# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

# Detect data exfiltration via HTTP POST to /telemetry/v2/report
# Criteria:
# 1. HTTP POST request
# 2. URI is exactly /telemetry/v2/report
# 3. Header X-TLM-Mode contains "exfil" (case-insensitive)
# 4. Body contains blob= with Base64-looking value >= 80 chars
# 5. Body contains sig= with exactly 64 hex characters
alert http any any -> any any (msg:"Data exfiltration detected in telemetry POST"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"x-tlm-mode|3a|"; http_header; content:"exfil"; http_header; content:"blob="; http_client_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; http_client_body; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1;)
