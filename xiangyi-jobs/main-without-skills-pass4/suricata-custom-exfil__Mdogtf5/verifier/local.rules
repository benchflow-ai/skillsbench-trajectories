# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert http any any -> any any (msg:"TLM exfil telemetry report"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; urilen:20; http.header; content:"X-TLM-Mode|3a| exfil"; nocase; http.request_body; content:"blob="; pcre:"/[A-Za-z0-9+\\/]{80,}={0,2}/R"; content:"sig="; pcre:"/[0-9A-Fa-f]{64}(?:&|\\r|\\n|$)/R"; sid:1000001; rev:7;)
