# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Suspected Data Exfiltration via Telemetry"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; endswith; http.header_names; content:"|0d 0a|X-TLM-Mode|0d 0a|"; nocase; http.header; content:"exfil"; nocase; http.request_body; content:"blob="; pcre:"/blob=[A-Za-z0-9+\/=]{80,}/"; content:"sig="; pcre:"/sig=[0-9a-fA-F]{64}(?:[^0-9a-fA-F]|$)/"; sid:1000001; rev:3;)
