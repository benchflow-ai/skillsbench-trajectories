# Data Exfiltration Detection in HTTP Telemetry Traffic
# Detects suspected data exfil hidden in POST requests with:
# - Exact path /telemetry/v2/report
# - Header X-TLM-Mode: exfil (case-insensitive)
# - Base64-looking blob parameter >= 80 chars
# - sig parameter with exactly 64 hex characters
alert http any any -> any any (msg:"DATA EXFILTRATION: HTTP Telemetry Exfil Pattern Detected"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"X-TLM-Mode|3a|"; http_header; content:"exfil"; http_header; distance:0; nocase; content:"blob="; http_client_body; pcre:"/blob=([A-Za-z0-9+\/=]{80,})/"; content:"sig="; http_client_body; pcre:"/sig=([0-9a-fA-F]{64})/"; classtype:trojan-activity; priority:1; sid:1000001; rev:1;)
