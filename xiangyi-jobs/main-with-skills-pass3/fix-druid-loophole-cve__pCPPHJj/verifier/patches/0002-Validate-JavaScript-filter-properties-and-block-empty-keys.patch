+  /**
+   * Validates that the JavaScript function string is safe.
+   * Checks for dangerous patterns and ensures it's properly formed.
+   */
+  private static void validateJavaScriptFunction(String function)
+  {
+    // Check for common dangerous patterns
+    if (function.contains("java.") || function.contains("Java.") || function.contains("Packages")) {
+      throw new IllegalArgumentException(
+          "JavaScript functions cannot access Java classes or packages"
+      );
+    }
+
+    if (function.contains("eval") || function.contains("Function")) {
+      throw new IllegalArgumentException(
+          "JavaScript functions cannot use eval or Function constructors"
+      );
+    }
+
+    // Function should be a proper function definition
+    validateFunctionSyntax(function);
+  }
+
+  /**
+   * Validates basic JavaScript function syntax.
+   */
+  private static void validateFunctionSyntax(String function)
+  {
+    function = function.trim();
+    if (!function.startsWith("function")) {
+      throw new IllegalArgumentException(
+          "JavaScript must be a function definition starting with 'function'"
+      );
+    }
+    if (!function.contains("(") || !function.contains(")")) {
+      throw new IllegalArgumentException(
+          "JavaScript must be a valid function with parentheses"
+      );
+    }
+    if (!function.contains("{") || !function.contains("}")) {
+      throw new IllegalArgumentException(
+          "JavaScript must be a valid function with curly braces"
+      );
+    }
+  }
+
