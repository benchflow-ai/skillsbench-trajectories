# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Custom Data Exfiltration via Telemetry"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; endswith; http.header_names; content:"|0d 0a|X-TLM-Mode|0d 0a|"; nocase; http.header; content:"X-TLM-Mode|3a 20|exfil"; nocase; fast_pattern; http.request_body; content:"blob="; content:"sig="; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; pcre:"/sig=[a-fA-F0-9]{64}(?:[^a-fA-F0-9]|$)/"; classtype:policy-violation; sid:1000001; rev:1;)
