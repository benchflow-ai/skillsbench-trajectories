From: Security Fix <security@apache.org>
Date: Mon, 28 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix JavaScriptPostAggregator bypass vulnerability

Add security validation to prevent JavaScript config bypass in post aggregator.

diff --git a/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java b/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
index 0000000000..1111111111 100644
--- a/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
+++ b/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
@@ -20,6 +20,7 @@
 package org.apache.druid.query.aggregation.post;

 import com.fasterxml.jackson.annotation.JacksonInject;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonCreator;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Preconditions;
@@ -42,6 +43,7 @@ import java.util.List;
 import java.util.Map;
 import java.util.Set;

+@JsonIgnoreProperties(value = {""})
 public class JavaScriptPostAggregator implements PostAggregator
 {
   private interface Function
@@ -104,6 +106,13 @@ public class JavaScriptPostAggregator implements PostAggregator
     Preconditions.checkNotNull(fieldNames, "Must have a valid, non-null fieldNames");
     Preconditions.checkNotNull(function, "Must have a valid, non-null function");

+    // Security fix: Prevent bypass of JavaScript security settings
+    if (config == null) {
+      throw new IllegalArgumentException(
+          "JavaScript is disabled or not properly configured. JavaScriptConfig must be injected by the system."
+      );
+    }
+
     this.name = name;
     this.fieldNames = fieldNames;
     this.function = function;
