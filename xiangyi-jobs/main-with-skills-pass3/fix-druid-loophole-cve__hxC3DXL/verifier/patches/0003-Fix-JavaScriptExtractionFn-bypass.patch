From: Security Fix <security@apache.org>
Date: Mon, 28 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix JavaScriptExtractionFn bypass vulnerability

Add security validation to prevent JavaScript config bypass in extraction function.

diff --git a/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java b/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java
index 0000000000..1111111111 100644
--- a/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java
+++ b/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java
@@ -20,6 +20,7 @@
 package org.apache.druid.query.extraction;

 import com.fasterxml.jackson.annotation.JacksonInject;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonCreator;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Function;
@@ -36,6 +37,7 @@ import org.mozilla.javascript.ScriptableObject;
 import javax.annotation.Nullable;
 import java.nio.ByteBuffer;

+@JsonIgnoreProperties(value = {""})
 public class JavaScriptExtractionFn implements ExtractionFn
 {
   private static Function<Object, String> compile(String function)
@@ -91,6 +93,13 @@ public class JavaScriptExtractionFn implements ExtractionFn
   {
     Preconditions.checkNotNull(function, "function must not be null");

+    // Security fix: Prevent bypass of JavaScript security settings
+    if (config == null) {
+      throw new IllegalArgumentException(
+          "JavaScript is disabled or not properly configured. JavaScriptConfig must be injected by the system."
+      );
+    }
+
     this.function = function;
     this.injective = injective;
     this.config = config;
