From: Security Fix <security@apache.org>
Date: Mon, 28 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix JavaScriptParseSpec bypass vulnerability

Add security validation to prevent JavaScript config bypass in parse spec.

diff --git a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
index 0000000000..1111111111 100644
--- a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
+++ b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
@@ -20,6 +20,7 @@
 package org.apache.druid.data.input.impl;

 import com.fasterxml.jackson.annotation.JacksonInject;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonCreator;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Preconditions;
@@ -29,6 +30,7 @@ import org.apache.druid.js.JavaScriptConfig;

 /**
  */
+@JsonIgnoreProperties(value = {""})
 public class JavaScriptParseSpec extends ParseSpec
 {
   private final String function;
@@ -47,6 +49,13 @@ public class JavaScriptParseSpec extends ParseSpec
   {
     super(timestampSpec, dimensionsSpec);

+    // Security fix: Prevent bypass of JavaScript security settings
+    if (config == null) {
+      throw new IllegalArgumentException(
+          "JavaScript is disabled or not properly configured. JavaScriptConfig must be injected by the system."
+      );
+    }
+
     this.function = function;
     this.config = config;
   }
