# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Data Exfiltration via HTTP Telemetry"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"x-tlm-mode|3a 20|exfil"; nocase; http.request_body; content:"blob="; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; pcre:"/sig=[a-fA-F0-9]{64}/"; sid:1000001; rev:1;)
