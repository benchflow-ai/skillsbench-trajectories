# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

# Data exfiltration detection rule for custom telemetry exfil pattern
# Matches: HTTP POST to /telemetry/v2/report with X-TLM-Mode: exfil header,
# containing blob= with >=80 base64 chars and sig= with exactly 64 hex chars
alert http any any -> any any ( \
    msg:"Data Exfiltration via Telemetry Endpoint"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; startswith; endswith; \
    http.header; content:"x-tlm-mode|3a 20|exfil"; nocase; \
    http.request_body; content:"blob="; \
    http.request_body; content:"sig="; \
    http.request_body; pcre:"/blob=[A-Za-z0-9+\/=]{80,}/"; \
    http.request_body; pcre:"/sig=[0-9a-fA-F]{64}([^0-9a-fA-F]|$)/"; \
    classtype:policy-violation; \
    sid:1000001; rev:1; \
)
