alert http $HOME_NET any -> $EXTERNAL_NET any (
  msg:"Data Exfiltration via Telemetry - Custom Exfil Pattern Detected";
  flow:to_server,established;
  http.method:POST;
  http.uri:"/telemetry/v2/report";
  http.header:"X-TLM-Mode|exfil";
  http.client_body;
  content:"blob="; http_client_body;
  pcre:"/blob=([A-Za-z0-9+\/\s]{80,})/";
  content:"sig="; http_client_body;
  pcre:"/sig=([0-9a-fA-F]{64})/";
  sid:1000001;
  rev:1;
  classtype:attempted-admin;
  priority:1;
)
