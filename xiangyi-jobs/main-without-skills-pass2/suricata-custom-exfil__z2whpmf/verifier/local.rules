# Data exfiltration detection rule
# Alerts on HTTP POST requests to /telemetry/v2/report with exfil header value and suspicious body
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Suspected data exfiltration in HTTP telemetry"; flow:established,to_server; http_method:POST; http_uri:"/telemetry/v2/report"; content:"exfil"; http_header:"x-tlm-mode"; http_client_body; content:"blob="; pcre:"/blob=[A-Za-z0-9+/]{80,}/"; http_client_body; content:"sig="; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1; classtype:policy-violation;)
