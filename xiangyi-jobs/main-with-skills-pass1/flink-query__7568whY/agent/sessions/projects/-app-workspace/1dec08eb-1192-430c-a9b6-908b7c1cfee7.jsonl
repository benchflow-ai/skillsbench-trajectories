k.api.common.typeinfo.Types;\nimport org.apache.flink.api.java.tuple.Tuple2;\nimport org.apache.flink.api.java.utils.ParameterTool;\nimport org.apache.flink.configuration.Configuration;\nimport org.apache.flink.streaming.api.datastream.DataStream;\nimport org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction;\nimport org.apache.flink.streaming.api.functions.source.SourceFunction;\nimport org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\nimport org.apache.flink.streaming.api.windowing.time.Time;\nimport org.apache.flink.util.Collector;\n\nimport java.io.BufferedReader;\nimport java.io.FileInputStream;\nimport java.io.InputStreamReader;\nimport java.time.Duration;\nimport java.util.zip.GZIPInputStream;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n\n        // Session gap: 10 minutes in milliseconds\n        final long sessionGapMs = 10 * 60 * 1000L;\n\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events\n        DataStream<TaskEvent> taskEvents = env\n                .addSource(taskSourceOrTest(new TaskEventSource(taskInput)))\n                .name(\"TaskEventSource\");\n\n        // Read job events\n        DataStream<JobEvent> jobEvents = env\n                .addSource(jobSourceOrTest(new JobEventSource(jobInput)))\n                .name(\"JobEventSource\");\n\n        // Filter for SUBMIT events only and assign watermarks\n        // Timestamps are in microseconds, convert to milliseconds\n        DataStream<TaskEvent> submitEvents = taskEvents\n                .filter(event -> event != null && event.getEventType() == TaskEvent.EventType.SUBMIT)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))\n                                .withTimestampAssigner((event, timestamp) -> event.getTimestamp() / 1000)\n                );\n\n        // Apply session windows to count tasks per session per job\n        // Returns (jobId, taskCount) for each session\n        DataStream<Tuple2<Long, Long>> sessionCounts = submitEvents\n                .map(new MapFunction<TaskEvent, Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> map(TaskEvent event) {\n                        return Tuple2.of(event.getJobId(), 1L);\n                    }\n                })\n                .keyBy(t -> t.f0)\n                .window(EventTimeSessionWindows.withGap(Time.milliseconds(sessionGapMs)))\n                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> a, Tuple2<Long, Long> b) {\n                        return Tuple2.of(a.f0, a.f1 + b.f1);\n                    }\n                });\n\n        // Assign watermarks to job events\n        DataStream<JobEvent> jobEventsWithWatermarks = jobEvents\n                .filter(event -> event != null)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))\n                                .withTimestampAssigner((event, timestamp) -> event.getTimestamp() / 1000)\n                );\n\n        // Filter for job finish events (FINISH, FAIL, KILL)\n        DataStream<JobEvent> finishedJobs = jobEventsWithWatermarks\n                .filter(JobEvent::isJobFinished);\n\n        // Join session counts with job finish events to find max session per finished job\n        DataStream<String> result = sessionCounts\n                .keyBy(t -> t.f0)\n                .connect(finishedJobs.keyBy(JobEvent::getJobId))\n                .process(new MaxSessionPerJobFunction());\n\n        result.addSink(sinkOrFileSink(outputPath))\n                .name(\"OutputSink\");\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private static org.apache.flink.streaming.api.functions.sink.SinkFunction<String> sinkOrFileSink(String outputPath) {\n        if (out != null) {\n            return (org.apache.flink.streaming.api.functions.sink.SinkFunction<String>) out;\n        }\n        return new org.apache.flink.streaming.api.functions.sink.SinkFunction<String>() {\n            private transient java.io.PrintWriter writer;\n\n            @Override\n            public void invoke(String value, Context context) throws Exception {\n                if (writer == null) {\n                    writer = new java.io.PrintWriter(new java.io.FileWriter(outputPath, true));\n                }\n                writer.println(value);\n                writer.flush();\n            }\n        };\n    }\n\n    /**\n     * Process function that tracks all session counts for a job and emits\n     * the maximum session count when the job finishes.\n     */\n    public static class MaxSessionPerJobFunction extends KeyedCoProcessFunction<Long, Tuple2<Long, Long>, JobEvent, String> {\n\n        // Maximum session count seen so far for this job\n        private transient ValueState<Long> maxSessionCountState;\n        // Whether the job has finished\n        private transient ValueState<Boolean> jobFinishedState;\n        // Whether result has been emitted\n        private transient ValueState<Boolean> resultEmittedState;\n\n        @Override\n        public void open(Configuration parameters) {\n            maxSessionCountState = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"maxSessionCount\", Types.LONG));\n            jobFinishedState = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"jobFinished\", Types.BOOLEAN));\n            resultEmittedState = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"resultEmitted\", Types.BOOLEAN));\n        }\n\n        @Override\n        public void processElement1(Tuple2<Long, Long> sessionCount, Context ctx, Collector<String> out) throws Exception {\n            // Update max session count\n            Long currentMax = maxSessionCountState.value();\n            if (currentMax == null || sessionCount.f1 > currentMax) {\n                maxSessionCountState.update(sessionCount.f1);\n            }\n\n            // Check if job already finished and we haven't emitted yet\n            Boolean finished = jobFinishedState.value();\n            Boolean emitted = resultEmittedState.value();\n            if (finished != null && finished && (emitted == null || !emitted)) {\n                Long max = maxSessionCountState.value();\n                if (max != null) {\n                    out.collect(\"(\" + sessionCount.f0 + \",\" + max + \")\");\n                    resultEmittedState.update(true);\n                }\n            }\n        }\n\n        @Override\n        public void processElement2(JobEvent jobEvent, Context ctx, Collector<String> out) throws Exception {\n            jobFinishedState.update(true);\n\n            // Check if we already have session data and haven't emitted yet\n            Boolean emitted = resultEmittedState.value();\n            Long currentMax = maxSessionCountState.value();\n            if (currentMax != null && (emitted == null || !emitted)) {\n                out.collect(\"(\" + jobEvent.getJobId() + \",\" + currentMax + \")\");\n                resultEmittedState.update(true);\n            }\n            // If no sessions yet, we'll emit when sessions arrive\n        }\n    }\n\n    public static class TaskEventSource implements SourceFunction<TaskEvent> {\n        private final String filePath;\n        private volatile boolean isRunning = true;\n\n        public TaskEventSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<TaskEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(new GZIPInputStream(new FileInputStream(filePath))))) {\n                String line;\n                while (isRunning && (line = reader.readLine()) != null) {\n                    TaskEvent event = TaskEvent.fromString(line);\n                    if (event != null) {\n                        ctx.collect(event);\n                    }\n                }\n            }\n        }\n\n        @Override\n        public void cancel() {\n            isRunning = false;\n        }\n    }\n\n    public static class JobEventSource implements SourceFunction<JobEvent> {\n        private final String filePath;\n        private volatile boolean isRunning = true;\n\n        public JobEventSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<JobEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(new GZIPInputStream(new FileInputStream(filePath))))) {\n                String line;\n                while (isRunning && (line = reader.readLine()) != null) {\n                    JobEvent event = JobEvent.fromString(line);\n                    if (event != null) {\n                        ctx.collect(event);\n                    }\n                }\n            }\n        }\n\n        @Override\n        public void cancel() {\n            isRunning = false;\n        }\n    }\n}\n"},"sourceToolAssistantUUID":"39960b14-d9b1-4bf8-91e0-cca2ca9f2306"}
