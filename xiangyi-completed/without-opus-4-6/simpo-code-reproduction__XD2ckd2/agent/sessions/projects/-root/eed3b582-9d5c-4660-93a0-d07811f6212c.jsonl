get_input_embeddings().register_forward_hook(make_inputs_require_grad)\n   172→\n   173→        # if args.generate_during_eval and not is_wandb_available():\n   174→        #     raise ValueError(\n   175→        #         \"`generate_during_eval=True` requires Weights and Biases to be installed.\"\n   176→        #         \" Please install `wandb` to resolve.\"\n   177→        #     )\n   178→\n   179→        # if model is not None:\n   180→        #     self.is_encoder_decoder = model.config.is_encoder_decoder\n   181→        # elif args.is_encoder_decoder is None:\n   182→        #     raise ValueError(\"When no model is provided, you need to pass the parameter is_encoder_decoder.\")\n   183→        # else:\n   184→        #     self.is_encoder_decoder = args.is_encoder_decoder\n   185→\n   186→        # if self.is_encoder_decoder:\n   187→        #     self.decoder_start_token_id = model.config.decoder_start_token_id\n   188→        #     self.pad_token_id = model.config.pad_token_id\n   189→\n   190→        # if tokenizer is None:\n   191→        #     raise ValueError(\"tokenizer must be specified to tokenize a SimPO dataset.\")\n   192→        # if args.max_length is None:\n   193→        #     warnings.warn(\n   194→        #         \"`max_length` is not set in the SimPOConfig's init\"\n   195→        #         \" it will default to `512` by default, but you should do it yourself in the future.\",\n   196→        #         UserWarning,\n   197→        #     )\n   198→        #     max_length = 512\n   199→        # else:\n   200→        #     max_length = args.max_length\n   201→        # if args.max_prompt_length is None:\n   202→        #     warnings.warn(\n   203→        #         \"`max_prompt_length` is not set in the SimPOConfig's init\"\n   204→        #         \" it will default to `128` by default, but you should do it yourself in the future.\",\n   205→        #         UserWarning,\n   206→        #     )\n   207→        #     max_prompt_length = 128\n   208→        # else:\n   209→        #     max_prompt_length = args.max_prompt_length\n   210→\n   211→        # if args.max_target_length is None and self.is_encoder_decoder:\n   212→        #     warnings.warn(\n   213→        #         \"When using an encoder decoder architecture, you should set `max_target_length` in the SimPOConfig's init\"\n   214→        #         \" it will default to `128` by default, but you should do it yourself in the future.\",\n   215→        #         UserWarning,\n   216→        #     )\n   217→        #     max_target_length = 128\n   218→        # else:\n   219→        #     max_target_length = args.max_target_length\n   220→\n   221→        # if data_collator is None:\n   222→        #     data_collator = DPODataCollatorWithPadding(\n   223→        #         pad_token_id=tokenizer.pad_token_id,\n   224→        #         label_pad_token_id=args.label_pad_token_id,\n   225→        #         is_encoder_decoder=self.is_encoder_decoder,\n   226→        #     )\n   227→\n   228→        #     if args.remove_unused_columns:\n   229→        #         args.remove_unused_columns = False\n   230→        #         # warn users\n   231→        #         warnings.warn(\n   232→        #             \"When using DPODataCollatorWithPadding, you should set `remove_unused_columns=False` in your TrainingArguments\"\n   233→        #             \" we have set it for you, but you should do it yourself in the future.\",\n   234→        #             UserWarning,\n   235→        #         )\n   236→\n   237→        #     self.use_dpo_data_collator = True\n   238→        # else:\n   239→        #     self.use_dpo_data_collator = False\n   240→\n   241→        # if args.disable_dropout:\n   242→        #     disable_dropout_in_model(model)\n   243→\n   244→        # self.max_length = max_length\n   245→        # self.generate_during_eval = args.generate_during_eval\n   246→        # self.label_pad_token_id = args.label_pad_token_id\n   247→        # self.padding_value = args.padding_value if args.padding_value is not None else tokenizer.pad_token_id\n   248→        # self.max_prompt_length = max_prompt_length\n   249→        # self.truncation_mode = args.truncation_mode\n   250→        # self.max_target_length = max_target_length\n   251→        # self.tokenizer = tokenizer\n   252→\n   253→        # if args.loss_type in [\"hinge\"] and args.label_smoothing > 0:\n   254→        #     warnings.warn(\n   255→        #         \"You are using a loss type that does not support label smoothing. Ignoring label_smoothing parameter.\"\n   256→        #     )\n   257→\n   258→        self.beta = args.beta\n   259→        self.gamma_beta_ratio = args.gamma_beta_ratio\n   260→        self.sft_weight = args.sft_weight\n   261→        self.label_smoothing = args.label_smoothing\n   262→        self.loss_type = args.loss_type\n   263→\n   264→        self._stored_metrics = defaultdict(lambda: defaultdict(list))\n   265→\n   266→        # Compute that only on the main process for faster data processing.\n   267→        # see: https://github.com/huggingface/trl/pull/1255\n   268→        # with PartialState().local_main_process_first():\n   269→        #     # tokenize the dataset\n   270→        #     train_dataset = train_dataset.map(self.tokenize_row, num_proc=args.dataset_num_proc)\n   271→        #     if eval_dataset is not None:\n   272→        #         eval_dataset = eval_dataset.map(self.tokenize_row, num_proc=args.dataset_num_proc)\n   273→\n   274→        # super().__init__(\n   275→        #     model=model,\n   276→        #     args=args,\n   277→        #     data_collator=data_collator,\n   278→        #     train_dataset=train_dataset,\n   279→        #     eval_dataset=eval_dataset,\n   280→        #     tokenizer=tokenizer,\n   281→        #     model_init=model_init,\n   282→        #     compute_metrics=compute_metrics,\n   283→        #     callbacks=callbacks,\n   284→        #     optimizers=optimizers,\n   285→        #     preprocess_logits_for_metrics=preprocess_logits_for_metrics,\n   286→        # )\n   287→\n   288→        # # Add tags for models that have been loaded with the correct transformers version\n   289→        # if hasattr(self.model, \"add_model_tags\"):\n   290→        #     self.model.add_model_tags(self._tag_names)\n   291→\n   292→        # if not hasattr(self, \"accelerator\"):\n   293→        #     raise AttributeError(\n   294→        #         \"Your `Trainer` does not have an `accelerator` object. Consider upgrading `transformers`.\"\n   295→        #     )\n   296→\n   297→    def build_tokenized_answer(self, prompt, answer):\n   298→        \"\"\"\n   299→        Llama tokenizer does satisfy `enc(a + b) = enc(a) + enc(b)`.\n   300→        It does ensure `enc(a + b) = enc(a) + enc(a + b)[len(enc(a)):]`.\n   301→        Reference:\n   302→            https://github.com/EleutherAI/lm-evaluation-harness/pull/531#issuecomment-1595586257\n   303→        \"\"\"\n   304→\n   305→        full_tokenized = self.tokenizer(prompt + answer, add_special_tokens=False)\n   306→        prompt_input_ids = self.tokenizer(prompt, add_special_tokens=False)[\"input_ids\"]\n   307→\n   308→        answer_input_ids = full_tokenized[\"input_ids\"][len(prompt_input_ids) :]\n   309→        answer_attention_mask = full_tokenized[\"attention_mask\"][len(prompt_input_ids) :]\n   310→\n   311→        # Concat tokens to form `enc(a) + enc(a + b)[len(enc(a)):]`\n   312→        full_concat_input_ids = np.concatenate([prompt_input_ids, answer_input_ids])\n   313→\n   314→        # Prepare input tokens for token by token comparison\n   315→        full_input_ids = np.array(full_tokenized[\"input_ids\"])\n   316→\n   317→        if len(full_input_ids) != len(full_concat_input_ids):\n   318→            raise ValueError(\"Prompt input ids and answer input ids should have the same length.\")\n   319→\n   320→        # On some tokenizers, like Llama-2 tokenizer, there are occasions where tokens\n   321→        # can be merged together when tokenizing prompt+answer. This could result\n   322→        # on the last token from the prompt being different when tokenized on its own\n   323→        # vs when done as prompt+answer.\n   324→        response_token_ids_start_idx = len(prompt_input_ids)\n   325→\n   326→        # If tokenized prompt is different than both prompt+answer, then it means the\n   327→        # last token has changed due to merging.\n   328→        if prompt_input_ids != full_tokenized[\"input_ids\"][:response_token_ids_start_idx]:\n   329→            response_token_ids_start_idx -= 1\n   330→\n   331→        prompt_input_ids = full_tokenized[\"input_ids\"][:response_token_ids_start_idx]\n   332→        prompt_attention_mask = full_tokenized[\"attention_mask\"][:response_token_ids_start_idx]\n   333→\n   334→        if len(prompt_input_ids) != len(prompt_attention_mask):\n   335→            raise ValueError(\"Prompt input ids and attention mask should have the same length.\")\n   336→\n   337→        answer_input_ids = full_tokenized[\"input_ids\"][response_token_ids_start_idx:]\n   338→        answer_attention_mask = full_tokenized[\"attention_mask\"][response_token_ids_start_idx:]\n   339→\n   340→        return dict(\n   341→            prompt_input_ids=prompt_input_ids,\n   342→            prompt_attention_mask=prompt_attention_mask,\n   343→            input_ids=answer_input_ids,\n   344→            attention_mask=answer_attention_mask,\n   345→        )\n   346→\n   347→    def tokenize_row(self, feature, model: Optional[Union[PreTrainedModel, nn.Module]] = None) -> Dict:\n   348→        \"\"\"Tokenize a single row from a SimPO specific dataset.\n   349→\n   350→        At this stage, we don't convert to PyTorch tensors yet; we just handle the truncation\n   351→        in case the prompt + chosen or prompt + rejected responses is/are too long. First\n   352→            we truncate the prompt; if we're still too long, we truncate the chosen/rejected.\n   353→\n   354→        We also create the labels for the chosen/rejected responses, which are of length equal to\n   355→            the sum of the length of the prompt and the chosen/rejected response, with\n   356→            label_pad_token_id  for the prompt tokens.\n   357→        \"\"\"\n   358→        batch = {}\n   359→        prompt = feature[\"prompt\"]\n   360→        chosen = feature[\"chosen\"]\n   361→        rejected = feature[\"rejected\"]\n   362→\n   363→        if not self.is_encoder_decoder:\n   364→            # Check issues below for more details\n   365→            #  1. https://github.com/huggingface/trl/issues/907\n   366→            #  2. https://github.com/EleutherAI/lm-evaluation-harness/pull/531#issuecomment-1595586257\n   367→            #  3. https://github.com/LianjiaTech/BELLE/issues/337\n   368→\n   369→            if not isinstance(prompt, str):\n   370→                raise ValueError(f\"prompt should be an str but got {type(prompt)}\")\n   371→            prompt_tokens = self.tokenizer(prompt, add_special_tokens=False)\n   372→            prompt_tokens = {f\"prompt_{k}\": v for k, v in prompt_tokens.items()}\n   373→\n   374→            if not isinstance(chosen, str):\n   375→                raise ValueError(f\"chosen should be an str but got {type(chosen)}\")\n   376→            chosen_tokens = self.build_tokenized_answer(prompt, chosen)\n   377→\n   378→            if not isinstance(rejected, str):\n   379→                raise ValueError(f\"rejected should be an str but got {type(rejected)}\")\n   380→            rejected_tokens = self.build_tokenized_answer(prompt, rejected)\n   381→\n   382→            # Last prompt token might get merged by tokenizer and\n   383→            # it should not be included for generation if that happens\n   384→            prompt_len_input_ids = len(prompt_tokens[\"prompt_input_ids\"])\n   385→\n   386→            chosen_prompt_len_input_ids = len(chosen_tokens[\"prompt_input_ids\"])\n   387→            rejected_prompt_len_input_ids = len(rejected_tokens[\"prompt_input_ids\"])\n   388→            prompt_len_input_ids = min(chosen_prompt_len_input_ids, rejected_prompt_len_input_ids)\n   389→\n   390→            for k, v in prompt_tokens.items():\n   391→                prompt_tokens[k] = v[:prompt_len_input_ids]\n   392→\n   393→            # Make sure prompts only have one different token at most an\n   394→            # and length only differs by 1 at most\n   395→            num_diff_tokens = sum(\n   396→                [a != b for a, b in zip(chosen_tokens[\"prompt_input_ids\"], rejected_tokens[\"prompt_input_ids\"])]\n   397→            )\n   398→            num_diff_len = abs(chosen_prompt_len_input_ids - rejected_prompt_len_input_ids)\n   399→            if num_diff_tokens > 1 or num_diff_len > 1:\n   400→                raise ValueError(\n   401→                    \"Chosen and rejected prompt_input_ids might only differ on the \"\n   402→                    \"last token due to tokenizer merge ops.\"\n   403→                )\n   404→\n   405→            # add BOS token to head of prompt. Avoid adding if it's already there\n   406→            bos_token_id = self.tokenizer.bos_token_id\n   407→            if prompt_len_input_ids == 0 or bos_token_id != prompt_tokens[\"prompt_input_ids\"][0]:\n   408→                prompt_tokens[\"prompt_input_ids\"] = [bos_token_id] + prompt_tokens[\"prompt_input_ids\"]\n   409→                prompt_tokens[\"prompt_attention_mask\"] = [1] + prompt_tokens[\"prompt_attention_mask\"]\n   410→            if chosen_prompt_len_input_ids == 0 or bos_token_id != chosen_tokens[\"prompt_input_ids\"][0]:\n   411→                chosen_tokens[\"prompt_input_ids\"] = [bos_token_id] + chosen_tokens[\"prompt_input_ids\"]\n   412→                chosen_tokens[\"prompt_attention_mask\"] = [1] + chosen_tokens[\"prompt_attention_mask\"]\n   413→            if rejected_prompt_len_input_ids == 0 or bos_token_id != rejected_tokens[\"prompt_input_ids\"][0]:\n   414→                rejected_tokens[\"prompt_input_ids\"] = [bos_token_id] + rejected_tokens[\"prompt_input_ids\"]\n   415→                rejected_tokens[\"prompt_attention_mask\"] = [1] + rejected_tokens[\"prompt_attention_mask\"]\n   416→\n   417→            # add EOS token to end of answer. Avoid adding if it's already there\n   418→            eos_token_id = self.tokenizer.eos_token_id\n   419→            if len(chosen_tokens[\"input_ids\"]) == 0 or eos_token_id != chosen_tokens[\"input_ids\"][-1]:\n   420→                chosen_tokens[\"input_ids\"].append(eos_token_id)\n   421→                chosen_tokens[\"attention_mask\"].append(1)\n   422→            if len(rejected_tokens[\"input_ids\"]) == 0 or eos_token_id != rejected_tokens[\"input_ids\"][-1]:\n   423→                rejected_tokens[\"input_ids\"].append(eos_token_id)\n   424→                rejected_tokens[\"attention_mask\"].append(1)\n   425→\n   426→            longer_response_length = max(len(chosen_tokens[\"input_ids\"]), len(rejected_tokens[\"input_ids\"]))\n   427→\n   428→            # if combined sequence is too long, truncate the prompt\n   429→            for answer_tokens in [chosen_tokens, rejected_tokens, prompt_tokens]:\n   430→                if len(answer_tokens[\"prompt_input_ids\"]) + longer_response_length > self.max_length:\n   431→                    if self.truncation_mode == \"keep_start\":\n   432→                        for k in [\"prompt_input_ids\", \"prompt_attention_mask\"]:\n   433→                            answer_tokens[k] = answer_tokens[k][: self.max_prompt_length]\n   434→                    elif self.truncation_mode == \"keep_end\":\n   435→                        for k in [\"prompt_input_ids\", \"prompt_attention_mask\"]:\n   436→                            answer_tokens[k] = answer_tokens[k][-self.max_prompt_length :]\n   437→                    else:\n   438→                        raise ValueError(f\"Unknown truncation mode: {self.truncation_mode}\")\n   439→\n   440→            # if that's still too long, truncate the response\n   441→            for answer_tokens in [chosen_tokens, rejected_tokens]:\n   442→                if len(answer_tokens[\"prompt_input_ids\"]) + longer_response_length > self.max_length:\n   443→                    for k in [\"input_ids\", \"attention_mask\"]:\n   444→                        answer_tokens[k] = answer_tokens[k][: self.max_length - self.max_prompt_length]\n   445→\n   446→            # Create labels\n   447→            chosen_sequence_tokens = {\n   448→                k: chosen_tokens[f\"prompt_{k}\"] + chosen_tokens[k] for k in [\"input_ids\", \"attention_mask\"]\n   449→            }\n   450→            rejected_sequence_tokens = {\n   451→                k: rejected_tokens[f\"prompt_{k}\"] + rejected_tokens[k] for k in [\"input_ids\", \"attention_mask\"]\n   452→            }\n   453→            chosen_sequence_tokens[\"labels\"] = chosen_sequence_tokens[\"input_ids\"][:]\n   454→            chosen_sequence_tokens[\"labels\"][: len(chosen_tokens[\"prompt_input_ids\"])] = [\n   455→                self.label_pad_token_id\n   456→            ] * len(chosen_tokens[\"prompt_input_ids\"])\n   457→            rejected_sequence_tokens[\"labels\"] = rejected_sequence_tokens[\"input_ids\"][:]\n   458→            rejected_sequence_tokens[\"labels\"][: len(rejected_tokens[\"prompt_input_ids\"])] = [\n   459→                self.label_pad_token_id\n   460→            ] * len(rejected_tokens[\"prompt_input_ids\"])\n   461→\n   462→            for k, toks in {\n   463→                \"chosen_\": chosen_sequence_tokens,\n   464→                \"rejected_\": rejected_sequence_tokens,\n   465→                \"\": prompt_tokens,\n   466→            }.items():\n   467→                for type_key, tokens in toks.items():\n   468→                    if type_key == \"token_type_ids\":\n   469→                        continue\n   470→                    batch[f\"{k}{type_key}\"] = tokens\n   471→\n   472→        else:\n   473→            chosen_tokens = self.tokenizer(\n   474→                chosen, truncation=True, max_length=self.max_target_length, add_special_tokens=True\n   475→            )\n   476→            rejected_tokens = self.tokenizer(\n   477→                rejected, truncation=True, max_length=self.max_target_length, add_special_tokens=True\n   478→            )\n   479→            prompt_tokens = self.tokenizer(\n   480→                prompt, truncation=True, max_length=self.max_prompt_length, add_special_tokens=True\n   481→            )\n   482→\n   483→            batch[\"chosen_labels\"] = chosen_tokens[\"input_ids\"]\n   484→            batch[\"rejected_labels\"] = rejected_tokens[\"input_ids\"]\n   485→            batch[\"prompt_input_ids\"] = prompt_tokens[\"input_ids\"]\n   486→            batch[\"prompt_attention_mask\"] = prompt_tokens[\"attention_mask\"]\n   487→\n   488→            if model is not None and hasattr(model, \"prepare_decoder_input_ids_from_labels\"):\n   489→                batch[\"rejected_decoder_input_ids\"] = model.prepare_decoder_input_ids_from_labels(\n   490→                    labels=torch.tensor(batch[\"rejected_labels\"])\n   491→                )\n   492→                batch[\"chosen_decoder_input_ids\"] = model.prepare_decoder_input_ids_from_labels(\n   493→                    labels=torch.tensor(batch[\"chosen_labels\"])\n   494→                )\n   495→\n   496→        return batch\n   497→\n   498→    @staticmethod\n   499→    def concatenated_inputs(\n   500→        batch: Dict[str, Union[List, torch.LongTensor]],\n   501→        is_encoder_decoder: bool = False,\n   502→        label_pad_token_id: int = -100,\n   503→        padding_value: int = 0,\n   504→        device: Optional[torch.device] = None,\n   505→    ) -> Dict[str, torch.LongTensor]:\n   506→        \"\"\"Concatenate the chosen and rejected inputs into a single tensor.\n   507→\n   508→        Args:\n   509→            batch: A batch of data. Must contain the keys 'chosen_input_ids' and 'rejected_input_ids', which are tensors of shape (batch_size, sequence_length).\n   510→            is_encoder_decoder: Whether the model is an encoder-decoder model.\n   511→            label_pad_token_id: The label pad token id.\n   512→            padding_value: The padding value to use for the concatenated inputs_ids.\n   513→            device: The device for the concatenated inputs.\n   514→\n   515→        Returns:\n   516→            A dictionary containing the concatenated inputs under the key 'concatenated_input_ids'.\n   517→        \"\"\"\n   518→        concatenated_batch = {}\n   519→\n   520→        if is_encoder_decoder:\n   521→            max_length = max(batch[\"chosen_labels\"].shape[1], batch[\"rejected_labels\"].shape[1])\n   522→        else:\n   523→            max_length = max(batch[\"chosen_input_ids\"].shape[1], batch[\"rejected_input_ids\"].shape[1])\n   524→\n   525→        for k in batch:\n   526→            if k.startswith(\"chosen\") and isinstance(batch[k], torch.Tensor):\n   527→                if \"labels\" in k or is_encoder_decoder:\n   528→                    pad_value = label_pad_token_id\n   529→                elif k.endswith(\"_input_ids\"):\n   530→                    pad_value = padding_value\n   531→                elif k.endswith(\"_attention_mask\"):\n   532→                    pad_value = 0\n   533→                concatenated_key = k.replace(\"chosen\", \"concatenated\")\n   534→                concatenated_batch[concatenated_key] = pad_to_length(batch[k], max_length, pad_value=pad_value)\n   535→        for k in batch:\n   536→            if k.startswith(\"rejected\") and isinstance(batch[k], torch.Tensor):\n   537→                if \"labels\" in k or is_encoder_decoder:\n   538→                    pad_value = label_pad_token_id\n   539→                elif k.endswith(\"_input_ids\"):\n   5