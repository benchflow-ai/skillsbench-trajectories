 public class GuiceAnnotationIntrospector extends NopAnnotationIntrospector
 {
+  @Override
+  public JacksonInject.Value findInjectableValue(AnnotatedMember m)
+  {
+    if (m.getAnnotation(JacksonInject.class) == null) {
+      return null;
+    }
+
+    Object injectableValueId = findInjectableValueId(m);
+    if (injectableValueId != null) {
+      // Return a JacksonInject.Value that disallows using JSON input for this parameter.
+      // This prevents attackers from overriding Guice-injected values by supplying
+      // an empty-string key ("") or matching property name in the JSON payload.
+      return JacksonInject.Value.construct(injectableValueId, Boolean.FALSE);
+    }
+
+    return null;
+  }
+
