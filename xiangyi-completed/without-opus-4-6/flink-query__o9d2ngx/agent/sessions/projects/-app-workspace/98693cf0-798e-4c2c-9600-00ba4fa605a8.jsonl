conds (default 600s = 10 min)\n        DataStream<Tuple2<Long, Long>> stageCounts = taskEventsWithWatermarks\n                .keyBy(event -> event.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input,\n                                      Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                })\n                .returns(TypeInformation.of(new TypeHint<Tuple2<Long, Long>>() {}));\n\n        // Read job events, filter for terminal events (job has ended)\n        DataStream<JobEvent> jobFinishEvents = env\n                .readTextFile(jobInput)\n                .flatMap(new FlatMapFunction<String, JobEvent>() {\n                    @Override\n                    public void flatMap(String line, Collector<JobEvent> out) {\n                        try {\n                            if (line.trim().isEmpty()) return;\n                            JobEvent event = JobEvent.fromCsv(line);\n                            if (event.eventType == JobEvent.FINISH ||\n                                event.eventType == JobEvent.FAIL ||\n                                event.eventType == JobEvent.KILL ||\n                                event.eventType == JobEvent.EVICT) {\n                                out.collect(event);\n                            }\n                        } catch (Exception e) {\n                            // skip malformed lines\n                        }\n                    }\n                })\n                .returns(TypeInformation.of(JobEvent.class));\n\n        DataStream<JobEvent> jobEventsWithWatermarks = jobFinishEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Connect stage counts with job finish events\n        // Use a CoProcess function with a timer to emit exactly one result per finished job\n        DataStream<String> results = stageCounts\n                .keyBy(t -> t.f0)\n                .connect(jobEventsWithWatermarks.keyBy(e -> e.jobId))\n                .process(new KeyedCoProcessFunction<Long, Tuple2<Long, Long>, JobEvent, String>() {\n\n                    private transient ValueState<Long> maxStageCount;\n                    private transient ValueState<Boolean> jobFinished;\n                    private transient ValueState<Boolean> timerRegistered;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        maxStageCount = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"maxStageCount\", Types.LONG));\n                        jobFinished = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"jobFinished\", Types.BOOLEAN));\n                        timerRegistered = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"timerRegistered\", Types.BOOLEAN));\n                    }\n\n                    private void registerEndTimer(Context ctx) throws Exception {\n                        Boolean registered = timerRegistered.value();\n                        if (registered == null || !registered) {\n                            // Register a timer at max event time; it fires when watermark reaches max\n                            // (i.e., end of bounded input)\n                            ctx.timerService().registerEventTimeTimer(Long.MAX_VALUE - 1);\n                            timerRegistered.update(true);\n                        }\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Long> stageCount, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        Long currentMax = maxStageCount.value();\n                        if (currentMax == null || stageCount.f1 > currentMax) {\n                            maxStageCount.update(stageCount.f1);\n                        }\n                        registerEndTimer(ctx);\n                    }\n\n                    @Override\n                    public void processElement2(JobEvent jobEvent, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        jobFinished.update(true);\n                        registerEndTimer(ctx);\n                    }\n\n                    @Override\n                    public void onTimer(long timestamp, OnTimerContext ctx,\n                                        Collector<String> out) throws Exception {\n                        Boolean finished = jobFinished.value();\n                        Long maxCount = maxStageCount.value();\n                        if (finished != null && finished && maxCount != null) {\n                            out.collect(\"(\" + ctx.getCurrentKey() + \",\" + maxCount + \")\");\n                        }\n                    }\n                });\n\n        // Write output to file\n        results.writeAsText(outputPath).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1322,"cache_read_input_tokens":69255,"cache_creation":{"ephemeral_5m_input_tokens":1322,"ephemeral_1h_input_tokens":0},"output_tokens":4}},"requestId":"req_vrtx_011CXt96fgJgLuvPohjs5MDv","type":"assistant","uuid":"68695fa3-2fc2-44b2-8f28-578b4c1a7796","timestamp":"2026-02-07T05:17:09.793Z"}
