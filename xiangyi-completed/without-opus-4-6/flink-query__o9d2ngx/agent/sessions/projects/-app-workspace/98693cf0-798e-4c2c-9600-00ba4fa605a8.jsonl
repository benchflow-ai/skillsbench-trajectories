i.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction;\nimport org.apache.flink.streaming.api.functions.windowing.WindowFunction;\nimport org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\nimport org.apache.flink.streaming.api.windowing.time.Time;\nimport org.apache.flink.streaming.api.windowing.windows.TimeWindow;\nimport org.apache.flink.util.Collector;\nimport org.apache.flink.api.common.serialization.SimpleStringEncoder;\nimport org.apache.flink.connector.file.sink.FileSink;\nimport org.apache.flink.streaming.api.functions.sink.filesystem.rollingpolicies.OnCheckpointRollingPolicy;\n\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.io.FileInputStream;\nimport java.time.Duration;\nimport java.util.zip.GZIPInputStream;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV, filter for SUBMIT events\n        DataStream<TaskEvent> taskEvents = env\n                .readTextFile(taskInput)\n                .flatMap(new FlatMapFunction<String, TaskEvent>() {\n                    @Override\n                    public void flatMap(String line, Collector<TaskEvent> out) {\n                        try {\n                            if (line.trim().isEmpty()) return;\n                            TaskEvent event = TaskEvent.fromCsv(line);\n                            if (event.eventType == TaskEvent.SUBMIT) {\n                                out.collect(event);\n                            }\n                        } catch (Exception e) {\n                            // skip malformed lines\n                        }\n                    }\n                })\n                .returns(TypeInformation.of(TaskEvent.class));\n\n        // Assign watermarks based on event time (timestamps are in microseconds)\n        DataStream<TaskEvent> taskEventsWithWatermarks = taskEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000) // convert microseconds to milliseconds\n                );\n\n        // Session windows on task SUBMIT events, keyed by jobId\n        // Each session window represents a \"stage\" - count tasks per stage\n        DataStream<Tuple2<Long, Long>> stageCounts = taskEventsWithWatermarks\n                .keyBy(event -> event.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input, Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                })\n                .returns(TypeInformation.of(new TypeHint<Tuple2<Long, Long>>() {}));\n\n        // Read job events, filter for terminal events (job finished)\n        DataStream<JobEvent> jobFinishEvents = env\n                .readTextFile(jobInput)\n                .flatMap(new FlatMapFunction<String, JobEvent>() {\n                    @Override\n                    public void flatMap(String line, Collector<JobEvent> out) {\n                        try {\n                            if (line.trim().isEmpty()) return;\n                            JobEvent event = JobEvent.fromCsv(line);\n                            // Terminal job events: FINISH, FAIL, KILL, EVICT\n                            if (event.eventType == JobEvent.FINISH ||\n                                event.eventType == JobEvent.FAIL ||\n                                event.eventType == JobEvent.KILL ||\n                                event.eventType == JobEvent.EVICT) {\n                                out.collect(event);\n                            }\n                        } catch (Exception e) {\n                            // skip malformed lines\n                        }\n                    }\n                })\n                .returns(TypeInformation.of(JobEvent.class));\n\n        DataStream<JobEvent> jobEventsWithWatermarks = jobFinishEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Connect stage counts with job finish events\n        // When job finishes, emit the max stage count for that job\n        DataStream<String> results = stageCounts\n                .keyBy(t -> t.f0)\n                .connect(jobEventsWithWatermarks.keyBy(e -> e.jobId))\n                .process(new KeyedCoProcessFunction<Long, Tuple2<Long, Long>, JobEvent, String>() {\n\n                    private ValueState<Long> maxStageCount;\n                    private ValueState<Boolean> jobFinished;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        maxStageCount = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"maxStageCount\", Types.LONG));\n                        jobFinished = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"jobFinished\", Types.BOOLEAN));\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Long> stageCount, Context ctx, Collector<String> out) throws Exception {\n                        Long currentMax = maxStageCount.value();\n                        if (currentMax == null || stageCount.f1 > currentMax) {\n                            maxStageCount.update(stageCount.f1);\n                        }\n                        Boolean finished = jobFinished.value();\n                        if (finished != null && finished) {\n                            // Job already finished, emit updated result\n                            out.collect(\"(\" + ctx.getCurrentKey() + \",\" + maxStageCount.value() + \")\");\n                        }\n                    }\n\n                    @Override\n                    public void processElement2(JobEvent jobEvent, Context ctx, Collector<String> out) throws Exception {\n                        jobFinished.update(true);\n                        Long currentMax = maxStageCount.value();\n                        if (currentMax != null) {\n                            out.collect(\"(\" + ctx.getCurrentKey() + \",\" + currentMax + \")\");\n                        }\n                    }\n                });\n\n        // Write output\n        results.writeAsText(outputPath).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":41,"lines":[" package clusterdata.query;"," ","+import clusterdata.datatypes.JobEvent;","+import clusterdata.datatypes.TaskEvent;"," import clusterdata