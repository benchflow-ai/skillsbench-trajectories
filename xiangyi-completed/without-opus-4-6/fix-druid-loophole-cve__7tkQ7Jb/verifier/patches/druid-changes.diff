diff --git a/core/src/main/java/org/apache/druid/guice/GuiceAnnotationIntrospector.java b/core/src/main/java/org/apache/druid/guice/GuiceAnnotationIntrospector.java
index 7862c977ee..d87f379cb2 100644
--- a/core/src/main/java/org/apache/druid/guice/GuiceAnnotationIntrospector.java
+++ b/core/src/main/java/org/apache/druid/guice/GuiceAnnotationIntrospector.java
@@ -33,6 +33,35 @@ import java.lang.annotation.Annotation;
  */
 public class GuiceAnnotationIntrospector extends NopAnnotationIntrospector
 {
+  /**
+   * Overrides the injectable value resolution to ensure that @JacksonInject parameters
+   * are NEVER sourced from JSON input. This prevents attackers from overriding
+   * server-configured injectable values (like JavaScriptConfig) via crafted JSON payloads.
+   */
+  @Override
+  public JacksonInject.Value findInjectableValue(AnnotatedMember m)
+  {
+    if (m.getAnnotation(JacksonInject.class) == null) {
+      return null;
+    }
+
+    Annotation guiceAnnotation = null;
+    for (Annotation annotation : m.annotations()) {
+      if (annotation.annotationType().isAnnotationPresent(BindingAnnotation.class)) {
+        guiceAnnotation = annotation;
+        break;
+      }
+    }
+
+    if (guiceAnnotation == null) {
+      if (m instanceof AnnotatedMethod) {
+        throw new IAE("Annotated methods don't work very well yet...");
+      }
+      return JacksonInject.Value.construct(Key.get(m.getGenericType()), Boolean.FALSE);
+    }
+    return JacksonInject.Value.construct(Key.get(m.getGenericType(), guiceAnnotation), Boolean.FALSE);
+  }
+
   @Override
   public Object findInjectableValueId(AnnotatedMember m)
   {
