 public class GuiceAnnotationIntrospector extends NopAnnotationIntrospector
 {
+  /**
+   * Override {@code findInjectableValue} to return a {@link JacksonInject.Value} with
+   * {@code useInput = false}. This prevents JSON input from overriding Guice-injected values,
+   * closing a security vulnerability where an attacker could supply a crafted JSON property
+   * (e.g., an empty key "") to override server-side configuration such as {@code JavaScriptConfig}.
+   */
+  @Override
+  public JacksonInject.Value findInjectableValue(AnnotatedMember m)
+  {
+    if (m.getAnnotation(JacksonInject.class) == null) {
+      return null;
+    }
+
+    Annotation guiceAnnotation = null;
+    for (Annotation annotation : m.annotations()) {
+      if (annotation.annotationType().isAnnotationPresent(BindingAnnotation.class)) {
+        guiceAnnotation = annotation;
+        break;
+      }
+    }
+
+    final Object valueId;
+    if (guiceAnnotation == null) {
+      if (m instanceof AnnotatedMethod) {
+        throw new IAE("Annotated methods don't work very well yet...");
+      }
+      valueId = Key.get(m.getGenericType());
+    } else {
+      valueId = Key.get(m.getGenericType(), guiceAnnotation);
+    }
+
+    return JacksonInject.Value.construct(valueId, Boolean.FALSE);
+  }
+
