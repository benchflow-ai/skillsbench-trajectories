# Detect custom data exfiltration over HTTP telemetry channel
# Triggers on POST /telemetry/v2/report with X-TLM-Mode: exfil header,
# a Base64 blob >=80 chars, and a 64-char hex signature.
alert http any any -> any any ( \
    msg:"DATA EXFIL via telemetry POST"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; startswith; endswith; \
    http.header; content:"x-tlm-mode"; nocase; content:"exfil"; distance:0; \
    http.request_body; content:"blob="; content:"sig="; \
    pcre:"/blob=[A-Za-z0-9+\/=]{80,}/"; \
    pcre:"/sig=[0-9a-fA-F]{64}(&|$)/"; \
    sid:1000001; rev:1; \
    classtype:policy-violation; \
    metadata:created_at 2026_02_07; \
)
