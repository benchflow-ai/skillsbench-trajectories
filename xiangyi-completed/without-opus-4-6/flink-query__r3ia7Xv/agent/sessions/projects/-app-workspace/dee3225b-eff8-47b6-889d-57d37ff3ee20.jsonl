 System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n        env.setParallelism(1);\n\n        // Read task events, filter SUBMIT (eventType=0), assign event-time watermarks\n        DataStream<TaskEvent> taskEventsStream = env\n                .readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        return TaskEvent.fromCsv(line);\n                    }\n                })\n                .filter(e -> e != null && e.eventType == 0)\n                .returns(TypeInformation.of(TaskEvent.class))\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(60))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Session windows on task SUBMIT events keyed by jobId\n        // Each window = one stage, output (jobId, task count in that stage)\n        DataStream<Tuple2<Long, Long>> sessionCounts = taskEventsStream\n                .keyBy(e -> e.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input, Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                })\n                .returns(TypeInformation.of(new TypeHint<Tuple2<Long, Long>>() {}));\n\n        // Read job events, filter FINISH (eventType=4)\n        DataStream<Tuple2<Long, Long>> finishedJobStream = env\n                .readTextFile(jobInput)\n                .map(new MapFunction<String, JobEvent>() {\n                    @Override\n                    public JobEvent map(String line) throws Exception {\n                        return JobEvent.fromCsv(line);\n                    }\n                })\n                .filter(e -> e != null && e.eventType == 4)\n                .returns(TypeInformation.of(JobEvent.class))\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(60))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                )\n                .map(new MapFunction<JobEvent, Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> map(JobEvent e) {\n                        return new Tuple2<>(e.jobId, -1L);\n                    }\n                })\n                .returns(TypeInformation.of(new TypeHint<Tuple2<Long, Long>>() {}));\n\n        // Connect: session stage counts (stream1) with job finish signals (stream2)\n        // Key by jobId, collect max stage count, emit when job is finished\n        DataStream<String> result = sessionCounts\n                .connect(finishedJobStream)\n                .keyBy(t -> t.f0, t -> t.f0)\n                .process(new MaxStageForFinishedJobs())\n                .returns(Types.STRING);\n\n        result.writeAsText(outputPath, org.apache.flink.core.fs.FileSystem.WriteMode.OVERWRITE);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    public static class MaxStageForFinishedJobs\n            extends KeyedCoProcessFunction<Long, Tuple2<Long, Long>, Tuple2<Long, Long>, String> {\n\n        private transient ValueState<Long> maxStageCount;\n        private transient ValueState<Boolean> jobFinished;\n        private transient ValueState<Boolean> resultEmitted;\n\n        @Override\n        public void open(Configuration parameters) {\n            maxStageCount = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"maxStageCount\", Types.LONG));\n            jobFinished = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"jobFinished\", Types.BOOLEAN));\n            resultEmitted = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"resultEmitted\", Types.BOOLEAN));\n        }\n\n        @Override\n        public void processElement1(Tuple2<Long, Long> sessionCount,\n                                    Context ctx,\n                                    Collector<String> out) throws Exception {\n            // A session stage count arrived from the session window\n            Long currentMax = maxStageCount.value();\n            if (currentMax == null || sessionCount.f1 > currentMax) {\n                maxStageCount.update(sessionCount.f1);\n            }\n            tryEmit(ctx, out);\n        }\n\n        @Override\n        public void processElement2(Tuple2<Long, Long> finishSignal,\n                                    Context ctx,\n                                    Collector<String> out) throws Exception {\n            // Job finish signal\n            jobFinished.update(true);\n            // Register a far-future event-time timer to ensure we emit after all windows fire\n            ctx.timerService().registerEventTimeTimer(Long.MAX_VALUE - 1);\n        }\n\n        @Override\n        public void onTimer(long timestamp, OnTimerContext ctx, Collector<String> out) throws Exception {\n            // This fires after all windows have fired (watermark reached end)\n            tryEmit(ctx, out);\n        }\n\n        private 