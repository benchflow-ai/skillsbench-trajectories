.process(new org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction<Long, Tuple2<Long, Long>, Tuple2<Long, Long>, Tuple2<Long, Long>>() {\n\n                    private transient org.apache.flink.api.common.state.ValueState<Long> maxCountState;\n                    private transient org.apache.flink.api.common.state.ValueState<Boolean> finishedState;\n\n                    @Override\n                    public void open(org.apache.flink.configuration.Configuration parameters) {\n                        maxCountState = getRuntimeContext().getState(\n                                new org.apache.flink.api.common.state.ValueStateDescriptor<>(\"maxCount\", Long.class));\n                        finishedState = getRuntimeContext().getState(\n                                new org.apache.flink.api.common.state.ValueStateDescriptor<>(\"finished\", Boolean.class));\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Long> value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n                        Long current = maxCountState.value();\n                        long newMax = (current == null) ? value.f1 : Math.max(current, value.f1);\n                        maxCountState.update(newMax);\n\n                        Boolean finished = finishedState.value();\n                        if (finished != null && finished) {\n                            out.collect(new Tuple2<>(value.f0, newMax));\n                        }\n                    }\n\n                    @Override\n                    public void processElement2(Tuple2<Long, Long> value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n                        finishedState.update(true);\n\n                        Long current = maxCountState.value();\n                        if (current != null) {\n                            out.collect(new Tuple2<>(value.f0, current));\n                        }\n                    }\n                });\n\n        // Format output and write\n        DataStream<String> output = result.map(new MapFunction<Tuple2<Long, Long>, String>() {\n            @Override\n            public String map(Tuple2<Long, Long> t) {\n                return \"(\" + t.f0 + \",\" + t.f1 + \")\";\n            }\n        });\n\n        output.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n}\n","numLines":172,"startLine":1,"totalLines":172}},"sourceToolAssistantUUID":"dec26709-e737-489d-b8f3-a4ea4847f5e7"}
