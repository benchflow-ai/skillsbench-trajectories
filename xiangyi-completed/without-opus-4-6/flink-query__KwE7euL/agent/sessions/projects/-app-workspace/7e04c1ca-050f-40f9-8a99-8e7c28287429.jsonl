treaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n        env.setRuntimeMode(RuntimeExecutionMode.BATCH);\n\n        // Read task events from gzipped CSV\n        DataStream<String> taskLines = env.readTextFile(taskInput);\n\n        // Parse task events, filter to SUBMIT events (eventType == 0)\n        DataStream<TaskEvent> submitEvents = taskLines.flatMap(new FlatMapFunction<String, TaskEvent>() {\n            @Override\n            public void flatMap(String line, Collector<TaskEvent> out) {\n                try {\n                    TaskEvent te = TaskEvent.fromString(line);\n                    if (te.eventType == 0) {\n                        out.collect(te);\n                    }\n                } catch (Exception e) {\n                    // skip malformed lines\n                }\n            }\n        });\n\n        // Assign timestamps (microseconds -> milliseconds) and watermarks\n        DataStream<TaskEvent> timestampedSubmits = submitEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(0))\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Key by jobId, apply session window with gap = sesssize seconds, count tasks per session\n        DataStream<Tuple2<Long, Long>> sessionCounts = timestampedSubmits\n                .map(new MapFunction<TaskEvent, Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> map(TaskEvent te) {\n                        return new Tuple2<>(te.jobId, 1L);\n                    }\n                })\n                .keyBy(t -> t.f0)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> a, Tuple2<Long, Long> b) {\n                        return new Tuple2<>(a.f0, a.f1 + b.f1);\n                    }\n                });\n\n        // Find max session count per job (in BATCH mode, reduce emits only final result)\n        DataStream<Tuple2<Long, Long>> maxPerJob = sessionCounts\n                .keyBy(t -> t.f0)\n                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> a, Tuple2<Long, Long> b) {\n                        return new Tuple2<>(a.f0, Math.max(a.f1, b.f1));\n                    }\n                });\n\n        // Read job events, find finished jobs (eventType == 4)\n        DataStream<String> jobLines = env.readTextFile(jobInput);\n        DataStream<Tuple2<Long, Long>> finishedJobTuples = jobLines\n                .flatMap(new FlatMapFunction<String, Tuple2<Long, Long>>() {\n                    @Override\n                    public void flatMap(String line, Collector<Tuple2<Long, Long>> out) {\n                        try {\n                            JobEvent je = JobEvent.fromString(line);\n                            if (je.eventType == 4) {\n                                out.collect(new Tuple2<>(je.jobId, 0L));\n                            }\n                        } catch (Exception e) {\n                            // skip malformed lines\n                        }\n                    }\n                });\n\n        // Join max-per-job with finished jobs using connect + KeyedCoProcessFunction\n        // In BATCH mode, both sides complete before end-of-input processing\n        DataStream<Tuple2<Long, Long>> result = maxPerJob\n                .connect(finishedJobTuples)\n                .keyBy(t -> t.f0, t -> t.f0)\n                .process(new org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction<Long, Tuple2<Long, Long>, Tuple2<Long, Long>, Tuple2<Long, Long>>() {\n\n                    private transient org.apache.flink.api.common.state.ValueState<Long> maxCountState;\n                    private transient org.apache.flink.api.common.state.ValueState<Boolean> finishedState;\n                    private transient org.apache.flink.api.common.state.ValueState<Boolean> emittedState;\n\n                    @Override\n                    public void open(org.apache.flink.configuration.Configuration parameters) {\n                        maxCountState = getRuntimeContext().getState(\n                                new org.apache.flink.api.common.state.ValueStateDescriptor<>(\"maxCount\", Long.class));\n                        finishedState = getRuntimeContext().getState(\n                                new org.apache.flink.api.common.state.ValueStateDescriptor<>(\"finished\", Boolean.class));\n                        emittedState = getRuntimeContext().getState(\n                                new org.apache.flink.api.common.state.ValueStateDescriptor<>(\"emitted\", Boolean.class));\n                    }\n\n                    private void tryEmit(Long jobId, Collector<Tuple2<Long, Long>> out) throws Exception {\n                        Boolean finished = finishedState.value();\n                        Long maxCount = maxCountState.value();\n                        Boolean emitted = emittedState.value();\n                        if (finished != null && finished && maxCount != null\n                                && (emitted == null || !emitted)) {\n                            out.collect(new Tuple2<>(jobId, maxCount));\n                            emittedState.update(true);\n                        }\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Long> value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n                        Long current = maxCountState.value();\n                        long newMax = (current == null) ? value.f1 : Math.max(current, value.f1);\n                        maxCountState.update(newMax);\n                        emittedState.update(false);\n                        tryEmit(value.f0, out);\n                    }\n\n                    @Override\n                    public void processElement2(Tuple2<Long, Long> value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n                        finishedState.update(true);\n                        tryEmit(value.f0, out);\n                    }\n                });\n\n        // Format output and write\n        DataStream<String> output = result.map(new MapFunction<Tuple2<Long, Long>, String>() {\n            @Override\n            public String map(Tuple2<Long, Long> t) {\n                return \"(\" + t.f0 + \",\" + t.f1 + \")\";\n            }\n        });\n\n        output.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n}\n","structuredPatch":[{"oldStart":3,"oldLines":6,"newStart":3,"newLines":7,"lines":[" import clusterdata.datatypes.JobEvent;"," import clusterdata.datatypes.TaskEvent;"," import clusterdata.utils.AppBase;","+import org.apache.flink.api.common.RuntimeExecutionMode;"," import org.apache.flink.api.common.eventtime.WatermarkStrategy;"," import org.apache.flink.api.common.functions.FlatMapFunction;"," import org.apache.flink.api.common.functions.MapFunction;"]},{"oldStart":32,"oldLines":6,"newStart":33,"newLines":7,"lines":[" ","         // set up streaming execution environment","         StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();","+        env.setRuntimeMode(RuntimeExecutionMode.BATCH);"," ","         // Read task events from gzipped CSV","         DataStream<String> taskLines = env.readTextFile(taskInput);"]},{"oldStart":75,"oldLines":7,"newStart":77,"newLines":7,"lines":["                     }","                 });"," ","-        