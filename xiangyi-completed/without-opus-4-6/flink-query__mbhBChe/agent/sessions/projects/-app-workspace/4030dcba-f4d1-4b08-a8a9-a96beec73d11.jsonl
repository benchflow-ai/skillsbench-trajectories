gs) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // Session gap in milliseconds (sesssize is in seconds)\n        final long sessionGapMs = sesssize * 1000L;\n\n        // Parse task events from gzipped CSV\n        List<TaskEvent> taskEventsList = new ArrayList<>();\n        try (BufferedReader reader = new BufferedReader(\n                new InputStreamReader(new GZIPInputStream(new FileInputStream(taskInput))))) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                if (!line.trim().isEmpty()) {\n                    try {\n                        TaskEvent te = TaskEvent.fromCsv(line);\n                        taskEventsList.add(te);\n                    } catch (Exception e) {\n                        // skip malformed lines\n                    }\n                }\n            }\n        }\n\n        // Parse job events from gzipped CSV\n        List<JobEvent> jobEventsList = new ArrayList<>();\n        try (BufferedReader reader = new BufferedReader(\n                new InputStreamReader(new GZIPInputStream(new FileInputStream(jobInput))))) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                if (!line.trim().isEmpty()) {\n                    try {\n                        JobEvent je = JobEvent.fromCsv(line);\n                        jobEventsList.add(je);\n                    } catch (Exception e) {\n                        // skip malformed lines\n                    }\n                }\n            }\n        }\n\n        // Collect finished job IDs (terminal states: FINISH=4, KILL=5, FAIL=3)\n        Set<Long> finishedJobs = new HashSet<>();\n        for (JobEvent je : jobEventsList) {\n            if (je.eventType == JobEvent.FINISH || je.eventType == JobEvent.KILL || je.eventType == JobEvent.FAIL) {\n                finishedJobs.add(je.jobId);\n            }\n        }\n\n        // Filter task events to only SUBMIT events for finished jobs\n        List<TaskEvent> submitEvents = new ArrayList<>();\n        for (TaskEvent te : taskEventsList) {\n            if (te.eventType == TaskEvent.SUBMIT && finishedJobs.contains(te.jobId)) {\n                submitEvents.add(te);\n            }\n        }\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Create stream from task submit events\n        DataStream<TaskEvent> taskStream = env.fromCollection(submitEvents);\n\n        // Assign timestamps (convert microseconds to milliseconds) and watermarks\n        SingleOutputStreamOperator<TaskEvent> withTimestamps = taskStream\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Key by jobId, session window with gap, count tasks per session\n        DataStream<Tuple2<Long, Long>> sessionCounts = withTimestamps\n                .keyBy((KeySelector<TaskEvent, Long>) event -> event.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.milliseconds(sessionGapMs)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input, Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent t