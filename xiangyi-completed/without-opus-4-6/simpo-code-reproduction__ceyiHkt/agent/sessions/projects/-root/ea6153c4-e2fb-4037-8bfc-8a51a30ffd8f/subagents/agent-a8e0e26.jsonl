_chosen_logits.view(-1, policy_chosen_logits.shape[-1]), chosen_labels.view(-1))\n   698→            loss = self.sft_weight * sft_loss + loss\n   699→            metrics[f\"{prefix}sft_loss\"] = sft_loss.detach().cpu()\n   700→        \n   701→        reward_accuracies = (chosen_rewards > rejected_rewards).float()\n   702→\n   703→        metrics[f\"{prefix}rewards/chosen\"] = chosen_rewards.mean().cpu()\n   704→        metrics[f\"{prefix}rewards/rejected\"] = rejected_rewards.mean().cpu()\n   705→        metrics[f\"{prefix}rewards/accuracies\"] = reward_accuracies.mean().cpu()\n   706→        metrics[f\"{prefix}rewards/margins\"] = (chosen_rewards - rejected_rewards).mean().cpu()\n   707→        metrics[f\"{prefix}logps/rejected\"] = policy_rejected_logps.detach().mean().cpu()\n   708→        metrics[f\"{prefix}logps/chosen\"] = policy_chosen_logps.detach().mean().cpu()\n   709→        metrics[f\"{prefix}logits/rejected\"] = policy_rejected_logits.detach().mean().cpu()\n   710→        metrics[f\"{prefix}logits/chosen\"] = policy_chosen_logits.detach().mean().cpu()\n   711→\n   712→        return loss, metrics\n   713→\n   714→    def compute_loss(\n   715→        self,\n   716→        model: Union[PreTrainedModel, nn.Module],\n   717→        inputs: Dict[str, Union[torch.Tensor, Any]],\n   718→        return_outputs=False,\n   719→    ) -> Union[torch.Tensor, Tuple[torch.Tensor, Dict[str, torch.Tensor]]]:\n   720→        if not self.use_dpo_data_collator:\n   721→            warnings.warn(\n   722→                \"compute_loss is only implemented for DPODataCollatorWithPadding, and you passed a datacollator that is different than \"\n   723→                \"DPODataCollatorWithPadding - you might see unexpected behavior. Alternatively, you can implement your own prediction_step method if you are using a custom data collator\"\n   724→            )\n   725→\n   726→        compute_loss_context_manager = torch.cuda.amp.autocast if self._peft_has_been_casted_to_bf16 else nullcontext\n   727→\n   728→        with compute_loss_context_manager():\n   729→            loss, metrics = self.get_batch_loss_metrics(model, inputs, train_eval=\"train\")\n   730→\n   731→        # force log the metrics\n   732→        self.store_metrics(metrics, train_eval=\"train\")\n   733→\n   734→        if return_outputs:\n   735→            return (loss, metrics)\n   736→        return loss\n   737→\n   738→    def get_batch_samples(self, model, batch: Dict[str, torch.LongTensor]) -> Tuple[str, str]:\n   739→        \"\"\"Generate samples from the model and reference model for the given batch of inputs.\"\"\"\n   740→\n   741→        # If one uses `generate_during_eval` with peft + bf16, we need to explicitly call generate with\n   742→        # the torch cuda amp context manager as some hidden states are silently casted to full precision.\n   743→        generate_context_manager = nullcontext if not self._peft_has_been_casted_to_bf16 else torch.cuda.amp.autocast\n   744→\n   745→        with generate_context_manager():\n   746→            policy_output = model.generate(\n   747→                input_ids=batch[\"prompt_input_ids\"],\n   748→                attention_mask=batch[\"prompt_attention_mask\"],\n   749→                max_length=self.max_length,\n   750→                do_sample=True,\n   751→                pad_token_id=self.tokenizer.pad_token_id,\n   752→            )\n   753→\n   754→        policy_output = pad_to_length(policy_output, self.max_length, self.tokenizer.pad_token_id)\n   755→        policy_output_decoded = self.tokenizer.batch_decode(policy_output, skip_special_tokens=True)\n   756→\n   757→        return policy_output_decoded\n   758→\n   759→    def prediction_step(\n   760→        self,\n   761→        model: Union[PreTrainedModel, nn.Module],\n   762→        inputs: Dict[str, Union[torch.Tensor, Any]],\n   763→        prediction_loss_only: bool,\n   764→        ignore_keys: Optional[List[str]] = None,\n   765→    ):\n   766→        if not self.use_dpo_data_collator:\n   767→            warnings.warn(\n   768→                \"prediction_step is only implemented for DPODataCollatorWithPadding, and you passed a datacollator that is different than \"\n   769→                \"DPODataCollatorWithPadding - you might see unexpected behavior. Alternatively, you can implement your own prediction_step method if you are using a custom data collator\"\n   770→            )\n   771→        if ignore_keys is None:\n   772→            if hasattr(model, \"config\"):\n   773→                ignore_keys = getattr(model.config, \"keys_to_ignore_at_inference\", [])\n   774→            else:\n   775→                ignore_keys = []\n   776→\n   777→        prediction_context_manager = torch.cuda.amp.autocast if self._peft_has_been_casted_to_bf16 else nullcontext\n   778→\n   779→        with torch.no_grad(), prediction_context_manager():\n   780→            loss, metrics = self.get_batch_loss_metrics(model, inputs, train_eval=\"eval\")\n   781→\n   782→        # force log the metrics\n   783→        self.store_metrics(metrics, train_eval=\"eval\")\n   784→\n   785→        if prediction_loss_only:\n   786→            return (loss.detach(), None, None)\n   787→\n   788→        # logits for the chosen and rejected samples from model\n   789→        logits_dict = {\n   790→            \"eval_logits/chosen\": metrics[\"eval_logits/chosen\"],\n   791→            \"eval_logits/rejected\": metrics[\"eval_logits/rejected\"],\n   792→        }\n   793→        logits = tuple(v.unsqueeze(dim=0) for k, v in logits_dict.items() if k not in ignore_keys)\n   794→        logits = torch.stack(logits).mean(axis=1).to(self.accelerator.device)\n   795→        labels = torch.zeros(logits.shape[0], device=self.accelerator.device)\n   796→\n   797→        return (loss.detach(), logits, labels)\n   798→\n   799→    def store_metrics(self, metrics: Dict[str, float], train_eval: Literal[\"train\", \"eval\"] = \"train\") -> None:\n   800→        for key, value in metrics.items():\n   801→            self._stored_metrics[train_eval][key].append(value)\n   802→\n   803→    def evaluation_loop(\n   804→        self,\n   805→        dataloader: DataLoader,\n   806→        description: str,\n   807→        prediction_loss_only: Optional[bool] = None,\n   808→        ignore_keys: Optional[List[str]] = None,\n   809→        metric_key_prefix: str = \"eval\",\n   810→    ) -> EvalLoopOutput:\n   811→        \"\"\"\n   812→        Overriding built-in evaluation loop to store metrics for each batch.\n   813→        Prediction/evaluation loop, shared by `Trainer.evaluate()` and `Trainer.predict()`.\n   814→\n   815→        Works both with or without labels.\n   816→        \"\"\"\n   817→\n   818→        # Sample and save to game log if requested (for one batch to save time)\n   819→        if self.generate_during_eval:\n   820→            # Generate random indices within the range of the total number of samples\n   821→            num_samples = len(dataloader.dataset)\n   822→            random_indices = random.sample(range(num_samples), k=self.args.eval_batch_size)\n   823→\n   824→            # Use dataloader.dataset.select to get the random batch without iterating over the DataLoader\n   825→            random_batch_dataset = dataloader.dataset.select(random_indices)\n   826→            random_batch = self.data_collator(random_batch_dataset)\n   827→            random_batch = self._prepare_inputs(random_batch)\n   828→\n   829→            policy_output_decoded = self.get_batch_samples(self.model, random_batch)\n   830→\n   831→            self.log(\n   832→                {\n   833→                    \"game_log\": wandb.Table(\n   834→                        columns=[\"Prompt\", \"Policy\"],\n   835→                        rows=[\n   836→                            [prompt, pol[len(prompt) :]]\n   837→                            for prompt, pol in zip(random_batch[\"prompt\"], policy_output_de