                    ],\n   839→                    )\n   840→                }\n   841→            )\n   842→            self.state.log_history.pop()\n   843→\n   844→        # Base evaluation\n   845→        initial_output = super().evaluation_loop(\n   846→            dataloader, description, prediction_loss_only, ignore_keys, metric_key_prefix\n   847→        )\n   848→\n   849→        return initial_output\n   850→\n   851→    def log(self, logs: Dict[str, float]) -> None:\n   852→        \"\"\"\n   853→        Log `logs` on the various objects watching training, including stored metrics.\n   854→\n   855→        Args:\n   856→            logs (`Dict[str, float]`):\n   857→                The values to log.\n   858→        \"\"\"\n   859→        # logs either has 'loss' or 'eval_loss'\n   860→        train_eval = \"train\" if \"loss\" in logs else \"eval\"\n   861→        # Add averaged stored metrics to logs\n   862→        for key, metrics in self._stored_metrics[train_eval].items():\n   863→            logs[key] = torch.tensor(metrics).mean().item()\n   864→        del self._stored_metrics[train_eval]\n   865→        return super().log(logs)\n   866→\n   867→    @wraps(Trainer.push_to_hub)\n   868→    def push_to_hub(self, commit_message: Optional[str] = \"End of training\", blocking: bool = True, **kwargs) -> str:\n   869→        \"\"\"\n   870→        Overwrite the `push_to_hub` method in order to force-add the tag \"simpo\" when pushing the\n   871→        model on the Hub. Please refer to `~transformers.Trainer.push_to_hub` for more details.\n   872→        \"\"\"\n   873→        kwargs = trl_sanitze_kwargs_for_tagging(model=self.model, tag_names=self._tag_names, kwargs=kwargs)\n   874→\n   875→        return super().push_to_hub(commit_message=commit_message, blocking=blocking, **kwargs)\n   876→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what 