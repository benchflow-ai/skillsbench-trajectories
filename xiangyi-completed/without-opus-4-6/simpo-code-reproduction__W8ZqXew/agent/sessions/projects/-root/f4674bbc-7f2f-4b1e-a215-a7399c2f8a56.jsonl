_random_pairs(self):\n        \n        losses, chosen_rewards, rejected_rewards = self.simpo_loss(\n            self.policy_chosen_logps,\n            self.policy_rejected_logps,\n        )\n\n        import numpy as np\n\n        np.savez(\n            \"/root/loss.npz\",\n            losses=losses.detach().cpu().numpy(),\n        )\n        print(\"Losses saved to /root/loss.npz\")\n\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":51,"startLine":1,"totalLines":51}},"sourceToolAssistantUUID":"dca483d3-eeba-41c9-9419-d1c4dcbb8cae"}
