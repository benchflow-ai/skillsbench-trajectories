ns 1,2,3,4,5,6 → 40\n    if set(rolls_list) == {1, 2, 3, 4, 5, 6}:\n        scores['all_numbers'] = 40\n\n    # Ordered Four: contiguous run of 4 consecutive increasing or decreasing → 50\n    if has_run_of_4(rolls_list):\n        scores['ordered_four'] = 50\n\n    return scores\n\ndef optimal_game_score(turn1_scores, turn2_scores):\n    \"\"\"Find maximum combined score using different categories for each turn.\"\"\"\n    best = 0\n    for cat1, s1 in turn1_scores.items():\n        for cat2, s2 in turn2_scores.items():\n            if cat1 != cat2:\n                best = max(best, s1 + s2)\n    return best\n\n# Compute scores for each turn\nturn_scores = {}\nfor _, row in data.iterrows():\n    turn_num = int(row['turn_number'])\n    game_num = int(row['game_number'])\n    rolls = [int(row[f'r{i}']) for i in range(1, 7)]\n    scores = score_turn(rolls)\n    turn_scores[turn_num] = {\n        'game_number': game_num,\n        'scores': scores,\n        'rolls': rolls\n    }\n\nprint(f\"\\nTotal turns scored: {len(turn_scores)}\")\n\n# Compute game scores\n# Each game has 2 turns. Turns are paired by game_number.\n# Group turns by game_number\nfrom collections import defaultdict\ngames = defaultdict(list)\nfor turn_num, info in turn_scores.items():\n    games[info['game_number']].append((turn_num, info['scores']))\n\ngame_scores = {}\nfor game_num, turns in games.items():\n    assert len(turns) == 2, f\"Game {game_num} has {len(turns)} turns\"\n    t1_scores = turns[0][1]\n    t2_scores = turns[1][1]\n    game_scores[game_num] = optimal_game_score(t1_scores, t2_scores)\n\nprint(f\"Total games scored: {len(game_scores)}\")\nprint(f\"Sample game scores (first 10):\")\nfor g in range(1, 11):\n    print(f\"  Game {g}: {game_scores[g]}\")\n\n# Now apply the player matching:\n# Odd numbered games → Player 1\n# Even numbered games → Player 2\n# Match: game 1 vs game 2, game 3 vs game 4, etc.\n\np1_wins = 0\np2_wins = 0\nties = 0\n\nnum_matches = len(game_scores) // 2  # 3000 games → 1500 matches\n\nfor i in range(num_matches):\n    odd_game = 2 * i + 1   # 1, 3, 5, ...\n    even_game = 2 * i + 2  # 2, 4, 6, ...\n\n    p1_score = game_scores[odd_game]\n    p2_score = game_scores[even_game]\n\n    if p1_score > p2_score:\n        p1_wins += 1\n    elif p2_score > p1_score:\n        p2_wins += 1\n    else:\n        ties += 1\n\nprint(f\"\\nResults:\")\nprint(f\"Player 1 wins: {p1_wins}\")\nprint(f\"Player 2 wins: {p2_wins}\")\nprint(f\"Ties: {ties}\")\nprint(f\"Total matches: {p1_wins + p2_wins + ties}\")\nprint(f\"\\nAnswer (P1 wins - P2 wins): {p1_wins - p2_wins}\")\n\n# Write answer\nwith open('/root/answer.txt', 'w') as f:\n    f.write(str(p1_wins - p2_wins))\n","numLines":140,"startLine":1,"totalLines":140}},"sourceToolAssistantUUID":"df3a5627-b36a-4103-8273-e8bbfea32d34"}
