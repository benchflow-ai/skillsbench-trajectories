# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http $HOME_NET any -> any any (msg:"DATA EXFIL - Encoded blob with signature via telemetry endpoint"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; bsize:20; http.header; content:"X-TLM-Mode|3a 20|exfil"; nocase; http.request_body; content:"blob="; pcre:"/^[A-Za-z0-9+\/=]{80,}/R"; content:"sig="; pcre:"/^[a-fA-F0-9]{64}($|&)/R"; sid:1000001; rev:1;)
