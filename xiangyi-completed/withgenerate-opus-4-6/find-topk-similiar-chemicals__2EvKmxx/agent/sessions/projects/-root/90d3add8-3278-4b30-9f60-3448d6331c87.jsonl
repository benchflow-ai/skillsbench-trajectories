extract_text()\n            if page_text:\n                text += page_text + \"\\n\"\n    return [line.strip() for line in text.split(\"\\n\") if line.strip()]\n\n\ndef name_to_smiles(name: str) -> str:\n    \"\"\"Convert a chemical name to its canonical SMILES using PubChem.\"\"\"\n    compounds = pcp.get_compounds(name, \"name\")\n    if compounds:\n        return compounds[0].canonical_smiles\n    return None\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str,\n    molecule_pool_filepath: str,\n    top_k: int,\n) -> list:\n    \"\"\"\n    Find the top-k most similar molecules to a target molecule from a PDF pool.\n\n    Args:\n        target_molecule_name: Name of the target molecule.\n        molecule_pool_filepath: Path to a PDF file containing molecule names.\n        top_k: Number of top similar molecules to return.\n\n    Returns:\n        A list of molecule names sorted by descending Tanimoto similarity,\n        with alphabetical ordering for ties.\n    \"\"\"\n    # 1. Extract molecule names from the PDF\n    pool_names = extract_molecules_from_pdf(molecule_pool_filepath)\n\n    # 2. Get SMILES for the target molecule\n    target_smiles = name_to_smiles(target_molecule_name)\n    if target_smiles is None:\n        raise ValueError(\n            f\"Could not find SMILES for target molecule: {target_molecule_name}\"\n        )\n\n    # 3. Create RDKit mol and fingerprint for target\n    target_mol = Chem.MolFromSmiles(target_smiles)\n    if target_mol is None:\n        raise ValueError(\n            f\"Invalid SMILES for target molecule: {target_smiles}\"\n        )\n    target_fp = AllChem.GetMorganFingerprintAsBitVect(\n        target_mol, radius=2, nBits=2048, useChirality=True\n    )\n\n    # 4. Compute similarity for each molecule in the pool\n    results = []\n    for name in pool_names:\n        smiles = name_to_smiles(name)\n        if smiles is None:\n            continue\n        mol = Chem.MolFromSmiles(smiles)\n        if mol is None:\n            continue\n        fp = AllChem.GetMorganFingerprintAsBitVect(\n            mol, radius=2, nBits=2048, useChirality=True\n        )\n        sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n        results.append((name, sim))\n\n    # 5. Sort by similarity descending, then alphabetically ascending for ties\n    results.sort(key=lambda x: (-x[1], x[0]))\n\n    # 6. Return top-k molecule names\n    return [name for name, _ in results[:top_k]]\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    target = \"Aspirin\"\n    filepath = \"/root/molecules.pdf\"\n    k = 5\n    top_molecules = topk_tanimoto_similarity_molecules(target, filepath, k)\n    print(f\"Top {k} molecules similar to {target}:\")\n    for i, name in enumerate(top_molecules, 1):\n        print(f\"  {i}. {name}\")\n"},"sourceToolAssistantUUID":"0f41d687-f62d-4f4f-8efe-c09bc4062f58"}
