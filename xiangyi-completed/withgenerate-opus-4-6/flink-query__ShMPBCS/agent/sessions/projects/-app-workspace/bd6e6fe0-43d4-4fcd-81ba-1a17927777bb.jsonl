 org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.windowing.ProcessWindowFunction;\nimport org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\nimport org.apache.flink.streaming.api.windowing.time.Time;\nimport org.apache.flink.streaming.api.windowing.windows.TimeWindow;\nimport org.apache.flink.core.fs.FileSystem;\nimport org.apache.flink.util.Collector;\n\nimport java.time.Duration;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV\n        DataStream<TaskEvent> taskEvents = env\n                .addSource(taskSourceOrTest(new TaskEventSource(taskInput)));\n\n        // Filter to only SUBMIT events (eventType == 0)\n        DataStream<TaskEvent> submitEvents = taskEvents\n                .filter(event -> event.getEventType() == 0);\n\n        // Assign timestamps and watermarks\n        // Timestamps in data are in microseconds; Flink uses milliseconds\n        DataStream<TaskEvent> withTimestamps = submitEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner(\n                                        (SerializableTimestampAssigner<TaskEvent>) (event, recordTimestamp) ->\n                                                event.getTimestamp() / 1000\n                                )\n                );\n\n        // Key by jobId, apply session window, count events per session\n        DataStream<Tuple2<Long, Long>> sessionCounts = withTimestamps\n                .keyBy(TaskEvent::getJobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void process(Long jobId, Context context,\n                                        Iterable<TaskEvent> elements,\n                                        Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent e : elements) {\n                            count++;\n                        }\n                        out.collect(Tuple2.of(jobId, count));\n                    }\n                });\n\n        // Find the max session count per job (longest stage)\n        DataStream<Tuple2<Long, Long>> maxPerJob = sessionCounts\n                .keyBy(t -> t.f0)\n                .reduce((a, b) -> a.f1 >= b.f1 ? a : b);\n\n        // Write output\n        maxPerJob.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE)\n                .setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n}"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":513,"cache_read_input_tokens":65898,"cache_creation":{"ephemeral_5m_input_tokens":513,"ephemeral_1h_input_tokens":0},"output_tokens":25}},"requestId":"req_vrtx_011CXtDMbSwczi9akRS6SkHa","type":"assistant","uuid":"6b8fd850-793f-4348-8b51-69c9ac14aa4c","timestamp":"2026-02-07T06:12:16.509Z"}
