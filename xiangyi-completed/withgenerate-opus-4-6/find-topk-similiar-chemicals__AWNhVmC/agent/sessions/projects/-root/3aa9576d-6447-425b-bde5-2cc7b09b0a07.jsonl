n    42→def topk_tanimoto_similarity_molecules(\n    43→    target_molecule_name: str, molecule_pool_filepath: str, top_k: int\n    44→) -> list:\n    45→    \"\"\"\n    46→    Find the top-k most similar molecules to the target molecule from a PDF pool.\n    47→\n    48→    Args:\n    49→        target_molecule_name: Name of the target molecule.\n    50→        molecule_pool_filepath: Path to the PDF containing molecule names.\n    51→        top_k: Number of top similar molecules to return.\n    52→\n    53→    Returns:\n    54→        A list of molecule names sorted by descending Tanimoto similarity,\n    55→        with alphabetical ordering for ties.\n    56→    \"\"\"\n    57→    # Extract molecule names from the PDF\n    58→    pool_names = extract_molecule_names_from_pdf(molecule_pool_filepath)\n    59→\n    60→    # Get SMILES for the target molecule\n    61→    target_smiles = get_smiles_from_name(target_molecule_name)\n    62→    target_fp = get_morgan_fingerprint(target_smiles)\n    63→\n    64→    # Compute similarity for each molecule in the pool\n    65→    similarities = []\n    66→    for name in pool_names:\n    67→        try:\n    68→            smiles = get_smiles_from_name(name)\n    69→            fp = get_morgan_fingerprint(smiles)\n    70→            sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n    71→            similarities.append((name, sim))\n    72→        except Exception:\n    73→            continue\n    74→\n    75→    # Sort by descending similarity, then alphabetical for ties\n    76→    similarities.sort(key=lambda x: (-x[1], x[0]))\n    77→\n    78→    # Return top-k molecule names\n    79→    return [name for name, _ in similarities[:top_k]]\n    80→\n    81→\n    82→if __name__ == \"__main__\":\n    83→    results = topk_tanimoto_similarity_molecules(\n    84→        \"Aspirin\", \"/root/molecules.pdf\", 5\n    85→    )\n    86→    print(\"Top 5 similar molecules to Aspirin:\")\n    87→    for i, name in enumerate(results, 1):\n    88→        print(f\"  {i}. {name}\")\n    89→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"878679fc-e17b-4bd3-897d-f2f85c5d61dd","timestamp":"2026-02-07T06:18:19.359Z","toolUseResult":{"type":"text","file":{"filePath":"/root/workspace/solution.py","content":"import pdfplumber\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import DataStructs, rdFingerprintGenerator\n\n\ndef extract_molecule_names_from_pdf(filepath: str) -> list:\n    \"\"\"Extract molecule names from a PDF file, one name per line.\"\"\"\n    names = []\n    with pdfplumber.open(filepath) as pdf:\n        for page in pdf.pages:\n            text = page.extract_text()\n            if text:\n                for line in text.strip().split(\"\\n\"):\n                    line = line.strip()\n                    if line:\n                        names.append(line)\n    return names\n\n\ndef get_smiles_from_name(chemical_name: str) -> str:\n    \"\"\"Convert a chemical name to its canonical SMILES using PubChem.\"\"\"\n    compounds = pcp.get_compounds(chemical_name, \"name\")\n    if compounds:\n        return compounds[0].smiles\n    raise ValueError(f\"Could not find SMILES for: {chemical_name}\")\n\n\n_morgan_gen = rdFingerprintGenerator.GetMorganGenerator(\n    radius=2, fpSize=2048, includeChirality=True\n)\n\n\ndef get_morgan_fingerprint(smiles: str):\n    \"\"\"Generate a Morgan fingerprint bit vector from a SMILES string.\"\"\"\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        raise ValueError(f\"Invalid SMILES: {smiles}\")\n    return _morgan_gen.GetFingerprint(mol)\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str, molecule_pool_filepath: str, top_k: int\n) -> list:\n    \"\"\"\n    Find the top-k most similar molecules to the target molecule from a PDF pool.\n\n    Args:\n        target_molecule_name: Name of the target molecule.\n        molecule_pool_filepath: Path to the PDF containing molecule names.\n        top_k: Number of top similar molecules to return.\n\n    Returns:\n        A list of molecule names sorted by descending Tanimoto similarity,\n        with alphabetical ordering for ties.\n    \"\"\"\n    # Extract molecule names from the PDF\n    pool_names = extract_molecule_names_from_pdf(molecule_pool_filepath)\n\n    # Get SMILES for the target molecule\n    target_smiles = get_smiles_from_name(target_molecule_name)\n    target_fp = get_morgan_fingerprint(target_smiles)\n\n    # Compute similarity for each molecule in the pool\n    similarities = []\n    for name in pool_names:\n        try:\n            smiles = get_smiles_from_name(name)\n            fp = get_morgan_fingerprint(smiles)\n            sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n            similarities.append((name, sim))\n        except Exception:\n            continue\n\n    # Sort by descending similarity, then alphabetical for ties\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n\n    # Return top-k molecule names\n    return [name for name, _ in similarities[:top_k]]\n\n\nif __name__ == \"__main__\":\n    results = topk_tanimoto_similarity_molecules(\n        \"Aspirin\", \"/root/molecules.pdf\", 5\n    )\n    print(\"Top 5 similar molecules to Aspirin:\")\n    for i, name in enumerate(results, 1):\n        print(f\"  {i}. {name}\")\n","numLines":89,"startLine":1,"totalLines":89}},"sourceToolAssistantUUID":"2d7be1ef-2975-4510-81e9-c1fb8dca70be"}
