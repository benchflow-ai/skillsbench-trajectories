ation;\n    29→\n    30→public class LongestSessionPerJob extends AppBase {\n    31→\n    32→    public static void main(String[] args) throws Exception {\n    33→\n    34→        ParameterTool params = ParameterTool.fromArgs(args);\n    35→        String taskInput = params.get(\"task_input\", null);\n    36→        String jobInput = params.get(\"job_input\", null);\n    37→        String outputPath = params.get(\"output\", null);\n    38→        System.out.println(\"task_input  \" + taskInput);\n    39→        System.out.println(\"job_input  \" + jobInput);\n    40→        final int sesssize = params.getInt(\"sesssize\", 600);\n    41→\n    42→        // set up streaming execution environment\n    43→        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n    44→\n    45→        // Read task events\n    46→        DataStream<TaskEvent> taskEvents = env\n    47→                .addSource(taskSourceOrTest(new TaskEventSource(taskInput)))\n    48→                .filter(e -> e != null && e.getEventType() == TaskEvent.SUBMIT)\n    49→                .assignTimestampsAndWatermarks(\n    50→                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(0))\n    51→                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000)\n    52→                );\n    53→\n    54→        // Apply session windows keyed by jobId to count tasks per stage\n    55→        DataStream<Tuple2<Long, Integer>> sessionCounts = taskEvents\n    56→                .keyBy(TaskEvent::getJobId)\n    57→                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n    58→                .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n    59→                    @Override\n    60→                    public void process(Long jobId, Context ctx, Iterable<TaskEvent> elements,\n    61→                                        Collector<Tuple2<Long, Integer>> out) {\n    62→                        int count = 0;\n    63→                        for (TaskEvent e : elements) {\n    64→                            count++;\n    65→                        }\n    66→                        out.collect(Tuple2.of(jobId, count));\n    67→                    }\n    68→                });\n    69→\n    70→        // Find max session count per job\n    71→        DataStream<Tuple2<Long, Integer>> maxPerJob = sessionCounts\n    72→                .keyBy(t -> t.f0)\n    73→                .reduce((a, b) -> a.f1 >= b.f1 ? a : b);\n    74→\n    75→        // Read job events and filter to finished jobs\n    76→        DataStream<JobEvent> finishedJobs = env\n    77→                .addSource(jobSourceOrTest(new JobEventSource(jobInput)))\n    78→                .filter(e -> e != null && e.getEventType() == JobEvent.FINISH)\n    79→                .assignTimestampsAndWatermarks(\n    80→                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(0))\n    81→                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000)\n    82→                );\n    83→\n    84→        // Join max session counts with finished jobs using CoProcessFunction\n    85→        DataStream<String> result = maxPerJob\n    86→                .connect(finishedJobs)\n    87→                .keyBy(t -> t.f0, JobEvent::getJobId)\n    88→                .process(new CoProcessFunction<Tuple2<Long, Integer>, JobEvent, String>() {\n    89→                    private ValueState<Tuple2<Long, Integer>> sessionState;\n    90→                    private ValueState<Boolean> jobFinishedState;\n    91→\n    92→                    @Override\n    93→                    public void open(Configuration parameters) {\n    94→                        sessionState = getRuntimeContext().getState(\n    95→                                new ValueStateDescriptor<>(\"session\", org.apache.flink.api.common.typeinfo.Types.TUPLE(\n    96→                                        org.apache.flink.api.common.typeinfo.Types.LONG,\n    97→                                        org.apache.flink.api.common.typeinfo.Types.INT)));\n    98→                        jobFinishedState = getRuntimeContext().getState(\n    99→                                new ValueStateDescriptor<>(\"jobFinished\", Boolean.class));\n   100→                    }\n   101→\n   102→                    @Override\n   103→                    public void processElement1(Tuple2<Long, Integer> value, Context ctx,\n   104→                                                Collector<String> out) throws Exception {\n   105→                        Tuple2<Long, Integer> current = sessionState.value();\n   106→                        if (current == null || value.f1 > current.f1) {\n   107→                            sessionState.update(value);\n   108→                        }\n   109→                        Boolean finished = jobFinishedState.value();\n   110→                        if (finished != null && finished) {\n   111→                            Tuple2<Long, Integer> best = sessionState.value();\n   112→                            out.collect(\"(\" + best.f0 + \",\" + best.f1 + \")\");\n   113→                            sessionState.clear();\n   114→                            jobFinishedState.clear();\n   115→                        }\n   116→                    }\n   117→\n   118→                    @Override\n   119→                    public void processElement2(JobEvent value, Context ctx,\n   120→                                                Collector<String> out) throws Exception {\n   121→                        jobFinishedState.update(true);\n   122→                        Tuple2<Long, Integer> current = sessionState.value();\n   123→                        if (current != null) {\n   124→                            out.collect(\"(\" + current.f0 + \",\" + current.f1 + \")\");\n   125→          