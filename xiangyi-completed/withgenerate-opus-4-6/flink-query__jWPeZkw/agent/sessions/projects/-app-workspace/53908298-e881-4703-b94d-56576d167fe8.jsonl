mport java.io.*;\nimport java.util.zip.GZIPInputStream;\nimport java.time.Duration;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events\n        DataStream<TaskEvent> taskEvents = env\n                .addSource(taskSourceOrTest(new TaskEventSource(taskInput)))\n                .filter(e -> e != null && e.getEventType() == TaskEvent.SUBMIT)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(0))\n                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000)\n                );\n\n        // Apply session windows keyed by jobId to count tasks per stage\n        DataStream<Tuple2<Long, Integer>> sessionCounts = taskEvents\n                .keyBy(TaskEvent::getJobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void process(Long jobId, Context ctx, Iterable<TaskEvent> elements,\n                                        Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (TaskEvent e : elements) {\n                            count++;\n                        }\n                        out.collect(Tuple2.of(jobId, count));\n                    }\n                });\n\n        // Find max session count per job\n        DataStream<Tuple2<Long, Integer>> maxPerJob = sessionCounts\n                .keyBy(t -> t.f0)\n                .reduce((a, b) -> a.f1 >= b.f1 ? a : b);\n\n        // Read job events and filter to finished jobs\n        DataStream<JobEvent> finishedJobs = env\n                .addSource(jobSourceOrTest(new JobEventSource(jobInput)))\n                .filter(e -> e != null && e.getEventType() == JobEvent.FINISH)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(0))\n                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000)\n                );\n\n        // Join max session counts with finished jobs using CoProcessFunction\n        DataStream<String> result = maxPerJob\n                .connect(finishedJobs)\n                .keyBy(t -> t.f0, JobEvent::getJobId)\n                .process(new CoProcessFunction<Tuple2<Long, Integer>, JobEvent, String>() {\n                    private ValueState<Tuple2<Long, Integer>> sessionState;\n                    private ValueState<Boolean> jobFinishedState;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        sessionState = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"session\", org.apache.flink.api.common.typeinfo.Types.TUPLE(\n                                        org.apache.flink.api.common.typeinfo.Types.LONG,\n                                        org.apache.flink.api.common.typeinfo.Types.INT)));\n                        jobFinishedState = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"jobFinished\", Boolean.class));\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Integer> value, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        Tuple2<Long, Integer> current = sessionState.value();\n                        if (current == null || value.f1 > current.f1) {\n                            sessionState.update(value);\n                        }\n                        Boolean finished = jobFinishedState.value();\n                        if (finished != null && finished) {\n                            Tuple2<Long, Integer> best = sessionState.value();\n                            out.collect(\"(\" + best.f0 + \",\" + best.f1 + \")\");\n                            sessionState.clear();\n                            jobFinishedState.clear();\n                        }\n                    }\n\n                    @Override\n                    public void processElement2(JobEvent value, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        jobFinishedState.update(true);\n                        Tuple2<Long, Integer> current = sessionState.value();\n                        if (current != null) {\n                            out.collect(\"(\" + current.f0 + \",\" + current.f1 + \")\");\n                            sessionState.clear();\n                            jobFinishedState.clear();\n                        }\n                    }\n                });\n\n        result.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    public static class TaskEventSource implements SourceFunction<TaskEvent> {\n        private final String filePath;\n        private volatile boolean running = true;\n\n        public TaskEventSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<TaskEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(new GZIPInputStream(new FileInputStream(filePath))))) {\n                String line;\n                while (running && (line = reader.readLine()) != null) {\n                    try {\n                        TaskEvent event = TaskEvent.fromCsv(line);\n                        if (event != null) {\n                            ctx.collect(event);\n                        }\n                    } catch (Exception e) {\n                        // Skip malformed lines\n                    }\n                }\n            }\n        }\n\n        @Override\n        public void cancel() {\n            running = false;\n        }\n    }\n\n    public static class JobEventSource implements SourceFunction<JobEvent> {\n        private final String filePath;\n        private volatile boolean running = true;\n\n        public JobEventSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<JobEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(new GZIPInputStream(new FileInputStream(filePath))))) {\n                String line;\n                while (running && (line = reader.readLine()) != null) {\n                    try {\n                        JobEvent event = JobEvent.fromCsv(line);\n                        if (event != null) {\n                            ctx.collect(event);\n                        }\n                    } catch (Exception e) {\n                        // Skip malformed lines\n                    }\n                }\n            }\n        }\n\n        @Override\n        public void cancel() {\n            running = false;\n        }\n    }\n}\n"},"sourceToolAssistantUUID":"72fa4e91-92b2-49ae-ab24-589a99e4897d"}
