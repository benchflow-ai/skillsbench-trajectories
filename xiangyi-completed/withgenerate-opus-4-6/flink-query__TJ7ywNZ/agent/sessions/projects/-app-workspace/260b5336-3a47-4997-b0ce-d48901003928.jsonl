ms.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV\n        DataStream<TaskEvent> taskEvents = env.readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        return TaskEvent.fromString(line);\n                    }\n                });\n\n        // Filter to SUBMIT events only (event_type == 0)\n        DataStream<TaskEvent> submitEvents = taskEvents\n                .filter(event -> event.eventType == 0);\n\n        // Assign event-time timestamps and watermarks\n        // Timestamps in data are in microseconds; Flink expects milliseconds\n        DataStream<TaskEvent> withTimestamps = submitEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ZERO)\n                                .withTimestampAssigner((event, ts) -> event.timestamp / 1000)\n                );\n\n        // Key by jobId, apply session windows with 10-minute gap\n        // Count tasks per session (stage)\n        DataStream<Tuple2<Long, Long>> stageCounts = withTimestamps\n                .keyBy(event -> event.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window,\n                                      Iterable<TaskEvent> input, Collector<Tuple2<Long, Long>> out) {\n                        long count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                });\n\n        // Find the maximum stage count per job (longest stage)\n        DataStream<Tuple2<Long, Long>> maxStagePerJob = stageCounts\n                .keyBy(t -> t.f0)\n                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\n                    @Override\n                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> a, Tuple2<Long, Long> b) {\n                        return a.f1 >= b.f1 ? a : b;\n                    }\n                });\n\n        // Write output to file\n        maxStagePerJob.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE)\n                .setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":267,"cache_read_input_tokens":54268,"cache_creation":{"ephemeral_5m_input_tokens":267,"ephemeral_1h_input_tokens":0},"output_tokens":1}},"requestId":"req_vrtx_011CXtEnwqquQtcbCv7oVNpP","type":"assistant","uuid":"75702526-665b-4485-8789-6e361d46c65e","timestamp":"2026-02-07T06:31:13.562Z"}
