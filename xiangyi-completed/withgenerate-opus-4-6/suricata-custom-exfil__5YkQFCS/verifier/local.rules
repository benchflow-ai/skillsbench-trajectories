# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"DATA EXFIL - Custom telemetry exfiltration detected"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; startswith; endswith; http.header; content:"x-tlm-mode: exfil"; http.request_body; content:"blob="; content:"sig="; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; pcre:"/sig=[0-9a-f]{64}([^0-9a-f]|$)/"; sid:1000001; rev:1;)
