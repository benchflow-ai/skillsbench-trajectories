# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert http $HOME_NET any -> any any (msg:"DATA EXFIL - Telemetry POST with encoded blob and signature"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; startswith; endswith; http.header; content:"x-tlm-mode|3a 20|exfil"; nocase; http.request_body; content:"blob="; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; pcre:"/sig=[0-9a-fA-F]{64}(&|$)/"; classtype:trojan-activity; sid:1000001; rev:1;)
