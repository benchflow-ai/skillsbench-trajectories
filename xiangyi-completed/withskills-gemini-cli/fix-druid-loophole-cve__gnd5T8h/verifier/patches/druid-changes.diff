diff --git a/processing/src/test/java/org/apache/druid/query/filter/JavaScriptDimFilterVulnerabilityTest.java b/processing/src/test/java/org/apache/druid/query/filter/JavaScriptDimFilterVulnerabilityTest.java
new file mode 100644
index 0000000000..66f5d107c7
--- /dev/null
+++ b/processing/src/test/java/org/apache/druid/query/filter/JavaScriptDimFilterVulnerabilityTest.java
@@ -0,0 +1,99 @@
+package org.apache.druid.query.filter;
+
+import com.fasterxml.jackson.databind.InjectableValues;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.apache.druid.jackson.DefaultObjectMapper;
+import org.apache.druid.js.JavaScriptConfig;
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.io.IOException;
+
+public class JavaScriptDimFilterVulnerabilityTest
+{
+  @Test
+  public void testVulnerabilityBypass() throws IOException
+  {
+    final ObjectMapper mapper = new DefaultObjectMapper();
+    final JavaScriptConfig disabledConfig = new JavaScriptConfig(false);
+    
+    final InjectableValues injectableValues = new InjectableValues.Std()
+        .addValue(JavaScriptConfig.class, disabledConfig);
+    
+    final String json = "{\n" +
+        "  \"type\": \"javascript\",\n" +
+        "  \"dimension\": \"dim\",\n" +
+        "  \"function\": \"function(x) { return true; }\",\n" +
+        "  \"\": {\n" +
+        "    \"enabled\": true\n" +
+        "  }\n" +
+        "}";
+    
+    final JavaScriptDimFilter filter = (JavaScriptDimFilter) mapper
+        .reader(injectableValues)
+        .forType(DimFilter.class)
+        .readValue(json);
+    
+    try {
+      filter.toFilter();
+      Assert.fail("Should have thrown IllegalStateException because JavaScript is disabled");
+    } catch (IllegalStateException e) {
+      Assert.assertEquals("JavaScript is disabled", e.getMessage());
+    }
+  }
+
+  @Test
+  public void testVulnerabilityBypassWithName() throws IOException
+  {
+    final ObjectMapper mapper = new DefaultObjectMapper();
+    final JavaScriptConfig disabledConfig = new JavaScriptConfig(false);
+    
+    final InjectableValues injectableValues = new InjectableValues.Std()
+        .addValue(JavaScriptConfig.class, disabledConfig);
+    
+    final String json = "{\n" +
+        "  \"type\": \"javascript\",\n" +
+        "  \"dimension\": \"dim\",\n" +
+        "  \"function\": \"function(x) { return true; }\",\n" +
+        "  \"config\": {\n" +
+        "    \"enabled\": true\n" +
+        "  }\n" +
+        "}";
+    
+    final JavaScriptDimFilter filter = (JavaScriptDimFilter) mapper
+        .reader(injectableValues)
+        .forType(DimFilter.class)
+        .readValue(json);
+    
+    try {
+      filter.toFilter();
+      Assert.fail("Should have thrown IllegalStateException because JavaScript is disabled");
+    } catch (IllegalStateException e) {
+      Assert.assertEquals("JavaScript is disabled", e.getMessage());
+    }
+  }
+
+  @Test
+  public void testLegitimateRequest() throws IOException
+  {
+    final ObjectMapper mapper = new DefaultObjectMapper();
+    final JavaScriptConfig enabledConfig = new JavaScriptConfig(true);
+    
+    final InjectableValues injectableValues = new InjectableValues.Std()
+        .addValue(JavaScriptConfig.class, enabledConfig);
+    
+    final String json = "{\n" +
+        "  \"type\": \"javascript\",\n" +
+        "  \"dimension\": \"dim\",\n" +
+        "  \"function\": \"function(x) { return true; }\"\n" +
+        "}";
+    
+    final JavaScriptDimFilter filter = (JavaScriptDimFilter) mapper
+        .reader(injectableValues)
+        .forType(DimFilter.class)
+        .readValue(json);
+    
+    // This should work
+    filter.toFilter();
+  }
+}
