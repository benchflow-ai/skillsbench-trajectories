index 0000000000..8cfd8fa24a
--- /dev/null
+++ b/processing/src/test/java/org/apache/druid/query/filter/JavaScriptDimFilterDeserializationTest.java
@@ -0,0 +1,38 @@
+package org.apache.druid.query.filter;
+
+import com.fasterxml.jackson.databind.InjectableValues;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.apache.druid.jackson.DefaultObjectMapper;
+import org.apache.druid.js.JavaScriptConfig;
+import org.junit.Assert;
+import org.junit.Test;
+import java.io.IOException;
+
+public class JavaScriptDimFilterDeserializationTest
+{
+  @Test
+  public void testVulnerability() throws IOException
+  {
+    ObjectMapper mapper = new DefaultObjectMapper();
+    JavaScriptConfig disabledConfig = new JavaScriptConfig(false);
+    mapper.setInjectableValues(new InjectableValues.Std().addValue(JavaScriptConfig.class, disabledConfig));
+
+    String json = "{" +
+        "\"type\": \"javascript\"," +
+        "\"dimension\": \"dim\"," +
+        "\"function\": \"function(x){return x}\"," +
+        "\"\": {\"enabled\": true}" +
+        "}";
+
+    JavaScriptDimFilter filter = (JavaScriptDimFilter) mapper.readValue(json, DimFilter.class);
+    
+    try {
+        filter.toFilter();
+        // If we reach here, JS is enabled.
+        // We injected FALSE. If the exploit works, it overrides with TRUE.
+        Assert.fail("Exploit succeeded: JavaScript was enabled via empty key override!");
+    } catch (IllegalStateException e) {
+        Assert.assertEquals("JavaScript is disabled", e.getMessage());
+    }
+  }
+}
