diff --git a/processing/src/test/java/org/apache/druid/query/filter/ReproductionTest.java b/processing/src/test/java/org/apache/druid/query/filter/ReproductionTest.java
new file mode 100644
index 0000000000..4b948ae72a
--- /dev/null
+++ b/processing/src/test/java/org/apache/druid/query/filter/ReproductionTest.java
@@ -0,0 +1,40 @@
+package org.apache.druid.query.filter;
+
+import com.fasterxml.jackson.databind.InjectableValues;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.apache.druid.js.JavaScriptConfig;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class ReproductionTest
+{
+  @Test
+  public void testExploit() throws Exception
+  {
+    ObjectMapper mapper = new ObjectMapper();
+    // Inject a DISABLED config
+    mapper.setInjectableValues(new InjectableValues.Std().addValue(JavaScriptConfig.class, new JavaScriptConfig(false)));
+
+    String json = "{ \"type\": \"javascript\", \"function\": \"function(x){ return true; }\", \"dimension\": \"some_dim\", \"\": { \"enabled\": true } }";
+
+    try {
+      JavaScriptDimFilter filter = (JavaScriptDimFilter) mapper.readValue(json, DimFilter.class);
+      // If we reach here, deserialization succeeded.
+      
+      // logic in getPredicateFactory checks config.isEnabled()
+      filter.toFilter();
+      
+      // If we get here, it means toFilter() succeeded, so config.isEnabled() was true!
+      Assert.fail("Vulnerability reproduced: JavaScript was executed despite being disabled in injection!");
+    } catch (com.fasterxml.jackson.databind.exc.UnrecognizedPropertyException e) {
+      // This is expected if the fix is working!
+      Assert.assertTrue(e.getMessage().contains("Unrecognized field \"\""));
+    } catch (IllegalStateException e) {
+       // This might happen if the vulnerability is NOT present but blocked by other means (unlikely here given previous runs)
+       if ("JavaScript is disabled".equals(e.getMessage())) {
+           // This would mean deserialization succeeded but checkState failed. 
+           // But with our fix, deserialization should fail.
+       }
+    }
+  }
+}
