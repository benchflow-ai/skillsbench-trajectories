 ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV, filter SUBMIT events (type 0)\n        List<TaskEvent> taskEventList = new ArrayList<>();\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(\n                new GZIPInputStream(new FileInputStream(taskInput))))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.trim().isEmpty()) continue;\n                try {\n                    TaskEvent te = TaskEvent.fromString(line);\n                    if (te.eventType == 0) { // SUBMIT\n                        taskEventList.add(te);\n                    }\n                } catch (Exception e) {\n                    // skip malformed lines\n                }\n            }\n        }\n\n        // Read job events from gzipped CSV, filter terminal events\n        List<JobEvent> jobEventList = new ArrayList<>();\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(\n                new GZIPInputStream(new FileInputStream(jobInput))))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.trim().isEmpty()) continue;\n                try {\n                    JobEvent je = JobEvent.fromString(line);\n                    // Terminal events: EVICT(2), FAIL(3), FINISH(4), KILL(5), LOST(6)\n                    if (je.eventType >= 2 && je.eventType <= 6) {\n                        jobEventList.add(je);\n                    }\n                } catch (Exception e) {\n                    // skip malformed lines\n                }\n            }\n        }\n\n        // Create task SUBMIT events stream with event time\n        // Timestamps in microseconds; convert to milliseconds for Flink\n        DataStream<TaskEvent> taskSubmitStream = env\n                .fromCollection(taskEventList)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(1))\n                                .withTimestampAssigner((SerializableTimestampAssigner<TaskEvent>)\n                                        (event, recordTimestamp) -> event.timestamp / 1000)\n                );\n\n        // Session window on task SUBMIT events keyed by jobId\n        // Gap = sesssize seconds (default 600 = 10 minutes)\n        DataStream<Tuple2<Long, Integer>> stageCounts = taskSubmitStream\n                .keyBy(TaskEvent::getJobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input,\n                                      Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (TaskEvent te : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                });\n\n        // Find max stage count per jobId\n        DataStream<Tuple2<Long, Integer>> maxStageCounts = stageCounts\n                .keyBy(t -> t.f0)\n                .reduce((ReduceFunction<Tuple2<Long, Integer>>) (t1, t2) ->\n                        new Tuple2<>(t1.f0, Math.max(t1.f1, t2.f1)));\n\n        // Create job terminal events stream\n        DataStream<JobEvent> jobTerminalStream = env\n                .fromCollection(jobEventList)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofSeconds(1))\n                                .withTimestampAssigner((SerializableTimestampAssigner<JobEvent>)\n                                        (event, recordTimestamp) -> event.timestamp / 1000)\n                );\n\n        // Map to Tuple2<jobId, 1> for the join signal\n        DataStream<Tuple2<Long, Integer>> finishedJobs = jobTerminalStream\n                .map((MapFunction<JobEvent, Tuple2<Long, Integer>>) je ->\n                        new Tuple2<>(je.jobId, 1))\n                .returns(Types.TUPLE(Types.LONG, Types.INT));\n\n        // Connect max stage counts with finished jobs to filter\n        DataStream<Tuple2<Long, Integer>> result = maxStageCounts\n                .keyBy(t -> t.f0)\n                .connect(finishedJobs.keyBy(t -> t.f0))\n                .process(new KeyedCoProcessFunction<Long, Tuple2<Long, Integer>, Tuple2<Long, Integer>, Tuple2<Long, Integer>>() {\n\n                    private ValueState<Integer> maxCountState;\n                    private ValueState<Boolean> jobFinishedState;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        maxCountState = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"maxCount\", Integer.class));\n                        jobFinishedState = getRuntimeContext().getState(\n                                new ValueStateDescriptor<>(\"jobFinished\", Boolean.class));\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Integer> stageCount,\n                                                KeyedCoProcessFunction<Long, Tuple2<Long, Integer>, Tuple2<Long, Integer>, Tuple2<Long, Integer>>.Context ctx,\n                                                Collector<Tuple2<Long, Integer>> out) throws Exception {\n                        Integer currentMax = maxCountState.value();\n                        int newMax = currentMax == null ? stageCount.f1 : Math.max(currentMax, stageCount.f1);\n                        maxCountState.update(newMax);\n\n                        Boolean finished = jobFinishedState.value();\n                        if (finished != null && finished) {\n                            out.collect(new Tuple2<>(stageCount.f0, newMax));\n                        }\n                    }\n\n                    @Override\n                    public void processElement2(Tuple2<Long, Integer> finishedSignal,\n                                                KeyedCoProcessFunction<Long, Tuple2<Long, Integer>, Tuple2<Long, Integer>, Tuple2<Long, Integer>>.Context ctx,\n                                                Collector<Tuple2<Long, Integer>> out) throws Exception {\n                        jobFinishedState.update(true);\n\n                        Integer currentMax = maxCountState.value();\n                        if (currentMax != null) {\n                            out.collect(new Tuple2<>(ctx.getCurrentKey(), currentMax));\n                        }\n                    }\n                });\n\n        // Deduplicate - take last emitted value per job (which has the correct max)\n        DataStream<Tuple2<Long, Integer>> finalResult = result\n                .keyBy(t -> t.f0)\n                .reduce((ReduceFunction<Tuple2<Long, Integer>>) (t1, t2) ->\n                        new Tuple2<>(t1.f0, Math.max(t1.f1, t2.f1)));\n\n        // Write to output file\n        finalResult\n                .map((MapFunction<Tuple2<Long, Integer>, String>) t ->\n                        \"(\" + t.f0 + \",\" + t.f1 + \")\")\n                .returns(Types.STRING)\n                .writeAsText(outputPath, org.apache.flink.core.fs.FileSystem.WriteMode.OVERWRITE)\n                .setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n}\n","numLines":196,"startLine":1,"totalLines":196}},"sourceToolAssistantUUID":"078374ba-d687-4429-bc74-661857921789"}
