# Full rule with precise matching
alert http any any -> any any ( \
    msg:"DATA EXFIL - Custom telemetry exfiltration pattern detected"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; bsize:20; \
    http.header; content:"X-TLM-Mode"; nocase; content:"exfil"; distance:0; within:10; \
    http.request_body; content:"blob="; content:"sig="; \
    pcre:"/blob=[A-Za-z0-9+\/=]{80,}/P"; \
    pcre:"/sig=[0-9a-fA-F]{64}([&\s]|$)/P"; \
    sid:1000001; rev:1; \
)
