ndowFunction;\nimport org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\nimport org.apache.flink.streaming.api.windowing.time.Time;\nimport org.apache.flink.streaming.api.windowing.windows.TimeWindow;\nimport org.apache.flink.core.fs.FileSystem;\nimport org.apache.flink.util.Collector;\nimport org.apache.flink.streaming.api.functions.sink.RichSinkFunction;\nimport org.apache.flink.configuration.Configuration;\nimport org.apache.flink.api.common.functions.RichFlatMapFunction;\nimport org.apache.flink.streaming.api.functions.co.RichCoFlatMapFunction;\nimport org.apache.flink.api.common.state.ValueState;\nimport org.apache.flink.api.common.state.ValueStateDescriptor;\nimport org.apache.flink.api.common.typeinfo.Types;\n\nimport java.io.BufferedWriter;\nimport java.io.FileWriter;\nimport java.io.PrintWriter;\nimport java.time.Duration;\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n        env.setParallelism(1);\n\n        // Read task events from gzipped CSV, filter to SUBMIT, assign timestamps\n        DataStream<TaskEvent> submitEvents = env.readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        return TaskEvent.fromCsv(line);\n                    }\n                })\n                .filter(event -> event.eventType == TaskEvent.SUBMIT)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(60))\n                                .withTimestampAssigner(new SerializableTimestampAssigner<TaskEvent>() {\n                                    @Override\n                                    public long extractTimestamp(TaskEvent event, long recordTimestamp) {\n                                        return event.timestamp / 1000; // microseconds to milliseconds\n                                    }\n                                })\n                );\n\n        // Session window per job: count SUBMIT events per session\n        DataStream<Tuple2<Long, Integer>> sessionCounts = submitEvents\n                .keyBy(event -> event.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> events, Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (TaskEvent e : events) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                });\n\n        // Read job events, filter to terminal events\n        DataStream<Long> finishedJobIds = env.readTextFile(jobInput)\n                .map(new MapFunction<String, JobEvent>() {\n                    @Override\n                    public JobEvent map(String line) throws Exception {\n                        return JobEvent.fromCsv(line);\n                    }\n                })\n                .filter(event -> event.eventType == JobEvent.FINISH\n                        || event.eventType == JobEvent.KILL\n                        || event.eventType == JobEvent.FAIL)\n                .map(new MapFunction<JobEvent, Long>() {\n                    @Override\n                    public Long map(JobEvent event) {\n                        return event.jobId;\n                    }\n                });\n\n        // Tag session counts as type 1, finished job IDs as type 2\n        // Union them into a single stream of Tuple2<Long, Integer>\n        // For session counts: (jobId, count) where count > 0\n        // For finished jobs: (jobId, -1) as a marker\n        DataStream<Tuple2<Long, Integer>> taggedSessionCounts = sessionCounts;\n\n        DataStream<Tuple2<Long, Integer>> taggedFinishedJobs = finishedJobIds\n                .map(new MapFunction<Long, Tuple2<Long, Integer>>() {\n                    @Override\n                    public Tuple2<Long, Integer> map(Long jobId) {\n                        return new Tuple2<>(jobId, -1); // marker for finished job\n                    }\n                });\n\n        // Union and collect in a custom sink\n        DataStream<Tuple2<Long, Integer>> combined = taggedSessionCounts.union(taggedFinishedJobs);\n\n        combined.addSink(new ResultSink(outputPath));\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    public static class ResultSink extends RichSinkFunction<Tuple2<Long, Integer>> {\n        private final String outputPath;\n        private final Map<Long, Integer> maxSessionPerJob = new HashMap<>();\n        private final Set<Long> finishedJobs = new HashSet<>();\n\n        public ResultSink(String outputPath) {\n            this.outputPath = outputPath;\n        }\n\n        @Override\n        public void invoke(Tuple2<Long, Integer> value, Context context) {\n            long jobId = value.f0;\n            int count = value.f1;\n            if (count == -1) {\n                // This is a finished job marker\n                finishedJobs.add(jobId);\n            } else {\n                // This is a session count\n                maxSessionPerJob.merge(jobId, count, Math::max);\n            }\n        }\n\n        @Override\n        public void close() throws Exception {\n            try (PrintWriter writer = new PrintWriter(new BufferedWriter(new FileWriter(outputPath)))) {\n                for (Map.Entry<Long, Integer> entry : maxSessionPerJob.entrySet()) {\n                    long jobId = entry.getKey();\n                    if (finishedJobs.contains(jobId)) {\n                        writer.println(\"(\" + jobId + \",\" + entry.getValue() + \")\");\n                    }\n                }\n            }\n            super.close();\n        }\n    }\n}\n","structuredPatch":[{"oldStart":16,"oldLines":23,"newStart":16,"newLines":22,"lines":[" import org.apache.flink.streaming.api.windowing.windows.TimeWindow;"," import org.apache.flink.core.fs.FileSystem;"," import org.apache.flink.util.Collector;","-import org.apache.flink.streaming.api.functions.sink.SinkFunction;","-import org.apache.flink.api.common.functions.ReduceFunction;","-import org.apache.flink.streaming.api.functions.co.RichCoFlatMapFunction;","+import org.apache.flink.streaming.api.functions.sink.RichSinkFunction;"," import org.apache.flink.configuration.Configuration;","+import org.apache.flink.api.common.functions.RichFlatMapFunction;","+import org.apache.flink.streaming.api.functions.co.RichCoFlatMapFunction;"," import org.apache.flink.api.common.state.ValueState;"," import org.apache.flink.api.common.state.ValueStateDescriptor;"," import org.apache.flink.api.common.typeinfo.Types;"," "," import java.io.BufferedWriter;"," import java.io.FileWriter;","+import java.io.PrintWriter;"," import java.time.Duration;"," import java.util.HashMap;"," import java.util.HashSet;"," import java.util.Map;"," import java.util.Set;","-import java.util.ArrayList;","-import java.util.List