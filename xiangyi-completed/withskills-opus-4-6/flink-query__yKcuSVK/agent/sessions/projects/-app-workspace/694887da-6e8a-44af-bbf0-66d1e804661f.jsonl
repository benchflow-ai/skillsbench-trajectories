args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV\n        DataStream<TaskEvent> taskEvents = env.readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        return TaskEvent.fromCsv(line);\n                    }\n                });\n\n        // Filter to SUBMIT events only\n        DataStream<TaskEvent> submitEvents = taskEvents\n                .filter(event -> event.eventType == TaskEvent.SUBMIT);\n\n        // Assign timestamps and watermarks based on event time (microseconds -> milliseconds)\n        DataStream<TaskEvent> timedSubmitEvents = submitEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner(new SerializableTimestampAssigner<TaskEvent>() {\n                                    @Override\n                                    public long extractTimestamp(TaskEvent event, long recordTimestamp) {\n                                        return event.timestamp / 1000; // microseconds to milliseconds\n                                    }\n                                })\n                );\n\n        // Key by jobId, session window with gap = sesssize seconds, count tasks per session\n        DataStream<Tuple2<Long, Integer>> sessionCounts = timedSubmitEvents\n                .keyBy(new KeySelector<TaskEvent, Long>() {\n                    @Override\n                    public Long getKey(TaskEvent event) {\n                        return event.jobId;\n                    }\n                })\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .reduce(new ReduceFunction<TaskEvent>() {\n                    @Override\n                    public TaskEvent reduce(TaskEvent t1, TaskEvent t2) {\n                        // Count by accumulating taskIndex field as counter\n                        TaskEvent result = new TaskEvent();\n                        result.jobId = t1.jobId;\n                        result.timestamp = Math.min(t1.timestamp, t2.timestamp);\n                        // Use priority field as accumulator for count\n                        result.priority = t1.priority + t2.priority;\n                        result.eventType = TaskEvent.SUBMIT;\n                        return result;\n                    }\n                })\n                .map(new MapFunction<TaskEvent, Tuple2<Long, Integer>>() {\n                    @Override\n                    public Tuple2<Long, Integer> map(TaskEvent event) {\n                        return new Tuple2<>(event.jobId, event.priority);\n                    }\n                });\n\n        // Hmm, the reduce approach won't work cleanly for counting since priority starts with the actual priority values.\n        // Let me use a different approach: map each SUBMIT to (jobId, 1) first, then use session window with sum.\n\n        // Actually, let me redo this properly. Map each submit event to Tuple2(jobId, 1), then session window + sum.\n        DataStream<Tuple2<Long, Integer>> submitCounts = timedSubmitEvents\n                .map(new MapFunction<TaskEvent, Tuple2<Long, Integer>>() {\n                    @Override\n                    public Tuple2<Long, Integer> map(TaskEvent event) {\n                        return new Tuple2<>(event.jobId, 1);\n                    }\n                })\n                .keyBy(t -> t.f0)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .sum(1);\n\n        // Find the max session count per jobId\n        DataStream<Tuple2<Long, Integer>> maxSessionPerJob = submitCounts\n                .keyBy(t -> t.f0)\n                .reduce(new ReduceFunction<Tuple2<Long, Integer>>() {\n                    @Override\n                    public Tuple2<Long, Integer> reduce(Tuple2<Long, Integer> v1, Tuple2<Long, Integer> v2) {\n                        return v1.f1 >= v2.f1 ? v1 : v2;\n                    }\n                });\n\n        // Read job events from gzipped CSV\n        DataStream<JobEvent> jobEventStream = env.readTextFile(jobInput)\n                .map(new MapFunction<String, JobEvent>() {\n                    @Override\n                    public JobEvent map(String line) throws Exception {\n                        return JobEvent.fromCsv(line);\n                    }\n                });\n\n        // Filter to terminal job events (job has finished)\n        DataStream<Long> finishedJobIds = jobEventStream\n                .filter(event -> event.eventType == JobEvent.FINISH\n                        || event.eventType == JobEvent.KILL\n                        || event.eventType == JobEvent.FAIL)\n                .map(new MapFunction<JobEvent, Long>() {\n                    @Override\n                    public Long map(JobEvent event) {\n                        return event.jobId;\n                    }\n                });\n\n        // Join maxSessionPerJob with finished jobs: use connect + CoFlatMap keyed by jobId\n        DataStream<String> result = maxSessionPerJob\n                .connect(finishedJobIds)\n                .keyBy(t -> t.f0, jobId -> jobId)\n                .flatMap(new CoFlatMapFunction<Tuple2<Long, Integer>, Long, String>() {\n                    private final Map<Long, Integer> sessionCounts = new HashMap<>();\n                    private final Set<Long> finishedJobs = new HashSet<>();\n\n                    @Override\n                    public void flatMap1(Tuple2<Long, Integer> sessionCount, Collector<String> out) {\n                        long jobId = sessionCount.f0;\n                        int count = sessionCount.f1;\n                        // Update max count for this job\n                        sessionCounts.merge(jobId, count, Math::max);\n                        if (finishedJobs.contains(jobId)) {\n                            out.collect(\"(\" + jobId + \",\" + sessionCounts.get(jobId) + \")\");\n                        }\n                    }\n\n                    @Override\n                    public void flatMap2(Long jobId, Collector<String> out) {\n                        finishedJobs.add(jobId);\n                        if (sessionCounts.containsKey(jobId)) {\n                            out.collect(\"(\" + jobId + \",\" + sessionCounts.get(jobId) + \")\");\n                        }\n                    }\n                });\n\n        result.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE)\n                .setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":30,"lines":[" package clusterdata.query;"," ","+import clusterdata.datatypes.JobEvent;","+import clusterdata.datatypes.TaskEvent;"," import clusterdata.utils.AppBase;","+import org.apache.flink.api.common.eventtime.SerializableTimestampAssigner;","+import org.apache.flink.api.common.eventtime.WatermarkStrategy;","+import org.apache.flink.api.common.functions.MapFunction;","+import org.apache.flink.api.common.functions.ReduceFunction;","+import org.apache.flink.api.java.functions.KeySelector;","+import org.apache.flink.api.java.tuple.Tuple2;"," import or