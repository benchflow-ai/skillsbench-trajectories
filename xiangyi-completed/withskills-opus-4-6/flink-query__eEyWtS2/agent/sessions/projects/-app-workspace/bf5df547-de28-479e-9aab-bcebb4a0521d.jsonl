a.io.BufferedReader;\nimport java.io.FileInputStream;\nimport java.io.InputStreamReader;\nimport java.time.Duration;\nimport java.util.zip.GZIPInputStream;\nimport java.util.HashSet;\nimport java.util.Set;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        // Collect finished job IDs first (job events with terminal event types)\n        Set<Long> finishedJobs = new HashSet<>();\n        if (jobInput != null) {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(new GZIPInputStream(new FileInputStream(jobInput))))) {\n                String line;\n                while ((line = reader.readLine()) != null) {\n                    JobEvent event = JobEvent.fromString(line);\n                    if (event != null && (event.eventType == 4 || event.eventType == 3\n                            || event.eventType == 5 || event.eventType == 2)) {\n                        finishedJobs.add(event.jobId);\n                    }\n                }\n            }\n        }\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events from gzipped CSV\n        DataStream<String> taskLines = env.readTextFile(taskInput);\n\n        // Parse task events, filter for SUBMIT (type 0), and filter for finished jobs\n        Set<Long> finishedJobsFinal = finishedJobs;\n        DataStream<Tuple2<Long, Long>> submitEvents = taskLines\n                .flatMap(new FlatMapFunction<String, Tuple2<Long, Long>>() {\n                    @Override\n                    public void flatMap(String line, Collector<Tuple2<Long, Long>> out) {\n                        TaskEvent event = TaskEvent.fromString(line);\n                        if (event != null && event.eventType == 0 && event.jobId >= 0\n                                && finishedJobsFinal.contains(event.jobId)) {\n                            // Tuple2<jobId, timestamp in microseconds>\n                            out.collect(new Tuple2<>(event.jobId, event.timestamp));\n                        }\n                    }\n                });\n\n        // Assign timestamps and watermarks\n        // Timestamps in dataset are microseconds, convert to milliseconds for Flink\n        DataStream<Tuple2<Long, Long>> withTimestamps = submitEvents\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<Tuple2<Long, Long>>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n                                .withTimestampAssigner((event, ts) -> event.f1 / 1000)\n                );\n\n        // Session window with sesssize gap (default 600 seconds = 10 minutes)\n        // Count tasks per session per job\n        DataStream<Tuple2<Long, Integer>> sessionCounts = withTimestamps\n                .keyBy(new KeySelector<Tuple2<Long, Long>, Long>() {\n                    @Override\n                    public Long getKey(Tuple2<Long, Long> value) {\n                        return value.f0;\n                    }\n                })\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .apply(new WindowFunction<Tuple2<Long, Long>, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window,\n                                      Iterable<Tuple2<Long, Long>> input,\n                                      Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (Tuple2<Long, Long> ignored : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                });\n\n        // Find max session count per job\n        DataStream<Tuple2<Long, Integer>> maxPerJob = sessionCounts\n                .keyBy(new KeySelector<Tuple2<Long, Integer>, Long>() {\n                    @Override\n                    public Long getKey(Tuple2<Long, Integer> value) {\n                        return value.f0;\n                    }\n                })\n                .reduce(new ReduceFunction<Tuple2<Long, Integer>>() {\n                    @Override\n                    public Tuple2<Long, Integer> reduce(Tuple2<Long, Integer> v1,\n                                                         Tuple2<Long, Integer> v2) {\n                        return v1.f1 >= v2.f1 ? v1 : v2;\n                    }\n                });\n\n        // Format output as (jobId,count)\n        DataStream<String> result = maxPerJob\n                .map(new MapFunction<Tuple2<Long, Integer>, String>() {\n                    @Override\n                    public String map(Tuple2<Long, Integer> value) {\n                        return \"(\" + value.f0 + \",\" + value.f1 + \")\";\n                    }\n                });\n\n        // Write output\n        if (outputPath != null) {\n            result.writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE).setParallelism(1);\n        } else {\n            result.print();\n        }\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n}\n","structuredPatch":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":34,"lines":[" package clusterdata.query;"," ","+import clusterdata.datatypes.JobEvent;","+import clusterdata.datatypes.TaskEvent;"," import clusterdata.utils.AppBase;","+import org.apache.fli