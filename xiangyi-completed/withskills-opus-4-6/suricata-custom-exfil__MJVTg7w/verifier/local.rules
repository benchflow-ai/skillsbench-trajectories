# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any ( \
    msg:"DATA EXFIL - Custom telemetry exfiltration detected"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; bsize:20; \
    http.header; content:"x-tlm-mode"; nocase; content:"exfil"; nocase; distance:0; within:20; \
    http.request_body; content:"blob="; \
    pcre:"/^[A-Za-z0-9+\/]{80,}/R"; \
    content:"sig="; \
    pcre:"/^[0-9a-fA-F]{64}(&|$)/R"; \
    classtype:trojan-activity; \
    sid:1000001; rev:1; \
)
