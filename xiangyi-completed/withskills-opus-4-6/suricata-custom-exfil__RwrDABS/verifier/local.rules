# Detect data exfiltration hidden in HTTP telemetry traffic.
# Matches HTTP POST to /telemetry/v2/report with X-TLM-Mode: exfil header,
# body containing blob= with >=80 Base64 chars, and sig= with exactly 64 hex chars.
alert http any any -> any any ( \
    msg:"DATA EXFIL via telemetry POST"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; bsize:20; \
    http.header; content:"x-tlm-mode: exfil"; \
    http.request_body; content:"blob="; content:"sig="; \
    pcre:"/blob=[A-Za-z0-9\+\/\=]{80,}/"; \
    pcre:"/sig=[0-9a-fA-F]{64}([&\s]|$)/"; \
    sid:1000001; rev:1; \
)
