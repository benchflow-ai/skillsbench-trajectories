 public class GuiceAnnotationIntrospector extends NopAnnotationIntrospector
 {
+  @Override
+  public JacksonInject.Value findInjectableValue(AnnotatedMember m)
+  {
+    if (m.getAnnotation(JacksonInject.class) == null) {
+      return null;
+    }
+
+    // Use findInjectableValueId to get the Guice Key, then wrap it in a
+    // JacksonInject.Value with useInput=false so that values from JSON input
+    // can never override Guice-injected values. This prevents the empty-key
+    // ("") bypass attack where an attacker supplies {"": {"enabled": true}}
+    // to override security configuration like JavaScriptConfig.
+    Object valueId = findInjectableValueId(m);
+    if (valueId == null) {
+      return null;
+    }
+    return JacksonInject.Value.forId(valueId).withUseInput(false);
+  }
