{"parentUuid":"cb521fee-1223-4d5c-ab4c-d40c5eac761d","isSidechain":false,"userType":"external","cwd":"/app","sessionId":"50ac3936-1935-4f6a-97ab-33616a432456","version":"2.1.19","gitBranch":"","slug":"greedy-tumbling-harbor","message":{"model":"claude-opus-4-6","id":"msg_vrtx_01AiSqvee6Jtv2Bjp5kJyRiW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_vrtx_01UwXrn3LRDByjUCEF1mtff7","name":"Write","input":{"file_path":"/app/compute_all.py","content":"import os, json, math\nimport pandas as pd\nimport numpy as np\n\nDATA_DIR = \"/app/data\"\nOUT_DIR  = \"/app/output\"\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# ---------------------------------------------------------------------------\n# Load data\n# ---------------------------------------------------------------------------\nruns = pd.read_csv(os.path.join(DATA_DIR, \"mes_log.csv\"))\ntc   = pd.read_csv(os.path.join(DATA_DIR, \"thermocouples.csv\"))\ndefects = pd.read_csv(os.path.join(DATA_DIR, \"test_defects.csv\"))\n\nruns[\"run_id\"] = runs[\"run_id\"].astype(str)\ntc[\"run_id\"]   = tc[\"run_id\"].astype(str)\ntc[\"tc_id\"]    = tc[\"tc_id\"].astype(str)\ndefects[\"run_id\"] = defects[\"run_id\"].astype(str)\n\nruns = runs.sort_values(\"run_id\", kind=\"mergesort\").reset_index(drop=True)\ntc   = tc.sort_values([\"run_id\",\"tc_id\",\"time_s\"], kind=\"mergesort\").reset_index(drop=True)\n\nall_run_ids = sorted(runs[\"run_id\"].unique())\n\n# ---------------------------------------------------------------------------\n# Handbook-derived configuration\n# ---------------------------------------------------------------------------\n# Preheat region: 100°C to 150°C (handbook page 5)\nPREHEAT_TMIN = 100.0\nPREHEAT_TMAX = 150.0\n\n# Ramp rate limit: 2°C/s (handbook page 5 & 10)\nRAMP_LIMIT = 2.0\n\n# TAL/Wetting time window: 30–60 seconds (handbook page 5)\nTAL_MIN_S = 30.0\nTAL_MAX_S = 60.0\n\n# Peak temperature: liquidus + 20°C (handbook page 5)\nPEAK_MARGIN_C = 20.0\n\n# Conveyor speed: minimum line speed = boards_per_min * board_length_cm / loading_factor\n# (handbook page 14: LINE SPEED (MINIMUM) = BOARDS PER MINUTE × LENGTH PER BOARD / LOAD FACTOR)\n\n# Representative thermocouple: TC on largest mass component (handbook page 8:\n# \"thermocoupling a lead on the largest and smallest device\" – the largest mass\n# is the worst-case cold spot, hardest to heat, most representative for compliance)\n# TC1 = largest_mass in data\n\n# ---------------------------------------------------------------------------\n# Helper functions\n# ---------------------------------------------------------------------------\ndef r2(x):\n    \"\"\"Round to 2 decimals, None/NaN/Inf → None.\"\"\"\n    if x is None:\n        return None\n    if isinstance(x, float) and (math.isnan(x) or math.isinf(x)):\n        return None\n    return round(float(x), 2)\n\n\ndef max_slope_in_temp_band(group_df, tmin, tmax):\n    \"\"\"Max finite-difference slope where both endpoints are in [tmin, tmax].\"\"\"\n    g = group_df.sort_values(\"time_s\")\n    t = g[\"time_s\"].to_numpy(dtype=float)\n    y = g[\"temp_c\"].to_numpy(dtype=float)\n    best = None\n    for i in range(1, len(t)):\n        dt = t[i] - t[i-1]\n        if dt <= 0:\n            continue\n        if (tmin <= y[i-1] <= tmax) and (tmin <= y[i] <= tmax):\n            s = (y[i] - y[i-1]) / dt\n            best = s if best is None else max(best, s)\n    return best\n\n\ndef time_above_threshold_s(group_df, thr):\n    \"\"\"Time above threshold with linear interpolation at crossings.\"\"\"\n    g = group_df.sort_values(\"time_s\")\n    t = g[\"time_s\"].to_numpy(dtype=float)\n    y = g[\"temp_c\"].to_numpy(dtype=float)\n    total = 0.0\n    for i in range(1, len(t)):\n        t0, t1 = t[i-1], t[i]\n        y0, y1 = y[i-1], y[i]\n        if t1 <= t0:\n            continue\n        # fully above\n        if y0 > thr and y1 > thr:\n            total += (t1 - t0)\n            continue\n        # crossing: interpolate crossing time\n        crosses = (y0 <= thr < y1) or (y1 <= thr < y0)\n        if crosses and (y1 != y0):\n            frac = (thr - y0) / (y1 - y0)\n            tcross = t0 + frac * (t1 - t0)\n            if y0 <= thr and y1 > thr:\n                total += (t1 - tcross)\n            else:\n                total += (tcross - t0)\n    return total\n\n\n# ====================================================================\n# Q1: Max preheat ramp rate per run\n# ====================================================================\n# Handbook: preheat 100–150°C, max ramp < 2°C/s\n# Representative TC: largest_mass (TC1) – the cold spot, worst case\n# For ramp rate, we want the maximum ramp rate among TCs to find violations,\n# but handbook says to thermocouple on largest and smallest device. The largest\n# mass TC is the representative \"worst case\" sensor per handbook guidance.\n# However, for ramp rate specifically, the concern is thermal shock – the max\n# ramp rate among all TCs would be the most representative of the worst case.\n# The handbook says \"minimize the rate of rise\" – so we select the TC with the\n# highest max ramp rate as it represents the worst case for thermal shock.\n\nq1_max_ramp_by_run = {}\nfor run_id in all_run_ids:\n    run_tc = tc[tc[\"run_id\"] == run_id]\n    best_val = None\n    best_tc = None\n    for tc_id in sorted(run_tc[\"tc_id\"].unique()):\n        tc_data = run_tc[run_tc[\"tc_id\"] == tc_id]\n        slope = max_slope_in_temp_band(tc_data, PREHEAT_TMIN, PREHEAT_TMAX)\n        if slope is not None:\n            if best_val is None or slope > best_val or (slope == best_val and tc_id < best_tc):\n                best_val = slope\n                best_tc = tc_id\n    q1_max_ramp_by_run[run_id] = {\"tc_id\": best_tc, \"max_preheat_ramp_c_per_s\": r2(best_val)}\n\nviolating_runs = sorted([rid for rid, v in q1_max_ramp_by_run.items()\n                         if v[\"max_preheat_ramp_c_per_s\"] is not None\n                         and v[\"max_preheat_ramp_c_per_s\"] > RAMP_LIMIT])\n\nq1 = {\n    \"ramp_rate_limit_c_per_s\": RAMP_LIMIT,\n    \"violating_runs\": violating_runs,\n    \"max_ramp_by_run\": {k: q1_max_ramp_by_run[k] for k in sorted(q1_max_ramp_by_run)}\n}\n\nwith open(os.path.join(OUT_DIR, \"q01.json\"), \"w\") as f:\n    json.dump(q1, f, indent=2)\nprint(\"Q1 done. Violating runs:\", violating_runs)\n\n\n# ====================================================================\n# Q2: TAL (Time Above Liquidus) per run\n# ====================================================================\n# Handbook: wetting time 30–60s, threshold = solder liquidus from MES\n# Representative TC: largest_mass (TC1) – cold spot gives minimum TAL (worst case)\n# For TAL, the coldest TC gives the shortest TAL – that's the limiting case.\n\nq2 = []\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    liquidus = float(run_info[\"solder_liquidus_c\"])\n    run_tc = tc[tc[\"run_id\"] == run_id]\n\n    # Find TC with minimum TAL (worst case = coldest spot)\n    best_val = None\n    best_tc = None\n    for tc_id in sorted(run_tc[\"tc_id\"].unique()):\n        tc_data = run_tc[run_tc[\"tc_id\"] == tc_id]\n        tal = time_above_threshold_s(tc_data, liquidus)\n        if best_val is None or tal < best_val or (tal == best_val and tc_id < best_tc):\n            best_val = tal\n            best_tc = tc_id\n\n    if best_val is not None:\n        status = \"compliant\" if TAL_MIN_S <= best_val <= TAL_MAX_S else \"non-compliant\"\n    else:\n        status = \"non-compliant\"\n\n    q2.append({\n        \"run_id\": run_id,\n        \"tc_id\": best_tc,\n        \"tal_s\": r2(best_val),\n        \"required_min_tal_s\": TAL_MIN_S,\n        \"required_max_tal_s\": TAL_MAX_S,\n        \"status\": status\n    })\n\nq2 = sorted(q2, key=lambda x: x[\"run_id\"])\n\nwith open(os.path.join(OUT_DIR, \"q02.json\"), \"w\") as f:\n    json.dump(q2, f, indent=2)\nprint(\"Q2 done. Non-compliant:\", [x[\"run_id\"] for x in q2 if x[\"status\"] == \"non-compliant\"])\n\n\n# ====================================================================\n# Q3: Peak temperature requirement per run\n# ====================================================================\n# Handbook: peak must exceed liquidus by ~20°C\n# Representative TC: use the TC with minimum peak (coldest spot = worst case)\n# A run fails if its coldest TC peak < required_min_peak\n\nq3_min_peak = {}\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    liquidus = float(run_info[\"solder_liquidus_c\"])\n    required_min = liquidus + PEAK_MARGIN_C\n    run_tc = tc[tc[\"run_id\"] == run_id]\n\n    best_val = None\n    best_tc = None\n    if len(run_tc) == 0:\n        q3_min_peak[run_id] = {\n            \"tc_id\": None,\n            \"peak_temp_c\": None,\n            \"required_min_peak_c\": r2(required_min)\n        }\n        continue\n\n    for tc_id in sorted(run_tc[\"tc_id\"].unique()):\n        tc_data = run_tc[run_tc[\"tc_id\"] == tc_id]\n        peak = float(tc_data[\"temp_c\"].max())\n        if best_val is None or peak < best_val or (peak == best_val and tc_id < best_tc):\n            best_val = peak\n            best_tc = tc_id\n\n    q3_min_peak[run_id] = {\n        \"tc_id\": best_tc,\n        \"peak_temp_c\": r2(best_val),\n        \"required_min_peak_c\": r2(required_min)\n    }\n\nfailing_runs = sorted([rid for rid, v in q3_min_peak.items()\n                        if v[\"peak_temp_c\"] is None\n                        or v[\"peak_temp_c\"] < v[\"required_min_peak_c\"]])\n\nq3 = {\n    \"failing_runs\": failing_runs,\n    \"min_peak_by_run\": {k: q3_min_peak[k] for k in sorted(q3_min_peak)}\n}\n\nwith open(os.path.join(OUT_DIR, \"q03.json\"), \"w\") as f:\n    json.dump(q3, f, indent=2)\nprint(\"Q3 done. Failing runs:\", failing_runs)\n\n\n# ====================================================================\n# Q4: Conveyor speed feasibility per run\n# ====================================================================\n# Handbook: LINE SPEED (MINIMUM) = BOARDS PER MINUTE × LENGTH PER BOARD / LOAD FACTOR\n# The actual speed must be >= this minimum to avoid jams\n\nq4 = []\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    boards_per_min = float(run_info[\"boards_per_min\"])\n    board_length_cm = float(run_info[\"board_length_cm\"])\n    loading_factor = float(run_info[\"loading_factor\"])\n    actual_speed = float(run_info[\"conveyor_speed_cm_min\"])\n\n    required_min_speed = (boards_per_min * board_length_cm) / loading_factor\n    meets = actual_speed >= required_min_speed\n\n    q4.append({\n        \"run_id\": run_id,\n        \"required_min_speed_cm_min\": r2(required_min_speed),\n        \"actual_speed_cm_min\": r2(actual_speed),\n        \"meets\": meets\n    })\n\nq4 = sorted(q4, key=lambda x: x[\"run_id\"])\n\nwith open(os.path.join(OUT_DIR, \"q04.json\"), \"w\") as f:\n    json.dump(q4, f, indent=2)\nprint(\"Q4 done. Not meeting:\", [x[\"run_id\"] for x in q4 if not x[\"meets\"]])\n\n\n# ====================================================================\n# Q5: Best run per board_family\n# ====================================================================\n# Selection based on quality (yield, defect count) and efficiency (throughput)\n# From test_defects: use SUMMARY rows for yield\n# Quality is primary; efficiency is secondary\n\nsummary = defects[defects[\"inspection_stage\"] == \"SUMMARY\"].copy()\nsummary = summary[[\"run_id\", \"fp_yield_pct\", \"count\"]].copy()\nsummary[\"fp_yield_pct\"] = summary[\"fp_yield_pct\"].astype(float)\nsummary[\"count\"] = summary[\"count\"].astype(int)  # total defect count\n\n# Merge with runs for board_family and throughput info\nmerged = runs[[\"run_id\", \"board_family\", \"conveyor_speed_cm_min\", \"boards_per_min\"]].merge(\n    summary, on=\"run_id\", how=\"left\"\n)\n# Fill missing yield with 0 (no data = worst)\nmerged[\"fp_yield_pct\"]