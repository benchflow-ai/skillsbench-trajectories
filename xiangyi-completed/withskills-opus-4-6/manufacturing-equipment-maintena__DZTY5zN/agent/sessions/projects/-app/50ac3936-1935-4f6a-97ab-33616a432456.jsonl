if v[\"max_preheat_ramp_c_per_s\"] is not None\n                         and v[\"max_preheat_ramp_c_per_s\"] > RAMP_LIMIT])\n\nq1 = {\n    \"ramp_rate_limit_c_per_s\": RAMP_LIMIT,\n    \"violating_runs\": violating_runs,\n    \"max_ramp_by_run\": {k: q1_max_ramp_by_run[k] for k in sorted(q1_max_ramp_by_run)}\n}\n\nwith open(os.path.join(OUT_DIR, \"q01.json\"), \"w\") as f:\n    json.dump(q1, f, indent=2)\nprint(\"Q1 done. Violating runs:\", violating_runs)\n\n\n# ====================================================================\n# Q2: TAL (Time Above Liquidus) per run\n# ====================================================================\n# Handbook: wetting time 30–60s, threshold = solder liquidus from MES\n# Representative TC: largest_mass (TC1) – cold spot gives minimum TAL (worst case)\n# For TAL, the coldest TC gives the shortest TAL – that's the limiting case.\n\nq2 = []\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    liquidus = float(run_info[\"solder_liquidus_c\"])\n    run_tc = tc[tc[\"run_id\"] == run_id]\n\n    # Find TC with minimum TAL (worst case = coldest spot)\n    best_val = None\n    best_tc = None\n    for tc_id in sorted(run_tc[\"tc_id\"].unique()):\n        tc_data = run_tc[run_tc[\"tc_id\"] == tc_id]\n        tal = time_above_threshold_s(tc_data, liquidus)\n        if best_val is None or tal < best_val or (tal == best_val and tc_id < best_tc):\n            best_val = tal\n            best_tc = tc_id\n\n    if best_val is not None:\n        status = \"compliant\" if TAL_MIN_S <= best_val <= TAL_MAX_S else \"non-compliant\"\n    else:\n        status = \"non-compliant\"\n\n    q2.append({\n        \"run_id\": run_id,\n        \"tc_id\": best_tc,\n        \"tal_s\": r2(best_val),\n        \"required_min_tal_s\": TAL_MIN_S,\n        \"required_max_tal_s\": TAL_MAX_S,\n        \"status\": status\n    })\n\nq2 = sorted(q2, key=lambda x: x[\"run_id\"])\n\nwith open(os.path.join(OUT_DIR, \"q02.json\"), \"w\") as f:\n    json.dump(q2, f, indent=2)\nprint(\"Q2 done. Non-compliant:\", [x[\"run_id\"] for x in q2 if x[\"status\"] == \"non-compliant\"])\n\n\n# ====================================================================\n# Q3: Peak temperature requirement per run\n# ====================================================================\n# Handbook: peak must exceed liquidus by ~20°C\n# Representative TC: use the TC with minimum peak (coldest spot = worst case)\n# A run fails if its coldest TC peak < required_min_peak\n\nq3_min_peak = {}\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    liquidus = float(run_info[\"solder_liquidus_c\"])\n    required_min = liquidus + PEAK_MARGIN_C\n    run_tc = tc[tc[\"run_id\"] == run_id]\n\n    best_val = None\n    best_tc = None\n    if len(run_tc) == 0:\n        q3_min_peak[run_id] = {\n            \"tc_id\": None,\n            \"peak_temp_c\": None,\n            \"required_min_peak_c\": r2(required_min)\n        }\n        continue\n\n    for tc_id in sorted(run_tc[\"tc_id\"].unique()):\n        tc_data = run_tc[run_tc[\"tc_id\"] == tc_id]\n        peak = float(tc_data[\"temp_c\"].max())\n        if best_val is None or peak < best_val or (peak == best_val and tc_id < best_tc):\n            best_val = peak\n            best_tc = tc_id\n\n    q3_min_peak[run_id] = {\n        \"tc_id\": best_tc,\n        \"peak_temp_c\": r2(best_val),\n        \"required_min_peak_c\": r2(required_min)\n    }\n\nfailing_runs = sorted([rid for rid, v in q3_min_peak.items()\n                        if v[\"peak_temp_c\"] is None\n                        or v[\"peak_temp_c\"] < v[\"required_min_peak_c\"]])\n\nq3 = {\n    \"failing_runs\": failing_runs,\n    \"min_peak_by_run\": {k: q3_min_peak[k] for k in sorted(q3_min_peak)}\n}\n\nwith open(os.path.join(OUT_DIR, \"q03.json\"), \"w\") as f:\n    json.dump(q3, f, indent=2)\nprint(\"Q3 done. Failing runs:\", failing_runs)\n\n\n# ====================================================================\n# Q4: Conveyor speed feasibility per run\n# ====================================================================\n# Handbook: LINE SPEED (MINIMUM) = BOARDS PER MINUTE × LENGTH PER BOARD / LOAD FACTOR\n# The actual speed must be >= this minimum to avoid jams\n\nq4 = []\nfor run_id in all_run_ids:\n    run_info = runs[runs[\"run_id\"] == run_id].iloc[0]\n    boards_per_min = float(run_info[\"boards_per_min\"])\n    board_length_cm = float(run_info[\"board_length_cm\"])\n    loading_factor = float(run_info[\"loading_factor\"])\n    actual_speed = float(run_info[\"conveyor_speed_cm_min\"])\n\n    required_min_speed = (boards_per_min * board_length_cm) / loading_factor\n    meets = actual_speed >= required_min_speed\n\n    q4.append({\n        \"run_id\": run_id,\n        \"required_min_speed_cm_min\": r2(required_min_speed),\n        \"actual_speed_cm_min\": r2(actual_speed),\n        \"meets\": meets\n    })\n\nq4 = sorted(q4, key=lambda x: x[\"run_id\"])\n\nwith open(os.path.join(OUT_DIR, \"q04.json\"), \"w\") as f:\n    json.dump(q4, f, indent=2)\nprint(\"Q4 done. Not meeting:\", [x[\"run_id\"] for x in q4 if not x[\"meets\"]])\n\n\n# ====================================================================\n# Q5: Best run per board_family\n# ====================================================================\n# Selection based on quality (yield, defect count) and efficiency (throughput)\n# From test_defects: use SUMMARY rows for yield\n# Quality is primary; efficiency is secondary\n\nsummary = defects[defects[\"inspection_stage\"] == \"SUMMARY\"].copy()\nsummary = summary[[\"run_id\", \"fp_yield_pct\", \"count\"]].copy()\nsummary[\"fp_yield_pct\"] = summary[\"fp_yield_pct\"].astype(float)\nsummary[\"count\"] = summary[\"count\"].astype(int)  # total defect count\n\n# Merge with runs for board_family and throughput info\nmerged = runs[[\"run_id\", \"board_family\", \"conveyor_speed_cm_min\", \"boards_per_min\"]].merge(\n    summary, on=\"run_id\", how=\"left\"\n)\n# Fill missing yield with 0 (no data = worst)\nmerged[\"fp_yield_pct\"] = merged[\"fp_yield_pct\"].fillna(0.0)\nmerged[\"count\"] = merged[\"count\"].fillna(999).astype(int)\n\nq5 = []\nfor bf in sorted(merged[\"board_family\"].unique()):\n    bf_runs = merged[merged[\"board_family\"] == bf].copy()\n    # Sort: highest yield first, then lowest defect count, then highest throughput, then run_id\n    bf_runs = bf_runs.sort_values(\n        [\"fp_yield_pct\", \"count\", \"boards_per_min\", \"run_id\"],\n        ascending=[False, True, False, True]\n    ).reset_index(drop=True)\n\n    best_run = bf_runs.iloc[0][\"run_id\"]\n    runner_ups = sorted(bf_runs.iloc[1:][\"run_id\"].tolist())\n\n    q5.append({\n        \"board_family\": bf,\n        \"best_run_id\": best_run,\n        \"runner_up_run_ids\": runner_ups\n    })\n\nq5 = sorted(q5, key=lambda x: x[\"board_family\"])\n\nwith open(os.path.join(OUT_DIR, \"q05.json\"), \"w\") as f:\n    json.dump(q5, f, indent=2)\nprint(\"Q5 done.\")\nprint(\"Best runs per board_family:\")\nfor entry in q5:\n    print(f\"  {entry['board_family']}: {entry['best_run_id']}\")\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"7228a619-e721-4cc1-a41c-cb1744a7a09a"}
