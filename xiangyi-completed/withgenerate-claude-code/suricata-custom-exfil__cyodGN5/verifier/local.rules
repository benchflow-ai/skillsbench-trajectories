# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any ( \
    msg:"Custom data exfiltration pattern detected"; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; bsize:20; \
    http.header; content:"x-tlm-mode"; nocase; content:"exfil"; distance:0; within:10; \
    http.request_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}.*sig=[0-9a-fA-F]{64}(?![0-9a-fA-F])/s"; \
    sid:1000001; rev:1; \
)
