# Suricata signature for detecting HTTP exfiltration via telemetry endpoint
# Alerts on POST to /telemetry/v2/report with X-TLM-Mode: exfil header,
# containing Base64 blob >= 80 chars and exactly 64 hex signature chars
alert http any any -> any any (msg:"HTTP Exfiltration via Telemetry - Suspicious Blob and Signature"; flow:to_server,established; http.method:POST; http.uri:"/telemetry/v2/report"; http.header:"X-TLM-Mode"|contains:"exfil"; http.client_body; pcre:"/blob=([A-Za-z0-9+/=]{80,})/"; pcre:"/sig=([0-9a-fA-F]{64})/"; sid:1000001; rev:1; classtype:attempted-admin; priority:1;)
