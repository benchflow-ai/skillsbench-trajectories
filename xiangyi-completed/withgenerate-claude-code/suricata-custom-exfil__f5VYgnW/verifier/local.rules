# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Data Exfiltration via Custom Telemetry Pattern"; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"X-TLM-Mode"; nocase; content:": exfil"; nocase; within:20; http.request_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; http.request_body; pcre:"/sig=[a-f0-9]{64}/"; sid:1000001; rev:1;)
