# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Custom Data Exfiltration Pattern Detected"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"X-TLM-Mode"; nocase; content:"exfil"; nocase; distance:0; within:10; http.request_body; content:"blob="; pcre:"/[A-Za-z0-9+\/]{80,}/R"; content:"sig="; distance:0; pcre:"/[0-9a-fA-F]{64}(?![0-9a-fA-F])/R"; sid:1000001; rev:1;)
