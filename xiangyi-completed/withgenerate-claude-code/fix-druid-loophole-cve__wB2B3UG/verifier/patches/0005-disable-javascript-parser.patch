From: Security Fix <security@example.com>
Date: Wed, 29 Jan 2026 00:00:00 +0000
Subject: [PATCH] Disable JavaScript parser to prevent RCE vulnerability

Disable JavaScript parsing functionality to prevent remote code execution.
JavaScript parsers in data input specifications can be exploited to execute
arbitrary system commands through sampler requests.

---
 .../data/input/impl/JavaScriptParseSpec.java | 20 +++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
index 1234567..abcdefg 100644
--- a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
+++ b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
@@ -50,6 +50,12 @@ public class JavaScriptParseSpec implements ParseSpec
       this.function = function;
       this.config = config;

+      // SECURITY FIX: Disable JavaScript parser to prevent RCE
+      if (!config.isEnabled()) {
+        throw new IllegalArgumentException(
+            "JavaScript parsers are disabled for security reasons. Please use other parser types.");
+      }
+
       // Closure factory is set lazy to avoid loading of javascript engine if not needed
     }
