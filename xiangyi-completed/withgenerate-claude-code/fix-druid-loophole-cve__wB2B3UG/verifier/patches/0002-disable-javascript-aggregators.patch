From: Security Fix <security@example.com>
Date: Wed, 29 Jan 2026 00:00:00 +0000
Subject: [PATCH] Disable JavaScript aggregators to prevent RCE vulnerability

Disable JavaScript aggregator expressions to prevent remote code execution.
JavaScript aggregators can be exploited similarly to filters through the
sampler endpoint to execute arbitrary system commands.

---
 .../aggregation/JavaScriptAggregatorFactory.java | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java b/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
index 1234567..abcdefg 100644
--- a/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
+++ b/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
@@ -65,6 +65,12 @@ public class JavaScriptAggregatorFactory extends AggregatorFactory
       this.finalizeFunction = finalizeFunction;
       this.cacheKeyPrefix = cacheKeyPrefix;

+      // SECURITY FIX: Disable JavaScript aggregators to prevent RCE
+      if (!config.isEnabled()) {
+        throw new IllegalArgumentException(
+            "JavaScript aggregators are disabled for security reasons. Please use other aggregator types.");
+      }
+
       // These are not saved to cache key because they are not part of the output
       this.config = config;
     }
