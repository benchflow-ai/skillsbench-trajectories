# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any ( \
    msg:"Suspected data exfiltration via telemetry endpoint"; \
    flow:to_server,established; \
    http.method; content:"POST"; \
    http.uri; content:"/telemetry/v2/report"; startswith; endswith; \
    http.header; content:"x-tlm-mode"; content:"exfil"; \
    http.request_body; content:"blob="; \
    http.request_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; \
    http.request_body; content:"sig="; \
    http.request_body; pcre:"/sig=[a-fA-F0-9]{64}(?![a-fA-F0-9])/"; \
    classtype:trojan-activity; \
    sid:1000001; \
    rev:1; \
)
