oken_id\n   247→        # self.padding_value = args.padding_value if args.padding_value is not None else tokenizer.pad_token_id\n   248→        # self.max_prompt_length = max_prompt_length\n   249→        # self.truncation_mode = args.truncation_mode\n   250→        # self.max_target_length = max_target_length\n   251→        # self.tokenizer = tokenizer\n   252→\n   253→        # if args.loss_type in [\"hinge\"] and args.label_smoothing > 0:\n   254→        #     warnings.warn(\n   255→        #         \"You are using a loss type that does not support label smoothing. Ignoring label_smoothing parameter.\"\n   256→        #     )\n   257→\n   258→        self.beta = args.beta\n   259→        self.gamma_beta_ratio = args.gamma_beta_ratio\n   260→        self.sft_weight = args.sft_weight\n   261→        self.label_smoothing = args.label_smoothing\n   262→        self.loss_type = args.loss_type\n   263→\n   264→        self._stored_metrics = defaultdict(lambda: defaultdict(list))\n   265→\n   266→        # Compute that only on the main process for faster data processing.\n   267→        # see: https://github.com/huggingface/trl/pull/1255\n   268→        # with PartialState().local_main_process_first():\n   269→        #     # tokenize the dataset\n   270→        #     train_dataset = train_dataset.map(self.tokenize_row, num_proc=args.dataset_num_proc)\n   271→        #     if eval_dataset is not None:\n   272→        #         eval_dataset = eval_dataset.map(self.tokenize_row, num_proc=args.dataset_num_proc)\n   273→\n   274→        # super().__init__(\n   275→        #     model=model,\n   276→        #     args=args,\n   277→        #     data_collator=data_collator,\n   278→        #     train_dataset=train_dataset,\n   279→        #     eval_dataset=eval_dataset,\n   280→        #     tokenizer=tokenizer,\n   281→        #     model_init=model_init,\n   282→        #     compute_metrics=compute_metrics,\n   283→        #     callbacks=callbacks,\n   284→        #     optimizers=optimizers,\n   285→        #     preprocess_logits_for_metrics=preprocess_logits_for_metrics,\n   286→        # )\n   287→\n   288→        # # Add tags for models that have been loaded with the correct transformers version\n   289→        # if hasattr(self.model, \"add_model_tags\"):\n   290→        #     self.model.add_model_tags(self._tag_names)\n   291→\n   292→        # if not hasattr(self, \"accelerator\"):\n   293→        #     raise AttributeError(\n   294→        #         \"Your `Trainer` does not have an `accelerator` object. Consider upgrading `transformers`.\"\n   295→        #     )\n   296→\n   297→    def build_tokenized_answer(self, prompt, answer):\n   298→        \"\"\"\n   299→        Llama tokenizer does satisfy `enc(a + b) = enc(a) + enc(b)`.\n   300→        It does ensure `enc(a + b) = enc(a) + enc(a + b)[len(enc(a)):]`.\n   301→        Reference:\n   302→            https://github.com/EleutherAI/lm-evaluation-harness/pull/531#issuecomment-1595586257\n   303→        \"\"\"\n   304→\n   305→        full_tokenized = self.tokenizer(prompt + answer, add_special_tokens=False)\n   306→        prompt_input_ids = self.tokenizer(prompt, add_special_tokens=False)[\"input_ids\"]\n   307→\n   308→        answer_input_ids = full_tokenized[\"input_ids\"][len(prompt_input_ids) :]\n   309→        answer_attention_mask = full_tokenized[\"attention_mask\"][len(prompt_input_ids) :]\n   310→\n   311→        # Concat tokens to form `enc(a) + enc(a + b)[len(enc(a)):]`\n   312→        full_concat_input_ids = np.concatenate([prompt_input_ids, answer_input_ids])\n   313→\n   314→        # Prepare input tokens for token by token comparison\n   315→        full_input_ids = np.array(full_tokenized[\"input_ids\"])\n   316→\n   317→        if len(full_input_ids) != len(full_concat_input_ids):\n   318→            raise ValueError(\"Prompt input ids and answer input ids should have the same length.\")\n   319→\n   320→        # On some tokenizers, like Llama-2 tokenizer, there are occasions where tokens\n   321→        # can be merged together when tokenizing prompt+answer. This could result\n   322→        # on the last token from the prompt being different when tokenized on its own\n   323→        # vs when done as prompt+answer.\n   324→        response_token_ids_start_idx = len(prompt_input_ids)\n   325→\n   326→        # If tokenized prompt is different than both prompt+answer, then it means the\n   327→        # last token has changed due to merging.\n   328→        if prompt_input_ids != full_tokenized[\"input_ids\"][:response_token_ids_start_idx]:\n   329→            response_token_ids_start_idx -= 1\n   330→\n   331→        prompt_input_ids = full_tokenized[\"input_ids\"][:response_token_ids_start_idx]\n   332→        prompt_attention_mask = full_tokenized[\"attention_mask\"][:response_token_ids_start_idx]\n   333→\n   334→        if len(prompt_input_ids) != len(prompt_attention_mask):\n   335→            raise ValueError(\"Prompt input ids and attention mask should have the same length.\")\n   336→\n   337→        answer_input_ids = full_tokenized[\"input_ids\"][response_token_ids_start_idx:]\n   338→        answer_attention_mask = full_tokenized[\"attention_mask\"][response_token_ids_start_idx:]\n   339→\n   340→        return dict(\n   341→            prompt_input_ids=prompt_input_ids,\n   342→            prompt_attention_mask=prompt_attention_mask,\n   343→            input_ids=answer_input_ids,\n   344→            attention_mask=answer_attention_mask,\n   345→        )\n   346→\n   347→    def tokenize_row(self, feature, model: Optional[Union[PreTrainedModel, nn.Module]] = None) -> Dict:\n   348→        \"\"\"Tokenize a single row from a SimPO specific dataset.\n   349→\n   350→        At this stage, we don't convert to PyTorch tensors yet; we just handle the truncation\n   351→        in case the prompt + chosen or prompt + rejected responses is/are too long. First\n   352→            we truncate the prompt; if we're still too long, we truncate the chosen/rejected.\n   353→\n   354→        We also create the labels for the chosen/rejected responses, which are of length equal to\n   355→            the sum of the length of the prompt and the chosen/rejected response, with\n   356→            label_pad_token_id  for the prompt tokens.\n   357→        \"\"\"\n   358→        batch = {}\n   359→        prompt = feature[\"prompt\"]\n   360→        chosen = feature[\"chosen\"]\n   361→        rejected = feature[\"rejected\"]\n   362→\n   363→        if not self.is_encoder_decoder:\n   364→            # Check issues below for more details\n   365→            #  1. https://github.com/huggingface/trl/issues/907\n   366→            #  2. https://github.com/EleutherAI/lm-evaluation-harness/pull/531#issuecomment-1595586257\n   367→            #  3. https://github.com/LianjiaTech/BELLE/issues/337\n   368→\n   369→            if not isinstance(prompt, str):\n   370→                raise ValueError(f\"prompt should be an str but got {type(prompt)}\")\n   371→            prompt_tokens = self.tokenizer(prompt, add_special_tokens=False)\n   372→            prompt_tokens = {f\"prompt_{k}\": v for k, v in prompt_tokens.items()}\n   373→\n   374→            if not isinstance(chosen, str):\n   375→                raise ValueError(f\"chosen should be an str but got {type(chosen)}\")\n   376→            chosen_tokens = self.build_tokenized_answer(prompt, chosen)\n   377→\n   378→            if not isinstance(rejected, str):\n   379→                raise ValueError(f\"rejected should be an str but got {type(rejected)}\")\n   380→            rejected_tokens = self.build_tokenized_answer(prompt, rejected)\n   381→\n   382→            # Last prompt token might get merged by tokenizer and\n   383→            # it should not be included for generation if that happens\n   384→            prompt_len_input_ids = len(prompt_tokens[\"prompt_input_ids\"])\n   385→\n   386→            chosen_prompt_len_input_ids = len(chosen_tokens[\"prompt_input_ids\"])\n   387→            rejected_prompt_len_input_ids = len(rejected_tokens[\"prompt_input_ids\"])\n   388→            prompt_len_input_ids = min(chosen_prompt_len_input_ids, rejected_prompt_len_input_ids)\n   389→\n   390→            for k, v in prompt_tokens.items():\n   391→                prompt_tokens[k] = v[:prompt_len_input_ids]\n   392→\n   393→            # Make sure prompts only have one different token at most an\n   394→            # and length only differs by 1 at most\n   395→            num_diff_tokens = sum(\n   396→                [a != b for a, b in zip(chosen_tokens[\"prompt_input_ids\"], rejected_tokens[\"prompt_input_ids\"])]\n   397→            )\n   398→            num_diff_len = abs(chosen_prompt_len_input_ids - rejected_prompt_len_input_ids)\n   399→            if num_diff_tokens > 1 or num_diff_len > 1:\n   400→                raise ValueError(\n   401→                    \"Chosen and rejected prompt_input_ids might only differ on the \"\n   402→                    \"last token due to tokenizer merge ops.\"\n   403→                )\n   404→\n   405→            # add BOS token to head of prompt. Avoid adding if it's already there\n   406→            bos_token_id = self.tokenizer.bos_token_id\n   407→            if prompt_len_input_ids == 0 or bos_token_id != prompt_tokens[\"prompt_input_ids\"][0]:\n   408→                prompt_tokens[\"prompt_input_ids\"] = [bos_token_id] + prompt_tokens[\"prompt_input_ids\"]\n   409→                prompt_tokens[\"prompt_attention_mask\"] = [1] + prompt_tokens[\"prompt_attention_mask\"]\n   410→            if chosen_prompt_len_input_ids == 0 or bos_token_id != chosen_tokens[\"prompt_input_ids\"][0]:\n   411→                chosen_tokens[\"prompt_input_ids\"] = [bos_token_id] + chosen_tokens[\"prompt_input_ids\"]\n   412→                chosen_tokens[\"prompt_attention_mask\"] = [1] + chosen_tokens[\"prompt_attention_mask\"]\n   413→            if rejected_prompt_len_input_ids == 0 or bos_token_id != rejected_tokens[\"prompt_input_ids\"][0]:\n   414→                rejected_tokens[\"prompt_input_ids\"] = [bos_token_id] + rejected_tokens[\"prompt_input_ids\"]\n   415→                rejected_tokens[\"prompt_attention_mask\"] = [1] + rejected_tokens[\"prompt_attention_mask\"]\n   416→\n   417→            # add EOS token to end of answer. Avoid adding if it's already there\n   418→            eos_token_id = self.tokenizer.eos_token_id\n   419→            if len(chosen_tokens[\"input_ids\"]) == 0 or eos_token_id != chosen_tokens[\"input_ids\"][-1]:\n   420→                chosen_tokens[\"input_ids\"].append(eos_token_id)\n   421→                chosen_tokens[\"attention_mask\"].append(1)\n   422→            if len(rejected_tokens[\"input_ids\"]) == 0 or eos_token_id != rejected_tokens[\"input_ids\"][-1]:\n   423→                rejected_tokens[\"input_ids\"].append(eos_token_id)\n   424→                rejected_tokens[\"attention_mask\"].append(1)\n   425→\n   426→            longer_response_length = max(len(chosen_tokens[\"input_ids\"]), len(rejected_tokens[\"input_ids\"]))\n   427→\n   428→            # if combined sequence is too long, truncate the prompt\n   429→            for answer_tokens in [chosen_tokens, rejected_tokens, prompt_tokens]:\n   430→                if len(answer_tokens[\"prompt_input_ids\"]) + longer_response_length > self.max_length:\n   431→                    if self.truncation_mode == \"keep_start\":\n   432→                        for k in [\"prompt_input_ids\", \"prompt_attention_mask\"]:\n   433→                            answer_tokens[k] = answer_tokens[k][: self.max_prompt_length]\n   434→                    elif self.truncation_mode == \"keep_end\":\n   435→                        for k in [\"prompt_input_ids\", \"prompt_attention_mask\"]:\n   436→                            answer_tokens[k] = answer_tokens[k][-self.max_prompt_length :]\n   437→                    else:\n   438→                        raise ValueError(f\"Unknown truncation mode: {self.truncation_mode}\")\n   439→\n   440→            # if that's still too long, truncate the response\n   441→            for answer_tokens in [chosen_tokens, rejected_tokens]:\n   442→                if len(answer_tokens[\"prompt_input_ids\"]) + longer_response_length > self.max_length:\n   443→                    for k in [\"input_ids\", \"attention_mask\"]:\n   444→                        answer_tokens[k] = answer_tokens[k][: self.max_length - self.max_prompt_length]\n   445→\n   446→            # Create labels\n   447→            chosen_sequence_tokens = {\n   448→                k: chosen_tokens[f\"prompt_{k}\"] + chosen_tokens[k] for k in [\"input_ids\", \"attention_mask\"]\n   449→            }\n   450→            rejected_sequence_tokens = {\n   451→                k: rejected_tokens[f\"prompt_{k}\"] + rejected_tokens[k] for k in [\"input_ids\", \"attention_mask\"]\n   452→            }\n   453→            chosen_sequence_tokens[\"labels\"] = chosen_sequence_tokens[\"input_ids\"][:]\n   454→            chosen_sequence_tokens[\"labels\"][: len(chosen_tokens[\"prompt_input_ids\"])] = [\n   455→                self.label_pad_token_id\n   456→            ] * len(chosen_tokens[\"prompt_input_ids\"])\n   457→            rejected_sequence_tokens[\"labels\"] = rejected_sequence_tokens[\"input_ids\"][:]\n   458→            rejected_sequence_tokens[\"labels\"][: len(rejected_tokens[\"prompt_input_ids\"])] = [\n   459→                self.label_pad_token_id\n   460→            ] * len(rejected_tokens[\"prompt_input_ids\"])\n   461→\n   462→            for k, toks in {\n   463→                \"chosen_\": chosen_sequence_tokens,\n   464→                \"rejected_\": rejected_sequence_tokens,\n   465→                \"\": prompt_tokens,\n   466→            }.items():\n   467→                for type_key, tokens in toks.items():\n   468→                    if type_key == \"token_type_ids\":\n   469→                        continue\n   470→                    batch[f\"{k}{type_key}\"] = tokens\n   471→\n   472→        else:\n   473→            chosen_tokens = self.tokenizer(\n   474→                chosen, truncation=True, max_length=self.max_target_length, add_special_tokens=True\n   475→            )\n   476→            rejected_tokens = self.tokenizer(\n   477→                rejected, truncation=True, max_length=self.max_target_length, add_special_tokens=True\n   478→            )\n   479→            prompt_tokens = self.tokenizer(\n   480→                prompt, truncation=True, max_length=self.max_prompt_length, add_special_tokens=True\n   481→            )\n   482→\n   483→            batch[\"chosen_labels\"] = chosen_tokens[\"input_ids\"]\n   484→            batch[\"rejected_labels\"] = rejected_tokens[\"input_ids\"]\n   485→            batch[\"prompt_input_ids\"] = prompt_tokens[\"input_ids\"]\n   486→            batch[\"prompt_attention_mask\"] = prompt_tokens[\"attention_mask\"]\n   487→\n   488→            if model is not None and hasattr(model, \"prepare_decoder_input_ids_from_labels\"):\n   489→                batch[\"rejected_decoder_input_ids\"] = model.prepare_decoder_input_ids_from_labels(\n   490→                    labels=torch.tensor(batch[\"rejected_labels\"])\n   491→                )\n   492→                batch[\"chosen_decoder_input_ids\"] = model.prepare_decoder_input_ids_from_labels(\n   493→                    labels=torch.tensor(batch[\"chosen_labels\"])\n   494→                )\n   495→\n   496→        return batch\n   497→\n   498→    @staticmethod\n   499→    def concatenated_inputs(\n   500→        batch: Dict[str, Union[List, torch.LongTensor]],\n   501→        is_encoder_decoder: bool = False,\n   502→        label_pad_token_id: int = -100,\n   503→        padding_value: int = 0,\n   504→        device: Optional[torch.device] = None,\n   505→    ) -> Dict[str, torch.LongTensor]:\n   506→        \"\"\"Concatenate the chosen and rejected inputs into a single tensor.\n   507→\n   508→        Args:\n   509→            batch: A batch of data. Must contain the keys 'chosen_input_ids' and 'rejected_input_ids', which are tensors of shape (batch_size, sequence_length).\n   510→            is_encoder_decoder: Whether the model is an encoder-decoder model.\n   511→            label_pad_token_id: The label pad token id.\n   512→            padding_value: The padding value to use for the concatenated inputs_ids.\n   513→            device: The device for the concatenated inputs.\n   514→\n   515→        Returns:\n   516→            A dictionary containing the concatenated inputs under the key 'concatenated_input_ids'.\n   517→        \"\"\"\n   518→        concatenated_batch = {}\n   519→\n   520→        if is_encoder_decoder:\n   521→            max_length = max(batch[\"chosen_labels\"].shape[1], batch[\"rejected_labels\"].shape[1])\n   522→        else:\n   523→            max_length = max(batch[\"chosen_input_ids\"].shape[1], batch[\"rejected_input_ids\"].shape[1])\n   524→\n   525→        for k in batch:\n   526→            if k.startswith(\"chosen\") and isinstance(batch[k], torch.Tensor):\n   527→                if \"labels\" in k or is_encoder_decoder:\n   528→                    pad_value = label_pad_token_id\n   529→                elif k.endswith(\"_input_ids\"):\n   530→                    pad_value = padding_value\n   531→                elif k.endswith(\"_attention_mask\"):\n   532→                    pad_value = 0\n   533→                concatenated_key = k.replace(\"chosen\", \"concatenated\")\n   534→                concatenated_batch[concatenated_key] = pad_to_length(batch[k], max_length, pad_value=pad_value)\n   535→        for k in batch:\n   536→            if k.startswith(\"rejected\") and isinstance(batch[k], torch.Tensor):\n   537→                if \"labels\" in k or is_encoder_decoder:\n   538→                    pad_value = label_pad_token_id\n   539→                elif k.endswith(\"_input_ids\"):\n   540→                    pad_value = padding_value\n   541→                elif k.endswith(\"_attention_mask\"):\n   542→                    pad_value = 0\n   543→                concatenated_key = k.replace(\"rejected\", \"concatenated\")\n   544→                concatenated_batch[concatenated_key] = torch.cat(\n   545→                    (\n   546→                        concatenated_batch[concatenated_key],\n   547→                        pad_to_length(batch[k], max_length, pad_value=pad_value),\n   548→                    ),\n   549→                    dim=0,\n   550→                ).to(device=device)\n   551→\n   552→        if is_encoder_decoder:\n   553→            concatenated_batch[\"concatenated_input_ids\"] = batch[\"prompt_input_ids\"].repeat(2, 1).to(device=device)\n   554→            concatenated_batch[\"concatenated_attention_mask\"] = (\n   555→                batch[\"prompt_attention_mask\"].repeat(2, 1).to(device=device)\n   556→            )\n   557→\n   558→        return concatenated_batch\n   559→\n   560→    def simpo_loss(\n   561→        self,\n   562→        policy_chosen_logps: torch.FloatTensor,\n   563→        policy_rejected_logps: torch.FloatTensor,\n   564→    ) -> Tuple[torch.FloatTensor, torch.FloatTensor, torch.FloatTensor]:\n   565→        \"\"\"Compute the SimPO loss for a batch of policy model log probabilities.\n   566→\n   567→        Args:\n   568→            policy_chosen_logps: Log probabilities of the policy model for the chosen responses. Shape: (batch_size,)\n   569→            policy_rejected_logps: Log probabilities of the policy model for the rejected responses. Shape: (batch_size,)\n   570→\n   571→        Returns:\n   572→            A tuple of three tensors: (losses, chosen_rewards, rejected_rewards).\n   573→            The losses tensor contains the SimPO loss for each example in the batch.\n   574→            The chosen_rewards and rejected_rewards tensors contain the rewards for the chosen and rejected responses, respectively.\n   575→        \"\"\"\n   576→\n   577→        return losses, chosen_rewards, rejected_rewards\n   578→\n   579→    def concatenated_forward(\n   580→        self, model: nn.Module, batch: Dict[str, Union[List, torch.LongTensor]]\n   581→    ) -> Tuple[torch.FloatTensor, torch.FloatTensor, torch.FloatTensor, torch.FloatTensor]:\n   582→        \"\"\"Run the given model on the given batch of inputs, concatenating the chosen and rejected inputs together.\n   583→\n   584→        We do this to avoid doing two forward passes, because it's faster for FSDP.\n   585→        \"\"\"\n   586→        concatenated_batch = self.concatenated_inputs(\n   587→            batch,\n   588→            is_encoder_decoder=self.is_encoder_decoder,\n   589→            label_pad_token_id=self.label_pad_token_id,\n   590→            padding_value=self.padding_value,\n   591→            device=self.accelerator.device,\n   592→        )\n   593→        len_chosen = batch[\"chosen_labels\"].shape[0]\n   594→\n   595→        model_kwargs = (\n   596→            {\n   597→                \"labels\": concatenated_batch[\"concatenated_labels\"],\n   598→                \"decoder_input_ids\": concatenated_batch.pop(\"concatenated_decoder_input_ids\", None),\n   599→            }\n   600→            if self.is_encoder_decoder\n   601→            else {}\n   602→        )\n   603→\n   604→        all_logits = model(\n   605→            concatenated_batch[\"concatenated_input_ids\"],\n   606→            attention_mask=concatenated_batch[\"concatenated_attention_mask\"],\n   607→            use_cache=False,\n   608→            **model_kwargs,\n   609→        ).logits\n   610→\n   611→        all_logps = self.get_batch_logps(\n   612→            all_logits,\n   613→            concatenated_batch[\"concatenated_labels\"],\n   614→            average_log_prob=True,\n   615→            is_encoder_decoder=self.is_encoder_decoder,\n   616→            label_pad_token_id=self.label_pad_token_id,\n   617→        )\n   618→\n   619→        chosen_logps = all_logps[:len_chosen]\n   620→        rejected_logps = all_logps[len_chosen:]\n   621→\n   622→        chosen_logits = all_logits[:len_chosen]\n   623→        rejected_logits = all_logits[len_chosen:]\n   624→\n   625→        chosen_labels = concatenated_batch[\"concatenated_labels\"][:len_chosen]\n   626→\n   627→        return (chosen_logps, rejected_logps, chosen_logits, rejected_logits, chosen_labels)\n   628→\n   629→    @staticmethod\n   630→    def get_batch_logps(\n   631→        logits: torch.FloatTensor,\n   632→        labels: torch.LongTensor,\n   633→        average_log_prob: bool = True,\n   634→        label_pad_token_id: int = -100,\n   635→        is_encoder_decoder: bool = False,\n   636→    ) -> torch.FloatTensor:\n   637→        \"\"\"Compute the log probabilities of the given labels under the given logits.\n   638→\n   639→        Args:\n   640→            logits: Logits of the model (unnormalized). Shape: (batch_size, sequence_length, vocab_size)\n   641→            labels: Labels for which to compute the log probabilities. Label tokens with a value of label_pad_token_id are ignored. Shape: (batch_size, sequence_length)\n   642→            average_log_prob: If True, return the average log probability per (non-masked) token. Otherwise, return the sum of the log probabilities of the (non-masked) tokens.\n   643→            label_pad_token_id: The label pad token id.\n   644→            is_encoder_decoder: Whether the model is an encoder-decoder model.\n   645→\n   646→        Returns:\n   647→            A tensor of shape (batch_size,) containing the average/sum log probabilities of the given labels under the given logits.\n   648→        \"\"\"\n   649→        if logits.shape[:-1] != labels.shape:\n   650→            raise ValueError(\"Logits (batch and sequence length dim) and labels must have the same shape.\")\n   651→\n   652→        if not is_encoder_decoder:\n   653→            labels = labels[:, 1:].clone()\n   654→            logits = logits[:, :-1, :]\n   655→        loss_mask = labels != label_pad_token_id\n   656→\n   657→        # dummy token; we'll ignore the losses on these tokens later\n   658→        labels[labels == label_pad_token_id] = 0\n   659→\n   660→        per_token_logps = torch.gather(logits.log_softmax(-1), dim=2, index=labels.unsqueeze(2)).squeeze(2)\n   661→\n   662→        if average_log_prob:\n   663→            return (per_token_logps * loss_mask).sum(-1) / loss_mask.sum(-1)\n   664→        else:\n   665→            return (per_token_logps * loss_mask).sum(-1)\n   666→\n   667→    def get_batch_loss_metrics(\n   668→        self,\n   669→        model,\n   670→        batch: Dict[str, Union[List, torch.LongTensor]],\n   671→        train_eval: Literal[\"train\", \"eval\"] = \"train\",\n   672→    ):\n   673→        \"\"\"Compute the SimPO loss and other metrics for the given batch of inputs for train or test.\"\"\"\n   674→        metrics = {}\n   675→        prefix = \"eval_\" if train_eval == \"eval\" else \"\"\n   676→\n   677→        (\n   678→            policy_chosen_logps,\n   679→            policy_rejected_logps,\n   680→            policy_chosen_logits,\n   681→            policy_rejected_logits,\n   682→            chosen_labels,\n   683→        ) = self.concatenated_forward(model, batch)\n   684→\n   685→        losses, chosen_rewards, rejected_rewards = self.simpo_loss(\n   686→            policy_chosen_logps,\n   687→            policy_rejected_logps,\n   688→        )\n   689→\n   690→        loss = losses.mean()\n   691→\n   692→        if self.sft_weight > 0.0:\n   693→            if not self.is_encoder_decoder:\n   694→                policy_chosen_logits = policy_chosen_logits[..., :-1, :].contiguous()\n   695→                chosen_labels = chosen_labels[..., 1:].clone()\n   696→            loss_func = nn.CrossEntropyLoss()\n   697→            sft_loss = loss_func(policy_chosen_logits.view(-1, policy_chosen_logits.shape[-1]), chosen_labels.view(-1))\n   698→            loss = self.sft_weight * sft_loss + loss\n   699→            metrics[f\"{prefix}sft_loss\"] = sft_loss.detach().cpu()\n   700→        \n   701→        reward_accuracies = (chosen_rewards > rejected_rewards).float()\n   702→\n   703→        metrics[f\"{prefix}rewards/chosen\"] = chosen_rewards.mean().cpu()\n   704→        metrics[f\"{prefix}rewards/rejected\"] = rejected_rewards.mean().cpu()\n   705→        metrics[f\"{prefix}rewards/accuracies\"] = reward_accuracies.mean().cpu()\n   706→        metrics[f\"{prefix}rewards/margins\"] = (chosen_rewards - rejected_rewards).mean().cpu()\n   707→        metrics[f\"{prefix}logps/rejected\"] = policy_rejected_logps.detach().mean().cpu()\n   708→        metrics[f\"{prefix}logps/chosen\"] = policy_chosen_logps.detach().mean().cpu()\n   709→        metrics[f\"{prefix}logits/rejected\"] = policy_rejected_logits.detach().mean().cpu()\n   710→        metrics[f\"{prefix}logits/chosen\"] = policy_chosen_logits.detach().mean().cpu()\n   711→\n   712→        return loss, metrics\n   713→\n   714→    def compute_loss(\n   715→        self,\n   716→        model: Union[PreTrainedModel, nn.Module],\n   717→        inputs: Dict[str, Union[torch.Tensor, Any]],\n   718→        return_outputs=False,\n   719→    ) -> Union[torch.Tensor, Tuple[torch.Tensor, Dict[str, torch.Tensor]]]:\n   720→        if not self.use_dpo_data_collator:\n   721→            warnings.warn(\n   722→                \"compute_loss is only implemented for DPODataCollatorWithPadding, and you passed a datacollator that is different than \"\n   723→                \"DPODataCollatorWithPadding - you might see unexpected behavior. Alternatively, you can implement your own prediction_step method if you are using a custom data collator\"\n   724→            )\n   725→\n   726→        compute_loss_context_manager = torch.cuda.amp.autocast if self._peft_has_been_casted_to_bf16 else nullcontext\n   727→\n   728→        with compute_loss_context_manager():\n   729→            loss, metrics = self.get_batch_loss_metrics(model, inputs, train_eval=\"train\")\n   730→\n   731→        # force log the metrics\n   732→        self.store_metrics(metrics, train_eval=\"train\")\n   733→\n   734→        if return_outputs:\n   735→            return (loss, metrics)\n   736→        return loss\n   737→\n   738→    def get_batch_samples(self, model, batch: Dict[str, torch.LongTensor]) -> Tuple[str, str]:\n   739→        \"\"\"Generate samples from the model and reference model for the given batch of inputs.\"\"\"\n   740→\n   741→        # If one uses `generate_during_eval` with peft + bf16, we need to explicitly call generate with\n   742→        # the torch cuda amp context manager as some hidden states are silently casted to full precision.\n   743→        generate_context_manager = nullcontext if not self._peft_has_been_casted_to_bf16 else torch.cuda.amp.autocast\n   744→\n   745→        with generate_context_manager():\n   746→            policy_output = model.generate(\n   747→                input_ids=batch[\"prompt_input_ids\"],\n   748→                attention_mask=batch[\"prompt_attention_mask\"],\n   749→                max_length=self.max_length,\n   750→                do_sample=True,\n   751→                pad_token_id=self.tokenizer.pad_token_id,\n   752→            )\n   753→\n   754→        policy_output = pad_to_length(policy_output, self.max_length, self.tokenizer.pad_token_id)\n   755→        policy_output_decoded = self.tokenizer.batch_decode(policy_output, skip_special_tokens=True)\n   756→\n   757→        return policy_output_decoded\n   758→\n   759→    def prediction_step(\n   760→        self,\n   761→        model: Union[PreTrainedModel, nn.Module],\n   762→        inputs: Dict[str, Union[torch.Tensor, Any]],\n   763→        prediction_loss_only: bool,\n   764→        ignore_keys: Optional[List[str]] = None,\n   765→    ):\n   766→        if not self.use_dpo_data_collator:\n   767→            warnings.warn(\n   768→                \"prediction_step is only implemented for DPODataCollatorWithPadding, and you passed a datacollator that is different than \"\n   769→                \"DPODataCollatorWithPadding - you might see unexpected behavior. Alternatively, you can implement your own prediction_step method if you are using a custom data collator\"\n   770→            )\n   771→        if ignore_keys is None:\n   772→            if hasattr(model, \"config\"):\n   773→                ignore_keys = getattr(model.config, \"keys_to_ignore_at_inference\", [])\n   774→            else:\n   775→                ignore_keys = []\n   776→\n   777→        prediction_context_manager = torch.cuda.amp.autocast if self._peft_has_been_casted_to_bf16 else nullcontext\n   778→\n   779→        with torch.no_grad(), prediction_context_manager():\n   780→            loss, metrics = self.get_batch_loss_metrics(model, inputs, train_eval=\"eval\")\n   781→\n   782→        # force log the metrics\n   783→        self.store_metrics(metrics, train_eval=\"eval\")\n   784→\n   785→        if prediction_loss_only:\n   786→            return (loss.detach(), None, None)\n   787→\n   788→        # logits for the chosen and rejected samples from model\n   789→        logits_dict = {\n   790→            \"eval_logits/chosen\": metrics[\"eval_logits/chosen\"],\n   791→            \"eval_logits/rejected\": metrics[\"eval_logits/rejected\"],\n   792→        }\n   793→        logits = tuple(v.unsqueeze(dim=0) for k, v in logits_dict.items() if k not in ignore_keys)\n   794→        logits = torch.stack(logits).mean(axis=1).to(self.accelerator.device)\n   795→        labels = torch.zeros(logits.shape[0], device=self.accelerator.device)\n   796→\n   797→        return (loss.detach(), logits, labels)\n   798→\n   799→    def store_metrics(self, metrics: Dict[str, float], train_eval: Literal[\"train\", \"eval\"] = \"train\") -> None:\n   800→        for key, value in metrics.items():\n   801→            self._stored_metrics[train_eval][key].append(value)\n   802→\n   803→    def evaluation_loop(\n   804→        self,\n   805→        dataloader: DataLoader,\n   806→        description: str,\n   807→        prediction_loss_only: Optional[bool] = None,\n   808→        ignore_keys: Optional[List[str]] = None,\n   809→        metric_key_prefix: str = \"eval\",\n   810→    ) -> EvalLoopOutput:\n   811→        \"\"\"\n   812→        Overriding built-in evaluation loop to store metrics for each batch.\n   813→        Prediction/evaluation loop, shared by `Trainer.evaluate()` and `Trainer.predict()`.\n   814→\n   815→        Works both with or without labels.\n   816→        \"\"\"\n   817→\n   818→        # Sample and save to game log if requested (for one batch to save time)\n   819→        if self.generate_during_eval:\n   820→            # Generate random indices within the range of the total number of samples\n   821→            num_samples = len(dataloader.dataset)\n   822→            random_indices = random.sample(range(num_samples), k=self.args.eval_batch_size)\n   823→\n   824→            # Use dataloader.dataset.select to get the random batch without iterating over the DataLoader\n   825→            random_batch_dataset = dataloader.dataset.select(random_indices)\n   826→            random_batch = self.data_collator(random_batch_dataset)\n   827→            random_batch = self._prepare_inputs(random_batch)\n   828→\n   829→            policy_output_decoded = self.get_batch_samples(self.model, random_batch)\n   830→\n   831→            self.log(\n   832→                {\n   833→                    \"game_log\": wandb.Table(\n   834→                        columns=[\"Prompt\", \"Policy\"],\n   835→                        rows=[\n   836→                            [prompt, pol[len(prompt) :]]\n   837→                            for prompt, pol in zip(random_batch[\"prompt\"], policy_output_decode