uration, the model will be wrapped in a PEFT model.\n    74→        compute_metrics (`Callable[[EvalPrediction], Dict]`, *optional*):\n    75→            The function to use to compute the metrics. Must take a `EvalPrediction` and return\n    76→            a dictionary string to metric values.\n    77→    \"\"\"\n    78→\n    79→    _tag_names = [\"trl\", \"simpo\"]\n    80→\n    81→    def __init__(\n    82→        self,\n    83→        model: Optional[Union[PreTrainedModel, nn.Module, str]] = None,\n    84→        args: Optional[SimPOConfig] = None,\n    85→        data_collator: Optional[DataCollator] = None,\n    86→        train_dataset: Optional[Dataset] = None,\n    87→        eval_dataset: Optional[Union[Dataset, Dict[str, Dataset]]] = None,\n    88→        tokenizer: Optional[PreTrainedTokenizerBase] = None,\n    89→        model_init: Optional[Callable[[], PreTrainedModel]] = None,\n    90→        callbacks: Optional[List[TrainerCallback]] = None,\n    91→        optimizers: Tuple[torch.optim.Optimizer, torch.optim.lr_scheduler.LambdaLR] = (None, None),\n    92→        preprocess_logits_for_metrics: Optional[Callable[[torch.Tensor, torch.Tensor], torch.Tensor]] = None,\n    93→        peft_config: Optional[Dict] = None,\n    94→        compute_metrics: Optional[Callable[[EvalLoopOutput], Dict]] = None,\n    95→    ):\n    96→        # if args.model_init_kwargs is None:\n    97→        #     model_init_kwargs = {}\n    98→        # elif not isinstance(model, str):\n    99→        #     raise ValueError(\"You passed model_kwargs to the SimPOTrainer. But your model is already instantiated.\")\n   100→        # else:\n   101→        #     model_init_kwargs = args.model_init_kwargs\n   102→        #     model_init_kwargs[\"torch_dtype\"] = (\n   103→        #         model_init_kwargs[\"torch_dtype\"]\n   104→        #         if model_init_kwargs[\"torch_dtype\"] in [\"auto\", None]\n   105→        #         else getattr(torch, model_init_kwargs[\"torch_dtype