ax(rolls)\n    scores['high_and_often'] = highest * counts[highest]\n\n    # Category 2: Sum of all dice\n    scores['summation'] = sum(rolls)\n\n    # Category 3: Highest × Lowest × Difference\n    lowest = min(rolls)\n    scores['highs_and_lows'] = highest * lowest * (highest - lowest)\n\n    # Category 4: Only two distinct numbers\n    unique_nums = set(rolls)\n    scores['only_two_numbers'] = 30 if len(unique_nums) == 2 else 0\n\n    # Category 5: All numbers present (1-6)\n    scores['all_numbers'] = 40 if set(rolls) == {1, 2, 3, 4, 5, 6} else 0\n\n    # Category 6: Consecutive run in order\n    scores['ordered_subset'] = check_ordered_run(rolls)\n\n    return scores\n\ndef check_ordered_run(rolls, length=4):\n    \"\"\"Check if rolls contain a consecutive run of specified length.\"\"\"\n    for i in range(len(rolls) - length + 1):\n        subset = rolls[i:i+length]\n\n        # Check increasing sequence\n        if all(subset[j+1] == subset[j] + 1 for j in range(length-1)):\n            return 50\n\n        # Check decreasing sequence\n        if all(subset[j+1] == subset[j] - 1 for j in range(length-1)):\n            return 50\n\n    return 0\n```\n\n### Pattern 2: Optimal Category Selection\n```python\ndef get_best_combined_score(turn1_rolls, turn2_rolls):\n    \"\"\"\n    Find best score across two turns where no category is used twice.\n\n    This is an optimization problem: select one category for each turn\n    such that total score is maximized and categories don't overlap.\n    \"\"\"\n    turn1_scores = calculate_scores(turn1_rolls)\n    turn2_scores = calculate_scores(turn2_rolls)\n\n    categories = list(turn1_scores.keys())\n    best_score = 0\n\n    # Brute force: try all non-overlapping combinations\n    for cat1 in categories:\n        for cat2 in categories:\n            if cat1 != cat2:  # Can't use same category twice\n                total = turn1_scores[cat1] + turn2_scores[cat2]\n                best_score = max(best_score, total)\n\n    return best_score\n```\n\n### Pattern 3: More Efficient Optimization (for many turns)\n```python\nfrom itertools import permutations\n\ndef optimize_n_turns(turns_rolls, num_categories):\n    \"\"\"\n    For n turns, select n different categories to maximize total score.\n\n    Args:\n        turns_rolls: List of roll lists [[1,2,3,4,5,6], [2,3,4,5,6,1], ...]\n        num_categories: Number of available categories\n\n    Returns:\n        Best total score and category assignments\n    \"\"\"\n    # Calculate all scores\n    all_scores = [calculate_scores(rolls) for rolls in turns_rolls]\n    categories = list(all_scores[0].keys())\n\n    # For small n, brute force is fine\n    if len(turns_rolls) <= 6:\n        best_score = 0\n        best_assignment = None\n\n        for perm in permutations(categories, len(turns_rolls)):\n            total = sum(all_scores[i][perm[i]] for i in range(len(turns_rolls)))\n            if total > best_score:\n                best_score = total\n                best_assignment = perm\n\n        return best_score, best_assignment\n\n    # For larger n, use greedy or dynamic programming\n    # ... (implementation depends on specific constraints)\n```\n\n## Data Processing Patterns\n\n### Reading Game Data\n```python\nimport pandas as pd\n\ndef load_game_data(file_path, sheet_name='Data'):\n    \"\"\"Load dice game data from Excel file.\"\"\"\n    # Read data, skipping header rows if needed\n    df = pd.read_excel(file_path, sheet_name=sheet_name, skiprows=8)\n\n    # Clean up: remove NaN rows and empty columns\n    df = df.dropna(subset=['Game number'])\n\n    # Extract roll columns\n    roll_cols = [f'Roll {i}' for i in range(1, 7)]\n\n    return df[['Turn number', 'Game number'] + roll_cols]\n```\n\n### Grouping Turns into Games\n```python\ndef group_turns_by_game(df):\n    \"\"\"\n    Group turn data by game number.\n\n    Returns:\n        Dict of {game_num: [turn1_rolls, turn2_rolls, ...]}\n    \"\"\"\n    games = {}\n\n    for _, row in df.iterrows():\n        game_num = int(row['Game number'])\n        rolls = [int(row[f'Roll {i}']) for i in range(1, 7)]\n\n        if game_num not in games:\n            games[game_num] = []\n        games[game_num].append(rolls)\n\n    return games\n```\n\n### Calculating Game Scores\n```python\ndef calculate_all_game_scores(games):\n    \"\"\"\n    Calculate optimal score for each game.\n\n    Args:\n        games: Dict of {game_num: [turn_rolls, ...]}\n\n    Returns:\n        Dict of {game_num: best_score}\n    \"\"\"\n    game_scores = {}\n\n    for game_num, turns in games.items():\n        if len(turns) == 2:  # Expected number of turns\n            score = get_best_combined_score(turns[0], turns[1])\n            game_scores[game_num] = score\n        else:\n            # Handle incomplete games\n            print(f\"Warning: Game {game_num} has {len(turns)} turns\")\n\n    return game_scores\n```\n\n## Head-to-Head Match Analysis\n\n### Pairing Games for Comparison\n```python\ndef analyze_player_matches(game_scores):\n    \"\"\"\n    Match odd-numbered games (Player 1) vs even-numbered games (Player 2).\n\n    Matches: 1 vs 2, 3 vs 4, 5 vs 6, ...\n    \"\"\"\n    player1_wins = 0\n    player2_wins = 0\n    ties = 0\n\n    max_game = max(game_scores.keys())\n\n    for i in range(1, max_game, 2):\n        game1 = i      # Player 1 (odd game)\n        game2 = i + 1  # Player 2 (even game)\n\n        # Only count matches where both games have valid scores\n        if game1 in game_scores and game2 in game_scores:\n            score1 = game_scores[game1]\n            score2 = game_scores[game2]\n\n            if score1 > score2:\n                player1_wins += 1\n            elif score2 > score1:\n                player2_wins += 1\n            else:\n                ties += 1\n\n    return {\n        'player1_wins': player1_wins,\n        'player2_wins': player2_wins,\n        'ties': ties,\n        'difference': player1_wins - player2_wins\n    }\n```\n\n## Common Patterns and Formulas\n\n### Frequency-Based Scoring\n```python\n# Count occurrences\nfrom collections import Counter\ncounts = Counter(rolls)\n\n# Most common number\nmost_common_num, most_common_count = counts.most_common(1)[0]\n\n# Score: number × frequency\nscore = most_common_num * most_common_count\n```\n\n### Set-Based Scoring\n```python\n# Check for specific sets\nunique_rolls = set(rolls)\n\n# Full house (exactly 2 distinct numbers)\nis_full_house = len(unique_rolls) == 2\n\n# Straight (all 6 numbers)\nis_straight = unique_rolls == {1, 2, 3, 4, 5, 6}\n\n# N of a kind\nhas_triple = any(count >= 3 for count in Counter(rolls).values())\n```\n\n### Sequential Pattern Detection\n```python\ndef has_consecutive_run(rolls, length=4):\n    \"\"\"Check for consecutive numbers in order rolled.\"\"\"\n    for i in range(len(rolls) - length + 1):\n        window = rolls[i:i+length]\n\n        # Check if strictly increasing\n        if all(window[j+1] == window[j] + 1 for j in range(len(window)-1)):\n            return True\n\n        # Check if strictly decreasing\n        if all(window[j+1] == window[j] - 1 for j in range(len(window)-1)):\n            return True\n\n    return False\n\n# Alternative: check for ANY consecutive sequence (not necessarily in order)\ndef has_consecutive_anywhere(rolls, length=4):\n    \"\"\"Check if rolls contain consecutive numbers anywhere.\"\"\"\n    sorted_unique = sorted(set(rolls))\n    for i in range(len(sorted_unique) - length + 1):\n        if all(sorted_unique[j+1] == sorted_unique[j] + 1\n               for j in range(i, i+length-1)):\n            return True\n    return False\n```\n\n## Edge Cases and Validation\n\n### Handling Incomplete Data\n```python\ndef validate_game_data(games, expected_turns=2):\n    \"\"\"Validate that all games have expected number of turns.\"\"\"\n    valid_games = {}\n    invalid_games = []\n\n    for game_num, turns in games.items():\n        if len(turns) == expected_turns:\n            valid_games[game_num] = turns\n        else:\n            invalid_games.append((game_num, len(turns)))\n\n    if invalid_games:\n        print(f\"Warning: {len(invalid_games)} games have incomplete data\")\n        for game_num, turn_count in invalid_games[:5]:\n            print(f\"  Game {game_num}: {turn_count} turns\")\n\n    return valid_games\n```\n\n### Missing Game Numbers\n```python\ndef check_game_sequence(game_scores):\n    \"\"\"Check for gaps in game numbering.\"\"\"\n    max_game = max(game_scores.keys())\n    expected_games = set(range(1, max_game + 1))\n    actual_games = set(game_scores.keys())\n\n    missing = expected_games - actual_games\n\n    if missing:\n        print(f\"Warning: {len(missing)} games missing\")\n        print(f\"Missing games: {sorted(list(missing))[:10]}...\")\n\n    return missing\n```\n\n## Performance Optimization\n\n### For Large Datasets\n```python\n# Use numpy for vectorized operations\nimport numpy as np\n\ndef calculate_scores_vectorized(rolls_array):\n    \"\"\"Vectorized scoring for multiple turns at once.\"\"\"\n    # rolls_array shape: (n_turns, 6)\n\n    # Summation score\n    summation = np.sum(rolls_array, axis=1)\n\n    # High and low\n    highs = np.max(rolls_array, axis=1)\n    lows = np.min(rolls_array, axis=1)\n\n    return {\n        'summation': summation,\n        'highs_lows': highs * lows * (highs - lows)\n    }\n```\n\n## Complete Example\n\n```python\nimport pandas as pd\n\ndef complete_analysis(excel_file):\n    \"\"\"Complete dice game analysis pipeline.\"\"\"\n\n    # 1. Load data\n    df = pd.read_excel(excel_file, sheet_name='Data', skiprows=8)\n    df = df.dropna(subset=['Game number'])\n\n    # 2. Group by games\n    games = {}\n    for _, row in df.iterrows():\n        game_num = int(row['Game number'])\n        rolls = [int(row[f'Roll {i}']) for i in range(1, 7)]\n        if game_num not in games:\n            games[game_num] = []\n        games[game_num].append(rolls)\n\n    # 3. Calculate scores\n    game_scores = {}\n    for game_num, turns in games.items():\n        if len(turns) == 2:\n            score = get_best_combined_score(turns[0], turns[1])\n            game_scores[game_num] = score\n\n    # 4. Analyze matches\n    results = analyze_player_matches(game_scores)\n\n    print(f\"Player 1 wins: {results['player1_wins']}\")\n    print(f\"Player 2 wins: {results['player2_wins']}\")\n    print(f\"Difference: {results['difference']}\")\n\n    return results['difference']\n```\n\n## Best Practices\n\n1. **Validate data before processing**: Check for missing turns, invalid rolls\n2. **Handle edge cases**: Incomplete games, missing game numbers\n3. **Use clear naming**: turn vs game, score vs points\n4. **Test scoring logic**: Verify each category independently\n5. **Document assumptions**: What constitutes a valid game/turn\n6. **Log warnings**: Don't silently skip invalid data\n\n## Common Pitfalls\n\n1. **Order matters**: Some scoring rules depend on roll order\n2. **Category exclusivity**: Ensure categories aren't reused\n3. **Off-by-one errors**: Game 1 is odd (Player 1), not even\n4. **Integer conversion**: Ensure dice values are ints, not floats\n5. **Missing data**: Always check for incomplete games before scoring\n\n## Testing Strategies\n\n```python\ndef test_scoring():\n    \"\"\"Test scoring functions with known inputs.\"\"\"\n\n    # Test case 1: All sixes\n    assert calculate_scores([6,6,6,6,6,6])['high_and_often'] == 36\n\n    # Test case 2: Straight (1-6)\n    assert calculate_scores([1,2,3,4,5,6])['all_numbers'] == 40\n\n    # Test case 3: Ordered run\n    assert calculate_scores([1,2,3,4,1,1])['ordered_subset'] == 50\n\n    print(\"All tests passed!\")\n```\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"fbcd060f-8da4-44a9-aada-ce543f47815e"}
