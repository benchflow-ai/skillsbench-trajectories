ypes)\n\n# Get basic statistics\nprint(df.describe())\n\n# Get info about DataFrame\nprint(df.info())\n```\n\n## Data Access and Filtering\n\n```python\n# Access column\ncolumn_data = df['column_name']\n\n# Access multiple columns\nsubset = df[['col1', 'col2']]\n\n# Access rows by index\nrow = df.iloc[0]  # First row\nrows = df.iloc[0:10]  # First 10 rows\n\n# Filter rows by condition\nfiltered = df[df['column_name'] > 100]\n\n# Multiple conditions\nfiltered = df[(df['col1'] > 10) & (df['col2'] < 100)]\n```\n\n## Common Operations\n\n```python\n# Count values\ncount = df['column'].value_counts()\n\n# Group by and aggregate\ngrouped = df.groupby('category')['value'].sum()\n\n# Sort values\nsorted_df = df.sort_values('column_name', ascending=False)\n\n# Unique values\nunique_vals = df['column'].unique()\n\n# Missing values\nmissing = df.isnull().sum()\n```\n\n## Writing to Files\n\n```python\n# Write to Excel\ndf.to_excel('output.xlsx', index=False)\n\n# Write to CSV\ndf.to_csv('output.csv', index=False)\n\n# Write to text file\ndf.to_csv('output.txt', sep='\\t', index=False)\n```\n\n## Memory Optimization\n\nFor large files:\n```python\n# Use chunking for very large files\nchunks = pd.read_excel('large.xlsx', chunksize=10000)\nfor chunk in chunks:\n    process(chunk)\n\n# Specify dtypes to reduce memory\ndf = pd.read_excel('data.xlsx', dtype={'col1': 'int32', 'col2': 'float32'})\n```\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"1f2f9353-159a-4b64-88d7-dc52f26ee006"}
