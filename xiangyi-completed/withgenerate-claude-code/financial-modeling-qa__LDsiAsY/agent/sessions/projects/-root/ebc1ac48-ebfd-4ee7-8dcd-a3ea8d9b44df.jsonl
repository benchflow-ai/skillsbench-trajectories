tion\n```python\n# Create new columns\ndf['new_col'] = df['col1'] + df['col2']\n\n# Apply functions\ndf['processed'] = df['raw'].apply(lambda x: x * 2)\n\n# Conditional transformations\ndf['category'] = df['value'].apply(\n    lambda x: 'high' if x > 100 else 'low'\n)\n\n# Group and aggregate\nresult = df.groupby('category').agg({\n    'value': ['sum', 'mean', 'count']\n})\n```\n\n### 6. Analysis\n```python\n# Filtering\nfiltered = df[df['condition'] == True]\n\n# Sorting\nsorted_df = df.sort_values('column', ascending=False)\n\n# Calculations\ntotal = df['column'].sum()\naverage = df['column'].mean()\nmaximum = df['column'].max()\n\n# Comparisons\ncomparison = df['col1'] > df['col2']\ncount_true = comparison.sum()\n```\n\n### 7. Output Results\n```python\n# Write to file\nresult_df.to_excel('output.xlsx', index=False)\nresult_df.to_csv('output.csv', index=False)\n\n# Write single value\nwith open('answer.txt', 'w') as f:\n    f.write(str(final_answer))\n\n# Write formatted output\nwith open('report.txt', 'w') as f:\n    f.write(f\"Total: {total}\\n\")\n    f.write(f\"Average: {average}\\n\")\n```\n\n## Complete Example Workflow\n\n```python\nimport pandas as pd\nimport numpy as np\n\n# 1. Load data\ndf = pd.read_excel('sales_data.xlsx')\n\n# 2. Explore\nprint(f\"Loaded {len(df)} rows\")\nprint(df.head())\n\n# 3. Clean\ndf = df.dropna()\ndf.columns = df.columns.str.strip()\n\n# 4. Transform\ndf['profit'] = df['revenue'] - df['cost']\ndf['profit_margin'] = df['profit'] / df['revenue'] * 100\n\n# 5. Analyze\nby_region = df.groupby('region').agg({\n    'revenue': 'sum',\n    'profit': 'sum'\n})\n\ntop_region = by_region['profit'].idxmax()\n\n# 6. Output\nwith open('answer.txt', 'w') as f:\n    f.write(top_region)\n\nprint(f\"Top region: {top_region}\")\n```\n\n## Error Handling\n\n```python\nimport pandas as pd\nimport sys\n\ntry:\n    # Load data\n    df = pd.read_excel('data.xlsx')\n\n    # Process\n    result = df['column'].sum()\n\n    # Output\n    with open('answer.txt', 'w') as f:\n        f.write(str(result))\n\nexcept FileNotFoundError:\n    print(\"Error: File not found\")\n    sys.exit(1)\nexcept KeyError as e:\n    print(f\"Error: Column not found: {e}\")\n    sys.exit(1)\nexcept Exception as e:\n    print(f\"Error: {e}\")\n    sys.exit(1)\n```\n\n## Debugging Tips\n\n```python\n# Check specific values\nprint(df.loc[0, 'column'])\n\n# View subset\nprint(df[['col1', 'col2']].head(10))\n\n# Check unique values\nprint(df['column'].unique())\n\n# Value counts\nprint(df['column'].value_counts())\n\n# Check data type issues\nprint(df['column'].apply(type).value_counts())\n\n# Inspect problematic rows\nproblematic = df[df['column'].isnull()]\nprint(problematic)\n```\n\n## Performance Optimization\n\n```python\n# Use categorical for repeated strings\ndf['category'] = df['category'].astype('category')\n\n# Use appropriate dtypes\ndf['id'] = df['id'].astype('int32')  # Instead of int64\n\n# Chunk processing for large files\nchunks = pd.read_excel('large.xlsx', chunksize=10000)\nresults = []\nfor chunk in chunks:\n    result = process_chunk(chunk)\n    results.append(result)\nfinal = pd.concat(results)\n\n# Use vectorized operations instead of loops\n# Bad: df['new'] = df.apply(lambda row: row['a'] + row['b'], axis=1)\n# Good: df['new'] = df['a'] + df['b']\n```\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":5,"cache_creation_input_tokens":3859,"cache_read_input_tokens":43476,"cache_creation":{"ephemeral_5m_input_tokens":3859,"ephemeral_1h_input_tokens":0},"output_tokens":1}},"requestId":"req_vrtx_011CXbApXB4H1CZuPVPdMSC2","type":"assistant","uuid":"60cb32bc-69a9-4c54-a7c8-594410d26ba6","timestamp":"2026-01-29T06:09:05.300Z"}
