dth\n    height = first_page.height\n```\n\n## Using PyMuPDF (fitz)\n\n```python\nimport fitz  # PyMuPDF\n\n# Open PDF\ndoc = fitz.open('document.pdf')\n\n# Extract text from all pages\ntext = ''\nfor page_num in range(len(doc)):\n    page = doc[page_num]\n    text += page.get_text()\n\n# Extract text from specific page\npage = doc[0]\ntext = page.get_text()\n\n# Close document\ndoc.close()\n\n# Alternative: Context manager\nwith fitz.open('document.pdf') as doc:\n    text = ''\n    for page in doc:\n        text += page.get_text()\n```\n\n## Handling Common Issues\n\n### Encrypted PDFs\n```python\nimport PyPDF2\n\nwith open('encrypted.pdf', 'rb') as file:\n    pdf_reader = PyPDF2.PdfReader(file)\n\n    if pdf_reader.is_encrypted:\n        pdf_reader.decrypt('password')\n\n    text = pdf_reader.pages[0].extract_text()\n```\n\n### Extracting Tables\n```python\nimport pdfplumber\nimport pandas as pd\n\nwith pdfplumber.open('document.pdf') as pdf:\n    page = pdf.pages[0]\n    tables = page.extract_tables()\n\n    # Convert to DataFrame\n    for table in tables:\n        df = pd.DataFrame(table[1:], columns=table[0])\n        print(df)\n```\n\n### Handling Multiple Languages\n```python\nimport fitz\n\ndoc = fitz.open('multilingual.pdf')\nfor page in doc:\n    # Extract text with layout preservation\n    text = page.get_text(\"text\")  # Plain text\n    # or\n    text = page.get_text(\"blocks\")  # Text blocks with coordinates\n```\n\n## Best Practices\n\n1. **Choose the right library**:\n   - PyPDF2: Simple text extraction\n   - pdfplumber: Tables and complex layouts\n   - PyMuPDF: Speed and features\n\n2. **Handle encoding issues**:\n   ```python\n   text = text.encode('utf-8', errors='ignore').decode('utf-8')\n   ```\n\n3. **Clean extracted text**:\n   ```python\n   import re\n   # Remove extra whitespace\n   text = re.sub(r'\\s+', ' ', text).strip()\n   ```\n\n4. **Memory management for large PDFs**:\n   ```python\n   # Process page by page instead of loading all at once\n   with pdfplumber.open('large.pdf') as pdf:\n       for i, page in enumerate(pdf.pages):\n           text = page.extract_text()\n           process_text(text)  # Process immediately\n   ```\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"78ce6527-1797-4307-9a3c-d51347415682"}
