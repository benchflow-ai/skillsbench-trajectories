# Custom exfil detection rule
# Alerts on HTTP POST requests to /telemetry/v2/report with X-TLM-Mode: exfil header
# and body containing Base64 blob (≥80 chars) and 64-char hex signature
alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"Suspected data exfiltration via telemetry endpoint"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"X-TLM-Mode|3a| exfil"; nocase; content:"blob="; fast_pattern; pcre:"/blob=([A-Za-z0-9+/=]{80,})/"; pcre:"/sig=([0-9a-fA-F]{64})/"; classtype:attempt-recon; sid:1000001; rev:1; )
