+  /**
+   * Security: Prevent unknown properties (like empty string keys) from being silently ignored.
+   * This prevents bypassing JavaScript security configuration via malicious payloads.
+   */
+  @JsonAnySetter
+  public void handleUnknownProperty(String key, Object value)
+  {
+    // Reject any unknown properties, especially empty or null keys that could bypass security
+    if (key == null || key.isEmpty()) {
+      throw new IllegalArgumentException(
+          "Invalid configuration: empty or null property keys are not allowed"
+      );
+    }
+    // Also reject any other unknown properties to prevent future bypasses
+    throw new IllegalArgumentException(
+        "Invalid configuration: unknown property '" + key + "' is not allowed"
+    );
