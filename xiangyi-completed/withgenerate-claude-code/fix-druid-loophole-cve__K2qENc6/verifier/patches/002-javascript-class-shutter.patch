   public static class JavaScriptPredicateFactory implements DruidPredicateFactory
   {
+    /**
+     * Security: ClassShutter to prevent JavaScript from accessing dangerous Java classes.
+     * This blocks arbitrary code execution via Runtime.getRuntime().exec() and similar attacks.
+     */
+    private static final ClassShutter CLASS_SHUTTER = new ClassShutter()
+    {
+      @Override
+      public boolean visibleToScripts(String className)
+      {
+        // Block access to all Java runtime classes that could execute commands
+        if (className.startsWith("java.lang.Runtime") ||
+            className.startsWith("java.lang.Process") ||
+            className.startsWith("java.lang.ProcessBuilder") ||
+            className.startsWith("java.lang.System") ||
+            className.startsWith("java.lang.Class") ||
+            className.startsWith("java.lang.reflect") ||
+            className.startsWith("java.io.File") ||
+            className.startsWith("java.nio.file") ||
+            className.startsWith("java.net.URL") ||
+            className.startsWith("java.net.URLClassLoader") ||
+            className.startsWith("javax.script") ||
+            className.startsWith("sun.") ||
+            className.startsWith("com.sun.")) {
+          return false;
+        }
+        // Allow other classes by default (can be restricted further if needed)
+        return true;
+      }
+    };
+
     final ScriptableObject scope;
