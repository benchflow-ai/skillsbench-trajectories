# Data exfiltration detection rule
# Detects HTTP POST requests to /telemetry/v2/report with exfil mode enabled
# Requires: blob parameter with >=80 char Base64-like value AND sig parameter with exactly 64 hex chars
alert http any any -> any any (msg:"Suspicious Data Exfiltration via Telemetry Endpoint"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"X-TLM-Mode"; http_header; content:"exfil"; http_header; pcre:"/blob=(?:[A-Za-z0-9+\\/\\-_]){80,}/"; pcre:"/sig=[0-9a-fA-F]{64}(?:[&\\r\\n]|$)/"; sid:1000001; rev:1; classtype:attempted-admin;)
