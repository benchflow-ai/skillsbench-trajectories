+package org.apache.druid.jackson;
+
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import com.fasterxml.jackson.core.util.JsonParserDelegate;
+import com.fasterxml.jackson.databind.DeserializationContext;
+import com.fasterxml.jackson.databind.JsonMappingException;
+import com.fasterxml.jackson.databind.deser.DeserializationProblemHandler;
+import com.fasterxml.jackson.databind.module.SimpleModule;
+
+import java.io.IOException;
+
+/**
+ * Jackson module that adds security-related deserialization checks.
+ * This module prevents security bypass attacks that use empty JSON property names
+ * to inject malicious configuration values.
+ */
+public class DruidSecurityModule extends SimpleModule
+{
+  public DruidSecurityModule()
+  {
+    super("DruidSecurityModule");
+  }
+
+  @Override
+  public void setupModule(SetupContext context)
+  {
+    super.setupModule(context);
+    context.addDeserializationProblemHandler(new EmptyKeyRejectingProblemHandler());
+  }
+
+  /**
+   * Problem handler that intercepts unknown properties and rejects empty property names.
+   * Empty keys in JSON payloads can be used to bypass security settings by injecting
+   * arbitrary configuration values.
+   */
+  private static class EmptyKeyRejectingProblemHandler extends DeserializationProblemHandler
+  {
+    @Override
+    public boolean handleUnknownProperty(
+        DeserializationContext ctxt,
+        JsonParser p,
+        com.fasterxml.jackson.databind.JsonDeserializer<?> deserializer,
+        Object beanOrClass,
+        String propertyName
+    ) throws IOException
+    {
+      if (propertyName != null && propertyName.isEmpty()) {
+        throw JsonMappingException.from(
+            p,
+            "Empty property names are not allowed for security reasons"
+        );
+      }
+      return false;
+    }
+  }
+
+  /**
+   * JsonParser wrapper that validates all field names during parsing and rejects empty keys.
+   * This provides comprehensive protection against empty key injection at any nesting level.
+   */
+  public static class EmptyKeyRejectingJsonParser extends JsonParserDelegate
+  {
+    public EmptyKeyRejectingJsonParser(JsonParser d)
+    {
+      super(d);
+    }
+
+    @Override
+    public JsonToken nextToken() throws IOException
+    {
+      JsonToken token = super.nextToken();
+      validateCurrentFieldName();
+      return token;
+    }
+
+    @Override
+    public String nextFieldName() throws IOException
+    {
+      String fieldName = super.nextFieldName();
+      if (fieldName != null && fieldName.isEmpty()) {
+        throw new IOException("Empty property names are not allowed for security reasons");
+      }
+      return fieldName;
+    }
+
+    private void validateCurrentFieldName() throws IOException
+    {
+      if (currentToken() == JsonToken.FIELD_NAME) {
+        String fieldName = currentName();
+        if (fieldName != null && fieldName.isEmpty()) {
+          throw new IOException("Empty property names are not allowed for security reasons");
+        }
+      }
+    }
+  }
+}
diff --git a/processing/src/main/java/org/apache/druid/jackson/DefaultObjectMapper.java b/processing/src/main/java/org/apache/druid/jackson/DefaultObjectMapper.java
index 235d46731d..d866baff49 100644
--- a/processing/src/main/java/org/apache/druid/jackson/DefaultObjectMapper.java
+++ b/processing/src/main/java/org/apache/druid/jackson/DefaultObjectMapper.java
@@ -49,6 +49,7 @@ public class DefaultObjectMapper extends ObjectMapper
     registerModule(new AggregatorsModule());
     registerModule(new StringComparatorModule());
     registerModule(new SegmentizerModule());
+    registerModule(new DruidSecurityModule());

     configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
     configure(MapperFeature.AUTO_DETECT_GETTERS, false);
