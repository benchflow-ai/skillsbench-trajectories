+  /**
+   * Validates the DataSchema to prevent security threats such as JavaScript filter injection.
+   * This is a critical security check for the sampler endpoint.
+   *
+   * @param dataSchema The DataSchema to validate
+   * @throws IllegalArgumentException if the schema contains JavaScript filters
+   */
+  private static void validateDataSchemaForSecurityThreats(DataSchema dataSchema)
+  {
+    if (dataSchema == null) {
+      return;
+    }
+
+    final TransformSpec transformSpec = dataSchema.getTransformSpec();
+    if (transformSpec == null) {
+      return;
+    }
+
+    final DimFilter filter = transformSpec.getFilter();
+    if (filter != null && filter instanceof JavaScriptDimFilter) {
+      throw new IllegalArgumentException(
+          "JavaScript filters are not allowed in the sampler endpoint for security reasons. "
+          + "JavaScript execution on the server can pose significant security risks. "
+          + "Please use other filter types such as 'selector', 'bound', 'regex', or 'in' filters instead."
+      );
+    }
+  }
