+  /**
+   * Validates the JavaScript function to prevent code injection and access to dangerous Java APIs.
+   * This validation runs at deserialization time, not just at execution time.
+   */
+  private static void validateJavaScriptFunction(String function)
+  {
+    // Reject functions that attempt to access Java runtime
+    String[] dangerousPatterns = {
+        "java.lang.Runtime",
+        "Runtime.getRuntime",
+        "java.lang.ProcessBuilder",
+        "java.lang.System",
+        "java.io.File",
+        "java.io.FileInputStream",
+        "java.io.FileOutputStream",
+        "java.io.InputStream",
+        "java.io.OutputStream",
+        "java.nio.file",
+        "java.net.Socket",
+        "java.net.URL",
+        "java.net.URLConnection",
+        "java.lang.Reflect",
+        "java.lang.ClassLoader",
+        "java.beans.XMLDecoder",
+        "java.rmi",
+        "java.security",
+        "javax.script",
+        "getClass",
+        "forName"
+    };
+
+    for (String pattern : dangerousPatterns) {
+      if (function.contains(pattern)) {
+        throw new IllegalArgumentException(
+            "JavaScript function contains disallowed pattern: " + pattern +
+            ". JavaScript functions cannot access Java APIs."
+        );
+      }
+    }
+  }
+
