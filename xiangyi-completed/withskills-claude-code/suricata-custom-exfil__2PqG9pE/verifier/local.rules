# Data exfiltration detection rule for telemetry POST requests
alert http any any -> any any (msg:"DATA EXFIL: Telemetry POST with exfil header and encoded blob"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"x-tlm-mode|3a|"; http_header; content:"exfil"; http_header; content:"blob="; http_client_body; pcre:"/blob=([A-Za-z0-9\+\/\-_]{80,})/"; content:"sig="; http_client_body; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1; classtype:attempted-admin; priority:1;)
