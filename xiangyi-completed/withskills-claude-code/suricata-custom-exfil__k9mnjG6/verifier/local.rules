# Custom exfiltration detection rule
# Detects POST requests to /telemetry/v2/report with X-TLM-Mode: exfil header
# and telemetry body parameters: blob= (Base64-ish, >=80 chars) and sig= (64 hex chars)
alert http any any -> any any (msg:"Suspicious data exfiltration via telemetry endpoint"; flow:established,to_server; content:"POST"; http.method; content:"/telemetry/v2/report"; http.uri; content:"X-TLM-Mode|3a| exfil"; http.header; content:" "; pkt_data; http_client_body; content:"blob="; pcre:"/blob=[A-Za-z0-9+\\/]{80,}(?=.*sig=[0-9a-fA-F]{64})/s"; sid:1000001; rev:1;)
