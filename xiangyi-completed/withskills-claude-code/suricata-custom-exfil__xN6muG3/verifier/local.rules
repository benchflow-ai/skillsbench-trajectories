# Custom data exfiltration detection rule
# Detects HTTP POST requests to /telemetry/v2/report with X-TLM-Mode: exfil header
# and body containing blob= (Base64, >=80 chars) and sig= (64 hex chars)
alert http any any -> any any (msg:"Custom HTTP Exfiltration Pattern Detected"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; content:"blob="; http_client_body; pcre:"/[A-Za-z0-9+\/]{80,}/"; content:"sig="; distance:-20; within:100; http_client_body; pcre:"/[0-9a-fA-F]{64}/"; content:"X-TLM-Mode|3a| exfil"; distance:-1000; http.header; sid:1000001; rev:1;)
