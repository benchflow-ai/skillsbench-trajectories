# Detect data exfiltration hidden in HTTP telemetry traffic
# Matches POST /telemetry/v2/report with X-TLM-Mode: exfil header
# and body containing blob= (>=80 chars base64) and sig= (exactly 64 hex chars)
alert http any any -> any any (msg:"Suspected data exfiltration in telemetry POST"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"X-TLM-Mode|3a|"; http_header; content:"exfil"; http_header; content:"blob="; http_client_body; pcre:"/blob=([A-Za-z0-9+/\-_]{80,})/"; content:"sig="; http_client_body; pcre:"/sig=([0-9a-f]{64})/i"; sid:1000001; rev:1; classtype:attempted-admin; priority:1;)
