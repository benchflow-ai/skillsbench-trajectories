# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert tcp any any -> any any (msg:"Data Exfiltration via HTTP Telemetry"; flow:established,to_server; content:"POST"; content:"/telemetry/v2/report"; content:"x-tlm-mode|3a 20|exfil"; nocase; content:"blob="; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1;)
