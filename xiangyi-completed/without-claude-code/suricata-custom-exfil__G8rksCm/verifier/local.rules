# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Custom Data Exfiltration via HTTP Telemetry"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; endswith; http.header; content:"X-TLM-Mode|3a 20|exfil"; nocase; http.request_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; http.request_body; pcre:"/sig=[a-fA-F0-9]{64}(?:[^a-fA-F0-9]|$)/"; sid:1000001; rev:1;)
