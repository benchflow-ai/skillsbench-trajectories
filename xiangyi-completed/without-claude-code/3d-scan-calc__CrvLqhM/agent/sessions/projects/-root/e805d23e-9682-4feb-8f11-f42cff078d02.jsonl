eighbor]:\n                        visited[neighbor] = True\n                        queue.append(neighbor)\n\n            components.append(component)\n\n    return components\n\ndef triangle_area(v1, v2, v3):\n    \"\"\"Calculate area of a triangle given 3 vertices.\"\"\"\n    v1 = np.array(v1)\n    v2 = np.array(v2)\n    v3 = np.array(v3)\n\n    # Cross product gives twice the area\n    cross = np.cross(v2 - v1, v3 - v1)\n    return np.linalg.norm(cross) / 2.0\n\ndef tetrahedron_volume(v0, v1, v2, v3):\n    \"\"\"Calculate volume of tetrahedron with vertices v0, v1, v2, v3.\"\"\"\n    v0 = np.array(v0)\n    v1 = np.array(v1)\n    v2 = np.array(v2)\n    v3 = np.array(v3)\n\n    # Volume = |det([v1-v0, v2-v0, v3-v0])| / 6\n    matrix = np.array([v1 - v0, v2 - v0, v3 - v0])\n    return abs(np.linalg.det(matrix)) / 6.0\n\ndef calculate_mesh_volume(triangles_subset, origin=None):\n    \"\"\"\n    Calculate volume of a closed mesh using divergence theorem.\n    Volume = (1/6) * sum of (triangle_vertex_dot_normal)\n    \"\"\"\n    if origin is None:\n        origin = np.array([0.0, 0.0, 0.0])\n    else:\n        origin = np.array(origin)\n\n    total_volume = 0.0\n\n    for v1, v2, v3 in triangles_subset:\n        v1 = np.array(v1)\n        v2 = np.array(v2)\n        v3 = np.array(v3)\n\n        # Calculate normal\n        normal = np.cross(v2 - v1, v3 - v1)\n        normal_magnitude = np.linalg.norm(normal)\n\n        if normal_magnitude < 1e-10:\n            continue\n\n        # Use signed volume contribution\n        volume_contribution = np.dot(v1 - origin, normal) / 6.0\n        total_volume += volume_contribution\n\n    return abs(total_volume)\n\ndef find_material_id_for_component(component, material_ids):\n    \"\"\"Find the most common material ID in a component.\"\"\"\n    mat_ids = [material_ids[tri_idx] for tri_idx in component]\n    if not mat_ids:\n        return None\n\n    # Find most frequent material ID\n    from collections import Counter\n    counter = Counter(mat_ids)\n    return counter.most_common(1)[0][0]\n\ndef get_density_from_table(material_id):\n    \"\"\"Get density from material table.\"\"\"\n    density_table = {\n        1: 0.10,      # Generic Debris\n        10: 7.85,     # Standard Steel\n        25: 2.70,     # Aluminum 6061\n        42: 5.55,     # Unobtanium\n        99: 11.34,    # Lead\n    }\n    return density_table.get(material_id)\n\ndef main():\n    # Parse STL file\n    triangles, material_ids = parse_stl('/root/scan_data.stl')\n    print(f\"Total triangles: {len(triangles)}\")\n    print(f\"Unique material IDs: {set(material_ids)}\")\n\n    # Build connectivity graph\n    adjacency = build_connectivity_graph(triangles)\n\n    # Find connected components\n    components = find_connected_components(adjacency, len(triangles))\n    print(f\"Number of connected components: {len(components)}\")\n\n    # Find largest component by triangle count\n    largest_component = max(components, key=len)\n    print(f\"Largest component size: {len(largest_component)} triangles\")\n\n    # Get material ID for largest component\n    material_id = find_material_id_for_component(largest_component, material_ids)\n    print(f\"Material ID: {material_id}\")\n\n    # Get density\n    density = get_density_from_table(material_id)\n    print(f\"Density: {density} g/cm³\")\n\n    # Calculate volume of largest component\n    largest_triangles = [triangles[i] for i in largest_component]\n    volume = calculate_mesh_volume(largest_triangles)\n    print(f\"Volume: {volume} cm³\")\n\n    # Calculate mass\n    mass = volume * density\n    print(f\"Mass: {mass} g\")\n\n    # Save result to JSON\n    result = {\n        \"main_part_mass\": round(mass, 2),\n        \"material_id\": material_id\n    }\n\n    with open('/root/mass_report.json', 'w') as f:\n        json.dump(result, f, indent=2)\n\n    print(\"\\nResult saved to /root/mass_report.json\")\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[{"oldSt