# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

# Alert on suspected data exfiltration in HTTP telemetry
# Detection criteria:
# 1. POST request to /telemetry/v2/report
# 2. X-TLM-Mode header contains "exfil"
# 3. Body has blob= with >=80 chars of base64-like data
# 4. Body has sig= with exactly 64 hex characters
alert http any any -> any any (msg:"Data Exfiltration via HTTP Telemetry"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"exfil"; http_header; content:"blob="; http_client_body; pcre:"/blob=[a-zA-Z0-9+\/=]{80,}/"; content:"sig="; http_client_body; pcre:"/sig=[0-9a-fA-F]{64}[&\r]?/"; sid:1000001; rev:1; classtype:suspicious-traffic; priority:1;)
