ed by applicable law or agreed to in writing,\nsoftware distributed under the License is distributed on an\n\"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\nKIND, either express or implied.  See the License for the\nspecific language governing permissions and limitations\nunder the License.\n-->\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n\n    <groupId>clusterdata-analysis</groupId>\n    <artifactId>clusterdata-analysis</artifactId>\n    <version>0.1</version>\n    <packaging>jar</packaging>\n\n    <name>Cluster data analysis</name>\n\n    <properties>\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\n        <flink.version>1.18.0</flink.version>\n        <target.java.version>11</target.java.version>\n        <scala.binary.version>2.12</scala.binary.version>\n        <maven.compiler.source>${target.java.version}</maven.compiler.source>\n        <maven.compiler.target>${target.java.version}</maven.compiler.target>\n        <log4j.version>2.17.1</log4j.version>\n    </properties>\n\n    <repositories>\n        <repository>\n            <id>apache.snapshots</id>\n            <name>Apache Development Snapshot Repository</name>\n            <url>https://repository.apache.org/content/repositories/snapshots/</url>\n            <releases>\n                <enabled>false</enabled>\n            </releases>\n            <snapshots>\n                <enabled>true</enabled>\n            </snapshots>\n        </repository>\n    </repositories>\n\n    <dependencies>\n        <!-- Apache Flink dependencies -->\n\n        <!-- https://mvnrepository.com/artifact/org.apache.flink/flink-examples-streaming -->\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-examples-streaming</artifactId>\n            <version>1.18.0</version>\n        </dependency>\n\n        <!-- These dependencies are provided, because they should not be packaged into the JAR file. -->\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-java</artifactId>\n            <version>${flink.version}</version>\n            <scope>provided</scope>\n        </dependency>\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-streaming-java</artifactId>\n            <version>${flink.version}</version>\n            <scope>provided</scope>\n        </dependency>\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-clients</artifactId>\n            <version>${flink.version}</version>\n            <scope>provided</scope>\n        </dependency>\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-walkthrough-common</artifactId>\n            <version>${flink.version}</version>\n            <scope>provided</scope>\n        </dependency>\n\n        <!-- Add connector dependencies here. They must be in the default scope (compile). -->\n\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-connector-kafka</artifactId>\n            <version>1.17.0</version>\n        </dependency>\n\n        <dependency>\n            <groupId>org.apache.flink</groupId>\n            <artifactId>flink-connector-wikiedits</artifactId>\n            <version>${flink.version}</version>\n        </dependency>\n\n        <!-- Add logging framework, to produce console output when running in the IDE. -->\n        <!-- These dependencies are excluded from the application JAR by default. -->\n        <dependency>\n            <groupId>org.apache.logging.log4j</groupId>\n            <artifactId>log4j-slf4j-impl</artifactId>\n            <version>${log4j.version}</version>\n            <scope>runtime</scope>\n        </dependency>\n        <dependency>\n            <groupId>org.apache.logging.log4j</groupId>\n            <artifactId>log4j-api</artifactId>\n            <version>${log4j.version}</version>\n            <scope>runtime</scope>\n        </dependency>\n        <dependency>\n            <groupId>org.apache.logging.log4j</groupId>\n            <artifactId>log4j-core</artifactId>\n            <version>${log4j.version}</version>\n            <scope>runtime</scope>\n        </dependency>\n    </dependencies>\n\n    <build>\n        <plugins>\n\n            <!-- Java Compiler -->\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-compiler-plugin</artifactId>\n                <version>3.9.0</version>\n                <configuration>\n                    <source>${target.java.version}</source>\n                    <target>${target.java.version}</target>\n                </configuration>\n            </plugin>\n\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-assembly-plugin</artifactId>\n                <version>3.3.0</version>\n                <configuration>\n                    <descriptorRefs>\n                        <descriptorRef>jar-with-dependencies</descriptorRef>\n                    </descriptorRefs>\n                </configuration>\n                <executions>\n                    <execution>\n                        <id>LongestSessionPerJob</id>\n                        <phase>package</phase>\n                        <goals>\n                            <goal>single</goal>\n                        </goals>\n                        <configuration>\n                            <finalName>LongestSessionPerJob</finalName>\n                            <archive>\n                                <manifestEntries>\n                                    <program-class>clusterdata.query.LongestSessionPerJob</program-class>\n                                </manifestEntries>\n                            </archive>\n                        </configuration>\n                    </execution>\n                </executions>\n            </plugin>\n\n        </plugins>\n\n        <pluginManagement>\n            <plugins>\n\n                <!-- This improves the out-of-the-box experience in Eclipse by resolving some warnings. -->\n                <plugin>\n                    <groupId>org.eclipse.m2e</groupId>\n                    <artifactId>lifecycle-mapping</artifactId>\n                    <version>1.0.0</version>\n                    <configuration>\n                        <lifecycleMappingMetadata>\n                            <pluginExecutions>\n                                <pluginExecution>\n                                    <pluginExecutionFilter>\n                                        <groupId>org.apache.maven.plugins</groupId>\n                                        <artifactId>maven-shade-plugin</artifactId>\n                                        <versionRange>[3.2.4,)</versionRange>\n                                        <goals>\n                                            <goal>shade</goal>\n                                        </goals>\n                                    </pluginExecutionFilter>\n                                    <action>\n                                        <ignore/>\n                                    </action>\n                                </pluginExecution>\n                                <pluginExecution>\n                                    <pluginExecutionFilter>\n                                        <groupId>org.apache.maven.plugins</groupId>\n                                        <artifactId>maven-compiler-plugin</artifactId>\n                                        <versionRange>[3.9.0,)</versionRange>\n                                        <goals>\n                                            <goal>t