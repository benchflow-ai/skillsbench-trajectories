     StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read task events stream - filter only SUBMIT events\n        DataStream<TaskEvent> taskEvents = env\n                .readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        return TaskEvent.fromString(line);\n                    }\n                })\n                .filter(event -> event != null && event.getEventType() == TaskEvent.SUBMIT)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofMinutes(5))\n                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000) // Convert microseconds to milliseconds\n                );\n\n        // Read job events stream - filter finished jobs\n        DataStream<JobEvent> finishedJobs = env\n                .readTextFile(jobInput)\n                .map(new MapFunction<String, JobEvent>() {\n                    @Override\n                    public JobEvent map(String line) throws Exception {\n                        return JobEvent.fromString(line);\n                    }\n                })\n                .filter(event -> event != null && event.isFinished())\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofMinutes(5))\n                                .withTimestampAssigner((event, ts) -> event.getTimestamp() / 1000) // Convert microseconds to milliseconds\n                );\n\n        // Session window on task submit events per job, counting tasks per session\n        // Session gap is 10 minutes (600 seconds = 600,000 ms)\n        // Output: (jobId, SESSION_COUNT, taskCount)\n        DataStream<Tuple3<Long, Integer, Long>> sessionCounts = taskEvents\n                .keyBy(TaskEvent::getJobId)\n                .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\n                .aggregate(new CountAggregate(), new SessionWindowFunction());\n\n        // Convert finished jobs to (jobId, JOB_FINISHED, 0L)\n        DataStream<Tuple3<Long, Integer, Long>> finishedJobMarkers = finishedJobs\n                .map(new MapFunction<JobEvent, Tuple3<Long, Integer, Long>>() {\n                    @Override\n                    public Tuple3<Long, Integer, Long> map(JobEvent event) throws Exception {\n                        return Tuple3.of(event.getJobId(), JOB_FINISHED, 0L);\n                    }\n                });\n\n        // Union the two streams and use GlobalWindow with EndOfStreamTrigger\n        DataStream<Tuple2<Long, Long>> result = sessionCounts\n                .union(finishedJobMarkers)\n                .keyBy(t -> t.f0)\n                .window(GlobalWindows.create())\n                .trigger(PurgingTrigger.of(EndOfStreamTrigger.create()))\n                .process(new ComputeMaxSessionForFinishedJobs());\n\n        // Write output\n        result.map(new MapFunction<Tuple2<Long, Long>, String>() {\n                    @Override\n                    public String map(Tuple2<Long, Long> value) throws Exception {\n                        return \"(\" + value.f0 + \",\" + value.f1 + \")\";\n                    }\n                })\n                .writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE)\n                .setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    // Aggregate function to count tasks in a session\n    public static class CountAggregate implements AggregateFunction<TaskEvent, Long, Long> {\n        @Override\n        public Long createAccumulator() {\n            return 0L;\n        }\n\n        @Override\n        public Long add(TaskEvent value, Long accumulator) {\n            return accumulator + 1;\n        }\n\n        @Override\n        public Long getResult(Long accumulator) {\n            return accumulator;\n        }\n\n        @Override\n        public Long merge(Long a, Long b) {\n            return a + b;\n        }\n    }\n\n    // Window function to emit (jobId, SESSION_COUNT, taskCount)\n    public static class SessionWindowFunction\n            extends ProcessWindowFunction<Long, Tuple3<Long, Integer, Long>, Long, TimeWindow> {\n        @Override\n        public void process(Long jobId, Context context, Iterable<Long> elements,\n                            Collector<Tuple3<Long, Integer, Long>> out) {\n            Long count = elements.iterator().next();\n            out.collect(Tuple3.of(jobId, SESSION_COUNT, count));\n        }\n    }\n\n    // Trigger that fires when watermark reaches Long.MAX_VALUE (end of stream)\n    public static class EndOfStreamTrigger extends Trigger<Object, GlobalWindow> {\n        private static final long serialVersionUID = 1L;\n\n        private EndOfStreamTrigger() {}\n\n        public static EndOfStreamTrigger create() {\n            return new EndOfStreamTrigger();\n        }\n\n        @Override\n        public TriggerResult onElement(Object element, long timestamp, GlobalWindow window, TriggerContext ctx) {\n            ctx.registerEventTimeTimer(Long.MAX_VALUE - 1);\n            return TriggerResult.CONTINUE;\n        }\n\n        @Override\n        public TriggerResult onProcessingTime(long time, GlobalWindow window, TriggerContext ctx) {\n            return TriggerResult.CONTINUE;\n        }\n\n        @Override\n        public TriggerResult onEventTime(long time, GlobalWindow window, TriggerContext ctx) {\n            return TriggerResult.FIRE;\n        }\n\n        @Override\n        public void clear(GlobalWindow window, TriggerContext ctx) {\n            ctx.deleteEventTimeTimer(Long.MAX_VALUE - 1);\n        }\n    }\n\n    // Process window function to compute max session count for finished jobs\n    public static class ComputeMaxSessionForFinishedJobs\n            extends ProcessWindowFunction<Tuple3<Long, Integer, Long>, Tuple2<Long, Long>, Long, GlobalWindow> {\n\n        @Override\n        public void process(Long jobId, Context context, Iterable<Tuple3<Long, Integer, Long>> elements,\n                            Collector<Tuple2<Long, Long>> out) {\n            boolean isFinished = false;\n            long maxSessionCount = 0;\n\n            for (Tuple3<Long, Integer, Long> element : elements) {\n                if (element.f1 == JOB_FINISHED) {\n                    isFinished = true;\n                } else if (element.f1 == SESSION_COUNT) {\n                    if (element.f2 > maxSessionCount) {\n                        maxSessionCount = element.f2;\n                    }\n                }\n            }\n\n            // Only emit if job is finished and has at least one session\n            if (isFinished && maxSessionCount > 0) {\n                out.collect(Tuple2.of(jobId, maxSessionCount));\n            }\n        }\n    }\n}\n","structuredPatch":[{"oldStart":6,"oldLines":31,"newStart":6,"newLines":36,"lines":[" import org.apache.flink.api.common.eventtime.WatermarkStrategy;"," import org.apache.flink.api.common.functions.AggregateFunction;"," import org.apache.flink.api.common.functions.MapFunction;","-import org.apache.flink.api.common.state.ListState;","-import org.apache.flink.api.common.state.ListStateDescriptor;"," import org.apache.flink.api.common.state.ValueState;"," import org.apache.flink.api.common.state.ValueStateDescriptor;"," import org.apache.flink.api.common.typeinfo.Types;"," import org.apache.flink.api.java.tuple.Tuple2;","+import org.apache.flink.api.java.tuple.Tuple3;"," import org.apache.flink.api.java.utils.ParameterTool;"," import org.apache.flink.configuration.Configuration;"," import org.apache.flink.core.fs.FileSystem;"," import org.apache.flink.streaming.api.datastream.DataStream;"," import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;"," i