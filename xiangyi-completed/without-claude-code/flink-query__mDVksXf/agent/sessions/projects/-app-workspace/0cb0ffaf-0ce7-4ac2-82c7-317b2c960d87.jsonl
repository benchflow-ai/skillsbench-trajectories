rivate ValueState<Boolean> seen;\n\n        @Override\n        public void open(Configuration parameters) {\n            seen = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"seen\", Types.BOOLEAN));\n        }\n\n        @Override\n        public void processElement(Tuple2<Long, Boolean> value, Context ctx,\n                                   Collector<Tuple2<Long, Boolean>> out) throws Exception {\n            if (seen.value() == null) {\n                seen.update(true);\n                out.collect(value);\n            }\n        }\n    }\n\n    // Process function to emit max session count for finished jobs\n    // Uses timer-based approach to ensure all session counts are received before emitting\n    public static class MaxSessionForFinishedJobs\n            extends KeyedCoProcessFunction<Long, Tuple2<Long, Long>, Tuple2<Long, Boolean>, Tuple2<Long, Long>> {\n\n        private ValueState<Long> maxSessionCount;\n        private ValueState<Long> jobFinishTime;\n        private ValueState<Boolean> hasEmitted;\n\n        // Timer delay: 10 minutes (session gap) + buffer to ensure all sessions are received\n        private static final long TIMER_DELAY_MS = 10 * 60 * 1000L + 5 * 60 * 1000L; // 15 minutes\n\n        @Override\n        public void open(Configuration parameters) {\n            maxSessionCount = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"maxSessionCount\", Types.LONG));\n            jobFinishTime = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"jobFinishTime\", Types.LONG));\n            hasEmitted = getRuntimeContext().getState(\n                    new ValueStateDescriptor<>(\"hasEmitted\", Types.BOOLEAN));\n        }\n\n        @Override\n        public void processElement1(Tuple2<Long, Long> sessionCount,\n                                    Context ctx,\n                                    Collector<Tuple2<Long, Long>> out) throws Exception {\n