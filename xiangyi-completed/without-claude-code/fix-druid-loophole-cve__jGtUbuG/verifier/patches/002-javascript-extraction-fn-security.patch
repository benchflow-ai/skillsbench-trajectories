+    // Restricted ClassShutter that prevents access to Java classes from JavaScript
+    ClassShutter classShutter = new ClassShutter()
+    {
+      @Override
+      public boolean visibleToScripts(String fullClassName)
+      {
+        // Block all Java class access from JavaScript
+        // Allow only basic JavaScript types
+        if (fullClassName.startsWith("java.")) {
+          return false;
+        }
+        if (fullClassName.startsWith("javax.")) {
+          return false;
+        }
+        if (fullClassName.startsWith("org.")) {
+          return false;
+        }
+        if (fullClassName.startsWith("com.")) {
+          return false;
+        }
+        // Allow Rhino internal classes but only safe ones
+        if (fullClassName.startsWith("org.mozilla.javascript.")) {
+          String simpleName = fullClassName.substring("org.mozilla.javascript.".length());
+          if (simpleName.startsWith("Undefined") || simpleName.startsWith("NativeObject") ||
+              simpleName.startsWith("NativeArray") || simpleName.startsWith("NativeDate") ||
+              simpleName.startsWith("NativeString") || simpleName.startsWith("NativeNumber") ||
+              simpleName.startsWith("NativeBoolean")) {
+            return true;
+          }
+          return false;
+        }
+        return true;
+      }
+    };
+
