# Data exfiltration detection rule
# Detects HTTP POST requests to /telemetry/v2/report with exfil mode and suspicious payload
alert http any any -> any any (
    msg:"Data exfiltration detected in telemetry report";
    flow:established,to_server;
    content:"POST";
    http_method;
    content:"/telemetry/v2/report";
    http_uri;
    content:"X-TLM-Mode|3a|";
    http_header;
    content:"exfil";
    http_header;
    content:"blob=";
    http_client_body;
    pcre:"/blob=([A-Za-z0-9+\/]{80,})/";
    http_client_body;
    content:"sig=";
    http_client_body;
    pcre:"/sig=[a-f0-9]{64}(?:[&\r\n]|$)/";
    http_client_body;
    sid:1000001;
    rev:1;
    classtype:policy-violation;
    priority:2;
)
