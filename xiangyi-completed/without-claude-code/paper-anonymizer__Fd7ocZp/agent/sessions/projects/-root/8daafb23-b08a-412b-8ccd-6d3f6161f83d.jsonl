ion'\n                else:\n                    del pdf.docinfo[key]","newString":"    # Also clean PDF Info dictionary\n    if pdf.docinfo:\n        # Remove author info\n        for key in ['/Author', '/DOI', '/arXivID', '/License']:\n            if key in pdf.docinfo:\n                del pdf.docinfo[key]\n\n        # Update author to Anonymous\n        pdf.docinfo['/Author'] = 'Anonymous'\n\n        # Keep title but anonymize if needed - or remove it\n        if '/Title' in pdf.docinfo:\n            pdf.docinfo['/Title'] = 'Anonymous Submission'","originalFile":"#!/usr/bin/env python3\n\"\"\"\nPDF Anonymization Script\nRemoves author-identifying information from academic papers including:\n- Author names and affiliations from metadata\n- arXiv identifiers and DOIs\n- Accepted venue information\n- Author names from document content\n\"\"\"\n\nimport pikepdf\nimport re\nimport sys\nfrom pathlib import Path\n\ndef anonymize_pdf(input_path, output_path):\n    \"\"\"Anonymize a PDF by removing author information from metadata and content\"\"\"\n\n    print(f\"Processing: {input_path}\")\n\n    # Open PDF with pikepdf\n    pdf = pikepdf.open(input_path)\n\n    # Step 1: Clean metadata\n    print(\"  - Cleaning metadata...\")\n    with pdf.open_metadata() as meta:\n        # Remove author information\n        if meta.get('dc:creator'):\n            meta['dc:creator'] = ['Anonymous']\n\n        # Remove other identifying metadata\n        for key in ['dc:publisher', 'dc:identifier', 'dc:rights']:\n            if meta.get(key):\n                del meta[key]\n\n    # Also clean PDF Info dictionary\n    if pdf.docinfo:\n        # Remove author info\n        for key in ['/Author', '/Creator', '/Producer', '/Title', '/Subject',\n                    '/Keywords', '/DOI', '/arXivID', '/License']:\n            if key in pdf.docinfo:\n                if key == '/Title':\n                    # Keep title but make it generic if it contains identifying info\n                    pdf.docinfo[key] = 'Anonymous Submission'\n                else:\n                    del pdf.docinfo[key]\n\n    # Step 2: Remove hyperlinks to arXiv and other identifying URLs\n    print(\"  - Removing identifying hyperlinks...\")\n    for page in pdf.pages:\n        if '/Annots' in page:\n            annots_to_keep = []\n            for annot_ref in page.Annots:\n                # Dereference the annotation\n                annot_obj = annot_ref\n                # Check if it's a link annotation\n                if annot_obj.get('/Subtype') == '/Link':\n                    # Check if it has a URI action\n                    if '/A' in annot_obj:\n                        action = annot_obj['/A']\n                        if '/URI' in action:\n                            uri = str(action['/URI'])\n                            # Remove links to arXiv, DOIs, and author pages\n                            if any(domain in uri.lower() for domain in\n                                   ['arxiv.org', 'doi.org', '10.', 'orcid.org']):\n                                print(f\"    Removing link: {uri}\")\n                                continue\n\n                annots_to_keep.append(annot_ref)\n\n            if annots_to_keep:\n                page.Annots = pikepdf.Array(annots_to_keep)\n            else:\n                del page.Annots\n\n    # Step 3: Try to redact text content\n    print(\"  - Redacting author names from content...\")\n\n    # Common patterns for author information\n    # We'll search for and redact these in the content streams\n    author_patterns = [\n        # From paper1.pdf metadata\n        r'Yueqian\\s+Lin', r'Zhengmian\\s+Hu', r'Qinsi\\s+Wang', r'Yudong\\s+Liu',\n        r'Hengfan\\s+Zhang', r'Jayakumar\\s+Subramanian', r'Nikos\\s+Vlassis',\n        r'Hai\\s+Helen\\s+Li', r'Yiran\\s+Chen',\n        # arXiv patterns\n        r'arXiv:\\s*\\d{4}\\.\\d{4,5}',\n        r'https?://arxiv\\.org/\\S+',\n        r'https?://doi\\.org/\\S+',\n        r'doi:\\s*10\\.\\d+/\\S+',\n    ]\n\n    # For each page, process content streams\n    for page_num, page in enumerate(pdf.pages):\n        try:\n            # Get the content stream\n            if '/Contents' in page:\n                contents = page.Contents\n                if not isinstance(contents, list):\n                    contents = [contents]\n\n                for content_stream in contents:\n                    try:\n                        # Get the stream data\n                        stream_obj = pdf.get_object(content_stream)\n                        if hasattr(stream_obj, 'read_bytes'):\n                            data = stream_obj.read_bytes()\n                            modified = False\n\n                            # Try to decode and process\n                            try:\n                                text = data.decode('latin-1', errors='ignore')\n                                original_text = text\n\n                                # Redact author patterns\n                                for pattern in author_patterns:\n                                    if re.search(pattern, text, re.IGNORECASE):\n                                        text = re.sub(pattern, '[REDACTED]', text, flags=re.IGNORECASE)\n                                        modified = True\n\n                                if modified:\n                                    # Write back the modified content\n                                    stream_obj.write(text.encode('latin-1', errors='ignore'))\n                                    print(f\"    Modified content on page {page_num + 1}\")\n                            except:\n                                # If decoding fails, skip this stream\n                                pass\n                    except Exception as e:\n                        # Skip problematic streams\n                        pass\n        except Exception as e:\n            print(f\"    Warning: Could not fully process page {page_num + 1}: {e}\")\n\n    # Save the anonymized PDF\n    print(f\"  - Saving to: {output_path}\")\n    pdf.save(output_path)\n    pdf.close()\n    print(f\"  ✓ Completed: {output_path}\\n\")\n\ndef main():\n    # Process all three papers\n    papers = [\n        ('/root/paper1.pdf', '/root/redacted/paper1.pdf'),\n        ('/root/paper2.pdf', '/root/redacted/paper2.pdf'),\n        ('/root/paper3.pdf', '/root/redacted/paper3.pdf'),\n    ]\n\n    for input_file, output_file in papers:\n        if Path(input_file).exists():\n            try:\n                anonymize_pdf(input_file, output_file)\n            except Exception as e:\n                print(f\"ERROR processing {input_file}: {e}\")\n                sys.exit(1)\n        else:\n            print(f\"ERROR: Input file not found: {input_file}\")\n            sys.exit(1)\n\n    print(\"=\" * 60)\n    print(\"All papers have been anonymized successfully!\")\n    print(\"=\" * 60)\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[{"oldStart":36,"oldLines":15,"newStart":36,"newLines":17,"lines":["     # Also clean PDF Info dictionary","     if pdf.docinfo:","         # Remove author info","-        for key in ['/Author', '/Creator', '/Producer', '/Title', '/Subject',","-                    '/Keywords', '/DOI', '/arXivID', '/License']:","+        for key in ['/Author', '/DOI', '/arXivID', '/License']:","             if key in pdf.docinfo:","-                if key == '/Title':","-                    # Keep title but make it generic if it contains identifying info","-                    pdf.docinfo[key] = 'Anonymous Submission'","-                else:","-                    del pdf.docinfo[key]","+                del pdf.docinfo[key]"," ","+        # Update author to Anonymous","+        pdf.docinfo['/Author'] = 'Anonymous'","+","+        # Keep title but anonymize if needed - or remove it","+        if '/Title' in pdf.docinfo:","+            pdf.docinfo['/Title'] = 'Anonymous Submission'","+","     # Step 2: Remove hyperlinks to arXiv and other identifying URLs","     print(\"  - Removing identifying hyperlinks...\")","     for page in pdf.pages:"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"cdef4aaa-e361-4083-9a62-3392eb661c57"}
