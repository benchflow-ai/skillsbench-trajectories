            pdf.docinfo[key] = 'Anonymous Submission'\n                else:\n                    del pdf.docinfo[key]\n\n    # Step 2: Remove hyperlinks to arXiv and other identifying URLs\n    print(\"  - Removing identifying hyperlinks...\")\n    for page in pdf.pages:\n        if '/Annots' in page:\n            annots_to_keep = []\n            for annot in page.Annots:\n                annot_obj = pdf.get_object(annot)\n                # Check if it's a link annotation\n                if annot_obj.get('/Subtype') == '/Link':\n                    # Check if it has a URI action\n                    if '/A' in annot_obj:\n                        action = annot_obj['/A']\n                        if '/URI' in action:\n                            uri = str(action['/URI'])\n                            # Remove links to arXiv, DOIs, and author pages\n                            if any(domain in uri.lower() for domain in\n                                   ['arxiv.org', 'doi.org', '10.', 'orcid.org']):\n                                print(f\"    Removing link: {uri}\")\n                                continue\n\n                annots_to_keep.append(annot)\n\n            if annots_to_keep:\n                page.Annots = pdf.make_array(annots_to_keep)\n            else:\n                del page.Annots\n\n    # Step 3: Try to redact text content\n    print(\"  - Redacting author names from content...\")\n\n    # Common patterns for author information\n    # We'll search for and redact these in the content streams\n    author_patterns = [\n        # From paper1.pdf metadata\n        r'Yueqian\\s+Lin', r'Zhengmian\\s+Hu', r'Qinsi\\s+Wang', r'Yudong\\s+Liu',\n        r'Hengfan\\s+Zhang', r'Jayakumar\\s+Subramanian', r'Nikos\\s+Vlassis',\n        r'Hai\\s+Helen\\s+Li', r'Yiran\\s+Chen',\n        # arXiv patterns\n        r'arXiv:\\s*\\d{4}\\.\\d{4,5}',\n        r'https?://arxiv\\.org/\\S+',\n        r'https?://doi\\.org/\\S+',\n        r'doi:\\s*10\\.\\d+/\\S+',\n    ]\n\n    # For each page, process content streams\n    for page_num, page in enumerate(pdf.pages):\n        try:\n            # Get the content stream\n            if '/Contents' in page:\n                contents = page.Contents\n                if not isinstance(contents, list):\n                    contents = [contents]\n\n                for content_stream in contents:\n                    try:\n                        # Get the stream data\n                        stream_obj = pdf.get_object(content_stream)\n                        if hasattr(stream_obj, 'read_bytes'):\n                            data = stream_obj.read_bytes()\n                            modified = False\n\n                            # Try to decode and process\n                            try:\n                                text = data.decode('latin-1', errors='ignore')\n                                original_text = text\n\n                                # Redact author patterns\n                                for pattern in author_patterns:\n                                    if re.search(pattern, text, re.IGNORECASE):\n                                        text = re.sub(pattern, '[REDACTED]', text, flags=re.IGNORECASE)\n                                        modified = True\n\n                                if modified:\n                                    # Write back the modified content\n                                    stream_obj.write(text.encode('latin-1', errors='ignore'))\n                                    print(f\"    Modified content on page {page_num + 1}\")\n                            except:\n                                # If decoding fails, skip this stream\n                                pass\n                    except Exception as e:\n                        # Skip problematic streams\n                        pass\n        except Exception as e:\n            print(f\"    Warning: Could not fully process page {page_num + 1}: {e}\")\n\n    # Save the anonymized PDF\n    print(f\"  - Saving to: {output_path}\")\n    pdf.save(output_path)\n    pdf.close()\n    print(f\"  ✓ Completed: {output_path}\\n\")\n\ndef main():\n    # Process all three papers\n    papers = [\n        ('/root/paper1.pdf', '/root/redacted/paper1.pdf'),\n        ('/root/paper2.pdf', '/root/redacted/paper2.pdf'),\n        ('/root/paper3.pdf', '/root/redacted/paper3.pdf'),\n    ]\n\n    for input_file, output_file in papers:\n        if Path(input_file).exists():\n            try:\n                anonymize_pdf(input_file, output_file)\n            except Exception as e:\n                print(f\"ERROR processing {input_file}: {e}\")\n                sys.exit(1)\n        else:\n            print(f\"ERROR: Input file not found: {input_file}\")\n            sys.exit(1)\n\n    print(\"=\" * 60)\n    print(\"All papers have been anonymized successfully!\")\n    print(\"=\" * 60)\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"91afdcd2-765a-463a-8fa5-10c45afa2299"}
