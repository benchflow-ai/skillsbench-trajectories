# Custom exfiltration detection rule
# Detects HTTP POST to /telemetry/v2/report with exfil mode header and Base64 blob + hex signature
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Custom Data Exfiltration Pattern Detected"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"x-tlm-mode"; http_header; nocase; content:"exfil"; http_header; nocase; pcre:"/blob=[A-Za-z0-9+\/\-_]{80,}/"; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1; classtype:attempted-recon;)
