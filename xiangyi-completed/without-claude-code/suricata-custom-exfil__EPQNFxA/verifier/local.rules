# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

# Detection for data exfiltration via HTTP telemetry
# Matches:
#  (1) HTTP POST request
#  (2) Request path exactly /telemetry/v2/report
#  (3) Header contains X-TLM-Mode: exfil (case-insensitive)
#  (4) Body has blob= with Base64-like value >= 80 chars
#  (5) Body has sig= with exactly 64 hex chars
alert http any any -> any any (
  msg:"Suspicious data exfiltration in telemetry report";
  flow:to_server,established;
  http.method:"POST";
  http.uri:"/telemetry/v2/report";
  pcre:"/x-tlm-mode\s*:\s*exfil/i";
  http.header;
  pcre:"/blob=[A-Za-z0-9+\/\-_]{80,}/";
  http.request_body;
  pcre:"/sig=[0-9a-fA-F]{64}(?:&|$)/";
  http.request_body;
  sid:1000001;
  rev:1;
  classtype:attempted-dos;
)
