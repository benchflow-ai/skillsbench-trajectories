# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert tcp any any -> any any (msg:"Custom Data Exfiltration via Telemetry"; flow:established,to_server; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"x-tlm-mode|3a 20|exfil"; http_header; nocase; content:"blob="; http_client_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/P"; content:"sig="; http_client_body; pcre:"/sig=[0-9a-fA-F]{64}(?:&|$)/P"; sid:1000001; rev:1;)
