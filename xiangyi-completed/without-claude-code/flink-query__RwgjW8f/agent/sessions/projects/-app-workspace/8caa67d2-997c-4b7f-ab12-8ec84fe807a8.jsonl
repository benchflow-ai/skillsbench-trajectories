he.flink.api.java.utils.ParameterTool;\nimport org.apache.flink.configuration.Configuration;\nimport org.apache.flink.streaming.api.datastream.DataStream;\nimport org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.KeyedProcessFunction;\nimport org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction;\nimport org.apache.flink.streaming.api.functions.sink.SinkFunction;\nimport org.apache.flink.streaming.api.functions.source.SourceFunction;\nimport org.apache.flink.util.Collector;\n\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.util.zip.GZIPInputStream;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\", null);\n        String jobInput = params.get(\"job_input\", null);\n        String outputPath = params.get(\"output\", null);\n        System.out.println(\"task_input  \" + taskInput);\n        System.out.println(\"job_input  \" + jobInput);\n        final int sesssize = params.getInt(\"sesssize\", 600);\n\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        DataStream<TaskEvent> taskStream = env.addSource(\n                taskSourceOrTest(new GzipCsvTaskSource(taskInput))\n        ).name(\"Task Events Source\");\n\n        DataStream<JobEvent> jobStream = env.addSource(\n                jobSourceOrTest(new GzipCsvJobSource(jobInput))\n        ).name(\"Job Events Source\");\n\n        DataStream<TaskEvent> submitEvents = taskStream\n                .filter(event -> event.eventType == 0)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\n                                .withTimestampAssigner((event, timestamp) -> event.timestamp / 1000)\n                );\n\n        DataStream<JobEvent> jobFinishEvents = jobStream\n                .filter(event -> event.eventType == 5 || event.eventType == 3 || event.eventType == 4)\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forMonotonousTimestamps()\n                                .withTimestampAssigner((event, timestamp) -> event.timestamp / 1000)\n                );\n\n        DataStream<Tuple2<Long, Integer>> result = submitEvents\n                .keyBy(event -> event.jobId)\n                .connect(jobFinishEvents.keyBy(event -> event.jobId))\n                .process(new SessionProcessor(sesssize * 1000L))\n                .name(\"Session Processor\");\n\n        result.addSink(sinkOrTest(new CustomFileSink(outputPath)))\n                .name(\"File Sink\");\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n\n    public static class GzipCsvTaskSource implements SourceFunction<TaskEvent> {\n        private final String filePath;\n        private volatile boolean isRunning = true;\n\n        public GzipCsvTaskSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<TaskEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(\n                            new GZIPInputStream(\n                                    new java.io.FileInputStream(filePath))))) {\n                String line;\n                while (isRunning && (line = reader.readLine()) != null) {\n                    String[] fields = line.split(\",\", -1);\n                    if (fields.length >= 13) {\n                        TaskEvent event = new TaskEvent();\n                        event.timestamp = Long.parseLong(fields[0]);\n                        event.missingInfo = fields[1];\n                        event.jobId = Long.parseLong(fields[2]);\n                        event.taskIndex = Integer.parseInt(fields[3]);\n                        event.machineId = fields[4].isEmpty() ? null : Long.parseLong(fields[4]);\n                        event.eventType = Integer.parseInt(fields[5]);\n                        event.user = fields[6];\n                        event.schedulingClass = Integer.parseInt(fields[7]);\n                        event.priority = Integer.parseInt(fields[8]);\n                        event.cpuRequest = Float.parseFloat(fields[9]);\n                        event.memoryRequest = Float.parseFloat(fields[10]);\n                        event.diskSpaceRequest = Float.parseFloat(fields[11]);\n                        event.differentMachinesRestriction = Integer.parseInt(fields[12]);\n                        ctx.collect(event);\n                    }\n                }\n            }\n        }\n\n        @Override\n        public void cancel() {\n            isRunning = false;\n        }\n    }\n\n    public static class GzipCsvJobSource implements SourceFunction<JobEvent> {\n        private final String filePath;\n        private volatile boolean isRunning = true;\n\n        public GzipCsvJobSource(String filePath) {\n            this.filePath = filePath;\n        }\n\n        @Override\n        public void run(SourceContext<JobEvent> ctx) throws Exception {\n            try (BufferedReader reader = new BufferedReader(\n                    new InputStreamReader(\n                            new GZIPInputStream(\n                                    new java.io.FileInputStream(filePath))))) {\n                String line;\n                while (isRunning && (line = reader.readLine()) != null) {\n                    String[] fields = line.split(\",\", -1);\n                    if (fields.length >= 8) {\n                        JobEvent event = new JobEvent();\n                        event.timestamp = Long.parseLong(fields[0]);\n                        event.missingInfo = fields[1];\n                        event.jobId = Long.