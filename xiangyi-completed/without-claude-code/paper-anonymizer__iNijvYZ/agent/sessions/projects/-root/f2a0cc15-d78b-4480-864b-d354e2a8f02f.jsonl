 ['♠', '♣'],\n            'github': [\n                'github.com/linyueqian', 'linyueqian/VERA', 'linyueqian'\n            ],\n            'venue': ['INTERSPEECH', 'Interspeech', 'ISCA']\n        },\n        'paper2': {\n            'authors': [\n                'Jiatong Shi', 'Yueqian Lin', 'Xinyi Bai', 'Keyi Zhang',\n                'Yuning Wu', 'Yuxun Tang', 'Yifeng Yu', 'Qin Jin',\n                'Shinji Watanabe',\n                'J. Shi', 'Y. Lin', 'X. Bai', 'K. Zhang',\n                'Y. Wu', 'Y. Tang', 'Y. Yu', 'Q. Jin', 'S. Watanabe'\n            ],\n            'affiliations': [\n                'Carnegie Mellon University', 'Duke Kunshan University',\n                'Cornell University', 'Multimodal Art Projection Community',\n                'Renmin University of China', 'Georgia Institute of Technology',\n                'cmu.edu', 'cs.cmu.edu'\n            ],\n            'venue': [\n                'INTERSPEECH', 'Interspeech', 'ISCA'\n            ]\n        },\n        'paper3': {\n            'authors': [\n                'Yueqian Lin', 'Yuzhe Fu', 'Jingyang Zhang', 'Yudong Liu',\n                'Jianyi Zhang', 'Jingwei Sun', 'Hai Li', 'Yiran Chen',\n                'Y. Lin', 'Y. Fu', 'J. Zhang', 'Y. Liu',\n                'J. Sun', 'H. Li', 'Y. Chen'\n            ],\n            'affiliations': [\n                'Duke University', 'Durham', 'USA', 'duke.edu'\n            ],\n            'venue': ['INTERSPEECH', 'Interspeech']\n        }\n    }\n    return patterns\n\ndef anonymize_pdf(input_path, output_path, paper_id):\n    \"\"\"Anonymize a single PDF with comprehensive redactions\"\"\"\n    print(f\"\\nProcessing {input_path}...\")\n\n    doc = fitz.open(input_path)\n\n    # Anonymize metadata\n    print(\"  - Removing metadata...\")\n    anonymize_metadata(doc)\n\n    # Get patterns\n    patterns = get_comprehensive_patterns()\n    paper_patterns = patterns.get(paper_id, {})\n\n    # Flatten all patterns\n    all_patterns = []\n    for category, pattern_list in paper_patterns.items():\n        all_patterns.extend(pattern_list)\n\n    print(f\"  - Processing {len(doc)} pages with {len(all_patterns)} base patterns...\")\n\n    total_redactions = 0\n\n    for page_num in range(len(doc)):\n        page = doc[page_num]\n        text = page.get_text()\n\n        # 1. Redact explicit patterns\n        for pattern in all_patterns:\n            try:\n                areas = page.search_for(pattern)\n                if areas:\n                    for area in areas:\n                        page.add_redact_annot(area, text=\"[REDACTED]\", fill=(0, 0, 0))\n                        total_redactions += 1\n            except:\n                pass\n\n        # 2. Redact email addresses\n        email_pattern = re.compile(r'\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b')\n        for email in email_pattern.findall(text):\n            areas = page.search_for(email)\n            if areas:\n                for area in areas:\n                    page.add_redact_annot(area, text=\"[REDACTED]\", fill=(0, 0, 0))\n                    total_redactions += 1\n\n        # 3. Redact arXiv identifiers\n        arxiv_patterns = [\n            r'arXiv:\\d{4}\\.\\d{4,5}(v\\d+)?',\n            r'\\b\\d{4}\\.\\d{4,5}v?\\d*\\b',\n            r'arxiv\\.org/[^\\s,\\)]+',\n            r'https://arxiv\\.org/[^\\s,\\)]+',\n        ]\n\n        for arxiv_re in arxiv_patterns:\n            for match in re.finditer(arxiv_re, text, re.IGNORECASE):\n                matched_text = match.group()\n                areas = page.search_for(matched_text)\n                if areas:\n                    for area in areas:\n                        page.add_redact_annot(area, text=\"[REDACTED]\", fill=(0, 0, 0))\n                        total_redactions += 1\n\n        # 4. Redact GitHub URLs\n        github_patterns = [\n            r'github\\.com/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)?',\n            r'https://github\\.com/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)?',\n        ]\n\n        for gh_re in github_patterns:\n            for match in re.finditer(gh_re, text, re.IGNORECASE):\n                matched_text = match.group()\n                # Check if contains author usernames\n                if paper_id == 'paper1' and 'linyueqian' in matched_text.lower():\n                    areas = page.search_for(matched_text)\n                    if areas:\n                        for area in areas:\n                            page.add_redact_annot(area, text=\"[REDACTED]\", fill=(0, 0, 0))\n                            total_redactions += 1\n\n        # 5. Redact lines containing correspondence or author info patterns\n        # Look for the specific GitHub URL pattern in paper 1\n        if paper_id == 'paper1' and 'linyueqian' in text.lower():\n            for match in re.finditer(r'[^\\s]+linyueqian[^\\s]*', text, re.IGNORECASE):\n                matched_text = match.group()\n                areas = page.search_for(matched_text)\n                if areas:\n                    for area in areas:\n                        page.add_redact_annot(area, text=\"[REDACTED]\", fill=(0, 0, 0))\n                        total_redactions += 1\n\n        # Apply all redactions on this page\n        page.apply_redactions(images=fitz.PDF_REDACT_IMAGE_NONE)\n\n    print(f\"  - Total redactions: {total_redactions}\")\n    print(f\"  - Saving to {output_path}...\")\n\n    doc.save(output_path, garbage=4, deflate=True, clean=True)\n    doc.close()\n\n    print(f\"  ✓ Completed\")\n\ndef main():\n    \"\"\"Process all papers\"\"\"\n    output_dir = Path(\"/root/redacted\")\n    output_dir.mkdir(exist_ok=True)\n\n    papers = [\n        (\"/root/paper1.pdf\", \"/root/redacted/paper1.pdf\", \"paper1\"),\n        (\"/root/paper2.pdf\", \"/root/redacted/paper2.pdf\", \"paper2\"),\n        (\"/root/paper3.pdf\", \"/root/redacted/paper3.pdf\", \"paper3\"),\n    ]\n\n    print(\"=\"*60)\n    print(\"PDF ANONYMIZATION - Comprehensive Redaction\")\n 