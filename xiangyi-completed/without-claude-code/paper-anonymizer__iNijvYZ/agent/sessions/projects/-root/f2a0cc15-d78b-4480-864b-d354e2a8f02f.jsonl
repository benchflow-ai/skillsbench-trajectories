nto a single list\n    all_patterns = []\n    for category, pattern_list in paper_patterns.items():\n        all_patterns.extend(pattern_list)\n\n    print(f\"  - Searching for {len(all_patterns)} patterns across {len(doc)} pages...\")\n\n    # Process each page\n    total_redactions = 0\n    for page_num in range(len(doc)):\n        page = doc[page_num]\n\n        # Search for each pattern and add redaction annotations\n        for pattern in all_patterns:\n            try:\n                areas = page.search_for(pattern)\n                for area in areas:\n                    # Add redaction annotation (this will remove the text when applied)\n                    page.add_redact_annot(area, text=\"\", fill=(0, 0, 0))\n                    total_redactions += 1\n            except Exception as e:\n                # Silently continue on errors\n                pass\n\n        # Search for email patterns using regex\n        text = page.get_text()\n        email_pattern = re.compile(r'\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b')\n        emails = email_pattern.findall(text)\n\n        for email in emails:\n            areas = page.search_for(email)\n            for area in areas:\n                page.add_redact_annot(area, text=\"\", fill=(0, 0, 0))\n                total_redactions += 1\n\n        # Search for arXiv patterns\n        arxiv_patterns = [\n            re.compile(r'arXiv:\\d{4}\\.\\d{4,5}(v\\d+)?', re.IGNORECASE),\n            re.compile(r'\\b\\d{4}\\.\\d{4,5}v?\\d*\\b'),\n            re.compile(r'arxiv\\.org/[^\\s,\\)]+', re.IGNORECASE)\n        ]\n\n        for arxiv_re in arxiv_patterns:\n            matches = arxiv_re.findall(text)\n            for match in matches:\n                # Handle tuple results from regex groups\n                if isinstance(match, tuple):\n                    match = ''.join(match)\n                areas = page.search_for(match)\n                for area in areas:\n                    page.add_redact_annot(area, text=\"\", fill=(0, 0, 0))\n                    total_redactions += 1\n\n        # Apply all redactions on this page\n        page.apply_redactions(images=fitz.PDF_REDACT_IMAGE_NONE)\n\n    print(f\"  - Total redactions applied: {total_redactions}\")\n\n    # Save the anonymized PDF\n    print(f\"  - Saving to {output_path}...\")\n    doc.save(output_path, garbage=4, deflate=True, clean=True)\n    doc.close()\n\n    print(f\"  ✓ Successfully anonymized {input_path}\")\n\ndef main():\n    \"\"\"Main function to process all three papers\"\"\"\n    # Create output directory\n    output_dir = Path(\"/root/redacted\")\n    output_dir.mkdir(exist_ok=True)\n    print(f\"Created output directory: {output_dir}\")\n\n    # Process each paper\n    papers = [\n        (\"/root/paper1.pdf\", \"/root/redacted/paper1.pdf\", \"paper1\"),\n        (\"/root/paper2.pdf\", \"/root/redacted/paper2.pdf\", \"paper2\"),\n        (\"/root/paper3.pdf\", \"/root/redacted/paper3.pdf\", \"paper3\"),\n    ]\n\n    for input_path, output_path, paper_id in papers:\n        if os.path.exists(input_path):\n            try:\n                anonymize_pdf(input_path, output_path, paper_id)\n            except Exception as e:\n                print(f\"ERROR processing {input_path}: {e}\")\n                import traceback\n                traceback.print_exc()\n        else:\n            print(f\"WARNING: {input_path} not found, skipping...\")\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"Anonymization complete!\")\n    print(\"=\"*60)\n    print(f\"\\nRedacted PDFs saved to: {output_dir}\")\n    print(\"\\nPlease review the redacted PDFs to ensure all identifying\")\n    print(\"information has been properly removed.\")\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"512eaa60-9004-4559-be81-0a6de60d1b8f"}
