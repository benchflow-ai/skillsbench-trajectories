 and next_line[0] in ['+', '-', '×', '·', '=']\n                has_continuation_math = any(indicator in next_line for indicator in math_indicators)\n                is_very_short = len(next_line) < 40\n\n                # Check if next line has equation number (end of formula)\n                next_has_eq_num = re.search(equation_num_pattern, next_line)\n\n                if next_has_eq_num:\n                    formula_lines.append(next_line)\n                    j += 1\n                    break\n                elif (starts_with_operator or (has_continuation_math and is_very_short)):\n                    formula_lines.append(next_line)\n                    j += 1\n                else:\n                    break\n\n            # Combine formula lines\n            formula = ' '.join(formula_lines)\n\n            # Clean up the formula\n            formula = clean_formula(formula)\n\n            # Only add if it's substantial (not just a symbol)\n            if len(formula) > 3:\n                formulas.append(formula)\n\n            i = j\n        else:\n            i += 1\n\n    return formulas\n\nif __name__ == '__main__':\n    text_file = '/tmp/pdf_full_text.txt'\n\n    formulas = extract_display_formulas_from_text(text_file)\n\n    print(f\"\\nExtracted {len(formulas)} display formulas\\n\")\n\n    # Save formulas\n    with open('/tmp/formulas_extracted.txt', 'w') as f:\n        for i, formula in enumerate(formulas, 1):\n            f.write(f\"Formula {i}:\\n$$\\n{formula}\\n$$\\n\\n\")\n\n    print(\"Formulas saved to /tmp/formulas_extracted.txt\")\n\n    # Display all formulas\n    print(\"\\n\" + \"=\"*60)\n    print(\"ALL EXTRACTED FORMULAS:\")\n    print(\"=\"*60 + \"\\n\")\n\n    for i, formula in enumerate(formulas, 1):\n        print(f\"{i}. $${formula}$$\\n\")\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":5,"cache_creation_input_tokens":5916,"cache_read_input_tokens":27888,"cache_creation":{"ephemeral_5m_input_tokens":5916,"e