# Category 4: Only two numbers - all rolls are one of two numbers (score: 30)\n    unique_nums = set(rolls)\n    if len(unique_nums) == 2:\n        scores['Only two numbers'] = 30\n    else:\n        scores['Only two numbers'] = 0\n    \n    # Category 5: All the numbers - rolls are 1,2,3,4,5,6 in any order (score: 40)\n    if sorted(rolls) == [1, 2, 3, 4, 5, 6]:\n        scores['All the numbers'] = 40\n    else:\n        scores['All the numbers'] = 0\n    \n    # Category 6: Ordered subset of four - contains run of 4 consecutive (score: 50)\n    def has_consecutive_run_of_4(rolls):\n        # Check in the order rolled for runs of 4 consecutive increasing or decreasing\n        for i in range(len(rolls) - 3):\n            # Get 4 consecutive rolls\n            four_rolls = rolls[i:i+4]\n            # Check if increasing: each next is exactly 1 more\n            if all(four_rolls[j+1] == four_rolls[j] + 1 for j in range(3)):\n                return True\n            # Check if decreasing: each next is exactly 1 less\n            if all(four_rolls[j+1] == four_rolls[j] - 1 for j in range(3)):\n                return True\n        return False\n    \n    if has_consecutive_run_of_4(rolls):\n        scores['Ordered subset of four'] = 50\n    else:\n        scores['Ordered subset of four'] = 0\n    \n    return scores\n\n# Test with first turn\ntest_rolls = clean_df.iloc[0][['Roll1', 'Roll2', 'Roll3', 'Roll4', 'Roll5', 'Roll6']].tolist()\nprint(f\"\\nTest turn rolls: {test_rolls}\")\nprint(f\"Test scores: {calculate_turn_scores(test_rolls)}\")\n\nEOFPYTHON","description":"Test scoring function","timeout":30000}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":869,"cache_read_input_tokens":52648,"cache_creation":{"ephemeral_5m_input_tokens":869,"ephemeral_1h_input_tokens":0},"output_tokens":1}},"requestId":"req_vrtx_011CXb8PpC4qEGjkArEySr7A","type":"assistant","uuid":"81b34f03-6e91-4195-9d5e-41cb3b4c529a","timestamp":"2026-