 for j in range(3)):\n                return True\n        return False\n    \n    scores['Ordered subset of four'] = 50 if has_consecutive_run_of_4(rolls) else 0\n    \n    return scores\n\n# Calculate scores for all turns\nprint(\"Calculating scores for all turns...\")\nturn_scores = []\nfor idx, row in clean_df.iterrows():\n    rolls = row[['Roll1', 'Roll2', 'Roll3', 'Roll4', 'Roll5', 'Roll6']].tolist()\n    scores = calculate_turn_scores(rolls)\n    turn_scores.append({\n        'Turn': row['Turn'],\n        'Game': row['Game'],\n        **scores\n    })\n\nturn_scores_df = pd.DataFrame(turn_scores)\nprint(f\"Calculated scores for {len(turn_scores_df)} turns\")\n\n# Now calculate the best score for each game\n# Each game has 2 turns, and we need to pick different categories for each turn\ncategories = ['High and Often', 'Summation', 'Highs and Lows', 'Only two numbers', 'All the numbers', 'Ordered subset of four']\n\ngame_results = []\nfor game_num in sorted(clean_df['Game'].unique()):\n    game_turns = turn_scores_df[turn_scores_df['Game'] == game_num]\n    \n    if len(game_turns) != 2:\n        print(f\"Warning: Game {game_num} has {len(game_turns)} turns\")\n        continue\n    \n    turn1_scores = game_turns.iloc[0]\n    turn2_scores = game_turns.iloc[1]\n    \n    # Find best combination where each turn uses a different category\n    best_score = 0\n    best_combo = None\n    \n    for cat1 in categories:\n        for cat2 in categories:\n            if cat1 != cat2:  # Can't use same category twice\n                total = turn1_scores[cat1] + turn2_scores[cat2]\n                if total > best_score:\n                    best_score = total\n                    best_combo = (cat1, cat2)\n    \n    game_results.append({\n        'Game': game_num,\n        'Best_Score': best_score,\n        'Turn1_Category': best_combo[0],\n        'Turn2_Category': best_combo[1]\n    })\n\ngame_results_df = pd.DataFrame(game_results)\nprint(f\"\\nCalculated best scores f