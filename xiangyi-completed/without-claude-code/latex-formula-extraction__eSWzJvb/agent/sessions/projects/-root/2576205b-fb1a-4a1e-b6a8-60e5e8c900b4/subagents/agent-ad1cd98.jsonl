he line with equation number\n    eq_line_idx = None\n    for i, line in enumerate(lines):\n        if line.strip().endswith(equation_marker):\n            eq_line_idx = i\n            break\n\n    if eq_line_idx is None:\n        return None\n\n    # Collect lines backwards from equation number\n    for i in range(eq_line_idx, -1, -1):\n        line = lines[i].strip()\n        formula_lines.insert(0, line)\n\n        # Stop if we hit clear text (not formula content)\n        if i < eq_line_idx:\n            # Check if this line looks like start of formula\n            # Formula typically starts with a variable name followed by =\n            if re.match(r'^[a-zA-Z_][a-zA-Z0-9_,()]*\\s*=', line) or \\\n               re.match(r'^d\\d*[a-zA-Z]', line):  # derivatives like d2xi/dt2\n                # Check previous line - if it's text, we found the start\n                if i > 0:\n                    prev = lines[i-1].strip()\n                    if prev and not any(c in prev for c in ['=', '∑', '∏', '∫', 'exp', 'cos', 'sin']):\n                        break\n\n    # Join and clean up\n    formula = '\\n'.join(formula_lines)\n    # Remove equation number\n    formula = re.sub(r'\\s*\\(\\d+\\)\\s*$', '', formula)\n\n    return formula.strip()\n\n# Extract all numbered equations\nprint(\"Extracting all display formulas from the paper...\")\nprint()\n\nequations = {}\nfor eq_num in range(1, 20):  # Try numbers 1-20\n    eq = find_equation(lines, eq_num)\n    if eq and len(eq) > 5:  # Valid equation found\n        equations[eq_num] = eq\n\n# Print all found equations\nfor num in sorted(equations.keys()):\n    print(f\"Equation ({num}):\")\n    print(equations[num])\n    print()\n    print(\"-\" * 80)\n    print()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":183,"cache_read_input_tokens":37262,"cache_creation":{"ephemeral_5m_input_tokens":183,"ephemeral_1h_input_tokens":0},"output_tokens":1}},"requestId":"req_vrtx_0