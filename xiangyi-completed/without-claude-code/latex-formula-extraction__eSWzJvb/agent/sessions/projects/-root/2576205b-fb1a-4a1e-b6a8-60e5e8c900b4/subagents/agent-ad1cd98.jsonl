 = any(re.search(pattern, line) for pattern in math_indicators)\n\n    # Also check if the line has equation numbering like (1), (2), etc at the end\n    has_equation_number = re.search(r'\\(\\d+\\)\\s*$', line)\n\n    if is_math or has_equation_number:\n        # This might be a formula\n        # Clean up the formula\n        formula = line\n\n        # Remove equation numbers at the end\n        formula = re.sub(r'\\s*\\(\\d+\\)\\s*$', '', formula)\n\n        # Remove trailing punctuation that's not part of math\n        # But be careful not to remove mathematical operators\n\n        if formula:\n            formulas.append(formula)\n\n    i += 1\n\n# Print all formulas\nprint(\"=\" * 80)\nprint(f\"Found {len(formulas)} potential formulas:\")\nprint(\"=\" * 80)\nfor idx, formula in enumerate(formulas, 1):\n    print(f\"\\n{idx}. {formula}\")\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":281,"cache_read_input_tokens":26998,"cache_creation":{"ephemeral_5m_input_tokens":281,"ephemeral_1h_input_tokens":0},"output_tokens":1}},"requestId":"req_vrtx_011CXb85M4AXkYh3UnuWZsZ5","type":"assistant","uuid":"441fb4ab-b857-4466-8306-a14079340e63","timestamp":"2026-01-29T05:32:58.837Z"}
