{"parentUuid":"a055be19-7518-4017-b4a9-e29a4492d9ea","isSidechain":false,"userType":"external","cwd":"/root/workspace","sessionId":"36112abe-e955-4a88-a30e-018625099bad","version":"2.1.19","gitBranch":"","slug":"peppy-popping-wigderson","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01J5ZHosws1JXM3nhr3U6xv9","type":"tool_result","content":"     1→\"\"\"\n     2→Solution for finding top k similar chemicals using Tanimoto similarity.\n     3→Uses Morgan fingerprints with radius=2 and chirality enabled.\n     4→\"\"\"\n     5→\n     6→import PyPDF2\n     7→from rdkit import Chem\n     8→from rdkit.Chem import AllChem\n     9→from rdkit import DataStructs\n    10→import pubchempy as pcp\n    11→\n    12→\n    13→def get_smiles_from_name(chemical_name):\n    14→    \"\"\"\n    15→    Convert chemical name to SMILES representation using PubChem.\n    16→\n    17→    Args:\n    18→        chemical_name: Name of the chemical\n    19→\n    20→    Returns:\n    21→        SMILES string or None if not found\n    22→    \"\"\"\n    23→    try:\n    24→        # Search PubChem for the compound\n    25→        compounds = pcp.get_compounds(chemical_name, 'name')\n    26→        if compounds:\n    27→            # Return the canonical SMILES of the first match\n    28→            return compounds[0].canonical_smiles\n    29→    except Exception as e:\n    30→        print(f\"Error fetching SMILES for {chemical_name}: {e}\")\n    31→    return None\n    32→\n    33→\n    34→def get_morgan_fingerprint(smiles, radius=2, use_chirality=True):\n    35→    \"\"\"\n    36→    Generate Morgan fingerprint from SMILES string.\n    37→\n    38→    Args:\n    39→        smiles: SMILES representation of molecule\n    40→        radius: Morgan fingerprint radius (default=2)\n    41→        use_chirality: Include chirality information (default=True)\n    42→\n    43→    Returns:\n    44→        Morgan fingerprint or None if conversion fails\n    45→    \"\"\"\n    46→    try:\n    47→        mol = Chem.MolFromSmiles(smiles)\n    48→        if mol is None:\n    49→            return None\n    50→        # Generate Morgan fingerprint with radius=2 and chirality\n    51→        fp = AllChem.GetMorganFingerprintAsBitVect(\n    52→            mol,\n    53→            radius=radius,\n    54→            nBits=2048,\n    55→            useChirality=use_chirality\n    56→        )\n    57→        return fp\n    58→    except Exception as e:\n    59→        print(f\"Error generating fingerprint for {smiles}: {e}\")\n    60→        return None\n    61→\n    62→\n    63→def calculate_tanimoto_similarity(fp1, fp2):\n    64→    \"\"\"\n    65→    Calculate Tanimoto similarity between two fingerprints.\n    66→\n    67→    Args:\n    68→        fp1: First fingerprint\n    69→        fp2: Second fingerprint\n    70→\n    71→    Returns:\n    72→        Tanimoto similarity score (0 to 1)\n    73→    \"\"\"\n    74→    return DataStructs.TanimotoSimilarity(fp1, fp2)\n    75→\n    76→\n    77→def extract_molecules_from_pdf(filepath):\n    78→    \"\"\"\n    79→    Extract chemical names from PDF file.\n    80→\n    81→    Args:\n    82→        filepath: Path to PDF file\n    83→\n    84→    Returns:\n    85→        List of chemical names\n    86→    \"\"\"\n    87→    molecules = []\n    88→    try:\n    89→        with open(filepath, 'rb') as file:\n    90→            pdf_reader = PyPDF2.PdfReader(file)\n    91→            all_text = \"\"\n    92→            for page in pdf_reader.pages:\n    93→                all_text += page.extract_text()\n    94→\n    95→        # Split by lines and filter out empty lines\n    96→        lines = [line.strip() for line in all_text.split('\\n') if line.strip()]\n    97→\n    98→        # Some lines might have multiple molecules separated by spaces\n    99→        # We'll keep them as-is since the PDF seems to mostly have one per line\n   100→        molecules = lines\n   101→\n   102→    except Exception as e:\n   103→        print(f\"Error reading PDF: {e}\")\n   104→\n   105→    return molecules\n   106→\n   107→\n   108→def topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n   109→    \"\"\"\n   110→    Find the top k most similar molecules to a target molecule.\n   111→\n   112→    Args:\n   113→        target_molecule_name: Name of the target molecule\n   114→        molecule_pool_filepath: Path to PDF file containing molecule names\n   115→        top_k: Number of top similar molecules to return\n   116→\n   117→    Returns:\n   118→        List of molecule names sorted by similarity (descending), with alphabetical\n   119→        ordering for ties. The list contains up to top_k molecules.\n   120→    \"\"\"\n   121→    # Extract molecules from PDF\n   122→    molecule_pool = extract_molecules_from_pdf(molecule_pool_filepath)\n   123→\n   124→    if not molecule_pool:\n   125→        print(\"No molecules found in PDF\")\n   126→        return []\n   127→\n   128→    # Get SMILES for target molecule\n   129→    print(f\"Fetching SMILES for target: {target_molecule_name}\")\n   130→    target_smiles = get_smiles_from_name(target_molecule_name)\n   131→\n   132→    if target_smiles is None:\n   133→        print(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n   134→        return []\n   135→\n   136→    # Get fingerprint for target molecule\n   137→    target_fp = get_morgan_fingerprint(target_smiles, radius=2, use_chirality=True)\n   138→\n   139→    if target_fp is None:\n   140→        print(f\"Could not generate fingerprint for target molecule: {target_molecule_name}\")\n   141→        return []\n   142→\n   143→    # Calculate similarities for all molecules in the pool\n   144→    similarities = []\n   145→\n   146→    for mol_name in molecule_pool:\n   147→        # Skip the target molecule itself if it's in the pool\n   148→        if mol_name.lower() == target_molecule_name.lower():\n   149→            continue\n   150→\n   151→        print(f\"Processing: {mol_name}\")\n   152→\n   153→        # Get SMILES for pool molecule\n   154→        mol_smiles = get_smiles_from_name(mol_name)\n   155→\n   156→        if mol_smiles is None:\n   157→            print(f\"  -> Could not find SMILES for {mol_name}\")\n   158→            continue\n   159→\n   160→        # Get fingerprint for pool molecule\n   161→        mol_fp = get_morgan_fingerprint(mol_smiles, radius=2, use_chirality=True)\n   162→\n   163→        if mol_fp is None:\n   164→            print(f\"  -> Could not generate fingerprint for {mol_name}\")\n   165→            continue\n   166→\n   167→        # Calculate Tanimoto similarity\n   168→        similarity = calculate_tanimoto_similarity(target_fp, mol_fp)\n   169→        similarities.append((mol_name, similarity))\n   170→        print(f\"  -> Similarity: {similarity:.4f}\")\n   171→\n   172→    # Sort by similarity (descending), then by name (alphabetically) for ties\n   173→    # Using negative similarity for descending order, then molecule name for alphabetical\n   174→    similarities.sort(key=lambda x: (-x[1], x[0]))\n   175→\n   176→    # Return top k molecules (just the names, not the scores)\n   177→    top_k_molecules = [mol_name for mol_name, _ in similarities[:top_k]]\n   178→\n   179→    return top_k_molecules\n   180→\n   181→\n   182→if __name__ == \"__main__\":\n   183→    # Example usage\n   184→    target = \"Aspirin\"\n   185→    pdf_path = \"/root/molecules.pdf\"\n   186→    k = 5\n   187→\n   188→    print(f\"Finding top {k} molecules similar to {target}...\")\n   189→    print(\"=\" * 60)\n   190→\n   191→    results = topk_tanimoto_similarity_molecules(target, pdf_path, k)\n   192→\n   193→    print(\"\\n\" + \"=\" * 60)\n   194→    print(f\"Top {k} similar molecules to {target}:\")\n   195→    for i, mol in enumerate(results, 1):\n   196→        print(f\"{i}. {mol}\")\n   197→\n\n<system-reminder>\nWhenever you read a file,