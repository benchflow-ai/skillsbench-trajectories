s[0].canonical_smiles\n        except Exception as e:\n            if \"503\" in str(e) or \"ServerBusy\" in str(e):\n                # Rate limiting - wait and retry\n                if attempt < max_retries - 1:\n                    time.sleep(delay * (attempt + 1))  # Exponential backoff\n                    continue\n            print(f\"Error fetching SMILES for {chemical_name}: {e}\")\n    return None","originalFile":"\"\"\"\nSolution for finding top k similar chemicals using Tanimoto similarity.\nUses Morgan fingerprints with radius=2 and chirality enabled.\n\"\"\"\n\nimport PyPDF2\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom rdkit import DataStructs\nimport pubchempy as pcp\nimport time\nimport warnings\n\n# Suppress deprecation warnings from RDKit\nwarnings.filterwarnings('ignore', category=DeprecationWarning)\n\n\ndef get_smiles_from_name(chemical_name):\n    \"\"\"\n    Convert chemical name to SMILES representation using PubChem.\n\n    Args:\n        chemical_name: Name of the chemical\n\n    Returns:\n        SMILES string or None if not found\n    \"\"\"\n    try:\n        # Search PubChem for the compound\n        compounds = pcp.get_compounds(chemical_name, 'name')\n        if compounds:\n            # Return the canonical SMILES of the first match\n            return compounds[0].canonical_smiles\n    except Exception as e:\n        print(f\"Error fetching SMILES for {chemical_name}: {e}\")\n    return None\n\n\ndef get_morgan_fingerprint(smiles, radius=2, use_chirality=True):\n    \"\"\"\n    Generate Morgan fingerprint from SMILES string.\n\n    Args:\n        smiles: SMILES representation of molecule\n        radius: Morgan fingerprint radius (default=2)\n        use_chirality: Include chirality information (default=True)\n\n    Returns:\n        Morgan fingerprint or None if conversion fails\n    \"\"\"\n    try:\n        mol = Chem.MolFromSmiles(smiles)\n        if mol is None:\n            return None\n        # Generate Morgan fingerprint with radius=2 and chirality\n        fp = AllChem.GetMorganFingerprintAsBitVect(\n            mol,\n            radius=radius,\n            nBits=2048,\n            useChirality=use_chirality\n        )\n        return fp\n    except Exception as e:\n        print(f\"Error generating fingerprint for {smiles}: {e}\")\n        return None\n\n\ndef calculate_tanimoto_similarity(fp1, fp2):\n    \"\"\"\n    Calculate Tanimoto similarity between two fingerprints.\n\n    Args:\n        fp1: First fingerprint\n        fp2: Second fingerprint\n\n    Returns:\n        Tanimoto similarity score (0 to 1)\n    \"\"\"\n    return DataStructs.TanimotoSimilarity(fp1, fp2)\n\n\ndef extract_molecules_from_pdf(filepath):\n    \"\"\"\n    Extract chemical names from PDF file.\n\n    Args:\n        filepath: Path to PDF file\n\n    Returns:\n        List of chemical names\n    \"\"\"\n    molecules = []\n    try:\n        with open(filepath, 'rb') as file:\n            pdf_reader = PyPDF2.PdfReader(file)\n            all_text = \"\"\n            for page in pdf_reader.pages:\n                all_text += page.extract_text()\n\n        # Split by lines and filter out empty lines\n        lines = [line.strip() for line in all_text.split('\\n') if line.strip()]\n\n        # Some lines might have multiple molecules separated by spaces\n        # We'll keep them as-is since the PDF seems to mostly have one per line\n        molecules = lines\n\n    except Exception as e:\n        print(f\"Error reading PDF: {e}\")\n\n    return molecules\n\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    \"\"\"\n    Find the top k most similar molecules to a target molecule.\n\n    Args:\n        target_molecule_name: Name of the target molecule\n        molecule_pool_filepath: Path to PDF file containing molecule names\n        top_k: Number of top similar molecules to return\n\n    Returns:\n        List of molecule names sorted by similarity (descending), with alphabetical\n        ordering for ties. The list contains up to top_k molecules.\n    \"\"\"\n    # Extract molecules from PDF\n    molecule_pool = extract_molecules_from_pdf(molecule_pool_filepath)\n\n    if not molecule_pool:\n        print(\"No molecules found in PDF\")\n        return []\n\n    # Get SMILES for target molecule\n    print(f\"Fetching SMILES for target: {target_molecule_name}\")\n    target_smiles = get_smiles_from_name(target_molecule_name)\n\n    if target_smiles is None:\n        print(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n        return []\n\n    # Get fingerprint for target molecule\n    target_fp = get_morgan_fingerprint(target_smiles, radius=2, use_chirality=True)\n\n    if target_fp is None:\n        print(f\"Could not generate fingerprint for target molecule: {target_molecule_name}\")\n        return []\n\n    # Calculate similarities for all molecules in the pool\n    similarities = []\n\n    for mol_name in molecule_pool:\n        # Skip the target molecule itself if it's in the pool\n        if mol_name.lower() == target_molecule_name.lower():\n            continue\n\n        print(f\"Processing: {mol_name}\")\n\n        # Get SMILES for pool molecule\n        mol_smiles = get_smiles_from_name(mol_name)\n\n        if mol_smiles is None:\n            print(f\"  -> Could not find SMILES for {mol_name}\")\n            continue\n\n        # Get fingerprint for pool molecule\n        mol_fp = get_morgan_fingerprint(mol_smiles, radius=2, use_chirality=True)\n\n        if mol_fp is None:\n            print(f\"  -> Could not generate fingerprint for {mol_name}\")\n            continue\n\n        # Calculate Tanimoto similarity\n        similarity = calculate_tanimoto_similarity(target_fp, mol_fp)\n        similarities.append((mol_name, similarity))\n        print(f\"  -> Similarity: {similarity:.4f}\")\n\n    # Sort by similarity (descending), then by name (alphabetically) for ties\n    # Using negative similarity for descending order, then molecule name for alphabetical\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n\n    # Return top k molecules (just the names, not the scores)\n    top_k_molecules = [mol_name for mol_name, _ in similarities[:top_k]]\n\n    return top_k_molecules\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    target = \"Aspirin\"\n    pdf_path = \"/root/molecules.pdf\"\n    k = 5\n\n    print(f\"Finding top {k} molecules similar to {target}...\")\n    print(\"=\" * 60)\n\n    results = topk_tanimoto_similarity_molecules(target, pdf_path, k)\n\n    print(\"\\n\" + \"=\" * 60)\n    print(f\"Top {k} similar molecules to {target}:\")\n    for i, mol in enumerate(results, 1):\n        print(f\"{i}. {mol}\")\n","structuredPatch":[{"oldStart":15,"oldLines":24,"newStart":15,"newLines":37,"lines":[" warnings.filterwarnings('ignore', category=DeprecationWarning)"," "," ","-def get_smiles_from_name(chemical_name):","+def get_smiles_from_name(chemical_name, max_retries=3, delay=1.0):","     \"\"\"","     Convert chemical name to SMILES representation using PubChem."," ","     Args:","         chemical_name: Name of the chemical","+        max_retries: Maximum number of retry attempts","+        delay: Delay between retries in seconds"," ","     Returns:","         SMILES string or None if not found","     \"\"\"","-    try:","-        # Search PubChem for the compound","-        compounds = pcp.get_compounds(chemical_name, 'name')","-        if compounds:","-            # Return the canonical SMILES of the first match","-            return compounds[0].canonical_smiles","-    except Exception as e:","-        print(f\"Error fetching SMILES for {chemical_name}: {e}\")","+    for attempt in range(max_retries):","+        try:","+            # Search PubChem for the compound","+            compounds = pcp.get_compounds(chemical_name, 'name')","+            if compounds:","+                # Return the isomeric SMILES (include