# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert tcp any any -> any any (msg:"Custom Data Exfiltration via Telemetry"; flow:to_server,established; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; depth:21; content:"x-tlm-mode|3a 20|exfil"; http_header; nocase; content:"blob="; http_client_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; http_client_body; distance:0; pcre:"/sig=[a-f0-9]{64}(?:&|$)/"; sid:1000001; rev:1;)
