for i, mol in enumerate(results, 1):\n   147→        print(f\"  {i}. {mol}\")\n   148→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"dda74cd0-0d5e-4b99-9f35-38ad9b30ffe9","timestamp":"2026-01-29T06:32:42.859Z","toolUseResult":{"type":"text","file":{"filePath":"/root/workspace/solution.py","content":"\"\"\"\nSolution for finding top-k similar chemicals using Morgan fingerprints and Tanimoto similarity.\n\"\"\"\n\nimport subprocess\nimport sys\n\n\ndef extract_molecules_from_pdf(pdf_path: str) -> list[str]:\n    \"\"\"\n    Extract molecule names from a PDF file using pdftotext.\n\n    Args:\n        pdf_path: Path to the PDF file containing molecule names\n\n    Returns:\n        List of molecule names extracted from the PDF\n    \"\"\"\n    result = subprocess.run(\n        [\"pdftotext\", pdf_path, \"-\"],\n        capture_output=True,\n        text=True,\n        check=True\n    )\n\n    molecules = []\n    for line in result.stdout.strip().split(\"\\n\"):\n        line = line.strip()\n        if line:\n            molecules.append(line)\n\n    return molecules\n\n\ndef get_smiles_from_pubchem(molecule_name: str) -> str | None:\n    \"\"\"\n    Get SMILES representation of a molecule from PubChem.\n\n    Args:\n        molecule_name: Common name of the molecule\n\n    Returns:\n        SMILES string if found, None otherwise\n    \"\"\"\n    import pubchempy as pcp\n\n    try:\n        compounds = pcp.get_compounds(molecule_name, \"name\")\n        if compounds:\n            return compounds[0].canonical_smiles\n    except Exception:\n        pass\n\n    return None\n\n\ndef compute_tanimoto_similarity(smiles1: str, smiles2: str, radius: int = 2, use_chirality: bool = True) -> float:\n    \"\"\"\n    Compute Tanimoto similarity between two molecules using Morgan fingerprints.\n\n    Args:\n        smiles1: SMILES string of first molecule\n        smiles2: SMILES string of second molecule\n        radius: Radius for Morgan fingerprint (default: 2)\n        use_chirality: Whether to include chirality in fingerprint (default: True)\n\n    Returns:\n        Tanimoto similarity score between 0 and 1\n    \"\"\"\n    from rdkit import Chem\n    from rdkit.Chem import AllChem\n    from rdkit import DataStructs\n\n    mol1 = Chem.MolFromSmiles(smiles1)\n    mol2 = Chem.MolFromSmiles(smiles2)\n\n    if mol1 is None or mol2 is None:\n        return 0.0\n\n    fp1 = AllChem.GetMorganFingerprintAsBitVect(mol1, radius, useChirality=use_chirality)\n    fp2 = AllChem.GetMorganFingerprintAsBitVect(mol2, radius, useChirality=use_chirality)\n\n    return DataStructs.TanimotoSimilarity(fp1, fp2)\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str,\n    molecule_pool_filepath: str,\n    top_k: int\n) -> list:\n    \"\"\"\n    Find the top-k most similar molecules to the target molecule from a PDF file.\n\n    Uses Morgan fingerprints (radius=2, with chirality) and Tanimoto similarity.\n    Results are sorted in descending order of similarity, with alphabetical\n    ordering when ties happen.\n\n    Args:\n        target_molecule_name: Name of the target molecule to compare against\n        molecule_pool_filepath: Path to PDF file containing pool of molecule names\n        top_k: Number of top similar molecules to return\n\n    Returns:\n        List of top-k most similar molecule names, sorted by descending similarity\n        (alphabetically for ties)\n    \"\"\"\n    # Get SMILES for target molecule from PubChem\n    target_smiles = get_smiles_from_pubchem(target_molecule_name)\n    if target_smiles is None:\n        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n\n    # Extract molecule names from PDF\n    pool_molecules = extract_molecules_from_pdf(molecule_pool_filepath)\n\n    # Compute similarities\n    similarities = []\n    for molecule_name in pool_molecules:\n        smiles = get_smiles_from_pubchem(molecule_name)\n        if smiles is not None:\n            similarity = compute_tanimoto_similarity(target_smiles, smiles)\n            similarities.append((molecule_name, similarity))\n\n    # Sort by descending similarity, then alphabetically for ties\n    # Using negative similarity for descending order, molecule name for alphabetical\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n\n    # Return top-k molecule names\n    return [name for name, _ in similarities[:top_k]]\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    import sys\n\n    if len(sys.argv) < 4:\n        print(\"Usage: python solution.py <target_molecule> <pdf_path> <top_k>\")\n        print(\"Example: python solution.py Aspirin molecules.pdf 5\")\n        sys.exit(1)\n\n    target = sys.argv[1]\n    pdf_path = sys.argv[2]\n    k = int(sys.argv[3])\n\n    results = topk_tanimoto_similarity_molecules(target, pdf_path, k)\n    print(f\"Top {k} similar molecules to {target}:\")\n    for i, mol in enumerate(results, 1):\n        print(f\"  {i}. {mol}\")\n","numLines":148,"startLine":1,"totalLines":148}},"sourceToolAssistantUUID":"35b75654-3642-4008-9571-4b7f2a36817c"}
