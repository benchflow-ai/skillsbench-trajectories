From: Security Patch <security@apache.org>
Subject: [PATCH] Fix JavaScript parse spec security bypass vulnerability

This patch fixes the same vulnerability in JavaScriptParseSpec.

---
 .../druid/data/input/impl/JavaScriptParseSpec.java |   10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
index 1234567..abcdefg 100644
--- a/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
+++ b/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java
@@ -21,6 +21,7 @@ package org.apache.druid.data.input.impl;

 import com.fasterxml.jackson.annotation.JacksonInject;
 import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Preconditions;
 import org.apache.druid.js.JavaScriptConfig;
@@ -28,6 +29,7 @@ import org.apache.druid.js.JavaScriptConfig;
 import java.util.List;
 import java.util.Objects;

+@JsonIgnoreProperties(ignoreUnknown = true)
 public class JavaScriptParseSpec extends ParseSpec
 {
   private final String function;
@@ -38,10 +40,14 @@ public class JavaScriptParseSpec extends ParseSpec
       @JsonProperty("timestampSpec") TimestampSpec timestampSpec,
       @JsonProperty("dimensionsSpec") DimensionsSpec dimensionsSpec,
       @JsonProperty("function") String function,
-      @JacksonInject JavaScriptConfig config
+      @JacksonInject(useInput = com.fasterxml.jackson.annotation.OptBoolean.FALSE) JavaScriptConfig config
   )
   {
     super(timestampSpec, dimensionsSpec);
+    Preconditions.checkNotNull(config, "JavaScriptConfig must not be null");
+    Preconditions.checkState(
+        config.isEnabled(),
+        "JavaScript is disabled. Set druid.javascript.enabled=true to enable JavaScript."
+    );
     this.function = function;
     this.config = config;
   }
