From: Security Patch <security@apache.org>
Subject: [PATCH] Fix JavaScript worker select strategy security bypass vulnerability

This patch fixes the same vulnerability in JavaScriptWorkerSelectStrategy.

---
 .../overlord/setup/JavaScriptWorkerSelectStrategy.java |   7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java b/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java
index 1234567..abcdefg 100644
--- a/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java
+++ b/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java
@@ -21,6 +21,7 @@ package org.apache.druid.indexing.overlord.setup;

 import com.fasterxml.jackson.annotation.JacksonInject;
 import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Optional;
 import com.google.common.base.Preconditions;
@@ -39,6 +40,7 @@ import java.util.Map;
 /**
  * This class is deprecated and will be removed in a future release.
  */
+@JsonIgnoreProperties(ignoreUnknown = true)
 public class JavaScriptWorkerSelectStrategy implements WorkerSelectStrategy
 {
   public interface SelectorFunction
@@ -55,7 +57,10 @@ public class JavaScriptWorkerSelectStrategy implements WorkerSelectStrategy
   @JsonCreator
   public JavaScriptWorkerSelectStrategy(
       @JsonProperty("function") String fn,
-      @JacksonInject JavaScriptConfig config
+      @JacksonInject(useInput = com.fasterxml.jackson.annotation.OptBoolean.FALSE) JavaScriptConfig config
   )
   {
     Preconditions.checkNotNull(fn, "function must not be null");
+    Preconditions.checkNotNull(config, "JavaScriptConfig must not be null");
     Preconditions.checkState(config.isEnabled(), "JavaScript is disabled");
