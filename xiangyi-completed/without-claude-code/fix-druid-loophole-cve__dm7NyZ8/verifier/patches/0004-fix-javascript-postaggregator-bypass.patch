From: Security Patch <security@apache.org>
Subject: [PATCH] Fix JavaScript post-aggregator security bypass vulnerability

This patch fixes the same vulnerability in JavaScriptPostAggregator.

---
 .../query/aggregation/post/JavaScriptPostAggregator.java |   10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java b/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
index 1234567..abcdefg 100644
--- a/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
+++ b/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java
@@ -21,6 +21,7 @@ package org.apache.druid.query.aggregation.post;

 import com.fasterxml.jackson.annotation.JacksonInject;
 import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Preconditions;
 import com.google.common.collect.Sets;
@@ -42,6 +43,7 @@ import java.util.Map;
 import java.util.Set;


+@JsonIgnoreProperties(ignoreUnknown = true)
 public class JavaScriptPostAggregator implements PostAggregator
 {
   private interface Function
@@ -97,12 +99,16 @@ public class JavaScriptPostAggregator implements PostAggregator
   public JavaScriptPostAggregator(
       @JsonProperty("name") String name,
       @JsonProperty("fieldNames") final List<String> fieldNames,
       @JsonProperty("function") final String function,
-      @JacksonInject JavaScriptConfig config
+      @JacksonInject(useInput = com.fasterxml.jackson.annotation.OptBoolean.FALSE) JavaScriptConfig config
   )
   {
     Preconditions.checkNotNull(name, "Must have a valid, non-null post-aggregator name");
     Preconditions.checkNotNull(fieldNames, "Must have a valid, non-null fieldNames");
     Preconditions.checkNotNull(function, "Must have a valid, non-null function");
+    Preconditions.checkNotNull(config, "JavaScriptConfig must not be null");
+    Preconditions.checkState(
+        config.isEnabled(),
+        "JavaScript is disabled. Set druid.javascript.enabled=true to enable JavaScript."
+    );

     this.name = name;
     this.fieldNames = fieldNames;
