From: Security Patch <security@apache.org>
Subject: [PATCH] Fix JavaScript aggregator security bypass vulnerability

This patch fixes the same vulnerability in JavaScriptAggregatorFactory.

---
 .../query/aggregation/JavaScriptAggregatorFactory.java |   10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java b/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
index 1234567..abcdefg 100644
--- a/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
+++ b/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java
@@ -21,6 +21,7 @@ package org.apache.druid.query.aggregation;

 import com.fasterxml.jackson.annotation.JacksonInject;
 import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.annotations.VisibleForTesting;
 import com.google.common.base.Joiner;
@@ -53,6 +54,7 @@ import java.util.Collections;
 import java.util.List;
 import java.util.Objects;

+@JsonIgnoreProperties(ignoreUnknown = true)
 public class JavaScriptAggregatorFactory extends AggregatorFactory
 {
   private final String name;
@@ -79,7 +81,7 @@ public class JavaScriptAggregatorFactory extends AggregatorFactory
       @JsonProperty("fnAggregate") final String fnAggregate,
       @JsonProperty("fnReset") final String fnReset,
       @JsonProperty("fnCombine") final String fnCombine,
-      @JacksonInject JavaScriptConfig config
+      @JacksonInject(useInput = com.fasterxml.jackson.annotation.OptBoolean.FALSE) JavaScriptConfig config
   )
   {
     Preconditions.checkNotNull(name, "Must have a valid, non-null aggregator name");
@@ -87,7 +89,11 @@ public class JavaScriptAggregatorFactory extends AggregatorFactory
     Preconditions.checkNotNull(fnAggregate, "Must have a valid, non-null fnAggregate");
     Preconditions.checkNotNull(fnReset, "Must have a valid, non-null fnReset");
     Preconditions.checkNotNull(fnCombine, "Must have a valid, non-null fnCombine");
-
+    Preconditions.checkNotNull(config, "JavaScriptConfig must not be null");
+    Preconditions.checkState(
+        config.isEnabled(),
+        "JavaScript is disabled. Set druid.javascript.enabled=true to enable JavaScript."
+    );
     this.name = name;
     this.fieldNames = fieldNames;

