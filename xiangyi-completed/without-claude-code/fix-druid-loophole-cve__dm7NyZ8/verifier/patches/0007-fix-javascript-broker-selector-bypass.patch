From: Security Patch <security@apache.org>
Subject: [PATCH] Fix JavaScript tiered broker selector security bypass vulnerability

This patch fixes the same vulnerability in JavaScriptTieredBrokerSelectorStrategy.

---
 .../server/router/JavaScriptTieredBrokerSelectorStrategy.java |   7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java b/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java
index 1234567..abcdefg 100644
--- a/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java
+++ b/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java
@@ -21,6 +21,7 @@ package org.apache.druid.server.router;

 import com.fasterxml.jackson.annotation.JacksonInject;
 import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
 import com.fasterxml.jackson.annotation.JsonProperty;
 import com.google.common.base.Optional;
 import com.google.common.base.Preconditions;
@@ -33,6 +34,7 @@ import javax.script.ScriptEngine;
 import javax.script.ScriptEngineManager;
 import javax.script.ScriptException;

+@JsonIgnoreProperties(ignoreUnknown = true)
 public class JavaScriptTieredBrokerSelectorStrategy implements TieredBrokerSelectorStrategy
 {
   public interface SelectorFunction
@@ -49,10 +51,13 @@ public class JavaScriptTieredBrokerSelectorStrategy implements TieredBrokerSelec
   @JsonCreator
   public JavaScriptTieredBrokerSelectorStrategy(
       @JsonProperty("function") String fn,
-      @JacksonInject JavaScriptConfig config
+      @JacksonInject(useInput = com.fasterxml.jackson.annotation.OptBoolean.FALSE) JavaScriptConfig config
   )
   {
     Preconditions.checkNotNull(fn, "function must not be null");
+    Preconditions.checkNotNull(config, "JavaScriptConfig must not be null");
     Preconditions.checkState(config.isEnabled(), "JavaScript is disabled");

     this.function = fn;
