# Suricata rule to detect data exfiltration via HTTP telemetry
# Detects POST /telemetry/v2/report with X-TLM-Mode: exfil header and base64 blob + 64-char hex sig
alert http any any -> any any (
    msg:"Custom HTTP Data Exfiltration Detection";
    flow:to_server,established;
    content:"POST";
    http_method;
    content:"/telemetry/v2/report";
    http_uri;
    content:"X-TLM-Mode|3a|exfil";
    http_header;
    nocase;
    content:"blob=";
    http_client_body;
    pcre:"/blob=([A-Za-z0-9+\/=]{80,})/";
    content:"sig=";
    http_client_body;
    pcre:"/sig=[0-9a-fA-F]{64}(?:[&\r\n]|$)/";
    sid:1000001;
    rev:1;
    classtype:policy-violation;
)
