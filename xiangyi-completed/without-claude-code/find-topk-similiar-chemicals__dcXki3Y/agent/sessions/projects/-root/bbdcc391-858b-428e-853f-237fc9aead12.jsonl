s: int = 2, use_chirality: bool = True):\n    \"\"\"\n    Compute Morgan fingerprint for a given SMILES string.\n\n    Args:\n        smiles: SMILES representation of the molecule.\n        radius: Radius for Morgan fingerprint (default: 2).\n        use_chirality: Whether to include chirality information (default: True).\n\n    Returns:\n        Morgan fingerprint object, or None if computation fails.\n    \"\"\"\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return None\n    return AllChem.GetMorganFingerprintAsBitVect(mol, radius, useChirality=use_chirality)\n\n\ndef compute_tanimoto_similarity(fp1, fp2) -> float:\n    \"\"\"\n    Compute Tanimoto similarity between two fingerprints.\n\n    Args:\n        fp1: First fingerprint.\n        fp2: Second fingerprint.\n\n    Returns:\n        Tanimoto similarity score between 0 and 1.\n    \"\"\"\n    return DataStructs.TanimotoSimilarity(fp1, fp2)\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str,\n    molecule_pool_filepath: str,\n    top_k: int\n) -> list:\n    \"\"\"\n    Find the top-k most similar molecules to a target molecule from a pool of molecules.\n\n    Uses Morgan fingerprints (radius=2, with chirality) and Tanimoto similarity.\n    Results are sorted in descending order of similarity, with alphabetical ordering\n    for ties.\n\n    Args:\n        target_molecule_name: Name of the target molecule to compare against.\n        molecule_pool_filepath: Path to PDF file containing pool of molecule names.\n        top_k: Number of top similar molecules to return.\n\n    Returns:\n        List of tuples (molecule_name, similarity_score) for top-k most similar molecules.\n    \"\"\"\n    target_smiles = get_smiles_from_name(target_molecule_name)\n    if target_smiles is None:\n        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n\n    target_fp = compute_morgan_fingerprint(target_smiles)\n    if target_fp is None:\n        raise ValueError(f\"Could not compute fingerprint for target molecule: {target_molecule_name}\")\n\n    pool_molecules = extract_molecules_from_pdf(molecule_pool_filepath)\n\n    similarities = []\n    for mol_name in pool_molecules:\n        smiles = get_smiles_from_name(mol_name)\n        if smiles is None:\n            continue\n\n        fp = compute_morgan_fingerprint(smiles)\n        if fp is None:\n            continue\n\n        similarity = compute_tanimoto_similarity(target_fp, fp)\n        similarities.append((mol_name, similarity))\n\n    # Sort by similarity descending, then by name alphabetically for ties\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n\n    return similarities[:top_k]\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    result = topk_tanimoto_similarity_molecules(\n        \"Aspirin\",\n        \"/root/molecules.pdf\",\n        5\n    )\n    print(\"Top 5 similar molecules to Aspirin:\")\n    for mol_name, similarity in result:\n        print(f\"  {mol_name}: {similarity:.4f}\")\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"5c81f042-a88d-4a46-ad70-3b010162efb4"}
