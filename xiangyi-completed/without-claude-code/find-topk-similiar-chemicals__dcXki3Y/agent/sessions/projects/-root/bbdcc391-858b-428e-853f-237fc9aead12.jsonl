h: Path to PDF file containing pool of molecule names.\n    99→        top_k: Number of top similar molecules to return.\n   100→\n   101→    Returns:\n   102→        List of tuples (molecule_name, similarity_score) for top-k most similar molecules.\n   103→    \"\"\"\n   104→    target_smiles = get_smiles_from_name(target_molecule_name)\n   105→    if target_smiles is None:\n   106→        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n   107→\n   108→    target_fp = compute_morgan_fingerprint(target_smiles)\n   109→    if target_fp is None:\n   110→        raise ValueError(f\"Could not compute fingerprint for target molecule: {target_molecule_name}\")\n   111→\n   112→    pool_molecules = extract_molecules_from_pdf(molecule_pool_filepath)\n   113→\n   114→    similarities = []\n   115→    for mol_name in pool_molecules:\n   116→        smiles = get_smiles_from_name(mol_name)\n   117→        if smiles is None:\n   118→            continue\n   119→\n   120→        fp = compute_morgan_fingerprint(smiles)\n   121→        if fp is None:\n   122→            continue\n   123→\n   124→        similarity = compute_tanimoto_similarity(target_fp, fp)\n   125→        similarities.append((mol_name, similarity))\n   126→\n   127→    # Sort by similarity descending, then by name alphabetically for ties\n   128→    similarities.sort(key=lambda x: (-x[1], x[0]))\n   129→\n   130→    return similarities[:top_k]\n   131→\n   132→\n   133→if __name__ == \"__main__\":\n   134→    # Example usage\n   135→    result = topk_tanimoto_similarity_molecules(\n   136→        \"Aspirin\",\n   137→        \"/root/molecules.pdf\",\n   138→        5\n   139→    )\n   140→    print(\"Top 5 similar molecules to Aspirin:\")\n   141→    for mol_name, similarity in result:\n   142→        print(f\"  {mol_name}: {similarity:.4f}\")\n   143→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"ea1dadd4-e48c-4cdb-a4bc-6726cb1f8c4b","timestamp":"2026-01-29T04:29:08.824Z","toolUseResult":{"type":"text","file":{"filePath":"/root/workspace/solution.py","content":"\"\"\"\nSolution for finding top-k similar chemicals using Morgan fingerprints and Tanimoto similarity.\n\"\"\"\n\nimport subprocess\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem.rdFingerprintGenerator import GetMorganGenerator\nfrom rdkit import DataStructs\n\n\ndef extract_molecules_from_pdf(pdf_filepath: str) -> list[str]:\n    \"\"\"\n    Extract molecule names from a PDF file.\n\n    Args:\n        pdf_filepath: Path to the PDF file containing molecule names.\n\n    Returns:\n        List of molecule names extracted from the PDF.\n    \"\"\"\n    txt_filepath = pdf_filepath.replace('.pdf', '.txt')\n    subprocess.run(['pdftotext', pdf_filepath, txt_filepath], check=True)\n\n    with open(txt_filepath, 'r') as f:\n        content = f.read()\n\n    molecules = [line.strip() for line in content.split('\\n') if line.strip()]\n    return molecules\n\n\ndef get_smiles_from_name(chemical_name: str) -> str | None:\n    \"\"\"\n    Convert a chemical name to its SMILES representation using PubChem.\n\n    Args:\n        chemical_name: The name of the chemical compound.\n\n    Returns:\n        The canonical SMILES string, or None if not found.\n    \"\"\"\n    try:\n        compounds = pcp.get_compounds(chemical_name, 'name')\n        if compounds:\n            return compounds[0].smiles\n    except Exception:\n        pass\n    return None\n\n\ndef compute_morgan_fingerprint(smiles: str, radius: int = 2, use_chirality: bool = True):\n    \"\"\"\n    Compute Morgan fingerprint for a given SMILES string.\n\n    Args:\n        smiles: SMILES representation of the molecule.\n        radius: Radius for Morgan fingerprint (default: 2).\n        use_chirality: Whether to include chirality information (default: True).\n\n    Returns:\n        Morgan fingerprint object, or None if computation fails.\n    \"\"\"\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return None\n    generator = GetMorganGenerator(radius=radius, includeChirality=use_chirality)\n    return generator.GetFingerprint(mol)\n\n\ndef compute_tanimoto_similarity(fp1, fp2) -> float:\n    \"\"\"\n    Compute Tanimoto similarity between two fingerprints.\n\n    Args:\n        fp1: First fingerprint.\n        fp2: Second fingerprint.\n\n    Returns:\n        Tanimoto similarity score between 0 and 1.\n    \"\"\"\n    return DataStructs.TanimotoSimilarity(fp1, fp2)\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str,\n    molecule_pool_filepath: str,\n    top_k: int\n) -> list:\n    \"\"\"\n    Find the top-k most similar molecules to a target molecule from a pool of molecules.\n\n    Uses Morgan fingerprints (radius=2, with chirality) and Tanimoto similarity.\n    Results are sorted in descending order of similarity, with alphabetical ordering\n    for ties.\n\n    Args:\n        target_molecule_name: Name of the target molecule to compare against.\n        molecule_pool_filepath: Path to PDF file containing pool of molecule names.\n        top_k: Number of top similar molecules to return.\n\n    Returns:\n        List of tuples (molecule_name, similarity_score) for top-k most similar molecules.\n    \"\"\"\n    target_smiles = get_smiles_from_name(target_molecule_name)\n    if target_smiles is None:\n        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n\n    target_fp = compute_morgan_fingerprint(target_smiles)\n    if target_fp is None:\n        raise ValueError(f\"Could not compute fingerprint for target molecule: {target_molecule_name}\")\n\n    pool_molecules = extract_molecules_from_pdf(molecule_pool_filepath)\n\n    similarities = []\n    for mol_name in pool_molecules:\n        smiles = get_smiles_from_name(mol_name)\n        if smiles is None:\n            continue\n\n        fp = compute_morgan_fingerprint(smiles)\n        if fp is None:\n            continue\n\n        similarity = compute_tanimoto_similarity(target_fp, fp)\n        similarities.append((mol_name, similarity))\n\n    # Sort by similarity descending, then by name alphabetically for ties\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n\n    return similarities[:top_k]\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    result = topk_tanimoto_similarity_molecules(\n        \"Aspirin\",\n        \"/root/molecules.pdf\",\n        5\n    )\n    print(\"Top 5 similar molecules to Aspirin:\")\n    for mol_name, similarity in result:\n        print(f\"  {mol_name}: {similarity:.4f}\")\n","numLines":143,"startLine":1,"totalLines":143}},"sourceToolAssistantUUID":"3c4440ad-e0bd-4951-a374-7ee102607198"}
