# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"Custom telemetry exfil pattern"; flow:to_server,established; http.method; content:"POST"; nocase; http.uri; content:"/telemetry/v2/report"; nocase; fast_pattern; pcre:"/^\\/telemetry\\/v2\\/report$/"; http.header; pcre:"/X-TLM-Mode[ \\t]*:[ \\t]*exfil/i"; http.request_body; pcre:"/blob=[A-Za-z0-9+\\/=]{80,}/"; pcre:"/sig=[A-Fa-f0-9]{64}(?:&|$)/"; sid:1000001; rev:4;)
