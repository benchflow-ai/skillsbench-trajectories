# Custom exfil detection
alert http any any -> any any (msg:"TLM exfil telemetry report"; flow:to_server,established; http.method; content:"POST"; depth:4; http.uri; pcre:"/^\\/telemetry\\/v2\\/report$/"; http.header; pcre:"/(?:^|\\r\\n)X-TLM-Mode\\s*:\\s*exfil(?:\\r\\n|$)/i"; http.request_body; pcre:"/blob=[A-Za-z0-9+\\/]{80,}/"; pcre:"/sig=[0-9a-fA-F]{64}(?:&|$)/"; sid:1000001; rev:2;)
