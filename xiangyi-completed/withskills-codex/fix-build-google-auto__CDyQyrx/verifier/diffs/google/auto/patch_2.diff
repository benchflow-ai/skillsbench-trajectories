diff --git a/common/src/main/java/com/google/auto/common/Visibility.java b/common/src/main/java/com/google/auto/common/Visibility.java
--- a/common/src/main/java/com/google/auto/common/Visibility.java
+++ b/common/src/main/java/com/google/auto/common/Visibility.java
@@ -49,7 +49,8 @@
   public static  Visibility ofElement(Element element) {
     checkNotNull(element);
     // packages don't have modifiers, but they're obviously "public"
-    if (element.getKind().equals(PACKAGE)) {
+    if (element.getKind().equals(PACKAGE)
+        || element.getKind().name().equals("MODULE")) {
       return PUBLIC;
     }
     Set<Modifier> modifiers = element.getModifiers();
     if (modifiers.contains(Modifier.PRIVATE)) {
       return PRIVATE;
     } else if (modifiers.contains(Modifier.PROTECTED)) {
       return PROTECTED;
     } else if (modifiers.contains(Modifier.PUBLIC)) {
       return PUBLIC;
     } else {
       return DEFAULT;
     }
   }

