+package org.apache.druid.jackson;
+
+import com.fasterxml.jackson.core.JsonFactory;
+import com.fasterxml.jackson.core.JsonParseException;
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import com.fasterxml.jackson.core.SerializableString;
+import com.fasterxml.jackson.core.util.JsonParserDelegate;
+
+import java.io.DataInput;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.Reader;
+import java.net.URL;
+
+/**
+ * JsonFactory that rejects empty field names (""), which can be used to smuggle values into
+ * @JacksonInject parameters during deserialization.
+ */
+public class NonEmptyFieldNameJsonFactory extends JsonFactory
+{
+  public NonEmptyFieldNameJsonFactory()
+  {
+    super();
+  }
+
+  public NonEmptyFieldNameJsonFactory(final JsonFactory src)
+  {
+    super(src, src.getCodec());
+  }
+
+  @Override
+  public JsonFactory copy()
+  {
+    return new NonEmptyFieldNameJsonFactory(this);
+  }
+
+  @Override
+  public JsonParser createParser(final File f) throws IOException
+  {
+    return wrap(super.createParser(f));
+  }
+
+  @Override
+  public JsonParser createParser(final URL url) throws IOException
+  {
+    return wrap(super.createParser(url));
+  }
+
+  @Override
+  public JsonParser createParser(final InputStream in) throws IOException
+  {
+    return wrap(super.createParser(in));
+  }
+
+  @Override
+  public JsonParser createParser(final Reader r) throws IOException
+  {
+    return wrap(super.createParser(r));
+  }
+
+  @Override
+  public JsonParser createParser(final byte[] data) throws IOException
+  {
+    return wrap(super.createParser(data));
+  }
+
+  @Override
+  public JsonParser createParser(final byte[] data, final int offset, final int len) throws IOException
+  {
+    return wrap(super.createParser(data, offset, len));
+  }
+
+  @Override
+  public JsonParser createParser(final String content) throws IOException
+  {
+    return wrap(super.createParser(content));
+  }
+
+  @Override
+  public JsonParser createParser(final char[] content) throws IOException
+  {
+    return wrap(super.createParser(content));
+  }
+
+  @Override
+  public JsonParser createParser(final char[] content, final int offset, final int len) throws IOException
+  {
+    return wrap(super.createParser(content, offset, len));
+  }
+
+  @Override
+  public JsonParser createParser(final DataInput in) throws IOException
+  {
+    return wrap(super.createParser(in));
+  }
+
+  private static JsonParser wrap(final JsonParser parser)
+  {
+    return new NonEmptyFieldNameJsonParser(parser);
+  }
+
+  private static class NonEmptyFieldNameJsonParser extends JsonParserDelegate
+  {
+    NonEmptyFieldNameJsonParser(final JsonParser delegate)
+    {
+      super(delegate);
+    }
+
+    @Override
+    public String nextFieldName() throws IOException
+    {
+      final String name = super.nextFieldName();
+      verifyFieldName(name);
+      return name;
+    }
+
+    @Override
+    public boolean nextFieldName(final SerializableString str) throws IOException
+    {
+      final boolean matched = super.nextFieldName(str);
+      if (matched) {
+        verifyFieldName(getCurrentName());
+      }
+      return matched;
+    }
+
+    @Override
+    public JsonToken nextToken() throws IOException
+    {
+      final JsonToken token = super.nextToken();
+      if (token == JsonToken.FIELD_NAME) {
+        verifyFieldName(getCurrentName());
+      }
+      return token;
+    }
+
+    private void verifyFieldName(final String name) throws IOException
+    {
+      if (name != null && name.isEmpty()) {
+        throw new JsonParseException(this, "Empty JSON field name is not allowed");
+      }
+    }
+  }
+}
