# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert http any any -> any any (msg:"Custom telemetry exfil pattern"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; urilen:20; http.header; pcre:"/\bX-TLM-Mode\s*:\s*exfil\b/i"; http.request_body; content:"blob="; pcre:"/[A-Za-z0-9+\\/=]{80,}(?:&|$)/R"; content:"sig="; pcre:"/[A-Fa-f0-9]{64}(?:&|$)/R"; sid:1000001; rev:4;)
