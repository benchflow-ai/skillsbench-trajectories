# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert http any any -> any any (msg:"Custom telemetry exfil"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; urilen:20; http.header; content:"X-TLM-Mode|3a| exfil"; nocase; http.request_body; pcre:"/\\bblob=[A-Za-z0-9+\\/=]{80,}(?:&|$)/"; pcre:"/\\bsig=[0-9a-fA-F]{64}(?:&|$)/"; sid:1000001; rev:1;)
