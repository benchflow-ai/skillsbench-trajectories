# Custom exfil telemetry detection
alert http any any -> any any (msg:"TLM exfil telemetry report"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; startswith; endswith; http.header; pcre:"/(^|\r\n)X-TLM-Mode\s*:\s*exfil(\r\n|$)/i"; http.request_body; pcre:"/(?:^|&)blob=[A-Za-z0-9+\/]{80,}={0,2}(?:&|$)/"; http.request_body; pcre:"/(?:^|&)sig=[A-Fa-f0-9]{64}(?:&|$)/"; sid:1000001; rev:1;)
