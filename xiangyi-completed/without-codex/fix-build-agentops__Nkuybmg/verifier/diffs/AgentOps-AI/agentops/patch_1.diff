+[metadata]
+name = agentops
+version = 0.1.8
+description = Python SDK for developing AI agent evals and observability
+long_description = file: README.md
+long_description_content_type = text/markdown
+license = MIT
+author = Alex Reibman, Shawn Qiu, Braelyn Boynton, Howard Gil
+author_email = areibman@gmail.com, siyangqiu@gmail.com, bboynton97@gmail.com, howardbgil@gmail.com
+url = https://github.com/AgentOps-AI/agentops
+project_urls =
+    Homepage = https://github.com/AgentOps-AI/agentops
+    Issues = https://github.com/AgentOps-AI/agentops/issues
+classifiers =
+    Programming Language :: Python :: 3
+    License :: OSI Approved :: MIT License
+    Operating System :: OS Independent
+
+[options]
+packages = find:
+python_requires = >=3.7
+install_requires =
+    requests==2.31.0
+    psutil==5.9.8
+    packaging==23.2
+
+[options.extras_require]
+dev =
+    pytest==7.4.0
+    requests_mock==1.11.0
+langchain =
+    langchain>=0.0.354
+
+
+[options.packages.find]
+where = .
