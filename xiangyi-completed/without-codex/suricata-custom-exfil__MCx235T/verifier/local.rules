# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert http any any -> any any (msg:"Custom exfil telemetry report"; flow:to_server,established; http.method; content:"POST"; http.uri; pcre:"/^\\/telemetry\\/v2\\/report$/"; http.header; content:"X-TLM-Mode|3a| exfil"; nocase; http.request_body; pcre:"/blob=[A-Za-z0-9+\\/=]{80,}/"; http.request_body; pcre:"/sig=[A-Fa-f0-9]{64}(?:&|$)/"; sid:1000001; rev:1;)
