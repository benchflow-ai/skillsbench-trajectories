[167.795416, "i", "python3 << 'EOF'\nfrom pypdf import PdfReader\n\nreader = PdfReader('latex_paper.pdf')\nall_text = []\n\nfor page_num, page in enumerate(reader.pages):\n    text = page.extract_text()\n    if text:\n        all_text.append(text)\n\nfull_text = '\\n'.join(all_text)\nlines = full_text.split('\\n')\n\n# Show wider context for equation (1)\nprint(\"=== EQUATION (1) - wider context ===\")\nfor i in range(max(0, 145), min(len(lines), 160)):\n    print(f\"Line {i}: {lines[i]}\")\n\nprint(\"\\n=== EQUATION (3) - wider context ===\")\nfor i in range(max(0, 215), min(len(lines), 235)):\n    print(f\"Line {i}: {lines[i]}\")\n\nprint(\"\\n=== EQUATION (4) - wider context ===\")\nfor i in range(max(0, 240), min(len(lines), 260)):\n    print(f\"Line {i}: {lines[i]}\")\n\nEOF\n"]
