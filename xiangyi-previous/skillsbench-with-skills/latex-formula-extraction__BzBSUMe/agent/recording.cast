[52.069263, "i", "python3 << 'EOF'\nimport pdfplumber\nimport re\n\nformulas = []\n\nwith pdfplumber.open('latex_paper.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        text = page.extract_text()\n        if text:\n            lines = text.split('\\n')\n            for line in lines:\n                # Look for lines that appear to contain LaTeX formulas\n                # Formulas on their own line typically have $$ or are equation-like\n                if '$$' in line or re.search(r'^\\s*\\\\[a-zA-Z]', line):\n                    print(f\"Page {page_num + 1}: {line}\")\n                    formulas.append(line)\n\nEOF\n"]
[52.06964, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
