[81.380061, "i", "python3 << 'EOF'\nimport pdfplumber\n\nwith pdfplumber.open('latex_paper.pdf') as pdf:\n    with open('/tmp/pdf_text.txt', 'w') as f:\n        for page_num, page in enumerate(pdf.pages):\n            text = page.extract_text()\n            if text:\n                f.write(f\"\\n\\n=== PAGE {page_num + 1} ===\\n\\n\")\n                f.write(text)\n\nprint(\"Text extracted to /tmp/pdf_text.txt\")\n\nEOF\n"]
