[108.255729, "i", "python3 << 'EOF'\nimport re\n\nwith open('/tmp/pdf_text.txt', 'r') as f:\n    content = f.read()\n\nlines = content.split('\\n')\n\n# Extract the three main equations we found\nformulas = []\n\n# Line 78: equation (1)\nline78 = lines[78]\nprint(f\"Line 78: {line78}\")\n# Extract formula before and after the equation\nif 'd2x' in line78:\n    # Find the formula part\n    match = re.search(r'd2x\\s+i\\s*=.*?\\(\\s*1\\s*\\)', line78)\n    if match:\n        formula = match.group(0)\n        print(f\"Found formula 1: {formula}\")\n\nEOF\n"]
