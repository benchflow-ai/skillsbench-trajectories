[116.546152, "i", "python3 << 'EOF'\nimport re\n\nwith open('/tmp/pdf_text.txt', 'r') as f:\n    content = f.read()\n\nlines = content.split('\\n')\n\n# Find all lines with equation numbers\nformulas_raw = []\nfor i, line in enumerate(lines):\n    # Look for equation numbers\n    match = re.search(r'\\((\\d+)\\)\\s*$', line.strip())\n    if match:\n        eq_num = match.group(1)\n        # Extract the formula part (everything before the equation number)\n        formula = re.sub(r'\\s*\\(\\s*' + eq_num + r'\\s*\\)\\s*$', '', line.strip())\n        formulas_raw.append({\n            'number': eq_num,\n            'raw': formula,\n            'line': i\n        })\n        print(f\"Equation ({eq_num}):\")\n        print(f\"  Raw: {formula}\")\n        print()\n\nprint(f\"\\nTotal formulas found: {len(formulas_raw)}\")\n\nEOF\n"]
