[202.850944, "i", "python3 << 'EOF'\nfrom pypdf import PdfReader\nimport re\n\nreader = PdfReader('latex_paper.pdf')\nall_text = []\n\nfor page_num, page in enumerate(reader.pages):\n    text = page.extract_text()\n    if text:\n        all_text.append(text)\n\nfull_text = '\\n'.join(all_text)\nlines = full_text.split('\\n')\n\n# Look for any other potential formulas (lines with heavy math symbols that don't have equation numbers)\nprint(\"=== Searching for additional formulas ===\")\nmath_symbols = r'[∑∏∫α-ωΩ±×÷≈≠≤≥∈∉⊂⊃∪∩ℏ†]'\n\nfor i, line in enumerate(lines):\n    # Skip lines we already found\n    if i in [146, 147, 148, 149, 150, 151, 152, 153, 154, 173, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 241, 242, 243, 244, 245, 246, 247, 248, 249, 250, 251, 252, 253, 254]:\n        continue\n    \n    if re.search(math_symbols, line) and len(line.strip()) > 10:\n        # Check if it's not just a reference or figure caption\n        if not any(word in line.lower() for word in ['figure', 'fig.', 'table', 'ref', 'see', 'shown', 'displayed']):\n            print(f\"Line {i}: {line}\")\n\nEOF\n"]
