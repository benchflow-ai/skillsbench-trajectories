[101.604133, "i", "python3 << 'EOF'\nimport re\n\nwith open('/tmp/pdf_text.txt', 'r') as f:\n    content = f.read()\n\n# Split by lines\nlines = content.split('\\n')\n\n# Look for formulas - lines with mathematical symbols and potentially equation numbers\nformula_lines = []\nfor i, line in enumerate(lines):\n    # Skip page headers and empty lines\n    if '===' in line or len(line.strip()) == 0:\n        continue\n    \n    # Look for lines with equation numbers like (1), (2), etc\n    if re.search(r'\\(\\d+\\)$', line.strip()):\n        formula_lines.append((i, line))\n        print(f\"Line {i}: {line}\")\n    # Look for lines with heavy math symbols\n    elif re.search(r'[∑∏∫α-ωΩ±×÷≈≠≤≥∈∉⊂⊃∪∩]', line):\n        if not any(word in line.lower() for word in ['figure', 'fig.', 'table', 'ref', 'equation', 'eq.']):\n            formula_lines.append((i, line))\n            print(f\"Line {i}: {line}\")\n\nprint(f\"\\nFound {len(formula_lines)} potential formula lines\")\n\nEOF\n"]
