[187.771135, "o", "$$\\frac{d^2x_i}{dt^2} = -\\omega_0^2 x_i + \\frac{kq^2}{m}\\sum_{j=1, j\\neq i}^{N} \\frac{1}{(x_i-x_j)^2}\\cdot\\text{sgn}(x_i-x_j)$$\r\n$$\\rho_c(\\tau) = \\rho_1(\\tau)\\rho_2(\\tau+\\delta T)$$\r\n$$H_{i,M} = \\frac{\\hbar}{2}\\Omega^{(i)}\\sigma_x^{(i)}\\prod_{m=1}^{M}\\exp\\left[i\\eta_{i,m}(a_m + a_m^\\dagger)\\right]$$\r\n$$P_e(t) = \\frac{1}{2N}\\left[1 - \\sum_{n=0}^{\\infty}\\sum_{i=0}^{N}P_n\\cos(\\Omega_n^{(i)}t)\\right]$$\r\n"]
[187.77142, "o", "\u001b[?2004hroot@f0bcd65f51bf:~# "]
[193.26963, "i", "python3 << 'EOF'\nfrom pypdf import PdfReader\nimport re\n\nreader = PdfReader('latex_paper.pdf')\nall_text = []\n\nfor page_num, page in enumerate(reader.pages):\n    text = page.extract_text()\n    if text:\n        all_text.append(text)\n\nfull_text = '\\n'.join(all_text)\nlines = full_text.split('\\n')\n\n# Verify equation (1)\nprint(\"=== VERIFICATION ===\")\nprint(\"\\nEquation (1) from PDF (lines 146-154):\")\nfor i in range(146, 155):\n    print(lines[i])\n\nprint(\"\\nEquation (2) from PDF (line 173):\")\nprint(lines[173])\n\nprint(\"\\nEquation (3) from PDF (lines 218-229):\")\nfor i in range(218, 230):\n    print(lines[i])\n\nprint(\"\\nEquation (4) from PDF (lines 241-254):\")\nfor i in range(241, 255):\n    print(lines[i])\n\nEOF\n"]
