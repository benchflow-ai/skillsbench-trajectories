[65.584499, "o", "    \"max_tension\": float(np.max(tensions_all)),\r\n\u001b[?2004l\r"]
[65.584553, "o", "\u001b[?2004h> "]
[65.584592, "o", "    \"min_tension\": float(np.min(tensions_all))\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.584632, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.584677, "o", "> "]
[65.584716, "o", "with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.584774, "o", "    json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
