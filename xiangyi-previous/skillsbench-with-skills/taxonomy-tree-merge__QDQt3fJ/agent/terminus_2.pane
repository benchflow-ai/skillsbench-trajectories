[?2004l[?2004h>     
[?2004l[?2004h>     return unified
[?2004l[?2004h> 
[?2004l[?2004h> def map_category(entry: Dict, unified: Dict) -> Dict:
[?2004l[?2004h>     """Map category to unified taxonomy."""
[?2004l[?2004h>     result = {
[?2004l[?2004h>         'source': entry['source'],
[?2004l[?2004h>         'category_path': entry['path'],
