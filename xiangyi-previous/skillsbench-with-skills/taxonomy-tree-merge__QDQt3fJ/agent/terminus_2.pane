[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     for level in range(1, 6):
[?2004l[?2004h>         if level <= len(entry['parts']):
[?2004l[?2004h>             part = entry['parts'][level - 1]
[?2004l[?2004h>             norm = normalize_text(part)
[?2004l[?2004h>             
[?2004l[?2004h>             # Try exact match first
[?2004l[?2004h>             if norm in unified[level]:
[?2004l[?2004h>                 result[f'unified_level_{level}'] = unified[level][norm]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 # Try to find best match by word overlap
[?2004l[?2004h>                 best_match = None
[?2004l[?2004h>                 best_score = 0
[?2004l[?2004h>                 norm_words = set(norm.split())
[?2004l[?2004h>                 
[?2004l[?2004h>                 for unified_norm, unified_name in unified[level].items():
[?2004l[?2004h>                     unified_words = set(unified_norm.split())
[?2004l[?2004h>                     overlap = len(norm_words & unified_words)
[?2004l[?2004h>                     if overlap > best_score:
[?2004l[?2004h>                         best_score = overlap
[?2004l[?2004h>                         best_match = unified_name
[?2004l[?2004h>                 
[?2004l[?2004h>                 if best_match:
[?2004l[?2004h>                     result[f'unified_level_{level}'] = best_match
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     # Default to first category
[?2004l[?2004h>                     result[f'unified_level_{level}'] = list(unified[level].values())[0] if unified[level] else None
[?2004l[?2004h>         else:
[?2004l[?2004h>             result[f'unified_level_{level}'] = None
[?2004l[?2004h>     
[?2004l[?2004h>     return result
