[170.271741, "i", "cat > /root/process_taxonomy_v4.py << 'EOFV4'\nimport pandas as pd\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple\n\ndef normalize_text(text: str) -> str:\n    \"\"\"Normalize text for comparison.\"\"\"\n    text = text.strip().lower()\n    text = re.sub(r'[&/]', ' and ', text)\n    text = re.sub(r'[^a-z0-9\\s]', '', text)\n    text = re.sub(r'\\s+', ' ', text)\n    return text\n\ndef load_categories():\n    \"\"\"Load all categories.\"\"\"\n    all_data = []\n    \n    for source, filepath in [('amazon', '/root/data/amazon_product_categories.csv'),\n                             ('facebook', '/root/data/fb_product_categories.csv'),\n                             ('google', '/root/data/google_shopping_product_categories.csv')]:\n        df = pd.read_csv(filepath)\n        for path in df['category_path']:\n            parts = [p.strip() for p in path.split('>')]\n            all_data.append({\n                'source': source,\n                'path': path,\n                'parts': parts,\n                'depth': len(parts)\n            })\n    \n    return all_data\n\ndef build_hierarchy_tree(all_data: List[Dict]):\n    \"\"\"Build a tree structure of categories.\"\"\"\n    tree = {}\n    \n    for entry in all_data:\n        parts = entry['parts']\n        current = tree\n        \n        for i, part in enumerate(parts):\n            norm = normalize_text(part)\n            if norm not in current:\n                current[norm] = {'name': part, 'children': {}, 'count': 0, 'depth': i + 1}\n            current[norm]['count'] += 1\n            current = current[norm]['children']\n    \n    return tree\n\ndef extract_top_categories(tree: Dict, max_count: int) -> List[str]:\n    \"\"\"Extract top categories from tree.\"\"\"\n    items = [(norm, data['count']) for norm, data in tree.items()]\n    items.sort(key=lambda x: x[1], reverse=True)\n    return [norm for norm, _ in items[:max_count]]\n\ndef build_unified_taxonomy(all_data: List[Dict]):\n    \"\"\"Build unified taxonomy using hierarchy analysis.\"\"\"\n    # Build tree structure\n    tree = build_hierarchy_tree(all_data)\n    \n    unified = {}\n    \n    # Level 1: Top 18 categories\n    level1_norms = extract_top_categories(tree, 18)\n    unified[1] = {}\n    for norm in level1_norms:\n        unified[1][norm] = tree[norm]['name']\n    \n    # For each level, build from the tree\n    for level in range(2, 6):\n        level_items = defaultdict(lambda: {'count': 0, 'name': ''})\n        \n        for entry in all_data:\n            if level <= len(entry['parts']):\n                norm = normalize_text(entry['parts'][level - 1])\n                if not level_items[norm]['name']:\n                    level_items[norm]['name'] = entry['parts'][level - 1]\n                level_items[norm]['count'] += 1\n        \n        # Keep top items\n        sorted_items = sorted([(k, v['count']) for k, v in level_items.items()],\n                             key=lambda x: x[1], reverse=True)\n        top_n = min(len(sorted_items), max(50, 10 * (6 - level)))\n        \n        unified[level] = {}\n        for norm, _ in sorted_items[:top_n]:\n            unified[level][norm] = level_items[norm]['name']\n    \n    return unified\n\ndef map_category(entry: Dict, unified: Dict) -> Dict:\n    \"\"\"Map category to unified taxonomy.\"\"\"\n    result = {\n        'source': entry['source'],\n        'category_path': entry['path'],\n        'depth': entry['depth']\n    }\n    \n    for level in range(1, 6):\n        if level <= len(entry['parts']):\n            part = entry['parts'][level - 1]\n            norm = normalize_text(part)\n            \n            # Try exact match first\n            if norm in unified[level]:\n                result[f'unified_level_{level}'] = unified[level][norm]\n            else:\n                # Try to find best match by word overlap\n                best_match = None\n                best_score = 0\n                norm_words = set(norm.split())\n                \n                for unified_norm, unified_name in unified[level].items():\n                    unified_words = set(unified_norm.split())\n                    overlap = len(norm_words & u"]
[170.2722, "i", "nified_words)\n                    if overlap > best_score:\n                        best_score = overlap\n                        best_match = unified_name\n                \n                if best_match:\n                    result[f'unified_level_{level}'] = best_match\n                else:\n                    # Default to first category\n                    result[f'unified_level_{level}'] = list(unified[level].values())[0] if unified[level] else None\n        else:\n            result[f'unified_level_{level}'] = None\n    \n    return result\n\ndef main():\n    print(\"Loading categories...\")\n    all_data = load_categories()\n    print(f\"Loaded {len(all_data)} categories\")\n    \n    print(\"Building unified taxonomy...\")\n    unified = build_unified_taxonomy(all_data)\n    \n    print(\"Mapping categories...\")\n    results = []\n    for i, entry in enumerate(all_data):\n        if (i + 1) % 2000 == 0:\n            print(f\"  Processed {i + 1}/{len(all_data)}\")\n        results.append(map_category(entry, unified))\n    \n    # Save full mapping\n    df = pd.DataFrame(results)\n    df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\n    print(f\"Saved {len(df)} mappings\")\n    \n    # Statistics\n    print(\"\\nStatistics:\")\n    for level in range(1, 6):\n        print(f\"Level {level}: {df[f'unified_level_{level}'].nunique()} categories\")\n    \n    # Hierarchy\n    print(\"Building hierarchy...\")\n    hierarchy = []\n    seen = set()\n    for _, row in df.iterrows():\n        key = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\n        if key not in seen:\n            seen.add(key)\n            hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\n    \n    pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n    print(f\"Saved {len(hierarchy)} hierarchy paths\")\n    print(\"Done!\")\n\nif __name__ == '__main__':\n    main()\nEOFV4\n"]
