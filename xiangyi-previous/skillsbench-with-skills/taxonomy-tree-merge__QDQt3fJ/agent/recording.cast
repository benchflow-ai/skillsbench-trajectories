[41.904905, "o", "        if level == 1:\r\n\u001b[?2004l\r\u001b[?2004h>             top_n = 15  # Target 10-20 for level 1\r\n\u001b[?2004l\r\u001b[?2004h>         elif level == 2:\r\n\u001b[?2004l\r\u001b[?2004h>             top_n = 60  # ~4 per parent\r\n\u001b[?2004l\r\u001b[?2004h>         elif level == 3:\r\n\u001b[?2004l\r\u001b[?2004h>             top_n = 150  # ~2.5 per parent\r\n\u001b[?2004l\r\u001b[?2004h>         elif level == 4:\r\n\u001b[?2004l\r\u001b[?2004h>             top_n = 300  # ~2 per parent\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             top_n = 500  # ~1.7 per parent\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         top_cats = get_top_categories(level_cats, level, top_n)\r\n\u001b[?2004l\r\u001b[?2004h>         unified[level] = [cat for cat, _ in top_cats]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return unified\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def map_to_unified(parsed_dict: Dict, unified: Dict) -> List[Dict]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Map original categories to unified taxonomy.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for source, items in parsed_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h>         for item in items:\r\n\u001b[?2004l\r\u001b[?2004h>             parts = item['parts']\r\n\u001b[?2004l\r\u001b[?2004h>             norm_parts = item['normalized_parts']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Map each level\r\n\u001b[?2004l\r\u001b[?2004h>             unified_parts = {}\r\n\u001b[?2004l\r\u001b[?2004h>             for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h>                 if level <= len(parts):\r\n\u001b[?2004l\r\u001b[?2004h>                     norm_cat = norm_parts[level - 1]\r\n\u001b[?2004l\r\u001b[?2004h>                     # Find closest match in unified\r\n\u001b[?2004l\r\u001b[?2004h>                     if norm_cat in unified[level]:\r\n\u001b[?2004l\r\u001b[?2004h>                         unified_parts[level] = parts[level - 1]\r\n\u001b[?2004l\r\u001b[?2004h>                     else:\r\n\u001b[?2004l\r\u001b[?2004h>                         # Find best match\r\n\u001b[?2004l\r\u001b[?2004h>                         best_match = None\r\n\u001b[?2004l\r\u001b[?2004h>                         for unified_cat in unified[level]:\r\n\u001b[?2004l\r\u001b[?2004h>                             if norm_cat.startswith(unified_cat[:3]):\r\n\u001b[?2004l\r\u001b[?2004h>                                 best_match = unified_cat\r\n\u001b[?2004l\r\u001b[?2004h>                                 break\r\n\u001b[?2004l\r\u001b[?2004h>                         unified_parts[level] = best_match if best_match else unified[level][0]\r\n\u001b[?2004l\r\u001b[?2004h"]
