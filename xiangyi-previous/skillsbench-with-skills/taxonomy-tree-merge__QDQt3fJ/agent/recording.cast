[223.473558, "o", "> "]
[223.473628, "o", "        if key not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.473702, "o", "            seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.473853, "o", "            hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.473926, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.474112, "o", "    pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
