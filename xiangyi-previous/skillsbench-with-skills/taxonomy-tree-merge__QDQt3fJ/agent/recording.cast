[179.895421, "o", "Level 2: 50 categories\r\n"]
[179.895749, "o", "Level 3: 50 categories\r\n"]
[179.896057, "o", "Level 4: 50 categories\r\n"]
[179.89652, "o", "Level 5: 50 categories\r\nBuilding hierarchy...\r\n"]
[180.356536, "o", "Saved 2633 hierarchy paths\r\n"]
[180.356653, "o", "Done!\r\n"]
[180.43309, "o", "\u001b[?2004hroot@99b963fec2a8:~# "]
