[136.705851, "o", "\u001b[?2004h> "]
[136.705964, "o", "            'depth': len(parts)\r\n\u001b[?2004l\r"]
[136.706038, "o", "\u001b[?2004h> "]
[136.706111, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.706183, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.706257, "o", "    # Load Facebook\r\n\u001b[?2004l\r"]
[136.706333, "o", "\u001b[?2004h> "]
[136.706595, "o", "    df = pd.read_csv('/root/data/fb_product_categories.csv')\r\n\u001b[?2004l\r"]
[136.706672, "o", "\u001b[?2004h> "]
[136.706815, "o", "    for path in df['category_path']:\r\n\u001b[?2004l\r"]
[136.706893, "o", "\u001b[?2004h> "]
[136.707116, "o", "        parts = [p.strip() for p in path.split('>')]\r\n\u001b[?2004l\r"]
[136.707195, "o", "\u001b[?2004h> "]
[136.707282, "o", "        all_data.append({\r\n\u001b[?2004l\r"]
[136.707367, "o", "\u001b[?2004h> "]
[136.707497, "o", "            'source': 'facebook',\r\n\u001b[?2004l\r"]
[136.707579, "o", "\u001b[?2004h> "]
[136.707707, "o", "            'original_path': path,\r\n\u001b[?2004l\r"]
[136.707786, "o", "\u001b[?2004h> "]
[136.707882, "o", "            'parts': parts,\r\n\u001b[?2004l\r"]
[136.70796, "o", "\u001b[?2004h> "]
