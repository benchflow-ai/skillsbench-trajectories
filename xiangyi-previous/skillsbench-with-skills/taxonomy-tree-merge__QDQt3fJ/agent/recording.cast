[223.465792, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[223.465999, "o", "            level_unified[norm] = name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.466211, "o", "        unified[level] = level_unified\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return unified\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.466413, "o", "def map_category(entry: Dict, unified: Dict) -> Dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.466564, "o", "    \"\"\"Map category to unified taxonomy.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.466676, "o", "    result = {'source': entry['source'], 'category_path': entry['path'], 'depth': entry['depth']}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[223.466711, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[223.466909, "o", "    for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.46695, "o", "        if level <= len(entry['parts']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.46715, "o", "            part = entry['parts'][level - 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.467308, "o", "            norm = normalize_text(part)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.467472, "o", "            if norm in unified[level]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.467616, "o", "                result[f'unified_level_{level}'] = unified[level][norm]\r\n\u001b[?2004l\r"]
[223.467688, "o", "\u001b[?2004h>             else:\r\n"]
[223.467718, "o", "\u001b[?2004l\r\u001b[?2004h"]
[223.467751, "o", "> "]
[223.468026, "o", "                # Find best match\r\n\u001b[?2004l\r\u001b[?2004h>                 best_match = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.468064, "o", "                best_score = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[223.468091, "o", "> "]
[223.46835, "o", "                norm_words = set(norm.split())\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.46851, "o", "                for unified_norm, unified_name in unified[level].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[223.468546, "o", "> "]
[223.468735, "o", "                    unified_words = set(unified_norm.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.468931, "o", "                    overlap = len(norm_words & unified_words)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.469054, "o", "                    if overlap > best_score:\r\n\u001b[?2004l\r"]
[223.469088, "o", "\u001b[?2004h> "]
[223.46921, "o", "                        best_score = overlap\r\n\u001b[?2004l\r"]
[223.469285, "o", "\u001b[?2004h> "]
[223.469413, "o", "                        best_match = unified_name\r\n\u001b[?2004l\r\u001b[?2004h> "]
