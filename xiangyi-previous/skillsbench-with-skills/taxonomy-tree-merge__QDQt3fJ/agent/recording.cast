[269.394817, "o", "    text = re.sub(r'\\s+', ' ', text).strip()\r\n\u001b[?2004l\r"]
[269.394995, "o", "\u001b[?2004h> "]
[269.395089, "o", "    return text\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.395187, "o", "def load_data():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.3953, "o", "    all_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.39566, "o", "    for source, path in [('amazon', '/root/data/amazon_product_categories.csv'),\r\n\u001b[?2004l\r"]
[269.395783, "o", "\u001b[?2004h> "]
[269.396075, "o", "                         ('facebook', '/root/data/fb_product_categories.csv'),\r\n\u001b[?2004l\r"]
[269.396239, "o", "\u001b[?2004h> "]
[269.39658, "o", "                         ('google', '/root/data/google_shopping_product_categories.csv')]:\r\n\u001b[?2004l\r"]
[269.39667, "o", "\u001b[?2004h> "]
[269.396776, "o", "        df = pd.read_csv(path)\r\n\u001b[?2004l\r"]
[269.396893, "o", "\u001b[?2004h> "]
[269.397039, "o", "        for cat_path in df['category_path']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.397326, "o", "            parts = [p.strip() for p in cat_path.split('>')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.39736, "o", "> "]
[269.397455, "o", "            all_data.append({\r\n\u001b[?2004l\r"]
[269.397489, "o", "\u001b[?2004h> "]
[269.397651, "o", "                'source': source,\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.397685, "o", "> "]
[269.397837, "o", "                'path': cat_path,\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.397871, "o", "> "]
[269.39802, "o", "                'parts': parts,"]
[269.398185, "o", "\r\n"]
[269.39845, "o", "\u001b[?2004l\r"]
[269.398536, "o", "\u001b[?2004h"]
[269.398585, "o", "> "]
[269.398783, "o", "                'depth': len(parts),"]
[269.398822, "o", "\r\n"]
[269.398948, "o", "\u001b[?2004l\r"]
[269.39899, "o", "\u001b[?2004h> "]
[269.399254, "o", "                'norm_parts': [normalize(p) for p in parts]"]
[269.39934, "o", "\r\n"]
[269.399386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[269.399466, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.399571, "o", "    return all_data\r\n\u001b[?2004l\r"]
[269.399642, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[269.39967, "o", "\u001b[?2004h> "]
[269.3998, "o", "def get_level_categories(all_data, level):\r\n\u001b[?2004l\r"]
[269.399828, "o", "\u001b[?2004h> "]
[269.399987, "o", "    \"\"\"Get all categories at a specific level with frequencies.\"\"\"\r\n\u001b[?2004l\r"]
[269.400015, "o", "\u001b[?2004h> "]
[269.400085, "o", "    items = Counter()\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.400112, "o", "> "]
[269.400241, "o", "    names = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.400271, "o", "    for entry in all_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.400374, "o", "        if level <= len(entry['parts']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.40049, "o", "            norm = entry['norm_parts'][level - 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.400563, "o", ">             items[norm] += 1\r\n\u001b[?2004l\r"]
[269.400596, "o", "\u001b[?2004h> "]
[269.400696, "o", "            if norm not in names:\r\n\u001b[?2004l\r"]
[269.400723, "o", "\u001b[?2004h> "]
[269.400899, "o", "                names[norm] = entry['parts'][level - 1]\r\n\u001b[?2004l\r"]
[269.400927, "o", "\u001b[?2004h> "]
[269.400998, "o", "    return items, names\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.401029, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[269.401055, "o", "> "]
[269.401167, "o", "def build_unified(all_data):"]
[269.401249, "o", "\r\n\u001b[?2004l\r"]
[269.40128, "o", "\u001b[?2004h> "]
[269.40138, "o", "    \"\"\"Build unified taxonomy.\"\"\"\r\n\u001b[?2004l\r"]
[269.401413, "o", "\u001b[?2004h> "]
[269.401481, "o", "    unified = {}\r\n\u001b[?2004l\r"]
[269.401509, "o", "\u001b[?2004h> "]
[269.401571, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.401636, "o", "    # Level 1: Top 18\r\n\u001b[?2004l\r"]
[269.401663, "o", "\u001b[?2004h> "]
[269.401811, "o", "    items1, names1 = get_level_categories(all_data, 1)\r\n\u001b[?2004l\r"]
[269.401838, "o", "\u001b[?2004h> "]
[269.401921, "o", "    unified[1] = {}\r\n\u001b[?2004l\r"]
[269.401948, "o", "\u001b[?2004h> "]
[269.402075, "o", "    for norm, _ in items1.most_common(18):\r\n\u001b[?2004l\r"]
[269.402104, "o", "\u001b[?2004h> "]
[269.402229, "o", "        unified[1][norm] = names1[norm]\r\n\u001b[?2004l\r"]
[269.402255, "o", "\u001b[?2004h> "]
[269.40233, "o", "    "]
[269.402359, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.402459, "o", "    # Levels 2-5: Build with better distribution\r\n\u001b[?2004l\r"]
[269.402489, "o", "\u001b[?2004h> "]
[269.402586, "o", "    for level in range(2, 6):\r\n\u001b[?2004l\r"]
[269.402655, "o", "\u001b[?2004h> "]
[269.402759, "o", "        items, names = get_level_categories(all_data, level)\r\n\u001b[?2004l\r"]
[269.402789, "o", "\u001b[?2004h> "]
[269.402878, "o", "        # Filter by minimum frequency\r\n\u001b[?2004l\r"]
[269.402908, "o", "\u001b[?2004h> "]
[269.403023, "o", "        filtered = {n: c for n, c in items.items() if c >= 2}\r\n\u001b[?2004l\r"]
[269.403053, "o", "\u001b[?2004h> "]
[269.403209, "o", "        sorted_items = sorted(filtered.items(), key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[269.403241, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[269.403268, "o", "\u001b[?2004h> "]
[269.403408, "o", "        # Better distribution: more items at higher levels\r\n\u001b[?2004l\r"]
[269.403438, "o", "\u001b[?2004h> "]
[269.403508, "o", "        if level == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.403629, "o", "            top_n = min(len(sorted_items), 60)  # ~3.3 per parent\r\n\u001b[?2004l\r"]
[269.403659, "o", "\u001b[?2004h> "]
[269.403725, "o", "        elif level == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.403861, "o", "            top_n = min(len(sorted_items), 100)  # ~1.7 per parent\r\n\u001b[?2004l\r"]
[269.403889, "o", "\u001b[?2004h> "]
[269.403955, "o", "        elif level == 4:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.40409, "o", "            top_n = min(len(sorted_items), 120)  # ~1.2 per parent\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.40412, "o", "> "]
[269.404152, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.404308, "o", "            top_n = min(len(sorted_items), 100)  # ~0.8 per parent\r\n\u001b[?2004l\r"]
[269.404337, "o", "\u001b[?2004h> "]
[269.404363, "o", "        \r\n"]
[269.404398, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[269.404501, "o", "        unified[level] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.404593, "o", "        for norm, _ in sorted_items[:top_n]:\r\n\u001b[?2004l\r"]
[269.404624, "o", "\u001b[?2004h> "]
[269.404734, "o", "            unified[level][norm] = names[norm]\r\n\u001b[?2004l\r"]
[269.404765, "o", "\u001b[?2004h>     "]
[269.404807, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.404839, "o", "> "]
[269.404944, "o", "    return unified\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[269.404974, "o", "> "]
[269.405077, "o", "def find_match(norm_cat, unified_level):\r\n\u001b[?2004l\r"]
[269.405106, "o", "\u001b[?2004h> "]
[269.405237, "o", "    \"\"\"Find best match for a category.\"\"\"\r\n\u001b[?2004l\r"]
[269.405266, "o", "\u001b[?2004h> "]
[269.405357, "o", "    if not unified_level:\r\n\u001b[?2004l\r"]
[269.405391, "o", "\u001b[?2004h> "]
[269.405581, "o", "        return None\r\n\u001b[?2004l\r"]
[269.405641, "o", "\u001b[?2004h> "]
[269.405668, "o", "    \r\n\u001b[?2004l\r"]
[269.405692, "o", "\u001b[?2004h"]
[269.405722, "o", "> "]
[269.405826, "o", "    # Exact match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.405885, "o", "    if norm_cat in unified_level:\r\n\u001b[?2004l\r"]
[269.405917, "o", "\u001b[?2004h> "]
[269.40601, "o", "        return unified_level[norm_cat]\r\n\u001b[?2004l\r"]
[269.406036, "o", "\u001b[?2004h> "]
[269.406063, "o", "    \r\n\u001b[?2004l\r"]
[269.406152, "o", "\u001b[?2004h> "]
[269.406207, "o", "    # Prefix/suffix match\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.406237, "o", "> "]
[269.406334, "o", "    for unorm in unified_level.keys():\r\n\u001b[?2004l\r"]
[269.406364, "o", "\u001b[?2004h> "]
[269.406625, "o", "        if norm_cat.startswith(unorm[:5]) or unorm.startswith(norm_cat[:5]):\r\n\u001b[?2004l\r"]
[269.406672, "o", "\u001b[?2004h> "]
[269.406773, "o", "            return unified_level[unorm]\r\n\u001b[?2004l\r"]
[269.406828, "o", "\u001b[?2004h> "]
[269.406857, "o", "    \r\n\u001b[?2004l\r"]
[269.406888, "o", "\u001b[?2004h> "]
[269.406973, "o", "    # Word overlap\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.407002, "o", "> "]
[269.407114, "o", "    norm_words = set(norm_cat.split())\r\n\u001b[?2004l\r"]
[269.407142, "o", "\u001b[?2004h> "]
[269.407216, "o", "    best = None\r\n\u001b[?2004l\r"]
[269.407245, "o", "\u001b[?2004h> "]
[269.40732, "o", "    best_score = 0\r\n\u001b[?2004l\r"]
[269.407348, "o", "\u001b[?2004h> "]
[269.40747, "o", "    for unorm in unified_level.keys():\r\n\u001b[?2004l\r"]
[269.4075, "o", "\u001b[?2004h> "]
[269.40761, "o", "        uwords = set(unorm.split())\r\n\u001b[?2004l\r"]
[269.407637, "o", "\u001b[?2004h> "]
[269.407761, "o", "        score = len(norm_words & uwords)\r\n\u001b[?2004l\r"]
[269.407787, "o", "\u001b[?2004h> "]
[269.407888, "o", "        if score > best_score:\r\n\u001b[?2004l\r"]
[269.407915, "o", "\u001b[?2004h> "]
[269.408021, "o", "            best_score = score\r\n\u001b[?2004l\r"]
[269.408048, "o", "\u001b[?2004h> "]
[269.408165, "o", "            best = unified_level[unorm]\r\n"]
[269.408195, "o", "\u001b[?2004l\r\u001b[?2004h"]
[269.408222, "o", ">     "]
[269.408258, "o", "\r\n\u001b[?2004l\r"]
[269.408287, "o", "\u001b[?2004h> "]
[269.408404, "o", "    if best:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.408432, "o", "        return best\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.408458, "o", ">     "]
[269.408488, "o", "\r\n\u001b[?2004l\r"]
[269.408517, "o", "\u001b[?2004h> "]
[269.408625, "o", "    # Default\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.40872, "o", "    return list(unified_level.values())[0]\r\n\u001b[?2004l\r"]
[269.408747, "o", "\u001b[?2004h> "]
[269.408773, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.408911, "o", "> "]
[269.409002, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.409036, "o", "    print(\"Loading...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.409065, "o", "    all_data = load_data()\r\n\u001b[?2004l\r"]
[269.409095, "o", "\u001b[?2004h> "]
[269.409277, "o", "    print(f\"Loaded {len(all_data)} categories\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.409378, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Building taxonomy...\")\r\n\u001b[?2004l\r"]
[269.40945, "o", "\u001b[?2004h> "]
[269.409512, "o", "    unified = build_unified(all_data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.409577, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.409646, "o", "    print(\"Mapping...\")\r\n\u001b[?2004l\r"]
[269.409746, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r"]
[269.409856, "o", "\u001b[?2004h> "]
[269.409916, "o", "    for i, entry in enumerate(all_data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.410014, "o", "        if (i + 1) % 2000 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.41009, "o", "            print(f\"  {i + 1}/{len(all_data)}\")\r\n\u001b[?2004l\r"]
[269.410154, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[269.41022, "o", "\u001b[?2004h> "]
[269.410283, "o", "        result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.410372, "o", "            'source': entry['source'],\r\n\u001b[?2004l\r"]
[269.410521, "o", "\u001b[?2004h>             'category_path': entry['path'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.410656, "o", "            'depth': entry['depth']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.410752, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.410933, "o", "        for level in range(1, 6):\r\n\u001b[?2004l\r"]
[269.410999, "o", "\u001b[?2004h>             if level <= len(entry['parts']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.411123, "o", "                norm = entry['norm_parts'][level - 1]\r\n\u001b[?2004l\r"]
[269.411185, "o", "\u001b[?2004h> "]
[269.411325, "o", "                match = find_match(norm, unified[level])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.411437, "o", "                result[f'unified_level_{level}'] = match\r\n\u001b[?2004l\r"]
[269.411498, "o", "\u001b[?2004h>             else:\r\n\u001b[?2004l\r"]
[269.411564, "o", "\u001b[?2004h> "]
[269.411702, "o", "                result[f'unified_level_{level}'] = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n"]
[269.41176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[269.411848, "o", "        results.append(result)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.411968, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412035, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412181, "o", "    df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412354, "o", "    print(f\"Saved {len(df)} mappings\")\r\n\u001b[?2004l\r"]
[269.412421, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nStatistics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412522, "o", "    for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412693, "o", "        count = df[f'unified_level_{level}'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.412833, "o", "        print(f\"Level {level}: {count} categories\")"]
[269.412914, "o", "\r\n\u001b[?2004l\r"]
[269.413061, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nBuilding hierarchy...\")\r\n\u001b[?2004l\r"]
[269.413122, "o", "\u001b[?2004h> "]
[269.413182, "o", "    hierarchy = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.413241, "o", "    seen = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.413298, "o", "> "]
[269.413357, "o", "    for _, row in df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.41342, "o", "> "]
[269.413575, "o", "        key = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.413637, "o", "        if key not in seen:\r\n\u001b[?2004l\r"]
[269.413696, "o", "\u001b[?2004h> "]
[269.413758, "o", "            seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.413982, "o", "            hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[269.414068, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[269.414303, "o", "    pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.414412, "o", "    print(f\"Saved {len(hierarchy)} paths\")\r\n\u001b[?2004l\r"]
[269.414537, "o", "\u001b[?2004h>     print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[269.414634, "o", "\u001b[?2004h> "]
[269.414698, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[269.414761, "o", "\u001b[?2004h> EOFFINAL\r\n\u001b[?2004l\r"]
[269.416626, "o", "\u001b[?2004hroot@99b963fec2a8:~# "]
[274.349882, "i", "python3 /root/final_taxonomy.py\n"]
