[223.464336, "o", "                if child_norm not in level_items:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.464494, "o", "                    level_items[child_norm] = (level_names[child_norm], count)\r\n\u001b[?2004l\r"]
[223.464545, "o", "\u001b[?2004h> "]
[223.464577, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[223.46461, "o", "> "]
[223.464842, "o", "        # Keep top items\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.464951, "o", "        sorted_items = sorted(level_items.items(), key=lambda x: x[1][1], reverse=True)\r\n\u001b[?2004l\r"]
[223.464986, "o", "\u001b[?2004h> "]
[223.465186, "o", "        top_n = min(len(sorted_items), max(40, 12 * (6 - level)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.465227, "o", "        \r\n\u001b[?2004l\r"]
[223.465257, "o", "\u001b[?2004h> "]
[223.465448, "o", "        level_unified = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
