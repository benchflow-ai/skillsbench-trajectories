[179.408844, "o", "  Processed 4000/11085\r\n"]
[179.526571, "o", "  Processed 6000/11085\r\n"]
[179.650195, "o", "  Processed 8000/11085\r\n"]
[179.769006, "o", "  Processed 10000/11085\r\n"]
