[245.659248, "o", "source,category_path,depth,unified_level_1,unified_level_2,unified_level_3,unified_level_4,unified_level_5\r\namazon,\"Clothing, Shoes & Jewelry > Women's Fashion > Women's Shops > Maternity > Maternity Sleepwear\",5,clothing & accessories,Women's Fashion,kitchen & dining,maternity clothing,bicycle drivetrain parts\r\namazon,\"Beauty & Personal Care > Foot, Hand & Nail Care Products > Hand, Foot & Nail Tools > Nail Cleaning Brushes\",4,health & beauty,Hobbies & Creative Arts,Kitchen Tools & Utensils,Household Cleaning Products,\r\namazon,Health & Household > Health Care Products > First Aid Supplies > Itching & Rash Treatments > Poison Ivy Treatments,5,health & beauty,Health Care,Household Cleaning Supplies,Art & Crafting Materials,bicycle drivetrain parts\r\namazon,Sports & Outdoors > Outdoor Recreation > Cycling Equipment > Cycling Accessories > Bike Lights & Reflectors > Bike Headlights,6,Sports & Outdoors,Outdoor Recreation,cycling,Woodwind Instrument Accessories,Embellishments & Trims\r\namazon,Pet Supplies > Horse Supplies > Horse Grooming & Bathing Supplies > Horse Care Coat Care,4,sporting goods,building supplies & hardware,kitchen & dining,Skin Care,\r\namazon,Automotive > Automotive Replacement Parts > Automotive Replacement Engines & Engine Parts > Automotive Replacement Engine Parts > Automotive Replacement Engine Valves & Parts > Automotive Replacement Engine Valve Cover Bolts,6,Automotive,Automotive Replacement Parts,Plumbing Fixture Hardware & Parts,bicycle parts,paintball gun parts & accessories\r\namazon,Books > Science & Math > Behavioral Sciences > Cognitive Psychology,4,Books,Science & Laboratory,kitchen & dining,bicycle parts,\r\namazon,Automotive > Car Care > Exterior Care Products > Cleaners,4,Automotive,Personal Care,\"Vehicle Maintenance, Care & Decor\",bicycle parts,\r\namazon,Books > History > American History > South American History > Peru History,5,Books,Hobbies & Creative Arts,kitchen & dining,bicycle parts,bicycle d