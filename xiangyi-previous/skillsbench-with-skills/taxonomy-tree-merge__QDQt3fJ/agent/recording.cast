[269.392092, "i", "cat > /root/final_taxonomy.py << 'EOFFINAL'\nimport pandas as pd\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple, Optional\n\ndef normalize(text: str) -> str:\n    text = text.strip().lower()\n    text = re.sub(r'[&/]', ' and ', text)\n    text = re.sub(r'[^a-z0-9\\s]', '', text)\n    text = re.sub(r'\\s+', ' ', text).strip()\n    return text\n\ndef load_data():\n    all_data = []\n    for source, path in [('amazon', '/root/data/amazon_product_categories.csv'),\n                         ('facebook', '/root/data/fb_product_categories.csv'),\n                         ('google', '/root/data/google_shopping_product_categories.csv')]:\n        df = pd.read_csv(path)\n        for cat_path in df['category_path']:\n            parts = [p.strip() for p in cat_path.split('>')]\n            all_data.append({\n                'source': source,\n                'path': cat_path,\n                'parts': parts,\n                'depth': len(parts),\n                'norm_parts': [normalize(p) for p in parts]\n            })\n    return all_data\n\ndef get_level_categories(all_data, level):\n    \"\"\"Get all categories at a specific level with frequencies.\"\"\"\n    items = Counter()\n    names = {}\n    for entry in all_data:\n        if level <= len(entry['parts']):\n            norm = entry['norm_parts'][level - 1]\n            items[norm] += 1\n            if norm not in names:\n                names[norm] = entry['parts'][level - 1]\n    return items, names\n\ndef build_unified(all_data):\n    \"\"\"Build unified taxonomy.\"\"\"\n    unified = {}\n    \n    # Level 1: Top 18\n    items1, names1 = get_level_categories(all_data, 1)\n    unified[1] = {}\n    for norm, _ in items1.most_common(18):\n        unified[1][norm] = names1[norm]\n    \n    # Levels 2-5: Build with better distribution\n    for level in range(2, 6):\n        items, names = get_level_categories(all_data, level)\n        # Filter by minimum frequency\n        filtered = {n: c for n, c in items.items() if c >= 2}\n        sorted_items = sorted(filtered.items(), key=lambda x: x[1], reverse=True)\n        \n        # Better distribution: more items at higher levels\n        if level == 2:\n            top_n = min(len(sorted_items), 60)  # ~3.3 per parent\n        elif level == 3:\n            top_n = min(len(sorted_items), 100)  # ~1.7 per parent\n        elif level == 4:\n            top_n = min(len(sorted_items), 120)  # ~1.2 per parent\n        else:\n            top_n = min(len(sorted_items), 100)  # ~0.8 per parent\n        \n        unified[level] = {}\n        for norm, _ in sorted_items[:top_n]:\n            unified[level][norm] = names[norm]\n    \n    return unified\n\ndef find_match(norm_cat, unified_level):\n    \"\"\"Find best match for a category.\"\"\"\n    if not unified_level:\n        return None\n    \n    # Exact match\n    if norm_cat in unified_level:\n        return unified_level[norm_cat]\n    \n    # Prefix/suffix match\n    for unorm in unified_level.keys():\n        if norm_cat.startswith(unorm[:5]) or unorm.startswith(norm_cat[:5]):\n            return unified_level[unorm]\n    \n    # Word overlap\n    norm_words = set(norm_cat.split())\n    best = None\n    best_score = 0\n    for unorm in unified_level.keys():\n        uwords = set(unorm.split())\n        score = len(norm_words & uwords)\n        if score > best_score:\n            best_score = score\n            best = unified_level[unorm]\n    \n    if best:\n        return best\n    \n    # Default\n    return list(unified_level.values())[0]\n\ndef main():\n    print(\"Loading...\")\n    all_data = load_data()\n    print(f\"Loaded {len(all_data)} categories\")\n    \n    print(\"Building taxonomy...\")\n    unified = build_unified(all_data)\n    \n    print(\"Mapping...\")\n    results = []\n    for i, entry in enumerate(all_data):\n        if (i + 1) % 2000 == 0:\n            print(f\"  {i + 1}/{len(all_data)}\")\n        \n        result = {\n            'source': entry['source'],\n            'category_path': entry['path'],\n            'depth': entry['depth']\n        }\n        \n        for level in range(1, 6):\n            if level <= len(entry['parts']):\n                no"]
[269.392182, "i", "rm = entry['norm_parts'][level - 1]\n                match = find_match(norm, unified[level])\n                result[f'unified_level_{level}'] = match\n            else:\n                result[f'unified_level_{level}'] = None\n        \n        results.append(result)\n    \n    df = pd.DataFrame(results)\n    df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\n    print(f\"Saved {len(df)} mappings\")\n    \n    print(\"\\nStatistics:\")\n    for level in range(1, 6):\n        count = df[f'unified_level_{level}'].nunique()\n        print(f\"Level {level}: {count} categories\")\n    \n    print(\"\\nBuilding hierarchy...\")\n    hierarchy = []\n    seen = set()\n    for _, row in df.iterrows():\n        key = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\n        if key not in seen:\n            seen.add(key)\n            hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\n    \n    pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n    print(f\"Saved {len(hierarchy)} paths\")\n    print(\"Done!\")\n\nif __name__ == '__main__':\n    main()\nEOFFINAL\n"]
