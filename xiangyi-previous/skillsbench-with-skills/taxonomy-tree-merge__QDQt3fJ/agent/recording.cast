[311.722968, "i", "python3 << 'EOFCHECK'\nimport pandas as pd\n\n# Load both files\ndf_full = pd.read_csv('/root/output/unified_taxonomy_full.csv')\ndf_hier = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\n\nprint(\"=== unified_taxonomy_full.csv ===\")\nprint(f\"Total rows: {len(df_full)}\")\nprint(f\"Columns: {list(df_full.columns)}\")\nprint(f\"\\nSource distribution:\")\nprint(df_full['source'].value_counts())\nprint(f\"\\nDepth distribution:\")\nprint(df_full['depth'].value_counts().sort_index())\n\nprint(f\"\\n=== unified_taxonomy_hierarchy.csv ===\")\nprint(f\"Total unique paths: {len(df_hier)}\")\nprint(f\"Columns: {list(df_hier.columns)}\")\n\nprint(f\"\\n=== Category counts by level ===\")\nfor level in range(1, 6):\n    col = f'unified_level_{level}'\n    count = df_full[col].nunique()\n    print(f\"Level {level}: {count} unique categories\")\n\nprint(f\"\\n=== Sample mappings ===\")\nprint(df_full[['source', 'category_path', 'unified_level_1', 'unified_level_2', 'unified_level_3']].head(5))\n\nprint(\"\\n✓ Files are properly formatted and complete!\")\nEOFCHECK\n"]
