[170.274457, "o", "    all_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.274502, "o", "    \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[170.274734, "o", "    for source, filepath in [('amazon', '/root/data/amazon_product_categories.csv'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.27497, "o", "                             ('facebook', '/root/data/fb_product_categories.csv'),\r\n\u001b[?2004l\r"]
[170.275016, "o", "\u001b[?2004h> "]
[170.275349, "o", "                             ('google', '/root/data/google_shopping_product_categories.csv')]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.275402, "o", "> "]
[170.27547, "o", "        df = pd.read_csv(filepath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.27552, "o", "> "]
[170.275638, "o", "        for path in df['category_path']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.275687, "o", "> "]
[170.275841, "o", "            parts = [p.strip() for p in path.split('>')]\r\n\u001b[?2004l\r"]
[170.275892, "o", "\u001b[?2004h> "]
[170.276021, "o", "            all_data.append({\r\n\u001b[?2004l\r"]
[170.276091, "o", "\u001b[?2004h> "]
[170.276146, "o", "                'source': source,\r\n\u001b[?2004l\r"]
[170.276191, "o", "\u001b[?2004h> "]
[170.276267, "o", "                'path': path,\r\n\u001b[?2004l\r"]
[170.276318, "o", "\u001b[?2004h> "]
[170.276406, "o", "                'parts': parts,\r\n\u001b[?2004l\r"]
[170.27645, "o", "\u001b[?2004h> "]
[170.276521, "o", "                'depth': len(parts)\r\n\u001b[?2004l\r"]
[170.276571, "o", "\u001b[?2004h> "]
[170.276614, "o", "            })\r\n\u001b[?2004l\r"]
[170.27666, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[170.276701, "o", "\u001b[?2004h> "]
[170.276781, "o", "    return all_data\r\n\u001b[?2004l\r"]
[170.276872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[170.277054, "o", "def build_hierarchy_tree(all_data: List[Dict]):\r\n\u001b[?2004l\r"]
[170.277107, "o", "\u001b[?2004h> "]
[170.277202, "o", "    \"\"\"Build a tree structure of categories.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.277249, "o", "> "]
[170.277297, "o", "    tree = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.277349, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.277453, "o", "    for entry in all_data:\r\n\u001b[?2004l\r"]
[170.2775, "o", "\u001b[?2004h> "]
[170.277555, "o", "        parts = entry['parts']\r\n\u001b[?2004l\r     pr\u001b[?2004h"]
[170.2776, "o", "> "]
[170.277693, "o", "        current = tree\r\n\u001b[?2004l\r"]
[170.277738, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[170.277783, "o", "\u001b[?2004h> "]
[170.277874, "o", "        for i, part in enumerate(parts):\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.277919, "o", "> "]
[170.277995, "o", "            norm = normalize_text(part)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.278041, "o", "> "]
[170.278105, "o", "            if norm not in current:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.278147, "o", "> "]
[170.278398, "o", "                current[norm] = {'name': part, 'children': {}, 'count': 0, 'depth': i + 1}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.278536, "o", "            current[norm]['count'] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.278645, "o", "            current = current[norm]['children']\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.278694, "o", ">     \r\n\u001b[?2004l\r  \u001b[?2004h> "]
[170.278787, "o", "    return tree\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[170.278962, "o", "def extract_top_categories(tree: Dict, max_count: int) -> List[str]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.279037, "o", "> "]
[170.279116, "o", "    \"\"\"Extract top categories from tree.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.279298, "o", "    items = [(norm, data['count']) for norm, data in tree.items()]\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.279373, "o", "> "]
[170.279441, "o", "    items.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[170.279507, "o", "\u001b[?2004h> "]
[170.279619, "o", "    return [norm for norm, _ in items[:max_count]]\r\n\u001b[?2004l\r"]
[170.279696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.279769, "o", "def build_unified_taxonomy(all_data: List[Dict]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.279866, "o", "    \"\"\"Build unified taxonomy using hierarchy analysis.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.27994, "o", ">     # Build tree structure\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280016, "o", "    tree = build_hierarchy_tree(all_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280093, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     unified = {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[170.280166, "o", "\u001b[?2004h> "]
[170.280235, "o", "    # Level 1: Top 18 categories\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280307, "o", "    level1_norms = extract_top_categories(tree, 18)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.280379, "o", ">     unified[1] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280452, "o", "    for norm in level1_norms:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280539, "o", "        unified[1][norm] = tree[norm]['name']\r\n\u001b[?2004l\r"]
[170.280614, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.280688, "o", "    # For each level, build from the tree\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.280757, "o", ">     for level in range(2, 6):\r\n\u001b[?2004l\r"]
[170.280863, "o", "\u001b[?2004h> "]
[170.280941, "o", "        level_items = defaultdict(lambda: {'count': 0, 'name': ''})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281014, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         for entry in all_data:\r\n\u001b[?2004l\r"]
[170.28109, "o", "\u001b[?2004h> "]
[170.281161, "o", "            if level <= len(entry['parts']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281233, "o", "                norm = normalize_text(entry['parts'][level - 1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.281303, "o", "> "]
[170.281377, "o", "                if not level_items[norm]['name']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281448, "o", "                    level_items[norm]['name'] = entry['parts'][level - 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.281519, "o", "> "]
[170.281588, "o", "                level_items[norm]['count'] += 1\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281659, "o", "        # Keep top items\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281794, "o", "        sorted_items = sorted([(k, v['count']) for k, v in level_items.items()],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.281898, "o", "                             key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.281968, "o", "> "]
[170.282039, "o", "        top_n = min(len(sorted_items), max(50, 10 * (6 - level)))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[170.282115, "o", "\u001b[?2004h>         unified[level] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.282189, "o", "        for norm, _ in sorted_items[:top_n]:\r\n\u001b[?2004l\r"]
[170.282258, "o", "\u001b[?2004h> "]
[170.282326, "o", "            unified[level][norm] = level_items[norm]['name']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.282395, "o", ">     return unified\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.282487, "o", "def map_category(entry: Dict, unified: Dict) -> Dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.282555, "o", ">     \"\"\"Map category to unified taxonomy.\"\"\"\r\n\u001b[?2004l\r"]
[170.282623, "o", "\u001b[?2004h>     result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.282692, "o", "        'source': entry['source'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.282763, "o", "        'category_path': entry['path'],\r\n\u001b[?2004l\r"]
[170.282837, "o", "\u001b[?2004h>         'depth': entry['depth']\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.282937, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283035, "o", "    for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283119, "o", "        if level <= len(entry['parts']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283194, "o", "            part = entry['parts'][level - 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283267, "o", "            norm = normalize_text(part)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.283337, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283413, "o", "            # Try exact match first\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283487, "o", "            if norm in unified[level]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28358, "o", "                result[f'unified_level_{level}'] = unified[level][norm]\r\n\u001b[?2004l\r"]
[170.283654, "o", "\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.283759, "o", "                # Try to find best match by word overlap\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.283836, "o", ">                 best_match = None\r\n"]
[170.283908, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.28402, "o", "                best_score = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284111, "o", "                norm_words = set(norm.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284248, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284334, "o", "                for unified_norm, unified_name in unified[level].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284457, "o", "                    unified_words = set(unified_norm.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284529, "o", "                    overlap = len(norm_words & unified_words)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284599, "o", "                    if overlap > best_score:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.284673, "o", "> "]
[170.284747, "o", "                        best_score = overlap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.284833, "o", "                        best_match = unified_name\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[170.284907, "o", "\u001b[?2004h>                 if best_match:\r\n\u001b[?2004l\r"]
[170.284978, "o", "\u001b[?2004h> "]
[170.285048, "o", "                    result[f'unified_level_{level}'] = best_match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285134, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285208, "o", "                    # Default to first category\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285359, "o", "                    result[f'unified_level_{level}'] = list(unified[level].values())[0] if unified[level] else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285435, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28552, "o", "            result[f'unified_level_{level}'] = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.285591, "o", ">     return result\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285657, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285723, "o", "    print(\"Loading categories...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285795, "o", "    all_data = load_categories()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.285867, "o", "    print(f\"Loaded {len(all_data)} categories\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[170.285936, "o", "\u001b[?2004h>     print(\"Building unified taxonomy...\")\r\n\u001b[?2004l\r"]
[170.286013, "o", "\u001b[?2004h> "]
[170.286087, "o", "    unified = build_unified_taxonomy(all_data)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.286158, "o", "    print(\"Mapping categories...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.286228, "o", ">     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28629, "o", "    for i, entry in enumerate(all_data):\r\n\u001b[?2004l\r"]
[170.28636, "o", "\u001b[?2004h>         if (i + 1) % 2000 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.286429, "o", "> "]
[170.286503, "o", "            print(f\"  Processed {i + 1}/{len(all_data)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.286575, "o", "        results.append(map_category(entry, unified))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.286646, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Save full mapping\r\n\u001b[?2004l\r"]
[170.286717, "o", "\u001b[?2004h>     df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[170.286788, "o", "\u001b[?2004h> "]
[170.286871, "o", "    df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.286943, "o", "    print(f\"Saved {len(df)} mappings\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.287012, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28708, "o", "    # Statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287146, "o", "    print(\"\\nStatistics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287217, "o", "    for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287371, "o", "        print(f\"Level {level}: {df[f'unified_level_{level}'].nunique()} categories\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[170.287448, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.287518, "o", "    # Hierarchy\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Building hierarchy...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287587, "o", "    hierarchy = []\r\n\u001b[?2004l\r\u001b[?2004h>     seen = set()\r\n\u001b[?2004l\r"]
[170.287655, "o", "\u001b[?2004h>     for _, row in df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.287723, "o", "> "]
[170.287792, "o", "        key = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287858, "o", "        if key not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.287928, "o", "            seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28804, "o", "            hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288122, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28823, "o", "    pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288325, "o", "    print(f\"Saved {len(hierarchy)} hierarchy paths\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288405, "o", "    print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.288475, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.288547, "o", ">     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOFV4\r\n\u001b[?2004l\r"]
[170.290166, "o", "\u001b[?2004hroot@99b963fec2a8:~# "]
[178.26165, "i", "python3 /root/process_taxonomy_v4.py\n"]
[178.261947, "o", "python3 /root/process_taxonomy_v4.py\r\n\u001b[?2004l\r"]
