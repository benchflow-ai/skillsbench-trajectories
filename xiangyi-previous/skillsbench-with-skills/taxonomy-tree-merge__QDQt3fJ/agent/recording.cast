[223.471115, "o", "> "]
[223.471253, "o", "    print(\"Mapping categories...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.471325, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.471451, "o", "    for i, entry in enumerate(all_data):\r\n\u001b[?2004l\r\u001b[?2004h"]
