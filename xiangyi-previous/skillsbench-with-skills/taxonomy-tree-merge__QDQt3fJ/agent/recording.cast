[223.469614, "o", "\u001b[?2004h> "]
[223.469815, "o", "                result[f'unified_level_{level}'] = best_match if best_match else list(unified[level].values())[0] if unified[level] else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[223.46995, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
