004h>     df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h>     df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Saved {len(df)} mappings\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nStatistics:\")\r\n\u001b[?2004l\r\u001b[?2004h>     for level in range(1, 6):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Level {level}: {df[f'unified_level_{level}'].nunique()} categories\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Building hierarchy...\")\r\n\u001b[?2004l\r\u001b[?2004h>     hierarchy = []\r\n\u001b[?2004l\r\u001b[?2004h>     seen = set()\r\n\u001b[?2004l\r\u001b[?2004h>     for _, row in df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h>         key = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\r\n\u001b[?2004l\r\u001b[?2004h>         if key not in seen:\r\n\u001b[?2004l\r\u001b[?2004h>             seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h>             hierarchy.append({f'unified_level_{i}': key[i-1] for i in range(1, 6)})\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     pd.DataFrame(hierarchy).to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Saved {len(hierarchy)} hierarchy paths\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOFV5\r\n\u001b[?2004l\r"]
