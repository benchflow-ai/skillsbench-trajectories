[136.688282, "i", "cat > /root/process_taxonomy_v3.py << 'EOFSCRIPT'\nimport pandas as pd\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple\n\ndef normalize_text(text: str) -> str:\n    \"\"\"Normalize text for comparison.\"\"\"\n    text = text.strip().lower()\n    text = re.sub(r'[&/]', ' and ', text)\n    text = re.sub(r'[^a-z0-9\\s]', '', text)\n    text = re.sub(r'\\s+', ' ', text)\n    return text\n\ndef load_and_parse_categories():\n    \"\"\"Load and parse all categories.\"\"\"\n    all_data = []\n    \n    # Load Amazon\n    df = pd.read_csv('/root/data/amazon_product_categories.csv')\n    for path in df['category_path']:\n        parts = [p.strip() for p in path.split('>')]\n        all_data.append({\n            'source': 'amazon',\n            'original_path': path,\n            'parts': parts,\n            'depth': len(parts)\n        })\n    \n    # Load Facebook\n    df = pd.read_csv('/root/data/fb_product_categories.csv')\n    for path in df['category_path']:\n        parts = [p.strip() for p in path.split('>')]\n        all_data.append({\n            'source': 'facebook',\n            'original_path': path,\n            'parts': parts,\n            'depth': len(parts)\n        })\n    \n    # Load Google\n    df = pd.read_csv('/root/data/google_shopping_product_categories.csv')\n    for path in df['category_path']:\n        parts = [p.strip() for p in path.split('>')]\n        all_data.append({\n            'source': 'google',\n            'original_path': path,\n            'parts': parts,\n            'depth': len(parts)\n        })\n    \n    return all_data\n\ndef build_unified_taxonomy(all_data: List[Dict]):\n    \"\"\"Build unified taxonomy by analyzing hierarchy.\"\"\"\n    unified = {}\n    \n    # Level 1: Get all top-level categories with frequency\n    level1_counts = Counter()\n    level1_names = {}\n    \n    for entry in all_data:\n        cat = entry['parts'][0]\n        norm = normalize_text(cat)\n        level1_counts[norm] += 1\n        if norm not in level1_names:\n            level1_names[norm] = cat\n    \n    # Keep top 18 for level 1\n    level1_unified = {}\n    for norm, count in level1_counts.most_common(18):\n        level1_unified[norm] = level1_names[norm]\n    \n    unified[1] = level1_unified\n    \n    # Build levels 2-5 by analyzing parent-child relationships\n    for level in range(2, 6):\n        level_items = defaultdict(lambda: {'count': 0, 'name': '', 'parents': set()})\n        \n        for entry in all_data:\n            if level <= len(entry['parts']):\n                cat = entry['parts'][level - 1]\n                norm = normalize_text(cat)\n                parent = normalize_text(entry['parts'][level - 2])\n                \n                level_items[norm]['count'] += 1\n                if not level_items[norm]['name']:\n                    level_items[norm]['name'] = cat\n                level_items[norm]['parents'].add(parent)\n        \n        # Filter to keep only items with parent in previous level or frequent items\n        filtered_items = {}\n        for norm, data in level_items.items():\n            # Keep if parent is in previous level or if it's frequent enough\n            if data['count'] >= 2:  # At least 2 occurrences\n                filtered_items[norm] = data['name']\n        \n        # Keep top N items\n        sorted_items = sorted([(k, level_items[k]['count']) for k in filtered_items.keys()],\n                             key=lambda x: x[1], reverse=True)\n        top_n = min(len(sorted_items), max(40, 12 * (6 - level)))\n        \n        level_unified = {}\n        for norm, _ in sorted_items[:top_n]:\n            level_unified[norm] = filtered_items[norm]\n        \n        unified[level] = level_unified\n    \n    return unified\n\ndef find_best_match(norm_cat: str, unified_level: Dict[str, str]) -> str:\n    \"\"\"Find best matching category in unified level.\"\"\"\n    if not unified_level:\n        return None\n    \n    # Exact match\n    if norm_cat in unified_level:\n        return unified_level[norm_cat]\n    \n    # Prefix match\n    for unified_norm, unified_name in unified_level.items():\n        if norm_cat.startswith(unified_norm["]
[136.688374, "i", ":4]) or unified_norm.startswith(norm_cat[:4]):\n            return unified_name\n    \n    # Word overlap\n    norm_words = set(norm_cat.split())\n    best_match = None\n    best_overlap = 0\n    for unified_norm in unified_level.keys():\n        unified_words = set(unified_norm.split())\n        overlap = len(norm_words & unified_words)\n        if overlap > best_overlap:\n            best_overlap = overlap\n            best_match = unified_norm\n    \n    if best_match:\n        return unified_level[best_match]\n    \n    # Default: return first item\n    return list(unified_level.values())[0] if unified_level else None\n\ndef map_category_to_unified(entry: Dict, unified: Dict) -> Dict:\n    \"\"\"Map a single category to unified taxonomy.\"\"\"\n    result = {\n        'source': entry['source'],\n        'category_path': entry['original_path'],\n        'depth': entry['depth']\n    }\n    \n    for level in range(1, 6):\n        if level <= len(entry['parts']):\n            cat = entry['parts'][level - 1]\n            norm = normalize_text(cat)\n            best_match = find_best_match(norm, unified[level])\n            result[f'unified_level_{level}'] = best_match\n        else:\n            result[f'unified_level_{level}'] = None\n    \n    return result\n\ndef main():\n    print(\"Loading and parsing categories...\")\n    all_data = load_and_parse_categories()\n    print(f\"Loaded {len(all_data)} category paths\")\n    \n    print(\"Building unified taxonomy structure...\")\n    unified = build_unified_taxonomy(all_data)\n    \n    print(\"Mapping categories to unified taxonomy...\")\n    results = []\n    for i, entry in enumerate(all_data):\n        if (i + 1) % 2000 == 0:\n            print(f\"  Processed {i + 1}/{len(all_data)}\")\n        mapped = map_category_to_unified(entry, unified)\n        results.append(mapped)\n    \n    # Save full mapping\n    df_full = pd.DataFrame(results)\n    df_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\n    print(f\"Saved {len(df_full)} mappings to unified_taxonomy_full.csv\")\n    \n    # Print statistics\n    print(\"\\nUnified Taxonomy Statistics:\")\n    for level in range(1, 6):\n        unique_count = df_full[f'unified_level_{level}'].nunique()\n        print(f\"Level {level}: {unique_count} unique categories\")\n    \n    # Save hierarchy\n    print(\"Building hierarchy...\")\n    hierarchy_rows = []\n    seen = set()\n    for _, row in df_full.iterrows():\n        levels = tuple(row[f'unified_level_{i}'] for i in range(1, 6))\n        if levels not in seen:\n            seen.add(levels)\n            hierarchy_rows.append({\n                'unified_level_1': levels[0],\n                'unified_level_2': levels[1],\n                'unified_level_3': levels[2],\n                'unified_level_4': levels[3],\n                'unified_level_5': levels[4]\n            })\n    \n    df_hierarchy = pd.DataFrame(hierarchy_rows)\n    df_hierarchy.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n    print(f\"Saved {len(df_hierarchy)} hierarchy paths to unified_taxonomy_hierarchy.csv\")\n    \n    print(\"Done!\")\n\nif __name__ == '__main__':\n    main()\nEOFSCRIPT\n"]
