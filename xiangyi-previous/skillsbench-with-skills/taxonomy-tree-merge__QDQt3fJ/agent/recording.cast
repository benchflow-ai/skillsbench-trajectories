[136.708164, "o", "\u001b[?2004h> "]
[136.708239, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.708315, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.708391, "o", "    # Load Google\r\n\u001b[?2004l\r"]
[136.70847, "o", "\u001b[?2004h> "]
[136.70889, "o", "    df = pd.read_csv('/root/data/google_shopping_product_categories.csv')\r\n\u001b[?2004l\r"]
[136.708984, "o", "\u001b[?2004h> "]
[136.70915, "o", "    for path in df['category_path']:\r\n\u001b[?2004l\r"]
[136.709231, "o", "\u001b[?2004h> "]
[136.709456, "o", "        parts = [p.strip() for p in path.split('>')]\r\n\u001b[?2004l\r"]
[136.709544, "o", "\u001b[?2004h> "]
[136.709627, "o", "        all_data.append({\r\n\u001b[?2004l\r"]
[136.709706, "o", "\u001b[?2004h> "]
[136.70983, "o", "            'source': 'google',\r\n\u001b[?2004l\r"]
[136.709914, "o", "\u001b[?2004h> "]
[136.710044, "o", "            'original_path': path,\r\n\u001b[?2004l\r"]
[136.710125, "o", "\u001b[?2004h> "]
[136.710229, "o", "            'parts': parts,\r\n\u001b[?2004l\r"]
[136.710312, "o", "\u001b[?2004h> "]
[136.710428, "o", "            'depth': len(parts)\r\n\u001b[?2004l\r"]
[136.710514, "o", "\u001b[?2004h> "]
[136.710591, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.710666, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.710743, "o", "    return all_data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.710821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.710974, "o", "def build_unified_taxonomy(all_data: List[Dict]):\r\n\u001b[?2004l\r"]
[136.711057, "o", "\u001b[?2004h> "]
[136.71129, "o", "    \"\"\"Build unified taxonomy by analyzing hierarchy.\"\"\"\r\n\u001b[?2004l\r"]
[136.711373, "o", "\u001b[?2004h> "]
[136.711451, "o", "    unified = {}\r\n\u001b[?2004l\r"]
[136.711534, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.71161, "o", "> "]
[136.713202, "o", "    # Level 1: Get all top-level categories with frequency\r\n\u001b[?2004l\r"]
[136.713296, "o", "\u001b[?2004h> "]
[136.713415, "o", "    level1_counts = Counter()\r\n\u001b[?2004l\r"]
[136.713496, "o", "\u001b[?2004h> "]
[136.713577, "o", "    level1_names = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.713655, "o", ">     \r\n"]
[136.713746, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.713836, "o", "    for entry in all_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.713997, "o", "        cat = entry['parts'][0]\r\n\u001b[?2004l\r"]
[136.714096, "o", "\u001b[?2004h> "]
[136.714234, "o", "        norm = normalize_text(cat)\r\n\u001b[?2004l\r"]
[136.714332, "o", "\u001b[?2004h> "]
[136.714446, "o", "        level1_counts[norm] += 1\r\n\u001b[?2004l\r"]
[136.714532, "o", "\u001b[?2004h> "]
[136.714675, "o", "        if norm not in level1_names:\r\n\u001b[?2004l\r"]
[136.71477, "o", "\u001b[?2004h> "]
[136.714903, "o", "            level1_names[norm] = cat\r\n\u001b[?2004l\r"]
[136.714987, "o", "\u001b[?2004h> "]
[136.715064, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.715162, "o", "    # Keep top 18 for level 1\r\n\u001b[?2004l\r"]
[136.715284, "o", "\u001b[?2004h> "]
[136.715377, "o", "    level1_unified = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.715455, "o", "> "]
[136.715633, "o", "    for norm, count in level1_counts.most_common(18):\r\n\u001b[?2004l\r"]
[136.715717, "o", "\u001b[?2004h> "]
[136.715922, "o", "        level1_unified[norm] = level1_names[norm]\r\n\u001b[?2004l\r"]
[136.716013, "o", "\u001b[?2004h> "]
[136.7161, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.716195, "o", "    unified[1] = level1_unified\r\n\u001b[?2004l\r"]
[136.716288, "o", "\u001b[?2004h> "]
[136.716377, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.716607, "o", "    # Build levels 2-5 by analyzing parent-child relationships\r\n\u001b[?2004l\r"]
[136.716702, "o", "\u001b[?2004h> "]
[136.716814, "o", "    for level in range(2, 6):\r\n\u001b[?2004l\r"]
[136.716914, "o", "\u001b[?2004h> "]
[136.717295, "o", "        level_items = defaultdict(lambda: {'count': 0, 'name': '', 'parents': set()})\r\n\u001b[?2004l\r"]
[136.717396, "o", "\u001b[?2004h> "]
[136.717486, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.717584, "o", "        for entry in all_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.717829, "o", "            if level <= len(entry['parts']):\r\n\u001b[?2004l\r"]
[136.717922, "o", "\u001b[?2004h> "]
[136.718114, "o", "                cat = entry['parts'][level - 1]\r\n\u001b[?2004l\r"]
[136.71821, "o", "\u001b[?2004h> "]
[136.718463, "o", "                norm = normalize_text(cat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.718772, "o", "                parent = normalize_text(entry['parts'][level - 2])\r\n\u001b[?2004l\r"]
[136.7189, "o", "\u001b[?2004h> "]
[136.719001, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.719151, "o", "                level_items[norm]['count'] += 1\r\n\u001b[?2004l\r"]
[136.719251, "o", "\u001b[?2004h> "]
[136.719437, "o", "                if not level_items[norm]['name']:\r\n\u001b[?2004l\r"]
[136.719542, "o", "\u001b[?2004h> "]
[136.719735, "o", "                    level_items[norm]['name'] = cat\r\n\u001b[?2004l\r"]
[136.71983, "o", "\u001b[?2004h> "]
[136.720048, "o", "                level_items[norm]['parents'].add(parent)\r\n\u001b[?2004l\r"]
[136.720134, "o", "\u001b[?2004h> "]
[136.720213, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.720582, "o", "        # Filter to keep only items with parent in previous level or frequent items\r\n\u001b[?2004l\r"]
[136.72067, "o", "\u001b[?2004h> "]
[136.720759, "o", "        filtered_items = {}\r\n\u001b[?2004l\r"]
[136.720862, "o", "\u001b[?2004h> "]
[136.72105, "o", "        for norm, data in level_items.items():\r\n\u001b[?2004l\r"]
[136.721138, "o", "\u001b[?2004h> "]
[136.721534, "o", "            # Keep if parent is in previous level or if it's frequent enough\r\n\u001b[?2004l\r"]
[136.721625, "o", "\u001b[?2004h> "]
[136.721739, "o", "            if data['count'] >= 2:  # At least 2 occurrences\r\n\u001b[?2004l\r"]
[136.721826, "o", "\u001b[?2004h> "]
[136.721905, "o", "                filtered_items[norm] = data['name']\r\n\u001b[?2004l\r"]
[136.721985, "o", "\u001b[?2004h>         "]
[136.722065, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.722141, "o", "        # Keep top N items\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.722318, "o", "        sorted_items = sorted([(k, level_items[k]['count']) for k in filtered_items.keys()],\r\n\u001b[?2004l\r"]
[136.722407, "o", "\u001b[?2004h> "]
[136.722519, "o", "                             key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[136.722604, "o", "\u001b[?2004h> "]
[136.72272, "o", "        top_n = min(len(sorted_items), max(40, 12 * (6 - level)))\r\n\u001b[?2004l\r"]
[136.722804, "o", "\u001b[?2004h> "]
[136.72288, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.722957, "o", "        level_unified = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.723034, "o", "        for norm, _ in sorted_items[:top_n]:\r\n\u001b[?2004l\r"]
[136.723116, "o", "\u001b[?2004h> "]
[136.723207, "o", "            level_unified[norm] = filtered_items[norm]\r\n\u001b[?2004l\r"]
[136.723293, "o", "\u001b[?2004h> "]
[136.723372, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.72345, "o", "        unified[level] = level_unified\r\n\u001b[?2004l\r"]
[136.723532, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.723614, "o", "    return unified\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.723691, "o", "\u001b[?2004h> "]
[136.723797, "o", "def find_best_match(norm_cat: str, unified_level: Dict[str, str]) -> str:\r\n\u001b[?2004l\r"]
[136.723882, "o", "\u001b[?2004h> "]
[136.723965, "o", "    \"\"\"Find best matching category in unified level.\"\"\"\r\n\u001b[?2004l\r"]
[136.724048, "o", "\u001b[?2004h> "]
[136.724125, "o", "    if not unified_level:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724202, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.724281, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724357, "o", "    # Exact match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724435, "o", "    if norm_cat in unified_level:\r\n\u001b[?2004l\r"]
[136.724522, "o", "\u001b[?2004h> "]
[136.724601, "o", "        return unified_level[norm_cat]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724677, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724753, "o", "    # Prefix match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.724875, "o", "    for unified_norm, unified_name in unified_level.items():\r\n\u001b[?2004l\r"]
[136.724978, "o", "\u001b[?2004h> "]
[136.725135, "o", "        if norm_cat.startswith(unified_norm[:4]) or unified_norm.startswith(norm_cat[:4]):\r\n\u001b[?2004l\r"]
[136.725223, "o", "\u001b[?2004h> "]
[136.725304, "o", "            return unified_name\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[136.725392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Word overlap\r\n\u001b[?2004l\r"]
[136.725481, "o", "\u001b[?2004h> "]
[136.725582, "o", "    norm_words = set(norm_cat.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.72567, "o", "    best_match = None\r\n\u001b[?2004l\r\u001b[?2004h>     best_overlap = 0\r\n"]
[136.725758, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.725845, "o", "    for unified_norm in unified_level.keys():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.725933, "o", "        unified_words = set(unified_norm.split())\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.726024, "o", "> "]
[136.726116, "o", "        overlap = len(norm_words & unified_words)\r\n\u001b[?2004l\r"]
[136.726193, "o", "\u001b[?2004h> "]
[136.726273, "o", "        if overlap > best_overlap:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.726356, "o", "            best_overlap = overlap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.726472, "o", "            best_match = unified_norm\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.72651, "o", "> "]
[136.726538, "o", "    if best_match:\r\n\u001b[?2004l\r"]
[136.726574, "o", "\u001b[?2004h> "]
[136.726719, "o", "        return unified_level[best_match]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.726749, "o", "\u001b[?2004h> "]
[136.726851, "o", "    # Default: return first item\r\n\u001b[?2004l\r"]
[136.72688, "o", "\u001b[?2004h> "]
[136.72701, "o", "    return list(unified_level.values())[0] if unified_level else None\r\n\u001b[?2004l\r"]
[136.727038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.727065, "o", "\u001b[?2004h> "]
[136.727223, "o", "def map_category_to_unified(entry: Dict, unified: Dict) -> Dict:\r\n\u001b[?2004l\r"]
[136.727249, "o", "\u001b[?2004h> "]
[136.727385, "o", "    \"\"\"Map a single category to unified taxonomy.\"\"\"\r\n\u001b[?2004l\r"]
[136.727412, "o", "\u001b[?2004h> "]
[136.727475, "o", "    result = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.727527, "o", "> "]
[136.727593, "o", "        'source': entry['source'],\r\n\u001b[?2004l\r"]
[136.727619, "o", "\u001b[?2004h> "]
[136.727746, "o", "        'category_path': entry['original_path'],\r\n\u001b[?2004l\r"]
[136.727797, "o", "\u001b[?2004h> "]
[136.727951, "o", "        'depth': entry['depth']"]
[136.728083, "o", "\r\n\u001b[?2004l\r"]
[136.728286, "o", "\u001b[?2004h"]
[136.728394, "o", "> "]
[136.728478, "o", "    }"]
[136.728575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.728658, "o", ">     "]
[136.728737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.728909, "o", "> "]
[136.72909, "o", "    for level in range(1, 6):"]
[136.729159, "o", "\r\n"]
[136.72922, "o", "\u001b[?2004l\r"]
[136.729292, "o", "\u001b[?2004h"]
[136.729368, "o", "> "]
[136.729502, "o", "        if level <= len(entry['parts']):"]
[136.729561, "o", "\r\n"]
[136.729616, "o", "\u001b[?2004l\r"]
[136.729686, "o", "\u001b[?2004h"]
[136.729747, "o", "> "]
[136.729884, "o", "            cat = entry['parts'][level - 1]"]
[136.729938, "o", "\r\n"]
[136.729991, "o", "\u001b[?2004l\r"]
[136.730057, "o", "\u001b[?2004h"]
[136.73012, "o", "> "]
[136.730248, "o", "            norm = normalize_text(cat)"]
[136.730303, "o", "\r\n"]
[136.730368, "o", "\u001b[?2004l\r"]
[136.730438, "o", "\u001b[?2004h"]
[136.73051, "o", "> "]
[136.730693, "o", "            best_match = find_best_match(norm, unified[level])"]
[136.730754, "o", "\r\n"]
[136.730808, "o", "\u001b[?2004l\r"]
[136.730874, "o", "\u001b[?2004h"]
[136.730933, "o", "> "]
[136.731099, "o", "            result[f'unified_level_{level}'] = best_match"]
[136.731158, "o", "\r\n"]
[136.731213, "o", "\u001b[?2004l\r"]
[136.731282, "o", "\u001b[?2004h"]
[136.731351, "o", "> "]
[136.731441, "o", "        else:"]
[136.7315, "o", "\r\n"]
[136.731561, "o", "\u001b[?2004l\r"]
[136.731631, "o", "\u001b[?2004h"]
[136.731695, "o", "> "]
[136.73185, "o", "            result[f'unified_level_{level}'] = None"]
[136.731908, "o", "\r\n"]
[136.731964, "o", "\u001b[?2004l\r"]
[136.732032, "o", "\u001b[?2004h"]
[136.732094, "o", "> "]
[136.732162, "o", "    "]
[136.732216, "o", "\r\n"]
[136.732283, "o", "\u001b[?2004l\r"]
[136.732362, "o", "\u001b[?2004h"]
[136.73243, "o", "> "]
[136.732527, "o", "    return result"]
[136.732591, "o", "\r\n"]
[136.732655, "o", "\u001b[?2004l\r"]
[136.732731, "o", "\u001b[?2004h"]
[136.732817, "o", "> "]
[136.732898, "o", "\r\n"]
[136.732964, "o", "\u001b[?2004l\r"]
[136.733045, "o", "\u001b[?2004h"]
[136.733112, "o", "> "]
[136.733192, "o", "def main():"]
[136.733248, "o", "\r\n"]
[136.733303, "o", "\u001b[?2004l\r"]
