[427.078446, "o", "def get_machine_end_time(schedule, machine):\r\n\u001b[?2004l\r\u001b[?2004h>     return max([op['end'] for op in schedule if op['machine'] == machine] + [0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_job_op_end(schedule, job, op):\r\n\u001b[?2004l\r\u001b[?2004h>     for item in schedule:\r\n\u001b[?2004l\r\u001b[?2004h>         if item['job'] == job and item['op'] == op:\r\n\u001b[?2004l\r\u001b[?2004h>             return item['end']\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\r\n\u001b[?2004l\r\u001b[?2004h>     machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r\u001b[?2004h>     candidate_start = max(earliest_start, machine_available)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h>         candidate_end = candidate_start + duration\r\n\u001b[?2004l\r\u001b[?2004h>         if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\r\n\u001b[?2004l\r\u001b[?2004h>             return candidate_start\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for dt in downtimes:\r\n\u001b[?2004l\r\u001b[?2004h>             if dt['machine'] == machine:\r\n\u001b[?2004l\r\u001b[?2004h>                 if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\r\n\u001b[?2004l\r\u001b[?2004h>                     candidate_start = max(candidate_start, dt['end'])\r\n\u001b[?2004l\r\u001b[?2004h>                     machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r\u001b[?2004h> "]
