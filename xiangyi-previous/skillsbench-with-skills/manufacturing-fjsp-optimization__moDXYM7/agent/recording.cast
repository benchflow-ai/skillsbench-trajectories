[360.880786, "o", ">                 \r\n\u001b[?2004l\r"]
[360.880821, "o", "\u001b[?2004h> "]
[360.880903, "o", "                new_schedule.append({\r\n\u001b[?2004l\r"]
[360.880935, "o", "\u001b[?2004h> "]
[360.880998, "o", "                    'job': job,\r\n\u001b[?2004l\r"]
[360.881033, "o", "\u001b[?2004h> "]
[360.881096, "o", "                    'op': op,\r\n\u001b[?2004l\r"]
[360.88113, "o", "\u001b[?2004h> "]
[360.881289, "o", "                    'machine': chosen['machine'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.881344, "o", "                    'start': chosen['start'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.88138, "o", "> "]
[360.88144, "o", "                    'end': chosen['end'],\r\n\u001b[?2004l\r"]
[360.88148, "o", "\u001b[?2004h> "]
[360.881609, "o", "                    'dur': chosen['duration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.881654, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.881686, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.88172, "o", "> "]
[360.881912, "o", "                mc_str = 'MC' if chosen['machine_changed'] else '  '\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.8824, "o", "                print(f\"J{job}O{op}: {mc_str} M{chosen['machine']} [{chosen['start']:2d}-{chosen['end']:2d}] (was M{baseline_op['machine']} [{baseline_op['start']:2d}-{baseline_op['end']:2d}]) shift:{chosen['start_shift']:2d}\")"]
[360.88364, "o", "\r\n\u001b[?2004l\r"]
[360.883691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.883727, "o", "\u001b[?2004h> "]
