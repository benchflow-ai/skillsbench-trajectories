[568.390991, "o", "                # Always find at least one candidate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.391111, "o", "                best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.391218, "o", "                best_score = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.391329, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.391442, "o", "                for opt in jobs[job][op]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.391593, "o", "                    machine = opt['machine']\r\n\u001b[?2004l\r"]
[568.391735, "o", "\u001b[?2004h> "]
[568.391856, "o", "                    duration = opt['duration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.395616, "o", "                    start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\r\n\u001b[?2004l\r\u001b[?2004h>                     end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     machine_changed = (machine != baseline_op['machine'])\r\n\u001b[?2004l\r\u001b[?2004h>                     start_shift = abs(start - baseline_op['start'])\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     # Prefer options within budget, but allow exceeding if necessary\r\n\u001b[?2004l\r\u001b[?2004h>                     mc_penalty = 1000 if (machine_changed and machine_changes >= max_machine_changes) else 0\r\n\u001b[?2004l\r\u001b[?2004h>                     shift_penalty = 500 if (total_start_shift + start_shift > max_start_shift) else 0\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     score = end + mc_penalty + shift_penalty\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     if score < best_score:\r\n\u001b[?2004l\r\u001b[?2004h>                         best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.396032, "o", "                        best = {\r\n\u001b[?2004l\r"]
[568.396155, "o", "\u001b[?2004h> "]
[568.396238, "o", "                            'machine': machine,\r\n\u001b[?2004l\r"]
[568.396319, "o", "\u001b[?2004h> "]
[568.396393, "o", "                            'duration': duration,\r\n\u001b[?2004l\r"]
[568.396477, "o", "\u001b[?2004h> "]
[568.39657, "o", "                            'start': start,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.39667, "o", "                            'end': end,\r\n\u001b[?2004l\r"]
[568.396759, "o", "\u001b[?2004h> "]
[568.396933, "o", "                            'machine_changed': machine_changed,"]
[568.397028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.39712, "o", "> "]
[568.397241, "o", "                            'start_shift': start_shift\r\n\u001b[?2004l\r"]
[568.397332, "o", "\u001b[?2004h> "]
[568.397479, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[568.397591, "o", "\u001b[?2004h>                 if best:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.39773, "o", "                    if best['machine_changed']:\r\n\u001b[?2004l\r"]
[568.397834, "o", "\u001b[?2004h> "]
[568.397917, "o", "                        machine_changes += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.398155, "o", "                    total_start_shift += best['start_shift']\r\n\u001b[?2004l\r"]
[568.398251, "o", "\u001b[?2004h> "]
[568.398331, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.398442, "o", "                    new_schedule.append({\r\n\u001b[?2004l\r"]
[568.398531, "o", "\u001b[?2004h> "]
[568.39861, "o", "                        'job': job,\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.398688, "o", "> "]
[568.398766, "o", "                        'op': op,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.398908, "o", "                        'machine': best['machine'],\r\n\u001b[?2004l\r"]
[568.398998, "o", "\u001b[?2004h> "]
[568.399089, "o", "                        'start': best['start'],\r\n\u001b[?2004l\r"]
[568.399179, "o", "\u001b[?2004h> "]
[568.399258, "o", "                        'end': best['end'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.399335, "o", "> "]
[568.399412, "o", "                        'dur': best['duration']\r\n\u001b[?2004l\r"]
[568.399489, "o", "\u001b[?2004h> "]
[568.399607, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.399753, "o", "makespan = max(op['end'] for op in new_schedule)\r\n\u001b[?2004l\r"]
[568.39986, "o", "\u001b[?2004h> "]
[568.400063, "o", "violations = sum(1 for op in new_schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes))\r\n\u001b[?2004l\r"]
[568.400175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.400287, "o", "print(f\"Makespan: {makespan} (max: {max_makespan})\")\r\n\u001b[?2004l\r"]
[568.400392, "o", "\u001b[?2004h> "]
[568.40052, "o", "print(f\"Machine changes: {machine_changes} (max: {max_machine_changes})\")\r\n\u001b[?2004l\r"]
[568.40063, "o", "\u001b[?2004h> "]
[568.400745, "o", "print(f\"Total start shift: {total_start_shift} (max: {max_start_shift})\")\r\n\u001b[?2004l\r"]
[568.400845, "o", "\u001b[?2004h> "]
[568.400939, "o", "print(f\"Downtime violations: {violations}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.401055, "o", "print(f\"Operations: {len(new_schedule)}/12\\n\")\r\n\u001b[?2004l\r"]
[568.401161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.40131, "o", "for op in sorted(new_schedule, key=lambda x: (x['job'], x['op'])):\r\n\u001b[?2004l\r"]
[568.401417, "o", "\u001b[?2004h> "]
[568.40151, "o", "    bl = baseline_dict[(op['job'], op['op'])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.40166, "o", "    mc = 'MC' if op['machine'] != bl['machine'] else '  '\r\n\u001b[?2004l\r"]
[568.401768, "o", "\u001b[?2004h> "]
[568.402088, "o", "    print(f\"{mc} J{op['job']}O{op['op']}: M{op['machine']} [{op['start']:2d}-{op['end']:2d}] (was M{bl['machine']} [{bl['start']:2d}-{bl['end']:2d}])\")\r\n\u001b[?2004l\r"]
[568.402201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.402571, "o", "if len(new_schedule) == 12 and violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= max_makespan:\r\n\u001b[?2004l\r"]
[568.402679, "o", "\u001b[?2004h> "]
[568.402773, "o", "    print(\"\\n*** SOLUTION IS FEASIBLE! ***\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.402866, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     solution = {\r\n\u001b[?2004l\r"]
[568.402958, "o", "\u001b[?2004h> "]
[568.40305, "o", "        'status': 'feasible',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.403149, "o", "        'makespan': makespan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.403372, "o", "        'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r"]
[568.403478, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[568.403612, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.403715, "o", "    with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.403874, "o", ">         json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.403986, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.404113, "o", "    with open('/app/output/schedule.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[568.404215, "o", "\u001b[?2004h> "]
[568.404394, "o", "        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\r\n\u001b[?2004l\r"]
[568.404485, "o", "\u001b[?2004h> "]
[568.404573, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[568.404675, "o", "        for op in solution['schedule']:\r\n\u001b[?2004l\r"]
[568.404801, "o", "\u001b[?2004h> "]
[568.404902, "o", "            writer.writerow(op)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[568.404988, "o", "> "]
[568.405075, "o", "    print(\"Solution saved to /app/output/\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[568.405156, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> ENDOFPYTHON\r\n"]
[568.405235, "o", "\u001b[?2004l\r"]
[568.436226, "o", "Simple greedy: minimize end time, ensure all ops scheduled\r\n\r\n"]
