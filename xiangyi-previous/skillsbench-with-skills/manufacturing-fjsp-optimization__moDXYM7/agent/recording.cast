[466.955426, "o", "    for item in schedule:\r\n\u001b[?2004l\r"]
[466.955549, "o", "\u001b[?2004h> "]
[466.955734, "o", "        if item['job'] == job and item['op'] == op:\r\n\u001b[?2004l\r"]
[466.955773, "o", "\u001b[?2004h> "]
[466.95598, "o", "            return item['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[466.956062, "o", "    return 0\r\n\u001b[?2004l\r"]
[466.956107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[466.956151, "o", "\u001b[?2004h> "]
