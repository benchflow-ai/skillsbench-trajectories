[168.897441, "o", "Job 0 Op 0: FROZEN at M1 [0-5]\r\nJob 0 Op 1: FROZEN at M2 [5-11]\r\nJob 0 Op 2: RESCHEDULED to M0 [11-16] (was M0 [24-29])\r\nJob 1 Op 0: FROZEN at M0 [0-5]\r\n"]
[168.897816, "o", "Job 1 Op 1: RESCHEDULED to M1 [20-26] (was M1 [9-15])\r\nJob 1 Op 2: RESCHEDULED to M0 [26-33] (was M0 [29-36])\r\nJob 2 Op 0: RESCHEDULED to M2 [25-31] (was M1 [5-9])\r\nJob 2 Op 1: RESCHEDULED to M1 [31-38] (was M0 [16-24])\r\nJob 2 Op 2: RESCHEDULED to M0 [38-44] (was M2 [11-16])\r\nJob 3 Op 0: FROZEN at M0 [5-12]\r\nJob 3 Op 1: RESCHEDULED to M2 [31-38] (was M1 [15-20])\r\nJob 3 Op 2: RESCHEDULED to M2 [38-44] (was M2 [20-26])\r\n\r\nMakespan: 44\r\nMachine changes: 4 (max: 4)\r\nTotal start shift: 123 (max: 120)\r\nMax allowed makespan: 39\r\n\r\nDowntime violations: 0\r\nSolution NOT feasible - need to adjust\r\n"]
[168.901694, "o", "\u001b[?2004hroot@5519cd689504:/app# "]
[206.220829, "i", "python3 << 'ENDOFPYTHON'\nimport json\nimport csv\nfrom copy import deepcopy\n\n# Read all input files\nwith open('/app/data/instance.txt', 'r') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({'machine': machine, 'duration': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nwith open('/app/data/downtime.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    downtimes = [{'machine': int(row['machine']), 'start': int(row['start']), 'end': int(row['end'])} for row in reader]\n\nwith open('/app/data/policy.json', 'r') as f:\n    policy = json.load(f)\n\nwith open('/app/data/baseline_solution.json', 'r') as f:\n    baseline = json.load(f)\n\nfreeze_until = policy['freeze']['freeze_until']\nmax_machine_changes = policy['change_budget']['max_machine_changes']\nmax_start_shift = policy['change_budget']['max_total_start_shift_L1']\nmax_makespan_ratio = policy['guards']['max_makespan_ratio']\n\ndef overlaps_downtime(machine, start, end, downtimes):\n    for dt in downtimes:\n        if dt['machine'] == machine:\n            if not (end <= dt['start'] or start >= dt['end']):\n                return True\n    return False\n\ndef get_machine_end_time(schedule, machine):\n    max_end = 0\n    for op in schedule:\n        if op['machine'] == machine and op['end'] > max_end:\n            max_end = op['end']\n    return max_end\n\ndef get_job_op_end(schedule, job, op):\n    for item in schedule:\n        if item['job'] == job and item['op'] == op:\n            return item['end']\n    return 0\n\ndef find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\n    \"\"\"Find earliest valid start time on a machine avoiding downtime\"\"\"\n    machine_available = get_machine_end_time(schedule, machine)\n    candidate_start = max(earliest_start, machine_available)\n    \n    # Keep trying until we find a valid slot\n    max_iterations = 100\n    for _ in range(max_iterations):\n        candidate_end = candidate_start + duration\n        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\n            return candidate_start\n        \n        # Find the downtime we're overlapping with and skip past it\n        for dt in downtimes:\n            if dt['machine'] == machine:\n                if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\n                    candidate_start = max(candidate_start, dt['end'])\n                    machine_available = get_machine_end_time(schedule, machine)\n                    candidate_start = max(candidate_start, machine_available)\n                    break\n    \n    return candidate_start\n\n# Build new schedule with better heuristics\nnew_schedule = []\nbaseline_dict = {(op['job'], op['op']): op for op in baseline['schedule']}\n\nmachine_changes = 0\ntotal_start_shift = 0\n\n# Process all operations in order\nfor job in range(num_jobs):\n    for op in range(num_ops_per_job):\n        baseline_op = baseline_dict[(job, op)]\n        \n        # Determine earliest start time (precedence constraint)\n        if op == 0:\n            earliest_start = 0\n        else:\n            earliest_start = get_job_op_end(new_schedule, job, op - 1)\n        \n        # Check if operation is frozen\n        is_frozen = baseline_op['start'] < freeze_until\n        \n        # Check if baseline violates downtime\n        violates = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtimes)\n        \n        if is_frozen and not violates:\n            # Keep as is\n            new_schedule.append(deepcopy(baseline_op))\n        else:\n            # Need to reschedule - try to minimize changes\n            best_option = None\n            best_score = floa"]
[206.221417, "i", "t('inf')\n            \n            for opt in jobs[job][op]:\n                machine = opt['machine']\n                duration = opt['duration']\n                \n                # Find earliest valid start time on this machine\n                candidate_start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                \n                # Calculate score: prioritize keeping same machine and minimizing start shift\n                machine_changed = (machine != baseline_op['machine'])\n                start_shift = abs(candidate_start - baseline_op['start'])\n                \n                # Score: heavily penalize machine changes if we're near the limit\n                # Also consider the end time (makespan)\n                if machine_changes >= max_machine_changes and machine_changed:\n                    continue  # Can't use this option\n                \n                score = candidate_start + duration  # Minimize end time (makespan)\n                score += start_shift * 0.5  # Also consider start shift\n                if machine_changed:\n                    score += 100  # Penalize machine changes\n                \n                if score < best_score:\n                    best_score = score\n                    best_option = {\n                        'machine': machine,\n                        'duration': duration,\n                        'start': candidate_start,\n                        'machine_changed': machine_changed,\n                        'start_shift': start_shift\n                    }\n            \n            if best_option:\n                if best_option['machine_changed']:\n                    machine_changes += 1\n                \n                total_start_shift += best_option['start_shift']\n                \n                new_op = {\n                    'job': job,\n                    'op': op,\n                    'machine': best_option['machine'],\n                    'start': best_option['start'],\n                    'end': best_option['start'] + best_option['duration'],\n                    'dur': best_option['duration']\n                }\n                new_schedule.append(new_op)\n\nmakespan = max(op['end'] for op in new_schedule)\nprint(f\"Makespan: {makespan} (max: {int(36 * max_makespan_ratio)})\")\nprint(f\"Machine changes: {machine_changes} (max: {max_machine_changes})\")\nprint(f\"Total start shift: {total_start_shift} (max: {max_start_shift})\")\n\n# Verify no downtime violations\nviolations = 0\nfor op in new_schedule:\n    if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes):\n        violations += 1\n\nprint(f\"Downtime violations: {violations}\")\n\nif violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= int(36 * max_makespan_ratio):\n    print(\"\\nSolution is FEASIBLE!\")\n    \n    solution = {\n        'status': 'feasible',\n        'makespan': makespan,\n        'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w', newline='') as f:\n        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        writer.writeheader()\n        for op in solution['schedule']:\n            writer.writerow(op)\n    \n    print(\"Solution saved!\")\nelse:\n    print(\"\\nStill not feasible - trying alternative approach...\")\n\nENDOFPYTHON\n"]
