[279.44075, "o", "    downtimes = [{'machine': int(row['machine']), 'start': int(row['start']), 'end': int(row['end'])} for row in reader]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data/policy.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     policy = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.440832, "o", "> "]
[279.441101, "o", "with open('/app/data/baseline_solution.json', 'r') as f:\r\n\u001b[?2004l\r"]
[279.441177, "o", "\u001b[?2004h> "]
[279.441307, "o", "    baseline = json.load(f)\r\n\u001b[?2004l\r"]
[279.441377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.441637, "o", "freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r"]
[279.441705, "o", "\u001b[?2004h> "]
[279.442041, "o", "max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r"]
[279.442116, "o", "\u001b[?2004h> "]
[279.442459, "o", "max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r"]
[279.442532, "o", "\u001b[?2004h> "]
[279.442848, "o", "max_makespan_ratio = policy['guards']['max_makespan_ratio']\r\n\u001b[?2004l\r"]
[279.442926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.443242, "o", "def overlaps_downtime(machine, start, end, downtimes):\r\n\u001b[?2004l\r"]
[279.443323, "o", "\u001b[?2004h> "]
[279.443432, "o", "    for dt in downtimes:\r\n\u001b[?2004l\r"]
[279.443513, "o", "\u001b[?2004h> "]
[279.443718, "o", "        if dt['machine'] == machine:\r\n\u001b[?2004l\r"]
[279.443795, "o", "\u001b[?2004h> "]
[279.44411, "o", "            if not (end <= dt['start'] or start >= dt['end']):\r\n\u001b[?2004l\r"]
[279.444192, "o", "\u001b[?2004h> "]
[279.444321, "o", "                return True\r\n\u001b[?2004l\r"]
[279.444394, "o", "\u001b[?2004h> "]
[279.444483, "o", "    return False\r\n\u001b[?2004l\r"]
[279.44456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.444865, "o", "def get_machine_end_time(schedule, machine):\r\n\u001b[?2004l\r"]
[279.44495, "o", "\u001b[?2004h> "]
[279.445131, "o", "    max_end = 0\r\n\u001b[?2004l\r"]
[279.44521, "o", "\u001b[?2004h> "]
[279.445308, "o", "    for op in schedule:\r\n\u001b[?2004l\r"]
[279.445388, "o", "\u001b[?2004h> "]
[279.4457, "o", "        if op['machine'] == machine and op['end'] > max_end:\r\n\u001b[?2004l\r"]
[279.445779, "o", "\u001b[?2004h> "]
[279.445967, "o", "            max_end = op['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.44618, "o", "    return max_end\r\n\u001b[?2004l\r"]
[279.446276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.446355, "o", "> "]
[279.446533, "o", "def get_job_op_end(schedule, job, op):\r\n\u001b[?2004l\r"]
[279.446616, "o", "\u001b[?2004h> "]
[279.446755, "o", "    for item in schedule:\r\n\u001b[?2004l\r"]
[279.446838, "o", "\u001b[?2004h> "]
[279.447098, "o", "        if item['job'] == job and item['op'] == op:\r\n\u001b[?2004l\r"]
[279.447175, "o", "\u001b[?2004h> "]
[279.447325, "o", "            return item['end']\r\n\u001b[?2004l\r"]
[279.44741, "o", "\u001b[?2004h> "]
[279.447484, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.447584, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.448039, "o", "def find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\r\n\u001b[?2004l\r"]
[279.44811, "o", "\u001b[?2004h> "]
[279.448345, "o", "    machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r"]
[279.448419, "o", "\u001b[?2004h> "]
[279.448642, "o", "    candidate_start = max(earliest_start, machine_available)\r\n\u001b[?2004l\r"]
[279.44871, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.44878, "o", "\u001b[?2004h> "]
[279.448855, "o", "    max_iterations = 100\r\n\u001b[?2004l\r"]
[279.448927, "o", "\u001b[?2004h> "]
[279.449057, "o", "    for _ in range(max_iterations):\r\n\u001b[?2004l\r"]
[279.44912, "o", "\u001b[?2004h> "]
[279.449306, "o", "        candidate_end = candidate_start + duration\r\n\u001b[?2004l\r"]
[279.449373, "o", "\u001b[?2004h> "]
[279.449694, "o", "        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\r\n\u001b[?2004l\r"]
[279.449764, "o", "\u001b[?2004h> "]
[279.449892, "o", "            return candidate_start\r\n\u001b[?2004l\r"]
[279.44996, "o", "\u001b[?2004h>         "]
[279.450025, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.450152, "o", "        for dt in downtimes:\r\n\u001b[?2004l\r"]
[279.450223, "o", "\u001b[?2004h> "]
[279.450362, "o", "            if dt['machine'] == machine:\r\n\u001b[?2004l\r"]
[279.450428, "o", "\u001b[?2004h> "]
[279.450748, "o", "                if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\r\n\u001b[?2004l\r"]
[279.450815, "o", "\u001b[?2004h> "]
[279.451071, "o", "                    candidate_start = max(candidate_start, dt['end'])\r\n\u001b[?2004l\r"]
[279.451137, "o", "\u001b[?2004h> "]
[279.451449, "o", "                    machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r"]
[279.451531, "o", "\u001b[?2004h> "]
[279.451851, "o", "                    candidate_start = max(candidate_start, machine_available)\r\n\u001b[?2004l\r"]
[279.451921, "o", "\u001b[?2004h> "]
[279.452015, "o", "                    break\r\n\u001b[?2004l\r"]
[279.452077, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.452147, "o", "\u001b[?2004h> "]
[279.452251, "o", "    return candidate_start\r\n\u001b[?2004l\r"]
[279.452328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452625, "o", "baseline_dict = {(op['job'], op['op']): op for op in baseline['schedule']}\r\n\u001b[?2004l\r"]
[279.452698, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.452936, "o", "# New strategy: prioritize minimizing end time (makespan)\r\n\u001b[?2004l\r"]
[279.45301, "o", "\u001b[?2004h> "]
[279.453082, "o", "new_schedule = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453179, "o", "machine_changes = 0\r\n\u001b[?2004l\r"]
[279.453253, "o", "\u001b[?2004h> "]
[279.453323, "o", "total_start_shift = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453395, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.453495, "o", "for job in range(num_jobs):\r\n\u001b[?2004l\r"]
[279.453567, "o", "\u001b[?2004h> "]
[279.453694, "o", "    for op in range(num_ops_per_job):\r\n\u001b[?2004l\r"]
[279.453763, "o", "\u001b[?2004h> "]
[279.453926, "o", "        baseline_op = baseline_dict[(job, op)]\r\n\u001b[?2004l\r"]
[279.453998, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.454064, "o", "\u001b[?2004h> "]
[279.454136, "o", "        if op == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.454205, "o", "> "]
[279.454286, "o", "            earliest_start = 0\r\n\u001b[?2004l\r"]
[279.454355, "o", "\u001b[?2004h> "]
[279.454425, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.454704, "o", "            earliest_start = get_job_op_end(new_schedule, job, op - 1)\r\n\u001b[?2004l\r"]
[279.454778, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.454914, "o", "\u001b[?2004h> "]
[279.455199, "o", "        is_frozen = baseline_op['start'] < freeze_until\r\n\u001b[?2004l\r"]
[279.455299, "o", "\u001b[?2004h> "]
[279.455465, "o", "        violates = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtimes)"]
[279.455554, "o", "\r\n\u001b[?2004l\r"]
[279.455632, "o", "\u001b[?2004h>         "]
[279.455704, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.455792, "o", "        if is_frozen and not violates:"]
[279.45587, "o", "\r\n\u001b[?2004l\r"]
[279.455941, "o", "\u001b[?2004h> "]
[279.456092, "o", "            new_schedule.append(deepcopy(baseline_op))"]
[279.458721, "o", "\r\n\u001b[?2004l\r"]
[279.458823, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[279.4589, "o", "\u001b[?2004h> "]
[279.458976, "o", "            options_with_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.459049, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.459138, "o", "            for opt in jobs[job][op]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.45921, "o", "> "]
[279.459281, "o", "                machine = opt['machine']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.459352, "o", "> "]
[279.459424, "o", "                duration = opt['duration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.45968, "o", "                start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\r\n\u001b[?2004l\r"]
[279.459762, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[279.459839, "o", "\u001b[?2004h> "]
[279.463598, "o", "                machine_changed = (machine != baseline_op['machine'])\r\n\u001b[?2004l\r\u001b[?2004h>                 start_shift = abs(start - baseline_op['start'])\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 if machine_changed and machine_changes >= max_machine_changes:\r\n\u001b[?2004l\r\u001b[?2004h>                     continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 # Check if this would exceed start shift budget\r\n\u001b[?2004l\r\u001b[?2004h>                 if total_start_shift + start_shift > max_start_shift:\r\n\u001b[?2004l\r\u001b[?2004h>                     continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 options_with_times.append({\r\n\u001b[?2004l\r\u001b[?2004h>                     'machine': machine,\r\n\u001b[?2004l\r\u001b[?2004h>                     'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h>                     'start': start,\r\n\u001b[?2004l\r\u001b[?2004h>                     'end': start + duration,\r\n\u001b[?2004l\r\u001b[?2004h>                     'machine_changed': machine_changed,\r\n\u001b[?2004l\r\u001b[?2004h>                     'start_shift': start_shift\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Sort by: 1) earliest end time (minimize makespan), 2) smallest start shift\r\n\u001b[?2004l\r\u001b[?2004h>             options_with_times.sort(key=lambda x: (x['end'], x['start_shift'], x['machine_changed']))\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if options_with_times:\r\n\u001b[?2004l\r\u001b[?2004h>                 chosen = options_with_times[0]\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 if chosen['machine_changed']:\r\n\u001b[?2004l\r\u001b[?2004h>                     machine_changes += 1\r\n\u001b[?2004l\r\u001b[?2004h>                 total_start_shift += chosen['start_shift']\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 new_op = {\r\n\u001b[?2004l\r\u001b[?2004h>                     'job': job,\r\n\u001b[?2004l\r\u001b[?2004h>                     'op': op,\r\n\u001b[?2004l\r\u001b[?2004h>                     'machine': chosen['machine'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.463734, "o", ">                     'start': chosen['start'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.463804, "o", "                    'end': chosen['end'],\r\n\u001b[?2004l\r"]
[279.463885, "o", "\u001b[?2004h> "]
[279.463964, "o", "                    'dur': chosen['duration']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.464038, "o", ">                 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.464108, "o", "> "]
[279.464179, "o", "                new_schedule.append(new_op)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.464252, "o", ">                 \r\n\u001b[?2004l\r"]
[279.464414, "o", "\u001b[?2004h> "]
[279.464533, "o", "                if chosen['machine_changed'] or chosen['start_shift'] > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.465006, "o", "                    print(f\"Job {job} Op {op}: M{chosen['machine']} [{chosen['start']}-{chosen['end']}] (was M{baseline_op['machine']} [{baseline_op['start']}-{baseline_op['end']}]) - MC:{chosen['machine_changed']}, shift:{chosen['start_shift']}\")\r\n\u001b[?2004l\r"]
[279.465143, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.465259, "o", "makespan = max(op['end'] for op in new_schedule)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.465472, "o", "violations = sum(1 for op in new_schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes))\r\n\u001b[?2004l\r"]
[279.465598, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.465703, "o", "print(f\"\\nMakespan: {makespan} (max: {int(36 * max_makespan_ratio)})\")\r\n\u001b[?2004l\r"]
[279.465821, "o", "\u001b[?2004h> "]
[279.466113, "o", "print(f\"Machine changes: {machine_changes} (max: {max_machine_changes})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.466246, "o", "print(f\"Total start shift: {total_start_shift} (max: {max_start_shift})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.466355, "o", "print(f\"Downtime violations: {violations}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[279.466463, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[279.466714, "o", "if violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= int(36 * max_makespan_ratio):\r\n\u001b[?2004l\r"]
[279.466825, "o", "\u001b[?2004h>     print(\"\\nSolution is FEASIBLE!\")\r\n"]
[279.466946, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.467053, "o", "    solution = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.467156, "o", "        'status': 'feasible',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.467262, "o", "        'makespan': makespan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.46742, "o", "        'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r"]
[279.467548, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.468098, "o", "\u001b[?2004h> "]
[279.468254, "o", "    with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.46838, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r"]
[279.4685, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.468614, "o", "> "]
[279.468738, "o", "    with open('/app/output/schedule.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[279.469015, "o", "\u001b[?2004h> "]
[279.469176, "o", "        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\r\n\u001b[?2004l\r"]
[279.469311, "o", "\u001b[?2004h> "]
[279.469441, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.469559, "o", "        for op in solution['schedule']:\r\n\u001b[?2004l\r"]
[279.469678, "o", "\u001b[?2004h> "]
[279.469905, "o", "            writer.writerow(op)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.470118, "o", "\u001b[?2004h>     print(\"Solution saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.470267, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.470442, "o", "    print(\"\\nStill not feasible. Let me analyze the schedule more carefully...\")\r\n\u001b[?2004l\r"]
[279.470567, "o", "\u001b[?2004h> "]
[279.470682, "o", "    print(\"\\nSchedule details:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.470854, "o", "    for op in sorted(new_schedule, key=lambda x: x['start']):\r\n\u001b[?2004l\r"]
[279.470975, "o", "\u001b[?2004h> "]
[279.471106, "o", "        baseline_op = baseline_dict[(op['job'], op['op'])]\r\n\u001b[?2004l\r"]
[279.471231, "o", "\u001b[?2004h> "]
[279.471645, "o", "        print(f\"  Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}] (baseline: M{baseline_op['machine']} [{baseline_op['start']}-{baseline_op['end']}])\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.47179, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFPYTHON\r\n\u001b[?2004l\r"]
[279.501876, "o", "Job 0 Op 2: M0 [11-16] (was M0 [24-29]) - MC:False, shift:13\r\nJob 1 Op 1: M1 [20-26] (was M1 [9-15]) - MC:False, shift:11\r\n"]
[279.502223, "o", "Job 1 Op 2: M0 [26-33] (was M0 [29-36]) - MC:False, shift:3\r\nJob 2 Op 0: M1 [26-30] (was M1 [5-9]) - MC:False, shift:21\r\nJob 2 Op 1: M1 [30-37] (was M0 [16-24]) - MC:True, shift:14\r\nJob 2 Op 2: M2 [37-42] (was M2 [11-16]) - MC:False, shift:26\r\nJob 3 Op 1: M1 [37-42] (was M1 [15-20]) - MC:False, shift:22\r\n\r\nMakespan: 42 (max: 39)\r\nMachine changes: 1 (max: 4)\r\nTotal start shift: 110 (max: 120)\r\nDowntime violations: 0\r\n\r\nStill not feasible. Let me analyze the schedule more carefully...\r\n\r\nSchedule details:\r\n  Job 0 Op 0: M1 [0-5] (baseline: M1 [0-5])\r\n  Job 1 Op 0: M0 [0-5] (baseline: M0 [0-5])\r\n  Job 0 Op 1: M2 [5-11] (baseline: M2 [5-11])\r\n  Job 3 Op 0: M0 [5-12] (baseline: M0 [5-12])\r\n  Job 0 Op 2: M0 [11-16] (baseline: M0 [24-29])\r\n  Job 1 Op 1: M1 [20-26] (baseline: M1 [9-15])\r\n  Job 1 Op 2: M0 [26-33] (baseline: M0 [29-36])\r\n  Job 2 Op 0: M1 [26-30] (baseline: M1 [5-9])\r\n  Job 2 Op 1: M1 [30-37] (baseline: M0 [16-24])\r\n  Job 2 Op 2: M2 [37-42] (baseline: M2 [11-16])\r\n  Job 3 Op 1: M1 [37-42] (baseline: M1 [15-20])\r\n"]
