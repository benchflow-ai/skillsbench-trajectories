[427.160684, "o", "Strategy: Aggressively use machine changes to minimize makespan\r\n\r\n"]
[427.160877, "o", "Makespan: 46 (max: 39)\r\nMachine changes: 2 (max: 4)\r\nTotal start shift: 132 (max: 120)\r\nDowntime violations: 0\r\n   J0O0: M1 [ 0- 5] (was M1 [ 0- 5])\r\n   J0O1: M2 [ 5-11] (was M2 [ 5-11])\r\n   J0O2: M0 [11-16] (was M0 [24-29])\r\n   J1O0: M0 [ 0- 5] (was M0 [ 0- 5])\r\n   J1O1: M1 [20-26] (was M1 [ 9-15])\r\n   J1O2: M0 [26-33] (was M0 [29-36])\r\n   J2O0: M1 [26-30] (was M1 [ 5- 9])\r\nMC J2O1: M1 [30-37] (was M0 [16-24])\r\n"]
[427.161012, "o", "   J2O2: M2 [37-42] (was M2 [11-16])\r\n   J3O0: M0 [ 5-12] (was M0 [ 5-12])\r\n   J3O1: M1 [37-42] (was M1 [15-20])\r\nMC J3O2: M0 [42-46] (was M2 [20-26])\r\n\r\nNeed to try different machine assignments...\r\n"]
