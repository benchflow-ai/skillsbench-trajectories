[63.799806, "o", "Jobs: 4, Ops per job: 3\r\nJob 0:\r\n  Op 0: [{'machine': 0, 'duration': 6}, {'machine': 1, 'duration': 5}]"]
[63.800339, "o", "\r\n  Op 1: [{'machine': 1, 'duration': 7}, {'machine': 2, 'duration': 6}]\r\n  Op 2: [{'machine': 0, 'duration': 5}, {'machine': 2, 'duration': 8}]\r\nJob 1:\r\n  Op 0: [{'machine': 0, 'duration': 5}, {'machine': 2, 'duration': 7}]\r\n  Op 1: [{'machine': 1, 'duration': 6}, {'machine': 2, 'duration': 5}]\r\n  Op 2: [{'machine': 0, 'duration': 7}, {'machine': 1, 'duration': 8}]\r\nJob 2:\r\n  Op 0: [{'machine': 1, 'duration': 4}, {'machine': 2, 'duration': 6}]\r\n  Op 1: [{'machine': 0, 'duration': 8}, {'machine': 1, 'duration': 7}]\r\n  Op 2: [{'machine': 0, 'duration': 6}, {'machine': 2, 'duration': 5}]\r\nJob 3:\r\n  Op 0: [{'machine': 0, 'duration': 7}, {'machine': 1, 'duration': 6}]\r\n  Op 1: [{'machine': 1, 'duration': 5}, {'machine': 2, 'duration': 7}]\r\n  Op 2: [{'machine': 0, 'duration': 4}, {'machine': 2, 'duration': 6}]\r\n\r\nDowntimes: [{'machine': 1, 'start': 5, 'end': 20}, {'machine': 2, 'start': 12, 'end': 25}]\r\n"]
[63.805972, "o", "\u001b[?2004hroot@5519cd689504:/app# "]
[78.166013, "i", "python3 << 'EOF'\nimport json\nimport csv\nfrom copy import deepcopy\n\n# Read all input files\nwith open('/app/data/instance.txt', 'r') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({'machine': machine, 'duration': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nwith open('/app/data/downtime.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    downtimes = [{'machine': int(row['machine']), 'start': int(row['start']), 'end': int(row['end'])} for row in reader]\n\nwith open('/app/data/policy.json', 'r') as f:\n    policy = json.load(f)\n\nwith open('/app/data/baseline_solution.json', 'r') as f:\n    baseline = json.load(f)\n\nwith open('/app/data/baseline_metrics.json', 'r') as f:\n    metrics = json.load(f)\n\nprint(\"Baseline schedule:\")\nfor op in baseline['schedule']:\n    print(f\"  Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")\n\nprint(f\"\\nBaseline makespan: {metrics['baseline']['makespan']}\")\nprint(f\"Downtime violations: {metrics['baseline']['downtime_violations']}\")\nprint(f\"\\nPolicy: {json.dumps(policy, indent=2)}\")\n\nEOF\n"]
