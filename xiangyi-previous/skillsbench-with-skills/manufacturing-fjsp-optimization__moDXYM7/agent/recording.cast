[63.759629, "i", "python3 << 'EOF'\nimport json\nimport csv\nfrom copy import deepcopy\n\n# Read instance\nwith open('/app/data/instance.txt', 'r') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({'machine': machine, 'duration': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nprint(f\"Jobs: {num_jobs}, Ops per job: {num_ops_per_job}\")\nfor j, job in enumerate(jobs):\n    print(f\"Job {j}:\")\n    for o, options in enumerate(job):\n        print(f\"  Op {o}: {options}\")\n\n# Read downtime\ndowntimes = []\nwith open('/app/data/downtime.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        downtimes.append({\n            'machine': int(row['machine']),\n            'start': int(row['start']),\n            'end': int(row['end'])\n        })\n\nprint(f\"\\nDowntimes: {downtimes}\")\n\nEOF\n"]
