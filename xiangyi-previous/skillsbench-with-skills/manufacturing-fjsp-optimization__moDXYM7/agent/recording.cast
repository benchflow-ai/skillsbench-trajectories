[466.953474, "o", "\u001b[?2004h> "]
[466.953819, "o", "                return True\r\n\u001b[?2004l\r"]
[466.953909, "o", "\u001b[?2004h> "]
[466.95412, "o", "    return False\r\n\u001b[?2004l\r"]
[466.954215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
