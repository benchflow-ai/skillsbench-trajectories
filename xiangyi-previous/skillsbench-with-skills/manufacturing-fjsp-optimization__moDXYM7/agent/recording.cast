[526.285886, "o", "    print(f\"{mc} J{op['job']}O{op['op']}: M{op['machine']} [{op['start']:2d}-{op['end']:2d}] (was M{bl['machine']} [{bl['start']:2d}-{bl['end']:2d}])\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= max_makespan:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\n*** SOLUTION IS FEASIBLE! ***\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     solution = {\r\n\u001b[?2004l\r\u001b[?2004h>         'status': 'feasible',\r\n\u001b[?2004l\r\u001b[?2004h>         'makespan': makespan,\r\n\u001b[?2004l\r\u001b[?2004h>         'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with open('/app/output/schedule.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\r\n\u001b[?2004l\r\u001b[?2004h>         writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h>         for op in solution['schedule']:\r\n\u001b[?2004l\r\u001b[?2004h>             writer.writerow(op)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Solution saved to /app/output/\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nChecking timeline:\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nBy machine:\")\r\n\u001b[?2004l\r\u001b[?2004h>     for m in range(3):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"M{m}: \", end='')\r\n\u001b[?2004l\r\u001b[?2004h>         ops_on_m = sorted([op for op in new_schedule if op['machine'] == m], key=lambda x: x['start'])\r\n\u001b[?2004l\r\u001b[?2004h>         for op in ops_on_m:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"J{op['job']}O{op['op']}[{op['start']}-{op['end']}] \", end='')\r\n\u001b[?2004l\r\u001b[?2004h>         print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ENDOFPYTHON\r\n\u001b[?2004l\r"]
[526.341544, "o", "New strategy: Change J1O1 to M2, J1O2 to M1\r\n\r\n"]
[526.341869, "o", "Makespan: 49 (max: 39)\r\nMachine changes: 3 (max: 4)\r\nTotal start shift: 108 (max: 120)\r\nDowntime violations: 0\r\n\r\n   J0O0: M1 [ 0- 5] (was M1 [ 0- 5])\r\n   J0O1: M2 [ 5-11] (was M2 [ 5-11])\r\n   J0O2: M0 [11-16] (was M0 [24-29])\r\n   J1O0: M0 [ 0- 5] (was M0 [ 0- 5])\r\nMC J1O1: M2 [25-30] (was M1 [ 9-15])\r\nMC J1O2: M1 [30-38] (was M0 [29-36])\r\nMC J2O0: M2 [30-36] (was M1 [ 5- 9])\r\n   J2O1: M0 [36-44] (was M0 [16-24])\r\n   J2O2: M2 [44-49] (was M2 [11-16])\r\n   J3O0: M0 [ 5-12] (was M0 [ 5-12])\r\n\r\nChecking timeline:\r\n\r\nBy machine:\r\nM0: J1O0[0-5] J3O0[5-12] J0O2[11-16] J2O1[36-44] \r\nM1: J0O0[0-5] J1O2[30-38] \r\nM2: J0O1[5-11] J1O1[25-30] J2O0[30-36] J2O2[44-49] \r\n"]
[526.380468, "o", "\u001b[?2004hroot@5519cd689504:/app# "]
[568.367661, "i", "python3 << 'ENDOFPYTHON'\nimport json\nimport csv\nfrom copy import deepcopy\n\nwith open('/app/data/instance.txt', 'r') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({'machine': machine, 'duration': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nwith open('/app/data/downtime.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    downtimes = [{'machine': int(row['machine']), 'start': int(row['start']), 'end': int(row['end'])} for row in reader]\n\nwith open('/app/data/baseline_solution.json', 'r') as f:\n    baseline = json.load(f)\n\nfreeze_until = 6\nmax_machine_changes = 4\nmax_start_shift = 120\nmax_makespan = 39\n\ndef overlaps_downtime(machine, start, end, downtimes):\n    for dt in downtimes:\n        if dt['machine'] == machine:\n            if not (end <= dt['start'] or start >= dt['end']):\n                return True\n    return False\n\ndef get_machine_end_time(schedule, machine):\n    return max([op['end'] for op in schedule if op['machine'] == machine] + [0])\n\ndef get_job_op_end(schedule, job, op):\n    for item in schedule:\n        if item['job'] == job and item['op'] == op:\n            return item['end']\n    return 0\n\ndef find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\n    machine_available = get_machine_end_time(schedule, machine)\n    candidate_start = max(earliest_start, machine_available)\n    \n    for _ in range(100):\n        candidate_end = candidate_start + duration\n        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\n            return candidate_start\n        \n        for dt in downtimes:\n            if dt['machine'] == machine:\n                if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\n                    candidate_start = max(candidate_start, dt['end'])\n                    machine_available = get_machine_end_time(schedule, machine)\n                    candidate_start = max(candidate_start, machine_available)\n                    break\n    \n    return candidate_start\n\nbaseline_dict = {(op['job'], op['op']): op for op in baseline['schedule']}\n\nprint(\"Simple greedy: minimize end time, ensure all ops scheduled\\n\")\n\n# Specific assignments to try\nforced_machines = {\n    (1, 1): 2,  # J1O1 -> M2\n    (3, 1): 2,  # J3O1 -> M2  \n}\n\nnew_schedule = []\nmachine_changes = 0\ntotal_start_shift = 0\n\nfor job in range(num_jobs):\n    for op in range(num_ops_per_job):\n        baseline_op = baseline_dict[(job, op)]\n        \n        earliest_start = 0 if op == 0 else get_job_op_end(new_schedule, job, op - 1)\n        \n        is_frozen = baseline_op['start'] < freeze_until\n        violates = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtimes)\n        \n        if is_frozen and not violates:\n            new_schedule.append(deepcopy(baseline_op))\n        else:\n            if (job, op) in forced_machines:\n                target_machine = forced_machines[(job, op)]\n                for opt in jobs[job][op]:\n                    if opt['machine'] == target_machine:\n                        machine = opt['machine']\n                        duration = opt['duration']\n                        start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                        end = start + duration\n                        \n                        machine_changed = (machine != baseline_op['machine'])\n                        start_shift = abs(start - baseline_op['start'])\n                        \n                        if machine_changed:\n                            machine_changes += 1\n                        total_start_shi"]
[568.368023, "i", "ft += start_shift\n                        \n                        new_schedule.append({\n                            'job': job,\n                            'op': op,\n                            'machine': machine,\n                            'start': start,\n                            'end': end,\n                            'dur': duration\n                        })\n                        break\n            else:\n                # Always find at least one candidate\n                best = None\n                best_score = float('inf')\n                \n                for opt in jobs[job][op]:\n                    machine = opt['machine']\n                    duration = opt['duration']\n                    start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                    end = start + duration\n                    \n                    machine_changed = (machine != baseline_op['machine'])\n                    start_shift = abs(start - baseline_op['start'])\n                    \n                    # Prefer options within budget, but allow exceeding if necessary\n                    mc_penalty = 1000 if (machine_changed and machine_changes >= max_machine_changes) else 0\n                    shift_penalty = 500 if (total_start_shift + start_shift > max_start_shift) else 0\n                    \n                    score = end + mc_penalty + shift_penalty\n                    \n                    if score < best_score:\n                        best_score = score\n                        best = {\n                            'machine': machine,\n                            'duration': duration,\n                            'start': start,\n                            'end': end,\n                            'machine_changed': machine_changed,\n                            'start_shift': start_shift\n                        }\n                \n                if best:\n                    if best['machine_changed']:\n                        machine_changes += 1\n                    total_start_shift += best['start_shift']\n                    \n                    new_schedule.append({\n                        'job': job,\n                        'op': op,\n                        'machine': best['machine'],\n                        'start': best['start'],\n                        'end': best['end'],\n                        'dur': best['duration']\n                    })\n\nmakespan = max(op['end'] for op in new_schedule)\nviolations = sum(1 for op in new_schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes))\n\nprint(f\"Makespan: {makespan} (max: {max_makespan})\")\nprint(f\"Machine changes: {machine_changes} (max: {max_machine_changes})\")\nprint(f\"Total start shift: {total_start_shift} (max: {max_start_shift})\")\nprint(f\"Downtime violations: {violations}\")\nprint(f\"Operations: {len(new_schedule)}/12\\n\")\n\nfor op in sorted(new_schedule, key=lambda x: (x['job'], x['op'])):\n    bl = baseline_dict[(op['job'], op['op'])]\n    mc = 'MC' if op['machine'] != bl['machine'] else '  '\n    print(f\"{mc} J{op['job']}O{op['op']}: M{op['machine']} [{op['start']:2d}-{op['end']:2d}] (was M{bl['machine']} [{bl['start']:2d}-{bl['end']:2d}])\")\n\nif len(new_schedule) == 12 and violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= max_makespan:\n    print(\"\\n*** SOLUTION IS FEASIBLE! ***\")\n    \n    solution = {\n        'status': 'feasible',\n        'makespan': makespan,\n        'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w', newline='') as f:\n        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        writer.writeheader()\n        for op in solution['schedule']:\n            writer.writerow(op)\n    \n    print(\"Solution saved to /app/output/\")\n\nENDOFPYTHON\n"]
