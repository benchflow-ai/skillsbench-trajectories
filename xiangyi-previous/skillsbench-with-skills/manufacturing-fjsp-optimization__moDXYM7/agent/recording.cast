[360.872045, "o", "            return item['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.872151, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[360.872216, "o", "\u001b[?2004h> "]
[360.872345, "o", "def find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.872529, "o", "    machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.872711, "o", "    candidate_start = max(earliest_start, machine_available)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.87279, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.872847, "o", "    for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.872986, "o", "        candidate_end = candidate_start + duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.873233, "o", "        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.873324, "o", "            return candidate_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.873395, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.873457, "o", "        for dt in downtimes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.873523, "o", "> "]
[360.873589, "o", "            if dt['machine'] == machine:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.873846, "o", "                if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.87405, "o", "                    candidate_start = max(candidate_start, dt['end'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.874276, "o", "                    machine_available = get_machine_end_time(schedule, machine)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.874513, "o", "                    candidate_start = max(candidate_start, machine_available)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.874602, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.874667, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.874723, "o", ">     return candidate_start\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.874857, "o", "baseline_dict = {(op['job'], op['op']): op for op in baseline['schedule']}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.874925, "o", "\u001b[?2004h> "]
[360.874977, "o", "print(\"Trying smarter scheduling with machine changes...\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.875034, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875206, "o", "# Try a specific strategy: use machine changes for operations that benefit most\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875276, "o", "new_schedule = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875335, "o", "machine_changes = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875368, "o", "total_start_shift = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.875496, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> for job in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875595, "o", "    for op in range(num_ops_per_job):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.875704, "o", "        baseline_op = baseline_dict[(job, op)]\r\n\u001b[?2004l\r"]
[360.875795, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[360.875854, "o", "\u001b[?2004h> "]
[360.875946, "o", "        earliest_start = 0 if op == 0 else get_job_op_end(new_schedule, job, op - 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.876011, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876135, "o", "        is_frozen = baseline_op['start'] < freeze_until\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876345, "o", "        violates = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtimes)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[360.876431, "o", "\u001b[?2004h> "]
[360.876507, "o", "        if is_frozen and not violates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876589, "o", "            new_schedule.append(deepcopy(baseline_op))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876731, "o", "            print(f\"J{job}O{op}: FROZEN M{baseline_op['machine']} [{baseline_op['start']}-{baseline_op['end']}]\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876809, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.876844, "o", "            candidates = []\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[360.876924, "o", "\u001b[?2004h> "]
[360.876991, "o", "            for opt in jobs[job][op]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877196, "o", "                machine = opt['machine']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877329, "o", "                duration = opt['duration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877525, "o", "                start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877585, "o", "                end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.877639, "o", ">                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877826, "o", "                machine_changed = (machine != baseline_op['machine'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.877959, "o", "                start_shift = abs(start - baseline_op['start'])\r\n\u001b[?2004l\r"]
[360.878042, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878212, "o", "                # Always include at least one candidate (even if it exceeds budget slightly)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878289, "o", "                # We'll pick the best one\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878356, "o", "                candidates.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.878414, "o", "> "]
[360.878465, "o", "                    'machine': machine,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878554, "o", "                    'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878623, "o", "                    'start': start,\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.878676, "o", ">                     'end': end,\r\n\u001b[?2004l\r"]
[360.878728, "o", "\u001b[?2004h> "]
[360.878786, "o", "                    'machine_changed': machine_changed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.878881, "o", "                    'start_shift': start_shift,\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.878946, "o", "> "]
[360.879054, "o", "                    'exceeds_mc': machine_changed and machine_changes >= max_machine_changes,\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.879136, "o", "> "]
[360.879199, "o", "                    'exceeds_shift': total_start_shift + start_shift > max_start_shift\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.879253, "o", ">                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.879311, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.87947, "o", "            # Sort by: 1) doesn't exceed budgets, 2) earliest end time, 3) smallest start shift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.879716, "o", "            candidates.sort(key=lambda x: (x['exceeds_mc'], x['exceeds_shift'], x['end'], x['start_shift']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.879796, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.879881, "o", "            if candidates:\r\n\u001b[?2004l\r"]
[360.879916, "o", "\u001b[?2004h> "]
[360.879999, "o", "                chosen = candidates[0]\r\n\u001b[?2004l\r"]
[360.880036, "o", "\u001b[?2004h> "]
[360.880069, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.880193, "o", "                # Only count if within budget\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.88036, "o", "                if chosen['machine_changed'] and not chosen['exceeds_mc']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.880451, "o", "                    machine_changes += 1\r\n\u001b[?2004l\r"]
[360.88049, "o", "\u001b[?2004h> "]
[360.88058, "o", "                if not chosen['exceeds_shift']:\r\n\u001b[?2004l\r"]
[360.880615, "o", "\u001b[?2004h> "]
