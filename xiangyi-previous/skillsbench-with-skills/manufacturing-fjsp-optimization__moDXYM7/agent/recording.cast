[360.884213, "o", "violations = sum(1 for op in new_schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.884258, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
