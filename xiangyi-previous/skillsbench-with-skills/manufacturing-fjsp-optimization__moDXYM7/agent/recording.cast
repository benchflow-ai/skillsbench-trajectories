[360.916039, "o", "Trying smarter scheduling with machine changes...\r\n\r\nJ0O0: FROZEN M1 [0-5]\r\nJ0O1: FROZEN M2 [5-11]\r\nJ0O2:    M0 [11-16] (was M0 [24-29]) shift:13\r\nJ1O0: FROZEN M0 [0-5]\r\nJ1O1:    M1 [20-26] (was M1 [ 9-15]) shift:11\r\nJ1O2:    M0 [26-33] (was M0 [29-36]) shift: 3\r\n"]
