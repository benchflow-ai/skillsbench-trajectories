[466.937213, "i", "python3 << 'ENDOFPYTHON'\nimport json\nimport csv\nfrom copy import deepcopy\n\nwith open('/app/data/instance.txt', 'r') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({'machine': machine, 'duration': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nwith open('/app/data/downtime.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    downtimes = [{'machine': int(row['machine']), 'start': int(row['start']), 'end': int(row['end'])} for row in reader]\n\nwith open('/app/data/baseline_solution.json', 'r') as f:\n    baseline = json.load(f)\n\nfreeze_until = 6\nmax_machine_changes = 4\nmax_start_shift = 120\nmax_makespan = 39\n\ndef overlaps_downtime(machine, start, end, downtimes):\n    for dt in downtimes:\n        if dt['machine'] == machine:\n            if not (end <= dt['start'] or start >= dt['end']):\n                return True\n    return False\n\ndef get_machine_end_time(schedule, machine):\n    return max([op['end'] for op in schedule if op['machine'] == machine] + [0])\n\ndef get_job_op_end(schedule, job, op):\n    for item in schedule:\n        if item['job'] == job and item['op'] == op:\n            return item['end']\n    return 0\n\ndef find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\n    machine_available = get_machine_end_time(schedule, machine)\n    candidate_start = max(earliest_start, machine_available)\n    \n    for _ in range(100):\n        candidate_end = candidate_start + duration\n        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\n            return candidate_start\n        \n        for dt in downtimes:\n            if dt['machine'] == machine:\n                if not (candidate_end <= dt['start'] or candidate_start >= dt['end']):\n                    candidate_start = max(candidate_start, dt['end'])\n                    machine_available = get_machine_end_time(schedule, machine)\n                    candidate_start = max(candidate_start, machine_available)\n                    break\n    \n    return candidate_start\n\nbaseline_dict = {(op['job'], op['op']): op for op in baseline['schedule']}\n\nprint(\"Targeted strategy: Force specific machine changes for key operations\\n\")\n\n# Define forced machine changes for specific operations\nforced_machines = {\n    (2, 0): 2,  # Job 2 Op 0 -> M2\n    (3, 1): 2,  # Job 3 Op 1 -> M2\n}\n\nnew_schedule = []\nmachine_changes = 0\ntotal_start_shift = 0\n\nfor job in range(num_jobs):\n    for op in range(num_ops_per_job):\n        baseline_op = baseline_dict[(job, op)]\n        \n        earliest_start = 0 if op == 0 else get_job_op_end(new_schedule, job, op - 1)\n        \n        is_frozen = baseline_op['start'] < freeze_until\n        violates = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtimes)\n        \n        if is_frozen and not violates:\n            new_schedule.append(deepcopy(baseline_op))\n        else:\n            # Check if we have a forced machine assignment\n            if (job, op) in forced_machines:\n                target_machine = forced_machines[(job, op)]\n                # Find the option for this machine\n                for opt in jobs[job][op]:\n                    if opt['machine'] == target_machine:\n                        machine = opt['machine']\n                        duration = opt['duration']\n                        start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                        end = start + duration\n                        \n                        machine_changed = (machine != baseline_op['machine'])\n                        start_shift = abs(start - baseline_op['start'])\n "]
[466.937579, "i", "                       \n                        if machine_changed:\n                            machine_changes += 1\n                        total_start_shift += start_shift\n                        \n                        new_schedule.append({\n                            'job': job,\n                            'op': op,\n                            'machine': machine,\n                            'start': start,\n                            'end': end,\n                            'dur': duration\n                        })\n                        print(f\"FORCED: J{job}O{op} -> M{machine} [{start}-{end}]\")\n                        break\n            else:\n                # Use greedy selection\n                candidates = []\n                \n                for opt in jobs[job][op]:\n                    machine = opt['machine']\n                    duration = opt['duration']\n                    start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                    end = start + duration\n                    \n                    machine_changed = (machine != baseline_op['machine'])\n                    start_shift = abs(start - baseline_op['start'])\n                    \n                    mc_ok = not machine_changed or machine_changes < max_machine_changes\n                    shift_ok = total_start_shift + start_shift <= max_start_shift\n                    \n                    if mc_ok and shift_ok:\n                        candidates.append({\n                            'machine': machine,\n                            'duration': duration,\n                            'start': start,\n                            'end': end,\n                            'machine_changed': machine_changed,\n                            'start_shift': start_shift\n                        })\n                \n                # Sort by earliest end time\n                candidates.sort(key=lambda x: (x['end'], x['start_shift']))\n                \n                if candidates:\n                    chosen = candidates[0]\n                    \n                    if chosen['machine_changed']:\n                        machine_changes += 1\n                    total_start_shift += chosen['start_shift']\n                    \n                    new_schedule.append({\n                        'job': job,\n                        'op': op,\n                        'machine': chosen['machine'],\n                        'start': chosen['start'],\n                        'end': chosen['end'],\n                        'dur': chosen['duration']\n                    })\n\nmakespan = max(op['end'] for op in new_schedule)\nviolations = sum(1 for op in new_schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtimes))\n\nprint(f\"\\nMakespan: {makespan} (max: {max_makespan})\")\nprint(f\"Machine changes: {machine_changes} (max: {max_machine_changes})\")\nprint(f\"Total start shift: {total_start_shift} (max: {max_start_shift})\")\nprint(f\"Downtime violations: {violations}\\n\")\n\nfor op in sorted(new_schedule, key=lambda x: (x['job'], x['op'])):\n    bl = baseline_dict[(op['job'], op['op'])]\n    mc = 'MC' if op['machine'] != bl['machine'] else '  '\n    print(f\"{mc} J{op['job']}O{op['op']}: M{op['machine']} [{op['start']:2d}-{op['end']:2d}] (was M{bl['machine']} [{bl['start']:2d}-{bl['end']:2d}])\")\n\nif violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= max_makespan:\n    print(\"\\n*** SOLUTION IS FEASIBLE! ***\")\n    \n    solution = {\n        'status': 'feasible',\n        'makespan': makespan,\n        'schedule': sorted(new_schedule, key=lambda x: (x['start'], x['job'], x['op']))\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w', newline='') as f:\n        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        writer.writeheader()\n        for op in solution['schedule']:\n            writer.writerow(op)\n    \n    print(\"Solution saved to /app/output"]
[466.938083, "o", "python3 << 'ENDOFPYTHON'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[466.938112, "i", "/\")\nelse:\n    print(\"\\nStill not feasible, trying another combination...\")\n\nENDOFPYTHON\n"]
