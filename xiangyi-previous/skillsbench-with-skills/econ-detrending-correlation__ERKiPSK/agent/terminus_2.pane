[?2004hroot@ea40db03efa0:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from statsmodels.tsa.filters.hp_filter import hpfilter
[?2004l[?2004h> from scipy.stats import pearsonr
[?2004l[?2004h> 
[?2004l[?2004h> # Read the data files
[?2004l[?2004h> df_pce_raw = pd.read_excel('/root/ERP-2025-table10.xls', header=None)
[?2004l[?2004h> df_pfi_raw = pd.read_excel('/root/ERP-2025-table12.xls', header=None)
[?2004l[?2004h> df_cpi = pd.read_excel('/root/CPI.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Extract annual PCE data (1973-2023)
[?2004l[?2004h> pce_annual = []
[?2004l[?2004h> for i in range(5, 56):
[?2004l[?2004h>     year = int(float(str(df_pce_raw.iloc[i, 0]).replace('.', '')))
[?2004l[?2004h>     value = float(df_pce_raw.iloc[i, 1])
[?2004l[?2004h>     pce_annual.append({'year': year, 'pce': value})
[?2004l[?2004h> 
[?2004l[?2004h> # Extract 2024 quarterly PCE data and average
[?2004l[?2004h> pce_2024_q1 = float(df_pce_raw.iloc[68, 1])
[?2004l[?2004h> pce_2024_q2 = float(df_pce_raw.iloc[69, 1])
[?2004l[?2004h> pce_2024_q3 = float(df_pce_raw.iloc[70, 1])
[?2004l[?2004h> pce_2024_avg = (pce_2024_q1 + pce_2024_q2 + pce_2024_q3) / 3
[?2004l[?2004h> pce_annual.append({'year': 2024, 'pce': pce_2024_avg})
[?2004l[?2004h> df_pce = pd.DataFrame(pce_annual)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract annual PFI data (1973-2023)
[?2004l[?2004h> pfi_annual = []
[?2004l[?2004h> for i in range(6, 57):
[?2004l[?2004h>     year = int(float(str(df_pfi_raw.iloc[i, 0]).replace('.', '')))
[?2004l[?2004h>     value = float(df_pfi_raw.iloc[i, 1])
[?2004l[?2004h>     pfi_annual.append({'year': year, 'pfi': value})
[?2004l[?2004h> 
[?2004l[?2004h> # Extract 2024 quarterly PFI data and average
[?2004l[?2004h> pfi_2024_q1 = float(df_pfi_raw.iloc[69, 1])
[?2004l[?2004h> pfi_2024_q2 = float(df_pfi_raw.iloc[70, 1])
[?2004l[?2004h> pfi_2024_q3 = float(df_pfi_raw.iloc[71, 1])
[?2004l[?2004h> pfi_2024_avg = (pfi_2024_q1 + pfi_2024_q2 + pfi_2024_q3) / 3
[?2004l[?2004h> pfi_annual.append({'year': 2024, 'pfi': pfi_2024_avg})
[?2004l[?2004h> df_pfi = pd.DataFrame(pfi_annual)
[?2004l[?2004h> 
[?2004l[?2004h> # Merge PCE and PFI
[?2004l[?2004h> df = pd.merge(df_pce, df_pfi, on='year')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge with CPI
[?2004l[?2004h> df_cpi.columns = ['year', 'cpi']
[?2004l[?2004h> df = pd.merge(df, df_cpi, on='year')
[?2004l[?2004h> 
[?2004l[?2004h> print("Merged data:")
[?2004l[?2004h> print(df.head())
[?2004l[?2004h> print("...")
[?2004l[?2004h> print(df.tail())
[?2004l[?2004h> print(f"\nShape: {df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Deflate to get real values (divide by CPI)
[?2004l[?2004h> df['real_pce'] = df['pce'] / df['cpi']
[?2004l[?2004h> df['real_pfi'] = df['pfi'] / df['cpi']
[?2004l[?2004h> 
[?2004l[?2004h> print("\nReal values:")
[?2004l[?2004h> print(df[['year', 'real_pce', 'real_pfi']].head())
[?2004l[?2004h> print("...")
[?2004l[?2004h> print(df[['year', 'real_pce', 'real_pfi']].tail())
[?2004l[?2004h> 
[?2004l[?2004h> # Take natural log of real series
[?2004l[?2004h> df['log_real_pce'] = np.log(df['real_pce'])
[?2004l[?2004h> df['log_real_pfi'] = np.log(df['real_pfi'])
[?2004l[?2004h> 
[?2004l[?2004h> # Apply HP filter with lambda=100
[?2004l[?2004h> cycle_pce, trend_pce = hpfilter(df['log_real_pce'], lamb=100)
[?2004l[?2004h> cycle_pfi, trend_pfi = hpfilter(df['log_real_pfi'], lamb=100)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nCyclical components (first 5):")
[?2004l[?2004h> print(f"PCE cycle: {cycle_pce.values[:5]}")
[?2004l[?2004h> print(f"PFI cycle: {cycle_pfi.values[:5]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Compute Pearson correlation
[?2004l[?2004h> correlation, p_value = pearsonr(cycle_pce, cycle_pfi)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nPearson correlation: {correlation}")
[?2004l[?2004h> print(f"Rounded to 5 decimal places: {round(correlation, 5)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to answer.txt
[?2004l[?2004h> with open('/root/answer.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{round(correlation, 5)}\n")
[?2004l[?2004h> 
