[51.52487, "o", "    print(\"Using statsmodels HP filter\")\r\n\u001b[?2004l\r\u001b[?2004h>     use_statsmodels = True\r\n\u001b[?2004l\r\u001b[?2004h> except ImportError:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"statsmodels not available, will implement HP filter manually\")\r\n\u001b[?2004l\r\u001b[?2004h>     use_statsmodels = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Libraries loaded successfully\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
