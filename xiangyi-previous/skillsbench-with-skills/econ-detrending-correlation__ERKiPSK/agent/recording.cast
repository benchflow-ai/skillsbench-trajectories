[51.522617, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy import signal\n\n# Check if statsmodels has HP filter\ntry:\n    from statsmodels.tsa.filters.hp_filter import hpfilter\n    print(\"Using statsmodels HP filter\")\n    use_statsmodels = True\nexcept ImportError:\n    print(\"statsmodels not available, will implement HP filter manually\")\n    use_statsmodels = False\n\nprint(\"Libraries loaded successfully\")\nEOF\n"]
[51.522836, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
