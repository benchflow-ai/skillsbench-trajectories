[201.062201, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Open PWT database\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nprint('PWT Sheets:', wb_pwt.sheetnames)\n\n# Check the Data sheet\nif 'Data' in wb_pwt.sheetnames:\n    ws = wb_pwt['Data']\n    print(f'\\nData sheet: {ws.max_row} rows x {ws.max_column} cols')\n    # Print first few rows to understand structure\n    print('\\nFirst 5 rows:')\n    for i in range(1, 6):\n        row_data = [ws.cell(i, j).value for j in range(1, min(15, ws.max_column + 1))]\n        print(f'Row {i}: {row_data[:10]}...')\nEOF\n"]
[201.062455, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[201.063427, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[201.066523, "o", "> # Open PWT database\r\n\u001b[?2004l\r\u001b[?2004h> wb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\r\n\u001b[?2004l\r\u001b[?2004h> print('PWT Sheets:', wb_pwt.sheetnames)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check the Data sheet\r\n\u001b[?2004l\r\u001b[?2004h> if 'Data' in wb_pwt.sheetnames:\r\n\u001b[?2004l\r\u001b[?2004h>     ws = wb_pwt['Data']\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'\\nData sheet: {ws.max_row} rows x {ws.max_column} cols')\r\n\u001b[?2004l\r\u001b[?2004h>     # Print first few rows to understand structure\r\n\u001b[?2004l\r"]
