[595.142316, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load PWT data\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nws_pwt = wb_pwt['Data']\n\n# Extract Georgia's rnna data from 1990-2023\ngeorgia_data = {}\nfor i in range(2, ws_pwt.max_row + 1):\n    countrycode = ws_pwt.cell(i, 1).value\n    if countrycode == 'GEO':\n        year = ws_pwt.cell(i, 4).value\n        rnna = ws_pwt.cell(i, 22).value\n        if year and year >= 1990 and year <= 2023:\n            georgia_data[year] = rnna\n\nprint('Georgia rnna data extracted:')\nfor year in sorted(georgia_data.keys()):\n    print(f'{year}: {georgia_data[year]}')\n\nprint(f'\\nTotal years: {len(georgia_data)}')\nEOF\n"]
