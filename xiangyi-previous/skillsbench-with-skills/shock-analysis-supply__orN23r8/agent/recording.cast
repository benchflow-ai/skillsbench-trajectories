[516.970274, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nws = wb_pwt['Data']\n\n# Search for Georgia by country code\nprint('Searching for GEO country code...')\nfor i in range(2, ws.max_row + 1):\n    countrycode = ws.cell(i, 1).value\n    if countrycode == 'GEO':\n        country = ws.cell(i, 2).value\n        year = ws.cell(i, 4).value\n        rnna = ws.cell(i, 22).value\n        print(f'Row {i}: {countrycode} - {country} - Year {year} - rnna: {rnna}')\n        if year and year >= 1990 and year <= 2000:\n            pass  # Keep searching\n        elif year and year > 2000:\n            break\nEOF\n"]
