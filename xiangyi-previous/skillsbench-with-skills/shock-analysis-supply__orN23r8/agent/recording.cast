[458.812857, "o", "Column headers:\r\nCol 1: countrycode\r\nCol 2: country\r\nCol 3: currency_unit\r\nCol 4: year\r\nCol 5: rgdpe\r\nCol 6: rgdpo\r\nCol 7: pop\r\nCol 8: emp\r\nCol 9: avh\r\nCol 10: hc\r\nCol 11: ccon\r\nCol 12: cda\r\nCol 13: cgdpe\r\nCol 14: cgdpo\r\nCol 15: cn\r\nCol 16: ck\r\nCol 17: ctfp\r\nCol 18: cwtfp\r\nCol 19: rgdpna\r\nCol 20: rconna\r\nCol 21: rdana\r\nCol 22: rnna\r\nCol 23: rkna\r\nCol 24: rtfpna\r\nCol 25: rwtfpna\r\nCol 26: labsh\r\nCol 27: irr\r\nCol 28: delta\r\nCol 29: xr\r\nCol 30: pl_con\r\nCol 31: pl_da\r\nCol 32: pl_gdpo\r\nCol 33: i_cig\r\nCol 34: i_xm\r\nCol 35: i_xr\r\nCol 36: i_outlier\r\nCol 37: i_irr\r\nCol 38: cor_exp\r\n"]
