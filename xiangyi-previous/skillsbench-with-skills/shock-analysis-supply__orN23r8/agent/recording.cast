[772.001905, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load PWT data and extract Georgia's rnna\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nws_pwt = wb_pwt['Data']\n\ngeorgia_data = {}\nfor i in range(2, ws_pwt.max_row + 1):\n    countrycode = ws_pwt.cell(i, 1).value\n    if countrycode == 'GEO':\n        year = ws_pwt.cell(i, 4).value\n        rnna = ws_pwt.cell(i, 22).value\n        if year and year >= 1990:\n            georgia_data[year] = rnna\n\n# Load test-supply.xlsx\nwb_test = openpyxl.load_workbook('test-supply.xlsx')\nws_test = wb_test['PWT']\n\n# Populate the data\nprint('Populating PWT sheet...')\nfor i in range(2, ws_test.max_row + 1):\n    year = ws_test.cell(i, 1).value\n    if year and year in georgia_data:\n        ws_test.cell(i, 2).value = georgia_data[year]\n        print(f'Year {year}: {georgia_data[year]}')\n\n# Save the file\nwb_test.save('test-supply.xlsx')\nprint('\\nPWT data populated and saved!')\nEOF\n"]
