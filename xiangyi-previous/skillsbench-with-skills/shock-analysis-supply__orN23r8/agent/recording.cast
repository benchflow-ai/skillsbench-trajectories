[124.286051, "i", "python3 << 'EOF'\nimport openpyxl\nwb = openpyxl.load_workbook('test-supply.xlsx')\n\n# Check CFC data sheet\nws = wb['CFC data']\nprint('=== CFC data Sheet ===')\nfor i in range(1, min(12, ws.max_row + 1)):\n    row_data = [ws.cell(i, j).value for j in range(1, min(6, ws.max_column + 1))]\n    print(f'Row {i}: {row_data}')\n\n# Check Production sheet\nws = wb['Production']\nprint('\\n=== Production Sheet (first 15 rows) ===')\nfor i in range(1, min(16, ws.max_row + 1)):\n    row_data = [ws.cell(i, j).value for j in range(1, min(10, ws.max_column + 1))]\n    print(f'Row {i}: {row_data}')\nEOF\n"]
