[108.237316, "i", "python3 << 'EOF'\nimport openpyxl\nwb = openpyxl.load_workbook('test-supply.xlsx')\n\n# Check PWT sheet\nws = wb['PWT']\nprint('=== PWT Sheet ===')\nfor i in range(1, min(10, ws.max_row + 1)):\n    row_data = [ws.cell(i, j).value for j in range(1, min(4, ws.max_column + 1))]\n    print(f'Row {i}: {row_data}')\n\n# Check WEO_Data sheet\nws = wb['WEO_Data']\nprint('\\n=== WEO_Data Sheet ===')\nfor i in range(1, min(10, ws.max_row + 1)):\n    row_data = [ws.cell(i, j).value for j in range(1, min(5, ws.max_column + 1))]\n    if any(cell is not None for cell in row_data):\n        print(f'Row {i}: {row_data}')\nEOF\n"]
