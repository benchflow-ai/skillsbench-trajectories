[452.708923, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nws = wb_pwt['Data']\n\n# Get all column headers\nheaders = [ws.cell(1, j).value for j in range(1, ws.max_column + 1)]\nprint('Column headers:')\nfor i, h in enumerate(headers, 1):\n    print(f'Col {i}: {h}')\n\n# Find rnna column\nif 'rnna' in headers:\n    print(f\"\\nFound 'rnna' at column {headers.index('rnna') + 1}\")\nEOF\n"]
