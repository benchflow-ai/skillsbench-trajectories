[477.569887, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\nws = wb_pwt['Data']\n\n# Find Georgia's data\nprint('Searching for Georgia...')\nfor i in range(2, min(200, ws.max_row + 1)):\n    country = ws.cell(i, 2).value\n    if country and 'Georgia' in str(country):\n        countrycode = ws.cell(i, 1).value\n        year = ws.cell(i, 4).value\n        rnna = ws.cell(i, 22).value\n        print(f'Row {i}: {countrycode} - {country} - Year {year} - rnna: {rnna}')\n        if i > 10:\n            break\nEOF\n"]
[477.57139, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb_pwt = openpyxl.load_workbook('pwt_data.xlsx', data_only=True)\r\n\u001b[?2004l\r\u001b[?2004h> ws = wb_pwt['Data']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Find Georgia's data\r\n\u001b[?2004l\r\u001b[?2004h> print('Searching for Georgia...')\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(2, min(200, ws.max_row + 1)):\r\n\u001b[?2004l\r\u001b[?2004h>     country = ws.cell(i, 2).value\r\n\u001b[?2004l\r\u001b[?2004h>     if country and 'Georgia' in str(country):\r\n\u001b[?2004l\r\u001b[?2004h>         countrycode = ws.cell(i, 1).value\r\n\u001b[?2004l\r\u001b[?2004h>         year = ws.cell(i, 4).value\r\n\u001b[?2004l\r\u001b[?2004h>         rnna = ws.cell(i, 22).value"]
