[64.667787, "i", "cat << 'EOF' > /root/calculate_rmse.py\nimport netCDF4 as nc\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\n\n# Load observations\nobs_df = pd.read_csv('/root/field_temp_oxy.csv')\nobs_df['datetime'] = pd.to_datetime(obs_df['datetime'])\n\n# Load simulation\nds = nc.Dataset('/root/output/output.nc')\ntime_var = ds.variables['time']\ntime_units = time_var.units\nsim_times = nc.num2date(time_var[:], units=time_units)\n# Convert to numpy array of datetime64 for easier comparison with pandas\nsim_times = np.array([np.datetime64(datetime(t.year, t.month, t.day, t.hour, t.minute, t.second)) for t in sim_times])\n\ntemp_sim = ds.variables['temp'][:]\nz_sim = ds.variables['z'][:]\n\n# Filter observations within simulation time range\nobs_df = obs_df[(obs_df['datetime'] >= sim_times[0]) & (obs_df['datetime'] <= sim_times[-1])]\n\n# Interpolate simulation to observation points\nsim_vals = []\nobs_datetimes = obs_df['datetime'].values\nfor i, row in obs_df.iterrows():\n    obs_dt = np.datetime64(row['datetime']"]
[64.667975, "i", ")\n    t_idx = np.argmin(np.abs(sim_times - obs_dt))\n    \n    max_z = z_sim[t_idx, -1]\n    obs_height = max_z - row['depth']\n    \n    z_profile = z_sim[t_idx, :]\n    temp_profile = temp_sim[t_idx, :]\n    \n    mask = ~np.isnan(z_profile)\n    if hasattr(z_profile, 'mask'):\n        mask = mask & (~z_profile.mask)\n        \n    z_valid = z_profile[mask]\n    temp_valid = temp_profile[mask]\n    \n    if len(z_valid) == 0:\n        sim_vals.append(np.nan)\n        continue\n\n    if obs_height < z_valid[0]:\n        sim_val = temp_valid[0]\n    elif obs_height > z_valid[-1]:\n        sim_val = temp_valid[-1]\n    else:\n        sim_val = np.interp(obs_height, z_valid, temp_valid)\n    \n    sim_vals.append(sim_val)\n\nobs_df['sim_temp'] = sim_vals\nobs_df = obs_df.dropna(subset=['sim_temp'])\nrmse = np.sqrt(np.mean((obs_df['temp'] - obs_df['sim_temp'])**2))\nprint(f'RMSE: {rmse}')\n\nds.close()\nEOF\n"]
