[64.673752, "o", ">     \r\n> "]
[64.674024, "o", "    mask = ~np.isnan(z_profile)\r\n>     if hasattr(z_profile, 'mask'):\r\n> "]
[64.674124, "o", "        mask = mask & (~z_profile.mask)\r\n>         \r\n"]
[64.674199, "o", "> "]
[64.674267, "o", "    z_valid = z_profile[mask]\r\n> "]
[64.674337, "o", "    temp_valid = temp_profile[mask]\r\n"]
[64.674365, "o", "> "]
[64.674396, "o", "    \r\n> "]
[64.674469, "o", "    if len(z_valid) == 0:\r\n"]
[64.67451, "o", "> "]
[64.674568, "o", "        sim_vals.append(np.nan)\r\n"]
[64.674615, "o", "> "]
[64.674657, "o", "        continue\r\n"]
[64.674702, "o", "> \r\n> "]
[64.674765, "o", "    if obs_height < z_valid[0]:\r\n"]
[64.674806, "o", "> "]
[64.674867, "o", "        sim_val = temp_valid[0]\r\n"]
[64.674905, "o", "> "]
[64.674978, "o", "    elif obs_height > z_valid[-1]:\r\n"]
[64.675022, "o", "> "]
[64.675142, "o", "        sim_val = temp_valid[-1]\r\n>     else:\r\n> "]
[64.675339, "o", "        sim_val = np.interp(obs_height, z_valid, temp_valid)\r\n> "]
[64.675417, "o", "    \r\n> "]
[64.675457, "o", "    sim_vals.append(sim_val)\r\n> "]
[64.675496, "o", "\r\n> "]
[64.675566, "o", "obs_df['sim_temp'] = sim_vals\r\n"]
[64.675613, "o", "> "]
[64.67569, "o", "obs_df = obs_df.dropna(subset=['sim_temp'])\r\n"]
[64.675733, "o", "> "]
[64.675879, "o", "rmse = np.sqrt(np.mean((obs_df['temp'] - obs_df['sim_temp'])**2))\r\n"]
[64.675946, "o", "> print(f'RMSE: {rmse}')\r\n"]
[64.675991, "o", "> \r\n> "]
[64.676028, "o", "ds.close()\r\n"]
[64.676102, "o", "> "]
[64.67615, "o", "EOF\r\n"]
[64.679695, "o", "root@d070cdfb5263:~# "]
[65.246112, "i", "python3 /root/calculate_rmse.py\n"]
[65.246268, "o", "python3 /root/calculate_rmse.py\r\n"]
[66.891877, "o", "RMSE: 6.855505843087376\r\n"]
