[?2004l[?2004h> s_by_sta=defaultdict(list)
[?2004l[?2004h> for p in picks:
[?2004l[?2004h>     if p.phase=='P':
[?2004l[?2004h>         p_by_sta[p.trace_id].append(p.peak_time)
[?2004l[?2004h>     elif p.phase=='S':
[?2004l[?2004h>         s_by_sta[p.trace_id].append(p.peak_time)
[?2004l[?2004h> # sort times
[?2004l[?2004h> for sta in p_by_sta: p_by_sta[sta]=sorted(p_by_sta[sta])
[?2004l[?2004h> for sta in s_by_sta: s_by_sta[sta]=sorted(s_by_sta[sta])
[?2004l[?2004h> # pair P with nearest S after it
[?2004l[?2004h> origin_times=[]
[?2004l[?2004h> for sta, ptimes in p_by_sta.items():
[?2004l[?2004h>     stimes = s_by_sta.get(sta, [])
[?2004l[?2004h>     if not stimes: continue
[?2004l[?2004h>     j=0
[?2004l[?2004h>     for pt in ptimes:
[?2004l[?2004h>         # move j to first S after pt
[?2004l[?2004h>         while j < len(stimes) and stimes[j] < pt: j+=1
[?2004l[?2004h>         if j>=len(stimes): break
[?2004l[?2004h>         stime=stimes[j]
[?2004l[?2004h>         sp = stime - pt
[?2004l[?2004h>         if sp < 0.5 or sp > 20: continue
[?2004l[?2004h>         # compute distance and origin time
[?2004l[?2004h>         dist = sp / (1/vs - 1/vp)
[?2004l[?2004h>         t0 = pt - dist/vp
[?2004l[?2004h>         origin_times.append(t0)
