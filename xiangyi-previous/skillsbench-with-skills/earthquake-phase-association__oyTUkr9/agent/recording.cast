[672.575902, "o", "\u001b[?2004hroot@582c3d58367d:~# "]
[711.421303, "i", "python3 - <<'PY'\nimport obspy, seisbench.models as sbm\nfrom collections import defaultdict\nimport numpy as np\nimport pandas as pd\nvp=6.0\nvs=vp/1.75\nst=obspy.read('/root/data/wave.mseed')\nmodel=sbm.PhaseNet.from_pretrained('scedc')\nprint('classify...')\npicks=model.classify(st, P_threshold=0.5, S_threshold=0.5).picks\n# group picks by station\np_by_sta=defaultdict(list)\ns_by_sta=defaultdict(list)\nfor p in picks:\n    if p.phase=='P':\n        p_by_sta[p.trace_id].append(p.peak_time)\n    elif p.phase=='S':\n        s_by_sta[p.trace_id].append(p.peak_time)\nfor sta in p_by_sta:\n    p_by_sta[sta]=sorted(p_by_sta[sta])\nfor sta in s_by_sta:\n    s_by_sta[sta]=sorted(s_by_sta[sta])\n# compute origin times from P-S pairs\norigin_times=[]\nfor sta, ptimes in p_by_sta.items():\n    stimes = s_by_sta.get(sta, [])\n    if not stimes:\n        continue\n    j=0\n    for pt in ptimes:\n        while j < len(stimes) and stimes[j] < pt:\n            j+=1\n        if j>=len(stimes):\n            break\n        stime=stimes[j]\n        sp = stime - pt\n        if sp < 0.5 or sp > 20:\n            continue\n        dist = sp / (1/vs - 1/vp)\n        t0 = pt - dist/vp\n        origin_times.append(t0)\norigin_times=sorted(origin_times)\n# cluster by 5s gap\nclusters=[]\ncurrent=[]\nfor t in origin_times:\n    if not current:\n        current=[t]\n    elif t - current[-1] <= 5:\n        current.append(t)\n    else:\n        clusters.append(current)\n        current=[t]\nif current:\n    clusters.append(current)\n# select events with at least 3 estimates\nminsize=3\nevents=[]\nfor c in clusters:\n    if len(c)>=minsize:\n        med=obspy.UTCDateTime(np.median([t.timestamp for t in c]))\n        events.append(med)\n# sort and format times\nevents=sorted(events)\n# write CSV\nrows=[{'time': e.isoformat().replace('Z','')} for e in events]\nimport csv\nwith open('/root/results.csv','w', newline='') as f:\n    writer=csv.DictWriter(f, fieldnames=['time'])\n    writer.writeheader()\n    writer.writerows(rows)\nprint('wrote', len(events), 'events to /root/results.csv')\nprint(events)\nPY\n"]
