[711.429767, "o", "    clusters.append(current)\r\n\u001b[?2004l\r"]
[711.429799, "o", "\u001b[?2004h> "]
[711.429888, "o", "# select events with at least 3 estimates\r\n\u001b[?2004l\r"]
[711.429913, "o", "\u001b[?2004h> "]
[711.429947, "o", "minsize=3\r\n\u001b[?2004l\r"]
[711.429974, "o", "\u001b[?2004h> "]
[711.430007, "o", "events=[]\r\n\u001b[?2004l\r"]
[711.430032, "o", "\u001b[?2004h> "]
[711.430083, "o", "for c in clusters:\r\n\u001b[?2004l\r"]
[711.430106, "o", "\u001b[?2004h> "]
[711.430167, "o", "    if len(c)>=minsize:\r\n\u001b[?2004l\r"]
[711.430197, "o", "\u001b[?2004h> "]
[711.430328, "o", "        med=obspy.UTCDateTime(np.median([t.timestamp for t in c]))\r\n\u001b[?2004l\r"]
[711.430358, "o", "\u001b[?2004h> "]
[711.430411, "o", "        events.append(med)\r\n\u001b[?2004l\r"]
[711.430439, "o", "\u001b[?2004h> "]
[711.430498, "o", "# sort and format times\r\n\u001b[?2004l\r"]
[711.430521, "o", "\u001b[?2004h> "]
[711.43058, "o", "events=sorted(events)\r\n\u001b[?2004l\r"]
[711.430609, "o", "\u001b[?2004h> "]
[711.430639, "o", "# write CSV\r\n\u001b[?2004l\r"]
[711.430668, "o", "\u001b[?2004h> "]
[711.430789, "o", "rows=[{'time': e.isoformat().replace('Z','')} for e in events]\r\n\u001b[?2004l\r"]
[711.430824, "o", "\u001b[?2004h> "]
[711.430848, "o", "import csv\r\n\u001b[?2004l\r"]
[711.430875, "o", "\u001b[?2004h> "]
[711.430976, "o", "with open('/root/results.csv','w', newline='') as f:\r\n\u001b[?2004l\r"]
[711.431009, "o", "\u001b[?2004h> "]
[711.43111, "o", "    writer=csv.DictWriter(f, fieldnames=['time'])\r\n\u001b[?2004l\r"]
[711.431139, "o", "\u001b[?2004h> "]
[711.431191, "o", "    writer.writeheader()\r\n\u001b[?2004l\r"]
[711.43122, "o", "\u001b[?2004h> "]
[711.431274, "o", "    writer.writerows(rows)\r\n\u001b[?2004l\r"]
[711.431297, "o", "\u001b[?2004h"]
[711.43132, "o", "> "]
[711.431451, "o", "print('wrote', len(events), 'events to /root/results.csv')\r\n\u001b[?2004l\r"]
[711.431475, "o", "\u001b[?2004h> "]
[711.431523, "o", "print(events)\r\n\u001b[?2004l\r"]
[711.431549, "o", "\u001b[?2004h> "]
[711.431577, "o", "PY\r\n\u001b[?2004l\r"]
[712.405589, "i", "cat /root/results.csv\n"]
[712.405838, "o", "cat /root/results.csv\r\n"]
[715.28895, "o", "classify...\r\n"]
