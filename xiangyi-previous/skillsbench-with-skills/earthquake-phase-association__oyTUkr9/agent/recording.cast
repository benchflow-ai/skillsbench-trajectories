[246.761184, "o", "\r\n        Classifies the stream. The classification can contain any information,\r\n        but should be consistent with existing models.\r\n\r\n        :param stream: Obspy stream to classify\r\n        :type stream: obspy.core.Stream\r\n        :param kwargs:\r\n        :return: A classification for the full stream, e.g., a list of picks or the source magnitude.\r\n        \r\ndefault_args {'P_threshold': 0.40876261396056346, 'S_threshold': 0.4039903966026159, 'blinding': [250, 250]}\r\n"]
[247.561035, "o", "\u001b[?2004hroot@582c3d58367d:~# "]
[289.425318, "i", "python3 - <<'PY'\nimport obspy, seisbench.models as sbm\nfrom collections import Counter\nst=obspy.read('/root/data/wave.mseed')\nprint('stream', st)\nmodel=sbm.PhaseNet.from_pretrained('scedc')\nprint('classifying...')\nout=model.classify(st, parallelism=4)\npicks=out.picks\nprint('n picks', len(picks))\nctr=Counter([p.phase for p in picks])\nprint('phase counts', ctr)\n# time range\nif picks:\n    times=[p.peak_time for p in picks]\n    print('pick time range', min(times), max(times))\n    # show first 5\n    for p in picks[:5]:\n        print(p.phase, p.peak_time, p.trace_id, p.peak_value)\nPY\n"]
