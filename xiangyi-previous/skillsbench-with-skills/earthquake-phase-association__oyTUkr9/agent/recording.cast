[90.440219, "i", "python3 - <<'PY'\nimport seisbench.models as sbm\nimport obspy\nmodel = sbm.PhaseNet.from_pretrained('scedc')\nst=obspy.read('/root/data/wave.mseed', starttime=obspy.UTCDateTime(2019,7,4,19,0,0), endtime=obspy.UTCDateTime(2019,7,4,19,2,0))\nprint('traces', len(st))\n# classify\npicks = model.classify(st)\nprint('picks type', type(picks), 'len', len(picks))\nprint(picks[:5])\n# show first pick fields\nif len(picks)>0:\n    p=picks[0]\n    print('pick', p)\n    print('attrs', p.phase, p.peak_time, p.trace_id, p.probability)\nPY\n"]
