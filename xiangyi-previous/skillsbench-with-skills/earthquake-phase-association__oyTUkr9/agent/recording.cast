[446.22962, "i", "python3 - <<'PY'\nimport obspy, seisbench.models as sbm\nfrom collections import Counter, defaultdict\nst=obspy.read('/root/data/wave.mseed')\nmodel=sbm.PhaseNet.from_pretrained('scedc')\nprint('classify...')\nout=model.classify(st, P_threshold=0.6, S_threshold=0.6)\npicks=out.picks\nprint('n picks', len(picks))\nctr=Counter([p.phase for p in picks])\nprint('phase counts', ctr)\n# counts per station for P\np_by_sta=defaultdict(list)\nfor p in picks:\n    if p.phase=='P':\n        p_by_sta[p.trace_id].append(p.peak_time)\nprint('P picks per station')\nfor sta, times in sorted(p_by_sta.items()):\n    print(sta, len(times))\n# show first 10 P times\np_times=sorted([p.peak_time for p in picks if p.phase=='P'])\nprint('first 10 P times', p_times[:10])\nPY\n"]
