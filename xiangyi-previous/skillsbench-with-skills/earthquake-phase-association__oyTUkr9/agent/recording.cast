[52.049076, "i", "python3 - <<'PY'\nimport seisbench.models as sbm\nimport obspy\nfrom inspect import signature\nmodel = sbm.PhaseNet.from_pretrained('phasenet')\nprint(model)\nprint('classify sig', signature(model.classify))\n# read one trace\nst=obspy.read('/root/data/wave.mseed', starttime=obspy.UTCDateTime(2019,7,4,19,0,0), endtime=obspy.UTCDateTime(2019,7,4,19,1,0))\ntr=st[0]\nprint(tr)\n# run classify on small stream\npicks = model.classify(tr)\nprint('picks type', type(picks))\ntry:\n    print('len', len(picks))\n    print(picks[:5])\nexcept Exception as e:\n    print('err', e)\nPY\n"]
