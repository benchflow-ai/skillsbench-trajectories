    # Variables
    Pg = cp.Variable(n_gen, nonneg=True)
    R = cp.Variable(n_gen, nonneg=True)
    
    # Objective
    obj = cp.sum(cp.multiply(c2, cp.square(Pg)) + cp.multiply(c1, Pg) + c0 + cp.multiply(res_cost, R))
    
    # Constraints
    cons = [Pg >= Pmin, Pg + R <= Pmax, R <= reserve_cap]
    cons.append(cp.sum(Pg) == np.sum(Pd))  # Power balance
    
