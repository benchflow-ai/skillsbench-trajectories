[?2004l[?2004h> def build_matrices(data):
[?2004l[?2004h>     """Build network matrices for DC-OPF"""
[?2004l[?2004h>     baseMVA = data['baseMVA']
[?2004l[?2004h>     buses = np.array(data['bus'])
[?2004l[?2004h>     gens = np.array(data['gen'])
[?2004l[?2004h>     branches = np.array(data['branch'])
[?2004l[?2004h>     
[?2004l[?2004h>     n_bus = len(buses)
[?2004l[?2004h>     n_gen = len(gens)
[?2004l[?2004h>     n_branch = len(branches)
[?2004l[?2004h>     
[?2004l[?2004h>     # Bus data
[?2004l[?2004h>     bus_ids = buses[:, 0].astype(int)
[?2004l[?2004h>     bus_id_to_idx = {bid: idx for idx, bid in enumerate(bus_ids)}
[?2004l[?2004h>     Pd = buses[:, 2]  # Real power demand (MW)
[?2004l[?2004h>     
[?2004l[?2004h>     # Generator data
[?2004l[?2004h>     gen_bus = gens[:, 0].astype(int)
[?2004l[?2004h>     gen_bus_idx = np.array([bus_id_to_idx[b] for b in gen_bus])
[?2004l[?2004h>     gen_status = gens[:, 7]
[?2004l[?2004h>     Pmax = gens[:, 8].copy()
[?2004l[?2004h>     Pmin = gens[:, 9].copy()
[?2004l[?2004h>     Pmax[gen_status == 0] = 0
[?2004l[?2004h>     Pmin[gen_status == 0] = 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Branch data
[?2004l[?2004h>     f_bus = branches[:, 0].astype(int)
[?2004l[?2004h>     t_bus = branches[:, 1].astype(int)
[?2004l[?2004h>     f_bus_idx = np.array([bus_id_to_idx[b] for b in f_bus])
[?2004l[?2004h>     t_bus_idx = np.array([bus_id_to_idx[b] for b in t_bus])
[?2004l[?2004h>     x = branches[:, 3]
[?2004l[?2004h>     rate_a = branches[:, 5].copy()
[?2004l[?2004h>     br_status = branches[:, 10]
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'n_bus': n_bus, 'n_gen': n_gen, 'n_branch': n_branch,
[?2004l[?2004h>         'bus_ids': bus_ids, 'bus_id_to_idx': bus_id_to_idx, 'Pd': Pd,
[?2004l[?2004h>         'gen_bus_idx': gen_bus_idx, 'Pmax': Pmax, 'Pmin': Pmin,
[?2004l[?2004h>         'f_bus': f_bus, 't_bus': t_bus, 'f_bus_idx': f_bus_idx, 't_bus_idx': t_bus_idx,
[?2004l[?2004h>         'x': x, 'rate_a': rate_a, 'br_status': br_status
[?2004l[?2004h>     }
