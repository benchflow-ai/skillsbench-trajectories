[?2004l[?2004hroot@9ef2a578021a:~# cat >> solve_dcopf.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> def build_ptdf(m):
[?2004l[?2004h>     """Build PTDF matrix for DC power flow"""
[?2004l[?2004h>     n_bus, n_branch = m['n_bus'], m['n_branch']
[?2004l[?2004h>     f_bus_idx, t_bus_idx = m['f_bus_idx'], m['t_bus_idx']
[?2004l[?2004h>     x, br_status = m['x'], m['br_status']
[?2004l[?2004h>     
[?2004l[?2004h>     b_line = np.zeros(n_branch)
[?2004l[?2004h>     for i in range(n_branch):
[?2004l[?2004h>         if br_status[i] > 0 and x[i] != 0:
[?2004l[?2004h>             b_line[i] = 1.0 / x[i]
[?2004l[?2004h>     
[?2004l[?2004h>     B = np.zeros((n_bus, n_bus))
[?2004l[?2004h>     for i in range(n_branch):
[?2004l[?2004h>         if br_status[i] > 0 and x[i] != 0:
[?2004l[?2004h>             fi, ti = f_bus_idx[i], t_bus_idx[i]
[?2004l[?2004h>             B[fi, fi] += b_line[i]
[?2004l[?2004h>             B[ti, ti] += b_line[i]
[?2004l[?2004h>             B[fi, ti] -= b_line[i]
[?2004l[?2004h>             B[ti, fi] -= b_line[i]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use pseudo-inverse for numerical stability
[?2004l[?2004h>     slack_idx = 0  # Use first bus as reference
[?2004l[?2004h>     non_slack = list(range(1, n_bus))
[?2004l[?2004h>     B_reduced = B[np.ix_(non_slack, non_slack)]
[?2004l[?2004h>     X = np.linalg.pinv(B_reduced)
[?2004l[?2004h>     
[?2004l[?2004h>     X_full = np.zeros((n_bus, n_bus))
[?2004l[?2004h>     for ii, i in enumerate(non_slack):
[?2004l[?2004h>         for jj, j in enumerate(non_slack):
[?2004l[?2004h>             X_full[i, j] = X[ii, jj]
[?2004l[?2004h>     
[?2004l[?2004h>     PTDF = np.zeros((n_branch, n_bus))
[?2004l[?2004h>     for l in range(n_branch):
[?2004l[?2004h>         if br_status[l] > 0 and x[l] != 0:
[?2004l[?2004h>             fi, ti = f_bus_idx[l], t_bus_idx[l]
[?2004l[?2004h>             for i in range(n_bus):
[?2004l[?2004h>                 PTDF[l, i] = b_line[l] * (X_full[fi, i] - X_full[ti, i])
[?2004l[?2004h>     
[?2004l[?2004h>     return PTDF, b_line
[?2004l[?2004h> 
[?2004l[?2004h> def get_costs(data):
[?2004l[?2004h>     """Extract generator cost coefficients"""
[?2004l[?2004h>     gencosts = data['gencost']
[?2004l[?2004h>     n_gen = len(gencosts)
[?2004l[?2004h>     cost_c2 = np.zeros(n_gen)
[?2004l[?2004h>     cost_c1 = np.zeros(n_gen)
[?2004l[?2004h>     cost_c0 = np.zeros(n_gen)
[?2004l[?2004h>     
[?2004l[?2004h>     for i, gc in enumerate(gencosts):
[?2004l[?2004h>         model = int(gc[0])
[?2004l[?2004h>         ncost = int(gc[3])
[?2004l[?2004h>         coeffs = gc[4:4+ncost]
[?2004l[?2004h>         if model == 2 and ncost >= 2:
[?2004l[?2004h>             cost_c0[i] = coeffs[-1] if ncost >= 1 else 0
[?2004l[?2004h>             cost_c1[i] = coeffs[-2] if ncost >= 2 else 0
[?2004l[?2004h>             cost_c2[i] = coeffs[-3] if ncost >= 3 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     return cost_c0, cost_c1, cost_c2
[?2004l[?2004h> EOF
[?2004l[?2004hroot@9ef2a578021a:~# cat >> solve_dcopf.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> def solve_dcopf(data, rate_a_override=None):
[?2004l[?2004h>     """Solve DC-OPF with reserve co-optimization"""
[?2004l[?2004h>     m = build_matrices(data)
[?2004l[?2004h>     PTDF, _ = build_ptdf(m)
[?2004l[?2004h>     cost_c0, cost_c1, cost_c2 = get_costs(data)
[?2004l[?2004h>     
[?2004l[?2004h>     reserve_capacity = np.array(data['reserve_capacity'])
[?2004l[?2004h>     reserve_req = data['reserve_requirement']
