[555.558271, "o", "cost']\r\n    reserve_cap = np.array(data['reserve_capacity'])\r\n    reserve_req = data['reserve_requirement']\r\n    \r\n    n_bus, n_gen, n_br = len(buses), len(gens), len(branches)\r\n    \r\n    # Bus mapping\r\n    bus_ids = buses[:, 0].astype(int)\r\n    bus_map = {bid: idx for idx, bid in enu"]
[555.558539, "o", "merate(bus_ids)}\r\n    Pd = buses[:, 2]\r\n    \r\n    # Generator data\r\n    gen_bus_idx = np.array([bus_map[int(g[0])] for g in gens])\r\n    gen_status = gens[:, 7]\r\n    Pmax = np.where(gen_status > 0, gens[:, 8], 0)\r\n    Pmin = np.where(gen_status > 0, gens[:, 9], 0)\r\n    \r\n    # Branch data\r\n    f_idx = np.array([bus_map[int(b[0])] for b in branches])\r\n    t_idx = np.array([bus_map[int(b[1])] for b in branches])\r\n    x = branches[:, 3]\r\n    rate_a = branches[:, 5].copy()\r\n    br_status = branches[:, 10]\r\n    \r\n    # Apply capacity multiplier\r\n    if capacity_mult:\r\n        for idx, mult in capacity_mult.items():\r\n            rate_a[idx] *= mult\r\n    \r\n    # Build B matrix vectorized\r\n    active = (br_status > 0) & (x != 0)\r\n    b_line = np.where(active, 1.0/np.where(x!=0, x, 1), 0)\r\n    \r\n    B = np.zeros((n_bus, n_bus))\r\n    np.add.at(B, (f_idx[active], f_idx[active]), b_line[active])\r\n    np.add.at(B, (t_idx[active], t_idx[active]), b_line[active])\r\n    np.add.at(B, (f_idx[active], t_idx[active]), -b_line[active])\r\n    np.add.at(B, (t_idx[active], f_idx[active]), -b_line[active])\r\n    \r\n    # PTDF using vectorized operations\r\n    non_slack = np.arange(1, n_bus)\r\n    B_red = B[np.ix_(non_slack, non_slack)]\r\n    X = np.linalg.pinv(B_red)\r\n    \r\n    X_full = np.zeros((n_bus, n_bus))\r\n    X_full[np.ix_(non_slack, non_slack)] = X\r\n    \r\n    # Vectorized PTDF\r\n    PTDF = np.zeros((n_br, n_bus))\r\n    active_idx = np.where(active)[0]\r\n    for l in active_idx:\r\n        PTDF[l, :] = b_line[l] * (X_full[f_idx[l], :] - X_full[t_idx[l], :])\r\n    \r\n    # Cost coefficients\r\n    c0, c1, c2 = np.zeros(n_gen), np.zeros(n_gen), np.zeros(n_gen)\r\n    for i, gc in enumerate(gencosts):\r\n        ncost = int(gc[3])\r\n        if int(gc[0]) == 2 and ncost >= 2:\r\n            coeffs = gc[4:4+ncost]\r\n            c0[i] = coeffs[-1] if ncost >= 1 else 0\r\n            c1[i] = coeffs[-2] if ncost >= 2 else 0\r\n            c2[i] = coeffs[-3] if ncost >= 3 else 0\r\n    \r\n    res_cost = np.maximum(c1 * 0.1, 0.1)\r\nEOF\r\n"]
[577.053618, "i", "cat >> solve_dcopf_fast.py << 'EOF'\n    \n    # Generator-bus matrix\n    Cg = np.zeros((n_bus, n_gen))\n    Cg[gen_bus_idx, np.arange(n_gen)] = 1\n    \n    # Variables\n    Pg = cp.Variable(n_gen, nonneg=True)\n    R = cp.Variable(n_gen, nonneg=True)\n    \n    # Objective\n    obj = cp.sum(cp.multiply(c2, cp.square(Pg)) + cp.multiply(c1, Pg) + c0 + cp.multiply(res_cost, R))\n    \n    # Constraints\n    cons = [Pg >= Pmin, Pg + R <= Pmax, R <= reserve_cap]\n    cons.append(cp.sum(Pg) == np.sum(Pd))  # Power balance\n    \n    # Line limits - only constrained lines\n    P_inj = Cg @ Pg - Pd\n    constrained = active & (rate_a > 0) & (rate_a < 50000)\n    con_idx = np.where(constrained)[0]\n    \n    # Use matrix form for line constraints\n    PTDF_con = PTDF[con_idx, :]\n    rate_con = rate_a[con_idx]\n    flow = PTDF_con @ P_inj\n    cons.append(flow <= rate_con)\n    cons.append(flow >= -rate_con)\n    \n    cons.append(cp.sum(R) >= reserve_req)  # Reserve requirement\n    \n    prob = cp.Problem(cp.Minimize(obj), cons)\n    prob.solve(solver=cp.ECOS, verbose=False)\n    \n    if prob.status not in ['optimal', 'optimal_inaccurate']:\n        print(f\"Status: {prob.status}\")\n        return None\n    \n    # Extract results\n    Pg_v, R_v = Pg.value, R.value\n    P_inj_v = Cg @ Pg_v - Pd\n    \n    # Duals\n    lam = cons[3].dual_value if cons[3].dual_value is not None else 0\n    mu_pos = cons[4].dual_value if cons[4].dual_value is not None else np.zeros(len(con_idx))\n    mu_neg = cons[5].dual_value if cons[5].dual_value is not None else np.zeros(len(con_idx))\n    res_dual = cons[6].dual_value if cons[6].dual_value is not None else 0\n    \n    # LMPs\n    lmp = np.full(n_bus, lam)\n    for i, l in enumerate(con_idx):\n        lmp += (mu_pos[i] - mu_neg[i]) * PTDF[l, :]\n    \n    # Binding lines\n    binding = []\n    flows = PTDF @ P_inj_v\n    for l in range(n_br):\n        if br_status[l] > 0 and rate_a[l] > 0 and rate_a[l] < 50000:\n            if abs(flows[l]) / rate_a[l] >= 0.99:\n                binding.append({'from': int(branches[l,0]), 'to': int(branches[l,1]),\n                               'flow_MW': round(abs(flows[l]),2), 'limit_MW': round(rate_a[l],2)})\n    \n    lmp_list = [{'bus': int(bus_ids[i]), 'lmp_dollars_per_MWh': round(lmp[i],4)} for i in range(n_bus)]\n    \n    return {'total_cost_dollars_per_hour': round(prob.value,2), 'lmp_by_bus': lmp_list,\n            'reserve_mcp_dollars_per_MWh': round(abs(res_dual),4), 'binding_lines': binding}\nEOF\n"]
