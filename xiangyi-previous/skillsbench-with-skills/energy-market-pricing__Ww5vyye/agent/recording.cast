[207.961679, "i", "cat > solve_dcopf.py << 'EOF'\nimport json\nimport numpy as np\nimport cvxpy as cp\n\ndef load_network(filename):\n    with open(filename) as f:\n        data = json.load(f)\n    return data\n\ndef build_matrices(data):\n    \"\"\"Build network matrices for DC-OPF\"\"\"\n    baseMVA = data['baseMVA']\n    buses = np.array(data['bus'])\n    gens = np.array(data['gen'])\n    branches = np.array(data['branch'])\n    \n    n_bus = len(buses)\n    n_gen = len(gens)\n    n_branch = len(branches)\n    \n    # Bus data\n    bus_ids = buses[:, 0].astype(int)\n    bus_id_to_idx = {bid: idx for idx, bid in enumerate(bus_ids)}\n    Pd = buses[:, 2]  # Real power demand (MW)\n    \n    # Generator data\n    gen_bus = gens[:, 0].astype(int)\n    gen_bus_idx = np.array([bus_id_to_idx[b] for b in gen_bus])\n    gen_status = gens[:, 7]\n    Pmax = gens[:, 8].copy()\n    Pmin = gens[:, 9].copy()\n    Pmax[gen_status == 0] = 0\n    Pmin[gen_status == 0] = 0\n    \n    # Branch data\n    f_bus = branches[:, 0].astype(int)\n    t_bus = branches[:, 1].astype(int)\n    f_bus_idx = np.array([bus_id_to_idx[b] for b in f_bus])\n    t_bus_idx = np.array([bus_id_to_idx[b] for b in t_bus])\n    x = branches[:, 3]\n    rate_a = branches[:, 5].copy()\n    br_status = branches[:, 10]\n    \n    return {\n        'n_bus': n_bus, 'n_gen': n_gen, 'n_branch': n_branch,\n        'bus_ids': bus_ids, 'bus_id_to_idx': bus_id_to_idx, 'Pd': Pd,\n        'gen_bus_idx': gen_bus_idx, 'Pmax': Pmax, 'Pmin': Pmin,\n        'f_bus': f_bus, 't_bus': t_bus, 'f_bus_idx': f_bus_idx, 't_bus_idx': t_bus_idx,\n        'x': x, 'rate_a': rate_a, 'br_status': br_status\n    }\nEOF\n"]
[207.961945, "o", "cat > solve_dcopf.py << 'EOF'\r\n"]
