[221.875857, "i", "cat >> solve_dcopf.py << 'EOF'\n\ndef build_ptdf(m):\n    \"\"\"Build PTDF matrix for DC power flow\"\"\"\n    n_bus, n_branch = m['n_bus'], m['n_branch']\n    f_bus_idx, t_bus_idx = m['f_bus_idx'], m['t_bus_idx']\n    x, br_status = m['x'], m['br_status']\n    \n    b_line = np.zeros(n_branch)\n    for i in range(n_branch):\n        if br_status[i] > 0 and x[i] != 0:\n            b_line[i] = 1.0 / x[i]\n    \n    B = np.zeros((n_bus, n_bus))\n    for i in range(n_branch):\n        if br_status[i] > 0 and x[i] != 0:\n            fi, ti = f_bus_idx[i], t_bus_idx[i]\n            B[fi, fi] += b_line[i]\n            B[ti, ti] += b_line[i]\n            B[fi, ti] -= b_line[i]\n            B[ti, fi] -= b_line[i]\n    \n    # Use pseudo-inverse for numerical stability\n    slack_idx = 0  # Use first bus as reference\n    non_slack = list(range(1, n_bus))\n    B_reduced = B[np.ix_(non_slack, non_slack)]\n    X = np.linalg.pinv(B_reduced)\n    \n    X_full = np.zeros((n_bus, n_bus))\n    for ii, i in enumerate(non_slack):\n        for jj, j in enumerate(non_slack):\n            X_full[i, j] = X[ii, jj]\n    \n    PTDF = np.zeros((n_branch, n_bus))\n    for l in range(n_branch):\n        if br_status[l] > 0 and x[l] != 0:\n            fi, ti = f_bus_idx[l], t_bus_idx[l]\n            for i in range(n_bus):\n                PTDF[l, i] = b_line[l] * (X_full[fi, i] - X_full[ti, i])\n    \n    return PTDF, b_line\n\ndef get_costs(data):\n    \"\"\"Extract generator cost coefficients\"\"\"\n    gencosts = data['gencost']\n    n_gen = len(gencosts)\n    cost_c2 = np.zeros(n_gen)\n    cost_c1 = np.zeros(n_gen)\n    cost_c0 = np.zeros(n_gen)\n    \n    for i, gc in enumerate(gencosts):\n        model = int(gc[0])\n        ncost = int(gc[3])\n        coeffs = gc[4:4+ncost]\n        if model == 2 and ncost >= 2:\n            cost_c0[i] = coeffs[-1] if ncost >= 1 else 0\n            cost_c1[i] = coeffs[-2] if ncost >= 2 else 0\n            cost_c2[i] = coeffs[-3] if ncost >= 3 else 0\n    \n    return cost_c0, cost_c1, cost_c2\nEOF\n"]
