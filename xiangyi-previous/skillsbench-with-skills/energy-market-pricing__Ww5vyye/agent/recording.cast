[221.887789, "o", "\u001b[?2004h> "]
[221.887883, "o", "        ncost = int(gc[3])\r\n\u001b[?2004l\r"]
[221.887911, "o", "\u001b[?2004h> "]
[221.888015, "o", "        coeffs = gc[4:4+ncost]\r\n\u001b[?2004l\r"]
[221.888046, "o", "\u001b[?2004h> "]
[221.888145, "o", "        if model == 2 and ncost >= 2:\r\n\u001b[?2004l\r"]
[221.888177, "o", "\u001b[?2004h> "]
[221.888302, "o", "            cost_c0[i] = coeffs[-1] if ncost >= 1 else 0\r\n\u001b[?2004l\r"]
[221.888331, "o", "\u001b[?2004h> "]
[221.888523, "o", "            cost_c1[i] = coeffs[-2] if ncost >= 2 else 0\r\n\u001b[?2004l\r"]
[221.888605, "o", "\u001b[?2004h> "]
[221.888639, "o", "            cost_c2[i] = coeffs[-3] if ncost >= 3 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.888683, "o", "    \r\n\u001b[?2004l\r"]
[221.888717, "o", "\u001b[?2004h> "]
[221.888878, "o", "    return cost_c0, cost_c1, cost_c2\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[221.890495, "o", "\u001b[?2004hroot@9ef2a578021a:~# "]
[237.735052, "i", "cat >> solve_dcopf.py << 'EOF'\n\ndef solve_dcopf(data, rate_a_override=None):\n    \"\"\"Solve DC-OPF with reserve co-optimization\"\"\"\n    m = build_matrices(data)\n    PTDF, _ = build_ptdf(m)\n    cost_c0, cost_c1, cost_c2 = get_costs(data)\n    \n    reserve_capacity = np.array(data['reserve_capacity'])\n    reserve_req = data['reserve_requirement']\n    \n    n_gen, n_bus, n_branch = m['n_gen'], m['n_bus'], m['n_branch']\n    rate_a = rate_a_override if rate_a_override is not None else m['rate_a'].copy()\n    \n    # Generator-bus incidence matrix\n    Cg = np.zeros((n_bus, n_gen))\n    for g in range(n_gen):\n        Cg[m['gen_bus_idx'][g], g] = 1\n    \n    # Variables\n    Pg = cp.Variable(n_gen, nonneg=True)\n    R = cp.Variable(n_gen, nonneg=True)\n    \n    # Reserve cost (10% of marginal cost)\n    res_cost = np.maximum(cost_c1 * 0.1, 0.1)\n    \n    # Objective\n    obj = cp.sum(cp.multiply(cost_c2, cp.square(Pg)) + \n                 cp.multiply(cost_c1, Pg) + cost_c0 +\n                 cp.multiply(res_cost, R))\n    \n    constraints = []\n    # Generator limits with reserve coupling\n    constraints.append(Pg >= m['Pmin'])\n    constraints.append(Pg + R <= m['Pmax'])\n    constraints.append(R <= reserve_capacity)\n    \n    # Power balance\n    constraints.append(cp.sum(Pg) == np.sum(m['Pd']))\n    \n    # Line flow limits (only for lines with finite limits)\n    P_inj = Cg @ Pg - m['Pd']\n    active_lines = []\n    for l in range(n_branch):\n        if m['br_status'][l] > 0 and 0 < rate_a[l] < 50000:\n            flow = PTDF[l, :] @ P_inj\n            constraints.append(flow <= rate_a[l])\n            constraints.append(flow >= -rate_a[l])\n            active_lines.append(l)\n    \n    # Reserve requirement\n    constraints.append(cp.sum(R) >= reserve_req)\n    \n    prob = cp.Problem(cp.Minimize(obj), constraints)\n    prob.solve(solver=cp.ECOS, verbose=False, max_iters=500)\n    \n    if prob.status not in ['optimal', 'optimal_inaccurate']:\n        print(f\"Warning: {prob.status}\")\n        return None\n    \n    return extract_results(prob, Pg, R, P_inj, m, PTDF, rate_a, active_lines, constraints, reserve_req)\nEOF\n"]
