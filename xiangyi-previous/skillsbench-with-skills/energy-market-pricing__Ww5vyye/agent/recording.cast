[1662.044357, "o", "\u001b[?2004h> "]
[1662.04441, "o", "    cons.append(cp.sum(Pg) == np.sum(Pd))  # Power balance\r\n\u001b[?2004l\r"]
[1662.044462, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.044523, "o", "    # Line limits - only constrained lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.044548, "o", "> "]
[1662.044609, "o", "    P_inj = Cg @ Pg - Pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.044676, "o", "    constrained = active & (rate_a > 0) & (rate_a < 50000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.044732, "o", "> "]
[1662.044783, "o", "    con_idx = np.where(constrained)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1662.044832, "o", "\u001b[?2004h> "]
[1662.044878, "o", "    # Use matrix form for line constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.044919, "o", "> "]
[1662.044972, "o", "    PTDF_con = PTDF[con_idx, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045023, "o", "    rate_con = rate_a[con_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045072, "o", "    flow = PTDF_con @ P_inj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045118, "o", "    cons.append(flow <= rate_con)\r\n\u001b[?2004l\r"]
[1662.04517, "o", "\u001b[?2004h> "]
[1662.045222, "o", "    cons.append(flow >= -rate_con)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1662.045272, "o", "\u001b[?2004h> "]
[1662.045324, "o", "    cons.append(cp.sum(R) >= reserve_req)  # Reserve requirement\r\n\u001b[?2004l\r"]
[1662.04537, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.045422, "o", "> "]
[1662.045467, "o", "    prob = cp.Problem(cp.Minimize(obj), cons)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.04552, "o", "    prob.solve(solver=cp.ECOS, verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.045564, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.045622, "o", "> "]
[1662.04567, "o", "    if prob.status not in ['optimal', 'optimal_inaccurate']:\r\n\u001b[?2004l\r"]
[1662.045716, "o", "\u001b[?2004h> "]
[1662.045772, "o", "        print(f\"Status: {prob.status}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045811, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045855, "o", "    # Extract results\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.045906, "o", "> "]
[1662.045958, "o", "    Pg_v, R_v = Pg.value, R.value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.045998, "o", "    P_inj_v = Cg @ Pg_v - Pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046022, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046102, "o", "    # Duals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046176, "o", "    lam = cons[3].dual_value if cons[3].dual_value is not None else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046229, "o", "> "]
[1662.046329, "o", "    mu_pos = cons[4].dual_value if cons[4].dual_value is not None else np.zeros(len(con_idx))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046379, "o", "> "]
[1662.04648, "o", "    mu_neg = cons[5].dual_value if cons[5].dual_value is not None else np.zeros(len(con_idx))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046529, "o", "> "]
[1662.046604, "o", "    res_dual = cons[6].dual_value if cons[6].dual_value is not None else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046653, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046699, "o", "    # LMPs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046753, "o", "    lmp = np.full(n_bus, lam)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046792, "o", "    for i, l in enumerate(con_idx):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046844, "o", "> "]
[1662.046887, "o", "        lmp += (mu_pos[i] - mu_neg[i]) * PTDF[l, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.046934, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.046986, "o", "    # Binding lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.047026, "o", ">     binding = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.047074, "o", "    flows = PTDF @ P_inj_v\r\n\u001b[?2004l\r"]
[1662.047125, "o", "\u001b[?2004h>     for l in range(n_br):\r\n\u001b[?2004l\r"]
[1662.047174, "o", "\u001b[?2004h> "]
[1662.047234, "o", "        if br_status[l] > 0 and rate_a[l] > 0 and rate_a[l] < 50000:\r\n\u001b[?2004l\r"]
[1662.047282, "o", "\u001b[?2004h> "]
[1662.04734, "o", "            if abs(flows[l]) / rate_a[l] >= 0.99:\r\n\u001b[?2004l\r"]
[1662.047386, "o", "\u001b[?2004h> "]
[1662.047481, "o", "                binding.append({'from': int(branches[l,0]), 'to': int(branches[l,1]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.047536, "o", "> "]
[1662.047641, "o", "                               'flow_MW': round(abs(flows[l]),2), 'limit_MW': round(rate_a[l],2)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.047687, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.04784, "o", "    lmp_list = [{'bus': int(bus_ids[i]), 'lmp_dollars_per_MWh': round(lmp[i],4)} for i in range(n_bus)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.047892, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1662.047944, "o", "> "]
[1662.048009, "o", "    return {'total_cost_dollars_per_hour': round(prob.value,2), 'lmp_by_bus': lmp_list,\r\n\u001b[?2004l\r"]
[1662.048056, "o", "\u001b[?2004h> "]
[1662.048164, "o", "            'reserve_mcp_dollars_per_MWh': round(abs(res_dual),4), 'binding_lines': binding}\r\n\u001b[?2004l\r"]
[1662.048216, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1662.049174, "o", "\u001b[?2004hroot@9ef2a578021a:~# "]
[1662.049235, "o", "tail -20 solve_dcopf_fast.py\r\n\u001b[?2004l\r"]
[1662.050043, "o", "    res_dual = cons[6].dual_value if cons[6].dual_value is not None else 0\r\n    \r\n    # LMPs\r\n    lmp = np.full(n_bus, lam)\r\n    for i, l in enumerate(con_idx):\r\n        lmp += (mu_pos[i] - mu_neg[i]) * PTDF[l, :]\r\n    \r\n    # Binding lines\r\n    binding = []\r\n    flows = PTDF @ P_inj_v\r\n    for l in range(n_br):\r\n        if br_status[l] > 0 and rate_a[l] > 0 and rate_a[l] < 50000:\r\n            if abs(flows[l]) / rate_a[l] >= 0.99:\r\n                binding.append({'from': int(branches[l,0]), 'to': int(branches[l,1]),\r\n                               'flow_MW': round(abs(flows[l]),2), 'limit_MW': round(rate_a[l],2)})\r\n    \r\n    lmp_list = [{'bus': int(bus_ids[i]), 'lmp_dollars_per_MWh': round(lmp[i],4)} for i in range(n_bus)]\r\n    \r\n    return {'total_cost_dollars_per_hour': round(prob.value,2), 'lmp_by_bus': lmp_list,\r\n            'reserve_mcp_dollars_per_MWh': round(abs(res_dual),4), 'binding_lines': binding}\r\n"]
[1662.050183, "o", "\u001b[?2004hroot@9ef2a578021a:~# "]
