[555.557956, "i", "cat > solve_dcopf_fast.py << 'EOF'\nimport json\nimport numpy as np\nimport cvxpy as cp\n\ndef load_network(filename):\n    with open(filename) as f:\n        return json.load(f)\n\ndef solve_dcopf(data, capacity_mult=None):\n    \"\"\"Solve DC-OPF with reserve co-optimization - optimized version\"\"\"\n    buses = np.array(data['bus'])\n    gens = np.array(data['gen'])\n    branches = np.array(data['branch'])\n    gencosts = data['gencost']\n    reserve_cap = np.array(data['reserve_capacity'])\n    reserve_req = data['reserve_requirement']\n    \n    n_bus, n_gen, n_br = len(buses), len(gens), len(branches)\n    \n    # Bus mapping\n    bus_ids = buses[:, 0].astype(int)\n    bus_map = {bid: idx for idx, bid in enumerate(bus_ids)}\n    Pd = buses[:, 2]\n    \n    # Generator data\n    gen_bus_idx = np.array([bus_map[int(g[0])] for g in gens])\n    gen_status = gens[:, 7]\n    Pmax = np.where(gen_status > 0, gens[:, 8], 0)\n    Pmin = np.where(gen_status > 0, gens[:, 9], 0)\n    \n    # Branch data\n    f_idx = np.array([bus_map[int(b[0])] for b in branches])\n    t_idx = np.array([bus_map[int(b[1])] for b in branches])\n    x = branches[:, 3]\n    rate_a = branches[:, 5].copy()\n    br_status = branches[:, 10]\n    \n    # Apply capacity multiplier\n    if capacity_mult:\n        for idx, mult in capacity_mult.items():\n            rate_a[idx] *= mult\n    \n    # Build B matrix vectorized\n    active = (br_status > 0) & (x != 0)\n    b_line = np.where(active, 1.0/np.where(x!=0, x, 1), 0)\n    \n    B = np.zeros((n_bus, n_bus))\n    np.add.at(B, (f_idx[active], f_idx[active]), b_line[active])\n    np.add.at(B, (t_idx[active], t_idx[active]), b_line[active])\n    np.add.at(B, (f_idx[active], t_idx[active]), -b_line[active])\n    np.add.at(B, (t_idx[active], f_idx[active]), -b_line[active])\n    \n    # PTDF using vectorized operations\n    non_slack = np.arange(1, n_bus)\n    B_red = B[np.ix_(non_slack, non_slack)]\n    X = np.linalg.pinv(B_red)\n    \n    X_full = np.zeros((n_bus, n_bus))\n    X_full[np.ix_(non_slack, non_slack)] = X\n    \n    # Vectorized PTDF\n    PTDF = np.zeros((n_br, n_bus))\n    active_idx = np.where(active)[0]\n    for l in active_idx:\n        PTDF[l, :] = b_line[l] * (X_full[f_idx[l], :] - X_full[t_idx[l], :])\n    \n    # Cost coefficients\n    c0, c1, c2 = np.zeros(n_gen), np.zeros(n_gen), np.zeros(n_gen)\n    for i, gc in enumerate(gencosts):\n        ncost = int(gc[3])\n        if int(gc[0]) == 2 and ncost >= 2:\n            coeffs = gc[4:4+ncost]\n            c0[i] = coeffs[-1] if ncost >= 1 else 0\n            c1[i] = coeffs[-2] if ncost >= 2 else 0\n            c2[i] = coeffs[-3] if ncost >= 3 else 0\n    \n    res_cost = np.maximum(c1 * 0.1, 0.1)\nEOF\n"]
