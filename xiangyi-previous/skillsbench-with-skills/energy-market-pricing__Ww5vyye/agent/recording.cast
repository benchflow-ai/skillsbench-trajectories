[131.022984, "o", "Bus columns: {'0': 'BUS_I - bus number (1-indexed)', '1': 'BUS_TYPE - 1=PQ, 2=PV, 3=Slack', '2': 'PD - real power demand (MW)', '3': 'QD - reactive power demand (MVAr)', '4': 'GS - shunt conductance', '5': 'BS - shunt susceptance', '6': 'BUS_AREA - area number', '7': 'VM - voltage magnitude (pu)', '8': 'VA - voltage angle (degrees)', '9': 'BASE_KV - base voltage (kV)', '10': 'ZONE - loss zone', '11': 'VMAX - max voltage (pu)', '12': 'VMIN - min voltage (pu)'}\r\nGen columns: {'0': 'GEN_BUS - bus number (1-indexed)', '1': 'PG - real power output (MW)', '2': 'QG - reactive power output (MVAr)', '3': 'QMAX - max reactive power (MVAr)', '4': 'QMIN - min reactive power (MVAr)', '5': 'VG - voltage setpoint (pu)', '6': 'MBASE - machine base (MVA)', '7': 'GEN_STATUS - 1=in-service, 0=out-of-service', '8': 'PMAX - max real power output (MW)', '9': 'PMIN - min real power output (MW)'}\r\nBranch columns: {'0': 'F_BUS - from bus (1-indexed)', '1': 'T_BUS - to bus (1-indexed)', '2': 'BR_R - resistance (pu)', '3': 'BR_X - reactance (pu)', '4': 'BR_B - total line charging susceptance (pu)', '5': 'RATE_A - MVA rating A (long term)', '6': 'RATE_B - MVA rating B (short term)', '7': 'RATE_C - MVA rating C (emergency)', '8': 'TAP - transformer tap ratio', '9': 'SHIFT - transformer phase shift (degrees)', '10': 'BR_STATUS - 1=in-service, 0=out-of-service', '11': 'ANGMIN - min angle difference (degrees)', '12': 'ANGMAX - max angle difference (degrees)'}\r\nGencost columns: {'0': 'MODEL - 1=piecewise linear, 2=polynomial', '1': 'STARTUP - startup cost ($)', '2': 'SHUTDOWN - shutdown cost ($)', '3': 'NCOST - number of cost coefficients', '4+': 'COST - cost coefficients (highest order first)'}\r\nReserve columns: {'reserve_capacity': 'Maximum reserve each generator can provide (MW)', 'reserve_requirement': 'Minimum total system reserve requirement R (MW)'}\r\n"]
[131.028328, "o", "\u001b[?2004hroot@9ef2a578021a:~# "]
[140.690684, "i", "python3 -c \"\nimport json\nwith open('network.json') as f:\n    d = json.load(f)\n\n# Find branch 64-1501\nfor i, br in enumerate(d['branch']):\n    fbus, tbus = int(br[0]), int(br[1])\n    if (fbus == 64 and tbus == 1501) or (fbus == 1501 and tbus == 64):\n        print(f'Branch index {i}: from={fbus}, to={tbus}')\n        print(f'  R={br[2]}, X={br[3]}, B={br[4]}')\n        print(f'  RATE_A={br[5]}, RATE_B={br[6]}, RATE_C={br[7]}')\n        print(f'  TAP={br[8]}, SHIFT={br[9]}, STATUS={br[10]}')\n        print(f'  Full: {br}')\n\nprint('\\nReserve capacity (first 5):', d['reserve_capacity'][:5])\nprint('Number of reserve capacities:', len(d['reserve_capacity']))\n\"\n"]
