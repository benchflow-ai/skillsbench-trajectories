[130.987187, "o", "    d = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> print('Bus columns:', d['column_info']['bus'])\r\n\u001b[?2004l\r\u001b[?2004h> print('Gen columns:', d['column_info']['gen'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
