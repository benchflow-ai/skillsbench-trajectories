[1662.044147, "o", "    obj = cp.sum(cp.multiply(c2, cp.square(Pg)) + cp.multiply(c1, Pg) + c0 + cp.multiply(res_cost, R))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1662.044196, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
