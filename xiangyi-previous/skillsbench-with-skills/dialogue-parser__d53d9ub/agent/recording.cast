[37.18592, "i", "            label = f\"[CHOICE] {node_id}\"\n        # Escape quotes in label\n        label = label.replace('\"', '\\\\\"').replace('\\n', ' ')\n        shape = \"diamond\" if node[\"type\"] == \"choice\" else \"box\"\n        dot_lines.append(f'    \"{node_id}\" [label=\"{label}\" shape={shape}];')\n    \n    # Add edges\n    for edge in graph[\"edges\"]:\n        edge_label = edge[\"text\"][:20] if edge[\"text\"] else \"\"\n        edge_label = edge_label.replace('\"', '\\\\\"')\n        if edge_label:\n            dot_lines.append(f'    \"{edge[\"from\"]}\" -> \"{edge[\"to\"]}\" [label=\"{edge_label}\"];')\n        else:\n            dot_lines.append(f'    \"{edge[\"from\"]}\" -> \"{edge[\"to\"]}\";')\n    \n    dot_lines.append(\"}\")\n    return \"\\n\".join(dot_lines)\n\n\ndef validate_graph(graph):\n    \"\"\"Validate graph constraints.\"\"\"\n    node_ids = {n[\"id\"] for n in graph[\"nodes\"]}\n    edge_targets = {e[\"to\"] for e in graph[\"edges\"]}\n    \n    # Check all edge targets exist (except special cases)\n    missing = edge_targets - node_ids\n    if missing:\n        print(f\"Warnin"]
[37.185956, "o", "def parse_script(text: str):\r\n\u001b[?2004l\r            label = f\"[CHOICE] {node_id}\"\r\n        # Escape quotes in label\r\n      "]
[37.185971, "i", "g: Missing target nodes: {missing}\")\n    \n    # Check reachability from first node\n    if graph[\"nodes\"]:\n        first_node = graph[\"nodes\"][0][\"id\"]\n        reachable = set()\n        to_visit = [first_node]\n        while to_visit:\n            current = to_visit.pop()\n            if current in reachable:\n                continue\n            reachable.add(current)\n            for edge in graph[\"edges\"]:\n                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\n                    to_visit.append(edge[\"to\"])\n        \n        unreachable = node_ids - reachable\n        if unreachable:\n            print(f\"Warning: Unreachable nodes: {unreachable}\")\n    \n    return True\n\n\nif __name__ == \"__main__\":\n    # Read input\n    with open(\"/app/script.txt\", \"r\") as f:\n        script_content = f.read()\n    \n    # Parse\n    graph = parse_script(script_content)\n    \n    # Validate\n    validate_graph(graph)\n    \n    # Write JSON output\n    with open(\"/app/dialogue.json\", \"w\") as f:\n        json.dump(graph, f, "]
