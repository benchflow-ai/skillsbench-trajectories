[37.191824, "o", "\u001b[?2004h> "]
[37.191897, "o", "            nodes.append({\r\n\u001b[?2004l\r"]
[37.191918, "o", "\u001b[?2004h> "]
[37.191994, "o", "                \"id\": node_id,\r\n\u001b[?2004l\r"]
[37.192023, "o", "\u001b[?2004h> "]
[37.192137, "o", "                \"text\": \"\\n\".join(choice_texts),\r\n\u001b[?2004l\r"]
[37.192155, "o", "\u001b[?2004h"]
[37.192175, "o", "> "]
[37.192233, "o", "                \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[37.192255, "o", "\u001b[?2004h> "]
[37.192334, "o", "                \"type\": \"choice\"\r\n\u001b[?2004l\r"]
[37.19236, "o", "\u001b[?2004h> "]
[37.192392, "o", "            })\r\n\u001b[?2004l\r"]
[37.192414, "o", "\u001b[?2004h> "]
[37.192446, "o", "        else:\r\n\u001b[?2004l\r"]
[37.192467, "o", "\u001b[?2004h> "]
[37.19259, "o", "            # Line node - Speaker: text -> target\r\n\u001b[?2004l\r"]
[37.19261, "o", "\u001b[?2004h"]
[37.192632, "o", "> "]
[37.19271, "o", "            # Combine all content lines\r\n\u001b[?2004l\r"]
[37.192739, "o", "\u001b[?2004h> "]
[37.192859, "o", "            full_content = ' '.join(content_lines)\r\n\u001b[?2004l\r"]
[37.192881, "o", "\u001b[?2004h"]
[37.192903, "o", "> "]
[37.192923, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.193041, "o", "            # Parse Speaker: text -> target\r\n\u001b[?2004l\r"]
[37.193066, "o", "\u001b[?2004h> "]
[37.193263, "o", "            line_match = re.match(r'^([^:]+):\\s*(.+?)\\s*->\\s*(\\S+)\\s*$', full_content)\r\n\u001b[?2004l\r"]
[37.193271, "o", "\u001b[?2004h> "]
[37.193331, "o", "            if line_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.193422, "o", "                speaker = line_match.group(1).strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.193442, "o", "> "]
[37.19352, "o", "                text_content = line_match.group(2).strip()\r\n\u001b[?2004l\r"]
[37.19354, "o", "\u001b[?2004h"]
[37.193561, "o", "> "]
[37.193613, "o", "                target = line_match.group(3).strip()\r\n\u001b[?2004l\r"]
[37.193641, "o", "\u001b[?2004h> "]
[37.193668, "o", "                \r\n\u001b[?2004l\r"]
[37.193694, "o", "\u001b[?2004h> "]
[37.193719, "o", "                nodes.append({\r\n\u001b[?2004l\r"]
[37.193748, "o", "\u001b[?2004h> "]
[37.193787, "o", "                    \"id\": node_id,\r\n\u001b[?2004l\r"]
[37.193815, "o", "\u001b[?2004h> "]
[37.193867, "o", "                    \"text\": text_content,\r\n\u001b[?2004l\r"]
[37.193896, "o", "\u001b[?2004h> "]
[37.193942, "o", "                    \"speaker\": speaker,\r\n\u001b[?2004l\r"]
[37.193964, "o", "\u001b[?2004h> "]
[37.19401, "o", "                    \"type\": \"line\"\r\n\u001b[?2004l\r"]
[37.194042, "o", "\u001b[?2004h> "]
[37.194067, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.194088, "o", "> "]
[37.194109, "o", "                \r\n\u001b[?2004l\r"]
[37.19413, "o", "\u001b[?2004h> "]
[37.194167, "o", "                edges.append({\r\n\u001b[?2004l\r"]
[37.194194, "o", "\u001b[?2004h> "]
[37.194237, "o", "                    \"from\": node_id,\r\n\u001b[?2004l\r"]
[37.194266, "o", "\u001b[?2004h"]
[37.194294, "o", "> "]
[37.194321, "o", "                    \"to\": target,\r\n\u001b[?2004l\r"]
[37.194334, "o", "\u001b[?2004h> "]
[37.194375, "o", "                    \"text\": \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.194391, "o", "> "]
[37.19442, "o", "                })\r\n\u001b[?2004l\r"]
[37.194449, "o", "\u001b[?2004h> "]
[37.194475, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.194552, "o", "                # Fallback - just store the text\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.194568, "o", "> "]
[37.19461, "o", "                nodes.append({\r\n\u001b[?2004l\r"]
[37.194636, "o", "\u001b[?2004h> "]
[37.194677, "o", "                    \"id\": node_id,\r\n\u001b[?2004l\r"]
[37.1947, "o", "\u001b[?2004h> "]
[37.194756, "o", "                    \"text\": full_content,\r\n\u001b[?2004l\r"]
[37.194785, "o", "\u001b[?2004h> "]
[37.194823, "o", "                    \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[37.194848, "o", "\u001b[?2004h> "]
[37.194899, "o", "                    \"type\": \"line\"\r\n\u001b[?2004l\r"]
[37.194924, "o", "\u001b[?2004h> "]
[37.194949, "o", "                })\r\n\u001b[?2004l\r"]
[37.194971, "o", "\u001b[?2004h> "]
[37.194997, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.195026, "o", "> "]
[37.195065, "o", "    # Add End node if referenced but not defined\r\n\u001b[?2004l\r"]
[37.195092, "o", "\u001b[?2004h> "]
[37.195147, "o", "    edge_targets = {e[\"to\"] for e in edges}\r\n\u001b[?2004l\r"]
[37.195177, "o", "\u001b[?2004h> "]
[37.195245, "o", "    if \"End\" in edge_targets and \"End\" not in node_ids:\r\n\u001b[?2004l\r"]
[37.195269, "o", "\u001b[?2004h> "]
[37.195296, "o", "        nodes.append({\r\n\u001b[?2004l\r"]
[37.195324, "o", "\u001b[?2004h> "]
[37.195368, "o", "            \"id\": \"End\",\r\n\u001b[?2004l\r"]
[37.195395, "o", "\u001b[?2004h> "]
[37.195436, "o", "            \"text\": \"\",\r\n\u001b[?2004l\r"]
[37.195465, "o", "\u001b[?2004h> "]
[37.195493, "o", "            \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[37.19552, "o", "\u001b[?2004h> "]
[37.195549, "o", "            \"type\": \"line\"\r\n\u001b[?2004l\r"]
[37.195569, "o", "\u001b[?2004h> "]
[37.195588, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.19561, "o", "> "]
[37.195639, "o", "        node_ids.add(\"End\")\r\n\u001b[?2004l\r"]
[37.195663, "o", "\u001b[?2004h> "]
[37.195686, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.195745, "o", "    return {\"nodes\": nodes, \"edges\": edges}\r\n\u001b[?2004l\r"]
[37.195769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.195797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.195821, "o", "\u001b[?2004h> "]
[37.195843, "o", "def generate_dot(graph):\r\n\u001b[?2004l\r"]
[37.195871, "o", "\u001b[?2004h"]
[37.195892, "o", "> "]
[37.195929, "o", "    \"\"\"Generate DOT format visualization.\"\"\"\r\n\u001b[?2004l\r"]
[37.195956, "o", "\u001b[?2004h> "]
[37.196002, "o", "    dot_lines = [\"digraph dialogue {\"]\r\n\u001b[?2004l\r"]
[37.196032, "o", "\u001b[?2004h> "]
[37.196077, "o", "    dot_lines.append(\"    rankdir=TB;\")\r\n\u001b[?2004l\r"]
[37.196098, "o", "\u001b[?2004h> "]
[37.196161, "o", "    dot_lines.append(\"    node [shape=box];\")\r\n\u001b[?2004l\r"]
[37.196186, "o", "\u001b[?2004h> "]
[37.196208, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.196227, "o", "    # Add nodes\r\n\u001b[?2004l\r"]
[37.196246, "o", "\u001b[?2004h"]
[37.196268, "o", "> "]
[37.19629, "o", "    for node in graph[\"nodes\"]:\r\n\u001b[?2004l\r"]
[37.196311, "o", "\u001b[?2004h> "]
[37.19635, "o", "        node_id = node[\"id\"]\r\n\u001b[?2004l\r"]
[37.196377, "o", "\u001b[?2004h> "]
[37.196403, "o", "        label = node_id\r\n\u001b[?2004l\r"]
[37.196424, "o", "\u001b[?2004h> "]
[37.19646, "o", "        if node[\"speaker\"]:\r\n\u001b[?2004l\r"]
[37.196489, "o", "\u001b[?2004h> "]
[37.196571, "o", "            label = f\"{node['speaker']}: {node['text'][:30]}...\"\r\n\u001b[?2004l\r"]
[37.196591, "o", "\u001b[?2004h> "]
[37.196641, "o", "        elif node[\"text\"]:\r\n\u001b[?2004l\r"]
[37.196651, "o", "\u001b[?2004h> "]
[37.196713, "o", "            label = node[\"text\"][:40]\r\n\u001b[?2004l\r"]
[37.196733, "o", "\u001b[?2004h> "]
[37.196783, "o", "        if node[\"type\"] == \"choice\":\r\n\u001b[?2004l\r"]
[37.196802, "o", "\u001b[?2004h> "]
[37.196867, "o", "            label = f\"[CHOICE] {node_id}\"\r\n\u001b[?2004l\r"]
[37.196892, "o", "\u001b[?2004h> "]
[37.196932, "o", "        # Escape quotes in label\r\n\u001b[?2004l\r"]
[37.196952, "o", "\u001b[?2004h> "]
[37.197037, "o", "        label = label.replace('\"', '\\\\\"').replace('\\n', ' ')\r\n\u001b[?2004l\r"]
[37.197065, "o", "\u001b[?2004h> "]
[37.197147, "o", "        shape = \"diamond\" if node[\"type\"] == \"choice\" else \"box\"\r\n\u001b[?2004l\r"]
[37.197168, "o", "\u001b[?2004h> "]
[37.197282, "o", "        dot_lines.append(f'    \"{node_id}\" [label=\"{label}\" shape={shape}];')\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.197302, "o", "> "]
[37.197322, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.197343, "o", "> "]
[37.197362, "o", "    # Add edges\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.197406, "o", "    for edge in graph[\"edges\"]:\r\n\u001b[?2004l\r"]
[37.197427, "o", "\u001b[?2004h> "]
[37.197514, "o", "        edge_label = edge[\"text\"][:20] if edge[\"text\"] else \"\"\r\n\u001b[?2004l\r"]
[37.197536, "o", "\u001b[?2004h> "]
[37.197607, "o", "        edge_label = edge_label.replace('\"', '\\\\\"')\r\n\u001b[?2004l\r"]
[37.197639, "o", "\u001b[?2004h> "]
[37.197658, "o", "        if edge_label:\r\n\u001b[?2004l\r"]
[37.197679, "o", "\u001b[?2004h> "]
[37.197812, "o", "            dot_lines.append(f'    \"{edge[\"from\"]}\" -> \"{edge[\"to\"]}\" [label=\"{edge_label}\"];')\r\n\u001b[?2004l\r"]
[37.197837, "o", "\u001b[?2004h> "]
[37.197861, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.197887, "o", "> "]
[37.197978, "o", "            dot_lines.append(f'    \"{edge[\"from\"]}\" -> \"{edge[\"to\"]}\";')\r\n\u001b[?2004l\r"]
[37.197996, "o", "\u001b[?2004h> "]
[37.19802, "o", "    \r\n\u001b[?2004l\r"]
[37.198046, "o", "\u001b[?2004h> "]
[37.198078, "o", "    dot_lines.append(\"}\")\r\n\u001b[?2004l\r"]
[37.198106, "o", "\u001b[?2004h> "]
[37.198134, "o", "    return \"\\n\".join(dot_lines)\r\n\u001b[?2004l\r"]
[37.198145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.198174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.198192, "o", "> "]
[37.198225, "o", "def validate_graph(graph):\r\n\u001b[?2004l\r"]
[37.198245, "o", "\u001b[?2004h> "]
[37.198298, "o", "    \"\"\"Validate graph constraints.\"\"\"\r\n\u001b[?2004l\r"]
[37.198316, "o", "\u001b[?2004h> "]
[37.198386, "o", "    node_ids = {n[\"id\"] for n in graph[\"nodes\"]}\r\n\u001b[?2004l\r"]
[37.198396, "o", "\u001b[?2004h> "]
[37.198479, "o", "    edge_targets = {e[\"to\"] for e in graph[\"edges\"]}\r\n\u001b[?2004l\r"]
[37.198498, "o", "\u001b[?2004h> "]
[37.198518, "o", "    \r\n\u001b[?2004l\r"]
[37.198549, "o", "\u001b[?2004h> "]
[37.198611, "o", "    # Check all edge targets exist (except special cases)\r\n\u001b[?2004l\r"]
[37.198629, "o", "\u001b[?2004h> "]
[37.198683, "o", "    missing = edge_targets - node_ids\r\n\u001b[?2004l\r"]
[37.198707, "o", "\u001b[?2004h> "]
[37.198739, "o", "    if missing:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.19883, "o", "        print(f\"Warning: Missing target nodes: {missing}\")\r\n\u001b[?2004l\r"]
[37.198848, "o", "\u001b[?2004h> "]
[37.198875, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.198934, "o", "    # Check reachability from first node\r\n\u001b[?2004l\r"]
[37.198952, "o", "\u001b[?2004h> "]
[37.198985, "o", "    if graph[\"nodes\"]:\r\n\u001b[?2004l\r"]
[37.199015, "o", "\u001b[?2004h> "]
[37.199067, "o", "        first_node = graph[\"nodes\"][0][\"id\"]\r\n\u001b[?2004l\r"]
[37.199088, "o", "\u001b[?2004h> "]
[37.199123, "o", "        reachable = set()\r\n\u001b[?2004l\r"]
[37.199152, "o", "\u001b[?2004h> "]
[37.199186, "o", "        to_visit = [first_node]\r\n\u001b[?2004l\r"]
[37.199212, "o", "\u001b[?2004h> "]
[37.19924, "o", "        while to_visit:\r\n\u001b[?2004l\r"]
[37.199259, "o", "\u001b[?2004h> "]
[37.19931, "o", "            current = to_visit.pop()\r\n\u001b[?2004l\r"]
[37.199331, "o", "\u001b[?2004h> "]
[37.19939, "o", "            if current in reachable:\r\n\u001b[?2004l\r"]
[37.199413, "o", "\u001b[?2004h> "]
[37.199443, "o", "                continue\r\n\u001b[?2004l\r"]
[37.199468, "o", "\u001b[?2004h> "]
[37.199511, "o", "            reachable.add(current)\r\n\u001b[?2004l\r"]
[37.199538, "o", "\u001b[?2004h> "]
[37.199586, "o", "            for edge in graph[\"edges\"]:\r\n\u001b[?2004l\r"]
[37.199604, "o", "\u001b[?2004h> "]
[37.199712, "o", "                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\r\n\u001b[?2004l\r"]
[37.199722, "o", "\u001b[?2004h> "]
[37.199798, "o", "                    to_visit.append(edge[\"to\"])\r\n\u001b[?2004l\r"]
[37.199816, "o", "\u001b[?2004h> "]
[37.199841, "o", "        \r\n\u001b[?2004l\r"]
[37.19987, "o", "\u001b[?2004h> "]
[37.199912, "o", "        unreachable = node_ids - reachable\r\n\u001b[?2004l\r"]
[37.199933, "o", "\u001b[?2004h> "]
[37.199965, "o", "        if unreachable:\r\n\u001b[?2004l\r"]
[37.199984, "o", "\u001b[?2004h> "]
[37.200073, "o", "            print(f\"Warning: Unreachable nodes: {unreachable}\")\r\n\u001b[?2004l\r"]
[37.200094, "o", "\u001b[?2004h> "]
[37.200119, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.20014, "o", "> "]
[37.200159, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.200185, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[37.200215, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[37.200238, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[37.200261, "o", "\u001b[?2004h> "]
[37.20028, "o", "    # Read input\r\n\u001b[?2004l\r"]
[37.200299, "o", "\u001b[?2004h> "]
[37.200361, "o", "    with open(\"/app/script.txt\", \"r\") as f:\r\n\u001b[?2004l\r"]
[37.200387, "o", "\u001b[?2004h> "]
[37.200427, "o", "        script_content = f.read()\r\n\u001b[?2004l\r"]
[37.200448, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[37.200471, "o", "\u001b[?2004h"]
[37.200496, "o", "> "]
[37.200522, "o", "    # Parse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.200575, "o", "    graph = parse_script(script_content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.200602, "o", "> "]
[37.200628, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.200654, "o", "    # Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.200691, "o", "    validate_graph(graph)\r\n\u001b[?2004l\r"]
[37.200719, "o", "\u001b[?2004h> "]
[37.20074, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.200766, "o", "    # Write JSON output\r\n\u001b[?2004l\r"]
[37.200785, "o", "\u001b[?2004h> "]
[37.200861, "o", "    with open(\"/app/dialogue.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.200889, "o", "> "]
[37.20093, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r"]
[37.200951, "o", "\u001b[?2004h> "]
[37.200973, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.201006, "o", "    # Write DOT output\r\n\u001b[?2004l\r"]
[37.201034, "o", "\u001b[?2004h> "]
[37.201078, "o", "    dot_content = generate_dot(graph)\r\n\u001b[?2004l\r"]
[37.201105, "o", "\u001b[?2004h> "]
[37.201245, "o", "    with open(\"/app/dialogue.dot\", \"w\") as f:\r\n\u001b[?2004l\r"]
[37.201267, "o", "\u001b[?2004h> "]
[37.201327, "o", "        f.write(dot_content)\r\n\u001b[?2004l\r"]
[37.201349, "o", "\u001b[?2004h> "]
[37.201372, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.201511, "o", "    print(f\"Parsed {len(graph['nodes'])} nodes and {len(graph['edges'])} edges\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.201625, "o", "    print(\"Output written to /app/dialogue.json and /app/dialogue.dot\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.201646, "o", "EOF\r\n\u001b[?2004l\r"]
[37.202901, "o", "\u001b[?2004hroot@e2a5438f7382:/app# "]
[42.140599, "i", "python3 /app/solution.py\n"]
[42.140768, "o", "python3 /app/solution.py\r\n\u001b[?2004l\r"]
