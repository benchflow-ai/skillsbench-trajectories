[48.353491, "o", "     \"id\": \"InterceptNote\",\r\n      \"text\": \"You dare?!\",\r\n      \"speaker\": \"Stranger\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"PickpocketAttempt\",\r\n      \"text\": \"[Sleight of Hand] Swiftly grab the pouch.\\n[Distraction] Bump into him accidentally.\\nAbandon the attempt.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"PickpocketSuccess\",\r\n      \"text\": \"50 gold pieces heavier, you slip away. The merchant hasn't noticed... yet.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n"]
