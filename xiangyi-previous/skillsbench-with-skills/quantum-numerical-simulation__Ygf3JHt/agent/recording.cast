[142.631988, "i", "cat << 'EOF' > simulation.py\nimport numpy as np\nfrom qutip import tensor, destroy, qeye, sigmap, sigmam, sigmaz, steadystate, wigner, ptrace\n\n# Parameters\nN = 4\nomega0 = 1.0\nomegac = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Operators\n# Cavity is the first subsystem\na = tensor(destroy(n_max + 1), qeye([2]*N))\nadag = a.dag()\n\ndef get_spin_op(op, i):\n    # ops list: [cavity, spin0, spin1, spin2, spin3]\n    ops = [qeye(n_max + 1)] + [qeye(2)]*N\n    ops[i+1] = op\n    return tensor(ops)\n\nsz = [get_spin_op(sigmaz(), i) for i in range(N)]\nsp = [get_spin_op(sigmap(), i) for i in range(N)]\nsm = [get_spin_op(sigmam(), i) for i in range(N)]\n\nJz = 0.5 * sum(sz)\nJp = sum(sp)\nJm = sum(sm)\n\nH = omega0 * Jz + omegac * adag * a + g * (adag + a) * (Jp + Jm)\n\n# Grid for Wigner function\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\ndef run_case(case_num, gamma_phi, gamma_up, gamma_down, gamma_coll_up, gamma_coll_down):\n    print(f\"Running Case {case_num}...\")\n    c_ops = [np.sqrt(kappa) * a]\n    # Local terms\n    for i in range(N):\n        if gamma_phi > 0:\n            c_ops.append(np.sqrt(gamma_phi) * sz[i])\n        if gamma_up > 0:\n            c_ops.append(np.sqrt(gamma_up) * sp[i])\n        if gamma_down > 0:\n            c_ops.append(np.sqrt(gamma_down) * sm[i])\n    # Collective terms\n    if gamma_coll_up > 0:\n        c_ops.append(np.sqrt(gamma_coll_up) * Jp)\n    if gamma_coll_down > 0:\n        c_ops.append(np.sqrt(gamma_coll_down) * Jm)\n\n    rho_ss = steadystate(H, c_ops)\n    rho_cavity = ptrace(rho_ss, 0)\n    \n    W = wigner(rho_cavity, xvec, pvec)\n    np.savetxt(f\"{case_num}.csv\", W, delimiter=\",\")\n    print(f\"Finished Case {case_num}.\")\n\n# Case 1: Local de-phasing & local pumping\nrun_case(1, 0.01, 0.1, 0.0, 0.0, 0.0)\n\n# Case 2: Local de-phasing & local emission\nrun_case(2, 0.01, 0.0, 0.1, 0.0, 0.0)\n\n# Case 3: Local de-phasing & local emission & collective pumping\nrun_case(3, 0.01, 0.0, 0.1, 0.1, 0.0)\n\n# Case 4: Local de-phasing & local emission & collective emission\nrun_case(4, 0.01, 0.0, 0.1, 0.0, 0.1)\nEOF\n"]
