[143.864207, "o", "/usr/local/lib/python3.10/site-packages/qutip/__init__.py:96: UserWarning: matplotlib not found: Graphics will not work.\r\n  warnings.warn(\"matplotlib not found: Graphics will not work.\")\r\n"]
[144.425627, "o", "Running Case 1...\r\n"]
[425.462167, "i", "\u0003"]
