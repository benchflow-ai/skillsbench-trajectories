cat << 'EOF' > simulation.py
import numpy as np
from qutip import tensor, destroy, qeye, sigmap, sigmam, sigmaz, steadystate, wigner, ptrace
import sys

N = 4
omega0 = 1.0
omegac = 1.0
g = 2.0 / np.sqrt(N)
kappa = 1.0
n_max = 16

# Operators
a = tensor(destroy(n_max + 1), qeye([2]*N))
adag = a.dag()

def get_spin_op(op, i):
    ops = [qeye(n_max + 1)] + [qeye(2)]*N
    ops[i+1] = op
    return tensor(ops)

sz = [get_spin_op(sigmaz(), i) for i in range(N)]
sp = [get_spin_op(sigmap(), i) for i in range(N)]
sm = [get_spin_op(sigmam(), i) for i in range(N)]

Jz = 0.5 * sum(sz)
Jp = sum(sp)
Jm = sum(sm)

H = omega0 * Jz + omegac * adag * a + g * (adag + a) * (Jp + Jm)

xvec = np.linspace(-6, 6, 1000)
pvec = np.linspace(-6, 6, 1000)

def run_case(case_num, gamma_phi, gamma_up, gamma_down, gamma_coll_up, gamma_coll_down):
    print(f"Starting Case {case_num}...", flush=True)
    c_ops = [np.sqrt(kappa) * a]
    for i in range(N):
        if gamma_phi > 0: c_ops.append(np.sqrt(gamma_phi) * sz[i])
        if gamma_up > 0: c_ops.append(np.sqrt(gamma_up) * sp[i])
        if gamma_down > 0: c_ops.append(np.sqrt(gamma_down) * sm[i])
    if gamma_coll_up > 0: c_ops.append(np.sqrt(gamma_coll_up) * Jp)
    if gamma_coll_down > 0: c_ops.append(np.sqrt(gamma_coll_down) * Jm)

    rho_ss = steadystate(H, c_ops, method='iterative-lgmres')
    rho_cavity = ptrace(rho_ss, 0)
    W = wigner(rho_cavity, xvec, pvec)
    np.savetxt(f"{case_num}.csv", W, delimiter=",")
    print(f"Finished Case {case_num}.", flush=True)

run_case(1, 0.01, 0.1, 0.0, 0.0, 0.0)
run_case(2, 0.01, 0.0, 0.1, 0.0, 0.0)
run_case(3, 0.01, 0.0, 0.1, 0.1, 0.0)
run_case(4, 0.01, 0.0, 0.1, 0.0, 0.1)
print("All cases completed.", flush=True)
EOF
