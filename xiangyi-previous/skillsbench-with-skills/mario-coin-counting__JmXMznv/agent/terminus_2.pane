[?2004l[?2004h> import cv2, glob, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> frames = sorted(glob.glob('/root/keyframes_*.png'))
[?2004l[?2004h> templates = {name: cv2.imread(f'/root/{name}.png', cv2.IMREAD_GRAYSCALE) for name in ['coin','enemy','turtle']}
[?2004l[?2004h> 
[?2004l[?2004h> # simple NMS
[?2004l[?2004h> 
[?2004l[?2004h> def nms(boxes, scores, thresh=0.3):
[?2004l[?2004h>     if len(boxes)==0:
[?2004l[?2004h>         return []
[?2004l[?2004h>     boxes = np.array(boxes)
[?2004l[?2004h>     scores = np.array(scores)
[?2004l[?2004h>     x1 = boxes[:,0]
[?2004l[?2004h>     y1 = boxes[:,1]
[?2004l[?2004h>     x2 = boxes[:,2]
[?2004l[?2004h>     y2 = boxes[:,3]
[?2004l[?2004h>     areas = (x2-x1+1)*(y2-y1+1)
[?2004l[?2004h>     order = scores.argsort()[::-1]
[?2004l[?2004h>     keep = []
[?2004l[?2004h>     while order.size>0:
[?2004l[?2004h>         i = order[0]
[?2004l[?2004h>         keep.append(i)
[?2004l[?2004h>         xx1 = np.maximum(x1[i], x1[order[1:]])
[?2004l[?2004h>         yy1 = np.maximum(y1[i], y1[order[1:]])
[?2004l[?2004h>         xx2 = np.minimum(x2[i], x2[order[1:]])
[?2004l[?2004h>         yy2 = np.minimum(y2[i], y2[order[1:]])
[?2004l[?2004h>         w = np.maximum(0.0, xx2-xx1+1)
[?2004l[?2004h>         h = np.maximum(0.0, yy2-yy1+1)
[?2004l[?2004h>         inter = w*h
[?2004l[?2004h>         ovr = inter/(areas[i]+areas[order[1:]]-inter)
[?2004l[?2004h>         inds = np.where(ovr<=thresh)[0]
[?2004l[?2004h>         order = order[inds+1]
[?2004l[?2004h>     return keep
[?2004l[?2004h> 
[?2004l[?2004h> thresholds = {'coin':[0.7,0.8,0.85,0.9], 'enemy':[0.7,0.8,0.9,0.95], 'turtle':[0.7,0.8,0.9,0.95]}
[?2004l[?2004h> 
[?2004l[?2004h> for name, templ in templates.items():
[?2004l[?2004h>     print('Template', name)
[?2004l[?2004h>     for th in thresholds[name]:
[?2004l[?2004h>         counts=[]
[?2004l[?2004h>         for fn in frames:
[?2004l[?2004h>             img=cv2.imread(fn, cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h>             res=cv2.matchTemplate(img, templ, cv2.TM_CCOEFF_NORMED)
[?2004l[?2004h>             loc = np.where(res>=th)
[?2004l[?2004h>             h,w = templ.shape
[?2004l[?2004h>             boxes=[]; scores=[]
[?2004l[?2004h>             for pt in zip(*loc[::-1]):
[?2004l[?2004h>                 boxes.append([pt[0], pt[1], pt[0]+w-1, pt[1]+h-1])
[?2004l[?2004h>                 scores.append(res[pt[1], pt[0]])
[?2004l[?2004h>             keep = nms(boxes, scores, thresh=0.3)
[?2004l[?2004h>             counts.append(len(keep))
[?2004l[?2004h>         print(' th', th, 'counts', counts)
[?2004l[?2004h>     print()
