[107.889269, "i", "python3 - <<'PY'\nimport cv2, glob, numpy as np\nframes = sorted(glob.glob('/root/keyframes_*.png'))\ntemplates = {name: cv2.imread(f'/root/{name}.png', cv2.IMREAD_GRAYSCALE) for name in ['coin','enemy','turtle']}\nfor fn in frames:\n    img = cv2.imread(fn, cv2.IMREAD_GRAYSCALE)\n    print(fn)\n    for name, templ in templates.items():\n        res = cv2.matchTemplate(img, templ, cv2.TM_CCOEFF_NORMED)\n        flat = np.sort(res.ravel())\n        top = flat[-10:][::-1]\n        print(' ', name, 'top', [round(v,3) for v in top])\n    print()\nPY\n"]
