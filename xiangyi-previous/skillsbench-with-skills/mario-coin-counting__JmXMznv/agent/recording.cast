[139.362988, "o", "\u001b[?2004h> "]
[139.363018, "o", "        order = order[inds+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363069, "o", "    return keep\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.363147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363193, "o", "def count_matches(img, templ, threshold):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363289, "o", "    res = cv2.matchTemplate(img, templ, cv2.TM_CCOEFF_NORMED)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363349, "o", "    loc = np.where(res>=threshold)\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.363377, "o", "> "]
[139.363438, "o", "    h, w = templ.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.363487, "o", ">     boxes=[]; scores=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363536, "o", "    for pt in zip(*loc[::-1]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.363571, "o", "> "]
[139.363625, "o", "        boxes.append([pt[0], pt[1], pt[0]+w-1, pt[1]+h-1])\r\n\u001b[?2004l\r"]
[139.363671, "o", "\u001b[?2004h> "]
[139.36372, "o", "        scores.append(res[pt[1], pt[0]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.363755, "o", "> "]
[139.363805, "o", "    keep = nms(boxes, scores, thresh=0.3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.363851, "o", "    return len(keep)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.363875, "o", "> rows=[]\r\n\u001b[?2004l\r"]
[139.363935, "o", "\u001b[?2004h> "]
[139.363974, "o", "for fn in frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364013, "o", "    img = cv2.imread(fn, cv2.IMREAD_GRAYSCALE)\r\n\u001b[?2004l\r"]
[139.364048, "o", "\u001b[?2004h>     counts={}\r\n\u001b[?2004l\r"]
[139.364099, "o", "\u001b[?2004h> "]
[139.36415, "o", "    for key, templ in templates.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364252, "o", "        counts[key]=count_matches(img, templ, thresholds[key])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364385, "o", "    rows.append([fn, counts['coins'], counts['enemies'], counts['turtles']])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.36444, "o", "\u001b[?2004h> "]
[139.364495, "o", "# write CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364549, "o", "with open('/root/counting_results.csv','w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364591, "o", "    writer=csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364716, "o", "    writer.writerow(['frame_id','coins','enemies','turtles'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364757, "o", "    for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364867, "o", "        writer.writerow(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364948, "o", "print('\\n'.join(str(r) for r in rows))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.364975, "o", "print('wrote /root/counting_results.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.365004, "o", "> PY\r\n\u001b[?2004l\r"]
[140.348373, "o", "['/root/keyframes_001.png', 0, 0, 0]\r\n['/root/keyframes_002.png', 2, 2, 0]\r\n['/root/keyframes_003.png', 0, 0, 0]\r\n['/root/keyframes_004.png', 3, 0, 0]\r\n['/root/keyframes_005.png', 4, 0, 1]\r\n['/root/keyframes_006.png', 1, 0, 0]\r\n['/root/keyframes_007.png', 1, 0, 1]\r\n['/root/keyframes_008.png', 0, 0, 1]\r\nwrote /root/counting_results.csv\r\n"]
[140.435066, "o", "\u001b[?2004hroot@d5e4dcf1fd29:~# "]
[144.757855, "i", "cat /root/counting_results.csv\n"]
[144.758655, "o", "cat /root/counting_results.csv\r\n\u001b[?2004l\r"]
[144.759117, "o", "frame_id,coins,enemies,turtles\r\r\n/root/keyframes_001.png,0,0,0\r\r\n/root/keyframes_002.png,2,2,0\r\r\n/root/keyframes_003.png,0,0,0\r\r\n/root/keyframes_004.png,3,0,0\r\r\n/root/keyframes_005.png,4,0,1\r\r\n/root/keyframes_006.png,1,0,0\r\r\n/root/keyframes_007.png,1,0,1\r\r\n/root/keyframes_008.png,0,0,1\r\r\n"]
[144.759171, "o", "\u001b[?2004hroot@d5e4dcf1fd29:~# "]
