[187.939643, "o", ">     rects, weights = hog.detectMultiScale(frame_small, winStride=(4,4), padding=(8,8), scale=1.05)\r\n\u001b[?2004l\r\u001b[?2004h>     boxes=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for (x,y,w,h) in rects:\r\n\u001b[?2004l\r\u001b[?2004h>         if h < 50:  # filter tiny\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         boxes.append([x,y,x+w,y+h])\r\n\u001b[?2004l\r\u001b[?2004h>     boxes = nms(boxes, 0.6)\r\n\u001b[?2004l\r\u001b[?2004h>     ct.update(boxes)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> print('count', len(ct.total_ids))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
