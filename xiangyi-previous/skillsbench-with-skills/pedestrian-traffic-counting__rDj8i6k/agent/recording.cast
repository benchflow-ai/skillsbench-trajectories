[633.120925, "o", "> "]
[633.121025, "o", "                    objectID=objectIDs[row]\r\n\u001b[?2004l\r"]
[633.121178, "o", "\u001b[?2004h> "]
[633.121308, "o", "                    self.disappeared[objectID]+=1\r\n\u001b[?2004l\r"]
[633.121347, "o", "\u001b[?2004h> "]
[633.121522, "o", "                    if self.disappeared[objectID] > self.maxDisappeared:\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.121559, "o", "> "]
[633.121673, "o", "                        self.deregister(objectID)\r\n\u001b[?2004l\r"]
[633.121707, "o", "\u001b[?2004h> "]
[633.121746, "o", "            else:\r\n\u001b[?2004l\r"]
[633.122056, "o", "\u001b[?2004h> "]
[633.122195, "o", "                for col in unusedCols:"]
[633.122261, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.122303, "o", "> "]
[633.122467, "o", "                    self.register(inputCentroids[col])"]
[633.122527, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.122586, "o", "> \r\n\u001b[?2004l\r"]
[633.122625, "o", "\u001b[?2004h> "]
[633.122706, "o", "video='test1.mp4'\r\n"]
[633.122747, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[633.122863, "o", "cap=cv2.VideoCapture(video)"]
[633.122901, "o", "\r\n\u001b[?2004l\r"]
[633.122938, "o", "\u001b[?2004h> "]
[633.123195, "o", "fgbg=cv2.createBackgroundSubtractorMOG2(history=500, varThreshold=50, detectShadows=False)"]
[633.123313, "o", "\r\n\u001b[?2004l\r"]
[633.123347, "o", "\u001b[?2004h> "]
[633.12352, "o", "ct=CentroidTracker(maxDisappeared=40, maxDistance=60)"]
[633.123584, "o", "\r\n\u001b[?2004l\r"]
[633.123621, "o", "\u001b[?2004h> "]
[633.123656, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.12369, "o", "> "]
[633.123752, "o", "frame_idx=0\r\n\u001b[?2004l\r"]
[633.123791, "o", "\u001b[?2004h> "]
[633.123855, "o", "while True:\r\n\u001b[?2004l\r"]
[633.123916, "o", "\u001b[?2004h> "]
[633.124008, "o", "    ret, frame = cap.read()"]
[633.124042, "o", "\r\n"]
[633.124074, "o", "\u001b[?2004l\r\u001b[?2004h"]
[633.124108, "o", "> "]
[633.124174, "o", "    if not ret:\r\n\u001b[?2004l\r"]
[633.124235, "o", "\u001b[?2004h> "]
[633.124298, "o", "        break"]
[633.124331, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.124369, "o", "> "]
[633.124443, "o", "    frame_idx+=1"]
[633.124471, "o", "\r\n\u001b[?2004l\r"]
[633.124505, "o", "\u001b[?2004h> "]
[633.124576, "o", "    width=640\r\n\u001b[?2004l\r\u001b[?2004h> "]
[633.124666, "o", "    scale=width/frame.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.12473, "o", "> "]
[633.124977, "o", "    frame_small=cv2.resize(frame, (width, int(frame.shape[0]*scale)))\r\n\u001b[?2004l\r"]
[633.125075, "o", "\u001b[?2004h> "]
[633.125178, "o", "    fgmask=fgbg.apply(frame_small)\r\n\u001b[?2004l\r"]
[633.125248, "o", "\u001b[?2004h> "]
[633.125353, "o", "    fgmask=cv2.medianBlur(fgmask,5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.125391, "o", "> "]
[633.125536, "o", "    _,fgmask=cv2.threshold(fgmask,200,255,cv2.THRESH_BINARY)\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.125566, "o", "> "]
[633.125751, "o", "    fgmask=cv2.morphologyEx(fgmask, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))\r\n\u001b[?2004l\r"]
[633.126025, "o", "\u001b[?2004h> "]
[633.126245, "o", "    contours,_=cv2.findContours(fgmask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\r\n\u001b[?2004l\r"]
[633.126285, "o", "\u001b[?2004h> "]
[633.126323, "o", "    centroids=[]\r\n\u001b[?2004l\r"]
[633.126453, "o", "\u001b[?2004h"]
[633.126491, "o", "> "]
[633.126568, "o", "    for c in contours:\r\n"]
[633.126602, "o", "\u001b[?2004l\r\u001b[?2004h"]
[633.126631, "o", "> "]
[633.126743, "o", "        area=cv2.contourArea(c)"]
[633.126779, "o", "\r\n\u001b[?2004l\r"]
[633.126814, "o", "\u001b[?2004h> "]
[633.126926, "o", "        if area < 300 or area > 5000:\r\n\u001b[?2004l\r"]
[633.127001, "o", "\u001b[?2004h> "]
[633.127056, "o", "            continue\r\n\u001b[?2004l\r"]
[633.127094, "o", "\u001b[?2004h> "]
[633.127245, "o", "        x,y,w,h=cv2.boundingRect(c)\r\n\u001b[?2004l\r"]
[633.127315, "o", "\u001b[?2004h> "]
[633.127403, "o", "        if h < 20 or w < 10:\r\n\u001b[?2004l\r"]
[633.127441, "o", "\u001b[?2004h> "]
[633.127546, "o", "            continue"]
[633.127581, "o", "\r\n\u001b[?2004l\r"]
[633.127612, "o", "\u001b[?2004h"]
[633.127651, "o", "> "]
[633.127726, "o", "        if h/w < 1.2:"]
[633.127764, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.127798, "o", "> "]
[633.12787, "o", "            continue"]
[633.127906, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.127945, "o", "> "]
[633.128091, "o", "        centroids.append((int(x+w/2), int(y+h/2)))"]
[633.128154, "o", "\r\n\u001b[?2004l\r"]
[633.128191, "o", "\u001b[?2004h> "]
[633.128284, "o", "    ct.update(centroids)"]
[633.128325, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.128367, "o", "> "]
[633.128458, "o", "    if frame_idx % 300 == 0:"]
[633.12849, "o", "\r\n\u001b[?2004l\r"]
[633.128526, "o", "\u001b[?2004h"]
[633.12856, "o", "> "]
[633.128717, "o", "        print('frame', frame_idx, 'total', len(ct.total_ids))\r\n\u001b[?2004l\r"]
[633.129007, "o", "\u001b[?2004h> "]
[633.129049, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.129086, "o", "> "]
[633.129122, "o", "cap.release()\r\n\u001b[?2004l\r"]
[633.129158, "o", "\u001b[?2004h"]
[633.129192, "o", "> "]
[633.129301, "o", "print('count', len(ct.total_ids))"]
