[822.703463, "o", "            data = resp.read(200).decode('utf-8', errors='ignore')\r\n\u001b[?2004l\r"]
[822.703531, "o", "\u001b[?2004h> "]
[822.703594, "o", "            print('data:', data)\r\n\u001b[?2004l\r"]
[822.703671, "o", "\u001b[?2004h> "]
[822.703738, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.703814, "o", "        print('error', e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.703889, "o", "    print('---')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
[822.703954, "o", "\u001b[?2004l\r"]
[822.780914, "o", "URL: https://api.water.noaa.gov/nwps/v1/gauges?limit=1"]
[822.781089, "o", "\r\n"]
