python3 - <<'PY'
import urllib.request
urls = [
    "https://api.water.noaa.gov/nwps/v1/gauges/04031000",
    "https://api.water.noaa.gov/nwps/v1/gauges?siteId=04031000",
    "https://api.water.noaa.gov/nwps/v1/gauges?identifier=04031000",
    "https://api.water.noaa.gov/nwps/v1/gauges?search=04031000",
    "https://api.water.noaa.gov/nwps/v1/gauges?usgs=04031000",
]
for url in urls:
    try:
        data = urllib.request.urlopen(url).read().decode('utf-8')
        print(url, data[:200])
    except Exception as e:
        print(url, 'error', e)
