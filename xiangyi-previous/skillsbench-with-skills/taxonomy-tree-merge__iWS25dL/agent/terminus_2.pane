[?2004l[?2004h> stopwords = set(['and','the','for','of','to','in','with','without','products','product','supplies','supply','other','misc','general'])
[?2004l[?2004h> 
[?2004l[?2004h> def normalize_text(s):
[?2004l[?2004h>     s = s.lower()
[?2004l[?2004h>     s = s.replace('&','and').replace('/',' ')
[?2004l[?2004h>     s = re.sub(r'[^a-z0-9\s]', ' ', s)
[?2004l[?2004h>     s = re.sub(r'\s+',' ', s).strip()
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def standardize_segment(seg, parent_words=set()):
[?2004l[?2004h>     s = normalize_text(seg)
[?2004l[?2004h>     words = [w for w in s.split() if w not in stopwords]
[?2004l[?2004h>     # remove parent words
[?2004l[?2004h>     filtered = [w for w in words if w not in parent_words]
[?2004l[?2004h>     if not filtered:
[?2004l[?2004h>         filtered = words
[?2004l[?2004h>     filtered = filtered[:5]
[?2004l[?2004h>     if not filtered:
[?2004l[?2004h>         return ''
[?2004l[?2004h>     return ' | '.join([w.title() for w in filtered])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def get_level1(full_text):
[?2004l[?2004h>     for name, keywords in level1_rules:
[?2004l[?2004h>         if any(kw in full_text for kw in keywords):
[?2004l[?2004h>             return name
[?2004l[?2004h>     return 'Other | Misc'
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def get_level2(level1, full_text):
[?2004l[?2004h>     rules = level2_map.get(level1, [])
[?2004l[?2004h>     for name, keywords in rules:
[?2004l[?2004h>         if any(kw in full_text for kw in keywords):
[?2004l[?2004h>             return name
[?2004l[?2004h>     # default
[?2004l[?2004h>     return 'General'
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_levels(path):
[?2004l[?2004h>     segments = [seg.strip() for seg in path.split('>')]
[?2004l[?2004h>     full_text = normalize_text(' > '.join(segments))
[?2004l[?2004h>     level1 = get_level1(full_text)
[?2004l[?2004h>     level2 = get_level2(level1, full_text)
[?2004l[?2004h>     # build remaining levels from segments
[?2004l[?2004h>     parent_words = set(normalize_text(level1).split()) | set(normalize_text(level2).split())
[?2004l[?2004h>     remaining = []
[?2004l[?2004h>     for seg in segments:
[?2004l[?2004h>         std = standardize_segment(seg, parent_words)
[?2004l[?2004h>         if not std:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # skip if same as level1 or level2
[?2004l[?2004h>         if std == level1 or std == level2:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if std in remaining:
[?2004l[?2004h>             continue
[?2004l[?2004h>         remaining.append(std)
[?2004l[?2004h>     # remove first two which might correspond to top level mapping
[?2004l[?2004h>     # We will drop any that are too generic and keep order
[?2004l[?2004h>     # fill levels 3-5 from remaining after removing those matching keywords
[?2004l[?2004h>     lvl3 = remaining[0] if len(remaining)>0 else ''
[?2004l[?2004h>     lvl4 = remaining[1] if len(remaining)>1 else ''
[?2004l[?2004h>     lvl5 = remaining[2] if len(remaining)>2 else ''
[?2004l[?2004h>     return level1, level2, lvl3, lvl4, lvl5
[?2004l[?2004h> 
[?2004l[?2004h> # Load datasets
[?2004l[?2004h> files = {
[?2004l[?2004h>     'amazon':'/root/data/amazon_product_categories.csv',
