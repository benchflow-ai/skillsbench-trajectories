[?2004l[?2004h>         rows.append({
[?2004l[?2004h>             'source': source,
[?2004l[?2004h>             'category_path': cat,
[?2004l[?2004h>             'depth': depth,
[?2004l[?2004h>             'unified_level_1': lvl1,
[?2004l[?2004h>             'unified_level_2': lvl2,
[?2004l[?2004h>             'unified_level_3': lvl3,
