[259.456849, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.457198, "o", "stopwords = set(['and','the','for','of','to','in','with','without','products','product','supplies','supply','other','misc','general'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.457301, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.457396, "o", "def normalize_text(s):\r\n\u001b[?2004l\r\u001b[?2004h>     s = s.lower()\r\n\u001b[?2004l\r"]
[259.457487, "o", "\u001b[?2004h> "]
[259.457584, "o", "    s = s.replace('&','and').replace('/',' ')\r\n\u001b[?2004l\r"]
[259.457671, "o", "\u001b[?2004h> "]
[259.457761, "o", "    s = re.sub(r'[^a-z0-9\\s]', ' ', s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.457874, "o", "    s = re.sub(r'\\s+',' ', s).strip()\r\n\u001b[?2004l\r"]
[259.457952, "o", "\u001b[?2004h>     return s\r\n\u001b[?2004l\r"]
[259.458049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[259.458132, "o", "\u001b[?2004h> "]
[259.458235, "o", "def standardize_segment(seg, parent_words=set()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.458328, "o", "    s = normalize_text(seg)\r\n\u001b[?2004l\r"]
[259.458412, "o", "\u001b[?2004h> "]
[259.458506, "o", "    words = [w for w in s.split() if w not in stopwords]\r\n\u001b[?2004l\r"]
[259.458593, "o", "\u001b[?2004h> "]
[259.458679, "o", "    # remove parent words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.458798, "o", "    filtered = [w for w in words if w not in parent_words]\r\n\u001b[?2004l\r"]
[259.458877, "o", "\u001b[?2004h> "]
[259.458964, "o", "    if not filtered:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.459056, "o", "        filtered = words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.459149, "o", "    filtered = filtered[:5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.459248, "o", "    if not filtered:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.459339, "o", "        return ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.45949, "o", "    return ' | '.join([w.title() for w in filtered])\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.459584, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.459667, "o", "def get_level1(full_text):\r\n\u001b[?2004l\r"]
[259.459768, "o", "\u001b[?2004h> "]
[259.459872, "o", "    for name, keywords in level1_rules:\r\n\u001b[?2004l\r"]
[259.459946, "o", "\u001b[?2004h> "]
[259.460063, "o", "        if any(kw in full_text for kw in keywords):\r\n\u001b[?2004l\r"]
[259.460168, "o", "\u001b[?2004h> "]
[259.460206, "o", "            return name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.460289, "o", "    return 'Other | Misc'\r\n\u001b[?2004l\r"]
[259.460358, "o", "\u001b[?2004h> \r\n"]
[259.460419, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[259.460479, "o", "\u001b[?2004h> "]
[259.460536, "o", "def get_level2(level1, full_text):\r\n\u001b[?2004l\r"]
[259.460595, "o", "\u001b[?2004h> "]
[259.460697, "o", "    rules = level2_map.get(level1, [])\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.460757, "o", "> "]
[259.460832, "o", "    for name, keywords in rules:\r\n\u001b[?2004l\r"]
[259.46089, "o", "\u001b[?2004h> "]
[259.460983, "o", "        if any(kw in full_text for kw in keywords):\r\n\u001b[?2004l\r"]
[259.461015, "o", "\u001b[?2004h"]
[259.46107, "o", "> "]
[259.461092, "o", "            return name\r\n\u001b[?2004l\r"]
[259.461146, "o", "\u001b[?2004h> "]
[259.461248, "o", "    # default\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.461271, "o", "    return 'General'\r\n"]
[259.461327, "o", "\u001b[?2004l\r"]
[259.461348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.461403, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.461485, "o", "> def build_levels(path):\r\n"]
[259.461539, "o", "\u001b[?2004l\r"]
[259.461596, "o", "\u001b[?2004h> "]
[259.461693, "o", "    segments = [seg.strip() for seg in path.split('>')]\r\n"]
[259.461746, "o", "\u001b[?2004l\r"]
[259.461796, "o", "\u001b[?2004h> "]
[259.461898, "o", "    full_text = normalize_text(' > '.join(segments))\r\n\u001b[?2004l\r"]
[259.461927, "o", "\u001b[?2004h> "]
[259.462033, "o", "    level1 = get_level1(full_text)\r\n\u001b[?2004l\r"]
[259.462092, "o", "\u001b[?2004h> "]
[259.462186, "o", "    level2 = get_level2(level1, full_text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.462218, "o", "> "]
[259.462327, "o", "    # build remaining levels from segments\r\n\u001b[?2004l\r"]
[259.462359, "o", "\u001b[?2004h> "]
[259.462606, "o", "    parent_words = set(normalize_text(level1).split()) | set(normalize_text(level2).split())\r\n\u001b[?2004l\r"]
[259.462672, "o", "\u001b[?2004h> "]
[259.462696, "o", "    remaining = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.462725, "o", "> "]
[259.462824, "o", "    for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.462966, "o", "        std = standardize_segment(seg, parent_words)\r\n\u001b[?2004l\r"]
[259.463031, "o", "\u001b[?2004h"]
[259.463091, "o", "> "]
[259.463148, "o", "        if not std:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.463211, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.463266, "o", "> "]
[259.463363, "o", "        # skip if same as level1 or level2\r\n\u001b[?2004l\r"]
[259.463392, "o", "\u001b[?2004h"]
[259.463453, "o", "> "]
[259.463533, "o", "        if std == level1 or std == level2:\r\n\u001b[?2004l\r"]
[259.463582, "o", "\u001b[?2004h> "]
[259.463627, "o", "            continue\r\n\u001b[?2004l\r"]
[259.463713, "o", "\u001b[?2004h> "]
[259.463776, "o", "        if std in remaining:\r\n\u001b[?2004l\r"]
[259.463825, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r"]
[259.463883, "o", "\u001b[?2004h> "]
[259.463937, "o", "        remaining.append(std)\r\n\u001b[?2004l\r"]
[259.463998, "o", "\u001b[?2004h> "]
[259.464047, "o", "    # remove first two which might correspond to top level mapping\r\n\u001b[?2004l\r"]
[259.464102, "o", "\u001b[?2004h> "]
[259.464191, "o", "    # We will drop any that are too generic and keep order\r\n\u001b[?2004l\r"]
[259.464247, "o", "\u001b[?2004h> "]
[259.464344, "o", "    # fill levels 3-5 from remaining after removing those matching keywords\r\n\u001b[?2004l\r"]
[259.464401, "o", "\u001b[?2004h> "]
[259.464468, "o", "    lvl3 = remaining[0] if len(remaining)>0 else ''\r\n\u001b[?2004l\r"]
[259.464527, "o", "\u001b[?2004h> "]
[259.464595, "o", "    lvl4 = remaining[1] if len(remaining)>1 else ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.464655, "o", "> "]
[259.464694, "o", "    lvl5 = remaining[2] if len(remaining)>2 else ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.464724, "o", "> "]
[259.464779, "o", "    return level1, level2, lvl3, lvl4, lvl5\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.46487, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.464896, "o", "> # Load datasets\r\n\u001b[?2004l\r\u001b[?2004h> files = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.464978, "o", "> "]
[259.465055, "o", "    'amazon':'/root/data/amazon_product_categories.csv',\r\n\u001b[?2004l\r"]
[259.465112, "o", "\u001b[?2004h> "]
[259.465168, "o", "    'facebook':'/root/data/fb_product_categories.csv',\r\n\u001b[?2004l\r"]
[259.465191, "o", "\u001b[?2004h> "]
[259.465279, "o", "    'google':'/root/data/google_shopping_product_categories.csv'\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[259.465308, "o", "\u001b[?2004h> "]
[259.465338, "o", "rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.465434, "o", "for source, path in files.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.465455, "o", "    df = pd.read_csv(path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.4655, "o", "> "]
[259.465525, "o", "    for cat in df['category_path']:\r\n\u001b[?2004l\r"]
[259.465554, "o", "\u001b[?2004h> "]
[259.465664, "o", "        lvl1,lvl2,lvl3,lvl4,lvl5 = build_levels(cat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.465755, "o", "        depth = sum([1 if x else 0 for x in [lvl1,lvl2,lvl3,lvl4,lvl5]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.465801, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.46583, "o", "> "]
[259.465889, "o", "            'source': source,\r\n\u001b[?2004l\r"]
[259.465955, "o", "\u001b[?2004h> "]
[259.465979, "o", "            'category_path': cat,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.466047, "o", "            'depth': depth,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.466098, "o", "            'unified_level_1': lvl1,\r\n\u001b[?2004l\r"]
[259.466156, "o", "\u001b[?2004h> "]
[259.466223, "o", "            'unified_level_2': lvl2,\r\n\u001b[?2004l\r"]
[259.466276, "o", "\u001b[?2004h> "]
[259.466334, "o", "            'unified_level_3': lvl3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.466359, "o", "            'unified_level_4': lvl4,\r\n\u001b[?2004l\r"]
[259.466418, "o", "\u001b[?2004h> "]
[259.466479, "o", "            'unified_level_5': lvl5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.466546, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.466569, "o", "> full_df = pd.DataFrame(rows)\r\n\u001b[?2004l\r"]
[259.466623, "o", "\u001b[?2004h> "]
[259.466733, "o", "print('Level1 distribution:', full_df['unified_level_1'].value_counts().head(20))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.466861, "o", "print('Other count:', (full_df['unified_level_1']=='Other | Misc').sum())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[259.466888, "o", "\u001b[?2004h> "]
[259.466948, "o", "# create hierarchy paths\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.467021, "o", "hier_set=set()\r\n\u001b[?2004l\r"]
[259.467041, "o", "\u001b[?2004h> for _,r in full_df.iterrows():\r\n\u001b[?2004l\r"]
[259.467067, "o", "\u001b[?2004h> "]
[259.467256, "o", "    levels=[r['unified_level_1'],r['unified_level_2'],r['unified_level_3'],r['unified_level_4'],r['unified_level_5']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.467318, "o", "    for i in range(1,6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.467387, "o", "        path = levels[:i] + ['']*(5-i)\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.467416, "o", "> "]
[259.467472, "o", "        # if any earlier level empty, skip\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.46752, "o", "        if not path[0]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.467544, "o", "> "]
[259.467574, "o", "            continue\r\n\u001b[?2004l\r"]
[259.467601, "o", "\u001b[?2004h> "]
[259.467661, "o", "        hier_set.add(tuple(path))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.467733, "o", "> "]
[259.467927, "o", "hier_df = pd.DataFrame(list(hier_set), columns=['unified_level_1','unified_level_2','unified_level_3','unified_level_4','unified_level_5'])\r\n\u001b[?2004l\r"]
[259.467987, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[259.468044, "o", "> "]
[259.468067, "o", "os.makedirs('/root/output', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
