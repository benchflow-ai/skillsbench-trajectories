[259.411994, "i", "th Care', ['health care','medical','first aid','treatment','therapy']),\n        ('Vitamins | Supplements', ['vitamin','supplement','nutrition']),\n    ],\n    'Sports | Outdoors | Fitness': [\n        ('Fitness | Exercise', ['fitness','exercise','gym','yoga']),\n        ('Outdoor Recreation', ['outdoor','camping','hiking','cycling','fishing','hunting','boating']),\n        ('Team Sports', ['soccer','basketball','football','baseball','hockey','team sport']),\n        ('Sports Equipment', ['sporting goods','equipment','gear','golf','tennis']),\n        ('Athletic Apparel', ['athletic','sport apparel']),\n    ],\n    'Toys | Games | Hobbies': [\n        ('Toys', ['toy','doll','action figure','playset']),\n        ('Games | Puzzles', ['game','board game','puzzle']),\n        ('Hobbies | Models', ['hobby','model','rc','remote control']),\n        ('Collectibles', ['collectible','antique']),\n    ],\n    'Baby | Kids': [\n        ('Baby Gear', ['stroller','car seat','gear','carrier','walker']),\n        ('Diapering | Feeding', ['diaper','feeding','bottle','nursing','formula','baby food']),\n        ('Nursery | Bedding', ['nursery','crib','bedding']),\n        ('Baby Clothing', ['clothing','apparel','wear']),\n        ('Health | Safety', ['health','safety','monitor','bath']),\n    ],\n    'Pet | Supplies': [\n        ('Pet Food', ['food','treat']),\n        ('Pet Health | Care', ['health','care','grooming','bath','medicine']),\n        ('Pet Accessories | Toys', ['toy','accessory','collar','leash','bed','crate']),\n        ('Horse | Livestock', ['horse','livestock','farm']),\n    ],\n    'Food | Grocery | Beverages': [\n        ('Food', ['food','grocery','gourmet','ingredient','pantry']),\n        ('Snacks | Candy', ['snack','candy','chips']),\n        ('Beverages', ['beverage','drink','coffee','tea','juice']),\n        ('Alcohol | Tobacco', ['wine','beer','liquor','tobacco']),\n    ],\n    'Automotive | Vehicles': [\n        ('Auto Parts', ['part','replacement','engine','brake','tire']),\n        ('Accessories', ['accessory','interior','exterior','electronics']),\n        ('Maintenance | Care', ['oil','fluid','care','cleaning','tools']),\n        ('Motorcycle | Powersports', ['motorcycle','powersport','atv','utv']),\n    ],\n    'Tools | Hardware | Industrial': [\n        ('Tools', ['tool','power tool','hand tool']),\n        ('Hardware | Building', ['hardware','building','plumbing','electrical','fastener']),\n        ('Industrial | Scientific', ['industrial','scientific','lab']),\n        ('Safety | Security', ['safety','security','protective']),\n        ('Business | Commercial', ['business','commercial','janitorial']),\n    ],\n    'Office | Business | Supplies': [\n        ('Office Supplies', ['office','stationery','paper','supplies']),\n        ('School | Classroom', ['school','classroom','education']),\n        ('Office Electronics', ['printer','copier','scanner']),\n        ('Office Furniture', ['furniture','desk','chair']),\n        ('Shipping | Packaging', ['shipping','packaging','mailing']),\n    ],\n    'Arts | Crafts | Sewing': [\n        ('Art Supplies', ['art','drawing','painting']),\n        ('Craft Supplies', ['craft','scrapbook','crafting']),\n        ('Sewing | Fabric', ['sewing','fabric','yarn','needle']),\n        ('Musical Instruments', ['musical','instrument']),\n        ('Collectibles | Antiques', ['collectible','antique']),\n    ],\n    'Books | Media | Music': [\n        ('Books', ['book']),\n        ('Music | Audio', ['music','cd','vinyl','audio']),\n        ('Movies | Video', ['movie','video','dvd','blu-ray','tv']),\n        ('Magazines', ['magazine']),\n    ],\n    'Travel | Luggage': [\n        ('Luggage', ['luggage','suitcase','baggage']),\n        ('Bags | Backpacks', ['bag','backpack']),\n        ('Travel Accessories', ['travel','accessory','passport']),\n    ],\n}\n\nstopwords = set(['and','the','for','of','to','in','with','without','products','product','supplies','supply','other','misc','general'])\n\ndef normalize_text(s):\n    s = s.lower()\n    s = s.replace('&','and').replace('/',' ')\n    s = re.sub(r'[^a-z0-9\\s]', ' ', s)\n    s = re.sub(r'\\s+',' ', s).strip()\n    "]
[259.412046, "i", "return s\n\n\ndef standardize_segment(seg, parent_words=set()):\n    s = normalize_text(seg)\n    words = [w for w in s.split() if w not in stopwords]\n    # remove parent words\n    filtered = [w for w in words if w not in parent_words]\n    if not filtered:\n        filtered = words\n    filtered = filtered[:5]\n    if not filtered:\n        return ''\n    return ' | '.join([w.title() for w in filtered])\n\n\ndef get_level1(full_text):\n    for name, keywords in level1_rules:\n        if any(kw in full_text for kw in keywords):\n            return name\n    return 'Other | Misc'\n\n\ndef get_level2(level1, full_text):\n    rules = level2_map.get(level1, [])\n    for name, keywords in rules:\n        if any(kw in full_text for kw in keywords):\n            return name\n    # default\n    return 'General'\n\n\ndef build_levels(path):\n    segments = [seg.strip() for seg in path.split('>')]\n    full_text = normalize_text(' > '.join(segments))\n    level1 = get_level1(full_text)\n    level2 = get_level2(level1, full_text)\n    # build remaining levels from segments\n    parent_words = set(normalize_text(level1).split()) | set(normalize_text(level2).split())\n    remaining = []\n    for seg in segments:\n        std = standardize_segment(seg, parent_words)\n        if not std:\n            continue\n        # skip if same as level1 or level2\n        if std == level1 or std == level2:\n            continue\n        if std in remaining:\n            continue\n        remaining.append(std)\n    # remove first two which might correspond to top level mapping\n    # We will drop any that are too generic and keep order\n    # fill levels 3-5 from remaining after removing those matching keywords\n    lvl3 = remaining[0] if len(remaining)>0 else ''\n    lvl4 = remaining[1] if len(remaining)>1 else ''\n    lvl5 = remaining[2] if len(remaining)>2 else ''\n    return level1, level2, lvl3, lvl4, lvl5\n\n# Load datasets\nfiles = {\n    'amazon':'/root/data/amazon_product_categories.csv',\n    'facebook':'/root/data/fb_product_categories.csv',\n    'google':'/root/data/google_shopping_product_categories.csv'\n}\nrows=[]\nfor source, path in files.items():\n    df = pd.read_csv(path)\n    for cat in df['category_path']:\n        lvl1,lvl2,lvl3,lvl4,lvl5 = build_levels(cat)\n        depth = sum([1 if x else 0 for x in [lvl1,lvl2,lvl3,lvl4,lvl5]])\n        rows.append({\n            'source': source,\n            'category_path': cat,\n            'depth': depth,\n            'unified_level_1': lvl1,\n            'unified_level_2': lvl2,\n            'unified_level_3': lvl3,\n            'unified_level_4': lvl4,\n            'unified_level_5': lvl5,\n        })\n\nfull_df = pd.DataFrame(rows)\nprint('Level1 distribution:', full_df['unified_level_1'].value_counts().head(20))\nprint('Other count:', (full_df['unified_level_1']=='Other | Misc').sum())\n\n# create hierarchy paths\nhier_set=set()\nfor _,r in full_df.iterrows():\n    levels=[r['unified_level_1'],r['unified_level_2'],r['unified_level_3'],r['unified_level_4'],r['unified_level_5']]\n    for i in range(1,6):\n        path = levels[:i] + ['']*(5-i)\n        # if any earlier level empty, skip\n        if not path[0]:\n            continue\n        hier_set.add(tuple(path))\n\nhier_df = pd.DataFrame(list(hier_set), columns=['unified_level_1','unified_level_2','unified_level_3','unified_level_4','unified_level_5'])\n\nos.makedirs('/root/output', exist_ok=True)\nfull_df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\nhier_df.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n\nprint('Saved:', full_df.shape, hier_df.shape)\nPY\n"]
