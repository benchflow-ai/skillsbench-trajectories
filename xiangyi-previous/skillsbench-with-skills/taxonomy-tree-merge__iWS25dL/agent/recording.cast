[51.945673, "i", "python3 - <<'PY'\nimport pandas as pd\nfrom collections import Counter\nfiles = {\n    'amazon':'/root/data/amazon_product_categories.csv',\n    'facebook':'/root/data/fb_product_categories.csv',\n    'google':'/root/data/google_shopping_product_categories.csv'\n}\nfor name,path in files.items():\n    df=pd.read_csv(path)\n    first=df['category_path'].str.split('>').str[0].str.strip()\n    cnt=Counter(first)\n    print('\\n',name, 'unique top:', len(cnt))\n    for k,v in cnt.most_common(20):\n        print(f'{k}: {v}')\nPY\n"]
