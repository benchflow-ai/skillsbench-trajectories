]\n\nlevel2_map = {\n    'Apparel | Accessories': [\n        ('Clothing', ['clothing','apparel','fashion','dress','shirt','pant','jean','outerwear','underwear','mens','womens','boys','girls','maternity','sleepwear','uniform']),\n        ('Shoes', ['shoe','shoes','footwear','boot','sneaker','sandal']),\n        ('Jewelry', ['jewelry','jewellery','earring','necklace','bracelet','ring']),\n        ('Watches', ['watch','watches']),\n        ('Bags | Wallets', ['bag','bags','handbag','backpack','wallet','purse']),\n        ('Accessories', ['accessory','accessories','belt','hat','scarf','glove','sunglass']),\n    ],\n    'Home | Garden | Kitchen': [\n        ('Furniture', ['furniture','sofa','couch','bed','table','chair','dresser']),\n        ('Kitchen | Dining', ['kitchen','dining','cookware','bakeware','tableware','appliance','utensil','food prep']),\n        ('Bedding | Bath', ['bedding','bed','mattress','bath','towel','linen','shower']),\n        ('Home Decor', ['decor','lighting','lamp','rug','curtain','candle','wall art']),\n        ('Storage | Organization', ['storage','organization','closet','rack']),\n        ('Garden | Outdoor', ['garden','patio','lawn','outdoor','grill','bbq','plant','yard']),\n        ('Cleaning | Household', ['clean','laundry','household']),\n    ],\n    'Electronics | Computers': [\n        ('Computers | Tablets', ['computer','laptop','desktop','notebook','tablet']),\n        ('Phones | Wearables', ['phone','smartphone','mobile','cell','wearable','smartwatch']),\n        ('TV | Video', ['tv','television','video','home theater','projector','streaming']),\n        ('Audio', ['audio','speaker','headphone','microphone']),\n        ('Cameras | Optics', ['camera','optics','photography','lens']),\n        ('Gaming | Software', ['video game','software','game','gaming','console']),\n        ('Accessories | Cables', ['accessory','accessories','cable','charger','battery']),\n    ],\n    'Health | Beauty | Personal Care': [\n        ('Personal Care', ['