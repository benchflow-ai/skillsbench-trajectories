[134.290166, "i", "python3 << 'EOF'\nimport openpyxl\nimport csv\n\n# Load vendors\nvendors = {}\nwb = openpyxl.load_workbook('/root/vendors.xlsx')\nws = wb.active\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    vendor_id, name, iban = row\n    vendors[name.lower()] = vendor_id\n\n# Load purchase orders\npos = {}\nwith open('/root/purchase_orders.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pos[row['po_number']] = row['vendor_id']\n\n# Check a few POs to see vendor mapping\nprint(\"Sample PO to Vendor mappings:\")\nfor po in ['PO-1030', 'PO-1412', 'PO-1181']:\n    print(f\"{po} -> {pos.get(po, 'NOT FOUND')}\")\n\nprint(\"\\nSample Vendor name to ID mappings:\")\nfor name in ['vendor 11', 'vendor 3', 'vendor 80']:\n    print(f\"{name} -> {vendors.get(name, 'NOT FOUND')}\")\nEOF\n"]
[134.290344, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[134.290384, "o", "\u001b[?2004h> "]
[134.290471, "o", "import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.290526, "o", "# Load vendors\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.290574, "o", "> vendors = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.290649, "o", "wb = openpyxl.load_workbook('/root/vendors.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.290694, "o", "ws = wb.active\r\n\u001b[?2004l\r"]
[134.290748, "o", "\u001b[?2004h> "]
[134.290798, "o", "for row in ws.iter_rows(min_row=2, values_only=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.290835, "o", "    vendor_id, name, iban = row\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.291087, "o", "> "]
[134.291153, "o", "    vendors[name.lower()] = vendor_id\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load purchase orders\r\n\u001b[?2004l\r\u001b[?2004h> pos = {}\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/purchase_orders.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.291202, "o", "    reader = csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.291264, "o", ">     for row in reader:\r\n\u001b[?2004l\r"]
[134.291306, "o", "\u001b[?2004h> "]
[134.29133, "o", "        pos[row['po_number']] = row['vendor_id']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[134.291398, "o", "\u001b[?2004h> "]
[134.291444, "o", "# Check a few POs to see vendor mapping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.291492, "o", "print(\"Sample PO to Vendor mappings:\")\r\n\u001b[?2004l\r"]
[134.291542, "o", "\u001b[?2004h> "]
[134.291579, "o", "for po in ['PO-1030', 'PO-1412', 'PO-1181']:\r\n\u001b[?2004l\r"]
[134.291627, "o", "\u001b[?2004h> "]
[134.291674, "o", "    print(f\"{po} -> {pos.get(po, 'NOT FOUND')}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.291725, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.29178, "o", "print(\"\\nSample Vendor name to ID mappings:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.291831, "o", "> "]
[134.291875, "o", "for name in ['vendor 11', 'vendor 3', 'vendor 80']:\r\n\u001b[?2004l\r"]
[134.291918, "o", "\u001b[?2004h> "]
[134.291978, "o", "    print(f\"{name} -> {vendors.get(name, 'NOT FOUND')}\")\r\n\u001b[?2004l\r"]
[134.292022, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[134.763239, "o", "Sample PO to Vendor mappings:\r\nPO-1030 -> V031\r\nPO-1412 -> V413\r\nPO-1181 -> V182\r\n\r\nSample Vendor name to ID mappings:\r\nvendor 11 -> V011\r\nvendor 3 -> V003\r\nvendor 80 -> V080\r\n"]
[134.818148, "o", "\u001b[?2004hroot@319514ad8a84:~# "]
[147.975195, "i", "python3 << 'EOF'\nimport openpyxl\nimport csv\nimport re\nfrom difflib import SequenceMatcher\n\n# Load vendors\nvendors = {}\nvendor_names = {}\nwb = openpyxl.load_workbook('/root/vendors.xlsx')\nws = wb.active\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    vendor_id, name, iban = row\n    vendors[vendor_id] = {'name': name, 'iban': iban}\n    vendor_names[name.lower()] = vendor_id\n\n# Load purchase orders\npos = {}\nwith open('/root/purchase_orders.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pos[row['po_number']] = {\n            'vendor_id': row['vendor_id'],\n            'amount': float(row['amount'])\n        }\n\n# Parse invoices\nwith open('/root/invoices.txt', 'r') as f:\n    content = f.read()\n\ninvoice_pattern = r'Invoice Page (\\d+)\\s+From:\\s*(.+?)\\s+Total\\s*\\$([\\d,.]+)\\s+Payment IBAN:\\s*(\\S+)\\s+PO Number:\\s*(\\S+)'\nmatches = re.findall(invoice_pattern, content)\n\n# Check for potential Vendor Mismatch cases\nprint(\"Checking for Vendor Mismatch scenarios:\")\nfor match in matches:\n    page_num = int(match[0])\n    vendor_name = match[1].strip()\n    amount = float(match[2].replace(',', ''))\n    iban = match[3].strip()\n    po_number = match[4].strip()\n    \n    vendor_id = vendor_names.get(vendor_name.lower())\n    if vendor_id and po_number in pos:\n        expected_iban = vendors[vendor_id]['iban']\n        expected_amount = pos[po_number]['amount']\n        expected_vendor = pos[po_number]['vendor_id']\n        \n        if iban == expected_iban and abs(amount - expected_amount) <= 0.01 and vendor_id != expected_vendor:\n            print(f\"Page {page_num}: Vendor Mismatch - Invoice vendor {vendor_id} vs PO vendor {expected_vendor}\")\n\nprint(\"\\nDone checking.\")\nEOF\n"]
