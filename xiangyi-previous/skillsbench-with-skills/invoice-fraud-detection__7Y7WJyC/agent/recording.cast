[58.520559, "o", "> "]
[58.520604, "o", "        expected_iban = vendors[vendor_id]['iban']\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.520636, "o", "> "]
[58.520699, "o", "        if iban != expected_iban:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.520751, "o", "> "]
[58.520802, "o", "            reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[58.520852, "o", "\u001b[?2004h>     # Check 3: Invalid PO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.520902, "o", "    if reason is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.520951, "o", ">         if po_number not in pos:\r\n\u001b[?2004l\r"]
[58.520999, "o", "\u001b[?2004h> "]
[58.521049, "o", "            reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[58.521092, "o", "\u001b[?2004h> "]
[58.521139, "o", "    # Check 4: Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.521189, "o", "    if reason is None and po_number in pos:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521238, "o", "> "]
[58.521291, "o", "        expected_amount = pos[po_number]['amount']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.521395, "o", "        if abs(amount - expected_amount) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.521451, "o", "            reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521499, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.521544, "o", "    # Check 5: Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521596, "o", "> "]
[58.521643, "o", "    if reason is None and po_number in pos and vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521695, "o", "> "]
[58.521744, "o", "        expected_vendor_id = pos[po_number]['vendor_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521789, "o", "> "]
[58.521827, "o", "        if vendor_id != expected_vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.521871, "o", "> "]
[58.521918, "o", "            reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r"]
[58.521942, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522007, "o", "    if reason:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522049, "o", ">         fraud_cases.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522112, "o", "            \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522159, "o", "> "]
[58.522204, "o", "            \"vendor_name\": vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522228, "o", "> "]
[58.522293, "o", "            \"invoice_amount\": amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522352, "o", "            \"iban\": iban,\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522403, "o", "> "]
[58.522474, "o", "            \"po_number\": po_number if po_number in pos or reason != \"Invalid PO\" else None,\r\n\u001b[?2004l\r"]
[58.522521, "o", "\u001b[?2004h> "]
[58.522573, "o", "            \"reason\": reason\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522611, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522695, "o", "        print(f\"Page {page_num}: {reason} - {vendor_name}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522748, "o", "> "]
[58.522834, "o", "# Fix po_number for Invalid PO cases - should keep the value but it's invalid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.522882, "o", "for case in fraud_cases:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.522936, "o", "> "]
[58.522992, "o", "    if case['reason'] == 'Invalid PO':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.523098, "o", "        # Keep the original PO number from invoice even if invalid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.523145, "o", "        pass\r\n\u001b[?2004l\r"]
[58.5232, "o", "\u001b[?2004h> "]
[58.523271, "o", "    if case['reason'] == 'Unknown Vendor' and case['po_number'] not in pos:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.52333, "o", "        case['po_number'] = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.523374, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.523419, "o", "> "]
[58.523469, "o", "print(f\"\\nTotal fraud cases: {len(fraud_cases)}\")\r\n\u001b[?2004l\r"]
[58.52352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save to JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.523592, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.523639, "o", "> "]
[58.523677, "o", "    json.dump(fraud_cases, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.523726, "o", "\u001b[?2004h> "]
[58.523767, "o", "print(\"Saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.523816, "o", "> EOF\r\n\u001b[?2004l\r"]
[58.524823, "o", "\u001b[?2004hroot@319514ad8a84:~# "]
