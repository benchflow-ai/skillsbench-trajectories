[110.585669, "o", "> "]
[110.585703, "o", "def fuzzy_match_vendor(name):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.585807, "o", "    \"\"\"Try to match vendor name with fuzzy matching\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.585865, "o", "    name_lower = name.lower().strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.585902, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.585978, "o", "    # Exact match first\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586011, "o", "    if name_lower in vendor_names:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.586096, "o", "> "]
[110.58616, "o", "        return vendor_names[name_lower]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Fuzzy match\r\n\u001b[?2004l\r"]
[110.586193, "o", "\u001b[?2004h> "]
[110.586222, "o", "    best_match = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586311, "o", "    best_ratio = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586377, "o", "    for vname, vid in vendor_names.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586491, "o", "        ratio = SequenceMatcher(None, name_lower, vname).ratio()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586524, "o", "        if ratio > best_ratio:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.586558, "o", "> "]
[110.58659, "o", "            best_ratio = ratio\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.586625, "o", "> "]
[110.586663, "o", "            best_match = vid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586701, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.58685, "o", "    # Threshold for fuzzy match (0.85 should catch minor typos)\r\n\u001b[?2004l\r\u001b[?2004h>     if best_ratio >= 0.85:\r\n\u001b[?2004l\r"]
[110.586883, "o", "\u001b[?2004h> "]
[110.586919, "o", "        return best_match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586954, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.587013, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587045, "o", "fraud_cases = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.587191, "o", "> "]
[110.587249, "o", "for match in matches:\r\n\u001b[?2004l\r\u001b[?2004h>     page_num = int(match[0])\r\n\u001b[?2004l\r\u001b[?2004h>     vendor_name = match[1].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587321, "o", "    amount = float(match[2].replace(',', ''))\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.587365, "o", "> "]
[110.587395, "o", "    iban = match[3].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587483, "o", "    po_number_raw = match[4].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.58756, "o", "    # Determine if PO exists in database\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587632, "o", "    po_exists = po_number_raw in pos\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587701, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587762, "o", "    reason = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587795, "o", "    # Check 1: Unknown Vendor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587884, "o", "    vendor_id = fuzzy_match_vendor(vendor_name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.587917, "o", "> "]
[110.587947, "o", "    if vendor_id is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588033, "o", "        reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.58807, "o", "> "]
[110.588158, "o", "    # Check 2: IBAN Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.58822, "o", "    if reason is None and vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588257, "o", "        expected_iban = vendors[vendor_id]['iban']\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.58829, "o", "> "]
[110.588376, "o", "        if iban != expected_iban:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588413, "o", "            reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588447, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588481, "o", "    # Check 3: Invalid PO\r\n\u001b[?2004l\r"]
[110.588514, "o", "\u001b[?2004h> "]
[110.588547, "o", "    if reason is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588707, "o", "        if not po_exists:\r\n\u001b[?2004l\r\u001b[?2004h>             reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588749, "o", "    # Check 4: Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.588781, "o", "> "]
[110.588842, "o", "    if reason is None and po_exists:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.588925, "o", "        expected_amount = pos[po_number_raw]['amount']\r\n\u001b[?2004l\r"]
[110.588963, "o", "\u001b[?2004h> "]
[110.589032, "o", "        if abs(amount - expected_amount) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589107, "o", "            reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589142, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589208, "o", "    # Check 5: Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589298, "o", "    if reason is None and po_exists and vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.589365, "o", "> "]
[110.589402, "o", "        expected_vendor_id = pos[po_number_raw]['vendor_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.589432, "o", "> "]
[110.589514, "o", "        if vendor_id != expected_vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589569, "o", "            reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589608, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589639, "o", "    if reason:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589764, "o", "        # Set po_number to null if PO doesn't exist in database\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589857, "o", "        po_number_output = po_number_raw if po_exists else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589907, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589958, "o", "        fraud_cases.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590031, "o", "            \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.590066, "o", "> "]
[110.590139, "o", "            \"vendor_name\": vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590193, "o", "            \"invoice_amount\": amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.59025, "o", "            \"iban\": iban,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590329, "o", "            \"po_number\": po_number_output,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590385, "o", "            \"reason\": reason\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590421, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.590455, "o", "> "]
[110.590566, "o", "        print(f\"Page {page_num}: {reason} - {vendor_name} (PO: {po_number_output})\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[110.590626, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.590674, "o", "print(f\"\\nTotal fraud cases: {len(fraud_cases)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.590728, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Save to JSON\r\n\u001b[?2004l\r"]
[110.590762, "o", "\u001b[?2004h> "]
[110.590843, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590911, "o", "    json.dump(fraud_cases, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[110.590979, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.591022, "o", "print(\"Saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.591059, "o", "> EOF\r\n\u001b[?2004l\r"]
[110.592819, "o", "\u001b[?2004hroot@319514ad8a84:~# "]
[111.622879, "i", "python3 /root/analyze_fraud.py\n"]
