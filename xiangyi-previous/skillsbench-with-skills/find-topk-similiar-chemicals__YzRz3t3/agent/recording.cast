[287.492054, "i", "cat << 'EOF' > /root/workspace/solution.py\nimport sys\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit import DataStructs\nfrom rdkit.Chem import AllChem\nfrom pdfminer.high_level import extract_text\nimport time\n\ndef get_smiles(name, cache):\n    if name in cache:\n        return cache[name]\n    try:\n        # Respect PubChem rate limit: no more than 5 requests per second.\n        time.sleep(0.2)\n        results = pcp.get_compounds(name, 'name')\n        if results:\n            smiles = results[0].smiles\n            cache[name] = smiles\n            return smiles\n    except Exception as e:\n        if \"503\" in str(e):\n            time.sleep(2)\n            return get_smiles(name, cache)\n        # Silently skip if not found or other errors, as per requirements\n    return None\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    # Extract names from PDF\n    try:\n        text = extract_text(molecule_pool_filepath)\n    except Exception:\n        return []\n\n    # Use a "]
[287.492095, "i", "set to handle duplicates and then sort for deterministic order\n    pool_names = sorted(list(set([line.strip() for line in text.split('\\n') if line.strip()])))\n    \n    cache = {}\n    target_smiles = get_smiles(target_molecule_name, cache)\n    if not target_smiles:\n        return []\n\n    target_mol = Chem.MolFromSmiles(target_smiles)\n    if not target_mol:\n        return []\n    \n    target_fp = AllChem.GetMorganFingerprintAsBitVect(target_mol, 2, nBits=2048, useChirality=True)\n    \n    scored_results = []\n    for name in pool_names:\n        smiles = get_smiles(name, cache)\n        if not smiles:\n            continue\n        mol = Chem.MolFromSmiles(smiles)\n        if not mol:\n            continue\n        fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=2048, useChirality=True)\n        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\n        scored_results.append((name, similarity))\n    \n    # Sort by similarity (descending), then name (ascending)\n    scored_results.sort(key=lambda x: (-x[1], "]
[287.492103, "i", "x[0]))\n    \n    return [res[0] for res in scored_results[:top_k]]\n\nif __name__ == \"__main__\":\n    target_name = sys.argv[1] if len(sys.argv) > 1 else \"Ethanol\"\n    top_k = int(sys.argv[2]) if len(sys.argv) > 2 else 5\n    pool_file = \"/root/molecules.pdf\"\n    \n    results = topk_tanimoto_similarity_molecules(target_name, pool_file, top_k)\n    for name in results:\n        print(name)\nEOF\n"]
