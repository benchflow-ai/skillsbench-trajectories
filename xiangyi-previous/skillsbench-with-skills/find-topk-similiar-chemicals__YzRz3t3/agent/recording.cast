[53.434996, "i", "cat << 'EOF' > /root/workspace/solution.py\nimport sys\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit import DataStructs\nfrom rdkit.Chem import AllChem\nfrom pdfminer.high_level import extract_text\nimport time\n\ndef get_smiles(name):\n    try:\n        results = pcp.get_compounds(name, 'name')\n        if results:\n            return results[0].smiles\n    except Exception as e:\n        if \"503\" in str(e):\n            time.sleep(1)\n            return get_smiles(name)\n        print(f\"Error fetching SMILES for {name}: {e}\", file=sys.stderr)\n    return None\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    # Extract names from PDF\n    text = extract_text(molecule_pool_filepath)\n    pool_names = sorted(list(set([line.strip() for line in text.split('\\n') if line.strip()])))\n    \n    target_smiles = get_smiles(target_molecule_name)\n    if not target_smiles:\n        return []\n\n    target_mol = Chem.MolFromSmiles(target_smiles)\n    if not target_mol:\n        return ["]
[53.435041, "o", "cat << 'EOF' > /root/workspace/solution.py\r\nimport sys\r\nimport pubchempy as pcp\r\nfrom rdkit import Chem\r\nfrom rdkit import DataStructs\r\nfrom rdkit.Chem import AllChem\r\nfrom pdfminer.high_level import extract_text\r\nimport time\r\n\r\ndef get_smiles(nam"]
[53.435049, "i", "]\n    \n    target_fp = AllChem.GetMorganFingerprintAsBitVect(target_mol, 2, nBits=2048, useChirality=True)\n    \n    results = []\n    for name in pool_names:\n        smiles = get_smiles(name)\n        if not smiles:\n            continue\n        mol = Chem.MolFromSmiles(smiles)\n        if not mol:\n            continue\n        fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=2048, useChirality=True)\n        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\n        results.append((name, similarity))\n    \n    # Sort by similarity (descending), then name (ascending)\n    results.sort(key=lambda x: (-x[1], x[0]))\n    \n    return results[:top_k]\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 3:\n        print(\"Usage: python solution.py <target_molecule_name> <top_k>\")\n        sys.exit(1)\n    \n    target_name = sys.argv[1]\n    top_k = int(sys.argv[2])\n    pool_file = \"/root/molecules.pdf\"\n    \n    top_k_results = topk_tanimoto_similarity_molecules(target_name, pool_file, top_k)\n    for name, sim in t"]
