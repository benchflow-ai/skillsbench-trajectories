[971.360439, "o", "arches = amd64, 386\r\nIEEE1284_ADDR = 0x2000\r\nIEEE1284_DATA = 0x0\r\nIEEE1284_DEVICEID = 0x4\r\nIEEE1284_EXT_LINK = 0x4000\r\nIEEE1284_MODE_BECP = 0x200\r\nIEEE1284_MODE_BYTE = 0x1\r\nIEEE1284_MODE_COMPAT = 0x100\r\nIEEE1284_MODE_ECP = 0x10\r\nIEEE1284_MODE_ECPRLE = 0x30\r\nIEEE1284_MODE_ECPSWE = 0x400\r\nIEEE1284_MODE_EPP = 0x40\r\nIEEE1284_MODE_EPPSL = 0x800\r\nIEEE1284_MODE_EPPSWE = 0x1000\r\nIEEE1284_MODE_NIBBLE = 0x0\r\nPPCLAIM = 0x708b\r\nPPCLRIRQ = 0x80047093\r\nPPDATADIR = 0x40047090\r\nPPEXCL = 0x708f\r\nPPFCONTROL = 0x4002708e\r\nPPGETFLAGS = 0x8004709a\r\nPPGETMODE = 0x80047098\r\nPPGETMODES = 0x80047097\r\nPPGETPHASE = 0x80047099\r\nPPGETTIME = 0x80107095\r\nPPNEGOT = 0x40047091\r\nPPRELEASE = 0x708c\r\nPPRCONTROL = 0x80017083\r\nPPRDATA = 0x80017085\r\nPPRSTATUS = 0x80017081\r\nPPSETFLAGS = 0x4004709b\r\nPPSETMODE = 0x40047080\r\nPPSETPHASE = 0x40047094\r\nPPSETTIME = 0x40107096\r\nPPWCONTROL = 0x40017084\r\nPPWCTLONIRQ = 0x40017092\r\nPPWDATA = 0x40017086\r\nPPYIELD = 0x708d\r\nPP_FASTREAD = 0x8\r\nPP_FASTWRITE = 0x4\r\nPP_W91284PIC = 0x10\r\n"]
