   printf(\"IEEE1284_MODE_ECP = 0x%x\\\\n\", IEEE1284_MODE_ECP);\n    printf(\"IEEE1284_MODE_ECPRLE = 0x%x\\\\n\", IEEE1284_MODE_ECPRLE);\n    printf(\"IEEE1284_MODE_ECPSWE = 0x%x\\\\n\", IEEE1284_MODE_ECPSWE);\n    printf(\"IEEE1284_MODE_EPP = 0x%x\\\\n\", IEEE1284_MODE_EPP);\n    printf(\"IEEE1284_MODE_EPPSL = 0x%x\\\\n\", IEEE1284_MODE_EPPSL);\n    printf(\"IEEE1284_MODE_EPPSWE = 0x%x\\\\n\", IEEE1284_MODE_EPPSWE);\n    printf(\"IEEE1284_DEVICEID = 0x%x\\\\n\", IEEE1284_DEVICEID);\n    printf(\"IEEE1284_EXT_LINK = 0x%x\\\\n\", IEEE1284_EXT_LINK);\n    printf(\"IEEE1284_ADDR = 0x%x\\\\n\", IEEE1284_ADDR);\n    printf(\"IEEE1284_DATA = 0x%x\\\\n\", IEEE1284_DATA);\n\n    printf(\"PP_FASTWRITE = 0x%x\\\\n\", PP_FASTWRITE);\n    printf(\"PP_FASTREAD = 0x%x\\\\n\", PP_FASTREAD);\n    printf(\"PP_W91284PIC = 0x%x\\\\n\", PP_W91284PIC);\n\n    return 0;\n}\nEOF\ngcc constants.c -o constants && ./constants\n"]
