[71.71097, "i", "cat <<EOF > constants.c\n#include <stdio.h>\n#include <linux/ppdev.h>\n#include <linux/parport.h>\n#include <sys/ioctl.h>\n\nint main() {\n    printf(\"PPSETMODE = 0x%lx\\\\n\", (unsigned long)PPSETMODE);\n    printf(\"PPRSTATUS = 0x%lx\\\\n\", (unsigned long)PPRSTATUS);\n    printf(\"PPRCONTROL = 0x%lx\\\\n\", (unsigned long)PPRCONTROL);\n    printf(\"PPWCONTROL = 0x%lx\\\\n\", (unsigned long)PPWCONTROL);\n    printf(\"PPFCONTROL = 0x%lx\\\\n\", (unsigned long)PPFCONTROL);\n    printf(\"PPRDATA = 0x%lx\\\\n\", (unsigned long)PPRDATA);\n    printf(\"PPWDATA = 0x%lx\\\\n\", (unsigned long)PPWDATA);\n    printf(\"PPCLAIM = 0x%lx\\\\n\", (unsigned long)PPCLAIM);\n    printf(\"PPRELEASE = 0x%lx\\\\n\", (unsigned long)PPRELEASE);\n    printf(\"PPYIELD = 0x%lx\\\\n\", (unsigned long)PPYIELD);\n    printf(\"PPEXCL = 0x%lx\\\\n\", (unsigned long)PPEXCL);\n    printf(\"PPDATADIR = 0x%lx\\\\n\", (unsigned long)PPDATADIR);\n    printf(\"PPNEGOT = 0x%lx\\\\n\", (unsigned long)PPNEGOT);\n    printf(\"PPWCTLONIRQ = 0x%lx\\\\n\", (unsigned long)PPWCTLONIRQ);\n    printf(\"PPCLRIRQ = 0x%lx\\\\n\", (unsigned long)PPCLRIRQ);\n    printf(\"PPSETPHASE = 0x%lx\\\\n\", (unsigned long)PPSETPHASE);\n    printf(\"PPGETTIME = 0x%lx\\\\n\", (unsigned long)PPGETTIME);\n    printf(\"PPSETTIME = 0x%lx\\\\n\", (unsigned long)PPSETTIME);\n    printf(\"PPGETMODES = 0x%lx\\\\n\", (unsigned long)PPGETMODES);\n    printf(\"PPGETMODE = 0x%lx\\\\n\", (unsigned long)PPGETMODE);\n    printf(\"PPGETPHASE = 0x%lx\\\\n\", (unsigned long)PPGETPHASE);\n    printf(\"PPGETFLAGS = 0x%lx\\\\n\", (unsigned long)PPGETFLAGS);\n    printf(\"PPSETFLAGS = 0x%lx\\\\n\", (unsigned long)PPSETFLAGS);\n    return 0;\n}\nEOF\ngcc constants.c -o constants && ./constants\n"]
