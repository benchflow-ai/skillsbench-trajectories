[316.657556, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[316.657623, "o", "> "]
[316.657714, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.657785, "o", "> "]
[316.657858, "o", "        results = executor.map(_index_chunk_stage2, stage2_inputs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.657919, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.658046, "o", "        for p_inverted, p_vectors, p_norms in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.658126, "o", "            # Merge inverted index\r\n\u001b[?2004l\r"]
[316.65822, "o", "\u001b[?2004h> "]
[316.6583, "o", "            for term, postings in p_inverted.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.658371, "o", "> "]
[316.65844, "o", "                if term not in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.658516, "o", "> "]
[316.658567, "o", "                    index.inverted_index[term] = []\r\n\u001b[?2004l\r"]
[316.658623, "o", "\u001b[?2004h> "]
[316.658723, "o", "                index.inverted_index[term].extend(postings)\r\n\u001b[?2004l\r"]
[316.658776, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[316.658836, "o", "> "]
[316.658888, "o", "            index.doc_vectors.update(p_vectors)\r\n\u001b[?2004l\r"]
[316.658961, "o", "\u001b[?2004h> "]
[316.659051, "o", "            index.doc_norms.update(p_norms)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.6591, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.659274, "o", "    # Sort posting lists (required for consistency with sequential version)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.659401, "o", "    for term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.659485, "o", "> "]
[316.659553, "o", "        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.659605, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.659741, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.66002, "o", "    return IndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\r\n\u001b[?2004l\r"]
[316.660056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[316.660176, "o", "\u001b[?2004h> "]
[316.660278, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[316.660356, "o", "\u001b[?2004h> "]
[316.660427, "o", "# Parallel Search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.660617, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[316.660685, "o", "\u001b[?2004h> _global_index = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.660764, "o", "> _global_documents = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.66084, "o", "def _init_search_worker(index, documents):\r\n\u001b[?2004l\r"]
[316.660908, "o", "\u001b[?2004h> "]
[316.660998, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.661065, "o", "    Initializer to set global variables in worker processes.\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.661127, "o", "> "]
[316.661296, "o", "    Avoids pickling large index for every task.\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.661328, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[316.661404, "o", "\u001b[?2004h> "]
[316.66146, "o", "    global _global_index, _global_documents\r\n\u001b[?2004l\r"]
[316.661516, "o", "\u001b[?2004h> "]
[316.661575, "o", "    _global_index = index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.661643, "o", "    _global_documents = documents\r\n\u001b[?2004l\r"]
[316.661705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[316.661786, "o", "> "]
[316.661905, "o", "def _search_chunk(queries: List[str], top_k: int) -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.661965, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.662059, "o", "    Worker function to search a chunk of queries.\r\n\u001b[?2004l\r"]
[316.662092, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[316.66215, "o", "\u001b[?2004h> "]
[316.662227, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.662289, "o", "> "]
[316.662412, "o", "    # We use search_sequential for each query, but distribute queries across workers\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.662475, "o", "> "]
[316.662529, "o", "    for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.662648, "o", "        # search_sequential is imported from sequential.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.662707, "o", "> "]
[316.662803, "o", "        # It uses the global index we set in initializer\r\n\u001b[?2004l\r"]
[316.662869, "o", "\u001b[?2004h> "]
[316.663028, "o", "        res = search_sequential(query, _global_index, top_k, _global_documents)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.663114, "o", "> "]
[316.663161, "o", "        results.append(res)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.663213, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[316.663279, "o", "\u001b[?2004h> "]
[316.66334, "o", "def _search_chunk_wrapper(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.66344, "o", "    \"\"\"Unpack arguments for map.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.663463, "o", "> "]
[316.663565, "o", "    return _search_chunk(*args)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[316.663612, "o", "\u001b[?2004h> "]
[316.663912, "o", "def batch_search_parallel(queries: List[str], index: TFIDFIndex, top_k=10, num_workers=None, documents=None) -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r"]
[316.663944, "o", "\u001b[?2004h> "]
[316.664023, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.66411, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.66417, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664221, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664275, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664323, "o", "    # Chunk queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664403, "o", "    chunk_size = max(1, len(queries) // num_workers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.664455, "o", "> "]
[316.664571, "o", "    # Ensure we don't have empty chunks if len(queries) < num_workers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664635, "o", "    if len(queries) < num_workers:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.664695, "o", "        chunk_size = 1\r\n\u001b[?2004l\r"]
[316.66474, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[316.664838, "o", "\u001b[?2004h> "]
[316.665004, "o", "    query_chunks = [queries[i:i + chunk_size] for i in range(0, len(queries), chunk_size)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[316.665065, "o", "\u001b[?2004h> "]
[316.665111, "o", "    # Prepare arguments: just query chunks and top_k\r\n\u001b[?2004l\r"]
[316.665172, "o", "\u001b[?2004h> "]
[316.665273, "o", "    # index and documents are passed via initializer\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.665326, "o", "> "]
[316.665443, "o", "    process_args = [(chunk, top_k) for chunk in query_chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.665474, "o", ">     \r\n\u001b[?2004l\r"]
[316.665535, "o", "\u001b[?2004h> "]
[316.665586, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.665637, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.665961, "o", "    with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, documents)) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.66602, "o", "> "]
[316.666158, "o", "        chunk_results = executor.map(_search_chunk_wrapper, process_args)\r\n\u001b[?2004l\r"]
[316.666254, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[316.666282, "o", "> "]
[316.666345, "o", "        for res in chunk_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.666485, "o", "            results.extend(res)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.666732, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[316.666762, "o", "\u001b[?2004h"]
[316.666842, "o", "> "]
[316.666899, "o", "    return results, elapsed\r\n\u001b[?2004l\r"]
[316.666947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[316.668387, "o", "\u001b[?2004hroot@0d4df3940cd5:~# "]
[346.074325, "i", "cat << 'EOF' > /root/workspace/test_parallel.py\nimport time\nimport argparse\nfrom sequential import generate_corpus, build_tfidf_index_sequential, batch_search_sequential, TFIDFIndex\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--num-docs\", type=int, default=5000)\n    parser.add_argument(\"--num-queries\", type=int, default=20)\n    args = parser.parse_args()\n\n    print(f\"Generating {args.num_docs} documents...\")\n    documents = generate_corpus(args.num_docs, seed=42)\n    \n    # Generate queries\n    queries = [\"machine learning\", \"artificial intelligence\", \"neural networks\", \"data science\", \"python programming\"] * (args.num_queries // 5)\n    queries = queries[:args.num_queries]\n    \n    print(\"=\"*60)\n    print(\"Testing Index Building\")\n    print(\"=\"*60)\n    \n    # Sequential Build\n    print(\"Running Sequential Indexing...\")\n    start = time.perf_counter()\n    seq_result = build_tfidf_index_sequential(documents)\n    seq_time = time.perf_counter() - start\n    print(f\"Sequential Time: {seq_time:.4f}s\")\n    \n    # Parallel Build\n    print(\"Running Parallel Indexing...\")\n    start = time.perf_counter()\n    par_result = build_tfidf_index_parallel(documents, num_workers=4)\n    par_time = time.perf_counter() - start\n    print(f\"Parallel Time: {par_time:.4f}s\")\n    \n    print(f\"Speedup: {seq_time / par_time:.2f}x\")\n    \n    # Verify Index Correctness\n    print(\"\\nVerifying Index Correctness...\")\n    assert len(seq_result.index.vocabulary) == len(par_result.index.vocabulary), \"Vocabulary size mismatch\"\n    assert seq_result.index.num_documents == par_result.index.num_documents, \"Num docs mismatch\"\n    \n    # Check a few terms in inverted index\n    vocab_list = list(seq_result.index.vocabulary)\n    for i in range(0, len(vocab_list), 1000):\n        term = vocab_list[i]\n        seq_postings = seq_result.index.inverted_index.get(term, [])\n        par_postings = par_result.index.inverted_index.get(term, [])\n        \n        # Sort just in case order differs slightly (though we sorted in code)\n        seq_postings.sort()\n        par_postings.sort()\n        \n        assert len(seq_postings) == len(par_postings), f\"Posting list length mismatch for term '{term}'\"\n        # Check content roughly (float precision might differ slightly)\n        for (d1, s1), (d2, s2) in zip(seq_postings, par_postings):\n            assert d1 == d2, f\"Doc ID mismatch for term '{term}'\"\n            assert abs(s1 - s2) < 1e-6, f\"Score mismatch for term '{term}': {s1} vs {s2}\"\n            \n    print(\"Index verification passed!\")\n    \n    print(\"=\"*60)\n    print(\"Testing Search\")\n    print(\"=\"*60)\n    \n    # Sequential Search\n    print(\"Running Sequential Search...\")\n    start = time.perf_counter()\n    seq_search_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - start\n    print(f\"Sequential Search Time: {seq_search_time:.4f}s\")\n    \n    # Parallel Search\n    print(\"Running Parallel Search...\")\n    # Note: batch_search_parallel returns (results, time)\n    # But we want to measure wall clock here including overhead if any\n    start = time.perf_counter()\n    par_search_results, inner_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    par_search_time = time.perf_counter() - start\n    print(f\"Parallel Search Time: {par_search_time:.4f}s\")\n    \n    print(f\"Speedup: {seq_search_time / par_search_time:.2f}x\")\n    \n    # Verify Search Correctness\n    print(\"\\nVerifying Search Correctness...\")\n    for i, (seq_res, par_res) in enumerate(zip(seq_search_results, par_search_results)):\n        assert len(seq_res) == len(par_res), f\"Result count mismatch for query {i}\"\n        for r1, r2 in zip(seq_res, par_res):\n            assert r1.doc_id == r2.doc_id, f\"Result doc_id mismatch for query {i}\"\n            assert abs(r1.score - r2.score) < 1e-6, f\"Result score mismatch for query {i}\"\n            \n    print(\"Search verification passed!\""]
[346.074379, "i", ")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[346.074777, "o", "cat << 'EOF' > /root/workspace/test_parallel.py\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.074844, "o", "import argparse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075057, "o", "from sequential import generate_corpus, build_tfidf_index_sequential, batch_search_sequential, TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075186, "o", "from parallel_solution import build_tfidf_index_parallel, batch_search_parallel\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[346.075241, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.075287, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075383, "o", "    parser = argparse.ArgumentParser()\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.075439, "o", "> "]
[346.075531, "o", "    parser.add_argument(\"--num-docs\", type=int, default=5000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075607, "o", "    parser.add_argument(\"--num-queries\", type=int, default=20)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075678, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.07575, "o", "    print(f\"Generating {args.num_docs} documents...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.075839, "o", "    documents = generate_corpus(args.num_docs, seed=42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.075907, "o", ">     \r\n\u001b[?2004l\r"]
[346.07598, "o", "\u001b[?2004h>     # Generate queries\r\n\u001b[?2004l\r"]
[346.076056, "o", "\u001b[?2004h> "]
[346.076286, "o", "    queries = [\"machine learning\", \"artificial intelligence\", \"neural networks\", \"data science\", \"python programming\"] * (args.num_queries // 5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076377, "o", "    queries = queries[:args.num_queries]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076448, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076524, "o", "    print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076595, "o", "    print(\"Testing Index Building\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"=\"*60)\r\n\u001b[?2004l\r"]
[346.076665, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076734, "o", "    # Sequential Build\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076803, "o", "    print(\"Running Sequential Indexing...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076873, "o", "    start = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.076954, "o", "    seq_result = build_tfidf_index_sequential(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.077028, "o", "    seq_time = time.perf_counter() - start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.07711, "o", "    print(f\"Sequential Time: {seq_time:.4f}s\")\r\n\u001b[?2004l\r"]
[346.077181, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.077295, "o", ">     # Parallel Build\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.077371, "o", "    print(\"Running Parallel Indexing...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.077443, "o", "    start = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.077673, "o", "    par_result = build_tfidf_index_parallel(documents, num_workers=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.077827, "o", ">     par_time = time.perf_counter() - start\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.077928, "o", ">     print(f\"Parallel Time: {par_time:.4f}s\")"]
[346.078065, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.078137, "o", ">     print(f\"Speedup: {seq_time / par_time:.2f}x\")"]
[346.078211, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.078324, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.07847, "o", ">     # Verify Index Correctness"]
[346.078545, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nVerifying Index Correctness...\")"]
[346.078765, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.078993, "o", "    assert len(seq_result.index.vocabulary) == len(par_result.index.vocabulary), \"Vocabulary size mismatch\""]
[346.079085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert seq_result.index.num_documents == par_result.index.num_documents, \"Num docs mismatch\""]
[346.07912, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[346.079261, "o", "\u001b[?2004l\r\u001b[?2004h>     # Check a few terms in inverted index"]
[346.079335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.079453, "o", "    vocab_list = list(seq_result.index.vocabulary)"]
[346.079608, "o", "\r\n"]
[346.079736, "o", "\u001b[?2004l\r\u001b[?2004h>     for i in range(0, len(vocab_list), 1000):"]
[346.079918, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         term = vocab_list[i]"]
[346.080101, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         seq_postings = seq_result.index.inverted_index.get(term, [])"]
[346.08018, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         par_postings = par_result.index.inverted_index.get(term, [])"]
[346.080249, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.080317, "o", "        \r\n"]
[346.08048, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.080558, "o", "        # Sort just in case order differs slightly (though we sorted in code)"]
[346.08065, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.080726, "o", "        seq_postings.sort()"]
[346.080829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.080928, "o", ">         par_postings.sort()"]
[346.081163, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[346.081284, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(seq_postings) == len(par_postings), f\"Posting list length mismatch for term '{term}'\""]
[346.085924, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.085969, "o", "        # Check content roughly (float precision might differ slightly)"]
[346.089249, "o", "\r\n\u001b[?2004l\r"]
[346.089309, "o", "\u001b[?2004h> "]
[346.089455, "o", "        for (d1, s1), (d2, s2) in zip(seq_postings, par_postings):\r\n\u001b[?2004l\r"]
[346.08949, "o", "\u001b[?2004h> "]
[346.089638, "o", "            assert d1 == d2, f\"Doc ID mismatch for term '{term}'\"\r\n\u001b[?2004l\r"]
[346.089668, "o", "\u001b[?2004h> "]
[346.089897, "o", "            assert abs(s1 - s2) < 1e-6, f\"Score mismatch for term '{term}': {s1} vs {s2}\"\r\n\u001b[?2004l\r"]
[346.089944, "o", "\u001b[?2004h> "]
[346.089992, "o", "            \r\n\u001b[?2004l\r"]
[346.090033, "o", "\u001b[?2004h> "]
[346.090128, "o", "    print(\"Index verification passed!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.090168, "o", ">     \r\n"]
[346.090197, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.090257, "o", "    print(\"=\"*60)\r\n\u001b[?2004l\r"]
[346.090293, "o", "\u001b[?2004h"]
[346.090323, "o", "> "]
[346.090398, "o", "    print(\"Testing Search\")\r\n\u001b[?2004l\r"]
[346.090428, "o", "\u001b[?2004h"]
[346.090457, "o", "> "]
[346.090511, "o", "    print(\"=\"*60)\r\n\u001b[?2004l\r"]
[346.090539, "o", "\u001b[?2004h"]
[346.090571, "o", "> "]
[346.0906, "o", "    \r\n\u001b[?2004l\r"]
[346.090641, "o", "\u001b[?2004h> "]
[346.090712, "o", "    # Sequential Search"]
[346.090745, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.090773, "o", "> "]
[346.09089, "o", "    print(\"Running Sequential Search...\")\r\n"]
[346.090918, "o", "\u001b[?2004l\r\u001b[?2004h"]
[346.090952, "o", "> "]
[346.091039, "o", "    start = time.perf_counter()\r\n"]
[346.091075, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.091362, "o", "    seq_search_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)"]
[346.091393, "o", "\r\n\u001b[?2004l\r"]
[346.091423, "o", "\u001b[?2004h> "]
[346.091558, "o", "    seq_search_time = time.perf_counter() - start\r\n"]
[346.091583, "o", "\u001b[?2004l\r\u001b[?2004h"]
[346.09162, "o", "> "]
[346.091784, "o", "    print(f\"Sequential Search Time: {seq_search_time:.4f}s\")\r\n"]
[346.091819, "o", "\u001b[?2004l\r\u001b[?2004h"]
[346.091848, "o", "> "]
[346.091878, "o", "    \r\n\u001b[?2004l\r"]
[346.091906, "o", "\u001b[?2004h> "]
[346.091983, "o", "    # Parallel Search\r\n\u001b[?2004l\r"]
[346.092019, "o", "\u001b[?2004h> "]
[346.092134, "o", "    print(\"Running Parallel Search...\")\r\n\u001b[?2004l\r"]
[346.092181, "o", "\u001b[?2004h> "]
[346.092338, "o", "    # Note: batch_search_parallel returns (results, time)\r\n"]
[346.092368, "o", "\u001b[?2004l\r"]
[346.092396, "o", "\u001b[?2004h> "]
[346.092584, "o", "    # But we want to measure wall clock here including overhead if any\r\n"]
[346.092617, "o", "\u001b[?2004l\r"]
[346.092645, "o", "\u001b[?2004h> "]
[346.09275, "o", "    start = time.perf_counter()\r\n\u001b[?2004l\r"]
[346.092778, "o", "\u001b[?2004h"]
[346.092807, "o", "> "]
[346.093118, "o", "    par_search_results, inner_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)"]
[346.093147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.093181, "o", "> "]
[346.093389, "o", "    par_search_time = time.perf_counter() - start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.093506, "o", "    print(f\"Parallel Search Time: {par_search_time:.4f}s\")\r\n"]
[346.093537, "o", "\u001b[?2004l\r\u001b[?2004h"]
[346.093567, "o", ">     \r\n\u001b[?2004l\r"]
[346.093685, "o", "\u001b[?2004h> "]
[346.095309, "o", "    print(f\"Speedup: {seq_search_time / par_search_time:.2f}x\")\r\n\u001b[?2004l\r"]
[346.095369, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Verify Search Correctness\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nVerifying Search Correctness...\")\r\n\u001b[?2004l\r\u001b[?2004h>     for i, (seq_res, par_res) in enumerate(zip(seq_search_results, par_search_results)):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(seq_res) == len(par_res), f\"Result count mismatch for query {i}\"\r\n\u001b[?2004l\r\u001b[?2004h>         for r1, r2 in zip(seq_res, par_res):\r\n\u001b[?2004l\r\u001b[?2004h>             assert r1.doc_id == r2.doc_id, f\"Result doc_id mismatch for query {i}\"\r\n\u001b[?2004l\r\u001b[?2004h>             assert abs(r1.score - r2.score) < 1e-6, f\"Result score mismatch for query {i}\"\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.0954, "o", "    print(\"Search verification passed!\")\r\n\u001b[?2004l\r"]
[346.095433, "o", "\u001b[?2004h> "]
[346.095473, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095549, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[346.095583, "o", "\u001b[?2004h> "]
[346.095612, "o", "    main()\r\n\u001b[?2004l\r"]
[346.09565, "o", "\u001b[?2004h> "]
