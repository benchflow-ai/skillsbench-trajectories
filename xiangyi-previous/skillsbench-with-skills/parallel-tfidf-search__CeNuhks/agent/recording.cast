[182.336459, "o", "    doc_terms: dict[int, set[str]] = {}\r\n\r\n    for doc in documents:\r\n        text = doc.title + \" \" + doc.content\r\n        tokens = tokenize(text)\r\n        tf = compute_term_frequencies(tokens)\r\n        doc_term_freqs[doc.doc_id] = tf\r\n        doc_terms[doc.doc_id] = set(tf.keys())\r\n        index.vocabulary.update(tf.keys())\r\n\r\n    # Step 2: Calculate document frequencies\r\n    for term in index.vocabulary:\r\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n        index.document_frequencies[term] = df\r\n\r\n    # Step 3: Compute IDF scores\r\n    # IDF(t) = log(N / DF(t)) + 1 (smoothed)\r\n    N = index.num_documents\r\n    for term, df in index.document_frequencies.items():\r\n        index.idf[term] = math.log(N / df) + 1\r\n\r\n    # Step 4: Build inverted index with TF-IDF scores\r\n    for term in index.vocabulary:\r\n"]
[182.336711, "o", "\u001b[?2004hroot@0d4df3940cd5:~# "]
[316.642617, "i", "cat << 'EOF' > /root/workspace/parallel_solution.py\nimport math\nimport time\nimport multiprocessing\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom typing import List, Tuple, Dict, Set, Optional\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    IndexingResult,\n    tokenize,\n    compute_term_frequencies,\n    search_sequential,\n    Document\n)\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\ndef _index_chunk_stage1(documents: List[Document]) -> Tuple[Dict[int, Dict[str, float]], Dict[str, int]]:\n    \"\"\"\n    Worker function for Stage 1: Compute TF and local DF counts.\n    \"\"\"\n    local_doc_term_freqs = {}\n    local_df = defaultdict(int)\n    \n    for doc in documents:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        local_doc_term_freqs[doc.doc_id] = tf\n        # Update local DF counts (unique terms in this doc)\n        for term in tf.keys():\n            local_df[term] += 1\n            \n    return local_doc_term_freqs, dict(local_df)\n\ndef _index_chunk_stage2(args) -> Tuple[Dict[str, List[Tuple[int, float]]], Dict[int, Dict[str, float]], Dict[int, float]]:\n    \"\"\"\n    Worker function for Stage 2: Build partial index and vectors.\n    \"\"\"\n    doc_term_freqs_chunk, idf = args\n    \n    partial_inverted = defaultdict(list)\n    partial_vectors = {}\n    partial_norms = {}\n    \n    for doc_id, tf_dict in doc_term_freqs_chunk.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        \n        for term, tf in tf_dict.items():\n            if term in idf:\n                val = tf * idf[term]\n                doc_vector[term] = val\n                norm_squared += val * val\n                # Add to partial inverted index\n                # Note: We append here; merging happens in main process\n                partial_inverted[term].append((doc_id, val))\n        \n        partial_vectors[doc_id] = doc_vector\n        partial_norms[doc_id] = math.sqrt(norm_squared)\n        \n    return partial_inverted, partial_vectors, partial_norms\n\ndef build_tfidf_index_parallel(documents: List[Document], num_workers=None, chunk_size=500) -> IndexingResult:\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n        \n    start_time = time.perf_counter()\n    \n    # Split documents into chunks for Stage 1\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    \n    doc_term_freqs = {}\n    document_frequencies = defaultdict(int)\n    \n    # Stage 1: Compute TF and DF counts in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        results = executor.map(_index_chunk_stage1, chunks)\n        \n        for chunk_tf, chunk_df in results:\n            doc_term_freqs.update(chunk_tf)\n            for term, count in chunk_df.items():\n                document_frequencies[term] += count\n                \n    # Compute global IDF\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    index.document_frequencies = dict(document_frequencies)\n    index.vocabulary = set(document_frequencies.keys())\n    \n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n        \n    # Stage 2: Build Inverted Index and Vectors in parallel\n    # We chunk the processed TF dictionaries\n    doc_ids = list(doc_term_freqs.keys())\n    doc_id_chunks = [doc_ids[i:i + chunk_size] for i in range(0, len(doc_ids), chunk_size)]\n    \n    stage2_inputs = []\n    for chunk in doc_id_chunks:\n        subset_tf = {doc_id: doc_term_freqs[doc_id] for doc_id in chunk}\n        stage2_inputs.append((subset_tf, index.idf))\n        \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        results = executor.map(_index_chunk_stage2, stage2_inputs)\n        \n        for p_inverted, p_vectors, p_norms in results:\n            # Merge inverted index\n    "]
[316.642851, "i", "        for term, postings in p_inverted.items():\n                if term not in index.inverted_index:\n                    index.inverted_index[term] = []\n                index.inverted_index[term].extend(postings)\n            \n            index.doc_vectors.update(p_vectors)\n            index.doc_norms.update(p_norms)\n            \n    # Sort posting lists (required for consistency with sequential version)\n    for term in index.inverted_index:\n        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n        \n    elapsed = time.perf_counter() - start_time\n    return IndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\n# ============================================================================\n# Parallel Search\n# ============================================================================\n\n_global_index = None\n_global_documents = None\n\ndef _init_search_worker(index, documents):\n    \"\"\"\n    Initializer to set global variables in worker processes.\n    Avoids pickling large index for every task.\n    \"\"\"\n    global _global_index, _global_documents\n    _global_index = index\n    _global_documents = documents\n\ndef _search_chunk(queries: List[str], top_k: int) -> List[SearchResult]:\n    \"\"\"\n    Worker function to search a chunk of queries.\n    \"\"\"\n    results = []\n    # We use search_sequential for each query, but distribute queries across workers\n    for query in queries:\n        # search_sequential is imported from sequential.py\n        # It uses the global index we set in initializer\n        res = search_sequential(query, _global_index, top_k, _global_documents)\n        results.append(res)\n    return results\n\ndef _search_chunk_wrapper(args):\n    \"\"\"Unpack arguments for map.\"\"\"\n    return _search_chunk(*args)\n\ndef batch_search_parallel(queries: List[str], index: TFIDFIndex, top_k=10, num_workers=None, documents=None) -> Tuple[List[List[SearchResult]], float]:\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n        \n    start_time = time.perf_counter()\n    \n    # Chunk queries\n    chunk_size = max(1, len(queries) // num_workers)\n    # Ensure we don't have empty chunks if len(queries) < num_workers\n    if len(queries) < num_workers:\n        chunk_size = 1\n        \n    query_chunks = [queries[i:i + chunk_size] for i in range(0, len(queries), chunk_size)]\n    \n    # Prepare arguments: just query chunks and top_k\n    # index and documents are passed via initializer\n    process_args = [(chunk, top_k) for chunk in query_chunks]\n    \n    results = []\n    \n    with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, documents)) as executor:\n        chunk_results = executor.map(_search_chunk_wrapper, process_args)\n        \n        for res in chunk_results:\n            results.extend(res)\n            \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\n\nEOF\n"]
