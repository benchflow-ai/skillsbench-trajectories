[?2004l[?2004h> 
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> # Parallel Search
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> _global_index = None
[?2004l[?2004h> _global_documents = None
[?2004l[?2004h> 
[?2004l[?2004h> def _init_search_worker(index, documents):
[?2004l[?2004h>     """
[?2004l[?2004h>     Initializer to set global variables in worker processes.
[?2004l[?2004h>     Avoids pickling large index for every task.
[?2004l[?2004h>     """
[?2004l[?2004h>     global _global_index, _global_documents
[?2004l[?2004h>     _global_index = index
[?2004l[?2004h>     _global_documents = documents
[?2004l[?2004h> 
[?2004l[?2004h> def _search_chunk(queries: List[str], top_k: int) -> List[SearchResult]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Worker function to search a chunk of queries.
[?2004l[?2004h>     """
[?2004l[?2004h>     results = []
[?2004l[?2004h>     # We use search_sequential for each query, but distribute queries across workers
[?2004l[?2004h>     for query in queries:
[?2004l[?2004h>         # search_sequential is imported from sequential.py
[?2004l[?2004h>         # It uses the global index we set in initializer
[?2004l[?2004h>         res = search_sequential(query, _global_index, top_k, _global_documents)
[?2004l[?2004h>         results.append(res)
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> def _search_chunk_wrapper(args):
[?2004l[?2004h>     """Unpack arguments for map."""
[?2004l[?2004h>     return _search_chunk(*args)
[?2004l[?2004h> 
[?2004l[?2004h> def batch_search_parallel(queries: List[str], index: TFIDFIndex, top_k=10, num_workers=None, documents=None) -> Tuple[List[List[SearchResult]], float]:
[?2004l[?2004h>     if num_workers is None:
[?2004l[?2004h>         num_workers = multiprocessing.cpu_count()
[?2004l[?2004h>         
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004l[?2004h>     
[?2004l[?2004h>     # Chunk queries
[?2004l[?2004h>     chunk_size = max(1, len(queries) // num_workers)
[?2004l[?2004h>     # Ensure we don't have empty chunks if len(queries) < num_workers
[?2004l[?2004h>     if len(queries) < num_workers:
[?2004l[?2004h>         chunk_size = 1
[?2004l[?2004h>         
[?2004l[?2004h>     query_chunks = [queries[i:i + chunk_size] for i in range(0, len(queries), chunk_size)]
[?2004l[?2004h>     
[?2004l[?2004h>     # Prepare arguments: just query chunks and top_k
[?2004l[?2004h>     # index and documents are passed via initializer
[?2004l[?2004h>     process_args = [(chunk, top_k) for chunk in query_chunks]
[?2004l[?2004h>     
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, documents)) as executor:
[?2004l[?2004h>         chunk_results = executor.map(_search_chunk_wrapper, process_args)
[?2004l[?2004h>         
[?2004l[?2004h>         for res in chunk_results:
[?2004l[?2004h>             results.extend(res)
[?2004l[?2004h>             
[?2004l[?2004h>     elapsed = time.perf_counter() - start_time
[?2004l[?2004h>     return results, elapsed
