[?2004l[?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:
[?2004l[?2004h>         results = executor.map(_index_chunk_stage2, stage2_inputs)
[?2004l[?2004h>         
[?2004l[?2004h>         for p_inverted, p_vectors, p_norms in results:
[?2004l[?2004h>             # Merge inverted index
[?2004l[?2004h>             for term, postings in p_inverted.items():
[?2004l[?2004h>                 if term not in index.inverted_index:
[?2004l[?2004h>                     index.inverted_index[term] = []
[?2004l[?2004h>                 index.inverted_index[term].extend(postings)
[?2004l[?2004h>             
[?2004l[?2004h>             index.doc_vectors.update(p_vectors)
[?2004l[?2004h>             index.doc_norms.update(p_norms)
[?2004l[?2004h>             
[?2004l[?2004h>     # Sort posting lists (required for consistency with sequential version)
[?2004l[?2004h>     for term in index.inverted_index:
[?2004l[?2004h>         index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h>         
[?2004l[?2004h>     elapsed = time.perf_counter() - start_time
