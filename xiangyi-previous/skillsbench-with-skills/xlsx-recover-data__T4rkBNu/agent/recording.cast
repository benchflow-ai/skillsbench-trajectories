[147.471882, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_recovered.xlsx')\n\nprint(\"Checking for remaining '???' values...\")\nfound_missing = False\n\nfor sheet_name in wb.sheetnames:\n    ws = wb[sheet_name]\n    for row in ws.iter_rows():\n        for cell in row:\n            if cell.value == '???':\n                print(f\"Found '???' in {sheet_name} at {cell.coordinate}\")\n                found_missing = True\n\nif not found_missing:\n    print(\"SUCCESS: No '???' values remaining!\")\n    print(\"\\nVerifying recovered values:\")\n    \n    # Show key recovered values\n    ws1 = wb['Budget by Directorate']\n    print(f\"\\n=== Budget by Directorate ===\")\n    print(f\"2016 Total: {ws1.cell(row=5, column=11).value}\")\n    print(f\"2019 Space Ops: {ws1.cell(row=8, column=6).value}\")\n    print(f\"2020 Science: {ws1.cell(row=9, column=2).value}\")\n    print(f\"2021 Exploration: {ws1.cell(row=10, column=5).value}\")\n    print(f\"2021 Total: {ws1.cell(row=10, column=11).value}\")\n    print(f\"2023 Aeronautics: {ws1.cell(row=12, column=3).value}\")\n    \n    ws2 = wb['YoY Changes (%)']\n    print(f\"\\n=== YoY Changes (%) ===\")\n    print(f\"2019 Space Tech: {ws2.cell(row=7, column=4).value}\")\n    print(f\"2021 Science: {ws2.cell(row=9, column=2).value}\")\n    print(f\"2021 Space Ops: {ws2.cell(row=9, column=6).value}\")\n    \n    ws3 = wb['Directorate Shares (%)']\n    print(f\"\\n=== Directorate Shares (%) ===\")\n    print(f\"2016 Space Ops: {ws3.cell(row=5, column=6).value}\")\n    print(f\"2021 Science: {ws3.cell(row=10, column=2).value}\")\n    \n    ws4 = wb['Growth Analysis']\n    print(f\"\\n=== Growth Analysis ===\")\n    print(f\"Exploration CAGR: {ws4.cell(row=4, column=5).value}\")\n    print(f\"FY2019 Exploration: {ws4.cell(row=5, column=5).value}\")\n    print(f\"Science 5-Year Change: {ws4.cell(row=7, column=2).value}\")\n    print(f\"Science Avg Annual: {ws4.cell(row=8, column=2).value}\")\nEOF\n"]
