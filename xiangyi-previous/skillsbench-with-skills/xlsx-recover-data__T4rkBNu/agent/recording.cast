[21.937396, "i", "python3 << 'EOF'\nimport openpyxl\nwb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\n\nfor sheet_name in wb.sheetnames:\n    print(f\"\\n=== {sheet_name} ===\")\n    ws = wb[sheet_name]\n    for row in ws.iter_rows(min_row=1, max_row=min(20, ws.max_row), max_col=min(15, ws.max_column)):\n        row_vals = [str(cell.value) if cell.value is not None else '' for cell in row]\n        print('\\t'.join(row_vals))\nEOF\n"]
