[38.739333, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\n\n# Sheet 1: Budget by Directorate\nws1 = wb['Budget by Directorate']\n\n# First, let's identify the structure - row 3 has headers, data starts row 4\n# Columns: A=Fiscal Year, B=Science, C=Aeronautics, D=Space Technology, E=Exploration,\n#          F=Space Operations, G=STEM Engagement, H=Safety & Mission, I=Construction,\n#          J=Inspector General, K=Total\n\n# Let's find and fix missing values in Sheet 1\n# Build a dictionary of all budget values first\nbudget_data = {}\nfor row in range(4, 14):  # rows 4-13 for years 2015-2024\n    year = ws1.cell(row=row, column=1).value\n    if year:\n        budget_data[year] = {}\n        for col in range(2, 12):  # columns B-K\n            val = ws1.cell(row=row, column=col).value\n            budget_data[year][col] = val\n\nprint(\"Budget data loaded:\")\nfor year, data in budget_data.items():\n    print(f\"{year}: {data}\")\nEOF\n"]
