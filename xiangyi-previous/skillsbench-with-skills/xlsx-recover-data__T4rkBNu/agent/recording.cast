[101.070751, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\nws1 = wb['Budget by Directorate']\nws2 = wb['YoY Changes (%)']\nws3 = wb['Directorate Shares (%)']\nws4 = wb['Growth Analysis']\n\n# ============ SHEET 1: Budget by Directorate ============\n# Fixed values from previous calculation\nws1.cell(row=5, column=11).value = 19285   # 2016 Total\nws1.cell(row=8, column=6).value = 4639     # 2019 Space Operations\nws1.cell(row=9, column=2).value = 7139     # 2020 Science\nws1.cell(row=10, column=5).value = 6555    # 2021 Exploration\nws1.cell(row=10, column=11).value = 23285  # 2021 Total\nws1.cell(row=12, column=3).value = 936     # 2023 Aeronautics\nprint(\"Sheet 1 fixed!\")\n\n# ============ SHEET 2: YoY Changes (%) ============\n# Row mapping: 4=2016, 5=2017, 6=2018, 7=2019, 8=2020, 9=2021, 10=2022, 11=2023, 12=2024\n# Column mapping: same as Sheet 1 (2=Science, 3=Aero, 4=Space Tech, etc.)\n\n# 2019 Space Technology YoY (row 7, col 4): (760-686)/686 * 100\nspace_tech_yoy_2019 = round((760 - 686) / 686 * 100, 2)\nprint(f\"2019 Space Tech YoY: {space_tech_yoy_2019}\")\nws2.cell(row=7, column=4).value = space_tech_yoy_2019\n\n# 2021 Science YoY (row 9, col 2): (7301-7139)/7139 * 100\nscience_yoy_2021 = round((7301 - 7139) / 7139 * 100, 2)\nprint(f\"2021 Science YoY: {science_yoy_2021}\")\nws2.cell(row=9, column=2).value = science_yoy_2021\n\n# 2021 Space Operations YoY (row 9, col 6): (3986-3989)/3989 * 100\nspace_ops_yoy_2021 = round((3986 - 3989) / 3989 * 100, 2)\nprint(f\"2021 Space Ops YoY: {space_ops_yoy_2021}\")\nws2.cell(row=9, column=6).value = space_ops_yoy_2021\nprint(\"Sheet 2 fixed!\")\n\n# ============ SHEET 3: Directorate Shares (%) ============\n# Row mapping: 4=2015, 5=2016, 6=2017, 7=2018, 8=2019, 9=2020, 10=2021, 11=2022, 12=2023, 13=2024\n\n# 2016 Space Operations share (row 5, col 6): 5029/19285 * 100\nspace_ops_share_2016 = round(5029 / 19285 * 100, 2)\nprint(f\"2016 Space Ops Share: {space_ops_share_2016}\")\nws3.cell(row=5, column=6).value = space_ops_share_2016\n\n# 2021 Science share (row 10, col 2): 7301/23285 * 100\nscience_share_2021 = round(7301 / 23285 * 100, 2)\nprint(f\"2021 Science Share: {science_share_2021}\")\nws3.cell(row=10, column=2).value = science_share_2021\nprint(\"Sheet 3 fixed!\")\n\n# ============ SHEET 4: Growth Analysis ============\n# Structure: Row 4=5-Year CAGR, Row 5=FY2019 Budget, Row 6=FY2024 Budget, Row 7=5-Year Change, Row 8=Avg Annual\n# Columns: 2=Science, 3=Aero, 4=Space Tech, 5=Exploration, 6=Space Ops, 7=STEM, 8=Safety, 9=Construction, 10=Inspector\n\n# Exploration 5-Year CAGR (row 4, col 5): ((7618/5047)^(1/5) - 1) * 100\nimport math\nexploration_cagr = round((pow(7618/5047, 1/5) - 1) * 100, 2)\nprint(f\"Exploration 5-Year CAGR: {exploration_cagr}\")\nws4.cell(row=4, column=5).value = exploration_cagr\n\n# FY2019 Exploration Budget (row 5, col 5): 5047\nprint(f\"FY2019 Exploration: 5047\")\nws4.cell(row=5, column=5).value = 5047\n\n# Science 5-Year Change (row 7, col 2): 8440 - 6906\nscience_5yr_change = 8440 - 6906\nprint(f\"Science 5-Year Change: {science_5yr_change}\")\nws4.cell(row=7, column=2).value = science_5yr_change\n\n# Science Avg Annual Budget (row 8, col 2): average of 2019-2024\n# 2019: 6906, 2020: 7139, 2021: 7301, 2022: 7614, 2023: 8262, 2024: 8440\nscience_avg = round((6906 + 7139 + 7301 + 7614 + 8262 + 8440) / 6, 1)\nprint(f\"Science Avg Annual: {science_avg}\")\nws4.cell(row=8, column=2).value = science_avg\nprint(\"Sheet 4 fixed!\")\n\n# Save the recovered file\nwb.save('nasa_budget_recovered.xlsx')\nprint(\"\\nFile saved as nasa_budget_recovered.xlsx!\")\nEOF\n"]
