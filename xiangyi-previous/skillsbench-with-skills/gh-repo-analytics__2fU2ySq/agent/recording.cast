[87.274786, "o", "\u001b[?2004h> \r\n"]
[87.274816, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.274843, "o", "> "]
[87.275013, "o", "merged_prs = [p for p in prs if p['merged_at'] is not None]\r\n\u001b[?2004l\r"]
[87.275045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
