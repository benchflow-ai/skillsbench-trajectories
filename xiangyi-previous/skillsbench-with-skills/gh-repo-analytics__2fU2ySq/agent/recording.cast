[87.273963, "i", "python3 -c \"\nimport json\nfrom datetime import datetime\n\nwith open('/app/prs_data.json') as f:\n    prs = json.load(f)\n\nmerged_prs = [p for p in prs if p['merged_at'] is not None]\n\ntotal_days = 0\nfor pr in merged_prs:\n    created = datetime.fromisoformat(pr['created_at'].replace('Z', '+00:00'))\n    merged = datetime.fromisoformat(pr['merged_at'].replace('Z', '+00:00'))\n    diff = (merged - created).total_seconds() / 86400\n    total_days += diff\n\navg_days = total_days / len(merged_prs)\nprint(f'Average merge time: {avg_days:.1f} days')\nprint(f'Merged PRs count: {len(merged_prs)}')\n\"\n"]
[87.274273, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
