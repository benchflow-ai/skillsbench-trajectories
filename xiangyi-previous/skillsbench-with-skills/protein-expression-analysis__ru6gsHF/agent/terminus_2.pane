[?2004l[?2004h>     task_sheet[f'{col_letter}24'].value = f'=AVERAGE(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 25: Control StdDev
[?2004l[?2004h>     task_sheet[f'{col_letter}25'].value = f'=STDEV(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 26: Treated Mean
[?2004l[?2004h>     task_sheet[f'{col_letter}26'].value = f'=AVERAGE(H{protein_row}:L{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 27: Treated StdDev
[?2004l[?2004h>     task_sheet[f'{col_letter}27'].value = f'=STDEV(H{protein_row}:L{protein_row})'
