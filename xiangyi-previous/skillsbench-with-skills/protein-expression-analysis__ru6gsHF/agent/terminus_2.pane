[?2004l[?2004h>     
[?2004l[?2004h>     # Column B: Gene_Symbol
[?2004l[?2004h>     task_sheet[f'B{fold_change_row}'].value = f'=B{protein_row}'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column C: Fold Change = 2^(Treated Mean - Control Mean)
