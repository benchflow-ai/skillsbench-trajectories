[70.705663, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Task sheet - Rows 22-28, all columns:\")\nfor row in range(22, 29):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 15):\n        cell_value = task_sheet.cell(row, col).value\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell_value:\n            print(f\"  {col_letter}{row}: {cell_value}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"Task sheet - Rows 30-42, all columns:\")\nfor row in range(30, 43):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 15):\n        cell_value = task_sheet.cell(row, col).value\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell_value:\n            print(f\"  {col_letter}{row}: {cell_value}\")\n\nEOF\n"]
