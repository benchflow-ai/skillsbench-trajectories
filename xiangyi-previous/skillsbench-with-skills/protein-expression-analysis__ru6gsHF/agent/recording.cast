[63.753488, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Adding statistics formulas (rows 24-27)...\")\n\n# For each protein (rows 11-20), add statistics\nfor protein_row in range(11, 21):\n    # Control columns are C-G (3-7), Treated columns are H-L (8-12)\n    control_range = 'C' + str(protein_row) + ':G' + str(protein_row)\n    treated_range = 'H' + str(protein_row) + ':L' + str(protein_row)\n    \n    # Row 24: Control Mean\n    task_sheet[f'C24'].value = f'=AVERAGE(C11:G11)' if protein_row == 11 else task_sheet[f'C24'].value\n    \n    # Row 25: Control StdDev\n    task_sheet[f'C25'].value = f'=STDEV(C11:G11)' if protein_row == 11 else task_sheet[f'C25'].value\n    \n    # Row 26: Treated Mean\n    task_sheet[f'C26'].value = f'=AVERAGE(H11:L11)' if protein_row == 11 else task_sheet[f'C26'].value\n    \n    # Row 27: Treated StdDev\n    task_sheet[f'C27'].value = f'=STDEV(H11:L11)' if protein_row == 11 else task_sheet[f'C27'].value\n\n# Actually, I need to add formulas for each protein separately\n# Let me redo this more carefully\n\nprint(\"Clearing and adding statistics formulas...\")\n\n# For each protein row, add statistics in columns C-L\nfor protein_row in range(11, 21):\n    protein_idx = protein_row - 10  # 1-10 for rows 11-20\n    \n    # Row 24: Control Mean (average of C-G for this protein)\n    cell_24 = task_sheet[f'C{24 + protein_idx - 1}']\n    cell_24.value = f'=AVERAGE(C{protein_row}:G{protein_row})'\n    \n    # Row 25: Control StdDev\n    cell_25 = task_sheet[f'C{25 + protein_idx - 1}']\n    cell_25.value = f'=STDEV(C{protein_row}:G{protein_row})'\n    \n    # Row 26: Treated Mean\n    cell_26 = task_sheet[f'C{26 + protein_idx - 1}']\n    cell_26.value = f'=AVERAGE(H{protein_row}:L{protein_row})'\n    \n    # Row 27: Treated StdDev\n    cell_27 = task_sheet[f'C{27 + protein_idx - 1}']\n    cell_27.value = f'=STDEV(H{protein_row}:L{protein_row})'\n\nprint(\"Wait, I need to reconsider the layout...\")\nprint(\"Let me check what the actual expected layout is...\")\n\nEOF\n"]
