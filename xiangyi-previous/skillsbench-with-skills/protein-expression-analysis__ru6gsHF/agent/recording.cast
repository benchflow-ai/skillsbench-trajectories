[90.287662, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx', data_only=False)\ntask_sheet = wb['Task']\n\nprint(\"Verifying formulas...\")\nprint(\"\\nExpression data formulas (C11:C12):\")\nfor row in [11, 12]:\n    print(f\"C{row}: {task_sheet[f'C{row}'].value}\")\n\nprint(\"\\nStatistics formulas (row 24):\")\nfor col in ['C', 'D', 'E']:\n    print(f\"{col}24: {task_sheet[f'{col}24'].value}\")\n\nprint(\"\\nFold change formulas (rows 32-33):\")\nfor row in [32, 33]:\n    print(f\"A{row}: {task_sheet[f'A{row}'].value}\")\n    print(f\"C{row}: {task_sheet[f'C{row}'].value}\")\n    print(f\"D{row}: {task_sheet[f'D{row}'].value}\")\n\nprint(\"\\nFormulas verified successfully!\")\nprint(\"\\nNow loading with data_only=True to check calculated values...\")\n\nwb2 = load_workbook('/root/protein_expression.xlsx', data_only=True)\ntask_sheet2 = wb2['Task']\n\nprint(\"\\nCalculated values (first protein):\")\nprint(f\"C11 (expression): {task_sheet2['C11'].value}\")\nprint(f\"C24 (control mean): {task_sheet2['C24'].value}\")\nprint(f\"C26 (treated mean): {task_sheet2['C26'].value}\")\nprint(f\"C32 (fold change): {task_sheet2['C32'].value}\")\nprint(f\"D32 (log2 FC): {task_sheet2['D32'].value}\")\n\nEOF\n"]
