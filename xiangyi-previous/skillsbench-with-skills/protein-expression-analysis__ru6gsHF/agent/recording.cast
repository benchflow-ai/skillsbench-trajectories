[17.956042, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/root/protein_expression.xlsx')\nprint(\"Sheet names:\", wb.sheetnames)\n\n# Get the Task sheet\ntask_sheet = wb['Task']\nprint(\"\\nTask sheet - Target proteins (A11:A20):\")\nfor row in range(11, 21):\n    protein = task_sheet[f'A{row}'].value\n    print(f\"Row {row}: {protein}\")\n\n# Get the Data sheet\ndata_sheet = wb['Data']\nprint(\"\\nData sheet - First few rows and columns:\")\nprint(f\"Dimensions: {data_sheet.dimensions}\")\n\n# Check row 9 for control/treated labels\nprint(\"\\nRow 9 (sample classification):\")\nfor col in range(1, 15):\n    cell_value = data_sheet.cell(9, col).value\n    col_letter = openpyxl.utils.get_column_letter(col)\n    print(f\"{col_letter}9: {cell_value}\")\n\n# Check row 10 for sample names\nprint(\"\\nRow 10 (sample names):\")\nfor col in range(1, 15):\n    cell_value = data_sheet.cell(10, col).value\n    col_letter = openpyxl.utils.get_column_letter(col)\n    print(f\"{col_letter}10: {cell_value}\")\n\nEOF\n"]
