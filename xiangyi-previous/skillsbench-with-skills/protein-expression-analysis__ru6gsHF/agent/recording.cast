[52.50903, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\ndata_sheet = wb['Data']\n\n# Step 1: Add INDEX-MATCH formulas to C11:L20\nprint(\"Adding INDEX-MATCH formulas for expression data...\")\n\n# Columns C-L correspond to samples\nfor protein_row in range(11, 21):  # Rows 11-20 in Task sheet\n    protein_id = task_sheet[f'A{protein_row}'].value\n    print(f\"Processing protein {protein_row}: {protein_id}\")\n    \n    for sample_col in range(3, 13):  # Columns C-L (3-12)\n        sample_name = task_sheet.cell(10, sample_col).value\n        col_letter = get_column_letter(sample_col)\n        \n        # Create INDEX-MATCH formula\n        # Match protein_id in Data sheet column A, match sample_name in Data sheet row 1\n        # Return the value at intersection\n        formula = f'=IFERROR(INDEX(Data.$D$2:$BA$201,MATCH($A{protein_row},Data.$A$2:$A$201,0),MATCH({col_letter}$10,Data.$D$1:$BA$1,0)),\"\")'\n        \n        cell = task_sheet[f'{col_letter}{protein_row}']\n        cell.value = formula\n        print(f\"  {col_letter}{protein_row}: {sample_name}\")\n\nprint(\"\\nFormulas added. Saving workbook...\")\nwb.save('/root/protein_expression.xlsx')\nprint(\"Workbook saved!\")\n\nEOF\n"]
