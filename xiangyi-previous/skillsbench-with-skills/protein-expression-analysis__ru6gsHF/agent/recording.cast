[81.809642, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Adding statistics formulas...\")\n\n# For each protein (rows 11-20), add statistics in columns C-L\nfor protein_row in range(11, 21):\n    col_idx = protein_row - 10 + 2  # Column C=3, D=4, etc. for proteins 1-10\n    col_letter = get_column_letter(col_idx)\n    \n    # Row 24: Control Mean (average of C-G for this protein)\n    task_sheet[f'{col_letter}24'].value = f'=AVERAGE(C{protein_row}:G{protein_row})'\n    \n    # Row 25: Control StdDev\n    task_sheet[f'{col_letter}25'].value = f'=STDEV(C{protein_row}:G{protein_row})'\n    \n    # Row 26: Treated Mean\n    task_sheet[f'{col_letter}26'].value = f'=AVERAGE(H{protein_row}:L{protein_row})'\n    \n    # Row 27: Treated StdDev\n    task_sheet[f'{col_letter}27'].value = f'=STDEV(H{protein_row}:L{protein_row})'\n    \n    print(f\"Protein row {protein_row}: Added stats in column {col_letter}\")\n\nprint(\"\\nAdding fold change analysis...\")\n\n# For each protein (rows 11-20), add fold change analysis in rows 32-41\nfor i, protein_row in enumerate(range(11, 21)):\n    fold_change_row = 32 + i  # Rows 32-41\n    \n    # Column A: Protein_ID\n    task_sheet[f'A{fold_change_row}'].value = f'=A{protein_row}'\n    \n    # Column B: Gene_Symbol\n    task_sheet[f'B{fold_change_row}'].value = f'=B{protein_row}'\n    \n    # Column C: Fold Change = 2^(Treated Mean - Control Mean)\n    col_letter = get_column_letter(protein_row - 10 + 2)  # C, D, E, etc.\n    task_sheet[f'C{fold_change_row}'].value = f'=2^({col_letter}26-{col_letter}24)'\n    \n    # Column D: Log2 FC = Treated Mean - Control Mean\n    task_sheet[f'D{fold_change_row}'].value = f'={col_letter}26-{col_letter}24'\n    \n    print(f\"Protein row {protein_row}: Added fold change in row {fold_change_row}\")\n\nprint(\"\\nSaving workbook...\")\nwb.save('/root/protein_expression.xlsx')\nprint(\"Workbook saved!\")\n\nEOF\n"]
