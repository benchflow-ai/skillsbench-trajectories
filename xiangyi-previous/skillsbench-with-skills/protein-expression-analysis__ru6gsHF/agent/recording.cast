[101.29458, "o", "    'sp|Q9BQA1|MEP50_HUMAN',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.29464, "o", "    'sp|Q9C0F1|CEP44_HUMAN',\r\n\u001b[?2004l\r\u001b[?2004h> "]
