[101.292481, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"Verifying Data sheet structure for INDEX-MATCH...\")\nprint(f\"\\nData sheet dimensions: {data_sheet.dimensions}\")\n\nprint(\"\\nColumn A (Protein_ID) - first 15 rows:\")\nfor row in range(1, 16):\n    value = data_sheet[f'A{row}'].value\n    print(f\"A{row}: {value}\")\n\nprint(\"\\nRow 1 (Sample names) - columns D-M:\")\nfor col in range(4, 14):\n    col_letter = openpyxl.utils.get_column_letter(col)\n    value = data_sheet[f'{col_letter}1'].value\n    print(f\"{col_letter}1: {value}\")\n\nprint(\"\\nChecking if our target proteins are in the Data sheet...\")\ntarget_proteins = [\n    'sp|Q9HCY8|S10AE_HUMAN',\n    'sp|Q96EN8|MOCOS_HUMAN',\n    'sp|Q86UT8|CCD84_HUMAN',\n    'sp|O96000|NDUBA_HUMAN',\n    'sp|Q86Y38|XYLT1_HUMAN',\n    'sp|Q5SZL2|CE85L_HUMAN',\n    'sp|Q9BQA1|MEP50_HUMAN',\n    'sp|Q9C0F1|CEP44_HUMAN',\n    'sp|Q9UH03|SEPT3_HUMAN',\n    'sp|P04632|CPNS1_HUMAN'\n]\n\nfor protein in target_proteins:\n    found = False\n    for row in range(2, 202):\n        if data_sheet[f'A{row}'].value == protein:\n            print(f\"Found: {protein} at row {row}\")\n            found = True\n            break\n    if not found:\n        print(f\"NOT FOUND: {protein}\")\n\nEOF\n"]
[101.292708, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.292835, "o", "import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]
