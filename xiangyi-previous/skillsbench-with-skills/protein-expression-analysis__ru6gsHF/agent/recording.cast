[101.294755, "o", "    'sp|P04632|CPNS1_HUMAN'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[101.294809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.294862, "o", "for protein in target_proteins:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.294915, "o", "    found = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
