[25.033936, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ndata_sheet = wb['Data']\n\n# Check the first 10 rows to find structure\nprint(\"First 10 rows, columns A-M:\")\nfor row in range(1, 11):\n    row_data = []\n    for col in range(1, 14):\n        cell_value = data_sheet.cell(row, col).value\n        row_data.append(str(cell_value)[:30] if cell_value else \"\")\n    print(f\"Row {row}: {row_data}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"Checking for sample classification row (looking for Control/Treated):\")\nfor row in range(1, 15):\n    row_data = []\n    for col in range(1, 14):\n        cell_value = data_sheet.cell(row, col).value\n        row_data.append(str(cell_value)[:20] if cell_value else \"\")\n    print(f\"Row {row}: {row_data}\")\n\nEOF\n"]
