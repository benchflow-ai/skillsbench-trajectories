[42.302508, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\n# Check rows 11-41\nprint(\"Task sheet - Rows 11-41, columns A-L:\")\nfor row in range(11, 42):\n    row_data = []\n    for col in range(1, 13):\n        cell_value = task_sheet.cell(row, col).value\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell_value:\n            row_data.append(f\"{col_letter}: {str(cell_value)[:20]}\")\n    if row_data:\n        print(f\"Row {row}: {row_data}\")\n    else:\n        print(f\"Row {row}: [empty]\")\n\nEOF\n"]
