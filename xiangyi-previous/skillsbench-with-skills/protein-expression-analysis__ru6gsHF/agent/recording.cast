[90.451554, "o", "Verifying formulas...\r\n\r\nExpression data formulas (C11:C12):\r\nC11: =IFERROR(INDEX(Data.$D$2:$BA$201,MATCH($A11,Data.$A$2:$A$201,0),MATCH(C$10,Data.$D$1:$BA$1,0)),\"\")\r\nC12: =IFERROR(INDEX(Data.$D$2:$BA$201,MATCH($A12,Data.$A$2:$A$201,0),MATCH(C$10,Data.$D$1:$BA$1,0)),\"\")\r\n\r\nStatistics formulas (row 24):\r\nC24: =AVERAGE(C11:G11)\r\nD24: =AVERAGE(C12:G12)\r\nE24: =AVERAGE(C13:G13)\r\n\r\nFold change formulas (rows 32-33):\r\nA32: =A11\r\nC32: =2^(C26-C24)\r\nD32: =C26-C24\r\n"]
[90.451707, "o", "A33: =A12\r\nC33: =2^(D26-D24)\r\nD33: =D26-D24\r\n\r\nFormulas verified successfully!\r\n\r\nNow loading with data_only=True to check calculated values...\r\n"]
