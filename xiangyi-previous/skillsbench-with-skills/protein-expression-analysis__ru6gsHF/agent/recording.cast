[33.901024, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\n# Check rows 1-10 in Task sheet\nprint(\"Task sheet - Rows 1-10, columns A-M:\")\nfor row in range(1, 11):\n    row_data = []\n    for col in range(1, 14):\n        cell_value = task_sheet.cell(row, col).value\n        row_data.append(str(cell_value)[:25] if cell_value else \"\")\n    print(f\"Row {row}: {row_data}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"Task sheet - Rows 9-10 in detail (all columns):\")\nfor row in [9, 10]:\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 20):\n        cell_value = task_sheet.cell(row, col).value\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell_value:\n            print(f\"  {col_letter}{row}: {cell_value}\")\n\nEOF\n"]
