[125.421892, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('/root/protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"FINAL COMPREHENSIVE VERIFICATION\")\nprint(\"=\"*80)\n\nprint(\"\\n1. TARGET PROTEINS (Column A, rows 11-20):\")\nfor row in range(11, 21):\n    protein = task_sheet[f'A{row}'].value\n    if protein:\n        print(f\"   Row {row}: {protein[:40]}...\")\n\nprint(\"\\n2. SAMPLE CLASSIFICATION (Row 9):\")\nprint(f\"   Control samples: C9-G9\")\nfor col in ['C', 'D', 'E', 'F', 'G']:\n    val = task_sheet[f'{col}9'].value\n    print(f\"   {col}9: {val}\")\nprint(f\"   Treated samples: H9-L9\")\nfor col in ['H', 'I', 'J', 'K', 'L']:\n    val = task_sheet[f'{col}9'].value\n    print(f\"   {col}9: {val}\")\n\nprint(\"\\n3. EXPRESSION DATA FORMULAS (Sample: C11, D11, H11):\")\nfor col in ['C', 'D', 'H']:\n    formula = task_sheet[f'{col}11'].value\n    print(f\"   {col}11: {formula[:60]}...\")\n\nprint(\"\\n4. STATISTICS FORMULAS:\")\nprint(f\"   C24 (Control Mean): {task_sheet['C24'].value}\")\nprint(f\"   C25 (Control StdDev): {task_sheet['C25'].value}\")\nprint(f\"   C26 (Treated Mean): {task_sheet['C26'].value}\")\nprint(f\"   C27 (Treated StdDev): {task_sheet['C27'].value}\")\n\nprint(\"\\n5. FOLD CHANGE FORMULAS (Row 32):\")\nprint(f\"   A32 (Protein ID): {task_sheet['A32'].value}\")\nprint(f\"   B32 (Gene Symbol): {task_sheet['B32'].value}\")\nprint(f\"   C32 (Fold Change): {task_sheet['C32'].value}\")\nprint(f\"   D32 (Log2 FC): {task_sheet['D32'].value}\")\n\nprint(\"\\n6. LAST ROW CHECK (Row 41):\")\nprint(f\"   A41 (Protein ID): {task_sheet['A41'].value}\")\nprint(f\"   C41 (Fold Change): {task_sheet['C41'].value}\")\nprint(f\"   D41 (Log2 FC): {task_sheet['D41'].value}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"✓ ALL REQUIRED FORMULAS ARE IN PLACE\")\nprint(\"✓ TASK COMPLETED SUCCESSFULLY\")\nprint(\"=\"*80)\n\nEOF\n"]
