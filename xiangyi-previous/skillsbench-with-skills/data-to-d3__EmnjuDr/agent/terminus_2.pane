[?2004l[?2004hroot@e4af873d765d:~# cat <<EOF > /root/output/js/visualization.js
[?2004l[?2004h> // Get dimensions
[?2004l[?2004h> const chartArea = document.getElementById('chart-area');
[?2004l[?2004h> const width = chartArea.clientWidth;
[?2004l[?2004h> const height = chartArea.clientHeight;
[?2004l[?2004h> 
[?2004l [?2004h> const svg = d3.select("#chart-area").append("svg")
[?2004l[?2004h>     .attr("width", width)
[?2004l[?2004h>     .attr("height", height);
[?2004l[?2004h> 
[?2004l[?2004h> const tooltip = d3.select("#tooltip");
[?2004l[?2004h> 
[?2004l[?2004h> d3.csv("data/stock-descriptions.csv").then(data => {
[?2004l[?2004h>     // Process data
[?2004l[?2004h>     data.forEach(d => {
[?2004l[?2004h>         d.marketCapVal = parseFloat(d.marketCap);
[?2004l[?2004h>         d.isETF = isNaN(d.marketCapVal) || d.marketCap === "";
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     const sectors = Array.from(new Set(data.map(d => d.sector))).sort();
[?2004l[?2004h>     
[?2004l[?2004h>     // Scales
[?2004l[?2004h>     const colorScale = d3.scaleOrdinal()
[?2004l[?2004h>         .domain(sectors)
[?2004l[?2004h>         .range(d3.schemeCategory10);
[?2004l[?2004h> 
[?2004l[?2004h>     // Filter valid caps for scale domain
[?2004l[?2004h>     const validCaps = data.filter(d => !d.isETF).map(d => d.marketCapVal);
[?2004l[?2004h>     const minCap = d3.min(validCaps);
[?2004l[?2004h>     const maxCap = d3.max(validCaps);
[?2004l[?2004h> 
[?2004l[?2004h>     const sizeScale = d3.scaleSqrt()
[?2004l[?2004h>         .domain([minCap, maxCap])
[?2004l[?2004h>         .range([15, 60]); 
[?2004l[?2004h> 
[?2004l[?2004h>     const getRadius = (d) => {
[?2004l[?2004h>         if (d.isETF) return 20; 
[?2004l[?2004h>         return sizeScale(d.marketCapVal);
[?2004l[?2004h>     };
[?2004l[?2004h> 
[?2004l[?2004h>     // Force Simulation Centers
[?2004l[?2004h>     const xCenter = d3.scalePoint()
[?2004l[?2004h>         .domain(sectors)
[?2004l[?2004h>         .range([100, width - 100])
[?2004l[?2004h>         .padding(0.5);
[?2004l[?2004h> 
[?2004l[?2004h>     const simulation = d3.forceSimulation(data)
[?2004l[?2004h>         .force("charge", d3.forceManyBody().strength(5))
[?2004l[?2004h>         .force("collide", d3.forceCollide().radius(d => getRadius(d) + 2).strength(0.7))
[?2004l[?2004h>         .force("x", d3.forceX(d => xCenter(d.sector)).strength(0.4))
[?2004l[?2004h>         .force("y", d3.forceY(height / 2).strength(0.15))
[?2004l[?2004h>         .on("tick", ticked);
[?2004l[?2004h> 
[?2004l[?2004h>     // Draw Bubbles
[?2004l[?2004h>     const node = svg.selectAll(".node")
[?2004l[?2004h>         .data(data)
[?2004l[?2004h>         .enter().append("g")
[?2004l[?2004h>         .attr("class", "node")
[?2004l ret[?2004h>         .call(drag(simulation));
[?2004l[?2004h> 
[?2004la[?2004h>     const circles = node.append("circle")
[?2004l[?2004h>         .attr("r", d => getRadius(d))
[?2004l[?2004h>         .attr("fill", d => colorScale(d.sector))
[?2004l[?2004h>         .attr("stroke", "#fff")
[?2004l[?2004h>         .attr("stroke-width", 1.5)
[?2004l[?2004h>         .on("mouseover", (event, d) => {
[?2004l[?2004h>             if (d.isETF) return;
[?2004l[?2004h>             tooltip.transition().duration(200).style("opacity", .9);
[?2004l[?2004h>             tooltip.html(`<strong>${d.ticker}</strong><br>${d["full name"]}<br>${d.sector}`)
[?2004l[?2004h>                 .style("left", (event.pageX + 10) + "px")
[?2004l[?2004h>                 .style("top", (event.pageY - 28) + "px");
[?2004l[?2004h>         })
[?2004l[?2004h>         .on("mouseout", (event, d) => {
[?2004l[?2004h>             tooltip.transition().duration(500).style("opacity", 0);
[?2004l[?2004h>         })
[?2004l[?2004h>         .on("click", (event, d) => highlight(d));
[?2004l[?2004h> 
[?2004l[?2004h>     const labels = node.append("text")
[?2004l[?2004h>         .text(d => d.ticker)
[?2004l[?2004h>         .attr("text-anchor", "middle")
[?2004l[?2004h>         .attr("dy", ".35em")
[?2004l[?2004h>         .style("font-size", "10px")
[?2004l[?2004h>         .style("pointer-events", "none");
[?2004l[?2004h> 
[?2004l[?2004h>     function ticked() {
[?2004l[?2004h>         node.attr("transform", d => {
[?2004l[?2004h>             // Keep within bounds
[?2004l[?2004h>             const r = getRadius(d);
[?2004l[?2004h>             d.x = Math.max(r, Math.min(width - r, d.x));
[?2004l[?2004h>             d.y = Math.max(r, Math.min(height - r, d.y));
[?2004l[?2004h>             return `translate(${d.x},${d.y})`;
[?2004l[?2004h>         });
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // Legend
[?2004l[?2004h>     const legend = svg.selectAll(".legend")
[?2004l[?2004h>         .data(sectors)
[?2004l[?2004h>         .enter().append("g")
[?2004l[?2004h>         .attr("class", "legend")
[?2004l[?2004h>         .attr("transform", (d, i) => `translate(20, ${20 + i * 20})`);
[?2004l[?2004h> 
[?2004l[?2004h>     legend.append("rect")
[?2004l[?2004h>         .attr("x", 0)
[?2004l[?2004h>         .attr("width", 12)
[?2004l[?2004h>         .attr("height", 12)
[?2004l[?2004h>         .style("fill", colorScale);
[?2004l[?2004h> 
[?2004l[?2004h>     legend.append("text")
[?2004l[?2004h>         .attr("x", 18)
[?2004l[?2004h>         .attr("y", 6)
[?2004l[?2004h>         .attr("dy", ".35em")
[?2004l[?2004h>         .text(d => d)
[?2004l[?2004h>         .style("font-size", "12px");
[?2004l[?2004h> 
[?2004l[?2004h>     // Table
[?2004l[?2004h>     const tableArea = d3.select("#table-area");
[?2004l[?2004h>     const table = tableArea.append("table");
[?2004l[?2004h>     const thead = table.append("thead");
[?2004l[?2004h>     const tbody = table.append("tbody");
[?2004l[?2004h> 
[?2004l[?2004h>     const columns = ["Ticker symbol", "Full company name", "Sector", "Market cap"];
[?2004l[?2004h>     
[?2004l[?2004h>     thead.append("tr")
[?2004l[?2004h>         .selectAll("th")
[?2004l[?2004h>         .data(columns)
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append("th")
[?2004l[?2004h>         .text(d => d);
[?2004l[?2004h> 
[?2004l[?2004h>     const rows = tbody.selectAll("tr")
[?2004l[?2004h>         .data(data)
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append("tr")
[?2004l[?2004h>         .attr("id", d => "row-" + d.ticker)
[?2004l[?2004h>         .on("click", (event, d) => highlight(d));
[?2004l[?2004h> 
[?2004l[?2004h>     rows.selectAll("td")
[?2004l[?2004h>         .data(d => {
[?2004l[?2004h>             return [
[?2004l[?2004h>                 d.ticker,
[?2004l[?2004h>                 d["full name"],
[?2004l[?2004h>                 d.sector,
[?2004l[?2004h>                 formatMarketCap(d.marketCapVal)
[?2004l[?2004h>             ];
[?2004l[?2004h>         })
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append("td")
[?2004l[?2004h>         .text(d => d);
[?2004l[?2004h> 
[?2004l[?2004h>     function formatMarketCap(val) {
[?2004l[?2004h>         if (!val || isNaN(val)) return "N/A";
[?2004l[?2004h>         if (val >= 1e12) return (val / 1e12).toFixed(2) + "T";
[?2004l[?2004h>         if (val >= 1e9) return (val / 1e9).toFixed(2) + "B";
[?2004l[?2004h>         if (val >= 1e6) return (val / 1e6).toFixed(2) + "M";
[?2004l[?2004h>         return val;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     function highlight(d) {
[?2004l[?2004h>         circles.attr("stroke", "#fff").attr("stroke-width", 1.5);
