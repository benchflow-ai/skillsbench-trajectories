[235.147026, "o", "package clusterdata.datatypes;\r\n\r\nimport java.io.Serializable;\r\n\r\npublic class TaskEvent implements Serializable {\r\n    private static final long serialVersionUID = 1L;\r\n    \r\n    public Long timestamp;\r\n    public String missingInfo;\r\n    public Long jobId;\r\n    public Long taskIndex;\r\n    public Long machineId;\r\n    public Integer eventType;\r\n    public String user;\r\n    public Integer schedulingClass;\r\n    public Integer priority;\r\n    public Double cpuRequest;\r\n    public Double memoryRequest;\r\n    public Double diskSpaceRequest;\r\n    public Integer differentMachinesRestriction;\r\n    \r\n    public TaskEvent() {}\r\n    \r\n    public TaskEvent(Long timestamp, String missingInfo, Long jobId, Long taskIndex,\r\n                     Long machineId, Integer eventType, String user, Integer schedulingClass,\r\n                     Integer priority, Double cpuRequest, Double memoryRequest,\r\n                     Double diskSpaceRequest, Integer differentMachinesRestriction) {\r\n        this.timestamp = timestamp;\r\n        this.missingInfo = missingInfo;\r\n        this.jobId = jobId;\r\n        this.taskIndex = taskIndex;\r\n        this.machineId = machineId;\r\n        this.eventType = eventType;\r\n        this.user = user;\r\n        this.schedulingClass = schedulingClass;\r\n        this.priority = priority;\r\n        this.cpuRequest = cpuRequest;\r\n        this.memoryRequest = memoryRequest;\r\n        this.diskSpaceRequest = diskSpaceRequest;\r\n        this.differentMachinesRestriction = differentMachinesRestriction;\r\n    }\r\n    \r\n    public static TaskEvent fromString(String line) {\r\n        String[] parts = line.split(\",\", -1);\r\n        if (parts.length < 13) return null;\r\n        \r\n        try {\r\n            TaskEvent event = new TaskEvent();\r\n            event.timestamp = parts[0].isEmpty() ? null : Long.parseLong(parts[0]);\r\n            event.missingInfo = parts[1];\r\n            event.jobId = parts[2].isEmpty() ? null : Long.parseLong(parts[2]);\r\n            event.taskIndex = parts[3].isEmpty() ? null : Long.parseLong(parts[3]);\r\n            event.machineId = parts[4].isEmpty() ? null : Long.parseLong(parts[4]);\r\n            event.eventType = parts[5].isEmpty() ? null : Integer.parseInt(parts[5]);\r\n            event.user = parts[6];\r\n            event.schedulingClass = parts[7].isEmpty() ? null : Integer.parseInt(parts[7]);\r\n            event.priority = parts[8].isEmpty() ? null : Integer.parseInt(parts[8]);\r\n            event.cpuRequest = parts[9].isEmpty() ? null : Double.parseDouble(parts[9]);\r\n            event.memoryRequest = parts[10].isEmpty() ? null : Double.parseDouble(parts[10]);\r\n            event.diskSpaceRequest = parts[11].isEmpty() ? null : Double.parseDouble(parts[11]);\r\n            event.differentMachinesRestriction = parts[12].isEmpty() ? null : Integer.parseInt(parts[12]);\r\n            return event;\r\n        } catch (Exception e) {\r\n            return null;\r\n        }\r\n    }\r\n    \r\n    public Long getTimestamp() { return timestamp; }\r\n    public Long getJobId() { return jobId; }\r\n    public Integer getEventType() { return eventType; }\r\n    \r\n    @Override\r\n    public String toString() {\r\n        return \"TaskEvent{\" +\r\n                \"timestamp=\" + timestamp +\r\n                \", jobId=\" + jobId +\r\n                \", taskIndex=\" + taskIndex +\r\n                \", eventType=\" + eventType +\r\n                '}';\r\n    }\r\n}\r\n"]
[235.147694, "o", "=== /app/workspace/src/main/java/clusterdata/datatypes/JobEvent.java ===\r\n"]
[235.148323, "o", "package clusterdata.datatypes;\r\n\r\nimport java.io.Serializable;\r\n\r\npublic class JobEvent implements Serializable {\r\n    private static final long serialVersionUID = 1L;\r\n    \r\n    public Long timestamp;\r\n    public String missingInfo;\r\n    public Long jobId;\r\n    public Integer eventType;\r\n    public String user;\r\n    public Integer schedulingClass;\r\n    public String jobName;\r\n    public String logicalJobName;\r\n    \r\n    public JobEvent() {}\r\n    \r\n    public JobEvent(Long timestamp, String missingInfo, Long jobId, Integer eventType,\r\n                    String user, Integer schedulingClass, String jobName, String logicalJobName) {\r\n        this.timestamp = timestamp;\r\n        this.missingInfo = missingInfo;\r\n        this.jobId = jobId;\r\n        this.eventType = eventType;\r\n        this.user = user;\r\n        this.schedulingClass = schedulingClass;\r\n        this.jobName = jobName;\r\n        this.logicalJobName = logicalJobName;\r\n    }\r\n    \r\n    public static JobEvent fromString(String line) {\r\n        String[] parts = line.split(\",\", -1);\r\n        if (parts.length < 8) return null;\r\n        \r\n        try {\r\n            JobEvent event = new JobEvent();\r\n            event.timestamp = parts[0].isEmpty() ? null : Long.parseLong(parts[0]);\r\n            event.missingInfo = parts[1];\r\n            event.jobId = parts[2].isEmpty() ? null : Long.parseLong(parts[2]);\r\n            event.eventType = parts[3].isEmpty() ? null : Integer.parseInt(parts[3]);\r\n            event.user = parts[4];\r\n            event.schedulingClass = parts[5].isEmpty() ? null : Integer.parseInt(parts[5]);\r\n            event.jobName = parts[6];\r\n            event.logicalJobName = parts[7];\r\n            return event;\r\n        } catch (Exception e) {\r\n            return null;\r\n        }\r\n    }\r\n    \r\n    public Long getTimestamp() { return timestamp; }\r\n    public Long getJobId() { return jobId; }\r\n    public Integer getEventType() { return eventType; }\r\n    \r\n    @Override\r\n    public String toString() {\r\n        return \"JobEvent{\" +\r\n                \"timestamp=\" + timestamp +\r\n                \", jobId=\" + jobId +\r\n                \", eventType=\" + eventType +\r\n                '}';\r\n    }\r\n}\r\n"]
