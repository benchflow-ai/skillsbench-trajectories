[72.83976, "o", "import clusterdata.utils.AppBase;\r\n\u001b[?2004l\rg"]
[72.839803, "o", "\u001b[?2004h> "]
[72.839902, "o", "import org.apache.flink.api.common.eventtime.WatermarkStrategy;\r\n\u001b[?2004l\r St\u001b[?2004h> "]
[72.840038, "o", "import org.apache.flink.api.common.functions.MapFunction;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.84018, "o", "import org.apache.flink.api.common.functions.ReduceFunction;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.840286, "o", "import org.apache.flink.api.java.tuple.Tuple2;\r\n\u001b[?2004l\r"]
[72.840332, "o", "\u001b[?2004h> "]
[72.840408, "o", "import org.apache.flink.api.java.utils.ParameterTool;\r\n\u001b[?2004l\r"]
[72.840448, "o", "\u001b[?2004h> "]
[72.840507, "o", "import org.apache.flink.core.fs.Path;\r\n\u001b[?2004l\rf\u001b[?2004h"]
[72.840548, "o", "> "]
[72.840647, "o", "import org.apache.flink.streaming.api.datastream.DataStream;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.84081, "o", "import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\r\n\u001b[?2004l\r"]
[72.840854, "o", "\u001b[?2004h> "]
[72.840959, "o", "import org.apache.flink.streaming.api.functions.source.SourceFunction;\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.840984, "o", "> "]
[72.841134, "o", "import org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.841181, "o", "> "]
[72.841263, "o", "import org.apache.flink.streaming.api.windowing.time.Time;\r\n\u001b[?2004l\r"]
[72.841287, "o", "\u001b[?2004h> "]
[72.841408, "o", "import org.apache.flink.api.common.serialization.SimpleStringEncoder;\r\n\u001b[?2004l\r"]
[72.84145, "o", "\u001b[?2004h> "]
[72.841582, "o", "import org.apache.flink.streaming.api.functions.sink.filesystem.StreamingFileSink;\r\n\u001b[?2004l\r"]
[72.841606, "o", "\u001b[?2004h> "]
[72.841794, "o", "import org.apache.flink.streaming.api.functions.sink.filesystem.rollingpolicies.DefaultRollingPolicy;\r\n\u001b[?2004l\r"]
[72.841823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.841886, "o", "import java.io.BufferedReader;\r\n\u001b[?2004l\ru"]
[72.84191, "o", "\u001b[?2004h> "]
[72.841973, "o", "import java.io.InputStreamReader;\r\n\u001b[?2004l\r \u001b[?2004h"]
[72.842016, "o", "> "]
[72.842043, "o", "import java.time.Duration;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.842129, "o", "import java.util.zip.GZIPInputStream;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.842208, "o", "import java.io.FileInputStream;\r\n\u001b[?2004l\r"]
[72.842256, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[72.84234, "o", "public class LongestSessionPerJob extends AppBase {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.842364, "o", "\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[72.84248, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\re\u001b[?2004h"]
[72.842504, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[72.842648, "o", "        ParameterTool params = ParameterTool.fromArgs(args);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.842767, "o", "        String taskInput = params.get(\"task_input\", null);\r\n\u001b[?2004l\r"]
[72.842792, "o", "\u001b[?2004h> "]
[72.842891, "o", "        String jobInput = params.get(\"job_input\", null);\r\n\u001b[?2004l\r"]
[72.842929, "o", "\u001b[?2004h> "]
[72.843055, "o", "        String outputPath = params.get(\"output\", null);\r\n\u001b[?2004l\r is"]
[72.84309, "o", "\u001b[?2004h> "]
[72.843185, "o", "        System.out.println(\"task_input  \" + taskInput);\r\n\u001b[?2004l\r"]
[72.843235, "o", "\u001b[?2004h> "]
[72.843286, "o", "        System.out.println(\"job_input  \" + jobInput);\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.84333, "o", "> "]
[72.843387, "o", "        final int sesssize = params.getInt(\"sesssize\", 600);\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.843423, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.843494, "o", "        // set up streaming execution environment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.843658, "o", "        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.843706, "o", "        env.setParallelism(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.843751, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.843809, "o", "        // Read task events from gzipped CSV\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.843858, "o", "> "]
[72.843977, "o", "        DataStream<TaskEvent> taskEvents = env.addSource(taskSourceOrTest(new TaskEventSource(taskInput)))\r\n\u001b[?2004l\r"]
[72.844025, "o", "\u001b[?2004h> "]
[72.844062, "o", "                .name(\"TaskEvents\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.844111, "o", "\u001b[?2004h> "]
[72.844217, "o", "        // Filter SUBMIT events (eventType = 0), assign timestamps and watermarks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.844345, "o", "        // Timestamps in data are in microseconds, convert to milliseconds for Flink\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.844394, "o", "> "]
[72.844443, "o", "        DataStream<TaskEvent> submitEvents = taskEvents\r\n\u001b[?2004l\r"]
[72.844487, "o", "\u001b[?2004h> "]
[72.844614, "o", "                .filter(event -> event != null && event.eventType != null && event.eventType == 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.844727, "o", "                        && event.jobId != null && event.timestamp != null)\r\n\u001b[?2004l\r"]
[72.844772, "o", "\u001b[?2004h> "]
[72.844814, "o", "                .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.844865, "o", "> "]
[72.84498, "o", "                        WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofSeconds(10))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845206, "o", "                                .withTimestampAssigner((event, timestamp) -> event.timestamp / 1000) // microseconds to milliseconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845236, "o", "                );\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.845301, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845402, "o", "        // Group by jobId, apply session window with 10-minute gap, count tasks per session\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845514, "o", "        DataStream<Tuple2<Long, Long>> sessionCounts = submitEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845628, "o", "                .map(new MapFunction<TaskEvent, Tuple2<Long, Long>>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.845689, "o", "                    @Override\r\n\u001b[?2004l\r"]
[72.845743, "o", "\u001b[?2004h> "]
[72.845813, "o", "                    public Tuple2<Long, Long> map(TaskEvent event) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.845856, "o", "> "]
[72.845921, "o", "                        return new Tuple2<>(event.jobId, 1L);\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.845944, "o", "> "]
[72.846003, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.846042, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.846086, "o", "                .keyBy(t -> t.f0)\r\n\u001b[?2004l\r"]
[72.846133, "o", "\u001b[?2004h> "]
[72.84623, "o", "                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.84634, "o", "                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\r\n\u001b[?2004l\r"]
[72.846384, "o", "\u001b[?2004h> "]
[72.84642, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.846571, "o", "                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> v1, Tuple2<Long, Long> v2) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.846682, "o", "                        return new Tuple2<>(v1.f0, v1.f1 + v2.f1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.84673, "o", "                    }\r\n\u001b[?2004l\r"]
[72.846757, "o", "\u001b[?2004h> "]
[72.846781, "o", "                });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[72.846845, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.846884, "o", "        // Find max session count per job\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.847008, "o", "        DataStream<Tuple2<Long, Long>> maxPerJob = sessionCounts\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847059, "o", "> "]
[72.847098, "o", "                .keyBy(t -> t.f0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.847181, "o", "                .reduce(new ReduceFunction<Tuple2<Long, Long>>() {\r\n\u001b[?2004l\r"]
[72.847218, "o", "\u001b[?2004h> "]
[72.84727, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847312, "o", "> "]
[72.847406, "o", "                    public Tuple2<Long, Long> reduce(Tuple2<Long, Long> v1, Tuple2<Long, Long> v2) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847445, "o", "> "]
[72.847506, "o", "                        return v1.f1 >= v2.f1 ? v1 : v2;\r\n\u001b[?2004l\r"]
[72.847531, "o", "\u001b[?2004h> "]
[72.847589, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847626, "o", ">                 });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847671, "o", "> "]
[72.847707, "o", "        // Format output as (jobId,count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.847857, "o", "        DataStream<String> output = maxPerJob.map(new MapFunction<Tuple2<Long, Long>, String>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.847881, "o", "> "]
[72.847944, "o", "            @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848006, "o", "            public String map(Tuple2<Long, Long> value) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.84805, "o", "> "]
[72.848139, "o", "                return \"(\" + value.f0 + \",\" + value.f1 + \")\";\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[72.848186, "o", "\u001b[?2004h> "]
[72.848237, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848275, "o", "        // Write to output file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848334, "o", "        if (outputPath != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848499, "o", "            output.writeAsText(outputPath, org.apache.flink.core.fs.FileSystem.WriteMode.OVERWRITE);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848537, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848601, "o", "            output.print();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.848617, "o", "        }\r\n\u001b[?2004l\r"]
[72.848633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.848656, "o", "\u001b[?2004h> "]
[72.848725, "o", "        env.execute(\"LongestSessionPerJob\");\r\n\u001b[?2004l\r"]
[72.848741, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[72.848762, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.848779, "o", "\u001b[?2004h> "]
[72.848858, "o", "    // Custom source to read gzipped CSV files\r\n\u001b[?2004l\r"]
[72.848878, "o", "\u001b[?2004h> "]
[72.848989, "o", "    public static class TaskEventSource implements SourceFunction<TaskEvent> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849061, "o", "        private final String filePath;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849156, "o", "        private volatile boolean isRunning = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849175, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849267, "o", "        public TaskEventSource(String filePath) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849346, "o", "            this.filePath = filePath;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849368, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.849389, "o", "\u001b[?2004h> "]
[72.849428, "o", "        @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849544, "o", "        public void run(SourceContext<TaskEvent> ctx) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849648, "o", "            try (BufferedReader reader = new BufferedReader(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.84972, "o", "                    new InputStreamReader(\r\n\u001b[?2004l\r"]
[72.849741, "o", "\u001b[?2004h> "]
[72.849866, "o", "                            new GZIPInputStream(new FileInputStream(filePath))))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.849917, "o", "                String line;\r\n\u001b[?2004l\r"]
[72.849937, "o", "\u001b[?2004h> "]
[72.850041, "o", "                while (isRunning && (line = reader.readLine()) != null) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.850062, "o", "> "]
[72.850154, "o", "                    TaskEvent event = TaskEvent.fromString(line);\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.850176, "o", "> "]
[72.850235, "o", "                    if (event != null) {\r\n\u001b[?2004l\r"]
[72.850258, "o", "\u001b[?2004h> "]
[72.850316, "o", "                        ctx.collect(event);\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.850336, "o", "> "]
[72.850365, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.850399, "o", "                }\r\n\u001b[?2004l\r"]
[72.850418, "o", "\u001b[?2004h> "]
[72.850441, "o", "            }\r\n\u001b[?2004l\r"]
[72.850458, "o", "\u001b[?2004h> "]
[72.850476, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.850496, "o", "\u001b[?2004h> "]
[72.85053, "o", "        @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.850551, "o", "> "]
[72.850593, "o", "        public void cancel() {\r\n\u001b[?2004l\r"]
[72.850613, "o", "\u001b[?2004h> "]
[72.850657, "o", "            isRunning = false;\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.850674, "o", "> "]
[72.850692, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.850709, "o", "    }\r\n\u001b[?2004l\r"]
[72.850725, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[72.850744, "o", "\u001b[?2004h> "]
[72.850763, "o", "EOF\r\n\u001b[?2004l\r"]
[72.856537, "o", "\u001b[?2004hroot@68268defd200:/app/workspace# "]
[77.841762, "i", "cat /app/workspace/pom.xml\n"]
[77.841983, "o", "cat /app/workspace/pom.xml\r\n\u001b[?2004l\r"]
[77.842813, "o", "<!--\r\nLicensed to the Apache Software Foundation (ASF) under one\r\nor more contributor license agreements.  See the NOTICE file\r\ndistributed with this work for additional information\r\nregarding copyright ownership.  The ASF licenses this file\r\nto you under the Apache License, Version 2.0 (the\r\n\"License\"); you may not use this file except in compliance\r\nwith the License.  You may obtain a copy of the License at\r\n\r\n  http://www.apache.org/licenses/LICENSE-2.0\r\n\r\nUnless required by applicable law or agreed to in writing,\r\nsoftware distributed under the License is distributed on an\r\n\"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\r\nKIND, either express or implied.  See the License for the\r\nspecific language governing permissions and limitations\r\nunder the License.\r\n-->\r\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\r\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\">\r\n    <modelVersion>4.0.0</modelVersion>\r\n\r\n    <groupId>clusterdata-analysis</groupId>\r\n    <artifactId>clusterdata-analysis</artifactId>\r\n    <version>0.1</version>\r\n    <packaging>jar</packaging>\r\n\r\n    <name>Cluster data analysis</name>\r\n\r\n    <properties>\r\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\r\n        <flink.version>1.18.0</flink.version>\r\n        <target.java.version>11</target.java.version>\r\n        <scala.binary.version>2.12</scala.binary.version>\r\n        <maven.compiler.source>${target.java.version}</maven.compiler.source>\r\n        <maven.compiler.target>${target.java.version}</maven.compiler.target>\r\n        <log4j.version>2.17.1</log4j.version>\r\n    </properties>\r\n\r\n    <repositories>\r\n        <repository>\r\n            <id>apache.snapshots</id>\r\n            <name>Apache Development Snapshot Repository</name>\r\n            <url>https://repository.apache.org/content/repositories/snapshots/</url>\r\n            <releases>\r\n                <enabled>false</enabled>\r\n            </releases>\r\n            <snapshots>\r\n                <enabled>true</enabled>\r\n            </snapshots>\r\n        </repository>\r\n    </repositories>\r\n\r\n    <dependencies>\r\n        <!-- Apache Flink dependencies -->\r\n\r\n        <!-- https://mvnrepository.com/artifact/org.apache.flink/flink-examples-streaming -->\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-examples-streaming</artifactId>\r\n            <version>1.18.0</version>\r\n        </dependency>\r\n\r\n        <!-- These dependencies are provided, because they should not be packaged into the JAR file. -->\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-java</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-streaming-java</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-clients</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-walkthrough-common</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n\r\n        <!-- Add connector dependencies here. They must be in the default scope (compile). -->\r\n\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-connector-kafka</artifactId>\r\n            <version>1.17.0</version>\r\n        </dependency>\r\n\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-connector-wikiedits</artifactId>\r\n            <version>${flink.version}</version>\r\n        </dependency>\r\n\r\n        <!-- Add logging framework, to produce console output when running in the IDE. -->\r\n        <!-- These dependencies are excluded from the application JAR by default. -->\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-slf4j-impl</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-api</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-core</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n    </dependencies>\r\n\r\n    <build>\r\n        <plugins>\r\n\r\n            <!-- Java Compiler -->\r\n            <plugin>\r\n                <groupId>org.apache.maven.plugins</groupId>\r\n                <artifactId>maven-compiler-plugin</artifactId>\r\n                <version>3.9.0</version>\r\n                <configuration>\r\n                    <source>${target.java.version}</source>\r\n                    <target>${target.java.version}</target>\r\n                </configuration>\r\n            </plugin>\r\n\r\n            <plugin>\r\n                <groupId>org.apache.maven.plugins</groupId>\r\n                <artifactId>maven-assembly-plugin</artifactId>\r\n                <version>3.3.0</version>\r\n                <configuration>\r\n                    <descriptorRefs>\r\n                        <descriptorRef>jar-with-dependencies</descriptorRef>\r\n                    </descriptorRefs>\r\n                </configuration>\r\n                <executions>\r\n                    <execution>"]
[77.842857, "o", "\r\n                        <id>LongestSessionPerJob</id>\r\n                        <phase>package</phase>\r\n                        <goals>\r\n                            <goal>single</goal>\r\n                        </goals>\r\n                        <configuration>\r\n                            <finalName>LongestSessionPerJob</finalName>\r\n                            <archive>\r\n                                <manifestEntries>\r\n                                    <program-class>clusterdata.query.LongestSessionPerJob</program-class>\r\n                                </manifestEntries>\r\n                            </archive>\r\n                        </configuration>\r\n                    </execution>\r\n                </executions>\r\n            </plugin>\r\n\r\n        </plugins>\r\n\r\n        <pluginManagement>\r\n            <plugins>\r\n\r\n                <!-- This improves the out-of-the-box experience in Eclipse by resolving some warnings. -->\r\n                <plugin>\r\n                    <groupId>org.eclipse.m2e</groupId>\r\n                    <artifactId>lifecycle-mapping</artifactId>\r\n                    <version>1.0.0</version>\r\n                    <configuration>\r\n                        <lifecycleMappingMetadata>\r\n                            <pluginExecutions>\r\n                                <pluginExecution>\r\n                                    <pluginExecutionFilter>\r\n                                        <groupId>org.apache.maven.plugins</groupId>\r\n                                        <artifactId>maven-shade-plugin</artifactId>\r\n                                        <versionRange>[3.2.4,)</versionRange>\r\n                                        <goals>\r\n                                            <goal>shade</goal>\r\n                                        </goals>\r\n                                    </pluginExecutionFilter>\r\n                                    <action>\r\n                                        <ignore/>\r\n                                    </action>\r\n                                </pluginExecution>\r\n                                <pluginExecution>\r\n                                    <pluginExecutionFilter>\r\n                                        <groupId>org.apache.maven.plugins</groupId>\r\n                                        <artifactId>maven-compiler-plugin</artifactId>\r\n                                        <versionRange>[3.9.0,)</versionRange>\r\n                                        <goals>\r\n                                            <goal>testCompile</goal>\r\n                                            <goal>compile</goal>\r\n                                        </goals>\r\n                                    </pluginExecutionFilter>\r\n                                    <action>\r\n                                        <ignore/>\r\n                                    </action>\r\n                                </pluginExecution>\r\n                            </pluginExecutions>\r\n                        </lifecycleMappingMetadata>\r\n                    </configuration>\r\n                </plugin>\r\n            </plugins>\r\n        </pluginManagement>\r\n    </build>"]
[77.842998, "o", "\r\n</project>\r\n"]
