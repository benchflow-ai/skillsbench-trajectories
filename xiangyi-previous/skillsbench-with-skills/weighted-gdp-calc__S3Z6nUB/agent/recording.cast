[158.080394, "o", "\u001b[?2004hroot@d613bed5710f:~# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('gdp.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Task']\r\n\u001b[?2004l\r\u001b[?2004h> print('H12 formula:', ws['H12'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print('H35 formula:', ws['H35'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print('H42 formula:', ws['H42'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print('H50 formula:', ws['H50'].value)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[158.644875, "o", "H12 formula: =INDEX(Data!$H$21:$M$40, MATCH($D12, Data!$B$21:$B$40,0), MATCH(H$9, Data!$H$4:$M$4,0))\r\nH35 formula: =(H12-H19)/H26*100\r\nH42 formula: =MIN(H35:H40)\r\nH50 formula: =SUMPRODUCT(H35:H40,H26:H31)/SUM(H26:H31)\r\n"]
