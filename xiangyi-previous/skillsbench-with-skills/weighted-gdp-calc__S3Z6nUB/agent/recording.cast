[14.863869, "i", "python3 - <<'PY'\nimport openpyxl, pandas as pd\nwb=openpyxl.load_workbook('gdp.xlsx')\nprint(wb.sheetnames)\nws=wb['Task']\n# print headers row 10, columns H to L maybe\nprint('Task row10 H:L:', [ws.cell(row=10, column=c).value for c in range(8,13)])\n# print series code cells row12? row12 maybe column G? We'll see\nfor r in range(12,18):\n    print(r, [ws.cell(row=r, column=c).value for c in range(6,9)])\n# print Data sheet rows 21-40 columns? let's see columns A-H maybe\nwsd=wb['Data']\nprint('Data row20 header', [wsd.cell(row=20, column=c).value for c in range(1,10)])\nfor r in range(21,26):\n    print(r, [wsd.cell(row=r, column=c).value for c in range(1,10)])\nPY\n"]
