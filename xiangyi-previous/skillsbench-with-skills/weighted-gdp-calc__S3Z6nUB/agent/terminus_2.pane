[?2004hroot@d613bed5710f:~# python3 - <<'PY'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> wb=openpyxl.load_workbook('gdp.xlsx')
[?2004l[?2004h> ws=wb['Task']
[?2004l[?2004h> # Step1 ranges
[?2004l[?2004h> ranges = [(12,17),(19,24),(26,31)]
[?2004l[?2004h> for rstart,rend in ranges:
[?2004l[?2004h>     for r in range(rstart,rend+1):
[?2004l[?2004h>         for c in range(8,13):  # H-L
[?2004l[?2004h>             col_letter=get_column_letter(c)
[?2004l[?2004h>             formula = f"=INDEX(Data!$H$21:$M$40, MATCH($D{r}, Data!$B$21:$B$40,0), MATCH({col_letter}$9, Data!$H$4:$M$4,0))"
[?2004l[?2004h>             ws.cell(row=r, column=c).value = formula
[?2004l[?2004h> # Step2 net exports percent of GDP
[?2004l[?2004h> for r in range(35,41):
[?2004l[?2004h>     exports_row = r-23
[?2004l[?2004h>     imports_row = r-16
[?2004l[?2004h>     gdp_row = r-9
[?2004l[?2004h>     for c in range(8,13):
[?2004l[?2004h>         col_letter=get_column_letter(c)
[?2004l[?2004h>         formula = f"=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100"
[?2004l[?2004h>         ws.cell(row=r, column=c).value = formula
[?2004l[?2004h> # Summary stats rows 42-47
[?2004l[?2004h> stat_formulas = {
[?2004l[?2004h>     42: "MIN",
[?2004l[?2004h>     43: "MAX",
[?2004l[?2004h>     44: "MEDIAN",
[?2004l[?2004h>     45: "AVERAGE",
[?2004l[?2004h>     46: "PERCENTILE.INC",
[?2004l[?2004h>     47: "PERCENTILE.INC",
[?2004l[?2004h> }
[?2004l[?2004h> for r,func in stat_formulas.items():
[?2004l[?2004h>     for c in range(8,13):
[?2004l[?2004h>         col_letter=get_column_letter(c)
[?2004l[?2004h>         if r in (46,47):
[?2004l[?2004h>             percentile = "0.25" if r==46 else "0.75"
[?2004l[?2004h>             formula = f"={func}({col_letter}35:{col_letter}40,{percentile})"
[?2004l[?2004h>         else:
[?2004l[?2004h>             formula = f"={func}({col_letter}35:{col_letter}40)"
[?2004l[?2004h>         ws.cell(row=r, column=c).value = formula
[?2004l[?2004h> # Weighted mean row 50
[?2004l[?2004h> for c in range(8,13):
[?2004l[?2004h>     col_letter=get_column_letter(c)
[?2004l[?2004h>     formula = f"=SUMPRODUCT({col_letter}35:{col_letter}40,{col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"
[?2004l[?2004h>     ws.cell(row=50, column=c).value = formula
[?2004l[?2004h> 
