[?2004hroot@d34c5c09ba07:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('gdp.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Fill yellow cells H12:L17, H19:L24, H26:L31 with INDEX/MATCH formulas
[?2004l[?2004h> # Formula structure: =INDEX(Data!$H$21:$M$40,MATCH($D12,Data!$B$21:$B$40,0),MATCH(H$9,Data!$H$4:$M$4,0))
[?2004l[?2004h> 
[?2004l[?2004h> # Define the ranges to fill
[?2004l[?2004h> ranges = [
[?2004l[?2004h>     (12, 17),  # H12:L17
[?2004l[?2004h>     (19, 24),  # H19:L24  
[?2004l[?2004h>     (26, 31)   # H26:L31
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> for start_row, end_row in ranges:
[?2004l[?2004h>     for row in range(start_row, end_row + 1):
[?2004l[?2004h>         for col in range(8, 13):  # H to L (columns 8-12)
[?2004l[?2004h>             col_letter = openpyxl.utils.get_column_letter(col)
[?2004l[?2004h>             # Create INDEX/MATCH formula
[?2004l[?2004h>             formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col_letter}$9,Data!$H$4:$M$4,0))'
[?2004l[?2004h>             task_sheet.cell(row, col).value = formula
[?2004l[?2004h>             print(f"Set {col_letter}{row}: {formula}")
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('gdp.xlsx')
[?2004l[?2004h> print("\nStep 1 formulas added successfully!")
[?2004l[?2004h> wb.close()
