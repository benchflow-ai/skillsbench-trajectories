[?2004hroot@d34c5c09ba07:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('gdp.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2a: Calculate Net Exports as % of GDP in H35:L40
[?2004l[?2004h> # Formula: (Exports - Imports) / GDP * 100
[?2004l[?2004h> # Exports are in rows 12-17, Imports in rows 19-24, GDP in rows 26-31
[?2004l[?2004h> for row in range(35, 41):
[?2004l[?2004h>     exports_row = row - 35 + 12  # Maps 35->12, 36->13, etc.
[?2004l[?2004h>     imports_row = row - 35 + 19  # Maps 35->19, 36->20, etc.
[?2004l[?2004h>     gdp_row = row - 35 + 26      # Maps 35->26, 36->27, etc.
[?2004l[?2004h>     
[?2004l[?2004h>     for col in range(8, 13):  # H to L
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(col)
[?2004l[?2004h>         # Formula: (Exports - Imports) / GDP * 100
[?2004l[?2004h>         formula = f'=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100'
[?2004l[?2004h>         task_sheet.cell(row, col).value = formula
[?2004l[?2004h>         print(f"Set {col_letter}{row}: {formula}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nStep 2a: Net Exports % of GDP formulas added!")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2b: Add statistical formulas in rows 42-47
[?2004l[?2004h> stats = [
[?2004l[?2004h>     (42, 'MIN', '=MIN(H$35:H$40)'),
[?2004l[?2004h>     (43, 'MAX', '=MAX(H$35:H$40)'),
[?2004l[?2004h>     (44, 'MEDIAN', '=MEDIAN(H$35:H$40)'),
[?2004l[?2004h>     (45, 'AVERAGE', '=AVERAGE(H$35:H$40)'),
[?2004l[?2004h>     (46, 'PERCENTILE.INC 25', '=PERCENTILE.INC(H$35:H$40,0.25)'),
[?2004l[?2004h>     (47, 'PERCENTILE.INC 75', '=PERCENTILE.INC(H$35:H$40,0.75)')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> for stat_row, stat_name, formula_template in stats:
[?2004l[?2004h>     for col in range(8, 13):  # H to L
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(col)
[?2004l[?2004h>         # Replace H with current column letter in formula
[?2004l[?2004h>         formula = formula_template.replace('H', col_letter)
[?2004l[?2004h>         task_sheet.cell(stat_row, col).value = formula
[?2004l[?2004h>         print(f"Set {col_letter}{stat_row} ({stat_name}): {formula}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nStep 2b: Statistical formulas added!")
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('gdp.xlsx')
[?2004l[?2004h> print("\nStep 2 complete! File saved.")
[?2004l[?2004h> wb.close()
[?2004l[?2004h> EOF
[?2004lSet H35: =(H12-H19)/H26*100
Set I35: =(I12-I19)/I26*100
Set J35: =(J12-J19)/J26*100
Set K35: =(K12-K19)/K26*100
Set L35: =(L12-L19)/L26*100
