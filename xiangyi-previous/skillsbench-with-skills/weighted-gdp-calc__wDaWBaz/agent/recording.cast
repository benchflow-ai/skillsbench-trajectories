[117.054378, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== Task Sheet Rows 42-50 (Statistics area) ===\")\nfor row in range(42, 51):\n    values = []\n    for col in range(1, 13):\n        val = task_sheet.cell(row, col).value\n        if val:\n            col_letter = openpyxl.utils.get_column_letter(col)\n            values.append(f\"{col_letter}:{str(val)[:50]}\")\n    if values:\n        print(f\"Row {row}: {' | '.join(values)}\")\n\nwb.close()\nEOF\n"]
