[151.151594, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== Checking Row 50 structure ===\")\nfor col in range(1, 13):\n    val = task_sheet.cell(50, col).value\n    if val:\n        col_letter = openpyxl.utils.get_column_letter(col)\n        print(f\"{col_letter}50: {val}\")\n\nprint(\"\\n=== Adding Step 3: Weighted Mean formulas ===\")\n# Step 3: Calculate weighted mean using SUMPRODUCT\n# Formula: SUMPRODUCT(Net Exports % GDP, GDP) / SUM(GDP)\n# Net Exports % GDP are in rows 35-40, GDP values are in rows 26-31\n\nfor col in range(8, 13):  # H to L\n    col_letter = openpyxl.utils.get_column_letter(col)\n    # Weighted mean: SUMPRODUCT(net_exports_pct, gdp) / SUM(gdp)\n    formula = f'=SUMPRODUCT({col_letter}$35:{col_letter}$40,{col_letter}$26:{col_letter}$31)/SUM({col_letter}$26:{col_letter}$31)'\n    task_sheet.cell(50, col).value = formula\n    print(f\"Set {col_letter}50: {formula}\")\n\nwb.save('gdp.xlsx')\nprint(\"\\nStep 3 complete! Weighted mean formulas added.\")\nprint(\"\\nAll tasks completed successfully!\")\nwb.close()\nEOF\n"]
