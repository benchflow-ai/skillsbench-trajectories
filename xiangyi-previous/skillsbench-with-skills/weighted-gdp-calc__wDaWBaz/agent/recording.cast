[49.013627, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\ndata_sheet = wb['Data']\n\nprint(\"=== Data Sheet Headers (Row 20 - likely has years) ===\")\nfor col in range(1, 20):\n    val = data_sheet.cell(20, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}20: {val}\")\n\nprint(\"\\n=== Task Sheet Rows 8-11 (looking for year headers) ===\")\nfor row in range(8, 12):\n    values = []\n    for col in range(1, 15):\n        val = task_sheet.cell(row, col).value\n        if val:\n            values.append(f\"{openpyxl.utils.get_column_letter(col)}:{val}\")\n    if values:\n        print(f\"Row {row}: {' | '.join(values)}\")\n\nprint(\"\\n=== Task Sheet Sample Yellow Cells ===\")\nfor row in [12, 13]:\n    for col in range(8, 13):  # H-L\n        cell = task_sheet.cell(row, col)\n        val = cell.value\n        print(f\"{openpyxl.utils.get_column_letter(col)}{row}: {val}\")\n\nwb.close()\nEOF\n"]
