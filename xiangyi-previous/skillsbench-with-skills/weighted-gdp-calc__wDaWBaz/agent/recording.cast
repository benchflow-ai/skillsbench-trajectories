[75.740279, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ndata_sheet = wb['Data']\ntask_sheet = wb['Task']\n\nprint(\"=== Data Sheet Row 4 (Years) ===\")\nfor col in range(1, 20):\n    val = data_sheet.cell(4, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}4: {val}\")\n\nprint(\"\\n=== Task Sheet Row 9 (Years) ===\")\nfor col in range(8, 13):\n    val = task_sheet.cell(9, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}9: {val}\")\n\nprint(\"\\n=== Verify series codes match ===\")\nprint(\"Task D12:\", task_sheet.cell(12, 4).value)\nprint(\"Data B21 (UAE BXGS):\", data_sheet.cell(21, 2).value)\nfor row in range(21, 41):\n    if '466BXGS' in str(data_sheet.cell(row, 2).value):\n        print(f\"Found UAE BXGS at Data row {row}: {data_sheet.cell(row, 2).value}\")\n\nwb.close()\nEOF\n"]
