[36.892915, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\ndata_sheet = wb['Data']\n\nprint(\"=== Task Sheet Row 10 (wider range) ===\")\nfor col in range(1, 15):\n    val = task_sheet.cell(10, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}10: {val}\")\n\nprint(\"\\n=== Data Sheet Row 1 (headers) ===\")\nfor col in range(1, 15):\n    val = data_sheet.cell(1, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}1: {val}\")\n\nprint(\"\\n=== Data Sheet Rows 21-25 (sample data with all columns) ===\")\nfor row in range(21, 26):\n    values = []\n    for col in range(1, 15):\n        cell = data_sheet.cell(row, col)\n        val = str(cell.value)[:20] if cell.value else ''\n        values.append(f\"{openpyxl.utils.get_column_letter(col)}:{val}\")\n    print(f\"Row {row}: {' | '.join(values[:8])}\")\n\nprint(\"\\n=== Task Sheet - Country names and labels ===\")\nfor row in [12, 13, 14, 15, 16, 17]:\n    print(f\"Row {row}: C={task_sheet.cell(row, 3).value}, D={task_sheet.cell(row, 4).value}\")\n\nwb.close()\nEOF\n"]
