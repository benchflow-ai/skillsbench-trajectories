[91.415176, "o", "# Step 1: Fill yellow cells H12:L17, H19:L24, H26:L31 with INDEX/MATCH formulas\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.415306, "o", "# Formula structure: =INDEX(Data!$H$21:$M$40,MATCH($D12,Data!$B$21:$B$40,0),MATCH(H$9,Data!$H$4:$M$4,0))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.41541, "o", "\u001b[?2004h> "]
[91.415487, "o", "# Define the ranges to fill\r\n\u001b[?2004l\r\u001b[?2004h> ranges = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.415568, "o", "    (12, 17),  # H12:L17\r\n\u001b[?2004l\r\u001b[?2004h>     (19, 24),  # H19:L24  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.415651, "o", "    (26, 31)   # H26:L31\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.415715, "o", "\u001b[?2004h> "]
[91.415782, "o", "for start_row, end_row in ranges:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.415834, "o", "    for row in range(start_row, end_row + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.415914, "o", "        for col in range(8, 13):  # H to L (columns 8-12)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.417167, "o", "            col_letter = openpyxl.utils.get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h>             # Create INDEX/MATCH formula\r\n\u001b[?2004l\r\u001b[?2004h>             formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col_letter}$9,Data!$H$4:$M$4,0))'\r\n\u001b[?2004l\r\u001b[?2004h>             task_sheet.cell(row, col).value = formula\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Set {col_letter}{row}: {formula}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('gdp.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nStep 1 formulas added successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
