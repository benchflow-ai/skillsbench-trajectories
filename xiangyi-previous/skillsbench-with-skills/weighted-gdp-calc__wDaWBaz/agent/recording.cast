[91.414179, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\n# Step 1: Fill yellow cells H12:L17, H19:L24, H26:L31 with INDEX/MATCH formulas\n# Formula structure: =INDEX(Data!$H$21:$M$40,MATCH($D12,Data!$B$21:$B$40,0),MATCH(H$9,Data!$H$4:$M$4,0))\n\n# Define the ranges to fill\nranges = [\n    (12, 17),  # H12:L17\n    (19, 24),  # H19:L24  \n    (26, 31)   # H26:L31\n]\n\nfor start_row, end_row in ranges:\n    for row in range(start_row, end_row + 1):\n        for col in range(8, 13):  # H to L (columns 8-12)\n            col_letter = openpyxl.utils.get_column_letter(col)\n            # Create INDEX/MATCH formula\n            formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col_letter}$9,Data!$H$4:$M$4,0))'\n            task_sheet.cell(row, col).value = formula\n            print(f\"Set {col_letter}{row}: {formula}\")\n\nwb.save('gdp.xlsx')\nprint(\"\\nStep 1 formulas added successfully!\")\nwb.close()\nEOF\n"]
[91.414668, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
