[63.540523, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"=== Checking for year headers in Data sheet ===\")\nfor row in range(1, 21):\n    row_vals = []\n    for col in range(1, 15):\n        val = data_sheet.cell(row, col).value\n        if val and ('2019' in str(val) or '2020' in str(val) or 'Year' in str(val) or row == 1):\n            row_vals.append(f\"{openpyxl.utils.get_column_letter(col)}:{val}\")\n    if row_vals:\n        print(f\"Row {row}: {' | '.join(row_vals)}\")\n\nprint(\"\\n=== Data Sheet Sample Row with Series Code ===\")\nrow = 21\nfor col in range(1, 15):\n    val = data_sheet.cell(row, col).value\n    print(f\"{openpyxl.utils.get_column_letter(col)}{row}: {val}\")\n\nprint(\"\\n=== Checking if years are in columns H onwards ===\")\nfor col in range(8, 15):\n    # Check if there's any indication of year in early rows\n    for row in [1, 2, 3, 19, 20]:\n        val = data_sheet.cell(row, col).value\n        if val:\n            print(f\"{openpyxl.utils.get_column_letter(col)}{row}: {val}\")\n\nwb.close()\nEOF\n"]
