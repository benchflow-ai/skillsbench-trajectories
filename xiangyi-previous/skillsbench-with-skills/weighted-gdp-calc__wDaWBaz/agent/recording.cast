[135.423121, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\n# Step 2a: Calculate Net Exports as % of GDP in H35:L40\n# Formula: (Exports - Imports) / GDP * 100\n# Exports are in rows 12-17, Imports in rows 19-24, GDP in rows 26-31\nfor row in range(35, 41):\n    exports_row = row - 35 + 12  # Maps 35->12, 36->13, etc.\n    imports_row = row - 35 + 19  # Maps 35->19, 36->20, etc.\n    gdp_row = row - 35 + 26      # Maps 35->26, 36->27, etc.\n    \n    for col in range(8, 13):  # H to L\n        col_letter = openpyxl.utils.get_column_letter(col)\n        # Formula: (Exports - Imports) / GDP * 100\n        formula = f'=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100'\n        task_sheet.cell(row, col).value = formula\n        print(f\"Set {col_letter}{row}: {formula}\")\n\nprint(\"\\nStep 2a: Net Exports % of GDP formulas added!\")\n\n# Step 2b: Add statistical formulas in rows 42-47\nstats = [\n    (42, 'MIN', '=MIN(H$35:H$40)'),\n    (43, 'MAX', '=MAX(H$35:H$40)'),\n    (44, 'MEDIAN', '=MEDIAN(H$35:H$40)'),\n    (45, 'AVERAGE', '=AVERAGE(H$35:H$40)'),\n    (46, 'PERCENTILE.INC 25', '=PERCENTILE.INC(H$35:H$40,0.25)'),\n    (47, 'PERCENTILE.INC 75', '=PERCENTILE.INC(H$35:H$40,0.75)')\n]\n\nfor stat_row, stat_name, formula_template in stats:\n    for col in range(8, 13):  # H to L\n        col_letter = openpyxl.utils.get_column_letter(col)\n        # Replace H with current column letter in formula\n        formula = formula_template.replace('H', col_letter)\n        task_sheet.cell(stat_row, col).value = formula\n        print(f\"Set {col_letter}{stat_row} ({stat_name}): {formula}\")\n\nprint(\"\\nStep 2b: Statistical formulas added!\")\n\nwb.save('gdp.xlsx')\nprint(\"\\nStep 2 complete! File saved.\")\nwb.close()\nEOF\n"]
