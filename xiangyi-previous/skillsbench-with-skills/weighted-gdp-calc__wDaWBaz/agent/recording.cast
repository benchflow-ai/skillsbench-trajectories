[135.430532, "o", "    (47, 'PERCENTILE.INC 75', '=PERCENTILE.INC(H$35:H$40,0.75)')\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for stat_row, stat_name, formula_template in stats:\r\n\u001b[?2004l\r\u001b[?2004h>     for col in range(8, 13):  # H to L\r\n\u001b[?2004l\r\u001b[?2004h>         col_letter = openpyxl.utils.get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h>         # Replace H with current column letter in formula\r\n\u001b[?2004l\r\u001b[?2004h>         formula = formula_template.replace('H', col_letter)\r\n\u001b[?2004l\r\u001b[?2004h>         task_sheet.cell(stat_row, col).value = formula\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Set {col_letter}{stat_row} ({stat_name}): {formula}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nStep 2b: Statistical formulas added!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('gdp.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nStep 2 complete! File saved.\")\r\n\u001b[?2004l\r\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[135.975699, "o", "Set H35: =(H12-H19)/H26*100\r\nSet I35: =(I12-I19)/I26*100\r\nSet J35: =(J12-J19)/J26*100\r\nSet K35: =(K12-K19)/K26*100\r\nSet L35: =(L12-L19)/L26*100\r\nSet H36: =(H13-H20)/H27*100\r\nSet I36: =(I13-I20)/I27*100\r\nSet J36: =(J13-J20)/J27*100\r\nSet K36: =(K13-K20)/K27*100\r\nSet L36: =(L13-L20)/L27*100\r\nSet H37: =(H14-H21)/H28*100\r\nSet I37: =(I14-I21)/I28*100\r\nSet J37: =(J14-J21)/J28*100\r\nSet K37: =(K14-K21)/K28*100\r\nSet L37: =(L14-L21)/L28*100\r\nSet H38: =(H15-H22)/H29*100\r\nSet I38: =(I15-I22)/I29*100\r\n"]
[135.975878, "o", "Set J38: =(J15-J22)/J29*100\r\nSet K38: =(K15-K22)/K29*100\r\nSet L38: =(L15-L22)/L29*100\r\nSet H39: =(H16-H23)/H30*100\r\nSet I39: =(I16-I23)/I30*100\r\nSet J39: =(J16-J23)/J30*100\r\nSet K39: =(K16-K23)/K30*100\r\nSet L39: =(L16-L23)/L30*100\r\nSet H40: =(H17-H24)/H31*100\r\nSet I40: =(I17-I24)/I31*100\r\nSet J40: =(J17-J24)/J31*100\r\nSet K40: =(K17-K24)/K31*100\r\nSet L40: =(L17-L24)/L31*100\r\n\r\nStep 2a: Net Exports % of GDP formulas added!\r\nSet H42 (MIN): =MIN(H$35:H$40)\r\nSet I42 (MIN): =MIN(I$35:I$40)\r\nSet J42 (MIN): =MIN(J$35:J$40)\r\nSet K42 (MIN): =MIN(K$35:K$40)\r\nSet L42 (MIN): =MIN(L$35:L$40)\r\nSet H43 (MAX): =MAX(H$35:H$40)\r\nSet I43 (MAX): =MAX(I$35:I$40)\r\nSet J43 (MAX): =MAX(J$35:J$40)\r\nSet K43 (MAX): =MAX(K$35:K$40)\r\nSet L43 (MAX): =MAX(L$35:L$40)\r\nSet H44 (MEDIAN): =MEDIAN(H$35:H$40)\r\nSet I44 (MEDIAN): =MEDIAN(I$35:I$40)\r\nSet J44 (MEDIAN): =MEDIAN(J$35:J$40)\r\nSet K44 (MEDIAN): =MEDIAN(K$35:K$40)\r\nSet L44 (MEDIAN): =MEDIAN(L$35:L$40)\r\nSet H45 (AVERAGE): =AVERAGE(H$35:H$40)\r\nSet I45 (AVERAGE): =AVERAGE(I$35:I$40)\r\n"]
[135.975942, "o", "Set J45 (AVERAGE): =AVERAGE(J$35:J$40)\r\nSet K45 (AVERAGE): =AVERAGE(K$35:K$40)\r\nSet L45 (AVERAGE): =AVERAGE(L$35:L$40)\r\nSet H46 (PERCENTILE.INC 25): =PERCENTILE.INC(H$35:H$40,0.25)\r\nSet I46 (PERCENTILE.INC 25): =PERCENTILE.INC(I$35:I$40,0.25)\r\nSet J46 (PERCENTILE.INC 25): =PERCENTILE.INC(J$35:J$40,0.25)\r\nSet K46 (PERCENTILE.INC 25): =PERCENTILE.INC(K$35:K$40,0.25)\r\nSet L46 (PERCENTILE.INC 25): =PERCENTILE.INC(L$35:L$40,0.25)\r\n"]
[135.976004, "o", "Set H47 (PERCENTILE.INC 75): =PERCENTILE.INC(H$35:H$40,0.75)\r\nSet I47 (PERCENTILE.INC 75): =PERCENTILE.INC(I$35:I$40,0.75)\r\nSet J47 (PERCENTILE.INC 75): =PERCENTILE.INC(J$35:J$40,0.75)\r\nSet K47 (PERCENTILE.INC 75): =PERCENTILE.INC(K$35:K$40,0.75)\r\nSet L47 (PERCENTILE.INC 75): =PERCENTILE.INC(L$35:L$40,0.75)\r\n\r\nStep 2b: Statistical formulas added!\r\n"]
