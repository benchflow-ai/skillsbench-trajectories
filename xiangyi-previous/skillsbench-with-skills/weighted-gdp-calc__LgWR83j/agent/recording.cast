[37.923928, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('gdp.xlsx', data_only=True)\nws_data = wb['Data']\nfor r in range(1, 21):\n    row_vals = [ws_data.cell(row=r, column=c).value for c in range(1, 15)]\n    if any(row_vals):\n        print(f'Data Row {r}: {row_vals}')\n\nws_task = wb['Task']\nfor r in range(8, 12):\n    print(f'Task Row {r} (G-M):', [ws_task.cell(row=r, column=c).value for c in range(7, 14)])\n\" \n"]
