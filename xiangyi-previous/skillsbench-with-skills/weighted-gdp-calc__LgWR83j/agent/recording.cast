[48.182363, "i", "python3 -c \"\nimport openpyxl\nfrom openpyxl.styles import Color\nwb = openpyxl.load_workbook('gdp.xlsx')\nws_task = wb['Task']\ndef get_color(cell):\n    if cell.fill and cell.fill.start_color:\n        return cell.fill.start_color.index\n    return None\n\nprint('Row 9 colors:', [get_color(ws_task.cell(row=9, column=c)) for c in range(8, 13)])\nprint('Row 10 colors:', [get_color(ws_task.cell(row=10, column=c)) for c in range(8, 13)])\nprint('Col D colors:', [get_color(ws_task.cell(row=r, column=4)) for r in range(12, 18)])\n\n# Also check the values of row 10 again with data_only=False\nprint('Row 10 values:', [ws_task.cell(row=10, column=c).value for c in range(8, 13)])\n\" \n"]
