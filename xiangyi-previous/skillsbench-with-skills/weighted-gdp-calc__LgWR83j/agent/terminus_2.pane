[?2004hroot@6daa90849180:~# cat << 'EOF' > solution.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('gdp.xlsx')
[?2004l[?2004h> ws_task = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Fill in H12:L17, H19:L24, H26:L31
[?2004l[?2004h> # Formula: =INDEX(Data!$A$1:$M$100, MATCH($D12, Data!$B$1:$B$100, 0), MATCH(H$9, Data!$A$4:$M$4, 0))
[?2004l[?2004h> for r in list(range(12, 18)) + list(range(19, 25)) + list(range(26, 32)):
[?2004l[?2004h>     for c in range(8, 13): # H to L
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(c)
[?2004l[?2004h>         formula = f'=INDEX(Data!$A$1:$M$100, MATCH($D{r}, Data!$B$1:$B$100, 0), MATCH({col_letter}$9, Data!$A$4:$M$4, 0))'
[?2004l[?2004h>         ws_task.cell(row=r, column=c).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Calculate net exports as % of GDP in H35:L40
[?2004l[?2004h> for r in range(35, 41):
[?2004l[?2004h>     for c in range(8, 13):
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(c)
[?2004l[?2004h>         # UAE is row 35, its data is in 12, 19, 26
[?2004l[?2004h>         # Bahrain is row 36, its data is in 13, 20, 27
[?2004l[?2004h>         # So for row r, data is in r-23, r-16, r-9
[?2004l[?2004h>         r_exp = r - 23
[?2004l[?2004h>         r_imp = r - 16
[?2004l[?2004h>         r_gdp = r - 9
[?2004l[?2004h>         formula = f"=({col_letter}{r_exp}-{col_letter}{r_imp})/{col_letter}{r_gdp}*100"
[?2004l[?2004h>         ws_task.cell(row=r, column=c).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Stats in H42:L47
[?2004l[?2004h> stats = ['MIN', 'MAX', 'MEDIAN', 'AVERAGE', 'PERCENTILE.INC', 'PERCENTILE.INC']
[?2004l[?2004h> for i, stat in enumerate(stats):
[?2004l[?2004h>     row = 42 + i
[?2004l[?2004h>     for c in range(8, 13):
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(c)
[?2004l[?2004h>         if 'PERCENTILE' in stat:
[?2004l[?2004h>             p = 0.25 if i == 4 else 0.75
[?2004l[?2004h>             formula = f"={stat}({col_letter}$35:{col_letter}$40, {p})"
[?2004l[?2004h>         else:
[?2004l[?2004h>             formula = f"={stat}({col_letter}$35:{col_letter}$40)"
[?2004l[?2004h>         ws_task.cell(row=row, column=c).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Weighted Mean in H50:L50
[?2004l[?2004h> for c in range(8, 13):
[?2004l[?2004h>     col_letter = openpyxl.utils.get_column_letter(c)
[?2004l[?2004h>     # Weighted Mean = SUMPRODUCT(NetExports%GDP_Range, GDP_Range) / SUM(GDP_Range)
[?2004l[?2004h>     # NetExports%GDP: H35:H40, GDP: H26:H31
[?2004l[?2004h>     formula = f"=SUMPRODUCT({col_letter}35:{col_letter}40, {col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"
[?2004l[?2004h>     ws_task.cell(row=50, column=c).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('gdp.xlsx')
