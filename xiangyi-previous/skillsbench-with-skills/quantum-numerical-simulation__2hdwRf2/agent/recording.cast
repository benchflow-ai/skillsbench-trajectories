[41.809394, "o", "            rho_ss = qt.steadystate(H, c_ops, method='iterative-gmres')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.809503, "o", "            print(f\"  Steady state found using iterative-gmres method\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.809554, "o", "> "]
[41.809595, "o", "        except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.809656, "o", "            rho_ss = qt.steadystate(H, c_ops, method='eigen')\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.809712, "o", "> "]
[41.809782, "o", "            print(f\"  Steady state found using eigen method\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.809836, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.809917, "o", "    # Trace out spin degrees of freedom to get cavity state\r\n\u001b[?2004l\r\u001b[?2004h> "]
