^Ccat > dicke_wigner2.py << 'EOF'
import numpy as np
import qutip as qt

# Parameters
N = 4  # Number of two-level systems
omega_0 = 1.0  # Spin frequency
omega_c = 1.0  # Cavity frequency
g = 2.0 / np.sqrt(N)  # Coupling strength
kappa = 1.0  # Cavity loss rate
n_max = 16  # Photon number cutoff

# Grid for Wigner function
xvec = np.linspace(-6, 6, 1000)
pvec = np.linspace(-6, 6, 1000)

print(f"Setting up Dicke model with N={N} spins, n_max={n_max} photons")

# Build full Hilbert space with individual spins
# Dimensions: [cavity, spin1, spin2, spin3, spin4]
dims = [n_max] + [2] * N
total_dim = np.prod(dims)
print(f"Total Hilbert space dimension: {total_dim}")

# Create identity operators
Id_cav = qt.qeye(n_max)
Id_spin = qt.qeye(2)

# Cavity annihilation operator
a_op = qt.destroy(n_max)
for i in range(N):
    a_op = qt.tensor(a_op, Id_spin) if i == 0 else a_op
a = qt.tensor(qt.destroy(n_max), *[Id_spin]*N)

# Single spin operators
sigma_z = qt.sigmaz()
sigma_p = qt.sigmap()
sigma_m = qt.sigmam()

def spin_op(op, k):
    """Create operator acting on k-th spin (0-indexed) in full Hilbert space."""
    op_list = [Id_cav] + [Id_spin]*N
    op_list[k+1] = op  # +1 because cavity is at index 0
    return qt.tensor(op_list)

# Collective spin operators
Jz = sum(spin_op(sigma_z, k) for k in range(N)) / 2
Jp = sum(spin_op(sigma_p, k) for k in range(N))
Jm = sum(spin_op(sigma_m, k) for k in range(N))

# Hamiltonian
# H = omega_0 * Jz + omega_c * a^dag * a + g * (a^dag + a) * (J+ + J-)
H = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)

print("Hamiltonian created")

def get_collapse_operators(case):
    """Get collapse operators for each case."""
    c_ops = []
    
    # Cavity decay (always present)
    c_ops.append(np.sqrt(kappa) * a)
    
    if case == 1:
        # Local de-phasing & local pumping
        gamma_phi = 0.01
        gamma_up = 0.1
        # Local dephasing on each spin
        for k in range(N):
            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))
        # Local pumping on each spin
        for k in range(N):
            c_ops.append(np.sqrt(gamma_up) * spin_op(sigma_p, k))
        
    elif case == 2:
        # Local de-phasing & local emission
        gamma_phi = 0.01
        gamma_down = 0.1
        # Local dephasing on each spin
        for k in range(N):
            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))
        # Local emission on each spin
        for k in range(N):
            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))
        
    elif case == 3:
        # Local de-phasing & local emission & collective pumping
        gamma_phi = 0.01
        gamma_down = 0.1
        gamma_Up = 0.1
        # Local dephasing
        for k in range(N):
            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))
        # Local emission
        for k in range(N):
            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))
        # Collective pumping
        c_ops.append(np.sqrt(gamma_Up) * Jp)
        
    elif case == 4:
        # Local de-phasing & local emission & collective emission
        gamma_phi = 0.01
        gamma_down = 0.1
        gamma_Down = 0.1
        # Local dephasing
        for k in range(N):
            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))
        # Local emission
        for k in range(N):
            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))
        # Collective emission
        c_ops.append(np.sqrt(gamma_Down) * Jm)
    
    return c_ops

def solve_steady_state_and_wigner(case):
    """Solve for steady state and compute Wigner function of cavity."""
    print(f"\nCase {case}: Computing steady state...")
    
    c_ops = get_collapse_operators(case)
    print(f"  Number of collapse operators: {len(c_ops)}")
    
    # Solve for steady state with robust settings
    rho_ss = qt.steadystate(H, c_ops, method='direct', solver='solve')
    print(f"  Steady state found")
    
    # Trace out spin degrees of freedom to get cavity state
    # Trace over all spin indices (1, 2, 3, 4)
    rho_cavit  Steady state found using eigen method
