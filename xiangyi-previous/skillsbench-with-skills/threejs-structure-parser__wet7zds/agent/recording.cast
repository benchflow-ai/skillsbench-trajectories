[47.287808, "o", "        const normal = new THREE.Vector3();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.288121, "o", "        for (let i = 0; i < normalAttribute.count; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.28815, "o", "> "]
[47.288399, "o", "            normal.set(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.288568, "o", "                normalAttribute.getX(i),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.288644, "o", "                normalAttribute.getY(i),\r\n\u001b[?2004l\r"]
[47.288666, "o", "\u001b[?2004h> "]
[47.288795, "o", "                normalAttribute.getZ(i)\r\n\u001b[?2004l\r"]
[47.288817, "o", "\u001b[?2004h> "]
[47.288927, "o", "            );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.289088, "o", "            normal.applyMatrix3(normalMatrix).normalize();\r\n\u001b[?2004l\r"]
[47.289113, "o", "\u001b[?2004h> "]
[47.289306, "o", "            obj += `vn ${normal.x} ${normal.y} ${normal.z}\\n`;\r\n\u001b[?2004l\r"]
[47.289386, "o", "\u001b[?2004h> "]
[47.28941, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.289429, "o", "> "]
[47.289481, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.289666, "o", "    // Write faces\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.289739, "o", "    const index = geometry.getIndex();\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.289832, "o", ">     if (index) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.290022, "o", "        for (let i = 0; i < index.count; i += 3) {\r\n\u001b[?2004l\r"]
[47.290046, "o", "\u001b[?2004h> "]
[47.290258, "o", "            const a = index.getX(i) + 1 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.290285, "o", "\u001b[?2004h> "]
[47.290594, "o", "            const b = index.getX(i + 1) + 1 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.290618, "o", "\u001b[?2004h> "]
[47.290943, "o", "            const c = index.getX(i + 2) + 1 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.290964, "o", "\u001b[?2004h> "]
[47.291124, "o", "            if (normalAttribute) {\r\n\u001b[?2004l\r"]
[47.291146, "o", "\u001b[?2004h> "]
[47.291356, "o", "                obj += `f ${a}//${a} ${b}//${b} ${c}//${c}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.291382, "o", "> "]
[47.291476, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.29162, "o", "                obj += `f ${a} ${b} ${c}\\n`;\r\n\u001b[?2004l\r"]
[47.291652, "o", "\u001b[?2004h> "]
[47.291753, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.291828, "o", "        }\r\n\u001b[?2004l\r"]
[47.29192, "o", "\u001b[?2004h> "]
[47.291945, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.292206, "o", "        for (let i = 0; i < positionAttribute.count; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.29239, "o", "            const a = i + 1 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.292409, "o", "\u001b[?2004h> "]
[47.292637, "o", "            const b = i + 2 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.292665, "o", "\u001b[?2004h> "]
[47.292861, "o", "            const c = i + 3 + vertexOffset;\r\n\u001b[?2004l\r"]
[47.292892, "o", "\u001b[?2004h> "]
[47.293055, "o", "            if (normalAttribute) {\r\n\u001b[?2004l\r"]
[47.293083, "o", "\u001b[?2004h> "]
[47.293298, "o", "                obj += `f ${a}//${a} ${b}//${b} ${c}//${c}\\n`;\r\n\u001b[?2004l\r"]
[47.293323, "o", "\u001b[?2004h> "]
[47.293403, "o", "            } else {\r\n\u001b[?2004l\r"]
[47.293421, "o", "\u001b[?2004h> "]
[47.293569, "o", "                obj += `f ${a} ${b} ${c}\\n`;\r\n\u001b[?2004l\r"]
[47.293625, "o", "\u001b[?2004h> "]
[47.293643, "o", "            }\r\n\u001b[?2004l\r"]
[47.293671, "o", "\u001b[?2004h> "]
[47.293731, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.293754, "o", "    }\r\n\u001b[?2004l\r"]
[47.293807, "o", "\u001b[?2004h> "]
[47.293846, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.294009, "o", "    return { obj, vertexCount: positionAttribute.count };\r\n\u001b[?2004l\r"]
[47.294052, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[47.294102, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.29412, "o", "> "]
[47.294254, "o", "// Function to export a single mesh to OBJ\r\n\u001b[?2004l\r"]
[47.294278, "o", "\u001b[?2004h> "]
[47.294403, "o", "function exportMeshToOBJ(mesh) {\r\n\u001b[?2004l\r"]
[47.294423, "o", "\u001b[?2004h> "]
[47.294558, "o", "    let geometry = mesh.geometry;\r\n\u001b[?2004l\r"]
[47.294632, "o", "\u001b[?2004h> "]
[47.2947, "o", "    if (!geometry) return '';\r\n\u001b[?2004l\r"]
[47.29476, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[47.294855, "o", "\u001b[?2004h> "]
[47.294944, "o", "    // Ensure geometry is BufferGeometry\r\n\u001b[?2004l\r"]
[47.295005, "o", "\u001b[?2004h> "]
[47.295107, "o", "    if (!geometry.isBufferGeometry) {\r\n\u001b[?2004l\r"]
[47.295161, "o", "\u001b[?2004h> "]
[47.295341, "o", "        console.warn('Non-BufferGeometry found, skipping');\r\n\u001b[?2004l\r"]
[47.295363, "o", "\u001b[?2004h> "]
[47.295426, "o", "        return '';\r\n\u001b[?2004l\r"]
[47.29545, "o", "\u001b[?2004h> "]
[47.295497, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.295517, "o", "> "]
[47.295573, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.2957, "o", "    // Compute normals if not present\r\n\u001b[?2004l\r"]
[47.295731, "o", "\u001b[?2004h> "]
[47.295876, "o", "    if (!geometry.getAttribute('normal')) {\r\n\u001b[?2004l\r"]
[47.295897, "o", "\u001b[?2004h> "]
[47.295993, "o", "        geometry.computeVertexNormals();\r\n\u001b[?2004l\r"]
[47.296027, "o", "\u001b[?2004h"]
[47.296047, "o", "> "]
[47.296071, "o", "    }\r\n\u001b[?2004l\r"]
[47.296093, "o", "\u001b[?2004h> "]
[47.296117, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.296139, "o", "> "]
[47.296251, "o", "    const result = geometryToOBJ(geometry, mesh);\r\n\u001b[?2004l\r"]
[47.296272, "o", "\u001b[?2004h> "]
[47.296388, "o", "    return `# Mesh: ${mesh.name}\\n` + result.obj;\r\n\u001b[?2004l\r"]
[47.296412, "o", "\u001b[?2004h> }\r\n"]
[47.29643, "o", "\u001b[?2004l\r\u001b[?2004h"]
[47.296491, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296585, "o", "// Function to collect all meshes from a group (including nested)\r\n\u001b[?2004l\r"]
[47.296607, "o", "\u001b[?2004h> "]
[47.296688, "o", "function collectMeshes(object, meshes = []) {\r\n\u001b[?2004l\r"]
[47.296708, "o", "\u001b[?2004h> "]
[47.29676, "o", "    if (object.isMesh) {\r\n\u001b[?2004l\r"]
[47.296803, "o", "\u001b[?2004h> "]
[47.296854, "o", "        meshes.push(object);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296878, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296974, "o", "    for (const child of object.children) {\r\n\u001b[?2004l\r"]
[47.297019, "o", "\u001b[?2004h> "]
[47.297084, "o", "        collectMeshes(child, meshes);\r\n\u001b[?2004l\r"]
[47.297132, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297183, "o", "    return meshes;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297203, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.297221, "o", "> "]
[47.297322, "o", "// Function to combine multiple meshes into one OBJ\r\n\u001b[?2004l\r"]
[47.297373, "o", "\u001b[?2004h> "]
[47.297421, "o", "function combineMeshesToOBJ(meshes) {\r\n\u001b[?2004l\r"]
[47.29747, "o", "\u001b[?2004h> "]
[47.297513, "o", "    let obj = '';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297566, "o", "    let vertexOffset = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297609, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297656, "o", "    for (const mesh of meshes) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297744, "o", "        let geometry = mesh.geometry;\r\n\u001b[?2004l\r"]
[47.297782, "o", "\u001b[?2004h> "]
[47.297869, "o", "        if (!geometry || !geometry.isBufferGeometry) continue;\r\n\u001b[?2004l\r"]
[47.29792, "o", "\u001b[?2004h> "]
[47.297958, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.29803, "o", "        if (!geometry.getAttribute('normal')) {\r\n\u001b[?2004l\r"]
[47.298094, "o", "\u001b[?2004h> "]
[47.29818, "o", "            geometry.computeVertexNormals();\r\n"]
[47.2982, "o", "\u001b[?2004l\r"]
[47.298219, "o", "\u001b[?2004h"]
[47.298242, "o", "> "]
[47.298349, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298382, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.298403, "o", "> "]
[47.298519, "o", "        obj += `# Mesh: ${mesh.name}\\n`;\r\n\u001b[?2004l\r"]
[47.298558, "o", "\u001b[?2004h> "]
[47.29874, "o", "        const result = geometryToOBJ(geometry, mesh, vertexOffset);\r\n\u001b[?2004l\r"]
[47.298796, "o", "\u001b[?2004h"]
[47.298823, "o", "> "]
[47.298886, "o", "        obj += result.obj;\r\n\u001b[?2004l\r"]
[47.298925, "o", "\u001b[?2004h> "]
[47.299058, "o", "        vertexOffset += result.vertexCount;\r\n\u001b[?2004l\r"]
[47.299099, "o", "\u001b[?2004h"]
[47.299117, "o", ">     }"]
[47.299184, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.299229, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.299268, "o", "    return obj;\r\n\u001b[?2004l\r"]
[47.299298, "o", "\u001b[?2004h"]
[47.299359, "o", "> }"]
[47.29938, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.29943, "o", "\u001b[?2004h> "]
[47.299483, "o", "// Main export function\r\n\u001b[?2004l\r"]
[47.299522, "o", "\u001b[?2004h> "]
[47.299622, "o", "async function exportScene() {\r\n\u001b[?2004l\r"]
[47.29966, "o", "\u001b[?2004h"]
[47.299681, "o", "> "]
[47.29977, "o", "    const root = createScene();\r\n\u001b[?2004l\r"]
[47.299808, "o", "\u001b[?2004h"]
[47.299828, "o", "> "]
[47.299878, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.300032, "o", "    const partMeshesDir = '/root/output/part_meshes';\r\n\u001b[?2004l\r"]
[47.300074, "o", "\u001b[?2004h"]
[47.300094, "o", "> "]
[47.300209, "o", "    const linksDir = '/root/output/links';\r\n\u001b[?2004l\r"]
[47.30025, "o", "\u001b[?2004h"]
[47.30029, "o", ">     \r\n\u001b[?2004l\r"]
[47.300309, "o", "\u001b[?2004h"]
[47.30033, "o", "> "]
[47.300514, "o", "    // Find all top-level parts (direct children of root that are Groups)\r\n\u001b[?2004l\r"]
[47.300561, "o", "\u001b[?2004h> "]
[47.300626, "o", "    const parts = [];\r\n"]
[47.300647, "o", "\u001b[?2004l\r"]
[47.300665, "o", "\u001b[?2004h> "]
[47.300733, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.300845, "o", "    for (const child of root.children) {\r\n\u001b[?2004l\r"]
[47.300874, "o", "\u001b[?2004h> "]
[47.300942, "o", "        if (child.isGroup) {\r\n\u001b[?2004l\r"]
[47.300983, "o", "\u001b[?2004h"]
[47.301013, "o", "> "]
[47.301095, "o", "            parts.push(child);\r\n\u001b[?2004l\r"]
[47.301124, "o", "\u001b[?2004h"]
[47.301144, "o", "> "]
[47.301203, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301233, "o", "    }\r\n\u001b[?2004l\r"]
[47.301278, "o", "\u001b[?2004h> "]
[47.301307, "o", "    \r\n\u001b[?2004l\r"]
[47.30136, "o", "\u001b[?2004h> "]
[47.301582, "o", "    console.log(`Found ${parts.length} top-level parts`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301648, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301706, "o", "    for (const part of parts) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.301745, "o", "> "]
[47.30182, "o", "        const partName = part.name || 'unnamed_part';\r\n\u001b[?2004l\r"]
[47.301857, "o", "\u001b[?2004h> "]
[47.301955, "o", "        const partDir = path.join(partMeshesDir, partName);\r\n\u001b[?2004l\r"]
[47.302004, "o", "\u001b[?2004h> "]
[47.302056, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302115, "o", "        // Create part directory\r\n\u001b[?2004l\r"]
[47.302137, "o", "\u001b[?2004h"]
[47.302157, "o", "> "]
[47.302292, "o", "        fs.mkdirSync(partDir, { recursive: true });\r\n\u001b[?2004l\r"]
[47.302334, "o", "\u001b[?2004h> "]
[47.302384, "o", "        \r\n"]
[47.302424, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[47.302547, "o", "        // Collect all meshes in this part (direct and nested)\r\n\u001b[?2004l\r"]
[47.302568, "o", "\u001b[?2004h"]
[47.302587, "o", "> "]
[47.302661, "o", "        const allMeshes = [];\r\n\u001b[?2004l\r"]
[47.302698, "o", "\u001b[?2004h> "]
[47.302743, "o", "        \r\n\u001b[?2004l\r"]
[47.3028, "o", "\u001b[?2004h> "]
[47.302942, "o", "        // Process direct mesh children and nested groups\r\n\u001b[?2004l\r"]
[47.302964, "o", "\u001b[?2004h> "]
[47.303089, "o", "        function processPart(obj, currentPartDir) {\r\n\u001b[?2004l\r"]
[47.303129, "o", "\u001b[?2004h> "]
[47.303254, "o", "            for (const child of obj.children) {\r\n\u001b[?2004l\r"]
[47.303276, "o", "\u001b[?2004h> "]
[47.303364, "o", "                if (child.isMesh) {\r\n\u001b[?2004l\r"]
[47.303404, "o", "\u001b[?2004h> "]
[47.303527, "o", "                    // Export individual mesh\r\n\u001b[?2004l\r"]
[47.303548, "o", "\u001b[?2004h> "]
[47.303724, "o", "                    const meshName = child.name || `mesh_${allMeshes.length}`;\r\n\u001b[?2004l\r"]
[47.303745, "o", "\u001b[?2004h> "]
[47.303891, "o", "                    const objContent = exportMeshToOBJ(child);\r\n\u001b[?2004l\r"]
[47.303931, "o", "\u001b[?2004h> "]
[47.304025, "o", "                    if (objContent) {\r\n\u001b[?2004l\r"]
[47.304065, "o", "\u001b[?2004h> "]
[47.304251, "o", "                        const filePath = path.join(currentPartDir, `${meshName}.obj`);\r\n\u001b[?2004l\r"]
[47.304272, "o", "\u001b[?2004h> "]
[47.30442, "o", "                        fs.writeFileSync(filePath, objContent);\r\n\u001b[?2004l\r"]
[47.304444, "o", "\u001b[?2004h> "]
[47.304589, "o", "                        console.log(`Exported: ${filePath}`);\r\n\u001b[?2004l\r"]
[47.304613, "o", "\u001b[?2004h> "]
[47.304727, "o", "                        allMeshes.push(child);\r\n\u001b[?2004l\r"]
[47.304767, "o", "\u001b[?2004h> "]
[47.304835, "o", "                    }\r\n\u001b[?2004l\r"]
[47.304855, "o", "\u001b[?2004h> "]
[47.304962, "o", "                } else if (child.isGroup) {\r\n\u001b[?2004l\r"]
[47.304983, "o", "\u001b[?2004h"]
[47.305002, "o", "> "]
[47.305169, "o", "                    // For nested groups (like cabins), create subdirectory\r\n\u001b[?2004l\r"]
[47.305188, "o", "\u001b[?2004h> "]
[47.305343, "o", "                    const subGroupName = child.name || 'subgroup';\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.305365, "o", "> "]
[47.305507, "o", "                    const subDir = path.join(currentPartDir, subGroupName);\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.305527, "o", "> "]
[47.30566, "o", "                    fs.mkdirSync(subDir, { recursive: true });\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.30568, "o", "> "]
[47.305777, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.305862, "o", "                    // Export meshes in this subgroup\r\n\u001b[?2004l\r"]
[47.305883, "o", "\u001b[?2004h> "]
[47.306044, "o", "                    const subMeshes = collectMeshes(child);\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.306064, "o", "> "]
[47.306169, "o", "                    for (const subMesh of subMeshes) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.306188, "o", "> "]
[47.306378, "o", "                        const meshName = subMesh.name || `mesh_${allMeshes.length}`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.306398, "o", "> "]
[47.306523, "o", "                        const objContent = exportMeshToOBJ(subMesh);\r\n\u001b[?2004l\r"]
[47.306543, "o", "\u001b[?2004h> "]
[47.306628, "o", "                        if (objContent) {\r\n\u001b[?2004l\r"]
[47.306649, "o", "\u001b[?2004h> "]
[47.306883, "o", "                            const filePath = path.join(subDir, `${meshName}.obj`);\r\n\u001b[?2004l\r"]
[47.306906, "o", "\u001b[?2004h> "]
[47.307025, "o", "                            fs.writeFileSync(filePath, objContent);\r\n\u001b[?2004l\r"]
[47.307045, "o", "\u001b[?2004h> "]
[47.307216, "o", "                            console.log(`Exported: ${filePath}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.307236, "o", "> "]
[47.307338, "o", "                            allMeshes.push(subMesh);\r\n\u001b[?2004l\r"]
[47.307359, "o", "\u001b[?2004h> "]
[47.307419, "o", "                        }\r\n\u001b[?2004l\r"]
[47.307439, "o", "\u001b[?2004h> "]
[47.307506, "o", "                    }\r\n\u001b[?2004l\r"]
[47.307525, "o", "\u001b[?2004h> "]
[47.30758, "o", "                }\r\n\u001b[?2004l\r"]
[47.307596, "o", "\u001b[?2004h"]
[47.307614, "o", "> "]
[47.307723, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.307792, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[47.307846, "o", "\u001b[?2004h> "]
[47.307932, "o", "        processPart(part, partDir);\r\n\u001b[?2004l\r"]
[47.308007, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[47.308062, "o", "\u001b[?2004h> "]
[47.308166, "o", "        // Create combined link file for this part\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.308242, "o", "        if (allMeshes.length > 0) {\r\n\u001b[?2004l\r"]
[47.308262, "o", "\u001b[?2004h"]
[47.308278, "o", "> "]
[47.308431, "o", "            const linkContent = combineMeshesToOBJ(allMeshes);\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.308451, "o", "> "]
[47.308599, "o", "            const linkPath = path.join(linksDir, `${partName}.obj`);\r\n\u001b[?2004l\r"]
[47.308619, "o", "\u001b[?2004h> "]
[47.308762, "o", "            fs.writeFileSync(linkPath, linkContent);\r\n\u001b[?2004l\r"]
[47.308783, "o", "\u001b[?2004h> "]
[47.308889, "o", "            console.log(`Created link: ${linkPath}`);\r\n\u001b[?2004l\r"]
[47.30891, "o", "\u001b[?2004h> "]
[47.309029, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[47.309113, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.309164, "o", "    console.log('Export complete!');\r\n\u001b[?2004l\r"]
[47.309186, "o", "\u001b[?2004h> "]
[47.309203, "o", "}\r\n\u001b[?2004l\r"]
[47.309222, "o", "\u001b[?2004h"]
[47.309242, "o", "> \r\n\u001b[?2004l\r"]
[47.30932, "o", "\u001b[?2004h> exportScene();\r\n\u001b[?2004l\r"]
[47.309344, "o", "\u001b[?2004h"]
[47.309365, "o", "> "]
[47.309384, "o", "EOF"]
[47.309404, "o", "\r\n\u001b[?2004l\r"]
