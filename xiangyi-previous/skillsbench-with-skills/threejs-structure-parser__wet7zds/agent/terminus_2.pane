[?2004l[?2004h>                         if (objContent) {
[?2004l[?2004h>                             const filePath = path.join(subDir, `${meshName}.obj`);
[?2004l[?2004h>                             fs.writeFileSync(filePath, objContent);
[?2004l[?2004h>                             console.log(`Exported: ${filePath}`);
[?2004l[?2004h>                             allMeshes.push(subMesh);
[?2004l[?2004h>                         }
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         processPart(part, partDir);
[?2004l[?2004h>         
