[?2004l[?2004h>                         fs.writeFileSync(filePath, objContent);
[?2004l[?2004h>                         console.log(`Exported: ${filePath}`);
[?2004l[?2004h>                         allMeshes.push(child);
[?2004l[?2004h>                     }
[?2004l[?2004h>                 } else if (child.isGroup) {
[?2004l[?2004h>                     // For nested groups (like cabins), create subdirectory
[?2004l[?2004h>                     const subGroupName = child.name || 'subgroup';
[?2004l[?2004h>                     const subDir = path.join(currentPartDir, subGroupName);
[?2004l[?2004h>                     fs.mkdirSync(subDir, { recursive: true });
[?2004l[?2004h>                     
[?2004l[?2004h>                     // Export meshes in this subgroup
