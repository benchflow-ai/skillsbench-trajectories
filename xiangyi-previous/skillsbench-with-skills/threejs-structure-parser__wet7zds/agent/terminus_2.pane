[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     console.log(`Found ${parts.length} top-level parts`);
[?2004l[?2004h>     
[?2004l[?2004h>     for (const part of parts) {
[?2004l[?2004h>         const partName = part.name || 'unnamed_part';
[?2004l[?2004h>         const partDir = path.join(partMeshesDir, partName);
[?2004l[?2004h>         
[?2004l[?2004h>         // Create part directory
[?2004l[?2004h>         fs.mkdirSync(partDir, { recursive: true });
[?2004l[?2004h>         
[?2004l[?2004h>         // Collect all meshes in this part (direct and nested)
[?2004l[?2004h>         const allMeshes = [];
[?2004l[?2004h>         
[?2004l[?2004h>         // Process direct mesh children and nested groups
[?2004l[?2004h>         function processPart(obj, currentPartDir) {
[?2004l[?2004h>             for (const child of obj.children) {
[?2004l[?2004h>                 if (child.isMesh) {
[?2004l[?2004h>                     // Export individual mesh
