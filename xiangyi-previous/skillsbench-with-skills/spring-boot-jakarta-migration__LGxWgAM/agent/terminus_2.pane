[?2004l[?2004h>     public boolean requestDataDeletion(String userId) {
[?2004l[?2004h>         try {
[?2004l[?2004h>             restClient.delete()
[?2004l[?2004h>                 .uri("/users/{userId}/data", userId)
[?2004l[?2004h>                 .retrieve()
[?2004l[?2004h>                 .toBodilessEntity();
[?2004l[?2004h>             return true;
[?2004l[?2004h>         } catch (Exception e) {
[?2004l[?2004h>             return false;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> }
