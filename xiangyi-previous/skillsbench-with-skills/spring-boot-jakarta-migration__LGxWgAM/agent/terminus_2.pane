    25	    public UserDetails loadUserByUsername(String username) throws UsernameNotFoundException {
    26	        User user = userRepository.findByUsername(username)
    27	                .orElseThrow(() -> new UsernameNotFoundException("User not found: " + username));
    28	
    29	        return new org.springframework.security.core.userdetails.User(
    30	                user.getUsername(),
    31	                user.getPassword(),
    32	                user.isActive(),
    33	                true,
    34	                true,
    35	                true,
    36	                Collections.singletonList(new SimpleGrantedAuthority("ROLE_" + user.getRole().name()))
    37	        );
    38	    }
    39	}
