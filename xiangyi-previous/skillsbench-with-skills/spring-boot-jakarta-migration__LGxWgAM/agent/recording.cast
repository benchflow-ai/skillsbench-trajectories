[139.078012, "o", "# Test Configuration\r\nspring.application.name=userservice-test\r\n\r\n# H2 In-Memory Database for tests\r\nspring.datasource.url=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE\r\nspring.datasource.driverClassName=org.h2.Driver\r\nspring.datasource.username=sa\r\nspring.datasource.password=\r\n\r\n# JPA Configuration for tests\r\nspring.jpa.database-platform=org.hibernate.dialect.H2Dialect"]
[139.078114, "o", "\r\nspring.jpa.hibernate.ddl-auto=create-drop\r\nspring.jpa.show-sql=false\r\n\r\n# Disable H2 console in tests\r\nspring.h2.console.enabled=false\r\n\r\n# External API mock URL\r\nexternal.api.base-url=http://localhost:8089\r\n\r\n# Reduce logging noise in tests\r\nlogging.level.com.example.userservice=WARN\r\nlogging.level.org.springframework.security=WARN\r\n"]
