[339.790038, "i", "ctId>jjwt-impl</artifactId>\\n            <version>0.11.5</version>\\n            <scope>runtime</scope>\\n        </dependency>\\n        <dependency>\\n            <groupId>io.jsonwebtoken</groupId>\\n            <artifactId>jjwt-jackson</artifactId>\\n            <version>0.11.5</version>\\n            <scope>runtime</scope>\\n        </dependency>\\n\"\"\"\nif old not in text:\n    raise SystemExit('Old JWT block not found')\ntext = text.replace(old, new)\npath.write_text(text)\nPY\n"]
