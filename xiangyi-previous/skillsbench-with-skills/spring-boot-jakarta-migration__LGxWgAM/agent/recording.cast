[76.437166, "o", "\t        user.setRole(request.getRole() != null ? request.getRole() : Role.USER);\r\n    64\t\r\n    65\t        User savedUser = userRepository.save(user);\r\n    66\t        return new UserDTO(savedUser);\r\n    67\t    }\r\n    68\t\r\n    69\t    public UserDTO updateUser(Long id, CreateUserRequest request) {\r\n    70\t        User user = userRepository.findById(id)\r\n    71\t                .orElseThrow(() -> new EntityNotFoundException(\"User not found with id: \" + id));\r\n    72\t\r\n    73\t        if (!user.getUsername().equals(request.getUsername()) &&\r\n    74\t                userRepository.existsByUsername(request.getUsername())) {\r\n    75\t            throw new IllegalArgumentException(\"Username already exists\");\r\n    76\t        }\r\n    77\t        if (!user.getEmail().equals(request.getEmail()) &&\r\n    78\t                userRepository.existsByEmail(request.getEmail())) {\r\n"]
