[121.457429, "o", "# Application Configuration\r\nspring.application.name=userservice\r\nserver.port=8080\r\n\r\n# Database Configuration (H2 In-Memory)\r\nspring.datasource.url=jdbc:h2:mem:userdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE\r\nspring.datasource.driverClassName=org.h2.Driver\r\nspring.datasource.username=sa\r\nspring.datasource.password=\r\n\r\n# JPA/Hibernate Configuration\r\nspring.jpa.database-platform=org.hibernate.dialect.H2Dialect\r\nspring.jpa.hibernate.ddl-auto=create-drop\r\nspring.jpa.show-sql=true\r\nspring.jpa.properties.hibernate.format_sql=true\r\n\r\n# H2 Console (for development)\r\nspring.h2.console.enabled=true\r\nspring.h2.console.path=/h2-console\r\n\r\n# External API Configuration\r\nexternal.api.base-url=https://api.example.com\r\n\r\n# Logging\r\nlogging.level.com.example.userservice=DEBUG\r\nlogging.level.org.springframework.security=DEBUG\r\n"]
