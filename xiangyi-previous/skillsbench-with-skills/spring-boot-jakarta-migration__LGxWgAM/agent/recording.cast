[76.437268, "o", "\t        if (!userRepository.existsById(id)) {\r\n    99\t            throw new EntityNotFoundException(\"User not found with id: \" + id);\r\n   100\t        }\r\n   101\t        userRepository.deleteById(id);\r\n   102\t    }\r\n   103\t\r\n   104\t    public UserDTO deactivateUser(Long id) {\r\n   105\t        User user = userRepository.findById(id)\r\n   106\t                .orElseThrow(() -> new EntityNotFoundException(\"User not found with id: \" + id));\r\n   107\t        user.setActive(false);"]
