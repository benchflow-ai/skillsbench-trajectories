[?2004l[?2004h> # Fuzzy search function
[?2004l[?2004h> def fuzzy_search(query, candidates, threshold=0.5):
[?2004l[?2004h>     matches = []
[?2004l[?2004h>     for candidate in candidates:
[?2004l[?2004h>         if pd.isna(candidate):
[?2004l[?2004h>             continue
[?2004l[?2004h>         ratio = difflib.SequenceMatcher(None, query.lower(), str(candidate).lower()).ratio()
[?2004l[?2004h>         if ratio >= threshold:
[?2004l[?2004h>             matches.append((candidate, ratio))
[?2004l[?2004h>     return sorted(matches, key=lambda x: x[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Question 4: Top 3 fund managers invested in Palantir
