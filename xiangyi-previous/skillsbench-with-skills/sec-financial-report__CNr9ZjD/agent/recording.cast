[82.871564, "i", "python3 << 'EOF'\nimport pandas as pd\nimport difflib\nimport json\n\n# Load Q3 data\nprint(\"Loading data...\")\nq3_coverpage = pd.read_csv('/root/2025-q3/COVERPAGE.tsv', sep='\\t', low_memory=False)\nq3_summarypage = pd.read_csv('/root/2025-q3/SUMMARYPAGE.tsv', sep='\\t', low_memory=False)\nq3_infotable = pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', low_memory=False)\n\n# Load Q2 data\nq2_coverpage = pd.read_csv('/root/2025-q2/COVERPAGE.tsv', sep='\\t', low_memory=False)\nq2_summarypage = pd.read_csv('/root/2025-q2/SUMMARYPAGE.tsv', sep='\\t', low_memory=False)\nq2_infotable = pd.read_csv('/root/2025-q2/INFOTABLE.tsv', sep='\\t', low_memory=False)\n\nprint(\"Data loaded\")\n\n# Fuzzy search function\ndef fuzzy_search(query, candidates, threshold=0.5):\n    matches = []\n    for candidate in candidates:\n        if pd.isna(candidate):\n            continue\n        ratio = difflib.SequenceMatcher(None, query.lower(), str(candidate).lower()).ratio()\n        if ratio >= threshold:\n            matches.append((candidate, ratio))\n    return sorted(matches, key=lambda x: x[1], reverse=True)\n\n# Question 2: Count stocks held by Renaissance\nprint(\"\\n=== Question 2: Renaissance Technologies Holdings Count ===\")\nrenaissance_accession = '0001037389-25-000064'\nrenaissance_holdings = q3_infotable[q3_infotable['ACCESSION_NUMBER'] == renaissance_accession]\nq2_answer = len(renaissance_holdings)\nprint(f\"Number of stocks held by Renaissance: {q2_answer}\")\n\n# Question 3: Berkshire Hathaway top 5 increased stocks\nprint(\"\\n=== Question 3: Berkshire Hathaway Top 5 Increased Stocks ===\")\nfund_names = q3_coverpage['FILINGMANAGER_NAME'].dropna().unique().tolist()\nmatches_bh = fuzzy_search('berkshire hathaway', fund_names, threshold=0.5)\nprint(f\"Berkshire matches: {matches_bh[:3]}\")\n\nif matches_bh:\n    bh_name = matches_bh[0][0]\n    print(f\"Berkshire name: {bh_name}\")\n    \n    # Find Q3 accession\n    bh_q3 = q3_coverpage[q3_coverpage['FILINGMANAGER_NAME'] == bh_name]\n    if not bh_q3.empty:\n        bh_q3_accession = bh_q3.iloc[0]['ACCESSION_NUMBER']\n        print(f\"Q3 Accession: {bh_q3_accession}\")\n    else:\n        print(\"Berkshire not found in Q3\")\n        bh_q3_accession = None\n    \n    # Find Q2 accession\n    bh_q2 = q2_coverpage[q2_coverpage['FILINGMANAGER_NAME'] == bh_name]\n    if not bh_q2.empty:\n        bh_q2_accession = bh_q2.iloc[0]['ACCESSION_NUMBER']\n        print(f\"Q2 Accession: {bh_q2_accession}\")\n    else:\n        print(\"Berkshire not found in Q2\")\n        bh_q2_accession = None\n    \n    if bh_q3_accession and bh_q2_accession:\n        # Get holdings for both quarters\n        q2_holdings = q2_infotable[q2_infotable['ACCESSION_NUMBER'] == bh_q2_accession][['CUSIP', 'VALUE']].copy()\n        q3_holdings = q3_infotable[q3_infotable['ACCESSION_NUMBER'] == bh_q3_accession][['CUSIP', 'VALUE']].copy()\n        \n        # Merge and calculate differences\n        merged = pd.merge(q2_holdings, q3_holdings, on='CUSIP', how='outer', suffixes=('_q2', '_q3'))\n        merged['VALUE_q2'] = merged['VALUE_q2'].fillna(0)\n        merged['VALUE_q3'] = merged['VALUE_q3'].fillna(0)\n        merged['VALUE_CHANGE'] = merged['VALUE_q3'] - merged['VALUE_q2']\n        \n        # Filter for increases and sort\n        increased = merged[merged['VALUE_CHANGE'] > 0].sort_values('VALUE_CHANGE', ascending=False)\n        top_5_cusips = increased.head(5)['CUSIP'].tolist()\n        print(f\"Top 5 increased stocks: {top_5_cusips}\")\n        q3_answer = top_5_cusips\n    else:\n        print(\"Could not find both Q2 and Q3 accessions\")\n        q3_answer = []\nelse:\n    print(\"Berkshire not found\")\n    q3_answer = []\n\nprint(f\"Q2 Answer: {q2_answer}\")\nprint(f\"Q3 Answer: {q3_answer}\")\n\nEOF\n"]
