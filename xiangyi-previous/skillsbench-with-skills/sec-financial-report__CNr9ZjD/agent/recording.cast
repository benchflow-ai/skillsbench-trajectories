[19.935567, "i", "python3 << 'EOF'\nimport pandas as pd\nfrom fuzzywuzzy import fuzz\nfrom fuzzywuzzy import process\nimport json\n\n# Load Q3 data\nq3_coverpage = pd.read_csv('/root/2025-q3/COVERPAGE.tsv', sep='\\t')\nq3_summarypage = pd.read_csv('/root/2025-q3/SUMMARYPAGE.tsv', sep='\\t')\nq3_infotable = pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t')\n\n# Load Q2 data\nq2_coverpage = pd.read_csv('/root/2025-q2/COVERPAGE.tsv', sep='\\t')\nq2_summarypage = pd.read_csv('/root/2025-q2/SUMMARYPAGE.tsv', sep='\\t')\nq2_infotable = pd.read_csv('/root/2025-q2/INFOTABLE.tsv', sep='\\t')\n\nprint(\"Data loaded successfully\")\nprint(f\"Q3 COVERPAGE shape: {q3_coverpage.shape}\")\nprint(f\"Q3 SUMMARYPAGE shape: {q3_summarypage.shape}\")\nprint(f\"Q3 INFOTABLE shape: {q3_infotable.shape}\")\n\nEOF\n"]
