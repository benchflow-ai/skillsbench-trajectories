[82.875931, "o", "    bh_q3 = q3_coverpage[q3_coverpage['FILINGMANAGER_NAME'] == bh_name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.875959, "o", "> "]
[82.876013, "o", "    if not bh_q3.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876089, "o", "        bh_q3_accession = bh_q3.iloc[0]['ACCESSION_NUMBER']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876201, "o", "        print(f\"Q3 Accession: {bh_q3_accession}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.876253, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.876286, "o", "> "]
[82.87635, "o", "        print(\"Berkshire not found in Q3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876418, "o", "        bh_q3_accession = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[82.876451, "o", "\u001b[?2004h> "]
[82.876515, "o", "    # Find Q2 accession\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876611, "o", "    bh_q2 = q2_coverpage[q2_coverpage['FILINGMANAGER_NAME'] == bh_name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876664, "o", "    if not bh_q2.empty:\r\n\u001b[?2004l\r"]
[82.876692, "o", "\u001b[?2004h> "]
[82.876793, "o", "        bh_q2_accession = bh_q2.iloc[0]['ACCESSION_NUMBER']\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.876814, "o", "> "]
[82.876901, "o", "        print(f\"Q2 Accession: {bh_q2_accession}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.876956, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.876986, "o", "> "]
[82.877065, "o", "        print(\"Berkshire not found in Q2\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.877095, "o", "        bh_q2_accession = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[82.877174, "o", "\u001b[?2004h> "]
[82.877223, "o", "    if bh_q3_accession and bh_q2_accession:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.877291, "o", "        # Get holdings for both quarters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.877473, "o", "        q2_holdings = q2_infotable[q2_infotable['ACCESSION_NUMBER'] == bh_q2_accession][['CUSIP', 'VALUE']].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.87764, "o", "        q3_holdings = q3_infotable[q3_infotable['ACCESSION_NUMBER'] == bh_q3_accession][['CUSIP', 'VALUE']].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.877695, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[82.877727, "o", "> "]
[82.877793, "o", "        # Merge and calculate differences\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.877959, "o", "        merged = pd.merge(q2_holdings, q3_holdings, on='CUSIP', how='outer', suffixes=('_q2', '_q3'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878096, "o", "        merged['VALUE_q2'] = merged['VALUE_q2'].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878189, "o", "        merged['VALUE_q3'] = merged['VALUE_q3'].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878308, "o", "        merged['VALUE_CHANGE'] = merged['VALUE_q3'] - merged['VALUE_q2']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878377, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878445, "o", "        # Filter for increases and sort\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878582, "o", "        increased = merged[merged['VALUE_CHANGE'] > 0].sort_values('VALUE_CHANGE', ascending=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878708, "o", "        top_5_cusips = increased.head(5)['CUSIP'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878796, "o", "        print(f\"Top 5 increased stocks: {top_5_cusips}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.878862, "o", "> "]
[82.878898, "o", "        q3_answer = top_5_cusips\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.878961, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.879055, "o", "        print(\"Could not find both Q2 and Q3 accessions\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.879121, "o", "        q3_answer = []\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.879183, "o", ">     print(\"Berkshire not found\")\r\n\u001b[?2004l\r\u001b[?2004h"]
