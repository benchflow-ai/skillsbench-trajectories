python3 << 'PYSCRIPT'
import pandas as pd
import numpy as np
from sklearn.cluster import DBSCAN
from itertools import product
import warnings
warnings.filterwarnings('ignore')

print("Loading data...")
citsci_df = pd.read_csv('/root/data/citsci_train.csv')[['file_rad', 'x', 'y']].dropna()
expert_df = pd.read_csv('/root/data/expert_train.csv')[['file_rad', 'x', 'y']].dropna()

citsci_by_img = {img: group[['x', 'y']].values for img, group in citsci_df.groupby('file_rad')}
expert_by_img = {img: group[['x', 'y']].values for img, group in expert_df.groupby('file_rad')}
expert_imgs = list(expert_by_img.keys())

print(f"Expert images: {len(expert_imgs)}, CitSci images: {len(citsci_by_img)}")

def custom_dist(a, b, w):
    return np.sqrt((w * (a[0] - b[0]))**2 + ((2 - w) * (a[1] - b[1]))**2)

def eucl_dist(a, b):
    return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)

def dist_matrix(pts, w):
    n = len(pts)
    dm = np.zeros((n, n))
    for i in range(n):
        for j in range(i+1, n):
            d = custom_dist(pts[i], pts[j], w)
            dm[i, j] = dm[j, i] = d
    return dm

def greedy_match(cents, experts):
    if len(cents) == 0 or len(experts) == 0:
        return [], []
    cents = np.array(cents)
    experts = np.array(experts)
    pairs = [(eucl_dist(cents[i], experts[j]), i, j) for i in range(len(cents)) for j in range(len(experts)) if eucl_dist(cents[i], experts[j]) <= 100]
    pairs.sort()
    used_c, used_e = set(), set()
    matched = []
    for d, i, j in pairs:
        if i not in used_c and j not in used_e:
            matched.append((cents[i], experts[j]))
            used_c.add(i)
            used_e.add(j)
    return matched

def eval_img(img_id, ms, eps, w):
    cpts = citsci_by_img.get(img_id, np.array([]))
    epts = expert_by_img[img_id]
    if len(cpts) == 0:
        return 0.0, np.nan
    try:
        db = DBSCAN(eps=eps, min_samples=ms, metric='precomputed')
        labels = db.fit_predict(dist_matrix(cpts, w))
    except:
        return 0.0, np.nan
    ulabels = set(labels) - {-1}
    if len(ulabels) == 0:
        return 0.0, np.nan
    cents = [cpts[labels == l].mean(axis=0) for l in ulabels]
    matched = greedy_match(cents, epts)
    if len(matched) == 0:
        return 0.0, np.nan
    tp = len(matched)
    fp = len(cents) - tp
    fn = len(epts) - tp
    f1 = 2 * tp / (2 * tp + fp + fn) if (2 * tp + fp + fn) > 0 else 0.0
    delta = np.mean([eucl_dist(c, e) for c, e in matched])
    return f1, delta

results = []
params = list(product(range(3, 10), range(4, 26, 2), np.round(np.arange(0.9, 2.0, 0.1), 1)))
print(f"Total params: {len(params)}")

for i, (ms, eps, w) in enumerate(params):
    if i % 50 == 0:
        print(f"Progress: {i}/{len(params)}")
    f1s, deltas = [], []
    for img in expert_imgs:
        f1, delta = eval_img(img, ms, eps, w)
        f1s.append(f1)
        if not np.isnan(delta):
            deltas.append(delta)
    avg_f1 = np.mean(f1s)
    avg_delta = np.mean(deltas) if deltas else np.nan
    if avg_f1 > 0.5:
        results.append({'f1': avg_f1, 'delta': avg_delta, 'min_samples': ms, 'epsilon': eps, 'shape_weight': w})

print(f"\nResults with F1 > 0.5: {len(results)}")

if results:
    df = pd.DataFrame(results)
    pareto = []
    for _, r in df.iterrows():
        dominated = False
        for _, r2 in df.iterrows():
            if (r2['f1'] > r['f1'] and r2['delta'] <= r['delta']) or (r2['f1'] >= r['f1'] and r2['delta'] < r['delta']):
                dominated = True
                break
        if not dominated:
            pareto.append(r)
    
    out = pd.DataFrame(pareto)
    out['f1'] = out['f1'].round(5)
    out['delta'] = out['delta'].round(5)
    out['shape_weight'] = out['shape_weight'].round(1)
    out = out[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']]
    out.to_csv('/root/pareto_frontier.csv', index=False)
    pr
