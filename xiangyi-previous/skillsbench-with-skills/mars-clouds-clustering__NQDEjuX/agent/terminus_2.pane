[?2004hroot@03401fc387bb:~# cat > /root/optimize_dbscan.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.cluster import DBSCAN
[?2004l[?2004h> from sklearn.metrics import f1_score
[?2004l[?2004h> from itertools import product
[?2004l[?2004h> from multiprocessing import Pool
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004lr[?2004h> def custom_distance(a, b, w):
[?2004l[?2004h>     """Custom distance metric: sqrt((w*dx)^2 + ((2-w)*dy)^2)"""
[?2004l[?2004h>     dx = a[0] - b[0]
[?2004l[?2004h>     dy = a[1] - b[1]
[?2004l[?2004h>     return np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)
[?2004l[?2004h> 
[?2004l [?2004h> def euclidean_distance(a, b):
[?2004l[?2004h>     """Standard Euclidean distance"""
[?2004l[?2004h>     return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)
[?2004l[?2004h> 
[?2004l[?2004h> def greedy_matching(centroids, experts, max_distance=100):
[?2004l[?2004h>     """Greedy matching of centroids to expert points using standard Euclidean distance."""
[?2004l[?2004h>     if len(centroids) == 0 or len(experts) == 0:
[?2004l[?2004h>         return [], []
[?2004l[?2004h>     
[?2004l[?2004h>     centroids = np.array(centroids)
[?2004l[?2004h>     experts = np.array(experts)
[?2004l[?2004h>     
[?2004ls")

# Extract relevant columns
citsci_df = citsci_df[['file_rad', 'x', 'y']].dropna()
expert_df = expert_df[['file_rad', 'x', 'y']].dropna()

print(f"After removing NaN: citsci {len(citsci_df)}, expert {len([?2004h>     matched_centroids = []
[?2004l[?2004h>     matched_experts = []
[?2004l[?2004h>     used_experts = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by distance
[?2004l[?2004h>     distances = []
[?2004l[?2004h>     for i, centroid in enumerate(centroids):
[?2004l[?2004h>         for j, expert in enumerate(experts):
[?2004l[?2004h>             dist = euclidean_distance(centroid, expert)
[?2004l[?2004h>             if dist <= max_distance:
[?2004l[?2004h>                 distances.append((dist, i, j))
[?2004l[?2004h>     
[?2004l[?2004h>     distances.sort()
[?2004l[?2004h>     
[?2004ld[?2004h>     used_centroids = set()
[?2004l[?2004h>     for dist, i, j in distances:
[?2004l[?2004h>         if i not in used_centroids and j not in used_experts:
[?2004l[?2004h>             matched_centroids.append(centroids[i])
[?2004l[?2004h>             matched_experts.append(experts[j])
[?2004l[?2004h>             used_centroids.add(i)
[?2004l[?2004h>             used_experts.add(j)
[?2004l[?2004h>     
[?2004l,[?2004h>     return matched_centroids, matched_experts
[?2004l[?2004h> 
[?2004lt[?2004h> def evaluate_image(image_id, citsci_points, expert_points, min_samples, epsilon, shape_weight):
[?2004l[?2004h>     """Evaluate a single image with given hyperparameters."""
[?2004l[?2004h>     if len(citsci_points) == 0:
[?2004l[?2004h>         # No citizen science points for this image
[?2004l[?2004h>         return 0.0, np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     # Define distance function for this weight
[?2004l[?2004h>     def dist_func(a, b):
[?2004l[?2004h>         return custom_distance(a, b, shape_weight)
[?2004l[?2004h>     
[?2004l[?2004h>     # Run DBSCAN
[?2004l[?2004h>     try:
[?2004l[?2004h>         db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=dist_func)
[?2004l[?2004h>         labels = db.fit_predict(citsci_points)
[?2004ln[?2004h>     except:
[?2004l[?2004h>         return 0.0, np.nan
[?2004l[?2004h>     
[?2004l([?2004h>     # Get cluster centroids (excluding noise points with label -1)
[?2004l[?2004h>     unique_labels = set(labels)
[?2004l[?2004h>     if -1 in unique_labels:
[?2004l[?2004h>         unique_labels.remove(-1)
[?2004l[?2004h>     
[?2004l[?2004h>     if len(unique_labels) == 0:
[?2004l[?2004h>         # No clusters found
[?2004l[?2004h>         return 0.0, np.nan
[?2004ln[?2004h>     
[?2004lr[?2004h>     centroids = []
[?2004l[?2004h>     for label in unique_labels:
[?2004l[?2004h>         cluster_points = citsci_points[labels == label]
[?2004l[?2004h>         centroid = cluster_points.mean(axis=0)
[?2004l[?2004h>         centroids.append(centroid)
[?2004l[?2004h>     
[?2004l[?2004h>     # Match centroids to expert points
[?2004li[?2004h>     matched_centroids, matched_experts = greedy_matching(centroids, expert_points)
[?2004l[?2004h>     
[?2004l[?2004h>     if len(matched_centroids) == 0:
[?2004l[?2004h>         # No matches found
[?2004lif ro[?2004h>         return 0.0, np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute F1 score
[?2004l[?2004h>     # True positives: matched clusters
[?2004l[?2004h>     tp = len(matched_centroids)
[?2004l[?2004h>     # False positives: unmatched clusters
[?2004lta[?2004h>     fp = len(centroids) - tp
[?2004l[?2004h>     # False negatives: unmatched expert points
[?2004lk[?2004h>     fn = len(expert_points) - tp
[?2004l [?2004h>     
[?2004l[?2004h>     if tp + fp == 0 or tp + fn == 0:
[?2004l[?2004h>         f1 = 0.0
[?2004l[?2004h>     else:
[?2004l([?2004h>         precision = tp / (tp + fp) if (tp + fp) > 0 else 0
[?2004l[?2004h>         recall = tp / (tp + fn) if (tp + fn) > 0 else 0
[?2004l[?2004h>         if precision + recall == 0:
[?2004l[?2004h>             f1 = 0.0
[?2004li[?2004h>         else:
[?2004lw[?2004h>             f1 = 2 * precision * recall / (precision + recall)
[?2004l[?2004h>     
[?2004l  o[?2004h>     # Compute average delta (standard Euclidean distance)
[?2004l[?2004h>     deltas = [euclidean_distance(c, e) for c, e in zip(matched_centroids, matched_experts)]
[?2004l[?2004h>     delta = np.mean(deltas) if deltas else np.nan
[?2004l[?2004h>     
[?2004ln[?2004h>     return f1, delta
[?2004lil[?2004h> 
[?2004l[?2004h> def evaluate_hyperparams(params):
[?2004ly[?2004h>     """Evaluate a single hyperparameter combination."""
[?2004l[?2004h>     min_samples, epsilon, shape_weight = params
[?2004lro[?2004h>     
[?2004lier[?2004h>     f1_scores = []
[?2004lpu[?2004h>     deltas = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Loop over all unique images from expert dataset
[?2004l[?2004h>     for image_id in expert_images:
[?2004l[?2004h>         citsci_pts = citsci_by_image.get(image_id, np.array([]))
[?2004l[?2004h>         expert_pts = expert_by_image[image_id]
[?2004l[?2004h>         
[?2004l[?2004h>         f1, delta = evaluate_image(image_id, citsci_pts, expert_pts, min_samples, epsilon, shape_weight)
[?2004l[?2004h>         f1_scores.append(f1)
[?2004l[?2004h>         if not np.isnan(delta):
[?2004l[?2004h>             deltas.append(delta)
[?2004l[?2004h>     
[?2004l[?2004h>     avg_f1 = np.mean(f1_scores)
[?2004l[?2004h>     avg_delta = np.mean(deltas) if deltas else np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'min_samples': min_samples,
[?2004l[?2004h>         'epsilon': epsilon,
[?2004l[?2004h>         'shape_weight': shape_weight,
[?2004l[?2004h>         'f1': avg_f1,
[?2004l[?2004h>         'delta': avg_delta
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> citsci_df = pd.read_csv('/root/data/citsci_train.csv')
[?2004l[?2004h> expert_df = pd.read_csv('/root/data/expert_train.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Citizen science data: {len(citsci_df)} rows")
[?2004l[?2004h> print(f"Expert data: {len(expert_df)} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Extract relevant columns
[?2004l[?2004h> citsci_df = citsci_df[['file_rad', 'x', 'y']].dropna()
[?2004l[?2004h> expert_df = expert_df[['file_rad', 'x', 'y']].dropna()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"After removing NaN: citsci {len(citsci_df)}, expert {len(expert_df)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Group by image
[?2004l[?2004h> citsci_by_image = {}
[?2004l[?2004h> for image_id, group in citsci_df.groupby('file_rad'):
[?2004l[?2004h>     citsci_by_image[image_id] = group[['x', 'y']].values
[?2004l[?2004h> 
[?2004l[?2004h> expert_by_image = {}
[?2004l[?2004h> expert_images = set()
[?2004l[?2004h> for image_id, group in expert_df.groupby('file_rad'):
[?2004l[?2004h>     expert_by_image[image_id] = group[['x', 'y']].values
[?2004l[?2004h>     expert_images.add(image_id)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Unique images in expert data: {len(expert_images)}")
[?2004l[?2004h> print(f"Unique images in citsci data: {len(citsci_by_image)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Define hyperparameter ranges
[?2004l[?2004h> min_samples_range = list(range(3, 10))  # 3-9
[?2004l[?2004h> epsilon_range = list(range(4, 26, 2))   # 4, 6, 8, ..., 24
[?2004l[?2004h> shape_weight_range = np.arange(0.9, 2.0, 0.1)  # 0.9, 1.0, ..., 1.9
[?2004l[?2004h> shape_weight_range = np.round(shape_weight_range, 1)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nHyperparameter ranges:")
[?2004l[?2004h> print(f"  min_samples: {min_samples_range}")
[?2004l[?2004h> print(f"  epsilon: {epsilon_range}")
[?2004l[?2004h> print(f"  shape_weight: {list(shape_weight_range)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate all combinations
[?2004l[?2004h> params = list(product(min_samples_range, epsilon_range, shape_weight_range))
[?2004l[?2004h> print(f"\nTotal combinations to evaluate: {len(params)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Run grid search in parallel
[?2004l[?2004h> print("\nRunning grid search...")
[?2004l[?2004h> with Pool(processes=8) as pool:
[?2004l[?2004h>     results = pool.map(evaluate_hyperparams, params)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Completed {len(results)} evaluations")
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to DataFrame
[?2004l[?2004h> results_df = pd.DataFrame(results)
[?2004l[?2004h> 
[?2004l[?2004h> # Filter by F1 > 0.5
[?2004l[?2004h> filtered_df = results_df[results_df['f1'] > 0.5].copy()
[?2004l[?2004h> print(f"\nResults with F1 > 0.5: {len(filtered_df)}")
[?2004l[?2004h> 
[?2004l[?2004h> if len(filtered_df) == 0:
[?2004l[?2004h>     print("No results with F1 > 0.5")
[?2004l[?2004h>     pareto_df = pd.DataFrame()
[?2004l[?2004h> else:
[?2004l[?2004h>     # Find Pareto frontier
[?2004l[?2004h>     # A point is Pareto-optimal if no other point has both higher F1 and lower delta
[?2004l[?2004h>     pareto_points = []
[?2004l[?2004h>     for idx, row in filtered_df.iterrows():
[?2004l[?2004h>         is_dominated = False
[?2004l[?2004h>         for idx2, row2 in filtered_df.iterrows():
[?2004l[?2004h>             if idx == idx2:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # Check if row2 dominates row (higher F1 and lower delta)
[?2004l[?2004h>             if row2['f1'] > row['f1'] and row2['delta'] <= row['delta']:
[?2004l[?2004h>                 is_dominated = True
[?2004l[?2004h>                 break
[?2004l[?2004h>             if row2['f1'] >= row['f1'] and row2['delta'] < row['delta']:
[?2004l[?2004h>                 is_dominated = True
[?2004l[?2004h>                 break
[?2004l[?2004h>         if not is_dominated:
[?2004l[?2004h>             pareto_points.append(row)
[?2004l[?2004h>     
[?2004l[?2004h>     pareto_df = pd.DataFrame(pareto_points)
[?2004l[?2004h>     print(f"Pareto frontier points: {len(pareto_df)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Format output
[?2004l[?2004h> if len(pareto_df) > 0:
[?2004l[?2004h>     output_df = pareto_df[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']].copy()
[?2004l[?2004h>     output_df['f1'] = output_df['f1'].round(5)
[?2004l[?2004h>     output_df['delta'] = output_df['delta'].round(5)
[?2004l[?2004h>     output_df['shape_weight'] = output_df['shape_weight'].round(1)
[?2004l[?2004h>     output_df['min_samples'] = output_df['min_samples'].astype(int)
[?2004l[?2004h>     output_df['epsilon'] = output_df['epsilon'].astype(int)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by F1 descending
[?2004l[?2004h>     output_df = output_df.sort_values('f1', ascending=False)
[?2004l[?2004h>     
[?2004l[?2004h>     print("\nPareto frontier:")
[?2004l[?2004h>     print(output_df)
