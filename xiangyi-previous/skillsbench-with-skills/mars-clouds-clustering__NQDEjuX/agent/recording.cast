[32.80393, "o", "\u001b[?2004h"]
[32.803938, "o", "> "]
[32.803945, "o", "\r\n\u001b[?2004l\r"]
[32.803965, "o", "\u001b[?2004h> "]
[32.804017, "o", "# Generate all combinations\r\n\u001b[?2004l\r"]
[32.804024, "o", "\u001b[?2004h> "]
[32.804154, "o", "params = list(product(min_samples_range, epsilon_range, shape_weight_range))\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.804166, "o", "> "]
[32.804267, "o", "print(f\"\\nTotal combinations to evaluate: {len(params)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.804273, "o", "> \r\n\u001b[?2004l\r"]
[32.804281, "o", "\u001b[?2004h"]
[32.804301, "o", "> "]
[32.804351, "o", "# Run grid search in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.804366, "o", "> "]
[32.804424, "o", "print(\"\\nRunning grid search...\")\r\n\u001b[?2004l\r"]
[32.804448, "o", "\u001b[?2004h"]
[32.804455, "o", "> "]
[32.804515, "o", "with Pool(processes=8) as pool:\r\n\u001b[?2004l\r"]
[32.804538, "o", "\u001b[?2004h"]
[32.804545, "o", "> "]
[32.804636, "o", "    results = pool.map(evaluate_hyperparams, params)\r\n"]
[32.804643, "o", "\u001b[?2004l\r"]
[32.804663, "o", "\u001b[?2004h"]
[32.804669, "o", "> "]
[32.80468, "o", "\r\n"]
[32.8047, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.804707, "o", "> "]
