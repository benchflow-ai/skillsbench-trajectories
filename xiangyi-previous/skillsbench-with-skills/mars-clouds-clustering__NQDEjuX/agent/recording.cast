[947.141456, "o", "> "]
[947.142008, "o", "results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Filter by F1 > 0.5\r\n\u001b[?2004l\r\u001b[?2004h> filtered_df = results_df[results_df['f1'] > 0.5].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
