[32.791608, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rd\u001b[?2004h"]
[32.79165, "o", "> "]
[32.791659, "o", "    used_centroids = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.791733, "o", "    for dist, i, j in distances:\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.791761, "o", "> "]
[32.791868, "o", "        if i not in used_centroids and j not in used_experts:\r\n\u001b[?2004l\r"]
[32.791906, "o", "\u001b[?2004h> "]
[32.791975, "o", "            matched_centroids.append(centroids[i])\r\n\u001b[?2004l\r"]
[32.792, "o", "\u001b[?2004h> "]
[32.792075, "o", "            matched_experts.append(experts[j])\r\n\u001b[?2004l\r"]
[32.792102, "o", "\u001b[?2004h> "]
[32.792158, "o", "            used_centroids.add(i)\r\n\u001b[?2004l\r"]
[32.792195, "o", "\u001b[?2004h> "]
[32.792234, "o", "            used_experts.add(j)\r\n\u001b[?2004l\r"]
[32.792263, "o", "\u001b[?2004h> "]
[32.79227, "o", "    \r\n\u001b[?2004l\r,\u001b[?2004h> "]
[32.792371, "o", "    return matched_centroids, matched_experts\r\n\u001b[?2004l\r"]
[32.792434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[32.792591, "o", "def evaluate_image(image_id, citsci_points, expert_points, min_samples, epsilon, shape_weight):\r\n\u001b[?2004l\r"]
[32.792631, "o", "\u001b[?2004h> "]
[32.792718, "o", "    \"\"\"Evaluate a single image with given hyperparameters.\"\"\"\r\n\u001b[?2004l\r"]
[32.792745, "o", "\u001b[?2004h> "]
[32.792796, "o", "    if len(citsci_points) == 0:\r\n\u001b[?2004l\r"]
[32.792824, "o", "\u001b[?2004h> "]
[32.792911, "o", "        # No citizen science points for this image\r\n\u001b[?2004l\r"]
[32.792939, "o", "\u001b[?2004h> "]
[32.792988, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r"]
[32.793025, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.793061, "o", "\u001b[?2004h> "]
[32.793112, "o", "    # Define distance function for this weight\r\n\u001b[?2004l\r"]
[32.793141, "o", "\u001b[?2004h> "]
[32.79318, "o", "    def dist_func(a, b):\r\n\u001b[?2004l\r"]
[32.793192, "o", "\u001b[?2004h> "]
[32.793312, "o", "        return custom_distance(a, b, shape_weight)\r\n\u001b[?2004l\r"]
[32.793321, "o", "\u001b[?2004h> "]
[32.79336, "o", "    \r\n"]
[32.793369, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[32.793387, "o", "    # Run DBSCAN\r\n\u001b[?2004l\r"]
[32.793425, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[32.793434, "o", "\u001b[?2004h> "]
[32.793604, "o", "        db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=dist_func)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.793641, "o", "> "]
[32.793707, "o", "        labels = db.fit_predict(citsci_points)\r\n\u001b[?2004l\rn"]
[32.793736, "o", "\u001b[?2004h> "]
[32.793767, "o", "    except:\r\n\u001b[?2004l\r"]
[32.793775, "o", "\u001b[?2004h> "]
[32.793817, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r"]
[32.793854, "o", "\u001b[?2004h"]
[32.793862, "o", ">     \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[32.793985, "o", "    # Get cluster centroids (excluding noise points with label -1)\r\n\u001b[?2004l\r"]
[32.79401, "o", "\u001b[?2004h> "]
[32.794065, "o", "    unique_labels = set(labels)\r\n\u001b[?2004l\r"]
[32.79409, "o", "\u001b[?2004h> "]
[32.794148, "o", "    if -1 in unique_labels:\r\n\u001b[?2004l\r"]
[32.794202, "o", "\u001b[?2004h> "]
[32.794234, "o", "        unique_labels.remove(-1)\r\n\u001b[?2004l\r"]
[32.794283, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.794349, "o", "\u001b[?2004h> "]
[32.794395, "o", "    if len(unique_labels) == 0:\r\n\u001b[?2004l\r"]
[32.794445, "o", "\u001b[?2004h> "]
[32.794504, "o", "        # No clusters found\r\n\u001b[?2004l\r"]
[32.794536, "o", "\u001b[?2004h> "]
[32.794574, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\rn"]
[32.794602, "o", "\u001b[?2004h"]
[32.794612, "o", ">     \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[32.794663, "o", "    centroids = []\r\n\u001b[?2004l\r"]
[32.794691, "o", "\u001b[?2004h> "]
[32.794739, "o", "    for label in unique_labels:\r\n\u001b[?2004l\r"]
[32.794767, "o", "\u001b[?2004h> "]
[32.794869, "o", "        cluster_points = citsci_points[labels == label]\r\n\u001b[?2004l\r"]
[32.794897, "o", "\u001b[?2004h> "]
[32.795022, "o", "        centroid = cluster_points.mean(axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.795079, "o", "        centroids.append(centroid)\r\n\u001b[?2004l\r"]
[32.795093, "o", "\u001b[?2004h> "]
[32.79515, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.795255, "o", "    # Match centroids to expert points\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[32.795477, "o", "    matched_centroids, matched_experts = greedy_matching(centroids, expert_points)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.795492, "o", ">     \r\n\u001b[?2004l\r"]
[32.795526, "o", "\u001b[?2004h> "]
[32.795609, "o", "    if len(matched_centroids) == 0:\r\n\u001b[?2004l\r"]
[32.795634, "o", "\u001b[?2004h"]
[32.795645, "o", "> "]
[32.795697, "o", "        # No matches found\r\n\u001b[?2004l\rif ro\u001b[?2004h> "]
[32.795782, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.795808, "o", ">     \r\n\u001b[?2004l\r"]
[32.79583, "o", "\u001b[?2004h> "]
[32.79586, "o", "    # Compute F1 score\r\n\u001b[?2004l\r"]
[32.795887, "o", "\u001b[?2004h> "]
[32.795952, "o", "    # True positives: matched clusters\r\n\u001b[?2004l\r"]
[32.795971, "o", "\u001b[?2004h> "]
[32.796051, "o", "    tp = len(matched_centroids)\r\n\u001b[?2004l\r"]
[32.796068, "o", "\u001b[?2004h> "]
[32.796161, "o", "    # False positives: unmatched clusters\r\n\u001b[?2004l\rta"]
[32.796251, "o", "\u001b[?2004h> "]
[32.796262, "o", "    fp = len(centroids) - tp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.796404, "o", "    # False negatives: unmatched expert points\r\n\u001b[?2004l\rk\u001b[?2004h"]
[32.796432, "o", "> "]
[32.796491, "o", "    fn = len(expert_points) - tp\r\n\u001b[?2004l\r "]
[32.796515, "o", "\u001b[?2004h> "]
[32.796539, "o", "    \r\n\u001b[?2004l\r"]
[32.796578, "o", "\u001b[?2004h> "]
[32.796642, "o", "    if tp + fp == 0 or tp + fn == 0:\r\n\u001b[?2004l\r"]
[32.796659, "o", "\u001b[?2004h"]
[32.796677, "o", "> "]
[32.796703, "o", "        f1 = 0.0\r\n\u001b[?2004l\r"]
[32.796722, "o", "\u001b[?2004h> "]
[32.796748, "o", "    else:\r\n\u001b[?2004l\r("]
[32.796764, "o", "\u001b[?2004h> "]
[32.796885, "o", "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0\r\n\u001b[?2004l\r"]
[32.796905, "o", "\u001b[?2004h> "]
[32.797012, "o", "        recall = tp / (tp + fn) if (tp + fn) > 0 else 0\r\n\u001b[?2004l\r"]
[32.797029, "o", "\u001b[?2004h> "]
[32.797096, "o", "        if precision + recall == 0:\r\n\u001b[?2004l\r"]
[32.797118, "o", "\u001b[?2004h> "]
[32.79716, "o", "            f1 = 0.0\r\n\u001b[?2004l\ri"]
[32.797177, "o", "\u001b[?2004h> "]
[32.797199, "o", "        else:\r\n\u001b[?2004l\rw"]
[32.79722, "o", "\u001b[?2004h> "]
[32.79737, "o", "            f1 = 2 * precision * recall / (precision + recall)\r\n\u001b[?2004l\r"]
[32.797394, "o", "\u001b[?2004h> "]
[32.797405, "o", "    \r\n\u001b[?2004l\r  o\u001b[?2004h"]
[32.797429, "o", "> "]
[32.797526, "o", "    # Compute average delta (standard Euclidean distance)\r\n\u001b[?2004l\r"]
[32.797549, "o", "\u001b[?2004h> "]
[32.797711, "o", "    deltas = [euclidean_distance(c, e) for c, e in zip(matched_centroids, matched_experts)]\r\n\u001b[?2004l\r"]
[32.79773, "o", "\u001b[?2004h> "]
[32.797824, "o", "    delta = np.mean(deltas) if deltas else np.nan\r\n\u001b[?2004l\r"]
[32.797843, "o", "\u001b[?2004h> "]
[32.797862, "o", "    \r\n\u001b[?2004l\rn"]
[32.79788, "o", "\u001b[?2004h> "]
[32.797904, "o", "    return f1, delta\r\n\u001b[?2004l\ril"]
[32.797927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.797939, "o", "\u001b[?2004h> "]
[32.797993, "o", "def evaluate_hyperparams(params):\r\n\u001b[?2004l\ry"]
[32.79801, "o", "\u001b[?2004h> "]
[32.798122, "o", "    \"\"\"Evaluate a single hyperparameter combination.\"\"\"\r\n\u001b[?2004l\r"]
[32.798133, "o", "\u001b[?2004h"]
[32.798154, "o", "> "]
[32.798258, "o", "    min_samples, epsilon, shape_weight = params\r\n\u001b[?2004l\rro\u001b[?2004h>     \r\n\u001b[?2004l\rier"]
[32.798278, "o", "\u001b[?2004h> "]
[32.798308, "o", "    f1_scores = []\r\n\u001b[?2004l\rpu"]
[32.798329, "o", "\u001b[?2004h> "]
[32.798373, "o", "    deltas = []\r\n\u001b[?2004l\r"]
[32.798397, "o", "\u001b[?2004h"]
[32.798419, "o", ">     \r\n"]
[32.79844, "o", "\u001b[?2004l\r"]
[32.79846, "o", "\u001b[?2004h> "]
[32.798622, "o", "    # Loop over all unique images from expert dataset\r\n\u001b[?2004l\r"]
[32.798644, "o", "\u001b[?2004h"]
[32.798663, "o", "> "]
[32.798772, "o", "    for image_id in expert_images:\r\n\u001b[?2004l\r"]
[32.798794, "o", "\u001b[?2004h"]
[32.798815, "o", "> "]
[32.799019, "o", "        citsci_pts = citsci_by_image.get(image_id, np.array([]))\r\n\u001b[?2004l\r"]
[32.79904, "o", "\u001b[?2004h"]
[32.799066, "o", "> "]
[32.799172, "o", "        expert_pts = expert_by_image[image_id]\r\n\u001b[?2004l\r"]
[32.799194, "o", "\u001b[?2004h"]
[32.799213, "o", "> "]
[32.799242, "o", "        \r\n\u001b[?2004l\r"]
[32.799264, "o", "\u001b[?2004h"]
[32.799289, "o", "> "]
[32.799572, "o", "        f1, delta = evaluate_image(image_id, citsci_pts, expert_pts, min_samples, epsilon, shape_weight)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.799583, "o", "> "]
[32.799652, "o", "        f1_scores.append(f1)\r\n\u001b[?2004l\r"]
[32.799681, "o", "\u001b[?2004h> "]
[32.799733, "o", "        if not np.isnan(delta):\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.799744, "o", "> "]
[32.799812, "o", "            deltas.append(delta)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.799823, "o", "> "]
[32.79986, "o", "    \r\n\u001b[?2004l\r"]
[32.799882, "o", "\u001b[?2004h> "]
[32.799908, "o", "    avg_f1 = np.mean(f1_scores)\r\n\u001b[?2004l\r"]
[32.799929, "o", "\u001b[?2004h"]
[32.799952, "o", "> "]
[32.800009, "o", "    avg_delta = np.mean(deltas) if deltas else np.nan\r\n\u001b[?2004l\r"]
[32.800019, "o", "\u001b[?2004h"]
[32.800042, "o", ">     \r\n\u001b[?2004l\r"]
[32.800064, "o", "\u001b[?2004h> "]
[32.800097, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.80012, "o", "> "]
