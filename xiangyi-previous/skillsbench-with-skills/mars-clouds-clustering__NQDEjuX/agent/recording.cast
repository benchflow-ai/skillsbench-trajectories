[947.14006, "o", "\u001b[?2004h> # Generate all combinations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.140499, "o", "params = list(product(min_samples_range, epsilon_range, shape_weight_range))\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nTotal combinations to evaluate: {len(params)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
