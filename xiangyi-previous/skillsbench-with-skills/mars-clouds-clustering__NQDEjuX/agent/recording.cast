[2200.681652, "o", "\u001b[?2004h> "]
[2200.681803, "o", "    out['shape_weight'] = out['shape_weight'].round(1)\r\n"]
[2200.681818, "o", "\u001b[?2004l\r"]
[2200.681854, "o", "\u001b[?2004h> "]
[2200.682047, "o", "    out = out[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']]\r\n"]
