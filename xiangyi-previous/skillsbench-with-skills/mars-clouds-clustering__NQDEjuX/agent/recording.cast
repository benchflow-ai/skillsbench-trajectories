[2200.678267, "o", "\u001b[?2004h> "]
[2200.678355, "o", "            deltas.append(delta)\r\n"]
[2200.678369, "o", "\u001b[?2004l\r"]
[2200.678403, "o", "\u001b[?2004h> "]
[2200.678492, "o", "    avg_f1 = np.mean(f1s)\r\n\u001b[?2004l\r"]
[2200.678529, "o", "\u001b[?2004h"]
[2200.678541, "o", "> "]
[2200.678693, "o", "    avg_delta = np.mean(deltas) if deltas else np.nan\r\n"]
[2200.678708, "o", "\u001b[?2004l\r"]
[2200.678748, "o", "\u001b[?2004h> "]
[2200.678841, "o", "    if avg_f1 > 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.67915, "o", "        results.append({'f1': avg_f1, 'delta': avg_delta, 'min_samples': ms, 'epsilon': eps, 'shape_weight': w})\r\n\u001b[?2004l\r"]
