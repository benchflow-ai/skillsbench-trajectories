[32.803179, "o", "\u001b[?2004h> "]
[32.803279, "o", "epsilon_range = list(range(4, 26, 2))   # 4, 6, 8, ..., 24\r\n\u001b[?2004l\r"]
[32.803301, "o", "\u001b[?2004h"]
[32.803308, "o", "> "]
[32.803426, "o", "shape_weight_range = np.arange(0.9, 2.0, 0.1)  # 0.9, 1.0, ..., 1.9\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.803442, "o", "> "]
[32.803529, "o", "shape_weight_range = np.round(shape_weight_range, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.803535, "o", "> \r\n\u001b[?2004l\r"]
[32.803555, "o", "\u001b[?2004h"]
[32.803561, "o", "> "]
[32.803618, "o", "print(f\"\\nHyperparameter ranges:\")\r\n\u001b[?2004l\r"]
[32.803625, "o", "\u001b[?2004h> "]
[32.803704, "o", "print(f\"  min_samples: {min_samples_range}\")\r\n\u001b[?2004l\r"]
[32.803722, "o", "\u001b[?2004h"]
[32.80373, "o", "> "]
