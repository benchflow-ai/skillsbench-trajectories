[32.78784, "i", "cat > /root/optimize_dbscan.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.metrics import f1_score\nfrom itertools import product\nfrom multiprocessing import Pool\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef custom_distance(a, b, w):\n    \"\"\"Custom distance metric: sqrt((w*dx)^2 + ((2-w)*dy)^2)\"\"\"\n    dx = a[0] - b[0]\n    dy = a[1] - b[1]\n    return np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\n\ndef euclidean_distance(a, b):\n    \"\"\"Standard Euclidean distance\"\"\"\n    return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)\n\ndef greedy_matching(centroids, experts, max_distance=100):\n    \"\"\"Greedy matching of centroids to expert points using standard Euclidean distance.\"\"\"\n    if len(centroids) == 0 or len(experts) == 0:\n        return [], []\n    \n    centroids = np.array(centroids)\n    experts = np.array(experts)\n    \n    matched_centroids = []\n    matched_experts = []\n    used_experts = set()\n    \n    # Sort by distance\n    distances = []\n    for i, centroid in"]
[32.787896, "i", " enumerate(centroids):\n        for j, expert in enumerate(experts):\n            dist = euclidean_distance(centroid, expert)\n            if dist <= max_distance:\n                distances.append((dist, i, j))\n    \n    distances.sort()\n    \n    used_centroids = set()\n    for dist, i, j in distances:\n        if i not in used_centroids and j not in used_experts:\n            matched_centroids.append(centroids[i])\n            matched_experts.append(experts[j])\n            used_centroids.add(i)\n            used_experts.add(j)\n    \n    return matched_centroids, matched_experts\n\ndef evaluate_image(image_id, citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    \"\"\"Evaluate a single image with given hyperparameters.\"\"\"\n    if len(citsci_points) == 0:\n        # No citizen science points for this image\n        return 0.0, np.nan\n    \n    # Define distance function for this weight\n    def dist_func(a, b):\n        return custom_distance(a, b, shape_weight)\n    \n    # Run DBSCAN\n    try:\n        db = DBSCAN("]
[32.787937, "i", "eps=epsilon, min_samples=min_samples, metric=dist_func)\n        labels = db.fit_predict(citsci_points)\n    except:\n        return 0.0, np.nan\n    \n    # Get cluster centroids (excluding noise points with label -1)\n    unique_labels = set(labels)\n    if -1 in unique_labels:\n        unique_labels.remove(-1)\n    \n    if len(unique_labels) == 0:\n        # No clusters found\n        return 0.0, np.nan\n    \n    centroids = []\n    for label in unique_labels:\n        cluster_points = citsci_points[labels == label]\n        centroid = cluster_points.mean(axis=0)\n        centroids.append(centroid)\n    \n    # Match centroids to expert points\n    matched_centroids, matched_experts = greedy_matching(centroids, expert_points)\n    \n    if len(matched_centroids) == 0:\n        # No matches found\n        return 0.0, np.nan\n    \n    # Compute F1 score\n    # True positives: matched clusters\n    tp = len(matched_centroids)\n    # False positives: unmatched clusters\n    fp = len(centroids) - tp\n    # False negatives: unmatched expert"]
[32.788315, "i", " points\n    fn = len(expert_points) - tp\n    \n    if tp + fp == 0 or tp + fn == 0:\n        f1 = 0.0\n    else:\n        precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n        recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n        if precision + recall == 0:\n            f1 = 0.0\n        else:\n            f1 = 2 * precision * recall / (precision + recall)\n    \n    # Compute average delta (standard Euclidean distance)\n    deltas = [euclidean_distance(c, e) for c, e in zip(matched_centroids, matched_experts)]\n    delta = np.mean(deltas) if deltas else np.nan\n    \n    return f1, delta\n\ndef evaluate_hyperparams(params):\n    \"\"\"Evaluate a single hyperparameter combination.\"\"\"\n    min_samples, epsilon, shape_weight = params\n    \n    f1_scores = []\n    deltas = []\n    \n    # Loop over all unique images from expert dataset\n    for image_id in expert_images:\n        citsci_pts = citsci_by_image.get(image_id, np.array([]))\n        expert_pts = expert_by_image[image_id]\n        \n        f1, delta = evaluate_image(image"]
[32.788337, "o", "cat > /root/optimize_dbscan.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.cluster import DBSCAN\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import f1_score\r\n\u001b[?2004l\r\u001b[?2004h> from itertools import product\r\n\u001b[?2004l\r"]
[32.78837, "i", "_id, citsci_pts, expert_pts, min_samples, epsilon, shape_weight)\n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    \n    avg_f1 = np.mean(f1_scores)\n    avg_delta = np.mean(deltas) if deltas else np.nan\n    \n    return {\n        'min_samples': min_samples,\n        'epsilon': epsilon,\n        'shape_weight': shape_weight,\n        'f1': avg_f1,\n        'delta': avg_delta\n    }\n\n# Load data\nprint(\"Loading data...\")\ncitsci_df = pd.read_csv('/root/data/citsci_train.csv')\nexpert_df = pd.read_csv('/root/data/expert_train.csv')\n\nprint(f\"Citizen science data: {len(citsci_df)} rows\")\nprint(f\"Expert data: {len(expert_df)} rows\")\n\n# Extract relevant columns\ncitsci_df = citsci_df[['file_rad', 'x', 'y']].dropna()\nexpert_df = expert_df[['file_rad', 'x', 'y']].dropna()\n\nprint(f\"After removing NaN: citsci {len(citsci_df)}, expert {len(expert_df)}\")\n\n# Group by image\ncitsci_by_image = {}\nfor image_id, group in citsci_df.groupby('file_rad'):\n    citsci_by_image[image_id] = group[['"]
[32.78838, "o", "\u001b[?2004h> "]
[32.788385, "i", "x', 'y']].values\n\nexpert_by_image = {}\nexpert_images = set()\nfor image_id, group in expert_df.groupby('file_rad'):\n    expert_by_image[image_id] = group[['x', 'y']].values\n    expert_images.add(image_id)\n\nprint(f\"Unique images in expert data: {len(expert_images)}\")\nprint(f\"Unique images in citsci data: {len(citsci_by_image)}\")\n\n# Define hyperparameter ranges\nmin_samples_range = list(range(3, 10))  # 3-9\nepsilon_range = list(range(4, 26, 2))   # 4, 6, 8, ..., 24\nshape_weight_range = np.arange(0.9, 2.0, 0.1)  # 0.9, 1.0, ..., 1.9\nshape_weight_range = np.round(shape_weight_range, 1)\n\nprint(f\"\\nHyperparameter ranges:\")\nprint(f\"  min_samples: {min_samples_range}\")\nprint(f\"  epsilon: {epsilon_range}\")\nprint(f\"  shape_weight: {list(shape_weight_range)}\")\n\n# Generate all combinations\nparams = list(product(min_samples_range, epsilon_range, shape_weight_range))\nprint(f\"\\nTotal combinations to evaluate: {len(params)}\")\n\n# Run grid search in parallel\nprint(\"\\nRunning grid search...\")\nwith Pool(processes=8) as pool:\n    r"]
[32.788393, "i", "esults = pool.map(evaluate_hyperparams, params)\n\nprint(f\"Completed {len(results)} evaluations\")\n\n# Convert to DataFrame\nresults_df = pd.DataFrame(results)\n\n# Filter by F1 > 0.5\nfiltered_df = results_df[results_df['f1'] > 0.5].copy()\nprint(f\"\\nResults with F1 > 0.5: {len(filtered_df)}\")\n\nif len(filtered_df) == 0:\n    print(\"No results with F1 > 0.5\")\n    pareto_df = pd.DataFrame()\nelse:\n    # Find Pareto frontier\n    # A point is Pareto-optimal if no other point has both higher F1 and lower delta\n    pareto_points = []\n    for idx, row in filtered_df.iterrows():\n        is_dominated = False\n        for idx2, row2 in filtered_df.iterrows():\n            if idx == idx2:\n                continue\n            # Check if row2 dominates row (higher F1 and lower delta)\n            if row2['f1'] > row['f1'] and row2['delta'] <= row['delta']:\n                is_dominated = True\n                break\n            if row2['f1'] >= row['f1'] and row2['delta'] < row['delta']:\n                is_dominated = True\n              "]
[32.788399, "i", "  break\n        if not is_dominated:\n            pareto_points.append(row)\n    \n    pareto_df = pd.DataFrame(pareto_points)\n    print(f\"Pareto frontier points: {len(pareto_df)}\")\n\n# Format output\nif len(pareto_df) > 0:\n    output_df = pareto_df[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']].copy()\n    output_df['f1'] = output_df['f1'].round(5)\n    output_df['delta'] = output_df['delta'].round(5)\n    output_df['shape_weight'] = output_df['shape_weight'].round(1)\n    output_df['min_samples'] = output_df['min_samples'].astype(int)\n    output_df['epsilon'] = output_df['epsilon'].astype(int)\n    \n    # Sort by F1 descending\n    output_df = output_df.sort_values('f1', ascending=False)\n    \n    print(\"\\nPareto frontier:\")\n    print(output_df)\n    \n    # Write to CSV\n    output_df.to_csv('/root/pareto_frontier.csv', index=False)\n    print(\"\\nResults written to /root/pareto_frontier.csv\")\nelse:\n    print(\"No Pareto frontier points found\")\n    pd.DataFrame(columns=['F1', 'delta', 'min_samples', 'epsilon', '"]
[32.788404, "i", "shape_weight']).to_csv('/root/pareto_frontier.csv', index=False)\n\nEOF\n"]
