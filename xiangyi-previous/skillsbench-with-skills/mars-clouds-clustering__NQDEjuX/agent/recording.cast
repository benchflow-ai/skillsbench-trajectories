[947.134108, "o", "> "]
[947.134294, "o", "        'min_samples': min_samples,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.134312, "o", "        'epsilon': epsilon,\r\n\u001b[?2004l\r"]
[947.134371, "o", "\u001b[?2004h> "]
