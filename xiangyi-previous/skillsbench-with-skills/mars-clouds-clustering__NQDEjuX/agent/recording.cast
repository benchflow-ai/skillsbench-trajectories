[32.80854, "o", "\u001b[?2004h"]
[32.808547, "o", "> "]
[32.808646, "o", "    output_df['epsilon'] = output_df['epsilon'].astype(int)\r\n\u001b[?2004l\r"]
[32.808656, "o", "\u001b[?2004h"]
[32.80867, "o", "> "]
[32.808688, "o", "    \r\n"]
[32.808695, "o", "\u001b[?2004l\r"]
[32.808721, "o", "\u001b[?2004h"]
[32.808728, "o", "> "]
[32.80877, "o", "    # Sort by F1 descending\r\n"]
[32.808777, "o", "\u001b[?2004l\r"]
[32.808801, "o", "\u001b[?2004h"]
[32.808816, "o", "> "]
