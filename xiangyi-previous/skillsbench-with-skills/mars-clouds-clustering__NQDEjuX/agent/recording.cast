[947.125308, "o", "    # Run DBSCAN with precomputed distance matrix\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         db = DBSCAN(eps=epsilon, min_samples=min_samples, metric='precomputed')\r\n\u001b[?2004l\r\u001b[?2004h>         labels = db.fit_predict(dist_matrix)\r\n\u001b[?2004l\r\u001b[?2004h>     except:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Get cluster centroids (excluding noise points with label -1)\r\n\u001b[?2004l\r\u001b[?2004h>     unique_labels = set(labels)\r\n\u001b[?2004l\r\u001b[?2004h>     if -1 in unique_labels:\r\n\u001b[?2004l\r\u001b[?2004h>         unique_labels.remove(-1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if len(unique_labels) == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     centroids = []\r\n\u001b[?2004l\r\u001b[?2004h>     for label in unique_labels:\r\n\u001b[?2004l\r\u001b[?2004h>         cluster_points = citsci_points[labels == label]\r\n\u001b[?2004l\r\u001b[?2004h>         centroid = cluster_points.mean(axis=0)\r\n\u001b[?2004l\r\u001b[?2004h>         centroids.append(centroid"]
[947.125335, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Match centroids to expert points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.125539, "o", "    matched_centroids, matched_experts = greedy_matching(centroids, expert_points)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[947.125556, "o", "> "]
[947.125769, "o", "    if len(matched_centroids) == 0:\r\n\u001b[?2004l\r"]
[947.125792, "o", "\u001b[?2004h"]
[947.125804, "o", "> "]
[947.125973, "o", "        return 0.0, np.nan\r\n"]
[947.125989, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.126, "o", "> "]
[947.126061, "o", "    \r\n\u001b[?2004l\r"]
[947.126076, "o", "\u001b[?2004h> "]
[947.126227, "o", "    # Compute F1 score\r\n\u001b[?2004l\r"]
[947.126243, "o", "\u001b[?2004h"]
[947.126254, "o", "> "]
[947.126452, "o", "    tp = len(matched_centroids)\r\n"]
[947.126469, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.126522, "o", "> "]
[947.126685, "o", "    fp = len(centroids) - tp\r\n"]
[947.1267, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.126711, "o", "> "]
[947.126916, "o", "    fn = len(expert_points) - tp\r\n"]
[947.126931, "o", "\u001b[?2004l\r"]
[947.126941, "o", "\u001b[?2004h"]
[947.126951, "o", "> "]
[947.127014, "o", "    \r\n\u001b[?2004l\r"]
[947.127033, "o", "\u001b[?2004h> "]
[947.127256, "o", "    if tp + fp == 0 or tp + fn == 0:\r\n"]
[947.127272, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.127331, "o", "> "]
[947.127501, "o", "        f1 = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.127596, "o", "    else:\r\n\u001b[?2004l\r"]
[947.127656, "o", "\u001b[?2004h> "]
[947.127956, "o", "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0\r\n"]
[947.128018, "o", "\u001b[?2004l\r"]
[947.128037, "o", "\u001b[?2004h> "]
[947.12834, "o", "        recall = tp / (tp + fn) if (tp + fn) > 0 else 0\r\n"]
[947.128394, "o", "\u001b[?2004l\r"]
[947.128416, "o", "\u001b[?2004h> "]
[947.128643, "o", "        if precision + recall == 0:\r\n\u001b[?2004l\r"]
[947.128717, "o", "\u001b[?2004h> "]
[947.128837, "o", "            f1 = 0.0\r\n"]
[947.128899, "o", "\u001b[?2004l\r"]
[947.128918, "o", "\u001b[?2004h> "]
[947.129001, "o", "        else:\r\n"]
[947.129021, "o", "\u001b[?2004l\r"]
[947.129095, "o", "\u001b[?2004h> "]
[947.129462, "o", "            f1 = 2 * precision * recall / (precision + recall)\r\n"]
[947.129525, "o", "\u001b[?2004l\r"]
[947.129547, "o", "\u001b[?2004h> "]
[947.129565, "o", "    "]
[947.129585, "o", "\r\n"]
[947.129656, "o", "\u001b[?2004l\r"]
[947.129695, "o", "\u001b[?2004h> "]
[947.129827, "o", "    # Compute average delta\r\n"]
[947.129851, "o", "\u001b[?2004l\r"]
[947.129888, "o", "\u001b[?2004h> "]
[947.130459, "o", "    deltas = [euclidean_distance(c, e) for c, e in zip(matched_centroids, matched_experts)]\r\n\u001b[?2004l\r"]
[947.130565, "o", "\u001b[?2004h> "]
[947.13083, "o", "    delta = np.mean(deltas) if deltas else np.nan\r\n\u001b[?2004l\r"]
[947.130851, "o", "\u001b[?2004h> "]
[947.130912, "o", "    \r\n\u001b[?2004l\r"]
[947.130925, "o", "\u001b[?2004h> "]
[947.131071, "o", "    return f1, delta\r\n\u001b[?2004l\r"]
[947.131086, "o", "\u001b[?2004h"]
[947.131096, "o", "> "]
[947.131107, "o", "\r\n\u001b[?2004l\r"]
[947.131168, "o", "\u001b[?2004h> "]
[947.131328, "o", "def evaluate_hyperparams(params):\r\n\u001b[?2004l\r"]
[947.131345, "o", "\u001b[?2004h"]
[947.131358, "o", "> "]
[947.131658, "o", "    \"\"\"Evaluate a single hyperparameter combination.\"\"\"\r\n\u001b[?2004l\r"]
[947.131684, "o", "\u001b[?2004h"]
[947.131697, "o", "> "]
[947.131939, "o", "    min_samples, epsilon, shape_weight = params\r\n\u001b[?2004l\r"]
[947.131957, "o", "\u001b[?2004h"]
[947.131969, "o", "> "]
[947.132035, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.132177, "o", "    f1_scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.132271, "o", "    deltas = []\r\n\u001b[?2004l\r"]
[947.132288, "o", "\u001b[?2004h> "]
[947.132344, "o", "    \r\n\u001b[?2004l\r"]
[947.13236, "o", "\u001b[?2004h> "]
[947.132514, "o", "    for image_id in expert_images:\r\n"]
[947.132528, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.132571, "o", "> "]
[947.132722, "o", "        citsci_pts = citsci_by_image.get(image_id, np.array([]))\r\n"]
[947.132736, "o", "\u001b[?2004l\r"]
[947.132747, "o", "\u001b[?2004h"]
[947.132757, "o", "> "]
[947.132883, "o", "        expert_pts = expert_by_image[image_id]\r\n"]
[947.132897, "o", "\u001b[?2004l\r\u001b[?2004h"]
[947.132949, "o", ">         \r\n"]
[947.132963, "o", "\u001b[?2004l\r"]
[947.132972, "o", "\u001b[?2004h"]
[947.132987, "o", "> "]
[947.133276, "o", "        f1, delta = evaluate_image(image_id, citsci_pts, expert_pts, min_samples, epsilon, shape_weight)\r\n\u001b[?2004l\r"]
[947.133298, "o", "\u001b[?2004h> "]
[947.13345, "o", "        f1_scores.append(f1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.133507, "o", "        if not np.isnan(delta):\r\n\u001b[?2004l\r"]
[947.133521, "o", "\u001b[?2004h> "]
[947.133656, "o", "            deltas.append(delta)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.133674, "o", "    \r\n\u001b[?2004l\r"]
[947.133693, "o", "\u001b[?2004h> "]
[947.133851, "o", "    avg_f1 = np.mean(f1_scores)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[947.133964, "o", "    avg_delta = np.mean(deltas) if deltas else np.nan\r\n\u001b[?2004l\r"]
[947.133983, "o", "\u001b[?2004h> "]
[947.134042, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
