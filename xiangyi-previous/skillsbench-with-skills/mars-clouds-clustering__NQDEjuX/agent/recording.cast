[947.134616, "o", "\u001b[?2004h> "]
[947.134781, "o", "        'delta': avg_delta\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
