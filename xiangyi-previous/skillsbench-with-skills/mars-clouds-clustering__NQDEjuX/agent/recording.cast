[2200.661222, "o", "0.6248,14.69838,7,12,1.9\r\n0.6087,14.64791,8,20,1.8\r\n0.60318,14.61162,7,12,1.8\r\n0.60204,14.34988,7,10,1.9\r\n0.55212,14.27348,9,20,1.7\r\n0.54389,14.0939,9,18,1.7\r\n0.54051,14.08916,9,20,1.6\r\n"]
[2200.661343, "o", "\u001b[?2004h"]
[2200.66138, "o", "root@03401fc387bb:~# "]
[2200.661415, "o", "\r\n\u001b[?2004l\r"]
[2200.661445, "o", "\u001b[?2004hroot@03401fc387bb:~# "]
[2200.661479, "o", "C-c\r\n"]
[2200.661522, "o", "\u001b[?2004l\r"]
[2200.661868, "o", "bash: C-c: command not found\r\n"]
[2200.662057, "o", "\u001b[?2004h"]
[2200.662087, "o", "root@03401fc387bb:~# "]
[2200.662116, "o", "C-c\r\n\u001b[?2004l\r"]
[2200.662444, "o", "bash: C-c: command not found\r\n"]
[2200.662617, "o", "\u001b[?2004h"]
[2200.662657, "o", "root@03401fc387bb:~# "]
[2200.662669, "o", "C-c\r\n\u001b[?2004l\r"]
[2200.663011, "o", "bash: C-c: command not found\r\n"]
[2200.663182, "o", "\u001b[?2004h"]
[2200.66323, "o", "root@03401fc387bb:~# "]
[2200.663367, "o", "rm -f /root/optimize_dbscan*.py\r\n"]
[2200.663409, "o", "\u001b[?2004l\r"]
[2200.664945, "o", "\u001b[?2004hroot@03401fc387bb:~# "]
[2200.665085, "o", "python3 << 'PYSCRIPT'\r\n\u001b[?2004l\r"]
[2200.665117, "o", "\u001b[?2004h"]
[2200.66513, "o", "> "]
[2200.665245, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[2200.665299, "o", "\u001b[?2004h"]
[2200.665312, "o", "> "]
[2200.665404, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[2200.665445, "o", "\u001b[?2004h"]
[2200.665457, "o", "> "]
[2200.665555, "o", "from sklearn.cluster import DBSCAN"]
[2200.666075, "o", "\r\n\u001b[?2004l\r"]
[2200.667639, "o", "\u001b[?2004h> from itertools import product\r\n\u001b[?2004l\r\u001b[?2004h> import warnings\r\n\u001b[?2004l\r\u001b[?2004h> warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h> citsci_df = pd.read_csv('/root/data/citsci_train.csv')[['file_rad', 'x', 'y']].dropna()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.668243, "o", "expert_df = pd.read_csv('/root/data/expert_train.csv')[['file_rad', 'x', 'y']].dropna()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> citsci_by_img = {img: group[['x', 'y']].values for img, group in citsci_df.groupby('file_rad')}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.668339, "o", "expert_by_img = {img: group[['x', 'y']].values for img, group in expert_df.groupby('file_rad')}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.668439, "o", "expert_imgs = list(expert_by_img.keys())\r\n"]
[2200.668481, "o", "\u001b[?2004l\r"]
[2200.668496, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2200.668556, "o", "\u001b[?2004h> "]
[2200.668735, "o", "print(f\"Expert images: {len(expert_imgs)}, CitSci images: {len(citsci_by_img)}\")\r\n"]
[2200.668787, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2200.668804, "o", "\u001b[?2004h"]
[2200.668839, "o", "> "]
[2200.668951, "o", "def custom_dist(a, b, w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.669122, "o", "    return np.sqrt((w * (a[0] - b[0]))**2 + ((2 - w) * (a[1] - b[1]))**2)\r\n\u001b[?2004l\r"]
[2200.669159, "o", "\u001b[?2004h> "]
[2200.669186, "o", "\r\n\u001b[?2004l\r"]
[2200.669215, "o", "\u001b[?2004h"]
[2200.669228, "o", "> "]
[2200.669362, "o", "def eucl_dist(a, b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.669464, "o", "    return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)\r\n\u001b[?2004l\r"]
[2200.66948, "o", "\u001b[?2004h"]
[2200.669518, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.669531, "o", "> "]
[2200.66964, "o", "def dist_matrix(pts, w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.669699, "o", "    n = len(pts)\r\n\u001b[?2004l\r"]
[2200.669733, "o", "\u001b[?2004h> "]
[2200.669806, "o", "    dm = np.zeros((n, n))\r\n"]
[2200.669819, "o", "\u001b[?2004l\r"]
[2200.669854, "o", "\u001b[?2004h> "]
[2200.669952, "o", "    for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.669966, "o", "> "]
[2200.670059, "o", "        for j in range(i+1, n):\r\n"]
[2200.670074, "o", "\u001b[?2004l\r"]
[2200.670115, "o", "\u001b[?2004h> "]
[2200.670227, "o", "            d = custom_dist(pts[i], pts[j], w)\r\n"]
[2200.670241, "o", "\u001b[?2004l\r"]
[2200.670279, "o", "\u001b[?2004h> "]
[2200.670366, "o", "            dm[i, j] = dm[j, i] = d\r\n"]
[2200.670379, "o", "\u001b[?2004l\r"]
[2200.670414, "o", "\u001b[?2004h> "]
[2200.670493, "o", "    return dm\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2200.670526, "o", "\u001b[?2004h> "]
[2200.670615, "o", "def greedy_match(cents, experts):\r\n"]
[2200.67063, "o", "\u001b[?2004l\r"]
[2200.670667, "o", "\u001b[?2004h> "]
[2200.670777, "o", "    if len(cents) == 0 or len(experts) == 0:\r\n"]
[2200.670793, "o", "\u001b[?2004l\r"]
[2200.670833, "o", "\u001b[?2004h> "]
[2200.671125, "o", "        return [], []"]
[2200.671141, "o", "\r\n\u001b[?2004l\r"]
[2200.671225, "o", "\u001b[?2004h> "]
[2200.67128, "o", "    cents = np.array(cents)\r\n\u001b[?2004l\r"]
[2200.671312, "o", "\u001b[?2004h> "]
[2200.671405, "o", "    experts = np.array(experts)\r\n\u001b[?2004l\r"]
[2200.671441, "o", "\u001b[?2004h> "]
[2200.671889, "o", "    pairs = [(eucl_dist(cents[i], experts[j]), i, j) for i in range(len(cents)) for j in range(len(experts)) if eucl_dist(cents[i], experts[j]) <= 100]\r\n"]
[2200.67191, "o", "\u001b[?2004l\r"]
[2200.671953, "o", "\u001b[?2004h> "]
[2200.672053, "o", "    pairs.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.672168, "o", "    used_c, used_e = set(), set()\r\n"]
[2200.672202, "o", "\u001b[?2004l\r"]
[2200.672231, "o", "\u001b[?2004h"]
[2200.672244, "o", "> "]
[2200.672349, "o", "    matched = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.6724, "o", "    for d, i, j in pairs:\r\n"]
[2200.67242, "o", "\u001b[?2004l\r"]
[2200.672456, "o", "\u001b[?2004h> "]
[2200.67267, "o", "        if i not in used_c and j not in used_e:\r\n"]
[2200.672685, "o", "\u001b[?2004l\r"]
[2200.672725, "o", "\u001b[?2004h> "]
[2200.672869, "o", "            matched.append((cents[i], experts[j]))\r\n\u001b[?2004l\r"]
[2200.672909, "o", "\u001b[?2004h> "]
[2200.672983, "o", "            used_c.add(i)\r\n\u001b[?2004l\r"]
[2200.673016, "o", "\u001b[?2004h> "]
[2200.673085, "o", "            used_e.add(j)\r\n"]
[2200.673173, "o", "\u001b[?2004l\r"]
[2200.673209, "o", "\u001b[?2004h> "]
[2200.673297, "o", "    return matched\r\n\u001b[?2004l\r"]
[2200.673312, "o", "\u001b[?2004h"]
[2200.673351, "o", "> \r\n\u001b[?2004l\r"]
[2200.673379, "o", "\u001b[?2004h> "]
[2200.67348, "o", "def eval_img(img_id, ms, eps, w):\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.673514, "o", "> "]
[2200.673701, "o", "    cpts = citsci_by_img.get(img_id, np.array([]))\r\n"]
[2200.673718, "o", "\u001b[?2004l\r"]
[2200.673759, "o", "\u001b[?2004h> "]
[2200.673858, "o", "    epts = expert_by_img[img_id]\r\n"]
[2200.673878, "o", "\u001b[?2004l\r"]
[2200.673916, "o", "\u001b[?2004h> "]
[2200.674, "o", "    if len(cpts) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.674034, "o", "> "]
[2200.674102, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r"]
[2200.674134, "o", "\u001b[?2004h> "]
[2200.674206, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.674381, "o", "        db = DBSCAN(eps=eps, min_samples=ms, metric='precomputed')\r\n\u001b[?2004l\r"]
[2200.674427, "o", "\u001b[?2004h> "]
[2200.674584, "o", "        labels = db.fit_predict(dist_matrix(cpts, w))\r\n\u001b[?2004l\r"]
[2200.674633, "o", "\u001b[?2004h> "]
[2200.674664, "o", "    except:\r\n\u001b[?2004l\r"]
[2200.674691, "o", "\u001b[?2004h"]
[2200.674704, "o", "> "]
[2200.674841, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.674909, "o", "    ulabels = set(labels) - {-1}\r\n\u001b[?2004l\r"]
[2200.674946, "o", "\u001b[?2004h> "]
[2200.675033, "o", "    if len(ulabels) == 0:\r\n\u001b[?2004l\r"]
[2200.675047, "o", "\u001b[?2004h"]
[2200.675058, "o", "> "]
[2200.675188, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.675337, "o", "    cents = [cpts[labels == l].mean(axis=0) for l in ulabels]\r\n\u001b[?2004l\r"]
[2200.675389, "o", "\u001b[?2004h> "]
[2200.675493, "o", "    matched = greedy_match(cents, epts)\r\n\u001b[?2004l\r"]
[2200.67551, "o", "\u001b[?2004h> "]
[2200.675605, "o", "    if len(matched) == 0:\r\n\u001b[?2004l\r"]
[2200.675647, "o", "\u001b[?2004h> "]
[2200.675737, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.675772, "o", "> "]
[2200.675838, "o", "    tp = len(matched)\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.675853, "o", "> "]
[2200.675951, "o", "    fp = len(cents) - tp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.676023, "o", "    fn = len(epts) - tp\r\n\u001b[?2004l\r"]
[2200.676059, "o", "\u001b[?2004h> "]
[2200.676239, "o", "    f1 = 2 * tp / (2 * tp + fp + fn) if (2 * tp + fp + fn) > 0 else 0.0\r\n\u001b[?2004l\r"]
[2200.676256, "o", "\u001b[?2004h"]
[2200.6763, "o", "> "]
[2200.676434, "o", "    delta = np.mean([eucl_dist(c, e) for c, e in matched])\r\n\u001b[?2004l\r"]
[2200.676476, "o", "\u001b[?2004h> "]
[2200.67656, "o", "    return f1, delta\r\n\u001b[?2004l\r"]
[2200.676601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2200.676626, "o", "\u001b[?2004h"]
[2200.67664, "o", "> "]
[2200.676754, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.676947, "o", "params = list(product(range(3, 10), range(4, 26, 2), np.round(np.arange(0.9, 2.0, 0.1), 1)))\r\n\u001b[?2004l\r"]
[2200.67697, "o", "\u001b[?2004h"]
[2200.676982, "o", "> "]
[2200.677138, "o", "print(f\"Total params: {len(params)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.677179, "o", "> "]
[2200.677293, "o", "for i, (ms, eps, w) in enumerate(params):\r\n"]
[2200.677311, "o", "\u001b[?2004l\r"]
[2200.677358, "o", "\u001b[?2004h> "]
[2200.677466, "o", "    if i % 50 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.677555, "o", "        print(f\"Progress: {i}/{len(params)}\")\r\n"]
[2200.677572, "o", "\u001b[?2004l\r"]
[2200.677613, "o", "\u001b[?2004h> "]
[2200.677699, "o", "    f1s, deltas = [], []\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.677712, "o", "> "]
[2200.677799, "o", "    for img in expert_imgs:\r\n"]
[2200.677813, "o", "\u001b[?2004l\r"]
[2200.677849, "o", "\u001b[?2004h> "]
