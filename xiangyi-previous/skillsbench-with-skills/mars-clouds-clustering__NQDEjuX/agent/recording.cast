[2200.679222, "o", "\u001b[?2004h"]
[2200.679255, "o", "> "]
[2200.679399, "o", "print(f\"\\nResults with F1 > 0.5: {len(results)}\")\r\n\u001b[?2004l\r"]
[2200.679443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[2200.679471, "o", "\u001b[?2004h> "]
[2200.679562, "o", "if results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.679658, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[2200.679699, "o", "\u001b[?2004h> "]
[2200.67977, "o", "    pareto = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.679801, "o", "> "]
[2200.679889, "o", "    for _, r in df.iterrows():\r\n"]
[2200.679906, "o", "\u001b[?2004l\r"]
[2200.679952, "o", "\u001b[?2004h> "]
[2200.680055, "o", "        dominated = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2200.680163, "o", "        for _, r2 in df.iterrows():\r\n"]
[2200.680181, "o", "\u001b[?2004l\r"]
[2200.680225, "o", "\u001b[?2004h> "]
[2200.68055, "o", "            if (r2['f1'] > r['f1'] and r2['delta'] <= r['delta']) or (r2['f1'] >= r['f1'] and r2['delta'] < r['delta']):\r\n\u001b[?2004l\r"]
[2200.680599, "o", "\u001b[?2004h> "]
[2200.680698, "o", "                dominated = True\r\n\u001b[?2004l\r"]
[2200.680739, "o", "\u001b[?2004h> "]
[2200.680825, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.680843, "o", "> "]
[2200.68095, "o", "        if not dominated:\r\n\u001b[?2004l\r\u001b[?2004h"]
[2200.680992, "o", "> "]
[2200.681064, "o", "            pareto.append(r)\r\n\u001b[?2004l\r"]
[2200.681098, "o", "\u001b[?2004h> "]
