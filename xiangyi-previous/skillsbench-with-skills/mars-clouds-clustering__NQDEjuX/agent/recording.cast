[32.804823, "o", "\u001b[?2004h"]
[32.804841, "o", "> "]
[32.804849, "o", "\r\n\u001b[?2004l\r"]
[32.804869, "o", "\u001b[?2004h> "]
[32.804918, "o", "# Convert to DataFrame\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.804933, "o", "> "]
[32.804992, "o", "results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[32.805016, "o", "\u001b[?2004h"]
[32.805022, "o", "> "]
[32.805026, "o", "\r\n"]
[32.805033, "o", "\u001b[?2004l\r"]
[32.805052, "o", "\u001b[?2004h> "]
[32.805091, "o", "# Filter by F1 > 0.5\r\n\u001b[?2004l\r"]
[32.8051, "o", "\u001b[?2004h"]
[32.805114, "o", "> "]
[32.805208, "o", "filtered_df = results_df[results_df['f1'] > 0.5].copy()\r\n\u001b[?2004l\r"]
[32.805232, "o", "\u001b[?2004h"]
[32.805239, "o", "> "]
[32.805355, "o", "print(f\"\\nResults with F1 > 0.5: {len(filtered_df)}\")\r\n\u001b[?2004l\r"]
[32.805381, "o", "\u001b[?2004h"]
[32.805388, "o", "> "]
[32.805395, "o", "\r\n\u001b[?2004l\r"]
[32.805415, "o", "\u001b[?2004h"]
[32.80542, "o", "> "]
[32.805474, "o", "if len(filtered_df) == 0:\r\n\u001b[?2004l\r"]
[32.805496, "o", "\u001b[?2004h"]
[32.805503, "o", "> "]
[32.805575, "o", "    print(\"No results with F1 > 0.5\")\r\n"]
[32.805582, "o", "\u001b[?2004l\r"]
[32.805605, "o", "\u001b[?2004h> "]
[32.805664, "o", "    pareto_df = pd.DataFrame()\r\n\u001b[?2004l\r"]
[32.805685, "o", "\u001b[?2004h"]
[32.805692, "o", "> "]
[32.805715, "o", "else:\r\n\u001b[?2004l\r"]
[32.805743, "o", "\u001b[?2004h"]
[32.80575, "o", "> "]
[32.805804, "o", "    # Find Pareto frontier\r\n\u001b[?2004l\r"]
[32.805835, "o", "\u001b[?2004h> "]
[32.805973, "o", "    # A point is Pareto-optimal if no other point has both higher F1 and lower delta\r\n"]
[32.80598, "o", "\u001b[?2004l\r"]
[32.806, "o", "\u001b[?2004h"]
[32.806005, "o", "> "]
[32.806061, "o", "    pareto_points = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.806067, "o", "> "]
[32.806152, "o", "    for idx, row in filtered_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.806161, "o", "> "]
[32.806215, "o", "        is_dominated = False\r\n\u001b[?2004l\r"]
[32.806238, "o", "\u001b[?2004h"]
[32.806245, "o", "> "]
[32.806331, "o", "        for idx2, row2 in filtered_df.iterrows():\r\n\u001b[?2004l\r"]
[32.806351, "o", "\u001b[?2004h"]
[32.806357, "o", "> "]
[32.806413, "o", "            if idx == idx2:\r\n\u001b[?2004l\r"]
[32.806422, "o", "\u001b[?2004h"]
[32.806436, "o", "> "]
[32.806485, "o", "                continue\r\n\u001b[?2004l\r"]
[32.806509, "o", "\u001b[?2004h"]
[32.806516, "o", "> "]
[32.806629, "o", "            # Check if row2 dominates row (higher F1 and lower delta)\r\n\u001b[?2004l\r"]
[32.806653, "o", "\u001b[?2004h"]
[32.80666, "o", "> "]
[32.806776, "o", "            if row2['f1'] > row['f1'] and row2['delta'] <= row['delta']:\r\n\u001b[?2004l\r"]
[32.8068, "o", "\u001b[?2004h"]
[32.806806, "o", "> "]
[32.80689, "o", "                is_dominated = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.806897, "o", "> "]
[32.806931, "o", "                break\r\n\u001b[?2004l\r"]
[32.80695, "o", "\u001b[?2004h> "]
[32.807066, "o", "            if row2['f1'] >= row['f1'] and row2['delta'] < row['delta']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.807081, "o", "> "]
[32.807144, "o", "                is_dominated = True\r\n\u001b[?2004l\r"]
[32.807167, "o", "\u001b[?2004h"]
[32.807177, "o", "> "]
[32.807225, "o", "                break\r\n\u001b[?2004l\r"]
[32.807235, "o", "\u001b[?2004h"]
[32.807247, "o", "> "]
[32.807301, "o", "        if not is_dominated:\r\n\u001b[?2004l\r"]
[32.807327, "o", "\u001b[?2004h"]
[32.807334, "o", "> "]
[32.807403, "o", "            pareto_points.append(row)\r\n\u001b[?2004l\r"]
[32.807428, "o", "\u001b[?2004h"]
[32.807436, "o", "> "]
[32.807456, "o", "    \r\n\u001b[?2004l\r"]
[32.807479, "o", "\u001b[?2004h"]
[32.807486, "o", "> "]
[32.807563, "o", "    pareto_df = pd.DataFrame(pareto_points)\r\n\u001b[?2004l\r"]
[32.807588, "o", "\u001b[?2004h"]
[32.807607, "o", "> "]
[32.807688, "o", "    print(f\"Pareto frontier points: {len(pareto_df)}\")\r\n"]
[32.807695, "o", "\u001b[?2004l\r"]
[32.807714, "o", "\u001b[?2004h"]
[32.80773, "o", "> \r\n"]
[32.807751, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.807767, "o", "> "]
[32.807797, "o", "# Format output\r\n\u001b[?2004l\r"]
[32.807814, "o", "\u001b[?2004h"]
[32.807818, "o", "> "]
[32.807863, "o", "if len(pareto_df) > 0:\r\n"]
[32.807868, "o", "\u001b[?2004l\r"]
[32.80789, "o", "\u001b[?2004h"]
[32.807896, "o", "> "]
[32.808036, "o", "    output_df = pareto_df[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']].copy()\r\n\u001b[?2004l\r"]
[32.808044, "o", "\u001b[?2004h"]
[32.80805, "o", "> "]
[32.808127, "o", "    output_df['f1'] = output_df['f1'].round(5)\r\n\u001b[?2004l\r"]
[32.808144, "o", "\u001b[?2004h"]
[32.808151, "o", "> "]
[32.808239, "o", "    output_df['delta'] = output_df['delta'].round(5)\r\n"]
[32.808245, "o", "\u001b[?2004l\r"]
[32.808266, "o", "\u001b[?2004h"]
[32.808281, "o", "> "]
[32.808383, "o", "    output_df['shape_weight'] = output_df['shape_weight'].round(1)\r\n\u001b[?2004l\r"]
[32.808399, "o", "\u001b[?2004h"]
[32.808406, "o", "> "]
[32.808515, "o", "    output_df['min_samples'] = output_df['min_samples'].astype(int)\r\n"]
