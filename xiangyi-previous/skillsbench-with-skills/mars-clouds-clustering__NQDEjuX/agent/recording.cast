[32.800198, "o", "\u001b[?2004h"]
[32.800221, "o", "> "]
[32.800261, "o", "        'epsilon': epsilon,\r\n\u001b[?2004l\r"]
[32.800285, "o", "\u001b[?2004h"]
[32.800305, "o", "> "]
[32.800362, "o", "        'shape_weight': shape_weight,\r\n\u001b[?2004l\r"]
[32.800388, "o", "\u001b[?2004h"]
[32.80041, "o", "> "]
[32.800442, "o", "        'f1': avg_f1,\r\n\u001b[?2004l\r"]
[32.800466, "o", "\u001b[?2004h"]
[32.800487, "o", "> "]
[32.800527, "o", "        'delta': avg_delta\r\n\u001b[?2004l\r"]
[32.800549, "o", "\u001b[?2004h"]
[32.800572, "o", "> "]
[32.800594, "o", "    }\r\n\u001b[?2004l\r"]
[32.800615, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.800638, "o", "\u001b[?2004h> "]
