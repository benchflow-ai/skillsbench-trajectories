[1682.882679, "i", "python3 << 'PYSCRIPT'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom itertools import product\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\ncitsci_df = pd.read_csv('/root/data/citsci_train.csv')[['file_rad', 'x', 'y']].dropna()\nexpert_df = pd.read_csv('/root/data/expert_train.csv')[['file_rad', 'x', 'y']].dropna()\n\ncitsci_by_img = {img: group[['x', 'y']].values for img, group in citsci_df.groupby('file_rad')}\nexpert_by_img = {img: group[['x', 'y']].values for img, group in expert_df.groupby('file_rad')}\nexpert_imgs = list(expert_by_img.keys())\n\nprint(f\"Expert images: {len(expert_imgs)}, CitSci images: {len(citsci_by_img)}\")\n\ndef custom_dist(a, b, w):\n    return np.sqrt((w * (a[0] - b[0]))**2 + ((2 - w) * (a[1] - b[1]))**2)\n\ndef eucl_dist(a, b):\n    return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)\n\ndef dist_matrix(pts, w):\n    n = len(pts)\n    dm = np.zeros((n, n))\n    for i in range(n):\n        for j in range(i+1, n):\n            d = custom_dist"]
[1682.882928, "o", "python3 << 'PYSCRIPT'\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.cluster import DBSCAN\r\nfrom itertools import product\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\nprint(\"Loading data...\")\r\ncitsci_df = pd.read_csv('/root/data/citsci_train.csv')[['file_rad', 'x', 'y']].dropna()\r\nexpert_df = pd.read_csv('/root/data/expert_train.csv')[['file_rad', 'x', 'y']].dropna()\r\n\r\ncitsci_by_img = {img: group[['x', 'y']].values for img, group in citsci_df.groupby('file_rad')}\r\nexpert_by_img = {img: group[['x', 'y']].values for img, group in expert_df.groupby('file_rad')}\r\nexpert_imgs = list(expert_by_img.keys())\r\n\r\nprint(f\"Expert images: {len(expert_imgs)}, CitSci images: {len(citsci_by_img)}\")\r\n\r\ndef custom_dist(a, b, w):\r\n    return np.sqrt((w * (a[0] - b[0]))**2 + ((2 - w) * (a[1] - b[1]))**2)\r\n\r\ndef eucl_dist(a, b):\r\n    return np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2)\r\n\r\ndef dist_matrix(pts, w):\r\n    n = len(pts)\r\n    dm = np.zeros((n, n))\r\n    for i in range(n):\r\n        for j in range(i+1, n):"]
[1682.883696, "i", "(pts[i], pts[j], w)\n            dm[i, j] = dm[j, i] = d\n    return dm\n\ndef greedy_match(cents, experts):\n    if len(cents) == 0 or len(experts) == 0:\n        return [], []\n    cents = np.array(cents)\n    experts = np.array(experts)\n    pairs = [(eucl_dist(cents[i], experts[j]), i, j) for i in range(len(cents)) for j in range(len(experts)) if eucl_dist(cents[i], experts[j]) <= 100]\n    pairs.sort()\n    used_c, used_e = set(), set()\n    matched = []\n    for d, i, j in pairs:\n        if i not in used_c and j not in used_e:\n            matched.append((cents[i], experts[j]))\n            used_c.add(i)\n            used_e.add(j)\n    return matched\n\ndef eval_img(img_id, ms, eps, w):\n    cpts = citsci_by_img.get(img_id, np.array([]))\n    epts = expert_by_img[img_id]\n    if len(cpts) == 0:\n        return 0.0, np.nan\n    try:\n        db = DBSCAN(eps=eps, min_samples=ms, metric='precomputed')\n        labels = db.fit_predict(dist_matrix(cpts, w))\n    except:\n        return 0.0, np.nan\n    ulabels = set(labels) - {-1}\n    i"]
[1682.883746, "o", "\r\n            d = custom_dist(pts[i], pts[j], w)\r\n            dm[i, j] = dm[j, i] = d\r\n    return dm\r\n\r\ndef greedy_match(cents, experts):\r\n    if len(cents) == 0 or len(experts) == 0:\r\n        return [], []\r\n    cents = np.array(cents)\r\n    experts = np.array(experts)\r\n    pairs = [(eucl_dist(cents[i], experts[j]), i, j) for i in range(len(cents)) for j in range(len(experts)) if eucl_dist(cents[i], experts[j]) <= 100]\r\n    pairs.sort()\r\n    used_c, used_e = set(), set()\r\n    matched = []\r\n    for d, i, j in pairs:\r\n        if i not in used_c and j not in used_e:\r\n            matched.append((cents[i], experts[j]))\r\n            used_c.add(i)\r\n            used_e.add(j)\r\n    return matched\r\n\r\ndef eval_img(img_id, ms, eps, w):\r\n    cpts = citsci_by_img.get(img_id, np.array([]))\r\n    epts = expert_by_img[img_id]\r\n    if len(cpts) == 0:\r\n        return 0.0, np.nan\r\n    try:\r\n        db = DBSCAN(eps=eps, min_samples=ms, metric='precomputed')\r\n        labels = db.fit_predict(dist_matrix(cpts, w))\r\n    except:\r\n       "]
[1682.884369, "i", "f len(ulabels) == 0:\n        return 0.0, np.nan\n    cents = [cpts[labels == l].mean(axis=0) for l in ulabels]\n    matched = greedy_match(cents, epts)\n    if len(matched) == 0:\n        return 0.0, np.nan\n    tp = len(matched)\n    fp = len(cents) - tp\n    fn = len(epts) - tp\n    f1 = 2 * tp / (2 * tp + fp + fn) if (2 * tp + fp + fn) > 0 else 0.0\n    delta = np.mean([eucl_dist(c, e) for c, e in matched])\n    return f1, delta\n\nresults = []\nparams = list(product(range(3, 10), range(4, 26, 2), np.round(np.arange(0.9, 2.0, 0.1), 1)))\nprint(f\"Total params: {len(params)}\")\n\nfor i, (ms, eps, w) in enumerate(params):\n    if i % 50 == 0:\n        print(f\"Progress: {i}/{len(params)}\")\n    f1s, deltas = [], []\n    for img in expert_imgs:\n        f1, delta = eval_img(img, ms, eps, w)\n        f1s.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    avg_f1 = np.mean(f1s)\n    avg_delta = np.mean(deltas) if deltas else np.nan\n    if avg_f1 > 0.5:\n        results.append({'f1': avg_f1, 'delta': avg_delta"]
[1682.8844, "o", " return 0.0, np.nan\r\n    ulabels = set(labels) - {-1}\r\n    if len(ulabels) == 0:\r\n        return 0.0, np.nan\r\n    cents = [cpts[labels == l].mean(axis=0) for l in ulabels]\r\n    matched = greedy_match(cents, epts)\r\n    if len(matched) == 0:\r\n        return 0.0, np.nan\r\n    tp = len(matched)\r\n    fp = len(cents) - tp\r\n    fn = len(epts) - tp\r\n    f1 = 2 * tp / (2 * tp + fp + fn) if (2 * tp + fp + fn) > 0 else 0.0\r\n    delta = np.mean([eucl_dist(c, e) for c, e in matched])\r\n    return f1, delta\r\n\r\nresults = []\r\nparams = list(product(range(3, 10), range(4, 26, 2), np.round(np.arange(0.9, 2.0, 0.1), 1)))\r\nprint(f\"Total params: {len(params)}\")\r\n\r\nfor i, (ms, eps, w) in enumerate(params):\r\n    if i % 50 == 0:\r\n        print(f\"Progress: {i}/{len(params)}\")\r\n    f1s, deltas = [], []\r\n    for img in expert_imgs:\r\n        f1, delta = eval_img(img, ms, eps, w)\r\n        f1s.append(f1)\r\n        if not np.isnan(delta):\r\n            deltas.append(delta)\r\n    avg_f1 = np.mean(f1s)\r\n    avg_delta = np.mean(deltas) if deltas el"]
[1682.884412, "i", ", 'min_samples': ms, 'epsilon': eps, 'shape_weight': w})\n\nprint(f\"\\nResults with F1 > 0.5: {len(results)}\")\n\nif results:\n    df = pd.DataFrame(results)\n    pareto = []\n    for _, r in df.iterrows():\n        dominated = False\n        for _, r2 in df.iterrows():\n            if (r2['f1'] > r['f1'] and r2['delta'] <= r['delta']) or (r2['f1'] >= r['f1'] and r2['delta'] < r['delta']):\n                dominated = True\n                break\n        if not dominated:\n            pareto.append(r)\n    \n    out = pd.DataFrame(pareto)\n    out['f1'] = out['f1'].round(5)\n    out['delta'] = out['delta'].round(5)\n    out['shape_weight'] = out['shape_weight'].round(1)\n    out = out[['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']]\n    out.to_csv('/root/pareto_frontier.csv', index=False)\n    print(f\"Pareto points: {len(out)}\")\n    print(out)\nelse:\n    pd.DataFrame(columns=['f1', 'delta', 'min_samples', 'epsilon', 'shape_weight']).to_csv('/root/pareto_frontier.csv', index=False)\n\nPYSCRIPT\n"]
