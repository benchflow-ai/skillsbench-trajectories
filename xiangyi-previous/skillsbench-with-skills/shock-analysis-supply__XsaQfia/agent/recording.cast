[364.401566, "i", "cat <<EOF > get_pwt.py\nimport asyncio\nfrom playwright.async_api import async_playwright\n\nasync def run():\n    async with async_playwright() as p:\n        browser = await p.chromium.launch()\n        page = await browser.new_page()\n        await page.goto('https://www.rug.nl/ggdc/productivity/pwt/pwt-releases/pwt1001')\n        links = await page.query_selector_all('a')\n        for link in links:\n            href = await link.get_attribute('href')\n            if href and '.xlsx' in href:\n                print(href)\n        await browser.close()\n\nasyncio.run(run())\nEOF\npython3 get_pwt.py\n"]
[364.407937, "o", "cat <<EOF > get_pwt.py\r\n\u001b[?2004l\r\u001b[?2004h> import asyncio\r\n\u001b[?2004l\r\u001b[?2004h> from playwright.async_api import async_playwright\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async def run():\r\n\u001b[?2004l\r\u001b[?2004h>     async with async_playwright() as p:\r\n\u001b[?2004l\r\u001b[?2004h>         browser = await p.chromium.launch()\r\n\u001b[?2004l\r\u001b[?2004h>         page = await browser.new_page()\r\n\u001b[?2004l\r\u001b[?2004h>         await page.goto('https://www.rug.nl/ggdc/productivity/pwt/pwt-releases/pwt1001')\r\n\u001b[?2004l\r\u001b[?2004h>         links = await page.query_selector_all('a')\r\n\u001b[?2004l\r\u001b[?2004h>         for link in links:\r\n\u001b[?2004l\r\u001b[?2004h>             href = await link.get_attribute('href')\r\n\u001b[?2004l\r\u001b[?2004h>             if href and '.xlsx' in href:\r\n\u001b[?2004l\r\u001b[?2004h> "]
