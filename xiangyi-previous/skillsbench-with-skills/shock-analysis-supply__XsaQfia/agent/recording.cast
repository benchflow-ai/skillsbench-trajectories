[888.642922, "i", "python3 -c \"import openpyxl; \nwb_pwt = openpyxl.load_workbook('pwt100.xlsx', data_only=True); \nws_pwt = wb_pwt['Data']; \nheaders = [cell.value for cell in ws_pwt[1]]; \nidx_cc = headers.index('countrycode'); \nidx_year = headers.index('year'); \nidx_rnna = headers.index('rnna'); \nidx_rgdpna = headers.index('rgdpna'); \ndata = []; \nfor row in ws_pwt.iter_rows(min_row=2):\n    if row[idx_cc].value == 'GEO':\n        data.append((row[idx_year].value, row[idx_rnna].value, row[idx_rgdpna].value))\n\nwb_test = openpyxl.load_workbook('test-supply.xlsx'); \nws_test = wb_test['PWT']; \nfor row_idx, (y, r, g) in enumerate(data, start=2):\n    ws_test.cell(row=row_idx, column=1).value = y\n    ws_test.cell(row=row_idx, column=2).value = r\n    ws_test.cell(row=row_idx, column=3).value = g\nwb_test.save('test-supply.xlsx')\n\"\n"]
