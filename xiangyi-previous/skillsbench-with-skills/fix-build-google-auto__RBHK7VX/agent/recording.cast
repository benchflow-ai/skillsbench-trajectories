[102.05325, "o", "on>\r\n </parent>\r\n <groupId>\r\n  com.google.auto\r\n </groupId>\r\n <artifactId>\r\n  auto-parent\r\n </artifactId>\r\n <packaging>\r\n  pom\r\n </packaging>\r\n <version>\r\n  4-SNAPSHOT\r\n </version>\r\n <name>\r\n  Auto (Parent)\r\n </name>\r\n <description>\r\n  A collection of code generators for Java.\r\n </description>\r\n <url>\r\n  https://github.com/google/auto\r\n </url>\r\n <properties>\r\n  <project.build.sourceEncoding>\r\n   UTF-8\r\n  </project.build.sourceEncoding>\r\n  <java.version>\r\n   1.6\r\n  </java.version>\r\n </properties>\r\n <scm>\r\n  <url>\r\n   http://github.com/google/auto\r\n  </url>\r\n  <connection>\r\n   scm:git:git://github.com/google/auto.git\r\n  </connection>\r\n  <developerConnection>\r\n   scm:git:ssh://git@github.com/google/auto.git\r\n  </developerConnection>\r\n  <tag>\r\n   HEAD\r\n  </tag>\r\n </scm>\r\n <issueManagement>\r\n  <system>\r\n   GitHub Issues\r\n  </system>\r\n  <url>\r\n   http://github.com/google/auto/issues\r\n  </url>\r\n </issueManagement>\r\n <licenses>\r\n  <license>\r\n   <name>\r\n    Apache 2.0\r\n   </name>\r\n   <url>\r\n    http://www.apache.org/l"]
[102.053263, "o", "icenses/LICENSE-2.0.txt\r\n   </url>\r\n  </license>\r\n </licenses>\r\n <organization>\r\n  <name>\r\n   Google, Inc.\r\n  </name>\r\n  <url>\r\n   http://www.google.com\r\n  </url>\r\n </organization>\r\n <build>\r\n  <plugins>\r\n   <plugin>\r\n    <groupId>\r\n     org.apache.maven.plugins\r\n    </groupId>\r\n    <artifactId>\r\n     maven-compiler-plugin\r\n    </artifactId>\r\n    <version>\r\n     3.1\r\n    </version>\r\n    <configuration>\r\n     <source>\r\n      ${java.version}\r\n     </source>"]
[102.053274, "o", "\r\n     <target>\r\n      ${java.version}\r\n     </target>\r\n     <compilerArgument>\r\n      -Xlint:all\r\n     </compilerArgument>\r\n     <showWarnings>\r\n      true\r\n     </showWarnings>\r\n     <showDeprecation>\r\n      true\r\n     </showDeprecation>\r\n    </configuration>\r\n   </plugin>\r\n   <plugin>"]
[102.053288, "o", "\r\n    <groupId>\r\n     org.apache.maven.plugins\r\n    </groupId>\r\n    <artifactId>\r\n     maven-checkstyle-plugin\r\n    </artifactId>\r\n    <version>\r\n     2.11\r\n    </version>\r\n    <configuration>\r\n     <consoleOutput>\r\n      true\r\n     </consoleOutput>\r\n     <configLocation>\r\n      checkstyle.xml\r\n     </configLocation>"]
[102.053305, "o", "\r\n     <failOnViolation>\r\n      false\r\n     </failOnViolation>\r\n    </configuration>\r\n   </plugin>\r\n  </plugins>\r\n  <pluginManagement>\r\n   <plugins>\r\n    <plugin>\r\n     <artifactId>\r\n      maven-invoker-plugin\r\n     </artifactId>\r\n     <version>\r\n      1.8\r\n     </version>\r\n    </plugin>\r\n   </plugins>\r\n  </pluginManagement>\r\n </build>\r\n <profiles>\r\n  <profile>"]
[102.053315, "o", "\r\n   <id>\r\n    default-profile\r\n   </id>\r\n   <activation>\r\n    <activeByDefault>\r\n     true\r\n    </activeByDefault>\r\n    <file>\r\n     <exists>\r\n      ${java.home}/../lib/tools.jar\r\n     </exists>\r\n    </file>\r\n   </activation>\r\n   <properties>\r\n    <toolsjar>\r\n     ${java.home}/../lib/tools.jar\r\n    </toolsjar>\r\n   </properties>\r\n  </profile>\r\n  <profile>\r\n   <id>\r\n    mac-profile\r\n   </id>\r\n   <activation>"]
[102.053329, "o", "\r\n    <activeByDefault>\r\n     false\r\n    </activeByDefault>\r\n    <file>\r\n     <exists>\r\n      ${java.home}/../Classes/classes.jar\r\n     </exists>\r\n    </file>\r\n   </activation>\r\n   <properties>\r\n    <toolsjar>\r\n     ${java.home}/../Classes/classes.jar\r\n    </toolsjar>\r\n   </properties>\r\n  </profile>\r\n </profiles>\r\n</project>"]
