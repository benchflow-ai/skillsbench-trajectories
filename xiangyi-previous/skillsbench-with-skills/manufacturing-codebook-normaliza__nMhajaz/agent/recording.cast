[161.843431, "o", "{\r\n  \"records\": [\r\n    {\r\n      \"record_id\": \"R0000001\",\r\n      \"product_id\": \"P3_RF\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E1\",\r\n      \"raw_reason_text\": \"治具/探针接触不良，重插后偶尔OK 浮高\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000001-S1\",\r\n          \"span_text\": \"治具/探针接触不良，重插后偶尔OK 浮高\",\r\n          \"pred_code\": \"P3_RF-TS-019\",\r\n          \"pred_label\": \"Fixture contact unstable (pogo pin / clamp)\",\r\n          \"confidence\": 0.4,\r\n          \"rationale\": \"Matched 2 keywords\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000002\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"FUNC\",\r\n      \"engineer_id\": \"E2\",\r\n      \"raw_reason_text\": \"静态电流偏高，疑似短路趋势/器件异常\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000002-S1\",\r\n          \"span_text\": \"静态电流偏高，疑似短路趋势/器件异常\",\r\n          \"pred_code\": \"P1_POWER-EL-037\",\r\n"]
