eer_id\": engineer_id,\r\n\u001b[?2004l\r\u001b[?2004h>             \"raw_reason_text\": raw_text,\r\n\u001b[?2004l\r\u001b[?2004h>             \"normalized\": []\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if not raw_text.strip():\r\n\u001b[?2004l\r\u001b[?2004h>             records.append(record)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         pred_code = \"UNKNOWN\"\r\n\u001b[?2004l\r\u001b[?2004h>         pred_label = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         confidence = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         rationale = \"No match found\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if product_id in codebooks:\r\n\u001b[?2004l\r\u001b[?2004h>             cb_records = codebooks[product_id]\r\n\u001b[?2004l\r\u001b[?2004h>             candidates = []\r\n\u001b[?2004l\r\u001b[?2004h>             raw_lower = raw_text.lower()\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             for cb_row in cb_records:\r\n\u001b[?2004l\r\u001b[?2004h>                 keywords = cb_row['keywords_list']\r\n\u001b[?2004l\r\u001b[?2004h>                 if not keywords:\r\n\u001b[?2004l\r\u001b[?2004h>                     continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 matches = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 for k in keywords:\r\n\u001b[?2004l\r\u001b[?2004h>                     if k in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h>                         matches += 1\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 if matches > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                     score = matches / len(keywords)\r\n\u001b[?2004l\r\u001b[?2004h>                     candidates.append({\r\n\u001b[?2004