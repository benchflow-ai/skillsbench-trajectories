[94.090859, "i", "cat << 'EOF' > /app/solution.py\nimport pandas as pd\nimport json\nimport glob\nimport os\n\ndef solve():\n    logs_path = '/app/data/test_center_logs.csv'\n    try:\n        df_logs = pd.read_csv(logs_path)\n    except Exception as e:\n        print(f\"Error reading logs: {e}\")\n        return\n\n    codebooks = {}\n    codebook_files = glob.glob('/app/data/codebook_*.csv')\n    for cb_file in codebook_files:\n        try:\n            df_cb = pd.read_csv(cb_file)\n            if 'product_id' in df_cb.columns and len(df_cb) > 0:\n                pid = df_cb['product_id'].iloc[0]\n                df_cb['keywords_list'] = df_cb['keywords_examples'].fillna('').apply(\n                    lambda x: [k.strip().lower() for k in str(x).split(',') if k.strip()]\n                )\n                codebooks[pid] = df_cb\n        except Exception as e:\n            print(f\"Error reading codebook {cb_file}: {e}\")\n\n    records = []\n    \n    for idx, row in df_logs.iterrows():\n        record_id = str(row['record_id'])\n        product_id = str(row['product_id'])\n        station = str(row['station'])\n        engineer_id = str(row['engineer_id'])\n        raw_text = str(row['raw_reason_text']) if not pd.isna(row['raw_reason_text']) else \"\"\n        \n        record = {\n            \"record_id\": record_id,\n            \"product_id\": product_id,\n            \"station\": station,\n            \"engineer_id\": engineer_id,\n            \"raw_reason_text\": raw_text,\n            \"normalized\": []\n        }\n        \n        if not raw_text.strip():\n            records.append(record)\n            continue\n            \n        pred_code = \"UNKNOWN\"\n        pred_label = \"\"\n        confidence = 0.0\n        rationale = \"No match found\"\n        \n        if product_id in codebooks:\n            df_cb = codebooks[product_id]\n            candidates = []\n            raw_lower = raw_text.lower()\n            \n            for i, cb_row in df_cb.iterrows():\n                keywords = cb_row['keywords_list']\n                if not keywords:\n                    continue\n                \n                matches = 0\n                for k in keywords:\n                    if k in raw_lower:\n                        matches += 1\n                \n                if matches > 0:\n                    # Calculate score. \n                    # We penalize if the keyword is very short (like 'c87') and might appear randomly?\n                    # No, keep it simple first.\n                    score = matches / len(keywords)\n                    candidates.append({\n                        \"row\": cb_row,\n                        \"score\": score,\n                        \"matches\": matches\n                    })\n            \n            if candidates:\n                candidates.sort(key=lambda x: x['score'], reverse=True)\n                best = candidates[0]\n                \n                # Thresholding\n                if best['score'] > 0:\n                    pred_code = best['row']['code']\n                    pred_label = best['row']['standard_label']\n                    confidence = round(best['score'], 4)\n                    rationale = f\"Matched {best['matches']} keywords\"\n        \n        segment = {\n            \"segment_id\": f\"{record_id}-S1\",\n            \"span_text\": raw_text,\n            \"pred_code\": pred_code,\n            \"pred_label\": pred_label,\n            \"confidence\": confidence,\n            \"rationale\": rationale\n        }\n        \n        record[\"normalized\"].append(segment)\n        records.append(record)\n\n    output = {\"records\": records}\n    \n    try:\n        with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\n            json.dump(output, f, ensure_ascii=False, indent=2)\n        print(\"Successfully wrote /app/output/solution.json\")\n    except Exception as e:\n        print(f\"Error writing output: {e}\")\n\nif __name__ == \"__main__\":\n    solve()\nEOF\n"]
