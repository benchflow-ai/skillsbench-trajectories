[64.228268, "i", "python3 - <<'PY'\nimport pdfplumber, re, pandas as pd, json\nfrom difflib import SequenceMatcher\n\nvendors=pd.read_excel('/root/vendors.xlsx')\npos=pd.read_csv('/root/purchase_orders.csv')\n\n# normalize vendor names\nvendors['name_norm']=vendors['name'].str.lower().str.strip()\n\npo_lookup={row['po_number']: row for _,row in pos.iterrows()}\n\nresults=[]\n\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for i,page in enumerate(pdf.pages, start=1):\n        text=page.extract_text() or ''\n        vendor_match=re.search(r'From:\\s*(.+)', text)\n        vendor_name=vendor_match.group(1).strip() if vendor_match else ''\n        amt_match=re.search(r'Total\\s*\\$([0-9,]+\\.?[0-9]*)', text)\n        amount=float(amt_match.group(1).replace(',','')) if amt_match else None\n        iban_match=re.search(r'IBAN:\\s*([A-Z0-9_]+)', text)\n        iban=iban_match.group(1).strip() if iban_match else ''\n        po_match=re.search(r'PO Number:\\s*(\\S+)', text)\n        po_number=po_match.group(1).strip() if po_match else None\n\n        # fuzzy match vendor\n        vendor_norm=vendor_name.lower().strip()\n        best_ratio=0\n        best_row=None\n        for _,row in vendors.iterrows():\n            ratio=SequenceMatcher(None, vendor_norm, row['name_norm']).ratio()\n            if ratio>best_ratio:\n                best_ratio=ratio\n                best_row=row\n        match_ok = best_ratio>=0.8\n\n        reason=None\n        if not match_ok:\n            reason='Unknown Vendor'\n        else:\n            # IBAN check\n            if iban!=str(best_row['iban']):\n                reason='IBAN Mismatch'\n            else:\n                # PO validity\n                if po_number is None or po_number not in po_lookup:\n                    reason='Invalid PO'\n                else:\n                    po=po_lookup[po_number]\n                    # amount mismatch\n                    if amount is not None and abs(float(po['amount'])-amount)>0.01:\n                        reason='Amount Mismatch'\n                    else:\n                        # vendor mismatch\n                        if str(po['vendor_id'])!=str(best_row['id']):\n                            reason='Vendor Mismatch'\n        if reason:\n            results.append({\n                'invoice_page_number': i,\n                'vendor_name': vendor_name,\n                'invoice_amount': amount,\n                'iban': iban,\n                'po_number': po_number if (po_number is not None and po_number in po_lookup) else None,\n                'reason': reason\n            })\n\nwith open('/root/fraud_report.json','w') as f:\n    json.dump(results,f,indent=2)\nprint('fraud count',len(results))\nprint(results[:5])\nPY\n"]
