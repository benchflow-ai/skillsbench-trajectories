[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> defects = pd.read_csv('/app/data/test_defects.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Load previous results
[?2004l[?2004h> with open('/app/output/q01.json', 'r') as f:
[?2004l[?2004h>     q01 = json.load(f)
[?2004l[?2004h> with open('/app/output/q02.json', 'r') as f:
[?2004l[?2004h>     q02 = json.load(f)
[?2004l[?2004h> with open('/app/output/q03.json', 'r') as f:
[?2004l[?2004h>     q03 = json.load(f)
[?2004l[?2004h> with open('/app/output/q04.json', 'r') as f:
[?2004l[?2004h>     q04 = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Question 5: Best Run Selection ===")
[?2004l[?2004h> 
[?2004l[?2004h> # Create compliance lookup
[?2004l[?2004h> violating_ramp = set(q01['violating_runs'])
[?2004l[?2004h> tal_status = {r['run_id']: r['status'] for r in q02}
[?2004l[?2004h> failing_peak = set(q03['failing_runs'])
[?2004l[?2004h> conveyor_meets = {r['run_id']: r['meets'] for r in q04}
[?2004l[?2004h> 
[?2004l[?2004h> # Get yield data
[?2004l[?2004h> yield_data = defects[defects['inspection_stage'] == 'SUMMARY'][['run_id', 'fp_yield_pct']].copy()
[?2004l[?2004h> yield_lookup = dict(zip(yield_data['run_id'], yield_data['fp_yield_pct']))
[?2004l[?2004h> 
[?2004l[?2004h> # Score each run
[?2004l[?2004h> run_scores = []
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in mes.iterrows():
[?2004l[?2004h>     run_id = row['run_id']
[?2004l[?2004h>     board_family = row['board_family']
[?2004l[?2004h>     
[?2004l[?2004h>     # Quality score (0-100 from yield)
[?2004l[?2004h>     quality_score = yield_lookup.get(run_id, 0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compliance penalties
[?2004l[?2004h>     compliance_penalty = 0
[?2004l[?2004h>     if run_id in violating_ramp:
[?2004l[?2004h>         compliance_penalty += 20
[?2004l[?2004h>     if tal_status.get(run_id) == 'non-compliant':
[?2004l[?2004h>         compliance_penalty += 20
[?2004l[?2004h>     if run_id in failing_peak:
[?2004l[?2004h>         compliance_penalty += 20
[?2004l[?2004h>     if not conveyor_meets.get(run_id, True):
[?2004l[?2004h>         compliance_penalty += 10
[?2004l[?2004h>     
[?2004l[?2004h>     # Efficiency score (normalized boards_per_min)
[?2004l[?2004h>     efficiency_score = float(row['boards_per_min']) * 10  # Scale up
[?2004l[?2004h>     
[?2004l[?2004h>     # Total score
[?2004l[?2004h>     total_score = quality_score + efficiency_score - compliance_penalty
[?2004l[?2004h>     
[?2004l[?2004h>     run_scores.append({
[?2004l[?2004h>         'run_id': run_id,
[?2004l[?2004h>         'board_family': board_family,
[?2004l[?2004h>         'quality_score': quality_score,
[?2004l[?2004h>         'efficiency_score': efficiency_score,
[?2004l[?2004h>         'compliance_penalty': compliance_penalty,
[?2004l[?2004h>         'total_score': total_score
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> run_scores_df = pd.DataFrame(run_scores)
[?2004l[?2004h> 
[?2004l[?2004h> # Select best run per board family
[?2004l[?2004h> q05_output = []
[?2004l[?2004h> 
[?2004l[?2004h> for board_family in sorted(mes['board_family'].unique()):
[?2004l[?2004h>     family_runs = run_scores_df[run_scores_df['board_family'] == board_family].copy()
[?2004l[?2004h>     family_runs = family_runs.sort_values('total_score', ascending=False)
[?2004l[?2004h>     
[?2004l[?2004h>     best_run_id = family_runs.iloc[0]['run_id']
[?2004l[?2004h>     runner_up_run_ids = family_runs.iloc[1:]['run_id'].tolist()
[?2004l[?2004h>     
[?2004l[?2004h>     q05_output.append({
[?2004l[?2004h>         'board_family': board_family,
[?2004l[?2004h>         'best_run_id': best_run_id,
[?2004l[?2004h>         'runner_up_run_ids': sorted(runner_up_run_ids)
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output/q05.json', 'w') as f:
[?2004l[?2004h>     json.dump(q05_output, f, indent=2)
