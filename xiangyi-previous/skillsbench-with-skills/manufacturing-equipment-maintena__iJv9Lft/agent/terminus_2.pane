[?2004l[?2004h> print("\n=== Question 1: Preheat Ramp Rates ===")
[?2004l[?2004h> 
[?2004l[?2004h> max_ramp_by_run = {}
[?2004l[?2004h> violating_runs = []
[?2004l[?2004h> 
[?2004l[?2004h> for run_id in sorted(mes_log['run_id'].unique()):
[?2004l[?2004h>     run_tc = tc_data[tc_data['run_id'] == run_id].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(run_tc) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter for preheat zone (100-150°C)
[?2004l[?2004h>     preheat_data = run_tc[(run_tc['temp_c'] >= PREHEAT_MIN_C) & 
[?2004l[?2004h>                           (run_tc['temp_c'] <= PREHEAT_MAX_C)].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(preheat_data) < 2:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     preheat_data = preheat_data.sort_values('time_s')
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate ramp rates between consecutive points
[?2004l[?2004h>     max_ramp = 0
[?2004l[?2004h>     tc_id = preheat_data['tc_id'].iloc[0]
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(1, len(preheat_data)):
[?2004l[?2004h>         dt = preheat_data.iloc[i]['time_s'] - preheat_data.iloc[i-1]['time_s']
[?2004l[?2004h>         dtemp = preheat_data.iloc[i]['temp_c'] - preheat_data.iloc[i-1]['temp_c']
[?2004l[?2004h>         
[?2004l[?2004h>         if dt > 0:
[?2004l[?2004h>             ramp_rate = dtemp / dt
[?2004l[?2004h>             max_ramp = max(max_ramp, ramp_rate)
[?2004l[?2004h>     
[?2004l[?2004h>     max_ramp = round(max_ramp, 2)
[?2004l[?2004h>     
[?2004l[?2004h>     max_ramp_by_run[run_id] = {
[?2004l[?2004h>         "tc_id": tc_id,
[?2004l[?2004h>         "max_preheat_ramp_c_per_s": max_ramp
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     if max_ramp > MAX_PREHEAT_RAMP_C_PER_S:
[?2004l[?2004h>         violating_runs.append(run_id)
[?2004l[?2004h> 
[?2004l[?2004h> q01_output = {
[?2004l[?2004h>     "ramp_rate_limit_c_per_s": MAX_PREHEAT_RAMP_C_PER_S,
[?2004l[?2004h>     "violating_runs": sorted(violating_runs),
[?2004l[?2004h>     "max_ramp_by_run": max_ramp_by_run
[?2004l[?2004h> }
[?2004l[?2004h> 
