[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> mes_log = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> thermocouples = pd.read_csv('/app/data/thermocouples.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Constants from handbook
[?2004l[?2004h> TAL_MIN_S = 30
[?2004l[?2004h> TAL_MAX_S = 60
[?2004l[?2004h> TC_LOCATION = 'largest_mass'
[?2004l[?2004h> 
[?2004l[?2004h> # Filter thermocouples for largest_mass only
[?2004l[?2004h> tc_data = thermocouples[thermocouples['tc_location'] == TC_LOCATION].copy()
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Question 2: Time Above Liquidus (Fixed) ===")
[?2004l[?2004h> 
[?2004l[?2004h> q02_output = []
[?2004l[?2004h> 
[?2004l[?2004h> for run_id in sorted(mes_log['run_id'].unique()):
[?2004l[?2004h>     # Get liquidus temperature for this run
[?2004l[?2004h>     run_info = mes_log[mes_log['run_id'] == run_id].iloc[0]
[?2004l[?2004h>     liquidus_c = float(run_info['solder_liquidus_c'])
[?2004l[?2004h>     
[?2004l[?2004h>     run_tc = tc_data[tc_data['run_id'] == run_id].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(run_tc) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     run_tc = run_tc.sort_values('time_s').reset_index(drop=True)
[?2004l[?2004h>     tc_id = str(run_tc['tc_id'].iloc[0])
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate TAL by summing time intervals where temp > liquidus
[?2004l[?2004h>     tal_s = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(run_tc) - 1):
[?2004l[?2004h>         temp_current = run_tc.loc[i, 'temp_c']
[?2004l[?2004h>         temp_next = run_tc.loc[i+1, 'temp_c']
[?2004l[?2004h>         time_current = run_tc.loc[i, 'time_s']
[?2004l[?2004h>         time_next = run_tc.loc[i+1, 'time_s']
[?2004l[?2004h>         
[?2004l[?2004h>         # If both points are above liquidus, add the interval
[?2004l[?2004h>         if temp_current > liquidus_c and temp_next > liquidus_c:
[?2004l[?2004h>             tal_s += (time_next - time_current)
[?2004l[?2004h>         # If one point is above and one below, estimate partial interval
[?2004l[?2004h>         elif temp_current > liquidus_c or temp_next > liquidus_c:
[?2004l[?2004h>             # Linear interpolation to find crossing point
[?2004l[?2004h>             if temp_current != temp_next:
[?2004l[?2004h>                 fraction_above = abs(max(temp_current, temp_next) - liquidus_c) / abs(temp_next - temp_current)
[?2004l[?2004h>                 tal_s += (time_next - time_current) * fraction_above
[?2004l[?2004h>     
[?2004l[?2004h>     tal_s = round(tal_s, 2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Determine compliance
[?2004l[?2004h>     if TAL_MIN_S <= tal_s <= TAL_MAX_S:
[?2004l[?2004h>         status = "compliant"
[?2004l[?2004h>     else:
[?2004l[?2004h>         status = "non-compliant"
[?2004l[?2004h>     
[?2004l[?2004h>     q02_output.append({
[?2004l[?2004h>         "run_id": run_id,
[?2004l[?2004h>         "tc_id": tc_id,
[?2004l[?2004h>         "tal_s": tal_s,
[?2004l[?2004h>         "required_min_tal_s": TAL_MIN_S,
[?2004l[?2004h>         "required_max_tal_s": TAL_MAX_S,
[?2004l[?2004h>         "status": status
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output/q02.json', 'w') as f:
[?2004l[?2004h>     json.dump(q02_output, f, indent=2)
[?2004l[?2004h> 
