[146.79827, "i", "cat > /tmp/analyze.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes_log = pd.read_csv('/app/data/mes_log.csv')\nthermocouples = pd.read_csv('/app/data/thermocouples.csv')\ntest_defects = pd.read_csv('/app/data/test_defects.csv')\n\nprint(\"Data loaded successfully\")\nprint(f\"MES log: {len(mes_log)} runs\")\nprint(f\"Thermocouples: {len(thermocouples)} records\")\nprint(f\"Test defects: {len(test_defects)} records\")\n\n# Check unique run_ids\nprint(f\"\\nUnique runs in MES: {sorted(mes_log['run_id'].unique())}\")\nprint(f\"Unique runs in TC: {sorted(thermocouples['run_id'].unique())}\")\n\n# Check tc_location values\nprint(f\"\\nTC locations: {thermocouples['tc_location'].unique()}\")\n\n# Check solder types and liquidus temps\nprint(f\"\\nSolder liquidus temps:\")\nprint(mes_log[['run_id', 'paste_type', 'solder_liquidus_c']].drop_duplicates())\nEOF\npython3 /tmp/analyze.py\n"]
