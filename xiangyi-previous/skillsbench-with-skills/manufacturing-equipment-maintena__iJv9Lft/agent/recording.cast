[458.889838, "o", "echo \"Q01: Preheat ramp rates\"\r\n\u001b[?2004l\rQ01: Preheat ramp rates\r\n"]
[458.88994, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
