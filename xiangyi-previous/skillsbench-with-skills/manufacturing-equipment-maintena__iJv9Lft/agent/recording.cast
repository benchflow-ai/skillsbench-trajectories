[167.395754, "o", "PREHEAT_MIN_C = 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.395911, "o", "PREHEAT_MAX_C = 150\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.395954, "o", "MAX_PREHEAT_RAMP_C_PER_S = 2.0\r\n\u001b[?2004l\r\u001b[?2004h> TAL_MIN_S = 30\r\n\u001b[?2004l\r\u001b[?2004h> TAL_MAX_S = 60\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396038, "o", "# Use largest_mass thermocouple as per handbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396101, "o", "TC_LOCATION = 'largest_mass'\r\n\u001b[?2004l\r"]
[167.396161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396244, "o", "# Filter thermocouples for largest_mass only\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.39636, "o", "tc_data = thermocouples[thermocouples['tc_location'] == TC_LOCATION].copy()\r\n\u001b[?2004l\r"]
[167.396487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.396593, "o", "\u001b[?2004h> print(f\"Processing {len(tc_data)} thermocouple records for {TC_LOCATION}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396688, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396754, "o", "# QUESTION 1: Maximum preheat ramp rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396907, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.396984, "o", "print(\"\\n=== Question 1: Preheat Ramp Rates ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397033, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397071, "o", "max_ramp_by_run = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397112, "o", "violating_runs = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.397156, "o", "\u001b[?2004h> "]
[167.397309, "o", "for run_id in sorted(mes_log['run_id'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397371, "o", "    run_tc = tc_data[tc_data['run_id'] == run_id].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397414, "o", "    if len(run_tc) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397454, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397552, "o", "    # Filter for preheat zone (100-150°C)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397651, "o", "    preheat_data = run_tc[(run_tc['temp_c'] >= PREHEAT_MIN_C) & \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.397778, "o", "                          (run_tc['temp_c'] <= PREHEAT_MAX_C)].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[167.397848, "o", "\u001b[?2004h>     if len(preheat_data) < 2:\r\n\u001b[?2004l\r"]
[167.397925, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[167.398005, "o", "\u001b[?2004h> "]
[167.398072, "o", "    preheat_data = preheat_data.sort_values('time_s')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398152, "o", "    # Calculate ramp rates between consecutive points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398217, "o", "    max_ramp = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398283, "o", "    tc_id = preheat_data['tc_id'].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398351, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398416, "o", "    for i in range(1, len(preheat_data)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398521, "o", "        dt = preheat_data.iloc[i]['time_s'] - preheat_data.iloc[i-1]['time_s']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398664, "o", "        dtemp = preheat_data.iloc[i]['temp_c'] - preheat_data.iloc[i-1]['temp_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398742, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398806, "o", "        if dt > 0:\r\n\u001b[?2004l\r\u001b[?2004h>             ramp_rate = dtemp / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.398894, "o", "            max_ramp = max(max_ramp, ramp_rate)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.39896, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399032, "o", "    max_ramp = round(max_ramp, 2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399112, "o", "    max_ramp_by_run[run_id] = {\r\n\u001b[?2004l\r"]
[167.399195, "o", "\u001b[?2004h>         \"tc_id\": tc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399242, "o", "        \"max_preheat_ramp_c_per_s\": max_ramp\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[167.399338, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[167.39939, "o", ">     if max_ramp > MAX_PREHEAT_RAMP_C_PER_S:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399487, "o", "        violating_runs.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399555, "o", "q01_output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399623, "o", "    \"ramp_rate_limit_c_per_s\": MAX_PREHEAT_RAMP_C_PER_S,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399699, "o", "    \"violating_runs\": sorted(violating_runs),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399771, "o", "    \"max_ramp_by_run\": max_ramp_by_run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.39982, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399901, "o", "with open('/app/output/q01.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.399971, "o", "    json.dump(q01_output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[167.400061, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[167.400131, "o", "print(f\"Found {len(violating_runs)} violating runs: {violating_runs[:5]}...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.400209, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOFPYTHON\r\n\u001b[?2004l\r"]
[167.401432, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
[167.401477, "o", "python3 /tmp/solution.py\r\n\u001b[?2004l\r"]
[167.906012, "o", "Processing 3130 thermocouple records for largest_mass\r\n\r\n=== Question 1: Preheat Ramp Rates ===\r\n"]
[168.014659, "o", "Found 3 violating runs: ['R0035', 'R0040', 'R0044']...\r\n"]
[168.071089, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
[184.203221, "i", "cat > /tmp/solution2.py << 'EOFPYTHON'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes_log = pd.read_csv('/app/data/mes_log.csv')\nthermocouples = pd.read_csv('/app/data/thermocouples.csv')\ntest_defects = pd.read_csv('/app/data/test_defects.csv')\n\n# Constants from handbook\nTAL_MIN_S = 30\nTAL_MAX_S = 60\nTC_LOCATION = 'largest_mass'\n\n# Filter thermocouples for largest_mass only\ntc_data = thermocouples[thermocouples['tc_location'] == TC_LOCATION].copy()\n\n# ============================================================================\n# QUESTION 2: Time Above Liquidus (TAL)\n# ============================================================================\nprint(\"\\n=== Question 2: Time Above Liquidus ===\")\n\nq02_output = []\n\nfor run_id in sorted(mes_log['run_id'].unique()):\n    # Get liquidus temperature for this run\n    run_info = mes_log[mes_log['run_id'] == run_id].iloc[0]\n    liquidus_c = run_info['solder_liquidus_c']\n    \n    run_tc = tc_data[tc_data['run_id'] == run_id].copy()\n    \n    if len(run_tc) == 0:\n        continue\n    \n    run_tc = run_tc.sort_values('time_s')\n    tc_id = run_tc['tc_id'].iloc[0]\n    \n    # Find time above liquidus\n    above_liquidus = run_tc[run_tc['temp_c'] > liquidus_c].copy()\n    \n    if len(above_liquidus) > 0:\n        # TAL is the time span when temp is above liquidus\n        tal_s = above_liquidus['time_s'].max() - above_liquidus['time_s'].min()\n    else:\n        tal_s = 0\n    \n    tal_s = round(tal_s, 2)\n    \n    # Determine compliance\n    if TAL_MIN_S <= tal_s <= TAL_MAX_S:\n        status = \"compliant\"\n    else:\n        status = \"non-compliant\"\n    \n    q02_output.append({\n        \"run_id\": run_id,\n        \"tc_id\": tc_id,\n        \"tal_s\": tal_s,\n        \"required_min_tal_s\": TAL_MIN_S,\n        \"required_max_tal_s\": TAL_MAX_S,\n        \"status\": status\n    })\n\nwith open('/app/output/q02.json', 'w') as f:\n    json.dump(q02_output, f, indent=2)\n\nprint(f\"Processed TAL for {len(q02_output)} runs\")\ncompliant = sum(1 for r in q02_output if r['status'] == 'compliant')\nprint(f\"Compliant: {compliant}, Non-compliant: {len(q02_output) - compliant}\")\n\nEOFPYTHON\npython3 /tmp/solution2.py\n"]
[184.203472, "o", "cat > /tmp/solution2.py << 'EOFPYTHON'\r\n\u001b[?2004l\r"]
