[359.681195, "i", "python3 << 'EOF'\nimport pandas as pd\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# Check board families\nprint(\"Board families:\")\nprint(sorted(mes['board_family'].unique()))\n\n# Check defect data structure\nprint(\"\\nDefect data sample:\")\nprint(defects[defects['inspection_stage'] == 'SUMMARY'].head())\n\n# Count runs per family\nprint(\"\\nRuns per board family:\")\nprint(mes.groupby('board_family')['run_id'].count().sort_index())\nEOF\n"]
[359.68145, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[359.681531, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.681588, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.681623, "o", "mes = pd.read_csv('/app/data/mes_log.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.681705, "o", "defects = pd.read_csv('/app/data/test_defects.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
