[408.691252, "i", "python3 << 'EOF'\nimport pandas as pd\n\n# Check a sample run's temperature profile\ntc = pd.read_csv('/app/data/thermocouples.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\nrun_id = 'R0001'\nrun_tc = tc[(tc['run_id'] == run_id) & (tc['tc_location'] == 'largest_mass')].sort_values('time_s')\nliquidus = mes[mes['run_id'] == run_id].iloc[0]['solder_liquidus_c']\n\nprint(f\"Run {run_id}, Liquidus: {liquidus}°C\")\nprint(\"\\nTemperature profile around liquidus:\")\nfor idx, row in run_tc.iterrows():\n    if row['temp_c'] > liquidus - 20 and row['temp_c'] < liquidus + 50:\n        print(f\"t={row['time_s']}s: {row['temp_c']:.2f}°C\")\nEOF\n"]
