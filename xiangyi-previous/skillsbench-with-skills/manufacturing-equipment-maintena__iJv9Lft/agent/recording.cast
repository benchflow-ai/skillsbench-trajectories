[459.079198, "o", "echo \"Q02: TAL (first 15 lines)\"\r\n\u001b[?2004l\r"]
[459.079341, "o", "Q02: TAL (first 15 lines)\r\n\u001b[?2004hroot@e00a671c414b:/app# "]
[459.079369, "o", "head -15 /app/output/q02.json\r\n\u001b[?2004l\r"]
[459.080277, "o", "[\r\n  {\r\n    \"run_id\": \"R0001\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 132.61,\r\n    \"required_min_tal_s\": 30,\r\n    \"required_max_tal_s\": 60,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0002\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 96.29,\r\n    \"required_min_tal_s\": 30,\r\n    \"required_max_tal_s\": 60,\r\n"]
[459.080429, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
