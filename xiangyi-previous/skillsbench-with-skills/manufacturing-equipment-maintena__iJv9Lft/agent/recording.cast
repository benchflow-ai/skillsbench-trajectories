[365.294594, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
[385.472561, "i", "cat > /tmp/solution5.py << 'EOFPYTHON'\nimport pandas as pd\nimport json\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# Load previous results\nwith open('/app/output/q01.json', 'r') as f:\n    q01 = json.load(f)\nwith open('/app/output/q02.json', 'r') as f:\n    q02 = json.load(f)\nwith open('/app/output/q03.json', 'r') as f:\n    q03 = json.load(f)\nwith open('/app/output/q04.json', 'r') as f:\n    q04 = json.load(f)\n\nprint(\"\\n=== Question 5: Best Run Selection ===\")\n\n# Create compliance lookup\nviolating_ramp = set(q01['violating_runs'])\ntal_status = {r['run_id']: r['status'] for r in q02}\nfailing_peak = set(q03['failing_runs'])\nconveyor_meets = {r['run_id']: r['meets'] for r in q04}\n\n# Get yield data\nyield_data = defects[defects['inspection_stage'] == 'SUMMARY'][['run_id', 'fp_yield_pct']].copy()\nyield_lookup = dict(zip(yield_data['run_id'], yield_data['fp_yield_pct']))\n\n# Score each run\nrun_scores = []\n\nfor idx, row in mes.iterrows():\n    run_id = row['run_id']\n    board_family = row['board_family']\n    \n    # Quality score (0-100 from yield)\n    quality_score = yield_lookup.get(run_id, 0)\n    \n    # Compliance penalties\n    compliance_penalty = 0\n    if run_id in violating_ramp:\n        compliance_penalty += 20\n    if tal_status.get(run_id) == 'non-compliant':\n        compliance_penalty += 20\n    if run_id in failing_peak:\n        compliance_penalty += 20\n    if not conveyor_meets.get(run_id, True):\n        compliance_penalty += 10\n    \n    # Efficiency score (normalized boards_per_min)\n    efficiency_score = float(row['boards_per_min']) * 10  # Scale up\n    \n    # Total score\n    total_score = quality_score + efficiency_score - compliance_penalty\n    \n    run_scores.append({\n        'run_id': run_id,\n        'board_family': board_family,\n        'quality_score': quality_score,\n        'efficiency_score': efficiency_score,\n        'compliance_penalty': compliance_penalty,\n        'total_score': total_score\n    })\n\nrun_scores_df = pd.DataFrame(run_scores)\n\n# Select best run per board family\nq05_output = []\n\nfor board_family in sorted(mes['board_family'].unique()):\n    family_runs = run_scores_df[run_scores_df['board_family'] == board_family].copy()\n    family_runs = family_runs.sort_values('total_score', ascending=False)\n    \n    best_run_id = family_runs.iloc[0]['run_id']\n    runner_up_run_ids = family_runs.iloc[1:]['run_id'].tolist()\n    \n    q05_output.append({\n        'board_family': board_family,\n        'best_run_id': best_run_id,\n        'runner_up_run_ids': sorted(runner_up_run_ids)\n    })\n\nwith open('/app/output/q05.json', 'w') as f:\n    json.dump(q05_output, f, indent=2)\n\nprint(f\"Selected best runs for {len(q05_output)} board families\")\nfor result in q05_output:\n    print(f\"{result['board_family']}: {result['best_run_id']} (+ {len(result['runner_up_run_ids'])} runners-up)\")\n\nEOFPYTHON\npython3 /tmp/solution5.py\n"]
[385.472805, "o", "cat > /tmp/solution5.py << 'EOFPYTHON'\r\n\u001b[?2004l\r"]
