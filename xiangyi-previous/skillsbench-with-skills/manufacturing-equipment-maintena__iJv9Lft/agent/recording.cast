[465.460082, "i", "echo \"=== Final Verification ===\"\necho \"Q01 Summary:\"\njq '.violating_runs | length' /app/output/q01.json\necho \"Q02 Summary:\"\njq '[.[] | select(.status == \"compliant\")] | length' /app/output/q02.json\necho \"Q03 Summary:\"\njq '.failing_runs | length' /app/output/q03.json\necho \"Q04 Summary:\"\njq '[.[] | select(.meets == true)] | length' /app/output/q04.json\necho \"Q05 Summary:\"\njq 'length' /app/output/q05.json\n"]
