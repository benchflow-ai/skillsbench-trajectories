[294.735172, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ntc = pd.read_csv('/app/data/thermocouples.csv')\n\n# Calculate oven length by oven model\noven_lengths = {}\n\nfor idx, row in mes.iterrows():\n    run_id = row['run_id']\n    oven_model = row['oven_model']\n    conveyor_speed_cm_min = row['conveyor_speed_cm_min']\n    \n    run_tc = tc[tc['run_id'] == run_id]\n    if len(run_tc) > 0:\n        thermal_dwell_s = run_tc['time_s'].max()\n        oven_length_cm = (conveyor_speed_cm_min / 60) * thermal_dwell_s\n        \n        if oven_model not in oven_lengths:\n            oven_lengths[oven_model] = []\n        oven_lengths[oven_model].append(oven_length_cm)\n\nprint(\"Average oven lengths by model:\")\nfor model, lengths in sorted(oven_lengths.items()):\n    avg_len = np.mean(lengths)\n    print(f\"{model}: {avg_len:.1f} cm (n={len(lengths)})\")\nEOF\n"]
