[167.39481, "i", "cat > /tmp/solution.py << 'EOFPYTHON'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes_log = pd.read_csv('/app/data/mes_log.csv')\nthermocouples = pd.read_csv('/app/data/thermocouples.csv')\ntest_defects = pd.read_csv('/app/data/test_defects.csv')\n\n# Constants from handbook\nPREHEAT_MIN_C = 100\nPREHEAT_MAX_C = 150\nMAX_PREHEAT_RAMP_C_PER_S = 2.0\nTAL_MIN_S = 30\nTAL_MAX_S = 60\n\n# Use largest_mass thermocouple as per handbook\nTC_LOCATION = 'largest_mass'\n\n# Filter thermocouples for largest_mass only\ntc_data = thermocouples[thermocouples['tc_location'] == TC_LOCATION].copy()\n\nprint(f\"Processing {len(tc_data)} thermocouple records for {TC_LOCATION}\")\n\n# ============================================================================\n# QUESTION 1: Maximum preheat ramp rate\n# ============================================================================\nprint(\"\\n=== Question 1: Preheat Ramp Rates ===\")\n\nmax_ramp_by_run = {}\nviolating_runs = []\n\nfor run_id in sorted(mes_log['run_id'].unique()):\n    run_tc = tc_data[tc_data['run_id'] == run_id].copy()\n    \n    if len(run_tc) == 0:\n        continue\n    \n    # Filter for preheat zone (100-150°C)\n    preheat_data = run_tc[(run_tc['temp_c'] >= PREHEAT_MIN_C) & \n                          (run_tc['temp_c'] <= PREHEAT_MAX_C)].copy()\n    \n    if len(preheat_data) < 2:\n        continue\n    \n    preheat_data = preheat_data.sort_values('time_s')\n    \n    # Calculate ramp rates between consecutive points\n    max_ramp = 0\n    tc_id = preheat_data['tc_id'].iloc[0]\n    \n    for i in range(1, len(preheat_data)):\n        dt = preheat_data.iloc[i]['time_s'] - preheat_data.iloc[i-1]['time_s']\n        dtemp = preheat_data.iloc[i]['temp_c'] - preheat_data.iloc[i-1]['temp_c']\n        \n        if dt > 0:\n            ramp_rate = dtemp / dt\n            max_ramp = max(max_ramp, ramp_rate)\n    \n    max_ramp = round(max_ramp, 2)\n    \n    max_ramp_by_run[run_id] = {\n        \"tc_id\": tc_id,\n        \"max_preheat_ramp_c_per_s\": max_ramp\n    }\n    \n    if max_ramp > MAX_PREHEAT_RAMP_C_PER_S:\n        violating_runs.append(run_id)\n\nq01_output = {\n    \"ramp_rate_limit_c_per_s\": MAX_PREHEAT_RAMP_C_PER_S,\n    \"violating_runs\": sorted(violating_runs),\n    \"max_ramp_by_run\": max_ramp_by_run\n}\n\nwith open('/app/output/q01.json', 'w') as f:\n    json.dump(q01_output, f, indent=2)\n\nprint(f\"Found {len(violating_runs)} violating runs: {violating_runs[:5]}...\")\n\nEOFPYTHON\npython3 /tmp/solution.py\n"]
[167.395109, "o", "cat > /tmp/solution.py << 'EOFPYTHON'\r\n\u001b[?2004l\r"]
