[78.832158, "i", "python3 << 'EOF'\n# Read the handbook text\nwith open('/tmp/handbook.txt', 'r') as f:\n    handbook = f.read()\n\n# Search for key terms\nprint(\"=== Searching for PREHEAT ===\")\nfor i, line in enumerate(handbook.split('\\n')):\n    if 'preheat' in line.lower() or 'pre-heat' in line.lower():\n        # Print context around the match\n        lines = handbook.split('\\n')\n        start = max(0, i-2)\n        end = min(len(lines), i+3)\n        print(f\"\\nLine {i}: {' '.join(lines[start:end])}\")\n        if i > 100:  # Limit output\n            break\nEOF\n"]
