[435.741033, "o", "mes_log = pd.read_csv('/app/data/mes_log.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.741087, "o", "> "]
[435.741136, "o", "thermocouples = pd.read_csv('/app/data/thermocouples.csv')\r\n\u001b[?2004l\r"]
[435.741186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.741215, "o", "# Constants from handbook\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.741243, "o", "> "]
[435.74127, "o", "TAL_MIN_S = 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.741399, "o", "TAL_MAX_S = 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.741463, "o", "TC_LOCATION = 'largest_mass'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.741491, "o", "# Filter thermocouples for largest_mass only\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.741619, "o", "tc_data = thermocouples[thermocouples['tc_location'] == TC_LOCATION].copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[435.741673, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[435.741733, "o", "print(\"\\n=== Question 2: Time Above Liquidus (Fixed) ===\")\r\n\u001b[?2004l\r"]
[435.741791, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[435.741848, "o", "> q02_output = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.741888, "o", "\u001b[?2004h> "]
[435.741935, "o", "for run_id in sorted(mes_log['run_id'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.741984, "o", "> "]
[435.742038, "o", "    # Get liquidus temperature for this run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.742108, "o", "    run_info = mes_log[mes_log['run_id'] == run_id].iloc[0]\r\n\u001b[?2004l\r"]
[435.742161, "o", "\u001b[?2004h> "]
[435.742208, "o", "    liquidus_c = float(run_info['solder_liquidus_c'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.742252, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.742337, "o", "    run_tc = tc_data[tc_data['run_id'] == run_id].copy()\r\n\u001b[?2004l\r"]
[435.742363, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[435.742411, "o", "\u001b[?2004h> "]
[435.742475, "o", "    if len(run_tc) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.742516, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.742619, "o", "    run_tc = run_tc.sort_values('time_s').reset_index(drop=True)\r\n\u001b[?2004l\r"]
[435.742669, "o", "\u001b[?2004h> "]
[435.742722, "o", "    tc_id = str(run_tc['tc_id'].iloc[0])\r\n\u001b[?2004l\r"]
[435.742777, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.742847, "o", "    # Calculate TAL by summing time intervals where temp > liquidus\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.742871, "o", ">     tal_s = 0.0\r\n\u001b[?2004l\r"]
[435.742896, "o", "\u001b[?2004h> "]
[435.742946, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743026, "o", "    for i in range(len(run_tc) - 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743073, "o", "        temp_current = run_tc.loc[i, 'temp_c']\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.743127, "o", "> "]
[435.743169, "o", "        temp_next = run_tc.loc[i+1, 'temp_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743248, "o", "        time_current = run_tc.loc[i, 'time_s']\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.743306, "o", "> "]
[435.743362, "o", "        time_next = run_tc.loc[i+1, 'time_s']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743416, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743499, "o", "        # If both points are above liquidus, add the interval\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743628, "o", "        if temp_current > liquidus_c and temp_next > liquidus_c:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.743686, "o", "            tal_s += (time_next - time_current)\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.743736, "o", "> "]
[435.743803, "o", "        # If one point is above and one below, estimate partial interval\r\n\u001b[?2004l\r"]
[435.743866, "o", "\u001b[?2004h> "]
[435.743921, "o", "        elif temp_current > liquidus_c or temp_next > liquidus_c:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.744025, "o", "            # Linear interpolation to find crossing point\r\n\u001b[?2004l\r"]
[435.744095, "o", "\u001b[?2004h> "]
[435.744153, "o", "            if temp_current != temp_next:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.744285, "o", "                fraction_above = abs(max(temp_current, temp_next) - liquidus_c) / abs(temp_next - temp_current)\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.744351, "o", "> "]
[435.744401, "o", "                tal_s += (time_next - time_current) * fraction_above\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.744427, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[435.744483, "o", "> "]
[435.744525, "o", "    tal_s = round(tal_s, 2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[435.744561, "o", "> "]
[435.744695, "o", "    # Determine compliance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.74477, "o", "    if TAL_MIN_S <= tal_s <= TAL_MAX_S:\r\n\u001b[?2004l\r\u001b[?2004h>         status = \"compliant\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[435.74484, "o", "\u001b[?2004h> "]
[435.744874, "o", "        status = \"non-compliant\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[435.7449, "o", "> "]
[435.744984, "o", "    q02_output.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.745043, "o", "        \"run_id\": run_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.745081, "o", "        \"tc_id\": tc_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.745113, "o", "> "]
[435.745149, "o", "        \"tal_s\": tal_s,\r\n\u001b[?2004l\r"]
[435.745175, "o", "\u001b[?2004h> "]
[435.745266, "o", "        \"required_min_tal_s\": TAL_MIN_S,\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.745294, "o", "> "]
[435.745374, "o", "        \"required_max_tal_s\": TAL_MAX_S,\r\n\u001b[?2004l\r"]
[435.7454, "o", "\u001b[?2004h> "]
[435.745444, "o", "        \"status\": status\r\n\u001b[?2004l\r"]
[435.745467, "o", "\u001b[?2004h> "]
[435.745489, "o", "    })\r\n\u001b[?2004l\r"]
[435.745513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.745537, "o", "\u001b[?2004h> "]
[435.745638, "o", "with open('/app/output/q02.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.745662, "o", "> "]
[435.745731, "o", "    json.dump(q02_output, f, indent=2)\r\n\u001b[?2004l\r"]
[435.745756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[435.74578, "o", "\u001b[?2004h> "]
[435.745888, "o", "print(f\"Processed TAL for {len(q02_output)} runs\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.745913, "o", "> "]
[435.746048, "o", "compliant = sum(1 for r in q02_output if r['status'] == 'compliant')\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.746076, "o", "> "]
[435.746248, "o", "print(f\"Compliant: {compliant}, Non-compliant: {len(q02_output) - compliant}\")\r\n\u001b[?2004l\r"]
[435.746284, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.746309, "o", "# Show some examples\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.746334, "o", "> "]
[435.746481, "o", "print(\"\\nSample TAL values:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.746537, "o", "for r in q02_output[:5]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.746641, "o", "    print(f\"{r['run_id']}: {r['tal_s']}s - {r['status']}\")"]
[435.752874, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOFPYTHON\r\n\u001b[?2004l\r\u001b[?2004hroot@e00a671c414b:/app# python3 /tmp/solution2_fixed.py\r\n\u001b[?2004l\r"]
[436.438291, "o", "\r\n=== Question 2: Time Above Liquidus (Fixed) ===\r\n"]
[436.578341, "o", "Processed TAL for 60 runs\r\nCompliant: 9, Non-compliant: 51\r\n\r\nSample TAL values:\r\nR0001: 132.61s - non-compliant\r\nR0002: 96.29s - non-compliant\r\nR0003: 81.55s - non-compliant\r\nR0004: 49.76s - compliant\r\nR0005: 0.0s - non-compliant\r\n"]
[436.647138, "o", "\u001b[?2004hroot@e00a671c414b:/app# "]
[449.069004, "i", "python3 << 'EOF'\nimport pandas as pd\n\ntc = pd.read_csv('/app/data/thermocouples.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\nrun_id = 'R0005'\nrun_tc = tc[(tc['run_id'] == run_id) & (tc['tc_location'] == 'largest_mass')].sort_values('time_s')\nliquidus = mes[mes['run_id'] == run_id].iloc[0]['solder_liquidus_c']\n\nprint(f\"Run {run_id}, Liquidus: {liquidus}°C\")\nprint(f\"Max temp reached: {run_tc['temp_c'].max():.2f}°C\")\nprint(f\"Temps above liquidus: {len(run_tc[run_tc['temp_c'] > liquidus])}\")\n\n# Check a few more SAC runs\nfor rid in ['R0006', 'R0008', 'R0009']:\n    run_tc = tc[(tc['run_id'] == rid) & (tc['tc_location'] == 'largest_mass')]\n    liq = mes[mes['run_id'] == rid].iloc[0]['solder_liquidus_c']\n    max_temp = run_tc['temp_c'].max() if len(run_tc) > 0 else 0\n    print(f\"{rid}: liquidus={liq}°C, max={max_temp:.2f}°C\")\nEOF\n"]
[449.069229, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[449.069308, "o", "\u001b[?2004h> "]
[449.069356, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.06942, "o", "tc = pd.read_csv('/app/data/thermocouples.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.069492, "o", "mes = pd.read_csv('/app/data/mes_log.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.069536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.069584, "o", "run_id = 'R0005'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.069725, "o", "run_tc = tc[(tc['run_id'] == run_id) & (tc['tc_location'] == 'largest_mass')].sort_values('time_s')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.069834, "o", "liquidus = mes[mes['run_id'] == run_id].iloc[0]['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h"]
[449.069856, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070035, "o", "print(f\"Run {run_id}, Liquidus: {liquidus}°C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070092, "o", "print(f\"Max temp reached: {run_tc['temp_c'].max():.2f}°C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.07027, "o", "print(f\"Temps above liquidus: {len(run_tc[run_tc['temp_c'] > liquidus])}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070321, "o", "# Check a few more SAC runs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070545, "o", "for rid in ['R0006', 'R0008', 'R0009']:\r\n\u001b[?2004l\r\u001b[?2004h>     run_tc = tc[(tc['run_id'] == rid) & (tc['tc_location'] == 'largest_mass')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070627, "o", "    liq = mes[mes['run_id'] == rid].iloc[0]['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070745, "o", "    max_temp = run_tc['temp_c'].max() if len(run_tc) > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070846, "o", "    print(f\"{rid}: liquidus={liq}°C, max={max_temp:.2f}°C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.070893, "o", "EOF\r\n\u001b[?2004l\r"]
[449.677834, "o", "Run R0005, Liquidus: 217°C\r\n"]
[449.677895, "o", "Max temp reached: 213.00°C\r\n"]
[449.678247, "o", "Temps above liquidus: 0\r\n"]
[449.681255, "o", "R0006: liquidus=217°C, max=409.45°C\r\n"]
[449.684249, "o", "R0008: liquidus=217°C, max=219.62°C\r\n"]
[449.687074, "o", "R0009: liquidus=217°C, max=227.39°C\r\n"]
