[459.223245, "o", "echo \"Q03: Peak temps (first 15 lines)\"\r\n\u001b[?2004l\r"]
[459.223312, "o", "Q03: Peak temps (first 15 lines)\r\n\u001b[?2004h"]
[459.223353, "o", "root@e00a671c414b:/app# "]
