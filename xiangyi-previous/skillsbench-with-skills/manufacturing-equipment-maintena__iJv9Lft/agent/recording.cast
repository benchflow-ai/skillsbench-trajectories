[283.3359, "i", "python3 << 'EOF'\nimport pandas as pd\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ntc = pd.read_csv('/app/data/thermocouples.csv')\n\n# Analyze relationship for a few runs\nfor run_id in ['R0001', 'R0002', 'R0003', 'R0004', 'R0005']:\n    run_mes = mes[mes['run_id'] == run_id].iloc[0]\n    run_tc = tc[tc['run_id'] == run_id]\n    \n    if len(run_tc) > 0:\n        thermal_dwell_s = run_tc['time_s'].max()\n        conveyor_speed_cm_min = run_mes['conveyor_speed_cm_min']\n        conveyor_speed_cm_s = conveyor_speed_cm_min / 60\n        oven_model = run_mes['oven_model']\n        \n        # Calculate implied oven length\n        oven_length_cm = conveyor_speed_cm_s * thermal_dwell_s\n        \n        print(f\"{run_id} ({oven_model}): dwell={thermal_dwell_s}s, speed={conveyor_speed_cm_min:.1f}cm/min, oven_len={oven_length_cm:.1f}cm\")\nEOF\n"]
