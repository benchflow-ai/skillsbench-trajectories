[478.61175, "i", "python3 << 'EOF'\nimport json\n\nprint(\"=== Final Verification ===\")\n\n# Q01\nwith open('/app/output/q01.json', 'r') as f:\n    q01 = json.load(f)\nprint(f\"\\nQ01 - Preheat Ramp Rates:\")\nprint(f\"  Ramp rate limit: {q01['ramp_rate_limit_c_per_s']} °C/s\")\nprint(f\"  Violating runs: {len(q01['violating_runs'])} - {q01['violating_runs']}\")\nprint(f\"  Total runs analyzed: {len(q01['max_ramp_by_run'])}\")\n\n# Q02\nwith open('/app/output/q02.json', 'r') as f:\n    q02 = json.load(f)\ncompliant = [r for r in q02 if r['status'] == 'compliant']\nprint(f\"\\nQ02 - Time Above Liquidus:\")\nprint(f\"  TAL requirement: {q02[0]['required_min_tal_s']}-{q02[0]['required_max_tal_s']}s\")\nprint(f\"  Compliant runs: {len(compliant)}\")\nprint(f\"  Non-compliant runs: {len(q02) - len(compliant)}\")\nprint(f\"  Total runs: {len(q02)}\")\n\n# Q03\nwith open('/app/output/q03.json', 'r') as f:\n    q03 = json.load(f)\nprint(f\"\\nQ03 - Peak Temperature:\")\nprint(f\"  Failing runs: {len(q03['failing_runs'])}\")\nprint(f\"  Total runs: {len(q03['min_peak_by_run'])}\")\n\n# Q04\nwith open('/app/output/q04.json', 'r') as f:\n    q04 = json.load(f)\nmeets = [r for r in q04 if r['meets']]\nprint(f\"\\nQ04 - Conveyor Speed:\")\nprint(f\"  Meets requirement: {len(meets)}\")\nprint(f\"  Does not meet: {len(q04) - len(meets)}\")\nprint(f\"  Total runs: {len(q04)}\")\n\n# Q05\nwith open('/app/output/q05.json', 'r') as f:\n    q05 = json.load(f)\nprint(f\"\\nQ05 - Best Runs per Board Family:\")\nfor family in q05:\n    print(f\"  {family['board_family']}: {family['best_run_id']} (+ {len(family['runner_up_run_ids'])} runners-up)\")\n\nprint(\"\\n=== All outputs generated successfully ===\")\nEOF\n"]
