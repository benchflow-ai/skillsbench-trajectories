[69.278492, "i", "python3 << 'EOF'\nimport pypdf\n\n# Extract text from handbook\nwith open('/app/data/handbook.pdf', 'rb') as f:\n    reader = pypdf.PdfReader(f)\n    text = ''\n    for page in reader.pages:\n        text += page.extract_text() + '\\n'\n\n# Save to a text file for easier analysis\nwith open('/tmp/handbook.txt', 'w') as f:\n    f.write(text)\n\nprint(f\"Extracted {len(reader.pages)} pages\")\nprint(\"First 2000 characters:\")\nprint(text[:2000])\nEOF\n"]
