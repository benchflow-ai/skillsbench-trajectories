[489.305001, "i", "cat > simulation.py <<'EOF'\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\n\ndef load_yaml(path):\n    with open(path, 'r') as f:\n        return yaml.safe_load(f)\n\n\ndef format_value(val):\n    if val is None:\n        return ''\n    if isinstance(val, (int, float)):\n        return round(val, 4)\n    return val\n\n\ndef main():\n    config = load_yaml('vehicle_params.yaml')\n    tuning = load_yaml('tuning_results.yaml')\n    # override PID gains with tuned values\n    config['pid_speed'] = tuning['pid_speed']\n    config['pid_distance'] = tuning['pid_distance']\n\n    acc = AdaptiveCruiseControl(config)\n    dt = config['simulation']['dt']\n\n    # Read sensor data\n    with open('sensor_data.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        data = list(reader)\n\n    # Initialize states\n    ego_speed = 0.0\n    ego_pos = 0.0\n    lead_pos = None\n\n    results = []\n\n    for row in data:\n        time = float(row['time'])\n        lead_speed = row['lead_speed']\n        distance_meas = row['distance']\n\n        lead_speed = float(lead_speed) if lead_speed != '' else None\n        distance_meas = float(distance_meas) if distance_meas != '' else None\n\n        # Handle lead appearance/disappearance\n        if lead_speed is None:\n            lead_pos = None\n        else:\n            if lead_pos is None:\n                # initialize lead position using measured distance\n                if distance_meas is None:\n                    distance_meas = config['acc_settings']['min_distance']\n                lead_pos = ego_pos + distance_meas\n\n        # Compute current distance\n        distance = None\n        if lead_pos is not None:\n            distance = lead_pos - ego_pos\n\n        # Compute control\n        accel_cmd, mode, distance_error = acc.compute(ego_speed, lead_speed, distance, dt)\n\n        # Compute TTC for reporting\n        ttc = None\n        if lead_speed is not None and distance is not None and ego_speed > lead_speed:\n            rel_speed = ego_speed - lead_speed\n            ttc = distance / max(rel_speed, 1e-5)\n\n        # Store results at current time\n        results.append({\n            'time': time,\n            'ego_speed': ego_speed,\n            'acceleration_cmd': accel_cmd,\n            'mode': mode,\n            'distance_error': distance_error,\n            'distance': distance,\n            'ttc': ttc\n        })\n\n        # Update vehicle states for next timestep\n        ego_speed = max(0.0, ego_speed + accel_cmd * dt)\n        ego_pos += ego_speed * dt\n        if lead_pos is not None and lead_speed is not None:\n            lead_pos += lead_speed * dt\n\n    # Write simulation results\n    with open('simulation_results.csv', 'w', newline='') as f:\n        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 'distance_error', 'distance', 'ttc']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        for row in results:\n            writer.writerow({k: format_value(row[k]) for k in fieldnames})\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
