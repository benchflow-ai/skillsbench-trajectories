[1233.887403, "o", "\u001b[?2004h> pid_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1233.887447, "o", ">   kp: 0.6\r\n\u001b[?2004l\r\u001b[?2004h>   ki: 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1233.887503, "o", "  kd: 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
