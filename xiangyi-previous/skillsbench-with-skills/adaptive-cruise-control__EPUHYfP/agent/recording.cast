[922.030214, "o", "\u001b[?2004h> "]
[922.030381, "o", "rt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.030513, "o", "rise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.030585, "o", "> "]
[922.030707, "o", "overshoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.03076, "o", "> "]
[922.030816, "o", "ss = cruise[cruise['time'] >= 25]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.030948, "o", "ss_error = (ss['ego_speed'] - set_speed).abs().mean()\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.031, "o", "> "]
[922.031043, "o", "follow = df[df['mode'] == 'follow']\r\n\u001b[?2004l\r"]
[922.031092, "o", "\u001b[?2004h> "]
[922.03117, "o", "min_distance = df['distance'].min()\r\n\u001b[?2004l\r"]
[922.031227, "o", "\u001b[?2004h> "]
[922.031283, "o", "follow_end = follow[follow['time'] >= 125]\r\n\u001b[?2004l\r"]
[922.031331, "o", "\u001b[?2004h> "]
[922.031497, "o", "dist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.03155, "o", "> "]
[922.031599, "o", "print(\"rise_time\", rise_time)\r\n\u001b[?2004l\r\u001b[?2004h> "]
