[1134.310703, "o", "rt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.310822, "o", "rise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.310974, "o", "overshoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.311041, "o", "ss = cruise[cruise['time'] >= 25]\r\n\u001b[?2004l\r"]
[1134.311094, "o", "\u001b[?2004h> "]
[1134.311195, "o", "ss_error = (ss['ego_speed'] - set_speed).abs().mean()\r\n\u001b[?2004l\r"]
[1134.311222, "o", "\u001b[?2004h> "]
[1134.31131, "o", "follow = df[df['mode'] == 'follow']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.3114, "o", "min_distance = df['distance'].min()\r\n\u001b[?2004l\r"]
[1134.311454, "o", "\u001b[?2004h> "]
[1134.311509, "o", "follow_end = follow[follow['time'] >= 125]\r\n\u001b[?2004l\r"]
[1134.311539, "o", "\u001b[?2004h> "]
[1134.311763, "o", "dist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.311859, "o", "print(\"rise_time\", rise_time)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1134.311913, "o", "print(\"overshoot\", overshoot)\r\n\u001b[?2004l\r\u001b[?2004h> "]
