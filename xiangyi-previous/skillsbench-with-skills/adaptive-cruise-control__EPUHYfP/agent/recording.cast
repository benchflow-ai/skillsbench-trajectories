[180.926795, "o", "    acc = AdaptiveCruiseControl(config)\r\n\u001b[?2004l\r"]
[180.926832, "o", "\u001b[?2004h> "]
[180.926913, "o", "    dt = config['simulation']['dt']\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.926972, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.927022, "o", "    # Read sensor data\r\n\u001b[?2004l\r"]
[180.927057, "o", "\u001b[?2004h> "]
[180.927165, "o", "    with open('sensor_data.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.927203, "o", "> "]
[180.927277, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[180.92734, "o", "\u001b[?2004h> "]
[180.927405, "o", "        data = list(reader)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.92747, "o", "> "]
[180.927534, "o", "    # Initialize states\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.92761, "o", "    ego_speed = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.927675, "o", "    ego_pos = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.927742, "o", "    lead_pos = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.927818, "o", ">     results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.927883, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.927947, "o", "    for row in data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928039, "o", "        time = float(row['time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928178, "o", "        lead_speed = row['lead_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928286, "o", "        distance_meas = row['distance']\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.928357, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928527, "o", "        lead_speed = float(lead_speed) if lead_speed != '' else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928735, "o", "        distance_meas = float(distance_meas) if distance_meas != '' else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928808, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.928899, "o", "        # Handle lead appearance/disappearance\r\n\u001b[?2004l\r"]
[180.928937, "o", "\u001b[?2004h> "]
[180.929032, "o", "        if lead_speed is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.929109, "o", "            lead_pos = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.929143, "o", "> "]
[180.929176, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.929213, "o", "> "]
[180.929313, "o", "            if lead_pos is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.92947, "o", "                # initialize lead position using measured distance\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.929496, "o", "> "]
[180.929601, "o", "                if distance_meas is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.929636, "o", "> "]
[180.929806, "o", "                    distance_meas = config['acc_settings']['min_distance']\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.929843, "o", "> "]
[180.929961, "o", "                lead_pos = ego_pos + distance_meas\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.930035, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.930073, "o", "> "]
[180.930106, "o", "        # Compute current distance\r\n\u001b[?2004l\r"]
[180.93014, "o", "\u001b[?2004h> "]
[180.930246, "o", "        distance = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.930304, "o", "        if lead_pos is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.930341, "o", "> "]
[180.930439, "o", "            distance = lead_pos - ego_pos\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.930466, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.930599, "o", "        # Compute control\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.930799, "o", "        accel_cmd, mode, distance_error = acc.compute(ego_speed, lead_speed, distance, dt)\r\n\u001b[?2004l\r"]
[180.930836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.930867, "o", "\u001b[?2004h> "]
[180.930951, "o", "        # Compute TTC for reporting\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.930989, "o", "> "]
[180.931023, "o", "        ttc = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931056, "o", "> "]
[180.931252, "o", "        if lead_speed is not None and distance is not None and ego_speed > lead_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931288, "o", "> "]
[180.931386, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931418, "o", "> "]
[180.931523, "o", "            ttc = distance / max(rel_speed, 1e-5)\r\n\u001b[?2004l\r"]
[180.931556, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931587, "o", "> "]
[180.931675, "o", "        # Store results at current time\r\n\u001b[?2004l\r"]
[180.931711, "o", "\u001b[?2004h> "]
[180.931768, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931803, "o", "> "]
[180.931857, "o", "            'time': time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.931891, "o", "> "]
[180.93197, "o", "            'ego_speed': ego_speed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932003, "o", "> "]
[180.932103, "o", "            'acceleration_cmd': accel_cmd,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932135, "o", "> "]
[180.932197, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932233, "o", "> "]
[180.932325, "o", "            'distance_error': distance_error,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932362, "o", "> "]
[180.932431, "o", "            'distance': distance,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932463, "o", "> "]
[180.932522, "o", "            'ttc': ttc\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.932598, "o", "> "]
[180.932636, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.932741, "o", "        # Update vehicle states for next timestep\r\n\u001b[?2004l\r"]
[180.932778, "o", "\u001b[?2004h> "]
[180.932902, "o", "        ego_speed = max(0.0, ego_speed + accel_cmd * dt)\r\n\u001b[?2004l\r"]
[180.932937, "o", "\u001b[?2004h> "]
[180.933013, "o", "        ego_pos += ego_speed * dt\r\n\u001b[?2004l\r"]
[180.933049, "o", "\u001b[?2004h> "]
[180.933183, "o", "        if lead_pos is not None and lead_speed is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.933218, "o", "> "]
[180.933303, "o", "            lead_pos += lead_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.93334, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.933372, "o", "> "]
[180.933472, "o", "    # Write simulation results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.933615, "o", "    with open('simulation_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.933652, "o", "> "]
[180.933902, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.934061, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.934094, "o", "> "]
[180.934168, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.93426, "o", "        for row in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.934467, "o", "            writer.writerow({k: format_value(row[k]) for k in fieldnames})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.934504, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.934614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.93468, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.934736, "o", "> EOF\r\n\u001b[?2004l\r"]
[180.936021, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
[181.080786, "i", "python3 simulation.py\n"]
[181.081055, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[181.131067, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
[192.96763, "i", "python3 - <<'EOF'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('simulation_results.csv')\n\n# speed metrics for cruise phase (before lead appears at 30s)\ncruise = df[df['time'] < 30]\nset_speed = 30.0\n# rise time: time to reach 90% of set speed\nrt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\nrise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\n# overshoot\novershoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\n# steady-state error: last 5s before 30s\nss = cruise[cruise['time'] >= 25]\nss_error = (ss['ego_speed'] - set_speed).abs().mean()\n\n# distance metrics during follow (lead present)\nfollow = df[df['mode'] == 'follow']\nmin_distance = df['distance'].min()\n# steady-state distance error last 5s of follow period\nfollow_end = follow[follow['time'] >= 125]\ndist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\n\nprint(\"rise_time\", rise_time)\nprint(\"overshoot\", overshoot)\nprint(\"ss_error\", ss_error)\nprint(\"min_distance\", min_distance)\nprint(\"dist_ss_error\", dist_ss_error)\nEOF\n"]
