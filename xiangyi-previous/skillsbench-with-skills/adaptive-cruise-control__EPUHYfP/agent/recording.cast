[601.278209, "o", "\u001b[?2004h> "]
[601.278258, "o", "    def compute(self, ego_speed, lead_speed, distance, dt):\r\n\u001b[?2004l\r"]
[601.278298, "o", "\u001b[?2004h> "]
[601.278339, "o", "        # Determine if lead vehicle is present\r\n\u001b[?2004l\r"]
[601.27838, "o", "\u001b[?2004h> "]
[601.278419, "o", "        if lead_speed is None or distance is None:\r\n\u001b[?2004l\r"]
[601.278459, "o", "\u001b[?2004h> "]
[601.278497, "o", "            mode = 'cruise'\r\n\u001b[?2004l\r"]
[601.278516, "o", "\u001b[?2004h> "]
[601.27862, "o", "            speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r"]
[601.278641, "o", "\u001b[?2004h> "]
[601.278784, "o", "            accel_cmd = self.pid_speed.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.27886, "o", "            distance_error = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.278884, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.278976, "o", "            # Calculate time to collision\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.279049, "o", "> "]
[601.279075, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.279169, "o", "            if rel_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.279239, "o", "                ttc = distance / max(rel_speed, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.279261, "o", ">             else:"]
[601.279276, "o", "\r\n\u001b[?2004l\r"]
[601.279294, "o", "\u001b[?2004h> "]
[601.279419, "o", "                ttc = math.inf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.279527, "o", "            desired_distance = self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r"]
[601.27955, "o", "\u001b[?2004h> "]
[601.279647, "o", "            distance_error = distance - desired_distance\r\n\u001b[?2004l\r"]
[601.279718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[601.279783, "o", "\u001b[?2004h> "]
[601.27985, "o", "            if ttc < self.emergency_ttc_threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.279926, "o", "                mode = 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.279996, "o", "                accel_cmd = self.max_deceleration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280067, "o", "                # reset PID to avoid windup during emergency\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.280138, "o", "> "]
[601.280204, "o", "                self.pid_speed.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280268, "o", "                self.pid_distance.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280335, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280397, "o", "                mode = 'follow'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280457, "o", "                # Compute target speed based on headway error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280575, "o", "                speed_adjust = distance_error / max(self.time_headway, 1e-3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.280639, "o", "> "]
[601.280699, "o", "                target_speed = max(0.0, lead_speed + speed_adjust)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280832, "o", "                accel_cmd = self.pid_speed.compute(target_speed - ego_speed, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.280895, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.280961, "o", "        # Apply acceleration limits\r\n\u001b[?2004l\r"]
[601.281025, "o", "\u001b[?2004h> "]
[601.281093, "o", "        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.281178, "o", "        return accel_cmd, mode, distance_error\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.281244, "o", "> EOF\r\n\u001b[?2004l\r"]
[601.29251, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
