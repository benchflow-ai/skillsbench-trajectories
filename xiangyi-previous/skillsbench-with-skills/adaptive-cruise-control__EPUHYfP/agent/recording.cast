[16.402467, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
[161.169507, "i", "cat > pid_controller.py <<'EOF'\nclass PIDController:\n    def __init__(self, kp, ki, kd, integrator_limit=10.0):\n        self.kp = kp\n        self.ki = ki\n        self.kd = kd\n        self.integrator_limit = integrator_limit\n        self.reset()\n\n    def reset(self):\n        self.integral = 0.0\n        self.prev_error = None\n\n    def compute(self, error, dt):\n        if dt <= 0:\n            return 0.0\n        # Integral term with simple anti-windup\n        self.integral += error * dt\n        if self.integrator_limit is not None:\n            self.integral = max(-self.integrator_limit, min(self.integrator_limit, self.integral))\n        # Derivative term\n        if self.prev_error is None:\n            derivative = 0.0\n        else:\n            derivative = (error - self.prev_error) / dt\n        self.prev_error = error\n        return self.kp * error + self.ki * self.integral + self.kd * derivative\nEOF\n"]
[161.169699, "o", "cat > pid_controller.py <<'EOF'\r\n\u001b[?2004l\r"]
[161.169807, "o", "\u001b[?2004h> "]
[161.169841, "o", "class PIDController:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.169918, "o", "    def __init__(self, kp, ki, kd, integrator_limit=10.0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.169972, "o", "        self.kp = kp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.169999, "o", "        self.ki = ki\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170025, "o", "        self.kd = kd\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.17009, "o", "> "]
[161.170145, "o", "        self.integrator_limit = integrator_limit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170207, "o", "        self.reset()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[161.17026, "o", "\u001b[?2004h>     def reset(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170307, "o", "        self.integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170354, "o", "        self.prev_error = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[161.170397, "o", "\u001b[?2004h> "]
[161.170445, "o", "    def compute(self, error, dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170492, "o", "        if dt <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.170556, "o", ">             return 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170666, "o", "        # Integral term with simple anti-windup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.17072, "o", "        self.integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.170767, "o", "> "]
[161.170813, "o", "        if self.integrator_limit is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.170972, "o", "            self.integral = max(-self.integrator_limit, min(self.integrator_limit, self.integral))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171028, "o", "        # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171075, "o", "        if self.prev_error is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171139, "o", "            derivative = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171183, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171275, "o", "            derivative = (error - self.prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.17132, "o", "> "]
[161.171364, "o", "        self.prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.171485, "o", "        return self.kp * error + self.ki * self.integral + self.kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.17153, "o", "EOF\r\n\u001b[?2004l\r"]
[161.17264, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
[161.298095, "i", "cat > acc_system.py <<'EOF'\nfrom pid_controller import PIDController\nimport math\n\nclass AdaptiveCruiseControl:\n    def __init__(self, config):\n        self.config = config\n        acc_settings = config['acc_settings']\n        vehicle = config['vehicle']\n        pid_speed_cfg = config.get('pid_speed', {})\n        pid_distance_cfg = config.get('pid_distance', {})\n\n        self.set_speed = acc_settings['set_speed']\n        self.time_headway = acc_settings['time_headway']\n        self.min_distance = acc_settings['min_distance']\n        self.emergency_ttc_threshold = acc_settings['emergency_ttc_threshold']\n\n        self.max_acceleration = vehicle['max_acceleration']\n        self.max_deceleration = vehicle['max_deceleration']\n\n        self.pid_speed = PIDController(pid_speed_cfg.get('kp', 0.1),\n                                       pid_speed_cfg.get('ki', 0.01),\n                                       pid_speed_cfg.get('kd', 0.0))\n        self.pid_distance = PIDController(pid_distance_cfg.get('kp', 0.1),\n                                          pid_distance_cfg.get('ki', 0.01),\n                                          pid_distance_cfg.get('kd', 0.0))\n\n    def compute(self, ego_speed, lead_speed, distance, dt):\n        # Determine if lead vehicle is present\n        if lead_speed is None or distance is None:\n            mode = 'cruise'\n            speed_error = self.set_speed - ego_speed\n            accel_cmd = self.pid_speed.compute(speed_error, dt)\n            distance_error = None\n        else:\n            # Calculate time to collision\n            rel_speed = ego_speed - lead_speed\n            if rel_speed > 0:\n                ttc = distance / max(rel_speed, 1e-5)\n            else:\n                ttc = math.inf\n\n            desired_distance = self.min_distance + self.time_headway * ego_speed\n            distance_error = distance - desired_distance\n\n            if ttc < self.emergency_ttc_threshold:\n                mode = 'emergency'\n                accel_cmd = self.max_deceleration\n                # reset PID to avoid windup during emergency\n                self.pid_speed.reset()\n                self.pid_distance.reset()\n            else:\n                mode = 'follow'\n                # Distance controller determines acceleration\n                accel_distance = self.pid_distance.compute(distance_error, dt)\n                # Speed controller to keep set speed if safe\n                accel_speed = self.pid_speed.compute(self.set_speed - ego_speed, dt)\n                if distance_error >= 0:\n                    # far enough: use conservative of speed and distance commands\n                    accel_cmd = min(accel_speed, accel_distance)\n                else:\n                    # too close: prioritize distance control\n                    accel_cmd = accel_distance\n\n        # Apply acceleration limits\n        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\n        return accel_cmd, mode, distance_error\nEOF\n"]
