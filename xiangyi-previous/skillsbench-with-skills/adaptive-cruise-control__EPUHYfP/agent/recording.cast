[784.4661, "i", "python3 - <<'EOF'\nimport pandas as pd\n\ndf = pd.read_csv('simulation_results.csv')\nsensor = pd.read_csv('sensor_data.csv')\nmerged = df.merge(sensor, on='time', how='left')\nfollow = merged[merged['mode']=='follow'].copy()\nfollow['rel_speed'] = follow['lead_speed'] - follow['ego_speed_x']\n# compute distance trend\nfollow['distance_change'] = follow['distance_x'].diff()\nprint(follow.tail(10)[['time','ego_speed_x','lead_speed','distance_x','rel_speed','distance_change']])\nprint('mean rel_speed last 50', follow['rel_speed'].tail(50).mean())\nprint('mean distance_change last 50', follow['distance_change'].tail(50).mean())\nEOF\n"]
