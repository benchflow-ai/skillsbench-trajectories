[1028.172113, "i", "python3 - <<'EOF'\nimport pandas as pd\n\nsensor = pd.read_csv('sensor_data.csv')\n# compute desired distance based on sensor ego speed (if available)\nacc_settings = {'time_headway':1.5,'min_distance':10.0}\nlead = sensor[sensor['lead_speed'].notna()].copy()\nlead['desired_distance'] = acc_settings['min_distance'] + acc_settings['time_headway'] * lead['ego_speed']\nlead['distance_error'] = lead['distance'] - lead['desired_distance']\nprint(lead[['time','ego_speed','lead_speed','distance','distance_error']].head())\nprint(lead[['distance_error']].describe())\nEOF\n"]
