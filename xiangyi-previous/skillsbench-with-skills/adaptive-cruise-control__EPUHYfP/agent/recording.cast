[713.506727, "i", "python3 - <<'EOF'\nimport pandas as pd\n\nset_speed = 30.0\ndf = pd.read_csv('simulation_results.csv')\ncruise = df[df['time'] < 30]\nrt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\nrise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\novershoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\nss = cruise[cruise['time'] >= 25]\nss_error = (ss['ego_speed'] - set_speed).abs().mean()\nfollow = df[df['mode'] == 'follow']\nmin_distance = df['distance'].min()\nfollow_end = follow[follow['time'] >= 125]\ndist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\nprint(\"rise_time\", rise_time)\nprint(\"overshoot\", overshoot)\nprint(\"ss_error\", ss_error)\nprint(\"min_distance\", min_distance)\nprint(\"dist_ss_error\", dist_ss_error)\nEOF\n"]
