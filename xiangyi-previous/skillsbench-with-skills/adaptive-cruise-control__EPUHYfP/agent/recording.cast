[283.434822, "i", "cat > acc_system.py <<'EOF'\nfrom pid_controller import PIDController\nimport math\n\nclass AdaptiveCruiseControl:\n    def __init__(self, config):\n        self.config = config\n        acc_settings = config['acc_settings']\n        vehicle = config['vehicle']\n        pid_speed_cfg = config.get('pid_speed', {})\n        pid_distance_cfg = config.get('pid_distance', {})\n\n        self.set_speed = acc_settings['set_speed']\n        self.time_headway = acc_settings['time_headway']\n        self.min_distance = acc_settings['min_distance']\n        self.emergency_ttc_threshold = acc_settings['emergency_ttc_threshold']\n\n        self.max_acceleration = vehicle['max_acceleration']\n        self.max_deceleration = vehicle['max_deceleration']\n\n        self.pid_speed = PIDController(pid_speed_cfg.get('kp', 0.1),\n                                       pid_speed_cfg.get('ki', 0.01),\n                                       pid_speed_cfg.get('kd', 0.0))\n        self.pid_distance = PIDController(pid_distance_cfg.get('kp', 0.1),\n                                          pid_distance_cfg.get('ki', 0.01),\n                                          pid_distance_cfg.get('kd', 0.0))\n\n    def compute(self, ego_speed, lead_speed, distance, dt):\n        # Determine if lead vehicle is present\n        if lead_speed is None or distance is None:\n            mode = 'cruise'\n            speed_error = self.set_speed - ego_speed\n            accel_cmd = self.pid_speed.compute(speed_error, dt)\n            distance_error = None\n        else:\n            # Calculate time to collision\n            rel_speed = ego_speed - lead_speed\n            if rel_speed > 0:\n                ttc = distance / max(rel_speed, 1e-5)\n            else:\n                ttc = math.inf\n\n            desired_distance = self.min_distance + self.time_headway * ego_speed\n            distance_error = distance - desired_distance\n\n            if ttc < self.emergency_ttc_threshold:\n                mode = 'emergency'\n                accel_cmd = self.max_deceleration\n                # reset PID to avoid windup during emergency\n                self.pid_speed.reset()\n                self.pid_distance.reset()\n            else:\n                mode = 'follow'\n                # Distance controller determines acceleration when too close\n                accel_distance = self.pid_distance.compute(distance_error, dt)\n                # Speed controller to keep set speed if safe\n                accel_speed = self.pid_speed.compute(self.set_speed - ego_speed, dt)\n                if distance_error >= 0:\n                    # Safe gap: use speed control to close gap naturally\n                    accel_cmd = accel_speed\n                else:\n                    # Too close: prioritize distance control\n                    accel_cmd = accel_distance\n\n        # Apply acceleration limits\n        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\n        return accel_cmd, mode, distance_error\nEOF\n"]
[283.435143, "o", "cat > acc_system.py <<'EOF'\r\n\u001b[?2004l\r"]
[283.435246, "o", "\u001b[?2004h> "]
[283.435321, "o", "from pid_controller import PIDController\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435404, "o", "class AdaptiveCruiseControl:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435473, "o", "    def __init__(self, config):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435555, "o", "        self.config = config\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435621, "o", "        acc_settings = config['acc_settings']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435691, "o", "        vehicle = config['vehicle']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435757, "o", "        pid_speed_cfg = config.get('pid_speed', {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.435882, "o", "        pid_distance_cfg = config.get('pid_distance', {})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.43596, "o", "\u001b[?2004h> "]
[283.436024, "o", "        self.set_speed = acc_settings['set_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.436116, "o", "        self.time_headway = acc_settings['time_headway']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.436248, "o", "        self.min_distance = acc_settings['min_distance']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.43642, "o", "        self.emergency_ttc_threshold = acc_settings['emergency_ttc_threshold']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.436542, "o", "        self.max_acceleration = vehicle['max_acceleration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.43663, "o", "        self.max_deceleration = vehicle['max_deceleration']\r\n\u001b[?2004l\r\u001b[?2004h"]
[283.436692, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.436818, "o", "        self.pid_speed = PIDController(pid_speed_cfg.get('kp', 0.1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.436957, "o", "                                       pid_speed_cfg.get('ki', 0.01),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437098, "o", "                                       pid_speed_cfg.get('kd', 0.0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437225, "o", "        self.pid_distance = PIDController(pid_distance_cfg.get('kp', 0.1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437353, "o", "                                          pid_distance_cfg.get('ki', 0.01),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437483, "o", "                                          pid_distance_cfg.get('kd', 0.0))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.437544, "o", "\u001b[?2004h> "]
[283.437605, "o", "    def compute(self, ego_speed, lead_speed, distance, dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437694, "o", "        # Determine if lead vehicle is present\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.43779, "o", "        if lead_speed is None or distance is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437853, "o", "            mode = 'cruise'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.437945, "o", "            speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438074, "o", "            accel_cmd = self.pid_speed.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438151, "o", "            distance_error = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438213, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438272, "o", "            # Calculate time to collision\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438334, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438407, "o", "            if rel_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438508, "o", "                ttc = distance / max(rel_speed, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.438595, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.446573, "o", "                ttc = math.inf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[283.44669, "o", "\u001b[?2004h>             desired_distance = self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r\u001b[?2004h>             distance_error = distance - desired_distance\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             if ttc < self.emergency_ttc_threshold:\r\n\u001b[?2004l\r\u001b[?2004h>                 mode = 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h>                 accel_cmd = self.max_deceleration\r\n\u001b[?2004l\r\u001b[?2004h>                 # reset PID to avoid windup during emergency\r\n\u001b[?2004l\r\u001b[?2004h>                 self.pid_speed.reset()\r\n\u001b[?2004l\r\u001b[?2004h>                 self.pid_distance.reset()\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 mode = 'follow'\r\n\u001b[?2004l\r\u001b[?2004h>                 # Distance controller determines acceleration when too close\r\n\u001b[?2004l\r\u001b[?2004h>                 accel_distance = self.pid_distance.compute(distance_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h>                 # Speed controller to keep set speed if safe\r\n\u001b[?2004l\r\u001b[?2004h>                 accel_speed = self.pid_speed.compute(self.set_speed - ego_speed, dt)\r\n\u001b[?2004l\r\u001b[?2004h>                 if distance_error >= 0:\r\n\u001b[?2004l\r\u001b[?2004h>                     # Safe gap: use speed control to close gap naturally\r\n\u001b[?2004l\r\u001b[?2004h>                     accel_cmd = accel_speed\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     # Too close: prioritize distance control\r\n\u001b[?2004l\r\u001b[?2004h>                     accel_cmd = accel_distance\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Apply acceleration limits\r\n\u001b[?2004l\r\u001b[?2004h>         accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h>         return accel_cmd, mode, distance_error\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@5090bbaa2228:~# "]
[283.572239, "i", "python3 simulation.py\n"]
[283.57245, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[283.623511, "o", "\u001b[?2004hroot@5090bbaa2228:~# "]
[284.594446, "i", "python3 - <<'EOF'\nimport pandas as pd\n\nset_speed = 30.0\ndf = pd.read_csv('simulation_results.csv')\ncruise = df[df['time'] < 30]\nrt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\nrise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\novershoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\nss = cruise[cruise['time'] >= 25]\nss_error = (ss['ego_speed'] - set_speed).abs().mean()\nfollow = df[df['mode'] == 'follow']\nmin_distance = df['distance'].min()\nfollow_end = follow[follow['time'] >= 125]\ndist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\nprint(\"rise_time\", rise_time)\nprint(\"overshoot\", overshoot)\nprint(\"ss_error\", ss_error)\nprint(\"min_distance\", min_distance)\nprint(\"dist_ss_error\", dist_ss_error)\nEOF\n"]
