[987.562787, "i", "python3 - <<'EOF'\nimport pandas as pd\n\nset_speed = 30.0\ndf = pd.read_csv('simulation_results.csv')\ncruise = df[df['time'] < 30]\nrt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\nrise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\novershoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\nss = cruise[cruise['time'] >= 25]\nss_error = (ss['ego_speed'] - set_speed).abs().mean()\nfollow = df[df['mode'] == 'follow']\nmin_distance = df['distance'].min()\nfollow_end = follow[follow['time'] >= 125]\ndist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\nprint(\"rise_time\", rise_time)\nprint(\"overshoot\", overshoot)\nprint(\"ss_error\", ss_error)\nprint(\"min_distance\", min_distance)\nprint(\"dist_ss_error\", dist_ss_error)\nEOF\n"]
[987.562978, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r"]
[987.563011, "o", "\u001b[?2004h> "]
[987.563147, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> set_speed = 30.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563216, "o", "df = pd.read_csv('simulation_results.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563269, "o", "cruise = df[df['time'] < 30]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563362, "o", "rt_idx = cruise[cruise['ego_speed'] >= 0.9*set_speed].index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563477, "o", "rise_time = cruise.loc[rt_idx[0],'time'] if len(rt_idx)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563584, "o", "overshoot = (cruise['ego_speed'].max() - set_speed)/set_speed*100\r\n\u001b[?2004l\r"]
[987.563637, "o", "\u001b[?2004h> "]
[987.563668, "o", "ss = cruise[cruise['time'] >= 25]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563751, "o", "ss_error = (ss['ego_speed'] - set_speed).abs().mean()\r\n\u001b[?2004l\r"]
[987.563785, "o", "\u001b[?2004h> "]
[987.563868, "o", "follow = df[df['mode'] == 'follow']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.563899, "o", "min_distance = df['distance'].min()\r\n\u001b[?2004l\r"]
[987.563928, "o", "\u001b[?2004h> "]
[987.564002, "o", "follow_end = follow[follow['time'] >= 125]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[987.564139, "o", "dist_ss_error = follow_end['distance_error'].abs().mean() if len(follow_end)>0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
