[489.308876, "o", "> "]
[489.308923, "o", "            distance = lead_pos - ego_pos\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[489.308962, "o", ">         # Compute control\r\n\u001b[?2004l\r"]
[489.309012, "o", "\u001b[?2004h> "]
[489.309145, "o", "        accel_cmd, mode, distance_error = acc.compute(ego_speed, lead_speed, distance, dt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[489.309171, "o", "\u001b[?2004h> "]
[489.309212, "o", "        # Compute TTC for reporting\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.309234, "o", "> "]
[489.309254, "o", "        ttc = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.309304, "o", "> "]
[489.309406, "o", "        if lead_speed is not None and distance is not None and ego_speed > lead_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.309451, "o", "> "]
[489.309487, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r"]
[489.309527, "o", "\u001b[?2004h> "]
[489.309596, "o", "            ttc = distance / max(rel_speed, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[489.309639, "o", "\u001b[?2004h> "]
[489.309694, "o", "        # Store results at current time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.309736, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.309802, "o", "            'time': time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.309876, "o", "            'ego_speed': ego_speed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.309949, "o", "            'acceleration_cmd': accel_cmd,\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.309993, "o", "> "]
[489.310033, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.31009, "o", "            'distance_error': distance_error,\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.310141, "o", "> "]
[489.310178, "o", "            'distance': distance,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.310215, "o", "            'ttc': ttc\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.31025, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.310288, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.310366, "o", "        # Update vehicle states for next timestep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.310453, "o", "        ego_speed = max(0.0, ego_speed + accel_cmd * dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.310496, "o", "> "]
[489.310564, "o", "        ego_pos += ego_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.310617, "o", "> "]
[489.310662, "o", "        if lead_pos is not None and lead_speed is not None:\r\n\u001b[?2004l\r"]
[489.310705, "o", "\u001b[?2004h> "]
[489.310749, "o", "            lead_pos += lead_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[489.310793, "o", "\u001b[?2004h> "]
[489.310837, "o", "    # Write simulation results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.310913, "o", "    with open('simulation_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.310957, "o", "> "]
[489.311106, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.311207, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.311277, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.311389, "o", "        for row in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.311439, "o", "            writer.writerow({k: format_value(row[k]) for k in fieldnames})\r\n\u001b[?2004l\r\u001b[?2004h"]
[489.311486, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[489.311511, "o", "\u001b[?2004h> "]
