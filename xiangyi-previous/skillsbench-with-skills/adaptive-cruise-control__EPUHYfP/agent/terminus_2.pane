[?2004l[?2004h> 
[?2004l[?2004h> def load_yaml(path):
[?2004l[?2004h>     with open(path, 'r') as f:
[?2004l[?2004h>         return yaml.safe_load(f)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def format_value(val):
[?2004l[?2004h>     if val is None:
[?2004l[?2004h>         return ''
[?2004l[?2004h>     if isinstance(val, (int, float)):
[?2004l[?2004h>         return round(val, 4)
[?2004l[?2004h>     return val
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     config = load_yaml('vehicle_params.yaml')
[?2004l[?2004h>     tuning = load_yaml('tuning_results.yaml')
[?2004l[?2004h>     # override PID gains with tuned values
[?2004l[?2004h>     config['pid_speed'] = tuning['pid_speed']
[?2004l[?2004h>     config['pid_distance'] = tuning['pid_distance']
[?2004l[?2004h> 
[?2004l[?2004h>     acc = AdaptiveCruiseControl(config)
[?2004l[?2004h>     dt = config['simulation']['dt']
[?2004l[?2004h> 
[?2004l[?2004h>     # Read sensor data
[?2004l[?2004h>     with open('sensor_data.csv', 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         data = list(reader)
[?2004l[?2004h> 
[?2004l[?2004h>     # Initialize states
[?2004l[?2004h>     ego_speed = 0.0
[?2004l[?2004h> 
[?2004l[?2004h>     results = []
[?2004l[?2004h> 
[?2004l[?2004h>     for row in data:
[?2004l[?2004h>         time = float(row['time'])
[?2004l[?2004h>         lead_speed = row['lead_speed']
[?2004l[?2004h>         distance_meas = row['distance']
[?2004l[?2004h> 
[?2004l[?2004h>         lead_speed = float(lead_speed) if lead_speed != '' else None
[?2004l[?2004h>         distance = float(distance_meas) if distance_meas != '' else None
[?2004l[?2004h> 
[?2004l[?2004h>         # Compute control using measured lead distance
[?2004l[?2004h>         accel_cmd, mode, distance_error = acc.compute(ego_speed, lead_speed, distance, dt)
[?2004l[?2004h> 
[?2004l[?2004h>         # Compute TTC for reporting
[?2004l[?2004h>         ttc = None
[?2004l[?2004h>         if lead_speed is not None and distance is not None and ego_speed > lead_speed:
[?2004l[?2004h>             rel_speed = ego_speed - lead_speed
[?2004l[?2004h>             ttc = distance / max(rel_speed, 1e-5)
[?2004l[?2004h> 
[?2004l[?2004h>         # Store results at current time
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': time,
[?2004l[?2004h>             'ego_speed': ego_speed,
[?2004l[?2004h>             'acceleration_cmd': accel_cmd,
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': distance_error,
[?2004l[?2004h>             'distance': distance,
[?2004l[?2004h>             'ttc': ttc
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h>         # Update vehicle speed for next timestep
[?2004l[?2004h>         ego_speed = max(0.0, ego_speed + accel_cmd * dt)
[?2004l[?2004h> 
[?2004l[?2004h>     # Write simulation results
[?2004l[?2004h>     with open('simulation_results.csv', 'w', newline='') as f:
[?2004l[?2004h>         fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 'distance_error', 'distance', 'ttc']
[?2004l[?2004h>         writer = csv.DictWriter(f, fieldnames=fieldnames)
[?2004l[?2004h>         writer.writeheader()
[?2004l[?2004h>         for row in results:
[?2004l[?2004h>             writer.writerow({k: format_value(row[k]) for k in fieldnames})
