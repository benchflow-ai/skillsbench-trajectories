[?2004l[?2004h>         if lead_speed is not None and distance is not None:
[?2004l[?2004h>             desired_distance = self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>             if distance > desired_distance + self.follow_buffer:
[?2004l[?2004h>                 lead_speed = None
[?2004l[?2004h>                 distance = None
[?2004l[?2004h> 
[?2004l[?2004h>         if lead_speed is None or distance is None:
[?2004l[?2004h>             mode = 'cruise'
[?2004l[?2004h>             speed_error = self.set_speed - ego_speed
[?2004l[?2004h>             accel_cmd = self.pid_speed.compute(speed_error, dt)
[?2004l[?2004h>             distance_error = None
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Calculate time to collision
[?2004l[?2004h>             rel_speed = ego_speed - lead_speed
[?2004l[?2004h>             if rel_speed > 0:
[?2004l[?2004h>                 ttc = distance / max(rel_speed, 1e-5)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ttc = math.inf
[?2004l[?2004h> 
[?2004l[?2004h>             desired_distance = self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>             distance_error = distance - desired_distance
[?2004l[?2004h> 
[?2004l[?2004h>             if ttc < self.emergency_ttc_threshold:
