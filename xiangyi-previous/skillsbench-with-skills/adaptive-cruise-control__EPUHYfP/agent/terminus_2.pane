[?2004l[?2004h> class PIDController:
[?2004l[?2004h>     def __init__(self, kp, ki, kd, integrator_limit=10.0):
[?2004l[?2004h>         self.kp = kp
[?2004l[?2004h>         self.ki = ki
[?2004l[?2004h>         self.kd = kd
[?2004l[?2004h>         self.integrator_limit = integrator_limit
[?2004l[?2004h>         self.reset()
[?2004l[?2004h> 
[?2004l[?2004h>     def reset(self):
[?2004l[?2004h>         self.integral = 0.0
[?2004l[?2004h>         self.prev_error = None
[?2004l[?2004h> 
[?2004l[?2004h>     def compute(self, error, dt):
[?2004l[?2004h>         if dt <= 0:
[?2004l[?2004h>             return 0.0
[?2004l[?2004h>         # Integral term with simple anti-windup
[?2004l[?2004h>         self.integral += error * dt
[?2004l[?2004h>         if self.integrator_limit is not None:
[?2004l[?2004h>             self.integral = max(-self.integrator_limit, min(self.integrator_limit, self.integral))
[?2004l[?2004h>         # Derivative term
[?2004l[?2004h>         if self.prev_error is None:
[?2004l[?2004h>             derivative = 0.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             derivative = (error - self.prev_error) / dt
[?2004l[?2004h>         self.prev_error = error
[?2004l[?2004h>         return self.kp * error + self.ki * self.integral + self.kd * derivative
