[51.816613, "i", "cat > estimate_params.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Parameter estimation: Fit first-order model to calibration data.\"\"\"\n\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef estimate_parameters():\n    # Load calibration data\n    with open('calibration_log.json', 'r') as f:\n        cal_data = json.load(f)\n    \n    data = cal_data['data']\n    heater_power = cal_data['heater_power_test']\n    \n    # Extract time and temperature arrays\n    times = np.array([d['time'] for d in data])\n    temps = np.array([d['temperature'] for d in data])\n    \n    # Get initial and ambient temperature\n    T_0 = temps[0]\n    T_ambient = 18.0  # From config\n    \n    print(f\"Estimating parameters from {len(data)} data points...\")\n    print(f\"Initial temperature: {T_0:.2f}C\")\n    print(f\"Heater power: {heater_power}%\")\n    \n    # First-order step response model:\n    # T(t) = T_ss - (T_ss - T_0) * exp(-t/tau)\n    # where T_ss = T_ambient + K * u (steady-state temperature)\n    \n    def first_order_response(t, K, tau):\n        \"\"\"First-order step response model.\"\"\"\n        T_ss = T_ambient + K * heater_power\n        return T_ss - (T_ss - T_0) * np.exp(-t / tau)\n    \n    # Initial guess: K ~ (final_temp - ambient) / heater_power, tau ~ 20s\n    T_final = np.mean(temps[-10:])  # Average last 10 points\n    K_guess = (T_final - T_ambient) / heater_power\n    tau_guess = 20.0\n    \n    print(f\"Initial guess: K={K_guess:.4f}, tau={tau_guess:.1f}\")\n    \n    # Fit the model (skip first point which is at t=0 with heater off)\n    try:\n        params, _ = curve_fit(\n            first_order_response,\n            times[1:],\n            temps[1:],\n            p0=[K_guess, tau_guess],\n            bounds=([0.0, 1.0], [1.0, 100.0]),  # K in [0, 1], tau in [1, 100]\n            maxfev=10000\n        )\n        \n        K_est, tau_est = params\n        \n        # Calculate R-squared and fitting error\n        temps_pred = first_order_response(times[1:], K_est, tau_est)\n        residuals = temps[1:] - temps_pred\n        ss_res = np.sum(residuals**2)\n        ss_tot = np.sum((temps[1:] - np.mean(temps[1:]))**2)\n        r_squared = 1 - (ss_res / ss_tot)\n        fitting_error = np.sqrt(np.mean(residuals**2))  # RMSE\n        \n        print(f\"\\nEstimated parameters:\")\n        print(f\"  K = {K_est:.4f} C/%\")\n        print(f\"  tau = {tau_est:.2f} s\")\n        print(f\"  R² = {r_squared:.4f}\")\n        print(f\"  RMSE = {fitting_error:.4f} C\")\n        \n        # Save results\n        results = {\n            \"K\": round(K_est, 6),\n            \"tau\": round(tau_est, 4),\n            \"r_squared\": round(r_squared, 6),\n            \"fitting_error\": round(fitting_error, 6)\n        }\n        \n        with open('estimated_params.json', 'w') as f:\n            json.dump(results, f, indent=2)\n        \n        print(\"\\nSaved estimated_params.json\")\n        \n    except Exception as e:\n        print(f\"Error during curve fitting: {e}\")\n        raise\n\nif __name__ == \"__main__\":\n    estimate_parameters()\nEOF\n"]
[51.816903, "o", "cat > estimate_params.py << 'EOF'\r\n\u001b[?2004l\r"]
[51.816968, "o", "\u001b[?2004h> "]
[51.817033, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817106, "o", "\"\"\"Parameter estimation: Fit first-order model to calibration data.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.817159, "o", "\u001b[?2004h> "]
[51.817211, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817276, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.817334, "o", "\u001b[?2004h> "]
[51.817379, "o", "def estimate_parameters():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817433, "o", "    # Load calibration data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817543, "o", "    with open('calibration_log.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817588, "o", "        cal_data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[51.817635, "o", "\u001b[?2004h> "]
[51.817691, "o", "    data = cal_data['data']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817754, "o", "    heater_power = cal_data['heater_power_test']\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[51.817808, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817854, "o", "    # Extract time and temperature arrays\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.817959, "o", "    times = np.array([d['time'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818038, "o", "    temps = np.array([d['temperature'] for d in data])\r\n\u001b[?2004l\r"]
[51.818091, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.818141, "o", "> "]
[51.81819, "o", "    # Get initial and ambient temperature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818242, "o", "    T_0 = temps[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818289, "o", "    T_ambient = 18.0  # From config\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818339, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818414, "o", "    print(f\"Estimating parameters from {len(data)} data points...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.818455, "o", "> "]
[51.818497, "o", "    print(f\"Initial temperature: {T_0:.2f}C\")\r\n\u001b[?2004l\r"]
[51.818542, "o", "\u001b[?2004h> "]
[51.818584, "o", "    print(f\"Heater power: {heater_power}%\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.818636, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818691, "o", "    # First-order step response model:\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.818744, "o", "> "]
[51.818783, "o", "    # T(t) = T_ss - (T_ss - T_0) * exp(-t/tau)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818902, "o", "    # where T_ss = T_ambient + K * u (steady-state temperature)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818948, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.818995, "o", "    def first_order_response(t, K, tau):\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819046, "o", "> "]
[51.819088, "o", "        \"\"\"First-order step response model.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819143, "o", "> "]
[51.819192, "o", "        T_ss = T_ambient + K * heater_power\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.819268, "o", "        return T_ss - (T_ss - T_0) * np.exp(-t / tau)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819313, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.819422, "o", "    # Initial guess: K ~ (final_temp - ambient) / heater_power, tau ~ 20s\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819472, "o", "> "]
[51.819527, "o", "    T_final = np.mean(temps[-10:])  # Average last 10 points\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819571, "o", "> "]
[51.819618, "o", "    K_guess = (T_final - T_ambient) / heater_power\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.819663, "o", ">     tau_guess = 20.0\r\n\u001b[?2004l\r"]
[51.819708, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.819813, "o", "    print(f\"Initial guess: K={K_guess:.4f}, tau={tau_guess:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.819869, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.819959, "o", "    # Fit the model (skip first point which is at t=0 with heater off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820009, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820052, "o", "        params, _ = curve_fit(\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820095, "o", "> "]
[51.820139, "o", "            first_order_response,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820183, "o", "            times[1:],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820224, "o", "            temps[1:],\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820268, "o", "> "]
[51.820321, "o", "            p0=[K_guess, tau_guess],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.82043, "o", "            bounds=([0.0, 1.0], [1.0, 100.0]),  # K in [0, 1], tau in [1, 100]\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820474, "o", ">             maxfev=10000\r\n\u001b[?2004l\r"]
[51.820518, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820561, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820614, "o", "        K_est, tau_est = params\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820658, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.820735, "o", "        # Calculate R-squared and fitting error\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820787, "o", "> "]
[51.820851, "o", "        temps_pred = first_order_response(times[1:], K_est, tau_est)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.820894, "o", "> "]
[51.820936, "o", "        residuals = temps[1:] - temps_pred\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821003, "o", "        ss_res = np.sum(residuals**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.821052, "o", "> "]
[51.821112, "o", "        ss_tot = np.sum((temps[1:] - np.mean(temps[1:]))**2)\r\n\u001b[?2004l\r"]
[51.821157, "o", "\u001b[?2004h> "]
[51.8212, "o", "        r_squared = 1 - (ss_res / ss_tot)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.821253, "o", "> "]
[51.821332, "o", "        fitting_error = np.sqrt(np.mean(residuals**2))  # RMSE\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.821385, "o", ">         \r\n\u001b[?2004l\r"]
[51.821438, "o", "\u001b[?2004h> "]
[51.821496, "o", "        print(f\"\\nEstimated parameters:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821536, "o", "        print(f\"  K = {K_est:.4f} C/%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821612, "o", "        print(f\"  tau = {tau_est:.2f} s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.821657, "o", "> "]
[51.821703, "o", "        print(f\"  R² = {r_squared:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821781, "o", "        print(f\"  RMSE = {fitting_error:.4f} C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821825, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.82187, "o", "        # Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.821907, "o", "        results = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.821951, "o", "> "]
[51.821995, "o", "            \"K\": round(K_est, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822051, "o", "            \"tau\": round(tau_est, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.822106, "o", "> "]
[51.822156, "o", "            \"r_squared\": round(r_squared, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822232, "o", "            \"fitting_error\": round(fitting_error, 6)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.822279, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822328, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822391, "o", "        with open('estimated_params.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.822435, "o", "> "]
[51.822473, "o", "            json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.822519, "o", ">         \r\n\u001b[?2004l\r"]
[51.822572, "o", "\u001b[?2004h> "]
[51.822622, "o", "        print(\"\\nSaved estimated_params.json\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[51.822671, "o", "\u001b[?2004h> "]
[51.82272, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822774, "o", "        print(f\"Error during curve fitting: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.822825, "o", ">         raise\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.82287, "o", "\u001b[?2004h> "]
[51.822913, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.822958, "o", "    estimate_parameters()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[51.823961, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[51.966765, "i", "python3 estimate_params.py\n"]
[51.96969, "o", "python3 estimate_params.py\r\n\u001b[?2004l\r"]
[52.965314, "o", "Estimating parameters from 81 data points...\r\nInitial temperature: 17.94C\r\nHeater power: 50.0%\r\n"]
[52.967545, "o", "Initial guess: K=0.0728, tau=20.0\r\n"]
[52.970799, "o", "\r\nEstimated parameters:\r\n  K = 0.1162 C/%\r\n  tau = 37.49 s\r\n"]
[52.970943, "o", "  R² = 0.9916\r\n  RMSE = 0.0996 C\r\n"]
[52.9711, "o", "\r\nSaved estimated_params.json\r\n"]
[53.012602, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[72.381915, "i", "cat > tune_gains.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\n\nimport json\n\ndef tune_controller():\n    # Load estimated parameters\n    with open('estimated_params.json', 'r') as f:\n        params = json.load(f)\n    \n    K = params['K']\n    tau = params['tau']\n    \n    print(f\"Tuning controller with estimated parameters:\")\n    print(f\"  K = {K:.4f} C/%\")\n    print(f\"  tau = {tau:.2f} s\")\n    \n    # Lambda tuning (IMC-based PID tuning for first-order system)\n    # For first-order system: dT/dt = (1/tau) * (K*u + T_ambient - T)\n    # \n    # PID tuning rules:\n    #   Kp = tau / (K * lambda)\n    #   Ki = 1 / tau  \n    #   Kd = 0 (for first-order system)\n    #\n    # Lambda is the desired closed-loop time constant\n    # - Smaller lambda = faster response but more aggressive\n    # - Larger lambda = slower response but more robust\n    # \n    # For overshoot < 10% and good settling time, choose lambda ~ tau\n    # This gives moderate aggressiveness with good stability margins\n    \n    lambda_factor = 1.0  # Lambda = lambda_factor * tau\n    lambda_val = lambda_factor * tau\n    \n    # Calculate PID gains\n    Kp = tau / (K * lambda_val)\n    Ki = 1.0 / tau\n    Kd = 0.0  # No derivative for first-order system\n    \n    print(f\"\\nTuning method: Lambda (IMC-based)\")\n    print(f\"  Lambda = {lambda_val:.2f} s (closed-loop time constant)\")\n    print(f\"\\nCalculated gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Save tuned gains\n    gains = {\n        \"Kp\": round(Kp, 6),\n        \"Ki\": round(Ki, 6),\n        \"Kd\": round(Kd, 6),\n        \"lambda\": round(lambda_val, 4)\n    }\n    \n    with open('tuned_gains.json', 'w') as f:\n        json.dump(gains, f, indent=2)\n    \n    print(\"\\nSaved tuned_gains.json\")\n\nif __name__ == \"__main__\":\n    tune_controller()\nEOF\n"]
[72.38216, "o", "cat > tune_gains.py << 'EOF'\r\n\u001b[?2004l\r"]
[72.382241, "o", "\u001b[?2004h> "]
[72.382268, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382381, "o", "\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.382436, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.382493, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.382525, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382586, "o", "def tune_controller():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382661, "o", "    # Load estimated parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382704, "o", "    with open('estimated_params.json', 'r') as f:\r\n\u001b[?2004l\r"]
[72.382752, "o", "\u001b[?2004h> "]
[72.382801, "o", "        params = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382857, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382913, "o", "    K = params['K']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.382955, "o", "    tau = params['tau']\r\n"]
[72.383008, "o", "\u001b[?2004l\r"]
[72.383068, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.383118, "o", "> "]
[72.383166, "o", "    print(f\"Tuning controller with estimated parameters:\")\r\n\u001b[?2004l\r"]
[72.383215, "o", "\u001b[?2004h> "]
[72.38325, "o", "    print(f\"  K = {K:.4f} C/%\")\r\n\u001b[?2004l\r"]
[72.383298, "o", "\u001b[?2004h> "]
[72.383354, "o", "    print(f\"  tau = {tau:.2f} s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.3834, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.383425, "o", "> "]
[72.383509, "o", "    # Lambda tuning (IMC-based PID tuning for first-order system)\r\n\u001b[?2004l\r"]
[72.383551, "o", "\u001b[?2004h> "]
[72.383843, "o", "    # For first-order system: dT/dt = (1/tau) * (K*u + T_ambient - T)\r\n\u001b[?2004l\r\u001b[?2004h>     # \r\n\u001b[?2004l\r\u001b[?2004h>     # PID tuning rules:\r\n"]
[72.383963, "o", "\u001b[?2004l\r\u001b[?2004h>     #   Kp = tau / (K * lambda)\r\n\u001b[?2004l\r"]
[72.384047, "o", "\u001b[?2004h>     #   Ki = 1 / tau  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.38413, "o", "    #   Kd = 0 (for first-order system)\r\n\u001b[?2004l\r"]
[72.384213, "o", "\u001b[?2004h>     #\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.384311, "o", "    # Lambda is the desired closed-loop time constant\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.38445, "o", "    # - Smaller lambda = faster response but more aggressive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.384576, "o", "    # - Larger lambda = slower response but more robust\r\n\u001b[?2004l\r"]
[72.38461, "o", "\u001b[?2004h>     # \r\n"]
[72.384645, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.38481, "o", "    # For overshoot < 10% and good settling time, choose lambda ~ tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.384965, "o", "    # This gives moderate aggressiveness with good stability margins\r\n\u001b[?2004l\r"]
[72.385002, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[72.385034, "o", "\u001b[?2004h> "]
[72.385167, "o", "    lambda_factor = 1.0  # Lambda = lambda_factor * tau\r\n\u001b[?2004l\r"]
[72.3852, "o", "\u001b[?2004h> "]
[72.385282, "o", "    lambda_val = lambda_factor * tau\r\n\u001b[?2004l\r"]
[72.38532, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[72.385354, "o", "\u001b[?2004h> "]
[72.385466, "o", "    # Calculate PID gains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.385542, "o", "    Kp = tau / (K * lambda_val)\r\n\u001b[?2004l\r"]
[72.38558, "o", "\u001b[?2004h> "]
[72.385652, "o", "    Ki = 1.0 / tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.385786, "o", "    Kd = 0.0  # No derivative for first-order system\r\n\u001b[?2004l\r"]
[72.38582, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[72.385852, "o", "\u001b[?2004h> "]
[72.385965, "o", "    print(f\"\\nTuning method: Lambda (IMC-based)\")\r\n\u001b[?2004l\r"]
[72.386001, "o", "\u001b[?2004h> "]
[72.386164, "o", "    print(f\"  Lambda = {lambda_val:.2f} s (closed-loop time constant)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.386231, "o", "    print(f\"\\nCalculated gains:\")\r\n\u001b[?2004l\r"]
[72.38627, "o", "\u001b[?2004h> "]
[72.386342, "o", "    print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r"]
[72.386379, "o", "\u001b[?2004h> "]
[72.386447, "o", "    print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r"]
[72.386484, "o", "\u001b[?2004h> "]
[72.386554, "o", "    print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r"]
[72.386591, "o", "\u001b[?2004h>     "]
[72.386627, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.386707, "o", "    # Save tuned gains\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.386744, "o", "> "]
[72.386775, "o", "    gains = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.386811, "o", "> "]
[72.386943, "o", "        \"Kp\": round(Kp, 6),\r\n\u001b[?2004l\r\u001b[?2004h>         \"Ki\": round(Ki, 6),"]
[72.387015, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.387079, "o", "        \"Kd\": round(Kd, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.387161, "o", "        \"lambda\": round(lambda_val, 4)\r\n\u001b[?2004l\r"]
[72.387234, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[72.387299, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.387387, "o", "    with open('tuned_gains.json', 'w') as f:\r\n\u001b[?2004l\r"]
[72.387457, "o", "\u001b[?2004h> "]
