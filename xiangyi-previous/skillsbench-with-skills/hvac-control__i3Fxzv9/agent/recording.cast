[304.877929, "i", "cat > tune_gains.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\n\nimport json\n\ndef tune_controller():\n    # Load estimated parameters\n    with open('estimated_params.json', 'r') as f:\n        params = json.load(f)\n    \n    K = params['K']\n    tau = params['tau']\n    \n    print(f\"Tuning controller with estimated parameters:\")\n    print(f\"  K = {K:.4f} C/%\")\n    print(f\"  tau = {tau:.2f} s\")\n    \n    # Very aggressive tuning\n    lambda_factor = 0.2\n    lambda_val = lambda_factor * tau\n    \n    # Calculate PID gains with very high integral\n    Kp = tau / (K * lambda_val)\n    Ki = 8.0 / tau  # Very high integral gain\n    Kd = 0.0\n    \n    print(f\"\\nTuning method: Very aggressive Lambda tuning\")\n    print(f\"  Lambda = {lambda_val:.2f} s\")\n    print(f\"  Lambda factor = {lambda_factor}\")\n    print(f\"  Integral boost factor = 8.0\")\n    print(f\"\\nCalculated gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Save tuned gains\n    gains = {\n        \"Kp\": round(Kp, 6),\n        \"Ki\": round(Ki, 6),\n        \"Kd\": round(Kd, 6),\n        \"lambda\": round(lambda_val, 4)\n    }\n    \n    with open('tuned_gains.json', 'w') as f:\n        json.dump(gains, f, indent=2)\n    \n    print(\"\\nSaved tuned_gains.json\")\n\nif __name__ == \"__main__\":\n    tune_controller()\nEOF\n"]
