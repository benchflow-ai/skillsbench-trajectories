[398.798566, "i", "cat > control.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Closed-loop control: Run PID controller to reach setpoint.\"\"\"\n\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\ndef calculate_metrics(data, setpoint):\n    \"\"\"Calculate performance metrics from control data.\"\"\"\n    times = np.array([d['time'] for d in data])\n    temps = np.array([d['temperature'] for d in data])\n    \n    # Find initial temperature (average of first few points)\n    T_initial = np.mean(temps[:5])\n    \n    # Max temperature\n    max_temp = np.max(temps)\n    \n    # Rise time: time to reach 90% of setpoint change\n    target_90 = T_initial + 0.9 * (setpoint - T_initial)\n    rise_idx = np.where(temps >= target_90)[0]\n    rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]\n    \n    # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)\n    overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))\n    \n    # Settling time: Use ±0.5°C criterion (consistent with steady-state error requirement)\n    # Temperature must stay within ±0.5°C of setpoint for 10 seconds\n    settling_band = 0.5  # Absolute error in °C\n    settled = False\n    settling_time = times[-1]\n    \n    for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)\n        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\n            settling_time = times[i]\n            settled = True\n            break\n    \n    # Steady-state error: average error in last 20% of data\n    steady_start = int(0.8 * len(temps))\n    steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)\n    \n    return {\n        \"rise_time\": round(rise_time, 2),\n        \"overshoot\": round(overshoot, 4),\n        \"settling_time\": round(settling_time, 2),\n        \"steady_state_error\": round(steady_state_error, 4),\n        \"max_temp\": round(max_temp, 4)\n    }\n\ndef run_control():\n    # Load tuned gains\n    with open('tuned_gains.json', 'r') as f:\n        gains = json.load(f)\n    \n    Kp = gains['Kp']\n    Ki = gains['Ki']\n    Kd = gains['Kd']\n    \n    print(f\"Running closed-loop control with PID gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Initialize simulator\n    sim = HVACSimulator()\n    setpoint = sim.get_setpoint()\n    dt = sim.get_dt()\n    \n    print(f\"\\nSetpoint: {setpoint}C\")\n    print(f\"Control duration: 200s\")\n    \n    # Reset and get initial temperature\n    initial_temp = sim.reset()\n    print(f\"Initial temperature: {initial_temp:.2f}C\")\n    \n    # PID controller state\n    integral = 0.0\n    prev_error = setpoint - initial_temp\n    \n    # Data collection\n    data = []\n    \n    # Run control loop\n    duration = 200.0\n    steps = int(duration / dt)\n    \n    print(f\"\\nStarting control loop...\")\n    \n    for step in range(steps):\n        # Get current state from last step or initial\n        if step == 0:\n            current_temp = initial_temp\n            time = 0.0\n        else:\n            time = data[-1]['time'] + dt\n        \n        # Calculate error\n        error = setpoint - current_temp\n        \n        # PID control\n        # Proportional term\n        P = Kp * error\n        \n        # Integral term with anti-windup\n        integral += error * dt\n        # Anti-windup: clamp integral to prevent excessive buildup\n        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\n        integral = np.clip(integral, -max_integral, max_integral)\n        I = Ki * integral\n        \n        # Derivative term\n        derivative = (error - prev_error) / dt\n        D = Kd * derivative\n        \n        # Calculate control output\n        heater_power = P + I + D\n        \n        # Clamp to valid range [0, 100]\n        heater_power = np.clip(heater_power, 0.0, 100.0)\n        \n        # Apply control and step simulation\n        result = sim.step(heater_power)\n        current_temp = result['temperature']\n        \n        # Log data\n        data.append({\n            \"time\": round(result['time'], 2),\n            \"temperature\": round(current_temp, 4),\n            \"setpoint\": setpoint,\n            \"heater"]
[398.798615, "i", "_power\": round(heater_power, 2),\n            \"error\": round(error, 4)\n        })\n        \n        # Update for next iteration\n        prev_error = error\n        \n        # Print progress every 20 seconds\n        if step % 40 == 0 or step == steps - 1:\n            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\n    \n    print(f\"\\nControl complete. Collected {len(data)} data points.\")\n    \n    # Save control log\n    control_log = {\n        \"phase\": \"control\",\n        \"setpoint\": setpoint,\n        \"data\": data\n    }\n    \n    with open('control_log.json', 'w') as f:\n        json.dump(control_log, f, indent=2)\n    \n    print(\"Saved control_log.json\")\n    \n    # Calculate and save metrics\n    metrics = calculate_metrics(data, setpoint)\n    \n    print(f\"\\nPerformance Metrics:\")\n    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\n    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\n    print(f\"  Settling time: {metrics['settling_time']:.2f}s\")\n    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\n    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\n    \n    with open('metrics.json', 'w') as f:\n        json.dump(metrics, f, indent=2)\n    \n    print(\"\\nSaved metrics.json\")\n    \n    # Check if requirements are met\n    print(\"\\n=== Requirements Check ===\")\n    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\n    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\n    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\n    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\n    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\n\nif __name__ == \"__main__\":\n    run_control()\nEOF\n"]
[398.798863, "o", "cat > control.py << 'EOF'\r\n\u001b[?2004l\r"]
[398.79891, "o", "\u001b[?2004h> "]
[398.798988, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\rrr\u001b[?2004h> "]
[398.799123, "o", "\"\"\"Closed-loop control: Run PID controller to reach setpoint.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.799146, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[398.799197, "o", "import json\r\n\u001b[?2004l\r \u001b[?2004h"]
[398.799251, "o", "> import numpy as np"]
[398.79928, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.799371, "o", "from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.799423, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[398.799492, "o", "def calculate_metrics(data, setpoint):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.799731, "o", "    \"\"\"Calculate performance metrics from control data.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.799835, "o", "    times = np.array([d['time'] for d in data])\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[398.799925, "o", "    temps = np.array([d['temperature'] for d in data])\r\n\u001b[?2004l\r"]
[398.799946, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[398.800026, "o", "\u001b[?2004h> "]
[398.800139, "o", "    # Find initial temperature (average of first few points)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.800164, "o", "> "]
[398.800244, "o", "    T_initial = np.mean(temps[:5])\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.800297, "o", ">     \r\n\u001b[?2004l\r"]
[398.800349, "o", "\u001b[?2004h>     # Max temperature\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.800389, "o", "> "]
[398.800413, "o", "    max_temp = np.max(temps)\r\n\u001b[?2004l\r,\r\n\u001b[?2004h> "]
[398.80044, "o", "    \r\n\u001b[?2004l\r  "]
[398.800468, "o", "\u001b[?2004h> "]
[398.800564, "o", "    # Rise time: time to reach 90% of setpoint change\r\n\u001b[?2004l\rg.\u001b[?2004h"]
[398.800589, "o", "> "]
[398.80073, "o", "    target_90 = T_initial + 0.9 * (setpoint - T_initial)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.800754, "o", "> "]
[398.800871, "o", "    rise_idx = np.where(temps >= target_90)[0]\r\n\u001b[?2004l\rn\")\r\n \u001b[?2004h"]
[398.800924, "o", "> "]
[398.801074, "o", "    rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.80112, "o", ">     \r\n\u001b[?2004l\r"]
[398.801161, "o", "\u001b[?2004h> "]
[398.80128, "o", "    # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)\r\n\u001b[?2004l\r"]
[398.801305, "o", "\u001b[?2004h> "]
[398.801508, "o", "    overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.801536, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.801845, "o", "    # Settling time: Use ±0.5°C criterion (consistent with steady-state error requirement)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.801996, "o", "    # Temperature must stay within ±0.5°C of setpoint for 10 seconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.802028, "o", "> "]
[398.802134, "o", "    settling_band = 0.5  # Absolute error in °C\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.802157, "o", "> "]
[398.8022, "o", "    settled = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.802224, "o", "> "]
[398.802295, "o", "    settling_time = times[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.80234, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.80239, "o", "> "]
[398.802576, "o", "    for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.8026, "o", "> "]
[398.802779, "o", "        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80288, "o", "            settling_time = times[i]\r\n\u001b[?2004l\r"]
[398.802931, "o", "\u001b[?2004h> "]
[398.802974, "o", "            settled = True\r\n\u001b[?2004l\r"]
[398.80303, "o", "\u001b[?2004h> "]
[398.80307, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.803094, "o", "> "]
[398.803247, "o", "    # Steady-state error: average error in last 20% of data\r\n\u001b[?2004l\r"]
[398.803273, "o", "\u001b[?2004h> "]
[398.803372, "o", "    steady_start = int(0.8 * len(temps))\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.803396, "o", "> "]
[398.803572, "o", "    steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.803618, "o", ">     \r\n\u001b[?2004l\r"]
[398.803645, "o", "\u001b[?2004h> "]
[398.803669, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.803782, "o", "        \"rise_time\": round(rise_time, 2),\r\n\u001b[?2004l\r"]
[398.803836, "o", "\u001b[?2004h> "]
[398.803893, "o", "        \"overshoot\": round(overshoot, 4),\r\n\u001b[?2004l\rve"]
[398.803937, "o", "\u001b[?2004h> "]
[398.804036, "o", "        \"settling_time\": round(settling_time, 2),\r\n\u001b[?2004l\r"]
[398.804061, "o", "\u001b[?2004h> "]
[398.804218, "o", "        \"steady_state_error\": round(steady_state_error, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.804263, "o", "> "]
[398.804338, "o", "        \"max_temp\": round(max_temp, 4)\r\n\u001b[?2004l\r"]
[398.804382, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.804426, "o", "> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[398.804477, "o", "def run_control():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.804515, "o", "    # Load tuned gains\r\n\u001b[?2004l\r"]
[398.80454, "o", "\u001b[?2004h> "]
[398.804621, "o", "    with open('tuned_gains.json', 'r') as f:\r\n\u001b[?2004l\r_\"\u001b[?2004h> "]
[398.804711, "o", "        gains = json.load(f)\r\n\u001b[?2004l\r"]
[398.804756, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.804808, "o", "    Kp = gains['Kp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.804857, "o", "    Ki = gains['Ki']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.804898, "o", "    Kd = gains['Kd']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.804951, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805026, "o", "    print(f\"Running closed-loop control with PID gains:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805079, "o", "    print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.805131, "o", "> "]
[398.805186, "o", "    print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805236, "o", "    print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[398.805277, "o", "\u001b[?2004h>     # Initialize simulator\r\n\u001b[?2004l\r"]
[398.805328, "o", "\u001b[?2004h> "]
[398.805382, "o", "    sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805433, "o", "    setpoint = sim.get_setpoint()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805517, "o", "    dt = sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805568, "o", "    print(f\"\\nSetpoint: {setpoint}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.805625, "o", "> "]
[398.805676, "o", "    print(f\"Control duration: 200s\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805736, "o", "    # Reset and get initial temperature\r\n\u001b[?2004l\r"]
[398.805781, "o", "\u001b[?2004h> "]
[398.805828, "o", "    initial_temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.805899, "o", "    print(f\"Initial temperature: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r"]
[398.805953, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.806004, "o", ">     # PID controller state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806061, "o", "    integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806104, "o", "    prev_error = setpoint - initial_temp\r\n\u001b[?2004l\r"]
[398.806149, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806189, "o", "    # Data collection\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806213, "o", "    data = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.806282, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.806323, "o", ">     # Run control loop\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806374, "o", "    duration = 200.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806415, "o", "    steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806461, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806504, "o", "    print(f\"\\nStarting control loop...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806549, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806588, "o", "    for step in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806687, "o", "        # Get current state from last step or initial\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80673, "o", "        if step == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806807, "o", "            current_temp = initial_temp\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.806833, "o", "> "]
[398.806894, "o", "            time = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.806944, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.806996, "o", "            time = data[-1]['time'] + dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807036, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807087, "o", "        # Calculate error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807132, "o", "        error = setpoint - current_temp\r\n\u001b[?2004l\r"]
[398.807183, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[398.807233, "o", "\u001b[?2004h>         # PID control\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807275, "o", "        # Proportional term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807323, "o", "        P = Kp * error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807369, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807423, "o", "        # Integral term with anti-windup\r\n\u001b[?2004l\r"]
[398.80747, "o", "\u001b[?2004h> "]
[398.807522, "o", "        integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.807603, "o", "        # Anti-windup: clamp integral to prevent excessive buildup\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.807655, "o", "> "]
[398.807702, "o", "        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.807756, "o", "> "]
[398.807817, "o", "        integral = np.clip(integral, -max_integral, max_integral)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.807869, "o", "> "]
[398.807919, "o", "        I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80796, "o", "        # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.808014, "o", "> "]
[398.808065, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808101, "o", "        D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808149, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.808174, "o", "> "]
[398.808218, "o", "        # Calculate control output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808276, "o", "        heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808328, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808369, "o", "        # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808477, "o", "        heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808527, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808581, "o", "        # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808653, "o", "        result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.8087, "o", "> "]
[398.808743, "o", "        current_temp = result['temperature']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80879, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808836, "o", "        # Log data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.808885, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80895, "o", "            \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r"]
[398.809003, "o", "\u001b[?2004h> "]
[398.809058, "o", "            \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.809098, "o", "> "]
[398.809145, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.809211, "o", "            \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.809267, "o", "> "]
[398.809313, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.809359, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.809384, "o", "> "]
[398.809458, "o", "        # Update for next iteration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.809512, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.80958, "o", "        # Print progress every 20 seconds\r\n\u001b[?2004l\r"]
[398.809627, "o", "\u001b[?2004h> "]
[398.809677, "o", "        if step % 40 == 0 or step == steps - 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.809726, "o", "> "]
[398.8099, "o", "            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.809991, "o", "    print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r"]
[398.810043, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810096, "o", ">     # Save control log\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810142, "o", ">     control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.810167, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r"]
[398.81023, "o", "\u001b[?2004h> "]
[398.810271, "o", "        \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.810318, "o", "        \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810373, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.810421, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810475, "o", "> "]
[398.810526, "o", "        json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[398.810568, "o", "\u001b[?2004h> "]
[398.810592, "o", "    print(\"Saved control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810658, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810714, "o", ">     # Calculate and save metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.810767, "o", "    metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810819, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.810869, "o", ">     print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r"]
[398.810923, "o", "\u001b[?2004h> "]
[398.810961, "o", "    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[398.811021, "o", "\u001b[?2004h> "]
[398.811066, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.811122, "o", "> "]
[398.811176, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[398.811222, "o", "\u001b[?2004h> "]
[398.811298, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r"]
[398.811349, "o", "\u001b[?2004h> "]
[398.811401, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.811447, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.811526, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.811577, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[398.811623, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.811668, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r"]
[398.811721, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.811764, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.811817, "o", "> "]
[398.811871, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.812081, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[398.812133, "o", "\u001b[?2004h> "]
[398.812278, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[398.812333, "o", "\u001b[?2004h> "]
[398.812465, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.812493, "o", "> "]
[398.81268, "o", "    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.812768, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r"]
[398.812813, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[398.812865, "o", "> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[398.812905, "o", "\u001b[?2004h>     run_control()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.812951, "o", "EOF\r\n\u001b[?2004l\r"]
