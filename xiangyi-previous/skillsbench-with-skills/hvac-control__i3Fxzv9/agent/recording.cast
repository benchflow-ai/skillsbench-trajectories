[107.871216, "o", "        # Derivative term\r\n\u001b[?2004l\r"]
[107.871251, "o", "\u001b[?2004h> "]
[107.871336, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r"]
[107.871377, "o", "\u001b[?2004h> "]
[107.871445, "o", "        D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.871488, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.871515, "o", "> "]
[107.871584, "o", "        # Calculate control output\r\n\u001b[?2004l\r"]
[107.871613, "o", "\u001b[?2004h> "]
[107.871823, "o", "        heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.871865, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.871895, "o", "        # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r"]
[107.871926, "o", "\u001b[?2004h> "]
[107.872088, "o", "        heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.87212, "o", "        \r\n"]
[107.872148, "o", "\u001b[?2004l\r\u001b[?2004h"]
[107.872173, "o", "> "]
[107.872317, "o", "        # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.872461, "o", "        result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.872527, "o", "        current_temp = result['temperature']\r\n\u001b[?2004l\r"]
[107.872566, "o", "\u001b[?2004h> "]
[107.872747, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.872856, "o", "        # Log data\r\n\u001b[?2004l\r\u001b[?2004h>         data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.872999, "o", "            \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r"]
[107.873163, "o", "\u001b[?2004h> "]
[107.873195, "o", "            \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873351, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873483, "o", "            \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873519, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873547, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873644, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873717, "o", "        # Update for next iteration\r\n\u001b[?2004l\r"]
[107.873791, "o", "\u001b[?2004h> "]
[107.873863, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873893, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.873973, "o", "        # Print progress every 30 seconds\r\n\u001b[?2004l\r"]
[107.874031, "o", "\u001b[?2004h> "]
[107.874185, "o", "        if step % 60 == 0 or step == steps - 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.874246, "o", "> "]
[107.874531, "o", "            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.874699, "o", "    print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.874798, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.87488, "o", "    # Save control log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.874937, "o", "    control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.87502, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.875133, "o", ">         \"setpoint\": setpoint,\r\n\u001b[?2004l\r"]
[107.87517, "o", "\u001b[?2004h>         \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.875242, "o", "> "]
[107.875335, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.875404, "o", "        json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[107.875484, "o", "\u001b[?2004h>     print(\"Saved control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.875562, "o", "    # Calculate and save metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.875589, "o", "> "]
[107.875674, "o", "    metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.875703, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.875732, "o", "> "]
[107.875841, "o", "    print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.875872, "o", "    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[107.875899, "o", "\u001b[?2004h> "]
[107.876008, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876137, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876361, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876469, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876514, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876709, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.876784, "o", "> "]
[107.876847, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.876873, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.876897, "o", "> "]
[107.876979, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r"]
[107.877007, "o", "\u001b[?2004h> "]
[107.877043, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.877069, "o", "> "]
[107.877149, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.877209, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.877235, "o", "> "]
[107.877499, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.877645, "o", "> "]
[107.877944, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.878564, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.878837, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.878877, "o", "\u001b[?2004h> "]
[107.879625, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     run_control()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[107.881329, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[108.037496, "i", "python3 control.py\n"]
[108.037748, "o", "python3 control.py\r\n\u001b[?2004l\r"]
[108.436837, "o", "Running closed-loop control with PID gains:\r\n  Kp = 8.6059\r\n  Ki = 0.0267\r\n  Kd = 0.0000\r\n"]
[108.436895, "o", "\r\nSetpoint: 22.0C\r\nControl duration: 150s minimum\r\n"]
[108.437052, "o", "Initial temperature: 17.92C\r\n\r\nStarting control loop...\r\n"]
[108.437106, "o", "  t=0.5s: T=17.95C, P=35.2%, error=4.08C\r\n"]
[108.438906, "o", "  t=30.5s: T=19.69C, P=22.7%, error=2.35C\r\n"]
[108.441067, "o", "  t=60.5s: T=20.14C, P=21.1%, error=1.97C\r\n"]
[108.443075, "o", "  t=90.5s: T=20.33C, P=21.7%, error=1.88C\r\n"]
[108.444814, "o", "  t=120.5s: T=20.42C, P=21.2%, error=1.67C\r\n"]
[108.446603, "o", "  t=150.0s: T=20.45C, P=21.3%, error=1.53C\r\n\r\nControl complete. Collected 300 data points.\r\n"]
[108.44886, "o", "Saved control_log.json\r\n"]
[108.449829, "o", "\r\nPerformance Metrics:\r\n  Rise time: 150.00s\r\n  Overshoot: 0.00%\r\n  Settling time: 150.00s\r\n  Steady-state error: 1.5845C\r\n"]
[108.449861, "o", "  Max temperature: 20.61C\r\n"]
[108.449995, "o", "\r\nSaved metrics.json\r\n\r\n=== Requirements Check ===\r\nSteady-state error < 0.5C: 1.5845C - FAIL\r\nSettling time < 120s: 150.00s - FAIL\r\nOvershoot < 10%: 0.00% - PASS\r\nMax temperature < 30C: 20.61C - PASS\r\n"]
[108.450022, "o", "Control duration >= 150s: 150.0s - PASS\r\n"]
[108.480852, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[130.307255, "i", "cat > tune_gains.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\n\nimport json\n\ndef tune_controller():\n    # Load estimated parameters\n    with open('estimated_params.json', 'r') as f:\n        params = json.load(f)\n    \n    K = params['K']\n    tau = params['tau']\n    \n    print(f\"Tuning controller with estimated parameters:\")\n    print(f\"  K = {K:.4f} C/%\")\n    print(f\"  tau = {tau:.2f} s\")\n    \n    # Lambda tuning (IMC-based PID tuning for first-order system)\n    # For first-order system: dT/dt = (1/tau) * (K*u + T_ambient - T)\n    # \n    # PID tuning rules:\n    #   Kp = tau / (K * lambda)\n    #   Ki = 1 / tau  \n    #   Kd = 0 (for first-order system)\n    #\n    # Lambda is the desired closed-loop time constant\n    # - Smaller lambda = faster response but more aggressive\n    # - Larger lambda = slower response but more robust\n    # \n    # Use smaller lambda for faster response to meet settling time < 120s\n    \n    lambda_factor = 0.4  # More aggressive tuning\n    lambda_val = lambda_factor * tau\n    \n    # Calculate PID gains\n    Kp = tau / (K * lambda_val)\n    Ki = 1.0 / tau\n    Kd = 0.0  # No derivative for first-order system\n    \n    print(f\"\\nTuning method: Lambda (IMC-based)\")\n    print(f\"  Lambda = {lambda_val:.2f} s (closed-loop time constant)\")\n    print(f\"  Lambda factor = {lambda_factor} (more aggressive for faster response)\")\n    print(f\"\\nCalculated gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Save tuned gains\n    gains = {\n        \"Kp\": round(Kp, 6),\n        \"Ki\": round(Ki, 6),\n        \"Kd\": round(Kd, 6),\n        \"lambda\": round(lambda_val, 4)\n    }\n    \n    with open('tuned_gains.json', 'w') as f:\n        json.dump(gains, f, indent=2)\n    \n    print(\"\\nSaved tuned_gains.json\")\n\nif __name__ == \"__main__\":\n    tune_controller()\nEOF\n"]
[130.307497, "o", "cat > tune_gains.py << 'EOF'\r\n\u001b[?2004l\r"]
[130.307582, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.307657, "o", "> "]
[130.30773, "o", "\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.307796, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[130.307863, "o", "\u001b[?2004l\r\u001b[?2004h> def tune_controller():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.30793, "o", "    # Load estimated parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.30801, "o", "    with open('estimated_params.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.30807, "o", "        params = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.308136, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308208, "o", "    K = params['K']\r\n\u001b[?2004l\r\u001b[?2004h>     tau = params['tau']\r\n\u001b[?2004l\r"]
[130.308267, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308348, "o", "    print(f\"Tuning controller with estimated parameters:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308408, "o", "    print(f\"  K = {K:.4f} C/%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.30847, "o", "    print(f\"  tau = {tau:.2f} s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.308546, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308621, "o", "    # Lambda tuning (IMC-based PID tuning for first-order system)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308745, "o", "    # For first-order system: dT/dt = (1/tau) * (K*u + T_ambient - T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308814, "o", "    # \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308893, "o", "    # PID tuning rules:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.308958, "o", "    #   Kp = tau / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h>     #   Ki = 1 / tau  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309018, "o", "    #   Kd = 0 (for first-order system)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309067, "o", "    #\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309144, "o", "    # Lambda is the desired closed-loop time constant\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309255, "o", "    # - Smaller lambda = faster response but more aggressive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309357, "o", "    # - Larger lambda = slower response but more robust\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309404, "o", "    # \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309526, "o", "    # Use smaller lambda for faster response to meet settling time < 120s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.30958, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309644, "o", "    lambda_factor = 0.4  # More aggressive tuning\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.309705, "o", "> "]
[130.309761, "o", "    lambda_val = lambda_factor * tau\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309813, "o", "    # Calculate PID gains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309868, "o", "    Kp = tau / (K * lambda_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.309919, "o", "    Ki = 1.0 / tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310015, "o", "    Kd = 0.0  # No derivative for first-order system\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310059, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310135, "o", "    print(f\"\\nTuning method: Lambda (IMC-based)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310275, "o", "    print(f\"  Lambda = {lambda_val:.2f} s (closed-loop time constant)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.3104, "o", "    print(f\"  Lambda factor = {lambda_factor} (more aggressive for faster response)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.310454, "o", "> "]
[130.310496, "o", "    print(f\"\\nCalculated gains:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310548, "o", "    print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310594, "o", "    print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.310642, "o", "> "]
[130.310684, "o", "    print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.310731, "o", "> "]
[130.310771, "o", "    # Save tuned gains\r\n\u001b[?2004l\r\u001b[?2004h>     gains = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.310814, "o", "> "]
[130.310859, "o", "        \"Kp\": round(Kp, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310903, "o", "        \"Ki\": round(Ki, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.310954, "o", "        \"Kd\": round(Kd, 6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.310996, "o", "> "]
[130.311047, "o", "        \"lambda\": round(lambda_val, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.31109, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.311138, "o", "> "]
[130.311187, "o", "    with open('tuned_gains.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.311249, "o", "        json.dump(gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.311288, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.311352, "o", "    print(\"\\nSaved tuned_gains.json\")\r\n\u001b[?2004l\r"]
[130.3114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.311443, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.311494, "o", "    tune_controller()\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.311545, "o", "> EOF\r\n\u001b[?2004l\r"]
