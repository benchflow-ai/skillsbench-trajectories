[237.368236, "o", "> "]
[237.368435, "o", "        \"steady_state_error\": round(steady_state_error, 4),\r\n\u001b[?2004l\r\u001b[?2004h>         \"max_temp\": round(max_temp, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.368507, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_control():\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.368541, "o", "> "]
[237.368656, "o", "    # Load tuned gains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.370437, "o", "    with open('tuned_gains.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         gains = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Kp = gains['Kp']\r\n\u001b[?2004l\r\u001b[?2004h>     Ki = gains['Ki']\r\n\u001b[?2004l\r\u001b[?2004h>     Kd = gains['Kd']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Running closed-loop control with PID gains:\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Initialize simulator\r\n\u001b[?2004l\r\u001b[?2004h>     sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h>     setpoint = sim.get_setpoint()\r\n\u001b[?2004l\r\u001b[?2004h>     dt = sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nSetpoint: {setpoint}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Control duration: 300s\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.370532, "o", "    # Reset and get initial temperature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.373492, "o", "    initial_temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Initial temperature: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # PID controller state\r\n\u001b[?2004l\r\u001b[?2004h>     integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     prev_error = setpoint - initial_temp\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Data collection\r\n\u001b[?2004l\r\u001b[?2004h>     data = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Run control loop for 300 seconds\r\n\u001b[?2004l\r\u001b[?2004h>     duration = 300.0\r\n\u001b[?2004l\r\u001b[?2004h>     steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nStarting control loop...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for step in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h>         # Get current state from last step or initial\r\n\u001b[?2004l\r\u001b[?2004h>         if step == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             current_temp = initial_temp\r\n\u001b[?2004l\r\u001b[?2004h>             time = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             time = data[-1]['time'] + dt\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Calculate error\r\n\u001b[?2004l\r\u001b[?2004h>         error = setpoint - current_temp\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # PID control\r\n\u001b[?2004l\r\u001b[?2004h>         # Proportional term\r\n\u001b[?2004l\r\u001b[?2004h>         P = Kp * error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Integral term with anti-windup\r\n\u001b[?2004l\r\u001b[?2004h>         integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h>         # Anti-windup: clamp integral to prevent excessive buildup\r\n\u001b[?2004l\r"]
[237.37352, "o", "\u001b[?2004h> "]
[237.377538, "o", "        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\r\n\u001b[?2004l\r\u001b[?2004h>         integral = np.clip(integral, -max_integral, max_integral)\r\n\u001b[?2004l\r\u001b[?2004h>         I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h>         derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h>         D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Calculate control output\r\n\u001b[?2004l\r\u001b[?2004h>         heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r\u001b[?2004h>         heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h>         result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h>         current_temp = result['temperature']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Log data\r\n\u001b[?2004l\r\u001b[?2004h>         data.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r\u001b[?2004h>             \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r\u001b[?2004h>             \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h>             \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h>             \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Update for next iteration\r\n\u001b[?2004l\r\u001b[?2004h>         prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Print progress every 30 seconds\r\n\u001b[?2004l\r\u001b[?2004h>         if step % 60 == 0 or step == steps - 1:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save control log\r\n\u001b[?2004l\r\u001b[?2004h>     control_log = {\r\n\u001b[?2004l\r\u001b[?2004h>         \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h>         \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r"]
[237.377573, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.377664, "o", "    print(\"Saved control_log.json\")\r\n\u001b[?2004l\r"]
[237.377684, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[237.377706, "o", "\u001b[?2004h> "]
[237.377788, "o", "    # Calculate and save metrics\r\n\u001b[?2004l\r"]
[237.377814, "o", "\u001b[?2004h> "]
[237.377919, "o", "    metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r"]
[237.377948, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.377972, "o", "> "]
[237.378152, "o", "    print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[237.378174, "o", "\u001b[?2004h> "]
[237.378255, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r"]
[237.37828, "o", "\u001b[?2004h> "]
[237.37837, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.378393, "o", "> "]
[237.378484, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r"]
[237.378517, "o", "\u001b[?2004h> "]
[237.378626, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r"]
[237.378657, "o", "\u001b[?2004h>     \r\n"]
[237.378704, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.378773, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r"]
[237.378794, "o", "\u001b[?2004h> "]
[237.378897, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[237.378916, "o", "\u001b[?2004h> "]
[237.378936, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.378956, "o", "> "]
[237.379028, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r"]
[237.379066, "o", "\u001b[?2004h> "]
[237.379097, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.37912, "o", "> "]
[237.379169, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r"]
[237.379189, "o", "\u001b[?2004h> "]
[237.379244, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r"]
[237.379269, "o", "\u001b[?2004h> "]
[237.37951, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[237.379532, "o", "\u001b[?2004h> "]
[237.379722, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[237.379764, "o", "\u001b[?2004h> "]
[237.37997, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[237.380001, "o", "\u001b[?2004h> "]
[237.380225, "o", "    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[237.38025, "o", "\u001b[?2004h> "]
[237.380381, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r"]
[237.380407, "o", "\u001b[?2004h> \r\n"]
[237.38044, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.3805, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[237.380525, "o", "\u001b[?2004h> "]
[237.380574, "o", "    run_control()\r\n\u001b[?2004l\r"]
[237.3806, "o", "\u001b[?2004h> "]
