[362.598351, "o", "times = np.array([d['time'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[362.598438, "o", "temps = np.array([d['temperature'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[362.598476, "o", "print(\"Checking settling with different bands:\")\r\n\u001b[?2004l\r\u001b[?2004h> for band in [0.3, 0.4, 0.5]:\r\n\u001b[?2004l\r"]
[362.598498, "o", "\u001b[?2004h> "]
[362.598655, "o", "    print(f\"\\nBand: ±{band}°C\")\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(temps) - 20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[362.598764, "o", "        if all(abs(temps[i:i+20] - setpoint) <= band):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[362.598856, "o", "            print(f\"  Settled at t={times[i]:.1f}s\")\r\n\u001b[?2004l\r"]
[362.598915, "o", "\u001b[?2004h> "]
[362.598974, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[362.599019, "o", "\u001b[?2004h> "]
[362.599056, "o", "        print(f\"  Not settled\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[362.599103, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
