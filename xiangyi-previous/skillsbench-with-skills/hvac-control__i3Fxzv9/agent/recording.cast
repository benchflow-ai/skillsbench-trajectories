[346.263679, "o", "  t=200.0s: T=21.92C, P=33.1%, error=0.27C\r\n\r\nControl complete. Collected 400 data points.\r\n"]
[346.305076, "o", "Saved control_log.json\r\n"]
[346.307436, "o", "\r\nPerformance Metrics:\r\n  Rise time: 27.50s\r\n  Overshoot: 0.00%\r\n  Settling time: 200.00s (±0.3°C criterion)\r\n  Steady-state error: 0.2536C\r\n"]
[346.307551, "o", "  Max temperature: 21.98C\r\n"]
[346.308952, "o", "\r\nSaved metrics.json\r\n\r\n=== Requirements Check ===\r\nSteady-state error < 0.5C: 0.2536C - PASS\r\nSettling time < 120s: 200.00s - FAIL\r\nOvershoot < 10%: 0.00% - PASS\r\nMax temperature < 30C: 21.98C - PASS\r\nControl duration >= 150s: 200.0s - PASS\r\n"]
[346.334643, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[362.597364, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\n\nwith open('control_log.json', 'r') as f:\n    log = json.load(f)\n\ndata = log['data']\nsetpoint = 22.0\n\ntimes = np.array([d['time'] for d in data])\ntemps = np.array([d['temperature'] for d in data])\n\nprint(\"Checking settling with different bands:\")\nfor band in [0.3, 0.4, 0.5]:\n    print(f\"\\nBand: ±{band}°C\")\n    for i in range(len(temps) - 20):\n        if all(abs(temps[i:i+20] - setpoint) <= band):\n            print(f\"  Settled at t={times[i]:.1f}s\")\n            break\n    else:\n        print(f\"  Not settled\")\n\n# Check when it first gets close\nprint(\"\\nFirst time within different error bands:\")\nfor band in [0.5, 0.4, 0.3]:\n    idx = np.where(abs(temps - setpoint) <= band)[0]\n    if len(idx) > 0:\n        print(f\"  Within ±{band}°C at t={times[idx[0]]:.1f}s\")\nEOF\n"]
[362.597632, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[362.597727, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[362.597802, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
