[345.626827, "o", "        integral = np.clip(integral, -max_integral, max_integral)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.626872, "o", "> "]
[345.626926, "o", "        I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[345.626971, "o", "\u001b[?2004h>         # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627054, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r"]
[345.627106, "o", "\u001b[?2004h> "]
[345.627152, "o", "        D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[345.627182, "o", "\u001b[?2004h> "]
[345.627255, "o", "        # Calculate control output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627304, "o", "        heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.627335, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627406, "o", "        # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627484, "o", "        heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r"]
[345.627537, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.627578, "o", "> "]
[345.627631, "o", "        # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627673, "o", "        result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627752, "o", "        current_temp = result['temperature']\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.627805, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627858, "o", "        # Log data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627905, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.627959, "o", "            \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.628012, "o", "> "]
[345.628052, "o", "            \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r"]
[345.628097, "o", "\u001b[?2004h> "]
[345.628143, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.628196, "o", "> "]
[345.628247, "o", "            \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.628291, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r"]
[345.628316, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[345.628379, "o", "\u001b[?2004h> "]
[345.62842, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.62847, "o", "        # Update for next iteration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.62852, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[345.628568, "o", "\u001b[?2004h> "]
[345.628617, "o", "        # Print progress every 20 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.628682, "o", "        if step % 40 == 0 or step == steps - 1:\r\n\u001b[?2004l\r"]
[345.628729, "o", "\u001b[?2004h> "]
[345.628867, "o", "            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r"]
[345.628889, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.628968, "o", "\u001b[?2004h> "]
[345.629019, "o", "    print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.629045, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.629071, "o", "> "]
[345.629126, "o", "    # Save control log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.62916, "o", "    control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.629239, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.62933, "o", "        \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.62936, "o", "        \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.629437, "o", "\u001b[?2004h> "]
[345.629489, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.629567, "o", "        json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.629596, "o", "\u001b[?2004h> "]
[345.629647, "o", "    print(\"Saved control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.629677, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.629711, "o", "> "]
[345.629826, "o", "    # Calculate and save metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.629861, "o", ">     metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.629935, "o", "    print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.630022, "o", "    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.63005, "o", "> "]
[345.630126, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.630179, "o", "> "]
[345.630268, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s (±0.3°C criterion)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.630313, "o", "> "]
[345.630389, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.630441, "o", "> "]
[345.63049, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.630543, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.630595, "o", ">     with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r"]
[345.63064, "o", "\u001b[?2004h> "]
[345.63069, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.630736, "o", "\u001b[?2004h> "]
[345.630792, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.630835, "o", "\u001b[?2004h> "]
[345.630892, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.63093, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.63096, "o", "> "]
[345.631153, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.631203, "o", "> "]
[345.631353, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[345.631405, "o", "\u001b[?2004h> "]
[345.631535, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.631589, "o", "> "]
[345.631716, "o", "    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.631764, "o", "> "]
[345.631839, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r"]
[345.631889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.631937, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.631992, "o", "    run_control()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.632036, "o", "EOF\r\n\u001b[?2004l\r"]
[345.641396, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[345.780314, "i", "python3 control.py\n"]
[345.780491, "o", "python3 control.py\r\n\u001b[?2004l\r"]
