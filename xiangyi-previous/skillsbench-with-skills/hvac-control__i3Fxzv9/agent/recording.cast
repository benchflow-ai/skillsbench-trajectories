[305.017781, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[305.49971, "i", "cat > control.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Closed-loop control: Run PID controller to reach setpoint.\"\"\"\n\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\ndef calculate_metrics(data, setpoint):\n    \"\"\"Calculate performance metrics from control data.\"\"\"\n    times = np.array([d['time'] for d in data])\n    temps = np.array([d['temperature'] for d in data])\n    \n    # Find initial temperature (average of first few points)\n    T_initial = np.mean(temps[:5])\n    \n    # Max temperature\n    max_temp = np.max(temps)\n    \n    # Rise time: time to reach 90% of setpoint change\n    target_90 = T_initial + 0.9 * (setpoint - T_initial)\n    rise_idx = np.where(temps >= target_90)[0]\n    rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]\n    \n    # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)\n    overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))\n    \n    # Settling time: time to stay within 5% of setpoint (more realistic with noise)\n    settling_band = 0.05 * abs(setpoint - T_initial)\n    settled = False\n    settling_time = times[-1]\n    \n    for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)\n        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\n            settling_time = times[i]\n            settled = True\n            break\n    \n    # Steady-state error: average error in last 20% of data\n    steady_start = int(0.8 * len(temps))\n    steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)\n    \n    return {\n        \"rise_time\": round(rise_time, 2),\n        \"overshoot\": round(overshoot, 4),\n        \"settling_time\": round(settling_time, 2),\n        \"steady_state_error\": round(steady_state_error, 4),\n        \"max_temp\": round(max_temp, 4)\n    }\n\ndef run_control():\n    # Load tuned gains\n    with open('tuned_gains.json', 'r') as f:\n        gains = json.load(f)\n    \n    Kp = gains['Kp']\n    Ki = gains['Ki']\n    Kd = gains['Kd']\n    \n    print(f\"Running closed-loop control with PID gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Initialize simulator\n    sim = HVACSimulator()\n    setpoint = sim.get_setpoint()\n    dt = sim.get_dt()\n    \n    print(f\"\\nSetpoint: {setpoint}C\")\n    print(f\"Control duration: 200s\")\n    \n    # Reset and get initial temperature\n    initial_temp = sim.reset()\n    print(f\"Initial temperature: {initial_temp:.2f}C\")\n    \n    # PID controller state\n    integral = 0.0\n    prev_error = setpoint - initial_temp\n    \n    # Data collection\n    data = []\n    \n    # Run control loop\n    duration = 200.0\n    steps = int(duration / dt)\n    \n    print(f\"\\nStarting control loop...\")\n    \n    for step in range(steps):\n        # Get current state from last step or initial\n        if step == 0:\n            current_temp = initial_temp\n            time = 0.0\n        else:\n            time = data[-1]['time'] + dt\n        \n        # Calculate error\n        error = setpoint - current_temp\n        \n        # PID control\n        # Proportional term\n        P = Kp * error\n        \n        # Integral term with anti-windup\n        integral += error * dt\n        # Anti-windup: clamp integral to prevent excessive buildup\n        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\n        integral = np.clip(integral, -max_integral, max_integral)\n        I = Ki * integral\n        \n        # Derivative term\n        derivative = (error - prev_error) / dt\n        D = Kd * derivative\n        \n        # Calculate control output\n        heater_power = P + I + D\n        \n        # Clamp to valid range [0, 100]\n        heater_power = np.clip(heater_power, 0.0, 100.0)\n        \n        # Apply control and step simulation\n        result = sim.step(heater_power)\n        current_temp = result['temperature']\n        \n        # Log data\n        data.append({\n            \"time\": round(result['time'], 2),\n            \"temperature\": round(current_temp, 4),\n            \"setpoint\": setpoint,\n            \"heater_power\": round(heater_power, 2),\n            \"error\": round(error, 4)\n      "]
[305.49987, "i", "  })\n        \n        # Update for next iteration\n        prev_error = error\n        \n        # Print progress every 20 seconds\n        if step % 40 == 0 or step == steps - 1:\n            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\n    \n    print(f\"\\nControl complete. Collected {len(data)} data points.\")\n    \n    # Save control log\n    control_log = {\n        \"phase\": \"control\",\n        \"setpoint\": setpoint,\n        \"data\": data\n    }\n    \n    with open('control_log.json', 'w') as f:\n        json.dump(control_log, f, indent=2)\n    \n    print(\"Saved control_log.json\")\n    \n    # Calculate and save metrics\n    metrics = calculate_metrics(data, setpoint)\n    \n    print(f\"\\nPerformance Metrics:\")\n    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\n    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\n    print(f\"  Settling time: {metrics['settling_time']:.2f}s (5% criterion)\")\n    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\n    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\n    \n    with open('metrics.json', 'w') as f:\n        json.dump(metrics, f, indent=2)\n    \n    print(\"\\nSaved metrics.json\")\n    \n    # Check if requirements are met\n    print(\"\\n=== Requirements Check ===\")\n    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\n    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\n    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\n    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\n    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\n\nif __name__ == \"__main__\":\n    run_control()\nEOF\n"]
[305.500063, "o", "cat > control.py << 'EOF'\r\n\u001b[?2004l\r"]
[305.500118, "o", "\u001b[?2004h> "]
[305.500201, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.500246, "o", "> "]
[305.500409, "o", "\"\"\"Closed-loop control: Run PID controller to reach setpoint.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.500464, "o", "> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[305.500509, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.500573, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[305.500667, "o", "\u001b[?2004h> "]
[305.500788, "o", "from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.500852, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50098, "o", "def calculate_metrics(data, setpoint):\r\n\u001b[?2004l\r"]
[305.501027, "o", "\u001b[?2004h> "]
[305.501273, "o", "    \"\"\"Calculate performance metrics from control data.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.501316, "o", "> "]
[305.501543, "o", "    times = np.array([d['time'] for d in data])\r\n\u001b[?2004l\r"]
[305.501597, "o", "\u001b[?2004h> "]
[305.501821, "o", "    temps = np.array([d['temperature'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.501881, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.501919, "o", "> "]
[305.502234, "o", "    # Find initial temperature (average of first few points)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.502351, "o", "    T_initial = np.mean(temps[:5])\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.502417, "o", ">     \r\n\u001b[?2004l\r"]
[305.502459, "o", "\u001b[?2004h> "]
[305.502511, "o", "    # Max temperature\r\n\u001b[?2004l\r"]
[305.50257, "o", "\u001b[?2004h> "]
[305.502713, "o", "    max_temp = np.max(temps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.502776, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.503026, "o", "    # Rise time: time to reach 90% of setpoint change\r\n\u001b[?2004l\rprint\u001b[?2004h> "]
[305.503216, "o", "    target_90 = T_initial + 0.9 * (setpoint - T_initial)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50343, "o", "    rise_idx = np.where(temps >= target_90)[0]\r\n\u001b[?2004l\r"]
[305.503501, "o", "\u001b[?2004h> "]
[305.503819, "o", "    rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]\r\n\u001b[?2004l\r"]
[305.50387, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[305.503938, "o", "\u001b[?2004h> "]
[305.504178, "o", "    # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)\r\n\u001b[?2004l\r"]
[305.504207, "o", "\u001b[?2004h> "]
[305.504557, "o", "    overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))\r\n\u001b[?2004l\r"]
[305.504607, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[305.504664, "o", "\u001b[?2004h> "]
[305.50503, "o", "    # Settling time: time to stay within 5% of setpoint (more realistic with noise)\r\n\u001b[?2004l\r"]
[305.505083, "o", "\u001b[?2004h> "]
[305.505314, "o", "    settling_band = 0.05 * abs(setpoint - T_initial)\r\n\u001b[?2004l\r"]
[305.505359, "o", "\u001b[?2004h> "]
[305.50546, "o", "    settled = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.505522, "o", "> "]
[305.505634, "o", "    settling_time = times[-1]\r\n\u001b[?2004l\r"]
[305.505685, "o", "\u001b[?2004h> "]
[305.505736, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.506088, "o", "    for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)\r\n\u001b[?2004l\r"]
[305.506117, "o", "\u001b[?2004h> "]
[305.506313, "o", "        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.506338, "o", "> "]
[305.506434, "o", "            settling_time = times[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.506528, "o", "            settled = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.506585, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.506627, "o", ">     \r\n\u001b[?2004l\re_\u001b[?2004h"]
[305.506673, "o", "> "]
[305.506817, "o", "    # Steady-state error: average error in last 20% of data\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.506847, "o", "> "]
[305.506941, "o", "    steady_start = int(0.8 * len(temps))\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.506992, "o", "> "]
[305.507154, "o", "    steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.507207, "o", ">     \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[305.507255, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50736, "o", "        \"rise_time\": round(rise_time, 2),\r\n\u001b[?2004l\r"]
[305.507406, "o", "\u001b[?2004h> "]
[305.507484, "o", "        \"overshoot\": round(overshoot, 4),\r\n\u001b[?2004l\r"]
[305.507529, "o", "\u001b[?2004h> "]
[305.507634, "o", "        \"settling_time\": round(settling_time, 2),\r\n\u001b[?2004l\r"]
[305.50766, "o", "\u001b[?2004h> "]
[305.507772, "o", "        \"steady_state_error\": round(steady_state_error, 4),\r\n\u001b[?2004l\r"]
[305.507797, "o", "\u001b[?2004h> "]
[305.507904, "o", "        \"max_temp\": round(max_temp, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.507949, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rL"]
[305.507995, "o", "\u001b[?2004h> "]
[305.508036, "o", "def run_control():\r\n\u001b[?2004l\rCo\u001b[?2004h> "]
[305.508098, "o", "    # Load tuned gains\r\n\u001b[?2004l\r"]
[305.508142, "o", "\u001b[?2004h> "]
[305.508239, "o", "    with open('tuned_gains.json', 'r') as f:\r\n\u001b[?2004l\r"]
[305.508266, "o", "\u001b[?2004h> "]
[305.508342, "o", "        gains = json.load(f)\r\n\u001b[?2004l\rt\u001b[?2004h"]
[305.508367, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.508424, "o", ">     Kp = gains['Kp']\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.508448, "o", "> "]
[305.508509, "o", "    Ki = gains['Ki']\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.50856, "o", ">     Kd = gains['Kd']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.50861, "o", "> "]
[305.508649, "o", "    print(f\"Running closed-loop control with PID gains:\")\r\n\u001b[?2004l\r"]
[305.508704, "o", "\u001b[?2004h> "]
[305.508754, "o", "    print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.508804, "o", "    print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50884, "o", "    print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r"]
[305.508884, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.508923, "o", "    # Initialize simulator\r\n\u001b[?2004l\r"]
[305.508977, "o", "\u001b[?2004h> "]
[305.509028, "o", "    sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509078, "o", "    setpoint = sim.get_setpoint()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509127, "o", "    dt = sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509176, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509224, "o", "    print(f\"\\nSetpoint: {setpoint}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50927, "o", "    print(f\"Control duration: 200s\")\r\n\u001b[?2004l\r"]
[305.509327, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.509378, "o", ">     # Reset and get initial temperature\r\n\u001b[?2004l\r"]
[305.509429, "o", "\u001b[?2004h> "]
[305.509504, "o", "    initial_temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.50955, "o", "    print(f\"Initial temperature: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r"]
[305.509602, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509651, "o", "    # PID controller state\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.509702, "o", ">     integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509757, "o", "    prev_error = setpoint - initial_temp\r\n\u001b[?2004l\r"]
[305.509812, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[305.509854, "o", "\u001b[?2004h>     # Data collection\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.509898, "o", "    data = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.509951, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510005, "o", "    # Run control loop\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510045, "o", "    duration = 200.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510097, "o", "    steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.510147, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510187, "o", "    print(f\"\\nStarting control loop...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510239, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510289, "o", "    for step in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510358, "o", "        # Get current state from last step or initial\r\n\u001b[?2004l\r"]
[305.510385, "o", "\u001b[?2004h> "]
[305.510411, "o", "        if step == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.510498, "o", "> "]
[305.510553, "o", "            current_temp = initial_temp\r\n\u001b[?2004l\r\u001b[?2004h>             time = 0.0\r\n\u001b[?2004l\r"]
[305.510608, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510659, "o", "            time = data[-1]['time'] + dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.510714, "o", ">         \r\n\u001b[?2004l\r"]
[305.510767, "o", "\u001b[?2004h>         # Calculate error\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.51081, "o", "> "]
[305.510875, "o", "        error = setpoint - current_temp\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.51093, "o", "        # PID control\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.510978, "o", "        # Proportional term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.511026, "o", "        P = Kp * error\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.511078, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.511123, "o", "        # Integral term with anti-windup\r\n\u001b[?2004l\r"]
[305.511177, "o", "\u001b[?2004h> "]
[305.511227, "o", "        integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.511298, "o", "        # Anti-windup: clamp integral to prevent excessive buildup\r\n\u001b[?2004l\r"]
[305.511352, "o", "\u001b[?2004h> "]
[305.5114, "o", "        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.511455, "o", "> "]
[305.511513, "o", "        integral = np.clip(integral, -max_integral, max_integral)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.511566, "o", "> "]
[305.511616, "o", "        I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.511663, "o", ">         # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.511713, "o", "> "]
[305.511771, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.511821, "o", "        D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.51187, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.511908, "o", "        # Calculate control output\r\n\u001b[?2004l\r"]
[305.511961, "o", "\u001b[?2004h> "]
[305.512005, "o", "        heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[305.512051, "o", "\u001b[?2004h> "]
[305.512099, "o", "        # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.51215, "o", "> "]
[305.512194, "o", "        heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512246, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512289, "o", "> "]
[305.512341, "o", "        # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.512383, "o", "        result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512414, "o", "> "]
[305.512469, "o", "        current_temp = result['temperature']\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512537, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512588, "o", ">         # Log data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.512637, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.512678, "o", "            \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r"]
[305.512724, "o", "\u001b[?2004h> "]
[305.512768, "o", "            \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r"]
[305.512815, "o", "\u001b[?2004h> "]
[305.512862, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512907, "o", "> "]
[305.512952, "o", "            \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.512981, "o", "> "]
[305.513041, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.513096, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[305.513135, "o", "\u001b[?2004h>         # Update for next iteration\r\n\u001b[?2004l\r"]
[305.513192, "o", "\u001b[?2004h> "]
[305.513242, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[305.513291, "o", "\u001b[?2004h> "]
[305.51334, "o", "        # Print progress every 20 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.513394, "o", "        if step % 40 == 0 or step == steps - 1:\r\n\u001b[?2004l\r"]
[305.513465, "o", "\u001b[?2004h> "]
[305.513668, "o", "            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.513726, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.513834, "o", "    print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.513885, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.513932, "o", "    # Save control log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.513979, "o", "    control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514021, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514077, "o", "        \"setpoint\": setpoint,\r\n\u001b[?2004l\r"]
[305.514102, "o", "\u001b[?2004h> "]
[305.514149, "o", "        \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.514198, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[305.514265, "o", "\u001b[?2004h> "]
[305.514316, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514365, "o", "        json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514415, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514467, "o", "    print(\"Saved control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514508, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.514565, "o", "    # Calculate and save metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.514618, "o", "> "]
[305.51467, "o", "    metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.51472, "o", "    print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r"]
[305.514766, "o", "\u001b[?2004h> "]
[305.514823, "o", "    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.514877, "o", "> "]
[305.514929, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.514975, "o", "> "]
[305.515055, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s (5% criterion)\")\r\n\u001b[?2004l\r"]
[305.515104, "o", "\u001b[?2004h> "]
[305.51518, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r"]
[305.515235, "o", "\u001b[?2004h> "]
[305.515285, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.515337, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.51538, "o", "> "]
[305.515436, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.515483, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.515533, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.515576, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.515633, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.51568, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.515709, "o", "> "]
[305.515777, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.515831, "o", "> "]
[305.51598, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.516155, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[305.516203, "o", "\u001b[?2004h> "]
[305.516339, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.516386, "o", "> "]
[305.516521, "o", "    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[305.516573, "o", "\u001b[?2004h> "]
[305.516645, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r"]
[305.516698, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.516748, "o", "> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.516799, "o", "    run_control()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.516848, "o", "EOF\r\n\u001b[?2004l\r"]
[305.518108, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[305.612851, "i", "python3 control.py\n"]
[305.613058, "o", "python3 control.py\r\n\u001b[?2004l\r"]
[306.013275, "o", "Running closed-loop control with PID gains:\r\n  Kp = 43.0293\r\n  Ki = 0.2134\r\n  Kd = 0.0000\r\n"]
[306.013437, "o", "\r\nSetpoint: 22.0C\r\nControl duration: 200s\r\nInitial temperature: 17.99C\r\n\r\nStarting control loop...\r\n"]
[306.013516, "o", "  t=0.5s: T=18.02C, P=100.0%, error=4.01C\r\n"]
[306.014755, "o", "  t=20.5s: T=21.29C, P=38.9%, error=0.72C\r\n"]
[306.015907, "o", "  t=40.5s: T=21.63C, P=24.9%, error=0.34C\r\n"]
[306.017101, "o", "  t=60.5s: T=21.65C, P=32.0%, error=0.46C\r\n"]
[306.018285, "o", "  t=80.5s: T=21.60C, P=24.1%, error=0.24C\r\n"]
[306.019475, "o", "  t=100.5s: T=21.70C, P=31.9%, error=0.38C\r\n"]
[306.020637, "o", "  t=120.5s: T=21.74C, P=33.5%, error=0.39C\r\n"]
[306.021835, "o", "  t=140.5s: T=21.69C, P=31.5%, error=0.31C\r\n"]
[306.023031, "o", "  t=160.5s: T=21.87C, P=41.7%, error=0.52C\r\n"]
