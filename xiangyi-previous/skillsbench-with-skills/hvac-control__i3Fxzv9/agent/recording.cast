[237.981899, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[257.65891, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\n\n# Load control log\nwith open('control_log.json', 'r') as f:\n    log = json.load(f)\n\ndata = log['data']\nsetpoint = log['setpoint']\n\ntimes = np.array([d['time'] for d in data])\ntemps = np.array([d['temperature'] for d in data])\nerrors = np.array([d['error'] for d in data])\n\nT_initial = np.mean(temps[:5])\nprint(f\"Initial temp: {T_initial:.2f}C\")\nprint(f\"Setpoint: {setpoint}C\")\nprint(f\"Temperature change: {setpoint - T_initial:.2f}C\")\n\n# Check settling with different criteria\nfor settling_pct in [0.02, 0.05, 0.10]:\n    settling_band = settling_pct * abs(setpoint - T_initial)\n    print(f\"\\nSettling band ({settling_pct*100:.0f}%): ±{settling_band:.4f}C\")\n    \n    # Find first time it enters and stays in band for 10 seconds (20 points)\n    for i in range(len(temps) - 20):\n        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\n            print(f\"  Settled at t={times[i]:.1f}s\")\n            break\n    else:\n        print(f\"  Not settled within duration\")\n\n# Show last 20 data points\nprint(\"\\nLast 20 data points:\")\nfor i in range(-20, 0):\n    print(f\"  t={times[i]:.1f}s: T={temps[i]:.2f}C, error={errors[i]:.4f}C\")\n\nEOF\n"]
[257.661588, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[257.661682, "o", "\u001b[?2004h> "]
[257.661717, "o", "import json\r\n\u001b[?2004l\r"]
[257.661744, "o", "\u001b[?2004h> "]
[257.661932, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.662011, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Load control log\r\n\u001b[?2004l\r"]
[257.662074, "o", "\u001b[?2004h> "]
[257.662211, "o", "with open('control_log.json', 'r') as f:\r\n"]
[257.66227, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[257.662359, "o", "    log = json.load(f)\r\n"]
[257.662417, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[257.662476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.662557, "o", "data = log['data']\r\n"]
[257.662616, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[257.662731, "o", "setpoint = log['setpoint']\r\n"]
[257.662791, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.66285, "o", "\u001b[?2004h> "]
[257.663993, "o", "times = np.array([d['time'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> temps = np.array([d['temperature'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> errors = np.array([d['error'] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> T_initial = np.mean(temps[:5])\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Initial temp: {T_initial:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Setpoint: {setpoint}C\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Temperature change: {setpoint - T_initial:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.66404, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.664068, "o", "> "]
[257.666354, "o", "# Check settling with different criteria\r\n\u001b[?2004l\r\u001b[?2004h> for settling_pct in [0.02, 0.05, 0.10]:\r\n\u001b[?2004l\r\u001b[?2004h>     settling_band = settling_pct * abs(setpoint - T_initial)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nSettling band ({settling_pct*100:.0f}%): ±{settling_band:.4f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find first time it enters and stays in band for 10 seconds (20 points)\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(temps) - 20):\r\n\u001b[?2004l\r\u001b[?2004h>         if all(abs(temps[i:i+20] - setpoint) <= settling_band):\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  Settled at t={times[i]:.1f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Not settled within duration\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Show last 20 data points\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nLast 20 data points:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
