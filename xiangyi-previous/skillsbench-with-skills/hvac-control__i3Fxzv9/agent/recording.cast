[168.798976, "o", "> "]
[168.799033, "o", "        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799146, "o", "        integral = np.clip(integral, -max_integral, max_integral)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799199, "o", "        I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.799251, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799314, "o", "        # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799394, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799454, "o", "        D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799512, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799576, "o", "        # Calculate control output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799634, "o", "        heater_power = P + I + D\r\n\u001b[?2004l\r"]
[168.799694, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.799775, "o", "        # Clamp to valid range [0, 100]\r\n\u001b[?2004l\r"]
[168.799834, "o", "\u001b[?2004h> "]
[168.799882, "o", "        heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r"]
[168.799934, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[168.799984, "o", "> "]
[168.800048, "o", "        # Apply control and step simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800121, "o", "        result = sim.step(heater_power)\r\n\u001b[?2004l\r"]
[168.800172, "o", "\u001b[?2004h> "]
[168.80022, "o", "        current_temp = result['temperature']\r\n\u001b[?2004l\r"]
[168.800273, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800319, "o", "        # Log data\r\n\u001b[?2004l\r"]
[168.800368, "o", "\u001b[?2004h> "]
[168.800418, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800492, "o", "            \"time\": round(result['time'], 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800583, "o", "            \"temperature\": round(current_temp, 4),\r\n\u001b[?2004l\r"]
[168.800639, "o", "\u001b[?2004h> "]
[168.800698, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800793, "o", "            \"heater_power\": round(heater_power, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.800862, "o", "> "]
[168.800914, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.800976, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.80104, "o", "        # Update for next iteration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.801087, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[168.801134, "o", "\u001b[?2004h> "]
[168.801189, "o", "        # Print progress every 30 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.80126, "o", "        if step % 60 == 0 or step == steps - 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.80131, "o", "> "]
[168.801487, "o", "            print(f\"  t={result['time']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[168.801545, "o", "> "]
[168.801628, "o", "    print(f\"\\nControl complete. Collected {len(data)} data points.\")\r\n\u001b[?2004l\r"]
[168.801698, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[168.801771, "o", "\u001b[?2004h>     # Save control log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.801839, "o", "    control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.801911, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.801961, "o", "        \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.80201, "o", "        \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.802059, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.802133, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r"]
[168.80218, "o", "\u001b[?2004h> "]
[168.802233, "o", "        json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r"]
[168.80228, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.802351, "o", "    print(\"Saved control_log.json\")\r\n\u001b[?2004l\r"]
[168.802401, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.802469, "o", "    # Calculate and save metrics\r\n\u001b[?2004l\r"]
[168.802517, "o", "\u001b[?2004h> "]
[168.80257, "o", "    metrics = calculate_metrics(data, setpoint)\r\n\u001b[?2004l\r"]
[168.802618, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.802687, "o", "    print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r"]
[168.802737, "o", "\u001b[?2004h> "]
[168.802808, "o", "    print(f\"  Rise time: {metrics['rise_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[168.802856, "o", "\u001b[?2004h> "]
[168.802928, "o", "    print(f\"  Overshoot: {metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r"]
[168.802977, "o", "\u001b[?2004h> "]
[168.803058, "o", "    print(f\"  Settling time: {metrics['settling_time']:.2f}s\")\r\n\u001b[?2004l\r"]
[168.803105, "o", "\u001b[?2004h> "]
[168.803213, "o", "    print(f\"  Steady-state error: {metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.803322, "o", "    print(f\"  Max temperature: {metrics['max_temp']:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.803376, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.803444, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.803522, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[168.803577, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.803641, "o", "    print(\"\\nSaved metrics.json\")\r\n\u001b[?2004l\r"]
[168.80371, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[168.803747, "o", "\u001b[?2004h> "]
[168.803817, "o", "    # Check if requirements are met\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.803874, "o", "    print(\"\\n=== Requirements Check ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.804087, "o", "    print(f\"Steady-state error < 0.5C: {metrics['steady_state_error']:.4f}C - {'PASS' if metrics['steady_state_error'] < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.804291, "o", "    print(f\"Settling time < 120s: {metrics['settling_time']:.2f}s - {'PASS' if metrics['settling_time'] < 120 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.804472, "o", "    print(f\"Overshoot < 10%: {metrics['overshoot']*100:.2f}% - {'PASS' if metrics['overshoot'] < 0.10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.804526, "o", "> "]
[168.804663, "o", "    print(f\"Max temperature < 30C: {metrics['max_temp']:.2f}C - {'PASS' if metrics['max_temp'] < 30 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.804806, "o", "    print(f\"Control duration >= 150s: {data[-1]['time']:.1f}s - PASS\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[168.804857, "o", "\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[168.80491, "o", "\u001b[?2004h> "]
[168.804958, "o", "    run_control()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[168.808203, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[168.906295, "i", "python3 control.py\n"]
[168.906456, "o", "python3 control.py\r\n\u001b[?2004l\r"]
[169.325061, "o", "Running closed-loop control with PID gains:\r\n  Kp = 21.5146\r\n  Ki = 0.0267\r\n  Kd = 0.0000\r\n"]
[169.325131, "o", "\r\nSetpoint: 22.0C\r\nControl duration: 250s (extended to allow integral action)\r\n"]
[169.325272, "o", "Initial temperature: 18.12C\r\n\r\nStarting control loop...\r\n  t=0.5s: T=18.11C, P=83.6%, error=3.88C\r\n"]
[169.327104, "o", "  t=30.5s: T=20.74C, P=28.7%, error=1.25C\r\n"]
[169.328865, "o", "  t=60.5s: T=20.89C, P=25.8%, error=1.08C\r\n"]
[169.330672, "o", "  t=90.5s: T=21.10C, P=27.9%, error=1.14C\r\n"]
[169.332417, "o", "  t=120.5s: T=20.99C, P=25.5%, error=0.99C\r\n"]
[169.334265, "o", "  t=150.5s: T=21.00C, P=25.6%, error=0.96C\r\n"]
[169.336005, "o", "  t=180.5s: T=21.04C, P=26.9%, error=0.98C\r\n"]
[169.337772, "o", "  t=210.5s: T=21.19C, P=27.7%, error=0.99C\r\n"]
[169.339525, "o", "  t=240.5s: T=21.14C, P=24.1%, error=0.79C\r\n"]
[169.340076, "o", "  t=250.0s: T=20.95C, P=28.1%, error=0.96C\r\n\r\nControl complete. Collected 500 data points.\r\n"]
[169.343629, "o", "Saved control_log.json\r\n"]
[169.345125, "o", "\r\nPerformance Metrics:\r\n  Rise time: 250.00s\r\n  Overshoot: 0.00%\r\n  Settling time: 250.00s\r\n  Steady-state error: 0.8938C\r\n"]
[169.345156, "o", "  Max temperature: 21.32C\r\n"]
[169.345312, "o", "\r\nSaved metrics.json\r\n\r\n=== Requirements Check ===\r\nSteady-state error < 0.5C: 0.8938C - FAIL\r\nSettling time < 120s: 250.00s - FAIL\r\nOvershoot < 10%: 0.00% - PASS\r\nMax temperature < 30C: 21.32C - PASS\r\nControl duration >= 150s: 250.0s - PASS\r\n"]
[169.380796, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[191.392819, "i", "cat > tune_gains.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\n\nimport json\n\ndef tune_controller():\n    # Load estimated parameters\n    with open('estimated_params.json', 'r') as f:\n        params = json.load(f)\n    \n    K = params['K']\n    tau = params['tau']\n    \n    print(f\"Tuning controller with estimated parameters:\")\n    print(f\"  K = {K:.4f} C/%\")\n    print(f\"  tau = {tau:.2f} s\")\n    \n    # Modified Lambda tuning with increased integral action\n    # Standard: Kp = tau/(K*lambda), Ki = 1/tau\n    # Modified: Increase Ki for faster steady-state error elimination\n    \n    lambda_factor = 0.3  # Aggressive tuning for fast response\n    lambda_val = lambda_factor * tau\n    \n    # Calculate PID gains with boosted integral\n    Kp = tau / (K * lambda_val)\n    Ki = 3.0 / tau  # Tripled integral gain for faster error elimination\n    Kd = 0.0\n    \n    print(f\"\\nTuning method: Modified Lambda (IMC-based with boosted integral)\")\n    print(f\"  Lambda = {lambda_val:.2f} s\")\n    print(f\"  Lambda factor = {lambda_factor}\")\n    print(f\"  Integral boost factor = 3.0\")\n    print(f\"\\nCalculated gains:\")\n    print(f\"  Kp = {Kp:.4f}\")\n    print(f\"  Ki = {Ki:.4f}\")\n    print(f\"  Kd = {Kd:.4f}\")\n    \n    # Save tuned gains\n    gains = {\n        \"Kp\": round(Kp, 6),\n        \"Ki\": round(Ki, 6),\n        \"Kd\": round(Kd, 6),\n        \"lambda\": round(lambda_val, 4)\n    }\n    \n    with open('tuned_gains.json', 'w') as f:\n        json.dump(gains, f, indent=2)\n    \n    print(\"\\nSaved tuned_gains.json\")\n\nif __name__ == \"__main__\":\n    tune_controller()\nEOF\n"]
[191.393076, "o", "cat > tune_gains.py << 'EOF'\r\n\u001b[?2004l\r"]
[191.393166, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.39319, "o", "> "]
[191.393298, "o", "\"\"\"Controller tuning: Calculate PID gains from estimated parameters.\"\"\"\r\n\u001b[?2004l\r"]
[191.393335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.393368, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.39339, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.393536, "o", "def tune_controller():\r\n\u001b[?2004l\r\u001b[?2004h>     # Load estimated parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.39362, "o", "    with open('estimated_params.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.39369, "o", "        params = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.393777, "o", ">     K = params['K']\r\n\u001b[?2004l\r"]
[191.393882, "o", "\u001b[?2004h>     tau = params['tau']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.393951, "o", ">     print(f\"Tuning controller with estimated parameters:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.39401, "o", "    print(f\"  K = {K:.4f} C/%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394077, "o", "    print(f\"  tau = {tau:.2f} s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394141, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.39422, "o", "    # Modified Lambda tuning with increased integral action\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394305, "o", "    # Standard: Kp = tau/(K*lambda), Ki = 1/tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394424, "o", "    # Modified: Increase Ki for faster steady-state error elimination\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394492, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394552, "o", "    lambda_factor = 0.3  # Aggressive tuning for fast response\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394653, "o", "    lambda_val = lambda_factor * tau\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394741, "o", "    # Calculate PID gains with boosted integral\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394813, "o", "    Kp = tau / (K * lambda_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.394934, "o", "    Ki = 3.0 / tau  # Tripled integral gain for faster error elimination\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395006, "o", "    Kd = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395087, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395178, "o", "    print(f\"\\nTuning method: Modified Lambda (IMC-based with boosted integral)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395255, "o", "    print(f\"  Lambda = {lambda_val:.2f} s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395331, "o", "    print(f\"  Lambda factor = {lambda_factor}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395389, "o", "    print(f\"  Integral boost factor = 3.0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395458, "o", "    print(f\"\\nCalculated gains:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395518, "o", "    print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395579, "o", "    print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395639, "o", "    print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395711, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Save tuned gains\r\n\u001b[?2004l\r"]
[191.395776, "o", "\u001b[?2004h>     gains = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395843, "o", "        \"Kp\": round(Kp, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395912, "o", "        \"Ki\": round(Ki, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.395975, "o", "        \"Kd\": round(Kd, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.396048, "o", "        \"lambda\": round(lambda_val, 4)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[191.396117, "o", "\u001b[?2004h> "]
[191.396187, "o", "    with open('tuned_gains.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.396225, "o", "        json.dump(gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[191.396323, "o", "\u001b[?2004h> "]
[191.396358, "o", "    print(\"\\nSaved tuned_gains.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.396455, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.396494, "o", "    tune_controller()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[191.397699, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[191.507966, "i", "python3 tune_gains.py\n"]
[191.508154, "o", "python3 tune_gains.py\r\n\u001b[?2004l\r"]
[191.525729, "o", "Tuning controller with estimated parameters:\r\n  K = 0.1162 C/%\r\n  tau = 37.49 s\r\n\r\nTuning method: Modified Lambda (IMC-based with boosted integral)\r\n  Lambda = 11.25 s\r\n  Lambda factor = 0.3\r\n  Integral boost factor = 3.0\r\n\r\nCalculated gains:\r\n  Kp = 28.6862\r\n  Ki = 0.0800\r\n  Kd = 0.0000\r\n"]
[191.525899, "o", "\r\nSaved tuned_gains.json\r\n"]
[191.528849, "o", "\u001b[?2004hroot@5b53895db643:~# "]
[192.064349, "i", "python3 control.py\n"]
[192.064507, "o", "python3 control.py"]
