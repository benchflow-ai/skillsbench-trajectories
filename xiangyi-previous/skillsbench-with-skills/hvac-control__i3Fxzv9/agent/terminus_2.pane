[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate PID gains
[?2004l[?2004h>     Kp = tau / (K * lambda_val)
[?2004l[?2004h>     Ki = 1.0 / tau
[?2004l[?2004h>     Kd = 0.0  # No derivative for first-order system
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nTuning method: Lambda (IMC-based)")
