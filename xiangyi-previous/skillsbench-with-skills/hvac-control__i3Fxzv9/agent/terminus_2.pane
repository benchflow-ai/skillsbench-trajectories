[?2004l[?2004h>         integral = np.clip(integral, -max_integral, max_integral)
[?2004l[?2004h>         I = Ki * integral
[?2004l[?2004h>         
[?2004l[?2004h>         # Derivative term
[?2004l[?2004h>         derivative = (error - prev_error) / dt
[?2004l[?2004h>         D = Kd * derivative
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate control output
