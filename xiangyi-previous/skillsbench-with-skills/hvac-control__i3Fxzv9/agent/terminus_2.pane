[?2004l[?2004h>     with open('control_log.json', 'w') as f:
[?2004l[?2004h>         json.dump(control_log, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     print("Saved control_log.json")
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate and save metrics
[?2004l[?2004h>     metrics = calculate_metrics(data, setpoint)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nPerformance Metrics:")
[?2004l[?2004h>     print(f"  Rise time: {metrics['rise_time']:.2f}s")
