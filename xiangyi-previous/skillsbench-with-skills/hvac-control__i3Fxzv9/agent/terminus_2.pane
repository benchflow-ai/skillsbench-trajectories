[?2004lt[?2004h>     
[?2004l[?2004h>     Kp = gains['Kp']
[?2004l[?2004h>     Ki = gains['Ki']
[?2004l[?2004h>     Kd = gains['Kd']
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Running closed-loop control with PID gains:")
[?2004l[?2004h>     print(f"  Kp = {Kp:.4f}")
[?2004l[?2004h>     print(f"  Ki = {Ki:.4f}")
[?2004l[?2004h>     print(f"  Kd = {Kd:.4f}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize simulator
[?2004l[?2004h>     sim = HVACSimulator()
[?2004l[?2004h>     setpoint = sim.get_setpoint()
[?2004l[?2004h>     dt = sim.get_dt()
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nSetpoint: {setpoint}C")
