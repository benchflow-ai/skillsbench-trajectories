[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Closed-loop control: Run PID controller to reach setpoint."""
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from hvac_simulator import HVACSimulator
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_metrics(data, setpoint):
[?2004l[?2004h>     """Calculate performance metrics from control data."""
[?2004l[?2004h>     times = np.array([d['time'] for d in data])
[?2004l[?2004h>     temps = np.array([d['temperature'] for d in data])
[?2004l[?2004h>     
[?2004l[?2004h>     # Find initial temperature (average of first few points)
[?2004l[?2004h>     T_initial = np.mean(temps[:5])
[?2004l[?2004h>     
[?2004l[?2004h>     # Max temperature
[?2004l[?2004h>     max_temp = np.max(temps)
[?2004l[?2004h>     
[?2004l[?2004h>     # Rise time: time to reach 90% of setpoint change
[?2004l[?2004h>     target_90 = T_initial + 0.9 * (setpoint - T_initial)
[?2004l[?2004h>     rise_idx = np.where(temps >= target_90)[0]
[?2004l[?2004h>     rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]
[?2004l[?2004h>     
[?2004l[?2004h>     # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)
[?2004l[?2004h>     overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))
[?2004l[?2004h>     
[?2004l[?2004h>     # Settling time: time to stay within 2% of setpoint
[?2004l[?2004h>     settling_band = 0.02 * abs(setpoint - T_initial)
[?2004l[?2004h>     settled = False
[?2004l[?2004h>     settling_time = times[-1]
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)
[?2004l[?2004h>         if all(abs(temps[i:i+20] - setpoint) <= settling_band):
[?2004l[?2004h>             settling_time = times[i]
[?2004l[?2004h>             settled = True
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Steady-state error: average error in last 20% of data
[?2004l[?2004h>     steady_start = int(0.8 * len(temps))
[?2004l[?2004h>     steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         "rise_time": round(rise_time, 2),
[?2004l[?2004h>         "overshoot": round(overshoot, 4),
[?2004l[?2004h>         "settling_time": round(settling_time, 2),
[?2004l[?2004h>         "steady_state_error": round(steady_state_error, 4),
[?2004l[?2004h>         "max_temp": round(max_temp, 4)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> def run_control():
[?2004l[?2004h>     # Load tuned gains
[?2004l[?2004h>     with open('tuned_gains.json', 'r') as f:
[?2004l[?2004h>         gains = json.load(f)
[?2004l[?2004h>     
[?2004l[?2004h>     Kp = gains['Kp']
[?2004l[?2004h>     Ki = gains['Ki']
[?2004l[?2004h>     Kd = gains['Kd']
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Running closed-loop control with PID gains:")
[?2004l[?2004h>     print(f"  Kp = {Kp:.4f}")
[?2004l[?2004h>     print(f"  Ki = {Ki:.4f}")
[?2004l[?2004h>     print(f"  Kd = {Kd:.4f}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize simulator
[?2004l[?2004h>     sim = HVACSimulator()
[?2004l[?2004h>     setpoint = sim.get_setpoint()
[?2004l[?2004h>     dt = sim.get_dt()
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nSetpoint: {setpoint}C")
[?2004l[?2004h>     print(f"Control duration: 300s")
[?2004l[?2004h>     
[?2004l[?2004h>     # Reset and get initial temperature
[?2004l[?2004h>     initial_temp = sim.reset()
[?2004l[?2004h>     print(f"Initial temperature: {initial_temp:.2f}C")
[?2004l[?2004h>     
[?2004l[?2004h>     # PID controller state
[?2004l[?2004h>     integral = 0.0
[?2004l[?2004h>     prev_error = setpoint - initial_temp
[?2004l[?2004h>     
[?2004l[?2004h>     # Data collection
[?2004l[?2004h>     data = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Run control loop for 300 seconds
[?2004l[?2004h>     duration = 300.0
[?2004l[?2004h>     steps = int(duration / dt)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nStarting control loop...")
[?2004l[?2004h>     
[?2004l[?2004h>     for step in range(steps):
[?2004l[?2004h>         # Get current state from last step or initial
[?2004l[?2004h>         if step == 0:
[?2004l[?2004h>             current_temp = initial_temp
[?2004l[?2004h>             time = 0.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             time = data[-1]['time'] + dt
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate error
[?2004l[?2004h>         error = setpoint - current_temp
[?2004l[?2004h>         
[?2004l[?2004h>         # PID control
[?2004l[?2004h>         # Proportional term
[?2004l[?2004h>         P = Kp * error
[?2004l[?2004h>         
[?2004l[?2004h>         # Integral term with anti-windup
[?2004l[?2004h>         integral += error * dt
[?2004l[?2004h>         # Anti-windup: clamp integral to prevent excessive buildup
[?2004l[?2004h>         max_integral = 100.0 / Ki if Ki > 0 else 1000.0
[?2004l[?2004h>         integral = np.clip(integral, -max_integral, max_integral)
[?2004l[?2004h>         I = Ki * integral
[?2004l[?2004h>         
[?2004l[?2004h>         # Derivative term
[?2004l[?2004h>         derivative = (error - prev_error) / dt
[?2004l[?2004h>         D = Kd * derivative
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate control output
[?2004l[?2004h>         heater_power = P + I + D
[?2004l[?2004h>         
[?2004l[?2004h>         # Clamp to valid range [0, 100]
[?2004l[?2004h>         heater_power = np.clip(heater_power, 0.0, 100.0)
[?2004l[?2004h>         
[?2004l[?2004h>         # Apply control and step simulation
[?2004l[?2004h>         result = sim.step(heater_power)
[?2004l[?2004h>         current_temp = result['temperature']
[?2004l[?2004h>         
[?2004l[?2004h>         # Log data
