[?2004l[?2004h>     prev_error = setpoint - initial_temp
[?2004l[?2004h>     
[?2004l[?2004h>     # Data collection
[?2004l[?2004h>     data = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Run control loop
[?2004l[?2004h>     duration = 200.0
