^Ccat > dicke_simulation.py << 'EOF'
import numpy as np
import qutip as qt
import csv

# Parameters
N = 4  # Number of two-level systems
omega_0 = 1.0  # Atomic frequency
omega_c = 1.0  # Cavity frequency
g = 2.0 / np.sqrt(N)  # Coupling strength
kappa = 1.0  # Cavity loss rate
n_max = 16  # Photon number cutoff

print("Setting up Dicke model simulation...")
print(f"Parameters: N={N}, ω0={omega_0}, ωc={omega_c}, g={g:.4f}, κ={kappa}, n_max={n_max}")

# Helper function to create operator acting on i-th spin
def spin_operator(op, i, N, n_max):
    """
    Create operator acting on i-th spin (0-indexed) in a system of N spins
    coupled to a cavity.
    op: single spin operator (sigmaz, sigmap, sigmam)
    i: index of spin (0 to N-1)
    N: total number of spins
    n_max: cavity Fock space dimension
    """
    op_list = [qt.qeye(n_max)]  # Cavity
    for j in range(N):
        if j == i:
            op_list.append(op)
        else:
            op_list.append(qt.qeye(2))  # Identity for other spins
    return qt.tensor(op_list)

# Create collective operators
def collective_operator(op, N, n_max):
    """
    Create collective operator sum_i op_i
    """
    result = 0
    for i in range(N):
        result += spin_operator(op, i, N, n_max)
    return result

# Build operators
print("Building operators...")
# Cavity operators
op_list_a = [qt.destroy(n_max)] + [qt.qeye(2) for _ in range(N)]
a = qt.tensor(op_list_a)

# Collective spin operators
Jz = collective_operator(qt.sigmaz() / 2.0, N, n_max)
Jp = collective_operator(qt.sigmap(), N, n_max)
Jm = collective_operator(qt.sigmam(), N, n_max)

# Hamiltonian
print("Constructing Hamiltonian...")
H = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)

print("Hamiltonian constructed.")
print(f"Hilbert space dimension: {H.shape[0]}")

# Function to solve for steady state and calculate Wigner function
def solve_case(case_num, collapse_ops, description):
    print(f"\n{'='*60}")
    print(f"Case {case_num}: {description}")
    print(f"{'='*60}")
    
    # Add cavity loss to all cases
    c_ops = [np.sqrt(kappa) * a] + collapse_ops
    
    print(f"Number of collapse operators: {len(c_ops)}")
    
    # Solve for steady state using eigen method (faster for moderate systems)
    print("Solving for steady state...")
    rho_ss = qt.steadystate(H, c_ops, method='eigen', sparse=True)
    print("Steady state found.")
    
    # Trace out spins to get cavity state
    print("Tracing out spin degrees of freedom...")
    # Keep subsystem 0 (cavity), trace out subsystems 1 to N (spins)
    rho_cavity = rho_ss.ptrace(0)
    print(f"Cavity density matrix dimension: {rho_cavity.shape[0]}")
    
    # Calculate Wigner function
    print("Calculating Wigner function on 1000x1000 grid...")
    xvec = np.linspace(-6, 6, 1000)
    pvec = np.linspace(-6, 6, 1000)
    W = qt.wigner(rho_cavity, xvec, pvec)
    
    # Save to CSV
    filename = f"{case_num}.csv"
    print(f"Saving Wigner function to {filename}...")
    np.savetxt(filename, W, delimiter=',')
    print(f"Saved {filename} with shape {W.shape}")
    
    return W

# Case 1: Local dephasing & local pumping
print("\n" + "#"*60)
print("Starting Case 1")
print("#"*60)
gamma_phi = 0.01
gamma_up = 0.1

collapse_ops_1 = []

# Local dephasing on each spin
for i in range(N):
    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)
    collapse_ops_1.append(np.sqrt(gamma_phi) * sz_i)

# Local pumping on each spin  
for i in range(N):
    sp_i = spin_operator(qt.sigmap(), i, N, n_max)
    collapse_ops_1.append(np.sqrt(gamma_up) * sp_i)

W1 = solve_case(1, collapse_ops_1, "Local dephasing & local pumping")

