[44.235737, "i", "cat > dicke_simulation.py << 'EOF'\nimport numpy as np\nimport qutip as qt\nimport csv\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Atomic frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\nprint(\"Setting up Dicke model simulation...\")\nprint(f\"Parameters: N={N}, ω0={omega_0}, ωc={omega_c}, g={g:.4f}, κ={kappa}, n_max={n_max}\")\n\n# Create operators\n# Cavity operators\na = qt.tensor(qt.destroy(n_max), qt.qeye(N+1))  # Cavity annihilation\nI_cav = qt.tensor(qt.qeye(n_max), qt.qeye(N+1))\n\n# Collective spin operators (using Dicke basis)\nj = N / 2.0  # Total spin\nJz = qt.tensor(qt.qeye(n_max), qt.jmat(j, 'z'))\nJp = qt.tensor(qt.qeye(n_max), qt.jmat(j, '+'))\nJm = qt.tensor(qt.qeye(n_max), qt.jmat(j, '-'))\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint(\"Hamiltonian constructed.\")\nprint(f\"Hilbert space dimension: {H.shape[0]}\")\n\n# Function to solve for steady state and calculate Wigner function\ndef solve_case(case_num, collapse_ops, description):\n    print(f\"\\n{'='*60}\")\n    print(f\"Case {case_num}: {description}\")\n    print(f\"{'='*60}\")\n    \n    # Add cavity loss to all cases\n    c_ops = [np.sqrt(kappa) * a] + collapse_ops\n    \n    print(f\"Number of collapse operators: {len(c_ops)}\")\n    \n    # Solve for steady state\n    print(\"Solving for steady state...\")\n    rho_ss = qt.steadystate(H, c_ops, method='direct')\n    print(\"Steady state found.\")\n    \n    # Trace out spins to get cavity state\n    print(\"Tracing out spin degrees of freedom...\")\n    rho_cavity = rho_ss.ptrace(0)  # Trace out subsystem 1 (spins), keep subsystem 0 (cavity)\n    print(f\"Cavity density matrix dimension: {rho_cavity.shape[0]}\")\n    \n    # Calculate Wigner function\n    print(\"Calculating Wigner function on 1000x1000 grid...\")\n    xvec = np.linspace(-6, 6, 1000)\n    pvec = np.linspace(-6, 6, 1000)\n    W = qt.wigner(rho_cavity, xvec, pvec)\n    \n    # Save to CSV\n    filename = f\"{case_num}.csv\"\n    print(f\"Saving Wigner function to {filename}...\")\n    np.savetxt(filename, W, delimiter=',')\n    print(f\"Saved {filename} with shape {W.shape}\")\n    \n    return W\n\n# Case 1: Local dephasing & local pumping\nprint(\"\\n\" + \"#\"*60)\nprint(\"Starting Case 1\")\nprint(\"#\"*60)\ngamma_phi = 0.01\ngamma_up = 0.1\n\n# Local operators for individual spins\n# For local operators, we need to apply them to each individual spin\n# Create single-spin operators and embed them\ncollapse_ops_1 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    # Create operator that acts on i-th spin\n    sz_i = qt.tensor(qt.qeye(n_max), qt.spin_Jz(N, i))\n    collapse_ops_1.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local pumping on each spin  \nfor i in range(N):\n    sp_i = qt.tensor(qt.qeye(n_max), qt.spin_Jp(N, i))\n    collapse_ops_1.append(np.sqrt(gamma_up) * sp_i)\n\nW1 = solve_case(1, collapse_ops_1, \"Local dephasing & local pumping\")\n\n# Case 2: Local dephasing & local emission\nprint(\"\\n\" + \"#\"*60)\nprint(\"Starting Case 2\")\nprint(\"#\"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\n\ncollapse_ops_2 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = qt.tensor(qt.qeye(n_max), qt.spin_Jz(N, i))\n    collapse_ops_2.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = qt.tensor(qt.qeye(n_max), qt.spin_Jm(N, i))\n    collapse_ops_2.append(np.sqrt(gamma_down) * sm_i)\n\nW2 = solve_case(2, collapse_ops_2, \"Local dephasing & local emission\")\n\n# Case 3: Local dephasing & local emission & collective pumping\nprint(\"\\n\" + \"#\"*60)\nprint(\"Starting Case 3\")\nprint(\"#\"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\ngamma_Up = 0.1\n\ncollapse_ops_3 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = qt.tensor(qt.qeye(n_max), qt.spin_Jz(N, i))\n    collapse_ops_3.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = qt.tensor(qt.qeye(n_max), qt.spin_Jm(N, i))\n    collapse_ops_3.append(np.sqrt(gamma_down) * sm_i)\n\n# Collective pumping\ncollapse_ops_3.append(np.sqrt(gamma_Up) *"]
[44.235971, "i", " Jp)\n\nW3 = solve_case(3, collapse_ops_3, \"Local dephasing & local emission & collective pumping\")\n\n# Case 4: Local dephasing & local emission & collective emission\nprint(\"\\n\" + \"#\"*60)\nprint(\"Starting Case 4\")\nprint(\"#\"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\ngamma_Down = 0.1\n\ncollapse_ops_4 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = qt.tensor(qt.qeye(n_max), qt.spin_Jz(N, i))\n    collapse_ops_4.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = qt.tensor(qt.qeye(n_max), qt.spin_Jm(N, i))\n    collapse_ops_4.append(np.sqrt(gamma_down) * sm_i)\n\n# Collective emission\ncollapse_ops_4.append(np.sqrt(gamma_Down) * Jm)\n\nW4 = solve_case(4, collapse_ops_4, \"Local dephasing & local emission & collective emission\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"All simulations completed successfully!\")\nprint(\"=\"*60)\nprint(\"\\nGenerated files:\")\nfor i in range(1, 5):\n    print(f\"  {i}.csv - Wigner function for case {i}\")\nEOF\n"]
