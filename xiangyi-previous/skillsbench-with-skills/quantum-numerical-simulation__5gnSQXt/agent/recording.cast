[158.73093, "o", "Setting up Dicke model simulation...\r\nParameters: N=4, ω0=1.0, ωc=1.0, g=1.0000, κ=1.0, n_max=16\r\nBuilding operators...\r\n"]
[158.740446, "o", "Constructing Hamiltonian...\r\n"]
[158.741707, "o", "Hamiltonian constructed.\r\nHilbert space dimension: 256\r\n"]
[158.741796, "o", "\r\n############################################################\r\nStarting Case 1\r\n############################################################\r\n"]
[158.747691, "o", "\r\n============================================================\r\nCase 1: Local dephasing & local pumping\r\n============================================================\r\n"]
[158.747855, "o", "Number of collapse operators: 9\r\nSolving for steady state...\r\n"]
