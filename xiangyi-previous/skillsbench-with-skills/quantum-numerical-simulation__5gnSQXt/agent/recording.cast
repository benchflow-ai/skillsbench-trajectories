[149.173904, "o", "    collapse_ops_2.append(np.sqrt(gamma_down) * sm_i)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[149.174017, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.174116, "o", "W2 = solve_case(2, collapse_ops_2, \"Local dephasing & local emission\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.17428, "o", "\u001b[?2004h> # Case 3: Local dephasing & local emission & collective pumping\r\n\u001b[?2004l\r"]
[149.174349, "o", "\u001b[?2004h> print(\"\\n\" + \"#\"*60)\r\n"]
[149.17441, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.174475, "o", "print(\"Starting Case 3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.174544, "o", "print(\"#\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.174605, "o", "gamma_phi = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.174679, "o", "gamma_down = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.174746, "o", "gamma_Up = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.174811, "o", "\u001b[?2004h> collapse_ops_3 = []\r\n\u001b[?2004l\r"]
[149.174875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.174935, "o", "\u001b[?2004h> "]
[149.175018, "o", "# Local dephasing on each spin\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.175083, "o", "> for i in range(N):\r\n\u001b[?2004l\r"]
[149.175153, "o", "\u001b[?2004h> "]
[149.176374, "o", "    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\r\n\u001b[?2004l\r"]
[149.176452, "o", "\u001b[?2004h> "]
[149.176555, "o", "    collapse_ops_3.append(np.sqrt(gamma_phi) * sz_i)\r\n\u001b[?2004l\r"]
[149.176616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.176699, "o", "# Local emission on each spin\r\n\u001b[?2004l\r"]
[149.176761, "o", "\u001b[?2004h> "]
[149.176819, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.176927, "o", "    sm_i = spin_operator(qt.sigmam(), i, N, n_max)\r\n\u001b[?2004l\r"]
[149.176993, "o", "\u001b[?2004h> "]
[149.17709, "o", "    collapse_ops_3.append(np.sqrt(gamma_down) * sm_i)\r\n\u001b[?2004l\r"]
[149.177155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.177214, "o", "# Collective pumping\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.177275, "o", "> "]
