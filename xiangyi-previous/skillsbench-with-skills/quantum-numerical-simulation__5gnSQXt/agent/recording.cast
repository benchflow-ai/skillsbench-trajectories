[149.157187, "o", "\u001b[?2004h"]
[149.157256, "o", "> "]
[149.157427, "o", "# Create collective operators"]
[149.157482, "o", "\r\n"]
[149.157538, "o", "\u001b[?2004l\r"]
[149.157607, "o", "\u001b[?2004h"]
[149.157668, "o", "> "]
[149.157875, "o", "def collective_operator(op, N, n_max):"]
[149.157931, "o", "\r\n"]
[149.157991, "o", "\u001b[?2004l\r"]
[149.158058, "o", "\u001b[?2004h"]
[149.158119, "o", "> "]
[149.158211, "o", "    \"\"\""]
[149.158271, "o", "\r\n"]
[149.158327, "o", "\u001b[?2004l\r"]
[149.158394, "o", "\u001b[?2004h"]
[149.158454, "o", "> "]
[149.158667, "o", "    Create collective operator sum_i op_i"]
[149.158712, "o", "\r\n"]
[149.158766, "o", "\u001b[?2004l\r"]
[149.158826, "o", "\u001b[?2004h"]
[149.158877, "o", "> "]
[149.158961, "o", "    \"\"\""]
[149.159003, "o", "\r\n"]
[149.159043, "o", "\u001b[?2004l\r"]
[149.159106, "o", "\u001b[?2004h"]
[149.15922, "o", "> "]
[149.159413, "o", "    result = 0"]
[149.159466, "o", "\r\n"]
[149.159509, "o", "\u001b[?2004l\r"]
[149.159574, "o", "\u001b[?2004h"]
[149.15962, "o", "> "]
[149.159757, "o", "    for i in range(N):"]
[149.159829, "o", "\r\n"]
[149.159872, "o", "\u001b[?2004l\r"]
[149.159931, "o", "\u001b[?2004h"]
[149.159978, "o", "> "]
[149.160226, "o", "        result += spin_operator(op, i, N, n_max)"]
[149.160259, "o", "\r\n"]
[149.160291, "o", "\u001b[?2004l\r"]
[149.160343, "o", "\u001b[?2004h"]
[149.160389, "o", "> "]
[149.160503, "o", "    return result"]
[149.160542, "o", "\r\n"]
[149.160576, "o", "\u001b[?2004l\r"]
[149.160626, "o", "\u001b[?2004h"]
[149.160668, "o", "> "]
[149.160712, "o", "\r\n"]
[149.160747, "o", "\u001b[?2004l\r"]
[149.160801, "o", "\u001b[?2004h"]
[149.160846, "o", "> "]
[149.160957, "o", "# Build operators"]
[149.160988, "o", "\r\n"]
[149.161024, "o", "\u001b[?2004l\r"]
[149.161068, "o", "\u001b[?2004h"]
[149.161105, "o", "> "]
[149.161269, "o", "print(\"Building operators...\")"]
[149.161304, "o", "\r\n"]
[149.161336, "o", "\u001b[?2004l\r"]
[149.161383, "o", "\u001b[?2004h"]
[149.161422, "o", "> "]
[149.161534, "o", "# Cavity operators"]
[149.161567, "o", "\r\n"]
[149.161601, "o", "\u001b[?2004l\r"]
[149.16165, "o", "\u001b[?2004h"]
[149.161696, "o", "> "]
[149.162011, "o", "op_list_a = [qt.destroy(n_max)] + [qt.qeye(2) for _ in range(N)]"]
[149.162046, "o", "\r\n"]
[149.162081, "o", "\u001b[?2004l\r"]
[149.162133, "o", "\u001b[?2004h"]
[149.162287, "o", "> "]
[149.162461, "o", "a = qt.tensor(op_list_a)"]
[149.162526, "o", "\r\n"]
[149.162599, "o", "\u001b[?2004l\r"]
[149.16272, "o", "\u001b[?2004h"]
[149.1628, "o", "> "]
[149.162869, "o", "\r\n"]
[149.162958, "o", "\u001b[?2004l\r"]
[149.165391, "o", "\u001b[?2004h"]
[149.165473, "o", "> # Collective spin operators\r\n\u001b[?2004l\r\u001b[?2004h> Jz = collective_operator(qt.sigmaz() / 2.0, N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> Jp = collective_operator(qt.sigmap(), N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> Jm = collective_operator(qt.sigmam(), N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hamiltonian\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Constructing Hamiltonian...\")\r\n\u001b[?2004l\r\u001b[?2004h> H = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Hamiltonian constructed.\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Hilbert space dimension: {H.shape[0]}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Function to solve for steady state and calculate Wigner function\r\n\u001b[?2004l\r\u001b[?2004h> def solve_case(case_num, collapse_ops, description):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n{'='*60}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Case {case_num}: {description}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{'='*60}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Add cavity loss to all cases\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.165674, "o", "    c_ops = [np.sqrt(kappa) * a] + collapse_ops\r\n\u001b[?2004l\r"]
[149.165715, "o", "\u001b[?2004h>     "]
[149.166005, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.166163, "o", "    print(f\"Number of collapse operators: {len(c_ops)}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.166213, "o", ">     # Solve for steady state\r\n\u001b[?2004l\r"]
[149.166252, "o", "\u001b[?2004h> "]
[149.166448, "o", "    print(\"Solving for steady state...\")"]
[149.166491, "o", "\r\n\u001b[?2004l\r"]
[149.166529, "o", "\u001b[?2004h> "]
[149.166735, "o", "    rho_ss = qt.steadystate(H, c_ops, method='direct')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.166852, "o", "    print(\"Steady state found.\")\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[149.166891, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.167071, "o", "    # Trace out spins to get cavity state\r\n\u001b[?2004l\r"]
[149.168542, "o", "\u001b[?2004h> "]
[149.168644, "o", "    print(\"Tracing out spin degrees of freedom...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.168777, "o", "    # Keep subsystem 0 (cavity), trace out subsystems 1 to N (spins)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.168872, "o", "    rho_cavity = rho_ss.ptrace(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.169024, "o", "    print(f\"Cavity density matrix dimension: {rho_cavity.shape[0]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.169158, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     # Calculate Wigner function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.169253, "o", "    print(\"Calculating Wigner function on 1000x1000 grid...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.169284, "o", "> "]
[149.169388, "o", "    xvec = np.linspace(-6, 6, 1000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.169476, "o", "    pvec = np.linspace(-6, 6, 1000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.169558, "o", "    W = qt.wigner(rho_cavity, xvec, pvec)\r\n\u001b[?2004l\r"]
[149.169588, "o", "\u001b[?2004h>     \r\n"]
[149.169615, "o", "\u001b[?2004l\r\u001b[?2004h"]
[149.169648, "o", "> "]
[149.169751, "o", "    # Save to CSV\r\n"]
[149.169806, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.169895, "o", "    filename = f\"{case_num}.csv\"\r\n\u001b[?2004l\r"]
[149.169925, "o", "\u001b[?2004h> "]
[149.170108, "o", "    print(f\"Saving Wigner function to {filename}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.170231, "o", "    np.savetxt(filename, W, delimiter=',')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.170353, "o", "    print(f\"Saved {filename} with shape {W.shape}\")\r\n\u001b[?2004l\r"]
[149.170379, "o", "\u001b[?2004h> "]
[149.170409, "o", "    \r\n\u001b[?2004l\r"]
[149.170443, "o", "\u001b[?2004h> "]
[149.170557, "o", "    return W\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.170758, "o", "# Case 1: Local dephasing & local pumping\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n\" + \"#\"*60)"]
[149.17083, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.170898, "o", "print(\"Starting Case 1\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.170965, "o", "> print(\"#\"*60)\r\n"]
[149.171036, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.171098, "o", "gamma_phi = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.171642, "o", "gamma_up = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> collapse_ops_1 = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Local dephasing on each spin\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.171771, "o", "    collapse_ops_1.append(np.sqrt(gamma_phi) * sz_i)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.171875, "o", "# Local pumping on each spin  \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.172001, "o", "> "]
[149.172103, "o", "    sp_i = spin_operator(qt.sigmap(), i, N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.172209, "o", "    collapse_ops_1.append(np.sqrt(gamma_up) * sp_i)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.172358, "o", "W1 = solve_case(1, collapse_ops_1, \"Local dephasing & local pumping\")\r\n\u001b[?2004l\r"]
[149.172461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.172559, "o", "# Case 2: Local dephasing & local emission\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.172655, "o", "print(\"\\n\" + \"#\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Starting Case 2\")\r\n\u001b[?2004l\r"]
[149.172743, "o", "\u001b[?2004h> print(\"#\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
