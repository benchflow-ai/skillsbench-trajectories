[149.172933, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> collapse_ops_2 = []\r\n\u001b[?2004l\r"]
[149.173039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.173141, "o", "# Local dephasing on each spin\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r"]
[149.173238, "o", "\u001b[?2004h> "]
[149.173335, "o", "    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.173431, "o", "    collapse_ops_2.append(np.sqrt(gamma_phi) * sz_i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.173524, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Local emission on each spin"]
[149.17362, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.173712, "o", "> "]
