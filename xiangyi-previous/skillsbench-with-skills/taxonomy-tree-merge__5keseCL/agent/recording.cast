[98.942992, "o", "        return \"others\"\r\n\u001b[?2004l\r"]
[98.943039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.943172, "o", "\u001b[?2004h> "]
[98.94325, "o", "    counts = Counter(candidates)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.943424, "o", "    total = sum(counts.values())\r\n\u001b[?2004l\r"]
[98.943458, "o", "\u001b[?2004h> "]
[98.943674, "o", "    most_common = counts.most_common(1)[0]\r\n\u001b[?2004l\r"]
[98.943737, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[98.943796, "o", "\u001b[?2004h> "]
[98.943967, "o", "    # Rule: representative enough (70%+)\r\n\u001b[?2004l\r"]
[98.944021, "o", "\u001b[?2004h> "]
[98.94418, "o", "    if most_common[1] / total >= 0.7:\r\n\u001b[?2004l\r"]
[98.944234, "o", "\u001b[?2004h> "]
[98.944359, "o", "        name = most_common[0]\r\n\u001b[?2004l\r"]
[98.944418, "o", "\u001b[?2004h> "]
[98.944476, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.944747, "o", "        # Construct name from top words in this cluster's paths\r\n\u001b[?2004l\r"]
[98.944823, "o", "\u001b[?2004h> "]
[98.945001, "o", "        # Use simple word frequency on the candidates\r\n\u001b[?2004l\r"]
[98.945076, "o", "\u001b[?2004h> "]
[98.94514, "o", "        words = []\r\n\u001b[?2004l\r"]
[98.945179, "o", "\u001b[?2004h> "]
[98.945305, "o", "        for c in candidates:\r\n\u001b[?2004l\r"]
[98.945388, "o", "\u001b[?2004h> "]
[98.945575, "o", "            words.extend(re.findall(r'\\w+', c.lower()))\r\n\u001b[?2004l\r"]
[98.945641, "o", "\u001b[?2004h> "]
[98.945707, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.945884, "o", "        # Filter stop words (basic list)\r\n\u001b[?2004l\r"]
[98.945969, "o", "\u001b[?2004h> "]
[98.946309, "o", "        stop_words = {'and', 'or', 'the', 'of', 'in', 'for', 'with', 'products', 'supplies', 'accessories'}\r\n\u001b[?2004l\r"]
[98.94639, "o", "\u001b[?2004h> "]
[98.946612, "o", "        words = [w for w in words if w not in stop_words and len(w) > 2]\r\n\u001b[?2004l\r"]
[98.94672, "o", "\u001b[?2004h> "]
[98.946785, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.946903, "o", "        word_counts = Counter(words)\r\n\u001b[?2004l\r"]
[98.947005, "o", "\u001b[?2004h> "]
[98.947189, "o", "        top_words = [w for w, c in word_counts.most_common(3)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.947246, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.947294, "o", "> "]
[98.947477, "o", "        # Ensure distinct from parent\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.947552, "o", "        if parent_name:\r\n\u001b[?2004l\r"]
[98.947601, "o", "\u001b[?2004h> "]
[98.94785, "o", "            parent_words = set(re.findall(r'\\w+', parent_name.lower()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.947902, "o", "> "]
[98.948008, "o", "            top_words = [w for w in top_words if w not in parent_words]\r\n\u001b[?2004l\r"]
[98.948056, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[98.948102, "o", "\u001b[?2004h> "]
[98.948147, "o", "        if not top_words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.948217, "o", "            name = most_common[0] # Fallback\r\n\u001b[?2004l\r"]
[98.948264, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[98.948309, "o", "\u001b[?2004h> "]
[98.948381, "o", "            name = \" | \".join(top_words[:3]).title()\r\n\u001b[?2004l\r"]
[98.948429, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.948475, "o", "\u001b[?2004h> "]
[98.948534, "o", "    # Clean up name length (max 5 words)\r\n\u001b[?2004l\r"]
[98.948582, "o", "\u001b[?2004h> "]
[98.948641, "o", "    name_words = name.split()\r\n\u001b[?2004l\r"]
[98.948688, "o", "\u001b[?2004h> "]
[98.948735, "o", "    if len(name_words) > 5:\r\n\u001b[?2004l\r"]
[98.948779, "o", "\u001b[?2004h> "]
[98.948823, "o", "        name = \" \".join(name_words[:5])\r\n\u001b[?2004l\r"]
[98.948866, "o", "\u001b[?2004h> "]
[98.94891, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.949133, "o", "    # Rule: Sibling distinctness (< 30% overlap) is hard to enforce strictly during generation without context of siblings.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.949258, "o", "    # We will assume clustering separates them enough.\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.949309, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.949352, "o", "    return name\r\n\u001b[?2004l\r"]
[98.9494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.949447, "o", "\u001b[?2004h> "]
[98.949562, "o", "def cluster_recursive(indices, current_depth, parent_name=\"\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.949606, "o", "> "]
[98.949649, "o", "    if current_depth > 5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.949697, "o", "> "]
[98.949743, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.949788, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.949867, "o", "    current_df = df.iloc[indices]\r\n\u001b[?2004l\r"]
[98.949921, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.949966, "o", "> "]
[98.95002, "o", "    # Determine K (number of clusters)\r\n\u001b[?2004l\r"]
[98.950065, "o", "\u001b[?2004h> "]
[98.950121, "o", "    n_samples = len(indices)\r\n\u001b[?2004l\r"]
[98.950166, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[98.950209, "o", "\u001b[?2004h> "]
[98.950324, "o", "    if n_samples < 10: # Too small to split further\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.950369, "o", "> "]
[98.950478, "o", "        # Just assign the parent name or a leaf name to all\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.950523, "o", "> "]
[98.950652, "o", "        name = get_cluster_name(current_df, current_depth, parent_name)\r\n\u001b[?2004l\r"]
[98.9507, "o", "\u001b[?2004h> "]
[98.95082, "o", "        df.loc[indices, f'unified_level_{current_depth}'] = name\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.950875, "o", "> "]
[98.951016, "o", "        # Propagate down if needed (or leave None, but task implies full 5 levels)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.951061, "o", "> "]
[98.951208, "o", "        # Let's fill remaining levels with the same name to ensure 5-level structure\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.951254, "o", "> "]
[98.951335, "o", "        for d in range(current_depth + 1, 6):\r\n\u001b[?2004l\r"]
[98.95138, "o", "\u001b[?2004h> "]
[98.951577, "o", "             df.loc[indices, f'unified_level_{d}'] = name\r\n\u001b[?2004l\r"]
[98.951629, "o", "\u001b[?2004h> "]
[98.951676, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.95172, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.951765, "o", "> "]
[98.951807, "o", "    if current_depth == 1:\r\n\u001b[?2004l\r"]
[98.951848, "o", "\u001b[?2004h> "]
[98.952018, "o", "        n_clusters = 15 # Target 10-20\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.952097, "o", "        # Target 3-20, scale with size\r\n\u001b[?2004l\r"]
[98.952148, "o", "\u001b[?2004h> "]
[98.952216, "o", "        n_clusters = min(20, max(3, int(n_samples / 50)))\r\n\u001b[?2004l\r"]
[98.952261, "o", "\u001b[?2004h> "]
[98.952377, "o", "        # If still too many samples, cap at 20. If too few, min 3.\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.952431, "o", "> "]
[98.952555, "o", "        # But if n_samples is really small (e.g. 20), 3 clusters is fine.\r\n\u001b[?2004l\r"]
[98.952607, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.952653, "o", ">     # Vectorize\r\n"]
[98.9527, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.952743, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.952784, "o", "> "]
[98.952907, "o", "        # Use the full path for context\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.953049, "o", "        tfidf_matrix = vectorizer.fit_transform(current_df['clean_path'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.953107, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.953153, "o", "> "]
[98.953248, "o", "        # If n_samples < n_clusters, adjust\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.953339, "o", "        real_k = min(n_clusters, n_samples)\r\n\u001b[?2004l\r"]
[98.953392, "o", "\u001b[?2004h> "]
[98.953437, "o", "        if real_k < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.953558, "o", "             name = get_cluster_name(current_df, current_depth, parent_name)\r\n\u001b[?2004l\r"]
[98.95361, "o", "\u001b[?2004h> "]
[98.953705, "o", "             df.loc[indices, f'unified_level_{current_depth}'] = name\r\n\u001b[?2004l\r"]
[98.953755, "o", "\u001b[?2004h> "]
[98.953839, "o", "             for d in range(current_depth + 1, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.953948, "o", "                 df.loc[indices, f'unified_level_{d}'] = name\r\n\u001b[?2004l\r"]
[98.953996, "o", "\u001b[?2004h> "]
[98.954039, "o", "             return\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.954082, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954211, "o", "        kmeans = MiniBatchKMeans(n_clusters=real_k, random_state=42, n_init=3)\r\n\u001b[?2004l\r"]
[98.954267, "o", "\u001b[?2004h> "]
[98.954351, "o", "        labels = kmeans.fit_predict(tfidf_matrix)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954401, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954483, "o", "        # Process each cluster\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.95456, "o", "        for label in range(real_k):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954659, "o", "            cluster_indices = indices[labels == label]\r\n\u001b[?2004l\r"]
[98.954712, "o", "\u001b[?2004h> "]
[98.954782, "o", "            sub_df = df.iloc[cluster_indices]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954872, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.954985, "o", "            name = get_cluster_name(sub_df, current_depth, parent_name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.955059, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.95516, "o", "            # Check overlap with parent\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.955232, "o", "> "]
[98.955432, "o", "            # (Simple check: if name is same as parent, try to append something or pick 2nd best)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.955553, "o", "            if name.lower() == parent_name.lower():\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.95558, "o", "> "]
[98.955697, "o", "                name = name + \" Sub\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.955757, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.955883, "o", "            df.loc[cluster_indices, f'unified_level_{current_depth}'] = name\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.955936, "o", "> "]
[98.955994, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956044, "o", "            # Recurse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956144, "o", "            cluster_recursive(cluster_indices, current_depth + 1, name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.956168, "o", ">             \r\n\u001b[?2004l\r"]
[98.956252, "o", "\u001b[?2004h> "]
[98.956331, "o", "    except ValueError as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956406, "o", "        # Fallback if vocabulary is empty or other error\r\n\u001b[?2004l\r"]
[98.956456, "o", "\u001b[?2004h> "]
[98.956573, "o", "        name = get_cluster_name(current_df, current_depth, parent_name)\r\n\u001b[?2004l\r"]
[98.95662, "o", "\u001b[?2004h> "]
[98.956768, "o", "        df.loc[indices, f'unified_level_{current_depth}'] = name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.956876, "o", "        for d in range(current_depth + 1, 6):\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.956932, "o", "> "]
[98.957027, "o", "             df.loc[indices, f'unified_level_{d}'] = name\r\n\u001b[?2004l\r"]
[98.957078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957151, "o", "print(\"Starting clustering...\")\r\n\u001b[?2004l\r"]
[98.957201, "o", "\u001b[?2004h> "]
[98.957249, "o", "cluster_recursive(df.index, 1)\r\n\u001b[?2004l\r"]
[98.9573, "o", "\u001b[?2004h> "]
[98.95735, "o", "print(\"Clustering complete.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.957403, "o", "> # 4. Output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957453, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.957502, "o", "> "]
[98.957546, "o", "os.makedirs('/root/output/', exist_ok=True)\r\n\u001b[?2004l\r"]
[98.957595, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.957646, "o", "# Full Taxonomy\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.957695, "o", "> "]
[98.957811, "o", "out_cols = ['source', 'category_path', 'depth'] + [f'unified_level_{i}' for i in range(1, 6)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.957861, "o", "> "]
[98.957919, "o", "# Calculate depth of original path just for info\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958018, "o", "df['depth'] = df['category_path'].apply(lambda x: len(x.split('>')))\r\n\u001b[?2004l\r"]
[98.958043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.958107, "o", "> "]
[98.958207, "o", "df[out_cols].to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.958259, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.958308, "o", "# Hierarchy\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.958357, "o", "> "]
[98.958459, "o", "hierarchy_cols = [f'unified_level_{i}' for i in range(1, 6)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.95848, "o", "> "]
[98.958643, "o", "hierarchy_df = df[hierarchy_cols].drop_duplicates().sort_values(by=hierarchy_cols)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.958695, "o", "> "]
[98.958824, "o", "hierarchy_df.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r"]
[98.958873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.958923, "o", "\u001b[?2004h> "]
[98.958974, "o", "print(\"Files saved to /root/output/\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.959022, "o", "> EOF\r\n\u001b[?2004l\r"]
[98.96101, "o", "\u001b[?2004hroot@586018ccc93d:~# "]
[99.119179, "i", "python3 /root/unify_taxonomy.py\n"]
[99.1194, "o", "python3 /root/unify_taxonomy.py"]
[99.119657, "o", "\r\n\u001b[?2004l\r"]
[99.658076, "o", "/root/unify_taxonomy.py:1: DeprecationWarning: \r\nPyarrow will become a required dependency of pandas in the next major release of pandas (pandas 3.0),\r\n(to allow more performant data types, such as the Arrow string type, and better interoperability with other libraries)\r\nbut was not found to be installed on your system.\r\nIf this would cause problems for you,\r\nplease provide us feedback at https://github.com/pandas-dev/pandas/issues/54466\r\n        \r\n  import pandas as pd\r\n"]
[100.658522, "o", "Starting clustering...\r\n"]
[135.500979, "i", "ls -l /root/output/\n"]
[135.501246, "o", "ls -l /root/output/\r\n"]
[137.268591, "o", "Clustering complete.\r\n"]
[137.370958, "o", "Files saved to /root/output/\r\n"]
[137.654231, "o", "\u001b[?2004hroot@586018ccc93d:~# ls -l /root/output/\r\n\u001b[?2004l\r"]
[137.658039, "o", "total 2260\r\n-rw-r--r-- 1 root root 2144523 Jan 26 19:49 unified_taxonomy_full.csv\r\n-rw-r--r-- 1 root root  163869 Jan 26 19:49 unified_taxonomy_hierarchy.csv\r\n"]
[137.658362, "o", "\u001b[?2004hroot@586018ccc93d:~# "]
[148.187908, "i", "head -n 5 /root/output/unified_taxonomy_full.csv\n"]
[148.188346, "o", "head -n 5 /root/output/unified_taxonomy_full.csv\r\n\u001b[?2004l\r"]
[148.18985, "o", "source,category_path,depth,unified_level_1,unified_level_2,unified_level_3,unified_level_4,unified_level_5\r\namazon,\"Clothing, Shoes & Jewelry > Women's Fashion > Women's Shops > Maternity > Maternity Sleepwear\",5,Clothing | Apparel | Shoes,Novelty | More,women's clothing,Maternity,Sleepwear | Tops\r\namazon,\"Beauty & Personal Care > Foot, Hand & Nail Care Products > Hand, Foot & Nail Tools > Nail Cleaning Brushes\",4,Beauty | Health | Personal,Care,Nail | Polish | Decoration,Foot | Hand,Nail\r\n"]
