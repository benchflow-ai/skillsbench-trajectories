[?2004hroot@586018ccc93d:~# cat << 'EOF' > /root/unify_taxonomy.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import re
[?2004l[?2004h> from sklearn.feature_extraction.text import TfidfVectorizer
[?2004l[?2004h> from sklearn.cluster import MiniBatchKMeans
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l#[?2004h> # 1. Load Data
[?2004l[?2004h> def load_data():
[?2004l[?2004h>     dfs = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Amazon
[?2004l[?2004h>     try:
[?2004l[?2004h>         df_amz = pd.read_csv('/root/data/amazon_product_categories.csv')
[?2004l[?2004h>         df_amz['source'] = 'amazon'
[?2004l[?2004h>         dfs.append(df_amz[['source', 'category_path']])
[?2004l[?2004h>     except Exception as e: print(f"Error loading Amazon: {e}")
[?2004lt 3-20, scale[?2004h> 
[?2004l[?2004h>     # FB
[?2004l[?2004h>     try:
[?2004l [?2004h>         df_fb = pd.read_csv('/root/data/fb_product_categories.csv')
[?2004l[?2004h>         df_fb['source'] = 'facebook'
[?2004l[?2004h>         dfs.append(df_fb[['source', 'category_path']])
[?2004l[?2004h>     except Exception as e: print(f"Error loading FB: {e}")
[?2004l[?2004h> 
[?2004l[?2004h>     # Google
[?2004l[?2004h>     try:
[?2004l[?2004h>         df_goog = pd.read_csv('/root/data/google_shopping_product_categories.csv')
[?2004l[?2004h>         df_goog['source'] = 'google'
[?2004l[?2004h>         dfs.append(df_goog[['source', 'category_path']])
[?2004l[?2004h>     except Exception as e: print(f"Error loading Google: {e}")
[?2004l[?2004h> 
[?2004l[?2004h>     full_df = pd.concat(dfs, ignore_index=True)
[?2004l[?2004h>     return full_df
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Preprocessing
[?2004l[?2004h> def clean_text(text):
[?2004l[?2004h>     if not isinstance(text, str): return ""
[?2004l[?2004h>     # Remove non-alphanumeric except > and spaces
[?2004l[?2004h>     text = text.lower()
[?2004l[?2004h>     text = re.sub(r'[^a-z0-9\s>]', '', text)
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> df = load_data()
[?2004l[?2004h> df['clean_path'] = df['category_path'].apply(clean_text)
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize unified columns
[?2004l[?2004h> for i in range(1, 6):
[?2004l[?2004h>     df[f'unified_level_{i}'] = None
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Recursive Clustering
[?2004l[?2004h> vectorizer = TfidfVectorizer(stop_words='english', max_features=1000)
[?2004l[?2004h> 
[?2004l[?2004h> def get_cluster_name(sub_df, depth, parent_name=None):
[?2004l[?2004h>     # Try to find a representative name from existing paths at this level
[?2004l[?2004h>     # Extract the component of the path corresponding to current depth
[?2004l[?2004h>     # Amazon/Google paths are > separated. 
[?2004l[?2004h>     # We'll tokenize by > and take the segment at 'depth-1' if it exists
[?2004l[?2004h>     
[?2004l[?2004h>     candidates = []
[?2004l[?2004h>     for path in sub_df['category_path']:
[?2004l[?2004h>         parts = [p.strip() for p in path.split('>')]
[?2004l[?2004h>         if len(parts) >= depth:
[?2004l[?2004h>             candidates.append(parts[depth-1])
[?2004l[?2004h>         elif len(parts) > 0:
[?2004l[?2004h>             candidates.append(parts[-1]) # Use last part if depth exceeds path
[?2004l[?2004h>     
[?2004l[?2004h>     if not candidates:
[?2004l[?2004h>         return "others"
[?2004l[?2004h> 
[?2004l[?2004h>     counts = Counter(candidates)
[?2004l[?2004h>     total = sum(counts.values())
[?2004l[?2004h>     most_common = counts.most_common(1)[0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Rule: representative enough (70%+)
[?2004l[?2004h>     if most_common[1] / total >= 0.7:
[?2004l[?2004h>         name = most_common[0]
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Construct name from top words in this cluster's paths
[?2004l[?2004h>         # Use simple word frequency on the candidates
[?2004l[?2004h>         words = []
[?2004l[?2004h>         for c in candidates:
[?2004l[?2004h>             words.extend(re.findall(r'\w+', c.lower()))
[?2004l[?2004h>         
[?2004l[?2004h>         # Filter stop words (basic list)
[?2004l[?2004h>         stop_words = {'and', 'or', 'the', 'of', 'in', 'for', 'with', 'products', 'supplies', 'accessories'}
[?2004l[?2004h>         words = [w for w in words if w not in stop_words and len(w) > 2]
[?2004l[?2004h>         
[?2004l[?2004h>         word_counts = Counter(words)
[?2004l[?2004h>         top_words = [w for w, c in word_counts.most_common(3)]
[?2004l[?2004h>         
[?2004l[?2004h>         # Ensure distinct from parent
[?2004l[?2004h>         if parent_name:
[?2004l[?2004h>             parent_words = set(re.findall(r'\w+', parent_name.lower()))
[?2004l[?2004h>             top_words = [w for w in top_words if w not in parent_words]
[?2004l[?2004h>             
[?2004l[?2004h>         if not top_words:
[?2004l[?2004h>             name = most_common[0] # Fallback
[?2004l[?2004h>         else:
[?2004l[?2004h>             name = " | ".join(top_words[:3]).title()
[?2004l[?2004h> 
[?2004l[?2004h>     # Clean up name length (max 5 words)
[?2004l[?2004h>     name_words = name.split()
[?2004l[?2004h>     if len(name_words) > 5:
[?2004l[?2004h>         name = " ".join(name_words[:5])
[?2004l[?2004h>         
[?2004l[?2004h>     # Rule: Sibling distinctness (< 30% overlap) is hard to enforce strictly during generation without context of siblings.
[?2004l[?2004h>     # We will assume clustering separates them enough.
[?2004l[?2004h>     
[?2004l[?2004h>     return name
[?2004l[?2004h> 
[?2004l[?2004h> def cluster_recursive(indices, current_depth, parent_name=""):
[?2004l[?2004h>     if current_depth > 5:
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     current_df = df.iloc[indices]
[?2004l[?2004h>     
[?2004l[?2004h>     # Determine K (number of clusters)
[?2004l[?2004h>     n_samples = len(indices)
[?2004l[?2004h>     
[?2004l[?2004h>     if n_samples < 10: # Too small to split further
[?2004l[?2004h>         # Just assign the parent name or a leaf name to all
[?2004l[?2004h>         name = get_cluster_name(current_df, current_depth, parent_name)
[?2004l[?2004h>         df.loc[indices, f'unified_level_{current_depth}'] = name
[?2004l[?2004h>         # Propagate down if needed (or leave None, but task implies full 5 levels)
[?2004l[?2004h>         # Let's fill remaining levels with the same name to ensure 5-level structure
[?2004l[?2004h>         for d in range(current_depth + 1, 6):
[?2004l[?2004h>              df.loc[indices, f'unified_level_{d}'] = name
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     if current_depth == 1:
[?2004l[?2004h>         n_clusters = 15 # Target 10-20
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Target 3-20, scale with size
[?2004l[?2004h>         n_clusters = min(20, max(3, int(n_samples / 50)))
[?2004l[?2004h>         # If still too many samples, cap at 20. If too few, min 3.
[?2004l[?2004h>         # But if n_samples is really small (e.g. 20), 3 clusters is fine.
[?2004l[?2004h>     
[?2004l[?2004h>     # Vectorize
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Use the full path for context
[?2004l[?2004h>         tfidf_matrix = vectorizer.fit_transform(current_df['clean_path'])
[?2004l[?2004h>         
[?2004l[?2004h>         # If n_samples < n_clusters, adjust
[?2004l[?2004h>         real_k = min(n_clusters, n_samples)
[?2004l[?2004h>         if real_k < 2:
[?2004l[?2004h>              name = get_cluster_name(current_df, current_depth, parent_name)
[?2004l[?2004h>              df.loc[indices, f'unified_level_{current_depth}'] = name
[?2004l[?2004h>              for d in range(current_depth + 1, 6):
[?2004l[?2004h>                  df.loc[indices, f'unified_level_{d}'] = name
[?2004l[?2004h>              return
[?2004l[?2004h> 
[?2004l[?2004h>         kmeans = MiniBatchKMeans(n_clusters=real_k, random_state=42, n_init=3)
[?2004l[?2004h>         labels = kmeans.fit_predict(tfidf_matrix)
[?2004l[?2004h>         
[?2004l[?2004h>         # Process each cluster
[?2004l[?2004h>         for label in range(real_k):
[?2004l[?2004h>             cluster_indices = indices[labels == label]
[?2004l[?2004h>             sub_df = df.iloc[cluster_indices]
[?2004l[?2004h>             
[?2004l[?2004h>             name = get_cluster_name(sub_df, current_depth, parent_name)
[?2004l[?2004h>             
[?2004l[?2004h>             # Check overlap with parent
[?2004l[?2004h>             # (Simple check: if name is same as parent, try to append something or pick 2nd best)
[?2004l[?2004h>             if name.lower() == parent_name.lower():
[?2004l[?2004h>                 name = name + " Sub"
[?2004l[?2004h>                 
[?2004l[?2004h>             df.loc[cluster_indices, f'unified_level_{current_depth}'] = name
[?2004l[?2004h>             
[?2004l[?2004h>             # Recurse
[?2004l[?2004h>             cluster_recursive(cluster_indices, current_depth + 1, name)
[?2004l[?2004h>             
[?2004l[?2004h>     except ValueError as e:
[?2004l[?2004h>         # Fallback if vocabulary is empty or other error
[?2004l[?2004h>         name = get_cluster_name(current_df, current_depth, parent_name)
[?2004l[?2004h>         df.loc[indices, f'unified_level_{current_depth}'] = name
[?2004l[?2004h>         for d in range(current_depth + 1, 6):
[?2004l[?2004h>              df.loc[indices, f'unified_level_{d}'] = name
[?2004l[?2004h> 
[?2004l[?2004h> print("Starting clustering...")
[?2004l[?2004h> cluster_recursive(df.index, 1)
[?2004l[?2004h> print("Clustering complete.")
