[?2004l[?2004h> 
[?2004l[?2004h> # Full Taxonomy
[?2004l[?2004h> out_cols = ['source', 'category_path', 'depth'] + [f'unified_level_{i}' for i in range(1, 6)]
[?2004l[?2004h> # Calculate depth of original path just for info
