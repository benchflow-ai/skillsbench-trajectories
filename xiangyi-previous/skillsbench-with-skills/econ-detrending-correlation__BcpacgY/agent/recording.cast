[184.70562, "i", "cat <<EOF > solve_v2.py\nimport pandas as pd\nimport numpy as np\nimport re\nfrom statsmodels.tsa.filters.hp_filter import hpfilter\n\ndef parse_erp(filename, val_col_idx):\n    if filename.endswith('.xls'):\n        df = pd.read_excel(filename, engine='xlrd', header=None)\n    else:\n        df = pd.read_excel(filename, engine='openpyxl', header=None)\n    \n    annual_data = {}\n    quarterly_data = {}\n    current_q_year = None\n    \n    for idx, row in df.iterrows():\n        raw_label = str(row[0]).strip()\n        val = row[val_col_idx]\n        \n        # Skip if value is not numeric (and handle strings that might be numbers)\n        if pd.isna(val):\n            continue\n        if isinstance(val, str):\n            try:\n                val = float(val)\n            except:\n                continue\n                \n        # Regex for Annual: \"1973.\"\n        # JSON escape: \\\\d for \\d, \\\\. for \\.\n        match_annual = re.match(r'^(\\\\d{4})\\\\.$', raw_label)\n        if match_annual:\n            year = int(match_annual.group(1))\n            annual_data[year] = val\n            current_q_year = None\n            continue\n            \n        # Regex for Start of Quarter: \"2024: I.\" or \"2024:I.\"\n        match_q_start = re.match(r'^(\\\\d{4})\\\\s*:\\s*[IVX]+', raw_label)\n        if match_q_start:\n            year = int(match_q_start.group(1))\n            current_q_year = year\n            if year not in quarterly_data:\n                quarterly_data[year] = []\n            quarterly_data[year].append(val)\n            continue\n            \n        # Regex for subsequent quarters: \"II.\", \"III.\", \"III p.\"\n        if current_q_year is not None:\n            # Starts with Roman numeral\n            if re.match(r'^[IVX]', raw_label):\n                quarterly_data[current_q_year].append(val)\n                \n    # Combine\n    final_series = {}\n    # We need 1973 to 2024\n    for y in range(1973, 2025):\n        if y in annual_data:\n            final_series[y] = annual_data[y]\n        elif y in quarterly_data:\n            vals = quarterly_data[y]\n            if vals:\n                final_series[y] = sum(vals) / len(vals)\n                \n    return pd.DataFrame(list(final_series.items()), columns=['Year', 'Value'])\n\n# Extract\ndf_pce = parse_erp('/root/ERP-2025-table10.xls', 1)\ndf_pce.rename(columns={'Value': 'PCE_Nominal'}, inplace=True)\n\ndf_pfi = parse_erp('/root/ERP-2025-table12.xls', 1)\ndf_pfi.rename(columns={'Value': 'PFI_Nominal'}, inplace=True)\n\n# CPI\ndf_cpi = pd.read_excel('/root/CPI.xlsx')\n\n# Merge\nmerged = pd.merge(df_pce, df_pfi, on='Year')\nmerged = pd.merge(merged, df_cpi, on='Year')\n\nprint(f\"Merged data range: {merged['Year'].min()} - {merged['Year'].max()}\")\nprint(f\"Count: {len(merged)}\")\nprint(merged.tail())\n\n# Deflate\nmerged['PCE_Real'] = merged['PCE_Nominal'] / merged['CPI_2024']\nmerged['PFI_Real'] = merged['PFI_Nominal'] / merged['CPI_2024']\n\n# Log\nmerged['ln_PCE_Real'] = np.log(merged['PCE_Real'])\nmerged['ln_PFI_Real'] = np.log(merged['PFI_Real'])\n\n# HP Filter\ncycle_pce, trend_pce = hpfilter(merged['ln_PCE_Real'], lamb=100)\ncycle_pfi, trend_pfi = hpfilter(merged['ln_PFI_Real'], lamb=100)\n\n# Correlation\ncorr = cycle_pce.corr(cycle_pfi)\nprint(f\"Correlation: {corr}\")\n\nwith open('/root/answer.txt', 'w') as f:\n    f.write(f\"{corr:.5f}\\n\")\nEOF\n"]
