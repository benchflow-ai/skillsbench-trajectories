[71.821204, "o", "\u001b[?2004h> "]
[71.82127, "o", "cycle_pce, trend_pce = hpfilter(merged['ln_PCE_Real'], lamb=100)\r\n\u001b[?2004l\r"]
[71.821326, "o", "\u001b[?2004h> "]
[71.821394, "o", "cycle_pfi, trend_pfi = hpfilter(merged['ln_PFI_Real'], lamb=100)\r\n\u001b[?2004l\r"]
[71.821444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.821502, "o", "# 5. Correlation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.821547, "o", "correlation = cycle_pce.corr(cycle_pfi)\r\n\u001b[?2004l\r"]
[71.821596, "o", "\u001b[?2004h> "]
[71.821651, "o", "print(f\"Correlation: {correlation}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.821705, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # 6. Write Output\r\n\u001b[?2004l\r"]
[71.821749, "o", "\u001b[?2004h> "]
