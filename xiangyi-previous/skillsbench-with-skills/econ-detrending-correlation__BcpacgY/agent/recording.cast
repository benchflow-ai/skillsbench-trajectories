[184.71014, "o", "\u001b[?2004h> "]
[184.710174, "o", "    final_series = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710308, "o", "    # We need 1973 to 2024\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(1973, 2025):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710374, "o", "        if y in annual_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710441, "o", "            final_series[y] = annual_data[y]\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.710473, "o", "> "]
[184.710606, "o", "        elif y in quarterly_data:\r\n\u001b[?2004l\r\u001b[?2004h>             vals = quarterly_data[y]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710696, "o", "            if vals:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710765, "o", "                final_series[y] = sum(vals) / len(vals)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710803, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710913, "o", "    return pd.DataFrame(list(final_series.items()), columns=['Year', 'Value'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.710941, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.710963, "o", "# Extract\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.710991, "o", "> "]
[184.711105, "o", "df_pce = parse_erp('/root/ERP-2025-table10.xls', 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711174, "o", "df_pce.rename(columns={'Value': 'PCE_Nominal'}, inplace=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.711208, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711355, "o", "df_pfi = parse_erp('/root/ERP-2025-table12.xls', 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711422, "o", "df_pfi.rename(columns={'Value': 'PFI_Nominal'}, inplace=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711457, "o", "# CPI\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711549, "o", "df_cpi = pd.read_excel('/root/CPI.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711585, "o", "# Merge\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711664, "o", "merged = pd.merge(df_pce, df_pfi, on='Year')\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.711699, "o", "> "]
[184.71178, "o", "merged = pd.merge(merged, df_cpi, on='Year')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.711917, "o", "print(f\"Merged data range: {merged['Year'].min()} - {merged['Year'].max()}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.71195, "o", "print(f\"Count: {len(merged)}\")\r\n\u001b[?2004l\r"]
[184.712018, "o", "\u001b[?2004h> print(merged.tail())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[184.712051, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.712084, "o", "# Deflate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.712234, "o", "merged['PCE_Real'] = merged['PCE_Nominal'] / merged['CPI_2024']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.712336, "o", "merged['PFI_Real'] = merged['PFI_Nominal'] / merged['CPI_2024']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.712369, "o", "> # Log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.712461, "o", "merged['ln_PCE_Real'] = np.log(merged['PCE_Real'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.712542, "o", "merged['ln_PFI_Real'] = np.log(merged['PFI_Real'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.712578, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
