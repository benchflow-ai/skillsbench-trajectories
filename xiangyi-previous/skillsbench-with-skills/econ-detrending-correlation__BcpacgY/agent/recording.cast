[96.116126, "i", "cat <<EOF > debug_parsing.py\nimport pandas as pd\n\ndef debug_tail(filename):\n    print(f\"--- Debugging {filename} ---\")\n    if filename.endswith('.xls'):\n        df = pd.read_excel(filename, engine='xlrd', header=None)\n    else:\n        df = pd.read_excel(filename, engine='openpyxl', header=None)\n    \n    # Print last 20 rows of column 0 and 1\n    print(df.iloc[-20:, [0, 1]])\n\ndebug_tail('/root/ERP-2025-table10.xls')\ndebug_tail('/root/ERP-2025-table12.xls')\nEOF\n"]
