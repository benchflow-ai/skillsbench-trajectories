[71.82091, "o", "\u001b[?2004h> "]
[71.820958, "o", "merged['ln_PCE_Real'] = np.log(merged['PCE_Real'])\r\n\u001b[?2004l\r"]
[71.821013, "o", "\u001b[?2004h> "]
[71.821056, "o", "merged['ln_PFI_Real'] = np.log(merged['PFI_Real'])\r\n\u001b[?2004l\r"]
[71.821105, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
