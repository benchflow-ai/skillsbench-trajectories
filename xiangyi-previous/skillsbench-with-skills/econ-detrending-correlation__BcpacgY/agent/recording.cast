[71.8192, "o", "df_pce = process_erp_table('/root/ERP-2025-table10.xls', 1)\r\n\u001b[?2004l\r"]
[71.819248, "o", "\u001b[?2004h> "]
[71.819314, "o", "df_pce.rename(columns={'Value': 'PCE_Nominal'}, inplace=True)\r\n\u001b[?2004l\r"]
[71.819362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.819414, "o", "# Table 12: PFI is column 1 (index 1)\r\n\u001b[?2004l\r"]
[71.819468, "o", "\u001b[?2004h> "]
[71.819528, "o", "df_pfi = process_erp_table('/root/ERP-2025-table12.xls', 1)\r\n\u001b[?2004l\r"]
[71.819578, "o", "\u001b[?2004h> "]
[71.819648, "o", "df_pfi.rename(columns={'Value': 'PFI_Nominal'}, inplace=True)\r\n\u001b[?2004l\r"]
[71.819706, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.819765, "o", "# CPI Data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.819815, "o", "df_cpi = pd.read_excel('/root/CPI.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.819871, "o", "# Ensure columns are Year, CPI_2024\r\n\u001b[?2004l\r"]
[71.819922, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.819981, "o", "# 2. Merge Data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820031, "o", "merged = pd.merge(df_pce, df_pfi, on='Year')\r\n\u001b[?2004l\r"]
[71.820083, "o", "\u001b[?2004h> "]
[71.820126, "o", "merged = pd.merge(merged, df_cpi, on='Year')\r\n\u001b[?2004l\r"]
[71.820208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820259, "o", "# Verify we have 1973-2024 (52 years)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.82031, "o", "> "]
[71.820359, "o", "print(f\"Data points: {len(merged)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820414, "o", "print(merged.head())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820467, "o", "print(merged.tail())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820517, "o", "# 3. Deflate to Real Values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820638, "o", "merged['PCE_Real'] = merged['PCE_Nominal'] / merged['CPI_2024']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.820745, "o", "merged['PFI_Real'] = merged['PFI_Nominal'] / merged['CPI_2024']\r\n\u001b[?2004l\r"]
[71.820801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 4. HP Filter"]
