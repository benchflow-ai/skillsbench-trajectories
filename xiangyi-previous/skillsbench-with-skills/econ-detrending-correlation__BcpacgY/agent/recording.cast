[27.851461, "i", "cat <<EOF > inspect_data.py\nimport pandas as pd\n\ndef inspect(filename):\n    print(f\"--- {filename} ---\")\n    try:\n        if filename.endswith('.xls'):\n            df = pd.read_excel(filename, engine='xlrd')\n        else:\n            df = pd.read_excel(filename, engine='openpyxl')\n        print(df.head(15))\n        print(df.tail(10))\n    except Exception as e:\n        print(f\"Error reading {filename}: {e}\")\n\ninspect('/root/ERP-2025-table10.xls')\ninspect('/root/ERP-2025-table12.xls')\ninspect('/root/CPI.xlsx')\nEOF\n"]
