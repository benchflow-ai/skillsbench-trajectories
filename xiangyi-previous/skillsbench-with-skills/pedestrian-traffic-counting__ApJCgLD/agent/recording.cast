[328.445088, "o", "\u001b[?2004h> "]
[328.445256, "o", "    hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())\r\n\u001b[?2004l\r"]
[328.445293, "o", "\u001b[?2004h>     \r\n"]
[328.445321, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[328.445509, "o", "    # Dictionary to store tracked pedestrians: {id: [centroid_history]}\r\n\u001b[?2004l\r"]
[328.445572, "o", "\u001b[?2004h> "]
[328.4456, "o", "    tracked_pedestrians = {}\r\n\u001b[?2004l\r"]
[328.445629, "o", "\u001b[?2004h"]
[328.445657, "o", "> "]
[328.445767, "o", "    next_id = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[328.445834, "o", "\u001b[?2004h> "]
[328.445904, "o", "    # Parameters for tracking\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.446061, "o", "    max_distance = 50  # Maximum distance to consider same person\r\n\u001b[?2004l\r"]
[328.446131, "o", "\u001b[?2004h> "]
[328.446268, "o", "    min_frames_threshold = 3  # Minimum frames a person must appear in\r\n\u001b[?2004l\r"]
[328.446339, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.446443, "o", "    frame_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.44652, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r"]
[328.446588, "o", "\u001b[?2004h> "]
[328.446668, "o", "        ret, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.446729, "o", "        if not ret:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.446811, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[328.446884, "o", "\u001b[?2004h> "]
[328.446975, "o", "        frame_count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.447035, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.447133, "o", "        # Resize frame for faster processing (optional)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.447281, "o", "        # frame = cv2.resize(frame, (640, 480))\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.447364, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.44743, "o", "        # Detect pedestrians\r\n\u001b[?2004l\r"]
[328.447508, "o", "\u001b[?2004h> "]
[328.447689, "o", "        detections, weights = hog.detectMultiScale(frame, winStride=(8, 8), padding=(16, 16), scale=1.05)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.447733, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.447762, "o", "> "]
[328.447894, "o", "        # Calculate centroids of detections\r\n\u001b[?2004l\r"]
[328.447964, "o", "\u001b[?2004h> "]
[328.447995, "o", "        current_centroids = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.448144, "o", "        for (x, y, w, h) in detections:\r\n\u001b[?2004l\r"]
[328.448211, "o", "\u001b[?2004h> "]
[328.448245, "o", "            cx = x + w // 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.448345, "o", "            cy = y + h // 2\r\n\u001b[?2004l\r"]
[328.448407, "o", "\u001b[?2004h> "]
[328.448474, "o", "            current_centroids.append((cx, cy))\r\n\u001b[?2004l\r"]
[328.448507, "o", "\u001b[?2004h> "]
[328.448535, "o", "        \r\n"]
[328.448562, "o", "\u001b[?2004l\r\u001b[?2004h"]
[328.448591, "o", "> "]
[328.448723, "o", "        # Match detections with existing tracks\r\n\u001b[?2004l\r"]
[328.448818, "o", "\u001b[?2004h> "]
[328.448893, "o", "        matched_ids = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.448968, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.449049, "o", "        for centroid in current_centroids:\r\n\u001b[?2004l\r"]
[328.449135, "o", "\u001b[?2004h> "]
[328.449228, "o", "            matched = False\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[328.449295, "o", "\u001b[?2004h> "]
[328.449326, "o", "            # Find closest tracked pedestrian\r\n\u001b[?2004l\r"]
[328.449355, "o", "\u001b[?2004h> "]
[328.449461, "o", "            min_dist = max_distance\r\n\u001b[?2004l\r"]
[328.449502, "o", "\u001b[?2004h> "]
[328.449598, "o", "            closest_id = None\r\n\u001b[?2004l\r"]
[328.44963, "o", "\u001b[?2004h> "]
[328.449659, "o", "            \r\n\u001b[?2004l\r"]
[328.449687, "o", "\u001b[?2004h"]
[328.449716, "o", "> "]
[328.449891, "o", "            for ped_id, history in tracked_pedestrians.items():\r\n"]
[328.449964, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[328.450035, "o", "                if ped_id in matched_ids:\r\n\u001b[?2004l\r"]
[328.450109, "o", "\u001b[?2004h> "]
[328.450141, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.450169, "o", "> "]
[328.450273, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.450335, "o", "> "]
[328.450416, "o", "                last_centroid = history[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.450674, "o", "                dist = np.sqrt((centroid[0] - last_centroid[0])**2 + (centroid[1] - last_centroid[1])**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.45074, "o", ">                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.450825, "o", "                if dist < min_dist:\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.450888, "o", "> "]
[328.450963, "o", "                    min_dist = dist\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.451036, "o", "                    closest_id = ped_id\r\n\u001b[?2004l\r"]
[328.451101, "o", "\u001b[?2004h> "]
[328.45117, "o", "                    matched = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.451223, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.451305, "o", "            if matched and closest_id is not None:\r\n\u001b[?2004l\r"]
[328.451359, "o", "\u001b[?2004h> "]
[328.451467, "o", "                tracked_pedestrians[closest_id].append(centroid)\r\n\u001b[?2004l\r"]
[328.451546, "o", "\u001b[?2004h> "]
[328.451609, "o", "                matched_ids.add(closest_id)"]
[328.45174, "o", "\r\n\u001b[?2004l\r"]
[328.451773, "o", "\u001b[?2004h> "]
[328.4518, "o", "            else:\r\n"]
[328.45187, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[328.451955, "o", "                # New pedestrian detected\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.451987, "o", "> "]
[328.452113, "o", "                tracked_pedestrians[next_id] = [centroid]\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.452147, "o", "> "]
[328.452181, "o", "                next_id += 1"]
[328.45562, "o", "\r\n\u001b[?2004l\r"]
[328.455686, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[328.455726, "o", "\u001b[?2004h> "]
[328.455842, "o", "        # Remove old tracks that haven't been updated\r\n\u001b[?2004l\r"]
[328.455873, "o", "\u001b[?2004h"]
[328.455935, "o", "> "]
[328.456006, "o", "        ids_to_remove = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.456042, "o", "> "]
[328.456194, "o", "        for ped_id in tracked_pedestrians.keys():\r\n"]
[328.456239, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[328.456438, "o", "            if ped_id not in matched_ids and len(tracked_pedestrians[ped_id]) > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.456503, "o", "> "]
[328.456707, "o", "                # Track is inactive, but keep it for potential re-matching\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.456757, "o", "> "]
[328.456825, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.456867, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.456913, "o", "    cap.release()"]
[328.456978, "o", "\r\n\u001b[?2004l\r"]
[328.457039, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[328.457079, "o", "\u001b[?2004h> "]
[328.457297, "o", "    # Count unique pedestrians (those that appeared in at least min_frames_threshold frames)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.457335, "o", "> "]
[328.457594, "o", "    unique_count = sum(1 for history in tracked_pedestrians.values() if len(history) >= min_frames_threshold)\r\n\u001b[?2004l\r"]
[328.45763, "o", "\u001b[?2004h>     "]
[328.4577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.457735, "o", "> "]
[328.457909, "o", "    # If no pedestrians met the threshold, count all detected unique pedestrians\r\n\u001b[?2004l\r"]
[328.457969, "o", "\u001b[?2004h> "]
[328.458061, "o", "    if unique_count == 0:\r\n"]
[328.458166, "o", "\u001b[?2004l\r\u001b[?2004h"]
[328.458244, "o", "> "]
[328.458282, "o", "        unique_count = len(tracked_pedestrians)\r\n\u001b[?2004l\r"]
[328.458325, "o", "\u001b[?2004h>     "]
[328.458355, "o", "\r\n\u001b[?2004l\r"]
[328.458384, "o", "\u001b[?2004h> "]
[328.45847, "o", "    return unique_count\r\n"]
[328.458499, "o", "\u001b[?2004l\r"]
[328.458531, "o", "\u001b[?2004h"]
[328.458563, "o", "> \r\n\u001b[?2004l\r"]
[328.458593, "o", "\u001b[?2004h> "]
[328.458652, "o", "def main():\r\n\u001b[?2004l\r"]
[328.458705, "o", "\u001b[?2004h> "]
[328.458807, "o", "    video_dir = '/app/video'\r\n"]
[328.458839, "o", "\u001b[?2004l\r\u001b[?2004h"]
[328.458869, "o", "> "]
[328.4589, "o", "    \r\n"]
[328.459287, "o", "\u001b[?2004l\r"]
[328.45935, "o", "\u001b[?2004h"]
[328.45938, "o", "> "]
[328.459775, "o", "    # Get all video files\r\n\u001b[?2004l\r"]
[328.459813, "o", "\u001b[?2004h"]
[328.459845, "o", "> "]
[328.459915, "o", "    video_files = []\r\n\u001b[?2004l\r"]
[328.459959, "o", "\u001b[?2004h> "]
[328.460085, "o", "    for file in sorted(os.listdir(video_dir)):\r\n\u001b[?2004l\r"]
[328.460133, "o", "\u001b[?2004h> "]
[328.460307, "o", "        if file.lower().endswith(('.mp4', '.avi', '.mov', '.mkv')):"]
[328.460348, "o", "\r\n\u001b[?2004l\r"]
[328.460381, "o", "\u001b[?2004h> "]
[328.460476, "o", "            video_files.append(file)\r\n\u001b[?2004l\r"]
[328.460508, "o", "\u001b[?2004h> "]
[328.460549, "o", "    \r\n\u001b[?2004l\r"]
[328.460585, "o", "\u001b[?2004h> "]
[328.460646, "o", "    # Create workbook\r\n\u001b[?2004l\r"]
[328.460689, "o", "\u001b[?2004h> "]
[328.460737, "o", "    wb = Workbook()\r\n\u001b[?2004l\r"]
[328.460766, "o", "\u001b[?2004h> "]
[328.460818, "o", "    ws = wb.active\r\n\u001b[?2004l\r"]
[328.460846, "o", "\u001b[?2004h> "]
[328.460932, "o", "    ws.title = 'results'\r\n\u001b[?2004l\r"]
[328.460966, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[328.461016, "o", "\u001b[?2004h> "]
[328.461095, "o", "    # Add header\r\n\u001b[?2004l\r"]
[328.461138, "o", "\u001b[?2004h> "]
[328.461216, "o", "    ws['A1'] = 'filename'\r\n\u001b[?2004l\r"]
[328.461249, "o", "\u001b[?2004h> "]
[328.461339, "o", "    ws['B1'] = 'number'\r\n\u001b[?2004l\r"]
[328.461386, "o", "\u001b[?2004h> "]
[328.461421, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.461457, "o", "> "]
[328.461523, "o", "    # Process each video\r\n\u001b[?2004l\r"]
[328.461567, "o", "\u001b[?2004h> "]
[328.461725, "o", "    for idx, video_file in enumerate(video_files, start=2):\r\n\u001b[?2004l\r"]
[328.46177, "o", "\u001b[?2004h"]
[328.4618, "o", "> "]
[328.461947, "o", "        video_path = os.path.join(video_dir, video_file)\r\n\u001b[?2004l\r"]
[328.461993, "o", "\u001b[?2004h> "]
[328.462135, "o", "        print(f\"Processing {video_file}...\")\r\n\u001b[?2004l\r"]
[328.462166, "o", "\u001b[?2004h> "]
[328.462218, "o", "        \r\n\u001b[?2004l\r"]
[328.462257, "o", "\u001b[?2004h> "]
[328.462388, "o", "        count = detect_pedestrians_in_video(video_path)\r\n\u001b[?2004l\r"]
[328.462436, "o", "\u001b[?2004h> "]
[328.462492, "o", "        \r\n\u001b[?2004l\r"]
[328.46253, "o", "\u001b[?2004h> "]
[328.462647, "o", "        ws[f'A{idx}'] = video_file\r\n\u001b[?2004l\r"]
[328.462681, "o", "\u001b[?2004h> "]
[328.46278, "o", "        ws[f'B{idx}'] = count\r\n\u001b[?2004l\r"]
[328.462829, "o", "\u001b[?2004h"]
[328.462863, "o", "> "]
[328.462895, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.462931, "o", "> "]
[328.463077, "o", "        print(f\"  Found {count} unique pedestrians\")\r\n\u001b[?2004l\r"]
[328.463132, "o", "\u001b[?2004h"]
[328.463204, "o", "> "]
[328.463251, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.463295, "o", "> "]
[328.463331, "o", "    # Save workbook\r\n\u001b[?2004l\r"]
[328.463393, "o", "\u001b[?2004h> "]
[328.463581, "o", "    output_file = os.path.join(video_dir, 'count.xlsx')"]
[328.463639, "o", "\r\n\u001b[?2004l\r"]
[328.463681, "o", "\u001b[?2004h> "]
[328.463744, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r"]
[328.463772, "o", "\u001b[?2004h> "]
[328.463918, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n"]
[328.463943, "o", "\u001b[?2004l\r"]
[328.463991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[328.464022, "o", "\u001b[?2004h> "]
[328.464118, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[328.46416, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[328.464189, "o", "\u001b[?2004h"]
[328.464225, "o", "> EOF\r\n"]
