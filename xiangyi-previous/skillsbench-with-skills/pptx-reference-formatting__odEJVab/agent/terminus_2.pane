[?2004hroot@d61935b92c72:~# cat << 'EOF' > process_pptx.py
[?2004l[?2004h> import pptx
[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.util import Inches, Pt
[?2004l[?2004h> from pptx.dml.color import RGBColor
[?2004l[?2004h> from pptx.enum.text import PP_ALIGN
[?2004l[?2004h> 
[?2004l[?2004h> def process_pptx(input_path, output_path):
[?2004l[?2004h>     prs = Presentation(input_path)
[?2004l[?2004h>     slide_width = prs.slide_width
[?2004l[?2004h>     slide_height = prs.slide_height
[?2004l[?2004h>     
[?2004l[?2004h>     all_titles = []
[?2004l[?2004h>     
[?2004l[?2004h>     for i, slide in enumerate(prs.slides):
[?2004l[?2004h>         if i == 0: continue # Skip first slide if it's a cover
[?2004l[?2004h>         
[?2004l[?2004h>         paper_title_shape = None
[?2004l[?2004h>         # Heuristic: the paper title is often in a TextBox and not the main title or content
[?2004l[?2004h>         for shape in slide.shapes:
[?2004l[?2004h>             if not shape.has_text_frame:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             text = shape.text.strip()
[?2004l[?2004h>             if not text:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Exclude what look like main slide titles or content
[?2004l[?2004h>             if "Title" in shape.name or "Placeholder" in shape.name:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # This is likely our paper title
[?2004l[?2004h>             paper_title_shape = shape
[?2004l[?2004h>             break
[?2004l[?2004h>         
[?2004l[?2004h>         if paper_title_shape:
[?2004l[?2004h>             title_text = paper_title_shape.text.strip()
[?2004l[?2004h>             if title_text not in all_titles:
[?2004l[?2004h>                 all_titles.append(title_text)
[?2004l[?2004h>             
[?2004l[?2004h>             # 1. Change font properties
[?2004l[?2004h>             for paragraph in paper_title_shape.text_frame.paragraphs:
[?2004l[?2004h>                 paragraph.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>                 for run in paragraph.runs:
[?2004l[?2004h>                     run.font.name = 'Arial'
[?2004l[?2004h>                     run.font.size = Pt(16)
[?2004l[?2004h>                     run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)
[?2004l[?2004h>                     run.font.bold = False
[?2004l[?2004h>             
[?2004l[?2004h>             # 2. Adjust box width and position
[?2004l[?2004h>             # Make it wide enough to fit in one line
[?2004l[?2004h>             paper_title_shape.width = slide_width - Inches(1) 
[?2004l[?2004h>             paper_title_shape.left = (slide_width - paper_title_shape.width) // 2
[?2004l[?2004h>             # 3. Put at bottom center
[?2004l[?2004h>             paper_title_shape.top = slide_height - Inches(0.8)
[?2004l[?2004h>             
[?2004l[?2004h>     # 4. Create Reference slide
[?2004l[?2004h>     # Remove duplicates (already handled by all_titles list check)
[?2004l[?2004h>     ref_slide_layout = prs.slide_layouts[1] # Usually Title and Content
[?2004l[?2004h>     ref_slide = prs.slides.add_slide(ref_slide_layout)
[?2004l[?2004h>     title_shape = ref_slide.shapes.title
[?2004l[?2004h>     title_shape.text = "Reference"
[?2004l[?2004h>     
[?2004l[?2004h>     body_shape = ref_slide.placeholders[1]
[?2004l[?2004h>     tf = body_shape.text_frame
[?2004l[?2004h>     tf.text = ""
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, title in enumerate(all_titles):
[?2004l[?2004h>         p = tf.add_paragraph()
[?2004l[?2004h>         p.text = title
[?2004l[?2004h>         p.level = 0
[?2004l[?2004h>         # The prompt asks for auto-numbered bullet points. 
[?2004l[?2004h>         # In pptx, this is often a property of the placeholder itself in the layout,
[?2004l[?2004h>         # but we can try to set the paragraph to be numbered if possible, 
[?2004l[?2004h>         # though standard pptx library doesn't have a direct 'numbered' property easily.
[?2004l[?2004h>         # However, usually the 'Content' placeholder in many templates is already bulleted.
[?2004l[?2004h>         # To be safe, I'll just add them as paragraphs.
[?2004l[?2004h> 
[?2004l[?2004h>     prs.save(output_path)
[?2004l[?2004h> 
[?2004l[?2004h> process_pptx('/root/Awesome-Agent-Papers.pptx', '/root/Awesome-Agent-Papers_processed.pptx')
