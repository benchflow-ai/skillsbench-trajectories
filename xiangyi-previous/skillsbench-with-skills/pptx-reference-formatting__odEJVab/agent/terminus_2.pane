[?2004hroot@d61935b92c72:~# cat << 'EOF' > process_pptx.py
[?2004l[?2004h> import pptx
[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.util import Inches, Pt
[?2004l[?2004h> from pptx.dml.color import RGBColor
[?2004l[?2004h> from pptx.enum.text import PP_ALIGN
[?2004l[?2004h> from pptx.oxml.xmlchemy import OxmlElement
[?2004l[?2004h> 
[?2004l[?2004h> def set_paragraph_numbered(paragraph):
[?2004l[?2004h>     """Sets the paragraph to be part of a numbered list."""
[?2004l[?2004h>     pPr = paragraph._p.get_or_add_pPr()
[?2004l[?2004h>     # Add buAutoNum to pPr
[?2004l[?2004h>     buAutoNum = OxmlElement('a:buAutoNum')
[?2004l[?2004h>     buAutoNum.set('type', 'arabicPeriod')
[?2004l[?2004h>     pPr.append(buAutoNum)
[?2004l[?2004h> 
[?2004l[?2004h> def process_pptx(input_path, output_path):
[?2004l[?2004h>     prs = Presentation(input_path)
[?2004l[?2004h>     slide_width = prs.slide_width
[?2004l[?2004h>     slide_height = prs.slide_height
[?2004l[?2004h>     
[?2004l[?2004h>     all_titles = []
[?2004l[?2004h>     
[?2004l[?2004h>     for i, slide in enumerate(prs.slides):
[?2004l[?2004h>         if i == 0: continue
[?2004l[?2004h>         
[?2004l[?2004h>         paper_title_shape = None
[?2004l[?2004h>         for shape in slide.shapes:
[?2004l[?2004h>             if not shape.has_text_frame:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             text = shape.text.strip()
[?2004l[?2004h>             if not text:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Heuristic to find the paper title box
[?2004l[?2004h>             # It's usually a TextBox or 文本框, and not the Title 1 or Content Placeholder
[?2004l[?2004h>             if "Title" in shape.name or "Placeholder" in shape.name:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             paper_title_shape = shape
[?2004l[?2004h>             break
[?2004l[?2004h>         
[?2004l[?2004h>         if paper_title_shape:
[?2004l[?2004h>             title_text = paper_title_shape.text.strip().replace('\n', ' ')
[?2004l[?2004h>             if title_text and title_text not in all_titles:
[?2004l[?2004h>                 all_titles.append(title_text)
[?2004l[?2004h>             
[?2004l[?2004h>             # Font type Arial, size 16, color #989596, no bold
[?2004l[?2004h>             for paragraph in paper_title_shape.text_frame.paragraphs:
[?2004l[?2004h>                 paragraph.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>                 for run in paragraph.runs:
[?2004l[?2004h>                     run.font.name = 'Arial'
[?2004l[?2004h>                     run.font.size = Pt(16)
[?2004l[?2004h>                     run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)
[?2004l[?2004h>                     run.font.bold = False
[?2004l[?2004h>             
[?2004l[?2004h>             # Adjust box width and position
[?2004l[?2004h>             paper_title_shape.width = slide_width - Inches(1)
[?2004l[?2004h>             paper_title_shape.left = (slide_width - paper_title_shape.width) // 2
[?2004l[?2004h>             # Position at bottom center
[?2004l[?2004h>             paper_title_shape.top = slide_height - Inches(0.6) # A bit closer to bottom
[?2004l[?2004h>             paper_title_shape.height = Inches(0.5)
[?2004l[?2004h>             
[?2004l[?2004h>     # Reference slide
[?2004l[?2004h>     ref_slide_layout = prs.slide_layouts[1]
[?2004l[?2004h>     ref_slide = prs.slides.add_slide(ref_slide_layout)
[?2004l[?2004h>     ref_slide.shapes.title.text = "Reference"
[?2004l[?2004h>     
