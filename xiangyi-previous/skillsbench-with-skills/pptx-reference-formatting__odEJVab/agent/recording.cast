[53.282949, "o", "python3 -c \"from pptx import Presentation; prs = Presentation('/root/Awesome-Agent-Papers_processed.pptx'); last_slide = prs.slides[-1]; print(f'Reference Slide Title: {last_slide.shapes.title.text}'); print('Paper Titles in Reference Slide:'); [print(f'- {p.text}') for p in last_slide.placeholders[1].text_frame.paragraphs if p.text.strip()]\"\r\n\u001b[?2004l\r"]
