[47.680457, "o", "\u001b[?2004h> "]
[47.680586, "o", "            paper_title_shape.top = slide_height - Inches(0.6) # A bit closer to bottom\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.68068, "o", "            paper_title_shape.height = Inches(0.5)\r\n\u001b[?2004l\r"]
[47.680729, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.680784, "o", ">     # Reference slide\r\n\u001b[?2004l\r"]
[47.680835, "o", "\u001b[?2004h> "]
[47.680892, "o", "    ref_slide_layout = prs.slide_layouts[1]\r\n\u001b[?2004l\r"]
[47.680941, "o", "\u001b[?2004h> "]
[47.681014, "o", "    ref_slide = prs.slides.add_slide(ref_slide_layout)\r\n\u001b[?2004l\r"]
[47.681063, "o", "\u001b[?2004h> "]
[47.681124, "o", "    ref_slide.shapes.title.text = \"Reference\"\r\n\u001b[?2004l\r"]
[47.68121, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.681289, "o", "    body_shape = ref_slide.placeholders[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.68139, "o", "    tf = body_shape.text_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.681465, "o", "    tf.text = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.681532, "o", "    for title in all_titles:\r\n\u001b[?2004l\r\u001b[?2004h>         p = tf.add_paragraph()\r\n\u001b[?2004l\r"]
[47.681591, "o", "\u001b[?2004h>         p.text = title\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.681664, "o", ">         set_paragraph_numbered(p)\r\n\u001b[?2004l\r"]
[47.681737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.681803, "o", "    prs.save(output_path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.681933, "o", "process_pptx('/root/Awesome-Agent-Papers.pptx', '/root/Awesome-Agent-Papers_processed.pptx')\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[47.681985, "o", "\r\n\u001b[?2004l\r"]
