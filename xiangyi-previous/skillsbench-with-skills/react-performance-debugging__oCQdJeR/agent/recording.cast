[293.151657, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[293.152135, "o", "  const prices = products.map(p => p.price);\r\n\u001b[?2004l\r\u001b[?2004h>   const ratings = products.map(p => p.rating);\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   const priceMean = mean(prices);\r\n\u001b[?2004l\r\u001b[?2004h>   const priceStd = std(prices);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.152282, "o", "  const priceVariance = variance(prices);\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.152402, "o", "  const ratingMedian = median(ratings);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.152541, "o", "  const ratingQuantiles = quantileSeq(ratings, [0.25, 0.75]);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
