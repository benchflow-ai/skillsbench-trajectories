[?2004l[?2004h> // The constraints say "Use React and Next.js patterns... bundle size reduction".
[?2004l[?2004h> // Let's assume standard import optimization.
[?2004l[?2004h> import { mean, std, median, quantileSeq, variance } from 'mathjs';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004ltex[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   reviews: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l
[?2004h> 
[?2004l [?2004h> // Sample products to compare
[?2004l[?2004h> const PRODUCTS: Product[] = [
[?2004l[?2004h>   { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },
[?2004l[?2004h>   { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },
[?2004l[?2004h>   { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },
[?2004l[?2004h>   { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },
[?2004l[?2004h>   { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },
[?2004l[?2004h> ];
[?2004l[?2004h> 
[?2004l[?2004h> function ComparisonTable({ products }: { products: Product[] }) {
[?2004l[?2004h>   // Using lodash for data transformations
[?2004l[?2004h>   const sorted = sortBy(products, ['price']);
[?2004l[?2004h>   const avgPrice = meanBy(products, 'price');
[?2004l[?2004h>   const totalReviews = sumBy(products, 'reviews');
[?2004l[?2004h>   const bestRated = maxBy(products, 'rating');
[?2004l[?2004h>   const cheapest = minBy(products, 'price');
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div className="bg-white rounded-xl shadow-md p-6">
[?2004l[?2004h>       <h2 className="text-xl font-bold mb-4">Comparison Overview</h2>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="grid grid-cols-4 gap-4 mb-6 text-center">
[?2004l[?2004h>         <div className="bg-blue-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-blue-600">${avgPrice.toFixed(2)}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Avg Price</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-green-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-green-600">{totalReviews.toLocaleString()}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Total Reviews</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-yellow-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-yellow-600">{bestRated?.name}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Best Rated</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-purple-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-purple-600">{cheapest?.name}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Best Value</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="overflow-x-auto">
[?2004l[?2004h>         <table className="w-full text-left">
[?2004l[?2004h>           <thead>
[?2004l[?2004h>             <tr className="border-b">
[?2004l[?2004h>               <th className="pb-2">Product</th>
[?2004l[?2004h>               <th className="pb-2">Price</th>
[?2004l[?2004h>               <th className="pb-2">Rating</th>
[?2004l[?2004h>               <th className="pb-2">Reviews</th>
[?2004l[?2004h>               <th className="pb-2">Status</th>
[?2004l[?2004h>             </tr>
[?2004l[?2004h>           </thead>
[?2004l[?2004h>           <tbody>
[?2004l[?2004h>             {sorted.map(product => (
[?2004l[?2004h>               <tr key={product.id} className="border-b last:border-0">
[?2004l[?2004h>                 <td className="py-3 font-medium">{product.name}</td>
[?2004l[?2004h>                 <td className="py-3">${product.price.toFixed(2)}</td>
[?2004l[?2004h>                 <td className="py-3">
[?2004l[?2004h>                   <span className="text-yellow-500">★</span> {product.rating}
[?2004l[?2004h>                 </td>
[?2004l[?2004h>                 <td className="py-3">{product.reviews.toLocaleString()}</td>
[?2004l[?2004h>                 <td className="py-3">
[?2004l[?2004h>                   <span className={`px-2 py-1 rounded-full text-xs ${product.inStock ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
[?2004l[?2004h>                     {product.inStock ? 'In Stock' : 'Out of Stock'}
[?2004l[?2004h>                   </span>
[?2004l[?2004h>                 </td>
[?2004l[?2004h>               </tr>
[?2004l[?2004h>             ))}
[?2004l[?2004h>           </tbody>
[?2004l[?2004h>         </table>
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function AdvancedAnalysis({ products }: { products: Product[] }) {
[?2004l[?2004h>   // Heavy calculations using mathjs
[?2004l[?2004h>   const prices = products.map(p => p.price);
[?2004l[?2004h>   const ratings = products.map(p => p.rating);
[?2004l[?2004h>   
[?2004l[?2004h>   const priceMean = mean(prices);
[?2004l[?2004h>   const priceStd = std(prices);
[?2004l[?2004h>   const priceVariance = variance(prices);
[?2004l[?2004h>   
[?2004l[?2004h>   const ratingMedian = median(ratings);
[?2004l[?2004h>   const ratingQuantiles = quantileSeq(ratings, [0.25, 0.75]);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div data-testid="advanced-content" className="bg-white rounded-xl shadow-md p-6">
[?2004l[?2004h>       <h2 className="text-xl font-bold mb-4">Advanced Analysis</h2>
[?2004l[?2004h>       
[?2004l[?2004h>       <div className="grid grid-cols-2 gap-8">
[?2004l[?2004h>         <div>
[?2004l[?2004h>           <h3 className="font-semibold mb-3 text-gray-700">Price Distribution</h3>
[?2004l[?2004h>           <dl className="space-y-2">
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">Mean Price:</dt>
[?2004l[?2004h>               <dd className="font-medium">${priceMean.toFixed(2)}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">Standard Deviation:</dt>
[?2004l[?2004h>               <dd className="font-medium">${priceStd.toFixed(2)}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">Variance:</dt>
[?2004l[?2004h>               <dd className="font-medium">{priceVariance.toFixed(2)}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>           </dl>
[?2004l[?2004h>         </div>
[?2004l[?2004h> 
[?2004l[?2004h>         <div>
[?2004l[?2004h>           <h3 className="font-semibold mb-3 text-gray-700">Rating Statistics</h3>
[?2004l[?2004h>           <dl className="space-y-2">
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">Median Rating:</dt>
[?2004l[?2004h>               <dd className="font-medium">{ratingMedian}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">25th Percentile:</dt>
[?2004l[?2004h>               <dd className="font-medium">{Array.isArray(ratingQuantiles) ? ratingQuantiles[0] : ratingQuantiles}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>             <div className="flex justify-between">
[?2004l[?2004h>               <dt className="text-gray-600">75th Percentile:</dt>
[?2004l[?2004h>               <dd className="font-medium">{Array.isArray(ratingQuantiles) ? ratingQuantiles[1] : ratingQuantiles}</dd>
[?2004l[?2004h>             </div>
[?2004l[?2004h>           </dl>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export default function ComparePage() {
[?2004l[?2004h>   const [activeTab, setActiveTab] = useState<'overview' | 'advanced'>('overview');
[?2004l[?2004h>   const [selectedProducts] = useState(PRODUCTS);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <main className="container mx-auto px-4 py-8">
[?2004l[?2004h>       <div className="mb-8">
[?2004l[?2004h>         <h1 className="text-3xl font-bold mb-2">Product Comparison</h1>
[?2004l[?2004h>         <p className="text-gray-600">Compare features and analyze product data.</p>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="mb-6">
[?2004l[?2004h>         <div className="border-b border-gray-200">
[?2004l[?2004h>           <nav className="flex gap-4">
[?2004l[?2004h>             <button
[?2004l[?2004h>               data-testid="tab-overview"
[?2004l[?2004h>               onClick={() => setActiveTab('overview')}
[?2004l[?2004h>               className={`py-3 px-4 font-medium border-b-2 transition-colors ${
[?2004l[?2004h>                 activeTab === 'overview'
[?2004l[?2004h>                   ? 'border-blue-600 text-blue-600'
[?2004l[?2004h>                   : 'border-transparent text-gray-500 hover:text-gray-700'
[?2004l[?2004h>               }`}
[?2004l[?2004h>             >
[?2004l[?2004h>               Overview
[?2004l[?2004h>             </button>
[?2004l[?2004h>             <button
[?2004l[?2004h>               data-testid="tab-advanced"
[?2004l[?2004h>               onClick={() => setActiveTab('advanced')}
[?2004l[?2004h>               className={`py-3 px-4 font-medium border-b-2 transition-colors ${
[?2004l[?2004h>                 activeTab === 'advanced'
[?2004l[?2004h>                   ? 'border-blue-600 text-blue-600'
[?2004l[?2004h>                   : 'border-transparent text-gray-500 hover:text-gray-700'
[?2004l[?2004h>               }`}
[?2004l[?2004h>             >
[?2004l[?2004h>               Advanced Analysis
[?2004l[?2004h>             </button>
[?2004l[?2004h>           </nav>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l[?2004h>       {activeTab === 'overview' ? (
[?2004l[?2004h>         <ComparisonTable products={selectedProducts} />
[?2004l[?2004h>       ) : (
[?2004l[?2004h>         <AdvancedAnalysis products={selectedProducts} />
[?2004l[?2004h>       )}
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="mt-6 text-center">
[?2004l[?2004h>         <a href="/" className="text-blue-600 hover:underline">← Back to Products</a>
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </main>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> EOF
