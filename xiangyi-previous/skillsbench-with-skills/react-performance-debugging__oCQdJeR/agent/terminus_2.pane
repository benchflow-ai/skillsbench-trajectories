[?2004l-rw-r--r-- 1 root root  560 Jan 26 12:32 src/app/api/products/route.ts
-rw-r--r-- 1 root root 8359 Jan 26 12:32 src/app/compare/page.tsx
-rw-r--r-- 1 root root 2228 Jan 26 12:32 src/components/ProductCard.tsx
-rw-r--r-- 1 root root 2610 Jan 26 12:32 src/components/ProductList.tsx
[?2004hroot@0b393b5aea4a:/app# 