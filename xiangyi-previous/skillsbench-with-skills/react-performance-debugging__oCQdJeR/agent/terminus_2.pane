[?2004l[?2004h> // src/components/ProductCard.tsx
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { memo } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> interface Props {
[?2004l[?2004h>   product: Product;
[?2004l[?2004h>   reviewCount: number;
[?2004l[?2004h>   onAddToCart: (id: string) => void;
[?2004l[?2004h>   isInCart: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export const ProductCard = memo(function ProductCard({ product, reviewCount, onAddToCart, isInCart }: Props) {
[?2004l[?2004h>   // Performance tracking: marks each render for debugging
[?2004l[?2004h>   performance.mark(`ProductCard-render-${product.id}`);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div className="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
[?2004l[?2004h>       <div className="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
[?2004l[?2004h>         <span className="text-6xl">📦</span>
[?2004l[?2004h>       </div>
[?2004l[?2004h>       <div className="p-4">
[?2004l[?2004h>         <div className="flex justify-between items-start mb-2">
[?2004l[?2004h>           <h3 className="font-semibold text-lg text-gray-900">{product.name}</h3>
[?2004l[?2004h>           <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
[?2004l[?2004h>             {product.category}
[?2004l[?2004h>           </span>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="flex items-center gap-1 mb-2">
[?2004l[?2004h>           {Array.from({ length: 5 }).map((_, i) => (
[?2004l[?2004h>             <span key={i} className={i < product.rating ? 'text-yellow-400' : 'text-gray-300'}>
[?2004l[?2004h>               ★
[?2004l[?2004h>             </span>
[?2004l[?2004h>           ))}
[?2004l[?2004h>           <span className="text-sm text-gray-500 ml-1">({reviewCount})</span>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="flex justify-between items-center mt-4">
[?2004l[?2004h>           <span className="text-2xl font-bold text-gray-900">
[?2004l[?2004h>             ${product.price.toFixed(2)}
[?2004l[?2004h>           </span>
[?2004l[?2004h>           <button
[?2004l[?2004h>             data-testid={`add-to-cart-${product.id}`}
[?2004l[?2004h>             onClick={() => onAddToCart(product.id)}
[?2004l[?2004h>             disabled={isInCart}
[?2004l[?2004h>             className={`px-4 py-2 rounded-lg font-medium transition-colors ${
[?2004l[?2004h>               isInCart
[?2004l[?2004h>                 ? 'bg-gray-200 text-gray-500 cursor-not-allowed'
[?2004l[?2004h>                 : 'bg-blue-600 text-white hover:bg-blue-700'
[?2004l[?2004h>             }`}
[?2004l[?2004h>           >
[?2004l[?2004h>             {isInCart ? '✓ In Cart' : 'Add to Cart'}
[?2004l[?2004h>           </button>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> });
