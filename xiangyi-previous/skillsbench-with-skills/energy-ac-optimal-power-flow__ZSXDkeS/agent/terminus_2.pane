[?2004l[?2004h> # Extract solution
[?2004l[?2004h> Vm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)
[?2004l[?2004h> Va_deg = Va_sol * 180 / np.pi
[?2004l[?2004h> Pg_mw = Pg_sol * baseMVA
[?2004l[?2004h> Qg_mvar = Qg_sol * baseMVA
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate branch flows
[?2004l[?2004h> def calc_branch_flows(Vm, Va):
[?2004l[?2004h>     V = Vm * np.exp(1j * Va)
[?2004l[?2004h>     Sf = np.diag(V) @ np.conj(Yf @ V)
[?2004l[?2004h>     St = np.diag(V) @ np.conj(Yt @ V)
[?2004l[?2004h>     return Sf * baseMVA, St * baseMVA
[?2004l[?2004h> 
[?2004l[?2004h> Sf, St = calc_branch_flows(Vm_sol, Va_sol)
[?2004l[?2004h> Sf_mva, St_mva = np.abs(Sf), np.abs(St)
[?2004l[?2004h> 
[?2004l[?2004h> # Totals
[?2004l[?2004h> total_load_mw = np.sum(Pd) * baseMVA
[?2004l[?2004h> total_load_mvar = np.sum(Qd) * baseMVA
[?2004l[?2004h> total_gen_mw = np.sum(Pg_mw)
[?2004l[?2004h> total_gen_mvar = np.sum(Qg_mvar)
[?2004l[?2004h> P_calc, Q_calc = calc_power(Vm_sol, Va_sol)
[?2004l[?2004h> total_losses = np.sum(P_calc) * baseMVA
[?2004l[?2004h> 
[?2004l[?2004h> # Feasibility
[?2004l[?2004h> mis = constraints(result.x)
[?2004l[?2004h> max_p_mis = np.max(np.abs(mis[:nbus])) * baseMVA
[?2004l[?2004h> max_q_mis = np.max(np.abs(mis[nbus:])) * baseMVA
[?2004l[?2004h> max_v_viol = max(np.max(Vm_sol - Vmax), np.max(Vmin - Vm_sol), 0)
[?2004l[?2004h> 
[?2004l[?2004h> # Branch loading
[?2004l[?2004h> loading = np.zeros(nbranch)
[?2004l[?2004h> for k in range(nbranch):
[?2004l[?2004h>     if rate_a[k] > 0 and br_status[k] == 1:
[?2004l[?2004h>         loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k]*baseMVA) * 100
[?2004l[?2004h> max_load_pct = np.max(loading)
[?2004l[?2004h> max_overload = max(0, max_load_pct - 100) * rate_a[np.argmax(loading)] * baseMVA / 100
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_v2.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Top loaded branches
[?2004l[?2004h> top_idx = np.argsort(loading)[-5:][::-1]
[?2004l[?2004h> most_loaded = []
[?2004l[?2004h> for k in top_idx:
[?2004l[?2004h>     if loading[k] > 0:
