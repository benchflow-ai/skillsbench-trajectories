[?2004l[?2004h> # Extract solution
[?2004l[?2004h> Vm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)
[?2004l[?2004h> Va_deg = Va_sol * 180 / np.pi
[?2004l[?2004h> Pg_mw = Pg_sol * baseMVA
[?2004l[?2004h> Qg_mvar = Qg_sol * baseMVA
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate branch flows
[?2004l[?2004h> def calc_flows(Vm, Va):
[?2004l[?2004h>     V = Vm * np.exp(1j * Va)
[?2004l[?2004h>     Sf, St = [], []
[?2004l[?2004h>     for k in range(nbranch):
[?2004l[?2004h>         i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]
[?2004l[?2004h>         if br_status[k] == 0 or (r[k] == 0 and x[k] == 0):
[?2004l[?2004h>             Sf.append(0); St.append(0)
[?2004l[?2004h>             continue
[?2004l[?2004h>         ys = 1.0 / (r[k] + 1j * x[k])
[?2004l[?2004h>         tap_k = tap[k] * np.exp(1j * shift[k])
[?2004l[?2004h>         Yff = (ys + 1j * b[k]/2) / (tap_k * np.conj(tap_k))
[?2004l[?2004h>         Yft = -ys / np.conj(tap_k)
[?2004l[?2004h>         Ytf = -ys / tap_k
[?2004l[?2004h>         Ytt = ys + 1j * b[k]/2
[?2004l[?2004h>         Sf.append(V[i] * np.conj(Yff*V[i] + Yft*V[j]))
[?2004l[?2004h>         St.append(V[j] * np.conj(Ytf*V[i] + Ytt*V[j]))
[?2004l[?2004h>     return np.array(Sf), np.array(St)
[?2004l[?2004h> 
[?2004l[?2004h> Sf, St = calc_flows(Vm_sol, Va_sol)
[?2004l[?2004h> Sf_mva = np.abs(Sf) * baseMVA
[?2004l[?2004h> St_mva = np.abs(St) * baseMVA
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_solver.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate totals
