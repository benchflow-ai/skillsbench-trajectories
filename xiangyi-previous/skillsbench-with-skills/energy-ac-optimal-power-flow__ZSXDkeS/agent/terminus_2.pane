[?2004l[?2004h> Gs = bus_data[:, 4] / baseMVA
[?2004l[?2004h> Bs = bus_data[:, 5] / baseMVA
[?2004l[?2004h> Vm_init = bus_data[:, 7]
[?2004l[?2004h> Vmax = bus_data[:, 11]
[?2004l[?2004h> Vmin = bus_data[:, 12]
[?2004l[?2004h> bus_idx = {int(bus_ids[i]): i for i in range(nbus)}
[?2004l[?2004h> 
[?2004l[?2004h> # Gen data
[?2004l[?2004h> gen_bus = gen_data[:, 0].astype(int)
[?2004l[?2004h> Qmax = gen_data[:, 3] / baseMVA
[?2004l[?2004h> Qmin = gen_data[:, 4] / baseMVA
[?2004l[?2004h> Pmax = gen_data[:, 8] / baseMVA
[?2004l[?2004h> Pmin = gen_data[:, 9] / baseMVA
[?2004l[?2004h> gen_status = gen_data[:, 7].astype(int)
[?2004l[?2004h> cost_c2 = gencost_data[:, 4]
[?2004l[?2004h> cost_c1 = gencost_data[:, 5]
[?2004l[?2004h> cost_c0 = gencost_data[:, 6]
[?2004l[?2004h> 
[?2004l[?2004h> # Branch data
[?2004l[?2004h> f_bus = branch_data[:, 0].astype(int)
[?2004l[?2004h> t_bus = branch_data[:, 1].astype(int)
[?2004l[?2004h> r = branch_data[:, 2]
[?2004l[?2004h> x = branch_data[:, 3]
[?2004l[?2004h> b_ch = branch_data[:, 4]
[?2004l[?2004h> rate_a = branch_data[:, 5] / baseMVA
[?2004l[?2004h> tap = np.where(branch_data[:, 8] == 0, 1.0, branch_data[:, 8])
[?2004l[?2004h> shift = branch_data[:, 9] * np.pi / 180
[?2004l[?2004h> br_status = branch_data[:, 10].astype(int)
[?2004l[?2004h> 
