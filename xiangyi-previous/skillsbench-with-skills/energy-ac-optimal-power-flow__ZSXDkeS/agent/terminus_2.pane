[?2004l[?2004h>     if rate_a[k] > 0 and br_status[k] == 1:
[?2004l[?2004h>         loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k] * baseMVA) * 100
[?2004l[?2004h> max_overload = max(0, np.max(loading) - 100) * rate_a[np.argmax(loading)] * baseMVA / 100 if np.max(loading) > 100 else 0
[?2004l[?2004h> 
[?2004l[?2004h> # Top 5 loaded branches
[?2004l[?2004h> top_idx = np.argsort(loading)[-5:][::-1]
[?2004l[?2004h> most_loaded = []
[?2004l[?2004h> for k in top_idx:
[?2004l[?2004h>     if loading[k] > 0:
[?2004l[?2004h>         most_loaded.append({
[?2004l[?2004h>             "from_bus": int(f_bus[k]), "to_bus": int(t_bus[k]),
[?2004l[?2004h>             "loading_pct": round(loading[k], 2),
[?2004l[?2004h>             "flow_from_MVA": round(Sf_mva[k], 2),
[?2004l[?2004h>             "flow_to_MVA": round(St_mva[k], 2),
[?2004l[?2004h>             "limit_MVA": round(rate_a[k] * baseMVA, 2)
[?2004l[?2004h>         })
[?2004l[?2004h> ENDOFFILE
