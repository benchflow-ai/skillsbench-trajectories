[?2004l[?2004h>             "loading_pct": round(loading[k],2), "flow_from_MVA": round(Sf_mva[k],2),
[?2004l[?2004h>             "flow_to_MVA": round(St_mva[k],2), "limit_MVA": round(rate_a[k]*baseMVA,2)})
[?2004l[?2004h> 
[?2004l[?2004h> # Generators and buses
[?2004l[?2004h> generators = [{"id": g+1, "bus": int(gen_bus[g]), "pg_MW": round(Pg_mw[g],2),
[?2004l[?2004h>     "qg_MVAr": round(Qg_mvar[g],2), "pmin_MW": round(Pmin[g]*baseMVA,2),
[?2004l[?2004h>     "pmax_MW": round(Pmax[g]*baseMVA,2), "qmin_MVAr": round(Qmin[g]*baseMVA,2),
[?2004l[?2004h>     "qmax_MVAr": round(Qmax[g]*baseMVA,2)} for g in range(ngen)]
[?2004l[?2004h> buses = [{"id": int(bus_ids[i]), "vm_pu": round(Vm_sol[i],4), "va_deg": round(Va_deg[i],2),
[?2004l[?2004h>     "vmin_pu": round(Vmin[i],2), "vmax_pu": round(Vmax[i],2)} for i in range(nbus)]
[?2004l[?2004h> 
[?2004l[?2004h> status = "optimal" if result.success else "suboptimal"
[?2004l[?2004h> report = {"summary": {"total_cost_per_hour": round(result.fun,2),
[?2004l[?2004h>     "total_load_MW": round(total_load_mw,2), "total_load_MVAr": round(total_load_mvar,2),
[?2004l[?2004h>     "total_generation_MW": round(total_gen_mw,2), "total_generation_MVAr": round(total_gen_mvar,2),
[?2004l[?2004h>     "total_losses_MW": round(total_losses,2), "solver_status": status},
[?2004l[?2004h>     "generators": generators, "buses": buses, "most_loaded_branches": most_loaded,
