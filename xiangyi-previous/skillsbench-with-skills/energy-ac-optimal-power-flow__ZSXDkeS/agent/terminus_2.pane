[?2004l[?2004h>         "id": g + 1, "bus": int(gen_bus[g]),
[?2004l[?2004h>         "pg_MW": round(Pg_mw[g], 2), "qg_MVAr": round(Qg_mvar[g], 2),
[?2004l[?2004h>         "pmin_MW": round(Pmin[g] * baseMVA, 2), "pmax_MW": round(Pmax[g] * baseMVA, 2),
[?2004l[?2004h>         "qmin_MVAr": round(Qmin[g] * baseMVA, 2), "qmax_MVAr": round(Qmax[g] * baseMVA, 2)
