[?2004l[?2004h> print(f"Network: {nbus} buses, {ngen} gens, {nbranch} branches")
[?2004l[?2004h> print(f"Total load: {np.sum(Pd)*baseMVA:.2f} MW")
[?2004l[?2004h> print(f"Total gen capacity: {np.sum(Pmax[gen_status==1])*baseMVA:.2f} MW")
