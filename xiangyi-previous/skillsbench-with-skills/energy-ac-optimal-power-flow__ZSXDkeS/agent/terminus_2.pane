[?2004l[?2004h> 
[?2004l[?2004h> # Build Ybus
[?2004l[?2004h> Ybus = np.zeros((nbus, nbus), dtype=complex)
[?2004l[?2004h> Yf = np.zeros((nbranch, nbus), dtype=complex)
[?2004l[?2004h> Yt = np.zeros((nbranch, nbus), dtype=complex)
[?2004l[?2004h> 
[?2004l[?2004h> for k in range(nbranch):
[?2004l[?2004h>     if br_status[k] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]
[?2004l[?2004h>     if r[k] == 0 and x[k] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     ys = 1.0 / (r[k] + 1j * x[k])
[?2004l[?2004h>     bc = b_ch[k]
[?2004l[?2004h>     tap_k = tap[k] * np.exp(1j * shift[k])
[?2004l[?2004h>     Yff = (ys + 1j*bc/2) / (np.abs(tap_k)**2)
[?2004l[?2004h>     Yft = -ys / np.conj(tap_k)
[?2004l[?2004h>     Ytf = -ys / tap_k
[?2004l[?2004h>     Ytt = ys + 1j*bc/2
[?2004l[?2004h>     Ybus[i,i] += Yff; Ybus[i,j] += Yft
[?2004l[?2004h>     Ybus[j,i] += Ytf; Ybus[j,j] += Ytt
[?2004l[?2004h>     Yf[k,i] = Yff; Yf[k,j] = Yft
[?2004l[?2004h>     Yt[k,i] = Ytf; Yt[k,j] = Ytt
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(nbus):
[?2004l[?2004h>     Ybus[i,i] += Gs[i] + 1j*Bs[i]
[?2004l[?2004h> 
[?2004l[?2004h> G = np.real(Ybus)
[?2004l[?2004h> B = np.imag(Ybus)
[?2004l[?2004h> print("Ybus built")
[?2004l[?2004h> 
[?2004l[?2004h> # Gen-bus incidence
[?2004l[?2004h> Cg = np.zeros((nbus, ngen))
[?2004l[?2004h> for g in range(ngen):
[?2004l[?2004h>     if gen_status[g] == 1:
[?2004l[?2004h>         Cg[bus_idx[gen_bus[g]], g] = 1
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_v2.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Variables: Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)
[?2004l[?2004h> # Use polar coordinates but with better scaling
[?2004l[?2004h> 
[?2004l[?2004h> def calc_power(Vm, Va):
[?2004l[?2004h>     """Calculate P and Q injections at each bus"""
[?2004l[?2004h>     P = np.zeros(nbus)
[?2004l[?2004h>     Q = np.zeros(nbus)
[?2004l[?2004h>     for i in range(nbus):
[?2004l[?2004h>         for j in range(nbus):
[?2004l[?2004h>             angle = Va[i] - Va[j]
[?2004l[?2004h>             P[i] += Vm[i]*Vm[j]*(G[i,j]*np.cos(angle) + B[i,j]*np.sin(angle))
[?2004l[?2004h>             Q[i] += Vm[i]*Vm[j]*(G[i,j]*np.sin(angle) - B[i,j]*np.cos(angle))
[?2004l[?2004h>     return P, Q
[?2004l[?2004h> 
[?2004l[?2004h> def unpack(x):
[?2004l[?2004h>     Vm = x[:nbus]
[?2004l[?2004h>     Va = x[nbus:2*nbus]
[?2004l[?2004h>     Pg = x[2*nbus:2*nbus+ngen]
[?2004l[?2004h>     Qg = x[2*nbus+ngen:]
[?2004l[?2004h>     return Vm, Va, Pg, Qg
[?2004l[?2004h> 
[?2004l[?2004h> def objective(x):
[?2004l[?2004h>     Pg = x[2*nbus:2*nbus+ngen]
[?2004l[?2004h>     Pg_mw = Pg * baseMVA
[?2004l[?2004h>     return np.sum(cost_c2 * Pg_mw**2 + cost_c1 * Pg_mw + cost_c0)
[?2004l[?2004h> 
[?2004l[?2004h> def constraints(x):
[?2004l[?2004h>     Vm, Va, Pg, Qg = unpack(x)
[?2004l[?2004h>     P_calc, Q_calc = calc_power(Vm, Va)
[?2004l[?2004h>     Pg_bus = Cg @ Pg
[?2004l[?2004h>     Qg_bus = Cg @ Qg
[?2004l[?2004h>     P_mis = Pg_bus - Pd - P_calc
[?2004l[?2004h>     Q_mis = Qg_bus - Qd - Q_calc
[?2004l[?2004h>     return np.concatenate([P_mis, Q_mis])
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_v2.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Initial point - flat start
[?2004l[?2004h> Vm0 = np.ones(nbus)
[?2004l[?2004h> Va0 = np.zeros(nbus)
[?2004l[?2004h> # Distribute load proportionally to gen capacity
[?2004l[?2004h> total_cap = np.sum(Pmax[gen_status==1])
[?2004l[?2004h> total_load = np.sum(Pd)
[?2004l[?2004h> Pg0 = np.zeros(ngen)
[?2004l[?2004h> for g in range(ngen):
[?2004l[?2004h>     if gen_status[g] == 1:
[?2004l[?2004h>         Pg0[g] = min(Pmax[g], max(Pmin[g], Pmax[g] * total_load / total_cap * 1.05))
[?2004l[?2004h> Qg0 = np.zeros(ngen)
[?2004l[?2004h> 
[?2004l[?2004h> x0 = np.concatenate([Vm0, Va0, Pg0, Qg0])
[?2004l[?2004h> 
[?2004l[?2004h> # Bounds
[?2004l[?2004h> lb = np.concatenate([Vmin, np.full(nbus, -np.pi), 
[?2004l[?2004h>     np.where(gen_status==1, Pmin, 0), np.where(gen_status==1, Qmin, 0)])
[?2004l[?2004h> ub = np.concatenate([Vmax, np.full(nbus, np.pi),
[?2004l[?2004h>     np.where(gen_status==1, Pmax, 0), np.where(gen_status==1, Qmax, 0)])
[?2004l[?2004h> lb[nbus+ref_bus] = 0; ub[nbus+ref_bus] = 0
[?2004l[?2004h> bounds = list(zip(lb, ub))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Initial gen: {np.sum(Pg0)*baseMVA:.2f} MW")
[?2004l[?2004h> print("Running optimization...")
[?2004l[?2004h> 
[?2004l[?2004h> result = minimize(objective, x0, method='trust-constr', bounds=bounds,
[?2004l[?2004h>     constraints={'type': 'eq', 'fun': constraints},
[?2004l[?2004h>     options={'maxiter': 300, 'verbose': 2, 'gtol': 1e-4})
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nStatus: {result.message}")
[?2004l[?2004h> print(f"Success: {result.success}")
[?2004l[?2004h> print(f"Cost: ${result.fun:,.2f}/hr")
[?2004l[?2004h> ENDOFFILE
