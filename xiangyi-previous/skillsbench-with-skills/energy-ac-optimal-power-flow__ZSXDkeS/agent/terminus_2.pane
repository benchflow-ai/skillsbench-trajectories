[?2004l[?2004h> # Build Ybus matrix
[?2004l[?2004h> Ybus = np.zeros((nbus, nbus), dtype=complex)
[?2004l[?2004h> for k in range(nbranch):
[?2004l[?2004h>     if br_status[k] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     i = bus_idx[f_bus[k]]
[?2004l[?2004h>     j = bus_idx[t_bus[k]]
[?2004l[?2004h>     if r[k] == 0 and x[k] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     ys = 1.0 / (r[k] + 1j * x[k])
[?2004l[?2004h>     bc = b[k]
[?2004l[?2004h>     tap_k = tap[k] * np.exp(1j * shift[k])
[?2004l[?2004h>     Yff = (ys + 1j * bc / 2) / (tap_k * np.conj(tap_k))
[?2004l[?2004h>     Yft = -ys / np.conj(tap_k)
[?2004l[?2004h>     Ytf = -ys / tap_k
[?2004l[?2004h>     Ytt = ys + 1j * bc / 2
[?2004l[?2004h>     Ybus[i, i] += Yff
[?2004l[?2004h>     Ybus[i, j] += Yft
[?2004l[?2004h>     Ybus[j, i] += Ytf
[?2004l[?2004h>     Ybus[j, j] += Ytt
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(nbus):
[?2004l[?2004h>     Ybus[i, i] += Gs[i] + 1j * Bs[i]
[?2004l[?2004h> 
[?2004l[?2004h> print("Ybus built")
[?2004l[?2004h> 
[?2004l[?2004h> # Gen at bus mapping
[?2004l[?2004h> gen_at_bus = [[] for _ in range(nbus)]
[?2004l[?2004h> for g in range(ngen):
[?2004l[?2004h>     if gen_status[g] == 1:
[?2004l[?2004h>         gen_at_bus[bus_idx[gen_bus[g]]].append(g)
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_solver.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Variables: [Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)]
[?2004l[?2004h> nvar = 2 * nbus + 2 * ngen
[?2004l[?2004h> 
[?2004l[?2004h> def unpack(x):
[?2004l[?2004h>     return x[:nbus], x[nbus:2*nbus], x[2*nbus:2*nbus+ngen], x[2*nbus+ngen:]
[?2004l[?2004h> 
[?2004l[?2004h> def objective(x):
[?2004l[?2004h>     Pg = x[2*nbus:2*nbus+ngen] * baseMVA
[?2004l[?2004h>     return np.sum(cost_c2 * Pg**2 + cost_c1 * Pg + cost_c0)
[?2004l[?2004h> 
[?2004l[?2004h> def power_balance(x):
[?2004l[?2004h>     Vm, Va, Pg, Qg = unpack(x)
[?2004l[?2004h>     V = Vm * np.exp(1j * Va)
[?2004l[?2004h>     S_inj = V * np.conj(Ybus @ V)
[?2004l[?2004h>     Pg_bus = np.zeros(nbus)
[?2004l[?2004h>     Qg_bus = np.zeros(nbus)
[?2004l[?2004h>     for g in range(ngen):
[?2004l[?2004h>         if gen_status[g] == 1:
[?2004l[?2004h>             bi = bus_idx[gen_bus[g]]
[?2004l[?2004h>             Pg_bus[bi] += Pg[g]
[?2004l[?2004h>             Qg_bus[bi] += Qg[g]
[?2004l[?2004h>     P_mis = Pg_bus - Pd - np.real(S_inj)
[?2004l[?2004h>     Q_mis = Qg_bus - Qd - np.imag(S_inj)
[?2004l[?2004h>     return np.concatenate([P_mis, Q_mis])
[?2004l[?2004h> ENDOFFILE
[?2004l[?2004hroot@9f1b6d1d752d:~# cat >> acopf_solver.py << 'ENDOFFILE'
[?2004l[?2004h> 
[?2004l[?2004h> # Initial point
[?2004l[?2004h> Vm0 = Vm_init.copy()
[?2004l[?2004h> Va0 = np.zeros(nbus)
[?2004l[?2004h> Pg0 = np.clip(gen_data[:, 1] / baseMVA, Pmin, Pmax)
[?2004l[?2004h> Qg0 = np.clip(gen_data[:, 2] / baseMVA, Qmin, Qmax)
[?2004l[?2004h> for g in range(ngen):
[?2004l[?2004h>     if gen_status[g] == 0:
[?2004l[?2004h>         Pg0[g] = 0
[?2004l[?2004h>         Qg0[g] = 0
[?2004l[?2004h> x0 = np.concatenate([Vm0, Va0, Pg0, Qg0])
[?2004l[?2004h> 
[?2004l[?2004h> # Bounds
[?2004l[?2004h> lb_Vm, ub_Vm = Vmin, Vmax
[?2004l[?2004h> lb_Va, ub_Va = np.full(nbus, -np.pi), np.full(nbus, np.pi)
[?2004l[?2004h> lb_Va[ref_bus], ub_Va[ref_bus] = 0, 0
[?2004l[?2004h> lb_Pg = np.where(gen_status == 1, Pmin, 0)
[?2004l[?2004h> ub_Pg = np.where(gen_status == 1, Pmax, 0)
[?2004l[?2004h> lb_Qg = np.where(gen_status == 1, Qmin, 0)
[?2004l[?2004h> ub_Qg = np.where(gen_status == 1, Qmax, 0)
[?2004l[?2004h> lb = np.concatenate([lb_Vm, lb_Va, lb_Pg, lb_Qg])
[?2004l[?2004h> ub = np.concatenate([ub_Vm, ub_Va, ub_Pg, ub_Qg])
[?2004l[?2004h> bounds = list(zip(lb, ub))
[?2004l[?2004h> 
[?2004l[?2004h> print("Starting optimization...")
[?2004l[?2004h> result = minimize(objective, x0, method='SLSQP', bounds=bounds,
[?2004l[?2004h>     constraints={'type': 'eq', 'fun': power_balance},
[?2004l[?2004h>     options={'maxiter': 500, 'ftol': 1e-4, 'disp': True})
[?2004l[?2004h> print(f"Status: {result.message}")
[?2004l[?2004h> print(f"Cost: ${result.fun:,.2f}/hr")
[?2004l[?2004h> ENDOFFILE
