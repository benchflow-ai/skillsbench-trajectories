[?2004l[?2004h> Vmin = bus_data[:, 12]
[?2004l[?2004h> bus_idx = {int(bus_ids[i]): i for i in range(nbus)}
[?2004l[?2004h> 
[?2004l[?2004h> # Gen data
[?2004l[?2004h> gen_bus = gen_data[:, 0].astype(int)
[?2004l[?2004h> Qmax = gen_data[:, 3] / baseMVA
[?2004l[?2004h> Qmin = gen_data[:, 4] / baseMVA
[?2004l[?2004h> Pmax = gen_data[:, 8] / baseMVA
