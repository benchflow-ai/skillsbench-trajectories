[400.886035, "i", "cat > acopf_v2.py << 'ENDOFFILE'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize, NonlinearConstraint\nfrom scipy.sparse import csr_matrix\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbus_data = np.array(data['bus'])\ngen_data = np.array(data['gen'])\nbranch_data = np.array(data['branch'])\ngencost_data = np.array(data['gencost'])\n\nnbus, ngen, nbranch = len(bus_data), len(gen_data), len(branch_data)\n\n# Bus data\nbus_ids = bus_data[:, 0].astype(int)\nbus_type = bus_data[:, 1].astype(int)\nPd = bus_data[:, 2] / baseMVA\nQd = bus_data[:, 3] / baseMVA\nGs = bus_data[:, 4] / baseMVA\nBs = bus_data[:, 5] / baseMVA\nVm_init = bus_data[:, 7]\nVmax = bus_data[:, 11]\nVmin = bus_data[:, 12]\nbus_idx = {int(bus_ids[i]): i for i in range(nbus)}\n\n# Gen data\ngen_bus = gen_data[:, 0].astype(int)\nQmax = gen_data[:, 3] / baseMVA\nQmin = gen_data[:, 4] / baseMVA\nPmax = gen_data[:, 8] / baseMVA\nPmin = gen_data[:, 9] / baseMVA\ngen_status = gen_data[:, 7].astype(int)\ncost_c2 = gencost_data[:, 4]\ncost_c1 = gencost_data[:, 5]\ncost_c0 = gencost_data[:, 6]\n\n# Branch data\nf_bus = branch_data[:, 0].astype(int)\nt_bus = branch_data[:, 1].astype(int)\nr = branch_data[:, 2]\nx = branch_data[:, 3]\nb_ch = branch_data[:, 4]\nrate_a = branch_data[:, 5] / baseMVA\ntap = np.where(branch_data[:, 8] == 0, 1.0, branch_data[:, 8])\nshift = branch_data[:, 9] * np.pi / 180\nbr_status = branch_data[:, 10].astype(int)\n\nref_bus = np.where(bus_type == 3)[0][0]\nprint(f\"Network: {nbus} buses, {ngen} gens, {nbranch} branches\")\nprint(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW\")\nprint(f\"Total gen capacity: {np.sum(Pmax[gen_status==1])*baseMVA:.2f} MW\")\nENDOFFILE\n"]
[400.886313, "o", "cat > acopf_v2.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
