[436.1476, "o", "print(f\"Cost: ${result.fun:,.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
[436.148707, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[450.141315, "i", "cat >> acopf_v2.py << 'ENDOFFILE'\n\n# Extract solution\nVm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)\nVa_deg = Va_sol * 180 / np.pi\nPg_mw = Pg_sol * baseMVA\nQg_mvar = Qg_sol * baseMVA\n\n# Calculate branch flows\ndef calc_branch_flows(Vm, Va):\n    V = Vm * np.exp(1j * Va)\n    Sf = np.diag(V) @ np.conj(Yf @ V)\n    St = np.diag(V) @ np.conj(Yt @ V)\n    return Sf * baseMVA, St * baseMVA\n\nSf, St = calc_branch_flows(Vm_sol, Va_sol)\nSf_mva, St_mva = np.abs(Sf), np.abs(St)\n\n# Totals\ntotal_load_mw = np.sum(Pd) * baseMVA\ntotal_load_mvar = np.sum(Qd) * baseMVA\ntotal_gen_mw = np.sum(Pg_mw)\ntotal_gen_mvar = np.sum(Qg_mvar)\nP_calc, Q_calc = calc_power(Vm_sol, Va_sol)\ntotal_losses = np.sum(P_calc) * baseMVA\n\n# Feasibility\nmis = constraints(result.x)\nmax_p_mis = np.max(np.abs(mis[:nbus])) * baseMVA\nmax_q_mis = np.max(np.abs(mis[nbus:])) * baseMVA\nmax_v_viol = max(np.max(Vm_sol - Vmax), np.max(Vmin - Vm_sol), 0)\n\n# Branch loading\nloading = np.zeros(nbranch)\nfor k in range(nbranch):\n    if rate_a[k] > 0 and br_status[k] == 1:\n        loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k]*baseMVA) * 100\nmax_load_pct = np.max(loading)\nmax_overload = max(0, max_load_pct - 100) * rate_a[np.argmax(loading)] * baseMVA / 100\nENDOFFILE\n"]
[450.141557, "o", "cat >> acopf_v2.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[450.141661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[450.141719, "o", "> # Extract solution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.141772, "o", "Vm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.141835, "o", "Va_deg = Va_sol * 180 / np.pi\r\n\u001b[?2004l\r\u001b[?2004h"]
[450.141921, "o", "> Pg_mw = Pg_sol * baseMVA\r\n\u001b[?2004l\r"]
[450.142015, "o", "\u001b[?2004h> Qg_mvar = Qg_sol * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142061, "o", "# Calculate branch flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142105, "o", "def calc_branch_flows(Vm, Va):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142157, "o", "    V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h"]
[450.142209, "o", "> "]
[450.142261, "o", "    Sf = np.diag(V) @ np.conj(Yf @ V)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142314, "o", "    St = np.diag(V) @ np.conj(Yt @ V)\r\n\u001b[?2004l\r\u001b[?2004h"]
[450.142438, "o", "> "]
[450.14248, "o", "    return Sf * baseMVA, St * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142542, "o", "Sf, St = calc_branch_flows(Vm_sol, Va_sol)\r\n\u001b[?2004l\r"]
[450.142666, "o", "\u001b[?2004h> Sf_mva, St_mva = np.abs(Sf), np.abs(St)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142749, "o", "# Totals\r\n\u001b[?2004l\r\u001b[?2004h> total_load_mw = np.sum(Pd) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142856, "o", "total_load_mvar = np.sum(Qd) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142891, "o", "total_gen_mw = np.sum(Pg_mw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.142927, "o", "total_gen_mvar = np.sum(Qg_mvar)\r\n\u001b[?2004l\r\u001b[?2004h> "]
