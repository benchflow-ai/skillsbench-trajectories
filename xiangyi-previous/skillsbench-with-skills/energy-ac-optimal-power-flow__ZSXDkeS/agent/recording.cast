[240.479791, "i", "cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Initial point\nVm0 = Vm_init.copy()\nVa0 = np.zeros(nbus)\nPg0 = np.clip(gen_data[:, 1] / baseMVA, Pmin, Pmax)\nQg0 = np.clip(gen_data[:, 2] / baseMVA, Qmin, Qmax)\nfor g in range(ngen):\n    if gen_status[g] == 0:\n        Pg0[g] = 0\n        Qg0[g] = 0\nx0 = np.concatenate([Vm0, Va0, Pg0, Qg0])\n\n# Bounds\nlb_Vm, ub_Vm = Vmin, Vmax\nlb_Va, ub_Va = np.full(nbus, -np.pi), np.full(nbus, np.pi)\nlb_Va[ref_bus], ub_Va[ref_bus] = 0, 0\nlb_Pg = np.where(gen_status == 1, Pmin, 0)\nub_Pg = np.where(gen_status == 1, Pmax, 0)\nlb_Qg = np.where(gen_status == 1, Qmin, 0)\nub_Qg = np.where(gen_status == 1, Qmax, 0)\nlb = np.concatenate([lb_Vm, lb_Va, lb_Pg, lb_Qg])\nub = np.concatenate([ub_Vm, ub_Va, ub_Pg, ub_Qg])\nbounds = list(zip(lb, ub))\n\nprint(\"Starting optimization...\")\nresult = minimize(objective, x0, method='SLSQP', bounds=bounds,\n    constraints={'type': 'eq', 'fun': power_balance},\n    options={'maxiter': 500, 'ftol': 1e-4, 'disp': True})\nprint(f\"Status: {result.message}\")\nprint(f\"Cost: ${result.fun:,.2f}/hr\")\nENDOFFILE\n"]
