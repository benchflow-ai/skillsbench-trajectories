[412.747535, "o", "# Gen-bus incidence\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.747606, "o", "> "]
[412.74767, "o", "Cg = np.zeros((nbus, ngen))\r\n\u001b[?2004l\r\u001b[?2004h> for g in range(ngen):\r\n\u001b[?2004l\r"]
[412.74772, "o", "\u001b[?2004h>     if gen_status[g] == 1:\r\n\u001b[?2004l\r"]
[412.747781, "o", "\u001b[?2004h> "]
[412.74784, "o", "        Cg[bus_idx[gen_bus[g]], g] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
