[252.776786, "i", "cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Extract solution\nVm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)\nVa_deg = Va_sol * 180 / np.pi\nPg_mw = Pg_sol * baseMVA\nQg_mvar = Qg_sol * baseMVA\n\n# Calculate branch flows\ndef calc_flows(Vm, Va):\n    V = Vm * np.exp(1j * Va)\n    Sf, St = [], []\n    for k in range(nbranch):\n        i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]\n        if br_status[k] == 0 or (r[k] == 0 and x[k] == 0):\n            Sf.append(0); St.append(0)\n            continue\n        ys = 1.0 / (r[k] + 1j * x[k])\n        tap_k = tap[k] * np.exp(1j * shift[k])\n        Yff = (ys + 1j * b[k]/2) / (tap_k * np.conj(tap_k))\n        Yft = -ys / np.conj(tap_k)\n        Ytf = -ys / tap_k\n        Ytt = ys + 1j * b[k]/2\n        Sf.append(V[i] * np.conj(Yff*V[i] + Yft*V[j]))\n        St.append(V[j] * np.conj(Ytf*V[i] + Ytt*V[j]))\n    return np.array(Sf), np.array(St)\n\nSf, St = calc_flows(Vm_sol, Va_sol)\nSf_mva = np.abs(Sf) * baseMVA\nSt_mva = np.abs(St) * baseMVA\nENDOFFILE\n"]
[252.777001, "o", "cat >> acopf_solver.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[252.777062, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[252.777141, "o", "\u001b[?2004h> "]
[252.777184, "o", "# Extract solution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777243, "o", "Vm_sol, Va_sol, Pg_sol, Qg_sol = unpack(result.x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777289, "o", "Va_deg = Va_sol * 180 / np.pi\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.777339, "o", "> Pg_mw = Pg_sol * baseMVA\r\n\u001b[?2004l\r"]
[252.777385, "o", "\u001b[?2004h> "]
[252.777434, "o", "Qg_mvar = Qg_sol * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777472, "o", "# Calculate branch flows\r\n\u001b[?2004l\r"]
[252.77752, "o", "\u001b[?2004h> "]
[252.777575, "o", "def calc_flows(Vm, Va):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777612, "o", "    V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777659, "o", "    Sf, St = [], []\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.777708, "o", "> "]
[252.777761, "o", "    for k in range(nbranch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.7778, "o", "        i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]\r\n\u001b[?2004l\r"]
[252.777845, "o", "\u001b[?2004h> "]
[252.77791, "o", "        if br_status[k] == 0 or (r[k] == 0 and x[k] == 0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.777978, "o", "            Sf.append(0); St.append(0)\r\n\u001b[?2004l\r"]
[252.778004, "o", "\u001b[?2004h> "]
[252.778055, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.778085, "o", "> "]
[252.778115, "o", "        ys = 1.0 / (r[k] + 1j * x[k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.778219, "o", "        tap_k = tap[k] * np.exp(1j * shift[k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.778306, "o", "        Yff = (ys + 1j * b[k]/2) / (tap_k * np.conj(tap_k))\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.778364, "o", "> "]
[252.778404, "o", "        Yft = -ys / np.conj(tap_k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.778476, "o", "        Ytf = -ys / tap_k\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.778529, "o", "        Ytt = ys + 1j * b[k]/2\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.778562, "o", "> "]
[252.778637, "o", "        Sf.append(V[i] * np.conj(Yff*V[i] + Yft*V[j]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.778697, "o", "        St.append(V[j] * np.conj(Ytf*V[i] + Ytt*V[j]))\r\n\u001b[?2004l\r"]
[252.778741, "o", "\u001b[?2004h> "]
[252.778784, "o", "    return np.array(Sf), np.array(St)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[252.778836, "o", "\u001b[?2004h> "]
[252.778884, "o", "Sf, St = calc_flows(Vm_sol, Va_sol)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.778908, "o", "> "]
[252.778979, "o", "Sf_mva = np.abs(Sf) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.779026, "o", "St_mva = np.abs(St) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
[252.780104, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[265.75552, "i", "cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Calculate totals\ntotal_load_mw = np.sum(Pd) * baseMVA\ntotal_load_mvar = np.sum(Qd) * baseMVA\ntotal_gen_mw = np.sum(Pg_mw)\ntotal_gen_mvar = np.sum(Qg_mvar)\ntotal_losses = total_gen_mw - total_load_mw\n\n# Check feasibility\nmismatch = power_balance(result.x)\nmax_p_mis = np.max(np.abs(mismatch[:nbus])) * baseMVA\nmax_q_mis = np.max(np.abs(mismatch[nbus:])) * baseMVA\nmax_v_viol = max(np.max(Vm_sol - Vmax), np.max(Vmin - Vm_sol), 0)\n\n# Branch loading\nloading = np.zeros(nbranch)\nfor k in range(nbranch):\n    if rate_a[k] > 0 and br_status[k] == 1:\n        loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k] * baseMVA) * 100\nmax_overload = max(0, np.max(loading) - 100) * rate_a[np.argmax(loading)] * baseMVA / 100 if np.max(loading) > 100 else 0\n\n# Top 5 loaded branches\ntop_idx = np.argsort(loading)[-5:][::-1]\nmost_loaded = []\nfor k in top_idx:\n    if loading[k] > 0:\n        most_loaded.append({\n            \"from_bus\": int(f_bus[k]), \"to_bus\": int(t_bus[k]),\n            \"loading_pct\": round(loading[k], 2),\n            \"flow_from_MVA\": round(Sf_mva[k], 2),\n            \"flow_to_MVA\": round(St_mva[k], 2),\n            \"limit_MVA\": round(rate_a[k] * baseMVA, 2)\n        })\nENDOFFILE\n"]
[265.755745, "o", "cat >> acopf_solver.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[265.755817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.755867, "o", "# Calculate totals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.755912, "o", "total_load_mw = np.sum(Pd) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.755961, "o", "> "]
[265.756012, "o", "total_load_mvar = np.sum(Qd) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756063, "o", "total_gen_mw = np.sum(Pg_mw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.756115, "o", "> total_gen_mvar = np.sum(Qg_mvar)\r\n\u001b[?2004l\r"]
[265.756165, "o", "\u001b[?2004h> "]
[265.7562, "o", "total_losses = total_gen_mw - total_load_mw\r\n\u001b[?2004l\r"]
[265.756248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756304, "o", "# Check feasibility\r\n\u001b[?2004l\r"]
[265.756364, "o", "\u001b[?2004h> "]
[265.756421, "o", "mismatch = power_balance(result.x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756475, "o", "max_p_mis = np.max(np.abs(mismatch[:nbus])) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756556, "o", "max_q_mis = np.max(np.abs(mismatch[nbus:])) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756672, "o", "max_v_viol = max(np.max(Vm_sol - Vmax), np.max(Vmin - Vm_sol), 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[265.756703, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[265.756769, "o", "# Branch loading\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.756822, "o", "> loading = np.zeros(nbranch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.756853, "o", "for k in range(nbranch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.756942, "o", "> "]
[265.757001, "o", "    if rate_a[k] > 0 and br_status[k] == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757065, "o", "        loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k] * baseMVA) * 100\r\n\u001b[?2004l\r"]
[265.757135, "o", "\u001b[?2004h> "]
[265.757289, "o", "max_overload = max(0, np.max(loading) - 100) * rate_a[np.argmax(loading)] * baseMVA / 100 if np.max(loading) > 100 else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[265.757339, "o", "\u001b[?2004h> "]
[265.757387, "o", "# Top 5 loaded branches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757445, "o", "top_idx = np.argsort(loading)[-5:][::-1]\r\n\u001b[?2004l\r"]
[265.757472, "o", "\u001b[?2004h> "]
[265.75752, "o", "most_loaded = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757567, "o", "for k in top_idx:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757635, "o", "    if loading[k] > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757674, "o", "        most_loaded.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[265.757758, "o", "            \"from_bus\": int(f_bus[k]), \"to_bus\": int(t_bus[k]),\r\n\u001b[?2004l\r"]
[265.757805, "o", "\u001b[?2004h> "]
[265.757851, "o", "            \"loading_pct\": round(loading[k], 2),\r\n\u001b[?2004l\r"]
[265.757878, "o", "\u001b[?2004h> "]
[265.757946, "o", "            \"flow_from_MVA\": round(Sf_mva[k], 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.757994, "o", "> "]
[265.758036, "o", "            \"flow_to_MVA\": round(St_mva[k], 2),\r\n\u001b[?2004l\r"]
[265.758086, "o", "\u001b[?2004h> "]
[265.758138, "o", "            \"limit_MVA\": round(rate_a[k] * baseMVA, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.758192, "o", ">         })\r\n\u001b[?2004l\r"]
[265.758243, "o", "\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
[265.759331, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[278.156561, "i", "cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Build generators list\ngenerators = []\nfor g in range(ngen):\n    generators.append({\n        \"id\": g + 1, \"bus\": int(gen_bus[g]),\n        \"pg_MW\": round(Pg_mw[g], 2), \"qg_MVAr\": round(Qg_mvar[g], 2),\n        \"pmin_MW\": round(Pmin[g] * baseMVA, 2), \"pmax_MW\": round(Pmax[g] * baseMVA, 2),\n        \"qmin_MVAr\": round(Qmin[g] * baseMVA, 2), \"qmax_MVAr\": round(Qmax[g] * baseMVA, 2)\n    })\n\n# Build buses list\nbuses = []\nfor i in range(nbus):\n    buses.append({\n        \"id\": int(bus_ids[i]), \"vm_pu\": round(Vm_sol[i], 4),\n        \"va_deg\": round(Va_deg[i], 2),\n        \"vmin_pu\": round(Vmin[i], 2), \"vmax_pu\": round(Vmax[i], 2)\n    })\n\n# Build report\nstatus = \"optimal\" if result.success else \"suboptimal\"\nreport = {\n    \"summary\": {\n        \"total_cost_per_hour\": round(result.fun, 2),\n        \"total_load_MW\": round(total_load_mw, 2),\n        \"total_load_MVAr\": round(total_load_mvar, 2),\n        \"total_generation_MW\": round(total_gen_mw, 2),\n        \"total_generation_MVAr\": round(total_gen_mvar, 2),\n        \"total_losses_MW\": round(total_losses, 2),\n        \"solver_status\": status\n    },\n    \"generators\": generators,\n    \"buses\": buses,\n    \"most_loaded_branches\": most_loaded,\n    \"feasibility_check\": {\n        \"max_p_mismatch_MW\": round(max_p_mis, 4),\n        \"max_q_mismatch_MVAr\": round(max_q_mis, 4),\n        \"max_voltage_violation_pu\": round(max_v_viol, 4),\n        \"max_branch_overload_MVA\": round(max_overload, 4)\n    }\n}\n\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\nprint(\"Report saved to report.json\")\nENDOFFILE\n"]
