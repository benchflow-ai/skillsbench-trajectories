[133.778055, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[196.149028, "i", "cat > acopf_part1.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbus_data = np.array(data['bus'])\ngen_data = np.array(data['gen'])\nbranch_data = np.array(data['branch'])\ngencost_data = np.array(data['gencost'])\n\nnbus = len(bus_data)\nngen = len(gen_data)\nnbranch = len(branch_data)\n\n# Bus data extraction\nbus_ids = bus_data[:, 0].astype(int)\nbus_type = bus_data[:, 1].astype(int)\nPd = bus_data[:, 2] / baseMVA\nQd = bus_data[:, 3] / baseMVA\nGs = bus_data[:, 4] / baseMVA\nBs = bus_data[:, 5] / baseMVA\nVm_init = bus_data[:, 7]\nVa_init = bus_data[:, 8] * np.pi / 180\nVmax = bus_data[:, 11]\nVmin = bus_data[:, 12]\n\nbus_idx = {int(bus_ids[i]): i for i in range(nbus)}\n\n# Generator data\ngen_bus = gen_data[:, 0].astype(int)\nPg_init = gen_data[:, 1] / baseMVA\nQg_init = gen_data[:, 2] / baseMVA\nQmax = gen_data[:, 3] / baseMVA\nQmin = gen_data[:, 4] / baseMVA\nPmax = gen_data[:, 8] / baseMVA\nPmin = gen_data[:, 9] / baseMVA\ngen_status = gen_data[:, 7].astype(int)\n\n# Cost coefficients\ncost_c2 = gencost_data[:, 4] * baseMVA**2\ncost_c1 = gencost_data[:, 5] * baseMVA\ncost_c0 = gencost_data[:, 6]\n\nprint(f\"Loaded: {nbus} buses, {ngen} gens, {nbranch} branches\")\nprint(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW\")\nEOF\n"]
