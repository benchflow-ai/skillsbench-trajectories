[230.893718, "o", "    Pg_bus = np.zeros(nbus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.893773, "o", "    Qg_bus = np.zeros(nbus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.893829, "o", "    for g in range(ngen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.893949, "o", "        if gen_status[g] == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.894035, "o", "            bi = bus_idx[gen_bus[g]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
