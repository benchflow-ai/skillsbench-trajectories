[412.747018, "o", "\u001b[?2004h> "]
[412.747077, "o", "    Yt[k,i] = Ytf; Yt[k,j] = Ytt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.747108, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
