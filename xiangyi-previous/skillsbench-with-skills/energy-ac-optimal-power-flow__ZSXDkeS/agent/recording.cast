[450.143756, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[450.143805, "o", "> # Branch loading\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.14387, "o", "loading = np.zeros(nbranch)\r\n\u001b[?2004l\r"]
[450.14392, "o", "\u001b[?2004h> "]
[450.143969, "o", "for k in range(nbranch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[450.144021, "o", "> "]
[450.144077, "o", "    if rate_a[k] > 0 and br_status[k] == 1:\r\n\u001b[?2004l\r"]
[450.144126, "o", "\u001b[?2004h> "]
[450.144277, "o", "        loading[k] = max(Sf_mva[k], St_mva[k]) / (rate_a[k]*baseMVA) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[450.144344, "o", "max_load_pct = np.max(loading)\r\n\u001b[?2004l\r"]
[450.144391, "o", "\u001b[?2004h> "]
[450.144569, "o", "max_overload = max(0, max_load_pct - 100) * rate_a[np.argmax(loading)] * baseMVA / 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[450.144627, "o", "> ENDOFFILE\r\n\u001b[?2004l\r"]
[450.145679, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[464.146705, "i", "cat >> acopf_v2.py << 'ENDOFFILE'\n\n# Top loaded branches\ntop_idx = np.argsort(loading)[-5:][::-1]\nmost_loaded = []\nfor k in top_idx:\n    if loading[k] > 0:\n        most_loaded.append({\"from_bus\": int(f_bus[k]), \"to_bus\": int(t_bus[k]),\n            \"loading_pct\": round(loading[k],2), \"flow_from_MVA\": round(Sf_mva[k],2),\n            \"flow_to_MVA\": round(St_mva[k],2), \"limit_MVA\": round(rate_a[k]*baseMVA,2)})\n\n# Generators and buses\ngenerators = [{\"id\": g+1, \"bus\": int(gen_bus[g]), \"pg_MW\": round(Pg_mw[g],2),\n    \"qg_MVAr\": round(Qg_mvar[g],2), \"pmin_MW\": round(Pmin[g]*baseMVA,2),\n    \"pmax_MW\": round(Pmax[g]*baseMVA,2), \"qmin_MVAr\": round(Qmin[g]*baseMVA,2),\n    \"qmax_MVAr\": round(Qmax[g]*baseMVA,2)} for g in range(ngen)]\nbuses = [{\"id\": int(bus_ids[i]), \"vm_pu\": round(Vm_sol[i],4), \"va_deg\": round(Va_deg[i],2),\n    \"vmin_pu\": round(Vmin[i],2), \"vmax_pu\": round(Vmax[i],2)} for i in range(nbus)]\n\nstatus = \"optimal\" if result.success else \"suboptimal\"\nreport = {\"summary\": {\"total_cost_per_hour\": round(result.fun,2),\n    \"total_load_MW\": round(total_load_mw,2), \"total_load_MVAr\": round(total_load_mvar,2),\n    \"total_generation_MW\": round(total_gen_mw,2), \"total_generation_MVAr\": round(total_gen_mvar,2),\n    \"total_losses_MW\": round(total_losses,2), \"solver_status\": status},\n    \"generators\": generators, \"buses\": buses, \"most_loaded_branches\": most_loaded,\n    \"feasibility_check\": {\"max_p_mismatch_MW\": round(max_p_mis,4),\n    \"max_q_mismatch_MVAr\": round(max_q_mis,4), \"max_voltage_violation_pu\": round(max_v_viol,4),\n    \"max_branch_overload_MVA\": round(max_overload,4)}}\n\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\nprint(f\"\\nReport saved. Losses: {total_losses:.2f} MW\")\nprint(f\"Max mismatch: P={max_p_mis:.4f} MW, Q={max_q_mis:.4f} MVAr\")\nENDOFFILE\n"]
