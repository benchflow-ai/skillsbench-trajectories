[436.146794, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.146881, "o", "print(f\"Initial gen: {np.sum(Pg0)*baseMVA:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.146912, "o", "> "]
[436.146968, "o", "print(\"Running optimization...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
