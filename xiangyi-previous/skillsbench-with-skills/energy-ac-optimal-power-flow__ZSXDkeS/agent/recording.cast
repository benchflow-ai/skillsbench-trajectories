[412.749162, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[424.309778, "i", "cat >> acopf_v2.py << 'ENDOFFILE'\n\n# Variables: Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)\n# Use polar coordinates but with better scaling\n\ndef calc_power(Vm, Va):\n    \"\"\"Calculate P and Q injections at each bus\"\"\"\n    P = np.zeros(nbus)\n    Q = np.zeros(nbus)\n    for i in range(nbus):\n        for j in range(nbus):\n            angle = Va[i] - Va[j]\n            P[i] += Vm[i]*Vm[j]*(G[i,j]*np.cos(angle) + B[i,j]*np.sin(angle))\n            Q[i] += Vm[i]*Vm[j]*(G[i,j]*np.sin(angle) - B[i,j]*np.cos(angle))\n    return P, Q\n\ndef unpack(x):\n    Vm = x[:nbus]\n    Va = x[nbus:2*nbus]\n    Pg = x[2*nbus:2*nbus+ngen]\n    Qg = x[2*nbus+ngen:]\n    return Vm, Va, Pg, Qg\n\ndef objective(x):\n    Pg = x[2*nbus:2*nbus+ngen]\n    Pg_mw = Pg * baseMVA\n    return np.sum(cost_c2 * Pg_mw**2 + cost_c1 * Pg_mw + cost_c0)\n\ndef constraints(x):\n    Vm, Va, Pg, Qg = unpack(x)\n    P_calc, Q_calc = calc_power(Vm, Va)\n    Pg_bus = Cg @ Pg\n    Qg_bus = Cg @ Qg\n    P_mis = Pg_bus - Pd - P_calc\n    Q_mis = Qg_bus - Qd - Q_calc\n    return np.concatenate([P_mis, Q_mis])\nENDOFFILE\n"]
[424.309994, "o", "cat >> acopf_v2.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[424.310111, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310232, "o", "# Variables: Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.310292, "o", "> # Use polar coordinates but with better scaling\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.310382, "o", "\u001b[?2004h> def calc_power(Vm, Va):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310475, "o", "    \"\"\"Calculate P and Q injections at each bus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310537, "o", "    P = np.zeros(nbus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310626, "o", "    Q = np.zeros(nbus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310708, "o", "    for i in range(nbus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310776, "o", "        for j in range(nbus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310856, "o", "            angle = Va[i] - Va[j]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.310969, "o", "            P[i] += Vm[i]*Vm[j]*(G[i,j]*np.cos(angle) + B[i,j]*np.sin(angle))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311075, "o", "            Q[i] += Vm[i]*Vm[j]*(G[i,j]*np.sin(angle) - B[i,j]*np.cos(angle))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311154, "o", "    return P, Q\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.311214, "o", "\u001b[?2004h> def unpack(x):\r\n\u001b[?2004l\r\u001b[?2004h>     Vm = x[:nbus]\r\n\u001b[?2004l\r"]
[424.311269, "o", "\u001b[?2004h>     Va = x[nbus:2*nbus]\r\n\u001b[?2004l\r"]
[424.311329, "o", "\u001b[?2004h>     Pg = x[2*nbus:2*nbus+ngen]\r\n\u001b[?2004l\r"]
[424.31139, "o", "\u001b[?2004h>     Qg = x[2*nbus+ngen:]\r\n\u001b[?2004l\r"]
[424.311445, "o", "\u001b[?2004h>     return Vm, Va, Pg, Qg\r\n\u001b[?2004l\r"]
[424.3115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311554, "o", "def objective(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311612, "o", "    Pg = x[2*nbus:2*nbus+ngen]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311666, "o", "    Pg_mw = Pg * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311773, "o", "    return np.sum(cost_c2 * Pg_mw**2 + cost_c1 * Pg_mw + cost_c0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.31182, "o", "\u001b[?2004h> "]
[424.311872, "o", "def constraints(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311926, "o", "    Vm, Va, Pg, Qg = unpack(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.311975, "o", "    P_calc, Q_calc = calc_power(Vm, Va)\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.312027, "o", ">     Pg_bus = Cg @ Pg\r\n\u001b[?2004l\r"]
[424.312079, "o", "\u001b[?2004h>     Qg_bus = Cg @ Qg\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.312127, "o", "> "]
[424.312176, "o", "    P_mis = Pg_bus - Pd - P_calc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.312237, "o", "    Q_mis = Qg_bus - Qd - Q_calc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.312291, "o", "    return np.concatenate([P_mis, Q_mis])\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.312355, "o", "> ENDOFFILE\r\n\u001b[?2004l\r"]
[424.313383, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[436.144973, "i", "cat >> acopf_v2.py << 'ENDOFFILE'\n\n# Initial point - flat start\nVm0 = np.ones(nbus)\nVa0 = np.zeros(nbus)\n# Distribute load proportionally to gen capacity\ntotal_cap = np.sum(Pmax[gen_status==1])\ntotal_load = np.sum(Pd)\nPg0 = np.zeros(ngen)\nfor g in range(ngen):\n    if gen_status[g] == 1:\n        Pg0[g] = min(Pmax[g], max(Pmin[g], Pmax[g] * total_load / total_cap * 1.05))\nQg0 = np.zeros(ngen)\n\nx0 = np.concatenate([Vm0, Va0, Pg0, Qg0])\n\n# Bounds\nlb = np.concatenate([Vmin, np.full(nbus, -np.pi), \n    np.where(gen_status==1, Pmin, 0), np.where(gen_status==1, Qmin, 0)])\nub = np.concatenate([Vmax, np.full(nbus, np.pi),\n    np.where(gen_status==1, Pmax, 0), np.where(gen_status==1, Qmax, 0)])\nlb[nbus+ref_bus] = 0; ub[nbus+ref_bus] = 0\nbounds = list(zip(lb, ub))\n\nprint(f\"Initial gen: {np.sum(Pg0)*baseMVA:.2f} MW\")\nprint(\"Running optimization...\")\n\nresult = minimize(objective, x0, method='trust-constr', bounds=bounds,\n    constraints={'type': 'eq', 'fun': constraints},\n    options={'maxiter': 300, 'verbose': 2, 'gtol': 1e-4})\n\nprint(f\"\\nStatus: {result.message}\")\nprint(f\"Success: {result.success}\")\nprint(f\"Cost: ${result.fun:,.2f}/hr\")\nENDOFFILE\n"]
[436.145214, "o", "cat >> acopf_v2.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
