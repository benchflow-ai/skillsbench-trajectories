[211.031375, "o", "bus_idx = {int(bus_ids[i]): i for i in range(nbus)}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031444, "o", "# Gen data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031515, "o", "gen_bus = gen_data[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031583, "o", "Qmax = gen_data[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031655, "o", "Qmin = gen_data[:, 4] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031728, "o", "Pmax = gen_data[:, 8] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031798, "o", "Pmin = gen_data[:, 9] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031866, "o", "gen_status = gen_data[:, 7].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.031933, "o", "cost_c2 = gencost_data[:, 4] * baseMVA**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032003, "o", "cost_c1 = gencost_data[:, 5] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032039, "o", "cost_c0 = gencost_data[:, 6]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[211.032072, "o", "\u001b[?2004h> "]
[211.032152, "o", "# Branch data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032229, "o", "f_bus = branch_data[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032265, "o", "t_bus = branch_data[:, 1].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.0323, "o", "r = branch_data[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032374, "o", "x = branch_data[:, 3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032453, "o", "b = branch_data[:, 4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032522, "o", "rate_a = branch_data[:, 5] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.032592, "o", "tap = np.where(branch_data[:, 8] == 0, 1.0, branch_data[:, 8])\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.032666, "o", "> shift = branch_data[:, 9] * np.pi / 180\r\n\u001b[?2004l\r"]
[211.032772, "o", "\u001b[?2004h> br_status = branch_data[:, 10].astype(int)\r\n\u001b[?2004l\r"]
[211.03287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ref_bus = np.where(bus_type == 3)[0][0]\r\n\u001b[?2004l\r"]
[211.032909, "o", "\u001b[?2004h> "]
[211.033125, "o", "print(f\"Network: {nbus} buses, {ngen} gens, {nbranch} branches\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.033207, "o", "print(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW, {np.sum(Qd)*baseMVA:.2f} MVAr\")\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
[211.03427, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[221.057894, "i", "cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Build Ybus matrix\nYbus = np.zeros((nbus, nbus), dtype=complex)\nfor k in range(nbranch):\n    if br_status[k] == 0:\n        continue\n    i = bus_idx[f_bus[k]]\n    j = bus_idx[t_bus[k]]\n    if r[k] == 0 and x[k] == 0:\n        continue\n    ys = 1.0 / (r[k] + 1j * x[k])\n    bc = b[k]\n    tap_k = tap[k] * np.exp(1j * shift[k])\n    Yff = (ys + 1j * bc / 2) / (tap_k * np.conj(tap_k))\n    Yft = -ys / np.conj(tap_k)\n    Ytf = -ys / tap_k\n    Ytt = ys + 1j * bc / 2\n    Ybus[i, i] += Yff\n    Ybus[i, j] += Yft\n    Ybus[j, i] += Ytf\n    Ybus[j, j] += Ytt\n\nfor i in range(nbus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\nprint(\"Ybus built\")\n\n# Gen at bus mapping\ngen_at_bus = [[] for _ in range(nbus)]\nfor g in range(ngen):\n    if gen_status[g] == 1:\n        gen_at_bus[bus_idx[gen_bus[g]]].append(g)\nENDOFFILE\n"]
[221.058161, "o", "cat >> acopf_solver.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
