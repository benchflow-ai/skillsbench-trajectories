[464.147882, "o", "            \"loading_pct\": round(loading[k],2), \"flow_from_MVA\": round(Sf_mva[k],2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.148065, "o", "            \"flow_to_MVA\": round(St_mva[k],2), \"limit_MVA\": round(rate_a[k]*baseMVA,2)})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[464.148141, "o", "\u001b[?2004h> "]
[464.148175, "o", "# Generators and buses\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.148321, "o", "generators = [{\"id\": g+1, \"bus\": int(gen_bus[g]), \"pg_MW\": round(Pg_mw[g],2),\r\n\u001b[?2004l\r"]
[464.148375, "o", "\u001b[?2004h> "]
[464.148509, "o", "    \"qg_MVAr\": round(Qg_mvar[g],2), \"pmin_MW\": round(Pmin[g]*baseMVA,2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.148559, "o", "> "]
[464.148688, "o", "    \"pmax_MW\": round(Pmax[g]*baseMVA,2), \"qmin_MVAr\": round(Qmin[g]*baseMVA,2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.148735, "o", "> "]
[464.148831, "o", "    \"qmax_MVAr\": round(Qmax[g]*baseMVA,2)} for g in range(ngen)]\r\n\u001b[?2004l\r"]
[464.148858, "o", "\u001b[?2004h> "]
[464.149036, "o", "buses = [{\"id\": int(bus_ids[i]), \"vm_pu\": round(Vm_sol[i],4), \"va_deg\": round(Va_deg[i],2),\r\n\u001b[?2004l\r"]
[464.149107, "o", "\u001b[?2004h> "]
[464.149251, "o", "    \"vmin_pu\": round(Vmin[i],2), \"vmax_pu\": round(Vmax[i],2)} for i in range(nbus)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.149306, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.149366, "o", "status = \"optimal\" if result.success else \"suboptimal\"\r\n\u001b[?2004l\r"]
[464.149437, "o", "\u001b[?2004h> "]
[464.149493, "o", "report = {\"summary\": {\"total_cost_per_hour\": round(result.fun,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.149631, "o", "    \"total_load_MW\": round(total_load_mw,2), \"total_load_MVAr\": round(total_load_mvar,2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.149677, "o", "> "]
[464.149803, "o", "    \"total_generation_MW\": round(total_gen_mw,2), \"total_generation_MVAr\": round(total_gen_mvar,2),\r\n\u001b[?2004l\r"]
[464.14983, "o", "\u001b[?2004h> "]
[464.149936, "o", "    \"total_losses_MW\": round(total_losses,2), \"solver_status\": status},\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.149965, "o", "> "]
[464.15008, "o", "    \"generators\": generators, \"buses\": buses, \"most_loaded_branches\": most_loaded,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.150184, "o", "    \"feasibility_check\": {\"max_p_mismatch_MW\": round(max_p_mis,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.150211, "o", "> "]
[464.150339, "o", "    \"max_q_mismatch_MVAr\": round(max_q_mis,4), \"max_voltage_violation_pu\": round(max_v_viol,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.150369, "o", "> "]
[464.150444, "o", "    \"max_branch_overload_MVA\": round(max_overload,4)}}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.150473, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.150498, "o", "> "]
[464.150561, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.150642, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.150724, "o", "print(f\"\\nReport saved. Losses: {total_losses:.2f} MW\")\r\n\u001b[?2004l\r"]
[464.150748, "o", "\u001b[?2004h> "]
[464.150845, "o", "print(f\"Max mismatch: P={max_p_mis:.4f} MW, Q={max_q_mis:.4f} MVAr\")\r\n\u001b[?2004l\r"]
[464.15089, "o", "\u001b[?2004h> ENDOFFILE\r\n\u001b[?2004l\r"]
[464.152058, "o", "\u001b[?2004hroot@9f1b6d1d752d:~# "]
[469.141264, "i", "python3 acopf_v2.py\n"]
[469.141494, "o", "python3 acopf_v2.py\r\n\u001b[?2004l\r"]
[469.36512, "o", "Loading data...\r\n"]
[469.367381, "o", "Network: 300 buses, 69 gens, 411 branches\r\nTotal load: 23525.85 MW\r\n"]
[469.367505, "o", "Total gen capacity: 36077.00 MW\r\n"]
[469.375044, "o", "Ybus built\r\n"]
[469.375546, "o", "Initial gen: 24702.14 MW\r\nRunning optimization...\r\n"]
