[412.744927, "i", "cat >> acopf_v2.py << 'ENDOFFILE'\n\n# Build Ybus\nYbus = np.zeros((nbus, nbus), dtype=complex)\nYf = np.zeros((nbranch, nbus), dtype=complex)\nYt = np.zeros((nbranch, nbus), dtype=complex)\n\nfor k in range(nbranch):\n    if br_status[k] == 0:\n        continue\n    i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]\n    if r[k] == 0 and x[k] == 0:\n        continue\n    ys = 1.0 / (r[k] + 1j * x[k])\n    bc = b_ch[k]\n    tap_k = tap[k] * np.exp(1j * shift[k])\n    Yff = (ys + 1j*bc/2) / (np.abs(tap_k)**2)\n    Yft = -ys / np.conj(tap_k)\n    Ytf = -ys / tap_k\n    Ytt = ys + 1j*bc/2\n    Ybus[i,i] += Yff; Ybus[i,j] += Yft\n    Ybus[j,i] += Ytf; Ybus[j,j] += Ytt\n    Yf[k,i] = Yff; Yf[k,j] = Yft\n    Yt[k,i] = Ytf; Yt[k,j] = Ytt\n\nfor i in range(nbus):\n    Ybus[i,i] += Gs[i] + 1j*Bs[i]\n\nG = np.real(Ybus)\nB = np.imag(Ybus)\nprint(\"Ybus built\")\n\n# Gen-bus incidence\nCg = np.zeros((nbus, ngen))\nfor g in range(ngen):\n    if gen_status[g] == 1:\n        Cg[bus_idx[gen_bus[g]], g] = 1\nENDOFFILE\n"]
[412.745167, "o", "cat >> acopf_v2.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[412.745236, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
