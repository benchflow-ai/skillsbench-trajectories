[379.254163, "o", "{\r\n  \"summary\": {\r\n    \"total_cost_per_hour\": 54370430.08,\r\n    \"total_load_MW\": 23525.85,\r\n    \"total_load_MVAr\": 7787.97,\r\n    \"total_generation_MW\": 23492.07,\r\n    \"total_generation_MVAr\": 2301.55,\r\n    \"total_losses_MW\": -33.78,\r\n    \"solver_status\": \"suboptimal\"\r\n  },\r\n  \"generators\": [\r\n    {\r\n      \"id\": 1,\r\n      \"bus\": 43,\r\n      \"pg_MW\": 609.73,\r\n      \"qg_MVAr\": 9.99,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 718.0,\r\n      \"qmin_MVAr\": 0.0,\r\n      \"qmax_MVAr\": 10.0\r\n    },\r\n    {\r\n      \"id\": 2,\r\n      \"bus\": 200,\r\n      \"pg_MW\": 854.64,\r\n      \"qg_MVAr\": 75.3,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 881.0,\r\n      \"qmin_MVAr\": -300.0,\r\n      \"qmax_MVAr\": 300.0\r\n    },\r\n    {\r\n      \"id\": 3,\r\n      \"bus\": 209,\r\n      \"pg_MW\": 194.47,\r\n      \"qg_MVAr\": 39.81,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 203.0,\r\n      \"qmin_MVAr\": 0.0,\r\n      \"qmax_MVAr\": 87.0\r\n    },\r\n    {\r\n      \"id\": 4,\r\n      \"bus\": 11,\r\n      \"pg_MW\": 635.22,\r\n      \"qg_MVAr\": -52.76,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 670.0,\r\n      \"qmin_MVAr\": -280.0,\r\n      \"qmax_MVAr\": 280.0\r\n"]
