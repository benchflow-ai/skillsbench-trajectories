[412.745539, "o", "Yf = np.zeros((nbranch, nbus), dtype=complex)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.745599, "o", "> Yt = np.zeros((nbranch, nbus), dtype=complex)\r\n\u001b[?2004l\r"]
[412.74565, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[412.745682, "o", "> "]
[412.745742, "o", "for k in range(nbranch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.745799, "o", "    if br_status[k] == 0:\r\n\u001b[?2004l\r"]
[412.745879, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[412.74594, "o", "\u001b[?2004h> "]
[412.745994, "o", "    i, j = bus_idx[f_bus[k]], bus_idx[t_bus[k]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746052, "o", "    if r[k] == 0 and x[k] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.7461, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746216, "o", "    ys = 1.0 / (r[k] + 1j * x[k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746283, "o", "    bc = b_ch[k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746334, "o", "    tap_k = tap[k] * np.exp(1j * shift[k])\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.746396, "o", "> "]
[412.74645, "o", "    Yff = (ys + 1j*bc/2) / (np.abs(tap_k)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746551, "o", "    Yft = -ys / np.conj(tap_k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746621, "o", "    Ytf = -ys / tap_k\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746681, "o", "    Ytt = ys + 1j*bc/2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.746755, "o", "    Ybus[i,i] += Yff; Ybus[i,j] += Yft\r\n\u001b[?2004l\r"]
[412.746807, "o", "\u001b[?2004h> "]
[412.746853, "o", "    Ybus[j,i] += Ytf; Ybus[j,j] += Ytt\r\n\u001b[?2004l\r"]
[412.746915, "o", "\u001b[?2004h> "]
