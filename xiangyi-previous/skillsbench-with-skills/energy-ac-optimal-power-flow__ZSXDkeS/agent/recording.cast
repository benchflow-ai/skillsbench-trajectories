[436.146457, "o", "> "]
[436.146494, "o", "ub = np.concatenate([Vmax, np.full(nbus, np.pi),\r\n\u001b[?2004l\r"]
[436.146538, "o", "\u001b[?2004h> "]
[436.146625, "o", "    np.where(gen_status==1, Pmax, 0), np.where(gen_status==1, Qmax, 0)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.146671, "o", "> "]
