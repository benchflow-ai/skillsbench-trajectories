[57.696365, "o", "grep -n 'def ' /root/SimPO/scripts/simpo_trainer.py\r\n\u001b[?2004l\r\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        #             \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kmake_inputs_require_grad(module, input, output):\r\n\u001b[32m\u001b[K168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        #         \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kmake_inputs_require_grad(module, input, output):\r\n\u001b[32m\u001b[K297\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_tokenized_answer(self, prompt, answer):\r\n\u001b[32m\u001b[K347\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize_row(self, feature, model: Optional[Union[PreTrainedModel, nn.Module]] = None) -> Dict:\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kconcatenated_inputs(\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksimpo_loss(\r\n\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kconcatenated_forward(\r\n\u001b[32m\u001b[K630\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_batch_logps(\r\n\u001b[32m\u001b[K667\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_batch_loss_metrics(\r\n\u001b[32m\u001b[K714\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcompute_loss(\r\n\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_batch_samples(self, model, batch: Dict[str, torch.LongTensor]) -> Tuple[str, str]:\r\n\u001b[32m\u001b[K759\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kprediction_step(\r\n\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kstore_metrics(self, metrics: Dict[str, float], train_eval: Literal[\"train\", \"eval\"] = \"train\") -> None:\r\n\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kevaluation_loop(\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klog(self, logs: Dict[str, float]) -> None:\r\n\u001b[32m\u001b[K868\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kpush_to_hub(self, commit_message: Optional[str] = \"End of training\", blocking: bool = True, **kwargs) -> str:\r\n\u001b[?2004hroot@30fd55b3792a:~# "]
