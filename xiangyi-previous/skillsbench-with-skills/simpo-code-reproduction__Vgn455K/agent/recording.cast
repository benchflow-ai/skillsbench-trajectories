[63.120907, "o", "    ) -> Tuple[torch.FloatTensor, torch.FloatTensor, torch.FloatTensor]:"]
[63.120942, "o", "\r\n"]
[63.12098, "o", "        \"\"\"Compute the SimPO loss for a batch of policy model log probabilities."]
[63.121014, "o", "\r\n"]
[63.121048, "o", "\r\n"]
[63.121083, "o", "        Args:"]
[63.121123, "o", "\r\n"]
[63.121161, "o", "            policy_chosen_logps: Log probabilities of the policy model for the chosen responses. Shape: (batch_size,)"]
[63.121203, "o", "\r\n"]
[63.121254, "o", "            policy_rejected_logps: Log probabilities of the policy model for the rejected responses. Shape: (batch_size,)"]
[63.121291, "o", "\r\n"]
[63.121326, "o", "\r\n"]
[63.121362, "o", "        Returns:"]
[63.121396, "o", "\r\n"]
[63.121435, "o", "            A tuple of three tensors: (losses, chosen_rewards, rejected_rewards)."]
[63.121472, "o", "\r\n"]
[63.121841, "o", "            The losses tensor contains the SimPO loss for each example in the batch."]
[63.121868, "o", "\r\n"]
[63.1219, "o", "            The chosen_rewards and rejected_rewards tensors contain the rewards for the chosen and rejected responses, respectively."]
[63.121923, "o", "\r\n"]
[63.121968, "o", "        \"\"\""]
[63.122075, "o", "\r\n"]
[63.122112, "o", "\r\n        return losses, chosen_rewards, rejected_rewards\r\n\r\n    def concatenated_forward(\r\n        self, model: nn.Module, batch: Dict[str, Union[List, torch.LongTensor]]\r\n    ) -> Tuple[torch.FloatTensor, torch.FloatTensor, torch.FloatTensor, torch.FloatTensor]:\r\n        \"\"\"Run the given model on the given batch of inputs, concatenating the chosen and rejected inputs together.\r\n\r\n        We do this to avoid doing two forward passes, because it's faster for FSDP.\r\n"]
[63.12229, "o", "        \"\"\""]
[63.122329, "o", "\r\n"]
