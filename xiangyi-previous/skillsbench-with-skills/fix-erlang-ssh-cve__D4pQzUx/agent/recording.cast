[115.764503, "o", "226:-define(SSH_DISCONNECT_HOST_NOT_ALLOWED_TO_CONNECT,   1).\r\n227:-define(SSH_DISCONNECT_PROTOCOL_ERROR,   2).\r\n228:-define(SSH_DISCONNECT_KEY_EXCHANGE_FAILED,   3).\r\n229:-define(SSH_DISCONNECT_RESERVED,   4).\r\n230:-define(SSH_DISCONNECT_MAC_ERROR,   5).\r\n231:-define(SSH_DISCONNECT_COMPRESSION_ERROR,   6).\r\n232:-define(SSH_DISCONNECT_SERVICE_NOT_AVAILABLE,   7).\r\n233:-define(SSH_DISCONNECT_PROTOCOL_VERSION_NOT_SUPPORTED,   8).\r\n234:-define(SSH_DISCONNECT_HOST_KEY_NOT_VERIFIABLE,   9).\r\n235:-define(SSH_DISCONNECT_CONNECTION_LOST,  10).\r\n236:-define(SSH_DISCONNECT_BY_APPLICATION,  11).\r\n237:-define(SSH_DISCONNECT_TOO_MANY_CONNECTIONS,  12).\r\n238:-define(SSH_DISCONNECT_AUTH_CANCELLED_BY_USER,  13).\r\n239:-define(SSH_DISCONNECT_NO_MORE_AUTH_METHODS_AVAILABLE,  14).\r\n240:-define(SSH_DISCONNECT_ILLEGAL_USER_NAME,  15).\r\n"]
