[56.756276, "o", "\u001b[32m\u001b[K730\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kssh_connection:handle_msg\u001b[m\u001b[K(Msg, D0#data.connection_state, ?role(StateName), D0#data.ssh_params),\r\n\u001b[32m\u001b[K763\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    try \u001b[01;31m\u001b[Kssh_connection:handle_msg\u001b[m\u001b[K(Msg, Connection0, Role, D0#data.ssh_params) of\r\n"]
