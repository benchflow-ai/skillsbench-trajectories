[38.756843, "o", "grep -n \"handle.*exec\" ssh_connection.erl\r\n\u001b[?2004l\r"]
[38.757991, "o", "\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    ssh_connection_\u001b[01;31m\u001b[Khandler:request(ConnectionRef, self(), ChannelId, \"exec\u001b[m\u001b[K\",\r\n"]
[38.758066, "o", "\u001b[32m\u001b[K1156\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Khandle_msg(#ssh_msg_channel_request{request_type = \"exec\u001b[m\u001b[K\"},\r\n"]
[38.758254, "o", "\u001b[?2004hroot@5252d2d4dfad:/app/workspace/otp_src_27.3.2/lib/ssh/src# "]
