[280.906389, "o", "    %% Connection messages should only be processed after successful authentication\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.906496, "o", "    Disconnect = #ssh_msg_disconnect{code = ?SSH_DISCONNECT_PROTOCOL_ERROR,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.906698, "o", "                                      description = \"Connection message received before authentication\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
