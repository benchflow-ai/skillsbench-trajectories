[72.083872, "o", "444:\t      userauth_supported_methods = AuthMethods,\r\n474:                       userauth_quiet_mode = ?GET_OPT(quiet_mode, Opts),\r\n478:            S1#ssh{userauth_pubkeys = [K || K <- ?GET_OPT(pref_public_key_algs, Opts),\r\n487:\t\t   userauth_methods = string:tokens(AuthMethods, \",\"),\r\n552:      | {userauth,                  role()                    }\r\n553:      | {userauth_keyboard_interactive,       role()          }\r\n554:      | {userauth_keyboard_interactive_extra, server          }\r\n555:      | {userauth_keyboard_interactive_info_response, client  }\r\n694:\t\"ssh-userauth\" ->\r\n696:\t    {ok, {Reply, Ssh}} = ssh_auth:handle_userauth_request(Msg, SessionId, Ssh0),\r\n698:\t    {next_state, {userauth,server}, D, {change_callback_module,ssh_fsm_userauth_server}};\r\n708:handle_event(internal, #ssh_msg_service_accept{name = \"ssh-userauth\"}, {service_request,client},\r\n709:\t     #data{ssh_params = #ssh{service=\"ssh-userauth\"} = Ssh0} = D0) ->\r\n710:    {Msg, Ssh} = ssh_auth:init_userauth_request_msg(Ssh0),\r\n714:    {next_state, {userauth,client}, D, {change_callback_module,ssh_fsm_userauth_client}};\r\n1641:                                    userauth_pubkeys=ClientSigAlgs}=Ssh0}) ->\r\n1666:            userauth_pubkeys =\r\n"]
