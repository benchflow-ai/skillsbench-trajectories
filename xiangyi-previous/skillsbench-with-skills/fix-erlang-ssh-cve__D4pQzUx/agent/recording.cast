[200.657541, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[200.657607, "o", "# Find and replace the original conn_msg handler\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.657703, "o", "# First, find line 759 where the original handler starts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.657765, "o", "original_start = 758  # 0-indexed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.657816, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.657896, "o", "# Find the end of the original handler (before the next handle_event)\r\n\u001b[?2004l\r"]
[200.657952, "o", "\u001b[?2004h> "]
[200.658006, "o", "original_end = original_start + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.658066, "o", "for i in range(original_start + 1, len(lines)):\r\n\u001b[?2004l\r"]
[200.658112, "o", "\u001b[?2004h> "]
[200.658173, "o", "    if lines[i].startswith('handle_event('):\r\n\u001b[?2004l\r"]
[200.658224, "o", "\u001b[?2004h> "]
[200.658276, "o", "        original_end = i\r\n\u001b[?2004l\r"]
[200.658326, "o", "\u001b[?2004h>         break\r\n\u001b[?2004l\r"]
[200.658375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.658441, "o", "# Remove the original handler and insert the new one\r\n\u001b[?2004l\r"]
[200.658486, "o", "\u001b[?2004h> "]
[200.65854, "o", "lines[original_start:original_end] = [fix]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.658589, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.65862, "o", "> "]
[200.658692, "o", "# Write the modified file\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.65874, "o", "> with open('ssh_connection_handler.erl', 'w') as f:\r\n\u001b[?2004l\r"]
[200.658788, "o", "\u001b[?2004h> "]
[200.65884, "o", "    f.writelines(lines)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[200.658888, "o", "\u001b[?2004h> "]
[200.659037, "o", "print(f\"Fix applied successfully - replaced lines {original_start+1} to {original_end}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
