[46.673112, "o", "\u001b[?2004hroot@3db5f8d7989f:~# "]
[85.012541, "i", "cat << 'EOF' > solve_mass.py\nimport struct\nimport json\nimport collections\nimport math\n\ndef read_stl(file_path):\n    triangles = []\n    with open(file_path, 'rb') as f:\n        header = f.read(80)\n        count_bytes = f.read(4)\n        if len(count_bytes) < 4: return []\n        count = struct.unpack('<I', count_bytes)[0]\n        \n        for i in range(count):\n            data = f.read(50)\n            if len(data) < 50: break\n            parts = struct.unpack('<3f3f3f3fH', data)\n            normal = parts[0:3]\n            v1 = parts[3:6]\n            v2 = parts[6:9]\n            v3 = parts[9:12]\n            attr = parts[12]\n            triangles.append(((v1, v2, v3), attr))\n    return triangles\n\ndef build_adjacency(triangles):\n    # Map edge (sorted vertex pair) to list of triangle indices\n    edge_to_tris = collections.defaultdict(list)\n    \n    for idx, (verts, _) in enumerate(triangles):\n        # 3 edges per triangle\n        edges = [\n            tuple(sorted((verts[0], verts[1]))),\n            tuple(sorted((verts[1], verts[2]))),\n            tuple(sorted((verts[2], verts[0])))\n        ]\n        for edge in edges:\n            edge_to_tris[edge].append(idx)\n            \n    # Build graph: tri_idx -> set of neighbor tri_indices\n    adjacency = collections.defaultdict(set)\n    for edge, tri_indices in edge_to_tris.items():\n        for i in range(len(tri_indices)):\n            for j in range(i + 1, len(tri_indices)):\n                t1, t2 = tri_indices[i], tri_indices[j]\n                adjacency[t1].add(t2)\n                adjacency[t2].add(t1)\n    return adjacency\n\ndef get_components(num_triangles, adjacency):\n    visited = set()\n    components = []\n    \n    for i in range(num_triangles):\n        if i not in visited:\n            component = []\n            stack = [i]\n            visited.add(i)\n            while stack:\n                curr = stack.pop()\n                component.append(curr)\n                for neighbor in adjacency[curr]:\n                    if neighbor not in visited:\n                        visited.add(neighbor)\n                        stack.append(neighbor)\n            components.append(component)\n    return components\n\ndef signed_volume_of_triangle(p1, p2, p3):\n    v321 = p3[0]*p2[1]*p1[2]\n    v231 = p2[0]*p3[1]*p1[2]\n    v312 = p3[0]*p1[1]*p2[2]\n    v132 = p1[0]*p3[1]*p2[2]\n    v213 = p2[0]*p1[1]*p3[2]\n    v123 = p1[0]*p2[1]*p3[2]\n    return (1.0/6.0)*(-v321 + v231 + v312 - v132 - v213 + v123)\n\ndef calculate_component_volume(component_indices, triangles):\n    total_vol = 0.0\n    for idx in component_indices:\n        verts, _ = triangles[idx]\n        total_vol += signed_volume_of_triangle(verts[0], verts[1], verts[2])\n    return abs(total_vol)\n\ndef get_majority_attr(component_indices, triangles):\n    counts = collections.Counter()\n    for idx in component_indices:\n        _, attr = triangles[idx]\n        counts[attr] += 1\n    return counts.most_common(1)[0][0]\n\ndef main():\n    triangles = read_stl('/root/scan_data.stl')\n    print(f\"Total triangles: {len(triangles)}\")\n    \n    adj = build_adjacency(triangles)\n    components = get_components(len(triangles), adj)\n    print(f\"Found {len(components)} components\")\n    \n    # Density table\n    # 1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34\n    # ID 0 is not in table.\n    densities = {\n        1: 0.10,\n        10: 7.85,\n        25: 2.70,\n        42: 5.55,\n        99: 11.34\n    }\n    \n    candidates = []\n    \n    for i, comp in enumerate(components):\n        vol_mm3 = calculate_component_volume(comp, triangles)\n        vol_cm3 = vol_mm3 / 1000.0\n        mat_id = get_majority_attr(comp, triangles)\n        \n        print(f\"Component {i}: Triangles={len(comp)}, Volume(mm3)={vol_mm3:.2f}, ID={mat_id}\")\n        \n        if mat_id in densities:\n            candidates.append({\n                'volume_cm3': vol_cm3,\n                'material_id': mat_id,\n                'density': densities[mat_id],\n                'tri_count': len(comp)\n            })\n    \n    if not candidates:\n        print(\"No valid components found matching density table.\")\n        return\n"]
[85.012609, "i", "\n    # Select the \"largest connected component\". \n    # Usually this means largest volume or largest triangle count. \n    # Let's sort by volume.\n    candidates.sort(key=lambda x: x['volume_cm3'], reverse=True)\n    best = candidates[0]\n    \n    mass = best['volume_cm3'] * best['density']\n    \n    result = {\n        \"main_part_mass\": round(mass, 2),\n        \"material_id\": best['material_id']\n    }\n    \n    print(f\"Selected Component: ID={best['material_id']}, Volume={best['volume_cm3']:.4f}, Mass={mass:.4f}\")\n    \n    with open('/root/mass_report.json', 'w') as f:\n        json.dump(result, f, indent=1)\n\nif __name__ == \"__main__\":\n    main()\nEOF\npython3 solve_mass.py\n"]
