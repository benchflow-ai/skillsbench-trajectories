[85.044841, "o", "Component 15: Triangles=4, Volume(mm3)=3.20, ID=0\r\nComponent 16: Triangles=4, Volume(mm3)=4.36, ID=0\r\nComponent 17: Triangles=4, Volume(mm3)=7.17, ID=0\r\nComponent 18: Triangles=4, Volume(mm3)=2.10, ID=0\r\nComponent 19: Triangles=4, Volume(mm3)=2.47, ID=0\r\nComponent 20: Triangles=4, Volume(mm3)=5.08, ID=0\r\nComponent 21: Triangles=4, Volume(mm3)=7.28, ID=0\r\nComponent 22: Triangles=4, Volume(mm3)=19.58, ID=0\r\n"]
[85.044912, "o", "Component 23: Triangles=4, Volume(mm3)=5.09, ID=0\r\nComponent 24: Triangles=4, Volume(mm3)=9.98, ID=0\r\nComponent 25: Triangles=4, Volume(mm3)=5.88, ID=0\r\nComponent 26: Triangles=4, Volume(mm3)=19.95, ID=0\r\nComponent 27: Triangles=4, Volume(mm3)=3.19, ID=0\r\nComponent 28: Triangles=4, Volume(mm3)=6.81, ID=0\r\n"]
[85.044957, "o", "Component 29: Triangles=4, Volume(mm3)=8.45, ID=0\r\nComponent 30: Triangles=4, Volume(mm3)=0.40, ID=0\r\nComponent 31: Triangles=4, Volume(mm3)=8.33, ID=0\r\nComponent 32: Triangles=4, Volume(mm3)=2.39, ID=0\r\nComponent 33: Triangles=4, Volume(mm3)=5.45, ID=0\r\nComponent 34: Triangles=4, Volume(mm3)=3.26, ID=0\r\nComponent 35: Triangles=4, Volume(mm3)=7.83, ID=0\r\nComponent 36: Triangles=4, Volume(mm3)=1.05, ID=0\r\nComponent 37: Triangles=4, Volume(mm3)=2.77, ID=0\r\n"]
