[85.01646, "o", "\u001b[?2004h> "]
[85.016499, "o", "    visited = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.016535, "o", "    components = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[85.016572, "o", "\u001b[?2004h> "]
[85.016612, "o", "    for i in range(num_triangles):\r\n\u001b[?2004l\r"]
[85.016652, "o", "\u001b[?2004h> "]
[85.016698, "o", "        if i not in visited:\r\n\u001b[?2004l\r"]
[85.016736, "o", "\u001b[?2004h> "]
[85.016774, "o", "            component = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.01683, "o", "            stack = [i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.016879, "o", "            visited.add(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.016921, "o", "            while stack:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.016989, "o", "                curr = stack.pop()\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.017034, "o", "> "]
[85.017076, "o", "                component.append(curr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017152, "o", "                for neighbor in adjacency[curr]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017233, "o", "                    if neighbor not in visited:\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.017279, "o", "> "]
[85.017316, "o", "                        visited.add(neighbor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.017361, "o", "> "]
[85.017401, "o", "                        stack.append(neighbor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.017447, "o", "> "]
[85.017493, "o", "            components.append(component)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017546, "o", "    return components\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.017601, "o", "\u001b[?2004h> "]
[85.01765, "o", "def signed_volume_of_triangle(p1, p2, p3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.0177, "o", "    v321 = p3[0]*p2[1]*p1[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017739, "o", "    v231 = p2[0]*p3[1]*p1[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017795, "o", "    v312 = p3[0]*p1[1]*p2[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017853, "o", "    v132 = p1[0]*p3[1]*p2[2]\r\n\u001b[?2004l\r"]
[85.017899, "o", "\u001b[?2004h> "]
[85.017943, "o", "    v213 = p2[0]*p1[1]*p3[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.017989, "o", "    v123 = p1[0]*p2[1]*p3[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018091, "o", "    return (1.0/6.0)*(-v321 + v231 + v312 - v132 - v213 + v123)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.018142, "o", "\u001b[?2004h> "]
[85.018211, "o", "def calculate_component_volume(component_indices, triangles):\r\n\u001b[?2004l\r"]
[85.018255, "o", "\u001b[?2004h>     total_vol = 0.0\r\n\u001b[?2004l\r"]
[85.018297, "o", "\u001b[?2004h> "]
[85.018341, "o", "    for idx in component_indices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018394, "o", "        verts, _ = triangles[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.018446, "o", "> "]
[85.018519, "o", "        total_vol += signed_volume_of_triangle(verts[0], verts[1], verts[2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.018564, "o", "> "]
[85.018612, "o", "    return abs(total_vol)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018691, "o", "def get_majority_attr(component_indices, triangles):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018755, "o", "    counts = collections.Counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018819, "o", "    for idx in component_indices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018884, "o", "        _, attr = triangles[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.018936, "o", "        counts[attr] += 1\r\n\u001b[?2004l\r"]
[85.018979, "o", "\u001b[?2004h> "]
[85.019016, "o", "    return counts.most_common(1)[0][0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[85.01904, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[85.019106, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.01915, "o", "    triangles = read_stl('/root/scan_data.stl')\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.019195, "o", "> "]
[85.019233, "o", "    print(f\"Total triangles: {len(triangles)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.01928, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019334, "o", "    adj = build_adjacency(triangles)\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.019378, "o", "> "]
[85.019425, "o", "    components = get_components(len(triangles), adj)\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.019467, "o", "> "]
[85.019511, "o", "    print(f\"Found {len(components)} components\")\r\n\u001b[?2004l\r"]
[85.019555, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019594, "o", "    # Density table\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019694, "o", "    # 1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019747, "o", "    # ID 0 is not in table.\r\n\u001b[?2004l\r"]
[85.019802, "o", "\u001b[?2004h> "]
[85.019851, "o", "    densities = {\r\n\u001b[?2004l\r\u001b[?2004h>         1: 0.10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019902, "o", "        10: 7.85,\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.019944, "o", ">         25: 2.70,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.019996, "o", "        42: 5.55,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.020047, "o", "        99: 11.34\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[85.020087, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.020112, "o", "    candidates = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.020156, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.020233, "o", "> "]
[85.020273, "o", "    for i, comp in enumerate(components):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.020374, "o", "        vol_mm3 = calculate_component_volume(comp, triangles)\r\n\u001b[?2004l\r"]
[85.020417, "o", "\u001b[?2004h> "]
[85.020464, "o", "        vol_cm3 = vol_mm3 / 1000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.02054, "o", "        mat_id = get_majority_attr(comp, triangles)\r\n\u001b[?2004l\r"]
[85.020585, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.020632, "o", "> "]
[85.020725, "o", "        print(f\"Component {i}: Triangles={len(comp)}, Volume(mm3)={vol_mm3:.2f}, ID={mat_id}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.020773, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.020815, "o", "        if mat_id in densities:\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.020864, "o", "> "]
[85.02091, "o", "            candidates.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.020959, "o", "                'volume_cm3': vol_cm3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021032, "o", "                'material_id': mat_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021119, "o", "                'density': densities[mat_id],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021186, "o", "                'tri_count': len(comp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021223, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021267, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021311, "o", "    if not candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021406, "o", "        print(\"No valid components found matching density table.\")\r\n\u001b[?2004l\r"]
[85.021448, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021552, "o", "    # Select the \"largest connected component\". \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.02168, "o", "    # Usually this means largest volume or largest triangle count. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021724, "o", "    # Let's sort by volume.\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.021769, "o", "> "]
[85.02184, "o", "    candidates.sort(key=lambda x: x['volume_cm3'], reverse=True)\r\n\u001b[?2004l\r"]
[85.021885, "o", "\u001b[?2004h>     best = candidates[0]\r\n\u001b[?2004l\r"]
[85.02193, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.021999, "o", "    mass = best['volume_cm3'] * best['density']\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.022043, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022087, "o", "    result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022146, "o", "        \"main_part_mass\": round(mass, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.02219, "o", "> "]
[85.022234, "o", "        \"material_id\": best['material_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022279, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022456, "o", "    print(f\"Selected Component: ID={best['material_id']}, Volume={best['volume_cm3']:.4f}, Mass={mass:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022503, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022571, "o", "    with open('/root/mass_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.022621, "o", "> "]
[85.022671, "o", "        json.dump(result, f, indent=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.022723, "o", "\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[85.022771, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.022821, "o", "EOF\r\n\u001b[?2004l\r"]
[85.02398, "o", "\u001b[?2004hroot@3db5f8d7989f:~# "]
[85.02405, "o", "python3 solve_mass.py\r\n\u001b[?2004l\r"]
