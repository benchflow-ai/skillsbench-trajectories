[?2004l[?2004h> def build_adjacency(triangles):
[?2004l[?2004h>     # Map edge (sorted vertex pair) to list of triangle indices
[?2004l[?2004h>     edge_to_tris = collections.defaultdict(list)
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, (verts, _) in enumerate(triangles):
[?2004l[?2004h>         # 3 edges per triangle
[?2004l[?2004h>         edges = [
[?2004l[?2004h>             tuple(sorted((verts[0], verts[1]))),
[?2004l[?2004h>             tuple(sorted((verts[1], verts[2]))),
[?2004l[?2004h>             tuple(sorted((verts[2], verts[0])))
[?2004l[?2004h>         ]
[?2004l[?2004h>         for edge in edges:
[?2004l[?2004h>             edge_to_tris[edge].append(idx)
[?2004l[?2004h>             
[?2004l[?2004h>     # Build graph: tri_idx -> set of neighbor tri_indices
[?2004l[?2004h>     adjacency = collections.defaultdict(set)
[?2004l[?2004h>     for edge, tri_indices in edge_to_tris.items():
[?2004l[?2004h>         for i in range(len(tri_indices)):
[?2004l[?2004h>             for j in range(i + 1, len(tri_indices)):
[?2004l[?2004h>                 t1, t2 = tri_indices[i], tri_indices[j]
[?2004l[?2004h>                 adjacency[t1].add(t2)
[?2004l[?2004h>                 adjacency[t2].add(t1)
[?2004l[?2004h>     return adjacency
[?2004l[?2004h> 
[?2004l[?2004h> def get_components(num_triangles, adjacency):
[?2004l[?2004h>     visited = set()
[?2004l[?2004h>     components = []
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(num_triangles):
[?2004l[?2004h>         if i not in visited:
[?2004l[?2004h>             component = []
[?2004l[?2004h>             stack = [i]
[?2004l[?2004h>             visited.add(i)
[?2004l[?2004h>             while stack:
[?2004l[?2004h>                 curr = stack.pop()
[?2004l[?2004h>                 component.append(curr)
[?2004l[?2004h>                 for neighbor in adjacency[curr]:
[?2004l[?2004h>                     if neighbor not in visited:
[?2004l[?2004h>                         visited.add(neighbor)
[?2004l[?2004h>                         stack.append(neighbor)
[?2004l[?2004h>             components.append(component)
[?2004l[?2004h>     return components
[?2004l[?2004h> 
[?2004l[?2004h> def signed_volume_of_triangle(p1, p2, p3):
[?2004l[?2004h>     v321 = p3[0]*p2[1]*p1[2]
[?2004l[?2004h>     v231 = p2[0]*p3[1]*p1[2]
[?2004l[?2004h>     v312 = p3[0]*p1[1]*p2[2]
[?2004l[?2004h>     v132 = p1[0]*p3[1]*p2[2]
[?2004l[?2004h>     v213 = p2[0]*p1[1]*p3[2]
[?2004l[?2004h>     v123 = p1[0]*p2[1]*p3[2]
[?2004l[?2004h>     return (1.0/6.0)*(-v321 + v231 + v312 - v132 - v213 + v123)
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_component_volume(component_indices, triangles):
[?2004l[?2004h>     total_vol = 0.0
[?2004l[?2004h>     for idx in component_indices:
[?2004l[?2004h>         verts, _ = triangles[idx]
[?2004l[?2004h>         total_vol += signed_volume_of_triangle(verts[0], verts[1], verts[2])
[?2004l[?2004h>     return abs(total_vol)
[?2004l[?2004h> 
[?2004l[?2004h> def get_majority_attr(component_indices, triangles):
[?2004l[?2004h>     counts = collections.Counter()
[?2004l[?2004h>     for idx in component_indices:
[?2004l[?2004h>         _, attr = triangles[idx]
[?2004l[?2004h>         counts[attr] += 1
[?2004l[?2004h>     return counts.most_common(1)[0][0]
