[?2004l[?2004h> t, f, ferr = t[mask2], f[mask2], ferr[mask2]
[?2004l[?2004h> 
[?2004l[?2004h> # Detrend using Savitzky-Golay filter
[?2004l[?2004h> if len(t) > 1:
[?2004l[?2004h>     dt = np.median(np.diff(t))
[?2004l[?2004h> else:
