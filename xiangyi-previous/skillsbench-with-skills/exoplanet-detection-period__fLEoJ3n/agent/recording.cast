[51.298823, "i", "python3 - <<'PY'\nimport numpy as np\nfrom astropy.timeseries import BoxLeastSquares\nfrom astropy.stats import sigma_clip\nfrom scipy.signal import savgol_filter\n\n# Load data\npath = '/root/data/tess_lc.txt'\ndata = np.loadtxt(path)\n\nt, f, flag, ferr = data.T\nmask = flag == 0\n\nt, f, ferr = t[mask], f[mask], ferr[mask]\n# sigma clip outliers\nclip = sigma_clip(f, sigma=5)\nmask2 = ~clip.mask\n\nt, f, ferr = t[mask2], f[mask2], ferr[mask2]\n\n# Detrend using Savitzky-Golay filter\nif len(t) > 1:\n    dt = np.median(np.diff(t))\nelse:\n    dt = 0.02\n\n# window length for ~1.5 day smoothing\nwindow = int(1.5 / dt)\nif window % 2 == 0:\n    window += 1\nif window < 5:\n    window = 5\n\ntrend = savgol_filter(f, window_length=window, polyorder=2)\ndetrended = f / trend\n\n# BLS period search around candidate\nbls = BoxLeastSquares(t, detrended, dy=ferr)\n# coarse check for half and double\nfor p in [0.699, 1.398, 2.796]:\n    periods = np.linspace(p*0.98, p*1.02, 5000)\n    durations = np.linspace(0.05, 0.3, 10)\n    power = bls.power(periods, dur"]
[51.298951, "i", "ations)\n    best = periods[np.argmax(power.power)]\n    print('Best near', p, '->', best)\n\n# fine grid around 1.398\np0 = 1.398\nperiods = np.linspace(p0-0.01, p0+0.01, 40001)  # step 5e-7\npower = bls.power(periods, np.linspace(0.05, 0.3, 10))\nbest_period = periods[np.argmax(power.power)]\nprint('Fine best period:', best_period)\nPY\n"]
