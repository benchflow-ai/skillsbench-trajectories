[5.475055, "o", "# column1: time (mjd)\r\n# column2: flux (relative)\r\n# column3: flag\r\n# column4: flux error\r\n2144.51963339 1.001605987549 0 0.000934709096\r\n"]
[5.475595, "o", "\u001b[?2004hroot@af02bb616b5b:~# "]
[30.996124, "i", "python3 - <<'PY'\nimport numpy as np\nfrom astropy.timeseries import BoxLeastSquares\nfrom astropy.stats import sigma_clip\nfrom scipy.signal import savgol_filter\n\n# Load data\npath = '/root/data/tess_lc.txt'\ndata = np.loadtxt(path)\n\nt, f, flag, ferr = data.T\nmask = flag == 0\n\nt, f, ferr = t[mask], f[mask], ferr[mask]\n# sigma clip outliers\nclip = sigma_clip(f, sigma=5)\nmask2 = ~clip.mask\n\nt, f, ferr = t[mask2], f[mask2], ferr[mask2]\n\n# Detrend using Savitzky-Golay filter\n# Estimate median cadence\nif len(t) > 1:\n    dt = np.median(np.diff(t))\nelse:\n    dt = 0.02\n\n# window length for ~1 day smoothing\nwindow = int(1.0 / dt)\nif window % 2 == 0:\n    window += 1\nif window < 5:\n    window = 5\n\ntrend = savgol_filter(f, window_length=window, polyorder=2)\ndetrended = f / trend\n\n# BLS period search\nbls = BoxLeastSquares(t, detrended, dy=ferr)\nperiods = np.linspace(0.5, 20.0, 20000)\ndurations = np.linspace(0.05, 0.3, 10)\n\npower = bls.power(periods, durations)\nbest_period = periods[np.argmax(power.power)]\nprint('Best period:',"]
[30.996178, "i", " best_period)\nPY\n"]
