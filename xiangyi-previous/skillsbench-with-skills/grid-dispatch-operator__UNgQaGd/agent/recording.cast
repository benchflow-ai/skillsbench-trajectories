[283.644247, "o", "root@704222683c58:~# "]
[305.058944, "i", "cat << 'EOF' > solution.py\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\nimport scipy.sparse as sp\n\ndef solve():\n    with open('network.json') as f:\n        data = json.load(f)\n    \n    baseMVA = data['baseMVA']\n    bus_data = np.array(data['bus'])\n    gen_data = np.array(data['gen'])\n    branch_data = np.array(data['branch'])\n    gencost_data = np.array(data['gencost'])\n    reserve_capacity = np.array(data['reserve_capacity'])\n    reserve_requirement = data['reserve_requirement']\n\n    num_buses = bus_data.shape[0]\n    num_gens = gen_data.shape[0]\n    num_branches = branch_data.shape[0]\n    bus_id_to_idx = {int(bus_data[i, 0]): i for i in range(num_buses)}\n\n    # Variables: [theta (rad), pg (pu), rg (pu)]\n    c = np.zeros(num_buses + 2 * num_gens)\n    for i in range(num_gens):\n        # Cost is c2*Pg^2 + c1*Pg + c0 where Pg is in MW\n        # So in terms of pg (pu), it's c2*(pg*baseMVA)^2 + c1*(pg*baseMVA) + c0\n        # Linear part coefficient is c1 * baseMVA\n        c[num_buses + i] = gencost_data[i, 5] * baseMVA\n\n    bounds = []\n    for i in range(num_buses):\n        if i == 0: bounds.append((0, 0))\n        else: bounds.append((-np.pi, np.pi))\n    \n    for i in range(num_gens):\n        bounds.append((gen_data[i, 9] / baseMVA, gen_data[i, 8] / baseMVA))\n        \n    for i in range(num_gens):\n        bounds.append((0, reserve_capacity[i] / baseMVA))\n\n    # B matrix\n    rows, cols, vals = [], [], []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        b = 1.0 / x\n        rows.extend([f_idx, t_idx, f_idx, t_idx])\n        cols.extend([f_idx, t_idx, t_idx, f_idx])\n        vals.extend([b, b, -b, -b])\n    B = sp.csr_matrix((vals, (rows, cols)), shape=(num_buses, num_buses))\n\n    # Equality constraints: B * theta - pg_at_bus = -pload_at_bus\n    rows_g, cols_g, vals_g = [], [], []\n    for k in range(num_gens):\n        bus_idx = bus_id_to_idx[int(gen_data[k, 0])]\n        rows_g.append(bus_idx)\n        cols_g.append(k)\n        vals_g.append(-1.0)\n    A_eq_gen = sp.csr_matrix((vals_g, (rows_g, cols_g)), shape=(num_buses, num_gens))\n    A_eq = sp.hstack([B, A_eq_gen, sp.csr_matrix((num_buses, num_gens))])\n    b_eq = -bus_data[:, 2] / baseMVA\n\n    # Inequality constraints\n    A_ub_list = []\n    b_ub_list = []\n    \n    # Transmission limits\n    for i in range(num_branches):\n        limit = branch_data[i, 5]\n        if limit == 0 or limit >= 9999: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        \n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, f_idx] = 1.0 / x\n        row[0, t_idx] = -1.0 / x\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(limit / baseMVA)\n        \n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, f_idx] = -1.0 / x\n        row[0, t_idx] = 1.0 / x\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(limit / baseMVA)\n\n    # Reserve requirement\n    row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n    for i in range(num_gens):\n        row[0, num_buses + num_gens + i] = -1.0\n    A_ub_list.append(row.tocsr())\n    b_ub_list.append(-reserve_requirement / baseMVA)\n\n    # Capacity coupling: pg + rg <= pmax\n    for i in range(num_gens):\n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, num_buses + i] = 1.0\n        row[0, num_buses + num_gens + i] = 1.0\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(gen_data[i, 8] / baseMVA)\n\n    A_ub = sp.vstack(A_ub_list)\n    b_ub = np.array(b_ub_list)\n\n    print(\"Starting solver...\")\n    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\n\n    if not res.success:\n        print(\"Optimization failed:\", res.message)\n        return\n\n    theta = res.x[:num_buses]\n    pg = res.x[num_buses:num_"]
[305.059084, "i", "buses+num_gens] * baseMVA\n    rg = res.x[num_buses+num_gens:] * baseMVA\n\n    # Generator dispatch report\n    generator_dispatch = []\n    for i in range(num_gens):\n        generator_dispatch.append({\n            \"id\": i + 1,\n            \"bus\": int(gen_data[i, 0]),\n            \"output_MW\": float(round(pg[i], 2)),\n            \"reserve_MW\": float(round(rg[i], 2)),\n            \"pmax_MW\": float(gen_data[i, 8])\n        })\n\n    total_cost = 0\n    for i in range(num_gens):\n        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\n\n    totals = {\n        \"cost_dollars_per_hour\": float(round(total_cost, 2)),\n        \"load_MW\": float(round(np.sum(bus_data[:, 2]), 2)),\n        \"generation_MW\": float(round(np.sum(pg), 2)),\n        \"reserve_MW\": float(round(np.sum(rg), 2))\n    }\n\n    most_loaded_lines = []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\n        limit = branch_data[i, 5]\n        if limit > 0:\n            loading_pct = (flow / limit * 100.0)\n            most_loaded_lines.append({\"from\": int(branch_data[i, 0]), \"to\": int(branch_data[i, 1]), \"loading_pct\": float(round(loading_pct, 2))})\n\n    most_loaded_lines.sort(key=lambda x: x['loading_pct'], reverse=True)\n    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\n\n    report = {\n        \"generator_dispatch\": generator_dispatch,\n        \"totals\": totals,\n        \"most_loaded_lines\": most_loaded_lines[:3],\n        \"operating_margin_MW\": float(round(operating_margin, 2))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Report generated successfully\")\n\nsolve()\nEOF\npython3 solution.py\n"]
