[244.714057, "o", "\u001b[?2004h> import json\r\n"]
[244.714278, "o", "\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import linprog\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.714362, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[244.714404, "o", "def solve():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.714498, "o", "    with open('network.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.714578, "o", "        data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.714658, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.714733, "o", "    baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.714767, "o", "> "]
[244.714891, "o", "    bus_data = np.array(data['bus'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.714986, "o", "> "]
[244.715054, "o", "    gen_data = np.array(data['gen'])\r\n\u001b[?2004l\r"]
[244.715118, "o", "\u001b[?2004h> "]
