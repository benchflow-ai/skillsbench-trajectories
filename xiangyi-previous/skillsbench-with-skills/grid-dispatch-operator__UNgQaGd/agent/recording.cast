[305.069211, "o", "\u001b[?2004h> "]
[305.069273, "o", "        A_ub_list.append(row.tocsr())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.069366, "o", "        b_ub_list.append(gen_data[i, 8] / baseMVA)\r\n\u001b[?2004l\r"]
[305.069409, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.069462, "o", "    A_ub = sp.vstack(A_ub_list)\r\n\u001b[?2004l\r"]
[305.069499, "o", "\u001b[?2004h> "]
[305.069561, "o", "    b_ub = np.array(b_ub_list)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.069611, "o", "> "]
[305.069656, "o", "    print(\"Starting solver...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.069795, "o", "    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\r\n\u001b[?2004l\r"]
[305.069851, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.0699, "o", "    if not res.success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.069963, "o", "        print(\"Optimization failed:\", res.message)\r\n\u001b[?2004l\r"]
[305.070017, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.07006, "o", "\u001b[?2004h> "]
[305.070117, "o", "    theta = res.x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.070191, "o", "    pg = res.x[num_buses:num_buses+num_gens] * baseMVA\r\n\u001b[?2004l\r"]
[305.070236, "o", "\u001b[?2004h> "]
[305.0703, "o", "    rg = res.x[num_buses+num_gens:] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.07035, "o", "\u001b[?2004h> "]
[305.070399, "o", "    # Generator dispatch report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.070452, "o", "    generator_dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.070509, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.070578, "o", "        generator_dispatch.append({\r\n\u001b[?2004l\r"]
[305.070632, "o", "\u001b[?2004h>             \"id\": i + 1,\r\n\u001b[?2004l\r"]
[305.070675, "o", "\u001b[?2004h> "]
[305.07073, "o", "            \"bus\": int(gen_data[i, 0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.070809, "o", "            \"output_MW\": float(round(pg[i], 2)),\r\n\u001b[?2004l\r"]
[305.070854, "o", "\u001b[?2004h> "]
[305.070912, "o", "            \"reserve_MW\": float(round(rg[i], 2)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.070956, "o", "> "]
[305.07103, "o", "            \"pmax_MW\": float(gen_data[i, 8])\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[305.07109, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     total_cost = 0\r\n\u001b[?2004l\r"]
[305.071129, "o", "\u001b[?2004h> "]
[305.071172, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.071325, "o", "        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\r\n\u001b[?2004l\r"]
[305.071388, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     totals = {\r\n\u001b[?2004l\r"]
[305.071431, "o", "\u001b[?2004h> "]
[305.071496, "o", "        \"cost_dollars_per_hour\": float(round(total_cost, 2)),\r\n\u001b[?2004l\r"]
[305.071539, "o", "\u001b[?2004h> "]
[305.071606, "o", "        \"load_MW\": float(round(np.sum(bus_data[:, 2]), 2)),\r\n\u001b[?2004l\r"]
[305.071649, "o", "\u001b[?2004h> "]
[305.071705, "o", "        \"generation_MW\": float(round(np.sum(pg), 2)),\r\n\u001b[?2004l\r"]
[305.071749, "o", "\u001b[?2004h> "]
[305.071814, "o", "        \"reserve_MW\": float(round(np.sum(rg), 2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.071876, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.071917, "o", "    most_loaded_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.07197, "o", "    for i in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.072012, "o", "> "]
[305.072057, "o", "        if branch_data[i, 10] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.072153, "o", "        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.072196, "o", "> "]
[305.072247, "o", "        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\r\n\u001b[?2004l\r"]
[305.072289, "o", "\u001b[?2004h> "]
[305.07233, "o", "        x = branch_data[i, 3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.072371, "o", "        if x <= 0: x = 0.0001\r\n\u001b[?2004l\r"]
[305.072414, "o", "\u001b[?2004h> "]
[305.072485, "o", "        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.072529, "o", "> "]
[305.072576, "o", "        limit = branch_data[i, 5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.072636, "o", "        if limit > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.072704, "o", "            loading_pct = (flow / limit * 100.0)\r\n\u001b[?2004l\r"]
[305.072748, "o", "\u001b[?2004h> "]
[305.072941, "o", "            most_loaded_lines.append({\"from\": int(branch_data[i, 0]), \"to\": int(branch_data[i, 1]), \"loading_pct\": float(round(loading_pct, 2))})\r\n\u001b[?2004l\r"]
[305.072984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.073075, "o", "    most_loaded_lines.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r"]
[305.073119, "o", "\u001b[?2004h> "]
[305.073187, "o", "    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\r\n\u001b[?2004l\r"]
[305.073245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     report = {\r\n\u001b[?2004l\r"]
[305.073302, "o", "\u001b[?2004h> "]
[305.073347, "o", "        \"generator_dispatch\": generator_dispatch,\r\n\u001b[?2004l\r"]
[305.073395, "o", "\u001b[?2004h> "]
[305.073439, "o", "        \"totals\": totals,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.073503, "o", "        \"most_loaded_lines\": most_loaded_lines[:3],\r\n\u001b[?2004l\r"]
[305.073546, "o", "\u001b[?2004h> "]
[305.07362, "o", "        \"operating_margin_MW\": float(round(operating_margin, 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.073688, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.073751, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[305.073799, "o", "\u001b[?2004h> "]
[305.073847, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.073917, "o", "    print(\"Report generated successfully\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.073964, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> solve()\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.074013, "o", "> EOF\r\n\u001b[?2004l\r"]
[305.075339, "o", "\u001b[?2004hroot@704222683c58:~# "]
[305.075396, "o", "python3 solution.py\r\n\u001b[?2004l\r"]
[306.576313, "o", "Starting solver...\r\n"]
[307.233339, "o", "Report generated successfully\r\n"]
[307.293442, "o", "\u001b[?2004hroot@704222683c58:~# "]
[337.239102, "i", "cat report.json\n"]
[337.239305, "o", "cat report.json\r\n\u001b[?2004l\r"]
