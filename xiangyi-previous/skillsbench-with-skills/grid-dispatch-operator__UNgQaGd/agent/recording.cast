[190.723059, "o", "\u001b[?2004h> "]
[190.723112, "o", "        row[t_idx] = -1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723161, "o", "        A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723214, "o", "        b_ub.append(limit / baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723262, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723325, "o", "        row = np.zeros(num_buses + 2 * num_gens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.723376, "o", ">         row[f_idx] = -1.0 / x\r\n\u001b[?2004l\r"]
[190.723424, "o", "\u001b[?2004h> "]
[190.723479, "o", "        row[t_idx] = 1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723537, "o", "        A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723595, "o", "        b_ub.append(limit / baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723697, "o", "    # 3. Spinning reserve requirement: sum(R_i) >= R_req\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.723755, "o", "> "]
[190.723807, "o", "    row = np.zeros(num_buses + 2 * num_gens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723862, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.723923, "o", "        row[num_buses + num_gens + i] = -1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.723971, "o", ">     A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.724021, "o", "> "]
[190.724083, "o", "    b_ub.append(-reserve_requirement / baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.724134, "o", "\u001b[?2004h> "]
[190.724184, "o", "    # 4. Capacity coupling: P_gen_i + R_i <= P_max_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.724242, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.724326, "o", "        row = np.zeros(num_buses + 2 * num_gens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.72438, "o", ">         row[num_buses + i] = 1.0\r\n\u001b[?2004l\r"]
[190.724434, "o", "\u001b[?2004h> "]
[190.724492, "o", "        row[num_buses + num_gens + i] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.72455, "o", "        A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.724618, "o", "        b_ub.append(gen_data[i, 8] / baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.724677, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     # Solve\r\n\u001b[?2004l\r"]
[190.724734, "o", "\u001b[?2004h> "]
[190.724861, "o", "    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.724914, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.724969, "o", "    if not res.success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.725029, "o", "        print(\"Optimization failed:\", res.message)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.725081, "o", ">         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.725133, "o", "\u001b[?2004h> "]
[190.725183, "o", "    theta = res.x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.725266, "o", "    pg = res.x[num_buses:num_buses+num_gens] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.725327, "o", "> "]
[190.725381, "o", "    rg = res.x[num_buses+num_gens:] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[190.725439, "o", ">     # Report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.725497, "o", "    generator_dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.725554, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.72561, "o", "        generator_dispatch.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.725662, "o", ">             \"id\": i + 1,\r\n\u001b[?2004l\r"]
[190.72571, "o", "\u001b[?2004h> "]
[190.725764, "o", "            \"bus\": int(gen_data[i, 0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.725837, "o", "            \"output_MW\": float(round(pg[i], 2)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.725888, "o", "> "]
[190.725938, "o", "            \"reserve_MW\": float(round(rg[i], 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726014, "o", "            \"pmax_MW\": float(gen_data[i, 8])\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.726063, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.726111, "o", "\u001b[?2004h>     total_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.72616, "o", "> "]
[190.726208, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726258, "o", "        # c2*Pg^2 + c1*Pg + c0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726428, "o", "        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.726496, "o", "\u001b[?2004h>     totals = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726599, "o", "        \"cost_dollars_per_hour\": float(round(total_cost, 2)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.726657, "o", "> "]
[190.726708, "o", "        \"load_MW\": float(round(np.sum(bus_data[:, 2]), 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726821, "o", "        \"generation_MW\": float(round(np.sum(pg), 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.726899, "o", "        \"reserve_MW\": float(round(np.sum(rg), 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.726949, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[190.726998, "o", ">     most_loaded_lines = []\r\n\u001b[?2004l\r"]
[190.727046, "o", "\u001b[?2004h> "]
[190.727103, "o", "    for i in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.727159, "o", "        if branch_data[i, 10] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.727208, "o", "> "]
[190.727261, "o", "        f_bus = int(branch_data[i, 0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.727313, "o", "        t_bus = int(branch_data[i, 1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.727385, "o", "        f_idx = bus_id_to_idx[f_bus]\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.727446, "o", ">         t_idx = bus_id_to_idx[t_bus]\r\n\u001b[?2004l\r"]
[190.727501, "o", "\u001b[?2004h>         x = branch_data[i, 3]\r\n\u001b[?2004l\r"]
[190.727559, "o", "\u001b[?2004h> "]
[190.72761, "o", "        if x == 0: x = 0.0001\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.727696, "o", "        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.727766, "o", "        limit = branch_data[i, 5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.727815, "o", "> "]
[190.727882, "o", "        loading_pct = (flow / limit * 100.0) if limit > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.72793, "o", "> "]
[190.728069, "o", "        most_loaded_lines.append({\"from\": f_bus, \"to\": t_bus, \"loading_pct\": float(round(loading_pct, 2))})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.728119, "o", "\u001b[?2004h> "]
[190.728204, "o", "    most_loaded_lines.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.728266, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.728333, "o", "    # Operating margin: sum(Pmax_i) - sum(Pg_i + Rg_i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.728451, "o", "    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.728505, "o", "\u001b[?2004h>     report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.728559, "o", "> "]
[190.728608, "o", "        \"generator_dispatch\": generator_dispatch,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.728658, "o", "        \"totals\": totals,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.728749, "o", "        \"most_loaded_lines\": most_loaded_lines[:3],\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.728798, "o", "> "]
[190.728861, "o", "        \"operating_margin_MW\": float(round(operating_margin, 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.728909, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[190.728959, "o", "> "]
[190.729009, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.729068, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.729116, "o", "> "]
[190.729174, "o", "    print(\"Report generated successfully\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.729227, "o", "solve()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[190.730399, "o", "\u001b[?2004hroot@704222683c58:~# python3 solution.py\r\n\u001b[?2004l\r"]
[193.614742, "o", "Optimization failed: The problem is infeasible. (HiGHS Status 8: model_status is Infeasible; primal_status is At lower/fixed bound)\r\n"]
[193.755621, "o", "\u001b[?2004hroot@704222683c58:~# "]
[225.144793, "i", "cat << 'EOF' > diagnostics.py\nimport json\nimport numpy as np\n\ndef diagnose():\n    with open('network.json') as f:\n        data = json.load(f)\n    \n    bus_data = np.array(data['bus'])\n    gen_data = np.array(data['gen'])\n    reserve_requirement = data['reserve_requirement']\n    \n    total_load = np.sum(bus_data[:, 2])\n    total_pmax = np.sum(gen_data[:, 8])\n    total_pmin = np.sum(gen_data[:, 9])\n    \n    print(f\"Total Load: {total_load} MW\")\n    print(f\"Total Pmax: {total_pmax} MW\")\n    print(f\"Total Pmin: {total_pmin} MW\")\n    print(f\"Reserve Requirement: {reserve_requirement} MW\")\n    print(f\"Total Pmax - (Total Load + Reserve): {total_pmax - (total_load + reserve_requirement)} MW\")\n\ndiagnose()\nEOF\npython3 diagnostics.py\n"]
[225.144984, "o", "cat << 'EOF' > diagnostics.py\r\n\u001b[?2004l\r"]
[225.145058, "o", "\u001b[?2004h> "]
[225.145135, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.145194, "o", "\u001b[?2004h> def diagnose():\r\n\u001b[?2004l\r"]
[225.145264, "o", "\u001b[?2004h> "]
[225.145338, "o", "    with open('network.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.1454, "o", "        data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.145461, "o", "    bus_data = np.array(data['bus'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.145511, "o", "> "]
[225.145558, "o", "    gen_data = np.array(data['gen'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.145638, "o", "> "]
[225.145725, "o", "    reserve_requirement = data['reserve_requirement']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.145784, "o", "    total_load = np.sum(bus_data[:, 2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.145827, "o", "> "]
[225.145868, "o", "    total_pmax = np.sum(gen_data[:, 8])\r\n\u001b[?2004l\r"]
[225.145925, "o", "\u001b[?2004h> "]
[225.145967, "o", "    total_pmin = np.sum(gen_data[:, 9])\r\n\u001b[?2004l\r"]
[225.146021, "o", "\u001b[?2004h> "]
[225.14606, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.146114, "o", "    print(f\"Total Load: {total_load} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.146169, "o", "> "]
[225.146212, "o", "    print(f\"Total Pmax: {total_pmax} MW\")\r\n\u001b[?2004l\r"]
[225.146261, "o", "\u001b[?2004h> "]
[225.146354, "o", "    print(f\"Total Pmin: {total_pmin} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.146417, "o", "    print(f\"Reserve Requirement: {reserve_requirement} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.146611, "o", "    print(f\"Total Pmax - (Total Load + Reserve): {total_pmax - (total_load + reserve_requirement)} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.146676, "o", "\u001b[?2004h> diagnose()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[225.147965, "o", "\u001b[?2004hroot@704222683c58:~# "]
[225.148022, "o", "python3 diagnostics.py\r\n\u001b[?2004l\r"]
[225.253868, "o", "Total Load: 144839.06 MW\r\nTotal Pmax: 219088.0 MW\r\nTotal Pmin: 8981.15 MW\r\nReserve Requirement: 5923.5 MW\r\nTotal Pmax - (Total Load + Reserve): 68325.44 MW\r\n"]
[225.270932, "o", "\u001b[?2004hroot@704222683c58:~# "]
[244.713437, "i", "cat << 'EOF' > solution.py\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\n\ndef solve():\n    with open('network.json') as f:\n        data = json.load(f)\n    \n    baseMVA = data['baseMVA']\n    bus_data = np.array(data['bus'])\n    gen_data = np.array(data['gen'])\n    branch_data = np.array(data['branch'])\n    gencost_data = np.array(data['gencost'])\n    reserve_capacity = np.array(data['reserve_capacity'])\n    reserve_requirement = data['reserve_requirement']\n\n    num_buses = bus_data.shape[0]\n    num_gens = gen_data.shape[0]\n    num_branches = branch_data.shape[0]\n\n    bus_id_to_idx = {int(bus_data[i, 0]): i for i in range(num_buses)}\n\n    # Variables: [theta_0...theta_{n-1}, P_g0...P_{g-1}, R_0...R_{g-1}]\n    # To handle potential disconnected components, we can add a small epsilon to the diagonal of B or solve per component. \n    # But first, let's try to fix the slack bus properly.\n    \n    c = np.zeros(num_buses + 2 * num_gens)\n    for i in range(num_gens):\n        c[num_buses + i] = gencost_data[i, 5]\n\n    bounds = []\n    for i in range(num_buses):\n        if i == 0: bounds.append((0, 0))\n        else: bounds.append((-np.pi, np.pi)) # Limit angles to avoid large values\n    \n    for i in range(num_gens):\n        bounds.append((gen_data[i, 9], gen_data[i, 8]))\n        \n    for i in range(num_gens):\n        bounds.append((0, reserve_capacity[i]))\n\n    # Constraints\n    import scipy.sparse as sp\n    \n    # Using sparse matrices to save memory and potentially improve performance\n    rows = []\n    cols = []\n    vals = []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        b = 1.0 / x\n        rows.extend([f_idx, t_idx, f_idx, t_idx])\n        cols.extend([f_idx, t_idx, t_idx, f_idx])\n        vals.extend([b, b, -b, -b])\n\n    B = sp.csr_matrix((vals, (rows, cols)), shape=(num_buses, num_buses))\n\n    A_eq_parts = []\n    # B * theta part\n    A_eq_theta = B\n    # -P_gen part\n    rows_g = []\n    cols_g = []\n    vals_g = []\n    for k in range(num_gens):\n        bus_idx = bus_id_to_idx[int(gen_data[k, 0])]\n        rows_g.append(bus_idx)\n        cols_g.append(k)\n        vals_g.append(-1.0)\n    A_eq_gen = sp.csr_matrix((vals_g, (rows_g, cols_g)), shape=(num_buses, num_gens))\n    \n    # Combine parts for A_eq\n    A_eq = sp.hstack([A_eq_theta, A_eq_gen, sp.csr_matrix((num_buses, num_gens))])\n    b_eq = -bus_data[:, 2] / baseMVA\n\n    # Transmission limits\n    A_ub_list = []\n    b_ub_list = []\n    \n    for i in range(num_branches):\n        limit = branch_data[i, 5]\n        if limit == 0 or limit >= 9999: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        \n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, f_idx] = 1.0 / x\n        row[0, t_idx] = -1.0 / x\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(limit / baseMVA)\n        \n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, f_idx] = -1.0 / x\n        row[0, t_idx] = 1.0 / x\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(limit / baseMVA)\n\n    # Reserve requirement\n    row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n    for i in range(num_gens):\n        row[0, num_buses + num_gens + i] = -1.0\n    A_ub_list.append(row.tocsr())\n    b_ub_list.append(-reserve_requirement / baseMVA)\n\n    # Capacity coupling\n    for i in range(num_gens):\n        row = sp.dok_matrix((1, num_buses + 2 * num_gens))\n        row[0, num_buses + i] = 1.0\n        row[0, num_buses + num_gens + i] = 1.0\n        A_ub_list.append(row.tocsr())\n        b_ub_list.append(gen_data[i, 8] / baseMVA)\n\n    A_ub = sp.vstack(A_ub_list)\n    b_ub = np.array(b_ub_list)\n\n    # Scaling: linprog can be sensitive to scaling. Let's keep things in MW for P and R, and adjust B matrix\n    # Actually, let's just stay "]
[244.713758, "i", "in per-unit for the solver and convert back later.\n    \n    print(\"Starting solver...\")\n    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\n\n    if not res.success:\n        print(\"Optimization failed:\", res.message)\n        # If it failed, let's try without transmission limits to see if it's a congestion issue\n        print(\"Retrying without transmission limits...\")\n        res = linprog(c, A_ub=A_ub[-(num_gens+1):], b_ub=b_ub[-(num_gens+1):], A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\n        if not res.success:\n            print(\"Still failed:\", res.message)\n            return\n\n    theta = res.x[:num_buses]\n    pg = res.x[num_buses:num_buses+num_gens] * baseMVA\n    rg = res.x[num_buses+num_gens:] * baseMVA\n\n    generator_dispatch = []\n    for i in range(num_gens):\n        generator_dispatch.append({\n            \"id\": i + 1,\n            \"bus\": int(gen_data[i, 0]),\n            \"output_MW\": float(round(pg[i], 2)),\n            \"reserve_MW\": float(round(rg[i], 2)),\n            \"pmax_MW\": float(gen_data[i, 8])\n        })\n\n    total_cost = 0\n    for i in range(num_gens):\n        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\n\n    totals = {\n        \"cost_dollars_per_hour\": float(round(total_cost, 2)),\n        \"load_MW\": float(round(np.sum(bus_data[:, 2]), 2)),\n        \"generation_MW\": float(round(np.sum(pg), 2)),\n        \"reserve_MW\": float(round(np.sum(rg), 2))\n    }\n\n    most_loaded_lines = []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\n        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\n        x = branch_data[i, 3]\n        if x <= 0: x = 0.0001\n        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\n        limit = branch_data[i, 5]\n        loading_pct = (flow / limit * 100.0) if limit > 0 else 0.0\n        most_loaded_lines.append({\"from\": int(branch_data[i, 0]), \"to\": int(branch_data[i, 1]), \"loading_pct\": float(round(loading_pct, 2))})\n\n    most_loaded_lines.sort(key=lambda x: x['loading_pct'], reverse=True)\n    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\n\n    report = {\n        \"generator_dispatch\": generator_dispatch,\n        \"totals\": totals,\n        \"most_loaded_lines\": most_loaded_lines[:3],\n        \"operating_margin_MW\": float(round(operating_margin, 2))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Report generated successfully\")\n\nsolve()\nEOF\npython3 solution.py\n"]
