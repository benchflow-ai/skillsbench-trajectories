[244.726694, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.726757, "o", "    A_ub = sp.vstack(A_ub_list)\r\n\u001b[?2004l\r\u001b[?2004h>     b_ub = np.array(b_ub_list)\r\n\u001b[?2004l\r"]
[244.726822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.726969, "o", "    # Scaling: linprog can be sensitive to scaling. Let's keep things in MW for P and R, and adjust B matrix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727095, "o", "    # Actually, let's just stay in per-unit for the solver and convert back later.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727183, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727242, "o", "    print(\"Starting solver...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727337, "o", "    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.727379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727422, "o", "    if not res.success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727539, "o", "        print(\"Optimization failed:\", res.message)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727674, "o", "        # If it failed, let's try without transmission limits to see if it's a congestion issue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.72777, "o", "        print(\"Retrying without transmission limits...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.727999, "o", "        res = linprog(c, A_ub=A_ub[-(num_gens+1):], b_ub=b_ub[-(num_gens+1):], A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728038, "o", "        if not res.success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728163, "o", "            print(\"Still failed:\", res.message)\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r"]
[244.728236, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728307, "o", "    theta = res.x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728368, "o", "    pg = res.x[num_buses:num_buses+num_gens] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728456, "o", "    rg = res.x[num_buses+num_gens:] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.728521, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     generator_dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728598, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728662, "o", "        generator_dispatch.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728726, "o", "            \"id\": i + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.728793, "o", "            \"bus\": int(gen_data[i, 0]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.728857, "o", "> "]
[244.728934, "o", "            \"output_MW\": float(round(pg[i], 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729022, "o", "            \"reserve_MW\": float(round(rg[i], 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729082, "o", "            \"pmax_MW\": float(gen_data[i, 8])\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[244.729151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     total_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.729213, "o", ">     for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729402, "o", "        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.729477, "o", "\u001b[?2004h> "]
[244.729557, "o", "    totals = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729616, "o", "        \"cost_dollars_per_hour\": float(round(total_cost, 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729673, "o", "        \"load_MW\": float(round(np.sum(bus_data[:, 2]), 2)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.729737, "o", "> "]
[244.729833, "o", "        \"generation_MW\": float(round(np.sum(pg), 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.729935, "o", "        \"reserve_MW\": float(round(np.sum(rg), 2))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730009, "o", "    most_loaded_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730077, "o", "    for i in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.73014, "o", "        if branch_data[i, 10] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730217, "o", "        f_idx = bus_id_to_idx[int(branch_data[i, 0])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.730253, "o", "> "]
[244.730362, "o", "        t_idx = bus_id_to_idx[int(branch_data[i, 1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730429, "o", "        x = branch_data[i, 3]\r\n\u001b[?2004l\r\u001b[?2004h>         if x <= 0: x = 0.0001\r\n\u001b[?2004l\r"]
[244.730493, "o", "\u001b[?2004h> "]
[244.730562, "o", "        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[244.730595, "o", "> "]
[244.730699, "o", "        limit = branch_data[i, 5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730786, "o", "        loading_pct = (flow / limit * 100.0) if limit > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.730979, "o", "        most_loaded_lines.append({\"from\": int(branch_data[i, 0]), \"to\": int(branch_data[i, 1]), \"loading_pct\": float(round(loading_pct, 2))})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.731017, "o", "\u001b[?2004h> "]
[244.731121, "o", "    most_loaded_lines.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.731226, "o", "    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.731259, "o", "\u001b[?2004h> "]
[244.731367, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.73143, "o", "        \"generator_dispatch\": generator_dispatch,\r\n\u001b[?2004l\r\u001b[?2004h>         \"totals\": totals,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.731533, "o", "        \"most_loaded_lines\": most_loaded_lines[:3],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.73164, "o", "        \"operating_margin_MW\": float(round(operating_margin, 2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.731716, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[244.731772, "o", "\u001b[?2004h>     with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.731822, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r"]
[244.731877, "o", "\u001b[?2004h> "]
[244.731939, "o", "    print(\"Report generated successfully\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.731995, "o", "solve()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[244.733294, "o", "\u001b[?2004hroot@704222683c58:~# "]
[244.733949, "o", "python3 solution.py\r\n\u001b[?2004l\r"]
[246.237053, "o", "Starting solver...\r\n"]
[246.401366, "o", "Optimization failed: The problem is infeasible. (HiGHS Status 8: model_status is Infeasible; primal_status is At lower/fixed bound)\r\nRetrying without transmission limits...\r\n"]
[246.40986, "o", "Still failed: The problem is infeasible. (HiGHS Status 8: model_status is Infeasible; primal_status is At lower/fixed bound)\r\n"]
[246.461285, "o", "\u001b[?2004hroot@704222683c58:~# "]
[283.444126, "i", "cat << 'EOF' > diagnostics_2.py\nimport json\nimport numpy as np\nimport scipy.sparse as sp\n\ndef diagnose():\n    with open('network.json') as f:\n        data = json.load(f)\n    \n    bus_data = np.array(data['bus'])\n    gen_data = np.array(data['gen'])\n    branch_data = np.array(data['branch'])\n    num_buses = len(bus_data)\n    bus_id_to_idx = {int(bus_data[i, 0]): i for i in range(num_buses)}\n\n    # Check connectivity\n    adj = [[] for _ in range(num_buses)]\n    for i in range(len(branch_data)):\n        if branch_data[i, 10] == 0: continue\n        u = bus_id_to_idx[int(branch_data[i, 0])]\n        v = bus_id_to_idx[int(branch_data[i, 1])]\n        adj[u].append(v)\n        adj[v].append(u)\n\n    visited = [False] * num_buses\n    components = []\n    for i in range(num_buses):\n        if not visited[i]:\n            comp = []\n            q = [i]\n            visited[i] = True\n            while q:\n                u = q.pop(0)\n                comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]:\n                        visited[v] = True\n                        q.append(v)\n            components.append(comp)\n    \n    print(f\"Number of components: {len(components)}\")\n    for idx, comp in enumerate(components):\n        comp_load = np.sum(bus_data[comp, 2])\n        comp_gens = [g for g in range(len(gen_data)) if bus_id_to_idx[int(gen_data[g, 0])] in comp]\n        comp_pmax = np.sum(gen_data[comp_gens, 8])\n        comp_pmin = np.sum(gen_data[comp_gens, 9])\n        if comp_load > comp_pmax:\n            print(f\"Component {idx} is deficit: Load={comp_load}, Pmax={comp_pmax}\")\n        if comp_load < comp_pmin:\n            print(f\"Component {idx} is surplus: Load={comp_load}, Pmin={comp_pmin}\")\n\ndiagnose()\nEOF\npython3 diagnostics_2.py\n"]
[283.444389, "o", "cat << 'EOF' > diagnostics_2.py\r\n\u001b[?2004l\r"]
