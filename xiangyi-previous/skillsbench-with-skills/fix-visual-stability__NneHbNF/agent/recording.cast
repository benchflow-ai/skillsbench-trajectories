g ? (\r\n\u001b[?2004l\r\u001b[?2004h>           Array.from({ length: perPage }).map((_, index) => (\r\n\u001b[?2004l\r\u001b[?2004h>             <ProductSkeleton key={index} />\r\n\u001b[?2004l\r\u001b[?2004h>           ))\r\n\u001b[?2004l\r\u001b[?2004h>         ) : (\r\n\u001b[?2004l\r\u001b[?2004h>           visibleProducts.map((product) => (\r\n\u001b[?2004l\r\u001b[?2004h>             <ProductCard key={product.id} product={product} />\r\n\u001b[?2004l\r\u001b[?2004h"]
