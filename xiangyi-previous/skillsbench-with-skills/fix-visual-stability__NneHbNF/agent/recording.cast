[163.769864, "o", "          <div className=\"mb-3 h-4 w-20 bg-gray-300 animate-pulse\" />\r\n\u001b[?2004l\r\u001b[?2004h>           <div className=\"space-y-2\">\r\n\u001b[?2004l\r\u001b[?2004h>             {Array.from({ length: 4 }).map((_, i) => (\r\n\u001b[?2004l\r\u001b[?2004h>               <div key={i} className=\"h-3 w-full bg-gray-200 animate-pulse\" />\r\n\u001b[?2004l\r\u001b[?2004h>             ))}\r\n\u001b[?2004l\r\u001b[?2004h>           </div>\r\n\u001b[?2004l\r\u001b[?2004h>         </div>\r\n\u001b[?2004l\r\u001b[?2004h>       ) : (\r\n\u001b[?2004l\r\u001b[?2004h>         <nav>\r\n\u001b[?2004l\r\u001b[?2004h>           <h3 className=\"mb-3 text-base font-semibold\" style={{ color: 'var(--text-muted)' }}>Categories</h3>\r\n\u001b[?2004l\r\u001b[?2004h>           <ul className=\"list-none mb-6\">\r\n\u001b[?2004l\r\u001b[?2004h>             {data.categories.map((cat: any) => (\r\n\u001b[?2004l\r\u001b[?2004h>               <li key={cat.name} className=\"mb-2\">\r\n\u001b[?2004l\r\u001b[?2004h>                 <a href={cat.href} className=\"text-[#0070f3] no-underline hover:underline\">{cat.name}</a>\r\n\u001b[?2004l\r\u001b[?2004h>               </li>\r\n\u001b[?2004l\r\u001b[?2004h>             ))}\r\n\u001b[?2004l\r\u001b[?2004h>           </ul>\r\n\u001b[?2004l\r\u001b[?2004h>           <h3 className=\"mb-3 text-base font-semibold\" style={{ color: 'var(--text-muted)' }}>Filters</h3>\r\n\u001b[?2004l\r\u001b[?2004h>           <ul className=\"list-none mb-6\">\r\n\u001b[?2004l\r\u001b[?2004h>             {data.filters.map((filter: any) => (\r\n\u001b[?2004l\r\u001b[?2004h>               <li key={filter.name} className=\"mb-2\">\r\n\u001b[?2004l\r\u001b[?2004h>                 <a href={filter.href} className=\"text-[#0070f3] no-underline hover:underline\">{filter.name}</a>\r\n\u001b[?2004l\r\u001b[?2004h>               </li>\r\n\u001b[?2004l\r\u001b[?2004h>             ))}\r\n\u001b[?2004l\r\u001b[?2004h>           </ul>\r\n\u001b[?2004l\r\u001b[