[578.84232, "o", "\u001b[?2004h> "]
[578.842402, "o", "        local_vocab.update(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.842457, "o", "    return doc_tfs, local_df, local_vocab\r\n\u001b[?2004l\r"]
[578.842513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.842685, "o", "def build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.842754, "o", "> "]
[578.842832, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.842888, "o", ">     if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.842939, "o", "> "]
[578.842996, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.843052, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.843138, "o", "    ctx = multiprocessing.get_context('fork')\r\n\u001b[?2004l\r"]
[578.843188, "o", "\u001b[?2004h> "]
[578.843252, "o", "    pool = ctx.Pool(processes=num_workers)\r\n\u001b[?2004l\r"]
[578.843309, "o", "\u001b[?2004h> "]
[578.843457, "o", "    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\r\n\u001b[?2004l\r"]
[578.843507, "o", "\u001b[?2004h> "]
[578.843608, "o", "    results = pool.map(_tokenize_and_count_worker, chunks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.843656, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[578.843696, "o", "> "]
[578.843737, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.843794, "o", "    global_df = defaultdict(int)\r\n\u001b[?2004l\r"]
[578.843844, "o", "\u001b[?2004h> "]
[578.84389, "o", "    vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.843927, "o", "> "]
[578.843971, "o", "    for tfs, dfs, vocab in results:\r\n\u001b[?2004l\r"]
[578.84401, "o", "\u001b[?2004h> "]
[578.844072, "o", "        doc_term_freqs.update(tfs)\r\n\u001b[?2004l\r"]
[578.844113, "o", "\u001b[?2004h> "]
[578.84417, "o", "        vocabulary.update(vocab)\r\n\u001b[?2004l\r"]
[578.844211, "o", "\u001b[?2004h> "]
[578.844277, "o", "        for term, count in dfs.items():\r\n\u001b[?2004l\r"]
[578.844318, "o", "\u001b[?2004h> "]
[578.844378, "o", "            global_df[term] += count\r\n\u001b[?2004l\r"]
[578.844428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[578.844465, "o", "> "]
[578.844506, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.844542, "o", "> "]
[578.844601, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[578.844643, "o", "\u001b[?2004h> "]
[578.844697, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[578.844737, "o", "\u001b[?2004h> "]
[578.844823, "o", "    index.document_frequencies = dict(global_df)\r\n\u001b[?2004l\r"]
[578.844868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[578.844911, "o", "\u001b[?2004h> "]
[578.84495, "o", "    N = index.num_documents\r\n\u001b[?2004l\r"]
[578.844985, "o", "\u001b[?2004h> "]
[578.845078, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[578.845122, "o", "\u001b[?2004h> "]
[578.845199, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[578.845242, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[578.845281, "o", "\u001b[?2004h> "]
[578.845357, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[578.84543, "o", "\u001b[?2004h> "]
[578.845474, "o", "        doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.845516, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[578.845553, "o", "\u001b[?2004h> "]
[578.84563, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[578.845675, "o", "\u001b[?2004h> "]
[578.845739, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[578.845781, "o", "\u001b[?2004h> "]
[578.845842, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[578.845883, "o", "\u001b[?2004h> "]
[578.845956, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[578.846001, "o", "\u001b[?2004h> "]
[578.846087, "o", "            if term not in index.inverted_index:\r\n\u001b[?2004l\r"]
[578.846197, "o", "\u001b[?2004h> "]
[578.846334, "o", "                index.inverted_index[term] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.846427, "o", "            index.inverted_index[term].append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.846501, "o", "> "]
[578.846572, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.846648, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.846729, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.846794, "o", "    for term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.846864, "o", "> "]
[578.846948, "o", "        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.847007, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.847053, "o", "    pool.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.847098, "o", "    pool.join()\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.847142, "o", "> "]
[578.847208, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[578.847256, "o", "\u001b[?2004h> "]
[578.847602, "o", "    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.847673, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.847725, "o", "_global_index = None\r\n\u001b[?2004l\r"]
[578.847768, "o", "\u001b[?2004h> "]
[578.847822, "o", "_global_documents = None\r\n\u001b[?2004l\r"]
[578.847875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.847957, "o", "def _search_worker_fork(args):\r\n\u001b[?2004l\r"]
[578.848006, "o", "\u001b[?2004h> "]
[578.848053, "o", "    query, top_k = args\r\n\u001b[?2004l\r"]
[578.848097, "o", "\u001b[?2004h> "]
[578.848158, "o", "    index = _global_index\r\n\u001b[?2004l\r"]
[578.848208, "o", "\u001b[?2004h> "]
[578.848286, "o", "    documents = _global_documents\r\n\u001b[?2004l\r"]
[578.848338, "o", "\u001b[?2004h> "]
[578.848409, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[578.848458, "o", "\u001b[?2004h> "]
[578.848544, "o", "    if not query_tokens: return []\r\n\u001b[?2004l\r"]
[578.848592, "o", "\u001b[?2004h> "]
[578.848719, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[578.848768, "o", "\u001b[?2004h> "]
[578.84882, "o", "    query_vector = {}\r\n\u001b[?2004l\r"]
[578.848865, "o", "\u001b[?2004h> "]
[578.848913, "o", "    query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.848956, "o", "> "]
[578.849011, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[578.849056, "o", "\u001b[?2004h> "]
[578.849103, "o", "        if term in index.idf:\r\n\u001b[?2004l\r"]
[578.849146, "o", "\u001b[?2004h> "]
[578.849208, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[578.849253, "o", "\u001b[?2004h> "]
[578.849314, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[578.849362, "o", "\u001b[?2004h> "]
[578.849438, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[578.849486, "o", "\u001b[?2004h> "]
[578.849537, "o", "    if not query_vector: return []\r\n\u001b[?2004l\r"]
[578.849581, "o", "\u001b[?2004h> "]
[578.849658, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r"]
[578.849712, "o", "\u001b[?2004h> "]
[578.849758, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r"]
[578.849801, "o", "\u001b[?2004h> "]
[578.849844, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.849886, "o", "> "]
[578.849934, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r"]
[578.849977, "o", "\u001b[?2004h> "]
[578.850074, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[578.850126, "o", "\u001b[?2004h> "]
[578.850242, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[578.850286, "o", "\u001b[?2004h>     scores = []\r\n\u001b[?2004l\r"]
[578.850326, "o", "\u001b[?2004h> "]
[578.850375, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[578.850421, "o", "\u001b[?2004h> "]
[578.85052, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})"]
[578.851312, "o", "\r\n\u001b[?2004l\r"]
[578.851413, "o", "\u001b[?2004h> "]
[578.851467, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r"]
[578.851514, "o", "\u001b[?2004h> "]
[578.851557, "o", "        if doc_norm == 0: continue\r\n\u001b[?2004l\r"]
[578.851594, "o", "\u001b[?2004h> "]
[578.851837, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector if term in doc_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.851971, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.852066, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[578.852112, "o", "\u001b[?2004h> "]
[578.852211, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[578.852263, "o", "\u001b[?2004h> "]
[578.852308, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.852465, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.852516, "o", "> "]
[578.85256, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[578.8526, "o", "\u001b[?2004h> "]
[578.852842, "o", "        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f\"Document {doc_id}\")))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.8529, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.85294, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.853106, "o", "def batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.853161, "o", "> "]
[578.853209, "o", "    global _global_index, _global_documents\r\n\u001b[?2004l\r"]
[578.85325, "o", "\u001b[?2004h> "]
[578.85329, "o", "    _global_index = index\r\n\u001b[?2004l\r"]
[578.853327, "o", "\u001b[?2004h> "]
[578.853396, "o", "    _global_documents = documents\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.853438, "o", "> "]
[578.853484, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[578.853525, "o", "\u001b[?2004h> "]
[578.853569, "o", "    if num_workers is None:\r\n\u001b[?2004l\r"]
[578.85361, "o", "\u001b[?2004h> "]
[578.853698, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r"]
[578.853743, "o", "\u001b[?2004h> "]
[578.853815, "o", "    ctx = multiprocessing.get_context('fork')\r\n\u001b[?2004l\r"]
[578.853858, "o", "\u001b[?2004h> "]
[578.853933, "o", "    pool = ctx.Pool(processes=num_workers)\r\n\u001b[?2004l\r"]
[578.853976, "o", "\u001b[?2004h> "]
[578.854074, "o", "    search_args = [(query, top_k) for query in queries]\r\n\u001b[?2004l\r"]
[578.854118, "o", "\u001b[?2004h> "]
[578.854248, "o", "    results = pool.map(_search_worker_fork, search_args)\r\n\u001b[?2004l\r\u001b[?2004h"]
[578.854323, "o", ">     pool.close()\r\n\u001b[?2004l\r"]
[578.854393, "o", "\u001b[?2004h>     pool.join()\r\n\u001b[?2004l\r"]
[578.854459, "o", "\u001b[?2004h> "]
[578.854522, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.854598, "o", "    return results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[578.854674, "o", "EOF\r\n\u001b[?2004l\r"]
[578.856214, "o", "\u001b[?2004hroot@77ccf63384bf:~# "]
