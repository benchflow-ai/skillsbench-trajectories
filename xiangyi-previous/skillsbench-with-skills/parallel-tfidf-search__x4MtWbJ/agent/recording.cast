[33.316093, "o", "    doc_chunk_size = max(1, len(doc_ids) // num_workers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.316138, "o", "> "]
[33.31626, "o", "    doc_id_chunks = [doc_ids[i:i + doc_chunk_size] for i in range(0, len(doc_ids), doc_chunk_size)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.316313, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.31648, "o", "    vector_results = pool.map(_build_doc_vectors_worker, [(chunk, doc_term_freqs, index.idf) for chunk in doc_id_chunks])\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.316541, "o", "> "]
[33.316591, "o", "    for vectors_chunk, norms_chunk in vector_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.316656, "o", "        index.doc_vectors.update(vectors_chunk)\r\n\u001b[?2004l\r"]
[33.316703, "o", "\u001b[?2004h> "]
[33.316745, "o", "        index.doc_norms.update(norms_chunk)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.316789, "o", "\u001b[?2004h> "]
[33.316835, "o", "    pool.close()\r\n\u001b[?2004l\r\u001b[?2004h>     pool.join()\r\n\u001b[?2004l\r"]
[33.316887, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[33.31693, "o", "> "]
[33.316976, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317184, "o", "    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.317228, "o", "\u001b[?2004h> "]
[33.317285, "o", "def _search_worker(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317335, "o", "    from sequential import search_sequential\r\n\u001b[?2004l\r"]
[33.317388, "o", "\u001b[?2004h> "]
[33.317439, "o", "    query, index, top_k, documents = args\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317519, "o", "    return search_sequential(query, index, top_k, documents)\r\n\u001b[?2004l\r"]
[33.317566, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317684, "o", "def batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.317737, "o", "> "]
[33.317789, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317833, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.317912, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.317962, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318041, "o", "    pool = multiprocessing.Pool(processes=num_workers)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318209, "o", "    search_args = [(query, index, top_k, documents) for query in queries]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318307, "o", "    results = pool.map(_search_worker, search_args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318354, "o", "    pool.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.31838, "o", "    pool.join()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318441, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.3185, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.318543, "o", "    return results, elapsed\r\n\u001b[?2004l\r"]
[33.318593, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[33.319865, "o", "\u001b[?2004hroot@77ccf63384bf:~# "]
[41.227113, "i", "cat << 'EOF' > /root/workspace/test_solution.py\nimport time\nimport sys\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential, generate_corpus\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef main():\n    num_docs = 2000\n    num_queries = 20\n    num_workers = 4\n\n    print(f\"Generating {num_docs} documents...\")\n    documents = generate_corpus(num_docs, seed=42)\n    \n    queries = [\"machine learning algorithm\", \"distributed systems architecture\", \"data science research\"] * 7\n    queries = queries[:num_queries]\n\n    print(\"\\n--- Sequential Version ---\")\n    start_seq_idx = time.perf_counter()\n    seq_result = build_tfidf_index_sequential(documents)\n    seq_idx_time = seq_result.elapsed_time\n    print(f\"Indexing time: {seq_idx_time:.4f}s\")\n\n    start_seq_search = time.perf_counter()\n    seq_search_results = batch_search_sequential(queries, seq_result.index, documents=documents)\n    seq_search_time = time.perf_counter() - start_seq_search\n    print(f\"Search time: {seq_search_time:.4f}s\")\n\n    print(\"\\n--- Parallel Version ---\")\n    par_result = build_tfidf_index_parallel(documents, num_workers=num_workers)\n    par_idx_time = par_result.elapsed_time\n    print(f\"Indexing time: {par_idx_time:.4f}s\")\n\n    par_search_results, par_search_time = batch_search_parallel(queries, par_result.index, num_workers=num_workers, documents=documents)\n    print(f\"Search time: {par_search_time:.4f}s\")\n\n    print(\"\\n--- Comparison ---\")\n    idx_speedup = seq_idx_time / par_idx_time\n    search_speedup = seq_search_time / par_search_time\n    print(f\"Indexing Speedup: {idx_speedup:.2f}x\")\n    print(f\"Search Speedup: {search_speedup:.2f}x\")\n\n    # Correctness check\n    correct = True\n    if len(seq_search_results) != len(par_search_results):\n        correct = False\n    else:\n        for s_res, p_res in zip(seq_search_results, par_search_results):\n            if len(s_res) != len(p_res):\n                correct = False\n                break\n            for sr, pr in zip(s_res, p_res):\n                if sr.doc_id != pr.doc_id or abs(sr.score - pr.score) > 1e-9:\n                    correct = False\n                    break\n            if not correct: break\n\n    print(f\"Results Correct: {correct}\")\n\n    if not correct:\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
