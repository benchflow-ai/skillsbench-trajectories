[71.706613, "i", "cat << 'EOF' > /root/workspace/parallel_solution.py\nimport math\nimport time\nimport multiprocessing\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom sequential import TFIDFIndex, SearchResult, tokenize, compute_term_frequencies, STOP_WORDS, TOKEN_PATTERN\nfrom document_generator import Document\n\n@dataclass\nclass ParallelIndexingResult:\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\ndef _tokenize_and_count_worker(docs):\n    doc_tfs = {}\n    local_df = defaultdict(int)\n    local_vocab = set()\n    for doc in docs:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_tfs[doc.doc_id] = tf\n        for term in tf:\n            local_df[term] += 1\n        local_vocab.update(tf.keys())\n    return doc_tfs, local_df, local_vocab\n\ndef build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n\n    pool = multiprocessing.Pool(processes=num_workers)\n    \n    # Step 1 & 2: Tokenize and count DF\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    results = pool.map(_tokenize_and_count_worker, chunks)\n\n    doc_term_freqs = {}\n    global_df = defaultdict(int)\n    vocabulary = set()\n    \n    for tfs, dfs, vocab in results:\n        doc_term_freqs.update(tfs)\n        vocabulary.update(vocab)\n        for term, count in dfs.items():\n            global_df[term] += count\n\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    index.vocabulary = vocabulary\n    index.document_frequencies = dict(global_df)\n\n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n\n    # Step 4 & 5: Build inverted index and doc vectors (Sequential for now, as they are fast once we have TFs and IDF)\n    # Actually, Step 4 & 5 in sequential were slow because of the nested loops.\n    # Let's optimize them.\n\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n            \n            if term not in index.inverted_index:\n                index.inverted_index[term] = []\n            index.inverted_index[term].append((doc_id, tfidf))\n        \n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    # Sort inverted index posting lists\n    for term in index.inverted_index:\n        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n\n    pool.close()\n    pool.join()\n\n    elapsed = time.perf_counter() - start_time\n    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\n_global_index = None\n\ndef _init_search_worker(index):\n    global _global_index\n    _global_index = index\n\ndef _search_worker_optimized(args):\n    from sequential import tokenize, compute_term_frequencies\n    query, top_k, documents = args\n    index = _global_index\n    \n    query_tokens = tokenize(query)\n    if not query_tokens: return []\n    query_tf = compute_term_frequencies(query_tokens)\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    if not query_vector: return []\n    query_norm = math.sqrt(query_norm_squared)\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_ve"]
[71.706706, "i", "ctors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        if doc_norm == 0: continue\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector if term in doc_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    results = []\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    for doc_id, score in top_results:\n        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f\"Document {doc_id}\")))\n    return results\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n    \n    # Using initializer to share index among workers once\n    pool = multiprocessing.Pool(processes=num_workers, initializer=_init_search_worker, initargs=(index,))\n    search_args = [(query, top_k, documents) for query in queries]\n    results = pool.map(_search_worker_optimized, search_args)\n    pool.close()\n    pool.join()\n    \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\nEOF\n"]
[71.707173, "o", "cat << 'EOF' > /root/workspace/parallel_solution.py\r\n\u001b[?2004l\r"]
[71.707295, "o", "\u001b[?2004h> import math\r\n"]
[71.707389, "o", "\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r"]
[71.707482, "o", "\u001b[?2004h> "]
[71.70759, "o", "import multiprocessing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.707737, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[71.70786, "o", "\u001b[?2004h> "]
[71.707981, "o", "from dataclasses import dataclass, field\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.708113, "o", "from heapq import nlargest\r\n\u001b[?2004l\r"]
[71.708189, "o", "\u001b[?2004h> "]
[71.708716, "o", "from sequential import TFIDFIndex, SearchResult, tokenize, compute_term_frequencies, STOP_WORDS, TOKEN_PATTERN\r\n\u001b[?2004l\r"]
[71.708807, "o", "\u001b[?2004h> "]
[71.708951, "o", "from document_generator import Document\r\n\u001b[?2004l\r"]
[71.709025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[71.709095, "o", "@dataclass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.709257, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[71.709328, "o", "\u001b[?2004h> "]
[71.709405, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.709531, "o", "    elapsed_time: float\r\n\u001b[?2004l\r"]
[71.709587, "o", "\u001b[?2004h> "]
[71.709709, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[71.709792, "o", "\u001b[?2004h> "]
[71.709864, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.709939, "o", "\u001b[?2004h> "]
[71.710095, "o", "def _tokenize_and_count_worker(docs):\r\n\u001b[?2004l\r"]
[71.710194, "o", "\u001b[?2004h> "]
[71.71028, "o", "    doc_tfs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.710419, "o", "    local_df = defaultdict(int)\r\n\u001b[?2004l\r"]
[71.7105, "o", "\u001b[?2004h> "]
[71.710578, "o", "    local_vocab = set()\r\n\u001b[?2004l\r"]
[71.710667, "o", "\u001b[?2004h> "]
[71.710741, "o", "    for doc in docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.710927, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r"]
[71.711007, "o", "\u001b[?2004h> "]
[71.711103, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r"]
[71.71117, "o", "\u001b[?2004h> "]
[71.711368, "o", "        tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r"]
[71.711478, "o", "\u001b[?2004h> "]
[71.711584, "o", "        doc_tfs[doc.doc_id] = tf\r\n\u001b[?2004l\r"]
[71.711651, "o", "\u001b[?2004h> "]
[71.711749, "o", "        for term in tf:\r\n\u001b[?2004l\r"]
[71.71181, "o", "\u001b[?2004h> "]
[71.711942, "o", "            local_df[term] += 1\r\n\u001b[?2004l\r"]
[71.712006, "o", "\u001b[?2004h> "]
[71.712174, "o", "        local_vocab.update(tf.keys())\r\n\u001b[?2004l\r"]
[71.712235, "o", "\u001b[?2004h> "]
[71.71241, "o", "    return doc_tfs, local_df, local_vocab\r\n\u001b[?2004l\r"]
[71.712483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.712555, "o", "\u001b[?2004h> "]
[71.712859, "o", "def build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\r\n\u001b[?2004l\r"]
[71.712931, "o", "\u001b[?2004h> "]
[71.713094, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[71.713158, "o", "\u001b[?2004h> "]
[71.713271, "o", "    if num_workers is None:\r\n\u001b[?2004l\r"]
[71.713333, "o", "\u001b[?2004h> "]
[71.713553, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r"]
[71.71362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.713901, "o", "    pool = multiprocessing.Pool(processes=num_workers)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.713968, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.714126, "o", "    # Step 1 & 2: Tokenize and count DF\r\n\u001b[?2004l\r"]
[71.714212, "o", "\u001b[?2004h> "]
[71.714632, "o", "    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\r\n\u001b[?2004l\r"]
[71.714815, "o", "\u001b[?2004h>     results = pool.map(_tokenize_and_count_worker, chunks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.714937, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r"]
[71.715044, "o", "\u001b[?2004h> "]
[71.715146, "o", "    global_df = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715254, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715355, "o", "    for tfs, dfs, vocab in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715474, "o", "        doc_term_freqs.update(tfs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715559, "o", "        vocabulary.update(vocab)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715695, "o", "        for term, count in dfs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715801, "o", "            global_df[term] += count\r\n\u001b[?2004l\r"]
[71.715884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.715965, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.716046, "o", "> "]
[71.716124, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.716235, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[71.716321, "o", "\u001b[?2004h> "]
[71.716471, "o", "    index.document_frequencies = dict(global_df)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.716576, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.716683, "o", "    # Step 3: Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.716787, "o", "    N = index.num_documents\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.716873, "o", "> "]
[71.716966, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.717096, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[71.717191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.717434, "o", "    # Step 4 & 5: Build inverted index and doc vectors (Sequential for now, as they are fast once we have TFs and IDF)\r\n\u001b[?2004l\r"]
[71.717525, "o", "\u001b[?2004h> "]
[71.717693, "o", "    # Actually, Step 4 & 5 in sequential were slow because of the nested loops.\r\n\u001b[?2004l\r"]
[71.717789, "o", "\u001b[?2004h> "]
[71.717887, "o", "    # Let's optimize them.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.717972, "o", "> "]
[71.718056, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[71.718152, "o", "\u001b[?2004h> "]
[71.71824, "o", "        doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.718318, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.718395, "o", "> "]
[71.718474, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.718552, "o", "> "]
[71.718629, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.718712, "o", "> "]
[71.71879, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.718916, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[71.719, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[71.719078, "o", "\u001b[?2004h> "]
[71.719164, "o", "            if term not in index.inverted_index:\r\n\u001b[?2004l\r"]
[71.719244, "o", "\u001b[?2004h> "]
[71.719339, "o", "                index.inverted_index[term] = []\r\n\u001b[?2004l\r"]
[71.719425, "o", "\u001b[?2004h> "]
[71.719553, "o", "            index.inverted_index[term].append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[71.719637, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.71974, "o", "> "]
[71.719832, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.720009, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.720133, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.720227, "o", "    # Sort inverted index posting lists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.720319, "o", "    for term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.720707, "o", "        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     pool.close()\r\n\u001b[?2004l\r\u001b[?2004h>     pool.join()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.721668, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _global_index = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _init_search_worker(index):\r\n\u001b[?2004l\r\u001b[?2004h>     global _global_index\r\n\u001b[?2004l\r\u001b[?2004h>     _global_index = index\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _search_worker_optimized(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.721725, "o", "    from sequential import tokenize, compute_term_frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.721919, "o", "    query, top_k, documents = args\r\n"]
[71.721983, "o", "\u001b[?2004l\r\u001b[?2004h>     index = _global_index"]
[71.722056, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.722183, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.722232, "o", ">     query_tokens = tokenize(query)"]
[71.722275, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.722485, "o", "    if not query_tokens: return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.722543, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[71.722703, "o", "\u001b[?2004h>     query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h>     query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.722818, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.722911, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.72301, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723111, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723214, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.723314, "o", ">     if not query_vector: return []\r\n\u001b[?2004l\r"]
[71.7234, "o", "\u001b[?2004h> "]
[71.723523, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723621, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723717, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723799, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.723918, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.72401, "o", "> "]
[71.72409, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h>     scores = []\r\n\u001b[?2004l\r"]
[71.724169, "o", "\u001b[?2004h> "]
[71.724261, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.724353, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.724452, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r"]
[71.724533, "o", "\u001b[?2004h> "]
[71.724621, "o", "        if doc_norm == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.724847, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector if term in doc_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.72506, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[71.725148, "o", "\u001b[?2004h> "]
[71.725234, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.725467, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[71.725602, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.725976, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h>     for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[71.726116, "o", "\u001b[?2004h> "]
[71.726298, "o", "        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f\"Document {doc_id}\")))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.726409, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.726535, "o", "def batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.726626, "o", ">     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.726725, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.72683, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.72692, "o", "    # Using initializer to share index among workers once\r\n\u001b[?2004l\r"]
[71.726994, "o", "\u001b[?2004h> "]
[71.727097, "o", "    pool = multiprocessing.Pool(processes=num_workers, initializer=_init_search_worker, initargs=(index,))\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.727174, "o", "> "]
[71.727258, "o", "    search_args = [(query, top_k, documents) for query in queries]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.72735, "o", "    results = pool.map(_search_worker_optimized, search_args)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.727435, "o", "    pool.close()\r\n\u001b[?2004l\r\u001b[?2004h>     pool.join()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.727513, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.727588, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[71.727664, "o", "\u001b[?2004h> "]
[71.727744, "o", "    return results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.727815, "o", "> EOF\r\n\u001b[?2004l\r"]
[71.730281, "o", "\u001b[?2004hroot@77ccf63384bf:~# "]
