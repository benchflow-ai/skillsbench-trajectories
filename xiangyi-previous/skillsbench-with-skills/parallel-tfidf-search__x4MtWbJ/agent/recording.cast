[137.159045, "o", "\u001b[?2004h> "]
[137.159199, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.159219, "o", "> "]
[137.159304, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[137.159324, "o", "\u001b[?2004h> "]
[137.159542, "o", "        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f\"Document {doc_id}\")))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[137.159597, "o", "    return results\r\n\u001b[?2004l\r"]
[137.159629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[137.159652, "o", "> "]
[137.159805, "o", "def batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.159826, "o", "> "]
[137.15989, "o", "    global _global_index, _global_documents\r\n\u001b[?2004l\r"]
[137.159918, "o", "\u001b[?2004h> "]
[137.159946, "o", "    _global_index = index\r\n\u001b[?2004l\r"]
[137.159968, "o", "\u001b[?2004h> "]
[137.160132, "o", "    _global_documents = documents\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[137.16022, "o", ">     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.160278, "o", "> "]
[137.160332, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.160386, "o", "> "]
[137.160492, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r"]
[137.160547, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[137.160602, "o", "\u001b[?2004h> "]
[137.160709, "o", "    ctx = multiprocessing.get_context('fork')\r\n\u001b[?2004l\r"]
[137.160764, "o", "\u001b[?2004h> "]
[137.160854, "o", "    pool = ctx.Pool(processes=num_workers)\r\n\u001b[?2004l\r"]
[137.160914, "o", "\u001b[?2004h> "]
[137.161037, "o", "    search_args = [(query, top_k) for query in queries]\r\n\u001b[?2004l\r"]
[137.161091, "o", "\u001b[?2004h> "]
[137.161224, "o", "    results = pool.map(_search_worker_fork, search_args)\r\n\u001b[?2004l\r"]
[137.161279, "o", "\u001b[?2004h> "]
[137.161332, "o", "    pool.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.161382, "o", "> "]
[137.161436, "o", "    pool.join()\r\n\u001b[?2004l\r\u001b[?2004h"]
[137.16149, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[137.161523, "o", "> "]
[137.161647, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[137.161706, "o", "\u001b[?2004h> "]
[137.161767, "o", "    return results, elapsed\r\n\u001b[?2004l\r"]
[137.161829, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
