==========================================\r\n# Search Functions\r\n# ============================================================================\r\n\r\n\r\ndef search_sequential(query: str, index: TFIDFIndex, top_k: int = 10, documents: list[Document] = None) -> list[SearchResult]:  # noqa: RUF013\r\n"]
