[1225.884671, "o", "> "]
[1225.88473, "o", "            if phrase2_clean in filler_words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.884789, "o", "                detected.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.884849, "o", "                    \"word\": phrase2_clean,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.884921, "o", "> "]
[1225.884976, "o", "                    \"timestamp\": words_list[i]['start'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.88504, "o", "                    \"end\": words_list[i+1]['end']\r\n\u001b[?2004l\r"]
[1225.885102, "o", "\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885163, "o", "                i += 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.88522, "o", "                found = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885284, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885337, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885395, "o", "        # Check for single words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885459, "o", "        word = words_list[i]['word'].strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.885515, "o", "> "]
[1225.885574, "o", "        word_clean = re.sub(r'[^\\w\\s]', '', word)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885635, "o", "        if word_clean in filler_words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885687, "o", "            detected.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.885741, "o", "> "]
[1225.885799, "o", "                \"word\": word_clean,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.885859, "o", "                \"timestamp\": words_list[i]['start'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.88594, "o", "                \"end\": words_list[i]['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886013, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.886066, "o", ">         i += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886165, "o", "    # Save to annotations.json (only word and timestamp as requested)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886312, "o", "    annotations = [{\"word\": d[\"word\"], \"timestamp\": d[\"timestamp\"]} for d in detected]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886384, "o", "    with open(output_json, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.886451, "o", "> "]
[1225.886506, "o", "        json.dump(annotations, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886568, "o", "    if not detected:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886633, "o", "        print(\"No filler words detected.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.886685, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.88677, "o", "    # Create ffmpeg filter complex to stitch clips\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.886831, "o", "> "]
[1225.886884, "o", "    # We'll use a filter_complex to avoid many intermediate files\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.886938, "o", ">     filter_complex = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887007, "o", ">     for i, d in enumerate(detected):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887063, "o", "> "]
[1225.887178, "o", "        filter_complex += f\"[0:v]trim=start={d['timestamp']}:end={d['end']},setpts=PTS-STARTPTS[v{i}];\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887243, "o", "> "]
[1225.887385, "o", "        filter_complex += f\"[0:a]atrim=start={d['timestamp']}:end={d['end']},asetpts=PTS-STARTPTS[a{i}];\"\r\n\u001b[?2004l\r"]
[1225.887455, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.887518, "o", "    for i in range(len(detected)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.887573, "o", "        filter_complex += f\"[v{i}][a{i}]\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887635, "o", "> "]
[1225.887694, "o", "    filter_complex += f\"concat=n={len(detected)}:v=1:a=1[outv][outa]\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887759, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     cmd = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.887839, "o", "        \"ffmpeg\", \"-y\", \"-i\", video_path,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.887917, "o", "        \"-filter_complex\", filter_complex,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.887986, "o", "> "]
[1225.888059, "o", "        \"-map\", \"[outv]\", \"-map\", \"[outa]\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.888114, "o", "        output_video\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.888173, "o", "    print(\"Running ffmpeg...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.888221, "o", "    subprocess.run(cmd)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1225.888282, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.888383, "o", "detect_fillers(\"/root/input.mp4\", \"/root/annotations.json\", \"/root/output.mp4\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.888413, "o", "EOF\r\n\u001b[?2004l\r"]
[1225.922627, "o", "\u001b[?2004hroot@2117414a953a:~# "]
[1225.922806, "o", "python3 /root/detect_fillers.py\r\n\u001b[?2004l\r"]
