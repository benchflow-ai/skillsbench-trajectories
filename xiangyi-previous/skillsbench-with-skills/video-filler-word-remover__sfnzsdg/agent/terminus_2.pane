cat << 'EOF' > /root/detect_fillers.py
import whisper
import json
import subprocess
import re

def detect_fillers(video_path, output_json, output_video):
    model = whisper.load_model("base")
    result = model.transcribe(video_path, word_timestamps=True)

    filler_words = [
        "um", "uh", "hum", "hmm", "mhm",
        "like",
        "you know",
        "i mean",
        "yeah",
        "so",
        "kind of",
        "basically",
        "i guess",
        "well",
        "okay"
    ]

    detected = []
    words_list = []
    for segment in result['segments']:
        for word_info in segment['words']:
            words_list.append(word_info)

    # Sort words by start time just in case
    words_list.sort(key=lambda x: x['start'])

    i = 0
    while i < len(words_list):
        found = False
        # Check for phrases first (2 words)
        if i + 1 < len(words_list):
            phrase2 = (words_list[i]['word'].strip().lower() + " " + words_list[i+1]['word'].strip().lower())
            phrase2_clean = re.sub(r'[^\w\s]', '', phrase2)
            if phrase2_clean in filler_words:
                detected.append({
                    "word": phrase2_clean,
                    "timestamp": words_list[i]['start'],
                    "end": words_list[i+1]['end']
                })
                i += 2
                found = True
                continue
        
        # Check for single words
        word = words_list[i]['word'].strip().lower()
        word_clean = re.sub(r'[^\w\s]', '', word)
        if word_clean in filler_words:
            detected.append({
                "word": word_clean,
                "timestamp": words_list[i]['start'],
                "end": words_list[i]['end']
            })
        i += 1

    # Save to annotations.json (only word and timestamp as requested)
    annotations = [{"word": d["word"], "timestamp": d["timestamp"]} for d in detected]
    with open(output_json, 'w') as f:
        json.dump(annotations, f, indent=2)

    if not detected:
        print("No filler words detected.")
        return

    # Create ffmpeg filter complex to stitch clips
    # We'll use a filter_complex to avoid many intermediate files
    filter_complex = ""
    for i, d in enumerate(detected):
        filter_complex += f"[0:v]trim=start={d['timestamp']}:end={d['end']},setpts=PTS-STARTPTS[v{i}];"
        filter_complex += f"[0:a]atrim=start={d['timestamp']}:end={d['end']},asetpts=PTS-STARTPTS[a{i}];"
    
    for i in range(len(detected)):
        filter_complex += f"[v{i}][a{i}]"
    filter_complex += f"concat=n={len(detected)}:v=1:a=1[outv][outa]"

    cmd = [
        "ffmpeg", "-y", "-i", video_path,
        "-filter_complex", filter_complex,
        "-map", "[outv]", "-map", "[outa]",
        output_video
    ]
    
    print("Running ffmpeg...")
    subprocess.run(cmd)

detect_fillers("/root/input.mp4", "/root/annotations.json", "/root/output.mp4")
EOF
python3 /root/detect_fillers.py
