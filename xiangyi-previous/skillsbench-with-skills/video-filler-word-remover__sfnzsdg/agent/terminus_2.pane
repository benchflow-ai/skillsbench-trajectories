[?2004l[?2004h> def detect_fillers(video_path, output_json, output_video):
[?2004l[?2004h>     model = whisper.load_model("base")
[?2004l[?2004h>     result = model.transcribe(video_path, word_timestamps=True)
[?2004l[?2004h> 
[?2004l[?2004h>     filler_words = [
[?2004l[?2004h>         "um", "uh", "hum", "hmm", "mhm",
[?2004l[?2004h>         "like",
[?2004l[?2004h>         "you know",
[?2004l[?2004h>         "i mean",
[?2004l[?2004h>         "yeah",
[?2004l[?2004h>         "so",
[?2004l[?2004h>         "kind of",
[?2004l[?2004h>         "basically",
[?2004l[?2004h>         "i guess",
[?2004l[?2004h>         "well",
[?2004l[?2004h>         "okay"
[?2004l[?2004h>     ]
[?2004l[?2004h> 
[?2004l[?2004h>     detected = []
[?2004l[?2004h>     words_list = []
[?2004l[?2004h>     for segment in result['segments']:
[?2004l[?2004h>         for word_info in segment['words']:
[?2004l[?2004h>             words_list.append(word_info)
[?2004l[?2004h> 
[?2004l[?2004h>     # Sort words by start time just in case
[?2004l[?2004h>     words_list.sort(key=lambda x: x['start'])
[?2004l[?2004h> 
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < len(words_list):
[?2004l[?2004h>         found = False
[?2004l[?2004h>         # Check for phrases first (2 words)
[?2004l[?2004h>         if i + 1 < len(words_list):
[?2004l[?2004h>             phrase2 = (words_list[i]['word'].strip().lower() + " " + words_list[i+1]['word'].strip().lower())
[?2004l[?2004h>             phrase2_clean = re.sub(r'[^\w\s]', '', phrase2)
[?2004l[?2004h>             if phrase2_clean in filler_words:
[?2004l[?2004h>                 detected.append({
[?2004l[?2004h>                     "word": phrase2_clean,
[?2004l[?2004h>                     "timestamp": words_list[i]['start'],
[?2004l[?2004h>                     "end": words_list[i+1]['end']
[?2004l[?2004h>                 })
[?2004l[?2004h>                 i += 2
[?2004l[?2004h>                 found = True
[?2004l[?2004h>                 continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Check for single words
[?2004l[?2004h>         word = words_list[i]['word'].strip().lower()
[?2004l[?2004h>         word_clean = re.sub(r'[^\w\s]', '', word)
[?2004l[?2004h>         if word_clean in filler_words:
[?2004l[?2004h>             detected.append({
[?2004l[?2004h>                 "word": word_clean,
[?2004l[?2004h>                 "timestamp": words_list[i]['start'],
[?2004l[?2004h>                 "end": words_list[i]['end']
[?2004l[?2004h>             })
[?2004l[?2004h>         i += 1
[?2004l[?2004h> 
[?2004l[?2004h>     # Save to annotations.json (only word and timestamp as requested)
[?2004l[?2004h>     annotations = [{"word": d["word"], "timestamp": d["timestamp"]} for d in detected]
[?2004l[?2004h>     with open(output_json, 'w') as f:
[?2004l[?2004h>         json.dump(annotations, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h>     if not detected:
[?2004l[?2004h>         print("No filler words detected.")
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     # Create ffmpeg filter complex to stitch clips
[?2004l[?2004h>     # We'll use a filter_complex to avoid many intermediate files
[?2004l[?2004h>     filter_complex = ""
[?2004l[?2004h>     for i, d in enumerate(detected):
[?2004l[?2004h>         filter_complex += f"[0:v]trim=start={d['timestamp']}:end={d['end']},setpts=PTS-STARTPTS[v{i}];"
[?2004l[?2004h>         filter_complex += f"[0:a]atrim=start={d['timestamp']}:end={d['end']},asetpts=PTS-STARTPTS[a{i}];"
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(detected)):
[?2004l[?2004h>         filter_complex += f"[v{i}][a{i}]"
[?2004l[?2004h>     filter_complex += f"concat=n={len(detected)}:v=1:a=1[outv][outa]"
[?2004l[?2004h> 
[?2004l[?2004h>     cmd = [
[?2004l[?2004h>         "ffmpeg", "-y", "-i", video_path,
