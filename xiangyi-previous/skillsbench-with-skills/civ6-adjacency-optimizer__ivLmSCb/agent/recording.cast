[45.953304, "i", "python3 << 'EOF'\nimport sqlite3\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get Plots table structure\ncursor.execute(\"PRAGMA table_info(Plots);\")\ncolumns = cursor.fetchall()\nprint(\"Plots columns:\")\nfor col in columns:\n    print(f\"  {col}\")\n\n# Get sample plots\ncursor.execute(\"SELECT * FROM Plots LIMIT 10;\")\nplots = cursor.fetchall()\nprint(\"\\nSample plots:\")\nfor plot in plots:\n    print(f\"  {plot}\")\n\nconn.close()\nEOF\n"]
