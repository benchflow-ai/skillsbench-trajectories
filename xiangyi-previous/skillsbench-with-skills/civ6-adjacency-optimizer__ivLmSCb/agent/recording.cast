[123.877067, "o", "\u001b[?2004h> "]
[123.877175, "o", "    # Count mountains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877203, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877225, "o", "        if (nx, ny) in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877304, "o", "            tile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87739, "o", "            if 'MOUNTAIN' in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.877417, "o", "> "]
[123.87746, "o", "                bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877528, "o", "            # Geothermal fissure\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87762, "o", "            if tile['feature'] == 'FEATURE_GEOTHERMAL_FISSURE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.877648, "o", "> "]
[123.877733, "o", "                bonus += 1\r\n\u001b[?2004l\r"]
[123.877763, "o", "\u001b[?2004h>             # Reef\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877837, "o", "            if tile['feature'] == 'FEATURE_REEF':\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.877863, "o", "> "]
[123.877928, "o", "                bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.877993, "o", "    # Count rainforests/jungles (1 per 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878038, "o", "    jungle_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878095, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878168, "o", "        if (nx, ny) in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.878196, "o", "> "]
[123.87824, "o", "            tile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.878314, "o", "> "]
[123.87838, "o", "            if tile['feature'] in ['FEATURE_JUNGLE', 'FEATURE_MARSH']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87843, "o", "                jungle_count += 1\r\n\u001b[?2004l\r"]
[123.87849, "o", "\u001b[?2004h> "]
[123.878518, "o", "    bonus += jungle_count // 2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[123.87859, "o", "\u001b[?2004h> "]
[123.878617, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878681, "o", "def calculate_holy_site_bonus(x, y, placed_districts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87877, "o", "    \"\"\"Calculate Holy Site adjacency bonus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878831, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878867, "o", "    neighbors = get_neighbors(x, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.878942, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.878966, "o", "    # Count mountains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879029, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879073, "o", "        if (nx, ny) in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.879131, "o", "> "]
[123.879191, "o", "            tile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879251, "o", "            if 'MOUNTAIN' in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879301, "o", "                bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.87936, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879416, "o", "    # Count woods (1 per 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879475, "o", "    woods_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879534, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87959, "o", "        if (nx, ny) in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879646, "o", "            tile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.87972, "o", "            if tile['feature'] == 'FEATURE_FOREST':\r\n\u001b[?2004l\r"]
[123.879775, "o", "\u001b[?2004h> "]
[123.879835, "o", "                woods_count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879859, "o", "    bonus += woods_count // 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879931, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.879956, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880025, "o", "def calculate_theater_bonus(x, y, placed_districts):\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.880083, "o", "> "]
[123.880142, "o", "    \"\"\"Calculate Theater Square adjacency bonus\"\"\"\r\n\u001b[?2004l\r"]
[123.880193, "o", "\u001b[?2004h>     bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.88022, "o", "    neighbors = get_neighbors(x, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.880295, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.88032, "o", "> "]
[123.880379, "o", "    # Count adjacent districts (1 per 2)\r\n\u001b[?2004l\r\u001b[?2004h>     district_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880434, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880521, "o", "        if (nx, ny) in placed_districts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880573, "o", "            district_count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880635, "o", "    bonus += district_count // 2\r\n\u001b[?2004l\r"]
[123.88069, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.880718, "o", ">     return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.880795, "o", "\u001b[?2004h> "]
[123.880868, "o", "def calculate_industrial_zone_bonus(x, y, placed_districts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880929, "o", "    \"\"\"Calculate Industrial Zone adjacency bonus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.880987, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.881046, "o", "> "]
[123.881102, "o", "    # Typically gets bonus from mines/quarries and strategic resources\r\n\u001b[?2004l\r"]
[123.881158, "o", "\u001b[?2004h> "]
[123.881185, "o", "    # Without resource data, this will be minimal\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.881255, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.88128, "o", "\u001b[?2004h> "]
[123.881348, "o", "def calculate_commercial_hub_bonus(x, y, placed_districts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.881418, "o", "    \"\"\"Calculate Commercial Hub adjacency bonus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.881445, "o", "> "]
[123.881517, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.881539, "o", "    neighbors = get_neighbors(x, y)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[123.881617, "o", "\u001b[?2004h> "]
[123.881643, "o", "    # Count adjacent rivers (would need river data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.881722, "o", ">     # Count adjacent harbors\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.881775, "o", ">     for nx, ny in neighbors:\r\n\u001b[?2004l\r"]
[123.881831, "o", "\u001b[?2004h> "]
[123.881895, "o", "        if placed_districts.get((nx, ny)) == 'HARBOR':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.881936, "o", "            bonus += 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.881992, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882047, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882133, "o", "def calculate_harbor_bonus(x, y, placed_districts, city_center):\r\n\u001b[?2004l\r"]
[123.882176, "o", "\u001b[?2004h> "]
[123.88224, "o", "    \"\"\"Calculate Harbor adjacency bonus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882284, "o", "    if (x, y) not in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882336, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882379, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882421, "o", "    tile = terrain_map[(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882465, "o", "    # Harbor must be on coast\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.882512, "o", "> "]
[123.882564, "o", "    if 'COAST' not in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.882614, "o", ">         return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882643, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882706, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.882734, "o", "    neighbors = get_neighbors(x, y)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[123.882782, "o", "\u001b[?2004h> "]
[123.882832, "o", "    # +2 if adjacent to city center\r\n\u001b[?2004l\r"]
[123.882859, "o", "\u001b[?2004h> "]
[123.882909, "o", "    if city_center in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h>         bonus += 2\r\n\u001b[?2004l\r"]
[123.882935, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[123.882984, "o", "\u001b[?2004h> "]
[123.883052, "o", "    # Count sea resources (reef, fish, etc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883144, "o", "    for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883192, "o", "        if (nx, ny) in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883238, "o", "            ntile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883337, "o", "            if ntile['feature'] == 'FEATURE_REEF':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.88338, "o", "                bonus += 1\r\n\u001b[?2004l\r"]
[123.883427, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883482, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883522, "o", "def is_harbor_valid(x, y):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883605, "o", "    \"\"\"Check if harbor can be placed here\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883672, "o", "    if (x, y) not in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883717, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883778, "o", "    tile = terrain_map[(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883847, "o", "    return 'COAST' in tile['terrain']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.883895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[123.883943, "o", "\r\n\u001b[?2004l\r"]
[123.885181, "o", "\u001b[?2004hroot@25684a8ed669:~# "]
[149.312378, "i", "cat >> /tmp/solve_civ6.py << 'EOF'\n\n# Find valid land tiles\nvalid_tiles = [(x, y) for x, y in terrain_map.keys() if is_valid_placement(x, y)]\n\nprint(f\"Valid placement tiles: {len(valid_tiles)}\")\n\n# Population 9 allows building multiple districts\n# Let's try different city center locations and district combinations\n\nbest_solution = None\nbest_total = -1\n\n# District types to consider\ndistrict_types = ['CAMPUS', 'HOLY_SITE', 'THEATER_SQUARE', 'INDUSTRIAL_ZONE', 'COMMERCIAL_HUB']\n\n# Try each valid tile as city center\nfor city_center in valid_tiles:\n    cx, cy = city_center\n    \n    # Get tiles within 3 range of city center (workable tiles)\n    workable = []\n    for x, y in terrain_map.keys():\n        # Calculate distance (simplified - should use proper hex distance)\n        dx = abs(x - cx)\n        dy = abs(y - cy)\n        if dx <= 3 and dy <= 3:  # Approximate range\n            workable.append((x, y))\n    \n    # Find valid district placements (not on city center, within range)\n    valid_for_districts = []\n    for x, y in workable:\n        if (x, y) != city_center and is_valid_placement(x, y):\n            valid_for_districts.append((x, y))\n    \n    # Also check for harbor locations (coastal tiles near city)\n    harbor_locations = []\n    for x, y in workable:\n        if (x, y) != city_center and is_harbor_valid(x, y):\n            # Check if adjacent to city center\n            if city_center in get_neighbors(x, y):\n                harbor_locations.append((x, y))\n    \n    # Try different combinations of districts\n    # With population 9, we can build up to 4-5 districts\n    max_districts = 4\n    \n    # Evaluate all district placements\n    district_scores = {}\n    \n    for loc in valid_for_districts:\n        scores = {}\n        scores['CAMPUS'] = calculate_campus_bonus(loc[0], loc[1], {})\n        scores['HOLY_SITE'] = calculate_holy_site_bonus(loc[0], loc[1], {})\n        scores['THEATER_SQUARE'] = 0  # Needs other districts\n        scores['INDUSTRIAL_ZONE'] = calculate_industrial_zone_bonus(loc[0], loc[1], {})\n        scores['COMMERCIAL_HUB'] = calculate_commercial_hub_bonus(loc[0], loc[1], {})\n        district_scores[loc] = scores\n    \n    for loc in harbor_locations:\n        if loc not in district_scores:\n            district_scores[loc] = {}\n        district_scores[loc]['HARBOR'] = calculate_harbor_bonus(loc[0], loc[1], {}, city_center)\n    \n    # Find best districts to place\n    # Greedy approach: pick highest scoring districts\n    all_options = []\n    for loc, scores in district_scores.items():\n        for dtype, score in scores.items():\n            all_options.append((score, dtype, loc))\n    \n    all_options.sort(reverse=True)\n    \n    # Select top districts (ensuring no overlap)\n    selected = []\n    used_locations = set()\n    used_types = set()\n    \n    for score, dtype, loc in all_options:\n        if loc not in used_locations and dtype not in used_types and len(selected) < max_districts:\n            selected.append((dtype, loc, score))\n            used_locations.add(loc)\n            used_types.add(dtype)\n    \n    # Recalculate theater square bonus with actual placements\n    placed_districts = {loc: dtype for dtype, loc, _ in selected}\n    for i, (dtype, loc, score) in enumerate(selected):\n        if dtype == 'THEATER_SQUARE':\n            new_score = calculate_theater_bonus(loc[0], loc[1], placed_districts)\n            selected[i] = (dtype, loc, new_score)\n    \n    total = sum(score for _, _, score in selected)\n    \n    if total > best_total:\n        best_total = total\n        best_solution = {\n            'city_center': list(city_center),\n            'districts': selected\n        }\n\nprint(f\"\\nBest solution found:\")\nprint(f\"City center: {best_solution['city_center']}\")\nprint(f\"Districts:\")\nfor dtype, loc, score in best_solution['districts']:\n    print(f\"  {dtype}: {loc} (bonus: {score})\")\nprint(f\"Total adjacency: {best_total}\")\n\n# Format output\nplacements = {}\nadjacency_bonuses = {}\nfor dtype, loc, score in best_solution['districts']:\n    placements[dtype] = list(loc)\n    adjacency_bonuses[dtype] = score\n\noutput = {\n    "]
[149.312447, "i", "'city_center': best_solution['city_center'],\n    'placements': placements,\n    'adjacency_bonuses': adjacency_bonuses,\n    'total_adjacency': best_total\n}\n\n# Write to output file\nimport os\nos.makedirs('/output', exist_ok=True)\nwith open('/output/scenario_3.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(\"\\nSolution written to /output/scenario_3.json\")\nEOF\n"]
