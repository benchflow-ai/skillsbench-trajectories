[185.280025, "o", "EOF\r\n\u001b[?2004l\r"]
[185.3008, "o", "Verifying solution:\r\nCity center: [20, 13]\r\n\r\nCity center at (20, 13):\r\n  Terrain: TERRAIN_GRASS\r\n  Feature: FEATURE_JUNGLE\r\n\r\nCAMPUS at (21, 14):\r\n  Terrain: TERRAIN_GRASS\r\n  Feature: None\r\n  Neighbors:\r\n    (20, 14): TERRAIN_COAST                  FEATURE_REEF\r\n    (22, 14): TERRAIN_GRASS                  \r\n    (20, 13): TERRAIN_GRASS                  FEATURE_JUNGLE\r\n    (21, 13): TERRAIN_GRASS                  FEATURE_GEOTHERMAL_FISSURE\r\n    (20, 15): TERRAIN_GRASS                  FEATURE_JUNGLE\r\n    (21, 15): TERRAIN_GRASS_MOUNTAIN         \r\n  Stated bonus: 4\r\n    +1 from reef at (20, 14)\r\n    +1 from geothermal fissure at (21, 13)\r\n    +1 from mountain at (21, 15)\r\n"]
[185.300986, "o", "    +1 from 2 jungles/marshes\r\n  Calculated bonus: 4\r\n\r\nHARBOR at (19, 13):\r\n  Terrain: TERRAIN_COAST\r\n  Feature: None\r\n  Neighbors:\r\n    (18, 13): TERRAIN_OCEAN                  \r\n    (20, 13): TERRAIN_GRASS                  FEATURE_JUNGLE\r\n    (19, 12): TERRAIN_OCEAN                  \r\n    (20, 12): TERRAIN_COAST                  \r\n    (19, 14): TERRAIN_OCEAN                  \r\n    (20, 14): TERRAIN_COAST                  FEATURE_REEF\r\n  Stated bonus: 3\r\n    +2 from adjacent city center\r\n    +1 from reef at (20, 14)\r\n  Calculated bonus: 3\r\n\r\nHOLY_SITE at (23, 12):\r\n  Terrain: TERRAIN_GRASS\r\n  Feature: None\r\n  Neighbors:\r\n    (22, 12): TERRAIN_GRASS                  \r\n    (24, 12): TERRAIN_GRASS                  FEATURE_FOREST\r\n    (22, 11): TERRAIN_GRASS_MOUNTAIN         \r\n    (23, 11): TERRAIN_GRASS                  FEATURE_FOREST\r\n"]
[185.301081, "o", "    (22, 13): TERRAIN_GRASS                  \r\n    (23, 13): TERRAIN_GRASS                  FEATURE_FOREST\r\n  Stated bonus: 2\r\n    +1 from mountain at (22, 11)\r\n    +1 from 3 woods\r\n  Calculated bonus: 2\r\n\r\nTHEATER_SQUARE at (23, 16):\r\n  Terrain: TERRAIN_PLAINS\r\n  Feature: FEATURE_FLOODPLAINS_PLAINS\r\n  Neighbors:\r\n    (22, 16): TERRAIN_GRASS                  \r\n    (24, 16): TERRAIN_GRASS                  \r\n    (22, 15): TERRAIN_GRASS                  \r\n    (23, 15): TERRAIN_PLAINS                 FEATURE_FLOODPLAINS_PLAINS\r\n    (22, 17): TERRAIN_PLAINS                 FEATURE_FLOODPLAINS_PLAINS\r\n    (23, 17): TERRAIN_GRASS                  \r\n  Stated bonus: 0\r\n"]
