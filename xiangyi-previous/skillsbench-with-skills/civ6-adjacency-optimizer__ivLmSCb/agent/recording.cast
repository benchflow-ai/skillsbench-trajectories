[260.343786, "i", "python3 << 'EOF'\nimport json\n\n# Create the solution\nsolution = {\n    \"city_center\": [24, 11],\n    \"placements\": {\n        \"CAMPUS\": [21, 14],\n        \"HOLY_SITE\": [23, 12],\n        \"HARBOR\": [24, 10],\n        \"COMMERCIAL_HUB\": [23, 11]\n    },\n    \"adjacency_bonuses\": {\n        \"CAMPUS\": 4,\n        \"HOLY_SITE\": 2,\n        \"HARBOR\": 2,\n        \"COMMERCIAL_HUB\": 2\n    },\n    \"total_adjacency\": 10\n}\n\n# Write to output file\nimport os\nos.makedirs('/output', exist_ok=True)\nwith open('/output/scenario_3.json', 'w') as f:\n    json.dump(solution, f, indent=2)\n\nprint(\"Solution written to /output/scenario_3.json\")\nprint(f\"\\nFinal solution:\")\nprint(f\"City center: {solution['city_center']}\")\nprint(f\"Districts:\")\nfor dtype, loc in solution['placements'].items():\n    bonus = solution['adjacency_bonuses'][dtype]\n    print(f\"  {dtype}: {loc} (bonus: {bonus})\")\nprint(f\"\\nTotal adjacency: {solution['total_adjacency']}\")\nEOF\n"]
