[221.154866, "o", "# Focus on city center at (20, 13) which seems good, but try others too\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.154969, "o", "best_total = 9  # Current best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155055, "o", "best_solution = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.15514, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155279, "o", "for city_center in valid_tiles[:10]:  # Try first 10 valid tiles as city center\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.15538, "o", ">     cx, cy = city_center\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155466, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155546, "o", "    # Get potential district locations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155624, "o", "    candidates = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.155702, "o", "    for x, y in valid_tiles:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.15578, "o", "        if (x, y) != city_center:\r\n\u001b[?2004l\r"]
[221.155859, "o", "\u001b[?2004h> "]
[221.155969, "o", "            # Check if within reasonable range\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.15622, "o", "            if abs(x - cx) <= 3 and abs(y - cy) <= 3:\r\n\u001b[?2004l\r\u001b[?2004h>                 candidates.append((x, y))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.156338, "o", "    # Add harbor candidates\r\n\u001b[?2004l\r\u001b[?2004h> "]
