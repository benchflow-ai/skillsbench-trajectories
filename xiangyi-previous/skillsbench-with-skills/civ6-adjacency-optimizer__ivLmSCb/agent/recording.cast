[221.152747, "o", "\u001b[?2004h> "]
[221.152852, "o", "            if ntile['feature'] == 'FEATURE_REEF':\r\n"]
[221.152903, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[221.152959, "o", "                bonus += 1\r\n\u001b[?2004l\r"]
[221.15301, "o", "\u001b[?2004h>     "]
[221.153058, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.153147, "o", "    elif district_type == 'THEATER_SQUARE':\r\n\u001b[?2004l\r"]
[221.15319, "o", "\u001b[?2004h> "]
[221.153462, "o", "        district_count = sum(1 for nx, ny in neighbors if (nx, ny) in placed_districts and placed_districts[(nx, ny)] != 'THEATER_SQUARE')\r\n\u001b[?2004l\r"]
[221.153511, "o", "\u001b[?2004h> "]
[221.154548, "o", "        bonus += district_count // 2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elif district_type == 'COMMERCIAL_HUB':\r\n\u001b[?2004l\r\u001b[?2004h>         harbor_count = sum(1 for nx, ny in neighbors if placed_districts.get((nx, ny)) == 'HARBOR')\r\n\u001b[?2004l\r\u001b[?2004h>         bonus += harbor_count * 2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try to find better combinations\r\n\u001b[?2004l\r\u001b[?2004h> valid_tiles = [(x, y) for x, y in terrain_map.keys() if is_valid_placement(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
