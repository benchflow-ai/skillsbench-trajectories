[149.31592, "o", "\u001b[?2004h"]
[149.315948, "o", "> "]
[149.316034, "o", "        dy = abs(y - cy)\r\n\u001b[?2004l\r"]
[149.316063, "o", "\u001b[?2004h"]
[149.316095, "o", "> "]
[149.316229, "o", "        if dx <= 3 and dy <= 3:  # Approximate range\r\n\u001b[?2004l\r"]
[149.316259, "o", "\u001b[?2004h> "]
[149.316376, "o", "            workable.append((x, y))\r\n\u001b[?2004l\r"]
[149.316551, "o", "\u001b[?2004h"]
[149.316641, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.316826, "o", "    # Find valid district placements (not on city center, within range)\r\n\u001b[?2004l\r"]
[149.316881, "o", "\u001b[?2004h> "]
[149.316957, "o", "    valid_for_districts = []\r\n\u001b[?2004l\r"]
[149.317015, "o", "\u001b[?2004h> "]
[149.317074, "o", "    for x, y in workable:\r\n\u001b[?2004l\r"]
[149.317105, "o", "\u001b[?2004h> "]
[149.317266, "o", "        if (x, y) != city_center and is_valid_placement(x, y):\r\n\u001b[?2004l\r"]
[149.317336, "o", "\u001b[?2004h> "]
[149.317462, "o", "            valid_for_districts.append((x, y))\r\n\u001b[?2004l\r"]
[149.317549, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.317723, "o", "    # Also check for harbor locations (coastal tiles near city)\r\n\u001b[?2004l\r"]
[149.317791, "o", "\u001b[?2004h> "]
[149.317819, "o", "    harbor_locations = []\r\n\u001b[?2004l\r"]
[149.317847, "o", "\u001b[?2004h> "]
[149.317947, "o", "    for x, y in workable:\r\n\u001b[?2004l\r"]
[149.317982, "o", "\u001b[?2004h> "]
[149.318169, "o", "        if (x, y) != city_center and is_harbor_valid(x, y):\r\n\u001b[?2004l\r"]
[149.318212, "o", "\u001b[?2004h> "]
[149.31837, "o", "            # Check if adjacent to city center\r\n\u001b[?2004l\r"]
[149.31841, "o", "\u001b[?2004h> "]
[149.31858, "o", "            if city_center in get_neighbors(x, y):\r\n\u001b[?2004l\r"]
[149.31862, "o", "\u001b[?2004h> "]
[149.318769, "o", "                harbor_locations.append((x, y))\r\n\u001b[?2004l\r"]
[149.318798, "o", "\u001b[?2004h> "]
[149.31902, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Try different combinations of districts"]
[149.319114, "o", "\r\n"]
[149.319365, "o", "\u001b[?2004l\r\u001b[?2004h"]
[149.319457, "o", ">     # With population 9, we can build up to 4-5 districts\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.319529, "o", "> "]
[149.319641, "o", "    max_districts = 4"]
[149.319718, "o", "\r\n\u001b[?2004l\r"]
[149.3198, "o", "\u001b[?2004h"]
[149.319903, "o", ">     "]
[149.320048, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Evaluate all district placements"]
[149.320112, "o", "\r\n"]
[149.320272, "o", "\u001b[?2004l\r"]
[149.320341, "o", "\u001b[?2004h>     district_scores = {}\r\n\u001b[?2004l\r"]
[149.320439, "o", "\u001b[?2004h"]
[149.320514, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.320548, "o", "> "]
[149.32063, "o", "    for loc in valid_for_districts:\r\n\u001b[?2004l\r"]
[149.320657, "o", "\u001b[?2004h> "]
[149.320738, "o", "        scores = {}\r\n\u001b[?2004l\r"]
[149.320763, "o", "\u001b[?2004h> "]
[149.320979, "o", "        scores['CAMPUS'] = calculate_campus_bonus(loc[0], loc[1], {})\r\n\u001b[?2004l\r"]
[149.321034, "o", "\u001b[?2004h> "]
[149.32117, "o", "        scores['HOLY_SITE'] = calculate_holy_site_bonus(loc[0], loc[1], {})\r\n\u001b[?2004l\r"]
[149.321204, "o", "\u001b[?2004h> "]
[149.321373, "o", "        scores['THEATER_SQUARE'] = 0  # Needs other districts\r\n\u001b[?2004l\r"]
[149.3214, "o", "\u001b[?2004h> "]
[149.321637, "o", "        scores['INDUSTRIAL_ZONE'] = calculate_industrial_zone_bonus(loc[0], loc[1], {})\r\n\u001b[?2004l\r"]
[149.321664, "o", "\u001b[?2004h"]
[149.32169, "o", "> "]
[149.321916, "o", "        scores['COMMERCIAL_HUB'] = calculate_commercial_hub_bonus(loc[0], loc[1], {})\r\n\u001b[?2004l\r"]
[149.321941, "o", "\u001b[?2004h> "]
[149.322041, "o", "        district_scores[loc] = scores\r\n\u001b[?2004l\r"]
[149.322075, "o", "\u001b[?2004h> "]
[149.322098, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.322123, "o", "> "]
[149.322226, "o", "    for loc in harbor_locations:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.322317, "o", "        if loc not in district_scores:\r\n\u001b[?2004l\r"]
[149.322344, "o", "\u001b[?2004h> "]
[149.322437, "o", "            district_scores[loc] = {}\r\n\u001b[?2004l\r"]
[149.322468, "o", "\u001b[?2004h> "]
[149.322668, "o", "        district_scores[loc]['HARBOR'] = calculate_harbor_bonus(loc[0], loc[1], {}, city_center)\r\n"]
[149.322702, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.322766, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.322842, "o", "    # Find best districts to place\r\n\u001b[?2004l\r"]
[149.322875, "o", "\u001b[?2004h> "]
[149.322999, "o", "    # Greedy approach: pick highest scoring districts\r\n\u001b[?2004l\r"]
[149.323025, "o", "\u001b[?2004h> "]
[149.323088, "o", "    all_options = []\r\n\u001b[?2004l\r"]
[149.323112, "o", "\u001b[?2004h> "]
[149.323222, "o", "    for loc, scores in district_scores.items():\r\n\u001b[?2004l\r"]
[149.323254, "o", "\u001b[?2004h> "]
[149.323356, "o", "        for dtype, score in scores.items():\r\n\u001b[?2004l\r"]
[149.323407, "o", "\u001b[?2004h> "]
[149.323507, "o", "            all_options.append((score, dtype, loc))\r\n\u001b[?2004l\r"]
[149.32354, "o", "\u001b[?2004h> "]
[149.323564, "o", "    \r\n\u001b[?2004l\r"]
[149.323587, "o", "\u001b[?2004h> "]
[149.32369, "o", "    all_options.sort(reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.323715, "o", ">     \r\n"]
[149.32374, "o", "\u001b[?2004l\r"]
[149.323765, "o", "\u001b[?2004h> "]
[149.323878, "o", "    # Select top districts (ensuring no overlap)\r\n\u001b[?2004l\r"]
[149.32391, "o", "\u001b[?2004h> "]
[149.323972, "o", "    selected = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.323997, "o", "> "]
[149.324061, "o", "    used_locations = set()\r\n\u001b[?2004l\r"]
[149.324095, "o", "\u001b[?2004h> "]
[149.324164, "o", "    used_types = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.324189, "o", ">     \r\n"]
[149.324213, "o", "\u001b[?2004l\r\u001b[?2004h"]
[149.324236, "o", "> "]
[149.324338, "o", "    for score, dtype, loc in all_options:\r\n\u001b[?2004l\r"]
[149.324371, "o", "\u001b[?2004h> "]
[149.324581, "o", "        if loc not in used_locations and dtype not in used_types and len(selected) < max_districts:\r\n\u001b[?2004l\r"]
[149.324613, "o", "\u001b[?2004h> "]
[149.324722, "o", "            selected.append((dtype, loc, score))\r\n\u001b[?2004l\r"]
[149.324749, "o", "\u001b[?2004h> "]
[149.324831, "o", "            used_locations.add(loc)\r\n\u001b[?2004l\r"]
[149.32486, "o", "\u001b[?2004h> "]
[149.324945, "o", "            used_types.add(dtype)\r\n\u001b[?2004l\r"]
[149.324972, "o", "\u001b[?2004h> "]
[149.324997, "o", "    \r\n\u001b[?2004l\r"]
[149.32502, "o", "\u001b[?2004h> "]
[149.325162, "o", "    # Recalculate theater square bonus with actual placements\r\n\u001b[?2004l\r"]
[149.325187, "o", "\u001b[?2004h> "]
[149.325331, "o", "    placed_districts = {loc: dtype for dtype, loc, _ in selected}\r\n\u001b[?2004l\r"]
[149.325356, "o", "\u001b[?2004h> "]
[149.325483, "o", "    for i, (dtype, loc, score) in enumerate(selected):\r\n\u001b[?2004l\r"]
[149.325508, "o", "\u001b[?2004h"]
[149.325531, "o", "> "]
[149.325619, "o", "        if dtype == 'THEATER_SQUARE':\r\n\u001b[?2004l\r"]
[149.325651, "o", "\u001b[?2004h> "]
[149.325858, "o", "            new_score = calculate_theater_bonus(loc[0], loc[1], placed_districts)\r\n\u001b[?2004l\r"]
[149.325883, "o", "\u001b[?2004h"]
[149.325906, "o", "> "]
[149.32605, "o", "            selected[i] = (dtype, loc, new_score)\r\n\u001b[?2004l\r"]
[149.326084, "o", "\u001b[?2004h"]
[149.326104, "o", "> "]
[149.326187, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.326319, "o", "    total = sum(score for _, _, score in selected)\r\n\u001b[?2004l\r"]
[149.326347, "o", "\u001b[?2004h"]
[149.326368, "o", "> "]
[149.326475, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.326544, "o", "    if total > best_total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.326644, "o", "        best_total = total\r\n\u001b[?2004l\r"]
[149.326715, "o", "\u001b[?2004h> "]
[149.326767, "o", "        best_solution = {\r\n\u001b[?2004l\r"]
[149.326792, "o", "\u001b[?2004h"]
[149.326815, "o", "> "]
[149.326968, "o", "            'city_center': list(city_center),\r\n\u001b[?2004l\r"]
[149.326994, "o", "\u001b[?2004h"]
[149.327017, "o", "> "]
[149.327136, "o", "            'districts': selected\r\n\u001b[?2004l\r"]
[149.327161, "o", "\u001b[?2004h> "]
[149.327223, "o", "        }\r\n\u001b[?2004l\r"]
[149.327246, "o", "\u001b[?2004h"]
[149.32734, "o", "> \r\n\u001b[?2004l\r"]
[149.327399, "o", "\u001b[?2004h> "]
[149.327423, "o", "print(f\"\\nBest solution found:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.327578, "o", "print(f\"City center: {best_solution['city_center']}\")\r\n\u001b[?2004l\r"]
[149.32761, "o", "\u001b[?2004h> "]
[149.32769, "o", "print(f\"Districts:\")\r\n\u001b[?2004l\r"]
[149.327758, "o", "\u001b[?2004h> "]
[149.327872, "o", "for dtype, loc, score in best_solution['districts']:\r\n\u001b[?2004l\r"]
[149.327897, "o", "\u001b[?2004h> "]
[149.328055, "o", "    print(f\"  {dtype}: {loc} (bonus: {score})\")\r\n\u001b[?2004l\r"]
[149.328089, "o", "\u001b[?2004h> "]
[149.328228, "o", "print(f\"Total adjacency: {best_total}\")\r\n\u001b[?2004l\r"]
[149.328259, "o", "\u001b[?2004h"]
[149.328339, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.328371, "o", "# Format output\r\n\u001b[?2004l\r"]
[149.328396, "o", "\u001b[?2004h> "]
[149.328473, "o", "placements = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.328497, "o", "> "]
[149.328567, "o", "adjacency_bonuses = {}\r\n\u001b[?2004l\r"]
[149.328622, "o", "\u001b[?2004h> "]
[149.328742, "o", "for dtype, loc, score in best_solution['districts']:\r\n\u001b[?2004l\r"]
[149.328767, "o", "\u001b[?2004h> "]
[149.328873, "o", "    placements[dtype] = list(loc)\r\n\u001b[?2004l\r"]
[149.328929, "o", "\u001b[?2004h> "]
[149.329015, "o", "    adjacency_bonuses[dtype] = score\r\n\u001b[?2004l\r"]
[149.329039, "o", "\u001b[?2004h> "]
[149.329063, "o", "\r\n\u001b[?2004l\r"]
[149.329157, "o", "\u001b[?2004h> output = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.329201, "o", "> "]
[149.329284, "o", "    'city_center': best_solution['city_center'],\r\n\u001b[?2004l\r"]
[149.329308, "o", "\u001b[?2004h> "]
[149.329409, "o", "    'placements': placements,\r\n\u001b[?2004l\r"]
[149.329434, "o", "\u001b[?2004h> "]
[149.329533, "o", "    'adjacency_bonuses': adjacency_bonuses,\r\n\u001b[?2004l\r"]
[149.32958, "o", "\u001b[?2004h> "]
[149.329644, "o", "    'total_adjacency': best_total\r\n\u001b[?2004l\r"]
[149.329716, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.329781, "o", "> "]
[149.329836, "o", "# Write to output file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.329862, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.329931, "o", "os.makedirs('/output', exist_ok=True)\r\n\u001b[?2004l\r"]
[149.329984, "o", "\u001b[?2004h> "]
[149.330067, "o", "with open('/output/scenario_3.json', 'w') as f:\r\n\u001b[?2004l\r"]
[149.33011, "o", "\u001b[?2004h> "]
[149.330173, "o", "    json.dump(output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.330199, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.33032, "o", "print(\"\\nSolution written to /output/scenario_3.json\")\r\n\u001b[?2004l\r"]
[149.33038, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[149.332202, "o", "\u001b[?2004hroot@25684a8ed669:~# "]
[154.08518, "i", "python3 /tmp/solve_civ6.py\n"]
[154.085426, "o", "python3 /tmp/solve_civ6.py\r\n\u001b[?2004l\r"]
[154.107741, "o", "Valid placement tiles: 37\r\n"]
[154.138527, "o", "\r\nBest solution found:\r\nCity center: [20, 13]\r\nDistricts:\r\n  CAMPUS: (21, 14) (bonus: 4)\r\n  HARBOR: (19, 13) (bonus: 3)\r\n  HOLY_SITE: (23, 12) (bonus: 2)\r\n"]
[154.138732, "o", "  THEATER_SQUARE: (23, 16) (bonus: 0)\r\nTotal adjacency: 9\r\n"]
[154.141481, "o", "\r\nSolution written to /output/scenario_3.json\r\n"]
[154.143705, "o", "\u001b[?2004hroot@25684a8ed669:~# "]
[162.068837, "i", "cat /output/scenario_3.json\n"]
[162.069617, "o", "cat /output/scenario_3.json\r\n\u001b[?2004l\r"]
[162.070147, "o", "{\r\n  \"city_center\": [\r\n    20,\r\n    13\r\n  ],\r\n  \"placements\": {\r\n    \"CAMPUS\": [\r\n      21,\r\n      14\r\n    ],\r\n    \"HARBOR\": [\r\n      19,\r\n      13\r\n    ],\r\n    \"HOLY_SITE\": [\r\n      23,\r\n      12\r\n    ],\r\n    \"THEATER_SQUARE\": [\r\n      23,\r\n      16\r\n    ]\r\n  },\r\n  \"adjacency_bonuses\": {\r\n    \"CAMPUS\": 4,\r\n    \"HARBOR\": 3,\r\n    \"HOLY_SITE\": 2,\r\n    \"THEATER_SQUARE\": 0\r\n  },\r\n  \"total_adjacency\": 9\r\n}"]
[162.070281, "o", "\u001b[?2004hroot@25684a8ed669:~# "]
[185.260865, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\n\n# Load map data\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\ncursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\nplots_data = cursor.fetchall()\n\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\n\nconn.close()\n\n# Build terrain map\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': features.get(plot_id, None)\n    }\n\ndef get_neighbors(x, y):\n    if y % 2 == 0:  # Even row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x-1, y-1), (x, y-1),\n            (x-1, y+1), (x, y+1)\n        ]\n    else:  # Odd row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x, y-1), (x+1, y-1),\n            (x, y+1), (x+1, y+1)\n        ]\n    return [(nx, ny) for nx, ny in neighbors if (nx, ny) in terrain_map]\n\n# Load solution\nwith open('/output/scenario_3.json', 'r') as f:\n    solution = json.load(f)\n\nprint(\"Verifying solution:\")\nprint(f\"City center: {solution['city_center']}\")\n\n# Check city center location\ncx, cy = solution['city_center']\nprint(f\"\\nCity center at ({cx}, {cy}):\")\nif (cx, cy) in terrain_map:\n    tile = terrain_map[(cx, cy)]\n    print(f\"  Terrain: {tile['terrain']}\")\n    print(f\"  Feature: {tile['feature']}\")\n\n# Verify each district\nfor district_type, (dx, dy) in solution['placements'].items():\n    print(f\"\\n{district_type} at ({dx}, {dy}):\")\n    if (dx, dy) in terrain_map:\n        tile = terrain_map[(dx, dy)]\n        print(f\"  Terrain: {tile['terrain']}\")\n        print(f\"  Feature: {tile['feature']}\")\n        \n        neighbors = get_neighbors(dx, dy)\n        print(f\"  Neighbors:\")\n        for nx, ny in neighbors:\n            ntile = terrain_map[(nx, ny)]\n            print(f\"    ({nx}, {ny}): {ntile['terrain']:30s} {ntile['feature'] or ''}\")\n        \n        # Verify bonus\n        stated_bonus = solution['adjacency_bonuses'][district_type]\n        print(f\"  Stated bonus: {stated_bonus}\")\n        \n        # Manual verification\n        if district_type == 'CAMPUS':\n            bonus = 0\n            for nx, ny in neighbors:\n                ntile = terrain_map[(nx, ny)]\n                if 'MOUNTAIN' in ntile['terrain']:\n                    bonus += 1\n                    print(f\"    +1 from mountain at ({nx}, {ny})\")\n                if ntile['feature'] == 'FEATURE_GEOTHERMAL_FISSURE':\n                    bonus += 1\n                    print(f\"    +1 from geothermal fissure at ({nx}, {ny})\")\n                if ntile['feature'] == 'FEATURE_REEF':\n                    bonus += 1\n                    print(f\"    +1 from reef at ({nx}, {ny})\")\n            jungle_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] in ['FEATURE_JUNGLE', 'FEATURE_MARSH'])\n            bonus += jungle_count // 2\n            if jungle_count > 0:\n                print(f\"    +{jungle_count // 2} from {jungle_count} jungles/marshes\")\n            print(f\"  Calculated bonus: {bonus}\")\n        \n        elif district_type == 'HOLY_SITE':\n            bonus = 0\n            for nx, ny in neighbors:\n                ntile = terrain_map[(nx, ny)]\n                if 'MOUNTAIN' in ntile['terrain']:\n                    bonus += 1\n                    print(f\"    +1 from mountain at ({nx}, {ny})\")\n            woods_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] == 'FEATURE_FOREST')\n            bonus += woods_count // 2\n            if woods_count > 0:\n                print(f\"    +{woods_count // 2} from {woods_count} woods\")\n            print(f\"  Calculated bonus: {bonus}\")\n        \n        elif district_type == 'HARBOR':\n            bonus = 0\n            if (cx, cy) in neighbors:\n                bonus += 2\n                print(f\"    +2 from adjacent c"]
[185.260934, "i", "ity center\")\n            for nx, ny in neighbors:\n                ntile = terrain_map[(nx, ny)]\n                if ntile['feature'] == 'FEATURE_REEF':\n                    bonus += 1\n                    print(f\"    +1 from reef at ({nx}, {ny})\")\n            print(f\"  Calculated bonus: {bonus}\")\n\nEOF\n"]
