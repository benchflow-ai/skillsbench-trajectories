[97.189244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189309, "o", "# Build terrain map\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189338, "o", "terrain_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189517, "o", "for plot_id, terrain, impassable in plots_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189557, "o", "    x = plot_id % width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189619, "o", "    y = plot_id // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189649, "o", "    terrain_map[(x, y)] = {\r\n\u001b[?2004l\r"]
[97.189783, "o", "\u001b[?2004h> "]
[97.189848, "o", "        'terrain': terrain,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189911, "o", "        'impassable': impassable,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.189985, "o", "        'feature': features.get(plot_id, None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.190012, "o", ">     }\r\n\u001b[?2004l\r"]
[97.190039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.190148, "o", "\u001b[?2004h> "]
[97.190178, "o", "# Helper functions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.19025, "o", "def get_neighbors(x, y):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.190309, "o", "    \"\"\"Get all 6 neighbors in hex grid\"\"\"\r\n\u001b[?2004l\r"]
[97.190376, "o", "\u001b[?2004h> "]
[97.190435, "o", "    if y % 2 == 0:  # Even row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.190496, "o", "        neighbors = [\r\n\u001b[?2004l\r"]
[97.190551, "o", "\u001b[?2004h> "]
[97.190592, "o", "            (x-1, y), (x+1, y),\r\n\u001b[?2004l\r"]
[97.190655, "o", "\u001b[?2004h> "]
[97.190702, "o", "            (x-1, y-1), (x, y-1),\r\n\u001b[?2004l\r"]
[97.190753, "o", "\u001b[?2004h> "]
[97.190801, "o", "            (x-1, y+1), (x, y+1)\r\n\u001b[?2004l\r"]
[97.19086, "o", "\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[97.190909, "o", "\u001b[?2004h>     else:  # Odd row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.190954, "o", "        neighbors = [\r\n\u001b[?2004l\r"]
[97.191005, "o", "\u001b[?2004h> "]
[97.191065, "o", "            (x-1, y), (x+1, y),\r\n\u001b[?2004l\r"]
[97.191135, "o", "\u001b[?2004h> "]
[97.191191, "o", "            (x, y-1), (x+1, y-1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.191244, "o", "            (x, y+1), (x+1, y+1)\r\n\u001b[?2004l\r"]
[97.191267, "o", "\u001b[?2004h> "]
[97.191288, "o", "        ]\r\n\u001b[?2004l\r"]
[97.191397, "o", "\u001b[?2004h> "]
[97.191477, "o", "    return [(nx, ny) for nx, ny in neighbors if (nx, ny) in terrain_map]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.191547, "o", "\u001b[?2004h> "]
[97.191614, "o", "def is_valid_placement(x, y):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.191674, "o", "    \"\"\"Check if a tile can have a district placed\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.191723, "o", "> "]
[97.191772, "o", "    if (x, y) not in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.191821, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.191878, "o", "> "]
[97.191931, "o", "    tile = terrain_map[(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192013, "o", "    # Can't place on water, mountains, or impassable\r\n\u001b[?2004l\r"]
[97.19206, "o", "\u001b[?2004h> "]
[97.192281, "o", "    if 'OCEAN' in tile['terrain'] or 'COAST' in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192369, "o", "    if 'MOUNTAIN' in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.19242, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192473, "o", "    if tile['impassable']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192516, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.192546, "o", "> "]
[97.192624, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192677, "o", "# Find valid land tiles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.192831, "o", "valid_tiles = [(x, y) for x, y in terrain_map.keys() if is_valid_placement(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.192885, "o", "> "]
[97.19294, "o", "print(f\"Valid placement tiles: {len(valid_tiles)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.192987, "o", "> "]
[97.193048, "o", "print(f\"Sample valid tiles: {valid_tiles[:10]}\")\r\n\u001b[?2004l\r"]
[97.193101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.193157, "o", "> EOF\r\n\u001b[?2004l\r"]
