[97.187413, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\nfrom collections import defaultdict\n\n# Load map data\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\ncursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\nplots_data = cursor.fetchall()\n\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\n\nconn.close()\n\n# Build terrain map\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': features.get(plot_id, None)\n    }\n\n# Helper functions\ndef get_neighbors(x, y):\n    \"\"\"Get all 6 neighbors in hex grid\"\"\"\n    if y % 2 == 0:  # Even row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x-1, y-1), (x, y-1),\n            (x-1, y+1), (x, y+1)\n        ]\n    else:  # Odd row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x, y-1), (x+1, y-1),\n            (x, y+1), (x+1, y+1)\n        ]\n    return [(nx, ny) for nx, ny in neighbors if (nx, ny) in terrain_map]\n\ndef is_valid_placement(x, y):\n    \"\"\"Check if a tile can have a district placed\"\"\"\n    if (x, y) not in terrain_map:\n        return False\n    tile = terrain_map[(x, y)]\n    # Can't place on water, mountains, or impassable\n    if 'OCEAN' in tile['terrain'] or 'COAST' in tile['terrain']:\n        return False\n    if 'MOUNTAIN' in tile['terrain']:\n        return False\n    if tile['impassable']:\n        return False\n    return True\n\n# Find valid land tiles\nvalid_tiles = [(x, y) for x, y in terrain_map.keys() if is_valid_placement(x, y)]\nprint(f\"Valid placement tiles: {len(valid_tiles)}\")\nprint(f\"Sample valid tiles: {valid_tiles[:10]}\")\n\nEOF\n"]
