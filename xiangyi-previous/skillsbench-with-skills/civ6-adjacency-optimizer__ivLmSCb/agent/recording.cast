[97.188661, "o", "cursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.18871, "o", "plots_data = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.188884, "o", "cursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.188962, "o", "features_data = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> "]
