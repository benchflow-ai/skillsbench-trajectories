[39.160847, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get map dimensions\ncursor.execute(\"SELECT * FROM Map;\")\nmap_data = cursor.fetchall()\nprint(\"Map data:\")\nfor row in map_data:\n    print(f\"  {row}\")\n\n# Get column names for Map table\ncursor.execute(\"PRAGMA table_info(Map);\")\ncolumns = cursor.fetchall()\nprint(\"\\nMap columns:\")\nfor col in columns:\n    print(f\"  {col}\")\n\nconn.close()\nEOF\n"]
