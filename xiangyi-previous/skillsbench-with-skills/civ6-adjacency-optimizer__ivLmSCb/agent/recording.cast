[221.145407, "o", "    if 'OCEAN' in tile['terrain'] or 'COAST' in tile['terrain']:\r\n\u001b[?2004l\r"]
[221.145534, "o", "\u001b[?2004h> "]
[221.145634, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.145771, "o", "> "]
[221.145894, "o", "    if 'MOUNTAIN' in tile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.146194, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.146406, "o", "    if tile['impassable']:\r\n\u001b[?2004l\r"]
[221.146624, "o", "\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.146826, "o", ">     return True\r\n\u001b[?2004l\r"]
[221.146934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[221.147048, "o", "def is_harbor_valid(x, y):\r\n\u001b[?2004l\rcem\u001b[?2004h> "]
[221.147238, "o", "    if (x, y) not in terrain_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.1476, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h>     tile = terrain_map[(x, y)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.147728, "o", "    return 'COAST' in tile['terrain']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[221.148027, "o", "def calculate_bonus(district_type, x, y, placed_districts, city_center):\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.148095, "o", "> "]
[221.148167, "o", "    neighbors = get_neighbors(x, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.148294, "o", "    bonus = 0\r\n\u001b[?2004l\ra\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.148353, "o", "> "]
[221.148447, "o", "    if district_type == 'CAMPUS':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.148596, "o", "        for nx, ny in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.148717, "o", "> "]
[221.148798, "o", "            ntile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.149037, "o", "            if 'MOUNTAIN' in ntile['terrain']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.149162, "o", ">                 bonus += 1\r\n\u001b[?2004l\r"]
[221.149247, "o", "\u001b[?2004h> "]
[221.149425, "o", "            if ntile['feature'] == 'FEATURE_GEOTHERMAL_FISSURE':\r\n\u001b[?2004l\r"]
[221.149519, "o", "\u001b[?2004h> "]
[221.149589, "o", "                bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.149904, "o", "            if ntile['feature'] == 'FEATURE_REEF':\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.150107, "o", ">                 bonus += 1\r\n\u001b[?2004l\r"]
[221.150244, "o", "\u001b[?2004h> "]
[221.150658, "o", "        jungle_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] in ['FEATURE_JUNGLE', 'FEATURE_MARSH'])\r\n\u001b[?2004l\r"]
[221.150734, "o", "\u001b[?2004h> "]
[221.15085, "o", "        bonus += jungle_count // 2\r\n\u001b[?2004l\r"]
[221.150914, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.150981, "o", "> "]
[221.15111, "o", "    elif district_type == 'HOLY_SITE':\r\n\u001b[?2004l\r"]
[221.151179, "o", "\u001b[?2004h> "]
[221.151289, "o", "        for nx, ny in neighbors:\r\n\u001b[?2004l\r"]
[221.151378, "o", "\u001b[?2004h> "]
[221.151458, "o", "            ntile = terrain_map[(nx, ny)]\r\n\u001b[?2004l\r"]
[221.151512, "o", "\u001b[?2004h> "]
[221.151596, "o", "            if 'MOUNTAIN' in ntile['terrain']:\r\n\u001b[?2004l\r"]
[221.151639, "o", "\u001b[?2004h> "]
[221.151693, "o", "                bonus += 1\r\n\u001b[?2004l\r"]
[221.151738, "o", "\u001b[?2004h> "]
[221.151952, "o", "        woods_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] == 'FEATURE_FOREST')\r\n\u001b[?2004l\r"]
[221.152002, "o", "\u001b[?2004h> "]
[221.152076, "o", "        bonus += woods_count // 2\r\n\u001b[?2004l\r"]
[221.152119, "o", "\u001b[?2004h> "]
[221.152161, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.152246, "o", "    elif district_type == 'HARBOR':\r\n\u001b[?2004l\r"]
[221.1523, "o", "\u001b[?2004h> "]
[221.152376, "o", "        if city_center in neighbors:\r\n\u001b[?2004l\r"]
[221.15242, "o", "\u001b[?2004h> "]
