[246.870831, "o", "    (20, 14): TERRAIN_COAST                  FEATURE_REEF\r\n    (22, 14): TERRAIN_GRASS                  \r\n    (20, 13): TERRAIN_GRASS                  FEATURE_JUNGLE\r\n    (21, 13): TERRAIN_GRASS                  FEATURE_GEOTHERMAL_FISSURE\r\n    (20, 15): TERRAIN_GRASS                  FEATURE_JUNGLE\r\n    (21, 15): TERRAIN_GRASS_MOUNTAIN         \r\n    +1 from reef\r\n    +1 from geothermal fissure\r\n    +1 from mountain\r\n    +1 from 2 jungles\r\n  Total bonus: 4\r\n\r\nHOLY_SITE at (23, 12):\r\n  Terrain: TERRAIN_GRASS\r\n  Feature: None\r\n  Neighbors:\r\n    (22, 12): TERRAIN_GRASS                  \r\n    (24, 12): TERRAIN_GRASS                  FEATURE_FOREST\r\n    (22, 11): TERRAIN_GRASS_MOUNTAIN         \r\n    (23, 11): TERRAIN_GRASS                  FEATURE_FOREST <- COMMERCIAL_HUB\r\n    (22, 13): TERRAIN_GRASS                  \r\n    (23, 13): TERRAIN_GRASS                  FEATURE_FOREST\r\n    +1 from mountain\r\n    +1 from 3 woods\r\n  Total bonus: 2\r\n\r\nHARBOR at (24, 10):\r\n  Terrain: TERRAIN_COAST\r\n  Feature: None\r\n  Neighbors:\r\n    (23, 10): TERRAIN_COAST                  \r\n    (25, 10): TERRAIN_COAST                  \r\n    (23, 9): TERRAIN_OCEAN                  \r\n    (24, 9): TERRAIN_OCEAN                  \r\n    (23, 11): TERRAIN_GRASS                  FEATURE_FOREST <- COMMERCIAL_HUB\r\n    (24, 11): TERRAIN_GRASS                   <- CITY CENTER\r\n    +2 from adjacent city center\r\n  Total bonus: 2\r\n\r\nCOMMERCIAL_HUB at (23, 11):\r\n  Terrain: TERRAIN_GRASS\r\n  Feature: FEATURE_FOREST\r\n  Neighbors:\r\n    (22, 11): TERRAIN_GRASS_MOUNTAIN         \r\n    (24, 11): TERRAIN_GRASS                   <- CITY CENTER\r\n    (23, 10): TERRAIN_COAST                  \r\n    (24, 10): TERRAIN_COAST                   <- HARBOR\r\n    (23, 12): TERRAIN_GRASS                   <- HOLY_SITE\r\n    (24, 12): TERRAIN_GRASS                  FEATURE_FOREST\r\n    +2 from adjacent harbor\r\n  Total bonus: 2\r\n\r\n"]
