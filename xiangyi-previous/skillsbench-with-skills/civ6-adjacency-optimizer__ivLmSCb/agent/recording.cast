[221.156506, "o", "    for x, y in terrain_map.keys():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.157297, "o", "        if is_harbor_valid(x, y) and (x, y) != city_center:\r\n\u001b[?2004l\r\u001b[?2004h>             if abs(x - cx) <= 3 and abs(y - cy) <= 3:\r\n\u001b[?2004l\r\u001b[?2004h>                 if city_center in get_neighbors(x, y):\r\n\u001b[?2004l\r\u001b[?2004h>                     harbor_candidates.append((x, y))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Try different district type combinations\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.157452, "o", ">     district_types_to_try = [\r\n\u001b[?2004l\r\u001b[?2004h>         ['CAMPUS', 'HOLY_SITE', 'HARBOR', 'THEATER_SQUARE'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.157668, "o", "        ['CAMPUS', 'HOLY_SITE', 'HARBOR', 'COMMERCIAL_HUB'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.158, "o", "        ['CAMPUS', 'HARBOR', 'THEATER_SQUARE', 'COMMERCIAL_HUB'],\r\n\u001b[?2004l\r\u001b[?2004h>         ['CAMPUS', 'HOLY_SITE', 'THEATER_SQUARE', 'COMMERCIAL_HUB'],\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.158212, "o", ">     for district_types in district_types_to_try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.158276, "o", "        # For each district type, find best location\r\n\u001b[?2004l\r\u001b[?2004h> "]
