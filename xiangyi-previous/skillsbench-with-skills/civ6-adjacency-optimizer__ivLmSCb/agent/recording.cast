[221.118821, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\nfrom itertools import combinations\n\n# Load map data\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\ncursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\nplots_data = cursor.fetchall()\n\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\n\nconn.close()\n\n# Build terrain map\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': features.get(plot_id, None)\n    }\n\ndef get_neighbors(x, y):\n    if y % 2 == 0:\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x-1, y-1), (x, y-1),\n            (x-1, y+1), (x, y+1)\n        ]\n    else:\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x, y-1), (x+1, y-1),\n            (x, y+1), (x+1, y+1)\n        ]\n    return [(nx, ny) for nx, ny in neighbors if (nx, ny) in terrain_map]\n\ndef is_valid_placement(x, y):\n    if (x, y) not in terrain_map:\n        return False\n    tile = terrain_map[(x, y)]\n    if 'OCEAN' in tile['terrain'] or 'COAST' in tile['terrain']:\n        return False\n    if 'MOUNTAIN' in tile['terrain']:\n        return False\n    if tile['impassable']:\n        return False\n    return True\n\ndef is_harbor_valid(x, y):\n    if (x, y) not in terrain_map:\n        return False\n    tile = terrain_map[(x, y)]\n    return 'COAST' in tile['terrain']\n\ndef calculate_bonus(district_type, x, y, placed_districts, city_center):\n    neighbors = get_neighbors(x, y)\n    bonus = 0\n    \n    if district_type == 'CAMPUS':\n        for nx, ny in neighbors:\n            ntile = terrain_map[(nx, ny)]\n            if 'MOUNTAIN' in ntile['terrain']:\n                bonus += 1\n            if ntile['feature'] == 'FEATURE_GEOTHERMAL_FISSURE':\n                bonus += 1\n            if ntile['feature'] == 'FEATURE_REEF':\n                bonus += 1\n        jungle_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] in ['FEATURE_JUNGLE', 'FEATURE_MARSH'])\n        bonus += jungle_count // 2\n    \n    elif district_type == 'HOLY_SITE':\n        for nx, ny in neighbors:\n            ntile = terrain_map[(nx, ny)]\n            if 'MOUNTAIN' in ntile['terrain']:\n                bonus += 1\n        woods_count = sum(1 for nx, ny in neighbors if terrain_map[(nx, ny)]['feature'] == 'FEATURE_FOREST')\n        bonus += woods_count // 2\n    \n    elif district_type == 'HARBOR':\n        if city_center in neighbors:\n            bonus += 2\n        for nx, ny in neighbors:\n            ntile = terrain_map[(nx, ny)]\n            if ntile['feature'] == 'FEATURE_REEF':\n                bonus += 1\n    \n    elif district_type == 'THEATER_SQUARE':\n        district_count = sum(1 for nx, ny in neighbors if (nx, ny) in placed_districts and placed_districts[(nx, ny)] != 'THEATER_SQUARE')\n        bonus += district_count // 2\n    \n    elif district_type == 'COMMERCIAL_HUB':\n        harbor_count = sum(1 for nx, ny in neighbors if placed_districts.get((nx, ny)) == 'HARBOR')\n        bonus += harbor_count * 2\n    \n    return bonus\n\n# Try to find better combinations\nvalid_tiles = [(x, y) for x, y in terrain_map.keys() if is_valid_placement(x, y)]\n\nprint(\"Searching for better combinations...\")\n\n# Focus on city center at (20, 13) which seems good, but try others too\nbest_total = 9  # Current best\nbest_solution = None\n\nfor city_center in valid_tiles[:10]:  # Try first 10 valid tiles as city center\n    cx, cy = city_center\n    \n    # Get potential district locations\n    candidates = []\n    for x, y in valid_tiles:\n        if (x, y) != city_center:\n            # Check if within reasonable range\n            if abs(x - cx) <= 3 and abs(y - cy) <= 3:\n                candidates.append((x, y))\n    \n    # Add harbor candidates\n    harbor_candidates = []\n    for x, y in terrain_map.ke"]
[221.119001, "i", "ys():\n        if is_harbor_valid(x, y) and (x, y) != city_center:\n            if abs(x - cx) <= 3 and abs(y - cy) <= 3:\n                if city_center in get_neighbors(x, y):\n                    harbor_candidates.append((x, y))\n    \n    # Try different district type combinations\n    district_types_to_try = [\n        ['CAMPUS', 'HOLY_SITE', 'HARBOR', 'THEATER_SQUARE'],\n        ['CAMPUS', 'HOLY_SITE', 'HARBOR', 'COMMERCIAL_HUB'],\n        ['CAMPUS', 'HARBOR', 'THEATER_SQUARE', 'COMMERCIAL_HUB'],\n        ['CAMPUS', 'HOLY_SITE', 'THEATER_SQUARE', 'COMMERCIAL_HUB'],\n    ]\n    \n    for district_types in district_types_to_try:\n        # For each district type, find best location\n        best_placements = {}\n        \n        for dtype in district_types:\n            best_loc = None\n            best_score = -1\n            \n            locs_to_check = harbor_candidates if dtype == 'HARBOR' else candidates\n            \n            for loc in locs_to_check:\n                if loc not in best_placements.values():\n                    score = calculate_bonus(dtype, loc[0], loc[1], best_placements, city_center)\n                    if score > best_score:\n                        best_score = score\n                        best_loc = loc\n            \n            if best_loc:\n                best_placements[dtype] = best_loc\n        \n        # Calculate total with proper theater square bonus\n        placed_districts = {loc: dtype for dtype, loc in best_placements.items()}\n        total = 0\n        details = []\n        for dtype, loc in best_placements.items():\n            bonus = calculate_bonus(dtype, loc[0], loc[1], placed_districts, city_center)\n            total += bonus\n            details.append((dtype, loc, bonus))\n        \n        if total > best_total:\n            best_total = total\n            best_solution = {\n                'city_center': list(city_center),\n                'districts': details\n            }\n            print(f\"New best: {total} at city center {city_center}\")\n            for dtype, loc, bonus in details:\n                print(f\"  {dtype}: {loc} = {bonus}\")\n\nif best_solution:\n    print(f\"\\nBest solution:\")\n    print(f\"City center: {best_solution['city_center']}\")\n    print(f\"Total: {best_total}\")\n    for dtype, loc, bonus in best_solution['districts']:\n        print(f\"  {dtype}: {loc} = {bonus}\")\nelse:\n    print(\"No better solution found, keeping current one.\")\n\nEOF\n"]
