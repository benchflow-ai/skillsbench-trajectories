[54.703663, "i", "python3 << 'EOF'\nimport sqlite3\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get PlotFeatures structure and data\ncursor.execute(\"PRAGMA table_info(PlotFeatures);\")\ncolumns = cursor.fetchall()\nprint(\"PlotFeatures columns:\")\nfor col in columns:\n    print(f\"  {col}\")\n\ncursor.execute(\"SELECT * FROM PlotFeatures LIMIT 20;\")\nfeatures = cursor.fetchall()\nprint(\"\\nSample plot features:\")\nfor feat in features:\n    print(f\"  {feat}\")\n\n# Get PlotResources\ncursor.execute(\"SELECT * FROM PlotResources LIMIT 20;\")\nresources = cursor.fetchall()\nprint(\"\\nSample plot resources:\")\nfor res in resources:\n    print(f\"  {res}\")\n\nconn.close()\nEOF\n"]
