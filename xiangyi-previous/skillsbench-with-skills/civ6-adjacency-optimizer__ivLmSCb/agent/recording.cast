[66.568892, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get map dimensions\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\nprint(f\"Map size: {width}x{height}\")\n\n# Load all plots\ncursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\nplots_data = cursor.fetchall()\nprint(f\"Total plots: {len(plots_data)}\")\n\n# Load all features\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\nprint(f\"Total features: {len(features)}\")\n\n# Create map grid\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': features.get(plot_id, None)\n    }\n\n# Count terrain types\nterrain_counts = {}\nfor tile in terrain_map.values():\n    t = tile['terrain']\n    terrain_counts[t] = terrain_counts.get(t, 0) + 1\n\nprint(\"\\nTerrain distribution:\")\nfor terrain, count in sorted(terrain_counts.items()):\n    print(f\"  {terrain}: {count}\")\n\n# Count features\nfeature_counts = {}\nfor tile in terrain_map.values():\n    f = tile['feature']\n    if f:\n        feature_counts[f] = feature_counts.get(f, 0) + 1\n\nprint(\"\\nFeature distribution:\")\nfor feature, count in sorted(feature_counts.items()):\n    print(f\"  {feature}: {count}\")\n\nconn.close()\nEOF\n"]
