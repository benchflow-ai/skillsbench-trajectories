[77.669529, "i", "python3 << 'EOF'\nimport sqlite3\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get map dimensions\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\n# Load all plots\ncursor.execute(\"SELECT ID, TerrainType, IsImpassable FROM Plots;\")\nplots_data = cursor.fetchall()\n\n# Load all features\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures;\")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\n\n# Create map grid\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': features.get(plot_id, None)\n    }\n\n# Find land tiles (non-ocean, non-coast)\nland_tiles = []\nfor (x, y), tile in terrain_map.items():\n    if 'OCEAN' not in tile['terrain'] and 'COAST' not in tile['terrain']:\n        land_tiles.append((x, y, tile))\n\nprint(f\"Found {len(land_tiles)} land tiles:\")\nfor x, y, tile in sorted(land_tiles):\n    print(f\"  ({x:2d}, {y:2d}): {tile['terrain']:30s} {tile['feature'] or ''}\")\n\nconn.close()\nEOF\n"]
