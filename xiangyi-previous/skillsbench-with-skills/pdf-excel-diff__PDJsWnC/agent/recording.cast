[57.6823, "i", "python3 - <<'PY'\nimport pdfplumber, pandas as pd, json, re\npdf_path='/root/employees_backup.pdf'\nrows=[]\nheader=None\nwith pdfplumber.open(pdf_path) as pdf:\n    for page in pdf.pages:\n        tables = page.extract_tables()\n        for t in tables:\n            if not t: continue\n            if header is None:\n                header = t[0]\n            # assume first row header if matches\n            start = 1 if t and t[0] and t[0][0]=='ID' else 0\n            for row in t[start:]:\n                if not row: continue\n                if row[0] and row[0].startswith('EMP'):\n                    rows.append(row)\n\nold_df = pd.DataFrame(rows, columns=header)\n\n# Load current excel\ncur_df = pd.read_excel('/root/employees_current.xlsx')\n\nprint('old rows', len(old_df), 'cur rows', len(cur_df))\nprint('old columns', old_df.columns)\nprint('cur columns', cur_df.columns)\n\n# normalize columns: strip whitespace\nold_df.columns = [c.strip() for c in old_df.columns]\ncur_df.columns = [c.strip() for c in cur_df.columns]\n\n# Ensure ID column name 'ID'\n\n# Clean numeric fields\nnum_fields = ['Salary','Years','Score']\nfor df in [old_df, cur_df]:\n    for field in num_fields:\n        if field in df.columns:\n            # remove commas and convert\n            df[field] = df[field].astype(str).str.replace(',','', regex=False)\n            # handle blanks\n            df[field] = pd.to_numeric(df[field], errors='coerce')\n\n# Convert other fields to string for comparison\nfor df in [old_df, cur_df]:\n    for col in df.columns:\n        if col not in num_fields:\n            df[col] = df[col].astype(str)\n\n# Build dicts keyed by ID\nold_dict = old_df.set_index('ID').to_dict(orient='index')\ncur_dict = cur_df.set_index('ID').to_dict(orient='index')\n\nold_ids = set(old_dict)\ncur_ids = set(cur_dict)\n\ndeleted = sorted(old_ids - cur_ids)\n\nmodified = []\nfor emp_id in sorted(old_ids & cur_ids):\n    old_rec = old_dict[emp_id]\n    new_rec = cur_dict[emp_id]\n    for field in old_df.columns:\n        if field == 'ID':\n            continue\n        old_val = old_rec.get(field)\n        new_val = new_rec.get(field)\n        # compare with NaN handling\n        if pd.isna(old_val) and pd.isna(new_val):\n            continue\n        if isinstance(old_val, float) and isinstance(new_val, float):\n            # compare numeric\n            if pd.isna(old_val) and pd.isna(new_val):\n                continue\n        if old_val != new_val:\n            # cast values for json: numbers as int if integer\n            def cast(v):\n                if pd.isna(v):\n                    return None\n                if isinstance(v, (int, float)):\n                    # check if integer-valued\n                    if isinstance(v, float) and v.is_integer():\n                        return int(v)\n                    return float(v) if isinstance(v, float) else v\n                return v\n            modified.append({\n                'id': emp_id,\n                'field': field,\n                'old_value': cast(old_val),\n                'new_value': cast(new_val)\n            })\n\n# sort modified by id then field\nmodified = sorted(modified, key=lambda x: (x['id'], x['field']))\n\nreport = {\n    'deleted_employees': deleted,\n    'modified_employees': modified\n}\n\nwith open('/root/diff_report.json','w') as f:\n    json.dump(report, f, indent=2)\n\nprint('deleted', deleted[:5], 'modified count', len(modified))\nPY\n"]
