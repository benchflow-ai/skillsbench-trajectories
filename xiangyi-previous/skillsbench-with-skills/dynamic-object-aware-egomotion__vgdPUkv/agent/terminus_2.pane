[0m[?2004hroot@dd9d9bcf7bee:~# cat > analyze_video.py << 'EOF'
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.sparse import csr_matrix
[?2004l[?2004h> 
[?2004l[[?2004h> def get_video_info(video_path):
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     fps = cap.get(cv2.CAP_PROP_FPS)
[?2004l[?2004h>     total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
[?2004l[?2004h>     width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
[?2004l[?2004h>     height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     return fps, total_frames, width, height
[?2004l[?2004h> 
[?2004l[?2004h> def sample_frames(video_path, target_fps=6):
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     original_fps = cap.get(cv2.CAP_PROP_FPS)
[?2004l[?2004h>     frame_interval = int(original_fps / target_fps)
[?2004l[?2004h>     
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     frame_idx = 0
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, frame = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         if frame_idx % frame_interval == 0:
[?2004l[?2004h>             frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))
[?2004l[?2004h>         frame_idx += 1
[?2004l[?2004h>     
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     return frames
[?2004l[?2004h> 
[?2004l[?2004h> def compute_optical_flow(prev_frame, curr_frame):
[?2004l[?2004h>     flow = cv2.calcOpticalFlowFarneback(
[?2004l[?2004h>         prev_frame, curr_frame, None,
[?2004l[?2004h>         pyr_scale=0.5, levels=3, winsize=15,
[?2004l[?2004h>         iterations=3, poly_n=5, poly_sigma=1.2, flags=0
[?2004l[?2004h>     )
[?2004l[?2004h>     return flow
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_camera_motion(flow):
[?2004l[?2004h>     # Compute flow statistics
[?2004l[?2004h>     flow_x = flow[:, :, 0]
[?2004l[?2004h>     flow_y = flow[:, :, 1]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use median to be robust to outliers (dynamic objects)
[?2004l[?2004h>     median_x = np.median(flow_x)
[?2004l[?2004h>     median_y = np.median(flow_y)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute flow magnitude
[?2004l[?2004h>     mag = np.sqrt(median_x**2 + median_y**2)
[?2004l[?2004h>     
[?2004l[?2004h>     motions = []
[?2004l[?2004h>     threshold = 0.5
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect horizontal motion (Pan)
[?2004l[?2004h>     if abs(median_x) > threshold:
[?2004l[?2004h>         if median_x > 0:
[?2004l[?2004h>             motions.append("Pan Right")
[?2004l[?2004h>         else:
[?2004l[?2004h>             motions.append("Pan Left")
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect vertical motion (Tilt)
[?2004l[?2004h>     if abs(median_y) > threshold:
[?2004l[?2004h>         if median_y > 0:
[?2004l[?2004h>             motions.append("Tilt Down")
[?2004l[?2004h>         else:
[?2004l[?2004h>             motions.append("Tilt Up")
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect zoom (Dolly) - check if flow is radial
[?2004l[?2004h>     h, w = flow.shape[:2]
[?2004l[?2004h>     cy, cx = h // 2, w // 2
[?2004l[?2004h>     y_coords, x_coords = np.mgrid[0:h, 0:w]
[?2004l[?2004h>     dx = x_coords - cx
[?2004l[?2004h>     dy = y_coords - cy
[?2004l[?2004h>     
[?2004l[?2004h>     # Expected radial flow for zoom
[?2004l[?2004h>     expected_mag = np.sqrt(dx**2 + dy**2)
[?2004l[?2004h>     mask = expected_mag > 10
[?2004l[?2004h>     if mask.sum() > 0:
[?2004l[?2004h>         radial_flow = (flow_x * dx + flow_y * dy) / (expected_mag + 1e-6)
[?2004l[?2004h>         avg_radial = np.median(radial_flow[mask])
[?2004l[?2004h>         
[?2004l[?2004h>         if abs(avg_radial) > 0.3:
[?2004l[?2004h>             if avg_radial > 0:
[?2004l[?2004h>                 motions.append("Dolly Out")
[?2004l[?2004h>             else:
[?2004l[?2004h>                 motions.append("Dolly In")
[?2004l[?2004h>     
[?2004l[?2004h>     # If no significant motion detected
[?2004l[?2004h>     if len(motions) == 0:
[?2004l[?2004h>         motions.append("Stay")
[?2004l[?2004h>     
[?2004l[?2004h>     return motions
[?2004l[?2004h> 
[?2004l[?2004h> def detect_dynamic_objects(flow, threshold_ratio=2.0):
[?2004l[?2004h>     # Compute flow magnitude
[?2004l[?2004h>     mag = np.sqrt(flow[:, :, 0]**2 + flow[:, :, 1]**2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Global median flow (camera motion)
[?2004l[?2004h>     median_mag = np.median(mag)
[?2004l[?2004h>     
[?2004l[?2004h>     # Dynamic objects have significantly different motion
[?2004l[?2004h>     dynamic_mask = mag > (median_mag * threshold_ratio + 1.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Clean up small regions
[?2004l[?2004h>     kernel = np.ones((5, 5), np.uint8)
[?2004l[?2004h>     dynamic_mask = cv2.morphologyEx(dynamic_mask.astype(np.uint8), cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>     dynamic_mask = cv2.morphologyEx(dynamic_mask, cv2.MORPH_CLOSE, kernel)
[?2004l[?2004h>     
[?2004l[?2004h>     return dynamic_mask.astype(bool)
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     video_path = '/root/input.mp4'
[?2004l[?2004h>     target_fps = 6
[?2004l[?2004h>     
[?2004l[?2004h>     print("Sampling video frames...")
[?2004l[?2004h>     frames = sample_frames(video_path, target_fps)
[?2004l[?2004h>     print(f"Sampled {len(frames)} frames")
[?2004l[?2004h>     
[?2004l[?2004h>     if len(frames) == 0:
[?2004l[?2004h>         print("No frames extracted!")
[?2004l[?2004h>         return
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize results
[?2004l[?2004h>     instructions = {}
[?2004l[?2004h>     masks_data = {}
[?2004l[?2004h>     
[?2004l[?2004h>     h, w = frames[0].shape
[?2004l[?2004h>     masks_data['shape'] = [h, w]
[?2004l[?2004h>     
[?2004l[?2004h>     # First frame has no motion
[?2004l[?2004h>     first_mask = np.zeros((h, w), dtype=bool)
[?2004l[?2004h>     sparse_mask = csr_matrix(first_mask)
[?2004l[?2004h>     masks_data['f_0_data'] = sparse_mask.data
[?2004l[?2004h>     masks_data['f_0_indices'] = sparse_mask.indices
[?2004l[?2004h>     masks_data['f_0_indptr'] = sparse_mask.indptr
[?2004l[?2004h>     
[?2004l[?2004h>     # Process frame pairs
[?2004l[?2004h>     for i in range(len(frames) - 1):
[?2004l[?2004h>         print(f"Processing frames {i} -> {i+1}...")
[?2004l[?2004h>         
[?2004l[?2004h>         prev_frame = frames[i]
[?2004l[?2004h>         curr_frame = frames[i + 1]
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute optical flow
[?2004l[?2004h>         flow = compute_optical_flow(prev_frame, curr_frame)
[?2004l[?2004h>         
[?2004l[?2004h>         # Analyze camera motion
[?2004l[?2004h>         motions = analyze_camera_motion(flow)
[?2004l[?2004h>         instructions[f"{i}->{i+1}"] = motions
[?2004l[?2004h>         
[?2004l[?2004h>         # Detect dynamic objects
[?2004l[?2004h>         dynamic_mask = detect_dynamic_objects(flow)
[?2004l[?2004h>         
[?2004l[?2004h>         # Store mask in CSR format
[?2004l[?2004h>         sparse_mask = csr_matrix(dynamic_mask)
[?2004l[?2004h>         masks_data[f'f_{i+1}_data'] = sparse_mask.data
[?2004l[?2004h>         masks_data[f'f_{i+1}_indices'] = sparse_mask.indices
[?2004l[?2004h>         masks_data[f'f_{i+1}_indptr'] = sparse_mask.indptr
[?2004l[?2004h>     
[?2004l[?2004h>     # Save instructions to JSON
[?2004l[?2004h>     print("Saving instructions...")
[?2004l[?2004h>     with open('/root/pred_instructions.json', 'w') as f:
[?2004l[?2004h>         json.dump(instructions, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Save masks to NPZ
[?2004l[?2004h>     print("Saving dynamic masks...")
[?2004l[?2004h>     np.savez('/root/pred_dyn_masks.npz', **masks_data)
[?2004l[?2004h>     
[?2004l[?2004h>     print("Done!")
[?2004l[?2004h>     print(f"Generated {len(instructions)} motion instructions")
[?2004l[?2004h>     print(f"Generated {len(frames)} frame masks")
