[37.409516, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[37.494479, "o", "\u001b[?2004hroot@dd9d9bcf7bee:~# "]
[75.257961, "i", "cat > analyze_video.py << 'EOF'\nimport cv2\nimport numpy as np\nimport json\nfrom scipy.sparse import csr_matrix\n\ndef get_video_info(video_path):\n    cap = cv2.VideoCapture(video_path)\n    fps = cap.get(cv2.CAP_PROP_FPS)\n    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n    cap.release()\n    return fps, total_frames, width, height\n\ndef sample_frames(video_path, target_fps=6):\n    cap = cv2.VideoCapture(video_path)\n    original_fps = cap.get(cv2.CAP_PROP_FPS)\n    frame_interval = int(original_fps / target_fps)\n    \n    frames = []\n    frame_idx = 0\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        if frame_idx % frame_interval == 0:\n            frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))\n        frame_idx += 1\n    \n    cap.release()\n    return frames\n\ndef compute_optical_flow(prev_frame, curr_frame):\n    flow = cv2.calcOpticalFlowFarneback(\n        prev_frame, curr_frame, None,\n        pyr_scale=0.5, levels=3, winsize=15,\n        iterations=3, poly_n=5, poly_sigma=1.2, flags=0\n    )\n    return flow\n\ndef analyze_camera_motion(flow):\n    # Compute flow statistics\n    flow_x = flow[:, :, 0]\n    flow_y = flow[:, :, 1]\n    \n    # Use median to be robust to outliers (dynamic objects)\n    median_x = np.median(flow_x)\n    median_y = np.median(flow_y)\n    \n    # Compute flow magnitude\n    mag = np.sqrt(median_x**2 + median_y**2)\n    \n    motions = []\n    threshold = 0.5\n    \n    # Detect horizontal motion (Pan)\n    if abs(median_x) > threshold:\n        if median_x > 0:\n            motions.append(\"Pan Right\")\n        else:\n            motions.append(\"Pan Left\")\n    \n    # Detect vertical motion (Tilt)\n    if abs(median_y) > threshold:\n        if median_y > 0:\n            motions.append(\"Tilt Down\")\n        else:\n            motions.append(\"Tilt Up\")\n    \n    # Detect zoom (Dolly) - check if flow is radial\n    h, w = flow.shape[:2]\n    cy, cx = h // 2, w // 2\n    y_coords, x_coords = np.mgrid[0:h, 0:w]\n    dx = x_coords - cx\n    dy = y_coords - cy\n    \n    # Expected radial flow for zoom\n    expected_mag = np.sqrt(dx**2 + dy**2)\n    mask = expected_mag > 10\n    if mask.sum() > 0:\n        radial_flow = (flow_x * dx + flow_y * dy) / (expected_mag + 1e-6)\n        avg_radial = np.median(radial_flow[mask])\n        \n        if abs(avg_radial) > 0.3:\n            if avg_radial > 0:\n                motions.append(\"Dolly Out\")\n            else:\n                motions.append(\"Dolly In\")\n    \n    # If no significant motion detected\n    if len(motions) == 0:\n        motions.append(\"Stay\")\n    \n    return motions\n\ndef detect_dynamic_objects(flow, threshold_ratio=2.0):\n    # Compute flow magnitude\n    mag = np.sqrt(flow[:, :, 0]**2 + flow[:, :, 1]**2)\n    \n    # Global median flow (camera motion)\n    median_mag = np.median(mag)\n    \n    # Dynamic objects have significantly different motion\n    dynamic_mask = mag > (median_mag * threshold_ratio + 1.0)\n    \n    # Clean up small regions\n    kernel = np.ones((5, 5), np.uint8)\n    dynamic_mask = cv2.morphologyEx(dynamic_mask.astype(np.uint8), cv2.MORPH_OPEN, kernel)\n    dynamic_mask = cv2.morphologyEx(dynamic_mask, cv2.MORPH_CLOSE, kernel)\n    \n    return dynamic_mask.astype(bool)\n\ndef main():\n    video_path = '/root/input.mp4'\n    target_fps = 6\n    \n    print(\"Sampling video frames...\")\n    frames = sample_frames(video_path, target_fps)\n    print(f\"Sampled {len(frames)} frames\")\n    \n    if len(frames) == 0:\n        print(\"No frames extracted!\")\n        return\n    \n    # Initialize results\n    instructions = {}\n    masks_data = {}\n    \n    h, w = frames[0].shape\n    masks_data['shape'] = [h, w]\n    \n    # First frame has no motion\n    first_mask = np.zeros((h, w), dtype=bool)\n    sparse_mask = csr_matrix(first_mask)\n    masks_data['f_0_data'] = sparse_mask.data\n    masks_data['f_0_indices'] = sparse_mask.indices\n    masks_data['f_0_indptr'] = sparse_mask.indptr\n    \n    # Process frame pairs\n    for i in range(len(frames) - 1):\n        p"]
[75.258139, "i", "rint(f\"Processing frames {i} -> {i+1}...\")\n        \n        prev_frame = frames[i]\n        curr_frame = frames[i + 1]\n        \n        # Compute optical flow\n        flow = compute_optical_flow(prev_frame, curr_frame)\n        \n        # Analyze camera motion\n        motions = analyze_camera_motion(flow)\n        instructions[f\"{i}->{i+1}\"] = motions\n        \n        # Detect dynamic objects\n        dynamic_mask = detect_dynamic_objects(flow)\n        \n        # Store mask in CSR format\n        sparse_mask = csr_matrix(dynamic_mask)\n        masks_data[f'f_{i+1}_data'] = sparse_mask.data\n        masks_data[f'f_{i+1}_indices'] = sparse_mask.indices\n        masks_data[f'f_{i+1}_indptr'] = sparse_mask.indptr\n    \n    # Save instructions to JSON\n    print(\"Saving instructions...\")\n    with open('/root/pred_instructions.json', 'w') as f:\n        json.dump(instructions, f, indent=2)\n    \n    # Save masks to NPZ\n    print(\"Saving dynamic masks...\")\n    np.savez('/root/pred_dyn_masks.npz', **masks_data)\n    \n    print(\"Done!\")\n    print(f\"Generated {len(instructions)} motion instructions\")\n    print(f\"Generated {len(frames)} frame masks\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
