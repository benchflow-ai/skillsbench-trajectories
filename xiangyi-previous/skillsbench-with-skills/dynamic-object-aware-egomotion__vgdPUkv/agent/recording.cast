[124.52887, "o", "cat /root/pred_instructions.json\r\n\u001b[?2004l\r"]
[124.536897, "o", "{\r\n  \"0->1\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"1->2\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"2->3\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"3->4\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"4->5\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"5->6\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"6->7\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"7->8\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"8->9\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"9->10\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"10->11\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"11->12\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"12->13\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"13->14\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"14->15\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"15->16\": [\r\n    \"Dolly Out\"\r\n  ],\r\n  \"16->17\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"17->18\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"18->19\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"19->20\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ]\r\n}\u001b[?2004hroot@dd9d9bcf7bee:~# "]
