[116.890489, "o", "head -30 /root/pred_instructions.json\r\n\u001b[?2004l\r"]
[116.896206, "o", "{\r\n  \"0->1\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"1->2\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"2->3\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"3->4\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"4->5\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"5->6\": [\r\n    \"Pan Left\",\r\n    \"Dolly Out\"\r\n  ],\r\n  \"6->7\": [\r\n    \"Pan Left\",\r\n    \"Tilt Down\",\r\n"]
[116.896436, "o", "\u001b[?2004hroot@dd9d9bcf7bee:~# "]
