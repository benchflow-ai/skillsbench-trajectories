[75.266253, "o", "        if abs(avg_radial) > 0.3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266321, "o", "            if avg_radial > 0:\r\n\u001b[?2004l\r"]
[75.266377, "o", "\u001b[?2004h> "]
[75.266446, "o", "                motions.append(\"Dolly Out\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266495, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266557, "o", "                motions.append(\"Dolly In\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.26661, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.26667, "o", "    # If no significant motion detected\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266725, "o", "    if len(motions) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266789, "o", "        motions.append(\"Stay\")\r\n\u001b[?2004l\r"]
[75.266844, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266912, "o", "    return motions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.266981, "o", "def detect_dynamic_objects(flow, threshold_ratio=2.0):\r\n\u001b[?2004l\r"]
[75.26704, "o", "\u001b[?2004h> "]
[75.267065, "o", "    # Compute flow magnitude\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.267146, "o", "    mag = np.sqrt(flow[:, :, 0]**2 + flow[:, :, 1]**2)\r\n\u001b[?2004l\r"]
[75.267205, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[75.267253, "o", "\u001b[?2004h> "]
[75.267311, "o", "    # Global median flow (camera motion)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.26736, "o", "    median_mag = np.median(mag)\r\n\u001b[?2004l\r"]
[75.26743, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.267488, "o", "    # Dynamic objects have significantly different motion\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.267543, "o", "> "]
[75.267781, "o", "    dynamic_mask = mag > (median_mag * threshold_ratio + 1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Clean up small regions\r\n\u001b[?2004l\r\u001b[?2004h>     kernel = np.ones((5, 5), np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.267803, "o", "> "]
[75.267916, "o", "    dynamic_mask = cv2.morphologyEx(dynamic_mask.astype(np.uint8), cv2.MORPH_OPEN, kernel)\r\n\u001b[?2004l\r"]
[75.267938, "o", "\u001b[?2004h> "]
[75.268066, "o", "    dynamic_mask = cv2.morphologyEx(dynamic_mask, cv2.MORPH_CLOSE, kernel)\r\n\u001b[?2004l\r"]
[75.268089, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[75.26811, "o", "\u001b[?2004h> "]
[75.268173, "o", "    return dynamic_mask.astype(bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.268206, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.268229, "o", "def main():\r\n\u001b[?2004l\r"]
[75.268251, "o", "\u001b[?2004h> "]
[75.268308, "o", "    video_path = '/root/input.mp4'\r\n\u001b[?2004l\r"]
[75.268334, "o", "\u001b[?2004h> "]
[75.268369, "o", "    target_fps = 6\r\n\u001b[?2004l\r"]
[75.268401, "o", "\u001b[?2004h> "]
[75.268421, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.268493, "o", "    print(\"Sampling video frames...\")\r\n\u001b[?2004l\r"]
[75.268513, "o", "\u001b[?2004h> "]
[75.268608, "o", "    frames = sample_frames(video_path, target_fps)\r\n\u001b[?2004l\r"]
[75.268629, "o", "\u001b[?2004h> "]
[75.268705, "o", "    print(f\"Sampled {len(frames)} frames\")\r\n\u001b[?2004l\r"]
[75.268727, "o", "\u001b[?2004h>     \r\n"]
[75.268749, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[75.268818, "o", "    if len(frames) == 0:\r\n\u001b[?2004l\r"]
[75.268891, "o", "\u001b[?2004h> "]
[75.268917, "o", "        print(\"No frames extracted!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.268946, "o", "        return\r\n\u001b[?2004l\r"]
[75.269409, "o", "\u001b[?2004h> "]
[75.269436, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Initialize results\r\n\u001b[?2004l\r\u001b[?2004h>     instructions = {}\r\n\u001b[?2004l\r\u001b[?2004h>     masks_data = {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     h, w = frames[0].shape\r\n\u001b[?2004l\r\u001b[?2004h>     masks_data['shape'] = [h, w]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # First frame has no motion\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.269495, "o", "    first_mask = np.zeros((h, w), dtype=bool)\r\n\u001b[?2004l\r"]
[75.269517, "o", "\u001b[?2004h> "]
[75.269589, "o", "    sparse_mask = csr_matrix(first_mask)\r\n\u001b[?2004l\r"]
[75.269618, "o", "\u001b[?2004h> "]
[75.269813, "o", "    masks_data['f_0_data'] = sparse_mask.data\r\n\u001b[?2004l\r"]
[75.269843, "o", "\u001b[?2004h>     masks_data['f_0_indices'] = sparse_mask.indices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.269895, "o", "    masks_data['f_0_indptr'] = sparse_mask.indptr\r\n\u001b[?2004l\r"]
[75.269921, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[75.270021, "o", "\u001b[?2004h> "]
[75.270054, "o", "    # Process frame pairs\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(frames) - 1):"]
[75.270074, "o", "\r\n\u001b[?2004l\r"]
[75.270159, "o", "\u001b[?2004h> "]
[75.270183, "o", "        print(f\"Processing frames {i} -> {i+1}...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.270244, "o", "> "]
[75.270269, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270337, "o", "        prev_frame = frames[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270389, "o", "        curr_frame = frames[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270457, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270507, "o", "        # Compute optical flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270586, "o", "        flow = compute_optical_flow(prev_frame, curr_frame)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.270635, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270684, "o", "        # Analyze camera motion\r\n\u001b[?2004l\r"]
[75.270742, "o", "\u001b[?2004h> "]
[75.270806, "o", "        motions = analyze_camera_motion(flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270872, "o", "        instructions[f\"{i}->{i+1}\"] = motions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270931, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.270989, "o", "        # Detect dynamic objects\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.271047, "o", "> "]
[75.271097, "o", "        dynamic_mask = detect_dynamic_objects(flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.271152, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.271209, "o", "        # Store mask in CSR format\r\n\u001b[?2004l\r"]
[75.271265, "o", "\u001b[?2004h> "]
[75.27132, "o", "        sparse_mask = csr_matrix(dynamic_mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.271374, "o", "> "]
[75.271431, "o", "        masks_data[f'f_{i+1}_data'] = sparse_mask.data\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.271487, "o", "> "]
[75.271516, "o", "        masks_data[f'f_{i+1}_indices'] = sparse_mask.indices\r\n\u001b[?2004l\r"]
[75.27159, "o", "\u001b[?2004h> "]
[75.271657, "o", "        masks_data[f'f_{i+1}_indptr'] = sparse_mask.indptr\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.271712, "o", ">     \r\n\u001b[?2004l\r"]
[75.271738, "o", "\u001b[?2004h> "]
[75.271811, "o", "    # Save instructions to JSON\r\n\u001b[?2004l\r"]
[75.271836, "o", "\u001b[?2004h>     print(\"Saving instructions...\")"]
[75.271896, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.271963, "o", "    with open('/root/pred_instructions.json', 'w') as f:\r\n\u001b[?2004l\r"]
[75.272017, "o", "\u001b[?2004h> "]
[75.272072, "o", "        json.dump(instructions, f, indent=2)\r\n\u001b[?2004l\r"]
[75.272129, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.27218, "o", ">     # Save masks to NPZ\r\n\u001b[?2004l\r"]
[75.272229, "o", "\u001b[?2004h> "]
[75.272288, "o", "    print(\"Saving dynamic masks...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.272354, "o", "    np.savez('/root/pred_dyn_masks.npz', **masks_data)\r\n\u001b[?2004l\r"]
[75.272409, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[75.272461, "o", "\u001b[?2004h>     print(\"Done!\")\r\n"]
[75.272515, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[75.272571, "o", "    print(f\"Generated {len(instructions)} motion instructions\")\r\n\u001b[?2004l\r"]
[75.272627, "o", "\u001b[?2004h> "]
[75.272678, "o", "    print(f\"Generated {len(frames)} frame masks\")\r\n\u001b[?2004l\r"]
[75.272731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.272801, "o", "\u001b[?2004h> "]
[75.272867, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.272925, "o", "> EOF\r\n\u001b[?2004l\r"]
[75.274033, "o", "\u001b[?2004hroot@dd9d9bcf7bee:~# "]
[81.571405, "i", "python3 analyze_video.py\n"]
[81.571669, "o", "python3 analyze_video.py\r\n\u001b[?2004l\r"]
