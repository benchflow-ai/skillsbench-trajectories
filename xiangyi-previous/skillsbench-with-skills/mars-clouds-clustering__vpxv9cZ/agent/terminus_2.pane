[?2004hroot@e1b82849fd7b:~# cat > /root/optimize_dbscan.py << 'EOF'
[?2004lelta = np.nanmean(deltas) if deltas els[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.cluster import DBSCAN
[?2004l[?2004h> from itertools import product
[?2004l[?2004h> from multiprocessing import Pool, cpu_count
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l [?2004h> # Load data
[?2004l[?2004h> citsci = pd.read_csv('/root/data/citsci_train.csv', usecols=['file_rad', 'x', 'y'])
[?2004l[?2004h> expert = pd.read_csv('/root/data/expert_train.csv', usecols=['file_rad', 'x', 'y'])
[?2004l[?2004h> 
[?2004l[?2004h> # Get unique images from expert dataset
[?2004l[?2004h> unique_images = expert['file_rad'].unique()
[?2004l[?2004h> 
[?2004l[?2004h> # Group data by file_rad for faster lookup
[?2004l[?2004h> citsci_grouped = {k: v[['x', 'y']].values for k, v in citsci.groupby('file_rad')}
[?2004l[?2004h> expert_grouped = {k: v[['x', 'y']].values for k, v in expert.groupby('file_rad')}
[?2004l[?2004h> 
[?2004l[?2004h> def custom_metric(a, b, w):
[?2004l[?2004h>     """Custom distance metric: d = sqrt((w*dx)^2 + ((2-w)*dy)^2)"""
[?2004l[?2004h>     dx = a[0] - b[0]
[?2004l[?2004h>     dy = a[1] - b[1]
[?2004l[?2004h>     return np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)
[?2004l[?2004h> 
[?2004l[?2004h> def greedy_match(centroids, expert_pts, max_dist=100):
[?2004l[?2004h>     """Greedy matching: closest pairs first, max distance 100 pixels (standard Euclidean)"""
[?2004l[?2004h>     if len(centroids) == 0 or len(expert_pts) == 0:
[?2004l[?2004h>         return [], 0, 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute all pairwise distances (standard Euclidean)
[?2004l[?2004h>     dists = np.sqrt(((centroids[:, np.newaxis, :] - expert_pts[np.newaxis, :, :])**2).sum(axis=2))
[?2004l[?2004h>     
[?2004l[?2004h>     matches = []
[?2004l[?2004h>     matched_centroids = set()
[?2004l[?2004h>     matched_experts = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Flatten and sort by distance
[?2004l[?2004h>     flat_indices = np.argsort(dists.ravel())
[?2004lar[?2004h>     
[?2004l[?2004h>     for idx in flat_indices:
[?2004l[?2004h>         i, j = divmod(idx, len(expert_pts))
[?2004l[?2004h>         if i in matched_centroids or j in matched_experts:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if dists[i, j] > max_dist:
[?2004l[?2004h>             break
[?2004l[?2004h>         matches.append((i, j, dists[i, j]))
[?2004l[?2004h>         matched_centroids.add(i)
[?2004l[?2004h>         matched_experts.add(j)
[?2004l[?2004h>         if len(matched_centroids) == len(centroids) or len(matched_experts) == len(expert_pts):
[?2004l[?2004h>             break
[?2004l:[?2004h>     
[?2004l[?2004h>     return matches, len(centroids), len(expert_pts)
[?2004l[?2004h> 
[?2004l[?2004h> def compute_f1_delta(matches, n_centroids, n_expert):
[?2004l[?2004h>     """Compute F1 score and average delta"""
[?2004l[?2004h>     tp = len(matches)
[?2004l[?2004h>     fp = n_centroids - tp
[?2004l[?2004h>     fn = n_expert - tp
[?2004l[?2004h>     
[?2004l[?2004h>     if tp == 0:
[?2004l[?2004h>         return 0.0, np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     precision = tp / (tp + fp) if (tp + fp) > 0 else 0
[?2004l[?2004h>     recall = tp / (tp + fn) if (tp + fn) > 0 else 0
[?2004l[?2004h>     f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     delta = np.mean([m[2] for m in matches]) if matches else np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     return f1, delta
[?2004l[?2004h> 
[?2004l[?2004h> def evaluate_params(params):
[?2004l[?2004h>     """Evaluate a single hyperparameter combination"""
[?2004l[?2004h>     min_samples, epsilon, shape_weight = params
[?2004l[?2004h>     
[?2004l[?2004h>     f1_scores = []
[?2004l[?2004h>     deltas = []
[?2004l[?2004h>     
[?2004l[?2004h>     for img in unique_images:
[?2004l[?2004h>         expert_pts = expert_grouped.get(img, np.array([]))
[?2004l[?2004h>         citsci_pts = citsci_grouped.get(img, np.array([]))
[?2004l[?2004h>         
[?2004l[?2004h>         if len(expert_pts) == 0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         if len(citsci_pts) == 0:
[?2004l[?2004h>             f1_scores.append(0.0)
[?2004l[?2004h>             deltas.append(np.nan)
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Run DBSCAN with custom metric
[?2004l[?2004h>         def metric_func(a, b):
[?2004l[?2004h>             return custom_metric(a, b, shape_weight)
[?2004l[?2004h>         
[?2004l[?2004h>         db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=metric_func)
[?2004l[?2004h>         labels = db.fit_predict(citsci_pts)
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute centroids for each cluster (excluding noise = -1)
[?2004l[?2004h>         unique_labels = set(labels)
[?2004l[?2004h>         unique_labels.discard(-1)
[?2004l[?2004h>         
[?2004l[?2004h>         if len(unique_labels) == 0:
[?2004l[?2004h>             f1_scores.append(0.0)
[?2004l[?2004h>             deltas.append(np.nan)
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         centroids = []
[?2004l[?2004h>         for label in unique_labels:
[?2004l[?2004h>             mask = labels == label
[?2004l[?2004h>             centroid = citsci_pts[mask].mean(axis=0)
[?2004l[?2004h>             centroids.append(centroid)
[?2004l[?2004h>         centroids = np.array(centroids)
[?2004l[?2004h>         
[?2004l[?2004h>         # Greedy matching
[?2004l[?2004h>         matches, n_cent, n_exp = greedy_match(centroids, expert_pts)
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute F1 and delta
[?2004l[?2004h>         f1, delta = compute_f1_delta(matches, n_cent, n_exp)
[?2004l[?2004h>         f1_scores.append(f1)
[?2004l[?2004h>         deltas.append(delta)
[?2004l[?2004h>     
[?2004l[?2004h>     avg_f1 = np.mean(f1_scores) if f1_scores else 0.0
[?2004l[?2004h>     avg_delta = np.nanmean(deltas) if deltas else np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     return (min_samples, epsilon, shape_weight, avg_f1, avg_delta)
[?2004l[?2004h> 
[?2004l[?2004h> # Define hyperparameter grid
[?2004l[?2004h> min_samples_range = list(range(3, 10))  # 3-9
[?2004l[?2004h> epsilon_range = list(range(4, 25, 2))   # 4, 6, 8, ..., 24
[?2004l[?2004h> shape_weight_range = [round(0.9 + 0.1 * i, 1) for i in range(11)]  # 0.9-1.9
[?2004l[?2004h> 
[?2004l[?2004h> all_params = list(product(min_samples_range, epsilon_range, shape_weight_range))
[?2004l[?2004h> print(f"Total combinations: {len(all_params)}")
[?2004l[?2004h> print(f"Using {cpu_count()} CPUs")
[?2004l[?2004h> 
[?2004l[?2004h> # Run parallel evaluation
[?2004l[?2004h> with Pool(cpu_count()) as pool:
[?2004l[?2004h>     results = pool.map(evaluate_params, all_params)
[?2004l[?2004h> 
[?2004l[?2004h> # Filter results with F1 > 0.5
[?2004l[?2004h> filtered = [(ms, eps, sw, f1, delta) for ms, eps, sw, f1, delta in results 
[?2004l[?2004h>             if f1 > 0.5 and not np.isnan(delta)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Filtered results (F1 > 0.5): {len(filtered)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Find Pareto frontier (maximize F1, minimize delta)
[?2004l[?2004h> def is_pareto_optimal(point, all_points):
[?2004l[?2004h>     """Check if point is Pareto optimal (maximize F1, minimize delta)"""
[?2004l[?2004h>     f1, delta = point[3], point[4]
[?2004l[?2004h>     for other in all_points:
[?2004l[?2004h>         other_f1, other_delta = other[3], other[4]
[?2004l[?2004h>         # other dominates point if: other_f1 >= f1 AND other_delta <= delta AND at least one is strictly better
[?2004l[?2004h>         if other_f1 >= f1 and other_delta <= delta:
[?2004l[?2004h>             if other_f1 > f1 or other_delta < delta:
[?2004l[?2004h>                 return False
[?2004l[?2004h>     return True
[?2004l[?2004h> 
[?2004l[?2004h> pareto_frontier = [p for p in filtered if is_pareto_optimal(p, filtered)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Pareto frontier points: {len(pareto_frontier)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write output
[?2004l[?2004h> with open('/root/pareto_frontier.csv', 'w') as f:
[?2004l[?2004h>     f.write('F1,delta,min_samples,epsilon,shape_weight\n')
[?2004l[?2004h>     for ms, eps, sw, f1, delta in sorted(pareto_frontier, key=lambda x: -x[3]):
[?2004l[?2004h>         f.write(f"{round(f1, 5)},{round(delta, 5)},{ms},{eps},{round(sw, 1)}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Results written to /root/pareto_frontier.csv")
[?2004l[?2004h> for p in sorted(pareto_frontier, key=lambda x: -x[3]):
[?2004l[?2004h>     print(f"F1={p[3]:.5f}, delta={p[4]:.5f}, min_samples={p[0]}, eps={p[1]}, sw={p[2]}")
