[536.264937, "i", "python3 << 'EOF'\nimport pandas as pd\n\n# Read the current results\ndf = pd.read_csv('/root/pareto_frontier.csv')\n\n# Rewrite with proper formatting\nwith open('/root/pareto_frontier.csv', 'w') as f:\n    f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\n    for _, row in df.iterrows():\n        f.write(f\"{row['F1']:.5f},{row['delta']:.5f},{int(row['min_samples'])},{int(row['epsilon'])},{row['shape_weight']:.1f}\\n\")\n\nprint(\"Updated formatting\")\nEOF\n"]
