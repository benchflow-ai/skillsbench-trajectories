[49.244085, "i", "cat > /root/optimize_dbscan.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom itertools import product\nfrom multiprocessing import Pool, cpu_count\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\ncitsci = pd.read_csv('/root/data/citsci_train.csv', usecols=['file_rad', 'x', 'y'])\nexpert = pd.read_csv('/root/data/expert_train.csv', usecols=['file_rad', 'x', 'y'])\n\n# Get unique images from expert dataset\nunique_images = expert['file_rad'].unique()\n\n# Group data by file_rad for faster lookup\ncitsci_grouped = {k: v[['x', 'y']].values for k, v in citsci.groupby('file_rad')}\nexpert_grouped = {k: v[['x', 'y']].values for k, v in expert.groupby('file_rad')}\n\ndef custom_metric(a, b, w):\n    \"\"\"Custom distance metric: d = sqrt((w*dx)^2 + ((2-w)*dy)^2)\"\"\"\n    dx = a[0] - b[0]\n    dy = a[1] - b[1]\n    return np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\n\ndef greedy_match(centroids, expert_pts, max_dist=100):\n    \"\"\"Greedy matching: closest pairs first, max distance 100 pix"]
[49.244147, "i", "els (standard Euclidean)\"\"\"\n    if len(centroids) == 0 or len(expert_pts) == 0:\n        return [], 0, 0\n    \n    # Compute all pairwise distances (standard Euclidean)\n    dists = np.sqrt(((centroids[:, np.newaxis, :] - expert_pts[np.newaxis, :, :])**2).sum(axis=2))\n    \n    matches = []\n    matched_centroids = set()\n    matched_experts = set()\n    \n    # Flatten and sort by distance\n    flat_indices = np.argsort(dists.ravel())\n    \n    for idx in flat_indices:\n        i, j = divmod(idx, len(expert_pts))\n        if i in matched_centroids or j in matched_experts:\n            continue\n        if dists[i, j] > max_dist:\n            break\n        matches.append((i, j, dists[i, j]))\n        matched_centroids.add(i)\n        matched_experts.add(j)\n        if len(matched_centroids) == len(centroids) or len(matched_experts) == len(expert_pts):\n            break\n    \n    return matches, len(centroids), len(expert_pts)\n\ndef compute_f1_delta(matches, n_centroids, n_expert):\n    \"\"\"Compute F1 score and average delta\"\"\"\n   "]
[49.244235, "i", " tp = len(matches)\n    fp = n_centroids - tp\n    fn = n_expert - tp\n    \n    if tp == 0:\n        return 0.0, np.nan\n    \n    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    \n    delta = np.mean([m[2] for m in matches]) if matches else np.nan\n    \n    return f1, delta\n\ndef evaluate_params(params):\n    \"\"\"Evaluate a single hyperparameter combination\"\"\"\n    min_samples, epsilon, shape_weight = params\n    \n    f1_scores = []\n    deltas = []\n    \n    for img in unique_images:\n        expert_pts = expert_grouped.get(img, np.array([]))\n        citsci_pts = citsci_grouped.get(img, np.array([]))\n        \n        if len(expert_pts) == 0:\n            continue\n        \n        if len(citsci_pts) == 0:\n            f1_scores.append(0.0)\n            deltas.append(np.nan)\n            continue\n        \n        # Run DBSCAN with custom metric\n        def metric_func(a, b):\n       "]
[49.244245, "i", "     return custom_metric(a, b, shape_weight)\n        \n        db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=metric_func)\n        labels = db.fit_predict(citsci_pts)\n        \n        # Compute centroids for each cluster (excluding noise = -1)\n        unique_labels = set(labels)\n        unique_labels.discard(-1)\n        \n        if len(unique_labels) == 0:\n            f1_scores.append(0.0)\n            deltas.append(np.nan)\n            continue\n        \n        centroids = []\n        for label in unique_labels:\n            mask = labels == label\n            centroid = citsci_pts[mask].mean(axis=0)\n            centroids.append(centroid)\n        centroids = np.array(centroids)\n        \n        # Greedy matching\n        matches, n_cent, n_exp = greedy_match(centroids, expert_pts)\n        \n        # Compute F1 and delta\n        f1, delta = compute_f1_delta(matches, n_cent, n_exp)\n        f1_scores.append(f1)\n        deltas.append(delta)\n    \n    avg_f1 = np.mean(f1_scores) if f1_scores else 0.0\n    avg_d"]
[49.244265, "o", "cat > /root/optimize_dbscan.py << 'EOF'\r\n\u001b[?2004l\r"]
[49.244271, "i", "elta = np.nanmean(deltas) if deltas else np.nan\n    \n    return (min_samples, epsilon, shape_weight, avg_f1, avg_delta)\n\n# Define hyperparameter grid\nmin_samples_range = list(range(3, 10))  # 3-9\nepsilon_range = list(range(4, 25, 2))   # 4, 6, 8, ..., 24\nshape_weight_range = [round(0.9 + 0.1 * i, 1) for i in range(11)]  # 0.9-1.9\n\nall_params = list(product(min_samples_range, epsilon_range, shape_weight_range))\nprint(f\"Total combinations: {len(all_params)}\")\nprint(f\"Using {cpu_count()} CPUs\")\n\n# Run parallel evaluation\nwith Pool(cpu_count()) as pool:\n    results = pool.map(evaluate_params, all_params)\n\n# Filter results with F1 > 0.5\nfiltered = [(ms, eps, sw, f1, delta) for ms, eps, sw, f1, delta in results \n            if f1 > 0.5 and not np.isnan(delta)]\n\nprint(f\"Filtered results (F1 > 0.5): {len(filtered)}\")\n\n# Find Pareto frontier (maximize F1, minimize delta)\ndef is_pareto_optimal(point, all_points):\n    \"\"\"Check if point is Pareto optimal (maximize F1, minimize delta)\"\"\"\n    f1, delta = point[3], point[4]"]
[49.244281, "i", "\n    for other in all_points:\n        other_f1, other_delta = other[3], other[4]\n        # other dominates point if: other_f1 >= f1 AND other_delta <= delta AND at least one is strictly better\n        if other_f1 >= f1 and other_delta <= delta:\n            if other_f1 > f1 or other_delta < delta:\n                return False\n    return True\n\npareto_frontier = [p for p in filtered if is_pareto_optimal(p, filtered)]\n\nprint(f\"Pareto frontier points: {len(pareto_frontier)}\")\n\n# Write output\nwith open('/root/pareto_frontier.csv', 'w') as f:\n    f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\n    for ms, eps, sw, f1, delta in sorted(pareto_frontier, key=lambda x: -x[3]):\n        f.write(f\"{round(f1, 5)},{round(delta, 5)},{ms},{eps},{round(sw, 1)}\\n\")\n\nprint(\"Results written to /root/pareto_frontier.csv\")\nfor p in sorted(pareto_frontier, key=lambda x: -x[3]):\n    print(f\"F1={p[3]:.5f}, delta={p[4]:.5f}, min_samples={p[0]}, eps={p[1]}, sw={p[2]}\")\nEOF\n"]
[49.244328, "o", "elta = np.nanmean(deltas) if deltas els"]
