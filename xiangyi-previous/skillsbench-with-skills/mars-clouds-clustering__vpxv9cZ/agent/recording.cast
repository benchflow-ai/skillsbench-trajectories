[363.343572, "o", "    centroids = np.array([citsci_pts[labels == lbl].mean(axis=0) for lbl in unique_labels])\r\n\u001b[?2004l\r"]
[363.34359, "o", "\u001b[?2004h> "]
[363.343612, "o", "    \r\n"]
[363.343621, "o", "\u001b[?2004l\r"]
[363.343628, "o", "\u001b[?2004h"]
[363.343634, "o", "> "]
[363.343674, "o", "    # Greedy matching\r\n\u001b[?2004l\r"]
[363.343693, "o", "\u001b[?2004h> "]
[363.343798, "o", "    matches, n_cent, n_exp = greedy_match(centroids, expert_pts)\r\n\u001b[?2004l\r"]
[363.343825, "o", "\u001b[?2004h> "]
[363.343833, "o", "    \r\n"]
[363.343839, "o", "\u001b[?2004l\r"]
[363.343847, "o", "\u001b[?2004h"]
[363.343854, "o", "> "]
[363.343902, "o", "    # Compute F1 and delta\r\n\u001b[?2004l\r"]
[363.343922, "o", "\u001b[?2004h"]
[363.343928, "o", "> "]
[363.343966, "o", "    tp = len(matches)\r\n\u001b[?2004l\r"]
[363.343986, "o", "\u001b[?2004h"]
[363.343993, "o", "> "]
[363.344031, "o", "    fp = n_cent - tp\r\n\u001b[?2004l\r"]
[363.34405, "o", "\u001b[?2004h"]
[363.344059, "o", "> "]
[363.344092, "o", "    fn = n_exp - tp\r\n"]
[363.344099, "o", "\u001b[?2004l\r"]
[363.344106, "o", "\u001b[?2004h"]
[363.344123, "o", "> "]
[363.34413, "o", "    "]
[363.344137, "o", "\r\n\u001b[?2004l\r"]
[363.344156, "o", "\u001b[?2004h"]
[363.344166, "o", "> "]
[363.344238, "o", "    if tp == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.344283, "o", "        return 0.0, np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.344296, "o", "    \r\n\u001b[?2004l\r"]
[363.34431, "o", "\u001b[?2004h> "]
[363.344409, "o", "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.344415, "o", "> "]
[363.344498, "o", "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\r\n\u001b[?2004l\r"]
[363.344506, "o", "\u001b[?2004h> "]
[363.344651, "o", "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\r\n\u001b[?2004l\r"]
[363.344667, "o", "\u001b[?2004h"]
[363.344677, "o", "> "]
[363.344755, "o", "    delta = np.mean([m[2] for m in matches])\r\n"]
[363.344763, "o", "\u001b[?2004l\r"]
[363.344783, "o", "\u001b[?2004h"]
[363.344794, "o", "> "]
[363.344814, "o", "    \r\n"]
[363.344821, "o", "\u001b[?2004l\r"]
[363.34484, "o", "\u001b[?2004h"]
[363.344857, "o", "> "]
[363.34489, "o", "    return f1, delta\r\n\u001b[?2004l\r"]
[363.344906, "o", "\u001b[?2004h"]
[363.344919, "o", "> \r\n\u001b[?2004l\r"]
[363.344933, "o", "\u001b[?2004h"]
[363.344941, "o", "> "]
[363.344984, "o", "def evaluate_params(params):\r\n\u001b[?2004l\r"]
[363.345001, "o", "\u001b[?2004h"]
[363.345007, "o", "> "]
[363.345123, "o", "    \"\"\"Evaluate a single hyperparameter combination\"\"\"\r\n\u001b[?2004l\r"]
[363.345142, "o", "\u001b[?2004h"]
[363.34515, "o", "> "]
[363.345215, "o", "    min_samples, epsilon, shape_weight = params\r\n\u001b[?2004l\r"]
[363.345234, "o", "\u001b[?2004h"]
[363.345251, "o", "> "]
[363.345265, "o", "    \r\n\u001b[?2004l\r"]
[363.345277, "o", "\u001b[?2004h> "]
[363.34531, "o", "    f1_scores = []\r\n\u001b[?2004l\r"]
[363.34532, "o", "\u001b[?2004h"]
[363.345327, "o", "> "]
[363.345362, "o", "    deltas = []\r\n"]
[363.34537, "o", "\u001b[?2004l\r"]
[363.34539, "o", "\u001b[?2004h"]
[363.345405, "o", "> "]
[363.345418, "o", "    \r\n\u001b[?2004l\r"]
[363.345435, "o", "\u001b[?2004h"]
[363.345447, "o", "> "]
[363.345491, "o", "    for img in unique_images:\r\n\u001b[?2004l\r"]
[363.345508, "o", "\u001b[?2004h"]
[363.345516, "o", "> "]
[363.3456, "o", "        expert_pts = expert_grouped.get(img, np.array([]))\r\n\u001b[?2004l\r"]
[363.345618, "o", "\u001b[?2004h"]
[363.345626, "o", "> "]
[363.345711, "o", "        citsci_pts = citsci_grouped.get(img, np.array([]))\r\n\u001b[?2004l\r"]
[363.345718, "o", "\u001b[?2004h"]
[363.345731, "o", "> "]
[363.345757, "o", "        \r\n"]
[363.345764, "o", "\u001b[?2004l\r"]
[363.345785, "o", "\u001b[?2004h"]
[363.345797, "o", "> "]
[363.345862, "o", "        if len(expert_pts) == 0:\r\n\u001b[?2004l\r"]
[363.34588, "o", "\u001b[?2004h"]
[363.345891, "o", "> "]
[363.345942, "o", "            continue\r\n\u001b[?2004l\r"]
[363.34596, "o", "\u001b[?2004h"]
[363.345968, "o", "> "]
[363.34598, "o", "        \r\n\u001b[?2004l\r"]
[363.345998, "o", "\u001b[?2004h"]
[363.346009, "o", "> "]
[363.346058, "o", "        if len(citsci_pts) == 0:\r\n\u001b[?2004l\r"]
[363.346077, "o", "\u001b[?2004h"]
[363.346085, "o", "> "]
[363.346135, "o", "            f1_scores.append(0.0)\r\n\u001b[?2004l\r"]
[363.34615, "o", "\u001b[?2004h> "]
[363.346204, "o", "            deltas.append(np.nan)\r\n\u001b[?2004l\r"]
[363.34621, "o", "\u001b[?2004h"]
[363.346222, "o", "> "]
[363.346269, "o", "            continue\r\n"]
[363.346276, "o", "\u001b[?2004l\r"]
[363.346305, "o", "\u001b[?2004h"]
[363.346316, "o", "> "]
[363.346343, "o", "        \r\n"]
[363.34635, "o", "\u001b[?2004l\r"]
[363.346383, "o", "\u001b[?2004h"]
[363.346399, "o", "> "]
[363.346461, "o", "        # Compute distance matrix\r\n"]
[363.346471, "o", "\u001b[?2004l\r"]
[363.346489, "o", "\u001b[?2004h"]
[363.3465, "o", "> "]
[363.346641, "o", "        dist_matrix = compute_custom_dist_matrix(citsci_pts, shape_weight)\r\n\u001b[?2004l\r"]
[363.346651, "o", "\u001b[?2004h"]
[363.346669, "o", "> "]
[363.346686, "o", "        \r\n\u001b[?2004l\r"]
[363.346699, "o", "\u001b[?2004h"]
[363.346707, "o", "> "]
[363.346869, "o", "        f1, delta = evaluate_image(img, min_samples, epsilon, dist_matrix, citsci_pts, expert_pts)\r\n\u001b[?2004l\r"]
[363.346886, "o", "\u001b[?2004h"]
[363.346902, "o", "> "]
[363.346927, "o", "        \r\n"]
[363.346934, "o", "\u001b[?2004l\r"]
[363.346953, "o", "\u001b[?2004h"]
[363.346968, "o", "> "]
[363.347025, "o", "        if f1 is not None:\r\n"]
[363.347032, "o", "\u001b[?2004l\r"]
[363.347049, "o", "\u001b[?2004h"]
[363.347056, "o", "> "]
[363.347119, "o", "            f1_scores.append(f1)\r\n"]
[363.347126, "o", "\u001b[?2004l\r"]
[363.347148, "o", "\u001b[?2004h> "]
[363.3472, "o", "            deltas.append(delta)\r\n\u001b[?2004l\r"]
[363.347213, "o", "\u001b[?2004h"]
[363.347221, "o", "> "]
[363.347239, "o", "    \r\n"]
[363.347245, "o", "\u001b[?2004l\r"]
[363.347265, "o", "\u001b[?2004h"]
[363.347269, "o", "> "]
[363.347362, "o", "    avg_f1 = np.mean(f1_scores) if f1_scores else 0.0\r\n\u001b[?2004l\r"]
[363.347374, "o", "\u001b[?2004h"]
[363.347383, "o", "> "]
[363.347476, "o", "    avg_delta = np.nanmean(deltas) if deltas else np.nan\r\n"]
[363.347483, "o", "\u001b[?2004l\r"]
[363.347504, "o", "\u001b[?2004h"]
[363.347511, "o", "> "]
[363.347527, "o", "    \r\n\u001b[?2004l\r"]
[363.34754, "o", "\u001b[?2004h"]
[363.347549, "o", "> "]
[363.347658, "o", "    return (min_samples, epsilon, shape_weight, avg_f1, avg_delta)\r\n"]
[363.347665, "o", "\u001b[?2004l\r"]
[363.347685, "o", "\u001b[?2004h"]
[363.347698, "o", "> "]
[363.347703, "o", "\r\n"]
[363.34771, "o", "\u001b[?2004l\r"]
[363.347728, "o", "\u001b[?2004h"]
[363.347732, "o", "> "]
[363.347789, "o", "# Define hyperparameter grid\r\n\u001b[?2004l\r"]
[363.347797, "o", "\u001b[?2004h"]
[363.347816, "o", "> "]
[363.347887, "o", "min_samples_range = list(range(3, 10))  # 3-9\r\n\u001b[?2004l\r"]
[363.347899, "o", "\u001b[?2004h"]
[363.347908, "o", "> "]
[363.348066, "o", "epsilon_range = list(range(4, 25, 2))   # 4, 6, 8, ..., 24\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.34814, "o", "shape_weight_range = [round(0.9 + 0.1 * i, 1) for i in range(11)]  # 0.9-1.9\r\n\u001b[?2004l\r"]
[363.348157, "o", "\u001b[?2004h> "]
[363.348164, "o", "\r\n"]
[363.34817, "o", "\u001b[?2004l\r"]
[363.348189, "o", "\u001b[?2004h"]
[363.348195, "o", "> "]
[363.348313, "o", "all_params = list(product(min_samples_range, epsilon_range, shape_weight_range))\r\n\u001b[?2004l\r"]
[363.348322, "o", "\u001b[?2004h"]
[363.348335, "o", "> "]
[363.348415, "o", "print(f\"Total combinations: {len(all_params)}\")\r\n"]
[363.348422, "o", "\u001b[?2004l\r"]
[363.348441, "o", "\u001b[?2004h"]
[363.348456, "o", "> "]
[363.348519, "o", "print(f\"Using {cpu_count()} CPUs\")\r\n"]
[363.348526, "o", "\u001b[?2004l\r"]
[363.348546, "o", "\u001b[?2004h"]
[363.348554, "o", "> \r\n\u001b[?2004l\r"]
[363.348575, "o", "\u001b[?2004h"]
[363.348588, "o", "> "]
[363.348636, "o", "# Run parallel evaluation\r\n"]
[363.348644, "o", "\u001b[?2004l\r"]
[363.348665, "o", "\u001b[?2004h"]
[363.34868, "o", "> "]
[363.348737, "o", "with Pool(cpu_count()) as pool:\r\n"]
[363.348745, "o", "\u001b[?2004l\r"]
[363.348761, "o", "\u001b[?2004h"]
[363.348777, "o", "> "]
[363.348863, "o", "    results = pool.map(evaluate_params, all_params)\r\n"]
[363.34887, "o", "\u001b[?2004l\r"]
[363.34889, "o", "\u001b[?2004h"]
[363.348896, "o", "> \r\n"]
[363.348904, "o", "\u001b[?2004l\r"]
[363.348925, "o", "\u001b[?2004h"]
[363.348938, "o", "> "]
[363.348993, "o", "print(\"Grid search complete.\")\r\n"]
[363.348998, "o", "\u001b[?2004l\r"]
[363.34902, "o", "\u001b[?2004h"]
[363.349029, "o", "> \r\n\u001b[?2004l\r"]
[363.349048, "o", "\u001b[?2004h"]
[363.349063, "o", "> "]
[363.349121, "o", "# Filter results with F1 > 0.5\r\n"]
[363.34913, "o", "\u001b[?2004l\r"]
[363.349146, "o", "\u001b[?2004h"]
[363.349153, "o", "> "]
[363.349263, "o", "filtered = [(ms, eps, sw, f1, delta) for ms, eps, sw, f1, delta in results \r\n\u001b[?2004l\r"]
[363.349275, "o", "\u001b[?2004h"]
[363.349283, "o", "> "]
[363.349367, "o", "            if f1 > 0.5 and not np.isnan(delta)]\r\n\u001b[?2004l\r"]
[363.349379, "o", "\u001b[?2004h"]
[363.349387, "o", "> \r\n"]
[363.349403, "o", "\u001b[?2004l\r"]
[363.349421, "o", "\u001b[?2004h"]
[363.349435, "o", "> "]
[363.349524, "o", "print(f\"Filtered results (F1 > 0.5): {len(filtered)}\")\r\n"]
[363.349532, "o", "\u001b[?2004l\r"]
[363.34955, "o", "\u001b[?2004h"]
[363.349559, "o", "> \r\n\u001b[?2004l\r"]
[363.34958, "o", "\u001b[?2004h"]
[363.349593, "o", "> "]
[363.349682, "o", "# Find Pareto frontier (maximize F1, minimize delta)\r\n"]
[363.349689, "o", "\u001b[?2004l\r"]
[363.349708, "o", "\u001b[?2004h"]
[363.349723, "o", "> "]
[363.349794, "o", "def is_pareto_optimal(point, all_points):\r\n"]
[363.349801, "o", "\u001b[?2004l\r"]
[363.34982, "o", "\u001b[?2004h"]
[363.349833, "o", "> "]
[363.349895, "o", "    f1, delta = point[3], point[4]\r\n"]
[363.349902, "o", "\u001b[?2004l\r"]
[363.349921, "o", "\u001b[?2004h"]
[363.349936, "o", "> "]
[363.34999, "o", "    for other in all_points:\r\n"]
[363.349998, "o", "\u001b[?2004l\r"]
[363.350016, "o", "\u001b[?2004h"]
[363.35003, "o", "> "]
[363.35008, "o", "        if other is point:\r\n"]
[363.350086, "o", "\u001b[?2004l\r"]
[363.350106, "o", "\u001b[?2004h"]
[363.350123, "o", "> "]
[363.350164, "o", "            continue\r\n"]
[363.350171, "o", "\u001b[?2004l\r"]
[363.35019, "o", "\u001b[?2004h"]
[363.350205, "o", "> "]
[363.350289, "o", "        other_f1, other_delta = other[3], other[4]\r\n"]
[363.350296, "o", "\u001b[?2004l\r"]
[363.350315, "o", "\u001b[?2004h"]
[363.350329, "o", "> "]
[363.350414, "o", "        if other_f1 >= f1 and other_delta <= delta:\r\n"]
[363.350422, "o", "\u001b[?2004l\r"]
[363.350438, "o", "\u001b[?2004h"]
[363.350452, "o", "> "]
[363.350538, "o", "            if other_f1 > f1 or other_delta < delta:\r\n"]
[363.350544, "o", "\u001b[?2004l\r"]
[363.350564, "o", "\u001b[?2004h"]
[363.35057, "o", "> "]
[363.350692, "o", "                return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.350744, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.350852, "o", "pareto_frontier = [p for p in filtered if is_pareto_optimal(p, filtered)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[363.350861, "o", "\u001b[?2004l\r"]
[363.350874, "o", "\u001b[?2004h"]
[363.350894, "o", "> "]
[363.350983, "o", "print(f\"Pareto frontier points: {len(pareto_frontier)}\")\r\n"]
[363.35099, "o", "\u001b[?2004l\r"]
[363.351008, "o", "\u001b[?2004h"]
[363.351013, "o", "> "]
[363.351029, "o", "\r\n\u001b[?2004l\r"]
[363.351045, "o", "\u001b[?2004h"]
[363.351053, "o", "> "]
[363.351088, "o", "# Write output\r\n"]
[363.351095, "o", "\u001b[?2004l\r"]
[363.351115, "o", "\u001b[?2004h"]
[363.351123, "o", "> "]
[363.351204, "o", "with open('/root/pareto_frontier.csv', 'w') as f:\r\n"]
[363.351211, "o", "\u001b[?2004l\r"]
[363.35123, "o", "\u001b[?2004h"]
[363.351245, "o", "> "]
[363.351341, "o", "    f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\r\n"]
[363.351348, "o", "\u001b[?2004l\r"]
[363.351368, "o", "\u001b[?2004h"]
[363.351382, "o", "> "]
[363.351508, "o", "    for ms, eps, sw, f1, delta in sorted(pareto_frontier, key=lambda x: -x[3]):\r\n"]
[363.351514, "o", "\u001b[?2004l\r"]
[363.351534, "o", "\u001b[?2004h"]
[363.351549, "o", "> "]
[363.351675, "o", "        f.write(f\"{round(f1, 5)},{round(delta, 5)},{ms},{eps},{round(sw, 1)}\\n\")\r\n"]
[363.351681, "o", "\u001b[?2004l\r"]
[363.351701, "o", "\u001b[?2004h"]
[363.351715, "o", "> \r\n"]
[363.35172, "o", "\u001b[?2004l\r"]
[363.351742, "o", "\u001b[?2004h"]
[363.351749, "o", "> "]
[363.351828, "o", "print(\"Results written to /root/pareto_frontier.csv\")\r\n\u001b[?2004l\r"]
[363.351851, "o", "\u001b[?2004h"]
[363.351869, "o", "> "]
[363.351959, "o", "for p in sorted(pareto_frontier, key=lambda x: -x[3]):\r\n"]
[363.351963, "o", "\u001b[?2004l\r"]
[363.351987, "o", "\u001b[?2004h"]
[363.351994, "o", "> "]
[363.352129, "o", "    print(f\"F1={p[3]:.5f}, delta={p[4]:.5f}, min_samples={p[0]}, eps={p[1]}, sw={p[2]}\")\r\n\u001b[?2004l\r"]
[363.352147, "o", "\u001b[?2004h> "]
[363.35216, "o", "EOF\r\n\u001b[?2004l\r"]
[363.390121, "o", "\u001b[?2004hroot@e1b82849fd7b:~# "]
