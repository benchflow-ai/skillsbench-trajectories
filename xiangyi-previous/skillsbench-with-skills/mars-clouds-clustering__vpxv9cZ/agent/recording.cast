[49.254902, "o", "    for img in unique_images:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.254924, "o", "> "]
[49.254998, "o", "        expert_pts = expert_grouped.get(img, np.array([]))\r\n\u001b[?2004l\r"]
[49.255029, "o", "\u001b[?2004h> "]
[49.255099, "o", "        citsci_pts = citsci_grouped.get(img, np.array([]))\r\n\u001b[?2004l\r"]
[49.255109, "o", "\u001b[?2004h> "]
[49.255181, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.25521, "o", "        if len(expert_pts) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.255237, "o", "> "]
[49.255258, "o", "            continue\r\n\u001b[?2004l\r"]
[49.255287, "o", "\u001b[?2004h> "]
[49.255315, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.255349, "o", "        if len(citsci_pts) == 0:\r\n\u001b[?2004l\r"]
[49.255372, "o", "\u001b[?2004h> "]
[49.255418, "o", "            f1_scores.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.255443, "o", "> "]
[49.25549, "o", "            deltas.append(np.nan)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.255525, "o", "> "]
[49.255565, "o", "            continue\r\n\u001b[?2004l\r"]
[49.255592, "o", "\u001b[?2004h"]
[49.255616, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.255675, "o", "        # Run DBSCAN with custom metric\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.255703, "o", "> "]
[49.255738, "o", "        def metric_func(a, b):\r\n\u001b[?2004l\r"]
[49.25576, "o", "\u001b[?2004h> "]
[49.255834, "o", "            return custom_metric(a, b, shape_weight)\r\n\u001b[?2004l\r"]
[49.255862, "o", "\u001b[?2004h> "]
[49.255885, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.256004, "o", "        db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=metric_func)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.256076, "o", "        labels = db.fit_predict(citsci_pts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.256098, "o", "> "]
[49.256127, "o", "        \r\n\u001b[?2004l\r"]
[49.256157, "o", "\u001b[?2004h> "]
[49.256225, "o", "        # Compute centroids for each cluster (excluding noise = -1)\r\n\u001b[?2004l\r"]
[49.256246, "o", "\u001b[?2004h> "]
[49.256308, "o", "        unique_labels = set(labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.256368, "o", "        unique_labels.discard(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.256395, "o", "> "]
[49.25642, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.256466, "o", "        if len(unique_labels) == 0:\r\n\u001b[?2004l\r"]
[49.256496, "o", "\u001b[?2004h> "]
[49.256534, "o", "            f1_scores.append(0.0)\r\n\u001b[?2004l\r"]
[49.256565, "o", "\u001b[?2004h> "]
[49.256602, "o", "            deltas.append(np.nan)\r\n\u001b[?2004l\r"]
[49.256622, "o", "\u001b[?2004h"]
[49.256644, "o", "> "]
[49.256663, "o", "            continue\r\n\u001b[?2004l\r"]
[49.256682, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[49.256711, "o", "\u001b[?2004h> "]
[49.256742, "o", "        centroids = []\r\n\u001b[?2004l\r"]
[49.256769, "o", "\u001b[?2004h> "]
[49.256797, "o", "        for label in unique_labels:\r\n\u001b[?2004l\r"]
[49.256821, "o", "\u001b[?2004h> "]
[49.256867, "o", "            mask = labels == label\r\n\u001b[?2004l\r"]
[49.256896, "o", "\u001b[?2004h> "]
[49.256963, "o", "            centroid = citsci_pts[mask].mean(axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.256993, "o", "> "]
[49.257041, "o", "            centroids.append(centroid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257066, "o", "> "]
[49.257111, "o", "        centroids = np.array(centroids)\r\n\u001b[?2004l\r"]
[49.257141, "o", "\u001b[?2004h> "]
[49.257174, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.257199, "o", "        # Greedy matching\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257222, "o", "> "]
[49.257316, "o", "        matches, n_cent, n_exp = greedy_match(centroids, expert_pts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257339, "o", ">         \r\n\u001b[?2004l\r"]
[49.25736, "o", "\u001b[?2004h> "]
[49.257412, "o", "        # Compute F1 and delta\r\n\u001b[?2004l\r"]
[49.257443, "o", "\u001b[?2004h> "]
[49.257536, "o", "        f1, delta = compute_f1_delta(matches, n_cent, n_exp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.257578, "o", "        f1_scores.append(f1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257602, "o", "> "]
[49.257639, "o", "        deltas.append(delta)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257662, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.257684, "o", "> "]
[49.257754, "o", "    avg_f1 = np.mean(f1_scores) if f1_scores else 0.0\r\n\u001b[?2004l\r"]
[49.25778, "o", "\u001b[?2004h"]
[49.25781, "o", "> "]
[49.257855, "o", "    avg_delta = np.nanmean(deltas) if deltas else np.nan\r\n\u001b[?2004l\r"]
[49.257883, "o", "\u001b[?2004h> "]
[49.25791, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.258008, "o", "    return (min_samples, epsilon, shape_weight, avg_f1, avg_delta)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.258035, "o", "\u001b[?2004h> "]
[49.25807, "o", "# Define hyperparameter grid\r\n\u001b[?2004l\r"]
[49.258099, "o", "\u001b[?2004h"]
[49.258127, "o", "> "]
[49.258158, "o", "min_samples_range = list(range(3, 10))  # 3-9\r\n\u001b[?2004l\r"]
[49.258166, "o", "\u001b[?2004h> "]
[49.258281, "o", "epsilon_range = list(range(4, 25, 2))   # 4, 6, 8, ..., 24\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.258402, "o", "shape_weight_range = [round(0.9 + 0.1 * i, 1) for i in range(11)]  # 0.9-1.9\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.258411, "o", "> \r\n\u001b[?2004l\r"]
[49.258448, "o", "\u001b[?2004h> "]
[49.258548, "o", "all_params = list(product(min_samples_range, epsilon_range, shape_weight_range))\r\n\u001b[?2004l\r"]
[49.258572, "o", "\u001b[?2004h> "]
[49.258679, "o", "print(f\"Total combinations: {len(all_params)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.258735, "o", "print(f\"Using {cpu_count()} CPUs\")\r\n\u001b[?2004l\r"]
[49.25876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.258782, "o", "\u001b[?2004h> "]
[49.25881, "o", "# Run parallel evaluation\r\n\u001b[?2004l\r"]
[49.258832, "o", "\u001b[?2004h> "]
[49.258875, "o", "with Pool(cpu_count()) as pool:\r\n\u001b[?2004l\r"]
[49.258907, "o", "\u001b[?2004h> "]
[49.258964, "o", "    results = pool.map(evaluate_params, all_params)\r\n\u001b[?2004l\r"]
[49.258977, "o", "\u001b[?2004h> \r\n"]
[49.258999, "o", "\u001b[?2004l\r"]
[49.25902, "o", "\u001b[?2004h> "]
[49.259041, "o", "# Filter results with F1 > 0.5\r\n\u001b[?2004l\r"]
[49.259063, "o", "\u001b[?2004h> "]
[49.259177, "o", "filtered = [(ms, eps, sw, f1, delta) for ms, eps, sw, f1, delta in results \r\n\u001b[?2004l\r"]
[49.259207, "o", "\u001b[?2004h> "]
[49.259262, "o", "            if f1 > 0.5 and not np.isnan(delta)]\r\n\u001b[?2004l\r"]
[49.259285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.259309, "o", "\u001b[?2004h> "]
[49.259384, "o", "print(f\"Filtered results (F1 > 0.5): {len(filtered)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.259408, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.259434, "o", "> "]
[49.259497, "o", "# Find Pareto frontier (maximize F1, minimize delta)\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.259524, "o", "> "]
[49.259576, "o", "def is_pareto_optimal(point, all_points):\r\n\u001b[?2004l\r"]
[49.259598, "o", "\u001b[?2004h> "]
[49.259699, "o", "    \"\"\"Check if point is Pareto optimal (maximize F1, minimize delta)\"\"\"\r\n\u001b[?2004l\r"]
[49.259725, "o", "\u001b[?2004h> "]
[49.259768, "o", "    f1, delta = point[3], point[4]\r\n\u001b[?2004l\r"]
[49.259789, "o", "\u001b[?2004h> "]
[49.259828, "o", "    for other in all_points:\r\n\u001b[?2004l\r"]
[49.259858, "o", "\u001b[?2004h> "]
[49.259916, "o", "        other_f1, other_delta = other[3], other[4]\r\n\u001b[?2004l\r"]
[49.259947, "o", "\u001b[?2004h> "]
[49.260127, "o", "        # other dominates point if: other_f1 >= f1 AND other_delta <= delta AND at least one is strictly better\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.26019, "o", "        if other_f1 >= f1 and other_delta <= delta:\r\n\u001b[?2004l\r"]
[49.260221, "o", "\u001b[?2004h> "]
[49.260287, "o", "            if other_f1 > f1 or other_delta < delta:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.260306, "o", "> "]
[49.260343, "o", "                return False\r\n\u001b[?2004l\r"]
[49.260364, "o", "\u001b[?2004h> "]
[49.260386, "o", "    return True\r\n\u001b[?2004l\r"]
[49.260398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.260421, "o", "\u001b[?2004h"]
[49.260451, "o", "> "]
[49.260525, "o", "pareto_frontier = [p for p in filtered if is_pareto_optimal(p, filtered)]\r\n\u001b[?2004l\r"]
[49.260555, "o", "\u001b[?2004h"]
[49.260584, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.260641, "o", "print(f\"Pareto frontier points: {len(pareto_frontier)}\")\r\n\u001b[?2004l\r"]
[49.26067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.260698, "o", "# Write output\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.260727, "o", "> "]
[49.260787, "o", "with open('/root/pareto_frontier.csv', 'w') as f:\r\n\u001b[?2004l\r"]
[49.260817, "o", "\u001b[?2004h> "]
[49.260893, "o", "    f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\r\n\u001b[?2004l\r"]
[49.260921, "o", "\u001b[?2004h> "]
[49.261024, "o", "    for ms, eps, sw, f1, delta in sorted(pareto_frontier, key=lambda x: -x[3]):\r\n\u001b[?2004l\r"]
[49.26105, "o", "\u001b[?2004h"]
[49.261075, "o", "> "]
[49.261166, "o", "        f.write(f\"{round(f1, 5)},{round(delta, 5)},{ms},{eps},{round(sw, 1)}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.261189, "o", "> \r\n\u001b[?2004l\r"]
[49.261212, "o", "\u001b[?2004h> "]
[49.261281, "o", "print(\"Results written to /root/pareto_frontier.csv\")\r\n\u001b[?2004l\r"]
[49.26131, "o", "\u001b[?2004h> "]
[49.261379, "o", "for p in sorted(pareto_frontier, key=lambda x: -x[3]):\r\n\u001b[?2004l\r"]
[49.261408, "o", "\u001b[?2004h> "]
[49.26153, "o", "    print(f\"F1={p[3]:.5f}, delta={p[4]:.5f}, min_samples={p[0]}, eps={p[1]}, sw={p[2]}\")\r\n\u001b[?2004l\r"]
[49.261554, "o", "\u001b[?2004h> EOF"]
[49.261576, "o", "\r\n\u001b[?2004l\r"]
[49.263767, "o", "\u001b[?2004hroot@e1b82849fd7b:~# "]
[49.720813, "i", "python3 /root/optimize_dbscan.py\n"]
[49.720977, "o", "python3 /root/optimize_dbscan.py\r\n\u001b[?2004l\r"]
[51.368709, "o", "Total combinations: 847\r\n"]
[51.369343, "o", "Using 128 CPUs\r\n"]
[331.295751, "i", "\u0003"]
[331.296253, "o", "^CTraceback (most recent call last):\r\n  File \"sklearn/neighbors/_binary_tree.pxi\", line 1021, in sklearn.neighbors._ball_tree.BinaryTree.rdist\r\nTraceback (most recent call last):\r\nTraceback (most recent call last):\r\nTraceback (most recent call last):\r\n  File \"sklearn/neighbors/_binary_tree.pxi\", line 1021, in sklearn.neighbors._ball_tree.BinaryTree.rdist\r\n  File \"sklearn/neighbors/_binary_tree.pxi\", line 1021, in sklearn.neighbors._ball_tree.BinaryTree.rdist\r\n  File \"sklearn/neighbors/_binary_tree.pxi\", line 1021, in sklearn.neighbors._ball_tree.BinaryTree.rdist\r\n  File \"sklearn/metrics/_dist_metrics.pyx\", line 328, in sklearn.metrics._dist_metrics.DistanceMetric.rdist\r\n  File \"sklearn/metrics/_dist_metrics.pyx\", line 2762, in sklearn.metrics._dist_metrics.PyFuncDistance.dist\r\n  File \"sklearn/metrics/_dist_metrics.pyx\", line 2774, in sklearn.metrics._dist_metrics.PyFuncDistance._dist\r\n  File \"sklearn/metrics/_dist_metrics.pyx\", line 328, in sklearn.metrics._dist_metrics.DistanceMetric.rdist\r\n  File \"/root/opt"]
