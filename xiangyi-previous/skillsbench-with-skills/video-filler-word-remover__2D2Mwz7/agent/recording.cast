[521.036139, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[521.057758, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.0.1\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m25.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[521.385654, "o", "\u001b[?2004hroot@14ba88551b2d:~# "]
[558.321708, "i", "cat > /root/detect_fillers.py << 'EOF'\nimport whisper\nimport json\nimport subprocess\nimport os\n\n# Filler words to detect\nFILLER_WORDS = [\n    \"um\", \"uh\", \"hum\", \"hmm\", \"mhm\",\n    \"like\",\n    \"you know\",\n    \"i mean\",\n    \"yeah\",\n    \"so\",\n    \"kind of\",\n    \"basically\",\n    \"i guess\",\n    \"well\",\n    \"okay\"\n]\n\ndef detect_fillers(input_video, output_json, output_video):\n    print(\"Loading whisper model...\")\n    model = whisper.load_model(\"base\")\n    \n    print(\"Transcribing video...\")\n    result = model.transcribe(input_video, word_timestamps=True)\n    \n    annotations = []\n    \n    # Process each segment\n    for segment in result[\"segments\"]:\n        if \"words\" not in segment:\n            continue\n        \n        words = segment[\"words\"]\n        text_lower = segment[\"text\"].lower()\n        \n        # Check for multi-word fillers first\n        for filler in [\"you know\", \"i mean\", \"kind of\", \"i guess\"]:\n            if filler in text_lower:\n                # Find approximate timestamp\n                filler_words = filler.split()\n                for i, word_info in enumerate(words):\n                    if word_info[\"word\"].strip().lower() == filler_words[0]:\n                        if i + 1 < len(words):\n                            next_word = words[i + 1][\"word\"].strip().lower()\n                            if len(filler_words) > 1 and next_word == filler_words[1]:\n                                annotations.append({\n                                    \"word\": filler,\n                                    \"timestamp\": round(word_info[\"start\"], 2),\n                                    \"end\": round(words[i + len(filler_words) - 1][\"end\"], 2)\n                                })\n        \n        # Check for single-word fillers\n        for word_info in words:\n            word = word_info[\"word\"].strip().lower().strip('.,!?')\n            for filler in [\"um\", \"uh\", \"hum\", \"hmm\", \"mhm\", \"like\", \"yeah\", \"so\", \"basically\", \"well\", \"okay\"]:\n                if word == filler:\n                    annotations.append({\n                        \"word\": filler,\n                        \"timestamp\": round(word_info[\"start\"], 2),\n                        \"end\": round(word_info[\"end\"], 2)\n                    })\n    \n    # Remove duplicates and sort by timestamp\n    seen = set()\n    unique_annotations = []\n    for a in sorted(annotations, key=lambda x: x[\"timestamp\"]):\n        key = (a[\"word\"], a[\"timestamp\"])\n        if key not in seen:\n            seen.add(key)\n            unique_annotations.append({\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"], \"end\": a[\"end\"]})\n    \n    # Save annotations (without end time for the JSON output)\n    json_output = [{\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"]} for a in unique_annotations]\n    with open(output_json, 'w') as f:\n        json.dump(json_output, f, indent=2)\n    print(f\"Saved {len(json_output)} annotations to {output_json}\")\n    \n    # Extract clips and stitch them\n    if unique_annotations:\n        print(\"Extracting filler clips...\")\n        clips = []\n        for i, a in enumerate(unique_annotations):\n            clip_file = f\"/tmp/clip_{i:04d}.mp4\"\n            start = max(0, a[\"timestamp\"] - 0.1)\n            duration = a[\"end\"] - a[\"timestamp\"] + 0.2\n            cmd = [\n                \"ffmpeg\", \"-y\", \"-i\", input_video,\n                \"-ss\", str(start), \"-t\", str(duration),\n                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\n                clip_file\n            ]\n            subprocess.run(cmd, capture_output=True)\n            if os.path.exists(clip_file):\n                clips.append(clip_file)\n        \n        if clips:\n            # Create concat file\n            with open(\"/tmp/concat.txt\", 'w') as f:\n                for clip in clips:\n                    f.write(f\"file '{clip}'\\n\")\n            \n            # Concatenate clips\n            cmd = [\n                \"ffmpeg\", \"-y\", \"-f\", \"concat\", \"-safe\", \"0\",\n                \"-i\", \"/tmp/concat.txt\",\n                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\n                output_video\n            ]\n            subprocess.run(cmd, capture_output=True)\n   "]
[558.321763, "i", "         print(f\"Created output video: {output_video}\")\n            \n            # Cleanup\n            for clip in clips:\n                os.remove(clip)\n            os.remove(\"/tmp/concat.txt\")\n    \n    return unique_annotations\n\nif __name__ == \"__main__\":\n    detect_fillers(\"/root/input.mp4\", \"/root/annotations.json\", \"/root/output.mp4\")\nEOF\n"]
[558.322194, "o", "cat > /root/detect_fillers.py << 'EOF'\r\n\u001b[?2004l\r         \"word\": filler,\r\n                        \"timestamp\": round(word_info[\"start\"], 2),\r\n                        \"end\": round(word_info[\"end\"], 2)\r\n                    })\r\n    \r\n    # Remove duplicates and sort by timestamp\r\n    seen = set()\r\n    unique_annotations = []\r\n    for a in sorted(annotations, key=lambda x: x[\"timestamp\"]):\r\n        key = (a[\"word\"], a[\"timestamp\"])\r\n        if key not in seen:\r\n            seen.add(key)\r\n            unique_annotations.append({\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"], \"end\": a[\"end\"]})\r\n    \r\n    # Save annotations (without end time for the JSON output)\r\n    json_output = [{\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"]} for a in unique_annotations]\r\n    with open(output_json, 'w') as f:\r\n        json.dump(json_output, f, indent=2)\r\n    print(f\"Saved {len(json_output)} annotations to {output_json}\")\r\n    \r\n    # Extract clips and stitch them\r\n    if unique_annotations:\r\n        print(\"Extracting filler clips...\")\r\n        clips = []\r\n        for i, a in enumerate(unique_annotations):\r\n            clip_file = f\"/tmp/clip_{i:04d}.mp4\"\r\n            start = max(0, a[\"timestamp\"] - 0.1)\r\n            duration = a[\"end\"] - a[\"timestamp\"] + 0.2\r\n            cmd = [\r\n                \"ffmpeg\", \"-y\", \"-i\", input_video,\r\n                \"-ss\", str(start), \"-t\", str(duration),\r\n                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\r\n                clip_file\r\n            ]\r\n            subprocess.run(cmd, capture_output=True)\r\n            if os.path.exists(clip_file):\r\n                clips.append(clip_file)\r\n        \r\n        if clips:\r\n            # Create concat file\r\n            with open(\"/tmp/concat.txt\", 'w') as f:\r\n                for clip in clips:\r\n                    f.write(f\"file '{clip}'\\n\")\r\n            \r\n            # Concatenate clips\r\n            cmd = [\r\n                \"ffmpeg\", \"-y\", \"-f\", \"concat\", \"-safe\", \"0\",\r\n                \"-i\", \"/tmp/concat.txt\",\r\n                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\r\n                output_video\r\n            ]\r\n            subprocess.run(cmd, capture_output=True)\r\n            print(f\"Created output video: \u001b[?2004h> "]
