[558.325529, "o", "                        if i + 1 < len(words):\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.325576, "o", "> "]
[558.325658, "o", "                            next_word = words[i + 1][\"word\"].strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.325705, "o", "> "]
[558.325815, "o", "                            if len(filler_words) > 1 and next_word == filler_words[1]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.3259, "o", "                                annotations.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.325959, "o", "> "]
[558.326018, "o", "                                    \"word\": filler,\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.326063, "o", "> "]
[558.326147, "o", "                                    \"timestamp\": round(word_info[\"start\"], 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.326195, "o", "> "]
[558.326323, "o", "                                    \"end\": round(words[i + len(filler_words) - 1][\"end\"], 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.326412, "o", "                                })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[558.326497, "o", "> "]
[558.326572, "o", "        # Check for single-word fillers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.32662, "o", "        for word_info in words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.326683, "o", "            word = word_info[\"word\"].strip().lower().strip('.,!?')\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.326727, "o", "> "]
[558.32686, "o", "            for filler in [\"um\", \"uh\", \"hum\", \"hmm\", \"mhm\", \"like\", \"yeah\", \"so\", \"basically\", \"well\", \"okay\"]:\r\n\u001b[?2004l\r"]
[558.326913, "o", "\u001b[?2004h> "]
[558.326982, "o", "                if word == filler:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.327073, "o", "                    annotations.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.327175, "o", "                        \"word\": filler,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.327249, "o", "                        \"timestamp\": round(word_info[\"start\"], 2),\r\n\u001b[?2004l\r"]
[558.327336, "o", "\u001b[?2004h> "]
[558.327406, "o", "                        \"end\": round(word_info[\"end\"], 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.32749, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[558.328317, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Remove duplicates and sort by timestamp\r\n\u001b[?2004l\r\u001b[?2004h>     seen = set()\r\n\u001b[?2004l\r\u001b[?2004h>     unique_annotations = []\r\n\u001b[?2004l\r\u001b[?2004h>     for a in sorted(annotations, key=lambda x: x[\"timestamp\"]):\r\n\u001b[?2004l\r\u001b[?2004h>         key = (a[\"word\"], a[\"timestamp\"])\r\n\u001b[?2004l\r\u001b[?2004h>         if key not in seen:\r\n\u001b[?2004l\r\u001b[?2004h>             seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h>             unique_annotations.append({\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"], \"end\": a[\"end\"]})\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save annotations (without end time for the JSON output)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.328558, "o", "    json_output = [{\"word\": a[\"word\"], \"timestamp\": a[\"timestamp\"]} for a in unique_annotations]\r\n\u001b[?2004l\r\u001b[?2004h>     with open(output_json, 'w') as f:\r\n"]
[558.328691, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[558.328743, "o", "        json.dump(json_output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.32885, "o", "    print(f\"Saved {len(json_output)} annotations to {output_json}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.328921, "o", "    # Extract clips and stitch them\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.328989, "o", ">     if unique_annotations:\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.329054, "o", "> "]
[558.329092, "o", "        print(\"Extracting filler clips...\")\r\n\u001b[?2004l\r\u001b[?2004h>         clips = []\r\n"]
[558.329174, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[558.329259, "o", "        for i, a in enumerate(unique_annotations):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.329373, "o", "            clip_file = f\"/tmp/clip_{i:04d}.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.32944, "o", "            start = max(0, a[\"timestamp\"] - 0.1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.329541, "o", "> "]
[558.329617, "o", "            duration = a[\"end\"] - a[\"timestamp\"] + 0.2\r\n\u001b[?2004l\r"]
[558.329681, "o", "\u001b[?2004h> "]
[558.32975, "o", "            cmd = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.329852, "o", "                \"ffmpeg\", \"-y\", \"-i\", input_video,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.329921, "o", "                \"-ss\", str(start), \"-t\", str(duration),\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.330002, "o", "> "]
[558.33004, "o", "                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.33029, "o", "                clip_file\r\n\u001b[?2004l\r"]
[558.330391, "o", "\u001b[?2004h>             ]\r\n\u001b[?2004l\r\u001b[?2004h>             subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h>             if os.path.exists(clip_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330487, "o", "                clips.append(clip_file)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330559, "o", "        if clips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330626, "o", "            # Create concat file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330691, "o", "            with open(\"/tmp/concat.txt\", 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330767, "o", "                for clip in clips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330839, "o", "                    f.write(f\"file '{clip}'\\n\")\r\n\u001b[?2004l\r"]
[558.330911, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.330966, "o", "            # Concatenate clips\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.331038, "o", ">             cmd = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.331109, "o", "> "]
[558.331179, "o", "                \"ffmpeg\", \"-y\", \"-f\", \"concat\", \"-safe\", \"0\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331241, "o", "                \"-i\", \"/tmp/concat.txt\",\r\n\u001b[?2004l\r"]
[558.331313, "o", "\u001b[?2004h> "]
[558.331384, "o", "                \"-c:v\", \"libx264\", \"-c:a\", \"aac\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.33147, "o", "                output_video\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331549, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331621, "o", "            subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331689, "o", "            print(f\"Created output video: {output_video}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.331724, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331852, "o", "            # Cleanup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.331893, "o", "            for clip in clips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.33197, "o", "                os.remove(clip)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.332089, "o", "            os.remove(\"/tmp/concat.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.332176, "o", "    return unique_annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.332233, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[558.332314, "o", "    detect_fillers(\"/root/input.mp4\", \"/root/annotations.json\", \"/root/output.mp4\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[558.332392, "o", "> EOF\r\n\u001b[?2004l\r"]
[558.334974, "o", "\u001b[?2004hroot@14ba88551b2d:~# "]
[559.391167, "i", "python3 /root/detect_fillers.py\n"]
[559.39173, "o", "python3 /root/detect_fillers.py\r\n\u001b[?2004l\r"]
