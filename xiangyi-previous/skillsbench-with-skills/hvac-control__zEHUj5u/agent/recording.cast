[269.962832, "o", "        self.sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.962894, "o", "        self.calibration_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.962948, "o", "        self.estimated_params = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963031, "o", "        self.tuned_gains = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963109, "o", "        self.control_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963193, "o", "        self.metrics = {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963283, "o", "    def run_calibration(self, heater_power=50.0, duration=120.0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.96343, "o", "        print(f\"\\n=== CALIBRATION TEST ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.9635, "o", "        print(f\"Duration: {duration}s, Heater Power: {heater_power}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963568, "o", "        initial_temp = self.sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963656, "o", "        print(f\"Initial temperature: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963781, "o", "        results = self.sim.run_open_loop(heater_power, duration)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.963855, "o", "        self.calibration_data = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.964013, "o", "            {\"time\": r[\"time\"], \"temperature\": r[\"temperature\"], \"heater_power\": r[\"heater_power\"]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.964082, "o", "            for r in results\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[269.964147, "o", "\u001b[?2004h> "]
[269.964214, "o", "        print(f\"Collected {len(self.calibration_data)} data points\")\r\n\u001b[?2004l\r"]
[269.964284, "o", "\u001b[?2004h> "]
[269.964351, "o", "        temps = [d[\"temperature\"] for d in self.calibration_data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.96448, "o", "        print(f\"Temperature range: {min(temps):.2f}C to {max(temps):.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.964711, "o", "        calibration_log = {\"phase\": \"calibration\", \"heater_power_test\": heater_power, \"data\": self.calibration_data}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.964819, "o", "        with open(\"calibration_log.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
