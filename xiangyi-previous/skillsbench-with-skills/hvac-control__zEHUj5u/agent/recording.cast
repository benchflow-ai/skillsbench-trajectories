[45.539591, "o", "        except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.5397, "o", "            self.estimated_params = {\"K\": 0.12, \"tau\": 40.0, \"r_squared\": 0.0, \"fitting_error\": 0.0}\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[45.539727, "o", "\u001b[?2004h> "]
[45.53981, "o", "        with open(\"estimated_params.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.539934, "o", "            json.dump(self.estimated_params, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.539988, "o", "        print(\"Saved estimated_params.json\")\r\n\u001b[?2004l\r"]
[45.540036, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[45.541261, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[50.641271, "i", "cat >> control_system.py << 'EOF'\n    \n    def tune_controller_gains(self):\n        \"\"\"Calculate PID controller gains using estimated parameters.\"\"\"\n        print(f\"\\n=== CONTROLLER TUNING ===\")\n        K = self.estimated_params[\"K\"]\n        tau = self.estimated_params[\"tau\"]\n        lambda_cl = tau / 1.5\n        Kp = tau / (K * lambda_cl)\n        Ki = 1.0 / (2.0 * lambda_cl)\n        Kd = 0.0\n        self.tuned_gains = {\"Kp\": round(Kp, 4), \"Ki\": round(Ki, 4), \"Kd\": round(Kd, 4), \"lambda\": round(lambda_cl, 2)}\n        print(f\"Kp={Kp:.4f}, Ki={Ki:.4f}, lambda={lambda_cl:.2f}s\")\n        with open(\"tuned_gains.json\", \"w\") as f:\n            json.dump(self.tuned_gains, f, indent=2)\n        print(\"Saved tuned_gains.json\")\nEOF\n"]
[50.6415, "o", "cat >> control_system.py << 'EOF'\r\n\u001b[?2004l\r"]
[50.641616, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[50.641673, "o", "\u001b[?2004h>     def tune_controller_gains(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
