[123.369501, "o", "        print(f\"Settling time < 120s: {self.metrics['settling_time'] < 120.0}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.36955, "o", "> "]
[123.369609, "o", "        print(f\"Overshoot < 10%: {self.metrics['overshoot'] < 0.1}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
