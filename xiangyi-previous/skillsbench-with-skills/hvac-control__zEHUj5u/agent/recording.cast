[123.36876, "o", "        print(f\"Overshoot: {self.metrics['overshoot']*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.368905, "o", "        print(f\"Settling time: {self.metrics['settling_time']:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.369025, "o", "        print(f\"Steady-state error: {self.metrics['steady_state_error']:.4f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
