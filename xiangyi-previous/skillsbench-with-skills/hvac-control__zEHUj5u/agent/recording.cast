[204.703361, "o", "        self.estimated_params = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.703408, "o", "        self.tuned_gains = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.703509, "o", "        self.control_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.703571, "o", "        self.metrics = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.703638, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.703696, "o", "    def run_calibration(self, heater_power=50.0, duration=120.0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.703723, "o", "> "]
