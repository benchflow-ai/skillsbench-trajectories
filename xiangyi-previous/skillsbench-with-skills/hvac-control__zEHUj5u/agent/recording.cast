[347.03448, "i", "python3 << 'PYEOF'\nimport json\n\nwith open('control_system_final.py', 'r') as f:\n    content = f.read()\n\nold_line = \"        lambda_cl = tau / 1.5\"\nnew_line = \"        lambda_cl = tau / 2.0\"\ncontent = content.replace(old_line, new_line)\n\nwith open('control_system_final.py', 'w') as f:\n    f.write(content)\n\nprint(\"Updated tuning formula: lambda_cl = tau / 2.0\")\nPYEOF\n"]
