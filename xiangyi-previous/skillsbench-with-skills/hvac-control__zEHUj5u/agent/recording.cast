[147.837789, "i", "python3 << 'PYEOF'\nfrom hvac_simulator import HVACSimulator\nimport numpy as np\n\nsim = HVACSimulator()\ninitial_temp = sim.reset()\nprint(f\"Initial temp: {initial_temp:.2f}C\")\nprint(f\"Ambient temp: {sim.get_ambient_temp()}C\")\nprint(f\"Running 120s calibration with 50% heater power...\")\n\nresults = sim.run_open_loop(50.0, 120.0)\ntemps = [r[\"temperature\"] for r in results]\nprint(f\"Final temp: {temps[-1]:.2f}C\")\nprint(f\"Temperature rise: {temps[-1] - initial_temp:.2f}C\")\nprint(f\"Last 10 temps (should stabilize): {[f'{t:.2f}' for t in temps[-10:]]}\")\nPYEOF\n"]
[147.83803, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.838138, "o", "from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.83819, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[147.838322, "o", "> sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> initial_temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.838423, "o", "print(f\"Initial temp: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.838533, "o", "print(f\"Ambient temp: {sim.get_ambient_temp()}C\")\r\n\u001b[?2004l\r"]
[147.838605, "o", "\u001b[?2004h> "]
[147.838653, "o", "print(f\"Running 120s calibration with 50% heater power...\")\r\n\u001b[?2004l\r"]
[147.838795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[147.838826, "o", "> results = sim.run_open_loop(50.0, 120.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.838879, "o", "temps = [r[\"temperature\"] for r in results]\r\n\u001b[?2004l\r\u001b[?2004h> "]
