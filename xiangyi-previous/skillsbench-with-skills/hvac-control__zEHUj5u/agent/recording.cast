[334.162562, "i", "python3 << 'PYEOF'\nwith open('control_system_final.py', 'r') as f:\n    content = f.read()\ncontent = content.replace(\n    'return T_ambient + (K_percent / 100.0) * heater_power * (1.0 - np.exp(-t / tau))',\n    'return T_ambient + K_percent * heater_power / 100.0 * (1.0 - np.exp(-t / tau))'\n)\nwith open('control_system_final.py', 'w') as f:\n    f.write(content)\nprint(\"Fixed model equation\")\nPYEOF\n"]
[334.162794, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
