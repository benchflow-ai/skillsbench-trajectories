[92.922754, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[99.748997, "i", "cat > control_system_v2.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nfrom pathlib import Path\nfrom hvac_simulator import HVACSimulator\nfrom scipy.optimize import curve_fit\n\nclass TemperatureController:\n    def __init__(self):\n        self.sim = HVACSimulator()\n        self.calibration_data = []\n        self.estimated_params = {}\n        self.tuned_gains = {}\n        self.control_data = []\n        self.metrics = {}\n    \n    def run_calibration(self, heater_power=50.0, duration=35.0):\n        print(f\"\\n=== CALIBRATION TEST ===\")\n        print(f\"Duration: {duration}s, Heater Power: {heater_power}%\")\n        initial_temp = self.sim.reset()\n        print(f\"Initial temperature: {initial_temp:.2f}C\")\n        results = self.sim.run_open_loop(heater_power, duration)\n        self.calibration_data = [\n            {\"time\": r[\"time\"], \"temperature\": r[\"temperature\"], \"heater_power\": r[\"heater_power\"]}\n            for r in results\n        ]\n        print(f\"Collected {len(self.calibration_data)} data points\")\n        temps = [d[\"temperature\"] for d in self.calibration_data]\n        print(f\"Temperature range: {min(temps):.2f}C to {max(temps):.2f}C\")\n        calibration_log = {\"phase\": \"calibration\", \"heater_power_test\": heater_power, \"data\": self.calibration_data}\n        with open(\"calibration_log.json\", \"w\") as f:\n            json.dump(calibration_log, f, indent=2)\n        print(\"Saved calibration_log.json\")\nEOF\n"]
[99.74928, "o", "cat > control_system_v2.py << 'EOF'\r\n\u001b[?2004l\r"]
[99.749326, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749373, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749421, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749466, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749581, "o", "from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749621, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.74988, "o", "class TemperatureController:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749929, "o", "        self.calibration_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.749967, "o", "        self.estimated_params = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750054, "o", "        self.tuned_gains = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750094, "o", "        self.control_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750183, "o", "        self.metrics = {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750316, "o", "    def run_calibration(self, heater_power=50.0, duration=35.0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750356, "o", "        print(f\"\\n=== CALIBRATION TEST ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750529, "o", "        print(f\"Duration: {duration}s, Heater Power: {heater_power}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750609, "o", "        initial_temp = self.sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.75068, "o", "        print(f\"Initial temperature: {initial_temp:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.75079, "o", "        results = self.sim.run_open_loop(heater_power, duration)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.750883, "o", "        self.calibration_data = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751028, "o", "            {\"time\": r[\"time\"], \"temperature\": r[\"temperature\"], \"heater_power\": r[\"heater_power\"]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751125, "o", "            for r in results\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[99.751193, "o", "\u001b[?2004h> "]
[99.751275, "o", "        print(f\"Collected {len(self.calibration_data)} data points\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751359, "o", "        temps = [d[\"temperature\"] for d in self.calibration_data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751498, "o", "        print(f\"Temperature range: {min(temps):.2f}C to {max(temps):.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.75167, "o", "        calibration_log = {\"phase\": \"calibration\", \"heater_power_test\": heater_power, \"data\": self.calibration_data}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751783, "o", "        with open(\"calibration_log.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751868, "o", "            json.dump(calibration_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751949, "o", "        print(\"Saved calibration_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.751989, "o", "EOF\r\n\u001b[?2004l\r"]
[99.753302, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[106.916471, "i", "cat >> control_system_v2.py << 'EOF'\n    \n    def estimate_parameters(self):\n        print(f\"\\n=== PARAMETER ESTIMATION ===\")\n        times = np.array([d[\"time\"] for d in self.calibration_data])\n        temps = np.array([d[\"temperature\"] for d in self.calibration_data])\n        heater_power = self.calibration_data[0][\"heater_power\"]\n        T_ambient = self.sim.get_ambient_temp()\n        T_initial = temps[0]\n        T_final = temps[-1]\n        delta_T = T_final - T_initial\n        u_norm = heater_power / 100.0\n        K_est = delta_T / u_norm\n        print(f\"Initial T: {T_initial:.2f}C, Final T: {T_final:.2f}C, Delta T: {delta_T:.2f}C\")\n        print(f\"Heater power: {heater_power}%, Normalized u: {u_norm}\")\n        print(f\"Estimated K (from rise): {K_est:.6f}\")\n        T_ss = T_ambient + K_est * u_norm\n        print(f\"Predicted steady-state T: {T_ss:.2f}C\")\n        def first_order_response(t, tau):\n            return T_initial + (T_ss - T_initial) * (1.0 - np.exp(-t / tau))\n        try:\n            popt, pcov = curve_fit(first_order_response, times, temps, p0=[40.0], maxfev=10000)\n            tau_est = popt[0]\n            y_pred = first_order_response(times, tau_est)\n            ss_res = np.sum((temps - y_pred) ** 2)\n            ss_tot = np.sum((temps - np.mean(temps)) ** 2)\n            r_squared = 1.0 - (ss_res / ss_tot) if ss_tot > 0 else 0.0\n            fitting_error = np.sqrt(ss_res / len(temps))\n            self.estimated_params = {\"K\": round(K_est, 6), \"tau\": round(tau_est, 2), \"r_squared\": round(r_squared, 4), \"fitting_error\": round(fitting_error, 4)}\n            print(f\"Estimated tau: {tau_est:.2f}s, R²: {r_squared:.4f}\")\n        except Exception as e:\n            print(f\"Fitting error: {e}\")\n            self.estimated_params = {\"K\": round(K_est, 6), \"tau\": 40.0, \"r_squared\": 0.0, \"fitting_error\": 0.0}\n        with open(\"estimated_params.json\", \"w\") as f:\n            json.dump(self.estimated_params, f, indent=2)\n        print(\"Saved estimated_params.json\")\nEOF\n"]
