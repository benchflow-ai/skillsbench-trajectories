[50.641849, "o", "        print(f\"\\n=== CONTROLLER TUNING ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.641925, "o", "        K = self.estimated_params[\"K\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.641972, "o", "> "]
[50.642028, "o", "        tau = self.estimated_params[\"tau\"]\r\n\u001b[?2004l\r"]
[50.642079, "o", "\u001b[?2004h>         lambda_cl = tau / 1.5\r\n\u001b[?2004l\r"]
[50.642123, "o", "\u001b[?2004h> "]
[50.642176, "o", "        Kp = tau / (K * lambda_cl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.642225, "o", "        Ki = 1.0 / (2.0 * lambda_cl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.642275, "o", "        Kd = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.642472, "o", "        self.tuned_gains = {\"Kp\": round(Kp, 4), \"Ki\": round(Ki, 4), \"Kd\": round(Kd, 4), \"lambda\": round(lambda_cl, 2)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.642569, "o", "        print(f\"Kp={Kp:.4f}, Ki={Ki:.4f}, lambda={lambda_cl:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.642628, "o", "> "]
[50.642679, "o", "        with open(\"tuned_gains.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.642764, "o", "            json.dump(self.tuned_gains, f, indent=2)\r\n\u001b[?2004l\r"]
