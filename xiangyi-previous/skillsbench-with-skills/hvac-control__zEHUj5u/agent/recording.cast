[194.539555, "o", "PYEOF\r\n\u001b[?2004l\r"]
[194.551634, "o", "Actual K from simulator: 0.12\r\nActual tau from simulator: 40.0\r\nExpected steady-state temp with 50% power: 24.0C\r\n"]
