[123.368011, "o", "        last_30s_idx = np.where(times >= times[-1] - 30)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.368263, "o", "        steady_state_error = np.mean(np.abs(errors[last_30s_idx])) if len(last_30s_idx) > 0 else np.mean(np.abs(errors))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.368542, "o", "        self.metrics = {\"rise_time\": round(rise_time, 2), \"overshoot\": round(overshoot, 4), \"settling_time\": round(settling_time, 2), \"steady_state_error\": round(steady_state_error, 4), \"max_temp\": round(max_temp, 2)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
