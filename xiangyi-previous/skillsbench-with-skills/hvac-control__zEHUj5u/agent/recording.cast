[334.192943, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[341.409925, "i", "python3 << 'PYEOF'\nK = 12.006487\ntau = 39.56\nlambda_cl = tau / 1.5\nKp = tau / (K * lambda_cl)\nKi = 1.0 / (2.0 * lambda_cl)\nprint(f\"Current tuning: Kp={Kp:.4f}, Ki={Ki:.4f}\")\nprint(f\"\\nWith K={K:.2f} (which is correct for 0-100% heater power):\")\nprint(f\"Steady-state with 50% power: {18 + K*50/100:.2f}C\")\nprint(f\"\\nThe issue is that the controller is too slow.\")\nprint(f\"Let me increase the gains by making lambda_cl smaller...\")\nlambda_cl_new = tau / 2.0\nKp_new = tau / (K * lambda_cl_new)\nKi_new = 1.0 / (2.0 * lambda_cl_new)\nprint(f\"\\nWith lambda_cl={lambda_cl_new:.2f}s:\")\nprint(f\"Kp={Kp_new:.4f}, Ki={Ki_new:.4f}\")\nPYEOF\n"]
