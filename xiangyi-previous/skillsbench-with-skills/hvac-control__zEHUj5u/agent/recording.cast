[204.701092, "i", "cat > control_system_v3.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\nfrom scipy.optimize import curve_fit\n\nclass TemperatureController:\n    def __init__(self):\n        self.sim = HVACSimulator()\n        self.calibration_data = []\n        self.estimated_params = {}\n        self.tuned_gains = {}\n        self.control_data = []\n        self.metrics = {}\n    \n    def run_calibration(self, heater_power=50.0, duration=120.0):\n        print(f\"\\n=== CALIBRATION TEST ===\")\n        print(f\"Duration: {duration}s, Heater Power: {heater_power}%\")\n        initial_temp = self.sim.reset()\n        print(f\"Initial temperature: {initial_temp:.2f}C\")\n        results = self.sim.run_open_loop(heater_power, duration)\n        self.calibration_data = [\n            {\"time\": r[\"time\"], \"temperature\": r[\"temperature\"], \"heater_power\": r[\"heater_power\"]}\n            for r in results\n        ]\n        print(f\"Collected {len(self.calibration_data)} data points\")\n        temps = [d[\"temperature\"] for d in self.calibration_data]\n        print(f\"Temperature range: {min(temps):.2f}C to {max(temps):.2f}C\")\n        calibration_log = {\"phase\": \"calibration\", \"heater_power_test\": heater_power, \"data\": self.calibration_data}\n        with open(\"calibration_log.json\", \"w\") as f:\n            json.dump(calibration_log, f, indent=2)\n        print(\"Saved calibration_log.json\")\nEOF\n"]
[204.702751, "o", "cat > control_system_v3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.702907, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
