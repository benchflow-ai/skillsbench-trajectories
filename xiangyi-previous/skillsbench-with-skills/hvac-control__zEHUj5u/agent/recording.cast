[285.199143, "i", "cat >> control_system_final.py << 'EOF'\n    \n    def tune_controller_gains(self):\n        print(f\"\\n=== CONTROLLER TUNING ===\")\n        K = self.estimated_params[\"K\"]\n        tau = self.estimated_params[\"tau\"]\n        lambda_cl = tau / 1.5\n        Kp = tau / (K * lambda_cl)\n        Ki = 1.0 / (2.0 * lambda_cl)\n        Kd = 0.0\n        self.tuned_gains = {\"Kp\": round(Kp, 4), \"Ki\": round(Ki, 4), \"Kd\": round(Kd, 4), \"lambda\": round(lambda_cl, 2)}\n        print(f\"K={K:.6f}, tau={tau:.2f}s, lambda={lambda_cl:.2f}s\")\n        print(f\"Kp={Kp:.4f}, Ki={Ki:.4f}\")\n        with open(\"tuned_gains.json\", \"w\") as f:\n            json.dump(self.tuned_gains, f, indent=2)\n        print(\"Saved tuned_gains.json\")\n    \n    def run_closed_loop_control(self, duration=150.0):\n        print(f\"\\n=== CLOSED-LOOP CONTROL ===\")\n        setpoint = self.sim.get_setpoint()\n        Kp = self.tuned_gains[\"Kp\"]\n        Ki = self.tuned_gains[\"Ki\"]\n        initial_temp = self.sim.reset()\n        print(f\"Initial temp: {initial_temp:.2f}C, Setpoint: {setpoint}C\")\n        integral_error = 0.0\n        dt = self.sim.get_dt()\n        steps = int(duration / dt)\n        temps = [initial_temp]\n        times = [0.0]\n        errors = [setpoint - initial_temp]\n        for step in range(steps):\n            current_temp = self.sim.temperature + np.random.normal(0, self.sim.noise_std)\n            error = setpoint - current_temp\n            integral_error += error * dt\n            heater_power = Kp * error + Ki * integral_error\n            heater_power = np.clip(heater_power, 0.0, 100.0)\n            result = self.sim.step(heater_power)\n            self.control_data.append({\"time\": result[\"time\"], \"temperature\": result[\"temperature\"], \"setpoint\": setpoint, \"heater_power\": result[\"heater_power\"], \"error\": round(setpoint - result[\"temperature\"], 4)})\n            temps.append(result[\"temperature\"])\n            times.append(result[\"time\"])\n            errors.append(setpoint - result[\"temperature\"])\n            if step % 20 == 0:\n                print(f\"t={result['time']:6.1f}s: T={result['temperature']:6.2f}C, E={error:6.2f}C, P={heater_power:6.1f}%\")\n        control_log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": self.control_data}\n        with open(\"control_log.json\", \"w\") as f:\n            json.dump(control_log, f, indent=2)\n        print(\"Saved control_log.json\")\n        self.calculate_metrics(np.array(temps), np.array(times), np.array(errors), setpoint)\nEOF\n"]
[285.199514, "o", "cat >> control_system_final.py << 'EOF'\r\n\u001b[?2004l\r"]
