[269.96612, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[276.58798, "i", "cat >> control_system_final.py << 'EOF'\n    \n    def estimate_parameters(self):\n        print(f\"\\n=== PARAMETER ESTIMATION ===\")\n        times = np.array([d[\"time\"] for d in self.calibration_data])\n        temps = np.array([d[\"temperature\"] for d in self.calibration_data])\n        heater_power = self.calibration_data[0][\"heater_power\"]\n        T_ambient = self.sim.get_ambient_temp()\n        \n        def first_order_response(t, K_percent, tau):\n            return T_ambient + (K_percent / 100.0) * heater_power * (1.0 - np.exp(-t / tau))\n        \n        try:\n            popt, pcov = curve_fit(first_order_response, times, temps, p0=[0.12, 40.0], maxfev=5000)\n            K_percent, tau_est = popt\n            y_pred = first_order_response(times, K_percent, tau_est)\n            ss_res = np.sum((temps - y_pred) ** 2)\n            ss_tot = np.sum((temps - np.mean(temps)) ** 2)\n            r_squared = 1.0 - (ss_res / ss_tot) if ss_tot > 0 else 0.0\n            fitting_error = np.sqrt(ss_res / len(temps))\n            self.estimated_params = {\"K\": round(K_percent, 6), \"tau\": round(tau_est, 2), \"r_squared\": round(r_squared, 4), \"fitting_error\": round(fitting_error, 4)}\n            print(f\"Estimated K: {K_percent:.6f} C per % power\")\n            print(f\"Estimated tau: {tau_est:.2f}s\")\n            print(f\"R-squared: {r_squared:.4f}\")\n        except Exception as e:\n            print(f\"Fitting error: {e}, using defaults\")\n            self.estimated_params = {\"K\": 0.12, \"tau\": 40.0, \"r_squared\": 0.0, \"fitting_error\": 0.0}\n        with open(\"estimated_params.json\", \"w\") as f:\n            json.dump(self.estimated_params, f, indent=2)\n        print(\"Saved estimated_params.json\")\nEOF\n"]
