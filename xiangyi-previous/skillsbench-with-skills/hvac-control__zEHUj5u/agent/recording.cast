[115.313473, "i", "cat >> control_system_v2.py << 'EOF'\n    \n    def tune_controller_gains(self):\n        print(f\"\\n=== CONTROLLER TUNING ===\")\n        K = self.estimated_params[\"K\"]\n        tau = self.estimated_params[\"tau\"]\n        lambda_cl = tau / 1.5\n        Kp = tau / (K * lambda_cl)\n        Ki = 1.0 / (2.0 * lambda_cl)\n        Kd = 0.0\n        self.tuned_gains = {\"Kp\": round(Kp, 4), \"Ki\": round(Ki, 4), \"Kd\": round(Kd, 4), \"lambda\": round(lambda_cl, 2)}\n        print(f\"K={K:.6f}, tau={tau:.2f}s\")\n        print(f\"Kp={Kp:.4f}, Ki={Ki:.4f}, lambda={lambda_cl:.2f}s\")\n        with open(\"tuned_gains.json\", \"w\") as f:\n            json.dump(self.tuned_gains, f, indent=2)\n        print(\"Saved tuned_gains.json\")\n    \n    def run_closed_loop_control(self, duration=150.0):\n        print(f\"\\n=== CLOSED-LOOP CONTROL ===\")\n        setpoint = self.sim.get_setpoint()\n        Kp = self.tuned_gains[\"Kp\"]\n        Ki = self.tuned_gains[\"Ki\"]\n        initial_temp = self.sim.reset()\n        print(f\"Initial temp: {initial_temp:.2f}C, Setpoint: {setpoint}C\")\n        integral_error = 0.0\n        dt = self.sim.get_dt()\n        steps = int(duration / dt)\n        temps = [initial_temp]\n        times = [0.0]\n        errors = [setpoint - initial_temp]\n        for step in range(steps):\n            current_temp = self.sim.temperature + np.random.normal(0, self.sim.noise_std)\n            error = setpoint - current_temp\n            integral_error += error * dt\n            heater_power = Kp * error + Ki * integral_error\n            heater_power = np.clip(heater_power, 0.0, 100.0)\n            result = self.sim.step(heater_power)\n            self.control_data.append({\"time\": result[\"time\"], \"temperature\": result[\"temperature\"], \"setpoint\": setpoint, \"heater_power\": result[\"heater_power\"], \"error\": round(setpoint - result[\"temperature\"], 4)})\n            temps.append(result[\"temperature\"])\n            times.append(result[\"time\"])\n            errors.append(setpoint - result[\"temperature\"])\n            if step % 20 == 0:\n                print(f\"t={result['time']:6.1f}s: T={result['temperature']:6.2f}C, E={error:6.2f}C, P={heater_power:6.1f}%\")\n        control_log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": self.control_data}\n        with open(\"control_log.json\", \"w\") as f:\n            json.dump(control_log, f, indent=2)\n        print(\"Saved control_log.json\")\n        self.calculate_metrics(np.array(temps), np.array(times), np.array(errors), setpoint)\nEOF\n"]
[115.313863, "o", "cat >> control_system_v2.py << 'EOF'\r\n\u001b[?2004l\r"]
[115.313976, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314043, "o", "    def tune_controller_gains(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314084, "o", "        print(f\"\\n=== CONTROLLER TUNING ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.31414, "o", "> "]
[115.314225, "o", "        K = self.estimated_params[\"K\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314251, "o", "        tau = self.estimated_params[\"tau\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314364, "o", "        lambda_cl = tau / 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314495, "o", "        Kp = tau / (K * lambda_cl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314661, "o", "        Ki = 1.0 / (2.0 * lambda_cl)\r\n\u001b[?2004l\r\u001b[?2004h>         Kd = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.314789, "o", "        self.tuned_gains = {\"Kp\": round(Kp, 4), \"Ki\": round(Ki, 4), \"Kd\": round(Kd, 4), \"lambda\": round(lambda_cl, 2)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.31483, "o", "        print(f\"K={K:.6f}, tau={tau:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315066, "o", "        print(f\"Kp={Kp:.4f}, Ki={Ki:.4f}, lambda={lambda_cl:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>         with open(\"tuned_gains.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315189, "o", "            json.dump(self.tuned_gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315277, "o", "        print(\"Saved tuned_gains.json\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315644, "o", "    def run_closed_loop_control(self, duration=150.0):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\n=== CLOSED-LOOP CONTROL ===\")\r\n\u001b[?2004l\r\u001b[?2004h>         setpoint = self.sim.get_setpoint()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315744, "o", "        Kp = self.tuned_gains[\"Kp\"]\r\n\u001b[?2004l\r\u001b[?2004h>         Ki = self.tuned_gains[\"Ki\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315848, "o", "        initial_temp = self.sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.315972, "o", "        print(f\"Initial temp: {initial_temp:.2f}C, Setpoint: {setpoint}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316036, "o", "        integral_error = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316087, "o", "        dt = self.sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.316123, "o", "> "]
[115.316317, "o", "        steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h>         temps = [initial_temp]\r\n\u001b[?2004l\r\u001b[?2004h>         times = [0.0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316357, "o", "        errors = [setpoint - initial_temp]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316489, "o", "        for step in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316559, "o", "            current_temp = self.sim.temperature + np.random.normal(0, self.sim.noise_std)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.316592, "o", "> "]
[115.316649, "o", "            error = setpoint - current_temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316757, "o", "            integral_error += error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.316853, "o", "            heater_power = Kp * error + Ki * integral_error\r\n"]
[115.316921, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[115.316997, "o", "            heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.31709, "o", "            result = self.sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.317115, "o", "> "]
[115.317434, "o", "            self.control_data.append({\"time\": result[\"time\"], \"temperature\": result[\"temperature\"], \"setpoint\": setpoint, \"heater_power\": result[\"heater_power\"], \"error\": round(setpoint - result[\"temperature\"], 4)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.31752, "o", "            temps.append(result[\"temperature\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.31759, "o", "            times.append(result[\"time\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.31771, "o", "            errors.append(setpoint - result[\"temperature\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.317775, "o", "            if step % 20 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.318162, "o", "                print(f\"t={result['time']:6.1f}s: T={result['temperature']:6.2f}C, E={error:6.2f}C, P={heater_power:6.1f}%\")\r\n\u001b[?2004l\r\u001b[?2004h>         control_log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": self.control_data}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.318314, "o", "        with open(\"control_log.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.318337, "o", "            json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.318428, "o", "        print(\"Saved control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.318602, "o", "        self.calculate_metrics(np.array(temps), np.array(times), np.array(errors), setpoint)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[115.319819, "o", "\u001b[?2004hroot@517b1cce9e08:~# "]
[123.365935, "i", "cat >> control_system_v2.py << 'EOF'\n    \n    def calculate_metrics(self, temps, times, errors, setpoint):\n        print(f\"\\n=== PERFORMANCE METRICS ===\")\n        target_90 = temps[0] + 0.9 * (setpoint - temps[0])\n        rise_time_idx = np.where(temps >= target_90)[0]\n        rise_time = times[rise_time_idx[0]] if len(rise_time_idx) > 0 else times[-1]\n        max_temp = np.max(temps)\n        overshoot = max(0, (max_temp - setpoint) / (setpoint - temps[0])) if setpoint > temps[0] else 0\n        settled_region = np.abs(errors) < 0.5\n        if np.any(settled_region):\n            settled_idx = np.where(settled_region)[0]\n            settling_time = times[-1]\n            for i in range(len(settled_idx) - 10):\n                if np.all(settled_region[settled_idx[i]:settled_idx[i]+10]):\n                    settling_time = times[settled_idx[i]]\n                    break\n        else:\n            settling_time = times[-1]\n        last_30s_idx = np.where(times >= times[-1] - 30)[0]\n        steady_state_error = np.mean(np.abs(errors[last_30s_idx])) if len(last_30s_idx) > 0 else np.mean(np.abs(errors))\n        self.metrics = {\"rise_time\": round(rise_time, 2), \"overshoot\": round(overshoot, 4), \"settling_time\": round(settling_time, 2), \"steady_state_error\": round(steady_state_error, 4), \"max_temp\": round(max_temp, 2)}\n        print(f\"Rise time: {self.metrics['rise_time']:.2f}s\")\n        print(f\"Overshoot: {self.metrics['overshoot']*100:.2f}%\")\n        print(f\"Settling time: {self.metrics['settling_time']:.2f}s\")\n        print(f\"Steady-state error: {self.metrics['steady_state_error']:.4f}C\")\n        print(f\"Max temp: {self.metrics['max_temp']:.2f}C\")\n        print(f\"\\n=== REQUIREMENT VERIFICATION ===\")\n        print(f\"Steady-state error < 0.5C: {self.metrics['steady_state_error'] < 0.5}\")\n        print(f\"Settling time < 120s: {self.metrics['settling_time'] < 120.0}\")\n        print(f\"Overshoot < 10%: {self.metrics['overshoot'] < 0.1}\")\n        print(f\"Max temp < 30C: {self.metrics['max_temp'] < 30.0}\")\n        with open(\"metrics.json\", \"w\") as f:\n            json.dump(self.metrics, f, indent=2)\n        print(\"Saved metrics.json\")\n\nif __name__ == \"__main__\":\n    controller = TemperatureController()\n    controller.run_calibration(heater_power=50.0, duration=35.0)\n    controller.estimate_parameters()\n    controller.tune_controller_gains()\n    controller.run_closed_loop_control(duration=150.0)\n    print(\"\\n=== ALL PHASES COMPLETE ===\")\nEOF\n"]
