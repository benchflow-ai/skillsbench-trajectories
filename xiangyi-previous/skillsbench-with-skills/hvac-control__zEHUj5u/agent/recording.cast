[204.704523, "o", "            {\"time\": r[\"time\"], \"temperature\": r[\"temperature\"], \"heater_power\": r[\"heater_power\"]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.704691, "o", "            for r in results\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.704777, "o", "        print(f\"Collected {len(self.calibration_data)} data points\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.70489, "o", "        temps = [d[\"temperature\"] for d in self.calibration_data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.705011, "o", "        print(f\"Temperature range: {min(temps):.2f}C to {max(temps):.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
