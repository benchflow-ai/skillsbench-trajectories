[285.203565, "o", "            current_temp = self.sim.temperature + np.random.normal(0, self.sim.noise_std)\r\n\u001b[?2004l\r\u001b[?2004h>             error = setpoint - current_temp\r\n\u001b[?2004l\r\u001b[?2004h>             integral_error += error * dt\r\n\u001b[?2004l\r\u001b[?2004h>             heater_power = Kp * error + Ki * integral_error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.203694, "o", "            heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h>             result = self.sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.203778, "o", "> "]
[285.20413, "o", "            self.control_data.append({\"time\": result[\"time\"], \"temperature\": result[\"temperature\"], \"setpoint\": setpoint, \"heater_power\": result[\"heater_power\"], \"error\": round(setpoint - result[\"temperature\"], 4)})\r\n\u001b[?2004l\r"]
[285.204174, "o", "\u001b[?2004h> "]
[285.204267, "o", "            temps.append(result[\"temperature\"])\r\n\u001b[?2004l\r"]
[285.204357, "o", "\u001b[?2004h> "]
[285.204485, "o", "            times.append(result[\"time\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.204675, "o", "            errors.append(setpoint - result[\"temperature\"])\r\n\u001b[?2004l\r\u001b[?2004h>             if step % 20 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.204897, "o", "                print(f\"t={result['time']:6.1f}s: T={result['temperature']:6.2f}C, E={error:6.2f}C, P={heater_power:6.1f}%\")"]
[285.205, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.205054, "o", "> "]
[285.205274, "o", "        control_log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": self.control_data}"]
[285.205348, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.205498, "o", ">         with open(\"control_log.json\", \"w\") as f:"]
[285.20557, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.205719, "o", ">             json.dump(control_log, f, indent=2)"]
[285.205792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.20593, "o", ">         print(\"Saved control_log.json\")"]
[285.206003, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.206214, "o", "> "]
[285.206285, "o", "        self.calculate_metrics(np.array(temps), np.array(times), np.array(errors), setpoint)"]
[285.206351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.206422, "o", "> EOF"]
