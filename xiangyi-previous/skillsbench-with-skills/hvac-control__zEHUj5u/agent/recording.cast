[389.325283, "i", "python3 << 'PYEOF'\nfrom hvac_simulator import HVACSimulator\nimport numpy as np\n\nsim = HVACSimulator()\ninitial = sim.reset()\nprint(f\"Testing with 100% heater power for 120s...\")\nresults = sim.run_open_loop(100.0, 120.0)\ntemps = [r[\"temperature\"] for r in results]\nprint(f\"Final temp with 100% power: {temps[-1]:.2f}C\")\nprint(f\"Expected with K=0.12: {18 + 0.12*100:.2f}C\")\nprint(f\"Expected with K=12: {18 + 12*100/100:.2f}C\")\nprint(f\"\\nActual K from observed data: {(temps[-1] - 18) / 100:.4f} per % power\")\nPYEOF\n"]
