[269.96257, "o", "from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.962625, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.962691, "o", "class TemperatureController:\r\n\u001b[?2004l\r\u001b[?2004h> "]
