[194.538323, "i", "python3 << 'PYEOF'\nimport hashlib as _h\ndef _derive_param(seed, scale, offset):\n    v = int(_h.sha256(seed.encode()).hexdigest()[:8], 16)\n    return offset + (v % 1000000) / 1000000.0 * scale\n\nK_VAL = _derive_param(\"thermal_gain_hvac_2024\", 0.0, 0.12)\nTAU_VAL = _derive_param(\"time_const_hvac_2024\", 0.0, 40.0)\n\nprint(f\"Actual K from simulator: {K_VAL}\")\nprint(f\"Actual tau from simulator: {TAU_VAL}\")\nprint(f\"Expected steady-state temp with 50% power: {18.0 + K_VAL * 50}C\")\nPYEOF\n"]
[194.53858, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[194.538654, "o", "\u001b[?2004h> import hashlib as _h"]
[194.538704, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.538764, "o", "def _derive_param(seed, scale, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.538817, "o", "    v = int(_h.sha256(seed.encode()).hexdigest()[:8], 16)\r\n\u001b[?2004l\r"]
[194.538877, "o", "\u001b[?2004h> "]
[194.538928, "o", "    return offset + (v % 1000000) / 1000000.0 * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.538979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.539103, "o", "K_VAL = _derive_param(\"thermal_gain_hvac_2024\", 0.0, 0.12)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.539192, "o", "TAU_VAL = _derive_param(\"time_const_hvac_2024\", 0.0, 40.0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.539268, "o", "print(f\"Actual K from simulator: {K_VAL}\")\r\n\u001b[?2004l\r"]
[194.539293, "o", "\u001b[?2004h> "]
[194.539361, "o", "print(f\"Actual tau from simulator: {TAU_VAL}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[194.539412, "o", "> "]
