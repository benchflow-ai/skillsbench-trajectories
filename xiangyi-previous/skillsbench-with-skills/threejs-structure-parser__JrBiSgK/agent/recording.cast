[117.662287, "o", "function getGeometryData(mesh) {\r\n\u001b[?2004l\r"]
[117.662341, "o", "\u001b[?2004h> "]
[117.662436, "o", "    const geometry = mesh.geometry;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.662491, "o", "> "]
[117.66254, "o", "    mesh.updateMatrix();\r\n\u001b[?2004l\r"]
[117.662594, "o", "\u001b[?2004h> "]
[117.662667, "o", "    const matrix = mesh.matrix;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.662723, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.662774, "o", "> "]
[117.662826, "o", "    const vertices = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.662896, "o", "    const indices = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.662971, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.663027, "o", "> "]
[117.66313, "o", "    const posAttr = geometry.attributes.position;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.663203, "o", "> "]
[117.66329, "o", "    const v = new THREE.Vector3();\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.663365, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.663479, "o", "    for (let i = 0; i < posAttr.count; i++) {\r\n\u001b[?2004l\r"]
[117.66353, "o", "\u001b[?2004h> "]
[117.663623, "o", "        v.fromBufferAttribute(posAttr, i);\r\n\u001b[?2004l\r"]
[117.663685, "o", "\u001b[?2004h> "]
[117.663756, "o", "        v.applyMatrix4(matrix);\r\n\u001b[?2004l\r"]
[117.663808, "o", "\u001b[?2004h> "]
[117.66389, "o", "        vertices.push(v.x, v.y, v.z);\r\n\u001b[?2004l\r"]
[117.663947, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[117.664025, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[117.664084, "o", "\u001b[?2004h> "]
[117.664145, "o", "    if (geometry.index) {\r\n\u001b[?2004l\r"]
[117.664209, "o", "\u001b[?2004h> "]
[117.664307, "o", "        for (let i = 0; i < geometry.index.count; i++) {\r\n\u001b[?2004l\r"]
[117.664365, "o", "\u001b[?2004h> "]
[117.664463, "o", "            indices.push(geometry.index.getX(i));\r\n\u001b[?2004l\r"]
[117.664523, "o", "\u001b[?2004h> "]
[117.664576, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.664626, "o", ">     } else {\r\n\u001b[?2004l\r"]
[117.664675, "o", "\u001b[?2004h> "]
[117.664759, "o", "        for (let i = 0; i < posAttr.count; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.664812, "o", "> "]
[117.664863, "o", "            indices.push(i);\r\n\u001b[?2004l\r"]
[117.664935, "o", "\u001b[?2004h>         }"]
[117.664991, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.66505, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.665114, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.665252, "o", "    return { vertices, indices, name: mesh.name };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.665308, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.665365, "o", "> "]
[117.665422, "o", "function savePart(group) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.665475, "o", "> "]
[117.665534, "o", "    const partName = group.name;\r\n\u001b[?2004l\r"]
[117.665587, "o", "\u001b[?2004h> "]
[117.665682, "o", "    const meshes = group.children.filter(c => c.isMesh);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.665734, "o", "> "]
[117.665784, "o", "    if (meshes.length === 0) return;\r\n\u001b[?2004l\r"]
[117.665842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.6659, "o", "\u001b[?2004h> "]
[117.666028, "o", "    const partDir = path.join('/root/output/part_meshes', partName);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.666203, "o", "    if (!fs.existsSync(partDir)) fs.mkdirSync(partDir, { recursive: true });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.66626, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.666331, "o", "    let linkVertices = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.666391, "o", "> "]
[117.666463, "o", "    let linkIndices = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.666543, "o", "    let vertexOffset = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.666596, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.666667, "o", "    meshes.forEach(mesh => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.666724, "o", "> "]
[117.666799, "o", "        const data = getGeometryData(mesh);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.66685, "o", ">         \r\n\u001b[?2004l\r"]
[117.666898, "o", "\u001b[?2004h> "]
[117.666945, "o", "        // Save individual mesh\r\n\u001b[?2004l\r"]
[117.666996, "o", "\u001b[?2004h> "]
[117.667086, "o", "        let meshObj = `o ${data.name}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.667161, "o", "> "]
[117.66728, "o", "        for (let i = 0; i < data.vertices.length; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.667461, "o", "            meshObj += `v ${data.vertices[i]} ${data.vertices[i+1]} ${data.vertices[i+2]}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.667521, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.667646, "o", "        for (let i = 0; i < data.indices.length; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.667833, "o", "            meshObj += `f ${data.indices[i] + 1} ${data.indices[i+1] + 1} ${data.indices[i+2] + 1}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.66789, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.667947, "o", "> "]
[117.668074, "o", "        fs.writeFileSync(path.join(partDir, mesh.name + '.obj'), meshObj);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.668129, "o", "\u001b[?2004h> "]
[117.668201, "o", "        // Accumulate for link\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668254, "o", "> "]
[117.668337, "o", "        linkVertices.push(...data.vertices);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668389, "o", "> "]
[117.668481, "o", "        for (let i = 0; i < data.indices.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668543, "o", "> "]
[117.668648, "o", "            linkIndices.push(data.indices[i] + vertexOffset);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668704, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668756, "o", "> "]
[117.66884, "o", "        vertexOffset += data.vertices.length / 3;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.668978, "o", ">     });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669047, "o", "    // Save link mesh\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669128, "o", "    let linkObj = `o ${partName}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.669197, "o", "> "]
[117.669316, "o", "    for (let i = 0; i < linkVertices.length; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.66948, "o", "        linkObj += `v ${linkVertices[i]} ${linkVertices[i+1]} ${linkVertices[i+2]}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669545, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669664, "o", "    for (let i = 0; i < linkIndices.length; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669843, "o", "        linkObj += `f ${linkIndices[i] + 1} ${linkIndices[i+1] + 1} ${linkIndices[i+2] + 1}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.669905, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.670058, "o", "    fs.writeFileSync(path.join('/root/output/links', partName + '.obj'), linkObj);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.670118, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670174, "o", "> try {\r\n\u001b[?2004l\r"]
[117.670226, "o", "\u001b[?2004h> "]
[117.670263, "o", "    const root = createScene();\r\n\u001b[?2004l\r"]
[117.670294, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670327, "o", "> "]
[117.67036, "o", "    function traverse(node) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.67039, "o", "> "]
[117.670422, "o", "        if (node.isGroup) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670452, "o", "> "]
[117.670486, "o", "            savePart(node);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670517, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670549, "o", "> "]
[117.670601, "o", "        node.children.forEach(child => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670633, "o", "> "]
[117.670692, "o", "            if (child.isGroup) traverse(child);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670722, "o", ">         });\r\n\u001b[?2004l\r"]
[117.670749, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[117.670787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.67082, "o", "\u001b[?2004h>     traverse(root);\r\n\u001b[?2004l\r"]
[117.670856, "o", "\u001b[?2004h> "]
[117.670907, "o", "    console.log('Conversion complete.');\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.670935, "o", "> "]
[117.670963, "o", "} catch (error) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.671051, "o", "    console.error('Error during conversion:', error);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.671078, "o", "> "]
[117.67111, "o", "    process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.671141, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[117.691244, "o", "\u001b[?2004hroot@b3c7eec982b2:~# "]
