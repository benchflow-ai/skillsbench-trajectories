[28.199079, "i", "cat << 'EOF' > extract_pdf.py\nimport pdfplumber\nimport pandas as pd\n\ndata = []\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for page in pdf.pages:\n        table = page.extract_table()\n        if table:\n            # Assuming the first row of the first page is the header\n            if not data:\n                header = table[0]\n                data.extend(table[1:])\n            else:\n                data.extend(table)\n\ndf = pd.DataFrame(data, columns=header)\ndf.to_csv('/root/population.csv', index=False)\nprint(\"PDF data extracted to /root/population.csv\")\nprint(df.head())\nEOF\n"]
