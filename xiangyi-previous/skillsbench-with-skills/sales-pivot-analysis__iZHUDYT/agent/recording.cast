[50.217142, "o", "\u001b[?2004hroot@eea7abd71e3d:~# "]
[50.37089, "i", "cat << 'EOF' > create_report.py\nimport pandas as pd\n\n# Load data\nincome_df = pd.read_excel('/root/income.xlsx')\npop_df = pd.read_csv('/root/population.csv')\n\n# Rename column if it was truncated\nif 'POPULATION_20' in pop_df.columns:\n    pop_df.rename(columns={'POPULATION_20': 'POPULATION_2023'}, inplace=True)\n\n# Merge dataframes\n# We'll use SA2_CODE as the primary key\nmerged_df = pd.merge(income_df, pop_df[['SA2_CODE', 'STATE', 'POPULATION_2023']], on='SA2_CODE', how='left')\n\n# Enrich SourceData\n# Calculate Total\nmerged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\n\n# Calculate Quarter based on MEDIAN_INCOME quartiles across all regions\nmerged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], 4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\n\n# 1. Population by State\npivot1 = merged_df.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')\n\n# 2. Earners by State\npivot2 = merged_df.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')\n\n# 3. Regions by State\npivot3 = merged_df.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')\npivot3.columns = ['Count']\n\n# 4. State Income Quartile\npivot4 = merged_df.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum', observed=False)\n\n# Save to Excel\nwith pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:\n    pivot1.to_excel(writer, sheet_name='Population by State')\n    pivot2.to_excel(writer, sheet_name='Earners by State')\n    pivot3.to_excel(writer, sheet_name='Regions by State')\n    pivot4.to_excel(writer, sheet_name='State Income Quartile')\n    merged_df.to_excel(writer, sheet_name='SourceData', index=False)\n\nprint(\"Report created successfully at /root/demographic_analysis.xlsx\")\nEOF\n"]
