[?2004hroot@eea7abd71e3d:~# cat << 'EOF' > create_report.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> income_df = pd.read_excel('/root/income.xlsx')
[?2004l[?2004h> pop_df = pd.read_csv('/root/population.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Clean population data: remove repeated headers
[?2004l[?2004h> if 'SA2_CODE' in pop_df.columns:
[?2004l[?2004h>     pop_df = pop_df[pop_df['SA2_CODE'] != 'SA2_CODE'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure SA2_CODE is the same type (string) and remove any potential whitespace
[?2004l[?2004h> income_df['SA2_CODE'] = income_df['SA2_CODE'].astype(str).str.strip()
[?2004l[?2004h> pop_df['SA2_CODE'] = pop_df['SA2_CODE'].astype(str).str.strip()
[?2004l[?2004h> 
[?2004l[?2004h> # Rename column if it was truncated
[?2004l[?2004h> if 'POPULATION_20' in pop_df.columns:
[?2004l[?2004h>     pop_df.rename(columns={'POPULATION_20': 'POPULATION_2023'}, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert columns to numeric
[?2004l[?2004h> income_df['EARNERS'] = pd.to_numeric(income_df['EARNERS'], errors='coerce')
[?2004l[?2004h> income_df['MEDIAN_INCOME'] = pd.to_numeric(income_df['MEDIAN_INCOME'], errors='coerce')
[?2004l[?2004h> pop_df['POPULATION_2023'] = pd.to_numeric(pop_df['POPULATION_2023'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with NaN in essential columns if any (optional, but good for stability)
[?2004l[?2004h> # income_df = income_df.dropna(subset=['EARNERS', 'MEDIAN_INCOME'])
[?2004l[?2004h> 
[?2004l[?2004h> # Merge dataframes
[?2004l[?2004h> merged_df = pd.merge(income_df, pop_df[['SA2_CODE', 'STATE', 'POPULATION_2023']], on='SA2_CODE', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # Enrich SourceData
[?2004l[?2004h> merged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']
[?2004l[?2004h> merged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], 4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
[?2004l[?2004h> 
[?2004l[?2004h> # Create Pivot Tables
[?2004l[?2004h> pivot1 = merged_df.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')
[?2004l[?2004h> pivot2 = merged_df.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')
[?2004l[?2004h> pivot3 = merged_df.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')
[?2004l[?2004h> pivot3.columns = ['Count']
[?2004l[?2004h> pivot4 = merged_df.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum', observed=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Save to Excel
[?2004l[?2004h> with pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:
[?2004l[?2004h>     pivot1.to_excel(writer, sheet_name='Population by State')
[?2004l[?2004h>     pivot2.to_excel(writer, sheet_name='Earners by State')
[?2004l[?2004h>     pivot3.to_excel(writer, sheet_name='Regions by State')
[?2004l[?2004h>     pivot4.to_excel(writer, sheet_name='State Income Quartile')
[?2004l[?2004h>     merged_df.to_excel(writer, sheet_name='SourceData', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print("Report created successfully at /root/demographic_analysis.xlsx")
