[930.520999, "o", "import os\r\nos.environ['OMP_NUM_THREADS'] = '1'\r\nimport csv\r\nimport numpy as np\r\nfrom sklearn.cluster import DBSCAN\r\n\r\n# Load data using csv module\r\ncitsci_groups = {}\r\nwith open('/root/data/citsci_train.csv', newline='') as f:\r\n    reader = csv.DictReader(f)\r\n    for row in reader:\r\n        key = row['file_rad']\r\n"]
[930.521133, "o", "        x = float(row['x'])\r\n        y = float(row['y'])\r\n        citsci_groups.setdefault(key, []).append((x, y))\r\n\r\nexpert_groups = {}\r\nwith open('/root/data/expert_train.csv', newline='') as f:\r\n    reader = csv.DictReader(f)\r\n    for row in reader:\r\n        key = row['file_rad']\r\n        x = float(row['x'])\r\n        y = float(row['y'])\r\n        expert_groups.setdefault(key, []).append((x, y))\r\n\r\n# Convert to numpy arrays\r\nfor k in list(citsci_groups.keys()):\r\n    citsci_groups[k] = np.array(citsci_groups[k], dtype=float)\r\n"]
[930.52116, "o", "for k in list(expert_groups.keys()):\r\n    expert_groups[k] = np.array(expert_groups[k], dtype=float)\r\n\r\nimages = list(expert_groups.keys())\r\nnum_images = len(images)\r\nempty = np.empty((0,2), dtype=float)\r\n\r\n# Hyperparameter grid\r\nmin_samples_list = list(range(3,10))\r\neps_list = list(range(4,25,2))\r\nshape_weights = [round(x,1) for x in np.arange(0.9, 2.0, 0.1)]\r\ncombos = [(ms, eps, w) for ms in min_samples_list for eps in eps_list for w in shape_weights]\r\n\r\nresults = []\r\nfor idx, (ms, eps, w) in enumerate(combos, 1):\r\n    f1_sum = 0.0\r\n    delta_sum = 0.0\r\n    delta_count = 0\r\n    scale = np.array([w, 2.0 - w])\r\n    for img in images:\r\n        exp = expert_groups.get(img, empty)\r\n        pts = citsci_groups.get(img, empty)\r\n        if pts.shape[0] == 0:\r\n            # no citsci points\r\n            f1_sum += 0.0\r\n            continue\r\n        scaled = pts * scale\r\n        labels = DBSCAN(eps=eps, min_samples=ms).fit_predict(scaled)\r\n        unique_labels = set(labels)\r\n        clusters = []\r\n        for lab in "]
[930.52117, "o", "unique_labels:\r\n            if lab == -1:\r\n                continue\r\n            clusters.append(pts[labels == lab].mean(axis=0))\r\n        if len(clusters) == 0 or exp.shape[0] == 0:"]
[930.521182, "o", "\r\n            f1_sum += 0.0\r\n            continue\r\n        clusters = np.array(clusters)\r\n        # Greedy matching using standard Euclidean distance\r\n        dists = np.linalg.norm(clusters[:, None, :] - exp[None, :, :], axis=2)\r\n        pairs = []\r\n"]
[930.521192, "o", "        for i in range(dists.shape[0]):\r\n            for j in range(dists.shape[1]):\r\n                dist = dists[i, j]\r\n"]
[930.521205, "o", "                if dist <= 100:\r\n                    pairs.append((dist, i, j))\r\n        if not pairs:\r\n            f1_sum += 0.0\r\n"]
[930.52122, "o", "            continue\r\n        pairs.sort(key=lambda x: x[0])\r\n        matched_clusters = set()\r\n"]
[930.521233, "o", "        matched_experts = set()\r\n"]
