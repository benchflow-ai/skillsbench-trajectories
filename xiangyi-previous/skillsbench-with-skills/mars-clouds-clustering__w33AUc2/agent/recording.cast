[540.045275, "i", "cat > /root/compute_pareto.py <<'PY'\nimport os\nos.environ['OMP_NUM_THREADS'] = '1'\nimport csv\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\n\n# Load data using csv module\ncitsci_groups = {}\nwith open('/root/data/citsci_train.csv', newline='') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        key = row['file_rad']\n        x = float(row['x'])\n        y = float(row['y'])\n        citsci_groups.setdefault(key, []).append((x, y))\n\nexpert_groups = {}\nwith open('/root/data/expert_train.csv', newline='') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        key = row['file_rad']\n        x = float(row['x'])\n        y = float(row['y'])\n        expert_groups.setdefault(key, []).append((x, y))\n\n# Convert to numpy arrays\nfor k in list(citsci_groups.keys()):\n    citsci_groups[k] = np.array(citsci_groups[k], dtype=float)\nfor k in list(expert_groups.keys()):\n    expert_groups[k] = np.array(expert_groups[k], dtype=float)\n\nimages = list(expert_groups.keys())\nnum_images = len(images)\nempty "]
[540.045478, "i", "= np.empty((0,2), dtype=float)\n\n# Hyperparameter grid\nmin_samples_list = list(range(3,10))\neps_list = list(range(4,25,2))\nshape_weights = [round(x,1) for x in np.arange(0.9, 2.0, 0.1)]\ncombos = [(ms, eps, w) for ms in min_samples_list for eps in eps_list for w in shape_weights]\n\nresults = []\nfor idx, (ms, eps, w) in enumerate(combos, 1):\n    f1_sum = 0.0\n    delta_sum = 0.0\n    delta_count = 0\n    scale = np.array([w, 2.0 - w])\n    for img in images:\n        exp = expert_groups.get(img, empty)\n        pts = citsci_groups.get(img, empty)\n        if pts.shape[0] == 0:\n            # no citsci points\n            f1_sum += 0.0\n            continue\n        scaled = pts * scale\n        labels = DBSCAN(eps=eps, min_samples=ms).fit_predict(scaled)\n        unique_labels = set(labels)\n        clusters = []\n        for lab in unique_labels:\n            if lab == -1:\n                continue\n            clusters.append(pts[labels == lab].mean(axis=0))\n        if len(clusters) == 0 or exp.shape[0] == 0:\n            f1_sum "]
[540.045517, "o", "cat > /root/compute_pareto.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.04557, "i", "+= 0.0\n            continue\n        clusters = np.array(clusters)\n        # Greedy matching using standard Euclidean distance\n        dists = np.linalg.norm(clusters[:, None, :] - exp[None, :, :], axis=2)\n        pairs = []\n        for i in range(dists.shape[0]):\n            for j in range(dists.shape[1]):\n                dist = dists[i, j]\n                if dist <= 100:\n                    pairs.append((dist, i, j))\n        if not pairs:\n            f1_sum += 0.0\n            continue\n        pairs.sort(key=lambda x: x[0])\n        matched_clusters = set()\n        matched_experts = set()\n        match_dists = []\n        for dist, i, j in pairs:\n            if i in matched_clusters or j in matched_experts:\n                continue\n            matched_clusters.add(i)\n            matched_experts.add(j)\n            match_dists.append(dist)\n        if len(match_dists) == 0:\n            f1_sum += 0.0\n            continue\n        tp = len(match_dists)\n        fp = len(clusters) - tp\n        fn = len(exp) - tp\n      "]
[540.045599, "o", "> import os\r\n\u001b[?2004l\r"]
[540.045637, "i", "  denom = 2*tp + fp + fn\n        f1 = 2*tp / denom if denom > 0 else 0.0\n        f1_sum += f1\n        delta_sum += np.mean(match_dists)\n        delta_count += 1\n    avg_f1 = f1_sum / num_images\n    avg_delta = delta_sum / delta_count if delta_count > 0 else np.nan\n    if avg_f1 > 0.5 and not np.isnan(avg_delta):\n        results.append((avg_f1, avg_delta, ms, eps, w))\n    if idx % 50 == 0:\n        print(f'Processed {idx}/{len(combos)} combos')\n\nif not results:\n    raise RuntimeError('No results with F1 > 0.5')\n\n# Pareto frontier\nresults_arr = np.array(results, dtype=object)\nF1 = results_arr[:,0].astype(float)\nDelta = results_arr[:,1].astype(float)\n\npareto_mask = np.ones(len(results), dtype=bool)\nfor i in range(len(results)):\n    for j in range(len(results)):\n        if i == j:\n            continue\n        if (F1[j] >= F1[i] and Delta[j] <= Delta[i] and (F1[j] > F1[i] or Delta[j] < Delta[i])):\n            pareto_mask[i] = False\n            break\n\npareto = [results[i] for i in range(len(results)) if pareto_mask["]
[540.045671, "o", "\u001b[?2004h> "]
[540.045763, "i", "i]]\npareto.sort(key=lambda x: (-x[0], x[1]))\n\n# Write output\nwith open('/root/pareto_frontier.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['F1','delta','min_samples','epsilon','shape_weight'])\n    for f1, delta, ms, eps, w in pareto:\n        writer.writerow([f\"{f1:.5f}\", f\"{delta:.5f}\", int(ms), int(eps), f\"{w:.1f}\"])\n\nprint('Saved to /root/pareto_frontier.csv with', len(pareto), 'rows')\nPY\n"]
