[256.215795, "o", "        exp = expert_groups.get(img, empty)\r\n\u001b[?2004l\r"]
[256.215809, "o", "\u001b[?2004h> "]
[256.215913, "o", "        pts = citsci_groups.get(img, empty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.215954, "o", "        if pts.shape[0] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216012, "o", "            # no citsci points\r\n\u001b[?2004l\r"]
[256.216023, "o", "\u001b[?2004h> "]
[256.216081, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216136, "o", "        scaled = pts * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216269, "o", "        labels = DBSCAN(eps=eps, min_samples=ms).fit_predict(scaled)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216335, "o", "        unique_labels = set(labels)\r\n\u001b[?2004l\r"]
[256.216347, "o", "\u001b[?2004h> "]
[256.216384, "o", "        clusters = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216468, "o", "        for lab in unique_labels:\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.216527, "o", "> "]
[256.216539, "o", "            if lab == -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216677, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216721, "o", "            clusters.append(pts[labels == lab].mean(axis=0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216795, "o", "        if len(clusters) == 0 or exp.shape[0] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.216882, "o", "            # no clusters or no expert points\r\n\u001b[?2004l\r"]
[256.216918, "o", "\u001b[?2004h> "]
[256.216935, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217022, "o", "        clusters = np.array(clusters)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217075, "o", "        # Greedy matching\r\n\u001b[?2004l\r"]
[256.217088, "o", "\u001b[?2004h> "]
[256.217243, "o", "        dists = np.linalg.norm(clusters[:, None, :] - exp[None, :, :], axis=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.21727, "o", ">         pairs = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217352, "o", "        for i in range(dists.shape[0]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217424, "o", "            for j in range(dists.shape[1]):\r\n\u001b[?2004l\r"]
[256.217468, "o", "\u001b[?2004h> "]
[256.217487, "o", "                dist = dists[i, j]\r\n\u001b[?2004l\r"]
[256.217496, "o", "\u001b[?2004h> "]
[256.217563, "o", "                if dist <= 100:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217651, "o", "                    pairs.append((dist, i, j))\r\n\u001b[?2004l\r"]
[256.217715, "o", "\u001b[?2004h> "]
[256.217732, "o", "        if not pairs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217773, "o", "            continue\r\n\u001b[?2004l\r"]
[256.217784, "o", "\u001b[?2004h> "]
[256.217826, "o", "        pairs.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[256.217835, "o", "\u001b[?2004h> "]
[256.217898, "o", "        matched_clusters = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.217971, "o", "        matched_experts = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.21798, "o", "> "]
[256.218027, "o", "        match_dists = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.218055, "o", "> "]
[256.218165, "o", "        for dist, i, j in pairs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.218241, "o", "            if i in matched_clusters or j in matched_experts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.218262, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.218303, "o", "> "]
[256.21839, "o", "            matched_clusters.add(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.218433, "o", "            matched_experts.add(j)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.218479, "o", "            match_dists.append(dist)\r\n\u001b[?2004l\r"]
[256.218492, "o", "\u001b[?2004h> "]
[256.218555, "o", "        if len(match_dists) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.218595, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.21863, "o", "> "]
[256.218666, "o", "        tp = len(match_dists)\r\n\u001b[?2004l\r"]
[256.218712, "o", "\u001b[?2004h> "]
[256.218757, "o", "        fp = len(clusters) - tp\r\n\u001b[?2004l\r"]
[256.218775, "o", "\u001b[?2004h> "]
[256.21881, "o", "        fn = len(exp) - tp\r\n\u001b[?2004l\r"]
[256.21882, "o", "\u001b[?2004h> "]
[256.218853, "o", "        denom = 2*tp + fp + fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.218869, "o", "> "]
[256.218974, "o", "        f1 = 2*tp / denom if denom > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.21902, "o", "        f1_sum += f1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.219117, "o", "        delta_sum += np.mean(match_dists)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.219141, "o", "        delta_count += 1\r\n\u001b[?2004l\r"]
[256.219172, "o", "\u001b[?2004h> "]
[256.219362, "o", "    avg_f1 = f1_sum / num_images\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.219535, "o", "    avg_delta = delta_sum / delta_count if delta_count > 0 else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.219627, "o", "    if avg_f1 > 0.5 and not np.isnan(avg_delta):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.21971, "o", "        results.append((avg_f1, avg_delta, ms, eps, w))\r\n\u001b[?2004l\r"]
[256.219732, "o", "\u001b[?2004h>     if idx % 50 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.219742, "o", "> "]
[256.219838, "o", "        print(f'Processed {idx}/{len(combos)} combos')\r\n\u001b[?2004l\r"]
[256.219852, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.219893, "o", "if not results:\r\n\u001b[?2004l\r"]
[256.219903, "o", "\u001b[?2004h> "]
[256.219995, "o", "    raise RuntimeError('No results with F1 > 0.5')\r\n\u001b[?2004l\r"]
[256.220011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[256.22002, "o", "\u001b[?2004h> "]
[256.220124, "o", "# DataFrame and Pareto frontier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220168, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220185, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[256.22021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[256.220254, "o", "\u001b[?2004h> "]
[256.22036, "o", "df = pd.DataFrame(results, columns=['F1','delta','min_samples','epsilon','shape_weight'])\r\n\u001b[?2004l\r"]
[256.220377, "o", "\u001b[?2004h> "]
[256.220453, "o", "vals = df[['F1','delta']].values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220544, "o", "pareto_mask = np.ones(len(df), dtype=bool)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220582, "o", "for i in range(len(df)):\r\n\u001b[?2004l\r"]
[256.220592, "o", "\u001b[?2004h> "]
[256.220667, "o", "    for j in range(len(df)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220747, "o", "        if i == j:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220764, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.220955, "o", "        if (vals[j,0] >= vals[i,0] and vals[j,1] <= vals[i,1] and (vals[j,0] > vals[i,0] or vals[j,1] < vals[i,1])):\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.221, "o", "> "]
[256.221018, "o", "            pareto_mask[i] = False\r\n\u001b[?2004l\r"]
[256.221029, "o", "\u001b[?2004h> "]
[256.221079, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[256.221134, "o", "\u001b[?2004h> "]
[256.221163, "o", "pareto_df = df[pareto_mask].copy()\r\n\u001b[?2004l\r"]
[256.221195, "o", "\u001b[?2004h> "]
[256.221332, "o", "pareto_df = pareto_df.sort_values(['F1','delta'], ascending=[False, True])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.22138, "o", "pareto_df['F1'] = pareto_df['F1'].round(5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.221467, "o", "pareto_df['delta'] = pareto_df['delta'].round(5)\r\n\u001b[?2004l\r"]
[256.221511, "o", "\u001b[?2004h> "]
[256.221574, "o", "pareto_df['shape_weight'] = pareto_df['shape_weight'].round(1)\r\n\u001b[?2004l\r"]
[256.221622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.22171, "o", "pareto_df.to_csv('/root/pareto_frontier.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.221762, "o", "print(pareto_df.head())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.221883, "o", "print('Saved to /root/pareto_frontier.csv with', len(pareto_df), 'rows')\r\n\u001b[?2004l\r"]
[256.2219, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
