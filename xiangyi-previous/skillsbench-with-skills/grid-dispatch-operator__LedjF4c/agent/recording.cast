[90.137936, "i", "cat > dispatch_optimizer.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\nfrom scipy.sparse import csr_matrix, lil_matrix\nimport sys\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbuses = np.array(data['bus'])\ngens = np.array(data['gen'])\nbranches = np.array(data['branch'])\ngencosts = np.array(data['gencost'])\nreserve_capacity = np.array(data['reserve_capacity'])\nreserve_requirement = data['reserve_requirement']\n\nprint(f\"Network: {len(buses)} buses, {len(gens)} generators, {len(branches)} branches\")\nprint(f\"Reserve requirement: {reserve_requirement} MW\")\n\n# Extract data\nnum_buses = len(buses)\nnum_gens = len(gens)\nnum_branches = len(branches)\n\n# Bus data\nbus_ids = buses[:, 0].astype(int)\nbus_pd = buses[:, 2]  # Real power demand (MW)\n\n# Create bus index mapping\nbus_to_idx = {int(bus_id): idx for idx, bus_id in enumerate(bus_ids)}\n\n# Generator data\ngen_bus = gens[:, 0].astype(int)\ngen_pmax = gens[:, 8]\ngen_pmin = gens[:, 9]\ngen_status = gens[:, 7].astype(int)\n\n# Filter active generators\nactive_gens = gen_status == 1\ngen_bus = gen_bus[active_gens]\ngen_pmax = gen_pmax[active_gens]\ngen_pmin = gen_pmin[active_gens]\nreserve_capacity = reserve_capacity[active_gens]\ngencosts = gencosts[active_gens]\nnum_active_gens = len(gen_bus)\n\nprint(f\"Active generators: {num_active_gens}\")\n\n# Cost coefficients (quadratic: c2*P^2 + c1*P + c0)\n# For linear programming, we use linear cost c1\ncost_linear = gencosts[:, 5]  # c1 coefficient\n\n# Branch data\nbranch_from = branches[:, 0].astype(int)\nbranch_to = branches[:, 1].astype(int)\nbranch_x = branches[:, 3]  # Reactance\nbranch_limit = branches[:, 5]  # RATE_A (MVA limit)\nbranch_status = branches[:, 10].astype(int)\n\n# Filter active branches\nactive_branches = branch_status == 1\nbranch_from = branch_from[active_branches]\nbranch_to = branch_to[active_branches]\nbranch_x = branch_x[active_branches]\nbranch_limit = branch_limit[active_branches]\nnum_active_branches = len(branch_from)\n\nprint(f\"Active branches: {num_active_branches}\")\n\n# Build susceptance matrix B (for DC power flow)\nB = lil_matrix((num_buses, num_buses))\nfor i in range(num_active_branches):\n    f_idx = bus_to_idx[branch_from[i]]\n    t_idx = bus_to_idx[branch_to[i]]\n    if branch_x[i] > 1e-6:  # Avoid division by zero\n        b = 1.0 / branch_x[i]\n        B[f_idx, t_idx] -= b\n        B[t_idx, f_idx] -= b\n        B[f_idx, f_idx] += b\n        B[t_idx, t_idx] += b\n\nB = B.tocsr()\n\n# Calculate total load\ntotal_load = bus_pd.sum()\nprint(f\"Total load: {total_load:.2f} MW\")\n\n# Setup optimization using linprog\n# Decision variables: [P_gen (num_active_gens), R_gen (num_active_gens), theta (num_buses)]\nnum_vars = 2 * num_active_gens + num_buses\n\n# Objective: minimize generation cost (linear part only)\nc = np.zeros(num_vars)\nc[:num_active_gens] = cost_linear  # Cost for generation\n# Reserve has no cost in objective (or could add small penalty)\n\n# Inequality constraints: A_ub @ x <= b_ub\nA_ub = []\nb_ub = []\n\n# Generator limits: P_min <= P <= P_max\nfor i in range(num_active_gens):\n    # P_i <= P_max_i\n    row = np.zeros(num_vars)\n    row[i] = 1\n    A_ub.append(row)\n    b_ub.append(gen_pmax[i])\n    \n    # -P_i <= -P_min_i  =>  P_i >= P_min_i\n    row = np.zeros(num_vars)\n    row[i] = -1\n    A_ub.append(row)\n    b_ub.append(-gen_pmin[i])\n\n# Reserve limits: R_i <= reserve_capacity_i\nfor i in range(num_active_gens):\n    row = np.zeros(num_vars)\n    row[num_active_gens + i] = 1\n    A_ub.append(row)\n    b_ub.append(reserve_capacity[i])\n    \n    # R_i >= 0\n    row = np.zeros(num_vars)\n    row[num_active_gens + i] = -1\n    A_ub.append(row)\n    b_ub.append(0)\n\n# Capacity coupling: P_i + R_i <= P_max_i\nfor i in range(num_active_gens):\n    row = np.zeros(num_vars)\n    row[i] = 1  # P_i\n    row[num_active_gens + i] = 1  # R_i\n    A_ub.append(row)\n    b_ub.append(gen_pmax[i])\n\n# Transmission line limits (DC power flow)\nfor i in range(num_active_branches):\n    if branch_limit[i] > 0:  # Only if limit is specified\n        f_idx = bus_to_idx[branch_from[i]]\n        t_idx = bus_to_i"]
[90.138114, "i", "dx[branch_to[i]]\n        if branch_x[i] > 1e-6:\n            b = 1.0 / branch_x[i]\n            # Flow = b * (theta_f - theta_t)\n            # b * (theta_f - theta_t) <= limit\n            row = np.zeros(num_vars)\n            row[2*num_active_gens + f_idx] = b\n            row[2*num_active_gens + t_idx] = -b\n            A_ub.append(row)\n            b_ub.append(branch_limit[i])\n            \n            # -b * (theta_f - theta_t) <= limit  (reverse flow)\n            row = np.zeros(num_vars)\n            row[2*num_active_gens + f_idx] = -b\n            row[2*num_active_gens + t_idx] = b\n            A_ub.append(row)\n            b_ub.append(branch_limit[i])\n\nA_ub = np.array(A_ub)\nb_ub = np.array(b_ub)\n\nprint(f\"Inequality constraints: {len(b_ub)}\")\n\n# Equality constraints: A_eq @ x = b_eq\nA_eq = []\nb_eq = []\n\n# Power balance at each bus: sum(P_gen at bus) - load = sum of flows out\nfor bus_idx in range(num_buses):\n    row = np.zeros(num_vars)\n    \n    # Add generation at this bus\n    bus_id = bus_ids[bus_idx]\n    for gen_idx in range(num_active_gens):\n        if gen_bus[gen_idx] == bus_id:\n            row[gen_idx] = 1\n    \n    # DC power flow: P_inj = B @ theta\n    # But we need to handle this differently\n    # For now, use simplified nodal balance\n    \n    A_eq.append(row)\n    b_eq.append(bus_pd[bus_idx])\n\n# Actually, let me use a simpler approach: total generation = total load\nrow = np.zeros(num_vars)\nrow[:num_active_gens] = 1\nA_eq = [row]\nb_eq = [total_load]\n\n# Reserve requirement: sum(R_i) >= reserve_requirement\n# Convert to equality by adding slack would be complex, so use inequality\nrow = np.zeros(num_vars)\nrow[num_active_gens:2*num_active_gens] = -1\nA_ub = np.vstack([A_ub, row])\nb_ub = np.append(b_ub, -reserve_requirement)\n\n# Reference bus: theta_0 = 0\nrow = np.zeros(num_vars)\nrow[2*num_active_gens] = 1  # First bus is reference\nA_eq.append(row)\nb_eq.append(0)\n\nA_eq = np.array(A_eq)\nb_eq = np.array(b_eq)\n\nprint(f\"Equality constraints: {len(b_eq)}\")\nprint(f\"Total variables: {num_vars}\")\n\n# Bounds\nbounds = []\nfor i in range(num_active_gens):\n    bounds.append((gen_pmin[i], gen_pmax[i]))  # P bounds\nfor i in range(num_active_gens):\n    bounds.append((0, reserve_capacity[i]))  # R bounds\nfor i in range(num_buses):\n    bounds.append((None, None))  # theta unbounded (except reference)\n\nprint(\"\\nSolving optimization...\")\n\n# Solve\nresult = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\n\nif result.success:\n    print(\"Optimization successful!\")\n    \n    # Extract results\n    P_gen = result.x[:num_active_gens]\n    R_gen = result.x[num_active_gens:2*num_active_gens]\n    theta = result.x[2*num_active_gens:]\n    \n    # Calculate total cost\n    total_cost = sum(cost_linear[i] * P_gen[i] for i in range(num_active_gens))\n    \n    # Calculate line flows and find most loaded\n    line_loadings = []\n    for i in range(num_active_branches):\n        f_idx = bus_to_idx[branch_from[i]]\n        t_idx = bus_to_idx[branch_to[i]]\n        if branch_x[i] > 1e-6 and branch_limit[i] > 0:\n            b = 1.0 / branch_x[i]\n            flow = b * (theta[f_idx] - theta[t_idx])\n            loading_pct = abs(flow) / branch_limit[i] * 100\n            line_loadings.append({\n                'from': int(branch_from[i]),\n                'to': int(branch_to[i]),\n                'loading_pct': round(loading_pct, 2)\n            })\n    \n    # Sort and get top 3\n    line_loadings.sort(key=lambda x: x['loading_pct'], reverse=True)\n    top_3_lines = line_loadings[:3]\n    \n    # Calculate operating margin\n    total_committed = sum(P_gen[i] + R_gen[i] for i in range(num_active_gens))\n    total_capacity = sum(gen_pmax[i] for i in range(num_active_gens))\n    operating_margin = total_capacity - total_committed\n    \n    # Generate report\n    report = {\n        'generator_dispatch': [],\n        'totals': {\n            'cost_dollars_per_hour': round(total_cost, 2),\n            'load_MW': round(total_load, 2),\n            'generation_MW': round(sum(P_gen), 2),\n            'reserve_MW': round(sum(R_gen), 2)\n        },\n        'most_loaded_lines': "]
[90.138182, "i", "top_3_lines,\n        'operating_margin_MW': round(operating_margin, 2)\n    }\n    \n    # Add generator dispatch details\n    for i in range(num_active_gens):\n        report['generator_dispatch'].append({\n            'id': i + 1,\n            'bus': int(gen_bus[i]),\n            'output_MW': round(P_gen[i], 2),\n            'reserve_MW': round(R_gen[i], 2),\n            'pmax_MW': round(gen_pmax[i], 2)\n        })\n    \n    # Save report\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    \n    print(f\"\\nTotal cost: ${total_cost:,.2f}/hr\")\n    print(f\"Total generation: {sum(P_gen):.2f} MW\")\n    print(f\"Total reserves: {sum(R_gen):.2f} MW\")\n    print(f\"Operating margin: {operating_margin:.2f} MW\")\n    print(f\"\\nReport saved to report.json\")\nelse:\n    print(f\"Optimization failed: {result.message}\")\n    sys.exit(1)\nEOF\n"]
