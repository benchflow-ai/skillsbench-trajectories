[90.138456, "o", "> import numpy as np\r\n\u001b[?2004l\r.0 "]
[90.138488, "o", "\u001b[?2004h> "]
[90.13857, "o", "from scipy.optimize import linprog\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.138675, "o", "from scipy.sparse import csr_matrix, lil_matrix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.138696, "o", "import sys\r\n\u001b[?2004l\r"]
[90.138721, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.138874, "o", "# Load network data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.138914, "o", "with open('network.json', 'r') as f:\r\n\u001b[?2004l\r \u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.138966, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.139005, "o", "baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.139072, "o", "buses = np.array(data['bus'])\r\n\u001b[?2004l\rdx] \u001b[?2004h"]
[90.139111, "o", "> "]
[90.139162, "o", "gens = np.array(data['gen'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.13924, "o", "branches = np.array(data['branch'])\r\n\u001b[?2004l\r"]
[90.139279, "o", "\u001b[?2004h> "]
[90.139325, "o", "gencosts = np.array(data['gencost'])\r\n\u001b[?2004l\r"]
[90.13937, "o", "\u001b[?2004h> "]
[90.139451, "o", "reserve_capacity = np.array(data['reserve_capacity'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.139503, "o", "> "]
[90.139564, "o", "reserve_requirement = data['reserve_requirement']\r\n\u001b[?2004l\r"]
[90.139592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r*\u001b[?2004h> "]
[90.139773, "o", "print(f\"Network: {len(buses)} buses, {len(gens)} generators, {len(branches)} branches\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.139898, "o", "print(f\"Reserve requirement: {reserve_requirement} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.139925, "o", "> \r\n\u001b[?2004l\r]\u001b[?2004h> "]
[90.139981, "o", "# Extract data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.140045, "o", "num_buses = len(buses)\r\n\u001b[?2004l\rarr\u001b[?2004h> "]
[90.140088, "o", "num_gens = len(gens)\r\n\u001b[?2004l\re\u001b[?2004h"]
[90.140125, "o", "> "]
[90.140165, "o", "num_branches = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.140189, "o", "\r\n\u001b[?2004l\rb\u001b[?2004h> "]
[90.140213, "o", "# Bus data\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[90.140297, "o", "bus_ids = buses[:, 0].astype(int)\r\n\u001b[?2004l\req\u001b[?2004h> "]
[90.140384, "o", "bus_pd = buses[:, 2]  # Real power demand (MW)\r\n\u001b[?2004l\r"]
[90.140404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.140518, "o", "# Create bus index mapping\r\n\u001b[?2004l\rad\u001b[?2004h> "]
[90.140631, "o", "bus_to_idx = {int(bus_id): idx for idx, bus_id in enumerate(bus_ids)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.140681, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.140708, "o", "# Generator data\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.140769, "o", "gen_bus = gens[:, 0].astype(int)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.140823, "o", "gen_pmax = gens[:, 8]\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[90.14088, "o", "gen_pmin = gens[:, 9]\r\n\u001b[?2004l\r"]
[90.140906, "o", "\u001b[?2004h> "]
[90.140967, "o", "gen_status = gens[:, 7].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141013, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141052, "o", "# Filter active generators\r\n\u001b[?2004l\r"]
[90.141079, "o", "\u001b[?2004h> "]
[90.141145, "o", "active_gens = gen_status == 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141202, "o", "gen_bus = gen_bus[active_gens]\r\n\u001b[?2004l\ri\u001b[?2004h"]
[90.141231, "o", "> "]
[90.141296, "o", "gen_pmax = gen_pmax[active_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141357, "o", "gen_pmin = gen_pmin[active_gens]\r\n\u001b[?2004l\r "]
[90.141386, "o", "\u001b[?2004h> "]
[90.141466, "o", "reserve_capacity = reserve_capacity[active_gens]\r\n\u001b[?2004l\r_\u001b[?2004h"]
[90.141494, "o", "> "]
[90.141547, "o", "gencosts = gencosts[active_gens]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.141573, "o", "> "]
[90.141683, "o", "num_active_gens = len(gen_bus)\r\n\u001b[?2004l\rt\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141764, "o", "print(f\"Active generators: {num_active_gens}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.141859, "o", "> # Cost coefficients (quadratic: c2*P^2 + c1*P + c0)"]
[90.141886, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.141969, "o", "# For linear programming, we use linear cost c1\r\n\u001b[?2004l\re\u001b[?2004h"]
[90.141996, "o", "> "]
[90.142077, "o", "cost_linear = gencosts[:, 5]  # c1 coefficient\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.142106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.142163, "o", "# Branch data\r\n\u001b[?2004l\rto \u001b[?2004h> "]
[90.142236, "o", "branch_from = branches[:, 0].astype(int)\r\n\u001b[?2004l\rx\u001b[?2004h"]
[90.142265, "o", "> "]
[90.142323, "o", "branch_to = branches[:, 1].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.142379, "o", "> "]
[90.142407, "o", "branch_x = branches[:, 3]  # Reactance\r\n\u001b[?2004l\r_\u001b[?2004h"]
[90.142457, "o", "> "]
[90.142523, "o", "branch_limit = branches[:, 5]  # RATE_A (MVA limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.142602, "o", "branch_status = branches[:, 10].astype(int)\r\n\u001b[?2004l\rn"]
[90.142631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[90.142694, "o", "# Filter active branches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.142761, "o", "active_branches = branch_status == 1\r\n\u001b[?2004l\r"]
[90.142791, "o", "\u001b[?2004h> "]
[90.142861, "o", "branch_from = branch_from[active_branches]\r\n\u001b[?2004l\rpp\u001b[?2004h> "]
[90.14295, "o", "branch_to = branch_to[active_branches]\r\n\u001b[?2004l\rra\u001b[?2004h> "]
[90.143042, "o", "branch_x = branch_x[active_branches]\r\n\u001b[?2004l\r(\u001b[?2004h"]
[90.143073, "o", "> "]
[90.143154, "o", "branch_limit = branch_limit[active_branches]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.143181, "o", "> "]
[90.143242, "o", "num_active_branches = len(branch_from)\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[90.14327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.14337, "o", "print(f\"Active branches: {num_active_branches}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.143394, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.143498, "o", "# Build susceptance matrix B (for DC power flow)\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[90.143588, "o", "B = lil_matrix((num_buses, num_buses))\r\n\u001b[?2004l\r \u001b[?2004h"]
[90.143644, "o", "> "]
[90.143695, "o", "for i in range(num_active_branches):\r\n\u001b[?2004l\ry\u001b[?2004h"]
[90.143722, "o", "> "]
[90.143792, "o", "    f_idx = bus_to_idx[branch_from[i]]\r\n\u001b[?2004l\r"]
[90.14382, "o", "\u001b[?2004h> "]
[90.143883, "o", "    t_idx = bus_to_idx[branch_to[i]]\r\n\u001b[?2004l\r))\u001b[?2004h"]
[90.143909, "o", "> "]
[90.144, "o", "    if branch_x[i] > 1e-6:  # Avoid division by zero\r\n\u001b[?2004l\r"]
[90.144027, "o", "\u001b[?2004h> "]
[90.144079, "o", "        b = 1.0 / branch_x[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.144105, "o", "> "]
[90.144146, "o", "        B[f_idx, t_idx] -= b\r\n\u001b[?2004l\r"]
[90.144205, "o", "\u001b[?2004h> "]
[90.144251, "o", "        B[t_idx, f_idx] -= b\r\n\u001b[?2004l\rq\u001b[?2004h> "]
[90.144295, "o", "        B[f_idx, f_idx] += b\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.14432, "o", "> "]
[90.144385, "o", "        B[t_idx, t_idx] += b\r\n\u001b[?2004l\r:\r\n\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.14441, "o", "\u001b[?2004h> "]
[90.144463, "o", "B = B.tocsr()\r\n\u001b[?2004l\ri\u001b[?2004h> \r\n\u001b[?2004l\rm"]
[90.144493, "o", "\u001b[?2004h> "]
[90.144522, "o", "# Calculate total load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144593, "o", "total_load = bus_pd.sum()\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[90.144689, "o", "print(f\"Total load: {total_load:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144717, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.144788, "o", "# Setup optimization using linprog\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144973, "o", "# Decision variables: [P_gen (num_active_gens), R_gen (num_active_gens), theta (num_buses)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.145024, "o", "> "]
[90.145079, "o", "num_vars = 2 * num_active_gens + num_buses\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.145141, "o", "\u001b[?2004h> "]
[90.1452, "o", "# Objective: minimize generation cost (linear part only)\r\n\u001b[?2004l\r"]
[90.145227, "o", "\u001b[?2004h> "]
[90.145282, "o", "c = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.145384, "o", "c[:num_active_gens] = cost_linear  # Cost for generation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.145513, "o", "# Reserve has no cost in objective (or could add small penalty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.145533, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.145632, "o", "# Inequality constraints: A_ub @ x <= b_ub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.145658, "o", "A_ub = []\r\n\u001b[?2004l\r"]
[90.145708, "o", "\u001b[?2004h> b_ub = []\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.145737, "o", "a\u001b[?2004h> "]
[90.145816, "o", "# Generator limits: P_min <= P <= P_max\r\n\u001b[?2004l\r   b = \u001b[?2004h> "]
[90.14589, "o", "for i in range(num_active_gens):\r\n\u001b[?2004l\r"]
[90.145917, "o", "\u001b[?2004h> "]
[90.145963, "o", "    # P_i <= P_max_i\r\n\u001b[?2004l\rx]\u001b[?2004h> "]
[90.146027, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.14607, "o", "    row[i] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146126, "o", "    A_ub.append(row)\r\n\u001b[?2004l\rlim\u001b[?2004h> "]
[90.146197, "o", "    b_ub.append(gen_pmax[i])\r\n\u001b[?2004l\r_\u001b[?2004h"]
[90.146224, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146316, "o", "    # -P_i <= -P_min_i  =>  P_i >= P_min_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146379, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r"]
[90.146409, "o", "\u001b[?2004h> "]
[90.146466, "o", "    row[i] = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146495, "o", "    A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146571, "o", "    b_ub.append(-gen_pmin[i])\r\n\u001b[?2004l\rloa\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h"]
[90.146599, "o", "> "]
[90.146678, "o", "# Reserve limits: R_i <= reserve_capacity_i\r\n\u001b[?2004l\r"]
[90.146708, "o", "\u001b[?2004h> "]
[90.146763, "o", "for i in range(num_active_gens):\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[90.146824, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r"]
[90.14687, "o", "\u001b[?2004h> "]
[90.146909, "o", "    row[num_active_gens + i] = 1\r\n\u001b[?2004l\r"]
[90.146953, "o", "\u001b[?2004h> "]
[90.146999, "o", "    A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.147062, "o", "    b_ub.append(reserve_capacity[i])\r\n\u001b[?2004l\rg\u001b[?2004h"]
[90.147089, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.147151, "o", ">     # R_i >= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.147212, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r"]
[90.14724, "o", "\u001b[?2004h> "]
[90.147295, "o", "    row[num_active_gens + i] = -1\r\n\u001b[?2004l\r\r\n \u001b[?2004h"]
[90.147336, "o", "> "]
[90.147362, "o", "    A_ub.append(row)\r\n\u001b[?2004l\r= s\u001b[?2004h> "]
[90.147412, "o", "    b_ub.append(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.147476, "o", "\u001b[?2004h> "]
[90.147516, "o", "# Capacity coupling: P_i + R_i <= P_max_i\r\n\u001b[?2004l\rting_"]
[90.147541, "o", "\u001b[?2004h> "]
[90.147611, "o", "for i in range(num_active_gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.147635, "o", "> "]
[90.147689, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.147728, "o", "    row[i] = 1  # P_i\r\n\u001b[?2004l\r"]
[90.14777, "o", "\u001b[?2004h> "]
[90.147819, "o", "    row[num_active_gens + i] = 1  # R_i\r\n\u001b[?2004l\r \u001b[?2004h"]
[90.147846, "o", "> "]
[90.14791, "o", "    A_ub.append(row)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.147967, "o", "    b_ub.append(gen_pmax[i])\r\n\u001b[?2004l\r"]
[90.147993, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.148048, "o", "# Transmission line limits (DC power flow)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.148075, "o", "> "]
[90.14815, "o", "for i in range(num_active_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.148258, "o", "    if branch_limit[i] > 0:  # Only if limit is specified\r\n\u001b[?2004l\re\u001b[?2004h"]
[90.148277, "o", "> "]
[90.148347, "o", "        f_idx = bus_to_idx[branch_from[i]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.148436, "o", "        t_idx = bus_to_idx[branch_to[i]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.148484, "o", "> "]
[90.148511, "o", "        if branch_x[i] > 1e-6:\r\n\u001b[?2004l\rn\u001b[?2004h"]
[90.148536, "o", "> "]
[90.14861, "o", "            b = 1.0 / branch_x[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.148634, "o", "> "]
[90.148696, "o", "            # Flow = b * (theta_f - theta_t)\r\n\u001b[?2004l\r"]
[90.148739, "o", "\u001b[?2004h> "]
[90.148802, "o", "            # b * (theta_f - theta_t) <= limit\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.148858, "o", "> "]
[90.148901, "o", "            row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.148944, "o", "> "]
[90.148995, "o", "            row[2*num_active_gens + f_idx] = b\r\n\u001b[?2004l\r"]
[90.14902, "o", "\u001b[?2004h> "]
[90.149112, "o", "            row[2*num_active_gens + t_idx] = -b\r\n\u001b[?2004l\r)\u001b[?2004h> "]
[90.14918, "o", "            A_ub.append(row)\r\n\u001b[?2004l\rr"]
[90.149221, "o", "\u001b[?2004h> "]
[90.149277, "o", "            b_ub.append(branch_limit[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.149328, "o", "> "]
[90.149368, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.149453, "o", "            # -b * (theta_f - theta_t) <= limit  (reverse flow)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.149494, "o", "> "]
[90.149534, "o", "            row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.149587, "o", "> "]
[90.149652, "o", "            row[2*num_active_gens + f_idx] = -b\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.149676, "o", "> "]
[90.149765, "o", "            row[2*num_active_gens + t_idx] = b\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.14979, "o", "> "]
[90.149842, "o", "            A_ub.append(row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.149882, "o", "> "]
[90.14993, "o", "            b_ub.append(branch_limit[i])\r\n\u001b[?2004l\rg\u001b[?2004h> "]
[90.149974, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150015, "o", "A_ub = np.array(A_ub)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15007, "o", "b_ub = np.array(b_ub)\r\n\u001b[?2004l\r{"]
[90.150115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[90.150189, "o", "print(f\"Inequality constraints: {len(b_ub)}\")\r\n\u001b[?2004l\rport\u001b[?2004h"]
[90.150233, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[90.150292, "o", "# Equality constraints: A_eq @ x = b_eq\r\n\u001b[?2004l\r"]
[90.150333, "o", "\u001b[?2004h> A_eq = []\r\n\u001b[?2004l\r"]
[90.150386, "o", "\u001b[?2004h> b_eq = []\r\n\u001b[?2004l\r"]
[90.150427, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150532, "o", "# Power balance at each bus: sum(P_gen at bus) - load = sum of flows out\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.150587, "o", "> "]
[90.150628, "o", "for bus_idx in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150651, "o", "    row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150711, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.150765, "o", ">     # Add generation at this bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150807, "o", "    bus_id = bus_ids[bus_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150899, "o", "    for gen_idx in range(num_active_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.150949, "o", "        if gen_bus[gen_idx] == bus_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151005, "o", "            row[gen_idx] = 1\r\n\u001b[?2004l\r"]
[90.151048, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151122, "o", "    # DC power flow: P_inj = B @ theta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151193, "o", "    # But we need to handle this differently\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151267, "o", "    # For now, use simplified nodal balance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151321, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.151346, "o", "> "]
[90.15141, "o", "    A_eq.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151463, "o", "    b_eq.append(bus_pd[bus_idx])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151547, "o", "# Actually, let me use a simpler approach: total generation = total load\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.151574, "o", "> "]
[90.15162, "o", "row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.151689, "o", "> row[:num_active_gens] = 1\r\n\u001b[?2004l\r"]
[90.151729, "o", "\u001b[?2004h> A_eq = [row]\r\n\u001b[?2004l\r\u001b[?2004h> b_eq = [total_load]\r\n\u001b[?2004l\r"]
[90.151779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.151821, "o", "> "]
[90.15186, "o", "# Reserve requirement: sum(R_i) >= reserve_requirement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.151975, "o", "# Convert to equality by adding slack would be complex, so use inequality\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152027, "o", "row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152102, "o", "row[num_active_gens:2*num_active_gens] = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152162, "o", "A_ub = np.vstack([A_ub, row])\r\n\u001b[?2004l\r"]
[90.152208, "o", "\u001b[?2004h> "]
[90.152248, "o", "b_ub = np.append(b_ub, -reserve_requirement)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152302, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152352, "o", "# Reference bus: theta_0 = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152401, "o", "row = np.zeros(num_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152456, "o", "row[2*num_active_gens] = 1  # First bus is reference\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152496, "o", "A_eq.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152537, "o", "b_eq.append(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[90.152577, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.152625, "o", "A_eq = np.array(A_eq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152672, "o", "b_eq = np.array(b_eq)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.152701, "o", "> "]
[90.152774, "o", "print(f\"Equality constraints: {len(b_eq)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152813, "o", "print(f\"Total variables: {num_vars}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.152856, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Bounds\r\n\u001b[?2004l\r"]
[90.15288, "o", "\u001b[?2004h> "]
[90.152925, "o", "bounds = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.152981, "o", "for i in range(num_active_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153065, "o", "    bounds.append((gen_pmin[i], gen_pmax[i]))  # P bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153124, "o", "for i in range(num_active_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153269, "o", "    bounds.append((0, reserve_capacity[i]))  # R bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153332, "o", "for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153391, "o", "    bounds.append((None, None))  # theta unbounded (except reference)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153449, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153485, "o", "print(\"\\nSolving optimization...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.153531, "o", "\u001b[?2004h> # Solve\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.153581, "o", "> "]
[90.15368, "o", "result = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.153703, "o", "> "]
[90.153768, "o", "if result.success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.153824, "o", "    print(\"Optimization successful!\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[90.153871, "o", "\u001b[?2004h>     # Extract results\r\n\u001b[?2004l\r"]
[90.153918, "o", "\u001b[?2004h> "]
[90.153966, "o", "    P_gen = result.x[:num_active_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.154043, "o", "    R_gen = result.x[num_active_gens:2*num_active_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15411, "o", "    theta = result.x[2*num_active_gens:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.154155, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.1542, "o", "    # Calculate total cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.154247, "o", "> "]
[90.15432, "o", "    total_cost = sum(cost_linear[i] * P_gen[i] for i in range(num_active_gens))\r\n\u001b[?2004l\r"]
[90.154369, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.154434, "o", "    # Calculate line flows and find most loaded\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.15446, "o", "> "]
[90.154532, "o", "    line_loadings = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.154586, "o", "    for i in range(num_active_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.154637, "o", "        f_idx = bus_to_idx[branch_from[i]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.154687, "o", "> "]
[90.154737, "o", "        t_idx = bus_to_idx[branch_to[i]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.154809, "o", "        if branch_x[i] > 1e-6 and branch_limit[i] > 0:\r\n\u001b[?2004l\r"]
[90.154832, "o", "\u001b[?2004h> "]
[90.154986, "o", "            b = 1.0 / branch_x[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155043, "o", "            flow = b * (theta[f_idx] - theta[t_idx])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155111, "o", "            loading_pct = abs(flow) / branch_limit[i] * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155161, "o", "            line_loadings.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155236, "o", "                'from': int(branch_from[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155346, "o", "                'to': int(branch_to[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155392, "o", "                'loading_pct': round(loading_pct, 2)\r\n\u001b[?2004l\r"]
[90.155446, "o", "\u001b[?2004h> "]
[90.155498, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155544, "o", "    # Sort and get top 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155641, "o", "    line_loadings.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155695, "o", "    top_3_lines = line_loadings[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155746, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155795, "o", "    # Calculate operating margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.155943, "o", "    total_committed = sum(P_gen[i] + R_gen[i] for i in range(num_active_gens))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156044, "o", "    total_capacity = sum(gen_pmax[i] for i in range(num_active_gens))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156137, "o", "    operating_margin = total_capacity - total_committed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156191, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156216, "o", "    # Generate report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156253, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15631, "o", "        'generator_dispatch': [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156398, "o", "        'totals': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156467, "o", "            'cost_dollars_per_hour': round(total_cost, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15654, "o", "            'load_MW': round(total_load, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156645, "o", "            'generation_MW': round(sum(P_gen), 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156703, "o", "            'reserve_MW': round(sum(R_gen), 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156755, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.156808, "o", "        'most_loaded_lines': top_3_lines,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.15693, "o", "        'operating_margin_MW': round(operating_margin, 2)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.156954, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157073, "o", "    # Add generator dispatch details\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157106, "o", "    for i in range(num_active_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157209, "o", "        report['generator_dispatch'].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157267, "o", "            'id': i + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157315, "o", "            'bus': int(gen_bus[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157372, "o", "            'output_MW': round(P_gen[i], 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157453, "o", "            'reserve_MW': round(R_gen[i], 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157532, "o", "            'pmax_MW': round(gen_pmax[i], 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157592, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[90.157621, "o", "\u001b[?2004h> "]
[90.157683, "o", "    # Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.157713, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.15778, "o", "> "]
[90.15787, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[90.157944, "o", "\u001b[?2004h>     print(f\"\\nTotal cost: ${total_cost:,.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158009, "o", "    print(f\"Total generation: {sum(P_gen):.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.158065, "o", "> "]
[90.15812, "o", "    print(f\"Total reserves: {sum(R_gen):.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158201, "o", "    print(f\"Operating margin: {operating_margin:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158276, "o", "    print(f\"\\nReport saved to report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158325, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158397, "o", "    print(f\"Optimization failed: {result.message}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.158449, "o", "    sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[90.160116, "o", "\u001b[?2004hroot@92db9ee6403d:~# "]
