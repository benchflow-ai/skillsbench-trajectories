[?2004l[?2004h> 
[?2004l[?2004h> if result.success:
[?2004l[?2004h>     print("Optimization successful!")
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract results
[?2004l[?2004h>     P_gen = result.x[:num_active_gens]
[?2004l[?2004h>     R_gen = result.x[num_active_gens:2*num_active_gens]
[?2004l[?2004h>     theta = result.x[2*num_active_gens:]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate total cost
[?2004l[?2004h>     total_cost = sum(cost_linear[i] * P_gen[i] for i in range(num_active_gens))
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate line flows and find most loaded
[?2004l[?2004h>     line_loadings = []
[?2004l[?2004h>     for i in range(num_active_branches):
[?2004l[?2004h>         f_idx = bus_to_idx[branch_from[i]]
[?2004l[?2004h>         t_idx = bus_to_idx[branch_to[i]]
[?2004l[?2004h>         if branch_x[i] > 1e-6 and branch_limit[i] > 0:
[?2004l[?2004h>             b = 1.0 / branch_x[i]
[?2004l[?2004h>             flow = b * (theta[f_idx] - theta[t_idx])
[?2004l[?2004h>             loading_pct = abs(flow) / branch_limit[i] * 100
[?2004l[?2004h>             line_loadings.append({
[?2004l[?2004h>                 'from': int(branch_from[i]),
[?2004l[?2004h>                 'to': int(branch_to[i]),
[?2004l[?2004h>                 'loading_pct': round(loading_pct, 2)
[?2004l[?2004h>             })
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort and get top 3
[?2004l[?2004h>     line_loadings.sort(key=lambda x: x['loading_pct'], reverse=True)
[?2004l[?2004h>     top_3_lines = line_loadings[:3]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate operating margin
[?2004l[?2004h>     total_committed = sum(P_gen[i] + R_gen[i] for i in range(num_active_gens))
[?2004l[?2004h>     total_capacity = sum(gen_pmax[i] for i in range(num_active_gens))
[?2004l[?2004h>     operating_margin = total_capacity - total_committed
[?2004l[?2004h>     
[?2004l[?2004h>     # Generate report
[?2004l[?2004h>     report = {
[?2004l[?2004h>         'generator_dispatch': [],
[?2004l[?2004h>         'totals': {
[?2004l[?2004h>             'cost_dollars_per_hour': round(total_cost, 2),
[?2004l[?2004h>             'load_MW': round(total_load, 2),
[?2004l[?2004h>             'generation_MW': round(sum(P_gen), 2),
[?2004l[?2004h>             'reserve_MW': round(sum(R_gen), 2)
[?2004l[?2004h>         },
[?2004l[?2004h>         'most_loaded_lines': top_3_lines,
[?2004l[?2004h>         'operating_margin_MW': round(operating_margin, 2)
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     # Add generator dispatch details
[?2004l[?2004h>     for i in range(num_active_gens):
[?2004l[?2004h>         report['generator_dispatch'].append({
[?2004l[?2004h>             'id': i + 1,
[?2004l[?2004h>             'bus': int(gen_bus[i]),
[?2004l[?2004h>             'output_MW': round(P_gen[i], 2),
[?2004l[?2004h>             'reserve_MW': round(R_gen[i], 2),
[?2004l[?2004h>             'pmax_MW': round(gen_pmax[i], 2)
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     # Save report
[?2004l[?2004h>     with open('report.json', 'w') as f:
[?2004l[?2004h>         json.dump(report, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nTotal cost: ${total_cost:,.2f}/hr")
[?2004l[?2004h>     print(f"Total generation: {sum(P_gen):.2f} MW")
[?2004l[?2004h>     print(f"Total reserves: {sum(R_gen):.2f} MW")
[?2004l[?2004h>     print(f"Operating margin: {operating_margin:.2f} MW")
[?2004l[?2004h>     print(f"\nReport saved to report.json")
[?2004l[?2004h> else:
