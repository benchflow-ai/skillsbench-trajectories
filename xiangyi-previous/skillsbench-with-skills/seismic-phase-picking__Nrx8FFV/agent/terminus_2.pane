[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> from scipy.ndimage import uniform_filter1d
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=4):
[?2004l[?2004h>     """Apply bandpass filter to data"""
[?2004l[?2004h>     nyq = 0.5 * fs
[?2004l[?2004h>     low = lowcut / nyq
[?2004l[?2004h>     high = highcut / nyq
[?2004l[?2004h>     # Ensure frequencies are valid
[?2004l[?2004h>     low = max(0.001, min(low, 0.99))
[?2004l[?2004h>     high = max(low + 0.01, min(high, 0.999))
[?2004l[?2004h>     b, a = signal.butter(order, [low, high], btype='band')
[?2004l[?2004h>     # Use filtfilt for zero-phase filtering
[?2004l[?2004h>     return signal.filtfilt(b, a, data, axis=0)
[?2004l[?2004h> 
[?2004l[?2004h> def sta_lta(data, sta_len, lta_len):
[?2004l[?2004h>     """Calculate STA/LTA ratio"""
[?2004l[?2004h>     # Calculate short-term and long-term averages using absolute values
[?2004l[?2004h>     abs_data = np.abs(data)
[?2004l[?2004h>     sta = uniform_filter1d(abs_data, size=sta_len, mode='nearest')
[?2004l[?2004h>     lta = uniform_filter1d(abs_data, size=lta_len, mode='nearest')
[?2004l[?2004h>     # Avoid division by zero
[?2004l[?2004h>     lta[lta < 1e-10] = 1e-10
[?2004l[?2004h>     return sta / lta
[?2004l[?2004h> 
[?2004l[?2004h> def find_triggers(cf, threshold_on, threshold_off, min_separation=100):
[?2004l[?2004h>     """Find trigger points where characteristic function exceeds threshold"""
[?2004l[?2004h>     triggers = []
[?2004l[?2004h>     triggered = False
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(cf)):
[?2004l[?2004h>         if not triggered:
[?2004l[?2004h>             if cf[i] >= threshold_on:
[?2004l[?2004h>                 triggered = True
[?2004l[?2004h>                 # Find the exact onset by looking back
[?2004l[?2004h>                 onset = i
[?2004l[?2004h>                 for j in range(i, max(0, i-50), -1):
[?2004l[?2004h>                     if cf[j] < threshold_on * 0.5:
[?2004l[?2004h>                         onset = j
[?2004l[?2004h>                         break
[?2004l[?2004h>                 triggers.append(onset)
[?2004l[?2004h>         else:
[?2004l[?2004h>             if cf[i] < threshold_off:
[?2004l[?2004h>                 triggered = False
[?2004l[?2004h>     
[?2004l[?2004h>     # Remove triggers that are too close
[?2004l[?2004h>     if len(triggers) > 1:
[?2004l[?2004h>         filtered = [triggers[0]]
[?2004l[?2004h>         for t in triggers[1:]:
[?2004l[?2004h>             if t - filtered[-1] >= min_separation:
[?2004l[?2004h>                 filtered.append(t)
[?2004l[?2004h>         triggers = filtered
[?2004l[?2004h>     
[?2004l[?2004h>     return triggers
[?2004l[?2004h> 
[?2004l[?2004h> def pick_p_wave(data_z, fs):
[?2004l[?2004h>     """Pick P-wave arrival on vertical component"""
[?2004l[?2004h>     # Filter data (1-20 Hz for P-wave)
[?2004l[?2004h>     try:
[?2004l[?2004h>         filtered = bandpass_filter(data_z, 1.0, 20.0, fs)
[?2004l[?2004h>     except:
[?2004l[?2004h>         filtered = data_z
[?2004l[?2004h>     
[?2004l[?2004h>     # STA/LTA parameters (in samples)
[?2004l[?2004h>     sta_len = int(0.1 * fs)  # 0.1 second
[?2004l[?2004h>     lta_len = int(2.0 * fs)  # 2 seconds
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate STA/LTA
[?2004l[?2004h>     cf = sta_lta(filtered, sta_len, lta_len)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find triggers with adaptive threshold
[?2004l[?2004h>     threshold = 3.0
[?2004l[?2004h>     picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))
[?2004l[?2004h>     
[?2004l[?2004h>     # If no picks found, try lower threshold
[?2004l[?2004h>     if len(picks) == 0:
[?2004l[?2004h>         threshold = 2.0
[?2004l[?2004h>         picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))
[?2004l[?2004h>     
[?2004l[?2004h>     # Return first pick (most likely P-wave)
[?2004l[?2004h>     if len(picks) > 0:
[?2004l[?2004h>         return [picks[0]]
[?2004l[?2004h>     return []
[?2004l[?2004h> 
[?2004l[?2004h> def pick_s_wave(data_e, data_n, fs, p_pick=None):
[?2004l[?2004h>     """Pick S-wave arrival on horizontal components"""
[?2004l[?2004h>     # Combine horizontal components
[?2004l[?2004h>     horizontal = np.sqrt(data_e**2 + data_n**2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter data (1-15 Hz for S-wave)
[?2004l[?2004h>     try:
[?2004l[?2004h>         filtered = bandpass_filter(horizontal, 1.0, 15.0, fs)
[?2004l[?2004h>     except:
[?2004l[?2004h>         filtered = horizontal
[?2004l[?2004h>     
[?2004l[?2004h>     # STA/LTA parameters
[?2004l[?2004h>     sta_len = int(0.2 * fs)  # 0.2 second
[?2004l[?2004h>     lta_len = int(3.0 * fs)  # 3 seconds
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate STA/LTA
[?2004l[?2004h>     cf = sta_lta(filtered, sta_len, lta_len)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find triggers
[?2004l[?2004h>     threshold = 2.5
[?2004l[?2004h>     picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))
[?2004l[?2004h>     
[?2004l[?2004h>     # If no picks, try lower threshold
[?2004l[?2004h>     if len(picks) == 0:
[?2004l[?2004h>         threshold = 2.0
[?2004l[?2004h>         picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))
[?2004l[?2004h>     
[?2004l[?2004h>     # S-wave should come after P-wave
[?2004l[?2004h>     if p_pick is not None and len(picks) > 0:
[?2004l[?2004h>         # Filter picks that are after P-wave with some minimum separation
[?2004l[?2004h>         min_ps_sep = int(0.3 * fs)  # Minimum 0.3 seconds after P
[?2004l[?2004h>         valid_picks = [p for p in picks if p > p_pick + min_ps_sep]
[?2004l[?2004h>         if len(valid_picks) > 0:
[?2004l[?2004h>             return [valid_picks[0]]
[?2004l[?2004h>         # If no valid picks after P, return first pick after P
[?2004l[?2004h>         for p in picks:
[?2004l[?2004h>             if p > p_pick:
[?2004l[?2004h>                 return [p]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(picks) > 0:
[?2004l[?2004h>         return [picks[0]]
[?2004l[?2004h>     return []
[?2004l[?2004h> 
[?2004l[?2004h> def process_file(filepath):
[?2004l[?2004h>     """Process a single trace file and return picks"""
[?2004l[?2004h>     f = np.load(filepath, allow_pickle=True)
[?2004l[?2004h>     data = f['data']  # shape: (12000, 3)
[?2004l[?2004h>     dt = float(f['dt'])
[?2004l[?2004h>     fs = 1.0 / dt
[?2004l[?2004h>     channels = str(f['channels']).split(',')
[?2004l[?2004h>     
[?2004l[?2004h>     # Identify channel indices (E, N, Z)
[?2004l[?2004h>     z_idx = None
[?2004l[?2004h>     e_idx = None
[?2004l[?2004h>     n_idx = None
[?2004l[?2004h>     
[?2004l[?2004h>     for i, ch in enumerate(channels):
[?2004l[?2004h>         if ch.endswith('Z'):
[?2004l[?2004h>             z_idx = i
[?2004l[?2004h>         elif ch.endswith('E') or ch.endswith('1'):
[?2004l[?2004h>             e_idx = i
[?2004l[?2004h>         elif ch.endswith('N') or ch.endswith('2'):
[?2004l[?2004h>             n_idx = i
[?2004l[?2004h>     
[?2004l[?2004h>     # Default indices if not found
[?2004l[?2004h>     if z_idx is None:
[?2004l[?2004h>         z_idx = 2
[?2004l[?2004h>     if e_idx is None:
[?2004l[?2004h>         e_idx = 0
[?2004l[?2004h>     if n_idx is None:
[?2004l[?2004h>         n_idx = 1
[?2004l[?2004h>     
[?2004l[?2004h>     picks = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Pick P-wave on vertical component
[?2004l[?2004h>     p_picks = pick_p_wave(data[:, z_idx], fs)
[?2004l[?2004h>     for p in p_picks:
[?2004l[?2004h>         picks.append(('P', int(p)))
[?2004l[?2004h>     
[?2004l[?2004h>     # Pick S-wave on horizontal components
[?2004l[?2004h>     p_pick = p_picks[0] if len(p_picks) > 0 else None
[?2004l[?2004h>     s_picks = pick_s_wave(data[:, e_idx], data[:, n_idx], fs, p_pick)
[?2004l[?2004h>     for s in s_picks:
[?2004l[?2004h>         picks.append(('S', int(s)))
[?2004l[?2004h>     
[?2004l[?2004h>     return picks
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     data_dir = '/root/data/'
[?2004l[?2004h>     output_file = '/root/results.csv'
[?2004l[?2004h>     
[?2004l[?2004h>     files = sorted(os.listdir(data_dir))
[?2004l[?2004h>     
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for fname in files:
[?2004l[?2004h>         if not fname.endswith('.npz'):
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         filepath = os.path.join(data_dir, fname)
[?2004l[?2004h>         try:
[?2004l[?2004h>             picks = process_file(filepath)
[?2004l[?2004h>             for phase, idx in picks:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     'file_name': fname,
[?2004l[?2004h>                     'phase': phase,
[?2004l[?2004h>                     'pick_idx': idx
[?2004l[?2004h>                 })
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f'Error processing {fname}: {e}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Write results to CSV
[?2004l[?2004h>     with open(output_file, 'w', newline='') as csvfile:
[?2004l[?2004h>         fieldnames = ['file_name', 'phase', 'pick_idx']
[?2004l[?2004h>         writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
[?2004l[?2004h>         writer.writeheader()
[?2004l[?2004h>         for row in results:
[?2004l[?2004h>             writer.writerow(row)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'Processed {len(files)} files')
[?2004l[?2004h>     print(f'Total picks: {len(results)}')
[?2004l[?2004h>     print(f'Results written to {output_file}')
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
