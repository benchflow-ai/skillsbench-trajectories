[?2004l[?2004h> import numpy as np
[?2004l [?2004h> import os
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> from scipy.ndimage import uniform_filter1d
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=3):
[?2004l[?2004h>     """Apply bandpass filter to data"""
[?2004l[?2004h>     nyq = 0.5 * fs
[?2004l[?2004h>     low = lowcut / nyq
[?2004l[?2004h>     high = highcut / nyq
[?2004l[?2004h>     low = max(0.001, min(low, 0.99))
[?2004l[?2004h>     high = max(low + 0.01, min(high, 0.999))
[?2004l[?2004h>     b, a = signal.butter(order, [low, high], btype='band')
[?2004l[?2004h>     return signal.filtfilt(b, a, data, axis=0, padlen=min(150, len(data)-1))
[?2004l[?2004h> 
[?2004l [?2004h> def recursive_sta_lta(data, sta_len, lta_len):
[?2004l[?2004h>     """Calculate recursive STA/LTA ratio"""
[?2004l[?2004h>     npts = len(data)
[?2004l[?2004h>     cf = np.zeros(npts)
[?2004l[?2004h>     abs_data = np.abs(data)
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize
[?2004l[?2004h>     sta = np.mean(abs_data[:sta_len])
[?2004l[?2004h>     lta = np.mean(abs_data[:lta_len])
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(lta_len, npts):
[?2004l[?2004h>         sta = sta + (abs_data[i] - abs_data[i-sta_len]) / sta_len
[?2004l[?2004h>         lta = lta + (abs_data[i] - abs_data[i-lta_len]) / lta_len
[?2004l[?2004h>         if lta > 1e-10:
[?2004l[?2004h>             cf[i] = sta / lta
[?2004l[?2004h>     
[?2004l[?2004h>     return cf
[?2004l[?2004h> 
[?2004lg[?2004h> def pick_phase_stalta(data, fs, sta_sec=0.1, lta_sec=2.0, threshold=2.0):
[?2004l[?2004h>     """Pick phase using STA/LTA method"""
[?2004l[?2004h>     sta_len = int(sta_sec * fs)
[?2004l[?2004h>     lta_len = int(lta_sec * fs)
[?2004l[?2004h>     
[?2004l[?2004h>     cf = recursive_sta_lta(data, sta_len, lta_len)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find where CF exceeds threshold
[?2004l[?2004h>     above_thresh = np.where(cf > threshold)[0]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(above_thresh) > 0:
[?2004l[?2004h>         # Return the first point where threshold is exceeded
[?2004l[?2004h>         idx = above_thresh[0]
[?2004l[?2004h>         # Refine by looking for the actual onset
[?2004l[?2004h>         for j in range(idx, max(0, idx-sta_len), -1):
[?2004l[?2004h>             if cf[j] < threshold * 0.7:
[?2004l[?2004h>                 return j
[?2004l[?2004h>         return idx
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def pick_by_energy(data, fs, window_sec=0.5):
[?2004l[?2004h>     """Pick based on energy increase"""
[?2004l[?2004h>     window = int(window_sec * fs)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate running energy
[?2004l[?2004h>     energy = uniform_filter1d(data**2, size=window, mode='nearest')
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate derivative of energy
[?2004l[?2004h>     energy_diff = np.diff(energy)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find maximum energy increase
[?2004l[?2004h>     if len(energy_diff) > 0:
[?2004l[?2004h>         max_idx = np.argmax(energy_diff)
[?2004l[?2004h>         return max_idx
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def pick_by_kurtosis(data, fs, window_sec=1.0):
[?2004l[?2004h>     """Pick based on kurtosis - higher kurtosis indicates impulsive arrival"""
[?2004l[?2004h>     window = int(window_sec * fs)
[?2004l[?2004h>     npts = len(data)
[?2004l[?2004h>     kurtosis = np.zeros(npts)
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(window, npts - window):
[?2004l[?2004h>         segment = data[i:i+window]
[?2004l[?2004h>         mean = np.mean(segment)
[?2004l[?2004h>         std = np.std(segment)
[?2004li[?2004h>         if std > 1e-10:
[?2004l[?2004h>             kurtosis[i] = np.mean(((segment - mean) / std) ** 4) - 3
[?2004l[?2004h>     
[?2004l[?2004h>     # Find maximum kurtosis
[?2004l[?2004h>     max_idx = np.argmax(kurtosis)
[?2004l[?2004h>     return max_idx
[?2004l[?2004h> 
[?2004l [?2004h> def aic_pick(data):
[?2004l[?2004h>     """Akaike Information Criterion picker"""
[?2004l[?2004h>     npts = len(data)
[?2004l[?2004h>     aic = np.zeros(npts)
[?2004l[?2004h>     
[?2004l[?2004h>     for k in range(1, npts - 1):
[?2004l[?2004h>         var1 = np.var(data[:k]) if k > 0 else 1e-10
[?2004l[?2004h>         var2 = np.var(data[k:]) if k < npts else 1e-10
[?2004l[?2004h>         var1 = max(var1, 1e-10)
[?2004l[?2004h>         var2 = max(var2, 1e-10)
[?2004l[?2004h>         aic[k] = k * np.log(var1) + (npts - k - 1) * np.log(var2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find minimum AIC (excluding edges)
[?2004l[?2004h>     margin = int(npts * 0.05)
[?2004l[?2004h>     search_region = aic[margin:npts-margin]
[?2004l[?2004h>     if len(search_region) > 0:
[?2004l[?2004h>         min_idx = np.argmin(search_region) + margin
[?2004l[?2004h>         return min_idx
[?2004l[?2004h>     return npts // 2
[?2004l[?2004h> 
[?2004l [?2004h> def process_file(filepath):
[?2004l[?2004h>     """Process a single trace file and return picks"""
[?2004l[?2004h>     f = np.load(filepath, allow_pickle=True)
[?2004l[?2004h>     data = f['data']  # shape: (12000, 3)
[?2004l[?2004h>     dt = float(f['dt'])
[?2004l[?2004h>     fs = 1.0 / dt
[?2004l[?2004h>     channels = str(f['channels']).split(',')
[?2004l[?2004h>     
[?2004l[?2004h>     # Identify channel indices (E, N, Z)
[?2004l[?2004h>     z_idx, e_idx, n_idx = 2, 0, 1  # defaults
[?2004l[?2004h>     
[?2004l[?2004h>     for i, ch in enumerate(channels):
[?2004l[?2004h>         if ch.endswith('Z'):
[?2004l[?2004h>             z_idx = i
[?2004l[?2004h>         elif ch.endswith('E') or ch.endswith('1'):
[?2004l[?2004h>             e_idx = i
[?2004l[?2004h>         elif ch.endswith('N') or ch.endswith('2'):
[?2004l[?2004h>             n_idx = i
[?2004l[?2004h>     
[?2004l[?2004h>     # Get components
[?2004l[?2004h>     data_z = data[:, z_idx].copy()
[?2004l[?2004h>     data_e = data[:, e_idx].copy()
[?2004l[?2004h>     data_n = data[:, n_idx].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     # Remove mean
[?2004l[?2004h>     data_z -= np.mean(data_z)
[?2004l[?2004h>     data_e -= np.mean(data_e)
[?2004l[?2004h>     data_n -= np.mean(data_n)
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter for P-wave (higher frequency content)
[?2004l[?2004h>     try:
[?2004l[?2004h>         filt_z = bandpass_filter(data_z, 1.0, 20.0, fs)
[?2004l[?2004h>     except:
[?2004l[?2004h>         filt_z = data_z
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter for S-wave (slightly lower frequency)
[?2004l[?2004h>     try:
[?2004l[?2004h>         horizontal = np.sqrt(data_e**2 + data_n**2)
[?2004l[?2004h>         filt_h = bandpass_filter(horizontal, 1.0, 15.0, fs)
[?2004l[?2004h>     except:
[?2004l[?2004h>         filt_h = np.sqrt(data_e**2 + data_n**2)
[?2004l[?2004h>     
[?2004l[?2004h>     picks = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Try multiple methods for P-wave and take the best
[?2004l[?2004h>     p_candidates = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Method 1: STA/LTA with different thresholds
[?2004l[?2004h>     for thresh in [1.5, 2.0, 2.5, 3.0]:
[?2004l[?2004h>         p = pick_phase_stalta(filt_z, fs, sta_sec=0.1, lta_sec=2.0, threshold=thresh)
[?2004l[?2004h>         if p is not None and 100 < p < 11900:
[?2004l[?2004h>             p_candidates.append(p)
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Method 2: AIC picker on filtered vertical
[?2004l[?2004h>     aic_p = aic_pick(filt_z)
[?2004l[?2004h>     if 100 < aic_p < 11900:
[?2004l[?2004h>         p_candidates.append(aic_p)
[?2004l[?2004h>     
[?2004l[?2004h>     # Method 3: Energy-based
[?2004l[?2004h>     energy_p = pick_by_energy(filt_z, fs, window_sec=0.3)
[?2004l[?2004h>     if energy_p is not None and 100 < energy_p < 11900:
[?2004l[?2004h>         p_candidates.append(energy_p)
[?2004l[?2004h>     
[?2004l[?2004h>     # Choose P pick - prefer STA/LTA if available, otherwise use AIC
[?2004l[?2004h>     if len(p_candidates) > 0:
[?2004l[?2004h>         # Use median of candidates to be robust
[?2004l[?2004h>         p_pick = int(np.median(p_candidates))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Fallback: use middle of trace
[?2004l[?2004h>         p_pick = 6000
[?2004l[?2004h>     
[?2004l[?2004h>     picks.append(('P', p_pick))
[?2004l[?2004h>     
[?2004l[?2004h>     # S-wave picking
[?2004l[?2004h>     s_candidates = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Search for S-wave after P-wave
[?2004l[?2004h>     min_ps_sep = int(0.2 * fs)  # Minimum 0.2 seconds after P
[?2004l[?2004h>     search_start = p_pick + min_ps_sep
[?2004l[?2004h>     
[?2004l[?2004h>     if search_start < len(filt_h) - 100:
[?2004l[?2004h>         # Method 1: STA/LTA on horizontal after P
[?2004l[?2004h>         for thresh in [1.3, 1.5, 2.0]:
[?2004l[?2004h>             s = pick_phase_stalta(filt_h[search_start:], fs, sta_sec=0.15, lta_sec=1.5, threshold=thresh)
[?2004l[?2004h>             if s is not None:
[?2004l[?2004h>                 s_idx = search_start + s
[?2004l[?2004h>                 if s_idx < 11900:
[?2004l[?2004h>                     s_candidates.append(s_idx)
[?2004l[?2004h>                     break
[?2004l[?2004h>         
[?2004l[?2004h>         # Method 2: AIC on horizontal after P
[?2004l[?2004h>         aic_s = aic_pick(filt_h[search_start:])
[?2004l[?2004h>         s_idx = search_start + aic_s
[?2004l[?2004h>         if s_idx < 11900:
[?2004l[?2004h>             s_candidates.append(s_idx)
[?2004l[?2004h>         
[?2004l[?2004h>         # Method 3: Energy-based after P
[?2004l[?2004h>         energy_s = pick_by_energy(filt_h[search_start:], fs, window_sec=0.3)
[?2004l[?2004h>         if energy_s is not None:
[?2004l[?2004h>             s_idx = search_start + energy_s
[?2004l[?2004h>             if s_idx < 11900:
[?2004l[?2004h>                 s_candidates.append(s_idx)
[?2004l[?2004h>     
[?2004l[?2004h>     if len(s_candidates) > 0:
[?2004l[?2004h>         s_pick = int(np.median(s_candidates))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Fallback: estimate S from P using typical Vp/Vs ratio
[?2004l[?2004h>         # S arrives about 1.73x later than P (relative to event time)
[?2004l[?2004h>         # Assume event is at index 6000, so S is roughly at P + 0.73*(P-6000) or just P + some offset
[?2004l[?2004h>         s_pick = min(p_pick + int(1.0 * fs), 11900)  # 1 second after P as fallback
[?2004l[?2004h>     
[?2004l[?2004h>     picks.append(('S', s_pick))
[?2004l[?2004h>     
[?2004l[?2004h>     return picks
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     data_dir = '/root/data/'
[?2004l[?2004h>     output_file = '/root/results.csv'
[?2004l[?2004h>     
[?2004l[?2004h>     files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])
[?2004l[?2004h>     
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for fname in files:
[?2004l[?2004h>         filepath = os.path.join(data_dir, fname)
[?2004l[?2004h>         try:
[?2004l[?2004h>             picks = process_file(filepath)
[?2004l[?2004h>             for phase, idx in picks:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     'file_name': fname,
[?2004l[?2004h>                     'phase': phase,
[?2004l[?2004h>                     'pick_idx': idx
[?2004l[?2004h>                 })
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f'Error processing {fname}: {e}')
[?2004l[?2004h>             # Add fallback picks
[?2004l[?2004h>             results.append({'file_name': fname, 'phase': 'P', 'pick_idx': 6000})
[?2004l[?2004h>             results.append({'file_name': fname, 'phase': 'S', 'pick_idx': 7000})
[?2004l[?2004h>     
[?2004l[?2004h>     # Write results to CSV
[?2004l[?2004h>     with open(output_file, 'w', newline='') as csvfile:
[?2004l[?2004h>         fieldnames = ['file_name', 'phase', 'pick_idx']
[?2004l[?2004h>         writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
[?2004l[?2004h>         writer.writeheader()
[?2004l[?2004h>         for row in results:
[?2004l[?2004h>             writer.writerow(row)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'Processed {len(files)} files')
[?2004l[?2004h>     print(f'Total picks: {len(results)}')
[?2004l[?2004h>     print(f'Results written to {output_file}')
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
