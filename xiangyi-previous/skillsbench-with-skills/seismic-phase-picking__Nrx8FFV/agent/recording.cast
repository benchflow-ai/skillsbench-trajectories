[144.136988, "o", "\u001b[?2004h>             return [valid_picks[0]]\r\n\u001b[?2004l\r\u001b[?2004h>         # If no valid picks after P, return first pick after P\r\n\u001b[?2004l\r\u001b[?2004h>         for p in picks:\r\n\u001b[?2004l\r\u001b[?2004h>             if p > p_pick:\r\n\u001b[?2004l\r\u001b[?2004h>                 return [p]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if len(picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         return [picks[0]]\r\n\u001b[?2004l\r\u001b[?2004h>     return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def process_file(filepath):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Process a single trace file and return picks\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     f = np.load(filepath, allow_pickle=True)\r\n\u001b[?2004l\r\u001b[?2004h>     data = f['data']  # shape: (12000, 3)\r\n\u001b[?2004l\r\u001b[?2004h>     dt = float(f['dt'])\r\n\u001b[?2004l\r\u001b[?2004h>     fs = 1.0 / dt\r\n\u001b[?2004l\r\u001b[?2004h>     channels = str(f['channels']).split(',')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
