[231.997669, "o", "import numpy as np\r\n\u001b[?2004l\r \u001b[?2004h"]
[231.997732, "o", "> import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.997848, "o", "from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.997915, "o", "> "]
[231.998033, "o", "from scipy.ndimage import uniform_filter1d\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.998112, "o", "> import csv\r\n\u001b[?2004l\r"]
[231.998176, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.998487, "o", "def bandpass_filter(data, lowcut, highcut, fs, order=3):\r\n\u001b[?2004l\r"]
[231.998568, "o", "\u001b[?2004h> "]
[231.998736, "o", "    \"\"\"Apply bandpass filter to data\"\"\"\r\n\u001b[?2004l\r"]
[231.998898, "o", "\u001b[?2004h>     nyq = 0.5 * fs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.998974, "o", "    low = lowcut / nyq\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.99909, "o", "    high = highcut / nyq\r\n\u001b[?2004l\r"]
[231.999151, "o", "\u001b[?2004h> "]
[231.999263, "o", "    low = max(0.001, min(low, 0.99))\r\n\u001b[?2004l\r"]
[231.999322, "o", "\u001b[?2004h> "]
[231.99955, "o", "    high = max(low + 0.01, min(high, 0.999))\r\n\u001b[?2004l\r"]
[231.999612, "o", "\u001b[?2004h> "]
[231.999958, "o", "    b, a = signal.butter(order, [low, high], btype='band')\r\n\u001b[?2004l\r"]
[232.00002, "o", "\u001b[?2004h> "]
[232.000509, "o", "    return signal.filtfilt(b, a, data, axis=0, padlen=min(150, len(data)-1))\r\n\u001b[?2004l\r"]
[232.00057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[232.000626, "o", "\u001b[?2004h> "]
[232.000907, "o", "def recursive_sta_lta(data, sta_len, lta_len):\r\n\u001b[?2004l\r"]
[232.000964, "o", "\u001b[?2004h> "]
[232.002494, "o", "    \"\"\"Calculate recursive STA/LTA ratio\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     npts = len(data)\r\n\u001b[?2004l\r\u001b[?2004h>     cf = np.zeros(npts)\r\n\u001b[?2004l\r\u001b[?2004h>     abs_data = np.abs(data)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Initialize\r\n\u001b[?2004l\r\u001b[?2004h>     sta = np.mean(abs_data[:sta_len])\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.002604, "o", "> "]
[232.005075, "o", "    lta = np.mean(abs_data[:lta_len])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(lta_len, npts):\r\n\u001b[?2004l\r\u001b[?2004h>         sta = sta + (abs_data[i] - abs_data[i-sta_len]) / sta_len\r\n\u001b[?2004l\r\u001b[?2004h>         lta = lta + (abs_data[i] - abs_data[i-lta_len]) / lta_len\r\n\u001b[?2004l\r\u001b[?2004h>         if lta > 1e-10:\r\n\u001b[?2004l\r\u001b[?2004h>             cf[i] = sta / lta\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.005236, "o", "    return cf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h> "]
[232.005746, "o", "def pick_phase_stalta(data, fs, sta_sec=0.1, lta_sec=2.0, threshold=2.0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.005859, "o", "> "]
[232.006117, "o", "    \"\"\"Pick phase using STA/LTA method\"\"\"\r\n\u001b[?2004l\r"]
[232.006331, "o", "\u001b[?2004h> "]
[232.006521, "o", "    sta_len = int(sta_sec * fs)\r\n\u001b[?2004l\r"]
[232.006584, "o", "\u001b[?2004h> "]
[232.006855, "o", "    lta_len = int(lta_sec * fs)\r\n\u001b[?2004l\r"]
[232.006953, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.007039, "o", "\u001b[?2004h> "]
[232.0075, "o", "    cf = recursive_sta_lta(data, sta_len, lta_len)\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.007616, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[232.007709, "o", "> "]
[232.007915, "o", "    # Find where CF exceeds threshold\r\n\u001b[?2004l\r"]
[232.008003, "o", "\u001b[?2004h> "]
[232.008278, "o", "    above_thresh = np.where(cf > threshold)[0]\r\n\u001b[?2004l\r"]
[232.00832, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.008354, "o", "\u001b[?2004h> "]
[232.008531, "o", "    if len(above_thresh) > 0:\r\n\u001b[?2004l\r"]
[232.00857, "o", "\u001b[?2004h> "]
[232.008874, "o", "        # Return the first point where threshold is exceeded\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.00891, "o", "> "]
[232.009034, "o", "        idx = above_thresh[0]\r\n\u001b[?2004l\r"]
[232.009069, "o", "\u001b[?2004h> "]
[232.009349, "o", "        # Refine by looking for the actual onset\r\n\u001b[?2004l\r"]
[232.009401, "o", "\u001b[?2004h> "]
[232.009649, "o", "        for j in range(idx, max(0, idx-sta_len), -1):\r\n\u001b[?2004l\r"]
[232.009702, "o", "\u001b[?2004h> "]
[232.009895, "o", "            if cf[j] < threshold * 0.7:\r\n\u001b[?2004l\r"]
[232.00993, "o", "\u001b[?2004h> "]
[232.010048, "o", "                return j\r\n\u001b[?2004l\r"]
[232.010081, "o", "\u001b[?2004h> "]
[232.010182, "o", "        return idx\r\n\u001b[?2004l\r"]
[232.010216, "o", "\u001b[?2004h> "]
[232.010291, "o", "    return None\r\n\u001b[?2004l\r"]
[232.010324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[232.010365, "o", "\u001b[?2004h> "]
[232.010611, "o", "def pick_by_energy(data, fs, window_sec=0.5):\r\n\u001b[?2004l\r"]
[232.010666, "o", "\u001b[?2004h> "]
[232.010894, "o", "    \"\"\"Pick based on energy increase\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.011122, "o", "    window = int(window_sec * fs)\r\n\u001b[?2004l\r"]
[232.011161, "o", "\u001b[?2004h>     \r\n"]
[232.0112, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.011384, "o", "    # Calculate running energy\r\n\u001b[?2004l\r"]
[232.011422, "o", "\u001b[?2004h> "]
[232.01182, "o", "    energy = uniform_filter1d(data**2, size=window, mode='nearest')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.011858, "o", "    \r\n\u001b[?2004l\r"]
[232.011894, "o", "\u001b[?2004h> "]
[232.012116, "o", "    # Calculate derivative of energy\r\n\u001b[?2004l\r"]
[232.012153, "o", "\u001b[?2004h> "]
[232.012313, "o", "    energy_diff = np.diff(energy)\r\n\u001b[?2004l\r"]
[232.012363, "o", "\u001b[?2004h> "]
[232.012414, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.012579, "o", "    # Find maximum energy increase\r\n\u001b[?2004l\r"]
[232.012612, "o", "\u001b[?2004h> "]
[232.012753, "o", "    if len(energy_diff) > 0:\r\n\u001b[?2004l\r"]
[232.012796, "o", "\u001b[?2004h> "]
[232.012986, "o", "        max_idx = np.argmax(energy_diff)\r\n\u001b[?2004l\r"]
[232.013033, "o", "\u001b[?2004h> "]
[232.013113, "o", "        return max_idx\r\n\u001b[?2004l\r"]
[232.013143, "o", "\u001b[?2004h"]
[232.013225, "o", ">     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.013538, "o", "def pick_by_kurtosis(data, fs, window_sec=1.0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.01358, "o", "> "]
[232.014065, "o", "    \"\"\"Pick based on kurtosis - higher kurtosis indicates impulsive arrival\"\"\"\r\n\u001b[?2004l\r"]
[232.014114, "o", "\u001b[?2004h> "]
[232.01428, "o", "    window = int(window_sec * fs)\r\n\u001b[?2004l\r"]
[232.014317, "o", "\u001b[?2004h> "]
[232.014441, "o", "    npts = len(data)\r\n\u001b[?2004l\r"]
[232.014477, "o", "\u001b[?2004h> "]
[232.014654, "o", "    kurtosis = np.zeros(npts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.014697, "o", ">     "]
[232.014736, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.015061, "o", "    for i in range(window, npts - window):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.015299, "o", "        segment = data[i:i+window]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.015478, "o", "        mean = np.mean(segment)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.015618, "o", "        std = np.std(segment)\r\n\u001b[?2004l\ri\u001b[?2004h"]
[232.015653, "o", "> "]
[232.015748, "o", "        if std > 1e-10:\r\n\u001b[?2004l\r"]
[232.01579, "o", "\u001b[?2004h> "]
[232.016216, "o", "            kurtosis[i] = np.mean(((segment - mean) / std) ** 4) - 3\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.016255, "o", ">     \r\n\u001b[?2004l\r"]
[232.016289, "o", "\u001b[?2004h"]
[232.016329, "o", "> "]
[232.016418, "o", "    # Find maximum kurtosis\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.016454, "o", "> "]
[232.0166, "o", "    max_idx = np.argmax(kurtosis)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.016687, "o", "    return max_idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.016721, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[232.016752, "o", "> "]
[232.016847, "o", "def aic_pick(data):\r\n\u001b[?2004l\r"]
[232.016878, "o", "\u001b[?2004h> "]
[232.017274, "o", "    \"\"\"Akaike Information Criterion picker\"\"\"\r\n\u001b[?2004l\r"]
[232.017333, "o", "\u001b[?2004h>     npts = len(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.017474, "o", "    aic = np.zeros(npts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.017532, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[232.017592, "o", "> "]
[232.019825, "o", "    for k in range(1, npts - 1):\r\n\u001b[?2004l\r\u001b[?2004h>         var1 = np.var(data[:k]) if k > 0 else 1e-10\r\n\u001b[?2004l\r\u001b[?2004h>         var2 = np.var(data[k:]) if k < npts else 1e-10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.019959, "o", "        var1 = max(var1, 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h>         var2 = max(var2, 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h>         aic[k] = k * np.log(var1) + (npts - k - 1) * np.log(var2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find minimum AIC (excluding edges)\r\n\u001b[?2004l\r\u001b[?2004h>     margin = int(npts * 0.05)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.020097, "o", "    search_region = aic[margin:npts-margin]\r\n\u001b[?2004l\r"]
[232.020137, "o", "\u001b[?2004h> "]
[232.020327, "o", "    if len(search_region) > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.02036, "o", "> "]
[232.020644, "o", "        min_idx = np.argmin(search_region) + margin\r\n\u001b[?2004l\r"]
[232.020682, "o", "\u001b[?2004h> "]
[232.020807, "o", "        return min_idx\r\n\u001b[?2004l\r"]
[232.020842, "o", "\u001b[?2004h> "]
[232.020976, "o", "    return npts // 2\r\n\u001b[?2004l\r"]
[232.02102, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[232.021056, "o", "\u001b[?2004h> "]
[232.021286, "o", "def process_file(filepath):\r\n\u001b[?2004l\r"]
[232.021317, "o", "\u001b[?2004h"]
[232.021354, "o", "> "]
[232.021708, "o", "    \"\"\"Process a single trace file and return picks\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.021997, "o", "    f = np.load(filepath, allow_pickle=True)\r\n\u001b[?2004l\r"]
[232.022054, "o", "\u001b[?2004h> "]
[232.022282, "o", "    data = f['data']  # shape: (12000, 3)\r\n\u001b[?2004l\r"]
[232.022323, "o", "\u001b[?2004h> "]
[232.022503, "o", "    dt = float(f['dt'])\r\n\u001b[?2004l\r"]
[232.022545, "o", "\u001b[?2004h"]
[232.022583, "o", "> "]
[232.02262, "o", "    fs = 1.0 / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.024275, "o", "    channels = str(f['channels']).split(',')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Identify channel indices (E, N, Z)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.024724, "o", "    z_idx, e_idx, n_idx = 2, 0, 1  # defaults\r\n\u001b[?2004l\r"]
[232.024906, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.030922, "o", "    for i, ch in enumerate(channels):\r\n\u001b[?2004l\r\u001b[?2004h>         if ch.endswith('Z'):\r\n\u001b[?2004l\r\u001b[?2004h>             z_idx = i\r\n\u001b[?2004l\r\u001b[?2004h>         elif ch.endswith('E') or ch.endswith('1'):\r\n\u001b[?2004l\r\u001b[?2004h>             e_idx = i\r\n\u001b[?2004l\r\u001b[?2004h>         elif ch.endswith('N') or ch.endswith('2'):\r\n\u001b[?2004l\r\u001b[?2004h>             n_idx = i\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Get components\r\n\u001b[?2004l\r\u001b[?2004h>     data_z = data[:, z_idx].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     data_e = data[:, e_idx].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     data_n = data[:, n_idx].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Remove mean\r\n\u001b[?2004l\r\u001b[?2004h>     data_z -= np.mean(data_z)\r\n\u001b[?2004l\r\u001b[?2004h>     data_e -= np.mean(data_e)\r\n\u001b[?2004l\r\u001b[?2004h>     data_n -= np.mean(data_n)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Filter for P-wave (higher frequency content)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         filt_z = bandpass_filter(data_z, 1.0, 20.0, fs)\r\n\u001b[?2004l\r\u001b[?2004h>     except:\r\n\u001b[?2004l\r\u001b[?2004h>         filt_z = data_z\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Filter for S-wave (slightly lower frequency)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[232.031065, "o", "\u001b[?2004h> "]
[232.031158, "o", "        horizontal = np.sqrt(data_e**2 + data_n**2)\r\n\u001b[?2004l\r"]
[232.031239, "o", "\u001b[?2004h"]
[232.031317, "o", "> "]
[232.031413, "o", "        filt_h = bandpass_filter(horizontal, 1.0, 15.0, fs)\r\n\u001b[?2004l\r"]
[232.031493, "o", "\u001b[?2004h>     except:\r\n\u001b[?2004l\r"]
[232.031569, "o", "\u001b[?2004h> "]
[232.031644, "o", "        filt_h = np.sqrt(data_e**2 + data_n**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.031712, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.03178, "o", "    picks = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[232.031851, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.031988, "o", "    # Try multiple methods for P-wave and take the best\r\n\u001b[?2004l\r"]
[232.032072, "o", "\u001b[?2004h>     p_candidates = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.032151, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.03226, "o", "    # Method 1: STA/LTA with different thresholds\r\n\u001b[?2004l\r"]
[232.032339, "o", "\u001b[?2004h> "]
[232.032414, "o", "    for thresh in [1.5, 2.0, 2.5, 3.0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.032627, "o", "        p = pick_phase_stalta(filt_z, fs, sta_sec=0.1, lta_sec=2.0, threshold=thresh)\r\n\u001b[?2004l\r"]
[232.032712, "o", "\u001b[?2004h> "]
[232.032795, "o", "        if p is not None and 100 < p < 11900:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.032886, "o", "            p_candidates.append(p)\r\n\u001b[?2004l\r"]
[232.032966, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[232.033115, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.033258, "o", "    # Method 2: AIC picker on filtered vertical\r\n\u001b[?2004l\r\u001b[?2004h>     aic_p = aic_pick(filt_z)\r\n"]
[232.033357, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.033446, "o", "    if 100 < aic_p < 11900:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.033533, "o", "        p_candidates.append(aic_p)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.033614, "o", "\u001b[?2004h> "]
[232.033694, "o", "    # Method 3: Energy-based\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.033805, "o", "    energy_p = pick_by_energy(filt_z, fs, window_sec=0.3)\r\n\u001b[?2004l\r"]
[232.033884, "o", "\u001b[?2004h> "]
[232.033972, "o", "    if energy_p is not None and 100 < energy_p < 11900:\r\n\u001b[?2004l\r"]
[232.03405, "o", "\u001b[?2004h> "]
[232.034119, "o", "        p_candidates.append(energy_p)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[232.034196, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.034339, "o", "    # Choose P pick - prefer STA/LTA if available, otherwise use AIC\r\n\u001b[?2004l\r"]
[232.03442, "o", "\u001b[?2004h> "]
[232.034499, "o", "    if len(p_candidates) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.034611, "o", "        # Use median of candidates to be robust\r\n\u001b[?2004l\r"]
[232.034694, "o", "\u001b[?2004h> "]
[232.034772, "o", "        p_pick = int(np.median(p_candidates))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.034864, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.034955, "o", "        # Fallback: use middle of trace\r\n\u001b[?2004l\r"]
[232.035035, "o", "\u001b[?2004h> "]
[232.035114, "o", "        p_pick = 6000\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[232.035187, "o", "> "]
[232.035259, "o", "    picks.append(('P', p_pick))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.035342, "o", "\u001b[?2004h>     # S-wave picking\r\n\u001b[?2004l\r"]
[232.035417, "o", "\u001b[?2004h> "]
[232.035494, "o", "    s_candidates = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.035603, "o", "    # Search for S-wave after P-wave\r\n\u001b[?2004l\r"]
[232.035683, "o", "\u001b[?2004h> "]
[232.035793, "o", "    min_ps_sep = int(0.2 * fs)  # Minimum 0.2 seconds after P\r\n\u001b[?2004l\r"]
[232.035875, "o", "\u001b[?2004h> "]
[232.035954, "o", "    search_start = p_pick + min_ps_sep\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.036032, "o", "\u001b[?2004h> "]
[232.03611, "o", "    if search_start < len(filt_h) - 100:\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.036187, "o", "> "]
[232.036265, "o", "        # Method 1: STA/LTA on horizontal after P\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.036373, "o", "        for thresh in [1.3, 1.5, 2.0]:\r\n\u001b[?2004l\r"]
[232.036456, "o", "\u001b[?2004h> "]
[232.036679, "o", "            s = pick_phase_stalta(filt_h[search_start:], fs, sta_sec=0.15, lta_sec=1.5, threshold=thresh)\r\n\u001b[?2004l\r"]
[232.036765, "o", "\u001b[?2004h>             if s is not None:\r\n"]
[232.036846, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.036927, "o", "                s_idx = search_start + s\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.037003, "o", "> "]
[232.037082, "o", "                if s_idx < 11900:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.037193, "o", "                    s_candidates.append(s_idx)\r\n\u001b[?2004l\r"]
[232.037276, "o", "\u001b[?2004h>                     break\r\n\u001b[?2004l\r"]
[232.037365, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.037499, "o", "        # Method 2: AIC on horizontal after P\r\n\u001b[?2004l\r"]
[232.037594, "o", "\u001b[?2004h> "]
[232.037677, "o", "        aic_s = aic_pick(filt_h[search_start:])\r\n\u001b[?2004l\r"]
[232.037768, "o", "\u001b[?2004h> "]
[232.037856, "o", "        s_idx = search_start + aic_s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.037948, "o", "        if s_idx < 11900:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.038073, "o", "            s_candidates.append(s_idx)\r\n\u001b[?2004l\r"]
[232.038166, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.038309, "o", "        # Method 3: Energy-based after P\r\n\u001b[?2004l\r"]
[232.038405, "o", "\u001b[?2004h> "]
[232.038559, "o", "        energy_s = pick_by_energy(filt_h[search_start:], fs, window_sec=0.3)\r\n\u001b[?2004l\r"]
[232.038652, "o", "\u001b[?2004h> "]
[232.038744, "o", "        if energy_s is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.038853, "o", "            s_idx = search_start + energy_s\r\n\u001b[?2004l\r"]
[232.038956, "o", "\u001b[?2004h>             if s_idx < 11900:\r\n\u001b[?2004l\r"]
[232.039045, "o", "\u001b[?2004h> "]
[232.039133, "o", "                s_candidates.append(s_idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.039222, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.039316, "o", "    if len(s_candidates) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.039453, "o", "        s_pick = int(np.median(s_candidates))\r\n\u001b[?2004l\r"]
[232.039497, "o", "\u001b[?2004h> "]
[232.039542, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.039726, "o", "        # Fallback: estimate S from P using typical Vp/Vs ratio\r\n\u001b[?2004l\r"]
[232.039771, "o", "\u001b[?2004h> "]
[232.039956, "o", "        # S arrives about 1.73x later than P (relative to event time)\r\n\u001b[?2004l\r"]
[232.039997, "o", "\u001b[?2004h> "]
[232.040537, "o", "        # Assume event is at index 6000, so S is roughly at P + 0.73*(P-6000) or just P + some offset"]
[232.040584, "o", "\r\n\u001b[?2004l\r"]
[232.040623, "o", "\u001b[?2004h> "]
[232.040857, "o", "        s_pick = min(p_pick + int(1.0 * fs), 11900)  # 1 second after P as fallback\r\n\u001b[?2004l\r"]
[232.040897, "o", "\u001b[?2004h>     \r\n"]
[232.040939, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.041033, "o", "    picks.append(('S', s_pick))\r\n\u001b[?2004l\r"]
[232.041071, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.041112, "o", "\u001b[?2004h> "]
[232.041179, "o", "    return picks\r\n\u001b[?2004l\r"]
[232.041221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[232.041265, "o", "\u001b[?2004h> "]
[232.041312, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.041352, "o", "> "]
[232.041405, "o", "    data_dir = '/root/data/'\r\n\u001b[?2004l\r"]
[232.041443, "o", "\u001b[?2004h> "]
[232.041558, "o", "    output_file = '/root/results.csv'\r\n\u001b[?2004l\r"]
[232.041602, "o", "\u001b[?2004h>     \r\n"]
[232.04164, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.041888, "o", "    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\r\n\u001b[?2004l\r"]
[232.041928, "o", "\u001b[?2004h>     \r\n"]
[232.041967, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[232.042032, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.042066, "o", ">     \r\n\u001b[?2004l\r"]
[232.042105, "o", "\u001b[?2004h> "]
[232.042189, "o", "    for fname in files:\r\n\u001b[?2004l\r"]
[232.042229, "o", "\u001b[?2004h> "]
[232.042415, "o", "        filepath = os.path.join(data_dir, fname)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[232.0425, "o", "\u001b[?2004h> "]
[232.04256, "o", "            picks = process_file(filepath)\r\n\u001b[?2004l\r"]
[232.042596, "o", "\u001b[?2004h> "]
[232.042686, "o", "            for phase, idx in picks:\r\n\u001b[?2004l\r"]
[232.042723, "o", "\u001b[?2004h> "]
[232.042832, "o", "                results.append({\r\n\u001b[?2004l\r"]
[232.042869, "o", "\u001b[?2004h> "]
[232.042972, "o", "                    'file_name': fname,\r\n\u001b[?2004l\r"]
[232.043009, "o", "\u001b[?2004h> "]
[232.043118, "o", "                    'phase': phase,\r\n\u001b[?2004l\r"]
[232.043155, "o", "\u001b[?2004h> "]
[232.043239, "o", "                    'pick_idx': idx\r\n\u001b[?2004l\r"]
[232.043276, "o", "\u001b[?2004h> "]
[232.043342, "o", "                })\r\n\u001b[?2004l\r"]
[232.04338, "o", "\u001b[?2004h> "]
[232.043459, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[232.043493, "o", "\u001b[?2004h> "]
[232.043635, "o", "            print(f'Error processing {fname}: {e}')\r\n\u001b[?2004l\r"]
[232.043672, "o", "\u001b[?2004h> "]
[232.043755, "o", "            # Add fallback picks\r\n\u001b[?2004l\r"]
[232.043789, "o", "\u001b[?2004h> "]
[232.044018, "o", "            results.append({'file_name': fname, 'phase': 'P', 'pick_idx': 6000})\r\n\u001b[?2004l\r"]
[232.044075, "o", "\u001b[?2004h> "]
[232.04428, "o", "            results.append({'file_name': fname, 'phase': 'S', 'pick_idx': 7000})\r\n\u001b[?2004l\r"]
[232.044325, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[232.044362, "o", "\u001b[?2004h> "]
[232.044425, "o", "    # Write results to CSV\r\n\u001b[?2004l\r"]
[232.044462, "o", "\u001b[?2004h> "]
[232.044606, "o", "    with open(output_file, 'w', newline='') as csvfile:\r\n\u001b[?2004l\r"]
[232.044646, "o", "\u001b[?2004h> "]
[232.044777, "o", "        fieldnames = ['file_name', 'phase', 'pick_idx']\r\n\u001b[?2004l\r"]
[232.044814, "o", "\u001b[?2004h> "]
[232.044965, "o", "        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\r\n\u001b[?2004l\r"]
[232.045002, "o", "\u001b[?2004h> "]
[232.045962, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h>         for row in results:\r\n\u001b[?2004l\r\u001b[?2004h>             writer.writerow(row)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Processed {len(files)} files')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Total picks: {len(results)}')\r\n\u001b[?2004l\r"]
[232.046118, "o", "\u001b[?2004h>     print(f'Results written to {output_file}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.046168, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> ENDOFSCRIPT\r\n"]
[232.046215, "o", "\u001b[?2004l\r"]
[232.085737, "o", "\u001b[?2004hroot@7b5c2b1a4d9a:~# "]
[233.286929, "i", "python3 /root/phase_picker2.py\n"]
[233.287281, "o", "python3 /root/phase_picker2.py"]
[233.291466, "o", "\r\n\u001b[?2004l\r"]
[390.295827, "o", "Processed 100 files\r\nTotal picks: 200\r\nResults written to /root/results.csv\r\n"]
[390.444619, "o", "\u001b[?2004hroot@7b5c2b1a4d9a:~# "]
[402.575443, "i", "head -30 /root/results.csv\n"]
