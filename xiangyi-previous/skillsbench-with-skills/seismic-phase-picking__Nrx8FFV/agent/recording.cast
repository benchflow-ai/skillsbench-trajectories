[402.673081, "o", "file_name,phase,pick_idx\r\r\nBG.ACR..DP.0215954.npz,P,3336\r\r\nBG.ACR..DP.0215954.npz,S,4925\r\r\nBG.ACR..DP.0346833.npz,P,3318\r\r\nBG.ACR..DP.0346833.npz,S,4910\r\r\nBG.AL6..DP.0301915.npz,P,3317\r\r\nBG.AL6..DP.0301915.npz,S,4949\r\r\nBG.BRP..DP.0414480.npz,P,3383\r\r\nBG.BRP..DP.0414480.npz,S,4977\r\r\nBG.DRK..DP.0351524.npz,P,5087\r\r\nBG.DRK..DP.0351524.npz,S,5780\r\r\nBG.EPR..DP.0252305.npz,P,3394\r\r\nBG.EPR..DP.0252305.npz,S,5012\r\r\nBG.HER..DP.0254197.npz,P,3379\r\r\nBG.HER..DP.0254197.npz,S,4984\r\r\nBG.NEG..DP.0343655.npz,P,3346\r\r\nBG.NEG..DP.0343655.npz,S,4949\r\r\nBG.RGP..DP.0279913.npz,P,3406\r\r\nBG.RGP..DP.0279913.npz,S,5006\r\r\nBG.SQK..DP.0399575.npz,P,3325\r\r\nBG.SQK..DP.0399575.npz,S,4911\r\r\nBG.STY..DP.0409927.npz,P,3325\r\r\nBG.STY..DP.0409927.npz,S,4913\r\r\nBG.TCH..DP.0283495.npz,P,3324\r\r\nBG.TCH..DP.0283495.npz,S,4912\r\r\nBK.BRIB..HH.0223041.npz,P,3298\r\r\nBK.BRIB..HH.0223041.npz,S,3756\r\r\nBK.CVS.00.HH.0345771.npz,P,3439\r\r\nBK.CVS.00.HH.0345771.npz,S,5070\r\r\nBK.DANT.00.BH.0373267.npz,P,600\r\r\n"]
[402.673947, "o", "\u001b[?2004hroot@7b5c2b1a4d9a:~# "]
[403.2205, "i", "python3 -c \"\nimport csv\nwith open('/root/results.csv') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n    p_picks = [int(r['pick_idx']) for r in rows if r['phase'] == 'P']\n    s_picks = [int(r['pick_idx']) for r in rows if r['phase'] == 'S']\n    print(f'P picks: min={min(p_picks)}, max={max(p_picks)}, mean={sum(p_picks)/len(p_picks):.0f}')\n    print(f'S picks: min={min(s_picks)}, max={max(s_picks)}, mean={sum(s_picks)/len(s_picks):.0f}')\n\"\n"]
[403.221411, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/results.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.221721, "o", ">     rows = list(reader)"]
[403.221813, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     p_picks = [int(r['pick_idx']) for r in rows if r['phase'] == 'P']"]
[403.221892, "o", "\r\n"]
[403.22197, "o", "\u001b[?2004l\r"]
[403.222071, "o", "\u001b[?2004h"]
[403.222311, "o", "> "]
[403.222402, "o", "    s_picks = [int(r['pick_idx']) for r in rows if r['phase'] == 'S']"]
[403.222486, "o", "\r\n"]
[403.22258, "o", "\u001b[?2004l\r"]
[403.222707, "o", "\u001b[?2004h"]
[403.223039, "o", ">     print(f'P picks: min={min(p_picks)}, max={max(p_picks)}, mean={sum(p_picks)/len(p_picks):.0f}')"]
[403.223121, "o", "\r\n"]
[403.223201, "o", "\u001b[?2004l\r"]
[403.22331, "o", "\u001b[?2004h"]
[403.223407, "o", "> "]
[403.223712, "o", "    print(f'S picks: min={min(s_picks)}, max={max(s_picks)}, mean={sum(s_picks)/len(s_picks):.0f}')"]
[403.223785, "o", "\r\n"]
[403.223858, "o", "\u001b[?2004l\r"]
[403.223953, "o", "\u001b[?2004h"]
[403.224065, "o", "> "]
[403.224253, "o", "\""]
[403.224398, "o", "\r\n"]
[403.224485, "o", "\u001b[?2004l\r"]
[403.247998, "o", "P picks: min=600, max=6238, mean=2234\r\nS picks: min=905, max=8769, mean=3730\r\n"]
