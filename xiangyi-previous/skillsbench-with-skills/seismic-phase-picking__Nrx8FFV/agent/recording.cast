[144.112329, "i", "cat > /root/phase_picker.py << 'ENDOFSCRIPT'\nimport numpy as np\nimport os\nfrom scipy import signal\nfrom scipy.ndimage import uniform_filter1d\nimport csv\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    \"\"\"Apply bandpass filter to data\"\"\"\n    nyq = 0.5 * fs\n    low = lowcut / nyq\n    high = highcut / nyq\n    # Ensure frequencies are valid\n    low = max(0.001, min(low, 0.99))\n    high = max(low + 0.01, min(high, 0.999))\n    b, a = signal.butter(order, [low, high], btype='band')\n    # Use filtfilt for zero-phase filtering\n    return signal.filtfilt(b, a, data, axis=0)\n\ndef sta_lta(data, sta_len, lta_len):\n    \"\"\"Calculate STA/LTA ratio\"\"\"\n    # Calculate short-term and long-term averages using absolute values\n    abs_data = np.abs(data)\n    sta = uniform_filter1d(abs_data, size=sta_len, mode='nearest')\n    lta = uniform_filter1d(abs_data, size=lta_len, mode='nearest')\n    # Avoid division by zero\n    lta[lta < 1e-10] = 1e-10\n    return sta / lta\n\ndef find_triggers(cf, threshold_on, threshold_off, min_separation=100):\n    \"\"\"Find trigger points where characteristic function exceeds threshold\"\"\"\n    triggers = []\n    triggered = False\n    \n    for i in range(len(cf)):\n        if not triggered:\n            if cf[i] >= threshold_on:\n                triggered = True\n                # Find the exact onset by looking back\n                onset = i\n                for j in range(i, max(0, i-50), -1):\n                    if cf[j] < threshold_on * 0.5:\n                        onset = j\n                        break\n                triggers.append(onset)\n        else:\n            if cf[i] < threshold_off:\n                triggered = False\n    \n    # Remove triggers that are too close\n    if len(triggers) > 1:\n        filtered = [triggers[0]]\n        for t in triggers[1:]:\n            if t - filtered[-1] >= min_separation:\n                filtered.append(t)\n        triggers = filtered\n    \n    return triggers\n\ndef pick_p_wave(data_z, fs):\n    \"\"\"Pick P-wave arrival on vertical component\"\"\"\n    # Filter data (1-20 H"]
[144.112584, "i", "z for P-wave)\n    try:\n        filtered = bandpass_filter(data_z, 1.0, 20.0, fs)\n    except:\n        filtered = data_z\n    \n    # STA/LTA parameters (in samples)\n    sta_len = int(0.1 * fs)  # 0.1 second\n    lta_len = int(2.0 * fs)  # 2 seconds\n    \n    # Calculate STA/LTA\n    cf = sta_lta(filtered, sta_len, lta_len)\n    \n    # Find triggers with adaptive threshold\n    threshold = 3.0\n    picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))\n    \n    # If no picks found, try lower threshold\n    if len(picks) == 0:\n        threshold = 2.0\n        picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))\n    \n    # Return first pick (most likely P-wave)\n    if len(picks) > 0:\n        return [picks[0]]\n    return []\n\ndef pick_s_wave(data_e, data_n, fs, p_pick=None):\n    \"\"\"Pick S-wave arrival on horizontal components\"\"\"\n    # Combine horizontal components\n    horizontal = np.sqrt(data_e**2 + data_n**2)\n    \n    # Filter data (1-15 Hz for S-wave)\n    try:\n        filtered = bandpass_filter(horizontal, 1.0, 15.0, fs)\n    except:\n        filtered = horizontal\n    \n    # STA/LTA parameters\n    sta_len = int(0.2 * fs)  # 0.2 second\n    lta_len = int(3.0 * fs)  # 3 seconds\n    \n    # Calculate STA/LTA\n    cf = sta_lta(filtered, sta_len, lta_len)\n    \n    # Find triggers\n    threshold = 2.5\n    picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))\n    \n    # If no picks, try lower threshold\n    if len(picks) == 0:\n        threshold = 2.0\n        picks = find_triggers(cf, threshold, threshold * 0.5, min_separation=int(0.5*fs))\n    \n    # S-wave should come after P-wave\n    if p_pick is not None and len(picks) > 0:\n        # Filter picks that are after P-wave with some minimum separation\n        min_ps_sep = int(0.3 * fs)  # Minimum 0.3 seconds after P\n        valid_picks = [p for p in picks if p > p_pick + min_ps_sep]\n        if len(valid_picks) > 0:\n            return [valid_picks[0]]\n        # If no valid picks after P, return first pick after"]
[144.112948, "o", "cat > /root/phase_picker.py << 'ENDOFSCRIPT'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.113086, "o", "from scipy.ndimage import uniform_filter1d\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[144.113115, "i", " P\n        for p in picks:\n            if p > p_pick:\n                return [p]\n    \n    if len(picks) > 0:\n        return [picks[0]]\n    return []\n\ndef process_file(filepath):\n    \"\"\"Process a single trace file and return picks\"\"\"\n    f = np.load(filepath, allow_pickle=True)\n    data = f['data']  # shape: (12000, 3)\n    dt = float(f['dt'])\n    fs = 1.0 / dt\n    channels = str(f['channels']).split(',')\n    \n    # Identify channel indices (E, N, Z)\n    z_idx = None\n    e_idx = None\n    n_idx = None\n    \n    for i, ch in enumerate(channels):\n        if ch.endswith('Z'):\n            z_idx = i\n        elif ch.endswith('E') or ch.endswith('1'):\n            e_idx = i\n        elif ch.endswith('N') or ch.endswith('2'):\n            n_idx = i\n    \n    # Default indices if not found\n    if z_idx is None:\n        z_idx = 2\n    if e_idx is None:\n        e_idx = 0\n    if n_idx is None:\n        n_idx = 1\n    \n    picks = []\n    \n    # Pick P-wave on vertical component\n    p_picks = pick_p_wave(data[:, z_idx], fs)\n    for p in p_picks:\n        picks.append(('P', int(p)))\n    \n    # Pick S-wave on horizontal components\n    p_pick = p_picks[0] if len(p_picks) > 0 else None\n    s_picks = pick_s_wave(data[:, e_idx], data[:, n_idx], fs, p_pick)\n    for s in s_picks:\n        picks.append(('S', int(s)))\n    \n    return picks\n\ndef main():\n    data_dir = '/root/data/'\n    output_file = '/root/results.csv'\n    \n    files = sorted(os.listdir(data_dir))\n    \n    results = []\n    \n    for fname in files:\n        if not fname.endswith('.npz'):\n            continue\n        \n        filepath = os.path.join(data_dir, fname)\n        try:\n            picks = process_file(filepath)\n            for phase, idx in picks:\n                results.append({\n                    'file_name': fname,\n                    'phase': phase,\n                    'pick_idx': idx\n                })\n        except Exception as e:\n            print(f'Error processing {fname}: {e}')\n    \n    # Write results to CSV\n    with open(output_file, 'w', newline='') as csvfile:\n        fieldnames = ['file_name', 'phase', 'pick_idx']\n        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n        writer.writeheader()\n        for row in results:\n            writer.writerow(row)\n    \n    print(f'Processed {len(files)} files')\n    print(f'Total picks: {len(results)}')\n    print(f'Results written to {output_file}')\n\nif __name__ == '__main__':\n    main()\nENDOFSCRIPT\n"]
