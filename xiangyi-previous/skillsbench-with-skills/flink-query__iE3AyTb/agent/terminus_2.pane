[?2004le[?2004h>         // Job Events
[?2004l[?2004h>         DataStream<JobEvent> jobEvents = env.readTextFile(jobInput)
[?2004l[?2004h>             .map(new MapFunction<String, JobEvent>() {
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public JobEvent map(String s) throws Exception {
[?2004l[?2004h>                     String[] tokens = s.split(",");
[?2004l[?2004h>                     long timestamp = Long.parseLong(tokens[0]) / 1000; // micros to millis
[?2004l[?2004h>                     long jobId = Long.parseLong(tokens[2]);
[?2004l[?2004h>                     int eventType = Integer.parseInt(tokens[3]);
[?2004l[?2004h>                     return new JobEvent(timestamp, jobId, eventType);
[?2004l[?2004h>                 }
[?2004l[?2004h>             })
[?2004l[?2004h>             .filter(new FilterFunction<JobEvent>() {
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public boolean filter(JobEvent jobEvent) throws Exception {
[?2004l[?2004h>                     return jobEvent.eventType == 4; // FINISH
[?2004l[?2004h>                 }
[?2004l[?2004h>             })
[?2004l[?2004h>             .assignTimestampsAndWatermarks(
[?2004l[?2004h>                 WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))
[?2004l[?2004h>                     .withTimestampAssigner((event, timestamp) -> event.timestamp)
