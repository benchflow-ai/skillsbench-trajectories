[?2004l[?2004h> 
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public void open(Configuration parameters) throws Exception {
[?2004l[?2004h>                     maxStageSize = getRuntimeContext().getState(new ValueStateDescriptor<>("maxStage", Integer.class));
[?2004l[?2004h>                     jobFinishTime = getRuntimeContext().getState(new ValueStateDescriptor<>("jobFinishTime", Long.class));
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public void processElement1(Tuple2<Long, Integer> stage, Context ctx, Collector<String> out) throws Exception {
[?2004l[?2004h>                     Integer currentMax = maxStageSize.value();
[?2004l[?2004h>                     if (currentMax == null || stage.f1 > currentMax) {
[?2004l[?2004h>                         maxStageSize.update(stage.f1);
[?2004l[?2004h>                     }
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public void processElement2(JobEvent job, Context ctx, Collector<String> out) throws Exception {
[?2004l[?2004h>                     jobFinishTime.update(job.timestamp);
[?2004l[?2004h>                     // Wait for 10 minutes past job finish to ensure all session windows have closed
[?2004l[?2004h>                     ctx.timerService().registerEventTimeTimer(job.timestamp + Time.minutes(10).toMilliseconds() + 1);
[?2004l[?2004h>                 }
[?2004l[?2004h> 
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public void onTimer(long timestamp, OnTimerContext ctx, Collector<String> out) throws Exception {
