[?2004l[?2004h>             })
[?2004l[?2004h>             .assignTimestampsAndWatermarks(
[?2004lme[?2004h>                 WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))
[?2004l[?2004h>                     .withTimestampAssigner((event, timestamp) -> event.timestamp)
