[?2004l[?2004h>                     long jobId = Long.parseLong(tokens[2]);
[?2004lime[?2004h>                     int eventType = Integer.parseInt(tokens[5]);
[?2004l[?2004h>                     return new TaskEvent(timestamp, jobId, eventType);
