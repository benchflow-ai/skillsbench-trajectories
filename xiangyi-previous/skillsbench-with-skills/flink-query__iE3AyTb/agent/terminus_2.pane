[?2004l[?2004h>             .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {
[?2004l[?2004h>                 @Override
[?2004l[?2004h>                 public void process(Long key, Context context, Iterable<TaskEvent> elements, Collector<Tuple2<Long, Integer>> out) throws Exception {
[?2004l[?2004h>                     int count = 0;
[?2004l[?2004h>                     for (TaskEvent e : elements) {
[?2004l[?2004h>                         count++;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     out.collect(Tuple2.of(key, count));
[?2004l[?2004h>                 }
[?2004l[?2004h>             });
[?2004l[?2004h> 
[?2004l[?2004h>         // Connect and find max stage per job upon completion
[?2004l[?2004h>         stageSizes.connect(jobEvents)
[?2004l[?2004h>             .keyBy(t -> t.f0, j -> j.jobId)
[?2004l[?2004h>             .process(new CoProcessFunction<Tuple2<Long, Integer>, JobEvent, String>() {
[?2004l[?2004h>                 
[?2004l[?2004h>                 private ValueState<Integer> maxStageSize;
