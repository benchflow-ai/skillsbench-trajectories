[?2004l[?2004h> 
[?2004l[?2004h>         // Calculate stage sizes
[?2004l[?2004h>         DataStream<Tuple2<Long, Integer>> stageSizes = taskEvents
[?2004l[?2004h>             .keyBy(t -> t.jobId)
