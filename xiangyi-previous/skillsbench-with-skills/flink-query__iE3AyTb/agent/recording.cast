[247.342966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.343027, "o", "        // Calculate stage sizes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.343088, "o", "        DataStream<Tuple2<Long, Integer>> stageSizes = taskEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.343146, "o", "            .keyBy(t -> t.jobId)\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.343191, "o", "> "]
[247.34327, "o", "            .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[247.343326, "o", "> "]
[247.343468, "o", "            .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
