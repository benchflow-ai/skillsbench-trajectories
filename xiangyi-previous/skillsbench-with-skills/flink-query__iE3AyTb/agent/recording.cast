[130.738152, "i", "cat > src/main/java/clusterdata/datatypes/TaskEvent.java <<EOF\npackage clusterdata.datatypes;\n\npublic class TaskEvent {\n    public long timestamp;\n    public long jobId;\n    public int eventType;\n\n    public TaskEvent() {}\n\n    public TaskEvent(long timestamp, long jobId, int eventType) {\n        this.timestamp = timestamp;\n        this.jobId = jobId;\n        this.eventType = eventType;\n    }\n\n    @Override\n    public String toString() {\n        return \"TaskEvent{timestamp=\" + timestamp + \", jobId=\" + jobId + \", eventType=\" + eventType + \"}\";\n    }\n}\nEOF\n"]
[130.73841, "o", "cat > src/main/java/clusterdata/datatypes/TaskEvent.java <<EOF\r\n\u001b[?2004l\r"]
