[247.342593, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h>             .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r\u001b[?2004h> "]
