[13.814457, "i", "python3 << 'EOF'\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom collections import defaultdict\n\n# GitHub API endpoint\nrepo = \"cli/cli\"\napi_base = \"https://api.github.com/repos\"\n\n# Date range\nstart_date = \"2024-12-01T00:00:00Z\"\nend_date = \"2024-12-31T23:59:59Z\"\n\ndef run_curl(url):\n    \"\"\"Run curl command and return JSON response\"\"\"\n    cmd = ['curl', '-s', url]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    try:\n        return json.loads(result.stdout)\n    except:\n        return None\n\n# Fetch PRs created in December 2024\nprint(\"Fetching PRs...\")\npr_url = f\"{api_base}/{repo}/pulls?state=all&created={start_date}..{end_date}&per_page=100\"\nall_prs = []\npage = 1\nwhile True:\n    page_url = f\"{pr_url}&page={page}\"\n    prs = run_curl(page_url)\n    if not prs or len(prs) == 0:\n        break\n    all_prs.extend(prs)\n    page += 1\n\nprint(f\"Found {len(all_prs)} PRs\")\n\n# Count merged and closed PRs\nmerged_prs = [pr for pr in all_prs if pr['merged_at'] is not None]\nclosed_prs = [pr for pr in all_prs if pr['state'] == 'closed' and pr['merged_at'] is None]\n\nprint(f\"Merged: {len(merged_prs)}, Closed: {len(closed_prs)}\")\n\n# Calculate average merge time\nmerge_times = []\nfor pr in merged_prs:\n    created = datetime.fromisoformat(pr['created_at'].replace('Z', '+00:00'))\n    merged = datetime.fromisoformat(pr['merged_at'].replace('Z', '+00:00'))\n    days = (merged - created).days + (merged - created).seconds / 86400\n    merge_times.append(days)\n\navg_merge_days = round(sum(merge_times) / len(merge_times), 1) if merge_times else 0.0\n\nprint(f\"Average merge time: {avg_merge_days} days\")\n\n# Find top contributor\ncontributor_count = defaultdict(int)\nfor pr in all_prs:\n    contributor = pr['user']['login']\n    contributor_count[contributor] += 1\n\ntop_contributor = max(contributor_count, key=contributor_count.get) if contributor_count else \"\"\nprint(f\"Top contributor: {top_contributor} ({contributor_count[top_contributor]} PRs)\")\n\n# Fetch issues created in December 2024\nprint(\"\\nFetching issues...\")\nissue_url = f\"{api_base}/{repo}/issues?state=all&created={start_date}..{end_date}&per_page=100\"\nall_issues = []\npage = 1\nwhile True:\n    page_url = f\"{issue_url}&page={page}\"\n    issues = run_curl(page_url)\n    if not issues or len(issues) == 0:\n        break\n    all_issues.extend(issues)\n    page += 1\n\nprint(f\"Found {len(all_issues)} issues\")\n\n# Count bug reports\nbug_issues = []\nfor issue in all_issues:\n    labels = issue.get('labels', [])\n    has_bug_label = any('bug' in label['name'].lower() for label in labels)\n    if has_bug_label:\n        bug_issues.append(issue)\n\nprint(f\"Bug reports: {len(bug_issues)}\")\n\n# Count resolved bugs\nresolved_bugs = [issue for issue in bug_issues if issue['state'] == 'closed' and issue['closed_at'] is not None]\n\nprint(f\"Resolved bugs: {len(resolved_bugs)}\")\n\n# Create report\nreport = {\n    \"pr\": {\n        \"total\": len(all_prs),\n        \"merged\": len(merged_prs),\n        \"closed\": len(closed_prs),\n        \"avg_merge_days\": avg_merge_days,\n        \"top_contributor\": top_contributor\n    },\n    \"issue\": {\n        \"total\": len(all_issues),\n        \"bug\": len(bug_issues),\n        \"resolved_bugs\": len(resolved_bugs)\n    }\n}\n\nprint(\"\\nReport:\")\nprint(json.dumps(report, indent=2))\n\n# Write to file\nwith open('/app/report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nReport saved to /app/report.json\")\nEOF\n"]
