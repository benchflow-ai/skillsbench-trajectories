[113.837254, "i", "python3 << 'EOF'\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom collections import defaultdict\nimport os\n\nrepo = \"cli/cli\"\napi_base = \"https://api.github.com\"\n\ntoken = os.environ.get('GITHUB_TOKEN', '')\nheaders = []\nif token:\n    headers = ['-H', f'Authorization: token {token}']\n\ndef run_curl(url):\n    \"\"\"Run curl command with timeout\"\"\"\n    cmd = ['curl', '-s', '--max-time', '10'] + headers + [url]\n    try:\n        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)\n        if result.stdout.strip():\n            return json.loads(result.stdout)\n    except Exception as e:\n        print(f\"Error: {e}\")\n    return None\n\nprint(\"Fetching PRs created in December 2024...\")\n# Search API query for PRs in December 2024\npr_search = f\"{api_base}/search/issues?q=repo:cli/cli+type:pr+created:2024-12-01..2024-12-31&sort=created&order=desc&per_page=100\"\nall_prs = []\npage = 1\nwhile page <= 10:\n    page_url = f\"{pr_search}&page={page}\"\n    print(f\"  Fetching PR page {page}...\")\n    response = run_curl(page_url)\n    if not response:\n        break\n    if 'message' in response:\n        print(f\"  API Error: {response['message']}\")\n        break\n    \n    items = response.get('items', [])\n    if not items:\n        break\n    \n    all_prs.extend(items)\n    print(f\"    Got {len(items)} items, total so far: {len(all_prs)}\")\n    \n    if len(items) < 100:\n        break\n    page += 1\n\nprint(f\"Found {len(all_prs)} PRs created in December 2024\")\n\nif len(all_prs) > 0:\n    # For each PR, fetch full details to get merged_at info\n    merged_prs = []\n    closed_prs = []\n    \n    for pr in all_prs:\n        pr_number = pr['number']\n        pr_url = f\"{api_base}/repos/cli/cli/pulls/{pr_number}\"\n        pr_detail = run_curl(pr_url)\n        if pr_detail:\n            if pr_detail.get('merged_at'):\n                merged_prs.append(pr_detail)\n            elif pr_detail.get('state') == 'closed':\n                closed_prs.append(pr_detail)\n    \n    print(f\"  Merged: {len(merged_prs)}, Closed: {len(closed_prs)}\")\n    \n    merge_times = []\n    for pr in merged_prs:\n        created = datetime.fromisoformat(pr['created_at'].replace('Z', '+00:00'))\n        merged = datetime.fromisoformat(pr['merged_at'].replace('Z', '+00:00'))\n        days = (merged - created).days + (merged - created).seconds / 86400\n        merge_times.append(days)\n    \n    avg_merge_days = round(sum(merge_times) / len(merge_times), 1) if merge_times else 0.0\n    print(f\"  Average merge time: {avg_merge_days} days\")\n    \n    contributor_count = defaultdict(int)\n    for pr in all_prs:\n        contributor = pr['user']['login']\n        contributor_count[contributor] += 1\n    \n    top_contributor = max(contributor_count, key=contributor_count.get) if contributor_count else \"\"\n    print(f\"  Top contributor: {top_contributor} ({contributor_count[top_contributor]} PRs)\")\nelse:\n    merged_prs = []\n    closed_prs = []\n    avg_merge_days = 0.0\n    top_contributor = \"\"\n\nprint(\"\\nFetching issues created in December 2024...\")\n# Search API query for issues (excluding PRs) in December 2024\nissue_search = f\"{api_base}/search/issues?q=repo:cli/cli+type:issue+created:2024-12-01..2024-12-31&sort=created&order=desc&per_page=100\"\nall_issues = []\npage = 1\nwhile page <= 10:\n    page_url = f\"{issue_search}&page={page}\"\n    print(f\"  Fetching issue page {page}...\")\n    response = run_curl(page_url)\n    if not response:\n        break\n    if 'message' in response:\n        print(f\"  API Error: {response['message']}\")\n        break\n    \n    items = response.get('items', [])\n    if not items:\n        break\n    \n    all_issues.extend(items)\n    print(f\"    Got {len(items)} items, total so far: {len(all_issues)}\")\n    \n    if len(items) < 100:\n        break\n    page += 1\n\nprint(f\"Found {len(all_issues)} issues created in December 2024\")\n\nbug_issues = []\nfor issue in all_issues:\n    labels = issue.get('labels', [])\n    has_bug_label = any('bug' in label['name'].lower() for label in labels)\n    if has_bug_label:\n        bug_issues.append(issue)\n\nprint(f\"  Bug reports: {len(bug_issues)}\")\n\nresolved"]
[113.837319, "i", "_bugs = [issue for issue in bug_issues if issue['state'] == 'closed']\nprint(f\"  Resolved bugs: {len(resolved_bugs)}\")\n\nreport = {\n    \"pr\": {\n        \"total\": len(all_prs),\n        \"merged\": len(merged_prs),\n        \"closed\": len(closed_prs),\n        \"avg_merge_days\": avg_merge_days,\n        \"top_contributor\": top_contributor\n    },\n    \"issue\": {\n        \"total\": len(all_issues),\n        \"bug\": len(bug_issues),\n        \"resolved_bugs\": len(resolved_bugs)\n    }\n}\n\nprint(\"\\nReport:\")\nprint(json.dumps(report, indent=2))\n\nwith open('/app/report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nReport saved to /app/report.json\")\nEOF\n"]
