import json
import subprocess
import sys
from pathlib import Path

try:
    from pyannote.audio import Pipeline
    import torch
except Exception as e:
    print(f"Error importing: {e}")
    sys.exit(1)

try:
    import whisper
except:
    whisper = None

def extract_audio(video_path, audio_path):
    """Extract audio from video"""
    print(f"[1/5] Extracting audio...")
    cmd = ['ffmpeg', '-i', video_path, '-acodec', 'pcm_s16le', '-ac', '1', '-ar', '16000', '-y', audio_path]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if not Path(audio_path).exists():
        print(f"Error: Audio extraction failed")
        return False
    print(f"  ✓ Audio extracted: {audio_path}")
    return True

def get_duration(audio_path):
    """Get audio duration"""
    cmd = ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', audio_path]
    result = subprocess.run(cmd, capture_output=True, text=True)
    try:
        return float(result.stdout.strip())
    except:
        return 0.0

def diarize(audio_path):
    """Perform speaker diarization"""
    print(f"[2/5] Performing speaker diarization...")
    try:
        pipeline = Pipeline.from_pretrained("pyannote/speaker-diarization-3.0", use_auth_token=None)
        diarization = pipeline(audio_path)
        print(f"  ✓ Diarization complete")
        return diarization
    except Exception as e:
        print(f"Error in diarization: {e}")
        return None

def transcribe(audio_path):
    """Transcribe audio with Whisper"""
    print(f"[3/5] Transcribing audio...")
    if not whisper:
        print(f"  ⚠ Whisper not available, using dummy transcription")
        return None
    try:
        model = whisper.load_model("tiny")
        result = model.transcribe(audio_path, language="en", fp16=False)
        print(f"  ✓ Transcription complete")
        return result
    except Exception as e:
        print(f"  ⚠ Transcription failed: {e}")
        return None

def generate_rttm(diarization, output_path):
    """Generate RTTM file"""
    print(f"[4/5] Generating RTTM file...")
    with open(output_path, 'w') as f:
        for turn, _, speaker in diarization.itertracks(yield_label=True):
            start = turn.start
            duration = turn.end - turn.start
            f.write(f"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\n")
    print(f"  ✓ RTTM file generated: {output_path}")

def generate_ass(diarization, transcription, output_path):
    """Generate ASS subtitle file"""
    print(f"[5/5] Generating ASS subtitle file...")
    
    ass_header = """[Script Info]
Title: Diarization Subtitles
ScriptType: v4.00+

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""
    
    with open(output_path, 'w') as f:
        f.write(ass_header)
        
        # Create speaker segments from diarization
        segments = []
        for turn, _, speaker in diarization.itertracks(yield_label=True):
            segments.append({
                'start': turn.start,
                'end': turn.end,
                'speaker': speaker
            })
        
        # If we have transcription, try to align it
        if transcription and 'segments' in transcription:
            for seg in transcription['segments']:
                seg_start = seg['start']
                seg_end = seg['end']
