[28.700797, "o", "            if overlap_end > overlap_start:\r\n\u001b[?2004l\r\u001b[?2004h>                 overlap = overlap_end - overlap_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.700962, "o", "                speaker_times[speaker] = speaker_times.get(speaker, 0) + overlap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701032, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701092, "o", "        if speaker_times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701294, "o", "            speaker = max(speaker_times, key=speaker_times.get)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701369, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701422, "o", "            speaker = \"spk00\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.701448, "o", "> "]
[28.701519, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701584, "o", "        segments_with_speakers.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.70161, "o", "> "]
[28.701698, "o", "            'start': seg_start,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.701778, "o", "            'end': seg_end,\r\n\u001b[?2004l\r"]
[28.701804, "o", "\u001b[?2004h> "]
[28.701879, "o", "            'speaker': speaker,\r\n\u001b[?2004l\r"]
[28.701924, "o", "\u001b[?2004h> "]
[28.702051, "o", "            'text': text\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.702112, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.702159, "o", "    return segments_with_speakers\r\n\u001b[?2004l\r"]
[28.702216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.702342, "o", "def generate_ass_subtitles(segments, output_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.702458, "o", "    \"\"\"Generate ASS subtitle format\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.7026, "o", "    print(f\"Generating ASS subtitle file...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.702625, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.702694, "o", "> "]
[28.702738, "o", "    ass_content = \"\"\"[Script Info]\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.702787, "o", "> "]
[28.70283, "o", "Title: Diarization Subtitles\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.702884, "o", "> "]
[28.702921, "o", "ScriptType: v4.00+\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.702966, "o", "> [V4+ Styles]\r\n\u001b[?2004l\r"]
[28.703009, "o", "\u001b[?2004h> "]
[28.703633, "o", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.703668, "o", "> "]
[28.70394, "o", "Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[28.704003, "o", "\u001b[?2004h> "]
[28.704051, "o", "[Events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.704234, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.704259, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[28.704332, "o", "\u001b[?2004h>     \r\n"]
[28.704372, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.704416, "o", "    for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.70453, "o", "        start_ms = int(seg['start'] * 1000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.704655, "o", "        end_ms = int(seg['end'] * 1000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.704719, "o", "> "]
[28.705045, "o", "        start_time = f\"{start_ms//3600000}:{(start_ms%3600000)//60000:02d}:{(start_ms%60000)//1000:02d}.{(start_ms%1000)//10:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.705073, "o", "> "]
[28.7054, "o", "        end_time = f\"{end_ms//3600000}:{(end_ms%3600000)//60000:02d}:{(end_ms%60000)//1000:02d}.{(end_ms%1000)//10:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.705472, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.705581, "o", "        speaker_label = seg['speaker'].upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.705718, "o", "        text = f\"{speaker_label}: {seg['text']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.705741, "o", ">         \r\n"]
[28.705809, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[28.706037, "o", "        ass_content += f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{text}\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.706093, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.706175, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.706221, "o", "> "]
[28.706267, "o", "        f.write(ass_content)\r\n\u001b[?2004l\r"]
[28.706291, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.706355, "o", "> "]
[28.706414, "o", "def calculate_speech_time(segments):\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.70646, "o", "> "]
[28.706537, "o", "    \"\"\"Calculate total speech time\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.706582, "o", ">     total = 0\r\n\u001b[?2004l\r"]
[28.706626, "o", "\u001b[?2004h> "]
[28.706682, "o", "    for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.706731, "o", "> "]
[28.706812, "o", "        total += seg['end'] - seg['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.706862, "o", ">     return total\r\n"]
[28.706906, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[28.707012, "o", "def count_speakers(diarization):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.70711, "o", "    \"\"\"Count number of speakers\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.70716, "o", "> "]
[28.707212, "o", "    speakers = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.707407, "o", "    for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.707498, "o", "        speakers.add(speaker)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.707547, "o", "> "]
[28.707571, "o", "    return len(speakers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.707641, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.70768, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.707765, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r"]
[28.70781, "o", "\u001b[?2004h> "]
[28.707872, "o", "    audio_path = \"/tmp/audio.wav\"\r\n\u001b[?2004l\r"]
[28.70792, "o", "\u001b[?2004h> "]
[28.707986, "o", "    rttm_path = \"/root/diarization.rttm\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708052, "o", "    ass_path = \"/root/subtitles.ass\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.708099, "o", "> "]
[28.708155, "o", "    report_path = \"/root/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.708193, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708267, "o", "    steps_completed = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708306, "o", "    tools_used = {}\r\n\u001b[?2004l\r\u001b[?2004h>     libraries_used = []\r\n\u001b[?2004l\r"]
[28.708378, "o", "\u001b[?2004h> "]
[28.708418, "o", "    commands_used = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[28.708482, "o", "\u001b[?2004h> "]
[28.708528, "o", "        # Step 1: Extract audio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708718, "o", "        print(\"\\n=== Step 1: Audio Extraction ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708819, "o", "        extract_audio(input_video, audio_path)\r\n\u001b[?2004l\r\u001b[?2004h>         steps_completed.append(\"audio_extraction\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.708936, "o", "        tools_used[\"audio_extraction\"] = \"ffmpeg\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.709007, "o", "        commands_used.append(\"ffmpeg\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.709077, "o", "        audio_duration = get_audio_duration(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.709194, "o", "        print(f\"Audio duration: {audio_duration:.2f} seconds\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.709251, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.7093, "o", "        # Step 2: Diarization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.709373, "o", "        print(\"\\n=== Step 2: Speaker Diarization ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.709422, "o", "> "]
[28.709468, "o", "        diarization = perform_diarization(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.709517, "o", ">         if diarization:\r\n\u001b[?2004l\r"]
[28.709564, "o", "\u001b[?2004h> "]
[28.709617, "o", "            steps_completed.append(\"diarization\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.709822, "o", ">             tools_used[\"diarization\"] = \"pyannote.audio\"\r\n\u001b[?2004l\r\u001b[?2004h>             libraries_used.append(\"pyannote.audio\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.70989, "o", "            commands_used.append(\"python3\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.70994, "o", "> "]
[28.709992, "o", "            num_speakers = count_speakers(diarization)\r\n\u001b[?2004l\r"]
[28.710046, "o", "\u001b[?2004h> "]
[28.710108, "o", "            print(f\"Number of speakers detected: {num_speakers}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710157, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.710227, "o", "            print(\"Diarization failed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710271, "o", "> "]
[28.710321, "o", "            diarization = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710362, "o", "> "]
[28.710411, "o", "        # Step 3: Transcription\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.710487, "o", "        print(\"\\n=== Step 3: Speech Transcription ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710536, "o", "> "]
[28.710582, "o", "        transcription = transcribe_audio(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710631, "o", ">         if transcription:\r\n\u001b[?2004l\r"]
[28.710682, "o", "\u001b[?2004h> "]
[28.710733, "o", "            steps_completed.append(\"transcription\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.71078, "o", "> "]
[28.710837, "o", "            tools_used[\"transcription\"] = \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710885, "o", "> "]
[28.71093, "o", "            libraries_used.append(\"openai-whisper\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.710978, "o", "> "]
[28.711099, "o", "            print(f\"Transcription completed with {len(transcription['segments'])} segments\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.711147, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.711209, "o", "            print(\"Transcription failed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.711257, "o", "> "]
[28.711307, "o", "            transcription = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[28.711437, "o", "> "]
[28.7115, "o", "        # Step 4: Align and generate outputs\r\n\u001b[?2004l\r\u001b[?2004h>         if diarization and transcription:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.711592, "o", "            print(\"\\n=== Step 4: Alignment and Output Generation ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.711646, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.7117, "o", "            # Generate RTTM\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.711744, "o", "> "]
[28.711796, "o", "            generate_rttm(diarization, rttm_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.71187, "o", "            steps_completed.append(\"rttm_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.711926, "o", "> "]
[28.711966, "o", "            print(f\"RTTM file generated: {rttm_path}\")\r\n\u001b[?2004l\r"]
[28.712019, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[28.712072, "o", "\u001b[?2004h> "]
[28.712126, "o", "            # Align transcripts with speakers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712274, "o", "            segments_with_speakers = align_transcripts_with_diarization(diarization, transcription)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712323, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712376, "o", "            # Generate ASS subtitles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712558, "o", "            generate_ass_subtitles(segments_with_speakers, ass_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712634, "o", "            steps_completed.append(\"subtitle_generation\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712717, "o", "            print(f\"ASS subtitle file generated: {ass_path}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712771, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712819, "o", "            # Calculate metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.712948, "o", "            total_speech_time = calculate_speech_time(segments_with_speakers)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713162, "o", "            num_speakers = count_speakers(diarization)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Generate report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713245, "o", "            print(\"\\n=== Step 5: Report Generation ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.713299, "o", "> "]
[28.713353, "o", "            report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713408, "o", "                \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713533, "o", "                \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713643, "o", "                \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.713718, "o", "                \"steps_completed\": steps_completed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.713773, "o", "> "]
[28.713823, "o", "                \"commands_used\": list(set(commands_used)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.713878, "o", "> "]
[28.713963, "o", "                \"libraries_used\": list(set(libraries_used)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.714012, "o", "                \"tools_used\": tools_used,\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.714062, "o", "> "]
[28.714288, "o", "                \"notes\": f\"Successfully processed {input_video} with {num_speakers} speakers. Generated RTTM, ASS subtitles, and detailed report.\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[28.714342, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.714411, "o", "            with open(report_path, 'w') as f:\r\n\u001b[?2004l\r"]
[28.71446, "o", "\u001b[?2004h> "]
[28.71452, "o", "                json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.714572, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.714637, "o", "            steps_completed.append(\"report_generation\")\r\n\u001b[?2004l\r"]
[28.714781, "o", "\u001b[?2004h> "]
[28.714835, "o", "            print(f\"Report generated: {report_path}\")\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"\\nSummary:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.714905, "o", "            print(f\"  Speakers detected: {num_speakers}\")\r\n\u001b[?2004l\r"]
[28.71496, "o", "\u001b[?2004h> "]
[28.715095, "o", "            print(f\"  Total speech time: {total_speech_time:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.715209, "o", "            print(f\"  Audio duration: {audio_duration:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.715273, "o", "            print(f\"  Steps completed: {', '.join(steps_completed)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.71533, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.715449, "o", "            print(\"Cannot proceed without diarization and transcription\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[28.715489, "o", "\u001b[?2004h> "]
[28.715521, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.715605, "o", "        print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.715661, "o", "        import traceback\r\n\u001b[?2004l\r\u001b[?2004h> "]
