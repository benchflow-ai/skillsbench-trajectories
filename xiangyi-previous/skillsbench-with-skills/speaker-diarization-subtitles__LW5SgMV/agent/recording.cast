[720.153455, "o", "            for seg in transcription['segments']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.153479, "o", "> "]
[720.153638, "o", "                seg_start = seg['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.153664, "o", "> "]
[720.153723, "o", "                seg_end = seg['end']\r\n\u001b[?2004l\r"]
[720.153743, "o", "\u001b[?2004h> "]
[720.153834, "o", "                text = seg['text'].strip()\r\n\u001b[?2004l\r"]
[720.153858, "o", "\u001b[?2004h> "]
[720.153928, "o", "                speaker = 'spk00'\r\n\u001b[?2004l\r"]
[720.153958, "o", "\u001b[?2004h> "]
[720.154317, "o", "                max_overlap = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 for spk_seg in speakers:\r\n\u001b[?2004l\r\u001b[?2004h>                     overlap_start = max(spk_seg['start'], seg_start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.154376, "o", "                    overlap_end = min(spk_seg['end'], seg_end)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.154443, "o", "                    if overlap_end > overlap_start:\r\n\u001b[?2004l\r"]
[720.154477, "o", "\u001b[?2004h> "]
[720.154573, "o", "                        overlap = overlap_end - overlap_start\r\n\u001b[?2004l\r"]
[720.154604, "o", "\u001b[?2004h> "]
[720.154684, "o", "                        if overlap > max_overlap:\r\n\u001b[?2004l\r"]
[720.154712, "o", "\u001b[?2004h> "]
[720.154797, "o", "                            max_overlap = overlap\r\n\u001b[?2004l\r"]
[720.154821, "o", "\u001b[?2004h> "]
[720.15492, "o", "                            speaker = spk_seg['speaker']\r\n\u001b[?2004l\r"]
[720.154947, "o", "\u001b[?2004h> "]
[720.155113, "o", "                h1, m1, s1 = int(seg_start // 3600), int((seg_start % 3600) // 60), int(seg_start % 60)\r\n\u001b[?2004l\r"]
[720.155136, "o", "\u001b[?2004h> "]
[720.155225, "o", "                cs1 = int((seg_start % 1) * 100)\r\n\u001b[?2004l\r"]
[720.155248, "o", "\u001b[?2004h> "]
[720.155401, "o", "                h2, m2, s2 = int(seg_end // 3600), int((seg_end % 3600) // 60), int(seg_end % 60)\r\n\u001b[?2004l\r"]
[720.155422, "o", "\u001b[?2004h> "]
[720.155513, "o", "                cs2 = int((seg_end % 1) * 100)\r\n\u001b[?2004l\r"]
[720.155535, "o", "\u001b[?2004h> "]
[720.15563, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r"]
[720.155654, "o", "\u001b[?2004h> "]
[720.155748, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.155771, "o", "> "]
[720.155825, "o", "                label = speaker.upper()\r\n\u001b[?2004l\r"]
[720.155846, "o", "\u001b[?2004h> "]
[720.155996, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.15602, "o", "> "]
[720.156043, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.156069, "o", "> "]
[720.156141, "o", "            for seg in speakers:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.156301, "o", "                h1, m1, s1 = int(seg['start'] // 3600), int((seg['start'] % 3600) // 60), int(seg['start'] % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.156323, "o", "> "]
[720.156399, "o", "                cs1 = int((seg['start'] % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.15642, "o", "> "]
[720.156572, "o", "                h2, m2, s2 = int(seg['end'] // 3600), int((seg['end'] % 3600) // 60), int(seg['end'] % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.156594, "o", "> "]
[720.15671, "o", "                cs2 = int((seg['end'] % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.156737, "o", "> "]
[720.156803, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r"]
[720.156824, "o", "\u001b[?2004h> "]
[720.156926, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.156953, "o", "> "]
[720.15702, "o", "                label = seg['speaker'].upper()\r\n\u001b[?2004l\r"]
[720.15704, "o", "\u001b[?2004h> "]
[720.157193, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: [speech]\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.157244, "o", "    print(f\"  ASS file generated\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157264, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.157313, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.157381, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157402, "o", "> "]
[720.157453, "o", "    audio_path = \"/tmp/audio.wav\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157474, "o", "> "]
[720.157533, "o", "    rttm_path = \"/root/diarization.rttm\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157555, "o", "> "]
[720.157607, "o", "    ass_path = \"/root/subtitles.ass\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157628, "o", "> "]
[720.157681, "o", "    report_path = \"/root/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157702, "o", "> "]
[720.157753, "o", "    print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.157835, "o", "    print(\"SPEAKER DIARIZATION PIPELINE\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157858, "o", "> "]
[720.157908, "o", "    print(\"=\"*60 + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.157956, "o", "    steps = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.157975, "o", ">     tools = {}\r\n\u001b[?2004l\r"]
[720.157996, "o", "\u001b[?2004h> "]
[720.158167, "o", "    libraries = []\r\n\u001b[?2004l\r\u001b[?2004h>     if not extract_audio(input_video, audio_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.158191, "o", "        sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.158264, "o", "    steps.append(\"audio_extraction\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.158287, "o", "> "]
[720.15834, "o", "    tools[\"audio_extraction\"] = \"ffmpeg\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.15836, "o", "> "]
[720.158385, "o", "    print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.158518, "o", "    speakers, num_speakers, audio_duration = simple_diarization(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.158567, "o", "    if not speakers:\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.15859, "o", "> "]
[720.158646, "o", "        print(\"ERROR: Diarization failed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.158666, "o", "> "]
[720.158715, "o", "        sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.158771, "o", "    steps.append(\"diarization\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.158791, "o", "> "]
[720.158895, "o", "    tools[\"diarization\"] = \"librosa (energy-based segmentation)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.15896, "o", "    libraries.append(\"librosa\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.158981, "o", "> "]
[720.159027, "o", "    libraries.append(\"numpy\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159047, "o", ">     print()"]
[720.159067, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.159173, "o", "    transcription = transcribe_with_whisper(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.159222, "o", "    if transcription:\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159244, "o", "> "]
[720.159298, "o", "        steps.append(\"transcription\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159319, "o", "> "]
[720.159388, "o", "        tools[\"transcription\"] = \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159408, "o", "> "]
[720.159474, "o", "        libraries.append(\"openai-whisper\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159495, "o", ">     print()"]
[720.159513, "o", "\r\n\u001b[?2004l\r"]
[720.159537, "o", "\u001b[?2004h> "]
