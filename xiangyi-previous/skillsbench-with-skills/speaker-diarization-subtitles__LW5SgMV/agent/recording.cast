[704.695411, "o", "def get_duration(audio_path):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         y, sr = librosa.load(audio_path, sr=None)\r\n\u001b[?2004l\r\u001b[?2004h>         return len(y) / sr\r\n\u001b[?2004l\r\u001b[?2004h>     except:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def simple_diarization(audio_path):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"[2/5] Performing speaker diarization...\")\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         y, sr = librosa.load(audio_path, sr=16000, mono=True)\r\n\u001b[?2004l\r\u001b[?2004h>         duration = len(y) / sr\r\n\u001b[?2004l\r\u001b[?2004h>         frame_length = int(0.025 * sr)\r\n\u001b[?2004l\r\u001b[?2004h>         hop_length = int(0.010 * sr)\r\n\u001b[?2004l\r\u001b[?2004h>         S = librosa.feature.melspectrogram(y=y, sr=sr, n_fft=frame_length, hop_length=hop_length)\r\n\u001b[?2004l\r\u001b[?2004h>         energy = np.sqrt(np.mean(S**2, axis=0))\r\n\u001b[?2004l\r\u001b[?2004h>         energy = (energy - np.min(energy)) / (np.max(energy) - np.min(energy) + 1e-8)\r\n\u001b[?2004l\r\u001b[?2004h>         threshold = 0.15\r\n\u001b[?2004l\r\u001b[?2004h>         speech_frames = energy > threshold\r\n\u001b[?2004l\r\u001b[?2004h>         times = librosa.frames_to_time(np.arange(len(speech_frames)), sr=sr, hop_length=hop_length)\r\n\u001b[?2004l\r\u001b[?2004h>         segments = []\r\n\u001b[?2004l\r\u001b[?2004h>         in_speech = False\r\n\u001b[?2004l\r\u001b[?2004h>         start_time = 0\r\n\u001b[?2004l\r\u001b[?2004h>         for i, is_speech in enumerate(speech_frames):\r\n\u001b[?2004l\r\u001b[?2004h>             if is_speech and not in_speech:\r\n\u001b[?2004l\r\u001b[?2004h>                 start_time = times[i]\r\n\u001b[?2004l\r\u001b[?2004h>                 in_speech = True\r\n\u001b[?2004l\r\u001b[?2004h>             elif not is_speech and in_speech:\r\n\u001b[?2004l\r\u001b[?2004h>                 end_time = times[i]\r\n\u001b[?2004l\r\u001b[?2004h>                 segments.append((start_time, end_time))\r\n\u001b[?2004l\r\u001b[?2004h>                 in_speech = False\r\n\u001b[?2004l\r\u001b[?2004h>         if in_speech:\r\n\u001b[?2004l\r\u001b[?2004h>             segments.append((start_time, duration))\r\n\u001b[?2004l\r\u001b[?2004h>         if not segments:\r\n\u001b[?2004l\r\u001b[?2004h>             segments = [(0, duration)]\r\n\u001b[?2004l\r\u001b[?2004h>         num_speakers = min(2, max(1, len(segments) // 5))\r\n\u001b[?2004l\r\u001b[?2004h>         speakers = []\r\n\u001b[?2004l\r\u001b[?2004h>         for idx, (start, end) in enumerate(segments):\r\n\u001b[?2004l\r\u001b[?2004h>             speaker_id = idx % num_speakers\r\n\u001b[?2004l\r\u001b[?2004h>             speakers.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 'start': start,\r\n\u001b[?2004l\r\u001b[?2004h>                 'end': end,\r\n\u001b[?2004l\r\u001b[?2004h>                 'speaker': f'spk{speaker_id:02d}'\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Diarization complete: {num_speakers} speakers, {len(speakers)} segments\")\r\n\u001b[?2004l\r\u001b[?2004h>         return speakers, num_speakers, duration\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>         return None, 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
