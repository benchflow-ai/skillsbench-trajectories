[526.76691, "o", "\u001b[?2004h> "]
[526.766985, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.767026, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.767085, "o", "        model = whisper.load_model(\"tiny\")\r\n\u001b[?2004l\rbe\u001b[?2004h"]
[526.767133, "o", "> "]
[526.767254, "o", "        result = model.transcribe(audio_path, language=\"en\", fp16=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.767358, "o", "        print(f\"  ✓ Transcription complete\")\r\n\u001b[?2004l\rec\u001b[?2004h"]
[526.767384, "o", "> "]
[526.76741, "o", "        return result\r\n\u001b[?2004l\r"]
[526.767441, "o", "\u001b[?2004h> "]
[526.767533, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.767632, "o", "        print(f\"  ⚠ Transcription failed: {e}\")\r\n\u001b[?2004l\r"]
[526.767687, "o", "\u001b[?2004h> "]
[526.767738, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[526.767828, "o", "def generate_rttm(diarization, output_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.767854, "o", "> "]
[526.767933, "o", "    \"\"\"Generate RTTM file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.767959, "o", "> "]
[526.768072, "o", "    print(f\"[4/5] Generating RTTM file...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.768155, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.768211, "o", "> "]
[526.768341, "o", "        for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.768395, "o", "> "]
[526.76844, "o", "            start = turn.start\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.768486, "o", "> "]
[526.768581, "o", "            duration = turn.end - turn.start\r\n\u001b[?2004l\r"]
[526.768625, "o", "\u001b[?2004h> "]
[526.768889, "o", "            f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.76891, "o", "> "]
[526.769047, "o", "    print(f\"  ✓ RTTM file generated: {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.769071, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[526.769234, "o", "def generate_ass(diarization, transcription, output_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.769256, "o", "> "]
[526.769344, "o", "    \"\"\"Generate ASS subtitle file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.769395, "o", "> "]
[526.769496, "o", "    print(f\"[5/5] Generating ASS subtitle file...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.769516, "o", ">     \r\n\u001b[?2004l\r"]
[526.769609, "o", "\u001b[?2004h> "]
[526.769647, "o", "    ass_header = \"\"\"[Script Info]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.769717, "o", "Title: Diarization Subtitles\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.76974, "o", "> "]
[526.769801, "o", "ScriptType: v4.00+\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[526.769854, "o", "\u001b[?2004h> "]
[526.769915, "o", "[V4+ Styles]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770331, "o", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770564, "o", "Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77061, "o", "> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[526.770649, "o", "[Events]\r\n\u001b[?2004l\rn:.\u001b[?2004h> "]
[526.770797, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770819, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.770896, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770959, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771036, "o", "        f.write(ass_header)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77106, "o", "> "]
[526.771107, "o", "        \r\n\u001b[?2004l\r f\u001b[?2004h> "]
[526.771195, "o", "        # Create speaker segments from diarization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771255, "o", "        segments = []\r\n\u001b[?2004l\ro\u001b[?2004h"]
[526.771307, "o", "> "]
[526.771444, "o", "        for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771495, "o", "> "]
[526.771532, "o", "            segments.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771557, "o", "> "]
[526.771639, "o", "                'start': turn.start,\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771663, "o", "> "]
[526.771736, "o", "                'end': turn.end,\r\n\u001b[?2004l\r"]
[526.771787, "o", "\u001b[?2004h> "]
[526.771841, "o", "                'speaker': speaker\r\n\u001b[?2004l\r"]
[526.771868, "o", "\u001b[?2004h> "]
[526.771933, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771979, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.772085, "o", "        # If we have transcription, try to align it\r\n\u001b[?2004l\r"]
[526.772134, "o", "\u001b[?2004h> "]
[526.772237, "o", "        if transcription and 'segments' in transcription:\r\n\u001b[?2004l\r"]
[526.772262, "o", "\u001b[?2004h> "]
[526.772392, "o", "            for seg in transcription['segments']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.772439, "o", "> "]
[526.772513, "o", "                seg_start = seg['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.772569, "o", "> "]
[526.772619, "o", "                seg_end = seg['end']\r\n\u001b[?2004l\r"]
[526.772673, "o", "\u001b[?2004h> "]
[526.772765, "o", "                text = seg['text'].strip()\r\n\u001b[?2004l\r"]
[526.772792, "o", "\u001b[?2004h> "]
[526.772842, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.773004, "o", "                # Find dominant speaker for this segment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.773112, "o", "                speaker_times = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.773165, "o", "> "]
[526.773335, "o", "                for turn, _, spk in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r"]
[526.773359, "o", "\u001b[?2004h> "]
[526.773509, "o", "                    overlap_start = max(turn.start, seg_start)\r\n\u001b[?2004l\r"]
[526.773555, "o", "\u001b[?2004h> "]
[526.77368, "o", "                    overlap_end = min(turn.end, seg_end)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.773705, "o", "> "]
[526.773826, "o", "                    if overlap_end > overlap_start:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77388, "o", "> "]
[526.773982, "o", "                        overlap = overlap_end - overlap_start\r\n\u001b[?2004l\r"]
[526.774028, "o", "\u001b[?2004h> "]
[526.77421, "o", "                        speaker_times[spk] = speaker_times.get(spk, 0) + overlap\r\n\u001b[?2004l\r"]
[526.774233, "o", "\u001b[?2004h> "]
[526.774292, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.774558, "o", "                speaker = max(speaker_times, key=speaker_times.get) if speaker_times else \"spk00\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.774585, "o", "> "]
[526.774608, "o", "                \r\n\u001b[?2004l\r"]
[526.774637, "o", "\u001b[?2004h> "]
[526.774732, "o", "                # Format times for ASS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.774858, "o", "                h1 = int(seg_start // 3600)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.774881, "o", "> "]
[526.774999, "o", "                m1 = int((seg_start % 3600) // 60)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[526.775102, "o", "                s1 = int(seg_start % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.775128, "o", "> "]
[526.775238, "o", "                cs1 = int((seg_start % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.775285, "o", "> "]
[526.775312, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.775436, "o", "                h2 = int(seg_end // 3600)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.775572, "o", "                m2 = int((seg_end % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.775597, "o", "> "]
[526.775674, "o", "                s2 = int(seg_end % 60)\r\n\u001b[?2004l\r'\u001b[?2004h"]
[526.775719, "o", "> "]
[526.7758, "o", "                cs2 = int((seg_end % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.775826, "o", "> "]
[526.775888, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[526.775942, "o", "> "]
[526.776056, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.776082, "o", "> "]
[526.776228, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r \u001b[?2004h"]
[526.77628, "o", "> "]
[526.776334, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.776396, "o", "                label = speaker.upper()\r\n\u001b[?2004l\r"]
[526.77642, "o", "\u001b[?2004h> "]
[526.776682, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.776749, "o", "> "]
[526.776843, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77687, "o", "> "]
[526.777005, "o", "            # No transcription, just use speaker segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.777091, "o", "            for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.777143, "o", "> "]
[526.777222, "o", "                h1 = int(seg['start'] // 3600)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.777265, "o", "> "]
[526.777371, "o", "                m1 = int((seg['start'] % 3600) // 60)\r\n\u001b[?2004l\r"]
[526.777395, "o", "\u001b[?2004h> "]
[526.777516, "o", "                s1 = int(seg['start'] % 60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.777657, "o", "                cs1 = int((seg['start'] % 1) * 100)\r\n\u001b[?2004l\r"]
[526.777699, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[526.777742, "o", "\u001b[?2004h> "]
[526.777824, "o", "                h2 = int(seg['end'] // 3600)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.777866, "o", "> "]
[526.777961, "o", "                m2 = int((seg['end'] % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.778009, "o", "> "]
[526.778057, "o", "                s2 = int(seg['end'] % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.778107, "o", "> "]
[526.778159, "o", "                cs2 = int((seg['end'] % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.778206, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.778297, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.77841, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.778452, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[526.778496, "o", "> "]
[526.778533, "o", "                label = seg['speaker'].upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.778578, "o", "> "]
[526.778696, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: [speech]\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77872, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[526.778781, "o", "> "]
[526.778827, "o", "    print(f\"  ✓ ASS file generated: {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[526.778877, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[526.778924, "o", "def count_speakers(diarization):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.778981, "o", "    \"\"\"Count number of speakers\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77901, "o", "> "]
[526.779036, "o", "    speakers = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779146, "o", "    for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.779191, "o", "> "]
[526.779219, "o", "        speakers.add(speaker)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779284, "o", "    return len(speakers)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779352, "o", "def calculate_speech_time(diarization):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.779404, "o", "> "]
[526.779435, "o", "    \"\"\"Calculate total speech time\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779508, "o", "    total = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779571, "o", "    for turn, _, _ in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.77962, "o", "> "]
[526.779673, "o", "        total += turn.end - turn.start\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.779719, "o", ">     return total\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779775, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779825, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.779865, "o", "> "]
[526.779923, "o", "    audio_path = \"/tmp/audio.wav\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.779968, "o", "    rttm_path = \"/root/diarization.rttm\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780033, "o", "    ass_path = \"/root/subtitles.ass\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.780077, "o", "> "]
[526.780125, "o", "    report_path = \"/root/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780175, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780225, "o", "    print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780274, "o", "    print(\"SPEAKER DIARIZATION PIPELINE\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.780319, "o", ">     print(\"=\"*60 + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.780371, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[526.780415, "o", ">     steps = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780466, "o", "    tools = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780508, "o", "    libraries = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.780562, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.780614, "o", ">         # Step 1: Extract audio\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.801081, "o", "> "]
[526.801182, "o", "        if not extract_audio(input_video, audio_path):\r\n\u001b[?2004l\r\u001b[?2004h>             sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         steps.append(\"audio_extraction\")\r\n\u001b[?2004l\r\u001b[?2004h>         tools[\"audio_extraction\"] = \"ffmpeg\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Get duration\r\n\u001b[?2004l\r\u001b[?2004h>         audio_duration = get_duration(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Duration: {audio_duration:.2f} seconds\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Step 2: Diarization\r\n\u001b[?2004l\r\u001b[?2004h>         diarization = diarize(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h>         if not diarization:\r\n\u001b[?2004l\r\u001b[?2004h>             print(\"ERROR: Diarization failed\")\r\n\u001b[?2004l\r\u001b[?2004h>             sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         steps.append(\"diarization\")\r\n\u001b[?2004l\r\u001b[?2004h>         tools[\"diarization\"] = \"pyannote.audio\"\r\n\u001b[?2004l\r\u001b[?2004h>         libraries.append(\"pyannote.audio\")\r\n\u001b[?2004l\r\u001b[?2004h>         libraries.append(\"torch\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         num_speakers = count_speakers(diarization)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Speakers detected: {num_speakers}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Step 3: Transcription\r\n\u001b[?2004l\r\u001b[?2004h>         transcription = transcribe(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h>         if transcription:\r\n\u001b[?2004l\r\u001b[?2004h>             steps.append(\"transcription\")\r\n\u001b[?2004l\r\u001b[?2004h>             tools[\"transcription\"] = \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h>             libraries.append(\"openai-whisper\")\r\n\u001b[?2004l\r\u001b[?2004h>         print()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Step 4 & 5: Generate outputs\r\n\u001b[?2004l\r\u001b[?2004h>         generate_rttm(diarization, rttm_path)\r\n\u001b[?2004l\r\u001b[?2004h>         generate_ass(diarization, transcription, ass_path)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         steps.append(\"rttm_generation\")\r\n\u001b[?2004l\r\u001b[?2004h>         steps.append(\"subtitle_generation\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Calculate metrics\r\n\u001b[?2004l\r\u001b[?2004h>         total_speech_time = calculate_speech_time(diarization)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Generate report\r\n\u001b[?2004l\r\u001b[?2004h>         report = {\r\n\u001b[?2004l\r\u001b[?2004h>             \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h>             \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h>             \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h>             \"steps_completed\": steps,\r\n\u001b[?2004l\r\u001b[?2004h>             \"commands_used\": [\"ffmpeg\", \"ffprobe\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"libraries_used\": list(set(libraries)),\r\n\u001b[?2004l\r\u001b[?2004h>             \"tools_used\": tools,\r\n\u001b[?2004l\r\u001b[?2004h>             \"notes\": f\"Successfully processed {input_video} with {num_speakers} speakers. Generated RTTM diarization output, ASS subtitle file with speaker labels, and comprehensive report.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         with open(report_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>             json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         steps.append(\"report_generation\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"SUMMARY\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Speakers detected: {num_speakers}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Total speech time: {total_speech_time:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Audio duration: {audio_duration:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\nOutput files:\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  - {rttm_path}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  - {ass_path}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  - {report_path}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"\\n\" + \"=\"*60 + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\nERROR: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[526.801208, "o", "import traceback\r\n\u001b[?2004l\r\u001b[?2004h>         traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> ENDSCRIPT\r\n\u001b[?2004l\r\u001b[?2004hroot@574ba8a89a99:~# python3 /root/diarize.py\r\n\u001b[?2004l\r"]
[531.400717, "o", "\r\n============================================================\r\nSPEAKER DIARIZATION PIPELINE\r\n============================================================\r\n\r\n[1/5] Extracting audio...\r\n"]
[531.634886, "o", "  ✓ Audio extracted: /tmp/audio.wav\r\n"]
[531.69199, "o", "  Duration: 69.06 seconds\r\n\r\n[2/5] Performing speaker diarization...\r\nError in diarization: Pipeline.from_pretrained() got an unexpected keyword argument 'use_auth_token'\r\nERROR: Diarization failed\r\n"]
