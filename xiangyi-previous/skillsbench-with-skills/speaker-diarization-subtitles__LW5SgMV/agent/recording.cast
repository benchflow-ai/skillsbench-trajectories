[601.73598, "o", ">     try:\r\n\u001b[?2004l\r"]
[601.736008, "o", "\u001b[?2004h> "]
[601.736142, "o", "        pipeline = Pipeline.from_pretrained(\"pyannote/speaker-diarization-3.0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.736235, "o", "        diarization = pipeline(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.736331, "o", "        print(f\"  ✓ Diarization complete\")\r\n\u001b[?2004l\r"]
[601.736349, "o", "\u001b[?2004h> "]
[601.736435, "o", "        return diarization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.73653, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.736685, "o", "        print(f\"Error in diarization: {e}\")\r\n\u001b[?2004l\r"]
[601.736752, "o", "\u001b[?2004h> "]
[601.736797, "o", "        import traceback\r\n\u001b[?2004l\r"]
[601.736847, "o", "\u001b[?2004h> "]
[601.736924, "o", "        traceback.print_exc()\r\n\u001b[?2004l\r"]
[601.736998, "o", "\u001b[?2004h> "]
[601.737067, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r)"]
[601.737132, "o", "\u001b[?2004h> "]
[601.737183, "o", "def transcribe(audio_path):\r\n\u001b[?2004l\r"]
[601.737278, "o", "\u001b[?2004h> "]
[601.737352, "o", "    \"\"\"Transcribe audio with Whisper\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.737481, "o", "    print(f\"[3/5] Transcribing audio...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.737555, "o", ">     if not whisper:\r\n\u001b[?2004l\r"]
[601.737611, "o", "\u001b[?2004h> "]
[601.737806, "o", "        print(f\"  ⚠ Whisper not available, using dummy transcription\")\r\n\u001b[?2004l\r"]
[601.737851, "o", "\u001b[?2004h> "]
[601.737895, "o", "        return None\r\n\u001b[?2004l\r"]
[601.737952, "o", "\u001b[?2004h> "]
[601.738005, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.738108, "o", "        model = whisper.load_model(\"tiny\")\r\n\u001b[?2004l\r"]
[601.738163, "o", "\u001b[?2004h> "]
[601.738378, "o", "        result = model.transcribe(audio_path, language=\"en\", fp16=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.738526, "o", "        print(f\"  ✓ Transcription complete\")\r\n\u001b[?2004l\r"]
[601.738572, "o", "\u001b[?2004h> "]
[601.738632, "o", "        return result\r\n\u001b[?2004l\r"]
[601.738688, "o", "\u001b[?2004h> "]
[601.738735, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[601.738785, "o", "\u001b[?2004h> "]
[601.738926, "o", "        print(f\"  ⚠ Transcription failed: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.739029, "o", ">         return None\r\n\u001b[?2004l\r"]
[601.739128, "o", "\u001b[?2004h> "]
[601.739183, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.739312, "o", "def generate_rttm(diarization, output_path):\r\n\u001b[?2004l\r"]
[601.739343, "o", "\u001b[?2004h> "]
[601.739458, "o", "    \"\"\"Generate RTTM file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.739573, "o", "    print(f\"[4/5] Generating RTTM file...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.739652, "o", "> "]
[601.739713, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r"]
[601.739796, "o", "\u001b[?2004h> "]
[601.73994, "o", "        for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r"]
[601.740032, "o", "\u001b[?2004h> "]
[601.740127, "o", "            start = turn.start\r\n\u001b[?2004l\r"]
[601.740151, "o", "\u001b[?2004h> "]
[601.740246, "o", "            duration = turn.end - turn.start\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.740327, "o", "> "]
[601.740549, "o", "            f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\r\n\u001b[?2004l\r"]
[601.740578, "o", "\u001b[?2004h> "]
[601.740787, "o", "    print(f\"  ✓ RTTM file generated: {output_path}\")\r\n\u001b[?2004l\r"]
[601.74081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[601.740828, "o", "\u001b[?2004h> "]
[601.741002, "o", "def generate_ass(diarization, transcription, output_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.741033, "o", "> "]
[601.741135, "o", "    \"\"\"Generate ASS subtitle file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.741159, "o", "> "]
[601.741282, "o", "    print(f\"[5/5] Generating ASS subtitle file...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.741302, "o", ">     \r\n\u001b[?2004l\r"]
[601.741321, "o", "\u001b[?2004h> "]
[601.741496, "o", "    ass_header = \"\"\"[Script Info]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.741519, "o", "Title: Diarization Subtitles\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.74154, "o", "> "]
[601.741607, "o", "ScriptType: v4.00+\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[601.741629, "o", "\u001b[?2004h> "]
[601.741678, "o", "[V4+ Styles]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.742337, "o", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.742627, "o", "Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[601.74265, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[601.742668, "o", "[Events]\r\n\u001b[?2004l\r"]
[601.742686, "o", "\u001b[?2004h> "]
[601.742913, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.742936, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.742958, "o", ">     \r\n\u001b[?2004l\r"]
[601.742975, "o", "\u001b[?2004h> "]
[601.743093, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.743186, "o", "        f.write(ass_header)\r\n\u001b[?2004l\r"]
[601.743206, "o", "\u001b[?2004h> "]
[601.743224, "o", "        \r\n\u001b[?2004l\r"]
[601.743249, "o", "\u001b[?2004h> "]
[601.743397, "o", "        # Create speaker segments from diarization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.743457, "o", "        segments = []\r\n\u001b[?2004l\r"]
[601.74348, "o", "\u001b[?2004h> "]
[601.743682, "o", "        for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.743767, "o", "            segments.append({\r\n\u001b[?2004l\r"]
[601.743787, "o", "\u001b[?2004h> "]
[601.743885, "o", "                'start': turn.start,\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.743904, "o", "> "]
[601.743985, "o", "                'end': turn.end,\r\n\u001b[?2004l\r"]
[601.744005, "o", "\u001b[?2004h> "]
[601.744102, "o", "                'speaker': speaker\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.744123, "o", "> "]
[601.744173, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.744193, "o", "        \r\n\u001b[?2004l\r"]
[601.744213, "o", "\u001b[?2004h> "]
[601.744362, "o", "        # If we have transcription, try to align it\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.744382, "o", "> "]
[601.744537, "o", "        if transcription and 'segments' in transcription:\r\n\u001b[?2004l\r"]
[601.744557, "o", "\u001b[?2004h> "]
[601.74474, "o", "            for seg in transcription['segments']:\r\n\u001b[?2004l\r"]
[601.744762, "o", "\u001b[?2004h> "]
[601.744931, "o", "                seg_start = seg['start']\r\n\u001b[?2004l\r"]
[601.744952, "o", "\u001b[?2004h> "]
[601.745186, "o", "                seg_end = seg['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.7456, "o", "                text = seg['text'].strip()\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.745824, "o", "                # Find dominant speaker for this segment\r\n\u001b[?2004l\r"]
[601.745847, "o", "\u001b[?2004h> "]
[601.746027, "o", "                speaker_times = {}\r\n\u001b[?2004l\r"]
[601.746052, "o", "\u001b[?2004h> "]
[601.746442, "o", "                for turn, _, spk in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.746468, "o", "> "]
[601.746769, "o", "                    overlap_start = max(turn.start, seg_start)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.746793, "o", "> "]
[601.747054, "o", "                    overlap_end = min(turn.end, seg_end)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.747076, "o", "> "]
[601.747717, "o", "                    if overlap_end > overlap_start:\r\n\u001b[?2004l\r\u001b[?2004h>                         overlap = overlap_end - overlap_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.748113, "o", "                        speaker_times[spk] = speaker_times.get(spk, 0) + overlap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.748183, "o", "                \r\n\u001b[?2004l\r"]
[601.748207, "o", "\u001b[?2004h> "]
[601.748489, "o", "                speaker = max(speaker_times, key=speaker_times.get) if speaker_times else \"spk00\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.748549, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[601.748568, "o", "> "]
[601.7487, "o", "                # Format times for ASS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.74881, "o", "                h1 = int(seg_start // 3600)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.748966, "o", "                m1 = int((seg_start % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.748986, "o", "> "]
[601.749084, "o", "                s1 = int(seg_start % 60)\r\n\u001b[?2004l\r"]
[601.749103, "o", "\u001b[?2004h> "]
[601.749254, "o", "                cs1 = int((seg_start % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.749303, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[601.749322, "o", "> "]
[601.749433, "o", "                h2 = int(seg_end // 3600)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.749456, "o", "> "]
[601.749576, "o", "                m2 = int((seg_end % 3600) // 60)\r\n\u001b[?2004l\r"]
[601.749595, "o", "\u001b[?2004h> "]
[601.749696, "o", "                s2 = int(seg_end % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.749716, "o", "> "]
[601.749838, "o", "                cs2 = int((seg_end % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.749862, "o", "> "]
[601.749916, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.750094, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r"]
[601.750113, "o", "\u001b[?2004h> "]
[601.750276, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.750295, "o", "> "]
[601.750346, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.750462, "o", "                label = speaker.upper()\r\n\u001b[?2004l\r"]
[601.750483, "o", "\u001b[?2004h> "]
[601.750751, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.750794, "o", "        else:\r\n\u001b[?2004l\r"]
[601.750812, "o", "\u001b[?2004h> "]
[601.750987, "o", "            # No transcription, just use speaker segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.751085, "o", "            for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.751231, "o", "                h1 = int(seg['start'] // 3600)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.751387, "o", "                m1 = int((seg['start'] % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.751509, "o", "                s1 = int(seg['start'] % 60)\r\n\u001b[?2004l\r"]
[601.75153, "o", "\u001b[?2004h> "]
[601.751677, "o", "                cs1 = int((seg['start'] % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.751697, "o", "> "]
[601.751752, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.751873, "o", "                h2 = int(seg['end'] // 3600)\r\n\u001b[?2004l\r"]
[601.751892, "o", "\u001b[?2004h> "]
[601.751984, "o", "                m2 = int((seg['end'] % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.752005, "o", "> "]
[601.752063, "o", "                s2 = int(seg['end'] % 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.752083, "o", "> "]
[601.752156, "o", "                cs2 = int((seg['end'] % 1) * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.752177, "o", "> "]
[601.752196, "o", "                \r\n\u001b[?2004l\r"]
[601.752217, "o", "\u001b[?2004h> "]
[601.752345, "o", "                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\r\n\u001b[?2004l\r"]
[601.752366, "o", "\u001b[?2004h> "]
[601.752475, "o", "                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\r\n\u001b[?2004l\r"]
[601.752506, "o", "\u001b[?2004h> "]
[601.752523, "o", "                \r\n\u001b[?2004l\r"]
[601.752542, "o", "\u001b[?2004h"]
[601.752567, "o", "> "]
[601.752692, "o", "                label = seg['speaker'].upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.752841, "o", "                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: [speech]\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.75286, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.752956, "o", "    print(f\"  ✓ ASS file generated: {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.752975, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.753037, "o", "def count_speakers(diarization):\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.753057, "o", "> "]
[601.753105, "o", "    \"\"\"Count number of speakers\"\"\"\r\n\u001b[?2004l\r"]
[601.753125, "o", "\u001b[?2004h> "]
[601.753176, "o", "    speakers = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.753197, "o", "> "]
[601.753346, "o", "    for turn, _, speaker in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.753463, "o", "        speakers.add(speaker)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.753501, "o", "    return len(speakers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.753523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.753638, "o", "def calculate_speech_time(diarization):\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.753661, "o", "> "]
[601.753735, "o", "    \"\"\"Calculate total speech time\"\"\"\r\n\u001b[?2004l\r"]
[601.753757, "o", "\u001b[?2004h> "]
[601.753808, "o", "    total = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.753939, "o", "    for turn, _, _ in diarization.itertracks(yield_label=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.754, "o", "        total += turn.end - turn.start\r\n\u001b[?2004l\r"]
[601.754023, "o", "\u001b[?2004h> "]
[601.754073, "o", "    return total\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754093, "o", "> "]
[601.75411, "o", "def main():\r\n\u001b[?2004l\r"]
[601.754133, "o", "\u001b[?2004h"]
[601.754154, "o", "> "]
[601.754236, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.754293, "o", "    audio_path = \"/tmp/audio.wav\"\r\n\u001b[?2004l\r"]
[601.754313, "o", "\u001b[?2004h> "]
[601.754393, "o", "    rttm_path = \"/root/diarization.rttm\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754413, "o", "> "]
[601.754462, "o", "    ass_path = \"/root/subtitles.ass\"\r\n\u001b[?2004l\r"]
[601.754482, "o", "\u001b[?2004h> "]
[601.754537, "o", "    report_path = \"/root/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754555, "o", ">     \r\n\u001b[?2004l\r"]
[601.754573, "o", "\u001b[?2004h> "]
[601.75463, "o", "    print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.754704, "o", "    print(\"SPEAKER DIARIZATION PIPELINE\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754725, "o", "> "]
[601.754772, "o", "    print(\"=\"*60 + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[601.754792, "o", "\u001b[?2004h> "]
[601.754838, "o", "    steps = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.754859, "o", "    tools = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754877, "o", "> "]
[601.754939, "o", "    libraries = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[601.754959, "o", ">     try:\r\n\u001b[?2004l\r"]
[601.754978, "o", "\u001b[?2004h> "]
[601.755033, "o", "        # Step 1: Extract audio\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755053, "o", "> "]
[601.755129, "o", "        if not extract_audio(input_video, audio_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755149, "o", "> "]
[601.755199, "o", "            sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.755269, "o", "        steps.append(\"audio_extraction\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755288, "o", "> "]
[601.755353, "o", "        tools[\"audio_extraction\"] = \"ffmpeg\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755372, "o", ">         \r\n\u001b[?2004l\r"]
[601.755389, "o", "\u001b[?2004h> "]
[601.755448, "o", "        # Get duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.755533, "o", "        audio_duration = get_duration(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755552, "o", "> "]
[601.755642, "o", "        print(f\"  Duration: {audio_duration:.2f} seconds\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755659, "o", ">         \r\n\u001b[?2004l\r"]
[601.755677, "o", "\u001b[?2004h> "]
[601.755733, "o", "        # Step 2: Diarization\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755754, "o", "> "]
[601.755811, "o", "        diarization = diarize(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.755832, "o", "> "]
[601.755879, "o", "        if not diarization:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.755961, "o", "            print(\"ERROR: Diarization failed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.75598, "o", "> "]
[601.756028, "o", "            sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756047, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756168, "o", "        steps.append(\"diarization\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756236, "o", "        tools[\"diarization\"] = \"pyannote.audio\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756296, "o", "        libraries.append(\"pyannote.audio\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.756317, "o", "> "]
[601.756365, "o", "        libraries.append(\"torch\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756383, "o", "        \r\n\u001b[?2004l\r"]
[601.756401, "o", "\u001b[?2004h> "]
[601.756484, "o", "        num_speakers = count_speakers(diarization)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.756505, "o", "> "]
[601.756583, "o", "        print(f\"  Speakers detected: {num_speakers}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.75663, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756776, "o", "        # Step 3: Transcription\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756876, "o", "        transcription = transcribe(audio_path)\r\n\u001b[?2004l\r\u001b[?2004h>         if transcription:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.756934, "o", "            steps.append(\"transcription\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.757024, "o", "            tools[\"transcription\"] = \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757069, "o", "> "]
[601.757112, "o", "            libraries.append(\"openai-whisper\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757156, "o", ">         print()\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757198, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.757267, "o", "        # Step 4 & 5: Generate outputs\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757311, "o", "> "]
[601.757355, "o", "        generate_rttm(diarization, rttm_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757398, "o", "> "]
[601.757459, "o", "        generate_ass(diarization, transcription, ass_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757503, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.75757, "o", "        steps.append(\"rttm_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757615, "o", "> "]
[601.757657, "o", "        steps.append(\"subtitle_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757699, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.75774, "o", "        # Calculate metrics\r\n\u001b[?2004l\r"]
[601.757782, "o", "\u001b[?2004h> "]
[601.757853, "o", "        total_speech_time = calculate_speech_time(diarization)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.757895, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.757946, "o", "        # Generate report\r\n\u001b[?2004l\r"]
[601.757994, "o", "\u001b[?2004h>         report = {\r\n\u001b[?2004l\r"]
[601.758036, "o", "\u001b[?2004h> "]
[601.758078, "o", "            \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r"]
[601.758119, "o", "\u001b[?2004h> "]
[601.758194, "o", "            \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.75826, "o", "> "]
[601.758303, "o", "            \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r"]
[601.758344, "o", "\u001b[?2004h> "]
[601.758385, "o", "            \"steps_completed\": steps,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.758486, "o", "            \"commands_used\": [\"ffmpeg\", \"ffprobe\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.758528, "o", "> "]
[601.758582, "o", "            \"libraries_used\": list(set(libraries)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.758622, "o", "> "]
[601.758662, "o", "            \"tools_used\": tools,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.758959, "o", "            \"notes\": f\"Successfully processed {input_video} with {num_speakers} speakers. Generated RTTM diarization output, ASS subtitle file with speaker labels, and comprehensive report.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759015, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759096, "o", "        with open(report_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759174, "o", "            json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759222, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759279, "o", "        steps.append(\"report_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.759322, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759375, "o", "        print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.759416, "o", "> "]
[601.759457, "o", "        print(\"SUMMARY\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759499, "o", "        print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759583, "o", "        print(f\"Speakers detected: {num_speakers}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759697, "o", "        print(f\"Total speech time: {total_speech_time:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.75978, "o", "        print(f\"Audio duration: {audio_duration:.2f}s\")\r\n\u001b[?2004l\r"]
[601.759823, "o", "\u001b[?2004h> "]
[601.759865, "o", "        print(f\"\\nOutput files:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.759923, "o", "        print(f\"  - {rttm_path}\")\r\n\u001b[?2004l\r"]
[601.759963, "o", "\u001b[?2004h> "]
[601.760014, "o", "        print(f\"  - {ass_path}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760059, "o", "        print(f\"  - {report_path}\")\r\n\u001b[?2004l\r"]
[601.760101, "o", "\u001b[?2004h> "]
[601.760143, "o", "        print(\"\\n\" + \"=\"*60 + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760186, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760228, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.760271, "o", "> "]
[601.760313, "o", "        print(f\"\\nERROR: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760356, "o", "        import traceback\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.760401, "o", "> "]
[601.760444, "o", "        traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760487, "o", "        sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.760542, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.760583, "o", ">     main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
