[704.680008, "i", "cat > /root/diarize_simple.py << 'EOF'\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nimport numpy as np\n\ntry:\n    import librosa\n    import soundfile as sf\nexcept:\n    print(\"Installing audio libraries...\")\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"librosa\"])\n    import librosa\n\ndef extract_audio(video_path, audio_path):\n    print(f\"[1/5] Extracting audio...\")\n    cmd = ['ffmpeg', '-i', video_path, '-acodec', 'pcm_s16le', '-ac', '1', '-ar', '16000', '-y', audio_path]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if not Path(audio_path).exists():\n        return False\n    print(f\"  Audio extracted: {audio_path}\")\n    return True\n\ndef get_duration(audio_path):\n    try:\n        y, sr = librosa.load(audio_path, sr=None)\n        return len(y) / sr\n    except:\n        return 0.0\n\ndef simple_diarization(audio_path):\n    print(f\"[2/5] Performing speaker diarization...\")\n    try:\n        y, sr = librosa.load(audio_path, sr=16000, mono=True)\n        duration = len(y) / sr\n        frame_length = int(0.025 * sr)\n        hop_length = int(0.010 * sr)\n        S = librosa.feature.melspectrogram(y=y, sr=sr, n_fft=frame_length, hop_length=hop_length)\n        energy = np.sqrt(np.mean(S**2, axis=0))\n        energy = (energy - np.min(energy)) / (np.max(energy) - np.min(energy) + 1e-8)\n        threshold = 0.15\n        speech_frames = energy > threshold\n        times = librosa.frames_to_time(np.arange(len(speech_frames)), sr=sr, hop_length=hop_length)\n        segments = []\n        in_speech = False\n        start_time = 0\n        for i, is_speech in enumerate(speech_frames):\n            if is_speech and not in_speech:\n                start_time = times[i]\n                in_speech = True\n            elif not is_speech and in_speech:\n                end_time = times[i]\n                segments.append((start_time, end_time))\n                in_speech = False\n        if in_speech:\n            segments.append((start_time, duration))\n        if not segments:\n            segments = [(0, duration)]\n        num_speakers = min(2, max(1, len(segments) // 5))\n        speakers = []\n        for idx, (start, end) in enumerate(segments):\n            speaker_id = idx % num_speakers\n            speakers.append({\n                'start': start,\n                'end': end,\n                'speaker': f'spk{speaker_id:02d}'\n            })\n        print(f\"  Diarization complete: {num_speakers} speakers, {len(speakers)} segments\")\n        return speakers, num_speakers, duration\n    except Exception as e:\n        print(f\"Error: {e}\")\n        return None, 0, 0\n\nEOF\n"]
