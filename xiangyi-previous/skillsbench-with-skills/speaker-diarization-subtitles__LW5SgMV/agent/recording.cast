[720.142857, "i", "cat >> /root/diarize_simple.py << 'EOF'\ndef transcribe_with_whisper(audio_path):\n    print(f\"[3/5] Transcribing audio...\")\n    try:\n        import whisper\n        model = whisper.load_model(\"tiny\")\n        result = model.transcribe(audio_path, language=\"en\", fp16=False)\n        print(f\"  Transcription complete\")\n        return result\n    except Exception as e:\n        print(f\"  Transcription skipped\")\n        return None\n\ndef generate_rttm(speakers, output_path):\n    print(f\"[4/5] Generating RTTM file...\")\n    with open(output_path, 'w') as f:\n        for seg in speakers:\n            start = seg['start']\n            duration = seg['end'] - seg['start']\n            speaker = seg['speaker']\n            f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\n    print(f\"  RTTM file generated\")\n\ndef generate_ass(speakers, transcription, output_path):\n    print(f\"[5/5] Generating ASS subtitle file...\")\n    ass_header = \"\"\"[Script Info]\nTitle: Diarization Subtitles\nScriptType: v4.00+\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\nStyle: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n\"\"\"\n    with open(output_path, 'w') as f:\n        f.write(ass_header)\n        if transcription and 'segments' in transcription:\n            for seg in transcription['segments']:\n                seg_start = seg['start']\n                seg_end = seg['end']\n                text = seg['text'].strip()\n                speaker = 'spk00'\n                max_overlap = 0\n                for spk_seg in speakers:\n                    overlap_start = max(spk_seg['start'], seg_start)\n                    overlap_end = min(spk_seg['end'], seg_end)\n                    if overlap_end > overlap_start:\n                        overlap = overlap_end - overlap_start\n                        if overlap > max_overlap:\n                            max_overlap = overlap\n                            speaker = spk_seg['speaker']\n                h1, m1, s1 = int(seg_start // 3600), int((seg_start % 3600) // 60), int(seg_start % 60)\n                cs1 = int((seg_start % 1) * 100)\n                h2, m2, s2 = int(seg_end // 3600), int((seg_end % 3600) // 60), int(seg_end % 60)\n                cs2 = int((seg_end % 1) * 100)\n                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\n                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\n                label = speaker.upper()\n                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: {text}\\n\")\n        else:\n            for seg in speakers:\n                h1, m1, s1 = int(seg['start'] // 3600), int((seg['start'] % 3600) // 60), int(seg['start'] % 60)\n                cs1 = int((seg['start'] % 1) * 100)\n                h2, m2, s2 = int(seg['end'] // 3600), int((seg['end'] % 3600) // 60), int(seg['end'] % 60)\n                cs2 = int((seg['end'] % 1) * 100)\n                start_time = f\"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}\"\n                end_time = f\"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}\"\n                label = seg['speaker'].upper()\n                f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: [speech]\\n\")\n    print(f\"  ASS file generated\")\n\ndef main():\n    input_video = \"/root/input.mp4\"\n    audio_path = \"/tmp/audio.wav\"\n    rttm_path = \"/root/diarization.rttm\"\n    ass_path = \"/root/subtitles.ass\"\n    report_path = \"/root/report.json\"\n    print(\"\\n\" + \"=\"*60)\n    print(\"SPEAKER DIARIZATION PIPELINE\")\n    print(\"=\"*60 + \"\\n\")\n    steps = []\n    tools = {}\n    libraries = []\n    if not extract_audio(input_video, audio_path):\n        sys.exit(1)\n    steps.append(\"audio_extraction\")\n    tools[\"audio_extraction\"] = \"ffmpeg\"\n    print()\n    speakers, num_speakers, audio_duration = simple_diarization(audio_pa"]
[720.142964, "i", "th)\n    if not speakers:\n        print(\"ERROR: Diarization failed\")\n        sys.exit(1)\n    steps.append(\"diarization\")\n    tools[\"diarization\"] = \"librosa (energy-based segmentation)\"\n    libraries.append(\"librosa\")\n    libraries.append(\"numpy\")\n    print()\n    transcription = transcribe_with_whisper(audio_path)\n    if transcription:\n        steps.append(\"transcription\")\n        tools[\"transcription\"] = \"openai-whisper\"\n        libraries.append(\"openai-whisper\")\n    print()\n    generate_rttm(speakers, rttm_path)\n    generate_ass(speakers, transcription, ass_path)\n    print()\n    steps.append(\"rttm_generation\")\n    steps.append(\"subtitle_generation\")\n    total_speech_time = sum(seg['end'] - seg['start'] for seg in speakers)\n    report = {\n        \"num_speakers_pred\": num_speakers,\n        \"total_speech_time_sec\": round(total_speech_time, 2),\n        \"audio_duration_sec\": round(audio_duration, 2),\n        \"steps_completed\": steps,\n        \"commands_used\": [\"ffmpeg\", \"python3\"],\n        \"libraries_used\": list(set(libraries)),\n        \"tools_used\": tools,\n        \"notes\": f\"Successfully processed {input_video} with {num_speakers} speakers. Used energy-based segmentation for diarization.\"\n    }\n    with open(report_path, 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"=\"*60)\n    print(\"SUMMARY\")\n    print(\"=\"*60)\n    print(f\"Speakers detected: {num_speakers}\")\n    print(f\"Total speech time: {total_speech_time:.2f}s\")\n    print(f\"Audio duration: {audio_duration:.2f}s\")\n    print(f\"Output files:\")\n    print(f\"  - {rttm_path}\")\n    print(f\"  - {ass_path}\")\n    print(f\"  - {report_path}\")\n    print(\"=\"*60 + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
