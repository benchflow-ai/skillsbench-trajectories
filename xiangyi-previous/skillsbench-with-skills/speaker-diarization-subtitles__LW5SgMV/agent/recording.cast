[720.159697, "o", "    generate_ass(speakers, transcription, ass_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.15972, "o", ">     print()\r\n\u001b[?2004l\r"]
[720.159772, "o", "\u001b[?2004h> "]
[720.15982, "o", "    steps.append(\"rttm_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159844, "o", "> "]
[720.159895, "o", "    steps.append(\"subtitle_generation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.159916, "o", "> "]
[720.160032, "o", "    total_speech_time = sum(seg['end'] - seg['start'] for seg in speakers)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.160054, "o", "> "]
[720.160075, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.160167, "o", "        \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.160274, "o", "        \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r"]
[720.1603, "o", "\u001b[?2004h> "]
[720.1604, "o", "        \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.160423, "o", "> "]
[720.160519, "o", "        \"steps_completed\": steps,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.160599, "o", "        \"commands_used\": [\"ffmpeg\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.160713, "o", "        \"libraries_used\": list(set(libraries)),\r\n\u001b[?2004l\r"]
[720.160772, "o", "\u001b[?2004h> "]
[720.160817, "o", "        \"tools_used\": tools,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.161017, "o", "        \"notes\": f\"Successfully processed {input_video} with {num_speakers} speakers. Used energy-based segmentation for diarization.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.161067, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.161122, "o", "    with open(report_path, 'w') as f:\r\n\u001b[?2004l\r"]
[720.161165, "o", "\u001b[?2004h> "]
