[618.342998, "o", "            losses = -F.logsigmoid(logits)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.343049, "o", "        elif self.loss_type == \"hinge\":\r\n\u001b[?2004l\r"]
[618.343097, "o", "\u001b[?2004h> "]
[618.343155, "o", "            # Hinge loss: max(0, 1 - logits)\r\n\u001b[?2004l\r"]
[618.343202, "o", "\u001b[?2004h> "]
[618.343247, "o", "            losses = torch.relu(1 - logits)\r\n\u001b[?2004l\r"]
[618.343294, "o", "\u001b[?2004h> "]
[618.343339, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.343452, "o", "            raise ValueError(f\"Unknown loss type: {self.loss_type}\")\r\n\u001b[?2004l\r"]
[618.343544, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.343659, "o", "        return losses, chosen_rewards, rejected_rewards\r\n\u001b[?2004l\r\u001b[?2004h> '''"]
