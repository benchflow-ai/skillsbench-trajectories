[320.997806, "o", "1\r\n|yl| log πθ(yl|x)\r\n\u0011\r\n−λ log πθ(yw|x)\r\nλ ∈[0.1, 0.5, 1.0, 10.0]\r\nSLiC-HF [96]\r\nmax (0, δ −log πθ(yw|x) + log πθ(yl|x)) −λ log πθ(yw|x)\r\nλ ∈[0.1, 0.5, 1.0, 10.0]\r\nβ ∈[0.1, 0.5, 1.0, 2.0]\r\nDPO [66]\r\n−log σ\r\n\u0010\r\nβ log πθ(yw|x)\r\nπref(yw|x) −β log πθ(yl|x)\r\nπref(yl|x)\r\n\u0011\r\nβ ∈[0.01, 0.05, 0.1]\r\nIPO [6]\r\n\u0010\r\nlog πθ(yw|x)\r\nπref(yw|x) −log πθ(yl|x)\r\nπref(yl|x) −\r\n1\r\n2τ\r\n\u00112\r\nτ ∈[0.01, 0.1, 0.5, 1.0]\r\nCPO [88]\r\n−log σ (β log πθ(yw|x) −β log πθ(yl|x)) −λ log πθ(yw|x)\r\nλ = 1.0, β ∈[0.01, 0.05, 0.1]\r\nKTO [29]\r\n−λwσ\r\n\u0010\r\nβ log πθ(yw|x)\r\nπref(yw|x) −zref\r\n\u0011\r\n+ λlσ\r\n\u0010\r\nzref −β log πθ(yl|x)\r\nπref(yl|x)\r\n\u0011\r\n,\r\nλl = λw = 1.0\r\nwhere zref = E(x,y)∼D [βKL (πθ(y|x)||πref(y|x))]\r\nβ ∈[0.01, 0.05, 0.1]\r\nORPO [42]\r\n−log pθ(yw|x) −λ log σ\r\n\u0010\r\nlog\r\npθ(yw|x)\r\n1−pθ(yw|x) −log\r\npθ(yl|x)\r\n1−pθ(yl|x)\r\n\u0011\r\n,\r\nλ ∈[0.1, 0.5, 1.0, 2.0]\r\nwhere pθ(y|x) = exp\r\n\u0010\r\n1\r\n|y| log πθ(y|x)\r\n\u0011\r\nR-DPO [64]\r\n−log σ\r\n\u0010\r\nβ log πθ(yw|x)\r\nπref(yw|x) −β log πθ(yl|x)\r\nπref(yl|x) + (α|yw| −α|yl|)\r\n\u0011\r\nα ∈[0.05, 0.1, 0.5, 1.0]\r\nβ ∈[0.01, 0.05, 0.1]\r\nSimPO\r\n−log σ\r\n\u0010\r\nβ\r\n|yw| log πθ(yw|x) −\r\nβ\r\n|yl| log πθ(yl|x) −γ\r\n\u0011\r\nβ ∈[2.0, 2.5]\r\nγ ∈[0.3, 0.5, 1.0, 1.2, 1.4, 1.6]\r\n0\r\n200\r\n400\r\n600\r\n800"]
