[328.863927, "i", "python3 << 'EOF'\nimport json\nwith open('/root/SimPO/paper.json', 'r') as f:\n    paper = json.load(f)\n    # Look for pages with the SimPO formula\n    for page_num in ['3', '4', '5', '6']:\n        if page_num in paper:\n            content = paper[page_num]\n            if 'LSimPO' in content or 'SimPO' in content:\n                print(f\"\\n=== Page {page_num} ===\")\n                print(content)\nEOF\n"]
