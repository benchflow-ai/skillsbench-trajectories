[317.753887, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\nurl = \"https://www.geostat.ge/en/modules/categories/23/national-accounts\"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        \n        # Save full HTML for inspection\n        with open('geostat_page.html', 'w') as f:\n            f.write(html)\n        \n        # Find all links\n        links = re.findall(r'href=[\"\\']([^\"\\']+)[\"\\']', html)\n        \n        # Look for category links\n        print(\"Category links:\")\n        for link in links:\n            if '/categories/' in link or '/modules/' in link:\n                print(f\"  {link}\")\n        \n        # Look for xlsx files\n        print(\"\\nExcel files:\")\n        xlsx_links = [l for l in links if '.xls' in l.lower()]\n        for link in xlsx_links[:20]:\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
