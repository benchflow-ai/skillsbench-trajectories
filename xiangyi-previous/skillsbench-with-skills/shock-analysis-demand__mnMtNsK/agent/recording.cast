[76.769571, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\n\n# Create SSL context that doesn't verify certificates (for simplicity)\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# IMF WEO URL for Georgia (country code 915)\n# NGDP_R = Real GDP, NGDP = Nominal GDP, NGDPD = GDP in USD, NGDP_D = GDP Deflator, NGDP_RPCH = Real GDP growth\nurl = \"https://www.imf.org/external/pubs/ft/weo/2024/02/weodata/weorept.aspx?pr.x=50&pr.y=9&sy=2020&ey=2029&scsm=1&ssd=1&sort=country&ds=.&br=1&c=915&s=NGDP_R,NGDP,NGDPD,NGDP_D,NGDP_RPCH&grp=0&a=\"\n\ntry:\n    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        with open('imf_weo_raw.html', 'w') as f:\n            f.write(html)\n        print(\"Downloaded IMF WEO data successfully\")\n        print(f\"File size: {len(html)} bytes\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
