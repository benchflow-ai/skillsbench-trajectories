[488.288535, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Let's look at the saved GDP page HTML more carefully\nwith open('gdp_page.html', 'r') as f:\n    html = f.read()\n\n# Search for SUT, supply, use in the full HTML\nprint(\"Searching for SUT-related content...\")\n\n# Find all text content\nif 'Supply' in html or 'supply' in html:\n    # Find context around 'supply'\n    matches = re.finditer(r'.{0,100}[Ss]upply.{0,100}', html)\n    print(\"\\nContexts with 'supply':\")\n    for i, m in enumerate(matches):\n        if i < 5:\n            text = m.group().replace('<', ' <').replace('>', '> ')\n            print(f\"  {text[:150]}...\")\n\n# Also check for SUT\nif 'SUT' in html:\n    print(\"\\nFound 'SUT' in page\")\n\n# Check for input-output\nif 'input' in html.lower() and 'output' in html.lower():\n    print(\"\\nFound input-output references\")\nEOF\n"]
