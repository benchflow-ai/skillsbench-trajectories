[457.729864, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Try searching Geostat for SUT or input-output\nurl = \"https://www.geostat.ge/en/search?q=supply+use+table\"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        print(\"Search results for 'supply use table':\")\n        \n        # Find links\n        links = re.findall(r'href=[\"\\']([^\"\\']+)[\"\\']', html)\n        xlsx_links = [l for l in links if '.xls' in l.lower()]\n        for link in xlsx_links[:10]:\n            print(f\"  {link}\")\n        \n        # Also find category links\n        cat_links = [l for l in links if 'categories' in l]\n        print(\"\\nCategory links in results:\")\n        for link in set(cat_links)[:10]:\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\n\n# Also try input-output\nurl2 = \"https://www.geostat.ge/en/search?q=input+output\"\ntry:\n    req = urllib.request.Request(url2, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        print(\"\\n\\nSearch results for 'input output':\")\n        links = re.findall(r'href=[\"\\']([^\"\\']+)[\"\\']', html)\n        xlsx_links = [l for l in links if '.xls' in l.lower()]\n        for link in xlsx_links[:10]:\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[457.734916, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ssl_context = ssl.create_default_context()\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.check_hostname = False\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.verify_mode = ssl.CERT_NONE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try searching Geostat for SUT or input-output\r\n\u001b[?2004l\r\u001b[?2004h> url = \"https://www.geostat.ge/en/search?q=supply+use+table\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     req = urllib.request.Request(url, headers={\r\n\u001b[?2004l\r\u001b[?2004h>         'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\r\n\u001b[?2004l\r\u001b[?2004h>         'Accept': 'text/html'\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\r\n\u001b[?2004l\r\u001b[?2004h>         html = response.read().decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"Search results for 'supply use table':\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Find links\r\n\u001b[?2004l\r\u001b[?2004h>         links = re.findall(r'href=[\"\\']([^\"\\']+)[\"\\']', html)\r\n\u001b[?2004l\r\u001b[?2004h>         xlsx_links = [l for l in links if '.xls' in l.lower()]\r\n\u001b[?2004l\r\u001b[?2004h>         for link in xlsx_links[:10]:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {link}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Also find category links\r\n\u001b[?2004l\r\u001b[?2004h>         cat_links = [l for l in links if 'categories' in l]\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"\\nCategory links in results:\")\r\n\u001b[?2004l\r\u001b[?2004h>         for link in set(cat_links)[:10]:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {link}\")\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Error: {e}\")"]
