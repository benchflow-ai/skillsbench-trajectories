[369.802698, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Search the main GDP page for SUT links\nurl = \"https://www.geostat.ge/en/modules/categories/23/gross-domestic-product-gdp\"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        \n        # Save for inspection\n        with open('gdp_page.html', 'w') as f:\n            f.write(html)\n        \n        # Search for supply, use, SUT in the text\n        # Find all links and their surrounding text\n        all_links = re.findall(r'<a[^>]*href=[\"\\']([^\"\\']+)[\"\\'][^>]*>([^<]*)</a>', html, re.IGNORECASE)\n        \n        print(\"Links with text containing supply/use/SUT:\")\n        for link, text in all_links:\n            if 'supply' in text.lower() or 'use' in text.lower() or 'sut' in text.lower() or 'input' in text.lower() or 'output' in text.lower():\n                print(f\"  {text}: {link}\")\n        \n        # Also check for subcategory links\n        print(\"\\nAll category links:\")\n        cat_links = re.findall(r'href=[\"\\']([^\"\\']*categories/\\d+[^\"\\']*)[\"\\']', html)\n        for link in set(cat_links):\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[369.806132, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ssl_context = ssl.create_default_context()\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.check_hostname = False\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.verify_mode = ssl.CERT_NONE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Search the main GDP page for SUT links\r\n\u001b[?2004l\r\u001b[?2004h> url = \"https://www.geostat.ge/en/modules/categories/23/gross-domestic-product-gdp\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     req = urllib.request.Request(url, headers={\r\n\u001b[?2004l\r\u001b[?2004h>         'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\r\n\u001b[?2004l\r\u001b[?2004h>         'Accept': 'text/html'\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\r\n\u001b[?2004l\r\u001b[?2004h>         html = response.read().decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Save for inspection\r\n\u001b[?2004l\r\u001b[?2004h>         with open('gdp_page.html', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(html)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Search for supply, use, SUT in the text\r\n\u001b[?2004l\r\u001b[?2004h>         # Find all links and their surrounding text\r\n\u001b[?2004l\r\u001b[?2004h>         all_links = re.findall(r'<a[^>]*href=[\"\\']([^\"\\']+)[\"\\'][^>]*>([^<]*)</a>', html, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h"]
