[139.071687, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport json\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Indicators to fetch\nindicators = {\n    'NGDP_RPCH': 'Real GDP Growth Rate',\n    'NGDP': 'Nominal GDP (LCU billions)',\n    'NGDPD': 'GDP USD (billions)',\n    'NGDP_D': 'GDP Deflator'\n}\n\nall_data = {}\n\nfor indicator, desc in indicators.items():\n    url = f\"https://www.imf.org/external/datamapper/api/v1/{indicator}/GEO\"\n    try:\n        req = urllib.request.Request(url, headers={\n            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n            'Accept': 'application/json'\n        })\n        with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n            data = json.loads(response.read().decode('utf-8'))\n            values = data['values'][indicator]['GEO']\n            all_data[indicator] = values\n            print(f\"\\n{indicator} ({desc}):\")\n            # Print years 2020-2029\n            for year in range(2020, 2030):\n                yr_str = str(year)\n                if yr_str in values:\n                    print(f\"  {year}: {values[yr_str]}\")\n    except Exception as e:\n        print(f\"Error fetching {indicator}: {e}\")\n\n# Save to file for later use\nwith open('imf_data.json', 'w') as f:\n    json.dump(all_data, f, indent=2)\nprint(\"\\nData saved to imf_data.json\")\nEOF\n"]
