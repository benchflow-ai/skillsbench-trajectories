[263.837144, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Try to access Geostat website\nurl = \"https://www.geostat.ge/en/modules/categories/196/supply-and-use-tables\"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        # Look for xlsx or xls file links\n        import re\n        links = re.findall(r'href=[\"\\']([^\"\\']*\\.xlsx?)[\"\\']', html, re.IGNORECASE)\n        print(\"Excel file links found:\")\n        for link in links:\n            print(f\"  {link}\")\n        \n        # Also search for download links\n        download_links = re.findall(r'href=[\"\\']([^\"\\']*(?:download|file)[^\"\\']*)[\"\\']', html, re.IGNORECASE)\n        print(\"\\nDownload links:\")\n        for link in download_links[:10]:\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
