[500.586656, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Try potential SUT URLs\nurls_to_try = [\n    \"https://www.geostat.ge/en/modules/categories/124/supply-and-use-tables\",\n    \"https://www.geostat.ge/en/modules/categories/125/supply-and-use-tables\",\n    \"https://www.geostat.ge/en/modules/categories/119/input-output\",\n    \"https://www.geostat.ge/en/modules/categories/120\",\n    \"https://www.geostat.ge/en/modules/categories/121\",\n    \"https://www.geostat.ge/en/modules/categories/122\",\n    \"https://www.geostat.ge/en/modules/categories/123\",\n]\n\nfor url in urls_to_try:\n    try:\n        req = urllib.request.Request(url, headers={\n            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n            'Accept': 'text/html'\n        })\n        with urllib.request.urlopen(req, context=ssl_context, timeout=15) as response:\n            html = response.read().decode('utf-8')\n            title = re.search(r'<title>([^<]+)</title>', html)\n            if title:\n                print(f\"{url}\")\n                print(f\"  Title: {title.group(1)}\")\n                \n                # Find xlsx links\n                xlsx_links = re.findall(r'href=[\"\\']([^\"\\']+\\.xlsx?)[\"\\']', html, re.IGNORECASE)\n                if xlsx_links:\n                    print(f\"  Excel files: {len(xlsx_links)}\")\n                    for link in xlsx_links[:3]:\n                        print(f\"    {link}\")\n    except Exception as e:\n        print(f\"{url}: {e}\")\nEOF\n"]
