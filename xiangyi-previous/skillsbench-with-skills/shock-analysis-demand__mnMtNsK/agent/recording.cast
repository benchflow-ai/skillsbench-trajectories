[343.53318, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Try the SUT category page\nurl = \"https://www.geostat.ge/en/modules/categories/196/supply-and-use-tables\"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n        'Accept': 'text/html'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode('utf-8')\n        \n        # Find all xlsx links\n        links = re.findall(r'href=[\"\\']([^\"\\']+\\.xlsx?)[\"\\']', html, re.IGNORECASE)\n        print(\"Excel files on SUT page:\")\n        for link in links:\n            print(f\"  {link}\")\n        \n        # Also look for media links\n        media_links = re.findall(r'(https?://[^\"\\s]+media[^\"\\s]+)', html)\n        print(\"\\nMedia links:\")\n        for link in set(media_links)[:20]:\n            print(f\"  {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[343.533499, "o", "python3 << 'EOF'\r\n"]
[343.533537, "o", "\u001b[?2004l\r\u001b[?2004h> import urllib.request"]
[343.538284, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ssl_context = ssl.create_default_context()\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.check_hostname = False\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.verify_mode = ssl.CERT_NONE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try the SUT category page\r\n\u001b[?2004l\r\u001b[?2004h> url = \"https://www.geostat.ge/en/modules/categories/196/supply-and-use-tables\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     req = urllib.request.Request(url, headers={\r\n\u001b[?2004l\r\u001b[?2004h>         'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\r\n\u001b[?2004l\r\u001b[?2004h>         'Accept': 'text/html'\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\r\n\u001b[?2004l\r\u001b[?2004h>         html = response.read().decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Find all xlsx links\r\n\u001b[?2004l\r\u001b[?2004h>         links = re.findall(r'href=[\"\\']([^\"\\']+\\.xlsx?)[\"\\']', html, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"Excel files on SUT page:\")\r\n\u001b[?2004l\r\u001b[?2004h>         for link in links:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {link}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Also look for media links\r\n\u001b[?2004l\r\u001b[?2004h>         media_links = re.findall(r'(https?://[^\"\\s]+media[^\"\\s]+)', html)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"\\nMedia links:\")\r\n\u001b[?2004l\r\u001b[?2004h>         for link in set(media_links)[:20]:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {link}\")\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
