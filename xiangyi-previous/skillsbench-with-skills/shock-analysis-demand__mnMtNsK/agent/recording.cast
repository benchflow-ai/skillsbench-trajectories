[222.969356, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\nimport json\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Let's try to find GDP deflator or nominal GDP data\n# Try NGDP_R (Real GDP) and calculate deflator from nominal/real\n\n# First let's see what we have and calculate what we need\n# We have: NGDPD (GDP in USD), NGDP_RPCH (Real GDP growth)\n# We need: Real GDP levels, GDP Deflator\n\n# Let's try NGDPRPC (Real GDP per capita) and work backwards\nalternative_codes = ['NGDPRPC', 'NGDPRPPPPC', 'NGSD_NGDP', 'BCA_NGDPD', 'GGXWDG_NGDP']\n\nfor indicator in alternative_codes:\n    url = f\"https://www.imf.org/external/datamapper/api/v1/{indicator}/GEO\"\n    try:\n        req = urllib.request.Request(url, headers={\n            'User-Agent': 'Mozilla/5.0',\n            'Accept': 'application/json'\n        })\n        with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n            data = json.loads(response.read().decode('utf-8'))\n            if 'values' in data and indicator in data['values']:\n                values = data['values'][indicator]['GEO']\n                print(f\"\\n{indicator}:\")\n                for year in ['2020', '2021', '2022', '2023', '2024', '2025', '2026', '2027', '2028', '2029']:\n                    if year in values:\n                        print(f\"  {year}: {values[year]}\")\n    except Exception as e:\n        print(f\"{indicator}: error - {e}\")\nEOF\n"]
[222.975255, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ssl_context = ssl.create_default_context()\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.check_hostname = False\r\n\u001b[?2004l\r\u001b[?2004h> ssl_context.verify_mode = ssl.CERT_NONE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's try to find GDP deflator or nominal GDP data\r\n\u001b[?2004l\r\u001b[?2004h> # Try NGDP_R (Real GDP) and calculate deflator from nominal/real\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # First let's see what we have and calculate what we need\r\n\u001b[?2004l\r\u001b[?2004h> # We have: NGDPD (GDP in USD), NGDP_RPCH (Real GDP growth)\r\n\u001b[?2004l\r\u001b[?2004h> # We need: Real GDP levels, GDP Deflator\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let's try NGDPRPC (Real GDP per capita) and work backwards\r\n\u001b[?2004l\r\u001b[?2004h> alternative_codes = ['NGDPRPC', 'NGDPRPPPPC', 'NGSD_NGDP', 'BCA_NGDPD', 'GGXWDG_NGDP']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for indicator in alternative_codes:\r\n\u001b[?2004l\r\u001b[?2004h>     url = f\"https://www.imf.org/external/datamapper/api/v1/{indicator}/GEO\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         req = urllib.request.Request(url, headers={\r\n\u001b[?2004l\r\u001b[?2004h>             'User-Agent': 'Mozilla/5.0',\r\n\u001b[?2004l\r\u001b[?2004h>             'Accept': 'application/json'\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\r\n\u001b[?2004l\r\u001b[?2004h>             data = json.loads(response.read().decode('utf-8'))\r\n\u001b[?2004l\r\u001b[?2004h>             if 'values' in data and indicator in data['values']:\r\n\u001b[?2004l\r\u001b[?2004h>                 values = data['values'][indicator]['GEO']\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f\"\\n{indicator}:\")\r\n\u001b[?2004l\r\u001b[?2004h>                 for year in ['2020', '2021', '2022', '2023', '2024', '2025', '2026', '2027', '2028', '2029']:\r\n\u001b[?2004l\r\u001b[?2004h>                     if year in values:\r\n\u001b[?2004l\r\u001b[?2004h>                         print(f\"  {year}: {values[year]}\")\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{indicator}: error - {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
