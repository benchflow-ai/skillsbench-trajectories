[238.37508, "i", "python3 << 'EOFPYTHON'\nimport json\n\nchapter_titles = [\n    \"What we'll do\",\n    \"How we'll get there\",\n    \"Getting a floor plan\",\n    \"Getting started\",\n    \"Basic Navigation\",\n    \"Import your plan into Blender\",\n    \"Basic transform operations\",\n    \"Setting up the plan and units\",\n    \"It all starts with a plane\",\n    \"Scaling the plane to real dimensions\",\n    \"Getting the plan in place\",\n    \"Tracing the outline\",\n    \"Tracing inner walls\",\n    \"Break\",\n    \"Continue tracing inner walls\",\n    \"Remove doubled vertices\",\n    \"Save\",\n    \"Make the floor\",\n    \"Remove unnecessary geometry\",\n    \"Make the floor's faces\",\n    \"Make the background\",\n    \"Extruding the walls in Z\",\n    \"Reviewing face orientation\",\n    \"Adding thickness to walls with Modifiers\",\n    \"Fixing face orientation errors\",\n    \"Note on face orientation\",\n    \"Save As\",\n    \"If you need thick and thin walls\",\n    \"Great job!\"\n]\n\n# Detected timestamps (starting from frame 4)\ntimestamps = [8, 12, 18, 34, 40, 44, 60, 72, 84, 126, 160, 164, 308, 312, 354, 384, 718, 724, 882, 912, 1024, 1032, 1046, 1110, 1232, 1236, 1314, 1320, 1380]\n\n# Create chapters array with first chapter at 0\nchapters = [\n    {\"time\": 0, \"title\": chapter_titles[0]}\n]\n\n# Add remaining chapters with detected timestamps\nfor i in range(1, 29):\n    chapters.append({\n        \"time\": timestamps[i-1],\n        \"title\": chapter_titles[i]\n    })\n\n# Create the output structure\noutput = {\n    \"video_info\": {\n        \"title\": \"In-Depth Floor Plan Tutorial Part 1\",\n        \"duration_seconds\": 1382\n    },\n    \"chapters\": chapters\n}\n\n# Write to file\nwith open('/root/tutorial_index.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(\"JSON file created successfully!\")\nprint(f\"Total chapters: {len(chapters)}\")\nprint(f\"First chapter: {chapters[0]['title']} at {chapters[0]['time']}s\")\nprint(f\"Last chapter: {chapters[-1]['title']} at {chapters[-1]['time']}s\")\nEOFPYTHON\n"]
