[227.667459, "i", "python3 << 'EOFPYTHON'\nimport os\n\nframe_dir = '/tmp'\ngrays = sorted([f for f in os.listdir(frame_dir) if f.startswith('gray_') and f.endswith('.png')])\n\nsizes = []\nfor frame in grays:\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = frame_num * 2\n    filepath = os.path.join(frame_dir, frame)\n    try:\n        size = os.path.getsize(filepath)\n        sizes.append((frame_num, timestamp, size))\n    except:\n        pass\n\n# Find local minima\nlocal_minima = []\nfor i in range(1, len(sizes) - 1):\n    prev_size = sizes[i-1][2]\n    curr_size = sizes[i][2]\n    next_size = sizes[i+1][2]\n    \n    if curr_size < prev_size and curr_size < next_size:\n        if curr_size < (prev_size + next_size) / 2 * 0.9:\n            local_minima.append(sizes[i])\n\n# Sort by size (smallest first) and select top 29\ntop_29 = sorted(local_minima, key=lambda x: x[2])[:29]\n\n# Re-sort by timestamp\ntop_29.sort(key=lambda x: x[1])\n\nprint(\"Top 29 chapter boundaries (by size, re-sorted by time):\")\nprint(\"Frame | Timestamp | Size\")\nprint(\"-\" * 40)\n\nfor i, (frame_num, timestamp, size) in enumerate(top_29, 1):\n    print(f\"{i:2d}. Frame {frame_num:4d} | {timestamp:4d}s | {size}\")\nEOFPYTHON\n"]
