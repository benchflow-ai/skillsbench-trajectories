[154.880709, "i", "python3 << 'EOFPYTHON'\nimport os\nimport struct\n\n# Analyze detailed frames\nframe_dir = '/tmp'\nframes = sorted([f for f in os.listdir(frame_dir) if f.startswith('detailed_') and f.endswith('.png')])\n\nprint(f\"Total frames: {len(frames)}\")\nprint(f\"Frame duration: 2 seconds each\")\nprint(f\"Total video duration: {len(frames) * 2} seconds\")\nprint()\nprint(\"First 10 frames:\")\nfor i, frame in enumerate(frames[:10]):\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = frame_num * 2\n    print(f\"Frame {frame_num}: {timestamp}s\")\nEOFPYTHON\n"]
