[75.188251, "o", "\u001b[?2004hroot@e62527645085:~# "]
[90.083666, "i", "python3 << 'EOF'\nimport os\nimport struct\n\n# Get frame file sizes to identify potential title screens\nframe_dir = '/tmp'\nframes = sorted([f for f in os.listdir(frame_dir) if f.startswith('frame_') and f.endswith('.png')])\n\nfor frame in frames:\n    path = os.path.join(frame_dir, frame)\n    size = os.path.getsize(path)\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = (frame_num - 1) * 30\n    print(f\"{frame}: {size} bytes, timestamp: {timestamp}s\")\nEOF\n"]
