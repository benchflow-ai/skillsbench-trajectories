[195.100619, "i", "python3 << 'EOFPYTHON'\nimport os\nimport struct\n\n# Read PNG header to get image statistics\ndef analyze_png(filepath):\n    try:\n        with open(filepath, 'rb') as f:\n            data = f.read()\n            # PNG files start with specific bytes\n            if data[:8] != b'\\x89PNG\\r\\n\\x1a\\n':\n                return None\n            return len(data)\n    except:\n        return None\n\nframe_dir = '/tmp'\ngrays = sorted([f for f in os.listdir(frame_dir) if f.startswith('gray_') and f.endswith('.png')])\n\nprint(\"Analyzing grayscale frames...\")\nprint(\"Frame | Timestamp | Size\")\nprint(\"-\" * 40)\n\nsizes = []\nfor frame in grays[:50]:  # First 50 frames\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = frame_num * 2\n    filepath = os.path.join(frame_dir, frame)\n    size = analyze_png(filepath)\n    sizes.append((frame_num, timestamp, size))\n    if frame_num <= 10 or frame_num % 5 == 0:\n        print(f\"{frame_num:4d} | {timestamp:4d}s | {size}\")\n\nprint(\"\\n... (continuing analysis)\")\nEOFPYTHON\n"]
