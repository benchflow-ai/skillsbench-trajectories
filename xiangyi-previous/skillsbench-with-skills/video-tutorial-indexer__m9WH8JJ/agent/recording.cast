[202.979429, "i", "python3 << 'EOFPYTHON'\nimport os\n\nframe_dir = '/tmp'\ngrays = sorted([f for f in os.listdir(frame_dir) if f.startswith('gray_') and f.endswith('.png')])\n\nsizes = []\nfor frame in grays:\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = frame_num * 2\n    filepath = os.path.join(frame_dir, frame)\n    try:\n        size = os.path.getsize(filepath)\n        sizes.append((frame_num, timestamp, size))\n    except:\n        pass\n\n# Find frames with notably small sizes (potential title screens)\nall_sizes = [s[2] for s in sizes]\navg_size = sum(all_sizes) / len(all_sizes)\nstd_dev = (sum((x - avg_size) ** 2 for x in all_sizes) / len(all_sizes)) ** 0.5\n\nprint(f\"Average frame size: {avg_size:.0f} bytes\")\nprint(f\"Std deviation: {std_dev:.0f} bytes\")\nprint(f\"\\nFrames with notably small sizes (potential chapter titles):\")\nprint(\"Frame | Timestamp | Size\")\nprint(\"-\" * 40)\n\nsmall_frames = []\nfor frame_num, timestamp, size in sizes:\n    if size < avg_size - std_dev:  # Significantly smaller than average\n        small_frames.append((frame_num, timestamp, size))\n        print(f\"{frame_num:4d} | {timestamp:4d}s | {size}\")\n\nprint(f\"\\nTotal small frames found: {len(small_frames)}\")\nEOFPYTHON\n"]
