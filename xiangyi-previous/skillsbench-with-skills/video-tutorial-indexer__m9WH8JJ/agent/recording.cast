[210.987982, "i", "python3 << 'EOFPYTHON'\nimport os\n\nframe_dir = '/tmp'\ngrays = sorted([f for f in os.listdir(frame_dir) if f.startswith('gray_') and f.endswith('.png')])\n\nsizes = []\nfor frame in grays:\n    frame_num = int(frame.split('_')[1].split('.')[0])\n    timestamp = frame_num * 2\n    filepath = os.path.join(frame_dir, frame)\n    try:\n        size = os.path.getsize(filepath)\n        sizes.append((frame_num, timestamp, size))\n    except:\n        pass\n\n# Find frames with notably small sizes\nall_sizes = [s[2] for s in sizes]\navg_size = sum(all_sizes) / len(all_sizes)\nstd_dev = (sum((x - avg_size) ** 2 for x in all_sizes) / len(all_sizes)) ** 0.5\n\nsmall_frames = [(fn, ts, sz) for fn, ts, sz in sizes if sz < avg_size - std_dev]\n\n# Find clusters - frames that are close together\nclusters = []\ncurrent_cluster = [small_frames[0]]\n\nfor i in range(1, len(small_frames)):\n    if small_frames[i][0] - small_frames[i-1][0] <= 5:  # Within 5 frames (10 seconds)\n        current_cluster.append(small_frames[i])\n    else:\n        clusters.append(current_cluster)\n        current_cluster = [small_frames[i]]\nclusters.append(current_cluster)\n\nprint(f\"Found {len(clusters)} clusters of small frames\")\nprint(\"\\nCluster analysis:\")\nprint(\"Cluster | First Frame | Timestamp | Size\")\nprint(\"-\" * 50)\n\nfor i, cluster in enumerate(clusters):\n    first = cluster[0]\n    print(f\"{i+1:3d} | {first[0]:4d} | {first[1]:4d}s | {first[2]}\")\nEOFPYTHON\n"]
