[?2004l[?2004h>         sizes.append((frame_num, timestamp, size))
[?2004l[?2004h>     except:
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h> # Find local minima - frames that are smaller than their neighbors
