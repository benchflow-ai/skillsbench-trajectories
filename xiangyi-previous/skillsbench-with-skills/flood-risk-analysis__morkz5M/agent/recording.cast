[333.788857, "o", "            count_flooded += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.788974, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[333.789006, "o", ">         count_processed += 1\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.7891, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.789163, "o", "> "]
[333.789225, "o", "        print(f\"Error processing {station_id}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.78928, "o", "# 5. Output Results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.789353, "o", "print(f\"Finished processing. Found {count_flooded} flooded stations.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.789382, "o", "> "]
[333.789531, "o", "output_df = pd.DataFrame(flood_results)\r\n\u001b[?2004l\r"]
[333.789562, "o", "\u001b[?2004h> if not output_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.78961, "o", "    output_df = output_df[['station_id', 'flood_days']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.789713, "o", "> "]
[333.789815, "o", "    output_df.to_csv('/root/output/flood_results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.789904, "o", "    print(f\"Results written to /root/output/flood_results.csv with {len(output_df)} entries.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.789962, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.790016, "o", "    print(\"No flooding detected.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.79011, "o", "> "]
[333.790176, "o", "    with open('/root/output/flood_results.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.790207, "o", "        f.write('station_id,flood_days\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.790268, "o", "> EOF\r\n\u001b[?2004l\r"]
