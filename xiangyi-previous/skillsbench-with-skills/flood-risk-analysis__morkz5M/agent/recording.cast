[228.061116, "i", "cat << 'EOF' > debug_floods.py\nimport pandas as pd\nfrom dataretrieval import nwis\nimport requests\nimport io\n\nstations = ['04031000', '04036000', '04040000', '04040500', '04041500']\n\nprint(\"Fetching Thresholds...\")\nurl = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\nr = requests.get(url)\nnws_df = pd.read_csv(io.StringIO(r.text), on_bad_lines='skip')\nnws_df.columns = [c.lower().strip() for c in nws_df.columns]\n\nfor sid in stations:\n    print(f\"\\nChecking Station {sid}...\")\n    \n    # Check Threshold\n    row = nws_df[nws_df['usgs id'].astype(str).str.strip() == sid]\n    if row.empty:\n        print(\"  -> No NWS threshold found.\")\n        threshold = None\n    else:\n        val = row.iloc[0]['flood stage']\n        print(f\"  -> Threshold found: {val}\")\n        threshold = float(val) if pd.notna(val) and val != -9999 else None\n\n    # Fetch Data\n    try:\n        df, _ = nwis.get_iv(sites=sid, start='2025-04-01', end='2025-04-07', parameterCd='00065')\n        if df.empty:\n            print(\"  -> No data returned from USGS.\")\n        else:\n            gage_cols = [c for c in df.columns if '00065' in str(c) and '_cd' not in str(c)]\n            if gage_cols:\n                max_val = df[gage_cols[0]].max()\n                print(f\"  -> Max Value: {max_val}\")\n                if threshold:\n                    print(f\"  -> Flooding? {max_val >= threshold}\")\n            else:\n                print(\"  -> No gage height column found.\")\n    except Exception as e:\n        print(f\"  -> Error fetching data: {e}\")\nEOF\n"]
