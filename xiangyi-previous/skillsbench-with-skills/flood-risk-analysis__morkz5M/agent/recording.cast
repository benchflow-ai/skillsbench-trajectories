[311.670238, "o", "    for sid in stations:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.670414, "o", "        # Check if sid is in the usgs id column (converting to string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.670549, "o", "        match = df[df['usgs id'].astype(str).str.strip() == sid]\r\n\u001b[?2004l\r\u001b[?2004h"]
[311.670664, "o", "> "]
[311.67074, "o", "        if not match.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.670895, "o", "            print(f\"Station {sid}: Found! Flood Stage: {match.iloc[0]['flood stage']}\")\r\n\u001b[?2004l\r"]
[311.670982, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.671104, "o", "            print(f\"Station {sid}: Not Found\")\r\n\u001b[?2004l\r"]
[311.671262, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.671384, "o", "except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
