[254.559726, "i", "cat << 'EOF' > inspect_nws.py\nimport pandas as pd\nimport requests\nimport io\n\nprint(\"Fetching Thresholds...\")\nurl = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\nr = requests.get(url)\nnws_df = pd.read_csv(io.StringIO(r.text), on_bad_lines='skip')\nnws_df.columns = [c.lower().strip() for c in nws_df.columns]\n\nprint(\"\\nFirst 10 rows of 'usgs id' and 'flood stage':\")\nprint(nws_df[['usgs id', 'flood stage']].head(10))\n\nprint(\"\\nChecking for specific stations in NWS data:\")\nstations = ['04031000', '04036000', '04040000', '04040500', '04041500']\n\n# Convert column to string for comparison\nnws_ids = nws_df['usgs id'].astype(str).str.strip().tolist()\n\nfor sid in stations:\n    if sid in nws_ids:\n        print(f\"Station {sid} FOUND in NWS data.\")\n    else:\n        print(f\"Station {sid} NOT FOUND in NWS data.\")\n\n# Check if there are any IDs that look similar (e.g. without leading zero)\nprint(\"\\nChecking for IDs without leading zeros:\")\nfor sid in stations:\n    short_id = sid.lstrip('0')\n    if short_id in nws_ids:\n        print(f\"Station {short_id} (shortened) FOUND in NWS data.\")\n\nEOF\n"]
