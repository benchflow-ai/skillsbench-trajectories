[311.677746, "o", "root@c8089f4f311b:~# "]
[312.190167, "i", "python3 test_csv_read.py\n"]
[312.190405, "o", "python3 test_csv_read.py"]
[312.19057, "o", "\r\n\u001b[?2004l\r"]
[313.632869, "o", "Columns: ['location name', 'proximity', 'river/water-body name', 'nws shef id', 'location type', 'usgs id', 'latitude', 'longitude', 'wfo', 'rfc', 'state', 'county', 'wrr', 'timezone', 'inundation', 'elevation', 'action stage', 'flood stage', 'moderate flood stage', 'major flood stage', 'flood stage unit', 'coeid', 'hydrograph page', 'pedts', 'in service', 'hemisphere', 'low water threshold value / units', 'forecast status', 'display low water impacts', 'low flow display', 'give data attribution', 'attribution wording', 'fema wms', 'probabilistic site', 'weekly chance probabilistic enabled', 'short-term probabilistic enabled', 'chance of exceeding probabilistic enabled', 'nrldb vertical datum name', 'nrldb vertical datum', 'navd88 vertical datum', 'ngvd29 vertical datum', 'msl vertical datum', 'other vertical datum']\r\n\r\nFirst 5 rows of 'usgs id' and 'flood stage':\r\n"]
[313.640463, "o", "    usgs id  flood stage\r\n0       NaN       3207.0\r\n1  08158930         13.0\r\n2  15055500         33.5\r\n3       NaN      -9999.0\r\n4  02336300         17.0\r\n"]
[313.640652, "o", "\r\nChecking specific stations:\r\n"]
[313.647368, "o", "Station 04031000: Found! Flood Stage: 10.0\r\n"]
[313.654307, "o", "Station 04036000: Found! Flood Stage: 8.0\r\n"]
[313.864188, "o", "\u001b[?2004hroot@c8089f4f311b:~# "]
[333.741952, "i", "cat << 'EOF' > process_floods.py\nimport pandas as pd\nfrom dataretrieval import nwis\nimport requests\nimport io\nimport os\n\n# 1. Read Station IDs\nprint(\"Reading station IDs...\")\nwith open('/root/data/michigan_stations.txt', 'r') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\nprint(f\"Found {len(station_ids)} stations.\")\n\n# 2. Fetch Flood Thresholds\nprint(\"Fetching NWS flood thresholds...\")\nurl = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\ntry:\n    response = requests.get(url, timeout=30)\n    response.raise_for_status()\n    # Use index_col=False to prevent column shifting\n    nws_df = pd.read_csv(io.StringIO(response.text), on_bad_lines='skip', index_col=False)\nexcept Exception as e:\n    print(f\"Error fetching thresholds: {e}\")\n    exit(1)\n\n# 3. Create Threshold Dictionary\nprint(\"Processing thresholds...\")\nthresholds = {}\nnws_df.columns = [c.lower().strip() for c in nws_df.columns]\n\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row.get('usgs id', '')).strip()\n    flood_stage = row.get('flood stage')\n    \n    # Skip if usgs_id is 'nan' or empty\n    if usgs_id and usgs_id.lower() != 'nan' and pd.notna(flood_stage) and flood_stage != -9999:\n        try:\n            thresholds[usgs_id] = float(flood_stage)\n        except ValueError:\n            continue\n\nprint(f\"Loaded thresholds for {len(thresholds)} stations.\")\n\n# 4. Process Stations\nprint(\"Processing station data...\")\nflood_results = []\n\nstart_date = '2025-04-01'\nend_date = '2025-04-07'\n\ncount_processed = 0\ncount_flooded = 0\n\nfor i, station_id in enumerate(station_ids):\n    if i % 10 == 0:\n        print(f\"Processing {i}/{len(station_ids)}: {station_id}\")\n        \n    if station_id not in thresholds:\n        # print(f\"Skipping {station_id}: No threshold data\")\n        continue\n        \n    threshold = thresholds[station_id]\n    \n    try:\n        # Fetch IV data (00065 = Gage height)\n        df, _ = nwis.get_iv(\n            sites=station_id,\n            start=start_date,\n            end=end_date,\n            parameterCd='00065'\n        )\n        \n        if df.empty:\n            continue\n            \n        gage_cols = [c for c in df.columns if '00065' in str(c) and '_cd' not in str(c)]\n        \n        if not gage_cols:\n            continue\n            \n        gage_col = gage_cols[0]\n        \n        # Aggregate to daily max\n        daily_max = df[gage_col].resample('D').max()\n        \n        # Count flood days\n        days_above = int((daily_max >= threshold).sum())\n        \n        if days_above > 0:\n            print(f\"  -> FLOOD DETECTED at {station_id}: {days_above} days (Threshold: {threshold})\")\n            flood_results.append({\n                'station_id': station_id,\n                'flood_days': days_above\n            })\n            count_flooded += 1\n        \n        count_processed += 1\n            \n    except Exception as e:\n        print(f\"Error processing {station_id}: {e}\")\n\n# 5. Output Results\nprint(f\"Finished processing. Found {count_flooded} flooded stations.\")\noutput_df = pd.DataFrame(flood_results)\nif not output_df.empty:\n    output_df = output_df[['station_id', 'flood_days']]\n    output_df.to_csv('/root/output/flood_results.csv', index=False)\n    print(f\"Results written to /root/output/flood_results.csv with {len(output_df)} entries.\")\nelse:\n    print(\"No flooding detected.\")\n    with open('/root/output/flood_results.csv', 'w') as f:\n        f.write('station_id,flood_days\\n')\nEOF\n"]
[333.7476, "o", "cat << 'EOF' > process_floods.py"]
