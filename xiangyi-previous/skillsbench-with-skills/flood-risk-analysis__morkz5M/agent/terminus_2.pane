[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from dataretrieval import nwis
[?2004l[?2004h> import requests
[?2004l[?2004h> import io
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Read Station IDs
[?2004l[?2004h> print("Reading station IDs...")
[?2004l[?2004h> with open('/root/data/michigan_stations.txt', 'r') as f:
[?2004l[?2004h>     station_ids = [line.strip() for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(station_ids)} stations.")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Fetch Flood Thresholds
[?2004l[?2004h> print("Fetching NWS flood thresholds...")
[?2004l[?2004h> url = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"
[?2004l[?2004h> try:
[?2004l[?2004h>     response = requests.get(url, timeout=30)
[?2004l[?2004h>     response.raise_for_status()
[?2004l[?2004h>     # Use index_col=False to prevent column shifting
[?2004l[?2004h>     nws_df = pd.read_csv(io.StringIO(response.text), on_bad_lines='skip', index_col=False)
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f"Error fetching thresholds: {e}")
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Create Threshold Dictionary
[?2004l[?2004h> print("Processing thresholds...")
[?2004l[?2004h> thresholds = {}
[?2004l[?2004h> nws_df.columns = [c.lower().strip() for c in nws_df.columns]
[?2004l[?2004h> 
[?2004l[?2004h> for _, row in nws_df.iterrows():
[?2004l[?2004h>     usgs_id = str(row.get('usgs id', '')).strip()
[?2004l[?2004h>     flood_stage = row.get('flood stage')
[?2004l[?2004h>     
[?2004l[?2004h>     # Skip if usgs_id is 'nan' or empty
[?2004l[?2004h>     if usgs_id and usgs_id.lower() != 'nan' and pd.notna(flood_stage) and flood_stage != -9999:
[?2004l[?2004h>         try:
[?2004l[?2004h>             thresholds[usgs_id] = float(flood_stage)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Loaded thresholds for {len(thresholds)} stations.")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Process Stations
[?2004l[?2004h> print("Processing station data...")
[?2004l[?2004h> flood_results = []
[?2004l[?2004h> 
[?2004l[?2004h> start_date = '2025-04-01'
[?2004l[?2004h> end_date = '2025-04-07'
[?2004l[?2004h> 
[?2004l[?2004h> count_processed = 0
[?2004l[?2004h> count_flooded = 0
[?2004l[?2004h> 
[?2004l[?2004h> for i, station_id in enumerate(station_ids):
[?2004l[?2004h>     if i % 10 == 0:
[?2004l[?2004h>         print(f"Processing {i}/{len(station_ids)}: {station_id}")
[?2004l[?2004h>         
[?2004l[?2004h>     if station_id not in thresholds:
[?2004l[?2004h>         # print(f"Skipping {station_id}: No threshold data")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     threshold = thresholds[station_id]
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Fetch IV data (00065 = Gage height)
[?2004l[?2004h>         df, _ = nwis.get_iv(
[?2004l[?2004h>             sites=station_id,
[?2004l[?2004h>             start=start_date,
[?2004l[?2004h>             end=end_date,
[?2004l[?2004h>             parameterCd='00065'
[?2004l[?2004h>         )
[?2004l[?2004h>         
[?2004l[?2004h>         if df.empty:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         gage_cols = [c for c in df.columns if '00065' in str(c) and '_cd' not in str(c)]
[?2004l[?2004h>         
[?2004l[?2004h>         if not gage_cols:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         gage_col = gage_cols[0]
[?2004l[?2004h>         
[?2004l[?2004h>         # Aggregate to daily max
[?2004l[?2004h>         daily_max = df[gage_col].resample('D').max()
[?2004l[?2004h>         
[?2004l[?2004h>         # Count flood days
[?2004l[?2004h>         days_above = int((daily_max >= threshold).sum())
[?2004l[?2004h>         
[?2004l[?2004h>         if days_above > 0:
[?2004l[?2004h>             print(f"  -> FLOOD DETECTED at {station_id}: {days_above} days (Threshold: {threshold})")
[?2004l[?2004h>             flood_results.append({
[?2004l[?2004h>                 'station_id': station_id,
[?2004l[?2004h>                 'flood_days': days_above
[?2004l[?2004h>             })
[?2004l[?2004h>             count_flooded += 1
[?2004l[?2004h>         
[?2004l[?2004h>         count_processed += 1
[?2004l[?2004h>             
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error processing {station_id}: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Output Results
[?2004l[?2004h> print(f"Finished processing. Found {count_flooded} flooded stations.")
[?2004l[?2004h> output_df = pd.DataFrame(flood_results)
[?2004l[?2004h> if not output_df.empty:
[?2004l[?2004h>     output_df = output_df[['station_id', 'flood_days']]
[?2004l[?2004h>     output_df.to_csv('/root/output/flood_results.csv', index=False)
[?2004l[?2004h>     print(f"Results written to /root/output/flood_results.csv with {len(output_df)} entries.")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("No flooding detected.")
[?2004l[?2004h>     with open('/root/output/flood_results.csv', 'w') as f:
