\\t1954\\t2025\\t66\\t2008\\t2590\\t1954\\t70.0\\t391\\t90\\t103\\t181\\t196\\t279\\t411\\t497\\t796\\t1310'\r\n'USGS\\t04176000\\t00060\\t71356\\t\\t1\\t12\\t1954\\t2025\\t66\\t2020\\t2530\\t1963\\t75.0\\t402\\t92\\t108\\t179\\t195\\t278\\t424\\t498\\t845\\t1260'\r\n'USGS\\t04176000\\t00060\\t71356\\t\\t1\\t13\\t1954\\t2025\\t66\\t2020\\t3160\\t1964\\t70.0\\t432\\t94\\t108\\t172\\t192\\t284\\t425\\t551\\t1010\\t1430'\r\n'USGS\\t04176000\\t00060\\t71356\\t\\t1\\t14\\t1954\\t2025\\t66\\t2005\\t3260\\t1954\\t70.0\\t453\\t84\\t103\\t167\\t180\\t279\\t426\\t595\\t976\\t1900'\r\n"]
