[165.477745, "o", "{\r\n  \"name\": \"ns1:timeSeriesResponseType\",\r\n  \"declaredType\": \"org.cuahsi.waterml.TimeSeriesResponseType\",\r\n  \"scope\": \"javax.xml.bind.JAXBElement$GlobalScope\",\r\n  \"value\": {\r\n    \"queryInfo\": {\r\n      \"queryURL\": \"http://waterservices.usgs.gov/nwis/dv/format=json&sites=04176000&startDT=2025-04-01&endDT=2025-04-07&parameterCd=00060,00065&siteStatus=all\",\r\n      \"criteria\": {\r\n        \"locationParam\": \"[ALL:04176000]\",\r\n        \"variableParam\": \"[00060, 00065]\",\r\n        \"timeParam\": {\r\n          \"beginDateTime\": \"2025-04-01T00:00:00.000\",\r\n          \"endDateTime\": \"2025-04-07T00:00:00.000\"\r\n        },\r\n        \"parameter\": []\r\n      },\r\n      \"note\": [\r\n        {\r\n          \"value\": \"[ALL:04176000]\",\r\n          \"title\": \"filter:sites\"\r\n        },\r\n        {\r\n          \"value\": \"[mode=RANGE, modifiedSince=null] interval={INTERVAL[2025-04-01T00:00:00.000-04:00/2025-04-07T00:00:00.000-04:00]}\",\r\n          \"title\": \"filter:timeRange\"\r\n        },\r\n        {\r\n          \"value\": \"methodIds=[ALL]\",\r\n          \"title\": \"filter:methodId\"\r\n        },"]
