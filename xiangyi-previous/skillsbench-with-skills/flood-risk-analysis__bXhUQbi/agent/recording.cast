[183.879154, "i", "python3 -c \"\nimport requests\nimport json\n\nstation = '04176000'\nstart_date = '2025-04-01'\nend_date = '2025-04-07'\n\n# Check daily values - get full response\nurl = f'https://waterservices.usgs.gov/nwis/dv/?format=json&sites={station}&startDT={start_date}&endDT={end_date}&parameterCd=00060,00065&siteStatus=all'\nresp = requests.get(url, timeout=30)\ndata = resp.json()\n\nif 'value' in data and 'timeSeries' in data['value']:\n    for ts in data['value']['timeSeries']:\n        var_name = ts.get('variable', {}).get('variableName', 'Unknown')\n        var_code = ts.get('variable', {}).get('variableCode', [{}])[0].get('value', '')\n        print(f'Variable: {var_name} (code: {var_code})')\n        values = ts.get('values', [{}])[0].get('value', [])\n        for v in values:\n            print(f'  {v}')\nelse:\n    print('No timeSeries found')\n\"\n"]
[183.879914, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> station = '04176000'\r\n\u001b[?2004l\r\u001b[?2004h> start_date = '2025-04-01'\r\n\u001b[?2004l\r"]
[183.88004, "o", "\u001b[?2004h> end_date = '2025-04-07'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
