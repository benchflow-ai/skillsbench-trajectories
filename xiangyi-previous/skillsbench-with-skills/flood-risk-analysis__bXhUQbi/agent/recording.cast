[304.992302, "o", "April 1-7 thresholds (month=4):\r\nDay | p90 | p95 | max\r\n1   | 1430 | 1700 | 2070\r\n2   | 1330 | 1580 | 2360\r\n3   | 1360 | 1610 | 2090\r\n4   | 1420 | 1820 | 3220\r\n5   | 1490 | 1680 | 2500\r\n6   | 1450 | 1680 | 1840\r\n7   | 1440 | 1790 | 2310\r\n"]
