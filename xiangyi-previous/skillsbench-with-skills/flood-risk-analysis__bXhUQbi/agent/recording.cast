[209.122031, "o", "Flood Stage Response:\r\n<html>\r\n<head></head>\r\n<body>\r\n<div style=\"border: 3px solid #4991C5; font:1.5em; font-family:tahoma,calibri,arial; font-weight:bold; color:#0A4369; padding:5px; margin:10px; text-align:center\">\r\nThe requested service is no longer available. </br>\r\n</br>\r\nPlease visit <a href='https://waterservices.usgs.gov/'>USGS Data Services</a> for downloading any USGS Data and check <a href='https://waterdata.usgs.gov/blog/'>https://waterdata.usgs.gov/blog/</a> for updates to water data analysis in the future.\r\n</div>\r\n</body>\r\n</html>\r\n\r\n"]
