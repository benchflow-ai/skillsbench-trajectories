[220.065466, "i", "python3 -c \"\nimport requests\nimport json\n\nstation = '04176000'\n\n# Try NWS AHPS - need to find the NWS location ID\n# First check USGS site info for more details\nurl = f'https://waterservices.usgs.gov/nwis/site/?format=rdb&sites={station}&siteOutput=expanded'\nresp = requests.get(url, timeout=30)\nprint('Site Info:')\nprint(resp.text[:3000])\n\"\n"]
[220.067623, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> station = '04176000'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try NWS AHPS - need to find the NWS location ID\r\n\u001b[?2004l\r\u001b[?2004h> # First check USGS site info for more details\r\n\u001b[?2004l\r\u001b[?2004h> url = f'https://waterservices.usgs.gov/nwis/site/?format=rdb&sites={station}&siteOutput=expanded'\r\n\u001b[?2004l\r\u001b[?2004h> resp = requests.get(url, timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h> print('Site Info:')\r\n\u001b[?2004l\r\u001b[?2004h> print(resp.text[:3000])\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
