[304.373569, "i", "python3 -c \"\nimport requests\n\nstation = '04176000'\n\nurl = f'https://waterservices.usgs.gov/nwis/stat/?format=rdb&sites={station}&statReportType=daily&statTypeCd=all&parameterCd=00060'\nresp = requests.get(url, timeout=30)\nlines = resp.text.split('\\n')\n\n# Get April 1-7 data\nprint('April 1-7 thresholds (month=4):')\nprint('Day | p90 | p95 | max')\nfor line in lines:\n    if not line.startswith('USGS'):\n        continue\n    parts = line.split('\\t')\n    if len(parts) >= 24:\n        month = parts[5]\n        day = parts[6]\n        if month == '4' and day in ['1','2','3','4','5','6','7']:\n            max_val = parts[11]\n            p90 = parts[22]\n            p95 = parts[23]\n            print(f'{day}   | {p90} | {p95} | {max_val}')\n\"\n"]
[304.374855, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> station = '04176000'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> url = f'https://waterservices.usgs.gov/nwis/stat/?format=rdb&sites={station}&statReportType=daily&statTypeCd=all&parameterCd=00060'\r\n\u001b[?2004l\r\u001b[?2004h> resp = requests.get(url, timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h> lines = resp.text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get April 1-7 data\r\n\u001b[?2004l\r\u001b[?2004h> print('April 1-7 thresholds (month=4):')\r\n\u001b[?2004l\r\u001b[?2004h> print('Day | p90 | p95 | max')\r\n\u001b[?2004l\r\u001b[?2004h> for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
