[259.042427, "i", "python3 -c \"\nimport requests\n\nstation = '04176000'\n\n# Get full stats\nurl = f'https://waterservices.usgs.gov/nwis/stat/?format=rdb&sites={station}&statReportType=daily&statTypeCd=all&parameterCd=00060'\nresp = requests.get(url, timeout=30)\nlines = resp.text.split('\\n')\n\n# Find and print data lines for April 1-7\nfor line in lines:\n    if line.startswith('USGS') and '\\t4\\t' in line:  # April data\n        parts = line.split('\\t')\n        if len(parts) > 3:\n            day = parts[3] if len(parts) > 3 else ''\n            if day in ['1','2','3','4','5','6','7']:\n                print(line)\n\"\n"]
