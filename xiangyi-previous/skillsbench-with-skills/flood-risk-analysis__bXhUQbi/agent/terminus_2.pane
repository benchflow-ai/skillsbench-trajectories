[?2004l[?2004h> import requests
[?2004l[?2004h> import csv
[?2004l[?2004h> from datetime import datetime, timedelta
[?2004l[?2004h> 
[?2004l[?2004h> # Read station IDs
[?2004l[?2004h> with open('/root/data/michigan_stations.txt', 'r') as f:
[?2004l[?2004h>     stations = [line.strip() for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Processing {len(stations)} stations...")
[?2004l[?2004h> 
[?2004l[?2004h> # Date range: April 1-7, 2025
[?2004l[?2004h> start_date = "2025-04-01"
[?2004l[?2004h> end_date = "2025-04-07"
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for i, station_id in enumerate(stations):
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Get daily values (discharge) from USGS
[?2004l[?2004h>         # Parameter 00060 = Discharge (cubic feet per second)
[?2004l[?2004h>         # Parameter 00065 = Gage height (feet)
[?2004l[?2004h>         url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={station_id}&startDT={start_date}&endDT={end_date}&parameterCd=00060,00065&siteStatus=all"
[?2004l[?2004h>         
[?2004l[?2004h>         resp = requests.get(url, timeout=30)
[?2004l[?2004h>         data = resp.json()
[?2004l[?2004h>         
[?2004l[?2004h>         # Get flood stage from NWIS flood service
[?2004l[?2004h>         flood_url = f"https://waterwatch.usgs.gov/webservices/floodstage?format=json&site={station_id}"
[?2004l[?2004h>         flood_resp = requests.get(flood_url, timeout=30)
[?2004l[?2004h>         
[?2004l[?2004h>         flood_stage = None
[?2004l[?2004h>         try:
[?2004l[?2004h>             flood_data = flood_resp.json()
[?2004l[?2004h>             if 'sites' in flood_data and len(flood_data['sites']) > 0:
[?2004l[?2004h>                 site_info = flood_data['sites'][0]
[?2004l[?2004h>                 if 'flood_stage' in site_info:
[?2004l[?2004h>                     flood_stage = float(site_info['flood_stage'])
[?2004l[?2004h>         except:
[?2004l[?2004h>             pass
[?2004l[?2004h>         
[?2004l[?2004h>         flood_days = 0
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if we have time series data
[?2004l[?2004h>         if 'value' in data and 'timeSeries' in data['value']:
[?2004l[?2004h>             for ts in data['value']['timeSeries']:
[?2004l[?2004h>                 var_code = ts.get('variable', {}).get('variableCode', [{}])[0].get('value', '')
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Check gage height against flood stage
[?2004l[?2004h>                 if var_code == '00065' and flood_stage is not None:
[?2004l[?2004h>                     values = ts.get('values', [{}])[0].get('value', [])
[?2004l[?2004h>                     for val in values:
[?2004l[?2004h>                         try:
[?2004l[?2004h>                             gage_height = float(val['value'])
[?2004l[?2004h>                             if gage_height >= flood_stage:
[?2004l[?2004h>                                 flood_days += 1
[?2004l[?2004h>                         except:
[?2004l[?2004h>                             pass
[?2004l[?2004h>         
[?2004l[?2004h>         if flood_days > 0:
[?2004l[?2004h>             results.append({'station_id': station_id, 'flood_days': flood_days})
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: {flood_days} flood days")
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: No flooding")
[?2004l[?2004h>             
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"[{i+1}/{len(stations)}] Station {station_id}: Error - {str(e)[:50]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/output/flood_results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.DictWriter(f, fieldnames=['station_id', 'flood_days'])
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     writer.writerows(results)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nDone! Found {len(results)} stations with flooding.")
[?2004l[?2004h> print(f"Results saved to /root/output/flood_results.csv")
[?2004l[?2004h> EOF
