[?2004l[?2004h> import requests
[?2004l[?2004h> import csv
[?2004l[?2004h> import time
[?2004l[?2004h> 
[?2004l[?2004h> # Read station IDs
[?2004l[?2004h> with open('/root/data/michigan_stations.txt', 'r') as f:
[?2004l[?2004h>     stations = [line.strip() for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Processing {len(stations)} stations...")
[?2004l[?2004h> 
[?2004l[?2004h> start_date = "2025-04-01"
[?2004l[?2004h> end_date = "2025-04-07"
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for i, station_id in enumerate(stations):
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Get daily values for April 1-7, 2025
[?2004l[?2004h>         dv_url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={station_id}&startDT={start_date}&endDT={end_date}&parameterCd=00060&siteStatus=all"
[?2004l[?2004h>         dv_resp = requests.get(dv_url, timeout=30)
[?2004l[?2004h>         dv_data = dv_resp.json()
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract daily discharge values
[?2004l[?2004h>         daily_values = {}  # {day: value}
[?2004l[?2004h>         if 'value' in dv_data and 'timeSeries' in dv_data['value'] and len(dv_data['value']['timeSeries']) > 0:
[?2004l[?2004h>             ts = dv_data['value']['timeSeries'][0]
[?2004l[?2004h>             values = ts.get('values', [{}])[0].get('value', [])
[?2004l[?2004h>             for v in values:
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     date_str = v['dateTime'][:10]  # YYYY-MM-DD
[?2004l[?2004h>                     day = int(date_str.split('-')[2])
[?2004l[?2004h>                     flow = float(v['value'])
[?2004l[?2004h>                     daily_values[day] = flow
[?2004l[?2004h>                 except:
[?2004l[?2004h>                     pass
[?2004l[?2004h>         
[?2004l[?2004h>         if not daily_values:
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: No discharge data")
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Get historical statistics for p90 thresholds
[?2004l[?2004h>         stat_url = f"https://waterservices.usgs.gov/nwis/stat/?format=rdb&sites={station_id}&statReportType=daily&statTypeCd=all&parameterCd=00060"
[?2004l[?2004h>         stat_resp = requests.get(stat_url, timeout=30)
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse statistics to get April 1-7 p90 values
[?2004l[?2004h>         p90_thresholds = {}  # {day: p90_value}
[?2004l[?2004h>         for line in stat_resp.text.split('\n'):
[?2004l[?2004h>             if not line.startswith('USGS'):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             parts = line.split('\t')
[?2004l[?2004h>             if len(parts) >= 23:
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     month = int(parts[5])
[?2004l[?2004h>                     day = int(parts[6])
[?2004l[?2004h>                     if month == 4 and 1 <= day <= 7:
[?2004l[?2004h>                         p90 = float(parts[22]) if parts[22] else None
[?2004l[?2004h>                         if p90:
[?2004l[?2004h>                             p90_thresholds[day] = p90
[?2004l[?2004h>                 except:
[?2004l[?2004h>                     pass
[?2004l[?2004h>         
[?2004l[?2004h>         if not p90_thresholds:
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: No threshold data")
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Count flood days
[?2004l[?2004h>         flood_days = 0
[?2004l[?2004h>         for day in range(1, 8):
[?2004l[?2004h>             if day in daily_values and day in p90_thresholds:
[?2004l[?2004h>                 if daily_values[day] >= p90_thresholds[day]:
[?2004l[?2004h>                     flood_days += 1
[?2004l[?2004h>         
[?2004l[?2004h>         if flood_days > 0:
[?2004l[?2004h>             results.append({'station_id': station_id, 'flood_days': flood_days})
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: {flood_days} flood days")
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f"[{i+1}/{len(stations)}] Station {station_id}: No flooding")
[?2004l[?2004h>         
[?2004l[?2004h>         # Small delay to be nice to the API
[?2004l[?2004h>         time.sleep(0.1)
[?2004l[?2004h>         
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"[{i+1}/{len(stations)}] Station {station_id}: Error - {str(e)[:50]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/output/flood_results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.DictWriter(f, fieldnames=['station_id', 'flood_days'])
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     writer.writerows(results)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nDone! Found {len(results)} stations with flooding.")
[?2004l[?2004h> print(f"Results saved to /root/output/flood_results.csv")
