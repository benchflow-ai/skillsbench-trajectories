[90.409769, "o", "        .data(stockData)\r\n\u001b[?2004l\r"]
[90.409788, "o", "\u001b[?2004h> "]
[90.409874, "o", "        .enter()\r\n\u001b[?2004l\r"]
[90.409896, "o", "\u001b[?2004h> "]
[90.409938, "o", "        .append('circle')\r\n\u001b[?2004l\r"]
[90.409968, "o", "\u001b[?2004h> "]
[90.410069, "o", "        .attr('class', 'bubble')\r\n\u001b[?2004l\r"]
[90.410092, "o", "\u001b[?2004h> "]
