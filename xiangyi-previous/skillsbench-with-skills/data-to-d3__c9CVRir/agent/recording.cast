[90.41977, "o", "\u001b[?2004h> "]
[90.419816, "o", "    d3.selectAll('.bubble')\r\n\u001b[?2004l\r"]
[90.419863, "o", "\u001b[?2004h> "]
[90.42001, "o", "        .attr('stroke', d => d.ticker === ticker ? '#ff6b6b' : '#fff')\r\n\u001b[?2004l\r"]
[90.420075, "o", "\u001b[?2004h> "]
[90.420221, "o", "        .attr('stroke-width', d => d.ticker === ticker ? 3 : 1.5);\r\n\u001b[?2004l\r"]
[90.420266, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
