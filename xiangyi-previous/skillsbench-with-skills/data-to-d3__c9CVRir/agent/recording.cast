[90.40616, "o", "\u001b[?2004h> "]
[90.406454, "o", "    const cols = Math.ceil(Math.sqrt(numSectors));\r\n\u001b[?2004l\r"]
[90.406474, "o", "\u001b[?2004h> "]
[90.40668, "o", "    sectors.forEach((sector, i) => {\r\n\u001b[?2004l\r"]
[90.40674, "o", "\u001b[?2004h> "]
[90.406871, "o", "        const col = i % cols;\r\n\u001b[?2004l\r"]
[90.406934, "o", "\u001b[?2004h> "]
[90.40715, "o", "        const row = Math.floor(i / cols);\r\n\u001b[?2004l\r"]
[90.40717, "o", "\u001b[?2004h> "]
[90.407378, "o", "        sectorPositions[sector] = {\r\n\u001b[?2004l\r"]
[90.407401, "o", "\u001b[?2004h> "]
[90.40765, "o", "            x: (col + 0.5) * (width / cols),\r\n\u001b[?2004l\r"]
[90.407709, "o", "\u001b[?2004h> "]
[90.408038, "o", "            y: (row + 0.5) * (height / Math.ceil(numSectors / cols))\r\n\u001b[?2004l\r"]
[90.408092, "o", "\u001b[?2004h> "]
[90.408143, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.408169, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.408216, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.408297, "o", "    // Create force simulation\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.408329, "o", "> "]
[90.408441, "o", "    const simulation = d3.forceSimulation(stockData)\r\n\u001b[?2004l\r"]
[90.408472, "o", "\u001b[?2004h> "]
[90.408617, "o", "        .force('charge', d3.forceManyBody().strength(5))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.408805, "o", "        .force('x', d3.forceX(d => sectorPositions[d.sector].x).strength(0.3))\r\n\u001b[?2004l\r"]
[90.408851, "o", "\u001b[?2004h> "]
[90.409021, "o", "        .force('y', d3.forceY(d => sectorPositions[d.sector].y).strength(0.3))\r\n\u001b[?2004l\r"]
[90.409073, "o", "\u001b[?2004h> "]
[90.409196, "o", "        .force('collide', d3.forceCollide(d => d.radius + 2))\r\n\u001b[?2004l\r"]
[90.409225, "o", "\u001b[?2004h> "]
[90.40941, "o", "        .force('center', d3.forceCenter(width / 2, height / 2).strength(0.05));\r\n\u001b[?2004l\r"]
[90.409459, "o", "\u001b[?2004h> "]
[90.409478, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
