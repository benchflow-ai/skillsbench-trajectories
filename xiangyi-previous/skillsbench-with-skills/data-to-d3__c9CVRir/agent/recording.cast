[90.421006, "o", "\u001b[?2004h> "]
[90.421272, "o", "    const highlightedRow = d3.select(`#stock-table tbody tr[data-ticker=\"${ticker}\"]`).node();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.42132, "o", "    if (highlightedRow) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.421349, "o", "> "]
