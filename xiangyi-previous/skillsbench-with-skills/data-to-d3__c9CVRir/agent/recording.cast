[90.411651, "o", "\u001b[?2004h> "]
[90.411704, "o", "                `)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.411856, "o", "                .style('left', (event.pageX + 10) + 'px')\r\n\u001b[?2004l\r"]
[90.411904, "o", "\u001b[?2004h> "]
[90.412017, "o", "                .style('top', (event.pageY - 10) + 'px')\r\n\u001b[?2004l\r"]
[90.412068, "o", "\u001b[?2004h> "]
