[90.419531, "o", "function selectStock(ticker) {\r\n\u001b[?2004l\r"]
[90.419553, "o", "\u001b[?2004h> "]
[90.419602, "o", "    selectedTicker = ticker;\r\n\u001b[?2004l\r"]
[90.419631, "o", "\u001b[?2004h> "]
[90.41966, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
