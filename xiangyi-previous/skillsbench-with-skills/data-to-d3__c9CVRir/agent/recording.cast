[90.420464, "o", "    d3.selectAll('#stock-table tbody tr')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.420607, "o", "        .classed('highlighted', function() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.420772, "o", "            return d3.select(this).attr('data-ticker') === ticker;\r\n\u001b[?2004l\r"]
[90.420798, "o", "\u001b[?2004h> "]
[90.420822, "o", "        });\r\n\u001b[?2004l\r"]
