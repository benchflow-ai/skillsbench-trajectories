[?2004hroot@5761c977c3d0:/app# cat <<EOF > solve_tasks.py
[?2004l[?2004h> import jax
[?2004l[?2004h> import jax.numpy as jnp
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Enable x64 to match numpy default precision if needed
[?2004l[?2004h> jax.config.update("jax_enable_x64", True)
[?2004l[?2004h> 
[?2004l[?2004h> def task_basic_reduce():
[?2004l[?2004h>     print("Running task: basic_reduce")
[?2004l[?2004h>     x = jnp.load("data/x.npy")
[?2004l[?2004h>     # Mean of each row
[?2004l[?2004h>     result = jnp.mean(x, axis=1)
[?2004l[?2004h>     np.save("basic_reduce.npy", result)
[?2004l[?2004h> 
[?2004l[?2004h> def task_map_square():
[?2004l[?2004h>     print("Running task: map_square")
[?2004l[?2004h>     x = jnp.load("data/x.npy")
[?2004l[?2004h>     # Square each element
[?2004l[?2004h>     result = jnp.square(x)
[?2004l[?2004h>     np.save("map_square.npy", result)
[?2004l[?2004h> 
[?2004l[?2004h> def task_grad_logistic():
[?2004l[?2004h>     print("Running task: grad_logistic")
[?2004l[?2004h>     data = np.load("data/logistic.npz")
[?2004l[?2004h>     x = jnp.array(data['x'])
[?2004l[?2004h>     y = jnp.array(data['y'])
[?2004l[?2004h>     w = jnp.array(data['w'])
[?2004l[?2004h> 
[?2004l[?2004h>     def loss_fn(w, x, y):
[?2004l[?2004h>         logits = jnp.dot(x, w)
[?2004l[?2004h>         # Logistic loss for labels {-1, 1}
[?2004l[?2004h>         # loss = log(1 + exp(-y * logits))
[?2004l[?2004h>         return jnp.mean(jnp.log1p(jnp.exp(-y * logits)))
[?2004l[?2004h> 
[?2004l[?2004h>     grad_fn = jax.grad(loss_fn)
[?2004l[?2004h>     grads = grad_fn(w, x, y)
[?2004l[?2004h>     np.save("grad_logistic.npy", grads)
[?2004l[?2004h> 
[?2004l[?2004h> def task_scan_rnn():
[?2004l[?2004h>     print("Running task: scan_rnn")
[?2004l[?2004h>     data = np.load("data/seq.npz")
[?2004l[?2004h>     seq = jnp.array(data['seq'])
[?2004l[?2004h>     init = jnp.array(data['init'])
[?2004l[?2004h>     Wx = jnp.array(data['Wx'])
[?2004l[?2004h>     Wh = jnp.array(data['Wh'])
[?2004l[?2004h>     b = jnp.array(data['b'])
[?2004l[?2004h> 
[?2004l[?2004h>     def step_fn(h_prev, x_t):
[?2004l[?2004h>         # h_t = tanh(Wx @ x_t + Wh @ h_prev + b)
[?2004l[?2004h>         h_new = jnp.tanh(jnp.dot(Wx, x_t) + jnp.dot(Wh, h_prev) + b)
[?2004l[?2004h>         return h_new, h_new
[?2004l[?2004h> 
[?2004l[?2004h>     final_h, states = jax.lax.scan(step_fn, init, seq)
[?2004l[?2004h>     np.save("scan_rnn.npy", states)
[?2004l[?2004h> 
[?2004l[?2004h> def task_jit_mlp():
[?2004l[?2004h>     print("Running task: jit_mlp")
[?2004l[?2004h>     data = np.load("data/mlp.npz")
[?2004l[?2004h>     X = jnp.array(data['X'])
[?2004l[?2004h>     W1 = jnp.array(data['W1'])
[?2004l[?2004h>     b1 = jnp.array(data['b1'])
[?2004l[?2004h>     W2 = jnp.array(data['W2'])
[?2004l[?2004h>     b2 = jnp.array(data['b2'])
[?2004l[?2004h> 
[?2004l[?2004h>     def mlp(X, W1, b1, W2, b2):
[?2004l[?2004h>         # Layer 1: ReLU(X @ W1 + b1)
[?2004l[?2004h>         h = jax.nn.relu(jnp.dot(X, W1) + b1)
[?2004l[?2004h>         # Layer 2: h @ W2 + b2
[?2004l[?2004h>         out = jnp.dot(h, W2) + b2
[?2004l[?2004h>         return out
[?2004l[?2004h> 
[?2004l[?2004h>     jit_mlp_fn = jax.jit(mlp)
[?2004l[?2004h>     result = jit_mlp_fn(X, W1, b1, W2, b2)
[?2004l[?2004h>     # Ensure execution by converting to numpy (blocks until ready)
[?2004l[?2004h>     np.save("jit_mlp.npy", result)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     try:
[?2004l[?2004h>         task_basic_reduce()
[?2004l[?2004h>         task_map_square()
[?2004l[?2004h>         task_grad_logistic()
[?2004l[?2004h>         task_scan_rnn()
[?2004l[?2004h>         task_jit_mlp()
[?2004l[?2004h>         print("All tasks completed.")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"An error occurred: {e}")
