[?2004l[?2004h>         traceback.print_exc()
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal picks: {len(all_picks)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to DataFrame
[?2004l[?2004h> picks_df = pd.DataFrame(all_picks)
[?2004l[?2004h> if len(picks_df) > 0:
[?2004l[?2004h>     picks_df['time_utc'] = picks_df['time'].apply(lambda x: UTCDateTime(x))
[?2004l[?2004h>     picks_df = picks_df.sort_values('time')
[?2004l[?2004h>     print("\nFirst 30 picks:")
[?2004l[?2004h>     print(picks_df.head(30))
[?2004l[?2004h> 
[?2004l[?2004h> # Velocity model
[?2004l[?2004h> vp = 6.0  # km/s
[?2004l[?2004h> vs = vp / 1.75
[?2004l[?2004h> 
[?2004l[?2004h> def associate_events(picks_df, time_window=15.0, min_picks=4):
[?2004l[?2004h>     """Associate picks into events using time-based clustering"""
[?2004l[?2004h>     if len(picks_df) == 0:
[?2004l[?2004h>         return []
[?2004l[?2004h>     
[?2004l[?2004h>     events = []
[?2004l[?2004h>     picks_used = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by time
[?2004l[?2004h>     picks_sorted = picks_df.sort_values('time').reset_index(drop=True)
[?2004l[?2004h>     
[?2004l[?2004h>     for i, pick in picks_sorted.iterrows():
[?2004l[?2004h>         if i in picks_used:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Find all picks within time window
[?2004l[?2004h>         pick_time = UTCDateTime(pick['time'])
[?2004l[?2004h>         
[?2004l[?2004h>         cluster_picks = []
[?2004l[?2004h>         cluster_indices = []
[?2004l[?2004h>         
[?2004l[?2004h>         for j, other_pick in picks_sorted.iterrows():
[?2004l[?2004h>             if j in picks_used:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             other_time = UTCDateTime(other_pick['time'])
[?2004l[?2004h>             if abs(other_time - pick_time) <= time_window:
[?2004l[?2004h>                 cluster_picks.append(other_pick)
[?2004l[?2004h>                 cluster_indices.append(j)
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if we have enough picks from different stations
[?2004l[?2004h>         if len(cluster_picks) >= min_picks:
[?2004l[?2004h>             stations_in_cluster = set([p['station'] for p in cluster_picks])
[?2004l[?2004h>             if len(stations_in_cluster) >= 3:  # At least 3 stations
[?2004l[?2004h>                 # Mark picks as used
[?2004l[?2004h>                 for idx in cluster_indices:
[?2004l[?2004h>                     picks_used.add(idx)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Estimate event time from P picks
[?2004l[?2004h>                 p_picks = [p for p in cluster_picks if p['phase'] == 'P']
[?2004l[?2004h>                 if len(p_picks) > 0:
[?2004l[?2004h>                     earliest_p = min([UTCDateTime(p['time']) for p in p_picks])
[?2004l[?2004h>                     events.append({
[?2004l[?2004h>                         'time': earliest_p,
[?2004l[?2004h>                         'n_picks': len(cluster_picks),
[?2004l[?2004h>                         'n_stations': len(stations_in_cluster)
[?2004l[?2004h>                     })
[?2004l[?2004h>     
[?2004l[?2004h>     return events
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAssociating picks into events...")
[?2004l[?2004h> events = associate_events(picks_df, time_window=20.0, min_picks=4)
[?2004l[?2004h> print(f"Found {len(events)} events")
[?2004l[?2004h> 
[?2004l[?2004h> if len(events) < 3:
[?2004l[?2004h>     print("Trying alternative association with relaxed parameters...")
[?2004l[?2004h>     events = associate_events(picks_df, time_window=30.0, min_picks=3)
[?2004l[?2004h>     print(f"Found {len(events)} events with relaxed parameters")
[?2004l[?2004h> 
[?2004l[?2004h> # Create output DataFrame
[?2004l[?2004h> if len(events) > 0:
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for event in events:
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': event['time'].strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],
[?2004l[?2004h>             'n_picks': event['n_picks'],
[?2004l[?2004h>             'n_stations': event['n_stations']
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     results_df = pd.DataFrame(results)
[?2004l[?2004h>     results_df['time_utc'] = pd.to_datetime(results_df['time'])
[?2004l[?2004h>     results_df = results_df.sort_values('time_utc')
[?2004l[?2004h>     
