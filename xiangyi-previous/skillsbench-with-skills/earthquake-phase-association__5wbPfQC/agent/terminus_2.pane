[?2004l[?2004h>     station_streams[key].append(tr)
[?2004l[?2004h> 
[?2004l[?2004h> # Pick phases for each station
[?2004l[?2004h> print("Picking phases...")
[?2004l[?2004h> all_picks = []
[?2004l[?2004h> 
[?2004l[?2004h> for station_key, station_st in station_streams.items():
[?2004l[?2004h>     print(f"  Processing {station_key} ({len(station_st)} traces)...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by channel to get consistent ordering (E, N, Z)
[?2004l[?2004h>     station_st.sort(keys=['channel'])
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Use SeisBench classify function - FIXED API
[?2004l[?2004h>         classify_output = model.classify(station_st, P_threshold=0.3, S_threshold=0.3)
[?2004l[?2004h>         picks = classify_output.picks  # Access picks via .picks attribute
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"    Found {len(picks)} picks")
[?2004l[?2004h>         
[?2004l[?2004h>         for pick in picks:
[?2004l[?2004h>             all_picks.append({
[?2004l[?2004h>                 'station': station_key,
[?2004l[?2004h>                 'phase': pick.phase,
[?2004l[?2004h>                 'time': pick.peak_time,
[?2004l[?2004h>                 'prob': pick.peak_value
[?2004l[?2004h>             })
[?2004l[?2004h>             
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"    Error processing {station_key}: {e}")
