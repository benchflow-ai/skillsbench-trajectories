[?2004l[?2004h> 
[?2004le[?2004h> print("Loading data...")
[?2004l[?2004h> st = obspy.read('/root/data/wave.mseed')
[?2004l[?2004h> stations_df = pd.read_csv('/root/data/stations.csv')
[?2004l[?2004h> 
[?2004l[?2004h> station_locs = stations_df.groupby(['network', 'station']).agg({
[?2004l[?2004h>     'longitude': 'first', 'latitude': 'first', 'elevation_m': 'first'
[?2004l[?2004h> }).reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> station_coords = {}
[?2004l[?2004h> for _, row in station_locs.iterrows():
[?2004l[?2004h>     key = f"{row['network']}.{row['station']}"
[?2004l[?2004h>     station_coords[key] = (row['latitude'], row['longitude'], row['elevation_m'])
[?2004l[?2004h> 
[?2004l[?2004h> center_lat = station_locs['latitude'].mean()
[?2004l[?2004h> center_lon = station_locs['longitude'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading PhaseNet...")
[?2004l[?2004h> model = sbm.PhaseNet.from_pretrained('instance')
[?2004l[?2004h> model.eval()
[?2004l[?2004h> 
[?2004l[?2004h> station_streams = defaultdict(obspy.Stream)
[?2004l[?2004h> for tr in st:
[?2004l[?2004h>     key = f"{tr.stats.network}.{tr.stats.station}"
[?2004l[?2004h>     station_streams[key].append(tr)
[?2004l[?2004h> 
[?2004l[?2004h> print("Picking phases...")
[?2004l[?2004h> all_picks = []
[?2004l[?2004h> for station_key, station_st in station_streams.items():
[?2004l[?2004h>     station_st.sort(keys=['channel'])
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Use moderate threshold
[?2004l[?2004h>         output = model.classify(station_st, P_threshold=0.4, S_threshold=0.4)
[?2004l[?2004h>         for pick in output.picks:
[?2004l[?2004h>             all_picks.append({
[?2004l[?2004h>                 'station': station_key,
[?2004l[?2004h>                 'phase': pick.phase,
[?2004l[?2004h>                 'time': pick.peak_time,
[?2004l[?2004h>                 'prob': pick.peak_value
[?2004l[?2004h>             })
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total picks: {len(all_picks)}")
[?2004l[?2004h> picks_df = pd.DataFrame(all_picks)
[?2004l[?2004h> picks_df['time_sec'] = picks_df['time'].apply(lambda x: UTCDateTime(x).timestamp)
[?2004l[?2004h> picks_df = picks_df.sort_values('time_sec').reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> vp = 6.0
[?2004l[?2004h> vs = vp / 1.75
[?2004l[?2004h> 
[?2004l[?2004h> def haversine_km(lat1, lon1, lat2, lon2):
[?2004l[?2004h>     R = 6371
[?2004l[?2004h>     lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
[?2004l[?2004h>     dlat, dlon = lat2 - lat1, lon2 - lon1
[?2004l[?2004h>     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[?2004l[?2004h>     return R * 2 * np.arcsin(np.sqrt(a))
[?2004l[?2004h> 
[?2004l[?2004h> station_dist = {}
[?2004l[?2004h> for sta, (lat, lon, elev) in station_coords.items():
[?2004l[?2004h>     station_dist[sta] = haversine_km(center_lat, center_lon, lat, lon)
[?2004l[?2004h> 
[?2004l[?2004h> max_dist = max(station_dist.values())
[?2004l[?2004h> max_travel_time = max_dist / vp
[?2004l[?2004h> 
[?2004l[?2004h> from scipy.cluster.hierarchy import fcluster, linkage
[?2004l[?2004h> 
[?2004l[?2004h> p_picks = picks_df[picks_df['phase'] == 'P'].copy()
[?2004l[?2004h> print(f"P picks: {len(p_picks)}")
[?2004l[?2004h> 
[?2004l[?2004h> if len(p_picks) > 1:
[?2004l[?2004h>     times = p_picks['time_sec'].values.reshape(-1, 1)
[?2004l[?2004h>     Z = linkage(times, method='single')
[?2004l[?2004h>     # Use travel time window for clustering
[?2004l[?2004h>     cluster_labels = fcluster(Z, t=max_travel_time + 2, criterion='distance')
[?2004l[?2004h>     p_picks['cluster'] = cluster_labels
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Clusters: {len(set(cluster_labels))}")
[?2004l[?2004h>     
[?2004l[?2004h>     events = []
[?2004l[?2004h>     for cluster_id in set(cluster_labels):
[?2004l[?2004h>         cluster = p_picks[p_picks['cluster'] == cluster_id]
[?2004l[?2004h>         n_stations = cluster['station'].nunique()
[?2004l[?2004h>         avg_prob = cluster['prob'].mean()
[?2004l[?2004h>         
[?2004l[?2004h>         # Accept events with 4+ stations, or 3 stations with high probability
[?2004l[?2004h>         if n_stations >= 4 or (n_stations >= 3 and avg_prob >= 0.7):
[?2004l[?2004h>             earliest_p_time = cluster['time_sec'].min()
[?2004l[?2004h>             earliest_station = cluster.loc[cluster['time_sec'].idxmin(), 'station']
[?2004l[?2004h>             est_dist = station_dist.get(earliest_station, 30)
[?2004l[?2004h>             origin_time = earliest_p_time - est_dist / vp
[?2004l[?2004h>             
[?2004l[?2004h>             events.append({
[?2004l[?2004h>                 'origin_time': origin_time,
[?2004l[?2004h>                 'n_stations': n_stations,
[?2004l[?2004h>                 'n_picks': len(cluster),
[?2004l[?2004h>                 'avg_prob': avg_prob
[?2004l[?2004h>             })
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Events before dedup: {len(events)}")
[?2004l[?2004h> 
