[1148.390208, "o", "\u001b[?2004hroot@5c6359148b36:~# "]
[1186.524711, "i", "cat > /root/solve_final.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import UTCDateTime\nimport seisbench.models as sbm\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = obspy.read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nstation_locs = stations_df.groupby(['network', 'station']).agg({\n    'longitude': 'first', 'latitude': 'first', 'elevation_m': 'first'\n}).reset_index()\n\nstation_coords = {}\nfor _, row in station_locs.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    station_coords[key] = (row['latitude'], row['longitude'], row['elevation_m'])\n\ncenter_lat = station_locs['latitude'].mean()\ncenter_lon = station_locs['longitude'].mean()\n\nprint(\"Loading PhaseNet...\")\nmodel = sbm.PhaseNet.from_pretrained('instance')\nmodel.eval()\n\nstation_streams = defaultdict(obspy.Stream)\nfor tr in st:\n    key = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[key].append(tr)\n\nprint(\"Picking phases...\")\nall_picks = []\nfor station_key, station_st in station_streams.items():\n    station_st.sort(keys=['channel'])\n    try:\n        # Use moderate threshold\n        output = model.classify(station_st, P_threshold=0.4, S_threshold=0.4)\n        for pick in output.picks:\n            all_picks.append({\n                'station': station_key,\n                'phase': pick.phase,\n                'time': pick.peak_time,\n                'prob': pick.peak_value\n            })\n    except Exception as e:\n        continue\n\nprint(f\"Total picks: {len(all_picks)}\")\npicks_df = pd.DataFrame(all_picks)\npicks_df['time_sec'] = picks_df['time'].apply(lambda x: UTCDateTime(x).timestamp)\npicks_df = picks_df.sort_values('time_sec').reset_index(drop=True)\n\nvp = 6.0\nvs = vp / 1.75\n\ndef haversine_km(lat1, lon1, lat2, lon2):\n    R = 6371\n    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n    dlat, dlon = lat2 - lat1, lon2 - lon1\n    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\n    return R * 2 * np.arcsin(np.sqrt(a))\n\nstation_dist = {}\nfor sta, (lat, lon, elev) in station_coords.items():\n    station_dist[sta] = haversine_km(center_lat, center_lon, lat, lon)\n\nmax_dist = max(station_dist.values())\nmax_travel_time = max_dist / vp\n\nfrom scipy.cluster.hierarchy import fcluster, linkage\n\np_picks = picks_df[picks_df['phase'] == 'P'].copy()\nprint(f\"P picks: {len(p_picks)}\")\n\nif len(p_picks) > 1:\n    times = p_picks['time_sec'].values.reshape(-1, 1)\n    Z = linkage(times, method='single')\n    # Use travel time window for clustering\n    cluster_labels = fcluster(Z, t=max_travel_time + 2, criterion='distance')\n    p_picks['cluster'] = cluster_labels\n    \n    print(f\"Clusters: {len(set(cluster_labels))}\")\n    \n    events = []\n    for cluster_id in set(cluster_labels):\n        cluster = p_picks[p_picks['cluster'] == cluster_id]\n        n_stations = cluster['station'].nunique()\n        avg_prob = cluster['prob'].mean()\n        \n        # Accept events with 4+ stations, or 3 stations with high probability\n        if n_stations >= 4 or (n_stations >= 3 and avg_prob >= 0.7):\n            earliest_p_time = cluster['time_sec'].min()\n            earliest_station = cluster.loc[cluster['time_sec'].idxmin(), 'station']\n            est_dist = station_dist.get(earliest_station, 30)\n            origin_time = earliest_p_time - est_dist / vp\n            \n            events.append({\n                'origin_time': origin_time,\n                'n_stations': n_stations,\n                'n_picks': len(cluster),\n                'avg_prob': avg_prob\n            })\n    \n    print(f\"Events before dedup: {len(events)}\")\n\n# Deduplicate\nevents = sorted(events, key=lambda x: x['origin_time'])\nfinal_events = []\nlast_time = None\nfor event in events:\n    if last_time is None or (event['origin_time'] - last_time) > 5:\n        final_events.append(event)\n        last_time = event['origin_time']\n\nprint(f\"Final events: {len(final_events)}\")\n\nresults = []\nfor e in final_events:\n    t = UTCDateTime(e['origin_time'])\n    res"]
[1186.52488, "i", "ults.append({\n        'time': t.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\n        'n_stations': e['n_stations'],\n        'n_picks': e['n_picks']\n    })\n\nfinal_df = pd.DataFrame(results)\nprint(final_df.to_string())\nfinal_df.to_csv('/root/results.csv', index=False)\nprint(f\"\\nSaved {len(final_df)} events to /root/results.csv\")\nEOF\n"]
