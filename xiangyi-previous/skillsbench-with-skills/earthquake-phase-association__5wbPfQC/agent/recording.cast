[1186.53907, "o", "    t = UTCDateTime(e['origin_time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1186.539158, "o", "    results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1186.539286, "o", "        'time': t.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\r\n\u001b[?2004l\r"]
[1186.539369, "o", "\u001b[?2004h> "]
[1186.539451, "o", "        'n_stations': e['n_stations'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1186.53953, "o", "        'n_picks': e['n_picks']\r\n\u001b[?2004l\r"]
[1186.539633, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1186.539733, "o", "final_df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[1186.539802, "o", "\u001b[?2004h> "]
[1186.539834, "o", "print(final_df.to_string())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1186.539972, "o", "final_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[1186.540001, "o", "\u001b[?2004h> "]
