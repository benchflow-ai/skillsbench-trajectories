[802.292264, "o", "        # Require at least 5 stations for more confidence\r\n\u001b[?2004l\r"]
[802.29232, "o", "\u001b[?2004h> "]
[802.292376, "o", "        if n_stations >= 5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.292428, "o", "> "]
[802.292483, "o", "            earliest_p_time = cluster_picks['time_sec'].min()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.292634, "o", "            earliest_station = cluster_picks.loc[cluster_picks['time_sec'].idxmin(), 'station']\r\n\u001b[?2004l\r"]
[802.29269, "o", "\u001b[?2004h> "]
[802.292764, "o", "            est_dist = station_dist.get(earliest_station, 30)\r\n\u001b[?2004l\r"]
[802.292821, "o", "\u001b[?2004h> "]
[802.292881, "o", "            origin_time = earliest_p_time - est_dist / vp\r\n\u001b[?2004l\r"]
[802.292936, "o", "\u001b[?2004h> "]
[802.292993, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.293048, "o", "            events.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.293151, "o", "                'origin_time': origin_time,\r\n\u001b[?2004l\r"]
[802.293208, "o", "\u001b[?2004h> "]
[802.293283, "o", "                'n_stations': n_stations,\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.293339, "o", "> "]
[802.29341, "o", "                'n_picks': len(cluster_picks)\r\n\u001b[?2004l\r"]
[802.293468, "o", "\u001b[?2004h> "]
[802.293526, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.293581, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.293666, "o", "    print(f\"Events with >= 5 stations: {len(events)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.293706, "o", "> else:\r\n\u001b[?2004l\r"]
[802.293779, "o", "\u001b[?2004h> "]
[802.293805, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[802.293868, "o", "> # Deduplicate\r\n\u001b[?2004l\r"]
[802.293925, "o", "\u001b[?2004h> "]
[802.293983, "o", "events = sorted(events, key=lambda x: x['origin_time'])\r\n\u001b[?2004l\r"]
[802.294039, "o", "\u001b[?2004h> "]
[802.294097, "o", "final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.294155, "o", "last_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.294209, "o", "for event in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.294343, "o", "    if last_time is None or (event['origin_time'] - last_time) > 5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.294405, "o", "> "]
[802.294462, "o", "        final_events.append(event)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.294564, "o", "        last_time = event['origin_time']\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.294622, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[802.29468, "o", "> "]
[802.294704, "o", "print(f\"Final events: {len(final_events)}\")\r\n\u001b[?2004l\r"]
[802.29473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[802.294823, "o", "\u001b[?2004h> "]
[802.294847, "o", "if len(final_events) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.295034, "o", "    results = [{'time': UTCDateTime(e['origin_time']).strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.295091, "o", "> "]
[802.295245, "o", "                'n_stations': e['n_stations'], 'n_picks': e['n_picks']} for e in final_events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.295335, "o", "    final_df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[802.295385, "o", "\u001b[?2004h> "]
[802.29544, "o", "    print(final_df.to_string())\r\n\u001b[?2004l\r"]
[802.295464, "o", "\u001b[?2004h> "]
[802.295537, "o", "else:\r\n\u001b[?2004l\r"]
[802.295562, "o", "\u001b[?2004h> "]
[802.295616, "o", "    final_df = pd.DataFrame(columns=['time'])\r\n\u001b[?2004l\r"]
[802.295643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[802.295714, "o", "\u001b[?2004h> "]
[802.295793, "o", "final_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[802.295852, "o", "> "]
[802.295914, "o", "print(f\"\\nSaved to /root/results.csv\")\r\n\u001b[?2004l\r"]
[802.295956, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[802.298834, "o", "\u001b[?2004hroot@5c6359148b36:~# "]
