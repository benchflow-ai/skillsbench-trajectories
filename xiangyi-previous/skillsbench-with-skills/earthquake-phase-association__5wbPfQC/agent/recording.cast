[346.092957, "o", "                cluster_indices.append(j)\r\n\u001b[?2004l\r"]
[346.093063, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.093214, "o", "        # Check if we have enough picks from different stations\r\n\u001b[?2004l\r\u001b[?2004h>         if len(cluster_picks) >= min_picks:\r\n\u001b[?2004l\r"]
[346.093309, "o", "\u001b[?2004h> "]
[346.093373, "o", "            stations_in_cluster = set([p['station'] for p in cluster_picks])\r\n\u001b[?2004l\r"]
[346.09342, "o", "\u001b[?2004h> "]
[346.093516, "o", "            if len(stations_in_cluster) >= 3:  # At least 3 stations\r\n\u001b[?2004l\r"]
[346.093545, "o", "\u001b[?2004h> "]
[346.093613, "o", "                # Mark picks as used\r\n\u001b[?2004l\r"]
[346.093661, "o", "\u001b[?2004h> "]
[346.093732, "o", "                for idx in cluster_indices:\r\n\u001b[?2004l\r"]
[346.093798, "o", "\u001b[?2004h> "]
[346.093839, "o", "                    picks_used.add(idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.093882, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.093965, "o", "                # Estimate event time from P picks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094101, "o", "                p_picks = [p for p in cluster_picks if p['phase'] == 'P']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094161, "o", "                if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.094188, "o", "> "]
[346.09431, "o", "                    earliest_p = min([UTCDateTime(p['time']) for p in p_picks])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094368, "o", "                    events.append({\r\n\u001b[?2004l\r"]
[346.094419, "o", "\u001b[?2004h> "]
[346.094468, "o", "                        'time': earliest_p,\r\n\u001b[?2004l\r"]
[346.094523, "o", "\u001b[?2004h> "]
[346.094575, "o", "                        'n_picks': len(cluster_picks),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094673, "o", "                        'n_stations': len(stations_in_cluster)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094726, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094756, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.094831, "o", "    return events\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.09489, "o", "print(\"\\nAssociating picks into events...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095005, "o", "events = associate_events(picks_df, time_window=20.0, min_picks=4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095075, "o", "print(f\"Found {len(events)} events\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.095104, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095167, "o", "if len(events) < 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.09528, "o", "    print(\"Trying alternative association with relaxed parameters...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095385, "o", "    events = associate_events(picks_df, time_window=30.0, min_picks=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095496, "o", "    print(f\"Found {len(events)} events with relaxed parameters\")\r\n\u001b[?2004l\r"]
[346.095544, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095592, "o", "# Create output DataFrame\r\n\u001b[?2004l\r"]
[346.09564, "o", "\u001b[?2004h> if len(events) > 0:\r\n\u001b[?2004l\r"]
[346.095688, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.095735, "o", ">     for event in events:\r\n\u001b[?2004l\r"]
[346.095762, "o", "\u001b[?2004h> "]
[346.09581, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.095908, "o", "            'time': event['time'].strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.095961, "o", "> "]
[346.096014, "o", "            'n_picks': event['n_picks'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.096073, "o", "> "]
[346.0961, "o", "            'n_stations': event['n_stations']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096128, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[346.096184, "o", "\u001b[?2004h> "]
[346.096219, "o", "    results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096389, "o", "    results_df['time_utc'] = pd.to_datetime(results_df['time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096445, "o", "    results_df = results_df.sort_values('time_utc')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[346.096549, "o", "\u001b[?2004h> "]
[346.096595, "o", "    # Deduplicate events within 5 seconds\r\n\u001b[?2004l\r\u001b[?2004h>     final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096694, "o", "    last_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096795, "o", "    for _, row in results_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096857, "o", "        if last_time is None or (row['time_utc'] - last_time).total_seconds() > 5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096921, "o", "            final_events.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.096974, "o", "            last_time = row['time_utc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097035, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.097087, "o", "> "]
[346.09713, "o", "    final_df = pd.DataFrame(final_events)[['time', 'n_picks', 'n_stations']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097256, "o", "    print(f\"\\nFinal events after deduplication: {len(final_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097309, "o", "    print(final_df)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097357, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097402, "o", "    final_df = pd.DataFrame(columns=['time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097651, "o", "    print(\"No events found!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save results\r\n\u001b[?2004l\r\u001b[?2004h> final_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.097783, "o", "print(f\"\\nResults saved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[346.097844, "o", "\u001b[?2004l\r"]
