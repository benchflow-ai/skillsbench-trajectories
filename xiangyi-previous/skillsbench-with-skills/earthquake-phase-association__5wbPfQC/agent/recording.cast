[56.273557, "o", "> "]
[56.273583, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.273612, "o", "            \r\n\u001b[?2004l\r"]
[56.273682, "o", "\u001b[?2004h> "]
[56.273732, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.273859, "o", "        print(f\"    Error processing {station_key}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.273886, "o", "> "]
[56.273938, "o", "        continue\r\n\u001b[?2004l\r_\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.273964, "o", "> "]
[56.274033, "o", "print(f\"Total picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.274081, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[56.27413, "o", "# Convert to DataFrame\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.274181, "o", "> "]
[56.274226, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r"]
[56.274251, "o", "\u001b[?2004h> "]
[56.274314, "o", "if len(picks_df) > 0:\r\n\u001b[?2004l\rd\u001b[?2004h"]
[56.274338, "o", "> "]
[56.274479, "o", "    picks_df['time_utc'] = picks_df['time'].apply(lambda x: UTCDateTime(x))\r\n\u001b[?2004l\r"]
[56.274505, "o", "\u001b[?2004h> "]
[56.274576, "o", "    picks_df = picks_df.sort_values('time')\r\n\u001b[?2004l\rev\u001b[?2004h"]
[56.274617, "o", "> "]
[56.274657, "o", "    print(picks_df.head(20))\r\n\u001b[?2004l\rs\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.274686, "o", "\u001b[?2004h> "]
[56.274793, "o", "# Simple event association based on clustering picks in time\r\n\u001b[?2004l\r"]
[56.274819, "o", "\u001b[?2004h> "]
[56.274904, "o", "# Use velocity model: vp = 6 km/s, vs = vp/1.75\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.274953, "o", "> vp = 6.0  # km/s\r\n\u001b[?2004l\r"]
[56.275003, "o", "\u001b[?2004h> vs = vp / 1.75\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.275052, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.2751, "o", "def haversine_km(lat1, lon1, lat2, lon2):\r\n\u001b[?2004l\r"]
[56.27515, "o", "\u001b[?2004h> "]
[56.275201, "o", "    \"\"\"Calculate distance between two points in km\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275248, "o", "    R = 6371  # Earth radius in km\r\n\u001b[?2004l\r"]
[56.275304, "o", "\u001b[?2004h> "]
[56.275379, "o", "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.275406, "o", "> "]
[56.275454, "o", "    dlat = lat2 - lat1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275505, "o", "    dlon = lon2 - lon1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275618, "o", "    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275673, "o", "    c = 2 * np.arcsin(np.sqrt(a))\r\n\u001b[?2004l\r"]
[56.27572, "o", "\u001b[?2004h>     return R * c\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.275773, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275844, "o", "# Event association using a simple time-based clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.275962, "o", "# For a regional network, P waves from same event should arrive within ~30s\r\n\u001b[?2004l\r"]
[56.276013, "o", "\u001b[?2004h> "]
[56.276063, "o", "# depending on network size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.276112, "o", "\u001b[?2004h> "]
[56.276156, "o", "def associate_events(picks_df, time_window=15.0, min_picks=4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276269, "o", "    \"\"\"Associate picks into events using time-based clustering\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.276319, "o", "> "]
[56.276346, "o", "    if len(picks_df) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276371, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.276417, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276466, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276493, "o", "    picks_used = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276589, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276639, "o", "    # Sort by time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276683, "o", "    picks_sorted = picks_df.sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276733, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276788, "o", "    for i, pick in picks_sorted.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.276836, "o", "> "]
[56.276879, "o", "        if i in picks_used:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276904, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.276949, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277007, "o", "        # Find all picks within time window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277086, "o", "        pick_time = UTCDateTime(pick['time'])\r\n\u001b[?2004l\r"]
[56.277136, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[56.277162, "o", "\u001b[?2004h> "]
[56.277209, "o", "        cluster_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277277, "o", "        cluster_indices = []\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277372, "o", "        for j, other_pick in picks_sorted.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277432, "o", "            if j in picks_used:\r\n\u001b[?2004l\r"]
[56.277478, "o", "\u001b[?2004h> "]
[56.277532, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277594, "o", "            other_time = UTCDateTime(other_pick['time'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.277641, "o", "> "]
[56.277717, "o", "            if abs(other_time - pick_time) <= time_window:\r\n\u001b[?2004l\r"]
[56.277768, "o", "\u001b[?2004h> "]
[56.277818, "o", "                cluster_picks.append(other_pick)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.277868, "o", "> "]
[56.277896, "o", "                cluster_indices.append(j)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.277921, "o", "        \r\n\u001b[?2004l\r"]
[56.277986, "o", "\u001b[?2004h> "]
[56.27805, "o", "        # Check if we have enough picks from different stations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.278118, "o", "        if len(cluster_picks) >= min_picks:\r\n\u001b[?2004l\r"]
[56.278172, "o", "\u001b[?2004h> "]
[56.278255, "o", "            stations_in_cluster = set([p['station'] for p in cluster_picks])\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.278304, "o", "> "]
[56.278375, "o", "            if len(stations_in_cluster) >= 3:  # At least 3 stations\r\n\u001b[?2004l\r"]
[56.278423, "o", "\u001b[?2004h> "]
[56.278472, "o", "                # Mark picks as used\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.278521, "o", "> "]
[56.278585, "o", "                for idx in cluster_indices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.278633, "o", "                    picks_used.add(idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.278684, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.278748, "o", "                # Estimate event time from P picks\r\n\u001b[?2004l\r"]
[56.278796, "o", "\u001b[?2004h> "]
[56.278877, "o", "                p_picks = [p for p in cluster_picks if p['phase'] == 'P']\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.278924, "o", "> "]
[56.278975, "o", "                if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279098, "o", "                    # Event time is approximately the earliest P pick minus travel time\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.279154, "o", "> "]
[56.279209, "o", "                    # For simplicity, use earliest P pick as proxy\r\n\u001b[?2004l\r"]
[56.27926, "o", "\u001b[?2004h> "]
[56.27937, "o", "                    earliest_p = min([UTCDateTime(p['time']) for p in p_picks])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279416, "o", "                    events.append({\r\n\u001b[?2004l\r"]
[56.279464, "o", "\u001b[?2004h> "]
[56.279519, "o", "                        'time': earliest_p,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279602, "o", "                        'n_picks': len(cluster_picks),\r\n\u001b[?2004l\r"]
[56.27965, "o", "\u001b[?2004h> "]
[56.279723, "o", "                        'n_stations': len(stations_in_cluster)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279768, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279823, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.279875, "o", "    return events\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.279927, "o", "> "]
[56.279979, "o", "print(\"\\nAssociating picks into events...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280063, "o", "events = associate_events(picks_df, time_window=20.0, min_picks=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.280111, "o", "> "]
[56.280167, "o", "print(f\"Found {len(events)} events\")\r\n\u001b[?2004l\r"]
[56.280222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280307, "o", "# If simple association didn't work well, try alternative approach\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280361, "o", "if len(events) < 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280461, "o", "    print(\"Trying alternative association with relaxed parameters...\")\r\n\u001b[?2004l\r"]
[56.280517, "o", "\u001b[?2004h> "]
[56.280584, "o", "    events = associate_events(picks_df, time_window=30.0, min_picks=3)\r\n\u001b[?2004l\r"]
[56.280632, "o", "\u001b[?2004h> "]
[56.280697, "o", "    print(f\"Found {len(events)} events with relaxed parameters\")\r\n\u001b[?2004l\r"]
[56.280751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280803, "o", "# Create output DataFrame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280847, "o", "if len(events) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.280894, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.280923, "o", "> "]
[56.280972, "o", "    for event in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281026, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281113, "o", "            'time': event['time'].strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281177, "o", "            'n_picks': event['n_picks'],\r\n\u001b[?2004l\r"]
[56.281233, "o", "\u001b[?2004h> "]
[56.281279, "o", "            'n_stations': event['n_stations']\r\n\u001b[?2004l\r"]
[56.28133, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[56.281379, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281423, "o", "    results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281514, "o", "    # Remove duplicate events (within 5 seconds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281618, "o", "    results_df['time_utc'] = pd.to_datetime(results_df['time'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.281667, "o", "> "]
[56.281734, "o", "    results_df = results_df.sort_values('time_utc')\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.281781, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.28183, "o", "    # Deduplicate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281875, "o", "    final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.28192, "o", "    last_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.281975, "o", "    for _, row in results_df.iterrows():\r\n\u001b[?2004l\r"]
[56.282027, "o", "\u001b[?2004h> "]
[56.282131, "o", "        if last_time is None or (row['time_utc'] - last_time).total_seconds() > 5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.282191, "o", "            final_events.append(row)\r\n\u001b[?2004l\r"]
[56.282241, "o", "\u001b[?2004h> "]
[56.282291, "o", "            last_time = row['time_utc']\r\n\u001b[?2004l\r"]
[56.28234, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.28244, "o", "    final_df = pd.DataFrame(final_events)[['time', 'n_picks', 'n_stations']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.282489, "o", "> "]
[56.282553, "o", "    print(f\"\\nFinal events after deduplication: {len(final_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.282606, "o", ">     print(final_df)\r\n\u001b[?2004l\r"]
[56.282657, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.282718, "o", "    final_df = pd.DataFrame(columns=['time'])\r\n\u001b[?2004l\r"]
[56.282766, "o", "\u001b[?2004h> "]
[56.282818, "o", "    print(\"No events found!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[56.282847, "o", "\u001b[?2004l\r\u001b[?2004h> # Save results\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.282896, "o", "> "]
[56.282957, "o", "final_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.283031, "o", "print(f\"\\nResults saved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.28308, "o", "> EOF\r\n\u001b[?2004l\r"]
