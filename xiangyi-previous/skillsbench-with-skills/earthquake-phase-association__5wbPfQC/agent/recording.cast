[575.982633, "i", "cat > /root/solve3.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import UTCDateTime\nimport seisbench.models as sbm\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading waveform data...\")\nst = obspy.read('/root/data/wave.mseed')\nprint(f\"Loaded {len(st)} traces\")\n\n# Load station data\nprint(\"Loading station data...\")\nstations_df = pd.read_csv('/root/data/stations.csv')\n\n# Get unique stations with their locations\nstation_locs = stations_df.groupby(['network', 'station']).agg({\n    'longitude': 'first',\n    'latitude': 'first',\n    'elevation_m': 'first'\n}).reset_index()\nprint(f\"Unique stations: {len(station_locs)}\")\n\n# Create station location dict\nstation_coords = {}\nfor _, row in station_locs.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    station_coords[key] = (row['latitude'], row['longitude'], row['elevation_m'])\n\n# Compute network center for rough distance estimates\ncenter_lat = station_locs['latitude'].mean()\ncenter_lon = station_locs['longitude'].mean()\nprint(f\"Network center: {center_lat:.2f}, {center_lon:.2f}\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = sbm.PhaseNet.from_pretrained('instance')\nmodel.eval()\n\n# Group traces by station\nprint(\"Grouping traces by station...\")\nstation_streams = defaultdict(obspy.Stream)\nfor tr in st:\n    key = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[key].append(tr)\n\n# Pick phases with higher thresholds\nprint(\"Picking phases (P_threshold=0.5, S_threshold=0.5)...\")\nall_picks = []\n\nfor station_key, station_st in station_streams.items():\n    station_st.sort(keys=['channel'])\n    \n    try:\n        classify_output = model.classify(station_st, P_threshold=0.5, S_threshold=0.5)\n        picks = classify_output.picks\n        \n        for pick in picks:\n            all_picks.append({\n                'station': station_key,\n                'phase': pick.phase,\n                'time': pick.peak_time,\n                'prob': pick.peak_value\n            })\n            \n    except Exception as e:\n        print(f\"  Error processing {station_key}: {e}\")\n        continue\n\nprint(f\"Total picks: {len(all_picks)}\")\n\n# Convert to DataFrame\npicks_df = pd.DataFrame(all_picks)\nif len(picks_df) == 0:\n    print(\"No picks found!\")\n    pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\n    exit()\n\npicks_df['time_sec'] = picks_df['time'].apply(lambda x: UTCDateTime(x).timestamp)\npicks_df = picks_df.sort_values('time_sec').reset_index(drop=True)\n\nprint(f\"P picks: {len(picks_df[picks_df['phase']=='P'])}\")\nprint(f\"S picks: {len(picks_df[picks_df['phase']=='S'])}\")\n\n# Velocity model\nvp = 6.0  # km/s\nvs = vp / 1.75  # ~3.43 km/s\n\ndef haversine_km(lat1, lon1, lat2, lon2):\n    R = 6371\n    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n    dlat = lat2 - lat1\n    dlon = lon2 - lon1\n    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\n    c = 2 * np.arcsin(np.sqrt(a))\n    return R * c\n\n# Compute distances from network center to each station\nstation_dist = {}\nfor sta, (lat, lon, elev) in station_coords.items():\n    station_dist[sta] = haversine_km(center_lat, center_lon, lat, lon)\n\nmax_dist = max(station_dist.values())\nprint(f\"Max station distance from center: {max_dist:.1f} km\")\n\n# Maximum P-wave travel time across network\nmax_travel_time = max_dist / vp\nprint(f\"Max P-wave travel time: {max_travel_time:.1f} s\")\n\n# Association using DBSCAN-like clustering on P picks\nfrom scipy.cluster.hierarchy import fcluster, linkage\n\n# Focus on P picks for initial event detection\np_picks = picks_df[picks_df['phase'] == 'P'].copy()\nprint(f\"\\nUsing {len(p_picks)} P picks for association\")\n\n# Cluster P picks by time\nif len(p_picks) > 1:\n    times = p_picks['time_sec'].values.reshape(-1, 1)\n    \n    # Use hierarchical clustering with time-based distance\n    Z = linkage(times, method='single')\n    \n    # Cut tree at max_travel_time (picks from same event should be within this window)\n    cluster_labels = fcluster(Z, t=max_travel_time + 5,"]
[575.982709, "i", " criterion='distance')\n    p_picks['cluster'] = cluster_labels\n    \n    print(f\"Found {len(set(cluster_labels))} initial clusters\")\n    \n    # Filter clusters by minimum number of stations\n    events = []\n    for cluster_id in set(cluster_labels):\n        cluster_picks = p_picks[p_picks['cluster'] == cluster_id]\n        n_stations = cluster_picks['station'].nunique()\n        \n        if n_stations >= 4:  # Require at least 4 stations\n            # Estimate origin time: earliest P pick minus average travel time\n            earliest_p_time = cluster_picks['time_sec'].min()\n            earliest_station = cluster_picks.loc[cluster_picks['time_sec'].idxmin(), 'station']\n            \n            # Estimate distance to source (rough approximation)\n            # Use the station distance as proxy\n            est_dist = station_dist.get(earliest_station, 30)  # default 30 km\n            travel_time = est_dist / vp\n            \n            origin_time = earliest_p_time - travel_time\n            \n            events.append({\n                'origin_time': origin_time,\n                'earliest_p': earliest_p_time,\n                'n_stations': n_stations,\n                'n_picks': len(cluster_picks)\n            })\n    \n    print(f\"Events with >= 4 stations: {len(events)}\")\nelse:\n    events = []\n\n# Sort events by time and deduplicate (within 5 seconds)\nevents = sorted(events, key=lambda x: x['origin_time'])\n\nfinal_events = []\nlast_time = None\nfor event in events:\n    if last_time is None or (event['origin_time'] - last_time) > 5:\n        final_events.append(event)\n        last_time = event['origin_time']\n\nprint(f\"Final events after deduplication: {len(final_events)}\")\n\n# Create output\nif len(final_events) > 0:\n    results = []\n    for event in final_events:\n        t = UTCDateTime(event['origin_time'])\n        results.append({\n            'time': t.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\n            'n_stations': event['n_stations'],\n            'n_picks': event['n_picks']\n        })\n    \n    final_df = pd.DataFrame(results)\n    print(\"\\nDetected events:\")\n    print(final_df.to_string())\nelse:\n    final_df = pd.DataFrame(columns=['time'])\n    print(\"No events found!\")\n\nfinal_df.to_csv('/root/results.csv', index=False)\nprint(f\"\\nResults saved to /root/results.csv\")\nEOF\n"]
