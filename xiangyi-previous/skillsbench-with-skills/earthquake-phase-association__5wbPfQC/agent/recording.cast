[20.196482, "o", "\u001b[?2004hroot@5c6359148b36:~# "]
[56.266973, "i", "cat > /root/solve.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import UTCDateTime\nimport seisbench.models as sbm\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading waveform data...\")\nst = obspy.read('/root/data/wave.mseed')\nprint(f\"Loaded {len(st)} traces\")\n\n# Load station data\nprint(\"Loading station data...\")\nstations_df = pd.read_csv('/root/data/stations.csv')\nprint(f\"Loaded {len(stations_df)} station channels\")\n\n# Get unique stations with their locations\nstation_locs = stations_df.groupby(['network', 'station']).agg({\n    'longitude': 'first',\n    'latitude': 'first',\n    'elevation_m': 'first'\n}).reset_index()\nprint(f\"Unique stations: {len(station_locs)}\")\n\n# Create station location dict\nstation_coords = {}\nfor _, row in station_locs.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    station_coords[key] = (row['latitude'], row['longitude'], row['elevation_m'])\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = sbm.PhaseNet.from_pretrained('instance')\nmodel.eval()\n\n# Group traces by station for 3-component processing\nprint(\"Grouping traces by station...\")\nstation_streams = defaultdict(obspy.Stream)\nfor tr in st:\n    key = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[key].append(tr)\n\n# Pick phases for each station\nprint(\"Picking phases...\")\nall_picks = []\n\nfor station_key, station_st in station_streams.items():\n    print(f\"  Processing {station_key} ({len(station_st)} traces)...\")\n    \n    # Sort by channel to get consistent ordering (E, N, Z)\n    station_st.sort(keys=['channel'])\n    \n    try:\n        # Use SeisBench annotate function\n        annotations = model.annotate(station_st)\n        \n        # Extract picks from annotations\n        picks = model.classify(station_st, P_threshold=0.3, S_threshold=0.3)\n        \n        for pick in picks:\n            all_picks.append({\n                'station': station_key,\n                'phase': pick.phase,\n                'time': pick.peak_time,\n                'prob': pick.peak_value\n            })\n            \n    except Exception as e:\n        print(f\"    Error processing {station_key}: {e}\")\n        continue\n\nprint(f\"Total picks: {len(all_picks)}\")\n\n# Convert to DataFrame\npicks_df = pd.DataFrame(all_picks)\nif len(picks_df) > 0:\n    picks_df['time_utc'] = picks_df['time'].apply(lambda x: UTCDateTime(x))\n    picks_df = picks_df.sort_values('time')\n    print(picks_df.head(20))\n\n# Simple event association based on clustering picks in time\n# Use velocity model: vp = 6 km/s, vs = vp/1.75\nvp = 6.0  # km/s\nvs = vp / 1.75\n\ndef haversine_km(lat1, lon1, lat2, lon2):\n    \"\"\"Calculate distance between two points in km\"\"\"\n    R = 6371  # Earth radius in km\n    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n    dlat = lat2 - lat1\n    dlon = lon2 - lon1\n    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\n    c = 2 * np.arcsin(np.sqrt(a))\n    return R * c\n\n# Event association using a simple time-based clustering\n# For a regional network, P waves from same event should arrive within ~30s\n# depending on network size\n\ndef associate_events(picks_df, time_window=15.0, min_picks=4):\n    \"\"\"Associate picks into events using time-based clustering\"\"\"\n    if len(picks_df) == 0:\n        return []\n    \n    events = []\n    picks_used = set()\n    \n    # Sort by time\n    picks_sorted = picks_df.sort_values('time').reset_index(drop=True)\n    \n    for i, pick in picks_sorted.iterrows():\n        if i in picks_used:\n            continue\n        \n        # Find all picks within time window\n        pick_time = UTCDateTime(pick['time'])\n        \n        cluster_picks = []\n        cluster_indices = []\n        \n        for j, other_pick in picks_sorted.iterrows():\n            if j in picks_used:\n                continue\n            other_time = UTCDateTime(other_pick['time'])\n            if abs(other_time - pick_time) <= time_window:\n                cluster_picks.append(other_pick)\n                cluster_indices.append(j)\n        \n  "]
[56.267165, "i", "      # Check if we have enough picks from different stations\n        if len(cluster_picks) >= min_picks:\n            stations_in_cluster = set([p['station'] for p in cluster_picks])\n            if len(stations_in_cluster) >= 3:  # At least 3 stations\n                # Mark picks as used\n                for idx in cluster_indices:\n                    picks_used.add(idx)\n                \n                # Estimate event time from P picks\n                p_picks = [p for p in cluster_picks if p['phase'] == 'P']\n                if len(p_picks) > 0:\n                    # Event time is approximately the earliest P pick minus travel time\n                    # For simplicity, use earliest P pick as proxy\n                    earliest_p = min([UTCDateTime(p['time']) for p in p_picks])\n                    events.append({\n                        'time': earliest_p,\n                        'n_picks': len(cluster_picks),\n                        'n_stations': len(stations_in_cluster)\n                    })\n    \n    return events\n\nprint(\"\\nAssociating picks into events...\")\nevents = associate_events(picks_df, time_window=20.0, min_picks=4)\nprint(f\"Found {len(events)} events\")\n\n# If simple association didn't work well, try alternative approach\nif len(events) < 3:\n    print(\"Trying alternative association with relaxed parameters...\")\n    events = associate_events(picks_df, time_window=30.0, min_picks=3)\n    print(f\"Found {len(events)} events with relaxed parameters\")\n\n# Create output DataFrame\nif len(events) > 0:\n    results = []\n    for event in events:\n        results.append({\n            'time': event['time'].strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\n            'n_picks': event['n_picks'],\n            'n_stations': event['n_stations']\n        })\n    \n    results_df = pd.DataFrame(results)\n    # Remove duplicate events (within 5 seconds)\n    results_df['time_utc'] = pd.to_datetime(results_df['time'])\n    results_df = results_df.sort_values('time_utc')\n    \n    # Deduplicate\n    final_events = []\n    last_time = None\n    for _, row in results_df.iterrows():\n        if last_time is None or (row['time_utc'] - last_time).total_seconds() > 5:\n            final_events.append(row)\n            last_time = row['time_utc']\n    \n    final_df = pd.DataFrame(final_events)[['time', 'n_picks', 'n_stations']]\n    print(f\"\\nFinal events after deduplication: {len(final_df)}\")\n    print(final_df)\nelse:\n    final_df = pd.DataFrame(columns=['time'])\n    print(\"No events found!\")\n\n# Save results\nfinal_df.to_csv('/root/results.csv', index=False)\nprint(f\"\\nResults saved to /root/results.csv\")\nEOF\n"]
