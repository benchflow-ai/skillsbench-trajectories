[576.000319, "o", "> "]
[576.000393, "o", "print(f\"Max station distance from center: {max_dist:.1f} km\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.000469, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[576.000531, "o", "> "]
[576.00061, "o", "# Maximum P-wave travel time across network\r\n\u001b[?2004l\r"]
[576.000685, "o", "\u001b[?2004h> "]
[576.000758, "o", "max_travel_time = max_dist / vp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.000893, "o", "print(f\"Max P-wave travel time: {max_travel_time:.1f} s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.000961, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.001091, "o", "# Association using DBSCAN-like clustering on P picks\r\n\u001b[?2004l\r"]
[576.001173, "o", "\u001b[?2004h> "]
[576.001259, "o", "from scipy.cluster.hierarchy import fcluster, linkage\r\n\u001b[?2004l\r"]
[576.001339, "o", "\u001b[?2004h> \r\n"]
[576.001408, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[576.001481, "o", "# Focus on P picks for initial event detection\r\n\u001b[?2004l\r"]
[576.001539, "o", "\u001b[?2004h> "]
[576.001655, "o", "p_picks = picks_df[picks_df['phase'] == 'P'].copy()\r\n\u001b[?2004l\r"]
[576.001815, "o", "\u001b[?2004h> print(f\"\\nUsing {len(p_picks)} P picks for association\")\r\n"]
[576.001933, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.002027, "o", "# Cluster P picks by time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.002054, "o", "if len(p_picks) > 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.002076, "o", "> "]
[576.002207, "o", "    times = p_picks['time_sec'].values.reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[576.002232, "o", "\u001b[?2004h> "]
[576.002904, "o", "    # Use hierarchical clustering with time-based distance\r\n\u001b[?2004l\r\u001b[?2004h>     Z = linkage(times, method='single')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Cut tree at max_travel_time (picks from same event should be within this window)\r\n\u001b[?2004l\r\u001b[?2004h>     cluster_labels = fcluster(Z, t=max_travel_time + 5, criterion='distance')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.002941, "o", "    p_picks['cluster'] = cluster_labels\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003077, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003102, "o", "    print(f\"Found {len(set(cluster_labels))} initial clusters\")\r\n\u001b[?2004l\r"]
[576.00319, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003319, "o", "    # Filter clusters by minimum number of stations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003378, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003499, "o", "    for cluster_id in set(cluster_labels):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.003924, "o", "        cluster_picks = p_picks[p_picks['cluster'] == cluster_id]\r\n\u001b[?2004l\r\u001b[?2004h>         n_stations = cluster_picks['station'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.004057, "o", "        if n_stations >= 4:  # Require at least 4 stations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.004156, "o", "            # Estimate origin time: earliest P pick minus average travel time\r\n\u001b[?2004l\r"]
[576.004227, "o", "\u001b[?2004h> "]
[576.004288, "o", "            earliest_p_time = cluster_picks['time_sec'].min()\r\n\u001b[?2004l\r"]
[576.00432, "o", "\u001b[?2004h> "]
[576.004482, "o", "            earliest_station = cluster_picks.loc[cluster_picks['time_sec'].idxmin(), 'station']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.004541, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.00468, "o", "            # Estimate distance to source (rough approximation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.004706, "o", "> "]
[576.004797, "o", "            # Use the station distance as proxy\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.004818, "o", "> "]
[576.004969, "o", "            est_dist = station_dist.get(earliest_station, 30)  # default 30 km\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.004992, "o", "> "]
[576.005079, "o", "            travel_time = est_dist / vp\r\n\u001b[?2004l\r"]
[576.005102, "o", "\u001b[?2004h> "]
[576.005217, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.005297, "o", "            origin_time = earliest_p_time - travel_time\r\n\u001b[?2004l\r"]
[576.005321, "o", "\u001b[?2004h> "]
[576.005413, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.005496, "o", "            events.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.00558, "o", "                'origin_time': origin_time,\r\n\u001b[?2004l\r"]
[576.005653, "o", "\u001b[?2004h> "]
[576.005759, "o", "                'earliest_p': earliest_p_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.005868, "o", "                'n_stations': n_stations,\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.005942, "o", "> "]
[576.006017, "o", "                'n_picks': len(cluster_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.006096, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[576.006168, "o", "\u001b[?2004h> "]
[576.006255, "o", "    print(f\"Events with >= 4 stations: {len(events)}\")\r\n\u001b[?2004l\r"]
[576.006327, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.006397, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[576.006468, "o", "\u001b[?2004h> "]
[576.006565, "o", "# Sort events by time and deduplicate (within 5 seconds)\r\n\u001b[?2004l\r"]
[576.006638, "o", "\u001b[?2004h> "]
[576.006708, "o", "events = sorted(events, key=lambda x: x['origin_time'])\r\n\u001b[?2004l\r"]
[576.006779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.006849, "o", "final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.006921, "o", "last_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.006991, "o", "for event in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007133, "o", "    if last_time is None or (event['origin_time'] - last_time) > 5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.007209, "o", "> "]
[576.007278, "o", "        final_events.append(event)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007375, "o", "        last_time = event['origin_time']\r\n\u001b[?2004l\r"]
[576.007449, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007541, "o", "print(f\"Final events after deduplication: {len(final_events)}\")\r\n\u001b[?2004l\r"]
[576.007614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007685, "o", "# Create output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007754, "o", "if len(final_events) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007823, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.007902, "o", "    for event in final_events:\r\n\u001b[?2004l\r"]
[576.007976, "o", "\u001b[?2004h> "]
[576.008049, "o", "        t = UTCDateTime(event['origin_time'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.008122, "o", ">         results.append({\r\n\u001b[?2004l\r"]
[576.008194, "o", "\u001b[?2004h> "]
[576.008304, "o", "            'time': t.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3],\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.008379, "o", "> "]
[576.00845, "o", "            'n_stations': event['n_stations'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.008555, "o", "            'n_picks': event['n_picks']\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.00863, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[576.008709, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[576.008783, "o", "    final_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.008855, "o", "    print(\"\\nDetected events:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.008931, "o", "    print(final_df.to_string())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.009001, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.009085, "o", "    final_df = pd.DataFrame(columns=['time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.009158, "o", "    print(\"No events found!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.009472, "o", "final_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nResults saved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
