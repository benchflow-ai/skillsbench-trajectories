[?2004l[?2004h> def find_available_slot(calendar_service, dates, duration_hours, time_constraints):
[?2004l[?2004h>     """Find an available time slot in the calendar"""
[?2004l[?2004h>     for date in dates:
[?2004l[?2004h>         # Query calendar events for this date
[?2004l[?2004h>         start_of_day = date.isoformat() + 'T00:00:00Z'
[?2004l[?2004h>         end_of_day = date.isoformat() + 'T23:59:59Z'
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             events_result = calendar_service.events().list(
[?2004l[?2004h>                 calendarId='primary',
[?2004l[?2004h>                 timeMin=start_of_day,
[?2004l[?2004h>                 timeMax=end_of_day,
[?2004l[?2004h>                 singleEvents=True,
[?2004l[?2004h>                 orderBy='startTime'
[?2004l[?2004h>             ).execute()
[?2004l[?2004h>             
[?2004l[?2004h>             events = events_result.get('items', [])
[?2004l[?2004h>             busy_times = []
[?2004l[?2004h>             for event in events:
[?2004l[?2004h>                 start = event['start'].get('dateTime', event['start'].get('date'))
[?2004l[?2004h>                 end = event['end'].get('dateTime', event['end'].get('date'))
[?2004l[?2004h>                 busy_times.append((start, end))
[?2004l[?2004h>             
[?2004l[?2004h>             # Find free slot within time constraints
[?2004l[?2004h>             start_hour = time_constraints.get('start_hour', 9)
[?2004l[?2004h>             end_hour = time_constraints.get('end_hour', 17)
[?2004l[?2004h>             
[?2004l[?2004h>             for hour in range(start_hour, end_hour):
[?2004l[?2004h>                 for minute in [0, 30]:
[?2004l[?2004h>                     slot_start = date.replace(hour=hour, minute=minute, second=0, microsecond=0)
[?2004l[?2004h>                     slot_end = slot_start + timedelta(hours=duration_hours)
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Check if slot is free
[?2004l[?2004h>                     is_free = True
[?2004l[?2004h>                     for busy_start, busy_end in busy_times:
[?2004l[?2004h>                         # Handle both datetime and date formats
[?2004l[?2004h>                         if 'T' in str(busy_start):
[?2004l[?2004h>                             busy_start_dt = datetime.fromisoformat(busy_start.replace('Z', '+00:00')).replace(tzinfo=None)
[?2004l[?2004h>                             busy_end_dt = datetime.fromisoformat(busy_end.replace('Z', '+00:00')).replace(tzinfo=None)
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             busy_start_dt = datetime.fromisoformat(busy_start)
[?2004l[?2004h>                             busy_end_dt = datetime.fromisoformat(busy_end)
[?2004l[?2004h>                         
[?2004l[?2004h>                         if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):
[?2004l[?2004h>                             is_free = False
[?2004l[?2004h>                             break
[?2004l[?2004h>                     
[?2004l[?2004h>                     if is_free and slot_end.hour <= end_hour:
[?2004l[?2004h>                         return slot_start, slot_end
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error checking calendar for {date}: {e}")
[?2004l[?2004h>             # Return a default slot if calendar check fails
[?2004l[?2004h>             return date.replace(hour=10, minute=0), date.replace(hour=10, minute=0) + timedelta(hours=duration_hours)
[?2004l[?2004h>     
