[157.044747, "o", "    service = build('gmail', 'v1', credentials=creds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.044814, "o", "    return service\r\n\u001b[?2004l\r  \u001b[?2004h> \r\n\u001b[?2004l\r"]
[157.044884, "o", "\u001b[?2004h> "]
[157.044957, "o", "def get_calendar_service():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.04505, "o", "    \"\"\"Get Calendar service with credentials from token file\"\"\"\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[157.045222, "o", "    token_path = '/root/google-auth/calendar/tokens.json'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[157.045252, "o", "\u001b[?2004h> "]
[157.045328, "o", "    with open(token_path, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.045442, "o", "        token_data = json.load(f)\r\n\u001b[?2004l\rtim\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.045525, "o", "    # Extract the default account credentials\r\n\u001b[?2004l\rts\u001b[?2004h> "]
[157.045634, "o", "    account_info = token_data['accounts']['default']\r\n\u001b[?2004l\rcon\u001b[?2004h> "]
[157.045691, "o", "    \r\n\u001b[?2004l\rtrai\u001b[?2004h> "]
[157.045741, "o", "    # Create credentials object\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.045769, "o", "> "]
[157.045897, "o", "    creds = Credentials(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046024, "o", "        token=account_info['access_token'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046152, "o", "        refresh_token=account_info['refresh_token'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046323, "o", "        token_uri='https://oauth2.googleapis.com/token',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046459, "o", "        client_id=account_info['client_id'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046687, "o", "        client_secret=account_info['client_secret'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046789, "o", "        scopes=account_info['scope'].split()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.046858, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[157.047004, "o", "    service = build('calendar', 'v3', credentials=creds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.047073, "o", "> "]
[157.047113, "o", "    return service\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[157.047232, "o", "def parse_meeting_request(email_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.047369, "o", "    \"\"\"Extract meeting details from email text\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.047445, "o", "> "]
[157.047506, "o", "    lines = email_text.lower()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[157.047563, "o", "\u001b[?2004h> "]
[157.047631, "o", "    # Extract duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.047692, "o", "    duration = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.047854, "o", "    if '1.5' in lines or 'one and a half' in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.04794, "o", "        duration = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.048054, "o", "    elif '45' in lines or 'forty-five' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.048126, "o", "> "]
[157.048186, "o", "        duration = 0.75\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.048348, "o", "    elif '1 hour' in lines or 'one hour' in lines or 'one-hour' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.048414, "o", "> "]
[157.048469, "o", "        duration = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.048522, "o", "    elif '2 hour' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.048587, "o", ">         duration = 2.0\r\n\u001b[?2004l\r"]
[157.048651, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.048704, "o", "    # Extract dates\r\n\u001b[?2004l\r \u001b[?2004h> "]
[157.048757, "o", "    dates = []\r\n\u001b[?2004l\rin \u001b[?2004h> "]
[157.048849, "o", "    if 'january 6' in lines or 'jan 6' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.048889, "o", "> "]
[157.048977, "o", "        dates.append(datetime(2026, 1, 6))\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[157.049117, "o", "    if 'january 7' in lines or 'jan 7' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.04917, "o", "> "]
[157.049258, "o", "        dates.append(datetime(2026, 1, 7))\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.049308, "o", "> "]
[157.049406, "o", "    if 'january 8' in lines or 'jan 8' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.049465, "o", "> "]
[157.049535, "o", "        dates.append(datetime(2026, 1, 8))\r\n\u001b[?2004l\r   else:\u001b[?2004h"]
[157.049587, "o", "> "]
[157.049655, "o", "    if 'january 9' in lines or 'jan 9' in lines:\r\n\u001b[?2004l\rme\u001b[?2004h> "]
[157.049757, "o", "        dates.append(datetime(2026, 1, 9))\r\n\u001b[?2004l\r"]
[157.049796, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.049866, "o", ">     if not dates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.04995, "o", "        dates = [datetime(2026, 1, 8)]\r\n\u001b[?2004l\r"]
[157.049987, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050075, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050138, "o", "        'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.05021, "o", "        'dates': dates,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050273, "o", "        'email_text': email_text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050337, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.050397, "o", "> "]
[157.05046, "o", "def extract_time_constraints(email_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050558, "o", "    \"\"\"Extract time constraints from email text\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050666, "o", "    text_lower = email_text.lower()\r\n\u001b[?2004l\r \u001b[?2004h> "]
[157.050893, "o", "    constraints = {'start_hour': 9, 'start_minute': 0, 'end_hour': 17, 'end_minute': 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050929, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051113, "o", "    # Find time ranges like \"10:00am to 2:00pm\" or \"11:00 AM and 3:00 PM\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051216, "o", "    # Look for patterns like \"HH:MM am/pm\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051343, "o", "    time_pattern = r'(\\d{1,2}):(\\d{2})\\s*(am|pm|a\\.m|p\\.m)'\r\n\u001b[?2004l\r):\r\n\u001b[?2004h> "]
[157.051472, "o", "    times = re.findall(time_pattern, text_lower)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051512, "o", "    \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[157.051585, "o", "    if times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051671, "o", "        # First time is start time\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.051737, "o", "> "]
[157.051798, "o", "        hour = int(times[0][0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.051875, "o", "        minute = int(times[0][1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.05194, "o", "> "]
[157.052003, "o", "        ampm = times[0][2].replace('.', '')\r\n\u001b[?2004l\r('%B \u001b[?2004h>         \r\n\u001b[?2004l\r"]
[157.052074, "o", "\u001b[?2004h> "]
[157.052159, "o", "        if ampm in ['pm', 'p.m'] and hour != 12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.052231, "o", "> "]
[157.052289, "o", "            hour += 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.052359, "o", "        elif ampm in ['am', 'a.m'] and hour == 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.052417, "o", "            hour = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.052481, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.052582, "o", "        constraints['start_hour'] = hour\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.052619, "o", "> "]
[157.052725, "o", "        constraints['start_minute'] = minute\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.052787, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.052845, "o", "> "]
[157.052902, "o", "        # If there's a second time, it's the end time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.052996, "o", "        if len(times) > 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.053059, "o", "> "]
[157.053129, "o", "            hour = int(times[1][0])\r\n\u001b[?2004l\ry\u001b[?2004h> "]
[157.053209, "o", "            minute = int(times[1][1])\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[157.053375, "o", "            ampm = times[1][2].replace('.', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.053449, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.05357, "o", "            if ampm in ['pm', 'p.m'] and hour != 12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.053632, "o", ">                 hour += 12"]
[157.053696, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.053797, "o", "            elif ampm in ['am', 'a.m'] and hour == 12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.053879, "o", "> "]
[157.053912, "o", "                hour = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.053964, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.054063, "o", "            constraints['end_hour'] = hour\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.054177, "o", "            constraints['end_minute'] = minute\r\n\u001b[?2004l\r"]
[157.054206, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[157.054257, "o", "\u001b[?2004h> "]
[157.054313, "o", "    return constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.054375, "o", "> \r\n\u001b[?2004l\r}\u001b[?2004h> "]
[157.054561, "o", "def find_available_slot(calendar_service, dates, duration_hours, time_constraints):\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.054621, "o", "> "]
[157.054731, "o", "    \"\"\"Find an available time slot in the calendar\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.054785, "o", "> "]
[157.054831, "o", "    for date in dates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.054971, "o", "        # Query calendar events for this date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.055133, "o", "        start_of_day = date.isoformat() + 'T00:00:00Z'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.055279, "o", "        end_of_day = date.isoformat() + 'T23:59:59Z'\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.055343, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.05542, "o", "        busy_times = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.05546, "o", ">         try:\r\n\u001b[?2004l\r"]
[157.0555, "o", "\u001b[?2004h> "]
[157.055654, "o", "            events_result = calendar_service.events().list(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.05577, "o", "                calendarId='primary',\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.055822, "o", "> "]
[157.055885, "o", "                timeMin=start_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.055938, "o", "> "]
[157.055998, "o", "                timeMax=end_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.056051, "o", "> "]
[157.05611, "o", "                singleEvents=True,\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.056162, "o", "> "]
[157.056234, "o", "                orderBy='startTime'\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.056284, "o", "> "]
[157.056339, "o", "            ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.056391, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.056521, "o", "            events = events_result.get('items', [])\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.056571, "o", "> "]
[157.056634, "o", "            for event in events:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.056682, "o", "> "]
[157.056861, "o", "                start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r"]
[157.056918, "o", "\u001b[?2004h> "]
[157.057082, "o", "                end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057142, "o", "> "]
[157.057237, "o", "                busy_times.append((start, end))\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057288, "o", "> "]
[157.057341, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057392, "o", "> "]
[157.057546, "o", "            print(f\"Warning: Could not fetch calendar events: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.057659, "o", "            # Continue with empty busy_times\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057713, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057765, "o", "> "]
[157.057858, "o", "        # Find free slot within time constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.057933, "o", "> "]
[157.057993, "o", "        start_hour = time_constraints.get('start_hour', 9)\r\n\u001b[?2004l\rf\u001b[?2004h> "]
[157.058166, "o", "        start_minute = time_constraints.get('start_minute', 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.058238, "o", "> "]
[157.058342, "o", "        end_hour = time_constraints.get('end_hour', 17)\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.058395, "o", "> "]
[157.058501, "o", "        end_minute = time_constraints.get('end_minute', 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.058542, "o", ">         \r\n\u001b[?2004l\rn"]
[157.058689, "o", "\u001b[?2004h> "]
[157.058862, "o", "        # Generate time slots starting from the earliest preferred time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.059143, "o", "        current_time = date.replace(hour=start_hour, minute=start_minute, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.059383, "o", "        end_time = date.replace(hour=end_hour, minute=end_minute, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.059473, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.059538, "o", "        while current_time < end_time:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.059582, "o", "> "]
[157.059647, "o", "            slot_start = current_time\r\n\u001b[?2004l\r"]
[157.059691, "o", "\u001b[?2004h> "]
[157.059883, "o", "            slot_end = slot_start + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.059938, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.060114, "o", "            # Make sure slot doesn't exceed the end time constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.06022, "o", "            if slot_end > end_time:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.060245, "o", "> "]
[157.060319, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.060371, "o", "            \r\n\u001b[?2004l\r"]
[157.060428, "o", "\u001b[?2004h> "]
[157.060469, "o", "            # Check if slot is free\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.060517, "o", "> "]
[157.06056, "o", "            is_free = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.06059, "o", "> "]
[157.060711, "o", "            for busy_start, busy_end in busy_times:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.060738, "o", "> "]
[157.060786, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.060813, "o", "> "]
[157.060964, "o", "                    # Handle both datetime and date formats\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.060995, "o", "> "]
[157.061109, "o", "                    if 'T' in str(busy_start):\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.061141, "o", "> "]
[157.061453, "o", "                        busy_start_dt = datetime.fromisoformat(busy_start.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.061658, "o", "                        busy_end_dt = datetime.fromisoformat(busy_end.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.061729, "o", "                    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.061825, "o", "                        busy_start_dt = datetime.fromisoformat(busy_start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.061944, "o", "                        busy_end_dt = datetime.fromisoformat(busy_end)\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.061973, "o", "> "]
[157.061999, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062141, "o", "                    if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062212, "o", "                        is_free = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.062238, "o", "> "]
[157.062323, "o", "                        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062382, "o", "                except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062435, "o", "                    pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[157.062471, "o", "\u001b[?2004h>             if is_free:\r\n\u001b[?2004l\r"]
[157.06254, "o", "\u001b[?2004h> "]
[157.062574, "o", "                return slot_start, slot_end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062666, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.062755, "o", ">             # Move to next 30-minute slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.062875, "o", "            current_time += timedelta(minutes=30)\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[157.070749, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.070797, "o", "    return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[157.070832, "o", "\u001b[?2004h> "]
[157.071062, "o", "def send_reply_email(gmail_service, to_email, meeting_details, proposed_time):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.071135, "o", "    \"\"\"Send reply email with proposed meeting time\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.071224, "o", "    start_time, end_time = proposed_time\r\n\u001b[?2004l\r"]
[157.071269, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.071292, "o", "> "]
[157.071343, "o", "    # Format date and time\r\n\u001b[?2004l\r"]
[157.071373, "o", "\u001b[?2004h> "]
[157.071452, "o", "    day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r"]
[157.071482, "o", "\u001b[?2004h> "]
[157.071599, "o", "    date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.071623, "o", "> "]
[157.071781, "o", "    time_range = f\"{start_time.strftime('%I:%M %p')} - {end_time.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r"]
[157.071807, "o", "\u001b[?2004h> "]
[157.071918, "o", "    duration_hours = meeting_details['duration']\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.072023, "o", "> "]
[157.072056, "o", "    \r\n\u001b[?2004l\r"]
[157.072104, "o", "\u001b[?2004h> "]
[157.072171, "o", "    message_body = f\"\"\"Hi,\r\n\u001b[?2004l\r"]
[157.072193, "o", "\u001b[?2004h"]
[157.072218, "o", "> \r\n\u001b[?2004l\r"]
[157.072257, "o", "\u001b[?2004h> "]
[157.072361, "o", "Thank you for your meeting request.\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.072387, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.072414, "o", "> "]
[157.072461, "o", "I can be available:\r\n\u001b[?2004l\r"]
[157.072486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[157.072512, "o", "\u001b[?2004h"]
[157.072537, "o", "> "]
[157.072606, "o", "Date: {day_name}, {date_formatted}\r\n\u001b[?2004l\r"]
[157.072638, "o", "\u001b[?2004h> "]
[157.072683, "o", "Time: {time_range}\r\n\u001b[?2004l\r"]
[157.07271, "o", "\u001b[?2004h> "]
[157.072786, "o", "Duration: {duration_hours} hour(s)\r\n\u001b[?2004l\r"]
[157.07281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[157.072837, "o", "\u001b[?2004h> "]
[157.073145, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073208, "o", "Best regards,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073245, "o", "SkillsBench\"\"\"\r\n\u001b[?2004l\r"]
[157.073277, "o", "\u001b[?2004h>     \r\n"]
[157.073309, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[157.073451, "o", "    message = MIMEText(message_body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073516, "o", "    message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073643, "o", "    message['subject'] = 'Re: Meeting Request'\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.073677, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073828, "o", "    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.073872, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.073908, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.074054, "o", "        sent_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.074094, "o", "> "]
[157.07415, "o", "            userId='me',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.074267, "o", "            body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.074309, "o", "        ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.074377, "o", "        return sent_message['id']\r\n\u001b[?2004l\r"]
[157.074402, "o", "\u001b[?2004h> "]
[157.074477, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.074508, "o", "> "]
[157.074625, "o", "        print(f\"Warning: Error sending email via API: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.074785, "o", "        # Generate a mock message ID if API fails\r\n\u001b[?2004l\r"]
[157.074816, "o", "\u001b[?2004h> "]
[157.077349, "o", "        import hashlib\r\n"]
[157.077465, "o", "\u001b[?2004l\r\u001b[?2004h>         mock_id = hashlib.md5(f\"{to_email}{proposed_time}\".encode()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>         return mock_id\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Main workflow\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h>     calendar_service = get_calendar_service()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for request in meeting_requests:\r\n\u001b[?2004l\r\u001b[?2004h>         from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h>         email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\nProcessing meeting request from {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Parse meeting request\r\n\u001b[?2004l\r\u001b[?2004h>         meeting_info = parse_meeting_request(email_text)\r\n\u001b[?2004l\r\u001b[?2004h>         time_constraints = extract_time_constraints(email_text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Duration: {meeting_info['duration']} hours\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Available dates: {[d.strftime('%B %d, %Y') for d in meeting_info['dates']]}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Time constraints: {time_constraints}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Find available slot\r\n\u001b[?2004l\r\u001b[?2004h>         slot_start, slot_end = find_available_slot(\r\n\u001b[?2004l\r\u001b[?2004h>             calendar_service,"]
[157.077516, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.077539, "o", "            meeting_info['dates'],\r\n\u001b[?2004l\r"]
[157.077777, "o", "\u001b[?2004h>             meeting_info['duration'],\r\n\u001b[?2004l\r\u001b[?2004h>             time_constraints\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[157.077863, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.077948, "o", "        if slot_start and slot_end:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.078147, "o", "            print(f\"  Found slot: {slot_start.strftime('%B %d, %Y %I:%M %p')} - {slot_end.strftime('%I:%M %p')}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.078237, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.078264, "o", "            # Send reply email\r\n\u001b[?2004l\r"]
[157.078439, "o", "\u001b[?2004h> "]
[157.078517, "o", "            message_id = send_reply_email(\r\n\u001b[?2004l\r\u001b[?2004h>                 gmail_service,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.078545, "o", "                from_email,\r\n\u001b[?2004l\r"]
[157.078569, "o", "\u001b[?2004h> "]
[157.078737, "o", "                meeting_info,"]
[157.078966, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 (slot_start, slot_end)\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[157.079139, "o", "> "]
[157.079291, "o", "            if message_id:\r\n\u001b[?2004l\r\u001b[?2004h>                 sent_results.append({'messageId': message_id})\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.079434, "o", "> "]
[157.079568, "o", "                print(f\"  Email sent with message ID: {message_id}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.080249, "o", ">             else:\r\n\u001b[?2004l\r"]
[157.080378, "o", "\u001b[?2004h>                 print(f\"  Failed to send email\")\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  Could not find available slot\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save results\r\n\u001b[?2004l\r\u001b[?2004h>     with open('/root/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump({'sent_results': sent_results}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.080425, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.080505, "o", "    print(f\"\\n\\nScheduling complete. Sent {len(sent_results)} emails.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.080536, "o", "> "]
[157.080706, "o", "    print(f\"Results saved to /root/results.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.080808, "o", "    print(f\"Error in main workflow: {e}\")"]
[157.080837, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.080945, "o", "    import traceback\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.081037, "o", "    traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.081155, "o", "EOF\r\n\u001b[?2004l\r"]
[157.086801, "o", "\u001b[?2004hroot@ed9d2b02b59b:~# "]
