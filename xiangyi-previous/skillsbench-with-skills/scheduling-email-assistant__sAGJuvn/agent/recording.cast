[30.487298, "o", "    elif '1 hour' in lines or 'one hour' in lines or 'one-hour' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.487324, "o", "> "]
[30.487377, "o", "        duration = 1.0\r\n\u001b[?2004l\r"]
[30.487429, "o", "\u001b[?2004h> "]
[30.487465, "o", "    elif '2 hour' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.48751, "o", "> "]
[30.487558, "o", "        duration = 2.0\r\n\u001b[?2004l\r"]
[30.487599, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.487652, "o", "    # Extract dates\r\n\u001b[?2004l\rr\u001b[?2004h"]
[30.487695, "o", "> "]
[30.487743, "o", "    dates = []\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[30.487885, "o", "    if 'january 6' in lines or 'jan 6' in lines:\r\n\u001b[?2004l\r"]
[30.487937, "o", "\u001b[?2004h> "]
[30.488033, "o", "        dates.append(datetime(2026, 1, 6))\r\n\u001b[?2004l\r"]
[30.48806, "o", "\u001b[?2004h> "]
[30.488212, "o", "    if 'january 7' in lines or 'jan 7' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.488256, "o", "> "]
[30.488342, "o", "        dates.append(datetime(2026, 1, 7))\r\n\u001b[?2004l\r"]
[30.48837, "o", "\u001b[?2004h> "]
[30.488484, "o", "    if 'january 8' in lines or 'jan 8' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.488535, "o", "> "]
[30.488613, "o", "        dates.append(datetime(2026, 1, 8))\r\n\u001b[?2004l\r"]
[30.488638, "o", "\u001b[?2004h> "]
[30.488757, "o", "    if 'january 9' in lines or 'jan 9' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.488781, "o", "> "]
[30.488885, "o", "        dates.append(datetime(2026, 1, 9))\r\n\u001b[?2004l\r"]
[30.488911, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r "]
[30.488941, "o", "\u001b[?2004h> "]
[30.489018, "o", "    if not dates:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.489067, "o", "> "]
[30.489105, "o", "        dates = [datetime(2026, 1, 8)]\r\n\u001b[?2004l\r"]
[30.489156, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\ro\u001b[?2004h"]
[30.489196, "o", ">     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.489222, "o", "> "]
[30.489285, "o", "        'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.489335, "o", "> "]
[30.48936, "o", "        'dates': dates,\r\n\u001b[?2004l\r"]
[30.489385, "o", "\u001b[?2004h> "]
[30.489451, "o", "        'email_text': email_text\r\n\u001b[?2004l\r:0\u001b[?2004h"]
[30.489496, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[30.489523, "o", "\u001b[?2004h> "]
[30.489777, "o", "def find_available_slot(calendar_service, dates, duration_hours, time_constraints):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.489954, "o", "    \"\"\"Find an available time slot in the calendar\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.490061, "o", "    for date in dates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.490184, "o", "        # Query calendar events for this date\r\n\u001b[?2004l\rn\u001b[?2004h"]
[30.49024, "o", "> "]
[30.49036, "o", "        start_of_day = date.isoformat() + 'T00:00:00Z'\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.490384, "o", "> "]
[30.490552, "o", "        end_of_day = date.isoformat() + 'T23:59:59Z'\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.490575, "o", ">         \r\n\u001b[?2004l\r"]
[30.490673, "o", "\u001b[?2004h> "]
[30.490749, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.490848, "o", "            events_result = calendar_service.events().list(\r\n\u001b[?2004l\r"]
[30.490889, "o", "\u001b[?2004h> "]
[30.490969, "o", "                calendarId='primary',\r\n\u001b[?2004l\rr\u001b[?2004h"]
[30.491013, "o", "> "]
[30.491093, "o", "                timeMin=start_of_day,\r\n\u001b[?2004l\r"]
[30.491118, "o", "\u001b[?2004h> "]
[30.491221, "o", "                timeMax=end_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.491265, "o", "> "]
[30.491352, "o", "                singleEvents=True,\r\n\u001b[?2004l\r"]
[30.491377, "o", "\u001b[?2004h> "]
[30.491475, "o", "                orderBy='startTime'\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.4915, "o", "> "]
[30.491558, "o", "            ).execute()\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.491587, "o", "> "]
[30.491638, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.491665, "o", "> "]
[30.491834, "o", "            events = events_result.get('items', [])\r\n\u001b[?2004l\r"]
[30.491879, "o", "\u001b[?2004h> "]
[30.491984, "o", "            busy_times = []\r\n\u001b[?2004l\r"]
[30.492009, "o", "\u001b[?2004h"]
[30.492074, "o", "> "]
[30.492126, "o", "            for event in events:\r\n\u001b[?2004l\r"]
[30.49215, "o", "\u001b[?2004h> "]
[30.492415, "o", "                start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.492664, "o", "                end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r"]
[30.492719, "o", "\u001b[?2004h> "]
[30.49279, "o", "                busy_times.append((start, end))\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.492812, "o", "> "]
[30.492838, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.492891, "o", "> "]
[30.493016, "o", "            # Find free slot within time constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.49304, "o", "> "]
[30.493216, "o", "            start_hour = time_constraints.get('start_hour', 9)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.493239, "o", "> "]
[30.493395, "o", "            end_hour = time_constraints.get('end_hour', 17)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.49344, "o", "> "]
[30.493466, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.493599, "o", "            for hour in range(start_hour, end_hour):\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.493626, "o", "> "]
[30.493732, "o", "                for minute in [0, 30]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.493781, "o", "> "]
[30.494024, "o", "                    slot_start = date.replace(hour=hour, minute=minute, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.494051, "o", "> "]
[30.494251, "o", "                    slot_end = slot_start + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.494277, "o", "> "]
[30.494337, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.494483, "o", "                    # Check if slot is free\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.494531, "o", "> "]
[30.494589, "o", "                    is_free = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.494641, "o", "> "]
[30.494805, "o", "                    for busy_start, busy_end in busy_times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.4952, "o", "                        busy_start_dt = datetime.fromisoformat(busy_start.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.495225, "o", "> "]
[30.495537, "o", "                        busy_end_dt = datetime.fromisoformat(busy_end.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.49568, "o", "                        if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.495736, "o", "> "]
[30.495777, "o", "                            is_free = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.495825, "o", "                            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.495873, "o", "> "]
[30.49592, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.495992, "o", "                    if is_free and slot_end.hour <= end_hour:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.496088, "o", "                        return slot_start, slot_end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.496144, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[30.496198, "o", "\u001b[?2004h> "]
[30.496238, "o", "            print(f\"Error checking calendar: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.496286, "o", "> "]
[30.496342, "o", "            # Return a default slot if calendar check fails\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.496387, "o", "> "]
[30.496537, "o", "            return date.replace(hour=10, minute=0), date.replace(hour=10, minute=0) + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.496585, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.496631, "o", ">     return None, None\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.496689, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.496757, "o", "def send_reply_email(gmail_service, to_email, meeting_details, proposed_time):\r\n\u001b[?2004l\r"]
[30.496803, "o", "\u001b[?2004h> "]
[30.496852, "o", "    \"\"\"Send reply email with proposed meeting time\"\"\"\r\n\u001b[?2004l\r"]
[30.496901, "o", "\u001b[?2004h> "]
[30.496955, "o", "    start_time, end_time = proposed_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.496995, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497042, "o", "    # Format date and time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497106, "o", "    day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497195, "o", "    date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.497242, "o", "> "]
[30.497353, "o", "    time_range = f\"{start_time.strftime('%I:%M %p')} - {end_time.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497424, "o", "    duration_hours = meeting_details['duration']\r\n\u001b[?2004l\r"]
[30.497468, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497508, "o", "    message_body = f\"\"\"Hi,\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.497559, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.497595, "o", "> Thank you for your meeting request.\r\n\u001b[?2004l\r"]
[30.497639, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497683, "o", "I can be available:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[30.497737, "o", "\u001b[?2004h> "]
[30.49779, "o", "Date: {day_name}, {date_formatted}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497841, "o", "Time: {time_range}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.497895, "o", "Duration: {duration_hours} hour(s)\r\n\u001b[?2004l\r"]
[30.497947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.498047, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r"]
[30.498095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498152, "o", "> Best regards,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.49819, "o", "SkillsBench\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.49825, "o", "    message = MIMEText(message_body)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498305, "o", "> "]
[30.498334, "o", "    message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.498399, "o", "    message['subject'] = 'Re: Meeting Request'\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498427, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498455, "o", "> "]
[30.498549, "o", "    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498579, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498609, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498649, "o", "> "]
[30.498762, "o", "        sent_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.498793, "o", "            userId='me',\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.498821, "o", "> "]
[30.498905, "o", "            body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.498957, "o", "        ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.498985, "o", "        return sent_message['id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.499074, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.499121, "o", "        print(f\"Error sending email: {e}\")\r\n\u001b[?2004l\r"]
[30.499145, "o", "\u001b[?2004h> "]
[30.4992, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.499253, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.499312, "o", "def extract_time_constraints(email_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.49938, "o", "    \"\"\"Extract time constraints from email text\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.49943, "o", "    text_lower = email_text.lower()\r\n\u001b[?2004l\r"]
[30.499485, "o", "\u001b[?2004h> "]
[30.499526, "o", "    constraints = {'start_hour': 9, 'end_hour': 17}\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.499585, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.499639, "o", "> "]
[30.499684, "o", "    if '10:00' in text_lower or '10am' in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.499728, "o", "        constraints['start_hour'] = 10\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.499779, "o", "> "]
[30.499825, "o", "    if '11:00' in text_lower or '11am' in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.499871, "o", "> "]
[30.499911, "o", "        constraints['start_hour'] = 11\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.499963, "o", "    if '9:30' in text_lower:\r\n\u001b[?2004l\r"]
[30.500018, "o", "\u001b[?2004h> "]
[30.500055, "o", "        constraints['start_hour'] = 9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500118, "o", "        constraints['start_minute'] = 30\r\n\u001b[?2004l\r"]
[30.500165, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[30.500202, "o", "\u001b[?2004h> "]
[30.500243, "o", "    if '2:00' in text_lower or '2pm' in text_lower:\r\n\u001b[?2004l\r"]
[30.500292, "o", "\u001b[?2004h> "]
[30.50033, "o", "        constraints['end_hour'] = 14\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500413, "o", "    if '3:00' in text_lower or '3pm' in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.500462, "o", "> "]
[30.500499, "o", "        constraints['end_hour'] = 15\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500544, "o", "    if '11:30' in text_lower:\r\n\u001b[?2004l\r"]
[30.500594, "o", "\u001b[?2004h> "]
[30.500633, "o", "        constraints['end_hour'] = 11\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500692, "o", "        constraints['end_minute'] = 30\r\n\u001b[?2004l\r"]
[30.500743, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.500781, "o", ">     return constraints\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[30.500818, "o", "\u001b[?2004h> "]
[30.500873, "o", "# Main workflow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500922, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.500962, "o", "    gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.501019, "o", "    calendar_service = get_calendar_service()\r\n\u001b[?2004l\r"]
[30.501064, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.501099, "o", "> "]
[30.50115, "o", "    for request in meeting_requests:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.501198, "o", "        from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.501248, "o", "> "]
[30.501285, "o", "        email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.501331, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.501372, "o", ">         # Parse meeting request\r\n\u001b[?2004l\r"]
[30.501418, "o", "\u001b[?2004h> "]
[30.501477, "o", "        meeting_info = parse_meeting_request(email_text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.501523, "o", "> "]
[30.501588, "o", "        time_constraints = extract_time_constraints(email_text)\r\n\u001b[?2004l\r"]
[30.501612, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[30.501674, "o", "\u001b[?2004h> "]
[30.501713, "o", "        # Find available slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.501781, "o", "        slot_start, slot_end = find_available_slot(\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.501834, "o", "> "]
[30.501873, "o", "            calendar_service,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.501911, "o", "            meeting_info['dates'],\r\n\u001b[?2004l\r"]
[30.50197, "o", "\u001b[?2004h> "]
[30.50201, "o", "            meeting_info['duration'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502051, "o", "            time_constraints\r\n\u001b[?2004l\r"]
[30.502079, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[30.502141, "o", "\u001b[?2004h> "]
[30.50218, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         if slot_start and slot_end:\r\n\u001b[?2004l\r"]
[30.502234, "o", "\u001b[?2004h> "]
[30.502283, "o", "            # Send reply email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502339, "o", "            message_id = send_reply_email(\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.502388, "o", "> "]
[30.502428, "o", "                gmail_service,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502454, "o", "                from_email,\r\n\u001b[?2004l\r"]
[30.502517, "o", "\u001b[?2004h> "]
[30.502557, "o", "                meeting_info,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502598, "o", "                (slot_start, slot_end)\r\n\u001b[?2004l\r"]
[30.502689, "o", "\u001b[?2004h> "]
[30.50276, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502816, "o", "            if message_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.502876, "o", "                sent_results.append({'messageId': message_id})\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.502929, "o", "> "]
[30.503009, "o", "                print(f\"Sent reply to {from_email} with message ID: {message_id}\")\r\n\u001b[?2004l\r"]
[30.503057, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[30.503096, "o", "\u001b[?2004h> "]
[30.503164, "o", "            print(f\"Could not find available slot for {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.503211, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.503248, "o", ">     # Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.50333, "o", "    with open('/root/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.503369, "o", "> "]
[30.503436, "o", "        json.dump({'sent_results': sent_results}, f, indent=2)\r\n\u001b[?2004l\r"]
[30.503483, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[30.50352, "o", "\u001b[?2004h> "]
[30.503591, "o", "    print(f\"\\nScheduling complete. Sent {len(sent_results)} emails.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.503637, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.503674, "o", "> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.50372, "o", "> "]
[30.503757, "o", "    print(f\"Error in main workflow: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.503799, "o", "    import traceback\r\n\u001b[?2004l\r"]
[30.503844, "o", "\u001b[?2004h> "]
[30.503884, "o", "    traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
