[122.744613, "o", "        dates.append(datetime(2026, 1, 7))\r\n\u001b[?2004l\r"]
[122.744788, "o", "\u001b[?2004h> "]
[122.744923, "o", "    if 'january 8' in lines or 'jan 8' in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.74511, "o", "        dates.append(datetime(2026, 1, 8))\r\n\u001b[?2004l\r"]
[122.74515, "o", "\u001b[?2004h> "]
[122.745308, "o", "    if 'january 9' in lines or 'jan 9' in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.745439, "o", "> "]
[122.745468, "o", "        dates.append(datetime(2026, 1, 9))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.745671, "o", ">     if not dates:\r\n\u001b[?2004l\r\u001b[?2004h>         dates = [datetime(2026, 1, 8)]\r\n\u001b[?2004l\r"]
[122.745844, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rh\u001b[?2004h> "]
[122.745937, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h>         'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.746096, "o", "        'dates': dates,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.746172, "o", "        'email_text': email_text\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[122.746229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.746476, "o", "def extract_time_constraints(email_text):\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.74659, "o", "> "]
[122.746738, "o", "    \"\"\"Extract time constraints from email text\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.746781, "o", "> "]
[122.746925, "o", "    text_lower = email_text.lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.747048, "o", "    constraints = {'start_hour': 9, 'end_hour': 17}\r\n\u001b[?2004l\r"]
[122.747181, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.747419, "o", "    if '10:00' in text_lower or '10am' in text_lower or '10 am' in text_lower:\r\n\u001b[?2004l\r"]
[122.74751, "o", "\u001b[?2004h> "]
[122.747646, "o", "        constraints['start_hour'] = 10\r\n\u001b[?2004l\r"]
[122.747732, "o", "\u001b[?2004h> "]
[122.748119, "o", "    if '11:00' in text_lower or '11am' in text_lower or '11 am' in text_lower:\r\n\u001b[?2004l\r"]
[122.748166, "o", "\u001b[?2004h> "]
[122.748392, "o", "        constraints['start_hour'] = 11\r\n\u001b[?2004l\r"]
[122.748472, "o", "\u001b[?2004h> "]
[122.748552, "o", "    if '9:30' in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.748659, "o", "> "]
[122.748787, "o", "        constraints['start_hour'] = 9\r\n\u001b[?2004l\r"]
[122.74884, "o", "\u001b[?2004h> "]
[122.748987, "o", "        constraints['start_minute'] = 30\r\n\u001b[?2004l\r"]
[122.749063, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[122.74917, "o", "\u001b[?2004h> "]
[122.749284, "o", "    if '2:00' in text_lower or '2pm' in text_lower or '2 pm' in text_lower:\r\n\u001b[?2004l\r"]
[122.749376, "o", "\u001b[?2004h> "]
[122.749468, "o", "        constraints['end_hour'] = 14\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.749848, "o", "    if '3:00' in text_lower or '3pm' in text_lower or '3 pm' in text_lower:\r\n\u001b[?2004l\r"]
[122.74988, "o", "\u001b[?2004h> "]
[122.750054, "o", "        constraints['end_hour'] = 15\r\n\u001b[?2004l\r"]
[122.750154, "o", "\u001b[?2004h> "]
[122.750224, "o", "    if '11:30' in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.75032, "o", "        constraints['end_hour'] = 11\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.750431, "o", "        constraints['end_minute'] = 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.750519, "o", "    \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[122.750608, "o", "    return constraints\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[122.750721, "o", "> "]
[122.750827, "o", "def find_available_slot(calendar_service, dates, duration_hours, time_constraints):\r\n\u001b[?2004l\r"]
[122.750888, "o", "\u001b[?2004h> "]
[122.751038, "o", "    \"\"\"Find an available time slot in the calendar\"\"\"\r\n\u001b[?2004l\r"]
[122.751134, "o", "\u001b[?2004h> "]
[122.751214, "o", "    for date in dates:\r\n\u001b[?2004l\r"]
[122.751238, "o", "\u001b[?2004h> "]
[122.751467, "o", "        # Query calendar events for this date\r\n\u001b[?2004l\r"]
[122.751569, "o", "\u001b[?2004h> "]
[122.751789, "o", "        start_of_day = date.isoformat() + 'T00:00:00Z'\r\n\u001b[?2004l\r"]
[122.751832, "o", "\u001b[?2004h> "]
[122.752096, "o", "        end_of_day = date.isoformat() + 'T23:59:59Z'\r\n\u001b[?2004l\r"]
[122.752176, "o", "\u001b[?2004h> "]
[122.752278, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.752324, "o", "        busy_times = []\r\n\u001b[?2004l\r"]
[122.752445, "o", "\u001b[?2004h>         try:\r\n"]
[122.752479, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[122.752765, "o", "            events_result = calendar_service.events().list(\r\n\u001b[?2004l\r"]
[122.7528, "o", "\u001b[?2004h> "]
[122.75292, "o", "                calendarId='primary',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.753024, "o", "                timeMin=start_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.753044, "o", "> "]
[122.753165, "o", "                timeMax=end_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.753225, "o", "> "]
[122.753304, "o", "                singleEvents=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.753407, "o", "                orderBy='startTime'\r\n\u001b[?2004l\r"]
[122.753427, "o", "\u001b[?2004h> "]
[122.753545, "o", "            ).execute()\r\n\u001b[?2004l\r"]
[122.753574, "o", "\u001b[?2004h> "]
[122.753728, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.753846, "o", "> "]
[122.753952, "o", "            events = events_result.get('items', [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.754009, "o", "            for event in events:\r\n\u001b[?2004l\r \u001b[?2004h> "]
[122.75435, "o", "                start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.754379, "o", "> "]
[122.754581, "o", "                end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.75482, "o", "                busy_times.append((start, end))\r\n\u001b[?2004l\r"]
[122.75493, "o", "\u001b[?2004h> "]
[122.755019, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[122.75518, "o", "\u001b[?2004h> "]
[122.755446, "o", "            print(f\"Warning: Could not fetch calendar events: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.755557, "o", "> "]
[122.755734, "o", "            # Continue with empty busy_times\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.755764, "o", "> "]
[122.75579, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.755916, "o", "> "]
[122.756098, "o", "        # Find free slot within time constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.756208, "o", "> "]
[122.756418, "o", "        start_hour = time_constraints.get('start_hour', 9)\r\n\u001b[?2004l\r"]
[122.756541, "o", "\u001b[?2004h> "]
[122.756612, "o", "        end_hour = time_constraints.get('end_hour', 17)\r\n\u001b[?2004l\r"]
[122.756701, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.756814, "o", "        for hour in range(start_hour, end_hour):\r\n\u001b[?2004l\r"]
[122.756835, "o", "\u001b[?2004h> "]
[122.756945, "o", "            for minute in [0, 30]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.756974, "o", "> "]
[122.757324, "o", "                slot_start = date.replace(hour=hour, minute=minute, second=0, microsecond=0)\r\n\u001b[?2004l\r"]
[122.757493, "o", "\u001b[?2004h> "]
[122.757588, "o", "                slot_end = slot_start + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r"]
[122.757672, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.757845, "o", "                # Check if slot is free\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.758072, "o", "                is_free = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.758206, "o", "                for busy_start, busy_end in busy_times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.758295, "o", "                    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.758423, "o", "                        # Handle both datetime and date formats\r\n\u001b[?2004l\r"]
[122.758516, "o", "\u001b[?2004h> "]
[122.758706, "o", "                        if 'T' in str(busy_start):\r\n\u001b[?2004l\r"]
[122.758824, "o", "\u001b[?2004h> "]
[122.758933, "o", "                            busy_start_dt = datetime.fromisoformat(busy_start.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r"]
[122.758965, "o", "\u001b[?2004h> "]
[122.759145, "o", "                            busy_end_dt = datetime.fromisoformat(busy_end.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.759206, "o", "> "]
[122.75927, "o", "                        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759337, "o", "                            busy_start_dt = datetime.fromisoformat(busy_start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759461, "o", "                            busy_end_dt = datetime.fromisoformat(busy_end)\r\n\u001b[?2004l\r"]
[122.759528, "o", "\u001b[?2004h> "]
[122.7596, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759668, "o", "                        if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):\r\n\u001b[?2004l\r"]
[122.759728, "o", "\u001b[?2004h> "]
[122.759804, "o", "                            is_free = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759871, "o", "                            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759934, "o", "                    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.759999, "o", "                        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.76006, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.760126, "o", "                if is_free and slot_end.hour <= end_hour:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.760199, "o", "                    return slot_start, slot_end\r\n\u001b[?2004l\r"]
[122.760244, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.76031, "o", ">     return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.760361, "o", "\u001b[?2004h> "]
[122.760422, "o", "def send_reply_email(gmail_service, to_email, meeting_details, proposed_time):\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.760473, "o", "> "]
[122.760546, "o", "    \"\"\"Send reply email with proposed meeting time\"\"\"\r\n\u001b[?2004l\r"]
[122.7606, "o", "\u001b[?2004h> "]
[122.760662, "o", "    start_time, end_time = proposed_time\r\n\u001b[?2004l\r"]
[122.760732, "o", "\u001b[?2004h> "]
[122.760809, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.760864, "o", "    # Format date and time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.760922, "o", "    day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r"]
[122.760953, "o", "\u001b[?2004h> "]
[122.761081, "o", "    date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r"]
[122.761109, "o", "\u001b[?2004h> "]
[122.761347, "o", "    time_range = f\"{start_time.strftime('%I:%M %p')} - {end_time.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.761472, "o", "    duration_hours = meeting_details['duration']\r\n\u001b[?2004l\r"]
[122.761539, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.761571, "o", "> "]
[122.761655, "o", "    message_body = f\"\"\"Hi,\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.761684, "o", "\u001b[?2004h> "]
[122.761772, "o", "Thank you for your meeting request.\r\n\u001b[?2004l\r"]
[122.761835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.761864, "o", "\u001b[?2004h> "]
[122.761892, "o", "I can be available:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.76198, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.76204, "o", "Date: {day_name}, {date_formatted}\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.762141, "o", "> Time: {time_range}\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.762201, "o", "> "]
[122.76227, "o", "Duration: {duration_hours} hour(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.7623, "o", "\u001b[?2004h> "]
[122.762438, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r"]
[122.762509, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.762533, "o", "Best regards,\r\n\u001b[?2004l\r"]
[122.762561, "o", "\u001b[?2004h> "]
[122.764453, "o", "SkillsBench\"\"\"\r\n\u001b[?2004l\r"]
[122.764537, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     message = MIMEText(message_body)\r\n\u001b[?2004l\r\u001b[?2004h>     message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h>     message['subject'] = 'Re: Meeting Request'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         sent_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h>             userId='me',\r\n\u001b[?2004l\r\u001b[?2004h>             body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h>         ).execute()\r\n\u001b[?2004l\r\u001b[?2004h>         return sent_message['id']\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Warning: Error sending email via API: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>         # Generate a mock message ID if API fails\r\n\u001b[?2004l\r\u001b[?2004h>         import hashlib\r\n\u001b[?2004l\r\u001b[?2004h>         mock_id = hashlib.md5(f\"{to_email}{proposed_time}\".encode()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>         return mock_id\r\n\u001b[?2004l\r"]
[122.764583, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.76476, "o", "> # Main workflow\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.764893, "o", "    gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.7655, "o", "    calendar_service = get_calendar_service()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for request in meeting_requests:\r\n\u001b[?2004l\r\u001b[?2004h>         from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h>         email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\nProcessing meeting request from {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.765599, "o", ">         # Parse meeting request\r\n\u001b[?2004l\r"]
[122.765659, "o", "\u001b[?2004h> "]
[122.76573, "o", "        meeting_info = parse_meeting_request(email_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.765854, "o", "        time_constraints = extract_time_constraints(email_text)\r\n\u001b[?2004l\r"]
[122.765957, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.766049, "o", "        print(f\"  Duration: {meeting_info['duration']} hours\")\r\n\u001b[?2004l\r"]
[122.766153, "o", "\u001b[?2004h> "]
[122.766409, "o", "        print(f\"  Available dates: {[d.strftime('%B %d, %Y') for d in meeting_info['dates']]}\")\r\n\u001b[?2004l\r"]
[122.766518, "o", "\u001b[?2004h> "]
[122.766604, "o", "        print(f\"  Time constraints: {time_constraints}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[122.766714, "o", "\u001b[?2004h>         # Find available slot\r\n\u001b[?2004l\r"]
[122.766785, "o", "\u001b[?2004h"]
[122.769269, "o", "> "]
