[95.712304, "o", "> "]
[95.712444, "o", "        start_of_day = date.isoformat() + 'T00:00:00Z'\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.712468, "o", "> "]
[95.712599, "o", "        end_of_day = date.isoformat() + 'T23:59:59Z'\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.712619, "o", ">         \r\n\u001b[?2004l\r"]
[95.712637, "o", "\u001b[?2004h"]
[95.712662, "o", "> "]
[95.712686, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.712866, "o", "            events_result = calendar_service.events().list(\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.712888, "o", "> "]
[95.712973, "o", "                calendarId='primary',\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.712993, "o", "> "]
[95.713092, "o", "                timeMin=start_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.713113, "o", "> "]
[95.713206, "o", "                timeMax=end_of_day,\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.713226, "o", "> "]
[95.71331, "o", "                singleEvents=True,\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.71333, "o", "> "]
[95.713423, "o", "                orderBy='startTime'\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.713446, "o", "> "]
[95.713534, "o", "            ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.713556, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.713703, "o", "            events = events_result.get('items', [])\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.713724, "o", "> "]
[95.713809, "o", "            busy_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.713898, "o", "            for event in events:\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.713917, "o", "> "]
[95.714134, "o", "                start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.714156, "o", "> "]
[95.714351, "o", "                end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.714371, "o", "> "]
[95.714495, "o", "                busy_times.append((start, end))\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.714516, "o", "> "]
[95.714532, "o", "            \r\n\u001b[?2004l\r"]
[95.71455, "o", "\u001b[?2004h> "]
[95.714719, "o", "            # Find free slot within time constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.714741, "o", "> "]
[95.714904, "o", "            start_hour = time_constraints.get('start_hour', 9)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.715062, "o", "            end_hour = time_constraints.get('end_hour', 17)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.715093, "o", "> "]
[95.715111, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.715275, "o", "            for hour in range(start_hour, end_hour):\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.715295, "o", "> "]
[95.715396, "o", "                for minute in [0, 30]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.715421, "o", "> "]
[95.715667, "o", "                    slot_start = date.replace(hour=hour, minute=minute, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.715687, "o", "> "]
[95.715884, "o", "                    slot_end = slot_start + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.715905, "o", "> "]
[95.715994, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.716094, "o", "                    # Check if slot is free\r\n\u001b[?2004l\r"]
[95.716112, "o", "\u001b[?2004h> "]
[95.716202, "o", "                    is_free = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.716223, "o", "> "]
[95.716377, "o", "                    for busy_start, busy_end in busy_times:\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.716397, "o", "> "]
[95.716564, "o", "                        # Handle both datetime and date formats\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.716584, "o", "> "]
[95.716713, "o", "                        if 'T' in str(busy_start):\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.716734, "o", "> "]
[95.71705, "o", "                            busy_start_dt = datetime.fromisoformat(busy_start.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.717071, "o", "> "]
[95.717293, "o", "                            busy_end_dt = datetime.fromisoformat(busy_end.replace('Z', '+00:00')).replace(tzinfo=None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717359, "o", "                        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717479, "o", "                            busy_start_dt = datetime.fromisoformat(busy_start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717605, "o", "                            busy_end_dt = datetime.fromisoformat(busy_end)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717666, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717806, "o", "                        if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.717881, "o", "                            is_free = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.717902, "o", "> "]
[95.717988, "o", "                            break\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r"]
[95.71801, "o", "\u001b[?2004h> "]
[95.718119, "o", "                    if is_free and slot_end.hour <= end_hour:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.718209, "o", "                        return slot_start, slot_end\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.718231, "o", "> "]
[95.718316, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.718382, "o", "            print(f\"Error checking calendar for {date}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.718406, "o", "> "]
[95.718493, "o", "            # Return a default slot if calendar check fails\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.718689, "o", "            return date.replace(hour=10, minute=0), date.replace(hour=10, minute=0) + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.718715, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.718827, "o", "    return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.718912, "o", "def send_reply_email(gmail_service, to_email, meeting_details, proposed_time):\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.718934, "o", "> "]
[95.719019, "o", "    \"\"\"Send reply email with proposed meeting time\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.719092, "o", "    start_time, end_time = proposed_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.719114, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[95.719133, "o", "> "]
[95.719239, "o", "    # Format date and time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.719261, "o", "    day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.719352, "o", "    date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.719374, "o", "> "]
[95.719499, "o", "    time_range = f\"{start_time.strftime('%I:%M %p')} - {end_time.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.719581, "o", "    duration_hours = meeting_details['duration']\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.719601, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[95.719683, "o", ">     message_body = f\"\"\"Hi,\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.719756, "o", "\u001b[?2004h> "]
[95.719781, "o", "Thank you for your meeting request.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.719801, "o", "\u001b[?2004h> "]
[95.719909, "o", "I can be available:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.719974, "o", "Date: {day_name}, {date_formatted}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72004, "o", "Time: {time_range}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.720109, "o", "Duration: {duration_hours} hour(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[95.720137, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[95.720269, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[95.720291, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[95.720377, "o", "Best regards,\r\n\u001b[?2004l\r\u001b[?2004h> SkillsBench\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.720398, "o", ">     \r\n\u001b[?2004l\r"]
[95.720418, "o", "\u001b[?2004h"]
[95.72044, "o", "> "]
[95.720571, "o", "    message = MIMEText(message_body)\r\n\u001b[?2004l\r\u001b[?2004h>     message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72064, "o", "    message['subject'] = 'Re: Meeting Request'\r\n\u001b[?2004l\r"]
[95.720661, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[95.720682, "o", "\u001b[?2004h> "]
[95.720807, "o", "    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\r\n\u001b[?2004l\r"]
[95.72083, "o", "\u001b[?2004h> "]
[95.720851, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[95.720874, "o", "> "]
[95.720898, "o", "    try:\r\n\u001b[?2004l\r"]
[95.72092, "o", "\u001b[?2004h> "]
[95.721105, "o", "        sent_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h>             userId='me',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.721176, "o", "            body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.721198, "o", "> "]
[95.721222, "o", "        ).execute()\r\n"]
[95.721243, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[95.721381, "o", "        return sent_message['id']\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.721405, "o", "> "]
[95.721492, "o", "        print(f\"Error sending email: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.721515, "o", "        return None\r\n\u001b[?2004l\r"]
[95.721604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Main workflow\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.721626, "o", "> try:\r\n\u001b[?2004l\r"]
[95.721646, "o", "\u001b[?2004h> "]
[95.721759, "o", "    gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.721825, "o", "    calendar_service = get_calendar_service()\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.721844, "o", ">     \r\n\u001b[?2004l\r"]
[95.721925, "o", "\u001b[?2004h>     for request in meeting_requests:\r\n\u001b[?2004l\r"]
[95.721947, "o", "\u001b[?2004h> "]
[95.722031, "o", "        from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.722114, "o", "        email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.722136, "o", "        \r\n\u001b[?2004l\r"]
[95.722155, "o", "\u001b[?2004h> "]
[95.722264, "o", "        print(f\"\\nProcessing meeting request from {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.722287, "o", ">         \r\n\u001b[?2004l\r"]
[95.722307, "o", "\u001b[?2004h> "]
[95.722416, "o", "        # Parse meeting request\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.722493, "o", "        meeting_info = parse_meeting_request(email_text)\r\n\u001b[?2004l\r"]
[95.722516, "o", "\u001b[?2004h> "]
[95.722623, "o", "        time_constraints = extract_time_constraints(email_text)\r\n\u001b[?2004l\r"]
[95.722655, "o", "\u001b[?2004h> "]
[95.722675, "o", "        \r\n"]
[95.722698, "o", "\u001b[?2004l\r"]
[95.722721, "o", "\u001b[?2004h> "]
[95.722887, "o", "        print(f\"  Duration: {meeting_info['duration']} hours\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72298, "o", "        print(f\"  Available dates: {[d.strftime('%B %d, %Y') for d in meeting_info['dates']]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.723002, "o", "> "]
[95.723098, "o", "        print(f\"  Time constraints: {time_constraints}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723171, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72324, "o", "        # Find available slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723307, "o", "        slot_start, slot_end = find_available_slot(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723373, "o", "            calendar_service,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723441, "o", "            meeting_info['dates'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723507, "o", "            meeting_info['duration'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723573, "o", "            time_constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723639, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723707, "o", "        if slot_start and slot_end:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72389, "o", "            print(f\"  Found slot: {slot_start.strftime('%B %d, %Y %I:%M %p')} - {slot_end.strftime('%I:%M %p')}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.723959, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724026, "o", "            # Send reply email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724097, "o", "            message_id = send_reply_email(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724166, "o", "                gmail_service,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724235, "o", "                from_email,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724308, "o", "                meeting_info,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724375, "o", "                (slot_start, slot_end)\r\n\u001b[?2004l\r"]
[95.724442, "o", "\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.72451, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724578, "o", "            if message_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724654, "o", "                sent_results.append({'messageId': message_id})\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.724724, "o", "> "]
[95.724794, "o", "                print(f\"  Email sent with message ID: {message_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724864, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.724933, "o", "                print(f\"  Failed to send email\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725001, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725065, "o", "            print(f\"  Could not find available slot\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725146, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Save results\r\n\u001b[?2004l\r"]
[95.72521, "o", "\u001b[?2004h> "]
[95.725275, "o", "    with open('/root/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725351, "o", "        json.dump({'sent_results': sent_results}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.725419, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725507, "o", "    print(f\"\\n\\nScheduling complete. Sent {len(sent_results)} emails.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.725575, "o", "> "]
[95.725643, "o", "    print(f\"Results saved to /root/results.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725713, "o", "except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725781, "o", "    print(f\"Error in main workflow: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725847, "o", "    import traceback\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.725915, "o", "    traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
