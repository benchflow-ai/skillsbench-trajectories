[21.569099, "i", "python3 << 'EOF'\nimport PyPDF2\nimport pdfplumber\n\n# Try to read the PDF\ntry:\n    with pdfplumber.open('/root/population.pdf') as pdf:\n        print(f\"PDF has {len(pdf.pages)} pages\")\n        print(\"\\nFirst page content:\")\n        first_page = pdf.pages[0]\n        text = first_page.extract_text()\n        print(text[:1000])\n        print(\"\\n...\")\n        \n        # Try to extract tables\n        tables = first_page.extract_tables()\n        if tables:\n            print(f\"\\nFound {len(tables)} table(s) on first page\")\n            if tables[0]:\n                print(\"\\nFirst table sample:\")\n                for row in tables[0][:10]:\n                    print(row)\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
