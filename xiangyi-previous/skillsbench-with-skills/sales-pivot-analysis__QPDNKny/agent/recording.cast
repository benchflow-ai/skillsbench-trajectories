[33.094495, "i", "python3 << 'EOF'\nimport pandas as pd\nimport pdfplumber\nfrom openpyxl import Workbook\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nfrom openpyxl.worksheet.pivot_table import PivotTable, PivotTableReference\nimport numpy as np\n\n# Extract data from PDF\nprint(\"Extracting data from PDF...\")\npopulation_data = []\n\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        if tables and tables[0]:\n            for row_idx, row in enumerate(tables[0]):\n                # Skip header rows\n                if row_idx == 0 and page_num == 0:\n                    continue\n                if len(row) >= 4:\n                    population_data.append({\n                        'SA2_CODE': row[0],\n                        'SA2_NAME': row[1],\n                        'STATE': row[2],\n                        'POPULATION_2023': row[3]\n                    })\n        if (page_num + 1) % 10 == 0:\n            print(f\"Processed {page_num + 1} pages...\")\n\npop_df = pd.DataFrame(population_data)\nprint(f\"\\nExtracted {len(pop_df)} population records\")\nprint(\"Population data sample:\")\nprint(pop_df.head())\nprint(f\"\\nPopulation data shape: {pop_df.shape}\")\nEOF\n"]
