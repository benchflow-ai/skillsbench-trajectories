[114.403946, "o", "Quarter                         STATE        Q1        Q2        Q3         Q4\r\n0        Australian Capital Territory    1004.0     549.0   16991.0   176177.0\r\n1                     New South Wales  575049.0  593938.0  824335.0  1206903.0\r\n2                  Northern Territory   10836.0    1328.0   17720.0    34435.0\r\n3                          Queensland  468970.0  529021.0  538854.0   392505.0\r\n4                     South Australia  146484.0  286428.0  230471.0    50885.0\r\n5                            Tasmania   34164.0  145893.0   55456.0        0.0\r\n6                            Victoria  483476.0  659344.0  820164.0   453208.0\r\n7                   Western Australia   78817.0  303917.0  348542.0   372136.0\r\n"]
[114.69531, "o", "\u001b[?2004hroot@77058f0212a8:~# "]
[134.77125, "i", "python3 << 'EOF'\nimport pandas as pd\nimport pdfplumber\nfrom openpyxl import Workbook\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nimport numpy as np\n\n# Extract data from PDF\nprint(\"Extracting data from PDF...\")\npopulation_data = []\n\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        if tables and tables[0]:\n            for row_idx, row in enumerate(tables[0]):\n                if row_idx == 0 and page_num == 0:\n                    continue\n                if len(row) >= 4:\n                    population_data.append({\n                        'SA2_CODE': int(row[0]),\n                        'SA2_NAME': row[1],\n                        'STATE': row[2],\n                        'POPULATION_2023': int(row[3])\n                    })\n\npop_df = pd.DataFrame(population_data)\n\n# Read income data\nprint(\"Reading income data...\")\nincome_df = pd.read_excel('/root/income.xlsx')\nincome_df['EARNERS'] = pd.to_numeric(income_df['EARNERS'], errors='coerce')\nincome_df['MEDIAN_INCOME'] = pd.to_numeric(income_df['MEDIAN_INCOME'], errors='coerce')\nincome_df['MEAN_INCOME'] = pd.to_numeric(income_df['MEAN_INCOME'], errors='coerce')\n\n# Merge on SA2_CODE\nmerged_df = pd.merge(income_df[['SA2_CODE', 'SA2_NAME', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME']], \n                     pop_df, on='SA2_CODE', how='inner')\nmerged_df = merged_df[['SA2_CODE', 'SA2_NAME_x', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', 'STATE', 'POPULATION_2023']]\nmerged_df.rename(columns={'SA2_NAME_x': 'SA2_NAME'}, inplace=True)\n\n# Create quartiles\nquartiles = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'], duplicates='drop')\nmerged_df['Quarter'] = quartiles\nmerged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\n\nprint(\"Creating pivot tables...\")\n\n# Pivot Table 1: Population by State\npop_by_state = merged_df.groupby('STATE')['POPULATION_2023'].sum().reset_index()\npop_by_state.columns = ['STATE', 'Sum of POPULATION_2023']\n\n# Pivot Table 2: Earners by State\nearners_by_state = merged_df.groupby('STATE')['EARNERS'].sum().reset_index()\nearners_by_state.columns = ['STATE', 'Sum of EARNERS']\n\n# Pivot Table 3: Regions by State (Count of SA2)\nregions_by_state = merged_df.groupby('STATE').size().reset_index(name='Count')\nregions_by_state.columns = ['STATE', 'Count']\n\n# Pivot Table 4: State Income Quartile\nstate_income_quartile = pd.pivot_table(merged_df, values='EARNERS', index='STATE', columns='Quarter', aggfunc='sum', fill_value=0, observed=False)\nstate_income_quartile = state_income_quartile.reset_index()\n\n# Create Excel workbook\nprint(\"Creating Excel workbook...\")\nwb = Workbook()\nwb.remove(wb.active)  # Remove default sheet\n\n# Sheet 1: Population by State\nws1 = wb.create_sheet('Population by State')\nfor r_idx, row in enumerate(dataframe_to_rows(pop_by_state, index=False, header=True), 1):\n    for c_idx, value in enumerate(row, 1):\n        ws1.cell(row=r_idx, column=c_idx, value=value)\n\n# Sheet 2: Earners by State\nws2 = wb.create_sheet('Earners by State')\nfor r_idx, row in enumerate(dataframe_to_rows(earners_by_state, index=False, header=True), 1):\n    for c_idx, value in enumerate(row, 1):\n        ws2.cell(row=r_idx, column=c_idx, value=value)\n\n# Sheet 3: Regions by State\nws3 = wb.create_sheet('Regions by State')\nfor r_idx, row in enumerate(dataframe_to_rows(regions_by_state, index=False, header=True), 1):\n    for c_idx, value in enumerate(row, 1):\n        ws3.cell(row=r_idx, column=c_idx, value=value)\n\n# Sheet 4: State Income Quartile\nws4 = wb.create_sheet('State Income Quartile')\nfor r_idx, row in enumerate(dataframe_to_rows(state_income_quartile, index=False, header=True), 1):\n    for c_idx, value in enumerate(row, 1):\n        ws4.cell(row=r_idx, column=c_idx, value=value)\n\n# Sheet 5: SourceData\nws5 = wb.create_sheet('SourceData')\nfor r_idx, row in enumerate(dataframe_to_rows(merged_df, index=False, header=True), 1):\n    for c_idx, value in enumerate(row, 1):\n        ws5.cell(row=r_idx, column=c_idx, value=value)\n\n# Save workbook\nprint(\"Savi"]
[134.771321, "i", "ng workbook...\")\nwb.save('/root/demographic_analysis.xlsx')\nprint(\"\\nDone! File saved to /root/demographic_analysis.xlsx\")\nprint(f\"\\nSummary:\")\nprint(f\"- Population by State: {len(pop_by_state)} rows\")\nprint(f\"- Earners by State: {len(earners_by_state)} rows\")\nprint(f\"- Regions by State: {len(regions_by_state)} rows\")\nprint(f\"- State Income Quartile: {len(state_income_quartile)} rows\")\nprint(f\"- SourceData: {len(merged_df)} rows\")\nEOF\n"]
