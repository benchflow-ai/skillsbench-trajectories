[84.188555, "i", "python3 << 'EOF'\nimport pandas as pd\nimport pdfplumber\nfrom openpyxl import Workbook\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nimport numpy as np\n\n# Extract data from PDF\nprint(\"Extracting data from PDF...\")\npopulation_data = []\n\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        if tables and tables[0]:\n            for row_idx, row in enumerate(tables[0]):\n                if row_idx == 0 and page_num == 0:\n                    continue\n                if len(row) >= 4:\n                    population_data.append({\n                        'SA2_CODE': int(row[0]),\n                        'SA2_NAME': row[1],\n                        'STATE': row[2],\n                        'POPULATION_2023': int(row[3])\n                    })\n\npop_df = pd.DataFrame(population_data)\n\n# Read income data\nprint(\"Reading income data...\")\nincome_df = pd.read_excel('/root/income.xlsx')\n\n# Clean up income data - convert to numeric\nincome_df['EARNERS'] = pd.to_numeric(income_df['EARNERS'], errors='coerce')\nincome_df['MEDIAN_INCOME'] = pd.to_numeric(income_df['MEDIAN_INCOME'], errors='coerce')\nincome_df['MEAN_INCOME'] = pd.to_numeric(income_df['MEAN_INCOME'], errors='coerce')\n\n# Merge on SA2_CODE\nmerged_df = pd.merge(income_df[['SA2_CODE', 'SA2_NAME', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME']], \n                     pop_df, on='SA2_CODE', how='inner')\n\n# Clean up - use SA2_NAME from income data\nmerged_df = merged_df[['SA2_CODE', 'SA2_NAME_x', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', 'STATE', 'POPULATION_2023']]\nmerged_df.rename(columns={'SA2_NAME_x': 'SA2_NAME'}, inplace=True)\n\nprint(f\"Merged data shape: {merged_df.shape}\")\n\n# Create quartiles based on MEDIAN_INCOME\nprint(\"Creating quartiles...\")\nquartiles = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'], duplicates='drop')\nmerged_df['Quarter'] = quartiles\n\nprint(f\"Quartile distribution:\")\nprint(merged_df['Quarter'].value_counts().sort_index())\n\n# Create Total column\nmerged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\n\nprint(\"\\nSourceData sample:\")\nprint(merged_df.head())\nprint(f\"\\nSourceData shape: {merged_df.shape}\")\nEOF\n"]
