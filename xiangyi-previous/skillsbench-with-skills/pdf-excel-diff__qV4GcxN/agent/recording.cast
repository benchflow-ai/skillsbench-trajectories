[70.83647, "i", "python3 << 'EOF'\nimport pandas as pd\nimport json\nimport re\n\n# Parse PDF text file\nwith open('/tmp/pdf_text.txt', 'r') as f:\n    lines = [line.strip() for line in f.readlines() if line.strip()]\n\n# Find header row\nheader_idx = 0\nfor i, line in enumerate(lines):\n    if line == 'ID':\n        header_idx = i\n        break\n\n# Extract headers\nheaders = []\ni = header_idx\nwhile i < len(lines) and lines[i] in ['ID', 'First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:\n    headers.append(lines[i])\n    i += 1\n\nprint(f\"Headers: {headers}\")\nprint(f\"Number of headers: {len(headers)}\")\nprint(f\"Data starts at line: {i}\")\n\n# Parse employee records\nemployees = []\ndata_lines = lines[i:]\n\n# Each employee has 9 fields\nfor j in range(0, len(data_lines), 9):\n    if j + 8 < len(data_lines):\n        emp = {\n            'ID': data_lines[j],\n            'First': data_lines[j+1],\n            'Last': data_lines[j+2],\n            'Dept': data_lines[j+3],\n            'Position': data_lines[j+4],\n            'Salary': data_lines[j+5],\n            'Years': data_lines[j+6],\n            'Location': data_lines[j+7],\n            'Score': data_lines[j+8]\n        }\n        employees.append(emp)\n\nprint(f\"\\nTotal employees in PDF: {len(employees)}\")\nprint(\"\\nFirst 5 employees:\")\nfor emp in employees[:5]:\n    print(emp)\n\nEOF\n"]
