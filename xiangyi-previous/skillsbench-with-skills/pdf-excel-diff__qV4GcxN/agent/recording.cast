[119.03522, "o", "\u001b[?2004hroot@ea67d6c7405a:~# "]
[144.850941, "i", "python3 << 'EOF'\nimport tabula\nimport pandas as pd\nimport json\n\n# Extract table from PDF\nprint(\"Loading PDF data...\")\npdf_dfs = tabula.read_pdf('/root/employees_backup.pdf', pages='all', multiple_tables=False)\npdf_df = pdf_dfs[0] if isinstance(pdf_dfs, list) else pdf_dfs\n\n# Clean PDF data - remove commas from Salary\npdf_df['Salary'] = pdf_df['Salary'].astype(str).str.replace(',', '').astype(int)\n\n# Load Excel data\nprint(\"Loading Excel data...\")\nxlsx_df = pd.read_excel('/root/employees_current.xlsx')\n\nprint(f\"PDF employees: {len(pdf_df)}\")\nprint(f\"Excel employees: {len(xlsx_df)}\")\n\n# Set ID as index for easier comparison\npdf_df.set_index('ID', inplace=True)\nxlsx_df.set_index('ID', inplace=True)\n\n# Find deleted employees (in PDF but not in Excel)\ndeleted_ids = set(pdf_df.index) - set(xlsx_df.index)\ndeleted_employees = sorted(list(deleted_ids))\n\nprint(f\"\\nDeleted employees: {len(deleted_employees)}\")\nprint(deleted_employees[:10])\n\n# Find modified employees (same ID but different values)\nmodified_employees = []\ncommon_ids = set(pdf_df.index) & set(xlsx_df.index)\n\nfor emp_id in sorted(common_ids):\n    pdf_row = pdf_df.loc[emp_id]\n    xlsx_row = xlsx_df.loc[emp_id]\n    \n    # Compare each field\n    for col in pdf_df.columns:\n        pdf_val = pdf_row[col]\n        xlsx_val = xlsx_row[col]\n        \n        # Handle different types\n        if pd.isna(pdf_val) and pd.isna(xlsx_val):\n            continue\n        \n        if pdf_val != xlsx_val:\n            # Determine if numeric or text field\n            if col in ['Salary', 'Years', 'Score']:\n                old_val = float(pdf_val) if col == 'Score' else int(pdf_val)\n                new_val = float(xlsx_val) if col == 'Score' else int(xlsx_val)\n            else:\n                old_val = str(pdf_val)\n                new_val = str(xlsx_val)\n            \n            modified_employees.append({\n                \"id\": emp_id,\n                \"field\": col,\n                \"old_value\": old_val,\n                \"new_value\": new_val\n            })\n\nprint(f\"\\nModified employee records: {len(modified_employees)}\")\nprint(\"First 10 modifications:\")\nfor mod in modified_employees[:10]:\n    print(mod)\n\n# Create final report\nreport = {\n    \"deleted_employees\": deleted_employees,\n    \"modified_employees\": modified_employees\n}\n\n# Save to JSON file\nwith open('/root/diff_report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nReport saved to /root/diff_report.json\")\nprint(f\"Total deleted: {len(deleted_employees)}\")\nprint(f\"Total modifications: {len(modified_employees)}\")\n\nEOF\n"]
