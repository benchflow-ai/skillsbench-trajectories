[100.400047, "i", "python3 << 'EOF'\nimport tabula\nimport pandas as pd\n\n# Extract table from PDF using tabula\nprint(\"Extracting table from PDF using tabula...\")\npdf_dfs = tabula.read_pdf('/root/employees_backup.pdf', pages='all', multiple_tables=False)\n\nif pdf_dfs:\n    pdf_df = pdf_dfs[0] if isinstance(pdf_dfs, list) else pdf_dfs\n    print(f\"PDF shape: {pdf_df.shape}\")\n    print(f\"PDF columns: {pdf_df.columns.tolist()}\")\n    print(\"\\nFirst 10 rows:\")\n    print(pdf_df.head(10))\n    print(\"\\nLast 5 rows:\")\n    print(pdf_df.tail(5))\nelse:\n    print(\"No tables found\")\n\nEOF\n"]
