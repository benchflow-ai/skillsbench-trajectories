[25.550106, "i", "cat > /tmp/compare_employees.py << 'EOF'\nimport pdfplumber\nimport pandas as pd\nimport json\n\n# Extract data from PDF\nprint(\"Extracting data from PDF...\")\nwith pdfplumber.open('/root/employees_backup.pdf') as pdf:\n    # Try to extract tables from all pages\n    all_tables = []\n    for page in pdf.pages:\n        tables = page.extract_tables()\n        if tables:\n            all_tables.extend(tables)\n    \n    # Assuming the first table is the employee table\n    if all_tables:\n        pdf_table = all_tables[0]\n        # Convert to DataFrame\n        pdf_df = pd.DataFrame(pdf_table[1:], columns=pdf_table[0])\n        print(f\"PDF columns: {pdf_df.columns.tolist()}\")\n        print(f\"PDF shape: {pdf_df.shape}\")\n        print(pdf_df.head())\n\n# Load Excel file\nprint(\"\\nLoading Excel file...\")\nxlsx_df = pd.read_excel('/root/employees_current.xlsx')\nprint(f\"Excel columns: {xlsx_df.columns.tolist()}\")\nprint(f\"Excel shape: {xlsx_df.shape}\")\nprint(xlsx_df.head())\n\nEOF\n"]
