[?2004l[?2004h> task = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> print("Adding formulas to Task sheet...")
[?2004l[?2004h> 
[?2004lg[?2004h> # Step 1: Add INDEX-MATCH formulas in C11:L20
[?2004l[?2004h> # Formula: =INDEX(Data!$A$1:$BA$201,MATCH($A11,Data!$A:$A,0),MATCH(C$10,Data!$1:$1,0))
[?2004l[?2004h> print("\nStep 1: Adding expression lookup formulas (C11:L20)")
[?2004l[?2004h> for row in range(11, 21):  # Rows 11-20
[?2004l[?2004h>     for col in range(3, 13):  # Columns C-L (3-12)
[?2004l[?2004h>         col_letter = get_column_letter(col)
[?2004l[?2004h>         formula = f'=INDEX(Data!$A$1:$BA$201,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'
[?2004l[?2004h>         task.cell(row=row, column=col).value = formula
[?2004l[?2004h>         if row == 11 and col == 3:
[?2004l[?2004h>             print(f"  Sample formula at C11: {formula}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"  Added formulas to cells C11:L20")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Add statistics formulas in rows 24-27, columns B-K
[?2004l[?2004h> # The statistics are per protein (columns), so we need to reference the correct row
[?2004l[?2004h> # Row 24: Control Mean - AVERAGE of C:G for each protein in rows 11-20
[?2004l[?2004h> # Row 25: Control StdDev - STDEV of C:G
[?2004l[?2004h> # Row 26: Treated Mean - AVERAGE of H:L
[?2004l[?2004h> # Row 27: Treated StdDev - STDEV of H:L
[?2004l[?2004h> 
[?2004l[?2004h> print("\nStep 2: Adding statistics formulas (B24:K27)")
[?2004l[?2004h> 
[?2004l[?2004h> # Column B corresponds to protein in row 11, C to row 12, etc.
[?2004l[?2004h> # Wait, let me re-check the structure...
[?2004l[?2004h> # Looking at the headers, row 23 has "Statistic" in A23
[?2004l[?2004h> # The statistics should be per-protein, with proteins as columns
[?2004l[?2004h> 
[?2004l[?2004h> # Actually looking at the task description again:
[?2004l[?2004h> # "Put your results in the yellow cells, rows 24-27, columns B-K"
[?2004l[?2004h> # So we have 10 columns (B-K) for 10 proteins
[?2004l[?2004h> 
[?2004l[?2004h> # For each protein (columns B-K map to proteins in rows 11-20):
[?2004l[?2004h> # - B24: Control Mean for protein in row 11 = AVERAGE(C11:G11)
[?2004l[?2004h> # - B25: Control StdDev for protein in row 11 = STDEV(C11:G11)
[?2004l[?2004h> # - etc.
[?2004l[?2004h> 
[?2004l[?2004h> for i, col in enumerate(range(2, 12)):  # Columns B-K (2-11)
[?2004l[?2004h>     protein_row = 11 + i  # Rows 11-20
[?2004l[?2004h>     col_letter = get_column_letter(col)
[?2004l[?2004h>     
[?2004l[?2004h>     # Control Mean (columns C-G are control)
[?2004l[?2004h>     formula_ctrl_mean = f'=AVERAGE(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     task.cell(row=24, column=col).value = formula_ctrl_mean
[?2004l[?2004h>     
[?2004l[?2004h>     # Control StdDev
[?2004l[?2004h>     formula_ctrl_std = f'=STDEV(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     task.cell(row=25, column=col).value = formula_ctrl_std
[?2004l[?2004h>     
[?2004l[?2004h>     # Treated Mean (columns H-L are treated)
[?2004l[?2004h>     formula_treat_mean = f'=AVERAGE(H{protein_row}:L{protein_row})'
[?2004l[?2004h>     task.cell(row=26, column=col).value = formula_treat_mean
[?2004l[?2004h>     
[?2004l[?2004h>     # Treated StdDev
[?2004l[?2004h>     formula_treat_std = f'=STDEV(H{protein_row}:L{protein_row})'
[?2004l[?2004h>     task.cell(row=27, column=col).value = formula_treat_std
[?2004l[?2004h>     
[?2004l[?2004h>     if col == 2:
[?2004l[?2004h>         print(f"  Sample formulas for column B (protein row 11):")
[?2004l[?2004h>         print(f"    B24 Control Mean: {formula_ctrl_mean}")
[?2004l[?2004h>         print(f"    B25 Control StdDev: {formula_ctrl_std}")
[?2004l[?2004h>         print(f"    B26 Treated Mean: {formula_treat_mean}")
[?2004l[?2004h>         print(f"    B27 Treated StdDev: {formula_treat_std}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"  Added formulas to cells B24:K27")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Add fold change formulas in rows 32-41
[?2004l[?2004h> # Column A: Protein_ID (reference from A11:A20)
[?2004l[?2004h> # Column B: Gene_Symbol (reference from B11:B20)
[?2004l[?2004h> # Column C: Fold Change = 2^(Log2 FC)
[?2004l[?2004h> # Column D: Log2 FC = Treated Mean - Control Mean
[?2004l[?2004h> 
[?2004l[?2004h> print("\nStep 3: Adding fold change formulas (A32:D41)")
[?2004l[?2004h> 
[?2004l[?2004h> for i, row in enumerate(range(32, 42)):  # Rows 32-41
[?2004l[?2004h>     protein_row = 11 + i  # Rows 11-20
[?2004l[?2004h>     stat_col = 2 + i  # Columns B-K (2-11) for statistics
[?2004l[?2004h>     stat_col_letter = get_column_letter(stat_col)
[?2004l[?2004h>     
[?2004l[?2004h>     # Column A: Protein_ID
[?2004l[?2004h>     task.cell(row=row, column=1).value = f'=A{protein_row}'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column B: Gene_Symbol
[?2004l[?2004h>     task.cell(row=row, column=2).value = f'=B{protein_row}'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column D: Log2 FC = Treated Mean - Control Mean
[?2004l[?2004h>     # Treated Mean is in row 26, Control Mean is in row 24
[?2004l[?2004h>     formula_log2fc = f'={stat_col_letter}26-{stat_col_letter}24'
[?2004l[?2004h>     task.cell(row=row, column=4).value = formula_log2fc
[?2004l[?2004h>     
[?2004l[?2004h>     # Column C: Fold Change = 2^(Log2 FC)
