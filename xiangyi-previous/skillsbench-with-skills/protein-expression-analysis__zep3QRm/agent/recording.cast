[171.678328, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\nprint(\"=== Final Verification of All Formulas ===\")\n\n# Check all fold change formulas\nprint(\"\\nFold Change formulas (rows 32-41):\")\nfor row in range(32, 42):\n    a_val = task.cell(row=row, column=1).value\n    b_val = task.cell(row=row, column=2).value\n    c_val = task.cell(row=row, column=3).value\n    d_val = task.cell(row=row, column=4).value\n    print(f\"  Row {row}: A={a_val}, B={b_val}, C={c_val}, D={d_val}\")\n\n# Verify the statistics column headers match\nprint(\"\\nStatistics row 23 headers (should match protein order):\")\nfor col in range(2, 12):\n    val = task.cell(row=23, column=col).value\n    print(f\"  Col {openpyxl.utils.get_column_letter(col)}: {val}\")\n\n# Check if there are headers in row 23\nprint(\"\\nChecking if row 10 can serve as headers for statistics:\")\nfor col in range(2, 12):\n    # The proteins in rows 11-20 correspond to stats in columns B-K\n    protein_row = 11 + (col - 2)\n    protein_id = task.cell(row=protein_row, column=1).value\n    gene_symbol = task.cell(row=protein_row, column=2).value\n    print(f\"  Stats col {openpyxl.utils.get_column_letter(col)} -> Protein row {protein_row}: {gene_symbol}\")\n\nwb.close()\nEOF\n"]
