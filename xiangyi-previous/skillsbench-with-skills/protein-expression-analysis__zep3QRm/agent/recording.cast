[114.887953, "o", "\u001b[?2004h> "]
[114.888009, "o", "for i, row in enumerate(range(32, 42)):  # Rows 32-41\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.888055, "o", "> "]
[114.888109, "o", "    protein_row = 11 + i  # Rows 11-20\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888187, "o", "    stat_col = 2 + i  # Columns B-K (2-11) for statistics\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.888243, "o", "> "]
[114.888295, "o", "    stat_col_letter = get_column_letter(stat_col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888348, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888399, "o", "    # Column A: Protein_ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888468, "o", "    task.cell(row=row, column=1).value = f'=A{protein_row}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888514, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
