[34.334542, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ndata = wb['Data']\n\nprint(\"=== DATA SHEET ===\")\nprint(f\"Dimensions: {data.dimensions}\")\n\n# Check first few rows to understand structure\nprint(\"\\nFirst row (headers):\")\nfor col in range(1, 10):\n    val = data.cell(row=1, column=col).value\n    print(f\"  Col {col}: {val}\")\n\nprint(\"\\n... checking more columns in row 1:\")\nfor col in range(10, 55):\n    val = data.cell(row=1, column=col).value\n    if val:\n        print(f\"  Col {col}: {val}\")\n\n# Check first column (protein IDs)\nprint(\"\\nFirst column (first 10 proteins):\")\nfor row in range(1, 12):\n    val = data.cell(row=row, column=1).value\n    print(f\"  Row {row}: {val}\")\n\nprint(\"\\nTotal rows in data sheet:\")\nprint(f\"  Max row: {data.max_row}\")\nprint(f\"  Max col: {data.max_column}\")\n\nwb.close()\nEOF\n"]
