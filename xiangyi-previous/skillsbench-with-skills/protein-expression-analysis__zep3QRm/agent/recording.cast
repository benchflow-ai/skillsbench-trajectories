[171.679026, "o", "# Check all fold change formulas\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.67911, "o", "print(\"\\nFold Change formulas (rows 32-41):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679167, "o", "for row in range(32, 42):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679337, "o", "    a_val = task.cell(row=row, column=1).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679415, "o", "    b_val = task.cell(row=row, column=2).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679481, "o", "    c_val = task.cell(row=row, column=3).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679557, "o", "    d_val = task.cell(row=row, column=4).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679639, "o", "    print(f\"  Row {row}: A={a_val}, B={b_val}, C={c_val}, D={d_val}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.679681, "o", "\u001b[?2004h> "]
[171.679866, "o", "# Verify the statistics column headers match\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nStatistics row 23 headers (should match protein order):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.679938, "o", "for col in range(2, 12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680042, "o", "    val = task.cell(row=23, column=col).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680114, "o", "    print(f\"  Col {openpyxl.utils.get_column_letter(col)}: {val}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.68018, "o", "\u001b[?2004h> "]
[171.680248, "o", "# Check if there are headers in row 23\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.68033, "o", "print(\"\\nChecking if row 10 can serve as headers for statistics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680419, "o", "for col in range(2, 12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680547, "o", "    # The proteins in rows 11-20 correspond to stats in columns B-K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680646, "o", "    protein_row = 11 + (col - 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680723, "o", "    protein_id = task.cell(row=protein_row, column=1).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680793, "o", "    gene_symbol = task.cell(row=protein_row, column=2).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.680993, "o", "    print(f\"  Stats col {openpyxl.utils.get_column_letter(col)} -> Protein row {protein_row}: {gene_symbol}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.681124, "o", "wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.681206, "o", "EOF\r\n\u001b[?2004l\r"]
[171.886598, "o", "=== Final Verification of All Formulas ===\r\n\r\nFold Change formulas (rows 32-41):\r\n  Row 32: A==A11, B==B11, C==POWER(2,D32), D==B26-B24\r\n  Row 33: A==A12, B==B12, C==POWER(2,D33), D==C26-C24\r\n  Row 34: A==A13, B==B13, C==POWER(2,D34), D==D26-D24\r\n  Row 35: A==A14, B==B14, C==POWER(2,D35), D==E26-E24\r\n"]
[171.886649, "o", "  Row 36: A==A15, B==B15, C==POWER(2,D36), D==F26-F24\r\n  Row 37: A==A16, B==B16, C==POWER(2,D37), D==G26-G24\r\n  Row 38: A==A17, B==B17, C==POWER(2,D38), D==H26-H24\r\n  Row 39: A==A18, B==B18, C==POWER(2,D39), D==I26-I24\r\n  Row 40: A==A19, B==B19, C==POWER(2,D40), D==J26-J24\r\n  Row 41: A==A20, B==B20, C==POWER(2,D41), D==K26-K24\r\n\r\nStatistics row 23 headers (should match protein order):\r\n"]
[171.886684, "o", "  Col B: None\r\n  Col C: None\r\n"]
[171.886707, "o", "  Col D: None\r\n  Col E: None\r\n  Col F: None\r\n"]
[171.886737, "o", "  Col G: None\r\n  Col H: None\r\n  Col I: None\r\n"]
[171.886764, "o", "  Col J: None\r\n  Col K: None\r\n\r\nChecking if row 10 can serve as headers for statistics:\r\n"]
[171.88679, "o", "  Stats col B -> Protein row 11: S100A14\r\n  Stats col C -> Protein row 12: MOCOS\r\n  Stats col D -> Protein row 13: CCDC84\r\n"]
[171.886816, "o", "  Stats col E -> Protein row 14: NDUFB10\r\n  Stats col F -> Protein row 15: XYLT1\r\n  Stats col G -> Protein row 16: CEP85L\r\n"]
[171.886843, "o", "  Stats col H -> Protein row 17: WDR77\r\n  Stats col I -> Protein row 18: CEP44\r\n  Stats col J -> Protein row 19: SEPT3\r\n"]
[171.886872, "o", "  Stats col K -> Protein row 20: CAPNS1\r\n"]
