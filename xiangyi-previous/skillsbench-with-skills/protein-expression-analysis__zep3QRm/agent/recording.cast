[66.382912, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\nprint(\"=== Row 23 (statistics headers) ===\")\nfor col in range(1, 13):\n    val = task.cell(row=23, column=col).value\n    if val is not None:\n        print(f\"  {openpyxl.utils.get_column_letter(col)}23: {val}\")\n\nprint(\"\\n=== Fold change section rows 32-41 ===\")\nfor row in range(32, 42):\n    row_vals = []\n    for col in range(1, 5):\n        val = task.cell(row=row, column=col).value\n        col_letter = openpyxl.utils.get_column_letter(col)\n        row_vals.append(f\"{col_letter}:{val}\")\n    print(f\"Row {row}: {row_vals}\")\n\n# Also check what's in the yellow cells area\nprint(\"\\n=== Checking cell fills (yellow cells) ===\")\nfrom openpyxl.styles import PatternFill\nfor row in [24, 25, 26, 27]:\n    for col in range(2, 12):\n        cell = task.cell(row=row, column=col)\n        fill = cell.fill\n        if fill.fgColor and fill.fgColor.rgb and fill.fgColor.rgb != '00000000':\n            print(f\"  {openpyxl.utils.get_column_letter(col)}{row}: fill={fill.fgColor.rgb}\")\n            break\n    break\n\nwb.close()\nEOF\n"]
