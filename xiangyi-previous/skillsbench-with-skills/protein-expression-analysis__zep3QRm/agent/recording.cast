[127.540313, "o", "=== Verification ===\r\n\r\nStep 1 - Expression lookups (sample cells):\r\n  C11: =INDEX(Data!$A$1:$BA$201,MATCH($A11,Data!$A:$A,0),MATCH(C$10,Data!$1:$1,0))\r\n  L11: =INDEX(Data!$A$1:$BA$201,MATCH($A11,Data!$A:$A,0),MATCH(L$10,Data!$1:$1,0))\r\n  C20: =INDEX(Data!$A$1:$BA$201,MATCH($A20,Data!$A:$A,0),MATCH(C$10,Data!$1:$1,0))\r\n  L20: =INDEX(Data!$A$1:$BA$201,MATCH($A20,Data!$A:$A,0),MATCH(L$10,Data!$1:$1,0))\r\n\r\n"]
[127.540367, "o", "Step 2 - Statistics formulas (sample cells):\r\n  B24: =AVERAGE(C11:G11)\r\n  K24: =AVERAGE(C20:G20)\r\n  B25: =STDEV(C11:G11)\r\n  K25: =STDEV(C20:G20)\r\n  B26: =AVERAGE(H11:L11)\r\n  K26: =AVERAGE(H20:L20)\r\n  B27: =STDEV(H11:L11)\r\n  K27: =STDEV(H20:L20)\r\n\r\nStep 3 - Fold change formulas (sample cells):\r\n  A32: =A11\r\n  B32: =B11\r\n"]
[127.540531, "o", "  C32: =POWER(2,D32)\r\n  D32: =B26-B24\r\n  A41: =A20\r\n"]
[127.540594, "o", "  B41: =B20\r\n  C41: =POWER(2,D41)\r\n  D41: =K26-K24\r\n\r\nFormatting check (yellow cells):\r\n  B24 fill color: 00FFFF00\r\n\r\nVerification complete!\r\n"]
