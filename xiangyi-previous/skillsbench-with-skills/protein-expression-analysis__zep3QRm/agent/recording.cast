[50.979256, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\nprint(\"=== TASK SHEET - Statistics section (rows 22-28) ===\")\nfor row in range(22, 29):\n    row_vals = []\n    for col in range(1, 13):\n        val = task.cell(row=row, column=col).value\n        if val is not None:\n            row_vals.append(f\"{openpyxl.utils.get_column_letter(col)}{row}:{val}\")\n    if row_vals:\n        print(f\"Row {row}: {row_vals}\")\n\nprint(\"\\n=== TASK SHEET - Fold change section (rows 30-42) ===\")\nfor row in range(30, 43):\n    row_vals = []\n    for col in range(1, 6):\n        val = task.cell(row=row, column=col).value\n        if val is not None:\n            row_vals.append(f\"{openpyxl.utils.get_column_letter(col)}{row}:{val}\")\n    if row_vals:\n        print(f\"Row {row}: {row_vals}\")\n\n# Check column B for rows 11-20 (Gene_Symbol)\nprint(\"\\n=== Column B rows 11-20 (Gene Symbols) ===\")\nfor row in range(11, 21):\n    val = task.cell(row=row, column=2).value\n    print(f\"  Row {row}: {val}\")\n\nwb.close()\nEOF\n"]
