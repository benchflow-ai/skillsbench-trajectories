[83.227367, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load workbook preserving formatting\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\ndata = wb['Data']\n\n# Get the sample names from Task sheet row 10 (columns C-L)\nsample_names = []\nfor col in range(3, 13):  # C to L\n    sample_names.append(task.cell(row=10, column=col).value)\nprint(\"Sample names from Task sheet:\", sample_names)\n\n# Get the protein IDs from Task sheet column A (rows 11-20)\nprotein_ids = []\nfor row in range(11, 21):\n    protein_ids.append(task.cell(row=row, column=1).value)\nprint(\"Protein IDs from Task sheet:\", protein_ids)\n\n# Find the column numbers in Data sheet for each sample\n# Data sheet has samples starting from column 4 (D)\ndata_sample_cols = {}\nfor col in range(4, data.max_column + 1):\n    sample_name = data.cell(row=1, column=col).value\n    if sample_name:\n        data_sample_cols[sample_name] = col\n\nprint(\"\\nMatching samples:\")\nfor s in sample_names:\n    if s in data_sample_cols:\n        print(f\"  {s} -> Data column {data_sample_cols[s]}\")\n    else:\n        print(f\"  {s} -> NOT FOUND\")\n\nwb.close()\nEOF\n"]
