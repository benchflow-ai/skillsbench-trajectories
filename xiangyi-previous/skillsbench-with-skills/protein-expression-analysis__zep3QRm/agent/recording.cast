[142.472918, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load workbook\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\ndata = wb['Data']\n\nprint(\"=== Manual Verification of Data Lookup ===\")\n\n# Get the first protein ID from Task sheet\nprotein_id = task['A11'].value\nprint(f\"Protein ID (A11): {protein_id}\")\n\n# Get the first sample name from Task sheet\nsample_name = task['C10'].value\nprint(f\"Sample name (C10): {sample_name}\")\n\n# Find the protein row in Data sheet\nprotein_row = None\nfor row in range(1, data.max_row + 1):\n    if data.cell(row=row, column=1).value == protein_id:\n        protein_row = row\n        break\nprint(f\"Protein found in Data sheet row: {protein_row}\")\n\n# Find the sample column in Data sheet\nsample_col = None\nfor col in range(1, data.max_column + 1):\n    if data.cell(row=1, column=col).value == sample_name:\n        sample_col = col\n        break\nprint(f\"Sample found in Data sheet column: {sample_col}\")\n\n# Get the value\nif protein_row and sample_col:\n    value = data.cell(row=protein_row, column=sample_col).value\n    print(f\"\\nExpected value at C11: {value}\")\n    print(f\"(This should match what Excel calculates for the INDEX-MATCH formula)\")\n\n# Also verify the group assignments\nprint(\"\\n=== Group Assignments Verification ===\")\nprint(\"Control samples (columns C-G):\")\nfor col in range(3, 8):\n    sample = task.cell(row=10, column=col).value\n    group = task.cell(row=9, column=col).value\n    print(f\"  {openpyxl.utils.get_column_letter(col)}: {sample} -> {group}\")\n\nprint(\"\\nTreated samples (columns H-L):\")\nfor col in range(8, 13):\n    sample = task.cell(row=10, column=col).value\n    group = task.cell(row=9, column=col).value\n    print(f\"  {openpyxl.utils.get_column_letter(col)}: {sample} -> {group}\")\n\nwb.close()\nprint(\"\\n=== All Done ===\")\nEOF\n"]
