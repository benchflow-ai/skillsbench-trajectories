[114.881116, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load workbook preserving formatting\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\nprint(\"Adding formulas to Task sheet...\")\n\n# Step 1: Add INDEX-MATCH formulas in C11:L20\n# Formula: =INDEX(Data!$A$1:$BA$201,MATCH($A11,Data!$A:$A,0),MATCH(C$10,Data!$1:$1,0))\nprint(\"\\nStep 1: Adding expression lookup formulas (C11:L20)\")\nfor row in range(11, 21):  # Rows 11-20\n    for col in range(3, 13):  # Columns C-L (3-12)\n        col_letter = get_column_letter(col)\n        formula = f'=INDEX(Data!$A$1:$BA$201,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'\n        task.cell(row=row, column=col).value = formula\n        if row == 11 and col == 3:\n            print(f\"  Sample formula at C11: {formula}\")\n\nprint(f\"  Added formulas to cells C11:L20\")\n\n# Step 2: Add statistics formulas in rows 24-27, columns B-K\n# The statistics are per protein (columns), so we need to reference the correct row\n# Row 24: Control Mean - AVERAGE of C:G for each protein in rows 11-20\n# Row 25: Control StdDev - STDEV of C:G\n# Row 26: Treated Mean - AVERAGE of H:L\n# Row 27: Treated StdDev - STDEV of H:L\n\nprint(\"\\nStep 2: Adding statistics formulas (B24:K27)\")\n\n# Column B corresponds to protein in row 11, C to row 12, etc.\n# Wait, let me re-check the structure...\n# Looking at the headers, row 23 has \"Statistic\" in A23\n# The statistics should be per-protein, with proteins as columns\n\n# Actually looking at the task description again:\n# \"Put your results in the yellow cells, rows 24-27, columns B-K\"\n# So we have 10 columns (B-K) for 10 proteins\n\n# For each protein (columns B-K map to proteins in rows 11-20):\n# - B24: Control Mean for protein in row 11 = AVERAGE(C11:G11)\n# - B25: Control StdDev for protein in row 11 = STDEV(C11:G11)\n# - etc.\n\nfor i, col in enumerate(range(2, 12)):  # Columns B-K (2-11)\n    protein_row = 11 + i  # Rows 11-20\n    col_letter = get_column_letter(col)\n    \n    # Control Mean (columns C-G are control)\n    formula_ctrl_mean = f'=AVERAGE(C{protein_row}:G{protein_row})'\n    task.cell(row=24, column=col).value = formula_ctrl_mean\n    \n    # Control StdDev\n    formula_ctrl_std = f'=STDEV(C{protein_row}:G{protein_row})'\n    task.cell(row=25, column=col).value = formula_ctrl_std\n    \n    # Treated Mean (columns H-L are treated)\n    formula_treat_mean = f'=AVERAGE(H{protein_row}:L{protein_row})'\n    task.cell(row=26, column=col).value = formula_treat_mean\n    \n    # Treated StdDev\n    formula_treat_std = f'=STDEV(H{protein_row}:L{protein_row})'\n    task.cell(row=27, column=col).value = formula_treat_std\n    \n    if col == 2:\n        print(f\"  Sample formulas for column B (protein row 11):\")\n        print(f\"    B24 Control Mean: {formula_ctrl_mean}\")\n        print(f\"    B25 Control StdDev: {formula_ctrl_std}\")\n        print(f\"    B26 Treated Mean: {formula_treat_mean}\")\n        print(f\"    B27 Treated StdDev: {formula_treat_std}\")\n\nprint(f\"  Added formulas to cells B24:K27\")\n\n# Step 3: Add fold change formulas in rows 32-41\n# Column A: Protein_ID (reference from A11:A20)\n# Column B: Gene_Symbol (reference from B11:B20)\n# Column C: Fold Change = 2^(Log2 FC)\n# Column D: Log2 FC = Treated Mean - Control Mean\n\nprint(\"\\nStep 3: Adding fold change formulas (A32:D41)\")\n\nfor i, row in enumerate(range(32, 42)):  # Rows 32-41\n    protein_row = 11 + i  # Rows 11-20\n    stat_col = 2 + i  # Columns B-K (2-11) for statistics\n    stat_col_letter = get_column_letter(stat_col)\n    \n    # Column A: Protein_ID\n    task.cell(row=row, column=1).value = f'=A{protein_row}'\n    \n    # Column B: Gene_Symbol\n    task.cell(row=row, column=2).value = f'=B{protein_row}'\n    \n    # Column D: Log2 FC = Treated Mean - Control Mean\n    # Treated Mean is in row 26, Control Mean is in row 24\n    formula_log2fc = f'={stat_col_letter}26-{stat_col_letter}24'\n    task.cell(row=row, column=4).value = formula_log2fc\n    \n    # Column C: Fold Change = 2^(Log2 FC)\n    formula_fc = f'=POWER(2,D{row})'\n    task.cell(row=row, column=3).value = formula_fc\n    \n    if ro"]
[114.881177, "i", "w == 32:\n        print(f\"  Sample formulas for row 32 (protein 1):\")\n        print(f\"    A32: =A11\")\n        print(f\"    B32: =B11\")\n        print(f\"    C32 (Fold Change): {formula_fc}\")\n        print(f\"    D32 (Log2 FC): {formula_log2fc}\")\n\nprint(f\"  Added formulas to cells A32:D41\")\n\n# Save the workbook\nwb.save('protein_expression.xlsx')\nprint(\"\\nWorkbook saved successfully!\")\n\nwb.close()\nEOF\n"]
