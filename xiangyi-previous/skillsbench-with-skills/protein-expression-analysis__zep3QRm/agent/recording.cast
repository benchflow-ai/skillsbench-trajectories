[127.362862, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load workbook to verify\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\nprint(\"=== Verification ===\")\n\n# Check Step 1: Expression lookup formulas\nprint(\"\\nStep 1 - Expression lookups (sample cells):\")\nfor cell in ['C11', 'L11', 'C20', 'L20']:\n    val = task[cell].value\n    print(f\"  {cell}: {val}\")\n\n# Check Step 2: Statistics formulas\nprint(\"\\nStep 2 - Statistics formulas (sample cells):\")\nfor cell in ['B24', 'K24', 'B25', 'K25', 'B26', 'K26', 'B27', 'K27']:\n    val = task[cell].value\n    print(f\"  {cell}: {val}\")\n\n# Check Step 3: Fold change formulas\nprint(\"\\nStep 3 - Fold change formulas (sample cells):\")\nfor row in [32, 41]:\n    for col in ['A', 'B', 'C', 'D']:\n        cell = f\"{col}{row}\"\n        val = task[cell].value\n        print(f\"  {cell}: {val}\")\n\n# Verify formatting preserved (check some fill colors)\nprint(\"\\nFormatting check (yellow cells):\")\ncell = task['B24']\nif cell.fill and cell.fill.fgColor:\n    print(f\"  B24 fill color: {cell.fill.fgColor.rgb}\")\n\nwb.close()\nprint(\"\\nVerification complete!\")\nEOF\n"]
