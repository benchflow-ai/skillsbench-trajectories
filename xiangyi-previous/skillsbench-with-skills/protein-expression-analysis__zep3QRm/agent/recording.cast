[22.532633, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\nprint(\"Sheet names:\", wb.sheetnames)\n\n# Explore Task sheet\ntask = wb['Task']\nprint(\"\\n=== TASK SHEET ===\")\nprint(f\"Dimensions: {task.dimensions}\")\n\n# Row 9 - Control/Treated labels\nprint(\"\\nRow 9 (group labels):\")\nfor col in range(1, 15):\n    val = task.cell(row=9, column=col).value\n    if val:\n        print(f\"  Col {col} ({openpyxl.utils.get_column_letter(col)}): {val}\")\n\n# Row 10 - Sample names\nprint(\"\\nRow 10 (sample names):\")\nfor col in range(1, 15):\n    val = task.cell(row=10, column=col).value\n    if val:\n        print(f\"  Col {col} ({openpyxl.utils.get_column_letter(col)}): {val}\")\n\n# Column A rows 11-20 - Target proteins\nprint(\"\\nColumn A rows 11-20 (target proteins):\")\nfor row in range(11, 21):\n    val = task.cell(row=row, column=1).value\n    print(f\"  Row {row}: {val}\")\n\nwb.close()\nEOF\n"]
