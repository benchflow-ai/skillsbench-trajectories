[114.888608, "o", "> "]
[114.888651, "o", "    task.cell(row=row, column=2).value = f'=B{protein_row}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.888704, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.888775, "o", "    # Column D: Log2 FC = Treated Mean - Control Mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.888822, "o", "> "]
[114.888874, "o", "    # Treated Mean is in row 26, Control Mean is in row 24\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.888922, "o", "> "]
