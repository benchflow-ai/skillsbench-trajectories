[32.262535, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.262621, "o", "npz=np.load('data/logistic.npz')\r\n\u001b[?2004l\r\u001b[?2004h> y=npz['y']\r\n\u001b[?2004l\r"]
