[12.682096, "i", "python3 - <<'PY'\nimport numpy as np\nimport os\nfor f in os.listdir('data'):\n    path='data/'+f\n    if f.endswith('.npy'):\n        arr=np.load(path)\n        print(f, arr.shape, arr.dtype)\n    elif f.endswith('.npz'):\n        npz=np.load(path)\n        print(f, npz.files)\n        for k in npz.files:\n            a=npz[k]\n            print(' ',k,a.shape,a.dtype)\nPY\n"]
[12.68235, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
