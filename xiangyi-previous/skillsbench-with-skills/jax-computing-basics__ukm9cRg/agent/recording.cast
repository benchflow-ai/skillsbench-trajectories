[96.92427, "i", "python3 - <<'PY'\nimport json, numpy as np\nimport jax\nimport jax.numpy as jnp\n\n# Task 1: basic_reduce\nx = np.load('data/x.npy')\nx_j = jnp.array(x)\nbasic_reduce = jnp.mean(x_j, axis=1)\nnp.save('basic_reduce.npy', np.array(basic_reduce))\n\n# Task 2: map_square\nmap_square = jnp.square(x_j)\nnp.save('map_square.npy', np.array(map_square))\n\n# Task 3: grad_logistic\nnpz = np.load('data/logistic.npz')\nx = jnp.array(npz['x'])\ny = jnp.array(npz['y'])\nw = jnp.array(npz['w'])\n\ndef loss(w):\n    logits = jnp.dot(x, w)\n    return jnp.mean(jnp.logaddexp(0.0, -y * logits))\n\ngrad_fn = jax.grad(loss)\ngrad = grad_fn(w)\nnp.save('grad_logistic.npy', np.array(grad))\n\n# Task 4: scan_rnn\nnpz = np.load('data/seq.npz')\nseq = jnp.array(npz['seq'])\ninit = jnp.array(npz['init'])\nWx = jnp.array(npz['Wx'])\nWh = jnp.array(npz['Wh'])\nb = jnp.array(npz['b'])\n\ndef step(h, x_t):\n    h_new = jnp.tanh(jnp.dot(Wx, x_t) + jnp.dot(Wh, h) + b)\n    return h_new, h_new\n\n_, outputs = jax.lax.scan(step, init, seq)\nnp.save('scan_rnn.npy', np.array(outputs))\n\n# Task 5: jit_mlp\nnpz = np.load('data/mlp.npz')\nX = jnp.array(npz['X'])\nW1 = jnp.array(npz['W1'])\nb1 = jnp.array(npz['b1'])\nW2 = jnp.array(npz['W2'])\nb2 = jnp.array(npz['b2'])\n\ndef mlp(X):\n    h = jnp.maximum(0, jnp.dot(X, W1) + b1)\n    return jnp.dot(h, W2) + b2\n\nmlp_jit = jax.jit(mlp)\nmlp_out = mlp_jit(X)\nnp.save('jit_mlp.npy', np.array(mlp_out))\n\nprint('done')\nPY\n"]
[96.924644, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
