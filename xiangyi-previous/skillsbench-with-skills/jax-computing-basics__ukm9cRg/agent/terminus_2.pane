[?2004hroot@d46176f17788:/app# python3 - <<'PY'
[?2004l[?2004h> import json, numpy as np
[?2004l[?2004h> import jax
[?2004l[?2004h> import jax.numpy as jnp
[?2004l[?2004h> 
[?2004l[?2004h> # Task 1: basic_reduce
[?2004l[?2004h> x = np.load('data/x.npy')
[?2004l[?2004h> x_j = jnp.array(x)
[?2004l[?2004h> basic_reduce = jnp.mean(x_j, axis=1)
[?2004l[?2004h> np.save('basic_reduce.npy', np.array(basic_reduce))
[?2004l[?2004h> 
[?2004l[?2004h> # Task 2: map_square
[?2004l[?2004h> map_square = jnp.square(x_j)
[?2004l[?2004h> np.save('map_square.npy', np.array(map_square))
[?2004l[?2004h> 
[?2004l[?2004h> # Task 3: grad_logistic
[?2004l[?2004h> npz = np.load('data/logistic.npz')
[?2004l[?2004h> x = jnp.array(npz['x'])
[?2004l[?2004h> y = jnp.array(npz['y'])
[?2004l[?2004h> w = jnp.array(npz['w'])
[?2004l[?2004h> 
[?2004l[?2004h> def loss(w):
[?2004l[?2004h>     logits = jnp.dot(x, w)
[?2004l[?2004h>     return jnp.mean(jnp.logaddexp(0.0, -y * logits))
[?2004l[?2004h> 
[?2004l[?2004h> grad_fn = jax.grad(loss)
[?2004l[?2004h> grad = grad_fn(w)
[?2004l[?2004h> np.save('grad_logistic.npy', np.array(grad))
[?2004l[?2004h> 
[?2004l[?2004h> # Task 4: scan_rnn
[?2004l[?2004h> npz = np.load('data/seq.npz')
[?2004l[?2004h> seq = jnp.array(npz['seq'])
[?2004l[?2004h> init = jnp.array(npz['init'])
[?2004l[?2004h> Wx = jnp.array(npz['Wx'])
[?2004l[?2004h> Wh = jnp.array(npz['Wh'])
[?2004l[?2004h> b = jnp.array(npz['b'])
[?2004l[?2004h> 
[?2004l[?2004h> def step(h, x_t):
[?2004l[?2004h>     h_new = jnp.tanh(jnp.dot(Wx, x_t) + jnp.dot(Wh, h) + b)
[?2004l[?2004h>     return h_new, h_new
[?2004l[?2004h> 
[?2004l[?2004h> _, outputs = jax.lax.scan(step, init, seq)
[?2004l[?2004h> np.save('scan_rnn.npy', np.array(outputs))
[?2004l[?2004h> 
[?2004l[?2004h> # Task 5: jit_mlp
[?2004l[?2004h> npz = np.load('data/mlp.npz')
[?2004l[?2004h> X = jnp.array(npz['X'])
[?2004l[?2004h> W1 = jnp.array(npz['W1'])
[?2004l[?2004h> b1 = jnp.array(npz['b1'])
[?2004l[?2004h> W2 = jnp.array(npz['W2'])
[?2004l[?2004h> b2 = jnp.array(npz['b2'])
[?2004l[?2004h> 
[?2004l[?2004h> def mlp(X):
[?2004l[?2004h>     h = jnp.maximum(0, jnp.dot(X, W1) + b1)
[?2004l[?2004h>     return jnp.dot(h, W2) + b2
[?2004l[?2004h> 
[?2004l[?2004h> mlp_jit = jax.jit(mlp)
[?2004l[?2004h> mlp_out = mlp_jit(X)
[?2004l[?2004h> np.save('jit_mlp.npy', np.array(mlp_out))
[?2004l[?2004h> 
[?2004l[?2004h> print('done')
[?2004l[?2004h> PY
[?2004lls -la *.npy
done
