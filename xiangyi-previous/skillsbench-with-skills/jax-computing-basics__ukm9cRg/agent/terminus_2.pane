[?2004hroot@d46176f17788:/app# python3 - <<'PY'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> ref=np.load('reference/grad_logistic.npy')
[?2004l[?2004h> npz=np.load('data/logistic.npz')
[?2004l[?2004h> x=npz['x']; y=npz['y']; w=npz['w']
[?2004l[?2004h> # candidate1: y in {-1,1} logistic loss mean log(1+exp(-y xw))
[?2004l[?2004h> logits=x.dot(w)
[?2004l[?2004h> z=y*logits
[?2004l[?2004h> sig=1/(1+np.exp(z)) # sigmoid(-z)
[?2004l[?2004h> # grad = mean(-y*x*sigmoid(-z))
[?2004l[?2004h> grad1=-(y[:,None]*x*sig[:,None]).mean(axis=0)
[?2004l[?2004h> print('grad1 diff', np.max(np.abs(grad1-ref)))
[?2004l[?2004h> # candidate2: loss mean log(1+exp(-y xw)) but sum? no mean
[?2004l[?2004h> grad1sum=-(y[:,None]*x*sig[:,None]).sum(axis=0)
[?2004l[?2004h> print('grad1sum diff', np.max(np.abs(grad1sum-ref)))
[?2004l[?2004h> # candidate3: y in {0,1} logistic
[?2004l[?2004h> # map y to (y+1)/2
[?2004l[?2004h> yp=(y+1)/2
[?2004l[?2004h> sigmoid=1/(1+np.exp(-logits))
[?2004l[?2004h> grad2=(x*(sigmoid-yp)[:,None]).mean(axis=0)
[?2004l[?2004h> print('grad2 diff', np.max(np.abs(grad2-ref)))
[?2004l[?2004h> 
[?2004l[?2004h> # RNN
[?2004l[?2004h> ref_rnn=np.load('reference/scan_rnn.npy')
[?2004l[?2004h> npz=np.load('data/seq.npz')
[?2004l[?2004h> seq=npz['seq']; init=npz['init']; Wx=npz['Wx']; Wh=npz['Wh']; b=npz['b']
[?2004l[?2004h> # candidate: h_t = tanh(seq_t @ Wx + h_{t-1} @ Wh + b)
[?2004l[?2004h> h=init
[?2004l[?2004h> outs=[]
[?2004l[?2004h> for t in range(seq.shape[0]):
[?2004l[?2004h>     h=np.tanh(seq[t].dot(Wx)+h.dot(Wh)+b)
[?2004l[?2004h>     outs.append(h)
[?2004l[?2004h> outs=np.stack(outs)
[?2004l[?2004h> print('rnn diff', np.max(np.abs(outs-ref_rnn)), outs.shape, ref_rnn.shape)
[?2004l[?2004h> # other candidate: Wx @ x + Wh @ h
[?2004l[?2004h> h=init
[?2004l[?2004h> outs2=[]
[?2004l[?2004h> for t in range(seq.shape[0]):
[?2004l[?2004h>     h=np.tanh(Wx.dot(seq[t])+Wh.dot(h)+b)
[?2004l[?2004h>     outs2.append(h)
[?2004l[?2004h> outs2=np.stack(outs2)
[?2004l[?2004h> print('rnn diff2', np.max(np.abs(outs2-ref_rnn)))
[?2004l[?2004h> 
[?2004l[?2004h> # MLP
[?2004l[?2004h> ref_mlp=np.load('reference/jit_mlp.npy')
[?2004l[?2004h> npz=np.load('data/mlp.npz')
[?2004l[?2004h> X=npz['X']; W1=npz['W1']; b1=npz['b1']; W2=npz['W2']; b2=npz['b2']
[?2004l[?2004h> # candidate: relu
[?2004l[?2004h> h=np.maximum(0, X.dot(W1)+b1)
[?2004l[?2004h> out=h.dot(W2)+b2
[?2004l[?2004h> print('mlp diff relu', np.max(np.abs(out-ref_mlp)))
[?2004l[?2004h> # candidate: tanh
[?2004l[?2004h> h=np.tanh(X.dot(W1)+b1)
[?2004l[?2004h> out2=h.dot(W2)+b2
[?2004l[?2004h> print('mlp diff tanh', np.max(np.abs(out2-ref_mlp)))
[?2004l[?2004h> # candidate: no activation
[?2004l[?2004h> h=X.dot(W1)+b1
[?2004l[?2004h> out3=h.dot(W2)+b2
[?2004l[?2004h> print('mlp diff linear', np.max(np.abs(out3-ref_mlp)))
[?2004l[?2004h> PY
