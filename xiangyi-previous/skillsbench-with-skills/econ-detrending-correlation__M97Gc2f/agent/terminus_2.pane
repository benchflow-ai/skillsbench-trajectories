[?2004hroot@91549974c08d:~# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, re
[?2004l[?2004h> from statsmodels.tsa.filters.hp_filter import hpfilter
[?2004l[?2004h> 
[?2004l[?2004h> # Load CPI
[?2004l[?2004h> cpi = pd.read_excel('/root/CPI.xlsx')
[?2004l[?2004h> cpi = cpi.set_index('Year')['CPI_2024']
[?2004l[?2004h> 
[?2004l[?2004h> # Function to extract annual series and 2024 average from quarterly data
[?2004l[?2004h> 
[?2004l[?2004h> def extract_series(fname, sheet):
[?2004l[?2004h>     df = pd.read_excel(fname, sheet_name=sheet, header=None)
[?2004l[?2004h>     # annual rows: label like '1973.'
[?2004l[?2004h>     years = {}
[?2004l[?2004h>     for idx, label in df[0].items():
[?2004l[?2004h>         if isinstance(label, str):
[?2004l[?2004h>             m = re.fullmatch(r'(\d{4})\.?', label.strip())
[?2004l[?2004h>             if m:
[?2004l[?2004h>                 year = int(m.group(1))
[?2004l[?2004h>                 years[year] = df.loc[idx, 1]
[?2004l[?2004h>     # 2024 quarterly data
[?2004l[?2004h>     # find index of row with '2024:'
[?2004l[?2004h>     idxs = df[df[0].astype(str).str.contains('2024:')].index
[?2004l[?2004h>     if len(idxs)==0:
[?2004l[?2004h>         raise ValueError('2024 quarterly not found')
[?2004l[?2004h>     idx0 = idxs[0]
[?2004l[?2004h>     vals = [df.loc[idx0,1]]
[?2004l[?2004h>     # collect subsequent quarter rows
[?2004l[?2004h>     for j in range(idx0+1, len(df)):
[?2004l[?2004h>         lbl = str(df.loc[j,0]).strip()
[?2004l[?2004h>         if re.fullmatch(r'(II|III|IV|I)( p\.)?\.', lbl) or lbl in ['II.','III.','IV.','III p.','IV p.','II p.','I p.']:
[?2004l[?2004h>             vals.append(df.loc[j,1])
[?2004l[?2004h>         else:
[?2004l[?2004h>             break
[?2004l[?2004h>     years[2024] = float(np.mean(vals))
[?2004l[?2004h>     return pd.Series(years).sort_index()
[?2004l[?2004h> 
[?2004l[?2004h> pce_nom = extract_series('/root/ERP-2025-table10.xls','B10')
[?2004l[?2004h> pfi_nom = extract_series('/root/ERP-2025-table12.xls','B12')
[?2004l[?2004h> 
[?2004l[?2004h> # align years 1973-2024
[?2004l[?2004h> years = range(1973, 2025)
[?2004l[?2004h> 
[?2004l[?2004h> pce_nom = pce_nom.reindex(years)
[?2004l[?2004h> pfi_nom = pfi_nom.reindex(years)
[?2004l[?2004h> 
[?2004l[?2004h> # deflate to real using CPI (2024 base)
[?2004l[?2004h> real_pce = pce_nom / cpi
[?2004l[?2004h> real_pfi = pfi_nom / cpi
[?2004l[?2004h> 
[?2004l[?2004h> # log transform
[?2004l[?2004h> log_pce = np.log(real_pce)
[?2004l[?2004h> log_pfi = np.log(real_pfi)
[?2004l[?2004h> 
[?2004l[?2004h> # HP filter
[?2004l[?2004h> cycle_pce, trend_pce = hpfilter(log_pce, lamb=100)
[?2004l[?2004h> cycle_pfi, trend_pfi = hpfilter(log_pfi, lamb=100)
[?2004l[?2004h> 
[?2004l[?2004h> corr = np.corrcoef(cycle_pce, cycle_pfi)[0,1]
[?2004l[?2004h> 
[?2004l[?2004h> # round to 5 decimals and write
[?2004l[?2004h> out = f"{corr:.5f}"
[?2004l[?2004h> print('Correlation:', out)
[?2004l[?2004h> with open('/root/answer.txt','w') as f:
[?2004l[?2004h>     f.write(out)
[?2004l[?2004h> PY
