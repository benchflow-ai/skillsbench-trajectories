[79.406955, "i", "python3 - <<'PY'\nimport pandas as pd\n\ndef annual_years(fname, sheet):\n    df = pd.read_excel(fname, sheet_name=sheet, header=None, usecols=[0,1])\n    years = [int(x) for x in df[0] if isinstance(x,(int,float)) and not pd.isna(x)]\n    print(fname, 'min', min(years), 'max', max(years), 'last10', years[-10:])\n\nannual_years('/root/ERP-2025-table10.xls','B10')\nannual_years('/root/ERP-2025-table12.xls','B12')\nPY\n"]
