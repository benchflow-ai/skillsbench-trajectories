[89.568886, "i", "python3 - <<'PY'\nimport pandas as pd, re\n\nfor fname,sheet in [('/root/ERP-2025-table10.xls','B10'),('/root/ERP-2025-table12.xls','B12')]:\n    df = pd.read_excel(fname, sheet_name=sheet, header=None, usecols=[0,1])\n    years = []\n    for x in df[0].astype(str):\n        m = re.fullmatch(r'(\\d{4})\\.?', x.strip())\n        if m:\n            years.append(int(m.group(1)))\n    print(fname, 'min', min(years), 'max', max(years), 'count', len(years), 'last10', years[-10:])\n\nPY\n"]
