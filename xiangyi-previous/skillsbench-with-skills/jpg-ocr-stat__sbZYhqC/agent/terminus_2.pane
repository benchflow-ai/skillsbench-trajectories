[?2004l[?2004h>     return img
[?2004l[?2004h> 
[?2004l[?2004h> def extract_date(text):
[?2004l[?2004h>     # Patterns for DD-MM-YYYY, DD-MM-YY, YYYY-MM-DD
[?2004l[?2004h>     # Using more flexible separators
[?2004l[?2004h>     patterns = [
[?2004l[?2004h>         r'(\d{1,2})[/-](\d{1,2})[/-](\d{4})',
[?2004l[?2004h>         r'(\d{4})[/-](\d{1,2})[/-](\d{1,2})',
[?2004l[?2004h>         r'(\d{1,2})[/-](\d{1,2})[/-](\d{2})'
[?2004l[?2004h>     ]
[?2004l[?2004h>     for pattern in patterns:
[?2004l[?2004h>         matches = re.finditer(pattern, text)
[?2004l[?2004h>         for match in matches:
[?2004l[?2004h>             g = match.groups()
[?2004l[?2004h>             try:
[?2004l[?2004h>                 if len(g[0]) == 4:
[?2004l[?2004h>                     y, m, d = int(g[0]), int(g[1]), int(g[2])
[?2004l[?2004h>                 elif len(g[2]) == 4:
[?2004l[?2004h>                     d, m, y = int(g[0]), int(g[1]), int(g[2])
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     d, m, y = int(g[0]), int(g[1]), int(g[2])
[?2004l[?2004h>                     y += 2000
[?2004l[?2004h>                 
[?2004l[?2004h>                 if 1 <= m <= 12 and 1 <= d <= 31 and 1900 <= y <= 2100:
[?2004l[?2004h>                     return f"{y:04d}-{m:02d}-{d:02d}"
[?2004l[?2004h>             except ValueError:
[?2004l[?2004h>                 continue
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def extract_total_amount(text):
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     lines = [line.strip() for line in lines if line.strip()]
[?2004l[?2004h>     
[?2004l[?2004h>     keywords_priority = [
[?2004l[?2004h>         r'GRAND\s*TOTAL',
[?2004l[?2004h>         r'TOTAL\s*RM',
[?2004l[?2004h>         r'TOTAL:\s*RM',
[?2004l[?2004h>         r'TOTAL\s*AMOUNT',
[?2004l[?2004h>         r'TOTAL', r'AMOUNT', r'TOTAL\s*DUE', r'AMOUNT\s*DUE', r'BALANCE\s*DUE', r'NETT\s*TOTAL', r'NET\s*TOTAL'
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']
[?2004l[?2004h>     
[?2004l[?2004h>     def get_amount_from_line(line):
[?2004l[?2004h>         # Improved regex for amount
[?2004l[?2004h>         match = re.findall(r'\d{1,3}(?:[ ,]\d{3})*[ .]+\d{2}', line)
[?2004l[?2004h>         if match:
[?2004l[?2004h>             amt_str = match[-1]
[?2004l[?2004h>             amt_str = amt_str.replace(',', '').replace(' ', '')
[?2004l[?2004h>             if amt_str.count('.') > 1:
[?2004l[?2004h>                 parts = amt_str.split('.')
[?2004l[?2004h>                 amt_str = "".join(parts[:-1]) + "." + parts[-1]
[?2004l[?2004h>             return amt_str
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h>     for kw_pattern in keywords_priority:
[?2004l[?2004h>         for i, line in enumerate(lines):
[?2004l[?2004h>             if re.search(kw_pattern, line, re.IGNORECASE):
[?2004l[?2004h>                 skip = False
[?2004l[?2004h>                 for ex in exclusion_keywords:
[?2004l[?2004h>                     if re.search(r'\b' + ex + r'\b', line, re.IGNORECASE):
[?2004l[?2004h>                         if kw_pattern in [r'TOTAL', r'AMOUNT']:
[?2004l[?2004h>                             skip = True
[?2004l[?2004h>                             break
