cat << 'EOF' > solution.py
import os
import re
import pytesseract
from PIL import Image, ImageOps, ImageEnhance
from openpyxl import Workbook
from datetime import datetime

def preprocess_image(img):
    # Convert to grayscale
    img = img.convert('L')
    # Increase contrast
    enhancer = ImageEnhance.Contrast(img)
    img = enhancer.enhance(2.0)
    return img

def extract_date(text):
    # Look for dates in various formats
    # DD-MM-YYYY, DD/MM/YYYY, YYYY-MM-DD, YYYY/MM/DD, DD.MM.YYYY
    patterns = [
        r'(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})',
        r'(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})'
    ]
    for pattern in patterns:
        matches = re.finditer(pattern, text)
        for match in matches:
            g = match.groups()
            try:
                if len(g[0]) == 4:
                    y, m, d = int(g[0]), int(g[1]), int(g[2])
                else:
                    d, m, y = int(g[0]), int(g[1]), int(g[2])
                
                # Basic validation
                if 1 <= m <= 12 and 1 <= d <= 31 and 1900 <= y <= 2100:
                    return f"{y:04d}-{m:02d}-{d:02d}"
            except ValueError:
                continue
    return None

def extract_total_amount(text):
    lines = text.split('\n')
    lines = [line.strip() for line in lines if line.strip()]
    
    keywords_priority = [
        r'GRAND\s*TOTAL',
        r'TOTAL\s*RM',
        r'TOTAL:\s*RM',
        r'TOTAL\s*AMOUNT',
        r'TOTAL', r'AMOUNT', r'TOTAL\s*DUE', r'AMOUNT\s*DUE', r'BALANCE\s*DUE', r'NETT\s*TOTAL', r'NET\s*TOTAL'
    ]
    
    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']
    
    def get_amount_from_line(line):
        # Look for something like 1,234.56 or 1234.56 or 1234 . 56
        # Sometimes OCR puts spaces around the dot
        match = re.findall(r'\d{1,3}(?:[ ,]\d{3})*[ .]+\d{2}', line)
        if match:
            # Take the last one, clean it
            amt_str = match[-1]
            amt_str = amt_str.replace(',', '').replace(' ', '')
            # If there are multiple dots, take the last one
            if amt_str.count('.') > 1:
                parts = amt_str.split('.')
                amt_str = "".join(parts[:-1]) + "." + parts[-1]
            return amt_str
        return None

    for kw_pattern in keywords_priority:
        for i, line in enumerate(lines):
            if re.search(kw_pattern, line, re.IGNORECASE):
                # Check exclusion
                skip = False
                for ex in exclusion_keywords:
                    if re.search(ex, line, re.IGNORECASE):
                        # If the keyword is 'TOTAL' but line contains 'SUBTOTAL', skip if kw is 'TOTAL'
                        if kw_pattern in [r'TOTAL', r'AMOUNT']:
                            skip = True
                            break
                if skip: continue

                amount = get_amount_from_line(line)
                if amount:
                    return amount
                # Fallback to next line
                if i + 1 < len(lines):
                    amount = get_amount_from_line(lines[i+1])
                    if amount:
                        return amount
    
    # Fallback: just look for the largest amount at the end of the text?
    # No, stick to the keywords first.
    return None

img_dir = '/app/workspace/dataset/img'
files = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])

results = []
for filename in files:
    img_path = os.path.join(img_dir, filename)
    try:
        img = Image.open(img_path)
        text = pytesseract.image_to_string(img)
        date = extract_date(text)
        amount = extract_total_amount(text)
        
        # If not found, try with preprocessed image
        if not date or not amount:
            text_p = pytesseract.image_to_string(preprocess_image(img))
            if not date: date = extract_date(text_p)
            if not amount: amount = extract_total_amount(text_p)

        if amount:
            try:
                amount = "{:.2f}".format(090.jpg: 2017-03-13, 5.00
094.jpg: 2018-02-09, 5.90
