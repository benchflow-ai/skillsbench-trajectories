[445.609329, "o", "> "]
[445.609364, "o", "                parts = amt_str.split('.')\r\n\u001b[?2004l\r"]
[445.609396, "o", "\u001b[?2004h> "]
[445.609575, "o", "                amt_str = \"\".join(parts[:-1]) + \".\" + parts[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.609667, "o", "            return amt_str\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.609697, "o", "> "]
[445.609724, "o", "        return None\r\n\u001b[?2004l\r"]
[445.609764, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[445.609796, "o", "\u001b[?2004h> "]
[445.609937, "o", "    for kw_pattern in keywords_priority:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.610131, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.610215, "o", "            if re.search(kw_pattern, line, re.IGNORECASE):\r\n\u001b[?2004l\r"]
[445.610262, "o", "\u001b[?2004h> "]
[445.610798, "o", "                if any(re.search(r'\\b' + ex.replace(' ', r'\\s*') + r'\\b', line, re.IGNORECASE) for ex in exclusion_keywords):\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.610844, "o", ">                     if kw_pattern in [r'TOTAL', r'AMOUNT']: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.610978, "o", "                amount = get_amount_from_line(line)\r\n\u001b[?2004l\r"]
[445.611012, "o", "\u001b[?2004h> "]
[445.611183, "o", "                if amount: return amount\r\n"]
[445.611256, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[445.61132, "o", "                if i + 1 < len(lines):\r\n\u001b[?2004l\r"]
[445.611404, "o", "\u001b[?2004h> "]
[445.611543, "o", "                    amount = get_amount_from_line(lines[i+1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.611611, "o", "> "]
[445.611676, "o", "                    if amount: return amount\r\n\u001b[?2004l\r"]
[445.611709, "o", "\u001b[?2004h> "]
[445.61176, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.611869, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.611944, "o", "img_dir = '/app/workspace/dataset/img'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.612147, "o", "files = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.612302, "o", "> results = []\r\n\u001b[?2004l\r\u001b[?2004h> for filename in files:\r\n\u001b[?2004l\r"]
[445.612333, "o", "\u001b[?2004h> "]
[445.61257, "o", "    img_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.61266, "o", "        img = Image.open(img_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.612794, "o", "        text = pytesseract.image_to_string(img)\r\n\u001b[?2004l\r"]
[445.612828, "o", "\u001b[?2004h> "]
[445.61296, "o", "        date = extract_date(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.613069, "o", "        amount = extract_total_amount(text)\r\n\u001b[?2004l\r"]
[445.613108, "o", "\u001b[?2004h> "]
[445.613188, "o", "        if not date or not amount:\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.613222, "o", "> "]
[445.613416, "o", "            text_p = pytesseract.image_to_string(preprocess_image(img))\r\n\u001b[?2004l\r"]
[445.613452, "o", "\u001b[?2004h> "]
[445.613585, "o", "            if not date: date = extract_date(text_p)\r\n\u001b[?2004l\r"]
[445.613623, "o", "\u001b[?2004h> "]
[445.613792, "o", "            if not amount: amount = extract_total_amount(text_p)\r\n\u001b[?2004l\r"]
[445.613824, "o", "\u001b[?2004h> "]
[445.613857, "o", "        if amount:\r\n"]
[445.613888, "o", "\u001b[?2004l\r\u001b[?2004h"]
[445.613938, "o", "> "]
[445.614179, "o", "            try: amount = \"{:.2f}\".format(float(amount))\r\n\u001b[?2004l\r\u001b[?2004h>             except: amount = None\r\n\u001b[?2004l\r"]
[445.614265, "o", "\u001b[?2004h> "]
[445.614374, "o", "        results.append((filename, date, amount))"]
[445.614894, "o", "\r\n\u001b[?2004l\r"]
[445.61493, "o", "\u001b[?2004h> "]
[445.615079, "o", "    except Exception: results.append((filename, None, None))\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.615112, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.615186, "o", "wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[445.615334, "o", "ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> ws.title = \"results\"\r\n\u001b[?2004l\r"]
[445.615371, "o", "\u001b[?2004h> "]
[445.615501, "o", "ws.append([\"filename\", \"date\", \"total_amount\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.615539, "o", "> "]
[445.615671, "o", "for res in results: ws.append(res)\r\n\u001b[?2004l\r\u001b[?2004h"]
[445.615703, "o", "> "]
[445.615846, "o", "wb.save('/app/workspace/stat_ocr.xlsx')\r\n\u001b[?2004l\r"]
[445.615882, "o", "\u001b[?2004h"]
[445.615913, "o", "> EOF\r\n\u001b[?2004l\r"]
