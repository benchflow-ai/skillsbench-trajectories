[166.182473, "i", "cat << 'EOF' > solution.py\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image, ImageOps, ImageEnhance\nfrom openpyxl import Workbook\n\ndef preprocess_image(img):\n    img = img.convert('L')\n    enhancer = ImageEnhance.Contrast(img)\n    img = enhancer.enhance(2.0)\n    return img\n\ndef extract_date(text):\n    # Patterns for DD-MM-YYYY, DD-MM-YY, YYYY-MM-DD\n    # Using more flexible separators\n    patterns = [\n        r'(\\d{1,2})[/-](\\d{1,2})[/-](\\d{4})',\n        r'(\\d{4})[/-](\\d{1,2})[/-](\\d{1,2})',\n        r'(\\d{1,2})[/-](\\d{1,2})[/-](\\d{2})'\n    ]\n    for pattern in patterns:\n        matches = re.finditer(pattern, text)\n        for match in matches:\n            g = match.groups()\n            try:\n                if len(g[0]) == 4:\n                    y, m, d = int(g[0]), int(g[1]), int(g[2])\n                elif len(g[2]) == 4:\n                    d, m, y = int(g[0]), int(g[1]), int(g[2])\n                else:\n                    d, m, y = int(g[0]), int(g[1]), int(g[2])\n                    y += 2000\n                \n                if 1 <= m <= 12 and 1 <= d <= 31 and 1900 <= y <= 2100:\n                    return f\"{y:04d}-{m:02d}-{d:02d}\"\n            except ValueError:\n                continue\n    return None\n\ndef extract_total_amount(text):\n    lines = text.split('\\n')\n    lines = [line.strip() for line in lines if line.strip()]\n    \n    keywords_priority = [\n        r'GRAND\\s*TOTAL',\n        r'TOTAL\\s*RM',\n        r'TOTAL:\\s*RM',\n        r'TOTAL\\s*AMOUNT',\n        r'TOTAL', r'AMOUNT', r'TOTAL\\s*DUE', r'AMOUNT\\s*DUE', r'BALANCE\\s*DUE', r'NETT\\s*TOTAL', r'NET\\s*TOTAL'\n    ]\n    \n    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\n    \n    def get_amount_from_line(line):\n        # Improved regex for amount\n        match = re.findall(r'\\d{1,3}(?:[ ,]\\d{3})*[ .]+\\d{2}', line)\n        if match:\n            amt_str = match[-1]\n            amt_str = amt_str.replace(',', '').replace(' ', '')\n            if amt_str.count('.') > 1:\n                parts = amt_str.split('.')\n                amt_str = \"\".join(parts[:-1]) + \".\" + parts[-1]\n            return amt_str\n        return None\n\n    for kw_pattern in keywords_priority:\n        for i, line in enumerate(lines):\n            if re.search(kw_pattern, line, re.IGNORECASE):\n                skip = False\n                for ex in exclusion_keywords:\n                    if re.search(r'\\b' + ex + r'\\b', line, re.IGNORECASE):\n                        if kw_pattern in [r'TOTAL', r'AMOUNT']:\n                            skip = True\n                            break\n                if skip: continue\n\n                amount = get_amount_from_line(line)\n                if amount:\n                    return amount\n                if i + 1 < len(lines):\n                    amount = get_amount_from_line(lines[i+1])\n                    if amount:\n                        return amount\n    return None\n\nimg_dir = '/app/workspace/dataset/img'\nfiles = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])\n\nresults = []\nfor filename in files:\n    img_path = os.path.join(img_dir, filename)\n    try:\n        img = Image.open(img_path)\n        text = pytesseract.image_to_string(img)\n        date = extract_date(text)\n        amount = extract_total_amount(text)\n        \n        if not date or not amount:\n            text_p = pytesseract.image_to_string(preprocess_image(img))\n            if not date: date = extract_date(text_p)\n            if not amount: amount = extract_total_amount(text_p)\n\n        if amount:\n            try:\n                amount = \"{:.2f}\".format(float(amount))\n            except:\n                amount = None\n        results.append((filename, date, amount))\n        print(f\"{filename}: {date}, {amount}\")\n    except Exception as e:\n        print(f\"Error processing {filename}: {e}\")\n        results.append((filename, None, None))\n\nwb = Workbook()\nws = wb.active\nws.title = \"results\"\nws.append([\"filename\", \"date\", \"total_amount\"])\nfor res in results:\n    ws.append(res)\n\nwb.save('/app/workspace/stat_ocr.xlsx')\nEOF\npytho"]
[166.182537, "i", "n3 solution.py\n"]
[166.190014, "o", "cat << 'EOF' > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import pytesseract\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image, ImageOps, ImageEnhance\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import Workbook\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def preprocess_image(img):\r\n\u001b[?2004l\r\u001b[?2004h>     img = img.convert('L')\r\n\u001b[?2004l\r\u001b[?2004h>     enhancer = ImageEnhance.Contrast(img)\r\n\u001b[?2004l\r\u001b[?2004h>     img = enhancer.enhance(2.0)\r\n\u001b[?2004l\r\u001b[?2004h>     return img\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_date(text):\r\n\u001b[?2004l\r\u001b[?2004h>     # Patterns for DD-MM-YYYY, DD-MM-YY, YYYY-MM-DD\r\n\u001b[?2004l\r\u001b[?2004h>     # Using more flexible separators\r\n\u001b[?2004l\r\u001b[?2004h>     patterns = [\r\n\u001b[?2004l\r\u001b[?2004h>         r'(\\d{1,2})[/-](\\d{1,2})[/-](\\d{4})',\r\n\u001b[?2004l\r\u001b[?2004h>         r'(\\d{4})[/-](\\d{1,2})[/-](\\d{1,2})',\r\n\u001b[?2004l\r\u001b[?2004h>         r'(\\d{1,2})[/-](\\d{1,2})[/-](\\d{2})'\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     for pattern in patterns:\r\n\u001b[?2004l\r\u001b[?2004h>         matches = re.finditer(pattern, text)\r\n\u001b[?2004l\r\u001b[?2004h>         for match in matches:\r\n\u001b[?2004l\r\u001b[?2004h>             g = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 if len(g[0]) == 4:\r\n\u001b[?2004l\r\u001b[?2004h>                     y, m, d = int(g[0]), int(g[1]), int(g[2])\r\n\u001b[?2004l\r\u001b[?2004h>                 elif len(g[2]) == 4:\r\n\u001b[?2004l\r\u001b[?2004h>                     d, m, y = int(g[0]), int(g[1]), int(g[2])\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     d, m, y = int(g[0]), int(g[1]), int(g[2])\r\n\u001b[?2004l\r\u001b[?2004h>                     y += 2000\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 if 1 <= m <= 12 and 1 <= d <= 31 and 1900 <= y <= 2100:\r\n\u001b[?2004l\r\u001b[?2004h>                     return f\"{y:04d}-{m:02d}-{d:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h>             except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h>     lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     lines = [line.strip() for line in lines if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     keywords_priority = [\r\n\u001b[?2004l\r\u001b[?2004h>         r'GRAND\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*RM',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL:\\s*RM',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AMOUNT',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL', r'AMOUNT', r'TOTAL\\s*DUE', r'AMOUNT\\s*DUE', r'BALANCE\\s*DUE', r'NETT\\s*TOTAL', r'NET\\s*TOTAL'\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def get_amount_from_line(line):\r\n\u001b[?2004l\r\u001b[?2004h>         # Improved regex for amount\r\n\u001b[?2004l\r\u001b[?2004h>         match = re.findall(r'\\d{1,3}(?:[ ,]\\d{3})*[ .]+\\d{2}', line)\r\n\u001b[?2004l\r\u001b[?2004h>         if match:\r\n\u001b[?2004l\r\u001b[?2004h>             amt_str = match[-1]\r\n\u001b[?2004l\r\u001b[?2004h>             amt_str = amt_str.replace(',', '').replace(' ', '')\r\n\u001b[?2004l\r\u001b[?2004h>             if amt_str.count('.') > 1:\r\n\u001b[?2004l\r\u001b[?2004h>                 parts = amt_str.split('.')\r\n\u001b[?2004l\r\u001b[?2004h>                 amt_str = \"\".join(parts[:-1]) + \".\" + parts[-1]\r\n\u001b[?2004l\r\u001b[?2004h>             return amt_str\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for kw_pattern in keywords_priority:\r\n\u001b[?2004l\r\u001b[?2004h>         for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h>             if re.search(kw_pattern, line, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
