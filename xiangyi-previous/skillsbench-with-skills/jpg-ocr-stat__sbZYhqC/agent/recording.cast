[423.092454, "i", "python3 -c \"import re; text = 'Date : 2032018 13:01'; patterns = [r'(\\d{2})(\\d{2})(\\d{4})']; [print(re.search(p, text)) for p in patterns]\"\n"]
[423.094701, "o", "python3 -c \"import re; text = 'Date : 2032018 13:01'; patterns = [r'(\\d{2})(\\d{2})(\\d{4})']; [print(re.search(p, text)) for p in patterns]\"\r\n\u001b[?2004l\r"]
