[?2004l[?2004hroot@e59c5b620acb:~# cat <<EOF > /root/output/js/visualization.js
[?2004l[?2004h> d3.csv("data/stock-descriptions.csv").then(data => {
[?2004l[?2004h>     const width = 600;
[?2004l[?2004h>     const height = 600;
[?2004l[?2004h> 
[?2004l[?2004h>     // Process data
[?2004l[?2004h>     data.forEach(d => {
[?2004l[?2004h>         d.marketCap = d.marketCap ? +d.marketCap : null;
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     const sectors = Array.from(new Set(data.map(d => d.sector)));
[?2004l[?2004h>     const color = d3.scaleOrdinal().domain(sectors).range(d3.schemeCategory10);
[?2004l[?2004h> 
[?2004l[?2004h>     const sizeScale = d3.scaleSqrt()
[?2004l[?2004h>         .domain([0, d3.max(data, d => d.marketCap || 0)])
[?2004l[?2004h>         .range([10, 60]);
[?2004l[?2004h> 
[?2004l[?2004h>     const nodes = data.map(d => ({
[?2004l[?2004h>         ...d,
[?2004l[?2004h>         radius: d.marketCap ? sizeScale(d.marketCap) : 20
[?2004l[?2004h>     }));
[?2004l[?2004h> 
[?2004l[?2004h>     const simulation = d3.forceSimulation(nodes)
[?2004l[?2004h>         .force("x", d3.forceX(width / 2).strength(0.05))
[?2004l[?2004h>         .force("y", d3.forceY(height / 2).strength(0.05))
[?2004l[?2004h>         .force("collide", d3.forceCollide(d => d.radius + 2))
[?2004l[?2004h>         .force("sectorX", d3.forceX(d => {
[?2004l[?2004h>             const idx = sectors.indexOf(d.sector);
[?2004l[?2004h>             return (idx % 3 + 1) * (width / 4);
[?2004l[?2004h>         }).strength(0.1))
[?2004l[?2004h>         .force("sectorY", d3.forceY(d => {
[?2004l[?2004h>             const idx = sectors.indexOf(d.sector);
[?2004l[?2004h>             return (Math.floor(idx / 3) + 1) * (height / 4);
[?2004l[?2004h>         }).strength(0.1));
[?2004l[?2004h> 
[?2004l[?2004h>     const svg = d3.select("#bubble-chart")
[?2004l[?2004h>         .append("svg")
[?2004l[?2004h>         .attr("width", width)
[?2004l[?2004h>         .attr("height", height);
[?2004l[?2004h> 
[?2004l[?2004h>     const tooltip = d3.select("body").append("div").attr("class", "tooltip");
[?2004l[?2004h> 
[?2004l[?2004h>     const bubbles = svg.selectAll(".bubble-group")
[?2004l[?2004h>         .data(nodes)
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append("g")
[?2004l[?2004h>         .attr("class", "bubble-group")
[?2004l[?2004h>         .on("mouseover", (event, d) => {
[?2004l[?2004h>             if (d.sector !== "ETF" && d.marketCap) {
[?2004l[?2004h>                 tooltip.style("display", "block")
[?2004l[?2004h>                     .html("<strong>" + d.ticker + "</strong><br>" + d["full name"] + "<br>" + d.sector);
[?2004l[?2004h>             }
[?2004l[?2004h>         })
[?2004l[?2004h>         .on("mousemove", (event) => {
[?2004l[?2004h>             tooltip.style("left", (event.pageX + 10) + "px")
[?2004l[?2004h>                 .style("top", (event.pageY + 10) + "px");
[?2004l[?2004h>         })
[?2004l[?2004h>         .on("mouseout", () => tooltip.style("display", "none"))
[?2004l[?2004h>         .on("click", (event, d) => {
[?2004l[?2004h>             highlightRow(d.ticker);
[?2004l[?2004h>             highlightBubble(d.ticker);
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>     bubbles.append("circle")
[?2004l[?2004h>         .attr("class", "bubble")
[?2004l[?2004h>         .attr("r", d => d.radius)
[?2004l[?2004h>         .attr("fill", d => color(d.sector))
[?2004l[?2004h>         .attr("stroke", "#999");
[?2004l[?2004h> 
[?2004l[?2004h>     bubbles.append("text")
[?2004l[?2004h>         .attr("text-anchor", "middle")
[?2004l[?2004h>         .attr("dy", ".3em")
[?2004l[?2004h>         .style("font-size", d => Math.min(d.radius / 2, 12) + "px")
[?2004l[?2004h>         .style("pointer-events", "none")
[?2004l[?2004h>         .text(d => d.ticker);
[?2004l[?2004h> 
[?2004l[?2004h>     simulation.on("tick", () => {
[?2004l[?2004h>         bubbles.attr("transform", d => \`translate(\${d.x},\${d.y})\`);
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     // Legend
[?2004l[?2004h>     const legend = d3.select("#legend");
[?2004l[?2004h>     sectors.forEach(sector => {
[?2004l[?2004h>         const item = legend.append("div").attr("class", "legend-item");
[?2004l[?2004h>         item.append("div").attr("class", "legend-color").style("background-color", color(sector));
[?2004l[?2004h>         item.append("span").text(sector);
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     // Table
[?2004l[?2004h>     const tableBody = d3.select("#stock-table tbody");
[?2004l[?2004h>     const rows = tableBody.selectAll("tr")
[?2004l[?2004h>         .data(data)
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append("tr")
[?2004l[?2004h>         .attr("id", d => "row-" + d.ticker)
[?2004l[?2004h>         .on("click", (event, d) => {
[?2004l[?2004h>             highlightRow(d.ticker);
[?2004l[?2004h>             highlightBubble(d.ticker);
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>     rows.append("td").text(d => d.ticker);
[?2004l[?2004h>     rows.append("td").text(d => d["full name"]);
[?2004l[?2004h>     rows.append("td").text(d => d.sector);
[?2004l[?2004h>     rows.append("td").text(d => formatMarketCap(d.marketCap));
[?2004l[?2004h> 
[?2004l[?2004h>     function formatMarketCap(val) {
[?2004l[?2004h>         if (!val) return "N/A";
[?2004l[?2004h>         if (val >= 1e12) return (val / 1e12).toFixed(2) + "T";
[?2004l[?2004h>         if (val >= 1e9) return (val / 1e9).toFixed(2) + "B";
[?2004l[?2004h>         if (val >= 1e6) return (val / 1e6).toFixed(2) + "M";
[?2004l[?2004h>         return val.toLocaleString();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     function highlightRow(ticker) {
[?2004l[?2004h>         d3.selectAll("tr").classed("highlight", false);
[?2004l[?2004h>         const row = d3.select("#row-" + ticker);
[?2004l[?2004h>         row.classed("highlight", true);
[?2004l[?2004h>         row.node().scrollIntoView({ behavior: "smooth", block: "center" });
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     function highlightBubble(ticker) {
[?2004l[?2004h>         d3.selectAll("circle").style("stroke", "#999").style("stroke-width", "1px");
[?2004l[?2004h>         d3.selectAll(".bubble-group").filter(d => d.ticker === ticker)
[?2004l[?2004h>             .select("circle")
[?2004l[?2004h>             .style("stroke", "black")
[?2004l[?2004h>             .style("stroke-width", "3px");
[?2004l[?2004h>     }
[?2004l[?2004h> });
