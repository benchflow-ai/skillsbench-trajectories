python3 - <<'PY'
import urllib.request, json

def test(ind):
    url=f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'
    try:
        with urllib.request.urlopen(url) as f:
            data=json.load(f)
        # try values
        if 'values' in data and ind in data['values'] and 'GEO' in data['values'][ind]:
            vals=data['values'][ind]['GEO']
            years=sorted(vals.keys())
            print(ind,'ok',len(years),'last',years[-3:],{y:vals[y] for y in years[-3:]})
        else:
            print(ind,'no values keys',data.keys())
    except Exception as e:
        print(ind,'error',e)

for ind in ['NGDPD','NGDP','NGDP_R','NGDP_D','NGDPDPC','NGDP_RPCH']:
    test(ind)
PY
