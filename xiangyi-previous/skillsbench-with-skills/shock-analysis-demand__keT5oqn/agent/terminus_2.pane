[?2004lpython3 - <<'PY'
import openpyxl
wb=openpyxl.load_workbook('test - demand.xlsx')
ws=wb['NA']
formulas=[]
for row in ws.iter_rows():
    for cell in row:
        if cell.data_type=='f' or (isinstance(cell.value,str) and cell.value.startswith('=')):
            formulas.append((cell.coordinate,cell.value))
print('formula cells',len(formulas))
print(formulas[:10])
