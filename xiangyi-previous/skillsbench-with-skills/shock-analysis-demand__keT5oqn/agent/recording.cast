[503.213806, "i", "python3 - <<'PY'\nimport urllib.request, json\n\ndef test(ind):\n    url=f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'\n    try:\n        with urllib.request.urlopen(url) as f:\n            data=json.load(f)\n        # try values\n        if 'values' in data and ind in data['values'] and 'GEO' in data['values'][ind]:\n            vals=data['values'][ind]['GEO']\n            years=sorted(vals.keys())\n            print(ind,'ok',len(years),'last',years[-3:],{y:vals[y] for y in years[-3:]})\n        else:\n            print(ind,'no values keys',data.keys())\n    except Exception as e:\n        print(ind,'error',e)\n\nfor ind in ['NGDPD','NGDP','NGDP_R','NGDP_D','NGDPDPC','NGDP_RPCH']:\n    test(ind)\nPY\n"]
[503.214435, "o", "python3 - <<'PY'\r\nimport urllib.request, json\r\n\r\ndef test(ind):\r\n    url=f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'\r\n    try:\r\n        with urllib.request.urlopen(url) as f:\r\n            data=json.load(f)\r\n        # try values\r\n        if 'values' in data and ind in data['values'] and 'GEO' in data['values'][ind]:\r\n            vals=data['values'][ind]['GEO']\r\n            years=sorted(vals.keys())\r\n            print(ind,'ok',len(years),'last',years[-3:],{y:vals[y] for y in years[-3:]})\r\n        else:\r\n            print(ind,'no values keys',data.keys())\r\n    except Exception as e:\r\n        print(ind,'error',e)\r\n\r\nfor ind in ['NGDPD','NGDP','NGDP_R','NGDP_D','NGDPDPC','NGDP_RPCH']:\r\n    test(ind)\r\nPY\r\n"]
