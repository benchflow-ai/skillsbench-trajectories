[448.155358, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('test - demand.xlsx')\nws=wb['NA']\nformulas=[]\nfor row in ws.iter_rows():\n    for cell in row:\n        if cell.data_type=='f' or (isinstance(cell.value,str) and cell.value.startswith('=')):\n            formulas.append((cell.coordinate,cell.value))\nprint('formula cells',len(formulas))\nprint(formulas[:10])\nPY\n"]
[448.155721, "o", "python3 - <<'PY'\r\nimport openpyxl\r\nwb=openpyxl.load_workbook('test - demand.xlsx')\r\nws=wb['NA']\r\nformulas=[]\r\nfor row in ws.iter_rows():\r\n    for cell in row:\r\n        if cell.data_type=='f' or (isinstance(cell.value,str) and cell.value.startswith('=')):\r\n            formulas.append((cell.coordinate,cell.value))\r\nprint('formula cells',len(formulas))\r\nprint(formulas[:10])\r\nPY\r\n"]
