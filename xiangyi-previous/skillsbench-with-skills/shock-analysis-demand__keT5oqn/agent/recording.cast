[447.316994, "i", "python3 - <<'PY'\nimport urllib.request, re\nurl='https://www.geostat.ge/en/modules/categories/324/supply-and-use-tables'\nhtml=urllib.request.urlopen(url).read().decode('utf-8','ignore')\n# find media links\nfor m in re.findall(r'https?://[^\\\"\\']+', html):\n    if 'media' in m or 'xls' in m or 'xlsx' in m:\n        print(m)\n# print lines with 'media' or 'download'\nfor line in html.split('\\n'):\n    if 'media' in line or 'download' in line or 'file' in line:\n        if len(line)<300:\n            print(line)\nPY\n"]
