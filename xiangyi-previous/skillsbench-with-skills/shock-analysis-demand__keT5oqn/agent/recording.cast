[188.220184, "i", "python3 - <<'PY'\nimport urllib.request, json\n\ndef get(ind):\n    url=f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'\n    with urllib.request.urlopen(url) as f:\n        data=json.load(f)\n    return data['values'][ind]['GEO']\n\nfor ind in ['NGDP_RPCH','NGDP_R','NGDP_D','NGDP']:\n    vals=get(ind)\n    years=sorted(vals.keys())\n    print(ind, 'years', years[:5], '...', years[-5:])\n    print('recent', {y:vals[y] for y in years[-5:]})\nPY\n"]
