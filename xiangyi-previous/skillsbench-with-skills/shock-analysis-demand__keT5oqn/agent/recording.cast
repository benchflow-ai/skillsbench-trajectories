[267.718409, "i", "python3 - <<'PY'\nimport urllib.request, json\nurl='https://www.imf.org/external/datamapper/api/v1/indicators'\nwith urllib.request.urlopen(url) as f:\n    data=json.load(f)\nprint(data.keys())\n# data is dict with 'indicators'\ninds=data.get('indicators',{})\nprint('total',len(inds))\n# filter\nfor k,v in list(inds.items())[:5]:\n    print(k, v.get('label'))\n# search\nfor k,v in inds.items():\n    label=v.get('label','')\n    if 'deflator' in label.lower() or 'real gdp' in label.lower():\n        print(k,label)\nPY\n"]
