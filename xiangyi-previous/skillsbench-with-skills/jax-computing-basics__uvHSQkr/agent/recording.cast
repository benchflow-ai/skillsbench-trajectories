[192.918851, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\n# Let me try using vmap for the MLP\ndata = np.load('data/mlp.npz')\nX = jnp.array(data['X'])\nW1 = jnp.array(data['W1'])\nb1 = jnp.array(data['b1'])\nW2 = jnp.array(data['W2'])\nb2 = jnp.array(data['b2'])\nreference = np.load('reference/jit_mlp.npy')\n\n# Try with vmap - maybe process each sample individually?\n@jax.jit\ndef mlp_single(x, w1, b1, w2, b2):\n    hidden = jnp.tanh(jnp.dot(w1.T, x) + b1)\n    output = jnp.dot(w2.T, hidden) + b2\n    return output\n\ntry:\n    result_vmap = jax.vmap(mlp_single, in_axes=(0, None, None, None, None))(X, W1, b1, W2, b2)\n    print(f\"Vmap with transposed: {np.allclose(result_vmap, reference)}\")\n    print(f\"Result[:2]: {result_vmap[:2]}\")\nexcept Exception as e:\n    print(f\"Vmap error: {e}\")\n\nprint(\"\\nReference[:2]:\")\nprint(reference[:2])\nEOF\n"]
[192.919823, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import jax\r\n\u001b[?2004l\r\u001b[?2004h> import jax.numpy as jnp\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let me try using vmap for the MLP\r\n\u001b[?2004l\r\u001b[?2004h> data = np.load('data/mlp.npz')\r\n\u001b[?2004l\r\u001b[?2004h> X = jnp.array(data['X'])"]
[192.922216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> W1 = jnp.array(data['W1'])\r\n\u001b[?2004l\r\u001b[?2004h> b1 = jnp.array(data['b1'])\r\n\u001b[?2004l\r\u001b[?2004h> W2 = jnp.array(data['W2'])\r\n\u001b[?2004l\r\u001b[?2004h> b2 = jnp.array(data['b2'])\r\n\u001b[?2004l\r\u001b[?2004h> reference = np.load('reference/jit_mlp.npy')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try with vmap - maybe process each sample individually?\r\n\u001b[?2004l\r\u001b[?2004h> @jax.jit\r\n\u001b[?2004l\r\u001b[?2004h> def mlp_single(x, w1, b1, w2, b2):\r\n\u001b[?2004l\r\u001b[?2004h>     hidden = jnp.tanh(jnp.dot(w1.T, x) + b1)\r\n\u001b[?2004l\r\u001b[?2004h>     output = jnp.dot(w2.T, hidden) + b2\r\n\u001b[?2004l\r\u001b[?2004h>     return output\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     result_vmap = jax.vmap(mlp_single, in_axes=(0, None, None, None, None))(X, W1, b1, W2, b2)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Vmap with transposed: {np.allclose(result_vmap, reference)}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Result[:2]: {result_vmap[:2]}\")\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Vmap error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nReference[:2]:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(reference[:2])\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
