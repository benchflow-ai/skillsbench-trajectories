[51.594957, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\n\ntasks = [\n    'basic_reduce.npy',\n    'map_square.npy',\n    'grad_logistic.npy',\n    'scan_rnn.npy',\n    'jit_mlp.npy'\n]\n\nprint(\"Comparing outputs with reference:\")\nprint(\"=\" * 60)\n\nall_match = True\nfor task in tasks:\n    output = np.load(task)\n    reference = np.load(f'reference/{task}')\n    \n    match = np.allclose(output, reference, rtol=1e-5, atol=1e-6)\n    all_match = all_match and match\n    \n    print(f\"{task:20s}: {'✓ MATCH' if match else '✗ MISMATCH'}\")\n    print(f\"  Output shape: {output.shape}, Reference shape: {reference.shape}\")\n    if not match:\n        print(f\"  Max difference: {np.max(np.abs(output - reference))}\")\n\nprint(\"=\" * 60)\nif all_match:\n    print(\"SUCCESS: All outputs match the reference!\")\nelse:\n    print(\"ERROR: Some outputs don't match the reference.\")\nEOF\n"]
