[129.066736, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\n# Load data\ndata = np.load('data/mlp.npz')\nX = jnp.array(data['X'])\nW1 = jnp.array(data['W1'])\nb1 = jnp.array(data['b1'])\nW2 = jnp.array(data['W2'])\nb2 = jnp.array(data['b2'])\n\n# Test without JIT first\ndef mlp_no_jit(x, w1, b1, w2, b2):\n    hidden = jnp.tanh(x @ w1 + b1)\n    output = hidden @ w2 + b2\n    return output\n\nresult_no_jit = mlp_no_jit(X, W1, b1, W2, b2)\n\n# Test with JIT\n@jax.jit\ndef mlp_with_jit(x, w1, b1, w2, b2):\n    hidden = jnp.tanh(x @ w1 + b1)\n    output = hidden @ w2 + b2\n    return output\n\nresult_with_jit = mlp_with_jit(X, W1, b1, W2, b2)\n\nreference = np.load('reference/jit_mlp.npy')\n\nprint(\"No JIT result[:2]:\")\nprint(result_no_jit[:2])\nprint(\"\\nWith JIT result[:2]:\")\nprint(result_with_jit[:2])\nprint(\"\\nReference[:2]:\")\nprint(reference[:2])\nprint(\"\\nNo JIT matches reference:\", np.allclose(result_no_jit, reference))\nprint(\"With JIT matches reference:\", np.allclose(result_with_jit, reference))\nEOF\n"]
