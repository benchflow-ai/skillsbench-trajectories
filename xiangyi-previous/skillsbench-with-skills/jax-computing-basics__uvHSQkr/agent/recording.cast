[90.770824, "o", "    b1 = jnp.array(data['b1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.770915, "o", "    W2 = jnp.array(data['W2'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.770978, "o", "> "]
[90.77108, "o", "    b2 = jnp.array(data['b2'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[90.771151, "o", "\u001b[?2004h>     @jax.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.771231, "o", "    def mlp(x, w1, b1, w2, b2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.771364, "o", "        hidden = jnp.tanh(jnp.dot(x, w1) + b1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.771426, "o", "> "]
[90.771504, "o", "        output = jnp.dot(hidden, w2) + b2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.771575, "o", "        return output\r\n\u001b[?2004l\r"]
[90.771654, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.771738, "o", "    result = mlp(X, W1, b1, W2, b2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.771828, "o", "    np.save('jit_mlp.npy', np.array(result))\r\n\u001b[?2004l\r"]
[90.771891, "o", "\u001b[?2004h> "]
[90.771993, "o", "    print(\"Task 5 (jit_mlp) completed\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
