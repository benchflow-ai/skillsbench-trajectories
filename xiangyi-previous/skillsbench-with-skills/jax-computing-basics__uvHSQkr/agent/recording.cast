[227.59904, "o", "# Task 3: grad_logistic - compute gradient of logistic loss\r\n\u001b[?2004l\r"]
[227.599073, "o", "\u001b[?2004h> "]
[227.599157, "o", "def task_grad_logistic():\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.599199, "o", ">     data = np.load('data/logistic.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599264, "o", "    x = jnp.array(data['x'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599318, "o", "    y = jnp.array(data['y'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599367, "o", "    w = jnp.array(data['w'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.599404, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599475, "o", "    def logistic_loss(w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599535, "o", "        logits = x @ w\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.59961, "o", "        return jnp.mean(jnp.logaddexp(0, -y * logits))\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.599646, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599718, "o", "    gradient = jax.grad(logistic_loss)(w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.599755, "o", "> "]
[227.599823, "o", "    np.save('grad_logistic.npy', np.array(gradient))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.599893, "o", "    print(\"Task 3 (grad_logistic) completed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.599932, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600028, "o", "# Task 4: scan_rnn - implement RNN forward pass using scan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600099, "o", "def task_scan_rnn():\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.600148, "o", ">     data = np.load('data/seq.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.60022, "o", "    seq = jnp.array(data['seq'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600277, "o", "    Wx = jnp.array(data['Wx'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600338, "o", "    Wh = jnp.array(data['Wh'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600393, "o", "    b = jnp.array(data['b'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.60043, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600502, "o", "    def rnn_step(h, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600563, "o", "        h_new = jnp.tanh(Wx @ x + Wh @ h + b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600619, "o", "        return h_new, h_new\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.600653, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600712, "o", "    h0 = jnp.zeros(Wh.shape[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600815, "o", "    final_state, all_states = jax.lax.scan(rnn_step, h0, seq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.600931, "o", "    np.save('scan_rnn.npy', np.array(all_states))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601005, "o", "    print(\"Task 4 (scan_rnn) completed\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.601041, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601131, "o", "# Task 5: jit_mlp - implement and JIT compile a 2-layer MLP\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.601165, "o", "> def task_jit_mlp():\r\n\u001b[?2004l\r"]
[227.601228, "o", "\u001b[?2004h> "]
[227.601264, "o", "    data = np.load('data/mlp.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601339, "o", "    X = jnp.array(data['X'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601375, "o", "    W1 = jnp.array(data['W1'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.601409, "o", "> "]
[227.601442, "o", "    b1 = jnp.array(data['b1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.60151, "o", "    W2 = jnp.array(data['W2'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601569, "o", "    b2 = jnp.array(data['b2'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601604, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601723, "o", "    @jax.jit\r\n\u001b[?2004l\r\u001b[?2004h>     def mlp(x, w1, b1, w2, b2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.601795, "o", "        hidden = jnp.maximum(0, x @ w1 + b1)  # ReLU activation\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.601832, "o", "> "]
[227.6019, "o", "        output = hidden @ w2 + b2\r\n\u001b[?2004l\r\u001b[?2004h>         return output\r\n\u001b[?2004l\r"]
[227.601935, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[227.601969, "o", "\u001b[?2004h> "]
[227.602055, "o", "    result = mlp(X, W1, b1, W2, b2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.602088, "o", "    np.save('jit_mlp.npy', np.array(result))\r\n\u001b[?2004l\r"]
[227.602125, "o", "\u001b[?2004h> "]
[227.602212, "o", "    print(\"Task 5 (jit_mlp) completed\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.60227, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.602305, "o", "    task_basic_reduce()\r\n\u001b[?2004l\r"]
[227.602371, "o", "\u001b[?2004h> "]
[227.602407, "o", "    task_map_square()\r\n\u001b[?2004l\r\u001b[?2004h>     task_grad_logistic()\r\n\u001b[?2004l\r"]
[227.602441, "o", "\u001b[?2004h> "]
[227.602539, "o", "    task_scan_rnn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.602578, "o", "    task_jit_mlp()\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nAll tasks completed!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.602661, "o", "> EOF\r\n\u001b[?2004l\r"]
[227.603972, "o", "\u001b[?2004hroot@dadd2ce7e238:/app# "]
[227.935953, "i", "python3 solve_tasks.py\n"]
[227.93614, "o", "python3 solve_tasks.py\r\n\u001b[?2004l\r"]
[228.791744, "o", "Task 1 (basic_reduce) completed\r\n"]
[228.840479, "o", "Task 2 (map_square) completed\r\n"]
[229.272258, "o", "Task 3 (grad_logistic) completed\r\n"]
[229.39468, "o", "Task 4 (scan_rnn) completed\r\n"]
[229.506321, "o", "Task 5 (jit_mlp) completed\r\n"]
[229.507701, "o", "\r\nAll tasks completed!\r\n"]
[229.851217, "o", "\u001b[?2004hroot@dadd2ce7e238:/app# "]
[238.057653, "i", "python3 << 'EOF'\nimport numpy as np\n\ntasks = [\n    'basic_reduce.npy',\n    'map_square.npy',\n    'grad_logistic.npy',\n    'scan_rnn.npy',\n    'jit_mlp.npy'\n]\n\nprint(\"Comparing outputs with reference:\")\nprint(\"=\" * 60)\n\nall_match = True\nfor task in tasks:\n    output = np.load(task)\n    reference = np.load(f'reference/{task}')\n    \n    match = np.allclose(output, reference, rtol=1e-5, atol=1e-6)\n    all_match = all_match and match\n    \n    print(f\"{task:20s}: {'✓ MATCH' if match else '✗ MISMATCH'}\")\n    print(f\"  Output shape: {output.shape}, Reference shape: {reference.shape}\")\n    if not match:\n        print(f\"  Max difference: {np.max(np.abs(output - reference))}\")\n\nprint(\"=\" * 60)\nif all_match:\n    print(\"SUCCESS: All outputs match the reference!\")\nelse:\n    print(\"ERROR: Some outputs don't match the reference.\")\nEOF\n"]
[238.057869, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[238.057905, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.057925, "o", "> \r\n\u001b[?2004l\r"]
[238.058075, "o", "\u001b[?2004h> "]
[238.058132, "o", "tasks = [\r\n\u001b[?2004l\r\u001b[?2004h>     'basic_reduce.npy',\r\n\u001b[?2004l\r\u001b[?2004h>     'map_square.npy',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.058186, "o", "    'grad_logistic.npy',\r\n\u001b[?2004l\r"]
[238.058213, "o", "\u001b[?2004h>     'scan_rnn.npy',\r\n\u001b[?2004l\r"]
[238.058266, "o", "\u001b[?2004h> "]
[238.058328, "o", "    'jit_mlp.npy'\r\n\u001b[?2004l\r"]
[238.058404, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.058452, "o", "print(\"Comparing outputs with reference:\")\r\n\u001b[?2004l\r"]
[238.058502, "o", "\u001b[?2004h> print(\"=\" * 60)\r\n\u001b[?2004l\r"]
[238.058551, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.058595, "o", "all_match = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.058649, "o", "for task in tasks:\r\n\u001b[?2004l\r"]
[238.0587, "o", "\u001b[?2004h> "]
[238.058752, "o", "    output = np.load(task)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.05883, "o", "    reference = np.load(f'reference/{task}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.058953, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.059, "o", "    match = np.allclose(output, reference, rtol=1e-5, atol=1e-6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.059047, "o", "    all_match = all_match and match\r\n\u001b[?2004l\r"]
[238.059108, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[238.059149, "o", "\u001b[?2004h> "]
[238.059221, "o", "    print(f\"{task:20s}: {'✓ MATCH' if match else '✗ MISMATCH'}\")\r\n\u001b[?2004l\r"]
[238.05927, "o", "\u001b[?2004h> "]
[238.059372, "o", "    print(f\"  Output shape: {output.shape}, Reference shape: {reference.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.059426, "o", "    if not match:\r\n\u001b[?2004l\r"]
[238.059462, "o", "\u001b[?2004h> "]
[238.059555, "o", "        print(f\"  Max difference: {np.max(np.abs(output - reference))}\")\r\n\u001b[?2004l\r"]
[238.059583, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[238.059648, "o", "\u001b[?2004h> "]
[238.059696, "o", "print(\"=\" * 60)\r\n\u001b[?2004l\r\u001b[?2004h> if all_match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.059747, "o", "> "]
[238.0598, "o", "    print(\"SUCCESS: All outputs match the reference!\")\r\n\u001b[?2004l\r"]
[238.059858, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.059932, "o", "    print(\"ERROR: Some outputs don't match the reference.\")\r\n\u001b[?2004l\r"]
[238.059979, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
