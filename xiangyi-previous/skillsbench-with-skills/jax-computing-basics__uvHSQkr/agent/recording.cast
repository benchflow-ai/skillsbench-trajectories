[148.740487, "i", "python3 << 'EOF'\nimport jax.numpy as jnp\nimport numpy as np\n\ndata = np.load('data/mlp.npz')\nX = jnp.array(data['X'])\nW1 = jnp.array(data['W1'])\nb1 = jnp.array(data['b1'])\nW2 = jnp.array(data['W2'])\nb2 = jnp.array(data['b2'])\nreference = np.load('reference/jit_mlp.npy')\n\nprint(\"Testing different formulations:\")\nprint(\"=\"*60)\n\n# Version 1: X @ W1 (current)\nv1 = jnp.tanh(X @ W1 + b1) @ W2 + b2\nprint(f\"V1 (X @ W1): {np.allclose(v1, reference)}\")\nprint(f\"  Result[:2]: {v1[:2]}\")\n\n# Version 2: W1 @ X.T (transposed)\ntry:\n    v2 = jnp.tanh(W1.T @ X.T + b1[:, None]).T @ W2 + b2\n    print(f\"V2 (W1.T @ X.T): {np.allclose(v2, reference)}\")\n    print(f\"  Result[:2]: {v2[:2]}\")\nexcept:\n    print(\"V2: Shape mismatch\")\n\n# Version 3: Maybe apply tanh per-row?\nv3 = jnp.tanh(X @ W1 + b1[None, :]) @ W2 + b2\nprint(f\"V3 (explicit broadcast): {np.allclose(v3, reference)}\")\nprint(f\"  Result[:2]: {v3[:2]}\")\n\n# Version 4: Maybe different activation on output?\nv4 = jnp.tanh(jnp.tanh(X @ W1 + b1) @ W2 + b2)\nprint(f\"V4 (tanh on output too): {np.allclose(v4, reference)}\")\nprint(f\"  Result[:2]: {v4[:2]}\")\n\nprint(\"\\nReference[:2]:\")\nprint(reference[:2])\nEOF\n"]
