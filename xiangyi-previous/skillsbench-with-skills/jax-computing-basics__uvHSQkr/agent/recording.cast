[168.655786, "o", "Trying to reverse engineer from reference...\r\n"]
[168.656013, "o", "Traceback (most recent call last):\r\n  File \"<stdin>\", line 25, in <module>\r\n  File \"/usr/local/lib/python3.12/dist-packages/numpy/_core/numeric.py\", line 2363, in allclose\r\n"]
[168.656361, "o", "    res = all(isclose(a, b, rtol=rtol, atol=atol, equal_nan=equal_nan))\r\n"]
[168.656421, "o", "              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/dist-packages/numpy/_core/numeric.py\", line 2494, in isclose\r\n"]
[168.656899, "o", "    result = (less_equal(abs(x - y), atol + rtol * abs(y))\r\n                             ~~^~~\r\nValueError: operands could not be broadcast together with shapes (8,10) (8,2) \r\n"]
