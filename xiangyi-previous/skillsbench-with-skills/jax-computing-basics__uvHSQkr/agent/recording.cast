[167.860719, "i", "python3 << 'EOF'\nimport numpy as np\nimport jax.numpy as jnp\n\n# Let me manually compute what the reference might be expecting\ndata = np.load('data/mlp.npz')\nX = data['X']\nW1 = data['W1']\nb1 = data['b1']\nW2 = data['W2']\nb2 = data['b2']\n\nprint(\"Trying to reverse engineer from reference...\")\nreference = np.load('reference/jit_mlp.npy')\n\n# Maybe the weights need to be used in reverse order?\n# Try W2 first, then W1\ntry:\n    v_reverse = np.tanh(X @ W2.T[:, :W2.shape[0]] if X.shape[1] != W2.shape[0] else X) \n    print(\"Reverse order won't work with these dimensions\")\nexcept:\n    pass\n\n# Let me check: maybe it's a single layer?\nv_single = X @ W1 + b1\nprint(f\"Single layer (no activation): {np.allclose(v_single, reference)}\")\n\n# Or maybe just first layer with tanh?\nv_first = np.tanh(X @ W1 + b1)\nprint(f\"First layer only: {np.allclose(v_first, reference)}\")\nprint(f\"  Shape: {v_first.shape}, Reference shape: {reference.shape}\")\n\n# Check if maybe the computation is done per-sample\nprint(\"\\nLet me check the actual data values:\")\nprint(f\"X[0]: {X[0]}\")\nprint(f\"W1[0]: {W1[0]}\")\nprint(f\"b1: {b1}\")\nEOF\n"]
