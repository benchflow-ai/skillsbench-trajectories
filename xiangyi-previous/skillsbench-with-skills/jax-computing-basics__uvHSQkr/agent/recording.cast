[112.465388, "i", "python3 << 'EOF'\nimport numpy as np\n\n# Check the actual values to understand the difference\ndata = np.load('data/mlp.npz')\nprint(\"MLP input data:\")\nfor key in data.keys():\n    print(f\"{key}: shape {data[key].shape}\")\n\nprint(\"\\nChecking matrix dimensions:\")\nprint(f\"X: {data['X'].shape} - input data\")\nprint(f\"W1: {data['W1'].shape} - first layer weights\")\nprint(f\"b1: {data['b1'].shape} - first layer bias\")\nprint(f\"W2: {data['W2'].shape} - second layer weights\")\nprint(f\"b2: {data['b2'].shape} - second layer bias\")\n\nprint(\"\\nExpected computation:\")\nprint(\"hidden = tanh(X @ W1 + b1)  -> shape (8, 10)\")\nprint(\"output = hidden @ W2 + b2   -> shape (8, 2)\")\n\noutput = np.load('jit_mlp.npy')\nreference = np.load('reference/jit_mlp.npy')\n\nprint(\"\\nFirst few values comparison:\")\nprint(\"Output:   \", output[:2])\nprint(\"Reference:\", reference[:2])\nprint(\"Difference:\", output[:2] - reference[:2])\nEOF\n"]
