[204.947429, "i", "python3 << 'EOF'\nimport numpy as np\nimport jax.numpy as jnp\n\n# Check ALL the data\ndata = np.load('data/mlp.npz')\nprint(\"All keys in mlp.npz:\", list(data.keys()))\nfor key in data.keys():\n    print(f\"{key}: shape={data[key].shape}, dtype={data[key].dtype}\")\n    print(f\"  First few values: {data[key].flatten()[:5]}\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"Reference output:\")\nref = np.load('reference/jit_mlp.npy')\nprint(f\"Shape: {ref.shape}\")\nprint(f\"First 3 rows:\\n{ref[:3]}\")\n\n# Maybe I should try ReLU instead of tanh?\nX = jnp.array(data['X'])\nW1 = jnp.array(data['W1'])\nb1 = jnp.array(data['b1'])\nW2 = jnp.array(data['W2'])\nb2 = jnp.array(data['b2'])\n\nresult_relu = jnp.maximum(0, X @ W1 + b1) @ W2 + b2\nprint(f\"\\nWith ReLU: {np.allclose(result_relu, ref)}\")\nprint(f\"Result[:2]: {result_relu[:2]}\")\nEOF\n"]
