[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # From handbook product matrix:
[?2004l[?2004h> # 8-zone ovens (8Z_IR+Conv, 8Z_Convection): STD LENGTH CM/MIN = 60-80, so min = 60
[?2004l[?2004h> # 10-zone ovens (10Z_Convection): STD LENGTH CM/MIN = 70-100, so min = 70
[?2004l[?2004h> 
[?2004l[?2004h> # Mapping oven model to minimum speed
[?2004l[?2004h> oven_min_speed = {
[?2004l[?2004h>     '8Z_IR+Conv': 60.0,
[?2004l[?2004h>     '8Z_Convection': 60.0,
[?2004l[?2004h>     '10Z_Convection': 70.0
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for _, row in mes.iterrows():
[?2004l[?2004h>     run_id = row['run_id']
[?2004l[?2004h>     oven_model = row['oven_model']
[?2004l[?2004h>     actual_speed = row['conveyor_speed_cm_min']
[?2004l[?2004h>     
[?2004l[?2004h>     min_speed = oven_min_speed.get(oven_model)
[?2004l[?2004h>     
[?2004l[?2004h>     if min_speed is None:
[?2004l[?2004h>         meets = False
[?2004l[?2004h>     else:
[?2004l[?2004h>         meets = actual_speed >= min_speed
[?2004l[?2004h>     
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'run_id': run_id,
[?2004l[?2004h>         'required_min_speed_cm_min': min_speed,
[?2004l[?2004h>         'actual_speed_cm_min': round(actual_speed, 2),
[?2004l[?2004h>         'meets': meets
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by run_id
[?2004l[?2004h> results = sorted(results, key=lambda x: x['run_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(json.dumps(results[:15], indent=2))
[?2004l[?2004h> 
[?2004l[?2004h> # Count meets/doesn't meet
[?2004l[?2004h> meets_count = sum(1 for r in results if r['meets'])
[?2004l[?2004h> print(f"\nMeets requirement: {meets_count}, Doesn't meet: {len(results) - meets_count}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save to file
[?2004l[?2004h> with open('/app/output/q04.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSaved to /app/output/q04.json")
