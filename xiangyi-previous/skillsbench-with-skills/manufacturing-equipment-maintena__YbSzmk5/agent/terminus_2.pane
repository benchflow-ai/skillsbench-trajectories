[?2004hroot@bcae08a41174:/app# python3 << 'ENDSCRIPT'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> tc = pd.read_csv('/app/data/thermocouples.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Handbook specifications:
[?2004l[?2004h> # Preheat zone: 100°C to 150°C
[?2004l[?2004h> # Ramp rate limit: < 2°C/second (so max allowed is 2.0)
[?2004l[?2004h> # Use largest_mass thermocouple
[?2004l[?2004h> 
[?2004l[?2004h> PREHEAT_MIN = 100.0
[?2004l[?2004h> PREHEAT_MAX = 150.0
[?2004l[?2004h> RAMP_LIMIT = 2.0  # °C/second
[?2004l[?2004h> 
[?2004l[?2004h> # Filter for largest_mass thermocouple only
[?2004l[?2004h> tc_largest = tc[tc['tc_location'] == 'largest_mass'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_max_preheat_ramp(run_data):
[?2004l[?2004h>     """Calculate max ramp rate during preheat phase (100-150°C)"""
[?2004l[?2004h>     run_data = run_data.sort_values('time_s')
[?2004l[?2004h>     
[?2004l[?2004h>     # Find data points in preheat range
[?2004l[?2004h>     preheat_data = run_data[(run_data['temp_c'] >= PREHEAT_MIN) & (run_data['temp_c'] <= PREHEAT_MAX)]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(preheat_data) < 2:
[?2004l[?2004h>         return None, None
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate ramp rates between consecutive points
[?2004l[?2004h>     temps = preheat_data['temp_c'].values
[?2004l[?2004h>     times = preheat_data['time_s'].values
[?2004l[?2004h>     
[?2004l[?2004h>     max_ramp = 0.0
[?2004l[?2004h>     for i in range(1, len(temps)):
[?2004l[?2004h>         dt = times[i] - times[i-1]
[?2004l[?2004h>         if dt > 0:
[?2004l[?2004h>             ramp = (temps[i] - temps[i-1]) / dt
[?2004l[?2004h>             if ramp > max_ramp:
[?2004l[?2004h>                 max_ramp = ramp
[?2004l[?2004h>     
[?2004l[?2004h>     tc_id = run_data['tc_id'].iloc[0]
[?2004l[?2004h>     return tc_id, round(max_ramp, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate for each run
[?2004l[?2004h> results = {}
[?2004l[?2004h> violating_runs = []
[?2004l[?2004h> 
[?2004l[?2004h> for run_id in sorted(tc_largest['run_id'].unique()):
[?2004l[?2004h>     run_data = tc_largest[tc_largest['run_id'] == run_id]
[?2004l[?2004h>     tc_id, max_ramp = calculate_max_preheat_ramp(run_data)
[?2004l[?2004h>     
[?2004l[?2004h>     if max_ramp is not None:
[?2004l[?2004h>         results[run_id] = {
[?2004l[?2004h>             'tc_id': tc_id,
[?2004l[?2004h>             'max_preheat_ramp_c_per_s': max_ramp
[?2004l[?2004h>         }
[?2004l[?2004h>         if max_ramp > RAMP_LIMIT:
[?2004l[?2004h>             violating_runs.append(run_id)
[?2004l[?2004h> 
[?2004l[?2004h> # Create output
[?2004l[?2004h> output = {
[?2004l[?2004h>     'ramp_rate_limit_c_per_s': RAMP_LIMIT,
[?2004l[?2004h>     'violating_runs': sorted(violating_runs),
[?2004l[?2004h>     'max_ramp_by_run': results
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> print(json.dumps(output, indent=2))
[?2004l[?2004h> 
[?2004l[?2004h> # Save to file
[?2004l[?2004h> with open('/app/output/q01.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSaved to /app/output/q01.json")
[?2004l[?2004h> print(f"\nViolating runs: {len(violating_runs)}")
