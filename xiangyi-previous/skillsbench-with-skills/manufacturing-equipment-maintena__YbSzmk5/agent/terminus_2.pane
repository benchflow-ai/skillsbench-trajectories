[?2004hroot@bcae08a41174:/app# python3 << 'ENDSCRIPT'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> tc = pd.read_csv('/app/data/thermocouples.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Handbook specifications:
[?2004l[?2004h> # TAL (wetting time): 30-60 seconds
[?2004l[?2004h> # Use largest_mass thermocouple
[?2004l[?2004h> 
[?2004l[?2004h> TAL_MIN = 30.0  # seconds
[?2004l[?2004h> TAL_MAX = 60.0  # seconds
[?2004l[?2004h> 
[?2004l[?2004h> # Create run to liquidus mapping
[?2004l[?2004h> run_liquidus = dict(zip(mes['run_id'], mes['solder_liquidus_c']))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter for largest_mass thermocouple
[?2004l[?2004h> tc_largest = tc[tc['tc_location'] == 'largest_mass'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_tal(run_data, liquidus_temp):
[?2004l[?2004h>     """Calculate Time Above Liquidus by counting intervals above liquidus"""
[?2004l[?2004h>     run_data = run_data.sort_values('time_s')
[?2004l[?2004h>     
[?2004l[?2004h>     # Get time step (should be 10 seconds)
[?2004l[?2004h>     times = run_data['time_s'].values
[?2004l[?2004h>     temps = run_data['temp_c'].values
[?2004l[?2004h>     
[?2004l[?2004h>     if len(times) < 2:
[?2004l[?2004h>         return None, 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     time_step = times[1] - times[0]  # Usually 10 seconds
[?2004l[?2004h>     
[?2004l[?2004h>     # Count intervals where temperature is above liquidus
[?2004l[?2004h>     # Each point above liquidus represents time_step seconds of TAL
[?2004l[?2004h>     above_liquidus_count = sum(1 for t in temps if t > liquidus_temp)
[?2004l[?2004h>     
[?2004l[?2004h>     # TAL = number of points above liquidus * time_step
[?2004l[?2004h>     # But we need to be more precise - count the actual time intervals
[?2004l[?2004h>     # If a point is above liquidus, it means the board was above liquidus
[?2004l[?2004h>     # for approximately time_step seconds centered on that point
[?2004l[?2004h>     
[?2004l[?2004h>     tal = above_liquidus_count * time_step
[?2004l[?2004h>     
[?2004l[?2004h>     tc_id = run_data['tc_id'].iloc[0]
[?2004l[?2004h>     return tc_id, round(float(tal), 2)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate for each run
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for run_id in sorted(tc_largest['run_id'].unique()):
[?2004l[?2004h>     run_data = tc_largest[tc_largest['run_id'] == run_id]
[?2004l[?2004h>     liquidus = run_liquidus.get(run_id)
[?2004l[?2004h>     
[?2004l[?2004h>     if liquidus is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     tc_id, tal = calculate_tal(run_data, liquidus)
[?2004l[?2004h>     
[?2004l[?2004h>     if tc_id is not None:
[?2004l[?2004h>         status = 'compliant' if TAL_MIN <= tal <= TAL_MAX else 'non-compliant'
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'run_id': run_id,
[?2004l[?2004h>             'tc_id': tc_id,
[?2004l[?2004h>             'tal_s': tal,
[?2004l[?2004h>             'required_min_tal_s': TAL_MIN,
[?2004l[?2004h>             'required_max_tal_s': TAL_MAX,
[?2004l[?2004h>             'status': status
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by run_id
[?2004l[?2004h> results = sorted(results, key=lambda x: x['run_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(json.dumps(results[:10], indent=2))
[?2004l[?2004h> 
[?2004l[?2004h> # Count compliance
[?2004l[?2004h> compliant = sum(1 for r in results if r['status'] == 'compliant')
[?2004l[?2004h> print(f"\nCompliant: {compliant}, Non-compliant: {len(results) - compliant}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save to file
[?2004l[?2004h> with open('/app/output/q02.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
