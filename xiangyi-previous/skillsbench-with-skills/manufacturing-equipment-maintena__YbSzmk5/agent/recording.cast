[412.204894, "o", "# Handbook specifications:\r\n\u001b[?2004l\r"]
[412.204916, "o", "\u001b[?2004h> "]
[412.204996, "o", "# TAL (wetting time): 30-60 seconds\r\n\u001b[?2004l\r"]
[412.205019, "o", "\u001b[?2004h> "]
[412.205121, "o", "# Use largest_mass thermocouple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.205144, "o", "\u001b[?2004h> "]
[412.205187, "o", "TAL_MIN = 30.0  # seconds\r\n\u001b[?2004l\r"]
[412.205209, "o", "\u001b[?2004h> "]
