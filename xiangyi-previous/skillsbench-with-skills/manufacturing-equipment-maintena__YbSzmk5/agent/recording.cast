[488.501131, "i", "python3 << 'ENDSCRIPT'\nimport json\n\n# Final validation\nprint(\"=== Final Validation ===\")\n\n# Q1\nwith open('/app/output/q01.json', 'r') as f:\n    q1 = json.load(f)\nassert 'ramp_rate_limit_c_per_s' in q1\nassert 'violating_runs' in q1\nassert 'max_ramp_by_run' in q1\nassert isinstance(q1['violating_runs'], list)\nassert isinstance(q1['max_ramp_by_run'], dict)\nprint(\"Q1: VALID\")\n\n# Q2\nwith open('/app/output/q02.json', 'r') as f:\n    q2 = json.load(f)\nassert isinstance(q2, list)\nfor item in q2:\n    assert 'run_id' in item\n    assert 'tc_id' in item\n    assert 'tal_s' in item\n    assert 'required_min_tal_s' in item\n    assert 'required_max_tal_s' in item\n    assert 'status' in item\n    assert item['status'] in ['compliant', 'non-compliant']\nprint(\"Q2: VALID\")\n\n# Q3\nwith open('/app/output/q03.json', 'r') as f:\n    q3 = json.load(f)\nassert 'failing_runs' in q3\nassert 'min_peak_by_run' in q3\nassert isinstance(q3['failing_runs'], list)\nassert isinstance(q3['min_peak_by_run'], dict)\nprint(\"Q3: VALID\")\n\n# Q4\nwith open('/app/output/q04.json', 'r') as f:\n    q4 = json.load(f)\nassert isinstance(q4, list)\nfor item in q4:\n    assert 'run_id' in item\n    assert 'required_min_speed_cm_min' in item\n    assert 'actual_speed_cm_min' in item\n    assert 'meets' in item\n    assert isinstance(item['meets'], bool)\nprint(\"Q4: VALID\")\n\n# Q5\nwith open('/app/output/q05.json', 'r') as f:\n    q5 = json.load(f)\nassert isinstance(q5, list)\nfor item in q5:\n    assert 'board_family' in item\n    assert 'best_run_id' in item\n    assert 'runner_up_run_ids' in item\n    assert isinstance(item['runner_up_run_ids'], list)\nprint(\"Q5: VALID\")\n\nprint(\"\\n=== ALL VALIDATIONS PASSED ===\")\nprint(\"All 5 output files are correctly formatted.\")\nENDSCRIPT\n"]
