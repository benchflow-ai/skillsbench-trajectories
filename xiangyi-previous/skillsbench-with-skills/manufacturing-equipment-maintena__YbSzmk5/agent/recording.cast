[434.654903, "i", "python3 << 'ENDSCRIPT'\nimport json\n\n# Check Q4\nwith open('/app/output/q04.json', 'r') as f:\n    q4 = json.load(f)\n\nprint(\"Q4 - Conveyor Speed Check:\")\nprint(f\"Total runs: {len(q4)}\")\nmeets = sum(1 for r in q4 if r['meets'])\nprint(f\"Meets requirement: {meets}\")\nprint(f\"Doesn't meet: {len(q4) - meets}\")\nprint(f\"\\nSample entries:\")\nfor entry in q4[:5]:\n    print(f\"  {entry}\")\nENDSCRIPT\n"]
[434.655095, "o", "python3 << 'ENDSCRIPT'\r\n\u001b[?2004l\r"]
[434.655189, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
