[217.146403, "o", "{\r\n  \"ramp_rate_limit_c_per_s\": 2.0,\r\n  \"violating_runs\": [\r\n    \"R0035\",\r\n    \"R0040\",\r\n    \"R0044\"\r\n  ],\r\n  \"max_ramp_by_run\": {\r\n    \"R0001\": {\r\n      \"tc_id\": \"TC1\",\r\n      \"max_preheat_ramp_c_per_s\": 1.74\r\n    },\r\n    \"R0002\": {\r\n      \"tc_id\": \"TC1\",\r\n      \"max_preheat_ramp_c_per_s\": 1.07\r\n    },\r\n    \"R0003\": {\r\n      \"tc_id\": \"TC1\",\r\n      \"max_preheat_ramp_c_per_s\": 0.99\r\n    },\r\n    \"R0004\": {\r\n      \"tc_id\": \"TC1\",\r\n      \"max_preheat_ramp_c_per_s\": 1.6\r\n    },\r\n    \"R0005\": {\r\n      \"tc_id\": \"TC1\",\r\n      \"max_preheat_ramp_c_per_s\": 1.48\r\n    },\r\n    \"R0006\": {\r\n      \"tc_id\": \"TC1\",\r\n"]
[217.146615, "o", "\u001b[?2004hroot@bcae08a41174:/app# "]
[217.641743, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes = pd.read_csv('/app/data/mes_log.csv')\ntc = pd.read_csv('/app/data/thermocouples.csv')\n\n# Handbook specifications:\n# TAL (wetting time): 30-60 seconds\n# Use largest_mass thermocouple\n# Liquidus temperature from MES log (solder_liquidus_c)\n\nTAL_MIN = 30.0  # seconds\nTAL_MAX = 60.0  # seconds\n\n# Create run to liquidus mapping\nrun_liquidus = dict(zip(mes['run_id'], mes['solder_liquidus_c']))\n\n# Filter for largest_mass thermocouple\ntc_largest = tc[tc['tc_location'] == 'largest_mass'].copy()\n\ndef calculate_tal(run_data, liquidus_temp):\n    \"\"\"Calculate Time Above Liquidus\"\"\"\n    run_data = run_data.sort_values('time_s')\n    \n    # Find time points where temperature is above liquidus\n    above_liquidus = run_data[run_data['temp_c'] > liquidus_temp]\n    \n    if len(above_liquidus) < 2:\n        return None, 0.0\n    \n    # Calculate total time above liquidus\n    # Each data point represents a 10-second interval\n    times = above_liquidus['time_s'].values\n    \n    # TAL is the time span from first to last point above liquidus\n    # But we need to count actual time spent above liquidus\n    # Since data is at 10-second intervals, count number of intervals\n    tal = times[-1] - times[0]\n    \n    # Add the last interval (10 seconds) since the last point is also above liquidus\n    # Actually, let's count the number of points and multiply by interval\n    # But more accurate: use the time span\n    \n    tc_id = run_data['tc_id'].iloc[0]\n    return tc_id, round(float(tal), 2)\n\n# Calculate for each run\nresults = []\n\nfor run_id in sorted(tc_largest['run_id'].unique()):\n    run_data = tc_largest[tc_largest['run_id'] == run_id]\n    liquidus = run_liquidus.get(run_id)\n    \n    if liquidus is None:\n        continue\n    \n    tc_id, tal = calculate_tal(run_data, liquidus)\n    \n    if tc_id is not None:\n        status = 'compliant' if TAL_MIN <= tal <= TAL_MAX else 'non-compliant'\n        results.append({\n            'run_id': run_id,\n            'tc_id': tc_id,\n            'tal_s': tal,\n            'required_min_tal_s': TAL_MIN,\n            'required_max_tal_s': TAL_MAX,\n            'status': status\n        })\n\n# Sort by run_id\nresults = sorted(results, key=lambda x: x['run_id'])\n\nprint(json.dumps(results[:10], indent=2))\nprint(f\"\\n... and {len(results)-10} more runs\")\n\n# Count compliance\ncompliant = sum(1 for r in results if r['status'] == 'compliant')\nprint(f\"\\nCompliant: {compliant}, Non-compliant: {len(results) - compliant}\")\n\n# Save to file\nwith open('/app/output/q02.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nSaved to /app/output/q02.json\")\nENDSCRIPT\n"]
