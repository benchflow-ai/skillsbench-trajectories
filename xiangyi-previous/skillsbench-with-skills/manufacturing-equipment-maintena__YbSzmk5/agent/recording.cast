[412.205387, "o", "# Create run to liquidus mapping\r\n\u001b[?2004l\r"]
[412.205411, "o", "\u001b[?2004h> "]
[412.205544, "o", "run_liquidus = dict(zip(mes['run_id'], mes['solder_liquidus_c']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.20573, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.205769, "o", "# Filter for largest_mass thermocouple\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.205839, "o", "tc_largest = tc[tc['tc_location'] == 'largest_mass'].copy()\r\n\u001b[?2004l\r"]
[412.205875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.206639, "o", "def calculate_tal(run_data, liquidus_temp):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Calculate Time Above Liquidus by counting intervals above liquidus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     run_data = run_data.sort_values('time_s')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Get time step (should be 10 seconds)\r\n\u001b[?2004l\r\u001b[?2004h>     times = run_data['time_s'].values\r\n\u001b[?2004l\r\u001b[?2004h>     temps = run_data['temp_c'].values\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.206676, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.206725, "o", "    if len(times) < 2:\r\n\u001b[?2004l\r"]
[412.206754, "o", "\u001b[?2004h> "]
[412.206811, "o", "        return None, 0.0\r\n\u001b[?2004l\r"]
[412.206853, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.206991, "o", "    time_step = times[1] - times[0]  # Usually 10 seconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.207064, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.207217, "o", "    # Count intervals where temperature is above liquidus\r\n\u001b[?2004l\r"]
[412.207357, "o", "\u001b[?2004h> "]
[412.207462, "o", "    # Each point above liquidus represents time_step seconds of TAL\r\n\u001b[?2004l\r"]
[412.207491, "o", "\u001b[?2004h> "]
[412.208581, "o", "    above_liquidus_count = sum(1 for t in temps if t > liquidus_temp)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # TAL = number of points above liquidus * time_step\r\n\u001b[?2004l\r\u001b[?2004h>     # But we need to be more precise - count the actual time intervals\r\n\u001b[?2004l\r\u001b[?2004h>     # If a point is above liquidus, it means the board was above liquidus\r\n\u001b[?2004l\r\u001b[?2004h>     # for approximately time_step seconds centered on that point\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     tal = above_liquidus_count * time_step\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     tc_id = run_data['tc_id'].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.208738, "o", "    return tc_id, round(float(tal), 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.208811, "o", "# Calculate for each run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.208929, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.208958, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209111, "o", "for run_id in sorted(tc_largest['run_id'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209271, "o", "    run_data = tc_largest[tc_largest['run_id'] == run_id]\r\n\u001b[?2004l\r\u001b[?2004h>     liquidus = run_liquidus.get(run_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209362, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     if liquidus is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209416, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.20952, "o", "    tc_id, tal = calculate_tal(run_data, liquidus)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[412.209557, "o", "\u001b[?2004h> "]
[412.209614, "o", "    if tc_id is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.20978, "o", "        status = 'compliant' if TAL_MIN <= tal <= TAL_MAX else 'non-compliant'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209851, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.209948, "o", "            'run_id': run_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.21008, "o", "            'tc_id': tc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210215, "o", "            'tal_s': tal,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210315, "o", "            'required_min_tal_s': TAL_MIN,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210394, "o", "            'required_max_tal_s': TAL_MAX,\r\n\u001b[?2004l\r\u001b[?2004h>             'status': status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210485, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210574, "o", "# Sort by run_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210643, "o", "results = sorted(results, key=lambda x: x['run_id'])\r\n\u001b[?2004l\r"]
[412.210717, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.210792, "o", "print(json.dumps(results[:10], indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.210873, "o", "\u001b[?2004h> # Count compliance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.21102, "o", "compliant = sum(1 for r in results if r['status'] == 'compliant')\r\n\u001b[?2004l\r"]
[412.21108, "o", "\u001b[?2004h> "]
[412.211202, "o", "print(f\"\\nCompliant: {compliant}, Non-compliant: {len(results) - compliant}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.21128, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.211312, "o", "# Save to file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.21139, "o", "with open('/app/output/q02.json', 'w') as f:\r\n\u001b[?2004l\r"]
[412.211416, "o", "\u001b[?2004h> "]
[412.211486, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[412.211508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.211532, "o", "\u001b[?2004h> "]
[412.211622, "o", "print(\"\\nSaved to /app/output/q02.json\")\r\n\u001b[?2004l\r"]
[412.211644, "o", "\u001b[?2004h> "]
[412.211667, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
[412.823219, "o", "[\r\n  {\r\n    \"run_id\": \"R0001\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 130.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0002\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 100.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0003\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 80.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0004\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 50.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0005\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 0.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0006\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 130.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0007\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 150.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0008\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 10.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0009\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 20.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  },\r\n  {\r\n    \"run_id\": \"R0010\",\r\n    \"tc_id\": \"TC1\",\r\n    \"tal_s\": 200.0,\r\n    \"required_min_tal_s\": 30.0,\r\n    \"required_max_tal_s\": 60.0,\r\n    \"status\": \"non-compliant\"\r\n  }\r\n]\r\n\r\nCompliant: 14, Non-compliant: 46\r\n"]
