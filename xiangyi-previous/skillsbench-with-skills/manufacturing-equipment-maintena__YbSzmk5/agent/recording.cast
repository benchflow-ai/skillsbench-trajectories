[240.189286, "o", "\u001b[?2004hroot@bcae08a41174:/app# "]
[240.690593, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes = pd.read_csv('/app/data/mes_log.csv')\ntc = pd.read_csv('/app/data/thermocouples.csv')\n\n# Handbook specifications:\n# Peak temperature should exceed liquidus by ~20°C\n# So minimum peak = liquidus + 20\n# Use largest_mass thermocouple (slowest heating, most critical)\n\nPEAK_MARGIN = 20.0  # °C above liquidus\n\n# Create run to liquidus mapping\nrun_liquidus = dict(zip(mes['run_id'], mes['solder_liquidus_c']))\n\n# Filter for largest_mass thermocouple\ntc_largest = tc[tc['tc_location'] == 'largest_mass'].copy()\n\ndef get_peak_temp(run_data):\n    \"\"\"Get peak temperature for a run\"\"\"\n    if len(run_data) == 0:\n        return None, None\n    \n    peak_temp = run_data['temp_c'].max()\n    tc_id = run_data['tc_id'].iloc[0]\n    return tc_id, round(float(peak_temp), 2)\n\n# Calculate for each run\nall_runs = sorted(mes['run_id'].unique())\nruns_with_tc = set(tc_largest['run_id'].unique())\n\nfailing_runs = []\nmin_peak_by_run = {}\n\nfor run_id in all_runs:\n    liquidus = run_liquidus.get(run_id)\n    required_min_peak = liquidus + PEAK_MARGIN if liquidus else None\n    \n    if run_id not in runs_with_tc:\n        # No thermocouple data - failing\n        failing_runs.append(run_id)\n        min_peak_by_run[run_id] = {\n            'tc_id': None,\n            'peak_temp_c': None,\n            'required_min_peak_c': required_min_peak\n        }\n        continue\n    \n    run_data = tc_largest[tc_largest['run_id'] == run_id]\n    tc_id, peak_temp = get_peak_temp(run_data)\n    \n    min_peak_by_run[run_id] = {\n        'tc_id': tc_id,\n        'peak_temp_c': peak_temp,\n        'required_min_peak_c': round(required_min_peak, 2) if required_min_peak else None\n    }\n    \n    if peak_temp is None or (required_min_peak and peak_temp < required_min_peak):\n        failing_runs.append(run_id)\n\n# Create output\noutput = {\n    'failing_runs': sorted(failing_runs),\n    'min_peak_by_run': min_peak_by_run\n}\n\nprint(f\"Failing runs: {len(failing_runs)}\")\nprint(f\"Failing run IDs: {failing_runs[:10]}...\" if len(failing_runs) > 10 else f\"Failing run IDs: {failing_runs}\")\n\n# Show some examples\nfor run_id in list(min_peak_by_run.keys())[:5]:\n    print(f\"{run_id}: {min_peak_by_run[run_id]}\")\n\n# Save to file\nwith open('/app/output/q03.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(\"\\nSaved to /app/output/q03.json\")\nENDSCRIPT\n"]
