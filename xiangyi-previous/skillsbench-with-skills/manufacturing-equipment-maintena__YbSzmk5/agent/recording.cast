[447.097088, "i", "python3 << 'ENDSCRIPT'\nimport json\n\n# Validate all output files\nprint(\"=== Q1 Validation ===\")\nwith open('/app/output/q01.json', 'r') as f:\n    q1 = json.load(f)\nprint(f\"Keys: {list(q1.keys())}\")\nprint(f\"ramp_rate_limit_c_per_s: {q1['ramp_rate_limit_c_per_s']}\")\nprint(f\"violating_runs count: {len(q1['violating_runs'])}\")\nprint(f\"max_ramp_by_run count: {len(q1['max_ramp_by_run'])}\")\n\nprint(\"\\n=== Q2 Validation ===\")\nwith open('/app/output/q02.json', 'r') as f:\n    q2 = json.load(f)\nprint(f\"Type: {type(q2)}\")\nprint(f\"Count: {len(q2)}\")\nif len(q2) > 0:\n    print(f\"First entry keys: {list(q2[0].keys())}\")\n\nprint(\"\\n=== Q3 Validation ===\")\nwith open('/app/output/q03.json', 'r') as f:\n    q3 = json.load(f)\nprint(f\"Keys: {list(q3.keys())}\")\nprint(f\"failing_runs count: {len(q3['failing_runs'])}\")\nprint(f\"min_peak_by_run count: {len(q3['min_peak_by_run'])}\")\n\nprint(\"\\n=== Q4 Validation ===\")\nwith open('/app/output/q04.json', 'r') as f:\n    q4 = json.load(f)\nprint(f\"Type: {type(q4)}\")\nprint(f\"Count: {len(q4)}\")\nif len(q4) > 0:\n    print(f\"First entry keys: {list(q4[0].keys())}\")\n\nprint(\"\\n=== Q5 Validation ===\")\nwith open('/app/output/q05.json', 'r') as f:\n    q5 = json.load(f)\nprint(f\"Type: {type(q5)}\")\nprint(f\"Count: {len(q5)}\")\nif len(q5) > 0:\n    print(f\"First entry keys: {list(q5[0].keys())}\")\n    print(f\"Board families: {[x['board_family'] for x in q5]}\")\n\nprint(\"\\n=== All validations passed ===\")\nENDSCRIPT\n"]
