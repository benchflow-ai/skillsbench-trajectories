[464.257676, "i", "echo \"=== Final Output Summary ===\"\necho \"\"\necho \"Q1 - Preheat Ramp Rate Analysis:\"\ncat /app/output/q01.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(f'  Limit: {d[\\\"ramp_rate_limit_c_per_s\\\"]} C/s'); print(f'  Violating runs: {d[\\\"violating_runs\\\"]}')\"\necho \"\"\necho \"Q2 - TAL Analysis:\"\ncat /app/output/q02.json | python3 -c \"import json,sys; d=json.load(sys.stdin); c=sum(1 for x in d if x['status']=='compliant'); print(f'  Compliant: {c}, Non-compliant: {len(d)-c}')\"\necho \"\"\necho \"Q3 - Peak Temperature Analysis:\"\ncat /app/output/q03.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(f'  Failing runs: {d[\\\"failing_runs\\\"]}')\"\necho \"\"\necho \"Q4 - Conveyor Speed Analysis:\"\ncat /app/output/q04.json | python3 -c \"import json,sys; d=json.load(sys.stdin); m=sum(1 for x in d if x['meets']); print(f'  Meets: {m}, Does not meet: {len(d)-m}')\"\necho \"\"\necho \"Q5 - Best Run per Board Family:\"\ncat /app/output/q05.json | python3 -c \"import json,sys; d=json.load(sys.stdin); [print(f'  {x[\\\"board_family\\\"]}: {x[\\\"best_run_id\\\"]}') for x in d]\"\n"]
[464.257922, "o", "echo \"=== Final Output Summary ===\"\r\n\u001b[?2004l\r"]
