[488.509734, "o", "\u001b[?2004h> assert isinstance(q3['min_peak_by_run'], dict)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Q3: VALID\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Q4\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/output/q04.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     q4 = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(q4, list)\r\n\u001b[?2004l\r\u001b[?2004h> for item in q4:\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'run_id' in item\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'required_min_speed_cm_min' in item\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'actual_speed_cm_min' in item\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'meets' in item\r\n\u001b[?2004l\r\u001b[?2004h>     assert isinstance(item['meets'], bool)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Q4: VALID\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Q5\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/output/q05.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     q5 = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(q5, list)\r\n\u001b[?2004l\r\u001b[?2004h> for item in q5:\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'board_family' in item\r\n\u001b[?2004l\r\u001b[?2004h"]
