[348.761432, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\n\ndefects = pd.read_csv('/app/data/test_defects.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\n# Look at SUMMARY rows for yield information\nsummary = defects[defects['inspection_stage'] == 'SUMMARY']\nprint(\"Summary data columns:\", summary.columns.tolist())\nprint(\"\\nSummary data:\")\nprint(summary[['run_id', 'units_tested', 'units_pass', 'units_rework', 'units_scrap', 'fp_yield_pct']].head(20).to_string())\n\n# Merge with MES to get board_family\nprint(\"\\nBoard families in MES:\")\nprint(mes['board_family'].unique())\n\n# Create run to board_family mapping\nrun_to_family = dict(zip(mes['run_id'], mes['board_family']))\nsummary['board_family'] = summary['run_id'].map(run_to_family)\n\nprint(\"\\nSummary with board_family:\")\nprint(summary[['run_id', 'board_family', 'fp_yield_pct', 'units_tested']].head(20).to_string())\nENDSCRIPT\n"]
