[308.287982, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ntc = pd.read_csv('/app/data/thermocouples.csv')\n\n# Get total process time for each run\ntc_times = tc.groupby('run_id')['time_s'].agg(['min', 'max'])\ntc_times['total_time_s'] = tc_times['max'] - tc_times['min']\n\nprint(\"Process times by run:\")\nprint(tc_times.head(20))\n\n# Merge with MES data\nmes_with_time = mes.merge(tc_times, left_on='run_id', right_index=True)\nprint(\"\\nMES with process times:\")\nprint(mes_with_time[['run_id', 'oven_model', 'board_length_cm', 'conveyor_speed_cm_min', 'total_time_s']].head(15).to_string())\n\n# Calculate what the speed should be based on board length and process time\n# Speed = Distance / Time\n# But we need to understand the relationship between board length and heated length\nENDSCRIPT\n"]
