[366.031225, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport json\n\ndefects = pd.read_csv('/app/data/test_defects.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\n# Get summary data with yield\nsummary = defects[defects['inspection_stage'] == 'SUMMARY'].copy()\n\n# Create run to board_family and conveyor_speed mapping\nrun_to_family = dict(zip(mes['run_id'], mes['board_family']))\nrun_to_speed = dict(zip(mes['run_id'], mes['conveyor_speed_cm_min']))\n\nsummary['board_family'] = summary['run_id'].map(run_to_family)\nsummary['conveyor_speed'] = summary['run_id'].map(run_to_speed)\n\n# For best run selection:\n# 1. Primary: Higher yield (fp_yield_pct)\n# 2. Secondary: Higher efficiency (conveyor_speed)\n\nresults = []\n\nfor family in sorted(summary['board_family'].unique()):\n    family_data = summary[summary['board_family'] == family].copy()\n    \n    # Sort by yield (descending), then by conveyor_speed (descending)\n    family_data = family_data.sort_values(\n        ['fp_yield_pct', 'conveyor_speed'], \n        ascending=[False, False]\n    )\n    \n    runs = family_data['run_id'].tolist()\n    \n    if len(runs) > 0:\n        best_run = runs[0]\n        runner_ups = runs[1:] if len(runs) > 1 else []\n        \n        results.append({\n            'board_family': family,\n            'best_run_id': best_run,\n            'runner_up_run_ids': sorted(runner_ups)\n        })\n\n# Sort by board_family\nresults = sorted(results, key=lambda x: x['board_family'])\n\nprint(json.dumps(results, indent=2))\n\n# Save to file\nwith open('/app/output/q05.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"\\nSaved to /app/output/q05.json\")\n\n# Show details for verification\nprint(\"\\nDetails by family:\")\nfor family in sorted(summary['board_family'].unique()):\n    family_data = summary[summary['board_family'] == family].copy()\n    family_data = family_data.sort_values(['fp_yield_pct', 'conveyor_speed'], ascending=[False, False])\n    print(f\"\\n{family}:\")\n    print(family_data[['run_id', 'fp_yield_pct', 'conveyor_speed']].head(5).to_string())\nENDSCRIPT\n"]
