[388.881929, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Check a specific run's temperature profile\ntc = pd.read_csv('/app/data/thermocouples.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\n# Get liquidus for R0001\nliquidus = mes[mes['run_id'] == 'R0001']['solder_liquidus_c'].values[0]\nprint(f\"R0001 liquidus: {liquidus}\")\n\n# Get TC1 data for R0001\nr0001 = tc[(tc['run_id'] == 'R0001') & (tc['tc_location'] == 'largest_mass')].sort_values('time_s')\nprint(f\"\\nR0001 TC1 temperature profile:\")\nprint(r0001[['time_s', 'temp_c']].to_string())\n\n# Count points above liquidus\nabove = r0001[r0001['temp_c'] > liquidus]\nprint(f\"\\nPoints above liquidus ({liquidus}): {len(above)}\")\nprint(f\"Time range: {above['time_s'].min()} to {above['time_s'].max()}\")\nprint(f\"Span: {above['time_s'].max() - above['time_s'].min()} seconds\")\nENDSCRIPT\n"]
