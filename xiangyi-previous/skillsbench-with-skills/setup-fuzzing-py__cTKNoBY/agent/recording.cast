[139.181489, "i", "cat > /app/minisgl/fuzz.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Coverage-guided fuzzer for MiniSGL library using atheris.\"\"\"\n\nimport sys\nimport atheris\n\n\ndef TestOneInput(data: bytes) -> None:\n    \"\"\"Fuzz target for MiniSGL message and config handling.\"\"\"\n    try:\n        # Convert bytes to string\n        try:\n            input_str = data.decode('utf-8')\n        except UnicodeDecodeError:\n            input_str = data.decode('latin-1')\n        \n        # Test message handling\n        try:\n            from minisgl.message import ChatMessage, ChatCompletionRequest\n            import json\n            \n            # Try parsing as JSON message\n            try:\n                msg_data = json.loads(input_str)\n                if isinstance(msg_data, dict):\n                    ChatMessage(**msg_data)\n            except (json.JSONDecodeError, TypeError, ValueError, KeyError):\n                pass\n        except ImportError:\n            pass\n        except Exception:\n            pass\n        \n        # Test engine config"]
[139.181636, "o", "cat > /app/minisgl/fuzz.py << 'EOF'\r\n"]
[139.181671, "i", " parsing\n        try:\n            from minisgl.engine.config import EngineConfig\n            import json\n            \n            try:\n                config_data = json.loads(input_str)\n                if isinstance(config_data, dict):\n                    EngineConfig(**config_data)\n            except (json.JSONDecodeError, TypeError, ValueError, KeyError):\n                pass\n        except ImportError:\n            pass\n        except Exception:\n            pass\n        \n        # Test misc utilities\n        try:\n            from minisgl.utils.misc import parse_args\n        except ImportError:\n            pass\n        except Exception:\n            pass\n            \n    except Exception:\n        pass\n\n\ndef main():\n    \"\"\"Main entry point for the fuzzer.\"\"\"\n    atheris.Setup(sys.argv, TestOneInput)\n    atheris.Fuzz()\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
