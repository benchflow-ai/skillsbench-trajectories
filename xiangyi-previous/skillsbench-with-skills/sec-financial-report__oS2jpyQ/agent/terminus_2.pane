[?2004hroot@8235cd2b99ef:~# cat > /tmp/analyze_berkshire.py << 'EOF'
[?2004l[?2004h> import csv
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q3 holdings
[?2004l[?2004h> q3_holdings = defaultdict(lambda: {'value': 0, 'cusip': ''})
[?2004l[?2004h> with open('/tmp/berkshire_q3.tsv', 'r') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split('\t')
[?2004l[?2004h>         cusip = parts[4]
[?2004l[?2004h>         value = int(parts[6])
[?2004l[?2004h>         q3_holdings[cusip]['value'] += value
[?2004l[?2004h>         q3_holdings[cusip]['cusip'] = cusip
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q2 holdings
[?2004l[?2004h> q2_holdings = defaultdict(lambda: {'value': 0, 'cusip': ''})
[?2004l[?2004h> with open('/tmp/berkshire_q2.tsv', 'r') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split('\t')
[?2004l[?2004h>         cusip = parts[4]
[?2004l[?2004h>         value = int(parts[6])
[?2004l[?2004h>         q2_holdings[cusip]['value'] += value
[?2004l[?2004h>         q2_holdings[cusip]['cusip'] = cusip
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate increases
[?2004l[?2004h> increases = []
[?2004l[?2004h> for cusip in q3_holdings:
[?2004l[?2004h>     q3_val = q3_holdings[cusip]['value']
[?2004l[?2004h>     q2_val = q2_holdings[cusip]['value'] if cusip in q2_holdings else 0
[?2004l[?2004h>     increase = q3_val - q2_val
[?2004l[?2004h>     if increase > 0:
[?2004l[?2004h>         increases.append((cusip, increase, q2_val, q3_val))
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by increase and get top 5
[?2004l[?2004h> increases.sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h> top5 = increases[:5]
[?2004l[?2004h> 
[?2004l[?2004h> print("Top 5 stocks with increased investment:")
[?2004l[?2004h> for cusip, increase, q2_val, q3_val in top5:
[?2004l[?2004h>     print(f"CUSIP: {cusip}, Increase: ${increase:,}, Q2: ${q2_val:,}, Q3: ${q3_val:,}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nCUSIPs only:")
[?2004l[?2004h> for cusip, _, _, _ in top5:
[?2004l[?2004h>     print(cusip)
