[54.101268, "i", "cat > /tmp/analyze_berkshire.py << 'EOF'\nimport csv\nfrom collections import defaultdict\n\n# Read Q3 holdings\nq3_holdings = defaultdict(lambda: {'value': 0, 'cusip': ''})\nwith open('/tmp/berkshire_q3.tsv', 'r') as f:\n    for line in f:\n        parts = line.strip().split('\\t')\n        cusip = parts[4]\n        value = int(parts[6])\n        q3_holdings[cusip]['value'] += value\n        q3_holdings[cusip]['cusip'] = cusip\n\n# Read Q2 holdings\nq2_holdings = defaultdict(lambda: {'value': 0, 'cusip': ''})\nwith open('/tmp/berkshire_q2.tsv', 'r') as f:\n    for line in f:\n        parts = line.strip().split('\\t')\n        cusip = parts[4]\n        value = int(parts[6])\n        q2_holdings[cusip]['value'] += value\n        q2_holdings[cusip]['cusip'] = cusip\n\n# Calculate increases\nincreases = []\nfor cusip in q3_holdings:\n    q3_val = q3_holdings[cusip]['value']\n    q2_val = q2_holdings[cusip]['value'] if cusip in q2_holdings else 0\n    increase = q3_val - q2_val\n    if increase > 0:\n        increases.append((cusip, increase, q2_val, q3_val))\n\n# Sort by increase and get top 5\nincreases.sort(key=lambda x: x[1], reverse=True)\ntop5 = increases[:5]\n\nprint(\"Top 5 stocks with increased investment:\")\nfor cusip, increase, q2_val, q3_val in top5:\n    print(f\"CUSIP: {cusip}, Increase: ${increase:,}, Q2: ${q2_val:,}, Q3: ${q3_val:,}\")\n\nprint(\"\\nCUSIPs only:\")\nfor cusip, _, _, _ in top5:\n    print(cusip)\nEOF\n"]
[54.101494, "o", "cat > /tmp/analyze_berkshire.py << 'EOF'\r\n\u001b[?2004l\r"]
