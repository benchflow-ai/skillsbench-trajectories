[10.11704, "o", "Task Sheet Sample Names (Row 10):\r\n['NCIH1568_LUNG_TenPx15', 'IPC298_SKIN_TenPx08', 'WM2664_SKIN_TenPx02', 'SNU1_STOMACH_TenPx20', 'TE6_OESOPHAGUS_TenPx17', 'FUOV1_OVARY_TenPx16', 'LS513_LARGE_INTESTINE_TenPx09', 'THP1_HAEMATOPOIETIC_AND_LYMPHOID_TISSUE_TenPx24', 'SW48_LARGE_INTESTINE_TenPx07', 'NCIN87_STOMACH_TenPx26']\r\n\r\nTask Sheet Protein IDs (Rows 11-20):\r\n['sp|Q9HCY8|S10AE_HUMAN', 'sp|Q96EN8|MOCOS_HUMAN', 'sp|Q86UT8|CCD84_HUMAN', 'sp|O96000|NDUBA_HUMAN', 'sp|Q86Y38|XYLT1_HUMAN', 'sp|Q5SZL2|CE85L_HUMAN', 'sp|Q9BQA1|MEP50_HUMAN', 'sp|Q9C0F1|CEP44_HUMAN', 'sp|Q9UH03|SEPT3_HUMAN', 'sp|P04632|CPNS1_HUMAN']\r\n\r\nTask Sheet Grouping (Row 9):\r\n"]
[10.117094, "o", "['Control', 'Control', 'Control', 'Control', 'Control', 'Treated', 'Treated', 'Treated', 'Treated', 'Treated']\r\n\r\nData Sheet First Row (Sample Names):\r\n['Gene_Symbol', 'Description', 'NCIH1568_LUNG_TenPx15', 'IPC298_SKIN_TenPx08', 'WM2664_SKIN_TenPx02', 'SNU1_STOMACH_TenPx20', 'TE6_OESOPHAGUS_TenPx17', 'FUOV1_OVARY_TenPx16', 'LS513_LARGE_INTESTINE_TenPx09', 'THP1_HAEMATOPOIETIC_AND_LYMPHOID_TISSUE_TenPx24'] ...\r\n\r\nData Sheet First Column (Protein IDs):\r\n['sp|Q9HCY8|S10AE_HUMAN', 'sp|Q96EN8|MOCOS_HUMAN', 'sp|Q86UT8|CCD84_HUMAN', 'sp|O96000|NDUBA_HUMAN', 'sp|Q86Y38|XYLT1_HUMAN', 'sp|Q5SZL2|CE85L_HUMAN', 'sp|Q9BQA1|MEP50_HUMAN', 'sp|Q9C0F1|CEP44_HUMAN', 'sp|Q9UH03|SEPT3_HUMAN', 'sp|P04632|CPNS1_HUMAN']\r\n"]
[10.139551, "o", "\u001b[?2004hroot@1ac8eb751cff:~# "]
[58.730041, "i", "cat << 'EOF' > update_excel.py\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\ntask = wb['Task']\n\n# 1. Pull expression data into C11:L20\nfor r in range(11, 21): # Rows 11-20 for 10 proteins\n    for c in range(3, 13): # Columns C-L (3-12) for 10 samples\n        protein_id_cell = f\"$A{r}\"\n        sample_name_cell = f\"{get_column_letter(c)}$10\"\n        # INDEX(Data!$A:$AZ, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))\n        formula = f\"=INDEX(Data!$A:$AZ, MATCH({protein_id_cell}, Data!$A:$A, 0), MATCH({sample_name_cell}, Data!$1:$1, 0))\"\n        task.cell(row=r, column=c).value = formula\n\n# 2. Group statistics in rows 24-27, columns B-K (2-11)\n# Row 24: Mean Control\n# Row 25: SD Control\n# Row 26: Mean Treated\n# Row 27: SD Treated\n# Based on Row 9: Control is C-G (3-7), Treated is H-L (8-12)\nfor i in range(10): # 10 proteins\n    protein_row = 11 + i\n    stat_col = 2 + i # B, C, D, ...\n    \n    # Mean Control\n    task.cell(row=24, column=stat_col).value = f\"=AVERAGE(C{protein_row}:G{protein_row})\"\n    # SD Control\n    task.cell(row=25, column=stat_col).value = f\"=STDEV(C{protein_row}:G{protein_row})\"\n    # Mean Treated\n    task.cell(row=26, column=stat_col).value = f\"=AVERAGE(H{protein_row}:L{protein_row})\"\n    # SD Treated\n    task.cell(row=27, column=stat_col).value = f\"=STDEV(H{protein_row}:L{protein_row})\"\n\n# 3. Fold change calculations in columns C and D, rows 32-41\nfor i in range(10):\n    protein_row = 32 + i\n    stat_col_letter = get_column_letter(2 + i) # Stats for protein i are in this column (B, C, ...)\n    \n    # Log2 Fold Change = Treated Mean - Control Mean\n    # Treated Mean is in row 26, Control Mean is in row 24\n    task.cell(row=protein_row, column=3).value = f\"={stat_col_letter}26-{stat_col_letter}24\"\n    # Fold Change = 2^(Log2 Fold Change)\n    task.cell(row=protein_row, column=4).value = f\"=2^C{protein_row}\"\n\nwb.save('protein_expression.xlsx')\nEOF\npython3 update_excel.py\n"]
