[?2004hroot@1ac8eb751cff:~# cat << 'EOF' > update_excel.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('protein_expression.xlsx')
[?2004l[?2004h> task = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Pull expression data into C11:L20
[?2004l[?2004h> for r in range(11, 21): # Rows 11-20 for 10 proteins
[?2004l[?2004h>     for c in range(3, 13): # Columns C-L (3-12) for 10 samples
[?2004l[?2004h>         protein_id_cell = f"$A{r}"
[?2004l[?2004h>         sample_name_cell = f"{get_column_letter(c)}$10"
[?2004l[?2004h>         # INDEX(Data!$A:$AZ, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))
[?2004l[?2004h>         formula = f"=INDEX(Data!$A:$AZ, MATCH({protein_id_cell}, Data!$A:$A, 0), MATCH({sample_name_cell}, Data!$1:$1, 0))"
[?2004l[?2004h>         task.cell(row=r, column=c).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Group statistics in rows 24-27, columns B-K (2-11)
[?2004l[?2004h> # Row 24: Mean Control
[?2004l[?2004h> # Row 25: SD Control
[?2004l[?2004h> # Row 26: Mean Treated
[?2004l[?2004h> # Row 27: SD Treated
[?2004l[?2004h> # Based on Row 9: Control is C-G (3-7), Treated is H-L (8-12)
[?2004l[?2004h> for i in range(10): # 10 proteins
[?2004l[?2004h>     protein_row = 11 + i
[?2004l[?2004h>     stat_col = 2 + i # B, C, D, ...
[?2004l[?2004h>     
[?2004l[?2004h>     # Mean Control
[?2004l[?2004h>     task.cell(row=24, column=stat_col).value = f"=AVERAGE(C{protein_row}:G{protein_row})"
[?2004l[?2004h>     # SD Control
[?2004l[?2004h>     task.cell(row=25, column=stat_col).value = f"=STDEV(C{protein_row}:G{protein_row})"
[?2004l[?2004h>     # Mean Treated
[?2004l[?2004h>     task.cell(row=26, column=stat_col).value = f"=AVERAGE(H{protein_row}:L{protein_row})"
[?2004l[?2004h>     # SD Treated
[?2004l[?2004h>     task.cell(row=27, column=stat_col).value = f"=STDEV(H{protein_row}:L{protein_row})"
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Fold change calculations in columns C and D, rows 32-41
[?2004l[?2004h> for i in range(10):
[?2004l[?2004h>     protein_row = 32 + i
[?2004l[?2004h>     stat_col_letter = get_column_letter(2 + i) # Stats for protein i are in this column (B, C, ...)
[?2004l[?2004h>     
[?2004l[?2004h>     # Log2 Fold Change = Treated Mean - Control Mean
[?2004l[?2004h>     # Treated Mean is in row 26, Control Mean is in row 24
[?2004l[?2004h>     task.cell(row=protein_row, column=3).value = f"={stat_col_letter}26-{stat_col_letter}24"
[?2004l[?2004h>     # Fold Change = 2^(Log2 Fold Change)
[?2004l[?2004h>     task.cell(row=protein_row, column=4).value = f"=2^C{protein_row}"
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('protein_expression.xlsx')
[?2004l[?2004h> EOF
