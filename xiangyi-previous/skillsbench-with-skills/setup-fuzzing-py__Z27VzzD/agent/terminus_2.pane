root@d03782396e7b:/app# ipython/.venv/bin/python ipython/fuzz.py -max_total_time=10 > ipython/fuzz.log 2>&1
cat <<EOF > minisgl/fuzz.py
import atheris
import sys
import json
with atheris.instrument_imports():
    from minisgl.message.tokenizer import decoder

def TestOneInput(data):
    fdp = atheris.FuzzedDataProvider(data)
    try:
        s = fdp.ConsumeUnicodeNoSurrogates(sys.maxsize)
        d = json.loads(s)
        if isinstance(d, dict):
            decoder(d)
    except Exception:
        pass

atheris.Setup(sys.argv, TestOneInput)
atheris.Fuzz()
EOF
python3 -m venv minisgl/.venv
export PYTHONPATH=$PYTHONPATH:/app/minisgl/python
minisgl/.venv/bin/pip install atheris torch
