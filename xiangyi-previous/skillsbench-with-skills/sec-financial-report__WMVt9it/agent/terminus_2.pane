[?2004hroot@3fac9713adbc:~# python3 << 'EOF'
[?2004l[?2004h> import csv
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # Read Palantir holdings and aggregate by accession number
[?2004l[?2004h> holdings = defaultdict(int)
[?2004l[?2004h> with open('/tmp/palantir_holdings.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         accession = row[0]
[?2004l[?2004h>         value = int(row[6]) if row[6] else 0
[?2004l[?2004h>         holdings[accession] += value
[?2004l[?2004h> 
[?2004l[?2004h> # Read COVERPAGE to get fund manager names
[?2004l[?2004h> fund_names = {}
[?2004l[?2004h> with open('/root/2025-q3/COVERPAGE.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     next(reader)  # Skip header
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         accession = row[0]
[?2004l[?2004h>         fund_name = row[9] if len(row) > 9 else ''
[?2004l[?2004h>         fund_names[accession] = fund_name
[?2004l[?2004h> 
[?2004l[?2004h> # Join and sort
[?2004l[?2004h> results = []
[?2004l[?2004h> for accession, value in holdings.items():
[?2004l[?2004h>     fund_name = fund_names.get(accession, 'Unknown')
[?2004l[?2004h>     results.append((fund_name, value, accession))
[?2004l[?2004h> 
[?2004l[?2004h> results.sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Print top 3
[?2004l[?2004h> print("Top 3 fund managers investing in Palantir:")
[?2004l[?2004h> for i, (name, value, acc) in enumerate(results[:10]):
[?2004l[?2004h>     print(f"{i+1}. {name}: ${value:,} (accession: {acc})")
