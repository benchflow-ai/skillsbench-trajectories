[?2004hroot@3fac9713adbc:~# python3 << 'EOF'
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q2 holdings
[?2004l[?2004h> q2_holdings = {}
[?2004l[?2004h> with open('/tmp/bh_q2.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         cusip = row[4]
[?2004l[?2004h>         value = int(row[6]) if row[6] else 0
[?2004l[?2004h>         if cusip in q2_holdings:
[?2004l[?2004h>             q2_holdings[cusip] += value
[?2004l[?2004h>         else:
[?2004l[?2004h>             q2_holdings[cusip] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q3 holdings
[?2004l[?2004h> q3_holdings = {}
[?2004l[?2004h> with open('/tmp/bh_q3.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         cusip = row[4]
[?2004l[?2004h>         value = int(row[6]) if row[6] else 0
[?2004l[?2004h>         if cusip in q3_holdings:
[?2004l[?2004h>             q3_holdings[cusip] += value
[?2004l[?2004h>         else:
[?2004l[?2004h>             q3_holdings[cusip] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate changes
[?2004l[?2004h> changes = []
[?2004l[?2004h> all_cusips = set(q2_holdings.keys()) | set(q3_holdings.keys())
[?2004l[?2004h> for cusip in all_cusips:
[?2004l[?2004h>     q2_val = q2_holdings.get(cusip, 0)
[?2004l[?2004h>     q3_val = q3_holdings.get(cusip, 0)
[?2004l[?2004h>     change = q3_val - q2_val
[?2004l[?2004h>     if change > 0:
[?2004l[?2004h>         changes.append((cusip, change, q2_val, q3_val))
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by change descending
[?2004l[?2004h> changes.sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Print top 5
[?2004l[?2004h> print("Top 5 stocks with increased investment:")
[?2004l[?2004h> for i, (cusip, change, q2, q3) in enumerate(changes[:5]):
