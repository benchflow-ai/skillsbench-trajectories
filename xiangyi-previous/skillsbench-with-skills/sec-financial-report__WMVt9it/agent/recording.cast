[75.832995, "i", "python3 << 'EOF'\nimport csv\n\n# Read Q2 holdings\nq2_holdings = {}\nwith open('/tmp/bh_q2.tsv', 'r') as f:\n    reader = csv.reader(f, delimiter='\\t')\n    for row in reader:\n        cusip = row[4]\n        value = int(row[6]) if row[6] else 0\n        if cusip in q2_holdings:\n            q2_holdings[cusip] += value\n        else:\n            q2_holdings[cusip] = value\n\n# Read Q3 holdings\nq3_holdings = {}\nwith open('/tmp/bh_q3.tsv', 'r') as f:\n    reader = csv.reader(f, delimiter='\\t')\n    for row in reader:\n        cusip = row[4]\n        value = int(row[6]) if row[6] else 0\n        if cusip in q3_holdings:\n            q3_holdings[cusip] += value\n        else:\n            q3_holdings[cusip] = value\n\n# Calculate changes\nchanges = []\nall_cusips = set(q2_holdings.keys()) | set(q3_holdings.keys())\nfor cusip in all_cusips:\n    q2_val = q2_holdings.get(cusip, 0)\n    q3_val = q3_holdings.get(cusip, 0)\n    change = q3_val - q2_val\n    if change > 0:\n        changes.append((cusip, change, q2_val, q3_val))\n\n# Sort by change descending\nchanges.sort(key=lambda x: x[1], reverse=True)\n\n# Print top 5\nprint(\"Top 5 stocks with increased investment:\")\nfor i, (cusip, change, q2, q3) in enumerate(changes[:5]):\n    print(f\"{i+1}. CUSIP: {cusip}, Change: ${change:,}, Q2: ${q2:,}, Q3: ${q3:,}\")\nEOF\n"]
[75.833427, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[75.833471, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
