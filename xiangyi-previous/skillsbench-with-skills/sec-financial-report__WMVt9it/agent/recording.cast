[75.834614, "o", "> "]
[75.834687, "o", "    for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.834738, "o", "        cusip = row[4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.834774, "o", "> "]
[75.83486, "o", "        value = int(row[6]) if row[6] else 0\r\n\u001b[?2004l\r"]
[75.834897, "o", "\u001b[?2004h> "]
[75.834961, "o", "        if cusip in q3_holdings:\r\n\u001b[?2004l\r"]
[75.834997, "o", "\u001b[?2004h> "]
[75.835059, "o", "            q3_holdings[cusip] += value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835133, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835181, "o", "            q3_holdings[cusip] = value\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.835217, "o", "\u001b[?2004h> "]
[75.835277, "o", "# Calculate changes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835313, "o", "changes = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.835396, "o", "> "]
[75.835435, "o", "all_cusips = set(q2_holdings.keys()) | set(q3_holdings.keys())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835508, "o", "for cusip in all_cusips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835569, "o", "    q2_val = q2_holdings.get(cusip, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835626, "o", "    q3_val = q3_holdings.get(cusip, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835697, "o", "    change = q3_val - q2_val\r\n\u001b[?2004l\r"]
[75.835733, "o", "\u001b[?2004h> "]
[75.835803, "o", "    if change > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835877, "o", "        changes.append((cusip, change, q2_val, q3_val))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.835911, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.836015, "o", "# Sort by change descending\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.836084, "o", "changes.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.836147, "o", "# Print top 5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.836213, "o", "print(\"Top 5 stocks with increased investment:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.836302, "o", "for i, (cusip, change, q2, q3) in enumerate(changes[:5]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.836326, "o", "> "]
[75.836467, "o", "    print(f\"{i+1}. CUSIP: {cusip}, Change: ${change:,}, Q2: ${q2:,}, Q3: ${q3:,}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
