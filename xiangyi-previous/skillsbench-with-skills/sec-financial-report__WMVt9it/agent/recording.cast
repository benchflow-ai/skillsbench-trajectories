[134.950922, "i", "python3 << 'EOF'\nimport csv\n\n# Check the stock names for the top 5 CUSIPs\ncusips = [\"02079K305\", \"037833100\", \"025816109\", \"166764100\", \"674599105\"]\n\nwith open('/root/2025-q3/INFOTABLE.tsv', 'r') as f:\n    reader = csv.reader(f, delimiter='\\t')\n    header = next(reader)\n    for row in reader:\n        if row[4] in cusips:\n            print(f\"CUSIP: {row[4]}, Name: {row[2]}, Title: {row[3]}\")\n            cusips.remove(row[4])\n            if not cusips:\n                break\nEOF\n"]
[134.952712, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check the stock names for the top 5 CUSIPs\r\n\u001b[?2004l\r\u001b[?2004h> cusips = [\"02079K305\", \"037833100\", \"025816109\", \"166764100\", \"674599105\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/2025-q3/INFOTABLE.tsv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(f, delimiter='\\t')\r\n\u001b[?2004l\r\u001b[?2004h>     header = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>     for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         if row[4] in cusips:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"CUSIP: {row[4]}, Name: {row[2]}, Title: {row[3]}\")\r\n\u001b[?2004l\r\u001b[?2004h>             cusips.remove(row[4])\r\n\u001b[?2004l\r\u001b[?2004h>             if not cusips:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
