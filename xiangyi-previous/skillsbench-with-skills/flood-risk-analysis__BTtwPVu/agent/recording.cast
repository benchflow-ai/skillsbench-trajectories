[107.538761, "i", "cat > /root/process_floods.py << 'EOF'\nfrom dataretrieval import nwis\nimport pandas as pd\nimport sys\n\n# Read station IDs\nwith open('/root/data/michigan_stations.txt', 'r') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\nprint(f\"Processing {len(station_ids)} stations...\")\n\nresults = []\n\nfor i, station_id in enumerate(station_ids, 1):\n    print(f\"Processing {i}/{len(station_ids)}: {station_id}\", end=' ... ')\n    \n    try:\n        # Get 2024 historical data for flood threshold\n        df_hist, _ = nwis.get_dv(\n            sites=station_id,\n            start='2024-01-01',\n            end='2024-12-31',\n            parameterCd='00060'\n        )\n        \n        if df_hist.empty or '00060_Mean' not in df_hist.columns:\n            print(\"No historical data\")\n            continue\n            \n        flows_hist = df_hist['00060_Mean'].dropna()\n        \n        if len(flows_hist) < 30:  # Need sufficient data\n            print(\"Insufficient historical data\")\n            continue\n        \n        # Calculate 95th percentile as flood threshold\n        flood_threshold = flows_hist.quantile(0.95)\n        \n        # Get April 1-7, 2025 data\n        df_2025, _ = nwis.get_dv(\n            sites=station_id,\n            start='2025-04-01',\n            end='2025-04-07',\n            parameterCd='00060'\n        )\n        \n        if df_2025.empty or '00060_Mean' not in df_2025.columns:\n            print(\"No April 2025 data\")\n            continue\n        \n        # Count flood days\n        flood_days = (df_2025['00060_Mean'] > flood_threshold).sum()\n        \n        if flood_days > 0:\n            results.append({\n                'station_id': station_id,\n                'flood_days': flood_days\n            })\n            print(f\"FLOOD: {flood_days} days (threshold: {flood_threshold:.2f} cfs)\")\n        else:\n            print(\"No flooding\")\n            \n    except Exception as e:\n        print(f\"Error: {e}\")\n        continue\n\nprint(f\"\\n{'='*60}\")\nprint(f\"Found {len(results)} stations with flooding\")\n\n# Create output DataFrame and save to CSV\nif results:\n    df_output = pd.DataFrame(results)\n    df_output.to_csv('/root/output/flood_results.csv', index=False)\n    print(f\"\\nResults saved to /root/output/flood_results.csv\")\n    print(f\"\\nSummary:\")\n    print(df_output.to_string(index=False))\nelse:\n    print(\"\\nNo stations with flooding found.\")\nEOF\n"]
