[84.835112, "i", "cat > /root/check_flood_stage.py << 'EOF'\nfrom dataretrieval import nwis\nimport pandas as pd\nimport numpy as np\n\nstation_id = '04031000'\n\n# Get historical data to establish baseline\ntry:\n    # Get a year of historical data to calculate percentiles\n    df_hist, _ = nwis.get_dv(\n        sites=station_id,\n        start='2024-01-01',\n        end='2024-12-31',\n        parameterCd='00060'\n    )\n    \n    if not df_hist.empty and '00060_Mean' in df_hist.columns:\n        flows = df_hist['00060_Mean'].dropna()\n        print(f\"Historical flow statistics for {station_id}:\")\n        print(f\"Mean: {flows.mean():.2f} cfs\")\n        print(f\"Median: {flows.median():.2f} cfs\")\n        print(f\"75th percentile: {flows.quantile(0.75):.2f} cfs\")\n        print(f\"90th percentile: {flows.quantile(0.90):.2f} cfs\")\n        print(f\"95th percentile: {flows.quantile(0.95):.2f} cfs\")\n        print(f\"99th percentile: {flows.quantile(0.99):.2f} cfs\")\n        print(f\"Max: {flows.max():.2f} cfs\")\n        \n        # Get April 2025 data\n        df_2025, _ = nwis.get_dv(\n            sites=station_id,\n            start='2025-04-01',\n            end='2025-04-07',\n            parameterCd='00060'\n        )\n        print(f\"\\nApril 2025 flows:\")\n        print(df_2025[['00060_Mean']])\n        \n        # Check against 95th percentile (common flood threshold)\n        threshold_95 = flows.quantile(0.95)\n        print(f\"\\nUsing 95th percentile ({threshold_95:.2f} cfs) as flood threshold:\")\n        flood_days = (df_2025['00060_Mean'] > threshold_95).sum()\n        print(f\"Flood days: {flood_days}\")\n        \nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
