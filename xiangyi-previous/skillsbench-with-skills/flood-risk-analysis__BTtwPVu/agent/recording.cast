[107.543171, "o", "            print(f\"FLOOD: {flood_days} days (threshold: {flood_threshold:.2f} cfs)\")\r\n\u001b[?2004l\r"]
[107.543223, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[107.543268, "o", "\u001b[?2004h> "]
[107.543317, "o", "            print(\"No flooding\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.543343, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.543393, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.543443, "o", "> "]
[107.543468, "o", "        print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[107.543496, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.543542, "o", "> "]
[107.543583, "o", "print(f\"\\n{'='*60}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.543669, "o", "print(f\"Found {len(results)} stations with flooding\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.543699, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.543787, "o", "# Create output DataFrame and save to CSV\r\n\u001b[?2004l\r"]
[107.543843, "o", "\u001b[?2004h> if results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.543904, "o", "> "]
[107.543944, "o", "    df_output = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.544081, "o", "    df_output.to_csv('/root/output/flood_results.csv', index=False)\r\n\u001b[?2004l\r"]
[107.54413, "o", "\u001b[?2004h> "]
[107.544205, "o", "    print(f\"\\nResults saved to /root/output/flood_results.csv\")\r\n\u001b[?2004l\r"]
[107.544255, "o", "\u001b[?2004h> "]
[107.544298, "o", "    print(f\"\\nSummary:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.544347, "o", "> "]
[107.544415, "o", "    print(df_output.to_string(index=False))\r\n\u001b[?2004l\r"]
[107.544462, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.544544, "o", "    print(\"\\nNo stations with flooding found.\")\r\n\u001b[?2004l\r"]
[107.544594, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[107.545855, "o", "\u001b[?2004hroot@90924ac9ce32:~# "]
