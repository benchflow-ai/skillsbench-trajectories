[52.316135, "o", "Data shape: (7, 3)"]
[52.316227, "o", "\r\n"]
[52.316309, "o", "\r\nColumns: ['site_no', '00060_Mean', '00060_Mean_cd']\r\n\r\nFirst few rows:\r\n"]
[52.323872, "o", "                            site_no  00060_Mean 00060_Mean_cd\r\ndatetime                                                     \r\n2025-04-01 00:00:00+00:00  04031000       473.0             P\r\n2025-04-02 00:00:00+00:00  04031000       440.0             P\r\n2025-04-03 00:00:00+00:00  04031000       423.0             P\r\n2025-04-04 00:00:00+00:00  04031000       437.0             P\r\n2025-04-05 00:00:00+00:00  04031000       520.0             P\r\n2025-04-06 00:00:00+00:00  04031000       521.0             P\r\n2025-04-07 00:00:00+00:00  04031000       552.0             P\r\n\r\nMetadata:\r\nNWIS_Metadata(url=https://waterservices.usgs.gov/nwis/dv?format=json&parameterCd=00060&startDT=2025-04-01&endDT=2025-04-07&sites=04031000)\r\n"]
[52.55019, "o", "\r\n\r\nSite info:\r\n"]
[52.5689, "o", "  agency_cd   site_no                     station_nm site_tp_cd  lat_va  long_va  ...  aqfr_cd  aqfr_type_cd well_depth_va hole_depth_va depth_src_cd project_no\r\n0      USGS  04031000  BLACK RIVER NEAR BESSEMER, MI         ST  463041   900428  ...      NaN           NaN           NaN           NaN          NaN  244500100\r\n\r\n[1 rows x 42 columns]\r\n"]
[52.721682, "o", "\u001b[?2004hroot@90924ac9ce32:~# "]
[65.420012, "i", "cat > /root/test_flood_info.py << 'EOF'\nfrom dataretrieval import nwis\nimport pandas as pd\n\nstation_id = '04031000'\n\n# Get site info and check all columns\ninfo, info_meta = nwis.get_info(sites=station_id)\nprint(\"All columns in site info:\")\nfor col in info.columns:\n    print(f\"{col}: {info[col].values[0]}\")\n\nprint(\"\\n\" + \"=\"*50)\n\n# Try to get gage height data which might have flood stage\ntry:\n    df_gh, meta_gh = nwis.get_dv(\n        sites=station_id,\n        start='2025-04-01',\n        end='2025-04-07',\n        parameterCd='00065'  # Gage height\n    )\n    print(\"\\nGage height data available:\")\n    print(df_gh.head(10))\nexcept Exception as e:\n    print(f\"\\nNo gage height data: {e}\")\n\n# Check for stat codes that might indicate flood stage\ntry:\n    stats = nwis.get_stats(sites=station_id, parameterCd='00060')\n    print(\"\\nStatistics data:\")\n    print(stats.head(20))\nexcept Exception as e:\n    print(f\"\\nNo stats data: {e}\")\nEOF\n"]
[65.420399, "o", "cat > /root/test_flood_info.py << 'EOF'"]
