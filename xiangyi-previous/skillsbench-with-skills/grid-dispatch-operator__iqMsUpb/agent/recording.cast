[431.087667, "o", "        tap = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.087697, "o", "    shift = br[9]*math.pi/180.0\r\n\u001b[?2004l\r\u001b[?2004h>     B = base/(x*tap)\r\n\u001b[?2004l\r"]
[431.087766, "o", "\u001b[?2004h> "]
[431.087794, "o", "    F = LpVariable(f\"F_{k}\", lowBound=None, upBound=None)\r\n\u001b[?2004l\r"]
[431.087863, "o", "\u001b[?2004h> "]
[431.087896, "o", "    # flow-angle relationship\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.087971, "o", "    prob += F == B*(theta[f] - theta[t] - shift)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088012, "o", "    rateA = br[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088085, "o", "    if rateA and rateA > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088161, "o", "        prob += F <= rateA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088209, "o", "        prob += F >= -rateA\r\n\u001b[?2004l\r\u001b[?2004h>     flow_vars[k] = F\r\n\u001b[?2004l\r"]
[431.08824, "o", "\u001b[?2004h> "]
[431.088336, "o", "    flows_by_bus[f].append((F,1))\r\n\u001b[?2004l\r\u001b[?2004h>     flows_by_bus[t].append((F,-1))\r\n\u001b[?2004l\r"]
[431.088404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # power balance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088456, "o", "for i,b in enumerate(bus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088542, "o", "    Pd = b[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088708, "o", "    prob += lpSum(Pg[j] for j in gens_by_bus[i]) - Pd == lpSum(sign*F for F,sign in flows_by_bus[i])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088783, "o", "# objective: linear cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088826, "o", "cost_terms = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.088896, "o", "for i,row in enumerate(gencost):\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.088925, "o", "> "]
[431.089014, "o", "    c2 = row[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.089083, "o", "    c1 = row[5]\r\n\u001b[?2004l\r\u001b[?2004h>     c0 = row[6]\r\n\u001b[?2004l\r"]
[431.089128, "o", "\u001b[?2004h>     cost_terms.append(c1*Pg[i] + c0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.089195, "o", "> prob += lpSum(cost_terms)\r\n\u001b[?2004l\r"]
[431.089275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[431.089318, "o", "\u001b[?2004h> # solve\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.089391, "o", "solver = PULP_CBC_CMD(msg=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.089467, "o", "status = prob.solve(solver)\r\n\u001b[?2004l\r"]
[431.089539, "o", "\u001b[?2004h> "]
[431.089602, "o", "print('Status', LpStatus[status])\r\n\u001b[?2004l\r"]
[431.089665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[431.089745, "o", "\u001b[?2004h> "]
[431.089785, "o", "# collect results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.089868, "o", "Pg_val = [value(v) for v in Pg]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.089913, "o", "R_val = [value(v) for v in R]"]
[431.089951, "o", "\r\n"]
[431.089991, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090034, "o", "# totals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090254, "o", "load = sum(b[2] for b in bus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090376, "o", "generation = sum(Pg_val)\r\n\u001b[?2004l\r\u001b[?2004h> reserve = sum(R_val)\r\n\u001b[?2004l\r\u001b[?2004h> # cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090497, "o", "cost = sum(gencost[i][5]*Pg_val[i] + gencost[i][6] for i in range(n_gen))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[431.090607, "o", "\u001b[?2004h> # line loading\r\n\u001b[?2004l\r\u001b[?2004h> loaded = []\r\n\u001b[?2004l\r"]
[431.090681, "o", "\u001b[?2004h> "]
[431.090755, "o", "for k,br in enumerate(branch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090801, "o", "    status = int(br[10])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.090892, "o", "    if status == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.090959, "o", ">     rateA = br[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091025, "o", "    if rateA and rateA > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.091113, "o", "> "]
[431.091189, "o", "        F = value(flow_vars[k])\r\n\u001b[?2004l\r\u001b[?2004h>         loading = abs(F)/rateA*100.0\r\n\u001b[?2004l\r"]
[431.091263, "o", "\u001b[?2004h> "]
[431.09134, "o", "        loaded.append((loading, int(br[0]), int(br[1])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091407, "o", "loaded.sort(reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091509, "o", "most_loaded = [{'from': f, 'to': t, 'loading_pct': round(l,3)} for l,f,t in loaded[:3]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091612, "o", "# operating margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091652, "o", "operating_margin = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> for i,g in enumerate(gen):\r\n\u001b[?2004l\r"]
[431.091687, "o", "\u001b[?2004h> "]
[431.091727, "o", "    if int(g[7]) != 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091858, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091902, "o", "    operating_margin += g[8] - Pg_val[i] - R_val[i]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.091994, "o", "# generator dispatch list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092078, "o", "dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> for i,g in enumerate(gen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092158, "o", "    dispatch.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'id': i+1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092206, "o", "        'bus': int(g[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092288, "o", "        'output_MW': float(Pg_val[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092327, "o", "        'reserve_MW': float(R_val[i]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.092365, "o", "> "]
[431.092411, "o", "        'pmax_MW': float(g[8])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092554, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092596, "o", "    'generator_dispatch': dispatch,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092636, "o", "    'totals': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092713, "o", "        'cost_dollars_per_hour': float(cost),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092779, "o", "        'load_MW': float(load),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092863, "o", "        'generation_MW': float(generation),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.092946, "o", "        'reserve_MW': float(reserve)\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[431.093024, "o", "\u001b[?2004h> "]
[431.093084, "o", "    'most_loaded_lines': most_loaded,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.093181, "o", "    'operating_margin_MW': float(operating_margin)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.093241, "o", "with open('report.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.093313, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[431.093388, "o", "\u001b[?2004h> "]
[431.093449, "o", "print('report.json written')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[432.30574, "o", "Status Optimal\r\n"]
[432.316573, "o", "report.json written\r\n"]
