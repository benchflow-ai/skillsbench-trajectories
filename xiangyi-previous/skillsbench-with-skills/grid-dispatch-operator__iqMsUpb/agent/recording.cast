[20.041101, "o", "column_info keys: dict_keys(['bus', 'gen', 'branch', 'gencost', 'reserve'])\r\nbus columns: {'0': 'BUS_I - bus number (1-indexed)', '1': 'BUS_TYPE - 1=PQ, 2=PV, 3=Slack', '2': 'PD - real power demand (MW)', '3': 'QD - reactive power demand (MVAr)', '4': 'GS - shunt conductance', '5': 'BS - shunt susceptance', '6': 'BUS_AREA - area number', '7': 'VM - voltage magnitude (pu)', '8': 'VA - voltage angle (degrees)', '9': 'BASE_KV - base voltage (kV)', '10': 'ZONE - loss zone', '11': 'VMAX - max voltage (pu)', '12': 'VMIN - min voltage (pu)'}\r\ngen columns: {'0': 'GEN_BUS - bus number (1-indexed)', '1': 'PG - real power output (MW)', '2': 'QG - reactive power output (MVAr)', '3': 'QMAX - max reactive power (MVAr)', '4': 'QMIN - min reactive power (MVAr)', '5': 'VG - voltage setpoint (pu)', '6': 'MBASE - machine base (MVA)', '7': 'GEN_STATUS - 1=in-service, 0=out-of-service', '8': 'PMAX - max real power output (MW)', '9': 'PMIN - min real power output (MW)'}\r\nbranch columns: {'0': 'F_BUS - from bus (1-indexed)', '1': 'T_BUS - to bus (1-indexed)', '2': 'BR_R - resistance (pu)', '3': 'BR_X - reactance (pu)', '4': 'BR_B - total line charging susceptance (pu)', '5': 'RATE_A - MVA rating A (long term)', '6': 'RATE_B - MVA rating B (short term)', '7': 'RATE_C - MVA rating C (emergency)', '8': 'TAP - transformer tap ratio', '9': 'SHIFT - transformer phase shift (degrees)', '10': 'BR_STATUS - 1=in-service, 0=out-of-service', '11': 'ANGMIN - min angle difference (degrees)', '12': 'ANGMAX - max angle difference (degrees)'}\r\ngencost columns: {'0': 'MODEL - 1=piecewise linear, 2=polynomial', '1': 'STARTUP - startup cost ($)', '2': 'SHUTDOWN - shutdown cost ($)', '3': 'NCOST - number of cost coefficients', '4+': 'COST - cost coefficients (highest order first)'}\r\nreserve_capacity columns: None\r\n"]
