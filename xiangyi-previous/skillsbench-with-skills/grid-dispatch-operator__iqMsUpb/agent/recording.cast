[152.478726, "i", "python3 - <<'PY'\nimport json, math\nwith open('network.json') as f:\n    data=json.load(f)\nbase=data['baseMVA']\nbus=data['bus']\ngen=data['gen']\ngencost=data['gencost']\nreserve_cap=data['reserve_capacity']\nRreq=data['reserve_requirement']\n# totals\nload=sum(b[2] for b in bus)  # PD\n# generator totals for in-service\nPg=0\nPmax=0\nPmin=0\ninservice=[]\nfor i,g in enumerate(gen):\n    if int(g[7])==1:\n        Pg+=g[1]\n        Pmax+=g[8]\n        Pmin+=g[9]\n        inservice.append(i)\nprint('load', load, 'Pg', Pg, 'difference', Pg-load)\nprint('in-service gens', len(inservice))\n# check cost coefficients\nnonzero_c2=0\nfor row in gencost:\n    if row[4]!=0:\n        nonzero_c2+=1\nprint('nonzero c2', nonzero_c2)\nprint('reserve req', Rreq)\n# reserve capacity availability\navail=0\nfor i,g in enumerate(gen):\n    if int(g[7])!=1: continue\n    headroom=g[8]-g[1]\n    cap=reserve_cap[i]\n    avail+=min(headroom, cap)\nprint('reserve available', avail)\n# sample VA stats\nangles=[b[8] for b in bus]\nprint('VA min', min(angles), 'max', max(angles))\nPY\n"]
