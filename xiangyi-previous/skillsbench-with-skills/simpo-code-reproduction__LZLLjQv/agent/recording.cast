[443.455809, "i", "python3 - <<'PY'\nimport PyPDF2, re\npdf_path='/root/SimPO/paper.pdf'\nreader=PyPDF2.PdfReader(open(pdf_path,'rb'))\nfor i,page in enumerate(reader.pages):\n    t=page.extract_text() or ''\n    if 'SimPO' in t or 'loss' in t or 'objective' in t:\n        if any(k in t for k in ['SimPO','loss','objective','reward']):\n            print('---page',i,'---')\n            lines=t.split('\\n')\n            for line in lines:\n                if any(k in line for k in ['SimPO','loss','objective','reward','margin','beta','β','Eq','Equation']):\n                    print(line)\nPY\n"]
