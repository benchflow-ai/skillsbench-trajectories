[336.111494, "i", "python - <<'PY'\nimport PyPDF2, re\npdf_path='/root/SimPO/paper.pdf'\nreader=PyPDF2.PdfReader(open(pdf_path,'rb'))\ntext=''\nfor i,page in enumerate(reader.pages):\n    t=page.extract_text() or ''\n    if 'SimPO' in t or 'SimPO' in t or 'loss' in t:\n        print('---page',i,'---')\n        for line in t.split('\\n'):\n            if 'SimPO' in line or 'loss' in line or 'objective' in line or 'reward' in line:\n                print(line)\nPY\n"]
