[595.281382, "i", "python3 - <<'PY'\nimport PyPDF2\nreader=PyPDF2.PdfReader(open('/root/SimPO/paper.pdf','rb'))\n# search lines with logσ, gamma, SimPO objective\nfor i,page in enumerate(reader.pages):\n    text=page.extract_text() or ''\n    lines=text.split('\\n')\n    if any('SimPO' in l or 'logσ' in l or 'sigma' in l or 'γ' in l or 'gamma' in l or 'objective' in l for l in lines):\n        for idx,l in enumerate(lines):\n            if any(k in l for k in ['logσ','σ','SimPO objective','SimPO Objective','γ','gamma','Objective','objective']):\n                print(f'page {i} line {idx}: {l}')\nPY\n"]
