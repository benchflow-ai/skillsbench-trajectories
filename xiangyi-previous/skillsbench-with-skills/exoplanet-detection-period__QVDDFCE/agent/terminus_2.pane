[?2004hroot@4205bb953fae:~# python3 << 'EOFPYTHON'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import lombscargle
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Load the data
[?2004l[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')
[?2004l[?2004h> time = data[:, 0]
[?2004l[?2004h> flux = data[:, 1]
[?2004l[?2004h> quality = data[:, 2]
[?2004l[?2004h> uncertainty = data[:, 3]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total points: {len(time)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Filter by quality flag
[?2004l[?2004h> mask_quality = quality == 0
[?2004l[?2004h> time_f = time[mask_quality]
[?2004l[?2004h> flux_f = flux[mask_quality]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"After quality filter: {len(time_f)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Remove outliers (3-sigma)
[?2004l[?2004h> mean_flux = np.mean(flux_f)
[?2004l[?2004h> std_flux = np.std(flux_f)
[?2004l[?2004h> mask_outliers = np.abs(flux_f - mean_flux) < 3 * std_flux
[?2004l[?2004h> time_clean = time_f[mask_outliers]
[?2004l[?2004h> flux_clean = flux_f[mask_outliers]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"After outlier removal: {len(time_clean)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Detrend with polynomial
[?2004l[?2004h> coeffs = np.polyfit(time_clean, flux_clean, 5)
[?2004l[?2004h> poly = np.poly1d(coeffs)
[?2004l[?2004h> trend = poly(time_clean)
[?2004l[?2004h> flux_detrended = flux_clean - trend + np.mean(flux_clean)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Detrended flux std: {np.std(flux_detrended):.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Compute Lomb-Scargle periodogram
[?2004l[?2004h> min_period = 0.5
[?2004l[?2004h> max_period = 30.0
[?2004l[?2004h> freq_max = 1.0 / min_period
[?2004l[?2004h> freq_min = 1.0 / max_period
[?2004l[?2004h> freqs = np.linspace(freq_min, freq_max, 10000)
[?2004l[?2004h> angular_freqs = 2.0 * np.pi * freqs
[?2004l[?2004h> pgram = lombscargle(time_clean, flux_detrended - np.mean(flux_detrended), angular_freqs, normalize=True)
[?2004l[?2004h> 
[?2004l[?2004h> periods = 1.0 / freqs
[?2004l[?2004h> peak_idx = np.argmax(pgram)
[?2004l[?2004h> peak_period = periods[peak_idx]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Peak period: {peak_period:.5f} days")
[?2004l[?2004h> print(f"Peak power: {pgram[peak_idx]:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Top 5 peaks
[?2004l[?2004h> top_indices = np.argsort(pgram)[-5:][::-1]
[?2004l[?2004h> print("\nTop 5 periods:")
[?2004l[?2004h> for i, idx in enumerate(top_indices):
[?2004l[?2004h>     print(f"  {i+1}. {periods[idx]:.5f} days (power: {pgram[idx]:.6f})")
[?2004l[?2004h> 
