[30.347475, "o", "\u001b[?2004hroot@4205bb953fae:~# "]
[42.425148, "i", "python3 << 'EOFPYTHON'\nimport numpy as np\nfrom scipy.signal import lombscargle\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load the data\ndata = np.loadtxt('/root/data/tess_lc.txt')\ntime = data[:, 0]\nflux = data[:, 1]\nquality = data[:, 2]\nuncertainty = data[:, 3]\n\nprint(f\"Total points: {len(time)}\")\n\n# Filter by quality flag\nmask_quality = quality == 0\ntime_f = time[mask_quality]\nflux_f = flux[mask_quality]\n\nprint(f\"After quality filter: {len(time_f)}\")\n\n# Remove outliers (3-sigma)\nmean_flux = np.mean(flux_f)\nstd_flux = np.std(flux_f)\nmask_outliers = np.abs(flux_f - mean_flux) < 3 * std_flux\ntime_clean = time_f[mask_outliers]\nflux_clean = flux_f[mask_outliers]\n\nprint(f\"After outlier removal: {len(time_clean)}\")\n\n# Detrend with polynomial\ncoeffs = np.polyfit(time_clean, flux_clean, 5)\npoly = np.poly1d(coeffs)\ntrend = poly(time_clean)\nflux_detrended = flux_clean - trend + np.mean(flux_clean)\n\nprint(f\"Detrended flux std: {np.std(flux_detrended):.6f}\")\n\n# Compute Lomb-Scargle periodogram\nmin_period = 0.5\n"]
[42.425203, "i", "max_period = 30.0\nfreq_max = 1.0 / min_period\nfreq_min = 1.0 / max_period\nfreqs = np.linspace(freq_min, freq_max, 10000)\nangular_freqs = 2.0 * np.pi * freqs\npgram = lombscargle(time_clean, flux_detrended - np.mean(flux_detrended), angular_freqs, normalize=True)\n\nperiods = 1.0 / freqs\npeak_idx = np.argmax(pgram)\npeak_period = periods[peak_idx]\n\nprint(f\"Peak period: {peak_period:.5f} days\")\nprint(f\"Peak power: {pgram[peak_idx]:.6f}\")\n\n# Top 5 peaks\ntop_indices = np.argsort(pgram)[-5:][::-1]\nprint(\"\\nTop 5 periods:\")\nfor i, idx in enumerate(top_indices):\n    print(f\"  {i+1}. {periods[idx]:.5f} days (power: {pgram[idx]:.6f})\")\n\n# Write result\nperiod_rounded = round(peak_period, 5)\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{period_rounded:.5f}\\n\")\n\nprint(f\"\\nResult written: {period_rounded:.5f}\")\nEOFPYTHON\n"]
