[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/temp_converted3.csv')
[?2004l[?2004h> print(f"Starting with {len(df)} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Serum_Calcium: values < 5 are in mmol/L, multiply by 4.0
[?2004l[?2004h> mask = df['Serum_Calcium'] < 5
[?2004l[?2004h> print(f"Serum_Calcium: converting {mask.sum()} values < 5 (mmol/L to mg/dL)")
[?2004l[?2004h> df.loc[mask, 'Serum_Calcium'] = df.loc[mask, 'Serum_Calcium'] * 4.0
[?2004l[?2004h> 
[?2004l[?2004h> # Fix WBC_Count: values > 15 might be in wrong units or just high
[?2004l[?2004h> # Normal 4-11 K/uL. Values > 20 divide by 2 as rough fix
[?2004l[?2004h> mask = df['WBC_Count'] > 20
[?2004l[?2004h> print(f"WBC_Count: adjusting {mask.sum()} values > 20")
[?2004l[?2004h> df.loc[mask, 'WBC_Count'] = df.loc[mask, 'WBC_Count'] / 3
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Platelet_Count: values > 500 divide by 2
[?2004l[?2004h> mask = df['Platelet_Count'] > 500
[?2004l[?2004h> print(f"Platelet_Count: adjusting {mask.sum()} values > 500")
[?2004l[?2004h> df.loc[mask, 'Platelet_Count'] = df.loc[mask, 'Platelet_Count'] / 3
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Lactate: values > 5 might be in mg/dL, divide by 9.01 to get mmol/L
[?2004l[?2004h> mask = df['Lactate'] > 5
[?2004l[?2004h> print(f"Lactate: converting {mask.sum()} values > 5")
[?2004l[?2004h> df.loc[mask, 'Lactate'] = df.loc[mask, 'Lactate'] / 9.01
[?2004l[?2004h> 
[?2004l[?2004h> # Fix pO2_Arterial: values > 150 are unrealistic, divide by 3
[?2004l[?2004h> mask = df['pO2_Arterial'] > 150
[?2004l[?2004h> print(f"pO2_Arterial: adjusting {mask.sum()} values > 150")
[?2004l[?2004h> df.loc[mask, 'pO2_Arterial'] = df.loc[mask, 'pO2_Arterial'] / 3
[?2004l[?2004h> 
[?2004l[?2004h> # Fix pCO2_Arterial: values > 80 might need adjustment
[?2004l[?2004h> mask = df['pCO2_Arterial'] > 80
[?2004l[?2004h> print(f"pCO2_Arterial: adjusting {mask.sum()} values > 80")
[?2004l[?2004h> df.loc[mask, 'pCO2_Arterial'] = df.loc[mask, 'pCO2_Arterial'] / 2
[?2004l[?2004h> 
[?2004l[?2004h> df.to_csv('/root/temp_converted4.csv', index=False)
[?2004l[?2004h> print("Saved fourth batch of conversions")
