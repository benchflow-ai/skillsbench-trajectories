[?2004hroot@b6205c93e183:~# cat > /root/convert_units.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/temp_cleaned.csv')
[?2004l[?2004h> print(f"Starting with {len(df)} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Unit conversion rules: (threshold, factor, direction)
[?2004l[?2004h> # direction: 'above' means convert if value > threshold, 'below' means convert if value < threshold
[?2004l[?2004h> conversions = {
[?2004l[?2004h>     # Kidney - Creatinine: µmol/L to mg/dL (divide by 88.4) if > 20
[?2004l[?2004h>     'Serum_Creatinine': [('above', 20, 1/88.4)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Hemoglobin: g/L to g/dL (divide by 10) if > 25
[?2004l[?2004h>     'Hemoglobin': [('above', 25, 0.1)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Glucose: mmol/L to mg/dL (multiply by 18.02) if < 30
[?2004l[?2004h>     'Glucose': [('below', 30, 18.02)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Cholesterol: mmol/L to mg/dL (multiply by 38.67) if < 15
[?2004l[?2004h>     'Total_Cholesterol': [('below', 15, 38.67)],
[?2004l[?2004h>     'LDL_Cholesterol': [('below', 10, 38.67)],
[?2004l[?2004h>     'HDL_Cholesterol': [('below', 5, 38.67)],
[?2004l[?2004h>     'Non_HDL_Cholesterol': [('below', 12, 38.67)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Triglycerides: mmol/L to mg/dL (multiply by 88.57) if < 15
[?2004l[?2004h>     'Triglycerides': [('below', 15, 88.57)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Calcium: mmol/L to mg/dL (multiply by 4.0) if < 5
[?2004l[?2004h>     'Serum_Calcium': [('below', 5, 4.0)],
[?2004l[?2004h>     
[?2004l[?2004h>     # Albumin: g/L to g/dL (divide by 10) if > 10
