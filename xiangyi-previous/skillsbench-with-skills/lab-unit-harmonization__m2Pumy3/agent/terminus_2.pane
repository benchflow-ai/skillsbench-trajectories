[?2004hroot@b6205c93e183:~# cat > /root/harmonize_lab_data.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Read the CSV file
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)
[?2004l[?2004h> print(f"Original data shape: {df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Function to clean and convert values
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val) or val == '' or str(val).strip() == '':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     val = str(val).strip().strip('"').strip("'")
[?2004l[?2004h>     val = val.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(val)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Apply cleaning to all columns except patient_id
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> df['patient_id'] = pd.to_numeric(df['patient_id'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with any missing values
[?2004l[?2004h> print(f"Rows with NaN before: {df.isna().any(axis=1).sum()}")
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> print(f"After removing missing: {df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save intermediate result
[?2004l[?2004h> df.to_csv('/root/temp_cleaned.csv', index=False)
[?2004l[?2004h> print("Saved intermediate cleaned data")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@b6205c93e183:~# python3 /root/harmonize_lab_data.py
[?2004lOriginal data shape: (2590, 63)
Rows with NaN before: 42
After removing missing: (2548, 63)
Saved intermediate cleaned data
