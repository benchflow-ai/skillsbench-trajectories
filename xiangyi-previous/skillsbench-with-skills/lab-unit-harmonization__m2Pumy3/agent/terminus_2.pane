[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/temp_converted4.csv')
[?2004l[?2004h> print(f"Starting with {len(df)} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Troponin_I: values > 100 are likely in ng/L, divide by 1000 to get ng/mL
[?2004l[?2004h> mask = df['Troponin_I'] > 100
[?2004l[?2004h> print(f"Troponin_I: converting {mask.sum()} values > 100 (ng/L to ng/mL)")
[?2004l[?2004h> df.loc[mask, 'Troponin_I'] = df.loc[mask, 'Troponin_I'] / 1000
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Troponin_T: values > 100 are likely in ng/L, divide by 1000 to get ng/mL  
[?2004l[?2004h> mask = df['Troponin_T'] > 100
[?2004l[?2004h> print(f"Troponin_T: converting {mask.sum()} values > 100 (ng/L to ng/mL)")
[?2004l[?2004h> df.loc[mask, 'Troponin_T'] = df.loc[mask, 'Troponin_T'] / 1000
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Urine_Creatinine: values > 500 might be in umol/L, divide by 88.4
[?2004l[?2004h> mask = df['Urine_Creatinine'] > 500
[?2004l[?2004h> print(f"Urine_Creatinine: converting {mask.sum()} values > 500")
[?2004l[?2004h> df.loc[mask, 'Urine_Creatinine'] = df.loc[mask, 'Urine_Creatinine'] / 88.4
[?2004l[?2004h> 
[?2004l[?2004h> # Fix Urine_Protein: values > 5000 might need adjustment
[?2004l[?2004h> mask = df['Urine_Protein'] > 5000
[?2004l[?2004h> print(f"Urine_Protein: converting {mask.sum()} values > 5000")
[?2004l[?2004h> df.loc[mask, 'Urine_Protein'] = df.loc[mask, 'Urine_Protein'] / 10
[?2004l[?2004h> 
[?2004l[?2004h> df.to_csv('/root/temp_converted5.csv', index=False)
