[?2004hroot@b6205c93e183:~# cat > /root/finalize.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/temp_converted5.csv')
[?2004l[?2004h> print(f"Final data shape: {df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Round all numeric columns to 2 decimal places
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col == 'patient_id':
[?2004l[?2004h>         df[col] = df[col].astype(int)
[?2004l[?2004h>     else:
[?2004l[?2004h>         df[col] = df[col].round(2)
[?2004l[?2004h> 
[?2004l[?2004h> # Format to ensure X.XX format (2 decimal places)
[?2004l[?2004h> def format_value(val, col):
[?2004l[?2004h>     if col == 'patient_id':
[?2004l[?2004h>         return str(int(val))
[?2004l[?2004h>     else:
[?2004l[?2004h>         return f"{val:.2f}"
[?2004l[?2004h> 
[?2004l[?2004h> # Save with proper formatting
[?2004l[?2004h> with open('/root/ckd_lab_data_harmonized.csv', 'w') as f:
[?2004l[?2004h>     # Write header
[?2004l[?2004h>     f.write(','.join(df.columns) + '\n')
[?2004l[?2004h>     # Write data rows
[?2004l[?2004h>     for idx, row in df.iterrows():
[?2004l[?2004h>         formatted_row = []
[?2004l[?2004h>         for col in df.columns:
[?2004l[?2004h>             formatted_row.append(format_value(row[col], col))
[?2004l[?2004h>         f.write(','.join(formatted_row) + '\n')
[?2004l[?2004h> 
[?2004l[?2004h> print("Saved harmonized data to /root/ckd_lab_data_harmonized.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # Verify the output
[?2004l[?2004h> df_check = pd.read_csv('/root/ckd_lab_data_harmonized.csv')
[?2004l[?2004h> print(f"Verified output shape: {df_check.shape}")
[?2004l[?2004h> print(f"Columns: {len(df_check.columns)}")
