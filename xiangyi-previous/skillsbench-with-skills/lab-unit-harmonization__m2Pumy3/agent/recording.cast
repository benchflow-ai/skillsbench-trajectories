[92.119783, "i", "cat > /root/harmonize_lab_data.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read the CSV file\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\nprint(f\"Original data shape: {df.shape}\")\n\n# Function to clean and convert values\ndef clean_value(val):\n    if pd.isna(val) or val == '' or str(val).strip() == '':\n        return np.nan\n    val = str(val).strip().strip('\"').strip(\"'\")\n    val = val.replace(',', '.')\n    try:\n        return float(val)\n    except:\n        return np.nan\n\n# Apply cleaning to all columns except patient_id\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\n\ndf['patient_id'] = pd.to_numeric(df['patient_id'], errors='coerce')\n\n# Remove rows with any missing values\nprint(f\"Rows with NaN before: {df.isna().any(axis=1).sum()}\")\ndf = df.dropna()\nprint(f\"After removing missing: {df.shape}\")\n\n# Save intermediate result\ndf.to_csv('/root/temp_cleaned.csv', index=False)\nprint(\"Saved intermediate cleaned data\")\nEOF\n"]
