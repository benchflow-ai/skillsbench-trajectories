[268.434283, "o", "# Normal 4-11 K/uL. Values > 20 divide by 2 as rough fix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.434338, "o", "mask = df['WBC_Count'] > 20\r\n\u001b[?2004l\r"]
[268.43435, "o", "\u001b[?2004h> "]
[268.434422, "o", "print(f\"WBC_Count: adjusting {mask.sum()} values > 20\")\r\n\u001b[?2004l\r"]
[268.43446, "o", "\u001b[?2004h> "]
[268.434572, "o", "df.loc[mask, 'WBC_Count'] = df.loc[mask, 'WBC_Count'] / 3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.434622, "o", "# Fix Platelet_Count: values > 500 divide by 2\r\n\u001b[?2004l\r"]
[268.434657, "o", "\u001b[?2004h> "]
[268.434709, "o", "mask = df['Platelet_Count'] > 500\r\n\u001b[?2004l\r"]
[268.434722, "o", "\u001b[?2004h> "]
[268.434825, "o", "print(f\"Platelet_Count: adjusting {mask.sum()} values > 500\")\r\n\u001b[?2004l\r"]
[268.434859, "o", "\u001b[?2004h"]
[268.434882, "o", "> "]
[268.434981, "o", "df.loc[mask, 'Platelet_Count'] = df.loc[mask, 'Platelet_Count'] / 3\r\n\u001b[?2004l\r"]
[268.435024, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.435173, "o", "# Fix Lactate: values > 5 might be in mg/dL, divide by 9.01 to get mmol/L\r\n\u001b[?2004l\r"]
[268.435187, "o", "\u001b[?2004h> "]
[268.435243, "o", "mask = df['Lactate'] > 5\r\n\u001b[?2004l\r"]
[268.435263, "o", "\u001b[?2004h"]
[268.435269, "o", "> "]
[268.435362, "o", "print(f\"Lactate: converting {mask.sum()} values > 5\")\r\n\u001b[?2004l\r"]
[268.435407, "o", "\u001b[?2004h> "]
[268.435467, "o", "df.loc[mask, 'Lactate'] = df.loc[mask, 'Lactate'] / 9.01\r\n\u001b[?2004l\r"]
[268.435509, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.435603, "o", "# Fix pO2_Arterial: values > 150 are unrealistic, divide by 3\r\n\u001b[?2004l\r"]
[268.435662, "o", "\u001b[?2004h> "]
[268.43571, "o", "mask = df['pO2_Arterial'] > 150\r\n\u001b[?2004l\r"]
[268.435731, "o", "\u001b[?2004h> "]
[268.435832, "o", "print(f\"pO2_Arterial: adjusting {mask.sum()} values > 150\")\r\n\u001b[?2004l\r"]
[268.435873, "o", "\u001b[?2004h> "]
[268.436012, "o", "df.loc[mask, 'pO2_Arterial'] = df.loc[mask, 'pO2_Arterial'] / 3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.436029, "o", "\u001b[?2004h> "]
[268.436163, "o", "# Fix pCO2_Arterial: values > 80 might need adjustment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.436219, "o", "mask = df['pCO2_Arterial'] > 80\r\n\u001b[?2004l\r"]
[268.436266, "o", "\u001b[?2004h> "]
[268.436352, "o", "print(f\"pCO2_Arterial: adjusting {mask.sum()} values > 80\")\r\n\u001b[?2004l\r"]
[268.436382, "o", "\u001b[?2004h> "]
[268.436461, "o", "df.loc[mask, 'pCO2_Arterial'] = df.loc[mask, 'pCO2_Arterial'] / 2\r\n\u001b[?2004l\r"]
[268.436498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.43653, "o", "\u001b[?2004h> "]
[268.436641, "o", "df.to_csv('/root/temp_converted4.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.436657, "o", "print(\"Saved fourth batch of conversions\")\r\n\u001b[?2004l\r"]
[268.436698, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
