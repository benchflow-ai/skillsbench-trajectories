[303.359933, "o", "mask = df['Urine_Protein'] > 5000\r\n\u001b[?2004l\r"]
[303.359959, "o", "\u001b[?2004h> "]
[303.360061, "o", "print(f\"Urine_Protein: converting {mask.sum()} values > 5000\")\r\n\u001b[?2004l\r"]
[303.360089, "o", "\u001b[?2004h> "]
[303.360199, "o", "df.loc[mask, 'Urine_Protein'] = df.loc[mask, 'Urine_Protein'] / 10\r\n\u001b[?2004l\r"]
[303.360224, "o", "\u001b[?2004h> \r\n"]
[303.360247, "o", "\u001b[?2004l\r"]
[303.360266, "o", "\u001b[?2004h"]
[303.360275, "o", "> "]
