[139.931889, "o", "\u001b[?2004h> import soundfile as sf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.932109, "o", "from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.932208, "o", "def srt_time_to_seconds(time_str):"]
[139.932298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.932357, "o", "> "]
[139.932587, "o", "    \"\"\"Convert SRT timestamp to seconds\"\"\""]
[139.932647, "o", "\r\n"]
[139.932699, "o", "\u001b[?2004l\r"]
[139.932766, "o", "\u001b[?2004h"]
[139.932825, "o", "> "]
[139.933026, "o", "    parts = time_str.split(':')"]
[139.933084, "o", "\r\n"]
[139.933138, "o", "\u001b[?2004l\r"]
[139.933218, "o", "\u001b[?2004h"]
[139.933288, "o", "> "]
[139.933449, "o", "    hours = int(parts[0])"]
[139.93351, "o", "\r\n"]
[139.93357, "o", "\u001b[?2004l\r"]
[139.933646, "o", "\u001b[?2004h"]
[139.933712, "o", "> "]
[139.933883, "o", "    minutes = int(parts[1])"]
[139.933944, "o", "\r\n"]
[139.934007, "o", "\u001b[?2004l\r"]
[139.934082, "o", "\u001b[?2004h"]
[139.934151, "o", "> "]
[139.934374, "o", "    seconds_parts = parts[2].split(',')"]
[139.93444, "o", "\r\n"]
[139.934507, "o", "\u001b[?2004l\r"]
[139.934725, "o", "\u001b[?2004h"]
[139.934845, "o", "> "]
[139.935051, "o", "    seconds = int(seconds_parts[0])"]
[139.93511, "o", "\r\n"]
[139.935164, "o", "\u001b[?2004l\r"]
[139.93523, "o", "\u001b[?2004h"]
[139.935284, "o", "> "]
[139.935508, "o", "    milliseconds = int(seconds_parts[1])"]
[139.935566, "o", "\r\n"]
[139.935623, "o", "\u001b[?2004l\r"]
[139.935692, "o", "\u001b[?2004h"]
[139.935753, "o", "> "]
[139.93608, "o", "    return hours * 3600 + minutes * 60 + seconds + milliseconds / 1000"]
[139.936136, "o", "\r\n"]
[139.936192, "o", "\u001b[?2004l\r"]
[139.936265, "o", "\u001b[?2004h"]
