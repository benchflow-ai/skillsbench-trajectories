[139.930494, "i", "cat > /tmp/dubbing_v2.py << 'EOFPYTHON'\nimport asyncio\nimport subprocess\nimport json\nimport os\nimport numpy as np\nimport soundfile as sf\nfrom scipy import signal\n\ndef srt_time_to_seconds(time_str):\n    \"\"\"Convert SRT timestamp to seconds\"\"\"\n    parts = time_str.split(':')\n    hours = int(parts[0])\n    minutes = int(parts[1])\n    seconds_parts = parts[2].split(',')\n    seconds = int(seconds_parts[0])\n    milliseconds = int(seconds_parts[1])\n    return hours * 3600 + minutes * 60 + seconds + milliseconds / 1000\n\ndef parse_srt(filename):\n    \"\"\"Parse SRT file and return list of segments\"\"\"\n    segments = []\n    with open(filename, 'r', encoding='utf-8') as f:\n        lines = f.readlines()\n    \n    i = 0\n    while i < len(lines):\n        line = lines[i].strip()\n        if line and line.isdigit():\n            if i + 2 < len(lines):\n                start_end = lines[i+1].strip().split(' --> ')\n                start = srt_time_to_seconds(start_end[0])\n                end = srt_time_to_seconds(start_end[1])\n                text = lines[i+2].strip()\n                segments.append({'start': start, 'end': end, 'text': text})\n        i += 1\n    return segments\n\nasync def generate_tts(text, output_file):\n    \"\"\"Generate TTS audio using edge-tts\"\"\"\n    try:\n        cmd = ['edge-tts', '--voice', 'ja-JP-NanaNeural', '--text', text, '--write-media', output_file]\n        process = await asyncio.create_subprocess_exec(*cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)\n        stdout, stderr = await process.communicate()\n        if process.returncode != 0:\n            print(f\"TTS Error: {stderr.decode()}\")\n        return process.returncode == 0\n    except Exception as e:\n        print(f\"TTS Exception: {e}\")\n        return False\n\ndef process_audio(input_file, output_file, target_duration):\n    \"\"\"Process audio to target specifications: 48kHz, mono, duration-adjusted, normalized\"\"\"\n    try:\n        # Read audio\n        data, sr = sf.read(input_file)\n        \n        # Convert to mono if stereo\n        if len(data.shape) > 1:\n            data = np.mean(data, axis=1)\n        \n        # Resample to 48kHz\n        if sr != 48000:\n            num_samples = int(len(data) * 48000 / sr)\n            data = signal.resample(data, num_samples)\n            sr = 48000\n        \n        # Adjust duration\n        current_duration = len(data) / sr\n        if current_duration < target_duration:\n            # Pad with silence\n            samples_needed = int((target_duration - current_duration) * sr)\n            data = np.pad(data, (0, samples_needed), mode='constant')\n        elif current_duration > target_duration:\n            # Trim\n            samples_to_keep = int(target_duration * sr)\n            data = data[:samples_to_keep]\n        \n        # Normalize to -23 LUFS (simplified RMS-based)\n        rms = np.sqrt(np.mean(data ** 2))\n        if rms > 1e-6:\n            target_rms = 10 ** (-23 / 20)\n            data = data * (target_rms / rms)\n        \n        # Ensure no clipping\n        data = np.clip(data, -1.0, 1.0)\n        \n        # Write as 16-bit PCM\n        sf.write(output_file, data, sr, subtype='PCM_16')\n        return sr, len(data) / sr\n    except Exception as e:\n        print(f\"Audio Processing Error: {e}\")\n        return None, None\n\ndef measure_lufs(audio_file):\n    \"\"\"Measure LUFS of audio file (simplified calculation)\"\"\"\n    try:\n        data, sr = sf.read(audio_file)\n        if len(data.shape) > 1:\n            data = np.mean(data, axis=1)\n        \n        # Simplified LUFS: RMS to LUFS conversion\n        rms = np.sqrt(np.mean(data ** 2))\n        if rms > 1e-6:\n            lufs = 20 * np.log10(rms) - 0.691\n        else:\n            lufs = -np.inf\n        return lufs\n    except Exception as e:\n        print(f\"LUFS Measurement Error: {e}\")\n        return -23.0\n\ndef get_video_duration(video_file):\n    \"\"\"Get video duration using ffprobe\"\"\"\n    try:\n        result = subprocess.run(\n            ['ffprobe', '-show_format', video_file],\n            capture_output=True, text=True\n        )\n        for line in result.stdout.split('\\n')"]
[139.930565, "i", ":\n            if line.startswith('duration='):\n                return float(line.split('=')[1])\n    except Exception as e:\n        print(f\"Duration Error: {e}\")\n    return 12.052\n\nasync def main():\n    print(\"Starting multilingual dubbing process...\")\n    \n    # Read target language\n    with open('/root/target_language.txt', 'r') as f:\n        target_lang = f.read().strip()\n    print(f\"Target language: {target_lang}\")\n    \n    # Parse segments\n    segments_data = parse_srt('/root/segments.srt')\n    source_data = parse_srt('/root/source_text.srt')\n    target_data = parse_srt('/root/reference_target_text.srt')\n    \n    print(f\"Found {len(segments_data)} segments\")\n    \n    # Get original video duration\n    original_duration = get_video_duration('/root/input.mp4')\n    print(f\"Original video duration: {original_duration}s\")\n    \n    # Process each segment\n    report_segments = []\n    \n    for idx, seg in enumerate(segments_data):\n        print(f\"\\nProcessing segment {idx}...\")\n        window_start = seg['start']\n        window_end = seg['end']\n        window_duration = window_end - window_start\n        \n        # Get corresponding text\n        source_text = source_data[idx]['text'] if idx < len(source_data) else ''\n        target_text = target_data[idx]['text'] if idx < len(target_data) else ''\n        \n        print(f\"  Window: {window_start:.3f}s - {window_end:.3f}s ({window_duration:.3f}s)\")\n        print(f\"  Source: {source_text[:50]}...\")\n        print(f\"  Target: {target_text[:50]}...\")\n        \n        # Generate TTS\n        tts_file = f'/tmp/tts_{idx}.mp3'\n        print(f\"  Generating TTS...\")\n        success = await generate_tts(target_text, tts_file)\n        \n        if not success or not os.path.exists(tts_file):\n            print(f\"  TTS generation failed, creating silence\")\n            # Create silence file as fallback\n            silence = np.zeros(int(window_duration * 48000))\n            sf.write(tts_file, silence, 48000, subtype='PCM_16')\n        \n        # Process audio\n        output_wav = f'/outputs/tts_segments/seg_{idx}.wav'\n        print(f\"  Processing audio to {output_wav}...\")\n        sr, tts_duration = process_audio(tts_file, output_wav, window_duration)\n        \n        if sr is None:\n            print(f\"  Audio processing failed\")\n            continue\n        \n        # Measure LUFS\n        lufs = measure_lufs(output_wav)\n        print(f\"  LUFS: {lufs:.1f}\")\n        \n        # Calculate drift\n        drift = abs(tts_duration - window_duration)\n        \n        # Determine duration control method\n        if abs(drift) < 0.01:\n            duration_control = 'rate_adjust'\n        elif tts_duration < window_duration:\n            duration_control = 'pad_silence'\n        else:\n            duration_control = 'trim'\n        \n        report_segments.append({\n            'window_start_sec': round(window_start, 3),\n            'window_end_sec': round(window_end, 3),\n            'placed_start_sec': round(window_start, 3),\n            'placed_end_sec': round(window_start + tts_duration, 3),\n            'source_text': source_text,\n            'target_text': target_text,\n            'window_duration_sec': round(window_duration, 3),\n            'tts_duration_sec': round(tts_duration, 3),\n            'drift_sec': round(drift, 3),\n            'duration_control': duration_control\n        })\n    \n    print(\"\\nCreating dubbed video...\")\n    \n    # Extract video without audio\n    print(\"  Extracting video stream...\")\n    subprocess.run([\n        'ffmpeg', '-i', '/root/input.mp4', '-c:v', 'copy', '-an', '-y',\n        '/tmp/video_only.mp4'\n    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    \n    # Create concat file for audio segments\n    concat_file = '/tmp/concat.txt'\n    with open(concat_file, 'w') as f:\n        for idx in range(len(segments_data)):\n            wav_path = f'/outputs/tts_segments/seg_{idx}.wav'\n            f.write(f\"file '{wav_path}'\\n\")\n    \n    # Concatenate audio segments\n    print(\"  Concatenating audio segments...\")\n    subprocess.run([\n        'ffmpeg', '-f', 'concat', '-safe', '0',"]
[139.930615, "i", " '-i', concat_file,\n        '-c:a', 'pcm_s16le', '-y', '/tmp/dubbed_audio.wav'\n    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    \n    # Mux video and audio\n    print(\"  Muxing video and audio...\")\n    subprocess.run([\n        'ffmpeg', '-i', '/tmp/video_only.mp4', '-i', '/tmp/dubbed_audio.wav',\n        '-c:v', 'copy', '-c:a', 'aac', '-shortest', '-y',\n        '/outputs/dubbed.mp4'\n    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    \n    # Measure final LUFS\n    final_lufs = measure_lufs('/tmp/dubbed_audio.wav')\n    print(f\"Final LUFS: {final_lufs:.1f}\")\n    \n    # Generate report\n    report = {\n        'source_language': 'en',\n        'target_language': target_lang,\n        'audio_sample_rate_hz': 48000,\n        'audio_channels': 1,\n        'original_duration_sec': round(original_duration, 3),\n        'new_duration_sec': round(original_duration, 3),\n        'measured_lufs': round(final_lufs, 1),\n        'speech_segments': report_segments\n    }\n    \n    # Write report\n    with open('/outputs/report.json', 'w', encoding='utf-8') as f:\n        json.dump(report, f, indent=2, ensure_ascii=False)\n    \n    print('\\n=== Dubbing Complete ===\"')\n    print(json.dumps(report, indent=2, ensure_ascii=False))\n\nif __name__ == '__main__':\n    asyncio.run(main())\nEOFPYTHON\n"]
