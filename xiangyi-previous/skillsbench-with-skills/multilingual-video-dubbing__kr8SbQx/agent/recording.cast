[139.944087, "o", "> "]
[139.944249, "o", "async def generate_tts(text, output_file):"]
[139.944306, "o", "\r\n"]
[139.944378, "o", "\u001b[?2004l\r"]
[139.944454, "o", "\u001b[?2004h"]
[139.944539, "o", "> "]
[139.944731, "o", "    \"\"\"Generate TTS audio using edge-tts\"\"\""]
[139.944785, "o", "\r\n"]
[139.944838, "o", "\u001b[?2004l\r"]
[139.944906, "o", "\u001b[?2004h"]
[139.945035, "o", "> "]
[139.94518, "o", "    try:\r\n"]
[139.945313, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[139.945669, "o", "        cmd = ['edge-tts', '--voice', 'ja-JP-NanaNeural', '--text', text, '--write-media', output_file]"]
[139.945749, "o", "\r\n"]
[139.945824, "o", "\u001b[?2004l\r"]
[139.945913, "o", "\u001b[?2004h"]
[139.94598, "o", "> "]
[139.946522, "o", "        process = await asyncio.create_subprocess_exec(*cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)"]
[139.946595, "o", "\r\n"]
[139.946649, "o", "\u001b[?2004l\r"]
[139.946727, "o", "\u001b[?2004h"]
[139.946788, "o", "> "]
[139.947055, "o", "        stdout, stderr = await process.communicate()"]
[139.947109, "o", "\r\n"]
[139.947164, "o", "\u001b[?2004l\r"]
[139.947235, "o", "\u001b[?2004h"]
[139.947298, "o", "> "]
[139.947498, "o", "        if process.returncode != 0:"]
[139.947576, "o", "\r\n"]
[139.94765, "o", "\u001b[?2004l\r"]
[139.94774, "o", "\u001b[?2004h"]
[139.947813, "o", "> "]
[139.94808, "o", "            print(f\"TTS Error: {stderr.decode()}\")"]
[139.948146, "o", "\r\n"]
[139.948211, "o", "\u001b[?2004l\r"]
[139.948298, "o", "\u001b[?2004h"]
[139.948373, "o", "> "]
[139.948622, "o", "        return process.returncode == 0"]
[139.948694, "o", "\r\n"]
[139.948763, "o", "\u001b[?2004l\r"]
[139.948845, "o", "\u001b[?2004h"]
[139.948918, "o", "> "]
[139.949142, "o", "    except Exception as e:"]
[139.949221, "o", "\r\n"]
[139.949298, "o", "\u001b[?2004l\r"]
[139.949392, "o", "\u001b[?2004h"]
[139.949472, "o", "> "]
[139.949699, "o", "        print(f\"TTS Exception: {e}\")"]
[139.949766, "o", "\r\n"]
[139.949839, "o", "\u001b[?2004l\r"]
[139.949927, "o", "\u001b[?2004h"]
[139.950005, "o", "> "]
[139.950165, "o", "        return False"]
[139.950263, "o", "\r\n"]
[139.950339, "o", "\u001b[?2004l\r"]
[139.950427, "o", "\u001b[?2004h"]
[139.950504, "o", "> "]
[139.950579, "o", "\r\n"]
[139.950646, "o", "\u001b[?2004l\r"]
[139.950727, "o", "\u001b[?2004h"]
[139.950802, "o", "> "]
[139.951103, "o", "def process_audio(input_file, output_file, target_duration):"]
[139.951178, "o", "\r\n"]
[139.951251, "o", "\u001b[?2004l\r"]
[139.951339, "o", "\u001b[?2004h"]
[139.951412, "o", "> "]
[139.951847, "o", "    \"\"\"Process audio to target specifications: 48kHz, mono, duration-adjusted, normalized\"\"\""]
[139.951923, "o", "\r\n"]
[139.951992, "o", "\u001b[?2004l\r"]
[139.952077, "o", "\u001b[?2004h"]
[139.952149, "o", "> "]
[139.952253, "o", "    try:"]
[139.952327, "o", "\r\n"]
[139.952396, "o", "\u001b[?2004l\r"]
[139.952482, "o", "\u001b[?2004h"]
[139.95285, "o", "> "]
[139.953369, "o", "        # Read audio"]
[139.953584, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953725, "o", "        data, sr = sf.read(input_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953875, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.954017, "o", "        # Convert to mono if stereo\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.954111, "o", "> "]
[139.954213, "o", "        if len(data.shape) > 1:\r\n\u001b[?2004l\r"]
[139.954258, "o", "\u001b[?2004h> "]
[139.954428, "o", "            data = np.mean(data, axis=1)\r\n\u001b[?2004l\r"]
[139.954486, "o", "\u001b[?2004h> "]
[139.954534, "o", "        \r\n\u001b[?2004l\ra\u001b[?2004h"]
[139.954614, "o", "> "]
[139.954702, "o", "        # Resample to 48kHz\r\n\u001b[?2004l\r"]
[139.954838, "o", "\u001b[?2004h> "]
[139.954948, "o", "        if sr != 48000:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.95514, "o", "            num_samples = int(len(data) * 48000 / sr)\r\n\u001b[?2004l\r"]
[139.955194, "o", "\u001b[?2004h> "]
[139.955467, "o", "            data = signal.resample(data, num_samples)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.955616, "o", "            sr = 48000\r\n\u001b[?2004l\r"]
[139.955675, "o", "\u001b[?2004h> "]
[139.955753, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.955806, "o", "> "]
[139.955898, "o", "        # Adjust duration\r\n\u001b[?2004l\r"]
[139.955941, "o", "\u001b[?2004h> "]
[139.956139, "o", "        current_duration = len(data) / sr\r\n\u001b[?2004l\r"]
[139.956209, "o", "\u001b[?2004h"]
[139.956264, "o", "> "]
[139.95667, "o", "        if current_duration < target_duration:\r\n\u001b[?2004l\r\u001b[?2004h>             # Pad with silence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.956945, "o", "            samples_needed = int((target_duration - current_duration) * sr)\r\n\u001b[?2004l\r"]
[139.957096, "o", "\u001b[?2004h> "]
[139.957338, "o", "            data = np.pad(data, (0, samples_needed), mode='constant')\r\n\u001b[?2004l\r"]
[139.957399, "o", "\u001b[?2004h> "]
[139.957475, "o", "        elif current_duration > target_duration:\r\n\u001b[?2004l\r"]
[139.957554, "o", "\u001b[?2004h> "]
[139.957621, "o", "            # Trim\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957767, "o", "            samples_to_keep = int(target_duration * sr)\r\n\u001b[?2004l\r"]
[139.957844, "o", "\u001b[?2004h> "]
[139.957955, "o", "            data = data[:samples_to_keep]\r\n\u001b[?2004l\r"]
[139.958004, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958201, "o", "        # Normalize to -23 LUFS (simplified RMS-based)\r\n\u001b[?2004l\r"]
[139.958256, "o", "\u001b[?2004h> "]
[139.958353, "o", "        rms = np.sqrt(np.mean(data ** 2))\r\n\u001b[?2004l\r"]
[139.958459, "o", "\u001b[?2004h> "]
[139.958503, "o", "        if rms > 1e-6:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958665, "o", "            target_rms = 10 ** (-23 / 20)\r\n\u001b[?2004l\r"]
[139.958747, "o", "\u001b[?2004h> "]
[139.958868, "o", "            data = data * (target_rms / rms)\r\n\u001b[?2004l\r"]
[139.958954, "o", "\u001b[?2004h> "]
[139.959003, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.959113, "o", "        # Ensure no clipping\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.959178, "o", "> "]
[139.959296, "o", "        data = np.clip(data, -1.0, 1.0)\r\n\u001b[?2004l\r"]
[139.959372, "o", "\u001b[?2004h> "]
[139.959418, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.959531, "o", "        # Write as 16-bit PCM\r\n\u001b[?2004l\r"]
[139.959591, "o", "\u001b[?2004h> "]
[139.95979, "o", "        sf.write(output_file, data, sr, subtype='PCM_16')\r\n\u001b[?2004l\r"]
[139.959872, "o", "\u001b[?2004h> "]
[139.959962, "o", "        return sr, len(data) / sr\r\n\u001b[?2004l\r"]
[139.960008, "o", "\u001b[?2004h> "]
[139.960105, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[139.960161, "o", "\u001b[?2004h> "]
[139.96032, "o", "        print(f\"Audio Processing Error: {e}\")\r\n\u001b[?2004l\r"]
[139.96037, "o", "\u001b[?2004h> "]
[139.96047, "o", "        return None, None\r\n\u001b[?2004l\r"]
[139.960537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[139.960582, "o", "> "]
[139.960689, "o", "def measure_lufs(audio_file):\r\n\u001b[?2004l\r"]
[139.960768, "o", "\u001b[?2004h> "]
[139.960931, "o", "    \"\"\"Measure LUFS of audio file (simplified calculation)\"\"\"\r\n\u001b[?2004l\r"]
[139.961013, "o", "\u001b[?2004h> "]
[139.961075, "o", "    try:\r\n\u001b[?2004l\r"]
[139.961219, "o", "\u001b[?2004h> "]
[139.961277, "o", "        data, sr = sf.read(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.961409, "o", "        if len(data.shape) > 1:\r\n\u001b[?2004l\r"]
[139.961568, "o", "\u001b[?2004h> "]
[139.961627, "o", "            data = np.mean(data, axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.961686, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.961883, "o", "        # Simplified LUFS: RMS to LUFS conversion\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.962049, "o", "        rms = np.sqrt(np.mean(data ** 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.96213, "o", "> "]
[139.962209, "o", "        if rms > 1e-6:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.962384, "o", "            lufs = 20 * np.log10(rms) - 0.691\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.962489, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.962551, "o", "> "]
[139.962634, "o", "            lufs = -np.inf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.962732, "o", "        return lufs\r\n\u001b[?2004l\r"]
[139.962793, "o", "\u001b[?2004h> "]
[139.962886, "o", "    except Exception as e:\r\n\u001b[?2004l\r  \u001b[?2004h"]
[139.962962, "o", "> "]
[139.96309, "o", "        print(f\"LUFS Measurement Error: {e}\")\r\n\u001b[?2004l\r"]
[139.963211, "o", "\u001b[?2004h>         return -23.0\r\n\u001b[?2004l\r"]
[139.963275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.963455, "o", "def get_video_duration(video_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.963638, "o", "    \"\"\"Get video duration using ffprobe\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.96378, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.963877, "o", "        result = subprocess.run(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.964061, "o", "            ['ffprobe', '-show_format', video_file],\r\n\u001b[?2004l\r"]
[139.964225, "o", "\u001b[?2004h> "]
[139.964278, "o", "            capture_output=True, text=True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.964329, "o", "        )\r\n\u001b[?2004l\r"]
[139.964375, "o", "\u001b[?2004h> "]
[139.964574, "o", "        for line in result.stdout.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.964739, "o", "            if line.startswith('duration='):\r\n\u001b[?2004l\r"]
[139.964791, "o", "\u001b[?2004h> "]
[139.964949, "o", "                return float(line.split('=')[1])\r\n\u001b[?2004l\r"]
[139.965029, "o", "\u001b[?2004h> "]
[139.965146, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[139.965213, "o", "\u001b[?2004h> "]
[139.965347, "o", "        print(f\"Duration Error: {e}\")\r\n\u001b[?2004l\r"]
[139.96544, "o", "\u001b[?2004h> "]
[139.965514, "o", "    return 12.052\r\n\u001b[?2004l\r"]
[139.965591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[139.965682, "o", "\u001b[?2004h> async def main():"]
[139.965742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.966047, "o", "    print(\"Starting multilingual dubbing process...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.966106, "o", "    # Read target language\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.966337, "o", "    with open('/root/target_language.txt', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.96641, "o", "> "]
[139.966543, "o", "        target_lang = f.read().strip()\r\n\u001b[?2004l\r"]
[139.966615, "o", "\u001b[?2004h> "]
[139.966746, "o", "    print(f\"Target language: {target_lang}\")\r\n\u001b[?2004l\r"]
[139.966807, "o", "\u001b[?2004h>     "]
[139.966859, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.966984, "o", "    # Parse segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.967195, "o", "    segments_data = parse_srt('/root/segments.srt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.9674, "o", "    source_data = parse_srt('/root/source_text.srt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.967651, "o", "    target_data = parse_srt('/root/reference_target_text.srt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.96773, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.967887, "o", "    print(f\"Found {len(segments_data)} segments\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.967991, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.968097, "o", "    # Get original video duration\r\n\u001b[?2004l\r"]
[139.968179, "o", "\u001b[?2004h> "]
[139.968355, "o", "    original_duration = get_video_duration('/root/input.mp4')\r\n\u001b[?2004l\r"]
[139.9684, "o", "\u001b[?2004h> "]
[139.96861, "o", "    print(f\"Original video duration: {original_duration}s\")\r\n\u001b[?2004l\r"]
[139.968691, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.968792, "o", "    # Process each segment\r\n\u001b[?2004l\r"]
[139.968855, "o", "\u001b[?2004h> "]
[139.968933, "o", "    report_segments = []\r\n\u001b[?2004l\r"]
[139.969051, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[139.969183, "o", "\u001b[?2004h> "]
[139.969246, "o", "    for idx, seg in enumerate(segments_data):\r\n\u001b[?2004l\r"]
[139.969297, "o", "\u001b[?2004h> "]
[139.969446, "o", "        print(f\"\\nProcessing segment {idx}...\")\r\n\u001b[?2004l\r"]
[139.96951, "o", "\u001b[?2004h> "]
[139.969627, "o", "        window_start = seg['start']\r\n\u001b[?2004l\r"]
[139.969708, "o", "\u001b[?2004h> "]
[139.969789, "o", "        window_end = seg['end']\r\n\u001b[?2004l\r"]
[139.96987, "o", "\u001b[?2004h> "]
[139.970016, "o", "        window_duration = window_end - window_start\r\n\u001b[?2004l\r"]
[139.970062, "o", "\u001b[?2004h> "]
[139.970136, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.970265, "o", "        # Get corresponding text\r\n\u001b[?2004l\r"]
[139.970325, "o", "\u001b[?2004h> "]
[139.97058, "o", "        source_text = source_data[idx]['text'] if idx < len(source_data) else ''\r\n\u001b[?2004l\r"]
[139.970646, "o", "\u001b[?2004h> "]
[139.970892, "o", "        target_text = target_data[idx]['text'] if idx < len(target_data) else ''\r\n\u001b[?2004l\r"]
[139.970941, "o", "\u001b[?2004h> "]
[139.970987, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.971156, "o", "        print(f\"  Window: {window_start:.3f}s - {window_end:.3f}s ({window_duration:.3f}s)\")\r\n\u001b[?2004l\r"]
[139.971204, "o", "\u001b[?2004h> "]
[139.971296, "o", "        print(f\"  Source: {source_text[:50]}...\")\r\n\u001b[?2004l\r"]
[139.971346, "o", "\u001b[?2004h> "]
[139.971426, "o", "        print(f\"  Target: {target_text[:50]}...\")\r\n\u001b[?2004l\r"]
[139.971482, "o", "\u001b[?2004h> "]
[139.971527, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.971593, "o", "        # Generate TTS\r\n\u001b[?2004l\r"]
[139.971643, "o", "\u001b[?2004h> "]
[139.971729, "o", "        tts_file = f'/tmp/tts_{idx}.mp3'\r\n\u001b[?2004l\r"]
[139.971774, "o", "\u001b[?2004h> "]
[139.971845, "o", "        print(f\"  Generating TTS...\")\r\n\u001b[?2004l\r"]
[139.971894, "o", "\u001b[?2004h> "]
[139.971989, "o", "        success = await generate_tts(target_text, tts_file)\r\n\u001b[?2004l\r"]
[139.972052, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[139.972099, "o", "\u001b[?2004h> "]
[139.972188, "o", "        if not success or not os.path.exists(tts_file):\r\n\u001b[?2004l\r"]
[139.972235, "o", "\u001b[?2004h> "]
[139.972346, "o", "            print(f\"  TTS generation failed, creating silence\")\r\n\u001b[?2004l\r"]
[139.972399, "o", "\u001b[?2004h> "]
[139.972467, "o", "            # Create silence file as fallback\r\n\u001b[?2004l\r"]
[139.972515, "o", "\u001b[?2004h> "]
[139.972624, "o", "            silence = np.zeros(int(window_duration * 48000))\r\n\u001b[?2004l\r"]
[139.972676, "o", "\u001b[?2004h> "]
[139.972783, "o", "            sf.write(tts_file, silence, 48000, subtype='PCM_16')\r\n\u001b[?2004l\r"]
[139.972842, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.972912, "o", "        # Process audio\r\n\u001b[?2004l\r"]
[139.972986, "o", "\u001b[?2004h> "]
[139.973091, "o", "        output_wav = f'/outputs/tts_segments/seg_{idx}.wav'\r\n\u001b[?2004l\r"]
[139.973142, "o", "\u001b[?2004h> "]
[139.973234, "o", "        print(f\"  Processing audio to {output_wav}...\")\r\n\u001b[?2004l\r"]
[139.973281, "o", "\u001b[?2004h> "]
[139.973415, "o", "        sr, tts_duration = process_audio(tts_file, output_wav, window_duration)\r\n\u001b[?2004l\r"]
[139.97346, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[139.973515, "o", "\u001b[?2004h> "]
[139.973593, "o", "        if sr is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.973702, "o", "            print(f\"  Audio processing failed\")\r\n\u001b[?2004l\r"]
[139.973753, "o", "\u001b[?2004h> "]
[139.973819, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.973873, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.973942, "o", "        # Measure LUFS\r\n\u001b[?2004l\r"]
[139.973991, "o", "\u001b[?2004h> "]
[139.974059, "o", "        lufs = measure_lufs(output_wav)\r\n\u001b[?2004l\r"]
[139.974109, "o", "\u001b[?2004h> "]
[139.97417, "o", "        print(f\"  LUFS: {lufs:.1f}\")\r\n\u001b[?2004l\r"]
[139.974218, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[139.974264, "o", "\u001b[?2004h> "]
[139.974331, "o", "        # Calculate drift\r\n\u001b[?2004l\r"]
[139.974378, "o", "\u001b[?2004h> "]
[139.974467, "o", "        drift = abs(tts_duration - window_duration)\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.974516, "o", ">         \r\n\u001b[?2004l\r"]
[139.974561, "o", "\u001b[?2004h> "]
[139.974643, "o", "        # Determine duration control method\r\n\u001b[?2004l\r"]
[139.974695, "o", "\u001b[?2004h> "]
[139.974761, "o", "        if abs(drift) < 0.01:\r\n\u001b[?2004l\r"]
[139.974811, "o", "\u001b[?2004h> "]
[139.974893, "o", "            duration_control = 'rate_adjust'\r\n\u001b[?2004l\r"]
[139.974941, "o", "\u001b[?2004h> "]
[139.975016, "o", "        elif tts_duration < window_duration:\r\n\u001b[?2004l\r"]
[139.975067, "o", "\u001b[?2004h> "]
[139.975141, "o", "            duration_control = 'pad_silence'\r\n\u001b[?2004l\r"]
[139.9752, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[139.975248, "o", "\u001b[?2004h> "]
[139.975324, "o", "            duration_control = 'trim'\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.975382, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.975428, "o", "> "]
[139.975488, "o", "        report_segments.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.975535, "o", "> "]
[139.975626, "o", "            'window_start_sec': round(window_start, 3),\r\n\u001b[?2004l\r"]
[139.975674, "o", "\u001b[?2004h> "]
[139.975764, "o", "            'window_end_sec': round(window_end, 3),\r\n\u001b[?2004l\r"]
[139.975811, "o", "\u001b[?2004h> "]
[139.975911, "o", "            'placed_start_sec': round(window_start, 3),\r\n\u001b[?2004l\r"]
[139.975962, "o", "\u001b[?2004h> "]
[139.976073, "o", "            'placed_end_sec': round(window_start + tts_duration, 3),\r\n\u001b[?2004l\r"]
[139.976123, "o", "\u001b[?2004h> "]
[139.976193, "o", "            'source_text': source_text,\r\n\u001b[?2004l\r"]
[139.976241, "o", "\u001b[?2004h> "]
[139.97632, "o", "            'target_text': target_text,\r\n\u001b[?2004l\r"]
[139.976369, "o", "\u001b[?2004h> "]
[139.976455, "o", "            'window_duration_sec': round(window_duration, 3),\r\n\u001b[?2004l\r"]
[139.976504, "o", "\u001b[?2004h> "]
[139.976601, "o", "            'tts_duration_sec': round(tts_duration, 3),\r\n\u001b[?2004l\r"]
[139.976648, "o", "\u001b[?2004h> "]
[139.976723, "o", "            'drift_sec': round(drift, 3),\r\n\u001b[?2004l\r"]
[139.97677, "o", "\u001b[?2004h> "]
[139.976854, "o", "            'duration_control': duration_control\r\n\u001b[?2004l\r"]
[139.976917, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[139.976996, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.977058, "o", "> "]
[139.977102, "o", "    print(\"\\nCreating dubbed video...\")\r\n\u001b[?2004l\r"]
[139.97715, "o", "\u001b[?2004h> "]
[139.977195, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.977282, "o", "    # Extract video without audio\r\n\u001b[?2004l\r"]
[139.97734, "o", "\u001b[?2004h> "]
[139.977427, "o", "    print(\"  Extracting video stream...\")\r\n\u001b[?2004l\r"]
[139.977479, "o", "\u001b[?2004h> "]
[139.977536, "o", "    subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.977585, "o", "> "]
[139.977708, "o", "        'ffmpeg', '-i', '/root/input.mp4', '-c:v', 'copy', '-an', '-y',\r\n\u001b[?2004l\r"]
[139.977758, "o", "\u001b[?2004h> "]
[139.977822, "o", "        '/tmp/video_only.mp4'\r\n\u001b[?2004l\r"]
[139.97787, "o", "\u001b[?2004h> "]
[139.977981, "o", "    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r"]
[139.978038, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.978089, "o", "> "]
[139.978164, "o", "    # Create concat file for audio segments\r\n\u001b[?2004l\r"]
[139.978221, "o", "\u001b[?2004h> "]
[139.978296, "o", "    concat_file = '/tmp/concat.txt'\r\n\u001b[?2004l\r"]
[139.978364, "o", "\u001b[?2004h> "]
[139.978432, "o", "    with open(concat_file, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.978538, "o", "        for idx in range(len(segments_data)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.978614, "o", "> "]
[139.978708, "o", "            wav_path = f'/outputs/tts_segments/seg_{idx}.wav'\r\n\u001b[?2004l\r"]
[139.978783, "o", "\u001b[?2004h> "]
[139.978857, "o", "            f.write(f\"file '{wav_path}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.978946, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.979031, "o", "    # Concatenate audio segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.979117, "o", "    print(\"  Concatenating audio segments...\")\r\n\u001b[?2004l\r"]
[139.97918, "o", "\u001b[?2004h>     subprocess.run([\r\n\u001b[?2004l\r"]
[139.979229, "o", "\u001b[?2004h> "]
[139.979344, "o", "        'ffmpeg', '-f', 'concat', '-safe', '0', '-i', concat_file,\r\n\u001b[?2004l\r"]
[139.979394, "o", "\u001b[?2004h> "]
[139.979494, "o", "        '-c:a', 'pcm_s16le', '-y', '/tmp/dubbed_audio.wav'\r\n\u001b[?2004l\r"]
[139.979544, "o", "\u001b[?2004h> "]
[139.979648, "o", "    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r"]
[139.979707, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.979763, "o", "> "]
[139.979813, "o", "    # Mux video and audio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.979902, "o", "    print(\"  Muxing video and audio...\")\r\n\u001b[?2004l\r"]
[139.979954, "o", "\u001b[?2004h> "]
[139.979998, "o", "    subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.980136, "o", "        'ffmpeg', '-i', '/tmp/video_only.mp4', '-i', '/tmp/dubbed_audio.wav',\r\n\u001b[?2004l\r"]
[139.98019, "o", "\u001b[?2004h> "]
[139.980298, "o", "        '-c:v', 'copy', '-c:a', 'aac', '-shortest', '-y',\r\n\u001b[?2004l\r"]
[139.98035, "o", "\u001b[?2004h> "]
[139.980397, "o", "        '/outputs/dubbed.mp4'\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.98044, "o", "> "]
[139.980539, "o", "    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r"]
[139.980599, "o", "\u001b[?2004h> "]
[139.980644, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.980699, "o", "    # Measure final LUFS\r\n\u001b[?2004l\r"]
[139.980752, "o", "\u001b[?2004h> "]
[139.980872, "o", "    final_lufs = measure_lufs('/tmp/dubbed_audio.wav')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.980998, "o", "    print(f\"Final LUFS: {final_lufs:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.981076, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.981148, "o", "    # Generate report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.981222, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.981299, "o", "> "]
[139.981371, "o", "        'source_language': 'en',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.981443, "o", "        'target_language': target_lang,\r\n\u001b[?2004l\r"]
[139.981507, "o", "\u001b[?2004h> "]
[139.981582, "o", "        'audio_sample_rate_hz': 48000,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.981655, "o", "        'audio_channels': 1,\r\n\u001b[?2004l\r"]
[139.981723, "o", "\u001b[?2004h> "]
[139.981803, "o", "        'original_duration_sec': round(original_duration, 3),\r\n\u001b[?2004l\r"]
[139.981852, "o", "\u001b[?2004h> "]
[139.981945, "o", "        'new_duration_sec': round(original_duration, 3),\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.982013, "o", "> "]
[139.982081, "o", "        'measured_lufs': round(final_lufs, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.982182, "o", "        'speech_segments': report_segments\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.982253, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[139.982328, "o", "\u001b[?2004h>     # Write report\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.982395, "o", "> "]
[139.982489, "o", "    with open('/outputs/report.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.982559, "o", "> "]
[139.982632, "o", "        json.dump(report, f, indent=2, ensure_ascii=False)\r\n\u001b[?2004l\r"]
[139.982698, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.982803, "o", "    print('\\n=== Dubbing Complete ===\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.982875, "o", "> "]
[139.982963, "o", "    print(json.dumps(report, indent=2, ensure_ascii=False))\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.983038, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.98311, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.983189, "o", "    asyncio.run(main())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.983324, "o", "EOFPYTHON\r\n\u001b[?2004l\r"]
