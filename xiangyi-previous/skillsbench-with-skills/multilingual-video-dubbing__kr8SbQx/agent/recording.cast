[71.819913, "o", "    seconds = int(seconds_parts[0])"]
[71.819996, "o", "\r\n"]
[71.820108, "o", "\u001b[?2004l\r"]
[71.820231, "o", "\u001b[?2004h> "]
[71.820432, "o", "    milliseconds = int(seconds_parts[1])"]
[71.82051, "o", "\r\n"]
[71.820585, "o", "\u001b[?2004l\r"]
[71.820694, "o", "\u001b[?2004h"]
[71.820806, "o", "> "]
[71.821146, "o", "    return hours * 3600 + minutes * 60 + seconds + milliseconds / 1000"]
[71.821231, "o", "\r\n"]
[71.82132, "o", "\u001b[?2004l\r"]
[71.821414, "o", "\u001b[?2004h"]
[71.821499, "o", "> "]
[71.82158, "o", "\r\n"]
[71.821657, "o", "\u001b[?2004l\r"]
[71.821759, "o", "\u001b[?2004h"]
[71.821864, "o", "> "]
[71.821983, "o", "# Parse SRT file"]
[71.822099, "o", "\r\n"]
[71.823206, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.82333, "o", "def parse_srt(filename):\r\n\u001b[?2004l\r"]
[71.823359, "o", "\u001b[?2004h> "]
[71.823492, "o", "    segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.823785, "o", "    with open(filename, 'r', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[71.823862, "o", "\u001b[?2004h> "]
[71.823998, "o", "        lines = f.readlines()\r\n\u001b[?2004l\r"]
[71.824022, "o", "\u001b[?2004h> "]
[71.824074, "o", "    \r\n\u001b[?2004l\r"]
[71.824185, "o", "\u001b[?2004h>     i = 0\r\n\u001b[?2004l\r"]
[71.824332, "o", "\u001b[?2004h> "]
[71.824428, "o", "    while i < len(lines):"]
[71.82456, "o", "\r\n"]
[71.824643, "o", "\u001b[?2004l\r"]
[71.824734, "o", "\u001b[?2004h"]
[71.824809, "o", "> "]
[71.825137, "o", "        if lines[i].strip().isdigit():"]
[71.825223, "o", "\r\n"]
[71.825302, "o", "\u001b[?2004l\r"]
[71.825396, "o", "\u001b[?2004h"]
[71.825475, "o", "> "]
[71.825841, "o", "            start_end = lines[i+1].strip().split(' --> ')"]
[71.825919, "o", "\r\n"]
[71.825987, "o", "\u001b[?2004l\r"]
[71.826082, "o", "\u001b[?2004h"]
[71.826161, "o", "> "]
[71.826513, "o", "            start = srt_time_to_seconds(start_end[0])"]
[71.826595, "o", "\r\n"]
[71.826668, "o", "\u001b[?2004l\r"]
[71.826756, "o", "\u001b[?2004h"]
[71.826833, "o", "> "]
[71.827169, "o", "            end = srt_time_to_seconds(start_end[1])"]
[71.827256, "o", "\r\n"]
[71.827332, "o", "\u001b[?2004l\r"]
[71.827429, "o", "\u001b[?2004h"]
[71.827508, "o", "> "]
[71.827771, "o", "            text = lines[i+2].strip()"]
[71.827856, "o", "\r\n"]
[71.827928, "o", "\u001b[?2004l\r"]
[71.828019, "o", "\u001b[?2004h"]
[71.828097, "o", "> "]
[71.828545, "o", "            segments.append({'start': start, 'end': end, 'text': text})"]
[71.828628, "o", "\r\n"]
[71.828703, "o", "\u001b[?2004l\r"]
[71.828799, "o", "\u001b[?2004h"]
[71.828878, "o", "> "]
[71.829089, "o", "            i += 4"]
[71.829175, "o", "\r\n"]
[71.829264, "o", "\u001b[?2004l\r"]
[71.829368, "o", "\u001b[?2004h"]
[71.829457, "o", "> "]
[71.829606, "o", "        else:"]
[71.829688, "o", "\r\n"]
[71.829764, "o", "\u001b[?2004l\r"]
[71.829863, "o", "\u001b[?2004h"]
[71.829947, "o", "> "]
[71.830123, "o", "            i += 1"]
[71.830226, "o", "\r\n"]
[71.830314, "o", "\u001b[?2004l\r"]
[71.830413, "o", "\u001b[?2004h"]
[71.830502, "o", "> "]
[71.830683, "o", "    return segments"]
[71.83076, "o", "\r\n"]
[71.830838, "o", "\u001b[?2004l\r"]
[71.830941, "o", "\u001b[?2004h"]
[71.831026, "o", "> "]
[71.831108, "o", "\r\n"]
[71.831181, "o", "\u001b[?2004l\r"]
[71.831287, "o", "\u001b[?2004h"]
[71.831374, "o", "> "]
[71.831609, "o", "# Generate TTS using edge-tts"]
[71.831692, "o", "\r\n"]
[71.831769, "o", "\u001b[?2004l\r"]
[71.83187, "o", "\u001b[?2004h"]
[71.831958, "o", "> "]
[71.832318, "o", "async def generate_tts(text, language, output_file):"]
[71.832404, "o", "\r\n"]
[71.832481, "o", "\u001b[?2004l\r"]
[71.832586, "o", "\u001b[?2004h"]
[71.832672, "o", "> "]
[71.833248, "o", "    cmd = f'edge-tts --voice ja-JP-NanaNeural --text \"{text}\" --write-media {output_file}'"]
[71.833342, "o", "\r\n"]
[71.833422, "o", "\u001b[?2004l\r"]
[71.833521, "o", "\u001b[?2004h"]
[71.833609, "o", "> "]
[71.833979, "o", "    process = await asyncio.create_subprocess_shell(cmd)"]
[71.83407, "o", "\r\n"]
[71.834149, "o", "\u001b[?2004l\r"]
[71.83426, "o", "\u001b[?2004h"]
[71.834348, "o", "> "]
[71.834553, "o", "    await process.wait()"]
[71.834634, "o", "\r\n"]
[71.834712, "o", "\u001b[?2004l\r"]
[71.834808, "o", "\u001b[?2004h"]
[71.834897, "o", "> "]
[71.834977, "o", "\r\n"]
[71.835054, "o", "\u001b[?2004l\r"]
[71.835149, "o", "\u001b[?2004h"]
[71.835235, "o", "> "]
[71.835463, "o", "# Convert audio to target specs"]
[71.835538, "o", "\r\n"]
[71.835607, "o", "\u001b[?2004l\r"]
[71.835702, "o", "\u001b[?2004h"]
[71.835782, "o", "> "]
[71.836164, "o", "def process_audio(input_file, output_file, target_duration):"]
[71.836255, "o", "\r\n"]
[71.836331, "o", "\u001b[?2004l\r"]
[71.83643, "o", "\u001b[?2004h"]
[71.836513, "o", "> "]
[71.836677, "o", "    # Read audio"]
[71.836751, "o", "\r\n"]
[71.836827, "o", "\u001b[?2004l\r"]
[71.836924, "o", "\u001b[?2004h"]
[71.837065, "o", "> "]
[71.837346, "o", "    data, sr = sf.read(input_file)"]
[71.837434, "o", "\r\n"]
[71.837513, "o", "\u001b[?2004l\r"]
[71.837639, "o", "\u001b[?2004h"]
[71.837771, "o", "> "]
[71.837882, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.838003, "o", "> "]
[71.838182, "o", "    # Convert to mono if stereo"]
[71.838301, "o", "\r\n"]
[71.838407, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.838523, "o", "> "]
[71.838665, "o", "    if len(data.shape) > 1:"]
[71.838771, "o", "\r\n"]
[71.838888, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.839003, "o", "> "]
[71.839181, "o", "        data = np.mean(data, axis=1)"]
[71.839295, "o", "\r\n"]
[71.839387, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.839514, "o", "> "]
[71.83962, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.839746, "o", "> "]
[71.839869, "o", "    # Resample to 48kHz"]
[71.839988, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.840102, "o", "> "]
[71.840228, "o", "    if sr != 48000:"]
[71.840376, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.840491, "o", "> "]
[71.840745, "o", "        num_samples = int(len(data) * 48000 / sr)"]
[71.840819, "o", "\r\n"]
[71.84089, "o", "\u001b[?2004l\r"]
[71.841065, "o", "\u001b[?2004h"]
[71.841277, "o", "> "]
[71.841586, "o", "        data = signal.resample(data, num_samples)"]
[71.841696, "o", "\r\n"]
[71.84184, "o", "\u001b[?2004l\r"]
[71.841985, "o", "\u001b[?2004h> "]
[71.842169, "o", "        sr = 48000"]
[71.842324, "o", "\r\n"]
[71.842487, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.84265, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.842819, "o", "    # Adjust duration"]
[71.84296, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.84311, "o", "> "]
[71.843351, "o", "    current_duration = len(data) / sr"]
[71.843441, "o", "\r\n"]
[71.843554, "o", "\u001b[?2004l\r"]
[71.843704, "o", "\u001b[?2004h> "]
[71.843968, "o", "    if current_duration < target_duration:"]
[71.844064, "o", "\r\n"]
[71.844176, "o", "\u001b[?2004l\r"]
[71.844324, "o", "\u001b[?2004h> "]
[71.844521, "o", "        # Pad with silence"]
[71.844646, "o", "\r\n"]
[71.844714, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.844798, "o", "> "]
[71.845201, "o", "        samples_needed = int((target_duration - current_duration) * sr)"]
[71.845272, "o", "\r\n"]
[71.845326, "o", "\u001b[?2004l\r"]
[71.8454, "o", "\u001b[?2004h"]
[71.845453, "o", "> "]
[71.845837, "o", "        data = np.pad(data, (0, samples_needed), mode='constant')"]
[71.845892, "o", "\r\n"]
[71.845942, "o", "\u001b[?2004l\r"]
[71.846016, "o", "\u001b[?2004h"]
[71.846073, "o", "> "]
[71.84636, "o", "    elif current_duration > target_duration:"]
[71.846413, "o", "\r\n"]
[71.846459, "o", "\u001b[?2004l\r"]
[71.846527, "o", "\u001b[?2004h"]
[71.846585, "o", "> "]
[71.846716, "o", "        # Trim"]
[71.846765, "o", "\r\n"]
[71.84681, "o", "\u001b[?2004l\r"]
[71.846877, "o", "\u001b[?2004h"]
[71.846931, "o", "> "]
[71.847252, "o", "        samples_to_keep = int(target_duration * sr)"]
[71.847302, "o", "\r\n"]
[71.847353, "o", "\u001b[?2004l\r"]
[71.847424, "o", "\u001b[?2004h"]
[71.847484, "o", "> "]
[71.847727, "o", "        data = data[:samples_to_keep]"]
[71.847782, "o", "\r\n"]
[71.84783, "o", "\u001b[?2004l\r"]
[71.847895, "o", "\u001b[?2004h"]
[71.847947, "o", "> "]
[71.848024, "o", "    "]
[71.848068, "o", "\r\n"]
[71.848112, "o", "\u001b[?2004l\r"]
[71.848173, "o", "\u001b[?2004h"]
[71.848226, "o", "> "]
[71.848604, "o", "    # Normalize to -23 LUFS (simplified: use RMS normalization)"]
[71.848653, "o", "\r\n"]
[71.8487, "o", "\u001b[?2004l\r"]
[71.848777, "o", "\u001b[?2004h"]
[71.848833, "o", "> "]
[71.849092, "o", "    rms = np.sqrt(np.mean(data ** 2))"]
[71.84914, "o", "\r\n"]
[71.849194, "o", "\u001b[?2004l\r"]
[71.849268, "o", "\u001b[?2004h"]
[71.849322, "o", "> "]
[71.84945, "o", "    if rms > 0:"]
[71.8495, "o", "\r\n"]
[71.849549, "o", "\u001b[?2004l\r"]
[71.849623, "o", "\u001b[?2004h"]
[71.849677, "o", "> "]
[71.850046, "o", "        target_rms = 10 ** (-23 / 20)  # Simplified LUFS to RMS"]
[71.850094, "o", "\r\n"]
[71.85014, "o", "\u001b[?2004l\r"]
[71.850229, "o", "\u001b[?2004h"]
[71.850296, "o", "> "]
[71.850559, "o", "        data = data * (target_rms / rms)"]
[71.850613, "o", "\r\n"]
[71.850671, "o", "\u001b[?2004l\r"]
[71.850749, "o", "\u001b[?2004h"]
[71.850809, "o", "> "]
[71.850886, "o", "    "]
[71.850932, "o", "\r\n"]
[71.851011, "o", "\u001b[?2004l\r"]
[71.851093, "o", "\u001b[?2004h"]
[71.851218, "o", "> "]
[71.851322, "o", "    # Ensure no clipping"]
[71.85142, "o", "\r\n\u001b[?2004l\r"]
[71.851516, "o", "\u001b[?2004h> "]
[71.851702, "o", "    data = np.clip(data, -1.0, 1.0)"]
[71.851747, "o", "\r\n"]
[71.851818, "o", "\u001b[?2004l\r"]
[71.851872, "o", "\u001b[?2004h"]
[71.852993, "o", "> "]
[71.853184, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Write output\r\n\u001b[?2004l\r\u001b[?2004h>     sf.write(output_file, data, sr)\r\n\u001b[?2004l\r\u001b[?2004h>     return sr, len(data) / sr\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Measure LUFS (simplified)\r\n\u001b[?2004l\r\u001b[?2004h> def measure_lufs(audio_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.853321, "o", "    data, sr = sf.read(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.853433, "o", "    if len(data.shape) > 1:\r\n\u001b[?2004l\r"]
[71.853537, "o", "\u001b[?2004h> "]
[71.85395, "o", "        data = np.mean(data, axis=1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Simplified LUFS calculation\r\n\u001b[?2004l\r"]
[71.854006, "o", "\u001b[?2004h> "]
[71.854202, "o", "    rms = np.sqrt(np.mean(data ** 2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.854313, "o", "    if rms > 0:\r\n\u001b[?2004l\r"]
[71.855063, "o", "\u001b[?2004h> "]
[71.855145, "o", "        lufs = 20 * np.log10(rms) - 0.691  # Simplified conversion\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         lufs = -np.inf\r\n\u001b[?2004l\r\u001b[?2004h>     return lufs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.855225, "o", "# Main dubbing process\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.855285, "o", "> "]
[71.855318, "o", "async def main():\r\n\u001b[?2004l\r"]
[71.855397, "o", "\u001b[?2004h> "]
[71.855434, "o", "    # Read target language\r\n\u001b[?2004l\r"]
[71.85553, "o", "\u001b[?2004h> "]
[71.855637, "o", "    with open('/root/target_language.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[71.855697, "o", "\u001b[?2004h> "]
[71.855759, "o", "        target_lang = f.read().strip()\r\n\u001b[?2004l\r"]
[71.855801, "o", "\u001b[?2004h> "]
[71.855833, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.855928, "o", "> "]
[71.855956, "o", "    # Parse segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.85608, "o", "    segments_data = parse_srt('/root/segments.srt')\r\n\u001b[?2004l\r"]
[71.856132, "o", "\u001b[?2004h> "]
[71.856275, "o", "    source_data = parse_srt('/root/source_text.srt')\r\n\u001b[?2004l\r"]
[71.856327, "o", "\u001b[?2004h> "]
[71.856479, "o", "    target_data = parse_srt('/root/reference_target_text.srt')\r\n\u001b[?2004l\r"]
[71.856541, "o", "\u001b[?2004h"]
[71.856563, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.856759, "o", "> "]
[71.856792, "o", "    # Get original video duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.856818, "o", "    result = subprocess.run(\r\n\u001b[?2004l\r"]
[71.856854, "o", "\u001b[?2004h"]
[71.856884, "o", "> "]
[71.857303, "o", "        ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=noprint_wrappers=1:nokey=1:noesc=1', '/root/input.mp4'],\r\n\u001b[?2004l\r"]
[71.857328, "o", "\u001b[?2004h> "]
[71.85745, "o", "        capture_output=True, text=True\r\n\u001b[?2004l\r"]
[71.857476, "o", "\u001b[?2004h"]
[71.857501, "o", "> "]
[71.857532, "o", "    )\r\n\u001b[?2004l\r"]
[71.857568, "o", "\u001b[?2004h"]
[71.857588, "o", "> "]
[71.857732, "o", "    original_duration = float(result.stdout.strip())\r\n\u001b[?2004l\r"]
[71.857758, "o", "\u001b[?2004h"]
[71.857774, "o", "> "]
[71.857798, "o", "    \r\n"]
[71.857822, "o", "\u001b[?2004l\r"]
[71.857843, "o", "\u001b[?2004h> "]
[71.857939, "o", "    # Process each segment\r\n\u001b[?2004l\r"]
[71.857961, "o", "\u001b[?2004h"]
[71.857983, "o", "> "]
[71.858072, "o", "    report_segments = []\r\n\u001b[?2004l\r"]
[71.858093, "o", "\u001b[?2004h"]
[71.858114, "o", "> "]
[71.858142, "o", "    \r\n"]
[71.858163, "o", "\u001b[?2004l\r"]
[71.858189, "o", "\u001b[?2004h> "]
[71.858332, "o", "    for idx, seg in enumerate(segments_data):\r\n\u001b[?2004l\r"]
[71.858366, "o", "\u001b[?2004h"]
[71.858387, "o", "> "]
[71.858484, "o", "        window_start = seg['start']\r\n"]
[71.858505, "o", "\u001b[?2004l\r"]
[71.858528, "o", "\u001b[?2004h"]
[71.85855, "o", "> "]
[71.858642, "o", "        window_end = seg['end']\r\n\u001b[?2004l\r"]
[71.858676, "o", "\u001b[?2004h"]
[71.8587, "o", "> "]
[71.858833, "o", "        window_duration = window_end - window_start\r\n"]
[71.858859, "o", "\u001b[?2004l\r"]
[71.858879, "o", "\u001b[?2004h> "]
[71.858922, "o", "        \r\n"]
[71.858944, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.858965, "o", "> "]
[71.859058, "o", "        # Get corresponding text\r\n\u001b[?2004l\r"]
[71.859092, "o", "\u001b[?2004h"]
[71.859113, "o", "> "]
[71.859324, "o", "        source_text = source_data[idx]['text'] if idx < len(source_data) else ''\r\n\u001b[?2004l\r"]
[71.859354, "o", "\u001b[?2004h"]
[71.859378, "o", "> "]
