[243.875038, "o", "\u001b[?2004h"]
[243.875059, "o", "> "]
[243.875276, "o", "    audio_data = np.clip(audio_data, -1.0, 1.0)\r\n\u001b[?2004l\r"]
[243.875301, "o", "\u001b[?2004h> "]
[243.875398, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.875521, "o", "    # Write as WAV file\r\n\u001b[?2004l\r"]
[243.875541, "o", "\u001b[?2004h"]
[243.875566, "o", "> "]
[243.875791, "o", "    sf.write(output_file, audio_data, 48000)\r\n\u001b[?2004l\r"]
[243.875816, "o", "\u001b[?2004h"]
[243.875836, "o", "> "]
[243.876046, "o", "    return 48000, len(audio_data) / 48000\r\n\u001b[?2004l\r"]
[243.876066, "o", "\u001b[?2004h"]
[243.876153, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.876277, "o", "def measure_lufs(audio_data):\r\n\u001b[?2004l\r"]
[243.876304, "o", "\u001b[?2004h> "]
[243.876532, "o", "    \"\"\"Measure LUFS of audio (simplified)\"\"\"\r\n\u001b[?2004l\r"]
[243.876555, "o", "\u001b[?2004h> "]
[243.876792, "o", "    rms = np.sqrt(np.mean(audio_data ** 2))\r\n\u001b[?2004l\r"]
[243.876863, "o", "\u001b[?2004h> "]
[243.876942, "o", "    if rms > 1e-6:\r\n\u001b[?2004l\r"]
[243.876988, "o", "\u001b[?2004h"]
[243.877016, "o", "> "]
[243.877239, "o", "        lufs = 20 * np.log10(rms) - 0.691\r\n\u001b[?2004l\r"]
[243.877264, "o", "\u001b[?2004h"]
[243.877379, "o", "> "]
[243.877405, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.877526, "o", "        lufs = -np.inf\r\n\u001b[?2004l\r"]
[243.877691, "o", "\u001b[?2004h>     return lufs\r\n\u001b[?2004l\r"]
[243.877715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r-"]
[243.877735, "o", "\u001b[?2004h> "]
[243.877949, "o", "def get_video_duration(video_file):\r\n\u001b[?2004l\r"]
[243.877974, "o", "\u001b[?2004h> "]
[243.878194, "o", "    \"\"\"Get video duration using ffprobe\"\"\"\r\n\u001b[?2004l\r"]
[243.878268, "o", "\u001b[?2004h> "]
[243.878339, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.878513, "o", "        result = subprocess.run(\r\n\u001b[?2004l\r"]
[243.878595, "o", "\u001b[?2004h> "]
[243.878839, "o", "            ['ffprobe', '-show_format', video_file],\r\n\u001b[?2004l\r"]
[243.878912, "o", "\u001b[?2004h> "]
[243.8792, "o", "            capture_output=True, text=True, timeout=5\r\n\u001b[?2004l\r"]
[243.879289, "o", "\u001b[?2004h>         )\r\n"]
[243.879365, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[243.879598, "o", "        for line in result.stdout.split('\\n'):\r\n\u001b[?2004l\r"]
[243.879677, "o", "\u001b[?2004h> "]
[243.879883, "o", "            if line.startswith('duration='):\r\n\u001b[?2004l\r"]
[243.879963, "o", "\u001b[?2004h> "]
[243.880196, "o", "                return float(line.split('=')[1])\r\n\u001b[?2004l\r"]
[243.880277, "o", "\u001b[?2004h> "]
[243.88035, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.880435, "o", "        pass\r\n\u001b[?2004l\r"]
[243.880508, "o", "\u001b[?2004h> "]
[243.880592, "o", "    return 12.052\r\n\u001b[?2004l\r"]
[243.880671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.880758, "o", "def main():\r\n\u001b[?2004l\r"]
[243.881082, "o", "\u001b[?2004h> "]
[243.881207, "o", "    print(\"Starting multilingual dubbing process...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.88132, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.88144, "o", "    # Read target language\r\n\u001b[?2004l\r"]
[243.881558, "o", "\u001b[?2004h> "]
[243.881779, "o", "    with open('/root/target_language.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[243.881862, "o", "\u001b[?2004h> "]
[243.882068, "o", "        target_lang = f.read().strip()\r\n\u001b[?2004l\r"]
[243.882141, "o", "\u001b[?2004h> "]
[243.882347, "o", "    print(f\"Target language: {target_lang}\")\r\n\u001b[?2004l\r"]
[243.88243, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[243.8825, "o", "\u001b[?2004h> "]
[243.882659, "o", "    # Parse segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.882894, "o", "    segments_data = parse_srt('/root/segments.srt')\r\n\u001b[?2004l\r"]
[243.882964, "o", "\u001b[?2004h> "]
[243.883198, "o", "    source_data = parse_srt('/root/source_text.srt')\r\n\u001b[?2004l\r"]
[243.883269, "o", "\u001b[?2004h> "]
[243.883585, "o", "    target_data = parse_srt('/root/reference_target_text.srt')\r\n\u001b[?2004l\r"]
[243.88367, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.88395, "o", "    print(f\"Found {len(segments_data)} segments\")\r\n\u001b[?2004l\r"]
[243.88403, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[243.8841, "o", "\u001b[?2004h> "]
[243.884259, "o", "    # Get original video duration\r\n\u001b[?2004l\r"]
[243.884339, "o", "\u001b[?2004h> "]
[243.884642, "o", "    original_duration = get_video_duration('/root/input.mp4')\r\n\u001b[?2004l\r"]
[243.884725, "o", "\u001b[?2004h> "]
[243.885029, "o", "    print(f\"Original video duration: {original_duration}s\")\r\n\u001b[?2004l\r"]
[243.889229, "o", "\u001b[?2004h> "]
[243.90386, "o", "    \r\n\u001b[?2004l\r"]
[243.904096, "o", "\u001b[?2004h>     # Process each segment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.904194, "o", "    report_segments = []\r\n\u001b[?2004l\r"]
[243.904293, "o", "\u001b[?2004h> "]
[243.904382, "o", "    all_audio_data = []\r\n\u001b[?2004l\r"]
[243.904461, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.904544, "o", "> "]
[243.904755, "o", "    for idx, seg in enumerate(segments_data):\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.90484, "o", "> "]
[243.90902, "o", "        print(f\"\\nProcessing segment {idx}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         window_start = seg['start']\r\n\u001b[?2004l\r\u001b[?2004h>         window_end = seg['end']\r\n\u001b[?2004l\r\u001b[?2004h>         window_duration = window_end - window_start\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Get corresponding text\r\n\u001b[?2004l\r\u001b[?2004h>         source_text = source_data[idx]['text'] if idx < len(source_data) else ''\r\n\u001b[?2004l\r\u001b[?2004h>         target_text = target_data[idx]['text'] if idx < len(target_data) else ''\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Window: {window_start:.3f}s - {window_end:.3f}s ({window_duration:.3f}s)\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Source: {source_text[:50]}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Target: {target_text[:50]}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Generate synthetic audio\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Generating synthetic audio...\")\r\n\u001b[?2004l\r\u001b[?2004h>         audio_data = generate_synthetic_audio(window_duration, 48000)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Process audio\r\n\u001b[?2004l\r\u001b[?2004h>         output_wav = f'/outputs/tts_segments/seg_{idx}.wav'\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Processing audio to {output_wav}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         sr, tts_duration = process_audio(audio_data, 48000, output_wav, window_duration)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Measure LUFS\r\n\u001b[?2004l\r\u001b[?2004h>         lufs = measure_lufs(audio_data)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  LUFS: {lufs:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Store audio for concatenation\r\n\u001b[?2004l\r\u001b[?2004h>         processed_audio, _ = sf.read(output_wav)\r\n\u001b[?2004l\r\u001b[?2004h>         all_audio_data.append(processed_audio)"]
[243.909156, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.909263, "o", "        # Calculate drift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.909364, "o", "        drift = abs(tts_duration - window_duration)\r\n\u001b[?2004l\r"]
[243.909442, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.909776, "o", "        # Determine duration control method\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(drift) < 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.909919, "o", "            duration_control = 'rate_adjust'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.910003, "o", "        elif tts_duration < window_duration:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.913058, "o", "            duration_control = 'pad_silence'\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             duration_control = 'trim'\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         report_segments.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'window_start_sec': round(window_start, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'window_end_sec': round(window_end, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'placed_start_sec': round(window_start, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'placed_end_sec': round(window_start + tts_duration, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'source_text': source_text,\r\n\u001b[?2004l\r\u001b[?2004h>             'target_text': target_text,\r\n\u001b[?2004l\r\u001b[?2004h>             'window_duration_sec': round(window_duration, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'tts_duration_sec': round(tts_duration, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'drift_sec': round(drift, 3),\r\n\u001b[?2004l\r\u001b[?2004h>             'duration_control': duration_control\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nCreating dubbed video...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Extract video without audio\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"  Extracting video stream...\")\r\n\u001b[?2004l\r\u001b[?2004h>     subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h>         'ffmpeg', '-i', '/root/input.mp4', '-c:v', 'copy', '-an', '-y',\r\n\u001b[?2004l\r"]
[243.913267, "o", "\u001b[?2004h>         '/tmp/video_only.mp4'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.91338, "o", "    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.913489, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.913599, "o", "    # Concatenate all audio segments\r\n\u001b[?2004l\r"]
[243.913668, "o", "\u001b[?2004h> "]
[243.913741, "o", "    print(\"  Concatenating audio segments...\")\r\n\u001b[?2004l\r"]
[243.913791, "o", "\u001b[?2004h> "]
[243.9139, "o", "    concatenated_audio = np.concatenate(all_audio_data)\r\n\u001b[?2004l\r"]
[243.913954, "o", "\u001b[?2004h> "]
[243.914092, "o", "    sf.write('/tmp/dubbed_audio.wav', concatenated_audio, 48000)\r\n\u001b[?2004l\r"]
[243.914142, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[243.914196, "o", "\u001b[?2004h> "]
[243.914262, "o", "    # Mux video and audio\r\n\u001b[?2004l\r"]
[243.914321, "o", "\u001b[?2004h> "]
[243.914402, "o", "    print(\"  Muxing video and audio...\")\r\n\u001b[?2004l\r"]
[243.914455, "o", "\u001b[?2004h> "]
[243.914517, "o", "    subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.91471, "o", "        'ffmpeg', '-i', '/tmp/video_only.mp4', '-i', '/tmp/dubbed_audio.wav',\r\n"]
[243.914768, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[243.914919, "o", "        '-c:v', 'copy', '-c:a', 'aac', '-shortest', '-y',\r\n\u001b[?2004l\r"]
[243.914972, "o", "\u001b[?2004h> "]
[243.91504, "o", "        '/outputs/dubbed.mp4'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.915228, "o", "    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r"]
[243.915299, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.915372, "o", "    # Measure final LUFS\r\n\u001b[?2004l\r"]
[243.915421, "o", "\u001b[?2004h> "]
[243.915555, "o", "    final_lufs = measure_lufs(concatenated_audio)\r\n\u001b[?2004l\r"]
[243.915602, "o", "\u001b[?2004h> "]
[243.915689, "o", "    print(f\"Final LUFS: {final_lufs:.1f}\")\r\n\u001b[?2004l\r"]
[243.915754, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.915823, "o", "    # Generate report\r\n\u001b[?2004l\r"]
[243.915873, "o", "\u001b[?2004h> "]
[243.91592, "o", "    report = {\r\n\u001b[?2004l\r"]
[243.915967, "o", "\u001b[?2004h> "]
[243.916041, "o", "        'source_language': 'en',\r\n\u001b[?2004l\r"]
[243.916089, "o", "\u001b[?2004h> "]
[243.916207, "o", "        'target_language': target_lang,\r\n\u001b[?2004l\r"]
[243.91626, "o", "\u001b[?2004h> "]
[243.916342, "o", "        'audio_sample_rate_hz': 48000,\r\n\u001b[?2004l\r"]
[243.916397, "o", "\u001b[?2004h> "]
[243.916467, "o", "        'audio_channels': 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.916642, "o", "        'original_duration_sec': round(original_duration, 3),\r\n\u001b[?2004l\r"]
[243.916699, "o", "\u001b[?2004h> "]
[243.916811, "o", "        'new_duration_sec': round(original_duration, 3),\r\n\u001b[?2004l\r"]
[243.916864, "o", "\u001b[?2004h> "]
[243.916956, "o", "        'measured_lufs': round(final_lufs, 1),\r\n\u001b[?2004l\r"]
[243.917036, "o", "\u001b[?2004h> "]
[243.917111, "o", "        'speech_segments': report_segments\r\n\u001b[?2004l\r"]
[243.917169, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.917225, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.917282, "o", "> "]
[243.917334, "o", "    # Write report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.917792, "o", "    with open('/outputs/report.json', 'w', encoding='utf-8') as f:\r\n"]
[243.917939, "o", "\u001b[?2004l\r\u001b[?2004h>         json.dump(report, f, indent=2, ensure_ascii=False)"]
[243.918059, "o", "\r\n"]
[243.918203, "o", "\u001b[?2004l\r\u001b[?2004h>     "]
[243.918392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.918467, "o", "    print('\\n=== Dubbing Complete ===')"]
[243.918582, "o", "\r\n"]
[243.918814, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[243.918893, "o", "    print(json.dumps(report, indent=2, ensure_ascii=False))"]
[243.918971, "o", "\r\n"]
[243.919047, "o", "\u001b[?2004l\r"]
[243.919167, "o", "\u001b[?2004h"]
[243.919286, "o", ">     "]
[243.919438, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Verify output files"]
[243.919521, "o", "\r\n"]
[243.919733, "o", "\u001b[?2004l\r\u001b[?2004h"]
[243.919804, "o", ">     print(\"\\nVerifying output files:\")"]
[243.919884, "o", "\r\n"]
[243.919985, "o", "\u001b[?2004l\r"]
[243.920331, "o", "\u001b[?2004h>     for output_file in ['/outputs/tts_segments/seg_0.wav', '/outputs/dubbed.mp4', '/outputs/report.json']:"]
[243.920421, "o", "\r\n"]
[243.920504, "o", "\u001b[?2004l\r"]
[243.920605, "o", "\u001b[?2004h"]
[243.920692, "o", "> "]
[243.920865, "o", "        if os.path.exists(output_file):"]
[243.92095, "o", "\r\n"]
[243.921049, "o", "\u001b[?2004l\r"]
[243.921148, "o", "\u001b[?2004h"]
[243.921357, "o", "> "]
[243.921437, "o", "            size = os.path.getsize(output_file)"]
[243.921525, "o", "\r\n"]
[243.92163, "o", "\u001b[?2004l\r"]
[243.921854, "o", "\u001b[?2004h> "]
[243.921931, "o", "            print(f\"  ✓ {output_file} ({size} bytes)\")"]
[243.922004, "o", "\r\n"]
[243.922082, "o", "\u001b[?2004l\r"]
[243.922229, "o", "\u001b[?2004h"]
[243.922334, "o", ">         else:"]
[243.92256, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.92264, "o", ">             print(f\"  ✗ {output_file} (NOT FOUND)\")"]
[243.922716, "o", "\r\n"]
[243.922797, "o", "\u001b[?2004l\r"]
[243.922915, "o", "\u001b[?2004h"]
[243.923087, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.92316, "o", "> if __name__ == '__main__':"]
[243.923266, "o", "\r\n"]
[243.923387, "o", "\u001b[?2004l\r\u001b[?2004h> "]
