[139.936731, "o", "def parse_srt(filename):"]
[139.936785, "o", "\r\n"]
[139.936843, "o", "\u001b[?2004l\r"]
[139.936912, "o", "\u001b[?2004h"]
[139.937019, "o", "> "]
[139.937231, "o", "    \"\"\"Parse SRT file and return list of segments\"\"\""]
[139.937281, "o", "\r\n"]
[139.937332, "o", "\u001b[?2004l\r"]
[139.937395, "o", "\u001b[?2004h"]
[139.937465, "o", "> "]
[139.937563, "o", "    segments = []"]
[139.937634, "o", "\r\n"]
[139.937715, "o", "\u001b[?2004l\r\u001b[?2004h"]
[139.937789, "o", "> "]
[139.93795, "o", "    with open(filename, 'r', encoding='utf-8') as f:"]
[139.938004, "o", "\r\n"]
[139.938054, "o", "\u001b[?2004l\r"]
[139.938137, "o", "\u001b[?2004h"]
[139.938221, "o", "> "]
[139.938465, "o", "        lines = f.readlines()"]
[139.938625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.938723, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.938804, "o", "    i = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.93888, "o", "> "]
[139.938963, "o", "    while i < len(lines):"]
[139.939034, "o", "\r\n\u001b[?2004l\r"]
[139.93912, "o", "\u001b[?2004h> "]
[139.939222, "o", "        line = lines[i].strip()"]
[139.939282, "o", "\r\n"]
[139.939358, "o", "\u001b[?2004l\r\u001b[?2004h"]
[139.939424, "o", "> "]
[139.939556, "o", "        if line and line.isdigit():"]
[139.939604, "o", "\r\n"]
[139.939676, "o", "\u001b[?2004l\r\u001b[?2004h"]
[139.939749, "o", "> "]
[139.939865, "o", "            if i + 2 < len(lines):"]
[139.939907, "o", "\r\n"]
[139.939977, "o", "\u001b[?2004l\r"]
[139.94006, "o", "\u001b[?2004h> "]
[139.940518, "o", "                start_end = lines[i+1].strip().split(' --> ')"]
[139.940787, "o", "\r\n"]
[139.940985, "o", "\u001b[?2004l\r\u001b[?2004h"]
[139.941106, "o", "> "]
[139.941345, "o", "                start = srt_time_to_seconds(start_end[0])"]
[139.941397, "o", "\r\n"]
[139.94145, "o", "\u001b[?2004l\r"]
[139.941518, "o", "\u001b[?2004h"]
[139.941582, "o", "> "]
[139.941843, "o", "                end = srt_time_to_seconds(start_end[1])"]
[139.94189, "o", "\r\n"]
[139.941937, "o", "\u001b[?2004l\r"]
[139.942003, "o", "\u001b[?2004h"]
[139.942056, "o", "> "]
[139.942284, "o", "                text = lines[i+2].strip()"]
[139.942347, "o", "\r\n"]
[139.942395, "o", "\u001b[?2004l\r"]
[139.94246, "o", "\u001b[?2004h"]
[139.942517, "o", "> "]
[139.94287, "o", "                segments.append({'start': start, 'end': end, 'text': text})"]
[139.942924, "o", "\r\n"]
[139.942979, "o", "\u001b[?2004l\r"]
[139.943046, "o", "\u001b[?2004h"]
[139.943107, "o", "> "]
[139.94322, "o", "        i += 1"]
[139.943272, "o", "\r\n"]
[139.943324, "o", "\u001b[?2004l\r"]
[139.94339, "o", "\u001b[?2004h"]
[139.943458, "o", "> "]
[139.94361, "o", "    return segments"]
