[?2004ln[?2004h> def measure_lufs(audio_file):
[?2004l[?2004h>     """Measure LUFS of audio file (simplified calculation)"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         data, sr = sf.read(audio_file)
[?2004l[?2004h>         if len(data.shape) > 1:
[?2004l[?2004h>             data = np.mean(data, axis=1)
[?2004l[?2004h>         
[?2004l[?2004h>         # Simplified LUFS: RMS to LUFS conversion
[?2004l[?2004h>         rms = np.sqrt(np.mean(data ** 2))
[?2004l[?2004h>         if rms > 1e-6:
[?2004l[?2004h>             lufs = 20 * np.log10(rms) - 0.691
[?2004l[?2004h>         else:
