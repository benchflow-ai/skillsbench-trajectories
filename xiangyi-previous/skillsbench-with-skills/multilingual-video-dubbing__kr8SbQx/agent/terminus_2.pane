[?2004l[?2004h> def process_audio(input_file, output_file, target_duration):
[?2004l[?2004h>     """Process audio to target specifications: 48kHz, mono, duration-adjusted, normalized"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Read audio
[?2004l[?2004h>         data, sr = sf.read(input_file)
[?2004l[?2004h>         
[?2004l[?2004h>         # Convert to mono if stereo
[?2004l[?2004h>         if len(data.shape) > 1:
[?2004l[?2004h>             data = np.mean(data, axis=1)
[?2004l[?2004h>         
[?2004la[?2004h>         # Resample to 48kHz
[?2004l[?2004h>         if sr != 48000:
[?2004l[?2004h>             num_samples = int(len(data) * 48000 / sr)
[?2004l[?2004h>             data = signal.resample(data, num_samples)
[?2004l[?2004h>             sr = 48000
[?2004l[?2004h>         
[?2004l[?2004h>         # Adjust duration
[?2004l[?2004h>         current_duration = len(data) / sr
[?2004l[?2004h>         if current_duration < target_duration:
[?2004l[?2004h>             # Pad with silence
[?2004l[?2004h>             samples_needed = int((target_duration - current_duration) * sr)
[?2004l[?2004h>             data = np.pad(data, (0, samples_needed), mode='constant')
[?2004l[?2004h>         elif current_duration > target_duration:
[?2004l[?2004h>             # Trim
