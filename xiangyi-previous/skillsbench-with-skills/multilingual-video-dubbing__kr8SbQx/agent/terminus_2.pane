[?2004l[?2004h> def main():
[?2004l[?2004h>     print("Starting multilingual dubbing process...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Read target language
[?2004l[?2004h>     with open('/root/target_language.txt', 'r') as f:
[?2004l[?2004h>         target_lang = f.read().strip()
[?2004l[?2004h>     print(f"Target language: {target_lang}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Parse segments
