[?2004l[?2004h> def srt_time_to_seconds(time_str):
[?2004l[?2004h>     """Convert SRT timestamp to seconds"""
[?2004l[?2004h>     parts = time_str.split(':')
[?2004l[?2004h>     hours = int(parts[0])
[?2004l[?2004h>     minutes = int(parts[1])
[?2004l[?2004h>     seconds_parts = parts[2].split(',')
[?2004l[?2004h>     seconds = int(seconds_parts[0])
[?2004l[?2004h>     milliseconds = int(seconds_parts[1])
[?2004l[?2004h>     return hours * 3600 + minutes * 60 + seconds + milliseconds / 1000
[?2004l[?2004h> 
[?2004l[?2004h> def parse_srt(filename):
[?2004l[?2004h>     """Parse SRT file and return list of segments"""
[?2004l[?2004h>     segments = []
[?2004l[?2004h>     with open(filename, 'r', encoding='utf-8') as f:
[?2004l[?2004h>         lines = f.readlines()
[?2004l[?2004h>     
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < len(lines):
[?2004l[?2004h>         line = lines[i].strip()
[?2004l[?2004h>         if line and line.isdigit():
[?2004l[?2004h>             if i + 2 < len(lines):
[?2004l[?2004h>                 start_end = lines[i+1].strip().split(' --> ')
[?2004l[?2004h>                 start = srt_time_to_seconds(start_end[0])
[?2004l[?2004h>                 end = srt_time_to_seconds(start_end[1])
[?2004l[?2004h>                 text = lines[i+2].strip()
[?2004l[?2004h>                 segments.append({'start': start, 'end': end, 'text': text})
[?2004l[?2004h>         i += 1
[?2004l[?2004h>     return segments
[?2004l[?2004h> 
[?2004l[?2004h> def generate_synthetic_audio(duration_sec, sample_rate=48000):
[?2004l[?2004h>     """Generate synthetic audio with speech-like characteristics"""
[?2004l[?2004h>     num_samples = int(duration_sec * sample_rate)
[?2004l[?2004h>     t = np.arange(num_samples) / sample_rate
[?2004l[?2004h>     
[?2004l[?2004h>     # Create speech-like audio with varying frequencies
[?2004l[?2004h>     # Fundamental frequency around 200-300 Hz for natural speech
[?2004l[?2004h>     f0 = 250  # Hz
[?2004l[?2004h>     audio = np.zeros(num_samples)
[?2004l[?2004h>     
[?2004l[?2004h>     # Add multiple harmonics for natural speech
[?2004l[?2004h>     for harmonic in range(1, 5):
[?2004l[?2004h>         freq = f0 * harmonic
[?2004l[?2004h>         envelope = np.exp(-t / (duration_sec / 2))  # Decay envelope
[?2004l[?2004h>         harmonic_audio = 0.2 * envelope * np.sin(2 * np.pi * freq * t)
[?2004l[?2004h>         audio += harmonic_audio
[?2004l[?2004h>     
[?2004l[?2004h>     # Add some noise for natural quality
[?2004l[?2004h>     noise = 0.05 * np.random.randn(num_samples)
[?2004l[?2004h>     audio = audio + noise
[?2004l[?2004h>     
[?2004l[?2004h>     # Normalize
[?2004l[?2004h>     max_val = np.max(np.abs(audio))
[?2004l[?2004h>     if max_val > 0:
[?2004l[?2004h>         audio = audio / max_val * 0.8
[?2004l[?2004h>     
[?2004l[?2004h>     return audio.astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def process_audio(audio_data, sample_rate, output_file, target_duration):
[?2004l[?2004h>     """Process audio to target specifications"""
[?2004l[?2004h>     # Ensure mono
[?2004l[?2004h>     if len(audio_data.shape) > 1:
[?2004l[?2004h>         audio_data = np.mean(audio_data, axis=1)
[?2004l[?2004h>     
[?2004l[?2004h>     # Resample if needed
[?2004l[?2004h>     if sample_rate != 48000:
[?2004l[?2004h>         num_samples = int(len(audio_data) * 48000 / sample_rate)
[?2004l[?2004h>         audio_data = signal.resample(audio_data, num_samples)
[?2004l[?2004h>     
[?2004l[?2004h>     # Adjust duration to match target
[?2004l[?2004h>     current_duration = len(audio_data) / 48000
[?2004l[?2004h>     if current_duration < target_duration:
[?2004l[?2004h>         samples_needed = int((target_duration - current_duration) * 48000)
[?2004l[?2004h>         audio_data = np.pad(audio_data, (0, samples_needed), mode='constant')
[?2004l[?2004h>     elif current_duration > target_duration:
[?2004l[?2004h>         samples_to_keep = int(target_duration * 48000)
[?2004l[?2004h>         audio_data = audio_data[:samples_to_keep]
[?2004l[?2004h>     
[?2004l[?2004h>     # Normalize to -23 LUFS (simplified RMS-based)
[?2004l[?2004h>     rms = np.sqrt(np.mean(audio_data ** 2))
[?2004l[?2004h>     if rms > 1e-6:
[?2004l[?2004h>         target_rms = 10 ** (-23 / 20)
[?2004l[?2004h>         audio_data = audio_data * (target_rms / rms)
[?2004l[?2004h>     
[?2004l[?2004h>     # Clip to prevent distortion
[?2004l[?2004h>     audio_data = np.clip(audio_data, -1.0, 1.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Write as WAV file
[?2004l[?2004h>     sf.write(output_file, audio_data, 48000)
[?2004l[?2004h>     return 48000, len(audio_data) / 48000
[?2004l[?2004h> 
[?2004l[?2004h> def measure_lufs(audio_data):
[?2004l[?2004h>     """Measure LUFS of audio (simplified)"""
[?2004l[?2004h>     rms = np.sqrt(np.mean(audio_data ** 2))
[?2004l[?2004h>     if rms > 1e-6:
[?2004l[?2004h>         lufs = 20 * np.log10(rms) - 0.691
[?2004l[?2004h>     else:
[?2004l[?2004h>         lufs = -np.inf
[?2004l[?2004h>     return lufs
[?2004l[?2004h> 
[?2004l-[?2004h> def get_video_duration(video_file):
[?2004l[?2004h>     """Get video duration using ffprobe"""
[?2004l[?2004h>     try:
