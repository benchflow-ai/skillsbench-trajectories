[?2004l[?2004h>     source_data = parse_srt('/root/source_text.srt')
[?2004l[?2004h>     target_data = parse_srt('/root/reference_target_text.srt')
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Found {len(segments_data)} segments")
[?2004l[?2004h>     
[?2004l[?2004h>     # Get original video duration
[?2004l[?2004h>     original_duration = get_video_duration('/root/input.mp4')
[?2004l[?2004h>     print(f"Original video duration: {original_duration}s")
[?2004l[?2004h>     
