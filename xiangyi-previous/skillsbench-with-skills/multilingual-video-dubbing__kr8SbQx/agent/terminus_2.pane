[?2004l[?2004h>     if rms > 0:
[?2004l[?2004h>         target_rms = 10 ** (-23 / 20)  # Simplified LUFS to RMS
[?2004l[?2004h>         data = data * (target_rms / rms)
[?2004l[?2004h>     
[?2004l[?2004h>     # Ensure no clipping
