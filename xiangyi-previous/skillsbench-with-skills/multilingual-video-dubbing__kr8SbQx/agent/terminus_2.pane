[?2004l[?2004h>         audio_data = generate_synthetic_audio(window_duration, 48000)
[?2004l[?2004h>         
[?2004l[?2004h>         # Process audio
[?2004l[?2004h>         output_wav = f'/outputs/tts_segments/seg_{idx}.wav'
[?2004l[?2004h>         print(f"  Processing audio to {output_wav}...")
[?2004l[?2004h>         sr, tts_duration = process_audio(audio_data, 48000, output_wav, window_duration)
[?2004l[?2004h>         
[?2004l[?2004h>         # Measure LUFS
