[?2004l[?2004h>         print(f"  LUFS: {lufs:.1f}")
[?2004l[?2004h>         
[?2004l[?2004h>         # Store audio for concatenation
[?2004l[?2004h>         processed_audio, _ = sf.read(output_wav)
[?2004l[?2004h>         all_audio_data.append(processed_audio)
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate drift
[?2004l[?2004h>         drift = abs(tts_duration - window_duration)
[?2004l[?2004h>         
[?2004l[?2004h>         # Determine duration control method
[?2004l[?2004h>         if abs(drift) < 0.01:
[?2004l[?2004h>             duration_control = 'rate_adjust'
[?2004l[?2004h>         elif tts_duration < window_duration:
[?2004l[?2004h>             duration_control = 'pad_silence'
[?2004l[?2004h>         else:
