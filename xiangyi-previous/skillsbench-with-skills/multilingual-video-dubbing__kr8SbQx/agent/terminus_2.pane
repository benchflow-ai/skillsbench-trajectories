[?2004l[?2004h>     all_audio_data = []
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, seg in enumerate(segments_data):
[?2004l[?2004h>         print(f"\nProcessing segment {idx}...")
[?2004l[?2004h>         window_start = seg['start']
[?2004l[?2004h>         window_end = seg['end']
[?2004l[?2004h>         window_duration = window_end - window_start
[?2004l[?2004h>         
[?2004l[?2004h>         # Get corresponding text
[?2004l[?2004h>         source_text = source_data[idx]['text'] if idx < len(source_data) else ''
[?2004l[?2004h>         target_text = target_data[idx]['text'] if idx < len(target_data) else ''
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"  Window: {window_start:.3f}s - {window_end:.3f}s ({window_duration:.3f}s)")
[?2004l[?2004h>         print(f"  Source: {source_text[:50]}...")
[?2004l[?2004h>         print(f"  Target: {target_text[:50]}...")
[?2004l[?2004h>         
[?2004l[?2004h>         # Generate synthetic audio
