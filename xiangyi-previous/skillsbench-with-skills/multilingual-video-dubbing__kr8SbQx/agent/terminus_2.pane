[?2004l[?2004h>             data = data[:samples_to_keep]
[?2004l[?2004h>         
[?2004l[?2004h>         # Normalize to -23 LUFS (simplified RMS-based)
[?2004l[?2004h>         rms = np.sqrt(np.mean(data ** 2))
[?2004l[?2004h>         if rms > 1e-6:
[?2004l[?2004h>             target_rms = 10 ** (-23 / 20)
[?2004l[?2004h>             data = data * (target_rms / rms)
[?2004l[?2004h>         
[?2004l[?2004h>         # Ensure no clipping
[?2004l[?2004h>         data = np.clip(data, -1.0, 1.0)
[?2004l[?2004h>         
[?2004l[?2004h>         # Write as 16-bit PCM
[?2004l[?2004h>         sf.write(output_file, data, sr, subtype='PCM_16')
