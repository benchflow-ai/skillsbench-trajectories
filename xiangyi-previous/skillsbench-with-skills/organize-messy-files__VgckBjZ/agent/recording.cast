[284.360232, "o", "        root = ET.fromstring(xml_content)\r\n\u001b[?2004l\r"]
[284.36032, "o", "\u001b[?2004h> "]
[284.360403, "o", "        # Find all text elements\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.360483, "o", "> "]
[284.360578, "o", "        for elem in root.iter():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.360684, "o", "            if elem.text:\r\n\u001b[?2004l\r"]
[284.360773, "o", "\u001b[?2004h> "]
[284.360871, "o", "                text.append(elem.text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.361026, "o", "    return ' '.join(text).lower()\r\n\u001b[?2004l\r"]
[284.361113, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.361216, "o", "def extract_text_from_pptx(pptx_file):\r\n\u001b[?2004l\r"]
[284.361264, "o", "\u001b[?2004h> "]
[284.361423, "o", "    \"\"\"Extract text from PPTX file\"\"\""]
[284.361507, "o", "\r\n"]
[284.361627, "o", "\u001b[?2004l\r"]
[284.361725, "o", "\u001b[?2004h>     text = []"]
[284.361798, "o", "\r\n\u001b[?2004l\r"]
[284.36186, "o", "\u001b[?2004h"]
[284.36192, "o", "> "]
[284.362097, "o", "    with zipfile.ZipFile(pptx_file, 'r') as zip_ref:"]
[284.362184, "o", "\r\n\u001b[?2004l\r"]
[284.362244, "o", "\u001b[?2004h> "]
[284.36237, "o", "        # Get all slide XMLs"]
[284.362435, "o", "\r\n\u001b[?2004l\r"]
[284.362496, "o", "\u001b[?2004h"]
[284.362666, "o", ">         for file_name in zip_ref.namelist():"]
[284.362726, "o", "\r\n\u001b[?2004l\r"]
[284.36279, "o", "\u001b[?2004h"]
[284.363089, "o", ">             if file_name.startswith('ppt/slides/slide') and file_name.endswith('.xml'):"]
[284.363176, "o", "\r\n\u001b[?2004l\r"]
[284.363384, "o", "\u001b[?2004h> "]
[284.363458, "o", "                xml_content = zip_ref.read(file_name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.36352, "o", "> "]
[284.363686, "o", "                root = ET.fromstring(xml_content)"]
[284.36377, "o", "\r\n\u001b[?2004l\r"]
[284.363936, "o", "\u001b[?2004h> "]
[284.364007, "o", "                for elem in root.iter():\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.364161, "o", "> "]
[284.364232, "o", "                    if elem.text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.364297, "o", "> "]
[284.364467, "o", "                        text.append(elem.text)"]
[284.364529, "o", "\r\n\u001b[?2004l\r"]
[284.36459, "o", "\u001b[?2004h"]
[284.364737, "o", "> "]
[284.364805, "o", "    return ' '.join(text).lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.364864, "o", "> "]
[284.364921, "o", "\r\n"]
[284.364997, "o", "\u001b[?2004l\r"]
