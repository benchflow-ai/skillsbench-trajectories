[136.595801, "o", "    'trapped_ion_and_qc': 'trapped_ion_and_qc',"]
[136.596146, "o", "\r\n"]
[136.596429, "o", "\u001b[?2004l\r"]
[136.596703, "o", "\u001b[?2004h"]
[136.596965, "o", ">     'black_hole': 'black_hole',"]
[136.597286, "o", "\r\n"]
[136.597558, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.597823, "o", "    'DNA': 'DNA',\r\n"]
[136.598067, "o", "\u001b[?2004l\r\u001b[?2004h>     'music_history': 'music_history'"]
[136.598304, "o", "\r\n"]
[136.598533, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.598776, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.59907, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.599195, "o", "def extract_text_from_pdf(pdf_path):"]
[136.599429, "o", "\r\n\u001b[?2004l\r"]
[136.599665, "o", "\u001b[?2004h>     \"\"\"Extract text from PDF using pdftotext\"\"\""]
[136.599876, "o", "\r\n"]
[136.60007, "o", "\u001b[?2004l\r"]
[136.60028, "o", "\u001b[?2004h> "]
[136.600842, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.601238, "o", ">         result = subprocess.run(['pdftotext', pdf_path, '-'], "]
[136.60177, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.601985, "o", ">                               capture_output=True, text=True, timeout=10)"]
[136.602222, "o", "\r\n"]
[136.602484, "o", "\u001b[?2004l\r"]
[136.602827, "o", "\u001b[?2004h"]
[136.603099, "o", ">         return result.stdout.lower()"]
[136.603575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.60396, "o", ">     except:\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.604241, "o", ">         return \"\""]
[136.604556, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.604881, "o", "> def classify_paper(pdf_path):"]
[136.605242, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.605754, "o", "> "]
[136.605973, "o", "    \"\"\"Classify a paper based on keyword matching\"\"\""]
[136.606338, "o", "\r\n"]
[136.606849, "o", "\u001b[?2004l\r\u001b[?2004h>     text = extract_text_from_pdf(pdf_path)"]
[136.607226, "o", "\r\n"]
[136.607509, "o", "\u001b[?2004l\r"]
[136.607967, "o", "\u001b[?2004h"]
[136.608552, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.608879, "o", ">     if not text:"]
[136.609251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         return 'music_history'  # Default category"]
[136.609642, "o", "\r\n"]
[136.609872, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.610154, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.610376, "o", ">     scores = {}"]
[136.610668, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for category, kw_list in keywords.items():"]
[136.610905, "o", "\r\n"]
[136.611167, "o", "\u001b[?2004l\r"]
[136.61146, "o", "\u001b[?2004h>         score = sum(text.count(kw) for kw in kw_list)"]
[136.611678, "o", "\r\n"]
[136.611882, "o", "\u001b[?2004l\r"]
[136.612163, "o", "\u001b[?2004h>         scores[category] = score"]
[136.612352, "o", "\r\n"]
[136.612587, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.612934, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.613076, "o", ">     # Return category with highest score"]
[136.613322, "o", "\r\n"]
[136.613673, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.613829, "o", "    best_category = max(scores, key=scores.get)"]
[136.614057, "o", "\r\n"]
[136.614464, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.614606, "o", ">     return best_category if scores[best_category] > 0 else 'music_history'"]
[136.61479, "o", "\r\n"]
[136.61496, "o", "\u001b[?2004l\r"]
[136.615261, "o", "\u001b[?2004h"]
[136.61566, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.61601, "o", "> def main():\r\n\u001b[?2004l\r"]
[136.616294, "o", "\u001b[?2004h>     # Get all PDF files"]
[136.616756, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     pdf_files = sorted([f for f in os.listdir(source_dir) if f.endswith('.pdf')])"]
[136.616905, "o", "\r\n"]
[136.617015, "o", "\u001b[?2004l\r"]
[136.617168, "o", "\u001b[?2004h"]
[136.617316, "o", "> "]
[136.617456, "o", "    \r\n\u001b[?2004l\r"]
[136.617679, "o", "\u001b[?2004h>     print(f\"Found {len(pdf_files)} PDF files\")"]
[136.617812, "o", "\r\n"]
[136.617961, "o", "\u001b[?2004l\r"]
[136.618139, "o", "\u001b[?2004h> "]
[136.618447, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.618558, "o", "    classified = {cat: [] for cat in target_dirs.keys()}"]
[136.618678, "o", "\r\n"]
[136.618829, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.618992, "o", ">     "]
[136.619258, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.619339, "o", "    for i, pdf_file in enumerate(pdf_files):"]
[136.619444, "o", "\r\n"]
[136.61958, "o", "\u001b[?2004l\r"]
[136.619831, "o", "\u001b[?2004h>         pdf_path = os.path.join(source_dir, pdf_file)"]
[136.619983, "o", "\r\n"]
[136.62009, "o", "\u001b[?2004l\r"]
[136.620252, "o", "\u001b[?2004h"]
[136.620576, "o", ">         print(f\"[{i+1}/{len(pdf_files)}] Classifying {pdf_file}...\", end=' ')"]
[136.620744, "o", "\r\n"]
[136.620856, "o", "\u001b[?2004l\r"]
[136.621002, "o", "\u001b[?2004h"]
[136.621129, "o", "> "]
[136.621258, "o", "        "]
[136.621435, "o", "\r\n\u001b[?2004l\r"]
[136.621689, "o", "\u001b[?2004h>         category = classify_paper(pdf_path)"]
[136.621843, "o", "\r\n"]
[136.622001, "o", "\u001b[?2004l\r"]
[136.622278, "o", "\u001b[?2004h"]
[136.62235, "o", ">         classified[category].append(pdf_file)"]
[136.622446, "o", "\r\n"]
[136.622567, "o", "\u001b[?2004l\r"]
[136.622698, "o", "\u001b[?2004h"]
[136.62282, "o", ">         "]
[136.623097, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         # Move file to appropriate folder"]
[136.623272, "o", "\r\n"]
[136.623599, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.623691, "o", "        target_path = os.path.join(target_dirs[category], pdf_file)"]
[136.623802, "o", "\r\n"]
[136.6239, "o", "\u001b[?2004l\r"]
[136.62404, "o", "\u001b[?2004h"]
[136.624242, "o", ">         shutil.move(pdf_path, target_path)"]
[136.624365, "o", "\r\n"]
[136.624457, "o", "\u001b[?2004l\r"]
[136.624583, "o", "\u001b[?2004h"]
[136.624747, "o", ">         print(f\"-> {category}\")"]
[136.624862, "o", "\r\n"]
[136.625173, "o", "\u001b[?2004l\r\u001b[?2004h"]
[136.625348, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.62548, "o", ">     # Print summary"]
[136.625654, "o", "\r\n"]
[136.625851, "o", "\u001b[?2004l\r\u001b[?2004h>     print(\"\\n=== Classification Summary ===\")"]
[136.625961, "o", "\r\n"]
[136.626052, "o", "\u001b[?2004l\r"]
[136.626323, "o", "\u001b[?2004h"]
[136.626395, "o", ">     for category, files in classified.items():"]
[136.626491, "o", "\r\n"]
[136.626608, "o", "\u001b[?2004l\r"]
[136.626844, "o", "\u001b[?2004h"]
[136.626912, "o", ">         print(f\"{category}: {len(files)} files\")"]
[136.627008, "o", "\r\n"]
[136.627141, "o", "\u001b[?2004l\r"]
[136.627287, "o", "\u001b[?2004h> "]
[136.627472, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.627541, "o", "if __name__ == '__main__':"]
[136.627689, "o", "\r\n\u001b[?2004l\r"]
[136.627857, "o", "\u001b[?2004h>     main()"]
[136.628306, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
