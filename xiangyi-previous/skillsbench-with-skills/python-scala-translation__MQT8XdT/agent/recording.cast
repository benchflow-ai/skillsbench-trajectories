[66.245697, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.245805, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.245874, "o", "// Enums and Constants\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.245987, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.246017, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.246103, "o", "sealed trait TokenType {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.246133, "o", "  def value: String\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.246188, "o", "\u001b[?2004h> "]
[66.246251, "o", "object TokenType {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.246325, "o", "  case object String extends TokenType { val value = \"string\" }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.246418, "o", "  case object Numeric extends TokenType { val value = \"numeric\" }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.24653, "o", "  case object Temporal extends TokenType { val value = \"temporal\" }\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.246583, "o", "> "]
[66.246653, "o", "  case object Structured extends TokenType { val value = \"structured\" }\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.246682, "o", "> "]
