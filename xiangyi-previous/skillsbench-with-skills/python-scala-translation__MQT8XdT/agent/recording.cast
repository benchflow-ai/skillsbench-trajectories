[173.597827, "o", "-rw-r--r-- 1 root root  2726 Jan 26 11:09 BaseTokenizer.class\r\n-rw-r--r-- 1 root root  1756 Jan 26 11:09 BivariantHandler.class\r\n-rw-r--r-- 1 root root   381 Jan 26 11:09 HasLength.class\r\n-rw-r--r-- 1 root root  2426 Jan 26 11:09 MutableTokenBatch.class\r\n-rw-r--r-- 1 root root   607 Jan 26 11:09 NumericTokenizer$.class\r\n-rw-r--r-- 1 root root  5262 Jan 26 11:09 NumericTokenizer.class\r\n-rw-r--r-- 1 root root   815 Jan 26 11:09 StringTokenizer$.class\r\n-rw-r--r-- 1 root root  6403 Jan 26 11:09 StringTokenizer.class\r\n-rw-r--r-- 1 root root   764 Jan 26 11:09 TemporalTokenizer$.class\r\n-rw-r--r-- 1 root root  6250 Jan 26 11:09 TemporalTokenizer.class\r\n-rw-r--r-- 1 root root  2801 Jan 26 11:09 Token$.class\r\n-rw-r--r-- 1 root root  7457 Jan 26 11:09 Token.class\r\n-rw-r--r-- 1 root root  2047 Jan 26 11:09 TokenContainer.class\r\n-rw-r--r-- 1 root root   609 Jan 26 11:09 TokenProcessor.class\r\n-rw-r--r-- 1 root root  1942 Jan 26 11:09 TokenSink.class\r\n-rw-r--r-- 1 root root   395 Jan 26 11:09 TokenType$.class\r\n-rw-r--r-- 1 root root  2313 Jan 26 11:09 TokenType$Binary$.class\r\n-rw-r--r-- 1 root root  2303 Jan 26 11:09 TokenType$Null$.class\r\n-rw-r--r-- 1 root root  2318 Jan 26 11:09 TokenType$Numeric$.class\r\n-rw-r--r-- 1 root root  2313 Jan 26 11:09 TokenType$String$.class\r\n-rw-r--r-- 1 root root  2333 Jan 26 11:09 TokenType$Structured$.class\r\n-rw-r--r-- 1 root root  2323 Jan 26 11:09 TokenType$Temporal$.class\r\n-rw-r--r-- 1 root root  2582 Jan 26 11:09 TokenType.class\r\n-rw-r--r-- 1 root root   452 Jan 26 11:09 Tokenizable.class\r\n-rw-r--r-- 1 root root  7441 Jan 26 11:09 TokenizerBuilder.class\r\n-rw-r--r-- 1 root root 10253 Jan 26 11:09 UniversalTokenizer.class\r\n-rw-r--r-- 1 root root   922 Jan 26 11:09 WhitespaceTokenizer$.class\r\n-rw-r--r-- 1 root root 13018 Jan 26 11:09 WhitespaceTokenizer.class\r\n"]
