[66.245042, "o", " * - Sealed traits and case classes for ADTs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.245164, "o", " * - Variance annotations for generic types\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.245192, "o", " * - Option/Either/Try for error handling\r\n\u001b[?2004l\r"]
