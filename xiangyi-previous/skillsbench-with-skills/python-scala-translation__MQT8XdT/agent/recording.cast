[128.646283, "o", "cat /root/Tokenizer.scala\r\n\u001b[?2004l\r"]
[128.647054, "o", "/**\r\n * Tokenizer module for converting various input types to standardized string tokens.\r\n *\r\n * This module demonstrates Scala's type system with:\r\n * - Sealed traits and case classes for ADTs\r\n * - Variance annotations for generic types\r\n * - Option/Either/Try for error handling\r\n * - Traits for structural typing and abstraction\r\n */\r\n\r\nimport java.time.{LocalDate, LocalDateTime}\r\nimport java.time.format.DateTimeFormatter\r\nimport scala.collection.mutable\r\nimport scala.util.{Try, Success, Failure}\r\n\r\n// ============================================================================\r\n// Enums and Constants\r\n// ============================================================================\r\n\r\nsealed trait TokenType {\r\n  def value: String\r\n}\r\n\r\nobject TokenType {\r\n  case object String extends TokenType { val value = \"string\" }\r\n  case object Numeric extends TokenType { val value = \"numeric\" }\r\n  case object Temporal extends TokenType { val value = \"temporal\" }\r\n  case object Structured extends TokenType { val value = \"structured\" }\r\n  case object Binary extends TokenType { val value = \"binary\" }\r\n  case object Null extends TokenType { val value = \"null\" }\r\n}\r\n\r\n// ============================================================================\r\n// Protocol definitions (structural typing via traits)\r\n// ============================================================================\r\n\r\ntrait Tokenizable {\r\n  def toToken: String\r\n}\r\n\r\ntrait HasLength {\r\n  def length: Int\r\n}\r\n\r\ntrait TokenProcessor[-T] {\r\n  def process(item: T): Unit\r\n}\r\n\r\n// ============================================================================\r\n// Core Token Classes\r\n// ============================================================================\r\n\r\nfinal case class Token(\r\n  value: String,\r\n  tokenType: TokenType,\r\n  metadata: Map[String, Any] = Map.empty\r\n) {\r\n  def withMetadata(entries: (String, Any)*): Token =\r\n    copy(metadata = metadata ++ entries.toMap)\r\n}\r\n\r\nfinal class MutableTokenBatch {\r\n  private val _tokens: mutable.ListBuffer[Token] = mutable.ListBuffer.empty\r\n  private var _processed: Boolean = false\r\n\r\n  def tokens: List[Token] = _tokens.toList\r\n\r\n  def add(token: Token): Unit = {\r\n    if (_processed) throw new RuntimeException(\"Batch already processed\")\r\n    _tokens += token\r\n  }\r\n\r\n  def markProcessed(): Unit = { _processed = true }\r\n  def isProcessed: Boolean = _processed\r\n}\r\n\r\n// ============================================================================\r\n// Generic Container Classes\r\n// ============================================================================\r\n\r\nclass TokenContainer[+T](items: Seq[T]) {\r\n  private val _items: Vector[T] = items.toVector\r\n  def getAll: Vector[T] = _items\r\n  def mapTokens(func: T => String): List[String] = _items.map(func).toList\r\n}\r\n\r\nclass TokenSink[-T] {\r\n  private val _received: mutable.ListBuffer[Any] = mutable.ListBuffer.empty\r\n  def receive(item: T): Unit = { _received += item }\r\n  def drain(): List[Any] = {\r\n    val result = _received.toList\r\n    _received.clear()\r\n    result\r\n  }\r\n}\r\n\r\nclass BivariantHandler[T](private var _value: T) {\r\n  def get: T = _value\r\n  def set(value: T): Unit = { _value = value }\r\n  def transform(func: T => T): T = { _value = func(_value); _value }\r\n}\r\n\r\n// ============================================================================\r\n// Tokenizer Implementations\r\n// ============================================================================\r\n\r\ntrait BaseTokenizer[T] {\r\n  def tokenize(value: T): Token\r\n\r\n  def tokenizeBatch(values: Iterable[T]): List[Token] =\r\n    values.map(tokenize).toList\r\n}\r\n\r\nclass StringTokenizer(\r\n  lowercase: Boolean = false,\r\n  stripWhitespace: Boolean = true,\r\n  maxLength: Option[Int] = None\r\n) extends BaseTokenizer[String] {\r\n\r\n  override def tokenize(value: String): Token = {\r\n    var processed = value\r\n    if (stripWhitespace) processed = processed.trim\r\n    if (lowercase) processed = processed.toLowerCase\r\n"]
[128.647111, "o", "    processed = maxLength.filter(_ < processed.length).fold(processed)(processed.take)\r\n\r\n    Token(\r\n      value = processed,\r\n      tokenType = TokenType.String,\r\n      metadata = Map(\r\n        \"original_length\" -> value.length,\r\n        \"processed_length\" -> processed.length\r\n      )\r\n    )\r\n  }\r\n}\r\n\r\nclass NumericTokenizer(\r\n  precision: Int = 2,\r\n  useScientificNotation: Boolean = false\r\n) extends BaseTokenizer[BigDecimal] {\r\n\r\n  override def tokenize(value: BigDecimal): Token = {\r\n    val formatted = if (useScientificNotation) {\r\n      s\"%.${precision}E\".format(value.doubleValue)\r\n    } else {\r\n      value.setScale(precision, BigDecimal.RoundingMode.HALF_UP).toString\r\n    }\r\n\r\n    Token(\r\n      value = formatted,\r\n      tokenType = TokenType.Numeric,\r\n      metadata = Map(\r\n        \"original_value\" -> value,\r\n        \"precision\" -> precision,\r\n        \"is_integer\" -> value.isWhole\r\n      )\r\n    )\r\n  }\r\n\r\n  def tokenizeInt(value: Int): Token = tokenize(BigDecimal(value))\r\n  def tokenizeDouble(value: Double): Token = tokenize(BigDecimal(value))\r\n}\r\n\r\nclass TemporalTokenizer(\r\n  dateFormat: String = \"yyyy-MM-dd\",\r\n  datetimeFormat: String = \"yyyy-MM-dd'T'HH:mm:ss\",\r\n  includeTimezone: Boolean = false\r\n) extends BaseTokenizer[Either[LocalDate, LocalDateTime]] {\r\n\r\n  private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)\r\n  private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)\r\n\r\n  override def tokenize(value: Either[LocalDate, LocalDateTime]): Token = value match {\r\n    case Left(date) =>\r\n      Token(\r\n        value = date.format(dateFormatter),\r\n        tokenType = TokenType.Temporal,\r\n        metadata = Map(\r\n          \"temporal_type\" -> \"date\",\r\n          \"year\" -> date.getYear,\r\n          \"month\" -> date.getMonthValue,\r\n          \"day\" -> date.getDayOfMonth\r\n        )\r\n      )\r\n    case Right(datetime) =>\r\n      Token(\r\n        value = datetime.format(datetimeFormatter),\r\n        tokenType = TokenType.Temporal,\r\n"]
[128.647155, "o", "        metadata = Map(\r\n          \"temporal_type\" -> \"datetime\",\r\n          \"year\" -> datetime.getYear,\r\n          \"month\" -> datetime.getMonthValue,\r\n          \"day\" -> datetime.getDayOfMonth,\r\n          \"hour\" -> datetime.getHour,\r\n          \"minute\" -> datetime.getMinute,\r\n          \"second\" -> datetime.getSecond\r\n        )\r\n      )\r\n  }\r\n\r\n  def tokenizeDate(date: LocalDate): Token = tokenize(Left(date))\r\n  def tokenizeDateTime(datetime: LocalDateTime): Token = tokenize(Right(datetime))\r\n}\r\n\r\nclass UniversalTokenizer extends BaseTokenizer[Any] {\r\n  private val stringTokenizer = new StringTokenizer()\r\n  private val numericTokenizer = new NumericTokenizer()\r\n  private val temporalTokenizer = new TemporalTokenizer()\r\n\r\n  override def tokenize(value: Any): Token = value match {\r\n    case null => Token(value = \"null\", tokenType = TokenType.Null)\r\n    case None => Token(value = \"null\", tokenType = TokenType.Null)\r\n    case Some(inner) => tokenize(inner)\r\n    case s: String => stringTokenizer.tokenize(s)\r\n    case b: Boolean => Token(b.toString, TokenType.String, Map(\"boolean_value\" -> b))\r\n    case i: Int => numericTokenizer.tokenizeInt(i)\r\n    case l: Long => numericTokenizer.tokenize(BigDecimal(l))\r\n    case f: Float => numericTokenizer.tokenize(BigDecimal(f.toDouble))\r\n    case d: Double => numericTokenizer.tokenizeDouble(d)\r\n    case bd: BigDecimal => numericTokenizer.tokenize(bd)\r\n    case bi: BigInt => numericTokenizer.tokenize(BigDecimal(bi))\r\n    case date: LocalDate => temporalTokenizer.tokenizeDate(date)\r\n    case datetime: LocalDateTime => temporalTokenizer.tokenizeDateTime(datetime)\r\n    case bytes: Array[Byte] =>\r\n      Token(\r\n        value = bytes.map(\"%02x\".format(_)).mkString,\r\n        tokenType = TokenType.Binary,\r\n        metadata = Map(\"byte_length\" -> bytes.length)\r\n      )\r\n    case seq: Seq[_] =>\r\n      val items = seq.map(item => tokenize(item).value)\r\n      Token(items.mkString(\"[\", \", \", \"]\"), TokenType.Structured,\r\n        Map(\"structure_type\" -> \"sequence\", \"item_count\" -> seq.length))\r\n    case map: Map[_, _] =>\r\n      val pairs = map.map { case (k, v) => s\"${tokenize(k).value}: ${tokenize(v).value}\" }\r\n      Token(pairs.mkString(\"{\", \", \", \"}\"), TokenType.Structured,\r\n        Map(\"structure_type\" -> \"mapping\", \"key_count\" -> map.size))\r\n    case t: Tokenizable => Token(t.toToken, TokenType.String, Map(\"source\" -> \"tokenizable\"))\r\n    case other => Token(other.toString, TokenType.String,\r\n        Map(\"fallback\" -> true, \"original_type\" -> other.getClass.getSimpleName))\r\n  }\r\n}\r\n\r\nclass WhitespaceTokenizer(\r\n  lowercase: Boolean = false,\r\n  minLength: Int = 0,\r\n  maxLength: Option[Int] = None,\r\n  stripPunctuation: Boolean = false\r\n) {\r\n  private val punctuation: Set[Char] = \".,!?;:'\\\"()[]{}\".toSet\r\n\r\n  private def processToken(word: String): Option[String] = {\r\n"]
[128.647221, "o", "    var processed = word\r\n    if (stripPunctuation) {\r\n      processed = processed.dropWhile(punctuation).reverse.dropWhile(punctuation).reverse\r\n    }\r\n    if (lowercase) processed = processed.toLowerCase\r\n    if (processed.length < minLength) return None\r\n    processed = maxLength.filter(_ < processed.length).fold(processed)(processed.take)\r\n    if (processed.isEmpty) None else Some(processed)\r\n  }\r\n\r\n  def tokenize(text: String): List[Token] = {\r\n    text.split(\"\\\\s+\").filter(_.nonEmpty).zipWithIndex.flatMap { case (word, i) =>\r\n      processToken(word).map { processed =>\r\n        Token(processed, TokenType.String, Map(\"position\" -> i, \"original\" -> word))\r\n      }\r\n    }.toList\r\n  }\r\n\r\n  def tokenizeToStrings(text: String): List[String] = tokenize(text).map(_.value)\r\n\r\n  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\r\n    val result = mutable.ListBuffer[(String, Int, Int)]()\r\n    var currentPos = 0\r\n    for (word <- text.split(\"\\\\s+\").filter(_.nonEmpty)) {\r\n      val start = text.indexOf(word, currentPos)\r\n      val end = start + word.length\r\n      processToken(word).foreach(p => result += ((p, start, end)))\r\n      currentPos = end\r\n    }\r\n    result.toList\r\n  }\r\n\r\n  def countTokens(text: String): Int = tokenize(text).length\r\n}\r\n\r\n// ============================================================================\r\n// Builder Pattern with Fluent Interface\r\n// ============================================================================\r\n\r\nclass TokenizerBuilder[T] {\r\n  private val normalizers: mutable.ListBuffer[String => String] = mutable.ListBuffer.empty\r\n  private val validators: mutable.ListBuffer[T => Boolean] = mutable.ListBuffer.empty\r\n  private var _metadata: Map[String, Any] = Map.empty\r\n\r\n  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\r\n    normalizers += normalizer\r\n"]
[128.64727, "o", "    this\r\n  }\r\n\r\n  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {\r\n    validators += validator\r\n    this\r\n  }\r\n\r\n  def withMetadata(entries: (String, Any)*): TokenizerBuilder[T] = {\r\n    _metadata = _metadata ++ entries.toMap\r\n    this\r\n  }\r\n\r\n  def build(): T => Token = { value: T =>\r\n    validators.foreach { validator =>\r\n      if (!validator(value)) {\r\n        throw new IllegalArgumentException(s\"Validation failed for $value\")\r\n      }\r\n    }\r\n\r\n    var strValue = value.toString\r\n    normalizers.foreach { normalizer =>\r\n      strValue = normalizer(strValue)\r\n    }\r\n\r\n    Token(strValue, TokenType.String, _metadata)\r\n  }\r\n}\r\n"]
