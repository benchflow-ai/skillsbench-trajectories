[180.796196, "o", "  \u001b[01;31m\u001b[Kdef withMetadata\u001b[m\u001b[K(entries: (String, Any)*): Token =\r\n  \u001b[01;31m\u001b[Kdef tokenize\u001b[m\u001b[K(value: T): Token\r\n  \u001b[01;31m\u001b[Kdef tokenizeBatch\u001b[m\u001b[K(values: Iterable[T]): List[Token] =\r\n  override \u001b[01;31m\u001b[Kdef tokenize\u001b[m\u001b[K(value: String): Token = {\r\n  override \u001b[01;31m\u001b[Kdef tokenize\u001b[m\u001b[K(value: BigDecimal): Token = {\r\n  \u001b[01;31m\u001b[Kdef tokenize\u001b[m\u001b[KInt(value: Int): Token = tokenize(BigDecimal(value))"]
