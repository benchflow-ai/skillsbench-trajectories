[?2004l/**
 * Tokenizer module for converting various input types to standardized string tokens.
 *
 * This module demonstrates Scala's type system with:
 * - Sealed traits and case classes for ADTs
 * - Variance annotations for generic types
 * - Option/Either/Try for error handling
 * - Traits for structural typing and abstraction
 */

import java.time.{LocalDate, LocalDateTime}
import java.time.format.DateTimeFormatter
import scala.collection.mutable
import scala.util.{Try, Success, Failure}

// ============================================================================
// Enums and Constants
// ============================================================================

sealed trait TokenType {
  def value: String
}

object TokenType {
  case object String extends TokenType { val value = "string" }
  case object Numeric extends TokenType { val value = "numeric" }
  case object Temporal extends TokenType { val value = "temporal" }
  case object Structured extends TokenType { val value = "structured" }
  case object Binary extends TokenType { val value = "binary" }
  case object Null extends TokenType { val value = "null" }
}

// ============================================================================
// Protocol definitions (structural typing via traits)
// ============================================================================

trait Tokenizable {
  def toToken: String
}

trait HasLength {
  def length: Int
}

trait TokenProcessor[-T] {
  def process(item: T): Unit
}

// ============================================================================
// Core Token Classes
// ============================================================================

final case class Token(
  value: String,
  tokenType: TokenType,
  metadata: Map[String, Any] = Map.empty
) {
  def withMetadata(entries: (String, Any)*): Token =
    copy(metadata = metadata ++ entries.toMap)
}

final class MutableTokenBatch {
  private val _tokens: mutable.ListBuffer[Token] = mutable.ListBuffer.empty
  private var _processed: Boolean = false

  def tokens: List[Token] = _tokens.toList

  def add(token: Token): Unit = {
    if (_processed) throw new RuntimeException("Batch already processed")
    _tokens += token
  }

  def markProcessed(): Unit = { _processed = true }
  def isProcessed: Boolean = _processed
}

// ============================================================================
// Generic Container Classes
// ============================================================================

class TokenContainer[+T](items: Seq[T]) {
  private val _items: Vector[T] = items.toVector
  def getAll: Vector[T] = _items
  def mapTokens(func: T => String): List[String] = _items.map(func).toList
}

class TokenSink[-T] {
  private val _received: mutable.ListBuffer[Any] = mutable.ListBuffer.empty
  def receive(item: T): Unit = { _received += item }
  def drain(): List[Any] = {
    val result = _received.toList
    _received.clear()
    result
  }
}

class BivariantHandler[T](private var _value: T) {
  def get: T = _value
  def set(value: T): Unit = { _value = value }
  def transform(func: T => T): T = { _value = func(_value); _value }
}

// ============================================================================
// Tokenizer Implementations
// ============================================================================

trait BaseTokenizer[T] {
  def tokenize(value: T): Token

  def tokenizeBatch(values: Iterable[T]): List[Token] =
    values.map(tokenize).toList
}

class StringTokenizer(
  lowercase: Boolean = false,
  stripWhitespace: Boolean = true,
  maxLength: Option[Int] = None
) extends BaseTokenizer[String] {

  override def tokenize(value: String): Token = {
    var processed = value
    if (stripWhitespace) processed = processed.trim
    if (lowercase) processed = processed.toLowerCase
    processed = maxLength.filter(_ < processed.length).fold(processed)(processed.take)

    Token(
      value = processed,
      tokenType = TokenType.String,
      metadata = Map(
        "original_length" -> value.length,
        "processed_length" -> processed.length
      )
    )
  }
}

class NumericTokenizer(
  precision: Int = 2,
  useScientificNotation: Boolean = false
) extends BaseTokenizer[BigDecimal] {

  override def tokenize(value: BigDecimal): Token = {
    val formatted = if (useScientificNotation) {
      s"%.${precision}E".format(value.doubleValue)
    } else {
      value.setScale(precision, BigDecimal.RoundingMode.HALF_UP).toString
    }

    Token(
      value = formatted,
      tokenType = TokenType.Numeric,
      metadata = Map(
        "original_value" -> value,
        "precision" -> precision,
        "is_integer" -> value.isWhole
      )
    )
  }

  def tokenizeInt(value: Int): Token = tokenize(BigDecimal(value))
  def tokenizeDouble(value: Double): Token = tokenize(BigDecimal(value))
}

class TemporalTokenizer(
  dateFormat: String = "yyyy-MM-dd",
  datetimeFormat: String = "yyyy-MM-dd'T'HH:mm:ss",
  includeTimezone: Boolean = false
) extends BaseTokenizer[Either[LocalDate, LocalDateTime]] {

  private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)
  private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)

  override def tokenize(value: Either[LocalDate, LocalDateTime]): Token = value match {
    case Left(date) =>
      Token(
        value = date.format(dateFormatter),
        tokenType = TokenType.Temporal,
        metadata = Map(
          "temporal_type" -> "date",
          "year" -> date.getYear,
          "month" -> date.getMonthValue,
          "day" -> date.getDayOfMonth
        )
      )
    case Right(datetime) =>
      Token(
        value = datetime.format(datetimeFormatter),
        tokenType = TokenType.Temporal,
        metadata = Map(
          "temporal_type" -> "datetime",
          "year" -> datetime.getYear,
          "month" -> datetime.getMonthValue,
          "day" -> datetime.getDayOfMonth,
          "hour" -> datetime.getHour,
          "minute" -> datetime.getMinute,
          "second" -> datetime.getSecond
        )
      )
  }

  def tokenizeDate(date: LocalDate): Token = tokenize(Left(date))
  def tokenizeDateTime(datetime: LocalDateTime): Token = tokenize(Right(datetime))
}

class UniversalTokenizer extends BaseTokenizer[Any] {
  private val stringTokenizer = new StringTokenizer()
  private val numericTokenizer = new NumericTokenizer()
  private val temporalTokenizer = new TemporalTokenizer()

  override def tokenize(value: Any): Token = value match {
    case null => Token(value = "null", tokenType = TokenType.Null)
    case None => Token(value = "null", tokenType = TokenType.Null)
    case Some(inner) => tokenize(inner)
    case s: String => stringTokenizer.tokenize(s)
    case b: Boolean => Token(b.toString, TokenType.String, Map("boolean_value" -> b))
    case i: Int => numericTokenizer.tokenizeInt(i)
    case l: Long => numericTokenizer.tokenize(BigDecimal(l))
    case f: Float => numericTokenizer.tokenize(BigDecimal(f.toDouble))
    case d: Double => numericTokenizer.tokenizeDouble(d)
    case bd: BigDecimal => numericTokenizer.tokenize(bd)
    case bi: BigInt => numericTokenizer.tokenize(BigDecimal(bi))
    case date: LocalDate => temporalTokenizer.tokenizeDate(date)
    case datetime: LocalDateTime => temporalTokenizer.tokenizeDateTime(datetime)
    case bytes: Array[Byte] =>
      Token(
        value = bytes.map("%02x".format(_)).mkString,
        tokenType = TokenType.Binary,
        metadata = Map("byte_length" -> bytes.length)
      )
    case seq: Seq[_] =>
      val items = seq.map(item => tokenize(item).value)
      Token(items.mkString("[", ", ", "]"), TokenType.Structured,
        Map("structure_type" -> "sequence", "item_count" -> seq.length))
    case map: Map[_, _] =>
      val pairs = map.map { case (k, v) => s"${tokenize(k).value}: ${tokenize(v).value}" }
      Token(pairs.mkString("{", ", ", "}"), TokenType.Structured,
        Map("structure_type" -> "mapping", "key_count" -> map.size))
    case t: Tokenizable => Token(t.toToken, TokenType.String, Map("source" -> "tokenizable"))
    case other => Token(other.toString, TokenType.String,
        Map("fallback" -> true, "original_type" -> other.getClass.getSimpleName))
  }
}

class WhitespaceTokenizer(
  lowercase: Boolean = false,
  minLength: Int = 0,
  maxLength: Option[Int] = None,
  stripPunctuation: Boolean = false
) {
  private val punctuation: Set[Char] = ".,!?;:'\"()[]{}".toSet

  private def processToken(word: String): Option[String] = {
    var processed = word
    if (stripPunctuation) {
      processed = processed.dropWhile(punctuation).reverse.dropWhile(punctuation).reverse
    }
    if (lowercase) processed = processed.toLowerCase
    if (processed.length < minLength) return None
    processed = maxLength.filter(_ < processed.length).fold(processed)(processed.take)
    if (processed.isEmpty) None else Some(processed)
  }

  def tokenize(text: String): List[Token] = {
    text.split("\\s+").filter(_.nonEmpty).zipWithIndex.flatMap { case (word, i) =>
      processToken(word).map { processed =>
        Token(processed, TokenType.String, Map("position" -> i, "original" -> word))
      }
    }.toList
  }

  def tokenizeToStrings(text: String): List[String] = tokenize(text).map(_.value)

  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {
    val result = mutable.ListBuffer[(String, Int, Int)]()
    var currentPos = 0
    for (word <- text.split("\\s+").filter(_.nonEmpty)) {
      val start = text.indexOf(word, currentPos)
      val end = start + word.length
      processToken(word).foreach(p => result += ((p, start, end)))
      currentPos = end
    }
    result.toList
  }

  def countTokens(text: String): Int = tokenize(text).length
}

// ============================================================================
// Builder Pattern with Fluent Interface
// ============================================================================

class TokenizerBuilder[T] {
  private val normalizers: mutable.ListBuffer[String => String] = mutable.ListBuffer.empty
  private val validators: mutable.ListBuffer[T => Boolean] = mutable.ListBuffer.empty
  private var _metadata: Map[String, Any] = Map.empty

  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {
    normalizers += normalizer
    this
  }

  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {
    validators += validator
    this
  }

  def withMetadata(entries: (String, Any)*): TokenizerBuilder[T] = {
    _metadata = _metadata ++ entries.toMap
    this
  }

  def build(): T => Token = { value: T =>
    validators.foreach { validator =>
      if (!validator(value)) {
        throw new IllegalArgumentException(s"Validation failed for $value")
      }
    }

    var strValue = value.toString
    normalizers.foreach { normalizer =>
      strValue = normalizer(strValue)
    }

    Token(strValue, TokenType.String, _metadata)
  }
}
