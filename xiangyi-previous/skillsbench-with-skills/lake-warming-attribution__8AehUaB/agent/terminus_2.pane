[?2004hroot@e2e6e3209338:~# cat <<EOF > analyze.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> from sklearn.ensemble import RandomForestRegressor
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> water_temp = pd.read_csv('/root/data/water_temperature.csv')
[?2004l[?2004h> climate = pd.read_csv('/root/data/climate.csv')
[?2004l[?2004h> land = pd.read_csv('/root/data/land_cover.csv')
[?2004l[?2004h> hydro = pd.read_csv('/root/data/hydrology.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge data
[?2004l[?2004h> df = water_temp.merge(climate, on='Year').merge(land, on='Year').merge(hydro, on='Year')
[?2004l[?2004h> 
[?2004l[?2004h> # Task 1: Trend Analysis
[?2004l[?2004h> slope, intercept, r_value, p_value, std_err = linregress(df['Year'], df['WaterTemperature'])
[?2004l[?2004h> trend_res = pd.DataFrame({'slope': [slope], 'p-value': [p_value]})
[?2004l[?2004h> trend_res.to_csv('/root/output/trend_result.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Task 2: Dominant Factor
[?2004l[?2004h> # Define categories
[?2004l[?2004h> categories = {
[?2004l[?2004h>     'Heat': ['AirTempLake', 'Shortwave', 'Longwave'],
[?2004l[?2004h>     'Flow': ['Precip', 'Outflow', 'Inflow'],
[?2004l[?2004h>     'Wind': ['WindSpeedLake'],
[?2004l[?2004h>     'Human': ['DevelopedArea', 'AgricultureArea']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> features = []
[?2004l[?2004h> for cats in categories.values():
[?2004l[?2004h>     features.extend(cats)
[?2004l[?2004h> 
[?2004l[?2004h> X = df[features]
[?2004l[?2004h> y = df['WaterTemperature']
[?2004l[?2004h> 
[?2004l[?2004h> # Use Random Forest for feature importance
[?2004l[?2004h> rf = RandomForestRegressor(n_estimators=100, random_state=42)
[?2004l[?2004h> rf.fit(X, y)
[?2004l[?2004h> 
[?2004l[?2004h> importances = rf.feature_importances_
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate by category
[?2004l[?2004h> cat_importance = {k: 0.0 for k in categories.keys()}
[?2004l[?2004h> for feature, importance in zip(features, importances):
[?2004l[?2004h>     for cat, cat_features in categories.items():
[?2004l[?2004h>         if feature in cat_features:
[?2004l[?2004h>             cat_importance[cat] += importance
[?2004l[?2004h> 
[?2004l[?2004h> # Find dominant category
[?2004l[?2004h> best_cat = max(cat_importance, key=cat_importance.get)
[?2004l[?2004h> best_val = cat_importance[best_cat]
[?2004l[?2004h> 
[?2004l[?2004h> # Output
[?2004l[?2004h> dom_res = pd.DataFrame({'variable': [best_cat], 'contribution': [best_val]})
[?2004l[?2004h> dom_res.to_csv('/root/output/dominant_factor.csv', index=False)
[?2004l[?2004h> print('Analysis complete.')
[?2004l[?2004h> EOF
[?2004l[?2004hroot@e2e6e3209338:~# python3 analyze.py
[?2004lAnalysis complete.
