[?2004hroot@07f0e82f5476:~# python3 - <<'PY'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> wb=openpyxl.load_workbook('protein_expression.xlsx')
[?2004l[?2004h> ws=wb['Task']
[?2004l[?2004h> # Step 1: lookup formulas C11:L20
[?2004l[?2004h> for r in range(11,21):
[?2004l[?2004h>     for c in range(3,13):
[?2004l[?2004h>         col_letter = get_column_letter(c)
[?2004l[?2004h>         formula = f"=INDEX(Data!$A:$BA, MATCH($A{r}, Data!$A:$A, 0), MATCH({col_letter}$10, Data!$1:$1, 0))"
[?2004l[?2004h>         ws.cell(r,c).value = formula
[?2004l[?2004h> # Step 2: statistics formulas B24:K27
[?2004l[?2004h> control_mean = "=AVERAGEIF($C$9:$L$9,\"Control\",INDEX($C$11:$L$20, COLUMN()-1,0))"
[?2004l[?2004h> control_std = "=STDEV.S(FILTER(INDEX($C$11:$L$20, COLUMN()-1,0),$C$9:$L$9=\"Control\"))"
[?2004l[?2004h> treated_mean = "=AVERAGEIF($C$9:$L$9,\"Treated\",INDEX($C$11:$L$20, COLUMN()-1,0))"
[?2004l[?2004h> treated_std = "=STDEV.S(FILTER(INDEX($C$11:$L$20, COLUMN()-1,0),$C$9:$L$9=\"Treated\"))"
[?2004l[?2004h> for c in range(2,12):  # B-K
[?2004l[?2004h>     ws.cell(24,c).value = control_mean
[?2004l[?2004h>     ws.cell(25,c).value = control_std
[?2004l[?2004h>     ws.cell(26,c).value = treated_mean
[?2004l[?2004h>     ws.cell(27,c).value = treated_std
[?2004l[?2004h> # Step 3: fold change rows 32-41
[?2004l[?2004h> for r in range(32,42):
[?2004l[?2004h>     ws.cell(r,1).value = "=INDEX($A$11:$A$20, ROW()-31)"
[?2004l[?2004h>     ws.cell(r,2).value = "=INDEX($B$11:$B$20, ROW()-31)"
[?2004l[?2004h>     ws.cell(r,4).value = "=INDEX($B$26:$K$26, ROW()-31)-INDEX($B$24:$K$24, ROW()-31)"
[?2004l[?2004h>     ws.cell(r,3).value = f"=2^D{r}"
[?2004l[?2004h> wb.save('protein_expression.xlsx')
[?2004l[?2004h> PY
[?2004l[?2004hroot@07f0e82f5476:~# python3 - <<'PY'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> wb=openpyxl.load_workbook('protein_expression.xlsx')
[?2004l[?2004h> ws=wb['Task']
[?2004l[?2004h> for r in range(32,42):
[?2004l[?2004h>     ws.cell(r,4).value = "=INDEX($B$26:$K$26,1,ROW()-31)-INDEX($B$24:$K$24,1,ROW()-31)"
[?2004l[?2004h>     ws.cell(r,3).value = f"=2^D{r}"
