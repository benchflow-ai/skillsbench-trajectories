[167.454949, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('protein_expression.xlsx')\nws=wb['Task']\n# Step 1: lookup formulas C11:L20\nfor r in range(11,21):\n    for c in range(3,13):\n        col_letter = get_column_letter(c)\n        formula = f\"=INDEX(Data!$A:$BA, MATCH($A{r}, Data!$A:$A, 0), MATCH({col_letter}$10, Data!$1:$1, 0))\"\n        ws.cell(r,c).value = formula\n# Step 2: statistics formulas B24:K27\ncontrol_mean = \"=AVERAGEIF($C$9:$L$9,\\\"Control\\\",INDEX($C$11:$L$20, COLUMN()-1,0))\"\ncontrol_std = \"=STDEV.S(FILTER(INDEX($C$11:$L$20, COLUMN()-1,0),$C$9:$L$9=\\\"Control\\\"))\"\ntreated_mean = \"=AVERAGEIF($C$9:$L$9,\\\"Treated\\\",INDEX($C$11:$L$20, COLUMN()-1,0))\"\ntreated_std = \"=STDEV.S(FILTER(INDEX($C$11:$L$20, COLUMN()-1,0),$C$9:$L$9=\\\"Treated\\\"))\"\nfor c in range(2,12):  # B-K\n    ws.cell(24,c).value = control_mean\n    ws.cell(25,c).value = control_std\n    ws.cell(26,c).value = treated_mean\n    ws.cell(27,c).value = treated_std\n# Step 3: fold change rows 32-41\nfor r in range(32,42):\n    ws.cell(r,1).value = \"=INDEX($A$11:$A$20, ROW()-31)\"\n    ws.cell(r,2).value = \"=INDEX($B$11:$B$20, ROW()-31)\"\n    ws.cell(r,4).value = \"=INDEX($B$26:$K$26, ROW()-31)-INDEX($B$24:$K$24, ROW()-31)\"\n    ws.cell(r,3).value = f\"=2^D{r}\"\nwb.save('protein_expression.xlsx')\nPY\n"]
