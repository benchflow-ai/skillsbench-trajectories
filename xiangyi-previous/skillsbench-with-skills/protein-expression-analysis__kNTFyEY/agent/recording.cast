[12.611221, "i", "python3 - <<'PY'\nimport openpyxl, pandas as pd\nwb=openpyxl.load_workbook('protein_expression.xlsx')\nprint(wb.sheetnames)\nws=wb['Task']\n# print some cells around rows 8-12 and columns A-L\nfor r in range(8,13):\n    row=[ws.cell(r,c).value for c in range(1,13)]\n    print(r,row)\nprint('Task row 20-25')\nfor r in range(20,28):\n    row=[ws.cell(r,c).value for c in range(1,13)]\n    print(r,row)\nprint('Task row 30-42')\nfor r in range(30,42):\n    row=[ws.cell(r,c).value for c in range(1,6)]\n    print(r,row)\nwsd=wb['Data']\nprint('Data row 9-12 cols A-L')\nfor r in range(9,13):\n    row=[wsd.cell(r,c).value for c in range(1,13)]\n    print(r,row)\nPY\n"]
