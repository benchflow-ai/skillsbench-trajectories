[252.494769, "o", "C11 =INDEX(Data!$A:$BA, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))\r\nB24 =AVERAGEIF($C$9:$L$9,\"Control\",INDEX($C$11:$L$20, COLUMN()-1,0))\r\nB25 =STDEV.S(FILTER(INDEX($C$11:$L$20, COLUMN()-1,0),$C$9:$L$9=\"Control\"))\r\nD32 =INDEX($B$26:$K$26,1,ROW()-31)-INDEX($B$24:$K$24,1,ROW()-31)\r\nC32 =2^D32\r\n"]
