[?2004l[?2004h> g = 2/np.sqrt(N)
[?2004l[?2004h> 
[?2004l[?2004h> kappa = 1.0
[?2004l[?2004h> nmax = 16  # cavity dimension
[?2004l[?2004h> 
[?2004l[?2004h> # Operators
[?2004l[?2004h> I_cav = qt.qeye(nmax)
[?2004l[?2004h> I_qubits = [qt.qeye(2) for _ in range(N)]
[?2004l[?2004h> 
[?2004l[?2004h> a = qt.tensor(qt.destroy(nmax), *I_qubits)
[?2004l[?2004h> 
[?2004l[?2004h> sigmap = qt.sigmap()
[?2004l[?2004h> sigmam = qt.sigmam()
[?2004l[?2004h> sigmaz = qt.sigmaz()
[?2004l[?2004h> 
[?2004l[?2004h> # helper to place operator on qubit i
[?2004l[?2004h> 
[?2004l[?2004h> def op_on_qubit(op, i):
[?2004l[?2004h>     ops = [qt.qeye(2) for _ in range(N)]
[?2004l[?2004h>     ops[i] = op
[?2004l[?2004h>     return qt.tensor(I_cav, *ops)
[?2004l[?2004h> 
[?2004l[?2004h> Jp = sum(op_on_qubit(sigmap, i) for i in range(N))
[?2004l[?2004h> Jm = sum(op_on_qubit(sigmam, i) for i in range(N))
[?2004l[?2004h> Jz = 0.5*sum(op_on_qubit(sigmaz, i) for i in range(N))
[?2004l[?2004h> 
[?2004l[?2004h> # Hamiltonian
[?2004l[?2004h> H = w0*Jz + wc*a.dag()*a + g*(a.dag()+a)*(Jp + Jm)
[?2004l[?2004h> 
[?2004l[?2004h> # Wigner grid
[?2004l[?2004h> xvec = np.linspace(-6, 6, 1000)
[?2004l[?2004h> pvec = np.linspace(-6, 6, 1000)
[?2004l[?2004h> 
[?2004l[?2004h> # Define cases
[?2004l[?2004h> cases = {
[?2004l[?2004h>     1: dict(gamma_phi=0.01, gamma_up=0.1, gamma_down=0.0, gamma_U=0.0, gamma_D=0.0),
[?2004l[?2004h>     2: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.0, gamma_D=0.0),
[?2004l[?2004h>     3: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.1, gamma_D=0.0),
[?2004l[?2004h>     4: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.0, gamma_D=0.1),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> for idx, params in cases.items():
[?2004l[?2004h>     print(f"Processing case {idx}...")
[?2004l[?2004h>     c_ops = [np.sqrt(kappa) * a]
[?2004l[?2004h>     # local dephasing
[?2004l[?2004h>     if params['gamma_phi'] > 0:
[?2004l[?2004h>         for i in range(N):
[?2004l[?2004h>             c_ops.append(np.sqrt(params['gamma_phi']) * op_on_qubit(sigmaz, i))
[?2004l[?2004h>     # local pumping
[?2004l[?2004h>     if params['gamma_up'] > 0:
[?2004l[?2004h>         for i in range(N):
[?2004l[?2004h>             c_ops.append(np.sqrt(params['gamma_up']) * op_on_qubit(sigmap, i))
[?2004l[?2004h>     # local emission
[?2004l[?2004h>     if params['gamma_down'] > 0:
[?2004l[?2004h>         for i in range(N):
[?2004l[?2004h>             c_ops.append(np.sqrt(params['gamma_down']) * op_on_qubit(sigmam, i))
[?2004l[?2004h>     # collective pumping
[?2004l[?2004h>     if params['gamma_U'] > 0:
[?2004l[?2004h>         c_ops.append(np.sqrt(params['gamma_U']) * Jp)
[?2004l[?2004h>     # collective emission
[?2004l[?2004h>     if params['gamma_D'] > 0:
[?2004l[?2004h>         c_ops.append(np.sqrt(params['gamma_D']) * Jm)
[?2004l[?2004h> 
[?2004l[?2004h>     # steady state
[?2004l[?2004h>     rho_ss = qt.steadystate(H, c_ops, method='direct')
[?2004l[?2004h>     # trace out spins to get cavity state
