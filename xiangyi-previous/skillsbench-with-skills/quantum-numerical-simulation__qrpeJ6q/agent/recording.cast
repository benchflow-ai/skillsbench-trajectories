[19.067266, "i", "python3 - <<'PY'\nimport importlib.util, sys\nprint('qutip available:', importlib.util.find_spec('qutip') is not None)\nPY\n"]
[19.067536, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[19.067681, "o", "> import importlib.util, sys\r\n\u001b[?2004l\r"]
[19.067804, "o", "\u001b[?2004h> print('qutip available:', importlib.util.find_spec('qutip') is not None)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[19.082719, "o", "qutip available: True\r\n"]
[19.085107, "o", "\u001b[?2004hroot@ade926119094:~# "]
[67.126326, "i", "python3 - <<'PY'\nimport numpy as np\nimport qutip as qt\n\n# Parameters\nN = 4\nw0 = 1.0\nwc = 1.0\ng = 2/np.sqrt(N)\n\nkappa = 1.0\nnmax = 16  # cavity dimension\n\n# Operators\nI_cav = qt.qeye(nmax)\nI_qubits = [qt.qeye(2) for _ in range(N)]\n\na = qt.tensor(qt.destroy(nmax), *I_qubits)\n\nsigmap = qt.sigmap()\nsigmam = qt.sigmam()\nsigmaz = qt.sigmaz()\n\n# helper to place operator on qubit i\n\ndef op_on_qubit(op, i):\n    ops = [qt.qeye(2) for _ in range(N)]\n    ops[i] = op\n    return qt.tensor(I_cav, *ops)\n\nJp = sum(op_on_qubit(sigmap, i) for i in range(N))\nJm = sum(op_on_qubit(sigmam, i) for i in range(N))\nJz = 0.5*sum(op_on_qubit(sigmaz, i) for i in range(N))\n\n# Hamiltonian\nH = w0*Jz + wc*a.dag()*a + g*(a.dag()+a)*(Jp + Jm)\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# Define cases\ncases = {\n    1: dict(gamma_phi=0.01, gamma_up=0.1, gamma_down=0.0, gamma_U=0.0, gamma_D=0.0),\n    2: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.0, gamma_D=0.0),\n    3: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.1, gamma_D=0.0),\n    4: dict(gamma_phi=0.01, gamma_up=0.0, gamma_down=0.1, gamma_U=0.0, gamma_D=0.1),\n}\n\nfor idx, params in cases.items():\n    print(f\"Processing case {idx}...\")\n    c_ops = [np.sqrt(kappa) * a]\n    # local dephasing\n    if params['gamma_phi'] > 0:\n        for i in range(N):\n            c_ops.append(np.sqrt(params['gamma_phi']) * op_on_qubit(sigmaz, i))\n    # local pumping\n    if params['gamma_up'] > 0:\n        for i in range(N):\n            c_ops.append(np.sqrt(params['gamma_up']) * op_on_qubit(sigmap, i))\n    # local emission\n    if params['gamma_down'] > 0:\n        for i in range(N):\n            c_ops.append(np.sqrt(params['gamma_down']) * op_on_qubit(sigmam, i))\n    # collective pumping\n    if params['gamma_U'] > 0:\n        c_ops.append(np.sqrt(params['gamma_U']) * Jp)\n    # collective emission\n    if params['gamma_D'] > 0:\n        c_ops.append(np.sqrt(params['gamma_D']) * Jm)\n\n    # steady state\n    rho_ss = qt.steadystate(H, c_ops, method='direct')\n    # trace out spins to get cavity state\n    rho_cav = qt.ptrace(rho_ss, 0)\n    # Wigner function\n    W = qt.wigner(rho_cav, xvec, pvec)\n    # Save to CSV\n    np.savetxt(f\"{idx}.csv\", W, delimiter=\",\")\n    print(f\"Saved {idx}.csv\")\n\nprint(\"All cases completed.\")\nPY\n"]
