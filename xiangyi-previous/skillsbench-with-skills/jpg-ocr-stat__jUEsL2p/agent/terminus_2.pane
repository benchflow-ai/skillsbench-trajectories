[?2004l[?2004h> import pytesseract
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> import re
[?2004l[?2004h> import os
[?2004l[?2004h> from openpyxl import Workbook
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> 
[?2004l[?2004h> # OCR function to extract text from image
[?2004l[?2004h> def extract_text_from_image(image_path):
[?2004l[?2004h>     try:
[?2004l[?2004h>         img = Image.open(image_path)
[?2004l[?2004h>         text = pytesseract.image_to_string(img)
[?2004l[?2004h>         return text
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error processing {image_path}: {e}")
[?2004l[?2004h>         return ""
[?2004l[?2004h> 
[?2004l[?2004h> # Extract date in YYYY-MM-DD format
[?2004l[?2004h> def extract_date(text):
[?2004l[?2004h>     # Look for common date patterns
[?2004l[?2004h>     # Try DD/MM/YYYY format
[?2004l[?2004h>     date_patterns = [
[?2004l[?2004h>         r'(\d{4})[/-](\d{1,2})[/-](\d{1,2})',  # YYYY-MM-DD or YYYY/MM/DD
[?2004l[?2004h>         r'(\d{1,2})[/-](\d{1,2})[/-](\d{4})',  # DD-MM-YYYY or MM-DD-YYYY
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for pattern in date_patterns:
[?2004l[?2004h>         matches = re.findall(pattern, text)
[?2004l[?2004h>         if matches:
[?2004l[?2004h>             for match in matches:
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     # Try YYYY-MM-DD format first
[?2004l[?2004h>                     if len(match[0]) == 4:
[?2004l[?2004h>                         year, month, day = match
[?2004l[?2004h>                         date_obj = datetime.strptime(f"{year}-{month}-{day}", "%Y-%m-%d")
[?2004l[?2004h>                         return date_obj.strftime("%Y-%m-%d")
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         # Try DD-MM-YYYY format
[?2004l[?2004h>                         day, month, year = match
[?2004l[?2004h>                         date_obj = datetime.strptime(f"{year}-{month}-{day}", "%Y-%m-%d")
[?2004l[?2004h>                         return date_obj.strftime("%Y-%m-%d")
[?2004l[?2004h>                 except ValueError:
[?2004l[?2004h>                     continue
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # Extract total amount
[?2004l[?2004h> def extract_total_amount(text):
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     
[?2004l[?2004h>     # Exclusion keywords
[?2004l[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority keywords
[?2004l[?2004h>     priority_keywords = [
[?2004l[?2004h>         ['GRAND TOTAL'],
[?2004l[?2004h>         ['TOTAL RM', 'TOTAL: RM'],
[?2004l[?2004h>         ['TOTAL AMOUNT'],
[?2004l[?2004h>         ['TOTAL', 'AMOUNT', 'TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL']
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for priority_level in priority_keywords:
[?2004l[?2004h>         for line_idx, line in enumerate(lines):
[?2004l[?2004h>             # Check if any exclusion keyword is in the line
[?2004l[?2004h>             if any(excl in line.upper() for excl in exclusion_keywords):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Check if any priority keyword is in the line
[?2004l[?2004h>             if any(keyword in line.upper() for keyword in priority_level):
[?2004l[?2004h>                 # Try to extract number from the same line
[?2004l[?2004h>                 amount_match = re.search(r'([0-9,]+\.\d{2})', line)
[?2004l[?2004h>                 if amount_match:
[?2004l[?2004h>                     amount_str = amount_match.group(1).replace(',', '')
[?2004l[?2004h>                     return amount_str
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Try next line as fallback
[?2004l[?2004h>                 if line_idx + 1 < len(lines):
[?2004l[?2004h>                     next_line = lines[line_idx + 1]
[?2004l[?2004h>                     amount_match = re.search(r'([0-9,]+\.\d{2})', next_line)
[?2004l[?2004h>                     if amount_match:
[?2004l[?2004h>                         amount_str = amount_match.group(1).replace(',', '')
[?2004l[?2004h>                         return amount_str
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # Main processing
[?2004l[?2004h> def process_receipts():
[?2004l[?2004h>     img_dir = '/app/workspace/dataset/img'
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Get all JPG files
[?2004l[?2004h>     jpg_files = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])
[?2004l[?2004h>     
[?2004l[?2004h>     for filename in jpg_files:
[?2004l[?2004h>         image_path = os.path.join(img_dir, filename)
[?2004l[?2004h>         print(f"Processing {filename}...")
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract text
[?2004l[?2004h>         text = extract_text_from_image(image_path)
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract date and amount
[?2004l[?2004h>         date = extract_date(text)
[?2004l[?2004h>         amount = extract_total_amount(text)
[?2004l[?2004h>         
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'filename': filename,
[?2004l[?2004h>             'date': date,
[?2004l[?2004h>             'total_amount': amount
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     # Write to Excel
[?2004l[?2004h>     wb = Workbook()
[?2004l[?2004h>     ws = wb.active
[?2004l[?2004h>     ws.title = 'results'
[?2004l[?2004h>     
[?2004l[?2004h>     # Add header
[?2004l[?2004h>     ws['A1'] = 'filename'
[?2004l[?2004h>     ws['B1'] = 'date'
[?2004l[?2004h>     ws['C1'] = 'total_amount'
[?2004l[?2004h>     
[?2004l[?2004h>     # Add data rows
[?2004l[?2004h>     for idx, result in enumerate(results, start=2):
[?2004l[?2004h>         ws[f'A{idx}'] = result['filename']
[?2004l[?2004h>         ws[f'B{idx}'] = result['date']
[?2004l[?2004h>         ws[f'C{idx}'] = result['total_amount']
[?2004l[?2004h>     
[?2004l[?2004h>     # Save workbook
[?2004l[?2004h>     wb.save('/app/workspace/stat_ocr.xlsx')
[?2004l[?2004h>     print("Excel file created: /app/workspace/stat_ocr.xlsx")
