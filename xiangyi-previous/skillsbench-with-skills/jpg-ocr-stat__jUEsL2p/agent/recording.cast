[22.018836, "i", "cat > /app/workspace/process_receipts.py << 'EOF'\nimport pytesseract\nfrom PIL import Image\nimport re\nimport os\nfrom openpyxl import Workbook\nfrom openpyxl.utils import get_column_letter\nfrom datetime import datetime\n\n# OCR function to extract text from image\ndef extract_text_from_image(image_path):\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        return text\n    except Exception as e:\n        print(f\"Error processing {image_path}: {e}\")\n        return \"\"\n\n# Extract date in YYYY-MM-DD format\ndef extract_date(text):\n    # Look for common date patterns\n    # Try DD/MM/YYYY format\n    date_patterns = [\n        r'(\\d{4})[/-](\\d{1,2})[/-](\\d{1,2})',  # YYYY-MM-DD or YYYY/MM/DD\n        r'(\\d{1,2})[/-](\\d{1,2})[/-](\\d{4})',  # DD-MM-YYYY or MM-DD-YYYY\n    ]\n    \n    for pattern in date_patterns:\n        matches = re.findall(pattern, text)\n        if matches:\n            for match in matches:\n                try:\n                    # Try YYYY-MM-DD format first\n                    if len(match[0]) == 4:\n                        year, month, day = match\n                        date_obj = datetime.strptime(f\"{year}-{month}-{day}\", \"%Y-%m-%d\")\n                        return date_obj.strftime(\"%Y-%m-%d\")\n                    else:\n                        # Try DD-MM-YYYY format\n                        day, month, year = match\n                        date_obj = datetime.strptime(f\"{year}-{month}-{day}\", \"%Y-%m-%d\")\n                        return date_obj.strftime(\"%Y-%m-%d\")\n                except ValueError:\n                    continue\n    \n    return None\n\n# Extract total amount\ndef extract_total_amount(text):\n    lines = text.split('\\n')\n    \n    # Exclusion keywords\n    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\n    \n    # Priority keywords\n    priority_keywords = [\n        ['GRAND TOTAL'],\n        ['TOTAL RM', 'TOTAL: RM'],\n        ['TOTAL AMOUNT'],\n        ['TOTAL', 'AMOUNT', 'TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL']\n    ]\n    \n    for priority_level in priority_keywords:\n        for line_idx, line in enumerate(lines):\n            # Check if any exclusion keyword is in the line\n            if any(excl in line.upper() for excl in exclusion_keywords):\n                continue\n            \n            # Check if any priority keyword is in the line\n            if any(keyword in line.upper() for keyword in priority_level):\n                # Try to extract number from the same line\n                amount_match = re.search(r'([0-9,]+\\.\\d{2})', line)\n                if amount_match:\n                    amount_str = amount_match.group(1).replace(',', '')\n                    return amount_str\n                \n                # Try next line as fallback\n                if line_idx + 1 < len(lines):\n                    next_line = lines[line_idx + 1]\n                    amount_match = re.search(r'([0-9,]+\\.\\d{2})', next_line)\n                    if amount_match:\n                        amount_str = amount_match.group(1).replace(',', '')\n                        return amount_str\n    \n    return None\n\n# Main processing\ndef process_receipts():\n    img_dir = '/app/workspace/dataset/img'\n    results = []\n    \n    # Get all JPG files\n    jpg_files = sorted([f for f in os.listdir(img_dir) if f.endswith('.jpg')])\n    \n    for filename in jpg_files:\n        image_path = os.path.join(img_dir, filename)\n        print(f\"Processing {filename}...\")\n        \n        # Extract text\n        text = extract_text_from_image(image_path)\n        \n        # Extract date and amount\n        date = extract_date(text)\n        amount = extract_total_amount(text)\n        \n        results.append({\n            'filename': filename,\n            'date': date,\n            'total_amount': amount\n        })\n    \n    # Write to Excel\n    wb = Workbook()\n    ws = wb.active\n    ws.title = 'results'\n    \n    # Add header\n    ws['A1'] = 'filename'\n    ws['B1'] = 'date'\n    ws['C1'] = 'total_amount'\n    \n    # Add data rows\n    for idx, re"]
[22.018901, "i", "sult in enumerate(results, start=2):\n        ws[f'A{idx}'] = result['filename']\n        ws[f'B{idx}'] = result['date']\n        ws[f'C{idx}'] = result['total_amount']\n    \n    # Save workbook\n    wb.save('/app/workspace/stat_ocr.xlsx')\n    print(\"Excel file created: /app/workspace/stat_ocr.xlsx\")\n\nif __name__ == '__main__':\n    process_receipts()\nEOF\n"]
[22.019641, "o", "cat > /app/workspace/process_receipts.py << 'EOF'\r\n"]
