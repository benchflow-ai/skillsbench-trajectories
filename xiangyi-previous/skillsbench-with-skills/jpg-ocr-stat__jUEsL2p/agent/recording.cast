[95.910689, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/app/workspace/stat_ocr.xlsx')\nprint(f\"Sheet names: {wb.sheetnames}\")\n\n# Get the active sheet\nws = wb.active\nprint(f\"Active sheet name: {ws.title}\")\n\n# Display header and first 10 rows\nprint(\"\\nFirst 11 rows of data:\")\nfor row_idx, row in enumerate(ws.iter_rows(max_row=11, values_only=True), 1):\n    print(f\"Row {row_idx}: {row}\")\n\n# Count total rows\nrow_count = ws.max_row\nprint(f\"\\nTotal rows (including header): {row_count}\")\nprint(f\"Total data rows: {row_count - 1}\")\n\n# Display last few rows\nprint(\"\\nLast 3 data rows:\")\nfor row_idx in range(max(2, row_count - 2), row_count + 1):\n    row_data = [ws.cell(row_idx, col).value for col in range(1, 4)]\n    print(f\"Row {row_idx}: {row_data}\")\nEOF\n"]
