[49.285451, "i", "cat > export_obj.mjs <<EOF\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from './data/object.js';\nimport fs from 'fs';\n\n// Create the scene\nconst sceneRoot = createScene();\n\n// Apply -90 degrees X-rotation to match Blender Z-up space\n// -90 degrees is -Math.PI / 2 radians\nsceneRoot.rotation.x = -Math.PI / 2;\nsceneRoot.updateMatrixWorld(true);\n\n// Export to OBJ\nconst exporter = new OBJExporter();\nconst result = exporter.parse(sceneRoot);\n\n// Write to file\nfs.writeFileSync('/root/output/object.obj', result);\nconsole.log('Export complete: /root/output/object.obj');\nEOF\n"]
[49.285703, "o", "cat > export_obj.mjs <<EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
