[153.49444, "i", "cat > /root/verify_pptx.py << 'ENDSCRIPT'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\n\nprs = Presentation('/root/Awesome-Agent-Papers_processed.pptx')\n\nprint(f\"Number of slides: {len(prs.slides)}\")\nprint(f\"Slide dimensions: {prs.slide_width.inches:.2f} x {prs.slide_height.inches:.2f} inches\")\nprint(\"=\"*80)\n\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"\\n=== Slide {slide_idx + 1} ===\")\n    for shape in slide.shapes:\n        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\n            print(f\"  TEXT_BOX: '{shape.name}'\")\n            print(f\"    Position: left={shape.left.inches:.2f}, top={shape.top.inches:.2f}\")\n            print(f\"    Size: width={shape.width.inches:.2f}, height={shape.height.inches:.2f}\")\n            if shape.has_text_frame:\n                for para in shape.text_frame.paragraphs:\n                    text = para.text.strip()\n                    if text:\n                        print(f\"    Text: '{text[:60]}{'...' if len(text) > 60 else ''}'\")\n                        print(f\"    Alignment: {para.alignment}\")\n                        for run in para.runs:\n                            print(f\"    Font: name={run.font.name}, size={run.font.size.pt if run.font.size else 'None'}pt\")\n                            print(f\"    Bold: {run.font.bold}\")\n                            if run.font.color and run.font.color.rgb:\n                                print(f\"    Color: #{run.font.color.rgb}\")\n        elif shape.has_text_frame:\n            for para in shape.text_frame.paragraphs:\n                text = para.text.strip()\n                if text:\n                    if 'title' in shape.name.lower() or (hasattr(shape, 'placeholder_format') and shape.placeholder_format):\n                        print(f\"  {shape.name}: '{text[:60]}{'...' if len(text) > 60 else ''}'\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"Verification complete!\")\nENDSCRIPT\n"]
[153.494745, "o", "cat > /root/verify_pptx.py << 'ENDSCRIPT'\r\n\u001b[?2004l\r"]
