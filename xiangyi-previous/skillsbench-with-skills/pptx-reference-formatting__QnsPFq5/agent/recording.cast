[101.608214, "o", "\u001b[?2004h> "]
[101.608313, "o", "            if shape.has_text_frame:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.608429, "o", "                text = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.608832, "o", "                for para in shape.text_frame.paragraphs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.608869, "o", "> "]
[101.609199, "o", "                    text += para.text.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.609285, "o", "> "]
[101.609366, "o", "                if text:\r\n\u001b[?2004l\r"]
[101.609449, "o", "\u001b[?2004h> "]
[101.609732, "o", "                    print(f\"Slide {slide_idx + 1}: Found paper title: '{text}'\")\r\n\u001b[?2004l\r"]
[101.609885, "o", "\u001b[?2004h> "]
[101.610046, "o", "                    dangling_boxes.append((slide, shape, text))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.610344, "o", "                    paper_titles.append(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.610418, "o", "> \r\n\u001b[?2004l\rP\u001b[?2004h> "]
[101.610625, "o", "print(f\"\\nFound {len(dangling_boxes)} dangling paper titles\")\r\n\u001b[?2004l\r"]
[101.610708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[101.610895, "o", "# Get unique titles while preserving order\r\n\u001b[?2004l\r"]
[101.610935, "o", "\u001b[?2004h> "]
[101.611057, "o", "seen = set()\r\n\u001b[?2004l\r"]
[101.611099, "o", "\u001b[?2004h> unique_titles = []\r\n\u001b[?2004l\r"]
[101.611205, "o", "\u001b[?2004h> "]
[101.611247, "o", "for title in paper_titles:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.611324, "o", "    if title not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.611391, "o", "        seen.add(title)\r\n\u001b[?2004l\r"]
[101.611456, "o", "\u001b[?2004h> "]
[101.611598, "o", "        unique_titles.append(title)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.611824, "o", "print(f\"Unique paper titles: {len(unique_titles)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.611869, "o", "for i, title in enumerate(unique_titles, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.611959, "o", "    print(f\"  {i}. {title}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.612034, "o", "\u001b[?2004h> "]
[101.612084, "o", "# Define formatting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.612145, "o", "font_name = \"Arial\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.612195, "o", "> font_size = Pt(16)\r\n\u001b[?2004l\r"]
[101.612229, "o", "\u001b[?2004h> "]
[101.612376, "o", "font_color = RGBColor(0x98, 0x95, 0x96)  # #989596\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.6124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.612521, "o", "# Bottom margin from slide bottom\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.612601, "o", "bottom_margin = Inches(0.3)\r\n\u001b[?2004l\r"]
[101.612661, "o", "\u001b[?2004h> "]
[101.612692, "o", "box_height = Inches(0.4)\r\n\u001b[?2004l\r"]
[101.612726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.612759, "o", "> "]
[101.61288, "o", "# Process each dangling text box\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.612986, "o", "for slide, shape, title_text in dangling_boxes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.613008, "o", "> "]
[101.613199, "o", "    # Calculate required width - estimate based on character count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.613327, "o", "    # Use a generous width to ensure single line\r\n\u001b[?2004l\r"]
[101.613374, "o", "\u001b[?2004h> "]
[101.613502, "o", "    # We'll use almost full slide width with some margin\r\n\u001b[?2004l\r"]
[101.61355, "o", "\u001b[?2004h> "]
[101.613739, "o", "    new_width = slide_width - Inches(0.5)  # Leave 0.25\" margin on each side\r\n\u001b[?2004l\r"]
[101.613787, "o", "\u001b[?2004h>     \r\n"]
[101.613822, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[101.61389, "o", "    # Center horizontally\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.613919, "o", "> "]
[101.614022, "o", "    new_left = (slide_width - new_width) / 2\r\n\u001b[?2004l\r"]
[101.614069, "o", "\u001b[?2004h> "]
[101.614099, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.614175, "o", "    # Position at bottom center\r\n\u001b[?2004l\r"]
[101.614208, "o", "\u001b[?2004h> "]
[101.614342, "o", "    new_top = slide_height - bottom_margin - box_height\r\n\u001b[?2004l\r"]
[101.61439, "o", "\u001b[?2004h> "]
[101.614421, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.614508, "o", "    # Update shape position and size\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.614541, "o", "> "]
[101.614608, "o", "    shape.left = int(new_left)\r\n\u001b[?2004l\r"]
[101.614654, "o", "\u001b[?2004h> "]
[101.614716, "o", "    shape.top = int(new_top)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.614749, "o", "> "]
[101.614831, "o", "    shape.width = int(new_width)\r\n\u001b[?2004l\r"]
[101.614861, "o", "\u001b[?2004h> "]
[101.614957, "o", "    shape.height = int(box_height)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.61498, "o", ">     \r\n\u001b[?2004l\r"]
[101.615009, "o", "\u001b[?2004h> "]
[101.615103, "o", "    # Format the text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.615253, "o", "    for para in shape.text_frame.paragraphs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.615276, "o", "> "]
[101.615377, "o", "        para.alignment = PP_ALIGN.CENTER\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.6154, "o", "> "]
[101.615484, "o", "        for run in para.runs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.615597, "o", "            run.font.name = font_name\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.615646, "o", "> "]
[101.615738, "o", "            run.font.size = font_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.615859, "o", "            run.font.color.rgb = font_color\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.615905, "o", "> "]
[101.615979, "o", "            run.font.bold = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616002, "o", "> "]
[101.61603, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616059, "o", "> "]
[101.616305, "o", "        # Also set paragraph-level font properties in case there are no runs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.616368, "o", "        if para.font:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.6164, "o", "> "]
[101.616472, "o", "            para.font.name = font_name\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616503, "o", "> "]
[101.616596, "o", "            para.font.size = font_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616619, "o", "> "]
[101.616738, "o", "            para.font.color.rgb = font_color\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616783, "o", "> "]
[101.616855, "o", "            para.font.bold = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.616884, "o", "> \r\n\u001b[?2004l\r"]
[101.616937, "o", "\u001b[?2004h> "]
[101.617032, "o", "print(\"\\nFormatted all dangling paper titles\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.617063, "o", "> \r\n\u001b[?2004l\r"]
[101.617091, "o", "\u001b[?2004h> "]
[101.617195, "o", "# Create a new Reference slide at the end\r\n\u001b[?2004l\r"]
[101.617228, "o", "\u001b[?2004h> "]
[101.617354, "o", "# Use a blank layout or title and content layout\r\n\u001b[?2004l\r"]
[101.617402, "o", "\u001b[?2004h> "]
[101.61747, "o", "slide_layouts = prs.slide_layouts\r\n\u001b[?2004l\r"]
[101.617502, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.61753, "o", "\u001b[?2004h> "]
[101.617682, "o", "# Find a suitable layout (Title and Content or similar)\r\n\u001b[?2004l\r"]
[101.617714, "o", "\u001b[?2004h> "]
[101.617821, "o", "# Layout index 1 is typically \"Title and Content\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.617867, "o", "> "]
[101.617901, "o", "layout = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.61798, "o", "for sl in slide_layouts:\r\n\u001b[?2004l\r"]
[101.618014, "o", "\u001b[?2004h> "]
[101.618214, "o", "    if 'Title and Content' in sl.name or 'title and content' in sl.name.lower():\r\n\u001b[?2004l\r"]
[101.618264, "o", "\u001b[?2004h> "]
[101.618293, "o", "        layout = sl\r\n\u001b[?2004l\r"]
[101.618322, "o", "\u001b[?2004h> "]
[101.618356, "o", "        break\r\n\u001b[?2004l\r"]
[101.618387, "o", "\u001b[?2004h> "]
[101.618445, "o", "if layout is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.6185, "o", "> "]
[101.618627, "o", "    # Try to get layout index 1 (usually Title and Content)\r\n\u001b[?2004l\r"]
[101.618655, "o", "\u001b[?2004h> "]
[101.618851, "o", "    layout = slide_layouts[1] if len(slide_layouts) > 1 else slide_layouts[0]\r\n\u001b[?2004l\r"]
[101.618873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.618928, "o", "\u001b[?2004h> "]
[101.619004, "o", "print(f\"Using layout: {layout.name}\")\r\n\u001b[?2004l\r"]
[101.619035, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.619062, "o", "\u001b[?2004h> "]
[101.619114, "o", "# Add new slide\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.619156, "o", "> "]
[101.619268, "o", "ref_slide = prs.slides.add_slide(layout)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.619298, "o", "\u001b[?2004h> "]
[101.619375, "o", "# Set the title\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.619457, "o", "for shape in ref_slide.shapes:\r\n\u001b[?2004l\r"]
[101.619481, "o", "\u001b[?2004h> "]
[101.61958, "o", "    if shape.has_text_frame:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.619804, "o", "        if 'title' in shape.name.lower() or shape.placeholder_format is not None:\r\n\u001b[?2004l\r"]
[101.619852, "o", "\u001b[?2004h> "]
[101.620069, "o", "            if hasattr(shape, 'placeholder_format') and shape.placeholder_format is not None:\r\n\u001b[?2004l\r"]
[101.620116, "o", "\u001b[?2004h> "]
[101.620246, "o", "                from pptx.enum.shapes import PP_PLACEHOLDER\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.620293, "o", "> "]
[101.620485, "o", "                if shape.placeholder_format.type == PP_PLACEHOLDER.TITLE:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.620536, "o", "> "]
[101.620685, "o", "                    shape.text_frame.paragraphs[0].text = \"Reference\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.620734, "o", "> "]
[101.620833, "o", "                    print(\"Set Reference title\")\r\n\u001b[?2004l\r"]
[101.62088, "o", "\u001b[?2004h> "]
[101.620931, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.620963, "o", "> "]
[101.621087, "o", "            elif 'title' in shape.name.lower():\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.621111, "o", "> "]
[101.62129, "o", "                shape.text_frame.paragraphs[0].text = \"Reference\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.621416, "o", "                print(\"Set Reference title\")\r\n\u001b[?2004l\r"]
[101.621474, "o", "\u001b[?2004h> "]
[101.621508, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.621537, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.621569, "o", "> "]
[101.621696, "o", "# Find the content placeholder and add paper titles\r\n\u001b[?2004l\r"]
[101.621727, "o", "\u001b[?2004h> "]
[101.621798, "o", "for shape in ref_slide.shapes:\r\n\u001b[?2004l\r"]
[101.621825, "o", "\u001b[?2004h> "]
[101.622127, "o", "    if shape.has_text_frame and hasattr(shape, 'placeholder_format') and shape.placeholder_format is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.622279, "o", "        from pptx.enum.shapes import PP_PLACEHOLDER\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.622592, "o", "        if shape.placeholder_format.type in [PP_PLACEHOLDER.BODY, PP_PLACEHOLDER.OBJECT, PP_PLACEHOLDER.CONTENT]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.622708, "o", "            tf = shape.text_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.622853, "o", "            tf.clear()  # Clear existing content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.62291, "o", "            \r\n\u001b[?2004l\r"]
[101.622943, "o", "\u001b[?2004h> "]
[101.623089, "o", "            for i, title in enumerate(unique_titles):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.623185, "o", "                if i == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.62321, "o", "> "]
[101.623348, "o", "                    p = tf.paragraphs[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.623423, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.623534, "o", "                    p = tf.add_paragraph()\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.623583, "o", "> "]
[101.623676, "o", "                p.text = f\"{i + 1}. {title}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.623721, "o", "> "]
[101.623772, "o", "                p.level = 0\r\n\u001b[?2004l\r"]
[101.623803, "o", "\u001b[?2004h> "]
[101.623857, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.624071, "o", "            print(f\"Added {len(unique_titles)} references to the slide\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.624149, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.62418, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.624253, "o", "# Save the presentation\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.624284, "o", "> "]
[101.62443, "o", "output_path = '/root/Awesome-Agent-Papers_processed.pptx'\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.624479, "o", "> "]
[101.624525, "o", "prs.save(output_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.6247, "o", "print(f\"\\nSaved processed presentation to: {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.624751, "o", "> "]
[101.624784, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
[101.626237, "o", "\u001b[?2004hroot@05a188121365:~# "]
[102.603606, "i", "python3 /root/process_pptx.py\n"]
[102.603882, "o", "python3 /root/process_pptx.py\r\n\u001b[?2004l\r"]
[102.735783, "o", "Slide dimensions: 13.33 x 7.50 inches\r\n"]
[102.73637, "o", "Slide 2: Found paper title: 'Foam-Agent: Towards Automated Intelligent CFD Workflows'\r\n"]
[102.736669, "o", "Slide 3: Found paper title: 'ReAct: Synergizing Reasoning and Acting in Language Models'\r\n"]
[102.73694, "o", "Slide 4: Found paper title: 'ReAct: Synergizing Reasoning and Acting in Language Models'\r\n"]
[102.737221, "o", "Slide 5: Found paper title: 'Why Do Multi-Agent LLM Systems Fail?'\r\n"]
[102.737497, "o", "Slide 6: Found paper title: 'MultiAgentBench : Evaluating the Collaboration and Competition of LLM agents'\r\n\r\nFound 5 dangling paper titles\r\nUnique paper titles: 4\r\n  1. Foam-Agent: Towards Automated Intelligent CFD Workflows\r\n  2. ReAct: Synergizing Reasoning and Acting in Language Models\r\n  3. Why Do Multi-Agent LLM Systems Fail?\r\n  4. MultiAgentBench : Evaluating the Collaboration and Competition of LLM agents\r\n"]
[102.741196, "o", "\r\nFormatted all dangling paper titles\r\n"]
[102.741314, "o", "Using layout: Title and Content\r\n"]
[102.743089, "o", "Set Reference title\r\n"]
