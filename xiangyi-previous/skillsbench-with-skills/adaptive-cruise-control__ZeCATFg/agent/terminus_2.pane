[?2004l[?2004h>     best_dist_params = (0.1, 0.01, 0.0)
[?2004l[?2004h>     min_dist_cost = float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     for kp in [0.1, 0.3, 0.5, 0.8, 1.0]:
