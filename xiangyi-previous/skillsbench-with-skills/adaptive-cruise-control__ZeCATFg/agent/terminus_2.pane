[?2004l[?2004h> from acc_system import AdaptiveCruiseControl
[?2004l[?2004h> 
[?2004l[?2004h> def run_simulation():
[?2004l[?2004h>     # Load configuration
[?2004l[?2004h>     with open('vehicle_params.yaml', 'r') as f:
[?2004l[?2004h>         config = yaml.safe_load(f)
[?2004l[?2004h>     
[?2004l[?2004h>     # Load tuned gains if available
[?2004l[?2004h>     try:
[?2004l[?2004h>         with open('tuning_results.yaml', 'r') as f:
[?2004l[?2004h>             tuning = yaml.safe_load(f)
[?2004l[?2004h>             config['pid_speed'] = tuning['pid_speed']
[?2004l[?2004h>             config['pid_distance'] = tuning['pid_distance']
[?2004l[?2004h>             print("Loaded tuned gains")
[?2004l[?2004h>     except FileNotFoundError:
[?2004l[?2004h>         print("No tuning results found, using default gains")
[?2004l[?2004h> 
[?2004l[?2004h>     # Initialize ACC
[?2004l[?2004h>     acc = AdaptiveCruiseControl(config)
[?2004l[?2004h>     dt = config['simulation']['dt']
[?2004l[?2004h>     
[?2004l[?2004h>     # Load sensor data
[?2004l[?2004h>     sensor_data = pd.read_csv('sensor_data.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Pre-calculate lead trajectory from sensor data
[?2004l[?2004h>     # We assume the recorded data is valid relative motion
[?2004l[?2004h>     # LeadPos(t) = RecEgoPos(t) + RecDistance(t)
[?2004l[?2004h>     rec_ego_pos = 0.0
[?2004l[?2004h>     lead_positions = []
[?2004l[?2004h>     lead_speeds = []
[?2004l[?2004h>     
[?2004l[?2004h>     for _, row in sensor_data.iterrows():
[?2004l[?2004h>         rec_ego_pos += row['ego_speed'] * dt
[?2004l[?2004h>         if not pd.isna(row['distance']):
[?2004l[?2004h>             lead_pos = rec_ego_pos + row['distance']
[?2004l[?2004h>             lead_positions.append(lead_pos)
[?2004l[?2004h>             lead_speeds.append(row['lead_speed'])
[?2004l[?2004h>         else:
[?2004l[?2004h>             lead_positions.append(None)
[?2004l[?2004h>             lead_speeds.append(None)
[?2004l[?2004h>             
[?2004l[?2004h>     # Simulation loop
[?2004l[?2004h>     results = []
[?2004l[?2004h>     sim_ego_speed = 0.0
[?2004l[?2004h>     sim_ego_pos = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(sensor_data)):
[?2004l[?2004h>         t = sensor_data.iloc[i]['time']
[?2004l[?2004h>         lead_pos = lead_positions[i]
[?2004l[?2004h>         l_speed = lead_speeds[i]
[?2004l[?2004h>         
[?2004l[?2004h>         # Determine inputs for ACC
[?2004l[?2004h>         sim_dist = None
[?2004l[?2004h>         if lead_pos is not None:
[?2004l[?2004h>             sim_dist = lead_pos - sim_ego_pos
[?2004l[?2004h>             
[?2004l[?2004h>         # ACC Compute
[?2004l[?2004h>         accel_cmd, mode, dist_err = acc.compute(sim_ego_speed, l_speed, sim_dist, dt)
[?2004l[?2004h>         
[?2004l[?2004h>         # Update Physics
[?2004l[?2004h>         sim_ego_speed += accel_cmd * dt
[?2004l[?2004h>         sim_ego_speed = max(0.0, sim_ego_speed) # No reverse
[?2004l[?2004h>         sim_ego_pos += sim_ego_speed * dt
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate TTC for logging
[?2004l[?2004h>         ttc = None
[?2004l[?2004h>         if l_speed is not None and sim_dist is not None:
[?2004l[?2004h>             rel_speed = sim_ego_speed - l_speed
[?2004l[?2004h>             if rel_speed > 0:
[?2004l[?2004h>                 ttc = sim_dist / rel_speed
[?2004l[?2004h>         
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': t,
[?2004l[?2004h>             'ego_speed': sim_ego_speed,
[?2004l[?2004h>             'acceleration_cmd': accel_cmd,
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': dist_err,
[?2004l[?2004h>             'distance': sim_dist,
[?2004l[?2004h>             'ttc': ttc
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     # Save results
[?2004l[?2004h>     df_results = pd.DataFrame(results)
[?2004l[?2004h>     df_results.to_csv('simulation_results.csv', index=False)
