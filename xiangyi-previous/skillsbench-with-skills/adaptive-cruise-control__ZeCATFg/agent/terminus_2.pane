[?2004l[?2004h>         cost += 2000.0 * overshoot
[?2004l[?2004h>         
[?2004l[?2004h>     cost += avg_speed_err * 100
[?2004l[?2004h>     cost += avg_dist_err * 100
[?2004l[?2004h>     
[?2004l[?2004h>     return cost
