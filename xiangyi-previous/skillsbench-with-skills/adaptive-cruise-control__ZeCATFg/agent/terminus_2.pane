[?2004l[?2004h>             lead_positions.append(lead_pos)
[?2004l[?2004h>             lead_speeds.append(row['lead_speed'])
[?2004l[?2004h>             has_lead.append(True)
[?2004l[?2004h>         else:
[?2004l[?2004h>             lead_positions.append(None)
[?2004l[?2004h>             lead_speeds.append(None)
[?2004l[?2004h>             has_lead.append(False)
[?2004l[?2004h>             
[?2004l[?2004h>     # Simulation state
