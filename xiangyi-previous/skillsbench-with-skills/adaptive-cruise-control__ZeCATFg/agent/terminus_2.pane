[?2004l[?2004h>         l_speed = lead_speeds[i]
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate simulated distance
[?2004l[?2004h>         sim_dist = None
[?2004l[?2004h>         if lead_pos is not None:
[?2004l[?2004h>             sim_dist = lead_pos - sim_ego_pos
[?2004l[?2004h>             
[?2004l[?2004h>         # ACC Compute
