[?2004l[?2004h>             s_err = abs(config['acc_settings']['set_speed'] - sim_ego_speed)
[?2004l[?2004h>             speed_errors.append(s_err)
[?2004l[?2004h>             
[?2004l[?2004h>             # Rise time (first time reaching 90% of set speed)
