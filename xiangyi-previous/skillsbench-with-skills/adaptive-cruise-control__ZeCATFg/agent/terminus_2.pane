[?2004l[?2004h>                 
[?2004l[?2004h>     # Calculate cost
[?2004l[?2004h>     # Speed criteria: rise_time < 10s, overshoot < 5%, steady_state < 0.5 m/s
[?2004l[?2004h>     # Distance criteria: steady_state < 2m
[?2004l[?2004h>     
[?2004l[?2004h>     avg_speed_err = np.mean(speed_errors[-50:]) if len(speed_errors) > 50 else 100.0
[?2004l[?2004h>     avg_dist_err = np.mean(dist_errors[-50:]) if len(dist_errors) > 50 else 100.0
[?2004l[?2004h>     
