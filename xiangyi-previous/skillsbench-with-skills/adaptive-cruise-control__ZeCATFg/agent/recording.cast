[93.224465, "i", "cat > acc_system.py << 'EOF'\nfrom pid_controller import PIDController\n\nclass AdaptiveCruiseControl:\n    def __init__(self, config):\n        self.config = config\n        self.set_speed = config['acc_settings']['set_speed']\n        self.time_headway = config['acc_settings']['time_headway']\n        self.min_distance = config['acc_settings']['min_distance']\n        self.ttc_threshold = config['acc_settings']['emergency_ttc_threshold']\n        \n        self.max_accel = config['vehicle']['max_acceleration']\n        self.max_decel = config['vehicle']['max_deceleration']\n        \n        self.pid_speed = PIDController(\n            config['pid_speed']['kp'],\n            config['pid_speed']['ki'],\n            config['pid_speed']['kd']\n        )\n        self.pid_distance = PIDController(\n            config['pid_distance']['kp'],\n            config['pid_distance']['ki'],\n            config['pid_distance']['kd']\n        )\n\n    def update_gains(self, speed_gains, distance_gains):\n        self.pid_speed.kp = speed_gains['kp']\n        self.pid_speed.ki = speed_gains['ki']\n        self.pid_speed.kd = speed_gains['kd']\n        self.pid_distance.kp = distance_gains['kp']\n        self.pid_distance.ki = distance_gains['ki']\n        self.pid_distance.kd = distance_gains['kd']\n\n    def compute(self, ego_speed, lead_speed, distance, dt):\n        mode = 'cruise'\n        acceleration_cmd = 0.0\n        distance_error = None\n        \n        # Determine mode\n        if lead_speed is not None and distance is not None:\n            relative_speed = ego_speed - lead_speed\n            ttc = float('inf')\n            if relative_speed > 0 and distance > 0:\n                ttc = distance / relative_speed\n            \n            if ttc < self.ttc_threshold:\n                mode = 'emergency'\n            else:\n                mode = 'follow'\n        \n        if mode == 'cruise':\n            error = self.set_speed - ego_speed\n            acceleration_cmd = self.pid_speed.compute(error, dt)\n            self.pid_distance.reset()\n            \n        elif mode == 'follow':\n            desired_distance = self.min_distance + (self.time_headway * ego_speed)\n            error = distance - desired_distance\n            distance_error = error\n            acceleration_cmd = self.pid_distance.compute(error, dt)\n            self.pid_speed.reset()\n            \n        elif mode == 'emergency':\n            acceleration_cmd = self.max_decel\n            self.pid_speed.reset()\n            self.pid_distance.reset()\n            if distance is not None:\n                desired_distance = self.min_distance + (self.time_headway * ego_speed)\n                distance_error = distance - desired_distance\n\n        # Clamp acceleration\n        acceleration_cmd = max(self.max_decel, min(self.max_accel, acceleration_cmd))\n        \n        return acceleration_cmd, mode, distance_error\nEOF\n"]
