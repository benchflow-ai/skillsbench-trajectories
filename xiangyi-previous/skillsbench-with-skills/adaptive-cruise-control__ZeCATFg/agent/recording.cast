[129.088965, "o", "grep -n \",\" sensor_data.csv | grep -v \",,\" | head -n 5\r\n\u001b[?2004l\r"]
[129.090491, "o", "1:time,ego_speed,lead_speed,distance\r\n302:30.0,30.0,25.37,52.1\r\n303:30.1,29.9,24.9,50.87\r\n304:30.2,29.8,25.49,49.1\r\n305:30.3,29.7,26.14,47.59\r\n"]
[129.090741, "o", "\u001b[?2004hroot@37146fd72e3b:~# "]
[154.654895, "i", "cat > tune_pid.py << 'EOF'\nimport yaml\nimport pandas as pd\nimport numpy as np\nfrom acc_system import AdaptiveCruiseControl\n\ndef run_closed_loop(kp_s, ki_s, kd_s, kp_d, ki_d, kd_d, sensor_data, config):\n    # Setup configuration with candidate gains\n    config['pid_speed']['kp'] = float(kp_s)\n    config['pid_speed']['ki'] = float(ki_s)\n    config['pid_speed']['kd'] = float(kd_s)\n    config['pid_distance']['kp'] = float(kp_d)\n    config['pid_distance']['ki'] = float(ki_d)\n    config['pid_distance']['kd'] = float(kd_d)\n    \n    acc = AdaptiveCruiseControl(config)\n    dt = config['simulation']['dt']\n    \n    # Pre-calculate lead trajectory\n    # Integrate recorded ego speed to get recorded ego position\n    rec_ego_pos = 0.0\n    lead_positions = []\n    lead_speeds = []\n    has_lead = []\n    \n    for _, row in sensor_data.iterrows():\n        rec_ego_pos += row['ego_speed'] * dt\n        if not pd.isna(row['distance']):\n            lead_pos = rec_ego_pos + row['distance']\n            lead_positions.append(lead_pos)\n            lead_speeds.append(row['lead_speed'])\n            has_lead.append(True)\n        else:\n            lead_positions.append(None)\n            lead_speeds.append(None)\n            has_lead.append(False)\n            \n    # Simulation state\n    sim_ego_speed = 0.0\n    sim_ego_pos = 0.0\n    \n    speed_errors = []\n    dist_errors = []\n    overshoot = 0.0\n    rise_time = None\n    \n    for i in range(len(sensor_data)):\n        t = sensor_data.iloc[i]['time']\n        lead_pos = lead_positions[i]\n        l_speed = lead_speeds[i]\n        \n        # Calculate simulated distance\n        sim_dist = None\n        if lead_pos is not None:\n            sim_dist = lead_pos - sim_ego_pos\n            \n        # ACC Compute\n        accel_cmd, mode, d_err = acc.compute(sim_ego_speed, l_speed, sim_dist, dt)\n        \n        # Update Physics\n        sim_ego_speed += accel_cmd * dt\n        sim_ego_speed = max(0.0, sim_ego_speed) # No reverse\n        sim_ego_pos += sim_ego_speed * dt\n        \n        # Metrics collection\n        if mode == 'cruise':\n            s_err = abs(config['acc_settings']['set_speed'] - sim_ego_speed)\n            speed_errors.append(s_err)\n            \n            # Rise time (first time reaching 90% of set speed)\n            if rise_time is None and sim_ego_speed >= 0.9 * config['acc_settings']['set_speed']:\n                rise_time = t\n            \n            # Overshoot\n            if sim_ego_speed > config['acc_settings']['set_speed']:\n                os = (sim_ego_speed - config['acc_settings']['set_speed']) / config['acc_settings']['set_speed']\n                overshoot = max(overshoot, os)\n                \n        elif mode == 'follow':\n            if d_err is not None:\n                dist_errors.append(abs(d_err))\n                \n    # Calculate cost\n    # Speed criteria: rise_time < 10s, overshoot < 5%, steady_state < 0.5 m/s\n    # Distance criteria: steady_state < 2m\n    \n    avg_speed_err = np.mean(speed_errors[-50:]) if len(speed_errors) > 50 else 100.0\n    avg_dist_err = np.mean(dist_errors[-50:]) if len(dist_errors) > 50 else 100.0\n    \n    cost = 0.0\n    \n    # Penalties\n    if rise_time is None or rise_time > 10.0:\n        cost += 1000.0\n    else:\n        cost += rise_time * 10\n        \n    if overshoot > 0.05:\n        cost += 2000.0 * overshoot\n        \n    cost += avg_speed_err * 100\n    cost += avg_dist_err * 100\n    \n    return cost\n\ndef tune():\n    with open('vehicle_params.yaml', 'r') as f:\n        config = yaml.safe_load(f)\n    \n    sensor_data = pd.read_csv('sensor_data.csv')\n    \n    best_cost = float('inf')\n    best_gains = None\n    \n    # Coarse grid search for Speed PID\n    # kp in (0, 10), ki in [0, 5), kd in [0, 5)\n    # We will do a simplified search to save time\n    \n    # Speed tuning loop (focus on cruise phase)\n    # We can tune speed first on a subset of data where there is no lead vehicle (0 to 30s)\n    # Then tune distance on the rest\n    \n    # Speed PID Search\n    print(\"Tuning Speed PID...\")\n    best_speed_params = (0.5, 0.0, 0.0)\n    min_speed_cost = float('inf')\n   "]
[154.65499, "i", " \n    for kp in [0.1, 0.5, 1.0, 2.0, 5.0]:\n        for ki in [0.0, 0.01, 0.05, 0.1, 0.5]:\n            for kd in [0.0, 0.1, 0.5, 1.0]:\n                 # Fix distance gains to default for now\n                 cost = run_closed_loop(kp, ki, kd, 0.1, 0.01, 0.0, sensor_data, config)\n                 if cost < min_speed_cost:\n                     min_speed_cost = cost\n                     best_speed_params = (kp, ki, kd)\n                     print(f\"New best speed: {best_speed_params}, Cost: {cost}\")\n\n    kp_s, ki_s, kd_s = best_speed_params\n    \n    # Distance PID Search\n    print(\"Tuning Distance PID...\")\n    best_dist_params = (0.1, 0.01, 0.0)\n    min_dist_cost = float('inf')\n    \n    for kp in [0.1, 0.3, 0.5, 0.8, 1.0]:\n        for ki in [0.0, 0.001, 0.01, 0.05]:\n            for kd in [0.0, 0.05, 0.1, 0.5]:\n                cost = run_closed_loop(kp_s, ki_s, kd_s, kp, ki, kd, sensor_data, config)\n                if cost < min_dist_cost:\n                    min_dist_cost = cost\n                    best_dist_params = (kp, ki, kd)\n                    print(f\"New best distance: {best_dist_params}, Cost: {cost}\")\n                    \n    kp_d, ki_d, kd_d = best_dist_params\n    \n    results = {\n        'pid_speed': {'kp': kp_s, 'ki': ki_s, 'kd': kd_s},\n        'pid_distance': {'kp': kp_d, 'ki': ki_d, 'kd': kd_d}\n    }\n    \n    with open('tuning_results.yaml', 'w') as f:\n        yaml.dump(results, f)\n    \n    print(\"Tuning complete. Results saved.\")\n\nif __name__ == '__main__':\n    tune()\nEOF\n"]
