[154.663107, "o", "                dist_errors.append(abs(d_err))\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663145, "o", "    # Calculate cost\r\n\u001b[?2004l\r"]
[154.66318, "o", "\u001b[?2004h> "]
[154.663281, "o", "    # Speed criteria: rise_time < 10s, overshoot < 5%, steady_state < 0.5 m/s\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.663319, "o", "> "]
[154.663395, "o", "    # Distance criteria: steady_state < 2m\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663526, "o", "    avg_speed_err = np.mean(speed_errors[-50:]) if len(speed_errors) > 50 else 100.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.663564, "o", "> "]
[154.663666, "o", "    avg_dist_err = np.mean(dist_errors[-50:]) if len(dist_errors) > 50 else 100.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.6637, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663737, "o", "    cost = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.663823, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663856, "o", "    # Penalties\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663923, "o", "    if rise_time is None or rise_time > 10.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.663962, "o", "        cost += 1000.0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[154.663994, "o", "\u001b[?2004h> "]
[154.664086, "o", "        cost += rise_time * 10\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664124, "o", "    if overshoot > 0.05:\r\n\u001b[?2004l\r"]
[154.664191, "o", "\u001b[?2004h>         cost += 2000.0 * overshoot\r\n\u001b[?2004l\r"]
[154.664227, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[154.664262, "o", "> "]
[154.664297, "o", "    cost += avg_speed_err * 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.664331, "o", "> "]
[154.664367, "o", "    cost += avg_dist_err * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.6644, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664436, "o", "    return cost\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.664472, "o", "\u001b[?2004h> def tune():\r\n\u001b[?2004l\r"]
[154.664504, "o", "\u001b[?2004h> "]
[154.664725, "o", "    with open('vehicle_params.yaml', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         config = yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664761, "o", "    sensor_data = pd.read_csv('sensor_data.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664793, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664891, "o", "    best_cost = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>     best_gains = None\r\n\u001b[?2004l\r"]
[154.664925, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.664998, "o", "    # Coarse grid search for Speed PID\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.665035, "o", "> "]
[154.665106, "o", "    # kp in (0, 10), ki in [0, 5), kd in [0, 5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.665192, "o", "    # We will do a simplified search to save time\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.665253, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.665317, "o", "    # Speed tuning loop (focus on cruise phase)\r\n\u001b[?2004l\r"]
[154.665354, "o", "\u001b[?2004h> "]
[154.665473, "o", "    # We can tune speed first on a subset of data where there is no lead vehicle (0 to 30s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.665509, "o", "> "]
[154.665581, "o", "    # Then tune distance on the rest\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.665634, "o", "    # Speed PID Search\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.665672, "o", "> "]
[154.665708, "o", "    print(\"Tuning Speed PID...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.665801, "o", "    best_speed_params = (0.5, 0.0, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.665859, "o", "    min_speed_cost = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[154.6659, "o", "\u001b[?2004h> "]
[154.665973, "o", "    for kp in [0.1, 0.5, 1.0, 2.0, 5.0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.666036, "o", "        for ki in [0.0, 0.01, 0.05, 0.1, 0.5]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.666069, "o", "> "]
[154.666132, "o", "            for kd in [0.0, 0.1, 0.5, 1.0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.666224, "o", "                 # Fix distance gains to default for now\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.666261, "o", "> "]
[154.666369, "o", "                 cost = run_closed_loop(kp, ki, kd, 0.1, 0.01, 0.0, sensor_data, config)\r\n\u001b[?2004l\r"]
[154.666405, "o", "\u001b[?2004h> "]
[154.666477, "o", "                 if cost < min_speed_cost:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.666532, "o", "                     min_speed_cost = cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.666564, "o", "> "]
[154.666633, "o", "                     best_speed_params = (kp, ki, kd)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.66667, "o", "> "]
[154.666768, "o", "                     print(f\"New best speed: {best_speed_params}, Cost: {cost}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.6668, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.666872, "o", "    kp_s, ki_s, kd_s = best_speed_params\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.666908, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.666982, "o", "    # Distance PID Search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667044, "o", "    print(\"Tuning Distance PID...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667095, "o", "    best_dist_params = (0.1, 0.01, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.667133, "o", "> "]
[154.667166, "o", "    min_dist_cost = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.667201, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667307, "o", "    for kp in [0.1, 0.3, 0.5, 0.8, 1.0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667365, "o", "        for ki in [0.0, 0.001, 0.01, 0.05]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667432, "o", "            for kd in [0.0, 0.05, 0.1, 0.5]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.667464, "o", "> "]
[154.667582, "o", "                cost = run_closed_loop(kp_s, ki_s, kd_s, kp, ki, kd, sensor_data, config)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.667621, "o", "> "]
[154.667697, "o", "                if cost < min_dist_cost:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667759, "o", "                    min_dist_cost = cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.667835, "o", "                    best_dist_params = (kp, ki, kd)\r\n\u001b[?2004l\r"]
[154.667906, "o", "\u001b[?2004h> "]
[154.667979, "o", "                    print(f\"New best distance: {best_dist_params}, Cost: {cost}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.66801, "o", "> "]
[154.668074, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668112, "o", "    kp_d, ki_d, kd_d = best_dist_params\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668145, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668181, "o", "    results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668278, "o", "        'pid_speed': {'kp': kp_s, 'ki': ki_s, 'kd': kd_s},\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.668314, "o", "> "]
[154.668383, "o", "        'pid_distance': {'kp': kp_d, 'ki': ki_d, 'kd': kd_d}\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.66842, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668452, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668528, "o", "    with open('tuning_results.yaml', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.66856, "o", "> "]
[154.668595, "o", "        yaml.dump(results, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.668631, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668731, "o", "    print(\"Tuning complete. Results saved.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668792, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.668827, "o", ">     tune()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.668861, "o", "EOF\r\n\u001b[?2004l\r"]
[154.670142, "o", "\u001b[?2004hroot@37146fd72e3b:~# "]
[157.930252, "i", "python3 tune_pid.py\n"]
[157.930706, "o", "python3 tune_pid.py"]
[157.933242, "o", "\r\n\u001b[?2004l\r"]
