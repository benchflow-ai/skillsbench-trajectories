[101.961741, "o", ">     sensor_data = pd.read_csv('sensor_data.csv')\r\n\u001b[?2004l\r"]
[101.961838, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.961913, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.961963, "o", "    for index, row in sensor_data.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962005, "o", "        time = row['time']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962107, "o", "        ego_speed = row['ego_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962247, "o", "        lead_speed = row['lead_speed'] if not pd.isna(row['lead_speed']) else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962362, "o", "        distance = row['distance'] if not pd.isna(row['distance']) else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962453, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962535, "o", "        accel_cmd, mode, dist_err = acc.compute(ego_speed, lead_speed, distance, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962578, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962661, "o", "        # Calculate TTC for logging\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962723, "o", "        ttc = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962817, "o", "        if lead_speed is not None and distance is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.962904, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.962947, "o", "> "]
[101.963041, "o", "            if rel_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.963079, "o", "                ttc = distance / rel_speed\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.963173, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.963216, "o", "            'time': time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.963243, "o", "> "]
[101.963362, "o", "            'ego_speed': ego_speed,\r\n\u001b[?2004l\r\u001b[?2004h>             'acceleration_cmd': accel_cmd,\r\n\u001b[?2004l\r"]
[101.963392, "o", "\u001b[?2004h> "]
[101.963543, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h>             'distance_error': dist_err,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.963613, "o", "            'distance': distance,\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.963697, "o", ">             'ttc': ttc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.963779, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.96387, "o", "    # Save results\r\n\u001b[?2004l\r\u001b[?2004h>     df_results = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[101.963911, "o", "\u001b[?2004h> "]
[101.964001, "o", "    df_results.to_csv('simulation_results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.96409, "o", "    print(\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.964134, "o", "\u001b[?2004h> "]
[101.964175, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.964214, "o", "    run_simulation()\r\n\u001b[?2004l\r\u001b[?2004h> "]
