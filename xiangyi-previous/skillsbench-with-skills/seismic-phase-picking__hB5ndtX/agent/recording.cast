6 Jan 25 20:43 NN.SCH..EH.0337546.npz\r\n-rw-r--r-- 1 root root  35995 Jan 25 20:43 NN.SCH.N1.EH.0058663.npz\r\n-rw-r--r-- 1 root root  41837 Jan 25 20:43 NN.SLK.N1.EH.0137316.npz\r\n-rw-r--r-- 1 root root 114805 Jan 25 20:43 NP.1582..HN.0369499.npz\r\n-rw-r--r-- 1 root root 137270 Jan 25 20:43 PB.B045..EH.0385872.npz\r\n-rw-r--r-- 1 root root 137641 Jan 25 20:43 PB.B046..EH.0283603.npz\r\n-rw-r--r-- 1 root root 130525 Jan 25 20:43 PB.B065..EH.0398802.npz\r\n-rw-r--r-- 1 root root 100254 Jan 25 20:43 PG.AR..EH.0170022.npz\r\n-rw-r--r-- 1 root root  83585 Jan 25 20:43 PG.LM..EH.0170871.npz\r\n-rw-r--r-- 1 root root 125169 Jan 25 20:43 PG.LMD..EH.0259174.npz\r\n-rw-r--r-- 1 root root  96142 Jan 25 20:43 PG.PB..EH.0163793.npz\r\n-rw-r--r-- 1 root root 131175 Jan 25 20:43 PG.WRD..EH.0309999.npz\r\n-rw-r--r-- 1 root root 138658 Jan 25 20:43 TA.P01C..BH.0201171.npz\r\n\u001b[?2004hroot@9d7b3ab297d3:~# "]
[20.781884, "i", "python3 - <<'PY'\nimport os, numpy as np, pandas as pd\nfrom glob import glob\n\ndef sta_lta(a, nsta, nlta):\n    a2 = a**2\n    sta = np.convolve(a2, np.ones(nsta), 'same')\n    lta = np.convolve(a2, np.ones(nlta), 'same') + 1e-12\n    return sta/nlta\n\nrows=[]\nfor fn in sorted(glob('/root/data/*.npz')):\n    d=np.load(fn, allow_pickle=True)\n    data=d['data']\n    dt=float(d['dt'])\n    chans = d['channels']\n    if isinstance(chans, np.ndarray):\n        chans = str(chans.tolist())\n    chans = str(chans)\n    ch_list=[c.strip() for c in chans.split(',')]\n    # identify vertical index: contains 'Z' or last channel\n    z_idx=None\n    for i,c in enumerate(ch_list):\n        if 'Z' in c.upper():\n            z_idx=i; break\n    if z_idx is None: z_idx=2 if data.shape[1]>2 else 0\n    # horizontal: use sum of remaining\n    h_idx=[i for i in range(data.shape[1]) if i!=z_idx]\n    if not h_idx: h_idx=[z_idx]\n    z = data[:,z_idx]\n    h = np.sqrt(np.sum(data[:,h_idx]**2, axis=1)) if len(h_idx)>1 else np.abs(data[:,h_idx[0]])\n    n=len(z)\n    # preprocess: detrend and normalize\n    z=z-np.mean(z); h=h-np.mean(h)\n    # STA/LTA parameters\n    nsta=max(1,int(0.2/dt))\n    nlta=max(nsta+1,int(2.0/dt))\n    ratio_p=sta_lta(np.abs(z), nsta, nlta)\n    ratio_s=sta_lta(np.abs(h), nsta, nlta)\n    # pick P: first time ratio exceeds threshold after initial padding\n    thr_p=3.0\n    idx_p=np.where(ratio_p>thr_p)[0]\n    if idx_p.size>0:\n        p_pick=idx_p[0]\n        rows.append((os.path.basename(fn),'P',int(p_pick)))\n    # pick S: search after P+0.5s, using horizontal\n    thr_s=3.0\n    start=int(p_pick+0.5/dt) if idx_p.size>0 else int(1.0/dt)\n    idx_s=np.where(ratio_s>thr_s)[0]\n    idx_s=idx_s[idx_s>=start]\n    if idx_s.size>0:\n        s_pick=idx_s[0]\n        rows.append((os.path.basename(fn),'S',int(s_pick)))\n\n# write results\nimport csv\nout='/root/results.csv'\nwith open(out,'w',newline='') as f:\n    w=csv.writer(f)\n    w.writerow(['file_name','phase','pick_idx'])\n    for r in rows:\n        w.writerow(r)\nprint('wrote',out,'rows',len(rows))\nPY\n"]
[20.792419, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os, numpy as np, pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from glob import glob\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def sta_lta(a, nsta, nlta):\r\n\u001b[?2004l\r\u001b[?2004h>     a2 = a**2\r\n\u001b[?2004l\r\u001b[?2004h>     sta = np.convolve(a2, np.ones(nsta), 'same')\r\n\u001b[?2004l\r\u001b[?2004h>     lta = np.convolve(a2, np.ones(nlta), 'same') + 1e-12\r\n\u001b[?2004l\r\u001b[?2004h>     return sta/nlta\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> for fn in sorted(glob('/root/data/*.npz')):\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.load(fn, allow_pickle=True)\r\n\u001b[?2004l\r\u001b[?2004h>     data=d['data']\r\n\u001b[?2004l\r\u001b[?2004h>     dt=float(d['dt'])\r\n\u001b[?2004l\r\u001b[?2004h>     chans = d['channels']\r\n\u001b[?2004l\r\u001b[?2004h>     if isinstance(chans, np.ndarray):\r\n\u001b[?2004l\r\u001b[?2004h>         chans = str(chans.tolist())\r\n\u001b[?2004l\r\u001b[?2004h>     chans = str(chans)\r\n\u001b[?2004l\r\u001b[?2004h>     ch_list=[c.strip() for c in chans.split(',')]\r\n\u001b[?2004l\r\u001b[?2004h>     # identify vertical index: contains 'Z' or last channel\r\n\u001b[?2004l\r\u001b[?2004h>     z_idx=None\r\n\u001b[?2004l\r\u001b[?2004h>     for i,c in enumerate(ch_list):\r\n\u001b[?2004l\r\u001b[?2004h>         if 'Z' in c.upper():\r\n\u001b[?2004l\r\u001b[?2004h>             z_idx=i; break\r\n\u001b[?2004l\r\u001b[?2004h>     if z_idx is None: z_idx=2 if data.shape[1]>2 else 0\r\n\u001b[?2004l\r\u001b[?2004h>     # horizontal: use sum of remaining\r\n\u001b[?2004l\r\u001b[?2004h>     h_idx=[i for i in range(data.shape[1]) if i!=z_idx]\r\n\u001b[?2004l\r\u001b[?2004h>     if not h_idx: h_idx=[z_idx]\r\n\u001b[?2004l\r\u001b[?2004h>     z = data[:,z_idx]\r\n\u001b[?2004l\r\u001b[?2004h>     h = np.sqrt(np.sum(data[:,h_idx]**2, axis=1)) if len(h_idx)>1 else np.abs(data[:,h_idx[0]])\r\n\u001b[?2004l\r\u001b[?2004h>     n=len(z)\r\n\u001b[?2004l\r\u001b[?2004h>     # preprocess: detrend and normalize\r\n\u001b[?2004l\r\u001b[?2004h>     z=z-np.mean(z); h=h-np.mean(h)\r\n\u001b[?2004l\r\u001b[?2004h>     # STA/LTA parameters\r\n\u001b[?2004l\r\u001b[?2004h>     nsta=max(1,int(0.2/dt))\r\n\u001b[?2004l\r\u001b[?2004h>     nlta=max(nsta+1,int(2.0/dt))\r\n\u001b[?2004l\r\u001b[?2004h>     ratio_p=sta_lta(np.abs(z), nsta, nlta)\r\n\u001b[?2004l\r\u001b[?2004h>     ratio_s=sta_lta(np.abs(h), nsta, nlta)\r\n\u001b[?2004l\r\u001b[?2004h>     # pick P: first time ratio exceeds threshold after initial padding\r\n\u001b[?2004l\r\u001b[?2004h>     thr_p=3.0\r\n\u001b[?2004l\r\u001b[?2004h>     idx_p=np.where(ratio_p>thr_p)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     if idx_p.size>0:\r\n\u001b[?2004l\r\u001b[?2004h>         p_pick=idx_p[0]\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append((os.path.basename(fn),'P',int(p_pick)))\r\n\u001b[?2004l\r\u001b[?2004h>     # pick S: search after P+0.5s, using horizontal\r\n\u001b[?2004l\r\u001b[?2004h>     thr_s=3.0\r\n\u001b[?2004l\r\u001b[?2004h>     start=int(p_pick+0.5/dt) if idx_p.size>0 else int(1.0/dt)\r\n\u001b[?2004l\r\u001b[?2004h>     idx_s=np.where(ratio_s>thr_s)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     idx_s=idx_s[idx_s>=start]\r\n\u001b[?2004l\r\u001b[?2004h>     if idx_s.size>0:\r\n\u001b[?2004l\r\u001b[?2004h>         s_pick=idx_s[0]\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append((os.path.basename(fn),'S',int(s_pick)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # write results\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> out='/root/results.csv'\r\n\u001b[?2004l\r\u001b[?2004h> with open(out,'w',newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     w=csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h>     w.writerow(['file_name','phase','pick_idx'])\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         w.writerow(r)\r\n\u001b[?2004l\r\u001b[?2004h> print('wrote',out,'rows',len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
