[?2004lpython3 - <<'PY'
import os, numpy as np
from glob import glob

def sta_lta(a, nsta, nlta):
    a2 = a**2
    sta = np.convolve(a2, np.ones(nsta), 'same')
    lta = np.convolve(a2, np.ones(nlta), 'same') + 1e-12
    return sta/(lta+1e-12)

rows=[]
for fn in sorted(glob('/root/data/*.npz')):
    d=np.load(fn, allow_pickle=True)
    data=d['data']
    dt=float(d['dt'])
    chans = d['channels']
    if isinstance(chans, np.ndarray):
        chans = str(chans.tolist())
    chans = str(chans)
    ch_list=[c.strip() for c in chans.split(',')]
    z_idx=None
    for i,c in enumerate(ch_list):
        if 'Z' in c.upper():
            z_idx=i; break
    if z_idx is None: z_idx=2 if data.shape[1]>2 else 0
    h_idx=[i for i in range(data.shape[1]) if i!=z_idx]
    if not h_idx: h_idx=[z_idx]
    z=data[:,z_idx]; h=np.sqrt(np.sum(data[:,h_idx]**2, axis=1)) if len(h_idx)>1 else np.abs(data[:,h_idx[0]])
    z=z-np.mean(z); h=h-np.mean(h)
    nsta=max(1,int(0.2/dt)); nlta=max(nsta+1,int(2.0/dt))
    ratio_p=sta_lta(np.abs(z), nsta, nlta)
    ratio_s=sta_lta(np.abs(h), nsta, nlta)
    thr_p=3.0; thr_s=3.0
    idx_p=np.where(ratio_p>thr_p)[0]
    p_pick=None
    if idx_p.size>0:
        p_pick=int(idx_p[0]); rows.append((os.path.basename(fn),'P',p_pick))
    start=int(p_pick+0.5/dt) if p_pick is not None else int(1.0/dt)
    idx_s=np.where(ratio_s>thr_s)[0]
    idx_s=idx_s[idx_s>=start]
    if idx_s.size>0:
        s_pick=int(idx_s[0]); rows.append((os.path.basename(fn),'S',s_pick))

import csv
out='/root/results.csv'
with open(out,'w',newline='') as f:
    w=csv.writer(f)
    w.writerow(['file_name','phase','pick_idx'])
    for r in rows:
        w.writerow(r)
print('wrote',out,'rows',len(rows))
