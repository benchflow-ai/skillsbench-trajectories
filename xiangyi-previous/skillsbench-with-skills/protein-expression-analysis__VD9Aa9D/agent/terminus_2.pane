[?2004hroot@699b34e01657:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('protein_expression.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> print("Step 3: Adding fold change formulas")
[?2004l[?2004h> print("\nFor each protein (rows 32-41):")
[?2004l[?2004h> print("  A: Protein_ID (reference from A11:A20)")
[?2004l[?2004h> print("  B: Gene_Symbol (lookup from Data sheet)")
[?2004l[?2004h> print("  C: Fold Change = 2^(Log2 FC)")
[?2004l[?2004h> print("  D: Log2 FC = Treated Mean - Control Mean")
[?2004l[?2004h> print()
[?2004l[?2004h> 
[?2004l[?2004h> # For each protein (rows 32-41)
[?2004l[?2004h> for i in range(10):
[?2004l[?2004h>     row = 32 + i  # rows 32 to 41
[?2004l[?2004h>     protein_row = 11 + i  # rows 11 to 20
[?2004l[?2004h>     stats_col = 2 + i  # columns B to K (for statistics)
[?2004l[?2004h>     stats_col_letter = openpyxl.utils.get_column_letter(stats_col)
[?2004l[?2004h>     
[?2004l[?2004h>     # Column A: Protein_ID reference
[?2004l[?2004h>     task_sheet.cell(row, 1).value = f'=A{protein_row}'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column B: Gene_Symbol from Data sheet
[?2004l[?2004h>     # =INDEX(Data!$B:$B,MATCH(A32,Data!$A:$A,0))
[?2004l[?2004h>     task_sheet.cell(row, 2).value = f'=INDEX(Data!$B:$B,MATCH(A{row},Data!$A:$A,0))'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column D: Log2 FC = Treated Mean - Control Mean
[?2004l[?2004h>     # Treated Mean is in row 26, Control Mean is in row 24
[?2004l[?2004h>     task_sheet.cell(row, 4).value = f'={stats_col_letter}26-{stats_col_letter}24'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column C: Fold Change = 2^(Log2 FC)
[?2004l[?2004h>     task_sheet.cell(row, 3).value = f'=2^D{row}'
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Row {row} (protein {i+1}): A={task_sheet.cell(row,1).value}, D={task_sheet.cell(row,4).value}, C={task_sheet.cell(row,3).value}")
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('protein_expression.xlsx')
[?2004l[?2004h> print("\nSaved workbook with fold change formulas")
[?2004l[?2004h> print("\nAll steps complete!")
