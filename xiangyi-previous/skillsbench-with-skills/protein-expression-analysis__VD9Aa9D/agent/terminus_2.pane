[?2004l[?2004h> wb = load_workbook('protein_expression.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> print("Step 1: Adding INDEX-MATCH formulas for expression data (C11:L20)")
[?2004l[?2004h> 
[?2004l[?2004h> # For each protein (rows 11-20) and each sample (columns C-L)
[?2004l[?2004h> for row in range(11, 21):
[?2004l[?2004h>     for col in range(3, 13):  # C to L
[?2004l[?2004h>         col_letter = openpyxl.utils.get_column_letter(col)
[?2004l[?2004h>         # INDEX-MATCH formula:
[?2004l[?2004h>         # =INDEX(Data!$D:$BA, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0)-3)
[?2004l[?2004h>         # The -3 is because INDEX on Data!$D:$BA treats D as column 1, but MATCH on row 1 returns absolute position
[?2004l[?2004h>         # Actually, let's use a simpler approach with full range
[?2004l[?2004h>         # =INDEX(Data!$A:$BA, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))
[?2004l[?2004h>         formula = f'=INDEX(Data!$A:$BA,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'
[?2004l[?2004h>         task_sheet.cell(row, col).value = formula
[?2004l[?2004h>         
[?2004l[?2004h> print(f"  Added formulas for {10*10} cells")
