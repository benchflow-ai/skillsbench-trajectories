[?2004l[?2004h>     
[?2004l[?2004h>     # Row 27: Treated StdDev = STDEV.S(H11:L11)
[?2004l[?2004h>     treated_std_formula = f'=STDEV.S(H{protein_row}:L{protein_row})'
