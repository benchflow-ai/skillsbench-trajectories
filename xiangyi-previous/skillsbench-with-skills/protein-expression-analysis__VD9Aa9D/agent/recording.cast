[36.044858, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"=== DATA SHEET ===\")\nprint(f\"Dimensions: {data_sheet.dimensions}\")\n\n# Check first few rows and columns to understand structure\nprint(\"\\nFirst cell (A1):\", data_sheet['A1'].value)\nprint(\"\\nFirst row (samples?):\")\nfor col in range(1, 11):\n    cell = data_sheet.cell(1, col)\n    print(f\"  {cell.coordinate}: {cell.value}\")\n\nprint(\"\\nFirst column (proteins?):\")\nfor row in range(1, 11):\n    cell = data_sheet.cell(row, 1)\n    print(f\"  {cell.coordinate}: {cell.value}\")\n\n# Check if we can find one of our target proteins\nprint(\"\\nSearching for protein sp|Q9HCY8|S10AE_HUMAN...\")\nfor row in range(1, 210):\n    if data_sheet.cell(row, 1).value == 'sp|Q9HCY8|S10AE_HUMAN':\n        print(f\"  Found at row {row}\")\n        break\n\n# Check if we can find one of our target samples\nprint(\"\\nSearching for sample NCIH1568_LUNG_TenPx15...\")\nfor col in range(1, 60):\n    if data_sheet.cell(1, col).value == 'NCIH1568_LUNG_TenPx15':\n        print(f\"  Found at column {col} ({openpyxl.utils.get_column_letter(col)})\")\n        break\n\nEOF\n"]
