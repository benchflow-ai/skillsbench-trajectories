[205.364, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx', data_only=False)\ntask_sheet = wb['Task']\n\nprint(\"=== FINAL PRE-SUBMISSION CHECK ===\")\n\nprint(\"\\n1. Checking task requirements:\")\nprint(\"\\nRequirement: Fill C11:L20 with expression data\")\nprint(f\"   C11: {task_sheet['C11'].value}\")\nprint(f\"   L20: {task_sheet['L20'].value}\")\n\nprint(\"\\nRequirement: Calculate stats in yellow cells rows 24-27, cols B-K\")\nprint(\"   Row 24 = Control Mean\")\nprint(f\"   B24 (protein 1): {task_sheet['B24'].value}\")\nprint(\"   Row 25 = Control StdDev\")\nprint(f\"   B25 (protein 1): {task_sheet['B25'].value}\")\nprint(\"   Row 26 = Treated Mean\")\nprint(f\"   B26 (protein 1): {task_sheet['B26'].value}\")\nprint(\"   Row 27 = Treated StdDev\")\nprint(f\"   B27 (protein 1): {task_sheet['B27'].value}\")\n\nprint(\"\\nRequirement: Fill C and D in rows 32-41\")\nprint(\"   Column C = Fold Change\")\nprint(\"   Column D = Log2 FC\")\nprint(f\"   C32: {task_sheet['C32'].value}\")\nprint(f\"   D32: {task_sheet['D32'].value}\")\n\nprint(\"\\n2. Verifying formula correctness:\")\nprint(\"\\nChecking row 9 groups:\")\nfor col in range(3, 13):\n    val = task_sheet.cell(9, col).value\n    col_letter = openpyxl.utils.get_column_letter(col)\n    print(f\"   {col_letter}9: {val}\")\n\nprint(\"\\nControl samples should be C-G (5 samples)\")\nprint(\"Treated samples should be H-L (5 samples)\")\nprint(\"\\nVerifying statistics use correct ranges:\")\nprint(f\"   B24 (Control Mean for protein in row 11): {task_sheet['B24'].value}\")\nprint(f\"   Expected: =AVERAGE(C11:G11) ✓\" if task_sheet['B24'].value == '=AVERAGE(C11:G11)' else \"   ERROR!\")\nprint(f\"   B26 (Treated Mean for protein in row 11): {task_sheet['B26'].value}\")\nprint(f\"   Expected: =AVERAGE(H11:L11) ✓\" if task_sheet['B26'].value == '=AVERAGE(H11:L11)' else \"   ERROR!\")\n\nprint(\"\\n3. Verifying fold change formulas:\")\nprint(f\"   D32 (Log2 FC): {task_sheet['D32'].value}\")\nprint(\"   Should be: Treated Mean - Control Mean = B26-B24\")\nprint(f\"   C32 (Fold Change): {task_sheet['C32'].value}\")\nprint(\"   Should be: 2^(Log2 FC) = 2^D32\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"ALL CHECKS PASSED - READY FOR SUBMISSION\")\nprint(\"=\"*60)\n\nEOF\n"]
