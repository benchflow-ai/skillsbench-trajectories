[36.220883, "o", "=== DATA SHEET ===\r\n"]
[36.221296, "o", "Dimensions: A1:BA201\r\n\r\nFirst cell (A1): Protein_ID\r\n\r\nFirst row (samples?):\r\n"]
[36.221334, "o", "  A1: Protein_ID\r\n  B1: Gene_Symbol\r\n  C1: Description\r\n  D1: NCIH1568_LUNG_TenPx15\r\n  E1: IPC298_SKIN_TenPx08\r\n  F1: WM2664_SKIN_TenPx02\r\n  G1: SNU1_STOMACH_TenPx20\r\n  H1: TE6_OESOPHAGUS_TenPx17\r\n  I1: FUOV1_OVARY_TenPx16\r\n"]
[36.22136, "o", "  J1: LS513_LARGE_INTESTINE_TenPx09\r\n\r\nFirst column (proteins?):\r\n  A1: Protein_ID\r\n  A2: sp|Q9HCY8|S10AE_HUMAN\r\n  A3: sp|Q96EN8|MOCOS_HUMAN\r\n  A4: sp|Q86UT8|CCD84_HUMAN\r\n  A5: sp|O96000|NDUBA_HUMAN\r\n"]
