[103.436296, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== Checking for filled cells (yellow) in statistics section ===\")\nfor row in range(24, 28):\n    print(f\"Row {row}:\", end=\"\")\n    for col in range(2, 12):  # B to K\n        cell = task_sheet.cell(row, col)\n        if cell.fill and cell.fill.start_color and cell.fill.start_color.rgb:\n            col_letter = openpyxl.utils.get_column_letter(col)\n            print(f\" {col_letter}(color:{cell.fill.start_color.rgb})\", end=\"\")\n    print()\n\nprint(\"\\n=== Checking for filled cells in fold change section ===\")\nfor row in range(32, 42):\n    print(f\"Row {row}:\", end=\"\")\n    for col in range(1, 5):  # A to D\n        cell = task_sheet.cell(row, col)\n        if cell.fill and cell.fill.start_color and cell.fill.start_color.rgb:\n            col_letter = openpyxl.utils.get_column_letter(col)\n            print(f\" {col_letter}(color:{cell.fill.start_color.rgb})\", end=\"\")\n    print()\n\n# Also check what row 23 says for protein headers\nprint(\"\\n=== Checking row 23 for protein headers ===\")\nfor col in range(2, 12):  # B to K\n    cell = task_sheet.cell(23, col)\n    col_letter = openpyxl.utils.get_column_letter(col)\n    print(f\"{col_letter}23: {cell.value}\")\n\nEOF\n"]
