[124.549605, "o", "Step 2: Adding statistics formulas\r\n\r\nStatistics layout: Each column B-K represents one protein\r\n  Protein 1 (row 11) -> column B\r\n  Protein 2 (row 12) -> column C\r\n  ...\r\n  Protein 10 (row 20) -> column K\r\n\r\nControl samples: C11:G20 (columns C-G)\r\nTreated samples: H11:L20 (columns H-L)\r\nColumn B (protein row 11): Added formulas\r\nColumn C (protein row 12): Added formulas\r\n"]
[124.549682, "o", "Column D (protein row 13): Added formulas\r\nColumn E (protein row 14): Added formulas\r\nColumn F (protein row 15): Added formulas\r\nColumn G (protein row 16): Added formulas\r\nColumn H (protein row 17): Added formulas\r\n"]
[124.549864, "o", "Column I (protein row 18): Added formulas\r\nColumn J (protein row 19): Added formulas\r\n"]
[124.549938, "o", "Column K (protein row 20): Added formulas\r\n"]
[124.812159, "o", "\r\nSaved workbook with statistics formulas\r\n"]
[124.833668, "o", "\u001b[?2004hroot@699b34e01657:~# "]
[141.72197, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Step 3: Adding fold change formulas\")\nprint(\"\\nFor each protein (rows 32-41):\")\nprint(\"  A: Protein_ID (reference from A11:A20)\")\nprint(\"  B: Gene_Symbol (lookup from Data sheet)\")\nprint(\"  C: Fold Change = 2^(Log2 FC)\")\nprint(\"  D: Log2 FC = Treated Mean - Control Mean\")\nprint()\n\n# For each protein (rows 32-41)\nfor i in range(10):\n    row = 32 + i  # rows 32 to 41\n    protein_row = 11 + i  # rows 11 to 20\n    stats_col = 2 + i  # columns B to K (for statistics)\n    stats_col_letter = openpyxl.utils.get_column_letter(stats_col)\n    \n    # Column A: Protein_ID reference\n    task_sheet.cell(row, 1).value = f'=A{protein_row}'\n    \n    # Column B: Gene_Symbol from Data sheet\n    # =INDEX(Data!$B:$B,MATCH(A32,Data!$A:$A,0))\n    task_sheet.cell(row, 2).value = f'=INDEX(Data!$B:$B,MATCH(A{row},Data!$A:$A,0))'\n    \n    # Column D: Log2 FC = Treated Mean - Control Mean\n    # Treated Mean is in row 26, Control Mean is in row 24\n    task_sheet.cell(row, 4).value = f'={stats_col_letter}26-{stats_col_letter}24'\n    \n    # Column C: Fold Change = 2^(Log2 FC)\n    task_sheet.cell(row, 3).value = f'=2^D{row}'\n    \n    print(f\"Row {row} (protein {i+1}): A={task_sheet.cell(row,1).value}, D={task_sheet.cell(row,4).value}, C={task_sheet.cell(row,3).value}\")\n\nwb.save('protein_expression.xlsx')\nprint(\"\\nSaved workbook with fold change formulas\")\nprint(\"\\nAll steps complete!\")\n\nEOF\n"]
