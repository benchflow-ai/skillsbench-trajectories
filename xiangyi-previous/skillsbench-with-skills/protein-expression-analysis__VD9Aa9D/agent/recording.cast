[103.4391, "o", "\u001b[?2004h> "]
[103.439237, "o", "print(\"\\n=== Checking row 23 for protein headers ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.439307, "o", "for col in range(2, 12):  # B to K\r\n\u001b[?2004l\r\u001b[?2004h>     cell = task_sheet.cell(23, col)\r\n\u001b[?2004l\r"]
[103.439362, "o", "\u001b[?2004h> "]
