[50.03277, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ndata_sheet = wb['Data']\ntask_sheet = wb['Task']\n\n# Get all sample names from Data sheet row 1\ndata_samples = {}\nfor col in range(1, 60):\n    val = data_sheet.cell(1, col).value\n    if val and val not in ['Protein_ID', 'Gene_Symbol', 'Description']:\n        data_samples[val] = col\n\nprint(\"Checking if all Task sheet samples exist in Data sheet:\")\nfor col in range(3, 13):  # C to L\n    sample = task_sheet.cell(10, col).value\n    if sample in data_samples:\n        print(f\"  {sample}: Found at column {openpyxl.utils.get_column_letter(data_samples[sample])}\")\n    else:\n        print(f\"  {sample}: NOT FOUND\")\n\nprint(\"\\nVerifying all 10 proteins are in rows 2-11 of Data sheet:\")\nfor row in range(11, 21):\n    protein = task_sheet.cell(row, 1).value\n    data_protein = data_sheet.cell(row - 9, 1).value  # row 11 -> row 2\n    print(f\"  Task row {row}: {protein} == Data row {row-9}: {data_protein} -> {protein == data_protein}\")\n\nEOF\n"]
