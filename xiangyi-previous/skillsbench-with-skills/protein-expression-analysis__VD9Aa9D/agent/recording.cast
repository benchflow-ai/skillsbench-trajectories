[90.778691, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== Statistics section - checking columns B through K ===\")\nfor row in range(23, 28):\n    print(f\"Row {row}:\", end=\"\")\n    for col in range(1, 12):  # A to K\n        cell = task_sheet.cell(row, col)\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell.value:\n            print(f\" {col_letter}:{cell.value}\", end=\"\")\n    print()\n\nprint(\"\\n=== Fold change section - rows 31-41 ===\")\nfor row in range(31, 42):\n    print(f\"Row {row}:\", end=\"\")\n    for col in range(1, 5):  # A to D\n        cell = task_sheet.cell(row, col)\n        col_letter = openpyxl.utils.get_column_letter(col)\n        if cell.value:\n            print(f\" {col_letter}:{cell.value}\", end=\"\")\n        else:\n            print(f\" {col_letter}:_\", end=\"\")\n    print()\n\nEOF\n"]
