[141.89645, "o", "Step 3: Adding fold change formulas\r\n\r\nFor each protein (rows 32-41):\r\n  A: Protein_ID (reference from A11:A20)\r\n  B: Gene_Symbol (lookup from Data sheet)\r\n  C: Fold Change = 2^(Log2 FC)\r\n  D: Log2 FC = Treated Mean - Control Mean\r\n\r\n"]
[141.896516, "o", "Row 32 (protein 1): A==A11, D==B26-B24, C==2^D32\r\nRow 33 (protein 2): A==A12, D==C26-C24, C==2^D33"]
[141.896545, "o", "\r\nRow 34 (protein 3): A==A13, D==D26-D24, C==2^D34"]
[141.896573, "o", "\r\nRow 35 (protein 4): A==A14, D==E26-E24, C==2^D35"]
[141.896603, "o", "\r\nRow 36 (protein 5): A==A15, D==F26-F24, C==2^D36\r\n"]
[141.896632, "o", "Row 37 (protein 6): A==A16, D==G26-G24, C==2^D37\r\n"]
[141.896661, "o", "Row 38 (protein 7): A==A17, D==H26-H24, C==2^D38\r\n"]
[141.896687, "o", "Row 39 (protein 8): A==A18, D==I26-I24, C==2^D39\r\n"]
[141.896712, "o", "Row 40 (protein 9): A==A19, D==J26-J24, C==2^D40\r\n"]
[141.896736, "o", "Row 41 (protein 10): A==A20, D==K26-K24, C==2^D41\r\n"]
[141.997825, "o", "\r\nSaved workbook with fold change formulas\r\n\r\nAll steps complete!\r\n"]
[142.039323, "o", "\u001b[?2004hroot@699b34e01657:~# "]
[158.264568, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load with data_only=True to see calculated values\nwb_data = load_workbook('protein_expression.xlsx', data_only=True)\ntask_sheet_data = wb_data['Task']\n\n# Load without data_only to see formulas\nwb_formula = load_workbook('protein_expression.xlsx', data_only=False)\ntask_sheet_formula = wb_formula['Task']\n\nprint(\"=== Verification ===\")\nprint(\"\\n1. Expression data (sample cells):\")\nprint(f\"  C11 formula: {task_sheet_formula['C11'].value}\")\nprint(f\"  C11 value: {task_sheet_data['C11'].value}\")\nprint(f\"  L20 formula: {task_sheet_formula['L20'].value}\")\nprint(f\"  L20 value: {task_sheet_data['L20'].value}\")\n\nprint(\"\\n2. Statistics (sample cells):\")\nprint(f\"  B24 (Control Mean, protein 1) formula: {task_sheet_formula['B24'].value}\")\nprint(f\"  B24 value: {task_sheet_data['B24'].value}\")\nprint(f\"  K27 (Treated StdDev, protein 10) formula: {task_sheet_formula['K27'].value}\")\nprint(f\"  K27 value: {task_sheet_data['K27'].value}\")\n\nprint(\"\\n3. Fold change (sample cells):\")\nprint(f\"  A32 formula: {task_sheet_formula['A32'].value}\")\nprint(f\"  A32 value: {task_sheet_data['A32'].value}\")\nprint(f\"  B32 formula: {task_sheet_formula['B32'].value}\")\nprint(f\"  B32 value: {task_sheet_data['B32'].value}\")\nprint(f\"  D32 (Log2 FC) formula: {task_sheet_formula['D32'].value}\")\nprint(f\"  D32 value: {task_sheet_data['D32'].value}\")\nprint(f\"  C32 (FC) formula: {task_sheet_formula['C32'].value}\")\nprint(f\"  C32 value: {task_sheet_data['C32'].value}\")\n\nprint(\"\\n4. Checking cell colors are preserved:\")\nprint(f\"  B24 fill color: {task_sheet_formula['B24'].fill.start_color.rgb if task_sheet_formula['B24'].fill else 'None'}\")\nprint(f\"  C32 fill color: {task_sheet_formula['C32'].fill.start_color.rgb if task_sheet_formula['C32'].fill else 'None'}\")\n\nprint(\"\\n=== All formulas added successfully! ===\")\n\nEOF\n"]
