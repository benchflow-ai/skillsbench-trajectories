[103.437405, "o", "    for col in range(2, 12):  # B to K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.437482, "o", "        cell = task_sheet.cell(row, col)\r\n\u001b[?2004l\r"]
[103.437552, "o", "\u001b[?2004h> "]
[103.437682, "o", "        if cell.fill and cell.fill.start_color and cell.fill.start_color.rgb:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.437838, "o", "            col_letter = openpyxl.utils.get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438015, "o", "            print(f\" {col_letter}(color:{cell.fill.start_color.rgb})\", end=\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438055, "o", "    print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[103.438148, "o", "\u001b[?2004h> "]
[103.438268, "o", "print(\"\\n=== Checking for filled cells in fold change section ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438334, "o", "for row in range(32, 42):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438368, "o", "    print(f\"Row {row}:\", end=\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.43852, "o", "    for col in range(1, 5):  # A to D\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438598, "o", "        cell = task_sheet.cell(row, col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438668, "o", "        if cell.fill and cell.fill.start_color and cell.fill.start_color.rgb:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438795, "o", "            col_letter = openpyxl.utils.get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438923, "o", "            print(f\" {col_letter}(color:{cell.fill.start_color.rgb})\", end=\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.438981, "o", "    print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
