[124.379183, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('protein_expression.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Step 2: Adding statistics formulas\")\nprint(\"\\nStatistics layout: Each column B-K represents one protein\")\nprint(\"  Protein 1 (row 11) -> column B\")\nprint(\"  Protein 2 (row 12) -> column C\")\nprint(\"  ...\")\nprint(\"  Protein 10 (row 20) -> column K\")\nprint(\"\\nControl samples: C11:G20 (columns C-G)\")\nprint(\"Treated samples: H11:L20 (columns H-L)\")\n\n# For each protein column (B to K = columns 2 to 11)\nfor col in range(2, 12):  # B to K\n    col_letter = openpyxl.utils.get_column_letter(col)\n    protein_row = 11 + (col - 2)  # B->row 11, C->row 12, ..., K->row 20\n    \n    # Row 24: Control Mean = AVERAGE(C11:G11) for protein in row 11, etc.\n    control_mean_formula = f'=AVERAGE(C{protein_row}:G{protein_row})'\n    task_sheet.cell(24, col).value = control_mean_formula\n    \n    # Row 25: Control StdDev = STDEV.S(C11:G11)\n    control_std_formula = f'=STDEV.S(C{protein_row}:G{protein_row})'\n    task_sheet.cell(25, col).value = control_std_formula\n    \n    # Row 26: Treated Mean = AVERAGE(H11:L11)\n    treated_mean_formula = f'=AVERAGE(H{protein_row}:L{protein_row})'\n    task_sheet.cell(26, col).value = treated_mean_formula\n    \n    # Row 27: Treated StdDev = STDEV.S(H11:L11)\n    treated_std_formula = f'=STDEV.S(H{protein_row}:L{protein_row})'\n    task_sheet.cell(27, col).value = treated_std_formula\n    \n    print(f\"Column {col_letter} (protein row {protein_row}): Added formulas\")\n\nwb.save('protein_expression.xlsx')\nprint(\"\\nSaved workbook with statistics formulas\")\n\nEOF\n"]
