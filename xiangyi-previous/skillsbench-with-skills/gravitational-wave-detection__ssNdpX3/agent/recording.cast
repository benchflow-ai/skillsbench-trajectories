[1067.625721, "i", "results = []\n\nmasses = range(10,41)\n\nfor approx in approximants:\n    best_snr = 0.0\n    best_mass = None\n    print('Processing', approx)\n    for m1 in masses:\n        for m2 in masses:\n            try:\n                hp, hc = get_td_waveform(approximant=approx,\n                                         mass1=m1, mass2=m2,\n                                         delta_t=seg.delta_t,\n                                         f_lower=15)\n            except Exception:\n                continue\n            hp.resize(len(seg))\n            snr = matched_filter(hp, seg_freq, psd=psd, low_frequency_cutoff=15)\n            snr = snr.crop(0.5,0.5)\n            peak = np.abs(snr).max()\n            if peak > best_snr:\n                best_snr = peak\n                best_mass = m1 + m2\n    results.append((approx, best_snr, best_mass))\n\nwith open('/root/detection_results.csv','w') as f:\n    f.write('approximant,snr,total_mass\\n')\n    for approx, snr, tmass in results:\n        f.write(f\"{approx},{snr},{tmass}\\n\")\n\nprint('Done, "]
