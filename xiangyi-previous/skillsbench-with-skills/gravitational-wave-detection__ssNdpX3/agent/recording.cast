[363.902198, "i", "python3 - <<'PY'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.psd import interpolate\n\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf','H1:TEST-STRAIN')\nstrain = strain.crop(4,4)\nstrain = strain.highpass_fir(15, 8)\npsd = strain.psd(4)\npsd = interpolate(psd, strain.delta_f)\nwhite = strain.whiten(4,4,psd=psd)\nwhite = white.bandpass(30,300)\nidx = np.abs(white.numpy()).argmax()\nprint('max index', idx)\nprint('time of max', white.sample_times[idx])\nprint('start time', white.sample_times[0], 'end time', white.sample_times[-1])\nPY\n"]
