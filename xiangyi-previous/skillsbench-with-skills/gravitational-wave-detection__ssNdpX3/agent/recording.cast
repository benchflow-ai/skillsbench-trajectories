[1047.870711, "i", "python3 - <<'PY'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter\nfrom pycbc.psd import interpolate\nfrom pycbc.waveform import get_td_waveform\n\n# Read and condition data\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf','H1:TEST-STRAIN')\nstrain = strain.crop(4,4)\nstrain = strain.highpass_fir(15, 8)\n# Resample to 1024 Hz\nstrain = strain.resample(1/1024)\n\n# Estimate PSD from full conditioned data\npsd = strain.psd(4)\npsd = interpolate(psd, strain.delta_f)\n\n# Focus on 4s window around event time\ncenter = 106.8\nstart = center - 2\nend = center + 2\nseg = strain.time_slice(start, end)\n\n# Precompute data frequency series for the segment\nseg_freq = seg.to_frequencyseries()\n\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nresults = []\n\nmasses = range(10,41)\n\nfor approx in approximants:\n    best_snr = 0.0\n    best_mass = None\n    print('Processing', approx)\n    for m1 in masses:\n        for m2 in masses:\n            try:\n                hp, hc = get_td_waveform(approxi"]
[1047.870789, "o", "python3 - <<'PY'\r\nimport numpy as np\r\nfrom pycbc.frame import read_frame\r\nfrom pycbc.filter import matched_filter\r\nfrom pycbc.psd import interpolate\r\nfrom pycbc.waveform import get_td_waveform\r\n\r\n# Read and condition data\r\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf','H1:TEST-STRAIN')\r\nstrain = strain.crop(4,4)\r\nstrain = strain.highpass_fir(15, 8)\r\n# Resample to 1024 Hz\r\nstrain = strain.resample(1/1024)\r\n\r\n# Estimate PSD from full conditioned data\r\npsd = strain.psd(4)\r\npsd = interpolate(psd, strain.delta_f)\r\n\r\n# Focus on 4s window around event time\r\ncenter = 106.8\r\nstart = center - 2\r\nend = center + 2\r\nseg = strain.time_slice(start, end)\r\n\r\n# Precompute data frequency series for the segment\r\nseg_freq = seg.to_frequencyseries()\r\n\r\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\nresults = []\r\n\r\nmasses = range(10,41)\r\n\r\nfor approx in approximants:\r\n    best_snr = 0.0\r\n    best_mass = None\r\n    print('Processing', approx)\r\n    for m1 in masses:\r\n        for m2 in masses:\r\n            try:\r\n         "]
[1047.870802, "i", "mant=approx,\n                                         mass1=m1, mass2=m2,\n                                         delta_t=seg.delta_t,\n                                         f_lower=15)\n            except Exception:\n                continue\n            hp.resize(len(seg))\n            snr = matched_filter(hp, seg_freq, psd=psd, low_frequency_cutoff=15)\n            snr = snr.crop(0.5,0.5)\n            peak = np.abs(snr).max()\n            if peak > best_snr:\n                best_snr = peak\n                best_mass = m1 + m2\n    results.append((approx, best_snr, best_mass))\n\nwith open('/root/detection_results.csv','w') as f:\n    f.write('approximant,snr,total_mass\\n')\n    for approx, snr, tmass in results:\n        f.write(f\"{approx},{snr},{tmass}\\n\")\n\nprint('Done, results written.')\nPY\n"]
[1047.870811, "o", "       hp, hc = get_td_waveform(approxi"]
[1047.871206, "o", "mant=approx,\r\n                                         mass1=m1, mass2=m2,\r\n                                         delta_t=seg.delta_t,\r\n                                         f_lower=15)\r\n            except Exception:\r\n                continue\r\n            hp.resize(len(seg))\r\n            snr = matched_filter(hp, seg_freq, psd=psd, low_frequency_cutoff=15)\r\n            snr = snr.crop(0.5,0.5)\r\n            peak = np.abs(snr).max()\r\n            if peak > best_snr:\r\n                best_snr = peak\r\n                best_mass = m1 + m2\r\n    results.append((approx, best_snr, best_mass))\r\n\r\nwith open('/root/detection_results.csv','w') as f:\r\n    f.write('approximant,snr,total_mass\\n')\r\n    for approx, snr, tmass in results:\r\n        f.write(f\"{approx},{snr},{tmass}\\n\")\r\n\r\nprint('Done, results written.')\r\nPY\r\n"]
