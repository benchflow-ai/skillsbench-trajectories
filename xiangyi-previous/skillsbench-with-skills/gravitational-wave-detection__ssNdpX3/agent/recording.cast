[284.375527, "o", "approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\n\u001b[?2004l\r"]
[284.37555, "o", "\u001b[?2004h"]
[284.375559, "o", "> "]
[284.375589, "o", "results = []\r\n\u001b[?2004l\r"]
[284.375609, "o", "\u001b[?2004h"]
[284.375617, "o", "> "]
[284.375627, "o", "\r\n"]
[284.375636, "o", "\u001b[?2004l\r"]
[284.375646, "o", "\u001b[?2004h"]
[284.375655, "o", "> "]
[284.375704, "o", "masses = range(10,41)\r\n"]
[284.375713, "o", "\u001b[?2004l\r"]
[284.375768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[284.375796, "o", "\u001b[?2004h> "]
[284.375873, "o", "for approx in approximants:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.375893, "o", "    best_snr = 0.0\r\n\u001b[?2004l\r"]
[284.37592, "o", "\u001b[?2004h> "]
[284.375969, "o", "    best_mass = None\r\n\u001b[?2004l\r"]
[284.375978, "o", "\u001b[?2004h> "]
[284.376049, "o", "    print('Processing', approx)\r\n\u001b[?2004l\r"]
[284.376058, "o", "\u001b[?2004h"]
[284.376065, "o", "> "]
[284.376124, "o", "    for m1 in masses:\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.376136, "o", "> "]
[284.376194, "o", "        for m2 in masses:\r\n\u001b[?2004l\r"]
[284.376202, "o", "\u001b[?2004h"]
[284.37621, "o", "> "]
[284.37625, "o", "            try:\r\n\u001b[?2004l\r"]
[284.376259, "o", "\u001b[?2004h"]
[284.376266, "o", "> "]
[284.376398, "o", "                hp, hc = get_td_waveform(approximant=approx,\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.376406, "o", "> "]
[284.376537, "o", "                                         mass1=m1, mass2=m2,\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.376552, "o", "> "]
[284.376683, "o", "                                         delta_t=strain.delta_t,\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.376691, "o", "> "]
[284.376808, "o", "                                         f_lower=15)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.376816, "o", "> "]
[284.376883, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[284.376903, "o", "\u001b[?2004h> "]
[284.376978, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.37699, "o", "> "]
[284.377056, "o", "            hp.resize(len(strain))\r\n\u001b[?2004l\r"]
[284.377068, "o", "\u001b[?2004h"]
[284.377078, "o", "> "]
[284.377239, "o", "            snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=15)\r\n\u001b[?2004l\r"]
[284.377249, "o", "\u001b[?2004h"]
[284.377257, "o", "> "]
[284.377327, "o", "            snr = snr.crop(4,4)\r\n\u001b[?2004l\r"]
[284.377341, "o", "\u001b[?2004h"]
[284.37735, "o", "> "]
[284.377428, "o", "            peak = np.abs(snr).max()\r\n\u001b[?2004l\r"]
[284.377443, "o", "\u001b[?2004h"]
[284.377452, "o", "> "]
[284.378995, "o", "            if peak > best_snr:\r\n\u001b[?2004l\r\u001b[?2004h>                 best_snr = peak\r\n\u001b[?2004l\r\u001b[?2004h>                 best_mass = m1 + m2\r\n\u001b[?2004l\r\u001b[?2004h>     results.append((approx, best_snr, best_mass))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/detection_results.csv','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write('approximant,snr,total_mass\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     for approx, snr, tmass in results:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(f\"{approx},{snr},{tmass}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Done, results written.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
