[625.684086, "i", "python3 - <<'PY'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter\nfrom pycbc.psd import interpolate\nfrom pycbc.waveform import get_td_waveform\n\n# Read and condition data\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf','H1:TEST-STRAIN')\nstrain = strain.crop(4,4)\nstrain = strain.highpass_fir(15, 8)\n\n# Focus on 8s window around event time\ncenter = 106.8\nstart = center - 4\nend = center + 4\nstrain = strain.time_slice(start, end)\n\n# Estimate PSD\npsd = strain.psd(4)\npsd = interpolate(psd, strain.delta_f)\n\n# Precompute data frequency series\nstrain_freq = strain.to_frequencyseries()\n\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nresults = []\n\nmasses = range(10,41)\n\nfor approx in approximants:\n    best_snr = 0.0\n    best_mass = None\n    print('Processing', approx)\n    for m1 in masses:\n        for m2 in masses:\n            try:\n                hp, hc = get_td_waveform(approximant=approx,\n                                         mass1=m1, mass2=m2,\n               "]
[625.68429, "i", "                          delta_t=strain.delta_t,\n                                         f_lower=15)\n            except Exception:\n                continue\n            hp.resize(len(strain))\n            snr = matched_filter(hp, strain_freq, psd=psd, low_frequency_cutoff=15)\n            snr = snr.crop(1,1)\n            peak = np.abs(snr).max()\n            if peak > best_snr:\n                best_snr = peak\n                best_mass = m1 + m2\n    results.append((approx, best_snr, best_mass))\n\nwith open('/root/detection_results.csv','w') as f:\n    f.write('approximant,snr,total_mass\\n')\n    for approx, snr, tmass in results:\n        f.write(f\"{approx},{snr},{tmass}\\n\")\n\nprint('Done, results written.')\nPY\n"]
