[?2004hroot@b76aad112781:~# python3 - <<'PY'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from pycbc.frame import read_frame
[?2004l[?2004h> from pycbc.filter import matched_filter
[?2004l[?2004h> from pycbc.psd import interpolate
[?2004l[?2004h> from pycbc.waveform import get_td_waveform
[?2004l[?2004h> 
[?2004l[?2004h> # Read data
[?2004l[?2004h> strain = read_frame('/root/data/PyCBC_T2_2.gwf','H1:TEST-STRAIN')
[?2004l[?2004h> # Condition: crop edges and highpass
[?2004l[?2004h> strain = strain.crop(4,4)
[?2004l[?2004h> strain = strain.highpass_fir(15, 8)
[?2004l[?2004h> 
[?2004l[?2004h> # Estimate PSD
[?2004l[?2004h> psd = strain.psd(4)
[?2004l[?2004h> psd = interpolate(psd, strain.delta_f)
[?2004l[?2004h> 
[?2004l[?2004h> approximants = ["SEOBNRv4_opt", "IMRPhenomD", "TaylorT4"]
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> # mass grid
[?2004l[?2004h> masses = range(10,41)
[?2004l[?2004h> 
[?2004l[?2004h> for approx in approximants:
[?2004l[?2004h>     best_snr = 0.0
[?2004l[?2004h>     best_mass = None
[?2004l[?2004h>     print('Processing', approx)
[?2004l[?2004h>     for m1 in masses:
[?2004l[?2004h>         for m2 in masses:
[?2004l[?2004h>             # Generate waveform
[?2004l[?2004h>             try:
[?2004l[?2004h>                 hp, hc = get_td_waveform(approximant=approx,
[?2004l[?2004h>                                          mass1=m1, mass2=m2,
[?2004l[?2004h>                                          delta_t=strain.delta_t,
[?2004l[?2004h>                                          f_lower=15)
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # Resize template to match strain length
[?2004l[?2004h>             hp.resize(len(strain))
[?2004l[?2004h>             # Matched filter
[?2004l[?2004h>             snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=15)
[?2004l[?2004h>             # Remove filter transients
[?2004l[?2004h>             snr = snr.crop(4,4)
[?2004l[?2004h>             peak = np.abs(snr).max()
[?2004l[?2004h>             if peak > best_snr:
[?2004l[?2004h>                 best_snr = peak
[?2004l[?2004h>                 best_mass = m1 + m2
[?2004l[?2004h>     results.append((approx, best_snr, best_mass))
[?2004l[?2004h> 
[?2004l[?2004h> # Write CSV
