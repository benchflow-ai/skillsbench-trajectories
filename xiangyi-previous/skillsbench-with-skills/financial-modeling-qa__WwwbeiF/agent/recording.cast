[273.201284, "i", "cat > /root/solve.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom collections import Counter\n\n# Read the data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=7)\n\n# Extract relevant columns\ndata = df[['Unnamed: 2', 'Unnamed: 3', 'Unnamed: 4', 'Unnamed: 5', 'Unnamed: 6', 'Unnamed: 7', 'Unnamed: 8', 'Unnamed: 9']].copy()\ndata.columns = ['Turn', 'Game', 'Roll1', 'Roll2', 'Roll3', 'Roll4', 'Roll5', 'Roll6']\ndata = data.iloc[1:]\ndata = data.dropna(subset=['Turn', 'Game'])\nfor col in data.columns:\n    data[col] = pd.to_numeric(data[col], errors='coerce')\ndata = data.dropna()\ndata = data.astype(int)\n\nprint(f\"Total turns: {len(data)}\")\nprint(f\"Total games: {data['Game'].max()}\")\n\n# Scoring functions\ndef high_and_often(rolls):\n    highest = max(rolls)\n    count = rolls.count(highest)\n    return highest * count\n\ndef summation(rolls):\n    return sum(rolls)\n\ndef highs_and_lows(rolls):\n    highest = max(rolls)\n    lowest = min(rolls)\n    return highest * lowest * (highest - lowest)\n\ndef only_two_numbers(rolls):\n    unique = set(rolls)\n    if len(unique) == 2:\n        return 30\n    return 0\n\ndef all_the_numbers(rolls):\n    if set(rolls) == {1, 2, 3, 4, 5, 6}:\n        return 40\n    return 0\n\ndef ordered_subset_of_four(rolls):\n    for i in range(3):\n        subset = rolls[i:i+4]\n        if all(subset[j+1] == subset[j] + 1 for j in range(3)):\n            return 50\n        if all(subset[j+1] == subset[j] - 1 for j in range(3)):\n            return 50\n    return 0\n\ndef get_all_scores(rolls):\n    return {\n        'high_and_often': high_and_often(rolls),\n        'summation': summation(rolls),\n        'highs_and_lows': highs_and_lows(rolls),\n        'only_two': only_two_numbers(rolls),\n        'all_numbers': all_the_numbers(rolls),\n        'ordered_four': ordered_subset_of_four(rolls)\n    }\n\ndef get_best_game_score(turn1_scores, turn2_scores):\n    categories = list(turn1_scores.keys())\n    best_score = 0\n    for cat1 in categories:\n        for cat2 in categories:\n            if cat1 != cat2:\n                score"]
[273.202034, "i", " = turn1_scores[cat1] + turn2_scores[cat2]\n                if score > best_score:\n                    best_score = score\n    return best_score\n\ndef get_best_single_turn_score(turn_scores):\n    return max(turn_scores.values())\n\n# Group turns by game\ngame_turns = {}\nfor _, row in data.iterrows():\n    game_num = int(row['Game'])\n    rolls = [int(row['Roll1']), int(row['Roll2']), int(row['Roll3']), \n             int(row['Roll4']), int(row['Roll5']), int(row['Roll6'])]\n    if game_num not in game_turns:\n        game_turns[game_num] = []\n    game_turns[game_num].append(get_all_scores(rolls))\n\n# Calculate best score for each game\ngame_scores = {}\nfor game_num in range(1, 3001):\n    if game_num in game_turns:\n        turns = game_turns[game_num]\n        if len(turns) == 2:\n            game_scores[game_num] = get_best_game_score(turns[0], turns[1])\n        elif len(turns) == 1:\n            # For incomplete games, use best single category score\n            game_scores[game_num] = get_best_single_turn_score(turns[0])\n            print(f\"Game {game_num} has only 1 turn, score: {game_scores[game_num]}\")\n\nprint(f\"\\nGames calculated: {len(game_scores)}\")\n\n# Match odd games (Player 1) vs even games (Player 2)\nplayer1_wins = 0\nplayer2_wins = 0\nties = 0\n\nfor i in range(1, 1501):\n    odd_game = 2 * i - 1\n    even_game = 2 * i\n    \n    score1 = game_scores.get(odd_game, 0)\n    score2 = game_scores.get(even_game, 0)\n    \n    if score1 > score2:\n        player1_wins += 1\n    elif score2 > score1:\n        player2_wins += 1\n    else:\n        ties += 1\n\nprint(f\"\\nPlayer 1 wins: {player1_wins}\")\nprint(f\"Player 2 wins: {player2_wins}\")\nprint(f\"Ties: {ties}\")\nprint(f\"\\nAnswer (P1 wins - P2 wins): {player1_wins - player2_wins}\")\n\nwith open('/root/answer.txt', 'w') as f:\n    f.write(str(player1_wins - player2_wins))\n\nprint(\"\\nAnswer written to /root/answer.txt\")\nEOF\n"]
