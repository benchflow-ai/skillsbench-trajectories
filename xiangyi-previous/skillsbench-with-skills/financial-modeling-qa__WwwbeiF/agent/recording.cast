[227.845101, "i", "python3 -c \"\nimport pandas as pd\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=7)\ndata = df[['Unnamed: 2', 'Unnamed: 3', 'Unnamed: 4', 'Unnamed: 5', 'Unnamed: 6', 'Unnamed: 7', 'Unnamed: 8', 'Unnamed: 9']].copy()\ndata.columns = ['Turn', 'Game', 'Roll1', 'Roll2', 'Roll3', 'Roll4', 'Roll5', 'Roll6']\ndata = data.iloc[1:]\ndata = data.dropna(subset=['Turn', 'Game'])\nfor col in data.columns:\n    data[col] = pd.to_numeric(data[col], errors='coerce')\ndata = data.dropna()\ndata = data.astype(int)\n\n# Check which turns are missing\nall_turns = set(range(1, 6001))\nactual_turns = set(data['Turn'].values)\nmissing_turns = all_turns - actual_turns\nprint(f'Missing turns: {sorted(missing_turns)}')\n\n# Check data around turn 15\nprint('\\nData around turn 15:')\nprint(data[data['Turn'].isin([13,14,15,16,17])])\n\"\n"]
[227.849384, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> df = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=7)\r\n\u001b[?2004l\r\u001b[?2004h> data = df[['Unnamed: 2', 'Unnamed: 3', 'Unnamed: 4', 'Unnamed: 5', 'Unnamed: 6', 'Unnamed: 7', 'Unnamed: 8', 'Unnamed: 9']].copy()\r\n\u001b[?2004l\r\u001b[?2004h> data.columns = ['Turn', 'Game', 'Roll1', 'Roll2', 'Roll3', 'Roll4', 'Roll5', 'Roll6']\r\n\u001b[?2004l\r\u001b[?2004h> data = data.iloc[1:]\r\n\u001b[?2004l\r\u001b[?2004h> data = data.dropna(subset=['Turn', 'Game'])\r\n\u001b[?2004l\r\u001b[?2004h> for col in data.columns:\r\n\u001b[?2004l\r\u001b[?2004h>     data[col] = pd.to_numeric(data[col], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h> data = data.dropna()\r\n\u001b[?2004l\r\u001b[?2004h> data = data.astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check which turns are missing\r\n\u001b[?2004l\r\u001b[?2004h> all_turns = set(range(1, 6001))\r\n\u001b[?2004l\r\u001b[?2004h> actual_turns = set(data['Turn'].values)\r\n\u001b[?2004l\r\u001b[?2004h> missing_turns = all_turns - actual_turns\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Missing turns: {sorted(missing_turns)}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check data around turn 15\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nData around turn 15:')\r\n\u001b[?2004l\r\u001b[?2004h> print(data[data['Turn'].isin([13,14,15,16,17])])\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
