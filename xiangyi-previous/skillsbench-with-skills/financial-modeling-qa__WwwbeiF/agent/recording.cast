[336.21941, "i", "python3 -c \"\nrolls = [1, 5, 3, 6, 6, 1]\n\n# high_and_often: highest * count\nhighest = max(rolls)\ncount = rolls.count(highest)\nprint(f'high_and_often: {highest} * {count} = {highest * count}')\n\n# summation\nprint(f'summation: {sum(rolls)}')\n\n# highs_and_lows: highest * lowest * difference\nlowest = min(rolls)\nprint(f'highs_and_lows: {highest} * {lowest} * {highest - lowest} = {highest * lowest * (highest - lowest)}')\n\n# only_two_numbers\nunique = set(rolls)\nprint(f'only_two: unique={unique}, len={len(unique)}, score={30 if len(unique) == 2 else 0}')\n\n# all_the_numbers\nprint(f'all_numbers: {40 if set(rolls) == {1,2,3,4,5,6} else 0}')\n\n# ordered_subset_of_four\nfor i in range(3):\n    subset = rolls[i:i+4]\n    inc = all(subset[j+1] == subset[j] + 1 for j in range(3))\n    dec = all(subset[j+1] == subset[j] - 1 for j in range(3))\n    print(f'  subset {i}: {subset}, inc={inc}, dec={dec}')\n\nprint(f'ordered_four: 0')\n\nprint(f'\\nBest score: {max(12, 22, 30, 0, 0, 0)}')\n\"\n"]
[336.222331, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> rolls = [1, 5, 3, 6, 6, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # high_and_often: highest * count\r\n\u001b[?2004l\r\u001b[?2004h> highest = max(rolls)\r\n\u001b[?2004l\r\u001b[?2004h> count = rolls.count(highest)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'high_and_often: {highest} * {count} = {highest * count}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # summation\r\n\u001b[?2004l\r\u001b[?2004h> print(f'summation: {sum(rolls)}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # highs_and_lows: highest * lowest * difference\r\n\u001b[?2004l\r\u001b[?2004h> lowest = min(rolls)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'highs_and_lows: {highest} * {lowest} * {highest - lowest} = {highest * lowest * (highest - lowest)}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # only_two_numbers\r\n\u001b[?2004l\r\u001b[?2004h> unique = set(rolls)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'only_two: unique={unique}, len={len(unique)}, score={30 if len(unique) == 2 else 0}')"]
