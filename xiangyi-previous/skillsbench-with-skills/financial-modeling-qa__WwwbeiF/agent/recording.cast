[184.657518, "o", "\u001b[?2004h> def highs_and_lows(rolls):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65768, "o", "    \"\"\"Highest * lowest * difference\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.657839, "o", "    highest = max(rolls)\r\n\u001b[?2004l\r\u001b[?2004h>     lowest = min(rolls)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65799, "o", "    return highest * lowest * (highest - lowest)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.658141, "o", "> def only_two_numbers(rolls):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658269, "o", "    \"\"\"30 if all rolls are one of two numbers\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658388, "o", "    unique = set(rolls)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658523, "o", "    if len(unique) == 2:\r\n\u001b[?2004l\r\u001b[?2004h>         return 30\r\n\u001b[?2004l\r"]
[184.658679, "o", "\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.658808, "o", "def all_the_numbers(rolls):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65893, "o", "    \"\"\"40 if rolls are 1-2-3-4-5-6 in any order\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.659056, "o", "    if set(rolls) == {1, 2, 3, 4, 5, 6}:\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.659205, "o", ">         return 40\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r"]
[184.659341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ordered_subset_of_four(rolls):"]
[184.659471, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.65988, "o", "    \"\"\"50 if there's a run of 4 consecutive increasing or decreasing in order rolled\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.660041, "o", "    for i in range(3):  # positions 0,1,2 can start a run of 4\r\n\u001b[?2004l\r\u001b[?2004h>         subset = rolls[i:i+4]\r\n\u001b[?2004l\r"]
[184.660165, "o", "\u001b[?2004h>         # Check increasing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.660367, "o", "        if all(subset[j+1] == subset[j] + 1 for j in range(3)):\r\n\u001b[?2004l\r"]
[184.660491, "o", "\u001b[?2004h>             return 50\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.660621, "o", "        # Check decreasing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.660833, "o", "        if all(subset[j+1] == subset[j] - 1 for j in range(3)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.66095, "o", ">             return 50\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.661072, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.661188, "o", "def get_all_scores(rolls):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.661327, "o", "    \"\"\"Get all possible scores for a turn\"\"\"\r\n\u001b[?2004l\r"]
[184.661685, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h>         'high_and_often': high_and_often(rolls),\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.661866, "o", ">         'summation': summation(rolls),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.662003, "o", "        'highs_and_lows': highs_and_lows(rolls),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.662169, "o", "        'only_two': only_two_numbers(rolls),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.662586, "o", "        'all_numbers': all_the_numbers(rolls),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.662807, "o", "        'ordered_four': ordered_subset_of_four(rolls)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.662956, "o", "\u001b[?2004h> def get_best_game_score(turn1_scores, turn2_scores):\r\n"]
[184.66308, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.663208, "o", "    \"\"\"Find the best combined score using each category at most once\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.663514, "o", "    categories = list(turn1_scores.keys())"]
[184.66493, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     best_score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Try all combinations of assigning categories to turns\r\n\u001b[?2004l\r\u001b[?2004h>     for cat1 in categories:\r\n\u001b[?2004l\r\u001b[?2004h>         for cat2 in categories:\r\n\u001b[?2004l\r\u001b[?2004h>             if cat1 != cat2:  # Can't use same category twice"]
[184.665064, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.665234, "o", "                score = turn1_scores[cat1] + turn2_scores[cat2]"]
[184.666053, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 if score > best_score:\r\n\u001b[?2004l\r\u001b[?2004h>                     best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.666175, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.666272, "o", "    return best_score\r\n\u001b[?2004l\r"]
[184.666383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.666583, "o", "# Calculate scores for each turn"]
[184.666735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> turn_scores = {}"]
[184.666839, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.666929, "o", "for _, row in data.iterrows():"]
[184.667019, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.667104, "o", "> "]
[184.667194, "o", "    turn_num = int(row['Turn'])"]
[184.667285, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.667371, "o", "> "]
[184.667504, "o", "    rolls = [int(row['Roll1']), int(row['Roll2']), int(row['Roll3']), "]
[184.667713, "o", "\r\n\u001b[?2004l\r"]
[184.667804, "o", "\u001b[?2004h> "]
[184.667959, "o", "             int(row['Roll4']), int(row['Roll5']), int(row['Roll6'])]"]
[184.668134, "o", "\r\n\u001b[?2004l\r"]
[184.668221, "o", "\u001b[?2004h> "]
[184.668329, "o", "    turn_scores[turn_num] = get_all_scores(rolls)"]
[184.66847, "o", "\r\n\u001b[?2004l\r"]
[184.668563, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.668661, "o", "> "]
[184.668749, "o", "# Calculate best score for each game"]
[184.668836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.668915, "o", "game_scores = {}"]
[184.669002, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.669088, "o", "for game_num in range(1, 3001):"]
[184.669176, "o", "\r\n\u001b[?2004l\r"]
[184.66927, "o", "\u001b[?2004h> "]
[184.669419, "o", "    # Each game has 2 turns: turn 2*game-1 and turn 2*game"]
[184.669583, "o", "\r\n\u001b[?2004l\r"]
[184.669718, "o", "\u001b[?2004h>     turn1 = 2 * game_num - 1"]
[184.66982, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.669926, "o", ">     turn2 = 2 * game_num"]
[184.670023, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.670143, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.67024, "o", "> "]
[184.670352, "o", "    if turn1 in turn_scores and turn2 in turn_scores:"]
[184.670465, "o", "\r\n\u001b[?2004l\r"]
[184.670775, "o", "\u001b[?2004h> "]
[184.670909, "o", "        game_scores[game_num] = get_best_game_score(turn_scores[turn1], turn_scores[turn2])"]
[184.671017, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.671114, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.671236, "o", "print(f\"Games calculated: {len(game_scores)}\")"]
[184.671389, "o", "\r\n\u001b[?2004l\r"]
[184.671489, "o", "\u001b[?2004h> "]
[184.671629, "o", "print(f\"Sample game scores: {list(game_scores.items())[:10]}\")"]
