[273.226883, "o", "# Match odd games (Player 1) vs even games (Player 2)\r\n\u001b[?2004l\r"]
[273.226991, "o", "\u001b[?2004h> player1_wins = 0\r\n"]
[273.2271, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[273.227188, "o", "player2_wins = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.227273, "o", "> ties = 0\r\n\u001b[?2004l\r"]
[273.227401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.227523, "o", "> for i in range(1, 1501):\r\n\u001b[?2004l\r"]
[273.22761, "o", "\u001b[?2004h> "]
[273.227717, "o", "    odd_game = 2 * i - 1\r\n\u001b[?2004l\r"]
[273.227817, "o", "\u001b[?2004h> "]
[273.227906, "o", "    even_game = 2 * i\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.227997, "o", ">     \r\n\u001b[?2004l\r"]
[273.228082, "o", "\u001b[?2004h> "]
[273.228217, "o", "    score1 = game_scores.get(odd_game, 0)\r\n\u001b[?2004l\r"]
[273.228309, "o", "\u001b[?2004h> "]
[273.228672, "o", "    score2 = game_scores.get(even_game, 0)\r\n"]
[273.228977, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if score1 > score2:"]
[273.229199, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         player1_wins += 1"]
[273.229327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.229477, "o", ">     elif score2 > score1:"]
[273.229581, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.229729, "o", ">         player2_wins += 1"]
[273.229836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.229963, "o", ">     else:"]
[273.230164, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.230353, "o", "        ties += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.230694, "o", "> "]
[273.230866, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nPlayer 1 wins: {player1_wins}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.231111, "o", "> "]
[273.231286, "o", "print(f\"Player 2 wins: {player2_wins}\")\r\n\u001b[?2004l\r"]
[273.231571, "o", "\u001b[?2004h> "]
