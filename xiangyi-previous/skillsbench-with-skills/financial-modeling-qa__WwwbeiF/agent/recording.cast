[184.673668, "o", "\u001b[?2004h> "]
[184.673804, "o", "    even_game = 2 * i     # 2, 4, 6, ..."]
[184.673935, "o", "\r\n\u001b[?2004l\r"]
[184.673984, "o", "\u001b[?2004h"]
[184.674035, "o", ">     "]
[184.674107, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.674154, "o", "> "]
[184.674303, "o", "    score1 = game_scores.get(odd_game, 0)"]
[184.674439, "o", "\r\n\u001b[?2004l\r"]
[184.674482, "o", "\u001b[?2004h"]
[184.674525, "o", "> "]
[184.674657, "o", "    score2 = game_scores.get(even_game, 0)"]
[184.674801, "o", "\r\n\u001b[?2004l\r"]
[184.674846, "o", "\u001b[?2004h"]
[184.674891, "o", ">     "]
[184.674938, "o", "\r\n\u001b[?2004l\r"]
[184.674982, "o", "\u001b[?2004h> "]
[184.675078, "o", "    if score1 > score2:"]
[184.675165, "o", "\r\n\u001b[?2004l\r"]
[184.675213, "o", "\u001b[?2004h"]
[184.675258, "o", "> "]
[184.675337, "o", "        player1_wins += 1"]
[184.675428, "o", "\r\n\u001b[?2004l\r"]
[184.675473, "o", "\u001b[?2004h"]
[184.675516, "o", "> "]
[184.67559, "o", "    elif score2 > score1:"]
[184.675693, "o", "\r\n\u001b[?2004l\r"]
[184.675744, "o", "\u001b[?2004h> "]
[184.67585, "o", "        player2_wins += 1"]
[184.675945, "o", "\r\n\u001b[?2004l\r"]
[184.675988, "o", "\u001b[?2004h"]
[184.676034, "o", "> "]
[184.676079, "o", "    else:\r\n"]
[184.676124, "o", "\u001b[?2004l\r\u001b[?2004h"]
[184.676166, "o", "> "]
[184.67624, "o", "        ties += 1"]
