[?2004hroot@f130cffd859a:~# cat << 'EOF' > calculate_dots.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> file_path = '/root/data/openipf.xlsx'
[?2004l[?2004h> wb = openpyxl.load_workbook(file_path)
[?2004l[?2004h> source = wb['Data']
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure Dots sheet is clean
[?2004l[?2004h> if 'Dots' in wb.sheetnames:
[?2004l[?2004h>     del wb['Dots']
[?2004l[?2004h> dest = wb.create_sheet('Dots')
[?2004l[?2004h> 
[?2004l[?2004h> # Headers
[?2004l[?2004h> headers = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg', 'TotalKg', 'Dots']
[?2004l[?2004h> dest.append(headers)
[?2004l[?2004h> 
[?2004l[?2004h> # Coefficients
[?2004l[?2004h> # Male
[?2004l[?2004h> mM = [-0.0000010930, 0.0007391293, -0.1918759221, 24.0900756, -307.75076]
[?2004l[?2004h> # Female
[?2004l[?2004h> mF = [-0.0000010706, 0.0005158568, -0.1126655495, 13.6175032, -57.96288]
[?2004l[?2004h> 
[?2004l[?2004h> rows = list(source.iter_rows(min_row=2, values_only=True))
[?2004l[?2004h> 
[?2004l[?2004h> for i, row in enumerate(rows, start=2):
[?2004l[?2004h>     # Extract values based on indices: Name(0), Sex(1), Bw(8), Sq(10), Bn(11), Dl(12)
[?2004l[?2004h>     name = row[0]
[?2004l[?2004h>     sex = row[1]
[?2004l[?2004h>     bw = row[8]
[?2004l[?2004h>     squat = row[10]
[?2004l[?2004h>     bench = row[11]
[?2004l[?2004h>     deadlift = row[12]
[?2004l[?2004h>     
[?2004l[?2004h>     # Write to Dots sheet
[?2004l[?2004h>     dest.cell(row=i, column=1, value=name)
[?2004l[?2004h>     dest.cell(row=i, column=2, value=sex)
[?2004l[?2004h>     dest.cell(row=i, column=3, value=bw)
[?2004l[?2004h>     dest.cell(row=i, column=4, value=squat)
[?2004l[?2004h>     dest.cell(row=i, column=5, value=bench)
[?2004l[?2004h>     dest.cell(row=i, column=6, value=deadlift)
[?2004l[?2004h>     
[?2004l[?2004h>     # TotalKg Formula: SUM(D:F)
[?2004l[?2004h>     dest.cell(row=i, column=7, value=f"=SUM(D{i}:F{i})")
[?2004l[?2004h>     
[?2004l[?2004h>     # Dots Formula
[?2004l[?2004h>     # C is Bodyweight, G is TotalKg, B is Sex
[?2004l[?2004h>     bw_ref = f"C{i}"
[?2004l[?2004h>     
[?2004l[?2004h>     term_m = f"({mM[0]}*{bw_ref}^4+{mM[1]}*{bw_ref}^3+{mM[2]}*{bw_ref}^2+{mM[3]}*{bw_ref}+{mM[4]})"
[?2004l[?2004h>     term_f = f"({mF[0]}*{bw_ref}^4+{mF[1]}*{bw_ref}^3+{mF[2]}*{bw_ref}^2+{mF[3]}*{bw_ref}+{mF[4]})"
[?2004l[?2004h>     
[?2004l[?2004h>     # Formula: ROUND( Total * 500 / Poly, 3)
[?2004l[?2004h>     formula = f"=ROUND(G{i}*500/IF(B{i}=\"M\",{term_m},{term_f}),3)"
[?2004l[?2004h>     dest.cell(row=i, column=8, value=formula)
[?2004l[?2004h> 
[?2004l[?2004h> wb.save(file_path)
[?2004l[?2004h> print("Processing complete.")
[?2004l[?2004h> EOF
