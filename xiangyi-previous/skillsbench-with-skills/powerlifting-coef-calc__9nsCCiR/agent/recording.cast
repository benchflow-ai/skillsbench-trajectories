[296.499557, "o", "    deadlift = row[12]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[296.49964, "o", "\u001b[?2004h> "]
[296.499716, "o", "    # Write to Dots sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.499792, "o", "    dest.cell(row=i, column=1, value=name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.499854, "o", "> "]
[296.499927, "o", "    dest.cell(row=i, column=2, value=sex)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.500256, "o", "    dest.cell(row=i, column=3, value=bw)\r\n\u001b[?2004l\r\u001b[?2004h>     dest.cell(row=i, column=4, value=squat)\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.500356, "o", ">     dest.cell(row=i, column=5, value=bench)\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.500435, "o", "> "]
[296.500533, "o", "    dest.cell(row=i, column=6, value=deadlift)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[296.50061, "o", "\u001b[?2004h> "]
[296.500692, "o", "    # TotalKg Formula: SUM(D:F)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.500861, "o", "    dest.cell(row=i, column=7, value=f\"=SUM(D{i}:F{i})\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[296.500941, "o", "\u001b[?2004h>     # Dots Formula\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.501081, "o", "    # C is Bodyweight, G is TotalKg, B is Sex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.501176, "o", "    bw_ref = f\"C{i}\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[296.501237, "o", "\u001b[?2004h> "]
[296.501462, "o", "    term_m = f\"({mM[0]}*{bw_ref}^4+{mM[1]}*{bw_ref}^3+{mM[2]}*{bw_ref}^2+{mM[3]}*{bw_ref}+{mM[4]})\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.501942, "o", "    term_f = f\"({mF[0]}*{bw_ref}^4+{mF[1]}*{bw_ref}^3+{mF[2]}*{bw_ref}^2+{mF[3]}*{bw_ref}+{mF[4]})\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Formula: ROUND( Total * 500 / Poly, 3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.502246, "o", "    formula = f\"=ROUND(G{i}*500/IF(B{i}=\\\"M\\\",{term_m},{term_f}),3)\"\r\n\u001b[?2004l\r\u001b[?2004h>     dest.cell(row=i, column=8, value=formula)\r\n\u001b[?2004l\r"]
[296.502326, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save(file_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.50242, "o", "print(\"Processing complete.\")\r\n\u001b[?2004l\r"]
[296.502486, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[296.508207, "o", "\u001b[?2004h"]
[296.508522, "o", "root@f130cffd859a:~# "]
[296.508644, "o", "python3 calculate_dots.py"]
[296.508827, "o", "\r\n"]
[296.508901, "o", "\u001b[?2004l\r"]
[296.689739, "o", "Processing complete.\r\n"]
[296.710102, "o", "\u001b[?2004hroot@f130cffd859a:~# "]
