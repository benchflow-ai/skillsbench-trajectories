[296.49248, "i", "cat << 'EOF' > calculate_dots.py\nimport openpyxl\n\nfile_path = '/root/data/openipf.xlsx'\nwb = openpyxl.load_workbook(file_path)\nsource = wb['Data']\n\n# Ensure Dots sheet is clean\nif 'Dots' in wb.sheetnames:\n    del wb['Dots']\ndest = wb.create_sheet('Dots')\n\n# Headers\nheaders = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg', 'TotalKg', 'Dots']\ndest.append(headers)\n\n# Coefficients\n# Male\nmM = [-0.0000010930, 0.0007391293, -0.1918759221, 24.0900756, -307.75076]\n# Female\nmF = [-0.0000010706, 0.0005158568, -0.1126655495, 13.6175032, -57.96288]\n\nrows = list(source.iter_rows(min_row=2, values_only=True))\n\nfor i, row in enumerate(rows, start=2):\n    # Extract values based on indices: Name(0), Sex(1), Bw(8), Sq(10), Bn(11), Dl(12)\n    name = row[0]\n    sex = row[1]\n    bw = row[8]\n    squat = row[10]\n    bench = row[11]\n    deadlift = row[12]\n    \n    # Write to Dots sheet\n    dest.cell(row=i, column=1, value=name)\n    dest.cell(row=i, column=2, value=sex)\n    dest.cell(row=i, column=3, value=bw)\n    dest.cell(row=i, column=4, value=squat)\n    dest.cell(row=i, column=5, value=bench)\n    dest.cell(row=i, column=6, value=deadlift)\n    \n    # TotalKg Formula: SUM(D:F)\n    dest.cell(row=i, column=7, value=f\"=SUM(D{i}:F{i})\")\n    \n    # Dots Formula\n    # C is Bodyweight, G is TotalKg, B is Sex\n    bw_ref = f\"C{i}\"\n    \n    term_m = f\"({mM[0]}*{bw_ref}^4+{mM[1]}*{bw_ref}^3+{mM[2]}*{bw_ref}^2+{mM[3]}*{bw_ref}+{mM[4]})\"\n    term_f = f\"({mF[0]}*{bw_ref}^4+{mF[1]}*{bw_ref}^3+{mF[2]}*{bw_ref}^2+{mF[3]}*{bw_ref}+{mF[4]})\"\n    \n    # Formula: ROUND( Total * 500 / Poly, 3)\n    formula = f\"=ROUND(G{i}*500/IF(B{i}=\\\"M\\\",{term_m},{term_f}),3)\"\n    dest.cell(row=i, column=8, value=formula)\n\nwb.save(file_path)\nprint(\"Processing complete.\")\nEOF\npython3 calculate_dots.py\n"]
[296.492766, "o", "cat << 'EOF' > calculate_dots.py\r\n"]
