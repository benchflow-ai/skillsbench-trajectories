[318.436124, "o", "python3 -c \"import openpyxl; wb = openpyxl.load_workbook('/root/data/openipf.xlsx'); sheet = wb['Dots']; print('Headers:', [c.value for c in sheet[1]]); print('Row 2 Values:', [c.value for c in sheet[2]])\"\r\n\u001b[?2004l\r"]
