[80.79309, "o", "            bonus += 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.793151, "o", "    return bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
