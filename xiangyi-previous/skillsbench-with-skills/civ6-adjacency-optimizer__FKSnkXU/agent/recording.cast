[107.549243, "o", "            for dist_type, dist_plot in placements.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549386, "o", "                bonus = calculate_bonus(dist_plot, dist_type, width, height, plots)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549492, "o", "                bonuses[dist_type] = bonus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549542, "o", "                total += bonus\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549653, "o", "            if total > best_total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549749, "o", "                best_total = total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.549893, "o", "                best_solution = {\r\n\u001b[?2004l\r\u001b[?2004h>                     'city_center': city_center_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550026, "o", "                    'placements': placements,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.55012, "o", "                    'bonuses': bonuses,\r\n\u001b[?2004l\r\u001b[?2004h>                     'total': total\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550207, "o", "if best_solution:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550253, "o", "    print(f\"Best solution found!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550498, "o", "    print(f\"City center: Plot {best_solution['city_center']} at ({plots[best_solution['city_center']]['x']}, {plots[best_solution['city_center']]['y']})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550597, "o", "    print(f\"\\nDistrict placements:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550679, "o", "    for dist_type, plot_id in best_solution['placements'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550719, "o", "        p = plots[plot_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550845, "o", "        bonus = best_solution['bonuses'][dist_type]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.550985, "o", "        print(f\"  {dist_type}: Plot {plot_id} at ({p['x']}, {p['y']}) - Bonus: {bonus}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.551095, "o", "    print(f\"\\nTotal adjacency bonus: {best_solution['total']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.551168, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.551263, "o", "    print(\"No valid solution found\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[107.575423, "o", "Evaluating 37 potential city center locations...\r\n\r\n"]
[107.592095, "o", "Best solution found!\r\nCity center: Plot 593 at (21, 13)\r\n\r\nDistrict placements:\r\n  CAMPUS: Plot 550 at (22, 12) - Bonus: 1\r\n  COMMERCIAL_HUB: Plot 592 at (20, 13) - Bonus: 2.0\r\n  INDUSTRIAL_ZONE: Plot 637 at (21, 14) - Bonus: 0.5\r\n\r\nTotal adjacency bonus: 3.5\r\n"]
[107.595741, "o", "\u001b[?2004hroot@e576be6b9300:~# "]
[119.646382, "i", "python3 << 'EOF'\nimport sqlite3\nimport json\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\ncursor.execute(\"\"\"\n    SELECT p.ID, p.TerrainType, p.IsImpassable,\n           COALESCE(pf.FeatureType, 'NONE') as Feature\n    FROM Plots p\n    LEFT JOIN PlotFeatures pf ON p.ID = pf.ID\n\"\"\")\n\nplots = {}\nfor plot_id, terrain, impassable, feature in cursor.fetchall():\n    x = plot_id % width\n    y = plot_id // width\n    plots[plot_id] = {\n        'id': plot_id,\n        'x': x,\n        'y': y,\n        'terrain': terrain,\n        'impassable': impassable,\n        'feature': feature\n    }\n\nconn.close()\n\n# Solution\ncity_center_id = 593\nplacements = {\n    'CAMPUS': 550,\n    'COMMERCIAL_HUB': 592,\n    'INDUSTRIAL_ZONE': 637\n}\nadj_bonuses = {\n    'CAMPUS': 1,\n    'COMMERCIAL_HUB': 2.0,\n    'INDUSTRIAL_ZONE': 0.5\n}\n\n# Verify city center is valid\ncity_p = plots[city_center_id]\nprint(f\"City center validation:\")\nprint(f\"  Plot ID: {city_center_id}\")\nprint(f\"  Coordinates: ({city_p['x']}, {city_p['y']})\")\nprint(f\"  Terrain: {city_p['terrain']}\")\nprint(f\"  Impassable: {city_p['impassable']}\")\nprint(f\"  Valid: {city_p['terrain'] != 'TERRAIN_OCEAN' and not city_p['impassable']}\")\n\n# Verify district placements\nprint(f\"\\nDistrict placements validation:\")\nfor dist_type, plot_id in placements.items():\n    p = plots[plot_id]\n    print(f\"  {dist_type} at plot {plot_id}:\")\n    print(f\"    Coordinates: ({p['x']}, {p['y']})\")\n    print(f\"    Terrain: {p['terrain']}\")\n    print(f\"    Impassable: {p['impassable']}\")\n    print(f\"    Valid: {p['terrain'] != 'TERRAIN_OCEAN' and not p['impassable']}\")\n\n# Create output\nsolution = {\n    \"city_center\": [city_p['x'], city_p['y']],\n    \"placements\": {\n        \"CAMPUS\": [plots[placements['CAMPUS']]['x'], plots[placements['CAMPUS']]['y']],\n        \"COMMERCIAL_HUB\": [plots[placements['COMMERCIAL_HUB']]['x'], plots[placements['COMMERCIAL_HUB']]['y']],\n        \"INDUSTRIAL_ZONE\": [plots[placements['INDUSTRIAL_ZONE']]['x'], plots[placements['INDUSTRIAL_ZONE']]['y']]\n    },\n    \"adjacency_bonuses\": adj_bonuses,\n    \"total_adjacency\": sum(adj_bonuses.values())\n}\n\nprint(f\"\\nOutput JSON:\")\nprint(json.dumps(solution, indent=2))\n\n# Write to file\nimport os\nos.makedirs('/output', exist_ok=True)\nwith open('/output/scenario_3.json', 'w') as f:\n    json.dump(solution, f, indent=2)\n\nprint(f\"\\nSolution written to /output/scenario_3.json\")\n\nEOF\n"]
