[39.59646, "o", "    columns = cursor.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.59651, "o", ">     for col in columns:\r\n\u001b[?2004l\r"]
[39.596557, "o", "\u001b[?2004h> "]
