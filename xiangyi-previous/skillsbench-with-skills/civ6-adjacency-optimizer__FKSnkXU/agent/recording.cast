[80.789382, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.789517, "o", "    for adj_id in get_adjacent_plots(plot_id, width, height):\r\n\u001b[?2004l\r"]
[80.789551, "o", "\u001b[?2004h> "]
[80.789631, "o", "        p = plots[adj_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.789734, "o", "        if 'MOUNTAIN' in p['terrain']:\r\n\u001b[?2004l\r"]
[80.78977, "o", "\u001b[?2004h> "]
[80.789848, "o", "            bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.789951, "o", "        if 'FOREST' in p['feature']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.789985, "o", "> "]
[80.790071, "o", "            bonus += 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.790125, "o", "    return bonus\r\n\u001b[?2004l\r"]
[80.79016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.790196, "o", "> "]
