[80.791086, "o", "            bonus += 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.791121, "o", "    return bonus\r\n\u001b[?2004l\r"]
[80.791153, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.791188, "o", "\u001b[?2004h> "]
