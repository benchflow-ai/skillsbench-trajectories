[53.906245, "i", "python3 << 'EOF'\nimport sqlite3\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get map dimensions\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\n\n# Get all land plots (non-ocean)\nprint(\"Land plots (ID, X, Y, Terrain):\")\ncursor.execute(\"\"\"\n    SELECT ID, TerrainType, IsImpassable FROM Plots \n    WHERE TerrainType != 'TERRAIN_OCEAN' \n    ORDER BY ID\n\"\"\")\n\nland_plots = []\nfor plot_id, terrain, impassable in cursor.fetchall():\n    x = plot_id % width\n    y = plot_id // width\n    land_plots.append((plot_id, x, y, terrain, impassable))\n    print(f\"  ID {plot_id}: ({x}, {y}) {terrain} Impassable:{impassable}\")\n\nprint(f\"\\nTotal land plots: {len(land_plots)}\")\n\n# Check features on land plots\nprint(\"\\nFeatures on land plots:\")\nfor plot_id, x, y, terrain, _ in land_plots:\n    cursor.execute(\"SELECT FeatureType FROM PlotFeatures WHERE ID = ?\", (plot_id,))\n    features = cursor.fetchall()\n    if features:\n        for feature in features:\n            print(f\"  Plot {plot_id} ({x},{y}): {feature[0]}\")\n\n# Check resources on land plots\nprint(\"\\nResources on land plots:\")\nfor plot_id, x, y, terrain, _ in land_plots:\n    cursor.execute(\"SELECT ResourceType, ResourceCount FROM PlotResources WHERE ID = ?\", (plot_id,))\n    resources = cursor.fetchall()\n    if resources:\n        for resource in resources:\n            print(f\"  Plot {plot_id} ({x},{y}): {resource[0]} x{resource[1]}\")\n\nconn.close()\nEOF\n"]
