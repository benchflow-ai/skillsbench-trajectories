[80.783373, "o", "           COALESCE(pf.FeatureType, 'NONE') as Feature\r\n\u001b[?2004l\r"]
[80.783408, "o", "\u001b[?2004h> "]
[80.783501, "o", "    FROM Plots p\r\n\u001b[?2004l\r"]
[80.783565, "o", "\u001b[?2004h> "]
[80.783776, "o", "    LEFT JOIN PlotFeatures pf ON p.ID = pf.ID\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.783841, "o", "> \"\"\")\r\n\u001b[?2004l\r"]
[80.783908, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.783972, "o", "plots = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.784033, "o", "> "]
