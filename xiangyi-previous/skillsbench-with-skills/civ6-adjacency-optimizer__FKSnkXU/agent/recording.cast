[39.596777, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[39.689425, "o", "Tables in database:\r\n  MetaData\r\n  Map\r\n  MapAttributes\r\n  Plots\r\n  PlotAttributes\r\n  PlotRivers\r\n  PlotCliffs\r\n  PlotResources\r\n  PlotFeatures\r\n  PlotImprovements\r\n  PlotRoutes\r\n  PlotOwners\r\n  RevealedPlots\r\n  StartPositions\r\n  Units\r\n  UnitAttributes\r\n  Cities\r\n  CityAttributes\r\n  Districts\r\n  DistrictAttributes\r\n  Buildings\r\n  Players\r\n  PlayerAttributes\r\n  ModProperties\r\n  ModComponents\r\n"]
[39.689657, "o", "  ModComponent_Properties\r\n  ModComponent_Items\r\n  ModSettings\r\n  ModSettings_Properties\r\n  ModSettings_Items\r\n  ModText\r\n  ModDependencies\r\n  GameConfig\r\n  NamedRiverPlot\r\n  NamedRiver\r\n\r\nSchema for MetaData:\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for Map:\r\n  ID (TEXT)\r\n  Width (INTEGER)\r\n  Height (INTEGER)\r\n  TopLatitude (INTEGER)\r\n  BottomLatitude (INTEGER)\r\n  WrapX (BOOLEAN)\r\n  WrapY (BOOLEAN)"]
[39.689723, "o", "\r\n  MapSizeType (TEXT)\r\n\r\nSchema for MapAttributes:\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for Plots:\r\n  ID (INTEGER)\r\n  TerrainType (TEXT)\r\n  ContinentType (TEXT)\r\n  IsImpassable (BOOLEAN)\r\n\r\nSchema for PlotAttributes:\r\n  ID (INTEGER)\r\n  Type (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for PlotRivers:\r\n  ID (INTEGER)\r\n  IsNEOfRiver (BOOLEAN)\r\n  IsWOfRiver (BOOLEAN)\r\n  IsNWOfRiver (BOOLEAN)\r\n  EFlowDirection (INTEGER)\r\n  SEFlowDirection (INTEGER)\r\n  SWFlowDirection (INTEGER)\r\n\r\nSchema for PlotCliffs:\r\n  ID (INTEGER)\r\n  IsNEOfCliff (BOOLEAN)\r\n  IsWOfCliff (BOOLEAN)\r\n  IsNWOfCliff (BOOLEAN)\r\n\r\nSchema for PlotResources:\r\n  ID (INTEGER)\r\n  ResourceType (TEXT)\r\n  ResourceCount (INTEGER)\r\n\r\nSchema for PlotFeatures:\r\n"]
[39.689775, "o", "  ID (INTEGER)\r\n  FeatureType (TEXT)\r\n\r\nSchema for PlotImprovements:\r\n  ID (INTEGER)\r\n  ImprovementType (TEXT)\r\n  ImprovementOwner (INTEGER)\r\n\r\nSchema for PlotRoutes:\r\n"]
[39.689827, "o", "  ID (INTEGER)\r\n  RouteType (TEXT)\r\n  RouteEra (TEXT)\r\n  IsRoutePillaged (BOOLEAN)\r\n\r\nSchema for PlotOwners:\r\n  ID (INTEGER)\r\n  Owner (INTEGER)\r\n  CityOwner (INTEGER)\r\n  CityWorking (INTEGER)\r\n\r\nSchema for RevealedPlots:\r\n  ID (INTEGER)\r\n  Player (INTEGER)\r\n\r\n"]
[39.689876, "o", "Schema for StartPositions:\r\n  Plot (INTEGER)\r\n  Type (STRING)\r\n  Value (STRING)\r\n"]
[39.689923, "o", "\r\nSchema for Units:\r\n  ID (INTEGER)\r\n  UnitType (TEXT)\r\n  Owner (INTEGER)\r\n  Plot (INTEGER)\r\n  Name (TEXT)\r\n\r\nSchema for UnitAttributes:\r\n  ID (INTEGER)\r\n  Type (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for Cities:\r\n"]
[39.689989, "o", "  Owner (INTEGER)\r\n  Plot (INTEGER)\r\n  Name (TEXT)\r\n\r\nSchema for CityAttributes:\r\n"]
[39.690035, "o", "  ID (INTEGER)\r\n  Type (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for Districts:\r\n  DistrictType (TEXT)\r\n  CityID (INTEGER)\r\n  Plot (INTEGER)\r\n\r\nSchema for DistrictAttributes:\r\n  ID (INTEGER)\r\n  Type (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for Buildings:\r\n"]
[39.690085, "o", "  BuildingType (TEXT)\r\n  Plot (INTEGER)\r\n\r\nSchema for Players:\r\n"]
[39.69014, "o", "  ID (INTEGER)\r\n  CivilizationType (TEXT)\r\n  LeaderType (TEXT)\r\n  CivilizationLevelType (TEXT)\r\n  AgendaType (TEXT)\r\n  Status (TEXT)\r\n  Handicap (TEXT)\r\n  StartingPosition (TEXT)\r\n  Color (TEXT)\r\n  Initialized (BOOLEAN)\r\n\r\nSchema for PlayerAttributes:\r\n"]
[39.690199, "o", "  ID (INTEGER)\r\n  Type (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModProperties:\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModComponents:\r\n  Type (TEXT)\r\n  ID (TEXT)\r\n\r\nSchema for ModComponent_Properties:"]
[39.690246, "o", "\r\n  Type (TEXT)\r\n  ID (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModComponent_Items:\r\n  Type (TEXT)\r\n  ID (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModSettings:\r\n  Type (TEXT)\r\n  ID (TEXT)\r\n\r\nSchema for ModSettings_Properties:"]
[39.6903, "o", "\r\n  Type (TEXT)\r\n  ID (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModSettings_Items:\r\n"]
[39.69035, "o", "  Type (TEXT)\r\n  ID (TEXT)\r\n  Name (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModText:\r\n  Language (TEXT)\r\n  ID (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for ModDependencies:\r\n"]
[39.690401, "o", "  ID (TEXT)\r\n  Title (TEXT)\r\n\r\nSchema for GameConfig:\r\n  ID (TEXT)\r\n  Value (TEXT)\r\n\r\nSchema for NamedRiverPlot:\r\n"]
[39.690451, "o", "  ID (INTEGER)\r\n  PlotIndex (INTEGER)\r\n  Edge (INTEGER)\r\n\r\nSchema for NamedRiver:\r\n  ID (INTEGER)\r\n  Type (TEXT)\r\n  DiscoveringCiv (TEXT)\r\n  CustomName (TEXT)\r\n"]
[39.694447, "o", "\u001b[?2004hroot@e576be6b9300:~# "]
[46.39613, "i", "python3 << 'EOF'\nimport sqlite3\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get map dimensions\ncursor.execute(\"SELECT Width, Height FROM Map;\")\nwidth, height = cursor.fetchone()\nprint(f\"Map dimensions: {width}x{height}\")\nprint(f\"Total plots: {width * height}\")\n\n# Get terrain types distribution\nprint(\"\\nTerrain types:\")\ncursor.execute(\"SELECT TerrainType, COUNT(*) FROM Plots GROUP BY TerrainType;\")\nfor terrain, count in cursor.fetchall():\n    print(f\"  {terrain}: {count}\")\n\n# Check existing cities\nprint(\"\\nExisting cities:\")\ncursor.execute(\"SELECT Owner, Plot, Name FROM Cities;\")\ncities = cursor.fetchall()\nif cities:\n    for city in cities:\n        print(f\"  Owner {city[0]}, Plot {city[1]}, Name: {city[2]}\")\nelse:\n    print(\"  No cities yet\")\n\n# Check existing districts\nprint(\"\\nExisting districts:\")\ncursor.execute(\"SELECT DistrictType, CityID, Plot FROM Districts;\")\ndistricts = cursor.fetchall()\nif districts:\n    for dist in districts:\n        print(f\"  {dist[0]}, CityID {dist[1]}, Plot {dist[2]}\")\nelse:\n    print(\"  No districts yet\")\n\nconn.close()\nEOF\n"]
