[80.78456, "o", "> "]
[80.784655, "o", "    y = plot_id // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.784768, "o", "    plots[plot_id] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
