[?2004l[?2004h> # Get schema for each table
[?2004l[?2004h> for table in tables:
[?2004l[?2004h>     print(f"\nSchema for {table[0]}:")
[?2004l[?2004h>     cursor.execute(f"PRAGMA table_info({table[0]});")
[?2004l[?2004h>     columns = cursor.fetchall()
[?2004l[?2004h>     for col in columns:
[?2004l[?2004h>         print(f"  {col[1]} ({col[2]})")
[?2004l[?2004h> 
