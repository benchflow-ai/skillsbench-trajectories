[?2004hroot@e576be6b9300:~# python3 << 'EOF'
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get map dimensions
[?2004l[?2004h> cursor.execute("SELECT Width, Height FROM Map;")
[?2004l[?2004h> width, height = cursor.fetchone()
[?2004l[?2004h> print(f"Map dimensions: {width}x{height}")
[?2004l[?2004h> print(f"Total plots: {width * height}")
[?2004l[?2004h> 
[?2004l[?2004h> # Get terrain types distribution
[?2004l[?2004h> print("\nTerrain types:")
[?2004l[?2004h> cursor.execute("SELECT TerrainType, COUNT(*) FROM Plots GROUP BY TerrainType;")
[?2004l[?2004h> for terrain, count in cursor.fetchall():
[?2004l[?2004h>     print(f"  {terrain}: {count}")
[?2004l[?2004h> 
[?2004l[?2004h> # Check existing cities
[?2004l[?2004h> print("\nExisting cities:")
[?2004l[?2004h> cursor.execute("SELECT Owner, Plot, Name FROM Cities;")
[?2004l[?2004h> cities = cursor.fetchall()
[?2004l[?2004h> if cities:
[?2004l[?2004h>     for city in cities:
[?2004l[?2004h>         print(f"  Owner {city[0]}, Plot {city[1]}, Name: {city[2]}")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("  No cities yet")
[?2004l[?2004h> 
[?2004l[?2004h> # Check existing districts
[?2004l[?2004h> print("\nExisting districts:")
[?2004l[?2004h> cursor.execute("SELECT DistrictType, CityID, Plot FROM Districts;")
[?2004l[?2004h> districts = cursor.fetchall()
[?2004l[?2004h> if districts:
[?2004l[?2004h>     for dist in districts:
[?2004l[?2004h>         print(f"  {dist[0]}, CityID {dist[1]}, Plot {dist[2]}")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("  No districts yet")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
