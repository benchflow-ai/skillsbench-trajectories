[?2004hroot@e576be6b9300:~# python3 << 'EOF'
[?2004l[?2004h> import sqlite3
[?2004l[?2004h> 
[?2004l[?2004h> conn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')
[?2004l[?2004h> cursor = conn.cursor()
[?2004l[?2004h> 
[?2004l[?2004h> # Get map dimensions
[?2004l[?2004h> cursor.execute("SELECT Width, Height FROM Map;")
[?2004l[?2004h> width, height = cursor.fetchone()
[?2004l[?2004h> 
[?2004l[?2004h> # Get all land plots (non-ocean)
[?2004l[?2004h> print("Land plots (ID, X, Y, Terrain):")
[?2004l[?2004h> cursor.execute("""
[?2004l[?2004h>     SELECT ID, TerrainType, IsImpassable FROM Plots 
[?2004l[?2004h>     WHERE TerrainType != 'TERRAIN_OCEAN' 
[?2004l[?2004h>     ORDER BY ID
[?2004l[?2004h> """)
[?2004l[?2004h> 
[?2004l[?2004h> land_plots = []
[?2004l[?2004h> for plot_id, terrain, impassable in cursor.fetchall():
[?2004l[?2004h>     x = plot_id % width
[?2004l[?2004h>     y = plot_id // width
[?2004l[?2004h>     land_plots.append((plot_id, x, y, terrain, impassable))
[?2004l[?2004h>     print(f"  ID {plot_id}: ({x}, {y}) {terrain} Impassable:{impassable}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal land plots: {len(land_plots)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Check features on land plots
[?2004l[?2004h> print("\nFeatures on land plots:")
[?2004l[?2004h> for plot_id, x, y, terrain, _ in land_plots:
[?2004l[?2004h>     cursor.execute("SELECT FeatureType FROM PlotFeatures WHERE ID = ?", (plot_id,))
[?2004l[?2004h>     features = cursor.fetchall()
[?2004l[?2004h>     if features:
[?2004l[?2004h>         for feature in features:
[?2004l[?2004h>             print(f"  Plot {plot_id} ({x},{y}): {feature[0]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Check resources on land plots
[?2004l[?2004h> print("\nResources on land plots:")
[?2004l[?2004h> for plot_id, x, y, terrain, _ in land_plots:
[?2004l[?2004h>     cursor.execute("SELECT ResourceType, ResourceCount FROM PlotResources WHERE ID = ?", (plot_id,))
[?2004l[?2004h>     resources = cursor.fetchall()
[?2004l[?2004h>     if resources:
[?2004l[?2004h>         for resource in resources:
[?2004l[?2004h>             print(f"  Plot {plot_id} ({x},{y}): {resource[0]} x{resource[1]}")
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
