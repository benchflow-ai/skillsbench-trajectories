[75.980914, "o", "    if bucket_counts:\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[75.981027, "o", "        ppm_values = list(bucket_counts.values())\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.981076, "o", "> "]
[75.981218, "o", "        metrics['packets_per_minute_avg'] = sum(ppm_values) / len(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.981341, "o", "        metrics['packets_per_minute_max'] = max(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.981394, "o", "> "]
[75.981478, "o", "        metrics['packets_per_minute_min'] = min(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.981523, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.981609, "o", "    metrics['duration_seconds'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.981662, "o", "> "]
[75.981726, "o", "    metrics['packets_per_minute_avg'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.981773, "o", "> "]
[75.981819, "o", "    metrics['packets_per_minute_max'] = 0\r\n\u001b[?2004l\r"]
[75.981842, "o", "\u001b[?2004h> "]
[75.981926, "o", "    metrics['packets_per_minute_min'] = 0\r\n\u001b[?2004l\r"]
[75.981976, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98203, "o", "# Size statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.982107, "o", "metrics['total_bytes'] = sum(packet_lengths)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.982159, "o", "> "]
[75.982319, "o", "metrics['avg_packet_size'] = sum(packet_lengths) / len(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.982484, "o", "metrics['min_packet_size'] = min(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.982651, "o", "metrics['max_packet_size'] = max(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.982701, "o", "> \r\n\u001b[?2004l\r}\u001b[?2004h> "]
[75.982743, "o", "# Shannon entropy function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.982815, "o", "def shannon_entropy(values):\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.982863, "o", ">     if not values:\r\n\u001b[?2004l\r"]
[75.98292, "o", "\u001b[?2004h> "]
[75.98297, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983013, "o", "    counter = Counter(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983063, "o", "    total = len(values)\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[75.98312, "o", "    entropy = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983167, "o", "    for count in counter.values():\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.983191, "o", "> "]
[75.983291, "o", "        p = count / total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983348, "o", "        entropy -= p * math.log2(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983387, "o", "    return entropy\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983417, "o", "# Entropy metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983552, "o", "metrics['src_ip_entropy'] = shannon_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983597, "o", "metrics['dst_ip_entropy'] = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983689, "o", "metrics['src_port_entropy'] = shannon_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.983737, "o", "> "]
[75.983789, "o", "metrics['dst_port_entropy'] = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.983836, "o", "> "]
[75.983886, "o", "metrics['unique_src_ports'] = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.983967, "o", "metrics['unique_dst_ports'] = len(set(dst_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.984012, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.984057, "o", "# Graph metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.984099, "o", "all_ips = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.98415, "o", "> "]
[75.984201, "o", "metrics['num_nodes'] = len(all_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98424, "o", "metrics['num_edges'] = len(ip_pairs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.984285, "o", "> "]
[75.984331, "o", "if metrics['num_nodes'] > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.984476, "o", "    metrics['network_density'] = metrics['num_edges'] / (metrics['num_nodes'] * (metrics['num_nodes'] - 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.984528, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.984574, "o", "    metrics['network_density'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.984625, "o", "\u001b[?2004h> # Max in/out degree\r\n\u001b[?2004l\r"]
[75.984676, "o", "\u001b[?2004h> "]
[75.984809, "o", "metrics['max_outdegree'] = max(len(v) for v in ip_graph_out.values()) if ip_graph_out else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.984953, "o", "metrics['max_indegree'] = max(len(v) for v in ip_graph_in.values()) if ip_graph_in else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.985022, "o", "> "]
[75.985091, "o", "# Temporal metrics (inter-arrival times)\r\n\u001b[?2004l\r\u001b[?2004h> if len(timestamps) > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985168, "o", "    timestamps.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985256, "o", "    iats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985348, "o", "    metrics['iat_mean'] = sum(iats) / len(iats)\r\n\u001b[?2004l\r"]
[75.985397, "o", "\u001b[?2004h> "]
[75.98548, "o", "    variance = sum((x - metrics['iat_mean'])**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985547, "o", "    metrics['iat_variance'] = variance\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.985607, "o", "> "]
[75.98567, "o", "    std_dev = math.sqrt(variance)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985767, "o", "    metrics['iat_cv'] = std_dev / metrics['iat_mean'] if metrics['iat_mean'] > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985798, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985857, "o", "    metrics['iat_mean'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.985948, "o", "    metrics['iat_variance'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98602, "o", "    metrics['iat_cv'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986079, "o", "# Producer/Consumer ratio\r\n\u001b[?2004l\r\u001b[?2004h> pcr_values = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986128, "o", "for ip in all_ips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986193, "o", "    sent = bytes_sent.get(ip, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986264, "o", "    recv = bytes_recv.get(ip, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.986294, "o", "> "]
[75.986371, "o", "    if sent + recv > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986439, "o", "        pcr = (sent - recv) / (sent + recv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986505, "o", "        pcr_values.append(pcr)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.986536, "o", "\u001b[?2004h> "]
[75.986664, "o", "metrics['num_producers'] = sum(1 for pcr in pcr_values if pcr > 0.2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98673, "o", "metrics['num_consumers'] = sum(1 for pcr in pcr_values if pcr < -0.2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.986789, "o", "\u001b[?2004h> # Flow metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.986859, "o", "metrics['unique_flows'] = len(flows)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.986915, "o", "\u001b[?2004h> # TCP and UDP flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987005, "o", "tcp_flows = sum(1 for f in flows if f[4] == 'TCP')\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.987072, "o", "> "]
[75.987127, "o", "udp_flows = sum(1 for f in flows if f[4] == 'UDP')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987202, "o", "metrics['tcp_flows'] = tcp_flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987262, "o", "metrics['udp_flows'] = udp_flows\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987314, "o", "# Bidirectional flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987366, "o", "bidirectional = 0\r\n\u001b[?2004l\r\u001b[?2004h> for flow in flows:\r\n\u001b[?2004l\r"]
[75.987396, "o", "\u001b[?2004h> "]
[75.987489, "o", "    src_ip, dst_ip, src_port, dst_port, proto = flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987591, "o", "    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98766, "o", "    if reverse in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987732, "o", "        bidirectional += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.987851, "o", "metrics['bidirectional_flows'] = bidirectional // 2  # Divide by 2 since we count both directions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.98788, "o", "\u001b[?2004h> "]
[75.987952, "o", "# Analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988053, "o", "metrics['is_traffic_benign'] = 'true'  # Default to benign\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988112, "o", "metrics['has_port_scan'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988163, "o", "metrics['has_dos_pattern'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988226, "o", "metrics['has_beaconing'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.988276, "o", "\u001b[?2004h> "]
[75.988399, "o", "# Check for port scan: single source contacting many destinations on different ports\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988458, "o", "if metrics['max_outdegree'] > 100:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988515, "o", "    metrics['has_port_scan'] = 'true'\r\n\u001b[?2004l\r"]
[75.988543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988622, "o", "# Check for DoS: very high packets per minute\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.988688, "o", "> "]
[75.988749, "o", "if metrics['packets_per_minute_max'] > 10000:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98878, "o", "    metrics['has_dos_pattern'] = 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.988807, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.988898, "o", "# Check for beaconing: low IAT variance and small mean IAT\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.988929, "o", "> "]
[75.989049, "o", "if metrics['iat_mean'] > 0 and metrics['iat_mean'] < 1 and metrics['iat_cv'] < 0.3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989109, "o", "    metrics['has_beaconing'] = 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.989137, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989319, "o", "if metrics['has_port_scan'] == 'true' or metrics['has_dos_pattern'] == 'true' or metrics['has_beaconing'] == 'true':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989395, "o", "    metrics['is_traffic_benign'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.989425, "o", "\u001b[?2004h> "]
[75.989452, "o", "# Write results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989545, "o", "with open('network_stats.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989601, "o", "    lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.989654, "o", "\u001b[?2004h> "]
[75.989699, "o", "with open('network_stats.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.989726, "o", "    for line in lines:\r\n\u001b[?2004l\r"]
[75.989754, "o", "\u001b[?2004h> "]
[75.989818, "o", "        line = line.rstrip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.9899, "o", "        if line.startswith('#') or line == 'metric,value':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.98999, "o", "            f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[75.990022, "o", "\u001b[?2004h> "]
[75.990098, "o", "            parts = line.split(',')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990152, "o", "            if len(parts) >= 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990218, "o", "                metric_name = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990313, "o", "                if metric_name in metrics:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990396, "o", "                    value = metrics[metric_name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.990419, "o", "> "]
[75.990499, "o", "                    # Format numbers appropriately\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990579, "o", "                    if isinstance(value, float):\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.990609, "o", "> "]
[75.990685, "o", "                        value = round(value, 6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.990765, "o", "                    f.write(f\"{metric_name},{value}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.990809, "o", ">                 else:\r\n\u001b[?2004l\r"]
[75.990852, "o", "\u001b[?2004h> "]
[75.990897, "o", "                    f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.990931, "o", "\u001b[?2004h> "]
[75.991029, "o", "print(\"Analysis complete. Results written to network_stats.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.991058, "o", "EOF\r\n\u001b[?2004l\r"]
[75.992296, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
[79.192162, "i", "python3 analyze_pcap.py\n"]
[79.192367, "o", "python3 analyze_pcap.py\r\n\u001b[?2004l\r"]
[104.636146, "o", "Analysis complete. Results written to network_stats.csv\r\n"]
[107.872908, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
[118.185319, "i", "cat network_stats.csv\n"]
[118.185554, "o", "cat network_stats.csv\r\n\u001b[?2004l\r"]
[118.186371, "o", "metric,value\r\n# Protocol Distribution\r\nprotocol_tcp,32620\r\nprotocol_udp,25846\r\nprotocol_icmp,8\r\nprotocol_arp,54938\r\nprotocol_ip_total,58474\r\n# Time Series\r\nduration_seconds,26030.330756\r\npackets_per_minute_avg,262.296552\r\npackets_per_minute_max,2385\r\npackets_per_minute_min,123\r\n# Size Statistics\r\ntotal_bytes,30889470\r\navg_packet_size,270.72516\r\nmin_packet_size,42\r\nmax_packet_size,56538\r\n# Entropy Metrics (Shannon entropy in bits)\r\ndst_port_entropy,4.281115\r\nsrc_port_entropy,4.339615\r\nsrc_ip_entropy,2.483323\r\ndst_ip_entropy,2.461762\r\nunique_dst_ports,1675\r\nunique_src_ports,1713\r\n# Graph/Topology Metrics\r\nnum_nodes,38\r\nnum_edges,58\r\nnetwork_density,0.041252\r\nmax_indegree,23\r\nmax_outdegree,27\r\n# Temporal Metrics\r\niat_mean,0.22814\r\niat_variance,0.063282\r\niat_cv,1.102649\r\nnum_producers,23\r\nnum_consumers,13\r\n# Flow Metrics\r\nunique_flows,3567\r\nbidirectional_flows,1758\r\ntcp_flows,3353\r\nudp_flows,214\r\n# Analysis Questions (true/false)\r\nis_traffic_benign,true\r\nhas_port_scan,false\r\nhas_dos_pattern,false\r\nhas_beaconing,false\r\n"]
[118.186554, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
[122.982799, "i", "wc -l network_stats.csv && grep -c '^#' network_stats.csv\n"]
[122.983126, "o", "wc -l network_stats.csv && grep -c '^#' network_stats.csv\r\n\u001b[?2004l\r"]
[122.984143, "o", "46 network_stats.csv\r\n"]
[122.985237, "o", "8\r\n"]
[122.985383, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
