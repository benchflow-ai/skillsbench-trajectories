[11.723307, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
[29.381801, "i", "cat > analyze_pcap.py << 'EOF'\nimport math\nfrom collections import defaultdict, Counter\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\n\n# Load pcap\npackets = rdpcap('packets.pcap')\n\n# Initialize counters\nprotocol_counts = {'tcp': 0, 'udp': 0, 'icmp': 0, 'arp': 0, 'ip_total': 0}\npacket_lengths = []\ntimestamps = []\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\nflows = set()\nip_pairs = set()\nip_graph_out = defaultdict(set)  # src -> {dst}\nip_graph_in = defaultdict(set)   # dst -> {src}\nbytes_sent = defaultdict(int)    # IP -> bytes sent\nbytes_recv = defaultdict(int)    # IP -> bytes received\n\n# Process packets\nfor pkt in packets:\n    pkt_len = len(pkt)\n    packet_lengths.append(pkt_len)\n    \n    # Get timestamp\n    if hasattr(pkt, 'time'):\n        timestamps.append(pkt.time)\n    \n    # Check for ARP\n    if ARP in pkt:\n        protocol_counts['arp'] += 1\n    \n    # Check for IP\n    if IP in pkt:\n        protocol_counts['ip_total'] += 1\n        src_ip = pkt[IP].src\n        dst_ip = pkt[IP].dst\n        src_ips.append(src_ip)\n        dst_ips.append(dst_ip)\n        \n        # Track IP graph\n        ip_pairs.add((src_ip, dst_ip))\n        ip_graph_out[src_ip].add(dst_ip)\n        ip_graph_in[dst_ip].add(src_ip)\n        \n        # Track bytes\n        bytes_sent[src_ip] += pkt_len\n        bytes_recv[dst_ip] += pkt_len\n        \n        # Check for TCP\n        if TCP in pkt:\n            protocol_counts['tcp'] += 1\n            src_port = pkt[TCP].sport\n            dst_port = pkt[TCP].dport\n            src_ports.append(src_port)\n            dst_ports.append(dst_port)\n            flows.add((src_ip, dst_ip, src_port, dst_port, 'TCP'))\n        \n        # Check for UDP\n        elif UDP in pkt:\n            protocol_counts['udp'] += 1\n            src_port = pkt[UDP].sport\n            dst_port = pkt[UDP].dport\n            src_ports.append(src_port)\n            dst_ports.append(dst_port)\n            flows.add((src_ip, dst_ip, src_port, dst_port, 'UDP'))\n        \n        # Check for ICMP\n        elif ICMP in pkt:\n            protocol_counts['icmp'] += 1\n\n# Compute metrics\nmetrics = {}\n\n# Protocol counts\nmetrics['protocol_tcp'] = protocol_counts['tcp']\nmetrics['protocol_udp'] = protocol_counts['udp']\nmetrics['protocol_icmp'] = protocol_counts['icmp']\nmetrics['protocol_arp'] = protocol_counts['arp']\nmetrics['protocol_ip_total'] = protocol_counts['ip_total']\n\n# Time series\nif len(timestamps) > 1:\n    timestamps.sort()\n    duration = timestamps[-1] - timestamps[0]\n    metrics['duration_seconds'] = duration\n    \n    # Packets per minute in 60s buckets\n    bucket_counts = defaultdict(int)\n    for ts in timestamps:\n        bucket = int(ts / 60)\n        bucket_counts[bucket] += 1\n    \n    if bucket_counts:\n        ppm_values = list(bucket_counts.values())\n        metrics['packets_per_minute_avg'] = sum(ppm_values) / len(ppm_values)\n        metrics['packets_per_minute_max'] = max(ppm_values)\n        metrics['packets_per_minute_min'] = min(ppm_values)\nelse:\n    metrics['duration_seconds'] = 0\n    metrics['packets_per_minute_avg'] = 0\n    metrics['packets_per_minute_max'] = 0\n    metrics['packets_per_minute_min'] = 0\n\n# Size statistics\nmetrics['total_bytes'] = sum(packet_lengths)\nmetrics['avg_packet_size'] = sum(packet_lengths) / len(packet_lengths) if packet_lengths else 0\nmetrics['min_packet_size'] = min(packet_lengths) if packet_lengths else 0\nmetrics['max_packet_size'] = max(packet_lengths) if packet_lengths else 0\n\n# Shannon entropy function\ndef shannon_entropy(values):\n    if not values:\n        return 0\n    counter = Counter(values)\n    total = len(values)\n    entropy = 0\n    for count in counter.values():\n        p = count / total\n        entropy -= p * math.log2(p)\n    return entropy\n\n# Entropy metrics\nmetrics['src_ip_entropy'] = shannon_entropy(src_ips)\nmetrics['dst_ip_entropy'] = shannon_entropy(dst_ips)\nmetrics['src_port_entropy'] = shannon_entropy(src_ports)\nmetrics['dst_port_entropy'] = shannon_entropy(dst_ports)\nmetrics['unique_src_ports'] = len(set(src_ports))\nmetrics['unique_dst_ports'] = len(set(dst_ports))\n\n# Graph metri"]
[29.381956, "i", "cs\nall_ips = set(src_ips) | set(dst_ips)\nmetrics['num_nodes'] = len(all_ips)\nmetrics['num_edges'] = len(ip_pairs)\nif metrics['num_nodes'] > 1:\n    metrics['network_density'] = metrics['num_edges'] / (metrics['num_nodes'] * (metrics['num_nodes'] - 1))\nelse:\n    metrics['network_density'] = 0\n\n# Max in/out degree\nmetrics['max_outdegree'] = max(len(v) for v in ip_graph_out.values()) if ip_graph_out else 0\nmetrics['max_indegree'] = max(len(v) for v in ip_graph_in.values()) if ip_graph_in else 0\n\n# Temporal metrics (inter-arrival times)\nif len(timestamps) > 1:\n    timestamps.sort()\n    iats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\n    metrics['iat_mean'] = sum(iats) / len(iats)\n    variance = sum((x - metrics['iat_mean'])**2 for x in iats) / len(iats)\n    metrics['iat_variance'] = variance\n    std_dev = math.sqrt(variance)\n    metrics['iat_cv'] = std_dev / metrics['iat_mean'] if metrics['iat_mean'] > 0 else 0\nelse:\n    metrics['iat_mean'] = 0\n    metrics['iat_variance'] = 0\n    metrics['iat_cv'] = 0\n\n# Producer/Consumer ratio\npcr_values = []\nfor ip in all_ips:\n    sent = bytes_sent.get(ip, 0)\n    recv = bytes_recv.get(ip, 0)\n    if sent + recv > 0:\n        pcr = (sent - recv) / (sent + recv)\n        pcr_values.append(pcr)\n\nmetrics['num_producers'] = sum(1 for pcr in pcr_values if pcr > 0.2)\nmetrics['num_consumers'] = sum(1 for pcr in pcr_values if pcr < -0.2)\n\n# Flow metrics\nmetrics['unique_flows'] = len(flows)\n\n# TCP and UDP flows\ntcp_flows = sum(1 for f in flows if f[4] == 'TCP')\nudp_flows = sum(1 for f in flows if f[4] == 'UDP')\nmetrics['tcp_flows'] = tcp_flows\nmetrics['udp_flows'] = udp_flows\n\n# Bidirectional flows\nbidirectional = 0\nfor flow in flows:\n    src_ip, dst_ip, src_port, dst_port, proto = flow\n    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\n    if reverse in flows:\n        bidirectional += 1\nmetrics['bidirectional_flows'] = bidirectional // 2  # Divide by 2 since we count both directions\n\n# Analysis flags\nmetrics['is_traffic_benign'] = 'true'  # Default to benign\nmetrics['has_port_scan'] = 'false'\nmetrics['has_dos_pattern'] = 'false'\nmetrics['has_beaconing'] = 'false'\n\n# Check for port scan: single source contacting many destinations on different ports\nif metrics['max_outdegree'] > 100:\n    metrics['has_port_scan'] = 'true'\n\n# Check for DoS: very high packets per minute\nif metrics['packets_per_minute_max'] > 10000:\n    metrics['has_dos_pattern'] = 'true'\n\n# Check for beaconing: low IAT variance and small mean IAT\nif metrics['iat_mean'] > 0 and metrics['iat_mean'] < 1 and metrics['iat_cv'] < 0.3:\n    metrics['has_beaconing'] = 'true'\n\nif metrics['has_port_scan'] == 'true' or metrics['has_dos_pattern'] == 'true' or metrics['has_beaconing'] == 'true':\n    metrics['is_traffic_benign'] = 'false'\n\n# Write results\nwith open('network_stats.csv', 'r') as f:\n    lines = f.readlines()\n\nwith open('network_stats.csv', 'w') as f:\n    for line in lines:\n        line = line.rstrip()\n        if line.startswith('#') or line == 'metric,value':\n            f.write(line + '\\n')\n        else:\n            parts = line.split(',')\n            if len(parts) >= 1:\n                metric_name = parts[0]\n                if metric_name in metrics:\n                    value = metrics[metric_name]\n                    # Format numbers appropriately\n                    if isinstance(value, float):\n                        value = round(value, 6)\n                    f.write(f\"{metric_name},{value}\\n\")\n                else:\n                    f.write(line + '\\n')\n\nprint(\"Analysis complete. Results written to network_stats.csv\")\nEOF\n"]
