[29.391863, "o", "metrics['protocol_tcp'] = protocol_counts['tcp']\r\n\u001b[?2004l\r"]
[29.391904, "o", "\u001b[?2004h> "]
[29.392126, "o", "metrics['protocol_udp'] = protocol_counts['udp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.39237, "o", "metrics['protocol_icmp'] = protocol_counts['icmp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.39256, "o", "metrics['protocol_arp'] = protocol_counts['arp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.39278, "o", "metrics['protocol_ip_total'] = protocol_counts['ip_total']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[29.392849, "o", "\u001b[?2004h> "]
[29.392916, "o", "# Time series\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393029, "o", "if len(timestamps) > 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393061, "o", "> "]
[29.393156, "o", "    timestamps.sort()\r\n\u001b[?2004l\r"]
[29.39322, "o", "\u001b[?2004h> "]
[29.39336, "o", "    duration = timestamps[-1] - timestamps[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393528, "o", "    metrics['duration_seconds'] = duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393597, "o", ">     \r\n\u001b[?2004l\r"]
[29.393663, "o", "\u001b[?2004h> "]
[29.393776, "o", "    # Packets per minute in 60s buckets\r\n\u001b[?2004l\r"]
[29.393846, "o", "\u001b[?2004h> "]
[29.393982, "o", "    bucket_counts = defaultdict(int)\r\n\u001b[?2004l\r"]
[29.394037, "o", "\u001b[?2004h> "]
[29.394114, "o", "    for ts in timestamps:\r\n\u001b[?2004l\r"]
[29.394181, "o", "\u001b[?2004h> "]
[29.394278, "o", "        bucket = int(ts / 60)\r\n\u001b[?2004l\r"]
[29.394349, "o", "\u001b[?2004h> "]
[29.394407, "o", "        bucket_counts[bucket] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.394472, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[29.39453, "o", ">     if bucket_counts:\r\n\u001b[?2004l\r"]
[29.394566, "o", "\u001b[?2004h> "]
[29.394699, "o", "        ppm_values = list(bucket_counts.values())\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.394732, "o", "> "]
[29.394967, "o", "        metrics['packets_per_minute_avg'] = sum(ppm_values) / len(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.395156, "o", "        metrics['packets_per_minute_max'] = max(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.395221, "o", "> "]
[29.395381, "o", "        metrics['packets_per_minute_min'] = min(ppm_values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.395444, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.395522, "o", "    metrics['duration_seconds'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.395593, "o", "> "]
[29.395657, "o", "    metrics['packets_per_minute_avg'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.395713, "o", "> "]
[29.395796, "o", "    metrics['packets_per_minute_max'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.395867, "o", "> "]
[29.395921, "o", "    metrics['packets_per_minute_min'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.395989, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[29.396055, "o", "# Size statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.39621, "o", "metrics['total_bytes'] = sum(packet_lengths)\r\n\u001b[?2004l\r"]
[29.396265, "o", "\u001b[?2004h> "]
[29.39656, "o", "metrics['avg_packet_size'] = sum(packet_lengths) / len(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.396802, "o", "metrics['min_packet_size'] = min(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.397021, "o", "metrics['max_packet_size'] = max(packet_lengths) if packet_lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.397089, "o", "> \r\n\u001b[?2004l\r}\u001b[?2004h> "]
[29.397174, "o", "# Shannon entropy function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.397279, "o", "def shannon_entropy(values):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.397373, "o", "    if not values:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.397449, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.397533, "o", "    counter = Counter(values)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.39759, "o", "> "]
[29.397647, "o", "    total = len(values)\r\n\u001b[?2004l\r"]
[29.397718, "o", "\u001b[?2004h>     entropy = 0\r\n"]
[29.397788, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[29.397852, "o", "    for count in counter.values():\r\n\u001b[?2004l\r"]
[29.397917, "o", "\u001b[?2004h>         p = count / total\r\n\u001b[?2004l\r"]
[29.39797, "o", "\u001b[?2004h> "]
[29.398032, "o", "        entropy -= p * math.log2(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398102, "o", "    return entropy\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.398173, "o", "\u001b[?2004h> # Entropy metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.398253, "o", "> "]
[29.398319, "o", "metrics['src_ip_entropy'] = shannon_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398399, "o", "metrics['dst_ip_entropy'] = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.398458, "o", "> "]
[29.398529, "o", "metrics['src_port_entropy'] = shannon_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.398591, "o", "> "]
[29.398654, "o", "metrics['dst_port_entropy'] = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398724, "o", "metrics['unique_src_ports'] = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398794, "o", "metrics['unique_dst_ports'] = len(set(dst_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.398863, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398932, "o", "# Graph metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.398998, "o", "all_ips = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399071, "o", "metrics['num_nodes'] = len(all_ips)\r\n\u001b[?2004l\r"]
[29.399139, "o", "\u001b[?2004h> "]
[29.399204, "o", "metrics['num_edges'] = len(ip_pairs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399266, "o", "if metrics['num_nodes'] > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399451, "o", "    metrics['network_density'] = metrics['num_edges'] / (metrics['num_nodes'] * (metrics['num_nodes'] - 1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399563, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399602, "o", "    metrics['network_density'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399683, "o", "# Max in/out degree\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.399896, "o", "metrics['max_outdegree'] = max(len(v) for v in ip_graph_out.values()) if ip_graph_out else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.400079, "o", "metrics['max_indegree'] = max(len(v) for v in ip_graph_in.values()) if ip_graph_in else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.400131, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.400202, "o", "# Temporal metrics (inter-arrival times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.400247, "o", "> if len(timestamps) > 1:\r\n\u001b[?2004l\r"]
[29.400298, "o", "\u001b[?2004h> "]
[29.400351, "o", "    timestamps.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.400489, "o", "    iats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\r\n\u001b[?2004l\r"]
[29.400546, "o", "\u001b[?2004h> "]
[29.400623, "o", "    metrics['iat_mean'] = sum(iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.400674, "o", "> "]
[29.400797, "o", "    variance = sum((x - metrics['iat_mean'])**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.400849, "o", "> "]
[29.400905, "o", "    metrics['iat_variance'] = variance\r\n\u001b[?2004l\r"]
[29.400956, "o", "\u001b[?2004h> "]
[29.401017, "o", "    std_dev = math.sqrt(variance)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.401174, "o", "    metrics['iat_cv'] = std_dev / metrics['iat_mean'] if metrics['iat_mean'] > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.401198, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.401244, "o", "> "]
[29.401295, "o", "    metrics['iat_mean'] = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.40134, "o", "> "]
[29.401386, "o", "    metrics['iat_variance'] = 0\r\n\u001b[?2004l\r"]
[29.401431, "o", "\u001b[?2004h> "]
[29.401473, "o", "    metrics['iat_cv'] = 0\r\n\u001b[?2004l\r"]
[29.401521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[29.401574, "o", "> "]
[29.401615, "o", "# Producer/Consumer ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.401641, "o", "pcr_values = []\r\n\u001b[?2004l\r"]
[29.401685, "o", "\u001b[?2004h> "]
[29.401712, "o", "for ip in all_ips:\r\n\u001b[?2004l\r"]
[29.40179, "o", "\u001b[?2004h> "]
[29.401847, "o", "    sent = bytes_sent.get(ip, 0)\r\n\u001b[?2004l\r"]
[29.401893, "o", "\u001b[?2004h> "]
[29.401918, "o", "    recv = bytes_recv.get(ip, 0)\r\n\u001b[?2004l\r"]
[29.401964, "o", "\u001b[?2004h> "]
[29.402004, "o", "    if sent + recv > 0:\r\n\u001b[?2004l\r"]
[29.402049, "o", "\u001b[?2004h> "]
[29.402135, "o", "        pcr = (sent - recv) / (sent + recv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.402185, "o", "> "]
[29.402265, "o", "        pcr_values.append(pcr)\r\n\u001b[?2004l\r"]
[29.402362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.402436, "o", "metrics['num_producers'] = sum(1 for pcr in pcr_values if pcr > 0.2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.402578, "o", "> "]
[29.402684, "o", "metrics['num_consumers'] = sum(1 for pcr in pcr_values if pcr < -0.2)\r\n\u001b[?2004l\r"]
[29.402712, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.402798, "o", "\u001b[?2004h> "]
[29.402852, "o", "# Flow metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.402883, "o", "metrics['unique_flows'] = len(flows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.402946, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403026, "o", "# TCP and UDP flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403131, "o", "tcp_flows = sum(1 for f in flows if f[4] == 'TCP')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403264, "o", "udp_flows = sum(1 for f in flows if f[4] == 'UDP')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403354, "o", "metrics['tcp_flows'] = tcp_flows\r\n\u001b[?2004l\r"]
[29.403407, "o", "\u001b[?2004h> "]
[29.403452, "o", "metrics['udp_flows'] = udp_flows\r\n\u001b[?2004l\r"]
[29.403513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.403574, "o", "\u001b[?2004h> # Bidirectional flows\r\n\u001b[?2004l\r"]
[29.403636, "o", "\u001b[?2004h> bidirectional = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.403689, "o", "> for flow in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403829, "o", "    src_ip, dst_ip, src_port, dst_port, proto = flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.403911, "o", "    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\r\n\u001b[?2004l\r"]
[29.403972, "o", "\u001b[?2004h>     if reverse in flows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.404025, "o", "> "]
[29.404089, "o", "        bidirectional += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.404244, "o", "metrics['bidirectional_flows'] = bidirectional // 2  # Divide by 2 since we count both directions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.404305, "o", "\u001b[?2004h> "]
[29.404373, "o", "# Analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.404438, "o", "metrics['is_traffic_benign'] = 'true'  # Default to benign\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.404542, "o", "metrics['has_port_scan'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.404627, "o", "metrics['has_dos_pattern'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.404678, "o", "> "]
[29.404742, "o", "metrics['has_beaconing'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.404802, "o", "\u001b[?2004h> "]
[29.404864, "o", "# Check for port scan: single source contacting many destinations on different ports\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.404924, "o", "> "]
[29.404981, "o", "if metrics['max_outdegree'] > 100:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.40504, "o", "    metrics['has_port_scan'] = 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.405096, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.405161, "o", "# Check for DoS: very high packets per minute\r\n\u001b[?2004l\r"]
[29.405218, "o", "\u001b[?2004h> "]
[29.405295, "o", "if metrics['packets_per_minute_max'] > 10000:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.405349, "o", "> "]
[29.405407, "o", "    metrics['has_dos_pattern'] = 'true'\r\n\u001b[?2004l\r"]
[29.405462, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.40558, "o", "# Check for beaconing: low IAT variance and small mean IAT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.405749, "o", "if metrics['iat_mean'] > 0 and metrics['iat_mean'] < 1 and metrics['iat_cv'] < 0.3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.405836, "o", "    metrics['has_beaconing'] = 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.405901, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.406096, "o", "if metrics['has_port_scan'] == 'true' or metrics['has_dos_pattern'] == 'true' or metrics['has_beaconing'] == 'true':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.406213, "o", "    metrics['is_traffic_benign'] = 'false'\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.406298, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[29.406864, "o", "> "]
[29.406892, "o", "# Write results\r\n\u001b[?2004l\r"]
[29.40696, "o", "\u001b[?2004h> "]
[29.407003, "o", "with open('network_stats.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.407049, "o", "    lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.407093, "o", "\u001b[?2004h> "]
[29.407146, "o", "with open('network_stats.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.40719, "o", "    for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.407232, "o", "> "]
[29.407277, "o", "        line = line.rstrip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.407363, "o", "        if line.startswith('#') or line == 'metric,value':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.40742, "o", "            f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.407479, "o", "> "]
[29.407535, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.40758, "o", "            parts = line.split(',')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.407626, "o", "            if len(parts) >= 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.407664, "o", "> "]
[29.40771, "o", "                metric_name = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.407768, "o", "                if metric_name in metrics:\r\n\u001b[?2004l\r"]
[29.407819, "o", "\u001b[?2004h> "]
[29.407855, "o", "                    value = metrics[metric_name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.407898, "o", "> "]
[29.407946, "o", "                    # Format numbers appropriately\r\n\u001b[?2004l\r"]
[29.407997, "o", "\u001b[?2004h> "]
[29.408035, "o", "                    if isinstance(value, float):\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.408085, "o", "> "]
[29.408122, "o", "                        value = round(value, 6)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.408171, "o", "> "]
[29.40822, "o", "                    f.write(f\"{metric_name},{value}\\n\")\r\n\u001b[?2004l\r"]
[29.408263, "o", "\u001b[?2004h> "]
[29.408314, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.408357, "o", "                    f.write(line + '\\n')\r\n\u001b[?2004l\r"]
[29.4084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.408502, "o", "print(\"Analysis complete. Results written to network_stats.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.408551, "o", "EOF\r\n\u001b[?2004l\r"]
[29.409752, "o", "\u001b[?2004hroot@d304588a83f4:~# "]
[32.662242, "i", "python3 analyze_pcap.py\n"]
