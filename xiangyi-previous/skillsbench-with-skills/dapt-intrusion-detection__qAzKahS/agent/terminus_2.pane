[?2004l}[?2004h> # Shannon entropy function
[?2004l[?2004h> def shannon_entropy(values):
[?2004l[?2004h>     if not values:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     counter = Counter(values)
[?2004l[?2004h>     total = len(values)
[?2004l[?2004h>     entropy = 0
[?2004l[?2004h>     for count in counter.values():
[?2004l[?2004h>         p = count / total
[?2004l[?2004h>         entropy -= p * math.log2(p)
[?2004l[?2004h>     return entropy
[?2004l[?2004h> 
