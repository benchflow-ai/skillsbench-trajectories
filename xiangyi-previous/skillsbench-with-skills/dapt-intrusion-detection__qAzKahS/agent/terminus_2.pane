[?2004l}[?2004h> # Shannon entropy function
[?2004l[?2004h> def shannon_entropy(values):
[?2004l[?2004h>     if not values:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     counter = Counter(values)
[?2004l[?2004h>     total = len(values)
[?2004l
[?2004h>     entropy = 0
[?2004l[?2004h>     for count in counter.values():
[?2004l[?2004h>         p = count / total
[?2004l[?2004h>         entropy -= p * math.log2(p)
[?2004l[?2004h>     return entropy
[?2004l[?2004h> 
[?2004l[?2004h> # Entropy metrics
[?2004l[?2004h> metrics['src_ip_entropy'] = shannon_entropy(src_ips)
[?2004l[?2004h> metrics['dst_ip_entropy'] = shannon_entropy(dst_ips)
[?2004l[?2004h> metrics['src_port_entropy'] = shannon_entropy(src_ports)
[?2004l[?2004h> metrics['dst_port_entropy'] = shannon_entropy(dst_ports)
[?2004l[?2004h> metrics['unique_src_ports'] = len(set(src_ports))
