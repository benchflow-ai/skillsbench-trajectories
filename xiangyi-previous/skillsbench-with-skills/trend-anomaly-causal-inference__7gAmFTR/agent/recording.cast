[149.39404, "o", "# Load and clean purchases data\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.394065, "o", "> "]
[149.394271, "o", "p = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.394295, "o", "> "]
[149.394453, "o", "p.columns = [c.strip() for c in p.columns]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.394506, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394738, "o", "p['Order Date'] = pd.to_datetime(p['Order Date'], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.394784, "o", "> "]
[149.395042, "o", "p['Purchase Price Per Unit'] = pd.to_numeric(p['Purchase Price Per Unit'], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395091, "o", "> "]
[149.395279, "o", "p['Quantity'] = pd.to_numeric(p['Quantity'], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395331, "o", "> "]
[149.395508, "o", "p['Category'] = p['Category'].apply(clean_str).str.upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395531, "o", "> "]
[149.395701, "o", "p['Category'] = p['Category'].fillna('UNKNOWN')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.395779, "o", "\u001b[?2004h> "]
[149.396026, "o", "p = p.dropna(subset=['Order Date','Purchase Price Per Unit','Quantity','Survey ResponseID'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396052, "o", "> "]
[149.39624, "o", "p = p[(p['Purchase Price Per Unit']>0) & (p['Quantity']>0)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396294, "o", "> "]
[149.396471, "o", "p['Total_Spend'] = p['Purchase Price Per Unit'] * p['Quantity']\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396517, "o", "> "]
[149.396557, "o", "p = p.drop_duplicates()\r\n\u001b[?2004l\r"]
[149.3966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.39664, "o", "\u001b[?2004h> "]
[149.396896, "o", "p.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396919, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.397026, "o", "# Anomaly detection\r\n\u001b[?2004l\r"]
[149.397079, "o", "\u001b[?2004h> "]
[149.397208, "o", "p['date'] = p['Order Date'].dt.normalize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.397253, "o", "> "]
[149.397384, "o", "end_date = pd.to_datetime('2020-03-31')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.397407, "o", "> "]
[149.397484, "o", "start_date = p['date'].min()\r\n\u001b[?2004l\r"]
[149.397536, "o", "\u001b[?2004h> "]
[149.397739, "o", "all_dates = pd.date_range(start_date, end_date, freq='D')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[149.397794, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.39803, "o", "daily_sales = p.groupby(['Category','date'])['Total_Spend'].sum().reset_index()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.398053, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.398125, "o", "records = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.398168, "o", "> "]
[149.39832, "o", "for cat, grp in daily_sales.groupby('Category'):\r\n\u001b[?2004l\r"]
[149.398363, "o", "\u001b[?2004h> "]
[149.398587, "o", "    s = grp.set_index('date').reindex(all_dates, fill_value=0)['Total_Spend']\r\n\u001b[?2004l\r"]
[149.398634, "o", "\u001b[?2004h> "]
[149.398793, "o", "    baseline = s[s.index < pd.to_datetime('2020-03-01')]\r\n\u001b[?2004l\r"]
[149.398843, "o", "\u001b[?2004h> "]
[149.399072, "o", "    treatment = s[(s.index >= pd.to_datetime('2020-03-01')) & (s.index <= end_date)]\r\n\u001b[?2004l\r"]
[149.399095, "o", "\u001b[?2004h> "]
[149.399222, "o", "    baseline_mean = baseline.mean()\r\n\u001b[?2004l\r"]
[149.399264, "o", "\u001b[?2004h> "]
[149.39937, "o", "    baseline_std = baseline.std()\r\n\u001b[?2004l\r"]
[149.399417, "o", "\u001b[?2004h> "]
[149.399552, "o", "    treatment_mean = treatment.mean()\r\n\u001b[?2004l\r"]
[149.399575, "o", "\u001b[?2004h> "]
[149.399787, "o", "    if baseline_std == 0 or np.isnan(baseline_std):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399962, "o", "        if treatment_mean == baseline_mean:\r\n\u001b[?2004l\r"]
[149.400025, "o", "\u001b[?2004h> "]
[149.400075, "o", "            z = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.400125, "o", "> "]
[149.400174, "o", "        else:\r\n\u001b[?2004l\r"]
[149.400215, "o", "\u001b[?2004h> "]
[149.400424, "o", "            z = np.sign(treatment_mean - baseline_mean) * 5\r\n\u001b[?2004l\r"]
[149.400447, "o", "\u001b[?2004h> "]
[149.400494, "o", "    else:\r\n\u001b[?2004l\r"]
[149.400542, "o", "\u001b[?2004h> "]
[149.400721, "o", "        z = (treatment_mean - baseline_mean) / baseline_std\r\n\u001b[?2004l\r"]
[149.400746, "o", "\u001b[?2004h> "]
[149.400859, "o", "    anomaly = np.tanh(z) * 100\r\n\u001b[?2004l\r"]
[149.400913, "o", "\u001b[?2004h> "]
[149.401118, "o", "    records.append({'Category': cat, 'Anomaly_Index': anomaly,\r\n\u001b[?2004l\r"]
[149.401174, "o", "\u001b[?2004h> "]
[149.401357, "o", "                    'baseline_avg_spend': baseline_mean,\r\n\u001b[?2004l\r"]
[149.401399, "o", "\u001b[?2004h> "]
[149.401622, "o", "                    'treatment_avg_spend': treatment_mean})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.401667, "o", "\u001b[?2004h> "]
[149.401773, "o", "anomaly_df = pd.DataFrame(records)\r\n\u001b[?2004l\r"]
[149.401813, "o", "\u001b[?2004h> "]
[149.402111, "o", "anomaly_df[['Category','Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.402161, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.402208, "o", "> "]
[149.40228, "o", "# Identify top categories\r\n\u001b[?2004l\r"]
[149.402306, "o", "\u001b[?2004h> "]
[149.402551, "o", "anomaly_sorted = anomaly_df.sort_values('Anomaly_Index', ascending=False)\r\n\u001b[?2004l\r"]
[149.402575, "o", "\u001b[?2004h> "]
[149.402764, "o", "top_surge = anomaly_sorted.head(10)['Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.402806, "o", "> "]
[149.402965, "o", "top_slump = anomaly_sorted.tail(10)['Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.403001, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.40316, "o", "# Aggregate user-category-period data\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.403184, "o", "> "]
[149.403379, "o", "users = survey_cleaned['Survey ResponseID'].unique()\r\n\u001b[?2004l\r"]
[149.403478, "o", "\u001b[?2004h> "]
[149.403769, "o", "all_top_categories = list(dict.fromkeys(top_surge + top_slump))\r\n\u001b[?2004l\r"]
[149.403832, "o", "\u001b[?2004h"]
[149.403872, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[149.404042, "o", "baseline_start = pd.to_datetime('2020-01-01')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.404083, "o", "> "]
[149.404219, "o", "baseline_end = pd.to_datetime('2020-02-29')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.404268, "o", "> "]
[149.404415, "o", "treatment_start = pd.to_datetime('2020-03-01')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.404455, "o", "> "]
[149.404605, "o", "treatment_end = pd.to_datetime('2020-03-31')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.404647, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.404999, "o", "index = pd.MultiIndex.from_product([users, all_top_categories], names=['Survey ResponseID','Category'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.405064, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.405121, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.405497, "o", "for period_name, (start, end) in {'baseline':(baseline_start, baseline_end), 'treatment':(treatment_start, treatment_end)}.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.405536, "o", "> "]
[149.405816, "o", "    df_period = p[(p['date']>=start) & (p['date']<=end) & (p['Category'].isin(all_top_categories))]\r\n\u001b[?2004l\r"]
[149.405847, "o", "\u001b[?2004h> "]
[149.40611, "o", "    spend = df_period.groupby(['Survey ResponseID','Category'])['Total_Spend'].sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.406312, "o", "    spend = spend.reindex(index, fill_value=0).reset_index()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.406377, "o", "> "]
[149.406456, "o", "    spend['Period'] = period_name\r\n\u001b[?2004l\r"]
[149.406502, "o", "\u001b[?2004h> "]
[149.406563, "o", "    rows.append(spend)\r\n\u001b[?2004l\r"]
[149.406623, "o", "\u001b[?2004h> "]
[149.406665, "o", "\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[149.406792, "o", "agg = pd.concat(rows, ignore_index=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.406817, "o", "> "]
