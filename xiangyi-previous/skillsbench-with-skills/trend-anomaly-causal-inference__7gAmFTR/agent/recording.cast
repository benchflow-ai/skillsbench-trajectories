[149.408406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[149.408469, "o", "# Causal analysis\r\n\u001b[?2004l\r"]
[149.408521, "o", "\u001b[?2004h> "]
[149.408684, "o", "features = feature_df.set_index('Survey ResponseID')\r\n\u001b[?2004l\r"]
[149.40871, "o", "\u001b[?2004h> "]
[149.408931, "o", "feature_cols = [c for c in features.columns if features[c].nunique()>1]\r\n\u001b[?2004l\r"]
[149.408955, "o", "\u001b[?2004h> "]
[149.409069, "o", "# filter features with prevalence >=5%\r\n\u001b[?2004l\r"]
[149.409094, "o", "\u001b[?2004h> "]
[149.409418, "o", "valid_features = [c for c in feature_cols if features[c].mean()>=0.05 and features[c].mean()<=0.95]\r\n\u001b[?2004l\r"]
[149.409466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r "]
[149.409493, "o", "\u001b[?2004h> "]
[149.409632, "o", "def did_regression(df, outcome, feature):\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.409658, "o", "> "]
[149.409716, "o", "    X = pd.DataFrame({\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.409765, "o", "> "]
[149.409861, "o", "        'feature': df[feature],\r\n\u001b[?2004l\r"]
[149.409889, "o", "\u001b[?2004h> "]
[149.41003, "o", "        'period': df['period_ind'],\r\n\u001b[?2004l\r"]
[149.410072, "o", "\u001b[?2004h> "]
[149.410122, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.410312, "o", "    X['interaction'] = X['feature'] * X['period']\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.410335, "o", "> "]
[149.410412, "o", "    if sm is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.410502, "o", "        # simple OLS using numpy\r\n\u001b[?2004l\r"]
[149.410553, "o", "\u001b[?2004h> "]
[149.410796, "o", "        X_mat = np.column_stack([np.ones(len(X)), X['feature'], X['period'], X['interaction']])\r\n\u001b[?2004l\r"]
[149.410819, "o", "\u001b[?2004h> "]
[149.410894, "o", "        y = df[outcome].values\r\n\u001b[?2004l\r"]
[149.41095, "o", "\u001b[?2004h> "]
[149.411119, "o", "        beta = np.linalg.lstsq(X_mat, y, rcond=None)[0]\r\n\u001b[?2004l\r"]
[149.41116, "o", "\u001b[?2004h> "]
[149.411333, "o", "        # approximate p-value not computed; return nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.411357, "o", "> "]
[149.411428, "o", "        return beta[3], np.nan\r\n\u001b[?2004l\r"]
[149.411455, "o", "\u001b[?2004h> "]
[149.4115, "o", "    else:\r\n\u001b[?2004l\r"]
[149.41157, "o", "\u001b[?2004h> "]
[149.411643, "o", "        X_mat = sm.add_constant(X)\r\n\u001b[?2004l\r"]
[149.41169, "o", "\u001b[?2004h> "]
[149.411774, "o", "        model = sm.OLS(df[outcome], X_mat).fit()\r\n\u001b[?2004l\r"]
[149.411822, "o", "\u001b[?2004h> "]
[149.41197, "o", "        return model.params['interaction'], model.pvalues['interaction']\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.412019, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.412069, "o", "report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.412117, "o", "    'metadata': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.412251, "o", "        'baseline_start': baseline_start.strftime('%m-%d-%Y'),\r\n\u001b[?2004l\r"]
[149.412297, "o", "\u001b[?2004h> "]
[149.412378, "o", "        'baseline_end': baseline_end.strftime('%m-%d-%Y'),\r\n\u001b[?2004l\r"]
[149.412429, "o", "\u001b[?2004h> "]
[149.412563, "o", "        'treatment_start': treatment_start.strftime('%m-%d-%Y'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.412611, "o", "> "]
[149.41269, "o", "        'treatment_end': treatment_end.strftime('%m-%d-%Y'),\r\n\u001b[?2004l\r"]
[149.412738, "o", "\u001b[?2004h> "]
[149.412838, "o", "        'total_features_analyzed': len(valid_features)\r\n\u001b[?2004l\r"]
[149.412884, "o", "\u001b[?2004h> "]
[149.412931, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.412973, "o", "    'surge_categories': [],\r\n\u001b[?2004l\r"]
[149.413019, "o", "\u001b[?2004h> "]
[149.413072, "o", "    'slump_categories': [],\r\n\u001b[?2004l\r"]
[149.413117, "o", "\u001b[?2004h> "]
[149.413164, "o", "    'summary': {\r\n\u001b[?2004l\r"]
[149.413211, "o", "\u001b[?2004h> "]
[149.413416, "o", "        'surge': {'total_categories': len(top_surge), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.413627, "o", "        'slump': {'total_categories': len(top_slump), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0}\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.413653, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.413704, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.413753, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.413823, "o", "# Precompute purchase metrics\r\n\u001b[?2004l\r"]
[149.413861, "o", "\u001b[?2004h> n_at_risk = len(users)\r\n\u001b[?2004l\r"]
[149.413904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.413948, "o", "\u001b[?2004h> "]
[149.414124, "o", "for cat_list, key in [(top_surge, 'surge_categories'), (top_slump, 'slump_categories')]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.414171, "o", "> "]
[149.414218, "o", "    for cat in cat_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.414364, "o", "        cat_daily = anomaly_df[anomaly_df['Category']==cat].iloc[0]\r\n\u001b[?2004l\r"]
[149.414409, "o", "\u001b[?2004h> "]
[149.414465, "o", "        # baseline and treatment metrics\r\n\u001b[?2004l\r"]
[149.414512, "o", "\u001b[?2004h> "]
[149.414745, "o", "        base_users = p[(p['Category']==cat) & (p['date']>=baseline_start) & (p['date']<=baseline_end)]['Survey ResponseID'].nunique()\r\n\u001b[?2004l\r"]
[149.414769, "o", "\u001b[?2004h> "]
[149.414987, "o", "        treat_users = p[(p['Category']==cat) & (p['date']>=treatment_start) & (p['date']<=treatment_end)]['Survey ResponseID'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.415038, "o", "> "]
[149.415122, "o", "        base_rate = base_users / n_at_risk if n_at_risk else 0\r\n\u001b[?2004l\r"]
[149.415166, "o", "\u001b[?2004h> "]
[149.415276, "o", "        treat_rate = treat_users / n_at_risk if n_at_risk else 0\r\n\u001b[?2004l\r"]
[149.41532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.415402, "o", "        df_cat = agg[agg['Category']==cat].copy()\r\n\u001b[?2004l\r"]
[149.415448, "o", "\u001b[?2004h> "]
[149.415631, "o", "        df_cat = df_cat.merge(features, left_on='Survey ResponseID', right_index=True, how='left')\r\n\u001b[?2004l\r"]
[149.415686, "o", "\u001b[?2004h> "]
[149.415803, "o", "        df_cat['period_ind'] = (df_cat['Period']=='treatment').astype(int)\r\n\u001b[?2004l\r"]
[149.415851, "o", "\u001b[?2004h> "]
[149.415877, "o", "        # intensive\r\n\u001b[?2004l\r"]
[149.415924, "o", "\u001b[?2004h> "]
[149.415984, "o", "        int_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.416086, "o", "        for feat in valid_features:\r\n\u001b[?2004l\r"]
[149.416132, "o", "\u001b[?2004h> "]
[149.416178, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.416322, "o", "                coef, pval = did_regression(df_cat, 'Total_Spend', feat)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.416368, "o", "> "]
[149.416631, "o", "                int_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Univariate DiD'})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.416691, "o", "            except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.416747, "o", "> "]
[149.416787, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.416847, "o", "        # extensive\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.416897, "o", "> "]
[149.416934, "o", "        df_cat_ext = df_cat.copy()\r\n\u001b[?2004l\r"]
[149.41699, "o", "\u001b[?2004h> "]
[149.417152, "o", "        df_cat_ext['Has_Purchase'] = (df_cat_ext['Total_Spend']>0).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.417205, "o", "        ext_results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.41726, "o", "> "]
[149.41731, "o", "        for feat in valid_features:\r\n\u001b[?2004l\r"]
[149.417361, "o", "\u001b[?2004h> "]
[149.417412, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.417584, "o", "                coef, pval = did_regression(df_cat_ext, 'Has_Purchase', feat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.417902, "o", "                ext_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Multivariate Heterogeneous DiD'})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.417961, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[149.418015, "o", "\u001b[?2004h> "]
[149.418065, "o", "                continue\r\n\u001b[?2004l\r"]
[149.418114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.418199, "o", "        # sort and select top 3\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.418252, "o", "> "]
[149.418285, "o", "        if key == 'surge_categories':\r\n\u001b[?2004l\r"]
[149.418331, "o", "\u001b[?2004h> "]
[149.418524, "o", "            int_results = sorted(int_results, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.418717, "o", "            ext_results = sorted(ext_results, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.418763, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.418809, "o", "> "]
[149.41894, "o", "            int_results = sorted(int_results, key=lambda x: x['did_estimate'])[:3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.418984, "o", "> "]
[149.419121, "o", "            ext_results = sorted(ext_results, key=lambda x: x['did_estimate'])[:3]\r\n\u001b[?2004l\r"]
[149.419169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.419217, "o", "> "]
[149.419274, "o", "        report[key].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.419313, "o", "            'category': cat,\r\n\u001b[?2004l\r"]
[149.419366, "o", "\u001b[?2004h> "]
[149.419487, "o", "            'anomaly_index': float(cat_daily['Anomaly_Index']),\r\n\u001b[?2004l\r"]
[149.419533, "o", "\u001b[?2004h> "]
[149.41965, "o", "            'baseline_avg_spend': float(cat_daily['baseline_avg_spend']),\r\n\u001b[?2004l\r"]
[149.419698, "o", "\u001b[?2004h> "]
[149.419842, "o", "            'treatment_avg_spend': float(cat_daily['treatment_avg_spend']),\r\n\u001b[?2004l\r"]
[149.419888, "o", "\u001b[?2004h> "]
[149.419958, "o", "            'n_purchasers_baseline': int(base_users),\r\n\u001b[?2004l\r"]
[149.420013, "o", "\u001b[?2004h> "]
[149.420125, "o", "            'n_purchasers_treatment': int(treat_users),\r\n\u001b[?2004l\r"]
[149.420172, "o", "\u001b[?2004h> "]
[149.420252, "o", "            'baseline_purchase_rate': float(base_rate),\r\n\u001b[?2004l\r"]
[149.420298, "o", "\u001b[?2004h> "]
[149.420409, "o", "            'treatment_purchase_rate': float(treat_rate),\r\n\u001b[?2004l\r"]
[149.420458, "o", "\u001b[?2004h> "]
[149.420506, "o", "            'n_at_risk': int(n_at_risk),\r\n\u001b[?2004l\r"]
[149.420551, "o", "\u001b[?2004h> "]
[149.420669, "o", "            'intensive_margin': int_results,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.420745, "o", "            'extensive_margin': ext_results\r\n\u001b[?2004l\r"]
[149.420791, "o", "\u001b[?2004h> "]
[149.42084, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.420895, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.421124, "o", "        report['summary']['surge' if key=='surge_categories' else 'slump']['total_intensive_drivers'] += len(int_results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.42115, "o", "> "]
[149.421416, "o", "        report['summary']['surge' if key=='surge_categories' else 'slump']['total_extensive_drivers'] += len(ext_results)\r\n\u001b[?2004l\r"]
[149.421442, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.421462, "o", "> "]
