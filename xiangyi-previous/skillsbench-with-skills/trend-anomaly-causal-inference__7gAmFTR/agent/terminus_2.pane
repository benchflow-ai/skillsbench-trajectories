treatment_end [?2004h> import pandas as pd, numpy as np, os, json
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> try:
[?2004l[?2004h>     import statsmodels.api as sm
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     sm = None
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/app/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Helper functions
[?2004l[?2004h> 
[?2004l[?2004h> def clean_str(x):
[?2004l[?2004h>     if pd.isna(x):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     s = str(x).strip()
[?2004l[?2004h>     if s == '' or s.lower() in ['nan','none','na','null']:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> def normalize_yesno(s):
[?2004l[?2004h>     if pd.isna(s):
[?2004l[?2004h>         return s
[?2004l[?2004h>     sl = str(s).strip().lower()
[?2004l[?2004h>     if sl in ['yes','y','true','1']:
[?2004l[?2004h>         return 'Yes'
[?2004l[?2004h>     if sl in ['no','n','false','0']:
[?2004l[?2004h>         return 'No'
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> # Load and clean survey data
[?2004l[?2004h> survey = pd.read_csv('/app/data/survey_dirty.csv')
[?2004l[?2004h> survey.columns = [c.strip() for c in survey.columns]
[?2004l[?2004h> if 'Survey ResponseID' not in survey.columns:
[?2004l[?2004h>     survey.rename(columns={survey.columns[0]:'Survey ResponseID'}, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> survey = survey.drop_duplicates(subset=['Survey ResponseID'])
[?2004l[?2004h> for col in survey.columns:
[?2004l[?2004h>     if col == 'Survey ResponseID':
[?2004l[?2004h>         continue
[?2004l[?2004h>     survey[col] = survey[col].apply(clean_str).apply(normalize_yesno)
[?2004l[?2004h>     survey[col] = survey[col].fillna('Unknown')
[?2004l[?2004h> 
[?2004l[?2004h> survey_cleaned = survey.copy()
[?2004l[?2004h> survey_cleaned.to_csv('/app/output/survey_cleaned.csv', index=False)
[?2004l[?2004h> 
[?2004l>[?2004h> # Feature engineering
[?2004l[?2004h> feature_df = pd.get_dummies(survey_cleaned.drop(columns=['Survey ResponseID']), prefix_sep='=')
[?2004l[?2004h> feature_df = pd.concat([survey_cleaned[['Survey ResponseID']], feature_df], axis=1)
[?2004l[?2004h> feature_df.to_csv('/app/output/survey_feature_engineered.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Load and clean purchases data
[?2004l[?2004h> p = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')
[?2004l[?2004h> p.columns = [c.strip() for c in p.columns]
[?2004l[?2004h> 
[?2004l[?2004h> p['Order Date'] = pd.to_datetime(p['Order Date'], errors='coerce')
[?2004l[?2004h> p['Purchase Price Per Unit'] = pd.to_numeric(p['Purchase Price Per Unit'], errors='coerce')
[?2004l[?2004h> p['Quantity'] = pd.to_numeric(p['Quantity'], errors='coerce')
[?2004l[?2004h> p['Category'] = p['Category'].apply(clean_str).str.upper()
[?2004l[?2004h> p['Category'] = p['Category'].fillna('UNKNOWN')
[?2004l[?2004h> 
[?2004l[?2004h> p = p.dropna(subset=['Order Date','Purchase Price Per Unit','Quantity','Survey ResponseID'])
[?2004l[?2004h> p = p[(p['Purchase Price Per Unit']>0) & (p['Quantity']>0)]
[?2004l[?2004h> p['Total_Spend'] = p['Purchase Price Per Unit'] * p['Quantity']
[?2004l[?2004h> p = p.drop_duplicates()
[?2004l[?2004h> 
[?2004l[?2004h> p.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Anomaly detection
[?2004l[?2004h> p['date'] = p['Order Date'].dt.normalize()
[?2004l[?2004h> end_date = pd.to_datetime('2020-03-31')
[?2004l[?2004h> start_date = p['date'].min()
[?2004l[?2004h> all_dates = pd.date_range(start_date, end_date, freq='D')
[?2004l[?2004h> 
[?2004l[?2004h> daily_sales = p.groupby(['Category','date'])['Total_Spend'].sum().reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> records = []
[?2004l[?2004h> for cat, grp in daily_sales.groupby('Category'):
[?2004l[?2004h>     s = grp.set_index('date').reindex(all_dates, fill_value=0)['Total_Spend']
[?2004l[?2004h>     baseline = s[s.index < pd.to_datetime('2020-03-01')]
[?2004l[?2004h>     treatment = s[(s.index >= pd.to_datetime('2020-03-01')) & (s.index <= end_date)]
[?2004l[?2004h>     baseline_mean = baseline.mean()
[?2004l[?2004h>     baseline_std = baseline.std()
[?2004l[?2004h>     treatment_mean = treatment.mean()
[?2004l[?2004h>     if baseline_std == 0 or np.isnan(baseline_std):
[?2004l[?2004h>         if treatment_mean == baseline_mean:
[?2004l[?2004h>             z = 0
[?2004l[?2004h>         else:
[?2004l[?2004h>             z = np.sign(treatment_mean - baseline_mean) * 5
[?2004l[?2004h>     else:
[?2004l[?2004h>         z = (treatment_mean - baseline_mean) / baseline_std
[?2004l[?2004h>     anomaly = np.tanh(z) * 100
[?2004l[?2004h>     records.append({'Category': cat, 'Anomaly_Index': anomaly,
[?2004l[?2004h>                     'baseline_avg_spend': baseline_mean,
[?2004l[?2004h>                     'treatment_avg_spend': treatment_mean})
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_df = pd.DataFrame(records)
[?2004l[?2004h> anomaly_df[['Category','Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Identify top categories
[?2004l[?2004h> anomaly_sorted = anomaly_df.sort_values('Anomaly_Index', ascending=False)
[?2004l[?2004h> top_surge = anomaly_sorted.head(10)['Category'].tolist()
[?2004l[?2004h> top_slump = anomaly_sorted.tail(10)['Category'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate user-category-period data
[?2004l[?2004h> users = survey_cleaned['Survey ResponseID'].unique()
[?2004l[?2004h> all_top_categories = list(dict.fromkeys(top_surge + top_slump))
[?2004l[?2004h> 
[?2004l [?2004h> baseline_start = pd.to_datetime('2020-01-01')
[?2004l[?2004h> baseline_end = pd.to_datetime('2020-02-29')
[?2004l[?2004h> treatment_start = pd.to_datetime('2020-03-01')
[?2004l[?2004h> treatment_end = pd.to_datetime('2020-03-31')
[?2004l[?2004h> 
[?2004l[?2004h> index = pd.MultiIndex.from_product([users, all_top_categories], names=['Survey ResponseID','Category'])
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> for period_name, (start, end) in {'baseline':(baseline_start, baseline_end), 'treatment':(treatment_start, treatment_end)}.items():
[?2004l[?2004h>     df_period = p[(p['date']>=start) & (p['date']<=end) & (p['Category'].isin(all_top_categories))]
[?2004l[?2004h>     spend = df_period.groupby(['Survey ResponseID','Category'])['Total_Spend'].sum()
[?2004l[?2004h>     spend = spend.reindex(index, fill_value=0).reset_index()
[?2004l[?2004h>     spend['Period'] = period_name
[?2004l[?2004h>     rows.append(spend)
[?2004l[?2004h> 
[?2004lu[?2004h> agg = pd.concat(rows, ignore_index=True)
[?2004l[?2004h> agg_intensive = agg[['Survey ResponseID','Category','Period','Total_Spend']].copy()
[?2004l[?2004h> agg_intensive.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> agg_extensive = agg.copy()
[?2004l[?2004h> agg_extensive['Has_Purchase'] = (agg_extensive['Total_Spend']>0).astype(int)
[?2004l[?2004h> agg_extensive = agg_extensive[['Survey ResponseID','Category','Period','Has_Purchase']]
[?2004l[?2004h> agg_extensive.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)
[?2004l[?2004h> 
[?2004ls[?2004h> # Causal analysis
[?2004l[?2004h> features = feature_df.set_index('Survey ResponseID')
[?2004l[?2004h> feature_cols = [c for c in features.columns if features[c].nunique()>1]
[?2004l[?2004h> # filter features with prevalence >=5%
[?2004l[?2004h> valid_features = [c for c in feature_cols if features[c].mean()>=0.05 and features[c].mean()<=0.95]
[?2004l[?2004h> 
[?2004l [?2004h> 
[?2004l [?2004h> def did_regression(df, outcome, feature):
[?2004l[?2004h>     X = pd.DataFrame({
[?2004l[?2004h>         'feature': df[feature],
[?2004l[?2004h>         'period': df['period_ind'],
[?2004l[?2004h>     })
[?2004l[?2004h>     X['interaction'] = X['feature'] * X['period']
[?2004l[?2004h>     if sm is None:
[?2004l[?2004h>         # simple OLS using numpy
[?2004l[?2004h>         X_mat = np.column_stack([np.ones(len(X)), X['feature'], X['period'], X['interaction']])
[?2004l[?2004h>         y = df[outcome].values
[?2004l[?2004h>         beta = np.linalg.lstsq(X_mat, y, rcond=None)[0]
[?2004l[?2004h>         # approximate p-value not computed; return nan
[?2004l[?2004h>         return beta[3], np.nan
[?2004l[?2004h>     else:
[?2004l[?2004h>         X_mat = sm.add_constant(X)
[?2004l[?2004h>         model = sm.OLS(df[outcome], X_mat).fit()
[?2004l[?2004h>         return model.params['interaction'], model.pvalues['interaction']
[?2004l[?2004h> 
[?2004l[?2004h> report = {
[?2004l[?2004h>     'metadata': {
[?2004l[?2004h>         'baseline_start': baseline_start.strftime('%m-%d-%Y'),
[?2004l[?2004h>         'baseline_end': baseline_end.strftime('%m-%d-%Y'),
[?2004l[?2004h>         'treatment_start': treatment_start.strftime('%m-%d-%Y'),
[?2004l[?2004h>         'treatment_end': treatment_end.strftime('%m-%d-%Y'),
[?2004l[?2004h>         'total_features_analyzed': len(valid_features)
[?2004l[?2004h>     },
[?2004l[?2004h>     'surge_categories': [],
[?2004l[?2004h>     'slump_categories': [],
[?2004l[?2004h>     'summary': {
[?2004l[?2004h>         'surge': {'total_categories': len(top_surge), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0},
[?2004l[?2004h>         'slump': {'total_categories': len(top_slump), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0}
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Precompute purchase metrics
[?2004l[?2004h> n_at_risk = len(users)
[?2004l[?2004h> 
[?2004l[?2004h> for cat_list, key in [(top_surge, 'surge_categories'), (top_slump, 'slump_categories')]:
[?2004l[?2004h>     for cat in cat_list:
[?2004l[?2004h>         cat_daily = anomaly_df[anomaly_df['Category']==cat].iloc[0]
[?2004l[?2004h>         # baseline and treatment metrics
[?2004l[?2004h>         base_users = p[(p['Category']==cat) & (p['date']>=baseline_start) & (p['date']<=baseline_end)]['Survey ResponseID'].nunique()
[?2004l[?2004h>         treat_users = p[(p['Category']==cat) & (p['date']>=treatment_start) & (p['date']<=treatment_end)]['Survey ResponseID'].nunique()
[?2004l[?2004h>         base_rate = base_users / n_at_risk if n_at_risk else 0
[?2004l[?2004h>         treat_rate = treat_users / n_at_risk if n_at_risk else 0
[?2004l[?2004h> 
[?2004l[?2004h>         df_cat = agg[agg['Category']==cat].copy()
[?2004l[?2004h>         df_cat = df_cat.merge(features, left_on='Survey ResponseID', right_index=True, how='left')
[?2004l[?2004h>         df_cat['period_ind'] = (df_cat['Period']=='treatment').astype(int)
[?2004l[?2004h>         # intensive
[?2004l[?2004h>         int_results = []
[?2004l[?2004h>         for feat in valid_features:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 coef, pval = did_regression(df_cat, 'Total_Spend', feat)
[?2004l[?2004h>                 int_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Univariate DiD'})
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         # extensive
[?2004l[?2004h>         df_cat_ext = df_cat.copy()
[?2004l[?2004h>         df_cat_ext['Has_Purchase'] = (df_cat_ext['Total_Spend']>0).astype(int)
[?2004l[?2004h>         ext_results = []
[?2004l[?2004h>         for feat in valid_features:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 coef, pval = did_regression(df_cat_ext, 'Has_Purchase', feat)
[?2004l[?2004h>                 ext_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Multivariate Heterogeneous DiD'})
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>         # sort and select top 3
[?2004l[?2004h>         if key == 'surge_categories':
[?2004l[?2004h>             int_results = sorted(int_results, key=lambda x: x['did_estimate'], reverse=True)[:3]
[?2004l[?2004h>             ext_results = sorted(ext_results, key=lambda x: x['did_estimate'], reverse=True)[:3]
[?2004l[?2004h>         else:
[?2004l[?2004h>             int_results = sorted(int_results, key=lambda x: x['did_estimate'])[:3]
[?2004l[?2004h>             ext_results = sorted(ext_results, key=lambda x: x['did_estimate'])[:3]
[?2004l[?2004h> 
[?2004l[?2004h>         report[key].append({
[?2004l[?2004h>             'category': cat,
[?2004l[?2004h>             'anomaly_index': float(cat_daily['Anomaly_Index']),
[?2004l[?2004h>             'baseline_avg_spend': float(cat_daily['baseline_avg_spend']),
