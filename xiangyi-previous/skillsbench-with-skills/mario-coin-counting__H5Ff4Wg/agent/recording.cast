[18.243465, "i", "python3 << 'EOF'\nimport cv2\nimport os\nimport csv\nfrom pathlib import Path\n\n# Step 1: Convert all keyframes to grayscale (in-place)\nprint(\"Converting frames to grayscale...\")\nfor i in range(1, 28):\n    frame_path = f\"/root/keyframes_{i:03d}.png\"\n    if os.path.exists(frame_path):\n        img = cv2.imread(frame_path)\n        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n        cv2.imwrite(frame_path, gray)\n        print(f\"Converted {frame_path}\")\n\nprint(\"\\nAll frames converted to grayscale.\")\nEOF\n"]
