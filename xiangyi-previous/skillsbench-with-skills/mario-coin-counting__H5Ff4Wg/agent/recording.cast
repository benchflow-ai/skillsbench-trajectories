[413.375838, "o", "        # Use TM_CCORR_NORMED for normalized correlation\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.375887, "o", "> "]
[413.376079, "o", "        result = cv2.matchTemplate(frame_small, template_small, cv2.TM_CCORR_NORMED)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.376122, "o", ">         \r\n\u001b[?2004l\r"]
[413.376171, "o", "\u001b[?2004h> "]
[413.376284, "o", "        # Find matches above very high threshold\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.376336, "o", "> "]
[413.376442, "o", "        locations = np.where(result >= threshold)\r\n\u001b[?2004l\r"]
[413.376492, "o", "\u001b[?2004h> "]
[413.376532, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.376633, "o", "        if len(locations[0]) == 0:\r\n\u001b[?2004l\r"]
[413.376686, "o", "\u001b[?2004h> "]
[413.376727, "o", "            return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.37678, "o", ">         \r\n"]
[413.376823, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[413.376892, "o", "        # Count non-overlapping matches\r\n\u001b[?2004l\r"]
[413.376937, "o", "\u001b[?2004h> "]
[413.377086, "o", "        matches = list(zip(locations[1], locations[0]))\r\n\u001b[?2004l\r"]
[413.37711, "o", "\u001b[?2004h> "]
[413.377272, "o", "        template_h, template_w = template_small.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.377423, "o", "        min_distance = max(template_h, template_w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.377481, "o", "        \r\n\u001b[?2004l\r"]
[413.377526, "o", "\u001b[?2004h>         selected = []\r\n\u001b[?2004l\r"]
[413.377568, "o", "\u001b[?2004h> "]
[413.377641, "o", "        for x, y in sorted(matches):\r\n\u001b[?2004l\r"]
[413.377697, "o", "\u001b[?2004h> "]
[413.377759, "o", "            overlaps = False\r\n\u001b[?2004l\r"]
[413.377807, "o", "\u001b[?2004h> "]
[413.377869, "o", "            for sx, sy in selected:\r\n\u001b[?2004l\r"]
[413.377908, "o", "\u001b[?2004h> "]
[413.378094, "o", "                if abs(x - sx) < min_distance and abs(y - sy) < min_distance:\r\n\u001b[?2004l\r"]
[413.378181, "o", "\u001b[?2004h> "]
[413.378227, "o", "                    overlaps = True\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.378257, "o", "> "]
[413.378327, "o", "            if not overlaps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378375, "o", "                selected.append((x, y))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378418, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378459, "o", "        return len(selected)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.37852, "o", "> "]
[413.378566, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378611, "o", "        print(f\"Error: {e}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[413.378661, "o", "\u001b[?2004h> "]
[413.378704, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r"]
[413.378745, "o", "\u001b[?2004h> "]
[413.378784, "o", "print(\"Processing frames...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378824, "o", "sys.stdout.flush()\r\n\u001b[?2004l\r"]
[413.378875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.378926, "o", "for i in range(1, 28):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.379003, "o", "    frame_path = f\"/root/keyframes_{i:03d}.png\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.379043, "o", "> "]
[413.379087, "o", "    frame_id = f\"/root/keyframes_{i:03d}.png\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.379127, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.379257, "o", "    coins = count_objects_very_fast(frame_path, \"/root/coin.png\", threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.379297, "o", "> "]
[413.379412, "o", "    enemies = count_objects_very_fast(frame_path, \"/root/enemy.png\", threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.379542, "o", "    turtles = count_objects_very_fast(frame_path, \"/root/turtle.png\", threshold=0.8)\r\n\u001b[?2004l\r"]
[413.379595, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[413.379636, "o", "\u001b[?2004h> "]
[413.379773, "o", "    results.append({'frame_id': frame_id, 'coins': coins, 'enemies': enemies, 'turtles': turtles})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.379886, "o", "    print(f\"Frame {i:03d}: coins={coins}, enemies={enemies}, turtles={turtles}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.379936, "o", "> "]
[413.379978, "o", "    sys.stdout.flush()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.380069, "o", "with open('/root/counting_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.380119, "o", "> "]
[413.380229, "o", "    writer = csv.DictWriter(f, fieldnames=['frame_id', 'coins', 'enemies', 'turtles'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.380283, "o", "> "]
[413.380323, "o", "    writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.380376, "o", "    writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.380418, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Done!\")\r\n\u001b[?2004l\r"]
[413.380466, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
