[36.804447, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndata_sheet = wb['Data']\nprint('Sample data (first 5 rows):')\nfor row in range(1, 6):\n    name = data_sheet.cell(row, 1).value\n    sex = data_sheet.cell(row, 2).value\n    bw = data_sheet.cell(row, 9).value\n    sq = data_sheet.cell(row, 11).value\n    bp = data_sheet.cell(row, 12).value\n    dl = data_sheet.cell(row, 13).value\n    print(f'Row {row}: Name={name}, Sex={sex}, BW={bw}, Sq={sq}, Bp={bp}, Dl={dl}')\n\"\n"]
