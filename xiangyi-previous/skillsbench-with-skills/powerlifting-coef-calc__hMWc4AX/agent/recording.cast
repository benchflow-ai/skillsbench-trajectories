[62.91491, "o", "    (13, 'Best3DeadliftKg')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.914967, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.915015, "o", "# Copy data from Data sheet to Dots sheet\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.915064, "o", "> "]
[62.915102, "o", "max_row = data_sheet.max_row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.915169, "o", "for row in range(1, max_row + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.915319, "o", "    for col_idx, (src_col, col_name) in enumerate(columns_to_copy, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.915463, "o", "        dots_sheet.cell(row, col_idx).value = data_sheet.cell(row, src_col).value\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.915522, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.915599, "o", "> # Add TotalKg header (column 7)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.915636, "o", "> dots_sheet.cell(1, 7).value = 'TotalKg'\r\n\u001b[?2004l\r"]
[62.915714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.91577, "o", "# Add TotalKg formula for each data row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.915891, "o", "# TotalKg = Best3SquatKg + Best3BenchKg + Best3DeadliftKg (columns D, E, F in Dots sheet)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.915949, "o", "> "]
[62.916001, "o", "for row in range(2, max_row + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.916063, "o", "    # Formula: =ROUND(D{row}+E{row}+F{row}, 3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.91611, "o", "> "]
[62.916205, "o", "    dots_sheet.cell(row, 7).value = f'=ROUND(D{row}+E{row}+F{row},3)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.916262, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.916325, "o", "# Add Dots header (column 8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.916388, "o", "dots_sheet.cell(1, 8).value = 'Dots'\r\n\u001b[?2004l\r"]
[62.91644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.916501, "o", "> # Dots formula coefficients\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.916555, "o", "> "]
[62.916636, "o", "# Male: A=-0.0000010930, B=0.0007391293, C=-0.1918759221, D=24.0900756, E=-307.75076\r\n\u001b[?2004l\r"]
[62.916688, "o", "\u001b[?2004h> "]
[62.916791, "o", "# Female: A=-0.0000010706, B=0.0005158568, C=-0.1126655495, D=13.6175032, E=-57.96288\r\n\u001b[?2004l\r"]
[62.916845, "o", "\u001b[?2004h> "]
[62.916982, "o", "# Dots = Total * 500 / (A*bw^4 + B*bw^3 + C*bw^2 + D*bw + E)\r\n\u001b[?2004l\r"]
[62.917009, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917158, "o", "# In Dots sheet: Sex is column B, BodyweightKg is column C, TotalKg is column G\r\n\u001b[?2004l\r"]
[62.917222, "o", "\u001b[?2004h> "]
[62.917288, "o", "for row in range(2, max_row + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917343, "o", "    # Create formula with IF to check sex\r\n\u001b[?2004l\r"]
[62.917371, "o", "\u001b[?2004h> "]
[62.917452, "o", "    # Male coefficients\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917515, "o", "    male_a = -0.0000010930\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917591, "o", "    male_b = 0.0007391293\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917646, "o", "    male_c = -0.1918759221\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.917703, "o", ">     male_d = 24.0900756\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917767, "o", "    male_e = -307.75076\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.91782, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.917888, "o", "    # Female coefficients\r\n\u001b[?2004l\r"]
[62.917952, "o", "\u001b[?2004h> "]
[62.917982, "o", "    female_a = -0.0000010706\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.918033, "o", "    female_b = 0.0005158568\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.91811, "o", "> "]
[62.918172, "o", "    female_c = -0.1126655495\r\n\u001b[?2004l\r\u001b[?2004h>     female_d = 13.6175032\r\n\u001b[?2004l\r"]
[62.918233, "o", "\u001b[?2004h>     female_e = -57.96288\r\n\u001b[?2004l\r"]
[62.918293, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.918345, "o", "    # Build the formula\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.918501, "o", "    # Dots = ROUND(G{row} * 500 / (A*C{row}^4 + B*C{row}^3 + C*C{row}^2 + D*C{row} + E), 3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.918554, "o", "> "]
[62.918705, "o", "    male_denom = f'({male_a}*C{row}^4+{male_b}*C{row}^3+{male_c}*C{row}^2+{male_d}*C{row}+{male_e})'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.918925, "o", "    female_denom = f'({female_a}*C{row}^4+{female_b}*C{row}^3+{female_c}*C{row}^2+{female_d}*C{row}+{female_e})'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[62.918986, "o", "\u001b[?2004h> "]
[62.919136, "o", "    formula = f'=ROUND(IF(B{row}=\"M\",G{row}*500/{male_denom},G{row}*500/{female_denom}),3)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919293, "o", "    dots_sheet.cell(row, 8).value = formula\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.919345, "o", "> # Save workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919418, "o", "wb.save('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919501, "o", "print('Done! Dots sheet updated successfully.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.919523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919636, "o", "# Verify the result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919698, "o", "wb2 = openpyxl.load_workbook('/root/data/openipf.xlsx')"]
[62.919767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919827, "o", "dots = wb2['Dots']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.919883, "o", "print('\\nDots sheet headers:')\r\n\u001b[?2004l\r"]
[62.919911, "o", "\u001b[?2004h> "]
[62.919973, "o", "for col in range(1, 9):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.920068, "o", "    print(f'  Column {col}: {dots.cell(1, col).value}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.920129, "o", "> "]
[62.920183, "o", "print('\\nFirst few rows (formulas):')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.920224, "o", "> "]
[62.920295, "o", "for row in range(2, min(5, max_row + 1)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.920358, "o", "    print(f'Row {row}:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.920428, "o", "    for col in range(1, 9):\r\n\u001b[?2004l\r"]
[62.920459, "o", "\u001b[?2004h> "]
[62.920602, "o", "        print(f'  {dots.cell(1, col).value}: {dots.cell(row, col).value}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.920655, "o", "> EOF\r\n\u001b[?2004l\r"]
[62.921925, "o", "\u001b[?2004hroot@8ae215b9d2e4:~# "]
[66.751553, "i", "python3 /tmp/process_dots.py\n"]
[66.751758, "o", "python3 /tmp/process_dots.py\r\n\u001b[?2004l\r"]
[66.868953, "o", "Done! Dots sheet updated successfully.\r\n"]
[66.878827, "o", "\r\nDots sheet headers:\r\n  Column 1: Name\r\n  Column 2: Sex\r\n  Column 3: BodyweightKg\r\n  Column 4: Best3SquatKg\r\n  Column 5: Best3BenchKg\r\n  Column 6: Best3DeadliftKg\r\n  Column 7: TotalKg\r\n  Column 8: Dots\r\n\r\nFirst few rows (formulas):\r\nRow 2:\r\n  Name: Julien Comte\r\n  Sex: M\r\n  BodyweightKg: 82.25\r\n  Best3SquatKg: 215\r\n  Best3BenchKg: 132.5\r\n  Best3DeadliftKg: 260\r\n  TotalKg: =ROUND(D2+E2+F2,3)\r\n"]
[66.878897, "o", "  Dots: =ROUND(IF(B2=\"M\",G2*500/(-1.093e-06*C2^4+0.0007391293*C2^3+-0.1918759221*C2^2+24.0900756*C2+-307.75076),G2*500/(-1.0706e-06*C2^4+0.0005158568*C2^3+-0.1126655495*C2^2+13.6175032*C2+-57.96288)),3)\r\nRow 3:\r\n  Name: Matthew Starkey\r\n  Sex: M\r\n  BodyweightKg: 82.9\r\n  Best3SquatKg: 205\r\n  Best3BenchKg: 130\r\n  Best3DeadliftKg: 227.5\r\n  TotalKg: =ROUND(D3+E3+F3,3)\r\n  Dots: =ROUND(IF(B3=\"M\",G3*500/(-1.093e-06*C3^4+0.0007391293*C3^3+-0.1918759221*C3^2+24.0900756*C3+-307.75076),G3*500/(-1.0706e-06*C3^4+0.0005158568*C3^3+-0.1126655495*C3^2+13.6175032*C3+-57.96288)),3)\r\nRow 4:\r\n  Name: Austin Keanu\r\n"]
[66.878946, "o", "  Sex: M\r\n  BodyweightKg: 122.4\r\n  Best3SquatKg: 275\r\n  Best3BenchKg: 142.5\r\n  Best3DeadliftKg: 235\r\n  TotalKg: =ROUND(D4+E4+F4,3)\r\n  Dots: =ROUND(IF(B4=\"M\",G4*500/(-1.093e-06*C4^4+0.0007391293*C4^3+-0.1918759221*C4^2+24.0900756*C4+-307.75076),G4*500/(-1.0706e-06*C4^4+0.0005158568*C4^3+-0.1126655495*C4^2+13.6175032*C4+-57.96288)),3)\r\n"]
[66.895035, "o", "\u001b[?2004hroot@8ae215b9d2e4:~# "]
[79.54107, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndots = wb['Dots']\nprint('All rows in Dots sheet:')\nfor row in range(1, dots.max_row + 1):\n    row_data = []\n    for col in range(1, 9):\n        val = dots.cell(row, col).value\n        if isinstance(val, str) and len(val) > 50:\n            val = val[:50] + '...'\n        row_data.append(str(val))\n    print(f'Row {row}: {row_data}')\n\"\n"]
