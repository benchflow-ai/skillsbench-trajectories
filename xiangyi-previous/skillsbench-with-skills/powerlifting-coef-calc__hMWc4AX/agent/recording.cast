[36.9175, "o", "Sample data (first 5 rows):\r\nRow 1: Name=Name, Sex=Sex, BW=BodyweightKg, Sq=Best3SquatKg, Bp=Best3BenchKg, Dl=Best3DeadliftKg\r\nRow 2: Name=Julien Comte, Sex=M, BW=82.25, Sq=215, Bp=132.5, Dl=260\r\nRow 3: Name=Matthew Starkey, Sex=M, BW=82.9, Sq=205, Bp=130, Dl=227.5\r\nRow 4: Name=Austin Keanu, Sex=M, BW=122.4, Sq=275, Bp=142.5, Dl=235\r\nRow 5: Name=Michelle McKeaveney, Sex=F, BW=96.8, Sq=102.5, Bp=50, Dl=137.5\r\n"]
[36.93155, "o", "\u001b[?2004hroot@8ae215b9d2e4:~# "]
[62.913076, "i", "cat > /tmp/process_dots.py << 'EOF'\nimport openpyxl\n\n# Load workbook\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndata_sheet = wb['Data']\ndots_sheet = wb['Dots']\n\n# Clear Dots sheet if it has any data\nfor row in dots_sheet.iter_rows():\n    for cell in row:\n        cell.value = None\n\n# Column mapping from Data sheet (1-indexed)\n# Need: Name(1), Sex(2), BodyweightKg(9), Best3SquatKg(11), Best3BenchKg(12), Best3DeadliftKg(13)\n# Keep same order as in Data sheet\ncolumns_to_copy = [\n    (1, 'Name'),\n    (2, 'Sex'),\n    (9, 'BodyweightKg'),\n    (11, 'Best3SquatKg'),\n    (12, 'Best3BenchKg'),\n    (13, 'Best3DeadliftKg')\n]\n\n# Copy data from Data sheet to Dots sheet\nmax_row = data_sheet.max_row\nfor row in range(1, max_row + 1):\n    for col_idx, (src_col, col_name) in enumerate(columns_to_copy, 1):\n        dots_sheet.cell(row, col_idx).value = data_sheet.cell(row, src_col).value\n\n# Add TotalKg header (column 7)\ndots_sheet.cell(1, 7).value = 'TotalKg'\n\n# Add TotalKg formula for each data row\n# TotalKg = Best3SquatKg + Best3BenchKg + Best3DeadliftKg (columns D, E, F in Dots sheet)\nfor row in range(2, max_row + 1):\n    # Formula: =ROUND(D{row}+E{row}+F{row}, 3)\n    dots_sheet.cell(row, 7).value = f'=ROUND(D{row}+E{row}+F{row},3)'\n\n# Add Dots header (column 8)\ndots_sheet.cell(1, 8).value = 'Dots'\n\n# Dots formula coefficients\n# Male: A=-0.0000010930, B=0.0007391293, C=-0.1918759221, D=24.0900756, E=-307.75076\n# Female: A=-0.0000010706, B=0.0005158568, C=-0.1126655495, D=13.6175032, E=-57.96288\n# Dots = Total * 500 / (A*bw^4 + B*bw^3 + C*bw^2 + D*bw + E)\n\n# In Dots sheet: Sex is column B, BodyweightKg is column C, TotalKg is column G\nfor row in range(2, max_row + 1):\n    # Create formula with IF to check sex\n    # Male coefficients\n    male_a = -0.0000010930\n    male_b = 0.0007391293\n    male_c = -0.1918759221\n    male_d = 24.0900756\n    male_e = -307.75076\n    \n    # Female coefficients\n    female_a = -0.0000010706\n    female_b = 0.0005158568\n    female_c = -0.1126655495\n    female_d = 13.6175032\n    female_e = -57.96288\n    \n    # Build the formula\n    # Dots = ROUND(G{row} * 500 / (A*C{row}^4 + B*C{row}^3 + C*C{row}^2 + D*C{row} + E), 3)\n    male_denom = f'({male_a}*C{row}^4+{male_b}*C{row}^3+{male_c}*C{row}^2+{male_d}*C{row}+{male_e})'\n    female_denom = f'({female_a}*C{row}^4+{female_b}*C{row}^3+{female_c}*C{row}^2+{female_d}*C{row}+{female_e})'\n    \n    formula = f'=ROUND(IF(B{row}=\"M\",G{row}*500/{male_denom},G{row}*500/{female_denom}),3)'\n    dots_sheet.cell(row, 8).value = formula\n\n# Save workbook\nwb.save('/root/data/openipf.xlsx')\nprint('Done! Dots sheet updated successfully.')\n\n# Verify the result\nwb2 = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndots = wb2['Dots']\nprint('\\nDots sheet headers:')\nfor col in range(1, 9):\n    print(f'  Column {col}: {dots.cell(1, col).value}')\nprint('\\nFirst few rows (formulas):')\nfor row in range(2, min(5, max_row + 1)):\n    print(f'Row {row}:')\n    for col in range(1, 9):\n        print(f'  {dots.cell(1, col).value}: {dots.cell(row, col).value}')\nEOF\n"]
