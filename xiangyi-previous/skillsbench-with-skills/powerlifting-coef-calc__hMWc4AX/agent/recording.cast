[108.581024, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\nprint('Sheets:', wb.sheetnames)\nprint()\ndots = wb['Dots']\nprint('Dots sheet structure:')\nprint(f'  Rows: {dots.max_row}')\nprint(f'  Columns: {dots.max_column}')\nprint()\nprint('Headers:', [dots.cell(1, c).value for c in range(1, dots.max_column + 1)])\nprint()\nprint('Sample formulas from row 2:')\nprint(f'  TotalKg formula: {dots.cell(2, 7).value}')\nprint(f'  Dots formula: {dots.cell(2, 8).value}')\n\"\n"]
