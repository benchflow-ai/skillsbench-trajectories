[108.582326, "o", "\"\r\n\u001b[?2004l\r"]
[108.713239, "o", "Sheets: ['Data', 'Dots']\r\n\r\nDots sheet structure:\r\n  Rows: 21\r\n  Columns: 8\r\n\r\nHeaders: ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg', 'TotalKg', 'Dots']\r\n\r\nSample formulas from row 2:\r\n  TotalKg formula: =ROUND(D2+E2+F2,3)\r\n  Dots formula: =ROUND(IF(B2=\"M\",G2*500/(-1.093e-06*C2^4+0.0007391293*C2^3+-0.1918759221*C2^2+24.0900756*C2+-307.75076),G2*500/(-1.0706e-06*C2^4+0.0005158568*C2^3+-0.1126655495*C2^2+13.6175032*C2+-57.96288)),3)\r\n"]
[108.730915, "o", "\u001b[?2004hroot@8ae215b9d2e4:~# "]
[125.441715, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndata = wb['Data']\ndots = wb['Dots']\n\nprint('Data sheet columns (relevant ones):')\nfor col in [1, 2, 9, 11, 12, 13]:\n    print(f'  Column {col}: {data.cell(1, col).value}')\n\nprint()\nprint('Dots sheet columns:')\nfor col in range(1, 9):\n    print(f'  Column {col}: {dots.cell(1, col).value}')\n\nprint()\nprint('Order verification:')\nprint('  Data: Name(1), Sex(2), BodyweightKg(9), Best3SquatKg(11), Best3BenchKg(12), Best3DeadliftKg(13)')\nprint('  Dots: Name(1), Sex(2), BodyweightKg(3), Best3SquatKg(4), Best3BenchKg(5), Best3DeadliftKg(6), TotalKg(7), Dots(8)')\nprint()\nprint('Column names match and order is preserved (relative order same as Data sheet).')\n\"\n"]
