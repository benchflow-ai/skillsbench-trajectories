[79.542236, "o", "\"\r\n\u001b[?2004l\r"]
[79.658855, "o", "All rows in Dots sheet:\r\nRow 1: ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg', 'TotalKg', 'Dots']\r\nRow 2: ['Julien Comte', 'M', '82.25', '215', '132.5', '260', '=ROUND(D2+E2+F2,3)', '=ROUND(IF(B2=\"M\",G2*500/(-1.093e-06*C2^4+0.0007391...']\r\nRow 3: ['Matthew Starkey', 'M', '82.9', '205', '130', '227.5', '=ROUND(D3+E3+F3,3)', '=ROUND(IF(B3=\"M\",G3*500/(-1.093e-06*C3^4+0.0007391...']\r\nRow 4: ['Austin Keanu', 'M', '122.4', '275', '142.5', '235', '=ROUND(D4+E4+F4,3)', '=ROUND(IF(B4=\"M\",G4*500/(-1.093e-06*C4^4+0.0007391...']\r\nRow 5: ['Michelle McKeaveney', 'F', '96.8', '102.5', '50', '137.5', '=ROUND(D5+E5+F5,3)', '=ROUND(IF(B5=\"M\",G5*500/(-1.093e-06*C5^4+0.0007391...']\r\nRow 6: ['Tracy Klinger', 'F', '130.82', '62.5', '57.5', '117.5', '=ROUND(D6+E6+F6,3)', '=ROUND(IF(B6=\"M\",G6*500/(-1.093e-06*C6^4+0.0007391...']\r\n"]
