[79.659124, "o", "Row 15: ['Serena Abweh', 'F', '46.1', '82.5', '52.5', '125.5', '=ROUND(D15+E15+F15,3)', '=ROUND(IF(B15=\"M\",G15*500/(-1.093e-06*C15^4+0.0007...']\r\nRow 16: ['Ashleigh Sutton', 'F', '74.2', '170', '85', '197.5', '=ROUND(D16+E16+F16,3)', '=ROUND(IF(B16=\"M\",G16*500/(-1.093e-06*C16^4+0.0007...']\r\nRow 17: ['Aaron Ziffle', 'M', '92.8', '255', '182.5', '245', '=ROUND(D17+E17+F17,3)', '=ROUND(IF(B17=\"M\",G17*500/(-1.093e-06*C17^4+0.0007...']\r\nRow 18: ['Adelaide Hurlbert', 'F', '61.8', '87.5', '57.5', '110', '=ROUND(D18+E18+F18,3)', '=ROUND(IF(B18=\"M\",G18*500/(-1.093e-06*C18^4+0.0007...']\r\nRow 19: ['Coralee Traurig', 'F', '71.1', '107.5', '65', '115', '=ROUND(D19+E19+F19,3)', '=ROUND(IF(B19=\"M\",G19*500/(-1.093e-06*C19^4+0.0007...']\r\nRow 20: ['Hugo Laliberté', 'M', '80.2', '162.5', '102.5', '205', '=ROUND(D20+E20+F20,3)', '=ROUND(IF(B20=\"M\",G20*500/(-1.093e-06*C20^4+0.0007...']\r\nRow 21: ['Curtis Laird', 'M', '108.98', '226.8', '165.56', '242.67', '=ROUND(D21+E21+F21,3)', '=ROUND(IF(B21=\"M\",G21*500/(-1.093e-06*C21^4+0.0007...']\r\n"]
[79.679538, "o", "\u001b[?2004hroot@8ae215b9d2e4:~# "]
[96.568908, "i", "python3 -c \"\n# Verify Dots calculation for Julien Comte (M, 82.25kg, Total=607.5)\nbw = 82.25\ntotal = 215 + 132.5 + 260  # 607.5\n\n# Male coefficients\nA = -0.0000010930\nB = 0.0007391293\nC = -0.1918759221\nD = 24.0900756\nE = -307.75076\n\ndenom = A*bw**4 + B*bw**3 + C*bw**2 + D*bw + E\ndots = total * 500 / denom\nprint(f'Julien Comte (M, 82.25kg):')\nprint(f'  Total: {total}')\nprint(f'  Denominator: {denom}')\nprint(f'  Dots: {dots}')\nprint(f'  Dots (3 decimals): {round(dots, 3)}')\n\n# Verify for Michelle McKeaveney (F, 96.8kg)\nbw = 96.8\ntotal = 102.5 + 50 + 137.5  # 290\n\n# Female coefficients\nA = -0.0000010706\nB = 0.0005158568\nC = -0.1126655495\nD = 13.6175032\nE = -57.96288\n\ndenom = A*bw**4 + B*bw**3 + C*bw**2 + D*bw + E\ndots = total * 500 / denom\nprint(f'\\nMichelle McKeaveney (F, 96.8kg):')\nprint(f'  Total: {total}')\nprint(f'  Denominator: {denom}')\nprint(f'  Dots: {dots}')\nprint(f'  Dots (3 decimals): {round(dots, 3)}')\n\"\n"]
[96.569134, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.569257, "o", "# Verify Dots calculation for Julien Comte (M, 82.25kg, Total=607.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.569287, "o", "bw = 82.25\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.569394, "o", "> "]
[96.569438, "o", "total = 215 + 132.5 + 260  # 607.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
