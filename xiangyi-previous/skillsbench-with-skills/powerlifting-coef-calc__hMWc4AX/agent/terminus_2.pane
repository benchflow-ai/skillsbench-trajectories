[?2004hroot@8ae215b9d2e4:~# cat > /tmp/process_dots.py << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> # Load workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> data_sheet = wb['Data']
[?2004l[?2004h> dots_sheet = wb['Dots']
[?2004l[?2004h> 
[?2004l[?2004h> # Clear Dots sheet if it has any data
[?2004l[?2004h> for row in dots_sheet.iter_rows():
[?2004l[?2004h>     for cell in row:
[?2004l[?2004h>         cell.value = None
[?2004l[?2004h> 
[?2004l[?2004h> # Column mapping from Data sheet (1-indexed)
[?2004l[?2004h> # Need: Name(1), Sex(2), BodyweightKg(9), Best3SquatKg(11), Best3BenchKg(12), Best3DeadliftKg(13)
[?2004l[?2004h> # Keep same order as in Data sheet
[?2004l[?2004h> columns_to_copy = [
[?2004l[?2004h>     (1, 'Name'),
[?2004l[?2004h>     (2, 'Sex'),
[?2004l[?2004h>     (9, 'BodyweightKg'),
[?2004l[?2004h>     (11, 'Best3SquatKg'),
[?2004l[?2004h>     (12, 'Best3BenchKg'),
[?2004l[?2004h>     (13, 'Best3DeadliftKg')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Copy data from Data sheet to Dots sheet
[?2004l[?2004h> max_row = data_sheet.max_row
[?2004l[?2004h> for row in range(1, max_row + 1):
[?2004l[?2004h>     for col_idx, (src_col, col_name) in enumerate(columns_to_copy, 1):
[?2004l[?2004h>         dots_sheet.cell(row, col_idx).value = data_sheet.cell(row, src_col).value
[?2004l[?2004h> 
[?2004l[?2004h> # Add TotalKg header (column 7)
[?2004l[?2004h> dots_sheet.cell(1, 7).value = 'TotalKg'
[?2004l[?2004h> 
[?2004l[?2004h> # Add TotalKg formula for each data row
[?2004l[?2004h> # TotalKg = Best3SquatKg + Best3BenchKg + Best3DeadliftKg (columns D, E, F in Dots sheet)
[?2004l[?2004h> for row in range(2, max_row + 1):
[?2004l[?2004h>     # Formula: =ROUND(D{row}+E{row}+F{row}, 3)
[?2004l[?2004h>     dots_sheet.cell(row, 7).value = f'=ROUND(D{row}+E{row}+F{row},3)'
[?2004l[?2004h> 
[?2004l[?2004h> # Add Dots header (column 8)
[?2004l[?2004h> dots_sheet.cell(1, 8).value = 'Dots'
[?2004l[?2004h> 
[?2004l[?2004h> # Dots formula coefficients
[?2004l[?2004h> # Male: A=-0.0000010930, B=0.0007391293, C=-0.1918759221, D=24.0900756, E=-307.75076
[?2004l[?2004h> # Female: A=-0.0000010706, B=0.0005158568, C=-0.1126655495, D=13.6175032, E=-57.96288
[?2004l[?2004h> # Dots = Total * 500 / (A*bw^4 + B*bw^3 + C*bw^2 + D*bw + E)
[?2004l[?2004h> 
[?2004l[?2004h> # In Dots sheet: Sex is column B, BodyweightKg is column C, TotalKg is column G
[?2004l[?2004h> for row in range(2, max_row + 1):
[?2004l[?2004h>     # Create formula with IF to check sex
[?2004l[?2004h>     # Male coefficients
[?2004l[?2004h>     male_a = -0.0000010930
[?2004l[?2004h>     male_b = 0.0007391293
[?2004l[?2004h>     male_c = -0.1918759221
[?2004l[?2004h>     male_d = 24.0900756
[?2004l[?2004h>     male_e = -307.75076
[?2004l[?2004h>     
[?2004l[?2004h>     # Female coefficients
[?2004l[?2004h>     female_a = -0.0000010706
[?2004l[?2004h>     female_b = 0.0005158568
[?2004l[?2004h>     female_c = -0.1126655495
[?2004l[?2004h>     female_d = 13.6175032
[?2004l[?2004h>     female_e = -57.96288
[?2004l[?2004h>     
[?2004l[?2004h>     # Build the formula
[?2004l[?2004h>     # Dots = ROUND(G{row} * 500 / (A*C{row}^4 + B*C{row}^3 + C*C{row}^2 + D*C{row} + E), 3)
[?2004l[?2004h>     male_denom = f'({male_a}*C{row}^4+{male_b}*C{row}^3+{male_c}*C{row}^2+{male_d}*C{row}+{male_e})'
[?2004l[?2004h>     female_denom = f'({female_a}*C{row}^4+{female_b}*C{row}^3+{female_c}*C{row}^2+{female_d}*C{row}+{female_e})'
[?2004l[?2004h>     
[?2004l[?2004h>     formula = f'=ROUND(IF(B{row}="M",G{row}*500/{male_denom},G{row}*500/{female_denom}),3)'
[?2004l[?2004h>     dots_sheet.cell(row, 8).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # Save workbook
[?2004l[?2004h> wb.save('/root/data/openipf.xlsx')
[?2004l[?2004h> print('Done! Dots sheet updated successfully.')
[?2004l[?2004h> 
[?2004l[?2004h> # Verify the result
[?2004l[?2004h> wb2 = openpyxl.load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> dots = wb2['Dots']
[?2004l[?2004h> print('\nDots sheet headers:')
[?2004l[?2004h> for col in range(1, 9):
[?2004l[?2004h>     print(f'  Column {col}: {dots.cell(1, col).value}')
[?2004l[?2004h> print('\nFirst few rows (formulas):')
[?2004l[?2004h> for row in range(2, min(5, max_row + 1)):
[?2004l[?2004h>     print(f'Row {row}:')
[?2004l[?2004h>     for col in range(1, 9):
[?2004l[?2004h>         print(f'  {dots.cell(1, col).value}: {dots.cell(row, col).value}')
[?2004l[?2004h> EOF
