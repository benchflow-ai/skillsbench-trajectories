[42.028934, "o", ">     with open('map_data.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.029015, "o", "        map_data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
