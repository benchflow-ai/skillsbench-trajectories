[42.031382, "o", "> "]
[42.031426, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.031473, "o", "> "]
[42.031503, "o", "            # City Center at (x, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
