[92.524759, "o", "> "]
[92.52516, "o", "            nearby = [p for p in map_data['plots'] if get_dist(cc_plot, p, width, height) <= 3 and (p['x'], p['y']) != city_center and 'MOUNTAIN' not in p['terrain'] and 'OCEAN' not in p['terrain'] and 'COAST' not in p['terrain'] and p.get('feature') != 'FEATURE_ICE']\r\n\u001b[?2004l\r\u001b[?2004h> "]
