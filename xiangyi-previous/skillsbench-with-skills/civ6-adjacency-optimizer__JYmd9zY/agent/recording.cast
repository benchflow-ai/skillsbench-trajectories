[42.032576, "o", "            for dx in range(-3, 4):\r\n\u001b[?2004l\r\u001b[?2004h>                 for dy in range(-3, 4):\r\n\u001b[?2004l\r\u001b[?2004h>                     nx, ny = (x + dx) % width, y + dy\r\n\u001b[?2004l\r\u001b[?2004h>                     if 0 <= ny < height:\r\n\u001b[?2004l\r\u001b[?2004h>                         if get_dist(p, plots[(nx, ny)], width) <= 3:\r\n\u001b[?2004l\r\u001b[?2004h>                             potential_plots.append(plots[(nx, ny)])\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Try some combinations or heuristics\r\n\u001b[?2004l\r\u001b[?2004h>             # For now, just find the best Campus, then best IZ, then best CH\r\n\u001b[?2004l\r\u001b[?2004h> "]
