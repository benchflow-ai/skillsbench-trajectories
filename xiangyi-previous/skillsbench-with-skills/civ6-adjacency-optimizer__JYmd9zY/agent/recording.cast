[25.135864, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[29.420926, "i", "cat << 'EOF' > extract_map.py\nimport sqlite3\nimport json\n\ndef get_map_data(db_path):\n    conn = sqlite3.connect(db_path)\n    cursor = conn.cursor()\n    \n    cursor.execute(\"SELECT Width, Height FROM Map\")\n    width, height = cursor.fetchone()\n    \n    plots = {}\n    cursor.execute(\"SELECT ID, TerrainType FROM Plots\")\n    for row in cursor.fetchall():\n        plots[row[0]] = {\"id\": row[0], \"terrain\": row[1], \"x\": row[0] % width, \"y\": row[0] // width}\n    \n    cursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures\")\n    for row in cursor.fetchall():\n        plots[row[0]][\"feature\"] = row[1]\n    \n    cursor.execute(\"SELECT ID, ResourceType FROM PlotResources\")\n    for row in cursor.fetchall():\n        plots[row[0]][\"resource\"] = row[1]\n\n    cursor.execute(\"SELECT ID, IsNEOfRiver, IsWOfRiver, IsNWOfRiver FROM PlotRivers\")\n    for row in cursor.fetchall():\n        plots[row[0]][\"river\"] = {\"NE\": row[1], \"W\": row[2], \"NW\": row[3]}\n\n    return {\"width\": width, \"height\": height, \"plots\": list(plots.values())}\n\ndata = get_map_data('/data/maps/e2e_test_case_0.Civ6Map')\nprint(json.dumps(data))\nEOF\n"]
[29.421293, "o", "cat << 'EOF' > extract_map.py\r\n\u001b[?2004l\r"]
