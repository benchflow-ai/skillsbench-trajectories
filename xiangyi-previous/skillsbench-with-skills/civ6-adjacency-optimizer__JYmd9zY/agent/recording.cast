[57.626142, "o", "    def calc_commercial_hub(p, placements):\r\n\u001b[?2004l\r"]
[57.626208, "o", "\u001b[?2004h> "]
[57.626268, "o", "        bonus = 0\r\n\u001b[?2004l\r"]
[57.626319, "o", "\u001b[?2004h> "]
[57.626428, "o", "        neighbors = get_neighbors(p['x'], p['y'])\r\n\u001b[?2004l\r"]
[57.626454, "o", "\u001b[?2004h> "]
[57.626658, "o", "        # River adjacency: a bit tricky, need to check edges\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.626716, "o", "> "]
[57.62698, "o", "        # For simplicity, if any neighbor has a river edge or the plot itself has a river edge\r\n\u001b[?2004l\r"]
[57.627042, "o", "\u001b[?2004h> "]
[57.627289, "o", "        if p.get('river') and (p['river']['NE'] or p['river']['W'] or p['river']['NW']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.627313, "o", "> "]
[57.627499, "o", "             bonus += 2\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.627601, "o", "            for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.627929, "o", "                if n.get('river') and (n['river']['NE'] or n['river']['W'] or n['river']['NW']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.627988, "o", "> "]
[57.628053, "o", "                    bonus += 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.628119, "o", "> "]
[57.628193, "o", "                    break\r\n\u001b[?2004l\r"]
[57.628238, "o", "\u001b[?2004h> "]
[57.628373, "o", "        # Royal Dock / Harbor? No, generic civilization.\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.628439, "o", "> "]
[57.628509, "o", "        # District adjacency\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.628602, "o", "        districts = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.628709, "o", "        for n in neighbors:\r\n\u001b[?2004l\r"]
[57.628768, "o", "\u001b[?2004h> "]
[57.628897, "o", "            if (n['x'], n['y']) in placements:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.628959, "o", "> "]
[57.62902, "o", "                districts += 1\r\n\u001b[?2004l\r"]
[57.629049, "o", "\u001b[?2004h> "]
[57.629149, "o", "        bonus += districts // 2\r\n\u001b[?2004l\r"]
[57.629211, "o", "\u001b[?2004h> "]
[57.629269, "o", "        return int(bonus)\r\n\u001b[?2004l\r"]
[57.629304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.629472, "o", "    def calc_industrial_zone(p, placements):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.629552, "o", "        bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.629617, "o", "> "]
[57.629735, "o", "        neighbors = get_neighbors(p['x'], p['y'])\r\n\u001b[?2004l\r"]
[57.629796, "o", "\u001b[?2004h> "]
[57.629855, "o", "        for n in neighbors:\r\n\u001b[?2004l\r"]
[57.629901, "o", "\u001b[?2004h> "]
[57.630335, "o", "            if 'QUARRY' in n.get('resource', '') or 'MINE' in n.get('resource', ''): # This is wrong, resources are like RESOURCE_IRON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.630421, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.630742, "o", "            # Actually, mines are improvements, not resources. Let's check resources that give bonuses to IZ\r\n\u001b[?2004l\r"]
[57.630772, "o", "\u001b[?2004h> "]
[57.631053, "o", "            if n.get('resource') in ['RESOURCE_IRON', 'RESOURCE_COAL', 'RESOURCE_STRATEGIC_COAL']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.631078, "o", "> "]
[57.631172, "o", "                pass # Still improvements. \r\n\u001b[?2004l\r"]
[57.631202, "o", "\u001b[?2004h> "]
[57.631423, "o", "            # In Civ 6: +1 per 2 districts, +1 per Quarry, +1 per 2 Mines/Lumber Mills.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63153, "o", "            # +2 per Aqueduct, Dam, Canal, Bath.\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.631559, "o", "> "]
[57.631726, "o", "            # Since we don't have improvements, we only count districts.\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.631779, "o", "> "]
[57.63183, "o", "        districts = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.631886, "o", "        for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.631937, "o", "            if (n['x'], n['y']) in placements:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63199, "o", "                districts += 1\r\n\u001b[?2004l\r"]
[57.632037, "o", "\u001b[?2004h> "]
[57.632093, "o", "        bonus += districts // 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632146, "o", "        return int(bonus)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632209, "o", "    # Simplified: look for best Campus spots\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.632266, "o", "> "]
[57.632331, "o", "    campus_spots = []\r\n\u001b[?2004l\r\u001b[?2004h>     for p in map_data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.632383, "o", "> "]
[57.632536, "o", "        if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632586, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63264, "o", "        bonus = calc_campus(p, {})\r\n\u001b[?2004l\r"]
[57.632688, "o", "\u001b[?2004h> "]
[57.632738, "o", "        if bonus >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632781, "o", "            campus_spots.append((p, bonus))\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.632836, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632912, "o", "    campus_spots.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.632962, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.633035, "o", "    # Let's try the top campus spot and build around it\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.633087, "o", ">     if campus_spots:\r\n\u001b[?2004l\r"]
[57.633133, "o", "\u001b[?2004h> "]
[57.633184, "o", "        best_c, c_bonus = campus_spots[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.633256, "o", "        # Find a city center within 3 tiles\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.633308, "o", "> "]
[57.633358, "o", "        for p in map_data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.633532, "o", "            if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.633555, "o", "> "]
[57.63368, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.633753, "o", "            if get_dist(p, best_c, width, height) <= 3 and get_dist(p, best_c, width, height) > 0:\r\n\u001b[?2004l\r"]
[57.633804, "o", "\u001b[?2004h> "]
[57.63385, "o", "                # City center at p, Campus at best_c\r\n\u001b[?2004l\r"]
[57.6339, "o", "\u001b[?2004h> "]
[57.634015, "o", "                placements = {(p['x'], p['y']): 'CITY_CENTER', (best_c['x'], best_c['y']): 'CAMPUS'}\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.634064, "o", "> "]
[57.63412, "o", "                # Find a third district - Commercial Hub\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.634174, "o", "> "]
[57.634227, "o", "                best_ch = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.634287, "o", "                best_ch_bonus = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.634339, "o", "                for p2 in map_data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.634386, "o", "> "]
[57.634498, "o", "                    if get_dist(p, p2, width, height) <= 3 and (p2['x'], p2['y']) not in placements:\r\n\u001b[?2004l\r"]
[57.634547, "o", "\u001b[?2004h> "]
[57.63474, "o", "                        if 'MOUNTAIN' in p2['terrain'] or 'OCEAN' in p2['terrain'] or 'COAST' in p2['terrain'] or p2.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.634787, "o", "> "]
[57.634839, "o", "                            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.634942, "o", "                        ch_bonus = calc_commercial_hub(p2, placements)\r\n\u001b[?2004l\r"]
[57.634991, "o", "\u001b[?2004h> "]
[57.63504, "o", "                        if ch_bonus > best_ch_bonus:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.635089, "o", "> "]
[57.635137, "o", "                            best_ch_bonus = ch_bonus\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.63519, "o", "> "]
[57.635243, "o", "                            best_ch = p2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.635297, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.635349, "o", "                if best_ch:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63546, "o", "                    placements[(best_ch['x'], best_ch['y'])] = 'COMMERCIAL_HUB'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.635568, "o", "                    # Find a fourth district - Industrial Zone\r\n\u001b[?2004l\r"]
[57.635622, "o", "\u001b[?2004h> "]
[57.635673, "o", "                    best_iz = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.635724, "o", "                    best_iz_bonus = -1\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.635775, "o", "> "]
[57.635827, "o", "                    for p3 in map_data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63598, "o", "                         if get_dist(p, p3, width, height) <= 3 and (p3['x'], p3['y']) not in placements:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.636212, "o", "                            if 'MOUNTAIN' in p3['terrain'] or 'OCEAN' in p3['terrain'] or 'COAST' in p3['terrain'] or p3.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636256, "o", "> "]
[57.636314, "o", "                                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636363, "o", "> "]
[57.63642, "o", "                            iz_bonus = calc_industrial_zone(p3, placements)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636466, "o", "> "]
[57.636521, "o", "                            if iz_bonus > best_iz_bonus:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636567, "o", "> "]
[57.636623, "o", "                                best_iz_bonus = iz_bonus\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636677, "o", "> "]
[57.636722, "o", "                                best_iz = p3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.636774, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.636819, "o", "                    if best_iz:\r\n\u001b[?2004l\r"]
[57.636865, "o", "\u001b[?2004h> "]
[57.636934, "o", "                        # Recalculate all with current placements\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.636981, "o", "> "]
[57.637076, "o", "                        placements[(best_iz['x'], best_iz['y'])] = 'INDUSTRIAL_ZONE'\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.637133, "o", "> "]
[57.637194, "o", "                        c_bonus = calc_campus(best_c, placements)\r\n\u001b[?2004l\r"]
[57.63726, "o", "\u001b[?2004h> "]
[57.63732, "o", "                        ch_bonus = calc_commercial_hub(best_ch, placements)\r\n\u001b[?2004l\r"]
[57.637368, "o", "\u001b[?2004h> "]
[57.637453, "o", "                        iz_bonus = calc_industrial_zone(best_iz, placements)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.6376, "o", "                        total = c_bonus + ch_bonus + iz_bonus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.637665, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.63772, "o", "                        result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.637796, "o", "                            \"city_center\": [p['x'], p['y']],\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.637851, "o", "> "]
[57.637904, "o", "                            \"placements\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.637994, "o", "                                \"CAMPUS\": [best_c['x'], best_c['y']],\r\n\u001b[?2004l\r"]
[57.638044, "o", "\u001b[?2004h> "]
[57.63813, "o", "                                \"COMMERCIAL_HUB\": [best_ch['x'], best_ch['y']],\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.638179, "o", "> "]
[57.638266, "o", "                                \"INDUSTRIAL_ZONE\": [best_iz['x'], best_iz['y']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.638324, "o", "                            },\r\n\u001b[?2004l\r"]
[57.638377, "o", "\u001b[?2004h> "]
[57.638421, "o", "                            \"adjacency_bonuses\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.638471, "o", "> "]
[57.638528, "o", "                                \"CAMPUS\": c_bonus,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.638612, "o", "                                \"COMMERCIAL_HUB\": ch_bonus,\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.638668, "o", "> "]
[57.638721, "o", "                                \"INDUSTRIAL_ZONE\": iz_bonus\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.638775, "o", "> "]
[57.638828, "o", "                            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.638879, "o", "                            \"total_adjacency\": total\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.638955, "o", "> "]
[57.639009, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.639055, "o", "                        print(json.dumps(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.639099, "o", "                        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[57.639125, "o", "\u001b[?2004h> solve()\r\n\u001b[?2004l\r"]
[57.639193, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[57.640491, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[58.733836, "i", "python3 optimize.py\n"]
[58.734103, "o", "python3 optimize.py\r\n\u001b[?2004l\r"]
[58.75559, "o", "{\"city_center\": [23, 11], \"placements\": {\"CAMPUS\": [21, 14], \"COMMERCIAL_HUB\": [21, 13], \"INDUSTRIAL_ZONE\": [22, 13]}, \"adjacency_bonuses\": {\"CAMPUS\": 4, \"COMMERCIAL_HUB\": 3, \"INDUSTRIAL_ZONE\": 1}, \"total_adjacency\": 8}\r\n"]
[58.758715, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[65.954878, "i", "cat << 'EOF' > verify.py\nimport json\n\nwith open('map_data.json') as f:\n    map_data = json.load(f)\n\nwidth = map_data['width']\nheight = map_data['height']\nplots = { (p['x'], p['y']): p for p in map_data['plots'] }\n\ndef get_dist(p1, p2):\n    x1, y1 = p1['x'], p1['y']\n    x2, y2 = p2['x'], p2['y']\n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n    q1, r1, s1 = to_cube(x1, y1)\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\ndef get_neighbors(x, y):\n    neighbors = []\n    if y % 2 == 0:\n        coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n    else:\n        coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n    for nx, ny in coords:\n        if 0 <= ny < height:\n            neighbors.append(plots[(nx % width, ny)])\n    return neighbors\n\ncc = [23, 11]\ndistricts = {\"CAMPUS\": [21, 14], \"COMMERCIAL_HUB\": [21, 13], \"INDUSTRIAL_ZONE\": [22, 13]}\n\nfor name, coord in districts.items():\n    d = get_dist(plots[tuple(cc)], plots[tuple(coord)])\n    print(f\"{name} distance from CC: {d}\")\n    p = plots[tuple(coord)]\n    print(f\"{name} terrain: {p['terrain']}, feature: {p.get('feature')}, resource: {p.get('resource')}\")\n    neighbors = get_neighbors(coord[0], coord[1])\n    print(f\"{name} neighbors:\")\n    for n in neighbors:\n        print(f\"  ({n['x']}, {n['y']}): {n['terrain']}, {n.get('feature')}, {n.get('resource')}, {'DISTRICT' if [n['x'], n['y']] in districts.values() or [n['x'], n['y']] == cc else ''}\")\n\nEOF\npython3 verify.py\n"]
[65.955227, "o", "cat << 'EOF' > verify.py\r\n\u001b[?2004l\r"]
[65.955283, "o", "\u001b[?2004h> "]
[65.95544, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.955592, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> with open('map_data.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.955684, "o", "    map_data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.955762, "o", "width = map_data['width']\r\n\u001b[?2004l\r"]
[65.95582, "o", "\u001b[?2004h> "]
[65.955878, "o", "height = map_data['height']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.956087, "o", "plots = { (p['x'], p['y']): p for p in map_data['plots'] }\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.956159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.95622, "o", "def get_dist(p1, p2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.956323, "o", "    x1, y1 = p1['x'], p1['y']\r\n\u001b[?2004l\r"]
[65.956399, "o", "\u001b[?2004h> "]
[65.956456, "o", "    x2, y2 = p2['x'], p2['y']\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.956524, "o", "> "]
[65.956599, "o", "    def to_cube(x, y):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.956696, "o", "        q = x - (y + (y & 1)) // 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
