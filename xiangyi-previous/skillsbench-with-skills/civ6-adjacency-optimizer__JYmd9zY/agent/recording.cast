[42.028105, "o", "    # x_h = x - (y + (y&1)) / 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.02818, "o", ">     # z_h = y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028263, "o", "    # y_h = -x_h - z_h\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028379, "o", "    def to_cube(x, y):\r\n\u001b[?2004l\r\u001b[?2004h>         q = x - (y + (y & 1)) // 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.028462, "o", ">         r = y\r\n\u001b[?2004l\r\u001b[?2004h>         s = -q - r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028549, "o", "        return q, r, s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028632, "o", "    q1, r1, s1 = to_cube(x1, y1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.02871, "o", "    q2, r2, s2 = to_cube(x2, y2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.028775, "o", "    return (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\r\n\u001b[?2004l\r\u001b[?2004h"]
