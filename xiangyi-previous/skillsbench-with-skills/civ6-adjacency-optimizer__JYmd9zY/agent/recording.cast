[42.034548, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[57.618008, "i", "cat << 'EOF' > optimize.py\nimport json\n\ndef get_dist(p1, p2, width, height):\n    x1, y1 = p1['x'], p1['y']\n    x2, y2 = p2['x'], p2['y']\n    dx = abs(x2 - x1)\n    if dx > width / 2: dx = width - dx\n    \n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n\n    q1, r1, s1 = to_cube(x1, y1)\n    # For the wrapped x, we need to check multiple versions of x2\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\ndef solve():\n    with open('map_data.json') as f:\n        map_data = json.load(f)\n    \n    width = map_data['width']\n    height = map_data['height']\n    plots = { (p['x'], p['y']): p for p in map_data['plots'] }\n    \n    def get_neighbors(x, y):\n        neighbors = []\n        if y % 2 == 0:\n            coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n        else:\n            coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n        for nx, ny in coords:\n            if 0 <= ny < height:\n                neighbors.append(plots[(nx % width, ny)])\n        return neighbors\n\n    def calc_campus(p, placements):\n        bonus = 0\n        neighbors = get_neighbors(p['x'], p['y'])\n        for n in neighbors:\n            if 'MOUNTAIN' in n['terrain']:\n                bonus += 1\n            if n.get('feature') == 'FEATURE_REEF':\n                bonus += 2\n            if n.get('feature') == 'FEATURE_JUNGLE':\n                bonus += 0.5\n        # District adjacency\n        districts = 0\n        for n in neighbors:\n            if (n['x'], n['y']) in placements:\n                districts += 1\n        bonus += districts // 2\n        return int(bonus)\n\n    def calc_commercial_hub(p, placements):\n        bonus = 0\n        neighbors = get_neighbors(p['x'], p['y'])\n        # River adjacency: a bit tricky, need to check edges\n        # For simplicity, if any neighbor has a river edge or the plot itself has a river edge\n        if p.get('river') and (p['river']['NE'] or p['river']['W'] or p['river']['NW']):\n             bonus += 2\n        else:\n            for n in neighbors:\n                if n.get('river') and (n['river']['NE'] or n['river']['W'] or n['river']['NW']):\n                    bonus += 2\n                    break\n        # Royal Dock / Harbor? No, generic civilization.\n        # District adjacency\n        districts = 0\n        for n in neighbors:\n            if (n['x'], n['y']) in placements:\n                districts += 1\n        bonus += districts // 2\n        return int(bonus)\n\n    def calc_industrial_zone(p, placements):\n        bonus = 0\n        neighbors = get_neighbors(p['x'], p['y'])\n        for n in neighbors:\n            if 'QUARRY' in n.get('resource', '') or 'MINE' in n.get('resource', ''): # This is wrong, resources are like RESOURCE_IRON\n                pass\n            # Actually, mines are improvements, not resources. Let's check resources that give bonuses to IZ\n            if n.get('resource') in ['RESOURCE_IRON', 'RESOURCE_COAL', 'RESOURCE_STRATEGIC_COAL']:\n                pass # Still improvements. \n            # In Civ 6: +1 per 2 districts, +1 per Quarry, +1 per 2 Mines/Lumber Mills.\n            # +2 per Aqueduct, Dam, Canal, Bath.\n            # Since we don't have improvements, we only count districts.\n        districts = 0\n        for n in neighbors:\n            if (n['x'], n['y']) in placements:\n                districts += 1\n        bonus += districts // 2\n        return int(bonus)\n\n    # Simplified: look for best Campus spots\n    campus_spots = []\n    for p in map_data['plots']:\n        if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\n            continue\n        bonus = calc_campus(p, {})\n        if bonus >= 3:\n            campus_spots.append((p, bonus))\n    \n    campus_spots.sort(key=lambda x: x[1], reverse=True)\n    \n    # Let's try the "]
[57.618078, "i", "top campus spot and build around it\n    if campus_spots:\n        best_c, c_bonus = campus_spots[0]\n        # Find a city center within 3 tiles\n        for p in map_data['plots']:\n            if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\n                continue\n            if get_dist(p, best_c, width, height) <= 3 and get_dist(p, best_c, width, height) > 0:\n                # City center at p, Campus at best_c\n                placements = {(p['x'], p['y']): 'CITY_CENTER', (best_c['x'], best_c['y']): 'CAMPUS'}\n                # Find a third district - Commercial Hub\n                best_ch = None\n                best_ch_bonus = -1\n                for p2 in map_data['plots']:\n                    if get_dist(p, p2, width, height) <= 3 and (p2['x'], p2['y']) not in placements:\n                        if 'MOUNTAIN' in p2['terrain'] or 'OCEAN' in p2['terrain'] or 'COAST' in p2['terrain'] or p2.get('feature') == 'FEATURE_ICE':\n                            continue\n                        ch_bonus = calc_commercial_hub(p2, placements)\n                        if ch_bonus > best_ch_bonus:\n                            best_ch_bonus = ch_bonus\n                            best_ch = p2\n                \n                if best_ch:\n                    placements[(best_ch['x'], best_ch['y'])] = 'COMMERCIAL_HUB'\n                    # Find a fourth district - Industrial Zone\n                    best_iz = None\n                    best_iz_bonus = -1\n                    for p3 in map_data['plots']:\n                         if get_dist(p, p3, width, height) <= 3 and (p3['x'], p3['y']) not in placements:\n                            if 'MOUNTAIN' in p3['terrain'] or 'OCEAN' in p3['terrain'] or 'COAST' in p3['terrain'] or p3.get('feature') == 'FEATURE_ICE':\n                                continue\n                            iz_bonus = calc_industrial_zone(p3, placements)\n                            if iz_bonus > best_iz_bonus:\n                                best_iz_bonus = iz_bonus\n                                best_iz = p3\n                    \n                    if best_iz:\n                        # Recalculate all with current placements\n                        placements[(best_iz['x'], best_iz['y'])] = 'INDUSTRIAL_ZONE'\n                        c_bonus = calc_campus(best_c, placements)\n                        ch_bonus = calc_commercial_hub(best_ch, placements)\n                        iz_bonus = calc_industrial_zone(best_iz, placements)\n                        total = c_bonus + ch_bonus + iz_bonus\n                        \n                        result = {\n                            \"city_center\": [p['x'], p['y']],\n                            \"placements\": {\n                                \"CAMPUS\": [best_c['x'], best_c['y']],\n                                \"COMMERCIAL_HUB\": [best_ch['x'], best_ch['y']],\n                                \"INDUSTRIAL_ZONE\": [best_iz['x'], best_iz['y']]\n                            },\n                            \"adjacency_bonuses\": {\n                                \"CAMPUS\": c_bonus,\n                                \"COMMERCIAL_HUB\": ch_bonus,\n                                \"INDUSTRIAL_ZONE\": iz_bonus\n                            },\n                            \"total_adjacency\": total\n                        }\n                        print(json.dumps(result))\n                        return\n\nsolve()\nEOF\n"]
