[118.14401, "o", "\u001b[?2004h> "]
[118.144082, "o", "def get_neighbors(x, y):\r\n\u001b[?2004l\r"]
[118.144165, "o", "\u001b[?2004h> "]
[118.144224, "o", "    neighbors = []\r\n\u001b[?2004l\r"]
[118.144288, "o", "\u001b[?2004h> "]
[118.14436, "o", "    if y % 2 == 0:\r\n\u001b[?2004l\r"]
[118.144447, "o", "\u001b[?2004h> "]
[118.14482, "o", "        coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\r\n\u001b[?2004l\r"]
[118.144913, "o", "\u001b[?2004h> "]
[118.144981, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.145374, "o", "        coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\r\n\u001b[?2004l\r"]
[118.145463, "o", "\u001b[?2004h> "]
[118.145542, "o", "    for nx, ny in coords:\r\n\u001b[?2004l\r"]
[118.145568, "o", "\u001b[?2004h> "]
[118.145752, "o", "        if 0 <= ny < height:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.145834, "o", "> "]
[118.146051, "o", "            neighbors.append(plots[(nx % width, ny)])\r\n\u001b[?2004l\r"]
[118.146133, "o", "\u001b[?2004h> "]
[118.14624, "o", "    return neighbors\r\n\u001b[?2004l\r"]
[118.146271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.14653, "o", "def calc_bonus(type, p, placements):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.146742, "o", "    neighbors = get_neighbors(p['x'], p['y'])\r\n\u001b[?2004l\r"]
[118.14683, "o", "\u001b[?2004h> "]
[118.146857, "o", "    bonus = 0\r\n\u001b[?2004l\r"]
[118.14688, "o", "\u001b[?2004h> "]
[118.147055, "o", "    if type == 'CAMPUS':\r\n\u001b[?2004l\r"]
[118.147132, "o", "\u001b[?2004h> "]
[118.14724, "o", "        for n in neighbors:\r\n\u001b[?2004l\r"]
[118.147313, "o", "\u001b[?2004h> "]
[118.14758, "o", "            if 'MOUNTAIN' in n['terrain']: bonus += 1\r\n\u001b[?2004l\r"]
[118.147667, "o", "\u001b[?2004h> "]
[118.147947, "o", "            if n.get('feature') == 'FEATURE_REEF': bonus += 2\r\n\u001b[?2004l\r"]
[118.148035, "o", "\u001b[?2004h> "]
[118.148425, "o", "            if n.get('feature') == 'FEATURE_GEOTHERMAL_FISSURE': bonus += 2\r\n\u001b[?2004l\r"]
[118.148528, "o", "\u001b[?2004h> "]
[118.148721, "o", "            if n.get('feature') == 'FEATURE_JUNGLE': bonus += 0.5\r\n\u001b[?2004l\r"]
[118.148814, "o", "\u001b[?2004h> "]
[118.148877, "o", "    elif type == 'COMMERCIAL_HUB':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.148977, "o", "        has_river = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.14905, "o", "> "]
[118.149249, "o", "        if p.get('river') and (p['river']['NE'] or p['river']['W'] or p['river']['NW']): has_river = True\r\n\u001b[?2004l\r"]
[118.149329, "o", "\u001b[?2004h> "]
[118.149392, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.149459, "o", "            for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.149516, "o", "> "]
[118.14976, "o", "                if n.get('river') and (n['river']['NE'] or n['river']['W'] or n['river']['NW']): \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.149857, "o", "                    has_river = True\r\n\u001b[?2004l\r"]
[118.149937, "o", "\u001b[?2004h> "]
[118.150007, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.150084, "o", "        if has_river: bonus += 2\r\n\u001b[?2004l\r"]
[118.150144, "o", "\u001b[?2004h> "]
[118.150213, "o", "    elif type == 'HOLY_SITE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.150279, "o", "        for n in neighbors:\r\n\u001b[?2004l\r"]
[118.150344, "o", "\u001b[?2004h> "]
[118.15048, "o", "            if 'MOUNTAIN' in n['terrain']: bonus += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.150678, "o", "            if n.get('feature') == 'FEATURE_FOREST': bonus += 0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.15076, "o", "> "]
[118.150805, "o", "    elif type == 'THEATER_SQUARE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.151049, "o", "        # Wonders and Entertainment complexes give bonuses, but we don't have them\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.151122, "o", ">         pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.151222, "o", "    elif type == 'INDUSTRIAL_ZONE':\r\n\u001b[?2004l\r"]
[118.151283, "o", "\u001b[?2004h> "]
[118.151359, "o", "        # We only count districts for now\r\n\u001b[?2004l\r"]
[118.151415, "o", "\u001b[?2004h> "]
[118.151477, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.151513, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.151703, "o", "    districts = sum(1 for n in neighbors if (n['x'], n['y']) in placements)\r\n\u001b[?2004l\r"]
[118.151764, "o", "\u001b[?2004h> "]
[118.151827, "o", "    bonus += districts // 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.151886, "o", "> "]
[118.151943, "o", "    return int(bonus)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.151994, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.152052, "o", "best_total = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.152109, "o", "best_res = {}\r\n\u001b[?2004l\r"]
[118.152165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.152222, "o", "# Specialty districts\r\n\u001b[?2004l\r"]
[118.152282, "o", "\u001b[?2004h> "]
[118.152454, "o", "types = ['CAMPUS', 'COMMERCIAL_HUB', 'INDUSTRIAL_ZONE', 'HOLY_SITE', 'THEATER_SQUARE']\r\n\u001b[?2004l\r"]
[118.152511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.152574, "o", "\u001b[?2004h> "]
[118.152743, "o", "# Focus on the best potential spots for each district type to narrow down the search\r\n\u001b[?2004l\r"]
[118.152768, "o", "\u001b[?2004h> "]
[118.152792, "o", "spots = {}\r\n\u001b[?2004l\r"]
[118.152815, "o", "\u001b[?2004h"]
[118.152837, "o", "> "]
[118.152875, "o", "for t in types:\r\n\u001b[?2004l\r"]
[118.152896, "o", "\u001b[?2004h> "]
[118.153004, "o", "    spots[t] = []\r\n\u001b[?2004l\r"]
[118.153032, "o", "\u001b[?2004h> "]
[118.153224, "o", "    for p in map_data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.153478, "o", "        if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.15356, "o", ">             continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.153623, "o", "> "]
[118.153684, "o", "        b = calc_bonus(t, p, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.15387, "o", "        if b > 0 or t in ['INDUSTRIAL_ZONE', 'THEATER_SQUARE']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.153932, "o", "> "]
[118.154, "o", "            spots[t].append((p, b))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.154059, "o", "> "]
[118.15415, "o", "    spots[t].sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[118.154216, "o", "\u001b[?2004h> "]
[118.15428, "o", "    spots[t] = spots[t][:10]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.154335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.154554, "o", "# Try all combinations of 3 types from types\r\n\u001b[?2004l\r\u001b[?2004h> import itertools\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.154626, "o", "for city_x in range(width):\r\n\u001b[?2004l\r"]
[118.154682, "o", "\u001b[?2004h> "]
[118.154753, "o", "    for city_y in range(height):\r\n\u001b[?2004l\r"]
[118.154808, "o", "\u001b[?2004h> "]
[118.1549, "o", "        cc_plot = plots[(city_x, city_y)]\r\n\u001b[?2004l\r"]
[118.154957, "o", "\u001b[?2004h> "]
[118.155338, "o", "        if 'MOUNTAIN' in cc_plot['terrain'] or 'OCEAN' in cc_plot['terrain'] or 'COAST' in cc_plot['terrain'] or cc_plot.get('feature') == 'FEATURE_ICE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.155379, "o", "> "]
[118.155475, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[118.155537, "o", "\u001b[?2004h> "]
[118.155604, "o", "        city_center = (city_x, city_y)\r\n\u001b[?2004l\r"]
[118.15567, "o", "\u001b[?2004h> "]
[118.156287, "o", "        nearby = [p for p in map_data['plots'] if get_dist(cc_plot, p, width, height) <= 3 and (p['x'], p['y']) != city_center and 'MOUNTAIN' not in p['terrain'] and 'OCEAN' not in p['terrain'] and 'COAST' not in p['terrain'] and p.get('feature') != 'FEATURE_ICE']\r\n\u001b[?2004l\r"]
[118.15631, "o", "\u001b[?2004h> "]
[118.156364, "o", "        \r\n\u001b[?2004l\r"]
[118.156393, "o", "\u001b[?2004h> "]
[118.156535, "o", "        for combo in itertools.combinations(types, 3):\r\n\u001b[?2004l\r"]
[118.156557, "o", "\u001b[?2004h> "]
[118.156779, "o", "            # For each type in combo, pick best 3 spots from nearby\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.157008, "o", "            # This is still a bit slow, let's just pick the best spots for each type from nearby\r\n\u001b[?2004l\r"]
[118.157068, "o", "\u001b[?2004h> "]
[118.157131, "o", "            type_spots = []\r\n\u001b[?2004l\r"]
[118.157194, "o", "\u001b[?2004h> "]
[118.15726, "o", "            for t in combo:\r\n\u001b[?2004l\r"]
[118.157318, "o", "\u001b[?2004h> "]
[118.15756, "o", "                ts = sorted(nearby, key=lambda p: calc_bonus(t, p, {city_center: 'CITY_CENTER'}), reverse=True)[:3]\r\n\u001b[?2004l\r"]
[118.157585, "o", "\u001b[?2004h> "]
[118.157729, "o", "                type_spots.append([(t, p) for p in ts])\r\n\u001b[?2004l\r"]
[118.157753, "o", "\u001b[?2004h> "]
[118.15783, "o", "            \r\n\u001b[?2004l\r"]
[118.157912, "o", "\u001b[?2004h> "]
[118.158002, "o", "            for d1, d2, d3 in itertools.product(*type_spots):\r\n\u001b[?2004l\r"]
[118.158054, "o", "\u001b[?2004h> "]
[118.158297, "o", "                if d1[1]['id'] == d2[1]['id'] or d1[1]['id'] == d3[1]['id'] or d2[1]['id'] == d3[1]['id']:\r\n\u001b[?2004l\r"]
[118.158326, "o", "\u001b[?2004h> "]
[118.158417, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.158438, "o", "> "]
[118.158596, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.158936, "o", "                placements = {city_center: 'CITY_CENTER', (d1[1]['x'], d1[1]['y']): d1[0], (d2[1]['x'], d2[1]['y']): d2[0], (d3[1]['x'], d3[1]['y']): d3[0]}\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.159022, "o", "> "]
[118.15911, "o", "                b1 = calc_bonus(d1[0], d1[1], placements)\r\n\u001b[?2004l\r"]
[118.159136, "o", "\u001b[?2004h> "]
[118.159301, "o", "                b2 = calc_bonus(d2[0], d2[1], placements)\r\n\u001b[?2004l\r"]
[118.159326, "o", "\u001b[?2004h> "]
[118.159486, "o", "                b3 = calc_bonus(d3[0], d3[1], placements)\r\n\u001b[?2004l\r"]
[118.159563, "o", "\u001b[?2004h> "]
[118.159621, "o", "                total = b1 + b2 + b3\r\n\u001b[?2004l\r"]
[118.159679, "o", "\u001b[?2004h> "]
[118.159736, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.159811, "o", "                if total > best_total:\r\n\u001b[?2004l\r"]
[118.159866, "o", "\u001b[?2004h> "]
[118.159945, "o", "                    best_total = total\r\n\u001b[?2004l\r"]
[118.159997, "o", "\u001b[?2004h> "]
[118.160075, "o", "                    best_res = {\r\n\u001b[?2004l\r"]
[118.160124, "o", "\u001b[?2004h> "]
[118.160238, "o", "                        \"city_center\": [city_x, city_y],\r\n\u001b[?2004l\r"]
[118.160298, "o", "\u001b[?2004h> "]
[118.160382, "o", "                        \"placements\": {\r\n\u001b[?2004l\r"]
[118.160458, "o", "\u001b[?2004h> "]
[118.160572, "o", "                            d1[0]: [d1[1]['x'], d1[1]['y']],\r\n\u001b[?2004l\r"]
[118.160646, "o", "\u001b[?2004h> "]
[118.160827, "o", "                            d2[0]: [d2[1]['x'], d2[1]['y']],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.160945, "o", "                            d3[0]: [d3[1]['x'], d3[1]['y']]\r\n\u001b[?2004l\r"]
[118.160979, "o", "\u001b[?2004h> "]
[118.161108, "o", "                        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.161198, "o", "                        \"adjacency_bonuses\": {\r\n\u001b[?2004l\r"]
[118.161264, "o", "\u001b[?2004h> "]
[118.161337, "o", "                            d1[0]: b1,\r\n\u001b[?2004l\r"]
[118.16142, "o", "\u001b[?2004h> "]
[118.1615, "o", "                            d2[0]: b2,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.161548, "o", "> "]
[118.16162, "o", "                            d3[0]: b3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.161681, "o", "                        },\r\n\u001b[?2004l\r"]
[118.161759, "o", "\u001b[?2004h> "]
[118.161978, "o", "                        \"total_adjacency\": total\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.16206, "o", "print(json.dumps(best_res))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.162139, "o", "EOF\r\n\u001b[?2004l\r"]
[118.195824, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[118.197055, "o", "python3 optimize.py\r\n\u001b[?2004l\r"]
[118.441636, "o", "{\"city_center\": [21, 13], \"placements\": {\"CAMPUS\": [21, 14], \"COMMERCIAL_HUB\": [22, 13], \"HOLY_SITE\": [22, 12]}, \"adjacency_bonuses\": {\"CAMPUS\": 6, \"COMMERCIAL_HUB\": 3, \"HOLY_SITE\": 2}, \"total_adjacency\": 11}\r\n"]
[118.445141, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[134.711346, "i", "python3 -c \"import json; data = json.load(open('map_data.json')); plots = {(p['x'], p['y']): p for p in data['plots']}; print(plots[(22, 13)].get('river')); print(plots[(21, 13)].get('river')); print(plots[(22, 12)].get('river'))\"\n"]
[134.71204, "o", "python3 -c \"import json; data = json.load(open('map_data.json')); plots = {(p['x'], p['y']): p for p in data['plots']}; print(plots[(22, 13)].get('river')); print(plots[(21, 13)].get('river')); print(plots[(22, 12)].get('river'))\""]
[134.712194, "o", "\r\n\u001b[?2004l\r"]
[134.733962, "o", "None\r\n{'NE': 0, 'W': 1, 'NW': 1}\r\nNone\r\n"]
[134.737474, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[141.953219, "i", "python3 -c \"import json; data = json.load(open('map_data.json')); plots = {(p['x'], p['y']): p for p in data['plots']}; print('23,13:', plots[(23, 13)].get('river')); print('23,12:', plots[(23, 12)].get('river')); print('22,12:', plots[(22, 12)].get('river'))\"\n"]
[141.953894, "o", "python3 -c \"import json; data = json.load(open('map_data.json')); plots = {(p['x'], p['y']): p for p in data['plots']}; print('23,13:', plots[(23, 13)].get('river')); print('23,12:', plots[(23, 12)].get('river')); print('22,12:', plots[(22, 12)].get('river'))\"\r\n\u001b[?2004l\r"]
[141.971473, "o", "23,13: None\r\n23,12: None\r\n22,12: None\r\n"]
[141.974285, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[154.359382, "i", "cat << 'EOF' > optimize.py\nimport json\nimport itertools\n\ndef get_dist(p1, p2, width, height):\n    x1, y1 = p1['x'], p1['y']\n    x2, y2 = p2['x'], p2['y']\n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n    q1, r1, s1 = to_cube(x1, y1)\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\nwith open('map_data.json') as f:\n    map_data = json.load(f)\nwidth = map_data['width']\nheight = map_data['height']\nplots = { (p['x'], p['y']): p for p in map_data['plots'] }\n\ndef get_neighbors(x, y):\n    neighbors = []\n    if y % 2 == 0:\n        coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n    else:\n        coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n    for nx, ny in coords:\n        if 0 <= ny < height:\n            neighbors.append(plots[(nx % width, ny)])\n    return neighbors\n\ndef is_adjacent_to_river(p):\n    if p.get('river'):\n        if p['river'].get('NE') or p['river'].get('W') or p['river'].get('NW'):\n            return True\n    x, y = p['x'], p['y']\n    # E neighbor\n    ne = plots[((x + 1) % width, y)]\n    if ne.get('river') and ne['river'].get('W'): return True\n    # SE neighbor\n    if y % 2 == 0: nse = plots[((x + 1) % width, y - 1)] if y > 0 else None\n    else: nse = plots[(x, y - 1)] if y > 0 else None\n    if nse and nse.get('river') and nse['river'].get('NW'): return True\n    # SW neighbor\n    if y % 2 == 0: nsw = plots[(x, y - 1)] if y > 0 else None\n    else: nsw = plots[((x - 1) % width, y - 1)] if y > 0 else None\n    if nsw and nsw.get('river') and nsw['river'].get('NE'): return True\n    return False\n\ndef calc_bonus(type, p, placements):\n    neighbors = get_neighbors(p['x'], p['y'])\n    bonus = 0\n    if type == 'CAMPUS':\n        for n in neighbors:\n            if 'MOUNTAIN' in n['terrain']: bonus += 1\n            if n.get('feature') == 'FEATURE_REEF': bonus += 2\n            if n.get('feature') == 'FEATURE_GEOTHERMAL_FISSURE': bonus += 2\n            if n.get('feature') == 'FEATURE_JUNGLE': bonus += 0.5\n    elif type == 'COMMERCIAL_HUB':\n        if is_adjacent_to_river(p): bonus += 2\n    elif type == 'HOLY_SITE':\n        for n in neighbors:\n            if 'MOUNTAIN' in n['terrain']: bonus += 1\n            if n.get('feature') == 'FEATURE_FOREST': bonus += 0.5\n    elif type == 'INDUSTRIAL_ZONE':\n        pass\n    \n    districts = sum(1 for n in neighbors if (n['x'], n['y']) in placements)\n    bonus += districts // 2\n    return int(bonus)\n\nbest_total = -1\nbest_res = {}\ntypes = ['CAMPUS', 'COMMERCIAL_HUB', 'INDUSTRIAL_ZONE', 'HOLY_SITE', 'THEATER_SQUARE']\n\nfor city_x in range(width):\n    for city_y in range(height):\n        cc_plot = plots[(city_x, city_y)]\n        if 'MOUNTAIN' in cc_plot['terrain'] or 'OCEAN' in cc_plot['terrain'] or 'COAST' in cc_plot['terrain'] or cc_plot.get('feature') == 'FEATURE_ICE':\n            continue\n        \n        city_center = (city_x, city_y)\n        nearby = [p for p in map_data['plots'] if get_dist(cc_plot, p, width, height) <= 3 and (p['x'], p['y']) != city_center and 'MOUNTAIN' not in p['terrain'] and 'OCEAN' not in p['terrain'] and 'COAST' not in p['terrain'] and p.get('feature') != 'FEATURE_ICE']\n        \n        for combo in itertools.combinations(types, 3):\n            type_spots = []\n            for t in combo:\n                ts = sorted(nearby, key=lambda p: calc_bonus(t, p, {city_center: 'CITY_CENTER'}), reverse=True)[:3]\n                type_spots.append([(t, p) for p in ts])\n            \n            for d1, d2, d3 in itertools.product(*type_spots):\n                if d1[1]['id'] == d2[1]['id'] or d1[1]['id'] == d3[1]['id'] or d2[1]['id'] == d3[1]['id']:\n                    continue\n                \n                placements = {city_center: 'CITY_CENTER', (d1[1]['x'], d1[1]['y']): d1[0], (d2[1]['x'], d2[1]['y']): d2[0], (d3[1]['x'], d3[1]['y']): d3[0]}\n                b1 = calc_"]
[154.359447, "i", "bonus(d1[0], d1[1], placements)\n                b2 = calc_bonus(d2[0], d2[1], placements)\n                b3 = calc_bonus(d3[0], d3[1], placements)\n                total = b1 + b2 + b3\n                \n                if total > best_total:\n                    best_total = total\n                    best_res = {\n                        \"city_center\": [city_x, city_y],\n                        \"placements\": {\n                            d1[0]: [d1[1]['x'], d1[1]['y']],\n                            d2[0]: [d2[1]['x'], d2[1]['y']],\n                            d3[0]: [d3[1]['x'], d3[1]['y']]\n                        },\n                        \"adjacency_bonuses\": {\n                            d1[0]: b1,\n                            d2[0]: b2,\n                            d3[0]: b3\n                        },\n                        \"total_adjacency\": total\n                    }\n\nprint(json.dumps(best_res))\nEOF\npython3 optimize.py\n"]
