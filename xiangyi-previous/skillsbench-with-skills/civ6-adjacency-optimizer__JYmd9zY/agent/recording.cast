[92.529365, "o", "                                },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.529504, "o", "                                \"adjacency_bonuses\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.529573, "o", "                                    \"CAMPUS\": c_bonus,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.529709, "o", "                                    \"COMMERCIAL_HUB\": ch_bonus,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.529856, "o", "                                    \"INDUSTRIAL_ZONE\": iz_bonus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.529965, "o", "                                },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.53009, "o", "                                \"total_adjacency\": total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.530173, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
