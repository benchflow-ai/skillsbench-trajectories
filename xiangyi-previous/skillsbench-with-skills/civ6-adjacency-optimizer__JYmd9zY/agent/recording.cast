[29.423442, "o", "    cursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.424261, "o", ">     for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>         plots[row[0]][\"feature\"] = row[1]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     cursor.execute(\"SELECT ID, ResourceType FROM PlotResources\")\r\n\u001b[?2004l\r\u001b[?2004h>     for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>         plots[row[0]][\"resource\"] = row[1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.424411, "o", "    cursor.execute(\"SELECT ID, IsNEOfRiver, IsWOfRiver, IsNWOfRiver FROM PlotRivers\")\r\n\u001b[?2004l\r\u001b[?2004h>     for row in cursor.fetchall():\r\n\u001b[?2004l\r"]
[29.424485, "o", "\u001b[?2004h> "]
[29.426952, "o", "        plots[row[0]][\"river\"] = {\"NE\": row[1], \"W\": row[2], \"NW\": row[3]}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return {\"width\": width, \"height\": height, \"plots\": list(plots.values())}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = get_map_data('/data/maps/e2e_test_case_0.Civ6Map')\r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(data))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
