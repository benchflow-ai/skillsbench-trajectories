[75.159147, "o", "\u001b[?2004hroot@dabf478945c1:~# "]
[92.512247, "i", "cat << 'EOF' > optimize.py\nimport json\n\ndef get_dist(p1, p2, width, height):\n    x1, y1 = p1['x'], p1['y']\n    x2, y2 = p2['x'], p2['y']\n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n    q1, r1, s1 = to_cube(x1, y1)\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\ndef solve():\n    with open('map_data.json') as f:\n        map_data = json.load(f)\n    width = map_data['width']\n    height = map_data['height']\n    plots = { (p['x'], p['y']): p for p in map_data['plots'] }\n    \n    def get_neighbors(x, y):\n        neighbors = []\n        if y % 2 == 0:\n            coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n        else:\n            coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n        for nx, ny in coords:\n            if 0 <= ny < height:\n                neighbors.append(plots[(nx % width, ny)])\n        return neighbors\n\n    def calc_campus(p, placements):\n        bonus = 0\n        neighbors = get_neighbors(p['x'], p['y'])\n        for n in neighbors:\n            if 'MOUNTAIN' in n['terrain']:\n                bonus += 1\n            if n.get('feature') == 'FEATURE_REEF':\n                bonus += 2\n            if n.get('feature') == 'FEATURE_GEOTHERMAL_FISSURE':\n                bonus += 2\n            if n.get('feature') == 'FEATURE_JUNGLE':\n                bonus += 0.5\n        districts = sum(1 for n in neighbors if (n['x'], n['y']) in placements)\n        bonus += districts // 2\n        return int(bonus)\n\n    def calc_commercial_hub(p, placements):\n        bonus = 0\n        if p.get('river') and (p['river']['NE'] or p['river']['W'] or p['river']['NW']):\n            bonus += 2\n        else:\n            for n in get_neighbors(p['x'], p['y']):\n                if n.get('river') and (n['river']['NE'] or n['river']['W'] or n['river']['NW']):\n                    bonus += 2\n                    break\n        districts = sum(1 for n in get_neighbors(p['x'], p['y']) if (n['x'], n['y']) in placements)\n        bonus += districts // 2\n        return int(bonus)\n\n    def calc_industrial_zone(p, placements):\n        bonus = 0\n        for n in get_neighbors(p['x'], p['y']):\n            if n.get('resource') in ['RESOURCE_IRON', 'RESOURCE_COAL', 'RESOURCE_STRATEGIC_COAL', 'RESOURCE_ALUMINUM', 'RESOURCE_STRATEGIC_ALUMINUM', 'RESOURCE_COPPER']:\n                pass # Mines would give bonus, but we don't know improvements.\n            # Let's assume no improvements.\n        districts = sum(1 for n in get_neighbors(p['x'], p['y']) if (n['x'], n['y']) in placements)\n        bonus += districts // 2\n        return int(bonus)\n\n    best_total = -1\n    best_res = {}\n\n    # Iterate over possible city centers\n    for x in range(width):\n        for y in range(height):\n            cc_plot = plots[(x, y)]\n            if 'MOUNTAIN' in cc_plot['terrain'] or 'OCEAN' in cc_plot['terrain'] or 'COAST' in cc_plot['terrain'] or cc_plot.get('feature') == 'FEATURE_ICE':\n                continue\n            \n            # City center at (x, y)\n            city_center = (x, y)\n            nearby = [p for p in map_data['plots'] if get_dist(cc_plot, p, width, height) <= 3 and (p['x'], p['y']) != city_center and 'MOUNTAIN' not in p['terrain'] and 'OCEAN' not in p['terrain'] and 'COAST' not in p['terrain'] and p.get('feature') != 'FEATURE_ICE']\n            \n            # Try combinations of 3 districts from nearby plots\n            # To speed up, we can pick the best spots for each district type\n            best_campus = sorted(nearby, key=lambda p: calc_campus(p, {city_center: 'CITY_CENTER'}), reverse=True)[:5]\n            for cp in best_campus:\n                placements = {city_center: 'CITY_CENTER', (cp['x'], cp['y']): 'CAMPUS'}\n                remaining = [p for p in nearby if (p['x'], p['y']) not in placements]\n                best_ch = sorted(remaining, key=lambda"]
[92.512311, "i", " p: calc_commercial_hub(p, placements), reverse=True)[:5]\n                for chp in best_ch:\n                    placements[(chp['x'], chp['y'])] = 'COMMERCIAL_HUB'\n                    remaining2 = [p for p in remaining if (p['x'], p['y']) not in placements]\n                    best_iz = sorted(remaining2, key=lambda p: calc_industrial_zone(p, placements), reverse=True)[:5]\n                    for izp in best_iz:\n                        placements[(izp['x'], izp['y'])] = 'INDUSTRIAL_ZONE'\n                        \n                        c_bonus = calc_campus(cp, placements)\n                        ch_bonus = calc_commercial_hub(chp, placements)\n                        iz_bonus = calc_industrial_zone(izp, placements)\n                        total = c_bonus + ch_bonus + iz_bonus\n                        \n                        if total > best_total:\n                            best_total = total\n                            best_res = {\n                                \"city_center\": [x, y],\n                                \"placements\": {\n                                    \"CAMPUS\": [cp['x'], cp['y']],\n                                    \"COMMERCIAL_HUB\": [chp['x'], chp['y']],\n                                    \"INDUSTRIAL_ZONE\": [izp['x'], izp['y']]\n                                },\n                                \"adjacency_bonuses\": {\n                                    \"CAMPUS\": c_bonus,\n                                    \"COMMERCIAL_HUB\": ch_bonus,\n                                    \"INDUSTRIAL_ZONE\": iz_bonus\n                                },\n                                \"total_adjacency\": total\n                            }\n                        del placements[(izp['x'], izp['y'])]\n                    del placements[(chp['x'], chp['y'])]\n\n    print(json.dumps(best_res))\n\nsolve()\nEOF\npython3 optimize.py\n"]
