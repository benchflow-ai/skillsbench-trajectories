[92.528626, "o", "> "]
[92.528703, "o", "                                \"placements\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.528755, "o", "> "]
[92.528849, "o", "                                    \"CAMPUS\": [cp['x'], cp['y']],\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.528896, "o", "> "]
