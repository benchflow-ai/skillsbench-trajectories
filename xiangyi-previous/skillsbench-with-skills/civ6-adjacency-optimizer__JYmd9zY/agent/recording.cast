EAN\", \"x\": 23, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1124, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 24, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1125, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 25, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1126, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 26, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1127, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 27, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1128, \"terrain\": \"TERRAIN_COAST\", \"x\": 28, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1129, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 29, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1130, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 30, \"y\": 25}, {\"id\": 1131, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 31,"]
[32.751685, "o", " \"y\": 25}, {\"id\": 1132, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 32, \"y\": 25}, {\"id\": 1133, \"terrain\": \"TERRAIN_COAST\", \"x\": 33, \"y\": 25}, {\"id\": 1134, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 34, \"y\": 25}, {\"id\": 1135, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 35, \"y\": 25}, {\"id\": 1136, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 36, \"y\": 25}, {\"id\": 1137, \"terrain\": \"TERRAIN_COAST\", \"x\": 37, \"y\": 25}, {\"id\": 1138, \"terrain\": \"TERRAIN_COAST\", \"x\": 38, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1139, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 39, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1140, \"terrain\": \"TERRAIN_COAST\", \"x\": 40, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1141, \"terrain\": \"TERRAIN_COAST\", \"x\": 41, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1142, \"terrain\": \"TERRAIN_COAST\", \"x\": 42, \"y\": 25, \"feature\": \"FEATURE_ICE\"}, {\"id\": 1143, \"terrain\": \"TERRAIN_OCEAN\", \"x\": 43, \"y\": 25}]}\r\n\u001b[?2004hroot@dabf478945c1:~# "]
[42.027022, "i", "cat << 'EOF' > optimize.py\nimport json\n\ndef get_dist(p1, p2, width):\n    x1, y1 = p1['x'], p1['y']\n    x2, y2 = p2['x'], p2['y']\n    dx = x2 - x1\n    dy = y2 - y1\n    if abs(dx) > width / 2:\n        if dx > 0: dx -= width\n        else: dx += width\n    \n    # Hexagonal distance\n    # For even-r horizontal layout:\n    # x_h = x - (y + (y&1)) / 2\n    # z_h = y\n    # y_h = -x_h - z_h\n    \n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n\n    q1, r1, s1 = to_cube(x1, y1)\n    q2, r2, s2 = to_cube(x2, y2)\n    return (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n\ndef solve():\n    with open('map_data.json') as f:\n        map_data = json.load(f)\n    \n    width = map_data['width']\n    height = map_data['height']\n    plots = { (p['x'], p['y']): p for p in map_data['plots'] }\n    \n    def get_neighbors(x, y):\n        neighbors = []\n        # Standard axial neighbors for even-r hex grid\n        # Even rows: (x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)\n        # Odd rows: (x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)\n        if y % 2 == 0:\n            coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n        else:\n            coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n        \n        for nx, ny in coords:\n            if 0 <= ny < height:\n                nx %= width\n                neighbors.append(plots[(nx, ny)])\n        return neighbors\n\n    best_total = -1\n    best_solution = {}\n\n    # For simplicity, let's look for a mountain range for Campus\n    # or a river for Commercial Hub\n    \n    for x in range(width):\n        for y in range(height):\n            p = plots[(x, y)]\n            if 'MOUNTAIN' in p['terrain'] or 'OCEAN' in p['terrain'] or 'COAST' in p['terrain'] or p.get('feature') == 'FEATURE_ICE':\n                continue\n            \n            # City Center at (x, y)\n            city_center = (x, y)\n            potential_plots = []\n            for dx in range(-3, 4):\n                for dy in range(-3, 4):\n                    nx, ny = (x + dx) % width, y + dy\n                    if 0 <= ny < height:\n                        if get_dist(p, plots[(nx, ny)], width) <= 3:\n                            potential_plots.append(plots[(nx, ny)])\n            \n            # Try some combinations or heuristics\n            # For now, just find the best Campus, then best IZ, then best CH\n            # This is a greedy approach but might work for a single city\n            # ...\n\n# Actually, let's just find the best individual spots first\nsolve()\nEOF\n"]
