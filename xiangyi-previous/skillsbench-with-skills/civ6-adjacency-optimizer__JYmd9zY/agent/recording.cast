[92.526551, "o", "> "]
[92.526634, "o", "                    placements[(chp['x'], chp['y'])] = 'COMMERCIAL_HUB'\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.526685, "o", "> "]
[92.52682, "o", "                    remaining2 = [p for p in remaining if (p['x'], p['y']) not in placements]\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.52687, "o", "> "]
[92.527082, "o", "                    best_iz = sorted(remaining2, key=lambda p: calc_industrial_zone(p, placements), reverse=True)[:5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.527182, "o", "                    for izp in best_iz:\r\n\u001b[?2004l\r\u001b[?2004h"]
