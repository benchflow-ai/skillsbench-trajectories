[160.958134, "i", "python3 << 'EOF'\nfrom PyPDF2 import PdfReader\n\n# Read the blank PDF and examine checkbox structure\nreader = PdfReader('/root/sc100-blank.pdf')\nfields = reader.get_fields()\n\nprint(\"Examining checkbox fields for valid values:\")\nfor field_name in ['Checkbox1[0]', 'Checkbox2[0]', 'Checkbox3[0]']:\n    if field_name in fields:\n        field = fields[field_name]\n        print(f\"\\n{field_name}:\")\n        if '/AP' in field:\n            print(f\"  Appearance: {field['/AP']}\")\n        if '/V' in field:\n            print(f\"  Value: {field['/V']}\")\n        if '/DV' in field:\n            print(f\"  Default Value: {field['/DV']}\")\n        if '/AS' in field:\n            print(f\"  Appearance State: {field['/AS']}\")\nEOF\n"]
