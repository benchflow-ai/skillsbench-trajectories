[171.629148, "i", "python3 << 'EOF'\nfrom PyPDF2 import PdfReader\n\n# Read the filled PDF to verify data\nreader = PdfReader('/root/sc100-filled.pdf')\nfields = reader.get_fields()\n\nprint(\"Checking filled form values:\")\nkey_fields = [\n    'PlaintiffName1[0]',\n    'DefendantName1[0]',\n    'PlaintiffClaimAmount1[0]',\n    'Date1[0]',\n    'Item1[0]',\n    'Checkbox1[0]',\n    'Checkbox2[0]',\n]\n\nfor field_name in key_fields:\n    if field_name in fields:\n        field = fields[field_name]\n        value = field.get('/V', 'No value')\n        print(f\"{field_name}: {value}\")\nEOF\n"]
