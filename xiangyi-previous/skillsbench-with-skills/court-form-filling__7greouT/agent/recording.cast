[148.435364, "i", "python3 << 'EOF'\nfrom PyPDF2 import PdfReader, PdfWriter\n\n# Read the blank PDF\nreader = PdfReader('/root/sc100-blank.pdf')\nwriter = PdfWriter()\n\n# Copy all pages\nfor page in reader.pages:\n    writer.add_page(page)\n\n# Prepare the claim description\nclaim_description = \"Defendant failed to return my security deposit of $1500 based on the signed roommate sublease contract after moving out. I have asked him to return the money multiple times via text but he is not responding. The amount is listed on the signed roommate sublease contract.\"\n\n# Fill in the form fields with all necessary information\nfield_data = {\n    # Plaintiff Information (Joyce He)\n    'PlaintiffName1[0]': 'Joyce He',\n    'PlaintiffAddress1[0]': '655 S Fair Oaks Ave',\n    'PlaintiffCity1[0]': 'Sunnyvale',\n    'PlaintiffState1[0]': 'CA',\n    'PlaintiffZip1[0]': '94086',\n    'PlaintiffPhone1[0]': '4125886066',\n    'EmailAdd1[0]': 'he1998@gmail.com',\n    \n    # Defendant Information (Zhi Chen)\n    'DefendantName1[0]': 'Zhi Chen',\n    'DefendantAddress1[0]': '299 W Washington Ave',\n    'DefendantCity1[0]': 'Sunnyvale',\n    'DefendantState1[0]': 'CA',\n    'DefendantZip1[0]': '94086',\n    'DefendantPhone1[0]': '5125658878',\n    \n    # Claim Amount\n    'PlaintiffClaimAmount1[0]': '1500.00',\n    \n    # Filing Date\n    'Date1[0]': '2026-01-19',\n    \n    # Dates of incident\n    'Date2[0]': '2025-09-30',\n    'Date3[0]': '2026-01-19',\n    \n    # Claim description\n    'Item1[0]': claim_description,\n    \n    # Checkboxes - trying common patterns for SC-100\n    # Checkbox2 is often for \"defendant lives or does business in this county\"\n    'Checkbox2[0]': '/Yes',\n    \n    # Checkbox1 might be for first-time filer or other initial option\n    'Checkbox1[0]': '/Yes',\n}\n\n# Update form fields for all pages\nfor page_num in range(len(writer.pages)):\n    writer.update_page_form_field_values(writer.pages[page_num], field_data)\n\n# Write to output file\nwith open('/root/sc100-filled.pdf', 'wb') as output_file:\n    writer.write(output_file)\n\nprint(\"Form filled with checkboxes\")\nEOF\n"]
