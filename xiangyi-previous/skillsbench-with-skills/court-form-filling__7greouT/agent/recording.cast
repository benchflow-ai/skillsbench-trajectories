[127.79504, "i", "python3 << 'EOF'\nfrom PyPDF2 import PdfReader\n\n# Check what checkbox fields exist and their purpose\nreader = PdfReader('/root/sc100-blank.pdf')\nfields = reader.get_fields()\n\nprint(\"Checkbox fields:\")\nfor field_name in sorted(fields.keys()):\n    if 'Checkbox' in field_name or 'Check' in field_name:\n        print(f\"  {field_name}\")\nEOF\n"]
