[37.829417, "i", "python3 << 'EOF'\nfrom pdfrw import PdfReader\n\npdf = PdfReader('/root/sc100-blank.pdf')\nif pdf.Root.AcroForm:\n    print(\"Form fields found:\")\n    fields = pdf.Root.AcroForm.Fields\n    for field in fields:\n        print(f\"Field Name: {field.T}\")\n        if hasattr(field, 'V'):\n            print(f\"  Value: {field.V}\")\n        if hasattr(field, 'FT'):\n            print(f\"  Type: {field.FT}\")\n        print()\nelse:\n    print(\"No AcroForm found\")\nEOF\n"]
