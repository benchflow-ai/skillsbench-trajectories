[1004.115555, "o", "        \r\n\u001b[?2004l\r"]
[1004.115584, "o", "\u001b[?2004h"]
[1004.116052, "o", ">         cft = classic_sta_lta(data, int(sta_len * sr), int(lta_len * sr))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Higher threshold to reduce false positives\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116158, "o", "        on_off = trigger_onset(cft, 4.0, 1.5)\r\n\u001b[?2004l\r"]
[1004.116235, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for on, off in on_off:\r\n\u001b[?2004l\r"]
[1004.116328, "o", "\u001b[?2004h> "]
[1004.116403, "o", "            pick_time = start_time + (on / sr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116477, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116551, "o", "            # P pick\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116626, "o", "            all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116711, "o", "                'station': station_id,\r\n\u001b[?2004l\r"]
[1004.116783, "o", "\u001b[?2004h> "]
[1004.116855, "o", "                'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.116926, "o", "                'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.117008, "o", "> "]
[1004.117084, "o", "                'probability': 0.7\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r"]
[1004.117167, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.117287, "o", "            # S pick with distance-based timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.117389, "o", "            s_time = pick_time + sp_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.117459, "o", "            all_picks.append({\r\n\u001b[?2004l\r"]
[1004.11753, "o", "\u001b[?2004h> "]
[1004.1176, "o", "                'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.117668, "o", "                'time': s_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.117736, "o", "                'phase': 'S',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.117803, "o", "> "]
[1004.117874, "o", "                'probability': 0.6\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r"]
[1004.117948, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118028, "o", "        print(f\"{len(on_off)} triggers\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.118098, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118169, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118239, "o", "        print(f\"Error: {e}\")\r\n\u001b[?2004l\r"]
[1004.118316, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118387, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118455, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1004.118521, "o", "\u001b[?2004h> if len(all_picks) == 0:\r\n\u001b[?2004l\r"]
[1004.11859, "o", "\u001b[?2004h> "]
[1004.118657, "o", "    print(\"No picks! Creating empty results.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118819, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.118885, "o", "    exit(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1004.118954, "o", "\u001b[?2004h> "]
[1004.119025, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.119211, "o", "print(f\"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}\")\r\n\u001b[?2004l\r"]
[1004.119351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Associate events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.119448, "o", "print(\"\\nAssociating events...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.119543, "o", "origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> for pick in all_picks:\r\n\u001b[?2004l\r"]
[1004.119634, "o", "\u001b[?2004h> "]
[1004.119726, "o", "    if pick['station'] not in station_lookup:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[1004.119827, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.119927, "o", "    s = station_lookup[pick['station']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120065, "o", "    dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0\r\n\u001b[?2004l\r"]
[1004.120146, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120228, "o", "    tt = dist / (vp if pick['phase'] == 'P' else vs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120343, "o", "    origin_times.append(pick['time'].timestamp - tt)\r\n\u001b[?2004l\r"]
[1004.120417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120512, "o", "origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r"]
[1004.120586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120663, "o", "# Require at least 6 picks (3 stations with P+S)\r\n\u001b[?2004l\r"]
[1004.120733, "o", "\u001b[?2004h> "]
[1004.120801, "o", "dbscan = DBSCAN(eps=5.0, min_samples=6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.120879, "o", "labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r"]
[1004.12095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.121083, "o", "print(f\"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters\")\r\n\u001b[?2004l\r"]
[1004.121165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.121237, "o", "> for cid in set(labels):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.121313, "o", ">     if cid == -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.121383, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.121452, "o", "    mask = labels == cid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.121552, "o", "    t = np.median(origin_times_array[mask])\r\n\u001b[?2004l\r"]
[1004.121625, "o", "\u001b[?2004h>     n_picks = int(np.sum(mask))\r\n\u001b[?2004l\r"]
[1004.121695, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.12176, "o", "    # Only keep events with sufficient picks\r\n\u001b[?2004l\r"]
[1004.121826, "o", "\u001b[?2004h> "]
[1004.12189, "o", "    if n_picks >= 6:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.121957, "o", "        events.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122057, "o", "            'time': datetime.utcfromtimestamp(t).isoformat(),\r\n\u001b[?2004l\r"]
[1004.122129, "o", "\u001b[?2004h> "]
[1004.122199, "o", "            'num_picks': n_picks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122273, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122409, "o", "events_df = pd.DataFrame(events).sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.122482, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122553, "o", "print(f\"\\nEvents: {len(events_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122621, "o", "if len(events_df) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.122689, "o", "    print(events_df.head(20))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1004.122757, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1004.122848, "o", "events_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[1004.122923, "o", "\u001b[?2004h> "]
[1004.122991, "o", "print(\"\\nSaved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
