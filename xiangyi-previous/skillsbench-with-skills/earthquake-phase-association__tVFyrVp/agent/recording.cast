[1041.610842, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[1041.610877, "o", "\u001b[?2004h> "]
[1041.610907, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[1041.610938, "o", "\u001b[?2004h> "]
[1041.611606, "o", "df = pd.read_csv('/root/results.csv')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Total events: {len(df)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Columns: {list(df.columns)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'First time: {df.iloc[0][\"time\"]}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Last time: {df.iloc[-1][\"time\"]}')"]
[1041.611736, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1041.611858, "o", "> "]
[1041.61195, "o", "print(f'Sample times:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1041.612073, "o", "for i in range(min(3, len(df))):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1041.612146, "o", "    print(f'  {df.iloc[i][\"time\"]}')\r\n\u001b[?2004l\r"]
