[57.908781, "o", "                z_tr = tr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.90884, "o", "            elif ch[-1] == 'N':\r\n\u001b[?2004l\r s\u001b[?2004h> "]
[57.908901, "o", "                n_tr = tr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.908963, "o", "            elif ch[-1] == 'E':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.909034, "o", "                e_tr = tr\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.909081, "o", ">         \r\n\u001b[?2004l\r"]
[57.909115, "o", "\u001b[?2004h> "]
[57.909221, "o", "        if z_tr is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.909308, "o", "            print(f\"  No Z component for {station_id}, skipping\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.909361, "o", "            continue\r\n\u001b[?2004l\r_l\u001b[?2004h> "]
[57.909424, "o", "            \r\n\u001b[?2004l\r  \u001b[?2004h> "]
[57.909523, "o", "        # Use Z component for picking (most reliable)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.909556, "o", "> "]
[57.909589, "o", "        data = z_tr.data\r\n\u001b[?2004l\rul"]
[57.909679, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[57.909716, "o", "\u001b[?2004h>         # Normalize\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[57.90978, "o", "        data = data.astype(np.float32)\r\n\u001b[?2004l\rt\u001b[?2004h"]
[57.909811, "o", "> "]
[57.909932, "o", "        data = (data - np.mean(data)) / (np.std(data) + 1e-10)\r\n\u001b[?2004l\r- m\u001b[?2004h> "]
[57.909969, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.910058, "o", "        # Pad or trim to appropriate length\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.910096, "o", "> "]
[57.91019, "o", "        # PhaseNet expects 3001 samples (30 seconds at 100 Hz)\r\n\u001b[?2004l\rr\u001b[?2004h"]
[57.910224, "o", "> "]
[57.910311, "o", "        target_len = 3001\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.910342, "o", "        if len(data) < target_len:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.910495, "o", "            data = np.pad(data, (0, target_len - len(data)), 'constant')\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.910527, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[57.910594, "o", ">         # Process in windows\r\n\u001b[?2004l\r \u001b[?2004h"]
[57.910628, "o", "> "]
[57.910694, "o", "        window_size = 3001\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.910763, "o", "        step_size = 1500  # 50% overlap\r\n\u001b[?2004l\r"]
[57.910796, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r tr"]
[57.910861, "o", "\u001b[?2004h> "]
[57.91095, "o", "        for i in range(0, len(data) - window_size + 1, step_size):\r\n\u001b[?2004l\r"]
[57.910985, "o", "\u001b[?2004h> "]
[57.911056, "o", "            window_data = data[i:i+window_size]\r\n\u001b[?2004l\r"]
[57.911092, "o", "\u001b[?2004h> "]
[57.911123, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.911257, "o", "            # Create 3-channel input (duplicate Z if N/E not available)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.911368, "o", "            if n_tr is not None and e_tr is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.911402, "o", "> "]
[57.911517, "o", "                n_data = n_tr.data[i:i+window_size].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.911669, "o", "                e_data = e_tr.data[i:i+window_size].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.911826, "o", "                n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)\r\n\u001b[?2004l\re"]
[57.911862, "o", "\u001b[?2004h> "]
[57.911989, "o", "                e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)\r\n\u001b[?2004l\r"]
[57.912023, "o", "\u001b[?2004h> "]
[57.912131, "o", "                input_data = np.array([window_data, n_data, e_data])\r\n\u001b[?2004l\r"]
[57.912166, "o", "\u001b[?2004h> "]
[57.912233, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.912361, "o", "                input_data = np.array([window_data, window_data, window_data])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.912423, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.912489, "o", "            # Add batch dimension\r\n\u001b[?2004l\rim\u001b[?2004h"]
[57.912546, "o", "> "]
[57.912611, "o", "            input_data = input_data[np.newaxis, :, :]\r\n\u001b[?2004l\r"]
[57.912649, "o", "\u001b[?2004h> "]
[57.912681, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.912781, "o", "            # Run model\r\n\u001b[?2004l\r}\u001b[?2004h> "]
[57.912847, "o", "            predictions = model.annotate(input_data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.912883, "o", ">             \r\n\u001b[?2004l\r"]
[57.912949, "o", "\u001b[?2004h> "]
[57.913023, "o", "            # Extract P and S picks (using threshold)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.913199, "o", "            p_prob = predictions[0, 1, :]  # P wave probability\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.913232, "o", "> "]
[57.913387, "o", "            s_prob = predictions[0, 2, :]  # S wave probability\r\n\u001b[?2004l\r"]
[57.913424, "o", "\u001b[?2004h> "]
[57.913458, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[57.913491, "o", "> "]
[57.913606, "o", "            threshold = 0.5\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.913669, "o", "            # Find peaks in P probability\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.913701, "o", "            p_peaks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.913785, "o", "            for j in range(1, len(p_prob) - 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91394, "o", "                if p_prob[j] > threshold and p_prob[j] > p_prob[j-1] and p_prob[j] > p_prob[j+1]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.913975, "o", "> "]
[57.914049, "o", "                    p_peaks.append((j, p_prob[j]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914085, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914155, "o", "            # Find peaks in S probability\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.914187, "o", "> "]
[57.914264, "o", "            s_peaks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914328, "o", "            for j in range(1, len(s_prob) - 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914459, "o", "                if s_prob[j] > threshold and s_prob[j] > s_prob[j-1] and s_prob[j] > s_prob[j+1]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.914491, "o", "> "]
[57.914565, "o", "                    s_peaks.append((j, s_prob[j]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.9146, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914672, "o", "            # Convert to absolute time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.914801, "o", "            window_start_time = z_tr.stats.starttime + (i / z_tr.stats.sampling_rate)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.914837, "o", ">             \r\n\u001b[?2004l\r"]
[57.914869, "o", "\u001b[?2004h> "]
[57.914928, "o", "            for peak_idx, prob in p_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915057, "o", "                pick_time = window_start_time + (peak_idx / 100.0)  # 100 Hz\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915118, "o", "                all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.915152, "o", "> "]
[57.915229, "o", "                    'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915281, "o", "                    'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.915313, "o", "> "]
[57.915347, "o", "                    'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.915379, "o", "> "]
[57.915492, "o", "                    'probability': prob\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915527, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915597, "o", "            for peak_idx, prob in s_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915711, "o", "                pick_time = window_start_time + (peak_idx / 100.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.915748, "o", "> "]
[57.91578, "o", "                all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.915814, "o", "> "]
[57.915921, "o", "                    'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.915958, "o", "                    'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916035, "o", "                    'phase': 'S',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916095, "o", "                    'probability': prob\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916131, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.916202, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916238, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91632, "o", "        print(f\"  Error processing {station_id}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.916356, "o", ">         continue\r\n\u001b[?2004l\r"]
[57.916391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916488, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916546, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.916582, "o", "> "]
[57.916669, "o", "print(f\"P picks: {len(picks_df[picks_df['phase'] == 'P'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916749, "o", "print(f\"S picks: {len(picks_df[picks_df['phase'] == 'S'])}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.916786, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916863, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.916898, "o", "    print(\"No picks found!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91698, "o", "    # Create empty results file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.917076, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.917113, "o", ">     exit(0)\r\n\u001b[?2004l\r"]
[57.917147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.917228, "o", "# Event association using origin time clustering\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.917262, "o", "> "]
[57.917338, "o", "print(\"\\nAssociating picks to events...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91743, "o", "# For each pick, estimate origin time by back-projecting\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.917462, "o", "> "]
[57.917538, "o", "# Assume source at mean station location initially\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91764, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.917679, "o", "> "]
[57.917774, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[57.917809, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[57.917843, "o", "vp = 6.0  # km/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.917944, "o", "vs = vp / 1.75  # km/s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.917979, "o", "# Calculate origin times\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918044, "o", "origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> for pick in all_picks:\r\n\u001b[?2004l\r"]
[57.91808, "o", "\u001b[?2004h> "]
[57.918153, "o", "    station_id = pick['station']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918206, "o", "    if station_id not in station_lookup:\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.918257, "o", ">         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918292, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918362, "o", "    station_info = station_lookup[station_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918397, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918481, "o", "    # Calculate distance (simple approximation)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.918568, "o", "    lat_diff = station_info['latitude'] - mean_lat\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.918604, "o", "> "]
[57.918679, "o", "    lon_diff = station_info['longitude'] - mean_lon\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91876, "o", "    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.918784, "o", "> "]
[57.918865, "o", "    distance_km = distance_deg * 111.0  # rough conversion\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.918928, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[57.919004, "o", ">     # Estimate travel time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919043, "o", "    if pick['phase'] == 'P':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919121, "o", "        travel_time = distance_km / vp\r\n\u001b[?2004l\r\u001b[?2004h>     else:  # S wave\r\n\u001b[?2004l\r"]
[57.91918, "o", "\u001b[?2004h> "]
[57.91922, "o", "        travel_time = distance_km / vs\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.919307, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.91934, "o", "    # Origin time = pick time - travel time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919407, "o", "    origin_time = pick['time'] - travel_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.919441, "o", "> "]
[57.919507, "o", "    origin_times.append(origin_time.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[57.919542, "o", "\u001b[?2004h> "]
[57.919649, "o", "# Cluster origin times using DBSCAN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919684, "o", "origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r"]
[57.919716, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919812, "o", "# Use 5 second tolerance for clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919871, "o", "dbscan = DBSCAN(eps=5.0, min_samples=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.919952, "o", "cluster_labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.919988, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920137, "o", "print(f\"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.920175, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920207, "o", "# Extract unique events\r\n\u001b[?2004l\r"]
[57.920239, "o", "\u001b[?2004h> events = []\r\n\u001b[?2004l\r"]
[57.920271, "o", "\u001b[?2004h> "]
[57.920377, "o", "for cluster_id in set(cluster_labels):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920519, "o", "    if cluster_id == -1:  # noise\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920586, "o", "    cluster_mask = cluster_labels == cluster_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920676, "o", "    cluster_origin_times = origin_times_array[cluster_mask]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920703, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920792, "o", "    # Use median origin time for this event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.920871, "o", "    event_time = np.median(cluster_origin_times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.920907, "o", "> "]
[57.920942, "o", "    events.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921057, "o", "        'time': datetime.utcfromtimestamp(event_time).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921123, "o", "        'num_picks': np.sum(cluster_mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921161, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921229, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Sort by time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921289, "o", "events_df = pd.DataFrame(events)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.921362, "o", "events_df = events_df.sort_values('time')\r\n\u001b[?2004l\r\u001b[?2004h"]
