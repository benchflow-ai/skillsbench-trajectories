[360.14509, "o", "\u001b[?2004h> "]
[360.145274, "o", "            'elevation_m': row['elevation_m']\r\n\u001b[?2004l\r"]
[360.145299, "o", "\u001b[?2004h> "]
[360.145375, "o", "        }\r\n\u001b[?2004l\r"]
[360.145395, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.145419, "o", "\u001b[?2004h"]
[360.145442, "o", "> "]
[360.145623, "o", "print(f\"Unique stations: {len(station_lookup)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[360.145649, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[360.145772, "o", "print(\"\\nLoading PhaseNet model...\")\r\n\u001b[?2004l\r"]
[360.145794, "o", "\u001b[?2004h> "]
[360.146036, "o", "model = sbm.PhaseNet.from_pretrained(\"original\")\r\n\u001b[?2004l\r"]
[360.146058, "o", "\u001b[?2004h> "]
[360.146286, "o", "model.eval()  # Set to evaluation mode\r\n\u001b[?2004l\r"]
[360.146307, "o", "\u001b[?2004h> "]
[360.146545, "o", "print(\"Model loaded successfully\")\r\n\u001b[?2004l\r"]
[360.146565, "o", "\u001b[?2004h> "]
[360.146585, "o", "\r\n\u001b[?2004l\r"]
[360.146721, "o", "\u001b[?2004h> "]
[360.146782, "o", "# Group traces by station\r\n\u001b[?2004l\r"]
[360.146816, "o", "\u001b[?2004h> "]
[360.147062, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[360.147091, "o", "\u001b[?2004h> "]
[360.147306, "o", "station_streams = defaultdict(list)\r\n\u001b[?2004l\r"]
[360.147389, "o", "\u001b[?2004h> "]
[360.147436, "o", "for tr in st:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.147531, "o", "> "]
[360.147763, "o", "    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\r\n\u001b[?2004l\r"]
[360.147848, "o", "\u001b[?2004h"]
[360.147891, "o", "> "]
[360.148032, "o", "    station_streams[station_id].append(tr)\r\n\u001b[?2004l\r"]
[360.14809, "o", "\u001b[?2004h> "]
[360.14813, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.148414, "o", "print(f\"Grouped into {len(station_streams)} stations\")\r\n\u001b[?2004l\r"]
[360.148473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.148523, "o", "> "]
[360.148582, "o", "all_picks = []\r\n\u001b[?2004l\r"]
[360.148623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.148726, "o", "\u001b[?2004h> "]
[360.148927, "o", "for station_id, traces in station_streams.items():\r\n\u001b[?2004l\r"]
[360.1491, "o", "\u001b[?2004h> "]
[360.149391, "o", "    print(f\"Processing {station_id}...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.150037, "o", "        # Create stream and get components\r\n\u001b[?2004l\r\u001b[?2004h>         station_st = obspy.Stream(traces)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Get Z, N, E components\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.150418, "o", "        z_tr = station_st.select(channel=\"*Z\")[0] if len(station_st.select(channel=\"*Z\")) > 0 else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.150497, "o", "> "]
[360.150853, "o", "        n_tr = station_st.select(channel=\"*N\")[0] if len(station_st.select(channel=\"*N\")) > 0 else None\r\n\u001b[?2004l\r"]
[360.150933, "o", "\u001b[?2004h> "]
[360.151297, "o", "        e_tr = station_st.select(channel=\"*E\")[0] if len(station_st.select(channel=\"*E\")) > 0 else None\r\n\u001b[?2004l\r"]
[360.151365, "o", "\u001b[?2004h> "]
[360.151662, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         if z_tr is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.151745, "o", "            print(f\"  No Z component, skipping\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.153066, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Prepare 3-component data\r\n\u001b[?2004l\r\u001b[?2004h>         z_data = z_tr.data.astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if n_tr is not None and e_tr is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             n_data = n_tr.data.astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>             e_data = e_tr.data.astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.153166, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.153405, "o", "            # Duplicate Z if N/E not available\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.153479, "o", "            n_data = z_data.copy()\r\n\u001b[?2004l\r"]
[360.15374, "o", "\u001b[?2004h>             e_data = z_data.copy()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.15438, "o", "        # Normalize each component\r\n\u001b[?2004l\r\u001b[?2004h>         z_data = (z_data - np.mean(z_data)) / (np.std(z_data) + 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.155133, "o", "        n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h>         e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Process in windows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.155196, "o", "        window_samples = 6000  # 60 seconds at 100 Hz\r\n\u001b[?2004l\r"]
[360.155254, "o", "\u001b[?2004h> "]
[360.155394, "o", "        overlap = 3000  # 30 second overlap\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.155464, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.15549, "o", "> "]
[360.15563, "o", "        sr = z_tr.stats.sampling_rate\r\n\u001b[?2004l\r"]
[360.155652, "o", "\u001b[?2004h> "]
[360.155741, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.156114, "o", "        for start_idx in range(0, len(z_data) - window_samples + 1, window_samples - overlap):\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.156176, "o", "> "]
[360.156333, "o", "            end_idx = start_idx + window_samples\r\n\u001b[?2004l\r"]
[360.156418, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[360.156449, "o", "\u001b[?2004h> "]
[360.156556, "o", "            # Extract window\r\n\u001b[?2004l\r"]
[360.156585, "o", "\u001b[?2004h> "]
[360.156781, "o", "            z_win = z_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[360.156815, "o", "\u001b[?2004h> "]
[360.157005, "o", "            n_win = n_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[360.157041, "o", "\u001b[?2004h> "]
[360.15724, "o", "            e_win = e_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[360.157269, "o", "\u001b[?2004h> "]
[360.157342, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.157633, "o", "            # Stack into 3-channel format (channels, samples)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.15766, "o", "> "]
[360.157967, "o", "            data_3c = np.array([z_win, n_win, e_win], dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.157999, "o", "> "]
[360.158064, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.158238, "o", "            # Run model prediction\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.158267, "o", "> "]
[360.158339, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.158367, "o", "> "]
[360.158634, "o", "                # Convert to torch tensor and add batch dimension\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.15866, "o", "> "]
[360.158924, "o", "                data_tensor = torch.from_numpy(data_3c).unsqueeze(0)\r\n\u001b[?2004l\r"]
[360.15895, "o", "\u001b[?2004h> "]
[360.159019, "o", "                \r\n\u001b[?2004l\r"]
[360.159042, "o", "\u001b[?2004h> "]
[360.159166, "o", "                # Run model\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.159191, "o", "> "]
[360.15934, "o", "                with torch.no_grad():\r\n\u001b[?2004l\r"]
[360.159369, "o", "\u001b[?2004h> "]
[360.159559, "o", "                    predictions = model(data_tensor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.159583, "o", "> "]
[360.159652, "o", "                \r\n\u001b[?2004l\r"]
[360.159677, "o", "\u001b[?2004h> "]
[360.159909, "o", "                # predictions shape: (batch, 3, samples)\r\n\u001b[?2004l\r"]
[360.159931, "o", "\u001b[?2004h> "]
[360.160124, "o", "                # Channel 0: noise, 1: P, 2: S\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.160152, "o", "> "]
[360.160372, "o", "                p_prob = predictions[0, 1, :].numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.160395, "o", "> "]
[360.160614, "o", "                s_prob = predictions[0, 2, :].numpy()\r\n\u001b[?2004l\r"]
[360.160637, "o", "\u001b[?2004h> "]
[360.160708, "o", "                \r\n\u001b[?2004l\r"]
[360.160731, "o", "\u001b[?2004h> "]
[360.160928, "o", "                # Find peaks in probabilities\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.160949, "o", "> "]
[360.16114, "o", "                p_threshold = 0.3\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.161163, "o", "> "]
[360.161224, "o", "                s_threshold = 0.3\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.161246, "o", "> "]
[360.161267, "o", "                \r\n\u001b[?2004l\r"]
[360.161294, "o", "\u001b[?2004h> "]
[360.16135, "o", "                # Find P picks\r\n\u001b[?2004l\r"]
[360.161369, "o", "\u001b[?2004h> "]
[360.161541, "o", "                p_peaks, _ = find_peaks(p_prob, height=p_threshold, distance=100)  # min 1 sec apart\r\n\u001b[?2004l\r"]
[360.161563, "o", "\u001b[?2004h> "]
[360.161636, "o", "                for peak_idx in p_peaks:\r\n\u001b[?2004l\r"]
[360.161658, "o", "\u001b[?2004h> "]
[360.161747, "o", "                    # Convert to absolute time\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.161768, "o", "> "]
[360.161855, "o", "                    sample_in_trace = start_idx + peak_idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.161876, "o", "> "]
[360.161983, "o", "                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.162002, "o", "> "]
[360.162019, "o", "                    \r\n\u001b[?2004l\r"]
[360.16204, "o", "\u001b[?2004h"]
[360.16206, "o", "> "]
[360.162114, "o", "                    all_picks.append({\r\n\u001b[?2004l\r"]
[360.162132, "o", "\u001b[?2004h> "]
[360.16221, "o", "                        'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.162284, "o", "                        'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.162305, "o", "> "]
[360.162363, "o", "                        'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.162385, "o", "> "]
[360.162468, "o", "                        'probability': float(p_prob[peak_idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.16249, "o", "> "]
[360.162536, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.162584, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.162605, "o", "> "]
[360.162669, "o", "                # Find S picks\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.162687, "o", "> "]
[360.162813, "o", "                s_peaks, _ = find_peaks(s_prob, height=s_threshold, distance=100)\r\n\u001b[?2004l\r"]
[360.162835, "o", "\u001b[?2004h> "]
[360.162916, "o", "                for peak_idx in s_peaks:\r\n\u001b[?2004l\r"]
[360.162938, "o", "\u001b[?2004h> "]
[360.163034, "o", "                    sample_in_trace = start_idx + peak_idx\r\n\u001b[?2004l\r"]
[360.163054, "o", "\u001b[?2004h> "]
[360.163188, "o", "                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.163207, "o", "> "]
[360.163223, "o", "                    \r\n\u001b[?2004l\r"]
[360.163244, "o", "\u001b[?2004h"]
[360.163264, "o", "> "]
[360.163318, "o", "                    all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.163336, "o", "> "]
[360.163403, "o", "                        'station': station_id,\r\n\u001b[?2004l\r"]
[360.163424, "o", "\u001b[?2004h> "]
[360.163484, "o", "                        'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.163503, "o", "> "]
[360.163562, "o", "                        'phase': 'S',\r\n\u001b[?2004l\r"]
[360.16358, "o", "\u001b[?2004h> "]
[360.163681, "o", "                        'probability': float(s_prob[peak_idx])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.163733, "o", "                    })\r\n\u001b[?2004l\r"]
[360.163754, "o", "\u001b[?2004h> "]
[360.163808, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.163828, "o", "> "]
[360.163889, "o", "            except Exception as e:\r\n\u001b[?2004l\r"]
[360.16391, "o", "\u001b[?2004h> "]
[360.16403, "o", "                print(f\"  Error in window starting at {start_idx}: {e}\")\r\n\u001b[?2004l\r"]
[360.164052, "o", "\u001b[?2004h> "]
[360.164101, "o", "                continue\r\n\u001b[?2004l\r"]
[360.164122, "o", "\u001b[?2004h> "]
[360.164165, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.16434, "o", "        print(f\"  Found {len([p for p in all_picks if p['station'] == station_id])} picks for {station_id}\")\r\n\u001b[?2004l\r"]
[360.164362, "o", "\u001b[?2004h> "]
[360.164379, "o", "        \r\n\u001b[?2004l\r"]
[360.164425, "o", "\u001b[?2004h> "]
[360.164471, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.164576, "o", "        print(f\"  Error processing {station_id}: {e}\")\r\n\u001b[?2004l\r"]
[360.164598, "o", "\u001b[?2004h> "]
[360.164648, "o", "        import traceback\r\n\u001b[?2004l\r"]
[360.164669, "o", "\u001b[?2004h> "]
[360.164733, "o", "        traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.164753, "o", "> "]
[360.16477, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.164793, "o", "> \r\n\u001b[?2004l\r"]
[360.164815, "o", "\u001b[?2004h> "]
[360.164904, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.164923, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.164942, "o", "> "]
[360.165119, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"No picks found!\")\r\n"]
[360.16523, "o", "\u001b[?2004l\r\u001b[?2004h>     pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165288, "o", "    exit(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165363, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165478, "o", "print(f\"P picks: {len(picks_df[picks_df['phase'] == 'P'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165596, "o", "print(f\"S picks: {len(picks_df[picks_df['phase'] == 'S'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165639, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165671, "o", "# Event association\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165762, "o", "print(\"\\nAssociating picks to events...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165881, "o", "# Calculate mean station location\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.165973, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r"]
[360.16601, "o", "\u001b[?2004h> "]
[360.166104, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.16614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.166172, "o", "vp = 6.0  # km/s\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.166208, "o", "> "]
[360.166241, "o", "vs = vp / 1.75  # km/s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.166372, "o", "\u001b[?2004h> # Estimate origin times\r\n\u001b[?2004l\r\u001b[?2004h> origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.166422, "o", "for pick in all_picks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.16646, "o", "> "]
[360.166532, "o", "    station_id = pick['station']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.166589, "o", "    if station_id not in station_lookup:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.166626, "o", ">         continue\r\n\u001b[?2004l\r"]
[360.166699, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.166757, "o", "    station_info = station_lookup[station_id]\r\n\u001b[?2004l\r"]
[360.16679, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[360.166823, "o", "> "]
[360.166915, "o", "    # Calculate approximate distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.166967, "o", "    lat_diff = station_info['latitude'] - mean_lat\r\n\u001b[?2004l\r"]
[360.167004, "o", "\u001b[?2004h> "]
[360.167073, "o", "    lon_diff = station_info['longitude'] - mean_lon\r\n\u001b[?2004l\r"]
[360.167109, "o", "\u001b[?2004h> "]
[360.167178, "o", "    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.167216, "o", "> "]
[360.167289, "o", "    distance_km = distance_deg * 111.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[360.167323, "o", "\u001b[?2004h> "]
[360.167353, "o", "    # Estimate travel time\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.167389, "o", "> "]
[360.167409, "o", "    if pick['phase'] == 'P':\r\n\u001b[?2004l\r"]
[360.167432, "o", "\u001b[?2004h> "]
[360.168322, "o", "        travel_time = distance_km / vp\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         travel_time = distance_km / vs\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Back-project to origin time\r\n\u001b[?2004l\r\u001b[?2004h>     origin_time = pick['time'] - travel_time\r\n\u001b[?2004l\r\u001b[?2004h>     origin_times.append(origin_time.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Cluster origin times\r\n\u001b[?2004l\r\u001b[?2004h> origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Use DBSCAN with 5 second tolerance\r\n\u001b[?2004l\r\u001b[?2004h> dbscan = DBSCAN(eps=5.0, min_samples=4)  # require at least 4 picks\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.168427, "o", "> "]
[360.168472, "o", "cluster_labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.168594, "o", "print(f\"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.168628, "o", "\u001b[?2004h> "]
[360.168666, "o", "# Extract events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.168704, "o", "events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.168826, "o", "for cluster_id in set(cluster_labels):\r\n\u001b[?2004l\r\u001b[?2004h>     if cluster_id == -1:\r\n\u001b[?2004l\r"]
[360.168855, "o", "\u001b[?2004h> "]
[360.168877, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.1689, "o", ">     \r\n\u001b[?2004l\r"]
[360.168923, "o", "\u001b[?2004h> "]
[360.169026, "o", "    cluster_mask = cluster_labels == cluster_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.169255, "o", "    cluster_origin_times = origin_times_array[cluster_mask]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Use median origin time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.169346, "o", "    event_time = np.median(cluster_origin_times)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.169387, "o", "    events.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.169499, "o", "        'time': datetime.utcfromtimestamp(event_time).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.169543, "o", "> "]
[360.169644, "o", "        'num_picks': int(np.sum(cluster_mask))\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.169688, "o", "\u001b[?2004h> "]
[360.16973, "o", "events_df = pd.DataFrame(events)\r\n\u001b[?2004l\r"]
[360.169856, "o", "\u001b[?2004h> events_df = events_df.sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.169933, "o", "\u001b[?2004h> "]
[360.170026, "o", "print(f\"\\nFinal event count: {len(events_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.170101, "o", "print(events_df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.170156, "o", "events_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
