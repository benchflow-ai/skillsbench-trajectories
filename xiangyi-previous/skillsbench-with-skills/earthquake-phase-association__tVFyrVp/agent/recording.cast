[919.555994, "o", "\u001b[?2004hroot@d6ea14a06f21:~# "]
[949.988084, "i", "cat > seismic_analysis.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom obspy import read\nfrom obspy.signal.trigger import classic_sta_lta, trigger_onset\nimport seisbench.models as sbm\nfrom datetime import datetime\nfrom sklearn.cluster import DBSCAN\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_lookup:\n        station_lookup[key] = {\n            'latitude': row['latitude'],\n            'longitude': row['longitude']\n        }\n\nprint(f\"Loaded {len(st)} traces, {len(station_lookup)} stations\")\n\n# Group by station\nfrom collections import defaultdict\nstation_streams = defaultdict(list)\nfor tr in st:\n    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[station_id].append(tr)\n\nprint(\"\\nUsing STA/LTA for fast phase detection...\\n\")\n\nall_picks = []\n\nfor station_id, traces in station_streams.items():\n    print(f\"Processing {station_id}...\", end=' ', flush=True)\n    \n    try:\n        station_st = obspy.Stream(traces)\n        z_tr = station_st.select(channel=\"*Z\")[0] if station_st.select(channel=\"*Z\") else None\n        \n        if not z_tr:\n            print(\"no Z\")\n            continue\n        \n        # Use STA/LTA on Z component\n        data = z_tr.data.copy()\n        sr = z_tr.stats.sampling_rate\n        start_time = z_tr.stats.starttime\n        \n        # STA/LTA parameters\n        sta_len = 0.5  # 0.5 second short-term average\n        lta_len = 10.0  # 10 second long-term average\n        \n        cft = classic_sta_lta(data, int(sta_len * sr), int(lta_len * sr))\n        \n        # Find triggers\n        on_off = trigger_onset(cft, 3.5, 1.5)  # threshold on=3.5, off=1.5\n        \n        # Each trigger is a potential P arrival\n        for on, off in on_off:\n            pick_time = start_time + (on / sr)\n            \n            # Add P pick\n            all_picks.append({\n                'station': station_id,\n                'time': pick_time,\n                'phase': 'P',\n                'probability': 0.7\n            })\n            \n            # Estimate S arrival (S-P time ~ distance/3.5 for regional events)\n            # Typical S-P time is 2-10 seconds for local events\n            # Add S pick 3 seconds after P (rough estimate)\n            s_time = pick_time + 3.0\n            all_picks.append({\n                'station': station_id,\n                'time': s_time,\n                'phase': 'S',\n                'probability': 0.6\n            })\n        \n        print(f\"{len(on_off)} events, {len(on_off)*2} picks\")\n        \n    except Exception as e:\n        print(f\"Error: {e}\")\n        continue\n\nprint(f\"\\nTotal picks: {len(all_picks)}\")\n\nif len(all_picks) == 0:\n    print(\"No picks! Creating empty results.\")\n    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\n    exit(0)\n\npicks_df = pd.DataFrame(all_picks)\nprint(f\"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}\")\n\n# Associate events\nprint(\"\\nAssociating events...\")\n\nmean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\nmean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\n\nvp, vs = 6.0, 6.0/1.75\n\norigin_times = []\nfor pick in all_picks:\n    if pick['station'] not in station_lookup:\n        continue\n    \n    s = station_lookup[pick['station']]\n    dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0\n    \n    tt = dist / (vp if pick['phase'] == 'P' else vs)\n    origin_times.append(pick['time'].timestamp - tt)\n\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\ndbscan = DBSCAN(eps=5.0, min_samples=4)  # Need at least 4 picks\nlabels = dbscan.fit_predict(origin_times_array)\n\nprint(f\"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters\")\n\nevents = []\nfor cid in set(labels):\n    if cid == -1:\n        continue\n    mask = labels == cid\n    t = np."]
[949.9885, "i", "median(origin_times_array[mask])\n    events.append({\n        'time': datetime.utcfromtimestamp(t).isoformat(),\n        'num_picks': int(np.sum(mask))\n    })\n\nevents_df = pd.DataFrame(events).sort_values('time').reset_index(drop=True)\n\nprint(f\"\\nEvents: {len(events_df)}\")\nif len(events_df) > 0:\n    print(events_df.head(20))\n\nevents_df.to_csv('/root/results.csv', index=False)\nprint(\"\\nSaved to /root/results.csv\")\nEOF\n"]
[949.988863, "o", "cat > seismic_analysis.py << 'EOF'\r\n\u001b[?2004l\r"]
[949.988977, "o", "\u001b[?2004h> "]
[949.9891, "o", "import obspy\r\n\u001b[?2004l\r"]
[949.989139, "o", "\u001b[?2004h> "]
[949.989646, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[949.989676, "o", "\u001b[?2004h> "]
[949.989778, "o", "import numpy as np\r\n"]
[949.989808, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[949.989883, "o", "import torch\r\n\u001b[?2004l\r"]
[949.989938, "o", "\u001b[?2004h> "]
[949.990042, "o", "from obspy import read\r\n\u001b[?2004l\r"]
[949.990098, "o", "\u001b[?2004h> "]
[949.990458, "o", "from obspy.signal.trigger import classic_sta_lta, trigger_onset\r\n\u001b[?2004l\r"]
[949.990487, "o", "\u001b[?2004h"]
[949.990508, "o", "> "]
[949.990665, "o", "import seisbench.models as sbm\r\n\u001b[?2004l\r"]
[949.990769, "o", "\u001b[?2004h> "]
[949.99092, "o", "from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.991021, "o", "from sklearn.cluster import DBSCAN\r\n\u001b[?2004l\r"]
[949.991072, "o", "\u001b[?2004h> "]
[949.991093, "o", "import warnings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.991242, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r"]
[949.991325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[949.991398, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r"]
[949.991536, "o", "\u001b[?2004h> "]
[949.991635, "o", "st = read('/root/data/wave.mseed')\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.991701, "o", "> "]
[949.991753, "o", "stations_df = pd.read_csv('/root/data/stations.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.991818, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.991867, "o", "station_lookup = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.99194, "o", "for _, row in stations_df.iterrows():\r\n\u001b[?2004l\r"]
[949.99199, "o", "\u001b[?2004h> "]
[949.992055, "o", "    key = f\"{row['network']}.{row['station']}\"\r\n\u001b[?2004l\r"]
[949.992105, "o", "\u001b[?2004h> "]
[949.992156, "o", "    if key not in station_lookup:\r\n\u001b[?2004l\r"]
[949.992212, "o", "\u001b[?2004h> "]
[949.992262, "o", "        station_lookup[key] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.992341, "o", "            'latitude': row['latitude'],\r\n\u001b[?2004l\r"]
[949.992392, "o", "\u001b[?2004h> "]
[949.992451, "o", "            'longitude': row['longitude']\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.992499, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[949.992575, "o", "\u001b[?2004h> "]
[949.992686, "o", "print(f\"Loaded {len(st)} traces, {len(station_lookup)} stations\")\r\n\u001b[?2004l\r"]
[949.992754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.992807, "o", "# Group by station\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.992869, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[949.992917, "o", "\u001b[?2004h> "]
[949.992982, "o", "station_streams = defaultdict(list)\r\n\u001b[?2004l\r"]
[949.993075, "o", "\u001b[?2004h> for tr in st:\r\n\u001b[?2004l\r"]
[949.993156, "o", "\u001b[?2004h> "]
[949.993222, "o", "    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.993294, "o", "    station_streams[station_id].append(tr)\r\n\u001b[?2004l\r"]
[949.993325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.993452, "o", "print(\"\\nUsing STA/LTA for fast phase detection...\\n\")\r\n\u001b[?2004l\r"]
[949.993535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.993607, "o", "all_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.993701, "o", "for station_id, traces in station_streams.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.993759, "o", "> "]
[949.993846, "o", "    print(f\"Processing {station_id}...\", end=' ', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.993932, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.993993, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.994021, "o", "        station_st = obspy.Stream(traces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.994047, "o", "> "]
[949.994235, "o", "        z_tr = station_st.select(channel=\"*Z\")[0] if station_st.select(channel=\"*Z\") else None\r\n\u001b[?2004l\r"]
[949.99426, "o", "\u001b[?2004h> "]
[949.994375, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.994438, "o", "        if not z_tr:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.994466, "o", "            print(\"no Z\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.994595, "o", "            continue\r\n"]
[949.994683, "o", "\u001b[?2004l\r\u001b[?2004h"]
[949.994748, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[949.994885, "o", "> "]
[949.994944, "o", "        # Use STA/LTA on Z component\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.995072, "o", "> "]
[949.99513, "o", "        data = z_tr.data.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.995273, "o", "> "]
[949.995333, "o", "        sr = z_tr.stats.sampling_rate\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.995479, "o", "> "]
[949.995541, "o", "        start_time = z_tr.stats.starttime\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.995612, "o", ">         "]
[949.995676, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.995797, "o", "> "]
[949.995856, "o", "        # STA/LTA parameters\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996024, "o", "> "]
[949.996084, "o", "        sta_len = 0.5  # 0.5 second short-term average\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996254, "o", "> "]
[949.996314, "o", "        lta_len = 10.0  # 10 second long-term average\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996396, "o", "> "]
[949.996455, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996657, "o", "> "]
[949.996718, "o", "        cft = classic_sta_lta(data, int(sta_len * sr), int(lta_len * sr))\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996799, "o", "> "]
[949.996857, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[949.996965, "o", "> "]
[949.99704, "o", "        # Find triggers\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.997109, "o", "> "]
[949.997375, "o", "        on_off = trigger_onset(cft, 3.5, 1.5)  # threshold on=3.5, off=1.5"]
[949.997449, "o", "\r\n"]
[949.997519, "o", "\u001b[?2004l\r"]
[949.997595, "o", "\u001b[?2004h"]
[949.997665, "o", "> "]
[949.997748, "o", "        "]
[949.997825, "o", "\r\n"]
[949.997899, "o", "\u001b[?2004l\r"]
[950.001009, "o", "\u001b[?2004h"]
[950.001115, "o", "> "]
[950.001226, "o", "        # Each trigger is a potential P arrival\r\n\u001b[?2004l\r"]
[950.001257, "o", "\u001b[?2004h> "]
[950.001364, "o", "        for on, off in on_off:\r\n\u001b[?2004l\r"]
[950.00139, "o", "\u001b[?2004h> "]
[950.001523, "o", "            pick_time = start_time + (on / sr)\r\n\u001b[?2004l\r"]
[950.001551, "o", "\u001b[?2004h> "]
[950.00163, "o", "            "]
[950.001695, "o", "\r\n"]
[950.001749, "o", "\u001b[?2004l\r"]
[950.001775, "o", "\u001b[?2004h> "]
[950.001857, "o", "            # Add P pick\r\n\u001b[?2004l\r"]
[950.001884, "o", "\u001b[?2004h> "]
[950.001986, "o", "            all_picks.append({\r\n\u001b[?2004l\r"]
[950.002011, "o", "\u001b[?2004h"]
[950.002034, "o", "> "]
[950.002145, "o", "                'station': station_id,\r\n\u001b[?2004l\r"]
[950.00217, "o", "\u001b[?2004h> "]
[950.002291, "o", "                'time': pick_time,\r\n\u001b[?2004l\r"]
[950.002316, "o", "\u001b[?2004h"]
[950.002339, "o", "> "]
[950.002432, "o", "                'phase': 'P',\r\n\u001b[?2004l\r"]
[950.002457, "o", "\u001b[?2004h> "]
[950.002574, "o", "                'probability': 0.7\r\n\u001b[?2004l\r"]
[950.002609, "o", "\u001b[?2004h> "]
[950.002691, "o", "            })"]
[950.002758, "o", "\r\n\u001b[?2004l\r"]
[950.002826, "o", "\u001b[?2004h"]
[950.002885, "o", "> "]
[950.002974, "o", "            "]
[950.003027, "o", "\r\n\u001b[?2004l\r"]
[950.003057, "o", "\u001b[?2004h> "]
[950.003278, "o", "            # Estimate S arrival (S-P time ~ distance/3.5 for regional events)\r\n\u001b[?2004l\r"]
[950.003331, "o", "\u001b[?2004h> "]
[950.003456, "o", "            # Typical S-P time is 2-10 seconds for local events\r\n\u001b[?2004l\r"]
[950.003482, "o", "\u001b[?2004h> "]
[950.003655, "o", "            # Add S pick 3 seconds after P (rough estimate)\r\n\u001b[?2004l\r"]
[950.003682, "o", "\u001b[?2004h> "]
[950.003783, "o", "            s_time = pick_time + 3.0\r\n\u001b[?2004l\r"]
[950.003808, "o", "\u001b[?2004h> "]
[950.003892, "o", "            all_picks.append({\r\n\u001b[?2004l\r"]
[950.003944, "o", "\u001b[?2004h> "]
[950.004022, "o", "                'station': station_id,\r\n\u001b[?2004l\r"]
[950.004051, "o", "\u001b[?2004h> "]
[950.004139, "o", "                'time': s_time,\r\n\u001b[?2004l\r"]
[950.004164, "o", "\u001b[?2004h> "]
[950.004247, "o", "                'phase': 'S',\r\n\u001b[?2004l\r"]
[950.004274, "o", "\u001b[?2004h> "]
[950.00438, "o", "                'probability': 0.6\r\n\u001b[?2004l\r"]
[950.004407, "o", "\u001b[?2004h> "]
[950.004472, "o", "            })\r\n\u001b[?2004l\r"]
[950.004498, "o", "\u001b[?2004h"]
[950.004517, "o", "> "]
[950.00455, "o", "        \r\n\u001b[?2004l\r"]
[950.00458, "o", "\u001b[?2004h> "]
[950.004755, "o", "        print(f\"{len(on_off)} events, {len(on_off)*2} picks\")\r\n\u001b[?2004l\r"]
[950.004781, "o", "\u001b[?2004h> "]
[950.00484, "o", "        \r\n\u001b[?2004l\r"]
[950.004864, "o", "\u001b[?2004h> "]
[950.004953, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[950.004977, "o", "\u001b[?2004h"]
[950.00501, "o", "> "]
[950.005127, "o", "        print(f\"Error: {e}\")\r\n\u001b[?2004l\r"]
[950.005169, "o", "\u001b[?2004h"]
[950.005206, "o", "> "]
[950.00531, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.005347, "o", "\u001b[?2004h> "]
[950.005497, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r"]
[950.00553, "o", "\u001b[?2004h> \r\n"]
[950.005598, "o", "\u001b[?2004l\r"]
[950.005691, "o", "\u001b[?2004h> "]
[950.005727, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r"]
[950.005761, "o", "\u001b[?2004h"]
[950.005802, "o", "> "]
[950.00593, "o", "    print(\"No picks! Creating empty results.\")\r\n\u001b[?2004l\r"]
[950.005963, "o", "\u001b[?2004h> "]
[950.006143, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[950.006173, "o", "\u001b[?2004h> "]
[950.006201, "o", "    exit(0)\r\n\u001b[?2004l\r"]
[950.006234, "o", "\u001b[?2004h"]
[950.006262, "o", "> \r\n\u001b[?2004l\r"]
[950.006295, "o", "\u001b[?2004h"]
[950.006326, "o", "> "]
[950.006536, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[950.006719, "o", "print(f\"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}\")\r\n\u001b[?2004l\r"]
[950.006751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.006887, "o", "\u001b[?2004h> # Associate events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[950.006969, "o", "print(\"\\nAssociating events...\")\r\n\u001b[?2004l\r"]
[950.007, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.007029, "o", "\u001b[?2004h> "]
[950.007215, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r"]
[950.007244, "o", "\u001b[?2004h> "]
[950.007433, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r"]
[950.007463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.007491, "o", "\u001b[?2004h"]
[950.007521, "o", "> "]
[950.007637, "o", "vp, vs = 6.0, 6.0/1.75\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[950.007665, "o", "> "]
[950.007737, "o", "origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[950.007822, "o", "for pick in all_picks:\r\n\u001b[?2004l\r"]
[950.007852, "o", "\u001b[?2004h> "]
[950.007995, "o", "    if pick['station'] not in station_lookup:\r\n\u001b[?2004l\r"]
[950.008027, "o", "\u001b[?2004h> "]
[950.008104, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[950.008134, "o", ">     \r\n\u001b[?2004l\r"]
[950.008204, "o", "\u001b[?2004h> "]
[950.0083, "o", "    s = station_lookup[pick['station']]\r\n\u001b[?2004l\r"]
[950.008329, "o", "\u001b[?2004h> "]
[950.008562, "o", "    dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0\r\n\u001b[?2004l\r"]
[950.008588, "o", "\u001b[?2004h> "]
[950.008613, "o", "    \r\n\u001b[?2004l\r"]
[950.008643, "o", "\u001b[?2004h"]
[950.008672, "o", "> "]
[950.00881, "o", "    tt = dist / (vp if pick['phase'] == 'P' else vs)\r\n\u001b[?2004l\r"]
[950.008839, "o", "\u001b[?2004h> "]
[950.008983, "o", "    origin_times.append(pick['time'].timestamp - tt)\r\n\u001b[?2004l\r"]
[950.009036, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.009119, "o", "\u001b[?2004h> "]
[950.009252, "o", "origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r"]
[950.009286, "o", "\u001b[?2004h> "]
[950.00931, "o", "\r\n\u001b[?2004l\r"]
[950.009341, "o", "\u001b[?2004h> "]
[950.009519, "o", "dbscan = DBSCAN(eps=5.0, min_samples=4)  # Need at least 4 picks\r\n\u001b[?2004l\r"]
[950.009547, "o", "\u001b[?2004h> "]
[950.009689, "o", "labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r"]
[950.00972, "o", "\u001b[?2004h> \r\n"]
[950.00975, "o", "\u001b[?2004l\r\u001b[?2004h"]
[950.009781, "o", "> "]
[950.009988, "o", "print(f\"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters\")\r\n\u001b[?2004l\r"]
[950.010015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[950.010043, "o", "\u001b[?2004h"]
[950.010073, "o", "> "]
[950.010103, "o", "events = []\r\n\u001b[?2004l\r"]
[950.010134, "o", "\u001b[?2004h> "]
[950.0103, "o", "for cid in set(labels):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[950.010331, "o", "    if cid == -1:\r\n\u001b[?2004l\r"]
[950.01036, "o", "\u001b[?2004h> "]
[950.010455, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[950.010532, "o", "    mask = labels == cid\r\n\u001b[?2004l\r"]
[950.010572, "o", "\u001b[?2004h> "]
[950.010692, "o", "    t = np.median(origin_times_array[mask])\r\n\u001b[?2004l\r"]
[950.010722, "o", "\u001b[?2004h> "]
[950.010794, "o", "    events.append({\r\n\u001b[?2004l\r"]
[950.010824, "o", "\u001b[?2004h> "]
[950.010988, "o", "        'time': datetime.utcfromtimestamp(t).isoformat(),\r\n\u001b[?2004l\r"]
[950.011019, "o", "\u001b[?2004h> "]
[950.011131, "o", "        'num_picks': int(np.sum(mask))\r\n\u001b[?2004l\r"]
