[252.080927, "o", "print(f\"Loaded {len(st)} traces\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.081132, "o", "print(f\"Time range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[252.081169, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[252.081315, "o", "print(\"\\nLoading station data...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.081426, "o", "stations_df = pd.read_csv('/root/data/stations.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.081602, "o", "print(f\"Loaded {len(stations_df)} station channels\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.08168, "o", "# Create station lookup\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.081711, "o", "> "]
[252.081792, "o", "station_lookup = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.081875, "o", "for _, row in stations_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.081906, "o", "> "]
[252.08202, "o", "    key = f\"{row['network']}.{row['station']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.082055, "o", "> "]
[252.082153, "o", "    if key not in station_lookup:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.082267, "o", "        station_lookup[key] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.082428, "o", ">             'latitude': row['latitude'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.082534, "o", "            'longitude': row['longitude'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.082733, "o", "> "]
[252.082806, "o", "            'elevation_m': row['elevation_m']\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[252.082961, "o", "print(f\"Unique stations: {len(station_lookup)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rS"]
[252.082991, "o", "\u001b[?2004h> "]
[252.083075, "o", "print(\"\\nLoading PhaseNet model...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.083096, "o", "> "]
[252.083238, "o", "model = sbm.PhaseNet.from_pretrained(\"original\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.083347, "o", "print(\"Model loaded successfully\")\r\n\u001b[?2004l\rt\u001b[?2004h"]
[252.083374, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[252.083453, "o", "# Group traces by station\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.083541, "o", "> "]
[252.083695, "o", "from collections import defaultdict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.083789, "o", "station_streams = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.083907, "o", "for tr in st:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.083977, "o", "    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.08419, "o", "    station_streams[station_id].append(tr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.084315, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.084434, "o", "print(f\"Grouped into {len(station_streams)} stations\")\r\n\u001b[?2004l\r"]
[252.084455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.084474, "o", "> "]
[252.08454, "o", "all_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[252.08456, "o", "\u001b[?2004h> "]
[252.084725, "o", "for station_id, traces in station_streams.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.084828, "o", "    print(f\"Processing {station_id}...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.08485, "o", ">     \r\n\u001b[?2004l\r"]
[252.084871, "o", "\u001b[?2004h> "]
[252.084939, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.097646, "o", "        # Create stream and get components\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.097731, "o", "> "]
[252.09805, "o", "        station_st = obspy.Stream(traces)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.098079, "o", "> "]
[252.098304, "o", "        # Get Z, N, E components\r\n\u001b[?2004l\r"]
[252.098333, "o", "\u001b[?2004h"]
[252.098486, "o", "> "]
[252.09906, "o", "        z_tr = station_st.select(channel=\"*Z\")[0] if len(station_st.select(channel=\"*Z\")) > 0 else None\r\n\u001b[?2004l\r"]
[252.099091, "o", "\u001b[?2004h> "]
[252.099678, "o", "        n_tr = station_st.select(channel=\"*N\")[0] if len(station_st.select(channel=\"*N\")) > 0 else None\r\n\u001b[?2004l\r"]
[252.099709, "o", "\u001b[?2004h> "]
[252.100241, "o", "        e_tr = station_st.select(channel=\"*E\")[0] if len(station_st.select(channel=\"*E\")) > 0 else None\r\n\u001b[?2004l\r"]
[252.100295, "o", "\u001b[?2004h> "]
[252.100384, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.10062, "o", "        if z_tr is None:\r\n\u001b[?2004l\r"]
[252.100674, "o", "\u001b[?2004h"]
[252.100709, "o", "> "]
[252.100967, "o", "            print(f\"  No Z component, skipping\")\r\n\u001b[?2004l\r"]
[252.101011, "o", "\u001b[?2004h"]
[252.101038, "o", "> "]
[252.101192, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.10127, "o", "        \r\n\u001b[?2004l\r"]
[252.101298, "o", "\u001b[?2004h> "]
[252.101576, "o", "        # Prepare 3-component data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.101801, "o", "        z_data = z_tr.data.astype(np.float32)\r\n\u001b[?2004l\r"]
[252.101833, "o", "\u001b[?2004h> "]
[252.101915, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.101941, "o", "> "]
[252.102214, "o", "        if n_tr is not None and e_tr is not None:\r\n\u001b[?2004l\r"]
[252.102246, "o", "\u001b[?2004h> "]
[252.102539, "o", "            n_data = n_tr.data.astype(np.float32)\r\n\u001b[?2004l\r"]
[252.102573, "o", "\u001b[?2004h> "]
[252.102868, "o", "            e_data = e_tr.data.astype(np.float32)\r\n\u001b[?2004l\r"]
[252.102901, "o", "\u001b[?2004h> "]
[252.103028, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.103063, "o", "> "]
[252.103333, "o", "            # Duplicate Z if N/E not available\r\n\u001b[?2004l\r"]
[252.103365, "o", "\u001b[?2004h> "]
[252.103573, "o", "            n_data = z_data.copy()\r\n\u001b[?2004l\r"]
[252.103602, "o", "\u001b[?2004h"]
[252.103629, "o", "> "]
[252.103835, "o", "            e_data = z_data.copy()\r\n\u001b[?2004l\r"]
[252.103864, "o", "\u001b[?2004h> "]
[252.103967, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.104162, "o", "        # Normalize each component\r\n\u001b[?2004l\r"]
[252.104191, "o", "\u001b[?2004h> "]
[252.10459, "o", "        z_data = (z_data - np.mean(z_data)) / (np.std(z_data) + 1e-10)\r\n\u001b[?2004l\r"]
[252.104618, "o", "\u001b[?2004h> "]
[252.104981, "o", "        n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)\r\n\u001b[?2004l\r"]
[252.105029, "o", "\u001b[?2004h> "]
[252.105336, "o", "        e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)\r\n\u001b[?2004l\r"]
[252.105365, "o", "\u001b[?2004h> "]
[252.105475, "o", "        \r\n\u001b[?2004l\r \u001b[?2004h> "]
[252.105828, "o", "        # Process in windows (PhaseNet expects 3001 samples = 30 seconds at 100 Hz)\r\n"]
[252.105857, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[252.106057, "o", "        window_samples = 6000  # 60 seconds\r\n\u001b[?2004l\r"]
[252.106085, "o", "\u001b[?2004h> "]
[252.106247, "o", "        overlap = 3000  # 30 second overlap\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.10627, "o", "> "]
[252.106376, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.106545, "o", "        sr = z_tr.stats.sampling_rate\r\n\u001b[?2004l\r"]
[252.106573, "o", "\u001b[?2004h> "]
[252.106674, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.107088, "o", "        for start_idx in range(0, len(z_data) - window_samples + 1, window_samples - overlap):\r\n\u001b[?2004l\r"]
[252.107117, "o", "\u001b[?2004h> "]
[252.107348, "o", "            end_idx = start_idx + window_samples\r\n\u001b[?2004l\r"]
[252.107378, "o", "\u001b[?2004h> "]
[252.107517, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.107614, "o", "            # Extract window\r\n\u001b[?2004l\r"]
[252.107643, "o", "\u001b[?2004h> "]
[252.10787, "o", "            z_win = z_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[252.1079, "o", "\u001b[?2004h> "]
[252.108124, "o", "            n_win = n_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[252.108157, "o", "\u001b[?2004h> "]
[252.108364, "o", "            e_win = e_data[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[252.108394, "o", "\u001b[?2004h> "]
[252.108508, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.108787, "o", "            # Stack into 3-channel format (channels, samples)\r\n\u001b[?2004l\r"]
[252.108822, "o", "\u001b[?2004h> "]
[252.109146, "o", "            data_3c = np.array([z_win, n_win, e_win])\r\n\u001b[?2004l\r"]
[252.109179, "o", "\u001b[?2004h> "]
[252.109306, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.109334, "o", "> "]
[252.109575, "o", "            # Run model prediction\r\n\u001b[?2004l\r"]
[252.10961, "o", "\u001b[?2004h> "]
[252.109755, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.109787, "o", "> "]
[252.110145, "o", "                # Model expects (batch, channels, samples)\r\n\u001b[?2004l\r"]
[252.11018, "o", "\u001b[?2004h"]
[252.11021, "o", "> "]
[252.110633, "o", "                predictions = model(data_3c[np.newaxis, :, :])\r\n\u001b[?2004l\r"]
[252.11067, "o", "\u001b[?2004h> "]
[252.110814, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.11117, "o", "                # predictions shape: (batch, 3, samples)\r\n\u001b[?2004l\r"]
[252.111201, "o", "\u001b[?2004h> "]
[252.111523, "o", "                # Channel 0: noise, 1: P, 2: S\r\n\u001b[?2004l\r"]
[252.111558, "o", "\u001b[?2004h> "]
[252.111957, "o", "                p_prob = predictions[0, 1, :].detach().numpy()\r\n\u001b[?2004l\r"]
[252.111998, "o", "\u001b[?2004h> "]
[252.112351, "o", "                s_prob = predictions[0, 2, :].detach().numpy()\r\n\u001b[?2004l\r"]
[252.11238, "o", "\u001b[?2004h> "]
[252.112592, "o", "                \r\n\u001b[?2004l\r"]
[252.112675, "o", "\u001b[?2004h> "]
[252.112892, "o", "                # Find peaks in probabilities\r\n\u001b[?2004l\r"]
[252.112924, "o", "\u001b[?2004h"]
[252.112953, "o", "> "]
[252.11312, "o", "                p_threshold = 0.3\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.113155, "o", "> "]
[252.113277, "o", "                s_threshold = 0.3\r\n\u001b[?2004l\r"]
[252.113309, "o", "\u001b[?2004h> "]
[252.113439, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.113528, "o", "                # Find P picks\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.113559, "o", "> "]
[252.11381, "o", "                p_peaks, p_props = find_peaks(p_prob, height=p_threshold, distance=100)  # min 1 sec apart\r\n"]
[252.113846, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[252.113988, "o", "                for peak_idx in p_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.114092, "o", "                    # Convert to absolute time\r\n\u001b[?2004l\r"]
[252.114123, "o", "\u001b[?2004h> "]
[252.114268, "o", "                    sample_in_trace = start_idx + peak_idx\r\n"]
[252.114302, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[252.114489, "o", "                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\r\n"]
[252.114522, "o", "\u001b[?2004l\r\u001b[?2004h"]
[252.114552, "o", "> "]
[252.114721, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.114755, "o", "                    all_picks.append({\r\n\u001b[?2004l\r"]
[252.114783, "o", "\u001b[?2004h> "]
[252.114939, "o", "                        'station': station_id,\r\n\u001b[?2004l\r"]
[252.11497, "o", "\u001b[?2004h> "]
[252.115112, "o", "                        'time': pick_time,\r\n"]
[252.115145, "o", "\u001b[?2004l\r\u001b[?2004h"]
[252.115173, "o", "> "]
[252.115328, "o", "                        'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115491, "o", "                        'probability': p_prob[peak_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115588, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115678, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115805, "o", "                # Find S picks\r\n"]
[252.115833, "o", "\u001b[?2004l\r\u001b[?2004h"]
[252.115863, "o", "> "]
[252.116097, "o", "                s_peaks, s_props = find_peaks(s_prob, height=s_threshold, distance=100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.116129, "o", "> "]
[252.116264, "o", "                for peak_idx in s_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.116442, "o", "                    sample_in_trace = start_idx + peak_idx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.116635, "o", "                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.116667, "o", "> "]
[252.116698, "o", "                    \r\n\u001b[?2004l\r"]
[252.116729, "o", "\u001b[?2004h> "]
[252.116924, "o", "                    all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117044, "o", "                        'station': station_id,\r\n\u001b[?2004l\r"]
[252.117078, "o", "\u001b[?2004h> "]
[252.117202, "o", "                        'time': pick_time,\r\n\u001b[?2004l\r"]
[252.117236, "o", "\u001b[?2004h> "]
[252.117357, "o", "                        'phase': 'S',\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.117388, "o", "> "]
[252.117522, "o", "                        'probability': s_prob[peak_idx]\r\n\u001b[?2004l\r"]
[252.117554, "o", "\u001b[?2004h> "]
[252.117669, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117716, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.117752, "o", "> "]
[252.117913, "o", "            except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.118105, "o", "                print(f\"  Error in window starting at {start_idx}: {e}\")\r\n\u001b[?2004l\r"]
[252.11822, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r"]
[252.118316, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.118414, "o", "> "]
[252.118506, "o", "        print(f\"  Found picks for {station_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.118603, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.118695, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.118874, "o", "        print(f\"  Error processing {station_id}: {e}\")\r\n\u001b[?2004l\r"]
[252.118979, "o", "\u001b[?2004h>         import traceback\r\n\u001b[?2004l\r"]
[252.11907, "o", "\u001b[?2004h> "]
[252.119158, "o", "        traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.119254, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.119343, "o", "> "]
[252.119446, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.119544, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.119641, "o", "    print(\"No picks found!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.119824, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[252.119916, "o", "\u001b[?2004h>     exit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.120007, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.120097, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.120189, "o", "> "]
[252.120281, "o", "print(f\"P picks: {len(picks_df[picks_df['phase'] == 'P'])}\")\r\n\u001b[?2004l\r"]
[252.120371, "o", "\u001b[?2004h> "]
[252.120466, "o", "print(f\"S picks: {len(picks_df[picks_df['phase'] == 'S'])}\")\r\n\u001b[?2004l\r"]
[252.12056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.120653, "o", "# Event association\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.120744, "o", "print(\"\\nAssociating picks to events...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[252.120834, "o", "\u001b[?2004h> "]
[252.120926, "o", "# Calculate mean station location\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121218, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121357, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121471, "o", "vp = 6.0  # km/s\r\n\u001b[?2004l\r\u001b[?2004h> vs = vp / 1.75  # km/s\r\n\u001b[?2004l\r"]
[252.121562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121656, "o", "# Estimate origin times\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.12175, "o", "origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121842, "o", "for pick in all_picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.121938, "o", "    station_id = pick['station']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.122054, "o", "    if station_id not in station_lookup:\r\n\u001b[?2004l\r"]
[252.122151, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.122243, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.122332, "o", "    station_info = station_lookup[station_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.12243, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.122523, "o", "    # Calculate approximate distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.122635, "o", "    lat_diff = station_info['latitude'] - mean_lat\r\n\u001b[?2004l\r"]
[252.122729, "o", "\u001b[?2004h> "]
[252.122819, "o", "    lon_diff = station_info['longitude'] - mean_lon\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.122947, "o", "    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\r\n\u001b[?2004l\r"]
[252.123043, "o", "\u001b[?2004h> "]
[252.123136, "o", "    distance_km = distance_deg * 111.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123229, "o", "    # Estimate travel time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123317, "o", "    if pick['phase'] == 'P':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123428, "o", "        travel_time = distance_km / vp\r\n\u001b[?2004l\r"]
[252.123521, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123608, "o", "        travel_time = distance_km / vs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123701, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123817, "o", "    # Back-project to origin time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.123937, "o", "    origin_time = pick['time'] - travel_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.124053, "o", "    origin_times.append(origin_time.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.124167, "o", "# Cluster origin times\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.12428, "o", "origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.124392, "o", "# Use DBSCAN with 5 second tolerance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.124534, "o", "dbscan = DBSCAN(eps=5.0, min_samples=4)  # require at least 4 picks\r\n\u001b[?2004l\r"]
[252.124646, "o", "\u001b[?2004h> "]
[252.12477, "o", "cluster_labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.124928, "o", "print(f\"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters\")\r\n\u001b[?2004l\r"]
[252.129072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract events\r\n\u001b[?2004l\r\u001b[?2004h> events = []\r\n\u001b[?2004l\r\u001b[?2004h> for cluster_id in set(cluster_labels):\r\n\u001b[?2004l\r\u001b[?2004h>     if cluster_id == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     cluster_mask = cluster_labels == cluster_id\r\n\u001b[?2004l\r\u001b[?2004h>     cluster_origin_times = origin_times_array[cluster_mask]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Use median origin time\r\n\u001b[?2004l\r\u001b[?2004h>     event_time = np.median(cluster_origin_times)\r\n\u001b[?2004l\r\u001b[?2004h>     events.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'time': datetime.utcfromtimestamp(event_time).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h>         'num_picks': int(np.sum(cluster_mask))\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events_df = pd.DataFrame(events)\r\n\u001b[?2004l\r\u001b[?2004h> events_df = events_df.sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nFinal event count: {len(events_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(events_df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nResults saved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@d6ea14a06f21:~# "]
[258.589755, "i", "python3 seismic_analysis.py\n"]
[258.590049, "o", "python3 seismic_analysis.py\r\n\u001b[?2004l\r"]
