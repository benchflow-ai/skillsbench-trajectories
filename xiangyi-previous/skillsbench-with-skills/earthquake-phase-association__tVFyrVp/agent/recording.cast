[720.602122, "o", "            # Predict\r\n\u001b[?2004l\r"]
[720.602191, "o", "\u001b[?2004h> "]
[720.602261, "o", "            with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.602348, "o", "> "]
[720.602426, "o", "                pred = model(data_t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.602512, "o", "> "]
[720.6026, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.60268, "o", "            p_prob = pred[0, 1, :].numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.602769, "o", "> "]
[720.602847, "o", "            s_prob = pred[0, 2, :].numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.602932, "o", ">             "]
[720.602981, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.603082, "o", "            # Find peaks\r\n\u001b[?2004l\r"]
[720.603165, "o", "\u001b[?2004h> "]
[720.603252, "o", "            p_peaks, _ = find_peaks(p_prob, height=0.5, distance=50)\r\n\u001b[?2004l\r"]
[720.603346, "o", "\u001b[?2004h> "]
[720.603488, "o", "            s_peaks, _ = find_peaks(s_prob, height=0.5, distance=50)\r\n"]
[720.603581, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[720.603673, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.603767, "o", "            # Convert to absolute time\r\n\u001b[?2004l\r"]
[720.603853, "o", "\u001b[?2004h> "]
[720.603942, "o", "            for pk in p_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.604032, "o", "                sample = i + pk\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.604127, "o", "> "]
[720.604217, "o", "                if sample < len(z):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.604301, "o", "                    t = start_time + (sample / sr)\r\n\u001b[?2004l\r"]
[720.604384, "o", "\u001b[?2004h> "]
[720.604476, "o", "                    station_picks.append({\r\n\u001b[?2004l\r"]
[720.604566, "o", "\u001b[?2004h> "]
[720.604722, "o", "                        'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.604831, "o", "                        'time': t,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.604935, "o", "                        'phase': 'P',\r\n\u001b[?2004l\r"]
[720.605033, "o", "\u001b[?2004h> "]
[720.605152, "o", "                        'probability': float(p_prob[pk])\r\n\u001b[?2004l\r"]
[720.605221, "o", "\u001b[?2004h> "]
[720.605363, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[720.605499, "o", "> "]
[720.605531, "o", "            for pk in s_peaks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.605593, "o", "                sample = i + pk\r\n\u001b[?2004l\r"]
[720.605745, "o", "\u001b[?2004h> "]
[720.605913, "o", "                if sample < len(z):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.605957, "o", "                    t = start_time + (sample / sr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.606084, "o", "                    station_picks.append({\r\n\u001b[?2004l\r"]
[720.606172, "o", "\u001b[?2004h> "]
[720.606252, "o", "                        'station': station_id,\r\n\u001b[?2004l\r"]
[720.606329, "o", "\u001b[?2004h> "]
[720.606407, "o", "                        'time': t,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.606476, "o", "                        'phase': 'S',\r\n\u001b[?2004l\r"]
[720.60657, "o", "\u001b[?2004h> "]
[720.606658, "o", "                        'probability': float(s_prob[pk])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.606725, "o", "                    })\r\n\u001b[?2004l\r"]
[720.606817, "o", "\u001b[?2004h>         \r\n"]
[720.606913, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[720.607008, "o", "        # Remove duplicates (from overlapping windows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.607095, "o", "        if station_picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.607197, "o", "            df_temp = pd.DataFrame(station_picks)\r\n\u001b[?2004l\r"]
[720.607267, "o", "\u001b[?2004h> "]
[720.607377, "o", "            df_temp['timestamp'] = df_temp['time'].apply(lambda x: x.timestamp)\r\n\u001b[?2004l\r"]
[720.607473, "o", "\u001b[?2004h> "]
[720.607552, "o", "            df_temp = df_temp.sort_values('timestamp')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.60762, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.607736, "o", "            # Keep picks at least 1 second apart\r\n\u001b[?2004l\r"]
[720.607826, "o", "\u001b[?2004h> "]
[720.607916, "o", "            filtered = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.608005, "o", "            last_p_time = -999\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.608093, "o", "            last_s_time = -999\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.60818, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.608268, "o", "            for _, row in df_temp.iterrows():\r\n\u001b[?2004l\r"]
[720.608317, "o", "\u001b[?2004h> "]
[720.608432, "o", "                if row['phase'] == 'P':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.608531, "o", "                    if row['timestamp'] - last_p_time > 1.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.608657, "o", "                        filtered.append(row.to_dict())\r\n\u001b[?2004l\r"]
[720.608745, "o", "\u001b[?2004h> "]
[720.608842, "o", "                        last_p_time = row['timestamp']\r\n\u001b[?2004l\r"]
[720.60891, "o", "\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.609017, "o", "> "]
[720.609102, "o", "                    if row['timestamp'] - last_s_time > 1.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.609221, "o", "                        filtered.append(row.to_dict())\r\n"]
[720.609294, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[720.609391, "o", "                        last_s_time = row['timestamp']\r\n\u001b[?2004l\r"]
[720.609439, "o", "\u001b[?2004h> "]
[720.609543, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.609622, "o", "            all_picks.extend(filtered)\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.60967, "o", "> "]
[720.609772, "o", "            print(f\"{len(filtered)} picks\")\r\n\u001b[?2004l\r"]
[720.609855, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.609943, "o", "            print(\"0 picks\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610018, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610107, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610197, "o", "        print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610307, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610425, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r"]
[720.610512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610603, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610697, "o", "    print(\"No picks! Creating empty results.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.610818, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[720.610902, "o", "\u001b[?2004h> "]
[720.610996, "o", "    exit(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.611082, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.61126, "o", "print(f\"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}\")\r\n"]
[720.611348, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[720.611444, "o", "\u001b[?2004h> # Associate events\r\n\u001b[?2004l\r\u001b[?2004h"]
[720.611531, "o", "> print(\"\\nAssociating events...\")"]
[720.611626, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.611773, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])"]
[720.611861, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.612001, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n"]
[720.612048, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[720.612149, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[720.612224, "o", "vp, vs = 6.0, 6.0/1.75\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[720.612311, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[720.612367, "o", "origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[720.612414, "o", "for pick in all_picks:\r\n\u001b[?2004l\r"]
[720.612546, "o", "\u001b[?2004h> "]
[720.612591, "o", "    if pick['station'] not in station_lookup:\r\n\u001b[?2004l\r"]
[720.612699, "o", "\u001b[?2004h> "]
[720.612792, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[720.617012, "o", "> "]
[720.617136, "o", "    s = station_lookup[pick['station']]\r\n\u001b[?2004l\r\u001b[?2004h>     dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     tt = dist / (vp if pick['phase'] == 'P' else vs)\r\n\u001b[?2004l\r\u001b[?2004h>     origin_times.append(pick['time'].timestamp - tt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dbscan = DBSCAN(eps=5.0, min_samples=3)\r\n\u001b[?2004l\r\u001b[?2004h> labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events = []\r\n\u001b[?2004l\r\u001b[?2004h> for cid in set(labels):\r\n\u001b[?2004l\r\u001b[?2004h>     if cid == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     mask = labels == cid\r\n\u001b[?2004l\r\u001b[?2004h>     t = np.median(origin_times_array[mask])\r\n\u001b[?2004l\r\u001b[?2004h>     events.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'time': datetime.utcfromtimestamp(t).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h>         'num_picks': int(np.sum(mask))\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events_df = pd.DataFrame(events).sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nEvents: {len(events_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(events_df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> events_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSaved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
