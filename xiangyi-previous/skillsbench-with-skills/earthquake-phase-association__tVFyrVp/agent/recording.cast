[972.710661, "o", "\u001b[?2004hroot@d6ea14a06f21:~# "]
[1004.105541, "i", "cat > seismic_analysis.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import read\nfrom obspy.signal.trigger import classic_sta_lta, trigger_onset\nfrom datetime import datetime\nfrom sklearn.cluster import DBSCAN\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_lookup:\n        station_lookup[key] = {\n            'latitude': row['latitude'],\n            'longitude': row['longitude']\n        }\n\nprint(f\"Loaded {len(st)} traces, {len(station_lookup)} stations\")\n\n# Calculate mean location\nmean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\nmean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\n\n# Group by station\nfrom collections import defaultdict\nstation_streams = defaultdict(list)\nfor tr in st:\n    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[station_id].append(tr)\n\nprint(\"\\nUsing STA/LTA for phase detection...\\n\")\n\nall_picks = []\n\nfor station_id, traces in station_streams.items():\n    print(f\"Processing {station_id}...\", end=' ', flush=True)\n    \n    try:\n        station_st = obspy.Stream(traces)\n        z_tr = station_st.select(channel=\"*Z\")[0] if station_st.select(channel=\"*Z\") else None\n        \n        if not z_tr:\n            print(\"no Z\")\n            continue\n        \n        # Get station distance from mean location\n        if station_id in station_lookup:\n            s = station_lookup[station_id]\n            dist_deg = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2)\n            dist_km = dist_deg * 111.0\n        else:\n            dist_km = 30.0  # default\n        \n        # Estimate S-P time based on distance\n        vp, vs = 6.0, 6.0/1.75\n        sp_time = dist_km * (1/vs - 1/vp)  # S-P travel time difference\n        sp_time = max(1.0, min(sp_time, 8.0))  # Clamp between 1-8 seconds\n        \n        data = z_tr.data.copy()\n        sr = z_tr.stats.sampling_rate\n        start_time = z_tr.stats.starttime\n        \n        # STA/LTA parameters - more conservative\n        sta_len = 0.5\n        lta_len = 15.0\n        \n        cft = classic_sta_lta(data, int(sta_len * sr), int(lta_len * sr))\n        \n        # Higher threshold to reduce false positives\n        on_off = trigger_onset(cft, 4.0, 1.5)\n        \n        for on, off in on_off:\n            pick_time = start_time + (on / sr)\n            \n            # P pick\n            all_picks.append({\n                'station': station_id,\n                'time': pick_time,\n                'phase': 'P',\n                'probability': 0.7\n            })\n            \n            # S pick with distance-based timing\n            s_time = pick_time + sp_time\n            all_picks.append({\n                'station': station_id,\n                'time': s_time,\n                'phase': 'S',\n                'probability': 0.6\n            })\n        \n        print(f\"{len(on_off)} triggers\")\n        \n    except Exception as e:\n        print(f\"Error: {e}\")\n        continue\n\nprint(f\"\\nTotal picks: {len(all_picks)}\")\n\nif len(all_picks) == 0:\n    print(\"No picks! Creating empty results.\")\n    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\n    exit(0)\n\npicks_df = pd.DataFrame(all_picks)\nprint(f\"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}\")\n\n# Associate events\nprint(\"\\nAssociating events...\")\n\norigin_times = []\nfor pick in all_picks:\n    if pick['station'] not in station_lookup:\n        continue\n    \n    s = station_lookup[pick['station']]\n    dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0\n    \n    tt = dist / (vp if pick['phase'] == 'P' else vs)\n    origin_times.append(pick['time'].timestamp - tt)\n\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\n# Require at least 6 picks (3 stations with P+S)\ndbscan = DBSCAN(eps=5.0, min_samples=6)\n"]
[1004.10574, "i", "labels = dbscan.fit_predict(origin_times_array)\n\nprint(f\"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters\")\n\nevents = []\nfor cid in set(labels):\n    if cid == -1:\n        continue\n    mask = labels == cid\n    t = np.median(origin_times_array[mask])\n    n_picks = int(np.sum(mask))\n    \n    # Only keep events with sufficient picks\n    if n_picks >= 6:\n        events.append({\n            'time': datetime.utcfromtimestamp(t).isoformat(),\n            'num_picks': n_picks\n        })\n\nevents_df = pd.DataFrame(events).sort_values('time').reset_index(drop=True)\n\nprint(f\"\\nEvents: {len(events_df)}\")\nif len(events_df) > 0:\n    print(events_df.head(20))\n\nevents_df.to_csv('/root/results.csv', index=False)\nprint(\"\\nSaved to /root/results.csv\")\nEOF\n"]
