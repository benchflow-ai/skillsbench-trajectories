[252.079174, "i", "cat > seismic_analysis.py << 'EOF'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import read, UTCDateTime\nimport seisbench.models as sbm\nfrom datetime import datetime\nfrom sklearn.cluster import DBSCAN\nfrom scipy.signal import find_peaks\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading waveform data...\")\nst = read('/root/data/wave.mseed')\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Time range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\n\nprint(\"\\nLoading station data...\")\nstations_df = pd.read_csv('/root/data/stations.csv')\nprint(f\"Loaded {len(stations_df)} station channels\")\n\n# Create station lookup\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_lookup:\n        station_lookup[key] = {\n            'latitude': row['latitude'],\n            'longitude': row['longitude'],\n            'elevation_m': row['elevation_m']\n        }\n\nprint(f\"Unique stations: {len(station_lookup)}\")\n\nprint(\"\\nLoading PhaseNet model...\")\nmodel = sbm.PhaseNet.from_pretrained(\"original\")\nprint(\"Model loaded successfully\")\n\n# Group traces by station\nfrom collections import defaultdict\nstation_streams = defaultdict(list)\nfor tr in st:\n    station_id = f\"{tr.stats.network}.{tr.stats.station}\"\n    station_streams[station_id].append(tr)\n\nprint(f\"Grouped into {len(station_streams)} stations\")\n\nall_picks = []\n\nfor station_id, traces in station_streams.items():\n    print(f\"Processing {station_id}...\")\n    \n    try:\n        # Create stream and get components\n        station_st = obspy.Stream(traces)\n        \n        # Get Z, N, E components\n        z_tr = station_st.select(channel=\"*Z\")[0] if len(station_st.select(channel=\"*Z\")) > 0 else None\n        n_tr = station_st.select(channel=\"*N\")[0] if len(station_st.select(channel=\"*N\")) > 0 else None\n        e_tr = station_st.select(channel=\"*E\")[0] if len(station_st.select(channel=\"*E\")) > 0 else None\n        \n        if z_tr is None:\n            print(f\"  No Z component, skipping\")\n            continue\n        \n        # Prepare 3-component data\n        z_data = z_tr.data.astype(np.float32)\n        \n        if n_tr is not None and e_tr is not None:\n            n_data = n_tr.data.astype(np.float32)\n            e_data = e_tr.data.astype(np.float32)\n        else:\n            # Duplicate Z if N/E not available\n            n_data = z_data.copy()\n            e_data = z_data.copy()\n        \n        # Normalize each component\n        z_data = (z_data - np.mean(z_data)) / (np.std(z_data) + 1e-10)\n        n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)\n        e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)\n        \n        # Process in windows (PhaseNet expects 3001 samples = 30 seconds at 100 Hz)\n        window_samples = 6000  # 60 seconds\n        overlap = 3000  # 30 second overlap\n        \n        sr = z_tr.stats.sampling_rate\n        \n        for start_idx in range(0, len(z_data) - window_samples + 1, window_samples - overlap):\n            end_idx = start_idx + window_samples\n            \n            # Extract window\n            z_win = z_data[start_idx:end_idx]\n            n_win = n_data[start_idx:end_idx]\n            e_win = e_data[start_idx:end_idx]\n            \n            # Stack into 3-channel format (channels, samples)\n            data_3c = np.array([z_win, n_win, e_win])\n            \n            # Run model prediction\n            try:\n                # Model expects (batch, channels, samples)\n                predictions = model(data_3c[np.newaxis, :, :])\n                \n                # predictions shape: (batch, 3, samples)\n                # Channel 0: noise, 1: P, 2: S\n                p_prob = predictions[0, 1, :].detach().numpy()\n                s_prob = predictions[0, 2, :].detach().numpy()\n                \n                # Find peaks in probabilities\n                p_threshold = 0.3\n                s_threshold = 0.3\n                \n                # Find P picks\n                p_peaks, p_props = find_peaks(p_prob, height=p_threshold, distance=100)  "]
[252.079255, "i", "# min 1 sec apart\n                for peak_idx in p_peaks:\n                    # Convert to absolute time\n                    sample_in_trace = start_idx + peak_idx\n                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\n                    \n                    all_picks.append({\n                        'station': station_id,\n                        'time': pick_time,\n                        'phase': 'P',\n                        'probability': p_prob[peak_idx]\n                    })\n                \n                # Find S picks\n                s_peaks, s_props = find_peaks(s_prob, height=s_threshold, distance=100)\n                for peak_idx in s_peaks:\n                    sample_in_trace = start_idx + peak_idx\n                    pick_time = z_tr.stats.starttime + (sample_in_trace / sr)\n                    \n                    all_picks.append({\n                        'station': station_id,\n                        'time': pick_time,\n                        'phase': 'S',\n                        'probability': s_prob[peak_idx]\n                    })\n                    \n            except Exception as e:\n                print(f\"  Error in window starting at {start_idx}: {e}\")\n                continue\n        \n        print(f\"  Found picks for {station_id}\")\n        \n    except Exception as e:\n        print(f\"  Error processing {station_id}: {e}\")\n        import traceback\n        traceback.print_exc()\n        continue\n\nprint(f\"\\nTotal picks: {len(all_picks)}\")\n\nif len(all_picks) == 0:\n    print(\"No picks found!\")\n    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\n    exit(0)\n\npicks_df = pd.DataFrame(all_picks)\nprint(f\"P picks: {len(picks_df[picks_df['phase'] == 'P'])}\")\nprint(f\"S picks: {len(picks_df[picks_df['phase'] == 'S'])}\")\n\n# Event association\nprint(\"\\nAssociating picks to events...\")\n\n# Calculate mean station location\nmean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\nmean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\n\nvp = 6.0  # km/s\nvs = vp / 1.75  # km/s\n\n# Estimate origin times\norigin_times = []\nfor pick in all_picks:\n    station_id = pick['station']\n    if station_id not in station_lookup:\n        continue\n    \n    station_info = station_lookup[station_id]\n    \n    # Calculate approximate distance\n    lat_diff = station_info['latitude'] - mean_lat\n    lon_diff = station_info['longitude'] - mean_lon\n    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\n    distance_km = distance_deg * 111.0\n    \n    # Estimate travel time\n    if pick['phase'] == 'P':\n        travel_time = distance_km / vp\n    else:\n        travel_time = distance_km / vs\n    \n    # Back-project to origin time\n    origin_time = pick['time'] - travel_time\n    origin_times.append(origin_time.timestamp)\n\n# Cluster origin times\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\n# Use DBSCAN with 5 second tolerance\ndbscan = DBSCAN(eps=5.0, min_samples=4)  # require at least 4 picks\ncluster_labels = dbscan.fit_predict(origin_times_array)\n\nprint(f\"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters\")\n\n# Extract events\nevents = []\nfor cluster_id in set(cluster_labels):\n    if cluster_id == -1:\n        continue\n    \n    cluster_mask = cluster_labels == cluster_id\n    cluster_origin_times = origin_times_array[cluster_mask]\n    \n    # Use median origin time\n    event_time = np.median(cluster_origin_times)\n    events.append({\n        'time': datetime.utcfromtimestamp(event_time).isoformat(),\n        'num_picks': int(np.sum(cluster_mask))\n    })\n\nevents_df = pd.DataFrame(events)\nevents_df = events_df.sort_values('time').reset_index(drop=True)\n\nprint(f\"\\nFinal event count: {len(events_df)}\")\nprint(events_df)\n\nevents_df.to_csv('/root/results.csv', index=False)\nprint(\"\\nResults saved to /root/results.csv\")\nEOF\n"]
