[593.649632, "o", "    station_streams[station_id].append(tr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.649656, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.64981, "o", "print(f\"Grouped into {len(station_streams)} stations\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.649855, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.64992, "o", "all_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650089, "o", "for station_id, traces in station_streams.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650229, "o", "    print(f\"Processing {station_id}...\", end=' ')\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650271, "o", ">     \r\n\u001b[?2004l\r"]
[593.650346, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650451, "o", "        station_st = obspy.Stream(traces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650485, "o", "> "]
[593.650512, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650596, "o", "        # Get Z, N, E components\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650644, "o", "> "]
[593.650967, "o", "        z_tr = station_st.select(channel=\"*Z\")[0] if len(station_st.select(channel=\"*Z\")) > 0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651234, "o", "        n_tr = station_st.select(channel=\"*N\")[0] if len(station_st.select(channel=\"*N\")) > 0 else None\r\n\u001b[?2004l\r"]
[593.651381, "o", "\u001b[?2004h> "]
[593.651526, "o", "        e_tr = station_st.select(channel=\"*E\")[0] if len(station_st.select(channel=\"*E\")) > 0 else None\r\n\u001b[?2004l\r"]
[593.65161, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65167, "o", "        if z_tr is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651737, "o", "            print(\"No Z component, skipping\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651808, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.651876, "o", ">         # Prepare 3-component data\r\n\u001b[?2004l\r"]
[593.651929, "o", "\u001b[?2004h> "]
[593.652003, "o", "        z_data = z_tr.data.astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[593.65206, "o", "\u001b[?2004h> "]
[593.652118, "o", "        if n_tr is not None and e_tr is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652186, "o", "            n_data = n_tr.data.astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652255, "o", "            e_data = e_tr.data.astype(np.float32)\r\n\u001b[?2004l\r"]
[593.652317, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[593.652376, "o", "\u001b[?2004h> "]
[593.652431, "o", "            n_data = z_data.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652484, "o", "            e_data = z_data.copy()\r\n\u001b[?2004l\r"]
[593.652555, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.652631, "o", ">         # Stack into (3, N) array\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652707, "o", "        data_3c = np.stack([z_data, n_data, e_data], axis=0)\r\n\u001b[?2004l\r"]
[593.652763, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652868, "o", "        # Use SeisBench's annotate method (handles windowing internally)\r\n\u001b[?2004l\r"]
[593.652928, "o", "\u001b[?2004h> "]
[593.653006, "o", "        annotations = model.annotate(data_3c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653121, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653175, "o", "        # Get picks from annotations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653336, "o", "        picks = model.classify(data_3c, P_threshold=0.3, S_threshold=0.3)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Convert picks to absolute times\r\n\u001b[?2004l\r"]
[593.653363, "o", "\u001b[?2004h> "]
[593.653471, "o", "        sr = z_tr.stats.sampling_rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653495, "o", "        start_time = z_tr.stats.starttime\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653515, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653635, "o", "        if picks.p_picks is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653728, "o", "            for pick_sample, pick_prob in zip(picks.p_picks, picks.p_probs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653752, "o", "> "]
[593.653845, "o", "                pick_time = start_time + (pick_sample / sr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653915, "o", "                all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653988, "o", "                    'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65401, "o", "> "]
[593.654107, "o", "                    'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654131, "o", "                    'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654229, "o", "                    'probability': float(pick_prob)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.654254, "o", "> "]
[593.654274, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654398, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         if picks.s_picks is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654508, "o", "            for pick_sample, pick_prob in zip(picks.s_picks, picks.s_probs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.654533, "o", "> "]
[593.654625, "o", "                pick_time = start_time + (pick_sample / sr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654692, "o", "                all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.654713, "o", "> "]
[593.654801, "o", "                    'station': station_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654874, "o", "                    'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65494, "o", "                    'phase': 'S',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655013, "o", "                    'probability': float(pick_prob)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.655035, "o", "> "]
[593.655056, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65508, "o", ">         \r\n\u001b[?2004l\r"]
[593.655105, "o", "\u001b[?2004h> "]
[593.655262, "o", "        n_picks = len([p for p in all_picks if p['station'] == station_id])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655291, "o", "        print(f\"{n_picks} picks\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65531, "o", ">         \r\n\u001b[?2004l\r"]
[593.655331, "o", "\u001b[?2004h> "]
[593.655469, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655494, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.655514, "o", "\u001b[?2004h> "]
[593.655627, "o", "print(f\"\\nTotal picks: {len(all_picks)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655696, "o", "if len(all_picks) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655719, "o", "    print(\"No picks found!\")\r\n\u001b[?2004l\r"]
[593.655737, "o", "\u001b[?2004h> "]
[593.655856, "o", "    pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65588, "o", ">     exit(0)\r\n\u001b[?2004l\r"]
[593.655899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.655921, "o", "\u001b[?2004h> "]
[593.65606, "o", "picks_df = pd.DataFrame(all_picks)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656129, "o", "print(f\"P picks: {len(picks_df[picks_df['phase'] == 'P'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656195, "o", "print(f\"S picks: {len(picks_df[picks_df['phase'] == 'S'])}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656218, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656312, "o", "# Event association\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656334, "o", "print(\"\\nAssociating picks to events...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65635, "o", "> \r\n\u001b[?2004l\r"]
[593.65637, "o", "\u001b[?2004h> "]
[593.656508, "o", "mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656614, "o", "mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.656637, "o", "\u001b[?2004h> "]
[593.656723, "o", "vp = 6.0  # km/s\r\n\u001b[?2004l\r\u001b[?2004h> vs = vp / 1.75  # km/s\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656746, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656834, "o", "# Estimate origin times\r\n\u001b[?2004l\r\u001b[?2004h> origin_times = []\r\n\u001b[?2004l\r"]
[593.656857, "o", "\u001b[?2004h> "]
[593.656942, "o", "for pick in all_picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656966, "o", "    station_id = pick['station']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657074, "o", "    if station_id not in station_lookup:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.6571, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.657118, "o", ">     \r\n\u001b[?2004l\r"]
[593.657141, "o", "\u001b[?2004h> "]
[593.657286, "o", "    station_info = station_lookup[station_id]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657357, "o", "    lat_diff = station_info['latitude'] - mean_lat\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65744, "o", "    lon_diff = station_info['longitude'] - mean_lon\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.657463, "o", "> "]
[593.657556, "o", "    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657624, "o", "    distance_km = distance_deg * 111.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657647, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657734, "o", "    if pick['phase'] == 'P':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.6578, "o", "        travel_time = distance_km / vp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657823, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65791, "o", "        travel_time = distance_km / vs\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[593.657932, "o", "\u001b[?2004h> "]
[593.658021, "o", "    origin_time = pick['time'] - travel_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658087, "o", "    origin_times.append(origin_time.timestamp)\r\n\u001b[?2004l\r"]
[593.658114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.658132, "o", "> "]
[593.658241, "o", "origin_times_array = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.658265, "o", "\u001b[?2004h> "]
[593.658291, "o", "# Cluster with DBSCAN\r\n\u001b[?2004l\r"]
[593.658312, "o", "\u001b[?2004h> "]
[593.658446, "o", "dbscan = DBSCAN(eps=5.0, min_samples=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658471, "o", "cluster_labels = dbscan.fit_predict(origin_times_array)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65849, "o", "> \r\n"]
[593.658511, "o", "\u001b[?2004l\r\u001b[?2004h"]
[593.658535, "o", "> "]
[593.658685, "o", "print(f\"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters\")\r\n\u001b[?2004l\r"]
[593.658711, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.658731, "o", "\u001b[?2004h> "]
[593.658845, "o", "# Extract events\r\n\u001b[?2004l\r\u001b[?2004h> events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658917, "o", "for cluster_id in set(cluster_labels):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658983, "o", "    if cluster_id == -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659049, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[593.659073, "o", "\u001b[?2004h> "]
[593.65916, "o", "    cluster_mask = cluster_labels == cluster_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659261, "o", "    cluster_origin_times = origin_times_array[cluster_mask]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659287, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659307, "o", "> "]
[593.659419, "o", "    event_time = np.median(cluster_origin_times)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65944, "o", "    events.append({\r\n\u001b[?2004l\r"]
[593.659459, "o", "\u001b[?2004h"]
[593.65948, "o", "> "]
[593.659617, "o", "        'time': datetime.utcfromtimestamp(event_time).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659689, "o", "        'num_picks': int(np.sum(cluster_mask))\r\n\u001b[?2004l\r"]
[593.659713, "o", "\u001b[?2004h>     })\r\n"]
[593.659729, "o", "\u001b[?2004l\r\u001b[?2004h"]
[593.65975, "o", "> \r\n\u001b[?2004l\r"]
[593.659773, "o", "\u001b[?2004h> "]
[593.65993, "o", "events_df = pd.DataFrame(events)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659955, "o", "events_df = events_df.sort_values('time').reset_index(drop=True)\r\n\u001b[?2004l\r"]
[593.659971, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.659992, "o", "\u001b[?2004h"]
[593.660011, "o", "> "]
[593.660166, "o", "print(f\"\\nFinal event count: {len(events_df)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(events_df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.660249, "o", "events_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.660272, "o", "> "]
[593.660355, "o", "print(\"\\nResults saved to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[593.661632, "o", "\u001b[?2004hroot@d6ea14a06f21:~# "]
[600.638133, "i", "python3 seismic_analysis.py\n"]
[600.638391, "o", "python3 seismic_analysis.py"]
[600.638497, "o", "\r\n"]
