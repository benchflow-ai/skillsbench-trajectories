[?2004hroot@d6ea14a06f21:~# cat > seismic_analysis.py << 'EOF'
[?2004l[?2004h> import obspy
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from obspy import read
[?2004l[?2004h> from obspy.signal.trigger import classic_sta_lta, trigger_onset
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> from sklearn.cluster import DBSCAN
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> st = read('/root/data/wave.mseed')
[?2004l[?2004h> stations_df = pd.read_csv('/root/data/stations.csv')
[?2004l[?2004h> 
[?2004l[?2004h> station_lookup = {}
[?2004l[?2004h> for _, row in stations_df.iterrows():
[?2004l[?2004h>     key = f"{row['network']}.{row['station']}"
[?2004l[?2004h>     if key not in station_lookup:
[?2004l[?2004h>         station_lookup[key] = {
[?2004l[?2004h>             'latitude': row['latitude'],
[?2004l[?2004h>             'longitude': row['longitude']
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Loaded {len(st)} traces, {len(station_lookup)} stations")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate mean location
[?2004l[?2004h> mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])
[?2004l[?2004h> mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])
[?2004l[?2004h> 
[?2004l[?2004h> # Group by station
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> station_streams = defaultdict(list)
[?2004l[?2004h> for tr in st:
[?2004l[?2004h>     station_id = f"{tr.stats.network}.{tr.stats.station}"
[?2004l[?2004h>     station_streams[station_id].append(tr)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nUsing STA/LTA for phase detection...\n")
[?2004l[?2004h> 
[?2004l[?2004h> all_picks = []
[?2004l[?2004h> 
[?2004l[?2004h> for station_id, traces in station_streams.items():
[?2004l[?2004h>     print(f"Processing {station_id}...", end=' ', flush=True)
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         station_st = obspy.Stream(traces)
[?2004l[?2004h>         z_tr = station_st.select(channel="*Z")[0] if station_st.select(channel="*Z") else None
[?2004l[?2004h>         
[?2004l[?2004h>         if not z_tr:
[?2004l[?2004h>             print("no Z")
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Get station distance from mean location
[?2004l[?2004h>         if station_id in station_lookup:
[?2004l[?2004h>             s = station_lookup[station_id]
[?2004l[?2004h>             dist_deg = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2)
[?2004l[?2004h>             dist_km = dist_deg * 111.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             dist_km = 30.0  # default
[?2004l[?2004h>         
[?2004l[?2004h>         # Estimate S-P time based on distance
[?2004l[?2004h>         vp, vs = 6.0, 6.0/1.75
[?2004l[?2004h>         sp_time = dist_km * (1/vs - 1/vp)  # S-P travel time difference
[?2004l[?2004h>         sp_time = max(1.0, min(sp_time, 8.0))  # Clamp between 1-8 seconds
[?2004l[?2004h>         
[?2004l[?2004h>         data = z_tr.data.copy()
[?2004l[?2004h>         sr = z_tr.stats.sampling_rate
[?2004l[?2004h>         start_time = z_tr.stats.starttime
[?2004l[?2004h>         
[?2004l[?2004h>         # STA/LTA parameters - more conservative
[?2004l[?2004h>         sta_len = 0.5
[?2004l[?2004h>         lta_len = 15.0
[?2004l[?2004h>         
[?2004l[?2004h>         cft = classic_sta_lta(data, int(sta_len * sr), int(lta_len * sr))
[?2004l[?2004h>         
[?2004l[?2004h>         # Higher threshold to reduce false positives
[?2004l[?2004h>         on_off = trigger_onset(cft, 4.0, 1.5)
[?2004l[?2004h>         
[?2004l[?2004h>         for on, off in on_off:
[?2004l[?2004h>             pick_time = start_time + (on / sr)
[?2004l[?2004h>             
[?2004l[?2004h>             # P pick
[?2004l[?2004h>             all_picks.append({
[?2004l[?2004h>                 'station': station_id,
[?2004l[?2004h>                 'time': pick_time,
[?2004l[?2004h>                 'phase': 'P',
[?2004l[?2004h>                 'probability': 0.7
[?2004l[?2004h>             })
[?2004l[?2004h>             
[?2004l[?2004h>             # S pick with distance-based timing
[?2004l[?2004h>             s_time = pick_time + sp_time
[?2004l[?2004h>             all_picks.append({
[?2004l[?2004h>                 'station': station_id,
[?2004l[?2004h>                 'time': s_time,
[?2004l[?2004h>                 'phase': 'S',
[?2004l[?2004h>                 'probability': 0.6
[?2004l[?2004h>             })
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"{len(on_off)} triggers")
[?2004l[?2004h>         
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error: {e}")
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal picks: {len(all_picks)}")
[?2004l[?2004h> 
[?2004l[?2004h> if len(all_picks) == 0:
[?2004l[?2004h>     print("No picks! Creating empty results.")
[?2004l[?2004h>     pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)
[?2004l[?2004h>     exit(0)
[?2004l[?2004h> 
[?2004l[?2004h> picks_df = pd.DataFrame(all_picks)
[?2004l[?2004h> print(f"P: {len(picks_df[picks_df['phase']=='P'])}, S: {len(picks_df[picks_df['phase']=='S'])}")
[?2004l[?2004h> 
[?2004l[?2004h> # Associate events
[?2004l[?2004h> print("\nAssociating events...")
[?2004l[?2004h> 
[?2004l[?2004h> origin_times = []
[?2004l[?2004h> for pick in all_picks:
[?2004l[?2004h>     if pick['station'] not in station_lookup:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     s = station_lookup[pick['station']]
[?2004l[?2004h>     dist = np.sqrt((s['latitude']-mean_lat)**2 + (s['longitude']-mean_lon)**2) * 111.0
[?2004l[?2004h>     
[?2004l[?2004h>     tt = dist / (vp if pick['phase'] == 'P' else vs)
[?2004l[?2004h>     origin_times.append(pick['time'].timestamp - tt)
[?2004l[?2004h> 
[?2004l[?2004h> origin_times_array = np.array(origin_times).reshape(-1, 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Require at least 6 picks (3 stations with P+S)
[?2004l[?2004h> dbscan = DBSCAN(eps=5.0, min_samples=6)
[?2004l[?2004h> labels = dbscan.fit_predict(origin_times_array)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters")
[?2004l[?2004h> 
[?2004l[?2004h> events = []
[?2004l[?2004h> for cid in set(labels):
[?2004l[?2004h>     if cid == -1:
[?2004l[?2004h>         continue
[?2004l[?2004h>     mask = labels == cid
[?2004l[?2004h>     t = np.median(origin_times_array[mask])
[?2004l[?2004h>     n_picks = int(np.sum(mask))
[?2004l[?2004h>     
[?2004l[?2004h>     # Only keep events with sufficient picks
[?2004l[?2004h>     if n_picks >= 6:
[?2004l[?2004h>         events.append({
[?2004l[?2004h>             'time': datetime.utcfromtimestamp(t).isoformat(),
[?2004l[?2004h>             'num_picks': n_picks
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> events_df = pd.DataFrame(events).sort_values('time').reset_index(drop=True)
[?2004l[?2004h> 
