[?2004l[?2004h> import obspy
[?2004l[?2004h> import pandas as pd
[?2004l [?2004h> import numpy as np
[?2004l[?2004h> from obspy import read, UTCDateTime
[?2004l[?2004h> import seisbench.models as sbm
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> from sklearn.cluster import DBSCAN
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l [?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading waveform data...")
[?2004l[?2004h> st = read('/root/data/wave.mseed')
[?2004l[?2004h> print(f"Loaded {len(st)} traces")
[?2004l[?2004h> print(f"Time range: {st[0].stats.starttime} to {st[0].stats.endtime}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nLoading station data...")
[?2004l[?2004h> stations_df = pd.read_csv('/root/data/stations.csv')
[?2004l[?2004h> print(f"Loaded {len(stations_df)} station channels")
[?2004l[?2004h> 
[?2004l[?2004h> # Create station lookup
[?2004l[?2004h> station_lookup = {}
[?2004l[?2004h> for _, row in stations_df.iterrows():
[?2004l[?2004h>     key = f"{row['network']}.{row['station']}"
[?2004l[?2004h>     if key not in station_lookup:
[?2004l[?2004h>         station_lookup[key] = {
[?2004l[?2004h>             'latitude': row['latitude'],
[?2004l[?2004h>             'longitude': row['longitude'],
[?2004l[?2004h>             'elevation_m': row['elevation_m']
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004lm[?2004h> print(f"Unique stations: {len(station_lookup)}")
[?2004l[?2004h> 
[?2004lS[?2004h> print("\nLoading PhaseNet model...")
[?2004l[?2004h> model = sbm.PhaseNet.from_pretrained("original")
[?2004l[?2004h> print("Model loaded successfully")
[?2004lt[?2004h> 
[?2004l [?2004h> # Group traces by station
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> station_streams = defaultdict(list)
[?2004l[?2004h> for tr in st:
[?2004l[?2004h>     station_id = f"{tr.stats.network}.{tr.stats.station}"
[?2004l[?2004h>     station_streams[station_id].append(tr)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Grouped into {len(station_streams)} stations")
[?2004l[?2004h> 
[?2004l[?2004h> all_picks = []
[?2004l[?2004h> 
[?2004lc[?2004h> for station_id, traces in station_streams.items():
[?2004l[?2004h>     print(f"Processing {station_id}...")
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Create stream and get components
[?2004l[?2004h>         station_st = obspy.Stream(traces)
[?2004l[?2004h>         
[?2004l[?2004h>         # Get Z, N, E components
[?2004l[?2004h>         z_tr = station_st.select(channel="*Z")[0] if len(station_st.select(channel="*Z")) > 0 else None
[?2004l[?2004h>         n_tr = station_st.select(channel="*N")[0] if len(station_st.select(channel="*N")) > 0 else None
[?2004l[?2004h>         e_tr = station_st.select(channel="*E")[0] if len(station_st.select(channel="*E")) > 0 else None
[?2004l[?2004h>         
[?2004l[?2004h>         if z_tr is None:
[?2004l[?2004h>             print(f"  No Z component, skipping")
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Prepare 3-component data
[?2004l[?2004h>         z_data = z_tr.data.astype(np.float32)
[?2004l[?2004h>         
[?2004l[?2004h>         if n_tr is not None and e_tr is not None:
[?2004l[?2004h>             n_data = n_tr.data.astype(np.float32)
[?2004l[?2004h>             e_data = e_tr.data.astype(np.float32)
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Duplicate Z if N/E not available
[?2004l[?2004h>             n_data = z_data.copy()
[?2004l[?2004h>             e_data = z_data.copy()
[?2004l[?2004h>         
[?2004l[?2004h>         # Normalize each component
[?2004l[?2004h>         z_data = (z_data - np.mean(z_data)) / (np.std(z_data) + 1e-10)
[?2004l[?2004h>         n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)
[?2004l[?2004h>         e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)
[?2004l[?2004h>         
[?2004l [?2004h>         # Process in windows (PhaseNet expects 3001 samples = 30 seconds at 100 Hz)
[?2004l[?2004h>         window_samples = 6000  # 60 seconds
[?2004l[?2004h>         overlap = 3000  # 30 second overlap
[?2004l[?2004h>         
[?2004l[?2004h>         sr = z_tr.stats.sampling_rate
[?2004l[?2004h>         
[?2004l[?2004h>         for start_idx in range(0, len(z_data) - window_samples + 1, window_samples - overlap):
[?2004l[?2004h>             end_idx = start_idx + window_samples
[?2004l[?2004h>             
[?2004l[?2004h>             # Extract window
[?2004l[?2004h>             z_win = z_data[start_idx:end_idx]
[?2004l[?2004h>             n_win = n_data[start_idx:end_idx]
[?2004l[?2004h>             e_win = e_data[start_idx:end_idx]
[?2004l[?2004h>             
[?2004l[?2004h>             # Stack into 3-channel format (channels, samples)
[?2004l[?2004h>             data_3c = np.array([z_win, n_win, e_win])
[?2004l[?2004h>             
[?2004l[?2004h>             # Run model prediction
[?2004l[?2004h>             try:
[?2004l[?2004h>                 # Model expects (batch, channels, samples)
[?2004l[?2004h>                 predictions = model(data_3c[np.newaxis, :, :])
[?2004l[?2004h>                 
[?2004l[?2004h>                 # predictions shape: (batch, 3, samples)
[?2004l[?2004h>                 # Channel 0: noise, 1: P, 2: S
[?2004l[?2004h>                 p_prob = predictions[0, 1, :].detach().numpy()
[?2004l[?2004h>                 s_prob = predictions[0, 2, :].detach().numpy()
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Find peaks in probabilities
[?2004l[?2004h>                 p_threshold = 0.3
[?2004l[?2004h>                 s_threshold = 0.3
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Find P picks
[?2004l[?2004h>                 p_peaks, p_props = find_peaks(p_prob, height=p_threshold, distance=100)  # min 1 sec apart
[?2004l[?2004h>                 for peak_idx in p_peaks:
[?2004l[?2004h>                     # Convert to absolute time
[?2004l[?2004h>                     sample_in_trace = start_idx + peak_idx
[?2004l[?2004h>                     pick_time = z_tr.stats.starttime + (sample_in_trace / sr)
[?2004l[?2004h>                     
[?2004l[?2004h>                     all_picks.append({
[?2004l[?2004h>                         'station': station_id,
[?2004l[?2004h>                         'time': pick_time,
[?2004l[?2004h>                         'phase': 'P',
[?2004l[?2004h>                         'probability': p_prob[peak_idx]
[?2004l[?2004h>                     })
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Find S picks
[?2004l[?2004h>                 s_peaks, s_props = find_peaks(s_prob, height=s_threshold, distance=100)
[?2004l[?2004h>                 for peak_idx in s_peaks:
[?2004l[?2004h>                     sample_in_trace = start_idx + peak_idx
[?2004l[?2004h>                     pick_time = z_tr.stats.starttime + (sample_in_trace / sr)
[?2004l[?2004h>                     
[?2004l[?2004h>                     all_picks.append({
[?2004l[?2004h>                         'station': station_id,
[?2004l[?2004h>                         'time': pick_time,
[?2004l[?2004h>                         'phase': 'S',
[?2004l[?2004h>                         'probability': s_prob[peak_idx]
[?2004l[?2004h>                     })
[?2004l[?2004h>                     
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 print(f"  Error in window starting at {start_idx}: {e}")
[?2004l[?2004h>                 continue
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"  Found picks for {station_id}")
[?2004l[?2004h>         
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"  Error processing {station_id}: {e}")
[?2004l[?2004h>         import traceback
[?2004l[?2004h>         traceback.print_exc()
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal picks: {len(all_picks)}")
[?2004l[?2004h> 
