[?2004l[?2004h>     print("No picks found!")
[?2004l[?2004h>     pd.DataFrame({'time': []}).to_csv('/root/results.csv', index=False)
[?2004l[?2004h>     exit(0)
[?2004l[?2004h> 
[?2004l[?2004h> picks_df = pd.DataFrame(all_picks)
[?2004l[?2004h> print(f"P picks: {len(picks_df[picks_df['phase'] == 'P'])}")
[?2004l[?2004h> print(f"S picks: {len(picks_df[picks_df['phase'] == 'S'])}")
[?2004l[?2004h> 
[?2004l[?2004h> # Event association
[?2004l[?2004h> print("\nAssociating picks to events...")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate mean station location
[?2004l[?2004h> mean_lat = np.mean([s['latitude'] for s in station_lookup.values()])
[?2004l[?2004h> mean_lon = np.mean([s['longitude'] for s in station_lookup.values()])
[?2004l[?2004h> 
[?2004l[?2004h> vp = 6.0  # km/s
[?2004l[?2004h> vs = vp / 1.75  # km/s
[?2004l[?2004h> 
[?2004l[?2004h> # Estimate origin times
[?2004l[?2004h> origin_times = []
[?2004l[?2004h> for pick in all_picks:
[?2004l[?2004h>     station_id = pick['station']
[?2004l[?2004h>     if station_id not in station_lookup:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     station_info = station_lookup[station_id]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate approximate distance
[?2004l[?2004h>     lat_diff = station_info['latitude'] - mean_lat
[?2004l[?2004h>     lon_diff = station_info['longitude'] - mean_lon
[?2004l[?2004h>     distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)
[?2004l[?2004h>     distance_km = distance_deg * 111.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Estimate travel time
[?2004l[?2004h>     if pick['phase'] == 'P':
[?2004l[?2004h>         travel_time = distance_km / vp
[?2004l[?2004h>     else:
[?2004l[?2004h>         travel_time = distance_km / vs
[?2004l[?2004h>     
[?2004l[?2004h>     # Back-project to origin time
[?2004l[?2004h>     origin_time = pick['time'] - travel_time
[?2004l[?2004h>     origin_times.append(origin_time.timestamp)
[?2004l[?2004h> 
[?2004l[?2004h> # Cluster origin times
[?2004l[?2004h> origin_times_array = np.array(origin_times).reshape(-1, 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Use DBSCAN with 5 second tolerance
[?2004l[?2004h> dbscan = DBSCAN(eps=5.0, min_samples=4)  # require at least 4 picks
[?2004l[?2004h> cluster_labels = dbscan.fit_predict(origin_times_array)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters")
[?2004l[?2004h> 
[?2004l[?2004h> # Extract events
[?2004l[?2004h> events = []
[?2004l[?2004h> for cluster_id in set(cluster_labels):
[?2004l[?2004h>     if cluster_id == -1:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     cluster_mask = cluster_labels == cluster_id
[?2004l[?2004h>     cluster_origin_times = origin_times_array[cluster_mask]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use median origin time
[?2004l[?2004h>     event_time = np.median(cluster_origin_times)
[?2004l[?2004h>     events.append({
[?2004l[?2004h>         'time': datetime.utcfromtimestamp(event_time).isoformat(),
[?2004l[?2004h>         'num_picks': int(np.sum(cluster_mask))
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> events_df = pd.DataFrame(events)
[?2004l[?2004h> events_df = events_df.sort_values('time').reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nFinal event count: {len(events_df)}")
[?2004l[?2004h> print(events_df)
