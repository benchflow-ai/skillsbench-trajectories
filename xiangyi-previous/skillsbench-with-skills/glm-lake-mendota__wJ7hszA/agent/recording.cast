[57.950618, "i", "python3 << 'EOF'\nimport netCDF4 as nc\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\n\n# Load the NetCDF file\nds = nc.Dataset('/root/output/output.nc')\n\n# Extract temperature and time data\ntemp_data = ds.variables['temp'][:]\ntime_data = ds.variables['time'][:]\nz_data = ds.variables['z'][:]\n\nprint(f\"Temperature shape: {temp_data.shape}\")\nprint(f\"Time shape: {time_data.shape}\")\nprint(f\"Z shape: {z_data.shape}\")\nprint(f\"Z values (first 30): {z_data[:30]}\")\n\n# Load field observations\nobs_df = pd.read_csv('/root/field_temp_oxy.csv')\nobs_df['datetime'] = pd.to_datetime(obs_df['datetime'])\nprint(f\"\\nObservations shape: {obs_df.shape}\")\nprint(f\"Observation date range: {obs_df['datetime'].min()} to {obs_df['datetime'].max()}\")\nprint(f\"Observation depths: {sorted(obs_df['depth'].unique())}\")\nprint(f\"\\nFirst few observations:\")\nprint(obs_df.head(10))\nEOF\n"]
