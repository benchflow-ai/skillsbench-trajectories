[35.920923, "o", "cat skills/pddl-skills/generate_plan.skill\r\n\u001b[?2004l\r"]
[35.922136, "o", "name: generate-plan\r\ndescription: Generate a plan for a PDDL problem object.\r\ninputs:\r\n  - problem: unified_planning problem object\r\noutputs:\r\n  - plan: plan object\r\nimplementation: python\r\nscript: |\r\n  def skill(problem):\r\n      from unified_planning.shortcuts import OneshotPlanner\r\n      with OneshotPlanner(name=\"pyperplan\") as planner:\r\n          result = planner.solve(problem)\r\n      return result.plan\r\n"]
[35.922324, "o", "\u001b[?2004hroot@543d9f6e7a39:/app# "]
[40.409268, "i", "cat <<EOF > solver.py\nimport unified_planning as up\nfrom unified_planning.shortcuts import PDDLReader, OneshotPlanner\nimport sys\n\ndef solve_pddl(domain_path, problem_path, output_path):\n    reader = PDDLReader()\n    problem = reader.parse_problem(domain_path, problem_path)\n    with OneshotPlanner(name='pyperplan') as planner:\n        result = planner.solve(problem)\n        if result.plan:\n            with open(output_path, 'w') as f:\n                for action in result.plan.actions:\n                    f.write(f\"({action.action.name} {' '.join(str(arg) for arg in action.actual_parameters)})\\\\n\")\n        else:\n            print(f\"No plan found for {problem_path}\")\n\nif __name__ == \"__main__\":\n    solve_pddl(sys.argv[1], sys.argv[2], sys.argv[3])\nEOF\n"]
[40.414226, "o", "cat <<EOF > solver.py\r\n\u001b[?2004l\r"]
