[92.390933, "i", "cat <<EOF > solver.py\nimport unified_planning as up\nfrom unified_planning.io import PDDLReader\nfrom unified_planning.shortcuts import OneshotPlanner\nimport sys\n\ndef solve_pddl(domain_path, problem_path, output_path):\n    reader = PDDLReader()\n    problem = reader.parse_problem(domain_path, problem_path)\n    with OneshotPlanner(name='pyperplan') as planner:\n        result = planner.solve(problem)\n        if result.plan:\n            with open(output_path, 'w') as f:\n                for action in result.plan.actions:\n                    args = ', '.join(str(arg) for arg in action.actual_parameters)\n                    f.write(f\"{action.action.name}({args})\\\\n\")\n        else:\n            print(f\"No plan found for {problem_path}\")\n\nif __name__ == \"__main__\":\n    solve_pddl(sys.argv[1], sys.argv[2], sys.argv[3])\nEOF\n"]
