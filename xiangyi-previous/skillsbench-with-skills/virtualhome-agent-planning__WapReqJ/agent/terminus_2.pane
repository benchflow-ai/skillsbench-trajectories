[?2004l[?2004h> import unified_planning as up
[?2004l[?2004h> from unified_planning.io import PDDLReader
[?2004l[?2004h> from unified_planning.shortcuts import OneshotPlanner
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> def solve_pddl(domain_path, problem_path, output_path):
[?2004l[?2004h>     reader = PDDLReader()
[?2004l[?2004h>     problem = reader.parse_problem(domain_path, problem_path)
[?2004l[?2004h>     with OneshotPlanner(name='pyperplan') as planner:
[?2004l[?2004h>         result = planner.solve(problem)
[?2004l[?2004h>         if result.plan:
[?2004l[?2004h>             with open(output_path, 'w') as f:
[?2004l[?2004h>                 for action in result.plan.actions:
[?2004l[?2004h>                     args = ', '.join(str(arg) for arg in action.actual_parameters)
[?2004l[?2004h>                     f.write(f"{action.action.name}({args})\\n")
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f"No plan found for {problem_path}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     solve_pddl(sys.argv[1], sys.argv[2], sys.argv[3])
