[1331.719287, "i", "cat <<EOF > transcribe.py\nimport whisper\nimport json\n\nprint(\"Loading model...\")\nmodel = whisper.load_model(\"tiny\")\nprint(\"Transcribing...\")\nresult = model.transcribe(\"/root/tutorial_video.mp4\", verbose=True)\n\nwith open(\"/root/tutorial_video.json\", \"w\") as f:\n    json.dump(result, f, indent=2)\nprint(\"Done!\")\nEOF\n"]
