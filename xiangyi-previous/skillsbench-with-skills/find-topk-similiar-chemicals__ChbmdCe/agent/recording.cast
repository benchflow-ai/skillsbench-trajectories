[98.105668, "i", "python3 << 'TESTAPI'\nimport urllib.request\nimport urllib.parse\nimport json\n\n# Test with different names\nnames = ['Aspirin', 'Acetylsalicylic acid', 'acetylsalicylic acid']\n\nfor name in names:\n    try:\n        encoded_name = urllib.parse.quote(name)\n        url = f\"https://pubchem.ncbi.nlm.nih.gov/rest/v1/compound/name/{encoded_name}/property/CanonicalSMILES/JSON\"\n        print(f\"Testing: {name}\")\n        with urllib.request.urlopen(url, timeout=5) as response:\n            data = json.loads(response.read().decode())\n            if 'properties' in data and len(data['properties']) > 0:\n                smiles = data['properties'][0].get('CanonicalSMILES')\n                print(f\"  SMILES: {smiles}\")\n            else:\n                print(f\"  No results\")\n    except Exception as e:\n        print(f\"  Error: {e}\")\nTESTAPI\n"]
