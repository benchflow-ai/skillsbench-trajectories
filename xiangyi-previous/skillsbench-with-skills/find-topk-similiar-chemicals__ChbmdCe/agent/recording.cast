[36.1613, "o", "    Find the top k similar chemicals to a target molecule.\r\n\u001b[?2004l\r"]
[36.161525, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.161562, "o", "        target_molecule_name: Name of the target molecule\r\n\u001b[?2004l\r"]
[36.161593, "o", "\u001b[?2004h> "]
[36.161732, "o", "        molecule_pool_filepath: Path to the PDF file containing molecule names\r\n"]
[36.161763, "o", "\u001b[?2004l\r"]
[36.161771, "o", "\u001b[?2004h"]
[36.161777, "o", "> "]
[36.161903, "o", "        top_k: Number of top similar molecules to return\r\n"]
[36.161925, "o", "\u001b[?2004l\r"]
[36.161935, "o", "\u001b[?2004h> "]
[36.161974, "o", "    \r\n\u001b[?2004l\r"]
[36.162013, "o", "\u001b[?2004h> "]
[36.162063, "o", "    Returns:\r\n"]
[36.162073, "o", "\u001b[?2004l\r\u001b[?2004h"]
[36.16209, "o", "> "]
[36.162301, "o", "        List of tuples (molecule_name, similarity_score) sorted by similarity (descending)\r\n"]
[36.162329, "o", "\u001b[?2004l\r"]
[36.16234, "o", "\u001b[?2004h> "]
[36.1624, "o", "        and alphabetically for ties\r\n"]
[36.16241, "o", "\u001b[?2004l\r"]
[36.162429, "o", "\u001b[?2004h> "]
[36.162466, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.16251, "o", "> "]
[36.16256, "o", "    # Get SMILES for target molecule\r\n\u001b[?2004l\r"]
[36.162577, "o", "\u001b[?2004h> "]
[36.162681, "o", "    target_smiles = get_smiles_from_pubchem(target_molecule_name)\r\n\u001b[?2004l\r"]
[36.162712, "o", "\u001b[?2004h> "]
[36.162766, "o", "    if target_smiles is None:\r\n"]
[36.162774, "o", "\u001b[?2004l\r"]
[36.16281, "o", "\u001b[?2004h> "]
[36.162834, "o", "        return []\r\n"]
[36.162841, "o", "\u001b[?2004l\r"]
[36.162873, "o", "\u001b[?2004h> "]
[36.16288, "o", "    "]
[36.162907, "o", "\r\n\u001b[?2004l\r"]
[36.162916, "o", "\u001b[?2004h"]
[36.162924, "o", "> "]
[36.16299, "o", "    # Compute fingerprint for target\r\n\u001b[?2004l\r"]
[36.163012, "o", "\u001b[?2004h"]
[36.16303, "o", "> "]
[36.163146, "o", "    target_fp = compute_morgan_fingerprint(target_smiles, radius=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.163195, "o", "    if target_fp is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.163219, "o", "> "]
[36.163236, "o", "        return []\r\n\u001b[?2004l\r"]
[36.163243, "o", "\u001b[?2004h"]
[36.163268, "o", ">     \r\n\u001b[?2004l\r"]
[36.1633, "o", "\u001b[?2004h"]
[36.16331, "o", "> "]
[36.163372, "o", "    # Extract molecules from PDF\r\n\u001b[?2004l\r"]
[36.16338, "o", "\u001b[?2004h"]
[36.163387, "o", "> "]
[36.163537, "o", "    molecules = extract_molecules_from_pdf(molecule_pool_filepath)\r\n\u001b[?2004l\r"]
[36.163568, "o", "\u001b[?2004h> "]
[36.163578, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.163621, "o", "    # Compute similarities\r\n\u001b[?2004l\r"]
[36.163631, "o", "\u001b[?2004h> "]
[36.163687, "o", "    similarities = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.163697, "o", "> "]
[36.163774, "o", "    for mol_name in molecules:\r\n\u001b[?2004l\r"]
[36.163783, "o", "\u001b[?2004h"]
[36.163805, "o", "> "]
[36.163933, "o", "        if mol_name.lower() == target_molecule_name.lower():\r\n\u001b[?2004l\r"]
[36.163942, "o", "\u001b[?2004h"]
[36.163963, "o", "> "]
[36.164035, "o", "            continue  # Skip the target molecule itself\r\n\u001b[?2004l\r"]
[36.164065, "o", "\u001b[?2004h> "]
[36.164073, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.164078, "o", "> "]
[36.164165, "o", "        mol_smiles = get_smiles_from_pubchem(mol_name)\r\n\u001b[?2004l\r"]
[36.164191, "o", "\u001b[?2004h> "]
[36.16424, "o", "        if mol_smiles is not None:\r\n\u001b[?2004l\r"]
[36.164272, "o", "\u001b[?2004h> "]
[36.164388, "o", "            mol_fp = compute_morgan_fingerprint(mol_smiles, radius=2)\r\n\u001b[?2004l\r"]
[36.164398, "o", "\u001b[?2004h"]
[36.164407, "o", "> "]
[36.164461, "o", "            if mol_fp is not None:\r\n\u001b[?2004l\r"]
[36.164471, "o", "\u001b[?2004h> "]
[36.164591, "o", "                sim = tanimoto_similarity(target_fp, mol_fp)\r\n\u001b[?2004l\r"]
[36.164626, "o", "\u001b[?2004h> "]
[36.164686, "o", "                if sim >= 0:\r\n\u001b[?2004l\r"]
[36.164721, "o", "\u001b[?2004h"]
[36.164731, "o", "> "]
[36.164827, "o", "                    similarities.append((mol_name, sim))\r\n\u001b[?2004l\r"]
[36.164857, "o", "\u001b[?2004h> "]
[36.164863, "o", "    \r\n"]
[36.164869, "o", "\u001b[?2004l\r"]
[36.164927, "o", "\u001b[?2004h> "]
[36.16502, "o", "    # Sort by similarity (descending) and then alphabetically\r\n\u001b[?2004l\r"]
[36.165041, "o", "\u001b[?2004h"]
[36.165051, "o", "> "]
[36.165159, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r"]
[36.165189, "o", "\u001b[?2004h> "]
[36.165197, "o", "    \r\n\u001b[?2004l\r"]
[36.16526, "o", "\u001b[?2004h> "]
[36.165271, "o", "    # Return top k\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.165287, "o", "> "]
[36.165339, "o", "    return similarities[:top_k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.16535, "o", "> \r\n\u001b[?2004l\r"]
[36.165366, "o", "\u001b[?2004h> EOF\r\n"]
[36.165373, "o", "\u001b[?2004l\r"]
[36.166588, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
