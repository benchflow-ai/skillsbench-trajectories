[180.006078, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[180.006093, "o", "\u001b[?2004h> "]
[180.006147, "o", "    if fp1 is None or fp2 is None:\r\n\u001b[?2004l\r"]
[180.006152, "o", "\u001b[?2004h> "]
[180.006193, "o", "        return -1.0\r\n\u001b[?2004l\r"]
[180.006199, "o", "\u001b[?2004h> "]
[180.006216, "o", "    \r\n\u001b[?2004l\r"]
[180.00623, "o", "\u001b[?2004h> "]
[180.006247, "o", "    try:\r\n\u001b[?2004l\r"]
[180.006251, "o", "\u001b[?2004h> "]
[180.006347, "o", "        return DataStructs.TanimotoSimilarity(fp1, fp2)\r\n\u001b[?2004l\r"]
[180.006352, "o", "\u001b[?2004h> "]
[180.006401, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[180.006407, "o", "\u001b[?2004h> "]
[180.006447, "o", "        return -1.0\r\n\u001b[?2004l\r"]
[180.006452, "o", "\u001b[?2004h> "]
[180.006458, "o", "\r\n\u001b[?2004l\r"]
[180.006476, "o", "\u001b[?2004h> "]
[180.006614, "o", "def topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\r\n\u001b[?2004l\r"]
[180.006619, "o", "\u001b[?2004h> "]
[180.006642, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[180.006647, "o", "\u001b[?2004h> "]
[180.006743, "o", "    Find the top k similar chemicals to a target molecule.\r\n\u001b[?2004l\r"]
[180.006748, "o", "\u001b[?2004h> "]
[180.006767, "o", "    \r\n\u001b[?2004l\r"]
[180.006772, "o", "\u001b[?2004h> "]
[180.006797, "o", "    Args:\r\n\u001b[?2004l\r"]
[180.006804, "o", "\u001b[?2004h> "]
[180.006898, "o", "        target_molecule_name: Name of the target molecule\r\n\u001b[?2004l\r"]
[180.006904, "o", "\u001b[?2004h> "]
[180.007025, "o", "        molecule_pool_filepath: Path to the PDF file containing molecule names\r\n\u001b[?2004l\r"]
[180.007043, "o", "\u001b[?2004h> "]
[180.00713, "o", "        top_k: Number of top similar molecules to return\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.007146, "o", ">     \r\n\u001b[?2004l\r"]
[180.007166, "o", "\u001b[?2004h> "]
[180.007181, "o", "    Returns:\r\n\u001b[?2004l\r"]
[180.0072, "o", "\u001b[?2004h> "]
[180.007332, "o", "        List of tuples (molecule_name, similarity_score) sorted by similarity (descending)\r\n\u001b[?2004l\r"]
[180.007336, "o", "\u001b[?2004h> "]
[180.007396, "o", "        and alphabetically for ties\r\n\u001b[?2004l\r"]
[180.00741, "o", "\u001b[?2004h> "]
[180.007426, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.007441, "o", "> "]
[180.007512, "o", "    # Get SMILES for target molecule using PubChem\r\n\u001b[?2004l\r"]
[180.007526, "o", "\u001b[?2004h> "]
[180.007628, "o", "    target_smiles = get_smiles_from_pubchem(target_molecule_name)\r\n\u001b[?2004l\r"]
[180.007646, "o", "\u001b[?2004h> "]
[180.007691, "o", "    if target_smiles is None:\r\n\u001b[?2004l\r"]
[180.007697, "o", "\u001b[?2004h> "]
[180.007734, "o", "        return []\r\n\u001b[?2004l\r"]
[180.00774, "o", "\u001b[?2004h> "]
[180.007757, "o", "    \r\n\u001b[?2004l\r"]
[180.007763, "o", "\u001b[?2004h> "]
[180.007867, "o", "    # Compute fingerprint for target (radius=2, with chirality)\r\n\u001b[?2004l\r"]
[180.007873, "o", "\u001b[?2004h> "]
[180.007979, "o", "    target_fp = compute_morgan_fingerprint(target_smiles, radius=2)\r\n\u001b[?2004l\r"]
[180.007985, "o", "\u001b[?2004h> "]
[180.008035, "o", "    if target_fp is None:\r\n\u001b[?2004l\r"]
[180.008041, "o", "\u001b[?2004h> "]
[180.008078, "o", "        return []\r\n\u001b[?2004l\r"]
[180.008082, "o", "\u001b[?2004h> "]
[180.008106, "o", "    \r\n\u001b[?2004l\r"]
[180.008111, "o", "\u001b[?2004h> "]
[180.008166, "o", "    # Extract molecules from PDF\r\n\u001b[?2004l\r"]
[180.008171, "o", "\u001b[?2004h> "]
[180.008279, "o", "    molecules = extract_molecules_from_pdf(molecule_pool_filepath)\r\n\u001b[?2004l\r"]
[180.008284, "o", "\u001b[?2004h> "]
[180.008301, "o", "    \r\n\u001b[?2004l\r"]
[180.008317, "o", "\u001b[?2004h> "]
[180.008382, "o", "    # Compute similarities for all molecules\r\n\u001b[?2004l\r"]
[180.008398, "o", "\u001b[?2004h> "]
[180.008432, "o", "    similarities = []\r\n\u001b[?2004l\r"]
[180.008437, "o", "\u001b[?2004h> "]
[180.008494, "o", "    for mol_name in molecules:\r\n\u001b[?2004l\r"]
[180.0085, "o", "\u001b[?2004h> "]
[180.008568, "o", "        # Skip the target molecule itself\r\n\u001b[?2004l\r"]
[180.008585, "o", "\u001b[?2004h> "]
[180.008677, "o", "        if mol_name.lower() == target_molecule_name.lower():\r\n\u001b[?2004l\r"]
[180.008693, "o", "\u001b[?2004h> "]
[180.008727, "o", "            continue\r\n\u001b[?2004l\r"]
[180.008733, "o", "\u001b[?2004h> "]
[180.008756, "o", "        \r\n\u001b[?2004l\r"]
[180.008772, "o", "\u001b[?2004h> "]
[180.008827, "o", "        # Get SMILES for the molecule\r\n\u001b[?2004l\r"]
[180.008842, "o", "\u001b[?2004h> "]
[180.008922, "o", "        mol_smiles = get_smiles_from_pubchem(mol_name)\r\n\u001b[?2004l\r"]
[180.008929, "o", "\u001b[?2004h> "]
[180.008991, "o", "        if mol_smiles is not None:\r\n\u001b[?2004l\r"]
[180.008997, "o", "\u001b[?2004h> "]
[180.009076, "o", "            # Compute fingerprint and similarity\r\n\u001b[?2004l\r"]
[180.009082, "o", "\u001b[?2004h> "]
[180.009204, "o", "            mol_fp = compute_morgan_fingerprint(mol_smiles, radius=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.009279, "o", "            if mol_fp is not None:\r\n\u001b[?2004l\r"]
[180.009285, "o", "\u001b[?2004h> "]
[180.009385, "o", "                sim = tanimoto_similarity(target_fp, mol_fp)\r\n\u001b[?2004l\r"]
[180.00939, "o", "\u001b[?2004h> "]
[180.009441, "o", "                if sim >= 0:\r\n\u001b[?2004l\r"]
[180.009458, "o", "\u001b[?2004h> "]
[180.009539, "o", "                    similarities.append((mol_name, sim))\r\n\u001b[?2004l\r"]
[180.009546, "o", "\u001b[?2004h> "]
[180.009566, "o", "    \r\n\u001b[?2004l\r"]
[180.009585, "o", "\u001b[?2004h> "]
[180.009689, "o", "    # Sort by similarity (descending) and then alphabetically for ties\r\n\u001b[?2004l\r"]
[180.009694, "o", "\u001b[?2004h> "]
[180.009778, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r"]
[180.009793, "o", "\u001b[?2004h> "]
[180.009799, "o", "    \r\n\u001b[?2004l\r"]
[180.009817, "o", "\u001b[?2004h> "]
[180.009852, "o", "    # Return top k\r\n\u001b[?2004l\r"]
[180.009857, "o", "\u001b[?2004h> "]
[180.009913, "o", "    return similarities[:top_k]\r\n\u001b[?2004l\r"]
[180.009919, "o", "\u001b[?2004h> \r\n"]
[180.009933, "o", "\u001b[?2004l\r"]
[180.009938, "o", "\u001b[?2004h"]
[180.009942, "o", "> "]
[180.009959, "o", "EOF\r\n\u001b[?2004l\r"]
[180.09094, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
[184.67078, "i", "head -20 /root/workspace/solution.py\n"]
[184.670941, "o", "head -20 /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[184.689235, "o", "import pdfplumber\r\nimport pubchempy as pcp\r\nfrom rdkit import Chem\r\nfrom rdkit.Chem import AllChem\r\nfrom rdkit import DataStructs\r\n\r\ndef get_smiles_from_pubchem(molecule_name):\r\n    \"\"\"\r\n    Convert a chemical name to SMILES using PubChemPy.\r\n    \"\"\"\r\n    try:\r\n        results = pcp.get_compounds(molecule_name, 'name')\r\n        if results and len(results) > 0:\r\n            return results[0].canonical_smiles\r\n    except Exception as e:\r\n        pass\r\n    \r\n    return None\r\n\r\ndef extract_molecules_from_pdf(filepath):\r\n"]
[184.68941, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
[184.8674, "i", "wc -l /root/workspace/solution.py\n"]
[184.867563, "o", "wc -l /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[184.868606, "o", "112 /root/workspace/solution.py\r\n"]
[184.868742, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
[189.214534, "i", "python3 << 'TESTEOF' 2>/dev/null\nimport sys\nsys.path.insert(0, '/root/workspace')\nfrom solution import topk_tanimoto_similarity_molecules\n\nprint(\"Testing with Caffeine:\")\nresults = topk_tanimoto_similarity_molecules('Caffeine', '/root/molecules.pdf', 3)\nfor mol_name, sim_score in results:\n    print(f\"  {mol_name}: {sim_score:.4f}\")\nTESTEOF\n"]
[189.214709, "o", "python3 << 'TESTEOF' 2>/dev/null\r\n\u001b[?2004l\r"]
[189.214761, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[189.214807, "o", "\u001b[?2004h> "]
[189.214874, "o", "sys.path.insert(0, '/root/workspace')\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.214889, "o", "> "]
[189.214999, "o", "from solution import topk_tanimoto_similarity_molecules\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.215046, "o", "> "]
[189.215081, "o", "print(\"Testing with Caffeine:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.215229, "o", "results = topk_tanimoto_similarity_molecules('Caffeine', '/root/molecules.pdf', 3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.215303, "o", "for mol_name, sim_score in results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.21534, "o", "> "]
[189.21543, "o", "    print(f\"  {mol_name}: {sim_score:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> TESTEOF\r\n\u001b[?2004l\r"]
[189.867084, "o", "Testing with Caffeine:\r\n"]
[205.554076, "o", "  Theophylline: 0.4571\r\n  Diazepam: 0.1455\r\n  Nicotine: 0.1224\r\n"]
[205.621428, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
[223.618334, "i", "tail -20 /root/workspace/solution.py\n"]
[223.618543, "o", "tail -20 /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[223.619474, "o", "        # Skip the target molecule itself\r\n        if mol_name.lower() == target_molecule_name.lower():\r\n            continue\r\n        \r\n        # Get SMILES for the molecule\r\n        mol_smiles = get_smiles_from_pubchem(mol_name)\r\n        if mol_smiles is not None:\r\n            # Compute fingerprint and similarity\r\n            mol_fp = compute_morgan_fingerprint(mol_smiles, radius=2)\r\n            if mol_fp is not None:\r\n                sim = tanimoto_similarity(target_fp, mol_fp)\r\n                if sim >= 0:\r\n                    similarities.append((mol_name, sim))\r\n    \r\n    # Sort by similarity (descending) and then alphabetically for ties"]
[223.619501, "o", "\r\n    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n    \r\n    # Return top k\r\n    return similarities[:top_k]\r\n\r\n"]
[223.619651, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
[223.763701, "i", "cat /root/workspace/solution.py | head -50 | tail -30\n"]
[223.763938, "o", "cat /root/workspace/solution.py | head -50 | tail -30\r\n\u001b[?2004l\r"]
[223.765671, "o", "    \"\"\"\r\n    Extract chemical names from the PDF file.\r\n    \"\"\"\r\n    molecules = []\r\n    try:\r\n        with pdfplumber.open(filepath) as pdf:\r\n            for page in pdf.pages:\r\n                text = page.extract_text()\r\n                if text:\r\n                    # Split by newlines and filter empty lines\r\n                    lines = [line.strip() for line in text.split('\\n') if line.strip()]\r\n                    molecules.extend(lines)\r\n    except Exception as e:\r\n        pass\r\n    \r\n    return molecules\r\n\r\ndef compute_morgan_fingerprint(smiles, radius=2):\r\n    \"\"\"\r\n    Compute Morgan fingerprint for a molecule.\r\n    Uses radius=2 and includes chirality as specified.\r\n    \"\"\"\r\n    try:\r\n        mol = Chem.MolFromSmiles(smiles)\r\n        if mol is not None:\r\n            return AllChem.GetMorganFingerprintAsBitVect(mol, radius=radius, nBits=2048, useChirality=True)\r\n    except Exception as e:\r\n        pass\r\n    \r\n    return None\r\n"]
[223.765836, "o", "\u001b[?2004hroot@0ceb20fbc37f:~# "]
