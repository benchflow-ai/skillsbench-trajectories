[?2004hroot@c51ab15f5ccf:~# cat << 'EOF' > recover_budget.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> sheet_budget = wb['Budget by Directorate']
[?2004l[?2004h> sheet_yoy = wb['YoY Changes (%)']
[?2004l[?2004h> sheet_share = wb['Directorate Shares (%)']
[?2004l[?2004h> sheet_growth = wb['Growth Analysis']
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Calculate 2016 Total
[?2004l[?2004h> # Row index 5 (2016), Cols 2 to 10 are directorates
[?2004l[?2004h> sum_2016 = 0
[?2004l[?2004h> for col in range(2, 11):
[?2004l[?2004h>     sum_2016 += sheet_budget.cell(row=5, column=col).value
[?2004l[?2004h> sheet_budget.cell(row=5, column=11).value = sum_2016
[?2004l[?2004h> 
[?2004l[?2004h> # 2. 2016 Space Operations Share
[?2004l[?2004h> # Row 5, Col 6 is Space Operations
[?2004l[?2004h> space_ops_2016 = sheet_budget.cell(row=5, column=6).value
[?2004l[?2004h> sheet_share.cell(row=5, column=6).value = round(space_ops_2016 / sum_2016 * 100, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. 2019 Space Operations
[?2004l[?2004h> # Total 2019 is 21688 (Row 8, Col 11)
[?2004l[?2004h> sum_2019_known = 0
[?2004l[?2004h> for col in [2, 3, 4, 5, 7, 8, 9, 10]:
[?2004l[?2004h>     sum_2019_known += sheet_budget.cell(row=8, column=col).value
[?2004l[?2004h> total_2019 = sheet_budget.cell(row=8, column=11).value
[?2004l[?2004h> space_ops_2019 = total_2019 - sum_2019_known
[?2004l[?2004h> sheet_budget.cell(row=8, column=6).value = space_ops_2019
[?2004l[?2004h> 
[?2004l[?2004h> # 4. 2019 Space Technology YoY Change
[?2004l[?2004h> # (2019 - 2018) / 2018
[?2004l[?2004h> st_2018 = sheet_budget.cell(row=7, column=4).value
[?2004l[?2004h> st_2019 = sheet_budget.cell(row=8, column=4).value
[?2004l[?2004h> sheet_yoy.cell(row=7, column=4).value = round((st_2019 - st_2018) / st_2018 * 100, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 5. 2020 Science
[?2004l[?2004h> # Total 2020 is 22513 (Row 9, Col 11)
[?2004l[?2004h> sum_2020_known = 0
[?2004l[?2004h> for col in range(3, 11):
[?2004l[?2004h>     sum_2020_known += sheet_budget.cell(row=9, column=col).value
[?2004l[?2004h> total_2020 = sheet_budget.cell(row=9, column=11).value
[?2004l[?2004h> science_2020 = total_2020 - sum_2020_known
[?2004l[?2004h> sheet_budget.cell(row=9, column=2).value = science_2020
[?2004l[?2004h> 
[?2004l[?2004h> # 6. 2021 Exploration & 2021 Total
[?2004l[?2004h> # 2021 YoY change for Total is 3.43% (Sheet YoY, Row 9, Col 11)
[?2004l[?2004h> total_2020 = sheet_budget.cell(row=9, column=11).value
[?2004l[?2004h> total_2021 = round(total_2020 * (1 + 3.43 / 100))
[?2004l[?2004h> sheet_budget.cell(row=10, column=11).value = total_2021
[?2004l[?2004h> 
[?2004l[?2004h> # 2021 Exploration
[?2004l[?2004h> # We have 2021 YoY for Exploration: 8.94% (Sheet YoY, Row 9, Col 5)
[?2004l[?2004h> exp_2020 = sheet_budget.cell(row=9, column=5).value
[?2004l[?2004h> exp_2021 = round(exp_2020 * (1 + 8.94 / 100))
[?2004l[?2004h> sheet_budget.cell(row=10, column=5).value = exp_2021
[?2004l[?2004h> 
[?2004l[?2004h> # 7. 2021 Science YoY Change
[?2004l[?2004h> science_2021 = sheet_budget.cell(row=10, column=2).value
[?2004l[?2004h> science_2020 = sheet_budget.cell(row=9, column=2).value
[?2004l[?2004h> sheet_yoy.cell(row=9, column=2).value = round((science_2021 - science_2020) / science_2020 * 100, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 8. 2021 Space Operations YoY Change
[?2004l[?2004h> so_2021 = sheet_budget.cell(row=10, column=6).value
[?2004l[?2004h> so_2020 = sheet_budget.cell(row=9, column=6).value
[?2004l[?2004h> sheet_yoy.cell(row=9, column=6).value = round((so_2021 - so_2020) / so_2020 * 100, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 9. 2021 Science Share
[?2004l[?2004h> sheet_share.cell(row=10, column=2).value = round(science_2021 / total_2021 * 100, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 10. Growth Analysis
[?2004l[?2004h> # FY2019 Budget ($M) Exploration
[?2004l[?2004h> sheet_growth.cell(row=5, column=5).value = sheet_budget.cell(row=8, column=5).value
[?2004l[?2004h> 
[?2004l[?2004h> # 5-Year CAGR (%) Exploration (FY2019-2024)
[?2004l[?2004h> exp_2019 = sheet_growth.cell(row=5, column=5).value
[?2004l[?2004h> exp_2024 = sheet_growth.cell(row=6, column=5).value
[?2004l[?2004h> cagr_exp = ((exp_2024 / exp_2019) ** (1/5) - 1) * 100
[?2004l[?2004h> sheet_growth.cell(row=4, column=5).value = round(cagr_exp, 2)
[?2004l[?2004h> 
[?2004l[?2004h> # 5-Year Change ($M) Science
[?2004l[?2004h> sci_2019 = sheet_growth.cell(row=5, column=2).value
[?2004l[?2004h> sci_2024 = sheet_growth.cell(row=6, column=2).value
[?2004l[?2004h> sheet_growth.cell(row=7, column=2).value = sci_2024 - sci_2019
[?2004l[?2004h> 
[?2004l[?2004h> # Avg Annual Budget ($M) Science
[?2004l[?2004h> # Need to find Science budgets for 2019, 2020, 2021, 2022, 2023, 2024
[?2004l[?2004h> # 2019: 6906
[?2004l[?2004h> # 2020: calculated science_2020
[?2004l[?2004h> # 2021: 7301
[?2004l[?2004h> # 2022: science_2021 * (1 + 4.29/100) = 7301 * 1.0429 = 7614.2129
[?2004l[?2004h> # Wait, I should check if I have 2022, 2023 data.
[?2004l[?2004h> # Actually, let's look at the other sheets again.
[?2004l[?2004h> # YoY sheet has 2022 data. 
[?2004l[?2004h> # Science 2022 YoY: 4.29%
[?2004l[?2004h> # Science 2021: 7301
[?2004l[?2004h> sci_2022 = 7301 * (1 + 4.29 / 100)
[?2004l[?2004h> # I don't have 2023 YoY data in the snippet. Let me check the YoY sheet more carefully.
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('nasa_budget_recovered.xlsx')
