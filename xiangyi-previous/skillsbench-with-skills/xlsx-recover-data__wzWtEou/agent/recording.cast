[69.415865, "i", "cat << 'EOF' > recover_budget.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\n\nsheet_budget = wb['Budget by Directorate']\nsheet_yoy = wb['YoY Changes (%)']\nsheet_share = wb['Directorate Shares (%)']\nsheet_growth = wb['Growth Analysis']\n\n# 1. Budget by Directorate: 2016 Total\nsum_2016 = 0\nfor col in range(2, 11):\n    sum_2016 += sheet_budget.cell(row=5, column=col).value\nsheet_budget.cell(row=5, column=11).value = sum_2016\n\n# 2. Directorate Shares: 2016 Space Operations Share\nspace_ops_2016 = sheet_budget.cell(row=5, column=6).value\nsheet_share.cell(row=5, column=6).value = round(space_ops_2016 / sum_2016 * 100, 2)\n\n# 3. Budget by Directorate: 2019 Space Operations\n# Total 2019 is 21688\ntotal_2019 = 21688\nsum_2019_known = 0\nfor col in [2, 3, 4, 5, 7, 8, 9, 10]:\n    sum_2019_known += sheet_budget.cell(row=8, column=col).value\nspace_ops_2019 = total_2019 - sum_2019_known\nsheet_budget.cell(row=8, column=6).value = space_ops_2019\n\n# 4. YoY Changes: 2019 Space Technology\nst_2018 = sheet_budget.cell(row=7, column=4).value\nst_2019 = sheet_budget.cell(row=8, column=4).value\nsheet_yoy.cell(row=7, column=4).value = round((st_2019 - st_2018) / st_2018 * 100, 2)\n\n# 5. Budget by Directorate: 2020 Science\ntotal_2020 = 22513\nsum_2020_known = 0\nfor col in range(3, 11):\n    sum_2020_known += sheet_budget.cell(row=9, column=col).value\nscience_2020 = total_2020 - sum_2020_known\nsheet_budget.cell(row=9, column=2).value = science_2020\n\n# 6. Budget by Directorate: 2021 Total and Exploration\n# YoY change for Total 2021 is 3.43%\ntotal_2021 = round(total_2020 * (1 + 3.43 / 100))\nsheet_budget.cell(row=10, column=11).value = total_2021\n# YoY change for Exploration 2021 is 8.94%\nexp_2020 = sheet_budget.cell(row=9, column=5).value\nexp_2021 = round(exp_2020 * (1 + 8.94 / 100))\nsheet_budget.cell(row=10, column=5).value = exp_2021\n\n# 7. YoY Changes: 2021 Science and Space Operations\nscience_2021 = sheet_budget.cell(row=10, column=2).value\nscience_2020 = sheet_budget.cell(row=9, column=2).value\nsheet_yoy.cell(row=9, column=2).value = round((science_2021 - science_2020) / science_2020 * 100, 2)\n\nso_2021 = sheet_budget.cell(row=10, column=6).value\nso_2020 = sheet_budget.cell(row=9, column=6).value\nsheet_yoy.cell(row=9, column=6).value = round((so_2021 - so_2020) / so_2020 * 100, 2)\n\n# 8. Directorate Shares: 2021 Science Share\nsheet_share.cell(row=10, column=2).value = round(science_2021 / total_2021 * 100, 2)\n\n# 9. Growth Analysis\n# FY2019 Exploration Budget\nexp_2019 = sheet_budget.cell(row=8, column=5).value\nsheet_growth.cell(row=5, column=5).value = exp_2019\n\n# 5-Year CAGR Exploration\nexp_2024 = sheet_growth.cell(row=6, column=5).value\ncagr_exp = ((exp_2024 / exp_2019) ** (1/5) - 1) * 100\nsheet_growth.cell(row=4, column=5).value = round(cagr_exp, 2)\n\n# 5-Year Change Science\nsci_2019 = sheet_growth.cell(row=5, column=2).value\nsci_2024 = sheet_growth.cell(row=6, column=2).value\nsheet_growth.cell(row=7, column=2).value = sci_2024 - sci_2019\n\n# Avg Annual Budget Science (FY2019-2024)\n# Budgets for Science: 2019, 2020, 2021, 2022, 2023, 2024\n# We have 2019, 2020, 2021 from Budget sheet\nsci_2019 = sheet_budget.cell(row=8, column=2).value\nsci_2020 = sheet_budget.cell(row=9, column=2).value\nsci_2021 = sheet_budget.cell(row=10, column=2).value\n# Calculate 2022, 2023, 2024 from YoY changes\n# 2022 YoY: 4.29%\nsci_2022 = sci_2021 * (1 + 4.29 / 100)\n# 2023 YoY: 8.51%\nsci_2023 = sci_2022 * (1 + 8.51 / 100)\n# 2024 YoY: 2.15%\nsci_2024_calc = sci_2023 * (1 + 2.15 / 100)\n\nsci_avg = (sci_2019 + sci_2020 + sci_2021 + sci_2022 + sci_2023 + sci_2024_calc) / 6\nsheet_growth.cell(row=8, column=2).value = round(sci_avg, 1)\n\nwb.save('nasa_budget_recovered.xlsx')\nEOF\npython3 recover_budget.py\n"]
