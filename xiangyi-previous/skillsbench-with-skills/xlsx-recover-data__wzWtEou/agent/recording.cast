[8.0866, "o", " [['Budget Share by Directorate (% of Total)', None, None, None, None, None, None, None, None, None], [None, None, None, None, None, None, None, None, None, None], ['Fiscal Year', 'Science', 'Aeronautics', 'Space Technology', 'Exploration', 'Space Operations', 'STEM Engagement', 'Safety & Mission', 'Construction', 'Inspector General'], [2015, 26.91, 2.93, 3.06, 23.12, 25.81, 0.61, 14.73, 2.64, 0.19], [2016, 28.98, 3.32, 3.56, 20.9, '???', 0.6, 14.36, 2.02, 0.19], [2017, 29.19, 3.34, 3.47, 21.89, 25.07, 0.56, 14.33, 1.96, 0.19], [2018, 30.06, 3.31, 3.67, 23.14, 22.96, 0.53, 13.66, 2.47, 0.19], [2019, 31.84, 3.34, 4.27, 23.27, 21.39, 0.51, 12.7, 2.48, 0.19], [2020, 31.71, 3.64, 4.89, 26.73, 17.72, 0.53, 12.94, 1.66, 0.19], [2021, '???', 3.56, 4.72, 28.15, 17.12, 0.55, 12.68, 1.67, 0.19]]\r\n\r\nSheet: Growth Analysis\r\n [['5-Year Growth Analysis (FY2019-2024)', None, None, None, None, None, None, None, None, None], [None, None, None, None, None, None, None, None, None, None], ['Metric', 'Science', 'Aeronautics', 'Space Technology', 'Exploration', 'Space Operations', 'STEM Engagement', 'Safety & Mission', 'Construction', 'Inspector General'], ['5-Year CAGR (%)', 4.09, 5.91, 4.98, '???', -0.81, 5.39, 2.14, -4.29, 3.2], ['FY2019 Budget ($M)', 6906, 725, 927, '???', 4639, 110, 2755, 538, 41], ['FY2024 Budget ($M)', 8440, 966, 1182, 7618, 4454, 143, 3062, 432, 48], ['5-Year Change ($M)', '???', 241, 255, 2571, -185, 33, 307, -106, 7], ['Avg Annual Budget ($M)', '???', 859.3, 1100.2, 6721.8, 4227.7, 131, 2970.2, 430.2, 44.8], [None, None, None, None, None, None, None, None, None, None], [None, None, None, None, None, None, None, None, None, None]]\r\n"]
