[31.10117, "o", "[['Fiscal Year', 'Science', 'Aeronautics', 'Space Technology', 'Exploration', 'Space Operations', 'STEM Engagement', 'Safety & Mission', 'Construction', 'Inspector General', 'Total'], [2016, 6.58, 12.08, 15.27, -10.56, 0, -3.36, -3.52, -24.47, 0, -1.04], [2017, 3.15, 3.12, -0.15, 7.3, -1.55, -4.35, 2.2, -0.26, 2.7, 2.42], [2018, 7.93, 3.79, 10.79, 10.78, -4.02, 0, -0.11, 31.7, 2.63, 4.78], [2019, 10.99, 5.84, '???', 5.37, -2.38, 0, -2.55, 5.28, 5.13, 4.79], [2020, 3.37, 12.97, 18.66, 19.22, -14.01, 9.09, 5.74, -30.67, 4.88, 3.8], [2021, '???', 1.22, 0, 8.94, '???', 5.83, 1.37, 4.56, 2.33, 3.43], [2022, 4.29, 6.27, 0, 14.05, 1.4, 12.6, 2.68, 8.72, 4.55, 6.33], [2023, 8.51, 6.24, 8.36, 1.9, 5.29, 0, 2.44, 0, 2.17, 4.95], [2024, 2.15, 3.21, -0.84, 0, 4.65, 0, -1.42, 1.89, 2.13, 1.39]]\r\n"]
