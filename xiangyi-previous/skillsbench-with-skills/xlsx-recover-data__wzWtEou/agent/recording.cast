[29.850108, "i", "cat << 'EOF' > recover_budget.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\n\nsheet_budget = wb['Budget by Directorate']\nsheet_yoy = wb['YoY Changes (%)']\nsheet_share = wb['Directorate Shares (%)']\nsheet_growth = wb['Growth Analysis']\n\n# 1. Calculate 2016 Total\n# Row index 5 (2016), Cols 2 to 10 are directorates\nsum_2016 = 0\nfor col in range(2, 11):\n    sum_2016 += sheet_budget.cell(row=5, column=col).value\nsheet_budget.cell(row=5, column=11).value = sum_2016\n\n# 2. 2016 Space Operations Share\n# Row 5, Col 6 is Space Operations\nspace_ops_2016 = sheet_budget.cell(row=5, column=6).value\nsheet_share.cell(row=5, column=6).value = round(space_ops_2016 / sum_2016 * 100, 2)\n\n# 3. 2019 Space Operations\n# Total 2019 is 21688 (Row 8, Col 11)\nsum_2019_known = 0\nfor col in [2, 3, 4, 5, 7, 8, 9, 10]:\n    sum_2019_known += sheet_budget.cell(row=8, column=col).value\ntotal_2019 = sheet_budget.cell(row=8, column=11).value\nspace_ops_2019 = total_2019 - sum_2019_known\nsheet_budget.cell(row=8, column=6).value = space_ops_2019\n\n# 4. 2019 Space Technology YoY Change\n# (2019 - 2018) / 2018\nst_2018 = sheet_budget.cell(row=7, column=4).value\nst_2019 = sheet_budget.cell(row=8, column=4).value\nsheet_yoy.cell(row=7, column=4).value = round((st_2019 - st_2018) / st_2018 * 100, 2)\n\n# 5. 2020 Science\n# Total 2020 is 22513 (Row 9, Col 11)\nsum_2020_known = 0\nfor col in range(3, 11):\n    sum_2020_known += sheet_budget.cell(row=9, column=col).value\ntotal_2020 = sheet_budget.cell(row=9, column=11).value\nscience_2020 = total_2020 - sum_2020_known\nsheet_budget.cell(row=9, column=2).value = science_2020\n\n# 6. 2021 Exploration & 2021 Total\n# 2021 YoY change for Total is 3.43% (Sheet YoY, Row 9, Col 11)\ntotal_2020 = sheet_budget.cell(row=9, column=11).value\ntotal_2021 = round(total_2020 * (1 + 3.43 / 100))\nsheet_budget.cell(row=10, column=11).value = total_2021\n\n# 2021 Exploration\n# We have 2021 YoY for Exploration: 8.94% (Sheet YoY, Row 9, Col 5)\nexp_2020 = sheet_budget.cell(row=9, column=5).value\nexp_2021 = round(exp_2020 * (1 + 8.94 / 100))\nsheet_budget.cell(row=10, column=5).value = exp_2021\n\n# 7. 2021 Science YoY Change\nscience_2021 = sheet_budget.cell(row=10, column=2).value\nscience_2020 = sheet_budget.cell(row=9, column=2).value\nsheet_yoy.cell(row=9, column=2).value = round((science_2021 - science_2020) / science_2020 * 100, 2)\n\n# 8. 2021 Space Operations YoY Change\nso_2021 = sheet_budget.cell(row=10, column=6).value\nso_2020 = sheet_budget.cell(row=9, column=6).value\nsheet_yoy.cell(row=9, column=6).value = round((so_2021 - so_2020) / so_2020 * 100, 2)\n\n# 9. 2021 Science Share\nsheet_share.cell(row=10, column=2).value = round(science_2021 / total_2021 * 100, 2)\n\n# 10. Growth Analysis\n# FY2019 Budget ($M) Exploration\nsheet_growth.cell(row=5, column=5).value = sheet_budget.cell(row=8, column=5).value\n\n# 5-Year CAGR (%) Exploration (FY2019-2024)\nexp_2019 = sheet_growth.cell(row=5, column=5).value\nexp_2024 = sheet_growth.cell(row=6, column=5).value\ncagr_exp = ((exp_2024 / exp_2019) ** (1/5) - 1) * 100\nsheet_growth.cell(row=4, column=5).value = round(cagr_exp, 2)\n\n# 5-Year Change ($M) Science\nsci_2019 = sheet_growth.cell(row=5, column=2).value\nsci_2024 = sheet_growth.cell(row=6, column=2).value\nsheet_growth.cell(row=7, column=2).value = sci_2024 - sci_2019\n\n# Avg Annual Budget ($M) Science\n# Need to find Science budgets for 2019, 2020, 2021, 2022, 2023, 2024\n# 2019: 6906\n# 2020: calculated science_2020\n# 2021: 7301\n# 2022: science_2021 * (1 + 4.29/100) = 7301 * 1.0429 = 7614.2129\n# Wait, I should check if I have 2022, 2023 data.\n# Actually, let's look at the other sheets again.\n# YoY sheet has 2022 data. \n# Science 2022 YoY: 4.29%\n# Science 2021: 7301\nsci_2022 = 7301 * (1 + 4.29 / 100)\n# I don't have 2023 YoY data in the snippet. Let me check the YoY sheet more carefully.\n\nwb.save('nasa_budget_recovered.xlsx')\nEOF\n"]
[29.853135, "o", "cat << 'EOF' > recover_budget.py\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sheet_budget = wb['Budget by Directorate']\r\n\u001b[?2004l\r\u001b[?2004h> sheet_yoy = wb['YoY Changes (%)']\r\n\u001b[?2004l\r\u001b[?2004h> sheet_share = wb['Directorate Shares (%)']\r\n\u001b[?2004l\r\u001b[?2004h> sheet_growth = wb['Growth Analysis']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 1. Calculate 2016 Total\r\n\u001b[?2004l\r\u001b[?2004h> # Row index 5 (2016), Cols 2 to 10 are directorates\r\n\u001b[?2004l\r\u001b[?2004h> sum_2016 = 0\r\n\u001b[?2004l\r\u001b[?2004h> for col in range(2, 11):\r\n\u001b[?2004l\r\u001b[?2004h>     sum_2016 += sheet_budget.cell(row=5, column=col).value\r\n\u001b[?2004l\r\u001b[?2004h> sheet_budget.cell(row=5, column=11).value = sum_2016\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2. 2016 Space Operations Share\r\n\u001b[?2004l\r\u001b[?2004h> # Row 5, Col 6 is Space Operations\r\n\u001b[?2004l\r\u001b[?2004h> space_ops_2016 = sheet_budget.cell(row=5, column=6).value\r\n\u001b[?2004l\r\u001b[?2004h> sheet_share.cell(row=5, column=6).value = round(space_ops_2016 / sum_2016 * 100, 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. 2019 Space Operations\r\n\u001b[?2004l\r\u001b[?2004h> # Total 2019 is 21688 (Row 8, Col 11)\r\n\u001b[?2004l\r\u001b[?2004h> sum_2019_known = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
