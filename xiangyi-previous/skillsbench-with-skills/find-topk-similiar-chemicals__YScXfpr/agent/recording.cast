[120.316904, "i", "python3 << 'EOF'\nimport pubchempy as pcp\nimport warnings\nwarnings.filterwarnings('ignore')\n\ntest_molecules = ['Acetylsalicylic acid', 'Ibuprofen', 'Phenol']\nfor mol in test_molecules:\n    try:\n        compounds = pcp.get_compounds(mol, 'name')\n        if compounds:\n            smiles = compounds[0].isomeric_smiles\n            print(f\"{mol}: {smiles}\")\n        else:\n            print(f\"{mol}: NOT FOUND\")\n    except Exception as e:\n        print(f\"{mol}: ERROR - {e}\")\nEOF\n"]
