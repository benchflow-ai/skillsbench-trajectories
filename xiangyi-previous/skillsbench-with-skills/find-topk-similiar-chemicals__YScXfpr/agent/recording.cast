[143.276757, "o", "\u001b[?2004h> "]
[143.276871, "o", "    # Small delay after getting target to avoid rate limiting\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.276881, "o", "> "]
[143.27693, "o", "    time.sleep(0.2)\r\n\u001b[?2004l\r"]
[143.276959, "o", "\u001b[?2004h"]
[143.276993, "o", ">     \r\n\u001b[?2004l\r"]
[143.277021, "o", "\u001b[?2004h> "]
[143.277071, "o", "    # Calculate similarities\r\n\u001b[?2004l\r"]
[143.277101, "o", "\u001b[?2004h"]
[143.277133, "o", "> "]
[143.277169, "o", "    similarities = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.2772, "o", "> "]
[143.277254, "o", "    for mol_name in molecule_names:\r\n\u001b[?2004l\r"]
[143.277291, "o", "\u001b[?2004h"]
[143.277314, "o", "> "]
[143.277379, "o", "        # Skip if it's the same as target\r\n\u001b[?2004l\r"]
[143.277395, "o", "\u001b[?2004h"]
[143.277401, "o", "> "]
[143.277517, "o", "        if mol_name == target_molecule_name:\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.277527, "o", "> "]
[143.277577, "o", "            continue\r\n\u001b[?2004l\r"]
[143.27761, "o", "\u001b[?2004h> "]
[143.277641, "o", "        \r\n\u001b[?2004l\r"]
[143.277649, "o", "\u001b[?2004h"]
[143.277689, "o", "> "]
[143.277805, "o", "        # Add small delay between API calls to avoid rate limiting\r\n\u001b[?2004l\r"]
[143.277815, "o", "\u001b[?2004h> "]
[143.277881, "o", "        time.sleep(0.15)\r\n\u001b[?2004l\r"]
[143.27791, "o", "\u001b[?2004h"]
[143.277943, "o", ">         \r\n"]
[143.277968, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[143.278062, "o", "        mol_smiles = name_to_smiles(mol_name)\r\n\u001b[?2004l\r"]
[143.278073, "o", "\u001b[?2004h> "]
[143.278189, "o", "        mol_fp = get_morgan_fingerprint(mol_smiles)\r\n\u001b[?2004l\r"]
[143.278198, "o", "\u001b[?2004h"]
[143.278205, "o", "> "]
[143.278255, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[143.278278, "o", "> "]
[143.278336, "o", "        if mol_fp is not None:\r\n\u001b[?2004l\r"]
[143.278369, "o", "\u001b[?2004h"]
[143.278403, "o", "> "]
[143.278461, "o", "            # Calculate Tanimoto similarity\r\n\u001b[?2004l\r"]
[143.278491, "o", "\u001b[?2004h"]
[143.278522, "o", "> "]
[143.278643, "o", "            similarity = DataStructs.TanimotoSimilarity(target_fp, mol_fp)\r\n\u001b[?2004l\r"]
[143.278654, "o", "\u001b[?2004h> "]
[143.27878, "o", "            similarities.append((mol_name, similarity))\r\n\u001b[?2004l\r"]
[143.278792, "o", "\u001b[?2004h> "]
[143.278815, "o", "    \r\n\u001b[?2004l\r"]
[143.278853, "o", "\u001b[?2004h"]
[143.278881, "o", "> "]
[143.278985, "o", "    # Sort by similarity (descending), then alphabetically by name\r\n\u001b[?2004l\r"]
[143.278996, "o", "\u001b[?2004h> "]
[143.279113, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r"]
[143.279124, "o", "\u001b[?2004h> "]
[143.279147, "o", "    \r\n\u001b[?2004l\r"]
[143.279161, "o", "\u001b[?2004h"]
[143.279168, "o", "> "]
[143.279255, "o", "    # Return top k molecule names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.279347, "o", "    result = [name for name, sim in similarities[:top_k]]\r\n\u001b[?2004l\r"]
[143.279355, "o", "\u001b[?2004h> "]
[143.27939, "o", "    return result\r\n\u001b[?2004l\r"]
[143.279398, "o", "\u001b[?2004h> "]
[143.279415, "o", "EOF\r\n\u001b[?2004l\r"]
[143.443538, "o", "\u001b[?2004hroot@809c3577c76e:~# "]
