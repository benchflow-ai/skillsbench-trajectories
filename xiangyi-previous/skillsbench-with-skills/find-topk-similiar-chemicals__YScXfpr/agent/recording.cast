[143.269212, "i", "cat > /root/workspace/solution.py << 'EOF'\nimport pdfplumber\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom rdkit import DataStructs\nimport time\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    \"\"\"\n    Find top k most similar molecules to the target molecule from a pool.\n    \n    Args:\n        target_molecule_name: Name of the target molecule\n        molecule_pool_filepath: Path to PDF file containing molecule names\n        top_k: Number of top similar molecules to return\n        \n    Returns:\n        List of molecule names sorted by similarity (descending), then alphabetically\n    \"\"\"\n    \n    # Extract molecule names from PDF\n    molecule_names = []\n    with pdfplumber.open(molecule_pool_filepath) as pdf:\n        for page in pdf.pages:\n            text = page.extract_text()\n            if text:\n                lines = text.strip().split('\\n')\n                for line in lines:\n                    line = line.strip()\n       "]
[143.269274, "i", "             if line:\n                        molecule_names.append(line)\n    \n    # Function to convert chemical name to SMILES using PubChem with retry logic\n    def name_to_smiles(name, max_retries=3):\n        for attempt in range(max_retries):\n            try:\n                compounds = pcp.get_compounds(name, 'name')\n                if compounds:\n                    # Use isomeric_smiles to preserve chirality\n                    return compounds[0].isomeric_smiles\n                return None\n            except Exception as e:\n                if attempt < max_retries - 1:\n                    # Exponential backoff: wait longer between retries\n                    wait_time = (2 ** attempt) * 0.5\n                    time.sleep(wait_time)\n                else:\n                    return None\n        return None\n    \n    # Function to get Morgan fingerprint\n    def get_morgan_fingerprint(smiles):\n        if smiles is None:\n            return None\n        try:\n            mol = Chem.MolFromSmiles(smiles)\n     "]
[143.269325, "i", "       if mol is None:\n                return None\n            # Morgan fingerprint with radius=2 and useChirality=True\n            fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius=2, nBits=2048, useChirality=True)\n            return fp\n        except Exception as e:\n            return None\n    \n    # Get target molecule fingerprint\n    target_smiles = name_to_smiles(target_molecule_name)\n    target_fp = get_morgan_fingerprint(target_smiles)\n    \n    if target_fp is None:\n        return []\n    \n    # Small delay after getting target to avoid rate limiting\n    time.sleep(0.2)\n    \n    # Calculate similarities\n    similarities = []\n    for mol_name in molecule_names:\n        # Skip if it's the same as target\n        if mol_name == target_molecule_name:\n            continue\n        \n        # Add small delay between API calls to avoid rate limiting\n        time.sleep(0.15)\n        \n        mol_smiles = name_to_smiles(mol_name)\n        mol_fp = get_morgan_fingerprint(mol_smiles)\n        \n        if mol_fp i"]
[143.269367, "i", "s not None:\n            # Calculate Tanimoto similarity\n            similarity = DataStructs.TanimotoSimilarity(target_fp, mol_fp)\n            similarities.append((mol_name, similarity))\n    \n    # Sort by similarity (descending), then alphabetically by name\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n    \n    # Return top k molecule names\n    result = [name for name, sim in similarities[:top_k]]\n    return result\nEOF\n"]
