[74.006328, "i", "python3 << 'EOF'\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\n\n# Test PubChem lookup\nprint(\"Testing PubChem lookup for Ibuprofen...\")\ntry:\n    compounds = pcp.get_compounds('Ibuprofen', 'name')\n    if compounds:\n        print(f\"Found: {compounds[0].canonical_smiles}\")\n        mol = Chem.MolFromSmiles(compounds[0].canonical_smiles)\n        if mol:\n            fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius=2, nBits=2048, useChirality=True)\n            print(f\"Fingerprint generated successfully\")\n    else:\n        print(\"No compounds found\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
