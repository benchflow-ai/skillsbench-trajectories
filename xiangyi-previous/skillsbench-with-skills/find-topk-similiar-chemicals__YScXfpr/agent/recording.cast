[28.103119, "o", "Guaiacol\r\nPropyl 2-hydroxybenzoate\r\nAcetylsalicylic acid\r\nPhenylpyruvic acid\r\nEthanol\r\n2-Ethoxybenzoic acid\r\nToluene\r\nCarbamazepine\r\nSuccinic acid\r\nPhenyl formate\r\nGlucose\r\nAcetic acid\r\nIbuprofen\r\nNaproxen\r\nPropranolol\r\nAnisole\r\nWarfarin\r\nMorphine\r\nHydroquinone\r\nPhenol\r\nTryptophan\r\nPhenylalanine\r\nCodeine\r\nTheobromine\r\nMalic acid\r\nNicotine\r\n3-Hydroxybenzoic acid\r\n"]
