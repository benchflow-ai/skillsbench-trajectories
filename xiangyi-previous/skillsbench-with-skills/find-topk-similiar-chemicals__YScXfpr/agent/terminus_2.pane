[?2004l[?2004h>     # Function to convert chemical name to SMILES using PubChem with retry logic
[?2004l[?2004h>     def name_to_smiles(name, max_retries=3):
[?2004l[?2004h>         for attempt in range(max_retries):
[?2004l[?2004h>             try:
[?2004l[?2004h>                 compounds = pcp.get_compounds(name, 'name')
[?2004l[?2004h>                 if compounds:
