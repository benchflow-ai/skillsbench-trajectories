[?2004l[?2004h>         try:
[?2004l[?2004h>             mol = Chem.MolFromSmiles(smiles)
[?2004l[?2004h>             if mol is None:
[?2004l[?2004h>                 return None
[?2004l[?2004h>             # Morgan fingerprint with radius=2 and useChirality=True
[?2004l[?2004h>             fp = AllChem.GetMorganFingerprintAsBitVect(mol, radius=2, nBits=2048, useChirality=True)
[?2004l[?2004h>             return fp
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             return None
[?2004l[?2004h>     
[?2004l[?2004h>     # Get target molecule fingerprint
[?2004l[?2004h>     target_smiles = name_to_smiles(target_molecule_name)
[?2004l[?2004h>     target_fp = get_morgan_fingerprint(target_smiles)
[?2004l[?2004h>     
[?2004l[?2004h>     if target_fp is None:
[?2004l[?2004h>         return []
[?2004l[?2004h>     
[?2004l[?2004h>     # Small delay after getting target to avoid rate limiting
[?2004l[?2004h>     time.sleep(0.2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate similarities
[?2004l[?2004h>     similarities = []
[?2004l[?2004h>     for mol_name in molecule_names:
[?2004l[?2004h>         # Skip if it's the same as target
[?2004l[?2004h>         if mol_name == target_molecule_name:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Add small delay between API calls to avoid rate limiting
[?2004l[?2004h>         time.sleep(0.15)
[?2004l[?2004h>         
[?2004l[?2004h>         mol_smiles = name_to_smiles(mol_name)
[?2004l[?2004h>         mol_fp = get_morgan_fingerprint(mol_smiles)
[?2004l[?2004h>         
[?2004l[?2004h>         if mol_fp is not None:
[?2004l[?2004h>             # Calculate Tanimoto similarity
[?2004l[?2004h>             similarity = DataStructs.TanimotoSimilarity(target_fp, mol_fp)
[?2004l[?2004h>             similarities.append((mol_name, similarity))
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by similarity (descending), then alphabetically by name
[?2004l[?2004h>     similarities.sort(key=lambda x: (-x[1], x[0]))
[?2004l[?2004h>     
[?2004l[?2004h>     # Return top k molecule names
[?2004l[?2004h>     result = [name for name, sim in similarities[:top_k]]
[?2004l[?2004h>     return result
