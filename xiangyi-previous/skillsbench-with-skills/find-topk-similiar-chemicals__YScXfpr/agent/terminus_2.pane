[?2004l[?2004h>     """
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract molecule names from PDF
[?2004l[?2004h>     molecule_names = []
[?2004l[?2004h>     with pdfplumber.open(molecule_pool_filepath) as pdf:
[?2004l[?2004h>         for page in pdf.pages:
[?2004l[?2004h>             text = page.extract_text()
[?2004l[?2004h>             if text:
