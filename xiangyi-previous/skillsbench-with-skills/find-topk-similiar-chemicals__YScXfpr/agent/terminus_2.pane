[?2004l[?2004h>                 return None
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 if attempt < max_retries - 1:
[?2004l[?2004h>                     # Exponential backoff: wait longer between retries
[?2004l[?2004h>                     wait_time = (2 ** attempt) * 0.5
[?2004l[?2004h>                     time.sleep(wait_time)
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     return None
[?2004l[?2004h>         return None
[?2004l[?2004h>     
