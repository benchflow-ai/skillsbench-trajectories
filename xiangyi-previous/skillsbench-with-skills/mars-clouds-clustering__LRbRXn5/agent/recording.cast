[34.535463, "o", "python3 optimize_dbscan.py\r\n\u001b[?2004l\r"]
[115.766584, "i", "cat << 'EOF' > optimize_dbscan.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom multiprocessing import Pool\n\ndef load_data():\n    citsci = pd.read_csv('/root/data/citsci_train.csv', usecols=['file_rad', 'x', 'y'])\n    expert = pd.read_csv('/root/data/expert_train.csv', usecols=['file_rad', 'x', 'y'])\n    return citsci, expert\n\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\n        return 0, []\n    dists = cdist(cluster_centroids, expert_points, metric='euclidean')\n    matched_expert_indices = set()\n    matched_cluster_indices = set()\n    matches = []\n    flat_dists = []\n    for i in range(len(cluster_centroids)):\n        for j in range(len(expert_points)):\n            if dists[i, j] <= max_dist:\n                flat_dists.append((dists[i, j], i, j))\n    flat_dists.sort()\n    for d, i, j in flat_dists:\n        if i not in matched_cluster_indices and j not i"]
[115.766636, "o", "cat << 'EOF' > optimize_dbscan.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.cluster"]
[115.766644, "i", "n matched_expert_indices:\n            matched_cluster_indices.add(i)\n            matched_expert_indices.add(j)\n            matches.append(d)\n    return len(matches), matches\n\ndef evaluate_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    if len(citsci_points) == 0:\n        return 0.0, np.nan\n    def custom_dist(a, b):\n        dx = a[0] - b[0]\n        dy = a[1] - b[1]\n        return np.sqrt((shape_weight * dx)**2 + ((2 - shape_weight) * dy)**2)\n    # Precompute distance matrix for custom metric\n    # Using cdist with a lambda is slow, but for DBSCAN we need a distance matrix or a metric\n    # Given we use the same points, we can compute it once.\n    # However, sklearn DBSCAN with metric callable is fine if the number of points is small.\n    # Let's use precomputed distance matrix to be faster.\n    from scipy.spatial.distance import pdist, squareform\n    \n    # custom distance between point i and j\n    # d(a, b) = sqrt((w * Δx)² + ((2 - w) * Δy)²)\n    # We can scale the coordinate"]
[115.766671, "o", " import DBSCAN"]
[116.067589, "o", "\r\nfrom scipy.spatial.distance import cdist\r\nfrom multiprocessing import Pool\r\n\r\ndef load_data():\r\n    citsci = pd.read_csv('/root/data/citsci_train.csv', usecols=['file_rad', 'x', 'y'])\r\n    expert = pd.read_csv('/root/data/expert_train.csv', usecols=['file_rad', 'x', 'y'])\r\n    return citsci, expert\r\n\r\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\r\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\r\n        return 0, []\r\n    dists = cdist(cluster_centroids, expert_points, metric='euclidean')\r\n    matched_expert_indices = set()\r\n    matched_cluster_indices = set()\r\n    matches = []\r\n    flat_dists = []\r\n    for i in range(len(cluster_centroids)):\r\n        for j in range(len(expert_points)):\r\n            if dists[i, j] <= max_dist:\r\n                flat_dists.append((dists[i, j], i, j))\r\n    flat_dists.sort()\r\n    for d, i, j in flat_dists:\r\n        if i not in matched_cluster_indices and j not in matched_expert_indices:\r\n            matched_cluster_indices.add(i)\r\n            m"]
[116.16758, "o", "atched_expert_indices.add(j)\r\n            matches.append(d)\r\n    return len(matches), matches\r\n\r\ndef evaluate_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\r\n    if len(citsci_points) == 0:\r\n        return 0.0, np.nan\r\n    def custom_dist(a, b):\r\n        dx = a[0] - b[0]\r\n        dy = a[1] - b[1]\r\n        return np.sqrt((shape_weight * dx)**2 + ((2 - shape_weight) * dy)**2)\r\n    # Precompute distance matrix for custom metric\r\n    # Using cdist with a lambda is slow, but for DBSCAN we need a distance matrix or a metric\r\n    # Given we use the same points, we can compute it once.\r\n    # However, sklearn DBSCAN with metric callable is fine if the number of points is small.\r\n    # Let's use precomputed distance matrix to be faster.\r\n    from scipy.spatial.distance import pdist, squareform\r\n    \r\n    # custom distance between point i and j\r\n    # d(a, b) = sqrt((w * Δx)² + ((2 - w) * Δy)²)\r\n    # We can scale the coordinate"]
[116.167669, "i", "s and then use standard Euclidean distance\n    scaled_points = citsci_points * np.array([shape_weight, 2 - shape_weight])\n    # Wait, the formula is (w * dx)^2 + ((2-w) * dy)^2\n    # This is equivalent to Euclidean distance on points (w*x, (2-w)*y)\n    scaled_citsci = citsci_points.copy()\n    scaled_citsci[:, 0] *= shape_weight\n    scaled_citsci[:, 1] *= (2 - shape_weight)\n    \n    db = DBSCAN(eps=epsilon, min_samples=min_samples, metric='euclidean').fit(scaled_citsci)\n    labels = db.labels_\n    unique_labels = set(labels) - {-1}\n    cluster_centroids = []\n    for label in unique_labels:\n        cluster_centroids.append(citsci_points[labels == label].mean(axis=0))\n    cluster_centroids = np.array(cluster_centroids)\n    num_matches, matches = greedy_match(cluster_centroids, expert_points)\n    precision = num_matches / len(cluster_centroids) if len(cluster_centroids) > 0 else 0\n    recall = num_matches / len(expert_points) if len(expert_points) > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) "]
[116.259599, "i", "if (precision + recall) > 0 else 0\n    delta = np.mean(matches) if matches else np.nan\n    return f1, delta\n\ndef run_search(params):\n    ms, eps, sw, citsci_grouped, expert_grouped, all_expert_files = params\n    f1_scores = []\n    deltas = []\n    for file_rad in all_expert_files:\n        c_pts = citsci_grouped.get(file_rad, np.array([]))\n        e_pts = expert_grouped.get(file_rad, np.array([]))\n        f1, delta = evaluate_image(c_pts, e_pts, ms, eps, sw)\n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    return (np.mean(f1_scores), np.mean(deltas) if deltas else np.nan, ms, eps, sw)\n\nif __name__ == '__main__':\n    citsci, expert = load_data()\n    citsci_grouped = {n: g[['x', 'y']].values for n, g in citsci.groupby('file_rad')}\n    expert_grouped = {n: g[['x', 'y']].values for n, g in expert.groupby('file_rad')}\n    all_expert_files = sorted(expert['file_rad'].unique())\n    param_grid = [(ms, eps, round(sw, 1), citsci_grouped, expert_grouped, all_expert_files)\n "]
