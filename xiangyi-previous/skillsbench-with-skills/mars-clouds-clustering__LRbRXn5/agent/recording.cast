[34.101237, "i", "\n            # Point j dominates point i if (F1_j >= F1_i and delta_j <= delta_i) \n            # AND (F1_j > F1_i or delta_j < delta_i)\n            \n            # To simplify, we'll check if point i is dominated by any other point.\n            # Point i is dominated if there exists j such that:\n            # (costs[j, 0] >= c[0] and costs[j, 1] <= c[1]) and (costs[j, 0] > c[0] or costs[j, 1] < c[1])\n            \n            dominated = ((costs[:, 0] >= c[0]) & (costs[:, 1] <= c[1])) & ((costs[:, 0] > c[0]) | (costs[:, 1] < c[1]))\n            if np.any(dominated):\n                is_efficient[i] = False\n    return is_efficient\n\nif __name__ == '__main__':\n    citsci, expert = load_data()\n    citsci_grouped = {name: group for name, group in citsci.groupby('file_rad')}\n    expert_grouped = {name: group for name, group in expert.groupby('file_rad')}\n    all_expert_files = sorted(expert['file_rad'].unique())\n    \n    param_grid = []\n    for ms in range(3, 10):\n        for eps in range(4, 25, 2):\n            for sw "]
