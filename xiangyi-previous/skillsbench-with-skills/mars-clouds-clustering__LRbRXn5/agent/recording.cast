[34.109431, "o", "    return (avg_f1, avg_delta, min_samples, epsilon, shape_weight)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.109441, "o", "\u001b[?2004h"]
[34.109452, "o", "> "]
[34.109501, "o", "def is_pareto_optimal(costs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.109516, "o", "> "]
[34.109527, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.109591, "o", "    Find the pareto-optimal points\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.109604, "o", "> "]
[34.10976, "o", "    :param costs: (n_points, n_costs) array. We want to maximize the first cost and minimize the second.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.109906, "o", "    :return: (n_points, ) boolean array of whether each point is Pareto optimal\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.109918, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.110028, "o", "    is_efficient = np.ones(costs.shape[0], dtype=bool)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.11008, "o", "    for i, c in enumerate(costs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.110094, "o", "> "]
[34.110131, "o", "        if is_efficient[i]:\r\n\u001b[?2004l\r"]
[34.110141, "o", "\u001b[?2004h> "]
[34.110308, "o", "            # A point is dominated if there is another point that is better in at least one objective \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.110394, "o", "            # and not worse in any objective.\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.110408, "o", "> "]
[34.110486, "o", "            # Here: better means F1 higher and delta lower.\r\n\u001b[?2004l\r"]
[34.110502, "o", "\u001b[?2004h> "]
[34.110613, "o", "            # We want to find if any other point j dominates point i.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.110748, "o", "            # Point j dominates point i if (F1_j >= F1_i and delta_j <= delta_i) \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.11076, "o", "> "]
[34.110838, "o", "            # AND (F1_j > F1_i or delta_j < delta_i)\r\n\u001b[?2004l\r"]
[34.110853, "o", "\u001b[?2004h> "]
[34.110896, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.111026, "o", "            # To simplify, we'll check if point i is dominated by any other point.\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.11104, "o", "> "]
[34.111128, "o", "            # Point i is dominated if there exists j such that:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.111142, "o", "> "]
[34.111318, "o", "            # (costs[j, 0] >= c[0] and costs[j, 1] <= c[1]) and (costs[j, 0] > c[0] or costs[j, 1] < c[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.111346, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.111537, "o", "            dominated = ((costs[:, 0] >= c[0]) & (costs[:, 1] <= c[1])) & ((costs[:, 0] > c[0]) | (costs[:, 1] < c[1]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.111616, "o", "            if np.any(dominated):\r\n\u001b[?2004l\r"]
[34.11163, "o", "\u001b[?2004h> "]
[34.111688, "o", "                is_efficient[i] = False\r\n\u001b[?2004l\r"]
[34.111696, "o", "\u001b[?2004h"]
[34.111705, "o", "> "]
[34.111748, "o", "    return is_efficient\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.111758, "o", "\r\n\u001b[?2004l\r"]
[34.111768, "o", "\u001b[?2004h"]
[34.111777, "o", "> "]
[34.111828, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.111837, "o", "> "]
[34.1119, "o", "    citsci, expert = load_data()\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.111913, "o", "> "]
[34.112029, "o", "    citsci_grouped = {name: group for name, group in citsci.groupby('file_rad')}\r\n\u001b[?2004l\r"]
[34.112037, "o", "\u001b[?2004h> "]
[34.112179, "o", "    expert_grouped = {name: group for name, group in expert.groupby('file_rad')}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.112273, "o", "    all_expert_files = sorted(expert['file_rad'].unique())\r\n\u001b[?2004l\r"]
[34.112289, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[34.112337, "o", "\u001b[?2004h>     param_grid = []\r\n\u001b[?2004l\r"]
[34.11235, "o", "\u001b[?2004h> "]
[34.112399, "o", "    for ms in range(3, 10):\r\n\u001b[?2004l\r"]
[34.112412, "o", "\u001b[?2004h> "]
[34.112465, "o", "        for eps in range(4, 25, 2):\r\n\u001b[?2004l\r"]
[34.112477, "o", "\u001b[?2004h> "]
[34.112554, "o", "            for sw in np.arange(0.9, 1.95, 0.1):\r\n\u001b[?2004l\r"]
[34.112566, "o", "\u001b[?2004h> "]
[34.112735, "o", "                param_grid.append((ms, eps, round(sw, 1), citsci_grouped, expert_grouped, all_expert_files))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.112754, "o", "    \r\n\u001b[?2004l\r"]
[34.112762, "o", "\u001b[?2004h"]
[34.112776, "o", "> "]
[34.112842, "o", "    with Pool() as pool:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.112912, "o", "        results = pool.map(run_search, param_grid)\r\n\u001b[?2004l\r"]
[34.112921, "o", "\u001b[?2004h> "]
[34.11295, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.112958, "o", "> "]
[34.113008, "o", "    # Filter results with F1 > 0.5\r\n\u001b[?2004l\r"]
[34.113016, "o", "\u001b[?2004h"]
[34.113023, "o", "> "]
[34.113163, "o", "    filtered_results = [r for r in results if r[0] > 0.5]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.113196, "o", "    if not filtered_results:\r\n\u001b[?2004l\r"]
[34.113205, "o", "\u001b[?2004h> "]
[34.113274, "o", "        print(\"No results with F1 > 0.5\")\r\n\u001b[?2004l\r"]
[34.113283, "o", "\u001b[?2004h"]
[34.113289, "o", "> "]
[34.113313, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.113322, "o", "> "]
[34.113377, "o", "        # Identify Pareto frontier\r\n\u001b[?2004l\r"]
[34.113386, "o", "\u001b[?2004h"]
[34.113392, "o", "> "]
[34.11349, "o", "        costs = np.array([(r[0], r[1]) for r in filtered_results])\r\n\u001b[?2004l\r"]
[34.113499, "o", "\u001b[?2004h"]
[34.113505, "o", "> "]
[34.113612, "o", "        # costs[:, 0] is F1 (maximize), costs[:, 1] is delta (minimize)\r\n\u001b[?2004l\r"]
[34.113618, "o", "\u001b[?2004h"]
[34.113627, "o", "> "]
[34.113719, "o", "        pareto_mask = is_pareto_optimal(costs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.113725, "o", "> "]
[34.113899, "o", "        pareto_results = [filtered_results[i] for i in range(len(filtered_results)) if pareto_mask[i]]\r\n\u001b[?2004l\r"]
[34.113923, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[34.113941, "o", "\u001b[?2004h> "]
[34.114017, "o", "        # Sort results for consistency (optional)\r\n\u001b[?2004l\r"]
[34.114024, "o", "\u001b[?2004h> "]
[34.114133, "o", "        pareto_results.sort(key=lambda x: (-x[0], x[1]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.114153, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.114195, "o", "        # Write to CSV\r\n\u001b[?2004l\r"]
[34.114204, "o", "\u001b[?2004h"]
[34.114209, "o", "> "]
[34.114315, "o", "        with open('/root/pareto_frontier.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.114425, "o", "            f.write(\"F1,delta,min_samples,epsilon,shape_weight\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.114492, "o", "            for r in pareto_results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.114499, "o", "> "]
[34.114631, "o", "                f.write(f\"{r[0]:.5f},{r[1]:.5f},{r[2]},{r[3]},{r[4]:.1f}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.114638, "o", "EOF\r\n\u001b[?2004l\r"]
