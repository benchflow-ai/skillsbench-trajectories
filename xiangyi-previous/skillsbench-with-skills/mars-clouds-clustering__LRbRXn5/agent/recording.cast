[116.267668, "i", "                 for ms in range(3, 10)\n                  for eps in range(4, 25, 2)\n                  for sw in np.arange(0.9, 1.95, 0.1)]\n    with Pool() as pool:\n        results = pool.map(run_search, param_grid)\n    filtered = [r for r in results if r[0] > 0.5]\n    if filtered:\n        costs = np.array([(r[0], r[1]) for r in filtered])\n        is_efficient = np.ones(costs.shape[0], dtype=bool)\n        for i, c in enumerate(costs):\n            if is_efficient[i]:\n                # Dominated by any other point j?\n                # j dominates i if j.f1 >= i.f1 and j.delta <= i.delta and (one inequality is strict)\n                dominated = ((costs[:, 0] >= c[0]) & (costs[:, 1] <= c[1])) & ((costs[:, 0] > c[0]) | (costs[:, 1] < c[1]))\n                if np.any(dominated): is_efficient[i] = False\n        pareto = [filtered[i] for i in range(len(filtered)) if is_efficient[i]]\n        pareto.sort(key=lambda x: (-x[0], x[1]))\n        with open('/root/pareto_frontier.csv', 'w') as f:\n            f.write(\"F1,delt"]
