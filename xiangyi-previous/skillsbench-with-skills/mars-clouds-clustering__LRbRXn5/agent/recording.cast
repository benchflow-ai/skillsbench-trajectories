[203.071926, "i", "centroids) if len(cluster_centroids) > 0 else 0\n    recall = num_matches / len(expert_points) if len(expert_points) > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    delta = np.mean(matches) if len(matches) > 0 else np.nan\n    return f1, delta\n\ndef run_search(params):\n    ms, eps, sw, citsci_grouped, expert_grouped, all_expert_files = params\n    f1_scores = []\n    deltas = []\n    for file_rad in all_expert_files:\n        c_pts = citsci_grouped.get(file_rad, np.empty((0, 2)))\n        e_pts = expert_grouped.get(file_rad, np.empty((0, 2)))\n        f1, delta = evaluate_image(c_pts, e_pts, ms, eps, sw)\n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    return (np.mean(f1_scores), np.mean(deltas) if deltas else np.nan, ms, eps, sw)\n\nif __name__ == '__main__':\n    citsci, expert = load_data()\n    citsci_grouped = {n: g[['x', 'y']].values for n, g in citsci.groupby('file_rad')}\n    expert_grouped = {n: g[['x', 'y']]."]
