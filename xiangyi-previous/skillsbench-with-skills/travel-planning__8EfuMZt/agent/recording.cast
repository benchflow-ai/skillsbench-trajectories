[49.507402, "i", "cat > /app/build_itinerary.py << 'EOF'\nimport sys\nimport json\n\n# Add all skill paths\nsys.path.append('/app/skills/search-cities/scripts')\nsys.path.append('/app/skills/search-accommodations/scripts')\nsys.path.append('/app/skills/search-restaurants/scripts')\nsys.path.append('/app/skills/search-attractions/scripts')\nsys.path.append('/app/skills/search-driving-distance/scripts')\n\nfrom search_cities import Cities\nfrom search_accommodations import Accommodations\nfrom search_restaurants import Restaurants\nfrom search_attractions import Attractions\nfrom search_driving_distance import GoogleDistanceMatrix\n\n# Initialize all tools\ncities_tool = Cities()\nacc_tool = Accommodations()\nrest_tool = Restaurants()\nattr_tool = Attractions()\ndist_tool = GoogleDistanceMatrix()\n\n# Get cities in Ohio\nprint(\"Searching for cities in Ohio...\")\nohio_cities = cities_tool.run('Ohio')\nprint(f\"Found cities: {ohio_cities}\")\n\n# Select three cities for the itinerary\nselected_cities = ['Cleveland', 'Columbus', 'Cincinnati']\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"Gathering data for selected cities...\")\nprint(\"=\"*50)\n\n# Gather accommodations for each city\nfor city in selected_cities:\n    print(f\"\\n--- {city} ---\")\n    print(f\"\\nAccommodations in {city}:\")\n    acc_data = acc_tool.run(city)\n    print(acc_data[:500] if len(str(acc_data)) > 500 else acc_data)\n    \n    print(f\"\\nRestaurants in {city}:\")\n    rest_data = rest_tool.run(city)\n    print(rest_data[:500] if len(str(rest_data)) > 500 else rest_data)\n    \n    print(f\"\\nAttractions in {city}:\")\n    attr_data = attr_tool.run(city)\n    print(attr_data[:500] if len(str(attr_data)) > 500 else attr_data)\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"Checking driving distances...\")\nprint(\"=\"*50)\n\n# Check distances\nprint(\"\\nMinneapolis to Cleveland:\")\nprint(dist_tool.run('Minneapolis', 'Cleveland', mode='driving'))\n\nprint(\"\\nCleveland to Columbus:\")\nprint(dist_tool.run('Cleveland', 'Columbus', mode='driving'))\n\nprint(\"\\nColumbus to Cincinnati:\")\nprint(dist_tool.run('Columbus', 'Cincinnati', mode='driving'))\n\nprint(\"\\nCincinnati to Minneapolis:\")\nprint(dist_tool.run('Cincinnati', 'Minneapolis', mode='driving'))\n\nEOF\n"]
