[?2004l[?2004h>             if len(matching) > 0:
[?2004l[?2004h>                 rest = matching.iloc[0]
[?2004l[?2004h>                 return f"{cuisine} at {rest['Name']}, {city}"
[?2004l[?2004h>         # Fallback to any restaurant
[?2004l[?2004h>         rest = rest_df.iloc[0]
[?2004l[?2004h>         return f"{rest['Name']}, {city}"
[?2004l[?2004h>     return f"{meal_type} in {city}"
