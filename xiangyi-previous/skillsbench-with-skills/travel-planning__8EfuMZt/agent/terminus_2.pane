[?2004l[?2004h> # Helper function to find pet-friendly accommodation
[?2004l[?2004h> def find_pet_friendly_accommodation(acc_df, city):
[?2004l[?2004h>     # Look for affordable options (sorting by price)
[?2004l[?2004h>     if isinstance(acc_df, pd.DataFrame) and len(acc_df) > 0:
[?2004l[?2004h>         # Sort by price and get a reasonable option
[?2004l[?2004h>         acc_sorted = acc_df.sort_values('price')
[?2004l[?2004h>         # Pick a mid-range option
[?2004l[?2004h>         idx = len(acc_sorted) // 2
[?2004l[?2004h>         return f"{acc_sorted.iloc[idx]['NAME']}, {city}"
[?2004l[?2004h>     return f"Pet-friendly accommodation in {city}"
[?2004l[?2004h> 
[?2004la[?2004h> # Helper function to find restaurants by cuisine
[?2004l[?2004h> def find_restaurant(rest_df, city, cuisine_prefs, meal_type):
[?2004l[?2004h>     if isinstance(rest_df, pd.DataFrame) and len(rest_df) > 0:
