[?2004hroot@da380c1bd5a4:/app# cat <<EOF > /app/feature_engineering.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> survey_path = '/app/output/survey_cleaned.csv'
[?2004l[?2004h> output_dir = '/app/output/'
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading survey data...')
[?2004l[?2004h> df = pd.read_csv(survey_path)
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical columns
[?2004l[?2004h> # Based on head output: Q-demos-age, Q-demos-hispanic, Q-demos-race, Q-demos-education, Q-demos-income, Q-demos-gender, Q-demos-state, etc.
[?2004l[?2004h> # We will select relevant demographic columns for engineering.
[?2004l[?2004h> 
[?2004l[?2004h> demo_cols = [
[?2004l[?2004h>     'Q-demos-age',
[?2004l[?2004h>     'Q-demos-hispanic',
[?2004l[?2004h>     'Q-demos-race',
[?2004l[?2004h>     'Q-demos-education',
[?2004l[?2004h>     'Q-demos-income',
[?2004l[?2004h>     'Q-demos-gender',
[?2004l[?2004h>     'Q-demos-state',
[?2004l[?2004h>     'Q-amazon-use-hh-size',
[?2004l[?2004h>     'Q-amazon-use-how-oft'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter to ID and demo cols
[?2004l[?2004h> # Keep ID separate
[?2004l[?2004h> ids = df['Survey ResponseID']
[?2004l[?2004h> demo_data = df[demo_cols]
[?2004l[?2004h> 
[?2004l[?2004h> # One-hot encode
[?2004l[?2004h> print('One-hot encoding features...')
[?2004l[?2004h> encoded_data = pd.get_dummies(demo_data, dummy_na=False, prefix_sep='_')
[?2004l[?2004h> 
[?2004l[?2004h> # Clean feature names (remove special characters like brackets, spaces)
[?2004l[?2004h> encoded_data.columns = encoded_data.columns.str.replace('[^a-zA-Z0-9_]', '_', regex=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Combine with ID
[?2004l[?2004h> final_df = pd.concat([ids, encoded_data], axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # Save
[?2004l[?2004h> output_path = os.path.join(output_dir, 'survey_feature_engineered.csv')
[?2004l[?2004h> final_df.to_csv(output_path, index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Feature engineering complete. Saved to {output_path}')
[?2004l[?2004h> print(f'Generated {len(encoded_data.columns)} features.')
[?2004l[?2004h> EOF
