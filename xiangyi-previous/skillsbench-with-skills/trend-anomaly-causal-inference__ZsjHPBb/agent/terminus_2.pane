[?2004hroot@da380c1bd5a4:/app# cat <<EOF > /app/clean_data.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> survey_path = '/app/data/survey_dirty.csv'
[?2004l[?2004h> purchase_path = '/app/data/amazon-purchases-2019-2020_dirty.csv'
[?2004l[?2004h> output_dir = '/app/output/'
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure output directory exists
[?2004l[?2004h> os.makedirs(output_dir, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> try:
[?2004l[?2004h>     survey_df = pd.read_csv(survey_path)
[?2004l[?2004h>     purchase_df = pd.read_csv(purchase_path)
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f'Error loading data: {e}')
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Clean Survey Data ---
[?2004l[?2004h> print('Cleaning survey data...')
[?2004l[?2004h> initial_survey_len = len(survey_df)
[?2004l[?2004h> # Drop duplicates
[?2004l[?2004h> survey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'])
[?2004l[?2004h> # Fill missing values for demographics with 'Unknown'
[?2004l[?2004h> survey_df = survey_df.fillna('Unknown')
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Survey data: {initial_survey_len} -> {len(survey_df)} rows')
[?2004l[?2004h> survey_df.to_csv(os.path.join(output_dir, 'survey_cleaned.csv'), index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Clean Purchase Data ---
[?2004l[?2004h> print('Cleaning purchase data...')
[?2004l[?2004h> initial_purchase_len = len(purchase_df)
[?2004l[?2004h> 
[?2004l[?2004h> # Drop duplicates
[?2004l[?2004h> purchase_df = purchase_df.drop_duplicates()
[?2004l[?2004h> 
[?2004l[?2004h> # Convert Order Date
[?2004l[?2004h> purchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'], errors='coerce')
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with missing Category
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Category'])
[?2004l[?2004h> 
[?2004l[?2004h> # Clean Price and Quantity
[?2004l[?2004h> # Remove '$' if present and convert to float
[?2004l[?2004h> if purchase_df['Purchase Price Per Unit'].dtype == object:
[?2004l[?2004h>     purchase_df['Purchase Price Per Unit'] = purchase_df['Purchase Price Per Unit'].astype(str).str.replace('$', '').str.replace(',', '')
[?2004l[?2004h> purchase_df['Purchase Price Per Unit'] = pd.to_numeric(purchase_df['Purchase Price Per Unit'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> purchase_df['Quantity'] = pd.to_numeric(purchase_df['Quantity'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with invalid price or quantity
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Purchase Price Per Unit', 'Quantity'])
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Total Spend (useful for later)
[?2004l[?2004h> purchase_df['Total Spend'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']
[?2004l[?2004h> 
[?2004l[?2004h> # Filter for relevant columns to save space if needed, but keeping all for now as per instructions
[?2004l[?2004h> # We need to ensure the Category strings are clean (strip whitespace)
[?2004l[?2004h> purchase_df['Category'] = purchase_df['Category'].astype(str).str.strip()
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Purchase data: {initial_purchase_len} -> {len(purchase_df)} rows')
[?2004l[?2004h> purchase_df.to_csv(os.path.join(output_dir, 'amazon-purchases-2019-2020-filtered.csv'), index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('Data cleaning complete.')
