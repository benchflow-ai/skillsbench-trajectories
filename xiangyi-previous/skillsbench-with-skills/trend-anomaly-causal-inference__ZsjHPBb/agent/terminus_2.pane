[?2004hroot@da380c1bd5a4:/app# cat <<EOF > /app/prepare_causal_data.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> purchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'
[?2004l[?2004h> anomaly_path = '/app/output/category_anomaly_index.csv'
[?2004l[?2004h> survey_path = '/app/output/survey_cleaned.csv'
[?2004l[?2004h> output_dir = '/app/output/'
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> purchase_df = pd.read_csv(purchase_path)
[?2004l[?2004h> anomaly_df = pd.read_csv(anomaly_path)
[?2004l[?2004h> survey_df = pd.read_csv(survey_path)
[?2004l[?2004h> 
[?2004l[?2004h> # Get Top 10 Surge and Slump Categories
[?2004l[?2004h> surge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()
[?2004l[?2004h> slump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()
[?2004l[?2004h> target_cats = surge_cats + slump_cats
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Target categories: {len(target_cats)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Filter purchase data for relevant dates and categories
[?2004l[?2004h> purchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Define periods
[?2004l[?2004h> baseline_start = pd.to_datetime('2020-01-01')
[?2004l[?2004h> baseline_end = pd.to_datetime('2020-02-29')
[?2004l[?2004h> treatment_start = pd.to_datetime('2020-03-01')
[?2004l[?2004h> treatment_end = pd.to_datetime('2020-03-31')
[?2004l[?2004h> 
[?2004l[?2004h> # Create Period column
[?2004l[?2004h> purchase_df['Period'] = np.nan
[?2004l[?2004h> purchase_df.loc[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end), 'Period'] = 'Baseline'
[?2004l[?2004h> purchase_df.loc[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end), 'Period'] = 'Treatment'
[?2004l[?2004h> 
[?2004l[?2004h> # Filter to valid periods and target categories
[?2004l[?2004h> filtered_df = purchase_df.dropna(subset=['Period'])
[?2004l[?2004h> filtered_df = filtered_df[filtered_df['Category'].isin(target_cats)]
[?2004l[?2004h> 
[?2004l[?2004h> # We need a Cartesian product of Users x Categories x Periods to ensure 0s are recorded
[?2004l[?2004h> users = survey_df['Survey ResponseID'].unique()
[?2004l[?2004h> periods = ['Baseline', 'Treatment']
[?2004l[?2004h> 
[?2004l[?2004h> # Create skeleton dataframe
[?2004l[?2004h> import itertools
[?2004l[?2004h> skeleton = pd.DataFrame(list(itertools.product(users, target_cats, periods)), columns=['Survey ResponseID', 'Category', 'Period'])
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate actual spend
[?2004l[?2004h> agg_spend = filtered_df.groupby(['Survey ResponseID', 'Category', 'Period'])['Total Spend'].sum().reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> # Merge with skeleton
[?2004l[?2004h> final_df = skeleton.merge(agg_spend, on=['Survey ResponseID', 'Category', 'Period'], how='left')
[?2004l[?2004h> final_df['Total Spend'] = final_df['Total Spend'].fillna(0)
[?2004l[?2004h> 
[?2004l[?2004h> # Create Extensive Margin (Has_Purchase)
[?2004l[?2004h> final_df['Has_Purchase'] = (final_df['Total Spend'] > 0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Save Intensive
[?2004l[?2004h> print('Saving intensive margin data...')
[?2004l[?2004h> intensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Total Spend']
[?2004l[?2004h> final_df[intensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_intensive.csv'), index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Save Extensive
[?2004l[?2004h> print('Saving extensive margin data...')
[?2004l[?2004h> extensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']
[?2004l[?2004h> final_df[extensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_extensive.csv'), index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('Data preparation complete.')
[?2004l[?2004h> EOF
