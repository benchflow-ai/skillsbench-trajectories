import pandas as pd
import numpy as np
import statsmodels.api as sm
import json
import os
import warnings

# Suppress warnings
warnings.filterwarnings('ignore')

# Paths
intensive_path = '/app/output/user_category_period_aggregated_intensive.csv'
extensive_path = '/app/output/user_category_period_aggregated_extensive.csv'
features_path = '/app/output/survey_feature_engineered.csv'
anomaly_path = '/app/output/category_anomaly_index.csv'
output_path = '/app/output/causal_analysis_report.json'

print('Loading data...')
intensive_df = pd.read_csv(intensive_path)
extensive_df = pd.read_csv(extensive_path)
features_df = pd.read_csv(features_path)
anomaly_df = pd.read_csv(anomaly_path)

# Prepare features: Convert boolean to int
feature_cols = [c for c in features_df.columns if c != 'Survey ResponseID']
print(f'Total features: {len(feature_cols)}')

# Convert features to numeric (int)
for col in feature_cols:
    features_df[col] = features_df[col].astype(int)

# Merge features into dataframes
intensive_df = intensive_df.merge(features_df, on='Survey ResponseID', how='left')
extensive_df = extensive_df.merge(features_df, on='Survey ResponseID', how='left')

# Encode Period: Baseline=0, Treatment=1
intensive_df['Period_Num'] = (intensive_df['Period'] == 'Treatment').astype(int)
extensive_df['Period_Num'] = (extensive_df['Period'] == 'Treatment').astype(int)

# Get Categories
surge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)
slump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)

results_json = {
    "metadata": {
        "baseline_start": "01-01-2020",
        "baseline_end": "02-29-2020",
        "treatment_start": "03-01-2020",
        "treatment_end": "03-31-2020",
        "total_features_analyzed": len(feature_cols)
    },
    "surge_categories": [],
    "slump_categories": [],
    "summary": {}
}

def analyze_category(category, anomaly_score, is_surge):
    print(f'Analyzing {category}...')
    cat_intensive = intensive_df[intensive_df['Category'] == category].copy()
    cat_extensive = extensive_df[extensive_df['Category'] == category].copy()
    
    # Basic Stats
    baseline_spend = cat_intensive[cat_intensive['Period'] == 'Baseline']['Total Spend']
    treatment_spend = cat_intensive[cat_intensive['Period'] == 'Treatment']['Total Spend']
    
    # Purchasers count (extensive)
    baseline_purchasers = cat_extensive[(cat_extensive['Period'] == 'Baseline') & (cat_extensive['Has_Purchase'] == 1)].shape[0]
    treatment_purchasers = cat_extensive[(cat_extensive['Period'] == 'Treatment') & (cat_extensive['Has_Purchase'] == 1)].shape[0]
    n_users = cat_extensive['Survey ResponseID'].nunique()
    
    stats = {
        "category": category,
        "anomaly_index": round(anomaly_score, 2),
        "baseline_avg_spend": round(baseline_spend.mean(), 2),
        "treatment_avg_spend": round(treatment_spend.mean(), 2),
        "n_purchasers_baseline": int(baseline_purchasers),
        "n_purchasers_treatment": int(treatment_purchasers),
        "baseline_purchase_rate": round(baseline_purchasers / n_users, 4),
        "treatment_purchase_rate": round(treatment_purchasers / n_users, 4),
        "n_at_risk": int(n_users)
    }
    
    # --- Intensive Margin: Univariate DiD ---
    intensive_drivers = []
    # We will also use this loop to score features for Extensive margin screening if needed
    # But for extensive margin, we should screen based on extensive outcome.
    
