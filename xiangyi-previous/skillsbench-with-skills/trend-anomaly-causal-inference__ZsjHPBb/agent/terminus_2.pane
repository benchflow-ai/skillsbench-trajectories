    for feature in feature_cols:
        if cat_intensive[feature].nunique() < 2:
            continue
            
        X = cat_intensive[['Period_Num', feature]].copy()
        X['Interaction'] = X['Period_Num'] * X[feature]
        X = sm.add_constant(X)
        y = cat_intensive['Total Spend']
        
        try:
            model = sm.OLS(y, X.astype(float)).fit()
