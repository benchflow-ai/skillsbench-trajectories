[?2004hroot@da380c1bd5a4:/app# cat <<EOF > /app/run_causal_analysis.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import statsmodels.api as sm
[?2004l[?2004h> import json
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> intensive_path = '/app/output/user_category_period_aggregated_intensive.csv'
[?2004l[?2004h> extensive_path = '/app/output/user_category_period_aggregated_extensive.csv'
[?2004l[?2004h> features_path = '/app/output/survey_feature_engineered.csv'
[?2004l[?2004h> anomaly_path = '/app/output/category_anomaly_index.csv'
[?2004l[?2004h> purchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'
[?2004l[?2004h> output_path = '/app/output/causal_analysis_report.json'
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> intensive_df = pd.read_csv(intensive_path)
[?2004l[?2004h> extensive_df = pd.read_csv(extensive_path)
[?2004l[?2004h> features_df = pd.read_csv(features_path)
[?2004l[?2004h> anomaly_df = pd.read_csv(anomaly_path)
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare features
[?2004l[?2004h> feature_cols = [c for c in features_df.columns if c != 'Survey ResponseID']
[?2004l[?2004h> print(f'Total features: {len(feature_cols)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge features into dataframes
[?2004l[?2004h> intensive_df = intensive_df.merge(features_df, on='Survey ResponseID', how='left')
[?2004l[?2004h> extensive_df = extensive_df.merge(features_df, on='Survey ResponseID', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # Encode Period: Baseline=0, Treatment=1
[?2004l[?2004h> intensive_df['Period_Num'] = (intensive_df['Period'] == 'Treatment').astype(int)
[?2004l[?2004h> extensive_df['Period_Num'] = (extensive_df['Period'] == 'Treatment').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Get Categories
[?2004l[?2004h> surge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)
[?2004l[?2004h> slump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)
[?2004l[?2004h> 
[?2004l[?2004h> results_json = {
[?2004l[?2004h>     "metadata": {
[?2004l[?2004h>         "baseline_start": "01-01-2020",
[?2004l[?2004h>         "baseline_end": "02-29-2020",
[?2004l[?2004h>         "treatment_start": "03-01-2020",
[?2004l[?2004h>         "treatment_end": "03-31-2020",
[?2004l[?2004h>         "total_features_analyzed": len(feature_cols)
[?2004l[?2004h>     },
[?2004l[?2004h>     "surge_categories": [],
[?2004l[?2004h>     "slump_categories": [],
[?2004l[?2004h>     "summary": {}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_category(category, anomaly_score, is_surge):
[?2004l[?2004h>     print(f'Analyzing {category}...')
[?2004l[?2004h>     cat_intensive = intensive_df[intensive_df['Category'] == category].copy()
[?2004l[?2004h>     cat_extensive = extensive_df[extensive_df['Category'] == category].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     # Basic Stats
[?2004l[?2004h>     baseline_spend = cat_intensive[cat_intensive['Period'] == 'Baseline']['Total Spend']
[?2004l[?2004h>     treatment_spend = cat_intensive[cat_intensive['Period'] == 'Treatment']['Total Spend']
[?2004l[?2004h>     
[?2004l[?2004h>     # Purchasers count (extensive)
[?2004l[?2004h>     baseline_purchasers = cat_extensive[(cat_extensive['Period'] == 'Baseline') & (cat_extensive['Has_Purchase'] == 1)].shape[0]
[?2004l[?2004h>     treatment_purchasers = cat_extensive[(cat_extensive['Period'] == 'Treatment') & (cat_extensive['Has_Purchase'] == 1)].shape[0]
[?2004l[?2004h>     n_users = cat_extensive['Survey ResponseID'].nunique()
[?2004l[?2004h>     
[?2004l[?2004h>     stats = {
[?2004l[?2004h>         "category": category,
[?2004l[?2004h>         "anomaly_index": round(anomaly_score, 2),
[?2004l[?2004h>         "baseline_avg_spend": round(baseline_spend.mean(), 2),
[?2004l[?2004h>         "treatment_avg_spend": round(treatment_spend.mean(), 2),
[?2004l[?2004h>         "n_purchasers_baseline": int(baseline_purchasers),
[?2004l[?2004h>         "n_purchasers_treatment": int(treatment_purchasers),
[?2004l[?2004h>         "baseline_purchase_rate": round(baseline_purchasers / n_users, 4),
[?2004l[?2004h>         "treatment_purchase_rate": round(treatment_purchasers / n_users, 4),
[?2004l[?2004h>         "n_at_risk": int(n_users)
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     # --- Intensive Margin: Univariate DiD ---
[?2004l[?2004h>     # For each feature, run: Spend ~ Period + Feature + Period*Feature
[?2004l[?2004h>     intensive_drivers = []
[?2004l[?2004h>     for feature in feature_cols:
[?2004l[?2004h>         # Prepare X and y
[?2004l[?2004h>         # To speed up, we can use numpy or simple stats
[?2004l[?2004h>         # But let's use statsmodels OLS for p-values
[?2004l[?2004h>         # Model: Y = b0 + b1*Period + b2*Feature + b3*(Period*Feature)
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if feature has variance
[?2004l[?2004h>         if cat_intensive[feature].nunique() < 2:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         X = cat_intensive[['Period_Num', feature]].copy()
[?2004l[?2004h>         X['Interaction'] = X['Period_Num'] * X[feature]
[?2004l[?2004h>         X = sm.add_constant(X)
[?2004l[?2004h>         y = cat_intensive['Total Spend']
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             model = sm.OLS(y, X).fit()
[?2004l[?2004h>             coeff = model.params['Interaction']
[?2004l[?2004h>             pval = model.pvalues['Interaction']
[?2004l[?2004h>             
[?2004l[?2004h>             intensive_drivers.append({
[?2004l[?2004h>                 "feature": feature,
[?2004l[?2004h>                 "did_estimate": float(coeff),
[?2004l[?2004h>                 "p_value": float(pval),
[?2004l[?2004h>                 "method": "Univariate DiD"
[?2004l[?2004h>             })
[?2004l[?2004h>         except:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>     # Sort Intensive Drivers
[?2004l[?2004h>     if is_surge:
[?2004l[?2004h>         intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)
[?2004l[?2004h>     else:
[?2004l[?2004h>         intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)
[?2004l[?2004h>     
[?2004l[?2004h>     stats['intensive_margin'] = intensive_drivers[:3]
[?2004l[?2004h>     
[?2004l[?2004h>     # --- Extensive Margin: Multivariate Heterogeneous DiD ---
[?2004l[?2004h>     # Model: Has_Purchase ~ Period + F1 + ... + Fn + Period*F1 + ... + Period*Fn
[?2004l[?2004h>     # This is large. Let's try to run it. If it fails, fallback to univariate.
[?2004l[?2004h>     extensive_drivers = []
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Construct design matrix
[?2004l[?2004h>         # Intercept, Period, All Features, Interactions
[?2004l[?2004h>         # We need to drop columns with no variance to avoid singular matrix issues
[?2004l[?2004h>         valid_features = [f for f in feature_cols if cat_extensive[f].nunique() > 1]
[?2004l[?2004h>         
[?2004l[?2004h>         X = cat_extensive[['Period_Num'] + valid_features].copy()
[?2004l[?2004h>         # Create interactions
[?2004l[?2004h>         interaction_cols = []
[?2004l[?2004h>         for f in valid_features:
[?2004l[?2004h>             col_name = f'Interaction_{f}'
[?2004l[?2004h>             X[col_name] = X['Period_Num'] * X[f]
[?2004l[?2004h>             interaction_cols.append(col_name)
[?2004l[?2004h>             
[?2004l[?2004h>         X = sm.add_constant(X)
[?2004l[?2004h>         y = cat_extensive['Has_Purchase']
[?2004l[?2004h>         
[?2004l[?2004h>         model = sm.OLS(y, X).fit()
[?2004l[?2004h>         
[?2004l[?2004h>         for f in valid_features:
[?2004l[?2004h>             inter_col = f'Interaction_{f}'
[?2004l[?2004h>             if inter_col in model.params:
[?2004l[?2004h>                 extensive_drivers.append({
[?2004l[?2004h>                     "feature": f,
[?2004l[?2004h>                     "did_estimate": float(model.params[inter_col]),
[?2004l[?2004h>                     "p_value": float(model.pvalues[inter_col]),
[?2004l[?2004h>                     "method": "Multivariate Heterogeneous DiD"
[?2004l[?2004h>                 })
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'Multivariate failed for {category}: {e}. Falling back to Univariate.')
[?2004l[?2004h>         # Fallback code if needed, but for now let's hope it works or return empty
[?2004l[?2004h>         pass
[?2004l[?2004h>         
[?2004l[?2004h>     # Sort Extensive Drivers
[?2004l[?2004h>     if is_surge:
[?2004l[?2004h>         extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)
[?2004l[?2004h>     else:
[?2004l[?2004h>         extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)
[?2004l[?2004h>         
[?2004l[?2004h>     stats['extensive_margin'] = extensive_drivers[:3]
[?2004l[?2004h>     
[?2004l[?2004h>     return stats
[?2004l[?2004h> 
[?2004l[?2004h> # Run for Surge
[?2004l[?2004h> print('Processing Surge Categories...')
[?2004l[?2004h> for _, row in surge_cats.iterrows():
[?2004l[?2004h>     res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=True)
[?2004l[?2004h>     results_json['surge_categories'].append(res)
[?2004l[?2004h> 
[?2004l[?2004h> # Run for Slump
[?2004l[?2004h> print('Processing Slump Categories...')
[?2004l[?2004h> for _, row in slump_cats.iterrows():
[?2004l[?2004h>     res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=False)
[?2004l[?2004h>     results_json['slump_categories'].append(res)
[?2004l[?2004h> 
[?2004l[?2004h> # Summary
[?2004l[?2004h> results_json['summary']['surge'] = {
[?2004l[?2004h>     "total_categories": len(results_json['surge_categories']),
[?2004l[?2004h>     "total_intensive_drivers": len(results_json['surge_categories']) * 3,
[?2004l[?2004h>     "total_extensive_drivers": len(results_json['surge_categories']) * 3
[?2004l[?2004h> }
[?2004l[?2004h> results_json['summary']['slump'] = {
[?2004l[?2004h>     "total_categories": len(results_json['slump_categories']),
[?2004l[?2004h>     "total_intensive_drivers": len(results_json['slump_categories']) * 3,
[?2004l[?2004h>     "total_extensive_drivers": len(results_json['slump_categories']) * 3
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Save JSON
[?2004l[?2004h> with open(output_path, 'w') as f:
[?2004l[?2004h>     json.dump(results_json, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Analysis complete. Saved to {output_path}')
