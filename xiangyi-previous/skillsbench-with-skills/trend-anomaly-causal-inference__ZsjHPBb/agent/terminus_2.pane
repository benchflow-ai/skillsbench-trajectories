[?2004hroot@da380c1bd5a4:/app# cat <<EOF > /app/detect_anomalies.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> purchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'
[?2004l[?2004h> output_dir = '/app/output/'
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> df = pd.read_csv(purchase_path)
[?2004l[?2004h> df['Order Date'] = pd.to_datetime(df['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Define periods
[?2004l[?2004h> baseline_start = '2020-01-01'
[?2004l[?2004h> baseline_end = '2020-02-29'
[?2004l[?2004h> treatment_start = '2020-03-01'
[?2004l[?2004h> treatment_end = '2020-03-31'
[?2004l[?2004h> 
[?2004l[?2004h> # Filter data for relevant periods
[?2004l[?2004h> baseline_data = df[(df['Order Date'] >= baseline_start) & (df['Order Date'] <= baseline_end)]
[?2004l[?2004h> treatment_data = df[(df['Order Date'] >= treatment_start) & (df['Order Date'] <= treatment_end)]
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate daily sales per category
[?2004l[?2004h> # We need average daily spend. 
[?2004l[?2004h> # 1. Sum spend per category per day.
[?2004l[?2004h> # 2. Average those daily sums over the period.
[?2004l[?2004h> 
[?2004l[?2004h> def get_avg_daily_sales(data, start_date, end_date):
[?2004l[?2004h>     if data.empty:
[?2004l[?2004h>         return pd.Series(dtype=float)
[?2004l[?2004h>     daily = data.groupby(['Category', 'Order Date'])['Total Spend'].sum().reset_index()
[?2004l[?2004h>     # Ensure we account for days with 0 sales if necessary, but usually we just average over the days in the range.
[?2004l[?2004h>     # To be precise, we should divide total sales in period by number of days in period.
[?2004l[?2004h>     total_sales = data.groupby('Category')['Total Spend'].sum()
[?2004l[?2004h>     n_days = (pd.to_datetime(end_date) - pd.to_datetime(start_date)).days + 1
[?2004l[?2004h>     return total_sales / n_days
[?2004l[?2004h> 
[?2004l[?2004h> baseline_avg = get_avg_daily_sales(baseline_data, baseline_start, baseline_end)
[?2004l[?2004h> treatment_avg = get_avg_daily_sales(treatment_data, treatment_start, treatment_end)
[?2004l[?2004h> 
[?2004l[?2004h> # Combine
[?2004l[?2004h> results = pd.DataFrame({'Baseline_Avg': baseline_avg, 'Treatment_Avg': treatment_avg})
[?2004l[?2004h> results = results.fillna(0)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Anomaly Index
[?2004l[?2004h> # Formula: ((Treatment - Baseline) / Baseline) * 100
[?2004l[?2004h> # Handle division by zero
[?2004l[?2004h> results['Anomaly_Index'] = 0.0
[?2004l[?2004h> mask = results['Baseline_Avg'] > 0
[?2004l[?2004h> results.loc[mask, 'Anomaly_Index'] = ((results.loc[mask, 'Treatment_Avg'] - results.loc[mask, 'Baseline_Avg']) / results.loc[mask, 'Baseline_Avg']) * 100
[?2004l[?2004h> 
[?2004l[?2004h> # Handle cases where Baseline is 0 but Treatment > 0 (infinite surge -> 100)
[?2004l[?2004h> results.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] > 0), 'Anomaly_Index'] = 100.0
[?2004l[?2004h> # Handle cases where both are 0
[?2004l[?2004h> results.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] == 0), 'Anomaly_Index'] = 0.0
[?2004l[?2004h> 
[?2004l[?2004h> # Clamp to -100, 100
[?2004l[?2004h> results['Anomaly_Index'] = results['Anomaly_Index'].clip(-100, 100)
[?2004l[?2004h> 
[?2004l[?2004h> # Reset index to make Category a column
[?2004l[?2004h> results = results.reset_index().rename(columns={'index': 'Category'})
[?2004l[?2004h> 
[?2004l[?2004h> # Save
[?2004l[?2004h> output_path = os.path.join(output_dir, 'category_anomaly_index.csv')
[?2004l[?2004h> results[['Category', 'Anomaly_Index']].to_csv(output_path, index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Anomaly detection complete. Saved to {output_path}')
[?2004l[?2004h> print('Top 5 Surges:')
[?2004l[?2004h> print(results.sort_values('Anomaly_Index', ascending=False).head(5))
[?2004l[?2004h> print('Top 5 Slumps:')
[?2004l[?2004h> print(results.sort_values('Anomaly_Index', ascending=True).head(5))
[?2004l[?2004h> EOF
