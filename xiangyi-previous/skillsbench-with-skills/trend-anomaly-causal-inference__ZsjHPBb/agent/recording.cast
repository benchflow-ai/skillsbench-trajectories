[104.327286, "i", "cat <<EOF > /app/prepare_causal_data.py\nimport pandas as pd\nimport numpy as np\nimport os\n\n# Paths\npurchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'\nanomaly_path = '/app/output/category_anomaly_index.csv'\nsurvey_path = '/app/output/survey_cleaned.csv'\noutput_dir = '/app/output/'\n\nprint('Loading data...')\npurchase_df = pd.read_csv(purchase_path)\nanomaly_df = pd.read_csv(anomaly_path)\nsurvey_df = pd.read_csv(survey_path)\n\n# Get Top 10 Surge and Slump Categories\nsurge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()\nslump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()\ntarget_cats = surge_cats + slump_cats\n\nprint(f'Target categories: {len(target_cats)}')\n\n# Filter purchase data for relevant dates and categories\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])\n\n# Define periods\nbaseline_start = pd.to_datetime('2020-01-01')\nbaseline_end = pd.to_datetime('2020-02-29')\ntreatment_start = pd.to_datetime('2020-03-01')\ntreatment_end = pd.to_datetime('2020-03-31')\n\n# Create Period column\npurchase_df['Period'] = np.nan\npurchase_df.loc[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end), 'Period'] = 'Baseline'\npurchase_df.loc[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end), 'Period'] = 'Treatment'\n\n# Filter to valid periods and target categories\nfiltered_df = purchase_df.dropna(subset=['Period'])\nfiltered_df = filtered_df[filtered_df['Category'].isin(target_cats)]\n\n# We need a Cartesian product of Users x Categories x Periods to ensure 0s are recorded\nusers = survey_df['Survey ResponseID'].unique()\nperiods = ['Baseline', 'Treatment']\n\n# Create skeleton dataframe\nimport itertools\nskeleton = pd.DataFrame(list(itertools.product(users, target_cats, periods)), columns=['Survey ResponseID', 'Category', 'Period'])\n\n# Aggregate actual spend\nagg_spend = filtered_df.groupby(['Survey ResponseID', 'Category', 'Period'])['Total Spend'].sum().reset_index()\n\n# Merge with skeleton\nfinal_df = skeleton.merge(agg_spend, on=['Survey ResponseID', 'Category', 'Period'], how='left')\nfinal_df['Total Spend'] = final_df['Total Spend'].fillna(0)\n\n# Create Extensive Margin (Has_Purchase)\nfinal_df['Has_Purchase'] = (final_df['Total Spend'] > 0).astype(int)\n\n# Save Intensive\nprint('Saving intensive margin data...')\nintensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Total Spend']\nfinal_df[intensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_intensive.csv'), index=False)\n\n# Save Extensive\nprint('Saving extensive margin data...')\nextensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']\nfinal_df[extensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_extensive.csv'), index=False)\n\nprint('Data preparation complete.')\nEOF\n"]
[104.328638, "o", "cat <<EOF > /app/prepare_causal_data.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Paths\r\n\u001b[?2004l\r\u001b[?2004h> purchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'\r\n\u001b[?2004l\r\u001b[?2004h> anomaly_path = '/app/output/category_anomaly_index.csv'\r\n\u001b[?2004l\r\u001b[?2004h> survey_path = '/app/output/survey_cleaned.csv'\r\n\u001b[?2004l\r\u001b[?2004h> output_dir = '/app/output/'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Loading data...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.328696, "o", "purchase_df = pd.read_csv(purchase_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.328869, "o", "anomaly_df = pd.read_csv(anomaly_path)\r\n\u001b[?2004l\r\u001b[?2004h> survey_df = pd.read_csv(survey_path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.328943, "o", "> # Get Top 10 Surge and Slump Categories\r\n\u001b[?2004l\r"]
[104.328998, "o", "\u001b[?2004h> "]
[104.329119, "o", "surge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.32928, "o", "slump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.329349, "o", "target_cats = surge_cats + slump_cats\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.3294, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.329443, "o", "print(f'Target categories: {len(target_cats)}')\r\n\u001b[?2004l\r"]
[104.329492, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.329573, "o", "# Filter purchase data for relevant dates and categories\r\n\u001b[?2004l\r"]
[104.32962, "o", "\u001b[?2004h> "]
[104.329702, "o", "purchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])\r\n\u001b[?2004l\r"]
[104.329751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Define periods\r\n\u001b[?2004l\r"]
[104.329798, "o", "\u001b[?2004h> "]
[104.329841, "o", "baseline_start = pd.to_datetime('2020-01-01')\r\n\u001b[?2004l\r"]
[104.329891, "o", "\u001b[?2004h> "]
[104.32994, "o", "baseline_end = pd.to_datetime('2020-02-29')\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.329983, "o", "> "]
[104.330026, "o", "treatment_start = pd.to_datetime('2020-03-01')\r\n\u001b[?2004l\r"]
[104.330068, "o", "\u001b[?2004h> "]
[104.33011, "o", "treatment_end = pd.to_datetime('2020-03-31')\r\n\u001b[?2004l\r"]
[104.330155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.330201, "o", "# Create Period column\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.330253, "o", "purchase_df['Period'] = np.nan\r\n\u001b[?2004l\r"]
[104.330301, "o", "\u001b[?2004h> "]
[104.330477, "o", "purchase_df.loc[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end), 'Period'] = 'Baseline'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.330681, "o", "purchase_df.loc[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end), 'Period'] = 'Treatment'\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.33073, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.330785, "o", "# Filter to valid periods and target categories\r\n\u001b[?2004l\r"]
[104.330832, "o", "\u001b[?2004h> "]
[104.330878, "o", "filtered_df = purchase_df.dropna(subset=['Period'])\r\n\u001b[?2004l\r"]
[104.330922, "o", "\u001b[?2004h> "]
[104.331002, "o", "filtered_df = filtered_df[filtered_df['Category'].isin(target_cats)]\r\n\u001b[?2004l\r"]
[104.331062, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331177, "o", "# We need a Cartesian product of Users x Categories x Periods to ensure 0s are recorded\r\n\u001b[?2004l\r"]
[104.331227, "o", "\u001b[?2004h> "]
[104.331291, "o", "users = survey_df['Survey ResponseID'].unique()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331344, "o", "periods = ['Baseline', 'Treatment']\r\n\u001b[?2004l\r"]
[104.331392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331441, "o", "# Create skeleton dataframe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331487, "o", "import itertools\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331697, "o", "skeleton = pd.DataFrame(list(itertools.product(users, target_cats, periods)), columns=['Survey ResponseID', 'Category', 'Period'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.331769, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331824, "o", "# Aggregate actual spend\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.331973, "o", "agg_spend = filtered_df.groupby(['Survey ResponseID', 'Category', 'Period'])['Total Spend'].sum().reset_index()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.332019, "o", "\u001b[?2004h> "]
[104.332064, "o", "# Merge with skeleton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.332202, "o", "final_df = skeleton.merge(agg_spend, on=['Survey ResponseID', 'Category', 'Period'], how='left')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.332312, "o", "final_df['Total Spend'] = final_df['Total Spend'].fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.332357, "o", "\u001b[?2004h> "]
[104.332399, "o", "# Create Extensive Margin (Has_Purchase)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.332441, "o", "> "]
[104.332513, "o", "final_df['Has_Purchase'] = (final_df['Total Spend'] > 0).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.332555, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.332596, "o", "# Save Intensive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.332653, "o", "print('Saving intensive margin data...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.332695, "o", "> "]
[104.332788, "o", "intensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Total Spend']\r\n\u001b[?2004l\r"]
[104.33283, "o", "\u001b[?2004h> "]
[104.332985, "o", "final_df[intensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_intensive.csv'), index=False)\r\n\u001b[?2004l\r"]
[104.333029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.333073, "o", "# Save Extensive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.33313, "o", "print('Saving extensive margin data...')\r\n\u001b[?2004l\r"]
[104.333172, "o", "\u001b[?2004h> "]
[104.333259, "o", "extensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']\r\n\u001b[?2004l\r"]
[104.333306, "o", "\u001b[?2004h> "]
[104.333458, "o", "final_df[extensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_extensive.csv'), index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.333502, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.333548, "o", "print('Data preparation complete.')\r\n\u001b[?2004l\r"]
