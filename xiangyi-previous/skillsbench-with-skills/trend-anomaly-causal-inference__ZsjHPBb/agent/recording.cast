[275.156051, "o", "\u001b[?2004hroot@da380c1bd5a4:/app# "]
[275.277142, "i", "python3 /app/run_causal_analysis.py\n"]
[275.295962, "o", "python3 /app/run_causal_analysis.py\r\n\u001b[?2004l\r"]
[277.270063, "o", "Loading data...\r\n"]
[277.513063, "o", "Total features: 133\r\n"]
[278.435851, "o", "Processing Surge Categories...\r\n"]
[278.43616, "o", "Analyzing BOARD_GAME...\r\n"]
[362.494917, "i", "ps aux | grep python\n"]
[362.495366, "o", "ps aux | grep python\r\n"]
[363.028105, "i", "ls -lh /app/output/\n"]
[363.028421, "o", "ls -lh /app/output/\r\n"]
