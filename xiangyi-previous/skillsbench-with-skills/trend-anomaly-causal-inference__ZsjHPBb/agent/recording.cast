[169.102942, "o", "def analyze_category(category, anomaly_score, is_surge):\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.103013, "o", "> "]
[169.103107, "o", "    print(f'Analyzing {category}...')\r\n\u001b[?2004l\r"]
[169.103169, "o", "\u001b[?2004h> "]
[169.103448, "o", "    cat_intensive = intensive_df[intensive_df['Category'] == category].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.103497, "o", "> "]
[169.103856, "o", "    cat_extensive = extensive_df[extensive_df['Category'] == category].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.103993, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Basic Stats\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.106444, "o", "    baseline_spend = cat_intensive[cat_intensive['Period'] == 'Baseline']['Total Spend']\r\n\u001b[?2004l\r\u001b[?2004h>     treatment_spend = cat_intensive[cat_intensive['Period'] == 'Treatment']['Total Spend']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Purchasers count (extensive)\r\n\u001b[?2004l\r\u001b[?2004h>     baseline_purchasers = cat_extensive[(cat_extensive['Period'] == 'Baseline') & (cat_extensive['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r\u001b[?2004h>     treatment_purchasers = cat_extensive[(cat_extensive['Period'] == 'Treatment') & (cat_extensive['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r\u001b[?2004h>     n_users = cat_extensive['Survey ResponseID'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     stats = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.10786, "o", "        \"category\": category,\r\n\u001b[?2004l\r\u001b[?2004h>         \"anomaly_index\": round(anomaly_score, 2),\r\n\u001b[?2004l\r\u001b[?2004h>         \"baseline_avg_spend\": round(baseline_spend.mean(), 2),\r\n\u001b[?2004l\r\u001b[?2004h>         \"treatment_avg_spend\": round(treatment_spend.mean(), 2),\r\n\u001b[?2004l\r\u001b[?2004h>         \"n_purchasers_baseline\": int(baseline_purchasers),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.10794, "o", "        \"n_purchasers_treatment\": int(treatment_purchasers),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.109306, "o", "        \"baseline_purchase_rate\": round(baseline_purchasers / n_users, 4),\r\n\u001b[?2004l\r\u001b[?2004h>         \"treatment_purchase_rate\": round(treatment_purchasers / n_users, 4),\r\n\u001b[?2004l\r\u001b[?2004h>         \"n_at_risk\": int(n_users)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # --- Intensive Margin: Univariate DiD ---\r\n\u001b[?2004l\r\u001b[?2004h>     # For each feature, run: Spend ~ Period + Feature + Period*Feature\r\n\u001b[?2004l\r\u001b[?2004h>     intensive_drivers = []\r\n\u001b[?2004l\r\u001b[?2004h>     for feature in feature_cols:\r\n\u001b[?2004l\r\u001b[?2004h>         # Prepare X and y\r\n\u001b[?2004l\r"]
[169.109391, "o", "\u001b[?2004h> "]
[169.110372, "o", "        # To speed up, we can use numpy or simple stats\r\n\u001b[?2004l\r\u001b[?2004h>         # But let's use statsmodels OLS for p-values\r\n\u001b[?2004l\r\u001b[?2004h>         # Model: Y = b0 + b1*Period + b2*Feature + b3*(Period*Feature)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Check if feature has variance\r\n\u001b[?2004l\r\u001b[?2004h>         if cat_intensive[feature].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         X = cat_intensive[['Period_Num', feature]].copy()\r\n\u001b[?2004l\r\u001b[?2004h>         X['Interaction'] = X['Period_Num'] * X[feature]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.110451, "o", "        X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.110505, "o", "        y = cat_intensive['Total Spend']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.110563, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[169.110613, "o", "\u001b[?2004h> "]
[169.110665, "o", "            model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r"]
[169.110713, "o", "\u001b[?2004h> "]
[169.111771, "o", "            coeff = model.params['Interaction']\r\n\u001b[?2004l\r\u001b[?2004h>             pval = model.pvalues['Interaction']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             intensive_drivers.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 \"feature\": feature,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"did_estimate\": float(coeff),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"p_value\": float(pval),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"method\": \"Univariate DiD\"\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h>         except:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort Intensive Drivers\r\n\u001b[?2004l\r\u001b[?2004h>     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h>         intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n"]
[169.111825, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.111951, "o", "        intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.111997, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.112092, "o", "    stats['intensive_margin'] = intensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.112135, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.112252, "o", "    # --- Extensive Margin: Multivariate Heterogeneous DiD ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.112292, "o", "> "]
[169.112401, "o", "    # Model: Has_Purchase ~ Period + F1 + ... + Fn + Period*F1 + ... + Period*Fn\r\n\u001b[?2004l\r"]
[169.112441, "o", "\u001b[?2004h> "]
[169.112559, "o", "    # This is large. Let's try to run it. If it fails, fallback to univariate.\r\n\u001b[?2004l\r"]
[169.112603, "o", "\u001b[?2004h> "]
[169.112652, "o", "    extensive_drivers = []\r\n\u001b[?2004l\r"]
[169.11269, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.11271, "o", "> "]
[169.112764, "o", "        # Construct design matrix\r\n\u001b[?2004l\r"]
[169.112785, "o", "\u001b[?2004h> "]
[169.112883, "o", "        # Intercept, Period, All Features, Interactions\r\n\u001b[?2004l\r"]
[169.112908, "o", "\u001b[?2004h> "]
[169.113051, "o", "        # We need to drop columns with no variance to avoid singular matrix issues\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.113074, "o", "> "]
[169.113205, "o", "        valid_features = [f for f in feature_cols if cat_extensive[f].nunique() > 1]\r\n\u001b[?2004l\r"]
[169.11323, "o", "\u001b[?2004h> "]
[169.11325, "o", "        \r\n\u001b[?2004l\r"]
[169.113275, "o", "\u001b[?2004h> "]
[169.113395, "o", "        X = cat_extensive[['Period_Num'] + valid_features].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.113424, "o", "> "]
[169.113455, "o", "        # Create interactions\r\n\u001b[?2004l\r"]
[169.113474, "o", "\u001b[?2004h> "]
[169.11353, "o", "        interaction_cols = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.113549, "o", "> "]
[169.113596, "o", "        for f in valid_features:\r\n\u001b[?2004l\r"]
[169.113615, "o", "\u001b[?2004h> "]
[169.113686, "o", "            col_name = f'Interaction_{f}'\r\n\u001b[?2004l\r"]
[169.113705, "o", "\u001b[?2004h> "]
[169.113786, "o", "            X[col_name] = X['Period_Num'] * X[f]\r\n\u001b[?2004l\r"]
[169.113806, "o", "\u001b[?2004h> "]
[169.113898, "o", "            interaction_cols.append(col_name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.113931, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[169.113949, "o", "> "]
[169.114018, "o", "        X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.114089, "o", "        y = cat_extensive['Has_Purchase']\r\n\u001b[?2004l\r"]
[169.11411, "o", "\u001b[?2004h> "]
[169.114129, "o", "        \r\n\u001b[?2004l\r"]
[169.114148, "o", "\u001b[?2004h> "]
[169.114213, "o", "        model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r"]
[169.114237, "o", "\u001b[?2004h> "]
[169.114258, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[169.114277, "o", "> "]
[169.114339, "o", "        for f in valid_features:\r\n\u001b[?2004l\r"]
[169.114373, "o", "\u001b[?2004h> "]
[169.114439, "o", "            inter_col = f'Interaction_{f}'\r\n\u001b[?2004l\r"]
[169.114459, "o", "\u001b[?2004h> "]
[169.114538, "o", "            if inter_col in model.params:\r\n\u001b[?2004l\r"]
[169.114556, "o", "\u001b[?2004h> "]
[169.114634, "o", "                extensive_drivers.append({\r\n\u001b[?2004l\r"]
[169.114653, "o", "\u001b[?2004h> "]
[169.114833, "o", "                    \"feature\": f,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.114858, "o", "                    \"did_estimate\": float(model.params[inter_col]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.114879, "o", "> "]
[169.116038, "o", "                    \"p_value\": float(model.pvalues[inter_col]),\r\n\u001b[?2004l\r\u001b[?2004h>                     \"method\": \"Multivariate Heterogeneous DiD\"\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'Multivariate failed for {category}: {e}. Falling back to Univariate.')\r\n\u001b[?2004l\r\u001b[?2004h>         # Fallback code if needed, but for now let's hope it works or return empty\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort Extensive Drivers\r\n\u001b[?2004l\r\u001b[?2004h>     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h>         extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\r\n\u001b[?2004l\r"]
[169.116081, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.116203, "o", "    stats['extensive_margin'] = extensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[169.116311, "o", "\u001b[?2004h>     return stats\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.116343, "o", "# Run for Surge\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.11639, "o", "> "]
[169.116529, "o", "print('Processing Surge Categories...')\r\n\u001b[?2004l\r\u001b[?2004h> for _, row in surge_cats.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.116668, "o", "    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.116728, "o", "> "]
[169.116783, "o", "    results_json['surge_categories'].append(res)\r\n\u001b[?2004l\r"]
[169.116816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[169.116843, "o", "> "]
[169.116926, "o", "# Run for Slump\r\n\u001b[?2004l\r"]
[169.116958, "o", "\u001b[?2004h> print('Processing Slump Categories...')\r\n\u001b[?2004l\r"]
[169.117021, "o", "\u001b[?2004h> "]
[169.117052, "o", "for _, row in slump_cats.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.117217, "o", "    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.117268, "o", "    results_json['slump_categories'].append(res)\r\n\u001b[?2004l\r"]
[169.117331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.117363, "o", "\u001b[?2004h> # Summary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.117422, "o", "results_json['summary']['surge'] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.117524, "o", "    \"total_categories\": len(results_json['surge_categories']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.117546, "o", "> "]
[169.11765, "o", "    \"total_intensive_drivers\": len(results_json['surge_categories']) * 3,\r\n\u001b[?2004l\r"]
[169.117711, "o", "\u001b[?2004h> "]
[169.11781, "o", "    \"total_extensive_drivers\": len(results_json['surge_categories']) * 3\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.117871, "o", "> "]
[169.11793, "o", "results_json['summary']['slump'] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.118004, "o", "    \"total_categories\": len(results_json['slump_categories']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.118062, "o", "> "]
[169.118123, "o", "    \"total_intensive_drivers\": len(results_json['slump_categories']) * 3,\r\n\u001b[?2004l\r"]
[169.118183, "o", "\u001b[?2004h> "]
[169.118268, "o", "    \"total_extensive_drivers\": len(results_json['slump_categories']) * 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.11833, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.118382, "o", "# Save JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.118448, "o", "with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.118516, "o", "    json.dump(results_json, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.118574, "o", "\u001b[?2004h> "]
[169.118631, "o", "print(f'Analysis complete. Saved to {output_path}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.118693, "o", "EOF\r\n\u001b[?2004l\r"]
