[275.096014, "i", "cat <<EOF > /app/run_causal_analysis.py\nimport pandas as pd\nimport numpy as np\nimport statsmodels.api as sm\nimport json\nimport os\n\n# Paths\nintensive_path = '/app/output/user_category_period_aggregated_intensive.csv'\nextensive_path = '/app/output/user_category_period_aggregated_extensive.csv'\nfeatures_path = '/app/output/survey_feature_engineered.csv'\nanomaly_path = '/app/output/category_anomaly_index.csv'\noutput_path = '/app/output/causal_analysis_report.json'\n\nprint('Loading data...')\nintensive_df = pd.read_csv(intensive_path)\nextensive_df = pd.read_csv(extensive_path)\nfeatures_df = pd.read_csv(features_path)\nanomaly_df = pd.read_csv(anomaly_path)\n\n# Prepare features: Convert boolean to int\nfeature_cols = [c for c in features_df.columns if c != 'Survey ResponseID']\nprint(f'Total features: {len(feature_cols)}')\n\n# Convert features to numeric (int)\nfor col in feature_cols:\n    features_df[col] = features_df[col].astype(int)\n\n# Merge features into dataframes\nintensive_df = intensive_df.merge(features_df, on='Survey ResponseID', how='left')\nextensive_df = extensive_df.merge(features_df, on='Survey ResponseID', how='left')\n\n# Encode Period: Baseline=0, Treatment=1\nintensive_df['Period_Num'] = (intensive_df['Period'] == 'Treatment').astype(int)\nextensive_df['Period_Num'] = (extensive_df['Period'] == 'Treatment').astype(int)\n\n# Get Categories\nsurge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)\nslump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)\n\nresults_json = {\n    \"metadata\": {\n        \"baseline_start\": \"01-01-2020\",\n        \"baseline_end\": \"02-29-2020\",\n        \"treatment_start\": \"03-01-2020\",\n        \"treatment_end\": \"03-31-2020\",\n        \"total_features_analyzed\": len(feature_cols)\n    },\n    \"surge_categories\": [],\n    \"slump_categories\": [],\n    \"summary\": {}\n}\n\ndef analyze_category(category, anomaly_score, is_surge):\n    print(f'Analyzing {category}...')\n    cat_intensive = intensive_df[intensive_df['Category'] == category].copy()\n    cat_extensive = extensive_df[extensive_df['Category'] == category].copy()\n    \n    # Basic Stats\n    baseline_spend = cat_intensive[cat_intensive['Period'] == 'Baseline']['Total Spend']\n    treatment_spend = cat_intensive[cat_intensive['Period'] == 'Treatment']['Total Spend']\n    \n    # Purchasers count (extensive)\n    baseline_purchasers = cat_extensive[(cat_extensive['Period'] == 'Baseline') & (cat_extensive['Has_Purchase'] == 1)].shape[0]\n    treatment_purchasers = cat_extensive[(cat_extensive['Period'] == 'Treatment') & (cat_extensive['Has_Purchase'] == 1)].shape[0]\n    n_users = cat_extensive['Survey ResponseID'].nunique()\n    \n    stats = {\n        \"category\": category,\n        \"anomaly_index\": round(anomaly_score, 2),\n        \"baseline_avg_spend\": round(baseline_spend.mean(), 2),\n        \"treatment_avg_spend\": round(treatment_spend.mean(), 2),\n        \"n_purchasers_baseline\": int(baseline_purchasers),\n        \"n_purchasers_treatment\": int(treatment_purchasers),\n        \"baseline_purchase_rate\": round(baseline_purchasers / n_users, 4),\n        \"treatment_purchase_rate\": round(treatment_purchasers / n_users, 4),\n        \"n_at_risk\": int(n_users)\n    }\n    \n    # --- Intensive Margin: Univariate DiD ---\n    intensive_drivers = []\n    for feature in feature_cols:\n        if cat_intensive[feature].nunique() < 2:\n            continue\n            \n        X = cat_intensive[['Period_Num', feature]].copy()\n        X['Interaction'] = X['Period_Num'] * X[feature]\n        X = sm.add_constant(X)\n        y = cat_intensive['Total Spend']\n        \n        try:\n            model = sm.OLS(y, X.astype(float)).fit()\n            coeff = model.params['Interaction']\n            pval = model.pvalues['Interaction']\n            \n            intensive_drivers.append({\n                \"feature\": feature,\n                \"did_estimate\": float(coeff),\n                \"p_value\": float(pval),\n                \"method\": \"Univariate DiD\"\n            })\n        except Exception as e:\n            # print(f'Intensive failed for {feature}: {e}')\n            continue\n"]
[275.09608, "i", "            \n    if is_surge:\n        intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    else:\n        intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\n    \n    stats['intensive_margin'] = intensive_drivers[:3]\n    \n    # --- Extensive Margin: Multivariate Heterogeneous DiD ---\n    extensive_drivers = []\n    try:\n        valid_features = [f for f in feature_cols if cat_extensive[f].nunique() > 1]\n        \n        # Build X iteratively or with concat to avoid fragmentation warning\n        # X = [Period, F1...Fn, P*F1...P*Fn]\n        \n        # Base parts\n        period_col = cat_extensive[['Period_Num']]\n        feat_cols = cat_extensive[valid_features]\n        \n        # Interactions\n        # To do this efficiently: multiply period vector by feature matrix\n        # Period_Num is 0/1. So Interaction_Fi is just Fi where Period=1, else 0.\n        inter_cols = feat_cols.multiply(cat_extensive['Period_Num'], axis=0)\n        inter_cols.columns = [f'Interaction_{f}' for f in valid_features]\n        \n        X = pd.concat([period_col, feat_cols, inter_cols], axis=1)\n        X = sm.add_constant(X)\n        y = cat_extensive['Has_Purchase']\n        \n        model = sm.OLS(y, X.astype(float)).fit()\n        \n        for f in valid_features:\n            inter_col = f'Interaction_{f}'\n            if inter_col in model.params:\n                extensive_drivers.append({\n                    \"feature\": f,\n                    \"did_estimate\": float(model.params[inter_col]),\n                    \"p_value\": float(model.pvalues[inter_col]),\n                    \"method\": \"Multivariate Heterogeneous DiD\"\n                })\n    except Exception as e:\n        print(f'Multivariate failed for {category}: {e}')\n        pass\n        \n    if is_surge:\n        extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    else:\n        extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\n        \n    stats['extensive_margin'] = extensive_drivers[:3]\n    \n    return stats\n\n# Run for Surge\nprint('Processing Surge Categories...')\nfor _, row in surge_cats.iterrows():\n    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=True)\n    results_json['surge_categories'].append(res)\n\n# Run for Slump\nprint('Processing Slump Categories...')\nfor _, row in slump_cats.iterrows():\n    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=False)\n    results_json['slump_categories'].append(res)\n\n# Summary\nresults_json['summary']['surge'] = {\n    \"total_categories\": len(results_json['surge_categories']),\n    \"total_intensive_drivers\": len(results_json['surge_categories']) * 3,\n    \"total_extensive_drivers\": len(results_json['surge_categories']) * 3\n}\nresults_json['summary']['slump'] = {\n    \"total_categories\": len(results_json['slump_categories']),\n    \"total_intensive_drivers\": len(results_json['slump_categories']) * 3,\n    \"total_extensive_drivers\": len(results_json['slump_categories']) * 3\n}\n\nwith open(output_path, 'w') as f:\n    json.dump(results_json, f, indent=2)\n\nprint(f'Analysis complete. Saved to {output_path}')\nEOF\n"]
