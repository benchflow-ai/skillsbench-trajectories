[79.940489, "i", "cat <<EOF > /app/feature_engineering.py\nimport pandas as pd\nimport os\n\n# Paths\nsurvey_path = '/app/output/survey_cleaned.csv'\noutput_dir = '/app/output/'\n\nprint('Loading survey data...')\ndf = pd.read_csv(survey_path)\n\n# Identify categorical columns\n# Based on head output: Q-demos-age, Q-demos-hispanic, Q-demos-race, Q-demos-education, Q-demos-income, Q-demos-gender, Q-demos-state, etc.\n# We will select relevant demographic columns for engineering.\n\ndemo_cols = [\n    'Q-demos-age',\n    'Q-demos-hispanic',\n    'Q-demos-race',\n    'Q-demos-education',\n    'Q-demos-income',\n    'Q-demos-gender',\n    'Q-demos-state',\n    'Q-amazon-use-hh-size',\n    'Q-amazon-use-how-oft'\n]\n\n# Filter to ID and demo cols\n# Keep ID separate\nids = df['Survey ResponseID']\ndemo_data = df[demo_cols]\n\n# One-hot encode\nprint('One-hot encoding features...')\nencoded_data = pd.get_dummies(demo_data, dummy_na=False, prefix_sep='_')\n\n# Clean feature names (remove special characters like brackets, spaces)\nencoded_data.columns = encoded_data.columns.str.replace('[^a-zA-Z0-9_]', '_', regex=True)\n\n# Combine with ID\nfinal_df = pd.concat([ids, encoded_data], axis=1)\n\n# Save\noutput_path = os.path.join(output_dir, 'survey_feature_engineered.csv')\nfinal_df.to_csv(output_path, index=False)\n\nprint(f'Feature engineering complete. Saved to {output_path}')\nprint(f'Generated {len(encoded_data.columns)} features.')\nEOF\n"]
