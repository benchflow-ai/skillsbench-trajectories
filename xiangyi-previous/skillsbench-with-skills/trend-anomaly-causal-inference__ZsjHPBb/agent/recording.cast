[275.111233, "o", "        y = cat_intensive['Total Spend']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111325, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111433, "o", "            model = sm.OLS(y, X.astype(float)).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111538, "o", "            coeff = model.params['Interaction']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111653, "o", "            pval = model.pvalues['Interaction']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111778, "o", "            intensive_drivers.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111883, "o", "                \"feature\": feature,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"did_estimate\": float(coeff),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.111911, "o", "                \"p_value\": float(pval),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.112017, "o", "                \"method\": \"Univariate DiD\"\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r"]
[275.112052, "o", "\u001b[?2004h> "]
[275.112149, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.112218, "o", "            # print(f'Intensive failed for {feature}: {e}')\r\n\u001b[?2004l\r"]
[275.112336, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11241, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h>     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11249, "o", "        intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.112568, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11268, "o", "        intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[275.112774, "o", "\u001b[?2004h> "]
[275.112844, "o", "    stats['intensive_margin'] = intensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11292, "o", "    # --- Extensive Margin: Multivariate Heterogeneous DiD ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.112944, "o", "> "]
[275.113061, "o", "    extensive_drivers = []\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113169, "o", "        valid_features = [f for f in feature_cols if cat_extensive[f].nunique() > 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113199, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113327, "o", "        # Build X iteratively or with concat to avoid fragmentation warning\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.113416, "o", "> "]
[275.113513, "o", "        # X = [Period, F1...Fn, P*F1...P*Fn]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113601, "o", "        # Base parts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113684, "o", "        period_col = cat_extensive[['Period_Num']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113784, "o", "        feat_cols = cat_extensive[valid_features]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113856, "o", "        # Interactions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.113935, "o", "        # To do this efficiently: multiply period vector by feature matrix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11407, "o", "        # Period_Num is 0/1. So Interaction_Fi is just Fi where Period=1, else 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11419, "o", "        inter_cols = feat_cols.multiply(cat_extensive['Period_Num'], axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114316, "o", "        inter_cols.columns = [f'Interaction_{f}' for f in valid_features]\r\n\u001b[?2004l\r"]
[275.114344, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[275.114365, "o", "\u001b[?2004h> "]
[275.11451, "o", "        X = pd.concat([period_col, feat_cols, inter_cols], axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114609, "o", "        X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114686, "o", "        y = cat_extensive['Has_Purchase']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114757, "o", "        model = sm.OLS(y, X.astype(float)).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114787, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114881, "o", "        for f in valid_features:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.114953, "o", "            inter_col = f'Interaction_{f}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11502, "o", "            if inter_col in model.params:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115113, "o", "                extensive_drivers.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115186, "o", "                    \"feature\": f,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115277, "o", "                    \"did_estimate\": float(model.params[inter_col]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115414, "o", "                    \"p_value\": float(model.pvalues[inter_col]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115505, "o", "                    \"method\": \"Multivariate Heterogeneous DiD\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.115529, "o", "> "]
[275.115632, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115714, "o", "        print(f'Multivariate failed for {category}: {e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.115751, "o", ">         pass\r\n\u001b[?2004l\r"]
[275.11577, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[275.115906, "o", "\u001b[?2004h>     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.115975, "o", "        extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116004, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.116024, "o", "> "]
[275.116151, "o", "        extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11618, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116274, "o", "    stats['extensive_margin'] = extensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116364, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116395, "o", "    return stats\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116425, "o", "# Run for Surge\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116541, "o", "print('Processing Surge Categories...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116568, "o", "for _, row in surge_cats.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.11659, "o", "> "]
[275.116736, "o", "    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.116829, "o", "    results_json['surge_categories'].append(res)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[275.116919, "o", "\u001b[?2004h> # Run for Slump\r\n\u001b[?2004l\r"]
[275.116946, "o", "\u001b[?2004h> print('Processing Slump Categories...')\r\n\u001b[?2004l\r"]
[275.116967, "o", "\u001b[?2004h> "]
[275.117092, "o", "for _, row in slump_cats.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117163, "o", "    res = analyze_category(row['Category'], row['Anomaly_Index'], is_surge=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.11719, "o", "> "]
[275.117275, "o", "    results_json['slump_categories'].append(res)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117301, "o", "# Summary\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.11732, "o", "> "]
[275.117433, "o", "results_json['summary']['surge'] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117501, "o", "    \"total_categories\": len(results_json['surge_categories']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117628, "o", "    \"total_intensive_drivers\": len(results_json['surge_categories']) * 3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117772, "o", "    \"total_extensive_drivers\": len(results_json['surge_categories']) * 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117859, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117928, "o", "results_json['summary']['slump'] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.117966, "o", "    \"total_categories\": len(results_json['slump_categories']),\r\n\u001b[?2004l\r"]
[275.117986, "o", "\u001b[?2004h> "]
[275.118105, "o", "    \"total_intensive_drivers\": len(results_json['slump_categories']) * 3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.118219, "o", "    \"total_extensive_drivers\": len(results_json['slump_categories']) * 3\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.118331, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.11843, "o", "with open(output_path, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.118516, "o", "    json.dump(results_json, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.118612, "o", "print(f'Analysis complete. Saved to {output_path}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
