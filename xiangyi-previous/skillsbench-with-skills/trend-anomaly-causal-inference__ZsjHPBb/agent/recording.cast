[64.768618, "o", "# Filter data for relevant periods\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.768741, "o", "baseline_data = df[(df['Order Date'] >= baseline_start) & (df['Order Date'] <= baseline_end)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.768898, "o", "treatment_data = df[(df['Order Date'] >= treatment_start) & (df['Order Date'] <= treatment_end)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.768971, "o", "# Calculate daily sales per category\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.769046, "o", "# We need average daily spend. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.769103, "o", "# 1. Sum spend per category per day.\r\n\u001b[?2004l\r"]
[64.769167, "o", "\u001b[?2004h> "]
[64.769241, "o", "# 2. Average those daily sums over the period.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.769313, "o", "def get_avg_daily_sales(data, start_date, end_date):\r\n\u001b[?2004l\r"]
[64.769383, "o", "\u001b[?2004h> "]
[64.769451, "o", "    if data.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.769512, "o", "        return pd.Series(dtype=float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.769622, "o", "    daily = data.groupby(['Category', 'Order Date'])['Total Spend'].sum().reset_index()\r\n\u001b[?2004l\r"]
[64.769659, "o", "\u001b[?2004h> "]
[64.769871, "o", "    # Ensure we account for days with 0 sales if necessary, but usually we just average over the days in the range.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.77001, "o", "    # To be precise, we should divide total sales in period by number of days in period.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770114, "o", "    total_sales = data.groupby('Category')['Total Spend'].sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770236, "o", "    n_days = (pd.to_datetime(end_date) - pd.to_datetime(start_date)).days + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770299, "o", "    return total_sales / n_days\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770345, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770463, "o", "baseline_avg = get_avg_daily_sales(baseline_data, baseline_start, baseline_end)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770593, "o", "treatment_avg = get_avg_daily_sales(treatment_data, treatment_start, treatment_end)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.770713, "o", "\u001b[?2004h> # Combine\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.770796, "o", "> results = pd.DataFrame({'Baseline_Avg': baseline_avg, 'Treatment_Avg': treatment_avg})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.770833, "o", "results = results.fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.770924, "o", "\u001b[?2004h> # Calculate Anomaly Index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771001, "o", "# Formula: ((Treatment - Baseline) / Baseline) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771073, "o", "# Handle division by zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771144, "o", "results['Anomaly_Index'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771219, "o", "mask = results['Baseline_Avg'] > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771439, "o", "results.loc[mask, 'Anomaly_Index'] = ((results.loc[mask, 'Treatment_Avg'] - results.loc[mask, 'Baseline_Avg']) / results.loc[mask, 'Baseline_Avg']) * 100\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[64.771477, "o", "> "]
[64.771581, "o", "# Handle cases where Baseline is 0 but Treatment > 0 (infinite surge -> 100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.771746, "o", "results.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] > 0), 'Anomaly_Index'] = 100.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.77178, "o", "> "]
[64.771871, "o", "# Handle cases where both are 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.77199, "o", "results.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] == 0), 'Anomaly_Index'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772058, "o", "# Clamp to -100, 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772152, "o", "results['Anomaly_Index'] = results['Anomaly_Index'].clip(-100, 100)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[64.772189, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[64.772258, "o", "# Reset index to make Category a column\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772366, "o", "results = results.reset_index().rename(columns={'index': 'Category'})\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.772437, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772478, "o", "# Save\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.77255, "o", "output_path = os.path.join(output_dir, 'category_anomaly_index.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772671, "o", "results[['Category', 'Anomaly_Index']].to_csv(output_path, index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772772, "o", "print(f'Anomaly detection complete. Saved to {output_path}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.772808, "o", "> "]
[64.772844, "o", "print('Top 5 Surges:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.772968, "o", "print(results.sort_values('Anomaly_Index', ascending=False).head(5))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.773001, "o", "print('Top 5 Slumps:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.773109, "o", "print(results.sort_values('Anomaly_Index', ascending=True).head(5))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.773184, "o", "EOF\r\n\u001b[?2004l\r"]
[64.774484, "o", "\u001b[?2004hroot@da380c1bd5a4:/app# "]
[64.929445, "i", "python3 /app/detect_anomalies.py\n"]
