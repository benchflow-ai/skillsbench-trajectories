[36.710346, "i", "cat <<EOF > /app/clean_data.py\nimport pandas as pd\nimport numpy as np\nimport os\n\n# Paths\nsurvey_path = '/app/data/survey_dirty.csv'\npurchase_path = '/app/data/amazon-purchases-2019-2020_dirty.csv'\noutput_dir = '/app/output/'\n\n# Ensure output directory exists\nos.makedirs(output_dir, exist_ok=True)\n\nprint('Loading data...')\ntry:\n    survey_df = pd.read_csv(survey_path)\n    purchase_df = pd.read_csv(purchase_path)\nexcept Exception as e:\n    print(f'Error loading data: {e}')\n    exit(1)\n\n# --- Clean Survey Data ---\nprint('Cleaning survey data...')\ninitial_survey_len = len(survey_df)\n# Drop duplicates\nsurvey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'])\n# Fill missing values for demographics with 'Unknown'\nsurvey_df = survey_df.fillna('Unknown')\n\nprint(f'Survey data: {initial_survey_len} -> {len(survey_df)} rows')\nsurvey_df.to_csv(os.path.join(output_dir, 'survey_cleaned.csv'), index=False)\n\n# --- Clean Purchase Data ---\nprint('Cleaning purchase data...')\ninitial_purchase_len = len(purchase_df)\n\n# Drop duplicates\npurchase_df = purchase_df.drop_duplicates()\n\n# Convert Order Date\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'], errors='coerce')\npurchase_df = purchase_df.dropna(subset=['Order Date'])\n\n# Drop rows with missing Category\npurchase_df = purchase_df.dropna(subset=['Category'])\n\n# Clean Price and Quantity\n# Remove '$' if present and convert to float\nif purchase_df['Purchase Price Per Unit'].dtype == object:\n    purchase_df['Purchase Price Per Unit'] = purchase_df['Purchase Price Per Unit'].astype(str).str.replace('$', '').str.replace(',', '')\npurchase_df['Purchase Price Per Unit'] = pd.to_numeric(purchase_df['Purchase Price Per Unit'], errors='coerce')\n\npurchase_df['Quantity'] = pd.to_numeric(purchase_df['Quantity'], errors='coerce')\n\n# Drop rows with invalid price or quantity\npurchase_df = purchase_df.dropna(subset=['Purchase Price Per Unit', 'Quantity'])\n\n# Calculate Total Spend (useful for later)\npurchase_df['Total Spend'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']\n\n# Filter for relevant columns to save space if needed, but keeping all for now as per instructions\n# We need to ensure the Category strings are clean (strip whitespace)\npurchase_df['Category'] = purchase_df['Category'].astype(str).str.strip()\n\nprint(f'Purchase data: {initial_purchase_len} -> {len(purchase_df)} rows')\npurchase_df.to_csv(os.path.join(output_dir, 'amazon-purchases-2019-2020-filtered.csv'), index=False)\n\nprint('Data cleaning complete.')\nEOF\n"]
