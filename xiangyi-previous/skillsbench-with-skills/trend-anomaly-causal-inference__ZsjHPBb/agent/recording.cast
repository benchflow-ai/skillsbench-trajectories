[208.435254, "o", "{\r\n  \"metadata\": {\r\n    \"baseline_start\": \"01-01-2020\",\r\n    \"baseline_end\": \"02-29-2020\",\r\n    \"treatment_start\": \"03-01-2020\",\r\n    \"treatment_end\": \"03-31-2020\",\r\n    \"total_features_analyzed\": 133\r\n  },\r\n  \"surge_categories\": [\r\n    {\r\n      \"category\": \"BOARD_GAME\",\r\n      \"anomaly_index\": 100.0,\r\n      \"baseline_avg_spend\": 0.24,\r\n      \"treatment_avg_spend\": 0.31,\r\n      \"n_purchasers_baseline\": 43,\r\n      \"n_purchasers_treatment\": 47,\r\n      \"baseline_purchase_rate\": 0.0086,\r\n      \"treatment_purchase_rate\": 0.0093,\r\n      \"n_at_risk\": 5027,\r\n      \"intensive_margin\": [],\r\n"]
[208.43543, "o", "\u001b[?2004hroot@da380c1bd5a4:/app# "]
[239.127365, "i", "cat <<EOF > /app/debug_analysis.py\nimport pandas as pd\nimport numpy as np\nimport statsmodels.api as sm\n\n# Paths\nintensive_path = '/app/output/user_category_period_aggregated_intensive.csv'\nfeatures_path = '/app/output/survey_feature_engineered.csv'\n\nprint('Loading data...')\nintensive_df = pd.read_csv(intensive_path)\nfeatures_df = pd.read_csv(features_path)\n\nprint('Merging...')\nintensive_df = intensive_df.merge(features_df, on='Survey ResponseID', how='left')\n\nprint('Checking for NaNs in features...')\nfeature_cols = [c for c in features_df.columns if c != 'Survey ResponseID']\nprint(f'NaNs in features: {intensive_df[feature_cols].isna().sum().sum()}')\n\n# Encode Period\nintensive_df['Period_Num'] = (intensive_df['Period'] == 'Treatment').astype(int)\n\n# Select one category\ncat = intensive_df['Category'].unique()[0]\nprint(f'Testing Category: {cat}')\ncat_data = intensive_df[intensive_df['Category'] == cat].copy()\n\n# Select one feature\nfeat = feature_cols[0]\nprint(f'Testing Feature: {feat}')\n\nX = cat_data[['Period_Num', feat]].copy()\nX['Interaction'] = X['Period_Num'] * X[feat]\nX = sm.add_constant(X)\ny = cat_data['Total Spend']\n\nprint('Data types in X:')\nprint(X.dtypes)\nprint('Data types in y:')\nprint(y.dtypes)\n\nprint('Head of X:')\nprint(X.head())\n\ntry:\n    model = sm.OLS(y, X).fit()\n    print('Success!')\n    print(model.summary())\nexcept Exception as e:\n    print(f'Error: {e}')\nEOF\n"]
[239.127891, "o", "cat <<EOF > /app/debug_analysis.py\r\n\u001b[?2004l\r"]
