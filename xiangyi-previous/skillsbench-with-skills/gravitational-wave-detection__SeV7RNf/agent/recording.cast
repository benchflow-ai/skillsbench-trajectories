[503.505817, "i", "cat > /root/gw_analysis2.py << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter, highpass\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation, welch\nfrom pycbc.waveform import get_td_waveform\nimport csv\nimport sys\n\n# Read the data\nprint(\"Reading data...\", flush=True)\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nprint(f\"Data: duration={strain.duration}s, sample_rate={strain.sample_rate}Hz\", flush=True)\n\n# Condition the data\nprint(\"Conditioning data...\", flush=True)\nstrain = highpass(strain, 15.0)\nstrain = strain.crop(2, 2)\n\n# Estimate PSD\nprint(\"Estimating PSD...\", flush=True)\npsd = welch(strain, seg_len=int(strain.sample_rate * 4), seg_stride=int(strain.sample_rate * 2))\npsd = interpolate(psd, strain.delta_f)\npsd = inverse_spectrum_truncation(psd, int(4 * strain.sample_rate), low_frequency_cutoff=15.0)\n\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nmass_range = range(10, 41)\n\nresults = []\n\nfor approx in approximant"]
[503.50586, "i", "s:\n    print(f\"Processing: {approx}\", flush=True)\n    best_snr = 0\n    best_m1 = 0\n    best_m2 = 0\n    count = 0\n    \n    for m1 in mass_range:\n        for m2 in mass_range:\n            if m2 > m1:\n                continue\n            count += 1\n            \n            try:\n                hp, hc = get_td_waveform(\n                    approximant=approx,\n                    mass1=m1,\n                    mass2=m2,\n                    delta_t=strain.delta_t,\n                    f_lower=20.0\n                )\n                hp.resize(len(strain))\n                snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=20.0)\n                peak_snr = abs(snr).numpy().max()\n                \n                if peak_snr > best_snr:\n                    best_snr = peak_snr\n                    best_m1 = m1\n                    best_m2 = m2\n            except Exception as e:\n                pass\n        \n        # Progress indicator\n        if m1 % 10 == 0:\n            print(f\"  m1={m1}, best_snr={best_snr:.2f}\""]
[503.505872, "i", ", flush=True)\n    \n    total_mass = best_m1 + best_m2\n    results.append({'approximant': approx, 'snr': best_snr, 'total_mass': total_mass})\n    print(f\"  Result: SNR={best_snr:.2f}, m1={best_m1}, m2={best_m2}, total_mass={total_mass}\", flush=True)\n\n# Write results\nprint(\"\\nWriting results...\", flush=True)\nwith open('/root/detection_results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['approximant', 'snr', 'total_mass'])\n    for r in results:\n        writer.writerow([r['approximant'], r['snr'], r['total_mass']])\n\nprint(\"\\nFinal Results:\")\nfor r in results:\n    print(f\"{r['approximant']}: SNR={r['snr']:.4f}, total_mass={r['total_mass']}\")\nprint(\"Done!\")\nEOF\n"]
