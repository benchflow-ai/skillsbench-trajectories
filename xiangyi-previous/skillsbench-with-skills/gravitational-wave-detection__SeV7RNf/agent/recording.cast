[9.109816, "o", "\u001b[?2004hroot@115cce2375d0:~# "]
[27.679738, "i", "cat > /root/gw_analysis.py << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter, highpass\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.catalog import Merger\nimport csv\n\n# Read the data\nprint(\"Reading data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nprint(f\"Data loaded: duration={strain.duration}s, sample_rate={strain.sample_rate}Hz\")\n\n# Condition the data\nprint(\"Conditioning data...\")\n# Highpass filter to remove low frequency noise\nstrain = highpass(strain, 15.0)\n\n# Crop to avoid filter artifacts\nstrain = strain.crop(2, 2)\n\n# Resample if needed (to reduce computation)\nif strain.sample_rate > 4096:\n    strain = strain.resample(4096)\n\nprint(f\"After conditioning: duration={strain.duration}s, sample_rate={strain.sample_rate}Hz\")\n\n# Estimate PSD\nprint(\"Estimating PSD...\")\nfrom pycbc.psd import welch\npsd = welch(strain, seg_len=int(strain.sample_rate * 4), seg_stride="]
[27.679952, "o", "cat > /root/gw_analysis.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.680048, "i", "int(strain.sample_rate * 2))\n\n# Interpolate PSD to match data length\npsd = interpolate(psd, strain.delta_f)\npsd = inverse_spectrum_truncation(psd, int(4 * strain.sample_rate), low_frequency_cutoff=15.0)\n\n# Define approximants and mass range\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nmass_range = range(10, 41)  # 10 to 40 inclusive\n\nresults = []\n\nfor approx in approximants:\n    print(f\"\\nProcessing approximant: {approx}\")\n    best_snr = 0\n    best_total_mass = 0\n    \n    for m1 in mass_range:\n        for m2 in mass_range:\n            if m2 > m1:  # Avoid duplicates, m1 >= m2 by convention\n                continue\n            \n            try:\n                # Generate template\n                hp, hc = get_td_waveform(\n                    approximant=approx,\n                    mass1=m1,\n                    mass2=m2,\n                    delta_t=strain.delta_t,\n                    f_lower=20.0\n                )\n                \n                # Resize template to match data length\n              "]
[27.68011, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from pycbc.frame import read_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.680172, "i", "  hp.resize(len(strain))\n                \n                # Perform matched filtering\n                snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=20.0)\n                \n                # Find peak SNR\n                peak_snr = abs(snr).numpy().max()\n                \n                if peak_snr > best_snr:\n                    best_snr = peak_snr\n                    best_total_mass = m1 + m2\n                    print(f\"  New best: m1={m1}, m2={m2}, total_mass={best_total_mass}, SNR={best_snr:.2f}\")\n                    \n            except Exception as e:\n                # Some approximants may not support all mass combinations\n                pass\n    \n    results.append({\n        'approximant': approx,\n        'snr': best_snr,\n        'total_mass': best_total_mass\n    })\n    print(f\"Best for {approx}: SNR={best_snr:.2f}, total_mass={best_total_mass}\")\n\n# Write results to CSV\nprint(\"\\nWriting results to /root/detection_results.csv\")\nwith open('/root/detection_results.csv', 'w', newline='') as"]
[27.68022, "o", "from pycbc.filter import matched_filter, highpass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.68027, "i", " f:\n    writer = csv.writer(f)\n    writer.writerow(['approximant', 'snr', 'total_mass'])\n    for r in results:\n        writer.writerow([r['approximant'], r['snr'], r['total_mass']])\n\nprint(\"Done!\")\nfor r in results:\n    print(f\"{r['approximant']}: SNR={r['snr']:.2f}, total_mass={r['total_mass']}\")\nEOF\n"]
[27.680337, "o", "from pycbc.psd import interpolate, inverse_spectrum_truncation\r\n\u001b[?2004l\r f:\r\n    writer = csv.writer(f)\r\n    writer.writerow(['approximant', 'snr', 'total_mass'])\r\n    for r in results:\r\n        writer.writerow([r['approximant'], r['snr'], r['total_mass']])\r\n\r\nprint(\"Done!\")\r\nfor r in results:\r\n    print(f\"{r['approximant']}: SNR={r['snr']:.2f}, total_mass={r['total_mass']}\")\r\nEOF\r\n"]
