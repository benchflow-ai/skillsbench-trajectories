[56.278906, "i", "python3 << 'EOF'\nimport numpy as np\nfrom scipy.signal import medfilt\n\n# Load and filter data\ndata = np.loadtxt('/root/data/tess_lc.txt')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Quality filtering and outlier removal\nmask = (flag == 0)\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask_outliers = np.abs(flux - median_flux) < 5 * std_flux\ntime = time[mask_outliers]\nflux = flux[mask_outliers]\nflux_err = flux_err[mask_outliers]\n\n# Detrend\nwindow_size = 101\nflux_trend = medfilt(flux, kernel_size=window_size)\nflux_detrended = flux / flux_trend\n\nprint(\"Starting BLS period search...\")\n\n# Implement Box Least Squares (BLS) algorithm\ndef bls_power(time, flux, period, qmin=0.01, qmax=0.1, nq=10):\n    \"\"\"Calculate BLS power for a given period\"\"\"\n    # Fractional transit duration to test\n    q_values = np.linspace(qmin, qmax, nq)\n    max_sr = 0\n    \n    # Phase fold the data\n    phase = (time % period) / period\n    "]
[56.279979, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import medfilt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load and filter data\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')\r\n\u001b[?2004l\r\u001b[?2004h> time = data[:, 0]\r\n\u001b[?2004l\r\u001b[?2004h> flux = data[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> flag = data[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h> flux_err = data[:, 3]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Quality filtering and outlier removal\r\n\u001b[?2004l\r\u001b[?2004h> mask = (flag == 0)\r\n\u001b[?2004l\r\u001b[?2004h> time = time[mask]\r\n\u001b[?2004l\r\u001b[?2004h> flux = flux[mask]\r\n\u001b[?2004l\r\u001b[?2004h> flux_err = flux_err[mask]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> median_flux = np.median(flux)\r\n\u001b[?2004l\r\u001b[?2004h> std_flux = np.std(flux)\r\n\u001b[?2004l\r\u001b[?2004h> mask_outliers = np.abs(flux - median_flux) < 5 * std_flux\r\n\u001b[?2004l\r\u001b[?2004h> time = time[mask_outliers]\r\n\u001b[?2004l\r\u001b[?2004h> flux = flux[mask_outliers]\r\n\u001b[?2004l\r\u001b[?2004h> flux_err = flux_err[mask_outliers]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Detr"]
[56.280307, "i", "\n    for q in q_values:\n        # Test different transit phases\n        n_phase = int(1.0 / q)\n        for i in range(n_phase):\n            phase_center = i / n_phase\n            \n            # Separate in-transit and out-of-transit points\n            in_transit = np.abs(phase - phase_center) < q/2\n            in_transit |= np.abs(phase - phase_center - 1) < q/2\n            in_transit |= np.abs(phase - phase_center + 1) < q/2\n            \n            if np.sum(in_transit) < 3 or np.sum(~in_transit) < 3:\n                continue\n                \n            # Calculate signal residue (BLS statistic)\n            flux_in = flux[in_transit]\n            flux_out = flux[~in_transit]\n            \n            mean_in = np.mean(flux_in)\n            mean_out = np.mean(flux_out)\n            \n            if mean_out > 0:\n                sr = (mean_out - mean_in)**2 * len(flux_in) * len(flux_out) / len(flux)\n                max_sr = max(max_sr, sr)\n    \n    return max_sr\n\n# Search over period range\nperiod_min = 0.5\nperiod"]
[56.281047, "o", "end\r\n\u001b[?2004l\r\u001b[?2004h> window_size = 101\r\n\u001b[?2004l\r\u001b[?2004h> flux_trend = medfilt(flux, kernel_size=window_size)\r\n\u001b[?2004l\r\u001b[?2004h> flux_detrended = flux / flux_trend\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Starting BLS period search...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Implement Box Least Squares (BLS) algorithm\r\n\u001b[?2004l\r\u001b[?2004h> def bls_power(time, flux, period, qmin=0.01, qmax=0.1, nq=10):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Calculate BLS power for a given period\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Fractional transit duration to test\r\n\u001b[?2004l\r\u001b[?2004h>     q_values = np.linspace(qmin, qmax, nq)\r\n\u001b[?2004l\r\u001b[?2004h>     max_sr = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Phase fold the data\r\n\u001b[?2004l\r\u001b[?2004h>     phase = (time % period) / period\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[56.281101, "i", "_max = min(12.0, (time[-1] - time[0]) / 2)\nn_periods = 5000\n\nperiods = np.linspace(period_min, period_max, n_periods)\npower = np.zeros(n_periods)\n\nfor i, period in enumerate(periods):\n    if i % 500 == 0:\n        print(f\"Progress: {i}/{n_periods} periods tested\")\n    power[i] = bls_power(time, flux_detrended, period)\n\n# Find best period\nbest_idx = np.argmax(power)\nbest_period = periods[best_idx]\n\nprint(f\"\\nBest period found: {best_period:.5f} days\")\nprint(f\"BLS power: {power[best_idx]:.6f}\")\n\n# Save the period\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period:.5f}\\n\")\n\nprint(f\"Period written to /root/period.txt\")\n\nEOF\n"]
[56.281168, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for q in q_values:\r\n\u001b[?2004l\r\u001b[?2004h>         # Test different transit phases\r\n\u001b[?2004l\r\u001b[?2004h>         n_phase = int(1.0 / q)\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(n_phase):\r\n\u001b[?2004l\r\u001b[?2004h>             phase_center = i / n_phase\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Separate in-transit and out-of-transit points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.283997, "o", "            in_transit = np.abs(phase - phase_center) < q/2\r\n\u001b[?2004l\r\u001b[?2004h>             in_transit |= np.abs(phase - phase_center - 1) < q/2\r\n\u001b[?2004l\r\u001b[?2004h>             in_transit |= np.abs(phase - phase_center + 1) < q/2\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if np.sum(in_transit) < 3 or np.sum(~in_transit) < 3:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>             # Calculate signal residue (BLS statistic)\r\n\u001b[?2004l\r\u001b[?2004h>             flux_in = flux[in_transit]\r\n\u001b[?2004l\r\u001b[?2004h>             flux_out = flux[~in_transit]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             mean_in = np.mean(flux_in)\r\n\u001b[?2004l\r\u001b[?2004h>             mean_out = np.mean(flux_out)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if mean_out > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 sr = (mean_out - mean_in)**2 * len(flux_in) * len(flux_out) / len(flux)\r\n\u001b[?2004l\r\u001b[?2004h>                 max_sr = max(max_sr"]
[56.284729, "o", ", sr)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return max_sr\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Search over period range\r\n\u001b[?2004l\r\u001b[?2004h> period_min = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> period_max = min(12.0, (time[-1] - time[0]) / 2)\r\n\u001b[?2004l\r\u001b[?2004h> n_periods = 5000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> periods = np.linspace(period_min, period_max, n_periods)\r\n\u001b[?2004l\r\u001b[?2004h> power = np.zeros(n_periods)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i, period in enumerate(periods):\r\n\u001b[?2004l\r\u001b[?2004h>     if i % 500 == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Progress: {i}/{n_periods} periods tested\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.28477, "o", "    power[i] = bls_power(time, flux_detrended, period)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Find best period\r\n\u001b[?2004l\r\u001b[?2004h> best_idx = np.argmax(power)\r\n\u001b[?2004l\r\u001b[?2004h> best_period = periods[best_idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nBest period found: {best_period:.5f} days\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"BLS power: {power[best_idx]:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save the period\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
