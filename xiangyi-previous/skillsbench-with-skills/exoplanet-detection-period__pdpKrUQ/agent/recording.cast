[19.894604, "i", "python3 << 'EOF'\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nfrom scipy import signal\nfrom scipy.ndimage import median_filter\n\n# Load the data\ndata = np.loadtxt('/root/data/tess_lc.txt')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Filter by quality flag\nmask = (flag == 0)\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\nprint(f\"Data points after quality filtering: {len(time)}\")\n\n# Remove outliers using sigma clipping\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask_outliers = np.abs(flux - median_flux) < 5 * std_flux\ntime = time[mask_outliers]\nflux = flux[mask_outliers]\nflux_err = flux_err[mask_outliers]\n\nprint(f\"Data points after outlier removal: {len(time)}\")\nprint(f\"Time span: {time[-1] - time[0]:.2f} days\")\nprint(f\"Flux range: {flux.min():.6f} to {flux.max():.6f}\")\n\nEOF\n"]
