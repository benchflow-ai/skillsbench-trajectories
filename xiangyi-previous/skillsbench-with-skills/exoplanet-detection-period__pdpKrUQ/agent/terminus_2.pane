[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import medfilt
[?2004l[?2004h> 
[?2004l[?2004h> # Load and filter data
[?2004l[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')
[?2004l[?2004h> time = data[:, 0]
[?2004l[?2004h> flux = data[:, 1]
[?2004l[?2004h> flag = data[:, 2]
[?2004l[?2004h> flux_err = data[:, 3]
[?2004l[?2004h> 
[?2004l[?2004h> # Quality filtering and outlier removal
[?2004l[?2004h> mask = (flag == 0)
[?2004l[?2004h> time = time[mask]
[?2004l[?2004h> flux = flux[mask]
[?2004l[?2004h> flux_err = flux_err[mask]
[?2004l[?2004h> 
[?2004l[?2004h> median_flux = np.median(flux)
[?2004l[?2004h> std_flux = np.std(flux)
[?2004l[?2004h> mask_outliers = np.abs(flux - median_flux) < 5 * std_flux
[?2004l[?2004h> time = time[mask_outliers]
[?2004l[?2004h> flux = flux[mask_outliers]
[?2004l[?2004h> flux_err = flux_err[mask_outliers]
[?2004l[?2004h> 
[?2004l[?2004h> # Detrend
[?2004l[?2004h> window_size = 101
[?2004l[?2004h> flux_trend = medfilt(flux, kernel_size=window_size)
[?2004l[?2004h> flux_detrended = flux / flux_trend
[?2004l[?2004h> 
[?2004l[?2004h> print("Starting BLS period search...")
[?2004l[?2004h> 
[?2004l[?2004h> # Implement Box Least Squares (BLS) algorithm
[?2004l[?2004h> def bls_power(time, flux, period, qmin=0.01, qmax=0.1, nq=10):
[?2004l[?2004h>     """Calculate BLS power for a given period"""
[?2004l[?2004h>     # Fractional transit duration to test
[?2004l[?2004h>     q_values = np.linspace(qmin, qmax, nq)
[?2004l[?2004h>     max_sr = 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Phase fold the data
[?2004l[?2004h>     phase = (time % period) / period
[?2004l[?2004h>     
[?2004l[?2004h>     for q in q_values:
[?2004l[?2004h>         # Test different transit phases
[?2004l[?2004h>         n_phase = int(1.0 / q)
[?2004l[?2004h>         for i in range(n_phase):
[?2004l[?2004h>             phase_center = i / n_phase
[?2004l[?2004h>             
[?2004l[?2004h>             # Separate in-transit and out-of-transit points
[?2004l[?2004h>             in_transit = np.abs(phase - phase_center) < q/2
[?2004l[?2004h>             in_transit |= np.abs(phase - phase_center - 1) < q/2
[?2004l[?2004h>             in_transit |= np.abs(phase - phase_center + 1) < q/2
[?2004l[?2004h>             
[?2004l[?2004h>             if np.sum(in_transit) < 3 or np.sum(~in_transit) < 3:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # Calculate signal residue (BLS statistic)
[?2004l[?2004h>             flux_in = flux[in_transit]
[?2004l[?2004h>             flux_out = flux[~in_transit]
[?2004l[?2004h>             
[?2004l[?2004h>             mean_in = np.mean(flux_in)
[?2004l[?2004h>             mean_out = np.mean(flux_out)
[?2004l[?2004h>             
[?2004l[?2004h>             if mean_out > 0:
[?2004l[?2004h>                 sr = (mean_out - mean_in)**2 * len(flux_in) * len(flux_out) / len(flux)
[?2004l[?2004h>                 max_sr = max(max_sr, sr)
[?2004l[?2004h>     
[?2004l[?2004h>     return max_sr
[?2004l[?2004h> 
[?2004l[?2004h> # Search over period range
[?2004l[?2004h> period_min = 0.5
[?2004l[?2004h> period_max = min(12.0, (time[-1] - time[0]) / 2)
[?2004l[?2004h> n_periods = 5000
[?2004l[?2004h> 
[?2004l[?2004h> periods = np.linspace(period_min, period_max, n_periods)
[?2004l[?2004h> power = np.zeros(n_periods)
[?2004l[?2004h> 
[?2004l[?2004h> for i, period in enumerate(periods):
[?2004l[?2004h>     if i % 500 == 0:
[?2004l[?2004h>         print(f"Progress: {i}/{n_periods} periods tested")
[?2004l[?2004h>     power[i] = bls_power(time, flux_detrended, period)
[?2004l[?2004h> 
[?2004l[?2004h> # Find best period
[?2004l[?2004h> best_idx = np.argmax(power)
[?2004l[?2004h> best_period = periods[best_idx]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nBest period found: {best_period:.5f} days")
[?2004l[?2004h> print(f"BLS power: {power[best_idx]:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the period
[?2004l[?2004h> with open('/root/period.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{best_period:.5f}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Period written to /root/period.txt")
[?2004l[?2004h> 
