[231.024835, "i", "python3 << 'EOF'\nimport json\nwith open('report.json', 'r') as f:\n    report = json.load(f)\n\nprint(\"\\n=== GRID DISPATCH OPTIMIZATION REPORT ===\")\nprint(f\"\\nTotals:\")\nprint(f\"  Cost: ${report['totals']['cost_dollars_per_hour']:,.2f}/hour\")\nprint(f\"  Load: {report['totals']['load_MW']:,.1f} MW\")\nprint(f\"  Generation: {report['totals']['generation_MW']:,.1f} MW\")\nprint(f\"  Spinning Reserves: {report['totals']['reserve_MW']:,.1f} MW\")\nprint(f\"  Operating Margin: {report['operating_margin_MW']:,.1f} MW\")\n\nprint(f\"\\nMost Heavily Loaded Transmission Lines:\")\nfor i, line in enumerate(report['most_loaded_lines'], 1):\n    print(f\"  {i}. Bus {line['from']} → Bus {line['to']}: {line['loading_pct']:.1f}% loaded\")\n\nprint(f\"\\nGenerator Dispatch Summary:\")\nprint(f\"  Total generators: {len(report['generator_dispatch'])}\")\ngen_online = sum(1 for g in report['generator_dispatch'] if g['output_MW'] > 0)\nprint(f\"  Generators online: {gen_online}\")\nprint(f\"  Generators providing reserves: {sum(1 for g in report['generator_dispatch'] if g['reserve_MW'] > 0)}\")\nprint(f\"\\nTop 5 generators by output:\")\ntop_gens = sorted(report['generator_dispatch'], key=lambda x: x['output_MW'], reverse=True)[:5]\nfor gen in top_gens:\n    print(f\"  Gen {gen['id']} (Bus {gen['bus']}): {gen['output_MW']:.1f} MW output, {gen['reserve_MW']:.1f} MW reserve\")\n\nprint(f\"\\nTop 5 generators by reserve allocation:\")\ntop_res = sorted(report['generator_dispatch'], key=lambda x: x['reserve_MW'], reverse=True)[:5]\nfor gen in top_res:\n    print(f\"  Gen {gen['id']} (Bus {gen['bus']}): {gen['reserve_MW']:.1f} MW reserve, {gen['output_MW']:.1f} MW output\")\n\nprint(f\"\\n✓ Report successfully generated and saved to report.json\")\nEOF\n"]
[231.025109, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
