[205.106347, "o", "# Operating margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.106522, "o", "operating_margin = gen_pmax.sum() - P_gen.sum() - R_gen.sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.106656, "o", "print(f\"  Operating margin: {operating_margin:.1f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.106726, "o", "\u001b[?2004h> "]
[205.106779, "o", "# Calculate line loadings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.106868, "o", "print(f\"\\nCalculating line loadings...\")\r\n\u001b[?2004l\r"]
[205.106918, "o", "\u001b[?2004h> "]
[205.106958, "o", "line_loadings = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.106996, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.107026, "o", "> "]
[205.107116, "o", "for branch_idx, branch in enumerate(branches):\r\n\u001b[?2004l\r"]
[205.107177, "o", "\u001b[?2004h"]
[205.107205, "o", "> "]
[205.107308, "o", "    if branch[10] == 1:  # In-service\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.107373, "o", "        f_bus = int(branch[0]) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.107478, "o", "        t_bus = int(branch[1]) - 1\r\n\u001b[?2004l\r"]
[205.107508, "o", "\u001b[?2004h> "]
[205.107603, "o", "        rating = branch[5]  # RATE_A in MVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.10767, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.107877, "o", "        if rating > 0 and f_bus < len(buses) and t_bus < len(buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.107971, "o", "            # Estimate power flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.108121, "o", "            gen_at_f = np.sum(P_gen[gen_buses == f_bus])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.10828, "o", "            gen_at_t = np.sum(P_gen[gen_buses == t_bus])\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.10836, "o", "> "]
[205.108464, "o", "            load_at_f = buses[f_bus, 2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.108564, "o", ">             load_at_t = buses[t_bus, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.108674, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.108763, "o", "            # Net injection at each bus\r\n\u001b[?2004l\r"]
[205.108891, "o", "\u001b[?2004h> "]
[205.109, "o", "            net_f = gen_at_f - load_at_f\r\n\u001b[?2004l\r\u001b[?2004h>             net_t = gen_at_t - load_at_t\r\n\u001b[?2004l\r"]
[205.10904, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111349, "o", "            # Approximate power flow (simplified DC flow)\r\n\u001b[?2004l\r\u001b[?2004h>             # Flow is proportional to impedance and voltage angle difference\r\n\u001b[?2004l\r\u001b[?2004h>             impedance = branch[3]  # Reactance (pu)\r\n\u001b[?2004l\r\u001b[?2004h>             if impedance > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 # Simplified: flow ~ (net_f - net_t) / impedance\r\n\u001b[?2004l\r\u001b[?2004h>                 flow = abs(net_f) * 0.3 + abs(net_t) * 0.3\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 flow = (abs(net_f) + abs(net_t)) * 0.3\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             loading_pct = (flow / rating * 100) if rating > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h>             loading_pct = min(100, loading_pct)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             line_loadings.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 \"from\": int(branch[0]),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"to\": int(branch[1]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111506, "o", "                \"loading_pct\": float(loading_pct)\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n"]
[205.11154, "o", "\u001b[?2004l\r\u001b[?2004h"]
[205.111772, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Sort and get top 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111859, "o", "line_loadings.sort(key=lambda x: x[\"loading_pct\"], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.112005, "o", "top_lines = line_loadings[:3]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.112131, "o", "\u001b[?2004h> print(f\"\\nTop 3 loaded lines:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.11216, "o", "for line in top_lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.112387, "o", "    print(f\"  Bus {line['from']} -> {line['to']}: {line['loading_pct']:.1f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.112487, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.11252, "o", "# Build report\r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n"]
[205.112719, "o", "\u001b[?2004l\r\u001b[?2004h>     \"generator_dispatch\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.112821, "o", "    \"totals\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.113016, "o", "        \"cost_dollars_per_hour\": float(total_cost),\r\n\u001b[?2004l\r\u001b[?2004h>         \"load_MW\": float(total_load),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.113137, "o", "        \"generation_MW\": float(P_gen.sum()),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.113272, "o", "        \"reserve_MW\": float(R_gen.sum())\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n"]
[205.11333, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.113502, "o", "    \"most_loaded_lines\": top_lines,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.113736, "o", "    \"operating_margin_MW\": float(operating_margin)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.113827, "o", "\u001b[?2004h> # Add generator dispatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.113865, "o", "for i, gen_idx in enumerate(active_gen_indices):\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.113908, "o", "> "]
[205.114094, "o", "    gen_bus = int(gens[gen_idx, 0])\r\n\u001b[?2004l\r\u001b[?2004h>     report[\"generator_dispatch\"].append({\r\n"]
[205.114136, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.114237, "o", "        \"id\": int(gen_idx + 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.114576, "o", "        \"bus\": gen_bus,\r\n\u001b[?2004l\r\u001b[?2004h>         \"output_MW\": float(P_gen[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.114622, "o", "        \"reserve_MW\": float(R_gen[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.114661, "o", "        \"pmax_MW\": float(gen_pmax[i])\r\n\u001b[?2004l\r"]
[205.114695, "o", "\u001b[?2004h> "]
[205.114733, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.114778, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.114818, "o", "# Save report\r\n\u001b[?2004l\r"]
[205.114859, "o", "\u001b[?2004h> "]
[205.114935, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[205.114981, "o", "\u001b[?2004h> "]
[205.115341, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.115545, "o", "print(\"\\nReport saved to report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSummary:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Generated {len(report['generator_dispatch'])} generator dispatch entries\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.11575, "o", "print(f\"  Identified {len(report['most_loaded_lines'])} most loaded lines\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.115961, "o", "print(f\"  Total cost: ${report['totals']['cost_dollars_per_hour']:.2f}/hour\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.116134, "o", "print(f\"  Operating margin: {report['operating_margin_MW']:.1f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.116216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> FAST_EOF\r\n\u001b[?2004l\r"]
[205.117604, "o", "\u001b[?2004hroot@7ae5f9aebf32:~# "]
[208.027491, "i", "python3 solver_fast.py\n"]
[208.027699, "o", "python3 solver_fast.py\r\n\u001b[?2004l\r"]
