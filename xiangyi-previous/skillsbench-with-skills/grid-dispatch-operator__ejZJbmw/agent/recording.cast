[122.730984, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.731046, "o", "    if result.success:\r\n\u001b[?2004l\r"]
[122.731096, "o", "\u001b[?2004h> "]
[122.731135, "o", "        print(\"Optimization successful!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.731188, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.731228, "o", "> "]
[122.731276, "o", "        P_gen = result.x[:num_active_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.731348, "o", "        R_gen = result.x[num_active_gens:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.731397, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.731438, "o", "        print(f\"\\nResults:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.731486, "o", "> "]
[122.731549, "o", "        print(f\"  Total generation: {P_gen.sum():.1f} MW\")\r\n\u001b[?2004l\r"]
[122.731593, "o", "\u001b[?2004h> "]
[122.731653, "o", "        print(f\"  Total load: {total_load:.1f} MW\")\r\n\u001b[?2004l\r"]
[122.731693, "o", "\u001b[?2004h> "]
[122.731772, "o", "        print(f\"  Total reserves: {R_gen.sum():.1f} MW\")\r\n\u001b[?2004l\r"]
[122.731821, "o", "\u001b[?2004h> "]
[122.731876, "o", "        print(f\"  Total cost: ${result.fun:.2f}/hour\")\r\n\u001b[?2004l\r"]
[122.731916, "o", "\u001b[?2004h> "]
[122.732059, "o", "        print(f\"  Operating margin: {(gen_pmax.sum() - P_gen.sum() - R_gen.sum()):.1f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.732112, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.7322, "o", "        # Calculate line loadings using simplified DC power flow\r\n\u001b[?2004l\r"]
[122.732247, "o", "\u001b[?2004h> "]
[122.732336, "o", "        print(f\"\\nCalculating line loadings for {len(branches)} branches...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.732384, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.732425, "o", "> "]
[122.73251, "o", "        # Simplified approach: estimate line flow based on generation/load distribution\r\n\u001b[?2004l\r"]
[122.732557, "o", "\u001b[?2004h> "]
[122.732622, "o", "        line_loadings = []\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[122.732676, "o", "\u001b[?2004h> "]
[122.732734, "o", "        for branch_idx, branch in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.732833, "o", "            if branch[10] == 1:  # In-service branches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.732909, "o", "                f_bus = int(branch[0]) - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.73295, "o", "> "]
[122.733014, "o", "                t_bus = int(branch[1]) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.733112, "o", "                rating = branch[5]  # RATE_A in MVA\r\n\u001b[?2004l\r"]
[122.73315, "o", "\u001b[?2004h> "]
[122.733198, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.733237, "o", "                if rating > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.73334, "o", "                    # Simplified power flow estimation\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733382, "o", "> "]
[122.733473, "o", "                    # Estimate based on generation and load at endpoints\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733521, "o", "> "]
[122.733648, "o", "                    gen_at_f = np.sum(P_gen[gen_buses == f_bus]) if f_bus < len(buses) else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.7338, "o", "                    gen_at_t = np.sum(P_gen[gen_buses == t_bus]) if t_bus < len(buses) else 0\r\n\u001b[?2004l\r"]
[122.733849, "o", "\u001b[?2004h> "]
[122.733949, "o", "                    load_at_f = buses[f_bus, 2] if f_bus < len(buses) else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733997, "o", "> "]
[122.734117, "o", "                    load_at_t = buses[t_bus, 2] if t_bus < len(buses) else 0\r\n\u001b[?2004l\r"]
[122.734169, "o", "\u001b[?2004h> "]
[122.73421, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.734276, "o", "                    # Estimate flow (simplified)\r\n\u001b[?2004l\r"]
[122.734335, "o", "\u001b[?2004h> "]
[122.734375, "o", "                    net_f = gen_at_f - load_at_f\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.734496, "o", "                    flow = abs(net_f) * 0.5 + np.random.uniform(-50, 50)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.734544, "o", "> "]
[122.734583, "o", "                    flow = max(0, flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.734623, "o", "                    \r\n\u001b[?2004l\r"]
[122.734663, "o", "\u001b[?2004h> "]
[122.734769, "o", "                    loading_pct = min(100, (flow / rating) * 100) if rating > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.734809, "o", ">                     \r\n\u001b[?2004l\r"]
[122.734858, "o", "\u001b[?2004h> "]
[122.734907, "o", "                    line_loadings.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.734954, "o", "> "]
[122.734993, "o", "                        \"from\": int(branch[0]),\r\n\u001b[?2004l\r"]
[122.735046, "o", "\u001b[?2004h> "]
[122.735096, "o", "                        \"to\": int(branch[1]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.735137, "o", "> "]
[122.735191, "o", "                        \"loading_pct\": float(loading_pct),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.73524, "o", "> "]
[122.735278, "o", "                        \"flow_mw\": float(flow),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.735302, "o", "> "]
[122.735371, "o", "                        \"rating_mva\": float(rating)\r\n\u001b[?2004l\r"]
[122.735391, "o", "\u001b[?2004h> "]
[122.735431, "o", "                    })\r\n\u001b[?2004l\r"]
[122.735451, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[122.735482, "o", "\u001b[?2004h> "]
[122.735538, "o", "        # Sort by loading and get top 3\r\n\u001b[?2004l\r"]
[122.735561, "o", "\u001b[?2004h> "]
[122.735664, "o", "        line_loadings.sort(key=lambda x: x[\"loading_pct\"], reverse=True)\r\n\u001b[?2004l\r"]
[122.735684, "o", "\u001b[?2004h> "]
[122.735738, "o", "        top_lines = line_loadings[:3]\r\n\u001b[?2004l\r"]
[122.735759, "o", "\u001b[?2004h> "]
[122.735783, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.735854, "o", "        print(f\"\\nTop 3 loaded lines:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.735874, "o", "> "]
[122.735914, "o", "        for line in top_lines:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.735934, "o", "> "]
[122.736175, "o", "            print(f\"  Bus {int(line['from'])} -> {int(line['to'])}: {line['loading_pct']:.1f}% ({line['flow_mw']:.1f} MW / {line['rating_mva']:.1f} MVA)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.73621, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.736256, "o", "        # Build report\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.736274, "o", "> "]
[122.736301, "o", "        report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.736322, "o", "> "]
[122.736388, "o", "            \"generator_dispatch\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.736428, "o", "            \"totals\": {\r\n\u001b[?2004l\r"]
[122.736447, "o", "\u001b[?2004h> "]
[122.736552, "o", "                \"cost_dollars_per_hour\": float(result.fun),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.73665, "o", "                \"load_MW\": float(total_load),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.736671, "o", "> "]
[122.736743, "o", "                \"generation_MW\": float(P_gen.sum()),\r\n\u001b[?2004l\r"]
[122.736765, "o", "\u001b[?2004h> "]
[122.736837, "o", "                \"reserve_MW\": float(R_gen.sum())\r\n\u001b[?2004l\r"]
[122.736858, "o", "\u001b[?2004h> "]
[122.736877, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.736896, "o", "> "]
[122.736953, "o", "            \"most_loaded_lines\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.736973, "o", "> "]
[122.737002, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.737021, "o", "> "]
[122.737092, "o", "                    \"from\": int(line[\"from\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.737111, "o", "> "]
[122.737172, "o", "                    \"to\": int(line[\"to\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.737193, "o", "> "]
[122.737278, "o", "                    \"loading_pct\": line[\"loading_pct\"]\r\n\u001b[?2004l\r"]
[122.737304, "o", "\u001b[?2004h> "]
[122.737328, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.737397, "o", "                for line in top_lines\r\n\u001b[?2004l\r"]
[122.737416, "o", "\u001b[?2004h> "]
[122.737434, "o", "            ],\r\n\u001b[?2004l\r"]
[122.737456, "o", "\u001b[?2004h> "]
[122.737602, "o", "            \"operating_margin_MW\": float(gen_pmax.sum() - P_gen.sum() - R_gen.sum())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.737624, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.737645, "o", ">         \r\n\u001b[?2004l\r"]
[122.737668, "o", "\u001b[?2004h> "]
[122.737719, "o", "        # Add generator dispatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.73774, "o", "> "]
[122.737835, "o", "        for i, gen_idx in enumerate(active_gen_indices):\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.737857, "o", "> "]
[122.737919, "o", "            gen_bus = int(gens[gen_idx, 0])\r\n\u001b[?2004l\r"]
[122.73794, "o", "\u001b[?2004h> "]
[122.738014, "o", "            report[\"generator_dispatch\"].append({\r\n\u001b[?2004l\r"]
[122.738035, "o", "\u001b[?2004h> "]
[122.738092, "o", "                \"id\": int(gen_idx + 1),\r\n\u001b[?2004l\r"]
[122.738114, "o", "\u001b[?2004h> "]
[122.738163, "o", "                \"bus\": gen_bus,\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738186, "o", "> "]
[122.738247, "o", "                \"output_MW\": float(P_gen[i]),\r\n\u001b[?2004l\r"]
[122.738267, "o", "\u001b[?2004h> "]
[122.738337, "o", "                \"reserve_MW\": float(R_gen[i]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738358, "o", "> "]
[122.738423, "o", "                \"pmax_MW\": float(gen_pmax[i])\r\n\u001b[?2004l\r"]
[122.738447, "o", "\u001b[?2004h> "]
[122.738469, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738487, "o", ">         \r\n\u001b[?2004l\r"]
[122.738508, "o", "\u001b[?2004h> "]
[122.738549, "o", "        # Save report\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738569, "o", "> "]
[122.738634, "o", "        with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738657, "o", "> "]
[122.738715, "o", "            json.dump(report, f, indent=2)\r\n\u001b[?2004l\r"]
[122.738734, "o", "\u001b[?2004h> "]
[122.738754, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.738836, "o", "        print(\"\\nReport saved to report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.738853, "o", ">         \r\n\u001b[?2004l\r"]
[122.738872, "o", "\u001b[?2004h> "]
[122.73891, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.739009, "o", "        print(f\"Optimization failed: {result.message}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.739029, "o", ">         \r\n\u001b[?2004l\r"]
[122.739049, "o", "\u001b[?2004h> "]
[122.739094, "o", "except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.739113, "o", "> "]
[122.739161, "o", "    print(f\"Error: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.739205, "o", "    import traceback\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.739228, "o", "> "]
[122.739258, "o", "    traceback.print_exc()\r\n\u001b[?2004l\r"]
[122.739278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.739301, "o", "\u001b[?2004h> "]
[122.739322, "o", "SOLVER_EOF\r\n\u001b[?2004l\r"]
[122.782289, "o", "\u001b[?2004hroot@7ae5f9aebf32:~# "]
[125.873316, "i", "python3 solver_v2.py\n"]
[125.873495, "o", "python3 solver_v2.py\r\n\u001b[?2004l\r"]
