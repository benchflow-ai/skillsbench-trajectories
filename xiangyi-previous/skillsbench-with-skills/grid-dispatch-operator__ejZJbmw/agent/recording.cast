[208.157216, "o", "Active generators: 510\r\n"]
[208.157876, "o", "Generation cost range: 5.77 to 129.26 $/MWh\r\nTotal Pmax capacity: 219088.0 MW\r\nTotal reserve capacity: 19745.0 MW"]
[208.157954, "o", "\r\nTotal load: 144839.1 MW\r\n\r\nPerforming merit-order dispatch...\r\n"]
[208.161827, "o", "\r\nDispatch Results:\r\n  Total generation: 144839.1 MW\r\n  Total load: 144839.1 MW\r\n  Total reserves: 5923.5 MW\r\n"]
[208.161907, "o", "  Reserve requirement: 5923.5 MW\r\n  Total cost: $3005150.70/hour\r\n  Operating margin: 68325.4 MW\r\n\r\nCalculating line loadings...\r\n"]
