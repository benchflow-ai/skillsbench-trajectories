[126.130057, "o", "Active generators: 510\r\n"]
[126.130526, "o", "Generation cost range: 5.77 to 129.26 $/MWh\r\nTotal Pmax capacity: 219088.0 MW\r\nTotal reserve capacity: 19745.0 MW\r\n"]
[126.130557, "o", "Total load: 144839.1 MW\r\n\r\nSetting up optimization...\r\n"]
[126.131958, "o", "Initial generation: 144839.1 MW\r\nInitial reserves: 5923.5 MW\r\n"]
[126.132096, "o", "\r\nSolving optimization problem...\r\n"]
[179.672155, "i", "\u0003"]
[179.69687, "o", "^C"]
[180.804655, "o", "Traceback (most recent call last):\r\n  File \"/root/solver_v2.py\", line 104, in <module>\r\n"]
