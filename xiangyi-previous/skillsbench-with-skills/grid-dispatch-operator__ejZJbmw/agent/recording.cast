[13.094779, "i", "python3 << 'EOF'\nimport json\nwith open('network.json', 'r') as f:\n    data = json.load(f)\nprint(\"Keys in network.json:\", list(data.keys()))\nprint(\"\\nNumber of buses:\", len(data.get('bus', [])))\nprint(\"Number of generators:\", len(data.get('gen', [])))\nprint(\"Number of branches:\", len(data.get('branch', [])))\nprint(\"\\nFirst generator:\", data.get('gen', [[]])[0] if data.get('gen') else 'None')\nprint(\"\\nFirst branch:\", data.get('branch', [[]])[0] if data.get('branch') else 'None')\nEOF\n"]
