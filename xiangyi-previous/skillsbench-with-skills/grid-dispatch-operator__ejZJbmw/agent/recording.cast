[219.512718, "o", "cat report.json\r\n\u001b[?2004l\r{\r\n  \"generator_dispatch\": [\r\n    {\r\n      \"id\": 1,\r\n      \"bus\": 316,\r\n      \"output_MW\": 491.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 491.0\r\n    },\r\n    {\r\n      \"id\": 2,\r\n      \"bus\": 497,\r\n      \"output_MW\": 37.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 37.0\r\n    },\r\n    {\r\n      \"id\": 3,\r\n      \"bus\": 396,\r\n      \"output_MW\": 408.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 408.0\r\n    },\r\n    {\r\n      \"id\": 4,\r\n      \"bus\": 221,\r\n      \"output_MW\": 447.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 447.0\r\n    },\r\n    {\r\n      \"id\": 5,\r\n      \"bus\": 2596,\r\n      \"output_MW\": 400.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 400.0\r\n    },\r\n    {\r\n      \"id\": 6,\r\n      \"bus\": 2854,\r\n      \"output_MW\": 0.0,\r\n      \"reserve_MW\": 0.6218528627766011,\r\n      \"pmax_MW\": 23.0\r\n    },\r\n    {\r\n      \"id\": 7,\r\n      \"bus\": 2669,\r\n      \"output_MW\": 96.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 96.0\r\n    },\r\n    {\r\n      \"id\": 8,\r\n      \"bus\": 1607,\r\n      \"output_MW\": 78.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 78.0\r\n    },\r\n    {\r\n      \"id\": 9,\r\n      \"bus\": 2399,\r\n      \"output_MW\": 0.0,\r\n      \"reserve_MW\": 35.68894690717885,\r\n      \"pmax_MW\": 1320.0\r\n    },\r\n    {\r\n      \"id\": 10,\r\n      \"bus\": 76,\r\n      \"output_MW\": 812.0,\r\n      \"reserve_MW\": 0.0,\r\n      \"pmax_MW\": 812.0\r\n    },\r\n    {\r\n      \"id\": 11,\r\n      \"bus\": 2089,\r\n      \"output_MW\": 0.0,\r\n      \"reserve_MW\": 6.461862356678595,\r\n      \"pmax_MW\": 239.0\r\n    },\r\n    {\r\n      \"id\": 12,\r\n      \"bus\": 2732,\r\n      \"output_MW\": 0.0,\r\n      \"reserve_MW\": 9.787423318483897,\r\n      \"pmax_MW\": 362.0\r\n    },\r\n    {\r\n      \"id\": 13,\r\n      \"bus\": 17