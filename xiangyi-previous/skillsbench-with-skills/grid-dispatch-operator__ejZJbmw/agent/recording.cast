[205.085628, "o", "\u001b[?2004h> "]
[205.085778, "o", "gen_cost = np.zeros(num_active_gens)\r\n\u001b[?2004l\r"]
[205.085838, "o", "\u001b[?2004h> "]
[205.086076, "o", "for i, gen_idx in enumerate(active_gen_indices):\r\n\u001b[?2004l\r"]
[205.086106, "o", "\u001b[?2004h> "]
[205.086252, "o", "    cost_data = gencost[gen_idx]\r\n\u001b[?2004l\r"]
[205.086281, "o", "\u001b[?2004h> "]
[205.086482, "o", "    if cost_data[0] == 2:  # Polynomial model\r\n\u001b[?2004l\r"]
[205.08651, "o", "\u001b[?2004h> "]
[205.086636, "o", "        ncost = int(cost_data[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.086764, "o", "        if ncost >= 2:\r\n\u001b[?2004l\r"]
[205.086821, "o", "\u001b[?2004h> "]
[205.087164, "o", "            # For polynomial: cost[4] is c_n, cost[5] is c_(n-1), etc.\r\n\u001b[?2004l\r"]
[205.087221, "o", "\u001b[?2004h> "]
[205.087421, "o", "            # For quadratic ax^2+bx+c: coefficients are [a, b, c]\r\n\u001b[?2004l\r"]
[205.087488, "o", "\u001b[?2004h> "]
[205.087701, "o", "            # We use the linear coefficient (marginal cost)\r\n\u001b[?2004l\r"]
[205.08776, "o", "\u001b[?2004h> "]
[205.088053, "o", "            gen_cost[i] = cost_data[4 + ncost - 2] if ncost >= 2 else 10.0\r\n\u001b[?2004l\r"]
[205.088113, "o", "\u001b[?2004h> "]
[205.088185, "o", "        else:\r\n\u001b[?2004l\r"]
[205.088246, "o", "\u001b[?2004h> "]
[205.088351, "o", "            gen_cost[i] = 10.0\r\n\u001b[?2004l\r"]
[205.088411, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[205.088467, "o", "\u001b[?2004h> "]
[205.088607, "o", "        gen_cost[i] = 10.0\r\n\u001b[?2004l\r"]
[205.088668, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[205.088923, "o", "gen_cost = np.maximum(gen_cost, 1.0)  # Ensure minimum\r\n\u001b[?2004l\r"]
