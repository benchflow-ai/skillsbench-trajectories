[205.083784, "o", "\u001b[?2004h"]
[205.083852, "o", "> "]
[205.083952, "o", "num_active_gens = len(active_gen_indices)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.08417, "o", "print(f\"Active generators: {num_active_gens}\")\r\n\u001b[?2004l\r"]
[205.084227, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
