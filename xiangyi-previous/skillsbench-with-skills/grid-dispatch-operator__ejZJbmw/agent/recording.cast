[17.645117, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[17.674992, "o", "Column Info:\r\nbus: {'0': 'BUS_I - bus number (1-indexed)', '1': 'BUS_TYPE - 1=PQ, 2=PV, 3=Slack', '2': 'PD - real power demand (MW)', '3': 'QD - reactive power demand (MVAr)', '4': 'GS - shunt conductance', '5': 'BS - shunt susceptance', '6': 'BUS_AREA - area number', '7': 'VM - voltage magnitude (pu)', '8': 'VA - voltage angle (degrees)', '9': 'BASE_KV - base voltage (kV)', '10': 'ZONE - loss zone', '11': 'VMAX - max voltage (pu)', '12': 'VMIN - min voltage (pu)'}\r\ngen: {'0': 'GEN_BUS - bus number (1-indexed)', '1': 'PG - real power output (MW)', '2': 'QG - reactive power output (MVAr)', '3': 'QMAX - max reactive power (MVAr)', '4': 'QMIN - min reactive power (MVAr)', '5': 'VG - voltage setpoint (pu)', '6': 'MBASE - machine base (MVA)', '7': 'GEN_STATUS - 1=in-service, 0=out-of-service', '8': 'PMAX - max real power output (MW)', '9': 'PMIN - min real power output (MW)'}\r\nbranch: {'0': 'F_BUS - from bus (1-indexed)', '1': 'T_BUS - to bus (1-indexed)', '2': 'BR_R - resistance (pu)', '3': 'BR_X - reactance (pu)', '4': 'BR_B - total line charging susceptance (pu)', '5': 'RATE_A - MVA rating A (long term)', '6': 'RATE_B - MVA rating B (short term)', '7': 'RATE_C - MVA rating C (emergency)', '8': 'TAP - transformer tap ratio', '9': 'SHIFT - transformer phase shift (degrees)', '10': 'BR_STATUS - 1=in-service, 0=out-of-service', '11': 'ANGMIN - min angle difference (degrees)', '12': 'ANGMAX - max angle difference (degrees)'}\r\ngencost: {'0': 'MODEL - 1=piecewise linear, 2=polynomial', '1': 'STARTUP - startup cost ($)', '2': 'SHUTDOWN - shutdown cost ($)', '3': 'NCOST - number of cost coefficients', '4+': 'COST - cost coefficients (highest order first)'}\r\nreserve: {'reserve_capacity': 'Maximum reserve each generator can provide (MW)', 'reserve_requirement': 'Minimum total system reserve requirement R (MW)'}\r\n"]
[17.680187, "o", "\u001b[?2004hroot@7ae5f9aebf32:~# "]
[26.835535, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbuses = np.array(data['bus'])\ngens = np.array(data['gen'])\nbranches = np.array(data['branch'])\ngencost = np.array(data['gencost'])\nreserve_capacity = np.array(data['reserve_capacity'])\nreserve_requirement = data['reserve_requirement']\n\nprint(f\"Base MVA: {baseMVA}\")\nprint(f\"Reserve Requirement: {reserve_requirement} MW\")\nprint(f\"Reserve Capacity array shape: {reserve_capacity.shape}\")\nprint(f\"Generator array shape: {gens.shape}\")\nprint(f\"Gencost array shape: {gencost.shape}\")\n\n# Extract key data\nnum_gens = len(gens)\nnum_buses = len(buses)\nnum_branches = len(branches)\n\n# Filter active generators\nactive_gens = gens[:, 7] == 1  # GEN_STATUS column\nactive_gen_indices = np.where(active_gens)[0]\nnum_active_gens = len(active_gen_indices)\n\nprint(f\"\\nActive generators: {num_active_gens} out of {num_gens}\")\nprint(f\"Total buses: {num_buses}\")\nprint(f\"Total branches: {num_branches}\")\n\n# Extract generator parameters for active generators\ngen_buses = gens[active_gen_indices, 0].astype(int) - 1  # Convert to 0-indexed\ngen_pmin = gens[active_gen_indices, 9]  # PMIN\ngen_pmax = gens[active_gen_indices, 8]  # PMAX\ngen_reserve_cap = reserve_capacity[active_gen_indices]\n\nprint(f\"\\nGenerator Pmax range: {gen_pmax.min():.1f} to {gen_pmax.max():.1f} MW\")\nprint(f\"Total installed capacity: {gen_pmax.sum():.1f} MW\")\nprint(f\"Reserve capacity available: {gen_reserve_cap.sum():.1f} MW\")\n\nEOF\n"]
