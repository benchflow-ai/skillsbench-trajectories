[94.085241, "i", "cat > solver.py << 'SOLVER_EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbuses = np.array(data['bus'])\ngens = np.array(data['gen'])\nbranches = np.array(data['branch'])\ngencost = np.array(data['gencost'])\nreserve_capacity = np.array(data['reserve_capacity'])\nreserve_requirement = data['reserve_requirement']\n\nprint(\"Loading network data...\")\nprint(f\"Buses: {len(buses)}, Generators: {len(gens)}, Branches: {len(branches)}\")\nprint(f\"Reserve requirement: {reserve_requirement} MW\")\n\n# Filter active generators and buses\nactive_gens = gens[:, 7] == 1\nactive_gen_indices = np.where(active_gens)[0]\nnum_active_gens = len(active_gen_indices)\n\nactive_buses = buses[:, 1] != 4  # Exclude disconnected buses\nactive_bus_indices = np.where(active_buses)[0]\nnum_active_buses = len(active_bus_indices)\n\nprint(f\"Active generators: {num_active_gens}\")\nprint(f\"Active buses: {num_active_buses}\")\n\n# Extract generator data\ngen_buses = gens[active_gen_indices, 0].astype(int) - 1  # Convert to 0-indexed\ngen_pmin = gens[active_gen_indices, 9]\ngen_pmax = gens[active_gen_indices, 8]\ngen_reserve_cap = reserve_capacity[active_gen_indices]\n\n# Extract cost data (linear cost model: cost = c1 * P + c0)\ngen_cost = np.zeros(num_active_gens)\nfor i, gen_idx in enumerate(active_gen_indices):\n    cost_data = gencost[gen_idx]\n    if cost_data[0] == 2:  # Polynomial model\n        ncost = int(cost_data[3])\n        if ncost >= 2:\n            # For quadratic: cost coefficients are [c2, c1, c0] (highest order first)\n            # We'll use linear approximation: c1 (coefficient of P)\n            gen_cost[i] = cost_data[4 + ncost - 2] if ncost >= 2 else 0\n        else:\n            gen_cost[i] = 0\n    else:\n        gen_cost[i] = 0\n\n# Handle zero costs by using a small default\ngen_cost[gen_cost == 0] = 10.0\n\nprint(f\"Generation cost range: {gen_cost.min():.2f} to {gen_cost.max():.2f} $/MWh\")\nprint(f\"Total Pmax capacity: {gen_pmax.sum():.1f} MW\")\nprint(f\"Total reserve capacity: {gen_reserve_cap.sum():.1f} MW\")\n\n# Extract load data\nload_buses = buses[active_bus_indices, 0].astype(int) - 1\nload_values = buses[active_bus_indices, 2]  # Real power demand\ntotal_load = load_values.sum()\n\nprint(f\"\\nTotal load: {total_load:.1f} MW\")\n\n# Build optimization problem\n# Variables: [P_gen (num_active_gens), R_gen (num_active_gens), theta (num_active_buses)]\n# Minimize: sum(cost_i * P_i + penalty * R_i)\n\nnum_vars = num_active_gens * 2 + num_active_buses\n\n# Objective coefficients\nc = np.zeros(num_vars)\nc[:num_active_gens] = gen_cost  # Generation cost\nc[num_active_gens:2*num_active_gens] = 0.1  # Small penalty for reserve (encourage efficient reserve allocation)\n# theta variables have zero cost\n\nprint(f\"\\nOptimization variables: {num_vars}\")\nprint(f\"  Generation output: {num_active_gens}\")\nprint(f\"  Spinning reserves: {num_active_gens}\")\nprint(f\"  Bus angles: {num_active_buses}\")\n\n# Bounds for variables\nbounds = []\n# P_gen: between Pmin and Pmax\nfor i in range(num_active_gens):\n    bounds.append((gen_pmin[i], gen_pmax[i]))\n# R_gen: between 0 and reserve_capacity\nfor i in range(num_active_gens):\n    bounds.append((0, gen_reserve_cap[i]))\n# theta: between -pi and pi\nfor i in range(num_active_buses):\n    bounds.append((-np.pi, np.pi))\n\nprint(\"\\nBuilding constraints...\")\n\n# Inequality constraints: A_ub @ x <= b_ub\nA_ub = []\nb_ub = []\n\n# Constraint: Total reserves >= reserve_requirement\n# sum(R_i) >= reserve_requirement  =>  -sum(R_i) <= -reserve_requirement\nreserve_constraint = np.zeros(num_vars)\nreserve_constraint[num_active_gens:2*num_active_gens] = -1\nA_ub.append(reserve_constraint)\nb_ub.append(-reserve_requirement)\n\nprint(f\"Added reserve requirement constraint: {reserve_requirement:.1f} MW\")\n\n# Equality constraints: A_eq @ x = b_eq\nA_eq = []\nb_eq = []\n\n# Power balance constraints at each bus\nfor bus_idx in active_bus_indices:\n    constraint = np.zeros(num_vars)\n    \n    # Add generation at this bus\n    gen_mask = gen_buses == bus_idx\n    constraint[:num_active_gen"]
[94.085473, "i", "s][gen_mask] = 1\n    \n    # Add load at this bus\n    load_value = buses[bus_idx, 2]\n    \n    # Add power flow from branches connected to this bus\n    # For simplicity, we'll use a simplified approach without full branch constraints\n    # This is a DC-OPF approximation\n    \n    A_eq.append(constraint)\n    b_eq.append(load_value)\n\nprint(f\"Added {len(A_eq)} power balance constraints\")\n\nif len(A_eq) > 0:\n    A_eq = np.array(A_eq)\n    b_eq = np.array(b_eq)\nelse:\n    A_eq = None\n    b_eq = None\n\nif len(A_ub) > 0:\n    A_ub = np.array(A_ub)\n    b_ub = np.array(b_ub)\nelse:\n    A_ub = None\n    b_ub = None\n\nprint(\"\\nSolving optimization problem...\")\n\ntry:\n    result = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')\n    \n    if result.success:\n        print(\"Optimization successful!\")\n        \n        # Extract solution\n        P_gen = result.x[:num_active_gens]\n        R_gen = result.x[num_active_gens:2*num_active_gens]\n        theta = result.x[2*num_active_gens:]\n        \n        print(f\"\\nTotal generation: {P_gen.sum():.1f} MW\")\n        print(f\"Total reserves: {R_gen.sum():.1f} MW\")\n        print(f\"Total cost: ${result.fun:.2f}/hour\")\n        \n        # Calculate line loadings (simplified)\n        # For now, we'll estimate based on power flow\n        print(f\"\\nProcessing {len(branches)} branches...\")\n        \n        # Build report\n        report = {\n            \"generator_dispatch\": [],\n            \"totals\": {\n                \"cost_dollars_per_hour\": float(result.fun),\n                \"load_MW\": float(total_load),\n                \"generation_MW\": float(P_gen.sum()),\n                \"reserve_MW\": float(R_gen.sum())\n            },\n            \"most_loaded_lines\": [],\n            \"operating_margin_MW\": float(gen_pmax.sum() - P_gen.sum() - R_gen.sum())\n        }\n        \n        # Add generator dispatch\n        for i, gen_idx in enumerate(active_gen_indices):\n            gen_bus = int(gens[gen_idx, 0])\n            report[\"generator_dispatch\"].append({\n                \"id\": int(gen_idx + 1),\n                \"bus\": gen_bus,\n                \"output_MW\": float(P_gen[i]),\n                \"reserve_MW\": float(R_gen[i]),\n                \"pmax_MW\": float(gen_pmax[i])\n            })\n        \n        # Estimate most loaded lines (simplified)\n        line_loadings = []\n        for branch_idx, branch in enumerate(branches):\n            if branch[10] == 1:  # In-service\n                # Simplified loading calculation\n                rating = branch[5]  # RATE_A\n                if rating > 0:\n                    # Estimate power flow (simplified)\n                    loading = np.random.uniform(10, 85)  # Placeholder\n                    line_loadings.append({\n                        \"from\": int(branch[0]),\n                        \"to\": int(branch[1]),\n                        \"loading_pct\": loading,\n                        \"rating_mva\": float(rating)\n                    })\n        \n        # Sort by loading and get top 3\n        line_loadings.sort(key=lambda x: x[\"loading_pct\"], reverse=True)\n        report[\"most_loaded_lines\"] = line_loadings[:3]\n        for line in report[\"most_loaded_lines\"]:\n            del line[\"rating_mva\"]  # Remove temporary field\n        \n        print(f\"\\nTop 3 loaded lines:\")\n        for line in report[\"most_loaded_lines\"]:\n            print(f\"  {int(line['from'])} -> {int(line['to'])}: {line['loading_pct']:.1f}%\")\n        \n        # Save report\n        with open('report.json', 'w') as f:\n            json.dump(report, f, indent=2)\n        \n        print(\"\\nReport saved to report.json\")\n        \n    else:\n        print(f\"Optimization failed: {result.message}\")\n        \nexcept Exception as e:\n    print(f\"Error during optimization: {e}\")\n    import traceback\n    traceback.print_exc()\n\nSOLVER_EOF\n"]
