[205.085037, "o", "\u001b[?2004h> "]
[205.085309, "o", "gen_reserve_cap = reserve_capacity[active_gen_indices]\r\n\u001b[?2004l\r"]
[205.085374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.085433, "o", "\u001b[?2004h> "]
