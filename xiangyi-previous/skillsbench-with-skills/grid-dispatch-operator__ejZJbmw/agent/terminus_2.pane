[?2004l[?2004h> 
[?2004l[?2004h> baseMVA = data['baseMVA']
[?2004l[?2004h> buses = np.array(data['bus'])
[?2004l[?2004h> gens = np.array(data['gen'])
[?2004l[?2004h> branches = np.array(data['branch'])
[?2004l[?2004h> gencost = np.array(data['gencost'])
[?2004l[?2004h> reserve_capacity = np.array(data['reserve_capacity'])
[?2004l[?2004h> reserve_requirement = data['reserve_requirement']
[?2004l[?2004h> 
