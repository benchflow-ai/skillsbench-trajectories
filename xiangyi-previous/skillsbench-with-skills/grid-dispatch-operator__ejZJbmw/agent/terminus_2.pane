[?2004hroot@7ae5f9aebf32:~# python3 << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> with open('report.json', 'r') as f:
[?2004l[?2004h>     report = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== GRID DISPATCH OPTIMIZATION REPORT ===")
[?2004l[?2004h> print(f"\nTotals:")
[?2004l[?2004h> print(f"  Cost: ${report['totals']['cost_dollars_per_hour']:,.2f}/hour")
[?2004l[?2004h> print(f"  Load: {report['totals']['load_MW']:,.1f} MW")
[?2004l[?2004h> print(f"  Generation: {report['totals']['generation_MW']:,.1f} MW")
[?2004l[?2004h> print(f"  Spinning Reserves: {report['totals']['reserve_MW']:,.1f} MW")
[?2004l[?2004h> print(f"  Operating Margin: {report['operating_margin_MW']:,.1f} MW")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nMost Heavily Loaded Transmission Lines:")
[?2004l[?2004h> for i, line in enumerate(report['most_loaded_lines'], 1):
[?2004l[?2004h>     print(f"  {i}. Bus {line['from']} → Bus {line['to']}: {line['loading_pct']:.1f}% loaded")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nGenerator Dispatch Summary:")
[?2004l[?2004h> print(f"  Total generators: {len(report['generator_dispatch'])}")
[?2004l[?2004h> gen_online = sum(1 for g in report['generator_dispatch'] if g['output_MW'] > 0)
[?2004l[?2004h> print(f"  Generators online: {gen_online}")
[?2004l[?2004h> print(f"  Generators providing reserves: {sum(1 for g in report['generator_dispatch'] if g['reserve_MW'] > 0)}")
[?2004l[?2004h> print(f"\nTop 5 generators by output:")
[?2004l[?2004h> top_gens = sorted(report['generator_dispatch'], key=lambda x: x['output_MW'], reverse=True)[:5]
[?2004l[?2004h> for gen in top_gens:
[?2004l[?2004h>     print(f"  Gen {gen['id']} (Bus {gen['bus']}): {gen['output_MW']:.1f} MW output, {gen['reserve_MW']:.1f} MW reserve")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTop 5 generators by reserve allocation:")
[?2004l[?2004h> top_res = sorted(report['generator_dispatch'], key=lambda x: x['reserve_MW'], reverse=True)[:5]
[?2004l[?2004h> for gen in top_res:
[?2004l[?2004h>     print(f"  Gen {gen['id']} (Bus {gen['bus']}): {gen['reserve_MW']:.1f} MW reserve, {gen['output_MW']:.1f} MW output")
