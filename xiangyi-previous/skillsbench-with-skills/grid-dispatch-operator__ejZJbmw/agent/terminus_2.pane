[?2004l[?2004h> print(f"Generator array shape: {gens.shape}")
[?2004l[?2004h> print(f"Gencost array shape: {gencost.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Extract key data
[?2004l[?2004h> num_gens = len(gens)
[?2004l[?2004h> num_buses = len(buses)
[?2004l[?2004h> num_branches = len(branches)
[?2004l[?2004h> 
[?2004l[?2004h> # Filter active generators
[?2004l[?2004h> active_gens = gens[:, 7] == 1  # GEN_STATUS column
[?2004l[?2004h> active_gen_indices = np.where(active_gens)[0]
[?2004l[?2004h> num_active_gens = len(active_gen_indices)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nActive generators: {num_active_gens} out of {num_gens}")
[?2004l[?2004h> print(f"Total buses: {num_buses}")
[?2004l[?2004h> print(f"Total branches: {num_branches}")
[?2004l[?2004h> 
[?2004l[?2004h> # Extract generator parameters for active generators
[?2004l[?2004h> gen_buses = gens[active_gen_indices, 0].astype(int) - 1  # Convert to 0-indexed
[?2004l[?2004h> gen_pmin = gens[active_gen_indices, 9]  # PMIN
[?2004l[?2004h> gen_pmax = gens[active_gen_indices, 8]  # PMAX
[?2004l[?2004h> gen_reserve_cap = reserve_capacity[active_gen_indices]
[?2004l[?2004h> 
