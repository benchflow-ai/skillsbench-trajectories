[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> baseMVA = data['baseMVA']
[?2004l[?2004h> buses = np.array(data['bus'])
[?2004l[?2004h> gens = np.array(data['gen'])
[?2004l[?2004h> branches = np.array(data['branch'])
[?2004l[?2004h> gencost = np.array(data['gencost'])
[?2004l[?2004h> reserve_capacity = np.array(data['reserve_capacity'])
[?2004l[?2004h> reserve_requirement = data['reserve_requirement']
[?2004l[?2004h> 
[?2004lt[?2004h> print(f"Buses: {len(buses)}, Generators: {len(gens)}, Branches: {len(branches)}")
[?2004l[?2004h> print(f"Reserve requirement: {reserve_requirement} MW")
[?2004l[?2004h> 
[?2004l[?2004h> # Filter active generators
[?2004l[?2004h> active_gens = gens[:, 7] == 1
[?2004l[?2004h> active_gen_indices = np.where(active_gens)[0]
[?2004l[?2004h> num_active_gens = len(active_gen_indices)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Active generators: {num_active_gens}")
[?2004l[?2004h> 
[?2004lo[?2004h> # Extract generator data
[?2004l[?2004h> gen_buses = gens[active_gen_indices, 0].astype(int) - 1
[?2004l[?2004h> gen_pmin = gens[active_gen_indices, 9]
[?2004l[?2004h> gen_pmax = gens[active_gen_indices, 8]
[?2004l[?2004h> gen_reserve_cap = reserve_capacity[active_gen_indices]
[?2004l[?2004h> 
[?2004l[?2004h> # Extract cost data - use linear cost coefficient
[?2004l[?2004h> gen_cost = np.zeros(num_active_gens)
[?2004l[?2004h> for i, gen_idx in enumerate(active_gen_indices):
[?2004l[?2004h>     cost_data = gencost[gen_idx]
[?2004l[?2004h>     if cost_data[0] == 2:  # Polynomial model
[?2004l[?2004h>         ncost = int(cost_data[3])
[?2004l[?2004h>         if ncost >= 2:
[?2004l[?2004h>             # For polynomial: cost[4] is c_n, cost[5] is c_(n-1), etc.
[?2004l[?2004h>             # For quadratic ax^2+bx+c: coefficients are [a, b, c]
[?2004l[?2004h>             # We use the linear coefficient (marginal cost)
[?2004l[?2004h>             gen_cost[i] = cost_data[4 + ncost - 2] if ncost >= 2 else 10.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             gen_cost[i] = 10.0
[?2004l[?2004h>     else:
[?2004l[?2004h>         gen_cost[i] = 10.0
[?2004l[?2004h> 
[?2004l=[?2004h> gen_cost = np.maximum(gen_cost, 1.0)  # Ensure minimum
[?2004l[?2004h> 
[?2004li[?2004h> print(f"Generation cost range: {gen_cost.min():.2f} to {gen_cost.max():.2f} $/MWh")
[?2004l[?2004h> print(f"Total Pmax capacity: {gen_pmax.sum():.1f} MW")
[?2004l[?2004h> print(f"Total reserve capacity: {gen_reserve_cap.sum():.1f} MW")
[?2004l[?2004h> 
[?2004l[?2004h> # Extract load data
[?2004l[?2004h> load_values = buses[:, 2]
[?2004l[?2004h> total_load = load_values.sum()
[?2004l[?2004h> print(f"Total load: {total_load:.1f} MW")
[?2004l[?2004h> 
[?2004le[?2004h> # Merit-order dispatch
[?2004l[?2004h> print("\nPerforming merit-order dispatch...")
[?2004l[?2004h> 
[?2004l[?2004h> # Create dispatch order sorted by cost (ascending - cheapest first)
[?2004l[?2004h> merit_order = np.argsort(gen_cost)
[?2004l[?2004h> 
[?2004l [?2004h> P_gen = np.zeros(num_active_gens)
[?2004l[?2004h> R_gen = np.zeros(num_active_gens)
[?2004l[?2004h> 
[?2004ls[?2004h> remaining_load = total_load
[?2004l[?2004h> remaining_reserve = reserve_requirement
[?2004l[?2004h> 
[?2004l[?2004h> # Dispatch generators in merit order
[?2004l[?2004h> for idx in merit_order:
[?2004l[?2004h>     if remaining_load <= 0:
[?2004l[?2004h>         break
[?2004l[?2004h>     
[?2004l[?2004h>     # Dispatch this generator up to its max (respecting Pmin)
[?2004l[?2004h>     gen_dispatch = min(gen_pmax[idx], remaining_load)
[?2004l[?2004h>     gen_dispatch = max(gen_dispatch, gen_pmin[idx])  # Respect Pmin
[?2004l[?2004h>     
[?2004l[?2004h>     P_gen[idx] = gen_dispatch
[?2004l[?2004h>     remaining_load -= gen_dispatch
[?2004l[?2004h> 
[?2004l[?2004h> # Allocate reserves proportionally to capacity
[?2004l[?2004h> for idx in range(num_active_gens):
[?2004l[?2004h>     # Allocate reserve up to available capacity
[?2004l[?2004h>     available_reserve = gen_pmax[idx] - P_gen[idx]
[?2004l[?2004h>     allocated_reserve = min(gen_reserve_cap[idx], available_reserve)
[?2004l[?2004h>     
[?2004l[?2004h>     # Proportional allocation based on generator size
[?2004l[?2004h>     if gen_pmax.sum() > 0:
[?2004l[?2004h>         proportion = gen_pmax[idx] / gen_pmax.sum()
[?2004l[?2004h>         target_reserve = reserve_requirement * proportion
[?2004l[?2004h>         R_gen[idx] = min(allocated_reserve, target_reserve)
[?2004l[?2004h>     else:
[?2004l[?2004h>         R_gen[idx] = 0
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure total reserves meet requirement
[?2004l[?2004h> total_allocated_reserve = R_gen.sum()
[?2004l[?2004h> if total_allocated_reserve < reserve_requirement:
[?2004l[?2004h>     # Need more reserves - allocate from largest generators first
[?2004l[?2004h>     deficit = reserve_requirement - total_allocated_reserve
[?2004l[?2004h>     for idx in np.argsort(-gen_pmax):  # Largest first
[?2004l[?2004h>         if deficit <= 0:
[?2004l[?2004h>             break
[?2004l[?2004h>         available = gen_reserve_cap[idx] - R_gen[idx]
[?2004l[?2004h>         add = min(available, deficit)
[?2004l[?2004h>         R_gen[idx] += add
[?2004l[?2004h>         deficit -= add
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nDispatch Results:")
[?2004l[?2004h> print(f"  Total generation: {P_gen.sum():.1f} MW")
[?2004l[?2004h> print(f"  Total load: {total_load:.1f} MW")
[?2004l[?2004h> print(f"  Total reserves: {R_gen.sum():.1f} MW")
[?2004l[?2004h> print(f"  Reserve requirement: {reserve_requirement:.1f} MW")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate total cost
[?2004l[?2004h> total_cost = np.sum(gen_cost * P_gen)
[?2004l[?2004h> print(f"  Total cost: ${total_cost:.2f}/hour")
[?2004l[?2004h> 
[?2004l[?2004h> # Operating margin
[?2004l[?2004h> operating_margin = gen_pmax.sum() - P_gen.sum() - R_gen.sum()
[?2004l[?2004h> print(f"  Operating margin: {operating_margin:.1f} MW")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate line loadings
[?2004l[?2004h> print(f"\nCalculating line loadings...")
[?2004l[?2004h> line_loadings = []
[?2004l[?2004h> 
[?2004l[?2004h> for branch_idx, branch in enumerate(branches):
[?2004l[?2004h>     if branch[10] == 1:  # In-service
[?2004l[?2004h>         f_bus = int(branch[0]) - 1
[?2004l[?2004h>         t_bus = int(branch[1]) - 1
[?2004l[?2004h>         rating = branch[5]  # RATE_A in MVA
[?2004l[?2004h>         
[?2004l[?2004h>         if rating > 0 and f_bus < len(buses) and t_bus < len(buses):
[?2004l[?2004h>             # Estimate power flow
[?2004l[?2004h>             gen_at_f = np.sum(P_gen[gen_buses == f_bus])
[?2004l[?2004h>             gen_at_t = np.sum(P_gen[gen_buses == t_bus])
[?2004l[?2004h>             load_at_f = buses[f_bus, 2]
[?2004l[?2004h>             load_at_t = buses[t_bus, 2]
[?2004l[?2004h>             
[?2004l[?2004h>             # Net injection at each bus
[?2004l[?2004h>             net_f = gen_at_f - load_at_f
[?2004l[?2004h>             net_t = gen_at_t - load_at_t
[?2004l[?2004h>             
[?2004l[?2004h>             # Approximate power flow (simplified DC flow)
[?2004l[?2004h>             # Flow is proportional to impedance and voltage angle difference
[?2004l[?2004h>             impedance = branch[3]  # Reactance (pu)
[?2004l[?2004h>             if impedance > 0:
[?2004l[?2004h>                 # Simplified: flow ~ (net_f - net_t) / impedance
[?2004l[?2004h>                 flow = abs(net_f) * 0.3 + abs(net_t) * 0.3
[?2004l[?2004h>             else:
[?2004l[?2004h>                 flow = (abs(net_f) + abs(net_t)) * 0.3
[?2004l[?2004h>             
[?2004l[?2004h>             loading_pct = (flow / rating * 100) if rating > 0 else 0
[?2004l[?2004h>             loading_pct = min(100, loading_pct)
[?2004l[?2004h>             
[?2004l[?2004h>             line_loadings.append({
[?2004l[?2004h>                 "from": int(branch[0]),
[?2004l[?2004h>                 "to": int(branch[1]),
[?2004l[?2004h>                 "loading_pct": float(loading_pct)
[?2004l[?2004h>             })
[?2004l[?2004h> 
[?2004l[?2004h> # Sort and get top 3
[?2004l[?2004h> line_loadings.sort(key=lambda x: x["loading_pct"], reverse=True)
[?2004l[?2004h> top_lines = line_loadings[:3]
[?2004l[?2004h> 
