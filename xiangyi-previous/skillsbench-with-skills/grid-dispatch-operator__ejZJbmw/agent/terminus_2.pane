[?2004l [?2004h> # Load network data
[?2004lan[?2004h> with open('network.json', 'r') as f:
[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004ls[?2004h> baseMVA = data['baseMVA']
[?2004l[?2004h> buses = np.array(data['bus'])
[?2004l[?2004h> gens = np.array(data['gen'])
[?2004l[?2004h> branches = np.array(data['branch'])
[?2004l[?2004h> gencost = np.array(data['gencost'])
[?2004l[?2004h> reserve_capacity = np.array(data['reserve_capacity'])
[?2004l[?2004h> reserve_requirement = data['reserve_requirement']
[?2004l[?2004h> 
[?2004lp[?2004h> print("Loading network data...")
[?2004l[?2004h> print(f"Buses: {len(buses)}, Generators: {len(gens)}, Branches: {len(branches)}")
[?2004l[?2004h> print(f"Reserve requirement: {reserve_requirement} MW")
[?2004l[?2004h> 
[?2004lo[?2004h> # Filter active generators and buses
[?2004l[?2004h> active_gens = gens[:, 7] == 1
[?2004l[?2004h> active_gen_indices = np.where(active_gens)[0]
[?2004l[?2004h> num_active_gens = len(active_gen_indices)
[?2004l[?2004h> 
[?2004l.[?2004h> active_buses = buses[:, 1] != 4  # Exclude disconnected buses
[?2004l[?2004h> active_bus_indices = np.where(active_buses)[0]
[?2004l[?2004h> num_active_buses = len(active_bus_indices)
[?2004l[?2004h> 
[?2004l.[?2004h> print(f"Active generators: {num_active_gens}")
[?2004l[?2004h> print(f"Active buses: {num_active_buses}")
[?2004l[?2004h> 
[?2004l
[?2004h> # Extract generator data
[?2004l[?2004h> gen_buses = gens[active_gen_indices, 0].astype(int) - 1  # Convert to 0-indexed
[?2004l[?2004h> gen_pmin = gens[active_gen_indices, 9]
[?2004l[?2004h> gen_pmax = gens[active_gen_indices, 8]
[?2004l[?2004h> gen_reserve_cap = reserve_capacity[active_gen_indices]
[?2004l[?2004h> 
[?2004lo[?2004h> # Extract cost data (linear cost model: cost = c1 * P + c0)
[?2004l[?2004h> gen_cost = np.zeros(num_active_gens)
[?2004l[?2004h> for i, gen_idx in enumerate(active_gen_indices):
[?2004l[?2004h>     cost_data = gencost[gen_idx]
[?2004l[?2004h>     if cost_data[0] == 2:  # Polynomial model
[?2004l[?2004h>         ncost = int(cost_data[3])
[?2004l[?2004h>         if ncost >= 2:
[?2004l[?2004h>             # For quadratic: cost coefficients are [c2, c1, c0] (highest order first)
[?2004l[?2004h>             # We'll use linear approximation: c1 (coefficient of P)
[?2004l[?2004h>             gen_cost[i] = cost_data[4 + ncost - 2] if ncost >= 2 else 0
[?2004l[?2004h>         else:
[?2004l[?2004h>             gen_cost[i] = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         gen_cost[i] = 0
[?2004l[?2004h> 
[?2004lA[?2004h> # Handle zero costs by using a small default
[?2004l[?2004h> gen_cost[gen_cost == 0] = 10.0
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Generation cost range: {gen_cost.min():.2f} to {gen_cost.max():.2f} $/MWh")
[?2004l[?2004h> print(f"Total Pmax capacity: {gen_pmax.sum():.1f} MW")
[?2004l[?2004h> print(f"Total reserve capacity: {gen_reserve_cap.sum():.1f} MW")
[?2004l[?2004h> 
[?2004l_[?2004h> # Extract load data
[?2004l[?2004h> load_buses = buses[active_bus_indices, 0].astype(int) - 1
[?2004l
                "pmax_[?2004h> load_values = buses[active_bus_indices, 2]  # Real power demand
[?2004l[?2004h> total_load = load_values.sum()
[?2004l[?2004h> 
[?2004ld[?2004h> print(f"\nTotal load: {total_load:.1f} MW")
[?2004l[?2004h> 
[?2004ln[?2004h> # Build optimization problem
[?2004l[?2004h> # Variables: [P_gen (num_active_gens), R_gen (num_active_gens), theta (num_active_buses)]
[?2004l[?2004h> # Minimize: sum(cost_i * P_i + penalty * R_i)
[?2004l[?2004h> 
[?2004l[[?2004h> num_vars = num_active_gens * 2 + num_active_buses
[?2004l[?2004h> 
[?2004l [?2004h> # Objective coefficients
