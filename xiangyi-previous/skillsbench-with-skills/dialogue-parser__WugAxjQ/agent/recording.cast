[93.645617, "o", "from typing import Dict, List\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.645639, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.645663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.645715, "o", "def parse_script(text: str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.64578, "o", "    lines = text.splitlines()\r\n\u001b[?2004l\r"]
[93.645815, "o", "\u001b[?2004h> "]
[93.645838, "o", "    nodes: List[Dict] = []\r\n\u001b[?2004l\r"]
[93.64587, "o", "\u001b[?2004h> "]
[93.645903, "o", "    edges: List[Dict] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.645926, "o", "> \r\n\u001b[?2004l\r"]
[93.645953, "o", "\u001b[?2004h> "]
[93.645984, "o", "    current_id = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.646023, "o", "> "]
[93.646056, "o", "    content: List[str] = []\r\n\u001b[?2004l\r"]
[93.646078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.646101, "o", "\u001b[?2004h> "]
[93.646121, "o", "    def flush():\r\n\u001b[?2004l\r"]
[93.646143, "o", "\u001b[?2004h> "]
[93.646191, "o", "        nonlocal current_id, content\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.646213, "o", "> "]
[93.646252, "o", "        if current_id is None:\r\n\u001b[?2004l\r"]
[93.646292, "o", "\u001b[?2004h> "]
[93.646325, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.646357, "o", "> "]
[93.646392, "o", "        # filter non-empty lines\r\n\u001b[?2004l\r"]
[93.646422, "o", "\u001b[?2004h> "]
[93.646525, "o", "        content_lines = [l for l in content if l.strip() != \"\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.646583, "o", "        if not content_lines:\r\n\u001b[?2004l\r"]
[93.646607, "o", "\u001b[?2004h> "]
[93.646652, "o", "            # create empty node\r\n\u001b[?2004l\r"]
[93.646677, "o", "\u001b[?2004h> "]
[93.646818, "o", "            nodes.append({\"id\": current_id, \"text\": \"\", \"speaker\": \"\", \"type\": \"line\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.646855, "o", "            return\r\n\u001b[?2004l\r"]
[93.646892, "o", "\u001b[?2004h> "]
[93.646933, "o", "        first = content_lines[0].lstrip()\r\n\u001b[?2004l\r"]
[93.646968, "o", "\u001b[?2004h> "]
[93.647014, "o", "        if re.match(r'^\\d+\\.', first):\r\n\u001b[?2004l\r"]
[93.647041, "o", "\u001b[?2004h> "]
[93.647075, "o", "            # choice node\r\n\u001b[?2004l\r"]
[93.647111, "o", "\u001b[?2004h> "]
[93.64723, "o", "            nodes.append({\"id\": current_id, \"text\": \"\", \"speaker\": \"\", \"type\": \"choice\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.647249, "o", "> "]
[93.647304, "o", "            for line in content_lines:\r\n\u001b[?2004l\r"]
[93.647345, "o", "\u001b[?2004h> "]
[93.647375, "o", "                line = line.strip()\r\n\u001b[?2004l\r"]
[93.647393, "o", "\u001b[?2004h"]
[93.647412, "o", "> "]
[93.647477, "o", "                m = re.match(r'^\\d+\\.\\s*(.*)$', line)\r\n\u001b[?2004l\r"]
[93.647501, "o", "\u001b[?2004h"]
[93.647519, "o", "> "]
[93.64758, "o", "                option_text = m.group(1) if m else line\r\n\u001b[?2004l\r"]
[93.647597, "o", "\u001b[?2004h> "]
[93.647656, "o", "                # split on last arrow\r\n\u001b[?2004l\r"]
[93.64768, "o", "\u001b[?2004h"]
[93.647706, "o", "> "]
[93.647737, "o", "                if \"->\" in option_text:\r\n\u001b[?2004l\r"]
[93.647773, "o", "\u001b[?2004h> "]
[93.647862, "o", "                    opt_text, target = option_text.rsplit(\"->\", 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.647893, "o", "> "]
[93.647946, "o", "                    opt_text = opt_text.strip()\r\n\u001b[?2004l\r"]
[93.647971, "o", "\u001b[?2004h> "]
[93.64803, "o", "                    target = target.strip()\r\n\u001b[?2004l\r"]
[93.648047, "o", "\u001b[?2004h> "]
[93.648081, "o", "                else:\r\n\u001b[?2004l\r"]
[93.648098, "o", "\u001b[?2004h"]
[93.648123, "o", "> "]
[93.648176, "o", "                    opt_text = option_text.strip()\r\n\u001b[?2004l\r"]
[93.648194, "o", "\u001b[?2004h> "]
[93.648246, "o", "                    target = None\r\n\u001b[?2004l\r"]
[93.648263, "o", "\u001b[?2004h> "]
[93.648305, "o", "                if target:\r\n\u001b[?2004l\r"]
[93.648322, "o", "\u001b[?2004h> "]
[93.648449, "o", "                    edges.append({\"from\": current_id, \"to\": target, \"text\": opt_text})\r\n\u001b[?2004l\r"]
[93.648464, "o", "\u001b[?2004h> "]
[93.648494, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.648515, "o", "> "]
[93.648545, "o", "            # line node\r\n\u001b[?2004l\r"]
[93.648586, "o", "\u001b[?2004h> "]
[93.648665, "o", "            line_text = \" \".join([l.strip() for l in content_lines])\r\n\u001b[?2004l\r"]
[93.648699, "o", "\u001b[?2004h> "]
[93.648736, "o", "            if \"->\" in line_text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.648754, "o", "> "]
[93.64884, "o", "                before, target = line_text.rsplit(\"->\", 1)\r\n\u001b[?2004l\r"]
[93.648857, "o", "\u001b[?2004h> "]
[93.648917, "o", "                target = target.strip()\r\n\u001b[?2004l\r"]
[93.648935, "o", "\u001b[?2004h> "]
[93.648964, "o", "            else:\r\n\u001b[?2004l\r"]
[93.648988, "o", "\u001b[?2004h> "]
[93.649034, "o", "                before = line_text\r\n\u001b[?2004l\r"]
[93.64905, "o", "\u001b[?2004h> "]
[93.649097, "o", "                target = None\r\n\u001b[?2004l\r"]
[93.649137, "o", "\u001b[?2004h> "]
[93.649161, "o", "            if \":\" in before:\r\n\u001b[?2004l\r"]
[93.64918, "o", "\u001b[?2004h> "]
[93.649257, "o", "                speaker, text = before.split(\":\", 1)\r\n\u001b[?2004l\r"]
[93.649272, "o", "\u001b[?2004h> "]
[93.649338, "o", "                speaker = speaker.strip()\r\n\u001b[?2004l\r"]
[93.649364, "o", "\u001b[?2004h> "]
[93.649411, "o", "                text = text.strip()\r\n\u001b[?2004l\r"]
[93.649434, "o", "\u001b[?2004h"]
[93.649459, "o", "> "]
[93.649482, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.649525, "o", "                speaker = \"\"\r\n\u001b[?2004l\r"]
[93.649554, "o", "\u001b[?2004h> "]
[93.6496, "o", "                text = before.strip()\r\n\u001b[?2004l\r"]
[93.649625, "o", "\u001b[?2004h> "]
[93.649756, "o", "            nodes.append({\"id\": current_id, \"text\": text, \"speaker\": speaker, \"type\": \"line\"})\r\n\u001b[?2004l\r"]
[93.64978, "o", "\u001b[?2004h"]
[93.649805, "o", ">             if target:\r\n\u001b[?2004l\r"]
[93.649828, "o", "\u001b[?2004h> "]
[93.649951, "o", "                edges.append({\"from\": current_id, \"to\": target, \"text\": \"\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.649976, "o", "> \r\n\u001b[?2004l\r"]
[93.650017, "o", "\u001b[?2004h> "]
[93.650044, "o", "    for raw in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.650076, "o", "        line = raw.strip()\r\n\u001b[?2004l\r"]
[93.650094, "o", "\u001b[?2004h> "]
[93.650177, "o", "        if line.startswith(\"[\") and line.endswith(\"]\"):\r\n\u001b[?2004l\r"]
[93.650202, "o", "\u001b[?2004h> "]
[93.650231, "o", "            flush()\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650259, "o", "> "]
[93.650311, "o", "            current_id = line[1:-1].strip()\r\n\u001b[?2004l\r"]
[93.650328, "o", "\u001b[?2004h> "]
[93.650365, "o", "            content = []\r\n\u001b[?2004l\r"]
[93.650402, "o", "\u001b[?2004h> "]
[93.650432, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650451, "o", "> "]
[93.650496, "o", "            content.append(raw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650514, "o", "> "]
[93.65054, "o", "    flush()\r\n\u001b[?2004l\r"]
[93.650564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.650587, "o", "\u001b[?2004h> "]
[93.650658, "o", "    # add implicit nodes for missing targets (e.g., End)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650675, "o", "> "]
[93.650736, "o", "    node_ids = {n[\"id\"] for n in nodes}\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650754, "o", "> "]
[93.650791, "o", "    for e in edges:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.650808, "o", "> "]
[93.650863, "o", "        if e[\"to\"] not in node_ids:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.65088, "o", "> "]
[93.651006, "o", "            nodes.append({\"id\": e[\"to\"], \"text\": \"\", \"speaker\": \"\", \"type\": \"line\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651015, "o", "> "]
[93.651085, "o", "            node_ids.add(e[\"to\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651102, "o", "> \r\n\u001b[?2004l\r"]
[93.651125, "o", "\u001b[?2004h> "]
[93.65119, "o", "    return {\"nodes\": nodes, \"edges\": edges}\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651214, "o", "> \r\n"]
[93.651242, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.651267, "o", "\u001b[?2004h> "]
[93.651301, "o", "def to_dot(graph: Dict) -> str:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651325, "o", "> "]
[93.651432, "o", "    lines = [\"digraph Dialogue {\", \"  rankdir=LR;\", \"  node [shape=box];\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651445, "o", "> "]
[93.651494, "o", "    for node in graph[\"nodes\"]:\r\n\u001b[?2004l\r"]
[93.651517, "o", "\u001b[?2004h> "]
[93.65155, "o", "        nid = node[\"id\"]\r\n\u001b[?2004l\r"]
[93.651567, "o", "\u001b[?2004h> "]
[93.651632, "o", "        ntype = node.get(\"type\", \"\")\r\n\u001b[?2004l\r"]
[93.65165, "o", "\u001b[?2004h"]
[93.651686, "o", "> "]
[93.651716, "o", "        label = nid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.651745, "o", "        if ntype == \"line\":\r\n\u001b[?2004l\r"]
[93.651763, "o", "\u001b[?2004h> "]
[93.651835, "o", "            speaker = node.get(\"speaker\", \"\")\r\n\u001b[?2004l\r"]
[93.65186, "o", "\u001b[?2004h> "]
[93.651919, "o", "            text = node.get(\"text\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.651937, "o", "> "]
[93.651969, "o", "            if speaker:\r\n\u001b[?2004l\r"]
[93.651992, "o", "\u001b[?2004h> "]
[93.652065, "o", "                label = f\"{nid}\\\\n{speaker}: {text}\"\r\n\u001b[?2004l\r"]
[93.652081, "o", "\u001b[?2004h> "]
[93.652111, "o", "            else:\r\n\u001b[?2004l\r"]
[93.652134, "o", "\u001b[?2004h> "]
[93.652191, "o", "                label = f\"{nid}\\\\n{text}\"\r\n\u001b[?2004l\r"]
[93.652208, "o", "\u001b[?2004h> "]
[93.652231, "o", "        else:\r\n\u001b[?2004l\r"]
[93.652255, "o", "\u001b[?2004h"]
[93.652281, "o", "> "]
[93.652312, "o", "            label = f\"{nid}\\\\n(choice)\"\r\n\u001b[?2004l\r"]
[93.652339, "o", "\u001b[?2004h> "]
[93.652423, "o", "        shape = \"diamond\" if ntype == \"choice\" else \"box\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.652443, "o", "> "]
[93.652544, "o", "        lines.append(f\"  \\\"{nid}\\\" [label=\\\"{label}\\\", shape={shape}];\")\r\n\u001b[?2004l\r"]
[93.65257, "o", "\u001b[?2004h> "]
[93.652611, "o", "    for edge in graph[\"edges\"]:\r\n\u001b[?2004l\r"]
[93.652634, "o", "\u001b[?2004h> "]
[93.652672, "o", "        frm = edge[\"from\"]\r\n\u001b[?2004l\r"]
[93.652689, "o", "\u001b[?2004h> "]
[93.65273, "o", "        to = edge[\"to\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.652748, "o", "> "]
[93.652802, "o", "        text = edge.get(\"text\", \"\")\r\n\u001b[?2004l\r"]
[93.652826, "o", "\u001b[?2004h> "]
[93.652853, "o", "        if text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.65287, "o", "> "]
[93.652973, "o", "            lines.append(f\"  \\\"{frm}\\\" -> \\\"{to}\\\" [label=\\\"{text}\\\"]; \")\r\n\u001b[?2004l\r"]
[93.652986, "o", "\u001b[?2004h> "]
[93.653015, "o", "        else:\r\n\u001b[?2004l\r"]
[93.653039, "o", "\u001b[?2004h> "]
[93.653113, "o", "            lines.append(f\"  \\\"{frm}\\\" -> \\\"{to}\\\";\")\r\n\u001b[?2004l\r"]
[93.653126, "o", "\u001b[?2004h"]
[93.653148, "o", "> "]
[93.653178, "o", "    lines.append(\"}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.653194, "o", "> "]
[93.65323, "o", "    return \"\\n\".join(lines)\r\n\u001b[?2004l\r"]
[93.653253, "o", "\u001b[?2004h> \r\n"]
[93.653279, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.653298, "o", "\u001b[?2004h> "]
[93.653335, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.653352, "o", "> "]
[93.65344, "o", "    with open(\"/app/script.txt\", \"r\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r"]
[93.653458, "o", "\u001b[?2004h> "]
[93.653495, "o", "        text = f.read()\r\n\u001b[?2004l\r"]
[93.653512, "o", "\u001b[?2004h> "]
[93.653561, "o", "    graph = parse_script(text)\r\n\u001b[?2004l\r"]
[93.653578, "o", "\u001b[?2004h> "]
[93.653674, "o", "    with open(\"/app/dialogue.json\", \"w\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r"]
[93.653699, "o", "\u001b[?2004h> "]
[93.653754, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.65378, "o", "> "]
[93.653811, "o", "    dot = to_dot(graph)\r\n\u001b[?2004l\r"]
[93.653835, "o", "\u001b[?2004h> "]
[93.653925, "o", "    with open(\"/app/dialogue.dot\", \"w\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r"]
[93.653943, "o", "\u001b[?2004h> "]
[93.653977, "o", "        f.write(dot)\r\n\u001b[?2004l\r"]
[93.654002, "o", "\u001b[?2004h> "]
[93.654029, "o", "PYCODE\r\n\u001b[?2004l\r"]
[93.655413, "o", "\u001b[?2004hroot@f7655c49d8af:/app# "]
[93.842954, "i", "python3 /app/solution.py\n"]
[93.843108, "o", "python3 /app/solution.py\r\n\u001b[?2004l\r"]
[93.879751, "o", "\u001b[?2004hroot@f7655c49d8af:/app# "]
[94.858749, "i", "ls -la /app/dialogue.json /app/dialogue.dot\n"]
[94.858922, "o", "ls -la /app/dialogue.json /app/dialogue.dot\r\n\u001b[?2004l\r"]
[94.86013, "o", "-rw-r--r-- 1 root root 39304 Jan 26 11:20 /app/dialogue.dot\r\n-rw-r--r-- 1 root root 62552 Jan 26 11:20 /app/dialogue.json\r\n"]
[94.860286, "o", "\u001b[?2004hroot@f7655c49d8af:/app# "]
