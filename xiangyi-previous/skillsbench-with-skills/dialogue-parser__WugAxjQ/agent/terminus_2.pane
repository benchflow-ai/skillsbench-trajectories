[?2004hroot@f7655c49d8af:/app# cat > /app/solution.py <<'PYCODE'
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> from typing import Dict, List
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_script(text: str):
[?2004l[?2004h>     lines = text.splitlines()
[?2004l[?2004h>     nodes: List[Dict] = []
[?2004l[?2004h>     edges: List[Dict] = []
[?2004l[?2004h> 
[?2004l[?2004h>     current_id = None
[?2004l[?2004h>     content: List[str] = []
[?2004l[?2004h> 
[?2004l[?2004h>     def flush():
[?2004l[?2004h>         nonlocal current_id, content
[?2004l[?2004h>         if current_id is None:
[?2004l[?2004h>             return
[?2004l[?2004h>         # filter non-empty lines
[?2004l[?2004h>         content_lines = [l for l in content if l.strip() != ""]
[?2004l[?2004h>         if not content_lines:
[?2004l[?2004h>             # create empty node
[?2004l[?2004h>             nodes.append({"id": current_id, "text": "", "speaker": "", "type": "line"})
[?2004l[?2004h>             return
[?2004l[?2004h>         first = content_lines[0].lstrip()
[?2004l[?2004h>         if re.match(r'^\d+\.', first):
[?2004l[?2004h>             # choice node
[?2004l[?2004h>             nodes.append({"id": current_id, "text": "", "speaker": "", "type": "choice"})
[?2004l[?2004h>             for line in content_lines:
[?2004l[?2004h>                 line = line.strip()
[?2004l[?2004h>                 m = re.match(r'^\d+\.\s*(.*)$', line)
[?2004l[?2004h>                 option_text = m.group(1) if m else line
[?2004l[?2004h>                 # split on last arrow
[?2004l[?2004h>                 if "->" in option_text:
[?2004l[?2004h>                     opt_text, target = option_text.rsplit("->", 1)
[?2004l[?2004h>                     opt_text = opt_text.strip()
[?2004l[?2004h>                     target = target.strip()
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     opt_text = option_text.strip()
[?2004l[?2004h>                     target = None
[?2004l[?2004h>                 if target:
[?2004l[?2004h>                     edges.append({"from": current_id, "to": target, "text": opt_text})
[?2004l[?2004h>         else:
[?2004l[?2004h>             # line node
[?2004l[?2004h>             line_text = " ".join([l.strip() for l in content_lines])
[?2004l[?2004h>             if "->" in line_text:
[?2004l[?2004h>                 before, target = line_text.rsplit("->", 1)
[?2004l[?2004h>                 target = target.strip()
[?2004l[?2004h>             else:
[?2004l[?2004h>                 before = line_text
[?2004l[?2004h>                 target = None
[?2004l[?2004h>             if ":" in before:
[?2004l[?2004h>                 speaker, text = before.split(":", 1)
[?2004l[?2004h>                 speaker = speaker.strip()
[?2004l[?2004h>                 text = text.strip()
[?2004l[?2004h>             else:
[?2004l[?2004h>                 speaker = ""
[?2004l[?2004h>                 text = before.strip()
[?2004l[?2004h>             nodes.append({"id": current_id, "text": text, "speaker": speaker, "type": "line"})
[?2004l[?2004h>             if target:
[?2004l[?2004h>                 edges.append({"from": current_id, "to": target, "text": ""})
[?2004l[?2004h> 
[?2004l[?2004h>     for raw in lines:
[?2004l[?2004h>         line = raw.strip()
[?2004l[?2004h>         if line.startswith("[") and line.endswith("]"):
[?2004l[?2004h>             flush()
[?2004l[?2004h>             current_id = line[1:-1].strip()
[?2004l[?2004h>             content = []
[?2004l[?2004h>         else:
[?2004l[?2004h>             content.append(raw)
[?2004l[?2004h>     flush()
[?2004l[?2004h> 
[?2004l[?2004h>     # add implicit nodes for missing targets (e.g., End)
[?2004l[?2004h>     node_ids = {n["id"] for n in nodes}
[?2004l[?2004h>     for e in edges:
[?2004l[?2004h>         if e["to"] not in node_ids:
[?2004l[?2004h>             nodes.append({"id": e["to"], "text": "", "speaker": "", "type": "line"})
[?2004l[?2004h>             node_ids.add(e["to"])
[?2004l[?2004h> 
[?2004l[?2004h>     return {"nodes": nodes, "edges": edges}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def to_dot(graph: Dict) -> str:
[?2004l[?2004h>     lines = ["digraph Dialogue {", "  rankdir=LR;", "  node [shape=box];"]
[?2004l[?2004h>     for node in graph["nodes"]:
[?2004l[?2004h>         nid = node["id"]
[?2004l[?2004h>         ntype = node.get("type", "")
[?2004l[?2004h>         label = nid
[?2004l[?2004h>         if ntype == "line":
[?2004l[?2004h>             speaker = node.get("speaker", "")
[?2004l[?2004h>             text = node.get("text", "")
[?2004l[?2004h>             if speaker:
[?2004l[?2004h>                 label = f"{nid}\\n{speaker}: {text}"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 label = f"{nid}\\n{text}"
[?2004l[?2004h>         else:
[?2004l[?2004h>             label = f"{nid}\\n(choice)"
[?2004l[?2004h>         shape = "diamond" if ntype == "choice" else "box"
[?2004l[?2004h>         lines.append(f"  \"{nid}\" [label=\"{label}\", shape={shape}];")
[?2004l[?2004h>     for edge in graph["edges"]:
[?2004l[?2004h>         frm = edge["from"]
[?2004l[?2004h>         to = edge["to"]
[?2004l[?2004h>         text = edge.get("text", "")
[?2004l[?2004h>         if text:
[?2004l[?2004h>             lines.append(f"  \"{frm}\" -> \"{to}\" [label=\"{text}\"]; ")
[?2004l[?2004h>         else:
[?2004l[?2004h>             lines.append(f"  \"{frm}\" -> \"{to}\";")
[?2004l[?2004h>     lines.append("}")
[?2004l[?2004h>     return "\n".join(lines)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     with open("/app/script.txt", "r", encoding="utf-8") as f:
[?2004l[?2004h>         text = f.read()
[?2004l[?2004h>     graph = parse_script(text)
[?2004l[?2004h>     with open("/app/dialogue.json", "w", encoding="utf-8") as f:
[?2004l[?2004h>         json.dump(graph, f, indent=2)
[?2004l[?2004h>     dot = to_dot(graph)
[?2004l[?2004h>     with open("/app/dialogue.dot", "w", encoding="utf-8") as f:
[?2004l[?2004h>         f.write(dot)
