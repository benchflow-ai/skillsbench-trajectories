[553.486733, "i", "cat << 'EOF' > detect_and_extract.py\nfrom surya.ocr import run_ocr\nfrom surya.model.detection.model import load_model as load_det_model, load_processor as load_det_processor\nfrom surya.model.recognition.model import load_model as load_rec_model, load_processor as load_rec_processor\nfrom surya.model.ordering.model import load_model as load_ord_model, load_processor as load_ord_processor\nfrom surya.model.layout.model import load_model as load_layout_model, load_processor as load_layout_processor\nfrom surya.detection import batch_detection\nfrom surya.layout import batch_layout\nfrom PIL import Image\nimport os\n\n# This is getting complicated. Let's try a simpler way using marker or texify if they have CLI.\nEOF\n"]
[553.489929, "o", "cat << 'EOF' > detect_and_extract.py\r\n\u001b[?2004l\r\u001b[?2004h> from surya.ocr import run_ocr\r\n\u001b[?2004l\r\u001b[?2004h> from surya.model.detection.model import load_model as load_det_model, load_processor as load_det_processor\r\n\u001b[?2004l\r\u001b[?2004h> from surya.model.recognition.model import load_model as load_rec_model, load_processor as load_rec_processor\r\n\u001b[?2004l\r\u001b[?2004h> from surya.model.ordering.model import load_model as load_ord_model, load_processor as load_ord_processor\r\n\u001b[?2004l\r\u001b[?2004h> from surya.model.layout.model import load_model as load_layout_model, load_processor as load_layout_processor\r\n\u001b[?2004l\r\u001b[?2004h> from surya.detection import batch_detection\r\n\u001b[?2004l\r\u001b[?2004h> from surya.layout import batch_layout\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # This is getting complicated. Let's try a simpler way using marker or texify if they have CLI.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
