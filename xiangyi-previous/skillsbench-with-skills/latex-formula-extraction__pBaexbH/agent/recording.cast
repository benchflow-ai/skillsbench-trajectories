[533.480804, "o", "\r\nAll support for the `google.generativeai` package has ended. It will no longer be receiving \r\nupdates or bug fixes. Please switch to the `google.genai` package as soon as possible.\r\nSee README for more details:\r\n\r\nhttps://github.com/google-gemini/deprecated-generative-ai-python/blob/main/README.md\r\n\r\n  import google.generativeai as genai\r\n/usr/local/lib/python3.12/dist-packages/click/core.py:1223: UserWarning: The parameter --force_layout_block is used more than once. Remove its duplicate as parameters should be unique.\r\n  parser = self.make_parser(ctx)\r\n/usr/local/lib/python3.12/dist-packages/click/core.py:1223: UserWarning: The parameter --use_llm is used more than once. Remove its duplicate as parameters should be unique.\r\n  parser = self.make_parser(ctx)\r\n/usr/local/lib/python3.12/dist-packages/click/core.py:1223: UserWarning: The parameter --google_api_key is used more than once. Remove its duplicate as parameters should be unique.\r\n  parser = self.make_parser(ctx)\r\n/usr/local/lib/python3.12/dist-packages/marker/config/printer.py:81: UserWarning: The parameter --force_layout_block is used more than once. Remove its duplicate as parameters should be unique.\r\n  super().parse_args(ctx, args)\r\n/usr/local/lib/python3.12/dist-packages/marker/config/printer.py:81: UserWarning: The parameter --use_llm is used more than once. Remove its duplicate as parameters should be unique.\r\n  super().parse_args(ctx, args)\r\n/usr/local/lib/python3.12/dist-packages/marker/config/printer.py:81: UserWarning: The parameter --google_api_key is used more than once. Remove its duplicate as parameters should be unique.\r\n  super().parse_args(ctx, args)\r\n"]
