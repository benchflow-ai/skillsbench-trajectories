[?2004l[?2004h>     
[?2004l[?2004h>     with pdfplumber.open(pdf_path) as pdf:
[?2004l[?2004h>         for page_num, page in enumerate(pdf.pages):
[?2004l[?2004h>             locations[page_num] = []
[?2004l[?2004h>             words = page.extract_words()
[?2004l[?2004h>             text = page.extract_text()
[?2004l[?2004h>             
[?2004l[?2004h>             if not words or not text:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # Find all pattern matches
[?2004l[?2004h>             for pattern in patterns:
[?2004l[?2004h>                 for match in re.finditer(pattern, text, re.IGNORECASE):
[?2004l[?2004h>                     matched_text = match.group()
[?2004l[?2004h>                     # Find corresponding words
[?2004l[?2004h>                     for word in words:
[?2004l[?2004h>                         if re.search(re.escape(word['text']), matched_text, re.IGNORECASE):
[?2004l[?2004h>                             x0, top, x1, bottom = word['x0'], word['top'], word['x1'], word['bottom']
[?2004l[?2004h>                             # Expand slightly for better coverage
[?2004l[?2004h>                             locations[page_num].append({
[?2004l[?2004h>                                 'rect': [x0-2, top-2, x1+2, bottom+2],
[?2004l[?2004h>                                 'text': word['text']
[?2004l[?2004h>                             })
[?2004l[?2004h>     
[?2004l[?2004h>     return locations
[?2004l[?2004h> 
[?2004l[?2004h> def redact_pdf_with_rectangles(input_path, output_path, patterns):
[?2004l[?2004h>     """
[?2004l[?2004h>     Redact by adding black rectangles over sensitive text
[?2004l[?2004h>     """
[?2004l[?2004h>     locations = get_text_locations(input_path, patterns)
[?2004l[?2004h>     
[?2004l[?2004h>     reader = PdfReader(input_path)
