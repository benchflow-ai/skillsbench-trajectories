[?2004l[?2004h>         writer.add_page(page)
[?2004l[?2004h>         
[?2004l[?2004h>         # Add black rectangles over sensitive areas
[?2004l[?2004h>         if page_num in locations:
[?2004l[?2004h>             for item in locations[page_num]:
[?2004l[?2004h>                 rect = RectangleObject(item['rect'])
[?2004l[?2004h>                 # Use /Redact annotation with black background
[?2004l[?2004h>                 writer.pages[page_num].add_redaction(rect, fill=[0, 0, 0])
[?2004l[?2004h>     
[?2004l[?2004h>     with open(output_path, 'wb') as f:
[?2004l[?2004h>         writer.write(f)
