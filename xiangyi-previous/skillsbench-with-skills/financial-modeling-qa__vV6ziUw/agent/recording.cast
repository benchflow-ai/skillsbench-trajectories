[200.504497, "o", "    29\tSCORING TURNS\r\n    30\tCategory\r\n    31\t\r\n    32\tCriteria\r\n    33\t\r\n    34\tScore\r\n    35\t\r\n    36\tAny turn\r\n    37\t\r\n    38\tThe highest number rolled in the turn\r\n    39\tmultiplied by\r\n    40\tthe number of times it was rolled that turn\r\n    41\t\r\n    42\tAny turn\r\n    43\t\r\n    44\tSum of all six dice rolls\r\n    45\t\r\n    46\tAny turn\r\n    47\t\r\n    48\tThe highest number rolled\r\n    49\tmultiplied by\r\n"]
[200.504561, "o", "    50\tthe lowest number rolled\r\n    51\tmultiplied by\r\n    52\tthe difference between them\r\n    53\t\r\n    54\tHigh and Often\r\n    55\tSummation\r\n    56\t\r\n    57\tHighs and Lows\r\n    58\t\r\n    59\tOnly two numbers\r\n    60\t\r\n    61\tThe six rolls are all one of two numbers\r\n    62\t(e.g. 3-6-3-6-6-6)\r\n    63\t\r\n    64\t30\r\n    65\t\r\n    66\tAll the numbers\r\n    67\t\r\n    68\tThe rolls are (in any order) 1-2-3-4-5-6\r\n    69\t\r\n    70\t40\r\n    71\t\r\n    72\tWhen listed in the order rolled the\r\n    73\tOrdered subset of numbers contain a run of 4 consecutive\r\n    74\tfour\r\n"]
[200.504595, "o", "    75\tincreasing or decreasing numbers (e.g.\r\n    76\t1-2-3-4 or 5-4-3-2)\r\n    77\t\r\n    78\t50\r\n    79\t\r\n    80\tFor Questions 20 to 27, select your answer from a multiple choice list.\r\n    81\tFor Questions 28 to 29, you are required to type in your answer.\r\n"]
