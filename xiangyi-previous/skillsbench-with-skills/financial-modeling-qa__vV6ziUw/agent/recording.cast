[61.030367, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\npath='/root/data.xlsx'\nraw=pd.read_excel(path, sheet_name='Data', header=None)\n# count non-NaN per row\ncounts=raw.notna().sum(axis=1)\n# find rows with at least 5 non-NaN\ncandidates=counts[counts>=5].index[:10]\nprint('candidate rows', candidates.tolist())\nfor i in candidates:\n    print('row', i, raw.loc[i].tolist())\nPY\n"]
