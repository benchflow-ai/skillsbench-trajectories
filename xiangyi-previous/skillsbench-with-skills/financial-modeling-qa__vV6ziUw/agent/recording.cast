[372.260845, "i", "python3 - <<'PY'\nimport pandas as pd\npath='/root/data.xlsx'\nraw=pd.read_excel(path, sheet_name='Data', header=None)\nheader=raw.iloc[8]\ndf=raw.iloc[9:].reset_index(drop=True)\ndf.columns=header\ncols=['Turn number','Game number','Roll 1','Roll 2','Roll 3','Roll 4','Roll 5','Roll 6']\ndf=df[cols]\nprint('rows before drop', len(df))\nprint('NaNs per column')\nprint(df.isna().sum())\nprint('rows with any NaN', df[df.isna().any(axis=1)].head())\n# drop rows with NaN in turn/game\nclean=df.dropna(subset=['Turn number','Game number'])\nprint('rows after drop', len(clean))\n# counts per game\ncounts=clean['Game number'].value_counts()\nprint('min turns per game', counts.min(), 'max', counts.max())\nprint('games with counts !=2', counts[counts!=2].head())\nPY\n"]
