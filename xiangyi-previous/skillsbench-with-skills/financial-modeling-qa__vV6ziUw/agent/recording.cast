[287.05691, "i", "python3 - <<'PY'\nimport pandas as pd\npath='/root/data.xlsx'\nraw=pd.read_excel(path, sheet_name='Data', header=None)\nheader=raw.iloc[8]\ndf=raw.iloc[9:].reset_index(drop=True)\ndf.columns=header\ncols=['Turn number','Game number','Roll 1','Roll 2','Roll 3','Roll 4','Roll 5','Roll 6']\ndf=df[cols]\ndf=df.dropna(subset=['Turn number','Game number'])\ndf[cols]=df[cols].astype(int)\nprint(df.head())\nprint(df.tail())\nprint('games', df['Game number'].nunique(), 'turns', len(df))\nPY\n"]
