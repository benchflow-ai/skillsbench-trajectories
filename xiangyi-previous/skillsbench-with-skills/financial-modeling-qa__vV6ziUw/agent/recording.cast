[38.030364, "i", "python3 - <<'PY'\nimport pandas as pd\nimport sys\npath='/root/data.xlsx'\ntry:\n    xl=pd.ExcelFile(path)\n    print('sheets', xl.sheet_names)\n    for name in xl.sheet_names:\n        df=xl.parse(name)\n        print('sheet', name, 'shape', df.shape)\n        print(df.head())\n        break\nexcept Exception as e:\n    print('error',e)\nPY\n"]
