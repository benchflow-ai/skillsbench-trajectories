[53.266956, "i", "python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\npath='/root/data.xlsx'\nraw=pd.read_excel(path, sheet_name='Data', header=None)\nprint('shape', raw.shape)\n# find rows with 'Game' or 'Match'\nfor i,row in raw.iterrows():\n    if row.astype(str).str.contains('Game', case=False, na=False).any():\n        print('row', i, row.head(10).tolist())\n        if i>20: break\nPY\n"]
