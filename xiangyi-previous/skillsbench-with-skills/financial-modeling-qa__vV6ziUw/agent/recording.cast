[562.062766, "i", "python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\npath='/root/data.xlsx'\nraw=pd.read_excel(path, sheet_name='Data', header=None)\nheader=raw.iloc[8]\n# create df with header\nall_df=raw.iloc[9:].reset_index(drop=True)\nall_df.columns=header\ncols=['Turn number','Game number','Roll 1','Roll 2','Roll 3','Roll 4','Roll 5','Roll 6']\nsub=all_df[cols]\n# locate rows with NaN in turn number\nnan_rows=sub[sub['Turn number'].isna()]\nprint('NaN rows idx', nan_rows.index.tolist())\nif not nan_rows.empty:\n    idx=nan_rows.index[0]\n    print('full raw row at original index', idx+9)\n    print(raw.iloc[idx+9])\n# identify missing turn numbers\nclean=sub.dropna(subset=['Turn number','Game number'])\nturns=clean['Turn number'].astype(int)\nmissing=set(range(1,6001))-set(turns)\nprint('missing turn numbers', sorted(missing)[:10], 'count', len(missing))\n# check game counts\ncounts=clean['Game number'].astype(int).value_counts()\nprint('games with counts!=2', counts[counts!=2])\nPY\n"]
