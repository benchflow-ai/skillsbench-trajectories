[233.85737, "i", "python3 - <<'PY'\nimport pandas as pd\np='P1_POWER'\ndf=pd.read_csv(f'/app/data/codebook_{p}.csv')\nkeywords=['current','电流','HiPot','leak','漏电','insulation','contamination','污染','residue','助焊剂','version','版本','mismatch','boot','启动','CRC','校验','verify','program','烧录','fixture','接触不良','probe worn','探针磨损','short','短路','open','开路','cold solder','虚焊','少锡','partial short','component issue','over current','idle current']\nfor kw in keywords:\n    m=df[df['standard_label'].str.contains(kw,case=False,na=False) | df['keywords_examples'].str.contains(kw,case=False,na=False)]\n    if len(m)>0:\n        print('keyword',kw)\n        print(m[['code','standard_label','keywords_examples']])\nPY\n"]
