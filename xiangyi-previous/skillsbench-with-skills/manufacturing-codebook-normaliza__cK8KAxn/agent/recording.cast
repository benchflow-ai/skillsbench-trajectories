[165.076504, "i", "python3 - <<'PY'\nimport pandas as pd\np='P1_POWER'\ndf=pd.read_csv(f'/app/data/codebook_{p}.csv')\nterms=['current','电流','short','短路','over','偏高','I2C','R152','SW_NODE','open','开路','cold','虚焊','少锡','fixture','接触不良','probe','探针','boot','OS','fail']\nfor kw in terms:\n    m=df[df['standard_label'].str.contains(kw,case=False,na=False) | df['keywords_examples'].str.contains(kw,case=False,na=False)]\n    if len(m)>0:\n        print('keyword',kw,'matches',len(m))\n        print(m[['code','standard_label','keywords_examples']].head(10))\nPY\n"]
