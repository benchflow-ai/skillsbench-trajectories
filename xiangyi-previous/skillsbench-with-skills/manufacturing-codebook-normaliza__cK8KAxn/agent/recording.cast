[100.324066, "i", "python3 - <<'PY'\nimport pandas as pd,re\nkeywords=['CRC','校验','烧录','program','write','current','电流','short','短路','cold','虚焊','少锡','open','开路','fixture','接触不良','probe','探针','OS fail','启动','boot','ESD','静电','pressure','压伤','missing','少锡','桥连','短','over','过','偏高']\nfor p in ['P1_POWER','P2_CTRL','P3_RF']:\n    df=pd.read_csv(f'/app/data/codebook_{p}.csv')\n    print('===',p)\n    for kw in keywords:\n        m=df[df['keywords_examples'].str.contains(kw,case=False,na=False) | df['standard_label'].str.contains(kw,case=False,na=False)]\n        if len(m)>0:\n            print('keyword',kw, 'matches', len(m))\n            print(m[['code','standard_label','keywords_examples']].head(5))\n    print('---')\nPY\n"]
[100.324289, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[100.324321, "o", "\u001b[?2004h> "]
