[156.971331, "i", "python3 - <<'PY'\nimport pandas as pd\nterms=['current','电流','short','短路','over','偏高','CRC','校验','program','烧录','write','boot','启动','I2C','SW_NODE','R152','cold','虚焊','少锡','open','开路','fixture','接触不良','probe','探针','OS fail','fail']\nfor p in ['P1_POWER','P2_CTRL']:\n    df=pd.read_csv(f'/app/data/codebook_{p}.csv')\n    print('===',p)\n    for kw in terms:\n        m=df[df['standard_label'].str.contains(kw,case=False,na=False) | df['keywords_examples'].str.contains(kw,case=False,na=False)]\n        if len(m)>0:\n            print('keyword',kw,'matches',len(m))\n            print(m[['code','standard_label','keywords_examples']].head(10))\n    print('---')\nPY\n"]
