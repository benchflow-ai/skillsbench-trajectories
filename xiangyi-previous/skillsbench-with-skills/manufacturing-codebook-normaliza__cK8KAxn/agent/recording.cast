[400.977913, "i", "python3 - <<'PY'\nimport pandas as pd, json\nlogs=pd.read_csv('/app/data/test_center_logs.csv')\n# load codebooks\ncodebooks={}\nfor product in ['P1_POWER','P2_CTRL','P3_RF']:\n    df=pd.read_csv(f'/app/data/codebook_{product}.csv')\n    entries=[]\n    for _,row in df.iterrows():\n        kws=[]\n        if pd.notna(row['keywords_examples']):\n            kws=[k.strip().lower() for k in str(row['keywords_examples']).split(',') if k.strip()]\n        entries.append({'code':row['code'],'label':row['standard_label'],'keywords':kws})\n    codebooks[product]=entries\n\nrecords=[]\nfor _,row in logs.iterrows():\n    text = '' if pd.isna(row['raw_reason_text']) else str(row['raw_reason_text'])\n    text_l = text.lower()\n    entries = codebooks.get(row['product_id'],[])\n    best=None; best_score=0; best_keys=[]\n    for ent in entries:\n        keys=[kw for kw in ent['keywords'] if kw in text_l]\n        score=len(keys)\n        if score>best_score:\n            best_score=score; best=ent; best_keys=keys\n    if best_score==0 or best is None:\n        pred_code='UNKNOWN'; pred_label=''; conf=0.2; rationale='No keyword match in codebook'\n    else:\n        conf=round(min(0.95,0.6+0.1*best_score),2)\n        pred_code=best['code']; pred_label=best['label']\n        rationale='Matched keywords: '+', '.join(best_keys)\n    rec={\n        'record_id':row['record_id'],\n        'product_id':row['product_id'],\n        'station':row['station'],\n        'engineer_id':row['engineer_id'],\n        'raw_reason_text':text,\n        'normalized':[{\n            'segment_id':f\"{row['record_id']}-S1\",\n            'span_text':text,\n            'pred_code':pred_code,\n            'pred_label':pred_label,\n            'confidence':conf,\n            'rationale':rationale\n        }]\n    }\n    records.append(rec)\n\nout={'records':records}\nwith open('/app/output/solution.json','w',encoding='utf-8') as f:\n    json.dump(out,f,ensure_ascii=False,indent=2)\nprint('written',len(records))\nPY\n"]
