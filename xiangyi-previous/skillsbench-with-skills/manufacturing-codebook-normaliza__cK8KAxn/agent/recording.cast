[100.324981, "o", "keywords=['CRC','校验','烧录','program','write','current','电流','short','短路','cold','虚焊','少锡','open','开路','fixture','接触不良','probe','探针','OS fail','启动','boot','ESD','静电','pressure','压伤','missing','少锡','桥连','短','over','过','偏高']"]
[100.360592, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for p in ['P1_POWER','P2_CTRL','P3_RF']:\r\n\u001b[?2004l\r\u001b[?2004h>     df=pd.read_csv(f'/app/data/codebook_{p}.csv')\r\n\u001b[?2004l\r\u001b[?2004h>     print('===',p)\r\n\u001b[?2004l\r\u001b[?2004h>     for kw in keywords:\r\n\u001b[?2004l\r\u001b[?2004h>         m=df[df['keywords_examples'].str.contains(kw,case=False,na=False) | df['standard_label'].str.contains(kw,case=False,na=False)]\r\n\u001b[?2004l\r\u001b[?2004h>         if len(m)>0:\r\n\u001b[?2004l\r\u001b[?2004h>             print('keyword',kw, 'matches', len(m))\r\n\u001b[?2004l\r\u001b[?2004h>             print(m[['code','standard_label','keywords_examples']].head(5))\r\n\u001b[?2004l\r\u001b[?2004h>     print('---')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
