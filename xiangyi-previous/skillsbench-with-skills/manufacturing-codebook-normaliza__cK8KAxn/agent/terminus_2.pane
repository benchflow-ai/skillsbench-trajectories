[?2004lpython3 - <<'PY'
import pandas as pd
p='P2_CTRL'
df=pd.read_csv(f'/app/data/codebook_{p}.csv')
keywords=['CRC','校验','verify','boot','启动','version','版本','mismatch','program','烧录','write','OS fail','current','电流','short','短路','open','开路','fixture','接触不良','probe worn','探针磨损','contamination','污染','residue','助焊剂']
for kw in keywords:
    m=df[df['standard_label'].str.contains(kw,case=False,na=False) | df['keywords_examples'].str.contains(kw,case=False,na=False)]
    if len(m)>0:
        print('keyword',kw)
        print(m[['code','standard_label','keywords_examples']])
