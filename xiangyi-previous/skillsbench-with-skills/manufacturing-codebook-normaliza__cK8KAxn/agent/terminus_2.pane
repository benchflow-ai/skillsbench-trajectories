[?2004l[?2004h> import pandas as pd, json
[?2004l[?2004h> logs=pd.read_csv('/app/data/test_center_logs.csv')
[?2004l[?2004h> # load codebooks
[?2004l[?2004h> codebooks={}
[?2004l[?2004h> for product in ['P1_POWER','P2_CTRL','P3_RF']:
[?2004l[?2004h>     df=pd.read_csv(f'/app/data/codebook_{product}.csv')
[?2004l[?2004h>     entries=[]
[?2004l[?2004h>     for _,row in df.iterrows():
[?2004l[?2004h>         kws=[]
[?2004l[?2004h>         if pd.notna(row['keywords_examples']):
[?2004l[?2004h>             kws=[k.strip().lower() for k in str(row['keywords_examples']).split(',') if k.strip()]
[?2004l[?2004h>         entries.append({'code':row['code'],'label':row['standard_label'],'keywords':kws})
[?2004l[?2004h>     codebooks[product]=entries
[?2004l[?2004h> 
[?2004l[?2004h> records=[]
[?2004l[?2004h> for _,row in logs.iterrows():
[?2004l[?2004h>     text = '' if pd.isna(row['raw_reason_text']) else str(row['raw_reason_text'])
[?2004l[?2004h>     text_l = text.lower()
[?2004l[?2004h>     entries = codebooks.get(row['product_id'],[])
[?2004l[?2004h>     best=None; best_score=0; best_keys=[]
[?2004l[?2004h>     for ent in entries:
[?2004l[?2004h>         keys=[kw for kw in ent['keywords'] if kw in text_l]
[?2004l[?2004h>         score=len(keys)
[?2004l[?2004h>         if score>best_score:
[?2004l[?2004h>             best_score=score; best=ent; best_keys=keys
[?2004l[?2004h>     if best_score==0 or best is None:
[?2004l[?2004h>         pred_code='UNKNOWN'; pred_label=''; conf=0.2; rationale='No keyword match in codebook'
[?2004l[?2004h>     else:
[?2004l[?2004h>         conf=round(min(0.95,0.6+0.1*best_score),2)
[?2004l[?2004h>         pred_code=best['code']; pred_label=best['label']
[?2004l[?2004h>         rationale='Matched keywords: '+', '.join(best_keys)
[?2004l[?2004h>     rec={
[?2004l[?2004h>         'record_id':row['record_id'],
[?2004l[?2004h>         'product_id':row['product_id'],
[?2004l[?2004h>         'station':row['station'],
[?2004l[?2004h>         'engineer_id':row['engineer_id'],
[?2004l[?2004h>         'raw_reason_text':text,
[?2004l[?2004h>         'normalized':[{
[?2004l[?2004h>             'segment_id':f"{row['record_id']}-S1",
[?2004l[?2004h>             'span_text':text,
[?2004l[?2004h>             'pred_code':pred_code,
[?2004l[?2004h>             'pred_label':pred_label,
[?2004l[?2004h>             'confidence':conf,
[?2004l[?2004h>             'rationale':rationale
[?2004l[?2004h>         }]
[?2004l[?2004h>     }
[?2004l[?2004h>     records.append(rec)
[?2004l[?2004h> 
[?2004l[?2004h> out={'records':records}
[?2004l[?2004h> with open('/app/output/solution.json','w',encoding='utf-8') as f:
[?2004l[?2004h>     json.dump(out,f,ensure_ascii=False,indent=2)
[?2004l[?2004h> print('written',len(records))
