[?2004lpython3 - <<'PY'
import pandas as pd
p='P3_RF'
df=pd.read_csv(f'/app/data/codebook_{p}.csv')
keywords=['RF','cal','loss','insertion','contamination','residue','助焊剂','污染','current','电流','HiPot','leak','漏电','boot','CRC','program','烧录','fixture','probe','接触不良']
for kw in keywords:
    m=df[df['standard_label'].str.contains(kw,case=False,na=False) | df['keywords_examples'].str.contains(kw,case=False,na=False)]
    if len(m)>0:
        print('keyword',kw)
        print(m[['code','standard_label','keywords_examples']])
