[188.604129, "o", "/app/workspace/Library/Tactic/ModCases.lean:8:/-! # `mod_cases` tactic\r\n/app/workspace/Library/Tactic/ModCases.lean:10:The `mod_cases` tactic does case disjunction on `e % n`, where `e : ℤ`, to yield a number of\r\n/app/workspace/Library/Tactic/ModCases.lean:73:* The tactic `mod_cases h : e % 3` will perform a case disjunction on `e : ℤ` and yield subgoals\r\n/app/workspace/Library/Tactic/ModCases.lean:80:syntax \"mod_cases \" (atomic(binderIdent \":\"))? term:71 \" % \" num : tactic\r\n/app/workspace/Library/Tactic/ModCases.lean:82:elab_rules : tactic\r\n/app/workspace/Library/Tactic/ModCases.lean:83:  | `(tactic| mod_cases $[$h :]? $e % $n) => do\r\n/app/workspace/Library/Tactic/Define.lean:18:| `(tactic| dsimp [$t,*] $[$loc:location]?) =>\r\n/app/workspace/Library/Tactic/Define.lean:19:  `(tactic| simp (config := { decide := false }) only [$t,*, set_simps] $(loc)?)\r\n/app/workspace/Library/Tactic/Define.lean:22:| `(tactic| dsimp $[$loc:location]?) =>\r\n/app/workspace/Library/Tactic/Define.lean:23:  `(tactic| simp (config := { decide := false }) only [set_simps] $[$loc]?)\r\n"]
[188.604357, "o", "\u001b[?2004hroot@f1c9e15f2b07:/app/workspace# "]
