[188.754955, "o", "\u001b[35m\u001b[K/app/workspace/Library/Tactic/ModCases.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    let e : Q(ℤ) ← Tactic.elabTermEnsu\u001b[01;31m\u001b[Kring\u001b[m\u001b[KType e q(ℤ)\r\n"]
[188.755051, "o", "\u001b[35m\u001b[K/app/workspace/Library/Tactic/Addarith.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kring\u001b[m\u001b[K, by combining a specified set of linear (in)equality hypotheses.\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/Addarith.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K-- while we're at it, this turns off the succeed-with-noise behaviour of `\u001b[01;31m\u001b[Kring\u001b[m\u001b[K_nf` with `\u001b[01;31m\u001b[Kring\u001b[m\u001b[K`\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/Addarith.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kmacro_rules | `(tactic| \u001b[01;31m\u001b[Kring\u001b[m\u001b[K) => `(tactic| \u001b[01;31m\u001b[Kring\u001b[m\u001b[K_nf)\r\n"]
[188.755083, "o", "\u001b[35m\u001b[K/app/workspace/Library/Tactic/Extra.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    | fail \"out of scope: extra proves relations between a LHS and a RHS diffe\u001b[01;31m\u001b[Kring\u001b[m\u001b[K by some neutral quantity for the relation\")\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/Numbers.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K      \u001b[01;31m\u001b[Kring\u001b[m\u001b[K\r\n"]
[188.755202, "o", "\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| var : St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K → BExpr\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K18\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kinstance : ToSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K BExpr :=\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Klet rec toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K23\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| .and p q => \"(\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p ++ \" ∧ \" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K q ++ \")\"\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K24\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| .or p q => \"(\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p ++ \" ∨ \" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K q ++ \")\"\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K25\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| .implies p q => \"(\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p ++ \" → \" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K q ++ \")\"\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| .not p => \"¬\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K| .iff p q => \"(\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p ++ \" ↔ \" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K q ++ \")\"\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K⟨toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K⟩"]
[188.755268, "o", "\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef getVars : BExpr → List St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K36\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef subst : BExpr → St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K → Bool → BExpr\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef substAll (asgns : List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool)) (e : BExpr) : BExpr :=\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef permuteVarVals : List St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K → List (List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool)) := λ vs =>\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  let rec helper : Nat → List (List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool))\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    vs.mapIdx (λ (i : Nat) (v : St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K) =>\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef truthTable (e : BExpr) : List (List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool)) :=\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    |> List.map (λ e => (toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K e, e))\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef htmlOfTable : List (List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool)) → St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K :=\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K110\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p.1 ++ \"</th>\") \"\" (t.head h1)\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K          let txt := toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p.2\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K              ++ bg ++ \"\\\">\" ++ toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p.2 ++ \"</td>\") \"\" ++ \"</tr>\") \"\" t\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef mkTableWidget (t : List (List (St\u001b[01;31m\u001b[Kring\u001b[m\u001b[K × Bool))) :\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  let vnm := p.raw.getId.toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/app/workspace/Library/Tactic/TruthTable.lean\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  | false => throwError (\"Illegal Expression \" ++ (toSt\u001b[01;31m\u001b[Kring\u001b[m\u001b[K p.raw))\r\n"]
[188.755433, "o", "\u001b[?2004hroot@f1c9e15f2b07:/app/workspace# "]
[188.911812, "i", "grep -R \"field_simp\" -n /app/workspace/Library/Tactic\n"]
[188.91214, "o", "grep -R \"field_simp\" -n /app/workspace/Library/Tactic\r\n\u001b[?2004l\r"]
[188.913829, "o", "\u001b[?2004hroot@f1c9e15f2b07:/app/workspace# "]
[223.150139, "i", "sed -n '1,200p' /app/workspace/Library/Tactic/Addarith.lean\n"]
[223.150408, "o", "sed -n '1,200p' /app/workspace/Library/Tactic/Addarith.lean\r\n\u001b[?2004l\r"]
[223.151348, "o", "/-\r\nCopyright (c) 2023 Heather Macbeth. All rights reserved.\r\nReleased under Apache 2.0 license as described in the file LICENSE.\r\nAuthors: Heather Macbeth\r\n-/\r\nimport Mathlib.Tactic.Abel\r\nimport Mathlib.Tactic.Linarith\r\nimport Mathlib.Tactic.NormNum\r\n\r\n/-! # Addarith tactic\r\n\r\nThe tactic `addarith` proves certain linear (in)equality goals over a commutative linear ordered\r\nring, by combining a specified set of linear (in)equality hypotheses.\r\n\r\nThis tactic is a deliberately weakened version of the Mathlib tactic `linarith`.\r\n-/\r\n\r\n"]
[223.151377, "o", "open Lean Elab Tactic\r\nopen Parser Tactic Syntax\r\n\r\nsyntax (name := addarith) \"addarith\" (\" [\" term,* \"]\")? : tactic\r\n\r\nopen Elab.Tactic Parser.Tactic\r\nopen Mathlib Tactic Abel\r\n\r\ndef addarithDischarger : TacticM Unit := do\r\n  try evalTactic (← `(tactic| simp (config := { decide := false }) only [one_mul, neg_mul])) catch _ => pure ()\r\n  abelNFTarget {}\r\n  try evalTactic (← `(tactic| push_cast (config := { decide := false }) [zsmul_eq_mul])) catch _ => pure ()\r\n  try evalTactic (← `(tactic| norm_num1)) catch _ => pure ()\r\n\r\n"]
[223.151423, "o", "/--\r\n`addarith` attempts to use specified linear (in)equality hypotheses to prove a linear (in)equality\r\ngoal.  It can add and subtract terms from both sides of hypotheses, add them together or subtract\r\nthem, and compare numerals.  It cannot rescale hypotheses (i.e., multiply through by a factor).\r\n\r\nAn example:\r\n```lean\r\nexample {a b : ℤ} (h : a = 10 - b) : a + b ≤ 12 := by addarith [h]\r\n```\r\n-/\r\nelab_rules : tactic | `(tactic| addarith $[[$args,*]]?) => withMainContext do\r\n  (liftMetaFinishingTactic <|\r\n    Linarith.linarith true"]
[223.151565, "o", "\r\n      (← ((args.map (TSepArray.getElems)).getD {}).mapM (elabTerm ·.raw none)).toList\r\n      { discharger := addarithDischarger })\r\n  <|> throwError \"addarith failed to prove this\"\r\n\r\n-- while we're at it, this turns off the succeed-with-noise behaviour of `ring_nf` with `ring`\r\nmacro_rules | `(tactic| ring) => `(tactic| ring_nf)\r\n"]
[223.151652, "o", "\u001b[?2004hroot@f1c9e15f2b07:/app/workspace# "]
[223.282606, "i", "sed -n '1,200p' /app/workspace/Library/Tactic/Numbers.lean\n"]
[223.282868, "o", "sed -n '1,200p' /app/workspace/Library/Tactic/Numbers.lean\r\n"]
[223.282899, "o", "\u001b[?2004l\r"]
[223.284149, "o", "import Library.Theory.ModEq.Defs\r\nimport Mathlib.Tactic.NormNum\r\nimport Mathlib.Tactic.Linarith\r\n\r\nopen Lean hiding Rat mkRat\r\nopen Lean.Meta Qq Lean.Elab Term\r\nopen Lean.Parser.Tactic Mathlib.Meta.NormNum\r\n\r\nnamespace Mathlib.Meta.NormNum\r\n\r\n"]
[223.284546, "o", "theorem isInt_ModEq_true : {a b a' b' n : ℤ} → IsInt a a' → IsInt b b' → decide (a' = b') = true →\r\n    Int.ModEq n a b\r\n  | _, _, a', b', n, ⟨rfl⟩, ⟨rfl⟩, hab =>\r\n    by\r\n      dsimp\r\n      replace hab := of_decide_eq_true hab\r\n      rw [hab]\r\n      use 0\r\n      ring\r\n\r\ntheorem isInt_ModEq_false : {a b a' b' n : ℤ} → IsInt a a' → IsInt b b' → decide (0 < n) = true →\r\n    decide (a' < n) = true → decide (b' < n) = true → decide (0 ≤ a') = true →\r\n    decide (0 ≤ b') = true → decide (a' ≠ b') = true → ¬ Int.ModEq n a b\r\n  | _, _, a', b', n, ⟨rfl⟩, ⟨rfl⟩, hn, han, hbn, ha, hb, hab =>\r\n    by\r\n      dsimp\r\n      change ¬ n ∣ _\r\n      replace hn := of_decide_eq_true hn\r\n      replace han := of_decide_eq_true han\r\n      replace hbn := of_decide_eq_true hbn\r\n      replace ha := of_decide_eq_true ha\r\n      replace hb := of_decide_eq_true hb\r\n      replace hab := of_decide_eq_true hab\r\n      rw [← Int.exists_lt_and_lt_iff_not_dvd _ hn]\r\n      cases' lt_or_gt_of_ne hab with hab hab\r\n      · exact ⟨-1, by linarith, by linarith⟩\r\n      · exact ⟨0, by linarith, by linarith⟩\r\n\r\nend Mathlib.Meta.NormNum\r\n\r\n/-- The `norm_num` extension which identifies expressions of the form `a ≡ b [ZMOD n]`,\r\nsuch that `norm_num` successfully recognises both `a` and `b` and they are small compared to `n`. -/\r\n@[norm_num Int.ModEq _ _ _] def evalModEq : NormNumExt where eval (e : Q(Prop)) := do\r\n  let .app (.app (.app f (n : Q(ℤ))) (a : Q(ℤ))) (b : Q(ℤ)) ← whnfR e | failure\r\n  guard <|← withNewMCtxDepth <| isDefEq f q(Int.ModEq)\r\n  let ra : Result a ← derive a\r\n  let rb : Result b ← derive b\r\n  let rn : Result q($n) ← derive n\r\n  let i : Q(Ring ℤ) := q(Int.instRingInt)\r\n  let ⟨za, na, pa⟩ ← ra.toInt\r\n  let ⟨zb, nb, pb⟩ ← rb.toInt\r\n  let ⟨zn, _, _⟩ ← rn.toInt i\r\n  if za = zb then\r\n    -- reduce `a ≡ b [ZMOD n]` to `true` if `a` and `b` reduce to the same integer\r\n    let pab : Q(decide ($na = $nb) = true) := (q(Eq.refl true) : Expr)\r\n    let r : Q(Int.ModEq $n $a $b) := q(isInt_ModEq_true $pa $pb $pab)\r\n    return (.isTrue r : Result q(Int.ModEq $n $a $b))\r\n  else\r\n    -- reduce `a ≡ b [ZMOD n]` to `false` if `0 < n`, `a` reduces to `a'` with `0 ≤ a' < n`,\r\n    -- and `b` reduces to `b'` with `0 ≤ b' < n`\r\n    let pab : Q(decide ($na ≠ $nb) = true) := (q(Eq.refl true) : Expr)\r\n    if zn = 0 then failure\r\n    let pn : Q(decide (0 < $n) = true) := (q(Eq.refl true) : Expr)\r\n    if zn ≤ za then failure\r\n    let pan : Q(decide ($na < $n) = true) := (q(Eq.refl true) : Expr)\r\n    if zn ≤ zb then failure\r\n    let pbn : Q(decide ($nb < $n) = true) := (q(Eq.refl true) : Expr)\r\n    if za < 0 then failure\r\n    let pa0 : Q(decide (0 ≤ $na) = true) := (q(Eq.refl true) : Expr)\r\n    if zb < 0 then failure\r\n    let pb0 : Q(decide (0 ≤ $nb) = true) := (q(Eq.refl true) : Expr)\r\n    let r : Q(¬Int.ModEq $n $a $b) := q(isInt_ModEq_false $pa $pb $pn $pan $pbn $pa0 $pb0 $pab)\r\n    return (.isFalse r : Result q(¬Int.ModEq $n $a $b))\r\n\r\n/--\r\nNormalize numerical expressions. Supports the operations `+` `-` `*` `/` `⁻¹` and `^`\r\nover numerical types such as `ℕ`, `ℤ`, `ℚ`, `ℝ`, `ℂ` and some general algebraic types,\r\nand can prove goals of the form `A = B`, `A ≠ B`, `A < B` and `A ≤ B`, where `A` and `B` are\r\nnumerical expressions.\r\n-/\r\nelab (name := numbers) \"numbers\" loc:(location ?) : tactic =>\r\n  elabNormNum mkNullNode loc (simpOnly := true) (useSimp := false)\r\n\r\ntheorem Prod.ne_left {a1 a2 : A} {b1 b2 : B} : a1 ≠ a2 → (a1, b1) ≠ (a2, b2) := mt <| by\r\n  rw [Prod.mk.inj_iff]\r\n  exact And.left\r\n\r\ntheorem Prod.ne_right {a1 a2 : A} {b1 b2 : B} : b1 ≠ b2 → (a1, b1) ≠ (a2, b2) := mt <| by\r\n  rw [Prod.mk.inj_iff]\r\n  exact And.right\r\n\r\ntheorem Prod.ne_left_right {a1 a2 : A} {b1 b2 : B} {c1 c2 : C} (h : b1 ≠ b2) :\r\n    (a1, b1, c1) ≠ (a2, b2, c2) :=\r\n  Prod.ne_right <| Prod.ne_left h\r\n\r\ntheorem Prod.ne_right_right {a1 a2 : A} {b1 b2 : B} {c1 c2 : C} (h : c1 ≠ c2) :\r\n    (a1, b1, c1) ≠ (a2, b2, c2) :=\r\n  Prod.ne_right <| Prod"]
[223.287409, "o", ".ne_right h\r\n\r\nmacro_rules | `(tactic| numbers) => `(tactic| apply Prod.ext <;> numbers)\r\nmacro_rules | `(tactic| numbers) => `(tactic| apply Prod.ne_left ; numbers)\r\nmacro_rules | `(tactic| numbers) => `(tactic| apply Prod.ne_right ; numbers)\r\nmacro_rules | `(tactic| numbers) => `(tactic| apply Prod.ne_left_right ; numbers)\r\nmacro_rules | `(tactic| numbers) => `(tactic| apply Prod.ne_right_right ; numbers)\r\n\r\nmacro (name := normNumCmd) \"#numbers\" ppSpace e:term : command =>\r\n  `(command| #conv norm_num1 => $e)\r\n\r\nopen Tactic\r\n\r\n@[inherit_doc numbers] syntax (name := numbersConv) \"numbers\" : conv\r\n\r\n/-- Elaborator for `numbers` conv tactic. -/\r\n@[tactic numbersConv] def elabNormNum1Conv : Tactic := fun _ ↦ withMainContext do\r\n  let ctx ← getSimpContext mkNullNode true\r\n  Conv.applySimpResult (← deriveSimp ctx (← instantiateMVars (← Conv.getLhs)) (useSimp := false))\r\n\u001b[?2004hroot@f1c9e15f2b07:/app/workspace# "]
