[74.177019, "o", "                        node[\"speaker\"] = s_parts[0].strip()\r\n\u001b[?2004l\r"]
[74.177036, "o", "\u001b[?2004h> "]
[74.177121, "o", "                        node[\"text\"] = s_parts[1].strip()\r\n\u001b[?2004l\r"]
[74.177138, "o", "\u001b[?2004h> "]
[74.177176, "o", "                    else:\r\n\u001b[?2004l\r"]
[74.177193, "o", "\u001b[?2004h> "]
[74.177269, "o", "                        node[\"text\"] = speaker_text\r\n\u001b[?2004l\r"]
[74.177277, "o", "\u001b[?2004h> "]
[74.17732, "o", "                    \r\n\u001b[?2004l\r"]
[74.177337, "o", "\u001b[?2004h> "]
[74.177386, "o", "                    if target:\r\n\u001b[?2004l\r"]
[74.177415, "o", "\u001b[?2004h> "]
[74.177517, "o", "                        edges.append({\"from\": node_id, \"to\": target, \"text\": \"\"})\r\n\u001b[?2004l\r"]
[74.177534, "o", "\u001b[?2004h> "]
[74.177567, "o", "                else:\r\n\u001b[?2004l\r"]
[74.17759, "o", "\u001b[?2004h> "]
[74.177648, "o", "                    if ':' in line_content:\r\n\u001b[?2004l\r"]
[74.177665, "o", "\u001b[?2004h> "]
[74.177768, "o", "                        s_parts = line_content.split(':', 1)\r\n\u001b[?2004l\r"]
[74.177777, "o", "\u001b[?2004h> "]
[74.177903, "o", "                        node[\"speaker\"] = s_parts[0].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.177986, "o", "                        node[\"text\"] = s_parts[1].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.178004, "o", "> "]
[74.178032, "o", "                    else:\r\n\u001b[?2004l\r"]
[74.178064, "o", "\u001b[?2004h> "]
[74.178123, "o", "                        node[\"text\"] = line_content\r\n\u001b[?2004l\r"]
[74.17814, "o", "\u001b[?2004h> "]
[74.178155, "o", "        \r\n\u001b[?2004l\r"]
[74.178176, "o", "\u001b[?2004h> "]
[74.178209, "o", "        nodes.append(node)\r\n\u001b[?2004l\r"]
[74.17823, "o", "\u001b[?2004h> "]
[74.178276, "o", "        node_dict[node_id] = node\r\n\u001b[?2004l\r"]
[74.178293, "o", "\u001b[?2004h"]
[74.178309, "o", "> \r\n\u001b[?2004l\r"]
[74.178328, "o", "\u001b[?2004h> "]
[74.178388, "o", "    # Ensure all mentioned targets exist as nodes\r\n\u001b[?2004l\r"]
[74.178406, "o", "\u001b[?2004h> "]
[74.178465, "o", "    existing_ids = set(node_dict.keys())\r\n\u001b[?2004l\r"]
[74.178474, "o", "\u001b[?2004h> "]
[74.178578, "o", "    all_targets = set(edge[\"to\"] for edge in edges if edge[\"to\"])\r\n\u001b[?2004l\r"]
[74.178586, "o", "\u001b[?2004h> "]
[74.178639, "o", "    for target in all_targets:\r\n\u001b[?2004l\r"]
[74.178657, "o", "\u001b[?2004h> "]
[74.178711, "o", "        if target not in existing_ids:\r\n\u001b[?2004l\r"]
[74.178727, "o", "\u001b[?2004h> "]
[74.178765, "o", "            new_node = {\r\n\u001b[?2004l\r"]
[74.178782, "o", "\u001b[?2004h> "]
[74.178826, "o", "                \"id\": target,\r\n\u001b[?2004l\r"]
[74.178843, "o", "\u001b[?2004h> "]
[74.178883, "o", "                \"text\": \"\",\r\n\u001b[?2004l\r"]
[74.1789, "o", "\u001b[?2004h> "]
[74.178945, "o", "                \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[74.178963, "o", "\u001b[?2004h> "]
[74.179007, "o", "                \"type\": \"line\"\r\n\u001b[?2004l\r"]
[74.179035, "o", "\u001b[?2004h> "]
[74.179044, "o", "            }\r\n\u001b[?2004l\r"]
[74.179058, "o", "\u001b[?2004h"]
[74.179074, "o", "> "]
[74.179116, "o", "            nodes.append(new_node)\r\n\u001b[?2004l\r"]
[74.179123, "o", "\u001b[?2004h> "]
[74.179186, "o", "            existing_ids.add(target)\r\n\u001b[?2004l\r"]
[74.179194, "o", "\u001b[?2004h> "]
[74.179222, "o", "            \r\n\u001b[?2004l\r"]
[74.17924, "o", "\u001b[?2004h> "]
[74.179306, "o", "    return {\"nodes\": nodes, \"edges\": edges}\r\n\u001b[?2004l\r"]
[74.179322, "o", "\u001b[?2004h> "]
[74.179335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.179356, "o", "def main():\r\n\u001b[?2004l\r"]
[74.179373, "o", "\u001b[?2004h> "]
[74.179439, "o", "    if not os.path.exists('/app/script.txt'):\r\n\u001b[?2004l\r"]
[74.179456, "o", "\u001b[?2004h> "]
[74.179479, "o", "        return\r\n\u001b[?2004l\r"]
[74.179502, "o", "\u001b[?2004h> "]
[74.179559, "o", "    with open('/app/script.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[74.179577, "o", "\u001b[?2004h> "]
[74.179612, "o", "        text = f.read()\r\n\u001b[?2004l\r"]
[74.179629, "o", "\u001b[?2004h> "]
[74.179647, "o", "    \r\n\u001b[?2004l\r"]
[74.179662, "o", "\u001b[?2004h> "]
[74.179703, "o", "    graph = parse_script(text)\r\n\u001b[?2004l\r"]
[74.17971, "o", "\u001b[?2004h"]
[74.179716, "o", ">     \r\n\u001b[?2004l\r"]
[74.179745, "o", "\u001b[?2004h> "]
[74.179806, "o", "    with open('/app/dialogue.json', 'w') as f:\r\n\u001b[?2004l\r"]
[74.179824, "o", "\u001b[?2004h> "]
[74.179878, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r"]
[74.179894, "o", "\u001b[?2004h> "]
[74.179918, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.179995, "o", "    with open('/app/dialogue.dot', 'w') as f:\r\n\u001b[?2004l\r"]
[74.180012, "o", "\u001b[?2004h> "]
[74.180075, "o", "        f.write('digraph dialogue {\\n')\r\n\u001b[?2004l\r"]
[74.180098, "o", "\u001b[?2004h> "]
[74.18014, "o", "        for node in graph['nodes']:\r\n\u001b[?2004l\r"]
[74.180158, "o", "\u001b[?2004h> "]
[74.180228, "o", "            if node['speaker'] and node['text']:\r\n\u001b[?2004l\r"]
[74.180244, "o", "\u001b[?2004h> "]
[74.180337, "o", "                label = f\"{node['speaker']}: {node['text']}\"\r\n\u001b[?2004l\r"]
[74.180345, "o", "\u001b[?2004h> "]
[74.180402, "o", "            elif node['text']:\r\n\u001b[?2004l\r"]
[74.180427, "o", "\u001b[?2004h> "]
[74.180474, "o", "                label = node['text']\r\n\u001b[?2004l\r"]
[74.180491, "o", "\u001b[?2004h> "]
[74.180517, "o", "            else:\r\n\u001b[?2004l\r"]
[74.180534, "o", "\u001b[?2004h> "]
[74.180585, "o", "                label = node['id']\r\n\u001b[?2004l\r"]
[74.180593, "o", "\u001b[?2004h> "]
[74.180669, "o", "            label = label.replace('\"', '\\\\\"')\r\n\u001b[?2004l\r"]
[74.180686, "o", "\u001b[?2004h> "]
[74.180791, "o", "            f.write(f'  \"{node[\"id\"]}\" [label=\"{label}\", shape=box];\\n')\r\n\u001b[?2004l\r"]
[74.180809, "o", "\u001b[?2004h> "]
[74.18083, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.180847, "o", "> "]
[74.18089, "o", "        for edge in graph['edges']:\r\n\u001b[?2004l\r"]
[74.180898, "o", "\u001b[?2004h> "]
[74.18099, "o", "            edge_text = edge['text'].replace('\"', '\\\\\"')\r\n\u001b[?2004l\r"]
[74.181007, "o", "\u001b[?2004h> "]
[74.181132, "o", "            f.write(f'  \"{edge[\"from\"]}\" -> \"{edge[\"to\"]}\" [label=\"{edge_text}\"];\\n')\r\n\u001b[?2004l\r"]
[74.181161, "o", "\u001b[?2004h> "]
[74.181183, "o", "        f.write('}\\n')\r\n\u001b[?2004l\r"]
[74.1812, "o", "\u001b[?2004h> \r\n"]
[74.181217, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.181255, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[74.181276, "o", "\u001b[?2004h> "]
[74.181297, "o", "    main()\r\n\u001b[?2004l\r"]
[74.181314, "o", "\u001b[?2004h> "]
