[395.925748, "o", "\u001b[?2004h> "]
[395.925978, "o", "                        month = month_fixed\r\n\u001b[?2004l\r"]
[395.926016, "o", "\u001b[?2004h> "]
[395.92635, "o", "                if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r"]
[395.92639, "o", "\u001b[?2004h> "]
[395.926629, "o", "                    return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.926666, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.926825, "o", "        # Pattern: DD/MM/YY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927053, "o", "        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927266, "o", "        if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927335, "o", "            day, month, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927566, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h>             month = month.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927695, "o", "            if int(month) > 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.927934, "o", "                month_fixed = month.replace('6', '0').replace('5', '0')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928123, "o", "                if 1 <= int(month_fixed) <= 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928254, "o", "                    month = month_fixed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928506, "o", "            year_full = '20' + year if int(year) < 50 else '19' + year\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928732, "o", "            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928918, "o", "                return f\"{year_full}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.928957, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.929119, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.929234, "o", "def extract_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.929441, "o", "    \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.929592, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[395.929629, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.930009, "o", "    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', \r\n\u001b[?2004l\r\u001b[?2004h"]
[395.930049, "o", "> "]
[395.930379, "o", "                          'DISCOUNT', 'CHANGE', 'CASH TENDERED', 'EXCL', 'SAVING',\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.930419, "o", "> "]
[395.930751, "o", "                          'CASH', 'VISA', 'MASTER', 'CARD', 'TENDER', 'PAYMENT']\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.93079, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.930978, "o", "    # Priority keyword patterns\r\n\u001b[?2004l\r\u001b[?2004h>     priority_patterns = [\r\n\u001b[?2004l\r"]
[395.931016, "o", "\u001b[?2004h> "]
[395.931048, "o", "        r'GRAND\\s*TOTAL',\r\n\u001b[?2004l\r"]
[395.931078, "o", "\u001b[?2004h> "]
[395.931313, "o", "        r'TOTAL\\s*:?\\s*RM',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AMOUNT',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.93135, "o", "> "]
[395.931529, "o", "        r'AMOUNT\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h>         r'BALANCE\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.931564, "o", "        r'NETT\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.931713, "o", "        r'NET\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*ROUNDED',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.931815, "o", "        r'TOTAL\\s*RM\\s*INCL',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.931919, "o", "        r'TOTAL\\s*INCL',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.932023, "o", "        r'TOTAL\\s*AFTER\\s*ADJ',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AFTER\\s*ROUND',\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.932125, "o", ">         r'TOTAL\\s*SALES',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.932236, "o", "        r'(?<!SUB[\\s\\-])TOTAL(?![\\s]*QTY|[\\s]*QUANTITY|[\\s]*ITEM|[\\s]*SAVING|[\\s]*GROSS)',\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93234, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.932448, "o", "    def extract_amount_from_line(line):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93255, "o", "        \"\"\"Extract monetary value from a line.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         # Fix common OCR errors\r\n\u001b[?2004l\r"]
[395.932659, "o", "\u001b[?2004h> "]
[395.932765, "o", "        line_fixed = line.replace('u', '0').replace('U', '0')\r\n\u001b[?2004l\r\u001b[?2004h>         line_fixed = line_fixed.replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.932867, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.932964, "o", "        # Match numbers with decimal point and exactly 2 decimal places\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933056, "o", "        matches = re.findall(r'(\\d+\\.\\d{2})(?!\\d)', line_fixed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933158, "o", "        if matches:\r\n\u001b[?2004l\r\u001b[?2004h>             return matches[-1]\r\n\u001b[?2004l\r"]
[395.933255, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933356, "o", "        # Try original line with comma handling\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933455, "o", "        matches = re.findall(r'([\\d,]+\\.\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r\u001b[?2004h>         if matches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933546, "o", "            amount = matches[-1].replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933709, "o", "            return amount\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[395.93381, "o", "\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.933917, "o", "    def should_exclude(line):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.934017, "o", "        \"\"\"Check if line contains exclusion keywords.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         upper_line = line.upper()"]
[395.934117, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         for kw in exclusion_keywords:\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.934219, "o", ">             if kw in upper_line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93432, "o", "                # But allow if it's TOTAL RM, TOTAL INCL, etc.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.934461, "o", "                if 'TOTAL' in upper_line and kw not in ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'GST', 'TAX', 'EXCL', 'SAVING']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.934566, "o", "> "]
[395.934664, "o", "                    return False\r\n\u001b[?2004l\r\u001b[?2004h>                 return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.934731, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93479, "o", "    # Try each priority pattern\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.934853, "o", "    for pattern in priority_patterns:\r\n\u001b[?2004l\r"]
[395.934921, "o", "\u001b[?2004h> "]
[395.934987, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935045, "o", "            upper_line = line.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935114, "o", "            if re.search(pattern, upper_line, re.IGNORECASE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935203, "o", "                # Skip if it's a GST/tax line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935362, "o", "                if any(kw in upper_line for kw in ['GST', 'TAX', 'SST', '@', '%']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935432, "o", "                    if 'INCL' not in upper_line:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935501, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93556, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935679, "o", "                # Try to extract amount from this line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.935748, "o", "                amount = extract_amount_from_line(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.936379, "o", "                if amount and float(amount) > 0.5:  # Avoid tiny amounts that might be rounding\r\n\u001b[?2004l\r\u001b[?2004h>                     return amount\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 # Fallback: check the next line\r\n\u001b[?2004l\r\u001b[?2004h>                 if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h>                     next_line = lines[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h>                     next_upper = next_line.upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.936489, "o", "> "]
[395.93655, "o", "                    if not any(kw in next_upper for kw in ['GST', 'TAX', 'SST', 'CASH', 'CHANGE', 'VISA', 'MASTER']):\r\n\u001b[?2004l\r"]
[395.936611, "o", "\u001b[?2004h> "]
[395.93668, "o", "                        amount = extract_amount_from_line(next_line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.936794, "o", "                        if amount and float(amount) > 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.936876, "o", "                            return amount\r\n\u001b[?2004l\r"]
[395.93692, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.936963, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937009, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[395.937057, "o", "\u001b[?2004h> "]
[395.937103, "o", "    img_dir = '/app/workspace/dataset/img'\r\n\u001b[?2004l\r"]
[395.937145, "o", "\u001b[?2004h> "]
[395.937202, "o", "    output_file = '/app/workspace/stat_ocr.xlsx'\r\n\u001b[?2004l\r"]
[395.937248, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937424, "o", "    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.93747, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937512, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[395.937567, "o", "\u001b[?2004h> "]
[395.937632, "o", "    for filename in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937729, "o", "        image_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937813, "o", "        print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937873, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937931, "o", "        text = extract_text(image_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.937989, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938042, "o", "        date = extract_date(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938682, "o", "        total_amount = extract_total_amount(text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Date: {date}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Total: {total_amount}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         results.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'filename': filename,\r\n\u001b[?2004l\r\u001b[?2004h>             'date': date,\r\n\u001b[?2004l\r\u001b[?2004h>             'total_amount': total_amount\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938738, "o", "    # Create Excel file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938783, "o", "    wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938825, "o", "    ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.938874, "o", ">     ws.title = 'results'\r\n\u001b[?2004l\r"]
[395.938924, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.938971, "o", "    ws['A1'] = 'filename'\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.939017, "o", ">     ws['B1'] = 'date'\r\n\u001b[?2004l\r"]
[395.939071, "o", "\u001b[?2004h> "]
[395.939117, "o", "    ws['C1'] = 'total_amount'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[395.939164, "o", "\u001b[?2004h> "]
[395.939211, "o", "    for i, result in enumerate(results, start=2):\r\n\u001b[?2004l\r"]
[395.939256, "o", "\u001b[?2004h> "]
[395.939301, "o", "        ws[f'A{i}'] = result['filename']\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.939345, "o", "> "]
[395.939389, "o", "        ws[f'B{i}'] = result['date']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939467, "o", "        ws[f'C{i}'] = result['total_amount']\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.939512, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939558, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939647, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[395.939695, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[395.93974, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939788, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.939833, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[395.961711, "o", "\u001b[?2004hroot@7e3b1f78574d:/app/workspace# "]
