[411.009716, "o", "  Date: 2018-03-23"]
[411.010248, "o", "\r\n"]
[411.010442, "o", "  Total: 10.00"]
[411.010575, "o", "\r\n"]
[411.01071, "o", "Processing 063.jpg..."]
[411.010858, "o", "\r\n"]
[411.811153, "o", "  Date: None"]
[411.811561, "o", "\r\n"]
[411.811736, "o", "  Total: None"]
[411.811873, "o", "\r\n"]
[411.812191, "o", "Processing 064.jpg..."]
[411.812449, "o", "\r\n"]
[412.865219, "o", "  Date: 2018-02-21\r\n  Total: 88.17\r\nProcessing 069.jpg...\r\n"]
[413.627292, "o", "  Date: 2018-02-20\r\n  Total: 9.90\r\nProcessing 071.jpg...\r\n"]
[414.718281, "o", "  Date: 2018-02-19\r\n  Total: 17.76\r\nProcessing 074.jpg...\r\n"]
[415.763962, "o", "  Date: None\r\n  Total: 102.00\r\nProcessing 077.jpg...\r\n"]
[417.266297, "o", "  Date: 2017-10-29\r\n  Total: 21.30\r\nProcessing 078.jpg...\r\n"]
[418.769481, "o", "  Date: 2017-02-02"]
[418.770002, "o", "\r\n  Total: 92.80\r\nProcessing 080.jpg...\r\n"]
[420.374775, "o", "  Date: 2017-09-21"]
[420.375101, "o", "\r\n"]
[420.375242, "o", "  Total: 10.40"]
[420.375351, "o", "\r\n"]
[420.375463, "o", "Processing 083.jpg..."]
[420.375568, "o", "\r\n"]
[422.159935, "o", "  Date: 2017-05-30\r\n  Total: 18.80\r\nProcessing 087.jpg...\r\n"]
[423.378329, "o", "  Date: None\r\n  Total: 538.00\r\nProcessing 088.jpg...\r\n"]
[424.394053, "o", "  Date: None\r\n  Total: 99.80\r\nProcessing 090.jpg...\r\n"]
[426.203392, "o", "  Date: 2017-03-13\r\n  Total: 5.00\r\nProcessing 094.jpg...\r\n"]
[427.342455, "o", "  Date: 2018-02-09\r\n  Total: 5.90\r\nProcessing 097.jpg...\r\n"]
[429.63079, "o", "  Date: 2018-01-12\r\n  Total: 20.98\r\n"]
[429.661909, "o", "\r\n"]
