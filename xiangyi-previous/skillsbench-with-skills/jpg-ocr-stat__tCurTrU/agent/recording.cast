[287.12578, "o", "\u001b[?2004h"]
[287.125861, "o", "> "]
[287.126057, "o", "        return \"\""]
[287.126137, "o", "\r\n"]
[287.126239, "o", "\u001b[?2004l\r"]
[287.126363, "o", "\u001b[?2004h"]
[287.126455, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.126583, "o", "> "]
[287.126753, "o", "def fix_ocr_digits(s):"]
[287.126857, "o", "\r\n"]
[287.126953, "o", "\u001b[?2004l\r\u001b[?2004h"]
[287.127092, "o", "> "]
[287.127351, "o", "    \"\"\"Fix common OCR digit errors.\"\"\""]
[287.127426, "o", "\r\n"]
[287.127474, "o", "\u001b[?2004l\r"]
[287.127547, "o", "\u001b[?2004h"]
[287.127671, "o", "> "]
[287.127853, "o", "    # Common OCR substitutions"]
[287.127904, "o", "\r\n"]
[287.127984, "o", "\u001b[?2004l\r"]
[287.12807, "o", "\u001b[?2004h"]
[287.128174, "o", "> "]
[287.128417, "o", "    s = s.replace('O', '0').replace('o', '0')"]
[287.12847, "o", "\r\n"]
[287.128519, "o", "\u001b[?2004l\r"]
[287.128586, "o", "\u001b[?2004h"]
[287.128654, "o", "> "]
[287.12897, "o", "    s = s.replace('l', '1').replace('I', '1')"]
[287.129023, "o", "\r\n"]
[287.129083, "o", "\u001b[?2004l\r"]
[287.129152, "o", "\u001b[?2004h"]
[287.129214, "o", "> "]
[287.129523, "o", "    s = s.replace('S', '5').replace('s', '5')"]
[287.1296, "o", "\r\n"]
[287.12965, "o", "\u001b[?2004l\r"]
[287.129715, "o", "\u001b[?2004h"]
[287.12977, "o", "> "]
[287.130013, "o", "    s = s.replace('B', '8')"]
[287.130064, "o", "\r\n"]
[287.130115, "o", "\u001b[?2004l\r"]
[287.13018, "o", "\u001b[?2004h"]
[287.130235, "o", "> "]
[287.131565, "o", "    s = s.replace('u', '0').replace('U', '0')\r\n\u001b[?2004l\r\u001b[?2004h>     return s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_date(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract date from OCR text and convert to ISO format.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     month_map = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.133036, "o", "        'jan': '01', 'feb': '02', 'mar': '03', 'apr': '04',\r\n\u001b[?2004l\r\u001b[?2004h>         'may': '05', 'jun': '06', 'jul': '07', 'aug': '08',\r\n\u001b[?2004l\r\u001b[?2004h>         'sep': '09', 'oct': '10', 'nov': '11', 'dec': '12'\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.133279, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.133444, "o", "    for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.133585, "o", "        # Skip lines that are too short\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.134673, "o", "        if len(line.strip()) < 6:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         # Try to fix OCR errors in the line for date parsing\r\n\u001b[?2004l\r\u001b[?2004h>         line_fixed = line\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.134873, "o", "        # Pattern: DD/MM/YYYY or DD-MM-YYYY\r\n\u001b[?2004l\r"]
[287.134958, "o", "\u001b[?2004h> "]
[287.135303, "o", "        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{4})', line)\r\n\u001b[?2004l\r"]
[287.135375, "o", "\u001b[?2004h> "]
[287.135439, "o", "        if match:\r\n\u001b[?2004l\r"]
[287.135504, "o", "\u001b[?2004h> "]
[287.13569, "o", "            day, month, year = match.groups()\r\n\u001b[?2004l\r"]
[287.135752, "o", "\u001b[?2004h> "]
[287.135889, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r"]
[287.135958, "o", "\u001b[?2004h> "]
[287.136177, "o", "            month = month.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.136471, "o", "            # Fix common OCR errors in month (62 -> 02, etc)\r\n\u001b[?2004l\r"]
[287.136537, "o", "\u001b[?2004h> "]
[287.136652, "o", "            if int(month) > 12:\r\n\u001b[?2004l\r"]
[287.136707, "o", "\u001b[?2004h> "]
[287.137051, "o", "                month_fixed = month.replace('6', '0').replace('5', '0')\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.137127, "o", "> "]
[287.137317, "o", "                if 1 <= int(month_fixed) <= 12:\r\n\u001b[?2004l\r"]
[287.137377, "o", "\u001b[?2004h> "]
[287.137604, "o", "                    month = month_fixed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.137967, "o", "            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r"]
[287.138023, "o", "\u001b[?2004h> "]
[287.138235, "o", "                return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
[287.138303, "o", "\u001b[?2004h> "]
[287.138362, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.138418, "o", "> "]
[287.138618, "o", "        # Pattern: DD/MM/YY or DD-MM-YY\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.138672, "o", "> "]
[287.139143, "o", "        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r"]
[287.139193, "o", "\u001b[?2004h> "]
[287.13929, "o", "        if match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.139336, "o", "> "]
[287.139602, "o", "            day, month, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.139643, "o", "> "]
[287.139833, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r"]
[287.139878, "o", "\u001b[?2004h> "]
[287.140066, "o", "            month = month.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.140111, "o", "> "]
[287.140281, "o", "            # Fix common OCR errors\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.140326, "o", "> "]
[287.140373, "o", "            if int(month) > 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.140603, "o", "                month_fixed = month.replace('6', '0').replace('5', '0')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.140764, "o", "                if 1 <= int(month_fixed) <= 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.140881, "o", "                    month = month_fixed\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.140926, "o", "> "]
[287.141047, "o", "            year = '20' + year if int(year) < 50 else '19' + year\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[287.141236, "o", "            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.141359, "o", "                return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.141401, "o", ">         \r\n\u001b[?2004l\r "]
[287.141442, "o", "\u001b[?2004h> "]
[287.141623, "o", "        # Pattern: DDMMYYYY (no separator, like 2032018 for 20/3/2018)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.14165, "o", "> "]
[287.141821, "o", "        match = re.search(r'(\\d{1,2})(\\d{1,2})(\\d{4})', line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.141849, "o", "        if match:\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[287.14245, "o", "            # Try to parse as DMMYYYY or DDMYYYY or DDMMYYYY\r\n\u001b[?2004l\r\u001b[?2004h>             full = match.group(0)\r\n\u001b[?2004l\r\u001b[?2004h>             if len(full) == 7:  # DMMYYYY like 2032018\r\n\u001b[?2004l\r\u001b[?2004h>                 day = full[0:1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.142482, "o", "                month = full[1:2]\r\n\u001b[?2004l\rac\u001b[?2004h> "]
[287.142577, "o", "                year = full[2:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.1426, "o", "> "]
[287.142727, "o", "                if month == '0':  # Try DDMYYYY\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.142751, "o", "> "]
[287.142843, "o", "                    day = full[0:2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.142867, "o", "> "]
[287.14296, "o", "                    month = full[2:3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.142985, "o", "> "]
[287.143081, "o", "                    year = full[3:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143129, "o", "> "]
[287.1432, "o", "            elif len(full) == 8:  # DDMMYYYY\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143246, "o", "> "]
[287.14331, "o", "                day = full[0:2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143353, "o", "> "]
[287.143423, "o", "                month = full[2:4]\r\n\u001b[?2004l\rs\u001b[?2004h"]
[287.143465, "o", "> "]
[287.143524, "o", "                year = full[4:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143567, "o", "> "]
[287.143608, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.143674, "o", "                continue\r\n\u001b[?2004l\r"]
[287.143717, "o", "\u001b[?2004h> "]
[287.143774, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143816, "o", "> "]
[287.143878, "o", "            month = month.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.143923, "o", "> "]
[287.144122, "o", "            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31 and len(year) == 4:\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.144164, "o", "> "]
[287.144265, "o", "                return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.144306, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.144346, "o", "> "]
[287.144414, "o", "        # Pattern: DD MMM YYYY or DD-MMM-YYYY\r\n\u001b[?2004l\rl\u001b[?2004h"]
[287.144456, "o", "> "]
[287.144825, "o", "        match = re.search(r'(\\d{1,2})[\\s\\-\\./]*(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./]*(\\d{4})', line, re.IGNORECASE)\r\n\u001b[?2004l\r"]
[287.144872, "o", "\u001b[?2004h>         if match:\r\n\u001b[?2004l\r"]
[287.144925, "o", "\u001b[?2004h> "]
[287.14505, "o", "            day, month_str, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.145148, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.145266, "o", "            month = month_map[month_str.lower()[:3]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.145385, "o", "            return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.145429, "o", "        \r\n\u001b[?2004l\r= \u001b[?2004h> "]
[287.145497, "o", "        # Pattern: MMM DD, YYYY\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.145538, "o", "> "]
[287.149616, "o", "        match = re.search(r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./]*(\\d{1,2})[,\\s]+(\\d{4})', line, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         if match:\r\n\u001b[?2004l\r\u001b[?2004h>             month_str, day, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h>             day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h>             month = month_map[month_str.lower()[:3]]\r\n\u001b[?2004l\r\u001b[?2004h>             return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Second pass: look for date-like patterns with OCR errors\r\n\u001b[?2004l\r\u001b[?2004h>     for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         # Look for patterns like \"7B 02/18\" which might be date\r\n\u001b[?2004l\r\u001b[?2004h>         match = re.search(r'(\\d{1,2})[A-Za-z]?\\s+(\\d{1,2})[/\\-](\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r\u001b[?2004h>         if match:\r\n\u001b[?2004l\r\u001b[?2004h>             day, month, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h>             day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h>             month = month.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.151585, "o", "            year = '20' + year if int(year) < 50 else '19' + year\r\n\u001b[?2004l\r\u001b[?2004h>             if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r\u001b[?2004h>                 return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED', 'EXCL']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Priority keyword patterns (from most to least specific)\r\n\u001b[?2004l\r\u001b[?2004h>     priority_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h>         (r'GRAND\\s*TOTAL', 1),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'TOTAL\\s*:?\\s*RM', 2),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'TOTAL\\s*AMOUNT', 3),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'TOTAL\\s*DUE', 4),\r\n"]
[287.151619, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[287.151704, "o", "        (r'AMOUNT\\s*DUE', 4),\r\n\u001b[?2004l\r"]
[287.151734, "o", "\u001b[?2004h> "]
[287.151816, "o", "        (r'BALANCE\\s*DUE', 4),\r\n\u001b[?2004l\r"]
[287.151853, "o", "\u001b[?2004h> "]
[287.151928, "o", "        (r'NETT\\s*TOTAL', 4),\r\n\u001b[?2004l\r"]
[287.151962, "o", "\u001b[?2004h> "]
[287.152045, "o", "        (r'NET\\s*TOTAL', 4),\r\n\u001b[?2004l\r"]
[287.152077, "o", "\u001b[?2004h> "]
[287.152165, "o", "        (r'TOTAL\\s*ROUNDED', 5),\r\n\u001b[?2004l\r"]
[287.152196, "o", "\u001b[?2004h> "]
[287.152323, "o", "        (r'TOTAL\\s*RM', 5),\r\n"]
[287.152356, "o", "\u001b[?2004l\r"]
[287.152386, "o", "\u001b[?2004h"]
[287.152417, "o", "> "]
[287.152518, "o", "        (r'TOTAL\\s*INCL', 5),\r\n\u001b[?2004l\r"]
[287.15255, "o", "\u001b[?2004h> "]
[287.152632, "o", "        (r'TOTAL\\s*AFTER', 5),\r\n\u001b[?2004l\r"]
[287.152662, "o", "\u001b[?2004h> "]
[287.152855, "o", "        (r'(?<!SUB)\\s*TOTAL(?!\\s*QTY|\\s*QUANTITY|\\s*ITEM|\\s*SAVING)', 6),\r\n\u001b[?2004l\r"]
[287.15289, "o", "\u001b[?2004h> "]
[287.152953, "o", "        (r'AMOUNT', 7),\r\n\u001b[?2004l\r"]
[287.152986, "o", "\u001b[?2004h> "]
[287.153018, "o", "    ]\r\n\u001b[?2004l\r"]
[287.153059, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.15309, "o", "\u001b[?2004h> "]
[287.153205, "o", "    def extract_amount_from_line(line):\r\n\u001b[?2004l\r"]
[287.153234, "o", "\u001b[?2004h> "]
[287.153378, "o", "        \"\"\"Extract monetary value from a line.\"\"\"\r\n\u001b[?2004l\r"]
[287.153408, "o", "\u001b[?2004h> "]
[287.153491, "o", "        # Fix common OCR errors\r\n\u001b[?2004l\r"]
[287.153522, "o", "\u001b[?2004h> "]
[287.153703, "o", "        line_fixed = line.replace('u', '0').replace('U', '0')\r\n\u001b[?2004l\r"]
[287.153737, "o", "\u001b[?2004h> "]
[287.153939, "o", "        line_fixed = line_fixed.replace(',', '')  # Remove comma separators first\r\n\u001b[?2004l\r"]
[287.153972, "o", "\u001b[?2004h> "]
[287.154005, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.154035, "o", "> "]
[287.154217, "o", "        # Match numbers with decimal point and exactly 2 decimal places\r\n\u001b[?2004l\r"]
[287.154256, "o", "\u001b[?2004h> "]
[287.154426, "o", "        matches = re.findall(r'(\\d+\\.\\d{2})(?!\\d)', line_fixed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.154461, "o", "> "]
[287.154493, "o", "        if matches:\r\n\u001b[?2004l\r"]
[287.154526, "o", "\u001b[?2004h> "]
[287.154732, "o", "            # Return the last match (usually the amount is at the end)\r\n\u001b[?2004l\r"]
[287.154773, "o", "\u001b[?2004h> "]
[287.154832, "o", "            return matches[-1]\r\n\u001b[?2004l\r"]
[287.154863, "o", "\u001b[?2004h> "]
[287.154902, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.154933, "o", "> "]
[287.155046, "o", "        # Try original line with comma handling\r\n\u001b[?2004l\r"]
[287.155076, "o", "\u001b[?2004h> "]
[287.155239, "o", "        matches = re.findall(r'([\\d,]+\\.\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r"]
[287.155274, "o", "\u001b[?2004h> "]
[287.155328, "o", "        if matches:\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.15536, "o", "> "]
[287.155483, "o", "            amount = matches[-1].replace(',', '')\r\n\u001b[?2004l\r"]
[287.155518, "o", "\u001b[?2004h> "]
[287.155583, "o", "            return amount\r\n\u001b[?2004l\r"]
[287.155612, "o", "\u001b[?2004h> "]
[287.155644, "o", "        \r\n\u001b[?2004l\r"]
[287.155673, "o", "\u001b[?2004h> "]
[287.155737, "o", "        return None\r\n\u001b[?2004l\r"]
[287.155768, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.155802, "o", "\u001b[?2004h> "]
[287.155898, "o", "    def should_exclude(line):\r\n\u001b[?2004l\r"]
[287.155929, "o", "\u001b[?2004h> "]
[287.15607, "o", "        \"\"\"Check if line contains exclusion keywords.\"\"\"\r\n\u001b[?2004l\r"]
[287.156103, "o", "\u001b[?2004h> "]
[287.156192, "o", "        upper_line = line.upper()\r\n\u001b[?2004l\r"]
[287.156226, "o", "\u001b[?2004h> "]
[287.156333, "o", "        for kw in exclusion_keywords:\r\n\u001b[?2004l\r"]
[287.156362, "o", "\u001b[?2004h> "]
[287.156451, "o", "            if kw in upper_line:\r\n\u001b[?2004l\r"]
[287.156481, "o", "\u001b[?2004h> "]
[287.156562, "o", "                return True\r\n\u001b[?2004l\r"]
[287.156594, "o", "\u001b[?2004h> "]
[287.15665, "o", "        return False\r\n\u001b[?2004l\r"]
[287.156682, "o", "\u001b[?2004h>     \r\n"]
[287.156712, "o", "\u001b[?2004l\r\u001b[?2004h"]
[287.156742, "o", "> "]
[287.15684, "o", "    # Try each priority pattern in order\r\n\u001b[?2004l\r"]
[287.15687, "o", "\u001b[?2004h> "]
[287.157001, "o", "    for pattern, priority in priority_patterns:\r\n\u001b[?2004l\r"]
[287.157034, "o", "\u001b[?2004h> "]
[287.157133, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[287.157174, "o", "\u001b[?2004h> "]
[287.157259, "o", "            if should_exclude(line):\r\n\u001b[?2004l\r"]
[287.157289, "o", "\u001b[?2004h> "]
[287.157361, "o", "                continue\r\n\u001b[?2004l\r"]
[287.157399, "o", "\u001b[?2004h> "]
[287.1575, "o", "            upper_line = line.upper()\r\n\u001b[?2004l\r"]
[287.157533, "o", "\u001b[?2004h> "]
[287.157691, "o", "            if re.search(pattern, upper_line, re.IGNORECASE):\r\n\u001b[?2004l\r"]
[287.157723, "o", "\u001b[?2004h> "]
[287.157856, "o", "                # Try to extract amount from this line\r\n\u001b[?2004l\r"]
[287.157891, "o", "\u001b[?2004h> "]
[287.158038, "o", "                amount = extract_amount_from_line(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.158072, "o", "> "]
[287.158128, "o", "                if amount:\r\n\u001b[?2004l\r"]
[287.158163, "o", "\u001b[?2004h> "]
[287.158299, "o", "                    return amount\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.158329, "o", "> "]
[287.158427, "o", "                # Fallback: check the next line\r\n\u001b[?2004l\r"]
[287.158461, "o", "\u001b[?2004h> "]
[287.158544, "o", "                if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.158574, "o", "> "]
[287.158659, "o", "                    next_line = lines[i + 1]\r\n\u001b[?2004l\r"]
[287.158688, "o", "\u001b[?2004h> "]
[287.158807, "o", "                    if not should_exclude(next_line):\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.158835, "o", "> "]
[287.158981, "o", "                        amount = extract_amount_from_line(next_line)\r\n\u001b[?2004l\r"]
[287.159018, "o", "\u001b[?2004h> "]
[287.159086, "o", "                        if amount:\r\n\u001b[?2004l\r"]
[287.159116, "o", "\u001b[?2004h> "]
[287.159203, "o", "                            return amount\r\n\u001b[?2004l\r"]
[287.159235, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.159267, "o", "\u001b[?2004h> "]
[287.159325, "o", "    return None\r\n\u001b[?2004l\r"]
[287.159361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[287.159393, "o", "\u001b[?2004h> "]
[287.159422, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.15945, "o", "> "]
[287.159538, "o", "    img_dir = '/app/workspace/dataset/img'\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.159567, "o", "> "]
[287.159675, "o", "    output_file = '/app/workspace/stat_ocr.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.159708, "o", ">     \r\n\u001b[?2004l\r"]
[287.15974, "o", "\u001b[?2004h> "]
[287.15983, "o", "    # Get all jpg files sorted by filename\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.15986, "o", "> "]
[287.160056, "o", "    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\r\n\u001b[?2004l\r"]
[287.160085, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.160119, "o", "\u001b[?2004h> "]
[287.160158, "o", "    results = []\r\n\u001b[?2004l\r"]
[287.16019, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.160223, "o", "\u001b[?2004h> "]
[287.160289, "o", "    for filename in files:\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.160319, "o", "> "]
[287.160419, "o", "        image_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r"]
[287.160452, "o", "\u001b[?2004h> "]
[287.16054, "o", "        print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.16057, "o", "        \r\n\u001b[?2004l\r"]
[287.160598, "o", "\u001b[?2004h> "]
[287.160682, "o", "        text = extract_text(image_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.160712, "o", ">         \r\n\u001b[?2004l\r"]
[287.160743, "o", "\u001b[?2004h> "]
[287.160834, "o", "        date = extract_date(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.160875, "o", "> "]
[287.160957, "o", "        total_amount = extract_total_amount(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.160989, "o", ">         \r\n\u001b[?2004l\r"]
[287.161019, "o", "\u001b[?2004h> "]
[287.161094, "o", "        print(f\"  Date: {date}\")\r\n\u001b[?2004l\r"]
[287.161125, "o", "\u001b[?2004h> "]
[287.161212, "o", "        print(f\"  Total: {total_amount}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.161245, "o", ">         \r\n\u001b[?2004l\r"]
[287.161278, "o", "\u001b[?2004h> "]
[287.161335, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.161365, "o", "> "]
[287.161423, "o", "            'filename': filename,\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.161454, "o", "> "]
[287.161508, "o", "            'date': date,\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.161544, "o", "> "]
[287.193781, "o", "            'total_amount': total_amount\r\n\u001b[?2004l\r"]
[287.193844, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[287.193878, "o", "\u001b[?2004h> "]
[287.193917, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.193952, "o", "> "]
[287.193981, "o", "    # Create Excel file\r\n\u001b[?2004l\r"]
[287.194009, "o", "\u001b[?2004h> "]
[287.194079, "o", "    wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.194115, "o", "> "]
[287.194155, "o", "    ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.194189, "o", "> "]
[287.194225, "o", "    ws.title = 'results'\r\n\u001b[?2004l\r"]
[287.194262, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[287.194297, "o", "\u001b[?2004h> "]
[287.194352, "o", "    # Write header\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.194389, "o", "> "]
[287.194427, "o", "    ws['A1'] = 'filename'\r\n\u001b[?2004l\r"]
[287.194462, "o", "\u001b[?2004h> "]
[287.194497, "o", "    ws['B1'] = 'date'\r\n\u001b[?2004l\r"]
[287.194531, "o", "\u001b[?2004h> "]
[287.194603, "o", "    ws['C1'] = 'total_amount'\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.194641, "o", ">     \r\n\u001b[?2004l\r"]
[287.194675, "o", "\u001b[?2004h> "]
[287.19471, "o", "    # Write data\r\n\u001b[?2004l\r"]
[287.194747, "o", "\u001b[?2004h> "]
[287.194856, "o", "    for i, result in enumerate(results, start=2):\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.19489, "o", "> "]
[287.194969, "o", "        ws[f'A{i}'] = result['filename']\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195006, "o", "> "]
[287.195078, "o", "        ws[f'B{i}'] = result['date']\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195112, "o", "> "]
[287.195205, "o", "        ws[f'C{i}'] = result['total_amount']\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195241, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195278, "o", "> "]
[287.195328, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195364, "o", "> "]
[287.195462, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195498, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195531, "o", "> "]
[287.195584, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.195623, "o", ">     main()\r\n\u001b[?2004l\r"]
[287.195659, "o", "\u001b[?2004h> "]
[287.195697, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[287.238086, "o", "\u001b[?2004hroot@7e3b1f78574d:/app/workspace# "]
