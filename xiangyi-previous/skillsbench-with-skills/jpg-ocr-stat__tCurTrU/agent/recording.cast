[529.04322, "o", "\u001b[?2004h> "]
[529.043449, "o", "                    if 1 <= int(month) <= 12 and 1 <= int(day) <= 31 and 2000 <= int(year) <= 2030:\r\n\u001b[?2004l\r\u001b[?2004h"]
[529.043508, "o", "> "]
[529.043605, "o", "                        return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
