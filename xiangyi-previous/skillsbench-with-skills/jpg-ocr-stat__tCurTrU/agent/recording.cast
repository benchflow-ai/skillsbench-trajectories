[38.330917, "i", "cat > /app/workspace/ocr_receipts.py << 'EOF'\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image\nimport openpyxl\nfrom openpyxl import Workbook\n\ndef extract_text(image_path):\n    \"\"\"Extract text from image using pytesseract.\"\"\"\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        return text\n    except Exception as e:\n        print(f\"Error processing {image_path}: {e}\")\n        return \"\"\n\ndef extract_date(text):\n    \"\"\"Extract date from OCR text and convert to ISO format.\"\"\"\n    # Common date patterns\n    patterns = [\n        # DD/MM/YYYY or DD-MM-YYYY\n        r'(\\d{1,2})[/\\-](\\d{1,2})[/\\-](\\d{4})',\n        # DD/MM/YY or DD-MM-YY\n        r'(\\d{1,2})[/\\-](\\d{1,2})[/\\-](\\d{2})(?!\\d)',\n        # YYYY/MM/DD or YYYY-MM-DD\n        r'(\\d{4})[/\\-](\\d{1,2})[/\\-](\\d{1,2})',\n        # DD MMM YYYY or DD-MMM-YYYY (e.g., 01 Jan 2024)\n        r'(\\d{1,2})[\\s\\-](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{4})',\n        # MMM DD, YYYY\n        r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{1,2})[,\\s]+(\\d{4})',\n    ]\n    \n    month_map = {\n        'jan': '01', 'feb': '02', 'mar': '03', 'apr': '04',\n        'may': '05', 'jun': '06', 'jul': '07', 'aug': '08',\n        'sep': '09', 'oct': '10', 'nov': '11', 'dec': '12'\n    }\n    \n    lines = text.split('\\n')\n    for line in lines:\n        line_lower = line.lower()\n        \n        # Pattern 1: DD/MM/YYYY or DD-MM-YYYY\n        match = re.search(r'(\\d{1,2})[/\\-](\\d{1,2})[/\\-](\\d{4})', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year}-{month}-{day}\"\n        \n        # Pattern 2: DD/MM/YY or DD-MM-YY\n        match = re.search(r'(\\d{1,2})[/\\-](\\d{1,2})[/\\-](\\d{2})(?!\\d)', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            year = '20' + year if int(year) < 50 else '19' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year}-{month}-{day}\"\n        \n        # Pattern 3: YYYY/MM/DD or YYYY-MM-DD\n        match = re.search(r'(\\d{4})[/\\-](\\d{1,2})[/\\-](\\d{1,2})', line)\n        if match:\n            year, month, day = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year}-{month}-{day}\"\n        \n        # Pattern 4: DD MMM YYYY\n        match = re.search(r'(\\d{1,2})[\\s\\-](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{4})', line, re.IGNORECASE)\n        if match:\n            day, month_str, year = match.groups()\n            day = day.zfill(2)\n            month = month_map[month_str.lower()[:3]]\n            return f\"{year}-{month}-{day}\"\n        \n        # Pattern 5: MMM DD, YYYY\n        match = re.search(r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{1,2})[,\\s]+(\\d{4})', line, re.IGNORECASE)\n        if match:\n            month_str, day, year = match.groups()\n            day = day.zfill(2)\n            month = month_map[month_str.lower()[:3]]\n            return f\"{year}-{month}-{day}\"\n    \n    return None\n\ndef extract_total_amount(text):\n    \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\n    lines = text.split('\\n')\n    \n    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\n    \n    # Priority keyword patterns (from most to least specific)\n    priority_patterns = [\n        r'GRAND\\s*TOTAL',\n        r'TOTAL\\s*:?\\s*RM',\n        r'TOTAL\\s*AMOUNT',\n        r'TOTAL\\s*DUE|AMOUNT\\s*DUE|BALANCE\\s*DUE|NETT\\s*TOTAL|NET\\s*TOTAL|TOTAL|AMOUNT'\n    ]\n    \n    def extract_amount_from_line(line):\n        \"\"\"Extract monetary value from a line.\"\"\"\n        # Match numbers with optional comma separators and decimal point\n        # Patterns like: 1,234.56 or 123.45 or RM 123.45\n        m"]
[38.330991, "i", "atches = re.findall(r'[\\d,]+\\.\\d{2}', line)\n        if matches:\n            # Return the last match (usually the amount is at the end)\n            amount = matches[-1].replace(',', '')\n            return amount\n        return None\n    \n    def should_exclude(line):\n        \"\"\"Check if line contains exclusion keywords.\"\"\"\n        upper_line = line.upper()\n        for kw in exclusion_keywords:\n            if kw in upper_line:\n                return True\n        return False\n    \n    # Try each priority pattern\n    for pattern in priority_patterns:\n        for i, line in enumerate(lines):\n            if should_exclude(line):\n                continue\n            upper_line = line.upper()\n            if re.search(pattern, upper_line, re.IGNORECASE):\n                # Try to extract amount from this line\n                amount = extract_amount_from_line(line)\n                if amount:\n                    return amount\n                # Fallback: check the next line\n                if i + 1 < len(lines):\n                    next_line = lines[i + 1]\n                    if not should_exclude(next_line):\n                        amount = extract_amount_from_line(next_line)\n                        if amount:\n                            return amount\n    \n    return None\n\ndef main():\n    img_dir = '/app/workspace/dataset/img'\n    output_file = '/app/workspace/stat_ocr.xlsx'\n    \n    # Get all jpg files sorted by filename\n    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\n    \n    results = []\n    \n    for filename in files:\n        image_path = os.path.join(img_dir, filename)\n        print(f\"Processing {filename}...\")\n        \n        text = extract_text(image_path)\n        print(f\"OCR Text for {filename}:\")\n        print(text[:500] if len(text) > 500 else text)\n        print(\"-\" * 50)\n        \n        date = extract_date(text)\n        total_amount = extract_total_amount(text)\n        \n        print(f\"  Date: {date}\")\n        print(f\"  Total: {total_amount}\")\n        print(\"=\" * 50)\n        \n        results.append({\n            'filename': filename,\n            'date': date,\n            'total_amount': total_amount\n        })\n    \n    # Create Excel file\n    wb = Workbook()\n    ws = wb.active\n    ws.title = 'results'\n    \n    # Write header\n    ws['A1'] = 'filename'\n    ws['B1'] = 'date'\n    ws['C1'] = 'total_amount'\n    \n    # Write data\n    for i, result in enumerate(results, start=2):\n        ws[f'A{i}'] = result['filename']\n        ws[f'B{i}'] = result['date']\n        ws[f'C{i}'] = result['total_amount']\n    \n    wb.save(output_file)\n    print(f\"\\nResults saved to {output_file}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
[38.331244, "o", "cat > /app/workspace/ocr_receipts.py << 'EOF'"]
