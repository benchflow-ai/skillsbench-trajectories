[529.040952, "o", "\u001b[?2004h> "]
[529.041321, "o", "                    if 1 <= int(month) <= 9 and 1 <= int(day) <= 31 and 2000 <= int(year) <= 2030:\r\n\u001b[?2004l\r\u001b[?2004h"]
[529.041417, "o", "> "]
[529.041641, "o", "                        return f\"{year}-0{month}-{day}\"\r\n"]
[529.041722, "o", "\u001b[?2004l\r"]
