[395.892205, "i", "cat > /app/workspace/ocr_receipts_v3.py << 'ENDOFSCRIPT'\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image\nfrom openpyxl import Workbook\n\ndef extract_text(image_path):\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        return text\n    except Exception as e:\n        print(f\"Error processing {image_path}: {e}\")\n        return \"\"\n\ndef extract_date(text):\n    \"\"\"Extract date from OCR text and convert to ISO format.\"\"\"\n    month_map = {\n        'jan': '01', 'feb': '02', 'mar': '03', 'apr': '04',\n        'may': '05', 'jun': '06', 'jul': '07', 'aug': '08',\n        'sep': '09', 'oct': '10', 'nov': '11', 'dec': '12'\n    }\n    \n    lines = text.split('\\n')\n    \n    # First pass: look for lines with date keywords\n    for i, line in enumerate(lines):\n        upper_line = line.upper()\n        # Skip lines with company/GST/registration numbers\n        if any(kw in upper_line for kw in ['GST', 'REG', 'COMPANY', 'SDN', 'BHD', 'NO.', 'NO:']):\n            if 'DATE' not in upper_line:\n                continue\n        \n        # Look for date keyword\n        has_date_keyword = 'DATE' in upper_line or 'TARIKH' in upper_line\n        \n        # Pattern: DD/MM/YYYY or DD-MM-YYYY or DD.MM.YYYY\n        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{4})', line)\n        if match:\n            day, month, year = match.groups()\n            # Validate year is reasonable (2000-2030)\n            if not (2000 <= int(year) <= 2030):\n                continue\n            day = day.zfill(2)\n            month = month.zfill(2)\n            # Fix OCR errors in month\n            if int(month) > 12:\n                month_fixed = month.replace('6', '0').replace('5', '0')\n                if 1 <= int(month_fixed) <= 12:\n                    month = month_fixed\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year}-{month}-{day}\"\n        \n        # Pattern: DD/MM/YY or DD-MM-YY\n        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d)', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            # Fix OCR errors\n            if int(month) > 12:\n                month_fixed = month.replace('6', '0').replace('5', '0')\n                if 1 <= int(month_fixed) <= 12:\n                    month = month_fixed\n            year_full = '20' + year if int(year) < 50 else '19' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year_full}-{month}-{day}\"\n        \n        # Pattern: DD MMM YYYY\n        match = re.search(r'(\\d{1,2})[\\s\\-\\./:](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./:](\\d{4})', line, re.IGNORECASE)\n        if match:\n            day, month_str, year = match.groups()\n            if 2000 <= int(year) <= 2030:\n                day = day.zfill(2)\n                month = month_map[month_str.lower()[:3]]\n                return f\"{year}-{month}-{day}\"\n    \n    # Second pass: look for standalone date patterns (more permissive)\n    for line in lines:\n        upper_line = line.upper()\n        # Skip company/registration lines\n        if any(kw in upper_line for kw in ['GST NO', 'REG NO', 'COMPANY', 'SDN BHD', '(-', '-M)', '-W)', '-K)', '-V)', '-D)', '-A)', '-T)', '-X)']):\n            continue\n        \n        # Pattern: DD/MM/YYYY\n        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{4})', line)\n        if match:\n            day, month, year = match.groups()\n            if 2000 <= int(year) <= 2030:\n                day = day.zfill(2)\n                month = month.zfill(2)\n                if int(month) > 12:\n                    month_fixed = month.replace('6', '0').replace('5', '0')\n                    if 1 <= int(month_fixed) <= 12:\n                        month = month_fixed\n                if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                    return f\"{year}-{month}-{day}\"\n        \n        # Pattern: DD/MM/YY\n        match = re.search(r'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d"]
[395.892467, "i", ")', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            if int(month) > 12:\n                month_fixed = month.replace('6', '0').replace('5', '0')\n                if 1 <= int(month_fixed) <= 12:\n                    month = month_fixed\n            year_full = '20' + year if int(year) < 50 else '19' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f\"{year_full}-{month}-{day}\"\n    \n    return None\n\ndef extract_total_amount(text):\n    \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\n    lines = text.split('\\n')\n    \n    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', \n                          'DISCOUNT', 'CHANGE', 'CASH TENDERED', 'EXCL', 'SAVING',\n                          'CASH', 'VISA', 'MASTER', 'CARD', 'TENDER', 'PAYMENT']\n    \n    # Priority keyword patterns\n    priority_patterns = [\n        r'GRAND\\s*TOTAL',\n        r'TOTAL\\s*:?\\s*RM',\n        r'TOTAL\\s*AMOUNT',\n        r'TOTAL\\s*DUE',\n        r'AMOUNT\\s*DUE',\n        r'BALANCE\\s*DUE',\n        r'NETT\\s*TOTAL',\n        r'NET\\s*TOTAL',\n        r'TOTAL\\s*ROUNDED',\n        r'TOTAL\\s*RM\\s*INCL',\n        r'TOTAL\\s*INCL',\n        r'TOTAL\\s*AFTER\\s*ADJ',\n        r'TOTAL\\s*AFTER\\s*ROUND',\n        r'TOTAL\\s*SALES',\n        r'(?<!SUB[\\s\\-])TOTAL(?![\\s]*QTY|[\\s]*QUANTITY|[\\s]*ITEM|[\\s]*SAVING|[\\s]*GROSS)',\n    ]\n    \n    def extract_amount_from_line(line):\n        \"\"\"Extract monetary value from a line.\"\"\"\n        # Fix common OCR errors\n        line_fixed = line.replace('u', '0').replace('U', '0')\n        line_fixed = line_fixed.replace(',', '')\n        \n        # Match numbers with decimal point and exactly 2 decimal places\n        matches = re.findall(r'(\\d+\\.\\d{2})(?!\\d)', line_fixed)\n        if matches:\n            return matches[-1]\n        \n        # Try original line with comma handling\n        matches = re.findall(r'([\\d,]+\\.\\d{2})(?!\\d)', line)\n        if matches:\n            amount = matches[-1].replace(',', '')\n            return amount\n        \n        return None\n    \n    def should_exclude(line):\n        \"\"\"Check if line contains exclusion keywords.\"\"\"\n        upper_line = line.upper()\n        for kw in exclusion_keywords:\n            if kw in upper_line:\n                # But allow if it's TOTAL RM, TOTAL INCL, etc.\n                if 'TOTAL' in upper_line and kw not in ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'GST', 'TAX', 'EXCL', 'SAVING']:\n                    return False\n                return True\n        return False\n    \n    # Try each priority pattern\n    for pattern in priority_patterns:\n        for i, line in enumerate(lines):\n            upper_line = line.upper()\n            if re.search(pattern, upper_line, re.IGNORECASE):\n                # Skip if it's a GST/tax line\n                if any(kw in upper_line for kw in ['GST', 'TAX', 'SST', '@', '%']):\n                    if 'INCL' not in upper_line:\n                        continue\n                \n                # Try to extract amount from this line\n                amount = extract_amount_from_line(line)\n                if amount and float(amount) > 0.5:  # Avoid tiny amounts that might be rounding\n                    return amount\n                \n                # Fallback: check the next line\n                if i + 1 < len(lines):\n                    next_line = lines[i + 1]\n                    next_upper = next_line.upper()\n                    if not any(kw in next_upper for kw in ['GST', 'TAX', 'SST', 'CASH', 'CHANGE', 'VISA', 'MASTER']):\n                        amount = extract_amount_from_line(next_line)\n                        if amount and float(amount) > 0.5:\n                            return amount\n    \n    return None\n\ndef main():\n    img_dir = '/app/workspace/dataset/img'\n    output_file = '/app/workspace/stat_ocr.xlsx'\n    \n    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\n    \n    results = []\n    \n    for filename in files:\n        image_path ="]
[395.892588, "i", " os.path.join(img_dir, filename)\n        print(f\"Processing {filename}...\")\n        \n        text = extract_text(image_path)\n        \n        date = extract_date(text)\n        total_amount = extract_total_amount(text)\n        \n        print(f\"  Date: {date}\")\n        print(f\"  Total: {total_amount}\")\n        \n        results.append({\n            'filename': filename,\n            'date': date,\n            'total_amount': total_amount\n        })\n    \n    # Create Excel file\n    wb = Workbook()\n    ws = wb.active\n    ws.title = 'results'\n    \n    ws['A1'] = 'filename'\n    ws['B1'] = 'date'\n    ws['C1'] = 'total_amount'\n    \n    for i, result in enumerate(results, start=2):\n        ws[f'A{i}'] = result['filename']\n        ws[f'B{i}'] = result['date']\n        ws[f'C{i}'] = result['total_amount']\n    \n    wb.save(output_file)\n    print(f\"\\nResults saved to {output_file}\")\n\nif __name__ == '__main__':\n    main()\nENDOFSCRIPT\n"]
