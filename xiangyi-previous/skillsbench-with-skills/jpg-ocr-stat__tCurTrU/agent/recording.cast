[529.04483, "o", "def extract_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.044956, "o", "    \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.045011, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.045057, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.0451, "o", "    def extract_amount_from_line(line):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.045173, "o", "        \"\"\"Extract monetary value from a line.\"\"\"\r\n\u001b[?2004l\r"]
[529.045232, "o", "\u001b[?2004h> "]
[529.045349, "o", "        line_fixed = line.replace('u', '0').replace('U', '0').replace('O', '0').replace('o', '0')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.045429, "o", "        line_fixed = line_fixed.replace(',', '')\r\n\u001b[?2004l\r"]
[529.045485, "o", "\u001b[?2004h> "]
[529.045573, "o", "        matches = re.findall(r'(\\d+\\.\\d{2})(?!\\d)', line_fixed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[529.045621, "o", "        if matches:\r\n\u001b[?2004l\r"]
[529.045646, "o", "\u001b[?2004h> "]
[529.049645, "o", "            return matches[-1]\r\n\u001b[?2004l\r\u001b[?2004h>         matches = re.findall(r'([\\d,]+\\.\\d{2})(?!\\d)', line)\r\n\u001b[?2004l\r\u001b[?2004h>         if matches:\r\n\u001b[?2004l\r\u001b[?2004h>             return matches[-1].replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def is_exclusion_line(line):\r\n\u001b[?2004l\r\u001b[?2004h>         upper = line.upper()\r\n\u001b[?2004l\r\u001b[?2004h>         exclusions = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'CASH', 'CHANGE', 'VISA', 'MASTER', \r\n\u001b[?2004l\r\u001b[?2004h>                       'PAYMENT', 'TENDER', 'EXCL', 'SAVING', 'DISCOUNT', 'ROUNDING']\r\n\u001b[?2004l\r\u001b[?2004h>         for ex in exclusions:\r\n\u001b[?2004l\r\u001b[?2004h>             if ex in upper:\r\n\u001b[?2004l\r\u001b[?2004h>                 return True\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Priority patterns for total\r\n\u001b[?2004l\r\u001b[?2004h>     priority_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h>         r'GRAND\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*:?\\s*RM',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AMOUNT',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h>         r'AMOUNT\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h>         r'BALANCE\\s*DUE',\r\n\u001b[?2004l\r\u001b[?2004h>         r'NETT\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'NET\\s*TOTAL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL.*INCL',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL.*INEL',  # OCR error for INCL\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*ROUNDED',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AMT\\s*ROUNDED',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*AFTER',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*SALES',\r\n\u001b[?2004l\r\u001b[?2004h>         r'TOTAL\\s*RM',\r\n\u001b[?2004l\r\u001b[?2004h>         r'(?<!SUB)(?<!SUB-)(?<!SUB )TOTAL(?!\\s*QTY|\\s*QUANTITY|\\s*ITEM|\\s*SAVING|\\s*GROSS|\\s*EXCL)',\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
