[38.350274, "o", "\u001b[?2004h> "]
[38.350394, "o", "                return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
[38.350473, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.350549, "o", "> "]
[38.350679, "o", "        # Pattern 3: YYYY/MM/DD or YYYY-MM-DD\r\n\u001b[?2004l\r"]
[38.350751, "o", "\u001b[?2004h> "]
[38.351025, "o", "        match = re.search(r'(\\d{4})[/\\-](\\d{1,2})[/\\-](\\d{1,2})', line)\r\n\u001b[?2004l\r"]
[38.351119, "o", "\u001b[?2004h> "]
[38.351148, "o", "        if match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.351235, "o", "> "]
[38.351368, "o", "            year, month, day = match.groups()\r\n\u001b[?2004l\r"]
[38.351485, "o", "\u001b[?2004h> "]
[38.351545, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r"]
[38.351567, "o", "\u001b[?2004h> "]
[38.351724, "o", "            month = month.zfill(2)\r\n\u001b[?2004l\r"]
[38.351749, "o", "\u001b[?2004h> "]
[38.352007, "o", "            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\r\n\u001b[?2004l\r"]
[38.352053, "o", "\u001b[?2004h> "]
[38.352232, "o", "                return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
[38.35227, "o", "\u001b[?2004h> "]
[38.352398, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.352462, "o", "> "]
[38.352486, "o", "        # Pattern 4: DD MMM YYYY\r\n\u001b[?2004l\r"]
[38.352509, "o", "\u001b[?2004h> "]
[38.352989, "o", "        match = re.search(r'(\\d{1,2})[\\s\\-](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{4})', line, re.IGNORECASE)\r\n\u001b[?2004l\r"]
[38.353059, "o", "\u001b[?2004h> "]
[38.353108, "o", "        if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.353192, "o", "            day, month_str, year = match.groups()\r\n\u001b[?2004l\r"]
[38.353238, "o", "\u001b[?2004h> "]
[38.353287, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.353407, "o", "            month = month_map[month_str.lower()[:3]]\r\n\u001b[?2004l\r"]
[38.353454, "o", "\u001b[?2004h> "]
[38.353507, "o", "            return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
[38.353534, "o", "\u001b[?2004h> "]
[38.353638, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.353713, "o", "        # Pattern 5: MMM DD, YYYY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.353977, "o", "        match = re.search(r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-](\\d{1,2})[,\\s]+(\\d{4})', line, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.354059, "o", ">         if match:\r\n\u001b[?2004l\r"]
[38.354127, "o", "\u001b[?2004h> "]
[38.354194, "o", "            month_str, day, year = match.groups()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.35425, "o", "            day = day.zfill(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.354372, "o", "            month = month_map[month_str.lower()[:3]]\r\n\u001b[?2004l\r"]
[38.354434, "o", "\u001b[?2004h> "]
[38.354511, "o", "            return f\"{year}-{month}-{day}\"\r\n\u001b[?2004l\r"]
[38.354542, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.35457, "o", "> "]
[38.354702, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[38.354759, "o", "\u001b[?2004h> def extract_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.354902, "o", "    \"\"\"Extract total amount from OCR text based on priority keywords.\"\"\"\r\n\u001b[?2004l\r"]
[38.354934, "o", "\u001b[?2004h> "]
[38.355005, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.355082, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.355289, "o", "    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\r\n\u001b[?2004l\r"]
[38.355319, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[38.355405, "o", "\u001b[?2004h> "]
[38.355492, "o", "    # Priority keyword patterns (from most to least specific)\r\n\u001b[?2004l\r"]
[38.355552, "o", "\u001b[?2004h> "]
[38.355582, "o", "    priority_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.355648, "o", "        r'GRAND\\s*TOTAL',\r\n\u001b[?2004l\r"]
[38.355677, "o", "\u001b[?2004h> "]
[38.355744, "o", "        r'TOTAL\\s*:?\\s*RM',\r\n\u001b[?2004l\r"]
[38.355772, "o", "\u001b[?2004h> "]
[38.355838, "o", "        r'TOTAL\\s*AMOUNT',\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.355873, "o", "> "]
[38.356051, "o", "        r'TOTAL\\s*DUE|AMOUNT\\s*DUE|BALANCE\\s*DUE|NETT\\s*TOTAL|NET\\s*TOTAL|TOTAL|AMOUNT'\r\n\u001b[?2004l\r"]
[38.35608, "o", "\u001b[?2004h>     ]\r\n"]
[38.356193, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.356257, "o", "    def extract_amount_from_line(line):\r\n\u001b[?2004l\r"]
[38.356308, "o", "\u001b[?2004h> "]
[38.356384, "o", "        \"\"\"Extract monetary value from a line.\"\"\"\r\n\u001b[?2004l\r"]
[38.356438, "o", "\u001b[?2004h> "]
[38.356559, "o", "        # Match numbers with optional comma separators and decimal point\r\n\u001b[?2004l\r"]
[38.356616, "o", "\u001b[?2004h> "]
[38.356696, "o", "        # Patterns like: 1,234.56 or 123.45 or RM 123.45\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.35675, "o", "> "]
[38.356824, "o", "        matches = re.findall(r'[\\d,]+\\.\\d{2}', line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.356894, "o", "> "]
[38.356945, "o", "        if matches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.357057, "o", "            # Return the last match (usually the amount is at the end)\r\n\u001b[?2004l\r"]
[38.357119, "o", "\u001b[?2004h> "]
[38.357179, "o", "            amount = matches[-1].replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.357209, "o", "> "]
[38.357278, "o", "            return amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.357339, "o", "        return None\r\n\u001b[?2004l\r"]
[38.357372, "o", "\u001b[?2004h>     \r\n"]
[38.357402, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[38.357485, "o", "    def should_exclude(line):\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.357515, "o", "> "]
[38.357658, "o", "        \"\"\"Check if line contains exclusion keywords.\"\"\"\r\n\u001b[?2004l\r"]
[38.357715, "o", "\u001b[?2004h> "]
[38.357763, "o", "        upper_line = line.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.357838, "o", "        for kw in exclusion_keywords:\r\n\u001b[?2004l\r"]
[38.357865, "o", "\u001b[?2004h> "]
[38.357944, "o", "            if kw in upper_line:\r\n\u001b[?2004l\r"]
[38.358021, "o", "\u001b[?2004h> "]
[38.358072, "o", "                return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.358133, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[38.358159, "o", "\u001b[?2004h> "]
[38.35824, "o", "    # Try each priority pattern\r\n\u001b[?2004l\r"]
[38.358269, "o", "\u001b[?2004h> "]
[38.358357, "o", "    for pattern in priority_patterns:\r\n\u001b[?2004l\r"]
[38.358428, "o", "\u001b[?2004h> "]
[38.358483, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.358527, "o", "> "]
[38.358575, "o", "            if should_exclude(line):\r\n\u001b[?2004l\r"]
[38.358602, "o", "\u001b[?2004h> "]
[38.358659, "o", "                continue\r\n\u001b[?2004l\r"]
[38.358685, "o", "\u001b[?2004h> "]
[38.358778, "o", "            upper_line = line.upper()\r\n\u001b[?2004l\r"]
[38.358805, "o", "\u001b[?2004h> "]
[38.358955, "o", "            if re.search(pattern, upper_line, re.IGNORECASE):\r\n\u001b[?2004l\r"]
[38.359055, "o", "\u001b[?2004h> "]
[38.359135, "o", "                # Try to extract amount from this line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.359245, "o", "                amount = extract_amount_from_line(line)\r\n\u001b[?2004l\r"]
[38.359276, "o", "\u001b[?2004h> "]
[38.359346, "o", "                if amount:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.359434, "o", "                    return amount\r\n\u001b[?2004l\r"]
[38.359469, "o", "\u001b[?2004h> "]
[38.359567, "o", "                # Fallback: check the next line\r\n\u001b[?2004l\r"]
[38.359597, "o", "\u001b[?2004h> "]
[38.359684, "o", "                if i + 1 < len(lines):\r\n\u001b[?2004l\r"]
[38.359714, "o", "\u001b[?2004h> "]
[38.359812, "o", "                    next_line = lines[i + 1]\r\n\u001b[?2004l\r"]
[38.359841, "o", "\u001b[?2004h> "]
[38.35996, "o", "                    if not should_exclude(next_line):\r\n\u001b[?2004l\r"]
[38.360059, "o", "\u001b[?2004h> "]
[38.360143, "o", "                        amount = extract_amount_from_line(next_line)\r\n\u001b[?2004l\r"]
[38.360193, "o", "\u001b[?2004h> "]
[38.360267, "o", "                        if amount:\r\n\u001b[?2004l\r"]
[38.3603, "o", "\u001b[?2004h> "]
[38.360391, "o", "                            return amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.360441, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.360501, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[38.360547, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[38.360579, "o", "\u001b[?2004h> "]
[38.360669, "o", "    img_dir = '/app/workspace/dataset/img'\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.360703, "o", "> "]
[38.360776, "o", "    output_file = '/app/workspace/stat_ocr.xlsx'\r\n\u001b[?2004l\r"]
[38.360806, "o", "\u001b[?2004h>     \r\n"]
[38.360832, "o", "\u001b[?2004l\r\u001b[?2004h"]
[38.360857, "o", "> "]
[38.360962, "o", "    # Get all jpg files sorted by filename\r\n\u001b[?2004l\r"]
[38.360988, "o", "\u001b[?2004h> "]
[38.361255, "o", "    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\r\n\u001b[?2004l\r"]
[38.361283, "o", "\u001b[?2004h> "]
[38.361378, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.361434, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.361474, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.3615, "o", "> "]
[38.361584, "o", "    for filename in files:\r\n\u001b[?2004l\r"]
[38.361612, "o", "\u001b[?2004h> "]
[38.361732, "o", "        image_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r"]
[38.361774, "o", "\u001b[?2004h> "]
[38.361904, "o", "        print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r"]
[38.361932, "o", "\u001b[?2004h> "]
[38.361977, "o", "        \r\n\u001b[?2004l\r"]
[38.362028, "o", "\u001b[?2004h> "]
[38.362649, "o", "        text = extract_text(image_path)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"OCR Text for {filename}:\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(text[:500] if len(text) > 500 else text)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"-\" * 50)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.362743, "o", "        date = extract_date(text)\r\n\u001b[?2004l\r"]
[38.362826, "o", "\u001b[?2004h> "]
[38.363062, "o", "        total_amount = extract_total_amount(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.36311, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.363143, "o", "> "]
[38.363253, "o", "        print(f\"  Date: {date}\")\r\n\u001b[?2004l\r"]
[38.363286, "o", "\u001b[?2004h> "]
[38.363416, "o", "        print(f\"  Total: {total_amount}\")\r\n\u001b[?2004l\r"]
[38.363449, "o", "\u001b[?2004h> "]
[38.363519, "o", "        print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[38.363584, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[38.363644, "o", "\u001b[?2004h> "]
[38.363705, "o", "        results.append({\r\n\u001b[?2004l\r"]
[38.363764, "o", "\u001b[?2004h> "]
[38.363847, "o", "            'filename': filename,\r\n\u001b[?2004l\r"]
[38.364004, "o", "\u001b[?2004h>             'date': date,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.364102, "o", "            'total_amount': total_amount\r\n\u001b[?2004l\r"]
[38.364158, "o", "\u001b[?2004h>         })\r\n"]
[38.364209, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[38.36426, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.364339, "o", "    # Create Excel file\r\n\u001b[?2004l\r"]
[38.364392, "o", "\u001b[?2004h> "]
[38.364449, "o", "    wb = Workbook()\r\n\u001b[?2004l\r"]
[38.364514, "o", "\u001b[?2004h> "]
[38.364562, "o", "    ws = wb.active\r\n\u001b[?2004l\r"]
[38.364592, "o", "\u001b[?2004h"]
[38.364624, "o", "> "]
[38.364694, "o", "    ws.title = 'results'\r\n\u001b[?2004l\r"]
[38.364743, "o", "\u001b[?2004h> "]
[38.364771, "o", "    \r\n\u001b[?2004l\r"]
[38.364814, "o", "\u001b[?2004h> "]
[38.364858, "o", "    # Write header\r\n\u001b[?2004l\r"]
[38.364908, "o", "\u001b[?2004h> "]
[38.365001, "o", "    ws['A1'] = 'filename'\r\n\u001b[?2004l\r"]
[38.365052, "o", "\u001b[?2004h> "]
[38.365134, "o", "    ws['B1'] = 'date'\r\n\u001b[?2004l\r"]
[38.365195, "o", "\u001b[?2004h> "]
[38.365266, "o", "    ws['C1'] = 'total_amount'\r\n\u001b[?2004l\r"]
[38.365296, "o", "\u001b[?2004h> "]
[38.365341, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.365369, "o", "> "]
[38.36546, "o", "    # Write data\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.365501, "o", "> "]
[38.365603, "o", "    for i, result in enumerate(results, start=2):\r\n\u001b[?2004l\r"]
[38.365649, "o", "\u001b[?2004h> "]
[38.365758, "o", "        ws[f'A{i}'] = result['filename']\r\n\u001b[?2004l\r"]
[38.365789, "o", "\u001b[?2004h> "]
[38.365917, "o", "        ws[f'B{i}'] = result['date']\r\n\u001b[?2004l\r"]
[38.365949, "o", "\u001b[?2004h> "]
[38.366098, "o", "        ws[f'C{i}'] = result['total_amount']\r\n\u001b[?2004l\r"]
[38.366133, "o", "\u001b[?2004h> "]
[38.366163, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.366195, "o", "> "]
[38.366272, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r"]
[38.366305, "o", "\u001b[?2004h> "]
[38.366454, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r"]
[38.369676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@7e3b1f78574d:/app/workspace# "]
[43.573664, "i", "python3 /app/workspace/ocr_receipts.py\n"]
[43.573951, "o", "python3 /app/workspace/ocr_receipts.py\r\n\u001b[?2004l\r"]
[43.787579, "o", "Processing 007.jpg...\r\n"]
[44.427218, "o", "OCR Text for 007.jpg:"]
[44.42744, "o", "\r\n"]
[44.42757, "o", "tan chay yee"]
[44.427659, "o", "\r\n"]
[44.427744, "o", "\r\n"]
[44.427831, "o", "HOTER (8 (sh ( UNGAL RENGTT ) SON, Bh,"]
[44.427919, "o", "\r\n"]
[44.428003, "o", "g0-T )"]
[44.428095, "o", "\r\n"]
[44.428194, "o", "No. 343, Jalan Kurau, Sungai Rengit,"]
[44.428279, "o", "\r\n"]
[44.428418, "o", "81620 Pengerang, Johor."]
[44.428608, "o", "\r\nel; 07-8263254 Fax: 07-8266888\r\n\r\nINVOICE\r\n\r\nTTEM/DESC. QTY U.PRICE RNCTOTAL)\r\n\r\n4132 1 20.00 20. 00\r\nCROCS 300X17 TUBES\r\n\r\nSUB TOTAL : 20.00\r\n\r\nROUNDING ADJUSTMENT : 0.00\r\nGRAND TOTAL : 20.00\r\n"]
[44.430513, "o", "\r\nCASH : 20.00\r\n\r\nCHANGE : 0.00\r\n\r\n23-01-2019 13:14:15 PM, PRINT BY: root\r\nTOKEN NO: 0, STATION ID: Al, PID: POS\r\nINVOICE NO: 22497\r\n\r\nThanks Your Support i WwW n\r\n\r\n--------------------------------------------------"]
[44.430708, "o", "\r\n  Date: 2019-01-23"]
[44.431237, "o", "\r\n"]
[44.431416, "o", "  Total: 20.00"]
[44.431565, "o", "\r\n"]
[44.431717, "o", "=================================================="]
[44.431856, "o", "\r\n"]
