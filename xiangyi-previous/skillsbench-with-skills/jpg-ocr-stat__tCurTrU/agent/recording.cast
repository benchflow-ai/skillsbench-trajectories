[529.043789, "o", "> "]
[529.044156, "o", "        match = re.search(r'(\\d{1,2})[\\s\\-\\./:](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./:](\\d{4})', line, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h"]
