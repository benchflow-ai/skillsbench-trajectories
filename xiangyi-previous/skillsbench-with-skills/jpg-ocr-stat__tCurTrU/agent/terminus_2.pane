[?2004l[?2004h> def extract_total_amount(text):
[?2004l[?2004h>     """Extract total amount from OCR text based on priority keywords."""
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     
[?2004l[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', 
[?2004l[?2004h>                           'DISCOUNT', 'CHANGE', 'CASH TENDERED', 'EXCL', 'SAVING',
[?2004l[?2004h>                           'CASH', 'VISA', 'MASTER', 'CARD', 'TENDER', 'PAYMENT']
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority keyword patterns
[?2004l[?2004h>     priority_patterns = [
[?2004l[?2004h>         r'GRAND\s*TOTAL',
[?2004l[?2004h>         r'TOTAL\s*:?\s*RM',
[?2004l[?2004h>         r'TOTAL\s*AMOUNT',
[?2004l[?2004h>         r'TOTAL\s*DUE',
[?2004l[?2004h>         r'AMOUNT\s*DUE',
[?2004l[?2004h>         r'BALANCE\s*DUE',
[?2004l[?2004h>         r'NETT\s*TOTAL',
[?2004l[?2004h>         r'NET\s*TOTAL',
[?2004l[?2004h>         r'TOTAL\s*ROUNDED',
[?2004l[?2004h>         r'TOTAL\s*RM\s*INCL',
[?2004l[?2004h>         r'TOTAL\s*INCL',
[?2004l[?2004h>         r'TOTAL\s*AFTER\s*ADJ',
[?2004l[?2004h>         r'TOTAL\s*AFTER\s*ROUND',
[?2004l[?2004h>         r'TOTAL\s*SALES',
[?2004l[?2004h>         r'(?<!SUB[\s\-])TOTAL(?![\s]*QTY|[\s]*QUANTITY|[\s]*ITEM|[\s]*SAVING|[\s]*GROSS)',
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     def extract_amount_from_line(line):
[?2004l[?2004h>         """Extract monetary value from a line."""
[?2004l[?2004h>         # Fix common OCR errors
[?2004l[?2004h>         line_fixed = line.replace('u', '0').replace('U', '0')
[?2004l[?2004h>         line_fixed = line_fixed.replace(',', '')
[?2004l[?2004h>         
[?2004l[?2004h>         # Match numbers with decimal point and exactly 2 decimal places
[?2004l[?2004h>         matches = re.findall(r'(\d+\.\d{2})(?!\d)', line_fixed)
[?2004l[?2004h>         if matches:
[?2004l[?2004h>             return matches[-1]
[?2004l[?2004h>         
[?2004l[?2004h>         # Try original line with comma handling
[?2004l[?2004h>         matches = re.findall(r'([\d,]+\.\d{2})(?!\d)', line)
[?2004l[?2004h>         if matches:
[?2004l[?2004h>             amount = matches[-1].replace(',', '')
[?2004l[?2004h>             return amount
[?2004l[?2004h>         
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     def should_exclude(line):
[?2004l[?2004h>         """Check if line contains exclusion keywords."""
[?2004l[?2004h>         upper_line = line.upper()
[?2004l[?2004h>         for kw in exclusion_keywords:
[?2004l[?2004h>             if kw in upper_line:
[?2004l[?2004h>                 # But allow if it's TOTAL RM, TOTAL INCL, etc.
[?2004l[?2004h>                 if 'TOTAL' in upper_line and kw not in ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'GST', 'TAX', 'EXCL', 'SAVING']:
[?2004l[?2004h>                     return False
[?2004l[?2004h>                 return True
[?2004l[?2004h>         return False
[?2004l[?2004h>     
[?2004l[?2004h>     # Try each priority pattern
[?2004l[?2004h>     for pattern in priority_patterns:
[?2004l[?2004h>         for i, line in enumerate(lines):
[?2004l[?2004h>             upper_line = line.upper()
[?2004l[?2004h>             if re.search(pattern, upper_line, re.IGNORECASE):
[?2004l[?2004h>                 # Skip if it's a GST/tax line
[?2004l[?2004h>                 if any(kw in upper_line for kw in ['GST', 'TAX', 'SST', '@', '%']):
[?2004l[?2004h>                     if 'INCL' not in upper_line:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Try to extract amount from this line
[?2004l[?2004h>                 amount = extract_amount_from_line(line)
[?2004l[?2004h>                 if amount and float(amount) > 0.5:  # Avoid tiny amounts that might be rounding
[?2004l[?2004h>                     return amount
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Fallback: check the next line
[?2004l[?2004h>                 if i + 1 < len(lines):
[?2004l[?2004h>                     next_line = lines[i + 1]
[?2004l[?2004h>                     next_upper = next_line.upper()
[?2004l[?2004h>                     if not any(kw in next_upper for kw in ['GST', 'TAX', 'SST', 'CASH', 'CHANGE', 'VISA', 'MASTER']):
[?2004l[?2004h>                         amount = extract_amount_from_line(next_line)
[?2004l[?2004h>                         if amount and float(amount) > 0.5:
[?2004l[?2004h>                             return amount
[?2004l[?2004h>     
[?2004l[?2004h>     return None
