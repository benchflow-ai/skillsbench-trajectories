[?2004l[?2004h>         
[?2004l[?2004h>         # Pattern: DD MMM YYYY
[?2004l[?2004h>         match = re.search(r'(\d{1,2})[\s\-\./:](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\s\-\./:](\d{4})', line, re.IGNORECASE)
[?2004l[?2004h>         if match:
[?2004l[?2004h>             day, month_str, year = match.groups()
[?2004l[?2004h>             if 2000 <= int(year) <= 2030:
[?2004l[?2004h>                 day = day.zfill(2)
[?2004l[?2004h>                 month = month_map[month_str.lower()[:3]]
[?2004l[?2004h>                 return f"{year}-{month}-{day}"
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def extract_total_amount(text):
[?2004l[?2004h>     """Extract total amount from OCR text based on priority keywords."""
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     
[?2004l[?2004h>     def extract_amount_from_line(line):
[?2004l[?2004h>         """Extract monetary value from a line."""
[?2004l[?2004h>         line_fixed = line.replace('u', '0').replace('U', '0').replace('O', '0').replace('o', '0')
[?2004l[?2004h>         line_fixed = line_fixed.replace(',', '')
[?2004l[?2004h>         matches = re.findall(r'(\d+\.\d{2})(?!\d)', line_fixed)
[?2004l[?2004h>         if matches:
[?2004l[?2004h>             return matches[-1]
[?2004l[?2004h>         matches = re.findall(r'([\d,]+\.\d{2})(?!\d)', line)
[?2004l[?2004h>         if matches:
[?2004l[?2004h>             return matches[-1].replace(',', '')
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     def is_exclusion_line(line):
[?2004l[?2004h>         upper = line.upper()
[?2004l[?2004h>         exclusions = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'CASH', 'CHANGE', 'VISA', 'MASTER', 
[?2004l[?2004h>                       'PAYMENT', 'TENDER', 'EXCL', 'SAVING', 'DISCOUNT', 'ROUNDING']
[?2004l[?2004h>         for ex in exclusions:
[?2004l[?2004h>             if ex in upper:
[?2004l[?2004h>                 return True
[?2004l[?2004h>         return False
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority patterns for total
[?2004l[?2004h>     priority_patterns = [
[?2004l[?2004h>         r'GRAND\s*TOTAL',
[?2004l[?2004h>         r'TOTAL\s*:?\s*RM',
[?2004l[?2004h>         r'TOTAL\s*AMOUNT',
[?2004l[?2004h>         r'TOTAL\s*DUE',
[?2004l[?2004h>         r'AMOUNT\s*DUE',
[?2004l[?2004h>         r'BALANCE\s*DUE',
[?2004l[?2004h>         r'NETT\s*TOTAL',
[?2004l[?2004h>         r'NET\s*TOTAL',
[?2004l[?2004h>         r'TOTAL.*INCL',
[?2004l[?2004h>         r'TOTAL.*INEL',  # OCR error for INCL
[?2004l[?2004h>         r'TOTAL\s*ROUNDED',
[?2004l[?2004h>         r'TOTAL\s*AMT\s*ROUNDED',
[?2004l[?2004h>         r'TOTAL\s*AFTER',
[?2004l[?2004h>         r'TOTAL\s*SALES',
[?2004l[?2004h>         r'TOTAL\s*RM',
[?2004l[?2004h>         r'(?<!SUB)(?<!SUB-)(?<!SUB )TOTAL(?!\s*QTY|\s*QUANTITY|\s*ITEM|\s*SAVING|\s*GROSS|\s*EXCL)',
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for pattern in priority_patterns:
[?2004l[?2004h>         for i, line in enumerate(lines):
[?2004l[?2004h>             upper_line = line.upper()
[?2004l[?2004h>             
[?2004l[?2004h>             # Skip subtotal lines
[?2004l[?2004h>             if 'SUBTOTAL' in upper_line or 'SUB TOTAL' in upper_line or 'SUB-TOTAL' in upper_line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Skip GST/tax summary lines (but not "incl GST")
[?2004l[?2004h>             if re.search(r'GST\s*@|GST\s*\d+%|TAX\s*@|SR\s*@', upper_line):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             if re.search(pattern, upper_line, re.IGNORECASE):
[?2004l[?2004h>                 amount = extract_amount_from_line(line)
[?2004l[?2004h>                 if amount and float(amount) > 1.0:
[?2004l[?2004h>                     return amount
[?2004l[?2004h>                 # Try next line
[?2004l[?2004h>                 if i + 1 < len(lines):
[?2004l[?2004h>                     next_line = lines[i + 1]
[?2004l[?2004h>                     if not is_exclusion_line(next_line):
