[?2004l[?2004h>             if 'DATE' not in upper_line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Pattern: DD/MM/YYYY or DD-MM-YYYY or DD.MM.YYYY
[?2004l[?2004h>         match = re.search(r'(\d{1,2})[/\-\.](\d{1,2})[/\-\.](\d{4})', line)
[?2004l[?2004h>         if match:
[?2004l[?2004h>             day, month, year = match.groups()
[?2004l[?2004h>             if 2000 <= int(year) <= 2030:
[?2004l[?2004h>                 day = day.zfill(2)
[?2004l[?2004h>                 month = month.zfill(2)
[?2004l[?2004h>                 if int(month) > 12:
