[?2004l[?2004h>                     if 1 <= int(month_fixed) <= 12:
[?2004l[?2004h>                         month = month_fixed
[?2004l[?2004h>                 if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:
[?2004l[?2004h>                     return f"{year}-{month}-{day}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Pattern: DD/MM/YY
[?2004l[?2004h>         match = re.search(r'(\d{1,2})[/\-\.](\d{1,2})[/\-\.](\d{2})(?!\d)', line)
[?2004l[?2004h>         if match:
[?2004l[?2004h>             day, month, year = match.groups()
[?2004l[?2004h>             day = day.zfill(2)
[?2004l[?2004h>             month = month.zfill(2)
[?2004l[?2004h>             if int(month) > 12:
[?2004l[?2004h>                 month_fixed = month.replace('6', '0').replace('5', '0')
[?2004l[?2004h>                 if 1 <= int(month_fixed) <= 12:
[?2004l[?2004h>                     month = month_fixed
[?2004l[?2004h>             year_full = '20' + year if int(year) < 50 else '19' + year
[?2004l[?2004h>             if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:
[?2004l[?2004h>                 return f"{year_full}-{month}-{day}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Pattern: DMMYYYY or DDMYYYY without separators (like 2032018 for 20/3/2018)
[?2004l[?2004h>         # Look for date keyword first
[?2004l[?2004h>         if 'DATE' in upper_line:
