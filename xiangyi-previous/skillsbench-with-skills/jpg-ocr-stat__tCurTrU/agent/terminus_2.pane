[?2004l[?2004h>                     next_line = lines[i + 1]
[?2004l[?2004h>                     if not should_exclude(next_line):
[?2004l[?2004h>                         amount = extract_amount_from_line(next_line)
[?2004l[?2004h>                         if amount:
[?2004l[?2004h>                             return amount
[?2004l[?2004h>     
[?2004l[?2004h>     return None
