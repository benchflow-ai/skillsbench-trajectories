[169.987877, "i", "printf \"import urllib.request\\nimport json\\nimport re\\nimport ssl\\n\\nctx = ssl.create_default_context()\\nctx.check_hostname = False\\nctx.verify_mode = ssl.CERT_NONE\\n\\n# Geostat\\ntry:\\n    url = 'https://www.geostat.ge/en/modules/categories/300/supply-and-use-tables'\\n    print(f'Fetching {url}...')\\n    with urllib.request.urlopen(url, context=ctx) as r:\\n        html = r.read().decode('utf-8')\\n        links = re.findall(r'href=\\\"([^\\\"]+\\\\.xlsx)\\\"', html)\\n        sut_url = next((l for l in links if 'supply' in l.lower() or 'use' in l.lower()), links[0] if links else None)\\n        if sut_url:\\n            if not sut_url.startswith('http'): sut_url = 'https://www.geostat.ge' + sut_url\\n            print(f'Downloading {sut_url}...')\\n            urllib.request.urlretrieve(sut_url, 'sut.xlsx', context=ctx)\\n            print('Downloaded sut.xlsx')\\n        else:\\n            print('No SUT link found')\\nexcept Exception as e:\\n    print(f'Geostat error: {e}')\\n\\n# IMF\\nfor ind in ['NGDP_RPCH', 'NGDP_D']:\\n    try:\\n        url = f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'\\n        print(f'Fetching {ind}...')\\n        with urllib.request.urlopen(url, context=ctx) as r:\\n            data = json.load(r)\\n            with open(f'{ind}.json', 'w') as f: json.dump(data, f)\\n            print(f'Saved {ind}.json')\\n    except Exception as e:\\n        print(f'IMF {ind} error: {e}')\\n\" > download_data.py\n"]
[169.992442, "o", "printf \"import urllib.request\\nimport json\\nimport re\\nimport ssl\\n\\nctx = ssl.create_default_context()\\nctx.check_hostname = False\\nctx.verify_mode = ssl.CERT_NONE\\n\\n# Geostat\\ntry:\\n    url = 'https://www.geostat.ge/en/modules/categories/300/supply-and-use-tables'\\n    print(f'Fetching {url}...')\\n    with urllib.request.urlopen(url, context=ctx) as r:\\n        html = r.read().decode('utf-8')\\n        links = re.findall(r'href=\\\"([^\\\"]+\\\\.xlsx)\\\"', html)\\n        sut_url = next((l for l in links if 'supply' in l.lower() or 'use' in l.lower()), links[0] if links else None)\\n        if sut_url:\\n            if not sut_url.startswith('http'): sut_url = 'https://www.geostat.ge' + sut_url\\n            print(f'Downloading {sut_url}...')\\n            urllib.request.urlretrieve(sut_url, 'sut.xlsx', context=ctx)\\n            print('Downloaded sut.xlsx')\\n        else:\\n            print('No SUT link found')\\nexcept Exception as e:\\n    print(f'Geostat error: {e}')\\n\\n# IMF\\nfor ind in ['NGDP_RPCH', 'NGDP_D']:\\n    "]
[169.992747, "o", "try:\\n        url = f'https://www.imf.org/external/datamapper/api/v1/{ind}/GEO'\\n        print(f'Fetching {ind}...')\\n        with urllib.request.urlopen(url, context=ctx) as r:\\n            data = json.load(r)\\n            with open(f'{ind}.json', 'w') as f: json.dump(data, f)\\n            print(f'Saved {ind}.json')\\n    except Exception as e:\\n        print(f'IMF {ind} error: {e}')\\n\" > download_data.py\r\n"]
