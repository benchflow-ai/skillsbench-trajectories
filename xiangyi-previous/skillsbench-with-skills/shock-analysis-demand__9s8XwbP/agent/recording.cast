[459.489263, "o", "cat <<EOF > inspect_full.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> with open('NGDP_D_FULL.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Keys:\", list(data.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> if 'values' in data:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Values keys:\", list(data['values'].keys()))\r\n\u001b[?2004l\r\u001b[?2004h>     if 'NGDP_D' in data['values']:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"GEO data:\", data['values']['NGDP_D'].get('GEO'))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
