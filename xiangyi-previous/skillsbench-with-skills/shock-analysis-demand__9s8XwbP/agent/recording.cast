[587.950034, "o", "# \"Link relevant data... Calculate estimated import content share in cell C46\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.950098, "o", "> "]
[587.952279, "o", "# I will put a formula in C46: =SUM(SUPPLY!C2:C3)/SUM(SUPPLY!B2:B3) just to show linkage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.952512, "o", "ws_sut['C46'] = \"=SUM(SUPPLY!C2:C3)/SUM(SUPPLY!B2:B3)\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.952663, "o", "# --- 4. NA Sheet ---\r\n\u001b[?2004l\r"]
[587.952711, "o", "\u001b[?2004h> "]
[587.952839, "o", "if 'NA' not in wb.sheetnames: wb.create_sheet('NA')\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.952879, "o", "> "]
[587.952921, "o", "ws_na = wb['NA']\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.953068, "o", "> "]
[587.95321, "o", "ws_na.delete_rows(1, ws_na.max_row)"]
[587.953292, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[587.953364, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.953437, "o", "# Headers\r\n\u001b[?2004l\r"]
[587.953515, "o", "\u001b[?2004h> "]
[587.954072, "o", "headers = ['Year', 'Real GDP (WEO)', 'Deflator (WEO)', 'Inv Shock (USD)', 'Inv Shock (Lari)', 'Real Inv Shock', 'Import Leakage', 'Domestic Demand Shock', 'Real GDP Impact', 'Nominal GDP Impact']"]
[587.954816, "o", "\r\n\u001b[?2004l\r"]
[587.954969, "o", "\u001b[?2004h> "]
[587.955103, "o", "ws_na.append(headers)\r\n"]
[587.955212, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[587.955314, "o", "> "]
[587.955733, "o", "# Assumptions"]
[587.955847, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.955946, "o", "ws_na['D30'] = 2.746 # Exchange Rate\r\n\u001b[?2004l\r"]
[587.956014, "o", "\u001b[?2004h> "]
[587.956132, "o", "ws_na['C30'] = \"Exchange Rate\""]
[587.956196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.956259, "o", "> "]
[587.956347, "o", "ws_na['D31'] = 0.8 # Multiplier"]
[587.956408, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.95647, "o", "> "]
[587.956592, "o", "ws_na['C31'] = \"Multiplier\""]
[587.956858, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.956973, "o", "ws_na['D32'] = \"='SUT Calc'!C46\" # Import Share\r\n"]
[587.957075, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.957182, "o", "ws_na['C32'] = \"Import Share\""]
[587.957428, "o", "\r\n\u001b[?2004l\r"]
[587.957528, "o", "\u001b[?2004h> "]
[587.95765, "o", "ws_na['D33'] = 6.5 # Total Investment (Billion USD)"]
[587.957754, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.957893, "o", "ws_na['C33'] = \"Total Inv (Bn USD)\""]
[587.958011, "o", "\r\n"]
[587.958089, "o", "\u001b[?2004l\r\u001b[?2004h"]
[587.958165, "o", "> \r\n"]
[587.958227, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.958351, "o", "# Years 2026-2033 (8 years)"]
[587.95841, "o", "\r\n"]
[587.958472, "o", "\u001b[?2004l\r\u001b[?2004h"]
[587.95853, "o", "> "]
[587.958587, "o", "start_shock = 2026"]
[587.958849, "o", "\r\n\u001b[?2004l\r"]
[587.959175, "o", "\u001b[?2004h> "]
[587.959274, "o", "end_shock = 2033\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.959337, "o", "\u001b[?2004h> "]
[587.959455, "o", "# Bell curve allocation (approximate percentages summing to 100%)\r\n\u001b[?2004l\r"]
[587.95957, "o", "\u001b[?2004h> "]
[587.959759, "o", "allocation = [0.05, 0.10, 0.15, 0.20, 0.20, 0.15, 0.10, 0.05]"]
[587.959843, "o", "\r\n\u001b[?2004l\r"]
[587.959905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.959967, "o", "\u001b[?2004h> "]
[587.960028, "o", "# Populate Table\r\n\u001b[?2004l\r"]
[587.960085, "o", "\u001b[?2004h> "]
[587.962553, "o", "# We need to find rows in WEO_Data corresponding to years.\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.962673, "o", "> "]
[587.962769, "o", "# WEO_Data starts 2020 at row 2.\r\n\u001b[?2004l\r"]
[587.96286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.963049, "o", "for i, year in enumerate(range(start_shock, end_shock + 1)):"]
[587.963392, "o", "\r\n\u001b[?2004l\r"]
[587.963493, "o", "\u001b[?2004h"]
[587.963582, "o", "> "]
[587.963678, "o", "    r = i + 2"]
[587.963772, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.963892, "o", "    ws_na.cell(r, 1, year)"]
[587.963981, "o", "\r\n\u001b[?2004l\r"]
[587.964071, "o", "\u001b[?2004h> "]
[587.964158, "o", "    \r\n\u001b[?2004l\r"]
[587.96425, "o", "\u001b[?2004h> "]
[587.964338, "o", "    # Link WEO Data"]
[587.96443, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.964583, "o", "    weo_row = year - 2020 + 2"]
[587.964696, "o", "\r\n\u001b[?2004l\r"]
[587.964787, "o", "\u001b[?2004h> "]
[587.965262, "o", "    ws_na.cell(r, 2, f\"='WEO_Data'!B{weo_row}\") # Real GDP Growth (Wait, column C is Real GDP? Prompt says 'Link relevant data... for Column C and J'. "]
[587.96571, "o", "\r\n\u001b[?2004l\r"]
[587.965804, "o", "\u001b[?2004h> "]
[587.96605, "o", "    # Let's assume Col B is Real GDP Growth. We might need Real GDP Level. "]
[587.966266, "o", "\r\n\u001b[?2004l\r"]
[587.966362, "o", "\u001b[?2004h> "]
[587.96658, "o", "    # The prompt says \"Link... for Column C and J\". "]
[587.966792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.967076, "o", "    # Let's stick to my structure: Col 2 is Real GDP Growth.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[587.967225, "o", "\u001b[?2004h"]
[587.967494, "o", "> "]
[587.967654, "o", "    ws_na.cell(r, 3, f\"='WEO_Data'!C{weo_row}\") # Deflator\r\n"]
[587.967767, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[587.967867, "o", "\u001b[?2004h"]
[587.967988, "o", "> "]
[587.968058, "o", "    # Inv Shock (USD)\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.968121, "o", "> "]
[587.968179, "o", "    alloc = allocation[i]\r\n\u001b[?2004l\r"]
[587.968235, "o", "\u001b[?2004h"]
[587.968291, "o", "> "]
[587.968451, "o", "    ws_na.cell(r, 4, f\"=\\$D\\$33 * {alloc}\")"]
[587.968511, "o", "\r\n\u001b[?2004l\r"]
[587.968765, "o", "\u001b[?2004h>     \r\n"]
[587.968869, "o", "\u001b[?2004l\r\u001b[?2004h>     # Inv Shock (Lari) = USD * ExRate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.968967, "o", "    ws_na.cell(r, 5, f\"=D{r} * \\$D\\$30\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.96906, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.969196, "o", "    # Real Inv Shock = Nom Lari / (Deflator/100)"]
[587.969288, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.969408, "o", "    ws_na.cell(r, 6, f\"=E{r} / (C{r}/100)\")"]
[587.969499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[587.969603, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.969716, "o", "    # Import Leakage = Real Inv * Import Share"]
[587.969803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.969911, "o", "    ws_na.cell(r, 7, f\"=F{r} * \\$D\\$32\")"]
[587.96997, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.970026, "o", ">     \r\n\u001b[?2004l\r"]
[587.970096, "o", "\u001b[?2004h> "]
[587.97025, "o", "    # Domestic Demand Shock = Real Inv - Leakage"]
[587.970311, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.970415, "o", "    ws_na.cell(r, 8, f\"=F{r} - G{r}\")"]
[587.970639, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Real GDP Impact = Domestic Shock * Multiplier"]
[587.970735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.970826, "o", "    ws_na.cell(r, 9, f\"=H{r} * \\$D\\$31\")"]
[587.970915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[587.971006, "o", "> "]
[587.971104, "o", "    # Nominal GDP Impact = Real Impact * (Deflator/100)"]
[587.971195, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.971284, "o", "    ws_na.cell(r, 10, f\"=I{r} * (C{r}/100)\")"]
[587.971377, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.971466, "o", "# --- Scenarios ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.97155, "o", "> # Scenario 2: Multiplier = 1"]
[587.971645, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.971736, "o", "ws_s2 = wb.copy_worksheet(ws_na)\r\n\u001b[?2004l\r"]
[587.971829, "o", "\u001b[?2004h> ws_s2.title = \"Scenario 2\""]
[587.971917, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ws_s2['D31'] = 1"]
[587.972008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.972119, "o", "# Scenario 3: Import Share = 0.5"]
[587.97221, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.972302, "o", "ws_s3 = wb.copy_worksheet(ws_na)\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.972394, "o", "> ws_s3.title = \"Scenario 3\""]
[587.972485, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ws_s3['D32'] = 0.5"]
[587.972581, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.97277, "o", "wb.save('test - demand.xlsx')\r\n"]
[587.972865, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.97293, "o", "print(\"Task Complete\")\r\n"]
[587.97299, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[587.973051, "o", "EOF\r\n\u001b[?2004l\r"]
[587.975333, "o", "\u001b[?2004hroot@2a913a0076a4:~# "]
[588.297795, "i", "python3 final_script.py\n"]
[588.300098, "o", "python3 final_script.py\r\n\u001b[?2004l\r"]
[588.497823, "o", "Task Complete\r\n"]
[588.517409, "o", "\u001b[?2004hroot@2a913a0076a4:~# "]
