[454.131335, "i", "cat <<EOF > download_deflator.py\nimport urllib.request\nimport json\nimport ssl\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\nurl = \"https://www.imf.org/external/datamapper/api/v1/NGDP_D\"\nprint(f\"Fetching {url}...\")\ntry:\n    with urllib.request.urlopen(url, context=ctx) as response:\n        data = json.load(response)\n        with open(\"NGDP_D_FULL.json\", \"w\") as f:\n            json.dump(data, f)\n        print(\"Saved NGDP_D_FULL.json\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[454.131928, "o", "cat <<EOF > download_deflator.py\r\n\u001b[?2004l\r"]
