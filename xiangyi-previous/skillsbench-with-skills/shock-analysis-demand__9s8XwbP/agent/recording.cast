[222.08884, "i", "cat <<EOF > find_geostat.py\nimport urllib.request\nimport re\nimport ssl\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\n# Try a more general page\nurl = 'https://www.geostat.ge/en/modules/categories/23/gross-domestic-product-gdp'\nprint(f'Fetching {url}...')\ntry:\n    with urllib.request.urlopen(url, context=ctx) as r:\n        html = r.read().decode('utf-8')\n        # Look for Supply and Use Table link\n        # Often it might be in a different category, let's look for any link with 'supply' or 'use'\n        links = re.findall(r'href=\"([^\"]+)\"', html)\n        for link in links:\n            if 'supply' in link.lower() and 'use' in link.lower():\n                print(f\"Potential Page/File: {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
