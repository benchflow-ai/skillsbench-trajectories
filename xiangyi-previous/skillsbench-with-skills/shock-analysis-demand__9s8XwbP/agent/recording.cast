[336.303914, "i", "cat <<EOF > process_excel.py\nimport openpyxl\nimport json\nfrom openpyxl.utils import get_column_letter\n\n# Load IMF Data\nwith open('NGDP_RPCH.json') as f: ngdp_rpch = json.load(f)\nwith open('NGDP_D.json') as f: ngdp_d = json.load(f)\n\n# Extract Georgia Data\ngdp_growth = ngdp_rpch['values']['NGDP_RPCH']['GEO']\ngdp_deflator = ngdp_d['values']['NGDP_D']['GEO']\n\nwb = openpyxl.load_workbook('test - demand.xlsx')\n\n# --- WEO_Data Sheet ---\nif 'WEO_Data' not in wb.sheetnames:\n    ws_weo = wb.create_sheet('WEO_Data')\nelse:\n    ws_weo = wb['WEO_Data']\n\nws_weo.delete_rows(1, ws_weo.max_row)\nws_weo.append(['Year', 'Real GDP Growth (%)', 'GDP Deflator Index', 'GDP Deflator Growth (%)'])\n\nstart_year = 2020\nend_year = 2043\n\n# Helper to get value safely\ndef get_val(data, year):\n    return float(data.get(str(year), 0))\n\n# Populate data\nfor year in range(start_year, end_year + 1):\n    row_idx = year - start_year + 2\n    ws_weo.cell(row=row_idx, column=1, value=year)\n    \n    # Real GDP Growth\n    if str(year) in gdp_growth:\n        ws_weo.cell(row=row_idx, column=2, value=get_val(gdp_growth, year))\n    elif year > 2027:\n        # Assume 2027 rate stays unchanged\n        val_2027 = get_val(gdp_growth, 2027)\n        ws_weo.cell(row=row_idx, column=2, value=val_2027)\n    \n    # GDP Deflator\n    if str(year) in gdp_deflator:\n        ws_weo.cell(row=row_idx, column=3, value=get_val(gdp_deflator, year))\n\n# Calculate Deflator Growth and Extend\n# First calculate existing growth\nlast_data_year = 0\nfor row in range(2, ws_weo.max_row + 1):\n    year = ws_weo.cell(row=row, column=1).value\n    def_curr = ws_weo.cell(row=row, column=3).value\n    def_prev = ws_weo.cell(row=row-1, column=3).value if row > 2 else None\n    \n    if def_curr and def_prev:\n        growth = (def_curr / def_prev - 1) * 100\n        ws_weo.cell(row=row, column=4, value=growth)\n        last_data_year = year\n\n# Find average deflator growth (recent 4 years from last data point)\n# Assuming last data point is around 2029 (IMF projection)\n# Let's find the last year with data in gdp"]
[336.304133, "i", "_deflator\nlast_imf_year = max([int(y) for y in gdp_deflator.keys() if int(y) <= end_year])\n\navg_growth = 0\ncount = 0\nfor y in range(last_imf_year - 3, last_imf_year + 1):\n    # Find row for this year\n    r = y - start_year + 2\n    g = ws_weo.cell(row=r, column=4).value\n    if g is not None:\n        avg_growth += g\n        count += 1\nif count > 0: avg_growth /= count\n\n# Extend Deflator\nfor year in range(last_imf_year + 1, end_year + 1):\n    r = year - start_year + 2\n    prev_def = ws_weo.cell(row=r-1, column=3).value\n    new_def = prev_def * (1 + avg_growth/100)\n    ws_weo.cell(row=r, column=3, value=new_def)\n    ws_weo.cell(row=r, column=4, value=avg_growth)\n\nwb.save('test - demand.xlsx')\nprint(\"WEO_Data processed.\")\nEOF\n"]
[336.304201, "o", "cat <<EOF > process_excel.py\r\n\u001b[?2004l\r"]
[336.304235, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r"]
[336.304424, "o", "_deflator\r\nlast_imf_year = max([int(y) for y in gdp_deflator.keys() if int(y) <= end_year])\r\n\r\navg_growth = 0\r\ncount = 0\r\nfor y in range(last_imf_year - 3, last_imf_year + 1):\r\n    # Find row for this year\r\n    r = y - start_year + 2\r\n    g = ws_weo.cell(row=r, column=4).value\r\n    if g is not None:\r\n        avg_growth += g\r\n        count += 1\r\nif count > 0: avg_growth /= count\r\n\r\n# Extend Deflator\r\nfor year in range(last_imf_year + 1, end_year + 1):\r\n    r = year - start_year + 2\r\n    prev_def = ws_weo.cell(row=r-1, column=3).value\r\n    new_def = prev_def * (1 + avg_growth/100)\r\n    ws_weo.cell(row=r, column=3, value=new_def)\r\n    ws_weo.cell(row=r, column=4, value=avg_growth)\r\n\r\nwb.save('test - demand.xlsx')\r\nprint(\"WEO_Data processed.\")\r\nEOF\r\n\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h"]
