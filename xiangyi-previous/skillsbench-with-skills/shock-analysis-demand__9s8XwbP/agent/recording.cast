[42.94534, "i", "cat <<EOF > inspect_excel.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('test - demand.xlsx')\nprint(\"Sheet names:\", wb.sheetnames)\n\nfor sheet_name in wb.sheetnames:\n    ws = wb[sheet_name]\n    print(f\"\\n--- {sheet_name} ---\")\n    for i, row in enumerate(ws.iter_rows(max_row=15, max_col=10, values_only=True)):\n        print(row)\nEOF\n"]
