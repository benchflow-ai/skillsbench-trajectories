[275.331064, "i", "cat <<EOF > list_links.py\nimport urllib.request\nimport re\nimport ssl\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\nurl = 'https://www.geostat.ge/en/modules/categories/23/gross-domestic-product-gdp'\nprint(f'Fetching {url}...')\ntry:\n    with urllib.request.urlopen(url, context=ctx) as r:\n        html = r.read().decode('utf-8')\n        links = re.findall(r'href=\"([^\"]+)\"', html)\n        for link in links:\n            if '.xlsx' in link:\n                print(f\"XLSX: {link}\")\n            elif 'supply' in link.lower():\n                print(f\"SUPPLY LINK: {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[275.331324, "o", "cat <<EOF > list_links.py\r\n\u001b[?2004l\r"]
