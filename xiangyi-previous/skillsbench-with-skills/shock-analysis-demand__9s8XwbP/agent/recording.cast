[251.897834, "i", "cat <<EOF > find_geostat_main.py\nimport urllib.request\nimport re\nimport ssl\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\nurl = 'https://www.geostat.ge/en'\nprint(f'Fetching {url}...')\ntry:\n    with urllib.request.urlopen(url, context=ctx) as r:\n        html = r.read().decode('utf-8')\n        # Find categories\n        links = re.findall(r'href=\"([^\"]+)\"[^>]*>([^<]*)<', html)\n        for link, text in links:\n            if 'national' in text.lower() or 'supply' in text.lower() or 'account' in text.lower():\n                print(f\"Found: {text.strip()} -> {link}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
[251.898361, "o", "cat <<EOF > find_geostat_main.py\r\n"]
