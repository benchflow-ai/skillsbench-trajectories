[119.175472, "i", "cat <<EOF > download_data.py\nimport urllib.request\nimport json\nimport re\nimport ssl\n\n# Ignore SSL certificate errors\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\n# 1. Get Geostat SUT File URL\nurl_geostat = \"https://www.geostat.ge/en/modules/categories/300/supply-and-use-tables\"\nprint(f\"Fetching {url_geostat}...\")\ntry:\n    with urllib.request.urlopen(url_geostat, context=ctx) as response:\n        html = response.read().decode('utf-8')\n        # Find link ending in .xlsx that likely contains SUT data\n        # Looking for links with 'supply' and 'use' in the href or surrounding text is tricky with regex alone\n        # Let's find all xlsx links\n        links = re.findall(r'href=\"([^\"]+\\.xlsx)\"', html)\n        sut_url = None\n        for link in links:\n            # Heuristic: usually contains 'supply' or 'use' or is the main download\n            # Let's print them to see, but for automation, pick the one that looks most relevant\n            if 'supply' in link.lower() or 'use' in link.lower() or 'sut' in link.lower():\n                sut_url = link\n                break\n        if not sut_url and links:\n             sut_url = links[0] # Fallback to first xlsx\n        \n        if sut_url:\n            if not sut_url.startswith('http'):\n                sut_url = \"https://www.geostat.ge\" + sut_url\n            print(f\"Found SUT URL: {sut_url}\")\n            print(\"Downloading SUT file...\")\n            urllib.request.urlretrieve(sut_url, \"sut.xlsx\", context=ctx)\n            print(\"Downloaded sut.xlsx\")\n        else:\n            print(\"No SUT .xlsx link found.\")\nexcept Exception as e:\n    print(f\"Error fetching Geostat: {e}\")\n\n# 2. Get IMF Data (Georgia)\n# Real GDP Growth: NGDP_RPCH\n# GDP Deflator Index: NGDP_D\n\nimf_base = \"https://www.imf.org/external/datamapper/api/v1\"\nindicators = [\"NGDP_RPCH\", \"NGDP_D\"]\ncountry = \"GEO\"\n\nfor ind in indicators:\n    api_url = f\"{imf_base}/{ind}/{country}\"\n    print(f\"Fetching IMF data: {ind}...\")\n    try:\n        with urllib.request.urlopen(api_url, context=ctx) as response:\n            data = json.load(response)\n            with open(f\"{ind}.json\", \"w\") as f:\n                json.dump(data, f)\n            print(f\"Saved {ind}.json\")\n    except Exception as e:\n        print(f\"Error fetching IMF {ind}: {e}\")\nEOF\n"]
[119.176076, "o", "cat <<EOF > download_data.py\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> "]
