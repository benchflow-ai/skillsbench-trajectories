[?2004l[?2004h> ws_na.append(headers)
[?2004l[?2004h> 
[?2004l[?2004h> # Assumptions
[?2004l[?2004h> ws_na['D30'] = 2.746 # Exchange Rate
[?2004l[?2004h> ws_na['C30'] = "Exchange Rate"
[?2004l[?2004h> ws_na['D31'] = 0.8 # Multiplier
[?2004l[?2004h> ws_na['C31'] = "Multiplier"
[?2004l[?2004h> ws_na['D32'] = "='SUT Calc'!C46" # Import Share
[?2004l[?2004h> ws_na['C32'] = "Import Share"
[?2004l[?2004h> ws_na['D33'] = 6.5 # Total Investment (Billion USD)
[?2004l[?2004h> ws_na['C33'] = "Total Inv (Bn USD)"
[?2004l[?2004h> 
[?2004l[?2004h> # Years 2026-2033 (8 years)
[?2004l[?2004h> start_shock = 2026
[?2004l[?2004h> end_shock = 2033
[?2004l[?2004h> 
[?2004l[?2004h> # Bell curve allocation (approximate percentages summing to 100%)
[?2004l[?2004h> allocation = [0.05, 0.10, 0.15, 0.20, 0.20, 0.15, 0.10, 0.05]
[?2004l[?2004h> 
[?2004l[?2004h> # Populate Table
[?2004l[?2004h> # We need to find rows in WEO_Data corresponding to years.
[?2004l[?2004h> # WEO_Data starts 2020 at row 2.
[?2004l[?2004h> 
[?2004l[?2004h> for i, year in enumerate(range(start_shock, end_shock + 1)):
[?2004l[?2004h>     r = i + 2
[?2004l[?2004h>     ws_na.cell(r, 1, year)
[?2004l[?2004h>     
[?2004l[?2004h>     # Link WEO Data
[?2004l[?2004h>     weo_row = year - 2020 + 2
[?2004l[?2004h>     ws_na.cell(r, 2, f"='WEO_Data'!B{weo_row}") # Real GDP Growth (Wait, column C is Real GDP? Prompt says 'Link relevant data... for Column C and J'. 
[?2004l[?2004h>     # Let's assume Col B is Real GDP Growth. We might need Real GDP Level. 
[?2004l[?2004h>     # The prompt says "Link... for Column C and J". 
[?2004l[?2004h>     # Let's stick to my structure: Col 2 is Real GDP Growth.
[?2004l[?2004h>     
[?2004l[?2004h>     ws_na.cell(r, 3, f"='WEO_Data'!C{weo_row}") # Deflator
[?2004l[?2004h>     
[?2004l[?2004h>     # Inv Shock (USD)
[?2004l[?2004h>     alloc = allocation[i]
[?2004l[?2004h>     ws_na.cell(r, 4, f"=\$D\$33 * {alloc}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Inv Shock (Lari) = USD * ExRate
[?2004l[?2004h>     ws_na.cell(r, 5, f"=D{r} * \$D\$30")
[?2004l[?2004h>     
[?2004l[?2004h>     # Real Inv Shock = Nom Lari / (Deflator/100)
[?2004l[?2004h>     ws_na.cell(r, 6, f"=E{r} / (C{r}/100)")
[?2004l[?2004h>     
[?2004l[?2004h>     # Import Leakage = Real Inv * Import Share
[?2004l[?2004h>     ws_na.cell(r, 7, f"=F{r} * \$D\$32")
[?2004l[?2004h>     
[?2004l[?2004h>     # Domestic Demand Shock = Real Inv - Leakage
[?2004l[?2004h>     ws_na.cell(r, 8, f"=F{r} - G{r}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Real GDP Impact = Domestic Shock * Multiplier
[?2004l[?2004h>     ws_na.cell(r, 9, f"=H{r} * \$D\$31")
[?2004l[?2004h>     
[?2004l[?2004h>     # Nominal GDP Impact = Real Impact * (Deflator/100)
[?2004l[?2004h>     ws_na.cell(r, 10, f"=I{r} * (C{r}/100)")
[?2004l[?2004h> 
