[?2004hroot@2a913a0076a4:~# cat <<EOF > process_excel.py
[?2004l[?2004h> import openpyxl
[?2004l_deflator
last_imf_year = max([int(y) for y in gdp_deflator.keys() if int(y) <= end_year])

avg_growth = 0
count = 0
for y in range(last_imf_year - 3, last_imf_year + 1):
    # Find row for this year
    r = y - start_year + 2
    g = ws_weo.cell(row=r, column=4).value
    if g is not None:
        avg_growth += g
        count += 1
if count > 0: avg_growth /= count

# Extend Deflator
for year in range(last_imf_year + 1, end_year + 1):
    r = year - start_year + 2
    prev_def = ws_weo.cell(row=r-1, column=3).value
    new_def = prev_def * (1 + avg_growth/100)
    ws_weo.cell(row=r, column=3, value=new_def)
    ws_weo.cell(row=r, column=4, value=avg_growth)

wb.save('test - demand.xlsx')
print("WEO_Data processed.")
EOF
[?2004h> import json
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> # Load IMF Data
[?2004l[?2004h> with open('NGDP_RPCH.json') as f: ngdp_rpch = json.load(f)
[?2004l[?2004h> with open('NGDP_D.json') as f: ngdp_d = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract Georgia Data
[?2004l[?2004h> gdp_growth = ngdp_rpch['values']['NGDP_RPCH']['GEO']
[?2004l[?2004h> gdp_deflator = ngdp_d['values']['NGDP_D']['GEO']
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('test - demand.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # --- WEO_Data Sheet ---
[?2004l[?2004h> if 'WEO_Data' not in wb.sheetnames:
[?2004l[?2004h>     ws_weo = wb.create_sheet('WEO_Data')
[?2004l[?2004h> else:
[?2004l[?2004h>     ws_weo = wb['WEO_Data']
[?2004l[?2004h> 
[?2004l[?2004h> ws_weo.delete_rows(1, ws_weo.max_row)
[?2004l[?2004h> ws_weo.append(['Year', 'Real GDP Growth (%)', 'GDP Deflator Index', 'GDP Deflator Growth (%)'])
[?2004l[?2004h> 
[?2004l[?2004h> start_year = 2020
[?2004l[?2004h> end_year = 2043
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to get value safely
[?2004l[?2004h> def get_val(data, year):
[?2004l[?2004h>     return float(data.get(str(year), 0))
[?2004l[?2004h> 
[?2004l[?2004h> # Populate data
[?2004l[?2004h> for year in range(start_year, end_year + 1):
[?2004l[?2004h>     row_idx = year - start_year + 2
[?2004l[?2004h>     ws_weo.cell(row=row_idx, column=1, value=year)
[?2004l[?2004h>     
[?2004l[?2004h>     # Real GDP Growth
[?2004l[?2004h>     if str(year) in gdp_growth:
[?2004l[?2004h>         ws_weo.cell(row=row_idx, column=2, value=get_val(gdp_growth, year))
[?2004l[?2004h>     elif year > 2027:
[?2004l[?2004h>         # Assume 2027 rate stays unchanged
[?2004l[?2004h>         val_2027 = get_val(gdp_growth, 2027)
[?2004l[?2004h>         ws_weo.cell(row=row_idx, column=2, value=val_2027)
[?2004l[?2004h>     
[?2004l[?2004h>     # GDP Deflator
[?2004l[?2004h>     if str(year) in gdp_deflator:
[?2004l[?2004h>         ws_weo.cell(row=row_idx, column=3, value=get_val(gdp_deflator, year))
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Deflator Growth and Extend
[?2004l[?2004h> # First calculate existing growth
[?2004l[?2004h> last_data_year = 0
[?2004l[?2004h> for row in range(2, ws_weo.max_row + 1):
[?2004l[?2004h>     year = ws_weo.cell(row=row, column=1).value
[?2004l[?2004h>     def_curr = ws_weo.cell(row=row, column=3).value
[?2004l[?2004h>     def_prev = ws_weo.cell(row=row-1, column=3).value if row > 2 else None
[?2004l[?2004h>     
[?2004l[?2004h>     if def_curr and def_prev:
[?2004l[?2004h>         growth = (def_curr / def_prev - 1) * 100
[?2004l[?2004h>         ws_weo.cell(row=row, column=4, value=growth)
[?2004l[?2004h>         last_data_year = year
[?2004l[?2004h> 
[?2004l[?2004h> # Find average deflator growth (recent 4 years from last data point)
[?2004l[?2004h> # Assuming last data point is around 2029 (IMF projection)
[?2004l[?2004h> # Let's find the last year with data in gdp_deflator
[?2004l[?2004h> last_imf_year = max([int(y) for y in gdp_deflator.keys() if int(y) <= end_year])
[?2004l[?2004h> 
[?2004l[?2004h> avg_growth = 0
[?2004l[?2004h> count = 0
[?2004l[?2004h> for y in range(last_imf_year - 3, last_imf_year + 1):
