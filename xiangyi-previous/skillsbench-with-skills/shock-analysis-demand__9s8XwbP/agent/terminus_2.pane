[?2004l[?2004h>         count += 1
[?2004l[?2004h> if count > 0: avg_growth /= count
[?2004l[?2004h> 
[?2004l[?2004h> # Extend Deflator
[?2004l[?2004h> for year in range(last_imf_year + 1, end_year + 1):
