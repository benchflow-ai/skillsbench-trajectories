[237.838828, "o", "        \"        return losses, chosen_rewards, rejected_rewards\\n\"\r\n\u001b[?2004l\r"]
[237.838907, "o", "\u001b[?2004h>     ]"]
[237.83897, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.839065, "o", "    lines[start_line:end_line+1] = new_func\r\n\u001b[?2004l\r"]
[237.839139, "o", "\u001b[?2004h> "]
[237.839273, "o", "    with open(\"/root/SimPO/scripts/simpo_trainer.py\", \"w\") as f:\r\n\u001b[?2004l\r"]
[237.83934, "o", "\u001b[?2004h> "]
[237.839416, "o", "        f.writelines(lines)\r\n\u001b[?2004l\r"]
[237.839495, "o", "\u001b[?2004h> "]
[237.839583, "o", "    print(\"Successfully updated simpo_loss\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.839664, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.839842, "o", "    print(f\"Could not find simpo_loss function: {start_line}, {end_line}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.839907, "o", ">     sys.exit(1)\r\n\u001b[?2004l\r"]
