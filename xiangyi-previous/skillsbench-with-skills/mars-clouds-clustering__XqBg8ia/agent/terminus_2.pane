[?2004l[?2004h>     for label in unique_labels:
[?2004l[?2004h>         cluster_points = citsci_points[labels == label]
[?2004l[?2004h>         centroid = cluster_points.mean(axis=0)
[?2004l[?2004h>         centroids.append(centroid)
[?2004l[?2004h>     
[?2004l[?2004h>     centroids = np.array(centroids)
[?2004l[?2004h>     
[?2004l[?2004h>     # Match centroids to expert points
[?2004l[?2004h>     matched_clusters, matched_experts = greedy_match(centroids, expert_points)
[?2004l[?2004h>     
[?2004l[?2004h>     n_matches = len(matched_clusters)
[?2004l[?2004h>     n_clusters = len(centroids)
[?2004l[?2004h>     n_experts = len(expert_points)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute F1 score
[?2004l[?2004h>     if n_matches == 0:
[?2004l[?2004h>         return 0.0, np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     precision = n_matches / n_clusters if n_clusters > 0 else 0
[?2004l[?2004h>     recall = n_matches / n_experts if n_experts > 0 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     if precision + recall == 0:
[?2004l[?2004h>         f1 = 0.0
[?2004l[?2004h>     else:
[?2004l[?2004h>         f1 = 2 * precision * recall / (precision + recall)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute delta (average standard Euclidean distance for matched pairs)
[?2004l[?2004h>     if n_matches > 0:
[?2004l[?2004h>         deltas = []
[?2004l[?2004h>         for c_idx, e_idx in zip(matched_clusters, matched_experts):
[?2004l[?2004h>             dist = np.linalg.norm(centroids[c_idx] - expert_points[e_idx])
[?2004l[?2004h>             deltas.append(dist)
[?2004l[?2004h>         delta = np.mean(deltas)
[?2004l[?2004h>     else:
[?2004l[?2004h>         delta = np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     return f1, delta
[?2004l[?2004h> 
[?2004l[?2004h> def evaluate_hyperparams(args):
[?2004l[?2004h>     """Evaluate a single hyperparameter combination."""
[?2004l[?2004h>     min_samples, epsilon, shape_weight, citsci_df, expert_df, all_images = args
[?2004l[?2004h>     
[?2004l[?2004h>     f1_scores = []
[?2004l[?2004h>     deltas = []
[?2004l[?2004h>     
[?2004l[?2004h>     for file_rad in all_images:
[?2004l[?2004h>         # Get points for this image
[?2004l[?2004h>         citsci_img = citsci_df[citsci_df['file_rad'] == file_rad][['x', 'y']].values
[?2004l[?2004h>         expert_img = expert_df[expert_df['file_rad'] == file_rad][['x', 'y']].values
[?2004l[?2004h>         
[?2004l[?2004h>         f1, delta = compute_f1_delta_for_image(citsci_img, expert_img, min_samples, epsilon, shape_weight)
[?2004l[?2004h>         
[?2004l[?2004h>         f1_scores.append(f1)
[?2004l[?2004h>         if not np.isnan(delta):
[?2004l[?2004h>             deltas.append(delta)
[?2004l[?2004h>     
[?2004l[?2004h>     # Average F1 (include all images with F1=0 for missing)
[?2004l[?2004h>     avg_f1 = np.mean(f1_scores)
[?2004l[?2004h>     
[?2004l[?2004h>     # Average delta (only over images where matches were found)
[?2004l[?2004h>     if len(deltas) > 0:
[?2004l[?2004h>         avg_delta = np.mean(deltas)
[?2004l[?2004h>     else:
[?2004l[?2004h>         avg_delta = np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     return (avg_f1, avg_delta, min_samples, epsilon, shape_weight)
[?2004l[?2004h> 
[?2004l[?2004h> def is_pareto_optimal(costs, idx):
[?2004l[?2004h>     """Check if point at idx is Pareto optimal.
[?2004l[?2004h>     costs: array of (f1, delta) where we maximize f1 and minimize delta.
[?2004l[?2004h>     """
[?2004l[?2004h>     f1_idx, delta_idx = costs[idx]
[?2004l[?2004h>     
[?2004l[?2004h>     for i, (f1_i, delta_i) in enumerate(costs):
[?2004l[?2004h>         if i == idx:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Check if point i dominates point idx
[?2004l[?2004h>         # i dominates idx if: f1_i >= f1_idx AND delta_i <= delta_idx AND at least one is strictly better
[?2004l[?2004h>         if f1_i >= f1_idx and delta_i <= delta_idx and (f1_i > f1_idx or delta_i < delta_idx):
[?2004l[?2004h>             return False
[?2004l[?2004h>     return True
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     print("Loading data...")
[?2004l[?2004h>     citsci_df = pd.read_csv('/root/data/citsci_train.csv')
[?2004l[?2004h>     expert_df = pd.read_csv('/root/data/expert_train.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Citizen science annotations: {len(citsci_df)}")
[?2004l[?2004h>     print(f"Expert annotations: {len(expert_df)}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Get all unique images from expert dataset
[?2004l[?2004h>     all_images = expert_df['file_rad'].unique()
[?2004l[?2004h>     print(f"Unique images in expert dataset: {len(all_images)}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Define hyperparameter grid
[?2004l[?2004h>     min_samples_range = list(range(3, 10))  # 3-9
[?2004l[?2004h>     epsilon_range = list(range(4, 26, 2))  # 4, 6, 8, ..., 24
[?2004l[?2004h>     shape_weight_range = [round(0.9 + i * 0.1, 1) for i in range(11)]  # 0.9-1.9
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nGrid search parameters:")
[?2004l[?2004h>     print(f"min_samples: {min_samples_range}")
[?2004l[?2004h>     print(f"epsilon: {epsilon_range}")
[?2004l[?2004h>     print(f"shape_weight: {shape_weight_range}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Generate all combinations
[?2004l[?2004h>     param_combinations = list(product(min_samples_range, epsilon_range, shape_weight_range))
[?2004l[?2004h>     print(f"\nTotal combinations: {len(param_combinations)}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Prepare arguments for parallel processing
[?2004l[?2004h>     args_list = [(ms, eps, sw, citsci_df, expert_df, all_images) 
[?2004l[?2004h>                  for ms, eps, sw in param_combinations]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nUsing {cpu_count()} CPU cores for parallel processing...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Run parallel evaluation
[?2004l[?2004h>     with Pool(cpu_count()) as pool:
[?2004l[?2004h>         results = pool.map(evaluate_hyperparams, args_list)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nCompleted {len(results)} evaluations")
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter results with F1 > 0.5
[?2004l[?2004h>     filtered_results = [(f1, delta, ms, eps, sw) 
[?2004l[?2004h>                         for f1, delta, ms, eps, sw in results 
[?2004l[?2004h>                         if f1 > 0.5 and not np.isnan(delta)]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Results with F1 > 0.5: {len(filtered_results)}")
[?2004l[?2004h>     
[?2004l[?2004h>     if len(filtered_results) == 0:
[?2004l[?2004h>         print("No results with F1 > 0.5 found!")
[?2004l[?2004h>         return
[?2004l[?2004h>     
[?2004l[?2004h>     # Find Pareto frontier
[?2004l[?2004h>     costs = np.array([(f1, delta) for f1, delta, _, _, _ in filtered_results])
[?2004l[?2004h>     pareto_indices = [i for i in range(len(filtered_results)) if is_pareto_optimal(costs, i)]
[?2004l[?2004h>     
[?2004l[?2004h>     pareto_results = [filtered_results[i] for i in pareto_indices]
[?2004l[?2004h>     print(f"Pareto optimal solutions: {len(pareto_results)}")
[?2004l[?2004h>     
