[303.669875, "i", "cat > optimize_dbscan_v2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\nfrom multiprocessing import Pool\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef custom_distance_matrix(X, w):\n    \"\"\"Compute pairwise distance matrix with custom metric.\"\"\"\n    n = len(X)\n    D = np.zeros((n, n))\n    for i in range(n):\n        for j in range(i+1, n):\n            dx = X[i, 0] - X[j, 0]\n            dy = X[i, 1] - X[j, 1]\n            d = np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\n            D[i, j] = d\n            D[j, i] = d\n    return D\n\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\n    \"\"\"Greedy matching using standard Euclidean.\"\"\"\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\n        return [], []\n    \n    distances = cdist(cluster_centroids, expert_points, metric='euclidean')\n    \n    matched_clusters = []\n    matched_experts = []\n    used_clusters = set()\n    used_ex"]
[303.669922, "i", "perts = set()\n    \n    while True:\n        masked_dist = distances.copy()\n        for i in used_clusters:\n            masked_dist[i, :] = np.inf\n        for j in used_experts:\n            masked_dist[:, j] = np.inf\n        \n        min_val = masked_dist.min()\n        if min_val > max_dist or min_val == np.inf:\n            break\n        \n        i, j = np.unravel_index(masked_dist.argmin(), masked_dist.shape)\n        matched_clusters.append(i)\n        matched_experts.append(j)\n        used_clusters.add(i)\n        used_experts.add(j)\n    \n    return matched_clusters, matched_experts\n\ndef compute_f1_delta_for_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    \"\"\"Compute F1 and delta for a single image.\"\"\"\n    if len(citsci_points) == 0:\n        return 0.0, np.nan\n    \n    dist_matrix = custom_distance_matrix(citsci_points, shape_weight)\n    db = DBSCAN(eps=epsilon, min_samples=min_samples, metric='precomputed')\n    labels = db.fit_predict(dist_matrix)\n    \n    unique_labels = set(labels"]
[303.669929, "i", ")\n    if -1 in unique_labels:\n        unique_labels.remove(-1)\n    \n    if len(unique_labels) == 0:\n        return 0.0, np.nan\n    \n    centroids = []\n    for label in unique_labels:\n        cluster_points = citsci_points[labels == label]\n        centroid = cluster_points.mean(axis=0)\n        centroids.append(centroid)\n    \n    centroids = np.array(centroids)\n    matched_clusters, matched_experts = greedy_match(centroids, expert_points)\n    \n    n_matches = len(matched_clusters)\n    n_clusters = len(centroids)\n    n_experts = len(expert_points)\n    \n    if n_matches == 0:\n        return 0.0, np.nan\n    \n    precision = n_matches / n_clusters if n_clusters > 0 else 0\n    recall = n_matches / n_experts if n_experts > 0 else 0\n    \n    if precision + recall == 0:\n        f1 = 0.0\n    else:\n        f1 = 2 * precision * recall / (precision + recall)\n    \n    if n_matches > 0:\n        deltas = []\n        for c_idx, e_idx in zip(matched_clusters, matched_experts):\n            dist = np.linalg.norm(centroids[c_idx] -"]
[303.669937, "i", " expert_points[e_idx])\n            deltas.append(dist)\n        delta = np.mean(deltas)\n    else:\n        delta = np.nan\n    \n    return f1, delta\n\ndef evaluate_hyperparams(args):\n    \"\"\"Evaluate a single hyperparameter combination.\"\"\"\n    min_samples, epsilon, shape_weight, image_data = args\n    \n    f1_scores = []\n    deltas = []\n    \n    for citsci_points, expert_points in image_data:\n        f1, delta = compute_f1_delta_for_image(citsci_points, expert_points, min_samples, epsilon, shape_weight)\n        \n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    \n    avg_f1 = np.mean(f1_scores)\n    \n    if len(deltas) > 0:\n        avg_delta = np.mean(deltas)\n    else:\n        avg_delta = np.nan\n    \n    return (avg_f1, avg_delta, min_samples, epsilon, shape_weight)\n\ndef is_pareto_optimal(costs, idx):\n    \"\"\"Check if point at idx is Pareto optimal.\"\"\"\n    f1_idx, delta_idx = costs[idx]\n    \n    for i, (f1_i, delta_i) in enumerate(costs):\n        if i == idx:\n           "]
[303.669944, "i", " continue\n        if f1_i >= f1_idx and delta_i <= delta_idx and (f1_i > f1_idx or delta_i < delta_idx):\n            return False\n    return True\n\ndef main():\n    print(\"Loading data...\")\n    citsci_df = pd.read_csv('/root/data/citsci_train.csv')\n    expert_df = pd.read_csv('/root/data/expert_train.csv')\n    \n    print(f\"Citizen science annotations: {len(citsci_df)}\")\n    print(f\"Expert annotations: {len(expert_df)}\")\n    \n    # Get all unique images from expert dataset\n    all_images = expert_df['file_rad'].unique()\n    print(f\"Unique images in expert dataset: {len(all_images)}\")\n    \n    # Pre-process data into list of (citsci_points, expert_points) for each image\n    print(\"Pre-processing image data...\")\n    image_data = []\n    for file_rad in all_images:\n        citsci_points = citsci_df[citsci_df['file_rad'] == file_rad][['x', 'y']].values\n        expert_points = expert_df[expert_df['file_rad'] == file_rad][['x', 'y']].values\n        image_data.append((citsci_points, expert_points))\n    \n    # Define hyp"]
[303.66995, "i", "erparameter grid\n    min_samples_range = list(range(3, 10))  # 3-9\n    epsilon_range = list(range(4, 26, 2))  # 4, 6, 8, ..., 24\n    shape_weight_range = [round(0.9 + i * 0.1, 1) for i in range(11)]  # 0.9-1.9\n    \n    print(f\"\\nGrid search parameters:\")\n    print(f\"min_samples: {min_samples_range}\")\n    print(f\"epsilon: {epsilon_range}\")\n    print(f\"shape_weight: {shape_weight_range}\")\n    \n    param_combinations = list(product(min_samples_range, epsilon_range, shape_weight_range))\n    print(f\"\\nTotal combinations: {len(param_combinations)}\")\n    \n    # Prepare arguments - share image_data across all workers\n    args_list = [(ms, eps, sw, image_data) for ms, eps, sw in param_combinations]\n    \n    # Use fewer processes to avoid memory issues\n    n_processes = min(32, len(param_combinations))\n    print(f\"\\nUsing {n_processes} processes for parallel processing...\")\n    \n    with Pool(n_processes) as pool:\n        results = pool.map(evaluate_hyperparams, args_list)\n    \n    print(f\"\\nCompleted {len(results)} ev"]
[303.669956, "i", "aluations\")\n    \n    # Filter results with F1 > 0.5\n    filtered_results = [(f1, delta, ms, eps, sw) \n                        for f1, delta, ms, eps, sw in results \n                        if f1 > 0.5 and not np.isnan(delta)]\n    \n    print(f\"Results with F1 > 0.5: {len(filtered_results)}\")\n    \n    if len(filtered_results) == 0:\n        print(\"No results with F1 > 0.5 found!\")\n        return\n    \n    # Find Pareto frontier\n    costs = np.array([(f1, delta) for f1, delta, _, _, _ in filtered_results])\n    pareto_indices = [i for i in range(len(filtered_results)) if is_pareto_optimal(costs, i)]\n    \n    pareto_results = [filtered_results[i] for i in pareto_indices]\n    print(f\"Pareto optimal solutions: {len(pareto_results)}\")\n    \n    pareto_results.sort(reverse=True)\n    \n    with open('/root/pareto_frontier.csv', 'w') as f:\n        f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\n        for f1, delta, ms, eps, sw in pareto_results:\n            f.write(f'{f1:.5f},{delta:.5f},{ms},{eps},{sw:.1f}\\n')\n   "]
[303.669962, "i", " \n    print(f\"\\nWrote {len(pareto_results)} Pareto optimal solutions to /root/pareto_frontier.csv\")\n    \n    print(\"\\nTop Pareto optimal solutions:\")\n    for i, (f1, delta, ms, eps, sw) in enumerate(pareto_results[:10]):\n        print(f\"{i+1}. F1={f1:.5f}, delta={delta:.5f}, min_samples={ms}, epsilon={eps}, shape_weight={sw:.1f}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
