[902.339555, "i", "cat>/root/opt.py<<'Z'\nimport pandas as pd;import numpy as np;from sklearn.cluster import DBSCAN;from scipy.spatial.distance import cdist;from itertools import product\ndef dm(X,w):n=len(X);D=np.zeros((n,n));\n for i in range(n):\n  for j in range(i+1,n):dx=X[i,0]-X[j,0];dy=X[i,1]-X[j,1];d=np.sqrt((w*dx)**2+((2-w)*dy)**2);D[i,j]=d;D[j,i]=d\n return D\ndef gm(c,e,m=100):\n if len(c)==0 or len(e)==0:return[],[]\n d=cdist(c,e);mc,me,uc,ue=[],[],set(),set()\n while True:\n  md=d.copy()\n  for i in uc:md[i,:]=np.inf\n  for j in ue:md[:,j]=np.inf\n  mv=md.min()\n  if mv>m or mv==np.inf:break\n  i,j=np.unravel_index(md.argmin(),md.shape);mc.append(i);me.append(j);uc.add(i);ue.add(j)\n return mc,me\ndef ev(c,e,ms,ep,sw):\n if len(c)==0:return 0.,np.nan\n D=dm(c,sw);l=DBSCAN(eps=ep,min_samples=ms,metric='precomputed').fit_predict(D);u=set(l)\n if -1 in u:u.remove(-1)\n if len(u)==0:return 0.,np.nan\n ct=np.array([c[l==x].mean(axis=0)for x in u]);mc,me=gm(ct,e);nm=len(mc)\n if nm==0:return 0.,np.nan\n p=nm/len(ct);r=nm/len(e);f1=2*p*r/(p+r)if"]
