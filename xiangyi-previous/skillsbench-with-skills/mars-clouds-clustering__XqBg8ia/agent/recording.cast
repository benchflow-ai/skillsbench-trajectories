[1119.849251, "i", "python3<<'EOF'>/root/out.log 2>&1\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\nprint('Starting')\ncs=pd.read_csv('/root/data/citsci_train.csv')[['file_rad','x','y']]\nex=pd.read_csv('/root/data/expert_train.csv')[['file_rad','x','y']]\nim=ex['file_rad'].unique()\nid={i:(cs[cs['file_rad']==i][['x','y']].values,ex[ex['file_rad']==i][['x','y']].values)for i in im}\ndef dm(X,w):\n n=len(X);D=np.zeros((n,n))\n for i in range(n):\n  for j in range(i+1,n):\n   D[i,j]=D[j,i]=np.sqrt((w*(X[i,0]-X[j,0]))**2+((2-w)*(X[i,1]-X[j,1]))**2)\n return D\ndef gm(c,e):\n if len(c)==0 or len(e)==0:return[],[]\n d=cdist(c,e);mc,me,uc,ue=[],[],set(),set()\n while True:\n  md=d.copy()\n  for i in uc:md[i,:]=1e9\n  for j in ue:md[:,j]=1e9\n  if md.min()>100:break\n  i,j=np.unravel_index(md.argmin(),md.shape);mc.append(i);me.append(j);uc.add(i);ue.add(j)\n return mc,me\ndef ev(c,e,ms,ep,sw):\n if len(c)==0:return 0.,np.nan\n l=DBSCAN(eps=ep,min_samples=ms,met"]
