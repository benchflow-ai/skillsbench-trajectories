[65.123702, "o", "> "]
[65.139502, "o", "    recall = n_matches / n_experts if n_experts > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if precision + recall == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         f1 = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         f1 = 2 * precision * recall / (precision + recall)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Compute delta (average standard Euclidean distance for matched pairs)\r\n\u001b[?2004l\r\u001b[?2004h>     if n_matches > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         deltas = []\r\n\u001b[?2004l\r\u001b[?2004h>         for c_idx, e_idx in zip(matched_clusters, matched_experts):\r\n\u001b[?2004l\r\u001b[?2004h>             dist = np.linalg.norm(centroids[c_idx] - expert_points[e_idx])\r\n\u001b[?2004l\r\u001b[?2004h>             deltas.append(dist)\r\n\u001b[?2004l\r\u001b[?2004h>         delta = np.mean(deltas)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         delta = np.nan\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return f1, delta\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def evaluate_hyperparams(args):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Evaluate a si"]
[65.139611, "o", "ngle hyperparameter combination.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     min_samples, epsilon, shape_weight, citsci_df, expert_df, all_images = args\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     f1_scores = []\r\n\u001b[?2004l\r\u001b[?2004h>     deltas = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for file_rad in all_images:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.139673, "o", "        # Get points for this image\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.139714, "o", "> "]
[65.140136, "o", "        citsci_img = citsci_df[citsci_df['file_rad'] == file_rad][['x', 'y']].values\r\n\u001b[?2004l\r"]
[65.140192, "o", "\u001b[?2004h> "]
[65.140599, "o", "        expert_img = expert_df[expert_df['file_rad'] == file_rad][['x', 'y']].values\r\n\u001b[?2004l\r"]
[65.140631, "o", "\u001b[?2004h> "]
[65.140678, "o", "        \r\n"]
[65.140717, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.140967, "o", "        f1, delta = compute_f1_delta_for_image(citsci_img, expert_img, min_samples, epsilon, shape_weight)\r\n"]
[65.140998, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.141028, "o", "        \r\n"]
[65.141055, "o", "\u001b[?2004l\r\u001b[?2004h"]
[65.141081, "o", "> "]
[65.141142, "o", "        f1_scores.append(f1)\r\n\u001b[?2004l\r"]
[65.141176, "o", "\u001b[?2004h> "]
[65.14126, "o", "        if not np.isnan(delta):\r\n"]
[65.141289, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.141377, "o", "            deltas.append(delta)\r\n"]
[65.141406, "o", "\u001b[?2004l\r\u001b[?2004h"]
[65.141434, "o", ">     \r\n\u001b[?2004l\r"]
[65.14146, "o", "\u001b[?2004h> "]
[65.141611, "o", "    # Average F1 (include all images with F1=0 for missing)\r\n"]
[65.14164, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.141728, "o", "    avg_f1 = np.mean(f1_scores)\r\n"]
[65.14176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.141787, "o", "    \r\n\u001b[?2004l\r"]
[65.141813, "o", "\u001b[?2004h> "]
[65.141966, "o", "    # Average delta (only over images where matches were found)\r\n"]
[65.141994, "o", "\u001b[?2004l\r\u001b[?2004h"]
[65.14202, "o", "> "]
[65.142072, "o", "    if len(deltas) > 0:\r\n"]
[65.1421, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.142199, "o", "        avg_delta = np.mean(deltas)\r\n\u001b[?2004l\r"]
[65.142226, "o", "\u001b[?2004h> "]
[65.142253, "o", "    else:"]
[65.14228, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.142305, "o", "> "]
[65.142363, "o", "        avg_delta = np.nan\r\n"]
[65.142393, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.14242, "o", "    \r\n\u001b[?2004l\r"]
[65.142446, "o", "\u001b[?2004h> "]
[65.142609, "o", "    return (avg_f1, avg_delta, min_samples, epsilon, shape_weight)\r\n"]
[65.142637, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.142663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.142689, "o", "> "]
[65.142769, "o", "def is_pareto_optimal(costs, idx):\r\n"]
[65.142797, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.142925, "o", "    \"\"\"Check if point at idx is Pareto optimal.\r\n"]
[65.142953, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.143142, "o", "    costs: array of (f1, delta) where we maximize f1 and minimize delta.\r\n\u001b[?2004l\r"]
[65.143182, "o", "\u001b[?2004h> "]
[65.143209, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[65.143235, "o", "\u001b[?2004h> "]
[65.143344, "o", "    f1_idx, delta_idx = costs[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.143374, "o", ">     \r\n\u001b[?2004l\r"]
[65.143401, "o", "\u001b[?2004h> "]
[65.143526, "o", "    for i, (f1_i, delta_i) in enumerate(costs):\r\n\u001b[?2004l\r"]
[65.143557, "o", "\u001b[?2004h> "]
[65.143602, "o", "        if i == idx:"]
[65.14363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.143656, "o", "> "]
[65.143682, "o", "            continue\r\n\u001b[?2004l\r"]
[65.143708, "o", "\u001b[?2004h> "]
[65.143798, "o", "        # Check if point i dominates point idx\r\n\u001b[?2004l\r"]
[65.143826, "o", "\u001b[?2004h> "]
[65.144036, "o", "        # i dominates idx if: f1_i >= f1_idx AND delta_i <= delta_idx AND at least one is strictly better\r\n\u001b[?2004l\r"]
[65.144066, "o", "\u001b[?2004h> "]
[65.144243, "o", "        if f1_i >= f1_idx and delta_i <= delta_idx and (f1_i > f1_idx or delta_i < delta_idx):\r\n\u001b[?2004l\r"]
[65.144275, "o", "\u001b[?2004h> "]
[65.144323, "o", "            return False\r\n\u001b[?2004l\r"]
[65.144351, "o", "\u001b[?2004h> "]
[65.144379, "o", "    return True\r\n"]
[65.144406, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.144431, "o", "\u001b[?2004h> "]
[65.144458, "o", "def main():\r\n\u001b[?2004l\r"]
[65.144483, "o", "\u001b[?2004h> "]
[65.144543, "o", "    print(\"Loading data...\")\r\n\u001b[?2004l\r"]
[65.144574, "o", "\u001b[?2004h> "]
[65.144683, "o", "    citsci_df = pd.read_csv('/root/data/citsci_train.csv')\r\n\u001b[?2004l\r"]
[65.144708, "o", "\u001b[?2004h> "]
[65.144825, "o", "    expert_df = pd.read_csv('/root/data/expert_train.csv')\r\n\u001b[?2004l\r"]
[65.144849, "o", "\u001b[?2004h> "]
[65.14487, "o", "    \r\n\u001b[?2004l\r"]
[65.144891, "o", "\u001b[?2004h> "]
[65.14501, "o", "    print(f\"Citizen science annotations: {len(citsci_df)}\")\r\n"]
[65.145034, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.145139, "o", "    print(f\"Expert annotations: {len(expert_df)}\")\r\n\u001b[?2004l\r"]
[65.145162, "o", "\u001b[?2004h> "]
[65.14519, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.145211, "o", "> "]
[65.1453, "o", "    # Get all unique images from expert dataset\r\n\u001b[?2004l\r"]
[65.145324, "o", "\u001b[?2004h> "]
[65.145423, "o", "    all_images = expert_df['file_rad'].unique()\r\n\u001b[?2004l\r"]
[65.14545, "o", "\u001b[?2004h> "]
[65.145578, "o", "    print(f\"Unique images in expert dataset: {len(all_images)}\")\r\n\u001b[?2004l\r"]
[65.14561, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.145634, "o", "\u001b[?2004h> "]
[65.145707, "o", "    # Define hyperparameter grid\r\n\u001b[?2004l\r"]
[65.145737, "o", "\u001b[?2004h> "]
[65.145835, "o", "    min_samples_range = list(range(3, 10))  # 3-9\r\n\u001b[?2004l\r"]
[65.145867, "o", "\u001b[?2004h> "]
[65.145984, "o", "    epsilon_range = list(range(4, 26, 2))  # 4, 6, 8, ..., 24\r\n\u001b[?2004l\r"]
[65.146019, "o", "\u001b[?2004h> "]
[65.146177, "o", "    shape_weight_range = [round(0.9 + i * 0.1, 1) for i in range(11)]  # 0.9-1.9\r\n\u001b[?2004l\r"]
[65.146218, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.146245, "o", "> "]
[65.146312, "o", "    print(f\"\\nGrid search parameters:\")\r\n\u001b[?2004l\r"]
[65.146342, "o", "\u001b[?2004h> "]
[65.146432, "o", "    print(f\"min_samples: {min_samples_range}\")\r\n\u001b[?2004l\r"]
[65.146463, "o", "\u001b[?2004h> "]
[65.146537, "o", "    print(f\"epsilon: {epsilon_range}\")\r\n\u001b[?2004l\r"]
[65.146567, "o", "\u001b[?2004h> "]
[65.14666, "o", "    print(f\"shape_weight: {shape_weight_range}\")\r\n\u001b[?2004l\r"]
[65.146692, "o", "\u001b[?2004h>     \r\n"]
[65.146717, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.146791, "o", "    # Generate all combinations\r\n\u001b[?2004l\r"]
[65.14682, "o", "\u001b[?2004h> "]
[65.146998, "o", "    param_combinations = list(product(min_samples_range, epsilon_range, shape_weight_range))\r\n\u001b[?2004l\r"]
[65.147034, "o", "\u001b[?2004h> "]
[65.147148, "o", "    print(f\"\\nTotal combinations: {len(param_combinations)}\")\r\n\u001b[?2004l\r"]
[65.14719, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.147218, "o", "\u001b[?2004h> "]
[65.147304, "o", "    # Prepare arguments for parallel processing\r\n\u001b[?2004l\r"]
[65.147336, "o", "\u001b[?2004h> "]
[65.147477, "o", "    args_list = [(ms, eps, sw, citsci_df, expert_df, all_images) \r\n\u001b[?2004l\r"]
[65.147531, "o", "\u001b[?2004h> "]
[65.147651, "o", "                 for ms, eps, sw in param_combinations]\r\n"]
[65.147681, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.147705, "o", "    \r\n"]
[65.147717, "o", "\u001b[?2004l\r"]
[65.147727, "o", "\u001b[?2004h"]
[65.147737, "o", "> "]
[65.147917, "o", "    print(f\"\\nUsing {cpu_count()} CPU cores for parallel processing...\")\r\n"]
[65.147928, "o", "\u001b[?2004l\r"]
[65.147938, "o", "\u001b[?2004h"]
[65.147949, "o", "> "]
[65.147973, "o", "    \r\n"]
[65.147984, "o", "\u001b[?2004l\r"]
[65.147994, "o", "\u001b[?2004h"]
[65.148004, "o", "> "]
[65.148092, "o", "    # Run parallel evaluation\r\n"]
[65.148102, "o", "\u001b[?2004l\r"]
[65.148112, "o", "\u001b[?2004h"]
[65.148123, "o", "> "]
[65.14822, "o", "    with Pool(cpu_count()) as pool:\r\n\u001b[?2004l\r"]
[65.148248, "o", "\u001b[?2004h"]
[65.148259, "o", "> "]
[65.148407, "o", "        results = pool.map(evaluate_hyperparams, args_list)\r\n"]
[65.148424, "o", "\u001b[?2004l\r\u001b[?2004h"]
[65.148447, "o", "> "]
[65.148458, "o", "    "]
[65.148468, "o", "\r\n\u001b[?2004l\r"]
[65.148491, "o", "\u001b[?2004h"]
[65.148502, "o", "> "]
[65.148633, "o", "    print(f\"\\nCompleted {len(results)} evaluations\")\r\n"]
[65.148643, "o", "\u001b[?2004l\r"]
[65.148665, "o", "\u001b[?2004h"]
[65.148676, "o", "> "]
[65.148722, "o", "    \r\n"]
[65.148732, "o", "\u001b[?2004l\r"]
[65.148742, "o", "\u001b[?2004h"]
[65.148752, "o", "> "]
[65.148952, "o", "    # Filter results with F1 > 0.5\r\n"]
[65.148962, "o", "\u001b[?2004l\r"]
[65.149008, "o", "\u001b[?2004h"]
[65.149033, "o", "> "]
[65.149161, "o", "    filtered_results = [(f1, delta, ms, eps, sw) \r\n"]
[65.149174, "o", "\u001b[?2004l\r"]
[65.149184, "o", "\u001b[?2004h"]
[65.149193, "o", "> "]
[65.149354, "o", "                        for f1, delta, ms, eps, sw in results \r\n"]
[65.149364, "o", "\u001b[?2004l\r"]
[65.149386, "o", "\u001b[?2004h"]
[65.14941, "o", "> "]
[65.149571, "o", "                        if f1 > 0.5 and not np.isnan(delta)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.149593, "o", "> "]
[65.149659, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.149788, "o", "    print(f\"Results with F1 > 0.5: {len(filtered_results)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.1498, "o", "> "]
[65.149809, "o", "    "]
[65.149818, "o", "\r\n\u001b[?2004l\r"]
[65.149844, "o", "\u001b[?2004h"]
[65.149857, "o", "> "]
[65.14995, "o", "    if len(filtered_results) == 0:\r\n"]
[65.149961, "o", "\u001b[?2004l\r"]
[65.149971, "o", "\u001b[?2004h"]
[65.14998, "o", "> "]
[65.150115, "o", "        print(\"No results with F1 > 0.5 found!\")\r\n\u001b[?2004l\r"]
[65.150142, "o", "\u001b[?2004h"]
[65.150153, "o", "> "]
[65.150202, "o", "        return\r\n"]
[65.150209, "o", "\u001b[?2004l\r"]
[65.150229, "o", "\u001b[?2004h"]
[65.150239, "o", "> "]
[65.150262, "o", "    \r\n"]
[65.150272, "o", "\u001b[?2004l\r"]
[65.150296, "o", "\u001b[?2004h"]
[65.150305, "o", "> "]
[65.150385, "o", "    # Find Pareto frontier\r\n\u001b[?2004l\r"]
[65.150411, "o", "\u001b[?2004h"]
[65.15042, "o", "> "]
[65.150617, "o", "    costs = np.array([(f1, delta) for f1, delta, _, _, _ in filtered_results])\r\n\u001b[?2004l\r"]
[65.150646, "o", "\u001b[?2004h"]
[65.150655, "o", "> "]
[65.150897, "o", "    pareto_indices = [i for i in range(len(filtered_results)) if is_pareto_optimal(costs, i)]\r\n\u001b[?2004l\r"]
[65.150956, "o", "\u001b[?2004h> "]
[65.150965, "o", "    \r\n\u001b[?2004l\r"]
[65.151009, "o", "\u001b[?2004h"]
[65.151017, "o", "> "]
[65.151202, "o", "    pareto_results = [filtered_results[i] for i in pareto_indices]\r\n"]
[65.151211, "o", "\u001b[?2004l\r"]
[65.151219, "o", "\u001b[?2004h"]
[65.151244, "o", "> "]
[65.151476, "o", "    print(f\"Pareto optimal solutions: {len(pareto_results)}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.15152, "o", "\u001b[?2004h> "]
[65.151541, "o", "    # Sort by F1 score (descending)\r\n\u001b[?2004l\r"]
[65.151572, "o", "\u001b[?2004h"]
[65.151578, "o", "> "]
[65.151771, "o", "    pareto_results.sort(reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.151808, "o", "    # Write to CSV\r\n\u001b[?2004l\r"]
[65.151832, "o", "\u001b[?2004h> "]
[65.152025, "o", "    with open('/root/pareto_frontier.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.152191, "o", "        f.write('F1,delta,min_samples,epsilon,shape_weight\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.152201, "o", "> "]
[65.152347, "o", "        for f1, delta, ms, eps, sw in pareto_results:\r\n\u001b[?2004l\r"]
[65.152353, "o", "\u001b[?2004h"]
[65.152368, "o", "> "]
[65.152596, "o", "            f.write(f'{f1:.5f},{delta:.5f},{ms},{eps},{sw:.1f}\\n')\r\n\u001b[?2004l\r"]
[65.15261, "o", "\u001b[?2004h"]
[65.152635, "o", "> "]
[65.152719, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.153042, "o", "    print(f\"\\nWrote {len(pareto_results)} Pareto optimal solutions to /root/pareto_frontier.csv\")\r\n\u001b[?2004l\r"]
[65.153053, "o", "\u001b[?2004h"]
[65.153082, "o", "> "]
[65.153101, "o", "    "]
[65.153107, "o", "\r\n\u001b[?2004l\r"]
[65.153171, "o", "\u001b[?2004h> "]
[65.153247, "o", "    # Display first few results\r\n\u001b[?2004l\r"]
[65.153274, "o", "\u001b[?2004h"]
[65.153289, "o", "> "]
[65.153419, "o", "    print(\"\\nTop Pareto optimal solutions:\")\r\n\u001b[?2004l\r"]
[65.153447, "o", "\u001b[?2004h"]
[65.15346, "o", "> "]
[65.153652, "o", "    for i, (f1, delta, ms, eps, sw) in enumerate(pareto_results[:10]):\r\n\u001b[?2004l\r"]
[65.153681, "o", "\u001b[?2004h"]
[65.153698, "o", "> "]
[65.153977, "o", "        print(f\"{i+1}. F1={f1:.5f}, delta={delta:.5f}, min_samples={ms}, epsilon={eps}, shape_weight={sw:.1f}\")\r\n\u001b[?2004l\r"]
[65.154016, "o", "\u001b[?2004h> \r\n"]
[65.154032, "o", "\u001b[?2004l\r"]
[65.15407, "o", "\u001b[?2004h> "]
[65.154154, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[65.154191, "o", "\u001b[?2004h"]
