[65.114885, "i", "   return 0.0, np.nan\n    \n    precision = n_matches / n_clusters if n_clusters > 0 else 0\n    recall = n_matches / n_experts if n_experts > 0 else 0\n    \n    if precision + recall == 0:\n        f1 = 0.0\n    else:\n        f1 = 2 * precision * recall / (precision + recall)\n    \n    # Compute delta (average standard Euclidean distance for matched pairs)\n    if n_matches > 0:\n        deltas = []\n        for c_idx, e_idx in zip(matched_clusters, matched_experts):\n            dist = np.linalg.norm(centroids[c_idx] - expert_points[e_idx])\n            deltas.append(dist)\n        delta = np.mean(deltas)\n    else:\n        delta = np.nan\n    \n    return f1, delta\n\ndef evaluate_hyperparams(args):\n    \"\"\"Evaluate a single hyperparameter combination.\"\"\"\n    min_samples, epsilon, shape_weight, citsci_df, expert_df, all_images = args\n    \n    f1_scores = []\n    deltas = []\n    \n    for file_rad in all_images:\n        # Get points for this image\n        citsci_img = citsci_df[citsci_df['file_rad'] == file_rad][['x', 'y']].va"]
