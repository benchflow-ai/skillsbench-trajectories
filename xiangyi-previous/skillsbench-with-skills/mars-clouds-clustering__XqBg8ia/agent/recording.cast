[408.627665, "i", "cat > optimize_dbscan_v3.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef custom_distance_matrix(X, w):\n    \"\"\"Compute pairwise distance matrix with custom metric.\"\"\"\n    n = len(X)\n    D = np.zeros((n, n))\n    for i in range(n):\n        for j in range(i+1, n):\n            dx = X[i, 0] - X[j, 0]\n            dy = X[i, 1] - X[j, 1]\n            d = np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\n            D[i, j] = d\n            D[j, i] = d\n    return D\n\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\n    \"\"\"Greedy matching using standard Euclidean.\"\"\"\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\n        return [], []\n    \n    distances = cdist(cluster_centroids, expert_points, metric='euclidean')\n    \n    matched_clusters = []\n    matched_experts = []\n    used_clusters = set()\n    used_experts = set()\n    \n    while True"]
[408.628012, "o", "cat > optimize_dbscan_v3.py << 'EOF'\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.cluster import DBSCAN\r\nfrom scipy.spatial.distance import cdist\r\nfrom itertools import product\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\ndef custom_distance_matrix(X, w):\r\n    \"\"\"Compute pairwise distance matrix with custom metric.\"\"\"\r\n    n = len(X)\r\n    D = np.zeros((n, n))\r\n    for i in range(n):\r\n        for j in range(i+1, n):\r\n            dx = X[i, 0] - X[j, 0]\r\n            dy = X[i, 1] - X[j, 1]\r\n            d = np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\r\n            D[i, j] = d\r\n            D[j, i] = d\r\n    return D\r\n\r\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\r\n    \"\"\"Greedy matching using standard Euclidean.\"\"\"\r\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\r\n        return [], []\r\n    \r\n    distances = cdist(cluster_centroids, expert_points, metric='euclidean')\r\n    \r\n    matched_clusters = []\r\n    matched_experts = []\r\n    used_clusters = set()\r\n    used_exp"]
[408.628165, "i", ":\n        masked_dist = distances.copy()\n        for i in used_clusters:\n            masked_dist[i, :] = np.inf\n        for j in used_experts:\n            masked_dist[:, j] = np.inf\n        \n        min_val = masked_dist.min()\n        if min_val > max_dist or min_val == np.inf:\n            break\n        \n        i, j = np.unravel_index(masked_dist.argmin(), masked_dist.shape)\n        matched_clusters.append(i)\n        matched_experts.append(j)\n        used_clusters.add(i)\n        used_experts.add(j)\n    \n    return matched_clusters, matched_experts\n\ndef compute_f1_delta_for_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    \"\"\"Compute F1 and delta for a single image.\"\"\"\n    if len(citsci_points) == 0:\n        return 0.0, np.nan\n    \n    dist_matrix = custom_distance_matrix(citsci_points, shape_weight)\n    db = DBSCAN(eps=epsilon, min_samples=min_samples, metric='precomputed')\n    labels = db.fit_predict(dist_matrix)\n    \n    unique_labels = set(labels)\n    if -1 in unique_labels:\n   "]
