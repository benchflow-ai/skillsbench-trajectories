[65.115535, "o", "> "]
[65.11569, "o", "    \"\"\"Compute pairwise distance matrix with custom metric.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.115752, "o", "    n = len(X)\r\n\u001b[?2004l\r"]
[65.115798, "o", "\u001b[?2004h> "]
[65.115859, "o", "    D = np.zeros((n, n))\r\n\u001b[?2004l\r"]
[65.115925, "o", "\u001b[?2004h> "]
[65.115979, "o", "    for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.116086, "o", "        for j in range(i+1, n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.116138, "o", "> "]
[65.116201, "o", "            dx = X[i, 0] - X[j, 0]\r\n\u001b[?2004l\r"]
[65.116247, "o", "\u001b[?2004h> "]
[65.116331, "o", "            dy = X[i, 1] - X[j, 1]\r\n\u001b[?2004l\r"]
[65.116371, "o", "\u001b[?2004h> "]
[65.116529, "o", "            d = np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.116575, "o", "> "]
[65.116624, "o", "            D[i, j] = d\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.116664, "o", "> "]
[65.116706, "o", "            D[j, i] = d\r\n\u001b[?2004l\r"]
[65.116747, "o", "\u001b[?2004h> "]
[65.116795, "o", "    return D\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.116836, "o", "> "]
