[?2004hroot@46805214ad85:~# cat > /root/count_objects.py << 'EOF'
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import csv
[?2004l[?2004h> import glob
[?2004l[?2004h> 
[?2004l[?2004h> # Get all keyframe files sorted
[?2004l[?2004h> keyframe_files = sorted(glob.glob('/root/keyframes_*.png'))
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Convert keyframes to grayscale in place
[?2004l[?2004h> print("Converting keyframes to grayscale...")
[?2004l[?2004h> for kf in keyframe_files:
[?2004l[?2004h>     img = cv2.imread(kf)
[?2004l[?2004h>     gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     cv2.imwrite(kf, gray)
[?2004l[?2004h>     print(f"Converted {kf} to grayscale")
[?2004l[?2004h> 
[?2004l[?2004h> # Load template images and convert to grayscale
[?2004l[?2004h> print("\nLoading template images...")
[?2004l[?2004h> coin_template = cv2.imread('/root/coin.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> enemy_template = cv2.imread('/root/enemy.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> turtle_template = cv2.imread('/root/turtle.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Coin template size: {coin_template.shape}")
[?2004l[?2004h> print(f"Enemy template size: {enemy_template.shape}")
[?2004l[?2004h> print(f"Turtle template size: {turtle_template.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> def count_matches(frame, template, threshold=0.8):
[?2004l[?2004h>     """Count non-overlapping template matches in frame"""
[?2004l[?2004h>     if template is None or frame is None:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Ensure frame is larger than template
[?2004l[?2004h>     if frame.shape[0] < template.shape[0] or frame.shape[1] < template.shape[1]:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     result = cv2.matchTemplate(frame, template, cv2.TM_CCOEFF_NORMED)
[?2004l[?2004h>     locations = np.where(result >= threshold)
[?2004l[?2004h>     
[?2004l[?2004h>     # Get template dimensions
[?2004l[?2004h>     h, w = template.shape[:2]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use non-maximum suppression to avoid counting overlapping matches
[?2004l[?2004h>     matches = list(zip(*locations[::-1]))  # (x, y) format
[?2004l[?2004h>     
[?2004l[?2004h>     if len(matches) == 0:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Simple non-maximum suppression
[?2004l[?2004h>     filtered_matches = []
[?2004l[?2004h>     for pt in matches:
[?2004l[?2004h>         overlap = False
[?2004l[?2004h>         for existing in filtered_matches:
[?2004l[?2004h>             if abs(pt[0] - existing[0]) < w * 0.5 and abs(pt[1] - existing[1]) < h * 0.5:
[?2004l[?2004h>                 overlap = True
[?2004l[?2004h>                 break
[?2004l[?2004h>         if not overlap:
[?2004l[?2004h>             filtered_matches.append(pt)
[?2004l[?2004h>     
[?2004l[?2004h>     return len(filtered_matches)
[?2004l[?2004h> 
[?2004l[?2004h> # Process each keyframe and count objects
[?2004l[?2004h> results = []
[?2004l[?2004h> print("\nCounting objects in each frame...")
[?2004l[?2004h> 
[?2004l[?2004h> for kf in keyframe_files:
[?2004l[?2004h>     frame = cv2.imread(kf, cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h>     
[?2004l[?2004h>     # Count objects with different thresholds if needed
[?2004l[?2004h>     coins = count_matches(frame, coin_template, threshold=0.8)
[?2004l[?2004h>     enemies = count_matches(frame, enemy_template, threshold=0.8)
[?2004l[?2004h>     turtles = count_matches(frame, turtle_template, threshold=0.8)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{kf}: coins={coins}, enemies={enemies}, turtles={turtles}")
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'frame_id': kf,
[?2004l[?2004h>         'coins': coins,
[?2004l[?2004h>         'enemies': enemies,
[?2004l[?2004h>         'turtles': turtles
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> print("\nWriting results to CSV...")
[?2004l[?2004h> with open('/root/counting_results.csv', 'w', newline='') as csvfile:
[?2004l[?2004h>     fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']
[?2004l[?2004h>     writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     for row in results:
[?2004l[?2004h>         writer.writerow(row)
[?2004l[?2004h> 
[?2004l[?2004h> print("Done! Results saved to /root/counting_results.csv")
