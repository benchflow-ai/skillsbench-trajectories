[93.162529, "i", "python3 << 'EOF'\nimport cv2\nimport glob\n\nkeyframe_files = sorted(glob.glob('/root/keyframes_*.png'))\n\nfor kf in keyframe_files:\n    # Read as grayscale\n    img = cv2.imread(kf, cv2.IMREAD_GRAYSCALE)\n    # Save as single-channel grayscale\n    cv2.imwrite(kf, img)\n    print(f\"Re-saved {kf} as true grayscale\")\n\n# Verify\nimg = cv2.imread(keyframe_files[0])\nprint(f\"\\nVerification - Shape of first keyframe: {img.shape}\")\nEOF\n"]
