[53.36589, "o", "\u001b[?2004h> "]
[53.365965, "o", "print(\"\\nCounting objects in each frame...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.366024, "o", "for kf in keyframe_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.3661, "o", "    frame = cv2.imread(kf, cv2.IMREAD_GRAYSCALE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.366137, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.366235, "o", "    # Count objects with different thresholds if needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.36634, "o", "    coins = count_matches(frame, coin_template, threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.366457, "o", "    enemies = count_matches(frame, enemy_template, threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.366583, "o", "    turtles = count_matches(frame, turtle_template, threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[53.366617, "o", "\u001b[?2004h> "]
[53.366718, "o", "    print(f\"{kf}: coins={coins}, enemies={enemies}, turtles={turtles}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.36675, "o", ">     results.append({\r\n\u001b[?2004l\r"]
[53.366816, "o", "\u001b[?2004h>         'frame_id': kf,\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.366852, "o", "> "]
[53.366913, "o", "        'coins': coins,\r\n\u001b[?2004l\r\u001b[?2004h>         'enemies': enemies,\r\n\u001b[?2004l\r"]
[53.36695, "o", "\u001b[?2004h> "]
[53.367025, "o", "        'turtles': turtles\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.367061, "o", "> "]
[53.367121, "o", "# Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.367158, "o", "print(\"\\nWriting results to CSV...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.367266, "o", "with open('/root/counting_results.csv', 'w', newline='') as csvfile:\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.367303, "o", "> "]
[53.367374, "o", "    fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.367411, "o", "> "]
[53.36748, "o", "    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.367529, "o", "    writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.367567, "o", "> "]
[53.367655, "o", "    for row in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.367709, "o", "        writer.writerow(row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.367764, "o", "print(\"Done! Results saved to /root/counting_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.367801, "o", "> EOF\r\n\u001b[?2004l\r"]
[53.370579, "o", "\u001b[?2004hroot@46805214ad85:~# "]
