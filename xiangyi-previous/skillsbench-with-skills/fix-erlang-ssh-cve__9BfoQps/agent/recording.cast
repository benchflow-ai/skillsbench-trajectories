[76.228808, "o", "\r\n-define(CONNECTED(StateName),\r\n        (element(1,StateName) == connected orelse\r\n         element(1,StateName) == ext_info ) ).\r\n\r\n-spec handle_event(gen_statem:event_type(),\r\n\t\t   event_content(),\r\n\t\t   state_name(),\r\n\t\t   #data{}\r\n\t\t  ) -> gen_statem:event_handler_result(state_name()) .\r\n"]
