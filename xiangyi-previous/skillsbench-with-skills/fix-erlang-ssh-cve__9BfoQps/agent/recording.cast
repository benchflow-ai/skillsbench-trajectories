m\u001b[K                #ssh_msg_channel_eof{}               = Msg -> {keep_state, D1, \u001b[01;31m\u001b[K?CONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_close{}             = Msg -> {keep_state, D1, \u001b[01;31m\u001b[K?CONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1179\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_request{}           = Msg -> {keep_state, D1, \u001b[01;31m\u001b[K?CONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_failure{}           = Msg -> {keep_state, D1, \u001b[01;31m\u001b[K?CONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1181\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_success{}           = Msg -> {keep_state, D1, \u001b[01;31m\u001b[K?CONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n"]
