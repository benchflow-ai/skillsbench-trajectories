[23.056567, "o", "\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K         {next_event,internal,\u001b[01;31m\u001b[K{conn_msg,\u001b[m\u001b[KMsg}}]).\r\n\u001b[32m\u001b[K759\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(internal, \u001b[01;31m\u001b[K{conn_msg,\u001b[m\u001b[KMsg}, StateName, #data{connection_state = Connection0,\r\n"]
