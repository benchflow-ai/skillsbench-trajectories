[121.53476, "i", "cat <<EOF > /tmp/fix_ssh.py\nimport sys\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'r') as f:\n    lines = f.readlines()\n\nnew_lines = []\nskip = False\nfor line in lines:\n    if 'handle_event(internal, {conn_msg,_Msg}, StateName, D) when not (?CONNECTED(StateName) orelse renegotiation(StateName)) ->' in line:\n        skip = True\n        continue\n    if skip and ('{Shutdown, D1} = ?send_disconnect' in line or '{stop, Shutdown, D1};' in line):\n        continue\n    if skip and line.strip() == '':\n        skip = False\n        continue\n    \n    if 'handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,' in line:\n        new_lines.append(line)\n        new_lines.append('    case ?CONNECTED(StateName) orelse renegotiation(StateName) of\\n')\n        new_lines.append('        true ->\\n')\n        indent = \"            \"\n        continue\n    \n    if 'try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of' in line:\n        new_lines.append('            try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of\\n')\n        continue\n\n    # This is getting complicated with simple line by line. Let's use a more robust approach.\nEOF\n"]
