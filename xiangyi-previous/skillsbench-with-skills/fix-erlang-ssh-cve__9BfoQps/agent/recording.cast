[157.049371, "o", "                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_BY_APPLICATION,\r\n\u001b[?2004l\r"]
[157.0494, "o", "\u001b[?2004h> "]
[157.049551, "o", "                                                     io_lib:format(\"Internal error: ~p:~p\",[Class,Error]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.049607, "o", "> "]
[157.049661, "o", "                                                     StateName, D1),\r\n\u001b[?2004l\r"]
[157.049688, "o", "\u001b[?2004h> "]
[157.049765, "o", "                    {stop_and_reply, Shutdown, Repls, D}\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.049793, "o", ">             end;\r\n\u001b[?2004l\r"]
[157.04985, "o", "\u001b[?2004h>         false ->\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.04991, "o", "> "]
[157.05007, "o", "            {Shutdown, D1} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, \"Connection message before authentication\", StateName, D0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.050117, "o", "> "]
[157.050169, "o", "            {stop, Shutdown, D1}\r\n\u001b[?2004l\r\u001b[?2004h>     end;\"\"\"\r\n\u001b[?2004l\r"]
[157.050234, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050267, "o", "parts = content.split(start_marker)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.05033, "o", "if len(parts) > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050362, "o", "    prefix = parts[0]\r\n\u001b[?2004l\r"]
[157.050393, "o", "\u001b[?2004h> "]
[157.050446, "o", "    rest = parts[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050548, "o", "    parts2 = rest.split(next_handler_marker)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(parts2) > 1:\r\n\u001b[?2004l\r"]
[157.050615, "o", "\u001b[?2004h> "]
[157.050648, "o", "        suffix = next_handler_marker + parts2[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050753, "o", "        new_content = prefix + new_block + '\\n\\n\\n' + suffix\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.050815, "o", "> "]
[157.050917, "o", "        with open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.050983, "o", "            f.write(new_content)\r\n\u001b[?2004l\r"]
[157.051043, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[157.05241, "o", "\u001b[?2004hroot@3a487dc4dce9:/app/workspace# "]
[157.052528, "o", "python3 /tmp/fix_ssh_v4.py\r\n\u001b[?2004l\r"]
[157.064845, "o", "\u001b[?2004hroot@3a487dc4dce9:/app/workspace# "]
[158.136706, "i", "sed -n '755,775p' /app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl\n"]
[158.137342, "o", "sed -n '755,775p' /app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl\r\n\u001b[?2004l\r"]
[158.139103, "o", "handle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n    debug_fun(Msg, D),\r\n    keep_state_and_data;\r\n\r\nhandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n                                                        event_queue = Qev0} = D0) ->\r\n    case ?CONNECTED(StateName) orelse renegotiation(StateName) of\r\n        true ->\r\n            Role = ?role(StateName),\r\n            Rengotation = renegotiation(StateName),\r\n            try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of\r\n                {disconnect, Reason0, RepliesConn} ->\r\n                    {Repls, D} = send_replies(RepliesConn, D0),\r\n                    case {Reason0,Role} of\r\n                        {{_, Reason}, client} when ((StateName =/= {connected,client})\r\n                                                    and (not Rengotation)) ->\r\n                            handshake({not_connected,Reason}, D);\r\n                        _ ->\r\n                            ok\r\n                    end,\r\n                    {stop_and_reply, {shutdown,normal}, Repls, D};\r\n"]
[158.139398, "o", "\u001b[?2004hroot@3a487dc4dce9:/app/workspace# "]
