[134.74121, "o", "# Since I don't know exactly how broken the file is now, I'll try to find the start of the handler and the next handler after it.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.741337, "o", "# Next handler is usually handle_event(enter, ...)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.741405, "o", "> "]
[134.741562, "o", "next_handler_marker = 'handle_event(enter, OldState, {connected,_}=NewState, D) ->'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.741633, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.741701, "o", "parts = content.split(start_marker)\r\n\u001b[?2004l\r"]
[134.74177, "o", "\u001b[?2004h> if len(parts) > 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.741832, "o", "> "]
[134.741897, "o", "    prefix = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.741967, "o", "    rest = parts[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.742044, "o", "    parts2 = rest.split(next_handler_marker)\r\n\u001b[?2004l\r"]
[134.742108, "o", "\u001b[?2004h> "]
[134.742176, "o", "    if len(parts2) > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.74227, "o", "        suffix = next_handler_marker + parts2[1]\r\n\u001b[?2004l\r"]
[134.742337, "o", "\u001b[?2004h> "]
[134.742438, "o", "        new_content = prefix + new_block + '\\n\\n\\n' + suffix\r\n\u001b[?2004l\r"]
[134.742506, "o", "\u001b[?2004h> "]
[134.742688, "o", "        with open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.742773, "o", "            f.write(new_content)\r\n\u001b[?2004l\r"]
[134.742841, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.742909, "o", "> "]
[134.742977, "o", "        print(\"Could not find next handler marker\")\r\n\u001b[?2004l\r"]
[134.743045, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.743161, "o", "    print(\"Could not find start marker\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.743235, "o", "> EOF\r\n\u001b[?2004l\r"]
[134.744712, "o", "\u001b[?2004hroot@3a487dc4dce9:/app/workspace# "]
