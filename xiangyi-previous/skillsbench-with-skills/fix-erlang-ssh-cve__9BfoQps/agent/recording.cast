[91.32776, "i", "cat <<EOF > /tmp/fix_ssh.py\nimport sys\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'r') as f:\n    lines = f.readlines()\n\nnew_lines = []\ninserted = False\nfor line in lines:\n    if 'handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,' in line and not inserted:\n        new_lines.append('handle_event(internal, {conn_msg,_Msg}, StateName, D) when not (?CONNECTED(StateName) orelse renegotiation(StateName)) ->\\n')\n        new_lines.append('    {Shutdown, D1} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, \"Connection message before authentication\", StateName, D),\\n')\n        new_lines.append('    {stop, Shutdown, D1};\\n\\n')\n        inserted = True\n    new_lines.append(line)\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\n    f.writelines(new_lines)\nEOF\npython3 /tmp/fix_ssh.py\n"]
