[104.344166, "o", "handle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n    debug_fun(Msg, D),\r\n    keep_state_and_data;\r\n\r\nhandle_event(internal, {conn_msg,_Msg}, StateName, D) when not (?CONNECTED(StateName) orelse renegotiation(StateName)) ->\r\n    {Shutdown, D1} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, \"Connection message before authentication\", StateName, D),\r\n    {stop, Shutdown, D1};\r\n\r\nhandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n                                                        event_queue = Qev0} = D0) ->\r\n    Role = ?role(StateName),\r\n"]
