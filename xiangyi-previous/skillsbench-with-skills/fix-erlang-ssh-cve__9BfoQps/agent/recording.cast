[122.092718, "i", "cat <<EOF > /tmp/fix_ssh_v2.py\nimport sys\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'r') as f:\n    content = f.read()\n\n# Remove the previous failed attempt if it exists\nimport re\npattern = r'handle_event\\(internal, {conn_msg,_Msg}, StateName, D\\) when not \\(\\?CONNECTED\\(StateName\\) orelse renegotiation\\(StateName\\)\\) ->\\s+{Shutdown, D1} = \\?send_disconnect\\(\\?SSH_DISCONNECT_PROTOCOL_ERROR, \"Connection message before authentication\", StateName, D\\),\\s+{stop, Shutdown, D1};\\s+'\ncontent = re.sub(pattern, '', content)\n\n# Now find the correct place to insert the check\nold_handler = 'handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,'\nnew_handler = \"\"\"handle_event(internal, {conn_msg,Msg}, StateName, D0) ->\n    case ?CONNECTED(StateName) orelse renegotiation(StateName) of\n        true ->\n            #data{connection_state = Connection0,\\n                  event_queue = Qev0} = D0,\n\"\"\"\n# This is still a bit messy. Let's try to just wrap the existing handler logic.\n\nlines = content.split('\\n')\nnew_lines = []\ni = 0\nwhile i < len(lines):\n    if 'handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,' in lines[i]:\n        # Start of the handler\n        new_lines.append('handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,')\n        new_lines.append('                                                        event_queue = Qev0} = D0) ->')\n        new_lines.append('    case ?CONNECTED(StateName) orelse renegotiation(StateName) of')\n        new_lines.append('        true ->')\n        i += 2 # Skip the original header lines\n        # Now indent the rest of the handler until the end of the try-catch block\n        # The handler ends at the next function definition or a long block.\n        # Looking at the code, the handler has a try-catch block that ends with {stop_and_reply, Shutdown, Repls, D}\n        while i < len(lines):\n            line = lines[i]\n            new_lines.append('            ' + line)\n            i += 1\n            if '{stop_and_reply, Shutdown, Repls, D}' in line:\n                break\n        new_lines.append('        false ->')\n        new_lines.append('            {Shutdown, D1} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, \"Connection message before authentication\", StateName, D0),')\n        new_lines.append('            {stop, Shutdown, D1}')\n        new_lines.append('    end;')\n    else:\n        new_lines.append(lines[i])\n        i += 1\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\n    f.write('\\n'.join(new_lines))\nEOF\npython3 /tmp/fix_ssh_v2.py\n"]
