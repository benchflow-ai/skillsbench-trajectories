[86.146862, "i", "cat <<EOF > /tmp/check_fix.py\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'r') as f:\n    lines = f.readlines()\n\nnew_lines = []\nfor i, line in enumerate(lines):\n    if 'handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,' in line:\n        new_lines.append(line.replace(') ->', ') when ?CONNECTED(StateName) orelse renegotiation(StateName) ->'))\n    else:\n        new_lines.append(line)\n\n# Find where the handle_event for conn_msg ends to insert the other case\n# It ends before the catch block for that try.\n# Actually it's easier to just add the new handler BEFORE the existing one.\nEOF\n"]
