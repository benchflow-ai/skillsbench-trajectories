[89.992699, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get Plots schema\nprint(\"=== Plots Schema ===\")\ncursor.execute(\"PRAGMA table_info(Plots)\")\nfor row in cursor.fetchall():\n    print(row)\n\n# Get sample Plots data\nprint(\"\\n=== Sample Plots (first 20) ===\")\ncursor.execute(\"SELECT * FROM Plots LIMIT 20\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\n"]
