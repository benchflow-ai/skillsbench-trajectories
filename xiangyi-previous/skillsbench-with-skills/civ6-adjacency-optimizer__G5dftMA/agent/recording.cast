[113.703511, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get unique terrain types\nprint(\"=== Unique Terrain Types ===\")\ncursor.execute(\"SELECT DISTINCT TerrainType FROM Plots ORDER BY TerrainType\")\nfor row in cursor.fetchall():\n    print(row[0])\n\n# Get unique feature types\nprint(\"\\n=== Unique Feature Types ===\")\ncursor.execute(\"SELECT DISTINCT FeatureType FROM PlotFeatures ORDER BY FeatureType\")\nfor row in cursor.fetchall():\n    print(row[0])\n\n# Count features\nprint(\"\\n=== Feature Counts ===\")\ncursor.execute(\"SELECT FeatureType, COUNT(*) FROM PlotFeatures GROUP BY FeatureType\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\n"]
