[266.625237, "o", "> "]
[266.625375, "o", "        placements = {cc: 'CITY_CENTER', campus_pos: 'CAMPUS', pos1: 'COMMERCIAL_HUB', pos2: 'HOLY_SITE'}\r\n\u001b[?2004l\r"]
