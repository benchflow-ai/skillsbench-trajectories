[180.096392, "o", "tiles = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.096541, "o", "cursor.execute(\"SELECT ID, TerrainType FROM Plots\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.096637, "o", ">     x, y = id_to_xy(row[0])\r\n\u001b[?2004l\r"]
