[124.129372, "o", "=== Valuable Features ===\r\n"]
[124.129639, "o", "(23, 11): FEATURE_FOREST\r\n(24, 12): FEATURE_FOREST\r\n(20, 13): FEATURE_JUNGLE\r\n(21, 13): FEATURE_GEOTHERMAL_FISSURE\r\n(23, 13): FEATURE_FOREST\r\n(20, 14): FEATURE_REEF\r\n(23, 14): FEATURE_FLOODPLAINS_PLAINS\r\n(20, 15): FEATURE_JUNGLE\r\n(23, 15): FEATURE_FLOODPLAINS_PLAINS\r\n(23, 16): FEATURE_FLOODPLAINS_PLAINS\r\n(22, 17): FEATURE_FLOODPLAINS_PLAINS\r\n\r\n=== Mountains ===\r\n"]
[124.12979, "o", "(22, 11)\r\n(21, 15)\r\n\r\n=== PlotRivers Schema ===\r\n"]
[124.129858, "o", "[(0, 'ID', 'INTEGER', 1, None, 1), (1, 'IsNEOfRiver', 'BOOLEAN', 0, None, 0), (2, 'IsWOfRiver', 'BOOLEAN', 0, None, 0), (3, 'IsNWOfRiver', 'BOOLEAN', 0, None, 0), (4, 'EFlowDirection', 'INTEGER', 0, None, 0), (5, 'SEFlowDirection', 'INTEGER', 0, None, 0), (6, 'SWFlowDirection', 'INTEGER', 0, None, 0)]\r\n(5, 7): edge=1, flow=0\r\n(3, 13): edge=0, flow=0\r\n(21, 13): edge=0, flow=1\r\n(22, 14): edge=0, flow=1\r\n(23, 14): edge=0, flow=1\r\n"]
[124.129925, "o", "(24, 14): edge=1, flow=0\r\n(22, 15): edge=0, flow=0\r\n(23, 15): edge=0, flow=1\r\n(23, 16): edge=0, flow=1\r\n(24, 16): edge=1, flow=0\r\n(22, 17): edge=0, flow=1\r\n(23, 17): edge=1, flow=0\r\n(38, 18): edge=0, flow=1\r\n(36, 23): edge=0, flow=1\r\n"]
