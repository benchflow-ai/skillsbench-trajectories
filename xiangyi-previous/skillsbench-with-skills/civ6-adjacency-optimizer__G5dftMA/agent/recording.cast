[205.111447, "o", "def calc_holy_site_adj(x, y, placed_districts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111509, "o", "    \"\"\"Calculate Holy Site adjacency bonus\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.11158, "o", "    bonus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
