[106.585112, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get unique terrain types\nprint(\"=== Unique Terrain Types ===\")\ncursor.execute(\"SELECT DISTINCT TerrainType FROM Plots\")\nfor row in cursor.fetchall():\n    print(row[0])\n\n# Get PlotFeatures\nprint(\"\\n=== PlotFeatures ===\")\ncursor.execute(\"PRAGMA table_info(PlotFeatures)\")\nprint(\"Schema:\", cursor.fetchall())\ncursor.execute(\"SELECT * FROM PlotFeatures\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\n"]
