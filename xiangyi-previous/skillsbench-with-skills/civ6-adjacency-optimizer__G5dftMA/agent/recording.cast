[539.913918, "o", "# Rule 3 (Mountain): checks if neighbor is_mountain\r\n\u001b[?2004l\r\u001b[?2004h> #   - (21,15) matches -> count=1, +1 bonus\r\n\u001b[?2004l\r\u001b[?2004h> # Rule 4 (Jungle): checks if neighbor has FEATURE_JUNGLE\r\n\u001b[?2004l\r\u001b[?2004h> #   - (20,13), (20,15) match -> count=2, floor(2/2)=1 bonus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.914186, "o", "# Rule 5 (District): checks if neighbor is in placements AND in SPECIALTY_DISTRICTS\r\n\u001b[?2004l\r\u001b[?2004h> #   - (21,13) CITY_CENTER is in DISTRICTS_FOR_ADJACENCY -> counts!\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.914771, "o", "#   - (22,14) COMMERCIAL_HUB is in DISTRICTS_FOR_ADJACENCY -> counts!\r\n\u001b[?2004l\r\u001b[?2004h> #   - count=2, floor(2/2)=1 bonus\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Total: 2 + 2 + 1 + 1 + 1 = 7\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Campus adjacency breakdown:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"  Geothermal (21,13): +2\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"  Reef (20,14): +2\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"  Mountain (21,15): +1\")\r\n\u001b[?2004l\r"]
