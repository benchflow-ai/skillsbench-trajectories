[574.038948, "i", "python3 << 'EOF'\nimport sys\nsys.path.insert(0, '/root/.gemini/skills/civ6lib/scripts')\n\nfrom placement_rules import Tile, DistrictType\nfrom adjacency_rules import AdjacencyCalculator\n\n# Build tiles dict\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\nWIDTH = 44\n\ndef id_to_xy(plot_id):\n    return (plot_id % WIDTH, plot_id // WIDTH)\n\ntiles = {}\n\n# Get terrain\ncursor.execute(\"SELECT ID, TerrainType FROM Plots\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    terrain = row[1].replace('TERRAIN_', '')\n    is_hills = '_HILLS' in terrain\n    terrain = terrain.replace('_HILLS', '').replace('_MOUNTAIN', '')\n    is_mountain = 'MOUNTAIN' in row[1]\n    \n    tiles[(x, y)] = Tile(\n        x=x, y=y,\n        terrain=terrain if not is_mountain else 'MOUNTAIN',\n        is_hills=is_hills\n    )\n\n# Get features\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    if (x, y) in tiles:\n        tiles[(x, y)].feature = row[1]\n\n# Get rivers\ncursor.execute(\"SELECT ID FROM PlotRivers\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    if (x, y) in tiles:\n        tiles[(x, y)].river_edges = [0]  # Just mark as having river\n\nconn.close()\n\n# Create placements\nplacements = {\n    (21, 13): DistrictType.CITY_CENTER,\n    (21, 14): DistrictType.CAMPUS,\n    (22, 14): DistrictType.COMMERCIAL_HUB,\n    (23, 12): DistrictType.HOLY_SITE,\n}\n\n# Calculate adjacency\ncalculator = AdjacencyCalculator(tiles)\ntotal, per_district = calculator.calculate_total_adjacency(placements)\n\nprint(f\"Total adjacency: {total}\")\nprint(\"\\nPer district:\")\nfor name, result in per_district.items():\n    print(f\"  {name}: {result.total_bonus}\")\n    for rule_key, breakdown in result.breakdown.items():\n        print(f\"    {rule_key}: count={breakdown['count']}, bonus={breakdown['bonus']}\")\n\nEOF\n"]
[574.042687, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0, '/root/.gemini/skills/civ6lib/scripts')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from placement_rules import Tile, DistrictType\r\n\u001b[?2004l\r\u001b[?2004h> from adjacency_rules import AdjacencyCalculator\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build tiles dict\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\r\n\u001b[?2004l\r\u001b[?2004h> cursor = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> WIDTH = 44\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def id_to_xy(plot_id):\r\n\u001b[?2004l\r\u001b[?2004h>     return (plot_id % WIDTH, plot_id // WIDTH)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> tiles = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get terrain\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT ID, TerrainType FROM Plots\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     x, y = id_to_xy(row[0])\r\n\u001b[?2004l\r\u001b[?2004h>     terrain = row[1].replace('TERRAIN_', '')\r\n\u001b[?2004l\r\u001b[?2004h>     is_hills = '_HILLS' in terrain\r\n\u001b[?2004l\r\u001b[?2004h>     terrain = terrain.replace('_HILLS', '').replace('_MOUNTAIN', '')\r\n\u001b[?2004l\r\u001b[?2004h>     is_mountain = 'MOUNTAIN' in row[1]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     tiles[(x, y)] = Tile(\r\n\u001b[?2004l\r\u001b[?2004h>         x=x, y=y,\r\n\u001b[?2004l\r\u001b[?2004h>         terrain=terrain if not is_mountain else 'MOUNTAIN',\r\n\u001b[?2004l\r\u001b[?2004h>         is_hills=is_hills\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get features\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     x, y = id_to_xy(row[0])\r\n\u001b[?2004l\r\u001b[?2004h>     if (x, y) in tiles:\r\n\u001b[?2004l\r\u001b[?2004h>         tiles[(x, y)].feature = row[1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get rivers\r\n\u001b[?2004l\r\u001b[?2004h> cursor.execute(\"SELECT ID FROM PlotRivers\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in cursor.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>     x, y = id_to_xy(row[0])\r\n\u001b[?2004l\r\u001b[?2004h>     if (x, y) in tiles:\r\n\u001b[?2004l\r\u001b[?2004h>         tiles[(x, y)].river_edges = [0]  # Just mark as having river\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create placements\r\n\u001b[?2004l\r\u001b[?2004h> placements = {\r\n\u001b[?2004l\r\u001b[?2004h>     (21, 13): DistrictType.CITY_CENTER,\r\n\u001b[?2004l\r\u001b[?2004h>     (21, 14): DistrictType.CAMPUS,\r\n\u001b[?2004l\r\u001b[?2004h>     (22, 14): DistrictType.COMMERCIAL_HUB,\r\n\u001b[?2004l\r\u001b[?2004h>     (23, 12): DistrictType.HOLY_SITE,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate adjacency\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.042888, "o", "calculator = AdjacencyCalculator(tiles)\r\n\u001b[?2004l\r\u001b[?2004h> total, per_district = calculator.calculate_total_adjacency(placements)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total adjacency: {total}\")\r\n\u001b[?2004l\r"]
[574.042974, "o", "\u001b[?2004h> print(\"\\nPer district:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.043049, "o", "for name, result in per_district.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[574.043287, "o", ">     print(f\"  {name}: {result.total_bonus}\")\r\n\u001b[?2004l\r\u001b[?2004h>     for rule_key, breakdown in result.breakdown.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.043394, "o", "        print(f\"    {rule_key}: count={breakdown['count']}, bonus={breakdown['bonus']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.043472, "o", "EOF\r\n\u001b[?2004l\r"]
