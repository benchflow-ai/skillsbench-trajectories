[136.771802, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\nWIDTH = 44\nHEIGHT = 26\n\ndef id_to_xy(plot_id):\n    return (plot_id % WIDTH, plot_id // WIDTH)\n\ndef xy_to_id(x, y):\n    return y * WIDTH + x\n\n# Get all land tiles\nprint(\"=== All Land Tiles ===\")\ncursor.execute(\"SELECT ID, TerrainType FROM Plots WHERE TerrainType NOT IN ('TERRAIN_OCEAN', 'TERRAIN_COAST')\")\nland_tiles = {}\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    land_tiles[(x, y)] = row[1]\n    print(f\"({x}, {y}): {row[1]}\")\n\n# Get PlotResources\nprint(\"\\n=== PlotResources ===\")\ncursor.execute(\"PRAGMA table_info(PlotResources)\")\nprint(\"Schema:\", cursor.fetchall())\ncursor.execute(\"SELECT * FROM PlotResources\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    print(f\"({x}, {y}): {row}\")\n\nconn.close()\nEOF\n"]
