[266.625471, "o", "> "]
[266.625578, "o", "        campus_adj = calc_campus_adj(campus_pos[0], campus_pos[1], placements)\r\n\u001b[?2004l\r\u001b[?2004h"]
[266.625626, "o", "> "]
