[205.11021, "o", ">             geothermal_count += 1\r\n\u001b[?2004l\r"]
[205.11028, "o", "\u001b[?2004h> "]
[205.110352, "o", "        if feature == 'FEATURE_REEF':\r\n\u001b[?2004l\r\u001b[?2004h>             reef_count += 1\r\n\u001b[?2004l\r"]
[205.110418, "o", "\u001b[?2004h>         if t.get('is_mountain'):\r\n"]
[205.110489, "o", "\u001b[?2004l\r\u001b[?2004h>             mountain_count += 1\r\n"]
