[124.112789, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\nWIDTH = 44\nHEIGHT = 26\n\ndef id_to_xy(plot_id):\n    return (plot_id % WIDTH, plot_id // WIDTH)\n\n# Get valuable features\nprint(\"=== Valuable Features ===\")\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures WHERE FeatureType NOT IN ('FEATURE_ICE')\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    print(f\"({x}, {y}): {row[1]}\")\n\n# Get mountains\nprint(\"\\n=== Mountains ===\")\ncursor.execute(\"SELECT ID FROM Plots WHERE TerrainType LIKE '%MOUNTAIN%'\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    print(f\"({x}, {y})\")\n\n# Get PlotRivers\nprint(\"\\n=== PlotRivers Schema ===\")\ncursor.execute(\"PRAGMA table_info(PlotRivers)\")\nprint(cursor.fetchall())\ncursor.execute(\"SELECT * FROM PlotRivers LIMIT 20\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    print(f\"({x}, {y}): edge={row[1]}, flow={row[2]}\")\n\nconn.close()\nEOF\n"]
