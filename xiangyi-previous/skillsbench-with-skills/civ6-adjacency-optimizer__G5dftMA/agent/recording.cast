[266.623176, "o", "> "]
[266.623236, "o", "    remaining = [t for t in workable if t != campus_pos]\r\n\u001b[?2004l\r"]
[266.623276, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[266.623322, "o", "\u001b[?2004h> "]
