[84.002204, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\n# Get Map info\nprint(\"=== Map ===\")\ncursor.execute(\"PRAGMA table_info(Map)\")\nprint(\"Schema:\", cursor.fetchall())\ncursor.execute(\"SELECT * FROM Map\")\nprint(\"Data:\", cursor.fetchall())\n\n# Get MapAttributes\nprint(\"\\n=== MapAttributes ===\")\ncursor.execute(\"SELECT * FROM MapAttributes\")\nfor row in cursor.fetchall():\n    print(row)\n\nconn.close()\nEOF\n"]
