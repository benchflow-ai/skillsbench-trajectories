[205.111926, "o", "        t = tiles.get((nx, ny), {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111984, "o", "        feature = t.get('feature', '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.112069, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.112137, "o", "        if t.get('is_mountain'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
