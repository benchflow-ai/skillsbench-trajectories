[304.42897, "o", "Valid district tiles: 36\r\nValid city center tiles: 37\r\n\r\n(21, 13) feature: FEATURE_GEOTHERMAL_FISSURE\r\nAccording to SKILL.md: Settling on Geothermal Fissure PRESERVES it\r\n\r\n=== Verifying configuration ===\r\nCity Center: (21, 13)\r\nCampus: (21, 14)\r\nCommercial Hub: (22, 14)"]
[304.429302, "o", "\r\nHoly Site: (23, 12)\r\nCampus distance from CC: 1\r\nCommercial Hub distance from CC: 1\r\nHoly Site distance from CC: 2\r\n\r\nCampus adjacency: 7\r\nCommercial Hub adjacency: 3\r\nHoly Site adjacency: 2\r\nTotal: 12\r\n\r\n=== Campus (21,14) neighbors ===\r\n  (22, 14): feature=None, mountain=False, placed=True\r\n  (21, 13): feature=FEATURE_GEOTHERMAL_FISSURE, mountain=False, placed=True\r\n  (20, 13): feature=FEATURE_JUNGLE, mountain=False, placed=False\r\n  (20, 14): feature=FEATURE_REEF, mountain=False, placed=False\r\n  (20, 15): feature=FEATURE_JUNGLE, mountain=False, placed=False\r\n  (21, 15): feature=None, mountain=True, placed=False\r\n"]
