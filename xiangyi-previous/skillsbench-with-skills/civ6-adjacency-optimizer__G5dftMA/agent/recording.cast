[136.797198, "o", "(21, 14): TERRAIN_GRASS\r\n(22, 14): TERRAIN_GRASS\r\n(23, 14): TERRAIN_PLAINS\r\n(24, 14): TERRAIN_GRASS\r\n(25, 14): TERRAIN_GRASS\r\n(26, 14): TERRAIN_GRASS\r\n(27, 14): TERRAIN_GRASS\r\n(20, 15): TERRAIN_GRASS\r\n"]
[136.797458, "o", "(21, 15): TERRAIN_GRASS_MOUNTAIN\r\n(22, 15): TERRAIN_GRASS\r\n(23, 15): TERRAIN_PLAINS\r\n(24, 15): TERRAIN_GRASS\r\n(25, 15): TERRAIN_GRASS\r\n(26, 15): TERRAIN_GRASS\r\n"]
[136.797551, "o", "(22, 16): TERRAIN_GRASS\r\n(23, 16): TERRAIN_PLAINS\r\n(24, 16): TERRAIN_GRASS\r\n(25, 16): TERRAIN_GRASS\r\n(26, 16): TERRAIN_GRASS\r\n(22, 17): TERRAIN_PLAINS\r\n(23, 17): TERRAIN_GRASS\r\n(24, 17): TERRAIN_GRASS\r\n(25, 17): TERRAIN_GRASS\r\n\r\n=== PlotResources ===\r\nSchema: [(0, 'ID', 'INTEGER', 1, None, 1), (1, 'ResourceType', 'TEXT', 0, None, 0), (2, 'ResourceCount', 'INTEGER', 0, None, 0)]\r\n"]
[136.802558, "o", "\u001b[?2004hroot@af79b57976f8:~# "]
[157.594697, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\nWIDTH = 44\nHEIGHT = 26\n\ndef id_to_xy(plot_id):\n    return (plot_id % WIDTH, plot_id // WIDTH)\n\n# Build complete tile data\ntiles = {}\n\n# Get terrain\ncursor.execute(\"SELECT ID, TerrainType FROM Plots\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    tiles[(x, y)] = {'terrain': row[1], 'feature': None, 'river_edges': []}\n\n# Get features\ncursor.execute(\"SELECT ID, FeatureType FROM PlotFeatures\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    if (x, y) in tiles:\n        tiles[(x, y)]['feature'] = row[1]\n\n# Get rivers - need to understand the schema better\ncursor.execute(\"SELECT * FROM PlotRivers\")\nfor row in cursor.fetchall():\n    x, y = id_to_xy(row[0])\n    if (x, y) in tiles:\n        # The columns are: ID, IsNEOfRiver, IsWOfRiver, IsNWOfRiver, EFlowDirection, SEFlowDirection, SWFlowDirection\n        tiles[(x, y)]['river_data'] = row[1:]\n        tiles[(x, y)]['has_river'] = True\n\n# Print the map area of interest (x: 19-28, y: 10-18)\nprint(\"=== Map Area (x:19-28, y:10-18) ===\")\nfor y in range(10, 19):\n    row_str = f\"y={y:2d}: \"\n    for x in range(19, 29):\n        t = tiles.get((x, y), {})\n        terrain = t.get('terrain', 'NONE')\n        feature = t.get('feature', '')\n        has_river = t.get('has_river', False)\n        \n        if 'OCEAN' in terrain:\n            c = '~'\n        elif 'COAST' in terrain:\n            c = '.'\n        elif 'MOUNTAIN' in terrain:\n            c = 'M'\n        elif feature == 'FEATURE_GEOTHERMAL_FISSURE':\n            c = 'G'\n        elif feature == 'FEATURE_REEF':\n            c = 'R'\n        elif feature == 'FEATURE_FOREST':\n            c = 'F'\n        elif feature == 'FEATURE_JUNGLE':\n            c = 'J'\n        elif feature and 'FLOODPLAIN' in feature:\n            c = 'P'\n        elif 'GRASS' in terrain or 'PLAINS' in terrain:\n            c = 'g' if not has_river else 'r'\n        else:\n            c = '?'\n        row_str += c\n    print(row_str)\n\n# Print river tiles\nprint(\"\\n=== Tiles with Rivers ===\")\nfor (x, y), t in sorted(tiles.items()):\n    if t.get('has_river'):\n        print(f\"({x}, {y}): {t.get('river_data')}\")\n\nconn.close()\nEOF\n"]
