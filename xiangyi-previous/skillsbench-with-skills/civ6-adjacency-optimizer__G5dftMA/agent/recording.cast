[460.897839, "o", "for nx, ny in get_neighbors(23, 12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.897934, "o", "    t = tiles.get((nx, ny), {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.898011, "o", "    feature = t.get('feature', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.898121, "o", "    placed = (nx, ny) in placements\r\n\u001b[?2004l\r"]
[460.898219, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.898306, "o", "    if t.get('is_mountain'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.898399, "o", "        hs_mountain += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.898503, "o", "        print(f\"  ({nx},{ny}): Mountain -> +1\")\r\n\u001b[?2004l\r"]
[460.898574, "o", "\u001b[?2004h> "]
[460.89868, "o", "    elif feature == 'FEATURE_FOREST' and not placed:\r\n\u001b[?2004l\r"]
[460.898758, "o", "\u001b[?2004h>         hs_forest += 1\r\n\u001b[?2004l\r"]
[460.898798, "o", "\u001b[?2004h> "]
[460.898877, "o", "        print(f\"  ({nx},{ny}): Forest -> +0.5\")\r\n\u001b[?2004l\r"]
[460.898903, "o", "\u001b[?2004h> "]
[460.898927, "o", "    elif placed:\r\n\u001b[?2004l\r"]
[460.898959, "o", "\u001b[?2004h> "]
[460.899052, "o", "        hs_district += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.899166, "o", "        print(f\"  ({nx},{ny}): District -> +0.5\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[460.899235, "o", "\u001b[?2004h> "]
[460.899305, "o", "hs_bonus = hs_mountain*1 + (hs_forest//2) + (hs_district//2)\r\n\u001b[?2004l\r"]
[460.899373, "o", "\u001b[?2004h> "]
[460.899537, "o", "print(f\"  Holy Site total: {hs_mountain}*1 + floor({hs_forest}/2) + floor({hs_district}/2) = {hs_bonus}\")\r\n\u001b[?2004l\r"]
[460.899619, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[460.899801, "o", "print(f\"\\n=== GRAND TOTAL: {campus_bonus} + {ch_bonus} + {hs_bonus} = {campus_bonus + ch_bonus + hs_bonus} ===\")\r\n\u001b[?2004l\r"]
[460.899829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[460.899854, "o", "> EOF\r\n\u001b[?2004l\r"]
[460.926484, "o", "=== FINAL VERIFICATION ===\r\n\r\nCity Center at (21, 13):\r\n  Feature: FEATURE_GEOTHERMAL_FISSURE\r\n  (Geothermal Fissure is preserved when settling)\r\n\r\nCampus at (21, 14) neighbors:\r\n  (22,14): TERRAIN_GRASS  -> +0.5 (District: COMMERCIAL_HUB)\r\n"]
[460.926548, "o", "  (21,13): FEATURE_GEOTHERMAL_FISSURE  -> +2 (Geothermal)\r\n  (20,13): FEATURE_JUNGLE  -> +0.5 (Jungle)\r\n  (20,14): FEATURE_REEF  -> +2 (Reef)\r\n  (20,15): FEATURE_JUNGLE  -> +0.5 (Jungle)\r\n  (21,15): TERRAIN_GRASS_MOUNTAIN  -> +1 (Mountain)\r\n\r\nCampus total: 1*2 + 1*2 + 1*1 + floor(2/2) + floor(1/2) = 6\r\n\r\nCommercial Hub at (22, 14):\r\n  Has river: True -> +2\r\n  Adjacent district at (21,13): CITY_CENTER\r\n  Adjacent district at (21,14): CAMPUS\r\n"]
[460.926575, "o", "  Commercial Hub total: 2 + floor(2/2) = 3\r\n\r\nHoly Site at (23, 12):\r\n"]
[460.926603, "o", "  (24,12): Forest -> +0.5\r\n  (23,11): Forest -> +0.5\r\n  (22,11): Mountain -> +1\r\n"]
[460.926895, "o", "  (23,13): Forest -> +0.5\r\n  Holy Site total: 1*1 + floor(3/2) + floor(0/2) = 2\r\n\r\n=== GRAND TOTAL: 6 + 3 + 2 = 11 ==="]
[460.926933, "o", "\r\n"]
