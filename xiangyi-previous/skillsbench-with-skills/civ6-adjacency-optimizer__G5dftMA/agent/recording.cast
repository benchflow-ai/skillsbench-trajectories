[598.132676, "o", "\u001b[?2004h> "]
[598.13273, "o", "    if t.get('is_mountain'):\r\n\u001b[?2004l\r"]
[598.13276, "o", "\u001b[?2004h> "]
[598.132844, "o", "        hs_mountain += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[598.132872, "o", "> "]
[598.132963, "o", "        print(f\"  ({nx},{ny}): Mountain +1\")\r\n\u001b[?2004l\r"]
[598.133037, "o", "\u001b[?2004h> "]
[598.133163, "o", "    if f == 'FEATURE_FOREST' and (nx, ny) not in placements:\r\n\u001b[?2004l\r"]
[598.1332, "o", "\u001b[?2004h> "]
[598.133256, "o", "        hs_forest += 1\r\n\u001b[?2004l\r"]
[598.133292, "o", "\u001b[?2004h> "]
[598.133442, "o", "        print(f\"  ({nx},{ny}): Forest +0.5\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[598.133589, "o", "    if (nx, ny) in placements:\r\n\u001b[?2004l\r\u001b[?2004h"]
[598.133661, "o", ">         hs_district += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[598.133754, "o", "        print(f\"  ({nx},{ny}): District +0.5\")\r\n\u001b[?2004l\r"]
[598.13383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[598.133897, "o", "> "]
[598.133972, "o", "hs_total = hs_mountain + (hs_forest // 2) + (hs_district // 2)\r\n\u001b[?2004l\r"]
[598.134037, "o", "\u001b[?2004h> "]
[598.134289, "o", "print(f\"Holy Site: {hs_mountain} + floor({hs_forest}/2) + floor({hs_district}/2) = {hs_total}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[598.134389, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[598.134585, "o", "print(f\"\\n=== TOTAL: {campus_total} + {ch_total} + {hs_total} = {campus_total + ch_total + hs_total} ===\")\r\n\u001b[?2004l\r"]
[598.134679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[598.134746, "o", "> EOF\r\n"]
[598.134782, "o", "\u001b[?2004l\r"]
[598.152117, "o", "=== CAMPUS at (21, 14) ===\r\n  (22,14): District (COMMERCIAL_HUB) +0.5\r\n  (21,13): Geothermal +2\r\n  (21,13): District (CITY_CENTER) +0.5\r\n  (20,13): Jungle +0.5\r\n  (20,14): Reef +2\r\n  (20,15): Jungle +0.5\r\n  (21,15): Mountain +1\r\n"]
[598.152185, "o", "Campus: 1*2 + 1*2 + 1 + floor(2/2) + floor(2/2) = 7\r\n\r\n=== COMMERCIAL_HUB at (22, 14) ==="]
[598.156939, "o", "\r\nRiver: 1*2 = 2\r\nDistricts: floor(2/2) = 1\r\nCommercial Hub total: 3\r\n\r\n=== HOLY_SITE at (23, 12) ===\r\n  (24,12): Forest +0.5\r\n  (23,11): Forest +0.5\r\n  (22,11): Mountain +1\r\n  (23,13): Forest +0.5\r\nHoly Site: 1 + floor(3/2) + floor(0/2) = 2\r\n\r\n=== TOTAL: 7 + 3 + 2 = 12 ===\r\n\u001b[?2004hroot@af79b57976f8:~# "]
