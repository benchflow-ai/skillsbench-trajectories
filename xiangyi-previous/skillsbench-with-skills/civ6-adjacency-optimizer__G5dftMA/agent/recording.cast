[266.626115, "o", "            best_total = total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[266.626172, "o", "            best_config = {\r\n\u001b[?2004l\r"]
[266.626222, "o", "\u001b[?2004h> "]
[266.626263, "o", "                'city_center': cc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[266.626339, "o", "                'CAMPUS': campus_pos,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[266.626409, "o", "                'COMMERCIAL_HUB': pos1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[266.626461, "o", "> "]
[266.626503, "o", "                'HOLY_SITE': pos2,\r\n\u001b[?2004l\r\u001b[?2004h> "]
