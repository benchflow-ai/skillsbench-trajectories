[522.201874, "o", "\r\n\r\n# Districts that count for the generic \"DISTRICT\" adjacency bonus\r\n# ALL districts count for adjacency, including City Center, Aqueduct, etc.\r\n# The distinction from NON_SPECIALTY (for population limit) is DIFFERENT\r\nDISTRICTS_FOR_ADJACENCY: Set[DistrictType] = {\r\n    # Specialty districts (count towards pop limit)\r\n    DistrictType.CAMPUS,\r\n    DistrictType.HOLY_SITE,\r\n    DistrictType.THEATER_SQUARE,\r\n    DistrictType.COMMERCIAL_HUB,\r\n    DistrictType.HARBOR,"]
[522.201989, "o", "\r\n"]
[522.202083, "o", "    DistrictType.INDUSTRIAL_ZONE,"]
[522.20216, "o", "\r\n"]
[522.202234, "o", "    DistrictType.GOVERNMENT_PLAZA,"]
[522.202306, "o", "\r\n"]
[522.202383, "o", "    DistrictType.ENTERTAINMENT_COMPLEX,"]
[522.202453, "o", "\r\n"]
[522.202526, "o", "    DistrictType.WATER_PARK,"]
[522.202595, "o", "\r\n"]
[522.202688, "o", "    DistrictType.ENCAMPMENT,"]
[522.202762, "o", "\r\n"]
[522.202836, "o", "    DistrictType.AERODROME,"]
[522.202901, "o", "\r\n"]
[522.202965, "o", "    DistrictType.PRESERVE,"]
[522.20303, "o", "\r\n"]
[522.2031, "o", "    DistrictType.DIPLOMATIC_QUARTER,"]
[522.203162, "o", "\r\n"]
[522.203227, "o", "    # Non-specialty districts (don't count towards pop limit, but DO count for adjacency!)"]
[522.20329, "o", "\r\n"]
[522.203355, "o", "    DistrictType.CITY_CENTER,"]
[522.203411, "o", "\r\n"]
[522.203465, "o", "    DistrictType.AQUEDUCT,"]
[522.20352, "o", "\r\n"]
