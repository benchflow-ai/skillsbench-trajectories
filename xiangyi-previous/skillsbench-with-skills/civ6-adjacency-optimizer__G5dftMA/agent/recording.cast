[157.616428, "o", "y=15: .JMrPggg.~\r\ny=16: ~..gPrgg.~\r\ny=17: ~~.Prgg.~~\r\ny=18: ~~~.....~~\r\n\r\n=== Tiles with Rivers ===\r\n"]
[157.616677, "o", "(3, 13): (0, 0, 1, -1, 4, -1)\r\n(5, 7): (1, 0, 0, -1, -1, 5)\r\n"]
[157.616754, "o", "(21, 13): (0, 1, 1, 3, 4, -1)\r\n(22, 14): (0, 1, 1, 3, 4, -1)\r\n(22, 15): (0, 0, 1, -1, 4, -1)\r\n(22, 17): (0, 1, 0, 0, -1, -1)\r\n(23, 14): (0, 1, 0, 0, -1, -1)\r\n(23, 15): (0, 1, 1, 0, 1, -1)\r\n(23, 16): (0, 1, 0, 0, -1, -1)\r\n"]
[157.616829, "o", "(23, 17): (1, 0, 0, -1, -1, 5)\r\n(24, 14): (1, 0, 0, -1, -1, 5)\r\n(24, 16): (1, 0, 0, -1, -1, 5)\r\n(36, 23): (0, 1, 0, 3, -1, -1)\r\n(38, 18): (0, 1, 0, 3, -1, -1)\r\n"]
