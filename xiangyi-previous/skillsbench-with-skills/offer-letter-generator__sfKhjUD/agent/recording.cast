[50.018714, "o", "=== Offer Letter Content ===\r\n"]
[50.019045, "o", "EMPLOYMENT OFFER\r\n"]
[50.019217, "o", "{{COMPANY_NAME}}\r\n"]
[50.019494, "o", "Date: {{DATE}}\r\n"]
[50.019633, "o", "Sarah Chen\r\n"]
[50.019762, "o", "456 Oak Avenue, Apt 7B\r\n"]
[50.020178, "o", "{{CITY}}, {{STATE}} {{ZIP_CODE}}\r\n"]
[50.02044, "o", "RE: Offer of Employment - {{POSITION}}\r\n"]
[50.020638, "o", "Dear {{CANDIDATE_FULL_NAME}},\r\n"]
[50.021091, "o", "We are pleased to extend an offer of employment for the position of Senior Software Engineer in our {{DEPARTMENT}} department.\r\n"]
[50.021214, "o", "Employment Details:\r\n"]
[50.021369, "o", "Relocation Assistance:\r\n"]
[50.021651, "o", "You are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\n"]
[50.021865, "o", "You will receive {{PTO_DAYS}} days of PTO annually.\r\n"]
[50.022255, "o", "Please respond by {{RESPONSE_DEADLINE}}.\r\n"]
[50.022431, "o", "Sincerely,\r\n"]
[50.022628, "o", "{{HR_NAME}}\r\n"]
[50.022751, "o", "Director of Human Resources\r\n"]
[50.022919, "o", "{{COMPANY_NAME}}\r\n"]
[50.025081, "o", "\r\n=== WARNING: Unfilled placeholders found ===\r\n"]
[50.025211, "o", "Remaining placeholders: {'{{COMPANY_NAME}}', '{{CITY}}', '{{RESPONSE_DEADLINE}}', '{{POSITION}}', '{{DATE}}', '{{PTO_DAYS}}', '{{ZIP_CODE}}', '{{DEPARTMENT}}', '{{CANDIDATE_FULL_NAME}}', '{{STATE}}', '{{HR_NAME}}'}\r\nSUCCESS: Conditional markers removed\r\n"]
[50.05271, "o", "\u001b[?2004hroot@c59be42736d0:~# "]
[63.505563, "i", "cat > process_offer_letter_v2.py << 'EOF'\nimport json\nfrom docx import Document\nimport re\n\n# Load employee data\nwith open('employee_data.json', 'r') as f:\n    data = json.load(f)\n\n# Load the template\ndoc = Document('offer_letter_template.docx')\n\ndef process_paragraph(paragraph, data):\n    \"\"\"Process a paragraph to replace placeholders\"\"\"\n    # Get full text\n    full_text = paragraph.text\n    \n    # Handle conditional sections\n    if data.get('RELOCATION_PACKAGE', '').lower() == 'yes':\n        full_text = re.sub(r'\\{\\{IF_RELOCATION\\}\\}', '', full_text)\n        full_text = re.sub(r'\\{\\{END_IF_RELOCATION\\}\\}', '', full_text)\n    else:\n        full_text = re.sub(r'\\{\\{IF_RELOCATION\\}\\}.*?\\{\\{END_IF_RELOCATION\\}\\}', '', full_text, flags=re.DOTALL)\n    \n    # Replace placeholders\n    for key, value in data.items():\n        placeholder = '{{' + key + '}}'\n        full_text = full_text.replace(placeholder, str(value))\n    \n    # If text changed, update the paragraph\n    if full_text != paragraph.text:\n        # Clear existing runs and add new text\n        for run in paragraph.runs:\n            run.text = ''\n        if paragraph.runs:\n            paragraph.runs[0].text = full_text\n        else:\n            paragraph.add_run(full_text)\n\n# Process all paragraphs\nfor paragraph in doc.paragraphs:\n    process_paragraph(paragraph, data)\n\n# Process tables\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                process_paragraph(paragraph, data)\n\n# Save the filled document\ndoc.save('/root/offer_letter_filled.docx')\nprint('Offer letter created successfully at /root/offer_letter_filled.docx')\nEOF\n"]
