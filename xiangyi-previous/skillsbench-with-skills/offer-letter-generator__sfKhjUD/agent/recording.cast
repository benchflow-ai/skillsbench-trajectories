[20.504993, "o", "\u001b[?2004hroot@c59be42736d0:~# "]
[32.022429, "i", "cat > process_offer_letter.py << 'EOF'\nimport json\nfrom docx import Document\nimport re\n\n# Load employee data\nwith open('employee_data.json', 'r') as f:\n    data = json.load(f)\n\n# Load the template\ndoc = Document('offer_letter_template.docx')\n\ndef replace_placeholders(text, data):\n    \"\"\"Replace placeholders in text with data values\"\"\"\n    if not text:\n        return text\n    \n    # Replace all placeholders\n    for key, value in data.items():\n        placeholder = '{{' + key + '}}'\n        text = text.replace(placeholder, str(value))\n    \n    return text\n\ndef handle_conditional(text, data):\n    \"\"\"Handle conditional sections based on RELOCATION_PACKAGE\"\"\"\n    if not text:\n        return text\n    \n    # Check if relocation package is Yes\n    if data.get('RELOCATION_PACKAGE', '').lower() == 'yes':\n        # Keep the content but remove the IF/END_IF markers\n        text = re.sub(r'\\{\\{IF_RELOCATION\\}\\}', '', text)\n        text = re.sub(r'\\{\\{END_IF_RELOCATION\\}\\}', '', text)\n    else:\n        # Remove the entire conditional section\n        text = re.sub(r'\\{\\{IF_RELOCATION\\}\\}.*?\\{\\{END_IF_RELOCATION\\}\\}', '', text, flags=re.DOTALL)\n    \n    return text\n\n# Process paragraphs\nfor paragraph in doc.paragraphs:\n    # Handle conditionals first\n    for run in paragraph.runs:\n        run.text = handle_conditional(run.text, data)\n    \n    # Then replace placeholders\n    for run in paragraph.runs:\n        run.text = replace_placeholders(run.text, data)\n\n# Process tables\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                # Handle conditionals first\n                for run in paragraph.runs:\n                    run.text = handle_conditional(run.text, data)\n                \n                # Then replace placeholders\n                for run in paragraph.runs:\n                    run.text = replace_placeholders(run.text, data)\n\n# Save the filled document\ndoc.save('/root/offer_letter_filled.docx')\nprint('Offer letter created successfully at /root/offer_letter_filled.docx')\nEOF\n"]
