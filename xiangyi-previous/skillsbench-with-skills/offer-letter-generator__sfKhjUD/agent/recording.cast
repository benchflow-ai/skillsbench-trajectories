[77.192335, "i", "python3 << 'EOF'\nfrom docx import Document\nimport re\n\n# Load the filled document\ndoc = Document('/root/offer_letter_filled.docx')\n\n# Display the content\nprint(\"=== Offer Letter Content ===\")\nfor paragraph in doc.paragraphs:\n    if paragraph.text.strip():\n        print(paragraph.text)\n\n# Check for any remaining placeholders\nall_text = '\\n'.join([p.text for p in doc.paragraphs])\n\n# Also check tables\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                all_text += '\\n' + paragraph.text\n\nif '{{' in all_text:\n    print(\"\\n=== WARNING: Unfilled placeholders found ===\")\n    placeholders = re.findall(r'\\{\\{[^}]+\\}\\}', all_text)\n    print(f\"Remaining placeholders: {set(placeholders)}\")\nelse:\n    print(\"\\n=== SUCCESS: All placeholders filled ===\")\n\n# Check for conditional markers\nif 'IF_RELOCATION' in all_text or 'END_IF_RELOCATION' in all_text:\n    print(\"WARNING: Conditional markers still present\")\nelse:\n    print(\"SUCCESS: Conditional markers removed\")\nEOF\n"]
