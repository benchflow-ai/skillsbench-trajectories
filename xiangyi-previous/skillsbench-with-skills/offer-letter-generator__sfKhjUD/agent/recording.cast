[77.284832, "o", "=== Offer Letter Content ===\r\n"]
[77.28511, "o", "EMPLOYMENT OFFER\r\n"]
[77.285186, "o", "Nexus Technologies Inc.\r\n"]
[77.285393, "o", "Date: January 15, 2024\r\n"]
[77.285501, "o", "Sarah Chen\r\n"]
[77.285579, "o", "456 Oak Avenue, Apt 7B\r\n"]
[77.285873, "o", "San Jose, CA 95123\r\n"]
[77.286977, "o", "RE: Offer of Employment - Senior Software Engineer\r\nDear Sarah Chen,\r\nWe are pleased to extend an offer of employment for the position of Senior Software Engineer in our Platform Engineering department.\r\nEmployment Details:\r\nRelocation Assistance:\r\nYou are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\n"]
[77.287114, "o", "You will receive 20 days of PTO annually.\r\n"]
[77.287364, "o", "Please respond by January 22, 2024.\r\n"]
[77.287479, "o", "Sincerely,\r\n"]
[77.287636, "o", "Jennifer Walsh\r\n"]
[77.287768, "o", "Director of Human Resources\r\n"]
[77.287856, "o", "Nexus Technologies Inc.\r\n"]
[77.289689, "o", "\r\n=== SUCCESS: All placeholders filled ===\r\nSUCCESS: Conditional markers removed\r\n"]
