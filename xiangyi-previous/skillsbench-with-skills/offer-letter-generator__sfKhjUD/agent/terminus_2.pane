[?2004hroot@c59be42736d0:~# cat > process_offer_letter.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> from docx import Document
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> # Load employee data
[?2004l[?2004h> with open('employee_data.json', 'r') as f:
[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> # Load the template
[?2004l[?2004h> doc = Document('offer_letter_template.docx')
[?2004l[?2004h> 
[?2004l[?2004h> def replace_placeholders(text, data):
[?2004l[?2004h>     """Replace placeholders in text with data values"""
[?2004l[?2004h>     if not text:
[?2004l[?2004h>         return text
[?2004l[?2004h>     
[?2004l[?2004h>     # Replace all placeholders
[?2004l[?2004h>     for key, value in data.items():
[?2004l[?2004h>         placeholder = '{{' + key + '}}'
[?2004l[?2004h>         text = text.replace(placeholder, str(value))
[?2004l[?2004h>     
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> def handle_conditional(text, data):
[?2004l[?2004h>     """Handle conditional sections based on RELOCATION_PACKAGE"""
[?2004l[?2004h>     if not text:
[?2004l[?2004h>         return text
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if relocation package is Yes
[?2004l[?2004h>     if data.get('RELOCATION_PACKAGE', '').lower() == 'yes':
[?2004l[?2004h>         # Keep the content but remove the IF/END_IF markers
[?2004l[?2004h>         text = re.sub(r'\{\{IF_RELOCATION\}\}', '', text)
[?2004l[?2004h>         text = re.sub(r'\{\{END_IF_RELOCATION\}\}', '', text)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Remove the entire conditional section
[?2004l[?2004h>         text = re.sub(r'\{\{IF_RELOCATION\}\}.*?\{\{END_IF_RELOCATION\}\}', '', text, flags=re.DOTALL)
[?2004l[?2004h>     
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> # Process paragraphs
[?2004l[?2004h> for paragraph in doc.paragraphs:
[?2004l[?2004h>     # Handle conditionals first
[?2004l[?2004h>     for run in paragraph.runs:
[?2004l[?2004h>         run.text = handle_conditional(run.text, data)
[?2004l[?2004h>     
[?2004l[?2004h>     # Then replace placeholders
[?2004l[?2004h>     for run in paragraph.runs:
[?2004l[?2004h>         run.text = replace_placeholders(run.text, data)
[?2004l[?2004h> 
[?2004l[?2004h> # Process tables
[?2004l[?2004h> for table in doc.tables:
[?2004l[?2004h>     for row in table.rows:
[?2004l[?2004h>         for cell in row.cells:
[?2004l[?2004h>             for paragraph in cell.paragraphs:
[?2004l[?2004h>                 # Handle conditionals first
[?2004l[?2004h>                 for run in paragraph.runs:
[?2004l[?2004h>                     run.text = handle_conditional(run.text, data)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Then replace placeholders
[?2004l[?2004h>                 for run in paragraph.runs:
[?2004l[?2004h>                     run.text = replace_placeholders(run.text, data)
[?2004l[?2004h> 
[?2004l[?2004h> # Save the filled document
[?2004l[?2004h> doc.save('/root/offer_letter_filled.docx')
[?2004l[?2004h> print('Offer letter created successfully at /root/offer_letter_filled.docx')
