[?2004l[?2004h> 
[?2004l[?2004h> def process_paragraph(paragraph, data):
[?2004l[?2004h>     """Process a paragraph to replace placeholders"""
[?2004l[?2004h>     # Get full text
[?2004l[?2004h>     full_text = paragraph.text
[?2004l[?2004h>     
[?2004l[?2004h>     # Handle conditional sections
