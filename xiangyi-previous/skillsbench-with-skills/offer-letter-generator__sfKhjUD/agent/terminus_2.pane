[?2004l[?2004h>     else:
[?2004l[?2004h>         full_text = re.sub(r'\{\{IF_RELOCATION\}\}.*?\{\{END_IF_RELOCATION\}\}', '', full_text, flags=re.DOTALL)
[?2004l[?2004h>     
[?2004l[?2004h>     # Replace placeholders
[?2004l[?2004h>     for key, value in data.items():
[?2004l[?2004h>         placeholder = '{{' + key + '}}'
[?2004l[?2004h>         full_text = full_text.replace(placeholder, str(value))
[?2004l[?2004h>     
[?2004l[?2004h>     # If text changed, update the paragraph
[?2004l[?2004h>     if full_text != paragraph.text:
[?2004l[?2004h>         # Clear existing runs and add new text
[?2004l[?2004h>         for run in paragraph.runs:
[?2004l[?2004h>             run.text = ''
[?2004l[?2004h>         if paragraph.runs:
[?2004l[?2004h>             paragraph.runs[0].text = full_text
[?2004l[?2004h>         else:
[?2004l[?2004h>             paragraph.add_run(full_text)
[?2004l[?2004h> 
[?2004l[?2004h> # Process all paragraphs
[?2004l[?2004h> for paragraph in doc.paragraphs:
[?2004l[?2004h>     process_paragraph(paragraph, data)
[?2004l[?2004h> 
[?2004l[?2004h> # Process tables
