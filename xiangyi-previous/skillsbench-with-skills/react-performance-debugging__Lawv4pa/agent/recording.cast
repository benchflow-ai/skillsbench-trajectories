[348.854077, "i", "cat > test-app.ts << 'EOF'\nimport { chromium } from 'playwright';\n\nasync function runTests() {\n  const browser = await chromium.launch();\n  const page = await browser.newPage();\n\n  try {\n    // Test 1: Homepage loads and shows products\n    console.log('Test 1: Loading homepage...');\n    await page.goto('http://localhost:3000', { waitUntil: 'networkidle' });\n    const productCards = await page.locator('[data-testid^=\"add-to-cart-\"]').count();\n    console.log(`✓ Homepage loaded with ${productCards} product cards`);\n\n    // Test 2: Add product to cart\n    console.log('\\nTest 2: Adding product to cart...');\n    const firstAddButton = page.locator('[data-testid^=\"add-to-cart-\"]').first();\n    await firstAddButton.click();\n    const cartCount = await page.locator('[data-testid=\"cart-count\"]').textContent();\n    console.log(`✓ Product added to cart. ${cartCount}`);\n\n    // Test 3: Compare page loads\n    console.log('\\nTest 3: Loading compare page...');\n    await page.goto('http://localhost:3000/compare', { waitUntil: 'networkidle' });\n    const overviewTab = await page.locator('[data-testid=\"tab-overview\"]').isVisible();\n    console.log(`✓ Compare page loaded with overview tab visible: ${overviewTab}`);\n\n    // Test 4: Advanced tab renders\n    console.log('\\nTest 4: Clicking advanced analysis tab...');\n    const advancedTab = page.locator('[data-testid=\"tab-advanced\"]');\n    await advancedTab.click();\n    await page.waitForTimeout(500);\n    const advancedContent = await page.locator('[data-testid=\"advanced-content\"]').isVisible();\n    console.log(`✓ Advanced analysis content visible: ${advancedContent}`);\n\n    console.log('\\n✅ All tests passed!');\n  } catch (error) {\n    console.error('❌ Test failed:', error);\n    process.exit(1);\n  } finally {\n    await browser.close();\n  }\n}\n\nrunTests();\nEOF\n"]
