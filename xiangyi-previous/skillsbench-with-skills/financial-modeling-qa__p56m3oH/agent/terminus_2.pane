[?2004hroot@00be8a52ee12:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load the data
[?2004l[?2004h> df = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=8)
[?2004l[?2004h> df = df.loc[:, ~df.columns.str.contains('^Unnamed')]
[?2004l[?2004h> df = df.dropna(subset=['Game number'])
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate score for each turn
[?2004l[?2004h> df['Turn Score'] = df[['Roll 1', 'Roll 2', 'Roll 3', 'Roll 4', 'Roll 5', 'Roll 6']].sum(axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate total score for each game
[?2004l[?2004h> game_scores = df.groupby('Game number')['Turn Score'].sum().reset_index()
[?2004l[?2004h> game_scores.columns = ['Game number', 'Total Score']
[?2004l[?2004h> 
[?2004l[?2004h> # Separate odd and even games
[?2004l[?2004h> odd_games = game_scores[game_scores['Game number'] % 2 == 1].sort_values('Game number').reset_index(drop=True)
[?2004l[?2004h> even_games = game_scores[game_scores['Game number'] % 2 == 0].sort_values('Game number').reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Create matches dataframe
[?2004l[?2004h> matches = pd.DataFrame({
[?2004l[?2004h>     'Player1_Game': odd_games['Game number'],
[?2004l[?2004h>     'Player1_Score': odd_games['Total Score'],
[?2004l[?2004h>     'Player2_Game': even_games['Game number'],
[?2004l[?2004h>     'Player2_Score': even_games['Total Score']
[?2004l[?2004h> })
[?2004l[?2004h> 
[?2004l[?2004h> # Determine winner for each match
[?2004l[?2004h> matches['Player1_Wins'] = (matches['Player1_Score'] > matches['Player2_Score']).astype(int)
[?2004l[?2004h> matches['Player2_Wins'] = (matches['Player2_Score'] > matches['Player1_Score']).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> print("First 20 matches:")
[?2004l[?2004h> print(matches.head(20))
[?2004l[?2004h> 
[?2004l[?2004h> # Count total wins
[?2004l[?2004h> player1_total_wins = matches['Player1_Wins'].sum()
[?2004l[?2004h> player2_total_wins = matches['Player2_Wins'].sum()
[?2004l[?2004h> ties = len(matches) - player1_total_wins - player2_total_wins
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== RESULTS ===")
[?2004l[?2004h> print(f"Player 1 wins: {player1_total_wins}")
[?2004l[?2004h> print(f"Player 2 wins: {player2_total_wins}")
[?2004l[?2004h> print(f"Ties: {ties}")
[?2004l[?2004h> print(f"\nAnswer (Player 1 wins - Player 2 wins): {player1_total_wins - player2_total_wins}")
