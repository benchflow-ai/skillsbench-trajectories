[123.943967, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=8)\ndf = df.loc[:, ~df.columns.str.contains('^Unnamed')]\n\n# Remove rows with NaN game numbers\ndf = df.dropna(subset=['Game number'])\n\nprint(\"Total rows:\", len(df))\nprint(\"\\nUnique game numbers:\", df['Game number'].nunique())\nprint(\"\\nGames range:\", df['Game number'].min(), \"to\", df['Game number'].max())\nprint(\"\\nTurns per game (sample):\")\nprint(df.groupby('Game number').size().head(20))\nprint(\"\\nLast few rows:\")\nprint(df.tail(10))\nEOF\n"]
