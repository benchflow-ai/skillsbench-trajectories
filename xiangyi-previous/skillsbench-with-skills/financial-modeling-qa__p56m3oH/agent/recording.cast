[137.120674, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=8)\ndf = df.loc[:, ~df.columns.str.contains('^Unnamed')]\ndf = df.dropna(subset=['Game number'])\n\n# Calculate score for each turn (sum of all 6 rolls)\ndf['Turn Score'] = df[['Roll 1', 'Roll 2', 'Roll 3', 'Roll 4', 'Roll 5', 'Roll 6']].sum(axis=1)\n\n# Calculate total score for each game (sum of all turns)\ngame_scores = df.groupby('Game number')['Turn Score'].sum().reset_index()\ngame_scores.columns = ['Game number', 'Total Score']\n\nprint(\"Game scores (first 20):\")\nprint(game_scores.head(20))\nprint(\"\\nGame scores (last 10):\")\nprint(game_scores.tail(10))\nprint(\"\\nTotal games:\", len(game_scores))\nEOF\n"]
