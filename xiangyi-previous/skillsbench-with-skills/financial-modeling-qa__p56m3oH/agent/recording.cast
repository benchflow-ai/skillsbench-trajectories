[165.800719, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=8)\ndf = df.loc[:, ~df.columns.str.contains('^Unnamed')]\ndf = df.dropna(subset=['Game number'])\n\n# Calculate score for each turn\ndf['Turn Score'] = df[['Roll 1', 'Roll 2', 'Roll 3', 'Roll 4', 'Roll 5', 'Roll 6']].sum(axis=1)\n\n# Calculate total score for each game\ngame_scores = df.groupby('Game number')['Turn Score'].sum().reset_index()\ngame_scores.columns = ['Game number', 'Total Score']\n\n# Separate odd and even games\nodd_games = game_scores[game_scores['Game number'] % 2 == 1].sort_values('Game number').reset_index(drop=True)\neven_games = game_scores[game_scores['Game number'] % 2 == 0].sort_values('Game number').reset_index(drop=True)\n\n# Create matches dataframe\nmatches = pd.DataFrame({\n    'Player1_Game': odd_games['Game number'],\n    'Player1_Score': odd_games['Total Score'],\n    'Player2_Game': even_games['Game number'],\n    'Player2_Score': even_games['Total Score']\n})\n\n# Determine winner for each match\nmatches['Player1_Wins'] = (matches['Player1_Score'] > matches['Player2_Score']).astype(int)\nmatches['Player2_Wins'] = (matches['Player2_Score'] > matches['Player1_Score']).astype(int)\n\nprint(\"First 20 matches:\")\nprint(matches.head(20))\n\n# Count total wins\nplayer1_total_wins = matches['Player1_Wins'].sum()\nplayer2_total_wins = matches['Player2_Wins'].sum()\nties = len(matches) - player1_total_wins - player2_total_wins\n\nprint(\"\\n=== RESULTS ===\")\nprint(f\"Player 1 wins: {player1_total_wins}\")\nprint(f\"Player 2 wins: {player2_total_wins}\")\nprint(f\"Ties: {ties}\")\nprint(f\"\\nAnswer (Player 1 wins - Player 2 wins): {player1_total_wins - player2_total_wins}\")\nEOF\n"]
