[150.305407, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=8)\ndf = df.loc[:, ~df.columns.str.contains('^Unnamed')]\ndf = df.dropna(subset=['Game number'])\n\n# Calculate score for each turn\ndf['Turn Score'] = df[['Roll 1', 'Roll 2', 'Roll 3', 'Roll 4', 'Roll 5', 'Roll 6']].sum(axis=1)\n\n# Calculate total score for each game\ngame_scores = df.groupby('Game number')['Turn Score'].sum().reset_index()\ngame_scores.columns = ['Game number', 'Total Score']\n\n# Separate odd and even games\nodd_games = game_scores[game_scores['Game number'] % 2 == 1].copy()\neven_games = game_scores[game_scores['Game number'] % 2 == 0].copy()\n\n# Sort to ensure proper pairing\nodd_games = odd_games.sort_values('Game number').reset_index(drop=True)\neven_games = even_games.sort_values('Game number').reset_index(drop=True)\n\nprint(\"Odd games (Player 1):\", len(odd_games))\nprint(\"Even games (Player 2):\", len(even_games))\nprint(\"\\nFirst 10 odd games:\")\nprint(odd_games.head(10))\nprint(\"\\nFirst 10 even games:\")\nprint(even_games.head(10))\nEOF\n"]
