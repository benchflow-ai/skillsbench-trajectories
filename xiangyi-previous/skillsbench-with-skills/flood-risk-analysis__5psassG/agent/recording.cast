[57.008007, "i", "python3 << 'EOF'\nimport urllib.request\nimport json\nimport csv\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict\n\n# Read station IDs\nwith open('/root/data/michigan_stations.txt', 'r') as f:\n    stations = [line.strip() for line in f if line.strip()]\n\nprint(f\"Processing {len(stations)} stations...\")\n\n# Date range: April 1-7, 2025\nstart_date = \"2025-04-01\"\nend_date = \"2025-04-07\"\n\nflood_results = {}\n\n# For each station, fetch streamflow data from USGS\nfor station_id in stations:\n    try:\n        url = f\"https://waterservices.usgs.gov/nwis/iv/?sites={station_id}&startDT={start_date}&endDT={end_date}&format=json&parameterCd=00060\"\n        with urllib.request.urlopen(url, timeout=5) as response:\n            data = json.loads(response.read().decode())\n            \n            # Extract streamflow values\n            if 'value' in data and 'timeSeries' in data['value']:\n                streamflows = []\n                for ts in data['value']['timeSeries']:\n                    if 'values' in ts:\n                        for val_period in ts['values']:\n                            for value in val_period.get('value', []):\n                                try:\n                                    flow = float(value.get('value', 0))\n                                    streamflows.append(flow)\n                                except:\n                                    pass\n                \n                if streamflows:\n                    # Calculate statistics for flood detection\n                    mean_flow = sum(streamflows) / len(streamflows)\n                    std_dev = (sum((x - mean_flow) ** 2 for x in streamflows) / len(streamflows)) ** 0.5\n                    threshold = mean_flow + (2 * std_dev)  # Flood threshold: mean + 2 std devs\n                    \n                    # Count flood days\n                    flood_days = sum(1 for flow in streamflows if flow > threshold)\n                    \n                    if flood_days > 0:\n                        flood_results[station_id] = flood_days\n                        print(f\"{station_id}: {flood_days} flood days (threshold: {threshold:.2f})\")\n    except Exception as e:\n        print(f\"Error processing {station_id}: {e}\")\n\n# Write CSV output\nwith open('/root/output/flood_results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['station_id', 'flood_days'])\n    for station_id in sorted(flood_results.keys()):\n        writer.writerow([station_id, flood_results[station_id]])\n\nprint(f\"\\nResults written to /root/output/flood_results.csv\")\nprint(f\"Total stations with flooding: {len(flood_results)}\")\n\nEOF\n"]
