[57.017893, "o", "                                    streamflows.append(flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.018004, "o", "                                except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.018124, "o", "                                    pass\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[57.018232, "o", "\u001b[?2004h> "]
[57.018328, "o", "                if streamflows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.018449, "o", "                    # Calculate statistics for flood detection\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.018579, "o", "> "]
[57.018677, "o", "                    mean_flow = sum(streamflows) / len(streamflows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.018842, "o", "                    std_dev = (sum((x - mean_flow) ** 2 for x in streamflows) / len(streamflows)) ** 0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.018945, "o", "> "]
[57.019069, "o", "                    threshold = mean_flow + (2 * std_dev)  # Flood threshold: mean + 2 std devs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.019193, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.019291, "o", "                    # Count flood days\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.019422, "o", "                    flood_days = sum(1 for flow in streamflows if flow > threshold)\r\n\u001b[?2004l\r"]
[57.019538, "o", "\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.01962, "o", "                    if flood_days > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.019745, "o", "                        flood_results[station_id] = flood_days\r\n\u001b[?2004l\r"]
[57.019818, "o", "\u001b[?2004h> "]
[57.020006, "o", "                        print(f\"{station_id}: {flood_days} flood days (threshold: {threshold:.2f})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.020034, "o", "> "]
[57.020229, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.020382, "o", "        print(f\"Error processing {station_id}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[57.020415, "o", "> # Write CSV output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.020561, "o", "with open('/root/output/flood_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.020673, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.020787, "o", "    writer.writerow(['station_id', 'flood_days'])\r\n\u001b[?2004l\r"]
[57.020906, "o", "\u001b[?2004h> "]
[57.021015, "o", "    for station_id in sorted(flood_results.keys()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.021132, "o", "        writer.writerow([station_id, flood_results[station_id]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.021277, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.021391, "o", "print(f\"\\nResults written to /root/output/flood_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.021527, "o", "print(f\"Total stations with flooding: {len(flood_results)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.021607, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
