[?2004l[?2004h> 
[?2004l[?2004h> flood_results = {}
[?2004l[?2004h> 
[?2004l[?2004h> # For each station, fetch streamflow data from USGS
[?2004l[?2004h> for station_id in stations:
[?2004l[?2004h>     try:
[?2004l[?2004h>         url = f"https://waterservices.usgs.gov/nwis/iv/?sites={station_id}&startDT={start_date}&endDT={end_date}&format=json&parameterCd=00060"
[?2004l[?2004h>         with urllib.request.urlopen(url, timeout=5) as response:
[?2004l[?2004h>             data = json.loads(response.read().decode())
[?2004l[?2004h>             
[?2004l[?2004h>             # Extract streamflow values
[?2004l[?2004h>             if 'value' in data and 'timeSeries' in data['value']:
[?2004l[?2004h>                 streamflows = []
[?2004l[?2004h>                 for ts in data['value']['timeSeries']:
[?2004l[?2004h>                     if 'values' in ts:
[?2004l[?2004h>                         for val_period in ts['values']:
[?2004l[?2004h>                             for value in val_period.get('value', []):
[?2004l[?2004h>                                 try:
[?2004l[?2004h>                                     flow = float(value.get('value', 0))
[?2004l[?2004h>                                     streamflows.append(flow)
[?2004l[?2004h>                                 except:
[?2004l[?2004h>                                     pass
[?2004l[?2004h>                 
[?2004l[?2004h>                 if streamflows:
[?2004l[?2004h>                     # Calculate statistics for flood detection
[?2004l[?2004h>                     mean_flow = sum(streamflows) / len(streamflows)
[?2004l[?2004h>                     std_dev = (sum((x - mean_flow) ** 2 for x in streamflows) / len(streamflows)) ** 0.5
[?2004l[?2004h>                     threshold = mean_flow + (2 * std_dev)  # Flood threshold: mean + 2 std devs
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Count flood days
[?2004l[?2004h>                     flood_days = sum(1 for flow in streamflows if flow > threshold)
[?2004l[?2004h>                     
[?2004l[?2004h>                     if flood_days > 0:
[?2004l[?2004h>                         flood_results[station_id] = flood_days
[?2004l[?2004h>                         print(f"{station_id}: {flood_days} flood days (threshold: {threshold:.2f})")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error processing {station_id}: {e}")
[?2004l[?2004h> 
