[?2004l[?2004h> 
[?2004l[?2004h> def replace_in_paragraph(paragraph, data):
[?2004l[?2004h>     # A simple replacement might break formatting if the placeholder is split across runs.
[?2004l[?2004h>     # But often for simple templates it works if we replace the whole text of the paragraph
[?2004l[?2004h>     # if it contains the placeholder, or we can do it more carefully.
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's try joining runs and then replacing if needed, 
[?2004l[?2004h>     # but that loses formatting. 
[?2004l[?2004h>     # Better approach: check each run.
[?2004l[?2004h>     # Even better for simple placeholders: replace in the whole paragraph text
[?2004l[?2004h>     # and then clear and re-add if we want to keep it simple, 
[?2004l[?2004h>     # but that loses run-level formatting.
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's use a more robust run-based replacement
[?2004l[?2004h>     for key, value in data.items():
[?2004l[?2004h>         placeholder = f'{{{{{key}}}}}'
[?2004l[?2004h>         if placeholder in paragraph.text:
[?2004l[?2004h>             # This is the tricky part in python-docx
[?2004l[?2004h>             # For now, let's try the simplest approach
[?2004l[?2004h>             full_text = paragraph.text.replace(placeholder, str(value))
[?2004l[?2004h>             paragraph.text = full_text
[?2004l[?2004h> 
[?2004l[?2004h> def handle_relocation(doc, relocation_package):
[?2004l[?2004h>     # This is complex because the markers might be in different paragraphs
[?2004l[?2004h>     # Let's find all paragraphs and identify the range
[?2004l[?2004h>     
[?2004l[?2004h>     paragraphs = list(doc.paragraphs)
[?2004l[?2004h>     start_idx = -1
[?2004l[?2004h>     end_idx = -1
[?2004l[?2004h>     
[?2004l[?2004h>     for i, p in enumerate(paragraphs):
[?2004l[?2004h>         if '{{IF_RELOCATION}}' in p.text:
[?2004l[?2004h>             start_idx = i
[?2004l[?2004h>         if '{{END_IF_RELOCATION}}' in p.text:
[?2004l[?2004h>             end_idx = i
[?2004l[?2004h> 
[?2004l[?2004h>     if start_idx != -1 and end_idx != -1:
[?2004l[?2004h>         if relocation_package == "Yes":
[?2004l[?2004h>             # Keep content, just remove markers
[?2004l[?2004h>             paragraphs[start_idx].text = paragraphs[start_idx].text.replace('{{IF_RELOCATION}}', '')
[?2004l[?2004h>             paragraphs[end_idx].text = paragraphs[end_idx].text.replace('{{END_IF_RELOCATION}}', '')
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Remove all paragraphs between and including markers
[?2004l[?2004h>             # We'll do this later to not mess up indices
[?2004l[?2004h>             pass
[?2004l[?2004h> 
[?2004l[?2004h>     # Re-run for tables if necessary, but usually markers are in paragraphs
[?2004l[?2004h> 
[?2004l[?2004h> # Loading data
[?2004l[?2004h> with open('employee_data.json', 'r') as f:
[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> doc = Document('offer_letter_template.docx')
[?2004l[?2004h> 
[?2004l[?2004h> # Handle relocation logic first
[?2004l[?2004h> paragraphs = list(doc.paragraphs)
[?2004l[?2004h> start_p = -1
[?2004l[?2004h> end_p = -1
[?2004l[?2004h> for i, p in enumerate(paragraphs):
[?2004l[?2004h>     if '{{IF_RELOCATION}}' in p.text:
[?2004l[?2004h>         start_p = i
[?2004l[?2004h>     if '{{END_IF_RELOCATION}}' in p.text:
[?2004l[?2004h>         end_p = i
[?2004l[?2004h> 
[?2004l[?2004h> if start_p != -1 and end_p != -1:
[?2004l[?2004h>     if data.get('RELOCATION_PACKAGE') == 'Yes':
[?2004l[?2004h>         # Just remove the markers
[?2004l[?2004h>         doc.paragraphs[start_p].text = doc.paragraphs[start_p].text.replace('{{IF_RELOCATION}}', '')
[?2004l[?2004h>         doc.paragraphs[end_p].text = doc.paragraphs[end_p].text.replace('{{END_IF_RELOCATION}}', '')
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Remove the paragraphs from end to start
