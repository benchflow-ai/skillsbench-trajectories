[190.146022, "o", "\u001b[?2004h> "]
[190.14613, "o", "    for t in parent.tables:\r\n\u001b[?2004l\r"]
[190.146177, "o", "\u001b[?2004h> "]
[190.146347, "o", "        for r in t.rows:\r\n\u001b[?2004l\r"]
[190.146412, "o", "\u001b[?2004h> "]
[190.146473, "o", "            for c in r.cells:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.146586, "o", "                walk(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
