[60.486425, "o", "def process_parent(parent, data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.486489, "o", "    for p in parent.paragraphs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.494107, "o", "        # Simple replacement in paragraph text\r\n\u001b[?2004l\r\u001b[?2004h>         for key, value in data.items():\r\n\u001b[?2004l\r\u001b[?2004h>             placeholder = f'{{{{{key}}}}}'\r\n\u001b[?2004l\r\u001b[?2004h>             if placeholder in p.text:\r\n\u001b[?2004l\r\u001b[?2004h>                 p.text = p.text.replace(placeholder, str(value))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for t in parent.tables:\r\n\u001b[?2004l\r\u001b[?2004h>         for r in t.rows:\r\n\u001b[?2004l\r\u001b[?2004h>             for c in r.cells:\r\n\u001b[?2004l\r\u001b[?2004h>                 process_parent(c, data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Loading data\r\n\u001b[?2004l\r\u001b[?2004h> with open('employee_data.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> doc = Document('offer_letter_template.docx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Handle relocation logic first\r\n\u001b[?2004l\r\u001b[?2004h> # Since markers are in paragraphs, we can find them in doc.paragraphs\r\n\u001b[?2004l\r\u001b[?2004h> # (assuming they are not in a table)\r\n\u001b[?2004l\r\u001b[?2004h> paragraphs = list(doc.paragraphs)\r\n\u001b[?2004l\r\u001b[?2004h> start_p = -1\r\n\u001b[?2004l\r\u001b[?2004h> end_p = -1\r\n\u001b[?2004l\r\u001b[?2004h> for i, p in enumerate(paragraphs):\r\n\u001b[?2004l\r\u001b[?2004h>     if '{{IF_RELOCATION}}' in p.text:\r\n\u001b[?2004l\r\u001b[?2004h>         start_p = i\r\n\u001b[?2004l\r\u001b[?2004h>     if '{{END_IF_RELOCATION}}' in p.text:\r\n\u001b[?2004l\r\u001b[?2004h>         end_p = i\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if start_p != -1 and end_p != -1:\r\n\u001b[?2004l\r\u001b[?2004h>     if data.get('RELOCATION_PACKAGE') == 'Yes':\r\n\u001b[?2004l\r\u001b[?2004h>         doc.paragraphs[start_p].text = doc.paragraphs[start_p].text.replace('{{IF_RELOCATION}}', '')\r\n\u001b[?2004l\r\u001b[?2004h>         doc.paragraphs[end_p].text = doc.paragraphs[end_p].text.replace('{{END_IF_RELOCATION}}', '')\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(end_p, start_p - 1, -1):\r\n\u001b[?2004l\r\u001b[?2004h>             p = doc.paragraphs[i]._element\r\n\u001b[?2004l\r\u001b[?2004h>             p.getparent().remove(p)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Replace all placeholders recursively\r\n\u001b[?2004l\r\u001b[?2004h> process_parent(doc, data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> doc.save('/root/offer_letter_filled.docx')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@22c3bc55c8ec:~# "]
[60.92804, "i", "python3 fill_template.py\n"]
[60.928281, "o", "python3 fill_template.py\r\n\u001b[?2004l\r"]
[61.082208, "o", "\u001b[?2004hroot@22c3bc55c8ec:~# "]
[190.145178, "i", "python3 -c \"from docx import Document; doc = Document('/root/offer_letter_filled.docx');\ndef walk(parent):\n    for p in parent.paragraphs:\n        if p.text.strip(): print('P:', p.text)\n    for t in parent.tables:\n        for r in t.rows:\n            for c in r.cells:\n                walk(c)\nwalk(doc)\"\n"]
[190.145475, "o", "python3 -c \"from docx import Document; doc = Document('/root/offer_letter_filled.docx');\r\n\u001b[?2004l\r"]
