[190.238743, "o", "P: RE: Offer of Employment - Senior Software Engineer\r\n"]
[190.238816, "o", "P: Dear Sarah Chen,\r\n"]
[190.238906, "o", "P: We are pleased to extend an offer of employment for the position of Senior Software Engineer in our Platform Engineering department.\r\n"]
[190.238986, "o", "P: Employment Details:\r\n"]
[190.23906, "o", "P: Relocation Assistance:\r\n"]
[190.239125, "o", "P: You are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\n"]
[190.239206, "o", "P: You will receive 20 days of PTO annually.\r\n"]
[190.239285, "o", "P: Please respond by January 22, 2024.\r\n"]
[190.239375, "o", "P: Sincerely,\r\n"]
