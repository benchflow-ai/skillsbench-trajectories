[60.485506, "i", "cat << 'EOF' > fill_template.py\nimport json\nfrom docx import Document\n\ndef replace_in_text(text, data):\n    for key, value in data.items():\n        placeholder = f'{{{{{key}}}}}'\n        if placeholder in text:\n            text = text.replace(placeholder, str(value))\n    return text\n\ndef process_parent(parent, data):\n    for p in parent.paragraphs:\n        # Simple replacement in paragraph text\n        for key, value in data.items():\n            placeholder = f'{{{{{key}}}}}'\n            if placeholder in p.text:\n                p.text = p.text.replace(placeholder, str(value))\n    \n    for t in parent.tables:\n        for r in t.rows:\n            for c in r.cells:\n                process_parent(c, data)\n\n# Loading data\nwith open('employee_data.json', 'r') as f:\n    data = json.load(f)\n\ndoc = Document('offer_letter_template.docx')\n\n# Handle relocation logic first\n# Since markers are in paragraphs, we can find them in doc.paragraphs\n# (assuming they are not in a table)\nparagraphs = list(doc.paragraphs)\nstart_p = -1\nend_p = -1\nfor i, p in enumerate(paragraphs):\n    if '{{IF_RELOCATION}}' in p.text:\n        start_p = i\n    if '{{END_IF_RELOCATION}}' in p.text:\n        end_p = i\n\nif start_p != -1 and end_p != -1:\n    if data.get('RELOCATION_PACKAGE') == 'Yes':\n        doc.paragraphs[start_p].text = doc.paragraphs[start_p].text.replace('{{IF_RELOCATION}}', '')\n        doc.paragraphs[end_p].text = doc.paragraphs[end_p].text.replace('{{END_IF_RELOCATION}}', '')\n    else:\n        for i in range(end_p, start_p - 1, -1):\n            p = doc.paragraphs[i]._element\n            p.getparent().remove(p)\n\n# Replace all placeholders recursively\nprocess_parent(doc, data)\n\ndoc.save('/root/offer_letter_filled.docx')\nEOF\n"]
[60.485731, "o", "cat << 'EOF' > fill_template.py\r\n\u001b[?2004l\r"]
[60.485836, "o", "\u001b[?2004h> "]
[60.485911, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> from docx import Document\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.485991, "o", "def replace_in_text(text, data):\r\n\u001b[?2004l\r\u001b[?2004h"]
