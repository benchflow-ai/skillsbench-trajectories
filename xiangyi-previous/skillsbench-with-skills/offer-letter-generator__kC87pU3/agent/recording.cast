[11.291247, "o", "Required-by: \r\n"]
[11.336523, "o", "\u001b[?2004hroot@22c3bc55c8ec:~# "]
[22.986755, "i", "cat << 'EOF' > fill_template.py\nimport json\nfrom docx import Document\nimport re\n\ndef replace_placeholders(doc, data):\n    # Replace in paragraphs\n    for p in doc.paragraphs:\n        replace_in_paragraph(p, data)\n    \n    # Replace in tables\n    for table in doc.tables:\n        for row in table.rows:\n            for cell in row.cells:\n                for p in cell.paragraphs:\n                    replace_in_paragraph(p, data)\n\ndef replace_in_paragraph(paragraph, data):\n    # A simple replacement might break formatting if the placeholder is split across runs.\n    # But often for simple templates it works if we replace the whole text of the paragraph\n    # if it contains the placeholder, or we can do it more carefully.\n    \n    # Let's try joining runs and then replacing if needed, \n    # but that loses formatting. \n    # Better approach: check each run.\n    # Even better for simple placeholders: replace in the whole paragraph text\n    # and then clear and re-add if we want to keep it simple, \n    # but that loses run-level formatting.\n    \n    # Let's use a more robust run-based replacement\n    for key, value in data.items():\n        placeholder = f'{{{{{key}}}}}'\n        if placeholder in paragraph.text:\n            # This is the tricky part in python-docx\n            # For now, let's try the simplest approach\n            full_text = paragraph.text.replace(placeholder, str(value))\n            paragraph.text = full_text\n\ndef handle_relocation(doc, relocation_package):\n    # This is complex because the markers might be in different paragraphs\n    # Let's find all paragraphs and identify the range\n    \n    paragraphs = list(doc.paragraphs)\n    start_idx = -1\n    end_idx = -1\n    \n    for i, p in enumerate(paragraphs):\n        if '{{IF_RELOCATION}}' in p.text:\n            start_idx = i\n        if '{{END_IF_RELOCATION}}' in p.text:\n            end_idx = i\n\n    if start_idx != -1 and end_idx != -1:\n        if relocation_package == \"Yes\":\n            # Keep content, just remove markers\n            paragraphs[start_idx].text = paragraphs[start_idx].text.replace('{{IF_RELOCATION}}', '')\n            paragraphs[end_idx].text = paragraphs[end_idx].text.replace('{{END_IF_RELOCATION}}', '')\n        else:\n            # Remove all paragraphs between and including markers\n            # We'll do this later to not mess up indices\n            pass\n\n    # Re-run for tables if necessary, but usually markers are in paragraphs\n\n# Loading data\nwith open('employee_data.json', 'r') as f:\n    data = json.load(f)\n\ndoc = Document('offer_letter_template.docx')\n\n# Handle relocation logic first\nparagraphs = list(doc.paragraphs)\nstart_p = -1\nend_p = -1\nfor i, p in enumerate(paragraphs):\n    if '{{IF_RELOCATION}}' in p.text:\n        start_p = i\n    if '{{END_IF_RELOCATION}}' in p.text:\n        end_p = i\n\nif start_p != -1 and end_p != -1:\n    if data.get('RELOCATION_PACKAGE') == 'Yes':\n        # Just remove the markers\n        doc.paragraphs[start_p].text = doc.paragraphs[start_p].text.replace('{{IF_RELOCATION}}', '')\n        doc.paragraphs[end_p].text = doc.paragraphs[end_p].text.replace('{{END_IF_RELOCATION}}', '')\n    else:\n        # Remove the paragraphs from end to start\n        for i in range(end_p, start_p - 1, -1):\n            p = doc.paragraphs[i]._element\n            p.getparent().remove(p)\n            p._p = p._element = None\n\n# Now replace all other placeholders\n# We'll iterate through all paragraphs and tables\n\ndef global_replace(doc, data):\n    for p in list(doc.paragraphs):\n        for key, value in data.items():\n            placeholder = f'{{{{{key}}}}}'\n            if placeholder in p.text:\n                p.text = p.text.replace(placeholder, str(value))\n    \n    for table in doc.tables:\n        for row in table.rows:\n            for cell in row.cells:\n                for p in cell.paragraphs:\n                    for key, value in data.items():\n                        placeholder = f'{{{{{key}}}}}'\n                        if placeholder in p.text:\n                            p.text = p.text.replace(placeholder, str(value))\n\nglobal_replace("]
[22.987151, "i", "doc, data)\n\ndoc.save('/root/offer_letter_filled.docx')\nEOF\n"]
