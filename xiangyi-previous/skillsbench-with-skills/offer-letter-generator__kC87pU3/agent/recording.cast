[11.280877, "o", "\u001b[33mWARNING: Skipping /usr/lib/python3.12/dist-packages/asciinema-2.4.0.dist-info due to invalid metadata entry 'name'\u001b[0m\u001b[33m\r\n\u001b[0m"]
[11.29015, "o", "Name: python-docx\r\n"]
[11.290245, "o", "Version: 1.1.2\r\n"]
[11.29038, "o", "Summary: Create, read, and update Microsoft Word .docx files.\r\n"]
[11.290487, "o", "Home-page: \r\n"]
[11.290701, "o", "Author: \r\n"]
[11.290828, "o", "Author-email: Steve Canny <stcanny@gmail.com>\r\n"]
[11.290904, "o", "License: MIT\r\n"]
[11.291037, "o", "Location: /usr/local/lib/python3.12/dist-packages\r\n"]
