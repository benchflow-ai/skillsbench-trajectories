[78.590443, "o", "\u001b[?2004h> "]
[78.5905, "o", "response = requests.get(nws_url)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.590568, "o", "content = response.text\r\n\u001b[?2004l\r"]
[78.590644, "o", "\u001b[?2004h> "]
[78.59069, "o", "reader = csv.reader(io.StringIO(content))\r\n\u001b[?2004l\r"]
[78.59076, "o", "\u001b[?2004h> "]
[78.590812, "o", "headers = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.590984, "o", "data = [row[:43] for row in reader]  # Truncate to 43 columns per SKILL.md\r\n\u001b[?2004l\r"]
[78.591045, "o", "\u001b[?2004h> "]
[78.591098, "o", "nws_df = pd.DataFrame(data, columns=headers)\r\n\u001b[?2004l\r"]
[78.591146, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.59117, "o", "\u001b[?2004h> "]
[78.59127, "o", "# 3. Filter NWS thresholds for our stations\r\n\u001b[?2004l\r"]
[78.591328, "o", "\u001b[?2004h> "]
[78.591476, "o", "nws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')\r\n\u001b[?2004l\r"]
[78.59151, "o", "\u001b[?2004h> "]
[78.591544, "o", "thresholds = {}\r\n\u001b[?2004l\r"]
[78.591574, "o", "\u001b[?2004h> "]
[78.591715, "o", "for _, row in nws_df.iterrows():\r\n\u001b[?2004l\r"]
[78.591777, "o", "\u001b[?2004h> "]
[78.591819, "o", "    usgs_id = str(row['usgs id']).strip().zfill(8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.59188, "o", "    if usgs_id in station_ids:\r\n\u001b[?2004l\r"]
[78.591938, "o", "\u001b[?2004h> "]
[78.592068, "o", "        if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:\r\n\u001b[?2004l\r"]
[78.592135, "o", "\u001b[?2004h> "]
[78.592199, "o", "            thresholds[usgs_id] = row['flood stage']\r\n\u001b[?2004l\r"]
[78.592259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.59232, "o", "\u001b[?2004h> "]
[78.592429, "o", "print(f\"Found thresholds for {len(thresholds)} out of {len(station_ids)} stations.\")\r\n\u001b[?2004l\r"]
[78.592488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.592529, "o", "\u001b[?2004h> "]
[78.592569, "o", "# 4. Fetch USGS data and detect floods\r\n\u001b[?2004l\r"]
[78.592618, "o", "\u001b[?2004h> "]
[78.592674, "o", "flood_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.592723, "o", "start_date = '2025-04-01'\r\n\u001b[?2004l\r"]
[78.592774, "o", "\u001b[?2004h> "]
[78.592835, "o", "end_date = '2025-04-07'\r\n\u001b[?2004l\r"]
[78.592895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.592955, "o", "for usgs_id in station_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.593021, "o", "    if usgs_id not in thresholds:\r\n\u001b[?2004l\r"]
[78.593121, "o", "\u001b[?2004h> "]
[78.593191, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.59325, "o", "    threshold = thresholds[usgs_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.593338, "o", "    # Fetch daily values (dv) for gage height (00065)\r\n\u001b[?2004l\r"]
[78.593401, "o", "\u001b[?2004h> "]
[78.593431, "o", "    # We want daily maximum (statCd=00001)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.59369, "o", "    usgs_url = f\"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.593713, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[78.593742, "o", "\u001b[?2004h> "]
[78.593864, "o", "        r = requests.get(usgs_url)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.593911, "o", "        if r.status_code != 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.593967, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594017, "o", "        data = r.json()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594136, "o", "        time_series = data.get('value', {}).get('timeSeries', [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594187, "o", "        if not time_series:\r\n\u001b[?2004l\r"]
[78.594238, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.59429, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594408, "o", "        values = time_series[0].get('values', [{}])[0].get('value', [])\r\n\u001b[?2004l\r"]
[78.594438, "o", "\u001b[?2004h> "]
[78.594561, "o", "        "]
[78.59466, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594759, "o", "        flood_days = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594827, "o", "        for entry in values:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594898, "o", "            val = float(entry['value'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.594965, "o", "            if val >= threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595024, "o", "                flood_days += 1\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595091, "o", "        if flood_days > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.59524, "o", "            flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595344, "o", "            print(f\"Station {usgs_id}: {flood_days} flood days\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.59545, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595515, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595592, "o", "        print(f\"Error processing {usgs_id}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.59567, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # 5. Save results\r\n\u001b[?2004l\r"]
[78.595723, "o", "\u001b[?2004h> "]
[78.595803, "o", "with open('/root/output/flood_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595861, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.595923, "o", "    writer.writerow(['station_id', 'flood_days'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.595983, "o", "> "]
[78.596031, "o", "    for result in flood_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.596135, "o", "        writer.writerow([result['station_id'], result['flood_days']])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.59622, "o", "\u001b[?2004h> print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[78.59754, "o", "\u001b[?2004h"]
[78.597716, "o", "root@1a9f2ac4f133:~# "]
[79.055251, "i", "python3 solution.py\n"]
