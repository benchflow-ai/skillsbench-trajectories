[170.572075, "i", "cat << 'EOF' > test_usgs.py\nimport requests\nusgs_id = \"04031000\"\nstart_date = '2025-04-01'\nend_date = '2025-04-07'\n# Try both gage height (00065) and discharge (00060)\nfor param in [\"00065\", \"00060\"]:\n    url = f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd={param}\"\n    r = requests.get(url)\n    print(f\"Param {param} status: {r.status_code}\")\n    if r.status_code == 200:\n        data = r.json()\n        ts = data.get('value', {}).get('timeSeries', [])\n        print(f\"Param {param} series count: {len(ts)}\")\nEOF\npython3 test_usgs.py\n"]
[170.57243, "o", "cat << 'EOF' > test_usgs.py\r\nimport requests\r\nusgs_id = \"04031000\"\r\nstart_date = '2025-04-01'\r\nend_date = '2025-04-07'\r\n# Try both gage height (00065) and discharge (00060)\r\nfor param in [\"00065\", \"00060\"]:\r\n    url = f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd={param}\"\r\n    r = requests.get(url)\r\n    print(f\"Param {param} status: {r.status_code}\")\r\n    if r.status_code == 200:\r\n        data = r.json()\r\n        ts = data.get('value', {}).get('timeSeries', [])\r\n        print(f\"Param {param} series count: {len(ts)}\")\r\nEOF\r\npython3 test_usgs.py\r\n"]
