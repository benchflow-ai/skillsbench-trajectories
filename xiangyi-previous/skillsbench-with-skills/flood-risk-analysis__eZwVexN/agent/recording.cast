[293.453955, "i", "cat << 'EOF' > solution.py\nimport requests\nimport csv\nimport io\nimport pandas as pd\n\n# 1. Load station IDs\nwith open('/root/data/michigan_stations.txt', 'r') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\n# 2. Download NWS thresholds\nnws_url = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\ntry:\n    response = requests.get(nws_url, timeout=10)\n    content = response.text\n    reader = csv.reader(io.StringIO(content))\n    headers = next(reader)\n    data = [row[:43] for row in reader]\n    nws_df = pd.DataFrame(data, columns=headers)\n    nws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')\nexcept Exception as e:\n    print(f\"Error downloading NWS thresholds: {e}\")\n    exit(1)\n\nthresholds = {}\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row['usgs id']).strip().zfill(8)\n    if usgs_id in station_ids:\n        if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:\n            thresholds[usgs_id] = row['flood stage']\n\n# 4. Fetch USGS data\nflood_results = []\nstart_date = '2025-04-01'\nend_date = '2025-04-07'\n\nprint(f\"Checking {len(thresholds)} stations...\")\n\nfor usgs_id in station_ids:\n    if usgs_id not in thresholds:\n        continue\n    \n    threshold = thresholds[usgs_id]\n    # Use daily maximum values (statCd=00001) for gage height (00065)\n    usgs_url = f\"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001\"\n    \n    try:\n        r = requests.get(usgs_url, timeout=10)\n        if r.status_code == 200:\n            data = r.json()\n            time_series = data.get('value', {}).get('timeSeries', [])\n            if time_series:\n                values = time_series[0].get('values', [{}])[0].get('value', [])\n                flood_days = sum(1 for entry in values if float(entry['value']) >= threshold)\n                if flood_days > 0:\n                    flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\n                   "]
[293.455227, "o", "cat << 'EOF' > solution.py\r\nimport requests\r\nimport csv\r\nimport io\r\nimport pandas as pd\r\n\r\n# 1. Load station IDs\r\nwith open('/root/data/michigan_stations.txt', 'r') as f:\r\n    station_ids = [line.strip() for line in f if line.strip()]\r\n\r\n# 2. Download NWS thresholds\r\nnws_url = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\r\ntry:\r\n    response = requests.get(nws_url, timeout=10)\r\n    content = response.text\r\n    reader = csv.reader(io.StringIO(content))\r\n    headers = next(reader)\r\n    data = [row[:43] for row in reader]\r\n    nws_df = pd.DataFrame(data, columns=headers)\r\n    nws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')\r\nexcept Exception as e:\r\n    print(f\"Error downloading NWS thresholds: {e}\")\r\n    exit(1)\r\n\r\nthresholds = {}\r\nfor _, row in nws_df.iterrows():\r\n    usgs_id = str(row['usgs id']).strip().zfill(8)\r\n    if usgs_id in station_ids:\r\n        if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:\r\n            thresholds[usgs_id] = row['flood stage']\r\n\r\n# 4. Fetch USGS data\r\nflood_results = []\r\nstart_date = '2025-04-01'\r\nend_date = '2025-04-07'\r\n\r\nprint(f\"Checking {len(thresholds)} stations...\")\r\n\r\nfor usgs_id in station_ids:\r\n    if usgs_id not in thresholds:\r\n        continue\r\n    \r\n    threshold = thresholds[usgs_id]\r\n    # Use daily maximum values (statCd=00001) for gage height (00065)\r\n    usgs_url = f\"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001\"\r\n    \r\n    try:\r\n        r = requests.get(usgs_url, timeout=10)\r\n        if r.status_code == 200:\r\n            data = r.json()\r\n            time_series = data.get('value', {}).get('timeSeries', [])\r\n            if time_series:\r\n                values = time_series[0].get('values', [{}])[0].get('value', [])\r\n                flood_days = sum(1 for entry in"]
[293.455326, "o", " values if float(entry['value']) >= threshold)\r\n                if flood_days > 0:\r\n                    flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\r\n                   "]
[293.455499, "i", " print(f\"Station {usgs_id}: {flood_days} flood days\")\n        else:\n            # If no daily values, try instantaneous values (iv)\n            usgs_url_iv = f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065\"\n            r = requests.get(usgs_url_iv, timeout=10)\n            if r.status_code == 200:\n                data = r.json()\n                time_series = data.get('value', {}).get('timeSeries', [])\n                if time_series:\n                    values = time_series[0].get('values', [{}])[0].get('value', [])\n                    # Aggregate to daily max\n                    daily_max = {}\n                    for entry in values:\n                        date = entry['dateTime'].split('T')[0]\n                        val = float(entry['value'])\n                        daily_max[date] = max(daily_max.get(date, -9999), val)\n                    \n                    flood_days = sum(1 for val in daily_max.values() if val >= threshold)\n                    if flood_days > 0:\n                        flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\n                        print(f\"Station {usgs_id} (IV): {flood_days} flood days\")\n    except Exception as e:\n        pass\n\n# 5. Save results\nwith open('/root/output/flood_results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['station_id', 'flood_days'])\n    for result in flood_results:\n        writer.writerow([result['station_id'], result['flood_days']])\nprint(\"Done!\")\nEOF\npython3 solution.py\n"]
[293.456535, "o", " print(f\"Station {usgs_id}: {flood_days} flood days\")\r\n        else:\r\n            # If no daily values, try instantaneous values (iv)\r\n            usgs_url_iv = f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065\"\r\n            r = requests.get(usgs_url_iv, timeout=10)\r\n            if r.status_code == 200:\r\n                data = r.json()\r\n                time_series = data.get('value', {}).get('timeSeries', [])\r\n                if time_series:\r\n                    values = time_series[0].get('values', [{}])[0].get('value', [])\r\n                    # Aggregate to daily max\r\n                    daily_max = {}\r\n                    for entry in values:\r\n                        date = entry['dateTime'].split('T')[0]\r\n                        val = float(entry['value'])\r\n                        daily_max[date] = max(daily_max.get(date, -9999), val)\r\n                    \r\n                    flood_days = sum(1 for val in daily_max.values() if val >= threshold)\r\n                    if flood_days > 0:\r\n                        flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\r\n                        print(f\"Station {usgs_id} (IV): {flood_days} flood days\")\r\n    except Exception as e:\r\n        pass\r\n\r\n# 5. Save results\r\nwith open('/root/output/flood_results.csv', 'w', newline='') as f:\r\n    writer = csv.writer(f)\r\n    writer.writerow(['station_id', 'flood_days'])\r\n    for result in flood_results:\r\n        writer.writerow([result['station_id'], result['flood_days']])\r\nprint(\"Done!\")\r\nEOF\r\npython3 solution.py\r\n"]
