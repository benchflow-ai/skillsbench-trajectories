[600.803899, "o", "\r\n\u001b[?2004l\r"]
[600.804116, "o", "\u001b[?2004h> "]
[600.804185, "o", "# 3. Fetch USGS data using multi-site request"]
[600.804261, "o", "\r\n"]
[600.804336, "o", "\u001b[?2004l\r"]
[600.804447, "o", "\u001b[?2004h"]
[600.804596, "o", "> "]
[600.804664, "o", "start_date = '2025-04-01'"]
[600.804759, "o", "\r\n"]
[600.804913, "o", "\u001b[?2004l\r\u001b[?2004h"]
[600.804981, "o", "> end_date = '2025-04-07'"]
[600.805081, "o", "\r\n"]
[600.805269, "o", "\u001b[?2004l\r\u001b[?2004h"]
[600.805337, "o", "> sites_str = \",\".join(station_ids)"]
[600.805405, "o", "\r\n"]
[600.805501, "o", "\u001b[?2004l\r"]
[600.805614, "o", "\u001b[?2004h"]
[600.805755, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[600.805823, "o", "> flood_results = {}"]
[600.80593, "o", "\r\n"]
[600.806044, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[600.80619, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[600.806255, "o", "def process_data(url):"]
[600.806353, "o", "\r\n"]
[600.806465, "o", "\u001b[?2004l\r\u001b[?2004h"]
[600.806574, "o", ">     try:"]
[600.806751, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[600.806813, "o", "        r = requests.get(url, timeout=30)"]
[600.806878, "o", "\r\n"]
[600.806969, "o", "\u001b[?2004l\r"]
[600.809598, "o", "\u001b[?2004h"]
[600.809911, "o", "> "]
[600.810045, "o", "        if r.status_code != 200: return\r\n\u001b[?2004l\r"]
[600.810217, "o", "\u001b[?2004h"]
[600.810289, "o", ">         data = r.json()"]
[600.810394, "o", "\r\n"]
[600.810659, "o", "\u001b[?2004l\r\u001b[?2004h"]
[600.810731, "o", ">         time_series = data.get('value', {}).get('timeSeries', [])"]
[600.810804, "o", "\r\n"]
[600.810876, "o", "\u001b[?2004l\r"]
[600.810974, "o", "\u001b[?2004h"]
[600.811054, "o", "> "]
[600.811204, "o", "        for ts in time_series:"]
[600.811272, "o", "\r\n"]
[600.811363, "o", "\u001b[?2004l\r"]
[600.811615, "o", "\u001b[?2004h"]
[600.811683, "o", ">             usgs_id = ts['sourceInfo']['siteCode'][0]['value']"]
[600.811749, "o", "\r\n"]
[600.811817, "o", "\u001b[?2004l\r"]
[600.811901, "o", "\u001b[?2004h"]
[600.811977, "o", "> "]
[600.812174, "o", "            if usgs_id not in thresholds: continue"]
[600.812243, "o", "\r\n"]
[600.812311, "o", "\u001b[?2004l\r"]
[600.812395, "o", "\u001b[?2004h"]
[600.812581, "o", "> "]
[600.812645, "o", "            threshold = thresholds[usgs_id]"]
[600.81271, "o", "\r\n"]
[600.812777, "o", "\u001b[?2004l\r"]
[600.812878, "o", "\u001b[?2004h"]
[600.813102, "o", "> "]
[600.81317, "o", "            values = ts.get('values', [{}])[0].get('value', [])"]
[600.813236, "o", "\r\n"]
[600.813303, "o", "\u001b[?2004l\r"]
[600.813387, "o", "\u001b[?2004h"]
[600.8135, "o", "> "]
[600.813562, "o", "            "]
[600.813731, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[600.8138, "o", ">             daily_max = {}"]
[600.813871, "o", "\r\n"]
[600.814055, "o", "\u001b[?2004l\r\u001b[?2004h"]
[600.814126, "o", ">             for entry in values:"]
[600.814192, "o", "\r\n"]
[600.814281, "o", "\u001b[?2004l\r"]
[600.814496, "o", "\u001b[?2004h"]
[600.814564, "o", ">                 date = entry['dateTime'].split('T')[0]"]
[600.814628, "o", "\r\n"]
[600.814696, "o", "\u001b[?2004l\r"]
[600.814783, "o", "\u001b[?2004h"]
[600.81497, "o", "> "]
[600.815033, "o", "                val = float(entry['value'])"]
[600.815096, "o", "\r\n"]
[600.815222, "o", "\u001b[?2004l\r"]
[600.815498, "o", "\u001b[?2004h"]
[600.81557, "o", ">                 daily_max[date] = max(daily_max.get(date, -9999), val)"]
[600.815639, "o", "\r\n"]
[600.815708, "o", "\u001b[?2004l\r"]
[600.815794, "o", "\u001b[?2004h"]
[600.815871, "o", "> "]
[600.815975, "o", "            "]
[600.816045, "o", "\r\n"]
[600.816137, "o", "\u001b[?2004l\r"]
[600.81642, "o", "\u001b[?2004h"]
[600.816478, "o", ">             flood_days = sum(1 for val in daily_max.values() if val >= threshold)"]
[600.816541, "o", "\r\n"]
[600.816607, "o", "\u001b[?2004l\r"]
[600.81669, "o", "\u001b[?2004h"]
[600.816764, "o", "> "]
[600.816906, "o", "            if flood_days > 0:"]
[600.816974, "o", "\r\n"]
[600.817041, "o", "\u001b[?2004l\r"]
[600.817133, "o", "\u001b[?2004h"]
[600.817432, "o", "> "]
[600.817492, "o", "                flood_results[usgs_id] = max(flood_results.get(usgs_id, 0), flood_days)"]
[600.817562, "o", "\r\n"]
[600.817629, "o", "\u001b[?2004l\r"]
[600.817713, "o", "\u001b[?2004h"]
[600.817787, "o", "> "]
[600.81792, "o", "    except Exception as e:"]
[600.817988, "o", "\r\n"]
[600.818049, "o", "\u001b[?2004l\r"]
[600.818139, "o", "\u001b[?2004h"]
[600.818289, "o", "> "]
[600.818348, "o", "        print(f\"Error: {e}\")"]
[600.818414, "o", "\r\n"]
[600.818514, "o", "\u001b[?2004l\r"]
[600.81861, "o", "\u001b[?2004h> "]
[600.818756, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[600.818822, "o", "> # Try daily values first"]
[600.818914, "o", "\r\n"]
[600.819099, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[600.819168, "o", "print(\"Fetching Daily Values...\")"]
[600.819224, "o", "\r\n"]
[600.819296, "o", "\u001b[?2004l\r"]
[600.819477, "o", "\u001b[?2004h> "]
[600.819823, "o", "process_data(f\"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001\")"]
[600.819865, "o", "\r\n"]
[600.819904, "o", "\u001b[?2004l\r"]
[600.819975, "o", "\u001b[?2004h"]
[600.820031, "o", "> "]
[600.820083, "o", "\r\n"]
[600.820136, "o", "\u001b[?2004l\r"]
[600.820198, "o", "\u001b[?2004h"]
[600.820253, "o", "> "]
[600.820453, "o", "# Then try instantaneous values for any missing or to supplement"]
[600.820494, "o", "\r\n"]
[600.820538, "o", "\u001b[?2004l\r"]
[600.8206, "o", "\u001b[?2004h"]
[600.820653, "o", "> "]
[600.820798, "o", "print(\"Fetching Instantaneous Values...\")"]
[600.820841, "o", "\r\n"]
[600.820886, "o", "\u001b[?2004l\r"]
[600.820944, "o", "\u001b[?2004h"]
[600.820994, "o", "> "]
[600.821383, "o", "process_data(f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065\")"]
[600.821425, "o", "\r\n"]
[600.821469, "o", "\u001b[?2004l\r"]
[600.821527, "o", "\u001b[?2004h"]
[600.821576, "o", "> "]
[600.821622, "o", "\r\n"]
[600.821665, "o", "\u001b[?2004l\r"]
[600.82172, "o", "\u001b[?2004h"]
[600.821771, "o", "> "]
[600.821861, "o", "# 4. Save results"]
[600.82191, "o", "\r\n"]
[600.821955, "o", "\u001b[?2004l\r"]
[600.82201, "o", "\u001b[?2004h"]
[600.822059, "o", "> "]
[600.822265, "o", "with open('/root/output/flood_results.csv', 'w', newline='') as f:"]
[600.822308, "o", "\r\n"]
[600.822353, "o", "\u001b[?2004l\r"]
[600.822414, "o", "\u001b[?2004h"]
[600.822464, "o", "> "]
[600.822573, "o", "    writer = csv.writer(f)"]
[600.822615, "o", "\r\n"]
[600.822659, "o", "\u001b[?2004l\r"]
[600.822717, "o", "\u001b[?2004h"]
[600.822766, "o", "> "]
[600.822938, "o", "    writer.writerow(['station_id', 'flood_days'])"]
[600.822984, "o", "\r\n"]
[600.82303, "o", "\u001b[?2004l\r"]
[600.823088, "o", "\u001b[?2004h"]
[600.82314, "o", "> "]
[600.823313, "o", "    for usgs_id, flood_days in flood_results.items():"]
[600.823356, "o", "\r\n"]
[600.823398, "o", "\u001b[?2004l\r"]
[600.823475, "o", "\u001b[?2004h"]
[600.823529, "o", "> "]
[600.823695, "o", "        writer.writerow([usgs_id, flood_days])"]
[600.823741, "o", "\r\n"]
[600.823791, "o", "\u001b[?2004l\r"]
[600.823852, "o", "\u001b[?2004h"]
[600.823904, "o", "> "]
[600.823953, "o", "\r\n"]
[600.823999, "o", "\u001b[?2004l\r"]
[600.824062, "o", "\u001b[?2004h"]
[600.82412, "o", "> "]
[600.82434, "o", "print(f\"Done! Found {len(flood_results)} stations with flooding.\")"]
[600.824386, "o", "\r\n"]
[600.824432, "o", "\u001b[?2004l\r"]
[600.824495, "o", "\u001b[?2004h"]
[600.824546, "o", "> "]
[600.824607, "o", "EOF"]
[600.824658, "o", "\r\n"]
[600.824707, "o", "\u001b[?2004l\r"]
[600.869328, "o", "\u001b[?2004hroot@1a9f2ac4f133:~# "]
[600.869401, "o", "python3 solution.py\r\n\u001b[?2004l\r"]
[603.302852, "o", "Fetching Daily Values..."]
[603.303159, "o", "\r\n"]
[603.735625, "o", "Fetching Instantaneous Values...\r\n"]
[607.188207, "o", "Done! Found 0 stations with flooding.\r\n"]
[607.373245, "o", "\u001b[?2004hroot@1a9f2ac4f133:~# "]
