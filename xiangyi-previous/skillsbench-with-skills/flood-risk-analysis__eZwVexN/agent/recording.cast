[707.719088, "i", "cat << 'EOF' > solution.py\nimport requests\nimport csv\nimport io\nimport pandas as pd\n\n# 1. Load station IDs\nwith open('/root/data/michigan_stations.txt', 'r') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\n# 2. Download NWS thresholds\nnws_url = \"https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv\"\nresponse = requests.get(nws_url)\ncontent = response.text\nreader = csv.reader(io.StringIO(content))\nheaders = next(reader)\ndata = [row[:43] for row in reader]\nnws_df = pd.DataFrame(data, columns=headers)\nnws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')\n\nthresholds = {}\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row['usgs id']).strip().zfill(8)\n    if usgs_id in station_ids:\n        if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:\n            thresholds[usgs_id] = row['flood stage']\n\n# 3. Fetch USGS data in batches\nstart_date = '2025-04-01'\nend_date = '2025-04-07'\nflood_results = []\n\nbatch_size = 20\nfor i in range(0, len(station_ids), batch_size):\n    batch = station_ids[i:i+batch_size]\n    sites_str = \",\".join(batch)\n    url = f\"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065\"\n    \n    try:\n        r = requests.get(url, timeout=60)\n        if r.status_code != 200: continue\n        data = r.json()\n        time_series = data.get('value', {}).get('timeSeries', [])\n        \n        for ts in time_series:\n            usgs_id = ts['sourceInfo']['siteCode'][0]['value']\n            if usgs_id not in thresholds: continue\n            threshold = thresholds[usgs_id]\n            \n            values = ts.get('values', [{}])[0].get('value', [])\n            daily_max = {}\n            for entry in values:\n                dt = entry['dateTime'].split('T')[0]\n                val = float(entry['value'])\n                daily_max[dt] = max(daily_max.get(dt, -9999), val)\n            \n            flood_days = sum(1 for val in daily_max.values() if val >= threshold)\n            if flood_days > 0:\n                flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})\n                print(f\"Station {usgs_id}: {flood_days} flood days\")\n    except Exception as e:\n        print(f\"Error batch {i}: {e}\")\n\n# 4. Save results\nwith open('/root/output/flood_results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['station_id', 'flood_days'])\n    for result in flood_results:\n        writer.writerow([result['station_id'], result['flood_days']])\nEOF\npython3 solution.py\n"]
[707.719372, "o", "cat << 'EOF' > solution.py"]
