cat << 'EOF' > solution.py
import requests
import csv
import io
import pandas as pd

# 1. Load station IDs
with open('/root/data/michigan_stations.txt', 'r') as f:
    station_ids = [line.strip() for line in f if line.strip()]

# 2. Download NWS thresholds
nws_url = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"
try:
    response = requests.get(nws_url, timeout=10)
    content = response.text
    reader = csv.reader(io.StringIO(content))
    headers = next(reader)
    data = [row[:43] for row in reader]
    nws_df = pd.DataFrame(data, columns=headers)
    nws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')
except Exception as e:
    print(f"Error downloading NWS thresholds: {e}")
    exit(1)

thresholds = {}
for _, row in nws_df.iterrows():
    usgs_id = str(row['usgs id']).strip().zfill(8)
    if usgs_id in station_ids:
        if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:
            thresholds[usgs_id] = row['flood stage']

# 4. Fetch USGS data
flood_results = []
start_date = '2025-04-01'
end_date = '2025-04-07'

print(f"Checking {len(thresholds)} stations...")

for usgs_id in station_ids:
    if usgs_id not in thresholds:
        continue
    
    threshold = thresholds[usgs_id]
    # Use daily maximum values (statCd=00001) for gage height (00065)
    usgs_url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001"
    
    try:
        r = requests.get(usgs_url, timeout=10)
        if r.status_code == 200:
            data = r.json()
            time_series = data.get('value', {}).get('timeSeries', [])
            if time_series:
                values = time_series[0].get('values', [{}])[0].get('value', [])
                flood_days = sum(1 for entry in values if float(entry['value']) >= threshold)
                if flood_days > 0:
                    flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})
                    print(f"Station {usgs_id}: {flood_days} flood days")
        else:
            # If no daily values, try instantaneous values (iv)
            usgs_url_iv = f"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065"
            r = requests.get(usgs_url_iv, timeout=10)
            if r.status_code == 200:
                data = r.json()
                time_series = data.get('value', {}).get('timeSeries', [])
                if time_series:
                    values = time_series[0].get('values', [{}])[0].get('value', [])
                    # Aggregate to daily max
                    daily_max = {}
                    for entry in values:
                        date = entry['dateTime'].split('T')[0]
                        val = float(entry['value'])
                        daily_max[date] = max(daily_max.get(date, -9999), val)
                    
                    flood_days = sum(1 for val in daily_max.values() if val >= threshold)
                    if flood_days > 0:
                        flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})
                        print(f"Station {usgs_id} (IV): {flood_days} flood days")
    except Exception as e:
        pass

# 5. Save results
with open('/root/output/flood_results.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['station_id', 'flood_days'])
    for result in flood_results:
        writer.writerow([result['station_id'], result['flood_days']])
print("Done!")
