[?2004hroot@1a9f2ac4f133:~# cat << 'EOF' > solution.py
[?2004l[?2004h> import requests
[?2004l[?2004h> import csv
[?2004l[?2004h> import io
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load station IDs
[?2004l[?2004h> with open('/root/data/michigan_stations.txt', 'r') as f:
[?2004l[?2004h>     station_ids = [line.strip() for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Download NWS thresholds
[?2004l[?2004h> nws_url = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"
[?2004l[?2004h> response = requests.get(nws_url)
[?2004l[?2004h> content = response.text
[?2004l[?2004h> reader = csv.reader(io.StringIO(content))
[?2004l[?2004h> headers = next(reader)
[?2004l[?2004h> data = [row[:43] for row in reader]
[?2004l[?2004h> nws_df = pd.DataFrame(data, columns=headers)
[?2004l[?2004h> nws_df['flood stage'] = pd.to_numeric(nws_df['flood stage'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> thresholds = {}
[?2004l[?2004h> for _, row in nws_df.iterrows():
[?2004l[?2004h>     usgs_id = str(row['usgs id']).strip().zfill(8)
[?2004l[?2004h>     if usgs_id in station_ids:
[?2004l[?2004h>         if not pd.isna(row['flood stage']) and row['flood stage'] != -9999:
[?2004l[?2004h>             thresholds[usgs_id] = row['flood stage']
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Fetch USGS data in batches
[?2004l[?2004h> start_date = '2025-04-01'
[?2004l[?2004h> end_date = '2025-04-07'
[?2004l[?2004h> flood_results = []
[?2004l[?2004h> 
[?2004l[?2004h> batch_size = 20
[?2004l[?2004h> for i in range(0, len(station_ids), batch_size):
[?2004l[?2004h>     batch = station_ids[i:i+batch_size]
[?2004l[?2004h>     sites_str = ",".join(batch)
[?2004l[?2004h>     url = f"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065"
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         r = requests.get(url, timeout=60)
[?2004l[?2004h>         if r.status_code != 200: continue
[?2004l[?2004h>         data = r.json()
[?2004l[?2004h>         time_series = data.get('value', {}).get('timeSeries', [])
[?2004l[?2004h>         
[?2004l[?2004h>         for ts in time_series:
[?2004l[?2004h>             usgs_id = ts['sourceInfo']['siteCode'][0]['value']
[?2004l[?2004h>             if usgs_id not in thresholds: continue
[?2004l[?2004h>             threshold = thresholds[usgs_id]
[?2004l[?2004h>             
[?2004l[?2004h>             values = ts.get('values', [{}])[0].get('value', [])
[?2004l[?2004h>             daily_max = {}
[?2004l[?2004h>             for entry in values:
[?2004l[?2004h>                 dt = entry['dateTime'].split('T')[0]
[?2004l[?2004h>                 val = float(entry['value'])
[?2004l[?2004h>                 daily_max[dt] = max(daily_max.get(dt, -9999), val)
[?2004l[?2004h>             
[?2004l[?2004h>             flood_days = sum(1 for val in daily_max.values() if val >= threshold)
[?2004l[?2004h>             if flood_days > 0:
[?2004l[?2004h>                 flood_results.append({'station_id': usgs_id, 'flood_days': flood_days})
[?2004l[?2004h>                 print(f"Station {usgs_id}: {flood_days} flood days")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error batch {i}: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Save results
[?2004l[?2004h> with open('/root/output/flood_results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.writer(f)
[?2004l[?2004h>     writer.writerow(['station_id', 'flood_days'])
[?2004l[?2004h>     for result in flood_results:
[?2004l[?2004h>         writer.writerow([result['station_id'], result['flood_days']])
[?2004l[?2004h> EOF
