[?2004lclass WhitespaceTokenizer(
    lowercase: Boolean = false,
    minLength: Int = 0,
    maxLength: Option[Int] = None,
    stripPunctuation: Boolean = false
) {
  private val punctuation: Set[Char] = ".,!?;:'\"()[]{}".toSet

  private def stripPunct(word: String): String = {
    def isPunct(c: Char) = punctuation.contains(c)
    word.dropWhile(isPunct).reverse.dropWhile(isPunct).reverse
  }

  private def processToken(word: String): Option[String] = {
    val stripped = if (stripPunctuation) stripPunct(word) else word
    val normalized = if (lowercase) stripped.toLowerCase else stripped

    if (normalized.length < minLength) {
      None
    } else {
      val truncated = maxLength match {
        case Some(max) if normalized.length > max => normalized.take(max)
        case _                                    => normalized
      }
      if (truncated.nonEmpty) Some(truncated) else None
    }
  }

  def tokenize(text: String): List[Token] = {
    val words = text.split("\\s+").filter(_.nonEmpty)
    val buffer = ListBuffer.empty[Token]

    words.zipWithIndex.foreach { case (word, idx) =>
      processToken(word).foreach { processed =>
        buffer += Token(
          processed,
          TokenType.STRING,
          Map("position" -> idx, "original" -> word)
        )
      }
    }

    buffer.toList
  }

  def tokenizeToStrings(text: String): List[String] =
    tokenize(text).map(_.value)

  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {
    val results = ListBuffer.empty[(String, Int, Int)]
    var currentPos = 0

    text.split("\\s+").filter(_.nonEmpty).foreach { word =>
      val start = text.indexOf(word, currentPos)
      val end = start + word.length

      processToken(word).foreach { processed =>
        results += ((processed, start, end))
      }

      currentPos = end
    }

    results.toList
  }

  def countTokens(text: String): Int = tokenize(text).length
}

