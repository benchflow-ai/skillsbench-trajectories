lazy val root = (project in file("."))
  .settings(
    name := "scala-tokenizer",
    libraryDependencies ++= Seq(
      // JSON processing
      "io.circe" %% "circe-core" % "0.14.6",
      "io.circe" %% "circe-generic" % "0.14.6",
