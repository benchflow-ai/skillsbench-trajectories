[354.11907, "o", "class WhitespaceTokenizer(\r\n    lowercase: Boolean = false,\r\n    minLength: Int = 0,\r\n    maxLength: Option[Int] = None,\r\n    stripPunctuation: Boolean = false\r\n) {\r\n  private val punctuation: Set[Char] = \".,!?;:'\\\"()[]{}\".toSet\r\n\r\n  private def stripPunct(word: String): String = {\r\n    def isPunct(c: Char) = punctuation.contains(c)\r\n    word.dropWhile(isPunct).reverse.dropWhile(isPunct).reverse\r\n  }\r\n\r\n  private def processToken(word: String): Option[String] = {\r\n    val stripped = if (stripPunctuation) stripPunct(word) else word\r\n    val normalized = if (lowercase) stripped.toLowerCase else stripped\r\n\r\n    if (normalized.length < minLength) {\r\n      None\r\n    } else {\r\n      val truncated = maxLength match {\r\n        case Some(max) if normalized.length > max => normalized.take(max)\r\n        case _                                    => normalized\r\n      }\r\n      if (truncated.nonEmpty) Some(truncated) else None\r\n    }\r\n  }\r\n\r\n  def tokenize(text: String): List[Token] = {\r\n    val words = text.split(\"\\\\s+\").filter(_.nonEmpty)\r\n    val buffer = ListBuffer.empty[Token]\r\n\r\n    words.zipWithIndex.foreach { case (word, idx) =>\r\n"]
[354.119108, "o", "      processToken(word).foreach { processed =>\r\n        buffer += Token(\r\n          processed,\r\n          TokenType.STRING,\r\n          Map(\"position\" -> idx, \"original\" -> word)\r\n        )\r\n      }\r\n    }\r\n\r\n    buffer.toList\r\n  }\r\n\r\n  def tokenizeToStrings(text: String): List[String] =\r\n    tokenize(text).map(_.value)\r\n\r\n  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\r\n    val results = ListBuffer.empty[(String, Int, Int)]\r\n    var currentPos = 0\r\n\r\n    text.split(\"\\\\s+\").filter(_.nonEmpty).foreach { word =>\r\n      val start = text.indexOf(word, currentPos)\r\n      val end = start + word.length\r\n\r\n      processToken(word).foreach { processed =>\r\n        results += ((processed, start, end))\r\n      }\r\n\r\n      currentPos = end\r\n    }\r\n\r\n    results.toList\r\n  }\r\n\r\n  def countTokens(text: String): Int = tokenize(text).length\r\n}\r\n\r\n// ==========================================================================\r\n// Builder pattern with fluent interface\r\n// =========================================================================="]
[354.119136, "o", "\r\n\r\nclass TokenizerBuilder[T] private () {\r\n  private val normalizers = ListBuffer.empty[String => String]\r\n  private val validators = ListBuffer.empty[T => Boolean]\r\n  private val metadata = mutable.Map.empty[String, Any]\r\n"]
[354.1193, "o", "\r\n  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\r\n    normalizers += normalizer\r\n    this\r\n"]
