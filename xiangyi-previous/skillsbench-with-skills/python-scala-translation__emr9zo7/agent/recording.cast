[4.587614, "o", "total 92\r\ndrwx------ 1 root root  4096 Jan 26 11:06 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root  4096 Jan 26 11:06 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.agents\u001b[0m\r\n-rw-r--r-- 1 root root  3106 Apr 22  2024 .bashrc\r\ndrwxr-xr-x 1 root root  4096 Jan 26 07:04 \u001b[01;34m.cache\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.claude\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.codex\u001b[0m\r\ndrwxr-xr-x 4 root root  4096 Jan 26 11:06 \u001b[01;34m.config\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.factory\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.gemini\u001b[0m\r\ndrwxr-xr-x 3 root root  4096 Jan 26 07:04 \u001b[01;34m.goose\u001b[0m"]
