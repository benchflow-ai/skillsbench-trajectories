[298.979133, "o", "    word.dropWhile(isPunct).reverse.dropWhile(isPunct).reverse\r\n\u001b[?2004l\r"]
[298.979179, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
