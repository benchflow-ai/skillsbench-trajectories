[358.811657, "o", "}\r\n\r\n// ==========================================================================\r\n// Higher-kinded type simulation\r\n// ==========================================================================\r\n\r\nclass TokenFunctor[T](val value: T) {\r\n  def map[U](func: T => U): TokenFunctor[U] = new TokenFunctor(func(value))\r\n\r\n  def flatMap[U](func: T => TokenFunctor[U]): TokenFunctor[U] = func(value)\r\n\r\n  def getOrElse(default: => T): T = if (value != null) value else default\r\n\r\n  def get: T = value\r\n}\r\n\r\nclass TokenMonad[T](value: T) extends TokenFunctor[T](value) {\r\n  def ap[U](funcWrapped: TokenMonad[T => U]): TokenMonad[U] =\r\n    new TokenMonad(funcWrapped.value(value))\r\n}\r\n\r\nobject TokenMonad {\r\n  def pure[T](value: T): TokenMonad[T] = new TokenMonad(value)\r\n}\r\n"]
[358.811699, "o", "\r\n// ==========================================================================\r\n// JSON structure tokenization\r\n// ==========================================================================\r\n\r\n\r\nclass JsonTokenizer(pretty: Boolean = false) {\r\n  private val printer = if (pretty) Printer.spaces2 else Printer.noSpaces\r\n\r\n  def tokenize(value: Json): Token = {\r\n    val jsonStr = printer.print(value)\r\n    Token(jsonStr, TokenType.STRUCTURED, Map(\"json\" -> true))\r\n  }\r\n\r\n  def tokenizePath(value: Json, path: String): Option[Token] = {\r\n    val parts = path.split(\"\\\\.\").toList.filter(_.nonEmpty)\r\n    var current: Option[Json] = Some(value)\r\n\r\n    parts.foreach { part =>\r\n      current = current.flatMap { json =>\r\n        json.asObject.flatMap(_.apply(part)).orElse {\r\n          json.asArray.flatMap { arr =>\r\n            if (part.forall(_.isDigit)) arr.lift(part.toInt) else None\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    current.map(tokenize)\r\n  }\r\n}\r\n\r\n// ==========================================================================\r\n// Whitespace tokenizer\r\n// =========================================================================="]
[358.811841, "o", "\r\n\r\nclass WhitespaceTokenizer(\r\n    lowercase: Boolean = false,\r\n    minLength: Int = 0,\r\n    maxLength: Option[Int] = None,\r\n    stripPunctuation: Boolean = false\r\n) {\r\n  private val punctuation: Set[Char] = \".,!?;:'\\\"()[]{}\".toSet\r\n\r\n  private def stripPunct(word: String): String = {\r\n    def isPunct(c: Char) = punctuation.contains(c)\r\n    word.dropWhile(isPunct).reverse.dropWhile(isPunct).reverse\r\n  }\r\n\r\n  private def processToken(word: String): Option[String] = {\r\n    val stripped = if (stripPunctuation) stripPunct(word) else word\r\n    val normalized = if (lowercase) stripped.toLowerCase else stripped\r\n\r\n    if (normalized.length < minLength) {\r\n      None\r\n    } else {\r\n      val truncated = maxLength match {\r\n"]
