[42.79953, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kto_token(self) -> str: ...\r\n\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__len__(self) -> int: ...\r\n\u001b[32m\u001b[K54\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kprocess(self, item: T_contra) -> None: ...\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwith_metadata(self, **kwargs: Any) -> \"Token\":\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kadd(self, token: Token) -> None:\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kmark_processed(self) -> None:\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, items: Sequence[T_co]) -> None:\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_all(self) -> tuple[T_co, ...]:\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kmap_tokens(self, func: Callable[[T_co], str]) -> list[str]:\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self) -> None:\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kreceive(self, item: T_contra) -> None:\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kdrain(self) -> list[Any]:\r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, default: T) -> None:\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget(self) -> T:\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kset(self, value: T) -> None:\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktransform(self, func: Callable[[T], T]) -> T:\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: T) -> Token:\r\n\u001b[32m\u001b[K169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize_batch(self, values: Iterable[T]) -> Iterator[Token]:\r\n\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, encoding: str = \"utf-8\", normalizer: Callable[[str], str] | None = None) -> None:\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: StrOrBytes) -> Token:\r\n\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(\r\n\u001b[32m\u001b[K204\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: NumericT) -> Token:\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, format_str: str | None = None) -> None:\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: datetime | date) -> Token:\r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self) -> None:\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: str) -> Token: ...\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: bytes) -> Token: ...\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: int) -> Token: ...\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: float) -> Token: ...\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: datetime) -> Token: ...\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: None) -> Token: ...\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: Tokenizable) -> Token: ...\r\n"]
[42.79965, "o", "\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: Any) -> Token:\r\n\u001b[32m\u001b[K303\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self) -> None:\r\n\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kregister(self, key: str, container: TokenContainer[T]) -> None:\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kadd_handler(self, handler: Callable[[T], Token | None]) -> None:\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kprocess(self, key: str) -> list[Token | None]:\r\n\u001b[32m\u001b[K348\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, value: T) -> None:\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kmap(self, func: Callable[[T], Any]) -> \"TokenFunctor[Any]\":\r\n\u001b[32m\u001b[K354\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kflat_map(self, func: Callable[[T], \"TokenFunctor[Any]\"]) -> \"TokenFunctor[Any]\":\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_or_else(self, default: T) -> T:\r\n\u001b[32m\u001b[K365\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kpure(cls, value: T) -> \"TokenMonad[T]\":\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kap(self, func_wrapped: \"TokenMonad[Callable[[T], Any]]\") -> \"TokenMonad[Any]\":\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, pretty: bool = False) -> None:\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, value: JsonValue) -> Token:\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize_path(self, value: JsonValue, path: str) -> Token | None:\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, lowercase: bool = False, min_length: int = 0, max_length: int | None = None, strip_punctuation: bool = False) -> None:\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K_process_token(self, word: str) -> str | None:\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(self, text: str) -> list[Token]:\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize_to_strings(self, text: str) -> list[str]:\r\n\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize_with_positions(self, text: str) -> list[tuple[str, int, int]]:\r\n\u001b[32m\u001b[K525\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcount_tokens(self, text: str) -> int:\r\n\u001b[32m\u001b[K543\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self) -> None:\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwith_normalizer(self, normalizer: Callable[[str], str]) -> \"TokenizerBuilder[T]\":"]
[42.799741, "o", "\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwith_validator(self, validator: Callable[[T], bool]) -> \"TokenizerBuilder[T]\":\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwith_metadata(self, **kwargs: Any) -> \"TokenizerBuilder[T]\":\r\n\u001b[32m\u001b[K560\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild(self) -> Callable[[T], Token]:\r\n\u001b[32m\u001b[K566\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktokenize(value: T) -> Token:\r\n"]
[42.799862, "o", "\u001b[?2004hroot@034fb4de3a07:~# "]
[55.163282, "i", "sed -n '1,200p' /root/TokenizerSpec.scala\n"]
[55.163532, "o", "sed -n '1,200p' /root/TokenizerSpec.scala\r\n\u001b[?2004l\r"]
[55.164577, "o", "package tokenizer\r\n\r\nimport org.scalatest.flatspec.AnyFlatSpec\r\nimport org.scalatest.matchers.should.Matchers\r\nimport org.scalatest.BeforeAndAfterEach\r\n\r\nimport java.time.{LocalDate, LocalDateTime}\r\nimport io.circe.parser._\r\nimport io.circe.syntax._\r\nimport io.circe.Json\r\n\r\nclass TokenizerSpec extends AnyFlatSpec with Matchers with BeforeAndAfterEach {\r\n\r\n  // ============================================================================\r\n  // TokenType Tests\r\n  // ============================================================================\r\n\r\n  \"TokenType\" should \"have correct string values\" in {\r\n    TokenType.STRING.value shouldBe \"string\"\r\n    TokenType.NUMERIC.value shouldBe \"numeric\"\r\n    TokenType.TEMPORAL.value shouldBe \"temporal\"\r\n    TokenType.STRUCTURED.value shouldBe \"structured\"\r\n    TokenType.BINARY.value shouldBe \"binary\"\r\n"]
[55.164702, "o", "    TokenType.NULL.value shouldBe \"null\"\r\n  }\r\n\r\n\r\n  // ============================================================================\r\n  // Token Tests\r\n  // ============================================================================\r\n\r\n  \"Token\" should \"be immutable and create new instances with metadata\" in {\r\n    val token = Token(\"test\", TokenType.STRING)\r\n    val tokenWithMeta = token.withMetadata(\"key\" -> \"value\")\r\n\r\n    token.metadata shouldBe empty\r\n    tokenWithMeta.metadata should contain (\"key\" -> \"value\")\r\n    token should not be theSameInstanceAs(tokenWithMeta)\r\n  }\r\n"]
[55.164796, "o", "\r\n\r\n  // ============================================================================\r\n  // TokenContainer Tests (Covariant)\r\n  // ============================================================================\r\n\r\n  \"TokenContainer\" should \"store and retrieve items\" in {\r\n    val container = new TokenContainer(Seq(\"a\", \"b\", \"c\"))\r\n\r\n    container.getAll shouldBe Vector(\"a\", \"b\", \"c\")\r\n    container.size shouldBe 3\r\n  }\r\n\r\n\r\n  // ============================================================================\r\n  // UniversalTokenizer Tests\r\n  // ============================================================================\r\n\r\n  \"UniversalTokenizer\" should \"tokenize null values\" in {\r\n    val tokenizer = new UniversalTokenizer()\r\n    val token = tokenizer.tokenizeNull\r\n\r\n    token.value shouldBe \"NULL\"\r\n    token.tokenType shouldBe TokenType.NULL\r\n  }\r\n\r\n  it should \"tokenize datetime\" in {\r\n    val tokenizer = new UniversalTokenizer()\r\n    val dt = LocalDateTime.of(2024, 1, 15, 10, 30, 0)\r\n    val token = tokenizer.tokenize(dt)\r\n\r\n    token.tokenType shouldBe TokenType.TEMPORAL\r\n    token.value should include (\"2024-01-15\")\r\n  }\r\n\r\n\r\n  // ============================================================================\r\n  // TokenRegistry Tests\r\n  // ============================================================================\r\n\r\n  \"TokenRegistry\" should \"register and process containers\" in {\r\n    val registry = new TokenRegistry[String]\r\n    val container = new TokenContainer(Seq(\"hello\", \"world\"))\r\n\r\n    registry.register(\"test\", container)\r\n    registry.addHandler { s =>\r\n      Some(Token(s.toUpperCase, TokenType.STRING))\r\n    }\r\n\r\n    val results = registry.process(\"test\")\r\n    results should have size 2\r\n    results.flatten.map(_.value) shouldBe List(\"HELLO\", \"WORLD\")\r\n  }"]
[55.164879, "o", "\r\n\r\n\r\n  // ============================================================================\r\n  // TokenFunctor Tests\r\n  // ============================================================================\r\n\r\n  \"TokenFunctor\" should \"map values\" in {\r\n    val functor = new TokenFunctor(5)\r\n    val mapped = functor.map(_ * 2)\r\n\r\n    mapped.get shouldBe 10\r\n  }\r\n\r\n\r\n  // ============================================================================\r\n  // JsonTokenizer Tests\r\n  // ============================================================================\r\n\r\n  \"JsonTokenizer\" should \"tokenize JSON values\" in {\r\n    val tokenizer = new JsonTokenizer()\r\n    val json = parse(\"\"\"{\"key\": \"value\"}\"\"\").getOrElse(Json.Null)\r\n    val token = tokenizer.tokenize(json)\r\n\r\n    token.tokenType shouldBe TokenType.STRUCTURED\r\n    token.metadata should contain (\"json\" -> true)\r\n    token.value should include (\"key\")\r\n  }\r\n\r\n\r\n  // ============================================================================\r\n  // WhitespaceTokenizer Tests\r\n  // ============================================================================\r\n\r\n  \"WhitespaceTokenizer\" should \"combine multiple options\" in {\r\n    val tokenizer = new WhitespaceTokenizer(\r\n      lowercase = true,\r\n      minLength = 2,\r\n      maxLength = Some(4),\r\n      stripPunctuation = true\r\n    )\r\n    val tokens = tokenizer.tokenize(\"A, Hello! WORLD...\")\r\n\r\n    tokens.map(_.value) shouldBe List(\"hell\", \"worl\")\r\n  }\r\n\r\n  // ============================================================================\r\n  // TokenizerBuilder Tests\r\n  // ============================================================================\r\n\r\n  \"TokenizerBuilder\" should \"chain multiple operations fluently\" in {\r\n    val tokenizer = TokenizerBuilder[String]()\r\n      .withNormalizer(_.toLowerCase)\r\n      .withNormalizer(_.replace(\" \", \"_\"))\r\n      .withValidator(_.nonEmpty)\r\n      .withMetadata(\"type\" -> \"custom\")\r\n      .build()\r\n\r\n    val token = tokenizer(\"Hello World\")\r\n    token.value shouldBe \"hello_world\"\r\n    token.metadata should contain (\"type\" -> \"custom\")\r\n  }\r\n\r\n}\r\n"]
[55.165129, "o", "\u001b[?2004hroot@034fb4de3a07:~# "]
[55.260263, "i", "sed -n '200,400p' /root/TokenizerSpec.scala\n"]
[55.260489, "o", "sed -n '200,400p' /root/TokenizerSpec.scala\r\n\u001b[?2004l\r"]
