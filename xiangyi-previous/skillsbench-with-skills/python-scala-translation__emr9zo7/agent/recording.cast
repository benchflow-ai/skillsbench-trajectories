[298.976461, "o", "        json.asObject.flatMap(_.apply(part)).orElse {\r\n\u001b[?2004l\r\u001b[?2004h>           json.asArray.flatMap { arr =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
