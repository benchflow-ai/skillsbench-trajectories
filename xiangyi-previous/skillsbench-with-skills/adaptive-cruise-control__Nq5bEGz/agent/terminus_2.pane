[?2004l[?2004h> import yaml
[?2004l[?2004h> from pid_controller import PIDController
[?2004l[?2004h> 
[?2004l[?2004h> class AdaptiveCruiseControl:
[?2004l[?2004h>     """Adaptive Cruise Control system with cruise, follow, and emergency modes."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, config):
[?2004l[?2004h>         """Initialize ACC system with configuration."""
[?2004l[?2004h>         self.set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>         self.time_headway = config['acc_settings']['time_headway']
[?2004l[?2004h>         self.min_distance = config['acc_settings']['min_distance']
[?2004l[?2004h>         self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']
[?2004l[?2004h>         self.max_acceleration = config['vehicle']['max_acceleration']
[?2004l[?2004h>         self.max_deceleration = config['vehicle']['max_deceleration']
[?2004l[?2004h>         self.speed_controller = None
[?2004l[?2004h>         self.distance_controller = None
[?2004l[?2004h>         self.previous_mode = None
[?2004l[?2004h>     
[?2004l[?2004h>     def set_pid_controllers(self, speed_pid_params, distance_pid_params):
[?2004l[?2004h>         """Set PID controllers with tuned parameters."""
[?2004l[?2004h>         self.speed_controller = PIDController(
[?2004l[?2004h>             speed_pid_params['kp'],
[?2004l[?2004h>             speed_pid_params['ki'],
[?2004l[?2004h>             speed_pid_params['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>         self.distance_controller = PIDController(
[?2004l[?2004h>             distance_pid_params['kp'],
[?2004l[?2004h>             distance_pid_params['ki'],
[?2004l[?2004h>             distance_pid_params['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def compute(self, ego_speed, lead_speed, distance, dt):
[?2004l[?2004h>         """Compute acceleration command based on current state."""
[?2004l[?2004h>         # Cruise mode: no lead vehicle detected
[?2004l[?2004h>         if lead_speed is None or distance is None:
[?2004l[?2004h>             mode = 'cruise'
[?2004l[?2004h>             
[?2004l[?2004h>             # Reset distance controller when entering cruise mode
[?2004l[?2004h>             if self.previous_mode != 'cruise':
[?2004l[?2004h>                 self.distance_controller.reset()
[?2004l[?2004h>             
[?2004l[?2004h>             speed_error = self.set_speed - ego_speed
[?2004l[?2004h>             acceleration_cmd = self.speed_controller.compute(speed_error, dt)
[?2004l[?2004h>             distance_error = None
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Calculate Time-To-Collision (TTC)
[?2004l[?2004h>             relative_speed = ego_speed - lead_speed
[?2004l[?2004h>             if relative_speed > 0 and distance > 0:
[?2004l[?2004h>                 ttc = distance / relative_speed
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ttc = float('inf')
[?2004l[?2004h>             
[?2004l[?2004h>             # Emergency mode: TTC below threshold
[?2004l[?2004h>             if ttc < self.emergency_ttc_threshold:
[?2004l[?2004h>                 mode = 'emergency'
[?2004l[?2004h>                 acceleration_cmd = self.max_deceleration
[?2004l[?2004h>                 desired_distance = self.time_headway * ego_speed + self.min_distance
[?2004l[?2004h>                 distance_error = distance - desired_distance
[?2004l[?2004h>             else:
[?2004l[?2004h>                 # Follow mode: maintain safe following distance
[?2004l[?2004h>                 mode = 'follow'
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Reset speed controller when entering follow mode
[?2004l[?2004h>                 if self.previous_mode == 'cruise':
[?2004l[?2004h>                     self.speed_controller.reset()
[?2004l[?2004h>                 
[?2004l[?2004h>                 desired_distance = self.time_headway * ego_speed + self.min_distance
[?2004l[?2004h>                 distance_error = distance - desired_distance
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Combined control: distance control + speed matching
[?2004l[?2004h>                 dist_control = self.distance_controller.compute(distance_error, dt)
[?2004l[?2004h>                 speed_error = lead_speed - ego_speed
[?2004l[?2004h>                 speed_match = self.speed_controller.compute(speed_error, dt)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Blend based on distance error magnitude
[?2004l[?2004h>                 if abs(distance_error) > 5:
[?2004l[?2004h>                     acceleration_cmd = dist_control
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     acceleration_cmd = 0.7 * dist_control + 0.3 * speed_match
[?2004l[?2004h>         
[?2004l[?2004h>         # Store current mode for next iteration
[?2004l[?2004h>         self.previous_mode = mode
[?2004l[?2004h>         
[?2004l[?2004h>         # Clamp acceleration to vehicle limits
[?2004l[?2004h>         acceleration_cmd = max(self.max_deceleration, min(self.max_acceleration, acceleration_cmd))
[?2004l[?2004h>         
[?2004l[?2004h>         return acceleration_cmd, mode, distance_error
