[?2004l[?2004h> import csv
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_simulation():
[?2004l[?2004h>     """Analyze simulation results and compute performance metrics."""
[?2004l[?2004h>     
[?2004l[?2004h>     with open('simulation_results.csv', 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         data = list(reader)
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract data
[?2004l[?2004h>     times = [float(row['time']) for row in data]
[?2004l[?2004h>     speeds = [float(row['ego_speed']) for row in data]
[?2004l[?2004h>     modes = [row['mode'] for row in data]
[?2004l[?2004h>     distances = [float(row['distance']) if row['distance'] else None for row in data]
[?2004l[?2004h>     distance_errors = [float(row['distance_error']) if row['distance_error'] else None for row in data]
[?2004l[?2004h>     
[?2004l[?2004h>     # Speed control metrics (cruise phase)
[?2004l[?2004h>     set_speed = 30.0
[?2004l[?2004h>     target_90 = 0.9 * set_speed
[?2004l[?2004h>     
[?2004l[?2004h>     # Find rise time
[?2004l[?2004h>     rise_time = None
[?2004l[?2004h>     for i, speed in enumerate(speeds):
[?2004l[?2004h>         if speed >= target_90:
[?2004l[?2004h>             rise_time = times[i]
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Find overshoot in first 50 seconds
[?2004l[?2004h>     cruise_idx = min(500, len(speeds))
[?2004l[?2004h>     max_speed_cruise = max(speeds[:cruise_idx])
[?2004l[?2004h>     overshoot = max(0, max_speed_cruise - set_speed)
[?2004l[?2004h>     overshoot_pct = (overshoot / set_speed) * 100
[?2004l[?2004h>     
[?2004l[?2004h>     # Steady-state error (last 10 seconds of cruise phase before lead vehicle)
[?2004l[?2004h>     # Find when lead vehicle appears
[?2004l[?2004h>     lead_appears_idx = None
[?2004l[?2004h>     for i, d in enumerate(distances):
[?2004l[?2004h>         if d is not None:
[?2004l[?2004h>             lead_appears_idx = i
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     if lead_appears_idx and lead_appears_idx > 100:
[?2004l[?2004h>         ss_speeds = speeds[lead_appears_idx-100:lead_appears_idx]
[?2004l[?2004h>         speed_ss_error = abs(np.mean(ss_speeds) - set_speed)
[?2004l[?2004h>     else:
[?2004l[?2004h>         ss_speeds = speeds[-100:]
[?2004l[?2004h>         speed_ss_error = abs(np.mean(ss_speeds) - set_speed)
[?2004l[?2004h>     
[?2004l[?2004h>     # Distance control metrics (follow phase)
[?2004l[?2004h>     valid_dist_errors = [abs(e) for e in distance_errors if e is not None]
[?2004l[?2004h>     valid_distances = [d for d in distances if d is not None]
[?2004l[?2004h>     
[?2004l[?2004h>     if valid_dist_errors:
[?2004l[?2004h>         distance_ss_error = np.mean(valid_dist_errors[-100:])
[?2004l[?2004h>         min_distance = min(valid_distances)
[?2004l[?2004h>     else:
[?2004l[?2004h>         distance_ss_error = 0
[?2004l[?2004h>         min_distance = float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     # Count mode transitions
[?2004l[?2004h>     mode_counts = {'cruise': 0, 'follow': 0, 'emergency': 0}
[?2004l[?2004h>     for mode in modes:
[?2004l[?2004h>         mode_counts[mode] += 1
[?2004l[?2004h>     
[?2004l[?2004h>     metrics = {
[?2004l[?2004h>         'rise_time': rise_time,
[?2004l[?2004h>         'overshoot': overshoot,
[?2004l[?2004h>         'overshoot_pct': overshoot_pct,
[?2004l[?2004h>         'speed_ss_error': speed_ss_error,
[?2004l[?2004h>         'distance_ss_error': distance_ss_error,
[?2004l[?2004h>         'min_distance': min_distance,
[?2004l[?2004h>         'mode_counts': mode_counts,
[?2004l[?2004h>         'total_steps': len(data)
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     return metrics
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     metrics = analyze_simulation()
[?2004l[?2004h>     print("\n=== Simulation Performance Metrics ===")
[?2004l[?2004h>     print(f"Rise Time: {metrics['rise_time']:.2f} s (target: <10s)")
[?2004l[?2004h>     print(f"Overshoot: {metrics['overshoot']:.2f} m/s ({metrics['overshoot_pct']:.2f}%) (target: <5%)")
[?2004l[?2004h>     print(f"Speed Steady-State Error: {metrics['speed_ss_error']:.3f} m/s (target: <0.5 m/s)")
[?2004l[?2004h>     print(f"Distance Steady-State Error: {metrics['distance_ss_error']:.3f} m (target: <2m)")
[?2004l[?2004h>     print(f"Minimum Distance: {metrics['min_distance']:.2f} m (target: >5m)")
[?2004l[?2004h>     print(f"\nMode Distribution:")
[?2004l[?2004h>     for mode, count in metrics['mode_counts'].items():
[?2004l[?2004h>         pct = (count / metrics['total_steps']) * 100
[?2004l[?2004h>         print(f"  {mode}: {count} steps ({pct:.1f}%)")
[?2004l[?2004h> EOF
