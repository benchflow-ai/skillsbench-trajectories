[?2004l[?2004h>                     'distance': distance_params,
[?2004l[?2004h>                     'metrics': metrics
[?2004l[?2004h>                 }
[?2004l[?2004h>             
[?2004l[?2004h>             print(f"Testing: Speed kp={speed_params['kp']:.2f} ki={speed_params['ki']:.3f} kd={speed_params['kd']:.2f}, "
