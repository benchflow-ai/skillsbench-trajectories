[?2004l[?2004h>     
[?2004l[?2004h>     dt = config['simulation']['dt']
[?2004l[?2004h>     set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>     
[?2004l[?2004h>     ego_speed = 0.0
[?2004l[?2004h>     speeds = []
[?2004l[?2004h>     distances = []
[?2004l[?2004h>     min_distance = float('inf')
[?2004l[?2004h>     
