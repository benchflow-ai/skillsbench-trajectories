[?2004l[?2004h>         distance = sensor_row['distance']
[?2004l[?2004h>         
[?2004l[?2004h>         acceleration_cmd, mode, distance_error = acc.compute(
[?2004l[?2004h>             ego_speed, lead_speed, distance, dt
