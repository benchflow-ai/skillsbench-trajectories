cts;\r\nimport java.util.Set;\r\n\r\npublic class JavaScriptDimFilter extends AbstractOptimizableDimFilter implements DimFilter\r\n{\r\n  private final String dimension;\r\n  private final String function;\r\n  @Nullable\r\n"]
