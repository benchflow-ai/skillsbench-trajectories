[430.824349, "i", "cat <<EOF > /root/patches/fix_constructors_2.py\nimport re\n\n# Fix JavaScriptParseSpec.java\nfile_path = '/root/druid/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\n# Add constructor accepting config\n# We insert it before the getFunction method\nnew_constructor = \"\"\"\n  public JavaScriptParseSpec(\n      TimestampSpec timestampSpec,\n      DimensionsSpec dimensionsSpec,\n      String function,\n      JavaScriptConfig config\n  )\n  {\n    this(timestampSpec, dimensionsSpec, function);\n    this.config = config;\n  }\n\n\"\"\"\n\nif 'public JavaScriptParseSpec(' not in content or 'JavaScriptConfig config' not in content[content.find('public JavaScriptParseSpec'):]:\n    content = re.sub(\n        r'@JsonProperty\\(\"function\"\\)\\s*public String getFunction',\n        new_constructor + '@JsonProperty(\"function\")\\n  public String getFunction',\n        content\n    )\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptAggregatorFactory.java\nfile_path = '/root/druid/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\n# Add constructor accepting config\nnew_constructor = \"\"\"\n  public JavaScriptAggregatorFactory(\n      String name,\n      List<String> fieldNames,\n      String fnAggregate,\n      String fnReset,\n      String fnCombine,\n      JavaScriptConfig config\n  )\n  {\n    this(name, fieldNames, fnAggregate, fnReset, fnCombine);\n    this.config = config;\n  }\n\n\"\"\"\n\n# Insert before getCombiningFactory method or similar, or just after the main constructor\n# The main constructor ends with 'this.fnCombine = fnCombine;\\n    }'\n\ncontent = re.sub(\n    r'this.fnCombine = fnCombine;\\s*\\}',\n    'this.fnCombine = fnCombine;\\n    }\\n' + new_constructor,\n    content\n)\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\nEOF\npython3 /root/patches/fix_constructors_2.py\n"]
