[185.778815, "i", "cat <<EOF > /root/patches/patch_druid.py\nimport os\nimport re\n\nfiles = [\n    '/root/druid/core/src/main/java/org/apache/druid/data/input/impl/JavaScriptParseSpec.java',\n    '/root/druid/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java',\n    '/root/druid/processing/src/main/java/org/apache/druid/query/aggregation/JavaScriptAggregatorFactory.java',\n    '/root/druid/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java',\n    '/root/druid/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java',\n    '/root/druid/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java',\n    '/root/druid/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java'\n]\n\nfor file_path in files:\n    print(f\"Patching {file_path}...\")\n    with open(file_path, 'r') as f:\n        content = f.read()\n\n    # 1. Modify the field definition\n    # Replace 'private final JavaScriptConfig config;' with '@JacksonInject\\n  private JavaScriptConfig config;'\n    # Note: Indentation might vary, so we handle that.\n    content = re.sub(\n        r'private\\s+final\\s+JavaScriptConfig\\s+config;',\n        '@JacksonInject\\n  private JavaScriptConfig config;',\n        content\n    )\n\n    # 2. Modify the @JsonCreator constructor arguments\n    # We need to remove the argument that looks like '@JacksonInject JavaScriptConfig config' or just 'JavaScriptConfig config'\n    # and the preceding comma if it exists.\n    \n    # This regex looks for the argument in the constructor list and removes it.\n    # It handles optional comma before it.\n    content = re.sub(\n        r',\\s*@JacksonInject\\s+JavaScriptConfig\\s+config',\n        '',\n        content\n    )\n    # Also handle case where it's the first argument (unlikely but possible) or different spacing\n    content = re.sub(\n        r'@JacksonInject\\s+JavaScriptConfig\\s+config\\s*,?',\n        '',\n        content\n    )\n\n    # 3. Modify the constructor body\n    # Remove 'this.config = config;'\n    content = re.sub(\n        r'this\\.config\\s*=\\s*config;\\s*', \n        '', \n        content\n    )\n\n    with open(file_path, 'w') as f:\n        f.write(content)\n    print(\"Done.\")\nEOF\npython3 /root/patches/patch_druid.py\n"]
