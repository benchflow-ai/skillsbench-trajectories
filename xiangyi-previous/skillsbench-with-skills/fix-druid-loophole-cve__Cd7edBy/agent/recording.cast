[318.206495, "i", "cat <<EOF > /root/patches/fix_all.py\nimport re\n\n# Fix JavaScriptDimFilter.java\nfile_path = '/root/druid/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\n# Fix the secondary constructor\n# Original: this(dimension, function, extractionFn, null, config);\n# New: this(dimension, function, extractionFn, null); this.config = config;\ncontent = re.sub(\n    r'this\\(dimension, function, extractionFn, null, config\\);',\n    'this(dimension, function, extractionFn, null);\\n    this.config = config;',\n    content\n)\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptWorkerSelectStrategy.java\nfile_path = '/root/druid/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\n# Add field\nif '@JacksonInject\\n  private JavaScriptConfig config;' not in content:\n    content = re.sub(\n        r'private final String function;',\n        'private final String function;\\n  @JacksonInject\\n  private JavaScriptConfig config;',\n        content\n    )\n\n# Remove check from constructor\ncontent = re.sub(\n    r'Preconditions\\.checkState\\(config\\.isEnabled\\(\\), \"JavaScript is disabled\"\\);\\s*', \n    '', \n    content\n)\n\n# Add check to compileSelectorFunction\ncontent = re.sub(\n    r'private SelectorFunction compileSelectorFunction\\(\\)\\s*\\{',\n    'private SelectorFunction compileSelectorFunction() {\\n    Preconditions.checkState(config.isEnabled(), \"JavaScript is disabled\");',\n    content\n)\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptTieredBrokerSelectorStrategy.java\nfile_path = '/root/druid/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\n# Add field\nif '@JacksonInject\\n  private JavaScriptConfig config;' not in content:\n    content = re.sub(\n        r'private final String function;',\n        'private final String function;\\n  @JacksonInject\\n  private JavaScriptConfig config;',\n        content\n    )\n\n# Remove check from constructor\ncontent = re.sub(\n    r'Preconditions\\.checkState\\(config\\.isEnabled\\(\\), \"JavaScript is disabled\"\\);\\s*', \n    '', \n    content\n)\n\n# Add check to compileSelectorFunction\ncontent = re.sub(\n    r'private SelectorFunction compileSelectorFunction\\(\\)\\s*\\{',\n    'private SelectorFunction compileSelectorFunction() {\\n    Preconditions.checkState(config.isEnabled(), \"JavaScript is disabled\");',\n    content\n)\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\nEOF\npython3 /root/patches/fix_all.py\n"]
