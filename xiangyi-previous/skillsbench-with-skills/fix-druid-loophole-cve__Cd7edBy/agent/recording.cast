[550.77444, "o", "\u001b[?2004hroot@84120c4187fc:~/druid# "]
[596.911206, "i", "cat <<EOF > /root/patches/fix_constructors_3.py\nimport re\n\n# Fix JavaScriptExtractionFn.java\nfile_path = '/root/druid/processing/src/main/java/org/apache/druid/query/extraction/JavaScriptExtractionFn.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\nnew_constructor = \"\"\"\n  public JavaScriptExtractionFn(\n      String function,\n      boolean injective,\n      JavaScriptConfig config\n  )\n  {\n    this(function, injective);\n    this.config = config;\n  }\n\n\"\"\"\n\nif 'public JavaScriptExtractionFn(String function, boolean injective, JavaScriptConfig config)' not in content:\n    content = re.sub(\n        r'@JsonProperty\\s*public String getFunction',\n        new_constructor + '@JsonProperty\\n  public String getFunction',\n        content\n    )\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptPostAggregator.java\nfile_path = '/root/druid/processing/src/main/java/org/apache/druid/query/aggregation/post/JavaScriptPostAggregator.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\nnew_constructor = \"\"\"\n  public JavaScriptPostAggregator(\n      String name,\n      List<String> fieldNames,\n      String function,\n      JavaScriptConfig config\n  )\n  {\n    this(name, fieldNames, function);\n    this.config = config;\n  }\n\n\"\"\"\n\nif 'public JavaScriptPostAggregator(String name, List<String> fieldNames, String function, JavaScriptConfig config)' not in content:\n    content = re.sub(\n        r'@Override\\s*public Set<String> getDependentFields',\n        new_constructor + '@Override\\n  public Set<String> getDependentFields',\n        content\n    )\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptTieredBrokerSelectorStrategy.java\nfile_path = '/root/druid/server/src/main/java/org/apache/druid/server/router/JavaScriptTieredBrokerSelectorStrategy.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\nnew_constructor = \"\"\"\n  public JavaScriptTieredBrokerSelectorStrategy(\n      String fn,\n      JavaScriptConfig config\n  )\n  {\n    this(fn);\n    this.config = config;\n  }\n\n\"\"\"\n\nif 'public JavaScriptTieredBrokerSelectorStrategy(String fn, JavaScriptConfig config)' not in content:\n    content = re.sub(\n        r'private SelectorFunction compileSelectorFunction',\n        new_constructor + 'private SelectorFunction compileSelectorFunction',\n        content\n    )\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\n\n# Fix JavaScriptWorkerSelectStrategy.java\nfile_path = '/root/druid/indexing-service/src/main/java/org/apache/druid/indexing/overlord/setup/JavaScriptWorkerSelectStrategy.java'\nwith open(file_path, 'r') as f:\n    content = f.read()\n\nnew_constructor = \"\"\"\n  public JavaScriptWorkerSelectStrategy(\n      String fn,\n      JavaScriptConfig config\n  )\n  {\n    this(fn);\n    this.config = config;\n  }\n\n\"\"\"\n\nif 'public JavaScriptWorkerSelectStrategy(String fn, JavaScriptConfig config)' not in content:\n    content = re.sub(\n        r'private SelectorFunction compileSelectorFunction',\n        new_constructor + 'private SelectorFunction compileSelectorFunction',\n        content\n    )\n\nwith open(file_path, 'w') as f:\n    f.write(content)\nprint(f\"Fixed {file_path}\")\nEOF\npython3 /root/patches/fix_constructors_3.py\n"]
