[201.163278, "o", "{\r\n  \"source_language\": \"en\",\r\n  \"target_language\": \"ja\",\r\n  \"audio_sample_rate_hz\": 48000,\r\n  \"audio_channels\": 1,\r\n  \"original_duration_sec\": 12.052,\r\n  \"new_duration_sec\": 12.052,\r\n  \"measured_lufs\": -22.97,\r\n  \"speech_segments\": [\r\n    {\r\n      \"window_start_sec\": 0.0,\r\n      \"window_end_sec\": 12.116,\r\n      \"placed_start_sec\": 0.0,\r\n      \"placed_end_sec\": 12.052,\r\n      \"source_text\": \"the guys that appear in this anime are delinquents, please do not under any circumstances imitate anything. They do. Don't do it man, I'm serious. Bad idea.\",\r\n      \"target_text\": \"前略テレビの前の視聴者様。このアニメに出てくるやつらは不良です。だから決して。このアニメなので。\",\r\n      \"window_duration_sec\": 12.116,\r\n      \"tts_duration_sec\": 12.052,\r\n      \"drift_sec\": 0.064,\r\n      \"duration_control\": \"rate_adjust\"\r\n    }\r\n  ]\r\n}\r\n"]
[201.169558, "o", "\u001b[?2004hroot@30b5235d5523:~# "]
[215.532471, "i", "python3 - <<'PY'\nimport json,subprocess,re\n\ndef dur(path):\n    out=subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','default=noprint_wrappers=1:nokey=1',path])\n    return float(out)\n\n# extract text from srt\nimport re\n\ndef srt_text(path):\n    lines=open(path).read().split('\\n')\n    return ' '.join([l for l in lines if l and not re.match(r'\\d+$',l) and '-->' not in l])\n\nsource_text=srt_text('/root/source_text.srt')\ntarget_text=srt_text('/root/reference_target_text.srt')\n\n# loudnorm measurement\ncmd=['ffmpeg','-i','/outputs/tts_segments/seg_0.wav','-filter:a','loudnorm=I=-23:TP=-2:LRA=7:print_format=json','-f','null','-']\nproc=subprocess.run(cmd,stderr=subprocess.PIPE,stdout=subprocess.PIPE,text=True)\nm=re.search(r\"\\{\\s*\\\"input_i\\\".*\\}\\s*\", proc.stderr, re.S)\nmeasured=-23.0\nif m:\n    data=json.loads(m.group(0))\n    measured=float(data.get('output_i', data.get('input_i', -23.0)))\n\norig_dur=dur('/root/input.mp4')\nnew_dur=dur('/outputs/dubbed.mp4')\nseg_dur=dur('/outputs/tts_segments/seg_0.wav')\nwindow_start=0.0\nwindow_end=12.116\nplaced_start=0.0\nplaced_end=seg_dur\nreport={\n  'source_language':'en',\n  'target_language':'ja',\n  'audio_sample_rate_hz':48000,\n  'audio_channels':1,\n  'original_duration_sec':round(orig_dur,3),\n  'new_duration_sec':round(new_dur,3),\n  'measured_lufs':round(measured,2),\n  'speech_segments':[{\n      'window_start_sec':window_start,\n      'window_end_sec':window_end,\n      'placed_start_sec':placed_start,\n      'placed_end_sec':round(placed_end,3),\n      'source_text':source_text,\n      'target_text':target_text,\n      'window_duration_sec':round(window_end-window_start,3),\n      'tts_duration_sec':round(seg_dur,3),\n      'drift_sec':round(abs(placed_end-window_end),3),\n      'duration_control':'rate_adjust'\n  }]\n}\nopen('/outputs/report.json','w').write(json.dumps(report,ensure_ascii=False,indent=2))\nprint(json.dumps(report,ensure_ascii=False,indent=2))\nPY\n"]
