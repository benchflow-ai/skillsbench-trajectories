[232.844653, "o", "    return float(out)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # extract text from srt\r\n\u001b[?2004l\r"]
[232.844755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def srt_text(path):\r\n\u001b[?2004l\r\u001b[?2004h>     lines=open(path).read().split('\\n')\r\n\u001b[?2004l\r"]
[232.844832, "o", "\u001b[?2004h> "]
[232.844934, "o", "    txt=' '.join([l for l in lines if l and not re.match(r'\\d+$',l) and '-->' not in l])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.845083, "o", "    return txt.replace('\\n',' ').replace('\\r',' ').strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.845162, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> source_text=srt_text('/root/source_text.srt')\r\n\u001b[?2004l\r"]
[232.845202, "o", "\u001b[?2004h> "]
[232.84523, "o", "target_text=srt_text('/root/reference_target_text.srt')\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.845258, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.845363, "o", "# loudnorm measurement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.845533, "o", "cmd=['ffmpeg','-i','/outputs/tts_segments/seg_0.wav','-filter:a','loudnorm=I=-23:TP=-2:LRA=7:print_format=json','-f','null','-']\r\n\u001b[?2004l\r"]
[232.845563, "o", "\u001b[?2004h> "]
[232.8457, "o", "proc=subprocess.run(cmd,stderr=subprocess.PIPE,stdout=subprocess.PIPE,text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.845761, "o", "> "]
[232.84581, "o", "m=re.search(r\"\\{\\s*\\\"input_i\\\".*\\}\\s*\", proc.stderr, re.S)\r\n\u001b[?2004l\r"]
[232.84585, "o", "\u001b[?2004h> "]
[232.84589, "o", "measured=-23.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.845934, "o", "if m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.845982, "o", "    data=json.loads(m.group(0))\r\n\u001b[?2004l\r"]
[232.846019, "o", "\u001b[?2004h> "]
[232.846217, "o", "    measured=float(data.get('output_i', data.get('input_i', -23.0)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> orig_dur=dur('/root/input.mp4')\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.846272, "o", "> "]
[232.84632, "o", "new_dur=dur('/outputs/dubbed.mp4')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.846378, "o", "seg_dur=dur('/outputs/tts_segments/seg_0.wav')\r\n\u001b[?2004l\r"]
[232.846421, "o", "\u001b[?2004h> "]
[232.846465, "o", "window_start=0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.846507, "o", "window_end=12.116\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.846548, "o", "> placed_start=0.0\r\n\u001b[?2004l\r"]
[232.847275, "o", "\u001b[?2004h> placed_end=seg_dur"]
[232.84737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> report={\r\n\u001b[?2004l\r\u001b[?2004h>   'source_language':'en',\r\n\u001b[?2004l\r\u001b[?2004h>   'target_language':'ja',\r\n\u001b[?2004l\r\u001b[?2004h>   'audio_sample_rate_hz':48000,\r\n\u001b[?2004l\r\u001b[?2004h>   'audio_channels':1,\r\n\u001b[?2004l\r\u001b[?2004h>   'original_duration_sec':round(orig_dur,3),\r\n\u001b[?2004l\r\u001b[?2004h>   'new_duration_sec':round(new_dur,3),\r\n\u001b[?2004l\r\u001b[?2004h>   'measured_lufs':round(measured,2),\r\n\u001b[?2004l\r\u001b[?2004h>   'speech_segments':[{\r\n\u001b[?2004l\r\u001b[?2004h>       'window_start_sec':window_start,\r\n\u001b[?2004l\r\u001b[?2004h>       'window_end_sec':window_end,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.847428, "o", "      'placed_start_sec':placed_start,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.847482, "o", "      'placed_end_sec':round(placed_end,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.847535, "o", "      'source_text':source_text,\r\n\u001b[?2004l\r"]
[232.847585, "o", "\u001b[?2004h> "]
[232.847631, "o", "      'target_text':target_text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.84774, "o", "      'window_duration_sec':round(window_end-window_start,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.847824, "o", "      'tts_duration_sec':round(seg_dur,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.847927, "o", "      'drift_sec':round(abs(placed_end-window_end),3),\r\n\u001b[?2004l\r\u001b[?2004h"]
[232.84798, "o", "> "]
[232.848031, "o", "      'duration_control':'rate_adjust'\r\n\u001b[?2004l\r\u001b[?2004h>   }]\r\n"]
[232.848079, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.848228, "o", "open('/outputs/report.json','w').write(json.dumps(report,ensure_ascii=False,indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[232.848396, "o", "print(json.dumps(report,ensure_ascii=False,indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[233.438648, "o", "{\r\n  \"source_language\": \"en\",\r\n  \"target_language\": \"ja\",\r\n  \"audio_sample_rate_hz\": 48000,\r\n  \"audio_channels\": 1,\r\n  \"original_duration_sec\": 12.052,\r\n  \"new_duration_sec\": 12.052,\r\n  \"measured_lufs\": -22.97,\r\n  \"speech_segments\": [\r\n    {\r\n      \"window_start_sec\": 0.0,\r\n      \"window_end_sec\": 12.116,\r\n      \"placed_start_sec\": 0.0,\r\n      \"placed_end_sec\": 12.052,\r\n      \"source_text\": \"the guys that appear in this anime are delinquents, please do not under any circumstances imitate anything. They do. Don't do it man, I'm serious. Bad idea.\",\r\n      \"target_text\": \"前略テレビの前の視聴者様。このアニメに出てくるやつらは不良です。だから決して。このアニメなので。\",\r\n      \"window_duration_sec\": 12.116,\r\n      \"tts_duration_sec\": 12.052,\r\n      \"drift_sec\": 0.064,\r\n      \"duration_control\": \"rate_adjust\"\r\n    }\r\n  ]\r\n}\r\n"]
[233.44524, "o", "\u001b[?2004hroot@30b5235d5523:~# "]
