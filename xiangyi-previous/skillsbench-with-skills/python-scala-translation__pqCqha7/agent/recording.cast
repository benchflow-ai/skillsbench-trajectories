[58.805392, "o", "\u001b[?2004h> class BivariantHandler[T](default: T) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.80544, "o", "  private var _value: T = default\r\n\u001b[?2004l\r"]
