[236.162014, "o", "      case bd: BigDecimal => numericTokenizer.tokenize(bd)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.162195, "o", "      case dt: LocalDateTime => temporalTokenizer.tokenize(Left(dt))\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[236.162307, "o", "      case d: LocalDate => temporalTokenizer.tokenize(Right(d))\r\n\u001b[?2004l\roc\u001b[?2004h> "]
[236.162463, "o", "      case other => Token(other.toString, TokenType.STRING, Map(\"fallback\" -> true))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.162491, "o", "    }\r\n\u001b[?2004l\rne\r\n\u001b[?2004h> "]
[236.162549, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r "]
[236.16258, "o", "\u001b[?2004h> "]
[236.162712, "o", "// ============================================================================\r\n\u001b[?2004l\red\u001b[?2004h"]
[236.162772, "o", "> "]
[236.162824, "o", "// Complex Nested Generics (TokenRegistry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.162988, "o", "// ============================================================================\r\n\u001b[?2004l\r"]
[236.163015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rz\u001b[?2004h> "]
[236.163091, "o", "class TokenRegistry[T] {\r\n\u001b[?2004l\rok\u001b[?2004h> "]
[236.163207, "o", "  private val _registry = mutable.Map[String, TokenContainer[T]]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.163234, "o", "> "]
[236.163358, "o", "  private val _handlers = mutable.ListBuffer[T => Option[Token]]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.163388, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.163576, "o", "  def register(key: String, container: TokenContainer[T]): Unit = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.163658, "o", "    _registry(key) = container\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.163709, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[236.163766, "o", "\u001b[?2004h> "]
[236.163838, "o", "  def addHandler(handler: T => Option[Token]): Unit = {\r\n\u001b[?2004l\r"]
[236.163868, "o", "\u001b[?2004h> "]
[236.163922, "o", "    _handlers += handler\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\re =>"]
[236.163982, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.164054, "o", "  def process(key: String): List[Option[Token]] = {\r\n\u001b[?2004l\rf\u001b[?2004h> "]
[236.164123, "o", "    _registry.get(key) match {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.164208, "o", "      case None => List.empty\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.164236, "o", "> "]
[236.164302, "o", "      case Some(container) =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.164428, "o", "        val results = mutable.ListBuffer[Option[Token]]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.164455, "o", "> "]
[236.164553, "o", "        for (item <- container.getAll) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.164581, "o", "> "]
[236.164674, "o", "          var processed: Option[Token] = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.164796, "o", "          val handlersIter = _handlers.iterator\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.164822, "o", "> "]
[236.164986, "o", "          while (handlersIter.hasNext && processed.isEmpty) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.165013, "o", "> "]
[236.16512, "o", "            val handler = handlersIter.next()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.16515, "o", "> "]
[236.165245, "o", "            val result = handler(item)\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.165271, "o", "> "]
[236.165355, "o", "            if (result.isDefined) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.165383, "o", "> "]
[236.16545, "o", "              processed = result\r\n\u001b[?2004l\r]\u001b[?2004h> "]
[236.165501, "o", "            }\r\n\u001b[?2004l\r"]
[236.165532, "o", "\u001b[?2004h> "]
[236.165561, "o", "          }\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.165588, "o", "> "]
[236.165682, "o", "          results += processed\r\n\u001b[?2004l\rwi\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.165743, "o", "> "]
[236.165776, "o", "        results.toList\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.165805, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.16586, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.165891, "o", "\u001b[?2004h> "]
[236.166069, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166101, "o", "> "]
[236.166151, "o", "// Higher-Kinded Type Simulation\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166182, "o", "> "]
[236.166359, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166387, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[236.166486, "o", "class TokenFunctor[T](val value: T) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166515, "o", "> "]
[236.166607, "o", "  def map[U](func: T => U): TokenFunctor[U] = {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[236.166704, "o", "    new TokenFunctor(func(value))\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166732, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.166762, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h"]
[236.166796, "o", "> "]
[236.166907, "o", "  def flatMap[U](func: T => TokenFunctor[U]): TokenFunctor[U] = {\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[236.166952, "o", "    func(value)\r\n\u001b[?2004l\rva\u001b[?2004h> "]
[236.167006, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.167078, "o", "  def getOrElse(default: T): T = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.167107, "o", "> "]
[236.167191, "o", "    if (value != null) value else default\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.167222, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.16725, "o", "}\r\n\u001b[?2004l\rva\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.167305, "o", "\u001b[?2004h> "]
[236.167472, "o", "class TokenMonad[T](override val value: T) extends TokenFunctor[T](value) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.1675, "o", "> "]
[236.167615, "o", "  def ap[U](funcWrapped: TokenMonad[T => U]): TokenMonad[U] = {\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[236.167643, "o", "> "]
[236.167745, "o", "    new TokenMonad(funcWrapped.value(value))\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.167773, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.16783, "o", "> }\r\n\u001b[?2004l\rrm\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.16786, "o", "object TokenMonad {\r\n\u001b[?2004l\r"]
[236.167911, "o", "\u001b[?2004h> "]
[236.168013, "o", "  def pure[T](value: T): TokenMonad[T] = new TokenMonad(value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.168042, "o", "> }\r\n\u001b[?2004l\r)\r\n\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.168077, "o", "\u001b[?2004h> "]
[236.168265, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.168292, "o", "> "]
[236.168353, "o", "// JSON Structure Tokenization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.168459, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.16849, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.168551, "o", "sealed trait JsonValue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.168618, "o", "case class JsonString(v: String) extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.168648, "o", "> "]
[236.168717, "o", "case class JsonNumber(v: Double) extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.1688, "o", "case class JsonBool(v: Boolean) extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.168828, "o", "> "]
[236.16889, "o", "case object JsonNull extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.168981, "o", "case class JsonArray(v: List[JsonValue]) extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.16901, "o", "> "]
[236.169093, "o", "case class JsonObject(v: Map[String, JsonValue]) extends JsonValue\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.169125, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[236.169152, "o", "> "]
[236.169245, "o", "class JsonTokenizer(pretty: Boolean = false) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169299, "o", "  def tokenize(value: JsonValue): Token = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169354, "o", "    val jsonStr = value.toString \r\n\u001b[?2004l\r\u001b[?2004h"]
[236.169385, "o", "> "]
[236.169459, "o", "    Token(jsonStr, TokenType.STRUCTURED, Map(\"json\" -> true))\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.169489, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169545, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169635, "o", "  def tokenizePath(value: JsonValue, path: String): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169691, "o", "    val parts = path.split(\"\\\\.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.169721, "o", "> "]
[236.169784, "o", "    var current: JsonValue = value\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[236.169815, "o", "\u001b[?2004h>     try {\r\n\u001b[?2004l\r"]
[236.169867, "o", "\u001b[?2004h> "]
[236.169929, "o", "      for (part <- parts) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.169961, "o", "        current match {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170019, "o", "          case JsonObject(fields) => \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170118, "o", "            current = fields.getOrElse(part, return None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170204, "o", "          case JsonArray(items) if part.forall(_.isDigit) =>\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.170257, "o", "> "]
[236.17029, "o", "            val idx = part.toInt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.17039, "o", "            if (idx >= 0 && idx < items.length) current = items(idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.170419, "o", "> "]
[236.170476, "o", "            else return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170535, "o", "          case _ => return None\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[236.170563, "o", "\u001b[?2004h>       }"]
[236.170627, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170659, "o", "      Some(tokenize(current))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170735, "o", "    } catch {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.170764, "o", "      case _: Exception => None\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[236.170815, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.170853, "o", "\u001b[?2004h> "]
[236.170989, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171023, "o", "// Whitespace Tokenizer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171149, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.171178, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171233, "o", "class WhitespaceTokenizer(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171305, "o", "    lowercase: Boolean = false,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171359, "o", "    minLength: Int = 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171422, "o", "    maxLength: Option[Int] = None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.17146, "o", "> "]
[236.171489, "o", "    stripPunctuation: Boolean = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.171517, "o", "> ) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171624, "o", "  private val punctuation = \".,!?;:'\\\"()[]{}\".toSet\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.171654, "o", "\u001b[?2004h> "]
[236.171745, "o", "  private def processToken(word: String): Option[String] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.171799, "o", "    var processed = word\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.171831, "o", "> "]
[236.171863, "o", "    if (stripPunctuation) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172085, "o", "      processed = processed.dropWhile(punctuation.contains).reverse.dropWhile(punctuation.contains).reverse\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172129, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     if (lowercase) {\r\n\u001b[?2004l\r"]
[236.172161, "o", "\u001b[?2004h> "]
[236.172221, "o", "      processed = processed.toLowerCase\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172312, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[236.172347, "o", "\u001b[?2004h>     if (processed.length < minLength) return None\r\n\u001b[?2004l\r"]
[236.172375, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[236.172406, "o", "> "]
[236.172555, "o", "    if (maxLength.isDefined && processed.length > maxLength.get) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172607, "o", "      processed = processed.substring(0, maxLength.get)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[236.172636, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[236.172698, "o", "\u001b[?2004h> "]
[236.172758, "o", "    if (processed.nonEmpty) Some(processed) else None\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[236.172788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172872, "o", "  def tokenize(text: String): List[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.172939, "o", "    val words = text.trim.split(\"\\\\s+\")\r\n\u001b[?2004l\r"]
[236.172989, "o", "\u001b[?2004h> "]
[236.173042, "o", "    val tokens = mutable.ListBuffer[Token]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173071, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173137, "o", "    for ((word, i) <- words.zipWithIndex) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173192, "o", "      processToken(word) match {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173254, "o", "        case Some(processed) =>\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.173283, "o", "> "]
[236.173421, "o", "          tokens += Token(processed, TokenType.STRING, Map(\"position\" -> i, \"original\" -> word))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173482, "o", "        case None => // skip\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173511, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173543, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173601, "o", "    tokens.toList\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173628, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173723, "o", "  def tokenizeToStrings(text: String): List[String] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.173785, "o", "    tokenize(text).map(_.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.173815, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[236.173845, "o", "\u001b[?2004h> "]
[236.173924, "o", "  def countTokens(text: String): Int = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.174, "o", "    tokenize(text).length\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.17403, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.174155, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.174181, "o", "// Builder Pattern\r\n\u001b[?2004l\r"]
[236.174237, "o", "\u001b[?2004h> "]
[236.174323, "o", "// ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.174354, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.174417, "o", "class TokenizerBuilder[T] {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.17451, "o", "  private val _normalizers = mutable.ListBuffer[String => String]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.174539, "o", "> "]
[236.174615, "o", "  private val _validators = mutable.ListBuffer[T => Boolean]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.17465, "o", "> "]
[236.174701, "o", "  private var _metadata = Map[String, Any]()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[236.17473, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[236.174876, "o", "  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.174929, "o", "    _normalizers += normalizer\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.174959, "o", ">     this\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.175016, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.17514, "o", "  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.175211, "o", "    _validators += validator\r\n\u001b[?2004l\r"]
[236.175269, "o", "\u001b[?2004h>     this\r\n\u001b[?2004l\r"]
[236.175298, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.17535, "o", "\u001b[?2004h> "]
[236.175517, "o", "  def withMetadata(meta: (String, Any)*): TokenizerBuilder[T] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.175578, "o", "    _metadata ++= meta\r\n\u001b[?2004l\r"]
[236.175607, "o", "\u001b[?2004h> "]
[236.175659, "o", "    this\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[236.175694, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[236.175783, "o", "  def build(): T => Token = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.175891, "o", "    val normalizers = _normalizers.toList\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.175937, "o", "> "]
[236.175995, "o", "    val validators = _validators.toList\r\n\u001b[?2004l\r"]
[236.176026, "o", "\u001b[?2004h> "]
[236.176084, "o", "    val metadata = _metadata\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[236.176149, "o", "> "]
[236.17618, "o", "    (value: T) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176239, "o", "      // Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176329, "o", "      for (validator <- validators) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.17639, "o", "        if (!validator(value)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176506, "o", "          throw new IllegalArgumentException(s\"Validation failed for $value\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176588, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[236.176618, "o", "\u001b[?2004h> "]
[236.17669, "o", "      var strValue = value.toString\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176779, "o", "      // Normalize\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176811, "o", "      for (normalizer <- normalizers) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.176877, "o", "        strValue = normalizer(strValue)\r\n\u001b[?2004l\r\u001b[?2004h"]
[236.176908, "o", ">       }\r\n\u001b[?2004l\r"]
[236.176936, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.177022, "o", "      Token(strValue, TokenType.STRING, metadata)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.177049, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[236.177128, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[236.177158, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[236.178476, "o", "\u001b[?2004hroot@33c708d00568:~# "]
