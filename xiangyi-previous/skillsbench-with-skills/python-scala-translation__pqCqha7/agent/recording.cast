[236.15938, "i", "cat <<'EOF' >> /root/Tokenizer.scala\n\n// ============================================================================\n// Advanced: Union Types and Overloads (Universal Tokenizer)\n// ============================================================================\n\nclass UniversalTokenizer {\n  private val stringTokenizer = new StringTokenizer()\n  private val numericTokenizer = new NumericTokenizer()\n  private val temporalTokenizer = new TemporalTokenizer()\n\n  def tokenize(value: Any): Token = {\n    value match {\n      case null => Token(\"NULL\", TokenType.NULL)\n      case t: Tokenizable => Token(t.toToken, TokenType.STRUCTURED)\n      case s: String => stringTokenizer.tokenize(Left(s))\n      case b: Array[Byte] => stringTokenizer.tokenize(Right(b))\n      case i: Int => numericTokenizer.tokenize(i)\n      case f: Float => numericTokenizer.tokenize(f)\n      case d: Double => numericTokenizer.tokenize(d)\n      case bd: BigDecimal => numericTokenizer.tokenize(bd)\n      case dt: LocalDateTime => temporalTokenizer.tokenize(Left(dt))\n      case d: LocalDate => temporalTokenizer.tokenize(Right(d))\n      case other => Token(other.toString, TokenType.STRING, Map(\"fallback\" -> true))\n    }\n  }\n}\n\n// ============================================================================\n// Complex Nested Generics (TokenRegistry)\n// ============================================================================\n\nclass TokenRegistry[T] {\n  private val _registry = mutable.Map[String, TokenContainer[T]]()\n  private val _handlers = mutable.ListBuffer[T => Option[Token]]()\n\n  def register(key: String, container: TokenContainer[T]): Unit = {\n    _registry(key) = container\n  }\n\n  def addHandler(handler: T => Option[Token]): Unit = {\n    _handlers += handler\n  }\n\n  def process(key: String): List[Option[Token]] = {\n    _registry.get(key) match {\n      case None => List.empty\n      case Some(container) =>\n        val results = mutable.ListBuffer[Option[Token]]()\n        for (item <- container.getAll) {\n          var processed: Option[Token] = None\n          val handlersIter = _handlers.iterator\n          while (handlersIter.hasNext && processed.isEmpty) {\n            val handler = handlersIter.next()\n            val result = handler(item)\n            if (result.isDefined) {\n              processed = result\n            }\n          }\n          results += processed\n        }\n        results.toList\n    }\n  }\n}\n\n// ============================================================================\n// Higher-Kinded Type Simulation\n// ============================================================================\n\nclass TokenFunctor[T](val value: T) {\n  def map[U](func: T => U): TokenFunctor[U] = {\n    new TokenFunctor(func(value))\n  }\n\n  def flatMap[U](func: T => TokenFunctor[U]): TokenFunctor[U] = {\n    func(value)\n  }\n\n  def getOrElse(default: T): T = {\n    if (value != null) value else default\n  }\n}\n\nclass TokenMonad[T](override val value: T) extends TokenFunctor[T](value) {\n  def ap[U](funcWrapped: TokenMonad[T => U]): TokenMonad[U] = {\n    new TokenMonad(funcWrapped.value(value))\n  }\n}\n\nobject TokenMonad {\n  def pure[T](value: T): TokenMonad[T] = new TokenMonad(value)\n}\n\n// ============================================================================\n// JSON Structure Tokenization\n// ============================================================================\n\nsealed trait JsonValue\ncase class JsonString(v: String) extends JsonValue\ncase class JsonNumber(v: Double) extends JsonValue\ncase class JsonBool(v: Boolean) extends JsonValue\ncase object JsonNull extends JsonValue\ncase class JsonArray(v: List[JsonValue]) extends JsonValue\ncase class JsonObject(v: Map[String, JsonValue]) extends JsonValue\n\nclass JsonTokenizer(pretty: Boolean = false) {\n  def tokenize(value: JsonValue): Token = {\n    val jsonStr = value.toString \n    Token(jsonStr, TokenType.STRUCTURED, Map(\"json\" -> true))\n  }\n\n  def tokenizePath(value: JsonValue, path: String): Option[Token] = {\n    val parts = path.split(\"\\\\.\")\n    var current: JsonValue = value\n    \n    try {\n      for (part <- parts) {\n        current"]
[236.15958, "i", " match {\n          case JsonObject(fields) => \n            current = fields.getOrElse(part, return None)\n          case JsonArray(items) if part.forall(_.isDigit) =>\n            val idx = part.toInt\n            if (idx >= 0 && idx < items.length) current = items(idx)\n            else return None\n          case _ => return None\n        }\n      }\n      Some(tokenize(current))\n    } catch {\n      case _: Exception => None\n    }\n  }\n}\n\n// ============================================================================\n// Whitespace Tokenizer\n// ============================================================================\n\nclass WhitespaceTokenizer(\n    lowercase: Boolean = false,\n    minLength: Int = 0,\n    maxLength: Option[Int] = None,\n    stripPunctuation: Boolean = false\n) {\n  private val punctuation = \".,!?;:'\\\"()[]{}\".toSet\n\n  private def processToken(word: String): Option[String] = {\n    var processed = word\n    if (stripPunctuation) {\n      processed = processed.dropWhile(punctuation.contains).reverse.dropWhile(punctuation.contains).reverse\n    }\n    \n    if (lowercase) {\n      processed = processed.toLowerCase\n    }\n    \n    if (processed.length < minLength) return None\n    \n    if (maxLength.isDefined && processed.length > maxLength.get) {\n      processed = processed.substring(0, maxLength.get)\n    }\n    \n    if (processed.nonEmpty) Some(processed) else None\n  }\n\n  def tokenize(text: String): List[Token] = {\n    val words = text.trim.split(\"\\\\s+\")\n    val tokens = mutable.ListBuffer[Token]()\n    \n    for ((word, i) <- words.zipWithIndex) {\n      processToken(word) match {\n        case Some(processed) =>\n          tokens += Token(processed, TokenType.STRING, Map(\"position\" -> i, \"original\" -> word))\n        case None => // skip\n      }\n    }\n    tokens.toList\n  }\n  \n  def tokenizeToStrings(text: String): List[String] = {\n    tokenize(text).map(_.value)\n  }\n  \n  def countTokens(text: String): Int = {\n    tokenize(text).length\n  }\n}\n\n// ============================================================================\n// Builder Pattern\n// ============================================================================\n\nclass TokenizerBuilder[T] {\n  private val _normalizers = mutable.ListBuffer[String => String]()\n  private val _validators = mutable.ListBuffer[T => Boolean]()\n  private var _metadata = Map[String, Any]()\n\n  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\n    _normalizers += normalizer\n    this\n  }\n\n  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {\n    _validators += validator\n    this\n  }\n\n  def withMetadata(meta: (String, Any)*): TokenizerBuilder[T] = {\n    _metadata ++= meta\n    this\n  }\n\n  def build(): T => Token = {\n    val normalizers = _normalizers.toList\n    val validators = _validators.toList\n    val metadata = _metadata\n\n    (value: T) => {\n      // Validate\n      for (validator <- validators) {\n        if (!validator(value)) {\n          throw new IllegalArgumentException(s\"Validation failed for $value\")\n        }\n      }\n\n      var strValue = value.toString\n\n      // Normalize\n      for (normalizer <- normalizers) {\n        strValue = normalizer(strValue)\n      }\n\n      Token(strValue, TokenType.STRING, metadata)\n    }\n  }\n}\nEOF\n"]
