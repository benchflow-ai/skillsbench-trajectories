[?2004l[?2004h>   case object STRING extends TokenType { override def toString = "string" }
[?2004l[?2004h>   case object NUMERIC extends TokenType { override def toString = "numeric" }
[?2004l[?2004h>   case object TEMPORAL extends TokenType { override def toString = "temporal" }
[?2004l[?2004h>   case object STRUCTURED extends TokenType { override def toString = "structured" }
[?2004l[?2004h>   case object BINARY extends TokenType { override def toString = "binary" }
[?2004l[?2004h>   case object NULL extends TokenType { override def toString = "null" }
[?2004l[?2004h> }
