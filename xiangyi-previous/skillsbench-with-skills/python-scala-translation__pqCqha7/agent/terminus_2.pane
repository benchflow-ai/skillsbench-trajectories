[?2004l[?2004h> class TokenSink[-T] {
[?2004l[?2004h>   private val _received: mutable.ListBuffer[Any] = mutable.ListBuffer()
[?2004l[?2004h> 
[?2004l[?2004h>   def receive(item: T): Unit = {
[?2004l[?2004h>     _received += item
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def drain(): List[Any] = {
[?2004l[?2004h>     val result = _received.toList
[?2004l[?2004h>     _received.clear()
[?2004l[?2004h>     result
[?2004l[?2004h>   }
[?2004l[?2004h> }
