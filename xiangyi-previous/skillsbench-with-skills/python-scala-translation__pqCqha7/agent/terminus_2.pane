[?2004l[?2004h> 
[?2004l[?2004h>   def markProcessed(): Unit = {
[?2004l[?2004h>     _processed = true
[?2004l[?2004h>   }
[?2004l[?2004h>   
[?2004l[?2004h>   def getTokens: List[Token] = tokens.toList
[?2004l[?2004h> }
