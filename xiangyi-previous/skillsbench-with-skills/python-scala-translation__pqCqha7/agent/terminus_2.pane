[?2004l[?2004h>     metadata: Map[String, Any] = Map.empty
[?2004l[?2004h> ) {
[?2004l[?2004h>   def withMetadata(newMeta: (String, Any)*): Token = {
[?2004l[?2004h>     copy(metadata = metadata ++ newMeta)
