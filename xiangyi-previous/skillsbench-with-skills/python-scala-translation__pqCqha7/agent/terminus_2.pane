[?2004l[?2004h> }
[?2004l)
[?2004h> 
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> // JSON Structure Tokenization
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> sealed trait JsonValue
[?2004l[?2004h> case class JsonString(v: String) extends JsonValue
[?2004l[?2004h> case class JsonNumber(v: Double) extends JsonValue
[?2004l[?2004h> case class JsonBool(v: Boolean) extends JsonValue
[?2004l[?2004h> case object JsonNull extends JsonValue
[?2004l[?2004h> case class JsonArray(v: List[JsonValue]) extends JsonValue
[?2004l[?2004h> case class JsonObject(v: Map[String, JsonValue]) extends JsonValue
[?2004l[?2004h> 
[?2004l[?2004h> class JsonTokenizer(pretty: Boolean = false) {
[?2004l[?2004h>   def tokenize(value: JsonValue): Token = {
[?2004l[?2004h>     val jsonStr = value.toString 
[?2004l[?2004h>     Token(jsonStr, TokenType.STRUCTURED, Map("json" -> true))
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizePath(value: JsonValue, path: String): Option[Token] = {
[?2004l[?2004h>     val parts = path.split("\\.")
[?2004l[?2004h>     var current: JsonValue = value
[?2004l[?2004h>     
[?2004l[?2004h>     try {
[?2004l[?2004h>       for (part <- parts) {
[?2004l[?2004h>         current match {
[?2004l[?2004h>           case JsonObject(fields) => 
[?2004l[?2004h>             current = fields.getOrElse(part, return None)
[?2004l[?2004h>           case JsonArray(items) if part.forall(_.isDigit) =>
[?2004l[?2004h>             val idx = part.toInt
[?2004l[?2004h>             if (idx >= 0 && idx < items.length) current = items(idx)
[?2004l[?2004h>             else return None
[?2004l[?2004h>           case _ => return None
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h>       Some(tokenize(current))
[?2004l[?2004h>     } catch {
[?2004l[?2004h>       case _: Exception => None
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> // Whitespace Tokenizer
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> class WhitespaceTokenizer(
[?2004l[?2004h>     lowercase: Boolean = false,
[?2004l[?2004h>     minLength: Int = 0,
[?2004l[?2004h>     maxLength: Option[Int] = None,
[?2004l[?2004h>     stripPunctuation: Boolean = false
[?2004l[?2004h> ) {
[?2004l[?2004h>   private val punctuation = ".,!?;:'\"()[]{}".toSet
[?2004l[?2004h> 
[?2004l[?2004h>   private def processToken(word: String): Option[String] = {
[?2004l[?2004h>     var processed = word
[?2004l[?2004h>     if (stripPunctuation) {
[?2004l[?2004h>       processed = processed.dropWhile(punctuation.contains).reverse.dropWhile(punctuation.contains).reverse
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     if (lowercase) {
[?2004l[?2004h>       processed = processed.toLowerCase
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     if (processed.length < minLength) return None
[?2004l[?2004h>     
[?2004l[?2004h>     if (maxLength.isDefined && processed.length > maxLength.get) {
[?2004l[?2004h>       processed = processed.substring(0, maxLength.get)
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     if (processed.nonEmpty) Some(processed) else None
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(text: String): List[Token] = {
[?2004l[?2004h>     val words = text.trim.split("\\s+")
[?2004l[?2004h>     val tokens = mutable.ListBuffer[Token]()
[?2004l[?2004h>     
[?2004l[?2004h>     for ((word, i) <- words.zipWithIndex) {
[?2004l[?2004h>       processToken(word) match {
[?2004l[?2004h>         case Some(processed) =>
[?2004l[?2004h>           tokens += Token(processed, TokenType.STRING, Map("position" -> i, "original" -> word))
[?2004l[?2004h>         case None => // skip
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>     tokens.toList
[?2004l[?2004h>   }
[?2004l[?2004h>   
[?2004l[?2004h>   def tokenizeToStrings(text: String): List[String] = {
[?2004l[?2004h>     tokenize(text).map(_.value)
[?2004l[?2004h>   }
[?2004l[?2004h>   
[?2004l[?2004h>   def countTokens(text: String): Int = {
[?2004l[?2004h>     tokenize(text).length
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> // Builder Pattern
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> class TokenizerBuilder[T] {
[?2004l[?2004h>   private val _normalizers = mutable.ListBuffer[String => String]()
[?2004l[?2004h>   private val _validators = mutable.ListBuffer[T => Boolean]()
[?2004l[?2004h>   private var _metadata = Map[String, Any]()
[?2004l[?2004h> 
[?2004l[?2004h>   def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {
[?2004l[?2004h>     _normalizers += normalizer
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {
[?2004l[?2004h>     _validators += validator
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withMetadata(meta: (String, Any)*): TokenizerBuilder[T] = {
[?2004l[?2004h>     _metadata ++= meta
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def build(): T => Token = {
[?2004l[?2004h>     val normalizers = _normalizers.toList
[?2004l[?2004h>     val validators = _validators.toList
[?2004l[?2004h>     val metadata = _metadata
[?2004l[?2004h> 
[?2004l[?2004h>     (value: T) => {
[?2004l[?2004h>       // Validate
[?2004l[?2004h>       for (validator <- validators) {
[?2004l[?2004h>         if (!validator(value)) {
[?2004l[?2004h>           throw new IllegalArgumentException(s"Validation failed for $value")
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       var strValue = value.toString
[?2004l[?2004h> 
[?2004l[?2004h>       // Normalize
[?2004l[?2004h>       for (normalizer <- normalizers) {
[?2004l[?2004h>         strValue = normalizer(strValue)
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       Token(strValue, TokenType.STRING, metadata)
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
