[?2004l[?2004h> class MutableTokenBatch {
[?2004l[?2004h>   private val tokens: mutable.ListBuffer[Token] = mutable.ListBuffer()
[?2004l[?2004h>   private var _processed: Boolean = false
[?2004l[?2004h> 
[?2004l[?2004h>   def add(token: Token): Unit = {
[?2004l[?2004h>     if (_processed) throw new RuntimeException("Batch already processed")
[?2004l[?2004h>     tokens += token
