[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> // Tokenizer Implementations
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> abstract class BaseTokenizer[T] {
[?2004l[?2004h>   def tokenize(value: T): Token
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizeBatch(values: Iterable[T]): Iterator[Token] = {
[?2004l[?2004h>     values.iterator.map(tokenize)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> class StringTokenizer(encoding: String = "utf-8", normalizer: Option[String => String] = None) 
[?2004l[?2004h>   extends BaseTokenizer[Either[String, Array[Byte]]] {
[?2004l[?2004h>   
[?2004l[?2004h>   private val norm: String => String = normalizer.getOrElse(identity)
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Either[String, Array[Byte]]): Token = {
[?2004l[?2004h>     val strValue = value match {
[?2004l[?2004h>       case Right(bytes) => new String(bytes, encoding)
[?2004l[?2004h>       case Left(str) => str
[?2004l[?2004h>     }
[?2004l[?2004h>     val normalized = norm(strValue)
[?2004l[?2004h>     Token(normalized, TokenType.STRING)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> class NumericTokenizer(precision: Int = 6, formatOptions: Map[String, Any] = Map.empty)
[?2004l[?2004h>   extends BaseTokenizer[Any] {
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Any): Token = {
[?2004l[?2004h>     val strValue = value match {
[?2004l[?2004h>       case d: BigDecimal => 
[?2004l[?2004h>         val fmt = s"%.$precision" + "f"
[?2004l[?2004h>         d.bigDecimal.toString // Simplified for Scala, formatting BigDecimal exactly like Python requires more work or Java formatters
[?2004l[?2004h>         String.format(fmt, d.bigDecimal)
[?2004l[?2004h>       case f: Float => 
[?2004l[?2004h>         val fmt = s"%.$precision" + "f"
[?2004l[?2004h>         String.format(fmt, Float.box(f))
[?2004l[?2004h>       case d: Double => 
[?2004l[?2004h>         val fmt = s"%.$precision" + "f"
[?2004l[?2004h>         String.format(fmt, Double.box(d))
[?2004l[?2004h>       case n: Number => n.toString
[?2004l[?2004h>       case other => other.toString
[?2004l[?2004h>     }
[?2004l[?2004h>     Token(strValue, TokenType.NUMERIC, Map("original_type" -> value.getClass.getSimpleName))
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> class TemporalTokenizer(formatStr: Option[String] = None)
[?2004l[?2004h>   extends BaseTokenizer[Either[LocalDateTime, LocalDate]] {
[?2004l[?2004h> 
[?2004l[?2004h>   private val ISO_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss")
[?2004l[?2004h>   private val DATE_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd")
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Either[LocalDateTime, LocalDate]): Token = {
[?2004l[?2004h>     val (dateObj, defaultFmt) = value match {
[?2004l[?2004h>       case Left(dt) => (dt, ISO_FORMAT)
[?2004l[?2004h>       case Right(d) => (d, DATE_FORMAT)
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     val fmt = formatStr.map(DateTimeFormatter.ofPattern).getOrElse(defaultFmt)
[?2004l[?2004h>     val strValue = fmt.format(dateObj)
[?2004l[?2004h>     Token(strValue, TokenType.TEMPORAL)
[?2004l[?2004h>   }
[?2004l[?2004h> }
