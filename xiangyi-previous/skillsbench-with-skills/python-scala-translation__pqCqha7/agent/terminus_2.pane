[?2004l[?2004h> class TokenContainer[+T](items: Seq[T]) {
[?2004l[?2004h>   private val _items: Seq[T] = items
[?2004l[?2004h> 
[?2004l[?2004h>   def getAll: Seq[T] = _items
[?2004l[?2004h> 
[?2004l[?2004h>   def mapTokens(func: T => String): List[String] = {
[?2004l[?2004h>     _items.map(func).toList
[?2004l[?2004h>   }
[?2004l[?2004h> }
