[218.155408, "o", "# Write your rule(s) here.\r\n# Requirement: raise exactly sid:1000001 for the custom exfil pattern.\r\nalert http any any -> any any (msg:\"Custom Data Exfiltration Detected\"; flow:established,to_server; http.method; content:\"POST\"; http.uri; content:\"/telemetry/v2/report\"; http.header; content:\"X-TLM-Mode|3a 20|exfil\"; nocase; http.request_body; content:\"blob=\"; content:\"sig=\"; pcre:\"/blob=[A-Za-z0-9+\\/]{80,}/\"; pcre:\"/sig=[a-fA-F0-9]{64}(?:[^a-fA-F0-9]|$)/\"; sid:1000001; rev:1;)\r\n"]
