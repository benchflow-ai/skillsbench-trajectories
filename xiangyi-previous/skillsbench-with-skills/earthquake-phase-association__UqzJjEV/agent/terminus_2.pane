[?2004l[?2004h>     for i, (p_time_float, ref_station, ref_pick) in enumerate(all_p_times):
[?2004l[?2004h>         if i in used_indices:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         cluster_picks = {'P': {}, 'S': {}}
[?2004l[?2004h>         cluster_indices = set()
