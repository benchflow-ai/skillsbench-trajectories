[?2004l[?2004h> 
[?2004l[?2004h> def haversine_distance(lon1, lat1, lon2, lat2):
[?2004l[?2004h>     """Calculate distance in km between two points on Earth"""
[?2004l[?2004h>     lon1, lat1, lon2, lat2 = map(np.radians, [lon1, lat1, lon2, lat2])
[?2004l[?2004h>     dlon = lon2 - lon1
[?2004l[?2004h>     dlat = lat2 - lat1
[?2004l[?2004h>     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[?2004l[?2004h>     c = 2 * np.arcsin(np.sqrt(a))
[?2004l[?2004h>     return EARTH_RADIUS * c
[?2004l[?2004h> 
