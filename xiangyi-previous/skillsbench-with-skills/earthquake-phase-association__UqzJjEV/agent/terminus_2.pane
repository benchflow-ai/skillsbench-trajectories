[?2004l[?2004h> def cluster_picks(all_p_times, picks_by_station, window_size=1.0, min_stations=3):
[?2004l[?2004h>     """Cluster picks into events"""
[?2004l[?2004h>     events = []
[?2004l[?2004h>     used_indices = set()
