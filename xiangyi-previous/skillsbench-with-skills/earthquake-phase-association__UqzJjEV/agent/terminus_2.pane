[?2004l[?2004h>         # Add reference pick
[?2004l[?2004h>         cluster_picks['P'][ref_station] = ref_pick
[?2004l[?2004h>         cluster_indices.add(i)
[?2004l[?2004h>         
[?2004l[?2004h>         # Find other P picks in the window
[?2004l[?2004h>         for j, (other_p_time, other_station, other_pick) in enumerate(all_p_times):
[?2004l[?2004h>             if j != i and j not in used_indices:
[?2004l[?2004h>                 if abs(other_p_time - p_time_float) < window_size and other_station != ref_station:
[?2004l[?2004h>                     cluster_picks['P'][other_station] = other_pick
[?2004l[?2004h>                     cluster_indices.add(j)
[?2004l[?2004h>         
[?2004l[?2004h>         # Only keep clusters with enough stations
[?2004l[?2004h>         if len(cluster_picks['P']) >= min_stations:
[?2004l[?2004h>             # Try to find matching S picks
[?2004l[?2004h>             for station in cluster_picks['P']:
[?2004l[?2004h>                 p_pick = cluster_picks['P'][station]
[?2004l[?2004h>                 p_time = p_pick['time_float']
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Look for S pick within expected range
[?2004l[?2004h>                 for s_pick in picks_by_station[station]['S']:
[?2004l[?2004h>                     s_time = s_pick['time_float']
[?2004l[?2004h>                     ps_diff = s_time - p_time
[?2004l[?2004h>                     if 1.5 < ps_diff < 5.0:
[?2004l[?2004h>                         cluster_picks['S'][station] = s_pick
[?2004l[?2004h>                         break
[?2004l[?2004h>             
[?2004l[?2004h>             # Create event
[?2004l[?2004h>             event_time = UTCDateTime(np.median([p['time_float'] for p in cluster_picks['P'].values()]))
[?2004l[?2004h>             events.append({
[?2004l[?2004h>                 'time': event_time,
