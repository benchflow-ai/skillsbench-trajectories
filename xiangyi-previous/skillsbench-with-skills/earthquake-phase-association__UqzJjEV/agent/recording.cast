[200.903991, "o", "picks_from_annotations signature:\r\n"]
[200.904248, "o", "(annotations, threshold, phase) -> 'util.PickList'\r\n\r\nDocstring:\r\n\r\n        Converts the annotations streams for a single phase to discrete picks using a classical trigger on/off.\r\n        The lower threshold is set to half the higher threshold.\r\n        Picks are represented by :py:class:`~seisbench.util.annotations.Pick` objects.\r\n        The pick start_time and end_time are set to the trigger on and off times.\r\n\r\n        :param annotations: Stream of annotations\r\n        :param threshold: Higher threshold for trigger\r\n        :param phase: Phase to label, only relevant for output phase labelling\r\n        :return: List of picks\r\n        \r\n"]
[201.685728, "o", "\u001b[?2004hroot@cbf9650d1fd1:~# "]
[209.120553, "i", "python3 << 'EOFSCRIPT'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nfrom scipy.spatial.distance import cdist\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Data range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\nprint(f\"Got {len(annotations)} annotation traces\")\n\n# Extract picks with threshold\nthreshold = 0.3\nprint(f\"\\nExtracting P phase picks (threshold={threshold})...\")\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\nprint(f\"Found {len(p_picks)} P picks\")\n\nprint(f\"Extracting S phase picks (threshold={threshold})...\")\ns_picks = model.picks_from_annotations(annotations, threshold, phase='S')\nprint(f\"Found {len(s_picks)} S picks\")\n\n# Display sample picks\nprint(\"\\nSample P picks:\")\nfor pick in p_picks[:3]:\n    print(f\"  Network: {pick.network}, Station: {pick.station}, Time: {pick.time}, Uncertainty: {pick.uncertainty}\")\n\nprint(\"\\nSample S picks:\")\nfor pick in s_picks[:3]:\n    print(f\"  Network: {pick.network}, Station: {pick.station}, Time: {pick.time}, Uncertainty: {pick.uncertainty}\")\n\nEOFSCRIPT\n"]
[209.120956, "o", "python3 << 'EOFSCRIPT'\r\n\u001b[?2004l\r"]
