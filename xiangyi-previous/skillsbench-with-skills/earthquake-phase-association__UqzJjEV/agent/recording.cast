[958.894755, "o", "> "]
[958.894803, "o", "            p_pick = cluster_picks['P'][station]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.894849, "o", "            p_time = p_pick['time_float']\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.894901, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.894975, "o", "            # Look for S pick within expected range\r\n\u001b[?2004l\r"]
[958.895021, "o", "\u001b[?2004h> "]
[958.895078, "o", "            for s_pick in picks_by_station[station]['S']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895127, "o", "> "]
[958.895189, "o", "                s_time = s_pick['time_float']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.895239, "o", "                ps_diff = s_time - p_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895286, "o", "> "]
[958.895332, "o", "                if 1.5 < ps_diff < 5.0:\r\n\u001b[?2004l\r"]
[958.895379, "o", "\u001b[?2004h> "]
[958.89543, "o", "                    cluster_picks['S'][station] = s_pick\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.895475, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895521, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895569, "o", "> "]
[958.895617, "o", "        # Create event using median P time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.89574, "o", "        event_time = UTCDateTime(np.median([p['time_float'] for p in cluster_picks['P'].values()]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895765, "o", "> "]
[958.895812, "o", "        events.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.895868, "o", "> "]
[958.895935, "o", "            'time': event_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.895983, "o", "            'time_float': float(event_time),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896033, "o", "            'num_stations': len(cluster_picks['P']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.896064, "o", "> "]
[958.896145, "o", "            'num_s_picks': len(cluster_picks['S']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896192, "o", "            'picks': cluster_picks\r\n\u001b[?2004l\r"]
[958.896222, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[958.896246, "o", "\u001b[?2004h> "]
[958.896318, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896385, "o", "        # Mark these indices as used\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896433, "o", "        for idx in cluster_indices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896477, "o", "            used_indices.add(idx)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[958.896529, "o", "\u001b[?2004h> "]
[958.896578, "o", "print(f\"Found {len(events)} events\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[958.896629, "o", "\u001b[?2004h> "]
[958.896668, "o", "# Remove very similar events (within 0.5 seconds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.896695, "o", "> "]
[958.896759, "o", "final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896815, "o", "for event in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896873, "o", "    is_duplicate = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.896923, "o", "    for final_event in final_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897001, "o", "        if abs(event['time_float'] - final_event['time_float']) < 0.5:\r\n\u001b[?2004l\r"]
[958.897047, "o", "\u001b[?2004h> "]
[958.897099, "o", "            # Keep the one with more S picks\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.897152, "o", "> "]
[958.897197, "o", "            if event['num_s_picks'] > final_event['num_s_picks']:\r\n\u001b[?2004l\r"]
[958.897242, "o", "\u001b[?2004h> "]
[958.897288, "o", "                final_events.remove(final_event)\r\n\u001b[?2004l\r"]
[958.897339, "o", "\u001b[?2004h> "]
[958.89739, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897431, "o", "                is_duplicate = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.89748, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897527, "o", "    if not is_duplicate:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897572, "o", "        final_events.append(event)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[958.897616, "o", "\u001b[?2004h> "]
[958.897683, "o", "print(f\"After deduplication: {len(final_events)} events\")\r\n\u001b[?2004l\r"]
[958.897729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897776, "o", "# Sort by time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897851, "o", "final_events = sorted(final_events, key=lambda x: x['time_float'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.897893, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.897939, "o", "# Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.897988, "o", "> results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898037, "o", "for event in final_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898113, "o", "    iso_time = event['time'].isoformat().replace('Z', '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.898165, "o", "> "]
[958.898216, "o", "    results.append({'time': iso_time})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[958.898257, "o", "> "]
[958.898309, "o", "results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898367, "o", "results_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.898418, "o", "> "]
[958.898494, "o", "print(f\"\\nWrote {len(results_df)} events to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898544, "o", "print(\"\\nFirst 25 events:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898594, "o", "print(results_df.head(25))\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.898618, "o", "> "]
[958.898673, "o", "print(f\"\\nLast 10 events:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[958.898694, "o", "print(results_df.tail(10))\r\n\u001b[?2004l\r"]
[958.898712, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[958.898747, "o", "\u001b[?2004h> "]
