[881.431504, "o", "\u001b[?2004h> "]
[881.431568, "o", "            is_duplicate = False\r\n\u001b[?2004l\r"]
[881.431615, "o", "\u001b[?2004h> "]
[881.431668, "o", "            for final_event in final_events:\r\n"]
[881.431711, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[881.431819, "o", "                if abs(event['time_float'] - final_event['time_float']) < 0.8:\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.431861, "o", "> "]
[881.431904, "o", "                    is_duplicate = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
