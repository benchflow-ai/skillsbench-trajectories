[69.154873, "i", "python3 << 'EOFSCRIPT'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Data range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nprint(f\"Found {len(z_traces)} Z-channel traces\")\n\n# Create stream with Z traces\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(\"Running phase picking...\")\ntry:\n    # Use annotate method\n    annotations = model.annotate(z_stream)\n    print(f\"Got annotations: {type(annotations)}\")\n    print(f\"Annotations shape: {annotations.shape if hasattr(annotations, 'shape') else 'N/A'}\")\n    \n    # Extract picks\n    picks = model.picks_from_annotations(z_stream, annotations)\n    print(f\"Extracted {len(picks)} picks\")\n    for i, pick in enumerate(picks[:10]):\n        print(f\"  Pick {i}: {pick}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\n    import traceback\n    traceback.print_exc()\n\nEOFSCRIPT\n"]
