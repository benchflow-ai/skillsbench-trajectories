[881.430829, "o", "best_events = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.430851, "o", "best_score = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.430867, "o", "> \r\n\u001b[?2004l\r"]
[881.430887, "o", "\u001b[?2004h"]
[881.430909, "o", "> "]
[881.430998, "o", "for window_size in [0.8, 1.0, 1.2, 1.5]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.431054, "o", "    for min_stations in [2, 3, 4]:\r\n\u001b[?2004l\r"]
[881.431078, "o", "\u001b[?2004h> "]
[881.431217, "o", "        events = cluster_picks(all_p_times, picks_by_station, window_size, min_stations)\r\n\u001b[?2004l\r"]
[881.431239, "o", "\u001b[?2004h> "]
[881.431257, "o", "        \r\n\u001b[?2004l\r"]
[881.43128, "o", "\u001b[?2004h> "]
[881.431354, "o", "        # Remove duplicates\r\n\u001b[?2004l\r\u001b[?2004h> "]
