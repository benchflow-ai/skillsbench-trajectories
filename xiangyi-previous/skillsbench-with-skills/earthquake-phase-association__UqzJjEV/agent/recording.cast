[958.887411, "o", "\u001b[?2004h> "]
[958.887524, "o", "z_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[958.88757, "o", "> "]
