[517.970306, "o", "\u001b[?2004hroot@cbf9650d1fd1:~# "]
[562.124418, "i", "cat > /root/event_association.py << 'EOFPYTHON'\nimport obspy\nfrom obspy import read, UTCDateTime\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nfrom collections import defaultdict\nfrom scipy.spatial.distance import cdist\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\n# Create station location lookup\nstation_locs = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_locs:\n        station_locs[key] = {\n            'lon': row['longitude'],\n            'lat': row['latitude'],\n            'elev': row['elevation_m']\n        }\n\nprint(f\"Found {len(station_locs)} unique stations\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\n\n# Extract picks with higher threshold to reduce noise\nthreshold = 0.5  # Increased threshold\nprint(f\"Extracting picks (threshold={threshold})...\")\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\ns_picks = model.picks_from_annotations(annotations, threshold, phase='S')\n\nprint(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'P',\n            'time': pick_time,\n            'trace_id': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'S',\n            'time': pick_time,\n            'trace_id': trace_id\n        })\n\nprint(f\"Total picks: {len(all_picks)}\")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {'P': [], 'S': []})\nfor pick in all_picks:\n    key = f\"{pick['network']}.{pick['station']}\"\n    picks_by_station[key][pick['phase']].append(pick['time'])\n\nprint(f\"Picks organized at {len(picks_by_station)} stations\")\n\n# Get all unique P times (potential event times)\nall_p_times = set()\nfor station, phases in picks_by_station.items():\n    for p_time in phases['P']:\n        all_p_times.add(p_time)\n\nall_p_times = sorted(list(all_p_times))\nprint(f\"Found {len(all_p_times)} unique P arrival times\")\n\n# For each P time, try to find an event\nevents = []\n\nfor p_time in all_p_times:\n    # For this potential event time, find all picks that could belong to it\n    event_picks = {'P': {}, 'S': {}}\n    \n    for station, phases in picks_by_station.items():\n        # Find P pick close to p_time\n        for p in phases['P']:\n            if abs(float(p - p_time)) < 0.5:  # Within 0.5 seconds\n                event_picks['P'][station] = p\n                break\n        \n        # Find S pick after the P pick\n        if station in event_picks['P']:\n            p_pick = event_picks['P'][station]\n            for s in phases['S']:\n                if s > p_pick and abs(float(s - p_pick) - 3.0) < 1.5:  # Expected P-S around 3s\n                    event_picks['S'][station] = s\n                    break\n    \n    # Only keep events with picks at multiple stations\n    num_stations = len(event_picks['P'])\n    "]
[562.124611, "i", "if num_stations >= 3:  # At least 3 stations\n        events.append({\n            'time': p_time,\n            'num_stations': num_stations,\n            'picks': event_picks\n        })\n\nprint(f\"\\nFound {len(events)} potential events\")\nprint(\"Sample events:\")\nfor event in events[:5]:\n    print(f\"  Time: {event['time']}, Stations: {event['num_stations']}\")\n\nEOFPYTHON\n"]
[562.124863, "o", "cat > /root/event_association.py << 'EOFPYTHON'\r\n\u001b[?2004l\r"]
