[134.0548, "i", "python3 << 'EOFSCRIPT'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\nprint(f\"Got {len(annotations)} annotation traces\")\n\n# Extract P and S picks\nprint(\"Extracting P phase picks...\")\np_picks = model.picks_from_annotations(z_stream, annotations, phase='P')\nprint(f\"Found {len(p_picks)} P picks\")\n\nprint(\"Extracting S phase picks...\")\ns_picks = model.picks_from_annotations(z_stream, annotations, phase='S')\nprint(f\"Found {len(s_picks)} S picks\")\n\n# Display sample picks\nprint(\"\\nSample P picks:\")\nfor pick in p_picks[:5]:\n    print(f\"  {pick}\")\n\nprint(\"\\nSample S picks:\")\nfor pick in s_picks[:5]:\n    print(f\"  {pick}\")\n\nEOFSCRIPT\n"]
