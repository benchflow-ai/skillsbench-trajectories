[719.705257, "o", "\u001b[?2004h> "]
[719.705431, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r"]
[719.705495, "o", "\u001b[?2004h> "]
[719.705531, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.70561, "o", "# Constants\r\n\u001b[?2004l\r"]
[719.705646, "o", "\u001b[?2004h> "]
[719.705762, "o", "VP = 6.0  # km/s\r\n\u001b[?2004l\r"]
[719.705794, "o", "\u001b[?2004h"]
[719.705863, "o", "> "]
[719.705936, "o", "VS = VP / 1.75  # km/s\r\n\u001b[?2004l\r"]
[719.705971, "o", "\u001b[?2004h"]
[719.706039, "o", "> "]
[719.70615, "o", "EARTH_RADIUS = 6371.0  # km\r\n\u001b[?2004l\r"]
[719.706185, "o", "\u001b[?2004h"]
[719.706219, "o", "> \r\n\u001b[?2004l\r"]
[719.706257, "o", "\u001b[?2004h> "]
[719.706516, "o", "def haversine_distance(lon1, lat1, lon2, lat2):\r\n\u001b[?2004l\r"]
[719.706554, "o", "\u001b[?2004h> "]
[719.706901, "o", "    \"\"\"Calculate distance in km between two points on Earth\"\"\"\r\n\u001b[?2004l\r"]
[719.707022, "o", "\u001b[?2004h> "]
[719.707333, "o", "    lon1, lat1, lon2, lat2 = map(np.radians, [lon1, lat1, lon2, lat2])\r\n\u001b[?2004l\r"]
[719.707411, "o", "\u001b[?2004h> "]
[719.707534, "o", "    dlon = lon2 - lon1\r\n\u001b[?2004l\r"]
[719.707566, "o", "\u001b[?2004h> "]
[719.707714, "o", "    dlat = lat2 - lat1\r\n\u001b[?2004l\r"]
[719.707794, "o", "\u001b[?2004h"]
[719.707854, "o", "> "]
[719.70818, "o", "    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\r\n\u001b[?2004l\r"]
[719.708216, "o", "\u001b[?2004h> "]
[719.708428, "o", "    c = 2 * np.arcsin(np.sqrt(a))\r\n\u001b[?2004l\r"]
[719.708461, "o", "\u001b[?2004h> "]
[719.708652, "o", "    return EARTH_RADIUS * c\r\n\u001b[?2004l\r"]
[719.708689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[719.708718, "o", "\u001b[?2004h> "]
[719.708883, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.708982, "o", "> "]
[719.709114, "o", "st = read('/root/data/wave.mseed')\r\n\u001b[?2004l\r"]
[719.709156, "o", "\u001b[?2004h"]
[719.709242, "o", "> "]
[719.709453, "o", "stations_df = pd.read_csv('/root/data/stations.csv')\r\n\u001b[?2004l\r"]
[719.70955, "o", "\u001b[?2004h"]
[719.709655, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.70972, "o", "# Create station location lookup\r\n\u001b[?2004l\r"]
[719.709825, "o", "\u001b[?2004h> "]
[719.709868, "o", "station_locs = {}\r\n\u001b[?2004l\r"]
[719.709895, "o", "\u001b[?2004h> "]
[719.710121, "o", "for _, row in stations_df.iterrows():\r\n\u001b[?2004l\r"]
[719.710151, "o", "\u001b[?2004h> "]
[719.710364, "o", "    key = f\"{row['network']}.{row['station']}\"\r\n\u001b[?2004l\r"]
[719.710387, "o", "\u001b[?2004h> "]
[719.710536, "o", "    if key not in station_locs:\r\n\u001b[?2004l\r"]
[719.710558, "o", "\u001b[?2004h> "]
[719.710715, "o", "        station_locs[key] = {\r\n\u001b[?2004l\r"]
[719.710754, "o", "\u001b[?2004h> "]
[719.710911, "o", "            'lon': row['longitude'],\r\n\u001b[?2004l\r"]
[719.710934, "o", "\u001b[?2004h> "]
[719.711118, "o", "            'lat': row['latitude'],\r\n\u001b[?2004l\r"]
[719.711238, "o", "\u001b[?2004h> "]
[719.711361, "o", "            'elev': row['elevation_m']\r\n\u001b[?2004l\r"]
[719.711467, "o", "\u001b[?2004h> "]
[719.711573, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.711822, "o", "print(f\"Found {len(station_locs)} unique stations\")\r\n\u001b[?2004l\r"]
[719.711866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[719.711985, "o", "\u001b[?2004h> "]
[719.712062, "o", "# Load PhaseNet model\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.712275, "o", "print(\"Loading PhaseNet model...\")\r\n\u001b[?2004l\r"]
[719.712376, "o", "\u001b[?2004h> "]
[719.712668, "o", "model = seisbench.models.PhaseNet.from_pretrained(\"original\")\r\n\u001b[?2004l\r"]
[719.712758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[719.712856, "o", "\u001b[?2004h> "]
[719.712959, "o", "# Get Z channel traces\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.713282, "o", "z_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.713357, "o", "> "]
[719.71355, "o", "z_stream = obspy.Stream(traces=z_traces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.713652, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.713958, "o", "print(f\"Running phase picking on {len(z_stream)} traces...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.71403, "o", "> "]
[719.714222, "o", "annotations = model.annotate(z_stream)\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.714329, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.714442, "o", "> # Extract picks\r\n\u001b[?2004l\r"]
[719.714544, "o", "\u001b[?2004h> "]
[719.714649, "o", "threshold = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.71488, "o", "print(f\"Extracting picks (threshold={threshold})...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.714984, "o", "> "]
[719.715314, "o", "p_picks = model.picks_from_annotations(annotations, threshold, phase='P')\r\n\u001b[?2004l\r"]
[719.715402, "o", "\u001b[?2004h> "]
[719.715765, "o", "s_picks = model.picks_from_annotations(annotations, threshold, phase='S')\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.715839, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.715916, "o", "> "]
[719.716199, "o", "print(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.716272, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.716348, "o", "> "]
[719.716436, "o", "# Organize picks by station\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.716518, "o", "> "]
[719.7166, "o", "all_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.71671, "o", "for pick in p_picks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.716795, "o", "> "]
[719.716899, "o", "    trace_id = pick.trace_id\r\n\u001b[?2004l\r"]
[719.716969, "o", "\u001b[?2004h> "]
[719.717054, "o", "    parts = trace_id.split('.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.717132, "o", "    if len(parts) >= 2:\r\n\u001b[?2004l\r"]
[719.717208, "o", "\u001b[?2004h> "]
[719.717283, "o", "        network, station = parts[0], parts[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.717352, "o", "> "]
[719.71743, "o", "        pick_time = pick.peak_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.717556, "o", "        if not isinstance(pick_time, UTCDateTime):\r\n\u001b[?2004l\r"]
[719.717627, "o", "\u001b[?2004h> "]
[719.717707, "o", "            pick_time = UTCDateTime(pick_time)\r\n\u001b[?2004l\r"]
[719.717775, "o", "\u001b[?2004h> "]
[719.717844, "o", "        all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.717927, "o", "            'network': network,\r\n\u001b[?2004l\r"]
[719.717995, "o", "\u001b[?2004h> "]
[719.718058, "o", "            'station': station,\r\n\u001b[?2004l\r"]
[719.718128, "o", "\u001b[?2004h> "]
[719.718209, "o", "            'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.718278, "o", "            'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.718344, "o", "> "]
[719.718403, "o", "            'time_float': float(pick_time),\r\n\u001b[?2004l\r"]
[719.718472, "o", "\u001b[?2004h> "]
[719.718541, "o", "            'trace_id': trace_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.71861, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[719.718679, "o", "\u001b[?2004h> "]
[719.718761, "o", "for pick in s_picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.718835, "o", "    trace_id = pick.trace_id\r\n\u001b[?2004l\r"]
[719.718906, "o", "\u001b[?2004h> "]
[719.718975, "o", "    parts = trace_id.split('.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.719047, "o", "    if len(parts) >= 2:\r\n\u001b[?2004l\r"]
[719.719116, "o", "\u001b[?2004h> "]
[719.719195, "o", "        network, station = parts[0], parts[1]\r\n\u001b[?2004l\r"]
[719.719263, "o", "\u001b[?2004h> "]
[719.719332, "o", "        pick_time = pick.peak_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.7194, "o", "> "]
[719.71948, "o", "        if not isinstance(pick_time, UTCDateTime):\r\n\u001b[?2004l\r"]
[719.71955, "o", "\u001b[?2004h> "]
[719.719629, "o", "            pick_time = UTCDateTime(pick_time)\r\n\u001b[?2004l\r"]
[719.719698, "o", "\u001b[?2004h> "]
[719.719769, "o", "        all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.719847, "o", "            'network': network,\r\n\u001b[?2004l\r"]
[719.719916, "o", "\u001b[?2004h> "]
[719.719991, "o", "            'station': station,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.720073, "o", "            'phase': 'S',\r\n\u001b[?2004l\r"]
[719.720146, "o", "\u001b[?2004h> "]
[719.720215, "o", "            'time': pick_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.720318, "o", "            'time_float': float(pick_time),\r\n\u001b[?2004l\r"]
[719.720387, "o", "\u001b[?2004h> "]
[719.720461, "o", "            'trace_id': trace_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.720527, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[719.720599, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[719.720671, "o", "print(f\"Total picks: {len(all_picks)}\")\r\n\u001b[?2004l\r"]
[719.720739, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.720825, "o", "# Group picks by station and phase\r\n\u001b[?2004l\r"]
[719.720894, "o", "\u001b[?2004h> "]
[719.721001, "o", "picks_by_station = defaultdict(lambda: {'P': [], 'S': []})\r\n\u001b[?2004l\r"]
[719.721071, "o", "\u001b[?2004h> "]
[719.721144, "o", "for pick in all_picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.721263, "o", "    key = f\"{pick['network']}.{pick['station']}\"\r\n\u001b[?2004l\r"]
[719.721331, "o", "\u001b[?2004h> "]
[719.721432, "o", "    picks_by_station[key][pick['phase']].append(pick)\r\n\u001b[?2004l\r"]
[719.721502, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.721655, "o", "print(f\"Picks organized at {len(picks_by_station)} stations\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.721727, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.721809, "o", "> "]
[719.721896, "o", "# Create feature vectors for clustering: (time, station_index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.721999, "o", "# Use P pick times as primary feature\r\n\u001b[?2004l\r"]
[719.722074, "o", "\u001b[?2004h> "]
[719.722146, "o", "features = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.722226, "o", "feature_to_pick = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.722312, "o", "station_list = list(picks_by_station.keys())\r\n\u001b[?2004l\r"]
[719.722382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.722506, "o", "for station_idx, station in enumerate(station_list):\r\n\u001b[?2004l\r"]
[719.72258, "o", "\u001b[?2004h> "]
[719.722663, "o", "    for p_pick in picks_by_station[station]['P']:\r\n\u001b[?2004l\r"]
[719.722744, "o", "\u001b[?2004h> "]
[719.722874, "o", "        features.append([p_pick['time_float'], station_idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.722942, "o", "> "]
[719.723049, "o", "        feature_to_pick[len(features)-1] = (station, p_pick)\r\n\u001b[?2004l\r"]
[719.723123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.723195, "o", "> features = np.array(features)\r\n\u001b[?2004l\r"]
[719.723265, "o", "\u001b[?2004h> "]
[719.723346, "o", "print(f\"Created {len(features)} feature vectors\")\r\n\u001b[?2004l\r"]
[719.723418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.723579, "o", "# Cluster picks: picks are close in time and from different stations\r\n\u001b[?2004l\r"]
[719.723649, "o", "\u001b[?2004h> "]
[719.723716, "o", "if len(features) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.723814, "o", "    # Normalize features for clustering\r\n\u001b[?2004l\r"]
[719.723883, "o", "\u001b[?2004h> "]
[719.723951, "o", "    features_norm = features.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.724251, "o", "    features_norm[:, 0] = (features[:, 0] - features[:, 0].min()) / (features[:, 0].max() - features[:, 0].min())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.724436, "o", "    features_norm[:, 1] = features_norm[:, 1] / len(station_list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.724512, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[719.724584, "o", ">     # DBSCAN clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.724768, "o", "    clustering = DBSCAN(eps=0.05, min_samples=3).fit(features_norm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.724851, "o", "> "]
[719.724926, "o", "    labels = clustering.labels_\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.72501, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.725088, "o", "    # Group by cluster\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.725168, "o", "    clusters = defaultdict(list)\r\n\u001b[?2004l\r"]
[719.72525, "o", "\u001b[?2004h> "]
[719.725326, "o", "    for idx, label in enumerate(labels):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.725457, "o", "        if label >= 0:  # Ignore noise points (label == -1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.72553, "o", "> "]
[719.725595, "o", "            clusters[label].append(idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.725666, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.725769, "o", "    print(f\"Found {len(clusters)} clusters\")\r\n\u001b[?2004l\r"]
[719.725844, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[719.725915, "o", "\u001b[?2004h> "]
[719.725985, "o", "    # Extract events from clusters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.726055, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[719.726124, "o", "> "]
[719.726214, "o", "    for cluster_id, feature_indices in clusters.items():\r\n\u001b[?2004l\r"]
[719.726285, "o", "\u001b[?2004h> "]
[719.726391, "o", "        if len(feature_indices) >= 3:  # At least 3 stations\r\n\u001b[?2004l\r"]
[719.726461, "o", "\u001b[?2004h> "]
[719.726526, "o", "            # Get picks for this cluster\r\n\u001b[?2004l\r"]
[719.726595, "o", "\u001b[?2004h> "]
[719.726664, "o", "            cluster_picks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[719.726776, "o", "            unique_stations = set()\r\n\u001b[?2004l\r"]
[719.726849, "o", "\u001b[?2004h> "]
[719.726919, "o", "            for feat_idx in feature_indices:\r\n\u001b[?2004l\r"]
[719.726988, "o", "\u001b[?2004h> "]
[719.727098, "o", "                station, pick = feature_to_pick[feat_idx]\r\n\u001b[?2004l\r"]
[719.727168, "o", "\u001b[?2004h> "]
[719.727241, "o", "                cluster_picks.append(pick)\r\n\u001b[?2004l\r"]
[719.72731, "o", "\u001b[?2004h> "]
[719.727385, "o", "                unique_stations.add(station)\r\n\u001b[?2004l\r"]
[719.727455, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[719.727523, "o", "\u001b[?2004h> "]
[719.72759, "o", "            if len(unique_stations) >= 3:\r\n\u001b[?2004l\r"]
[719.727658, "o", "\u001b[?2004h> "]
[719.727746, "o", "                # Use median P time as event time\r\n\u001b[?2004l\r"]
[719.727814, "o", "\u001b[?2004h> "]
[719.727938, "o", "                times = [p['time_float'] for p in cluster_picks]\r\n\u001b[?2004l\r"]
[719.728009, "o", "\u001b[?2004h> "]
