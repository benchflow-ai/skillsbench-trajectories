[415.735738, "i", "cat > /root/event_association.py << 'EOFPYTHON'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nfrom scipy.spatial.distance import cdist\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\n\n# Create station lookup by network.station.channel\nstation_coords = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}.{row['channel']}\"\n    station_coords[key] = {\n        'lon': row['longitude'],\n        'lat': row['latitude'],\n        'elev': row['elevation_m']\n    }\n\n# Also create unique station locations (average if multiple channels)\nstation_locs = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_locs:\n        station_locs[key] = {\n            'lon': row['longitude'],\n            'lat': row['latitude'],\n            'elev': row['elevation_m']\n        }\n\nprint(f\"Found {len(station_locs)} unique stations\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\n\n# Extract picks\nthreshold = 0.3\nprint(f\"Extracting picks...\")\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\ns_picks = model.picks_from_annotations(annotations, threshold, phase='S')\n\nprint(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'P',\n            'time': pick.peak_time,\n            'trace_id': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'S',\n            'time': pick.peak_time,\n            'trace_id': trace_id\n        })\n\nprint(f\"Total picks: {len(all_picks)}\")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {'P': None, 'S': None})\nfor pick in all_picks:\n    key = f\"{pick['network']}.{pick['station']}\"\n    picks_by_station[key][pick['phase']] = pick['time']\n\nprint(f\"Picks organized at {len(picks_by_station)} stations\")\n\n# Calculate P-S times for each station\nps_times = {}\nfor station, phases in picks_by_station.items():\n    if phases['P'] and phases['S']:\n        ps_time = (phases['S'] - phases['P']).total_seconds()\n        ps_times[station] = {\n            'p_time': phases['P'],\n            's_time': phases['S'],\n            'ps_time': ps_time\n        }\n\nprint(f\"\\nStations with both P and S picks: {len(ps_times)}\")\nprint(\"Sample P-S times:\")\nfor i, (station, data) in enumerate(list(ps_times.items())[:5]):\n    print(f\"  {station}: P-S = {data['ps_time']:.2f}s\")\n\nEOFPYTHON\n"]
