[881.432102, "o", "                final_events.append(event)\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.432144, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.432282, "o", "        # Simple scoring: prefer moderate number of events with good station coverage\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.432325, "o", "> "]
[881.432448, "o", "        avg_stations = np.mean([e['num_stations'] for e in final_events]) if final_events else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.432491, "o", "> "]
[881.43258, "o", "        score = len(final_events) * (0.5 + 0.5 * min(avg_stations / 5.0, 1.0))\r\n\u001b[?2004l\r"]
[881.432626, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.432853, "o", "        print(f\"  window={window_size}, min_stations={min_stations}: {len(final_events)} events, avg_stations={avg_stations:.1f}, score={score:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.432899, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.432993, "o", "        if score > best_score and len(final_events) > 20:\r\n\u001b[?2004l\r"]
[881.43304, "o", "\u001b[?2004h> "]
[881.433085, "o", "            best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.433184, "o", "            best_config = (window_size, min_stations)\r\n\u001b[?2004l\r"]
[881.433229, "o", "\u001b[?2004h> "]
[881.433273, "o", "            best_events = final_events\r\n\u001b[?2004l\r"]
