[24.793785, "i", "python3 << 'EOFSCRIPT'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Data range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\n\n# Load PhaseNet model for picking\nprint(\"Loading SeisBench PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Prepare data for picking - use Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nprint(f\"Found {len(z_traces)} vertical (Z) channel traces\")\n\n# Create a stream with Z channel traces\nz_stream = obspy.Stream(traces=z_traces)\n\n# Normalize traces for model input\nfor tr in z_stream:\n    if np.max(np.abs(tr.data)) > 0:\n        tr.data = tr.data / np.max(np.abs(tr.data))\n\nprint(f\"Processing {len(z_stream)} traces with PhaseNet...\")\n\n# Run picking on the stream\ntry:\n    picks = model.predict(z_stream)\n    print(f\"Detected {len(picks)} picks\")\n    print(\"Sample picks:\")\n    for i, pick in enumerate(picks[:5]):\n        print(f\"  {pick}\")\nexcept Exception as e:\n    print(f\"Error during picking: {e}\")\n    print(\"Attempting alternative approach...\")\n    picks = []\n\nEOFSCRIPT\n"]
