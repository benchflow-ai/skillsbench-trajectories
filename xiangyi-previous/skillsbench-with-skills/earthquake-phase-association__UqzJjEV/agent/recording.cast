[881.434093, "o", "> "]
[881.434139, "o", "        for final_event in final_events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.434262, "o", "            if abs(event['time_float'] - final_event['time_float']) < 0.8:\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.434302, "o", "> "]
[881.434344, "o", "                is_duplicate = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.434387, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.434428, "o", "> "]
[881.434472, "o", "        if not is_duplicate:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.434528, "o", "            final_events.append(event)\r\n\u001b[?2004l\r"]
[881.43457, "o", "\u001b[?2004h> "]
[881.434613, "o", "    best_events = final_events\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.434655, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.434701, "o", "# Sort by time\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.43476, "o", "> "]
[881.442843, "o", "best_events = sorted(best_events, key=lambda x: x['time_float'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> for event in best_events:\r\n\u001b[?2004l\r\u001b[?2004h>     iso_time = event['time'].isoformat().replace('Z', '')\r\n\u001b[?2004l\r\u001b[?2004h>     results.append({'time': iso_time})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> results_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nWrote {len(results_df)} events to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nFirst 20 events:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(results_df.head(20))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOFPYTHON\r\n\u001b[?2004l\r\u001b[?2004hroot@cbf9650d1fd1:~# "]
