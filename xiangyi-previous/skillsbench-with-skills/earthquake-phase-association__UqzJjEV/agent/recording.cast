[635.698863, "o", "    picks_by_station[key][pick['phase']].append(pick)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Picks organized at {len(picks_by_station)} stations\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get all unique P times (potential event times)\r\n\u001b[?2004l\r\u001b[?2004h> all_p_times = set()\r\n\u001b[?2004l\r\u001b[?2004h> for station, phases in picks_by_station.items():\r\n\u001b[?2004l\r\u001b[?2004h>     for p_pick in phases['P']:\r\n\u001b[?2004l\r\u001b[?2004h>         all_p_times.add(p_pick['time_float'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> all_p_times = sorted(list(all_p_times))\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(all_p_times)} unique P arrival times\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # For each P time, try to find an event\r\n\u001b[?2004l\r\u001b[?2004h> events = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for p_time_float in all_p_times:\r\n\u001b[?2004l\r\u001b[?2004h>     p_time = UTCDateTime(p_time_float)\r\n\u001b[?2004l\r\u001b[?2004h>     # For this potential event time, find all picks that could belong to it\r\n\u001b[?2004l\r\u001b[?2004h>     event_picks = {'P': {}, 'S': {}}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for station, phases in picks_by_station.items():\r\n\u001b[?2004l\r\u001b[?2004h>         # Find P pick close to p_time\r\n\u001b[?2004l\r\u001b[?2004h>         for p_pick in phases['P']:\r\n\u001b[?2004l\r\u001b[?2004h>             if abs(p_pick['time_float'] - p_time_float) < 0.5:  # Within 0.5 seconds\r\n\u001b[?2004l\r\u001b[?2004h>                 event_picks['P'][station] = p_pick\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Find S pick after the P pick\r\n\u001b[?2004l\r\u001b[?2004h>         if station in event_picks['P']:\r\n\u001b[?2004l\r\u001b[?2004h>             p_pick_time = event_picks['P'][station]['time_float']\r\n\u001b[?2004l\r\u001b[?2004h>             for s_pick in phases['S']:\r\n\u001b[?2004l\r\u001b[?2004h>                 s_time = s_pick['time_float']\r\n\u001b[?2004l\r\u001b[?2004h>                 if s_time > p_pick_time and abs(s_time - p_pick_time - 3.0) < 1.5:\r\n\u001b[?2004l\r\u001b[?2004h>                     event_picks['S'][station] = s_pick\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r"]
[635.699029, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.699083, "o", "    # Only keep events with picks at multiple stations\r\n\u001b[?2004l\r\u001b[?2004h>     num_stations = len(event_picks['P'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.699227, "o", "    if num_stations >= 3:  # At least 3 stations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.699296, "o", "        events.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'time': p_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.69934, "o", "            'time_float': p_time_float,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.69943, "o", "            'num_stations': num_stations,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700141, "o", "            'picks': event_picks\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nFound {len(events)} potential events\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Sample events:\")\r\n\u001b[?2004l\r\u001b[?2004h> for event in events[:10]:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Time: {event['time']}, Stations: {event['num_stations']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Remove duplicate events (within 2 seconds)\r\n\u001b[?2004l\r\u001b[?2004h> final_events = []\r\n\u001b[?2004l\r\u001b[?2004h> used = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700197, "o", "for i, event in enumerate(events):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700223, "o", "    if i in used:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700271, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700301, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700377, "o", "    final_events.append(event)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700408, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[635.700442, "o", "    # Mark similar events as used\r\n\u001b[?2004l\r\u001b[?2004h"]
[635.702308, "o", "> "]
[635.702412, "o", "    for j in range(i+1, len(events)):\r\n\u001b[?2004l\r\u001b[?2004h>         if j not in used:\r\n\u001b[?2004l\r\u001b[?2004h>             if abs(event['time_float'] - events[j]['time_float']) < 2.0:\r\n\u001b[?2004l\r\u001b[?2004h>                 used.add(j)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nAfter deduplication: {len(final_events)} events\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> for event in final_events:\r\n\u001b[?2004l\r\u001b[?2004h>     iso_time = event['time'].isoformat().replace('Z', '')\r\n\u001b[?2004l\r\u001b[?2004h>     results.append({'time': iso_time})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> results_df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nWrote {len(results_df)} events to /root/results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nFirst few events:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(results_df.head(10))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOFPYTHON\r\n\u001b[?2004l\r"]
