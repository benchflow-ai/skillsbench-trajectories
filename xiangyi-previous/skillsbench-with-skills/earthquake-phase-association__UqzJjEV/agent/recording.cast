[274.17202, "i", "python3 << 'EOFSCRIPT'\nimport obspy\nfrom obspy import read\nimport seisbench.models\nimport warnings\nwarnings.filterwarnings('ignore')\n\nst = read('/root/data/wave.mseed')\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\nannotations = model.annotate(z_stream)\n\nthreshold = 0.3\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\n\nif len(p_picks) > 0:\n    pick = p_picks[0]\n    print(f\"Pick object type: {type(pick)}\")\n    print(f\"Pick attributes: {dir(pick)}\")\n    print(f\"\\nPick details:\")\n    for attr in dir(pick):\n        if not attr.startswith('_'):\n            try:\n                val = getattr(pick, attr)\n                if not callable(val):\n                    print(f\"  {attr}: {val}\")\n            except:\n                pass\n\nEOFSCRIPT\n"]
