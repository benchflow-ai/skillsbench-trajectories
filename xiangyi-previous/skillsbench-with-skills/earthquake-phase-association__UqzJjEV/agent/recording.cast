[881.411688, "i", "cat > /root/event_association_optimized.py << 'EOFPYTHON'\nimport obspy\nfrom obspy import read, UTCDateTime\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport seisbench.models\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\ndef cluster_picks(all_p_times, picks_by_station, window_size=1.0, min_stations=3):\n    \"\"\"Cluster picks into events\"\"\"\n    events = []\n    used_indices = set()\n    \n    for i, (p_time_float, ref_station, ref_pick) in enumerate(all_p_times):\n        if i in used_indices:\n            continue\n        \n        cluster_picks = {'P': {}, 'S': {}}\n        cluster_indices = set()\n        \n        # Add reference pick\n        cluster_picks['P'][ref_station] = ref_pick\n        cluster_indices.add(i)\n        \n        # Find other P picks in the window\n        for j, (other_p_time, other_station, other_pick) in enumerate(all_p_times):\n            if j != i and j not in used_indices:\n                if abs(other_p_time - p_time_float) < window_size and other_station != ref_station:\n                    cluster_picks['P'][other_station] = other_pick\n                    cluster_indices.add(j)\n        \n        # Only keep clusters with enough stations\n        if len(cluster_picks['P']) >= min_stations:\n            # Try to find matching S picks\n            for station in cluster_picks['P']:\n                p_pick = cluster_picks['P'][station]\n                p_time = p_pick['time_float']\n                \n                # Look for S pick within expected range\n                for s_pick in picks_by_station[station]['S']:\n                    s_time = s_pick['time_float']\n                    ps_diff = s_time - p_time\n                    if 1.5 < ps_diff < 5.0:\n                        cluster_picks['S'][station] = s_pick\n                        break\n            \n            # Create event\n            event_time = UTCDateTime(np.median([p['time_float'] for p in cluster_picks['P'].values()]))\n            events.append({\n                'time': event_time,\n                'time_float': float(event_time),\n                'num_stations': len(cluster_picks['P']),\n                'picks': cluster_picks\n            })\n            \n            # Mark these indices as used\n            for idx in cluster_indices:\n                used_indices.add(idx)\n    \n    return events\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\n# Create station location lookup\nstation_locs = {}\nfor _, row in stations_df.iterrows():\n    key = f\"{row['network']}.{row['station']}\"\n    if key not in station_locs:\n        station_locs[key] = {\n            'lon': row['longitude'],\n            'lat': row['latitude'],\n            'elev': row['elevation_m']\n        }\n\nprint(f\"Found {len(station_locs)} unique stations\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\n\n# Extract picks with optimized threshold\nthreshold = 0.35  # Lower threshold for better sensitivity\nprint(f\"Extracting picks (threshold={threshold})...\")\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\ns_picks = model.picks_from_annotations(annotations, threshold, phase='S')\n\nprint(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'P',\n            'time': pi"]
[881.411859, "i", "ck_time,\n            'time_float': float(pick_time),\n            'trace_id': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'S',\n            'time': pick_time,\n            'time_float': float(pick_time),\n            'trace_id': trace_id\n        })\n\nprint(f\"Total picks: {len(all_picks)}\")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {'P': [], 'S': []})\nfor pick in all_picks:\n    key = f\"{pick['network']}.{pick['station']}\"\n    picks_by_station[key][pick['phase']].append(pick)\n\nprint(f\"Picks organized at {len(picks_by_station)} stations\")\n\n# Get all unique P times and sort them\nall_p_times = []\nfor station, phases in picks_by_station.items():\n    for p_pick in phases['P']:\n        all_p_times.append((p_pick['time_float'], station, p_pick))\n\nall_p_times = sorted(all_p_times, key=lambda x: x[0])\nprint(f\"Found {len(all_p_times)} P picks across all stations\")\n\n# Test different parameter combinations\nprint(\"\\nTesting parameter combinations...\")\nbest_config = None\nbest_events = None\nbest_score = 0\n\nfor window_size in [0.8, 1.0, 1.2, 1.5]:\n    for min_stations in [2, 3, 4]:\n        events = cluster_picks(all_p_times, picks_by_station, window_size, min_stations)\n        \n        # Remove duplicates\n        final_events = []\n        for event in events:\n            is_duplicate = False\n            for final_event in final_events:\n                if abs(event['time_float'] - final_event['time_float']) < 0.8:\n                    is_duplicate = True\n                    break\n            if not is_duplicate:\n                final_events.append(event)\n        \n        # Simple scoring: prefer moderate number of events with good station coverage\n        avg_stations = np.mean([e['num_stations'] for e in final_events]) if final_events else 0\n        score = len(final_events) * (0.5 + 0.5 * min(avg_stations / 5.0, 1.0))\n        \n        print(f\"  window={window_size}, min_stations={min_stations}: {len(final_events)} events, avg_stations={avg_stations:.1f}, score={score:.1f}\")\n        \n        if score > best_score and len(final_events) > 20:\n            best_score = score\n            best_config = (window_size, min_stations)\n            best_events = final_events\n\nif best_config:\n    print(f\"\\nBest configuration: window_size={best_config[0]}, min_stations={best_config[1]}\")\n    print(f\"Events found: {len(best_events)}\")\nelse:\n    print(\"\\nUsing default configuration\")\n    best_events = cluster_picks(all_p_times, picks_by_station, 1.0, 3)\n    final_events = []\n    for event in best_events:\n        is_duplicate = False\n        for final_event in final_events:\n            if abs(event['time_float'] - final_event['time_float']) < 0.8:\n                is_duplicate = True\n                break\n        if not is_duplicate:\n            final_events.append(event)\n    best_events = final_events\n\n# Sort by time\nbest_events = sorted(best_events, key=lambda x: x['time_float'])\n\n# Write results to CSV\nresults = []\nfor event in best_events:\n    iso_time = event['time'].isoformat().replace('Z', '')\n    results.append({'time': iso_time})\n\nresults_df = pd.DataFrame(results)\nresults_df.to_csv('/root/results.csv', index=False)\nprint(f\"\\nWrote {len(results_df)} events to /root/results.csv\")\nprint(\"\\nFirst 20 events:\")\nprint(results_df.head(20))\n\nEOFPYTHON\n"]
[881.412176, "o", "cat > /root/event_association_optimized.py << 'EOFPYTHON'\r\n\u001b[?2004l\r"]
[881.412285, "o", "\u001b[?2004h> import obspy"]
[881.412316, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.41244, "o", "from obspy import read, UTCDateTime\r\n\u001b[?2004l\r \u001b[?2004h> "]
[881.412514, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[881.412581, "o", "\u001b[?2004h> "]
[881.412617, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[881.41264, "o", "\u001b[?2004h> "]
[881.412794, "o", "from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.412852, "o", "> "]
[881.412922, "o", "import seisbench.models\r\n\u001b[?2004l\r"]
[881.412976, "o", "\u001b[?2004h> "]
[881.413082, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[881.413137, "o", "\u001b[?2004h"]
[881.413194, "o", "> "]
[881.413245, "o", "import warnings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.413439, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r"]
[881.413491, "o", "\u001b[?2004h> "]
[881.413532, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.413575, "o", "# Constants\r\n\u001b[?2004l\r"]
[881.413622, "o", "\u001b[?2004h> "]
[881.413679, "o", "VP = 6.0  # km/s\r\n\u001b[?2004l\r"]
[881.413726, "o", "\u001b[?2004h> "]
[881.413808, "o", "VS = VP / 1.75  # km/s\r\n\u001b[?2004l\r"]
[881.413855, "o", "\u001b[?2004h> "]
[881.413903, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.414153, "o", "def cluster_picks(all_p_times, picks_by_station, window_size=1.0, min_stations=3):\r\n\u001b[?2004l\r"]
[881.414205, "o", "\u001b[?2004h> "]
[881.414291, "o", "    \"\"\"Cluster picks into events\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.414333, "o", "> "]
[881.41438, "o", "    events = []\r\n\u001b[?2004l\r"]
[881.414434, "o", "\u001b[?2004h> "]
[881.414487, "o", "    used_indices = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.414536, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.414798, "o", "    for i, (p_time_float, ref_station, ref_pick) in enumerate(all_p_times):\r\n\u001b[?2004l\r"]
[881.414848, "o", "\u001b[?2004h> "]
[881.414933, "o", "        if i in used_indices:\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.414981, "o", "> "]
[881.415034, "o", "            continue\r\n\u001b[?2004l\r"]
[881.415081, "o", "\u001b[?2004h> "]
[881.415108, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.415135, "o", "> "]
[881.415301, "o", "        cluster_picks = {'P': {}, 'S': {}}\r\n\u001b[?2004l\r"]
[881.415329, "o", "\u001b[?2004h> "]
[881.415439, "o", "        cluster_indices = set()\r\n\u001b[?2004l\r"]
[881.415494, "o", "\u001b[?2004h> "]
[881.415586, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.415673, "o", "        # Add reference pick\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.415785, "o", "        cluster_picks['P'][ref_station] = ref_pick\r\n\u001b[?2004l\r"]
[881.415874, "o", "\u001b[?2004h> "]
[881.415969, "o", "        cluster_indices.add(i)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.416068, "o", "> "]
[881.416155, "o", "        # Find other P picks in the window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.416351, "o", "        for j, (other_p_time, other_station, other_pick) in enumerate(all_p_times):\r\n\u001b[?2004l\r"]
[881.416438, "o", "\u001b[?2004h> "]
[881.416514, "o", "            if j != i and j not in used_indices:\r\n\u001b[?2004l\r"]
[881.416568, "o", "\u001b[?2004h> "]
[881.416862, "o", "                if abs(other_p_time - p_time_float) < window_size and other_station != ref_station:\r\n\u001b[?2004l\r"]
[881.416911, "o", "\u001b[?2004h> "]
[881.417101, "o", "                    cluster_picks['P'][other_station] = other_pick\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.417151, "o", "> "]
[881.417265, "o", "                    cluster_indices.add(j)\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.417317, "o", "> "]
[881.417358, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.417515, "o", "        # Only keep clusters with enough stations\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.417541, "o", "> "]
[881.417688, "o", "        if len(cluster_picks['P']) >= min_stations:\r\n\u001b[?2004l\r"]
[881.417731, "o", "\u001b[?2004h> "]
[881.417847, "o", "            # Try to find matching S picks\r\n\u001b[?2004l\r"]
[881.4179, "o", "\u001b[?2004h> "]
[881.418016, "o", "            for station in cluster_picks['P']:\r\n\u001b[?2004l\r"]
[881.41807, "o", "\u001b[?2004h> "]
[881.418216, "o", "                p_pick = cluster_picks['P'][station]\r\n\u001b[?2004l\r"]
[881.418303, "o", "\u001b[?2004h> "]
[881.418387, "o", "                p_time = p_pick['time_float']\r\n\u001b[?2004l\r"]
[881.418415, "o", "\u001b[?2004h> "]
[881.418476, "o", "                \r\n\u001b[?2004l\r"]
[881.418531, "o", "\u001b[?2004h> "]
[881.418683, "o", "                # Look for S pick within expected range\r\n\u001b[?2004l\r"]
[881.418748, "o", "\u001b[?2004h> "]
[881.418918, "o", "                for s_pick in picks_by_station[station]['S']:\r\n\u001b[?2004l\r"]
[881.418973, "o", "\u001b[?2004h> "]
[881.419102, "o", "                    s_time = s_pick['time_float']\r\n\u001b[?2004l\r"]
[881.419157, "o", "\u001b[?2004h> "]
[881.419273, "o", "                    ps_diff = s_time - p_time\r\n\u001b[?2004l\r"]
[881.419301, "o", "\u001b[?2004h> "]
[881.419443, "o", "                    if 1.5 < ps_diff < 5.0:\r\n\u001b[?2004l\r"]
[881.419498, "o", "\u001b[?2004h> "]
[881.419661, "o", "                        cluster_picks['S'][station] = s_pick\r\n\u001b[?2004l\r"]
[881.419712, "o", "\u001b[?2004h> "]
[881.419801, "o", "                        break\r\n\u001b[?2004l\r"]
[881.419866, "o", "\u001b[?2004h> "]
[881.419919, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.419992, "o", "            # Create event\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.420047, "o", "> "]
[881.420338, "o", "            event_time = UTCDateTime(np.median([p['time_float'] for p in cluster_picks['P'].values()]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.42037, "o", "> "]
[881.420467, "o", "            events.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.420527, "o", "> "]
[881.420609, "o", "                'time': event_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.42065, "o", "> "]
[881.420791, "o", "                'time_float': float(event_time),\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.420846, "o", "> "]
[881.420998, "o", "                'num_stations': len(cluster_picks['P']),\r\n\u001b[?2004l\r"]
[881.421045, "o", "\u001b[?2004h> "]
[881.421143, "o", "                'picks': cluster_picks\r\n\u001b[?2004l\r"]
[881.421223, "o", "\u001b[?2004h>             })\r\n\u001b[?2004l\r"]
[881.421287, "o", "\u001b[?2004h> "]
[881.421338, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.421453, "o", "            # Mark these indices as used\r\n\u001b[?2004l\r"]
[881.421499, "o", "\u001b[?2004h> "]
[881.421605, "o", "            for idx in cluster_indices:\r\n\u001b[?2004l\r"]
[881.421657, "o", "\u001b[?2004h> "]
[881.421761, "o", "                used_indices.add(idx)\r\n\u001b[?2004l\r"]
[881.421827, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[881.42188, "o", "\u001b[?2004h> "]
[881.421938, "o", "    return events\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[881.422001, "o", "\u001b[?2004h> "]
[881.422075, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.422129, "o", "> "]
[881.422183, "o", "st = read('/root/data/wave.mseed')\r\n\u001b[?2004l\r"]
[881.422239, "o", "\u001b[?2004h> "]
[881.422387, "o", "stations_df = pd.read_csv('/root/data/stations.csv')\r\n\u001b[?2004l\r"]
[881.422441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[881.422483, "o", "\u001b[?2004h> "]
[881.42256, "o", "# Create station location lookup\r\n\u001b[?2004l\r"]
[881.42263, "o", "\u001b[?2004h> "]
[881.42268, "o", "station_locs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.422813, "o", "for _, row in stations_df.iterrows():\r\n\u001b[?2004l\r"]
[881.422847, "o", "\u001b[?2004h> "]
[881.422996, "o", "    key = f\"{row['network']}.{row['station']}\"\r\n\u001b[?2004l\r"]
[881.42306, "o", "\u001b[?2004h> "]
[881.423122, "o", "    if key not in station_locs:\r\n\u001b[?2004l\r"]
[881.423176, "o", "\u001b[?2004h> "]
[881.423249, "o", "        station_locs[key] = {\r\n\u001b[?2004l\r"]
[881.423305, "o", "\u001b[?2004h> "]
[881.423394, "o", "            'lon': row['longitude'],\r\n\u001b[?2004l\r"]
[881.423441, "o", "\u001b[?2004h> "]
[881.423532, "o", "            'lat': row['latitude'],\r\n\u001b[?2004l\r"]
[881.423588, "o", "\u001b[?2004h> "]
[881.423681, "o", "            'elev': row['elevation_m']\r\n\u001b[?2004l\r"]
[881.423728, "o", "\u001b[?2004h> "]
[881.423778, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.423825, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.423966, "o", "print(f\"Found {len(station_locs)} unique stations\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.42399, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.424063, "o", "> "]
[881.42411, "o", "# Load PhaseNet model\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.424223, "o", "print(\"Loading PhaseNet model...\")\r\n\u001b[?2004l\r"]
[881.424247, "o", "\u001b[?2004h> "]
[881.424429, "o", "model = seisbench.models.PhaseNet.from_pretrained(\"original\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.424451, "o", "> \r\n\u001b[?2004l\r"]
[881.424471, "o", "\u001b[?2004h> "]
[881.42456, "o", "# Get Z channel traces\r\n\u001b[?2004l\r"]
[881.424582, "o", "\u001b[?2004h> "]
[881.424788, "o", "z_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\r\n\u001b[?2004l\r"]
[881.424807, "o", "\u001b[?2004h> "]
[881.424934, "o", "z_stream = obspy.Stream(traces=z_traces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.424957, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.424974, "o", "> "]
[881.425166, "o", "print(f\"Running phase picking on {len(z_stream)} traces...\")\r\n\u001b[?2004l\r"]
[881.425191, "o", "\u001b[?2004h> "]
[881.42532, "o", "annotations = model.annotate(z_stream)\r\n\u001b[?2004l\r"]
[881.42534, "o", "\u001b[?2004h> \r\n"]
[881.425359, "o", "\u001b[?2004l\r\u001b[?2004h"]
[881.425385, "o", "> "]
[881.425502, "o", "# Extract picks with optimized threshold\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.425523, "o", "> "]
[881.42569, "o", "threshold = 0.35  # Lower threshold for better sensitivity\r\n\u001b[?2004l\r"]
[881.425711, "o", "\u001b[?2004h> "]
[881.425882, "o", "print(f\"Extracting picks (threshold={threshold})...\")\r\n\u001b[?2004l\r"]
[881.425904, "o", "\u001b[?2004h> "]
[881.426111, "o", "p_picks = model.picks_from_annotations(annotations, threshold, phase='P')\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.426131, "o", "> "]
[881.42637, "o", "s_picks = model.picks_from_annotations(annotations, threshold, phase='S')\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.426392, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.42641, "o", "> "]
[881.426607, "o", "print(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.426629, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[881.426649, "o", "> "]
[881.426758, "o", "# Organize picks by station\r\n\u001b[?2004l\r"]
[881.426779, "o", "\u001b[?2004h> "]
[881.426836, "o", "all_picks = []\r\n\u001b[?2004l\r"]
[881.426856, "o", "\u001b[?2004h> "]
[881.426918, "o", "for pick in p_picks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.426937, "o", "> "]
[881.426988, "o", "    trace_id = pick.trace_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.427041, "o", "    parts = trace_id.split('.')\r\n\u001b[?2004l\r"]
[881.427062, "o", "\u001b[?2004h> "]
[881.427112, "o", "    if len(parts) >= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.427192, "o", "        network, station = parts[0], parts[1]\r\n\u001b[?2004l\r"]
[881.427215, "o", "\u001b[?2004h> "]
[881.427267, "o", "        pick_time = pick.peak_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.427354, "o", "        if not isinstance(pick_time, UTCDateTime):\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427375, "o", "> "]
[881.42744, "o", "            pick_time = UTCDateTime(pick_time)\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427461, "o", "> "]
[881.42751, "o", "        all_picks.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.427565, "o", "            'network': network,\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427584, "o", "> "]
[881.427635, "o", "            'station': station,\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427654, "o", "> "]
[881.427704, "o", "            'phase': 'P',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[881.427755, "o", "            'time': pick_time,\r\n\u001b[?2004l\r"]
[881.427775, "o", "\u001b[?2004h> "]
[881.427834, "o", "            'time_float': float(pick_time),\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427855, "o", "> "]
[881.427905, "o", "            'trace_id': trace_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[881.427928, "o", ">         })\r\n\u001b[?2004l\r"]
[881.427948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[881.428006, "o", "\u001b[?2004h> for pick in s_picks:\r\n\u001b[?2004l\r"]
[881.428026, "o", "\u001b[?2004h> "]
[881.428087, "o", "    trace_id = pick.trace_id\r\n\u001b[?2004l\r"]
