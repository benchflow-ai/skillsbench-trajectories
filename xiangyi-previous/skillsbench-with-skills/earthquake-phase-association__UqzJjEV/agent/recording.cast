[14.71266, "i", "python3 << 'EOF'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\n\n# Load waveforms\nst = read('/root/data/wave.mseed')\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Sample trace: {st[0]}\")\nprint(f\"Start time: {st[0].stats.starttime}\")\nprint(f\"End time: {st[0].stats.endtime}\")\n\n# Load station data\nstations = pd.read_csv('/root/data/stations.csv')\nprint(f\"\\nLoaded {len(stations)} station channels\")\nprint(stations.head())\nEOF\n"]
