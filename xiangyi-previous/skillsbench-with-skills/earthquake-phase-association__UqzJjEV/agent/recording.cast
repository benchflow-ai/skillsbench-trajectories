[342.907609, "i", "cat > /root/event_association.py << 'EOFPYTHON'\nimport obspy\nfrom obspy import read\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport seisbench.models\nfrom scipy.spatial.distance import cdist\nfrom itertools import combinations\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\nprint(\"Loading data...\")\nst = read('/root/data/wave.mseed')\nstations_df = pd.read_csv('/root/data/stations.csv')\n\nprint(f\"Loaded {len(st)} traces\")\nprint(f\"Data range: {st[0].stats.starttime} to {st[0].stats.endtime}\")\n\n# Create station lookup\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = (row['network'], row['station'], row['channel'])\n    station_lookup[key] = {\n        'lon': row['longitude'],\n        'lat': row['latitude'],\n        'elev': row['elevation_m']\n    }\n\nprint(f\"Created lookup for {len(station_lookup)} station channels\")\n\n# Load PhaseNet model\nprint(\"Loading PhaseNet model...\")\nmodel = seisbench.models.PhaseNet.from_pretrained(\"original\")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith('Z')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f\"Running phase picking on {len(z_stream)} traces...\")\nannotations = model.annotate(z_stream)\n\n# Extract picks\nthreshold = 0.3\nprint(f\"Extracting picks (threshold={threshold})...\")\np_picks = model.picks_from_annotations(annotations, threshold, phase='P')\ns_picks = model.picks_from_annotations(annotations, threshold, phase='S')\n\nprint(f\"Found {len(p_picks)} P picks and {len(s_picks)} S picks\")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'P',\n            'time': pick.peak_time,\n            'trace_id': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split('.')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            'network': network,\n            'station': station,\n            'phase': 'S',\n            'time': pick.peak_time,\n            'trace_id': trace_id\n        })\n\nprint(f\"\\nTotal picks organized: {len(all_picks)}\")\nprint(\"Sample picks:\")\nfor pick in all_picks[:5]:\n    print(f\"  {pick['network']}.{pick['station']} {pick['phase']} {pick['time']}\")\n\nEOFPYTHON\n"]
