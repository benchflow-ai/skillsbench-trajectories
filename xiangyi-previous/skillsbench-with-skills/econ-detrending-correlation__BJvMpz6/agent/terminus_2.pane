[?2004l[?2004h> df_annual['PFI_real'] = df_annual['PFI_nominal'] / df_annual['CPI_2024']
[?2004l[?2004h> df_annual['log_PCE'] = np.log(df_annual['PCE_real'])
[?2004l[?2004h> df_annual['log_PFI'] = np.log(df_annual['PFI_real'])
[?2004l[?2004h> 
[?2004l[?2004h> # Implement Hodrick-Prescott filter
[?2004l[?2004h> def hp_filter(y, lam=100):
[?2004l[?2004h>     """
[?2004l[?2004h>     Hodrick-Prescott filter
[?2004l[?2004h>     y: time series (numpy array)
[?2004l[?2004h>     lam: smoothing parameter (lambda)
[?2004l[?2004h>     Returns: trend component
[?2004l[?2004h>     """
[?2004l[?2004h>     T = len(y)
[?2004l[?2004h>     # Create the matrix for the HP filter
[?2004l[?2004h>     I = np.eye(T)
[?2004l[?2004h>     D = np.zeros((T-2, T))
[?2004l[?2004h>     for i in range(T-2):
[?2004l[?2004h>         D[i, i] = 1
[?2004l[?2004h>         D[i, i+1] = -2
[?2004l[?2004h>         D[i, i+2] = 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve for trend: (I + lambda * D'D)^-1 * y
[?2004l[?2004h>     trend = np.linalg.solve(I + lam * D.T @ D, y)
[?2004l[?2004h>     return trend
[?2004l[?2004h> 
[?2004l[?2004h> # Apply HP filter with lambda=100
[?2004l[?2004h> lam = 100
[?2004l[?2004h> y_pce = df_annual['log_PCE'].values
[?2004l[?2004h> y_pfi = df_annual['log_PFI'].values
[?2004l[?2004h> 
[?2004l[?2004h> trend_pce = hp_filter(y_pce, lam=lam)
[?2004l[?2004h> trend_pfi = hp_filter(y_pfi, lam=lam)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract cyclical components
[?2004l[?2004h> cycle_pce = y_pce - trend_pce
[?2004l[?2004h> cycle_pfi = y_pfi - trend_pfi
[?2004l[?2004h> 
[?2004l[?2004h> print("Cyclical components (first 5 and last 5):")
[?2004l[?2004h> print(f"PCE cycle: {cycle_pce[:5]} ... {cycle_pce[-5:]}")
[?2004l[?2004h> print(f"PFI cycle: {cycle_pfi[:5]} ... {cycle_pfi[-5:]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Pearson correlation
[?2004l[?2004h> corr, pvalue = pearsonr(cycle_pce, cycle_pfi)
[?2004l[?2004h> print(f"\nPearson correlation between detrended PCE and PFI: {corr}")
[?2004l[?2004h> print(f"P-value: {pvalue}")
[?2004l[?2004h> 
[?2004l[?2004h> # Round to 5 decimal places
[?2004l[?2004h> corr_rounded = round(corr, 5)
[?2004l[?2004h> print(f"\nCorrelation rounded to 5 decimal places: {corr_rounded}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to answer.txt
[?2004l[?2004h> with open('/root/answer.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{corr_rounded}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nResult written to /root/answer.txt")
