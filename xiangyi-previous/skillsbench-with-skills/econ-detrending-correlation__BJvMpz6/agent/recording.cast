[36.367536, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Read the Excel files\ndf_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\ndf_12_raw = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0, engine='xlrd', header=None)\ndf_cpi = pd.read_excel('/root/CPI.xlsx', sheet_name=0)\n\n# Extract PCE data (column 1 is Total PCE, starting from row 5 which is 1973)\n# Column 0 has years/quarters, Column 1 has PCE Total\npce_data = []\nfor i in range(5, len(df_10_raw)):\n    year_str = str(df_10_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan':\n        continue\n    value = df_10_raw.iloc[i, 1]\n    if pd.notna(value):\n        pce_data.append((year_str, value))\n\nprint(\"PCE data (first 10 and last 10):\")\nprint(\"First 10:\", pce_data[:10])\nprint(\"Last 10:\", pce_data[-10:])\nprint(f\"Total PCE entries: {len(pce_data)}\")\n\n# Extract PFI data (column 1 is Total PFI, starting from row 6 which is 1973)\npfi_data = []\nfor i in range(6, len(df_12_raw)):\n    year_str = str(df_12_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan':\n        continue\n    value = df_12_raw.iloc[i, 1]\n    if pd.notna(value):\n        pfi_data.append((year_str, value))\n\nprint(\"\\nPFI data (first 10 and last 10):\")\nprint(\"First 10:\", pfi_data[:10])\nprint(\"Last 10:\", pfi_data[-10:])\nprint(f\"Total PFI entries: {len(pfi_data)}\")\n\nprint(\"\\nCPI data (first 5 and last 5):\")\nprint(df_cpi.head())\nprint(df_cpi.tail())\n\nEOF\n"]
