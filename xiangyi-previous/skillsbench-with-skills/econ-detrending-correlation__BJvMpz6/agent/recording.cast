[75.540702, "i", "python3 << 'EOF'\nimport pandas as pd\n\ndf_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\n\nprint(\"Checking 2024 quarterly rows:\")\nfor i in range(68, 71):\n    year_str = str(df_10_raw.iloc[i, 0]).strip()\n    value = df_10_raw.iloc[i, 1]\n    print(f\"Row {i}: repr={repr(year_str)}, value={value}\")\n    print(f\"  Starts with '2024:': {year_str.startswith('2024:')}\")\n    print(f\"  Contains '2024': {'2024' in year_str}\")\n    print(f\"  First 6 chars: {repr(year_str[:6])}\")\n\nEOF\n"]
