[11.531989, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy import signal\nfrom scipy.stats import pearsonr\n\n# First, let's inspect the structure of the files\nprint(\"=== Inspecting ERP-2025-table10.xls (PCE) ===\")\nxl_file_10 = pd.ExcelFile('/root/ERP-2025-table10.xls')\nprint(\"Sheet names:\", xl_file_10.sheet_names)\ndf_10 = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0)\nprint(\"\\nFirst few rows:\")\nprint(df_10.head(10))\nprint(\"\\nShape:\", df_10.shape)\nprint(\"\\nColumn names:\")\nprint(df_10.columns.tolist())\n\nprint(\"\\n=== Inspecting ERP-2025-table12.xls (PFI) ===\")\nxl_file_12 = pd.ExcelFile('/root/ERP-2025-table12.xls')\nprint(\"Sheet names:\", xl_file_12.sheet_names)\ndf_12 = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0)\nprint(\"\\nFirst few rows:\")\nprint(df_12.head(10))\nprint(\"\\nShape:\", df_12.shape)\nprint(\"\\nColumn names:\")\nprint(df_12.columns.tolist())\n\nprint(\"\\n=== Inspecting CPI.xlsx ===\")\ndf_cpi = pd.read_excel('/root/CPI.xlsx', sheet_name=0)\nprint(\"\\nFirst few rows:\")\nprint(df_cpi.head(10))\nprint(\"\\nShape:\", df_cpi.shape)\nprint(\"\\nColumn names:\")\nprint(df_cpi.columns.tolist())\n\nEOF\n"]
