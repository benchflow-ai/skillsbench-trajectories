[68.297169, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Read the Excel files\ndf_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\ndf_12_raw = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0, engine='xlrd', header=None)\ndf_cpi = pd.read_excel('/root/CPI.xlsx', sheet_name=0)\n\n# Extract PCE annual data\npce_annual = {}\npce_2024_quarters = []\nfor i in range(5, len(df_10_raw)):\n    year_str = str(df_10_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str:\n        continue\n    value = df_10_raw.iloc[i, 1]\n    if pd.notna(value) and isinstance(value, (int, float)):\n        # Annual data: year followed by period\n        if year_str[-1] == '.':\n            try:\n                year = int(year_str[:-1])\n                pce_annual[year] = value\n            except:\n                pass\n        # 2024 quarterly data\n        elif year_str.startswith('2024:'):\n            pce_2024_quarters.append(value)\n\n# Extract PFI annual data\npfi_annual = {}\npfi_2024_quarters = []\nfor i in range(6, len(df_12_raw)):\n    year_str = str(df_12_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str:\n        continue\n    value = df_12_raw.iloc[i, 1]\n    if pd.notna(value) and isinstance(value, (int, float)):\n        # Annual data: year followed by period\n        if year_str[-1] == '.':\n            try:\n                year = int(year_str[:-1])\n                pfi_annual[year] = value\n            except:\n                pass\n        # 2024 quarterly data\n        elif year_str.startswith('2024:'):\n            pfi_2024_quarters.append(value)\n\nprint(\"PCE Annual data:\")\nprint(f\"Years: {sorted(pce_annual.keys())}\")\nprint(f\"Count: {len(pce_annual)}\")\nprint(f\"2024 Quarterly data: {pce_2024_quarters}\")\nprint(f\"2024 Average: {np.mean(pce_2024_quarters)}\")\n\nprint(\"\\nPFI Annual data:\")\nprint(f\"Years: {"]
[68.301138, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.stats import pearsonr\r\n\u001b[?2004l\r\u001b[?2004h> import warnings\r\n\u001b[?2004l\r\u001b[?2004h> warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read the Excel files\r\n\u001b[?2004l\r\u001b[?2004h> df_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\r\n\u001b[?2004l\r\u001b[?2004h> df_12_raw = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0, engine='xlrd', header=None)\r\n\u001b[?2004l\r\u001b[?2004h> df_cpi = pd.read_excel('/root/CPI.xlsx', sheet_name=0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract PCE annual data\r\n\u001b[?2004l\r\u001b[?2004h> pce_annual = {}\r\n\u001b[?2004l\r\u001b[?2004h> pce_2024_quarters = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(5, len(df_10_raw)):\r\n\u001b[?2004l\r\u001b[?2004h>     year_str = str(df_10_raw.iloc[i, 0]).strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     value = df_10_raw.iloc[i, 1]\r\n\u001b[?2004l\r\u001b[?2004h>     if pd.notna(value) and isinstance(value, (int, float)):\r\n\u001b[?2004l\r\u001b[?2004h>         # Annual data: year followed by period\r\n\u001b[?2004l\r\u001b[?2004h>         if year_str[-1] == '.':\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 year = int(year_str[:-1])\r\n\u001b[?2004l\r\u001b[?2004h>                 pce_annual[year] = value\r\n\u001b[?2004l\r\u001b[?2004h>             except:\r\n\u001b[?2004l\r\u001b[?2004h>                 pass\r\n\u001b[?2004l\r\u001b[?2004h>         # 2024 quarterly data\r\n\u001b[?2004l\r\u001b[?2004h>         elif year_str.startswith('2024:'):\r\n\u001b[?2004l\r\u001b[?2004h>             pce_2024_quarters.append(value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract PFI annual data\r\n\u001b[?2004l\r\u001b[?2004h> pfi_annual = {}\r\n\u001b[?2004l\r\u001b[?2004h> pfi_2024_quarters = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(6, len(df_12_raw)):\r\n\u001b[?2004l\r\u001b[?2004h>     year_str = str(df_12_raw.iloc[i, 0]).strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
