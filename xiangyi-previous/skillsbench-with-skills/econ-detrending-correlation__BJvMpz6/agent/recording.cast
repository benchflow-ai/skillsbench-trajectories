[19.910037, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\n# Let's read the raw Excel files to understand structure better\nprint(\"=== Reading raw ERP-2025-table10.xls ===\")\nwb10 = load_workbook('/root/ERP-2025-table10.xls')\nws10 = wb10.active\nprint(\"First 15 rows:\")\nfor i, row in enumerate(ws10.iter_rows(min_row=1, max_row=15, values_only=True), 1):\n    print(f\"Row {i}: {row}\")\n\nprint(\"\\n=== Reading raw ERP-2025-table12.xls ===\")\nwb12 = load_workbook('/root/ERP-2025-table12.xls')\nws12 = wb12.active\nprint(\"First 15 rows:\")\nfor i, row in enumerate(ws12.iter_rows(min_row=1, max_row=15, values_only=True), 1):\n    print(f\"Row {i}: {row}\")\n\nEOF\n"]
