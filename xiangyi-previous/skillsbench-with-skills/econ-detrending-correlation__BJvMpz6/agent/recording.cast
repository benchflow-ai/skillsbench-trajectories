[25.992649, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read with xlrd engine\nprint(\"=== Reading ERP-2025-table10.xls (PCE) ===\")\ndf_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\nprint(\"Shape:\", df_10_raw.shape)\nprint(\"\\nFirst 10 rows:\")\nfor i in range(10):\n    print(f\"Row {i}: {df_10_raw.iloc[i].tolist()}\")\n\nprint(\"\\n=== Reading ERP-2025-table12.xls (PFI) ===\")\ndf_12_raw = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0, engine='xlrd', header=None)\nprint(\"Shape:\", df_12_raw.shape)\nprint(\"\\nFirst 10 rows:\")\nfor i in range(10):\n    print(f\"Row {i}: {df_12_raw.iloc[i].tolist()}\")\n\nEOF\n"]
