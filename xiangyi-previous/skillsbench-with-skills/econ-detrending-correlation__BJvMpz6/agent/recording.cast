[124.952682, "o", "    D = np.zeros((T-2, T))\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.952709, "o", "> "]
[124.952781, "o", "    for i in range(T-2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.952831, "o", "        D[i, i] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.952882, "o", "        D[i, i+1] = -2\r\n\u001b[?2004l\r"]
[124.952928, "o", "\u001b[?2004h> "]
[124.952955, "o", "        D[i, i+2] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.953026, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.953094, "o", "> "]
[124.953142, "o", "    # Solve for trend: (I + lambda * D'D)^-1 * y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.95324, "o", "    trend = np.linalg.solve(I + lam * D.T @ D, y)\r\n\u001b[?2004l\r"]
[124.953285, "o", "\u001b[?2004h> "]
[124.953336, "o", "    return trend\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.953385, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.953434, "o", "# Apply HP filter with lambda=100\r\n\u001b[?2004l\r"]
[124.95346, "o", "\u001b[?2004h> lam = 100\r\n\u001b[?2004l\r"]
[124.95351, "o", "\u001b[?2004h> "]
[124.953575, "o", "y_pce = df_annual['log_PCE'].values\r\n\u001b[?2004l\r"]
[124.953631, "o", "\u001b[?2004h> "]
[124.953673, "o", "y_pfi = df_annual['log_PFI'].values\r\n\u001b[?2004l\r"]
[124.953731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.953796, "o", "trend_pce = hp_filter(y_pce, lam=lam)\r\n\u001b[?2004l\r"]
[124.953842, "o", "\u001b[?2004h> "]
[124.953905, "o", "trend_pfi = hp_filter(y_pfi, lam=lam)\r\n\u001b[?2004l\r"]
[124.953952, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.954025, "o", "# Extract cyclical components\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954079, "o", "> "]
[124.954129, "o", "cycle_pce = y_pce - trend_pce\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.954168, "o", "cycle_pfi = y_pfi - trend_pfi\r\n\u001b[?2004l\r"]
[124.954224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.954328, "o", "print(\"Cyclical components (first 5 and last 5):\")\r\n\u001b[?2004l\r"]
[124.954392, "o", "\u001b[?2004h> "]
[124.954485, "o", "print(f\"PCE cycle: {cycle_pce[:5]} ... {cycle_pce[-5:]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954535, "o", "> "]
[124.954633, "o", "print(f\"PFI cycle: {cycle_pfi[:5]} ... {cycle_pfi[-5:]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954687, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954715, "o", "> "]
[124.95474, "o", "# Calculate Pearson correlation\r\n\u001b[?2004l\r"]
[124.954828, "o", "\u001b[?2004h> "]
[124.954888, "o", "corr, pvalue = pearsonr(cycle_pce, cycle_pfi)\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954946, "o", "> "]
[124.955054, "o", "print(f\"\\nPearson correlation between detrended PCE and PFI: {corr}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955111, "o", "> "]
[124.955168, "o", "print(f\"P-value: {pvalue}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.955209, "o", "\u001b[?2004h> "]
[124.95526, "o", "# Round to 5 decimal places\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.955321, "o", "corr_rounded = round(corr, 5)\r\n\u001b[?2004l\r"]
[124.955379, "o", "\u001b[?2004h> "]
[124.955452, "o", "print(f\"\\nCorrelation rounded to 5 decimal places: {corr_rounded}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955507, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.95556, "o", "# Write to answer.txt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.955647, "o", "with open('/root/answer.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955703, "o", "> "]
[124.955744, "o", "    f.write(f\"{corr_rounded}\\n\")\r\n\u001b[?2004l\r"]
[124.955799, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955853, "o", "> "]
[124.955898, "o", "print(f\"\\nResult written to /root/answer.txt\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955923, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955988, "o", "> EOF\r\n\u001b[?2004l\r"]
