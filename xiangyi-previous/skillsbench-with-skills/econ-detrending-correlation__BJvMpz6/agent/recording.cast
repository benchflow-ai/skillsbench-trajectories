[111.760863, "o", "\u001b[?2004hroot@aaf04b4c4cb6:~# "]
[124.943349, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Read the Excel files\ndf_10_raw = pd.read_excel('/root/ERP-2025-table10.xls', sheet_name=0, engine='xlrd', header=None)\ndf_12_raw = pd.read_excel('/root/ERP-2025-table12.xls', sheet_name=0, engine='xlrd', header=None)\ndf_cpi = pd.read_excel('/root/CPI.xlsx', sheet_name=0)\n\ndef is_quarterly(year_str):\n    year_str = year_str.strip()\n    return year_str in ['I.', 'II.', 'III.', 'III p.', 'IV.']\n\n# Extract PCE and PFI annual data\npce_annual = {}\npce_2024_quarters = []\nin_2024_quarters = False\n\nfor i in range(5, len(df_10_raw)):\n    year_str = str(df_10_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str or 'Food' in year_str:\n        continue\n    value = df_10_raw.iloc[i, 1]\n    if pd.notna(value) and isinstance(value, (int, float)):\n        if '2024:' in year_str:\n            in_2024_quarters = True\n            pce_2024_quarters.append(value)\n        elif in_2024_quarters and is_quarterly(year_str):\n            pce_2024_quarters.append(value)\n        elif year_str[-1] == '.' and len(year_str) <= 5:\n            try:\n                year = int(year_str[:-1])\n                pce_annual[year] = value\n                in_2024_quarters = False\n            except:\n                pass\n\npfi_annual = {}\npfi_2024_quarters = []\nin_2024_quarters = False\n\nfor i in range(6, len(df_12_raw)):\n    year_str = str(df_12_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == 'nan' or 'Includes' in year_str or 'Source' in year_str or 'Research' in year_str:\n        continue\n    value = df_12_raw.iloc[i, 1]\n    if pd.notna(value) and isinstance(value, (int, float)):\n        if '2024:' in year_str:\n            in_2024_quarters = True\n            pfi_2024_quarters.append(value)\n        elif in_2024_quarters and is_quarterly(year_str):\n            pfi_2024_quarters.append(value)\n        elif year_str[-1] == '.' and len(year_str) <= 5:\n            try:\n                year = int(year_str[:-1])\n                pfi_annual[year] = value\n                in_2024_quarters = False\n            except:\n                pass\n\n# Create annual series\nyears = list(range(1973, 2024))\npce_values = [pce_annual[y] for y in years]\npfi_values = [pfi_annual[y] for y in years]\npce_values.append(np.mean(pce_2024_quarters))\npfi_values.append(np.mean(pfi_2024_quarters))\nyears.append(2024)\n\n# Create DataFrame\ndf_annual = pd.DataFrame({\n    'Year': years,\n    'PCE_nominal': pce_values,\n    'PFI_nominal': pfi_values\n})\n\ndf_annual = df_annual.merge(df_cpi, left_on='Year', right_on='Year', how='left')\n\n# Deflate and log\ndf_annual['PCE_real'] = df_annual['PCE_nominal'] / df_annual['CPI_2024']\ndf_annual['PFI_real'] = df_annual['PFI_nominal'] / df_annual['CPI_2024']\ndf_annual['log_PCE'] = np.log(df_annual['PCE_real'])\ndf_annual['log_PFI'] = np.log(df_annual['PFI_real'])\n\n# Implement Hodrick-Prescott filter\ndef hp_filter(y, lam=100):\n    \"\"\"\n    Hodrick-Prescott filter\n    y: time series (numpy array)\n    lam: smoothing parameter (lambda)\n    Returns: trend component\n    \"\"\"\n    T = len(y)\n    # Create the matrix for the HP filter\n    I = np.eye(T)\n    D = np.zeros((T-2, T))\n    for i in range(T-2):\n        D[i, i] = 1\n        D[i, i+1] = -2\n        D[i, i+2] = 1\n    \n    # Solve for trend: (I + lambda * D'D)^-1 * y\n    trend = np.linalg.solve(I + lam * D.T @ D, y)\n    return trend\n\n# Apply HP filter with lambda=100\nlam = 100\ny_pce = df_annual['log_PCE'].values\ny_pfi = df_annual['log_PFI'].values\n\ntrend_pce = hp_filter(y_pce, lam=lam)\ntrend_pfi = hp_filter(y_pfi, lam=lam)\n\n# Extract cyclical components\ncycle_pce = y_pce - trend_pce\ncycle_pfi = y_pfi - trend_pfi\n\nprint(\"Cyclical components (first 5 and last 5):\")\nprint(f\"PCE cycle: {cycle_pce[:5]} ... {cycle_pce[-5:]}\")\nprint(f\"PFI cycle: {cycle_pfi[:5]} ... {cycle_pfi[-5:]}\")\n\n# Calculate Pearson correlation\ncorr, pvalue = pearsonr(cycle_pce, cycle_pfi)\nprint(f\"\\nPearson correlation between detrended PCE and PFI: {corr}\")\nprint"]
[124.943522, "i", "(f\"P-value: {pvalue}\")\n\n# Round to 5 decimal places\ncorr_rounded = round(corr, 5)\nprint(f\"\\nCorrelation rounded to 5 decimal places: {corr_rounded}\")\n\n# Write to answer.txt\nwith open('/root/answer.txt', 'w') as f:\n    f.write(f\"{corr_rounded}\\n\")\n\nprint(f\"\\nResult written to /root/answer.txt\")\n\nEOF\n"]
