[77.591516, "o", "        D2[i, i+2] = 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591579, "o", "    # Solve for trend: (I + lambda*D2'*D2)^-1 * y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591684, "o", "    trend = np.linalg.solve(I + lamb * D2.T @ D2, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591745, "o", "    cycle = y - trend\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.591823, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     return trend, cycle\r\n\u001b[?2004l\r"]
