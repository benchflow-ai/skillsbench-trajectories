[77.591064, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591149, "o", "    n = len(y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591228, "o", "    # Create second difference matrix\r\n\u001b[?2004l\r\u001b[?2004h>     I = np.eye(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.591305, "o", "    D2 = np.zeros((n-2, n))\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n-2):\r\n\u001b[?2004l\r\u001b[?2004h"]
