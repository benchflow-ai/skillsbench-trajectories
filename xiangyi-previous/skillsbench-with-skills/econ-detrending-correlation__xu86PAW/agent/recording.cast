[99.219379, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read PFI data\ndf_pfi = pd.read_excel('ERP-2025-table12.xls', sheet_name=0, header=None)\nprint(\"Checking PFI row indices...\")\nprint(f\"Row 5 (year): {df_pfi.iloc[5, 0]}\")\nprint(f\"Row 6 (year): {df_pfi.iloc[6, 0]}\")\nprint(f\"Row 7 (year): {df_pfi.iloc[7, 0]}\")\nprint(f\"Row 57 (year): {df_pfi.iloc[57, 0]}\")\nprint(f\"Row 58 (year): {df_pfi.iloc[58, 0]}\")\nprint(f\"Row 69 label: {df_pfi.iloc[69, 0]}\")\nprint(f\"Row 70 label: {df_pfi.iloc[70, 0]}\")\nprint(f\"Row 71 label: {df_pfi.iloc[71, 0]}\")\n\n# Annual data from 1973 to 2023\npfi_annual = df_pfi.iloc[6:58, 1].values.astype(float)\nprint(f\"\\nPFI annual data length: {len(pfi_annual)}\")\nprint(f\"First year (1973): {pfi_annual[0]}\")\nprint(f\"Last year (2023): {pfi_annual[-1]}\")\n\n# 2024 quarterly data\npfi_2024_q = df_pfi.iloc[69:72, 1].values.astype(float)\nprint(f\"\\n2024 Q1-Q3: {pfi_2024_q}\")\npfi_2024 = np.mean(pfi_2024_q)\nprint(f\"2024 average: {pfi_2024}\")\n\npfi_nominal = np.append(pfi_annual, pfi_2024)\nprint(f\"\\nTotal PFI data points: {len(pfi_nominal)} (should be 52 for 1973-2024)\")\nEOF\n"]
[99.219658, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
