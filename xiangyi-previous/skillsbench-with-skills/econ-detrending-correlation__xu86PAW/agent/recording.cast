[145.156582, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\n\n# HP Filter implementation\ndef hp_filter(y, lamb=100):\n    n = len(y)\n    I = np.eye(n)\n    D2 = np.zeros((n-2, n))\n    for i in range(n-2):\n        D2[i, i] = 1\n        D2[i, i+1] = -2\n        D2[i, i+2] = 1\n    trend = np.linalg.solve(I + lamb * D2.T @ D2, y)\n    cycle = y - trend\n    return trend, cycle\n\n# 1. Extract PCE data\ndf_pce = pd.read_excel('ERP-2025-table10.xls', sheet_name=0, header=None)\npce_annual = df_pce.iloc[5:56, 1].values.astype(float)  # 1973-2023\npce_2024_q = df_pce.iloc[68:71, 1].values.astype(float)  # 2024 Q1-Q3\npce_2024 = np.mean(pce_2024_q)\npce_nominal = np.append(pce_annual, pce_2024)\n\n# 2. Extract PFI data\ndf_pfi = pd.read_excel('ERP-2025-table12.xls', sheet_name=0, header=None)\npfi_annual = df_pfi.iloc[6:57, 1].values.astype(float)  # 1973-2023\npfi_2024_q = df_pfi.iloc[69:72, 1].values.astype(float)  # 2024 Q1-Q3\npfi_2024 = np.mean(pfi_2024_q)\npfi_nominal = np.append(pfi_annual, pfi_2024)\n\n# 3. Extract CPI data\ndf_cpi = pd.read_excel('CPI.xlsx', sheet_name=0, header=None)\ncpi = df_cpi.iloc[1:53, 1].values.astype(float)  # 1973-2024\n\nprint(f\"PCE data points: {len(pce_nominal)}\")\nprint(f\"PFI data points: {len(pfi_nominal)}\")\nprint(f\"CPI data points: {len(cpi)}\")\nprint(f\"\\nPCE 1973: {pce_nominal[0]}, 2024: {pce_nominal[-1]}\")\nprint(f\"PFI 1973: {pfi_nominal[0]}, 2024: {pfi_nominal[-1]}\")\nprint(f\"CPI 1973: {cpi[0]}, 2024: {cpi[-1]}\")\n\n# 4. Deflate to real values\npce_real = pce_nominal / cpi\npfi_real = pfi_nominal / cpi\n\nprint(f\"\\nPCE real 1973: {pce_real[0]}, 2024: {pce_real[-1]}\")\nprint(f\"PFI real 1973: {pfi_real[0]}, 2024: {pfi_real[-1]}\")\n\n# 5. Take natural log\npce_log = np.log(pce_real)\npfi_log = np.log(pfi_real)\n\n# 6. Apply HP filter\npce_trend, pce_cycle = hp_filter(pce_log, lamb=100)\npfi_trend, pfi_cycle = hp_filter(pfi_log, lamb=100)\n\nprint(f\"\\nPCE cycle range: [{pce_cycle.min():.6f}, {pce_cycle.max():.6f}]\")\nprint(f\"PFI cycle range: [{pfi_cycle.min():.6f}, {pfi_cycle.max():.6f}]\")\n\n# 7. Calculate Pearson correlation\ncorrelation, p_value = pearsonr(pce_cycle, pfi_cycle)\n\nprint(f\"\\nPearson correlation: {correlation}\")\nprint(f\"P-value: {p_value}\")\n\n# 8. Write to answer.txt (rounded to 5 decimal places)\nwith open('/root/answer.txt', 'w') as f:\n    f.write(f\"{correlation:.5f}\\n\")\n\nprint(f\"\\nResult written to answer.txt: {correlation:.5f}\")\nEOF\n"]
