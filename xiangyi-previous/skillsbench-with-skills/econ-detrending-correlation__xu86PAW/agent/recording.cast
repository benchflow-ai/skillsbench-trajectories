[109.984667, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Check exact structure\ndf_pce = pd.read_excel('ERP-2025-table10.xls', sheet_name=0, header=None)\ndf_pfi = pd.read_excel('ERP-2025-table12.xls', sheet_name=0, header=None)\n\nprint(\"PCE years:\")\nfor i in range(5, 60):\n    year_val = df_pce.iloc[i, 0]\n    if pd.notna(year_val) and isinstance(year_val, (int, float)):\n        print(f\"Row {i}: {year_val}\")\n    elif pd.notna(year_val) and ':' in str(year_val):\n        print(f\"Row {i}: {year_val} (quarterly)\")\n        \nprint(\"\\nPFI years:\")\nfor i in range(6, 60):\n    year_val = df_pfi.iloc[i, 0]\n    if pd.notna(year_val) and isinstance(year_val, (int, float)):\n        print(f\"Row {i}: {year_val}\")\n    elif pd.notna(year_val) and ':' in str(year_val):\n        print(f\"Row {i}: {year_val} (quarterly)\")\n        break\nEOF\n"]
