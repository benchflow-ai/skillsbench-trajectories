[?2004hroot@41c56d1c1f66:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.stats import pearsonr
[?2004l[?2004h> 
[?2004l[?2004h> # HP Filter implementation
[?2004l[?2004h> def hp_filter(y, lamb=100):
[?2004l[?2004h>     n = len(y)
[?2004l[?2004h>     I = np.eye(n)
[?2004l[?2004h>     D2 = np.zeros((n-2, n))
[?2004l[?2004h>     for i in range(n-2):
[?2004l[?2004h>         D2[i, i] = 1
[?2004l[?2004h>         D2[i, i+1] = -2
[?2004l[?2004h>         D2[i, i+2] = 1
[?2004l[?2004h>     trend = np.linalg.solve(I + lamb * D2.T @ D2, y)
[?2004l[?2004h>     cycle = y - trend
[?2004l[?2004h>     return trend, cycle
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Extract PCE data
[?2004l[?2004h> df_pce = pd.read_excel('ERP-2025-table10.xls', sheet_name=0, header=None)
[?2004l[?2004h> pce_annual = df_pce.iloc[5:56, 1].values.astype(float)  # 1973-2023
[?2004l[?2004h> pce_2024_q = df_pce.iloc[68:71, 1].values.astype(float)  # 2024 Q1-Q3
[?2004l[?2004h> pce_2024 = np.mean(pce_2024_q)
[?2004l[?2004h> pce_nominal = np.append(pce_annual, pce_2024)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Extract PFI data
[?2004l[?2004h> df_pfi = pd.read_excel('ERP-2025-table12.xls', sheet_name=0, header=None)
[?2004l[?2004h> pfi_annual = df_pfi.iloc[6:57, 1].values.astype(float)  # 1973-2023
[?2004l[?2004h> pfi_2024_q = df_pfi.iloc[69:72, 1].values.astype(float)  # 2024 Q1-Q3
[?2004l[?2004h> pfi_2024 = np.mean(pfi_2024_q)
[?2004l[?2004h> pfi_nominal = np.append(pfi_annual, pfi_2024)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Extract CPI data
[?2004l[?2004h> df_cpi = pd.read_excel('CPI.xlsx', sheet_name=0, header=None)
[?2004l[?2004h> cpi = df_cpi.iloc[1:53, 1].values.astype(float)  # 1973-2024
[?2004l[?2004h> 
[?2004l[?2004h> print(f"PCE data points: {len(pce_nominal)}")
[?2004l[?2004h> print(f"PFI data points: {len(pfi_nominal)}")
[?2004l[?2004h> print(f"CPI data points: {len(cpi)}")
[?2004l[?2004h> print(f"\nPCE 1973: {pce_nominal[0]}, 2024: {pce_nominal[-1]}")
[?2004l[?2004h> print(f"PFI 1973: {pfi_nominal[0]}, 2024: {pfi_nominal[-1]}")
[?2004l[?2004h> print(f"CPI 1973: {cpi[0]}, 2024: {cpi[-1]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Deflate to real values
[?2004l[?2004h> pce_real = pce_nominal / cpi
[?2004l[?2004h> pfi_real = pfi_nominal / cpi
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nPCE real 1973: {pce_real[0]}, 2024: {pce_real[-1]}")
[?2004l[?2004h> print(f"PFI real 1973: {pfi_real[0]}, 2024: {pfi_real[-1]}")
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Take natural log
[?2004l[?2004h> pce_log = np.log(pce_real)
[?2004l[?2004h> pfi_log = np.log(pfi_real)
[?2004l[?2004h> 
[?2004l[?2004h> # 6. Apply HP filter
[?2004l[?2004h> pce_trend, pce_cycle = hp_filter(pce_log, lamb=100)
[?2004l[?2004h> pfi_trend, pfi_cycle = hp_filter(pfi_log, lamb=100)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nPCE cycle range: [{pce_cycle.min():.6f}, {pce_cycle.max():.6f}]")
[?2004l[?2004h> print(f"PFI cycle range: [{pfi_cycle.min():.6f}, {pfi_cycle.max():.6f}]")
[?2004l[?2004h> 
[?2004l[?2004h> # 7. Calculate Pearson correlation
[?2004l[?2004h> correlation, p_value = pearsonr(pce_cycle, pfi_cycle)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nPearson correlation: {correlation}")
[?2004l[?2004h> print(f"P-value: {p_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # 8. Write to answer.txt (rounded to 5 decimal places)
[?2004l[?2004h> with open('/root/answer.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{correlation:.5f}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nResult written to answer.txt: {correlation:.5f}")
