[?2004hroot@41c56d1c1f66:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> 
[?2004l[?2004h> # Function to implement HP filter
[?2004l[?2004h> def hp_filter(y, lamb=100):
[?2004l[?2004h>     """
[?2004l[?2004h>     Hodrick-Prescott filter
[?2004l[?2004h>     y: time series data
[?2004l[?2004h>     lamb: smoothing parameter (100 for annual data)
[?2004l[?2004h>     Returns: trend, cycle
[?2004l[?2004h>     """
[?2004l[?2004h>     n = len(y)
[?2004l[?2004h>     # Create second difference matrix
[?2004l[?2004h>     I = np.eye(n)
[?2004l[?2004h>     D2 = np.zeros((n-2, n))
[?2004l[?2004h>     for i in range(n-2):
[?2004l[?2004h>         D2[i, i] = 1
[?2004l[?2004h>         D2[i, i+1] = -2
[?2004l[?2004h>         D2[i, i+2] = 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve for trend: (I + lambda*D2'*D2)^-1 * y
[?2004l[?2004h>     trend = np.linalg.solve(I + lamb * D2.T @ D2, y)
[?2004l[?2004h>     cycle = y - trend
[?2004l[?2004h>     
[?2004l[?2004h>     return trend, cycle
[?2004l[?2004h> 
[?2004l[?2004h> # Read PCE data
[?2004l[?2004h> df_pce = pd.read_excel('ERP-2025-table10.xls', sheet_name=0, header=None)
[?2004l[?2004h> # Annual data from 1973 (row 6, index 6) to 2023 (row 57, index 57)
[?2004l[?2004h> pce_annual = df_pce.iloc[6:58, 1].values.astype(float)
[?2004l[?2004h> # 2024 quarterly data (rows 68, 69, 70)
[?2004l[?2004h> pce_2024_q = df_pce.iloc[68:71, 1].values.astype(float)
[?2004l[?2004h> pce_2024 = np.mean(pce_2024_q)
[?2004l[?2004h> pce_nominal = np.append(pce_annual, pce_2024)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"PCE data points: {len(pce_nominal)}")
[?2004l[?2004h> print(f"PCE 1973: {pce_nominal[0]}")
[?2004l[?2004h> print(f"PCE 2023: {pce_nominal[-2]}")
[?2004l[?2004h> print(f"PCE 2024 (avg of Q1-Q3): {pce_2024}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004lPCE data points: 53
PCE 1973: 930.2
PCE 2023: 16016.3
PCE 2024 (avg of Q1-Q3): 19678.566666666666
[?2004hroot@41c56d1c1f66:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Read PCE data
[?2004l[?2004h> df_pce = pd.read_excel('ERP-2025-table10.xls', sheet_name=0, header=None)
[?2004l[?2004h> print("Checking PCE row indices...")
[?2004l[?2004h> print(f"Row 5 (year): {df_pce.iloc[5, 0]}")
[?2004l[?2004h> print(f"Row 6 (year): {df_pce.iloc[6, 0]}")
[?2004l[?2004h> print(f"Row 57 (year): {df_pce.iloc[57, 0]}")
