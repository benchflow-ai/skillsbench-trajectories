[40.070662, "i", "python3 << 'EOF'\ntry:\n    import pdfrw\n    template = pdfrw.PdfReader('/root/sc100-blank.pdf')\n    print(f\"Pages in PDF: {len(template.pages)}\")\n    if template.Root.AcroForm:\n        fields = pdfrw.PdfArray(template.Root.AcroForm.Fields)\n        print(f\"Form fields: {len(fields)}\")\n        for i, field in enumerate(fields[:20]):\n            if hasattr(field, 'T'):\n                print(f\"Field {i}: {field.T}\")\nexcept Exception as e:\n    print(f\"pdfrw error: {e}\")\nEOF\n"]
