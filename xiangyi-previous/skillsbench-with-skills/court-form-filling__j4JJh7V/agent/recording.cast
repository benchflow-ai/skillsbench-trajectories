[72.810271, "o", "# Fill in the fields"]
[72.810353, "o", "\r\n"]
[72.810433, "o", "\u001b[?2004l\r"]
[72.810542, "o", "\u001b[?2004h"]
[72.810634, "o", "> "]
[72.810808, "o", "for page_num in range(len(doc)):"]
[72.810892, "o", "\r\n"]
[72.810974, "o", "\u001b[?2004l\r"]
[72.811079, "o", "\u001b[?2004h"]
[72.811176, "o", "> "]
[72.811327, "o", "    page = doc[page_num]"]
[72.811409, "o", "\r\n"]
[72.81149, "o", "\u001b[?2004l\r"]
[72.811597, "o", "\u001b[?2004h"]
[72.811689, "o", "> "]
[72.811995, "o", "    for widget in page.widgets():"]
[72.812131, "o", "\r\n"]
[72.812225, "o", "\u001b[?2004l\r"]
[72.812338, "o", "\u001b[?2004h"]
[72.812434, "o", "> "]
[72.812638, "o", "        field_name = widget.field_name"]
[72.812722, "o", "\r\n"]
[72.812808, "o", "\u001b[?2004l\r"]
[72.812911, "o", "\u001b[?2004h"]
[72.813001, "o", "> "]
[72.813214, "o", "        if field_name in field_data:"]
[72.813318, "o", "\r\n\u001b[?2004l\r"]
[72.813426, "o", "\u001b[?2004h> "]
[72.813603, "o", "            widget.field_value = field_data[field_name]\r\n\u001b[?2004l\r"]
[72.813725, "o", "\u001b[?2004h"]
[72.813823, "o", "> "]
[72.813899, "o", "            widget.update()\r\n\u001b[?2004l\r"]
[72.813999, "o", "\u001b[?2004h> "]
[72.814221, "o", "            print(f\"Filled: {field_name} = {field_data[field_name]}\")\r\n\u001b[?2004l\r"]
[72.814364, "o", "\u001b[?2004h"]
[72.814446, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.814544, "o", "# Save the filled PDF\r\n\u001b[?2004l\r"]
[72.814653, "o", "\u001b[?2004h> "]
[72.814797, "o", "doc.save('/root/sc100-filled.pdf')\r\n\u001b[?2004l\r"]
[72.814905, "o", "\u001b[?2004h> "]
