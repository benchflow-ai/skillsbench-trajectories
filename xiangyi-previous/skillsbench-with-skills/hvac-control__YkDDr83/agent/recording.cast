[112.125523, "o", "\u001b[?2004h> # Control parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.125722, "o", "control_duration = 160.0  # Run for 160 seconds (>150s required)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.125836, "o", "steps = int(control_duration / dt)\r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h"]
[112.125921, "o", "> "]
[112.125977, "o", "# PI controller state\r\n\u001b[?2004l\rk\u001b[?2004h> integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.12604, "o", "prev_error = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.126092, "o", "> \r\n\u001b[?2004l\rR\u001b[?2004h> "]
[112.126185, "o", "# Anti-windup limits\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[112.126394, "o", "integral_max = 100.0 / Ki if Ki > 0 else 1000.0  # Limit integral to max output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.126494, "o", "integral_min = -integral_max\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.126581, "o", "f\u001b[?2004h> # Data logging\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.126647, "o", "data = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[112.126679, "o", "# Control loop\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.126766, "o", "for i in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.126902, "o", "    # Get current time (before this step)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.126981, "o", "    current_time = i * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.12706, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.127212, "o", "    # Use the measured temperature from previous step or initial\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.127249, "o", "    if i == 0:\r\n\u001b[?2004l\r"]
[112.12728, "o", "\u001b[?2004h> "]
[112.127388, "o", "        measured_temp = initial_temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.127419, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.127509, "o", "> "]
[112.12763, "o", "        measured_temp = data[-1][\"temperature\"]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.127683, "o", "    # Calculate error\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.127734, "o", "> "]
[112.127809, "o", "    error = setpoint - measured_temp\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.127851, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.127953, "o", "    # PI controller with anti-windup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128022, "o", "    # Proportional term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128095, "o", "    P = Kp * error\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128157, "o", "    # Integral term with anti-windup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128217, "o", "    integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.1283, "o", "    integral = np.clip(integral, integral_min, integral_max)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128349, "o", "    I = Ki * integral\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128416, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128483, "o", "    # Derivative term (on error)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128549, "o", "    if i > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128615, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[112.128686, "o", "\u001b[?2004h>         derivative = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.128745, "o", ">     D = Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128797, "o", "    prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.12885, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128901, "o", "    # Calculate control output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.128971, "o", "    heater_power = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.12904, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Clamp to valid range\r\n\u001b[?2004l\r"]
[112.129112, "o", "\u001b[?2004h> "]
[112.129186, "o", "    heater_power = np.clip(heater_power, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129245, "o", "    # Apply control and get result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129296, "o", "    result = sim.step(heater_power)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129347, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129417, "o", "    # Log data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.12949, "o", "    data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129554, "o", "        \"time\": result[\"time\"],\r\n\u001b[?2004l\r\u001b[?2004h>         \"temperature\": result[\"temperature\"],\r\n\u001b[?2004l\r"]
[112.129634, "o", "\u001b[?2004h> "]
[112.129704, "o", "        \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129756, "o", "        \"heater_power\": result[\"heater_power\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129833, "o", "        \"error\": round(setpoint - result[\"temperature\"], 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.129891, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.12996, "o", "    # Print progress every 20 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.13001, "o", "    if i % 40 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130234, "o", "        print(f\"t={result['time']:.1f}s: T={result['temperature']:.2f}C, error={error:.2f}C, P={heater_power:.1f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.13029, "o", "# Save control log\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130341, "o", "control_log = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.13039, "o", "    \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130439, "o", "    \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130489, "o", "    \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[112.130549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130616, "o", "with open(\"control_log.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.130689, "o", "    json.dump(control_log, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.130743, "o", "\u001b[?2004h> "]
[112.130846, "o", "print(f\"\\nControl complete. Saved {len(data)} data points to control_log.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.1309, "o", "\u001b[?2004h> # Calculate metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.130949, "o", "> "]
[112.131005, "o", "temps = np.array([d[\"temperature\"] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131084, "o", "times = np.array([d[\"time\"] for d in data])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131136, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Max temperature\r\n\u001b[?2004l\r"]
[112.131193, "o", "\u001b[?2004h> max_temp = np.max(temps)\r\n\u001b[?2004l\r"]
[112.131244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131366, "o", "# Rise time: time to first reach 90% of the way from initial to setpoint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131493, "o", "rise_target = initial_temp + 0.9 * (setpoint - initial_temp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131544, "o", "rise_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131599, "o", "for i, t in enumerate(temps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.13165, "o", "    if t >= rise_target:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131699, "o", "        rise_time = times[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131749, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.131798, "o", "\u001b[?2004h> "]
[112.131889, "o", "# Overshoot: (max_temp - setpoint) / (setpoint - initial_temp) * 100%\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.131942, "o", "if max_temp > setpoint:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.131993, "o", "> "]
[112.132056, "o", "    overshoot = (max_temp - setpoint) / (setpoint - initial_temp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132109, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132159, "o", "    overshoot = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132291, "o", "# Settling time: time after which temperature stays within 2% of setpoint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132424, "o", "settling_band = 0.02 * abs(setpoint - initial_temp)  # 2% of step size = 0.08C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132535, "o", "# Use a larger band for practical purposes (0.5C as per spec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132615, "o", "settling_band = 0.5  # Use the spec requirement\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[112.132666, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.132717, "o", "settling_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132808, "o", "# Find the last time the temperature was outside the settling band\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132884, "o", "for i in range(len(temps) - 1, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.132968, "o", "    if abs(temps[i] - setpoint) > settling_band:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.133018, "o", "> "]
[112.133056, "o", "        if i < len(temps) - 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133111, "o", "            settling_time = times[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.133163, "o", ">         break\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.133211, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133273, "o", "    settling_time = times[0]  # Always within band\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.133296, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133374, "o", "# If never settled, use the full duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.133397, "o", "> "]
[112.133432, "o", "if settling_time is None:\r\n\u001b[?2004l\r"]
[112.133502, "o", "\u001b[?2004h> "]
[112.133552, "o", "    settling_time = times[-1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133658, "o", "# Steady-state error: average error in last 20 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133707, "o", "last_20s_mask = times >= (times[-1] - 20.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.13376, "o", "> "]
[112.13381, "o", "steady_state_temps = temps[last_20s_mask]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.133897, "o", "steady_state_error = abs(np.mean(steady_state_temps) - setpoint)\r\n\u001b[?2004l\r"]
[112.133944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.133998, "o", "\u001b[?2004h> "]
[112.134049, "o", "print(f\"\\nPerformance Metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.13414, "o", "print(f\"  Rise time (90%): {rise_time:.1f}s\" if rise_time else \"  Rise time: N/A\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134247, "o", "print(f\"  Overshoot: {overshoot*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134356, "o", "print(f\"  Settling time (within 0.5C): {settling_time:.1f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134455, "o", "print(f\"  Steady-state error: {steady_state_error:.3f}C\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.134478, "o", "> "]
[112.134641, "o", "print(f\"  Max temperature: {max_temp:.2f}C\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134699, "o", "metrics = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134746, "o", "    \"rise_time\": round(rise_time, 2) if rise_time else None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.134798, "o", "> "]
[112.134842, "o", "    \"overshoot\": round(overshoot, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.134909, "o", "    \"settling_time\": round(settling_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.134959, "o", "> "]
[112.13501, "o", "    \"steady_state_error\": round(steady_state_error, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.135054, "o", "> "]
[112.135143, "o", "    \"max_temp\": round(max_temp, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.135208, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.135251, "o", "with open(\"metrics.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.135297, "o", "    json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[112.135344, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.135398, "o", "print(f\"\\nSaved to metrics.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.135449, "o", "\u001b[?2004h> # Check against requirements\r\n\u001b[?2004l\r"]
[112.135498, "o", "\u001b[?2004h> "]
[112.135546, "o", "print(f\"\\nRequirements check:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.135704, "o", "print(f\"  Steady-state error < 0.5C: {'PASS' if steady_state_error < 0.5 else 'FAIL'} ({steady_state_error:.3f}C)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.135867, "o", "print(f\"  Settling time < 120s: {'PASS' if settling_time < 120 else 'FAIL'} ({settling_time:.1f}s)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.135912, "o", "> "]
[112.136024, "o", "print(f\"  Overshoot < 10%: {'PASS' if overshoot < 0.10 else 'FAIL'} ({overshoot*100:.2f}%)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.136068, "o", "> "]
[112.136184, "o", "print(f\"  Control duration >= 150s: {'PASS' if times[-1] >= 150 else 'FAIL'} ({times[-1]:.1f}s)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.13623, "o", "> "]
[112.136338, "o", "print(f\"  Max temperature < 30C: {'PASS' if max_temp < 30 else 'FAIL'} ({max_temp:.2f}C)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.136383, "o", "> EOF\r\n\u001b[?2004l\r"]
[112.13756, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[112.667187, "i", "python3 run_control.py\n"]
[112.667537, "o", "python3 run_control.py\r\n\u001b[?2004l\r"]
[113.104501, "o", "Controller gains: Kp=13.4116, Ki=0.3172, Kd=0.0\r\n"]
[113.105134, "o", "Setpoint: 22.0C\r\nTimestep: 0.5s\r\nInitial temperature: 18.13C\r\nt=0.5s: T=18.00C, error=3.87C, P=52.5%\r\n"]
[113.107853, "o", "t=20.5s: T=20.08C, error=1.77C, P=41.4%\r\nt=40.5s: T=21.18C, error=0.70C, P=35.0%\r\n"]
[113.1094, "o", "t=60.5s: T=21.52C, error=0.35C, P=34.2%\r\n"]
[113.11068, "o", "t=80.5s: T=21.76C, error=0.19C, P=33.7%\r\n"]
[113.111678, "o", "t=100.5s: T=21.82C, error=0.16C, P=34.3%\r\n"]
[113.11264, "o", "t=120.5s: T=22.06C, error=0.07C, P=33.6%\r\n"]
[113.113587, "o", "t=140.5s: T=21.98C, error=0.06C, P=33.7%\r\n"]
[113.117208, "o", "\r\nControl complete. Saved 320 data points to control_log.json\r\n"]
[113.117434, "o", "\r\nPerformance Metrics:\r\n  Rise time (90%): 56.0s\r\n"]
[113.117503, "o", "  Overshoot: 5.58%\r\n  Settling time (within 0.5C): 58.5s\r\n  Steady-state error: 0.031C\r\n  Max temperature: 22.22C\r\n"]
[113.117691, "o", "\r\nSaved to metrics.json\r\n\r\nRequirements check:\r\n  Steady-state error < 0.5C: PASS (0.031C)\r\n  Settling time < 120s: PASS (58.5s)\r\n  Overshoot < 10%: PASS (5.58%)\r\n  Control duration >= 150s: PASS (160.0s)\r\n  Max temperature < 30C: PASS (22.22C)\r\n"]
[113.137989, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[124.534717, "i", "echo '=== calibration_log.json ===' && head -20 calibration_log.json\n"]
[124.535121, "o", "echo '=== calibration_log.json ===' && head -20 calibration_log.json\r\n\u001b[?2004l\r"]
[124.535189, "o", "=== calibration_log.json ===\r\n"]
[124.536534, "o", "{\r\n  \"phase\": \"calibration\",\r\n  \"heater_power_test\": 50.0,\r\n  \"data\": [\r\n    {\r\n      \"time\": 0.0,\r\n      \"temperature\": 17.8757,\r\n"]
[124.53662, "o", "      \"heater_power\": 0.0\r\n    },\r\n    {\r\n      \"time\": 0.5,\r\n      \"temperature\": 18.1133,\r\n      \"heater_power\": 50.0\r\n    },\r\n    {\r\n      \"time\": 1.0,\r\n      \"temperature\": 18.138,\r\n"]
[124.536665, "o", "      \"heater_power\": 50.0\r\n    },\r\n    {\r\n"]
[124.536832, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[125.003072, "i", "echo '=== estimated_params.json ===' && cat estimated_params.json\n"]
[125.003491, "o", "echo '=== estimated_params.json ===' && cat estimated_params.json\r\n\u001b[?2004l\r"]
[125.003604, "o", "=== estimated_params.json ===\r\n"]
[125.00442, "o", "{\r\n  \"K\": 0.1261,\r\n  \"tau\": 42.28,\r\n  \"r_squared\": 0.9917,\r\n  \"fitting_error\": 0.0919\r\n}"]
[125.004564, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[125.48151, "i", "echo '=== tuned_gains.json ===' && cat tuned_gains.json\n"]
[125.481842, "o", "echo '=== tuned_gains.json ===' && cat tuned_gains.json\r\n\u001b[?2004l\r"]
[125.48192, "o", "=== tuned_gains.json ===\r\n"]
[125.482659, "o", "{"]
[125.482803, "o", "\r\n"]
[125.482943, "o", "  \"Kp\": 13.4116,\r\n  \"Ki\": 0.3172,\r\n  \"Kd\": 0.0,\r\n  \"lambda\": 25.0\r\n}\u001b[?2004hroot@e10a2078de3f:~# "]
[126.003212, "i", "echo '=== control_log.json (first 20 lines) ===' && head -20 control_log.json\n"]
[126.003739, "o", "echo '=== control_log.json (first 20 lines) ===' && head -20 control_log.json\r\n"]
[126.003832, "o", "\u001b[?2004l\r=== control_log.json (first 20 lines) ===\r\n"]
