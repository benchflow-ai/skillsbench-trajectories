[53.233273, "o", "    with open(\"estimated_params.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233344, "o", "        json.dump(params, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.233414, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233484, "o", "    print(f\"\\nSaved to estimated_params.json\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[53.233542, "o", "\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233609, "o", "    print(f\"Curve fitting failed: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.233644, "o", "> "]
[53.233727, "o", "    # Fallback: manual estimation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233807, "o", "    # Use the 63.2% method for tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233874, "o", "    T_final = np.mean(temps[-10:])  # Average of last 10 points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.233947, "o", "    T_63 = T_initial + 0.632 * (T_final - T_initial)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234009, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234072, "o", "    # Find time when temp crosses T_63\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234135, "o", "    for i, t in enumerate(temps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234203, "o", "        if t >= T_63:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234279, "o", "            tau_est = times[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234335, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234399, "o", "        tau_est = 40.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234499, "o", "    # Estimate K from final temperature (not yet at steady state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.23455, "o", "> "]
[53.234623, "o", "    # Extrapolate: T_ss = T_ambient + K*u\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234692, "o", "    # At t=35s, we're at about (1 - exp(-35/tau)) of the way there\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234771, "o", "    fraction = 1 - np.exp(-35.0 / tau_est)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.234947, "o", "    T_ss_est = T_initial + (T_final - T_initial) / fraction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.235031, "o", "    K_est = (T_ss_est - T_ambient) / test_power\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.235094, "o", "    print(f\"\\nManual estimation:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.235159, "o", "    print(f\"  K: {K_est:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.235224, "o", "    print(f\"  tau: {tau_est:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[53.23624, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[53.733438, "i", "python3 estimate_params.py\n"]
[53.733622, "o", "python3 estimate_params.py\r\n\u001b[?2004l\r"]
[54.681792, "o", "Calibration data: 70 points\r\nInitial temperature: 17.88C\r\nTest heater power: 50.0%\r\nFinal temperature: 21.51C\r\n"]
[54.684701, "o", "\r\nEstimated parameters:\r\n  K (process gain): 0.1261 C/%\r\n  tau (time constant): 42.28 s\r\n  R-squared: 0.9917\r\n  Fitting error (RMSE): 0.0919 C\r\n\r\nPredicted steady-state at 100% power: 30.61C\r\nPredicted steady-state at 50% power: 24.31C\r\n"]
[54.684877, "o", "\r\nSaved to estimated_params.json\r\n"]
[54.729952, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[78.178633, "i", "cat > calculate_gains.py << 'EOF'\n#!/usr/bin/env python3\nimport json\n\n# Load estimated parameters\nwith open(\"estimated_params.json\", \"r\") as f:\n    params = json.load(f)\n\nK = params[\"K\"]\ntau = params[\"tau\"]\n\nprint(f\"System parameters:\")\nprint(f\"  K = {K} C/%\")\nprint(f\"  tau = {tau} s\")\n\n# Target specifications:\n# - Steady-state error < 0.5C\n# - Settling time < 120s\n# - Overshoot < 10%\n# - Max temperature < 30C\n\n# Using Lambda (IMC) tuning for PI controller\n# For first-order system: G(s) = K / (tau*s + 1)\n# PI controller: C(s) = Kp * (1 + 1/(Ti*s))\n#\n# Lambda tuning (aggressive for faster response):\n# Kp = tau / (K * lambda)\n# Ti = tau\n# Ki = Kp / Ti = 1 / (K * lambda)\n#\n# Closed-loop time constant = lambda\n# For settling time (4*lambda) < 120s, we need lambda < 30s\n# But we also need to avoid overshoot, so we'll be more conservative\n\n# Choose lambda = tau for moderate response (no overshoot)\n# But this gives settling time ~ 4*tau = 169s, too slow\n# \n# For faster response with minimal overshoot, use lambda = tau/2\n# This gives settling time ~ 4*lambda = 2*tau = 84s\n\n# Let's use lambda slightly larger than tau/2 to ensure low overshoot\nlambda_cl = 25.0  # Closed-loop time constant\n\n# Calculate PI gains\nKp = tau / (K * lambda_cl)\nTi = tau  # Integral time = process time constant\nKi = Kp / Ti  # = 1 / (K * lambda)\n\n# Add small derivative for smoother response (optional)\nKd = 0.0  # Keep it simple with PI\n\nprint(f\"\\nLambda tuning with lambda = {lambda_cl}s:\")\nprint(f\"  Kp = {Kp:.4f}\")\nprint(f\"  Ki = {Ki:.4f}\")\nprint(f\"  Kd = {Kd:.4f}\")\nprint(f\"  Ti (integral time) = {Ti:.2f}s\")\n\n# Expected closed-loop performance:\nprint(f\"\\nExpected performance:\")\nprint(f\"  Closed-loop time constant: {lambda_cl}s\")\nprint(f\"  Approximate settling time (4*lambda): {4*lambda_cl}s\")\nprint(f\"  Expected overshoot: minimal (IMC tuning)\")\n\n# Verify: at setpoint 22C from ambient 18C, what heater power needed?\n# Steady-state: T = T_ambient + K * u\n# 22 = 18 + 0.1261 * u => u = 4 / 0.1261 = 31.7%\nu_ss = (22.0 - 18.0) / K\nprint(f\"\\nSteady-state heater power for 22C: {u_ss:.1f}%\")\n\n# Save tuned gains\ngains = {\n    \"Kp\": round(Kp, 4),\n    \"Ki\": round(Ki, 4),\n    \"Kd\": round(Kd, 4),\n    \"lambda\": round(lambda_cl, 2)\n}\n\nwith open(\"tuned_gains.json\", \"w\") as f:\n    json.dump(gains, f, indent=2)\n\nprint(f\"\\nSaved to tuned_gains.json\")\nEOF\n"]
[78.178924, "o", "cat > calculate_gains.py << 'EOF'\r\n\u001b[?2004l\r"]
[78.178957, "o", "\u001b[?2004h> "]
[78.179096, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load estimated parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179188, "o", "with open(\"estimated_params.json\", \"r\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179257, "o", "    params = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179296, "o", "K = params[\"K\"]\r\n\u001b[?2004l\r"]
[78.179331, "o", "\u001b[?2004h> "]
[78.179364, "o", "tau = params[\"tau\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.179397, "o", "> "]
[78.179434, "o", "print(f\"System parameters:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.179469, "o", "> "]
[78.179502, "o", "print(f\"  K = {K} C/%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179701, "o", "print(f\"  tau = {tau} s\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Target specifications:\r\n\u001b[?2004l\r\u001b[?2004h> # - Steady-state error < 0.5C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179756, "o", "# - Settling time < 120s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179815, "o", "# - Overshoot < 10%\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.179869, "o", "# - Max temperature < 30C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.179907, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.179983, "o", "# Using Lambda (IMC) tuning for PI controller\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180057, "o", "# For first-order system: G(s) = K / (tau*s + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.180091, "o", "> "]
[78.180167, "o", "# PI controller: C(s) = Kp * (1 + 1/(Ti*s))\r\n\u001b[?2004l\r\u001b[?2004h> #\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.180203, "o", "> "]
[78.180272, "o", "# Lambda tuning (aggressive for faster response):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180328, "o", "# Kp = tau / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180381, "o", "# Ti = tau\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.18044, "o", "# Ki = Kp / Ti = 1 / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h> #\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.180476, "o", "> "]
[78.18055, "o", "# Closed-loop time constant = lambda\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180645, "o", "# For settling time (4*lambda) < 120s, we need lambda < 30s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180758, "o", "# But we also need to avoid overshoot, so we'll be more conservative\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.180793, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.180894, "o", "# Choose lambda = tau for moderate response (no overshoot)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.180988, "o", "# But this gives settling time ~ 4*tau = 169s, too slow\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.181026, "o", "> # \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.18113, "o", "# For faster response with minimal overshoot, use lambda = tau/2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181217, "o", "# This gives settling time ~ 4*lambda = 2*tau = 84s\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.181252, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181374, "o", "# Let's use lambda slightly larger than tau/2 to ensure low overshoot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181452, "o", "lambda_cl = 25.0  # Closed-loop time constant\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.181489, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.181523, "o", "# Calculate PI gains\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.181557, "o", "> "]
[78.181589, "o", "Kp = tau / (K * lambda_cl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181698, "o", "Ti = tau  # Integral time = process time constant\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181749, "o", "Ki = Kp / Ti  # = 1 / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.181787, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181887, "o", "# Add small derivative for smoother response (optional)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.181954, "o", "Kd = 0.0  # Keep it simple with PI\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.181987, "o", "\u001b[?2004h> "]
[78.182075, "o", "print(f\"\\nLambda tuning with lambda = {lambda_cl}s:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.182134, "o", "print(f\"  Kp = {Kp:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.182184, "o", "print(f\"  Ki = {Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.182257, "o", "> print(f\"  Kd = {Kd:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.182293, "o", "> "]
[78.182375, "o", "print(f\"  Ti (integral time) = {Ti:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.182432, "o", "# Expected closed-loop performance:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.182498, "o", "print(f\"\\nExpected performance:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.182536, "o", "> "]
[78.182608, "o", "print(f\"  Closed-loop time constant: {lambda_cl}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.182711, "o", "print(f\"  Approximate settling time (4*lambda): {4*lambda_cl}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.182747, "o", "> "]
[78.182816, "o", "print(f\"  Expected overshoot: minimal (IMC tuning)\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.182849, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.182957, "o", "# Verify: at setpoint 22C from ambient 18C, what heater power needed?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183028, "o", "# Steady-state: T = T_ambient + K * u\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183116, "o", "# 22 = 18 + 0.1261 * u => u = 4 / 0.1261 = 31.7%\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.183151, "o", "> "]
[78.183188, "o", "u_ss = (22.0 - 18.0) / K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183283, "o", "print(f\"\\nSteady-state heater power for 22C: {u_ss:.1f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.183322, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.183358, "o", "# Save tuned gains\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183389, "o", "gains = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183497, "o", "    \"Kp\": round(Kp, 4),\r\n\u001b[?2004l\r\u001b[?2004h>     \"Ki\": round(Ki, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183552, "o", "    \"Kd\": round(Kd, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183616, "o", "    \"lambda\": round(lambda_cl, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183675, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183745, "o", "with open(\"tuned_gains.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183813, "o", "    json.dump(gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.18387, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183923, "o", "print(f\"\\nSaved to tuned_gains.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.183959, "o", "EOF\r\n\u001b[?2004l\r"]
[78.184985, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[78.708984, "i", "python3 calculate_gains.py\n"]
[78.711708, "o", "python3 calculate_gains.py\r\n\u001b[?2004l\r"]
[78.728644, "o", "System parameters:\r\n  K = 0.1261 C/%\r\n  tau = 42.28 s\r\n\r\nLambda tuning with lambda = 25.0s:\r\n  Kp = 13.4116\r\n  Ki = 0.3172\r\n  Kd = 0.0000\r\n  Ti (integral time) = 42.28s\r\n\r\nExpected performance:\r\n  Closed-loop time constant: 25.0s\r\n  Approximate settling time (4*lambda): 100.0s\r\n  Expected overshoot: minimal (IMC tuning)\r\n\r\nSteady-state heater power for 22C: 31.7%"]
[78.728943, "o", "\r\n\r\nSaved to tuned_gains.json\r\n"]
[78.732108, "o", "\u001b[?2004hroot@e10a2078de3f:~# "]
[112.122887, "i", "cat > run_control.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport sys\nsys.path.insert(0, '/root')\nfrom hvac_simulator import HVACSimulator\nimport numpy as np\n\n# Load controller gains\nwith open(\"tuned_gains.json\", \"r\") as f:\n    gains = json.load(f)\n\nKp = gains[\"Kp\"]\nKi = gains[\"Ki\"]\nKd = gains[\"Kd\"]\n\nprint(f\"Controller gains: Kp={Kp}, Ki={Ki}, Kd={Kd}\")\n\n# Initialize simulator\nsim = HVACSimulator()\nsetpoint = sim.get_setpoint()  # 22.0C\ndt = sim.get_dt()  # 0.5s\n\nprint(f\"Setpoint: {setpoint}C\")\nprint(f\"Timestep: {dt}s\")\n\n# Reset simulator\ninitial_temp = sim.reset()\nprint(f\"Initial temperature: {initial_temp:.2f}C\")\n\n# Control parameters\ncontrol_duration = 160.0  # Run for 160 seconds (>150s required)\nsteps = int(control_duration / dt)\n\n# PI controller state\nintegral = 0.0\nprev_error = 0.0\n\n# Anti-windup limits\nintegral_max = 100.0 / Ki if Ki > 0 else 1000.0  # Limit integral to max output\nintegral_min = -integral_max\n\n# Data logging\ndata = []\n\n# Control loop\nfor i in range(steps):\n    # Get current time (before this step)\n    current_time = i * dt\n    \n    # Use the measured temperature from previous step or initial\n    if i == 0:\n        measured_temp = initial_temp\n    else:\n        measured_temp = data[-1][\"temperature\"]\n    \n    # Calculate error\n    error = setpoint - measured_temp\n    \n    # PI controller with anti-windup\n    # Proportional term\n    P = Kp * error\n    \n    # Integral term with anti-windup\n    integral += error * dt\n    integral = np.clip(integral, integral_min, integral_max)\n    I = Ki * integral\n    \n    # Derivative term (on error)\n    if i > 0:\n        derivative = (error - prev_error) / dt\n    else:\n        derivative = 0.0\n    D = Kd * derivative\n    \n    prev_error = error\n    \n    # Calculate control output\n    heater_power = P + I + D\n    \n    # Clamp to valid range\n    heater_power = np.clip(heater_power, 0.0, 100.0)\n    \n    # Apply control and get result\n    result = sim.step(heater_power)\n    \n    # Log data\n    data.append({\n        \"time\": result[\"time\"],\n        \"temperature\": result[\"temperature\"],\n        \"setpoint\": setpoint,\n        \"heater_power\": result[\"heater_power\"],\n        \"error\": round(setpoint - result[\"temperature\"], 4)\n    })\n    \n    # Print progress every 20 seconds\n    if i % 40 == 0:\n        print(f\"t={result['time']:.1f}s: T={result['temperature']:.2f}C, error={error:.2f}C, P={heater_power:.1f}%\")\n\n# Save control log\ncontrol_log = {\n    \"phase\": \"control\",\n    \"setpoint\": setpoint,\n    \"data\": data\n}\n\nwith open(\"control_log.json\", \"w\") as f:\n    json.dump(control_log, f, indent=2)\n\nprint(f\"\\nControl complete. Saved {len(data)} data points to control_log.json\")\n\n# Calculate metrics\ntemps = np.array([d[\"temperature\"] for d in data])\ntimes = np.array([d[\"time\"] for d in data])\n\n# Max temperature\nmax_temp = np.max(temps)\n\n# Rise time: time to first reach 90% of the way from initial to setpoint\nrise_target = initial_temp + 0.9 * (setpoint - initial_temp)\nrise_time = None\nfor i, t in enumerate(temps):\n    if t >= rise_target:\n        rise_time = times[i]\n        break\n\n# Overshoot: (max_temp - setpoint) / (setpoint - initial_temp) * 100%\nif max_temp > setpoint:\n    overshoot = (max_temp - setpoint) / (setpoint - initial_temp)\nelse:\n    overshoot = 0.0\n\n# Settling time: time after which temperature stays within 2% of setpoint\nsettling_band = 0.02 * abs(setpoint - initial_temp)  # 2% of step size = 0.08C\n# Use a larger band for practical purposes (0.5C as per spec)\nsettling_band = 0.5  # Use the spec requirement\n\nsettling_time = None\n# Find the last time the temperature was outside the settling band\nfor i in range(len(temps) - 1, -1, -1):\n    if abs(temps[i] - setpoint) > settling_band:\n        if i < len(temps) - 1:\n            settling_time = times[i + 1]\n        break\nelse:\n    settling_time = times[0]  # Always within band\n\n# If never settled, use the full duration\nif settling_time is None:\n    settling_time = times[-1]\n\n# Steady-state error: average error in last 20 seconds\nlast_20s_mask = times >= (times[-1] - 20.0)\nsteady_state_temps = temps[last_20s_mask]\n"]
[112.122965, "i", "steady_state_error = abs(np.mean(steady_state_temps) - setpoint)\n\nprint(f\"\\nPerformance Metrics:\")\nprint(f\"  Rise time (90%): {rise_time:.1f}s\" if rise_time else \"  Rise time: N/A\")\nprint(f\"  Overshoot: {overshoot*100:.2f}%\")\nprint(f\"  Settling time (within 0.5C): {settling_time:.1f}s\")\nprint(f\"  Steady-state error: {steady_state_error:.3f}C\")\nprint(f\"  Max temperature: {max_temp:.2f}C\")\n\n# Save metrics\nmetrics = {\n    \"rise_time\": round(rise_time, 2) if rise_time else None,\n    \"overshoot\": round(overshoot, 4),\n    \"settling_time\": round(settling_time, 2),\n    \"steady_state_error\": round(steady_state_error, 4),\n    \"max_temp\": round(max_temp, 2)\n}\n\nwith open(\"metrics.json\", \"w\") as f:\n    json.dump(metrics, f, indent=2)\n\nprint(f\"\\nSaved to metrics.json\")\n\n# Check against requirements\nprint(f\"\\nRequirements check:\")\nprint(f\"  Steady-state error < 0.5C: {'PASS' if steady_state_error < 0.5 else 'FAIL'} ({steady_state_error:.3f}C)\")\nprint(f\"  Settling time < 120s: {'PASS' if settling_time < 120 else 'FAIL'} ({settling_time:.1f}s)\")\nprint(f\"  Overshoot < 10%: {'PASS' if overshoot < 0.10 else 'FAIL'} ({overshoot*100:.2f}%)\")\nprint(f\"  Control duration >= 150s: {'PASS' if times[-1] >= 150 else 'FAIL'} ({times[-1]:.1f}s)\")\nprint(f\"  Max temperature < 30C: {'PASS' if max_temp < 30 else 'FAIL'} ({max_temp:.2f}C)\")\nEOF\n"]
[112.123227, "o", "cat > run_control.py << 'EOF'\r\n\u001b[?2004l\r"]
