[112.124918, "o", "dt = sim.get_dt()  # 0.5s\r\n\u001b[?2004l\re\u001b[?2004h"]
[112.124995, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> print(f\"Setpoint: {setpoint}C\")\r\n\u001b[?2004l\r"]
