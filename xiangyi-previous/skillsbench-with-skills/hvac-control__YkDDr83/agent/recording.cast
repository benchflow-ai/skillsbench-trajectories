[53.231356, "o", "    temps_pred = first_order_response(times, K_est, tau_est)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.231451, "o", "    ss_res = np.sum((temps - temps_pred) ** 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.23155, "o", "    ss_tot = np.sum((temps - np.mean(temps)) ** 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
