[53.230741, "o", "# Fit the model\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.230807, "o", "    popt, pcov = curve_fit(first_order_response, times, temps, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.230904, "o", "                           p0=[K_guess, tau_guess],\r\n\u001b[?2004l\r\u001b[?2004h> "]
