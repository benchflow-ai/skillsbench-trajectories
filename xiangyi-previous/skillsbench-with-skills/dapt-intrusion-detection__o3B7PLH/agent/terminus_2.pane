[?2004l[?2004h> buckets = collections.defaultdict(int)
[?2004l[?2004h> start_time = timestamps[0] if timestamps else 0
[?2004l[?2004h> for ts in timestamps:
[?2004l i[?2004h>     b_idx = int((ts - start_time) // 60)
[?2004l[?2004h>     buckets[b_idx] += 1
[?2004l[?2004h> ppm_vals = list(buckets.values()) if buckets else [0]
[?2004l[?2004h> ppm_avg = statistics.mean(ppm_vals) if ppm_vals else 0
[?2004l[?2004h> ppm_max = max(ppm_vals) if ppm_vals else 0
