[?2004l[?2004h> min_size = min(lengths) if lengths else 0
[?2004l[?2004h> max_size = max(lengths) if lengths else 0
[?2004l[?2004h> 
[?2004l[?2004h> # Entropy
[?2004l[?2004h> def calc_entropy(data):
[?2004l[?2004h>     if not data: return 0
[?2004l[?2004h>     counts = collections.Counter(data)
[?2004l[?2004h>     total = len(data)
[?2004l[?2004h>     return -sum((c/total) * math.log2(c/total) for c in counts.values())
[?2004l[?2004h> 
