[118.791098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[118.791133, "o", "\u001b[?2004h> "]
[118.791213, "o", "# --- Calculations ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.791243, "o", "# Time\r\n\u001b[?2004l\r"]
[118.791303, "o", "\u001b[?2004h> "]
[118.791497, "o", "duration = timestamps[-1] - timestamps[0] if timestamps else 0\r\n\u001b[?2004l\r"]
[118.791558, "o", "\u001b[?2004h> "]
[118.791656, "o", "buckets = collections.defaultdict(int)\r\n\u001b[?2004l\r"]
[118.79169, "o", "\u001b[?2004h> "]
[118.791855, "o", "start_time = timestamps[0] if timestamps else 0\r\n\u001b[?2004l\r"]
[118.791886, "o", "\u001b[?2004h> "]
[118.791948, "o", "for ts in timestamps:\r\n\u001b[?2004l\r i"]
[118.791981, "o", "\u001b[?2004h> "]
[118.792102, "o", "    b_idx = int((ts - start_time) // 60)\r\n\u001b[?2004l\r"]
[118.792138, "o", "\u001b[?2004h> "]
[118.792204, "o", "    buckets[b_idx] += 1\r\n\u001b[?2004l\r"]
[118.792237, "o", "\u001b[?2004h> "]
[118.792421, "o", "ppm_vals = list(buckets.values()) if buckets else [0]\r\n\u001b[?2004l\r"]
[118.792456, "o", "\u001b[?2004h> "]
[118.792602, "o", "ppm_avg = statistics.mean(ppm_vals) if ppm_vals else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.792637, "o", "> "]
[118.792717, "o", "ppm_max = max(ppm_vals) if ppm_vals else 0\r\n\u001b[?2004l\r"]
[118.792752, "o", "\u001b[?2004h> "]
[118.792841, "o", "ppm_min = min(ppm_vals) if ppm_vals else 0\r\n\u001b[?2004l\r"]
[118.792878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.792911, "o", "> # Size\r\n\u001b[?2004l\r"]
[118.792944, "o", "\u001b[?2004h> "]
[118.793042, "o", "total_bytes = sum(lengths)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.793134, "o", "avg_size = statistics.mean(lengths) if lengths else 0\r\n\u001b[?2004l\r"]
[118.79317, "o", "\u001b[?2004h> "]
[118.793265, "o", "min_size = min(lengths) if lengths else 0\r\n\u001b[?2004l\r"]
[118.7933, "o", "\u001b[?2004h> "]
[118.793398, "o", "max_size = max(lengths) if lengths else 0\r\n\u001b[?2004l\r"]
[118.793436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.793466, "o", "# Entropy\r\n\u001b[?2004l\r"]
[118.7935, "o", "\u001b[?2004h> "]
[118.793599, "o", "def calc_entropy(data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.793658, "o", "    if not data: return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.793694, "o", "> "]
[118.793761, "o", "    counts = collections.Counter(data)\r\n\u001b[?2004l\r"]
[118.793798, "o", "\u001b[?2004h> "]
[118.793868, "o", "    total = len(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.794035, "o", "    return -sum((c/total) * math.log2(c/total) for c in counts.values())\r\n\u001b[?2004l\r"]
[118.79407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.794135, "o", "\u001b[?2004h> "]
[118.794195, "o", "src_ip_ent = calc_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.794274, "o", "dst_ip_ent = calc_entropy(dst_ips)\r\n\u001b[?2004l\r"]
[118.794307, "o", "\u001b[?2004h> "]
[118.794411, "o", "src_port_ent = calc_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.794508, "o", "dst_port_ent = calc_entropy(dst_ports)\r\n\u001b[?2004l\r"]
[118.794542, "o", "\u001b[?2004h> "]
[118.79463, "o", "uniq_src_ports = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.794666, "o", "> "]
[118.794735, "o", "uniq_dst_ports = len(set(dst_ports))\r\n\u001b[?2004l\r"]
[118.7948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.794837, "o", "\u001b[?2004h> # Graph\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.79492, "o", "> num_nodes = len(nodes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.794982, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r"]
[118.795016, "o", "\u001b[?2004h> "]
[118.795196, "o", "density = num_edges / (num_nodes * (num_nodes - 1)) if num_nodes > 1 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.795355, "o", "max_out = max((len(d) for d in out_degree.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.79539, "o", "> "]
[118.795535, "o", "max_in = max((len(s) for s in in_degree.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.795566, "o", "> \r\n\u001b[?2004l\r"]
[118.795644, "o", "\u001b[?2004h> # IAT\r\n\u001b[?2004l\r"]
[118.795679, "o", "\u001b[?2004h> "]
[118.79581, "o", "iats = [timestamps[i] - timestamps[i-1] for i in range(1, len(timestamps))]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.795842, "o", "> "]
[118.795942, "o", "iat_mean = statistics.mean(iats) if iats else 0\r\n\u001b[?2004l\r"]
[118.79598, "o", "\u001b[?2004h> "]
[118.796107, "o", "iat_var = statistics.variance(iats) if len(iats) > 1 else 0\r\n\u001b[?2004l\r"]
[118.796144, "o", "\u001b[?2004h> "]
[118.796201, "o", "iat_std = math.sqrt(iat_var)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.796235, "o", "> "]
[118.796339, "o", "iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\r\n\u001b[?2004l\r"]
[118.796371, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.796405, "o", "> # PCR\r\n\u001b[?2004l\r"]
[118.79644, "o", "\u001b[?2004h> "]
[118.796537, "o", "producers = 0\r\n\u001b[?2004l\r\u001b[?2004h> consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.796572, "o", "> "]
[118.796686, "o", "all_ips = set(bytes_sent.keys()) | set(bytes_recv.keys())\r\n\u001b[?2004l\r"]
[118.796722, "o", "\u001b[?2004h> "]
[118.79679, "o", "for ip in all_ips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.796885, "o", "    s = bytes_sent[ip]; r = bytes_recv[ip]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.796918, "o", "> "]
[118.79699, "o", "    if s + r > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797046, "o", "        pcr = (s - r) / (s + r)\r\n\u001b[?2004l\r"]
[118.797083, "o", "\u001b[?2004h> "]
[118.797168, "o", "        if pcr > 0.2: producers += 1\r\n\u001b[?2004l\r"]
[118.7972, "o", "\u001b[?2004h> "]
[118.797288, "o", "        if pcr < -0.2: consumers += 1\r\n\u001b[?2004l\r"]
[118.797319, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797391, "o", "# Flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797449, "o", "uniq_flows = len(flows)\r\n\u001b[?2004l\r"]
[118.797484, "o", "\u001b[?2004h> "]
[118.797602, "o", "tcp_flows = len([f for f in flows if f[4] == 6])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797736, "o", "udp_flows = len([f for f in flows if f[4] == 17])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797787, "o", "bidirect = 0\r\n\u001b[?2004l\r"]
[118.797821, "o", "\u001b[?2004h> "]
[118.797886, "o", "for f in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.797964, "o", "    # f = (src, dst, sport, dport, proto)\r\n\u001b[?2004l\r"]
[118.798002, "o", "\u001b[?2004h> "]
[118.798084, "o", "    rev = (f[1], f[0], f[3], f[2], f[4])\r\n\u001b[?2004l\r"]
[118.798121, "o", "\u001b[?2004h> "]
[118.798194, "o", "    if rev in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.79825, "o", "        bidirect += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[118.798284, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[118.79836, "o", "# Analysis Flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.79839, "o", "# Heuristics:\r\n\u001b[?2004l\r"]
[118.798425, "o", "\u001b[?2004h> "]
[118.798524, "o", "# Port Scan: Single IP scanning > 50 ports\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.79856, "o", "> "]
[118.798758, "o", "max_scanned_ports = max((len(ports) for ports in port_scan_candidates.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.798844, "o", "> "]
[118.798877, "o", "has_port_scan = max_scanned_ports > 50\r\n\u001b[?2004l\r"]
[118.798947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.799027, "o", "# DoS: High PPM max (e.g., > 3000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.799111, "o", "has_dos = ppm_max > 3000\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.799148, "o", "\u001b[?2004h> "]
[118.799307, "o", "# Beaconing: Very low IAT CV (e.g., < 0.05) and sufficient packets\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.799343, "o", "> "]
[118.799454, "o", "has_beaconing = iat_cv < 0.1 and len(packets) > 50\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.799486, "o", "> \r\n\u001b[?2004l\r"]
[118.799549, "o", "\u001b[?2004h> "]
[118.799656, "o", "is_benign = not (has_port_scan or has_dos or has_beaconing)\r\n\u001b[?2004l\r"]
[118.799694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.799724, "o", "\u001b[?2004h> "]
[118.799807, "o", "# Results Dict\r\n\u001b[?2004l\r\u001b[?2004h> res = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.799842, "o", "> "]
[118.799919, "o", "    'protocol_tcp': proto_counts['tcp'],\r\n\u001b[?2004l\r"]
[118.799954, "o", "\u001b[?2004h> "]
[118.800038, "o", "    'protocol_udp': proto_counts['udp'],\r\n\u001b[?2004l\r"]
[118.800074, "o", "\u001b[?2004h> "]
[118.800175, "o", "    'protocol_icmp': proto_counts['icmp'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.800292, "o", "    'protocol_arp': proto_counts['arp'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.800398, "o", "    'protocol_ip_total': ip_total,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.800488, "o", "    'duration_seconds': duration,\r\n\u001b[?2004l\r"]
[118.800524, "o", "\u001b[?2004h> "]
[118.800613, "o", "    'packets_per_minute_avg': ppm_avg,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.800649, "o", "> "]
[118.800725, "o", "    'packets_per_minute_max': ppm_max,\r\n\u001b[?2004l\r"]
[118.800758, "o", "\u001b[?2004h> "]
[118.800851, "o", "    'packets_per_minute_min': ppm_min,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.800884, "o", "> "]
[118.800955, "o", "    'total_bytes': total_bytes,\r\n\u001b[?2004l\r"]
[118.800994, "o", "\u001b[?2004h> "]
[118.801063, "o", "    'avg_packet_size': avg_size,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.801148, "o", "    'min_packet_size': min_size,\r\n\u001b[?2004l\r"]
[118.801173, "o", "\u001b[?2004h> "]
[118.801301, "o", "    'max_packet_size': max_size,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.801376, "o", "    'dst_port_entropy': dst_port_ent,\r\n\u001b[?2004l\r"]
[118.80144, "o", "\u001b[?2004h> "]
[118.801491, "o", "    'src_port_entropy': src_port_ent,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.801525, "o", "> "]
[118.801592, "o", "    'src_ip_entropy': src_ip_ent,\r\n\u001b[?2004l\r"]
[118.801627, "o", "\u001b[?2004h> "]
[118.801693, "o", "    'dst_ip_entropy': dst_ip_ent,\r\n\u001b[?2004l\r"]
[118.801726, "o", "\u001b[?2004h> "]
[118.801816, "o", "    'unique_dst_ports': uniq_dst_ports,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.80185, "o", "> "]
[118.801931, "o", "    'unique_src_ports': uniq_src_ports,\r\n\u001b[?2004l\r"]
[118.801965, "o", "\u001b[?2004h> "]
[118.802034, "o", "    'num_nodes': num_nodes,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.802112, "o", "    'num_edges': num_edges,\r\n\u001b[?2004l\r"]
[118.802147, "o", "\u001b[?2004h> "]
[118.802214, "o", "    'network_density': density,\r\n\u001b[?2004l\r"]
[118.802284, "o", "\u001b[?2004h> "]
[118.802319, "o", "    'max_indegree': max_in,\r\n\u001b[?2004l\r"]
[118.802351, "o", "\u001b[?2004h> "]
[118.802429, "o", "    'max_outdegree': max_out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.802514, "o", "    'iat_mean': iat_mean,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.802549, "o", "> "]
[118.802611, "o", "    'iat_variance': iat_var,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.802647, "o", "> "]
[118.802735, "o", "    'iat_cv': iat_cv,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.802814, "o", "    'num_producers': producers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.802887, "o", "    'num_consumers': consumers,\r\n\u001b[?2004l\r"]
[118.802946, "o", "\u001b[?2004h> "]
[118.803011, "o", "    'unique_flows': uniq_flows,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.803044, "o", "> "]
[118.803113, "o", "    'bidirectional_flows': bidirect,\r\n\u001b[?2004l\r"]
[118.803145, "o", "\u001b[?2004h> "]
[118.803209, "o", "    'tcp_flows': tcp_flows,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.803247, "o", "> "]
[118.80332, "o", "    'udp_flows': udp_flows,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.803442, "o", "    'is_traffic_benign': str(is_benign).lower(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.803573, "o", "    'has_port_scan': str(has_port_scan).lower(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.803608, "o", "> "]
[118.803696, "o", "    'has_dos_pattern': str(has_dos).lower(),\r\n\u001b[?2004l\r"]
[118.803732, "o", "\u001b[?2004h> "]
[118.803831, "o", "    'has_beaconing': str(has_beaconing).lower(),\r\n\u001b[?2004l\r"]
[118.803866, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[118.803931, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.803967, "o", "# Write CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.804051, "o", "lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.804147, "o", "with open('/root/network_stats.csv', 'r') as f:\r\n\u001b[?2004l\r"]
[118.804185, "o", "\u001b[?2004h> "]
[118.804245, "o", "    lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.804278, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.804313, "o", "> "]
[118.804412, "o", "with open('/root/network_stats.csv', 'w') as f:\r\n\u001b[?2004l\r"]
[118.804447, "o", "\u001b[?2004h> "]
[118.804519, "o", "    for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.804584, "o", "        line = line.strip()\r\n\u001b[?2004l\r"]
[118.804618, "o", "\u001b[?2004h> "]
[118.804792, "o", "        if not line or line.startswith('#') or line == 'metric,value':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.804876, "o", "            f.write(line + '\\n')\r\n\u001b[?2004l\r"]
[118.804908, "o", "\u001b[?2004h> "]
[118.804973, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.805056, "o", "        key = line.split(',')[0]\r\n\u001b[?2004l\r"]
[118.805091, "o", "\u001b[?2004h> "]
[118.805162, "o", "        if key in res:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.805253, "o", "            f.write(f\"{key},{res[key]}\\n\")\r\n\u001b[?2004l\r"]
[118.805287, "o", "\u001b[?2004h> "]
[118.805343, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.805418, "o", "            f.write(line + '\\n')\r\n\u001b[?2004l\r"]
[118.805452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.805482, "o", "> "]
[118.805565, "o", "print(\"Analysis complete.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[118.82686, "o", "\u001b[?2004hroot@6620cc08661c:~# "]
[119.275802, "i", "python3 analyze.py\n"]
[119.27599, "o", "python3 analyze.py\r\n\u001b[?2004l\r"]
[129.349928, "i", "cat /root/network_stats.csv\n"]
[129.350105, "o", "cat /root/network_stats.csv\r\n"]
[151.785351, "o", "Analysis complete.\r\n"]
