[?2004l[?2004h>                 'selected': local_selected,
[?2004l[?2004h>                 'alts': op_data
[?2004l[?2004h>             }
[?2004l[?2004h> 
[?2004l[?2004h>     # Precedence
[?2004l[?2004h>     for j in range(num_jobs):
