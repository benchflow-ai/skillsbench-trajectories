[?2004l[?2004h>             curr_s = task_vars[(j, o)]['start']
[?2004l[?2004h>             
[?2004l[?2004h>             shift = model.NewIntVar(0, horizon, f'shift_{j}_{o}')
[?2004l[?2004h>             model.Add(shift >= curr_s - base_s)
[?2004l[?2004h>             model.Add(shift >= base_s - curr_s)
[?2004l[?2004h>             shifts.append(shift)
[?2004l[?2004h>     
[?2004l[?2004h>     model.Add(sum(shifts) <= policy['change_budget']['max_total_start_shift_L1'])
[?2004l[?2004h>     
[?2004l[?2004h>     # Makespan
[?2004l[?2004h>     makespan = model.NewIntVar(0, horizon, 'makespan')
[?2004l[?2004h>     for j in range(num_jobs):
[?2004l[?2004h>         last_op_idx = len(jobs[j]) - 1
[?2004l[?2004h>         model.Add(makespan >= task_vars[(j, last_op_idx)]['end'])
[?2004l[?2004h>         
[?2004l[?2004h>     max_makespan = int(baseline['makespan'] * policy['guards']['max_makespan_ratio'])
[?2004l[?2004h>     model.Add(makespan <= max_makespan)
[?2004l[?2004h>     
[?2004l[?2004h>     model.Minimize(makespan)
