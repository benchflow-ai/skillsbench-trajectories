[?2004l[?2004h>         t_var = task_vars[(j, o)]
[?2004l[?2004h>         model.Add(t_var['start'] == task['start'])
[?2004l[?2004h>         model.Add(t_var['machine'] == task['machine'])
[?2004l[?2004h> 
[?2004l[?2004h>     # Budgets
[?2004l[?2004h>     machine_changes = []
[?2004l[?2004h>     for j in range(num_jobs):
[?2004l[?2004h>         for o in range(len(jobs[j])):
