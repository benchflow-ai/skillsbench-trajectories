[?2004l[?2004h>             curr_m = task_vars[(j, o)]['machine']
[?2004l[?2004h>             
[?2004l[?2004h>             is_diff = model.NewBoolVar(f'diff_m_{j}_{o}')
[?2004l[?2004h>             model.Add(curr_m != base_m).OnlyEnforceIf(is_diff)
[?2004l[?2004h>             model.Add(curr_m == base_m).OnlyEnforceIf(is_diff.Not())
[?2004l[?2004h>             machine_changes.append(is_diff)
[?2004l[?2004h>     
[?2004l[?2004h>     model.Add(sum(machine_changes) <= policy['change_budget']['max_machine_changes'])
[?2004l[?2004h>     
[?2004l[?2004h>     shifts = []
[?2004l[?2004h>     for j in range(num_jobs):
