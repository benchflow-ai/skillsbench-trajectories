[273.07081, "o", "\u001b[?2004h> "]
[273.071067, "o", "        model.AddNoOverlap(machine_intervals[m])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.071116, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.071175, "o", "    # Downtime Constraints\r\n\u001b[?2004l\r"]
[273.071202, "o", "\u001b[?2004h> "]
[273.07127, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.071358, "o", "        for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[273.071378, "o", "\u001b[?2004h> "]
[273.071459, "o", "            if (j, o) in frozen_tasks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.071592, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[273.071646, "o", "\u001b[?2004h"]
[273.071674, "o", "> "]
[273.071744, "o", "            t_var = task_vars[(j, o)]\r\n\u001b[?2004l\r"]
[273.071773, "o", "\u001b[?2004h> "]
[273.071819, "o", "            \r\n\u001b[?2004l\r"]
[273.07184, "o", "\u001b[?2004h> "]
[273.075019, "o", "            for alt_idx, alt in enumerate(t_var['alts']):\r\n\u001b[?2004l\r\u001b[?2004h>                 m = alt['machine']\r\n\u001b[?2004l\r\u001b[?2004h>                 is_selected = t_var['selected'][alt_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.078426, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h>                 relevant_dts = [dt for dt in downtimes if dt['machine'] == m]\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 for dt in relevant_dts:\r\n\u001b[?2004l\r\u001b[?2004h>                     b_before = model.NewBoolVar(f'before_dt_{j}_{o}_{m}_{dt[\"start\"]}')\r\n\u001b[?2004l\r\u001b[?2004h>                     b_after = model.NewBoolVar(f'after_dt_{j}_{o}_{m}_{dt[\"start\"]}')\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     model.Add(t_var['end'] <= dt['start']).OnlyEnforceIf(b_before)\r\n\u001b[?2004l\r\u001b[?2004h>                     model.Add(t_var['start'] >= dt['end']).OnlyEnforceIf(b_after)\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     model.Add(b_before + b_after >= 1).OnlyEnforceIf(is_selected)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Freeze Constraints\r\n\u001b[?2004l\r\u001b[?2004h>     for (j, o), task in frozen_tasks.items():\r\n\u001b[?2004l\r\u001b[?2004h>         t_var = task_vars[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h>         model.Add(t_var['start'] == task['start'])\r\n\u001b[?2004l\r\u001b[?2004h>         model.Add(t_var['machine'] == task['machine'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Budgets\r\n\u001b[?2004l\r\u001b[?2004h>     machine_changes = []\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h>         for o in range(len(jobs[j])):\r\n\u001b[?2004l\r\u001b[?2004h>             base_m = baseline_map[(j, o)]['machine']\r\n\u001b[?2004l\r\u001b[?2004h>             curr_m = task_vars[(j, o)]['machine']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             is_diff = model.NewBoolVar(f'diff_m_{j}_{o}')\r\n\u001b[?2004l\r\u001b[?2004h>             model.Add(curr_m != base_m).OnlyEnforceIf(is_diff)\r\n\u001b[?2004l\r\u001b[?2004h>             model.Add(curr_m == base_m).OnlyEnforceIf(is_diff.Not())\r\n\u001b[?2004l\r\u001b[?2004h>             machine_changes.append(is_diff)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model.Add(sum(machine_changes) <= policy['change_budget']['max_machine_changes'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     shifts = []\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h>         for o in range(len(jobs[j])):\r\n\u001b[?2004l\r\u001b[?2004h>             base_s = baseline_map[(j, o)]['start']\r\n\u001b[?2004l\r\u001b[?2004h>             curr_s = task_vars[(j, o)]['start']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.078476, "o", "            shift = model.NewIntVar(0, horizon, f'shift_{j}_{o}')\r\n\u001b[?2004l\r\u001b[?2004h>             model.Add(shift >= curr_s - base_s)\r\n\u001b[?2004l\r\u001b[?2004h>             model.Add(shift >= base_s - curr_s)\r\n\u001b[?2004l\r\u001b[?2004h>             shifts.append(shift)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model.Add(sum(shifts) <= policy['change_budget']['max_total_start_shift_L1'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Makespan\r\n\u001b[?2004l\r\u001b[?2004h>     makespan = model.NewIntVar(0, horizon, 'makespan')\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h>         last_op_idx = len(jobs[j]) - 1\r\n\u001b[?2004l\r\u001b[?2004h>         model.Add(makespan >= task_vars[(j, last_op_idx)]['end'])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     max_makespan = int(baseline['makespan'] * policy['guards']['max_makespan_ratio'])\r\n\u001b[?2004l\r\u001b[?2004h>     model.Add(makespan <= max_makespan)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model.Minimize(makespan)\r\n\u001b[?2004l\r"]
