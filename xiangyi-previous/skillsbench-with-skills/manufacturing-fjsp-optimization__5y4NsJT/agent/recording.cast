[282.905273, "o", "{\r\n  \"status\": \"OPTIMAL\",\r\n  \"makespan\": 36,\r\n  \"schedule\": [\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 1,\r\n      \"machine\": 2,\r\n      \"start\": 5,\r\n      \"end\": 11,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 26,\r\n      \"end\": 31,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 20,\r\n      \"end\": 26,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 2,\r\n      \"machine\": 1,\r\n      \"start\": 26,\r\n      \"end\": 34,\r\n      \"dur\": 8\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 5,\r\n      \"end\": 9,\r\n      \"dur\": 4\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 1,\r\n      \"machine\": 0,\r\n      \"start\": 12,\r\n      \"end\": 20,\r\n      \"dur\": 8\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 20,\r\n      \"end\": 26,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 5,\r\n      \"end\": 12,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 1,\r\n      \"machine\": 2,\r\n      \"start\": 25,\r\n      \"end\": 32,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 32,\r\n      \"end\": 36,\r\n      \"dur\": 4\r\n    }\r\n  ]\r\n}"]
[282.905448, "o", "\u001b[?2004hroot@2539c6dc1948:/app# "]
[374.578929, "i", "cat << 'EOF' > solve.py\nimport json\nimport csv\nimport sys\n\ntry:\n    from ortools.sat.python import cp_model\nexcept ImportError:\n    print(\"Error: ortools not installed\")\n    sys.exit(1)\n\ndef solve():\n    # 1. Load Data\n    with open('/app/data/instance.txt', 'r') as f:\n        lines = f.read().split()\n    \n    iterator = iter(lines)\n    num_jobs = int(next(iterator))\n    num_machines = int(next(iterator))\n    \n    jobs = []\n    for j in range(num_jobs):\n        num_ops = int(next(iterator))\n        ops = []\n        for o in range(num_ops):\n            num_alts = int(next(iterator))\n            alts = []\n            for _ in range(num_alts):\n                m_id = int(next(iterator))\n                dur = int(next(iterator))\n                alts.append({'machine': m_id, 'duration': dur})\n            ops.append(alts)\n        jobs.append(ops)\n\n    downtimes = []\n    with open('/app/data/downtime.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            downtimes.append({\n                'machine': int(row['machine']),\n                'start': int(row['start']),\n                'end': int(row['end']),\n                'reason': row['reason']\n            })\n\n    with open('/app/data/policy.json', 'r') as f:\n        policy = json.load(f)\n        \n    with open('/app/data/baseline_solution.json', 'r') as f:\n        baseline = json.load(f)\n        \n    baseline_map = {} \n    for task in baseline['schedule']:\n        baseline_map[(task['job'], task['op'])] = task\n\n    freeze_time = policy['freeze']['freeze_until'] if policy['freeze']['enabled'] else -1\n    \n    frozen_tasks = {}\n    for (j, o), task in baseline_map.items():\n        if task['start'] < freeze_time:\n            frozen_tasks[(j, o)] = task\n\n    # Check for conflicts between frozen tasks and downtime\n    # If a frozen task conflicts with downtime, it must be unfrozen to allow rescheduling\n    tasks_to_unfreeze = []\n    for (j, o), task in frozen_tasks.items():\n        m = task['machine']\n        s = task['start']\n        e = task['end']\n        \n        for dt in downtimes:\n            if dt['machine'] == m:\n                # Check overlap: start < dt_end AND end > dt_start\n                if s < dt['end'] and e > dt['start']:\n                    print(f\"Unfreezing Task {j}-{o} due to downtime conflict on Machine {m}\")\n                    tasks_to_unfreeze.append((j, o))\n                    break\n    \n    for key in tasks_to_unfreeze:\n        del frozen_tasks[key]\n\n    # 2. Solver Setup\n    model = cp_model.CpModel()\n    \n    task_vars = {}\n    machine_intervals = {m: [] for m in range(num_machines)}\n    \n    horizon = 200 # Increased horizon slightly to be safe\n    \n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            op_data = jobs[j][o]\n            suffix = f'_{j}_{o}'\n            \n            start_var = model.NewIntVar(0, horizon, 'start' + suffix)\n            end_var = model.NewIntVar(0, horizon, 'end' + suffix)\n            mach_var = model.NewIntVar(0, num_machines - 1, 'mach' + suffix)\n            \n            local_selected = []\n            \n            for alt_idx, alt in enumerate(op_data):\n                m_id = alt['machine']\n                dur = alt['duration']\n                \n                is_selected = model.NewBoolVar(f'sel{suffix}_{m_id}')\n                local_selected.append(is_selected)\n                \n                interval = model.NewOptionalIntervalVar(\n                    start_var, dur, end_var, is_selected, f'interval{suffix}_{m_id}'\n                )\n                machine_intervals[m_id].append(interval)\n                \n                model.Add(mach_var == m_id).OnlyEnforceIf(is_selected)\n                \n            model.Add(sum(local_selected) == 1)\n            \n            task_vars[(j, o)] = {\n                'start': start_var,\n                'end': end_var,\n                'machine': mach_var,\n                'selected': local_selected,\n                'alts': op_data\n            }\n\n    # Precedence\n    for j in range(num_jobs):\n        for o in range(len(jobs[j]"]
[374.579, "i", ") - 1):\n            model.Add(task_vars[(j, o)]['end'] <= task_vars[(j, o+1)]['start'])\n            \n    # No Overlap\n    for m in range(num_machines):\n        model.AddNoOverlap(machine_intervals[m])\n            \n    # Downtime Constraints\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            # If task is frozen, we assume it's valid (we already filtered invalid ones)\n            # But technically, we can just apply downtime constraints to everyone.\n            # If it's frozen and valid, the constraints will pass.\n            # If it's frozen and invalid, we unfroze it, so constraints apply.\n            # So we apply to ALL tasks.\n            \n            t_var = task_vars[(j, o)]\n            \n            for alt_idx, alt in enumerate(t_var['alts']):\n                m = alt['machine']\n                is_selected = t_var['selected'][alt_idx]\n                \n                relevant_dts = [dt for dt in downtimes if dt['machine'] == m]\n                \n                for dt in relevant_dts:\n                    b_before = model.NewBoolVar(f'before_dt_{j}_{o}_{m}_{dt[\"start\"]}')\n                    b_after = model.NewBoolVar(f'after_dt_{j}_{o}_{m}_{dt[\"start\"]}')\n                    \n                    model.Add(t_var['end'] <= dt['start']).OnlyEnforceIf(b_before)\n                    model.Add(t_var['start'] >= dt['end']).OnlyEnforceIf(b_after)\n                    \n                    model.Add(b_before + b_after >= 1).OnlyEnforceIf(is_selected)\n\n    # Freeze Constraints\n    for (j, o), task in frozen_tasks.items():\n        t_var = task_vars[(j, o)]\n        model.Add(t_var['start'] == task['start'])\n        model.Add(t_var['machine'] == task['machine'])\n\n    # Budgets\n    machine_changes = []\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            base_m = baseline_map[(j, o)]['machine']\n            curr_m = task_vars[(j, o)]['machine']\n            \n            is_diff = model.NewBoolVar(f'diff_m_{j}_{o}')\n            model.Add(curr_m != base_m).OnlyEnforceIf(is_diff)\n            model.Add(curr_m == base_m).OnlyEnforceIf(is_diff.Not())\n            machine_changes.append(is_diff)\n    \n    model.Add(sum(machine_changes) <= policy['change_budget']['max_machine_changes'])\n    \n    shifts = []\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            base_s = baseline_map[(j, o)]['start']\n            curr_s = task_vars[(j, o)]['start']\n            \n            shift = model.NewIntVar(0, horizon, f'shift_{j}_{o}')\n            model.Add(shift >= curr_s - base_s)\n            model.Add(shift >= base_s - curr_s)\n            shifts.append(shift)\n    \n    model.Add(sum(shifts) <= policy['change_budget']['max_total_start_shift_L1'])\n    \n    # Makespan\n    makespan = model.NewIntVar(0, horizon, 'makespan')\n    for j in range(num_jobs):\n        last_op_idx = len(jobs[j]) - 1\n        model.Add(makespan >= task_vars[(j, last_op_idx)]['end'])\n        \n    max_makespan = int(baseline['makespan'] * policy['guards']['max_makespan_ratio'])\n    model.Add(makespan <= max_makespan)\n    \n    model.Minimize(makespan)\n    \n    solver = cp_model.CpSolver()\n    status = solver.Solve(model)\n    \n    if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:\n        res_makespan = solver.Value(makespan)\n        schedule = []\n        for j in range(num_jobs):\n            for o in range(len(jobs[j])):\n                t_var = task_vars[(j, o)]\n                s = solver.Value(t_var['start'])\n                e = solver.Value(t_var['end'])\n                m = solver.Value(t_var['machine'])\n                dur = e - s\n                schedule.append({\n                    \"job\": j,\n                    \"op\": o,\n                    \"machine\": m,\n                    \"start\": s,\n                    \"end\": e,\n                    \"dur\": dur\n                })\n        \n        output = {\n            \"status\": \"OPTIMAL\" if status == cp_model.OPTIMAL else \"FEASIBLE\",\n            \"makespan\": res_makespan,\n            \"schedule\": schedule\n        }\n        \n        with open('/app/output/solution.json', "]
[374.579048, "i", "'w') as f:\n            json.dump(output, f, indent=2)\n            \n        keys = [\"job\", \"op\", \"machine\", \"start\", \"end\", \"dur\"]\n        with open('/app/output/schedule.csv', 'w', newline='') as f:\n            writer = csv.DictWriter(f, fieldnames=keys)\n            writer.writeheader()\n            for row in schedule:\n                writer.writerow(row)\n        \n        print(\"Solved successfully.\")\n    else:\n        print(\"No solution found.\")\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
[374.579354, "o", "cat << 'EOF' > solve.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[374.579462, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[374.579698, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.579809, "o", "    from ortools.sat.python import cp_model\r\n\u001b[?2004l\r\u001b[?2004h> except ImportError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.579903, "o", "    print(\"Error: ortools not installed\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.581052, "o", "    sys.exit(1)\r\n\u001b[?2004l\r"]
[374.581089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.581226, "o", "def solve():\r\n\u001b[?2004l\r"]
[374.581254, "o", "\u001b[?2004h> "]
[374.581426, "o", "    # 1. Load Data\r\n\u001b[?2004l\r"]
[374.581462, "o", "\u001b[?2004h> "]
[374.581698, "o", "    with open('/app/data/instance.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[374.581731, "o", "\u001b[?2004h> "]
[374.581876, "o", "        lines = f.read().split()\r\n\u001b[?2004l\r"]
[374.581906, "o", "\u001b[?2004h> "]
[374.581934, "o", "    \r\n\u001b[?2004l\r"]
[374.581962, "o", "\u001b[?2004h> "]
[374.582102, "o", "    iterator = iter(lines)\r\n\u001b[?2004l\r"]
[374.582137, "o", "\u001b[?2004h> "]
[374.582375, "o", "    num_jobs = int(next(iterator))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.582568, "o", "    num_machines = int(next(iterator))\r\n\u001b[?2004l\r"]
[374.5826, "o", "\u001b[?2004h> "]
[374.582639, "o", "    \r\n\u001b[?2004l\r"]
[374.582664, "o", "\u001b[?2004h> "]
[374.582766, "o", "    jobs = []\r\n\u001b[?2004l\r"]
[374.582801, "o", "\u001b[?2004h> "]
[374.582973, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r"]
[374.583013, "o", "\u001b[?2004h> "]
[374.58322, "o", "        num_ops = int(next(iterator))\r\n\u001b[?2004l\r"]
[374.583259, "o", "\u001b[?2004h> "]
[374.58337, "o", "        ops = []\r\n\u001b[?2004l\r"]
[374.5834, "o", "\u001b[?2004h> "]
[374.583593, "o", "        for o in range(num_ops):\r\n\u001b[?2004l\r"]
[374.583639, "o", "\u001b[?2004h"]
[374.583698, "o", "> "]
[374.583905, "o", "            num_alts = int(next(iterator))\r\n\u001b[?2004l\r"]
[374.583935, "o", "\u001b[?2004h> "]
[374.584059, "o", "            alts = []\r\n\u001b[?2004l\r"]
[374.584084, "o", "\u001b[?2004h> "]
[374.584318, "o", "            for _ in range(num_alts):\r\n\u001b[?2004l\r"]
[374.584353, "o", "\u001b[?2004h> "]
[374.584601, "o", "                m_id = int(next(iterator))\r\n\u001b[?2004l\r"]
[374.584666, "o", "\u001b[?2004h> "]
[374.584883, "o", "                dur = int(next(iterator))\r\n\u001b[?2004l\r"]
[374.584913, "o", "\u001b[?2004h> "]
[374.5853, "o", "                alts.append({'machine': m_id, 'duration': dur})\r\n\u001b[?2004l\r"]
[374.58533, "o", "\u001b[?2004h> "]
[374.585521, "o", "            ops.append(alts)\r\n\u001b[?2004l\r"]
[374.585552, "o", "\u001b[?2004h> "]
[374.585711, "o", "        jobs.append(ops)\r\n\u001b[?2004l\r"]
[374.585745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.585774, "o", "> "]
[374.585896, "o", "    downtimes = []\r\n\u001b[?2004l\r"]
[374.585928, "o", "\u001b[?2004h> "]
[374.586275, "o", "    with open('/app/data/downtime.csv', 'r') as f:\r\n\u001b[?2004l\r"]
[374.586338, "o", "\u001b[?2004h"]
[374.586368, "o", "> "]
[374.586551, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[374.586582, "o", "\u001b[?2004h> "]
[374.586753, "o", "        for row in reader:\r\n\u001b[?2004l\r"]
[374.586783, "o", "\u001b[?2004h> "]
[374.586985, "o", "            downtimes.append({\r\n"]
[374.587027, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[374.587381, "o", "                'machine': int(row['machine']),\r\n\u001b[?2004l\r"]
[374.587444, "o", "\u001b[?2004h> "]
[374.587728, "o", "                'start': int(row['start']),\r\n\u001b[?2004l\r"]
[374.587784, "o", "\u001b[?2004h> "]
[374.58803, "o", "                'end': int(row['end']),\r\n\u001b[?2004l\r"]
[374.58806, "o", "\u001b[?2004h"]
[374.588086, "o", "> "]
[374.588427, "o", "                'reason': row['reason']\r\n\u001b[?2004l\r"]
[374.588462, "o", "\u001b[?2004h"]
[374.588495, "o", "> "]
[374.588591, "o", "            })\r\n\u001b[?2004l\r"]
[374.588628, "o", "\u001b[?2004h> "]
[374.588659, "o", "\r\n\u001b[?2004l\r"]
[374.588688, "o", "\u001b[?2004h"]
[374.588721, "o", "> "]
[374.589027, "o", "    with open('/app/data/policy.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.589196, "o", "        policy = json.load(f)\r\n\u001b[?2004l\r"]
[374.589232, "o", "\u001b[?2004h> "]
[374.58957, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.589648, "o", "    with open('/app/data/baseline_solution.json', 'r') as f:\r\n\u001b[?2004l\r"]
[374.589677, "o", "\u001b[?2004h> "]
[374.589881, "o", "        baseline = json.load(f)\r\n\u001b[?2004l\r"]
[374.589919, "o", "\u001b[?2004h> "]
[374.589977, "o", "        \r\n\u001b[?2004l\r"]
[374.590013, "o", "\u001b[?2004h> "]
[374.590133, "o", "    baseline_map = {} \r\n\u001b[?2004l\r"]
[374.590169, "o", "\u001b[?2004h> "]
[374.590464, "o", "    for task in baseline['schedule']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.590827, "o", "        baseline_map[(task['job'], task['op'])] = task\r\n\u001b[?2004l\r"]
[374.590875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.591415, "o", "    freeze_time = policy['freeze']['freeze_until'] if policy['freeze']['enabled'] else -1\r\n\u001b[?2004l\r"]
[374.591457, "o", "\u001b[?2004h> "]
[374.591501, "o", "    \r\n\u001b[?2004l\r"]
[374.591544, "o", "\u001b[?2004h> "]
[374.591707, "o", "    frozen_tasks = {}\r\n\u001b[?2004l\r"]
[374.591751, "o", "\u001b[?2004h> "]
[374.592061, "o", "    for (j, o), task in baseline_map.items():\r\n\u001b[?2004l\r"]
[374.5921, "o", "\u001b[?2004h> "]
[374.592353, "o", "        if task['start'] < freeze_time:\r\n\u001b[?2004l\r"]
[374.59238, "o", "\u001b[?2004h"]
[374.592404, "o", "> "]
[374.592653, "o", "            frozen_tasks[(j, o)] = task\r\n\u001b[?2004l\r"]
[374.592686, "o", "\u001b[?2004h"]
[374.592713, "o", "> \r\n"]
[374.592745, "o", "\u001b[?2004l\r\u001b[?2004h"]
[374.592775, "o", "> "]
[374.59316, "o", "    # Check for conflicts between frozen tasks and downtime\r\n\u001b[?2004l\r"]
[374.593202, "o", "\u001b[?2004h> "]
[374.593758, "o", "    # If a frozen task conflicts with downtime, it must be unfrozen to allow rescheduling\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.593798, "o", "> "]
[374.593985, "o", "    tasks_to_unfreeze = []\r\n\u001b[?2004l\r"]
[374.59403, "o", "\u001b[?2004h> "]
[374.594381, "o", "    for (j, o), task in frozen_tasks.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.594534, "o", "        m = task['machine']\r\n\u001b[?2004l\r"]
[374.594569, "o", "\u001b[?2004h> "]
[374.594747, "o", "        s = task['start']\r\n\u001b[?2004l\r"]
[374.594778, "o", "\u001b[?2004h"]
[374.594812, "o", "> "]
[374.59497, "o", "        e = task['end']\r\n\u001b[?2004l\r"]
[374.595009, "o", "\u001b[?2004h> "]
[374.595086, "o", "        \r\n\u001b[?2004l\r"]
[374.595117, "o", "\u001b[?2004h"]
[374.59515, "o", "> "]
[374.595344, "o", "        for dt in downtimes:\r\n\u001b[?2004l\r"]
[374.595379, "o", "\u001b[?2004h"]
[374.595413, "o", "> "]
[374.595686, "o", "            if dt['machine'] == m:\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.595732, "o", "> "]
[374.59611, "o", "                # Check overlap: start < dt_end AND end > dt_start\r\n"]
[374.596149, "o", "\u001b[?2004l\r\u001b[?2004h"]
[374.596178, "o", "> "]
[374.596796, "o", "                if s < dt['end'] and e > dt['start']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.59737, "o", "                    print(f\"Unfreezing Task {j}-{o} due to downtime conflict on Machine {m}\")\r\n\u001b[?2004l\r"]
[374.597422, "o", "\u001b[?2004h> "]
[374.597813, "o", "                    tasks_to_unfreeze.append((j, o))\r\n\u001b[?2004l\r"]
[374.597841, "o", "\u001b[?2004h> "]
[374.59803, "o", "                    break\r\n"]
[374.598062, "o", "\u001b[?2004l\r\u001b[?2004h"]
[374.598093, "o", "> "]
[374.598127, "o", "    \r\n\u001b[?2004l\r"]
[374.598161, "o", "\u001b[?2004h"]
[374.598188, "o", "> "]
[374.598422, "o", "    for key in tasks_to_unfreeze:\r\n\u001b[?2004l\r"]
[374.598461, "o", "\u001b[?2004h> "]
[374.598669, "o", "        del frozen_tasks[key]\r\n\u001b[?2004l\r"]
[374.598702, "o", "\u001b[?2004h"]
[374.598736, "o", "> "]
[374.598765, "o", "\r\n\u001b[?2004l\r"]
[374.598792, "o", "\u001b[?2004h"]
[374.598827, "o", "> "]
[374.59898, "o", "    # 2. Solver Setup\r\n\u001b[?2004l\r"]
[374.599013, "o", "\u001b[?2004h"]
[374.599039, "o", "> "]
[374.599264, "o", "    model = cp_model.CpModel()\r\n\u001b[?2004l\r"]
[374.599296, "o", "\u001b[?2004h> "]
[374.59934, "o", "    \r\n\u001b[?2004l\r"]
[374.599383, "o", "\u001b[?2004h> "]
[374.599543, "o", "    task_vars = {}\r\n\u001b[?2004l\r"]
[374.599574, "o", "\u001b[?2004h> "]
[374.600031, "o", "    machine_intervals = {m: [] for m in range(num_machines)}\r\n\u001b[?2004l\r"]
[374.600064, "o", "\u001b[?2004h"]
[374.6001, "o", "> "]
[374.600153, "o", "    \r\n\u001b[?2004l\r"]
[374.600189, "o", "\u001b[?2004h"]
[374.600219, "o", "> "]
[374.600588, "o", "    horizon = 200 # Increased horizon slightly to be safe\r\n\u001b[?2004l\r"]
[374.600622, "o", "\u001b[?2004h"]
[374.60065, "o", "> "]
[374.600696, "o", "    \r\n\u001b[?2004l\r"]
[374.600727, "o", "\u001b[?2004h"]
[374.600756, "o", "> "]
[374.600952, "o", "    for j in range(num_jobs):\r\n"]
[374.600987, "o", "\u001b[?2004l\r\u001b[?2004h"]
[374.601021, "o", "> "]
[374.601265, "o", "        for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[374.601297, "o", "\u001b[?2004h"]
[374.601327, "o", "> "]
[374.60155, "o", "            op_data = jobs[j][o]\r\n\u001b[?2004l\r"]
[374.601588, "o", "\u001b[?2004h> "]
[374.6018, "o", "            suffix = f'_{j}_{o}'\r\n\u001b[?2004l\r"]
[374.601833, "o", "\u001b[?2004h"]
[374.60187, "o", "> "]
[374.601951, "o", "            \r\n\u001b[?2004l\r"]
[374.601999, "o", "\u001b[?2004h"]
[374.602032, "o", "> "]
[374.602456, "o", "            start_var = model.NewIntVar(0, horizon, 'start' + suffix)\r\n"]
[374.602486, "o", "\u001b[?2004l\r"]
[374.60257, "o", "\u001b[?2004h> "]
[374.603001, "o", "            end_var = model.NewIntVar(0, horizon, 'end' + suffix)\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.603051, "o", "> "]
[374.603496, "o", "            mach_var = model.NewIntVar(0, num_machines - 1, 'mach' + suffix)\r\n\u001b[?2004l\r"]
[374.603533, "o", "\u001b[?2004h"]
[374.603577, "o", "> "]
[374.603689, "o", "            \r\n\u001b[?2004l\r"]
[374.603724, "o", "\u001b[?2004h> "]
[374.604135, "o", "            local_selected = []\r\n\u001b[?2004l\r"]
[374.604179, "o", "\u001b[?2004h> "]
[374.604297, "o", "            \r\n\u001b[?2004l\r"]
[374.604328, "o", "\u001b[?2004h"]
[374.604367, "o", "> "]
[374.604692, "o", "            for alt_idx, alt in enumerate(op_data):\r\n\u001b[?2004l\r"]
[374.604732, "o", "\u001b[?2004h> "]
[374.604992, "o", "                m_id = alt['machine']\r\n\u001b[?2004l\r"]
[374.605022, "o", "\u001b[?2004h"]
[374.605081, "o", "> "]
[374.605351, "o", "                dur = alt['duration']\r\n\u001b[?2004l\r"]
[374.605385, "o", "\u001b[?2004h> "]
[374.605518, "o", "                \r\n\u001b[?2004l\r"]
[374.605549, "o", "\u001b[?2004h"]
[374.605583, "o", "> "]
[374.636102, "o", "                is_selected = model.NewBoolVar(f'sel{suffix}_{m_id}')\r\n\u001b[?2004l\r"]
[374.636391, "o", "\u001b[?2004h> "]
[374.636534, "o", "                local_selected.append(is_selected)\r\n\u001b[?2004l\r\u001b[?2004h>                 "]
[374.636658, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.636852, "o", "                interval = model.NewOptionalIntervalVar(\r\n\u001b[?2004l\r"]
[374.636962, "o", "\u001b[?2004h> "]
[374.637691, "o", "                    start_var, dur, end_var, is_selected, f'interval{suffix}_{m_id}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.637913, "o", ">                 )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.638286, "o", "                machine_intervals[m_id].append(interval)\r\n\u001b[?2004l\r"]
[374.638411, "o", "\u001b[?2004h> "]
[374.638535, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.638918, "o", "                model.Add(mach_var == m_id).OnlyEnforceIf(is_selected)\r\n\u001b[?2004l\r"]
[374.639036, "o", "\u001b[?2004h> "]
[374.63914, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.639393, "o", "            model.Add(sum(local_selected) == 1)\r\n\u001b[?2004l\r"]
[374.639493, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[374.639591, "o", "\u001b[?2004h> "]
[374.639719, "o", "            task_vars[(j, o)] = {\r\n\u001b[?2004l\r"]
[374.639818, "o", "\u001b[?2004h> "]
[374.639988, "o", "                'start': start_var,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.640176, "o", "                'end': end_var,\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.640254, "o", "> "]
[374.640433, "o", "                'machine': mach_var,\r\n\u001b[?2004l\r"]
[374.64051, "o", "\u001b[?2004h> "]
[374.640674, "o", "                'selected': local_selected,\r\n\u001b[?2004l\r"]
[374.640751, "o", "\u001b[?2004h> "]
[374.640879, "o", "                'alts': op_data\r\n\u001b[?2004l\r"]
[374.640953, "o", "\u001b[?2004h> "]
[374.641037, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.641106, "o", "> "]
[374.641188, "o", "    # Precedence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.641353, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r"]
[374.641417, "o", "\u001b[?2004h> "]
[374.641589, "o", "        for o in range(len(jobs[j]) - 1):\r\n\u001b[?2004l\r \u001b[?2004h> "]
[374.642009, "o", "            model.Add(task_vars[(j, o)]['end'] <= task_vars[(j, o+1)]['start'])\r\n\u001b[?2004l\r"]
[374.642077, "o", "\u001b[?2004h> "]
[374.642157, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.642252, "o", "    # No Overlap\r\n\u001b[?2004l\r"]
[374.642326, "o", "\u001b[?2004h> "]
[374.642444, "o", "    for m in range(num_machines):\r\n\u001b[?2004l\r"]
[374.642514, "o", "\u001b[?2004h> "]
[374.642721, "o", "        model.AddNoOverlap(machine_intervals[m])\r\n\u001b[?2004l\r"]
[374.642798, "o", "\u001b[?2004h> "]
[374.642876, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.642996, "o", "    # Downtime Constraints\r\n\u001b[?2004l\r"]
[374.643078, "o", "\u001b[?2004h> "]
[374.643182, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.643275, "o", "> "]
[374.643414, "o", "        for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[374.643488, "o", "\u001b[?2004h> "]
[374.643882, "o", "            # If task is frozen, we assume it's valid (we already filtered invalid ones)\r\n\u001b[?2004l\r"]
[374.644023, "o", "\u001b[?2004h"]
[374.648737, "o", "> "]
[374.653655, "o", "            # But technically, we can just apply downtime constraints to everyone.\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.653914, "o", ">             # If it's frozen and valid, the constraints will pass.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.654182, "o", "            # If it's frozen and invalid, we unfroze it, so constraints apply.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.654496, "o", "            # So we apply to ALL tasks.\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.654594, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.654831, "o", "            t_var = task_vars[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[374.654997, "o", "\u001b[?2004h> "]
[374.655243, "o", "            for alt_idx, alt in enumerate(t_var['alts']):\r\n\u001b[?2004l\r\u001b[?2004h>                 m = alt['machine']\r\n\u001b[?2004l\r"]
[374.655391, "o", "\u001b[?2004h> "]
[374.655492, "o", "                is_selected = t_var['selected'][alt_idx]\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.655729, "o", "                relevant_dts = [dt for dt in downtimes if dt['machine'] == m]\r\n\u001b[?2004l\r"]
[374.655823, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.656058, "o", "                for dt in relevant_dts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.656166, "o", "> "]
[374.656272, "o", "                    b_before = model.NewBoolVar(f'before_dt_{j}_{o}_{m}_{dt[\"start\"]}')\r\n\u001b[?2004l\r"]
[374.656348, "o", "\u001b[?2004h> "]
[374.656524, "o", "                    b_after = model.NewBoolVar(f'after_dt_{j}_{o}_{m}_{dt[\"start\"]}')\r\n\u001b[?2004l\r"]
[374.656647, "o", "\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.656814, "o", "                    model.Add(t_var['end'] <= dt['start']).OnlyEnforceIf(b_before)\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.656916, "o", "> "]
[374.657009, "o", "                    model.Add(t_var['start'] >= dt['end']).OnlyEnforceIf(b_after)\r\n\u001b[?2004l\r"]
[374.657085, "o", "\u001b[?2004h>                     \r\n\u001b[?2004l\r"]
[374.657164, "o", "\u001b[?2004h> "]
[374.657633, "o", "                    model.Add(b_before + b_after >= 1).OnlyEnforceIf(is_selected)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Freeze Constraints\r\n\u001b[?2004l\r\u001b[?2004h>     for (j, o), task in frozen_tasks.items():\r\n\u001b[?2004l\r\u001b[?2004h>         t_var = task_vars[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.657748, "o", ">         model.Add(t_var['start'] == task['start'])\r\n\u001b[?2004l\r"]
[374.657826, "o", "\u001b[?2004h> "]
[374.657936, "o", "        model.Add(t_var['machine'] == task['machine'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.658024, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     # Budgets\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.658116, "o", "    machine_changes = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.6583, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.658388, "o", "        for o in range(len(jobs[j])):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.65857, "o", "            base_m = baseline_map[(j, o)]['machine']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.658681, "o", "            curr_m = task_vars[(j, o)]['machine']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[374.658757, "o", "\u001b[?2004h> "]
[374.658837, "o", "            is_diff = model.NewBoolVar(f'diff_m_{j}_{o}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.658929, "o", "            model.Add(curr_m != base_m).OnlyEnforceIf(is_diff)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.659347, "o", "            model.Add(curr_m == base_m).OnlyEnforceIf(is_diff.Not())\r\n\u001b[?2004l\r\u001b[?2004h>             machine_changes.append(is_diff)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model.Add(sum(machine_changes) <= policy['change_budget']['max_machine_changes'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[374.659446, "o", "\u001b[?2004h>     shifts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.659523, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.659594, "o", "        for o in range(len(jobs[j])):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.659737, "o", "            base_s = baseline_map[(j, o)]['start']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.659827, "o", "            curr_s = task_vars[(j, o)]['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.659932, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.66001, "o", "> "]
[374.660103, "o", "            shift = model.NewIntVar(0, horizon, f'shift_{j}_{o}')\r\n\u001b[?2004l\r"]
[374.660191, "o", "\u001b[?2004h> "]
[374.660276, "o", "            model.Add(shift >= curr_s - base_s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.660368, "o", "            model.Add(shift >= base_s - curr_s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.660477, "o", "            shifts.append(shift)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.660621, "o", "    model.Add(sum(shifts) <= policy['change_budget']['max_total_start_shift_L1'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.660706, "o", ">     # Makespan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.660812, "o", "    makespan = model.NewIntVar(0, horizon, 'makespan')\r\n\u001b[?2004l\r"]
[374.660907, "o", "\u001b[?2004h>     for j in range(num_jobs):\r\n\u001b[?2004l\r"]
[374.660968, "o", "\u001b[?2004h> "]
[374.661042, "o", "        last_op_idx = len(jobs[j]) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.661208, "o", "        model.Add(makespan >= task_vars[(j, last_op_idx)]['end'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.661276, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.661586, "o", "    max_makespan = int(baseline['makespan'] * policy['guards']['max_makespan_ratio'])\r\n\u001b[?2004l\r\u001b[?2004h>     model.Add(makespan <= max_makespan)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.661717, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     model.Minimize(makespan)\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.661825, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.66192, "o", "    solver = cp_model.CpSolver()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662007, "o", "    status = solver.Solve(model)\r\n\u001b[?2004l\r"]
[374.662066, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662296, "o", "    if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662423, "o", "        res_makespan = solver.Value(makespan)\r\n\u001b[?2004l\r\u001b[?2004h>         schedule = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662504, "o", "        for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662594, "o", "            for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[374.662674, "o", "\u001b[?2004h> "]
[374.66278, "o", "                t_var = task_vars[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.662886, "o", "                s = solver.Value(t_var['start'])\r\n\u001b[?2004l\r"]
[374.66295, "o", "\u001b[?2004h> "]
[374.663026, "o", "                e = solver.Value(t_var['end'])\r\n\u001b[?2004l\r"]
[374.663084, "o", "\u001b[?2004h> "]
[374.663196, "o", "                m = solver.Value(t_var['machine'])\r\n\u001b[?2004l\r"]
[374.663254, "o", "\u001b[?2004h> "]
[374.663317, "o", "                dur = e - s\r\n\u001b[?2004l\r"]
[374.663375, "o", "\u001b[?2004h> "]
[374.663449, "o", "                schedule.append({\r\n\u001b[?2004l\r"]
[374.6635, "o", "\u001b[?2004h> "]
[374.663583, "o", "                    \"job\": j,\r\n\u001b[?2004l\r"]
[374.663632, "o", "\u001b[?2004h> "]
[374.663711, "o", "                    \"op\": o,\r\n\u001b[?2004l\r"]
[374.663772, "o", "\u001b[?2004h> "]
[374.663895, "o", "                    \"machine\": m,\r\n\u001b[?2004l\r"]
[374.664001, "o", "\u001b[?2004h>                     \"start\": s,\r\n\u001b[?2004l\r"]
[374.664087, "o", "\u001b[?2004h> "]
[374.664165, "o", "                    \"end\": e,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.664266, "o", "                    \"dur\": dur\r\n\u001b[?2004l\r"]
[374.66433, "o", "\u001b[?2004h> "]
[374.664381, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.66443, "o", "        \r\n\u001b[?2004l\r"]
[374.664479, "o", "\u001b[?2004h> "]
[374.664541, "o", "        output = {\r\n\u001b[?2004l\r"]
[374.664596, "o", "\u001b[?2004h> "]
[374.664795, "o", "            \"status\": \"OPTIMAL\" if status == cp_model.OPTIMAL else \"FEASIBLE\",\r\n\u001b[?2004l\r"]
[374.664853, "o", "\u001b[?2004h> "]
[374.664952, "o", "            \"makespan\": res_makespan,\r\n\u001b[?2004l\r"]
[374.665012, "o", "\u001b[?2004h> "]
[374.66509, "o", "            \"schedule\": schedule\r\n\u001b[?2004l\r"]
[374.665158, "o", "\u001b[?2004h> "]
[374.665215, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.665277, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.665327, "o", "> "]
[374.665455, "o", "        with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r"]
[374.66551, "o", "\u001b[?2004h> "]
[374.665614, "o", "            json.dump(output, f, indent=2)\r\n"]
[374.665664, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[374.665717, "o", "            \r\n\u001b[?2004l\r"]
[374.665775, "o", "\u001b[?2004h> "]
[374.665909, "o", "        keys = [\"job\", \"op\", \"machine\", \"start\", \"end\", \"dur\"]\r\n\u001b[?2004l\r"]
[374.665961, "o", "\u001b[?2004h> "]
[374.666146, "o", "        with open('/app/output/schedule.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[374.6662, "o", "\u001b[?2004h> "]
[374.666357, "o", "            writer = csv.DictWriter(f, fieldnames=keys)\r\n\u001b[?2004l\r"]
[374.666429, "o", "\u001b[?2004h> "]
[374.666502, "o", "            writer.writeheader()\r\n\u001b[?2004l\r"]
[374.666551, "o", "\u001b[?2004h> "]
[374.666645, "o", "            for row in schedule:\r\n\u001b[?2004l\r"]
[374.666702, "o", "\u001b[?2004h> "]
[374.666793, "o", "                writer.writerow(row)\r\n\u001b[?2004l\r"]
[374.666843, "o", "\u001b[?2004h> "]
[374.666895, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[374.666941, "o", "> "]
[374.667014, "o", "        print(\"Solved successfully.\")\r\n\u001b[?2004l\r"]
[374.66707, "o", "\u001b[?2004h> "]
[374.667126, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.667191, "o", "> "]
[374.667245, "o", "        print(\"No solution found.\")\r\n\u001b[?2004l\r"]
[374.667271, "o", "\u001b[?2004h> "]
[374.667297, "o", "\r\n\u001b[?2004l\r"]
[374.667322, "o", "\u001b[?2004h> "]
[374.667409, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[374.667436, "o", "\u001b[?2004h"]
[374.667458, "o", "> "]
[374.667504, "o", "    solve()\r\n\u001b[?2004l\r"]
[374.667529, "o", "\u001b[?2004h"]
[374.66755, "o", "> "]
[374.667575, "o", "EOF\r\n"]
[374.667599, "o", "\u001b[?2004l\r"]
[374.699095, "o", "\u001b[?2004hroot@2539c6dc1948:/app# "]
[375.510955, "i", "python3 solve.py\n"]
[375.511673, "o", "python3 solve.py\r\n\u001b[?2004l\r"]
[376.309241, "o", "Unfreezing Task 2-0 due to downtime conflict on Machine 1\r\n"]
[376.360035, "o", "Solved successfully.\r\n"]
[376.473889, "o", "\u001b[?2004hroot@2539c6dc1948:/app# "]
[380.616183, "i", "cat /app/output/solution.json\n"]
[380.616863, "o", "cat /app/output/solution.json\r\n\u001b[?2004l\r"]
[380.670809, "o", "{\r\n  \"status\": \"OPTIMAL\",\r\n  \"makespan\": 38,\r\n  \"schedule\": [\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 1,\r\n      \"machine\": 2,\r\n      \"start\": 5,\r\n      \"end\": 11,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 12,\r\n      \"end\": 17,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 1,\r\n      \"machine\": 2,\r\n      \"start\": 25,\r\n      \"end\": 30,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 2,\r\n      \"machine\": 1,\r\n      \"start\": 30,\r\n      \"end\": 38,\r\n      \"dur\": 8\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 20,\r\n      \"end\": 24,\r\n      \"dur\": 4\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 1,\r\n      \"machine\": 0,\r\n      \"start\": 24,\r\n      \"end\": 32,\r\n      \"dur\": 8\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 32,\r\n      \"end\": 38,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 5,\r\n      \"end\": 12,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 24,"]
[380.671008, "o", "\r\n      \"end\": 29,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 2,\r\n      \"machine\": 2,\r\n      \"start\": 30,\r\n      \"end\": 36,\r\n      \"dur\": 6\r\n    }\r\n  ]\r\n}"]
[380.671144, "o", "\u001b[?2004hroot@2539c6dc1948:/app# "]
