[273.069593, "o", "\u001b[?2004h> "]
[273.069692, "o", "    # Precedence\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.069742, "o", "> "]
[273.069938, "o", "    for j in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.070088, "o", "        for o in range(len(jobs[j]) - 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.070173, "o", "> "]
[273.070489, "o", "            model.Add(task_vars[(j, o)]['end'] <= task_vars[(j, o+1)]['start'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.070527, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
