[399.078027, "o", "cat /app/output/schedule.csv\r\n\u001b[?2004l\r"]
[399.12879, "o", "job,op,machine,start,end,dur\r\r\n0,0,1,0,5,5\r\r\n0,1,2,5,11,6\r\r\n0,2,0,12,17,5\r\r\n1,0,0,0,5,5\r\r\n1,1,2,25,30,5\r\r\n1,2,1,30,38,8\r\r\n2,0,1,20,24,4\r\r\n2,1,0,24,32,8\r\r\n2,2,0,32,38,6\r\r\n3,0,0,5,12,7\r\r\n3,1,1,24,29,5\r\r\n3,2,2,30,36,6\r\r\n"]
[399.1293, "o", "\u001b[?2004hroot@2539c6dc1948:/app# "]
