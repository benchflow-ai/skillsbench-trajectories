[508.243367, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\ndef add_exclusion(path):\n    p = Path(path)\n    text = p.read_text()\n    if '<artifactId>compile-testing</artifactId>' not in text:\n        return\n    # Skip if already has exclusions in the compile-testing dependency\n    def repl(match):\n        block = match.group(0)\n        if '<exclusions>' in block:\n            return block\n        # insert exclusions before closing dependency tag\n        insert = (\n            \"      <exclusions>\\n\"\n            \"        <exclusion>\\n\"\n            \"          <groupId>com.sun</groupId>\\n\"\n            \"          <artifactId>tools</artifactId>\\n\"\n            \"        </exclusion>\\n\"\n            \"      </exclusions>\\n\"\n        )\n        return block.replace(\"    </dependency>\\n\", insert + \"    </dependency>\\n\")\n\n    pattern = re.compile(r\"    <dependency>\\n(?:.*?\\n)*?    </dependency>\\n\", re.MULTILINE)\n    def replace_first(match):\n        block = match.group(0)\n        if '<artifactId>compile-testing</artifactId>' in bloc"]
[508.243535, "i", "k:\n            return repl(match)\n        return block\n    new_text = pattern.sub(replace_first, text, count=1)\n    # For safety, do full substitution where block contains compile-testing\n    if new_text == text:\n        # try more targeted substitution\n        new_text = re.sub(\n            r\"(    <dependency>\\n(?:.*?\\n)*?<artifactId>compile-testing</artifactId>\\n(?:.*?\\n)*?    </dependency>\\n)\",\n            lambda m: repl(m), text, count=1, flags=re.MULTILINE)\n    p.write_text(new_text)\n\nfor path in [\n    '/home/travis/build/failed/google/auto/factory/pom.xml',\n    '/home/travis/build/failed/google/auto/service/pom.xml',\n    '/home/travis/build/failed/google/auto/value/pom.xml',\n]:\n    add_exclusion(path)\nPY\n"]
