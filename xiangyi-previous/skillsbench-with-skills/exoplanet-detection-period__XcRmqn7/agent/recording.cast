[173.757066, "o", "\u001b[?2004h> "]
[173.757209, "o", "    print(f\"P: {p:.5f}, t0: {t0:.5f}, dur: {dur:.3f}, SNR: {snr:.2f}, Depth: {depth:.5f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[173.757221, "o", "\u001b[?2004h> "]
[173.757231, "o", "EOF\r\n\u001b[?2004l\r"]
