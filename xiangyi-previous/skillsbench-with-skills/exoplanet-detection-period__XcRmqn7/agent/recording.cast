[259.219027, "i", "cat << 'EOF' > final_check_v2.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\nfor wl in [0.4, 0.5, 0.6, 0.7]:\n    flat = lc.flatten(window_length=int(wl/cadence)|1)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=500)\n    best_p = pg.period_at_max_power.value\n    snr = pg.snr.max()\n    print(f\"WL {wl}: P {best_p:.5f}, SNR {snr:.2f}\")\n\n# Let's check the folded lightcurve for 6.93331 at WL 0.5\nflat = lc.flatten(window_length=int(0.5/cadence)|1)\npg = flat.to_periodogram(method='bls', minimum_period=6.8, maximum_period=7.0, frequency_factor=1000)\nbest_p = pg.period_at_max_power.value\nprint(f\"Refined P around 6.93: {best_p:.5f}\")\nEOF\npython3 final_check_v2.py\n"]
