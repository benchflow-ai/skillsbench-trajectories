[57.703732, "i", "cat << 'EOF' > final_check.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\n# Try a few different flattening windows to see if the period stays the same\nperiods = []\nfor wl in [71, 101, 151, 201]:\n    flat = lc.flatten(window_length=wl)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=20, frequency_factor=20)\n    periods.append(pg.period_at_max_power.value)\n    print(f\"Window {wl}: {pg.period_at_max_power.value}\")\n\nprint(f\"Mean period: {np.mean(periods)}\")\nEOF\npython3 final_check.py\n"]
