[112.556727, "o", "from scipy.signal import medfilt\r\n\u001b[?2004l\r"]
[112.556751, "o", "\u001b[?2004h"]
[112.556772, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.556842, "o", "data = np.loadtxt('/root/data/tess_lc.txt')\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.556865, "o", "> "]
[112.556894, "o", "mask = (data[:, 2] == 0)\r\n\u001b[?2004l\r"]
