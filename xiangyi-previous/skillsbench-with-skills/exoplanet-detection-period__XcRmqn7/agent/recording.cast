[124.599577, "i", "cat << 'EOF' > find_period_v5.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\ntime = data[mask, 0]\nflux = data[mask, 1]\nflux_err = data[mask, 3]\nlc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err).remove_outliers(sigma=5)\n\ncadence = np.median(np.diff(lc.time.value))\n\n# Try a range of windows\nfor wl_days in [0.4, 0.6, 0.8, 1.0]:\n    wl_pts = int(wl_days / cadence)\n    if wl_pts % 2 == 0: wl_pts += 1\n    flat = lc.flatten(window_length=wl_pts)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n    best_p = pg.period_at_max_power.value\n    snr = pg.snr[np.argmax(pg.power)]\n    print(f\"WL: {wl_days}d, Period: {best_p:.5f}, SNR: {snr:.2f}\")\n\n# Let's also check the periodogram of the 1.0 day flattened lightcurve specifically\nflat = lc.flatten(window_length=int(0.8 / cadence) | 1)\npg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n# Look at "]
[124.599624, "i", "top peaks\nprint(\"\\nTop peaks for 0.8d window:\")\nindices = np.argsort(pg.power)[::-1]\nfor i in range(10):\n    idx = indices[i]\n    # Filter out very close periods\n    if i > 0 and np.any(np.abs(pg.period[indices[:i]].value - pg.period[idx].value) < 0.01):\n        continue\n    print(f\"Period: {pg.period[idx].value:.5f}, Power: {pg.power[idx].value:.2f}, SNR: {pg.snr[idx].value:.2f}\")\n\nEOF\npython3 find_period_v5.py\n"]
