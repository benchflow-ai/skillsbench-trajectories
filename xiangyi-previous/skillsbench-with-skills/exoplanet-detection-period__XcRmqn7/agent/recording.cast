[73.24407, "i", "cat << 'EOF' > investigate.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\n# Stellar variability removal - more robust\n# Let's try to remove the dominant rotation period first if possible\n# or use a smaller window for flatten but be careful not to remove the transit.\n\n# Let's try wl=101 again but with a wider period search and more frequency resolution\nflat = lc.flatten(window_length=101)\npg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=10, frequency_factor=100)\n\n# Get top 5 peaks\nimport pandas as pd\n# Accessing private attributes is not ideal but works for debugging\n# Actually let's just use the periodogram object's properties\n\nprint(\"Top peaks:\")\nfor i in range(5):\n    p = pg.period[np.argsort(pg.power)[-1-i]]\n    pow = np.sort(pg.power)[-1-i]\n    print(f\"Period: {p.value:.6f}, Power: {pow:.6f}\")\n\n# C"]
[73.244212, "i", "heck the 2.68 and 5.35 relationship\nEOF\npython3 investigate.py\n"]
