[232.595806, "i", "cat << 'EOF' > check_consistency.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Try to remove the 1.407d rotation by folding and subtracting\nperiod_rot = 1.40713\nfolded_rot = lc.fold(period=period_rot)\n# (This is just an idea, maybe not best)\n\n# Let's try a very small window for flatten to really get rid of the 1.4d signal\n# but not so small that it kills a transit (typical transit is 2-4 hours)\n# 0.2 days is 4.8 hours.\nflat = lc.flatten(window_length=int(0.2/cadence)|1)\npg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=500)\n\nprint(\"Top peaks with 0.2d window:\")\nindices = np.argsort(pg.power)[::-1]\nfor i in range(5):\n    idx = indices[i]\n    print(f\"P: {pg.period[idx].value:.5f}, SNR: {pg.snr[idx].value:.2f}\")\n\nEOF\npython3 check_consiste"]
