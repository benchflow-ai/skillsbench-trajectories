[278.332093, "o", "    return BoxLeastSquaresPeriodogram(\r\n  File \"/usr/local/lib/python3.9/site-packages/lightkurve/periodogram.py\", line 1015, in __init__\r\n"]
[278.332297, "o", "    super(BoxLeastSquaresPeriodogram, self).__init__(*args, **kwargs)\r\n  File \"/usr/local/lib/python3.9/site-packages/lightkurve/periodogram.py\", line 89, in __init__\r\n"]
