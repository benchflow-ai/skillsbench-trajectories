[83.639576, "i", "cat << 'EOF' > check_rotation.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\n# Lomb-Scargle for rotation\nls = lc.to_periodogram(method='lombscargle', minimum_period=0.1, maximum_period=20)\nprint(f\"Rotation period peak: {ls.period_at_max_power.value}\")\n\n# Flatten with a window related to rotation but still suitable for transits\n# If rotation is ~5 days, wl=101 (3.3 hrs) should be fine. \n# Let's try to find the best period again with a very high frequency factor.\nflat = lc.flatten(window_length=101)\npg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\nprint(f\"Best BLS period: {pg.period_at_max_power.value}\")\n\n# Fold and check depth\nfolded = flat.fold(period=pg.period_at_max_power.value)\n# We can't see the plot, but we can check the signal-to-noise ratio\nprint(f\"SNR: {pg.max_power / "]
[83.639622, "i", "pg.power.mean()}\")\nEOF\npython3 check_rotation.py\n"]
