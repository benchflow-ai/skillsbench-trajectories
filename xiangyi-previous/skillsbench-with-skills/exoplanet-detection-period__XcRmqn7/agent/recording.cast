[184.195422, "i", "cat << 'EOF' > check_folded_v3.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Try several flattening windows\nfor wl_days in [0.4, 0.5, 0.6]:\n    flat = lc.flatten(window_length=int(wl_days/cadence)|1)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n    \n    p = pg.period_at_max_power.value\n    t0 = pg.transit_time_at_max_power.value\n    dur = pg.duration_at_max_power.value\n    \n    folded = flat.fold(period=p, epoch_time=t0)\n    in_transit = np.abs(folded.time.value) < (dur / 2.0)\n    depth = 1.0 - np.median(folded.flux[in_transit])\n    std = np.std(folded.flux[~in_transit])\n    snr = depth / (std / np.sqrt(np.sum(in_transit)))\n    print(f\"WL: {wl_days}, P: {p:.5f}, SNR: {snr:.2f}, Depth: {depth:.5f}\")\n\nEOF\npython3 check_folde"]
[184.195598, "i", "d_v3.py\n"]
[184.195617, "o", "cat << 'EOF' > check_folded_v3.py\r\n\u001b[?2004l\r"]
[184.195714, "o", "\u001b[?2004h> "]
[184.195743, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.195792, "o", "import lightkurve as lk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.195802, "o", "\u001b[?2004h> "]
[184.195902, "o", "data = np.loadtxt('/root/data/tess_lc.txt')\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.19591, "o", "> "]
[184.195976, "o", "mask = (data[:, 2] == 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.195986, "o", "> "]
[184.196156, "o", "lc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.196167, "o", "> "]
[184.196232, "o", "lc = lc.remove_outliers(sigma=5)\r\n\u001b[?2004l\r"]
[184.196269, "o", "\u001b[?2004h> "]
[184.196337, "o", "cadence = np.median(np.diff(lc.time.value))\r\n\u001b[?2004l\r"]
[184.196372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.196399, "o", "\u001b[?2004h> "]
[184.196444, "o", "# Try several flattening windows\r\n\u001b[?2004l\r"]
[184.196476, "o", "\u001b[?2004h> "]
[184.196532, "o", "for wl_days in [0.4, 0.5, 0.6]:\r\n\u001b[?2004l\r"]
[184.196565, "o", "\u001b[?2004h> "]
[184.196674, "o", "    flat = lc.flatten(window_length=int(wl_days/cadence)|1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.196684, "o", "> "]
[184.1969, "o", "    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.196912, "o", ">     \r\n"]
[184.196951, "o", "\u001b[?2004l\r"]
[184.196959, "o", "\u001b[?2004h> "]
[184.197024, "o", "    p = pg.period_at_max_power.value\r\n\u001b[?2004l\r"]
[184.197045, "o", "\u001b[?2004h> "]
[184.197124, "o", "    t0 = pg.transit_time_at_max_power.value\r\n"]
[184.197156, "o", "\u001b[?2004l\r"]
[184.197164, "o", "\u001b[?2004h"]
[184.19717, "o", "> "]
[184.197268, "o", "    dur = pg.duration_at_max_power.value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.197284, "o", "    \r\n\u001b[?2004l\r"]
[184.197297, "o", "\u001b[?2004h"]
[184.197303, "o", "> "]
[184.197407, "o", "    folded = flat.fold(period=p, epoch_time=t0)\r\n\u001b[?2004l\r"]
[184.19744, "o", "\u001b[?2004h> "]
[184.197537, "o", "    in_transit = np.abs(folded.time.value) < (dur / 2.0)\r\n\u001b[?2004l\r"]
[184.197577, "o", "\u001b[?2004h> "]
[184.197675, "o", "    depth = 1.0 - np.median(folded.flux[in_transit])\r\n\u001b[?2004l\r"]
[184.197685, "o", "\u001b[?2004h"]
[184.197691, "o", "> "]
[184.197772, "o", "    std = np.std(folded.flux[~in_transit])\r\n\u001b[?2004l\r"]
[184.197807, "o", "\u001b[?2004h> "]
[184.1979, "o", "    snr = depth / (std / np.sqrt(np.sum(in_transit)))\r\n\u001b[?2004l\r"]
[184.197931, "o", "\u001b[?2004h> "]
[184.198063, "o", "    print(f\"WL: {wl_days}, P: {p:.5f}, SNR: {snr:.2f}, Depth: {depth:.5f}\")\r\n\u001b[?2004l\r"]
[184.198103, "o", "\u001b[?2004h"]
[184.198113, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.198171, "o", "EOF\r\n\u001b[?2004l\r"]
[184.199412, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
[184.199468, "o", "python3 check_folded_v3.py\r\n\u001b[?2004l\r"]
[186.765589, "o", "WL: 0.4, P: 1.33805, SNR: 8.54, Depth: 0.00042\r\n"]
[186.84946, "o", "WL: 0.5, P: 1.33805, SNR: 8.89, Depth: 0.00044\r\n"]
[186.932599, "o", "WL: 0.6, P: 0.50390, SNR: 3.03, Depth: 0.00004\r\n"]
[187.213007, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
[195.454501, "i", "cat << 'EOF' > check_2.68.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Try to find the best period around 2.67-2.68\nflat = lc.flatten(window_length=int(0.8/cadence)|1)\npg = flat.to_periodogram(method='bls', minimum_period=2.6, maximum_period=2.7, frequency_factor=500)\np = pg.period_at_max_power.value\nt0 = pg.transit_time_at_max_power.value\ndur = pg.duration_at_max_power.value\nsnr = pg.snr.max()\nprint(f\"Period around 2.68: {p:.5f}, SNR: {snr:.2f}, Depth: {pg.depth_at_max_power.value:.5f}\")\n\n# Check 5.352 again\npg2 = flat.to_periodogram(method='bls', minimum_period=5.3, maximum_period=5.4, frequency_factor=500)\np2 = pg2.period_at_max_power.value\nprint(f\"Period around 5.35: {p2:.5f}, SNR: {pg2.snr.max():.2f}, Depth: {pg2.depth_at_max_power.value:.5f}\")\nEOF\npython3 check_2.68.py\n"]
