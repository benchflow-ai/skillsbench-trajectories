[43.93447, "i", "cat << 'EOF' > find_period_refined.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\n# Flattening\nflat_lc = lc.flatten(window_length=101)\n\n# High resolution BLS search\n# The default frequency_factor is 1. Let's increase it to get better precision.\npg = flat_lc.to_periodogram(method='bls', minimum_period=0.5, maximum_period=20, frequency_factor=50)\n\nbest_period = pg.period_at_max_power.value\nprint(f\"Best period (high res): {best_period}\")\n\n# Save with 5 decimal places\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period:.5f}\\n\")\nEOF\npython3 find_period_refined.py\n"]
