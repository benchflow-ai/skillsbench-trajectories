[207.747002, "i", "cat << 'EOF' > find_best_snr.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Detrend\nflat = lc.flatten(window_length=int(0.5/cadence)|1)\n\n# Search\npg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=500)\n\n# Get top peaks\nindices = np.argsort(pg.power)[::-1]\nseen_periods = []\nfor idx in indices:\n    p = pg.period[idx].value\n    if any(np.abs(p - sp) < 0.05 for sp in seen_periods):\n        continue\n    seen_periods.append(p)\n    snr = pg.snr[idx].value\n    depth = pg.depth[idx].value\n    print(f\"Period: {p:.5f}, SNR: {snr:.2f}, Depth: {depth:.5f}\")\n    if len(seen_periods) >= 5:\n        break\n\nbest_p = seen_periods[0]\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_p:.5f}\\n\")\nEOF\npython3 find_best_snr.py\n"]
