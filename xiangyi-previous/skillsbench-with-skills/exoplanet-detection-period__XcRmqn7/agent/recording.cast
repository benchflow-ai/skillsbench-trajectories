[243.756084, "i", "cat << 'EOF' > find_consistent.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\nfor wl in [0.3, 0.4, 0.5]:\n    flat = lc.flatten(window_length=int(wl/cadence)|1)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=500)\n    print(f\"WL {wl}: Best P {pg.period_at_max_power.value:.5f}, SNR {pg.snr.max():.2f}\")\n    # Also print top 3\n    indices = np.argsort(pg.power)[::-1]\n    seen = []\n    for idx in indices:\n        p = pg.period[idx].value\n        if any(np.abs(p-s)<0.05 for s in seen): continue\n        seen.append(p)\n        print(f\"  P: {p:.5f}, SNR: {pg.snr[idx].value:.2f}\")\n        if len(seen) >= 3: break\nEOF\npython3 find_consistent.py\n"]
