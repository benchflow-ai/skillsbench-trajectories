[57.704331, "o", "lc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.70439, "o", "lc = lc.remove_outliers(sigma=5)\r\n\u001b[?2004l\r"]
[57.704416, "o", "\u001b[?2004h> "]
[57.704452, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.704571, "o", "# Try a few different flattening windows to see if the period stays the same\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.704582, "o", "periods = []\r\n\u001b[?2004l\r"]
[57.704637, "o", "\u001b[?2004h> "]
