[275.914588, "i", "cat << 'EOF' > final_precision.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\nflat = lc.flatten(window_length=int(0.7/cadence)|1)\n# Search with extremely high resolution around the peak\npg = flat.to_periodogram(method='bls', minimum_period=6.93, maximum_period=6.94, frequency_factor=2000)\n\nbest_p = pg.period_at_max_power.value\nprint(f\"{best_p:.5f}\")\n\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_p:.5f}\\n\")\nEOF\npython3 final_precision.py\n"]
