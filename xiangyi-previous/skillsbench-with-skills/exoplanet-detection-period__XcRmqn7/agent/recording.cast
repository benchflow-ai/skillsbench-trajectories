[135.318998, "i", "cat << 'EOF' > verify_7.76.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\ncadence = np.median(np.diff(lc.time.value))\nflat = lc.flatten(window_length=int(0.8 / cadence) | 1)\n\nperiod = 7.76599\npg = flat.to_periodogram(method='bls', minimum_period=period-0.1, maximum_period=period+0.1, frequency_factor=500)\nbest_p = pg.period_at_max_power.value\nsnr = pg.snr[np.argmax(pg.power)]\nprint(f\"Refined Period: {best_p:.5f}, SNR: {snr:.2f}\")\n\n# Check if 7.76599 is consistent across different flattenings\nfor wl in [0.7, 0.8, 0.9, 1.1]:\n    f = lc.flatten(window_length=int(wl / cadence) | 1)\n    p = f.to_periodogram(method='bls', minimum_period=7.5, maximum_period=8.0, frequency_factor=100)\n    print(f\"WL {wl}: {p.period_at_max_power.value:.5f}, SNR: {p.snr.max():.2f}\")\n\nEOF\npython3 verify_7.76.py\n"]
