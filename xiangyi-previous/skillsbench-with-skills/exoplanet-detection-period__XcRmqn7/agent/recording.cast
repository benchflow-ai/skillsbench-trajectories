[147.391281, "i", "cat << 'EOF' > find_robust_period.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\ntime = data[mask, 0]\nflux = data[mask, 1]\nflux_err = data[mask, 3]\nlc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err).remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Try to find a period that shows up consistently\nresults = []\nfor wl_days in [0.7, 0.8, 0.9, 1.0, 1.2]:\n    wl_pts = int(wl_days / cadence) | 1\n    flat = lc.flatten(window_length=wl_pts)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n    results.append(pg)\n    print(f\"WL: {wl_days}d, Best: {pg.period_at_max_power.value:.5f}, SNR: {pg.snr.max():.2f}\")\n\n# Sum the power of all periodograms to find the most consistent peak\n# (First interpolate to a common frequency grid)\ncommon_periods = results[0].period\ncombined_power = np.zeros_like(results[0].power.value)\nfor pg in results:\n    combined_power += np.interp(commo"]
[147.391438, "i", "n_periods.value, pg.period.value, pg.power.value)\n\nbest_idx = np.argmax(combined_power)\nbest_p = common_periods[best_idx].value\nprint(f\"Combined Best Period: {best_p:.5f}\")\n\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_p:.5f}\\n\")\nEOF\npython3 find_robust_period.py\n"]
[147.391454, "o", "cat << 'EOF' > find_robust_period.py\r\n"]
[147.392072, "o", "\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import lightkurve as lk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')\r\n\u001b[?2004l\r\u001b[?2004h> mask = (data[:, 2] == 0)\r\n\u001b[?2004l\r\u001b[?2004h> time = data[mask, 0]\r\n\u001b[?2004l\r\u001b[?2004h> flux = data[mask, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.392149, "o", "flux_err = data[mask, 3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.392267, "o", "lc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err).remove_outliers(sigma=5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.392375, "o", "cadence = np.median(np.diff(lc.time.value))\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.392416, "o", "> \r\n\u001b[?2004l\r"]
[147.392479, "o", "\u001b[?2004h> "]
[147.392509, "o", "# Try to find a period that shows up consistently\r\n\u001b[?2004l\r"]
[147.392543, "o", "\u001b[?2004h> "]
[147.392581, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.392662, "o", "for wl_days in [0.7, 0.8, 0.9, 1.0, 1.2]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.392689, "o", "> "]
[147.392768, "o", "    wl_pts = int(wl_days / cadence) | 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.392802, "o", "> "]
[147.392877, "o", "    flat = lc.flatten(window_length=wl_pts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.392915, "o", "> "]
[147.393122, "o", "    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.393177, "o", "    results.append(pg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.393376, "o", "    print(f\"WL: {wl_days}d, Best: {pg.period_at_max_power.value:.5f}, SNR: {pg.snr.max():.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.393425, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.393551, "o", "# Sum the power of all periodograms to find the most consistent peak\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.393565, "o", "> "]
[147.39367, "o", "# (First interpolate to a common frequency grid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.393706, "o", "> "]
[147.393755, "o", "common_periods = results[0].period\r\n\u001b[?2004l\r"]
[147.39379, "o", "\u001b[?2004h> "]
[147.393892, "o", "combined_power = np.zeros_like(results[0].power.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.393932, "o", "> "]
[147.393945, "o", "for pg in results:\r\n\u001b[?2004l\r"]
[147.393984, "o", "\u001b[?2004h"]
[147.394037, "o", "> "]
[147.39414, "o", "    combined_power += np.interp(common_periods.value, pg.period.value, pg.power.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.394193, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[147.394226, "o", "> "]
[147.394275, "o", "best_idx = np.argmax(combined_power)\r\n\u001b[?2004l\r"]
[147.394314, "o", "\u001b[?2004h> "]
[147.394361, "o", "best_p = common_periods[best_idx].value\r\n\u001b[?2004l\r"]
[147.394379, "o", "\u001b[?2004h> "]
[147.394447, "o", "print(f\"Combined Best Period: {best_p:.5f}\")\r\n\u001b[?2004l\r"]
[147.394482, "o", "\u001b[?2004h> \r\n"]
[147.394503, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[147.394545, "o", "with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[147.394555, "o", "\u001b[?2004h> "]
[147.394608, "o", "    f.write(f\"{best_p:.5f}\\n\")\r\n\u001b[?2004l\r"]
[147.394642, "o", "\u001b[?2004h> "]
[147.394665, "o", "EOF\r\n\u001b[?2004l\r"]
[147.396359, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
[147.396407, "o", "python3 find_robust_period.py\r\n\u001b[?2004l\r"]
[150.144309, "o", "WL: 0.7d, Best: 7.76599, SNR: 36.71\r\n"]
[150.221632, "o", "WL: 0.8d, Best: 7.76599, SNR: 36.61\r\n"]
[150.30759, "o", "WL: 0.9d, Best: 0.54648, SNR: 41.34\r\n"]
[150.396316, "o", "WL: 1.0d, Best: 0.54648, SNR: 48.57\r\n"]
[150.48028, "o", "WL: 1.2d, Best: 1.39582, SNR: 84.31\r\n"]
[150.480633, "o", "Combined Best Period: 1.39582\r\n"]
[150.874183, "o", "\u001b[?2004h"]
[150.883504, "o", "root@fb04da87aec8:~# "]
[163.24106, "i", "cat << 'EOF' > check_folded.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\ndef check_p(p, wl_days):\n    flat = lc.flatten(window_length=int(wl_days/cadence)|1)\n    folded = flat.fold(period=p)\n    # Calculate SNR of the folded transit\n    # Use a simple depth/std approach\n    in_transit = np.abs(folded.time.value) < 0.05 # assume 0.1 day duration\n    depth = 1.0 - np.median(folded.flux[in_transit])\n    std = np.std(folded.flux[~in_transit])\n    snr = depth / (std / np.sqrt(np.sum(in_transit)))\n    return snr, depth\n\nfor p in [7.76599, 1.39582, 0.54648, 6.58052]:\n    snr, depth = check_p(p, 0.5)\n    print(f\"Period {p:.5f}: SNR {snr:.2f}, Depth {depth:.5f}\")\n\nEOF\npython3 check_folded.py\n"]
[163.241222, "o", "cat << 'EOF' > check_folded.py\r\n\u001b[?2004l\r"]
[163.24128, "o", "\u001b[?2004h> "]
[163.241316, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[163.241344, "o", "\u001b[?2004h"]
[163.241366, "o", "> "]
[163.241398, "o", "import lightkurve as lk\r\n\u001b[?2004l\r"]
[163.241417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[163.241449, "o", "\u001b[?2004h> "]
[163.241545, "o", "data = np.loadtxt('/root/data/tess_lc.txt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.241615, "o", "mask = (data[:, 2] == 0)\r\n\u001b[?2004l\r"]
[163.241626, "o", "\u001b[?2004h"]
[163.241658, "o", "> "]
[163.241773, "o", "lc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.241839, "o", "lc = lc.remove_outliers(sigma=5)\r\n\u001b[?2004l\r"]
[163.241867, "o", "\u001b[?2004h> "]
[163.241922, "o", "cadence = np.median(np.diff(lc.time.value))\r\n\u001b[?2004l\r"]
[163.241945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[163.241968, "o", "> "]
[163.241995, "o", "def check_p(p, wl_days):\r\n\u001b[?2004l\r"]
[163.242019, "o", "\u001b[?2004h> "]
[163.242099, "o", "    flat = lc.flatten(window_length=int(wl_days/cadence)|1)\r\n\u001b[?2004l\r"]
[163.242118, "o", "\u001b[?2004h> "]
[163.24218, "o", "    folded = flat.fold(period=p)\r\n\u001b[?2004l\r"]
[163.242203, "o", "\u001b[?2004h"]
[163.242225, "o", "> "]
[163.242269, "o", "    # Calculate SNR of the folded transit\r\n\u001b[?2004l\r"]
[163.242285, "o", "\u001b[?2004h> "]
[163.242341, "o", "    # Use a simple depth/std approach\r\n\u001b[?2004l\r"]
[163.242362, "o", "\u001b[?2004h> "]
[163.24247, "o", "    in_transit = np.abs(folded.time.value) < 0.05 # assume 0.1 day duration\r\n\u001b[?2004l\r"]
[163.242496, "o", "\u001b[?2004h> "]
[163.242564, "o", "    depth = 1.0 - np.median(folded.flux[in_transit])\r\n\u001b[?2004l\r"]
[163.242595, "o", "\u001b[?2004h> "]
[163.242644, "o", "    std = np.std(folded.flux[~in_transit])\r\n\u001b[?2004l\r"]
[163.242664, "o", "\u001b[?2004h> "]
[163.242741, "o", "    snr = depth / (std / np.sqrt(np.sum(in_transit)))\r\n\u001b[?2004l\r"]
[163.242763, "o", "\u001b[?2004h> "]
[163.24279, "o", "    return snr, depth\r\n\u001b[?2004l\r"]
[163.242815, "o", "\u001b[?2004h> "]
[163.242836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.242902, "o", "for p in [7.76599, 1.39582, 0.54648, 6.58052]:\r\n\u001b[?2004l\r"]
[163.242923, "o", "\u001b[?2004h> "]
[163.24298, "o", "    snr, depth = check_p(p, 0.5)\r\n\u001b[?2004l\r"]
[163.243, "o", "\u001b[?2004h> "]
[163.243089, "o", "    print(f\"Period {p:.5f}: SNR {snr:.2f}, Depth {depth:.5f}\")\r\n\u001b[?2004l\r"]
[163.243117, "o", "\u001b[?2004h> "]
[163.243138, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[163.244469, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
