[96.408149, "i", "cat << 'EOF' > search_v3.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt('/root/data/tess_lc.txt')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\n\n# Try a more aggressive flattening to remove the 1.4d rotation\n# window_length should be less than the rotation period.\n# 1.4 days is ~1000 cadences (if 2-min cadence). \n# Let's try window_length = 51 (1.7 hours) and 101 (3.3 hours).\n\nfor wl in [51, 101, 201]:\n    flat = lc.flatten(window_length=wl)\n    pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=100)\n    best_p = pg.period_at_max_power.value\n    snr = pg.max_power / pg.power.mean()\n    print(f\"WL: {wl}, Best Period: {best_p:.5f}, SNR: {snr:.2f}\")\n\nEOF\npython3 search_v3.py\n"]
