[11.746527, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m23.0.1\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m25.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[11.796273, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
[19.891327, "i", "cat << 'EOF' > analyze_lc.py\nimport numpy as np\nimport lightkurve as lk\n\n# Load data\ndata = np.loadtxt('/root/data/tess_lc.txt')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Filter by quality flag\nmask = (flag == 0)\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\n# Create LightCurve object\nlc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err)\n\n# Remove outliers\nlc = lc.remove_outliers(sigma=5)\n\n# Detrend the lightcurve (remove stellar variability)\n# flatten() uses a Savitzky-Golay filter by default\nflat_lc = lc.flatten(window_length=101)\n\n# Search for period using BLS\n# We'll search in a reasonable range, e.g., 0.5 to 20 days\nperiodogram = flat_lc.to_periodogram(method='bls', minimum_period=0.5, maximum_period=20)\n\nbest_period = periodogram.period_at_max_power.value\n\nprint(f\"Best period: {best_period}\")\n\n# Write to file\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period:.5f}\\n\")\nEOF\n"]
