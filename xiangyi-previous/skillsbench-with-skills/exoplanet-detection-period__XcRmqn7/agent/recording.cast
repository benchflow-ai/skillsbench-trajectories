[275.915145, "o", "mask = (data[:, 2] == 0)\r\n\u001b[?2004l\r"]
[275.915181, "o", "\u001b[?2004h> "]
[275.915336, "o", "lc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.915376, "o", "> "]
[275.915429, "o", "lc = lc.remove_outliers(sigma=5)\r\n\u001b[?2004l\r"]
[275.915452, "o", "\u001b[?2004h> "]
[275.915609, "o", "cadence = np.median(np.diff(lc.time.value))\r\n\u001b[?2004l\r"]
[275.915644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[275.915667, "o", "\u001b[?2004h> "]
[275.915775, "o", "flat = lc.flatten(window_length=int(0.7/cadence)|1)\r\n\u001b[?2004l\r"]
[275.915801, "o", "\u001b[?2004h> "]
[275.915897, "o", "# Search with extremely high resolution around the peak\r\n\u001b[?2004l\r"]
[275.915924, "o", "\u001b[?2004h> "]
[275.916116, "o", "pg = flat.to_periodogram(method='bls', minimum_period=6.93, maximum_period=6.94, frequency_factor=2000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.916147, "o", "> \r\n\u001b[?2004l\r"]
[275.916168, "o", "\u001b[?2004h> "]
[275.916247, "o", "best_p = pg.period_at_max_power.value\r\n\u001b[?2004l\r"]
[275.91627, "o", "\u001b[?2004h"]
[275.916291, "o", "> "]
[275.916338, "o", "print(f\"{best_p:.5f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[275.916365, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[275.916392, "o", "> "]
[275.916484, "o", "with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[275.916526, "o", "\u001b[?2004h"]
[275.916577, "o", "> "]
[275.9166, "o", "    f.write(f\"{best_p:.5f}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[275.916625, "o", "EOF\r\n\u001b[?2004l\r"]
[275.917815, "o", "\u001b[?2004hroot@fb04da87aec8:~# "]
[275.91783, "o", "python3 final_precision.py"]
[275.917863, "o", "\r\n\u001b[?2004l\r"]
