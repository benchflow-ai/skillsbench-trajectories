[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightkurve as lk
[?2004l[?2004h> 
[?2004l[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')
[?2004l[?2004h> mask = (data[:, 2] == 0)
[?2004l[?2004h> lc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])
