[?2004l[?2004h> pg = flat.to_periodogram(method='bls', minimum_period=0.5, maximum_period=15, frequency_factor=500)
[?2004l[?2004h> 
[?2004l[?2004h> print("Top peaks with 0.2d window:")
[?2004l[?2004h> indices = np.argsort(pg.power)[::-1]
[?2004l[?2004h> for i in range(5):
[?2004l[?2004h>     idx = indices[i]
