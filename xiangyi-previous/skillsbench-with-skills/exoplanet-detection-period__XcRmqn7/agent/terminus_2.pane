[?2004hroot@fb04da87aec8:~# cat << 'EOF' > analyze_lc.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightkurve as lk
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')
[?2004l[?2004h> time = data[:, 0]
[?2004l[?2004h> flux = data[:, 1]
[?2004l[?2004h> flag = data[:, 2]
[?2004l[?2004h> flux_err = data[:, 3]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter by quality flag
[?2004l[?2004h> mask = (flag == 0)
[?2004l[?2004h> time = time[mask]
[?2004l[?2004h> flux = flux[mask]
[?2004l[?2004h> flux_err = flux_err[mask]
[?2004l[?2004h> 
[?2004l[?2004h> # Create LightCurve object
[?2004l[?2004h> lc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err)
[?2004l[?2004h> 
[?2004l[?2004h> # Remove outliers
[?2004l[?2004h> lc = lc.remove_outliers(sigma=5)
[?2004l[?2004h> 
[?2004l[?2004h> # Detrend the lightcurve (remove stellar variability)
[?2004l[?2004h> # flatten() uses a Savitzky-Golay filter by default
[?2004l[?2004h> flat_lc = lc.flatten(window_length=101)
[?2004l[?2004h> 
[?2004l[?2004h> # Search for period using BLS
[?2004l[?2004h> # We'll search in a reasonable range, e.g., 0.5 to 20 days
[?2004l[?2004h> periodogram = flat_lc.to_periodogram(method='bls', minimum_period=0.5, maximum_period=20)
[?2004l[?2004h> 
[?2004l[?2004h> best_period = periodogram.period_at_max_power.value
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Best period: {best_period}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to file
[?2004l[?2004h> with open('/root/period.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{best_period:.5f}\n")
[?2004l[?2004h> EOF
