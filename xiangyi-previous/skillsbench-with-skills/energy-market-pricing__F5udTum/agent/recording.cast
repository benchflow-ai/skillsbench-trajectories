[381.61807, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport pulp\nR1=pulp.LpVariable('R1', lowBound=0)\nR2=pulp.LpVariable('R2', lowBound=0)\nprob=pulp.LpProblem('res', pulp.LpMinimize)\nprob += 0*R1+0*R2\nc1 = (R1 <= 5)\nc2 = (R2 <= 5)\ncreq = (R1 + R2 >= 10)\nprob += c1\nprob += c2\nprob += creq\nprob.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('R1',R1.value(),'R2',R2.value())\nprint('duals cap', c1.pi, c2.pi, 'req', creq.pi)\nPY\n"]
