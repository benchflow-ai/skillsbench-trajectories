[441.203877, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport pulp\n# two generators: cheap G1 (10$/MW) and expensive G2 (50$/MW)\nP1=pulp.LpVariable('P1', lowBound=0)\nP2=pulp.LpVariable('P2', lowBound=0)\nR1=pulp.LpVariable('R1', lowBound=0)\nR2=pulp.LpVariable('R2', lowBound=0)\nprob=pulp.LpProblem('toy2', pulp.LpMinimize)\nprob += 10*P1 + 50*P2\n# demand 9\nprob += (P1 + P2 == 9)\n# limits\nprob += (P1 + R1 <= 10)\nprob += (P2 + R2 <= 2)\n# reserve caps\nprob += (R1 <= 10)\nprob += (R2 <= 2)\n# reserve requirement 2\ncreq = (R1 + R2 >= 2)\nprob += creq\nprob.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('P1',P1.value(),'P2',P2.value(),'R1',R1.value(),'R2',R2.value())\nprint('dual req', creq.pi)\nfor name,c in prob.constraints.items():\n    if name.startswith('_C'):\n        pass\n# print coupling duals\nprint('coupling duals')\nfor nm,c in prob.constraints.items():\n    if 'R1' in str(c) and 'P1' in str(c):\n        print('c1', c, c.pi)\n    if 'R2' in str(c) and 'P2' in str(c):\n        print('c2', c, c.pi)\nPY\n"]
[441.204343, "o", "source /tmp/venv/bin/activate && python3 - <<'PY'\r\n\u001b[?2004l\r"]
