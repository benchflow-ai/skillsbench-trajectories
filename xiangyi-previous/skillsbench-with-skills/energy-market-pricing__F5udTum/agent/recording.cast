[160.360799, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport json, numpy as np\nwith open('network.json') as f:\n    data=json.load(f)\nmodels=[row[0] for row in data['gencost']]\nprint('gencost model counts:', {m:models.count(m) for m in set(models)})\n# NCOST stats\nncost=[row[3] for row in data['gencost']]\nprint('ncost unique:', sorted(set(ncost))[:10], 'max', max(ncost))\nprint('first gencost row', data['gencost'][0])\nprint('second gencost row', data['gencost'][1])\nprint('reserve_capacity sample', data['reserve_capacity'][:5])\nPY\n"]
