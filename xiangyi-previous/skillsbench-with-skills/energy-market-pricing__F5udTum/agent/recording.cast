[441.276789, "o", "P1 9.0 P2 0.0 R1 1.0 R2 1.0\r\ndual req 0.0\r\ncoupling duals\r\nc1 P1 + R1 <= 10 0.0\r\nc2 P2 + R2 <= 2 0.0\r\n"]
[441.284362, "o", "\u001b[?2004h(venv) root@bb7f2498d3f9:~# "]
[498.701314, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport pulp\n# Gen1 cheap, Pmax=10; Gen2 expensive, Pmax=10\nP1=pulp.LpVariable('P1', lowBound=0)\nP2=pulp.LpVariable('P2', lowBound=0)\nR1=pulp.LpVariable('R1', lowBound=0)\nR2=pulp.LpVariable('R2', lowBound=0)\nprob=pulp.LpProblem('toy3', pulp.LpMinimize)\nprob += 10*P1 + 100*P2\n# demand 10\nprob += (P1 + P2 == 10)\n# limits and coupling\nprob += (P1 + R1 <= 10)\nprob += (P2 + R2 <= 10)\nprob += (R1 <= 10)\nprob += (R2 <= 10)\n# reserve requirement 1\ncreq = (R1 + R2 >= 1)\nprob += creq\nprob.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('P1',P1.value(),'P2',P2.value(),'R1',R1.value(),'R2',R2.value())\nprint('dual req', creq.pi)\nPY\n"]
