[300.984822, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport pulp\n# simple 1-bus test\nPg = pulp.LpVariable('Pg', lowBound=0)\nprob = pulp.LpProblem('test', pulp.LpMinimize)\nprob += 10*Pg\nc = (Pg == 5)\nprob += c\nprob.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('Pg', Pg.value(), 'dual', c.pi)\n# now with constraint Pg == PD (5) but as Pg - PD == 0\nPg2 = pulp.LpVariable('Pg2', lowBound=0)\nprob2 = pulp.LpProblem('test2', pulp.LpMinimize)\nprob2 += 10*Pg2\nc2 = (Pg2 - 5 == 0)\nprob2 += c2\nprob2.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('Pg2', Pg2.value(), 'dual', c2.pi)\nPY\n"]
