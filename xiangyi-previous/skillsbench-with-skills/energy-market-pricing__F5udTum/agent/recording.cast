[340.936034, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport json, math\nwith open('network.json') as f:\n    data=json.load(f)\nbranch=data['branch']\nxs=[row[3] for row in branch]\nprint('x min', min(xs), 'zero count', sum(1 for x in xs if abs(x)<1e-9))\nrateA=[row[5] for row in branch]\nprint('rateA zero count', sum(1 for r in rateA if r==0))\n# tap ratios\nT=[row[8] for row in branch]\nprint('tap min', min(T), 'max', max(T), 'zero count', sum(1 for t in T if t==0))\n# status counts\nstatus=[row[10] for row in branch]\nprint('status counts', {s:status.count(s) for s in set(status)})\nPY\n"]
