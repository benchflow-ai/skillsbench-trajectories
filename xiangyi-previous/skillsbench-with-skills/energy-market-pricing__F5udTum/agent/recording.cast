[422.531039, "i", "source /tmp/venv/bin/activate && python3 - <<'PY'\nimport pulp\n# toy: one generator, demand 9, Pmax=10, reserve requirement 1; cost 10 per MW\nPg = pulp.LpVariable('Pg', lowBound=0)\nRg = pulp.LpVariable('Rg', lowBound=0)\nprob = pulp.LpProblem('toy', pulp.LpMinimize)\nprob += 10*Pg\nprob += (Pg == 9)\nprob += (Rg <= 5)\nprob += (Pg + Rg <= 10)\ncreq = (Rg >= 1)\nprob += creq\nprob.solve(pulp.PULP_CBC_CMD(msg=False))\nprint('Pg', Pg.value(),'Rg',Rg.value(),'dual req', creq.pi)\nPY\n"]
