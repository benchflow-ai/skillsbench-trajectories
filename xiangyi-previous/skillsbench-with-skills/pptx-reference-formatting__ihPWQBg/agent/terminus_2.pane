[?2004hroot@d0035c90459a:~# cat > process_pptx.py << 'EOF'
[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.util import Inches, Pt
[?2004l[?2004h> from pptx.enum.shapes import MSO_SHAPE_TYPE
[?2004l[?2004h> from pptx.dml.color import RGBColor
[?2004l[?2004h> from pptx.enum.text import PP_ALIGN
[?2004l[?2004h> 
[?2004l[?2004h> # Load the presentation
[?2004l[?2004h> prs = Presentation('/root/Awesome-Agent-Papers.pptx')
[?2004l[?2004h> 
[?2004l[?2004h> # Store paper titles for the reference slide
[?2004l[?2004h> paper_titles = []
[?2004l[?2004h> 
[?2004l[?2004h> print("Processing dangling paper titles...\n")
[?2004l[?2004h> 
[?2004l[?2004h> # Process each slide (skip the first title slide)
[?2004l[?2004h> for slide_idx, slide in enumerate(prs.slides):
[?2004l[?2004h>     print(f"Processing Slide {slide_idx + 1}...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Find text boxes (dangling paper titles)
[?2004l[?2004h>     for shape in slide.shapes:
[?2004l[?2004h>         if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:
[?2004l[?2004h>             print(f"  Found text box: {shape.text[:50]}...")
[?2004l[?2004h>             
[?2004l[?2004h>             # Store the paper title
[?2004l[?2004h>             paper_title = shape.text.strip()
[?2004l[?2004h>             if paper_title and paper_title not in paper_titles:
[?2004l[?2004h>                 paper_titles.append(paper_title)
[?2004l[?2004h>             
[?2004l[?2004h>             # Format the text
[?2004l[?2004h>             if hasattr(shape, 'text_frame') and shape.text_frame:
[?2004l[?2004h>                 text_frame = shape.text_frame
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Set text alignment to center
[?2004l[?2004h>                 for paragraph in text_frame.paragraphs:
[?2004l[?2004h>                     paragraph.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>                     
[?2004l[?2004h>                     for run in paragraph.runs:
[?2004l[?2004h>                         # Set font properties
[?2004l[?2004h>                         run.font.name = 'Arial'
[?2004l[?2004h>                         run.font.size = Pt(16)
[?2004l[?2004h>                         run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)  # #989596
[?2004l[?2004h>                         run.font.bold = False
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Disable word wrap to keep text in one line
[?2004l[?2004h>                 text_frame.word_wrap = False
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Get slide dimensions
[?2004l[?2004h>                 slide_width = prs.slide_width
[?2004l[?2004h>                 slide_height = prs.slide_height
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Calculate text width (estimate based on character count)
[?2004l[?2004h>                 # Approximately 0.1 inches per character for 16pt Arial
[?2004l[?2004h>                 text_length = len(shape.text)
[?2004l[?2004h>                 estimated_width = Pt(16 * text_length * 0.6)  # rough estimate
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Set a reasonable max width (90% of slide width)
[?2004l[?2004h>                 max_width = slide_width * 0.9
[?2004l[?2004h>                 box_width = min(estimated_width, max_width)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Position at bottom center
[?2004l[?2004h>                 shape.width = box_width
[?2004l[?2004h>                 shape.height = Pt(30)  # Fixed height for single line
[?2004l[?2004h>                 shape.left = (slide_width - box_width) // 2  # Center horizontally
[?2004l[?2004h>                 shape.top = slide_height - Pt(60)  # 60pt from bottom
[?2004l[?2004h>                 
[?2004l[?2004h>                 print(f"    Formatted and repositioned to bottom center")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nFound {len(paper_titles)} unique paper titles")
[?2004l[?2004h> for i, title in enumerate(paper_titles, 1):
[?2004l[?2004h>     print(f"  {i}. {title}")
[?2004l[?2004h> 
[?2004l[?2004h> # Create References slide
[?2004l[?2004h> print("\nCreating References slide...")
[?2004l[?2004h> 
[?2004l[?2004h> # Use a blank layout or title and content layout
[?2004l[?2004h> title_content_layout = prs.slide_layouts[1]  # Usually "Title and Content"
[?2004l[?2004h> reference_slide = prs.slides.add_slide(title_content_layout)
[?2004l[?2004h> 
[?2004l[?2004h> # Set the title
[?2004l[?2004h> title_shape = reference_slide.shapes.title
[?2004l[?2004h> title_shape.text = "Reference"
[?2004l[?2004h> 
[?2004l[?2004h> # Find the content placeholder
[?2004l[?2004h> content_placeholder = None
[?2004l[?2004h> for shape in reference_slide.shapes:
[?2004l[?2004h>     if shape.has_text_frame and shape != title_shape:
[?2004l[?2004h>         content_placeholder = shape
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> if content_placeholder:
[?2004l[?2004h>     text_frame = content_placeholder.text_frame
[?2004l[?2004h>     text_frame.clear()  # Clear any default text
[?2004l[?2004h>     
[?2004l[?2004h>     # Add each paper title as a numbered bullet point
[?2004l[?2004h>     for i, title in enumerate(paper_titles):
[?2004l[?2004h>         if i == 0:
[?2004l[?2004h>             p = text_frame.paragraphs[0]
[?2004l[?2004h>         else:
[?2004l[?2004h>             p = text_frame.add_paragraph()
[?2004l[?2004h>         
[?2004l[?2004h>         p.text = title
[?2004l[?2004h>         p.level = 0
