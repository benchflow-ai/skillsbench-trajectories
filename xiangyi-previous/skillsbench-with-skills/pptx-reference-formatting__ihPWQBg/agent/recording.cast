[100.724672, "o", "\u001b[?2004h> "]
[100.724728, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.724859, "o", "                print(f\"    Formatted and repositioned to bottom center\")\r\n\u001b[?2004l\r"]
[100.724907, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.724959, "o", "\u001b[?2004h> "]
[100.725018, "o", "print(f\"\\nFound {len(paper_titles)} unique paper titles\")\r\n\u001b[?2004l\r"]
[100.72507, "o", "\u001b[?2004h> "]
[100.725126, "o", "for i, title in enumerate(paper_titles, 1):\r\n\u001b[?2004l\r"]
[100.725178, "o", "\u001b[?2004h> "]
[100.725222, "o", "    print(f\"  {i}. {title}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.725267, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.725311, "o", "# Create References slide\r\n\u001b[?2004l\r"]
[100.725354, "o", "\u001b[?2004h> "]
[100.725412, "o", "print(\"\\nCreating References slide...\")\r\n\u001b[?2004l\r"]
[100.725462, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.72555, "o", "# Use a blank layout or title and content layout\r\n\u001b[?2004l\r"]
[100.725598, "o", "\u001b[?2004h> "]
[100.72571, "o", "title_content_layout = prs.slide_layouts[1]  # Usually \"Title and Content\"\r\n\u001b[?2004l\r"]
[100.725762, "o", "\u001b[?2004h> "]
[100.725849, "o", "reference_slide = prs.slides.add_slide(title_content_layout)\r\n\u001b[?2004l\r"]
[100.7259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.72595, "o", "# Set the title\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.726, "o", "> "]
[100.726035, "o", "title_shape = reference_slide.shapes.title\r\n\u001b[?2004l\r"]
[100.726079, "o", "\u001b[?2004h> "]
[100.726118, "o", "title_shape.text = \"Reference\"\r\n\u001b[?2004l\r"]
[100.726143, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.726192, "o", "\u001b[?2004h> "]
[100.726259, "o", "# Find the content placeholder\r\n\u001b[?2004l\r"]
[100.726308, "o", "\u001b[?2004h> "]
[100.726356, "o", "content_placeholder = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.726404, "o", "for shape in reference_slide.shapes:\r\n\u001b[?2004l\r"]
[100.726449, "o", "\u001b[?2004h> "]
[100.726529, "o", "    if shape.has_text_frame and shape != title_shape:\r\n\u001b[?2004l\r"]
[100.726576, "o", "\u001b[?2004h> "]
[100.726623, "o", "        content_placeholder = shape\r\n\u001b[?2004l\r"]
[100.726668, "o", "\u001b[?2004h> "]
[100.726714, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.726759, "o", "\u001b[?2004h> "]
[100.726804, "o", "if content_placeholder:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.726878, "o", "    text_frame = content_placeholder.text_frame\r\n\u001b[?2004l\r"]
[100.726924, "o", "\u001b[?2004h> "]
[100.726996, "o", "    text_frame.clear()  # Clear any default text\r\n\u001b[?2004l\r"]
[100.727047, "o", "\u001b[?2004h> "]
[100.727099, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.727159, "o", "    # Add each paper title as a numbered bullet point\r\n\u001b[?2004l\r"]
[100.72721, "o", "\u001b[?2004h> "]
[100.727272, "o", "    for i, title in enumerate(paper_titles):\r\n\u001b[?2004l\r"]
[100.727326, "o", "\u001b[?2004h> "]
[100.727376, "o", "        if i == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.727441, "o", "            p = text_frame.paragraphs[0]\r\n\u001b[?2004l\r"]
[100.727486, "o", "\u001b[?2004h> "]
[100.727531, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.7276, "o", "            p = text_frame.add_paragraph()\r\n\u001b[?2004l\r"]
[100.727625, "o", "\u001b[?2004h> "]
[100.72767, "o", "        \r\n\u001b[?2004l\r"]
[100.727738, "o", "\u001b[?2004h> "]
[100.727788, "o", "        p.text = title\r\n\u001b[?2004l\r\u001b[?2004h>         p.level = 0\r\n\u001b[?2004l\r"]
[100.727835, "o", "\u001b[?2004h> "]
[100.727944, "o", "        # The numbering will be handled by PowerPoint's auto-numbering\r\n\u001b[?2004l\r"]
[100.727989, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[100.728043, "o", "\u001b[?2004h> "]
[100.728112, "o", "    # If no content placeholder, create a text box\r\n\u001b[?2004l\r"]
[100.728164, "o", "\u001b[?2004h> "]
[100.728191, "o", "    left = Inches(0.5)\r\n\u001b[?2004l\r"]
[100.728258, "o", "\u001b[?2004h> "]
[100.728308, "o", "    top = Inches(1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.728364, "o", "    width = prs.slide_width - Inches(1)\r\n\u001b[?2004l\r"]
[100.728408, "o", "\u001b[?2004h> "]
[100.72847, "o", "    height = prs.slide_height - Inches(2)\r\n\u001b[?2004l\r"]
[100.728521, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[100.728564, "o", "\u001b[?2004h> "]
[100.728697, "o", "    textbox = reference_slide.shapes.add_textbox(left, top, width, height)\r\n\u001b[?2004l\r"]
[100.728745, "o", "\u001b[?2004h> "]
[100.728807, "o", "    text_frame = textbox.text_frame\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.72886, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.728951, "o", "    for i, title in enumerate(paper_titles, 1):\r\n\u001b[?2004l\r"]
[100.728997, "o", "\u001b[?2004h> "]
[100.729043, "o", "        if i == 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.729088, "o", "> "]
[100.729128, "o", "            p = text_frame.paragraphs[0]\r\n\u001b[?2004l\r"]
[100.729186, "o", "\u001b[?2004h> "]
[100.729236, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.729294, "o", "            p = text_frame.add_paragraph()\r\n\u001b[?2004l\r"]
[100.72934, "o", "\u001b[?2004h> "]
[100.729386, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.729433, "o", "        p.text = f\"{i}. {title}\"\r\n\u001b[?2004l\r"]
[100.729478, "o", "\u001b[?2004h> "]
[100.729533, "o", "        p.level = 0\r\n\u001b[?2004l\r"]
[100.729584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.729621, "o", "print(\"References slide created\")\r\n\u001b[?2004l\r"]
[100.72967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.729725, "o", "\u001b[?2004h> "]
[100.729767, "o", "# Save the processed presentation\r\n\u001b[?2004l\r"]
[100.729818, "o", "\u001b[?2004h> "]
[100.729916, "o", "output_path = '/root/Awesome-Agent-Papers_processed.pptx'\r\n\u001b[?2004l\r"]
[100.729962, "o", "\u001b[?2004h> "]
[100.730007, "o", "prs.save(output_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.730132, "o", "print(f\"\\nProcessed presentation saved to: {output_path}\")\r\n\u001b[?2004l\r"]
[100.730182, "o", "\u001b[?2004h> EOF\r\n"]
