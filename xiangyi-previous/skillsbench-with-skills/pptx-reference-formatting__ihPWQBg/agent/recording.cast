[100.714925, "i", "cat > process_pptx.py << 'EOF'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN\n\n# Load the presentation\nprs = Presentation('/root/Awesome-Agent-Papers.pptx')\n\n# Store paper titles for the reference slide\npaper_titles = []\n\nprint(\"Processing dangling paper titles...\\n\")\n\n# Process each slide (skip the first title slide)\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"Processing Slide {slide_idx + 1}...\")\n    \n    # Find text boxes (dangling paper titles)\n    for shape in slide.shapes:\n        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\n            print(f\"  Found text box: {shape.text[:50]}...\")\n            \n            # Store the paper title\n            paper_title = shape.text.strip()\n            if paper_title and paper_title not in paper_titles:\n                paper_titles.append(paper_title)\n            \n            # Format the text\n            if hasattr(shape, 'text_frame') and shape.text_frame:\n                text_frame = shape.text_frame\n                \n                # Set text alignment to center\n                for paragraph in text_frame.paragraphs:\n                    paragraph.alignment = PP_ALIGN.CENTER\n                    \n                    for run in paragraph.runs:\n                        # Set font properties\n                        run.font.name = 'Arial'\n                        run.font.size = Pt(16)\n                        run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)  # #989596\n                        run.font.bold = False\n                \n                # Disable word wrap to keep text in one line\n                text_frame.word_wrap = False\n                \n                # Get slide dimensions\n                slide_width = prs.slide_width\n                slide_height = prs.slide_height\n                \n                # Calculate text width (estimate based on character count)\n                # Approximately 0.1 inches per character for 16pt Arial\n                text_length = len(shape.text)\n                estimated_width = Pt(16 * text_length * 0.6)  # rough estimate\n                \n                # Set a reasonable max width (90% of slide width)\n                max_width = slide_width * 0.9\n                box_width = min(estimated_width, max_width)\n                \n                # Position at bottom center\n                shape.width = box_width\n                shape.height = Pt(30)  # Fixed height for single line\n                shape.left = (slide_width - box_width) // 2  # Center horizontally\n                shape.top = slide_height - Pt(60)  # 60pt from bottom\n                \n                print(f\"    Formatted and repositioned to bottom center\")\n\nprint(f\"\\nFound {len(paper_titles)} unique paper titles\")\nfor i, title in enumerate(paper_titles, 1):\n    print(f\"  {i}. {title}\")\n\n# Create References slide\nprint(\"\\nCreating References slide...\")\n\n# Use a blank layout or title and content layout\ntitle_content_layout = prs.slide_layouts[1]  # Usually \"Title and Content\"\nreference_slide = prs.slides.add_slide(title_content_layout)\n\n# Set the title\ntitle_shape = reference_slide.shapes.title\ntitle_shape.text = \"Reference\"\n\n# Find the content placeholder\ncontent_placeholder = None\nfor shape in reference_slide.shapes:\n    if shape.has_text_frame and shape != title_shape:\n        content_placeholder = shape\n        break\n\nif content_placeholder:\n    text_frame = content_placeholder.text_frame\n    text_frame.clear()  # Clear any default text\n    \n    # Add each paper title as a numbered bullet point\n    for i, title in enumerate(paper_titles):\n        if i == 0:\n            p = text_frame.paragraphs[0]\n        else:\n            p = text_frame.add_paragraph()\n        \n        p.text = title\n        p.level = 0\n        # The numbering will be handled by PowerPoint's auto-numbering\nelse:\n    # If no content placeholder, create a text box\n    left = Inches(0.5)\n    top = Inches(1.5)\n    width = prs.slide_width - Inches(1)\n    height = prs.sl"]
[100.714988, "i", "ide_height - Inches(2)\n    \n    textbox = reference_slide.shapes.add_textbox(left, top, width, height)\n    text_frame = textbox.text_frame\n    \n    for i, title in enumerate(paper_titles, 1):\n        if i == 1:\n            p = text_frame.paragraphs[0]\n        else:\n            p = text_frame.add_paragraph()\n        \n        p.text = f\"{i}. {title}\"\n        p.level = 0\n\nprint(\"References slide created\")\n\n# Save the processed presentation\noutput_path = '/root/Awesome-Agent-Papers_processed.pptx'\nprs.save(output_path)\nprint(f\"\\nProcessed presentation saved to: {output_path}\")\nEOF\n"]
