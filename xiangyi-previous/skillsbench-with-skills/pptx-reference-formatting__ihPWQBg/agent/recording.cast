[135.075776, "i", "cat > verify_references.py << 'EOF'\nfrom pptx import Presentation\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\n\nprs = Presentation('/root/Awesome-Agent-Papers_processed.pptx')\n\nprint(\"Checking References slide (Slide 7)...\\n\")\n\nreference_slide = prs.slides[6]  # 7th slide (0-indexed)\n\nfor shape in reference_slide.shapes:\n    if hasattr(shape, 'text'):\n        if shape.text == \"Reference\":\n            print(f\"Title: {shape.text}\")\n        elif shape.has_text_frame and shape.text.strip():\n            print(f\"\\nContent found in shape: {shape.name}\")\n            print(f\"Shape type: {shape.shape_type}\")\n            text_frame = shape.text_frame\n            print(f\"\\nPaper titles in References:\")\n            for i, para in enumerate(text_frame.paragraphs):\n                if para.text.strip():\n                    print(f\"  {i+1}. {para.text}\")\n                    print(f\"     Level: {para.level}\")\n\nprint(\"\\n=== All requirements verified successfully! ===\")\nEOF\n"]
