[69.640217, "o", "from document_generator import Document\r\n\u001b[?2004l\r\u001b[?2004h> from sequential import (\r\n\u001b[?2004l\r\u001b[?2004h>     TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     SearchResult,\r\n\u001b[?2004l\r\u001b[?2004h>     tokenize,\r\n\u001b[?2004l\r\u001b[?2004h>     compute_term_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @dataclass\r\n\u001b[?2004l\r\u001b[?2004h> class ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Result from parallel index building.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h>     elapsed_time: float\r\n\u001b[?2004l\r\u001b[?2004h>     num_documents: int\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary_size: int\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def process_document_chunk(docs_data: List[Tuple[int, str, str]]) -> Dict:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Process a chunk of documents: tokenize and compute term frequencies.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
