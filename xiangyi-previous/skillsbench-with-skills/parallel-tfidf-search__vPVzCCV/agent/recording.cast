[82.831128, "o", "    index = TFIDFIndex()"]
[82.831161, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.831284, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.831314, "o", "    "]
[82.831343, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.831549, "o", "    # Prepare document data for parallel processing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.831732, "o", "    docs_data = [(doc.doc_id, doc.title, doc.content) for doc in documents]\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.831794, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.831917, "o", "    # Split into chunks\r\n\u001b[?2004l\r"]
[82.832053, "o", "\u001b[?2004h> "]
[82.832188, "o", "    chunks = [docs_data[i:i + chunk_size] for i in range(0, len(docs_data), chunk_size)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[82.832231, "o", "\u001b[?2004h> "]
[82.832359, "o", "    # Step 1: Parallel tokenization and TF computation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.832509, "o", "    doc_term_freqs: Dict[int, Dict[str, float]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.8326, "o", "> "]
[82.832643, "o", "    doc_terms: Dict[int, Set[str]] = {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[82.83267, "o", "\u001b[?2004l\r\u001b[?2004h"]
[82.8327, "o", "> "]
[82.832892, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.836703, "o", "> "]
[82.836829, "o", "        results = list(executor.map(process_document_chunk, chunks))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[82.836857, "o", ">     # Merge results from all chunks\r\n\u001b[?2004l\r"]
[82.836963, "o", "\u001b[?2004h"]
[82.837127, "o", ">     for result in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837221, "o", "        doc_term_freqs.update(result['doc_term_freqs'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837347, "o", "        doc_terms.update(result['doc_terms'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837473, "o", "        index.vocabulary.update(result['vocabulary'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837538, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837674, "o", "    # Step 2: Calculate document frequencies"]
[82.837763, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.837893, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.83809, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[82.838154, "o", "\u001b[?2004h> "]
[82.838305, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[82.838378, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.83843, "o", "    # Step 3: Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.838497, "o", "    N = index.num_documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.838659, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.838775, "o", "> "]
[82.838816, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[82.838848, "o", "\u001b[?2004h> "]
[82.839122, "o", "    # Step 4: Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.839195, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h>         posting_list = []\r\n\u001b[?2004l\r"]
[82.839234, "o", "\u001b[?2004h> "]
[82.839364, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[82.839799, "o", "\u001b[?2004h> "]
[82.839852, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r\u001b[?2004h>                 tf = tf_dict[term]\r\n\u001b[?2004l\r\u001b[?2004h>                 tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h>                 posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.840532, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.840595, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Step 5: Build document vectors and compute norms\r\n\u001b[?2004l\r\u001b[?2004h>     for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h>         doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h>         norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h>             tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.844372, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h>             norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h>         index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h>         index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h>         index=index,\r\n\u001b[?2004l\r\u001b[?2004h>         elapsed_time=elapsed,\r\n\u001b[?2004l\r\u001b[?2004h>         num_documents=len(documents),\r\n\u001b[?2004l\r\u001b[?2004h>         vocabulary_size=len(index.vocabulary)\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@25ba4a54bbfc:~/workspace# "]
[93.363802, "i", "cat >> /root/workspace/parallel_solution.py << 'EOF'\n\n\ndef search_single_query(args: Tuple) -> List[SearchResult]:\n    \"\"\"Search for documents similar to a single query.\"\"\"\n    query, index, top_k, doc_titles = args\n    \n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    query_tf = compute_term_frequencies(query_tokens)\n    \n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    results = []\n    if doc_titles is None:\n        doc_titles = {}\n    for doc_id, score in top_results:\n        results.append(SearchResult(\n            doc_id=doc_id,\n            score=score,\n            title=doc_titles.get(doc_id, f\"Document {doc_id}\")\n        ))\n    \n    return results\nEOF\n"]
