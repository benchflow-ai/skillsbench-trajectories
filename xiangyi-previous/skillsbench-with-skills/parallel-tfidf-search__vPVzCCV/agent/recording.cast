[453.480075, "i", "        pass\n    return []\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    import time\n    from concurrent.futures import ThreadPoolExecutor\n    start = time.perf_counter()\n    if num_workers is None:\n        num_workers = 4\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else None\n    def search_one(q):\n        return _search_query(q, index, top_k, doc_titles)\n    with ThreadPoolExecutor(max_workers=num_workers) as ex:\n        results = list(ex.map(search_one, queries))\n    return results, time.perf_counter() - start\nEOF\n"]
