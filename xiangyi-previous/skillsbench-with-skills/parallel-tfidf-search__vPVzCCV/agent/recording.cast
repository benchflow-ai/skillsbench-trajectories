[274.851511, "i", "cat >> /root/workspace/parallel_solution.py << 'ENDOFFILE'\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None\n) -> Tuple[List[List[SearchResult]], float]:\n    \"\"\"Search for multiple queries in parallel using threads.\"\"\"\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    doc_titles = {d.doc_id: d.title for d in documents} if documents else None\n    \n    def search_one(query):\n        return _search_query(query, index, top_k, doc_titles)\n    \n    with ThreadPoolExecutor(max_workers=num_workers) as executor:\n        results = list(executor.map(search_one, queries))\n    \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\nENDOFFILE\n"]
