[69.637294, "i", "cat > /root/workspace/parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Parallel TF-IDF Implementation\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom typing import List, Tuple, Dict, Set, Optional\nimport multiprocessing as mp\n\nfrom document_generator import Document\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\ndef process_document_chunk(docs_data: List[Tuple[int, str, str]]) -> Dict:\n    \"\"\"Process a chunk of documents: tokenize and compute term frequencies.\"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc_id, title, content in docs_data:\n        text = title + \" \" + content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc_id] = tf\n        doc_terms[doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return {\n        'doc_term_freqs': doc_term_freqs,\n        'doc_terms': doc_terms,\n        'vocabulary': vocabulary\n    }\nEOF\n"]
