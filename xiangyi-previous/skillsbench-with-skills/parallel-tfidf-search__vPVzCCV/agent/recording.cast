[104.287238, "o", "cat /root/workspace/parallel_solution.py\r\n\u001b[?2004l\r"]
[104.348114, "o", "#!/usr/bin/env python3\r\n\"\"\"Parallel TF-IDF Implementation\"\"\"\r\n\r\nimport math\r\nimport time\r\nfrom collections import defaultdict\r\nfrom concurrent.futures import ProcessPoolExecutor\r\nfrom dataclasses import dataclass, field\r\nfrom heapq import nlargest\r\nfrom typing import List, Tuple, Dict, Set, Optional\r\nimport multiprocessing as mp\r\n\r\nfrom document_generator import Document\r\nfrom sequential import (\r\n    TFIDFIndex,\r\n    SearchResult,\r\n    tokenize,\r\n    compute_term_frequencies,\r\n)\r\n\r\n\r\n@dataclass\r\nclass ParallelIndexingResult:\r\n    \"\"\"Result from parallel index building.\"\"\"\r\n    index: TFIDFIndex\r\n    elapsed_time: float\r\n    num_documents: int\r\n    vocabulary_size: int\r\n\r\n\r\ndef process_document_chunk(docs_data: List[Tuple[int, str, str]]) -> Dict:\r\n    \"\"\"Process a chunk of documents: tokenize and compute term frequencies.\"\"\"\r\n    doc_term_freqs = {}\r\n    doc_terms = {}\r\n    vocabulary = set()\r\n    \r\n    for doc_id, title, content in docs_data:\r\n        text = title + \" \" + content\r\n        tokens = tokenize(text)\r\n        tf = compute_term_frequencies(tokens)\r\n        doc_term_freqs[doc_id] = tf\r\n        doc_terms[doc_id] = set(tf.keys())\r\n        vocabulary.update(tf.keys())\r\n    \r\n    return {\r\n        'doc_term_freqs': doc_term_freqs,\r\n        'doc_terms': doc_terms,\r\n        'vocabulary': vocabulary\r\n    }\r\n\r\n\r\ndef build_tfidf_index_parallel(\r\n    documents: List[Document],\r\n    num_workers: Optional[int] = None,\r\n    chunk_size: int = 500\r\n) -> ParallelIndexingResult:\r\n    \"\"\"Build TF-IDF inverted index in parallel.\"\"\"\r\n    start_time = time.perf_counter()\r\n    \r\n    if num_workers is None:\r\n        num_workers = mp.cpu_count()\r\n    \r\n    index = TFIDFIndex()\r\n    index.num_documents = len(documents)\r\n    \r\n    # Prepare document data for parallel processing\r\n    docs_data = [(doc.doc_id, doc.title, doc.content) for doc in documents]\r\n    \r\n    # Split into chunks\r\n    chunks = [docs_data[i:i + chunk_size] for i in range(0, len(docs_data), chunk_size)]\r\n    \r\n    # Step 1: Parallel tokenization and TF computation\r\n    doc_term_freqs: Dict[int, Dict[str, float]] = {}\r\n    doc_terms: Dict[int, Set[str]] = {}\r\n    \r\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n        results = list(executor.map(process_document_chunk, chunks))\r\n    \r\n    # Merge results from all chunks\r\n    for result in results:\r\n        doc_term_freqs.update(result['doc_term_freqs'])\r\n        doc_terms.update(result['doc_terms'])\r\n        index.vocabulary.update(result['vocabulary'])\r\n    \r\n    # Step 2: Calculate document frequencies\r\n    for term in index.vocabulary:\r\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n        index.document_frequencies[term] = df\r\n    \r\n    # Step 3: Compute IDF scores\r\n    N = index.num_documents\r\n    for term, df in index.document_frequencies.items():\r\n        index.idf[term] = math.log(N / df) + 1\r\n    \r\n    # Step 4: Build inverted index with TF-IDF scores\r\n    for term in index.vocabulary:\r\n        posting_list = []\r\n        for doc_id, tf_dict in doc_term_freqs.items():\r\n            if term in tf_dict:\r\n                tf = tf_dict[term]\r\n                tfidf = tf * index.idf[term]\r\n                posting_list.append((doc_id, tfidf))\r\n        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n        index.inverted_index[term] = posting_list\r\n    \r\n    # Step 5: Build document vectors and compute norms\r\n    for doc_id, tf_dict in doc_term_freqs.items():\r\n        doc_vector = {}\r\n        norm_squared = 0.0\r\n        for term, tf in tf_dict.items():\r\n            tfidf = tf * index.idf[term]\r\n            doc_vector[term] = tfidf\r\n            norm_squared += tfidf * tfidf\r\n        index.doc_vectors[doc_id] = doc_vector\r\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n    \r\n    elapsed = time.perf_counter() - start_time\r\n    \r\n    return ParallelIndexingResult(\r\n        index=index,\r\n        elapsed_time=elapsed,\r\n        num_documents=len(documents),\r\n        vocabulary_size=len(index.vocabulary)\r\n    )\r\n\r\n\r\ndef search_single_query(args: Tuple) -> List[SearchResult]:\r\n    \"\"\"Search for documents similar to a single query.\"\"\"\r\n    query, index, top_k, doc_titles = args\r\n    \r\n    query_tokens = tokenize(query)\r\n    if not query_tokens:\r\n        return []\r\n    \r\n    query_tf = compute_term_frequencies(query_tokens)\r\n    \r\n    query_vector = {}\r\n    query_norm_squared = 0.0\r\n    for term, tf in query_tf.items():\r\n        if term in index.idf:\r\n            tfidf = tf * index.idf[term]\r\n            query_vector[term] = tfidf\r\n            query_norm_squared += tfidf * tfidf\r\n    \r\n    if not query_vector:\r\n        return []\r\n    \r\n    query_norm = math.sqrt(query_norm_squared)\r\n    \r\n    candidate_docs = set()\r\n    for term in query_vector:\r\n        if term in index.inverted_index:\r\n            for doc_id, _ in index.inverted_index[term]:\r\n                candidate_docs.add(doc_id)\r\n    \r\n    scores = []\r\n    for doc_id in candidate_docs:\r\n        doc_vector = index.doc_vectors.get(doc_id, {})\r\n        doc_norm = index.doc_norms.get(doc_id, 0)\r\n        \r\n        if doc_norm == 0:\r\n            continue\r\n        \r\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n        similarity = dot_product / (query_norm * doc_norm)\r\n        scores.append((doc_id, similarity))\r\n    \r\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n    \r\n    results = []\r\n    if doc_titles is None:\r\n        doc_titles = {}\r\n    for doc_id, score in top_results:\r\n        results.append(SearchResult(\r\n            doc_id=doc_id,\r\n            score=score,\r\n            title=doc_titles.get(doc_id, f\"Document {doc_id}\")\r\n        ))\r\n    \r\n    return results\r\n\r\n\r\ndef batch_search_parallel(\r\n    queries: List[str],\r\n    index: TFIDFIndex,\r\n    top_k: int = 10,\r\n    num_workers: Optional[int] = None,\r\n    documents: Optional[List[Document]] = None\r\n) -> Tuple[List[List[SearchResult]], float]:\r\n    \"\"\"Search for multiple queries in parallel.\"\"\"\r\n    start_time = time.perf_counter()\r\n    \r\n    if num_workers is None:\r\n        num_workers = mp.cpu_count()\r\n    \r\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else None\r\n    \r\n    search_args = [(query, index, top_k, doc_titles) for query in queries]\r\n    \r\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n        results = list(executor.map(search_single_query, search_args))\r\n    \r\n    elapsed = time.perf_counter() - start_time\r\n    \r\n    return results, elapsed\r\n"]
[104.348407, "o", "\u001b[?2004h"]
[104.348482, "o", "root@25ba4a54bbfc:~/workspace# "]
[117.397931, "i", "cat > /root/workspace/test_parallel.py << 'EOF'\n#!/usr/bin/env python3\nimport time\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\nif __name__ == \"__main__\":\n    print(\"Generating corpus...\")\n    docs = generate_corpus(5000, seed=42)\n    print(f\"Generated {len(docs)} documents\")\n    \n    # Test index building\n    print(\"\\n=== Index Building ===\")\n    seq_result = build_tfidf_index_sequential(docs)\n    print(f\"Sequential: {seq_result.elapsed_time:.3f}s\")\n    \n    par_result = build_tfidf_index_parallel(docs, num_workers=4)\n    print(f\"Parallel (4 workers): {par_result.elapsed_time:.3f}s\")\n    print(f\"Speedup: {seq_result.elapsed_time / par_result.elapsed_time:.2f}x\")\n    \n    # Verify correctness\n    print(\"\\nVerifying index correctness...\")\n    assert seq_result.vocabulary_size == par_result.vocabulary_size\n    assert seq_result.index.idf == par_result.index.idf\n    print(\"Index verification passed!\")\n    \n    # Test search\n    print(\"\\n=== Batch Search ===\")\n    queries = [\"machine learning\", \"data analysis\", \"network security\"] * 100\n    \n    start = time.perf_counter()\n    seq_search = batch_search_sequential(queries, seq_result.index, 10, docs)\n    seq_time = time.perf_counter() - start\n    print(f\"Sequential: {seq_time:.3f}s\")\n    \n    par_search, par_time = batch_search_parallel(queries, par_result.index, 10, 4, docs)\n    print(f\"Parallel (4 workers): {par_time:.3f}s\")\n    print(f\"Speedup: {seq_time / par_time:.2f}x\")\n    \n    # Verify search results\n    print(\"\\nVerifying search results...\")\n    for i, (s, p) in enumerate(zip(seq_search, par_search)):\n        for sr, pr in zip(s, p):\n            assert sr.doc_id == pr.doc_id, f\"Query {i}: doc_id mismatch\"\n            assert abs(sr.score - pr.score) < 1e-9, f\"Query {i}: score mismatch\"\n    print(\"Search verification passed!\")\nEOF\n"]
