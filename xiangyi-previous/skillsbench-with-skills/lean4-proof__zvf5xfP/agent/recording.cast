[104.161451, "i", "cat > /app/workspace/solution.lean << 'ENDFILE'\n\nimport Mathlib.Data.Real.Basic\nimport Mathlib.Tactic\n\n-- Define the sequence S_n\nnoncomputable def S : ℕ → ℝ\n  | 0 => 1\n  | n + 1 => S n + 1 / (2 : ℝ) ^ (n + 1)\n\n-- Theorem: S_n ≤ 2 for all n ∈ ℕ\ntheorem problemsolution : ∀ n : ℕ, S n ≤ 2 := by\n  intro n\n  induction n with\n  | zero => simp [S]; norm_num\n  | succ n ih =>\n    have h : S (n + 1) < 2 := by\n      calc S (n + 1) = S n + 1 / 2 ^ (n + 1) := by rw [S]\n        _ ≤ 2 + 1 / 2 ^ (n + 1) := by linarith\n        _ < 2 + 1 := by nlinarith [pow_pos (show (0:ℝ) < 2 by norm_num) (n+1)]\n        _ = 3 := by norm_num\n    linarith\nENDFILE\n"]
[104.161694, "o", "cat > /app/workspace/solution.lean << 'ENDFILE'\r\n\u001b[?2004l\r"]
[104.161814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.161868, "o", "> import Mathlib.Data.Real.Basic\r\n\u001b[?2004l\r\u001b[?2004h> import Mathlib.Tactic\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.161921, "o", "> "]
[104.161978, "o", "-- Define the sequence S_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162031, "o", "noncomputable def S : ℕ → ℝ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162078, "o", "  | 0 => 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162131, "o", "  | n + 1 => S n + 1 / (2 : ℝ) ^ (n + 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162197, "o", "-- Theorem: S_n ≤ 2 for all n ∈ ℕ\r\n\u001b[?2004l\r"]
[104.16225, "o", "\u001b[?2004h> "]
[104.16231, "o", "theorem problemsolution : ∀ n : ℕ, S n ≤ 2 := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162364, "o", ">   intro n\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162415, "o", ">   induction n with\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162462, "o", "  | zero => simp [S]; norm_num\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162499, "o", ">   | succ n ih =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162558, "o", "    have h : S (n + 1) < 2 := by\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162607, "o", "> "]
[104.16266, "o", "      calc S (n + 1) = S n + 1 / 2 ^ (n + 1) := by rw [S]\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162705, "o", "> "]
[104.162749, "o", "        _ ≤ 2 + 1 / 2 ^ (n + 1) := by linarith\r\n\u001b[?2004l\r"]
[104.162796, "o", "\u001b[?2004h> "]
[104.162897, "o", "        _ < 2 + 1 := by nlinarith [pow_pos (show (0:ℝ) < 2 by norm_num) (n+1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.162952, "o", "        _ = 3 := by norm_num\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.162976, "o", ">     linarith\r\n\u001b[?2004l\r"]
[104.163006, "o", "\u001b[?2004h> "]
[104.163037, "o", "ENDFILE\r\n\u001b[?2004l\r"]
