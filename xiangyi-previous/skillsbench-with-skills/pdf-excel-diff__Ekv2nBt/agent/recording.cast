[180.695998, "i", "python3 -c \"import pandas as pd, tabula, json, re; curr = pd.read_excel('/root/employees_current.xlsx'); tabs = tabula.read_pdf('/root/employees_backup.pdf', pages='all', stream=True); back_rows = []; [back_rows.append([str(x) for x in r.values if pd.notna(x)][:9]) for df in tabs for _, r in df.iterrows() if [str(x) for x in r.values if pd.notna(x)] and re.match(r'EMP\\d{5}', str([str(x) for x in r.values if pd.notna(x)][0]))]; back = pd.DataFrame(back_rows, columns=['ID','First','Last','Dept','Position','Salary','Years','Location','Score']); [back.__setitem__(c, back[c].astype(str).str.replace(',','').astype(float)) for c in ['Salary','Years','Score']]; [curr.__setitem__(c, curr[c].astype(str).str.replace(',','').astype(float)) for c in ['Salary','Years','Score']]; del_ids = sorted(list(set(back.ID) - set(curr.ID))); mod = []; common = sorted(list(set(back.ID) & set(curr.ID))); [mod.append({'id':eid, 'field':col, 'old_value':int(back[back.ID==eid].iloc[0][col]) if col in ['Salary','Years'] else back[back.ID==eid].iloc[0][col], 'new_value':int(curr[curr.ID==eid].iloc[0][col]) if col in ['Salary','Years'] else curr[curr.ID==eid].iloc[0][col]}) for eid in common for col in ['First','Last','Dept','Position','Salary','Years','Location','Score'] if (int(back[back.ID==eid].iloc[0][col]) if col in ['Salary','Years'] else back[back.ID==eid].iloc[0][col]) != (int(curr[curr.ID==eid].iloc[0][col]) if col in ['Salary','Years'] else curr[curr.ID==eid].iloc[0][col])]; json.dump({'deleted_employees':del_ids, 'modified_employees':mod}, open('/root/diff_report.json','w'), indent=2); print('Success')\"\n"]
[203.292241, "i", "cat << 'EOF' > /root/parse_pdf_new.py\nimport re, json, pandas as pd\nfrom pdfminer.high_level import extract_text\n\ndef parse_pdf(file_path):\n    text = extract_text(file_path)\n    # Split by whitespace but keep track of the structure\n    tokens = text.split()\n    \n    records = []\n    i = 0\n    while i < len(tokens):\n        if re.match(r'EMP\\d{5}', tokens[i]):\n            eid = tokens[i]\n            # We expect 8 more fields: First, Last, Dept, Position, Salary, Years, Location, Score\n            # But Dept and Position can be multiple words. This is the challenge.\n            # Let's look for the next EMP\\d{5} to see where this record ends.\n            j = i + 1\n            while j < len(tokens) and not re.match(r'EMP\\d{5}', tokens[j]):\n                j += 1\n            \n            record_tokens = tokens[i:j]\n            # Now we have tokens for ONE record, e.g., ['EMP00001', 'Joe', 'Brown', 'QA', 'QA', 'Manager', '112,000', '7', 'Houston', '4.3']\n            if len(record_tokens) >= 9:\n                record = {}\n                record['ID'] = record_tokens[0]\n                record['First'] = record_tokens[1]\n                record['Last'] = record_tokens[2]\n                record['Score'] = record_tokens[-1]\n                record['Location'] = record_tokens[-2]\n                record['Years'] = record_tokens[-3]\n                record['Salary'] = record_tokens[-4]\n                # Dept and Position are between index 3 and -4\n                middle = record_tokens[3:-4]\n                # This is still a bit ambiguous. Let's use the known columns from Excel to help.\n                # For now, let's join them and hope for the best, or try to split by known Depts.\n                record['Dept_Position'] = \" \".join(middle)\n                records.append(record)\n            i = j\n        else:\n            i += 1\n    return records\n\nrecords = parse_pdf('/root/employees_backup.pdf')\n# Save to check\nwith open('/root/backup_data.json', 'w') as f:\n    json.dump(records, f)\nprint(f\"Extracted {len(records)} records\")\nEOF\n"]
[203.805677, "i", "python3 /root/parse_pdf_new.py\n"]
[211.331528, "i", "python3 -c \"import pandas as pd; df = pd.read_excel('/root/employees_current.xlsx'); print('Depts:', df.Dept.unique().tolist()); print('Positions:', df.Position.unique().tolist())\"\n"]
