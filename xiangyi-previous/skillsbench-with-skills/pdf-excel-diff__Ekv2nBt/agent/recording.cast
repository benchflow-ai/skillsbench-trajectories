[98.508173, "i", "cat << 'EOF' > /root/generate_report.py\nimport pandas as pd\nimport json\nimport re\nfrom pdfminer.high_level import extract_text\n\ndef parse_pdf(file_path):\n    text = extract_text(file_path)\n    # The format seems to be ID First Last Dept Position Salary Years Location Score\n    # Example: EMP00001 Joe Brown QA QA Manager 112,000 7 Houston 4.3\n    # We can use regex to find lines starting with EMP followed by 5 digits\n    pattern = r'(EMP\\d{5})\\s+(\\S+)\\s+(\\S+)\\s+(.*?)\\s+(.*?)\\s+([\\d,]+)\\s+(\\d+)\\s+(.*?)\\s+(\\d+\\.\\d+)'\n    \n    # However, sometimes positions or depts have spaces. Let's try a more flexible approach.\n    # Since we know the column order, we can try to split the text and group it.\n    # But wait, looking at the tabula output, it seems it's a standard table.\n    # Let's try to extract all words and then group them by ID.\n    \n    records = []\n    lines = text.split('\\n')\n    for line in lines:\n        line = line.strip()\n        if not line.startswith('EMP'):\n            continue\n        \n        # Try to match the record\n        # Typical line: EMP00001 Joe Brown QA QA Manager 112,000 7 Houston 4.3\n        parts = line.split()\n        if len(parts) >= 9:\n            # This is tricky because Dept, Position, and Location might have spaces.\n            # Let's use the fact that Salary is a number with commas, Years is an int,\n            # Score is a float at the end.\n            emp_id = parts[0]\n            first = parts[1]\n            last = parts[2]\n            # Score is last\n            score = parts[-1]\n            # Location is second to last\n            location = parts[-2]\n            # Years is third to last\n            years = parts[-3]\n            # Salary is fourth to last\n            salary = parts[-4]\n            # Everything in between is Dept and Position\n            # This is still risky. \n            # Let's try a different regex that uses the known structure.\n            pass\n\n    # Actually, let's use the messy tabula output if possible, it had the data.\n    # Or better, use pdfminer and just extract all text and then use regex to find the fields.\n    # Let's try to find all IDs and then the text until the next ID.\n    ids = re.findall(r'EMP\\d{5}', text)\n    records = []\n    for i in range(len(ids)):\n        start_id = ids[i]\n        end_id = ids[i+1] if i+1 < len(ids) else None\n        \n        start_idx = text.find(start_id)\n        if end_id:\n            end_idx = text.find(end_id, start_idx + 1)\n            record_text = text[start_idx:end_idx]\n        else:\n            record_text = text[start_idx:]\n        \n        # Now parse record_text\n        # It should contain: ID, First, Last, Dept, Position, Salary, Years, Location, Score\n        parts = record_text.split()\n        if len(parts) >= 9:\n            record = {\n                'ID': parts[0],\n                'First': parts[1],\n                'Last': parts[2],\n                # The rest are more complex. Let's rely on the order from the end.\n                'Score': parts[-1],\n                'Location': parts[-2],\n                'Years': parts[-3],\n                'Salary': parts[-4],\n            }\n            # Dept and Position are what's left\n            # This is still not perfect but let's try.\n            # Wait, I have the tabula output! It was actually pretty good in the first attempt.\n            # Let's use tabula but with a better cleaning logic.\n    return [] # Placeholder\n\n# Let's try a better approach. Use tabula and flatten the result.\nimport tabula\n\ndef get_backup_df():\n    tables = tabula.read_pdf('/root/employees_backup.pdf', pages='all', multiple_tables=True, lattice=False, stream=True)\n    all_rows = []\n    for df in tables:\n        # Flatten the dataframe if it's messy\n        for _, row in df.iterrows():\n            row_vals = [str(v) for v in row.values if pd.notna(v)]\n            # Look for ID in the row\n            for i, val in enumerate(row_vals):\n                if re.match(r'EMP\\d{5}', val):\n                    # Found a potential start of a row\n                    all_rows.append(row_vals[i:])\n       "]
[98.508353, "i", "             break\n    \n    # Now we have a list of lists. Each should have 9 elements.\n    cleaned_data = []\n    for r in all_rows:\n        if len(r) >= 9:\n            cleaned_data.append({\n                'ID': r[0],\n                'First': r[1],\n                'Last': r[2],\n                'Dept': r[3],\n                'Position': r[4],\n                'Salary': r[5],\n                'Years': r[6],\n                'Location': r[7],\n                'Score': r[8]\n            })\n    return pd.DataFrame(cleaned_data)\n\ntry:\n    df_current = pd.read_excel('/root/employees_current.xlsx')\n    df_backup = get_backup_df()\n    \n    # Data cleaning\n    for df in [df_current, df_backup]:\n        df['Salary'] = df['Salary'].astype(str).str.replace(',', '').astype(float)\n        df['Years'] = df['Years'].astype(float).astype(int)\n        df['Score'] = df['Score'].astype(float)\n\n    # Comparison logic (same as before but fixed)\n    backup_ids = set(df_backup['ID'])\n    current_ids = set(df_current['ID'])\n    \n    deleted = sorted(list(backup_ids - current_ids))\n    modified = []\n    \n    common = sorted(list(backup_ids & current_ids))\n    for eid in common:\n        b_row = df_backup[df_backup['ID'] == eid].iloc[0]\n        c_row = df_current[df_current['ID'] == eid].iloc[0]\n        \n        for col in ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:\n            b_val = b_row[col]\n            c_val = c_row[col]\n            \n            if b_val != c_val:\n                modified.append({\n                    \"id\": eid,\n                    \"field\": col,\n                    \"old_value\": b_val,\n                    \"new_value\": c_val\n                })\n    \n    with open('/root/diff_report.json', 'w') as f:\n        json.dump({\"deleted_employees\": deleted, \"modified_employees\": modified}, f, indent=2)\n    print(\"Done\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
