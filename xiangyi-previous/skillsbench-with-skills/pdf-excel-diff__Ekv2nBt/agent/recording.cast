[120.523855, "i", "python3 -c \"import pandas as pd, tabula, json, re; \ntry:\n curr = pd.read_excel('/root/employees_current.xlsx')\n for c in ['Salary','Years','Score']: curr[c] = curr[c].astype(str).str.replace(',','').astype(float)\n tabs = tabula.read_pdf('/root/employees_backup.pdf', pages='all', stream=True)\n back_rows = []\n for df in tabs:\n  for _, r in df.iterrows():\n   v = [str(x) for x in r.values if pd.notna(x)]\n   if v and re.match(r'EMP\\d{5}', v[0]) and len(v)>=9: back_rows.append(v[:9])\n back = pd.DataFrame(back_rows, columns=['ID','First','Last','Dept','Position','Salary','Years','Location','Score'])\n for c in ['Salary','Years','Score']: back[c] = back[c].astype(str).str.replace(',','').astype(float)\n del_ids = sorted(list(set(back.ID) - set(curr.ID)))\n mod = []\n for eid in sorted(list(set(back.ID) & set(curr.ID))):\n  br, cr = back[back.ID==eid].iloc[0], curr[curr.ID==eid].iloc[0]\n  for col in ['First','Last','Dept','Position','Salary','Years','Location','Score']:\n   bv, cv = br[col], cr[col]\n   if col in ['Salary','Years']: bv, cv = int(bv), int(cv)\n   if bv != cv: mod.append({'id':eid, 'field':col, 'old_value':bv, 'new_value':cv})\n with open('/root/diff_report.json','w') as f: json.dump({'deleted_employees':del_ids, 'modified_employees':mod}, f, indent=2)\n print('Success')\nexcept Exception as e: print(e)\" \n"]
