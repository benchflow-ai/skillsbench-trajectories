[14.084956, "i", "cat << 'EOF' > /root/inspect_data.py\nimport pandas as pd\nimport tabula\n\ntry:\n    # Inspect Excel\n    df_current = pd.read_excel('/root/employees_current.xlsx')\n    print(\"Excel Columns:\", df_current.columns.tolist())\n    print(\"Excel Head:\\n\", df_current.head())\n\n    # Inspect PDF\n    tables = tabula.read_pdf('/root/employees_backup.pdf', pages='all')\n    if tables:\n        df_backup = pd.concat(tables)\n        print(\"PDF Columns:\", df_backup.columns.tolist())\n        print(\"PDF Head:\\n\", df_backup.head())\n    else:\n        print(\"No tables found in PDF with tabula\")\nexcept Exception as e:\n    print(\"Error:\", e)\nEOF\n"]
