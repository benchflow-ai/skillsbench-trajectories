import pandas as pd
import tabula
import json
import os

def clean_value(val):
    if pd.isna(val):
        return None
    if isinstance(val, (int, float)):
        return val
    # Remove commas from numbers represented as strings
    if isinstance(val, str):
        val = val.strip()
        if re.match(r'^-?[\d,]+(\.\d+)?$', val):
            try:
                return float(val.replace(',', ''))
            except:
                pass
    return val

import re

try:
    # Read Excel
    df_current = pd.read_excel('/root/employees_current.xlsx')
    
    # Read PDF - We saw tabula worked but messy. Let's try to extract all tables and clean them.
    # Given the previous output, it seems tabula might have merged everything into one wide table.
    tables = tabula.read_pdf('/root/employees_backup.pdf', pages='all', multiple_tables=True)
    
    all_data = []
    for table in tables:
        # Clean up columns
        # In the previous output, we saw columns like 'ID', 'First', 'Last', etc.
        # But also many others. Let's filter for relevant columns.
        expected_cols = ['ID', 'First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']
        # Filter table to only include rows that look like they have an ID
        if 'ID' in table.columns:
            relevant_data = table[table['ID'].astype(str).str.contains('EMP', na=False)]
            for _, row in relevant_data.iterrows():
                record = {}
                for col in expected_cols:
                    if col in table.columns:
                        val = row[col]
                        # Clean numeric values
                        if col in ['Salary', 'Years', 'Score']:
                            if isinstance(val, str):
                                val = val.replace(',', '')
                            try:
                                val = float(val)
                            except:
                                pass
                        record[col] = val
                if record.get('ID'):
                    all_data.append(record)

    df_backup = pd.DataFrame(all_data)
    
    # If df_backup is still empty or missing data, tabula might have failed to find the table correctly.
    # Let's try another approach for PDF if needed, but let's see if this works.
    
    # Deduplicate backup data by ID
    df_backup = df_backup.drop_duplicates(subset=['ID'])
    
    current_ids = set(df_current['ID'].tolist())
    backup_ids = set(df_backup['ID'].tolist())
    
    deleted_employees = sorted(list(backup_ids - current_ids))
    
    modified_employees = []
    
    # Compare existing employees
    common_ids = backup_ids intersection current_ids
    
    # Sort for consistency
    for emp_id in sorted(list(common_ids)):
        old_row = df_backup[df_backup['ID'] == emp_id].iloc[0]
        new_row = df_current[df_current['ID'] == emp_id].iloc[0]
        
        for col in ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:
            old_val = old_row[col]
            new_val = new_row[col]
            
            # Normalize for comparison
            norm_old = old_val
            norm_new = new_val
            
            if col in ['Salary', 'Years', 'Score']:
                try:
                    norm_old = float(str(old_val).replace(',', ''))
                    norm_new = float(new_val)
                    if abs(norm_old - norm_new) < 1e-9:
               ID

