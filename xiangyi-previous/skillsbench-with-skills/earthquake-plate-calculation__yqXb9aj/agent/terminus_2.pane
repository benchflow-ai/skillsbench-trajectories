[?2004hroot@5f82e0fa11ec:~# python3 - <<'PY'
[?2004l[?2004h> import geopandas as gpd
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json, datetime
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> plates = gpd.read_file('PB2002_plates.json')
[?2004l[?2004h> boundaries = gpd.read_file('PB2002_boundaries.json')
[?2004l[?2004h> quakes = gpd.read_file('earthquakes_2024.json')
[?2004l[?2004h> 
[?2004l[?2004h> # Select Pacific plate
[?2004l[?2004h> pac = plates[plates['PlateName'] == 'Pacific']
[?2004l[?2004h> if pac.empty:
[?2004l[?2004h>     raise ValueError('Pacific plate not found')
[?2004l[?2004h> 
[?2004l[?2004h> # Pacific plate code
[?2004l[?2004h> pac_code = pac.iloc[0]['Code']
[?2004l[?2004h> 
[?2004l[?2004h> # Select boundaries involving Pacific plate
[?2004l[?2004h> pac_boundaries = boundaries[(boundaries['PlateA'] == pac_code) | (boundaries['PlateB'] == pac_code)]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter earthquakes within Pacific plate
[?2004l[?2004h> pac_geom = pac.geometry.unary_union
[?2004l[?2004h> quakes_in_pac = quakes[quakes.within(pac_geom)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> print('Quakes in Pacific plate:', len(quakes_in_pac))
[?2004l[?2004h> 
[?2004l[?2004h> # Project to Azimuthal Equidistant centered on Pacific
[?2004l[?2004h> aeqd = "+proj=aeqd +lat_0=0 +lon_0=180 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs"
[?2004l[?2004h> 
[?2004l[?2004h> pac_boundaries_proj = pac_boundaries.to_crs(aeqd)
[?2004l[?2004h> quakes_proj = quakes_in_pac.to_crs(aeqd)
[?2004l[?2004h> 
[?2004l[?2004h> boundary_union = pac_boundaries_proj.geometry.unary_union
[?2004l[?2004h> 
[?2004l[?2004h> # Compute distances
[?2004l[?2004h> quakes_proj['distance_m'] = quakes_proj.geometry.distance(boundary_union)
[?2004l[?2004h> 
[?2004l[?2004h> # Find max distance
[?2004l[?2004h> max_row = quakes_proj.loc[quakes_proj['distance_m'].idxmax()]
[?2004l[?2004h> 
[?2004l[?2004h> # Map back to original row (same index)
[?2004l[?2004h> orig_row = quakes_in_pac.loc[max_row.name]
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare output
[?2004l[?2004h> # Convert time from ms since epoch
[?2004l[?2004h> iso_time = datetime.datetime.utcfromtimestamp(orig_row['time']/1000).strftime('%Y-%m-%dT%H:%M:%SZ')
[?2004l[?2004h> 
[?2004l[?2004h> distance_km = round(max_row['distance_m'] / 1000.0, 2)
[?2004l[?2004h> 
[?2004l[?2004h> result = {
[?2004l[?2004h>     'id': orig_row['id'],
[?2004l[?2004h>     'place': orig_row['place'],
[?2004l[?2004h>     'time': iso_time,
[?2004l[?2004h>     'magnitude': float(orig_row['mag']) if pd.notnull(orig_row['mag']) else None,
[?2004l[?2004h>     'latitude': float(orig_row.geometry.y),
[?2004l[?2004h>     'longitude': float(orig_row.geometry.x),
[?2004l[?2004h>     'distance_km': distance_km
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/root/answer.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Result written to /root/answer.json')
[?2004l[?2004h> print(result)
