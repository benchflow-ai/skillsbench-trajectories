[24.358521, "i", "python3 - <<'PY'\nimport json\nwith open('PB2002_plates.json') as f:\n    plates=json.load(f)\nplate_names=sorted({feat['properties'].get('PlateName') for feat in plates['features']})\nprint('Plate names containing Pacific:')\nfor name in plate_names:\n    if 'Pacific' in name:\n        print(name)\nprint('Total plates', len(plate_names))\n\nwith open('PB2002_boundaries.json') as f:\n    boundaries=json.load(f)\nplateA=set(); plateB=set()\nfor feat in boundaries['features']:\n    plateA.add(feat['properties'].get('PlateA'))\n    plateB.add(feat['properties'].get('PlateB'))\n\nprint('PlateA values containing Pacific:')\nfor name in sorted(plateA):\n    if name and 'Pacific' in name:\n        print(name)\nprint('PlateB values containing Pacific:')\nfor name in sorted(plateB):\n    if name and 'Pacific' in name:\n        print(name)\nPY\n"]
