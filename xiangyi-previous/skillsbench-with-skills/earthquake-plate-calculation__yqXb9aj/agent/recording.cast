[31.211473, "i", "python3 - <<'PY'\nimport json\nwith open('PB2002_plates.json') as f:\n    plates=json.load(f)\n# find Pacific plate code\npac_code=None\nfor feat in plates['features']:\n    if feat['properties'].get('PlateName')=='Pacific':\n        pac_code=feat['properties'].get('Code')\n        print('Pacific code', pac_code)\n        break\n\nwith open('PB2002_boundaries.json') as f:\n    boundaries=json.load(f)\nplateA=set(); plateB=set()\nfor feat in boundaries['features']:\n    plateA.add(feat['properties'].get('PlateA'))\n    plateB.add(feat['properties'].get('PlateB'))\nprint('unique PlateA', sorted(list(plateA))[:20])\nprint('unique PlateB', sorted(list(plateB))[:20])\nprint('contains pac code in PlateA?', pac_code in plateA)\nprint('contains pac code in PlateB?', pac_code in plateB)\nPY\n"]
