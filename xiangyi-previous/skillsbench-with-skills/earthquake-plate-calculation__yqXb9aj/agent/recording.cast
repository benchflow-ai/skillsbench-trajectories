[81.577444, "i", "python3 - <<'PY'\nimport geopandas as gpd\n\nplates = gpd.read_file('PB2002_plates.json')\n# select Pacific plate\npac = plates[plates['PlateName']=='Pacific']\nprint('Pacific count', len(pac))\nprint('Pacific bounds', pac.total_bounds)\n\nquakes = gpd.read_file('earthquakes_2024.json')\nprint('Quake bounds', quakes.total_bounds)\n# show longitude min/max\nprint('lon min/max', quakes.geometry.x.min(), quakes.geometry.x.max())\nPY\n"]
