[156.684416, "i", "python3 - <<'PY'\nimport geopandas as gpd\nimport pandas as pd\nimport json, datetime\n\n# Load data\nplates = gpd.read_file('PB2002_plates.json')\nboundaries = gpd.read_file('PB2002_boundaries.json')\nquakes = gpd.read_file('earthquakes_2024.json')\n\n# Select Pacific plate\npac = plates[plates['PlateName'] == 'Pacific']\nif pac.empty:\n    raise ValueError('Pacific plate not found')\n\n# Pacific plate code\npac_code = pac.iloc[0]['Code']\n\n# Select boundaries involving Pacific plate\npac_boundaries = boundaries[(boundaries['PlateA'] == pac_code) | (boundaries['PlateB'] == pac_code)]\n\n# Filter earthquakes within Pacific plate\npac_geom = pac.geometry.unary_union\nquakes_in_pac = quakes[quakes.within(pac_geom)].copy()\n\nprint('Quakes in Pacific plate:', len(quakes_in_pac))\n\n# Project to Azimuthal Equidistant centered on Pacific\naeqd = \"+proj=aeqd +lat_0=0 +lon_0=180 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs\"\n\npac_boundaries_proj = pac_boundaries.to_crs(aeqd)\nquakes_proj = quakes_in_pac.to_crs(aeqd)\n\nboundary_union = pac_boundaries_proj.geometry.unary_union\n\n# Compute distances\nquakes_proj['distance_m'] = quakes_proj.geometry.distance(boundary_union)\n\n# Find max distance\nmax_row = quakes_proj.loc[quakes_proj['distance_m'].idxmax()]\n\n# Map back to original row (same index)\norig_row = quakes_in_pac.loc[max_row.name]\n\n# Prepare output\n# Convert time from ms since epoch\niso_time = datetime.datetime.utcfromtimestamp(orig_row['time']/1000).strftime('%Y-%m-%dT%H:%M:%SZ')\n\ndistance_km = round(max_row['distance_m'] / 1000.0, 2)\n\nresult = {\n    'id': orig_row['id'],\n    'place': orig_row['place'],\n    'time': iso_time,\n    'magnitude': float(orig_row['mag']) if pd.notnull(orig_row['mag']) else None,\n    'latitude': float(orig_row.geometry.y),\n    'longitude': float(orig_row.geometry.x),\n    'distance_km': distance_km\n}\n\nwith open('/root/answer.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Result written to /root/answer.json')\nprint(result)\nPY\n"]
