[106.204119, "o", "                                                          0\r\nid                                               us6000pgf9\r\nmag                                                     5.1\r\nplace                        13 km NW of Port-Vila, Vanuatu\r\ntime                                          1735537742808\r\nupdated                                       1741473553040\r\ntz                                                     None\r\nurl       https://earthquake.usgs.gov/earthquakes/eventp...\r\ndetail    https://earthquake.usgs.gov/fdsnws/event/1/que...\r\nfelt                                                    5.0\r\ncdi                                                     4.3\r\nmmi                                                     NaN\r\nalert                                                  None\r\nstatus                                             reviewed\r\ntsunami                                                   0\r\nsig                                                     402\r\nnet                                                      us\r\ncode                                               6000pgf9\r\nids                             ,us6000pgf9,usauto6000pgf9,\r\nsources                                         ,us,usauto,\r\ntypes       ,dyfi,internal-moment-tensor,origin,phase-data,\r\nnst                                                   121.0\r\ndmin                                                  2.402\r\nrms                                                    0.47\r\ngap                                                    99.0\r\nmagType                                                 mww\r\ntype                                             earthquake\r\ntitle                M 5.1 - 13 km NW of Port-Vila, Vanuatu\r\ngeometry                 POINT Z (168.2183 -17.6555 66.612)\r\n"]
