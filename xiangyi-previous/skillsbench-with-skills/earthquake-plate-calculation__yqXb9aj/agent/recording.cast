[52.867995, "i", "python3 - <<'PY'\nimport json, datetime\nwith open('earthquakes_2024.json') as f:\n    data=json.load(f)\nfirst=data['features'][0]['properties']['time']\nprint('time value', first, type(first))\n# convert assuming ms since epoch\nprint('iso', datetime.datetime.utcfromtimestamp(first/1000).strftime('%Y-%m-%dT%H:%M:%SZ'))\nPY\n"]
