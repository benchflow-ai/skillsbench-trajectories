[15.736734, "i", "python3 - <<'PY'\nimport json\nfor fname in ['earthquakes_2024.json','PB2002_plates.json','PB2002_boundaries.json']:\n    with open(fname) as f:\n        data=json.load(f)\n    print(fname, type(data))\n    if isinstance(data, dict):\n        print('keys', data.keys())\n        # if GeoJSON\n        if 'features' in data:\n            print('num features', len(data['features']))\n            print('first feature keys', data['features'][0].keys())\n            print('first properties keys', data['features'][0].get('properties',{}).keys())\n            print('first geometry type', data['features'][0].get('geometry',{}).get('type'))\n    elif isinstance(data, list):\n        print('len', len(data))\n    print('---')\nPY\n"]
