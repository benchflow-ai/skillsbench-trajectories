[58.12698, "o", "vertices, faces = create_box_geometry(20, 2.0, 25)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.127041, "o", "> "]
[58.127163, "o", "vertices = apply_transform(vertices, (0, 1.0, 0))\r\n\u001b[?2004l\r"]
[58.127228, "o", "\u001b[?2004h> "]
[58.127435, "o", "add_mesh_to_part('support_structure', 'base_platform', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.127509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.127568, "o", "# Support legs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.127637, "o", "leg_params = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.127839, "o", "    ('support_leg_front_left', (-7.5, 2.0, 12.5), (0, 35, 2.5)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.128036, "o", "    ('support_leg_front_right', (7.5, 2.0, 12.5), (0, 35, 2.5)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.128351, "o", "    ('support_leg_back_left', (-7.5, 2.0, -12.5), (0, 35, -2.5)),\r\n"]
[58.128479, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[58.128667, "o", "    ('support_leg_back_right', (7.5, 2.0, -12.5), (0, 35, -2.5)),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[58.128771, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.128843, "o", "for leg_name, p1, p2 in leg_params:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.128891, "o", "> "]
[58.129028, "o", "    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.129216, "o", "    length = math.sqrt(dx*dx + dy*dy + dz*dz)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.129432, "o", "    vertices, faces = create_cylinder_geometry(0.8, length, 16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.129584, "o", "    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\r\n\u001b[?2004l\r"]
[58.129647, "o", "\u001b[?2004h> "]
[58.129765, "o", "    vertices = apply_transform(vertices, mid)\r\n\u001b[?2004l\r"]
[58.129806, "o", "\u001b[?2004h> "]
[58.129997, "o", "    add_mesh_to_part('support_structure', leg_name, vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.130062, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.130103, "o", "> # Cross braces\r\n\u001b[?2004l\r"]
[58.130162, "o", "\u001b[?2004h> "]
[58.130217, "o", "cross_brace_params = [\r\n\u001b[?2004l\r"]
[58.130268, "o", "\u001b[?2004h> "]
[58.130421, "o", "    ('cross_brace_front', (-7.5, 17.5, 12.5), (7.5, 17.5, 12.5)),\r\n\u001b[?2004l\r"]
[58.130474, "o", "\u001b[?2004h> "]
[58.130679, "o", "    ('cross_brace_back', (-7.5, 17.5, -12.5), (7.5, 17.5, -12.5)),\r\n\u001b[?2004l\r"]
[58.130731, "o", "\u001b[?2004h> "]
[58.130929, "o", "    ('cross_brace_left', (-7.5, 17.5, 12.5), (-7.5, 17.5, -12.5)),\r\n\u001b[?2004l\r"]
[58.130975, "o", "\u001b[?2004h> "]
[58.131169, "o", "    ('cross_brace_right', (7.5, 17.5, 12.5), (7.5, 17.5, -12.5)),\r\n\u001b[?2004l\r"]
[58.131211, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[58.131254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.131361, "o", "for brace_name, p1, p2 in cross_brace_params:\r\n\u001b[?2004l\r"]
[58.131408, "o", "\u001b[?2004h> "]
[58.13153, "o", "    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.131577, "o", "> "]
[58.13165, "o", "    length = math.sqrt(dx*dx + dy*dy + dz*dz)\r\n\u001b[?2004l\r"]
[58.131693, "o", "\u001b[?2004h> "]
[58.131824, "o", "    vertices, faces = create_cylinder_geometry(0.6, length, 16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.131867, "o", "> "]
[58.131978, "o", "    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\r\n\u001b[?2004l\r"]
[58.132023, "o", "\u001b[?2004h> "]
[58.132113, "o", "    vertices = apply_transform(vertices, mid)\r\n\u001b[?2004l\r"]
[58.132161, "o", "\u001b[?2004h> "]
[58.132295, "o", "    add_mesh_to_part('support_structure', brace_name, vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.132342, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.132383, "o", "# Axle housing\r\n\u001b[?2004l\r"]
[58.132425, "o", "\u001b[?2004h> "]
[58.132522, "o", "vertices, faces = create_box_geometry(7.5, 2, 7)\r\n\u001b[?2004l\r"]
[58.132568, "o", "\u001b[?2004h> "]
[58.132661, "o", "vertices = apply_transform(vertices, (0, 35, 0))\r\n\u001b[?2004l\r"]
[58.132705, "o", "\u001b[?2004h> "]
[58.13286, "o", "add_mesh_to_part('support_structure', 'axle_housing', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.132906, "o", "\u001b[?2004h> "]
[58.133089, "o", "print(f\"Created {len(part_data['support_structure'])} meshes for support_structure\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.133137, "o", "# WHEEL STRUCTURE\r\n\u001b[?2004l\r"]
[58.13318, "o", "\u001b[?2004h> "]
[58.133276, "o", "print(\"Creating wheel_structure meshes...\")\r\n\u001b[?2004l\r"]
[58.133321, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.133364, "o", "\u001b[?2004h> "]
[58.133429, "o", "# Central hub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.133556, "o", "vertices, faces = create_cylinder_geometry(2, 4, 32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.133605, "o", "> "]
[58.133736, "o", "vertices = apply_transform(vertices, (0, 35, 0), rotation_x=math.pi/2)\r\n\u001b[?2004l\r"]
[58.13378, "o", "\u001b[?2004h> "]
[58.133915, "o", "add_mesh_to_part('wheel_structure', 'central_hub', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.133961, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.134002, "o", "# Outer rim\r\n\u001b[?2004l\r"]
[58.134045, "o", "\u001b[?2004h> "]
[58.134163, "o", "vertices, faces = create_torus_geometry(30, 1.0, 16, 100)\r\n\u001b[?2004l\r"]
[58.134207, "o", "\u001b[?2004h> "]
[58.134331, "o", "vertices = apply_transform(vertices, (0, 35, 0), rotation_z=math.pi/2)\r\n\u001b[?2004l\r"]
[58.134375, "o", "\u001b[?2004h> "]
[58.134497, "o", "add_mesh_to_part('wheel_structure', 'outer_rim', vertices, faces)\r\n\u001b[?2004l\r"]
[58.134545, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.134588, "o", "# Spokes\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.134629, "o", "> "]
[58.13467, "o", "print(\"Creating spokes...\")\r\n\u001b[?2004l\r"]
[58.134714, "o", "\u001b[?2004h> "]
[58.134757, "o", "for i in range(32):\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.134803, "o", "> "]
[58.134863, "o", "    angle = (i / 32) * 2 * math.pi\r\n\u001b[?2004l\r"]
[58.134906, "o", "\u001b[?2004h> "]
[58.134973, "o", "    spoke_y = math.sin(angle) * 30\r\n\u001b[?2004l\r"]
[58.135019, "o", "\u001b[?2004h> "]
[58.135084, "o", "    spoke_z = math.cos(angle) * 30\r\n\u001b[?2004l\r"]
[58.135131, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[58.135175, "o", "\u001b[?2004h> "]
[58.135222, "o", "    # Front spoke\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.135278, "o", "    p1 = (2, 0, 0)\r\n\u001b[?2004l\r"]
[58.13532, "o", "\u001b[?2004h> "]
[58.135383, "o", "    p2 = (0.5, spoke_y, spoke_z)\r\n\u001b[?2004l\r"]
[58.135428, "o", "\u001b[?2004h> "]
[58.135606, "o", "    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.135705, "o", "    length = math.sqrt(dx*dx + dy*dy + dz*dz)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.135758, "o", "> "]
[58.135877, "o", "    vertices, faces = create_cylinder_geometry(0.2, length, 8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.135922, "o", "> "]
[58.136045, "o", "    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.136091, "o", "> "]
[58.136169, "o", "    vertices = apply_transform(vertices, mid)\r\n\u001b[?2004l\r"]
[58.136214, "o", "\u001b[?2004h> "]
[58.136366, "o", "    add_mesh_to_part('wheel_structure', f'spoke_front_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.136413, "o", ">     \r\n\u001b[?2004l\r"]
[58.136455, "o", "\u001b[?2004h> "]
[58.136499, "o", "    # Back spoke\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.136545, "o", "    p1 = (-2, 0, 0)\r\n\u001b[?2004l\r"]
[58.136587, "o", "\u001b[?2004h> "]
[58.136652, "o", "    p2 = (-0.5, spoke_y, spoke_z)\r\n\u001b[?2004l\r"]
[58.136697, "o", "\u001b[?2004h> "]
[58.136826, "o", "    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.136937, "o", "    length = math.sqrt(dx*dx + dy*dy + dz*dz)\r\n\u001b[?2004l\r"]
[58.136979, "o", "\u001b[?2004h> "]
[58.137118, "o", "    vertices, faces = create_cylinder_geometry(0.2, length, 8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.13716, "o", "> "]
[58.137287, "o", "    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.137328, "o", "> "]
[58.137441, "o", "    vertices = apply_transform(vertices, mid)\r\n\u001b[?2004l\r"]
[58.13747, "o", "\u001b[?2004h> "]
[58.137635, "o", "    add_mesh_to_part('wheel_structure', f'spoke_back_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.137664, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.13769, "o", "> "]
[58.137793, "o", "print(\"Creating cabins...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.137856, "o", "> for i in range(16):\r\n\u001b[?2004l\r"]
[58.137919, "o", "\u001b[?2004h> "]
[58.137972, "o", "    angle = (i / 16) * 2 * math.pi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.138052, "o", "    pivot_y = math.sin(angle) * 30 + 35\r\n\u001b[?2004l\r"]
[58.138098, "o", "\u001b[?2004h> "]
[58.138162, "o", "    pivot_z = math.cos(angle) * 30\r\n\u001b[?2004l\r"]
[58.138215, "o", "\u001b[?2004h> "]
[58.138266, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.138315, "o", "    # Cabin arm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.138359, "o", "    p1 = (0, 0, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.13841, "o", "> "]
[58.138464, "o", "    p2 = (0, -1.5, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.138536, "o", "    vertices, faces = create_cylinder_geometry(0.1, 1.5, 8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.13858, "o", "> "]
[58.138627, "o", "    mid = (0, pivot_y - 0.75, pivot_z)\r\n\u001b[?2004l\r"]
[58.138674, "o", "\u001b[?2004h> "]
[58.138722, "o", "    vertices = apply_transform(vertices, mid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.138767, "o", "> "]
[58.138826, "o", "    add_mesh_to_part('wheel_structure', f'cabin_arm_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.138874, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.138928, "o", ">     # Cabin body\r\n\u001b[?2004l\r"]
[58.138972, "o", "\u001b[?2004h> "]
[58.139009, "o", "    vertices, faces = create_cylinder_geometry(1.25, 2.5, 8)\r\n\u001b[?2004l\r"]
[58.139064, "o", "\u001b[?2004h> "]
[58.139143, "o", "    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 1.25, pivot_z))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.139205, "o", "> "]
[58.139292, "o", "    add_mesh_to_part('wheel_structure', f'cabin_body_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.139345, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.139451, "o", "    # Cabin roof\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.139507, "o", "    vertices, faces = create_cone_geometry(1.375, 0.5, 8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.139642, "o", "    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5 + 1.25, pivot_z))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.139664, "o", "> "]
[58.139782, "o", "    add_mesh_to_part('wheel_structure', f'cabin_roof_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.13983, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.139884, "o", "    # Cabin floor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.139977, "o", "    vertices, faces = create_cylinder_geometry(1.25, 0.1, 8)\r\n\u001b[?2004l\r"]
[58.140007, "o", "\u001b[?2004h> "]
[58.140111, "o", "    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5, pivot_z))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.140159, "o", "> "]
[58.140235, "o", "    add_mesh_to_part('wheel_structure', f'cabin_floor_{i}', vertices, faces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.140287, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.140339, "o", "> "]
[58.140398, "o", "print(f\"Created {len(part_data['wheel_structure'])} meshes for wheel_structure\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.140444, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.140508, "o", "# Create combined OBJ files for each part (links)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.140562, "o", "> "]
[58.140606, "o", "print(\"Creating combined part files...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.140663, "o", "for part_name, meshes in part_data.items():\r\n\u001b[?2004l\r"]
[58.140689, "o", "\u001b[?2004h> "]
[58.140725, "o", "    all_vertices = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.140863, "o", "    all_faces = []\r\n\u001b[?2004l\r\u001b[?2004h>     vertex_offset = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.140908, "o", "    for vertices, faces in meshes:\r\n\u001b[?2004l\r"]
[58.140966, "o", "\u001b[?2004h> "]
[58.141018, "o", "        all_vertices.extend(vertices)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.141069, "o", "        for face in faces:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.141218, "o", "            all_faces.append((face[0] + vertex_offset, face[1] + vertex_offset, face[2] + vertex_offset))\r\n\u001b[?2004l\r"]
[58.141269, "o", "\u001b[?2004h> "]
[58.141298, "o", "        vertex_offset += len(vertices)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.141364, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.141421, "o", "> "]
[58.141473, "o", "    write_obj(links_dir / f'{part_name}.obj', all_vertices, all_faces)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.141523, "o", "\u001b[?2004h> "]
[58.14157, "o", "print(\"\\nMesh export complete!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.141622, "o", "> "]
[58.141661, "o", "print(f\"Part meshes saved to: {part_meshes_dir}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.141724, "o", "print(f\"Part links saved to: {links_dir}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.141746, "o", "> EOF\r\n\u001b[?2004l\r"]
[58.143331, "o", "\u001b[?2004hroot@fd6fbba97a2c:~# "]
[61.277209, "i", "cd /root && python3 export_meshes.py\n"]
[61.277473, "o", "cd /root && python3 export_meshes.py\r\n\u001b[?2004l\r"]
[61.308743, "o", "Creating support_structure meshes...\r\n"]
[61.310374, "o", "Created 10 meshes for support_structure\r\nCreating wheel_structure meshes...\r\n"]
[61.31598, "o", "Creating spokes...\r\n"]
[61.32359, "o", "Creating cabins...\r\n"]
[61.331266, "o", "Created 130 meshes for wheel_structure\r\nCreating combined part files...\r\n"]
[61.340262, "o", "\r\nMesh export complete!\r\nPart meshes saved to: /root/output/part_meshes\r\nPart links saved to: /root/output/links\r\n"]
[61.345946, "o", "\u001b[?2004hroot@fd6fbba97a2c:~# "]
[68.533703, "i", "ls -la /root/output/\n"]
