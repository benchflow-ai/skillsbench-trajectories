[38.540953, "i", "cat > /root/geometry_utils.py << 'EOF'\nimport math\nfrom pathlib import Path\n\ndef create_box_geometry(width, height, depth):\n    w, h, d = width/2, height/2, depth/2\n    vertices = [\n        (-w, -h, -d), (w, -h, -d), (w, h, -d), (-w, h, -d),\n        (-w, -h, d), (w, -h, d), (w, h, d), (-w, h, d),\n    ]\n    faces = [\n        (0, 1, 2), (0, 2, 3), (4, 6, 5), (4, 7, 6),\n        (0, 4, 5), (0, 5, 1), (2, 6, 7), (2, 7, 3),\n        (0, 3, 7), (0, 7, 4), (1, 5, 6), (1, 6, 2),\n    ]\n    return vertices, faces\n\ndef create_cylinder_geometry(radius, height, segments=16):\n    vertices = []\n    faces = []\n    h = height / 2\n    \n    top_center = len(vertices)\n    vertices.append((0, h, 0))\n    bottom_center = len(vertices)\n    vertices.append((0, -h, 0))\n    \n    for i in range(segments):\n        angle = (i / segments) * 2 * math.pi\n        x = radius * math.cos(angle)\n        z = radius * math.sin(angle)\n        vertices.append((x, h, z))\n        vertices.append((x, -h, z))\n    \n    for i in range(segments):\n        next_i = (i + 1) % segments\n        v1 = 2 + i * 2\n        v2 = 2 + next_i * 2\n        faces.append((top_center, v1, v2))\n        faces.append((bottom_center, v2 + 1, v1 + 1))\n    \n    for i in range(segments):\n        next_i = (i + 1) % segments\n        v1 = 2 + i * 2\n        v2 = v1 + 1\n        v3 = 2 + next_i * 2\n        v4 = v3 + 1\n        faces.append((v1, v3, v4))\n        faces.append((v1, v4, v2))\n    \n    return vertices, faces\n\ndef create_torus_geometry(radius, tube_radius, segments=16, tube_segments=100):\n    vertices = []\n    faces = []\n    \n    for i in range(segments):\n        angle1 = (i / segments) * 2 * math.pi\n        for j in range(tube_segments):\n            angle2 = (j / tube_segments) * 2 * math.pi\n            x = (radius + tube_radius * math.cos(angle2)) * math.cos(angle1)\n            y = tube_radius * math.sin(angle2)\n            z = (radius + tube_radius * math.cos(angle2)) * math.sin(angle1)\n            vertices.append((x, y, z))\n    \n    for i in range(segments):\n        next_i = (i + 1) % segments\n        for j in range(tube_segments):\n            next_j = (j + 1) % tube_segments\n            v1 = i * tube_segments + j\n            v2 = i * tube_segments + next_j\n            v3 = next_i * tube_segments + next_j\n            v4 = next_i * tube_segments + j\n            faces.append((v1, v2, v3))\n            faces.append((v1, v3, v4))\n    \n    return vertices, faces\n\ndef create_cone_geometry(radius, height, segments=8):\n    vertices = []\n    faces = []\n    h = height / 2\n    \n    tip = len(vertices)\n    vertices.append((0, h, 0))\n    base_center = len(vertices)\n    vertices.append((0, -h, 0))\n    \n    for i in range(segments):\n        angle = (i / segments) * 2 * math.pi\n        x = radius * math.cos(angle)\n        z = radius * math.sin(angle)\n        vertices.append((x, -h, z))\n    \n    for i in range(segments):\n        next_i = (i + 1) % segments\n        v1 = 2 + i\n        v2 = 2 + next_i\n        faces.append((tip, v2, v1))\n    \n    for i in range(segments):\n        next_i = (i + 1) % segments\n        v1 = 2 + i\n        v2 = 2 + next_i\n        faces.append((base_center, v1, v2))\n    \n    return vertices, faces\n\ndef apply_transform(vertices, position, rotation_z=0, rotation_x=0):\n    transformed = []\n    for v in vertices:\n        x, y, z = v\n        \n        if rotation_x != 0:\n            cos_x = math.cos(rotation_x)\n            sin_x = math.sin(rotation_x)\n            y_rot = y * cos_x - z * sin_x\n            z_rot = y * sin_x + z * cos_x\n            y, z = y_rot, z_rot\n        \n        if rotation_z != 0:\n            cos_z = math.cos(rotation_z)\n            sin_z = math.sin(rotation_z)\n            x_rot = x * cos_z - y * sin_z\n            y_rot = x * sin_z + y * cos_z\n            x, y = x_rot, y_rot\n        \n        transformed.append((x + position[0], y + position[1], z + position[2]))\n    return transformed\n\ndef write_obj(filepath, vertices, faces):\n    Path(filepath).parent.mkdir(parents=True, exist_ok=True)\n    with open(filepath, 'w') as f:\n        for v in vertices:\n            f.write(f\""]
[38.541008, "i", "v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\\n\")\n        for face in faces:\n            f.write(f\"f {face[0]+1} {face[1]+1} {face[2]+1}\\n\")\nEOF\n"]
