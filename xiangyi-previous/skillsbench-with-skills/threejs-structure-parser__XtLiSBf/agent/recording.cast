[38.544496, "o", "def create_torus_geometry(radius, tube_radius, segments=16, tube_segments=100):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.544548, "o", "    vertices = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.544599, "o", "    faces = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[38.544639, "o", "\u001b[?2004h> "]
[38.54469, "o", "    for i in range(segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.544741, "o", "        angle1 = (i / segments) * 2 * math.pi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.544806, "o", "        for j in range(tube_segments):\r\n\u001b[?2004l\r"]
[38.544862, "o", "\u001b[?2004h> "]
[38.544908, "o", "            angle2 = (j / tube_segments) * 2 * math.pi\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.544957, "o", "> "]
[38.545033, "o", "            x = (radius + tube_radius * math.cos(angle2)) * math.cos(angle1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.545084, "o", "> "]
[38.545133, "o", "            y = tube_radius * math.sin(angle2)\r\n\u001b[?2004l\r"]
[38.545189, "o", "\u001b[?2004h> "]
[38.545249, "o", "            z = (radius + tube_radius * math.cos(angle2)) * math.sin(angle1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.545296, "o", "> "]
[38.545352, "o", "            vertices.append((x, y, z))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.545413, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.54547, "o", "    for i in range(segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.545515, "o", "        next_i = (i + 1) % segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.545553, "o", "        for j in range(tube_segments):\r\n\u001b[?2004l\r"]
[38.545608, "o", "\u001b[?2004h> "]
[38.545651, "o", "            next_j = (j + 1) % tube_segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.545707, "o", "            v1 = i * tube_segments + j\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.545751, "o", "> "]
[38.545788, "o", "            v2 = i * tube_segments + next_j\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.54584, "o", "> "]
[38.545878, "o", "            v3 = next_i * tube_segments + next_j\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.545923, "o", "> "]
[38.545964, "o", "            v4 = next_i * tube_segments + j\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.546015, "o", "> "]
[38.546051, "o", "            faces.append((v1, v2, v3))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.546105, "o", "            faces.append((v1, v3, v4))\r\n\u001b[?2004l\r"]
[38.546157, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.546193, "o", ">     return vertices, faces\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[38.54624, "o", "\u001b[?2004h> "]
[38.546307, "o", "def create_cone_geometry(radius, height, segments=8):\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.546356, "o", ">     vertices = []\r\n\u001b[?2004l\r"]
[38.546399, "o", "\u001b[?2004h>     faces = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.546451, "o", "    h = height / 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.546487, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.546538, "o", "    tip = len(vertices)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.546577, "o", "    vertices.append((0, h, 0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.546629, "o", "    base_center = len(vertices)\r\n\u001b[?2004l\r"]
[38.546672, "o", "\u001b[?2004h> "]
[38.546722, "o", "    vertices.append((0, -h, 0))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[38.546773, "o", "\u001b[?2004h>     for i in range(segments):\r\n\u001b[?2004l\r"]
[38.546828, "o", "\u001b[?2004h> "]
[38.546864, "o", "        angle = (i / segments) * 2 * math.pi\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.546914, "o", "> "]
[38.546953, "o", "        x = radius * math.cos(angle)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547006, "o", "        z = radius * math.sin(angle)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547054, "o", "> "]
[38.5471, "o", "        vertices.append((x, -h, z))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547151, "o", "> "]
[38.547191, "o", "    for i in range(segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547228, "o", "        next_i = (i + 1) % segments\r\n\u001b[?2004l\r"]
[38.547251, "o", "\u001b[?2004h> "]
[38.547302, "o", "        v1 = 2 + i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.54735, "o", "        v2 = 2 + next_i\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547375, "o", "> "]
[38.547463, "o", "        faces.append((tip, v2, v1))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547502, "o", "    for i in range(segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547549, "o", "        next_i = (i + 1) % segments\r\n\u001b[?2004l\r"]
[38.547596, "o", "\u001b[?2004h> "]
[38.547651, "o", "        v1 = 2 + i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547689, "o", "        v2 = 2 + next_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547734, "o", "        faces.append((base_center, v1, v2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547787, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.547831, "o", "    return vertices, faces\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547884, "o", "> "]
[38.547941, "o", "def apply_transform(vertices, position, rotation_z=0, rotation_x=0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.547964, "o", "> "]
[38.548008, "o", "    transformed = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.548075, "o", ">     for v in vertices:\r\n\u001b[?2004l\r"]
[38.548115, "o", "\u001b[?2004h>         x, y, z = v\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[38.548171, "o", "\u001b[?2004h> "]
[38.548211, "o", "        if rotation_x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548253, "o", "            cos_x = math.cos(rotation_x)\r\n\u001b[?2004l\r"]
[38.548307, "o", "\u001b[?2004h> "]
[38.548348, "o", "            sin_x = math.sin(rotation_x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548401, "o", "            y_rot = y * cos_x - z * sin_x\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.548446, "o", "> "]
[38.548502, "o", "            z_rot = y * sin_x + z * cos_x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548542, "o", "            y, z = y_rot, z_rot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548591, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548629, "o", "        if rotation_z != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548699, "o", "            cos_z = math.cos(rotation_z)\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.548742, "o", "> "]
[38.548787, "o", "            sin_z = math.sin(rotation_z)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.548853, "o", "            x_rot = x * cos_z - y * sin_z\r\n\u001b[?2004l\r"]
[38.5489, "o", "\u001b[?2004h> "]
[38.548947, "o", "            y_rot = x * sin_z + y * cos_z\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.548985, "o", "> "]
[38.549013, "o", "            x, y = x_rot, y_rot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549059, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.54916, "o", "        transformed.append((x + position[0], y + position[1], z + position[2]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.549183, "o", "> "]
[38.549207, "o", "    return transformed\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.549256, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549324, "o", "def write_obj(filepath, vertices, faces):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549431, "o", "    Path(filepath).parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549487, "o", "    with open(filepath, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549542, "o", "        for v in vertices:\r\n\u001b[?2004l\r"]
[38.549588, "o", "\u001b[?2004h> "]
[38.549645, "o", "            f.write(f\"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.549696, "o", "> "]
[38.549734, "o", "        for face in faces:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.549806, "o", "            f.write(f\"f {face[0]+1} {face[1]+1} {face[2]+1}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.54985, "o", "> EOF\r\n\u001b[?2004l\r"]
[38.55098, "o", "\u001b[?2004hroot@fd6fbba97a2c:~# "]
[58.12398, "i", "cat > /root/export_meshes.py << 'EOF'\nimport math\nfrom pathlib import Path\nfrom geometry_utils import *\n\noutput_base = Path('/root/output')\npart_meshes_dir = output_base / 'part_meshes'\nlinks_dir = output_base / 'links'\n\npart_meshes_dir.mkdir(parents=True, exist_ok=True)\nlinks_dir.mkdir(parents=True, exist_ok=True)\n\n# Store all meshes for each part to create combined links\npart_data = {}\n\ndef add_mesh_to_part(part_name, mesh_name, vertices, faces):\n    if part_name not in part_data:\n        part_data[part_name] = []\n    part_data[part_name].append((vertices, faces))\n    write_obj(part_meshes_dir / part_name / f'{mesh_name}.obj', vertices, faces)\n\n# SUPPORT STRUCTURE\nprint(\"Creating support_structure meshes...\")\n\n# Base platform\nvertices, faces = create_box_geometry(20, 2.0, 25)\nvertices = apply_transform(vertices, (0, 1.0, 0))\nadd_mesh_to_part('support_structure', 'base_platform', vertices, faces)\n\n# Support legs\nleg_params = [\n    ('support_leg_front_left', (-7.5, 2.0, 12.5), (0, 35, 2.5)),\n    ('support_leg_front_right', (7.5, 2.0, 12.5), (0, 35, 2.5)),\n    ('support_leg_back_left', (-7.5, 2.0, -12.5), (0, 35, -2.5)),\n    ('support_leg_back_right', (7.5, 2.0, -12.5), (0, 35, -2.5)),\n]\n\nfor leg_name, p1, p2 in leg_params:\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.8, length, 16)\n    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part('support_structure', leg_name, vertices, faces)\n\n# Cross braces\ncross_brace_params = [\n    ('cross_brace_front', (-7.5, 17.5, 12.5), (7.5, 17.5, 12.5)),\n    ('cross_brace_back', (-7.5, 17.5, -12.5), (7.5, 17.5, -12.5)),\n    ('cross_brace_left', (-7.5, 17.5, 12.5), (-7.5, 17.5, -12.5)),\n    ('cross_brace_right', (7.5, 17.5, 12.5), (7.5, 17.5, -12.5)),\n]\n\nfor brace_name, p1, p2 in cross_brace_params:\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.6, length, 16)\n    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part('support_structure', brace_name, vertices, faces)\n\n# Axle housing\nvertices, faces = create_box_geometry(7.5, 2, 7)\nvertices = apply_transform(vertices, (0, 35, 0))\nadd_mesh_to_part('support_structure', 'axle_housing', vertices, faces)\n\nprint(f\"Created {len(part_data['support_structure'])} meshes for support_structure\")\n\n# WHEEL STRUCTURE\nprint(\"Creating wheel_structure meshes...\")\n\n# Central hub\nvertices, faces = create_cylinder_geometry(2, 4, 32)\nvertices = apply_transform(vertices, (0, 35, 0), rotation_x=math.pi/2)\nadd_mesh_to_part('wheel_structure', 'central_hub', vertices, faces)\n\n# Outer rim\nvertices, faces = create_torus_geometry(30, 1.0, 16, 100)\nvertices = apply_transform(vertices, (0, 35, 0), rotation_z=math.pi/2)\nadd_mesh_to_part('wheel_structure', 'outer_rim', vertices, faces)\n\n# Spokes\nprint(\"Creating spokes...\")\nfor i in range(32):\n    angle = (i / 32) * 2 * math.pi\n    spoke_y = math.sin(angle) * 30\n    spoke_z = math.cos(angle) * 30\n    \n    # Front spoke\n    p1 = (2, 0, 0)\n    p2 = (0.5, spoke_y, spoke_z)\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.2, length, 8)\n    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part('wheel_structure', f'spoke_front_{i}', vertices, faces)\n    \n    # Back spoke\n    p1 = (-2, 0, 0)\n    p2 = (-0.5, spoke_y, spoke_z)\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.2, length, 8)\n    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part('wheel_structure', f'spoke_back_{i}', vertices, faces)\n\nprint(\"Creating cabins...\")\nfor i in "]
[58.124257, "i", "range(16):\n    angle = (i / 16) * 2 * math.pi\n    pivot_y = math.sin(angle) * 30 + 35\n    pivot_z = math.cos(angle) * 30\n    \n    # Cabin arm\n    p1 = (0, 0, 0)\n    p2 = (0, -1.5, 0)\n    vertices, faces = create_cylinder_geometry(0.1, 1.5, 8)\n    mid = (0, pivot_y - 0.75, pivot_z)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part('wheel_structure', f'cabin_arm_{i}', vertices, faces)\n    \n    # Cabin body\n    vertices, faces = create_cylinder_geometry(1.25, 2.5, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 1.25, pivot_z))\n    add_mesh_to_part('wheel_structure', f'cabin_body_{i}', vertices, faces)\n    \n    # Cabin roof\n    vertices, faces = create_cone_geometry(1.375, 0.5, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5 + 1.25, pivot_z))\n    add_mesh_to_part('wheel_structure', f'cabin_roof_{i}', vertices, faces)\n    \n    # Cabin floor\n    vertices, faces = create_cylinder_geometry(1.25, 0.1, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5, pivot_z))\n    add_mesh_to_part('wheel_structure', f'cabin_floor_{i}', vertices, faces)\n\nprint(f\"Created {len(part_data['wheel_structure'])} meshes for wheel_structure\")\n\n# Create combined OBJ files for each part (links)\nprint(\"Creating combined part files...\")\nfor part_name, meshes in part_data.items():\n    all_vertices = []\n    all_faces = []\n    vertex_offset = 0\n    \n    for vertices, faces in meshes:\n        all_vertices.extend(vertices)\n        for face in faces:\n            all_faces.append((face[0] + vertex_offset, face[1] + vertex_offset, face[2] + vertex_offset))\n        vertex_offset += len(vertices)\n    \n    write_obj(links_dir / f'{part_name}.obj', all_vertices, all_faces)\n\nprint(\"\\nMesh export complete!\")\nprint(f\"Part meshes saved to: {part_meshes_dir}\")\nprint(f\"Part links saved to: {links_dir}\")\nEOF\n"]
