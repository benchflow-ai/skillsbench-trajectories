[?2004l[?2004h>     vertex_offset = 0
[?2004l[?2004h>     
[?2004l[?2004h>     for vertices, faces in meshes:
[?2004l[?2004h>         all_vertices.extend(vertices)
[?2004l[?2004h>         for face in faces:
[?2004l[?2004h>             all_faces.append((face[0] + vertex_offset, face[1] + vertex_offset, face[2] + vertex_offset))
[?2004l[?2004h>         vertex_offset += len(vertices)
[?2004l[?2004h>     
[?2004l[?2004h>     write_obj(links_dir / f'{part_name}.obj', all_vertices, all_faces)
[?2004l[?2004h> 
