[?2004l[?2004h> # Axle housing
[?2004l[?2004h> vertices, faces = create_box_geometry(7.5, 2, 7)
[?2004l[?2004h> vertices = apply_transform(vertices, (0, 35, 0))
[?2004l[?2004h> add_mesh_to_part('support_structure', 'axle_housing', vertices, faces)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Created {len(part_data['support_structure'])} meshes for support_structure")
[?2004l[?2004h> 
[?2004l[?2004h> # WHEEL STRUCTURE
[?2004l[?2004h> print("Creating wheel_structure meshes...")
[?2004l[?2004h> 
[?2004l[?2004h> # Central hub
[?2004l[?2004h> vertices, faces = create_cylinder_geometry(2, 4, 32)
[?2004l[?2004h> vertices = apply_transform(vertices, (0, 35, 0), rotation_x=math.pi/2)
[?2004l[?2004h> add_mesh_to_part('wheel_structure', 'central_hub', vertices, faces)
[?2004l[?2004h> 
[?2004l[?2004h> # Outer rim
[?2004l[?2004h> vertices, faces = create_torus_geometry(30, 1.0, 16, 100)
[?2004l[?2004h> vertices = apply_transform(vertices, (0, 35, 0), rotation_z=math.pi/2)
[?2004l[?2004h> add_mesh_to_part('wheel_structure', 'outer_rim', vertices, faces)
[?2004l[?2004h> 
[?2004l[?2004h> # Spokes
[?2004l[?2004h> print("Creating spokes...")
[?2004l[?2004h> for i in range(32):
[?2004l[?2004h>     angle = (i / 32) * 2 * math.pi
[?2004l[?2004h>     spoke_y = math.sin(angle) * 30
[?2004l[?2004h>     spoke_z = math.cos(angle) * 30
[?2004l[?2004h>     
[?2004l[?2004h>     # Front spoke
[?2004l[?2004h>     p1 = (2, 0, 0)
[?2004l[?2004h>     p2 = (0.5, spoke_y, spoke_z)
[?2004l[?2004h>     dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]
[?2004l[?2004h>     length = math.sqrt(dx*dx + dy*dy + dz*dz)
[?2004l[?2004h>     vertices, faces = create_cylinder_geometry(0.2, length, 8)
[?2004l[?2004h>     mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)
[?2004l[?2004h>     vertices = apply_transform(vertices, mid)
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'spoke_front_{i}', vertices, faces)
[?2004l[?2004h>     
[?2004l[?2004h>     # Back spoke
[?2004l[?2004h>     p1 = (-2, 0, 0)
[?2004l[?2004h>     p2 = (-0.5, spoke_y, spoke_z)
[?2004l[?2004h>     dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]
[?2004l[?2004h>     length = math.sqrt(dx*dx + dy*dy + dz*dz)
[?2004l[?2004h>     vertices, faces = create_cylinder_geometry(0.2, length, 8)
[?2004l[?2004h>     mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)
[?2004l[?2004h>     vertices = apply_transform(vertices, mid)
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'spoke_back_{i}', vertices, faces)
[?2004l[?2004h> 
[?2004l[?2004h> print("Creating cabins...")
[?2004l[?2004h> for i in range(16):
[?2004l[?2004h>     angle = (i / 16) * 2 * math.pi
[?2004l[?2004h>     pivot_y = math.sin(angle) * 30 + 35
[?2004l[?2004h>     pivot_z = math.cos(angle) * 30
[?2004l[?2004h>     
[?2004l[?2004h>     # Cabin arm
[?2004l[?2004h>     p1 = (0, 0, 0)
[?2004l[?2004h>     p2 = (0, -1.5, 0)
[?2004l[?2004h>     vertices, faces = create_cylinder_geometry(0.1, 1.5, 8)
[?2004l[?2004h>     mid = (0, pivot_y - 0.75, pivot_z)
[?2004l[?2004h>     vertices = apply_transform(vertices, mid)
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'cabin_arm_{i}', vertices, faces)
[?2004l[?2004h>     
[?2004l[?2004h>     # Cabin body
[?2004l[?2004h>     vertices, faces = create_cylinder_geometry(1.25, 2.5, 8)
[?2004l[?2004h>     vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 1.25, pivot_z))
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'cabin_body_{i}', vertices, faces)
[?2004l[?2004h>     
[?2004l[?2004h>     # Cabin roof
[?2004l[?2004h>     vertices, faces = create_cone_geometry(1.375, 0.5, 8)
[?2004l[?2004h>     vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5 + 1.25, pivot_z))
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'cabin_roof_{i}', vertices, faces)
[?2004l[?2004h>     
[?2004l[?2004h>     # Cabin floor
[?2004l[?2004h>     vertices, faces = create_cylinder_geometry(1.25, 0.1, 8)
[?2004l[?2004h>     vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5, pivot_z))
[?2004l[?2004h>     add_mesh_to_part('wheel_structure', f'cabin_floor_{i}', vertices, faces)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Created {len(part_data['wheel_structure'])} meshes for wheel_structure")
[?2004l[?2004h> 
[?2004l[?2004h> # Create combined OBJ files for each part (links)
[?2004l[?2004h> print("Creating combined part files...")
[?2004l[?2004h> for part_name, meshes in part_data.items():
[?2004l[?2004h>     all_vertices = []
