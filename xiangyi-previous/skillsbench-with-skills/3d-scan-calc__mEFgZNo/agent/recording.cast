[64.343551, "o", "Comp 0 Min: [-10.0, -10.0, 0.0]\r\nComp 0 Max: [10.0, 10.0, 20.0]\r\nComp 0 Dimensions: [20.0, 20.0, 20.0]\r\n"]
[64.346296, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
[96.015321, "i", "cat << 'EOF' > /root/check_all_comps.py\nimport struct\nimport collections\n\ndef solve():\n    with open('/root/scan_data.stl', 'rb') as f:\n        f.read(84)\n        triangles = []\n        while True:\n            data = f.read(50)\n            if len(data) < 50: break\n            parts = struct.unpack('<ffffffffffffH', data)\n            v1, v2, v3 = parts[3:6], parts[6:9], parts[9:12]\n            triangles.append({'v1': v1, 'v2': v2, 'v3': v3, 'attr': parts[12]})\n\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri['v1'], tri['v2'], tri['v3']]:\n            vertex_to_triangles[tuple(v)].append(i)\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices: \n            for j in tri_indices: \n                if i != j: adj[i].add(j)\n    visited = [False] * len(triangles)\n    components = []\n    for i in range(len(triangles)):\n        if not visited[i]:\n            comp = []; stack = [i]; visited[i] = True\n            while stack:\n                u = stack.pop(); comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]: visited[v] = True; stack.append(v)\n            components.append(comp)\n\n    for i, comp in enumerate(sorted(components, key=len, reverse=True)):\n        min_coords = [float('inf')] * 3\n        max_coords = [float('-inf')] * 3\n        for idx in comp:\n            for v in [triangles[idx]['v1'], triangles[idx]['v2'], triangles[idx]['v3']]:\n                for k in range(3):\n                    min_coords[k] = min(min_coords[k], v[k])\n                    max_coords[k] = max(max_coords[k], v[k])\n        dims = [max_coords[k] - min_coords[k] for k in range(3)]\n        print(f\"Comp {i}: triangles={len(comp)}, dims={dims}, material={triangles[comp[0]]['attr']}\")\n\nsolve()\nEOF\npython3 /root/check_all_comps.py | head -n 10\n"]
