[45.349222, "o", "        cp_z = v2[0] * v3[1] - v2[1] * v3[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.34935, "o", "        vol = (v1[0] * cp_x + v1[1] * cp_y + v1[2] * cp_z) / 6.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.349413, "o", "        total_volume_mm3 += vol\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.349463, "o", ">         material_ids.append(tri['attr'])\r\n\u001b[?2004l\r"]
[45.349512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.349595, "o", "    total_volume_cm3 = abs(total_volume_mm3) / 1000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.349761, "o", "    material_id = collections.Counter(material_ids).most_common(1)[0][0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.349818, "o", "\u001b[?2004h> "]
[45.349868, "o", "    densities = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350001, "o", "        1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350055, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350106, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.35019, "o", "    density = densities.get(material_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350254, "o", "    mass = total_volume_cm3 * density\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350306, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350355, "o", "    result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350441, "o", "        \"main_part_mass\": round(mass, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350502, "o", "        \"material_id\": material_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350551, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350599, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350709, "o", "    with open('/root/mass_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350818, "o", "        json.dump(result, f, indent=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350936, "o", "    print(json.dumps(result, indent=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.350992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> solve()\r\n\u001b[?2004l\r"]
[45.351042, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[45.357228, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
[45.357388, "o", "python3 /root/calculate_mass.py\r\n\u001b[?2004l\r"]
[45.37828, "o", "{\r\n \"main_part_mass\": 34.65,\r\n \"material_id\": 42\r\n}\r\n"]
[45.381363, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
[57.516469, "i", "cat << 'EOF' > /root/check_vol.py\nimport struct\nimport collections\n\ndef solve():\n    with open('/root/scan_data.stl', 'rb') as f:\n        f.read(84)\n        triangles = []\n        while True:\n            data = f.read(50)\n            if len(data) < 50: break\n            parts = struct.unpack('<ffffffffffffH', data)\n            v1, v2, v3 = parts[3:6], parts[6:9], parts[9:12]\n            triangles.append({'v1': v1, 'v2': v2, 'v3': v3, 'attr': parts[12]})\n\n    # Check components\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri['v1'], tri['v2'], tri['v3']]:\n            vertex_to_triangles[tuple(v)].append(i)\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices:\n            for j in tri_indices:\n                if i != j: adj[i].add(j)\n    visited = [False] * len(triangles)\n    components = []\n    for i in range(len(triangles)):\n        if not visited[i]:\n            comp = []; stack = [i]; visited[i] = True\n            while stack:\n                u = stack.pop(); comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]: visited[v] = True; stack.append(v)\n            components.append(comp)\n\n    print(f\"Number of components: {len(components)}\")\n    for i, comp in enumerate(sorted(components, key=len, reverse=True)):\n        vol = 0\n        m_ids = []\n        for idx in comp:\n            tri = triangles[idx]\n            v1, v2, v3 = tri['v1'], tri['v2'], tri['v3']\n            vol += (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) + v1[1]*(v2[2]*v3[0]-v2[0]*v3[2]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0])) / 6.0\n            m_ids.append(tri['attr'])\n        print(f\"Component {i}: triangles={len(comp)}, material={collections.Counter(m_ids).most_common(1)}, volume={vol}\")\n\nsolve()\nEOF\npython3 /root/check_vol.py\n"]
