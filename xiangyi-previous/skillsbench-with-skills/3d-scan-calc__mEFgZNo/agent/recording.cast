[108.103486, "o", "                for v in adj[u]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.103543, "o", "> "]
[108.103717, "o", "                    if not visited[v]: visited[v] = True; stack.append(v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.103802, "o", "            components.append(comp)\r\n\u001b[?2004l\r"]
[108.10387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.104008, "o", "    largest_comp_indices = max(components, key=len)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.104078, "o", "    total_volume_mm3 = 0.0\r\n\u001b[?2004l\r"]
[108.10413, "o", "\u001b[?2004h> "]
[108.10418, "o", "    material_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.104274, "o", "    for idx in largest_comp_indices:\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.104324, "o", "> "]
[108.104376, "o", "        tri = triangles[idx]\r\n\u001b[?2004l\r"]
[108.104427, "o", "\u001b[?2004h> "]
[108.104547, "o", "        v1, v2, v3 = tri['v1'], tri['v2'], tri['v3']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.104912, "o", "        total_volume_mm3 += (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) + v1[1]*(v2[2]*v3[0]-v2[0]*v3[2]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0])) / 6.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105019, "o", "        material_ids.append(tri['attr'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105101, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.10521, "o", "    total_volume_cm3 = abs(total_volume_mm3) / 1000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105417, "o", "    material_id = collections.Counter(material_ids).most_common(1)[0][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105609, "o", "    densities = {1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34}\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.105673, "o", "> "]
[108.10575, "o", "    mass = total_volume_cm3 * densities[material_id]\r\n\u001b[?2004l\r"]
[108.105802, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105863, "o", "    result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.105944, "o", "        \"main_part_mass\": mass,\r\n\u001b[?2004l\r"]
[108.106002, "o", "\u001b[?2004h> "]
[108.106061, "o", "        \"material_id\": material_id\r\n\u001b[?2004l\r"]
[108.10612, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.106266, "o", "    with open('/root/mass_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.106385, "o", "        json.dump(result, f, indent=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.106443, "o", "> "]
[108.106505, "o", "    print(json.dumps(result, indent=1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.106562, "o", "> solve()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.106618, "o", "EOF\r\n\u001b[?2004l\r"]
[108.107951, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
[108.108033, "o", "python3 /root/calculate_mass.py\r\n\u001b[?2004l\r"]
[108.127968, "o", "{\r\n \"main_part_mass\": 34.648041234901754,\r\n \"material_id\": 42\r\n}\r\n"]
[108.130997, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
