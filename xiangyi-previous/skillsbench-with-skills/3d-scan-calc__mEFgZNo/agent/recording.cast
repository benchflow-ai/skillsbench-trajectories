[36.473246, "o", "\u001b[?2004hroot@18c148984ddb:~# "]
[45.344456, "i", "cat << 'EOF' > /root/calculate_mass.py\nimport struct\nimport collections\nimport json\n\ndef solve():\n    with open('/root/scan_data.stl', 'rb') as f:\n        header = f.read(80)\n        num_triangles_raw = f.read(4)\n        if not num_triangles_raw:\n            return\n        num_triangles = struct.unpack('<I', num_triangles_raw)[0]\n        \n        triangles = []\n        for i in range(num_triangles):\n            data = f.read(50)\n            if len(data) < 50:\n                break\n            parts = struct.unpack('<ffffffffffffH', data)\n            v1 = parts[3:6]\n            v2 = parts[6:9]\n            v3 = parts[9:12]\n            attr = parts[12]\n            triangles.append({'v1': v1, 'v2': v2, 'v3': v3, 'attr': attr})\n\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri['v1'], tri['v2'], tri['v3']]:\n            vertex_to_triangles[tuple(v)].append(i)\n\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices:\n            for j in tri_indices:\n                if i != j:\n                    adj[i].add(j)\n\n    visited = [False] * len(triangles)\n    components = []\n    for i in range(len(triangles)):\n        if not visited[i]:\n            comp = []\n            stack = [i]\n            visited[i] = True\n            while stack:\n                u = stack.pop()\n                comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]:\n                        visited[v] = True\n                        stack.append(v)\n            components.append(comp)\n\n    largest_comp_indices = max(components, key=len)\n    \n    total_volume_mm3 = 0.0\n    material_ids = []\n    for idx in largest_comp_indices:\n        tri = triangles[idx]\n        v1, v2, v3 = tri['v1'], tri['v2'], tri['v3']\n        cp_x = v2[1] * v3[2] - v2[2] * v3[1]\n        cp_y = v2[2] * v3[0] - v2[0] * v3[2]\n        cp_z = v2[0] * v3[1] - v2[1] * v3[0]\n        vol = (v1[0] * cp_x + v1[1] * cp_y + v1[2] * cp_z) / 6.0\n        total_volume_mm3 += vol\n        material_ids.append(tri['attr'])\n\n    total_volume_cm3 = abs(total_volume_mm3) / 1000.0\n    material_id = collections.Counter(material_ids).most_common(1)[0][0]\n\n    densities = {\n        1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34\n    }\n    \n    density = densities.get(material_id, 0.0)\n    mass = total_volume_cm3 * density\n\n    result = {\n        \"main_part_mass\": round(mass, 2),\n        \"material_id\": material_id\n    }\n    \n    with open('/root/mass_report.json', 'w') as f:\n        json.dump(result, f, indent=1)\n    print(json.dumps(result, indent=1))\n\nsolve()\nEOF\npython3 /root/calculate_mass.py\n"]
