[?2004hroot@18c148984ddb:~# cat /root/material_density_table.md
[?2004l# Proprietary Material Density Table

This table lists the density values for the proprietary materials used in the Constructo-95 system.
Use the Material ID found in the CAD file attributes to lookup the corresponding density.

| Material ID | Material Name | Density (g/cm³) | Description |
| :--- | :--- | :--- | :--- |
| **1** | Generic Debris | 0.10 | Low-density dust/noise artifacts. |
| **10** | Standard Steel | 7.85 | Common structural steel. |
| **25** | Aluminum 6061 | 2.70 | Aerospace grade aluminum. |
| **42** | Unobtanium | 5.55 | High-strength proprietary alloy. |
| **99** | Lead | 11.34 | Heavy ballast material. |

## Formula

$$ Mass = Volume \times Density $$

Note: Ensure volume is in $cm^3$ and density is in $g/cm^3$.
[?2004hroot@18c148984ddb:~# cat << 'EOF' > /root/calculate_mass.py
[?2004l[?2004h> import struct
[?2004l[?2004h> import collections
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     with open('/root/scan_data.stl', 'rb') as f:
[?2004l[?2004h>         header = f.read(80)
[?2004l[?2004h>         num_triangles_raw = f.read(4)
[?2004l[?2004h>         if not num_triangles_raw:
[?2004l[?2004h>             return
[?2004l[?2004h>         num_triangles = struct.unpack('<I', num_triangles_raw)[0]
[?2004l[?2004h>         
[?2004l[?2004h>         triangles = []
[?2004l[?2004h>         for i in range(num_triangles):
[?2004l[?2004h>             data = f.read(50)
[?2004l[?2004h>             if len(data) < 50:
[?2004l[?2004h>                 break
[?2004l[?2004h>             # Normal (3 floats), V1, V2, V3 (each 3 floats), Attribute (1 uint16)
[?2004l[?2004h>             parts = struct.unpack('<ffffffffffffH', data)
[?2004l[?2004h>             normal = parts[0:3]
[?2004l[?2004h>             v1 = parts[3:6]
[?2004l[?2004h>             v2 = parts[6:9]
[?2004l[?2004h>             v3 = parts[9:12]
[?2004l[?2004h>             attr = parts[12]
[?2004l[?2004h>             triangles.append({'v1': v1, 'v2': v2, 'v3': v3, 'attr': attr, 'id': i})
[?2004l[?2004h> 
[?2004l[?2004h>     # Build connectivity graph
[?2004l[?2004h>     # Use vertices as keys to find triangles sharing them
[?2004l[?2004h>     vertex_to_triangles = collections.defaultdict(list)
[?2004l[?2004h>     for i, tri in enumerate(triangles):
[?2004l[?2004h>         for v in [tri['v1'], tri['v2'], tri['v3']]:
[?2004l[?2004h>             vertex_to_triangles[tuple(v)].append(i)
[?2004l[?2004h> 
[?2004l[?2004h>     adj = collections.defaultdict(set)
[?2004l[?2004h>     for tri_indices in vertex_to_triangles.values():
[?2004l[?2004h>         for i in tri_indices:
[?2004l[?2004h>             for j in tri_indices:
[?2004l[?2004h>                 if i != j:
[?2004l[?2004h>                     adj[i].add(j)
[?2004l[?2004h> 
[?2004l[?2004h>     # Find connected components
[?2004l[?2004h>     visited = [False] * num_triangles
[?2004l[?2004h>     components = []
[?2004l[?2004h>     for i in range(num_triangles):
[?2004l[?2004h>         if not visited[i]:
[?2004l[?2004h>             comp = []
[?2004l[?2004h>             stack = [i]
[?2004l[?2004h>             visited[i] = True
[?2004l[?2004h>             while stack:
[?2004l[?2004h>                 u = stack.pop()
[?2004l[?2004h>                 comp.append(u)
[?2004l[?2004h>                 for v in adj[u]:
[?2004l[?2004h>                     if not visited[v]:
[?2004l[?2004h>                         visited[v] = True
[?2004l[?2004h>                         stack.append(v)
[?2004l[?2004h>             components.append(comp)
[?2004l[?2004h> 
[?2004l[?2004h>     # Identify the largest component (by number of triangles)
[?2004l[?2004h>     largest_comp_indices = max(components, key=len)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate volume of the largest component
[?2004l[?2004h>     # Volume = sum of signed volume of tetrahedra (origin to triangle)
[?2004l[?2004h>     # Volume = (1/6) * |sum(v1 . (v2 x v3))|
[?2004l[?2004h>     total_volume = 0.0
[?2004l[?2004h>     material_ids = []
[?2004l[?2004h>     for idx in largest_comp_indices:
[?2004l[?2004h>         tri = triangles[idx]
[?2004l[?2004h>         v1, v2, v3 = tri['v1'], tri['v2'], tri['v3']
[?2004l[?2004h>         # Signed volume of tetrahedron formed by origin and triangle
[?2004l[?2004h>         # cross product v2 x v3
[?2004l[?2004h>         cp_x = v2[1] * v3[2] - v2[2] * v3[1]
[?2004l[?2004h>         cp_y = v2[2] * v3[0] - v2[0] * v3[2]
[?2004l[?2004h>         cp_z = v2[0] * v3[1] - v2[1] * v3[0]
[?2004l[?2004h>         # dot product v1 . (v2 x v3)
[?2004l[?2004h>         vol = (v1[0] * cp_x + v1[1] * cp_y + v1[2] * cp_z) / 6.0
[?2004l[?2004h>         total_volume += vol
[?2004l[?2004h>         material_ids.append(tri['attr'])
[?2004l[?2004h> 
[?2004l[?2004h>     total_volume = abs(total_volume)
[?2004l[?2004h>     # Assuming the most frequent material ID in the component is the correct one
[?2004l[?2004h>     material_id = collections.Counter(material_ids).most_common(1)[0][0]
[?2004l[?2004h> 
[?2004l[?2004h>     # Density table
[?2004l[?2004h>     densities = {
[?2004l[?2004h>         1: 0.10,
[?2004l[?2004h>         10: 7.85,
[?2004l[?2004h>         25: 2.70,
[?2004l[?2004h>         42: 5.55,
[?2004l[?2004h>         99: 11.34
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     density = densities.get(material_id, 0.0)
[?2004l[?2004h>     # Assuming STL units are in cm. If they were mm, we'd need to divide volume by 1000.
[?2004l[?2004h>     # Given the task description, let's check if the volume seems reasonable for cm.
[?2004l[?2004h>     # If the mass is huge or tiny, we might need to reconsider.
[?2004l[?2004h>     # Usually, STL is in mm. Let's assume mm and see. 
[?2004l[?2004h>     # Wait, the note says 'Ensure volume is in cm^3 and density is in g/cm^3'.
[?2004l[?2004h>     # If the STL is in mm, Vol_cm3 = Vol_mm3 / 1000.
[?2004l[?2004h>     # Let's look at the coordinates.
[?2004l[?2004h>     
[?2004l[?2004h>     # For now, let's assume the coordinates are already in cm.
[?2004l[?2004h>     # If the results are expected in g, and the density is g/cm^3, then mass = volume * density.
[?2004l[?2004h>     
[?2004l[?2004h>     mass = total_volume * density
[?2004l[?2004h> 
[?2004l[?2004h>     import json
[?2004l[?2004h>     result = {
[?2004l[?2004h>         "main_part_mass": round(mass, 2),
[?2004l[?2004h>         "material_id": material_id
[?2004l[?2004h>     }
[?2004l[?2004h>     print(json.dumps(result, indent=1))
[?2004l[?2004h> 
