[154.745488, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[154.745536, "o", "> "]
[154.745571, "o", "  def tokenizeToStrings(text: String): List[String] =\r\n\u001b[?2004l\r"]
[154.745621, "o", "\u001b[?2004h> "]
[154.745655, "o", "    tokenizeText(text).map(_.value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.7457, "o", "\u001b[?2004h> "]
[154.745794, "o", "  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.745837, "o", "> "]
[154.745904, "o", "    val result = mutable.ListBuffer[(String, Int, Int)]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.745952, "o", "    var currentPos = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746001, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.746051, "o", "    for (word <- text.split(\"\\\\s+\")) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746105, "o", "> "]
[154.746142, "o", "      val start = text.indexOf(word, currentPos)\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746197, "o", "> "]
[154.746233, "o", "      val end = start + word.length\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746283, "o", "> "]
[154.746319, "o", "      processToken(word).foreach { processed =>\r\n\u001b[?2004l\r"]
[154.746368, "o", "\u001b[?2004h> "]
[154.746403, "o", "        result += ((processed, start, end))\r\n\u001b[?2004l\r"]
[154.746446, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.746488, "o", "      currentPos = end\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746511, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746564, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.746615, "o", "    result.toList\r\n\u001b[?2004l\r\u001b[?2004h>   }"]
[154.746651, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.746698, "o", "  def countTokens(text: String): Int =\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746742, "o", "> "]
[154.746792, "o", "    tokenizeText(text).length\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.746831, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746874, "o", "> "]
[154.746943, "o", " * Universal tokenizer that tries multiple tokenizers in sequence\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.746985, "o", ">  */\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.747012, "o", "> "]
[154.747054, "o", "class UniversalTokenizer(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.74716, "o", "  tokenizers: List[BaseTokenizer[String]] = UniversalTokenizer.defaultTokenizers\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.747203, "o", "> "]
[154.747253, "o", ") extends BaseTokenizer[String] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.747291, "o", "> "]
[154.747329, "o", "  override def tokenize(value: String): Option[Token] = {\r\n\u001b[?2004l\r"]
[154.747375, "o", "\u001b[?2004h> "]
[154.747427, "o", "    tokenizers\r\n\u001b[?2004l\r\u001b[?2004h>       .view\r\n\u001b[?2004l\r"]
[154.747453, "o", "\u001b[?2004h> "]
[154.747506, "o", "      .flatMap(_.tokenize(value))\r\n\u001b[?2004l\r\u001b[?2004h>       .headOption\r\n\u001b[?2004l\r"]
[154.747558, "o", "\u001b[?2004h> "]
[154.747615, "o", "      .orElse(Some(Token(value, TokenType.Null)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.747666, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[154.747702, "o", "\u001b[?2004l\r\u001b[?2004h>   def tokenizeWith(\r\n\u001b[?2004l\r"]
[154.747753, "o", "\u001b[?2004h> "]
[154.7478, "o", "    customTokenizers: List[BaseTokenizer[String]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.747849, "o", "> "]
[154.747887, "o", "  )(value: String): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.747926, "o", "    customTokenizers\r\n\u001b[?2004l\r"]
[154.74795, "o", "\u001b[?2004h>       .view\r\n\u001b[?2004l\r"]
[154.748009, "o", "\u001b[?2004h> "]
[154.748049, "o", "      .flatMap(_.tokenize(value))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.74809, "o", "      .headOption\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.74816, "o", "      .orElse(Some(Token(value, TokenType.Null)))\r\n\u001b[?2004l\r"]
[154.748224, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[154.748269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.748324, "o", "object UniversalTokenizer {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.748361, "o", "> "]
[154.748402, "o", "  val defaultTokenizers: List[BaseTokenizer[String]] = List(\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.748452, "o", "> "]
[154.748498, "o", "    new NumericTokenizer,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.748544, "o", "    new TemporalTokenizer(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.748583, "o", "    new WhitespaceTokenizer(),\r\n\u001b[?2004l\r"]
[154.748635, "o", "\u001b[?2004h> "]
[154.748673, "o", "    new StringTokenizer\r\n\u001b[?2004l\r\u001b[?2004h>   )\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[154.748708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.748751, "o", "\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.748843, "o", " * Fluent builder for creating configured tokenizers\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.748897, "o", ">  */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.748937, "o", "class TokenizerBuilder {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.74908, "o", "  private val normalizers: mutable.ListBuffer[String => String] = mutable.ListBuffer.empty\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.749127, "o", "> "]
[154.749225, "o", "  private val validators: mutable.ListBuffer[String => Boolean] = mutable.ListBuffer.empty\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.749268, "o", "> "]
[154.74935, "o", "  private val metadata: mutable.Map[String, Any] = mutable.Map.empty\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[154.749393, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[154.74951, "o", "  def withNormalizer(normalizer: String => String): TokenizerBuilder = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.749583, "o", "    normalizers += normalizer\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.749635, "o", ">     this\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[154.749673, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.749762, "o", "  def withValidator(validator: String => Boolean): TokenizerBuilder = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.749814, "o", "> "]
[154.749862, "o", "    validators += validator\r\n\u001b[?2004l\r\u001b[?2004h>     this\r\n\u001b[?2004l\r"]
[154.749909, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.749956, "o", "\u001b[?2004h> "]
[154.750034, "o", "  def withMetadata(key: String, value: Any): TokenizerBuilder = {\r\n\u001b[?2004l\r"]
[154.750075, "o", "\u001b[?2004h> "]
[154.750114, "o", "    metadata(key) = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.750156, "o", "    this\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[154.750208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.7503, "o", "  def withMetadata(entries: Map[String, Any]): TokenizerBuilder = {\r\n\u001b[?2004l\r"]
[154.750344, "o", "\u001b[?2004h> "]
[154.750394, "o", "    metadata ++= entries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.750431, "o", "    this\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[154.75048, "o", "> "]
[154.750516, "o", "  def build(): String => Token = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.750585, "o", "    val normalizersList = normalizers.toList\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.750627, "o", "> "]
[154.750663, "o", "    val validatorsList = validators.toList\r\n\u001b[?2004l\r"]
[154.75072, "o", "\u001b[?2004h> "]
[154.75076, "o", "    val metadataMap = metadata.toMap\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.750804, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.75085, "o", "    (value: String) => {\r\n\u001b[?2004l\r"]
[154.750897, "o", "\u001b[?2004h> "]
[154.750947, "o", "      validatorsList.foreach { validator =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.750993, "o", "        if (!validator(value)) {\r\n\u001b[?2004l\r"]
[154.751036, "o", "\u001b[?2004h> "]
[154.751133, "o", "          throw new IllegalArgumentException(s\"Validation failed for $value\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.751181, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751216, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751338, "o", "      val normalized = normalizersList.foldLeft(value) { (acc, norm) =>\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.751384, "o", "> "]
[154.75143, "o", "        norm(acc)\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.751474, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751531, "o", "      Token(normalized, TokenType.String, metadataMap)\r\n\u001b[?2004l\r"]
[154.751555, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751611, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[154.751661, "o", "\u001b[?2004l\r\u001b[?2004h> /**\r\n\u001b[?2004l\r"]
[154.751698, "o", "\u001b[?2004h> "]
[154.75175, "o", " * Companion object with utility functions for tokenization\r\n\u001b[?2004l\r"]
[154.75179, "o", "\u001b[?2004h>  */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751827, "o", "object Tokenizer {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.751876, "o", ">   /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.751953, "o", "   * Tokenize a single value using the universal tokenizer\r\n\u001b[?2004l\r"]
[154.751997, "o", "\u001b[?2004h>    */\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.752041, "o", "> "]
[154.752094, "o", "  def tokenize(value: String): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.752151, "o", "    val tokenizer = new UniversalTokenizer()\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.752222, "o", "> "]
[154.752267, "o", "    tokenizer.tokenize(value)\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.752319, "o", "  /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.752396, "o", "   * Convert a string value to a token with position information\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.752441, "o", "   */\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.752492, "o", "> "]
[154.752534, "o", "  def toToken(value: String, position: Int): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.752583, "o", "> "]
[154.75264, "o", "    tokenize(value).map(_.withMetadata(\"position\", position))\r\n\u001b[?2004l\r"]
[154.752686, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.75274, "o", "\u001b[?2004h>   /**\r\n\u001b[?2004l\r"]
[154.752805, "o", "\u001b[?2004h> "]
[154.752841, "o", "   * Tokenize multiple values and return list of tokens\r\n\u001b[?2004l\r\u001b[?2004h>    */\r\n\u001b[?2004l\r"]
[154.752884, "o", "\u001b[?2004h> "]
[154.752953, "o", "  def tokenizeBatch(values: Seq[String]): List[Token] = {\r\n\u001b[?2004l\r"]
[154.752997, "o", "\u001b[?2004h> "]
[154.753055, "o", "    values.zipWithIndex.flatMap { case (value, index) =>\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.753109, "o", "> "]
[154.753146, "o", "      toToken(value, index)\r\n\u001b[?2004l\r\u001b[?2004h>     }.toList\r\n\u001b[?2004l\r"]
[154.753196, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.753233, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>   /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.753329, "o", "   * Tokenize a value and add metadata to the resulting token\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.753378, "o", ">    */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.753506, "o", "  def tokenizeWithMetadata(value: String, metadata: Map[String, Any]): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.753558, "o", "> "]
[154.753599, "o", "    tokenize(value).map(_.withMetadata(metadata))\r\n\u001b[?2004l\r"]
[154.753634, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[154.753685, "o", "\u001b[?2004h>   /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.753742, "o", "   * Create a new TokenizerBuilder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.753794, "o", "   */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.753872, "o", "  def builder(): TokenizerBuilder = new TokenizerBuilder()\r\n\u001b[?2004l\r"]
[154.753921, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.753961, "o", "> SCALA_EOF\r\n\u001b[?2004l\r"]
