[46.986214, "o", ">  */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.986273, "o", "class WhitespaceTokenizer(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.986319, "o", "  lowercase: Boolean = false,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.986376, "o", "  minLength: Int = 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
