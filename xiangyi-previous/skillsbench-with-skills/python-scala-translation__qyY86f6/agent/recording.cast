[154.730041, "i", "cat > /root/Tokenizer.scala << 'SCALA_EOF'\nimport scala.util.{Try, Success, Failure}\nimport scala.collection.mutable\nimport scala.math.BigDecimal\nimport java.time.LocalDateTime\nimport java.time.format.DateTimeFormatter\n\n/**\n * Sealed trait representing different token types\n */\nsealed trait TokenType {\n  def name: String\n}\n\nobject TokenType {\n  case object String extends TokenType {\n    override def name: String = \"string\"\n  }\n  case object Numeric extends TokenType {\n    override def name: String = \"numeric\"\n  }\n  case object Temporal extends TokenType {\n    override def name: String = \"temporal\"\n  }\n  case object Structured extends TokenType {\n    override def name: String = \"structured\"\n  }\n  case object Binary extends TokenType {\n    override def name: String = \"binary\"\n  }\n  case object Null extends TokenType {\n    override def name: String = \"null\"\n  }\n}\n\n/**\n * Immutable token representation with metadata support\n */\ncase class Token(\n  value: String,\n  tokenType: TokenType,\n  metadata: Map[String, Any] = Map.empty\n) {\n  /**\n   * Return new token with additional metadata\n   */\n  def withMetadata(key: String, value: Any): Token =\n    this.copy(metadata = metadata + (key -> value))\n\n  /**\n   * Return new token with multiple metadata entries\n   */\n  def withMetadata(newMetadata: Map[String, Any]): Token =\n    this.copy(metadata = metadata ++ newMetadata)\n}\n\n/**\n * Mutable batch of tokens - contrast with immutable Token\n */\nclass MutableTokenBatch {\n  private val tokens: mutable.ListBuffer[Token] = mutable.ListBuffer.empty\n  private var processed: Boolean = false\n\n  def add(token: Token): Unit = {\n    if (processed) {\n      throw new RuntimeException(\"Batch already processed\")\n    }\n    tokens += token\n  }\n\n  def getAll: List[Token] = tokens.toList\n\n  def markProcessed(): Unit = {\n    processed = true\n  }\n}\n\n/**\n * Base trait for all tokenizers\n */\nsealed trait BaseTokenizer[T] {\n  /**\n   * Convert value to token\n   */\n  def tokenize(value: T): Option[Token]\n\n  /**\n   * Tokenize multiple values\n   */\n  def tokenizeBatch(values: Iterable[T]): List[Token] =\n    values.flatMap(tokenize).toList\n}\n\n/**\n * String tokenizer implementation\n */\nclass StringTokenizer extends BaseTokenizer[String] {\n  override def tokenize(value: String): Option[Token] = {\n    if (value.nonEmpty) {\n      Some(Token(value, TokenType.String))\n    } else {\n      None\n    }\n  }\n}\n\n/**\n * Numeric tokenizer implementation\n */\nclass NumericTokenizer extends BaseTokenizer[String] {\n  override def tokenize(value: String): Option[Token] = {\n    Try(BigDecimal(value)).toOption.map(_ =>\n      Token(value, TokenType.Numeric)\n    )\n  }\n}\n\n/**\n * Temporal tokenizer for date/time values\n */\nclass TemporalTokenizer(\n  dateFormats: List[DateTimeFormatter] = TemporalTokenizer.defaultFormats\n) extends BaseTokenizer[String] {\n  override def tokenize(value: String): Option[Token] = {\n    dateFormats\n      .view\n      .flatMap { formatter =>\n        Try(LocalDateTime.parse(value, formatter)).toOption\n      }\n      .headOption\n      .map(_ => Token(value, TokenType.Temporal))\n  }\n}\n\nobject TemporalTokenizer {\n  val defaultFormats: List[DateTimeFormatter] = List(\n    DateTimeFormatter.ISO_DATE_TIME,\n    DateTimeFormatter.ISO_DATE,\n    DateTimeFormatter.ISO_TIME\n  )\n}\n\n/**\n * Whitespace tokenizer for text processing\n */\nclass WhitespaceTokenizer(\n  lowercase: Boolean = false,\n  minLength: Int = 0,\n  maxLength: Option[Int] = None,\n  stripPunctuation: Boolean = false\n) extends BaseTokenizer[String] {\n  private val punctuationChars: String = \".,!?;:'\\\"()[]{}\"\n\n  private def processToken(word: String): Option[String] = {\n    var processed = word\n\n    if (stripPunctuation) {\n      processed = processed.dropWhile(c => punctuationChars.contains(c))\n        .reverse.dropWhile(c => punctuationChars.contains(c)).reverse\n    }\n\n    if (lowercase) {\n      processed = processed.toLowerCase\n    }\n\n    if (processed.length < minLength) {\n      None\n    } else if (maxLength.exists(processed.length > _)) {\n      Some(processed.take(maxLength.get))\n    } else {\n      Some(processed)\n    "]
[154.73021, "i", "}\n  }\n\n  override def tokenize(value: String): Option[Token] = {\n    processToken(value).map(Token(_, TokenType.String))\n  }\n\n  def tokenizeText(text: String): List[Token] = {\n    text.split(\"\\\\s+\")\n      .zipWithIndex\n      .flatMap { case (word, index) =>\n        processToken(word).map { processed =>\n          Token(\n            processed,\n            TokenType.String,\n            Map(\"position\" -> index, \"original\" -> word)\n          )\n        }\n      }\n      .toList\n  }\n\n  def tokenizeToStrings(text: String): List[String] =\n    tokenizeText(text).map(_.value)\n\n  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\n    val result = mutable.ListBuffer[(String, Int, Int)]()\n    var currentPos = 0\n\n    for (word <- text.split(\"\\\\s+\")) {\n      val start = text.indexOf(word, currentPos)\n      val end = start + word.length\n\n      processToken(word).foreach { processed =>\n        result += ((processed, start, end))\n      }\n      currentPos = end\n    }\n\n    result.toList\n  }\n\n  def countTokens(text: String): Int =\n    tokenizeText(text).length\n}\n\n/**\n * Universal tokenizer that tries multiple tokenizers in sequence\n */\nclass UniversalTokenizer(\n  tokenizers: List[BaseTokenizer[String]] = UniversalTokenizer.defaultTokenizers\n) extends BaseTokenizer[String] {\n  override def tokenize(value: String): Option[Token] = {\n    tokenizers\n      .view\n      .flatMap(_.tokenize(value))\n      .headOption\n      .orElse(Some(Token(value, TokenType.Null)))\n  }\n\n  def tokenizeWith(\n    customTokenizers: List[BaseTokenizer[String]]\n  )(value: String): Option[Token] = {\n    customTokenizers\n      .view\n      .flatMap(_.tokenize(value))\n      .headOption\n      .orElse(Some(Token(value, TokenType.Null)))\n  }\n}\n\nobject UniversalTokenizer {\n  val defaultTokenizers: List[BaseTokenizer[String]] = List(\n    new NumericTokenizer,\n    new TemporalTokenizer(),\n    new WhitespaceTokenizer(),\n    new StringTokenizer\n  )\n}\n\n/**\n * Fluent builder for creating configured tokenizers\n */\nclass TokenizerBuilder {\n  private val normalizers: mutable.ListBuffer[String => String] = mutable.ListBuffer.empty\n  private val validators: mutable.ListBuffer[String => Boolean] = mutable.ListBuffer.empty\n  private val metadata: mutable.Map[String, Any] = mutable.Map.empty\n\n  def withNormalizer(normalizer: String => String): TokenizerBuilder = {\n    normalizers += normalizer\n    this\n  }\n\n  def withValidator(validator: String => Boolean): TokenizerBuilder = {\n    validators += validator\n    this\n  }\n\n  def withMetadata(key: String, value: Any): TokenizerBuilder = {\n    metadata(key) = value\n    this\n  }\n\n  def withMetadata(entries: Map[String, Any]): TokenizerBuilder = {\n    metadata ++= entries\n    this\n  }\n\n  def build(): String => Token = {\n    val normalizersList = normalizers.toList\n    val validatorsList = validators.toList\n    val metadataMap = metadata.toMap\n\n    (value: String) => {\n      validatorsList.foreach { validator =>\n        if (!validator(value)) {\n          throw new IllegalArgumentException(s\"Validation failed for $value\")\n        }\n      }\n\n      val normalized = normalizersList.foldLeft(value) { (acc, norm) =>\n        norm(acc)\n      }\n\n      Token(normalized, TokenType.String, metadataMap)\n    }\n  }\n}\n\n/**\n * Companion object with utility functions for tokenization\n */\nobject Tokenizer {\n  /**\n   * Tokenize a single value using the universal tokenizer\n   */\n  def tokenize(value: String): Option[Token] = {\n    val tokenizer = new UniversalTokenizer()\n    tokenizer.tokenize(value)\n  }\n\n  /**\n   * Convert a string value to a token with position information\n   */\n  def toToken(value: String, position: Int): Option[Token] = {\n    tokenize(value).map(_.withMetadata(\"position\", position))\n  }\n\n  /**\n   * Tokenize multiple values and return list of tokens\n   */\n  def tokenizeBatch(values: Seq[String]): List[Token] = {\n    values.zipWithIndex.flatMap { case (value, index) =>\n      toToken(value, index)\n    }.toList\n  }\n\n  /**\n   * Tokenize a value and add metadata to the resulting token\n   */\n  def tokenizeWithMetadata(value: String, metadata:"]
