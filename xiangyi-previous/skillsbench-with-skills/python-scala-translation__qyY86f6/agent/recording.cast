[46.990969, "o", "> "]
[46.991024, "o", "    for (word <- text.split(\"\\\\s+\")) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.991103, "o", "      val start = text.indexOf(word, currentPos)\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.991131, "o", "> "]
