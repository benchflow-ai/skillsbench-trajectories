[46.986565, "o", ") extends BaseTokenizer[String] {\r\n\u001b[?2004l\r"]
[46.986615, "o", "\u001b[?2004h> "]
[46.986807, "o", "  private val punctuation = Set(\".,!?;:'\\\"()[]{}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.986876, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>   private def processToken(word: String): Option[String] = {\r\n\u001b[?2004l\r"]
[46.987009, "o", "\u001b[?2004h> "]
[46.987089, "o", "    var processed = word\r\n\u001b[?2004l\r"]
[46.987273, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.98739, "o", "    if (stripPunctuation) {\r\n\u001b[?2004l\r"]
