[46.987716, "o", "      processed = processed.dropWhile(punctuation.contains(_))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.987841, "o", "        .reverse.dropWhile(punctuation.contains(_)).reverse\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
