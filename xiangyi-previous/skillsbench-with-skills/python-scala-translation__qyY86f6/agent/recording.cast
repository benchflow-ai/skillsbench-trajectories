[180.067219, "i", "cat > /tmp/TokenizerTest.scala << 'TEST_EOF'\nobject TokenizerTest {\n  def main(args: Array[String]): Unit = {\n    // Test basic tokenization\n    val token1 = Tokenizer.tokenize(\"123.45\")\n    println(s\"Numeric token: $token1\")\n    \n    val token2 = Tokenizer.tokenize(\"hello world\")\n    println(s\"String token: $token2\")\n    \n    // Test batch tokenization\n    val batch = Tokenizer.tokenizeBatch(Seq(\"100\", \"200\", \"300\"))\n    println(s\"Batch tokens: $batch\")\n    \n    // Test builder\n    val builder = Tokenizer.builder()\n      .withNormalizer(_.trim)\n      .withNormalizer(_.toLowerCase)\n      .withMetadata(\"source\", \"test\")\n    val tokenizer = builder.build()\n    val customToken = tokenizer(\"  HELLO  \")\n    println(s\"Custom token: $customToken\")\n  }\n}\nTEST_EOF\n"]
