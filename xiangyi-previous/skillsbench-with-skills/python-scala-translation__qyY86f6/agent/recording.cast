[170.716441, "o", "---\r\n"]
[170.71725, "o", "   * Tokenize multiple values and return list of tokens\r\n   */\r\n  def tokenizeBatch(values: Seq[String]): List[Token] = {\r\n    values.zipWithIndex.flatMap { case (value, index) =>\r\n      toToken(value, index)\r\n    }.toList\r\n  }\r\n\r\n  /**\r\n   * Tokenize a value and add metadata to the resulting token\r\n   */\r\n  def tokenizeWithMetadata(value: String, metadata: Map[String, Any]): Option[Token] = {\r\n    tokenize(value).map(_.withMetadata(metadata))\r\n  }\r\n\r\n  /**\r\n   * Create a new TokenizerBuilder\r\n   */\r\n  def builder(): TokenizerBuilder = new TokenizerBuilder()\r\n}\r\n"]
