[46.991218, "o", "> "]
[46.991314, "o", "      processToken(word).foreach { processed =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.991357, "o", "        result += ((processed, start, end))\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.991381, "o", ">       }\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.991425, "o", "> "]
[46.991452, "o", "      currentPos = end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.991479, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.991534, "o", "> \r\n\u001b[?2004l\r"]
[46.991599, "o", "\u001b[?2004h> "]
[46.991629, "o", "    result.toList\r\n\u001b[?2004l\r"]
