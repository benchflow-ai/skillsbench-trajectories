[56.952288, "o", " * Companion object with utility functions for tokenization\r\n\u001b[?2004l\r\u001b[?2004h>  */\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.952318, "o", "> object Tokenizer {\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.952388, "o", ">   /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.952448, "o", "   * Tokenize a single value using the universal tokenizer\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.9525, "o", ">    */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.952559, "o", "  def tokenize(value: String): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.952605, "o", "> "]
[56.952654, "o", "    val tokenizer = new UniversalTokenizer()\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.952693, "o", ">     tokenizer.tokenize(value)\r\n\u001b[?2004l\r"]
[56.952744, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.952795, "o", "\u001b[?2004h>   /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.952885, "o", "   * Convert a string value to a token with position information\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.952929, "o", "   */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.953013, "o", "  def toToken(value: String, position: Int): Option[Token] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.953066, "o", "> "]
[56.953117, "o", "    tokenize(value).map(_.withMetadata(\"position\", position))\r\n\u001b[?2004l\r"]
[56.953141, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.953208, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.953259, "o", "  /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
