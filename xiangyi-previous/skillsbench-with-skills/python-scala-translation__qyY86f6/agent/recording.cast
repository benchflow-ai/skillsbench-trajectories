[56.953364, "o", "\u001b[?2004h> "]
[56.953406, "o", "  def tokenizeBatch(values: Seq[String]): List[Token] = {\r\n\u001b[?2004l\r"]
[56.953458, "o", "\u001b[?2004h> "]
[56.953507, "o", "    values.zipWithIndex.flatMap { case (value, index) =>\r\n\u001b[?2004l\r"]
[56.953558, "o", "\u001b[?2004h> "]
[56.953609, "o", "      toToken(value, index)\r\n\u001b[?2004l\r\u001b[?2004h>     }.toList\r\n\u001b[?2004l\r"]
[56.953649, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
