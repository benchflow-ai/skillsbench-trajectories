[46.988285, "o", "\u001b[?2004h> "]
[46.988436, "o", "    if (processed.length < minLength) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.988518, "o", "      None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.988651, "o", "    } else if (maxLength.exists(processed.length > _)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
