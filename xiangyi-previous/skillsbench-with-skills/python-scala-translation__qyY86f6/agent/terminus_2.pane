---
   * Tokenize multiple values and return list of tokens
   */
  def tokenizeBatch(values: Seq[String]): List[Token] = {
    values.zipWithIndex.flatMap { case (value, index) =>
      toToken(value, index)
    }.toList
  }

  /**
   * Tokenize a value and add metadata to the resulting token
   */
  def tokenizeWithMetadata(value: String, metadata: Map[String, Any]): Option[Token] = {
    tokenize(value).map(_.withMetadata(metadata))
  }

  /**
   * Create a new TokenizerBuilder
   */
  def builder(): TokenizerBuilder = new TokenizerBuilder()
}
