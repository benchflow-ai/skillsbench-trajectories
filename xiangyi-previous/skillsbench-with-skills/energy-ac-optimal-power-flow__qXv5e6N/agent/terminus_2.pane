7[0;40r8[1A[J[?2004hroot@83d6abcea2bf:~# cat << 'EOF' > solver.py
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004lL[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> 
[?2004l [?2004h> def solve_opf():
[?2004l[?2004h>     with open('network.json') as f:
[?2004l[?2004h>         data = json.load(f)
[?2004l [?2004h>     
[?2004l[?2004h>     baseMVA = data['baseMVA']
[?2004lh[?2004h>     buses = np.array(data['bus'])
[?2004l[?2004h>     gens = np.array(data['gen'])
[?2004l[?2004h>     branches = np.array(data['branch'])
[?2004l[?2004h>     gencosts = np.array(data['gencost'])
[?2004l[?2004h>     
[?2004l[?2004h>     num_buses = len(buses)
[?2004l[?2004h>     num_gens = len(gens)
[?2004l[?2004h>     num_branches = len(branches)
[?2004l[?2004h>     
[?2004l[?2004h>     # Bus indices
[?2004l[?2004h>     bus_ids = buses[:, 0].astype(int)
[?2004l[?2004h>     bus_idx = {id: i for i, id in enumerate(bus_ids)}
[?2004l[?2004h>     
[?2004l[?2004h>     # Slack bus
[?2004l[?2004h>     slack_bus_idx = np.where(buses[:, 1] == 3)[0][0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Y-bus construction
[?2004l[?2004h>     Y = np.zeros((num_buses, num_buses), dtype=complex)
[?2004l[?2004h>     for br in branches:
[?2004l[?2004h>         f = bus_idx[int(br[0])]
[?2004l[?2004h>         t = bus_idx[int(br[1])]
[?2004l[?2004h>         r = br[2]
[?2004l[?2004h>         x = br[3]
[?2004l[?2004h>         b = br[4]
[?2004l[?2004h>         tau = br[8] if br[8] != 0 else 1.0
[?2004l[?2004h>         shift = np.radians(br[9])
[?2004l[?2004h>         
[?2004l[?2004h>         y = 1.0 / (r + 1j * x)
[?2004l[?2004h>         T = tau * np.exp(1j * shift)
[?2004l[?2004h>         
[?2004l[?2004h>         Y[f, f] += (y + 1j * b / 2) / (abs(T)**2)
[?2004l[?2004h>         Y[t, t] += y + 1j * b / 2
[?2004l[?2004h>         Y[f, t] -= y / np.conj(T)
[?2004l[?2004h>         Y[t, f] -= y / T
[?2004l[?2004h> 
[?2004l[?2004h>     # Shunts
[?2004l[?2004h>     for i in range(num_buses):
[?2004l[?2004h>         gs = buses[i, 4] / baseMVA
[?2004l[?2004h>         bs = buses[i, 5] / baseMVA
[?2004l[?2004h>         Y[i, i] += gs + 1j * bs
[?2004l[?2004h> 
[?2004l[?2004h>     # Variables: [Va (except slack), Vm, Pg, Qg]
[?2004l[?2004h>     # Va: num_buses
[?2004l[?2004h>     # Vm: num_buses
[?2004l[?2004h>     # Pg: num_gens
[?2004l[?2004h>     # Qg: num_gens
[?2004l[?2004h>     
[?2004l[?2004h>     x0 = np.concatenate([
[?2004l[?2004h>         np.zeros(num_buses), # Va
[?2004l[?2004h>         np.ones(num_buses),  # Vm
[?2004l[?2004h>         gens[:, 1] / baseMVA, # Pg
[?2004l[?2004h>         gens[:, 2] / baseMVA  # Qg
[?2004l[?2004h>     ])
[?2004l[?2004h>     
[?2004l[?2004h>     bounds = []
[?2004l[?2004h>     # Va
[?2004l[?2004h>     for i in range(num_buses):
[?2004l[?2004h>         if i == slack_bus_idx:
[?2004l[?2004h>             bounds.append((0, 0))
[?2004l[?2004h>         else:
[?2004l[?2004h>             bounds.append((-np.pi, np.pi))
[?2004l[?2004h>     # Vm
[?2004l[?2004h>     for i in range(num_buses):
[?2004l[?2004h>         bounds.append((buses[i, 12], buses[i, 11]))
[?2004l[?2004h>     # Pg
[?2004l[?2004h>     for i in range(num_gens):
[?2004l[?2004h>         bounds.append((gens[i, 9] / baseMVA, gens[i, 8] / baseMVA))
[?2004l[?2004h>     # Qg
[?2004l[?2004h>     for i in range(num_gens):
[?2004l[?2004h>         bounds.append((gens[i, 4] / baseMVA, gens[i, 3] / baseMVA))
[?2004l[?2004h> 
[?2004l[?2004h>     def objective(x):
[?2004l[?2004h>         Pg = x[2*num_buses : 2*num_buses + num_gens] * baseMVA
[?2004l[?2004h>         cost = 0
[?2004l[?2004h>         for i in range(num_gens):
[?2004l[?2004h>             c2, c1, c0 = gencosts[i, 4], gencosts[i, 5], gencosts[i, 6]
[?2004l[?2004h>             cost += c2 * Pg[i]**2 + c1 * Pg[i] + c0
[?2004l[?2004h>         return cost
[?2004l[?2004h> 
[?2004l[?2004h>     def constraints(x):
[?2004l[?2004h>         Va = x[0:num_buses]
[?2004l[?2004h>         Vm = x[num_buses:2*num_buses]
[?2004l[?2004h>         Pg = x[2*num_buses:2*num_buses+num_gens]
[?2004l[?2004h>         Qg = x[2*num_buses+num_gens:]
[?2004l[?2004h>         
[?2004l[?2004h>         V = Vm * np.exp(1j * Va)
