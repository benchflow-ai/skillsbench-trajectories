[65.249979, "o", "\u001b7\u001b[40;0f\u001b[42m\u001b[30mProgress: [ 99%]\u001b[49m\u001b[39m [########################################################################################################################################..] \u001b8"]
[65.341923, "o", "Processing triggers for libc-bin (2.39-0ubuntu8.6) ...\r\n"]
[65.956475, "o", "\r\n\u001b7\u001b[0;40r\u001b8\u001b[1A\u001b[J"]
[65.971611, "o", "\u001b[?2004hroot@83d6abcea2bf:~# "]
[81.680498, "i", "cat << 'EOF' > solver.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\n\ndef solve_opf():\n    with open('network.json') as f:\n        data = json.load(f)\n    \n    baseMVA = data['baseMVA']\n    buses = np.array(data['bus'])\n    gens = np.array(data['gen'])\n    branches = np.array(data['branch'])\n    gencosts = np.array(data['gencost'])\n    \n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n    \n    # Bus indices\n    bus_ids = buses[:, 0].astype(int)\n    bus_idx = {id: i for i, id in enumerate(bus_ids)}\n    \n    # Slack bus\n    slack_bus_idx = np.where(buses[:, 1] == 3)[0][0]\n    \n    # Y-bus construction\n    Y = np.zeros((num_buses, num_buses), dtype=complex)\n    for br in branches:\n        f = bus_idx[int(br[0])]\n        t = bus_idx[int(br[1])]\n        r = br[2]\n        x = br[3]\n        b = br[4]\n        tau = br[8] if br[8] != 0 else 1.0\n        shift = np.radians(br[9])\n        \n        y = 1.0 / (r + 1j * x)\n        T = tau * np.exp(1j * shift)\n        \n        Y[f, f] += (y + 1j * b / 2) / (abs(T)**2)\n        Y[t, t] += y + 1j * b / 2\n        Y[f, t] -= y / np.conj(T)\n        Y[t, f] -= y / T\n\n    # Shunts\n    for i in range(num_buses):\n        gs = buses[i, 4] / baseMVA\n        bs = buses[i, 5] / baseMVA\n        Y[i, i] += gs + 1j * bs\n\n    # Variables: [Va (except slack), Vm, Pg, Qg]\n    # Va: num_buses\n    # Vm: num_buses\n    # Pg: num_gens\n    # Qg: num_gens\n    \n    x0 = np.concatenate([\n        np.zeros(num_buses), # Va\n        np.ones(num_buses),  # Vm\n        gens[:, 1] / baseMVA, # Pg\n        gens[:, 2] / baseMVA  # Qg\n    ])\n    \n    bounds = []\n    # Va\n    for i in range(num_buses):\n        if i == slack_bus_idx:\n            bounds.append((0, 0))\n        else:\n            bounds.append((-np.pi, np.pi))\n    # Vm\n    for i in range(num_buses):\n        bounds.append((buses[i, 12], buses[i, 11]))\n    # Pg\n    for i in range(num_gens):\n        bounds.append((gens[i, 9] / baseMVA, gens[i, 8] / baseMVA))\n    # Qg\n    for i in range(num_gens):\n        bounds.append((gens[i, 4] / baseMVA, gens[i, 3] / baseMVA))\n\n    def objective(x):\n        Pg = x[2*num_buses : 2*num_buses + num_gens] * baseMVA\n        cost = 0\n        for i in range(num_gens):\n            c2, c1, c0 = gencosts[i, 4], gencosts[i, 5], gencosts[i, 6]\n            cost += c2 * Pg[i]**2 + c1 * Pg[i] + c0\n        return cost\n\n    def constraints(x):\n        Va = x[0:num_buses]\n        Vm = x[num_buses:2*num_buses]\n        Pg = x[2*num_buses:2*num_buses+num_gens]\n        Qg = x[2*num_buses+num_gens:]\n        \n        V = Vm * np.exp(1j * Va)\n        S_inj = V * np.conj(Y @ V)\n        \n        P_inj = S_inj.real\n        Q_inj = S_inj.imag\n        \n        P_gen = np.zeros(num_buses)\n        Q_gen = np.zeros(num_buses)\n        for i in range(num_gens):\n            idx = bus_idx[int(gens[i, 0])]\n            P_gen[idx] += Pg[i]\n            Q_gen[idx] += Qg[i]\n            \n        P_load = buses[:, 2] / baseMVA\n        Q_load = buses[:, 3] / baseMVA\n        \n        eq_p = P_gen - P_load - P_inj\n        eq_q = Q_gen - Q_load - Q_inj\n        \n        return np.concatenate([eq_p, eq_q])\n\n    # Line flow limits\n    def branch_flow_limit(x):\n        Va = x[0:num_buses]\n        Vm = x[num_buses:2*num_buses]\n        V = Vm * np.exp(1j * Va)\n        \n        limits = []\n        for br in branches:\n            f = bus_idx[int(br[0])]\n            t = bus_idx[int(br[1])]\n            r, x_br, b = br[2], br[3], br[4]\n            tau = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            T = tau * np.exp(1j * shift)\n            rateA = br[5] / baseMVA\n            \n            if rateA == 0: continue\n            \n            y = 1.0 / (r + 1j * x_br)\n            \n            # Flow from f to t\n            Sf = V[f] * np.conj((y + 1j*b/2)/abs(T)**2 * V[f] - y/np.conj(T) * V[t])\n            # Flow from t to f\n            St = V[t] * np.conj((y + 1j*b/2) * V[t] - y/T * V[f])\n            \n            limits.append(rateA - abs(Sf))\n            limits.append(rateA - abs(St))\n        return np.arr"]
[81.680552, "i", "ay(limits)\n\n    res = minimize(objective, x0, method='SLSQP', bounds=bounds, \n                   constraints=[{'type': 'eq', 'fun': constraints}, \n                                {'type': 'ineq', 'fun': branch_flow_limit}],\n                   options={'maxiter': 100, 'disp': True})\n    \n    return res, data, Y, bus_idx\n\nres, data, Y, bus_idx = solve_opf()\nprint(res.message)\n\n# Prepare report\n# ... (to be continued)\nEOF\n"]
