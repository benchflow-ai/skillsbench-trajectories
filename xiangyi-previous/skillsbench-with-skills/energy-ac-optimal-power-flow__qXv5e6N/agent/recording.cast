[101.740104, "o", "    def constraints(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740259, "o", "        Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740316, "o", "> "]
[101.74048, "o", "        Pg, Qg = x[2*num_buses:2*num_buses+num_gens], x[2*num_buses+num_gens:]\r\n\u001b[?2004l\r"]
[101.740505, "o", "\u001b[?2004h> "]
[101.740601, "o", "        V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740628, "o", "> "]
[101.740715, "o", "        S_inj = V * np.conj(Y @ V)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740744, "o", "> "]
[101.740903, "o", "        P_gen, Q_gen = np.zeros(num_buses), np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740989, "o", "        for i in range(num_gens):\r\n\u001b[?2004l\r"]
[101.741012, "o", "\u001b[?2004h> "]
[101.741127, "o", "            idx = bus_idx[int(gens[i, 0])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.741156, "o", "> "]
[101.741236, "o", "            P_gen[idx] += Pg[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.741264, "o", "> "]
[101.741329, "o", "            Q_gen[idx] += Qg[i]\r\n\u001b[?2004l\r f\u001b[?2004h> "]
[101.741619, "o", "        return np.concatenate([P_gen - buses[:, 2]/baseMVA - S_inj.real, Q_gen - buses[:, 3]/baseMVA - S_inj.imag])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[101.741647, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[101.741717, "o", "    def branch_flow_limit(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741811, "o", "        Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741871, "o", "        V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741934, "o", "        limits = []\r\n\u001b[?2004l\r"]
[101.741965, "o", "\u001b[?2004h> "]
[101.741994, "o", "        for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742045, "o", "            if br[5] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.742098, "o", "> "]
[101.742157, "o", "            f, t = bus_idx[int(br[0])], bus_idx[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742246, "o", "            r, x_br, b = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742368, "o", "            tau, shift = (br[8] if br[8] != 0 else 1.0), np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742477, "o", "            T, y = tau * np.exp(1j * shift), 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.742536, "o", "> "]
[101.742622, "o", "            Sf = V[f] * np.conj((y + 1j*b/2)/abs(T)**2 * V[f] - y/np.conj(T) * V[t])\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.742672, "o", "> "]
[101.742736, "o", "            St = V[t] * np.conj((y + 1j*b/2) * V[t] - y/T * V[f])\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.742761, "o", "> "]
[101.742888, "o", "            limits.extend([br[5]/baseMVA - abs(Sf), br[5]/baseMVA - abs(St)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742975, "o", "        return np.array(limits)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.743047, "o", "\u001b[?2004h> "]
[101.743118, "o", "    res = minimize(objective, x0, method='SLSQP', bounds=bounds, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743189, "o", "                   constraints=[{'type': 'eq', 'fun': constraints}, \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.74322, "o", "> "]
[101.74333, "o", "                                {'type': 'ineq', 'fun': branch_flow_limit}],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743423, "o", "                   options={'maxiter': 200, 'ftol': 1e-6})\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.743477, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.743509, "o", ">     x = res.x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743591, "o", "    Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.743622, "o", "> "]
[101.743718, "o", "    Pg, Qg = x[2*num_buses:2*num_buses+num_gens], x[2*num_buses+num_gens:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.743749, "o", "> "]
[101.743807, "o", "    V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.743838, "o", "> "]
[101.743868, "o", "    gen_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743925, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743989, "o", "        gen_list.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744046, "o", "            \"id\": i + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744099, "o", "            \"bus\": int(gens[i, 0]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744129, "o", "> "]
[101.744183, "o", "            \"pg_MW\": float(Pg[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744214, "o", "> "]
[101.744268, "o", "            \"qg_MVAr\": float(Qg[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744298, "o", "> "]
[101.744347, "o", "            \"pmin_MW\": float(gens[i, 9]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744378, "o", "> "]
[101.744436, "o", "            \"pmax_MW\": float(gens[i, 8]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744582, "o", "            \"qmin_MVAr\": float(gens[i, 4]),\r\n\u001b[?2004l\r\u001b[?2004h>             \"qmax_MVAr\": float(gens[i, 3])\r\n\u001b[?2004l\r"]
[101.744638, "o", "\u001b[?2004h> "]
[101.744669, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744853, "o", "    bus_list = []\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h>         bus_list.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744918, "o", "            \"id\": int(buses[i, 0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744993, "o", "            \"vm_pu\": float(Vm[i]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.745091, "o", "> "]
[101.745191, "o", "            \"va_deg\": float(np.degrees(Va[i])),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745245, "o", "            \"vmin_pu\": float(buses[i, 12]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745397, "o", "            \"vmax_pu\": float(buses[i, 11])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745434, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745506, "o", "    branch_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745579, "o", "    for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745747, "o", "        f_id, t_id = int(br[0]), int(br[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745813, "o", "        f, t = bus_idx[f_id], bus_idx[t_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.745875, "o", "> "]
[101.745926, "o", "        r, x_br, b = br[2], br[3], br[4]\r\n\u001b[?2004l\r"]
[101.745963, "o", "\u001b[?2004h> "]
[101.746126, "o", "        tau, shift = (br[8] if br[8] != 0 else 1.0), np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746269, "o", "        T, y = tau * np.exp(1j * shift), 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.746302, "o", "> "]
[101.746505, "o", "        Sf = V[f] * np.conj((y + 1j*b/2)/abs(T)**2 * V[f] - y/np.conj(T) * V[t]) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746698, "o", "        St = V[t] * np.conj((y + 1j*b/2) * V[t] - y/T * V[f]) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746753, "o", "        limit = br[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746926, "o", "        loading = max(abs(Sf), abs(St)) / limit * 100 if limit > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.746996, "o", "> "]
[101.747064, "o", "        branch_results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747149, "o", "            \"from_bus\": f_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74735, "o", "            \"to_bus\": t_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747423, "o", "            \"loading_pct\": float(loading),\r\n\u001b[?2004l\r\u001b[?2004h>             \"flow_from_MVA\": float(abs(Sf)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747454, "o", "            \"flow_to_MVA\": float(abs(St)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74756, "o", "            \"limit_MVA\": float(limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747587, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747727, "o", "    branch_results.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.74782, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747892, "o", "    S_inj = V * np.conj(Y @ V) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747938, "o", "    mismatch = constraints(x) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74799, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748031, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.748062, "o", "> "]
[101.748088, "o", "        \"summary\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748294, "o", "            \"total_cost_per_hour\": float(res.fun),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748374, "o", "            \"total_load_MW\": float(np.sum(buses[:, 2])),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748448, "o", "            \"total_load_MVAr\": float(np.sum(buses[:, 3])),\r\n\u001b[?2004l\r"]
[101.748508, "o", "\u001b[?2004h> "]
[101.748637, "o", "            \"total_generation_MW\": float(np.sum(Pg) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748752, "o", "            \"total_generation_MVAr\": float(np.sum(Qg) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748936, "o", "            \"total_losses_MW\": float(np.sum(Pg) * baseMVA - np.sum(buses[:, 2])),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.749122, "o", "            \"solver_status\": \"optimal\" if res.success else \"suboptimal\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.749172, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.749283, "o", "        \"generators\": gen_list,\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.749347, "o", ">         \"buses\": bus_list,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.749416, "o", "        \"most_loaded_branches\": branch_results[:10],\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.749449, "o", ">         \"feasibility_check\": {\r\n\u001b[?2004l\r"]
[101.749544, "o", "\u001b[?2004h> "]
[101.749638, "o", "            \"max_p_mismatch_MW\": float(np.max(np.abs(mismatch[:num_buses]))),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.749801, "o", "            \"max_q_mismatch_MVAr\": float(np.max(np.abs(mismatch[num_buses:]))),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.750028, "o", "            \"max_voltage_violation_pu\": float(max(0, np.max(Vm - buses[:, 11]), np.max(buses[:, 12] - Vm))),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.750067, "o", "> "]
[101.750352, "o", "            \"max_branch_overload_MVA\": float(max(0, max(br['flow_from_MVA'] - br['limit_MVA'] for br in branch_results if br['limit_MVA'] > 0)))\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n"]
[101.750381, "o", "\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[101.750449, "o", "\u001b[?2004h> "]
[101.750503, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.750545, "o", "> "]
[101.750627, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.750678, "o", "solve_opf()\r\n\u001b[?2004l\r\u001b[?2004h"]
