[?2004l[?2004h> x_range = 6.0
[?2004l[?2004h> p_range = 6.0
[?2004l[?2004h> 
[?2004l[?2004h> print("Initializing Dicke model simulation...")
[?2004l[?2004h> print(f"Parameters: N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}, kappa={kappa}, n_max={n_max}")
[?2004l[?2004h> 
[?2004l[?2004h> # Create operators
[?2004l[?2004h> a = destroy(n_max)  # Cavity annihilation operator
[?2004l[?2004h> N_cav = num(n_max)  # Cavity number operator
[?2004l[?2004h> I_cav = qeye(n_max)  # Cavity identity
[?2004l[?2004h> I_spin = qeye(2)  # Single spin identity
[?2004l[?2004h> 
[?2004l[?2004h> # Single spin operators
[?2004l[?2004h> jz = 0.5 * sigmaz()
[?2004l[?2004h> jp = (sigmax() + 1j*sigmay()) / 2.0  # J+ = (sigma_x + i*sigma_y)/2
[?2004l[?2004h> jm = (sigmax() - 1j*sigmay()) / 2.0  # J- = (sigma_x - i*sigma_y)/2
[?2004l[?2004h> 
[?2004l[?2004h> print("Building collective spin operators...")
[?2004l[?2004h> 
[?2004l[?2004h> # Build collective operators by summing over all spins
[?2004l[?2004h> # Start with first spin and add others
[?2004l[?2004h> ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h> ops_list[0] = jz
[?2004l[?2004h> Jz = tensor(I_cav, tensor(ops_list))
[?2004l[?2004h> 
[?2004l[?2004h> ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h> ops_list[0] = jp
[?2004l[?2004h> Jp = tensor(I_cav, tensor(ops_list))
[?2004l[?2004h> 
[?2004l[?2004h> ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h> ops_list[0] = jm
[?2004l[?2004h> Jm = tensor(I_cav, tensor(ops_list))
[?2004l[?2004h> 
[?2004l[?2004h> # Add remaining spins
[?2004l[?2004h> for i in range(1, N):
[?2004l[?2004h>     ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h>     ops_list[i] = jz
[?2004l[?2004h>     Jz = Jz + tensor(I_cav, tensor(ops_list))
[?2004l[?2004h>     
[?2004l[?2004h>     ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h>     ops_list[i] = jp
[?2004l[?2004h>     Jp = Jp + tensor(I_cav, tensor(ops_list))
[?2004l[?2004h>     
[?2004l[?2004h>     ops_list = [I_spin for _ in range(N)]
[?2004l[?2004h>     ops_list[i] = jm
[?2004l[?2004h>     Jm = Jm + tensor(I_cav, tensor(ops_list))
[?2004l[?2004h> 
[?2004l[?2004h> print("Collective operators built.")
[?2004l[?2004h> 
[?2004l[?2004h> # Cavity operators in full Hilbert space
[?2004l[?2004h> a_full = tensor(a, qeye(2**N))
[?2004l[?2004h> a_dag = a_full.dag()
[?2004l[?2004h> 
[?2004li[?2004h> print("Hamiltonian construction...")
[?2004l[?2004h> 
[?2004l[?2004h> # Hamiltonian: H = omega_0 * Jz + omega_c * a^dag*a + g*(a^dag + a)*(J+ + J-)
[?2004l[?2004h> H = omega_0 * Jz + omega_c * tensor(N_cav, qeye(2**N)) + g * (a_full + a_dag) * (Jp + Jm)
[?2004l[?2004h> 
[?2004l[?2004h> print("Hamiltonian constructed.")
[?2004l[?2004h> print(f"Hilbert space dimension: {H.dims}")
