[24.545381, "o", "> "]
[24.545438, "o", "    c_ops_3.append(c_emit)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.545506, "o", "# Collective pumping: J_+ (raises all spins)\r\n\u001b[?2004l\r"]
[24.545554, "o", "\u001b[?2004h> "]
[24.545621, "o", "Jp_coll = tensor(qeye(n_max), 0*qeye(2**N))\r\n\u001b[?2004l\r"]
[24.545685, "o", "\u001b[?2004h> "]
[24.545737, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.545796, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.545867, "o", "> "]
[24.545919, "o", "    ops[i] = jp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.545979, "o", "    Jp_i = tensor(qeye(n_max), tensor(ops))\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.546046, "o", "> "]
[24.5461, "o", "    Jp_coll = Jp_coll + Jp_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.546196, "o", "c_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp_coll)\r\n\u001b[?2004l\r"]
[24.546249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.546361, "o", "print(f\"Number of collapse operators: {len(c_ops_3)}\")\r\n\u001b[?2004l\r"]
[24.546411, "o", "\u001b[?2004h> "]
[24.546496, "o", "rho_ss_3 = steadystate(H, c_ops_3, method='direct')\r\n\u001b[?2004l\r"]
[24.546545, "o", "\u001b[?2004h> "]
[24.546609, "o", "print(\"Steady state found for Case 3.\")\r\n\u001b[?2004l\r"]
[24.546669, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.546801, "o", "# Case 4: Local dephasing & local emission & collective emission\r\n\u001b[?2004l\r"]
[24.546855, "o", "\u001b[?2004h> "]
[24.547045, "o", "print(\"\\nCase 4: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective emission (γ_Σ↓=0.1)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.547119, "o", "> "]
[24.547181, "o", "gamma_phi_4 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.547266, "o", "gamma_coll_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.547317, "o", "\u001b[?2004h> "]
[24.547426, "o", "c_ops_4 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\r\n\u001b[?2004l\r"]
[24.547504, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.547558, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.547621, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.547688, "o", "    ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.547848, "o", "    c_dephase = np.sqrt(gamma_phi_4) * tensor(qeye(n_max), tensor(ops))\r\n\u001b[?2004l\r"]
[24.547911, "o", "\u001b[?2004h> "]
[24.547971, "o", "    c_ops_4.append(c_dephase)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548042, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548109, "o", "    ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548196, "o", "    c_emit = np.sqrt(gamma_down_4) * tensor(qeye(n_max), tensor(ops))\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.548269, "o", "> "]
[24.54832, "o", "    c_ops_4.append(c_emit)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548383, "o", "# Collective emission: J_- (lowers all spins)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548459, "o", "Jm_coll = tensor(qeye(n_max), 0*qeye(2**N))\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.548535, "o", "> "]
[24.548593, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548669, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.548744, "o", ">     ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.548812, "o", "    Jm_i = tensor(qeye(n_max), tensor(ops))\r\n\u001b[?2004l\r"]
[24.548873, "o", "\u001b[?2004h> "]
[24.548934, "o", "    Jm_coll = Jm_coll + Jm_i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.549032, "o", "c_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm_coll)\r\n\u001b[?2004l\r"]
