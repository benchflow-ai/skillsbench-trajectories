[203.186102, "o", "gamma_down_2 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.186131, "o", "c_ops_2 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r"]
[203.186162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[203.186197, "o", "\u001b[?2004h> "]
[203.186559, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Dephasing: sigma_z\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r"]
[203.186596, "o", "\u001b[?2004h> "]
