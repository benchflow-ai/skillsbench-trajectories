[24.545084, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r"]
[24.545159, "o", "\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r"]
[24.545212, "o", "\u001b[?2004h> "]
