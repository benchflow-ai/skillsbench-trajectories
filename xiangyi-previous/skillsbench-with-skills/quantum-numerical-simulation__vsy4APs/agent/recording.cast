[24.544444, "o", "c_ops_3 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\r\n\u001b[?2004l\r"]
[24.544524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544576, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544635, "o", "    ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544703, "o", "    ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544858, "o", "    c_dephase = np.sqrt(gamma_phi_3) * tensor(qeye(n_max), tensor(ops))\r\n\u001b[?2004l\r"]
[24.544929, "o", "\u001b[?2004h> "]
