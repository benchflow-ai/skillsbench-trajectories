[24.549228, "o", "\u001b[?2004h> "]
[24.549362, "o", "rho_ss_4 = steadystate(H, c_ops_4, method='direct')\r\n\u001b[?2004l\r"]
[24.549423, "o", "\u001b[?2004h> "]
[24.549498, "o", "print(\"Steady state found for Case 4.\")\r\n\u001b[?2004l\r"]
[24.549558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.549655, "o", "print(\"\\nTracing out spin degrees of freedom...\")\r\n\u001b[?2004l\r"]
[24.549715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.549802, "o", "# Trace out spins to get cavity density matrices\r\n\u001b[?2004l\r"]
[24.549852, "o", "\u001b[?2004h> "]
[24.54996, "o", "# The full state is in Hilbert space of cavity (n_max) × spins (2^N)\r\n\u001b[?2004l\r"]
[24.550022, "o", "\u001b[?2004h> "]
[24.550101, "o", "# We need to trace out the spin part\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.55015, "o", "\u001b[?2004h> "]
[24.55021, "o", "def get_cavity_state(rho_full, n_max, N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.550263, "o", "> "]
[24.550336, "o", "    \"\"\"Trace out spins to get cavity density matrix\"\"\"\r\n\u001b[?2004l\r"]
[24.550386, "o", "\u001b[?2004h> "]
[24.550491, "o", "    # rho_full is in the tensor product space: cavity × spins\r\n\u001b[?2004l\r"]
[24.550538, "o", "\u001b[?2004h> "]
[24.550601, "o", "    # We want to trace out the spin part\r\n\u001b[?2004l\r"]
[24.550649, "o", "\u001b[?2004h> "]
[24.550788, "o", "    rho_cavity = ptrace(rho_full, 0)  # Keep only cavity mode (index 0)\r\n\u001b[?2004l\r"]
[24.550859, "o", "\u001b[?2004h> "]
[24.550929, "o", "    return rho_cavity\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.551089, "o", "rho_cav_1 = get_cavity_state(rho_ss_1, n_max, N)\r\n\u001b[?2004l\r"]
[24.551279, "o", "\u001b[?2004h> rho_cav_2 = get_cavity_state(rho_ss_2, n_max, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.551349, "o", "rho_cav_3 = get_cavity_state(rho_ss_3, n_max, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.551505, "o", "rho_cav_4 = get_cavity_state(rho_ss_4, n_max, N)\r\n\u001b[?2004l\r"]
[24.551578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.551605, "o", "\u001b[?2004h> "]
[24.551698, "o", "print(\"Cavity states extracted.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.551791, "o", "print(\"\\nCalculating Wigner functions...\")\r\n\u001b[?2004l\r"]
[24.551827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.551851, "o", "\u001b[?2004h> "]
[24.551939, "o", "# Create grid for Wigner function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.55205, "o", "xvec = np.linspace(-x_range, x_range, grid_points)\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.552076, "o", "> "]
[24.552155, "o", "pvec = np.linspace(-p_range, p_range, grid_points)\r\n\u001b[?2004l\r"]
[24.55219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.552273, "o", "# Calculate Wigner functions\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.552375, "o", "> W1 = wigner(rho_cav_1, xvec, pvec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.552455, "o", "W2 = wigner(rho_cav_2, xvec, pvec)\r\n\u001b[?2004l\r"]
[24.552512, "o", "\u001b[?2004h> "]
[24.552569, "o", "W3 = wigner(rho_cav_3, xvec, pvec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.552645, "o", "W4 = wigner(rho_cav_4, xvec, pvec)\r\n\u001b[?2004l\r"]
[24.552697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.552834, "o", "print(f\"Wigner functions calculated on {grid_points}x{grid_points} grid.\")\r\n\u001b[?2004l\r"]
[24.552892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.552966, "o", "print(\"\\nSaving results to CSV files...\")\r\n\u001b[?2004l\r"]
[24.553023, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.553082, "o", "# Save Wigner functions as CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.553172, "o", "np.savetxt('1.csv', W1, delimiter=',')\r\n\u001b[?2004l\r"]
[24.553226, "o", "\u001b[?2004h> "]
[24.553288, "o", "np.savetxt('2.csv', W2, delimiter=',')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.553375, "o", "np.savetxt('3.csv', W3, delimiter=',')\r\n\u001b[?2004l\r"]
[24.553424, "o", "\u001b[?2004h> "]
[24.553497, "o", "np.savetxt('4.csv', W4, delimiter=',')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.553558, "o", "\u001b[?2004h> "]
[24.553618, "o", "print(\"Results saved:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.553718, "o", "print(\"  1.csv - Case 1: Local dephasing & local pumping\")\r\n\u001b[?2004l\r"]
[24.55377, "o", "\u001b[?2004h> "]
[24.553864, "o", "print(\"  2.csv - Case 2: Local dephasing & local emission\")\r\n\u001b[?2004l\r"]
[24.553924, "o", "\u001b[?2004h> "]
[24.554043, "o", "print(\"  3.csv - Case 3: Local dephasing & local emission & collective pumping\")\r\n\u001b[?2004l\r"]
[24.554099, "o", "\u001b[?2004h> "]
[24.554215, "o", "print(\"  4.csv - Case 4: Local dephasing & local emission & collective emission\")\r\n\u001b[?2004l\r"]
[24.554293, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.554347, "o", "print(\"\\nSimulation complete!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[24.559473, "o", "\u001b[?2004hroot@627802df49db:~# "]
[30.849697, "i", "ls -lh dicke_model.py\n"]
[30.850014, "o", "ls -lh dicke_model.py\r\n\u001b[?2004l\r"]
[30.851531, "o", "-rw-r--r-- 1 root root 7.1K Jan 26 12:11 dicke_model.py\r\n"]
[30.851761, "o", "\u001b[?2004hroot@627802df49db:~# "]
[31.262424, "i", "head -20 dicke_model.py\n"]
[31.262958, "o", "head -20 dicke_model.py\r\n\u001b[?2004l\r"]
[31.263938, "o", "import numpy as np\r\nfrom qutip import *\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\n# System parameters\r\nN = 4  # Number of two-level systems\r\nomega_0 = 1.0  # Transition frequency\r\nomega_c = 1.0  # Cavity frequency\r\ng = 2.0 / np.sqrt(N)  # Coupling strength\r\nkappa = 1.0  # Cavity loss rate\r\n"]
[31.264275, "o", "n_max = 16  # Photon number cutoff\r\n\r\n# Wigner function grid parameters\r\ngrid_points = 1000\r\nx_range = 6.0\r\np_range = 6.0\r\n\r\nprint(\"Initializing Dicke model simulation...\")\r\nprint(f\"Parameters: N={N}, ω₀={omega_0}, ω_c={omega_c}, g={g:.4f}, κ={kappa}, n_max={n_max}\")\r\n"]
[31.264382, "o", "\u001b[?2004hroot@627802df49db:~# "]
[31.564747, "i", "python3 dicke_model.py\n"]
[31.565434, "o", "python3 dicke_model.py\r\n\u001b[?2004l\r"]
