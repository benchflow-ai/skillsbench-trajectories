[24.543834, "o", "\u001b[?2004h> "]
[24.543894, "o", "# Case 3: Local dephasing & local emission & collective pumping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544087, "o", "print(\"\\nCase 3: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective pumping (γ_Σ↑=0.1)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.544162, "o", "> gamma_phi_3 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.544227, "o", "gamma_down_3 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
