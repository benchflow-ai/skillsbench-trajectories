[203.186955, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.187059, "o", "    # Emission: sigma_minus = J_minus\r\n\u001b[?2004l\r"]
[203.187147, "o", "\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.187242, "o", "> "]
