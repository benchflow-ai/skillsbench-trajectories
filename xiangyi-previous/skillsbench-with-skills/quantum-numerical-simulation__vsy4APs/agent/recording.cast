[24.542052, "o", "\u001b[?2004h> gamma_down_2 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r,\u001b[?2004h> "]
[24.542406, "o", "c_ops_2 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rL\u001b[?2004h> "]
[24.542528, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
