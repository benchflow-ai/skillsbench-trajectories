[282.492561, "o", "Initializing Dicke model simulation...\r\nParameters: N=4, omega_0=1.0, omega_c=1.0, g=1.0000, kappa=1.0, n_max=16\r\n"]
[282.497726, "o", "Building Hamiltonian operators...\r\n"]
[282.501975, "o", "Jz dims: [[16, 2, 2, 2, 2], [16, 2, 2, 2, 2]]\r\nJp dims: [[16, 2, 2, 2, 2], [16, 2, 2, 2, 2]]\r\nJm dims: [[16, 2, 2, 2, 2], [16, 2, 2, 2, 2]]\r\n"]
[282.502371, "o", "a_full dims: [[16, 16], [16, 16]]\r\nN_cav_full dims: [[16, 16], [16, 16]]\r\n"]
