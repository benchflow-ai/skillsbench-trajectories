[112.67614, "o", "> "]
[112.676235, "o", "gamma_up_1 = 0.1"]
[112.676305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.676336, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[112.676396, "o", "> "]
[112.676585, "o", "c_ops_1 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r"]
[112.67661, "o", "\u001b[?2004h> "]
[112.676634, "o", "\r\n\u001b[?2004l\r"]
[112.676657, "o", "\u001b[?2004h"]
[112.676682, "o", "> "]
[112.676885, "o", "# Local dephasing and pumping for each spin\r\n\u001b[?2004l\r"]
[112.676922, "o", "\u001b[?2004h> "]
[112.677014, "o", "for i in range(N):\r\n\u001b[?2004l\r"]
[112.677049, "o", "\u001b[?2004h> "]
[112.677217, "o", "    ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r"]
[112.677241, "o", "\u001b[?2004h"]
[112.677308, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[112.677347, "o", "> "]
[112.677439, "o", "    # Dephasing: σz\r\n\u001b[?2004l\r"]
[112.677461, "o", "\u001b[?2004h> "]
[112.677578, "o", "    ops[i] = sigmaz()\r\n\u001b[?2004l\r"]
[112.677607, "o", "\u001b[?2004h> "]
[112.677889, "o", "    c_dephase = np.sqrt(gamma_phi_1) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.677911, "o", "\u001b[?2004h> "]
[112.678067, "o", "    c_ops_1.append(c_dephase)\r\n\u001b[?2004l\r"]
[112.678093, "o", "\u001b[?2004h"]
[112.678154, "o", "> "]
[112.678177, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.678373, "o", "    # Pumping: |↓⟩⟨↓| = (I - σz)/2\r\n\u001b[?2004l\r"]
[112.678408, "o", "\u001b[?2004h> "]
[112.678587, "o", "    ops[i] = (I_spin - sigmaz()) / 2.0\r\n\u001b[?2004l\r"]
[112.67861, "o", "\u001b[?2004h> "]
[112.678922, "o", "    c_pump = np.sqrt(gamma_up_1) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.678956, "o", "\u001b[?2004h> "]
[112.679099, "o", "    c_ops_1.append(c_pump)\r\n\u001b[?2004l\r"]
[112.679133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.679195, "o", "\u001b[?2004h> "]
[112.679433, "o", "print(f\"Number of collapse operators: {len(c_ops_1)}\")\r\n\u001b[?2004l\r"]
[112.679526, "o", "\u001b[?2004h> "]
[112.679696, "o", "rho_ss_1 = steadystate(H, c_ops_1, method='direct')\r\n\u001b[?2004l\r"]
[112.679768, "o", "\u001b[?2004h> "]
[112.679899, "o", "print(\"Steady state found for Case 1.\")\r\n\u001b[?2004l\r"]
[112.679927, "o", "\u001b[?2004h> \r\n"]
[112.679957, "o", "\u001b[?2004l\r\u001b[?2004h"]
[112.680071, "o", "> "]
[112.680315, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[112.680342, "o", "\u001b[?2004h"]
[112.680368, "o", "> "]
[112.680565, "o", "# Case 2: Local dephasing & local emission\r\n\u001b[?2004l\r"]
[112.680588, "o", "\u001b[?2004h> "]
[112.68094, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[112.680975, "o", "\u001b[?2004h> "]
[112.6813, "o", "print(\"\\nCase 2: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1)\")\r\n\u001b[?2004l\r"]
[112.681332, "o", "\u001b[?2004h> "]
[112.681404, "o", "gamma_phi_2 = 0.01\r\n\u001b[?2004l\r"]
[112.681431, "o", "\u001b[?2004h> "]
[112.6815, "o", "gamma_down_2 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.681524, "o", "\u001b[?2004h> "]
[112.681642, "o", "c_ops_2 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r"]
[112.681676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.681699, "o", "\u001b[?2004h"]
[112.681722, "o", "> "]
[112.681812, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.681888, "o", "    ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r"]
[112.681916, "o", "\u001b[?2004h> "]
[112.681939, "o", "    \r\n\u001b[?2004l\r"]
[112.682011, "o", "\u001b[?2004h>     # Dephasing: σz\r\n"]
[112.682037, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.682104, "o", "    ops[i] = sigmaz()\r\n\u001b[?2004l\r"]
[112.682133, "o", "\u001b[?2004h> "]
[112.682286, "o", "    c_dephase = np.sqrt(gamma_phi_2) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.682312, "o", "\u001b[?2004h> "]
[112.682393, "o", "    c_ops_2.append(c_dephase)\r\n\u001b[?2004l\r"]
[112.682433, "o", "\u001b[?2004h>     \r\n"]
[112.682462, "o", "\u001b[?2004l\r\u001b[?2004h"]
[112.68249, "o", "> "]
[112.682592, "o", "    # Emission: σ- = J-\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.682621, "o", "    ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.682648, "o", "> "]
[112.6828, "o", "    c_emit = np.sqrt(gamma_down_2) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.682834, "o", "\u001b[?2004h> "]
[112.683009, "o", "    c_ops_2.append(c_emit)\r\n\u001b[?2004l\r"]
[112.683339, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of collapse operators: {len(c_ops_2)}\")\r\n\u001b[?2004l\r\u001b[?2004h> rho_ss_2 = steadystate(H, c_ops_2, method='direct')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683575, "o", "print(\"Steady state found for Case 2.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683709, "o", "# Case 3: Local dephasing & local emission & collective pumping\r\n\u001b[?2004l\r"]
[112.683746, "o", "\u001b[?2004h> "]
[112.683902, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[112.68397, "o", "\u001b[?2004h> "]
[112.684161, "o", "print(\"\\nCase 3: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective pumping (γ_Σ↑=0.1)\")\r\n\u001b[?2004l\r"]
[112.684229, "o", "\u001b[?2004h> "]
[112.684289, "o", "gamma_phi_3 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684347, "o", "gamma_down_3 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684408, "o", "gamma_coll_up_3 = 0.1\r\n\u001b[?2004l\r"]
[112.684473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684575, "o", "c_ops_3 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r"]
[112.68464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684701, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.684761, "o", "> "]
[112.684817, "o", "    ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684881, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.68494, "o", "    # Dephasing: σz\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.684997, "o", "> "]
[112.685056, "o", "    ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685186, "o", "    c_dephase = np.sqrt(gamma_phi_3) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.685251, "o", "\u001b[?2004h> "]
[112.68531, "o", "    c_ops_3.append(c_dephase)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.685375, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685434, "o", "    # Emission: σ-\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.685494, "o", ">     ops[i] = jm\r\n\u001b[?2004l\r"]
[112.685553, "o", "\u001b[?2004h> "]
[112.685666, "o", "    c_emit = np.sqrt(gamma_down_3) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r"]
[112.68573, "o", "\u001b[?2004h> "]
[112.685825, "o", "    c_ops_3.append(c_emit)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.68589, "o", "# Collective pumping: J_+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.686003, "o", "c_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp)\r\n\u001b[?2004l\r"]
[112.686068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.686185, "o", "print(f\"Number of collapse operators: {len(c_ops_3)}\")\r\n\u001b[?2004l\r"]
[112.686248, "o", "\u001b[?2004h> "]
[112.68633, "o", "rho_ss_3 = steadystate(H, c_ops_3, method='direct')\r\n\u001b[?2004l\r"]
[112.686394, "o", "\u001b[?2004h> "]
[112.686461, "o", "print(\"Steady state found for Case 3.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.686528, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.686658, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[112.686732, "o", "\u001b[?2004h> "]
[112.686836, "o", "# Case 4: Local dephasing & local emission & collective emission\r\n\u001b[?2004l\r"]
[112.686902, "o", "\u001b[?2004h> "]
[112.686996, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[112.687056, "o", "\u001b[?2004h> "]
[112.690878, "o", "print(\"\\nCase 4: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective emission (γ_Σ↓=0.1)\")\r\n\u001b[?2004l\r\u001b[?2004h> gamma_phi_4 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> gamma_coll_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> c_ops_4 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Dephasing: σz\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h>     c_dephase = np.sqrt(gamma_phi_4) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_4.append(c_dephase)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Emission: σ-\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h>     c_emit = np.sqrt(gamma_down_4) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_4.append(c_emit)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Collective emission: J_-\r\n\u001b[?2004l\r\u001b[?2004h> c_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of collapse operators: {len(c_ops_4)}\")\r\n\u001b[?2004l\r\u001b[?2004h> rho_ss_4 = steadystate(H, c_ops_4, method='direct')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Steady state found for Case 4.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nTracing out spin degrees of freedom...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Trace out spins to get cavity density matrices\r\n\u001b[?2004l\r\u001b[?2004h> rho_cav_1 = ptrace(rho_ss_1, 0)  # Keep only cavity mode (index 0)\r\n\u001b[?2004l\r\u001b[?2004h> rho_cav_2 = ptrace(rho_ss_2, 0)\r\n\u001b[?2004l\r\u001b[?2004h> rho_cav_3 = ptrace(rho_ss_3, 0)\r\n\u001b[?2004l\r\u001b[?2004h> rho_cav_4 = ptrace(rho_ss_4, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Cavity states extracted.\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Cavity state dimensions: {rho_cav_1.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nCalculating Wigner functions...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create grid for Wigner function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691021, "o", "xvec = np.linspace(-x_range, x_range, grid_points)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691121, "o", "pvec = np.linspace(-p_range, p_range, grid_points)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691297, "o", "print(f\"Grid: {grid_points} x {grid_points} points from -{x_range} to {x_range}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.691356, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691408, "o", "# Calculate Wigner functions\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.691463, "o", "> "]
[112.69152, "o", "print(\"Calculating W1...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691582, "o", "W1 = wigner(rho_cav_1, xvec, pvec)\r\n\u001b[?2004l\r"]
[112.691634, "o", "\u001b[?2004h> "]
[112.691693, "o", "print(\"Calculating W2...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691769, "o", "W2 = wigner(rho_cav_2, xvec, pvec)\r\n\u001b[?2004l\r"]
[112.69182, "o", "\u001b[?2004h> "]
[112.691873, "o", "print(\"Calculating W3...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.691937, "o", "W3 = wigner(rho_cav_3, xvec, pvec)\r\n\u001b[?2004l\r"]
[112.691996, "o", "\u001b[?2004h> "]
[112.692052, "o", "print(\"Calculating W4...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.692106, "o", "W4 = wigner(rho_cav_4, xvec, pvec)\r\n\u001b[?2004l\r"]
[112.692177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.692259, "o", "print(f\"Wigner functions calculated.\")\r\n\u001b[?2004l\r"]
[112.692313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.69238, "o", "print(\"\\nSaving results to CSV files...\")\r\n\u001b[?2004l\r"]
[112.692449, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.692507, "o", "# Save Wigner functions as CSV\r\n\u001b[?2004l\r"]
[112.692559, "o", "\u001b[?2004h> "]
[112.692612, "o", "np.savetxt('1.csv', W1, delimiter=',')\r\n\u001b[?2004l\r"]
[112.692669, "o", "\u001b[?2004h> "]
[112.692723, "o", "np.savetxt('2.csv', W2, delimiter=',')\r\n\u001b[?2004l\r"]
[112.692776, "o", "\u001b[?2004h> "]
[112.692827, "o", "np.savetxt('3.csv', W3, delimiter=',')\r\n\u001b[?2004l\r"]
[112.692879, "o", "\u001b[?2004h> "]
[112.69293, "o", "np.savetxt('4.csv', W4, delimiter=',')\r\n\u001b[?2004l\r"]
