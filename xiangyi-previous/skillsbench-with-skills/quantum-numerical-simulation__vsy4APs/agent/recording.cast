[280.806242, "i", "cat > dicke_model.py << 'EOF'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# System parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Wigner function grid parameters\ngrid_points = 1000\nx_range = 6.0\np_range = 6.0\n\nprint(\"Initializing Dicke model simulation...\")\nprint(f\"Parameters: N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}, kappa={kappa}, n_max={n_max}\")\n\n# Create basic operators\na = destroy(n_max)\nI_cav = qeye(n_max)\nI_spin = qeye(2)\n\n# Single spin operators\njz = 0.5 * sigmaz()\njp = (sigmax() + 1j*sigmay()) / 2.0\njm = (sigmax() - 1j*sigmay()) / 2.0\n\nprint(\"Building Hamiltonian operators...\")\n\n# Build Jz by explicit summation\nJz_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jz\n    Jz_terms.append(tensor(I_cav, tensor(ops)))\nJz = sum(Jz_terms)\n\n# Build Jp by explicit summation\nJp_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jp\n    Jp_terms.append(tensor(I_cav, tensor(ops)))\nJp = sum(Jp_terms)\n\n# Build Jm by explicit summation\nJm_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jm\n    Jm_terms.append(tensor(I_cav, tensor(ops)))\nJm = sum(Jm_terms)\n\nprint(f\"Jz dims: {Jz.dims}\")\nprint(f\"Jp dims: {Jp.dims}\")\nprint(f\"Jm dims: {Jm.dims}\")\n\n# Cavity operators\na_full = tensor(a, qeye(2**N))\na_dag = a_full.dag()\nN_cav_full = tensor(num(n_max), qeye(2**N))\n\nprint(f\"a_full dims: {a_full.dims}\")\nprint(f\"N_cav_full dims: {N_cav_full.dims}\")\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * N_cav_full + g * (a_full + a_dag) * (Jp + Jm)\n\nprint(\"Hamiltonian constructed.\")\nprint(f\"Hilbert space dimension: {H.dims}\")\nprint(\"\\nSolving for steady states...\")\n\n# ============================================================================\n# Case 1: Local dephasing & local pumping\n# ============================================================================\nprint(\"\\nCase 1: Local dephasing & local pumping\")\ngamma_phi_1 = 0.01\ngamma_up_1 = 0.1\n\nc_ops_1 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_1.append(np.sqrt(gamma_phi_1) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = (I_spin - sigmaz()) / 2.0\n    c_ops_1.append(np.sqrt(gamma_up_1) * tensor(I_cav, tensor(ops)))\n\nprint(f\"Collapse operators: {len(c_ops_1)}\")\nrho_ss_1 = steadystate(H, c_ops_1, method='direct')\nprint(\"Steady state found.\")\n\n# ============================================================================\n# Case 2: Local dephasing & local emission\n# ============================================================================\nprint(\"\\nCase 2: Local dephasing & local emission\")\ngamma_phi_2 = 0.01\ngamma_down_2 = 0.1\n\nc_ops_2 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_2.append(np.sqrt(gamma_phi_2) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_2.append(np.sqrt(gamma_down_2) * tensor(I_cav, tensor(ops)))\n\nprint(f\"Collapse operators: {len(c_ops_2)}\")\nrho_ss_2 = steadystate(H, c_ops_2, method='direct')\nprint(\"Steady state found.\")\n\n# ============================================================================\n# Case 3: Local dephasing & local emission & collective pumping\n# ============================================================================\nprint(\"\\nCase 3: Local dephasing & local emission & collective pumping\")\ngamma_phi_3 = 0.01\ngamma_down_3 = 0.1\ngamma_coll_up_3 = 0.1\n\nc_ops_3 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_3.append(np.sqrt(gamma_phi_3) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_3.append(np.sqrt(gamma_down_3) * tensor(I_cav, tensor(ops)))\n\nc_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp)\n\nprint(f\"Collapse operators: {len(c_ops_3)}\")\nrho_ss_3 = steadystate(H, c_ops_3, method='direct')\nprint(\"Steady state found.\")\n\n# ============================================================================\n# Case 4:"]
[280.806314, "i", " Local dephasing & local emission & collective emission\n# ============================================================================\nprint(\"\\nCase 4: Local dephasing & local emission & collective emission\")\ngamma_phi_4 = 0.01\ngamma_down_4 = 0.1\ngamma_coll_down_4 = 0.1\n\nc_ops_4 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_4.append(np.sqrt(gamma_phi_4) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_4.append(np.sqrt(gamma_down_4) * tensor(I_cav, tensor(ops)))\n\nc_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm)\n\nprint(f\"Collapse operators: {len(c_ops_4)}\")\nrho_ss_4 = steadystate(H, c_ops_4, method='direct')\nprint(\"Steady state found.\")\n\nprint(\"\\nTracing out spins...\")\nrho_cav_1 = ptrace(rho_ss_1, 0)\nrho_cav_2 = ptrace(rho_ss_2, 0)\nrho_cav_3 = ptrace(rho_ss_3, 0)\nrho_cav_4 = ptrace(rho_ss_4, 0)\nprint(\"Done.\")\n\nprint(\"\\nCalculating Wigner functions...\")\nxvec = np.linspace(-x_range, x_range, grid_points)\npvec = np.linspace(-p_range, p_range, grid_points)\n\nprint(\"W1...\")\nW1 = wigner(rho_cav_1, xvec, pvec)\nprint(\"W2...\")\nW2 = wigner(rho_cav_2, xvec, pvec)\nprint(\"W3...\")\nW3 = wigner(rho_cav_3, xvec, pvec)\nprint(\"W4...\")\nW4 = wigner(rho_cav_4, xvec, pvec)\n\nprint(\"\\nSaving to CSV...\")\nnp.savetxt('1.csv', W1, delimiter=',')\nnp.savetxt('2.csv', W2, delimiter=',')\nnp.savetxt('3.csv', W3, delimiter=',')\nnp.savetxt('4.csv', W4, delimiter=',')\n\nprint(\"\\nComplete!\")\nEOF\n"]
[280.807422, "o", "cat > dicke_model.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from qutip import *\r\n\u001b[?2004l\r\u001b[?2004h> import warnings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.807627, "o", "warnings.filterwarnings('ignore')"]
[280.807753, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.807968, "o", "> # System parameters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.808297, "o", "N = 4  # Number of two-level systems\r\n\u001b[?2004l\r\u001b[?2004h> omega_0 = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.808393, "o", "omega_c = 1.0"]
[280.808519, "o", "\r\n"]
[280.808594, "o", "\u001b[?2004l\r"]
[280.808677, "o", "\u001b[?2004h"]
[280.808773, "o", "> "]
[280.808948, "o", "g = 2.0 / np.sqrt(N)"]
[280.809016, "o", "\r\n"]
[280.809088, "o", "\u001b[?2004l\r"]
[280.809184, "o", "\u001b[?2004h"]
[280.809261, "o", "> "]
[280.809384, "o", "kappa = 1.0"]
[280.80945, "o", "\r\n"]
[280.809514, "o", "\u001b[?2004l\r"]
[280.810547, "o", "\u001b[?2004h"]
[280.810745, "o", "> "]
[280.813869, "o", "n_max = 16"]
[280.814042, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.814157, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.814448, "o", "> "]
[280.814659, "o", "# Wigner function grid parameters"]
[280.814765, "o", "\r\n"]
[280.814883, "o", "\u001b[?2004l\r\u001b[?2004h"]
[280.815088, "o", "> "]
[280.815227, "o", "grid_points = 1000"]
[280.81565, "o", "\r\n\u001b[?2004l\r"]
[280.815893, "o", "\u001b[?2004h> x_range = 6.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.816116, "o", "p_range = 6.0"]
[280.81625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.816393, "o", "> \r\n"]
[280.816549, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[280.816836, "o", "print(\"Initializing Dicke model simulation...\")"]
[280.816943, "o", "\r\n"]
[280.817053, "o", "\u001b[?2004l\r"]
[280.817193, "o", "\u001b[?2004h"]
[280.817354, "o", "> "]
[280.817957, "o", "print(f\"Parameters: N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}, kappa={kappa}, n_max={n_max}\")"]
[280.818036, "o", "\r\n"]
[280.818103, "o", "\u001b[?2004l\r"]
[280.818189, "o", "\u001b[?2004h"]
[280.818263, "o", "> "]
[280.818333, "o", "\r\n"]
[280.818396, "o", "\u001b[?2004l\r"]
[280.818516, "o", "\u001b[?2004h"]
[280.818595, "o", "> "]
[280.818807, "o", "# Create basic operators"]
[280.81888, "o", "\r\n"]
[280.81895, "o", "\u001b[?2004l\r"]
[280.819043, "o", "\u001b[?2004h"]
[280.819129, "o", "> "]
[280.819315, "o", "a = destroy(n_max)"]
[280.819382, "o", "\r\n"]
[280.819468, "o", "\u001b[?2004l\r"]
[280.819557, "o", "\u001b[?2004h"]
[280.819994, "o", "> "]
[280.820173, "o", "I_cav = qeye(n_max)"]
[280.820316, "o", "\r\n\u001b[?2004l\r"]
[280.820477, "o", "\u001b[?2004h> "]
[280.820647, "o", "I_spin = qeye(2)"]
[280.820781, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.820922, "o", "> \r\n"]
[280.821068, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[280.821258, "o", "# Single spin operators"]
[280.821397, "o", "\r\n"]
[280.821525, "o", "\u001b[?2004l\r\u001b[?2004h"]
[280.821645, "o", "> "]
[280.821772, "o", "jz = 0.5 * sigmaz()"]
[280.821908, "o", "\r\n"]
[280.822018, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[280.822366, "o", "jp = (sigmax() + 1j*sigmay()) / 2.0"]
[280.822478, "o", "\r\n"]
[280.834759, "o", "\u001b[?2004l\r"]
[280.835067, "o", "\u001b[?2004h> jm = (sigmax() - 1j*sigmay()) / 2.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Building Hamiltonian operators...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build Jz by explicit summation\r\n\u001b[?2004l\r\u001b[?2004h> Jz_terms = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jz\r\n\u001b[?2004l\r\u001b[?2004h>     Jz_terms.append(tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h> Jz = sum(Jz_terms)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build Jp by explicit summation\r\n\u001b[?2004l\r\u001b[?2004h> Jp_terms = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jp\r\n\u001b[?2004l\r\u001b[?2004h>     Jp_terms.append(tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h> Jp = sum(Jp_terms)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\"\u001b[?2004h> # Build Jm by explicit summation\r\n\u001b[?2004l\r\u001b[?2004h> Jm_terms = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h>     Jm_terms.append(tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h> Jm = sum(Jm_terms)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> print(f\"Jz dims: {Jz.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Jp dims: {Jp.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Jm dims: {Jm.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Cavity operators\r\n\u001b[?2004l\r\u001b[?2004h> a_full = tensor(a, qeye(2**N))\r\n\u001b[?2004l\r\u001b[?2004h> a_dag = a_full.dag()\r\n\u001b[?2004l\r\u001b[?2004h> N_cav_full = tensor(num(n_max), qeye(2**N))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"a_full dims: {a_full.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"N_cav_full dims: {N_cav_full.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hamiltonian\r\n\u001b[?2004l\r\u001b[?2004h> H = omega_0 * Jz + omega_c * N_cav_full + g * (a_full + a_dag) * (Jp + Jm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Hamiltonian constructed.\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Hilbert space dimension: {H.dims}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSolving for steady states...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Case 1: Local dephasing & local pumping\r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nCase 1: Local dephasing & local pumping\")\r\n\u001b[?2004l\r\u001b[?2004h> gamma_phi_1 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_up_1 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> c_ops_1 = [np.sqrt(kappa) * a_full]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_1.append(np.sqrt(gamma_phi_1) * tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = (I_spin - sigmaz()) / 2.0\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_1.append(np.sqrt(gamma_up_1) * tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Collapse operators: {len(c_ops_1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> rho_ss_1 = steadystate(H, c_ops_1, method='direct')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Steady state found.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Case 2: Local dephasing & local emission\r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nCase 2: Local dephasing & local emission\")\r\n\u001b[?2004l\r\u001b[?2004h> gamma_phi_2 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down_2 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> c_ops_2 = [np.sqrt(kappa) * a_full]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_2.append(np.sqrt(gamma_phi_2) * tensor(I_cav, tensor(ops)))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_2.append(np.sqrt(gamma_down_2) * tensor(I_cav, tensor(ops)))\r\n\u001b"]
[280.835158, "o", "[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Collapse operators: {len(c_ops_2)}\")\r\n\u001b[?2004l\r"]
