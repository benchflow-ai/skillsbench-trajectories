[32.546638, "o", "Initializing Dicke model simulation...\r\nParameters: N=4, ω₀=1.0, ω_c=1.0, g=1.0000, κ=1.0, n_max=16\r\n"]
[32.548178, "o", "Traceback (most recent call last):\r\n  File \"/root/dicke_model.py\", line 45, in <module>\r\n"]
[32.5483, "o", "    Jz = Jz + Jz_i\r\n  File \"/usr/local/lib/python3.10/site-packages/qutip/qobj.py\", line 435, in __add__\r\n"]
