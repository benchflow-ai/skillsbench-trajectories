[?2004h> # Collective pumping: J_plus\r\n\u001b[?2004l\r\u001b[?2004h> c_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of collapse operators: {len(c_ops_3)}\")\r\n\u001b[?2004l\r\u001b[?2004h> rho_ss_3 = steadystate(H, c_ops_3, method='direct')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Steady state found for Case 3.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Case 4: Local dephasing & local emission & collective emission\r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nCase 4: Local dephasing & local emission & collective emission\")\r\n\u001b[?2004l\r\u001b[?2004h> gamma_phi_4 = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> gamma_coll_down_4 = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> c_ops_4 = [np.sqrt(kappa) * a_full]  # Cavity loss\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [I_spin for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Dephasing: sigma_z\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h>     c_dephase = np.sqrt(gamma_phi_4) * tensor(I_cav, tensor(ops))\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_4.append(c_dephase)\r\n\u001b[?2004l\r\u001b[?2004h> "]
