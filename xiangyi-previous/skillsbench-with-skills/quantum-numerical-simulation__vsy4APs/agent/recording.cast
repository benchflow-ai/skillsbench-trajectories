[24.543217, "o", ">     ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = jm\r\n\u001b[?2004l\r"]
[24.543359, "o", "\u001b[?2004h> "]
