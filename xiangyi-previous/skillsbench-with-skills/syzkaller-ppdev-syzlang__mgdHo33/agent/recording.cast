[985.805461, "o", "_IOC_DIRSHIFT=_IOC_SIZESHIFT+_IOC_SIZEBITS\r\n\u001b[?2004l\r\u001b[?2004h> _IOC_NONE=0\r\n\u001b[?2004l\r\u001b[?2004h"]
[985.805538, "o", "> _IOC_WRITE=1\r\n\u001b[?2004l\r\u001b[?2004h> _IOC_READ=2\r\n\u001b[?2004l\r"]
