[985.810292, "o", "def calc(sizes):\r\n\u001b[?2004l\r\u001b[?2004h>     vals={}"]
[985.810366, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.810441, "o", "    for name, func, nr, typ in ioctls:\r\n\u001b[?2004l\r\u001b[?2004h"]
[985.810521, "o", ">         if func==_IO:\r\n\u001b[?2004l\r"]
[985.810598, "o", "\u001b[?2004h> "]
[985.810673, "o", "            vals[name]=func(pp, nr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.810741, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.810809, "o", "            vals[name]=func(pp, nr, sizes[typ])\r\n\u001b[?2004l\r"]
[985.810877, "o", "\u001b[?2004h>     return vals\r\n\u001b[?2004l\r"]
[985.810948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.811019, "o", "v64=calc(sizes64)\r\n\u001b[?2004l\r\u001b[?2004h> v32=calc(sizes32)"]
[985.811096, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.811168, "o", "print('diffs:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.811234, "o", "for name in v64:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[985.811299, "o", "    if v64[name]!=v32[name]:\r\n\u001b[?2004l\r"]
[985.811358, "o", "\u001b[?2004h> "]
[985.811417, "o", "        print(name, v64[name], v32[name])\r\n\u001b[?2004l\r"]
