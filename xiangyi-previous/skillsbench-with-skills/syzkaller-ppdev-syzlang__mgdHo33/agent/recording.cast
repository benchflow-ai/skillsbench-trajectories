[985.80457, "i", "python3 - <<'PY'\n_IOC_NRBITS=8\n_IOC_TYPEBITS=8\n_IOC_SIZEBITS=14\n_IOC_DIRBITS=2\n_IOC_NRSHIFT=0\n_IOC_TYPESHIFT=_IOC_NRSHIFT+_IOC_NRBITS\n_IOC_SIZESHIFT=_IOC_TYPESHIFT+_IOC_TYPEBITS\n_IOC_DIRSHIFT=_IOC_SIZESHIFT+_IOC_SIZEBITS\n_IOC_NONE=0\n_IOC_WRITE=1\n_IOC_READ=2\n\ndef _IOC(dir, type, nr, size):\n    return (dir << _IOC_DIRSHIFT) | (type << _IOC_TYPESHIFT) | (nr << _IOC_NRSHIFT) | (size << _IOC_SIZESHIFT)\n\ndef _IO(type, nr):\n    return _IOC(_IOC_NONE, type, nr, 0)\n\ndef _IOR(type, nr, size):\n    return _IOC(_IOC_READ, type, nr, size)\n\ndef _IOW(type, nr, size):\n    return _IOC(_IOC_WRITE, type, nr, size)\n\ndef _IOWR(type, nr, size):\n    return _IOC(_IOC_READ|_IOC_WRITE, type, nr, size)\n\npp=ord('p')\n# sizes for 64-bit\nsizes64 = {\n    'int':4,\n    'uchar':1,\n    'frob':2,\n    'uint':4,\n    'timeval':16,\n}\n# sizes for 32-bit\nsizes32 = {\n    'int':4,\n    'uchar':1,\n    'frob':2,\n    'uint':4,\n    'timeval':8,\n}\n\nioctls=[\n('PPSETMODE', _IOW, 0x80, 'int'),\n('PPRSTATUS', _IOR, 0x81, 'uchar'),\n('PPRCONTROL', _IOR, 0x83, 'uchar'),\n('PPWCONTROL', _IOW, 0x84, 'uchar'),\n('PPFCONTROL', _IOW, 0x8e, 'frob'),\n('PPRDATA', _IOR, 0x85, 'uchar'),\n('PPWDATA', _IOW, 0x86, 'uchar'),\n('PPCLAIM', _IO, 0x8b, None),\n('PPRELEASE', _IO, 0x8c, None),\n('PPYIELD', _IO, 0x8d, None),\n('PPEXCL', _IO, 0x8f, None),\n('PPDATADIR', _IOW, 0x90, 'int'),\n('PPNEGOT', _IOW, 0x91, 'int'),\n('PPWCTLONIRQ', _IOW, 0x92, 'uchar'),\n('PPCLRIRQ', _IOR, 0x93, 'int'),\n('PPSETPHASE', _IOW, 0x94, 'int'),\n('PPGETTIME', _IOR, 0x95, 'timeval'),\n('PPSETTIME', _IOW, 0x96, 'timeval'),\n('PPGETMODES', _IOR, 0x97, 'uint'),\n('PPGETMODE', _IOR, 0x98, 'int'),\n('PPGETPHASE', _IOR, 0x99, 'int'),\n('PPGETFLAGS', _IOR, 0x9a, 'int'),\n('PPSETFLAGS', _IOW, 0x9b, 'int'),\n]\n\ndef calc(sizes):\n    vals={}\n    for name, func, nr, typ in ioctls:\n        if func==_IO:\n            vals[name]=func(pp, nr)\n        else:\n            vals[name]=func(pp, nr, sizes[typ])\n    return vals\n\nv64=calc(sizes64)\nv32=calc(sizes32)\n\nprint('diffs:')\nfor name in v64:\n    if v64[name]!=v32[name]:\n        print(name, v64[name], v32[name])\nPY\n"]
[985.804938, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
