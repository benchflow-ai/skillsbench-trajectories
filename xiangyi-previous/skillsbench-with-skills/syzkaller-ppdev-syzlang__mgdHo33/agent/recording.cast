[985.805165, "o", "_IOC_SIZEBITS=14\r\n\u001b[?2004l\r\u001b[?2004h> _IOC_DIRBITS=2\r\n\u001b[?2004l\r\u001b[?2004h> _IOC_NRSHIFT=0\r\n\u001b[?2004l\r"]
