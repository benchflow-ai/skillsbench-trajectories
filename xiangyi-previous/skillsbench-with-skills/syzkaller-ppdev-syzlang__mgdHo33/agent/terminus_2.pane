[?2004l[?2004h> ('PPEXCL', _IO, 0x8f, None),
[?2004l[?2004h> ('PPDATADIR', _IOW, 0x90, 'int'),
[?2004l[?2004h> ('PPNEGOT', _IOW, 0x91, 'int'),
[?2004l[?2004h> ('PPWCTLONIRQ', _IOW, 0x92, 'uchar'),
[?2004l[?2004h> ('PPCLRIRQ', _IOR, 0x93, 'int'),
[?2004l[?2004h> ('PPSETPHASE', _IOW, 0x94, 'int'),
[?2004l[?2004h> ('PPGETTIME', _IOR, 0x95, 'timeval'),
[?2004l[?2004h> ('PPSETTIME', _IOW, 0x96, 'timeval'),
[?2004l[?2004h> ('PPGETMODES', _IOR, 0x97, 'uint'),
[?2004l[?2004h> ('PPGETMODE', _IOR, 0x98, 'int'),
[?2004l[?2004h> ('PPGETPHASE', _IOR, 0x99, 'int'),
[?2004l[?2004h> ('PPGETFLAGS', _IOR, 0x9a, 'int'),
[?2004l[?2004h> ('PPSETFLAGS', _IOW, 0x9b, 'int'),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def calc(sizes):
[?2004l[?2004h>     vals={}
[?2004l[?2004h>     for name, func, nr, typ in ioctls:
