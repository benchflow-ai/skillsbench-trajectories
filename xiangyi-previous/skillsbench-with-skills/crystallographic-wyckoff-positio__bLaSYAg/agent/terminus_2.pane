[?2004hroot@d9b96b15a19c:~# cat <<'PY' > /root/workspace/solution.py
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from typing import Any, Dict
[?2004l[?2004h> import re
[?2004l[?2004h> from fractions import Fraction
[?2004l[?2004h> 
[?2004l[?2004h> from pymatgen.core import Structure
[?2004l[?2004h> from pymatgen.symmetry.analyzer import SpacegroupAnalyzer
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _float_to_rational_str(x: float, max_den: int = 12) -> str:
[?2004l[?2004h>     """Convert float to rational string with denominator <= max_den."""
[?2004l[?2004h>     # wrap into [0,1)
[?2004l[?2004h>     x = x % 1.0
[?2004l[?2004h>     if abs(x) < 1e-8:
[?2004l[?2004h>         return "0"
[?2004l[?2004h>     frac = Fraction(x).limit_denominator(max_den)
[?2004l[?2004h>     # If frac is 1 (e.g., x very close to 1), represent as 0
[?2004l[?2004h>     if frac.numerator == frac.denominator:
[?2004l[?2004h>         return "0"
[?2004l[?2004h>     if frac.denominator == 1:
[?2004l[?2004h>         return str(frac.numerator)
[?2004l[?2004h>     return f"{frac.numerator}/{frac.denominator}"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_wyckoff_position_multiplicities_and_coordinates(
[?2004l[?2004h>     filepath: str,
[?2004l[?2004h> ) -> Dict[str, Dict] | Dict[str, Any]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Analyze Wyckoff position multiplicities and calculate approximate coordinates
[?2004l[?2004h>     for the first atom of each Wyckoff position.
[?2004l[?2004h>     """
[?2004l[?2004h>     # Read structure from CIF
[?2004l[?2004h>     structure = Structure.from_file(filepath)
[?2004l[?2004h>     # Symmetry analysis to get Wyckoff positions
[?2004l[?2004h>     sga = SpacegroupAnalyzer(structure, symprec=1e-3)
[?2004l[?2004h>     symm_structure = sga.get_symmetrized_structure()
[?2004l[?2004h> 
[?2004l[?2004h>     wyckoff_multiplicity_dict: Dict[str, int] = {}
[?2004l[?2004h>     wyckoff_coordinates_dict: Dict[str, list] = {}
[?2004l[?2004h> 
[?2004l[?2004h>     for symbol, sites in zip(symm_structure.wyckoff_symbols, symm_structure.equivalent_sites):
[?2004l[?2004h>         m = re.match(r"(\d+)([A-Za-z]+)", symbol)
[?2004l[?2004h>         if not m:
[?2004l[?2004h>             continue
[?2004l[?2004h>         multiplicity = int(m.group(1))
[?2004l[?2004h>         letter = m.group(2)
[?2004l[?2004h>         # store multiplicity
[?2004l[?2004h>         wyckoff_multiplicity_dict[letter] = multiplicity
[?2004l[?2004h>         # first site's fractional coordinates
[?2004l[?2004h>         coords = sites[0].frac_coords
[?2004l[?2004h>         wyckoff_coordinates_dict[letter] = [
[?2004l[?2004h>             _float_to_rational_str(float(c)) for c in coords
[?2004l[?2004h>         ]
[?2004l[?2004h> 
[?2004l[?2004h>     return {
[?2004l[?2004h>         "wyckoff_multiplicity_dict": wyckoff_multiplicity_dict,
[?2004l[?2004h>         "wyckoff_coordinates_dict": wyckoff_coordinates_dict,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     # simple manual test
[?2004l[?2004h>     import sys, json
[?2004l[?2004h>     if len(sys.argv) > 1:
[?2004l[?2004h>         print(json.dumps(analyze_wyckoff_position_multiplicities_and_coordinates(sys.argv[1]), indent=2))
[?2004l[?2004h> PY
