[161.280935, "o", "\u001b[?2004h> "]
[161.281091, "o", "            taskSourceOrTest(new GzipCSVSource<>(taskInput, TaskEvent::fromCSV))\r\n\u001b[?2004l\r"]
[161.28114, "o", "\u001b[?2004h> "]
[161.281195, "o", "        ).name(\"TaskEventSource\");\r\n\u001b[?2004l\r"]
[161.281241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.281352, "o", "        // Filter for SUBMIT events (eventType = 4) and assign timestamps\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.2814, "o", "> "]
