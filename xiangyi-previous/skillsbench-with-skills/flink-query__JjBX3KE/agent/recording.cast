[161.28322, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.283301, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.283427, "o", "            .window(EventTimeSessionWindows.withGap(Duration.ofNanos(sesssize * 1000)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.283562, "o", "            .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\r\n\u001b[?2004l\r"]
[161.283588, "o", "\u001b[?2004h> "]
[161.283655, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.283709, "o", "> "]
[161.283853, "o", "                public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> events, Collector<Tuple2<Long, Long>> out) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.283907, "o", "> "]
[161.283958, "o", "                    long count = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.284013, "o", "                    for (TaskEvent event : events) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.28406, "o", "> "]
[161.284118, "o", "                        count++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.284169, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.284247, "o", "                    out.collect(new Tuple2<>(jobId, count));\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.284272, "o", "> "]
[161.284298, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.284371, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.284422, "o", ">             .name(\"SessionWindow\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[161.284464, "o", "\u001b[?2004h> "]
[161.284509, "o", "        // Find max tasks per job\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.28458, "o", "        DataStream<Tuple2<Long, Long>> maxPerJob = result\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.284631, "o", "> "]
[161.284743, "o", "            .keyBy(new org.apache.flink.api.java.functions.KeySelector<Tuple2<Long, Long>, Long>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.284795, "o", "> "]
[161.284846, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.284937, "o", "                public Long getKey(Tuple2<Long, Long> value) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.284996, "o", "> "]
[161.285045, "o", "                    return value.f0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.285085, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.285129, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.28526, "o", "            .reduce(new org.apache.flink.api.common.functions.ReduceFunction<Tuple2<Long, Long>>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.285312, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
