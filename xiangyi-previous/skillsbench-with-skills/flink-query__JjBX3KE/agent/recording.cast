[49.494885, "i", "cat > /app/workspace/src/main/java/clusterdata/datatypes/TaskEvent.java << 'EOF'\npackage clusterdata.datatypes;\n\nimport java.io.Serializable;\n\npublic class TaskEvent implements Serializable {\n    public long timestamp;        // field 0\n    public String field1;         // field 1 (empty)\n    public long jobId;            // field 2\n    public long taskIndex;        // field 3\n    public String machineId;      // field 4\n    public int eventType;         // field 5\n    public String userId;         // field 6\n    public int field7;            // field 7\n    public int field8;            // field 8\n    public double cpu;            // field 9\n    public double memory;         // field 10\n    public double field11;        // field 11\n    public int field12;           // field 12\n\n    public TaskEvent() {}\n\n    public static TaskEvent fromCSV(String line) {\n        TaskEvent event = new TaskEvent();\n        String[] fields = line.split(\",\");\n        \n        if (fields.length >= 13) {\n            event.timestamp = Long.parseLong(fields[0]);\n            event.field1 = fields[1];\n            event.jobId = Long.parseLong(fields[2]);\n            event.taskIndex = Long.parseLong(fields[3]);\n            event.machineId = fields[4];\n            event.eventType = Integer.parseInt(fields[5]);\n            event.userId = fields[6];\n            event.field7 = Integer.parseInt(fields[7]);\n            event.field8 = Integer.parseInt(fields[8]);\n            event.cpu = Double.parseDouble(fields[9]);\n            event.memory = Double.parseDouble(fields[10]);\n            event.field11 = Double.parseDouble(fields[11]);\n            event.field12 = Integer.parseInt(fields[12]);\n        }\n        \n        return event;\n    }\n\n    @Override\n    public String toString() {\n        return \"TaskEvent{\" +\n                \"timestamp=\" + timestamp +\n                \", jobId=\" + jobId +\n                \", taskIndex=\" + taskIndex +\n                \", eventType=\" + eventType +\n                '}';\n    }\n}\nEOF\n"]
