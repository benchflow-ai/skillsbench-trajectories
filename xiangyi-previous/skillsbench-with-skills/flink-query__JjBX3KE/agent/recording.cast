[453.523896, "o", "\u001b[?2004h> "]
[453.524044, "o", "        ParameterTool params = ParameterTool.fromArgs(args);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.524219, "o", "        String taskInput = params.get(\"task_input\", null);\r\n\u001b[?2004l\r\u001b[?2004h> "]
