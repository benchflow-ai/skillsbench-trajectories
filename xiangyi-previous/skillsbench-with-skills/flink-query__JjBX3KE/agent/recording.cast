[161.285621, "o", "                    return new Tuple2<>(v1.f0, Math.max(v1.f1, v2.f1));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.285661, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.285686, "o", "> "]
[161.285731, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
