[453.529622, "o", "                    return value.f0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.529671, "o", ">                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.529727, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.52989, "o", "            .reduce(new org.apache.flink.api.common.functions.ReduceFunction<Tuple2<Long, Long>>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.529955, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
