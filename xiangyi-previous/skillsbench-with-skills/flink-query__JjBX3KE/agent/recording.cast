[161.281731, "o", "                public boolean filter(TaskEvent event) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.281853, "o", "                    return event.eventType == 4; // SUBMIT event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.281875, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.281958, "o", "> "]
[161.282008, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>             .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r"]
[161.282083, "o", "\u001b[?2004h> "]
[161.282135, "o", "                WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.282186, "o", "> "]
[161.282266, "o", "                    .withTimestampAssigner((event, recordTimestamp) -> event.timestamp)\r\n\u001b[?2004l\r"]
[161.282313, "o", "\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.282386, "o", "            .name(\"FilterSubmitEvents\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.28244, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.28255, "o", "        // Group by jobId and apply session window (10 minutes in microseconds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.282596, "o", "> "]
[161.28265, "o", "        // Convert microseconds to nanoseconds for Duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.282703, "o", "> "]
[161.282754, "o", "        DataStream<Tuple2<Long, Long>> result = submitEvents\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.282812, "o", "> "]
[161.282913, "o", "            .keyBy(new org.apache.flink.api.java.functions.KeySelector<TaskEvent, Long>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.282939, "o", "> "]
[161.28299, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.283052, "o", "> "]
[161.283093, "o", "                public Long getKey(TaskEvent event) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
