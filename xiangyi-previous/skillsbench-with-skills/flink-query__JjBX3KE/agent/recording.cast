[54.029339, "i", "cat > /app/workspace/src/main/java/clusterdata/datatypes/JobEvent.java << 'EOF'\npackage clusterdata.datatypes;\n\nimport java.io.Serializable;\n\npublic class JobEvent implements Serializable {\n    public long timestamp;        // field 0\n    public String field1;         // field 1 (empty)\n    public long jobId;            // field 2\n    public int eventType;         // field 3\n    public String userId;         // field 4\n    public int field5;            // field 5\n    public String field6;         // field 6\n    public String field7;         // field 7\n\n    public JobEvent() {}\n\n    public static JobEvent fromCSV(String line) {\n        JobEvent event = new JobEvent();\n        String[] fields = line.split(\",\");\n        \n        if (fields.length >= 8) {\n            event.timestamp = Long.parseLong(fields[0]);\n            event.field1 = fields[1];\n            event.jobId = Long.parseLong(fields[2]);\n            event.eventType = Integer.parseInt(fields[3]);\n            event.userId = fields[4];\n            event.field5 = Integer.parseInt(fields[5]);\n            event.field6 = fields[6];\n            event.field7 = fields[7].trim(); // Remove newline\n        }\n        \n        return event;\n    }\n\n    @Override\n    public String toString() {\n        return \"JobEvent{\" +\n                \"timestamp=\" + timestamp +\n                \", jobId=\" + jobId +\n                \", eventType=\" + eventType +\n                '}';\n    }\n}\nEOF\n"]
[54.029639, "o", "cat > /app/workspace/src/main/java/clusterdata/datatypes/JobEvent.java << 'EOF'\r\n\u001b[?2004l\r"]
