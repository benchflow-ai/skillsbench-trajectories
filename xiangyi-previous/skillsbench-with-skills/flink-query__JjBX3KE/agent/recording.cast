[453.524919, "o", "> "]
[453.525033, "o", "        final long sesssize = params.getLong(\"sesssize\", 600000); // 10 minutes in milliseconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.52509, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.525152, "o", "        // set up streaming execution environment\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.525208, "o", "> "]
[453.525317, "o", "        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.525367, "o", "        env.setParallelism(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.525419, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.525475, "o", "        // Read task events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.525561, "o", "        DataStream<TaskEvent> taskEvents = env.addSource(\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.525617, "o", "> "]
[453.525699, "o", "            taskSourceOrTest(new GzipCSVSource<>(taskInput, new TaskEventParser()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.525746, "o", "> "]
[453.525796, "o", "        ).name(\"TaskEventSource\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.525913, "o", "        // Filter for SUBMIT events (eventType = 4) and assign timestamps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.526008, "o", "        DataStream<TaskEvent> submitEvents = taskEvents\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.526056, "o", "> "]
[453.526105, "o", "            .filter(new FilterFunction<TaskEvent>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.526153, "o", ">                 @Override\r\n\u001b[?2004l\r"]
[453.526209, "o", "\u001b[?2004h> "]
[453.526287, "o", "                public boolean filter(TaskEvent event) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.526338, "o", "> "]
[453.526399, "o", "                    return event.eventType == 4; // SUBMIT event\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.526457, "o", ">                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.526507, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.526584, "o", "            .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r"]
[453.526633, "o", "\u001b[?2004h> "]
[453.526712, "o", "                WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.526935, "o", "                    .withTimestampAssigner((event, recordTimestamp) -> event.timestamp / 1000) // Convert microseconds to milliseconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.526979, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527046, "o", "            .name(\"FilterSubmitEvents\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.527106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527224, "o", "        // Group by jobId and apply session window (10 minutes = 600000 milliseconds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.52732, "o", "        DataStream<Tuple2<Long, Long>> result = submitEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527494, "o", "            .keyBy(new org.apache.flink.api.java.functions.KeySelector<TaskEvent, Long>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527559, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527669, "o", "                public Long getKey(TaskEvent event) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527741, "o", "                    return event.jobId;\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.527789, "o", ">                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527838, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.527981, "o", "            .window(EventTimeSessionWindows.withGap(Time.milliseconds(sesssize)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528129, "o", "            .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528182, "o", "                @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528441, "o", "                public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> events, Collector<Tuple2<Long, Long>> out) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528504, "o", "                    long count = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528616, "o", "                    for (TaskEvent event : events) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528675, "o", "                        count++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.528744, "o", ">                     }\r\n\u001b[?2004l\r"]
[453.528807, "o", "\u001b[?2004h> "]
[453.528857, "o", "                    out.collect(new Tuple2<>(jobId, count));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.528919, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r"]
[453.528969, "o", "\u001b[?2004h> "]
[453.529016, "o", "            .name(\"SessionWindow\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[453.529072, "o", "> "]
[453.529126, "o", "        // Find max tasks per job\r\n\u001b[?2004l\r\u001b[?2004h> "]
[453.529204, "o", "        DataStream<Tuple2<Long, Long>> maxPerJob = result\r\n\u001b[?2004l\r\u001b[?2004h> "]
