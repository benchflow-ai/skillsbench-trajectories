[?2004l[?2004h> def classify_camera_motion(flow, H, h, w):
[?2004l[?2004h>     """Classify camera motion based on optical flow and homography."""
[?2004l[?2004h>     labels = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute mean flow
[?2004l[?2004h>     flow_x = flow[:, :, 0]
[?2004l[?2004h>     flow_y = flow[:, :, 1]
[?2004l[?2004h>     mean_flow_x = np.mean(flow_x)
[?2004l[?2004h>     mean_flow_y = np.mean(flow_y)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute flow magnitude
[?2004l[?2004h>     magnitude = np.sqrt(flow_x**2 + flow_y**2)
[?2004l[?2004h>     mean_magnitude = np.mean(magnitude)
[?2004l[?2004h>     
[?2004l[?2004h>     # Thresholds
[?2004l[?2004h>     motion_threshold = 1.5  # pixels
[?2004l[?2004h>     
[?2004l[?2004h>     if mean_magnitude < motion_threshold:
[?2004l[?2004h>         return ["Stay"]
[?2004l[?2004h>     
[?2004l[?2004h>     # Analyze flow pattern for different motion types
[?2004l[?2004h>     # Pan: horizontal translation (negative flow_x = camera moving right = Pan Right)
[?2004l[?2004h>     # Tilt: vertical translation (negative flow_y = camera moving up = Tilt Up)
[?2004l[?2004h>     # Dolly: radial flow (in = Dolly In, out = Dolly Out)
[?2004l[?2004h>     # Roll: rotational flow around center
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for pan (horizontal motion)
[?2004l[?2004h>     if abs(mean_flow_x) > motion_threshold:
[?2004l[?2004h>         if mean_flow_x < 0:
[?2004l[?2004h>             labels.append("Pan Right")
[?2004l[?2004h>         else:
[?2004l[?2004h>             labels.append("Pan Left")
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for tilt (vertical motion)
[?2004l[?2004h>     if abs(mean_flow_y) > motion_threshold:
[?2004l[?2004h>         if mean_flow_y < 0:
[?2004l[?2004h>             labels.append("Tilt Down")
[?2004l[?2004h>         else:
[?2004l[?2004h>             labels.append("Tilt Up")
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for dolly (zoom) - radial flow pattern
[?2004l[?2004h>     cy, cx = h // 2, w // 2
[?2004l[?2004h>     y_coords, x_coords = np.mgrid[0:h, 0:w]
[?2004l[?2004h>     
[?2004l[?2004h>     # Vector from center to each pixel
[?2004l[?2004h>     dx = x_coords - cx
[?2004l[?2004h>     dy = y_coords - cy
[?2004l[?2004h>     
[?2004l[?2004h>     # Normalize
[?2004l[?2004h>     dist = np.sqrt(dx**2 + dy**2) + 1e-6
[?2004l[?2004h>     dx_norm = dx / dist
[?2004l[?2004h>     dy_norm = dy / dist
[?2004l[?2004h>     
[?2004l[?2004h>     # Radial component of flow (positive = outward = dolly in, camera approaching)
[?2004l[?2004h>     radial_flow = flow_x * dx_norm + flow_y * dy_norm
[?2004l[?2004h>     mean_radial = np.mean(radial_flow)
[?2004l[?2004h>     
[?2004l[?2004h>     if abs(mean_radial) > motion_threshold * 0.5:
[?2004l[?2004h>         if mean_radial > 0:  # Flow going outward = objects getting bigger = Dolly In
[?2004l[?2004h>             labels.append("Dolly In")
[?2004l[?2004h>         else:
[?2004l[?2004h>             labels.append("Dolly Out")
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for roll - tangential flow pattern
[?2004l[?2004h>     tangent_flow = -flow_x * dy_norm + flow_y * dx_norm
[?2004l[?2004h>     mean_tangent = np.mean(tangent_flow)
[?2004l[?2004h>     
[?2004l[?2004h>     if abs(mean_tangent) > motion_threshold * 0.5:
[?2004l[?2004h>         if mean_tangent > 0:
[?2004l[?2004h>             labels.append("Roll Left")
[?2004l[?2004h>         else:
[?2004l[?2004h>             labels.append("Roll Right")
[?2004l[?2004h>     
[?2004l[?2004h>     if not labels:
[?2004l[?2004h>         labels = ["Stay"]
[?2004l[?2004h>     
[?2004l[?2004h>     return labels
