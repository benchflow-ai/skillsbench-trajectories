[?2004l[?2004h> def detect_dynamic_objects(flow, H, prev_frame, curr_frame):
[?2004l[?2004h>     """Detect dynamic objects by finding regions inconsistent with global motion."""
[?2004l[?2004h>     h, w = prev_frame.shape
[?2004l[?2004h>     
[?2004l[?2004h>     if H is None:
[?2004l[?2004h>         # Fall back to mean flow subtraction
[?2004l[?2004h>         mean_flow = np.mean(flow, axis=(0, 1))
[?2004l[?2004h>         residual_flow = flow - mean_flow
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Warp previous frame using homography and compare
[?2004l[?2004h>         y_coords, x_coords = np.mgrid[0:h, 0:w].astype(np.float32)
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute expected flow from homography
[?2004l[?2004h>         ones = np.ones((h, w), dtype=np.float32)
[?2004l[?2004h>         pts = np.stack([x_coords, y_coords, ones], axis=-1)
[?2004l[?2004h>         
[?2004l[?2004h>         # Apply homography
[?2004l[?2004h>         H_inv = np.linalg.inv(H) if H is not None else np.eye(3)
[?2004l[?2004h>         warped_pts = np.einsum('ij,...j->...i', H, pts)
[?2004l[?2004h>         warped_pts = warped_pts[..., :2] / (warped_pts[..., 2:3] + 1e-6)
[?2004l[?2004h>         
[?2004l[?2004h>         expected_flow = warped_pts - np.stack([x_coords, y_coords], axis=-1)
[?2004l[?2004h>         residual_flow = flow - expected_flow
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute residual magnitude
[?2004l[?2004h>     residual_mag = np.sqrt(residual_flow[:, :, 0]**2 + residual_flow[:, :, 1]**2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Threshold to get dynamic mask
[?2004l[?2004h>     threshold = np.percentile(residual_mag, 85)  # Top 15% as potential dynamic
[?2004l[?2004h>     threshold = max(threshold, 2.0)  # Minimum threshold
[?2004l[?2004h>     
[?2004l[?2004h>     dynamic_mask = residual_mag > threshold
[?2004l[?2004h>     
[?2004l[?2004h>     # Clean up mask with morphological operations
[?2004l[?2004h>     kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
[?2004l[?2004h>     dynamic_mask = cv2.morphologyEx(dynamic_mask.astype(np.uint8), cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>     dynamic_mask = cv2.morphologyEx(dynamic_mask, cv2.MORPH_CLOSE, kernel)
[?2004l[?2004h>     
[?2004l[?2004h>     return dynamic_mask.astype(bool)
