[?2004l[?2004h> IMG_DIR = "/app/workspace/dataset/img"
[?2004l[?2004h> OUTPUT_FILE = "/app/workspace/stat_ocr.xlsx"
[?2004l[?2004h> 
[?2004l[?2004h> # Keywords sorted by priority (1 is highest)
[?2004l[?2004h> PRIORITY_1 = ["GRAND TOTAL"]
[?2004l[?2004h> PRIORITY_2 = ["TOTAL RM", "TOTAL: RM"]
[?2004l[?2004h> PRIORITY_3 = ["TOTAL AMOUNT"]
[?2004l[?2004h> PRIORITY_4 = ["TOTAL", "AMOUNT", "TOTAL DUE", "AMOUNT DUE", "BALANCE DUE", "NETT TOTAL", "NET TOTAL"]
[?2004l[?2004h> 
[?2004l[?2004h> EXCLUSION = ["SUBTOTAL", "SUB TOTAL", "TAX", "GST", "SST", "DISCOUNT", "CHANGE", "CASH TENDERED"]
[?2004l[?2004h> 
[?2004l[?2004h> def extract_date(text):
[?2004l[?2004h>     # YYYY-MM-DD
[?2004l[?2004h>     match = re.search(r'\b(\d{4})-(\d{2})-(\d{2})\b', text)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         return f"{match.group(1)}-{match.group(2)}-{match.group(3)}"
[?2004l[?2004h>     
[?2004l[?2004h>     # DD-MM-YYYY or DD/MM/YYYY or DD.MM.YYYY
[?2004l[?2004h>     match = re.search(r'\b(\d{2})[-/.](\d{2})[-/.](\d{4})\b', text)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         return f"{match.group(3)}-{match.group(2)}-{match.group(1)}"
[?2004l[?2004h>     
[?2004l[?2004h>     # DD MMM YYYY (e.g. 23 JAN 2019)
[?2004l[?2004h>     match = re.search(r'\b(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})\b', text, re.IGNORECASE)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         day, month_str, year = match.groups()
[?2004l[?2004h>         try:
[?2004l[?2004h>             date_obj = datetime.strptime(f"{day} {month_str} {year}", "%d %b %Y")
[?2004l[?2004h>             return date_obj.strftime("%Y-%m-%d")
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>     # MMM DD YYYY (e.g. JAN 23 2019)
[?2004l[?2004h>     match = re.search(r'\b([A-Za-z]{3})\s+(\d{1,2})[,\s]+(\d{4})\b', text, re.IGNORECASE)
[?2004l[?2004h>     if match:
[?2004l[?2004h>         month_str, day, year = match.groups()
[?2004l[?2004h>         try:
[?2004l[?2004h>             date_obj = datetime.strptime(f"{day} {month_str} {year}", "%d %b %Y")
[?2004l[?2004h>             return date_obj.strftime("%Y-%m-%d")
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def parse_amount(line):
[?2004l[?2004h>     # Look for currency pattern: 1,234.56 or 1234.56 or 12.34
[?2004l[?2004h>     # We assume 2 decimal places as per hint
[?2004l[?2004h>     matches = re.findall(r'(\d{1,3}(?:,\d{3})*\.\d{2})', line)
[?2004l[?2004h>     if matches:
[?2004l[?2004h>         # Return the last one found on the line
[?2004l[?2004h>         val = matches[-1]
[?2004l[?2004h>         return val.replace(',', '')
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def extract_total(text):
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     candidates = [] # (priority, value)
[?2004l[?2004h>     
[?2004l[?2004h>     for i, line in enumerate(lines):
[?2004l[?2004h>         line_upper = line.upper()
[?2004l[?2004h>         
[?2004l[?2004h>         # Check exclusion
[?2004l[?2004h>         if any(ex in line_upper for ex in EXCLUSION):
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         priority = 0
[?2004l[?2004h>         if any(k in line_upper for k in PRIORITY_1):
[?2004l[?2004h>             priority = 1
[?2004l[?2004h>         elif any(k in line_upper for k in PRIORITY_2):
[?2004l[?2004h>             priority = 2
[?2004l[?2004h>         elif any(k in line_upper for k in PRIORITY_3):
[?2004l[?2004h>             priority = 3
[?2004l[?2004h>         elif any(k in line_upper for k in PRIORITY_4):
[?2004l[?2004h>             priority = 4
[?2004l[?2004h>             
[?2004l[?2004h>         if priority > 0:
[?2004l[?2004h>             val = parse_amount(line)
[?2004l[?2004h>             if val:
[?2004l[?2004h>                 candidates.append((priority, val))
[?2004l[?2004h>             else:
[?2004l[?2004h>                 # Fallback to next line
[?2004l[?2004h>                 if i + 1 < len(lines):
[?2004l[?2004h>                     next_line = lines[i+1]
[?2004l[?2004h>                     val_next = parse_amount(next_line)
[?2004l[?2004h>                     if val_next:
[?2004l[?2004h>                         candidates.append((priority, val_next))
[?2004l[?2004h>     
[?2004l[?2004h>     if not candidates:
[?2004l[?2004h>         return None
[?2004l[?2004h>         
[?2004l[?2004h>     # Sort by priority (1 is best, so ascending)
[?2004l[?2004h>     candidates.sort(key=lambda x: x[0])
[?2004l[?2004h>     return candidates[0][1]
[?2004l[?2004h> 
[?2004l[?2004h> def process():
[?2004l[?2004h>     wb = Workbook()
[?2004l[?2004h>     ws = wb.active
[?2004l[?2004h>     ws.title = "results"
[?2004l[?2004h>     ws.append(["filename", "date", "total_amount"])
[?2004l[?2004h>     
[?2004l[?2004h>     files = sorted(glob.glob(os.path.join(IMG_DIR, "*.jpg")))
[?2004l[?2004h>     
[?2004l[?2004h>     for fpath in files:
[?2004l[?2004h>         fname = os.path.basename(fpath)
[?2004l[?2004h>         try:
[?2004l[?2004h>             text = pytesseract.image_to_string(Image.open(fpath))
[?2004l[?2004h>             
[?2004l[?2004h>             date_str = extract_date(text)
[?2004l[?2004h>             total_str = extract_total(text)
[?2004l[?2004h>             
[?2004l[?2004h>             ws.append([fname, date_str, total_str])
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error processing {fname}: {e}")
[?2004l[?2004h>             ws.append([fname, None, None])
[?2004l[?2004h>             
[?2004l[?2004h>     wb.save(OUTPUT_FILE)
[?2004l[?2004h> 
