[454.667653, "o", "python3 -c \"from openpyxl import load_workbook; wb = load_workbook('/app/workspace/stat_ocr.xlsx'); ws = wb.active; print([cell.value for cell in next(ws.rows)]); print([cell.value for cell in list(ws.rows)[1]])\"\r\n"]
