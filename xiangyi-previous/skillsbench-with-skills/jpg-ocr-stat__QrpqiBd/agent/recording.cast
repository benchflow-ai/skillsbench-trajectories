[404.706669, "o", "            priority = 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[404.706701, "o", "> "]
[404.706843, "o", "        elif any(k in line_upper for k in PRIORITY_3):\r\n\u001b[?2004l\r"]
[404.706876, "o", "\u001b[?2004h> "]
[404.706952, "o", "            priority = 3\r\n\u001b[?2004l\r"]
[404.706985, "o", "\u001b[?2004h> "]
[404.707426, "o", "        elif any(k in line_upper for k in PRIORITY_4):\r\n\u001b[?2004l\r\u001b[?2004h>             priority = 4\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         if priority > 0:\r\n\u001b[?2004l\r"]
[404.707466, "o", "\u001b[?2004h> "]
[404.707612, "o", "            val = parse_amount(line)\r\n\u001b[?2004l\r"]
[404.70775, "o", "\u001b[?2004h>             if val:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.70786, "o", "                candidates.append((priority, val))\r\n\u001b[?2004l\r"]
[404.707955, "o", "\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[404.708108, "o", ">                 # Fallback to next line\r\n\u001b[?2004l\r"]
[404.708315, "o", "\u001b[?2004h>                 if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.708465, "o", "                    next_line = lines[i+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.708503, "o", "                    val_next = parse_amount(next_line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.708657, "o", "                    if val_next:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.708762, "o", "                        candidates.append((priority, val_next))\r\n\u001b[?2004l\r"]
[404.708911, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.709048, "o", "    if not candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.709163, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.709315, "o", "    # Sort by priority (1 is best, so ascending)\r\n\u001b[?2004l\r\u001b[?2004h>     candidates.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[404.709456, "o", "\u001b[?2004h> "]
[404.709493, "o", "    return candidates[0][1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.709522, "o", "def process():\r\n\u001b[?2004l\r"]
[404.709551, "o", "\u001b[?2004h> "]
[404.709753, "o", "    wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h>     ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.709791, "o", "    ws.title = \"results\"\r\n\u001b[?2004l\r"]
[404.709833, "o", "\u001b[?2004h> "]
[404.71001, "o", "    ws.append([\"filename\", \"date\", \"total_amount\"])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[404.710044, "o", "\u001b[?2004h> "]
[404.710184, "o", "    files = sorted(glob.glob(os.path.join(IMG_DIR, \"*.jpg\")))\r\n\u001b[?2004l\r"]
[404.71022, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[404.710248, "o", "\u001b[?2004h> "]
[404.710418, "o", "    for fpath in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.71045, "o", "        fname = os.path.basename(fpath)\r\n\u001b[?2004l\r"]
[404.710478, "o", "\u001b[?2004h> "]
[404.710643, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.710737, "o", "            text = pytesseract.image_to_string(Image.open(fpath))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.710767, "o", "            \r\n\u001b[?2004l\r"]
[404.710794, "o", "\u001b[?2004h> "]
[404.710962, "o", "            date_str = extract_date(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.711061, "o", "            total_str = extract_total(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.711092, "o", "            \r\n\u001b[?2004l\r"]
[404.711126, "o", "\u001b[?2004h> "]
[404.711293, "o", "            ws.append([fname, date_str, total_str])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.711388, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.711539, "o", "            print(f\"Error processing {fname}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[404.711642, "o", "            ws.append([fname, None, None])\r\n\u001b[?2004l\r"]
[404.711671, "o", "\u001b[?2004h> "]
[404.711698, "o", "            \r\n\u001b[?2004l\r"]
[404.711726, "o", "\u001b[?2004h> "]
[404.711921, "o", "    wb.save(OUTPUT_FILE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[404.711953, "o", "\u001b[?2004h> "]
[404.71198, "o", "    process()\r\n\u001b[?2004l\r"]
[404.712007, "o", "\u001b[?2004h> "]
[404.712033, "o", "EOF\r\n\u001b[?2004l\r"]
[404.713559, "o", "\u001b[?2004hroot@ce9fc0dd380b:/app/workspace# "]
