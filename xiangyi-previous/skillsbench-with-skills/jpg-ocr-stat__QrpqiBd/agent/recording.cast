[114.898782, "o", "tan chay yee"]
[114.899629, "o", "\r\n\r\nSufi, HOTOR ( SUNGAT RENGIT ) SON, Bt.\r\n\r\n( 801580-T )\r\nNo. 343, Jalan Kurau, Sungai Rengit,\r\n81620 Pengerang, Johor.\r\nel: 07-8263254 Fax: 07-8266888\r\n\r\nINVOICE\r\n\r\nTTEM/DESC. QvY U.PRICE RNCTOTAL)\r\n\r\n4132 1 20.00 20. 00\r\nCROCS 300X17 TUBES\r\n\r\nSUB TOTAL : 20.00\r\n\r\nROUNDING ADJUSTMENT : 0.00\r\nGRAND TOTAL : 20.00\r\n"]
[114.899675, "o", "\r\nCASH: — 20.00\r\n\r\nCHANGE : 0.00\r\n\r\n23-01-2019 13:14:15 PM, PRINT BY: root\r\nTOKEN NO: 0, STATION ID: Al, PID: POS\r\nINVOICE NO: 22497\r\n\r\nThanks Your Support 4 WwW n\r\n"]
[114.916084, "o", "\u001b[?2004hroot@ce9fc0dd380b:/app/workspace# "]
[404.686067, "i", "cat << 'EOF' > solve_ocr.py\nimport os\nimport re\nimport glob\nimport pytesseract\nfrom PIL import Image\nfrom openpyxl import Workbook\nfrom datetime import datetime\n\nIMG_DIR = \"/app/workspace/dataset/img\"\nOUTPUT_FILE = \"/app/workspace/stat_ocr.xlsx\"\n\n# Keywords sorted by priority (1 is highest)\nPRIORITY_1 = [\"GRAND TOTAL\"]\nPRIORITY_2 = [\"TOTAL RM\", \"TOTAL: RM\"]\nPRIORITY_3 = [\"TOTAL AMOUNT\"]\nPRIORITY_4 = [\"TOTAL\", \"AMOUNT\", \"TOTAL DUE\", \"AMOUNT DUE\", \"BALANCE DUE\", \"NETT TOTAL\", \"NET TOTAL\"]\n\nEXCLUSION = [\"SUBTOTAL\", \"SUB TOTAL\", \"TAX\", \"GST\", \"SST\", \"DISCOUNT\", \"CHANGE\", \"CASH TENDERED\"]\n\ndef extract_date(text):\n    # YYYY-MM-DD\n    match = re.search(r'\\b(\\d{4})-(\\d{2})-(\\d{2})\\b', text)\n    if match:\n        return f\"{match.group(1)}-{match.group(2)}-{match.group(3)}\"\n    \n    # DD-MM-YYYY or DD/MM/YYYY or DD.MM.YYYY\n    match = re.search(r'\\b(\\d{2})[-/.](\\d{2})[-/.](\\d{4})\\b', text)\n    if match:\n        return f\"{match.group(3)}-{match.group(2)}-{match.group(1)}\"\n    \n    # DD MMM YYYY (e.g. 23 JAN 2019)\n    match = re.search(r'\\b(\\d{1,2})\\s+([A-Za-z]{3})\\s+(\\d{4})\\b', text, re.IGNORECASE)\n    if match:\n        day, month_str, year = match.groups()\n        try:\n            date_obj = datetime.strptime(f\"{day} {month_str} {year}\", \"%d %b %Y\")\n            return date_obj.strftime(\"%Y-%m-%d\")\n        except ValueError:\n            pass\n            \n    # MMM DD YYYY (e.g. JAN 23 2019)\n    match = re.search(r'\\b([A-Za-z]{3})\\s+(\\d{1,2})[,\\s]+(\\d{4})\\b', text, re.IGNORECASE)\n    if match:\n        month_str, day, year = match.groups()\n        try:\n            date_obj = datetime.strptime(f\"{day} {month_str} {year}\", \"%d %b %Y\")\n            return date_obj.strftime(\"%Y-%m-%d\")\n        except ValueError:\n            pass\n            \n    return None\n\ndef parse_amount(line):\n    # Look for currency pattern: 1,234.56 or 1234.56 or 12.34\n    # We assume 2 decimal places as per hint\n    matches = re.findall(r'(\\d{1,3}(?:,\\d{3})*\\.\\d{2})', line)\n    if matches:\n        # Return the last one found on the line\n        val = matches[-1]\n        return val.replace(',', '')\n    return None\n\ndef extract_total(text):\n    lines = text.split('\\n')\n    candidates = [] # (priority, value)\n    \n    for i, line in enumerate(lines):\n        line_upper = line.upper()\n        \n        # Check exclusion\n        if any(ex in line_upper for ex in EXCLUSION):\n            continue\n            \n        priority = 0\n        if any(k in line_upper for k in PRIORITY_1):\n            priority = 1\n        elif any(k in line_upper for k in PRIORITY_2):\n            priority = 2\n        elif any(k in line_upper for k in PRIORITY_3):\n            priority = 3\n        elif any(k in line_upper for k in PRIORITY_4):\n            priority = 4\n            \n        if priority > 0:\n            val = parse_amount(line)\n            if val:\n                candidates.append((priority, val))\n            else:\n                # Fallback to next line\n                if i + 1 < len(lines):\n                    next_line = lines[i+1]\n                    val_next = parse_amount(next_line)\n                    if val_next:\n                        candidates.append((priority, val_next))\n    \n    if not candidates:\n        return None\n        \n    # Sort by priority (1 is best, so ascending)\n    candidates.sort(key=lambda x: x[0])\n    return candidates[0][1]\n\ndef process():\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"results\"\n    ws.append([\"filename\", \"date\", \"total_amount\"])\n    \n    files = sorted(glob.glob(os.path.join(IMG_DIR, \"*.jpg\")))\n    \n    for fpath in files:\n        fname = os.path.basename(fpath)\n        try:\n            text = pytesseract.image_to_string(Image.open(fpath))\n            \n            date_str = extract_date(text)\n            total_str = extract_total(text)\n            \n            ws.append([fname, date_str, total_str])\n        except Exception as e:\n            print(f\"Error processing {fname}: {e}\")\n            ws.append([fname, None, None])\n            \n    wb.save(OUTPUT_FILE)\n\nif __name__ == \"__main__\":\n    process()\nEOF\n"]
[404.686356, "o", "cat << 'EOF' > solve_ocr.py"]
