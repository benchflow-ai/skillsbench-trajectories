[?2004hroot@21f5b6c60e55:~# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> # Load data as strings
[?2004l[?2004h> raw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> # Clean numeric formatting: replace commas with dots, strip spaces, convert to numeric
[?2004l[?2004h> for col in raw.columns:
[?2004l[?2004h>     if col == 'patient_id':
[?2004l[?2004h>         continue
[?2004l[?2004h>     raw[col] = raw[col].str.replace(',', '.', regex=False).str.strip()
[?2004l[?2004h>     raw[col] = pd.to_numeric(raw[col], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with any missing values
[?2004l[?2004h> raw = raw.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # Helper for conditional conversion
[?2004l[?2004h> 
[?2004l[?2004h> def convert_cond(df, col, cond, factor, op='*'):
[?2004l[?2004h>     if op == '*':
[?2004l[?2004h>         df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] * factor
[?2004l[?2004h>     else:
[?2004l[?2004h>         df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] / factor
[?2004l[?2004h> 
[?2004l[?2004h> # Unit harmonization conversions
[?2004l[?2004h> convert_cond(raw, 'Serum_Creatinine', lambda s: s > 20, 88.4, op='/')            # µmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'BUN', lambda s: s < 5, 2.8, op='*')                           # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Serum_Calcium', lambda s: s < 4, 4, op='*')                   # mmol/L -> mg/dL
[?2004l[?2004h> raw['Ionized_Calcium'] = raw['Ionized_Calcium'] * 4                              # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Phosphorus', lambda s: s < 2, 3.1, op='*')                    # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Magnesium', lambda s: s < 1, 2.43, op='*')                    # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Intact_PTH', lambda s: s < 10, 9.43, op='*')                  # pmol/L -> pg/mL
[?2004l[?2004h> convert_cond(raw, 'Vitamin_D_25OH', lambda s: s > 100, 2.5, op='/')              # nmol/L -> ng/mL
[?2004l[?2004h> convert_cond(raw, 'Vitamin_D_1_25OH', lambda s: s > 100, 2.4, op='/')            # pmol/L -> pg/mL
[?2004l[?2004h> convert_cond(raw, 'Hemoglobin', lambda s: s > 25, 10, op='/')                    # g/L -> g/dL
[?2004l[?2004h> convert_cond(raw, 'Albumin_Serum', lambda s: s > 10, 10, op='/')                 # g/L -> g/dL
[?2004l[?2004h> convert_cond(raw, 'Total_Protein', lambda s: s > 10, 10, op='/')                 # g/L -> g/dL
[?2004l[?2004h> convert_cond(raw, 'Prealbumin', lambda s: s > 100, 10, op='/')                   # mg/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Total_Bilirubin', lambda s: s > 5, 17.1, op='/')              # µmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Direct_Bilirubin', lambda s: s > 2, 17.1, op='/')             # µmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Serum_Iron', lambda s: s < 30, 5.585, op='*')                 # µmol/L -> µg/dL
[?2004l[?2004h> convert_cond(raw, 'TIBC', lambda s: s < 100, 5.585, op='*')                      # µmol/L -> µg/dL
[?2004l[?2004h> for col in ['Total_Cholesterol','LDL_Cholesterol','HDL_Cholesterol','Non_HDL_Cholesterol']:
[?2004l[?2004h>     convert_cond(raw, col, lambda s: s < 10, 38.67, op='*')                      # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Triglycerides', lambda s: s < 10, 88.57, op='*')              # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Glucose', lambda s: s < 30, 18, op='*')                       # mmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Uric_Acid', lambda s: s > 20, 59.48, op='/')                  # µmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Urine_Creatinine', lambda s: s > 1000, 88.4, op='/')          # µmol/L -> mg/dL
[?2004l[?2004h> convert_cond(raw, 'Albumin_to_Creatinine_Ratio_Urine', lambda s: s < 30, 8.84, op='*')  # mg/mmol -> mg/g
[?2004l[?2004h> convert_cond(raw, 'Protein_to_Creatinine_Ratio_Urine', lambda s: s < 30, 8.84, op='*')  # mg/mmol -> mg/g
[?2004l[?2004h> convert_cond(raw, 'Troponin_I', lambda s: s > 1, 1000, op='/')                   # ng/L -> ng/mL
[?2004l[?2004h> convert_cond(raw, 'Troponin_T', lambda s: s > 1, 1000, op='/')                   # ng/L -> ng/mL
[?2004l[?2004h> convert_cond(raw, 'Free_T4', lambda s: s > 5, 12.87, op='/')                     # pmol/L -> ng/dL
[?2004l[?2004h> convert_cond(raw, 'Free_T3', lambda s: s > 10, 1.536, op='/')                    # pmol/L -> pg/mL
[?2004l[?2004h> convert_cond(raw, 'Lactate', lambda s: s > 10, 9, op='/')                        # mg/dL -> mmol/L (or adjust)
[?2004l[?2004h> 
[?2004l[?2004h> # Format output: patient_id as integer, others as 2-decimal strings
[?2004l[?2004h> raw['patient_id'] = raw['patient_id'].astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> for col in raw.columns:
[?2004l[?2004h>     if col == 'patient_id':
[?2004l[?2004h>         continue
[?2004l[?2004h>     raw[col] = raw[col].map(lambda x: f"{x:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save harmonized data
[?2004l[?2004h> output_path = '/root/ckd_lab_data_harmonized.csv'
[?2004l[?2004h> raw.to_csv(output_path, index=False)
[?2004l[?2004h> print('saved', output_path, 'shape', raw.shape)
[?2004l[?2004h> PY
