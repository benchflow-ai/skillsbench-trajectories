[?2004l[?2004h> # replace commas and convert
[?2004l[?2004h> for col in raw.columns:
[?2004l[?2004h>     if col=='patient_id':
[?2004l[?2004h>         continue
[?2004l[?2004h>     raw[col] = raw[col].str.replace(',', '.', regex=False).str.strip()
[?2004l[?2004h>     raw[col] = pd.to_numeric(raw[col], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # drop rows with any missing
[?2004l[?2004h> raw = raw.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # conversion helper
[?2004l[?2004h> 
[?2004l[?2004h> def convert_cond(df, col, cond, factor, op='*'):
[?2004l[?2004h>     if op=='*':
[?2004l[?2004h>         df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] * factor
[?2004l[?2004h>     else:
[?2004l[?2004h>         df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] / factor
[?2004l[?2004h> 
[?2004l[?2004h> # conversions
[?2004l[?2004h> convert_cond(raw, 'Serum_Creatinine', lambda s: s>20, 88.4, op='/')
[?2004l[?2004h> convert_cond(raw, 'BUN', lambda s: s<5, 2.8, op='*')
[?2004l[?2004h> convert_cond(raw, 'Serum_Calcium', lambda s: s<5, 4, op='*')
[?2004l[?2004h> raw['Ionized_Calcium'] = raw['Ionized_Calcium']*4
[?2004l[?2004h> convert_cond(raw, 'Phosphorus', lambda s: s<2, 3.1, op='*')
[?2004l[?2004h> convert_cond(raw, 'Magnesium', lambda s: s<1, 2.43, op='*')
