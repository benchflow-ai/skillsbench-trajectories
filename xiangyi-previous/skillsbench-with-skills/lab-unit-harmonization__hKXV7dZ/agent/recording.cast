[173.320408, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\nraw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\ndef clean(s):\n    return pd.to_numeric(s.str.replace(',', '.', regex=False).str.strip(), errors='coerce')\n\ncols = ['Serum_Creatinine','BUN','Serum_Calcium','Phosphorus','Magnesium','Hemoglobin','Albumin_Serum','Total_Protein','Prealbumin','Total_Bilirubin','Direct_Bilirubin','Uric_Acid','Vitamin_D_25OH','Vitamin_D_1_25OH','Free_T4','Free_T3','Troponin_I','Troponin_T','Lactate','Serum_Iron','TIBC','Urine_Albumin','Urine_Creatinine','Urine_Protein']\nfor col in cols:\n    v = clean(raw[col])\n    print(col, 'min', v.min(), 'p5', v.quantile(0.05), 'p50', v.quantile(0.5), 'p95', v.quantile(0.95), 'max', v.max())\nPY\n"]
