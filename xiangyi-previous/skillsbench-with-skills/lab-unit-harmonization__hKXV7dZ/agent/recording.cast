[479.290254, "i", "python3 - <<'PY'\nimport pandas as pd\nraw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\ndef clean(s):\n    return pd.to_numeric(s.str.replace(',', '.', regex=False).str.strip(), errors='coerce')\n\ncols = ['Lactate','Troponin_I','Troponin_T','Free_T4','Free_T3','Serum_Iron','TIBC']\nfor col in cols:\n    v=clean(raw[col])\n    if col=='Lactate':\n        for thr in [5,10,20]:\n            print(col,'>thr',thr,(v>thr).sum())\n    elif col in ['Troponin_I','Troponin_T']:\n        for thr in [0.1,1,10,100]:\n            print(col,'>thr',thr,(v>thr).sum())\n    elif col=='Free_T4':\n        for thr in [2,5,10]:\n            print(col,'>thr',thr,(v>thr).sum())\n    elif col=='Free_T3':\n        for thr in [5,10]:\n            print(col,'>thr',thr,(v>thr).sum())\n    elif col in ['Serum_Iron','TIBC']:\n        for thr in [30,50,100]:\n            print(col,'<thr',thr,(v<thr).sum())\nPY\n"]
