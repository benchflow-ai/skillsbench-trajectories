[786.526979, "i", "t_cond(raw, 'Total_Bilirubin', lambda s: s > 5, 17.1, op='/')              # µmol/L -> mg/dL\nconvert_cond(raw, 'Direct_Bilirubin', lambda s: s > 2, 17.1, op='/')             # µmol/L -> mg/dL\nconvert_cond(raw, 'Serum_Iron', lambda s: s < 30, 5.585, op='*')                 # µmol/L -> µg/dL\nconvert_cond(raw, 'TIBC', lambda s: s < 100, 5.585, op='*')                      # µmol/L -> µg/dL\nfor col in ['Total_Cholesterol','LDL_Cholesterol','HDL_Cholesterol','Non_HDL_Cholesterol']:\n    convert_cond(raw, col, lambda s: s < 10, 38.67, op='*')                      # mmol/L -> mg/dL\nconvert_cond(raw, 'Triglycerides', lambda s: s < 10, 88.57, op='*')              # mmol/L -> mg/dL\nconvert_cond(raw, 'Glucose', lambda s: s < 30, 18, op='*')                       # mmol/L -> mg/dL\nconvert_cond(raw, 'Uric_Acid', lambda s: s > 20, 59.48, op='/')                  # µmol/L -> mg/dL\nconvert_cond(raw, 'Urine_Creatinine', lambda s: s > 1000, 88.4, op='/')          # µmol/L -> mg/dL\nconvert_cond(raw, 'Albumin_to_Creatinin"]
[786.52708, "i", "e_Ratio_Urine', lambda s: s < 30, 8.84, op='*')  # mg/mmol -> mg/g\nconvert_cond(raw, 'Protein_to_Creatinine_Ratio_Urine', lambda s: s < 30, 8.84, op='*')  # mg/mmol -> mg/g\nconvert_cond(raw, 'Troponin_I', lambda s: s > 1, 1000, op='/')                   # ng/L -> ng/mL\nconvert_cond(raw, 'Troponin_T', lambda s: s > 1, 1000, op='/')                   # ng/L -> ng/mL\nconvert_cond(raw, 'Free_T4', lambda s: s > 5, 12.87, op='/')                     # pmol/L -> ng/dL\nconvert_cond(raw, 'Free_T3', lambda s: s > 10, 1.536, op='/')                    # pmol/L -> pg/mL\nconvert_cond(raw, 'Lactate', lambda s: s > 10, 9, op='/')                        # mg/dL -> mmol/L (or adjust)\n\n# Format output: patient_id as integer, others as 2-decimal strings\nraw['patient_id'] = raw['patient_id'].astype(int)\n\nfor col in raw.columns:\n    if col == 'patient_id':\n        continue\n    raw[col] = raw[col].map(lambda x: f\"{x:.2f}\")\n\n# Save harmonized data\noutput_path = '/root/ckd_lab_data_harmonized.csv'\nraw.to_csv(output_path, index=False"]
