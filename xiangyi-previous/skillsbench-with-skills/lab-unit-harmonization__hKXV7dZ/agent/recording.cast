[394.977872, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\nraw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\ndef clean(s):\n    return pd.to_numeric(s.str.replace(',', '.', regex=False).str.strip(), errors='coerce')\n\nchecks = {\n    'Serum_Creatinine': ('>20', 20),\n    'BUN': ('<5', 5),\n    'Serum_Calcium': ('<5', 5),\n    'Phosphorus': ('<2', 2),\n    'Magnesium': ('<1', 1),\n    'Hemoglobin': ('>30', 30),\n    'Albumin_Serum': ('>10', 10),\n    'Total_Protein': ('>10', 10),\n    'Prealbumin': ('>100', 100),\n    'Total_Bilirubin': ('>5', 5),\n    'Direct_Bilirubin': ('>2', 2),\n    'Total_Cholesterol': ('<20', 20),\n    'LDL_Cholesterol': ('<20', 20),\n    'HDL_Cholesterol': ('<20', 20),\n    'Non_HDL_Cholesterol': ('<20', 20),\n    'Triglycerides': ('<10', 10),\n    'Glucose': ('<30', 30),\n    'Uric_Acid': ('>20', 20),\n    'Urine_Creatinine': ('>1000', 1000),\n    'Free_T4': ('>5', 5),\n    'Free_T3': ('>10', 10),\n    'Lactate': ('>20', 20)\n}\n\nfor col,(cond,thr) in checks.items():\n    v = clean(raw[col])\n    i"]
[394.977926, "i", "f cond.startswith('>'):\n        count = (v>thr).sum()\n    else:\n        count = (v<thr).sum()\n    print(col, cond, thr, 'count', int(count), 'total', v.notna().sum())\nPY\n"]
