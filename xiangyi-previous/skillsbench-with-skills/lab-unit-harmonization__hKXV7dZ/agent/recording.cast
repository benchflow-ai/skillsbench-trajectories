[786.510627, "i", "python3 - <<'PY'\nimport pandas as pd\n\n# Load data as strings\nraw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\n# Clean numeric formatting: replace commas with dots, strip spaces, convert to numeric\nfor col in raw.columns:\n    if col == 'patient_id':\n        continue\n    raw[col] = raw[col].str.replace(',', '.', regex=False).str.strip()\n    raw[col] = pd.to_numeric(raw[col], errors='coerce')\n\n# Drop rows with any missing values\nraw = raw.dropna()\n\n# Helper for conditional conversion\n\ndef convert_cond(df, col, cond, factor, op='*'):\n    if op == '*':\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] * factor\n    else:\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] / factor\n\n# Unit harmonization conversions\nconvert_cond(raw, 'Serum_Creatinine', lambda s: s > 20, 88.4, op='/')            # µmol/L -> mg/dL\nconvert_cond(raw, 'BUN', lambda s: s < 5, 2.8, op='*')                           # mmol/L -> mg/dL\nconvert_cond(raw, 'Serum_Calcium', lambda s: s < 4, 4, op"]
[786.511115, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data as strings\r\n\u001b[?2004l\r\u001b[?2004h> raw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[786.511147, "i", "='*')                   # mmol/L -> mg/dL\nraw['Ionized_Calcium'] = raw['Ionized_Calcium'] * 4                              # mmol/L -> mg/dL\nconvert_cond(raw, 'Phosphorus', lambda s: s < 2, 3.1, op='*')                    # mmol/L -> mg/dL\nconvert_cond(raw, 'Magnesium', lambda s: s < 1, 2.43, op='*')                    # mmol/L -> mg/dL\nconvert_cond(raw, 'Intact_PTH', lambda s: s < 10, 9.43, op='*')                  # pmol/L -> pg/mL\nconvert_cond(raw, 'Vitamin_D_25OH', lambda s: s > 100, 2.5, op='/')              # nmol/L -> ng/mL\nconvert_cond(raw, 'Vitamin_D_1_25OH', lambda s: s > 100, 2.4, op='/')            # pmol/L -> pg/mL\nconvert_cond(raw, 'Hemoglobin', lambda s: s > 25, 10, op='/')                    # g/L -> g/dL\nconvert_cond(raw, 'Albumin_Serum', lambda s: s > 10, 10, op='/')                 # g/L -> g/dL\nconvert_cond(raw, 'Total_Protein', lambda s: s > 10, 10, op='/')                 # g/L -> g/dL\nconvert_cond(raw, 'Prealbumin', lambda s: s > 100, 10, op='/')                   # mg/L -> mg/dL\nconver"]
