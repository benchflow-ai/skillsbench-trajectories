[724.858087, "i", "python3 - <<'PY'\nimport pandas as pd\nraw = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\nfor col in raw.columns:\n    if col=='patient_id':\n        continue\n    raw[col] = raw[col].str.replace(',', '.', regex=False).str.strip()\n    raw[col] = pd.to_numeric(raw[col], errors='coerce')\nraw = raw.dropna()\n\ndef convert_cond(df, col, cond, factor, op='*'):\n    if op=='*':\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] * factor\n    else:\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] / factor\n\nconvert_cond(raw, 'Serum_Creatinine', lambda s: s>20, 88.4, op='/')\nconvert_cond(raw, 'BUN', lambda s: s<5, 2.8, op='*')\nconvert_cond(raw, 'Serum_Calcium', lambda s: s<4, 4, op='*')\nraw['Ionized_Calcium'] = raw['Ionized_Calcium']*4\nconvert_cond(raw, 'Phosphorus', lambda s: s<2, 3.1, op='*')\nconvert_cond(raw, 'Magnesium', lambda s: s<1, 2.43, op='*')\nconvert_cond(raw, 'Intact_PTH', lambda s: s<10, 9.43, op='*')\nconvert_cond(raw, 'Vitamin_D_25OH', lambda s: s>100, 2.5, op='/')"]
[724.858143, "i", "\nconvert_cond(raw, 'Vitamin_D_1_25OH', lambda s: s>100, 2.4, op='/')\nconvert_cond(raw, 'Hemoglobin', lambda s: s>25, 10, op='/')\nconvert_cond(raw, 'Albumin_Serum', lambda s: s>10, 10, op='/')\nconvert_cond(raw, 'Total_Protein', lambda s: s>10, 10, op='/')\nconvert_cond(raw, 'Prealbumin', lambda s: s>100, 10, op='/')\nconvert_cond(raw, 'Total_Bilirubin', lambda s: s>5, 17.1, op='/')\nconvert_cond(raw, 'Direct_Bilirubin', lambda s: s>2, 17.1, op='/')\nconvert_cond(raw, 'Serum_Iron', lambda s: s<30, 5.585, op='*')\nconvert_cond(raw, 'TIBC', lambda s: s<100, 5.585, op='*')\nfor col in ['Total_Cholesterol','LDL_Cholesterol','HDL_Cholesterol','Non_HDL_Cholesterol']:\n    convert_cond(raw, col, lambda s: s<10, 38.67, op='*')\nconvert_cond(raw, 'Triglycerides', lambda s: s<10, 88.57, op='*')\nconvert_cond(raw, 'Glucose', lambda s: s<30, 18, op='*')\nconvert_cond(raw, 'Uric_Acid', lambda s: s>20, 59.48, op='/')\nconvert_cond(raw, 'Urine_Creatinine', lambda s: s>1000, 88.4, op='/')\nconvert_cond(raw, 'Albumin_to_Creatinine_Ratio_Ur"]
[724.858161, "i", "ine', lambda s: s<30, 8.84, op='*')\nconvert_cond(raw, 'Protein_to_Creatinine_Ratio_Urine', lambda s: s<30, 8.84, op='*')\nconvert_cond(raw, 'Troponin_I', lambda s: s>1, 1000, op='/')\nconvert_cond(raw, 'Troponin_T', lambda s: s>1, 1000, op='/')\nconvert_cond(raw, 'Free_T4', lambda s: s>5, 12.87, op='/')\nconvert_cond(raw, 'Free_T3', lambda s: s>10, 1.536, op='/')\nconvert_cond(raw, 'Lactate', lambda s: s>10, 9, op='/')\n\ncols = ['Serum_Creatinine','BUN','Serum_Calcium','Ionized_Calcium','Phosphorus','Magnesium','Hemoglobin','Albumin_Serum','Total_Protein','Prealbumin','Total_Bilirubin','Direct_Bilirubin','Uric_Acid','Vitamin_D_25OH','Vitamin_D_1_25OH','Free_T4','Free_T3','Troponin_I','Troponin_T','Lactate','Serum_Iron','TIBC','Total_Cholesterol','LDL_Cholesterol','HDL_Cholesterol','Triglycerides','Glucose']\nfor col in cols:\n    v = raw[col]\n    print(col, 'min', v.min(), 'max', v.max())\nprint('rows', raw.shape)\nPY\n"]
