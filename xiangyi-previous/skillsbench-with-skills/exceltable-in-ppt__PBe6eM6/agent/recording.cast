[67.499406, "i", "python3 << 'EOF'\nimport zipfile\nimport os\n\n# Repack the PPTX file\npptx_dir = '/root/pptx_extracted'\npptx_output = '/root/results.pptx'\n\n# Remove old pptx if exists\nif os.path.exists(pptx_output):\n    os.remove(pptx_output)\n\n# Create new pptx\nwith zipfile.ZipFile(pptx_output, 'w', zipfile.ZIP_DEFLATED) as zf:\n    for root, dirs, files in os.walk(pptx_dir):\n        for file in files:\n            file_path = os.path.join(root, file)\n            arc_name = os.path.relpath(file_path, pptx_dir)\n            zf.write(file_path, arc_name)\n\nprint(f\"PPTX file created: {pptx_output}\")\nprint(f\"Size: {os.path.getsize(pptx_output)} bytes\")\nEOF\n"]
