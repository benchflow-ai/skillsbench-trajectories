[59.970716, "i", "python3 << 'EOF'\nimport zipfile\nimport os\n\n# Repack the Excel file\nexcel_dir = '/root/excel_extracted'\nexcel_output = '/root/pptx_extracted/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx'\n\n# Remove old xlsx\nif os.path.exists(excel_output):\n    os.remove(excel_output)\n\n# Create new xlsx\nwith zipfile.ZipFile(excel_output, 'w', zipfile.ZIP_DEFLATED) as zf:\n    for root, dirs, files in os.walk(excel_dir):\n        for file in files:\n            file_path = os.path.join(root, file)\n            arc_name = os.path.relpath(file_path, excel_dir)\n            zf.write(file_path, arc_name)\n\nprint(f\"Excel file repacked: {excel_output}\")\nprint(f\"Size: {os.path.getsize(excel_output)} bytes\")\nEOF\n"]
