[311.05388, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.053957, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.054033, "o", "    with open(\"report.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
