[311.05197, "o", "        f = line[\"from\"]\r\n"]
[311.05203, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.052085, "o", "        t = line[\"to\"]\r\n\u001b[?2004l\r"]
[311.052152, "o", "\u001b[?2004h> "]
[311.05231, "o", "        if (f == 64 and t == 1501) or (f == 1501 and t == 64):\r\n"]
[311.052368, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.052467, "o", "            congestion_relieved = False\r\n"]
[311.052521, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.052574, "o", "            break\r\n\u001b[?2004l\r"]
[311.05264, "o", "\u001b[?2004h> "]
[311.052696, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.052753, "o", "    report = {\r\n\u001b[?2004l\r"]
[311.052807, "o", "\u001b[?2004h> "]
