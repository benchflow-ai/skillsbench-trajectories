[311.040396, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[311.040449, "o", "> "]
[311.040568, "o", "    reserve_constr = (cp.sum(Rg) >= reserve_req)"]
[311.040625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.040725, "o", "    constraints.append(reserve_constr)\r\n\u001b[?2004l\r"]
