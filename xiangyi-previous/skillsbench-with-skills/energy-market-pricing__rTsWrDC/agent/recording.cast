[311.040116, "o", "    constraints.append(Rg <= reserve_cap)\r\n"]
[311.040182, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.040291, "o", "    constraints.append(Pg + Rg <= Pmax)"]
