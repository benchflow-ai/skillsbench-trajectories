[311.053227, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.05339, "o", "            \"cost_reduction_dollars_per_hour\": round(cost_red, 2),"]
[311.053445, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
