[311.040842, "o", "\u001b[?2004h> "]
[311.040902, "o", "    c2 = np.zeros(ng)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.040959, "o", "    c1 = np.zeros(ng)\r\n\u001b[?2004l\r"]
[311.041014, "o", "\u001b[?2004h> "]
[311.041075, "o", "    c0 = np.zeros(ng)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041133, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041191, "o", "    for i in range(ng):\r\n\u001b[?2004l\r"]
[311.041251, "o", "\u001b[?2004h> "]
[311.041313, "o", "        gc = gencost[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041371, "o", "        n = int(gc[3])\r\n\u001b[?2004l\r"]
[311.041429, "o", "\u001b[?2004h> "]
[311.041508, "o", "        if n == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041582, "o", "            c2[i] = gc[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.04165, "o", "            c1[i] = gc[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041723, "o", "            c0[i] = gc[6]\r\n\u001b[?2004l\r"]
[311.041784, "o", "\u001b[?2004h> "]
[311.041868, "o", "        elif n == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041931, "o", "            c1[i] = gc[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.041993, "o", "            c0[i] = gc[5]\r\n"]
[311.042049, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.042111, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.042252, "o", "    obj = cp.sum(c2 * cp.square(Pg) + c1 * Pg + c0)"]
[311.04231, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[311.042372, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.042521, "o", "    problem = cp.Problem(cp.Minimize(obj), constraints)"]
[311.042579, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
