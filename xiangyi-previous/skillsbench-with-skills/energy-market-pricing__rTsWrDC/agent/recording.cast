[311.03771, "o", ">             \r\n\u001b[?2004l\r"]
[311.03776, "o", "\u001b[?2004h> "]
[311.037834, "o", "        row_f.append(len(limit_vec))\r\n"]
[311.037886, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.037948, "o", "        col_f.append(f_idx)\r\n\u001b[?2004l\r"]
[311.038001, "o", "\u001b[?2004h> "]
[311.03805, "o", "        data_f.append(1.0/x)\r\n\u001b[?2004l\r"]
[311.038101, "o", "\u001b[?2004h>         "]
[311.038151, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.038246, "o", "        row_f.append(len(limit_vec))\r\n"]
[311.038296, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.038386, "o", "        col_f.append(t_idx)\r\n"]
[311.038437, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[311.038527, "o", "        data_f.append(-1.0/x)"]
[311.038577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.038659, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
