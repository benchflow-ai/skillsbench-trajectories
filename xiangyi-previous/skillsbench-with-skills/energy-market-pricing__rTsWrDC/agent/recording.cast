[161.062083, "i", "python3 -c \"import json; \nwith open('network.json') as f: data = json.load(f); \nprint('Reserve Req:', data['reserve_requirement']); \nrc = data['reserve_capacity']; \nprint('Reserve Cap Type:', type(rc)); \nprint('Reserve Cap Len:', len(rc) if isinstance(rc, list) else 'N/A'); \nprint('Reserve Cap Sample:', rc[:5] if isinstance(rc, list) else rc); \nprint('Gencost Sample:', data['gencost'][0]);\"\n"]
