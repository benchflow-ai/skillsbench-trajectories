[27.540872, "i", "cat > explore_pptx.py << 'EOF'\nfrom pptx import Presentation\nimport os\n\n# Load the presentation\nprs = Presentation('/root/input.pptx')\n\nprint(f\"Number of slides: {len(prs.slides)}\")\nprint()\n\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"\\n=== Slide {slide_idx + 1} ===\")\n    print(f\"Number of shapes: {len(slide.shapes)}\")\n    \n    for shape_idx, shape in enumerate(slide.shapes):\n        print(f\"\\nShape {shape_idx}: {shape.shape_type}\")\n        print(f\"  Name: {shape.name}\")\n        \n        # Check if it's a text box\n        if hasattr(shape, 'text'):\n            print(f\"  Text: {shape.text[:100]}\")\n        \n        # Check if it's an embedded object\n        if shape.shape_type == 7:  # EMBEDDED_OLE_OBJECT\n            print(f\"  -> This is an embedded OLE object\")\n            if hasattr(shape, 'ole_format'):\n                print(f\"     Program ID: {shape.ole_format.prog_id if hasattr(shape.ole_format, 'prog_id') else 'N/A'}\")\n        \n        # Check if it's a table\n        if shape.shape_type == 19:  # TABLE\n            print(f\"  -> This is a table\")\n            if hasattr(shape, 'table'):\n                print(f\"     Rows: {len(shape.table.rows)}, Columns: {len(shape.table.columns)}\")\nEOF\n"]
