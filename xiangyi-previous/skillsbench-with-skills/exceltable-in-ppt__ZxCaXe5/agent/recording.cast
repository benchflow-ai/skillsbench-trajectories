[38.665117, "i", "cat > extract_excel.py << 'EOF'\nfrom pptx import Presentation\nfrom pptx.util import Inches\nimport zipfile\nimport os\nimport shutil\n\n# Extract the PPTX to examine its structure\nwith zipfile.ZipFile('/root/input.pptx', 'r') as zip_ref:\n    zip_ref.extractall('/root/pptx_extracted')\n\nprint(\"Extracted PPTX contents:\")\nfor root, dirs, files in os.walk('/root/pptx_extracted'):\n    level = root.replace('/root/pptx_extracted', '').count(os.sep)\n    indent = ' ' * 2 * level\n    print(f'{indent}{os.path.basename(root)}/')\n    subindent = ' ' * 2 * (level + 1)\n    for file in files:\n        print(f'{subindent}{file}')\n        if 'embed' in file.lower() or file.endswith('.xlsx') or file.endswith('.bin'):\n            print(f'{subindent}  -> Possible embedded object!')\nEOF\n"]
