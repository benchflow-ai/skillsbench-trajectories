[88.78326, "i", "cat > verify_results.py << 'EOF'\nfrom pptx import Presentation\nimport zipfile\nimport openpyxl\nimport os\n\nprint(\"=== Verifying results.pptx ===\")\nprint(f\"File exists: {os.path.exists('/root/results.pptx')}\")\nprint(f\"File size: {os.path.getsize('/root/results.pptx')} bytes\")\n\n# Load the presentation\nprint(\"\\n=== Loading presentation ===\")\nprs = Presentation('/root/results.pptx')\nprint(f\"Number of slides: {len(prs.slides)}\")\n\n# Check shapes\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"\\nSlide {slide_idx + 1}:\")\n    for shape_idx, shape in enumerate(slide.shapes):\n        print(f\"  Shape {shape_idx}: {shape.name}\")\n        if hasattr(shape, 'text') and shape.text:\n            print(f\"    Text: {shape.text}\")\n\n# Extract and verify the Excel file\nprint(\"\\n=== Extracting and verifying Excel data ===\")\nwith zipfile.ZipFile('/root/results.pptx', 'r') as zip_ref:\n    zip_ref.extract('ppt/embeddings/Microsoft_Excel_Worksheet.xlsx', '/root/verify_temp')\n\nwb = openpyxl.load_workbook('/root/verify_temp/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nws = wb['Sheet1']\n\nprint(\"\\nUpdated Exchange Rate Table:\")\nfor row_idx in range(1, 6):\n    row_str = []\n    for col_idx in range(1, 6):\n        cell = ws.cell(row=row_idx, column=col_idx)\n        if cell.data_type == 'f':\n            row_str.append(f\"[F]\")\n        else:\n            row_str.append(str(cell.value) if cell.value is not None else \"\")\n    print(f\"  {' | '.join(row_str)}\")\n\nprint(f\"\\nKey verification:\")\nprint(f\"  B3 (USD to CNY): {ws['B3'].value} (type: {ws['B3'].data_type})\")\nprint(f\"  C2 (formula): {ws['C2'].value} (type: {ws['C2'].data_type})\")\nprint(f\"  D3 (formula): {ws['D3'].value} (type: {ws['D3'].data_type})\")\n\nprint(\"\\n=== Verification complete ===\")\nif ws['B3'].value == 7.02 and ws['C2'].data_type == 'f':\n    print(\"✓ SUCCESS: USD to CNY rate updated to 7.02 and formulas preserved!\")\nelse:\n    print(\"✗ FAILED: Something went wrong\")\nEOF\n"]
