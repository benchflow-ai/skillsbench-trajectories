[157.130754, "o", "{\"total_count\":50,\"incomplete_results\":false,\"items\":[{\"url\":\"https://api.github.com/repos/cli/cli/issues/10154\",\"repository_url\":\"https://api.github.com/repos/cli/cli\",\"labels_url\":\"https://api.github.com/repos/cli/cli/issues/10154/labels{/name}\",\"comments_url\":\"https://api.github.com/repos/cli/cli/issues/10154/comments\",\"events_url\":\"https://api.github.com/repos/cli/cli/issues/10154/events\",\"html_url\":\"https://github.com/cli/cli/pull/10154\",\"id\":2763799392,\"node_id\":\"PR_kwDODKw3uc6GdxQ1\",\"number\":10154,\"title\":\"gh gist delete: prompt for gist id\",\"user\":{\"login\":\"danochoa\",\"id\":11418369,\"node_id\":\"MDQ6VXNlcjExNDE4MzY5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/11418369?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/danochoa\",\"html_url\":\"https://github.com/danochoa\",\"followers_url\":\"https://api.github.com/users/danochoa/followers\",\"following_url\":\"https://api.github.com/users/danochoa/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/danochoa/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/danochoa/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/danochoa/subscriptions\",\"organizations_url\":\"https://api.github.com/users/danochoa/orgs\",\"repos_url\":\"https://api.github.com/users/danochoa/repos\",\"events_url\":\"https://api.github.com/users/danochoa/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/danochoa/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"labels\":[{\"id\":3581582503,\"node_id\":\"LA_kwDODKw3uc7Vepyn\",\"url\":\"https://api.github.com/repos/cli/cli/labels/external\",\"name\":\"external\",\"color\":\"2700AF\",\"default\":false,\"description\":\"pull request originating outside of the CLI core team\"}],\"state\":\"closed\",\"locked\":false,\"assignee\":null,\"assignees\":[],\"milestone\":null,\"comments\":4,\"created_at\":\"2024-12-30T23:29:25Z\",\"updated_at\":\"2025-01-14T22:42:14Z\",\"closed_at\":\"2025-01-14T22:42:14Z\",\"author_association\":\"CONTRIBUTOR\",\"type\":null,\"active_lock_reason\":null,\"draft\":false,\"pull_request\":{\"url\":"]
[157.131181, "o", "\"https://api.github.com/repos/cli/cli/pulls/10154\",\"html_url\":\"https://github.com/cli/cli/pull/10154\",\"diff_url\":\"https://github.com/cli/cli/pull/10154.diff\",\"patch_url\":\"https://github.com/cli/cli/pull/10154.patch\",\"\u001b[01;31m\u001b[Kmerged_at\u001b[m\u001b[K\":\"2025-01-14T22:42:14Z\"},\"body\":\"Fixes #10073.\\r\\n\\r\\nThis changes `gh gist delete` to prompt the user to select a gist when no args are passed, instead of returning a message with usage info. And adds a confirm flag to prompt for confirmation. The code for prompting is already used by other commands (used `gh gist view` and `gh repo delete` for reference).\",\"reactions\":{\"url\":\"https://api.github.com/repos/cli/cli/issues/10154/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"timeline_url\":\"https://api.github.com/repos/cli/cli/issues/10154/timeline\",\"performed_via_github_app\":null,\"state_reason\":null,\"score\":1.0}]}\r\n"]
[157.131554, "o", "\u001b[?2004hroot@fe4edd809eae:/app# "]
[206.413665, "i", "cat << 'EOF' > generate_report.py\nimport urllib.request\nimport urllib.parse\nimport json\nimport datetime\nimport sys\nimport time\n\ndef get_json(url):\n    req = urllib.request.Request(url)\n    req.add_header('User-Agent', 'python-script')\n    try:\n        with urllib.request.urlopen(req) as response:\n            return json.loads(response.read())\n    except Exception as e:\n        print(f\"Error fetching {url}: {e}\", file=sys.stderr)\n        return None\n\ndef search_github(query):\n    items = []\n    page = 1\n    while True:\n        time.sleep(2)  # Rate limit niceness\n        params = {'q': query, 'per_page': 100, 'page': page}\n        query_string = urllib.parse.urlencode(params)\n        url = f\"https://api.github.com/search/issues?{query_string}\"\n        print(f\"Fetching page {page} for query: {query}\")\n        data = get_json(url)\n        if not data:\n            break\n        page_items = data.get('items', [])\n        items.extend(page_items)\n        if len(items) >= data.get('total_count', 0) or len(page_items) == 0:\n            break\n        page += 1\n    return items\n\ndef is_bug(issue):\n    labels = issue.get('labels', [])\n    for l in labels:\n        if 'bug' in l['name'].lower():\n            return True\n    return False\n\ndef parse_time(t_str):\n    return datetime.datetime.strptime(t_str, \"%Y-%m-%dT%H:%M:%SZ\")\n\ndef main():\n    # 1. PRs created in Dec\n    print(\"Fetching PRs...\")\n    prs = search_github(\"repo:cli/cli is:pr created:2024-12-01..2024-12-31\")\n    \n    pr_total = len(prs)\n    pr_merged = 0\n    pr_closed = 0\n    merge_times = []\n    authors = {}\n\n    for pr in prs:\n        user = pr.get('user', {}).get('login')\n        if user:\n            authors[user] = authors.get(user, 0) + 1\n            \n        pr_details = pr.get('pull_request', {})\n        merged_at_str = pr_details.get('merged_at')\n        \n        if merged_at_str:\n            pr_merged += 1\n            created_at = parse_time(pr['created_at'])\n            merged_at = parse_time(merged_at_str)\n            delta = merged_at - created_at\n            merge_times.append(delta.total_seconds() / 86400.0)\n        elif pr['state'] == 'closed':\n            pr_closed += 1\n\n    avg_merge_days = 0.0\n    if merge_times:\n        avg_merge_days = sum(merge_times) / len(merge_times)\n    \n    top_contributor = \"\"\n    if authors:\n        top_contributor = max(authors, key=authors.get)\n\n    # 2. Issues created in Dec\n    print(\"Fetching Created Issues...\")\n    issues_created = search_github(\"repo:cli/cli is:issue created:2024-12-01..2024-12-31\")\n    issue_total = len(issues_created)\n    issue_bug_created = sum(1 for i in issues_created if is_bug(i))\n\n    # 3. Issues closed in Dec\n    print(\"Fetching Closed Issues...\")\n    issues_closed = search_github(\"repo:cli/cli is:issue closed:2024-12-01..2024-12-31\")\n    issue_bug_closed = sum(1 for i in issues_closed if is_bug(i))\n\n    report = {\n        \"pr\": {\n            \"total\": pr_total,\n            \"merged\": pr_merged,\n            \"closed\": pr_closed,\n            \"avg_merge_days\": round(avg_merge_days, 1),\n            \"top_contributor\": top_contributor\n        },\n        \"issue\": {\n            \"total\": issue_total,\n            \"bug\": issue_bug_created,\n            \"resolved_bugs\": issue_bug_closed\n        }\n    }\n\n    print(\"Writing report...\")\n    with open('/app/report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Done.\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
