[206.422924, "o", "            delta = merged_at - created_at\r\n\u001b[?2004l\r"]
[206.422957, "o", "\u001b[?2004h> "]
[206.423139, "o", "            merge_times.append(delta.total_seconds() / 86400.0)\r\n\u001b[?2004l\r"]
[206.423171, "o", "\u001b[?2004h> "]
[206.423297, "o", "        elif pr['state'] == 'closed':\r\n\u001b[?2004l\r"]
[206.423327, "o", "\u001b[?2004h> "]
[206.423418, "o", "            pr_closed += 1\r\n\u001b[?2004l\r"]
[206.423462, "o", "\u001b[?2004h> \r\n"]
[206.423493, "o", "\u001b[?2004l\r\u001b[?2004h"]
[206.423541, "o", "> "]
[206.423626, "o", "    avg_merge_days = 0.0\r\n\u001b[?2004l\r"]
[206.423665, "o", "\u001b[?2004h> "]
[206.423698, "o", "    if merge_times:\r\n\u001b[?2004l\r"]
[206.423734, "o", "\u001b[?2004h> "]
[206.423903, "o", "        avg_merge_days = sum(merge_times) / len(merge_times)\r\n\u001b[?2004l\r"]
[206.423936, "o", "\u001b[?2004h> "]
[206.423976, "o", "    \r\n\u001b[?2004l\r"]
[206.42401, "o", "\u001b[?2004h> "]
[206.424106, "o", "    top_contributor = \"\"\r\n\u001b[?2004l\r"]
[206.424146, "o", "\u001b[?2004h"]
[206.424182, "o", "> "]
[206.424233, "o", "    if authors:\r\n\u001b[?2004l\r"]
[206.42428, "o", "\u001b[?2004h> "]
[206.424464, "o", "        top_contributor = max(authors, key=authors.get)\r\n\u001b[?2004l\r"]
[206.424504, "o", "\u001b[?2004h> "]
[206.424555, "o", "\r\n\u001b[?2004l\r"]
[206.424592, "o", "\u001b[?2004h> "]
[206.424695, "o", "    # 2. Issues created in Dec\r\n\u001b[?2004l\r"]
[206.424743, "o", "\u001b[?2004h> "]
[206.424882, "o", "    print(\"Fetching Created Issues...\")\r\n\u001b[?2004l\r"]
[206.424922, "o", "\u001b[?2004h> "]
[206.425151, "o", "    issues_created = search_github(\"repo:cli/cli is:issue created:2024-12-01..2024-12-31\")\r\n\u001b[?2004l\r"]
[206.425199, "o", "\u001b[?2004h> "]
[206.425327, "o", "    issue_total = len(issues_created)\r\n\u001b[?2004l\r"]
[206.425367, "o", "\u001b[?2004h> "]
[206.425579, "o", "    issue_bug_created = sum(1 for i in issues_created if is_bug(i))\r\n\u001b[?2004l\r"]
[206.425613, "o", "\u001b[?2004h> "]
[206.425645, "o", "\r\n\u001b[?2004l\r"]
[206.425679, "o", "\u001b[?2004h> "]
[206.425911, "o", "    # 3. Issues closed in Dec\r\n\u001b[?2004l\r"]
[206.425981, "o", "\u001b[?2004h> "]
[206.426112, "o", "    print(\"Fetching Closed Issues...\")\r\n\u001b[?2004l\r"]
[206.426153, "o", "\u001b[?2004h> "]
[206.426427, "o", "    issues_closed = search_github(\"repo:cli/cli is:issue closed:2024-12-01..2024-12-31\")\r\n\u001b[?2004l\r"]
[206.426466, "o", "\u001b[?2004h> "]
[206.426671, "o", "    issue_bug_closed = sum(1 for i in issues_closed if is_bug(i))\r\n\u001b[?2004l\r"]
[206.426716, "o", "\u001b[?2004h> "]
[206.426759, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.426797, "o", "> "]
[206.426843, "o", "    report = {\r\n\u001b[?2004l\r"]
[206.426876, "o", "\u001b[?2004h"]
[206.42691, "o", "> "]
[206.426958, "o", "        \"pr\": {\r\n\u001b[?2004l\r"]
[206.426995, "o", "\u001b[?2004h> "]
[206.42711, "o", "            \"total\": pr_total,\r\n\u001b[?2004l\r"]
[206.427154, "o", "\u001b[?2004h> "]
[206.42725, "o", "            \"merged\": pr_merged,\r\n"]
[206.427282, "o", "\u001b[?2004l\r\u001b[?2004h"]
[206.427315, "o", "> "]
[206.427416, "o", "            \"closed\": pr_closed,\r\n\u001b[?2004l\r"]
[206.427454, "o", "\u001b[?2004h> "]
[206.427631, "o", "            \"avg_merge_days\": round(avg_merge_days, 1),\r\n\u001b[?2004l\r"]
[206.427669, "o", "\u001b[?2004h> "]
[206.427817, "o", "            \"top_contributor\": top_contributor\r\n\u001b[?2004l\r"]
[206.427849, "o", "\u001b[?2004h> "]
[206.427909, "o", "        },\r\n\u001b[?2004l\r"]
[206.427941, "o", "\u001b[?2004h> "]
[206.428031, "o", "        \"issue\": {\r\n\u001b[?2004l\r"]
[206.42807, "o", "\u001b[?2004h"]
[206.428104, "o", "> "]
[206.428195, "o", "            \"total\": issue_total,\r\n\u001b[?2004l\r"]
[206.428235, "o", "\u001b[?2004h> "]
[206.428372, "o", "            \"bug\": issue_bug_created,\r\n\u001b[?2004l\r"]
[206.428405, "o", "\u001b[?2004h"]
[206.428512, "o", "> "]
[206.428654, "o", "            \"resolved_bugs\": issue_bug_closed\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.428708, "o", ">         }\r\n\u001b[?2004l\r"]
[206.428746, "o", "\u001b[?2004h> "]
[206.428775, "o", "    }\r\n\u001b[?2004l\r"]
[206.428819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[206.428854, "o", "\u001b[?2004h> "]
[206.429009, "o", "    print(\"Writing report...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.429134, "o", "    with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[206.429182, "o", "\u001b[?2004h> "]
[206.429307, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r"]
[206.429343, "o", "\u001b[?2004h> "]
[206.429403, "o", "    print(\"Done.\")\r\n\u001b[?2004l\r"]
[206.429438, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[206.429489, "o", "\u001b[?2004h> "]
[206.429583, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[206.429628, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
