[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     if isinstance(val, str):
[?2004l[?2004h>         val = val.replace(',', '.')
[?2004l[?2004h>         try:
[?2004l[?2004h>             return float(val)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             return np.nan
[?2004l[?2004h>     return float(val)
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     df[col] = df[col].apply(clean_value)
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # Unit Harmonization
[?2004l[?2004h> # Serum_Creatinine (mg/dL): 0.7-1.3, CKD up to 20
[?2004l[?2004h> df.loc[df['Serum_Creatinine'] > 50, 'Serum_Creatinine'] /= 88.4
[?2004l[?2004h> 
[?2004l[?2004h> # BUN (mg/dL): 7-20, CKD up to 200
[?2004l[?2004h> df.loc[df['BUN'] < 5, 'BUN'] /= 0.357
[?2004l[?2004h> 
[?2004l[?2004h> # Serum_Calcium (mg/dL): 8.5-10.5
[?2004l[?2004h> # If < 3, likely mmol/L (factor 4). If 3-7, likely mEq/L (factor 2).
[?2004l[?2004h> df.loc[df['Serum_Calcium'] < 3.0, 'Serum_Calcium'] *= 4.0
[?2004l[?2004h> df.loc[(df['Serum_Calcium'] >= 3.0) & (df['Serum_Calcium'] < 7.0), 'Serum_Calcium'] *= 2.0
[?2004l[?2004h> 
[?2004l[?2004h> # Phosphorus (mg/dL): 2.5-4.5
[?2004l[?2004h> df.loc[df['Phosphorus'] < 2.0, 'Phosphorus'] *= 3.1
[?2004l[?2004h> 
[?2004l[?2004h> # Hemoglobin (g/dL): 12-16
[?2004l[?2004h> df.loc[df['Hemoglobin'] > 30, 'Hemoglobin'] /= 10.0
[?2004l[?2004h> df.loc[df['Hemoglobin'] < 5.0, 'Hemoglobin'] *= 1.61
[?2004l[?2004h> df.loc[df['Hemoglobin'] < 5.0, 'Hemoglobin'] *= 4.0
[?2004l[?2004h> 
[?2004l[?2004h> # Albumin_Serum (g/dL): 3.5-5.0
[?2004l[?2004h> df.loc[df['Albumin_Serum'] > 10, 'Albumin_Serum'] /= 10.0
[?2004l[?2004h> 
[?2004l[?2004h> # Total_Protein (g/dL): 6-8
[?2004l[?2004h> df.loc[df['Total_Protein'] > 15, 'Total_Protein'] /= 10.0
[?2004l[?2004h> 
[?2004l[?2004h> # Glucose (mg/dL): 70-100
[?2004l[?2004h> df.loc[df['Glucose'] < 25, 'Glucose'] *= 18.0
[?2004l[?2004h> 
[?2004l[?2004h> # Uric_Acid (mg/dL): 3-7
