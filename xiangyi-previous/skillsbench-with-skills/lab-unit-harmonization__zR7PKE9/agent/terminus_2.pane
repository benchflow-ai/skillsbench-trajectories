[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> def harmonize(row):
[?2004l[?2004h>     # Serum_Creatinine (mg/dL): 0.7-1.3, CKD up to 20
[?2004l[?2004h>     if row['Serum_Creatinine'] > 50: row['Serum_Creatinine'] /= 88.4
[?2004l[?2004h>     elif row['Serum_Creatinine'] < 0.5: row['Serum_Creatinine'] *= 1.0 # too low?
[?2004l[?2004h>     
[?2004l[?2004h>     # BUN (mg/dL): 7-20, CKD up to 200
[?2004l[?2004h>     if row['BUN'] < 5: row['BUN'] /= 0.357
[?2004l[?2004h> 
[?2004l[?2004h>     # Serum_Calcium (mg/dL): 8.5-10.5
[?2004l[?2004h>     if 2.0 <= row['Serum_Calcium'] < 5.0: row['Serum_Calcium'] *= 4.0
[?2004l[?2004h>     elif row['Serum_Calcium'] < 2.0: row['Serum_Calcium'] *= 4.0 # possibly mmol/L
[?2004l[?2004h>     elif row['Serum_Calcium'] > 15: row['Serum_Calcium'] /= 1.0 # already high
[?2004l[?2004h>     
[?2004l[?2004h>     # Phosphorus (mg/dL): 2.5-4.5
[?2004l[?2004h>     if row['Phosphorus'] < 2.0: row['Phosphorus'] *= 3.1
[?2004l[?2004h> 
[?2004l[?2004h>     # Hemoglobin (g/dL): 12-16
[?2004l[?2004h>     if row['Hemoglobin'] > 30: row['Hemoglobin'] /= 10.0
[?2004l[?2004h>     elif row['Hemoglobin'] < 8.0: 
[?2004l[?2004h>         if row['Hemoglobin'] * 1.61 > 8.0:
[?2004l[?2004h>             row['Hemoglobin'] *= 1.61
[?2004l[?2004h>         elif row['Hemoglobin'] * 6.2 > 8.0:
[?2004l[?2004h>             row['Hemoglobin'] *= 6.2 # mmol/L to g/dL factor is ~6.2 for Hb
[?2004l[?2004h> 
[?2004l[?2004h>     # Albumin_Serum (g/dL): 3.5-5.0
[?2004l[?2004h>     if row['Albumin_Serum'] > 10: row['Albumin_Serum'] /= 10.0
[?2004l[?2004h>     elif row['Albumin_Serum'] < 2.0: row['Albumin_Serum'] *= 1.0 # keep as is or adjust?
[?2004l[?2004h> 
[?2004l[?2004h>     # Glucose (mg/dL): 70-100
[?2004l[?2004h>     if row['Glucose'] < 20: row['Glucose'] *= 18.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Uric_Acid (mg/dL): 3-7
[?2004l[?2004h>     if row['Uric_Acid'] > 50: row['Uric_Acid'] /= 16.8
[?2004l[?2004h> 
[?2004l[?2004h>     # Cholesterol (mg/dL): < 200
[?2004l[?2004h>     for col in ['Total_Cholesterol', 'LDL_Cholesterol', 'HDL_Cholesterol', 'Triglycerides', 'Non_HDL_Cholesterol']:
[?2004l[?2004h>         if row[col] < 15: 
[?2004l[?2004h>             if 'Triglycerides' in col:
[?2004l[?2004h>                 row[col] *= 88.5
[?2004l[?2004h>             else:
[?2004l[?2004h>                 row[col] *= 38.6
[?2004l[?2004h> 
[?2004l[?2004h>     # Bilirubin (mg/dL): 0.1-1.2
[?2004l[?2004h>     if row['Total_Bilirubin'] > 5: row['Total_Bilirubin'] /= 17.1
[?2004l[?2004h>     if row['Direct_Bilirubin'] > 5: row['Direct_Bilirubin'] /= 17.1
[?2004l[?2004h> 
[?2004l[?2004h>     # Serum_Iron (ug/dL): 60-170
[?2004l[?2004h>     if row['Serum_Iron'] < 20: row['Serum_Iron'] *= 5.59 # umol/L to ug/dL
[?2004l[?2004h>     
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> df = df.apply(harmonize, axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # Round and format
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
