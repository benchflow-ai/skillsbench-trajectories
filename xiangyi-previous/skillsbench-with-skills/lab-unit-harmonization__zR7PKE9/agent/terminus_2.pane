[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     if isinstance(val, str):
[?2004l[?2004h>         val = val.replace(',', '.')
[?2004l[?2004h>         try:
[?2004l[?2004h>             return float(val)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             return np.nan
[?2004l[?2004h>     return float(val)
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> def harmonize(row):
[?2004l[?2004h>     # Serum_Creatinine (mg/dL): normal 0.7-1.3, CKD up to 20.
[?2004l[?2004h>     # if > 50, likely umol/L. 
[?2004l[?2004h>     if row['Serum_Creatinine'] > 50: row['Serum_Creatinine'] /= 88.4
[?2004l[?2004h>     
[?2004l[?2004h>     # BUN (mg/dL): normal 7-20, CKD up to 200.
[?2004l[?2004h>     # If < 5 and Creatinine is high, likely mmol/L.
[?2004l[?2004h>     if row['BUN'] < 5 and row['Serum_Creatinine'] > 2: row['BUN'] /= 0.357
[?2004l[?2004h> 
[?2004l[?2004h>     # Serum_Calcium (mg/dL): normal 8.5-10.5.
[?2004l[?2004h>     # If < 5, likely mmol/L.
[?2004l[?2004h>     if row['Serum_Calcium'] < 5: row['Serum_Calcium'] *= 4.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Phosphorus (mg/dL): normal 2.5-4.5.
[?2004l[?2004h>     # If < 2, likely mmol/L.
[?2004l[?2004h>     if row['Phosphorus'] < 2: row['Phosphorus'] *= 3.1
[?2004l[?2004h> 
[?2004l[?2004h>     # Magnesium (mg/dL): normal 1.7-2.2.
[?2004l[?2004h>     # If < 1.2, likely mmol/L.
[?2004l[?2004h>     if row['Magnesium'] < 1.2: row['Magnesium'] *= 2.43
[?2004l[?2004h> 
[?2004l[?2004h>     # Hemoglobin (g/dL): normal 12-16.
[?2004l[?2004h>     # If > 30, likely g/L.
[?2004l[?2004h>     if row['Hemoglobin'] > 30: row['Hemoglobin'] /= 10.0
[?2004l[?2004h>     # If Hemoglobin < 5, likely mmol/L.
[?2004l[?2004h>     if row['Hemoglobin'] < 5: row['Hemoglobin'] *= 1.61
[?2004l[?2004h> 
[?2004l[?2004h>     # Albumin_Serum (g/dL): normal 3.5-5.0.
[?2004l[?2004h>     if row['Albumin_Serum'] > 10: row['Albumin_Serum'] /= 10.0
[?2004l[?2004h>     elif row['Albumin_Serum'] < 1.0: row['Albumin_Serum'] *= 1.0 # already g/dL?
[?2004l[?2004h>     
[?2004l[?2004h>     # Total_Protein (g/dL): normal 6-8.
[?2004l[?2004h>     if row['Total_Protein'] > 15: row['Total_Protein'] /= 10.0
[?2004l[?2004h> 
[?2004l[?2004h>     # Glucose (mg/dL): normal 70-100.
[?2004l[?2004h>     if row['Glucose'] < 25: row['Glucose'] *= 18.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Uric_Acid (mg/dL): normal 3-7.
[?2004l[?2004h>     if row['Uric_Acid'] > 50: row['Uric_Acid'] /= 16.8
[?2004l[?2004h> 
[?2004l[?2004h>     # Cholesterol (mg/dL): normal < 200.
[?2004l[?2004h>     for col in ['Total_Cholesterol', 'LDL_Cholesterol', 'HDL_Cholesterol', 'Triglycerides', 'Non_HDL_Cholesterol']:
[?2004l[?2004h>         if row[col] < 15: 
[?2004l[?2004h>             if 'Triglycerides' in col:
[?2004l[?2004h>                 row[col] *= 88.5
[?2004l[?2004h>             else:
[?2004l[?2004h>                 row[col] *= 38.6
[?2004l[?2004h> 
[?2004l[?2004h>     # Bilirubin (mg/dL): normal 0.1-1.2.
[?2004l[?2004h>     if row['Total_Bilirubin'] > 5: row['Total_Bilirubin'] /= 17.1
[?2004l[?2004h>     if row['Direct_Bilirubin'] > 5: row['Direct_Bilirubin'] /= 17.1
[?2004l[?2004h> 
[?2004l[?2004h>     # Serum_Iron (ug/dL): normal 60-170.
[?2004l[?2004h>     if row['Serum_Iron'] < 20: row['Serum_Iron'] *= 55.8 # umol/L to ug/dL
[?2004l[?2004h>     
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> df = df.apply(harmonize, axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # Round to 2 decimal places and format as X.XX
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(lambda x: "{:.2f}".format(x))
[?2004l[?2004h>     else:
[?2004l[?2004h>         df[col] = df[col].astype(int)
[?2004l[?2004h> 
