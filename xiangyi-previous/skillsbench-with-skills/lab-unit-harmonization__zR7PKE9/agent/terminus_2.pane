[?2004hroot@4a5b84650438:~# cat << 'EOF' > process_data.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     if isinstance(val, str):
[?2004l[?2004h>         val = val.replace(',', '.')
[?2004l[?2004h>         try:
[?2004l[?2004h>             return float(val)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             return np.nan
[?2004l[?2004h>     return float(val)
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with missing values
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # Clean all numeric columns
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows that became NaN after cleaning (if any)
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # Now handle unit harmonization
[?2004l[?2004h> # We need to define expected ranges for each feature.
[?2004l[?2004h> # If a value is outside the range, we check if it fits after conversion.
[?2004l[?2004h> 
[?2004l[?2004h> def harmonize(df):
[?2004l[?2004h>     # Example: Serum_Creatinine
[?2004l[?2004h>     # Normal: 0.7-1.3 mg/dL. CKD: can be up to 10-20 mg/dL.
[?2004l[?2004h>     # If it's in umol/L, it would be 60-1000+.
[?2004l[?2004h>     # If value > 30, it's likely umol/L. Conversion: umol/L / 88.4
[?2004l[?2004h>     df['Serum_Creatinine'] = df['Serum_Creatinine'].apply(lambda x: x / 88.4 if x > 50 else x)
[?2004l[?2004h>     
[?2004l[?2004h>     # Hemoglobin: normal 12-18 g/dL. If g/L, it's 120-180.
[?2004l[?2004h>     # If value > 30, it's likely g/L. Conversion: g/L / 10
[?2004l[?2004h>     df['Hemoglobin'] = df['Hemoglobin'].apply(lambda x: x / 10 if x > 30 else x)
[?2004l[?2004h> 
[?2004l[?2004h>     # BUN: normal 7-20 mg/dL. In CKD, can be 100+. 
[?2004l[?2004h>     # In mmol/L, normal is 2.5-7.1. 
[?2004l[?2004h>     # This one is tricky. Let's look at the data.
[?2004l[?2004h>     # If value < 2, maybe it's mmol/L? But 2 mmol/L is 5.6 mg/dL.
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's check more features based on the head output and general knowledge.
[?2004l[?2004h>     
[?2004l[?2004h>     return df
[?2004l[?2004h> 
[?2004l[?2004h> # I need a more comprehensive list of ranges.
[?2004l[?2004h> EOF
