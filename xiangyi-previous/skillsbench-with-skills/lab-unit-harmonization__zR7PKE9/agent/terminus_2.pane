[?2004l
# Hemoglobin (g/dL): 12-16
df.loc[df['Hemoglobin'] > 30, 'Hemoglobin'] /= 10.0
df.loc[df['Hemoglobin'] < 5.0, 'Hemoglobin'] *= 1.61
df.loc[df['Hemoglobin'] < 5.0, 'Hemoglobin'] *= 4.0

# Albumin_Serum (g/dL): 3.5-5.0
df.loc[df['Albumin_Serum'] > 10, 'Albumin_Serum'] /= 10.0

# Total_Protein (g/dL): 6-8
df.loc[df['Total_Protein'] > 15, 'Total_Protein'] /= 10.0

# Glucose (mg/dL): 70-100
df.loc[df['Glucose'] < 25, 'Glucose'] *= 18.0

# Uric_Acid (mg/dL): 3-7
df.loc[df['Uric_Acid'] > 50, 'Uric_Acid'] /= 16.8

# Bilirubin (mg/dL): 0.1-1.2
df.loc[df['Total_Bilirubin'] > 5, 'Total_Bilirubin'] /= 17.1
df.loc[df['Direct_Bilirubin'] > 5, 'Direct_Bilirubin'] /= 17.1

# Cholesterol features: mg/dL
for col in ['Total_Cholesterol', 'LDL_Cholesterol', 'HDL_Cholesterol', 'Triglycerides', 'Non_HDL_Cholesterol']:
    df.loc[df[col] < 15, col] *= 38.6 if col != 'Triglycerides' else 88.5

# Serum_Iron (ug/dL): 60-170
df.loc[df['Serum_Iron'] < 20, 'Serum_Iron'] *= 5.59

# Round and format all columns to 2 decimal places
for col[?2004h> import pandas as pd
[?2004l in df.columns:
    df[col] = df[col].apply(lambda x: "{:.2f}".format(round(float(x), 2)))

df.to_csv('/root/ckd_lab_data_harmonized.csv', index=False)
