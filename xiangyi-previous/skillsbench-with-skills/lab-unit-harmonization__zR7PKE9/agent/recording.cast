[95.077613, "i", "cat << 'EOF' > process_data.py\nimport pandas as pd\nimport numpy as np\n\ndef clean_value(val):\n    if pd.isna(val):\n        return np.nan\n    if isinstance(val, str):\n        val = val.replace(',', '.')\n        try:\n            return float(val)\n        except ValueError:\n            return np.nan\n    return float(val)\n\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\ndf = df.dropna()\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\ndf = df.dropna()\n\ndef harmonize(row):\n    # Serum_Creatinine (mg/dL): 0.7-1.3, CKD up to 20\n    if row['Serum_Creatinine'] > 50: row['Serum_Creatinine'] /= 88.4\n    elif row['Serum_Creatinine'] < 0.5: row['Serum_Creatinine'] *= 1.0 # too low?\n    \n    # BUN (mg/dL): 7-20, CKD up to 200\n    if row['BUN'] < 5: row['BUN'] /= 0.357\n\n    # Serum_Calcium (mg/dL): 8.5-10.5\n    if 2.0 <= row['Serum_Calcium'] < 5.0: row['Serum_Calcium'] *= 4.0\n    elif row['Serum_Calcium'] < 2.0: row['Serum_Calcium'] *= 4.0 # possibly mmol/L\n    elif "]
[95.0777, "i", "row['Serum_Calcium'] > 15: row['Serum_Calcium'] /= 1.0 # already high\n    \n    # Phosphorus (mg/dL): 2.5-4.5\n    if row['Phosphorus'] < 2.0: row['Phosphorus'] *= 3.1\n\n    # Hemoglobin (g/dL): 12-16\n    if row['Hemoglobin'] > 30: row['Hemoglobin'] /= 10.0\n    elif row['Hemoglobin'] < 8.0: \n        if row['Hemoglobin'] * 1.61 > 8.0:\n            row['Hemoglobin'] *= 1.61\n        elif row['Hemoglobin'] * 6.2 > 8.0:\n            row['Hemoglobin'] *= 6.2 # mmol/L to g/dL factor is ~6.2 for Hb\n\n    # Albumin_Serum (g/dL): 3.5-5.0\n    if row['Albumin_Serum'] > 10: row['Albumin_Serum'] /= 10.0\n    elif row['Albumin_Serum'] < 2.0: row['Albumin_Serum'] *= 1.0 # keep as is or adjust?\n\n    # Glucose (mg/dL): 70-100\n    if row['Glucose'] < 20: row['Glucose'] *= 18.0\n    \n    # Uric_Acid (mg/dL): 3-7\n    if row['Uric_Acid'] > 50: row['Uric_Acid'] /= 16.8\n\n    # Cholesterol (mg/dL): < 200\n    for col in ['Total_Cholesterol', 'LDL_Cholesterol', 'HDL_Cholesterol', 'Triglycerides', 'Non_HDL_Cholesterol']:\n        if row[col] < 1"]
[95.077726, "i", "5: \n            if 'Triglycerides' in col:\n                row[col] *= 88.5\n            else:\n                row[col] *= 38.6\n\n    # Bilirubin (mg/dL): 0.1-1.2\n    if row['Total_Bilirubin'] > 5: row['Total_Bilirubin'] /= 17.1\n    if row['Direct_Bilirubin'] > 5: row['Direct_Bilirubin'] /= 17.1\n\n    # Serum_Iron (ug/dL): 60-170\n    if row['Serum_Iron'] < 20: row['Serum_Iron'] *= 5.59 # umol/L to ug/dL\n    \n    return row\n\ndf = df.apply(harmonize, axis=1)\n\n# Round and format\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(lambda x: \"{:.2f}\".format(round(float(x), 2)))\n    else:\n        df[col] = df[col].astype(int)\n\ndf.to_csv('/root/ckd_lab_data_harmonized.csv', index=False)\nEOF\npython3 process_data.py\nhead -n 5 /root/ckd_lab_data_harmonized.csv\n"]
