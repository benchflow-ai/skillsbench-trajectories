[62.432068, "o", "5,5.30,168.45,41.30,58.95,818.40,141.03,723.43,12.60,549.36,10.30,2563.18,290.44,249.62,18942.60,171.37,7.80,1.04,2065.39,15245.65,19710.00,8.18,2.45,3.10,6.86,43.10,8.66,1.13,29.25,178.10\r\n2.0,19.02,83.10,70.30,2.49,27.26,120.80,2.80,122.57,15.18,34.32,8.88,10.55,1.21,10.50,1259.52,378.20,229.14,671.10,3.06,22.51,6.70,29.66,237.03,293.50,346.30,77.55,3793.98,7.71,19.55,1.26,4.04,7.32,326.52,35.46,169.70,88.78,41.81,505.71,228.75,785.84,11.59,586.40,8.58,3962.07,5896.36,2790.34,17497.00,1008.40,5.30,1.03,3046.90,8918.69,29154.70,5040.00,2.70,2.65,7.19,33.50,285.89,49.66,0.90,83.38\r\n3.0,14.69,27.45,140.79,3.50,20.60,163.04,5.70,83.02,16.64,18.82,7.83,8.73,1.09,9.26,737.17,136.46,107.64,1858.05,9.30,56.61,6.39,44.44,786.11,169.19,80.72,89.30,1987.30,6.42,12.19,8.99,3.74,7.00,37.70,21.21,315.75,17.69,28.62,950.58,125.65,518.29,5.70,427.53,20.18,4679.21,430.40,4982.90,13969.00,2712.42,5.19,1.03,4807.50,26114.32,40009.30,5335.00,5.32,12.60,7.10,60.35,9.08,45.80,5.73,199.80\r\n4.0,12.05,177.24,27.88,6.43,19.35,130.28"]
[62.432079, "o", ",3.40,77.70,24.20,33.82,6.61,19.20,1.58,11.92,82.11,86.70,101.22,878.41,19.18,24.42,2.52,31.72,638.84,33.95,31.24,55.64,859.81,6.60,0.79,0.85,5.29,10.24,0.21,41.89,351.17,190.92,105.54,735.72,59.30,760.80,11.32,590.07,2.37,1659.18,36733.29,1051.60,17877.09,9899.37,6.60,1.00,2578.07,9196.03,8.70,1.02,22.61,2.59,7.66,81.83,206.91,15.66,22.86,197.70\r\n"]
[62.43531, "o", "\u001b[?2004hroot@4a5b84650438:~# "]
[77.171078, "i", "cat << 'EOF' > process_data.py\nimport pandas as pd\nimport numpy as np\n\ndef clean_value(val):\n    if pd.isna(val):\n        return np.nan\n    if isinstance(val, str):\n        val = val.replace(',', '.')\n        try:\n            return float(val)\n        except ValueError:\n            return np.nan\n    return float(val)\n\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\ndf = df.dropna()\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\ndf = df.dropna()\n\ndef harmonize(row):\n    # Serum_Creatinine (mg/dL): normal 0.7-1.3, CKD up to 20.\n    # if > 50, likely umol/L. \n    if row['Serum_Creatinine'] > 50: row['Serum_Creatinine'] /= 88.4\n    \n    # BUN (mg/dL): normal 7-20, CKD up to 200.\n    # If < 5 and Creatinine is high, likely mmol/L.\n    if row['BUN'] < 5 and row['Serum_Creatinine'] > 2: row['BUN'] /= 0.357\n\n    # Serum_Calcium (mg/dL): normal 8.5-10.5.\n    # If < 5, likely mmol/L.\n    if row['Serum_Calcium'] < 5: row['Serum_Calcium'] *= 4.0\n    \n    # Phos"]
[77.171259, "i", "phorus (mg/dL): normal 2.5-4.5.\n    # If < 2, likely mmol/L.\n    if row['Phosphorus'] < 2: row['Phosphorus'] *= 3.1\n\n    # Magnesium (mg/dL): normal 1.7-2.2.\n    # If < 1.2, likely mmol/L.\n    if row['Magnesium'] < 1.2: row['Magnesium'] *= 2.43\n\n    # Hemoglobin (g/dL): normal 12-16.\n    # If > 30, likely g/L.\n    if row['Hemoglobin'] > 30: row['Hemoglobin'] /= 10.0\n    # If Hemoglobin < 5, likely mmol/L.\n    if row['Hemoglobin'] < 5: row['Hemoglobin'] *= 1.61\n\n    # Albumin_Serum (g/dL): normal 3.5-5.0.\n    if row['Albumin_Serum'] > 10: row['Albumin_Serum'] /= 10.0\n    elif row['Albumin_Serum'] < 1.0: row['Albumin_Serum'] *= 1.0 # already g/dL?\n    \n    # Total_Protein (g/dL): normal 6-8.\n    if row['Total_Protein'] > 15: row['Total_Protein'] /= 10.0\n\n    # Glucose (mg/dL): normal 70-100.\n    if row['Glucose'] < 25: row['Glucose'] *= 18.0\n    \n    # Uric_Acid (mg/dL): normal 3-7.\n    if row['Uric_Acid'] > 50: row['Uric_Acid'] /= 16.8\n\n    # Cholesterol (mg/dL): normal < 200.\n    for col in ['Total_Cholestero"]
[77.171294, "o", "cat << 'EOF' > process_data.py\r\n\u001b[?2004l\r"]
[77.171309, "i", "l', 'LDL_Cholesterol', 'HDL_Cholesterol', 'Triglycerides', 'Non_HDL_Cholesterol']:\n        if row[col] < 15: \n            if 'Triglycerides' in col:\n                row[col] *= 88.5\n            else:\n                row[col] *= 38.6\n\n    # Bilirubin (mg/dL): normal 0.1-1.2.\n    if row['Total_Bilirubin'] > 5: row['Total_Bilirubin'] /= 17.1\n    if row['Direct_Bilirubin'] > 5: row['Direct_Bilirubin'] /= 17.1\n\n    # Serum_Iron (ug/dL): normal 60-170.\n    if row['Serum_Iron'] < 20: row['Serum_Iron'] *= 55.8 # umol/L to ug/dL\n    \n    return row\n\ndf = df.apply(harmonize, axis=1)\n\n# Round to 2 decimal places and format as X.XX\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(lambda x: \"{:.2f}\".format(x))\n    else:\n        df[col] = df[col].astype(int)\n\ndf.to_csv('/root/ckd_lab_data_harmonized.csv', index=False)\nEOF\npython3 process_data.py\nhead -n 5 /root/ckd_lab_data_harmonized.csv\n"]
