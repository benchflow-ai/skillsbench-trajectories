[32.968591, "i", "cat << 'EOF' > get_stats.py\nimport pandas as pd\nimport numpy as np\n\ndef clean_value(val):\n    if pd.isna(val):\n        return np.nan\n    if isinstance(val, str):\n        val = val.replace(',', '.')\n        try:\n            return float(val)\n        except ValueError:\n            return np.nan\n    return float(val)\n\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\ndf = df.dropna()\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\ndf = df.dropna()\n\nstats = df.describe(percentiles=[0.05, 0.95]).transpose()\nprint(stats[['min', '5%', '95%', 'max']].to_string())\nEOF\npython3 get_stats.py > column_ranges.txt\ncat column_ranges.txt\n"]
[32.968823, "o", "cat << 'EOF' > get_stats.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
