[479.901431, "o", "3.50,552.10,16.90,4465.80,397.03,2852.80,14238.70,16.27,8.87,1.00,2327.45,12761.59,37.09,6.14,5.40,14.82,7.20,9.52,4.24,9.09,12.71,165.59\r\n2589,1.70,89.48,38.20,5.07,14.89,131.69,7.75,133.16,24.87,7.79,8.96,14.89,1.32,1.86,1070.73,434.10,194.10,422.69,17.91,25.30,5.86,5.40,492.60,112.71,48.30,98.99,4269.06,3.81,1.50,14.75,5.74,8.75,40.25,35.71,270.20,142.43,134.52,61.03,323.47,682.79,11.42,163.03,8.50,839.90,21540.00,3305.90,19119.18,2261.61,8.86,1.02,40.72,3759.82,2.10,9135.00,4.40,1.90,6.88,60.30,256.65,16.40,24.23,197.70\r\n2590,8.27,160.94,138.62,4.30,36.10,139.36,2.66,70.38,28.94,11.69,3.74,13.00,1.18,8.51,2067.40,10.42,48.81,709.92,18.14,61.40,3.10,39.62,1464.90,127.77,401.40,26.20,3083.12,2.58,0.40,0.83,3.42,7.30,14.10,7.24,138.23,112.00,57.90,1251.98,83.10,315.76,10.71,421.60,6.70,1390.71,1831.82,1609.30,5793.40,2305.40,8.61,1.02,3659.67,4978.81,17.74,3.11,5.10,11.21,7.49,24.59,343.48,82.00,44.89,38.64\r\n"]
