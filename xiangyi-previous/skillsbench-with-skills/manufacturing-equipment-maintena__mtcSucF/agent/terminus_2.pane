[?2004l[?2004h> # Q4: conveyor speed feasibility using line speed formula
[?2004l[?2004h> # LINE SPEED = boards per minute * length per board / loading factor
[?2004l[?2004h> q4_list = []
[?2004l[?2004h> for run_id in sorted(mes['run_id'].unique()):
[?2004l[?2004h>     row = mes[mes['run_id']==run_id].iloc[0]
[?2004l[?2004h>     bpm = row['boards_per_min']
[?2004l[?2004h>     length = row['board_length_cm']
[?2004l[?2004h>     load_factor = row['loading_factor']
[?2004l[?2004h>     actual = row['conveyor_speed_cm_min']
[?2004l[?2004h>     if pd.isna(bpm) or pd.isna(length) or pd.isna(load_factor) or load_factor==0:
[?2004l[?2004h>         req = None
[?2004l[?2004h>     else:
[?2004l[?2004h>         req = bpm * length / load_factor
[?2004l[?2004h>     meets = (actual >= req) if (req is not None and not pd.isna(actual)) else False
[?2004l[?2004h>     q4_list.append({
[?2004l[?2004h>         'run_id': run_id,
[?2004l[?2004h>         'required_min_speed_cm_min': round(req,2) if req is not None else None,
[?2004l[?2004h>         'actual_speed_cm_min': round(actual,2) if not pd.isna(actual) else None,
[?2004l[?2004h>         'meets': bool(meets)
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> Path('/app/output/q04.json').write_text(json.dumps(q4_list, indent=2))
