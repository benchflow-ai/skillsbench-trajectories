[?2004l[?2004h> # Q5: best run per board_family based on quality and efficiency
[?2004l[?2004h> # Use yield summary (fp_yield_pct) as quality; boards_per_min as efficiency; downtime_s as tiebreaker (lower better)
[?2004l[?2004h> # Create yield per run from defects summary
[?2004l[?2004h> summary = defects[(defects['inspection_stage']=='SUMMARY') & (defects['defect_type']=='yield_summary')][['run_id','fp_yield_pct']]
[?2004l[?2004h> summary = summary.drop_duplicates(subset=['run_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # merge with mes
[?2004l[?2004h> mes_q5 = mes.merge(summary, on='run_id', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> q5_list = []
[?2004l[?2004h> for fam, fam_df in mes_q5.groupby('board_family'):
[?2004l[?2004h>     # sort by yield desc, boards_per_min desc, downtime_s asc
[?2004l[?2004h>     fam_df = fam_df.copy()
[?2004l[?2004h>     fam_df['fp_yield_pct'] = fam_df['fp_yield_pct'].fillna(-1)
[?2004l[?2004h>     fam_df['boards_per_min'] = fam_df['boards_per_min'].fillna(-1)
[?2004l[?2004h>     fam_df['downtime_s'] = fam_df['downtime_s'].fillna(1e9)
[?2004l[?2004h>     fam_df = fam_df.sort_values(by=['fp_yield_pct','boards_per_min','downtime_s','run_id'], ascending=[False,False,True,True])
[?2004l[?2004h>     best_run = fam_df.iloc[0]['run_id']
[?2004l[?2004h>     runner_up = [r for r in fam_df['run_id'].tolist() if r != best_run]
[?2004l[?2004h>     q5_list.append({'board_family': fam, 'best_run_id': best_run, 'runner_up_run_ids': runner_up})
[?2004l[?2004h> 
[?2004l[?2004h> q5_list = sorted(q5_list, key=lambda x: x['board_family'])
[?2004l[?2004h> Path('/app/output/q05.json').write_text(json.dumps(q5_list, indent=2))
