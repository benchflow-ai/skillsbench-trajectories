[?2004lu[?2004h> # compute TAL (time above liquidus) using linear interpolation
[?2004l[?2004h> 
[?2004ln[?2004h> def time_above_threshold(df, thr):
[?2004l[?2004h>     if df.empty:
[?2004l[?2004h>         return None
[?2004l[?2004h>     df = df.sort_values('time_s')
[?2004l[?2004h>     times = df['time_s'].values
[?2004l[?2004h>     temps = df['temp_c'].values
[?2004l[?2004h>     total = 0.0
[?2004l[?2004h>     for i in range(len(df)-1):
[?2004l[?2004h>         t1, t2 = times[i], times[i+1]
[?2004l[?2004h>         T1, T2 = temps[i], temps[i+1]
[?2004l[?2004h>         if t2 == t1:
[?2004l [?2004h>             continue
[?2004l[?2004h>         if T1 >= thr and T2 >= thr:
[?2004la[?2004h>             total += (t2 - t1)
[?2004l[?2004h>         elif T1 < thr and T2 > thr:
[?2004l][?2004h>             # crossing upward
[?2004ls[[?2004h>             frac = (T2 - thr) / (T2 - T1)
[?2004l[?2004h>             total += (t2 - t1) * frac
[?2004l[?2004h>         elif T1 > thr and T2 < thr:
[?2004l[?2004h>             # crossing downward
[?2004l[?2004h>             frac = (T1 - thr) / (T1 - T2)
[?2004l[?2004h>             total += (t2 - t1) * frac
[?2004l(l[?2004h>         else:
[?2004l[?2004h>             # both below
[?2004l[?2004h>             pass
[?2004l[?2004h>     return total
