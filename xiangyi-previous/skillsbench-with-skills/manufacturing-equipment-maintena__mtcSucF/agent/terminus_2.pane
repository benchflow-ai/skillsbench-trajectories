[?2004l[?2004h>             continue
[?2004l[?2004h>         slope = (T2 - T1) / (t2 - t1)
[?2004l[?2004h>         if max_slope is None or slope > max_slope:
[?2004l[?2004h>             max_slope = slope
[?2004l[?2004h>     return max_slope
