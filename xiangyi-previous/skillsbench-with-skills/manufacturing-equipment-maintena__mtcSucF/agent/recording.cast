[543.503395, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfor fname in ['q01.json','q02.json','q03.json','q04.json','q05.json']:\n    path = Path('/app/output')/fname\n    data = json.loads(path.read_text())\n    print(fname, 'loaded', type(data))\n    if isinstance(data, dict):\n        print(' keys', list(data.keys()))\n        if fname=='q01.json':\n            print(' ramp_rate_limit', data['ramp_rate_limit_c_per_s'], 'violations', len(data['violating_runs']))\n            # print first 2 runs\n            for k in list(data['max_ramp_by_run'].keys())[:2]:\n                print(k, data['max_ramp_by_run'][k])\n        if fname=='q03.json':\n            print(' failing', len(data['failing_runs']))\n            for k in list(data['min_peak_by_run'].keys())[:2]:\n                print(k, data['min_peak_by_run'][k])\n    else:\n        print(' len', len(data))\n        print(' first', data[0])\n    print('---')\nPY\n"]
