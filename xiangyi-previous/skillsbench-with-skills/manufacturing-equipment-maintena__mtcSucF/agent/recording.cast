[471.860062, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np, json, math\nfrom pathlib import Path\n\n# Load data\nmes = pd.read_csv('/app/data/mes_log.csv')\nthermo = pd.read_csv('/app/data/thermocouples.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# Helper: compute max ramp rate in preheat (100-150C) for a given df\nPREHEAT_MIN = 100.0\nPREHEAT_MAX = 150.0\n\n# choose representative TC for ramp: smallest_mass if available\n\ndef get_tc_for_location(run_df, location):\n    sub = run_df[run_df['tc_location'] == location]\n    if sub.empty:\n        return None\n    # choose first tc_id\n    return sub['tc_id'].iloc[0]\n\n# compute max ramp rate within region using linear segments\n\ndef max_ramp_preheat(df):\n    if df.empty:\n        return None\n    df = df.sort_values('time_s')\n    max_slope = None\n    times = df['time_s'].values\n    temps = df['temp_c'].values\n    for i in range(len(df)-1):\n        t1, t2 = times[i], times[i+1]\n        T1, T2 = temps[i], temps[i+1]\n        if t2 == t1:\n            continue\n        # if segment intersects preheat region\n        if max(T1, T2) < PREHEAT_MIN or min(T1, T2) > PREHEAT_MAX:\n            continue\n        slope = (T2 - T1) / (t2 - t1)\n        if max_slope is None or slope > max_slope:\n            max_slope = slope\n    return max_slope\n\n# compute TAL (time above liquidus) using linear interpolation\n\ndef time_above_threshold(df, thr):\n    if df.empty:\n        return None\n    df = df.sort_values('time_s')\n    times = df['time_s'].values\n    temps = df['temp_c'].values\n    total = 0.0\n    for i in range(len(df)-1):\n        t1, t2 = times[i], times[i+1]\n        T1, T2 = temps[i], temps[i+1]\n        if t2 == t1:\n            continue\n        if T1 >= thr and T2 >= thr:\n            total += (t2 - t1)\n        elif T1 < thr and T2 > thr:\n            # crossing upward\n            frac = (T2 - thr) / (T2 - T1)\n            total += (t2 - t1) * frac\n        elif T1 > thr and T2 < thr:\n            # crossing downward\n            frac = (T1 - thr) / (T1 - T2)\n            total += (t2 - t1) * frac\n        else:\n            # both below\n            pass\n    return total\n\n# Create output directory\nPath('/app/output').mkdir(parents=True, exist_ok=True)\n\n# Q1: ramp rate\nramp_limit = 2.0\nq1_max_by_run = {}\nviolating = []\n\nfor run_id, run_df in thermo.groupby('run_id'):\n    tc_id = get_tc_for_location(run_df, 'smallest_mass')\n    if tc_id is None:\n        # fallback: use first tc_id\n        tc_id = run_df['tc_id'].iloc[0] if not run_df.empty else None\n        df_tc = run_df[run_df['tc_id']==tc_id] if tc_id else pd.DataFrame()\n    else:\n        df_tc = run_df[run_df['tc_id']==tc_id]\n    max_ramp = max_ramp_preheat(df_tc)\n    q1_max_by_run[run_id] = {\n        'tc_id': tc_id if tc_id is not None else None,\n        'max_preheat_ramp_c_per_s': round(max_ramp,2) if max_ramp is not None else None\n    }\n    if max_ramp is not None and max_ramp > ramp_limit:\n        violating.append(run_id)\n\n# ensure all runs in mes_log included, even if no thermo\nfor run_id in mes['run_id']:\n    if run_id not in q1_max_by_run:\n        q1_max_by_run[run_id] = {'tc_id': None, 'max_preheat_ramp_c_per_s': None}\n\nviolating = sorted(set(violating))\n\nq1 = {\n    'ramp_rate_limit_c_per_s': ramp_limit,\n    'violating_runs': violating,\n    'max_ramp_by_run': {k: q1_max_by_run[k] for k in sorted(q1_max_by_run.keys())}\n}\n\nPath('/app/output/q01.json').write_text(json.dumps(q1, indent=2))\n\n# Q2: TAL\nTAL_MIN = 30.0\nTAL_MAX = 60.0\nq2_list = []\n\nfor run_id in sorted(mes['run_id'].unique()):\n    run_mes = mes[mes['run_id']==run_id].iloc[0]\n    liquidus = run_mes['solder_liquidus_c']\n    run_tc = thermo[thermo['run_id']==run_id]\n    if run_tc.empty:\n        q2_list.append({\n            'run_id': run_id,\n            'tc_id': None,\n            'tal_s': None,\n            'required_min_tal_s': TAL_MIN,\n            'required_max_tal_s': TAL_MAX,\n            'status': 'non-compliant'\n        })\n        continue\n    tc_id = get_tc_for_location(run_tc, 'largest_mass')\n    if tc_id is None:\n        tc_id = run_tc['tc_id'].iloc[0]\n    df_tc = run_tc[run_tc['tc_id']==tc_i"]
[471.860138, "i", "d]\n    tal = time_above_threshold(df_tc, liquidus)\n    status = 'compliant' if tal is not None and (TAL_MIN <= tal <= TAL_MAX) else 'non-compliant'\n    q2_list.append({\n        'run_id': run_id,\n        'tc_id': tc_id,\n        'tal_s': round(tal,2) if tal is not None else None,\n        'required_min_tal_s': TAL_MIN,\n        'required_max_tal_s': TAL_MAX,\n        'status': status\n    })\n\nPath('/app/output/q02.json').write_text(json.dumps(q2_list, indent=2))\n\n# Q3: peak temperature requirement\nq3_min_peak = {}\nfail_runs = []\n\nfor run_id in sorted(mes['run_id'].unique()):\n    run_mes = mes[mes['run_id']==run_id].iloc[0]\n    liquidus = run_mes['solder_liquidus_c']\n    required_min_peak = liquidus + 20.0\n    run_tc = thermo[thermo['run_id']==run_id]\n    if run_tc.empty:\n        q3_min_peak[run_id] = {'tc_id': None, 'peak_temp_c': None, 'required_min_peak_c': round(required_min_peak,2)}\n        fail_runs.append(run_id)\n        continue\n    tc_id = get_tc_for_location(run_tc, 'largest_mass')\n    if tc_id is None:\n        tc_id = run_tc['tc_id'].iloc[0]\n    df_tc = run_tc[run_tc['tc_id']==tc_id]\n    peak = df_tc['temp_c'].max() if not df_tc.empty else None\n    q3_min_peak[run_id] = {'tc_id': tc_id, 'peak_temp_c': round(float(peak),2) if peak is not None else None, 'required_min_peak_c': round(required_min_peak,2)}\n    if peak is None or peak < required_min_peak:\n        fail_runs.append(run_id)\n\nq3 = {\n    'failing_runs': sorted(set(fail_runs)),\n    'min_peak_by_run': {k: q3_min_peak[k] for k in sorted(q3_min_peak.keys())}\n}\nPath('/app/output/q03.json').write_text(json.dumps(q3, indent=2))\n\n# Q4: conveyor speed feasibility using line speed formula\n# LINE SPEED = boards per minute * length per board / loading factor\nq4_list = []\nfor run_id in sorted(mes['run_id'].unique()):\n    row = mes[mes['run_id']==run_id].iloc[0]\n    bpm = row['boards_per_min']\n    length = row['board_length_cm']\n    load_factor = row['loading_factor']\n    actual = row['conveyor_speed_cm_min']\n    if pd.isna(bpm) or pd.isna(length) or pd.isna(load_factor) or load_factor==0:\n        req = None\n    else:\n        req = bpm * length / load_factor\n    meets = (actual >= req) if (req is not None and not pd.isna(actual)) else False\n    q4_list.append({\n        'run_id': run_id,\n        'required_min_speed_cm_min': round(req,2) if req is not None else None,\n        'actual_speed_cm_min': round(actual,2) if not pd.isna(actual) else None,\n        'meets': bool(meets)\n    })\n\nPath('/app/output/q04.json').write_text(json.dumps(q4_list, indent=2))\n\n# Q5: best run per board_family based on quality and efficiency\n# Use yield summary (fp_yield_pct) as quality; boards_per_min as efficiency; downtime_s as tiebreaker (lower better)\n# Create yield per run from defects summary\nsummary = defects[(defects['inspection_stage']=='SUMMARY') & (defects['defect_type']=='yield_summary')][['run_id','fp_yield_pct']]\nsummary = summary.drop_duplicates(subset=['run_id'])\n\n# merge with mes\nmes_q5 = mes.merge(summary, on='run_id', how='left')\n\nq5_list = []\nfor fam, fam_df in mes_q5.groupby('board_family'):\n    # sort by yield desc, boards_per_min desc, downtime_s asc\n    fam_df = fam_df.copy()\n    fam_df['fp_yield_pct'] = fam_df['fp_yield_pct'].fillna(-1)\n    fam_df['boards_per_min'] = fam_df['boards_per_min'].fillna(-1)\n    fam_df['downtime_s'] = fam_df['downtime_s'].fillna(1e9)\n    fam_df = fam_df.sort_values(by=['fp_yield_pct','boards_per_min','downtime_s','run_id'], ascending=[False,False,True,True])\n    best_run = fam_df.iloc[0]['run_id']\n    runner_up = [r for r in fam_df['run_id'].tolist() if r != best_run]\n    q5_list.append({'board_family': fam, 'best_run_id': best_run, 'runner_up_run_ids': runner_up})\n\nq5_list = sorted(q5_list, key=lambda x: x['board_family'])\nPath('/app/output/q05.json').write_text(json.dumps(q5_list, indent=2))\n\nprint('Generated outputs')\nPY\n"]
[471.860319, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[471.860395, "o", "\u001b[?2004h> "]
[471.860489, "o", "import pandas as pd, numpy as np, json, math\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.860513, "o", "> "]
[471.860569, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[471.860595, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[471.860637, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.860663, "o", "> "]
[471.860774, "o", "mes = pd.read_csv('/app/data/mes_log.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.860815, "o", "> "]
[471.860913, "o", "thermo = pd.read_csv('/app/data/thermocouples.csv')\r\n\u001b[?2004l\r"]
[471.860938, "o", "\u001b[?2004h> "]
[471.86108, "o", "defects = pd.read_csv('/app/data/test_defects.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.86112, "o", "> \r\n\u001b[?2004l\r)\u001b[?2004h> "]
[471.861292, "o", "# Helper: compute max ramp rate in preheat (100-150C) for a given df\r\n\u001b[?2004l\r"]
[471.861317, "o", "\u001b[?2004h> "]
[471.861376, "o", "PREHEAT_MIN = 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.861438, "o", "PREHEAT_MAX = 150.0\r\n\u001b[?2004l\r"]
[471.861478, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[471.861659, "o", "# choose representative TC for ramp: smallest_mass if available\r\n\u001b[?2004l\r"]
[471.861682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[471.86175, "o", "> "]
[471.861814, "o", "def get_tc_for_location(run_df, location):\r\n\u001b[?2004l\r"]
[471.861854, "o", "\u001b[?2004h> "]
[471.861969, "o", "    sub = run_df[run_df['tc_location'] == location]\r\n\u001b[?2004l\r"]
[471.862008, "o", "\u001b[?2004h> "]
[471.862035, "o", "    if sub.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.862095, "o", "> "]
[471.862133, "o", "        return None\r\n\u001b[?2004l\r'\u001b[?2004h> "]
[471.862184, "o", "    # choose first tc_id\r\n\u001b[?2004l\r"]
[471.862224, "o", "\u001b[?2004h> "]
[471.862293, "o", "    return sub['tc_id'].iloc[0]\r\n\u001b[?2004l\r"]
[471.86233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[471.862488, "o", "# compute max ramp rate within region using linear segments\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.862514, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[471.86259, "o", "def max_ramp_preheat(df):\r\n\u001b[?2004l\r"]
[471.862636, "o", "\u001b[?2004h> "]
[471.862684, "o", "    if df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.862721, "o", "        return None\r\n\u001b[?2004l\r"]
[471.862757, "o", "\u001b[?2004h> "]
[471.862833, "o", "    df = df.sort_values('time_s')\r\n\u001b[?2004l\r"]
[471.86287, "o", "\u001b[?2004h> "]
[471.862907, "o", "    max_slope = None\r\n\u001b[?2004l\r"]
[471.862947, "o", "\u001b[?2004h> "]
[471.862994, "o", "    times = df['time_s'].values\r\n\u001b[?2004l\r"]
[471.863032, "o", "\u001b[?2004h> "]
[471.863103, "o", "    temps = df['temp_c'].values\r\n\u001b[?2004l\r"]
[471.863143, "o", "\u001b[?2004h> "]
[471.863186, "o", "    for i in range(len(df)-1):\r\n\u001b[?2004l\r"]
[471.863227, "o", "\u001b[?2004h> "]
[471.863295, "o", "        t1, t2 = times[i], times[i+1]\r\n\u001b[?2004l\r"]
[471.863334, "o", "\u001b[?2004h> "]
[471.863415, "o", "        T1, T2 = temps[i], temps[i+1]\r\n\u001b[?2004l\r"]
[471.863454, "o", "\u001b[?2004h> "]
[471.863494, "o", "        if t2 == t1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.863521, "o", "> "]
[471.863578, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.863682, "o", "        # if segment intersects preheat region\r\n\u001b[?2004l\r"]
[471.863722, "o", "\u001b[?2004h> "]
[471.863865, "o", "        if max(T1, T2) < PREHEAT_MIN or min(T1, T2) > PREHEAT_MAX:\r\n\u001b[?2004l\r"]
[471.863906, "o", "\u001b[?2004h> "]
[471.863943, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.863981, "o", "> "]
[471.864058, "o", "        slope = (T2 - T1) / (t2 - t1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.864096, "o", "> "]
[471.864188, "o", "        if max_slope is None or slope > max_slope:\r\n\u001b[?2004l\r"]
[471.864203, "o", "\u001b[?2004h> "]
[471.864286, "o", "            max_slope = slope\r\n\u001b[?2004l\r"]
[471.864307, "o", "\u001b[?2004h> "]
[471.864355, "o", "    return max_slope\r\n\u001b[?2004l\rq\u001b[?2004h"]
[471.864378, "o", "> \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[471.864519, "o", "# compute TAL (time above liquidus) using linear interpolation\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.864538, "o", "> \r\n\u001b[?2004l\rn"]
[471.864558, "o", "\u001b[?2004h> "]
[471.864648, "o", "def time_above_threshold(df, thr):\r\n\u001b[?2004l\r"]
[471.86467, "o", "\u001b[?2004h> "]
[471.864712, "o", "    if df.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.864734, "o", "> "]
[471.864777, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.864793, "o", "> "]
[471.864911, "o", "    df = df.sort_values('time_s')\r\n\u001b[?2004l\r"]
[471.864929, "o", "\u001b[?2004h> "]
[471.865031, "o", "    times = df['time_s'].values\r\n\u001b[?2004l\r"]
[471.865049, "o", "\u001b[?2004h> "]
[471.865123, "o", "    temps = df['temp_c'].values\r\n\u001b[?2004l\r"]
[471.865147, "o", "\u001b[?2004h> "]
[471.865182, "o", "    total = 0.0\r\n\u001b[?2004l\r"]
[471.865205, "o", "\u001b[?2004h> "]
[471.865276, "o", "    for i in range(len(df)-1):\r\n\u001b[?2004l\r"]
[471.865294, "o", "\u001b[?2004h> "]
[471.865429, "o", "        t1, t2 = times[i], times[i+1]\r\n\u001b[?2004l\r"]
[471.865445, "o", "\u001b[?2004h> "]
[471.865564, "o", "        T1, T2 = temps[i], temps[i+1]\r\n\u001b[?2004l\r"]
[471.865581, "o", "\u001b[?2004h> "]
[471.865627, "o", "        if t2 == t1:\r\n\u001b[?2004l\r "]
[471.865644, "o", "\u001b[?2004h> "]
[471.865685, "o", "            continue\r\n\u001b[?2004l\r"]
[471.865702, "o", "\u001b[?2004h> "]
[471.865767, "o", "        if T1 >= thr and T2 >= thr:\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[471.865834, "o", "            total += (t2 - t1)\r\n\u001b[?2004l\r"]
[471.865851, "o", "\u001b[?2004h> "]
[471.865926, "o", "        elif T1 < thr and T2 > thr:\r\n\u001b[?2004l\r]\u001b[?2004h"]
[471.865947, "o", "> "]
[471.866009, "o", "            # crossing upward\r\n\u001b[?2004l\rs["]
[471.866027, "o", "\u001b[?2004h"]
[471.866085, "o", "> "]
[471.866153, "o", "            frac = (T2 - thr) / (T2 - T1)\r\n\u001b[?2004l\r"]
[471.866181, "o", "\u001b[?2004h> "]
[471.866287, "o", "            total += (t2 - t1) * frac\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.866356, "o", "        elif T1 > thr and T2 < thr:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.866379, "o", "> "]
[471.866433, "o", "            # crossing downward\r\n\u001b[?2004l\r"]
[471.86645, "o", "\u001b[?2004h> "]
[471.866548, "o", "            frac = (T1 - thr) / (T1 - T2)\r\n\u001b[?2004l\r"]
[471.866566, "o", "\u001b[?2004h> "]
[471.866635, "o", "            total += (t2 - t1) * frac\r\n\u001b[?2004l\r(l"]
[471.866653, "o", "\u001b[?2004h> "]
[471.86668, "o", "        else:\r\n\u001b[?2004l\r"]
[471.866698, "o", "\u001b[?2004h> "]
[471.866743, "o", "            # both below\r\n\u001b[?2004l\r"]
[471.86676, "o", "\u001b[?2004h> "]
[471.866795, "o", "            pass\r\n\u001b[?2004l\r"]
[471.866814, "o", "\u001b[?2004h> "]
[471.866847, "o", "    return total\r\n\u001b[?2004l\r"]
[471.866866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[471.866886, "o", "\u001b[?2004h> "]
[471.866972, "o", "# Create output directory\r\n\u001b[?2004l\r"]
[471.866994, "o", "\u001b[?2004h> "]
[471.867097, "o", "Path('/app/output').mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\ro"]
[471.867115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[471.867131, "o", "> "]
[471.867158, "o", "# Q1: ramp rate\r\n\u001b[?2004l\r"]
[471.867186, "o", "\u001b[?2004h> "]
[471.867217, "o", "ramp_limit = 2.0\r\n\u001b[?2004l\r  \u001b[?2004h"]
[471.867235, "o", "> "]
[471.867264, "o", "q1_max_by_run = {}\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[471.867311, "o", "violating = []\r\n\u001b[?2004l\r':\u001b[?2004h> "]
[471.867329, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[471.86744, "o", "for run_id, run_df in thermo.groupby('run_id'):\r\n\u001b[?2004l\rou"]
[471.867459, "o", "\u001b[?2004h> "]
[471.867646, "o", "    tc_id = get_tc_for_location(run_df, 'smallest_mass')\r\n\u001b[?2004l\r\u001b[?2004h>     if tc_id is None:\r\n\u001b[?2004l\rc"]
[471.867688, "o", "\u001b[?2004h> "]
[471.867718, "o", "        # fallback: use first tc_id\r\n\u001b[?2004l\r \u001b[?2004h"]
[471.867739, "o", "> "]
[471.867858, "o", "        tc_id = run_df['tc_id'].iloc[0] if not run_df.empty else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.867879, "o", "> "]
[471.868001, "o", "        df_tc = run_df[run_df['tc_id']==tc_id] if tc_id else pd.DataFrame()\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.868019, "o", "> "]
[471.868047, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.868141, "o", "        df_tc = run_df[run_df['tc_id']==tc_id]\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[471.868224, "o", "    max_ramp = max_ramp_preheat(df_tc)\r\n\u001b[?2004l\r"]
[471.868245, "o", "\u001b[?2004h> "]
[471.869563, "o", "    q1_max_by_run[run_id] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'tc_id': tc_id if tc_id is not None else None,\r\n\u001b[?2004l\rf\u001b[?2004h>         'max_preheat_ramp_c_per_s': round(max_ramp,2) if max_ramp is not None else None\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\ryp\u001b[?2004h>     if max_ramp is not None and max_ramp > ramp_limit:\r\n\u001b[?2004l\r\u001b[?2004h>         violating.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ensure all runs in mes_log included, even if no thermo\r\n\u001b[?2004l\r\u001b[?2004h> for run_id in mes['run_id']:\r\n\u001b[?2004l\r\r\n\r\n\u001b[?2004h>     if run_id not in q1_max_by_run:\r\n\u001b[?2004l\r_\u001b[?2004h>         q1_max_by_run[run_id] = {'tc_id': None, 'max_preheat_ramp_c_per_s': None}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> violating = sorted(set(violating))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> q1 = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.869612, "o", "    'ramp_rate_limit_c_per_s': ramp_limit,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.869727, "o", "    'violating_runs': violating,\r\n\u001b[?2004l\rper\u001b[?2004h> "]
[471.869898, "o", "    'max_ramp_by_run': {k: q1_max_by_run[k] for k in sorted(q1_max_by_run.keys())}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[471.869931, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[471.870063, "o", "Path('/app/output/q01.json').write_text(json.dumps(q1, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[471.870111, "o", "\u001b[?2004h> # Q2: TAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87015, "o", "TAL_MIN = 30.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.870176, "o", "TAL_MAX = 60.0\r\n\u001b[?2004l\rid\u001b[?2004h"]
[471.870199, "o", "> "]
[471.870229, "o", "q2_list = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.870249, "o", "> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[471.870362, "o", "for run_id in sorted(mes['run_id'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.870477, "o", "    run_mes = mes[mes['run_id']==run_id].iloc[0]\r\n\u001b[?2004l\rfa\u001b[?2004h> "]
[471.870585, "o", "    liquidus = run_mes['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87066, "o", "    run_tc = thermo[thermo['run_id']==run_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.870734, "o", "    if run_tc.empty:\r\n\u001b[?2004l\r'ru\u001b[?2004h> "]
[471.870801, "o", "        q2_list.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.870849, "o", "            'run_id': run_id,\r\n\u001b[?2004l\r"]
[471.870901, "o", "\u001b[?2004h> "]
[471.870953, "o", "            'tc_id': None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.870982, "o", "            'tal_s': None,\r\n\u001b[?2004l\r/q\u001b[?2004h> "]
[471.871084, "o", "            'required_min_tal_s': TAL_MIN,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87118, "o", "            'required_max_tal_s': TAL_MAX,\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.871235, "o", "> "]
[471.871287, "o", "            'status': 'non-compliant'\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[471.871338, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[471.871389, "o", "\u001b[?2004h> "]
[471.871434, "o", "    tc_id = get_tc_for_location(run_tc, 'largest_mass')\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.871459, "o", "> "]
[471.87152, "o", "    if tc_id is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.871574, "o", "        tc_id = run_tc['tc_id'].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.871638, "o", "    df_tc = run_tc[run_tc['tc_id']==tc_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.871685, "o", "> "]
[471.871726, "o", "    tal = time_above_threshold(df_tc, liquidus)\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.87178, "o", "> "]
[471.871884, "o", "    status = 'compliant' if tal is not None and (TAL_MIN <= tal <= TAL_MAX) else 'non-compliant'\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.871939, "o", "> "]
[471.871976, "o", "    q2_list.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'run_id': run_id,\r\n\u001b[?2004l\r"]
[471.872015, "o", "\u001b[?2004h> "]
[471.872068, "o", "        'tc_id': tc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.872148, "o", "        'tal_s': round(tal,2) if tal is not None else None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.872195, "o", "> "]
[471.872249, "o", "        'required_min_tal_s': TAL_MIN,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.872294, "o", "        'required_max_tal_s': TAL_MAX,\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.872321, "o", "> "]
[471.872344, "o", "        'status': status\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.87237, "o", ">     })\r\n\u001b[?2004l\r"]
[471.872437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[471.872486, "o", "> "]
[471.872573, "o", "Path('/app/output/q02.json').write_text(json.dumps(q2_list, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.872617, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Q3: peak temperature requirement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.872664, "o", "q3_min_peak = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.872691, "o", "> fail_runs = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[471.872752, "o", "\u001b[?2004h> "]
[471.872812, "o", "for run_id in sorted(mes['run_id'].unique()):\r\n\u001b[?2004l\r"]
[471.872859, "o", "\u001b[?2004h> "]
[471.872887, "o", "    run_mes = mes[mes['run_id']==run_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873037, "o", "    liquidus = run_mes['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873087, "o", "    required_min_peak = liquidus + 20.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873154, "o", "    run_tc = thermo[thermo['run_id']==run_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873208, "o", "    if run_tc.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873459, "o", "        q3_min_peak[run_id] = {'tc_id': None, 'peak_temp_c': None, 'required_min_peak_c': round(required_min_peak,2)}\r\n\u001b[?2004l\r\u001b[?2004h>         fail_runs.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873542, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873595, "o", "    tc_id = get_tc_for_location(run_tc, 'largest_mass')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873648, "o", "    if tc_id is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87369, "o", "        tc_id = run_tc['tc_id'].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.873741, "o", "> "]
[471.87379, "o", "    df_tc = run_tc[run_tc['tc_id']==tc_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.873879, "o", "    peak = df_tc['temp_c'].max() if not df_tc.empty else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.873927, "o", "> "]
[471.874137, "o", "    q3_min_peak[run_id] = {'tc_id': tc_id, 'peak_temp_c': round(float(peak),2) if peak is not None else None, 'required_min_peak_c': round(required_min_peak,2)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.874192, "o", "> "]
[471.874244, "o", "    if peak is None or peak < required_min_peak:\r\n\u001b[?2004l\r"]
[471.874297, "o", "\u001b[?2004h>         fail_runs.append(run_id)\r\n\u001b[?2004l\r"]
[471.874347, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.874401, "o", "q3 = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.874452, "o", "    'failing_runs': sorted(set(fail_runs)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87456, "o", "    'min_peak_by_run': {k: q3_min_peak[k] for k in sorted(q3_min_peak.keys())}\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.874608, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.874696, "o", "Path('/app/output/q03.json').write_text(json.dumps(q3, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.874748, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.874818, "o", "# Q4: conveyor speed feasibility using line speed formula\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.874865, "o", "> "]
[471.874936, "o", "# LINE SPEED = boards per minute * length per board / loading factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.874988, "o", "> q4_list = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.875038, "o", "> "]
[471.875091, "o", "for run_id in sorted(mes['run_id'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.875155, "o", "    row = mes[mes['run_id']==run_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.8752, "o", "> "]
[471.875248, "o", "    bpm = row['boards_per_min']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.875298, "o", "    length = row['board_length_cm']\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.87535, "o", "> "]
[471.8754, "o", "    load_factor = row['loading_factor']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.875446, "o", "    actual = row['conveyor_speed_cm_min']\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.875496, "o", "> "]
[471.875576, "o", "    if pd.isna(bpm) or pd.isna(length) or pd.isna(load_factor) or load_factor==0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.875622, "o", "> "]
[471.875673, "o", "        req = None\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.875703, "o", "> "]
[471.875761, "o", "        req = bpm * length / load_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.875867, "o", "    meets = (actual >= req) if (req is not None and not pd.isna(actual)) else False\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.875913, "o", "> "]
[471.87594, "o", "    q4_list.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.875998, "o", "        'run_id': run_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.876096, "o", "        'required_min_speed_cm_min': round(req,2) if req is not None else None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.876145, "o", "> "]
[471.876249, "o", "        'actual_speed_cm_min': round(actual,2) if not pd.isna(actual) else None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.87629, "o", "        'meets': bool(meets)\r\n\u001b[?2004l\r"]
[471.876335, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[471.876381, "o", "\u001b[?2004h> "]
[471.876463, "o", "Path('/app/output/q04.json').write_text(json.dumps(q4_list, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.876515, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.876602, "o", "# Q5: best run per board_family based on quality and efficiency\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.876788, "o", "# Use yield summary (fp_yield_pct) as quality; boards_per_min as efficiency; downtime_s as tiebreaker (lower better)\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.876838, "o", "> "]
[471.876888, "o", "# Create yield per run from defects summary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.877082, "o", "summary = defects[(defects['inspection_stage']=='SUMMARY') & (defects['defect_type']=='yield_summary')][['run_id','fp_yield_pct']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.877191, "o", "summary = summary.drop_duplicates(subset=['run_id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[471.877216, "o", "> # merge with mes\r\n\u001b[?2004l\r"]
[471.877281, "o", "\u001b[?2004h> "]
[471.87732, "o", "mes_q5 = mes.merge(summary, on='run_id', how='left')\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.877376, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> q5_list = []\r\n\u001b[?2004l\r"]
[471.877445, "o", "\u001b[?2004h> "]
[471.877572, "o", "for fam, fam_df in mes_q5.groupby('board_family'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.88158, "o", "    # sort by yield desc, boards_per_min desc, downtime_s asc\r\n\u001b[?2004l\r"]
[471.881798, "o", "\u001b[?2004h>     fam_df = fam_df.copy()"]
[471.882002, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[471.882056, "o", ">     fam_df['fp_yield_pct'] = fam_df['fp_yield_pct'].fillna(-1)"]
[471.882113, "o", "\r\n"]
[471.88222, "o", "\u001b[?2004l\r"]
[471.882325, "o", "\u001b[?2004h"]
[471.882547, "o", "> "]
[471.882622, "o", "    fam_df['boards_per_min'] = fam_df['boards_per_min'].fillna(-1)"]
[471.882721, "o", "\r\n"]
[471.8828, "o", "\u001b[?2004l\r"]
[471.882895, "o", "\u001b[?2004h"]
[471.883106, "o", "> "]
[471.883182, "o", "    fam_df['downtime_s'] = fam_df['downtime_s'].fillna(1e9)"]
[471.883254, "o", "\r\n"]
[471.883331, "o", "\u001b[?2004l\r"]
[471.883424, "o", "\u001b[?2004h"]
[471.883511, "o", "> "]
[471.883825, "o", "    fam_df = fam_df.sort_values(by=['fp_yield_pct','boards_per_min','downtime_s','run_id'], ascending=[False,False,True,True])"]
[471.883907, "o", "\r\n"]
[471.88399, "o", "\u001b[?2004l\r"]
[471.884083, "o", "\u001b[?2004h"]
[471.884179, "o", "> "]
[471.884329, "o", "    best_run = fam_df.iloc[0]['run_id']"]
[471.884405, "o", "\r\n"]
[471.884482, "o", "\u001b[?2004l\r"]
[471.884573, "o", "\u001b[?2004h"]
[471.884677, "o", "> "]
[471.886038, "o", "    runner_up = [r for r in fam_df['run_id'].tolist() if r != best_run]\r\n\u001b[?2004l\r\u001b[?2004h>     q5_list.append({'board_family': fam, 'best_run_id': best_run, 'runner_up_run_ids': runner_up})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> q5_list = sorted(q5_list, key=lambda x: x['board_family'])\r\n\u001b[?2004l\r\u001b[?2004h> Path('/app/output/q05.json').write_text(json.dumps(q5_list, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Generated outputs')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[472.796499, "o", "Generated outputs\r\n"]
[472.856257, "o", "\u001b[?2004hroot@b59e49b25ca1:/app# "]
