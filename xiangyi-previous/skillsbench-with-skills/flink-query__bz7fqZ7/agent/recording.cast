[429.227798, "o", "java --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED -cp \"target/classes:target/libs/*\" clusterdata.query.LongestSessionPerJob --task_input /app/workspace/data/task_events/part-00001-of-00500.csv.gz --job_input /app/workspace/data/job_events/part-00001-of-00500.csv.gz --output /app/workspace/output.txt\r\n\u001b[?2004l\r"]
