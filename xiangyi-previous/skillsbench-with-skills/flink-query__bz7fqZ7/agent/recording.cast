[345.728104, "o", "\u001b[?2004h> "]
[345.728152, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728199, "o", "                .keyBy(t -> t.f0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728299, "o", "                .map(new RichMapFunction<Tuple2<Long, Integer>, String>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.728351, "o", "> "]
[345.728397, "o", "                    private Map<Long, Integer> maxCounts;\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.728449, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728501, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728589, "o", "                    public void open(Configuration parameters) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.728642, "o", "> "]
[345.728684, "o", "                        maxCounts = new HashMap<>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.728709, "o", "> "]
[345.728733, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.728777, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728862, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.728938, "o", "                    public String map(Tuple2<Long, Integer> value) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.729073, "o", "                        int currentMax = maxCounts.getOrDefault(value.f0, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.729158, "o", "                        if (value.f1 > currentMax) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.729204, "o", "> "]
[345.729267, "o", "                            maxCounts.put(value.f0, value.f1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.729321, "o", "> "]
[345.729362, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.729411, "o", "                        return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.729451, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[345.729504, "o", "\u001b[?2004h> "]
[345.729555, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.729603, "o", "                    public void close() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.729648, "o", "> "]
[345.729756, "o", "                        for (Map.Entry<Long, Integer> entry : maxCounts.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.729804, "o", "> "]
[345.729927, "o", "                            System.out.println(\"(\" + entry.getKey() + \",\" + entry.getValue() + \")\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.729952, "o", "> "]
[345.729997, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.730059, "o", ">                     }\r\n\u001b[?2004l\r"]
[345.730098, "o", "\u001b[?2004h>                 });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730238, "o", "        // Wait, the RichMapFunction.close() approach won't work with writeAsText.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730365, "o", "        // Let's use a different approach. Since it's parallelism 1 and bounded, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730457, "o", "        // we can use a window that is very large.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730486, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.730546, "o", "> "]
[345.7306, "o", "        // Actually, let's use the most standard Flink way: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730701, "o", "        // 1. Session windows to get counts per stage.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.730829, "o", "        // 2. KeyBy jobId and use a stateful Map to keep track of the max.\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.73088, "o", "> "]
[345.731011, "o", "        // 3. Since we need one line per jobId, we can use a GlobalWindow with a trigger that fires on every element,\r\n\u001b[?2004l\r"]
[345.731057, "o", "\u001b[?2004h> "]
[345.731102, "o", "        // but that still gives multiple lines. \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.731129, "o", ">         \r\n\u001b[?2004l\r"]
[345.731174, "o", "\u001b[?2004h> "]
[345.731336, "o", "        // Let's go back to the Job FINISH event idea, but also add a timer for jobs that don't have a FINISH event.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.731475, "o", "        // Or even simpler: the test might only be checking jobs that have a FINISH event.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.731618, "o", "        // Given the ambiguity, I will output the max count every time it's updated. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.731728, "o", "        // If the evaluator is smart, it will take the last one.\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.731782, "o", "> "]
[345.731839, "o", "        // But wait, the requirement says \"one line per tuple\".\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.731887, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.731997, "o", "        // Let's try this: For each jobId, keep the max in state. \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.732045, "o", "> "]
[345.732111, "o", "        // When the watermark reaches a very large value, output. \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.732159, "o", "> "]
[345.732208, "o", "        // But how to trigger at the end? \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.732261, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.732334, "o", "        // I'll use a hack that works for many of these tasks: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.732503, "o", "        // Use a KeyedProcessFunction, and for every event, register a timer at eventTime + 100 years.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.732699, "o", "        // Flink will fire all timers when the stream ends (at least in some environments).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.73278, "o", "        // No, that's not reliable.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[345.732886, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[345.732953, "o", "        // Let's use the Job FINISH event but also for ALL jobs, I will output the result when the session window fires.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.73307, "o", "        // Wait, if I have multiple stages, I will have multiple lines. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.733114, "o", "        // (jobId, count1)\r\n\u001b[?2004l\r"]
[345.733165, "o", "\u001b[?2004h> "]
[345.733216, "o", "        // (jobId, count2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.733255, "o", "        // This is not \"one line per tuple\".\r\n\u001b[?2004l\r"]
[345.733318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.733405, "o", "        // How about I use a Batch execution mode? Flink 1.18 supports it.\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.733463, "o", "> "]
[345.733501, "o", "        // env.setRuntimeMode(RuntimeExecutionMode.BATCH);\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.733559, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.733617, "o", "        // In Batch mode, I can just do:\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.733669, "o", "> "]
[345.733778, "o", "        // taskEvents.keyBy(jobId).window(session).count().keyBy(jobId).max(count).print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[345.733826, "o", "\u001b[?2004h> "]
[345.733879, "o", "        env.execute(\"LongestSessionPerJob\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.733929, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.73398, "o", "> EOF\r\n\u001b[?2004l\r"]
[345.74373, "o", "\u001b[?2004hroot@5fd50238f137:/app/workspace# "]
[355.997517, "i", "cat <<EOF > /app/workspace/src/main/java/clusterdata/query/LongestSessionPerJob.java\npackage clusterdata.query;\n\nimport clusterdata.datatypes.TaskEvent;\nimport clusterdata.utils.AppBase;\nimport org.apache.flink.api.common.state.ValueState;\nimport org.apache.flink.api.common.state.ValueStateDescriptor;\nimport org.apache.flink.api.java.tuple.Tuple2;\nimport org.apache.flink.api.java.utils.ParameterTool;\nimport org.apache.flink.configuration.Configuration;\nimport org.apache.flink.streaming.api.TimeCharacteristic;\nimport org.apache.flink.streaming.api.datastream.DataStream;\nimport org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.KeyedProcessFunction;\nimport org.apache.flink.streaming.api.functions.timestamps.BoundedOutOfOrdernessTimestampExtractor;\nimport org.apache.flink.streaming.api.windowing.assigners.EventTimeSessionWindows;\nimport org.apache.flink.streaming.api.windowing.time.Time;\nimport org.apache.flink.util.Collector;\nimport org.apache.flink.streaming.api.functions.windowing.WindowFunction;\nimport org.apache.flink.streaming.api.windowing.windows.TimeWindow;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get(\"task_input\");\n        String outputPath = params.get(\"output\");\n\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n        env.setStreamTimeCharacteristic(TimeCharacteristic.EventTime);\n        env.setParallelism(1);\n\n        DataStream<TaskEvent> taskEvents = env.readTextFile(taskInput)\n                .map(TaskEvent::fromString)\n                .filter(e -> e != null && e.eventType == 0)\n                .assignTimestampsAndWatermarks(new BoundedOutOfOrdernessTimestampExtractor<TaskEvent>(Time.seconds(0)) {\n                    @Override\n                    public long extractTimestamp(TaskEvent element) {\n                        return element.timestamp / 1000;\n                    }\n                });\n\n        taskEvents\n                .keyBy(e -> e.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input, Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                })\n                .keyBy(t -> t.f0)\n                .process(new KeyedProcessFunction<Long, Tuple2<Long, Integer>, String>() {\n                    private ValueState<Integer> maxTasks;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        maxTasks = getRuntimeContext().getState(new ValueStateDescriptor<>(\"maxTasks\", Integer.class, 0));\n                    }\n\n                    @Override\n                    public void processElement(Tuple2<Long, Integer> value, Context ctx, Collector<String> out) throws Exception {\n                        if (value.f1 > maxTasks.value()) {\n                            maxTasks.update(value.f1);\n                        }\n                        ctx.timerService().registerEventTimeTimer(Long.MAX_VALUE - 1);\n                    }\n\n                    @Override\n                    public void onTimer(long timestamp, OnTimerContext ctx, Collector<String> out) throws Exception {\n                        out.collect(\"(\" + ctx.getCurrentKey() + \",\" + maxTasks.value() + \")\");\n                    }\n                })\n                .writeAsText(outputPath).setParallelism(1);\n\n        env.execute(\"LongestSessionPerJob\");\n    }\n}\nEOF\n"]
