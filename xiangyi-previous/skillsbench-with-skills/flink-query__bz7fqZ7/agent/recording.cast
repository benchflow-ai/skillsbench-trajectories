[416.014289, "o", "(6252007148,0)\r\n(6252018749,0)\r\n(6252009114,0)\r\n(6252009169,0)\r\n(6252009257,0)\r\n(6252009167,0)\r\n(6252008056,0)\r\n(6252018951,0)\r\n(6252020393,0)\r\n(6252007996,0)\r\n(6252023188,1)\r\n(6251994762,0)\r\n(6252018928,0)\r\n(6252020683,0)\r\n(6252020836,9)\r\n(6251974069,0)\r\n(6252023247,1)\r\n(6252020745,2)\r\n(6252020654,0)\r\n(6252024416,1)\r\n"]
