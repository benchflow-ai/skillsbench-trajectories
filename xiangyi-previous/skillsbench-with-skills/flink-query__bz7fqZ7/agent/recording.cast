[27.602082, "i", "cat <<EOF > /app/workspace/src/main/java/clusterdata/datatypes/JobEvent.java\npackage clusterdata.datatypes;\n\npublic class JobEvent {\n    public long timestamp;\n    public long jobId;\n    public int eventType;\n\n    public JobEvent() {}\n\n    public static JobEvent fromString(String line) {\n        String[] tokens = line.split(\",\");\n        JobEvent event = new JobEvent();\n        try {\n            event.timestamp = Long.parseLong(tokens[0]);\n            event.jobId = Long.parseLong(tokens[2]);\n            event.eventType = Integer.parseInt(tokens[3]);\n        } catch (NumberFormatException | ArrayIndexOutOfBoundsException e) {\n            return null;\n        }\n        return event;\n    }\n}\nEOF\n"]
