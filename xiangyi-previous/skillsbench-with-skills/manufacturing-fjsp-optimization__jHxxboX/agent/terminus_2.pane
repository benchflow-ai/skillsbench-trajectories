[?2004l[?2004h> def solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline):
[?2004l[?2004h>     """Improved job shop scheduling with downtime constraints"""
[?2004l[?2004h>     
[?2004l[?2004h>     freeze_until = policy.get('freeze', {}).get('freeze_until', 0)
[?2004l[?2004h>     baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}
[?2004l[?2004h>     
[?2004l[?2004h>     # Track state
[?2004l[?2004h>     schedule = {}
[?2004l[?2004h>     machine_events = [[] for _ in range(num_machines)]  # List of (end_time, job, op)
[?2004l[?2004h>     job_last_op = [-1] * num_jobs  # Last operation end time for each job
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority queue: (earliest_possible_start, job, op)
[?2004l[?2004h>     priority_queue = []
[?2004l[?2004h>     scheduled_ops = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Start with first operation of each job
[?2004l[?2004h>     for job_id in range(num_jobs):
[?2004l[?2004h>         heapq.heappush(priority_queue, (0, job_id, 0))
[?2004l[?2004h>     
[?2004l[?2004h>     while priority_queue:
[?2004l[?2004h>         _, job_id, op_id = heapq.heappop(priority_queue)
[?2004l[?2004h>         
[?2004l[?2004h>         if (job_id, op_id) in scheduled_ops:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if previous operation is done
[?2004l[?2004h>         if op_id > 0 and (job_id, op_id - 1) not in scheduled_ops:
[?2004l[?2004h>             heapq.heappush(priority_queue, (job_last_op[job_id], job_id, op_id))
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         alternatives = jobs[job_id][op_id]
[?2004l[?2004h>         best_schedule = None
[?2004l[?2004h>         best_end_time = float('inf')
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if frozen
[?2004l[?2004h>         is_frozen = (job_id, op_id) in baseline_schedule and \
[?2004l[?2004h>                     baseline_schedule[(job_id, op_id)]['end'] <= freeze_until
[?2004l[?2004h>         
[?2004l[?2004h>         if is_frozen:
[?2004l[?2004h>             baseline_op = baseline_schedule[(job_id, op_id)]
[?2004l[?2004h>             machine = baseline_op['machine']
[?2004l[?2004h>             duration = baseline_op['dur']
[?2004l[?2004h>             start = baseline_op['start']
[?2004l[?2004h>             end = baseline_op['end']
[?2004l[?2004h>             
[?2004l[?2004h>             if not check_downtime_conflict(machine, start, end, downtime):
[?2004l[?2004h>                 best_schedule = (machine, start, end, duration)
[?2004l[?2004h>                 best_end_time = end
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Try each alternative
[?2004l[?2004h>             for machine, duration in alternatives:
[?2004l[?2004h>                 # Earliest start time
[?2004l[?2004h>                 earliest_start = job_last_op[job_id] + 1 if job_last_op[job_id] >= 0 else 0
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Get machine free time
[?2004l[?2004h>                 if machine_events[machine]:
[?2004l[?2004h>                     machine_free = machine_events[machine][-1][0]
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     machine_free = 0
[?2004l[?2004h>                 
[?2004l[?2004h>                 earliest_start = max(earliest_start, machine_free)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Adjust for downtime
[?2004l[?2004h>                 start = get_available_time_after_downtime(machine, earliest_start, duration, downtime)
[?2004l[?2004h>                 end = start + duration
[?2004l[?2004h>                 
[?2004l[?2004h>                 if end < best_end_time:
[?2004l[?2004h>                     best_end_time = end
[?2004l[?2004h>                     best_schedule = (machine, start, end, duration)
[?2004l[?2004h>         
[?2004l[?2004h>         if best_schedule:
[?2004l[?2004h>             machine, start, end, duration = best_schedule
[?2004l[?2004h>             schedule[(job_id, op_id)] = {
[?2004l[?2004h>                 'job': job_id,
[?2004l[?2004h>                 'op': op_id,
[?2004l[?2004h>                 'machine': machine,
[?2004l[?2004h>                 'start': start,
[?2004l[?2004h>                 'end': end,
[?2004l[?2004h>                 'dur': duration
[?2004l[?2004h>             }
[?2004l[?2004h>             machine_events[machine].append((end, job_id, op_id))
[?2004l[?2004h>             machine_events[machine].sort()
[?2004l[?2004h>             job_last_op[job_id] = end
[?2004l[?2004h>             scheduled_ops.add((job_id, op_id))
[?2004l[?2004h>             
[?2004l[?2004h>             # Add next operation to queue
[?2004l[?2004h>             if op_id + 1 < len(jobs[job_id]):
