[?2004l[?2004h>                      for op_id in range(len(jobs[job_id]))]
[?2004l[?2004h>     schedule_list.sort(key=lambda x: (x['start'], x['job'], x['op']))
[?2004l[?2004h>     
[?2004l[?2004h>     makespan = max(op['end'] for op in schedule_list) if schedule_list else 0
[?2004l[?2004h>     
