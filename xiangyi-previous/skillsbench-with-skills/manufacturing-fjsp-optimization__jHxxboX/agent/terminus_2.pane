[?2004l[?2004h> 
[?2004l[?2004h> # Parse instance.txt
[?2004l[?2004h> def parse_instance(filename):
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         lines = f.readlines()
[?2004l[?2004h>     
[?2004l[?2004h>     first_line = lines[0].strip().split()
[?2004l[?2004h>     num_jobs = int(first_line[0])
[?2004l[?2004h>     num_machines = int(first_line[1])
[?2004l[?2004h>     
[?2004l[?2004h>     jobs = []
[?2004l[?2004h>     line_idx = 1
[?2004l[?2004h>     
[?2004l[?2004h>     for job_id in range(num_jobs):
[?2004l[?2004h>         num_ops = int(lines[line_idx].strip())
[?2004l[?2004h>         line_idx += 1
[?2004l[?2004h>         operations = []
[?2004l[?2004h>         
[?2004l[?2004h>         for op_id in range(num_ops):
[?2004l[?2004h>             parts = list(map(int, lines[line_idx].strip().split()))
[?2004l[?2004h>             line_idx += 1
[?2004l[?2004h>             num_alts = parts[0]
[?2004l[?2004h>             alternatives = []
[?2004l[?2004h>             for i in range(num_alts):
[?2004l[?2004h>                 machine = parts[1 + i*2]
[?2004l[?2004h>                 duration = parts[1 + i*2 + 1]
[?2004l[?2004h>                 alternatives.append((machine, duration))
[?2004l[?2004h>             operations.append(alternatives)
[?2004l[?2004h>         
[?2004l[?2004h>         jobs.append(operations)
[?2004l[?2004h>     
[?2004l[?2004h>     return num_jobs, num_machines, jobs
[?2004l[?2004h> 
[?2004l [?2004h> # Parse downtime.csv
[?2004l[?2004h> def parse_downtime(filename):
[?2004l[?2004h>     downtime = {}
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         for row in reader:
[?2004l[?2004h>             machine = int(row['machine'])
[?2004l[?2004h>             start = int(row['start'])
[?2004l[?2004h>             end = int(row['end'])
[?2004l[?2004h>             if machine not in downtime:
[?2004l[?2004h>                 downtime[machine] = []
[?2004l[?2004h>             downtime[machine].append((start, end))
[?2004l[?2004h>     return downtime
[?2004l[?2004h> 
[?2004lc[?2004h> # Parse policy.json
[?2004l[?2004h> def parse_policy(filename):
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         policy = json.load(f)
[?2004l[?2004h>     return policy
[?2004l[?2004h> 
[?2004l[?2004h> # Parse baseline solution
[?2004l[?2004h> def parse_baseline(filename):
[?2004l[?2004h>     with open(filename, 'r') as f:
[?2004l[?2004h>         baseline = json.load(f)
[?2004l[?2004h>     return baseline
[?2004l[?2004h> 
[?2004l [?2004h> def check_downtime_conflict(machine, start, end, downtime):
[?2004l[?2004h>     """Check if operation conflicts with machine downtime"""
[?2004l[?2004h>     if machine not in downtime:
[?2004l[?2004h>         return False
[?2004l[?2004h>     for dt_start, dt_end in downtime[machine]:
[?2004l[?2004h>         # Conflict if operation overlaps with downtime
[?2004l[?2004h>         if not (end <= dt_start or start >= dt_end):
[?2004l[?2004h>             return True
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> def solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline):
[?2004l[?2004h>     """Solve job shop scheduling with downtime constraints"""
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract freeze policy
[?2004l[?2004h>     freeze_until = policy.get('freeze', {}).get('freeze_until', 0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Start with baseline and try to fix violations
[?2004l[?2004h>     schedule = []
[?2004l[?2004h>     baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}
[?2004l[?2004h>     
[?2004l[?2004h>     # Track machine availability
[?2004l[?2004h>     machine_free_time = [0] * num_machines
[?2004l[?2004h>     job_last_op_end = [-1] * num_jobs
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort operations by job and operation order
[?2004l[?2004h>     operations_to_schedule = []
[?2004l[?2004h>     for job_id in range(num_jobs):
[?2004l[?2004h>         for op_id in range(len(jobs[job_id])):
[?2004l[?2004h>             operations_to_schedule.append((job_id, op_id))
[?2004l[?2004h>     
[?2004l[?2004h>     # Schedule each operation
[?2004l[?2004h>     for job_id, op_id in operations_to_schedule:
[?2004l[?2004h>         alternatives = jobs[job_id][op_id]
[?2004l[?2004h>         best_schedule = None
[?2004l[?2004h>         best_end_time = float('inf')
[?2004l[?2004h>         
[?2004l[?2004h>         # Try each alternative (machine, duration)
[?2004l[?2004h>         for machine, duration in alternatives:
[?2004l[?2004h>             # Check if this operation is frozen
[?2004l[?2004h>             if (job_id, op_id) in baseline_schedule:
[?2004l[?2004h>                 baseline_op = baseline_schedule[(job_id, op_id)]
[?2004l[?2004h>                 if baseline_op['end'] <= freeze_until:
[?2004l[?2004h>                     # This operation is frozen, must keep same machine and times
[?2004l[?2004h>                     if machine == baseline_op['machine']:
[?2004l[?2004h>                         start = baseline_op['start']
[?2004l[?2004h>                         end = baseline_op['end']
[?2004l[?2004h>                         if not check_downtime_conflict(machine, start, end, downtime):
[?2004l[?2004h>                             best_schedule = (machine, start, end, duration)
[?2004l[?2004h>                             best_end_time = end
[?2004l[?2004h>                     continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Find earliest start time
[?2004l[?2004h>             # Must respect: machine availability and job precedence
[?2004l[?2004h>             earliest_start = max(machine_free_time[machine], 
[?2004l[?2004h>                                 job_last_op_end[job_id] + 1 if job_last_op_end[job_id] >= 0 else 0)
[?2004l[?2004h>             
[?2004l[?2004h>             # Check if we need to wait for downtime to pass
[?2004l[?2004h>             start = earliest_start
[?2004l[?2004h>             end = start + duration
[?2004l[?2004h>             
[?2004l[?2004h>             while check_downtime_conflict(machine, start, end, downtime):
[?2004l[?2004h>                 # Find next available time after downtime
[?2004l[?2004h>                 for dt_start, dt_end in downtime[machine]:
[?2004l[?2004h>                     if not (end <= dt_start or start >= dt_end):
[?2004l[?2004h>                         start = dt_end
[?2004l[?2004h>                         end = start + duration
[?2004l[?2004h>                         break
[?2004l[?2004h>             
[?2004l[?2004h>             if end < best_end_time:
[?2004l[?2004h>                 best_end_time = end
[?2004l[?2004h>                 best_schedule = (machine, start, end, duration)
[?2004l[?2004h>         
[?2004l[?2004h>         if best_schedule:
[?2004l[?2004h>             machine, start, end, duration = best_schedule
[?2004l[?2004h>             schedule.append({
[?2004l[?2004h>                 'job': job_id,
[?2004l[?2004h>                 'op': op_id,
[?2004l[?2004h>                 'machine': machine,
[?2004l[?2004h>                 'start': start,
[?2004l[?2004h>                 'end': end,
[?2004l[?2004h>                 'dur': duration
[?2004l[?2004h>             })
[?2004l[?2004h>             machine_free_time[machine] = end
[?2004l[?2004h>             job_last_op_end[job_id] = end
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate makespan
[?2004l[?2004h>     makespan = max(op['end'] for op in schedule) if schedule else 0
[?2004l[?2004h>     
[?2004l[?2004h>     return schedule, makespan
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     # Parse all input files
[?2004l[?2004h>     num_jobs, num_machines, jobs = parse_instance('/app/data/instance.txt')
[?2004l[?2004h>     downtime = parse_downtime('/app/data/downtime.csv')
[?2004l[?2004h>     policy = parse_policy('/app/data/policy.json')
[?2004l[?2004h>     baseline = parse_baseline('/app/data/baseline_solution.json')
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve the scheduling problem
[?2004l[?2004h>     schedule, makespan = solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for downtime violations
[?2004l[?2004h>     violations = 0
[?2004l[?2004h>     for op in schedule:
[?2004l[?2004h>         if check_downtime_conflict(op['machine'], op['start'], op['end'], downtime):
[?2004l[?2004h>             violations += 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Determine status
[?2004l[?2004h>     if violations == 0:
