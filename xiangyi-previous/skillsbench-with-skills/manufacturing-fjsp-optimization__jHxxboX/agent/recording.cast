[74.511379, "o", "                conflict = True"]
[74.511445, "o", "\r\n"]
[74.511514, "o", "\u001b[?2004l\r"]
[74.511609, "o", "\u001b[?2004h"]
[74.511716, "o", "> "]
[74.511829, "o", "                break"]
[74.511929, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.512032, "o", "> "]
[74.512155, "o", "        if not conflict:"]
[74.512249, "o", "\r\n"]
[74.512354, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.512515, "o", "            return current_start"]
[74.512582, "o", "\r\n"]
[74.512676, "o", "\u001b[?2004l\r"]
[74.512782, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.512901, "o", "> "]
[74.513256, "o", "def solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline):"]
[74.513326, "o", "\r\n"]
[74.513393, "o", "\u001b[?2004l\r"]
[74.513473, "o", "\u001b[?2004h"]
[74.513551, "o", "> "]
[74.51387, "o", "    \"\"\"Improved job shop scheduling with downtime constraints\"\"\""]
[74.513938, "o", "\r\n"]
[74.514005, "o", "\u001b[?2004l\r"]
[74.514086, "o", "\u001b[?2004h"]
[74.514155, "o", "> "]
[74.51424, "o", "    "]
[74.514302, "o", "\r\n"]
[74.514368, "o", "\u001b[?2004l\r"]
[74.514443, "o", "\u001b[?2004h"]
[74.514558, "o", "> "]
[74.514853, "o", "    freeze_until = policy.get('freeze', {}).get('freeze_until', 0)"]
[74.514918, "o", "\r\n"]
[74.514982, "o", "\u001b[?2004l\r"]
[74.515061, "o", "\u001b[?2004h"]
[74.515135, "o", "> "]
[74.515662, "o", "    baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}"]
[74.515792, "o", "\r\n"]
[74.515866, "o", "\u001b[?2004l\r"]
[74.515959, "o", "\u001b[?2004h"]
[74.516036, "o", "> "]
[74.516119, "o", "    "]
[74.51618, "o", "\r\n"]
[74.51624, "o", "\u001b[?2004l\r"]
[74.516314, "o", "\u001b[?2004h"]
[74.516382, "o", "> "]
[74.516516, "o", "    # Track state"]
[74.516585, "o", "\r\n"]
[74.51665, "o", "\u001b[?2004l\r"]
[74.516745, "o", "\u001b[?2004h"]
[74.516852, "o", "> "]
[74.516965, "o", "    schedule = {}"]
[74.517077, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.517444, "o", "    machine_events = [[] for _ in range(num_machines)]  # List of (end_time, job, op)"]
[74.517598, "o", "\r\n"]
[74.517703, "o", "\u001b[?2004l\r"]
[74.517798, "o", "\u001b[?2004h"]
[74.51788, "o", "> "]
[74.518241, "o", "    job_last_op = [-1] * num_jobs  # Last operation end time for each job"]
[74.518312, "o", "\r\n"]
[74.518375, "o", "\u001b[?2004l\r"]
[74.518456, "o", "\u001b[?2004h"]
[74.518531, "o", "> "]
[74.518614, "o", "    "]
[74.518678, "o", "\r\n"]
[74.518765, "o", "\u001b[?2004l\r"]
[74.518865, "o", "\u001b[?2004h> "]
[74.519131, "o", "    # Priority queue: (earliest_possible_start, job, op)"]
[74.51922, "o", "\r\n"]
[74.51929, "o", "\u001b[?2004l\r"]
[74.519372, "o", "\u001b[?2004h"]
[74.519455, "o", "> "]
[74.519632, "o", "    priority_queue = []"]
[74.519711, "o", "\r\n"]
[74.519846, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.520007, "o", "    scheduled_ops = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[74.520108, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.520363, "o", "    # Start with first operation of each job\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.520766, "o", "    for job_id in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h>         heapq.heappush(priority_queue, (0, job_id, 0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.520952, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     while priority_queue:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.521288, "o", "        _, job_id, op_id = heapq.heappop(priority_queue)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.521406, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.521633, "o", "        if (job_id, op_id) in scheduled_ops:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.521722, "o", "> "]
[74.521793, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.521864, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.521933, "o", "> "]
[74.522108, "o", "        # Check if previous operation is done\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.522183, "o", "> "]
[74.522517, "o", "        if op_id > 0 and (job_id, op_id - 1) not in scheduled_ops:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.522904, "o", "            heapq.heappush(priority_queue, (job_last_op[job_id], job_id, op_id))\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.523015, "o", "> "]
[74.523098, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.523199, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.52724, "o", "        alternatives = jobs[job_id][op_id]\r\n\u001b[?2004l\r\u001b[?2004h>         best_schedule = None\r\n\u001b[?2004l\r\u001b[?2004h>         best_end_time = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Check if frozen\r\n\u001b[?2004l\r\u001b[?2004h>         is_frozen = (job_id, op_id) in baseline_schedule and \\\r\n\u001b[?2004l\r\u001b[?2004h>                     baseline_schedule[(job_id, op_id)]['end'] <= freeze_until\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if is_frozen:\r\n\u001b[?2004l\r\u001b[?2004h>             baseline_op = baseline_schedule[(job_id, op_id)]\r\n\u001b[?2004l\r\u001b[?2004h>             machine = baseline_op['machine']\r\n\u001b[?2004l\r\u001b[?2004h>             duration = baseline_op['dur']\r\n\u001b[?2004l\r\u001b[?2004h>             start = baseline_op['start']\r\n\u001b[?2004l\r\u001b[?2004h>             end = baseline_op['end']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if not check_downtime_conflict(machine, start, end, downtime):\r\n\u001b[?2004l\r\u001b[?2004h>                 best_schedule = (machine, start, end, duration)\r\n\u001b[?2004l\r\u001b[?2004h>                 best_end_time = end\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             # Try each alternative\r\n\u001b[?2004l\r\u001b[?2004h>             for machine, duration in alternatives:\r\n\u001b[?2004l\r\u001b[?2004h>                 # Earliest start time\r\n\u001b[?2004l\r\u001b[?2004h>                 earliest_start = job_last_op[job_id] + 1 if job_last_op[job_id] >= 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 # Get machine free time\r\n\u001b[?2004l\r\u001b[?2004h>                 if machine_events[machine]:\r\n\u001b[?2004l\r\u001b[?2004h>                     machine_free = machine_events[machine][-1][0]\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     machine_free = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.527372, "o", "                earliest_start = max(earliest_start, machine_free)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.527468, "o", ">                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.527567, "o", "                # Adjust for downtime\r\n\u001b[?2004l\r"]
[74.527647, "o", "\u001b[?2004h> "]
[74.527834, "o", "                start = get_available_time_after_downtime(machine, earliest_start, duration, downtime)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.527912, "o", "                end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.527984, "o", ">                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.528071, "o", "                if end < best_end_time:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.528139, "o", "> "]
[74.528208, "o", "                    best_end_time = end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.528333, "o", "                    best_schedule = (machine, start, end, duration)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.528409, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.528485, "o", "        if best_schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.528605, "o", "            machine, start, end, duration = best_schedule\r\n\u001b[?2004l\r"]
[74.528677, "o", "\u001b[?2004h> "]
[74.52875, "o", "            schedule[(job_id, op_id)] = {\r\n\u001b[?2004l\r"]
[74.52882, "o", "\u001b[?2004h> "]
[74.528889, "o", "                'job': job_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.528974, "o", "                'op': op_id,\r\n\u001b[?2004l\r"]
[74.529043, "o", "\u001b[?2004h> "]
[74.529112, "o", "                'machine': machine,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.529205, "o", "                'start': start,\r\n\u001b[?2004l\r"]
[74.529274, "o", "\u001b[?2004h> "]
[74.529347, "o", "                'end': end,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.52943, "o", "                'dur': duration\r\n\u001b[?2004l\r"]
[74.529505, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[74.529576, "o", "\u001b[?2004h> "]
[74.52969, "o", "            machine_events[machine].append((end, job_id, op_id))\r\n\u001b[?2004l\r"]
[74.529761, "o", "\u001b[?2004h> "]
[74.52983, "o", "            machine_events[machine].sort()\r\n\u001b[?2004l\r"]
[74.529901, "o", "\u001b[?2004h> "]
[74.52997, "o", "            job_last_op[job_id] = end\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.530039, "o", "> "]
[74.53011, "o", "            scheduled_ops.add((job_id, op_id))\r\n\u001b[?2004l\r"]
[74.530176, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[74.530244, "o", "\u001b[?2004h> "]
[74.53032, "o", "            # Add next operation to queue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.530451, "o", "            if op_id + 1 < len(jobs[job_id]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.530614, "o", "                heapq.heappush(priority_queue, (end, job_id, op_id + 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.530686, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.530758, "o", "    # Convert to list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.530859, "o", "    schedule_list = [schedule[(job_id, op_id)] \r\n\u001b[?2004l\r"]
[74.530928, "o", "\u001b[?2004h> "]
[74.530998, "o", "                     for job_id in range(num_jobs) \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.53107, "o", "> "]
[74.531181, "o", "                     for op_id in range(len(jobs[job_id]))]\r\n\u001b[?2004l\r"]
[74.531263, "o", "\u001b[?2004h"]
[74.531349, "o", "> "]
[74.531467, "o", "    schedule_list.sort(key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r"]
[74.531547, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.53162, "o", "> "]
[74.531755, "o", "    makespan = max(op['end'] for op in schedule_list) if schedule_list else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.531828, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.531897, "o", "    return schedule_list, makespan\r\n\u001b[?2004l\r"]
[74.531968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[74.532038, "o", "\u001b[?2004h> "]
[74.532195, "o", "    num_jobs, num_machines, jobs = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r"]
[74.532272, "o", "\u001b[?2004h> "]
[74.532346, "o", "    downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r"]
[74.532421, "o", "\u001b[?2004h> "]
[74.532504, "o", "    policy = parse_policy('/app/data/policy.json')\r\n\u001b[?2004l\r"]
[74.532579, "o", "\u001b[?2004h> "]
[74.532695, "o", "    baseline = parse_baseline('/app/data/baseline_solution.json')\r\n\u001b[?2004l\r"]
[74.532763, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.533017, "o", "    schedule, makespan = solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline)\r\n\u001b[?2004l\r"]
[74.533095, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.533238, "o", "    violations = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.533311, "o", "> "]
[74.533484, "o", "        if check_downtime_conflict(op['machine'], op['start'], op['end'], downtime):\r\n\u001b[?2004l\r"]
[74.533561, "o", "\u001b[?2004h> "]
[74.533633, "o", "            violations += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.533703, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.533947, "o", "    status = \"FEASIBLE\" if violations == 0 else \"INFEASIBLE\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     solution = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.534024, "o", "        \"status\": status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.534107, "o", "        \"makespan\": makespan,\r\n\u001b[?2004l\r"]
[74.534179, "o", "\u001b[?2004h> "]
[74.534248, "o", "        \"schedule\": schedule\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.534317, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[74.534388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.534518, "o", "    with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r"]
[74.534598, "o", "\u001b[?2004h> "]
[74.534669, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r"]
[74.534739, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.534809, "o", "> "]
[74.534902, "o", "    with open('/app/output/schedule.csv', 'w') as f:\r\n\u001b[?2004l\r"]
[74.534975, "o", "\u001b[?2004h> "]
[74.539467, "o", "        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\r\n\u001b[?2004l\r\u001b[?2004h>         writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h>         for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h>             writer.writerow(op)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Schedule generated successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Status: {status}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Makespan: {makespan}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Downtime violations: {violations}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Guard constraint (max {int(baseline['makespan'] * 1.1)}): {'PASS' if makespan <= baseline['makespan'] * 1.1 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@0628284d9d7e:/app# "]
[77.991417, "i", "python3 /app/scheduler_v2.py\n"]
[77.991883, "o", "python3 /app/scheduler_v2.py\r\n\u001b[?2004l\r"]
[78.034199, "o", "Schedule generated successfully!\r\nStatus: FEASIBLE\r\nMakespan: 38\r\nDowntime violations: 0\r\nGuard constraint (max 39): PASS\r\n"]
[78.03929, "o", "\u001b[?2004hroot@0628284d9d7e:/app# "]
[83.023096, "i", "ls -la /app/output/\n"]
[83.023405, "o", "ls -la /app/output/\r\n\u001b[?2004l\r"]
[83.024959, "o", "total 20\r\ndrwxr-xr-x 1 root root 4096 Jan 26 12:45 .\r\ndrwxr-xr-x 1 root root 4096 Jan 26 12:46 ..\r\n-rw-r--r-- 1 root root  202 Jan 26 12:46 schedule.csv\r\n-rw-r--r-- 1 root root 1436 Jan 26 12:46 solution.json"]
[83.02505, "o", "\r\n"]
[83.025204, "o", "\u001b[?2004hroot@0628284d9d7e:/app# "]
[85.97915, "i", "cat /app/output/solution.json\n"]
