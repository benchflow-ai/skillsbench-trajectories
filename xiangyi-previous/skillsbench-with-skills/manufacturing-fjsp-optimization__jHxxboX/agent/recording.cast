[46.837187, "o", "        if not (end <= dt_start or start >= dt_end):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.837335, "o", "            return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.837524, "o", "    return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.837555, "o", "\u001b[?2004h> "]
[46.837954, "o", "def solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline):\r\n\u001b[?2004l\r"]
[46.83814, "o", "\u001b[?2004h> "]
[46.838307, "o", "    \"\"\"Solve job shop scheduling with downtime constraints\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[46.838349, "o", "\u001b[?2004h> "]
[46.838527, "o", "    # Extract freeze policy\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.838566, "o", "> "]
[46.838903, "o", "    freeze_until = policy.get('freeze', {}).get('freeze_until', 0)\r\n\u001b[?2004l\r"]
[46.839098, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.839243, "o", ">     # Start with baseline and try to fix violations\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.839292, "o", "> "]
[46.839519, "o", "    schedule = []\r\n\u001b[?2004l\r"]
[46.839685, "o", "\u001b[?2004h> "]
[46.839823, "o", "    baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.839857, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.840025, "o", "    # Track machine availability\r\n\u001b[?2004l\r"]
[46.840146, "o", "\u001b[?2004h> "]
[46.840276, "o", "    machine_free_time = [0] * num_machines\r\n\u001b[?2004l\r"]
[46.84039, "o", "\u001b[?2004h> "]
[46.840547, "o", "    job_last_op_end = [-1] * num_jobs\r\n\u001b[?2004l\r"]
[46.840579, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.840808, "o", "> "]
[46.840941, "o", "    # Sort operations by job and operation order\r\n\u001b[?2004l\r"]
[46.841028, "o", "\u001b[?2004h> "]
[46.841151, "o", "    operations_to_schedule = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.841218, "o", "    for job_id in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.84125, "o", "> "]
[46.841364, "o", "        for op_id in range(len(jobs[job_id])):\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.84143, "o", "> "]
[46.841738, "o", "            operations_to_schedule.append((job_id, op_id))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Schedule each operation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.841856, "o", "    for job_id, op_id in operations_to_schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.842224, "o", "        alternatives = jobs[job_id][op_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.84253, "o", "        best_schedule = None\r\n\u001b[?2004l\r\u001b[?2004h>         best_end_time = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.84266, "o", "        # Try each alternative (machine, duration)\r\n\u001b[?2004l\r\u001b[?2004h>         for machine, duration in alternatives:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.842931, "o", "            # Check if this operation is frozen\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.843072, "o", "            if (job_id, op_id) in baseline_schedule:\r\n\u001b[?2004l\r\u001b[?2004h>                 baseline_op = baseline_schedule[(job_id, op_id)]\r\n\u001b[?2004l\r"]
[46.843163, "o", "\u001b[?2004h> "]
[46.843275, "o", "                if baseline_op['end'] <= freeze_until:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.84337, "o", "                    # This operation is frozen, must keep same machine and times\r\n\u001b[?2004l\r"]
[46.84349, "o", "\u001b[?2004h> "]
[46.843552, "o", "                    if machine == baseline_op['machine']:\r\n\u001b[?2004l\r"]
[46.843625, "o", "\u001b[?2004h> "]
[46.84373, "o", "                        start = baseline_op['start']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.843873, "o", "                        end = baseline_op['end']\r\n\u001b[?2004l\r"]
[46.843944, "o", "\u001b[?2004h> "]
[46.844065, "o", "                        if not check_downtime_conflict(machine, start, end, downtime):\r\n\u001b[?2004l\r"]
[46.844168, "o", "\u001b[?2004h> "]
[46.84439, "o", "                            best_schedule = (machine, start, end, duration)\r\n\u001b[?2004l\r"]
[46.844581, "o", "\u001b[?2004h>                             best_end_time = end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.844685, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.844826, "o", "            # Find earliest start time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.845082, "o", "            # Must respect: machine availability and job precedence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.845245, "o", "            earliest_start = max(machine_free_time[machine], \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.845348, "o", "                                job_last_op_end[job_id] + 1 if job_last_op_end[job_id] >= 0 else 0)\r\n\u001b[?2004l\r"]
[46.845428, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.84562, "o", "            # Check if we need to wait for downtime to pass\r\n\u001b[?2004l\r"]
[46.845707, "o", "\u001b[?2004h> "]
[46.845737, "o", "            start = earliest_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.845838, "o", "            end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.845957, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.846094, "o", "            while check_downtime_conflict(machine, start, end, downtime):\r\n\u001b[?2004l\r"]
[46.846165, "o", "\u001b[?2004h> "]
[46.846257, "o", "                # Find next available time after downtime\r\n\u001b[?2004l\r"]
[46.846328, "o", "\u001b[?2004h> "]
[46.846393, "o", "                for dt_start, dt_end in downtime[machine]:\r\n\u001b[?2004l\r"]
[46.846514, "o", "\u001b[?2004h> "]
[46.846588, "o", "                    if not (end <= dt_start or start >= dt_end):\r\n\u001b[?2004l\r"]
[46.846659, "o", "\u001b[?2004h> "]
[46.84675, "o", "                        start = dt_end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.846878, "o", "                        end = start + duration\r\n\u001b[?2004l\r"]
[46.846966, "o", "\u001b[?2004h> "]
[46.84705, "o", "                        break\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.847125, "o", "> "]
[46.847151, "o", "            if end < best_end_time:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.852218, "o", "                best_end_time = end\r\n\u001b[?2004l\r"]
[46.852309, "o", "\u001b[?2004h> "]
[46.852384, "o", "                best_schedule = (machine, start, end, duration)\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.852462, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.852552, "o", "        if best_schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.852822, "o", "            machine, start, end, duration = best_schedule\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.852943, "o", "            schedule.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.853013, "o", "                'job': job_id,\r\n\u001b[?2004l\r\u001b[?2004h>                 'op': op_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.853103, "o", "                'machine': machine,\r\n\u001b[?2004l\r"]
[46.853232, "o", "\u001b[?2004h>                 'start': start,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.853309, "o", "                'end': end,\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.853376, "o", "> "]
[46.85347, "o", "                'dur': duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.853556, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.85373, "o", "            machine_free_time[machine] = end\r\n\u001b[?2004l\r\u001b[?2004h>             job_last_op_end[job_id] = end\r\n"]
[46.853812, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.853883, "o", "    # Calculate makespan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.854123, "o", "    makespan = max(op['end'] for op in schedule) if schedule else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.854252, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.854389, "o", "    return schedule, makespan\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[46.854497, "o", "\u001b[?2004h>     # Parse all input files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.854668, "o", "    num_jobs, num_machines, jobs = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.854767, "o", "> "]
[46.854876, "o", "    downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.854942, "o", "    policy = parse_policy('/app/data/policy.json')\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.855019, "o", "> "]
[46.855228, "o", "    baseline = parse_baseline('/app/data/baseline_solution.json')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[46.855366, "o", "\u001b[?2004h>     # Solve the scheduling problem\r\n\u001b[?2004l\r"]
[46.855431, "o", "\u001b[?2004h> "]
[46.855544, "o", "    schedule, makespan = solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline)\r\n\u001b[?2004l\r"]
[46.855629, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.855872, "o", "    # Check for downtime violations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.856071, "o", "    violations = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.856282, "o", "        if check_downtime_conflict(op['machine'], op['start'], op['end'], downtime):\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.856379, "o", ">             violations += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.856495, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Determine status\r\n"]
[46.85654, "o", "\u001b[?2004l\r\u001b[?2004h>     if violations == 0:\r\n"]
[46.856623, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[46.856766, "o", "        status = \"FEASIBLE\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.856816, "o", "        status = \"INFEASIBLE\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.856903, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.856999, "o", "    # Write solution.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857074, "o", "    solution = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857159, "o", "        \"status\": status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857243, "o", "        \"makespan\": makespan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857325, "o", "        \"schedule\": schedule\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.857395, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[46.857474, "o", "\u001b[?2004h> "]
[46.857612, "o", "    with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.857683, "o", "> "]
[46.857775, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857864, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.857938, "o", "    # Write schedule.csv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.85801, "o", "    with open('/app/output/schedule.csv', 'w') as f:\r\n\u001b[?2004l\r"]
[46.858095, "o", "\u001b[?2004h> "]
[46.858313, "o", "        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\r\n\u001b[?2004l\r"]
[46.858364, "o", "\u001b[?2004h>         writer.writeheader()\r\n\u001b[?2004l\r"]
[46.858444, "o", "\u001b[?2004h> "]
[46.858529, "o", "        for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.858615, "o", "            writer.writerow(op)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[46.858706, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[46.85878, "o", "    print(f\"Schedule generated successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.858909, "o", "    print(f\"Status: {status}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.858996, "o", "> "]
[46.859062, "o", "    print(f\"Makespan: {makespan}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.859215, "o", "    print(f\"Downtime violations: {violations}\")\r\n\u001b[?2004l\r"]
[46.859309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.859353, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.859437, "o", "EOF\r\n\u001b[?2004l\r"]
[46.866836, "o", "\u001b[?2004hroot@0628284d9d7e:/app# "]
[50.376344, "i", "python3 /app/scheduler.py\n"]
[50.376609, "o", "python3 /app/scheduler.py\r\n\u001b[?2004l\r"]
[50.407408, "o", "Schedule generated successfully!\r\nStatus: FEASIBLE\r\nMakespan: 52\r\nDowntime violations: 0\r\n"]
[50.41182, "o", "\u001b[?2004hroot@0628284d9d7e:/app# "]
[56.428493, "i", "cat /app/output/solution.json\n"]
[56.429135, "o", "cat /app/output/solution.json\r\n\u001b[?2004l\r"]
[56.433158, "o", "{\r\n  \"status\": \"FEASIBLE\",\r\n  \"makespan\": 52,\r\n  \"schedule\": [\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 1,\r\n      \"machine\": 2,\r\n      \"start\": 6,\r\n      \"end\": 12,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 13,\r\n      \"end\": 18,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 0,\r\n      \"end\": 5,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 20,\r\n      \"end\": 26,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 27,\r\n      \"end\": 34,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 0,\r\n      \"machine\": 1,\r\n      \"start\": 26,\r\n      \"end\": 30,\r\n      \"dur\": 4\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 31,\r\n      \"end\": 38,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 2,\r\n      \"machine\": 2,\r\n      \"start\": 39,\r\n      \"end\": 44,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 0,\r\n      \"machine\": 0,\r\n      \"start\": 34,\r\n      \"end\": 41,\r\n      \"dur\": 7\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 42,\r\n      \"end\": 47,\r\n"]
[56.433224, "o", "      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 48,\r\n      \"end\": 52,\r\n      \"dur\": 4\r\n    }\r\n  ]\r\n}"]
[56.433652, "o", "\u001b[?2004hroot@0628284d9d7e:/app# "]
[74.479711, "i", "cat > /app/scheduler_v2.py << 'EOF'\nimport json\nimport csv\nfrom typing import List, Dict, Tuple, Set\nimport heapq\n\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = f.readlines()\n    \n    first_line = lines[0].strip().split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    \n    jobs = []\n    line_idx = 1\n    \n    for job_id in range(num_jobs):\n        num_ops = int(lines[line_idx].strip())\n        line_idx += 1\n        operations = []\n        \n        for op_id in range(num_ops):\n            parts = list(map(int, lines[line_idx].strip().split()))\n            line_idx += 1\n            num_alts = parts[0]\n            alternatives = []\n            for i in range(num_alts):\n                machine = parts[1 + i*2]\n                duration = parts[1 + i*2 + 1]\n                alternatives.append((machine, duration))\n            operations.append(alternatives)\n        \n        jobs.append(operations)\n    \n    return num_jobs, num_machines, jobs\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            machine = int(row['machine'])\n            start = int(row['start'])\n            end = int(row['end'])\n            if machine not in downtime:\n                downtime[machine] = []\n            downtime[machine].append((start, end))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, 'r') as f:\n        policy = json.load(f)\n    return policy\n\ndef parse_baseline(filename):\n    with open(filename, 'r') as f:\n        baseline = json.load(f)\n    return baseline\n\ndef check_downtime_conflict(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for dt_start, dt_end in downtime[machine]:\n        if not (end <= dt_start or start >= dt_end):\n            return True\n    return False\n\ndef get_available_time_after_downtime(machine, start, duration, downtime):\n    \"\"\"Find the earliest time >= start when operation can fit without downtime conflict\"\"\"\n    if machine not in downtime:\n        return start\n    \n    current_start = start\n    while True:\n        current_end = current_start + duration\n        conflict = False\n        for dt_start, dt_end in downtime[machine]:\n            if not (current_end <= dt_start or current_start >= dt_end):\n                current_start = dt_end\n                conflict = True\n                break\n        if not conflict:\n            return current_start\n\ndef solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline):\n    \"\"\"Improved job shop scheduling with downtime constraints\"\"\"\n    \n    freeze_until = policy.get('freeze', {}).get('freeze_until', 0)\n    baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}\n    \n    # Track state\n    schedule = {}\n    machine_events = [[] for _ in range(num_machines)]  # List of (end_time, job, op)\n    job_last_op = [-1] * num_jobs  # Last operation end time for each job\n    \n    # Priority queue: (earliest_possible_start, job, op)\n    priority_queue = []\n    scheduled_ops = set()\n    \n    # Start with first operation of each job\n    for job_id in range(num_jobs):\n        heapq.heappush(priority_queue, (0, job_id, 0))\n    \n    while priority_queue:\n        _, job_id, op_id = heapq.heappop(priority_queue)\n        \n        if (job_id, op_id) in scheduled_ops:\n            continue\n        \n        # Check if previous operation is done\n        if op_id > 0 and (job_id, op_id - 1) not in scheduled_ops:\n            heapq.heappush(priority_queue, (job_last_op[job_id], job_id, op_id))\n            continue\n        \n        alternatives = jobs[job_id][op_id]\n        best_schedule = None\n        best_end_time = float('inf')\n        \n        # Check if frozen\n        is_frozen = (job_id, op_id) in baseline_schedule and \\\n                    baseline_schedule[(job_id, op_id)]['end'] <= freeze_until\n        \n        if is_frozen:\n            baseline_op = baseline_schedule[(job_id, op_id)]\n            machine = baseline_op['machi"]
[74.479778, "i", "ne']\n            duration = baseline_op['dur']\n            start = baseline_op['start']\n            end = baseline_op['end']\n            \n            if not check_downtime_conflict(machine, start, end, downtime):\n                best_schedule = (machine, start, end, duration)\n                best_end_time = end\n        else:\n            # Try each alternative\n            for machine, duration in alternatives:\n                # Earliest start time\n                earliest_start = job_last_op[job_id] + 1 if job_last_op[job_id] >= 0 else 0\n                \n                # Get machine free time\n                if machine_events[machine]:\n                    machine_free = machine_events[machine][-1][0]\n                else:\n                    machine_free = 0\n                \n                earliest_start = max(earliest_start, machine_free)\n                \n                # Adjust for downtime\n                start = get_available_time_after_downtime(machine, earliest_start, duration, downtime)\n                end = start + duration\n                \n                if end < best_end_time:\n                    best_end_time = end\n                    best_schedule = (machine, start, end, duration)\n        \n        if best_schedule:\n            machine, start, end, duration = best_schedule\n            schedule[(job_id, op_id)] = {\n                'job': job_id,\n                'op': op_id,\n                'machine': machine,\n                'start': start,\n                'end': end,\n                'dur': duration\n            }\n            machine_events[machine].append((end, job_id, op_id))\n            machine_events[machine].sort()\n            job_last_op[job_id] = end\n            scheduled_ops.add((job_id, op_id))\n            \n            # Add next operation to queue\n            if op_id + 1 < len(jobs[job_id]):\n                heapq.heappush(priority_queue, (end, job_id, op_id + 1))\n    \n    # Convert to list\n    schedule_list = [schedule[(job_id, op_id)] \n                     for job_id in range(num_jobs) \n                     for op_id in range(len(jobs[job_id]))]\n    schedule_list.sort(key=lambda x: (x['start'], x['job'], x['op']))\n    \n    makespan = max(op['end'] for op in schedule_list) if schedule_list else 0\n    \n    return schedule_list, makespan\n\ndef main():\n    num_jobs, num_machines, jobs = parse_instance('/app/data/instance.txt')\n    downtime = parse_downtime('/app/data/downtime.csv')\n    policy = parse_policy('/app/data/policy.json')\n    baseline = parse_baseline('/app/data/baseline_solution.json')\n    \n    schedule, makespan = solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline)\n    \n    violations = 0\n    for op in schedule:\n        if check_downtime_conflict(op['machine'], op['start'], op['end'], downtime):\n            violations += 1\n    \n    status = \"FEASIBLE\" if violations == 0 else \"INFEASIBLE\"\n    \n    solution = {\n        \"status\": status,\n        \"makespan\": makespan,\n        \"schedule\": schedule\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w') as f:\n        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        writer.writeheader()\n        for op in schedule:\n            writer.writerow(op)\n    \n    print(f\"Schedule generated successfully!\")\n    print(f\"Status: {status}\")\n    print(f\"Makespan: {makespan}\")\n    print(f\"Downtime violations: {violations}\")\n    print(f\"Guard constraint (max {int(baseline['makespan'] * 1.1)}): {'PASS' if makespan <= baseline['makespan'] * 1.1 else 'FAIL'}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
