[46.81749, "i", "cat > /app/scheduler.py << 'EOF'\nimport json\nimport csv\nfrom typing import List, Dict, Tuple\nimport sys\n\n# Parse instance.txt\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = f.readlines()\n    \n    first_line = lines[0].strip().split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    \n    jobs = []\n    line_idx = 1\n    \n    for job_id in range(num_jobs):\n        num_ops = int(lines[line_idx].strip())\n        line_idx += 1\n        operations = []\n        \n        for op_id in range(num_ops):\n            parts = list(map(int, lines[line_idx].strip().split()))\n            line_idx += 1\n            num_alts = parts[0]\n            alternatives = []\n            for i in range(num_alts):\n                machine = parts[1 + i*2]\n                duration = parts[1 + i*2 + 1]\n                alternatives.append((machine, duration))\n            operations.append(alternatives)\n        \n        jobs.append(operations)\n    \n    return num_jobs, num_machines, jobs\n\n# Parse downtime.csv\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            machine = int(row['machine'])\n            start = int(row['start'])\n            end = int(row['end'])\n            if machine not in downtime:\n                downtime[machine] = []\n            downtime[machine].append((start, end))\n    return downtime\n\n# Parse policy.json\ndef parse_policy(filename):\n    with open(filename, 'r') as f:\n        policy = json.load(f)\n    return policy\n\n# Parse baseline solution\ndef parse_baseline(filename):\n    with open(filename, 'r') as f:\n        baseline = json.load(f)\n    return baseline\n\ndef check_downtime_conflict(machine, start, end, downtime):\n    \"\"\"Check if operation conflicts with machine downtime\"\"\"\n    if machine not in downtime:\n        return False\n    for dt_start, dt_end in downtime[machine]:\n        # Conflict if operation overlaps with downtime\n        if not (end <= dt_start or start >= dt_end):\n            return True\n    return False\n\ndef solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline):\n    \"\"\"Solve job shop scheduling with downtime constraints\"\"\"\n    \n    # Extract freeze policy\n    freeze_until = policy.get('freeze', {}).get('freeze_until', 0)\n    \n    # Start with baseline and try to fix violations\n    schedule = []\n    baseline_schedule = {(op['job'], op['op']): op for op in baseline['schedule']}\n    \n    # Track machine availability\n    machine_free_time = [0] * num_machines\n    job_last_op_end = [-1] * num_jobs\n    \n    # Sort operations by job and operation order\n    operations_to_schedule = []\n    for job_id in range(num_jobs):\n        for op_id in range(len(jobs[job_id])):\n            operations_to_schedule.append((job_id, op_id))\n    \n    # Schedule each operation\n    for job_id, op_id in operations_to_schedule:\n        alternatives = jobs[job_id][op_id]\n        best_schedule = None\n        best_end_time = float('inf')\n        \n        # Try each alternative (machine, duration)\n        for machine, duration in alternatives:\n            # Check if this operation is frozen\n            if (job_id, op_id) in baseline_schedule:\n                baseline_op = baseline_schedule[(job_id, op_id)]\n                if baseline_op['end'] <= freeze_until:\n                    # This operation is frozen, must keep same machine and times\n                    if machine == baseline_op['machine']:\n                        start = baseline_op['start']\n                        end = baseline_op['end']\n                        if not check_downtime_conflict(machine, start, end, downtime):\n                            best_schedule = (machine, start, end, duration)\n                            best_end_time = end\n                    continue\n            \n            # Find earliest start time\n            # Must respect: machine availability and job precedence\n            earliest_start = max(machine_free_time[machine], \n                                job_last_op_end[job_id] + 1 if jo"]
[46.817572, "i", "b_last_op_end[job_id] >= 0 else 0)\n            \n            # Check if we need to wait for downtime to pass\n            start = earliest_start\n            end = start + duration\n            \n            while check_downtime_conflict(machine, start, end, downtime):\n                # Find next available time after downtime\n                for dt_start, dt_end in downtime[machine]:\n                    if not (end <= dt_start or start >= dt_end):\n                        start = dt_end\n                        end = start + duration\n                        break\n            \n            if end < best_end_time:\n                best_end_time = end\n                best_schedule = (machine, start, end, duration)\n        \n        if best_schedule:\n            machine, start, end, duration = best_schedule\n            schedule.append({\n                'job': job_id,\n                'op': op_id,\n                'machine': machine,\n                'start': start,\n                'end': end,\n                'dur': duration\n            })\n            machine_free_time[machine] = end\n            job_last_op_end[job_id] = end\n    \n    # Calculate makespan\n    makespan = max(op['end'] for op in schedule) if schedule else 0\n    \n    return schedule, makespan\n\ndef main():\n    # Parse all input files\n    num_jobs, num_machines, jobs = parse_instance('/app/data/instance.txt')\n    downtime = parse_downtime('/app/data/downtime.csv')\n    policy = parse_policy('/app/data/policy.json')\n    baseline = parse_baseline('/app/data/baseline_solution.json')\n    \n    # Solve the scheduling problem\n    schedule, makespan = solve_schedule(num_jobs, num_machines, jobs, downtime, policy, baseline)\n    \n    # Check for downtime violations\n    violations = 0\n    for op in schedule:\n        if check_downtime_conflict(op['machine'], op['start'], op['end'], downtime):\n            violations += 1\n    \n    # Determine status\n    if violations == 0:\n        status = \"FEASIBLE\"\n    else:\n        status = \"INFEASIBLE\"\n    \n    # Write solution.json\n    solution = {\n        \"status\": status,\n        \"makespan\": makespan,\n        \"schedule\": schedule\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    # Write schedule.csv\n    with open('/app/output/schedule.csv', 'w') as f:\n        writer = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        writer.writeheader()\n        for op in schedule:\n            writer.writerow(op)\n    \n    print(f\"Schedule generated successfully!\")\n    print(f\"Status: {status}\")\n    print(f\"Makespan: {makespan}\")\n    print(f\"Downtime violations: {violations}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
