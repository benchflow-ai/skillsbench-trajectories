Expert: ['base', 'channel', 'user_name', 'classification_id', 'user_id', 'user_ip', 'workflow_id', 'workflow_name', 'workflow_version', 'created_at', 'gold_standard', 'expert', 'subject_ids', 'x', 'y', 'tool', 'frame', 'details', 'tool_label', 'rx', 'ry', 'angle', 'closed', 'points', 'retired', 'Filename', 'file_log', 'file_rad', 'Ls', 'MY', 'L2_file', 'L1B_file', 'data_end_time', 'data_start_time', 'Set', 'package', 'file_stretch_0_75', 'file_stretch_0_85', 'source', 'session', 'viewport', 'started_at', 'user_agent', 'utc_offset', 'finished_at', 'live_project', 'interventions', 'user_language', 'user_group_ids', 'subject_dimensions', 'subject_selection_state', 'workflow_translation_id', 'seen_before', 'frame_file']
[?2004hroot@4caf205a0f92:~# cat << 'EOF' > optimize_dbscan.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.cluster import DBSCAN
[?2004l[?2004h> from scipy.spatial.distance import cdist
[?2004l[?2004h> from joblib import Parallel, delayed
[?2004l[?2004h> import itertools
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> citsci = pd.read_csv('/root/data/citsci_train.csv')
[?2004l[?2004h> expert = pd.read_csv('/root/data/expert_train.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Group by image
[?2004l[?2004h> # Expert images define the universe of images we care about
[?2004l[?2004h> expert_images = expert['file_rad'].unique()
[?2004l[?2004h> citsci_grouped = citsci.groupby('file_rad')
[?2004l[?2004h> expert_grouped = expert.groupby('file_rad')
[?2004l[?2004h> 
[?2004l[?2004h> # Pre-fetch data for all expert images to avoid repeated indexing
[?2004l[?2004h> image_data = {}
[?2004l[?2004h> for img in expert_images:
[?2004l[?2004h>     # Get expert points
[?2004l[?2004h>     if img in expert_grouped.groups:
[?2004l[?2004h>         exp_pts = expert_grouped.get_group(img)[['x', 'y']].values
[?2004l[?2004h>     else:
[?2004l[?2004h>         exp_pts = np.empty((0, 2))
[?2004l[?2004h>     
[?2004l[?2004h>     # Get citizen science points
[?2004l[?2004h>     if img in citsci_grouped.groups:
[?2004l[?2004h>         cit_pts = citsci_grouped.get_group(img)[['x', 'y']].values
[?2004l[?2004h>     else:
[?2004l[?2004h>         cit_pts = np.empty((0, 2))
[?2004l[?2004h>         
[?2004l[?2004h>     image_data[img] = {'exp': exp_pts, 'cit': cit_pts}
[?2004l[?2004h> 
[?2004l[?2004h> # Define parameter grid
[?2004l[?2004h> min_samples_range = range(3, 10)
[?2004l[?2004h> epsilon_range = range(4, 26, 2)
[?2004l[?2004h> shape_weight_range = [round(x, 1) for x in np.arange(0.9, 2.0, 0.1)]
[?2004l[?2004h> 
[?2004l[?2004h> param_grid = list(itertools.product(min_samples_range, epsilon_range, shape_weight_range))
[?2004l[?2004h> 
[?2004l[?2004h> def evaluate_params(params):
[?2004l[?2004h>     min_samples, eps, w = params
[?2004l[?2004h>     
[?2004l[?2004h>     f1_scores = []
[?2004l[?2004h>     deltas = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Scaling factors for custom distance
[?2004l[?2004h>     # d = sqrt((w*dx)^2 + ((2-w)*dy)^2)
[?2004l[?2004h>     # We scale x by w and y by (2-w) then use standard Euclidean
[?2004l[?2004h>     scale_x = w
[?2004l[?2004h>     scale_y = 2 - w
[?2004l[?2004h>     
[?2004l[?2004h>     for img in expert_images:
[?2004l[?2004h>         data = image_data[img]
[?2004l[?2004h>         cit_pts = data['cit']
[?2004l[?2004h>         exp_pts = data['exp']
[?2004l[?2004h>         
[?2004l[?2004h>         # If no cit points, F1=0, delta=NaN
[?2004l[?2004h>         if len(cit_pts) == 0:
[?2004l[?2004h>             f1_scores.append(0.0)
[?2004l[?2004h>             deltas.append(np.nan)
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         # Scale points for DBSCAN
[?2004l[?2004h>         cit_pts_scaled = cit_pts.copy()
[?2004l[?2004h>         cit_pts_scaled[:, 0] *= scale_x
[?2004l[?2004h>         cit_pts_scaled[:, 1] *= scale_y
[?2004l[?2004h>         
[?2004l[?2004h>         # Run DBSCAN
[?2004l[?2004h>         # eps is applied in the scaled space
[?2004l[?2004h>         db = DBSCAN(eps=eps, min_samples=min_samples, metric='euclidean', algorithm='brute')
[?2004l[?2004h>         labels = db.fit_predict(cit_pts_scaled)
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract clusters
[?2004l[?2004h>         unique_labels = set(labels)
[?2004l[?2004h>         if -1 in unique_labels:
[?2004l[?2004h>             unique_labels.remove(-1)
[?2004l[?2004h>             
[?2004l[?2004h>         if not unique_labels:
[?2004l[?2004h>             # No clusters found
[?2004l[?2004h>             f1_scores.append(0.0)
[?2004l[?2004h>             deltas.append(np.nan)
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         # Compute centroids in ORIGINAL space
[?2004l[?2004h>         centroids = []
[?2004l[?2004h>         for l in unique_labels:
[?2004l[?2004h>             cluster_points = cit_pts[labels == l]
[?2004l[?2004h>             centroids.append(cluster_points.mean(axis=0))
[?2004l[?2004h>         centroids = np.array(centroids)
[?2004l[?2004h>         
[?2004l[?2004h>         # Match with expert points
[?2004l[?2004h>         # Greedy matching based on Euclidean distance, max 100 pixels
[?2004l[?2004h>         if len(exp_pts) == 0:
[?2004l[?2004h>             # No expert points to match against -> Precision=0, Recall=0 (undefined?), F1=0
[?2004l[?2004h>             f1_scores.append(0.0)
[?2004l[?2004h>             deltas.append(np.nan)
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         # Distance matrix (centroids vs expert)
[?2004l[?2004h>         dists = cdist(centroids, exp_pts, metric='euclidean')
[?2004l[?2004h>         
[?2004l[?2004h>         matches = []
[?2004l[?2004h>         matched_centroids = set()
[?2004l[?2004h>         matched_experts = set()
[?2004l[?2004h>         
[?2004l[?2004h>         # List of all possible pairs sorted by distance
[?2004l[?2004h>         possible_matches = []
[?2004l[?2004h>         for i in range(len(centroids)):
[?2004l[?2004h>             for j in range(len(exp_pts)):
[?2004l[?2004h>                 if dists[i, j] <= 100:
[?2004l[?2004h>                     possible_matches.append((dists[i, j], i, j))
[?2004l[?2004h>         
[?2004l[?2004h>         possible_matches.sort(key=lambda x: x[0])
[?2004l[?2004h>         
[?2004l[?2004h>         match_deltas = []
[?2004l[?2004h>         
[?2004l[?2004h>         for d, c_idx, e_idx in possible_matches:
[?2004l[?2004h>             if c_idx not in matched_centroids and e_idx not in matched_experts:
[?2004l[?2004h>                 matched_centroids.add(c_idx)
[?2004l[?2004h>                 matched_experts.add(e_idx)
[?2004l[?2004h>                 match_deltas.append(d)
[?2004l[?2004h>                 
[?2004l[?2004h>         tp = len(matched_centroids)
[?2004l[?2004h>         fp = len(centroids) - tp
[?2004l[?2004h>         fn = len(exp_pts) - tp
[?2004l[?2004h>         
[?2004l[?2004h>         if tp == 0:
[?2004l[?2004h>             f1 = 0.0
[?2004l[?2004h>             delta = np.nan
[?2004l[?2004h>         else:
[?2004l[?2004h>             precision = tp / (tp + fp)
[?2004l[?2004h>             recall = tp / (tp + fn)
[?2004l[?2004h>             f1 = 2 * (precision * recall) / (precision + recall)
[?2004l[?2004h>             delta = np.mean(match_deltas)
[?2004l[?2004h>             
[?2004l[?2004h>         f1_scores.append(f1)
[?2004l[?2004h>         deltas.append(delta)
[?2004l[?2004h>         
[?2004l[?2004h>     # Aggregate results
[?2004l[?2004h>     avg_f1 = np.mean(f1_scores)
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter out NaNs for delta average
[?2004l[?2004h>     valid_deltas = [d for d in deltas if not np.isnan(d)]
[?2004l[?2004h>     if valid_deltas:
[?2004l[?2004h>         avg_delta = np.mean(valid_deltas)
[?2004l[?2004h>     else:
[?2004l[?2004h>         avg_delta = np.nan # Should probably not happen if F1 > 0
[?2004l[?2004h>         
[?2004l[?2004h>     return {
[?2004l[?2004h>         'min_samples': min_samples,
[?2004l[?2004h>         'epsilon': eps,
[?2004l[?2004h>         'shape_weight': w,
[?2004l[?2004h>         'F1': avg_f1,
[?2004l[?2004h>         'delta': avg_delta
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Run grid search in parallel
[?2004l[?2004h> results = Parallel(n_jobs=-1)(delayed(evaluate_params)(p) for p in param_grid)
[?2004l[?2004h> results_df = pd.DataFrame(results)
[?2004l[?2004h> 
[?2004l[?2004h> # Filter results
[?2004l[?2004h> filtered_df = results_df[results_df['F1'] > 0.5].copy()
[?2004l[?2004h> 
[?2004l[?2004h> if filtered_df.empty:
[?2004l[?2004h>     print("No results with F1 > 0.5")
[?2004l[?2004h>     filtered_df.to_csv('/root/pareto_frontier.csv', index=False)
[?2004l[?2004h>     exit()
[?2004l[?2004h> 
[?2004l[?2004h> # Find Pareto frontier
[?2004l[?2004h> # Maximize F1, Minimize delta
[?2004l[?2004h> # Sort by F1 descending to make it easier
[?2004l[?2004h> filtered_df = filtered_df.sort_values('F1', ascending=False).reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> pareto_indices = []
[?2004l[?2004h> 
[?2004l[?2004h> # A simple way to find Pareto frontier for 2 objectives:
[?2004l[?2004h> # Sort by one objective (F1 desc), then keep point if it improves the other objective (delta)
[?2004l[?2004h> # relative to the best seen so far.
[?2004l[?2004h> # Since we want to MINIMIZE delta, we keep a running minimum of delta.
[?2004l[?2004h> 
[?2004l[?2004h> # However, strictly speaking, for duplicates in F1, we want the best delta.
[?2004l[?2004h> # And we need to handle the trade-off.
[?2004l[?2004h> 
[?2004l[?2004h> # Let's do a standard check:
[?2004l[?2004h> # Point A dominates B if F1(A) >= F1(B) AND delta(A) <= delta(B) 
[?2004l[?2004h> # AND (F1(A) > F1(B) OR delta(A) < delta(B))
[?2004l[?2004h> 
[?2004l[?2004h> is_pareto = []
[?2004l[?2004h> for i, row in filtered_df.iterrows():
[?2004l[?2004h>     dominated = False
[?2004l[?2004h>     for j, other in filtered_df.iterrows():
[?2004l[?2004h>         if i == j: 
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if 'other' dominates 'row'
[?2004l[?2004h>         if (other['F1'] >= row['F1'] and other['delta'] <= row['delta']) and \
[?2004l[?2004h>            (other['F1'] > row['F1'] or other['delta'] < row['delta']):
[?2004l[?2004h>             dominated = True
[?2004l[?2004h>             break
[?2004l[?2004h>     is_pareto.append(not dominated)
[?2004l[?2004h> 
[?2004l[?2004h> pareto_df = filtered_df[is_pareto].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Rounding
[?2004l[?2004h> pareto_df['F1'] = pareto_df['F1'].round(5)
[?2004l[?2004h> pareto_df['delta'] = pareto_df['delta'].round(5)
[?2004l[?2004h> pareto_df['shape_weight'] = pareto_df['shape_weight'].round(1)
[?2004l[?2004h> 
[?2004l[?2004h> # Select columns and save
[?2004l[?2004h> output_cols = ['F1', 'delta', 'min_samples', 'epsilon', 'shape_weight']
[?2004l[?2004h> pareto_df[output_cols].to_csv('/root/pareto_frontier.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print("Pareto frontier saved.")
[?2004l[?2004h> print(pareto_df[output_cols])
