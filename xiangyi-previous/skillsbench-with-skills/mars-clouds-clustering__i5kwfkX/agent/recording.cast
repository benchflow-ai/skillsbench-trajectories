[81.697775, "o", "\u001b[?2004h"]
[81.697782, "o", "> "]
[81.697935, "o", "            cluster_points = cit_pts[labels == l]\r\n\u001b[?2004l\r"]
[81.697943, "o", "\u001b[?2004h"]
[81.697974, "o", "> "]
[81.698139, "o", "            centroids.append(cluster_points.mean(axis=0))\r\n\u001b[?2004l\r"]
[81.698151, "o", "\u001b[?2004h"]
[81.698158, "o", "> "]
[81.698269, "o", "        centroids = np.array(centroids)\r\n\u001b[?2004l\r"]
[81.698277, "o", "\u001b[?2004h"]
[81.698285, "o", "> "]
[81.698321, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.698327, "o", "> "]
[81.698409, "o", "        # Match with expert points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.698514, "o", "        # Greedy matching based on Euclidean distance, max 100 pixels\r\n\u001b[?2004l\r"]
[81.698524, "o", "\u001b[?2004h"]
[81.698531, "o", "> "]
[81.698602, "o", "        if len(exp_pts) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.698743, "o", "            # No expert points to match against -> Precision=0, Recall=0 (undefined?), F1=0\r\n\u001b[?2004l\r"]
[81.698756, "o", "\u001b[?2004h> "]
[81.698819, "o", "            f1_scores.append(0.0)\r\n\u001b[?2004l\r"]
[81.698829, "o", "\u001b[?2004h"]
[81.698836, "o", "> "]
[81.698912, "o", "            deltas.append(np.nan)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.698959, "o", "            continue\r\n\u001b[?2004l\r"]
[81.698969, "o", "\u001b[?2004h> "]
[81.698999, "o", "            \r\n\u001b[?2004l\r"]
[81.699019, "o", "\u001b[?2004h> "]
[81.699112, "o", "        # Distance matrix (centroids vs expert)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699209, "o", "        dists = cdist(centroids, exp_pts, metric='euclidean')\r\n\u001b[?2004l\r"]
[81.699219, "o", "\u001b[?2004h"]
[81.69923, "o", "> "]
[81.699263, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699335, "o", "        matches = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699381, "o", "        matched_centroids = set()\r\n\u001b[?2004l\r"]
[81.699391, "o", "\u001b[?2004h"]
[81.699398, "o", "> "]
[81.699468, "o", "        matched_experts = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699497, "o", "        \r\n\u001b[?2004l\r"]
[81.699506, "o", "\u001b[?2004h"]
[81.699515, "o", "> "]
[81.699604, "o", "        # List of all possible pairs sorted by distance\r\n\u001b[?2004l\r"]
[81.699616, "o", "\u001b[?2004h"]
[81.699624, "o", "> "]
[81.699696, "o", "        possible_matches = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699757, "o", "        for i in range(len(centroids)):\r\n\u001b[?2004l\r"]
[81.699767, "o", "\u001b[?2004h"]
[81.699774, "o", "> "]
[81.699846, "o", "            for j in range(len(exp_pts)):\r\n\u001b[?2004l\r"]
[81.699856, "o", "\u001b[?2004h"]
[81.699866, "o", "> "]
[81.699936, "o", "                if dists[i, j] <= 100:\r\n\u001b[?2004l\r"]
[81.699944, "o", "\u001b[?2004h> "]
[81.70005, "o", "                    possible_matches.append((dists[i, j], i, j))\r\n\u001b[?2004l\r"]
[81.700058, "o", "\u001b[?2004h"]
[81.70007, "o", "> "]
[81.700106, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.700113, "o", "> "]
[81.700234, "o", "        possible_matches.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[81.700243, "o", "\u001b[?2004h"]
[81.70025, "o", "> "]
[81.700284, "o", "        \r\n"]
[81.700292, "o", "\u001b[?2004l\r"]
[81.70032, "o", "\u001b[?2004h> "]
[81.70041, "o", "        match_deltas = []\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.700486, "o", "        for d, c_idx, e_idx in possible_matches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.700628, "o", "            if c_idx not in matched_centroids and e_idx not in matched_experts:\r\n\u001b[?2004l\r"]
[81.712731, "o", "\u001b[?2004h"]
[81.716535, "o", "> "]
[81.716601, "o", "                matched_centroids.add(c_idx)\r\n"]
[81.716631, "o", "\u001b[?2004l\r"]
[81.718134, "o", "\u001b[?2004h>                 matched_experts.add(e_idx)\r\n\u001b[?2004l\r\u001b[?2004h>                 match_deltas.append(d)\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>         tp = len(matched_centroids)\r\n\u001b[?2004l\r\u001b[?2004h>         fp = len(centroids) - tp\r\n\u001b[?2004l\r\u001b[?2004h>         fn = len(exp_pts) - tp\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if tp == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             f1 = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>             delta = np.nan\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             precision = tp / (tp + fp)\r\n\u001b[?2004l\r\u001b[?2004h>             recall = tp / (tp + fn)\r\n\u001b[?2004l\r\u001b[?2004h>             f1 = 2 * (precision * recall) / (precision + recall)\r\n\u001b[?2004l\r\u001b[?2004h>             delta = np.mean(match_deltas)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         f1_scores.append(f1)\r\n\u001b[?2004l\r"]
[81.718165, "o", "\u001b[?2004h> "]
[81.718726, "o", "        deltas.append(delta)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     # Aggregate results\r\n\u001b[?2004l\r\u001b[?2004h>     avg_f1 = np.mean(f1_scores)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Filter out NaNs for delta average\r\n\u001b[?2004l\r\u001b[?2004h>     valid_deltas = [d for d in deltas if not np.isnan(d)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.718831, "o", "    if valid_deltas:\r\n\u001b[?2004l\r"]
[81.718872, "o", "\u001b[?2004h>         avg_delta = np.mean(valid_deltas)\r\n\u001b[?2004l\r"]
[81.718888, "o", "\u001b[?2004h> "]
[81.718956, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.719107, "o", "        avg_delta = np.nan # Should probably not happen if F1 > 0"]
[81.72425, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[81.7243, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.724317, "o", "> "]
[81.724452, "o", "        'min_samples': min_samples,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.724469, "o", "        'epsilon': eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.724478, "o", "> "]
[81.724542, "o", "        'shape_weight': w,\r\n\u001b[?2004l\r"]
[81.724557, "o", "\u001b[?2004h> "]
[81.724645, "o", "        'F1': avg_f1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.724678, "o", "> "]
[81.724714, "o", "        'delta': avg_delta\r\n\u001b[?2004l\r"]
[81.724747, "o", "\u001b[?2004h> "]
[81.724771, "o", "    }\r\n\u001b[?2004l\r"]
[81.724799, "o", "\u001b[?2004h> \r\n"]
[81.724826, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[81.724899, "o", "# Run grid search in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.724929, "o", "> "]
[81.725087, "o", "results = Parallel(n_jobs=-1)(delayed(evaluate_params)(p) for p in param_grid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.725106, "o", "> "]
[81.725168, "o", "results_df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[81.725197, "o", "\u001b[?2004h> "]
[81.725222, "o", "\r\n\u001b[?2004l\r"]
[81.725244, "o", "\u001b[?2004h> "]
[81.725274, "o", "# Filter results\r\n\u001b[?2004l\r"]
[81.725296, "o", "\u001b[?2004h"]
[81.725319, "o", "> "]
[81.725423, "o", "filtered_df = results_df[results_df['F1'] > 0.5].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.725452, "o", "> \r\n\u001b[?2004l\r"]
[81.725478, "o", "\u001b[?2004h> "]
[81.725509, "o", "if filtered_df.empty:\r\n\u001b[?2004l\r"]
[81.72555, "o", "\u001b[?2004h> "]
[81.725653, "o", "    print(\"No results with F1 > 0.5\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.725795, "o", "    filtered_df.to_csv('/root/pareto_frontier.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.72583, "o", "    exit()\r\n\u001b[?2004l\r"]
[81.725876, "o", "\u001b[?2004h> "]
[81.725914, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.72594, "o", "> "]
[81.726001, "o", "# Find Pareto frontier\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.726027, "o", "> "]
[81.726096, "o", "# Maximize F1, Minimize delta\r\n\u001b[?2004l\r"]
[81.726122, "o", "\u001b[?2004h> "]
[81.726265, "o", "# Sort by F1 descending to make it easier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.726702, "o", "filtered_df = filtered_df.sort_values('F1', ascending=False).reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pareto_indices = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.726781, "o", "# A simple way to find Pareto frontier for 2 objectives:\r\n\u001b[?2004l\r"]
[81.726818, "o", "\u001b[?2004h> "]
[81.727088, "o", "# Sort by one objective (F1 desc), then keep point if it improves the other objective (delta)\r\n\u001b[?2004l\r"]
[81.727126, "o", "\u001b[?2004h> "]
[81.727219, "o", "# relative to the best seen so far.\r\n\u001b[?2004l\r"]
[81.727247, "o", "\u001b[?2004h"]
[81.727271, "o", "> "]
[81.727462, "o", "# Since we want to MINIMIZE delta, we keep a running minimum of delta.\r\n\u001b[?2004l\r"]
[81.727498, "o", "\u001b[?2004h> "]
[81.727523, "o", "\r\n\u001b[?2004l\r"]
[81.727547, "o", "\u001b[?2004h"]
[81.72757, "o", "> "]
[81.727781, "o", "# However, strictly speaking, for duplicates in F1, we want the best delta.\r\n\u001b[?2004l\r"]
[81.727809, "o", "\u001b[?2004h"]
[81.727834, "o", "> "]
[81.727907, "o", "# And we need to handle the trade-off.\r\n\u001b[?2004l\r"]
[81.727945, "o", "\u001b[?2004h"]
[81.727972, "o", "> "]
[81.727997, "o", "\r\n\u001b[?2004l\r"]
[81.728023, "o", "\u001b[?2004h> "]
[81.728093, "o", "# Let's do a standard check:\r\n"]
[81.728119, "o", "\u001b[?2004l\r"]
[81.728145, "o", "\u001b[?2004h> "]
[81.728299, "o", "# Point A dominates B if F1(A) >= F1(B) AND delta(A) <= delta(B) \r\n\u001b[?2004l\r"]
[81.728327, "o", "\u001b[?2004h"]
[81.728352, "o", "> "]
[81.72845, "o", "# AND (F1(A) > F1(B) OR delta(A) < delta(B))\r\n\u001b[?2004l\r"]
[81.728477, "o", "\u001b[?2004h"]
[81.728503, "o", "> \r\n\u001b[?2004l\r"]
[81.728528, "o", "\u001b[?2004h> "]
[81.728561, "o", "is_pareto = []\r\n\u001b[?2004l\r"]
[81.728586, "o", "\u001b[?2004h"]
[81.728638, "o", "> "]
[81.728697, "o", "for i, row in filtered_df.iterrows():\r\n\u001b[?2004l\r"]
[81.728742, "o", "\u001b[?2004h> "]
[81.728813, "o", "    dominated = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.728832, "o", "> "]
[81.728953, "o", "    for j, other in filtered_df.iterrows():\r\n\u001b[?2004l\r"]
[81.728968, "o", "\u001b[?2004h"]
[81.728978, "o", "> "]
[81.729033, "o", "        if i == j: \r\n\u001b[?2004l\r"]
[81.729071, "o", "\u001b[?2004h> "]
[81.729133, "o", "            continue\r\n\u001b[?2004l\r"]
[81.729166, "o", "\u001b[?2004h> "]
[81.729199, "o", "        \r\n\u001b[?2004l\r"]
[81.729232, "o", "\u001b[?2004h"]
[81.729243, "o", "> "]
[81.729367, "o", "        # Check if 'other' dominates 'row'\r\n\u001b[?2004l\r"]
[81.729386, "o", "\u001b[?2004h> "]
[81.729598, "o", "        if (other['F1'] >= row['F1'] and other['delta'] <= row['delta']) and \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.729615, "o", "> "]
[81.729807, "o", "           (other['F1'] > row['F1'] or other['delta'] < row['delta']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.729823, "o", "> "]
[81.729903, "o", "            dominated = True\r\n\u001b[?2004l\r"]
[81.729916, "o", "\u001b[?2004h"]
[81.729927, "o", "> "]
[81.729987, "o", "            break\r\n\u001b[?2004l\r"]
[81.730029, "o", "\u001b[?2004h> "]
[81.730134, "o", "    is_pareto.append(not dominated)\r\n\u001b[?2004l\r"]
[81.730146, "o", "\u001b[?2004h> "]
[81.730159, "o", "\r\n\u001b[?2004l\r"]
[81.730185, "o", "\u001b[?2004h"]
[81.730195, "o", "> "]
[81.730309, "o", "pareto_df = filtered_df[is_pareto].copy()\r\n\u001b[?2004l\r"]
[81.730336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.73035, "o", "\u001b[?2004h> "]
[81.730388, "o", "# Rounding\r\n\u001b[?2004l\r"]
[81.730423, "o", "\u001b[?2004h> "]
[81.730551, "o", "pareto_df['F1'] = pareto_df['F1'].round(5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.730575, "o", "> "]
[81.730686, "o", "pareto_df['delta'] = pareto_df['delta'].round(5)\r\n\u001b[?2004l\r"]
[81.730701, "o", "\u001b[?2004h> "]
[81.730867, "o", "pareto_df['shape_weight'] = pareto_df['shape_weight'].round(1)\r\n\u001b[?2004l\r"]
[81.73088, "o", "\u001b[?2004h> "]
[81.730894, "o", "\r\n\u001b[?2004l\r"]
[81.730924, "o", "\u001b[?2004h> "]
[81.731019, "o", "# Select columns and save\r\n\u001b[?2004l\r"]
[81.731033, "o", "\u001b[?2004h"]
[81.731045, "o", "> "]
[81.731216, "o", "output_cols = ['F1', 'delta', 'min_samples', 'epsilon', 'shape_weight']\r\n\u001b[?2004l\r"]
[81.731246, "o", "\u001b[?2004h"]
[81.731259, "o", "> "]
[81.731457, "o", "pareto_df[output_cols].to_csv('/root/pareto_frontier.csv', index=False)\r\n\u001b[?2004l\r"]
[81.731473, "o", "\u001b[?2004h"]
[81.731486, "o", "> \r\n"]
[81.731498, "o", "\u001b[?2004l\r"]
[81.731509, "o", "\u001b[?2004h"]
[81.73152, "o", "> "]
[81.731627, "o", "print(\"Pareto frontier saved.\")\r\n\u001b[?2004l\r"]
[81.731643, "o", "\u001b[?2004h"]
[81.731655, "o", "> "]
[81.731752, "o", "print(pareto_df[output_cols])\r\n\u001b[?2004l\r"]
[81.731767, "o", "\u001b[?2004h> "]
[81.731797, "o", "EOF\r\n"]
[81.731808, "o", "\u001b[?2004l\r"]
[81.753999, "o", "\u001b[?2004hroot@4caf205a0f92:~# "]
