[72.046087, "o", "            if neighbor not in visited:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.046146, "o", "                visited.add(neighbor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.046191, "o", "> "]
[72.046238, "o", "                queue.append(neighbor)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[72.046294, "o", "\u001b[?2004h> "]
[72.046351, "o", "    components.append(component)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.046403, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.046455, "o", "# Find largest component\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.0465, "o", "largest_component = max(components, key=len)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.046609, "o", "print(f\"Largest component: {len(largest_component)} triangles\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.046661, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.046711, "o", "# Get material ID from largest component\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.046756, "o", "> "]
[72.046808, "o", "main_material_id = material_ids[largest_component[0]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.046854, "o", "> "]
[72.046903, "o", "print(f\"Material ID: {main_material_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.046945, "o", "\u001b[?2004h> "]
[72.046997, "o", "# Calculate volume using signed volume formula\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.047043, "o", "> def dot(v1, v2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047137, "o", "    return v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.047189, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047241, "o", "def cross(v1, v2):\r\n\u001b[?2004l\r\u001b[?2004h>     return (\r\n\u001b[?2004l\r"]
[72.047291, "o", "\u001b[?2004h> "]
[72.047338, "o", "        v1[1]*v2[2] - v1[2]*v2[1],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047379, "o", "        v1[2]*v2[0] - v1[0]*v2[2],\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.047427, "o", "> "]
[72.04748, "o", "        v1[0]*v2[1] - v1[1]*v2[0]\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[72.047528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047583, "o", "def signed_volume_of_triangle(v1, v2, v3):\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.04763, "o", "> "]
[72.047676, "o", "    # Volume = (1/6) * v1 · (v2 × v3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047747, "o", "    return dot(v1, cross(v2, v3)) / 6.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.047795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047836, "o", "total_volume = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.047881, "o", "for tri_idx in largest_component:\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.047933, "o", "> "]
[72.047981, "o", "    v1, v2, v3 = triangles[tri_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.048059, "o", "    total_volume += signed_volume_of_triangle(v1, v2, v3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.048156, "o", "# Take absolute value for volume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.04821, "o", "total_volume = abs(total_volume)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048257, "o", "> "]
[72.048306, "o", "print(f\"Volume: {total_volume} cm³\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048361, "o", "> "]
[72.048414, "o", "# Material density table\r\n\u001b[?2004l\r\u001b[?2004h> density_table = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048461, "o", ">     1: 0.10,   # Generic Debris\r\n\u001b[?2004l\r"]
[72.048509, "o", "\u001b[?2004h> "]
[72.048556, "o", "    10: 7.85,  # Standard Steel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.048603, "o", "    25: 2.70,  # Aluminum 6061\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.04865, "o", "> "]
[72.048689, "o", "    42: 5.55,  # Unobtanium\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.04874, "o", "    99: 11.34  # Lead\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048788, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.048845, "o", "density = density_table[main_material_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.048891, "o", "> "]
[72.048939, "o", "print(f\"Density: {density} g/cm³\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.04898, "o", "# Calculate mass\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.049042, "o", "> "]
[72.04909, "o", "mass = total_volume * density\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049136, "o", "print(f\"Mass: {mass} g\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.04919, "o", "\u001b[?2004h> "]
[72.049238, "o", "# Save to JSON\r\n\u001b[?2004l\r\u001b[?2004h> result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049295, "o", "    \"main_part_mass\": round(mass, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.049342, "o", "> "]
[72.049387, "o", "    \"material_id\": main_material_id\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.049434, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049507, "o", "with open('/root/mass_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049579, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.049625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049688, "o", "print(f\"\\nSaved to /root/mass_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.049753, "o", "print(json.dumps(result, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.049807, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[72.071523, "o", "Largest component: 128 triangles\r\nMaterial ID: 42\r\n"]
[72.071661, "o", "Volume: 6242.890312594912 cm³\r\nDensity: 5.55 g/cm³\r\nMass: 34648.04123490176 g\r\n"]
[72.071717, "o", "\r\nSaved to /root/mass_report.json\r\n"]
[72.071777, "o", "{\r\n  \"main_part_mass\": 34648.04,\r\n  \"material_id\": 42\r\n}\r\n"]
[72.07568, "o", "\u001b[?2004hroot@1d410785f904:~# "]
[79.009167, "i", "cat /root/mass_report.json\n"]
[79.009374, "o", "cat /root/mass_report.json\r\n\u001b[?2004l\r"]
[79.010152, "o", "{\r\n  \"main_part_mass\": 34648.04,\r\n  \"material_id\": 42\r\n}"]
