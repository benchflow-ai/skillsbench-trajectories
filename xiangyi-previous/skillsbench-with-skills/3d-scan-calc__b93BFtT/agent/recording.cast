[72.041532, "i", "python3 << 'EOF'\nimport struct\nfrom collections import defaultdict, deque\nimport json\n\n# Parse binary STL\nwith open('/root/scan_data.stl', 'rb') as f:\n    header = f.read(80)\n    num_triangles = struct.unpack('<I', f.read(4))[0]\n    \n    triangles = []\n    material_ids = []\n    \n    for i in range(num_triangles):\n        normal = struct.unpack('<3f', f.read(12))\n        v1 = struct.unpack('<3f', f.read(12))\n        v2 = struct.unpack('<3f', f.read(12))\n        v3 = struct.unpack('<3f', f.read(12))\n        material_id = struct.unpack('<H', f.read(2))[0]\n        \n        triangles.append((v1, v2, v3))\n        material_ids.append(material_id)\n\n# Build edge-to-triangle adjacency\ndef make_edge_key(v1, v2):\n    return tuple(sorted([v1, v2]))\n\nedge_to_triangles = defaultdict(list)\nfor tri_idx, (v1, v2, v3) in enumerate(triangles):\n    edge_to_triangles[make_edge_key(v1, v2)].append(tri_idx)\n    edge_to_triangles[make_edge_key(v2, v3)].append(tri_idx)\n    edge_to_triangles[make_edge_key(v3, v1)].append(tri_idx)\n\n# Build triangle adjacency graph\ntriangle_neighbors = defaultdict(set)\nfor edge, tri_list in edge_to_triangles.items():\n    for i, tri1 in enumerate(tri_list):\n        for tri2 in tri_list[i+1:]:\n            triangle_neighbors[tri1].add(tri2)\n            triangle_neighbors[tri2].add(tri1)\n\n# Find connected components using BFS\nvisited = set()\ncomponents = []\n\nfor start_tri in range(len(triangles)):\n    if start_tri in visited:\n        continue\n    \n    component = []\n    queue = deque([start_tri])\n    visited.add(start_tri)\n    \n    while queue:\n        tri_idx = queue.popleft()\n        component.append(tri_idx)\n        \n        for neighbor in triangle_neighbors[tri_idx]:\n            if neighbor not in visited:\n                visited.add(neighbor)\n                queue.append(neighbor)\n    \n    components.append(component)\n\n# Find largest component\nlargest_component = max(components, key=len)\nprint(f\"Largest component: {len(largest_component)} triangles\")\n\n# Get material ID from largest component\nmain_material_id = material_ids[largest_component[0]]\nprint(f\"Material ID: {main_material_id}\")\n\n# Calculate volume using signed volume formula\ndef dot(v1, v2):\n    return v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]\n\ndef cross(v1, v2):\n    return (\n        v1[1]*v2[2] - v1[2]*v2[1],\n        v1[2]*v2[0] - v1[0]*v2[2],\n        v1[0]*v2[1] - v1[1]*v2[0]\n    )\n\ndef signed_volume_of_triangle(v1, v2, v3):\n    # Volume = (1/6) * v1 · (v2 × v3)\n    return dot(v1, cross(v2, v3)) / 6.0\n\ntotal_volume = 0.0\nfor tri_idx in largest_component:\n    v1, v2, v3 = triangles[tri_idx]\n    total_volume += signed_volume_of_triangle(v1, v2, v3)\n\n# Take absolute value for volume\ntotal_volume = abs(total_volume)\nprint(f\"Volume: {total_volume} cm³\")\n\n# Material density table\ndensity_table = {\n    1: 0.10,   # Generic Debris\n    10: 7.85,  # Standard Steel\n    25: 2.70,  # Aluminum 6061\n    42: 5.55,  # Unobtanium\n    99: 11.34  # Lead\n}\n\ndensity = density_table[main_material_id]\nprint(f\"Density: {density} g/cm³\")\n\n# Calculate mass\nmass = total_volume * density\nprint(f\"Mass: {mass} g\")\n\n# Save to JSON\nresult = {\n    \"main_part_mass\": round(mass, 2),\n    \"material_id\": main_material_id\n}\n\nwith open('/root/mass_report.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint(f\"\\nSaved to /root/mass_report.json\")\nprint(json.dumps(result, indent=2))\n\nEOF\n"]
