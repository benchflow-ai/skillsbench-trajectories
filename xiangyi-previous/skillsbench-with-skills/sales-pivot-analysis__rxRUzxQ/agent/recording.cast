[22.27993, "i", "python3 - <<'PY'\nimport pdfplumber, pandas as pd\npdf = pdfplumber.open('/root/population.pdf')\nprint('pages', len(pdf.pages))\npage = pdf.pages[0]\ntext = page.extract_text()\nprint(text[:1000])\n# try extract table\nfor i, p in enumerate(pdf.pages[:2]):\n    tables = p.extract_tables()\n    print('page', i, 'tables', len(tables))\n    if tables:\n        for t in tables:\n            print('table rows', len(t))\n            print(t[:3])\nPY\n"]
