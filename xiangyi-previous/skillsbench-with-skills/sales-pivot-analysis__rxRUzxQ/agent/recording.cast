[148.834446, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[148.834488, "o", "    for table in p.extract_tables():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.834548, "o", "        for row in table:\r\n\u001b[?2004l\r"]
[148.834599, "o", "\u001b[?2004h> "]
[148.834663, "o", "            if not row or len(row)<4:\r\n\u001b[?2004l\r"]
[148.834692, "o", "\u001b[?2004h> "]
[148.834759, "o", "                continue\r\n\u001b[?2004l\r"]
[148.834786, "o", "\u001b[?2004h> "]
[148.834905, "o", "            row=[(c or '').strip() for c in row]\r\n\u001b[?2004l\r"]
[148.834952, "o", "\u001b[?2004h> "]
[148.835087, "o", "            if not row[0] or row[0].upper().startswith('SA2_CODE'):\r\n\u001b[?2004l\r"]
[148.835145, "o", "\u001b[?2004h> "]
[148.835189, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.835241, "o", "> "]
[148.835312, "o", "            if not re.match(r'^\\d+$', row[0]):\r\n\u001b[?2004l\r"]
[148.835384, "o", "\u001b[?2004h> "]
[148.835427, "o", "                continue\r\n\u001b[?2004l\r"]
[148.835473, "o", "\u001b[?2004h> "]
[148.835531, "o", "            rows.append(row[:4])\r\n\u001b[?2004l\r"]
[148.835639, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.83569, "o", "\u001b[?2004h> "]
[148.835772, "o", "pop_df = pd.DataFrame(rows, columns=['SA2_CODE','SA2_NAME','STATE','POPULATION_2023'])\r\n\u001b[?2004l\r"]
[148.835816, "o", "\u001b[?2004h> "]
[148.83592, "o", "pop_df['SA2_CODE']=pop_df['SA2_CODE'].astype(int)\r\n\u001b[?2004l\r"]
[148.83597, "o", "\u001b[?2004h> "]
[148.836158, "o", "pop_df['POPULATION_2023']=pop_df['POPULATION_2023'].str.replace(',','').astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.836205, "o", "> \r\n\u001b[?2004l\r"]
[148.836232, "o", "\u001b[?2004h> "]
[148.83628, "o", "# Read income data\r\n\u001b[?2004l\r"]
[148.836326, "o", "\u001b[?2004h> "]
[148.836426, "o", "income = pd.read_excel('/root/income.xlsx', sheet_name='Data')\r\n\u001b[?2004l\r"]
[148.836473, "o", "\u001b[?2004h> "]
[148.836561, "o", "income['SA2_CODE']=income['SA2_CODE'].astype(int)\r\n\u001b[?2004l\r"]
[148.836607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.836654, "o", "\u001b[?2004h> # Merge\r\n"]
[148.836706, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[148.836873, "o", "merged = pd.merge(pop_df, income, on='SA2_CODE', how='left', suffixes=('', '_income'))\r\n\u001b[?2004l\r"]
[148.83692, "o", "\u001b[?2004h> "]
[148.836993, "o", "if 'SA2_NAME_income' in merged.columns:\r\n\u001b[?2004l\r"]
[148.837045, "o", "\u001b[?2004h> "]
[148.837153, "o", "    merged = merged.drop(columns=['SA2_NAME_income'])\r\n\u001b[?2004l\r"]
[148.837204, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.837246, "o", "\u001b[?2004h> "]
[148.837291, "o", "# Coerce numeric columns\r\n\u001b[?2004l\r"]
[148.837337, "o", "\u001b[?2004h> "]
[148.837494, "o", "merged['MEDIAN_INCOME'] = pd.to_numeric(merged['MEDIAN_INCOME'], errors='coerce')\r\n\u001b[?2004l\r"]
[148.83754, "o", "\u001b[?2004h> "]
[148.837698, "o", "merged['EARNERS'] = pd.to_numeric(merged['EARNERS'], errors='coerce')\r\n\u001b[?2004l\r"]
[148.837723, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.837784, "o", "\u001b[?2004h> "]
[148.837832, "o", "# Quartiles based on MEDIAN_INCOME\r\n\u001b[?2004l\r"]
[148.837883, "o", "\u001b[?2004h> "]
[148.838063, "o", "merged['Quarter'] = pd.qcut(merged['MEDIAN_INCOME'], 4, labels=['Q1','Q2','Q3','Q4'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.838118, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[148.838171, "o", "> # Total column\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.838221, "o", "> "]
[148.838317, "o", "merged['Total'] = merged['EARNERS'] * merged['MEDIAN_INCOME']\r\n\u001b[?2004l\r"]
[148.838369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[148.83842, "o", "\u001b[?2004h> # Pivot tables\r\n\u001b[?2004l\r"]
[148.838468, "o", "\u001b[?2004h> "]
[148.838649, "o", "population_by_state = merged.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')\r\n\u001b[?2004l\r"]
[148.8387, "o", "\u001b[?2004h> "]
[148.838867, "o", "earners_by_state = merged.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')\r\n\u001b[?2004l\r"]
[148.838893, "o", "\u001b[?2004h> "]
[148.839103, "o", "regions_by_state = merged.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.839149, "o", "> "]
[148.83938, "o", "state_income_quartile = merged.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum')\r\n\u001b[?2004l\r"]
[148.839469, "o", "\u001b[?2004h> "]
[148.839671, "o", "state_income_quartile = state_income_quartile.reindex(columns=['Q1','Q2','Q3','Q4'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.839725, "o", "> \r\n\u001b[?2004l\r"]
[148.839767, "o", "\u001b[?2004h> # Write to Excel\r\n\u001b[?2004l\r"]
[148.839815, "o", "\u001b[?2004h> "]
[148.839888, "o", "output = '/root/demographic_analysis.xlsx'\r\n\u001b[?2004l\r"]
[148.839934, "o", "\u001b[?2004h> "]
[148.840042, "o", "with pd.ExcelWriter(output, engine='openpyxl') as writer:\r\n\u001b[?2004l\r"]
[148.84009, "o", "\u001b[?2004h> "]
[148.840221, "o", "    population_by_state.to_excel(writer, sheet_name='Population by State')\r\n\u001b[?2004l\r"]
[148.840327, "o", "\u001b[?2004h> "]
[148.840403, "o", "    earners_by_state.to_excel(writer, sheet_name='Earners by State')\r\n\u001b[?2004l\r"]
[148.840454, "o", "\u001b[?2004h> "]
[148.8406, "o", "    regions_by_state.to_excel(writer, sheet_name='Regions by State')\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.84065, "o", "> "]
[148.840814, "o", "    state_income_quartile.to_excel(writer, sheet_name='State Income Quartile')\r\n\u001b[?2004l\r"]
[148.840862, "o", "\u001b[?2004h> "]
[148.840992, "o", "    merged.to_excel(writer, sheet_name='SourceData', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[148.841049, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[148.841088, "o", "print('saved', output)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[149.930717, "i", "ls -l /root/demographic_analysis.xlsx\n"]
[149.930954, "o", "ls -l /root/demographic_analysis.xlsx\r\n"]
