[100.610557, "i", "python3 - <<'PY'\nimport pdfplumber, pandas as pd, numpy as np, re\n# Extract population data\npdf = pdfplumber.open('/root/population.pdf')\nrows=[]\nfor p in pdf.pages:\n    for table in p.extract_tables():\n        for row in table:\n            if not row or len(row)<4:\n                continue\n            row=[(c or '').strip() for c in row]\n            if not row[0] or row[0].upper().startswith('SA2_CODE'):\n                continue\n            if not re.match(r'^\\d+$', row[0]):\n                continue\n            rows.append(row[:4])\n\npop_df = pd.DataFrame(rows, columns=['SA2_CODE','SA2_NAME','STATE','POPULATION_2023'])\npop_df['SA2_CODE']=pop_df['SA2_CODE'].astype(int)\npop_df['POPULATION_2023']=pop_df['POPULATION_2023'].str.replace(',','').astype(int)\n\n# Read income data\nincome = pd.read_excel('/root/income.xlsx', sheet_name='Data')\nincome['SA2_CODE']=income['SA2_CODE'].astype(int)\n\n# Merge\nmerged = pd.merge(pop_df, income, on='SA2_CODE', how='left', suffixes=('', '_income'))\n# If SA2_NAME from income exists, keep population's SA2_NAME\nif 'SA2_NAME_income' in merged.columns:\n    merged = merged.drop(columns=['SA2_NAME_income'])\n\n# Quartiles based on MEDIAN_INCOME\nmedian = merged['MEDIAN_INCOME']\nquartiles = pd.qcut(median, 4, labels=['Q1','Q2','Q3','Q4'])\nmerged['Quarter'] = quartiles\n\n# Total column\nmerged['Total'] = merged['EARNERS'] * merged['MEDIAN_INCOME']\n\n# Pivot tables\npopulation_by_state = merged.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')\nearners_by_state = merged.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')\nregions_by_state = merged.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')\nstate_income_quartile = merged.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum')\n# Ensure columns order\nstate_income_quartile = state_income_quartile.reindex(columns=['Q1','Q2','Q3','Q4'])\n\n# Write to Excel\noutput = '/root/demographic_analysis.xlsx'\nwith pd.ExcelWriter(output, engine='openpyxl') as writer:\n    population_by_state.to_excel(writer, sheet_name='Population by State')\n    earners_by_state.to_excel(writer, sheet_name='Earners by State')\n    regions_by_state.to_excel(writer, sheet_name='Regions by State')\n    state_income_quartile.to_excel(writer, sheet_name='State Income Quartile')\n    merged.to_excel(writer, sheet_name='SourceData', index=False)\n\nprint('saved', output)\nPY\n"]
