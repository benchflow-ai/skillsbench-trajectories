[64.601595, "i", "python3 - <<'PY'\nimport pdfplumber, pandas as pd, numpy as np, re\npdf = pdfplumber.open('/root/population.pdf')\nrows=[]\nfor p in pdf.pages:\n    tables = p.extract_tables()\n    for table in tables:\n        for row in table:\n            if not row or len(row)<4: continue\n            # strip\n            row=[(c or '').strip() for c in row]\n            if not row[0] or row[0].upper().startswith('SA2_CODE'): \n                continue\n            # some header fragments: skip non-numeric codes\n            if not re.match(r'^\\d+$', row[0]):\n                continue\n            rows.append(row[:4])\n\npop_df = pd.DataFrame(rows, columns=['SA2_CODE','SA2_NAME','STATE','POPULATION_2023'])\n# clean numeric\npop_df['SA2_CODE']=pop_df['SA2_CODE'].astype(int)\npop_df['POPULATION_2023']=pop_df['POPULATION_2023'].str.replace(',','').astype(int)\nprint('population rows', len(pop_df), 'unique codes', pop_df['SA2_CODE'].nunique())\nprint(pop_df.head())\n\nincome = pd.read_excel('/root/income.xlsx', sheet_name='Data')\n# ensure numeric\nincome['SA2_CODE']=income['SA2_CODE'].astype(int)\n\n# merge\nmerged = pd.merge(pop_df, income, on='SA2_CODE', how='left')\nprint('merged rows', len(merged), 'missing income', merged['EARNERS'].isna().sum())\nprint(merged.head())\nPY\n"]
