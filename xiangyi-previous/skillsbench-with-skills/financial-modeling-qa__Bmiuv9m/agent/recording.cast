[157.899898, "i", "cat << 'EOF' > /root/solution.py\nimport pandas as pd\nimport numpy as np\n\ndef score_turn(rolls):\n    scores = {}\n    # 1. High and Often\n    max_val = max(rolls)\n    scores['High and Often'] = max_val * rolls.count(max_val)\n    # 2. Summation\n    scores['Summation'] = sum(rolls)\n    # 3. Highs and Lows\n    scores['Highs and Lows'] = max(rolls) * min(rolls) * (max(rolls) - min(rolls))\n    # 4. Only two numbers\n    if len(set(rolls)) <= 2:\n        scores['Only two numbers'] = 30\n    else:\n        scores['Only two numbers'] = 0\n    # 5. All the numbers\n    if sorted(rolls) == [1, 2, 3, 4, 5, 6]:\n        scores['All the numbers'] = 40\n    else:\n        scores['All the numbers'] = 0\n    # 6. Ordered subset of four\n    scores['Ordered subset of four'] = 0\n    for i in range(3): # Check start at index 0, 1, 2\n        subset = rolls[i:i+4]\n        if len(subset) == 4:\n            is_increasing = all(subset[j+1] == subset[j] + 1 for j in range(3))\n            is_decreasing = all(subset[j+1] == subset[j] - 1 for j in range(3))\n            if is_increasing or is_decreasing:\n                scores['Ordered subset of four'] = 50\n                break\n    return scores\n\ndef get_max_game_score(turn1_rolls, turn2_rolls):\n    s1 = score_turn(turn1_rolls)\n    s2 = score_turn(turn2_rolls)\n    max_score = 0\n    categories = list(s1.keys())\n    for c1 in categories:\n        for c2 in categories:\n            if c1 != c2:\n                max_score = max(max_score, s1[c1] + s2[c2])\n    return max_score\n\n# Load data\ndf = pd.read_excel('/root/data.xlsx', sheet_name='Data', skiprows=7)\ndf.columns = [f'col{i}' for i in range(len(df.columns))]\n\n# Turn number is col2, Game number is col3, rolls are col4-9\ndata = df[['col2', 'col3', 'col4', 'col5', 'col6', 'col7', 'col8', 'col9']]\nfor col in data.columns:\n    data.loc[:, col] = pd.to_numeric(data[col], errors='coerce')\n\ndata = data.dropna()\n\ngame_scores = {}\nfor game_id, group in data.groupby('col3'):\n    game_id = int(game_id)\n    if len(group) == 2:\n        turns = group.sort_values('col2')\n        t1_rolls = turns.iloc[0][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\n        t2_rolls = turns.iloc[1][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\n        game_scores[game_id] = get_max_game_score(t1_rolls, t2_rolls)\n\np1_wins = 0\np2_wins = 0\n\nmax_game = int(max(game_scores.keys()))\nfor i in range(1, max_game, 2):\n    g1 = i\n    g2 = i + 1\n    if g1 in game_scores and g2 in game_scores:\n        score1 = game_scores[g1]\n        score2 = game_scores[g2]\n        if score1 > score2:\n            p1_wins += 1\n        elif score2 > score1:\n            p2_wins += 1\n\nprint(p1_wins - p2_wins)\nEOF\npython3 /root/solution.py > /root/answer.txt\ncat /root/answer.txt\n"]
