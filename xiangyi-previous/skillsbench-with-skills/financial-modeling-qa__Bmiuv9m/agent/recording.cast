[157.901914, "o", "    scores['High and Often'] = max_val * rolls.count(max_val)\r\n\u001b[?2004l\r"]
[157.901957, "o", "\u001b[?2004h> "]
[157.902064, "o", "    # 2. Summation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.902186, "o", "    scores['Summation'] = sum(rolls)\r\n\u001b[?2004l\r"]
[157.902351, "o", "\u001b[?2004h>     # 3. Highs and Lows\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.902436, "o", "> "]
[157.902765, "o", "    scores['Highs and Lows'] = max(rolls) * min(rolls) * (max(rolls) - min(rolls))\r\n\u001b[?2004l\r"]
[157.902827, "o", "\u001b[?2004h> "]
[157.902872, "o", "    # 4. Only two numbers\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.90292, "o", "> "]
[157.903092, "o", "    if len(set(rolls)) <= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.903149, "o", "        scores['Only two numbers'] = 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.903192, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.903324, "o", "        scores['Only two numbers'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.90342, "o", "    # 5. All the numbers\r\n\u001b[?2004l\r"]
[157.903464, "o", "\u001b[?2004h> "]
[157.903571, "o", "    if sorted(rolls) == [1, 2, 3, 4, 5, 6]:\r\n\u001b[?2004l\r"]
[157.903614, "o", "\u001b[?2004h> "]
[157.903721, "o", "        scores['All the numbers'] = 40\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.903782, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.903905, "o", "        scores['All the numbers'] = 0\r\n\u001b[?2004l\r"]
[157.903943, "o", "\u001b[?2004h> "]
[157.904029, "o", "    # 6. Ordered subset of four\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.904065, "o", "> "]
[157.904167, "o", "    scores['Ordered subset of four'] = 0\r\n\u001b[?2004l\r"]
[157.904206, "o", "\u001b[?2004h> "]
[157.904333, "o", "    for i in range(3): # Check start at index 0, 1, 2\r\n\u001b[?2004l\r"]
[157.904372, "o", "\u001b[?2004h> "]
[157.90447, "o", "        subset = rolls[i:i+4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[157.904509, "o", "> "]
[157.904546, "o", "        if len(subset) == 4:\r\n\u001b[?2004l\r"]
[157.904581, "o", "\u001b[?2004h> "]
[157.904792, "o", "            is_increasing = all(subset[j+1] == subset[j] + 1 for j in range(3))\r\n\u001b[?2004l\r"]
[157.904827, "o", "\u001b[?2004h> "]
[157.905029, "o", "            is_decreasing = all(subset[j+1] == subset[j] - 1 for j in range(3))\r\n\u001b[?2004l\r"]
[157.905065, "o", "\u001b[?2004h> "]
[157.91099, "o", "            if is_increasing or is_decreasing:\r\n\u001b[?2004l\r\u001b[?2004h>                 scores['Ordered subset of four'] = 50\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>     return scores\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_max_game_score(turn1_rolls, turn2_rolls):\r\n\u001b[?2004l\r\u001b[?2004h>     s1 = score_turn(turn1_rolls)\r\n\u001b[?2004l\r\u001b[?2004h>     s2 = score_turn(turn2_rolls)\r\n\u001b[?2004l\r\u001b[?2004h>     max_score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     categories = list(s1.keys())\r\n\u001b[?2004l\r\u001b[?2004h>     for c1 in categories:\r\n\u001b[?2004l\r\u001b[?2004h>         for c2 in categories:\r\n\u001b[?2004l\r\u001b[?2004h>             if c1 != c2:\r\n\u001b[?2004l\r\u001b[?2004h>                 max_score = max(max_score, s1[c1] + s2[c2])\r\n\u001b[?2004l\r\u001b[?2004h>     return max_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> df = pd.read_excel('/root/data.xlsx', sheet_name='Data', skiprows=7)\r\n\u001b[?2004l\r\u001b[?2004h> df.columns = [f'col{i}' for i in range(len(df.columns))]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Turn number is col2, Game number is col3, rolls are col4-9\r\n\u001b[?2004l\r\u001b[?2004h> data = df[['col2', 'col3', 'col4', 'col5', 'col6', 'col7', 'col8', 'col9']]\r\n\u001b[?2004l\r\u001b[?2004h> for col in data.columns:\r\n\u001b[?2004l\r\u001b[?2004h>     data.loc[:, col] = pd.to_numeric(data[col], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = data.dropna()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> game_scores = {}\r\n\u001b[?2004l\r\u001b[?2004h> for game_id, group in data.groupby('col3'):\r\n\u001b[?2004l\r\u001b[?2004h>     game_id = int(game_id)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(group) == 2:\r\n\u001b[?2004l\r\u001b[?2004h>         turns = group.sort_values('col2')\r\n\u001b[?2004l\r\u001b[?2004h>         t1_rolls = turns.iloc[0][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\r\n\u001b[?2004l\r\u001b[?2004h>         t2_rolls = turns.iloc[1][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\r\n\u001b[?2004l\r\u001b[?2004h>         game_scores[game_id] = get_max_game_score(t1_rolls, t2_rolls)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p1_wins = 0\r\n\u001b[?2004l\r\u001b[?2004h> p2_wins = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> max_game = int(max(game_scores.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, max_game, 2):\r\n\u001b[?2004l\r\u001b[?2004h>     g1 = i\r\n\u001b[?2004l\r\u001b[?2004h>     g2 = i + 1\r\n\u001b[?2004l\r\u001b[?2004h>     if g1 in game_scores and g2 in game_scores:\r\n\u001b[?2004l\r\u001b[?2004h>         score1 = game_scores[g1]\r\n\u001b[?2004l\r\u001b[?2004h>         score2 = game_scores[g2]\r\n\u001b[?2004l\r\u001b[?2004h>         if score1 > score2:\r\n\u001b[?2004l\r\u001b[?2004h>             p1_wins += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.911068, "o", "        elif score2 > score1:\r\n\u001b[?2004l\r"]
[157.911115, "o", "\u001b[?2004h> "]
[157.911164, "o", "            p2_wins += 1\r\n"]
[157.911212, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[157.911254, "o", "\u001b[?2004h> "]
[157.911322, "o", "print(p1_wins - p2_wins)\r\n\u001b[?2004l\r"]
