[28.905778, "i", "python3 /app/skills/search-driving-distance/scripts/search_driving_distance.py --help\n"]
[28.906114, "o", "python3 /app/skills/search-driving-distance/scripts/search_driving_distance.py --help\r\n\u001b[?2004l\r"]
[29.597376, "o", "usage: search_driving_distance.py [-h] [--origin ORIGIN] [--destination DESTINATION] [--mode MODE] [--path PATH] [--api-key API_KEY]\r\n\r\nLookup distance, duration, and cost between cities.\r\n\r\noptions:\r\n  -h, --help            show this help message and exit\r\n  --origin ORIGIN, -o ORIGIN\r\n                        Origin city.\r\n  --destination DESTINATION, -d DESTINATION\r\n                        Destination city.\r\n  --mode MODE, -m MODE  Mode: driving (default) or taxi; online uses driving for both.\r\n  --path PATH, -p PATH  Path to local distance CSV (defaults to bundled dataset).\r\n  --api-key API_KEY, -k API_KEY\r\n                        Optional Google Distance Matrix API key; if omitted, uses local CSV only.\r\n"]
[29.662022, "o", "\u001b[?2004hroot@f0d3c8658035:/app# "]
[31.63399, "i", "cat /app/skills/search-driving-distance/scripts/search_driving_distance.py | head -50\n"]
[31.634329, "o", "cat /app/skills/search-driving-distance/scripts/search_driving_distance.py | head -50\r\n\u001b[?2004l\r"]
[31.639657, "o", "\"\"\"Utility for estimating distances and costs between cities.\"\"\""]
[31.639793, "o", "\r\n"]
[31.639891, "o", "\r\n"]
[31.639972, "o", "from __future__ import annotations"]
[31.640056, "o", "\r\n"]
[31.640122, "o", "\r\n"]
[31.640187, "o", "import argparse"]
[31.640251, "o", "\r\n"]
[31.640335, "o", "from collections.abc import Callable"]
[31.640422, "o", "\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\n\r\n# Default to the bundled distance matrix CSV.\r\ndef _find_data_path() -> Path:\r\n    \"\"\"Find data file, checking container path first, then relative to script.\"\"\""]
[31.640604, "o", "\r\n    relative = \"googleDistanceMatrix/distance.csv\"\r\n    container_path = Path(\"/app/data\") / relative\r\n    if container_path.exists():\r\n        return container_path\r\n    return Path(__file__).resolve().parent.parent.parent / \"data\" / relative\r\n"]
[31.640645, "o", "\r\n\r\nDEFAULT_DATA_PATH = _find_data_path()\r\n\r\nLOCAL_COLUMNS = [\"origin\", \"destination\", \"duration\", \"distance\"]\r\n\r\n\r\ndef _extract_before_parenthesis(value: str) -> str:\r\n    \"\"\"Return the substring before the first opening parenthesis.\"\"\"\r\n    if value is None:\r\n        return \"\"\r\n    return value.split(\"(\", 1)[0].strip()\r\n\r\n\r\ndef _parse_distance_km(distance_text: str) -> float | None:\r\n    \"\"\"Convert a distance string like '1,234 km' to a float.\"\"\"\r\n    if not isinstance(distance_text, str):\r\n        return None\r\n    cleaned = distance_text.lower().replace(\"km\", \"\").replace(\",\", \"\").strip()\r\n    try:\r\n        return float(cleaned)\r\n    except (TypeError, ValueError):\r\n        return None\r\n\r\n\r\ndef _compute_cost(distance_km: float | None, mode: str) -> int | None:\r\n    \"\"\"Compute cost based on mode.\"\"\"\r\n    if distance_km is None:\r\n        return None\r\n    if \"driving\" in mode:\r\n        return int(distance_km * 0.05)\r\n"]
