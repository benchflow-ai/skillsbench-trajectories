[?2004l[?2004h> import whisper
[?2004l[?2004h> 
[?2004le[?2004h> def get_audio_duration(wav_path):
[?2004l[?2004h>     with wave.open(wav_path, 'rb') as wf:
[?2004l[?2004h>         frames = wf.getnframes()
[?2004l[?2004h>         rate = wf.getframerate()
[?2004l[?2004h>         return frames / float(rate)
[?2004l[?2004h> 
[?2004li[?2004h> def format_time_ass(seconds):
[?2004l[?2004h>     h = int(seconds // 3600)
[?2004l[?2004h>     m = int((seconds % 3600) // 60)
[?2004l[?2004h>     s = seconds % 60
[?2004l[?2004h>     return f"{h}:{m:02d}:{s:05.2f}"
[?2004l[?2004h> 
[?2004lp[?2004h> audio_path = "/root/audio.wav"
[?2004l[?2004h> audio_duration = get_audio_duration(audio_path)
[?2004l[?2004h> print(f"Audio duration: {audio_duration:.2f} seconds")
[?2004l[?2004h> 
[?2004lm[?2004h> # Step 1: VAD
[?2004l[?2004h> print("\n[Step 1] Voice Activity Detection...")
[?2004l[?2004h> from silero_vad import load_silero_vad, read_audio, get_speech_timestamps
[?2004l[?2004h> 
[?2004li[?2004h> model = load_silero_vad()
[?2004l[?2004h> wav = read_audio(audio_path, sampling_rate=16000)
[?2004l[?2004h> speech_timestamps = get_speech_timestamps(wav, model, sampling_rate=16000, threshold=0.5)
[?2004l[?2004h> print(f"Found {len(speech_timestamps)} speech segments")
[?2004l[?2004h> 
[?2004lh[?2004h> # Step 2: Speaker Embeddings
[?2004l[?2004h> print("\n[Step 2] Extracting speaker embeddings...")
[?2004l[?2004h> from speechbrain.inference import SpeakerRecognition
[?2004l[?2004h> verifier = SpeakerRecognition.from_hparams(
[?2004l[?2004h>     source="speechbrain/spkrec-ecapa-voxceleb",
[?2004l[?2004h>     savedir="/tmp/speechbrain_spkrec"
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Load full audio
[?2004l[?2004h> waveform, sr = torchaudio.load(audio_path)
[?2004l[?2004h> if sr != 16000:
[?2004l[?2004h>     resampler = torchaudio.transforms.Resample(sr, 16000)
[?2004l[?2004h>     waveform = resampler(waveform)
[?2004l[?2004h>     sr = 16000
[?2004l[?2004h> 
[?2004l[?2004h> if waveform.shape[0] > 1:
[?2004l[?2004h>     waveform = waveform.mean(dim=0, keepdim=True)
[?2004l[?2004h> 
[?2004l [?2004h> segments = []
[?2004l[?2004h> embeddings = []
[?2004l[?2004h> 
[?2004l[?2004h> for ts in speech_timestamps:
[?2004l[?2004h>     start_sample = ts['start']
[?2004l[?2004h>     end_sample = ts['end']
[?2004l[?2004h>     start_sec = start_sample / 16000
[?2004l[?2004h>     end_sec = end_sample / 16000
[?2004l[?2004h>     
[?2004l[?2004h>     segment_audio = waveform[:, start_sample:end_sample]
[?2004l[?2004h>     if segment_audio.shape[1] < 1600:  # Skip very short segments
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     with torch.no_grad():
[?2004li[?2004h>         emb = verifier.encode_batch(segment_audio)
[?2004l[?2004h>         embeddings.append(emb.squeeze().numpy())
[?2004l[?2004h>         segments.append({'start': start_sec, 'end': end_sec, 'audio': segment_audio})
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Extracted embeddings for {len(segments)} segments")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Clustering
[?2004l[?2004h> print("\n[Step 3] Clustering speakers...")
[?2004l[?2004h> if len(embeddings) > 1:
[?2004l[?2004h>     X = np.array(embeddings)
[?2004l[?2004h>     distances = pdist(X, metric='cosine')
[?2004l[?2004h>     Z = linkage(distances, method='average')
[?2004l[?2004h>     # Use threshold for clustering
[?2004l[?2004h>     labels = fcluster(Z, t=0.5, criterion='distance')
[?2004l[?2004h> else:
[?2004l[?2004h>     labels = [1]
[?2004l[?2004h> 
[?2004l[?2004h> num_speakers = len(set(labels))
[?2004l[?2004h> print(f"Detected {num_speakers} speakers")
[?2004l[?2004h> 
[?2004l[?2004h> for i, seg in enumerate(segments):
[?2004l[?2004h>     seg['speaker'] = f"SPEAKER_{labels[i]-1:02d}"
[?2004l[?2004h>     seg['speaker_id'] = f"spk{labels[i]-1:02d}"
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Transcription with Whisper
[?2004l[?2004h> print("\n[Step 4] Transcribing with Whisper...")
[?2004l[?2004h> whisper_model = whisper.load_model("base")
[?2004l[?2004h> 
[?2004l[?2004h> for i, seg in enumerate(segments):
[?2004l[?2004h>     # Save temp audio for whisper
[?2004l[?2004h>     temp_path = f"/tmp/seg_{i}.wav"
[?2004l[?2004h>     torchaudio.save(temp_path, seg['audio'], 16000)
[?2004l[?2004h>     
[?2004l[?2004h>     result = whisper_model.transcribe(temp_path, language="en")
[?2004l[?2004h>     seg['text'] = result['text'].strip()
[?2004l[?2004h>     print(f"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text'][:50]}..." if len(seg['text']) > 50 else f"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text']}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Generate RTTM
[?2004l[?2004h> print("\n[Step 5] Generating RTTM...")
[?2004l[?2004h> with open('/root/diarization.rttm', 'w') as f:
[?2004l[?2004h>     for seg in segments:
[?2004l[?2004h>         duration = seg['end'] - seg['start']
[?2004l[?2004h>         f.write(f"SPEAKER input 1 {seg['start']:.6f} {duration:.6f} <NA> <NA> {seg['speaker_id']} <NA> <NA>\n")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Generate ASS
[?2004l[?2004h> print("[Step 6] Generating ASS subtitles...")
[?2004l[?2004h> ass_header = """[Script Info]
[?2004l[?2004h> Title: Diarization Subtitles
[?2004l[?2004h> ScriptType: v4.00+
[?2004l[?2004h> PlayResX: 640
[?2004l[?2004h> PlayResY: 480
