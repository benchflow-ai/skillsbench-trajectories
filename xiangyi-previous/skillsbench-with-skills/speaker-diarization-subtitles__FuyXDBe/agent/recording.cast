[202.367488, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.367557, "o", "# Step 4: Transcription with Whisper\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.367642, "o", "print(\"\\n[Step 4] Transcribing with Whisper...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.367668, "o", "> "]
[202.367747, "o", "whisper_model = whisper.load_model(\"base\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.367774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.367931, "o", "for i, seg in enumerate(segments):\r\n\u001b[?2004l\r\u001b[?2004h>     temp_path = f\"/tmp/seg_{i}.wav\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.367999, "o", "    torchaudio.save(temp_path, seg['audio'], 16000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.368048, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[202.36807, "o", "> "]
[202.368134, "o", "    result = whisper_model.transcribe(temp_path, language=\"en\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.368177, "o", "> "]
[202.368219, "o", "    seg['text'] = result['text'].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.368281, "o", "> "]
[202.368358, "o", "    print(f\"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text']}\")\r\n\u001b[?2004l\r"]
[202.36841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.368466, "o", "# Step 5: Generate RTTM\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.368521, "o", "> "]
[202.368592, "o", "print(\"\\n[Step 5] Generating RTTM...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.368638, "o", "with open('/root/diarization.rttm', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.36869, "o", "    for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.368757, "o", "        duration = seg['end'] - seg['start']\r\n\u001b[?2004l\r"]
[202.368806, "o", "\u001b[?2004h> "]
[202.368944, "o", "        f.write(f\"SPEAKER input 1 {seg['start']:.6f} {duration:.6f} <NA> <NA> {seg['speaker_id']} <NA> <NA>\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[202.369028, "o", "\u001b[?2004h> # Step 6: Generate ASS\r\n\u001b[?2004l\r"]
[202.369092, "o", "\u001b[?2004h> "]
[202.369124, "o", "print(\"[Step 6] Generating ASS subtitles...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.369227, "o", "ass_header = \"\"\"[Script Info]\r\n\u001b[?2004l\r\u001b[?2004h> Title: Diarization Subtitles\r\n\u001b[?2004l\r"]
[202.369288, "o", "\u001b[?2004h> ScriptType: v4.00+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.369357, "o", "PlayResX: 640\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.369424, "o", "PlayResY: 480\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.369484, "o", "[V4+ Styles]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.369835, "o", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370043, "o", "Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370143, "o", "[Events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370211, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370267, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370317, "o", "with open('/root/subtitles.ass', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370376, "o", "    f.write(ass_header)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.370421, "o", ">     for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.370468, "o", "> "]
[202.370523, "o", "        start_time = format_time_ass(seg['start'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370602, "o", "        end_time = format_time_ass(seg['end'])\r\n\u001b[?2004l\r"]
[202.370689, "o", "\u001b[?2004h> "]
[202.370779, "o", "        text = seg['text'].replace('\\n', ' ')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.370858, "o", "        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{seg['speaker']}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.370922, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Step 7: Generate Report\r\n\u001b[?2004l\r"]
[202.370962, "o", "\u001b[?2004h> "]
[202.371029, "o", "print(\"[Step 7] Generating report...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371157, "o", "total_speech_time = sum(seg['end'] - seg['start'] for seg in segments)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.371197, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r"]
[202.371259, "o", "\u001b[?2004h> "]
[202.371317, "o", "    \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371387, "o", "    \"total_speech_time_sec\": round(total_speech_time, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371476, "o", "    \"audio_duration_sec\": round(audio_duration, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.371538, "o", ">     \"steps_completed\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371593, "o", "        \"audio_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371668, "o", "        \"voice_activity_detection\", \r\n\u001b[?2004l\r"]
[202.371731, "o", "\u001b[?2004h> "]
[202.371796, "o", "        \"speaker_embedding_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371862, "o", "        \"speaker_clustering\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"transcription\",\r\n\u001b[?2004l\r"]
[202.371919, "o", "\u001b[?2004h>         \"diarization\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.371981, "o", "        \"subtitle_generation\"\r\n\u001b[?2004l\r"]
[202.37203, "o", "\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372084, "o", "    \"commands_used\": [\"python3\", \"ffmpeg\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.372139, "o", "> "]
[202.372216, "o", "    \"libraries_used\": [\r\n\u001b[?2004l\r\u001b[?2004h>         \"torch\",\r\n\u001b[?2004l\r"]
[202.372296, "o", "\u001b[?2004h>         \"torchaudio\", \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372357, "o", "        \"numpy\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"scipy\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.372417, "o", ">         \"silero-vad\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372467, "o", "        \"speechbrain\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372538, "o", "        \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r"]
[202.372619, "o", "\u001b[?2004h>     \"tools_used\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372686, "o", "        \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.372741, "o", "        \"voice_activity_detection\": \"silero-vad\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.372793, "o", "> "]
[202.372859, "o", "        \"speaker_embeddings\": \"speechbrain/spkrec-ecapa-voxceleb\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.372916, "o", "> "]
[202.372974, "o", "        \"speaker_clustering\": \"scipy hierarchical clustering\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373074, "o", "        \"transcription\": \"openai-whisper (base model)\",\r\n\u001b[?2004l\r"]
[202.373135, "o", "\u001b[?2004h> "]
[202.373198, "o", "        \"diarization\": \"custom pipeline with speechbrain + clustering\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.373272, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373509, "o", "    \"notes\": f\"Processed {len(segments)} speech segments from {audio_duration:.1f}s audio. Used ECAPA-TDNN embeddings with agglomerative clustering (threshold=0.75).\"\r\n\u001b[?2004l\r"]
[202.373587, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.37367, "o", "with open('/root/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373776, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373815, "o", "print(\"\\nDone! Generated:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373876, "o", "print(\"  - /root/diarization.rttm\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.373925, "o", "print(\"  - /root/subtitles.ass\")\r\n\u001b[?2004l\r"]
[202.373953, "o", "\u001b[?2004h> "]
[202.37401, "o", "print(\"  - /root/report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.374031, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[202.414519, "o", "\u001b[?2004hroot@bacde7ed2b5d:/app/workspace# "]
