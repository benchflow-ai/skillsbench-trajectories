[322.96642, "o", "[Script Info]\r\nTitle: Diarization Subtitles\r\nScriptType: v4.00+\r\nPlayResX: 640\r\nPlayResY: 480\r\n\r\n[V4+ Styles]\r\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\nStyle: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1\r\n\r\n[Events]\r\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\nDialogue: 0,0:00:00.83,0:00:01.69,Default,,0,0,0,,SPEAKER_01: Excuse me.\r\nDialogue: 0,0:00:05.47,0:00:06.56,Default,,0,0,0,,SPEAKER_01: just want to say.\r\nDialogue: 0,0:00:07.17,0:00:08.38,Default,,0,0,0,,SPEAKER_01: My name is Chang.\r\nDialogue: 0,0:00:08.71,0:00:10.17,Default,,0,0,0,,SPEAKER_01: And this is my grandfather.\r\nDialogue: 0,0:00:10.82,0:00:11.65,Default,,0,0,0,,SPEAKER_01: Mr. Lee.\r\nDialogue: 0,0:00:16.77,0:00:17.63,Default,,0,0,0,,SPEAKER_01: Get your name.\r\nDialogue: 0,0:00:23.01,0:00:24.16,Default,,0,0,0,,SPEAKER_04: You didn't did you?\r\nDialogue: 0,0:00:54.11,0:00:54.81,Default,,0,0,0,,SPEAKER_00: other one, honey.\r\nDialogue: 0,0:00:55.33,0:00:55.97,Default,,0,0,0,,SPEAKER_00: same thing.\r\nDialogue: 0,0:00:57.19,0:00:57.69,Default,,0,0,0,,SPEAKER_02: You on the YouTube channel?\r\nDialogue: 0,0:00:58.82,0:00:59.13,Default,,0,0,0,,SPEAKER_05: Thank you.\r\nDialogue: 0,0:01:00.55,0:01:01.53,Default,,0,0,0,,SPEAKER_06: about that doc.\r\nDialogue: 0,0:01:01.83,0:01:03.20,Default,,0,0,0,,SPEAKER_04: 100 doubles all night.\r\nDialogue: 0,0:01:04.39,0:01:04.77,Default,,0,0,0,,SPEAKER_03: Right?\r\nDialogue: 0,0:01:05.70,0:01:06.37,Default,,0,0,0,,SPEAKER_00: get a triple.\r\n\u001b[?2004hroot@bacde7ed2b5d:/app/workspace# "]
