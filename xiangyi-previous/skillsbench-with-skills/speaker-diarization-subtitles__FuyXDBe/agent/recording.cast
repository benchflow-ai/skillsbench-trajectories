[53.669673, "o", "    with wave.open(wav_path, 'rb') as wf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.669716, "o", "        frames = wf.getnframes()\r\n\u001b[?2004l\r\u001b[?2004h> "]
