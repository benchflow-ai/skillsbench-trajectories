[101.506047, "o", "    seg['text'] = result['text'].strip()\r\n\u001b[?2004l\r"]
[101.506098, "o", "\u001b[?2004h> "]
[101.506377, "o", "    print(f\"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text'][:50]}...\" if len(seg['text']) > 50 else f\"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[101.506406, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[101.506465, "o", "# Step 5: Generate RTTM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.506544, "o", "print(\"\\n[Step 5] Generating RTTM...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.506642, "o", "with open('/root/diarization.rttm', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.506757, "o", "    for seg in segments:\r\n\u001b[?2004l\r"]
[101.506812, "o", "\u001b[?2004h>         duration = seg['end'] - seg['start']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.506974, "o", "        f.write(f\"SPEAKER input 1 {seg['start']:.6f} {duration:.6f} <NA> <NA> {seg['speaker_id']} <NA> <NA>\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.507036, "o", "\u001b[?2004h> "]
[101.507084, "o", "# Step 6: Generate ASS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.507159, "o", "print(\"[Step 6] Generating ASS subtitles...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.507207, "o", "> "]
[101.507246, "o", "ass_header = \"\"\"[Script Info]\r\n\u001b[?2004l\r"]
[101.507303, "o", "\u001b[?2004h> "]
[101.507344, "o", "Title: Diarization Subtitles\r\n\u001b[?2004l\r"]
[101.507391, "o", "\u001b[?2004h> ScriptType: v4.00+\r\n\u001b[?2004l\r"]
[101.507416, "o", "\u001b[?2004h> PlayResX: 640\r\n\u001b[?2004l\r"]
[101.507476, "o", "\u001b[?2004h> "]
[101.50753, "o", "PlayResY: 480\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.507574, "o", "> [V4+ Styles]\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.507627, "o", "> "]
[101.507991, "o", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.508193, "o", "Style: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.508247, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.508287, "o", "> [Events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.508427, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.50845, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.508477, "o", "> \r\n\u001b[?2004l\r"]
[101.508531, "o", "\u001b[?2004h> "]
[101.508615, "o", "with open('/root/subtitles.ass', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.508657, "o", ">     f.write(ass_header)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.508708, "o", "    for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.508759, "o", "> "]
[101.508802, "o", "        start_time = format_time_ass(seg['start'])\r\n\u001b[?2004l\r"]
[101.508859, "o", "\u001b[?2004h> "]
[101.50892, "o", "        end_time = format_time_ass(seg['end'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.508967, "o", "> "]
[101.509013, "o", "        text = seg['text'].replace('\\n', ' ')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.509203, "o", "        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{seg['speaker']}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.509248, "o", "\u001b[?2004h> "]
[101.509298, "o", "# Step 7: Generate Report\r\n\u001b[?2004l\r"]
[101.509353, "o", "\u001b[?2004h> "]
[101.509423, "o", "print(\"[Step 7] Generating report...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.50947, "o", "> "]
[101.509607, "o", "total_speech_time = sum(seg['end'] - seg['start'] for seg in segments)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.509658, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.509713, "o", "report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.509763, "o", "> "]
[101.509808, "o", "    \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.509931, "o", "    \"total_speech_time_sec\": round(total_speech_time, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.509975, "o", "> "]
[101.51007, "o", "    \"audio_duration_sec\": round(audio_duration, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.510121, "o", "> "]
[101.510155, "o", "    \"steps_completed\": [\r\n\u001b[?2004l\r"]
[101.5102, "o", "\u001b[?2004h> "]
[101.510248, "o", "        \"audio_extraction\",\r\n\u001b[?2004l\r"]
[101.5103, "o", "\u001b[?2004h> "]
[101.510354, "o", "        \"voice_activity_detection\", \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.510395, "o", "        \"speaker_embedding_extraction\",\r\n\u001b[?2004l\r"]
[101.510442, "o", "\u001b[?2004h> "]
[101.510495, "o", "        \"speaker_clustering\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.510541, "o", "        \"transcription\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.510591, "o", "> "]
[101.510641, "o", "        \"diarization\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.510679, "o", "> "]
[101.510721, "o", "        \"subtitle_generation\"\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r"]
[101.510773, "o", "\u001b[?2004h> "]
[101.510839, "o", "    \"commands_used\": [\"python3\", \"ffmpeg\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.510866, "o", "> "]
[101.510932, "o", "    \"libraries_used\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.510979, "o", "        \"torch\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.511005, "o", "> "]
[101.51103, "o", "        \"torchaudio\", \r\n\u001b[?2004l\r"]
[101.511113, "o", "\u001b[?2004h> "]
[101.511156, "o", "        \"numpy\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.511201, "o", "        \"scipy\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.511227, "o", "        \"silero-vad\",\r\n\u001b[?2004l\r"]
[101.511287, "o", "\u001b[?2004h> "]
[101.511314, "o", "        \"speechbrain\",\r\n\u001b[?2004l\r"]
[101.511363, "o", "\u001b[?2004h> "]
[101.511436, "o", "        \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.511478, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.51153, "o", "    \"tools_used\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.51158, "o", "> "]
[101.511623, "o", "        \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.511676, "o", "> "]
[101.51173, "o", "        \"voice_activity_detection\": \"silero-vad\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.511783, "o", "> "]
[101.511845, "o", "        \"speaker_embeddings\": \"speechbrain/spkrec-ecapa-voxceleb\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.511866, "o", "> "]
[101.511956, "o", "        \"speaker_clustering\": \"scipy hierarchical clustering\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512004, "o", "> "]
[101.512053, "o", "        \"transcription\": \"openai-whisper (base model)\",\r\n\u001b[?2004l\r"]
[101.512099, "o", "\u001b[?2004h> "]
[101.512182, "o", "        \"diarization\": \"custom pipeline with speechbrain + clustering\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.512207, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512268, "o", "> "]
[101.512455, "o", "    \"notes\": f\"Processed {len(segments)} speech segments from {audio_duration:.1f}s audio. Used ECAPA-TDNN embeddings with agglomerative clustering.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.512479, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512525, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.512598, "o", "with open('/root/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512643, "o", "> "]
[101.512697, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512745, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512796, "o", "> "]
[101.512834, "o", "print(\"\\nDone! Generated:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.512928, "o", "print(\"  - /root/diarization.rttm\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.512976, "o", "> "]
[101.513022, "o", "print(\"  - /root/subtitles.ass\")\r\n\u001b[?2004l\r"]
[101.513069, "o", "\u001b[?2004h> "]
[101.513128, "o", "print(\"  - /root/report.json\")\r\n\u001b[?2004l\r"]
[101.51318, "o", "\u001b[?2004h> "]
[101.513234, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[101.52922, "o", "\u001b[?2004hroot@bacde7ed2b5d:/app/workspace# "]
