[60.032433, "o", "\u001b[?2004hroot@bacde7ed2b5d:/app/workspace# "]
[101.494064, "i", "cat > /root/diarize.py << 'ENDOFSCRIPT'\nimport torch\nimport numpy as np\nimport json\nimport wave\nimport torchaudio\nfrom scipy.cluster.hierarchy import linkage, fcluster\nfrom scipy.spatial.distance import pdist\nimport whisper\n\ndef get_audio_duration(wav_path):\n    with wave.open(wav_path, 'rb') as wf:\n        frames = wf.getnframes()\n        rate = wf.getframerate()\n        return frames / float(rate)\n\ndef format_time_ass(seconds):\n    h = int(seconds // 3600)\n    m = int((seconds % 3600) // 60)\n    s = seconds % 60\n    return f\"{h}:{m:02d}:{s:05.2f}\"\n\naudio_path = \"/root/audio.wav\"\naudio_duration = get_audio_duration(audio_path)\nprint(f\"Audio duration: {audio_duration:.2f} seconds\")\n\n# Step 1: VAD\nprint(\"\\n[Step 1] Voice Activity Detection...\")\nfrom silero_vad import load_silero_vad, read_audio, get_speech_timestamps\n\nmodel = load_silero_vad()\nwav = read_audio(audio_path, sampling_rate=16000)\nspeech_timestamps = get_speech_timestamps(wav, model, sampling_rate=16000, threshold=0.5)\nprint(f\"Found {len(speech_timestamps)} speech segments\")\n\n# Step 2: Speaker Embeddings\nprint(\"\\n[Step 2] Extracting speaker embeddings...\")\nfrom speechbrain.inference import SpeakerRecognition\nverifier = SpeakerRecognition.from_hparams(\n    source=\"speechbrain/spkrec-ecapa-voxceleb\",\n    savedir=\"/tmp/speechbrain_spkrec\"\n)\n\n# Load full audio\nwaveform, sr = torchaudio.load(audio_path)\nif sr != 16000:\n    resampler = torchaudio.transforms.Resample(sr, 16000)\n    waveform = resampler(waveform)\n    sr = 16000\n\nif waveform.shape[0] > 1:\n    waveform = waveform.mean(dim=0, keepdim=True)\n\nsegments = []\nembeddings = []\n\nfor ts in speech_timestamps:\n    start_sample = ts['start']\n    end_sample = ts['end']\n    start_sec = start_sample / 16000\n    end_sec = end_sample / 16000\n    \n    segment_audio = waveform[:, start_sample:end_sample]\n    if segment_audio.shape[1] < 1600:  # Skip very short segments\n        continue\n    \n    with torch.no_grad():\n        emb = verifier.encode_batch(segment_audio)\n        embeddings.append(emb.squeeze().numpy())\n        segments.append({'start': start_sec, 'end': end_sec, 'audio': segment_audio})\n\nprint(f\"Extracted embeddings for {len(segments)} segments\")\n\n# Step 3: Clustering\nprint(\"\\n[Step 3] Clustering speakers...\")\nif len(embeddings) > 1:\n    X = np.array(embeddings)\n    distances = pdist(X, metric='cosine')\n    Z = linkage(distances, method='average')\n    # Use threshold for clustering\n    labels = fcluster(Z, t=0.5, criterion='distance')\nelse:\n    labels = [1]\n\nnum_speakers = len(set(labels))\nprint(f\"Detected {num_speakers} speakers\")\n\nfor i, seg in enumerate(segments):\n    seg['speaker'] = f\"SPEAKER_{labels[i]-1:02d}\"\n    seg['speaker_id'] = f\"spk{labels[i]-1:02d}\"\n\n# Step 4: Transcription with Whisper\nprint(\"\\n[Step 4] Transcribing with Whisper...\")\nwhisper_model = whisper.load_model(\"base\")\n\nfor i, seg in enumerate(segments):\n    # Save temp audio for whisper\n    temp_path = f\"/tmp/seg_{i}.wav\"\n    torchaudio.save(temp_path, seg['audio'], 16000)\n    \n    result = whisper_model.transcribe(temp_path, language=\"en\")\n    seg['text'] = result['text'].strip()\n    print(f\"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text'][:50]}...\" if len(seg['text']) > 50 else f\"  {seg['speaker']} ({seg['start']:.2f}-{seg['end']:.2f}): {seg['text']}\")\n\n# Step 5: Generate RTTM\nprint(\"\\n[Step 5] Generating RTTM...\")\nwith open('/root/diarization.rttm', 'w') as f:\n    for seg in segments:\n        duration = seg['end'] - seg['start']\n        f.write(f\"SPEAKER input 1 {seg['start']:.6f} {duration:.6f} <NA> <NA> {seg['speaker_id']} <NA> <NA>\\n\")\n\n# Step 6: Generate ASS\nprint(\"[Step 6] Generating ASS subtitles...\")\nass_header = \"\"\"[Script Info]\nTitle: Diarization Subtitles\nScriptType: v4.00+\nPlayResX: 640\nPlayResY: 480\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\nStyle: Default,Arial,20,&H00FFFFFF,&H000000FF,&H0000000"]
[101.494126, "i", "0,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n\"\"\"\n\nwith open('/root/subtitles.ass', 'w') as f:\n    f.write(ass_header)\n    for seg in segments:\n        start_time = format_time_ass(seg['start'])\n        end_time = format_time_ass(seg['end'])\n        text = seg['text'].replace('\\n', ' ')\n        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{seg['speaker']}: {text}\\n\")\n\n# Step 7: Generate Report\nprint(\"[Step 7] Generating report...\")\ntotal_speech_time = sum(seg['end'] - seg['start'] for seg in segments)\n\nreport = {\n    \"num_speakers_pred\": num_speakers,\n    \"total_speech_time_sec\": round(total_speech_time, 1),\n    \"audio_duration_sec\": round(audio_duration, 1),\n    \"steps_completed\": [\n        \"audio_extraction\",\n        \"voice_activity_detection\", \n        \"speaker_embedding_extraction\",\n        \"speaker_clustering\",\n        \"transcription\",\n        \"diarization\",\n        \"subtitle_generation\"\n    ],\n    \"commands_used\": [\"python3\", \"ffmpeg\"],\n    \"libraries_used\": [\n        \"torch\",\n        \"torchaudio\", \n        \"numpy\",\n        \"scipy\",\n        \"silero-vad\",\n        \"speechbrain\",\n        \"openai-whisper\"\n    ],\n    \"tools_used\": {\n        \"audio_extraction\": \"ffmpeg\",\n        \"voice_activity_detection\": \"silero-vad\",\n        \"speaker_embeddings\": \"speechbrain/spkrec-ecapa-voxceleb\",\n        \"speaker_clustering\": \"scipy hierarchical clustering\",\n        \"transcription\": \"openai-whisper (base model)\",\n        \"diarization\": \"custom pipeline with speechbrain + clustering\"\n    },\n    \"notes\": f\"Processed {len(segments)} speech segments from {audio_duration:.1f}s audio. Used ECAPA-TDNN embeddings with agglomerative clustering.\"\n}\n\nwith open('/root/report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nDone! Generated:\")\nprint(\"  - /root/diarization.rttm\")\nprint(\"  - /root/subtitles.ass\")\nprint(\"  - /root/report.json\")\nENDOFSCRIPT\n"]
