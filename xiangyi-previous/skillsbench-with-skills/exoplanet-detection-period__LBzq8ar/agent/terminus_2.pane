[?2004l[?2004h> 
[?2004l[?2004h> # Detrend
[?2004l[?2004h> time_step = np.median(np.diff(time))
[?2004l[?2004h> window_points = int(1.0 / time_step)
[?2004l[?2004h> if window_points % 2 == 0:
[?2004l[?2004h>     window_points += 1
[?2004l[?2004h> 
[?2004l[?2004h> trend1 = signal.savgol_filter(flux, window_points, 3)
[?2004l[?2004h> flux_dt1 = flux / trend1
[?2004l[?2004h> transit_mask = flux_dt1 < (1 - 2*np.std(flux_dt1))
[?2004l[?2004h> flux_masked = flux.copy()
[?2004l[?2004h> flux_masked[transit_mask] = np.nan
[?2004l[?2004h> valid_mask = ~np.isnan(flux_masked)
[?2004l[?2004h> flux_interp = np.interp(time, time[valid_mask], flux_masked[valid_mask])
[?2004l[?2004h> trend2 = signal.savgol_filter(flux_interp, window_points, 3)
[?2004l[?2004h> flux_detrended = flux / trend2
[?2004l[?2004h> 
[?2004l[?2004h> # Fine grid search around 1.397 days
[?2004l[?2004h> model = BoxLeastSquares(time, flux_detrended)
[?2004l[?2004h> durations = np.array([0.03, 0.05, 0.07, 0.1, 0.13, 0.16])
[?2004l[?2004h> 
[?2004l[?2004h> # Very fine grid
[?2004l[?2004h> periods_fine = np.linspace(1.35, 1.45, 5000)
[?2004l[?2004h> result = model.power(periods_fine, durations)
[?2004l[?2004h> 
[?2004l[?2004h> best_idx = np.argmax(result.power)
[?2004l[?2004h> best_period = result.period[best_idx]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Best period: {best_period:.6f} days")
[?2004l[?2004h> print(f"Power: {result.power[best_idx]:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Even finer refinement
[?2004l[?2004h> periods_ultra = np.linspace(best_period - 0.005, best_period + 0.005, 5000)
[?2004l[?2004h> result_ultra = model.power(periods_ultra, durations)
[?2004l[?2004h> best_period_final = result_ultra.period[np.argmax(result_ultra.power)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Final refined period: {best_period_final:.6f} days")
[?2004l[?2004h> print(f"Rounded to 5 decimals: {best_period_final:.5f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write result
[?2004l[?2004h> with open('/root/period.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{best_period_final:.5f}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nWritten to /root/period.txt: {best_period_final:.5f}")
