[30.345133, "o", "\u001b[?2004h> "]
[30.345278, "o", "periods_fine = np.linspace(best_period - 0.1, best_period + 0.1, 1000)\r\n\u001b[?2004l\r"]
[30.345303, "o", "\u001b[?2004h"]
[30.345325, "o", "> "]
[30.345417, "o", "periods_fine = periods_fine[periods_fine > 0.3]\r\n\u001b[?2004l\r"]
[30.345439, "o", "\u001b[?2004h"]
[30.345466, "o", "> "]
[30.345598, "o", "power_fine = bls_periodogram(time, flux_detrended, periods_fine)\r\n\u001b[?2004l\r"]
[30.34562, "o", "\u001b[?2004h"]
[30.345642, "o", "> "]
[30.345721, "o", "best_idx_fine = np.argmax(power_fine)\r\n\u001b[?2004l\r"]
[30.345749, "o", "\u001b[?2004h> "]
