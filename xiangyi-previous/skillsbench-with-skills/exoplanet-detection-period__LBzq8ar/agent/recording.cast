[30.345899, "o", "\u001b[?2004h> "]
[30.346037, "o", "print(f\"Refined period: {best_period_refined:.5f} days\")\r\n\u001b[?2004l\r"]
[30.346058, "o", "\u001b[?2004h"]
[30.346084, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.346112, "o", "> "]
[30.346134, "o", "# Write result\r\n\u001b[?2004l\r"]
[30.346158, "o", "\u001b[?2004h> "]
[30.346265, "o", "with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[30.346291, "o", "\u001b[?2004h> "]
[30.346423, "o", "    f.write(f\"{best_period_refined:.5f}\\n\")\r\n\u001b[?2004l\r"]
[30.346433, "o", "\u001b[?2004h"]
[30.346457, "o", "> "]
[30.34648, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
