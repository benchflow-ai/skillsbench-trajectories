[30.335882, "i", "cat > /root/find_period.py << 'EOF'\nimport numpy as np\nfrom scipy import signal\nfrom scipy.ndimage import median_filter\n\n# Load data\ndata = np.loadtxt('/root/data/tess_lc.txt', comments='#')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\nprint(f\"Total data points: {len(time)}\")\nprint(f\"Time range: {time.min():.2f} to {time.max():.2f} MJD\")\nprint(f\"Time span: {time.max() - time.min():.2f} days\")\n\n# Filter by quality flag (keep only flag=0)\nmask = flag == 0\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\nprint(f\"After quality filter: {len(time)} points\")\n\n# Remove outliers using sigma clipping\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nsigma_clip = 3.0\nmask = np.abs(flux - median_flux) < sigma_clip * std_flux\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\nprint(f\"After outlier removal: {len(time)} points\")\n\n# Detrend stellar variability using Savitzky-Golay filter\n# Need to handle gaps in data - use a window that spans ~1 day\ntime_step = np.m"]
[30.33604, "i", "edian(np.diff(time))\nprint(f\"Median time step: {time_step*24*60:.2f} minutes\")\n\n# Window for ~0.5 day smoothing (to preserve transit shape)\nwindow_days = 0.5\nwindow_points = int(window_days / time_step)\nif window_points % 2 == 0:\n    window_points += 1\nwindow_points = max(window_points, 51)\nprint(f\"Smoothing window: {window_points} points\")\n\n# Use Savitzky-Golay filter for detrending\ntrend = signal.savgol_filter(flux, window_points, 3)\nflux_detrended = flux / trend\n\nprint(f\"Detrended flux std: {np.std(flux_detrended):.6f}\")\n\n# Box Least Squares periodogram for transit detection\ndef bls_periodogram(time, flux, periods, duration_frac=0.02):\n    \"\"\"Simple BLS implementation\"\"\"\n    power = np.zeros(len(periods))\n    \n    for i, period in enumerate(periods):\n        # Phase fold\n        phase = (time % period) / period\n        \n        # Try different transit phases\n        n_phases = int(period / (duration_frac * period * 0.5)) + 1\n        n_phases = min(n_phases, 100)\n        \n        best_depth = 0\n        dura"]
[30.336055, "o", "cat > /root/find_period.py << 'EOF'\r\n\u001b[?2004l\r"]
[30.3361, "i", "tion = duration_frac * period\n        \n        for phase_start in np.linspace(0, 1, n_phases):\n            phase_end = phase_start + duration_frac\n            \n            if phase_end <= 1:\n                in_transit = (phase >= phase_start) & (phase < phase_end)\n            else:\n                in_transit = (phase >= phase_start) | (phase < (phase_end - 1))\n            \n            if np.sum(in_transit) > 5 and np.sum(~in_transit) > 5:\n                depth = np.median(flux[~in_transit]) - np.median(flux[in_transit])\n                if depth > best_depth:\n                    best_depth = depth\n        \n        power[i] = best_depth\n    \n    return power\n\n# Search period range (typical hot Jupiter range)\nperiods = np.linspace(0.5, 15, 3000)\nprint(\"Running BLS periodogram...\")\npower = bls_periodogram(time, flux_detrended, periods)\n\n# Find best period\nbest_idx = np.argmax(power)\nbest_period = periods[best_idx]\nprint(f\"Best period: {best_period:.5f} days\")\nprint(f\"BLS power: {power[best_idx]:.6f}\")\n\n# Refine a"]
[30.336124, "o", "edian(np.diff(time))\r\nprint(f\"Median time step: {time_step*24*60:.2f} minutes\")\r\n\r\n# Window for ~0.5 day smoothing (to preserve transit shape)\r\nwindow_days = 0.5\r\nwindow_points = int(window_days / time_step)\r\nif window_points % 2 == 0:\r\n    window_points += 1\r\nwindow_points = max(window_points, 51)\r\nprint(f\"Smoothing window: {window_points} points\")\r\n\r\n# Use Savitzky-Golay filter for detrending"]
[30.336174, "i", "round best period\nperiods_fine = np.linspace(best_period - 0.1, best_period + 0.1, 1000)\nperiods_fine = periods_fine[periods_fine > 0.3]\npower_fine = bls_periodogram(time, flux_detrended, periods_fine)\nbest_idx_fine = np.argmax(power_fine)\nbest_period_refined = periods_fine[best_idx_fine]\nprint(f\"Refined period: {best_period_refined:.5f} days\")\n\n# Write result\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period_refined:.5f}\\n\")\n\nprint(f\"Period written to /root/period.txt\")\nEOF\n"]
