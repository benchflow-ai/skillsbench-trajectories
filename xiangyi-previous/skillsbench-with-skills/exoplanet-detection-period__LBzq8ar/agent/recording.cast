[467.56799, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[467.574701, "o", "\u001b[?2004hroot@b0483704dbee:~# "]
[468.028114, "i", "python3 /root/refine_final.py\n"]
