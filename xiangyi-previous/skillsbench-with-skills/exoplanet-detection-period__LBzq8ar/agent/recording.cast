[467.564291, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[467.564307, "o", "> "]
[467.564397, "o", "# Load and process data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.564451, "o", "data = np.loadtxt('/root/data/tess_lc.txt', comments='#')\r\n\u001b[?2004l\r"]
[467.564471, "o", "\u001b[?2004h> "]
