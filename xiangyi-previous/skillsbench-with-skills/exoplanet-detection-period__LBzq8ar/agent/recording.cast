[152.935373, "o", "\u001b[?2004hroot@b0483704dbee:~# "]
[189.376381, "i", "cat > /root/verify_period.py << 'EOF'\nimport numpy as np\nfrom scipy import signal\n\n# Load data\ndata = np.loadtxt('/root/data/tess_lc.txt', comments='#')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Filter by quality flag\nmask = flag == 0\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\n# Remove outliers\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask = np.abs(flux - median_flux) < 4.0 * std_flux\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\n# Try using astropy BLS if available\ntry:\n    from astropy.timeseries import BoxLeastSquares\n    \n    # Detrend with Savitzky-Golay\n    time_step = np.median(np.diff(time))\n    window_days = 0.3  # Smaller window to better preserve transits\n    window_points = int(window_days / time_step)\n    if window_points % 2 == 0:\n        window_points += 1\n    window_points = max(window_points, 51)\n    \n    trend = signal.savgol_filter(flux, window_points, 2)\n    flux_detrended = flux / trend\n    \n    # Use a"]
[189.376523, "i", "stropy BLS\n    model = BoxLeastSquares(time, flux_detrended)\n    \n    # Search periods from 0.5 to 15 days\n    periods = np.linspace(0.5, 15, 5000)\n    \n    # Typical transit duration for hot Jupiters: 1-4 hours\n    durations = np.array([0.05, 0.075, 0.1, 0.125, 0.15])  # days\n    \n    print(\"Running astropy BLS...\")\n    result = model.power(periods, durations)\n    \n    best_period = result.period[np.argmax(result.power)]\n    best_power = np.max(result.power)\n    \n    print(f\"Best period (astropy BLS): {best_period:.5f} days\")\n    print(f\"Best power: {best_power:.6f}\")\n    \n    # Get stats\n    stats = model.compute_stats(best_period, durations[2], result.transit_time[np.argmax(result.power)])\n    print(f\"Transit depth: {stats['depth']:.6f}\")\n    print(f\"Transit duration: {durations[2]*24:.2f} hours\")\n    \n    # Check top 5 periods\n    sorted_idx = np.argsort(result.power)[::-1]\n    print(\"\\nTop 5 periods:\")\n    for i in range(5):\n        idx = sorted_idx[i]\n        print(f\"  {result.period[idx]:.5f} days, pow"]
[189.376557, "o", "cat > /root/verify_period.py << 'EOF'\r\n\u001b[?2004l\r"]
[189.376582, "i", "er={result.power[idx]:.6f}\")\n    \n    # Write best period\n    with open('/root/period.txt', 'w') as f:\n        f.write(f\"{best_period:.5f}\\n\")\n    print(f\"\\nPeriod {best_period:.5f} written to /root/period.txt\")\n    \nexcept ImportError:\n    print(\"astropy not available, using custom implementation\")\n    \n    # Detrend\n    time_step = np.median(np.diff(time))\n    window_points = int(0.3 / time_step)\n    if window_points % 2 == 0:\n        window_points += 1\n    window_points = max(window_points, 51)\n    trend = signal.savgol_filter(flux, window_points, 2)\n    flux_detrended = flux / trend\n    \n    # BLS implementation\n    def bls_fast(time, flux, periods):\n        power = np.zeros(len(periods))\n        for i, period in enumerate(periods):\n            phase = (time % period) / period\n            sorted_idx = np.argsort(phase)\n            phase_sorted = phase[sorted_idx]\n            flux_sorted = flux[sorted_idx]\n            \n            # Try transit durations\n            for dur_frac in [0.02, 0.03, 0.04, 0.05]"]
[189.376606, "o", "\u001b[?2004h> "]
[189.376634, "i", ":\n                n_bins = int(1.0 / dur_frac)\n                for start_bin in range(n_bins):\n                    start_phase = start_bin * dur_frac\n                    end_phase = start_phase + dur_frac\n                    in_transit = (phase_sorted >= start_phase) & (phase_sorted < end_phase)\n                    if np.sum(in_transit) > 3:\n                        depth = np.median(flux_sorted[~in_transit]) - np.median(flux_sorted[in_transit])\n                        if depth > power[i]:\n                            power[i] = depth\n        return power\n    \n    periods = np.linspace(0.5, 15, 3000)\n    print(\"Running custom BLS...\")\n    power = bls_fast(time, flux_detrended, periods)\n    \n    best_idx = np.argmax(power)\n    best_period = periods[best_idx]\n    print(f\"Best period: {best_period:.5f} days\")\n    \n    with open('/root/period.txt', 'w') as f:\n        f.write(f\"{best_period:.5f}\\n\")\n\nEOF\n"]
