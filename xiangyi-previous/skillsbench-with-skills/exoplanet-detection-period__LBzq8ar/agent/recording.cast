[189.381353, "o", "\u001b[?2004h> "]
[189.381384, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.381412, "o", "    # Detrend\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.38144, "o", "> "]
[189.381468, "o", "    time_step = np.median(np.diff(time))\r\n\u001b[?2004l\r"]
[189.381496, "o", "\u001b[?2004h> "]
[189.381543, "o", "    window_points = int(0.3 / time_step)\r\n\u001b[?2004l\r"]
[189.381572, "o", "\u001b[?2004h> "]
[189.381606, "o", "    if window_points % 2 == 0:\r\n\u001b[?2004l\r"]
[189.381634, "o", "\u001b[?2004h> "]
[189.381663, "o", "        window_points += 1\r\n\u001b[?2004l\r"]
[189.381691, "o", "\u001b[?2004h> "]
[189.381742, "o", "    window_points = max(window_points, 51)\r\n\u001b[?2004l\r"]
[189.38177, "o", "\u001b[?2004h> "]
[189.38184, "o", "    trend = signal.savgol_filter(flux, window_points, 2)\r\n\u001b[?2004l\r"]
[189.381865, "o", "\u001b[?2004h> "]
[189.381907, "o", "    flux_detrended = flux / trend\r\n\u001b[?2004l\r"]
[189.381936, "o", "\u001b[?2004h> "]
[189.381964, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.381989, "o", "    # BLS implementation\r\n\u001b[?2004l\r"]
[189.382018, "o", "\u001b[?2004h> "]
[189.382058, "o", "    def bls_fast(time, flux, periods):\r\n\u001b[?2004l\r"]
[189.382086, "o", "\u001b[?2004h> "]
[189.38213, "o", "        power = np.zeros(len(periods))\r\n\u001b[?2004l\r"]
[189.382151, "o", "\u001b[?2004h> "]
[189.382213, "o", "        for i, period in enumerate(periods):\r\n\u001b[?2004l\r"]
[189.38224, "o", "\u001b[?2004h> "]
[189.382293, "o", "            phase = (time % period) / period\r\n\u001b[?2004l\r"]
[189.38232, "o", "\u001b[?2004h> "]
[189.382372, "o", "            sorted_idx = np.argsort(phase)\r\n\u001b[?2004l\r"]
[189.382414, "o", "\u001b[?2004h> "]
[189.382499, "o", "            phase_sorted = phase[sorted_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.382527, "o", "> "]
[189.382576, "o", "            flux_sorted = flux[sorted_idx]\r\n\u001b[?2004l\r"]
[189.382606, "o", "\u001b[?2004h> "]
[189.382637, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.382685, "o", "            # Try transit durations\r\n\u001b[?2004l\r"]
[189.382716, "o", "\u001b[?2004h> "]
[189.382779, "o", "            for dur_frac in [0.02, 0.03, 0.04, 0.05]:\r\n\u001b[?2004l\r"]
[189.382807, "o", "\u001b[?2004h> "]
[189.382859, "o", "                n_bins = int(1.0 / dur_frac)\r\n\u001b[?2004l\r"]
[189.382886, "o", "\u001b[?2004h> "]
[189.382949, "o", "                for start_bin in range(n_bins):\r\n\u001b[?2004l\r"]
[189.382979, "o", "\u001b[?2004h> "]
[189.383041, "o", "                    start_phase = start_bin * dur_frac\r\n\u001b[?2004l\r"]
[189.383072, "o", "\u001b[?2004h> "]
[189.383137, "o", "                    end_phase = start_phase + dur_frac\r\n\u001b[?2004l\r"]
[189.383166, "o", "\u001b[?2004h> "]
[189.383293, "o", "                    in_transit = (phase_sorted >= start_phase) & (phase_sorted < end_phase)\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.383322, "o", "> "]
[189.383369, "o", "                    if np.sum(in_transit) > 3:\r\n\u001b[?2004l\r"]
[189.383399, "o", "\u001b[?2004h> "]
[189.383542, "o", "                        depth = np.median(flux_sorted[~in_transit]) - np.median(flux_sorted[in_transit])\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.38357, "o", "> "]
[189.383626, "o", "                        if depth > power[i]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.383654, "o", "> "]
[189.383704, "o", "                            power[i] = depth\r\n\u001b[?2004l\r"]
[189.383734, "o", "\u001b[?2004h> "]
[189.383754, "o", "        return power\r\n\u001b[?2004l\r"]
[189.383782, "o", "\u001b[?2004h> "]
[189.383813, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.383851, "o", "    periods = np.linspace(0.5, 15, 3000)\r\n\u001b[?2004l\r"]
[189.383879, "o", "\u001b[?2004h> "]
[189.38392, "o", "    print(\"Running custom BLS...\")\r\n\u001b[?2004l\r"]
[189.383953, "o", "\u001b[?2004h> "]
[189.384013, "o", "    power = bls_fast(time, flux_detrended, periods)\r\n\u001b[?2004l\r"]
[189.384041, "o", "\u001b[?2004h> "]
[189.384068, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.3841, "o", "    best_idx = np.argmax(power)\r\n\u001b[?2004l\r"]
[189.384131, "o", "\u001b[?2004h> "]
[189.384169, "o", "    best_period = periods[best_idx]\r\n\u001b[?2004l\r"]
[189.384197, "o", "\u001b[?2004h> "]
[189.384257, "o", "    print(f\"Best period: {best_period:.5f} days\")\r\n\u001b[?2004l\r"]
[189.384284, "o", "\u001b[?2004h> "]
[189.384313, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.384365, "o", "    with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[189.384395, "o", "\u001b[?2004h> "]
[189.384442, "o", "        f.write(f\"{best_period:.5f}\\n\")\r\n\u001b[?2004l\r"]
[189.384473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.3845, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[189.385656, "o", "\u001b[?2004h"]
[189.385667, "o", "root@b0483704dbee:~# "]
[189.849382, "i", "python3 /root/verify_period.py\n"]
[189.849537, "o", "python3 /root/verify_period.py\r\n\u001b[?2004l\r"]
[191.205272, "o", "Running astropy BLS...\r\n"]
[191.957704, "o", "Best period (astropy BLS): 5.35847 days\r\nBest power: 0.000165\r\n"]
[192.098438, "o", "Traceback (most recent call last):"]
[192.098513, "o", "\r\n  File \"/root/verify_period.py\", line 60, in <module>\r\n"]
[192.098697, "o", "    print(f\"Transit depth: {stats['depth']:.6f}\")\r\n"]
