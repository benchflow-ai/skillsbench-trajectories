[467.564512, "o", "\u001b[?2004h> "]
[467.564539, "o", "flux = data[:, 1]\r\n\u001b[?2004l\r"]
[467.564563, "o", "\u001b[?2004h> "]
[467.564588, "o", "flag = data[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.56461, "o", "> \r\n\u001b[?2004l\r"]
[467.564636, "o", "\u001b[?2004h> "]
[467.564663, "o", "mask = flag == 0\r\n\u001b[?2004l\r"]
[467.564687, "o", "\u001b[?2004h> "]
[467.564722, "o", "time = time[mask]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.564743, "o", "flux = flux[mask]\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.564761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[467.564784, "o", "> "]
[467.564816, "o", "median_flux = np.median(flux)\r\n\u001b[?2004l\r"]
[467.564837, "o", "\u001b[?2004h> "]
[467.564868, "o", "std_flux = np.std(flux)\r\n\u001b[?2004l\r"]
[467.564893, "o", "\u001b[?2004h> "]
[467.564968, "o", "mask = np.abs(flux - median_flux) < 3.5 * std_flux\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.564978, "o", "> "]
[467.565006, "o", "time = time[mask]\r\n\u001b[?2004l\r"]
[467.565023, "o", "\u001b[?2004h> "]
[467.565048, "o", "flux = flux[mask]\r\n\u001b[?2004l\r"]
[467.565062, "o", "\u001b[?2004h> "]
[467.56508, "o", "\r\n\u001b[?2004l\r"]
[467.565098, "o", "\u001b[?2004h> "]
[467.565119, "o", "# Detrend\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.565174, "o", "time_step = np.median(np.diff(time))\r\n\u001b[?2004l\r"]
[467.565194, "o", "\u001b[?2004h> "]
[467.565243, "o", "window_points = int(1.0 / time_step)\r\n\u001b[?2004l\r"]
[467.56527, "o", "\u001b[?2004h> "]
[467.565298, "o", "if window_points % 2 == 0:\r\n\u001b[?2004l\r"]
[467.565318, "o", "\u001b[?2004h> "]
[467.565348, "o", "    window_points += 1\r\n\u001b[?2004l\r"]
[467.56537, "o", "\u001b[?2004h> "]
[467.565385, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.565464, "o", "trend1 = signal.savgol_filter(flux, window_points, 3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.565492, "o", "> "]
[467.565516, "o", "flux_dt1 = flux / trend1\r\n\u001b[?2004l\r"]
[467.565542, "o", "\u001b[?2004h> "]
[467.565609, "o", "transit_mask = flux_dt1 < (1 - 2*np.std(flux_dt1))\r\n\u001b[?2004l\r"]
[467.56563, "o", "\u001b[?2004h"]
[467.565644, "o", "> "]
[467.56567, "o", "flux_masked = flux.copy()\r\n\u001b[?2004l\r"]
[467.56569, "o", "\u001b[?2004h> "]
[467.565738, "o", "flux_masked[transit_mask] = np.nan\r\n\u001b[?2004l\r"]
[467.565747, "o", "\u001b[?2004h> "]
[467.565804, "o", "valid_mask = ~np.isnan(flux_masked)\r\n\u001b[?2004l\r"]
[467.565826, "o", "\u001b[?2004h"]
[467.565849, "o", "> "]
[467.565928, "o", "flux_interp = np.interp(time, time[valid_mask], flux_masked[valid_mask])\r\n\u001b[?2004l\r"]
[467.565956, "o", "\u001b[?2004h> "]
[467.566041, "o", "trend2 = signal.savgol_filter(flux_interp, window_points, 3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.566068, "o", "> "]
[467.566097, "o", "flux_detrended = flux / trend2\r\n\u001b[?2004l\r"]
[467.566123, "o", "\u001b[?2004h> "]
[467.566147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.566187, "o", "# Fine grid search around 1.397 days\r\n\u001b[?2004l\r"]
[467.566211, "o", "\u001b[?2004h"]
[467.566232, "o", "> "]
[467.566273, "o", "model = BoxLeastSquares(time, flux_detrended)\r\n\u001b[?2004l\r"]
[467.566291, "o", "\u001b[?2004h> "]
[467.566373, "o", "durations = np.array([0.03, 0.05, 0.07, 0.1, 0.13, 0.16])\r\n\u001b[?2004l\r"]
[467.566404, "o", "\u001b[?2004h"]
[467.566432, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.566452, "o", "# Very fine grid\r\n\u001b[?2004l\r"]
[467.56647, "o", "\u001b[?2004h> "]
[467.566528, "o", "periods_fine = np.linspace(1.35, 1.45, 5000)\r\n\u001b[?2004l\r"]
[467.566548, "o", "\u001b[?2004h> "]
[467.566617, "o", "result = model.power(periods_fine, durations)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.566637, "o", "\r\n\u001b[?2004l\r"]
[467.566665, "o", "\u001b[?2004h> "]
[467.566699, "o", "best_idx = np.argmax(result.power)\r\n\u001b[?2004l\r"]
[467.566725, "o", "\u001b[?2004h"]
[467.566757, "o", "> "]
[467.566785, "o", "best_period = result.period[best_idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[467.56681, "o", "\u001b[?2004h> "]
[467.56687, "o", "print(f\"Best period: {best_period:.6f} days\")\r\n\u001b[?2004l\r"]
[467.566897, "o", "\u001b[?2004h> "]
[467.56696, "o", "print(f\"Power: {result.power[best_idx]:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[467.566985, "o", "\u001b[?2004h> "]
[467.567025, "o", "# Even finer refinement\r\n\u001b[?2004l\r"]
[467.567053, "o", "\u001b[?2004h> "]
[467.567155, "o", "periods_ultra = np.linspace(best_period - 0.005, best_period + 0.005, 5000)\r\n\u001b[?2004l\r"]
[467.567165, "o", "\u001b[?2004h"]
[467.56719, "o", "> "]
[467.567253, "o", "result_ultra = model.power(periods_ultra, durations)\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.567279, "o", "> "]
[467.567371, "o", "best_period_final = result_ultra.period[np.argmax(result_ultra.power)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.567392, "o", "> \r\n\u001b[?2004l\r"]
[467.567414, "o", "\u001b[?2004h> "]
[467.567491, "o", "print(f\"Final refined period: {best_period_final:.6f} days\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[467.567515, "o", "> "]
[467.56759, "o", "print(f\"Rounded to 5 decimals: {best_period_final:.5f}\")\r\n\u001b[?2004l\r"]
[467.567617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[467.567647, "o", "\u001b[?2004h> "]
[467.567674, "o", "# Write result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[467.567723, "o", "with open('/root/period.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[467.567734, "o", "\u001b[?2004h> "]
[467.567801, "o", "    f.write(f\"{best_period_final:.5f}\\n\")\r\n\u001b[?2004l\r"]
[467.567823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[467.567847, "o", "\u001b[?2004h> "]
[467.56794, "o", "print(f\"\\nWritten to /root/period.txt: {best_period_final:.5f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
