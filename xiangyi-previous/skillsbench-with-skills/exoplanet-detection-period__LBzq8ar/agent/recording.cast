[192.274125, "o", "\u001b[?2004hroot@b0483704dbee:~# "]
[269.467845, "i", "cat > /root/verify_period2.py << 'EOF'\nimport numpy as np\nfrom scipy import signal\nfrom astropy.timeseries import BoxLeastSquares\n\n# Load data\ndata = np.loadtxt('/root/data/tess_lc.txt', comments='#')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Filter by quality flag\nmask = flag == 0\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\n# Remove outliers\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask = np.abs(flux - median_flux) < 4.0 * std_flux\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\nprint(f\"Data points: {len(time)}\")\nprint(f\"Time span: {time.max() - time.min():.2f} days\")\n\n# Detrend with Savitzky-Golay - use larger window to not remove transits\ntime_step = np.median(np.diff(time))\nwindow_days = 0.5\nwindow_points = int(window_days / time_step)\nif window_points % 2 == 0:\n    window_points += 1\nwindow_points = max(window_points, 51)\n\ntrend = signal.savgol_filter(flux, window_points, 2)\nflux_detrended = flux / trend\n\nprint(f\"Detrendi"]
[269.46789, "i", "ng window: {window_points} points ({window_days} days)\")\n\n# Use astropy BLS\nmodel = BoxLeastSquares(time, flux_detrended)\n\n# Search periods from 0.5 to 15 days with finer grid\nperiods = np.linspace(0.5, 15, 10000)\n\n# Typical transit duration for hot Jupiters: 1-4 hours\ndurations = np.array([0.04, 0.06, 0.08, 0.1, 0.12, 0.15])  # days\n\nprint(\"Running astropy BLS...\")\nresult = model.power(periods, durations)\n\nbest_period = result.period[np.argmax(result.power)]\nbest_power = np.max(result.power)\n\nprint(f\"\\nBest period: {best_period:.5f} days\")\nprint(f\"Best power: {best_power:.6f}\")\n\n# Check top 10 periods\nsorted_idx = np.argsort(result.power)[::-1]\nprint(\"\\nTop 10 periods:\")\nfor i in range(10):\n    idx = sorted_idx[i]\n    print(f\"  {result.period[idx]:.5f} days, power={result.power[idx]:.6f}\")\n\n# Refine around best period\nperiods_fine = np.linspace(best_period - 0.05, best_period + 0.05, 2000)\nperiods_fine = periods_fine[periods_fine > 0.3]\nresult_fine = model.power(periods_fine, durations)\nbest_period_refined ="]
[269.468018, "i", " result_fine.period[np.argmax(result_fine.power)]\n\nprint(f\"\\nRefined period: {best_period_refined:.5f} days\")\n\n# Write best period\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period_refined:.5f}\\n\")\nprint(f\"Period {best_period_refined:.5f} written to /root/period.txt\")\n\n# Verify by phase folding\nphase = (time - time.min()) % best_period_refined / best_period_refined\nprint(f\"\\nPhase-folded statistics:\")\nbins = np.linspace(0, 1, 50)\nfor i in range(len(bins)-1):\n    mask = (phase >= bins[i]) & (phase < bins[i+1])\n    if np.sum(mask) > 0:\n        bin_flux = np.median(flux_detrended[mask])\n        if bin_flux < 0.998:\n            print(f\"  Phase {bins[i]:.2f}-{bins[i+1]:.2f}: flux={bin_flux:.6f} (transit?)\")\n\nEOF\n"]
