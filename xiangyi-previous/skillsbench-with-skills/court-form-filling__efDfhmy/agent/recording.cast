[296.149988, "o", "\u001b[?2004l\r"]
[296.501859, "o", "page 1 Why does the defendant owe the plaintiff money?  value TEST\r\n"]
[296.504954, "o", "page 2 You must ask the defendant (in person, in writing, or by phone) to pay you before you sue. If your claim is for possession of property, you must ask the defendant to give you the property. Have you done this? If no, explain why not: value \r\n"]
[296.562766, "o", "\u001b[?2004hroot@75f52cc615f1:~# "]
[420.638638, "i", "python3 - <<'PY'\nimport fitz\npdf = fitz.open('/root/sc100-blank.pdf')\nfor page in pdf:\n    for w in page.widgets():\n        name = w.field_name or ''\n        label = w.field_label or ''\n        # text fields\n        if name.endswith('County[0]'):\n            w.field_value = 'Santa Clara'\n        elif name.endswith('CaseName[0]'):\n            w.field_value = 'Joyce He v. Zhi Chen'\n        elif name.endswith('Plaintiff[0]'):\n            w.field_value = 'Joyce He'\n        elif name.endswith('PlaintiffName1[0]'):\n            w.field_value = 'Joyce He'\n        elif name.endswith('PlaintiffPhone1[0]'):\n            w.field_value = '4125886066'\n        elif name.endswith('PlaintiffAddress1[0]'):\n            w.field_value = '655 S Fair Oaks Ave'\n        elif name.endswith('PlaintiffCity1[0]'):\n            w.field_value = 'Sunnyvale'\n        elif name.endswith('PlaintiffState1[0]'):\n            w.field_value = 'CA'\n        elif name.endswith('PlaintiffZip1[0]'):\n            w.field_value = '94086'\n        elif name.endswith('EmailAdd1[0]'):\n            w.field_value = 'he1998@gmail.com'\n        elif name.endswith('DefendantName1[0]'):\n            w.field_value = 'Zhi Chen'\n        elif name.endswith('DefendantPhone1[0]'):\n            w.field_value = '5125658878'\n        elif name.endswith('DefendantAddress1[0]'):\n            w.field_value = '299 W Washington Ave'\n        elif name.endswith('DefendantCity1[0]'):\n            w.field_value = 'Sunnyvale'\n        elif name.endswith('DefendantState1[0]'):\n            w.field_value = 'CA'\n        elif name.endswith('DefendantZip1[0]'):\n            w.field_value = '94086'\n        elif name.endswith('PlaintiffClaimAmount1[0]'):\n            w.field_value = '1500'\n        elif label.startswith('Why does the defendant owe'):\n            w.field_value = 'Defendant failed to return $1500 security deposit under signed roommate sublease contract after moving out.'\n        elif label.startswith('How did you calculate'):\n            w.field_value = 'Security deposit amount of $1500 per signed roommate sublease contract.'\n        elif label.startswith('You must ask the defendant'):\n            w.field_value = 'Asked via text multiple times.'\n        elif label == 'Date started':\n            w.field_value = '2025-09-30'\n        elif label == 'through':\n            w.field_value = '2026-01-19'\n        elif 'Sign[0].Date1' in name:\n            w.field_value = '2026-01-19'\n        elif name.endswith('ZipCode1[0]'):\n            w.field_value = '94086'\n        # checkboxes\n        if w.field_type == fitz.PDF_WIDGET_TYPE_CHECKBOX:\n            if name.endswith('Checkbox50[0]'):\n                w.field_value = w.on_state()\n            elif 'List5[0].Lia[0].Checkbox5cb[0]' in name:\n                w.field_value = w.on_state()\n            elif name.endswith('Checkbox60[1]'):\n                w.field_value = w.on_state()\n            elif name.endswith('Checkbox61[1]'):\n                w.field_value = w.on_state()\n            elif name.endswith('Checkbox62[1]'):\n                w.field_value = w.on_state()\n            elif name.endswith('Checkbox63[1]'):\n                w.field_value = w.on_state()\n        w.update()\n\npdf.save('/root/sc100-filled.pdf')\npdf.close()\nPY\n"]
