[296.132905, "i", "python3 - <<'PY'\nimport fitz\n# set value for the 'Why does the defendant owe' field\npdf = fitz.open('/root/sc100-blank.pdf')\nfor page in pdf:\n    for w in page.widgets():\n        if w.field_label and 'Why does the defendant owe' in w.field_label:\n            w.field_value = 'TEST'\n            w.update()\npdf.save('/root/test.pdf')\npdf.close()\n# reopen and check both FillField2 widgets\npdf = fitz.open('/root/test.pdf')\nfor i,page in enumerate(pdf):\n    for w in page.widgets():\n        if w.field_name.endswith('FillField2[0]') and w.field_label and ('Why does' in w.field_label or 'You must ask' in w.field_label):\n            print('page', i, w.field_label, 'value', w.field_value)\npdf.close()\nPY\n"]
