[120.023808, "i", "python3 << 'EOF'\nimport re\nimport html\n\ndef extract_essay_text(filename):\n    with open(filename, 'r', encoding='utf-8', errors='ignore') as f:\n        content = f.read()\n    \n    # Find the main content area (usually between specific tags)\n    # Remove script and style tags\n    content = re.sub(r'<script[^>]*>.*?</script>', '', content, flags=re.DOTALL | re.IGNORECASE)\n    content = re.sub(r'<style[^>]*>.*?</style>', '', content, flags=re.DOTALL | re.IGNORECASE)\n    \n    # Extract text between common content markers\n    # For Paul Graham essays, content is typically in <font> or <td> tags\n    text_parts = []\n    \n    # Remove HTML tags but keep text\n    text = re.sub(r'<[^>]+>', ' ', content)\n    \n    # Clean up whitespace\n    text = re.sub(r'\\s+', ' ', text)\n    text = html.unescape(text)\n    \n    # Remove common navigation text\n    text = re.sub(r'.*?Essays.*?$', '', text, flags=re.IGNORECASE | re.MULTILINE)\n    \n    return text.strip()\n\n# Extract text from both essays\nds_text = extract_essay_text('/tmp/ds.html')\nfm_text = extract_essay_text('/tmp/foundermode.html')\n\nprint(f\"DS essay length: {len(ds_text)} characters\")\nprint(f\"FM essay length: {len(fm_text)} characters\")\nprint(f\"\\nFirst 200 chars of DS: {ds_text[:200]}\")\nprint(f\"\\nFirst 200 chars of FM: {fm_text[:200]}\")\n\n# Save combined text\nwith open('/tmp/combined_essays.txt', 'w') as f:\n    f.write(\"Essay 1: Do Things that Don't Scale\\n\")\n    f.write(\"=\"*50 + \"\\n\\n\")\n    f.write(ds_text)\n    f.write(\"\\n\\n\")\n    f.write(\"Essay 2: Founder Mode\\n\")\n    f.write(\"=\"*50 + \"\\n\\n\")\n    f.write(fm_text)\n\nprint(\"\\nCombined essays saved to /tmp/combined_essays.txt\")\nEOF\n"]
