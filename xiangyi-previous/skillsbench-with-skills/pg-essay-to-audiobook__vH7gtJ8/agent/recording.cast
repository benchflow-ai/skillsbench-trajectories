[132.577915, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> import html\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578106, "o", "def extract_essay_text(filename):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578165, "o", "    with open(filename, 'r', encoding='utf-8', errors='ignore') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578283, "o", "    # Find the main content area (usually between specific tags)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578348, "o", "    # Remove script and style tags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578515, "o", "    content = re.sub(r'<script[^>]*>.*?</script>', '', content, flags=re.DOTALL | re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578698, "o", "    content = re.sub(r'<style[^>]*>.*?</style>', '', content, flags=re.DOTALL | re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.578774, "o", "    # Extract text between common content markers\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.578844, "o", "> "]
[132.578902, "o", "    # For Paul Graham essays, content is typically in <font> or <td> tags\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.57895, "o", ">     text_parts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.579027, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579084, "o", "    # Remove HTML tags but keep text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579143, "o", "    text = re.sub(r'<[^>]+>', ' ', content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.579198, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579247, "o", "    # Clean up whitespace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579307, "o", "    text = re.sub(r'\\s+', ' ', text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.579355, "o", ">     text = html.unescape(text)\r\n\u001b[?2004l\r"]
[132.579404, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579464, "o", "    # Remove common navigation text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579607, "o", "    text = re.sub(r'.*?Essays.*?$', '', text, flags=re.IGNORECASE | re.MULTILINE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579655, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.579718, "o", "    return text.strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
