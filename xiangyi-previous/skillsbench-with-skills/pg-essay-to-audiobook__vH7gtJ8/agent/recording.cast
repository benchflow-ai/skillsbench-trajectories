[96.938081, "i", "python3 << 'EOF'\nimport subprocess\n\nwith open('/tmp/all_urls.txt', 'r') as f:\n    urls = [line.strip() for line in f if line.strip()]\n\nprint(f\"Searching through {len(urls)} essays for 'things' + 'scale'...\")\n\nfor url in urls:\n    try:\n        result = subprocess.run(['curl', '-s', f'https://paulgraham.com/{url}'], capture_output=True, text=True, timeout=3)\n        content = result.stdout.lower()\n        \n        # Search for essays about doing things that don't scale\n        if 'things that don' in content and 'scale' in content:\n            if '<title>' in result.stdout:\n                title = result.stdout.split('<title>')[1].split('</title>')[0]\n                print(f\"FOUND: {url} -> {title}\")\n    except:\n        pass\nEOF\n"]
