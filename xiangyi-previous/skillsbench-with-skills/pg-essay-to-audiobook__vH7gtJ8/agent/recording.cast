[74.050041, "i", "python3 << 'EOF'\nimport os\nimport subprocess\n\n# Try some likely URLs\ncandidates = ['startups.html', 'founders.html', 'airbnb.html', 'airbnbs.html']\n\nfor candidate in candidates:\n    try:\n        result = subprocess.run(['curl', '-s', f'https://paulgraham.com/{candidate}'], capture_output=True, text=True, timeout=5)\n        if 'do things' in result.stdout.lower() or 'scale' in result.stdout.lower():\n            if '<title>' in result.stdout:\n                title = result.stdout.split('<title>')[1].split('</title>')[0]\n                print(f\"Found in {candidate}: {title}\")\n    except:\n        pass\nEOF\n"]
