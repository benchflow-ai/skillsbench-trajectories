[603.453333, "i", "python3 << 'EOF'\nimport os\n\n# Create a concat file for ffmpeg\nwith open('/tmp/concat.txt', 'w') as f:\n    for i in range(10):\n        filename = f'/tmp/audio_chunk_{i:03d}.mp3'\n        f.write(f\"file '{filename}'\\n\")\n\nprint(\"Concat file created\")\nEOF\n"]
