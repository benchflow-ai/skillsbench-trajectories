[189.361417, "i", "python3 << 'EOF'\nfrom openai import OpenAI\nimport os\n\n# Initialize OpenAI client\nclient = OpenAI(api_key=os.environ.get('OPENAI_API_KEY'))\n\n# Read the combined essays\nwith open('/tmp/combined_essays.txt', 'r') as f:\n    text = f.read()\n\nprint(f\"Total text length: {len(text)} characters\")\nprint(f\"First 200 characters:\\n{text[:200]}\")\n\n# Use OpenAI TTS to convert to audio\ntry:\n    print(\"\\nCalling OpenAI TTS API...\")\n    response = client.audio.speech.create(\n        model=\"tts-1\",\n        voice=\"alloy\",\n        input=text\n    )\n    \n    # Save the audio to file\n    with open('/root/audiobook.mp3', 'wb') as f:\n        f.write(response.content)\n    \n    # Check file size\n    import os as os_module\n    file_size = os_module.path.getsize('/root/audiobook.mp3')\n    print(f\"\\nAudio file created successfully!\")\n    print(f\"File: /root/audiobook.mp3\")\n    print(f\"Size: {file_size} bytes ({file_size/1024/1024:.2f} MB)\")\n    \nexcept Exception as e:\n    print(f\"Error: {e}\")\n    import traceback\n    traceback.print_exc()\nEOF\n"]
