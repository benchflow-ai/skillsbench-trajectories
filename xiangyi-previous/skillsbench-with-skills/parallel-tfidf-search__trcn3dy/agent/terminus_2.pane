[?2004l [?2004h> def _worker_tokenize_and_tf(doc: Document) -> tuple[int, dict[str, float]]:
[?2004l[?2004h>     """
[?2004lp[?2004h>     Worker function to tokenize a document and compute term frequencies.
[?2004l[?2004h>     Returns (doc_id, term_frequencies).
[?2004l[?2004h>     """
