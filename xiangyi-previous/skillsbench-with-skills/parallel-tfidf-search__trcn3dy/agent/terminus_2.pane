[?2004l[?2004h> 
[?2004l[?2004h>     # Prepare worker arguments
[?2004l[?2004h>     worker_args = [
[?2004l[?2004h>         (
[?2004l[?2004h>             queries[i],
[?2004l[?2004h>             query_vectors[i],
[?2004l[?2004h>             query_norms[i],
