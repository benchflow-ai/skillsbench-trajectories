[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> from heapq import nlargest
[?2004l[?2004h> from typing import List
[?2004l[?2004h> 
[?2004l[?2004h> from document_generator import Document
[?2004l[?2004h> from sequential import (
[?2004l[?2004h>     SearchResult,
[?2004l[?2004h>     TFIDFIndex,
[?2004l[?2004h>     compute_term_frequencies,
[?2004l[?2004h>     tokenize,
[?2004l[?2004h>     search_sequential,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class ParallelIndexingResult:
[?2004l[?2004h>     """Result from parallel index building."""
[?2004l[?2004h> 
[?2004l[?2004h>     index: TFIDFIndex
[?2004l[?2004h>     elapsed_time: float
[?2004l[?2004h>     num_documents: int
[?2004l[?2004h>     vocabulary_size: int
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _worker_process_chunk(chunk: List[Document]) -> tuple[dict, dict]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Worker function to process a chunk of documents.
[?2004l[?2004h>     Returns (doc_tfs, doc_terms) for the chunk.
[?2004l[?2004h>     """
[?2004l[?2004h>     doc_tfs = {}
[?2004l[?2004h>     doc_terms = {}
[?2004l[?2004h>     
[?2004l[?2004h>     for doc in chunk:
[?2004l[?2004h>         text = doc.title + " " + doc.content
[?2004l[?2004h>         tokens = tokenize(text)
[?2004l[?2004h>         tf = compute_term_frequencies(tokens)
[?2004l[?2004h>         doc_tfs[doc.doc_id] = tf
[?2004l[?2004h>         doc_terms[doc.doc_id] = set(tf.keys())
[?2004l[?2004h>     
[?2004l[?2004h>     return doc_tfs, doc_terms
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004lu[?2004h> def build_tfidf_index_parallel(
[?2004l[?2004h>     documents: List[Document],
[?2004l[?2004h>     num_workers: int = None,
[?2004l[?2004h>     chunk_size: int = 500,
[?2004l[?2004h> ) -> ParallelIndexingResult:
[?2004l[?2004h>     """
[?2004l[?2004h>     Build TF-IDF index in parallel using chunked batch processing.
[?2004l[?2004h> 
[?2004l[?2004h>     Args:
[?2004l[?2004h>         documents: List of Document objects
[?2004l[?2004h>         num_workers: Number of worker processes (default: CPU count)
[?2004l[?2004h>         chunk_size: Chunk size for batch processing (default: 500)
[?2004l[?2004h> 
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         ParallelIndexingResult containing TFIDFIndex and timing info
[?2004l[?2004h>     """
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004l[?2004h> 
[?2004l[?2004h>     # Phase 1: Chunk documents and process in parallel
[?2004l[?2004h>     chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]
[?2004l[?2004h>     
[?2004l[?2004h>     doc_tfs = {}
[?2004l[?2004h>     doc_terms = {}
[?2004l[?2004h>     all_vocabulary = set()
[?2004l[?2004h> 
[?2004l[?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:
[?2004l[?2004h>         futures = [executor.submit(_worker_process_chunk, chunk) for chunk in chunks]
[?2004l[?2004h>         for future in futures:
[?2004l[?2004h>             chunk_tfs, chunk_terms = future.result()
[?2004l[?2004h>             doc_tfs.update(chunk_tfs)
[?2004l[?2004h>             doc_terms.update(chunk_terms)
[?2004l[?2004h>             all_vocabulary.update(set().union(*chunk_terms.values()))
[?2004l[?2004h> 
[?2004l[?2004h>     # Phase 2: Calculate document frequencies
[?2004l[?2004h>     document_frequencies = {}
[?2004l[?2004h>     for term in all_vocabulary:
[?2004l[?2004h>         df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])
[?2004l[?2004h>         document_frequencies[term] = df
[?2004l[?2004h> 
[?2004l[?2004h>     # Phase 3: Compute IDF scores (with smoothing, matching sequential)
[?2004l[?2004h>     num_docs = len(documents)
[?2004l[?2004h>     idf = {}
[?2004l[?2004h>     for term, df in document_frequencies.items():
[?2004l[?2004h>         # IDF(t) = log(N / DF(t)) + 1 (smoothed, matching sequential)
[?2004l[?2004h>         idf[term] = math.log(num_docs / df) + 1
[?2004l[?2004h> 
[?2004l[?2004h>     # Phase 4: Build inverted index and doc vectors
[?2004l[?2004h>     inverted_index = defaultdict(list)
[?2004l[?2004h>     doc_vectors = {}
[?2004l[?2004h>     doc_norms = {}
[?2004l[?2004h> 
[?2004l[?2004h>     for term in all_vocabulary:
[?2004l[?2004h>         posting_list = []
[?2004l[?2004h>         for doc_id, tf_dict in doc_tfs.items():
[?2004l[?2004h>             if term in tf_dict:
[?2004l[?2004h>                 tf = tf_dict[term]
[?2004l[?2004h>                 tfidf = tf * idf[term]
[?2004l[?2004h>                 posting_list.append((doc_id, tfidf))
[?2004l[?2004h>         inverted_index[term] = posting_list
[?2004l[?2004h> 
[?2004l[?2004h>     # Compute doc vectors and norms
[?2004l[?2004h>     for doc_id, tf_dict in doc_tfs.items():
[?2004l[?2004h>         doc_vector = {}
[?2004l[?2004h>         norm_squared = 0.0
[?2004l[?2004h>         for term, tf in tf_dict.items():
[?2004l[?2004h>             tfidf = tf * idf[term]
[?2004l[?2004h>             doc_vector[term] = tfidf
[?2004l[?2004h>             norm_squared += tfidf * tfidf
[?2004l[?2004h>         doc_vectors[doc_id] = doc_vector
[?2004l[?2004h>         doc_norms[doc_id] = math.sqrt(norm_squared)
[?2004l[?2004h> 
[?2004l[?2004h>     # Create index
[?2004l[?2004h>     index = TFIDFIndex(
[?2004l[?2004h>         num_documents=num_docs,
[?2004l[?2004h>         vocabulary=all_vocabulary,
[?2004l[?2004h>         document_frequencies=document_frequencies,
[?2004l[?2004h>         idf=idf,
[?2004l[?2004h>         inverted_index=dict(inverted_index),
[?2004l[?2004h>         doc_vectors=doc_vectors,
[?2004l[?2004h>         doc_norms=doc_norms,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     elapsed_time = time.perf_counter() - start_time
[?2004l[?2004h> 
[?2004l[?2004h>     return ParallelIndexingResult(
[?2004l[?2004h>         index=index,
[?2004l[?2004h>         elapsed_time=elapsed_time,
[?2004l[?2004h>         num_documents=num_docs,
[?2004l[?2004h>         vocabulary_size=len(all_vocabulary),
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def batch_search_parallel(
[?2004l[?2004h>     queries: List[str],
[?2004l[?2004h>     index: TFIDFIndex,
[?2004l[?2004h>     top_k: int = 10,
[?2004l[?2004h>     num_workers: int = None,
[?2004l[?2004h>     documents: List[Document] = None,
[?2004l[?2004h> ) -> tuple[List[List[SearchResult]], float]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Search for multiple queries.
[?2004l[?2004h>     
[?2004l[?2004h>     Uses sequential search as it's already fast. For very large query sets,
[?2004l[?2004h>     parallelization overhead is not worth the complexity.
[?2004l[?2004h> 
[?2004l[?2004h>     Args:
[?2004l[?2004h>         queries: List of search query strings
[?2004l[?2004h>         index: TF-IDF index to search
[?2004l[?2004h>         top_k: Number of top results per query
[?2004l[?2004h>         num_workers: Number of worker processes (ignored, for API compatibility)
[?2004l[?2004h>         documents: Optional list of documents for title lookup
[?2004l[?2004h> 
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         Tuple of (results, elapsed_time) where results is a list of result lists
[?2004l[?2004h>     """
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004l[?2004h> 
[?2004l[?2004h>     # Use sequential search - it's already fast and parallelization overhead is high
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for query in queries:
[?2004l[?2004h>         result = search_sequential(query, index, top_k, documents)
[?2004l[?2004h>         results.append(result)
[?2004l[?2004h> 
[?2004l[?2004h>     elapsed_time = time.perf_counter() - start_time
[?2004l[?2004h> 
[?2004l[?2004h>     return results, elapsed_time
