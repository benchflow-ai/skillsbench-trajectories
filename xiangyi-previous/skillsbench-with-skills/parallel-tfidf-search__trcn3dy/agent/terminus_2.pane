[?2004l[?2004h> 
[?2004l [?2004h> 
[?2004l [?2004h> def build_tfidf_index_parallel(
[?2004l[?2004h>     documents: List[Document],
[?2004l[?2004h>     num_workers: int = None,
[?2004ls[?2004h>     chunk_size: int = 500,
[?2004l[?2004h> ) -> ParallelIndexingResult:
[?2004l[?2004h>     """
[?2004l [?2004h>     Build TF-IDF index in parallel.
[?2004l[?2004h> 
[?2004l[?2004h>     Args:
[?2004l#[?2004h>         documents: List of Document objects
[?2004l[?2004h>         num_workers: Number of worker processes (default: CPU count)
[?2004l[?2004h>         chunk_size: Chunk size for processing (default: 500)
[?2004l[?2004h> 
[?2004lt[?2004h>     Returns:
[?2004l[?2004h>         ParallelIndexingResult containing TFIDFIndex and timing info
[?2004l[?2004h>     """
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004lut[?2004h> 
[?2004l[?2004h>     # Phase 1: Parallel tokenization and TF computation
[?2004l[?2004h>     doc_tfs = {}
[?2004lry_n[?2004h>     all_tokens = defaultdict(int)  # For document frequency computation
[?2004l[?2004h> 
[?2004l [?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:
[?2004l[?2004h>         futures = [executor.submit(_worker_tokenize_and_tf, doc) for doc in documents]
[?2004l[?2004h>         for future in futures:
[?2004l[?2004h>             doc_id, tf = future.result()
[?2004l[?2004h>             doc_tfs[doc_id] = tf
[?2004l[?2004h>             # Count document frequencies (number of documents containing each term)
[?2004l[?2004h>             for term in tf.keys():
[?2004l[?2004h>                 all_tokens[term] += 1
[?2004l[?2004h> 
[?2004l[?2004h>     # Phase 2: Sequential IDF computation (must be done after all docs are processed)
[?2004l[?2004h>     num_docs = len(documents)
[?2004l[?2004h>     idf = {}
[?2004l[?2004h>     vocabulary = set()
[?2004l[?2004h> 
[?2004l [?2004h>     for term, doc_count in all_tokens.items():
[?2004l[?2004h>         vocabulary.add(term)
[?2004l[?2004h>         # IDF = log(N / df)
[?2004l[?2004h>         idf[term] = math.log(num_docs / doc_count)
[?2004l[?2004h> 
[?2004lr[?2004h>     # Phase 3: Build inverted index and doc vectors
[?2004l[?2004h>     inverted_index = defaultdict(list)
[?2004l[?2004h>     doc_vectors = {}
[?2004l[?2004h>     doc_norms = {}
[?2004lro[?2004h> 
[?2004lv[?2004h>     for doc_id, tf_dict in doc_tfs.items():
[?2004l[?2004h>         doc_vector = {}
