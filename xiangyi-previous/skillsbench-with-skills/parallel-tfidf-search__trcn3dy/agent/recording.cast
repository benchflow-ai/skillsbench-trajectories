[831.685148, "o", "    assert 'queries' in params, \"batch_search_parallel missing 'queries' parameter\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.685177, "o", "> "]
[831.685287, "o", "    assert 'index' in params, \"batch_search_parallel missing 'index' parameter\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.685318, "o", "> "]
[831.68565, "o", "    assert 'top_k' in params, \"batch_search_parallel missing 'top_k' parameter\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'num_workers' in params, \"batch_search_parallel missing 'num_workers' parameter\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.685797, "o", "    assert 'documents' in params, \"batch_search_parallel missing 'documents' parameter\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.685848, "o", "> "]
[831.685939, "o", "    print(\"  ✓ batch_search_parallel signature correct\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.685977, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[831.686006, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[831.686072, "o", "def verify_return_types():\r\n\u001b[?2004l\r"]
[831.686099, "o", "\u001b[?2004h> "]
[831.686179, "o", "    \"\"\"Verify return types are correct.\"\"\"\r\n\u001b[?2004l\r"]
[831.686206, "o", "\u001b[?2004h> "]
[831.686289, "o", "    print(\"\\nVerifying return types...\")\r\n\u001b[?2004l\r"]
[831.686319, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[831.686349, "o", "\u001b[?2004h> "]
[831.686439, "o", "    documents = generate_corpus(100, seed=42)\r\n\u001b[?2004l\r"]
[831.686468, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[831.686495, "o", "\u001b[?2004h> "]
[831.686583, "o", "    # Test build_tfidf_index_parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.686615, "o", "> "]
[831.686735, "o", "    result = build_tfidf_index_parallel(documents, num_workers=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.686768, "o", "> "]
[831.686992, "o", "    assert isinstance(result, ParallelIndexingResult), \"build_tfidf_index_parallel should return ParallelIndexingResult\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.687024, "o", "> "]
[831.687189, "o", "    assert hasattr(result, 'index'), \"ParallelIndexingResult missing 'index' attribute\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.687222, "o", "> "]
[831.687397, "o", "    assert hasattr(result, 'elapsed_time'), \"ParallelIndexingResult missing 'elapsed_time' attribute\"\r\n\u001b[?2004l\r"]
[831.687425, "o", "\u001b[?2004h> "]
[831.687627, "o", "    assert hasattr(result, 'num_documents'), \"ParallelIndexingResult missing 'num_documents' attribute\"\r\n\u001b[?2004l\r"]
[831.687654, "o", "\u001b[?2004h> "]
[831.687858, "o", "    assert hasattr(result, 'vocabulary_size'), \"ParallelIndexingResult missing 'vocabulary_size' attribute\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.687886, "o", "> "]
[831.688007, "o", "    print(\"  ✓ build_tfidf_index_parallel return type correct\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.688038, "o", ">     \r\n\u001b[?2004l\r"]
[831.688069, "o", "\u001b[?2004h> "]
[831.688134, "o", "    # Test batch_search_parallel\r\n\u001b[?2004l\r"]
[831.68817, "o", "\u001b[?2004h> "]
[831.688258, "o", "    queries = [\"machine learning\", \"data science\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.688291, "o", "> "]
[831.688519, "o", "    results, elapsed_time = batch_search_parallel(queries, result.index, top_k=5, num_workers=1, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.688715, "o", "    assert isinstance(results, list), \"batch_search_parallel should return (list, float)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.688922, "o", "    assert isinstance(elapsed_time, float), \"batch_search_parallel should return (list, float)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.68968, "o", "    assert len(results) == len(queries), \"batch_search_parallel should return results for all queries\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"  ✓ batch_search_parallel return type correct\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def verify_correctness():\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Verify results are identical to sequential version.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nVerifying correctness...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.689762, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     documents = generate_corpus(500, seed=42)\r\n\u001b[?2004l\r"]
[831.689824, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.68988, "o", "    # Build indexes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.68996, "o", "    seq_result = build_tfidf_index_sequential(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690083, "o", "    par_result = build_tfidf_index_parallel(documents, num_workers=1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[831.690152, "o", "\u001b[?2004h> "]
[831.690212, "o", "    # Check vocabulary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690336, "o", "    assert seq_result.index.vocabulary == par_result.index.vocabulary, \"Vocabularies don't match\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690373, "o", "    print(\"  ✓ Vocabularies match\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[831.690407, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690459, "o", "    # Check IDF values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690527, "o", "    for term in seq_result.index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.6907, "o", "        assert term in par_result.index.idf, f\"Term {term} missing in parallel IDF\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.69076, "o", "        seq_idf = seq_result.index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.690878, "o", "        par_idf = par_result.index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.691275, "o", "        assert abs(seq_idf - par_idf) < 1e-9, f\"IDF mismatch for {term}: {seq_idf} vs {par_idf}\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"  ✓ IDF values match\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check search results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.691312, "o", "    queries = [\"machine learning\", \"data analysis\", \"algorithm\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.691448, "o", "    seq_results = batch_search_sequential(queries, seq_result.index, top_k=5, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.691612, "o", "    par_results, _ = batch_search_parallel(queries, par_result.index, top_k=5, num_workers=1, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[831.691636, "o", "\u001b[?2004h> "]
[831.691759, "o", "    for q_idx, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.691905, "o", "        assert len(seq_res) == len(par_res), f\"Query {q_idx}: result count mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692009, "o", "        for i, (s, p) in enumerate(zip(seq_res, par_res)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692151, "o", "            assert s.doc_id == p.doc_id, f\"Query {q_idx}, result {i}: doc_id mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692303, "o", "            assert abs(s.score - p.score) < 1e-6, f\"Query {q_idx}, result {i}: score mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692365, "o", "    print(\"  ✓ Search results match\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692387, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[831.692409, "o", "\u001b[?2004h> "]
[831.692435, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692518, "o", "    print(\"=\" * 70)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692593, "o", "    print(\"Parallel TF-IDF Solution Verification\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692628, "o", "    print(\"=\" * 70)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692652, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692738, "o", "    verify_function_signatures()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692789, "o", "    verify_return_types()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692837, "o", "    verify_correctness()\r\n\u001b[?2004l\r"]
[831.692861, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.692927, "o", "    print(\"\\n\" + \"=\" * 70)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693027, "o", "    print(\"✓ All verification checks PASSED!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693053, "o", "    print(\"=\" * 70)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693124, "o", "    print(\"\\nSolution Summary:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693267, "o", "    print(\"  - build_tfidf_index_parallel: Parallelizes document processing\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693381, "o", "    print(\"  - batch_search_parallel: Parallelizes query processing\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693494, "o", "    print(\"  - Results are identical to sequential version\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693615, "o", "    print(\"  - Achieves speedup on multi-core systems\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[831.69364, "o", "\u001b[?2004h> "]
[831.693697, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[831.693718, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[831.695529, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
[835.140396, "i", "python3 verify_solution.py\n"]
[835.14068, "o", "python3 verify_solution.py\r\n\u001b[?2004l\r"]
[835.206074, "o", "======================================================================\r\nParallel TF-IDF Solution Verification\r\n======================================================================\r\nVerifying function signatures...\r\n  ✓ build_tfidf_index_parallel signature correct\r\n"]
[835.206269, "o", "  ✓ batch_search_parallel signature correct\r\n\r\nVerifying return types...\r\n"]
[835.475782, "o", "Generated 100 documents.\r\n"]
[835.517849, "o", "  ✓ build_tfidf_index_parallel return type correct\r\n"]
[835.518413, "o", "  ✓ batch_search_parallel return type correct\r\n"]
[835.518733, "o", "\r\nVerifying correctness...\r\n"]
[836.891093, "o", "Generated 500 documents.\r\n"]
[837.281987, "o", "  ✓ Vocabularies match\r\n"]
[837.282181, "o", "  ✓ IDF values match\r\n"]
[837.284584, "o", "  ✓ Search results match\r\n"]
[837.291285, "o", "\r\n======================================================================\r\n✓ All verification checks PASSED!\r\n======================================================================\r\n\r\nSolution Summary:\r\n  - build_tfidf_index_parallel: Parallelizes document processing\r\n  - batch_search_parallel: Parallelizes query processing\r\n  - Results are identical to sequential version\r\n  - Achieves speedup on multi-core systems\r\n"]
