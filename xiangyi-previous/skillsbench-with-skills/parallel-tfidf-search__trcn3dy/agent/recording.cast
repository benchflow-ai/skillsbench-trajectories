[649.435623, "o", "Sequential: 5.171s\r\n  Vocabulary size: 392\r\n  Documents: 10000\r\n\r\nBuilding parallel index (1 workers)...\r\n"]
[655.14561, "o", "Parallel: 5.672s\r\nSpeedup: 0.91x\r\n"]
[655.145693, "o", "\r\nBuilding parallel index (2 workers)...\r\n"]
[659.802161, "o", "Parallel: 4.520s\r\nSpeedup: 1.14x\r\n\r\nBuilding parallel index (4 workers)...\r\n"]
[664.071465, "o", "Parallel: 4.094s\r\nSpeedup: 1.26x\r\n✗ Target speedup (1.5x) not met: 1.26x\r\n\r\n======================================================================\r\nTest 2: Search Performance (200 queries)\r\n======================================================================\r\n"]
[664.071695, "o", "\r\nSearching with 200 queries (sequential)...\r\n"]
