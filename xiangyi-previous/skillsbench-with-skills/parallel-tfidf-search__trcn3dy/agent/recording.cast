[325.527512, "o", "python3 test_parallel_optimized.py"]
[325.527645, "o", "\r\n"]
[325.528079, "o", "\u001b[?2004l\r"]
[325.594591, "o", "======================================================================\r\nOptimized Performance Testing\r\n======================================================================\r\n\r\nGenerating test corpus...\r\n"]
[340.487662, "o", "Generated 5000 documents.\r\nGenerated 5000 documents\r\n\r\n======================================================================\r\nTest 1: Index Building Performance (5000 documents)\r\n======================================================================\r\n\r\nBuilding sequential index...\r\n"]
[342.682724, "o", "Sequential: 2.170s\r\n\r\nBuilding parallel index (1 workers)...\r\n"]
[345.145329, "o", "Parallel: 2.434s\r\nSpeedup: 0.89x\r\n\r\nBuilding parallel index (2 workers)...\r\n"]
[347.96785, "o", "Parallel: 2.744s\r\nSpeedup: 0.79x\r\n\r\nBuilding parallel index (4 workers)...\r\n"]
[350.592685, "o", "Parallel: 2.563s\r\nSpeedup: 0.85x\r\n\r\n======================================================================\r\nTest 2: Search Performance (100 queries)\r\n======================================================================\r\n\r\nSearching with 100 queries (sequential)...\r\n"]
[350.87493, "o", "Sequential: 282.15ms\r\n\r\nSearching with 100 queries (parallel, 1 workers)...\r\n"]
[351.162272, "o", "Parallel: 287.10ms\r\nSpeedup: 0.98x\r\n\r\nSearching with 100 queries (parallel, 2 workers)...\r\n"]
[351.446263, "o", "Parallel: 283.54ms\r\nSpeedup: 1.00x\r\n\r\nSearching with 100 queries (parallel, 4 workers)...\r\n"]
[351.686313, "o", "Parallel: 239.53ms\r\nSpeedup: 1.18x"]
