[412.121782, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.121829, "o", "> "]
[412.121881, "o", "        doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[412.121908, "o", "\u001b[?2004h> "]
[412.122005, "o", "        doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122057, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122107, "o", "    # Create index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122155, "o", "    index = TFIDFIndex(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122209, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.12226, "o", "        vocabulary=all_vocabulary,\r\n\u001b[?2004l\r"]
[412.122307, "o", "\u001b[?2004h> "]
[412.122355, "o", "        document_frequencies=document_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.122411, "o", "> "]
[412.122463, "o", "        idf=idf,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122516, "o", "        inverted_index=dict(inverted_index),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122569, "o", "        doc_vectors=doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122609, "o", "        doc_norms=doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.122634, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.122706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.122748, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[412.122795, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[412.122845, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.122887, "o", ">         index=index,\r\n\u001b[?2004l\r"]
[412.12294, "o", "\u001b[?2004h> "]
[412.122991, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123045, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123094, "o", "        vocabulary_size=len(all_vocabulary),\r\n\u001b[?2004l\r"]
[412.123137, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.12319, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[412.123243, "o", "> def _worker_search_query(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123293, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.12334, "o", "    query_vector: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123388, "o", "    query_norm: float,\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.123438, "o", ">     inverted_index: dict,\r\n\u001b[?2004l\r"]
[412.12349, "o", "\u001b[?2004h>     doc_vectors: dict,\r\n\u001b[?2004l\r"]
[412.123544, "o", "\u001b[?2004h>     doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.123599, "o", ">     top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123651, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123701, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.123739, "o", "    Worker function to search a single query.\r\n\u001b[?2004l\r"]
[412.123795, "o", "\u001b[?2004h> "]
[412.123849, "o", "    Returns list of SearchResult objects.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[412.123899, "o", "\u001b[?2004h> "]
[412.123951, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r"]
[412.124001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124058, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.12411, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124155, "o", "    for term in query_vector:\r\n\u001b[?2004l\r"]
[412.124207, "o", "\u001b[?2004h> "]
[412.124258, "o", "        if term in inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124306, "o", "            for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r"]
[412.12436, "o", "\u001b[?2004h> "]
[412.124416, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[412.124459, "o", ">     # Compute cosine similarity\r\n\u001b[?2004l\r"]
[412.124484, "o", "\u001b[?2004h> "]
[412.12455, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124597, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.124649, "o", "> "]
[412.124704, "o", "        doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124747, "o", "        doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.124794, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124834, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.124858, "o", "            continue\r\n\u001b[?2004l\r"]
[412.124885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.124917, "o", "\u001b[?2004h> "]
[412.125065, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.125116, "o", "> "]
[412.125165, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.125212, "o", "> "]
[412.125258, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.125304, "o", "\u001b[?2004h> "]
[412.125358, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.125455, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.129575, "o", "    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h>     queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h>     index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h>     num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h>     documents: List[Document] = None,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Search for multiple queries in parallel using threading.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h>         queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h>         index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h>         top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers: Number of worker threads (default: CPU count)\r\n\u001b[?2004l\r\u001b[?2004h>         documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r\u001b[?2004h>     query_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h>     query_norms = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h>         query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h>         if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h>             query_vectors.append({})\r\n\u001b[?2004l\r\u001b[?2004h>             query_norms.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>         query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h>         query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h>             if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.129685, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.129746, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.129806, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[412.129865, "o", "\u001b[?2004h> "]
[412.129921, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r"]
[412.129982, "o", "\u001b[?2004h> "]
[412.130071, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r"]
[412.130128, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.130198, "o", "    # Prepare worker arguments\r\n\u001b[?2004l\r"]
[412.130253, "o", "\u001b[?2004h>     worker_args = [\r\n\u001b[?2004l\r"]
[412.130312, "o", "\u001b[?2004h>         (\r\n\u001b[?2004l\r"]
[412.130366, "o", "\u001b[?2004h> "]
[412.130422, "o", "            queries[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.130474, "o", "            query_vectors[i],\r\n\u001b[?2004l\r"]
[412.130528, "o", "\u001b[?2004h> "]
[412.130586, "o", "            query_norms[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.130665, "o", "            index.inverted_index,\r\n\u001b[?2004l\r"]
[412.130724, "o", "\u001b[?2004h> "]
[412.130783, "o", "            index.doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.130831, "o", "            index.doc_norms,\r\n\u001b[?2004l\r"]
[412.13089, "o", "\u001b[?2004h>             top_k,\r\n"]
[412.130946, "o", "\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[412.131002, "o", "\u001b[?2004h> "]
[412.131053, "o", "        for i in range(len(queries))\r\n\u001b[?2004l\r"]
[412.13111, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.131177, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.131226, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.131338, "o", "    with ThreadPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[412.131395, "o", "\u001b[?2004h> "]
[412.131528, "o", "        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\r\n\u001b[?2004l\r"]
[412.131588, "o", "\u001b[?2004h> "]
[412.131644, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.131723, "o", "            results.append(future.result())\r\n\u001b[?2004l\r"]
[412.13178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.131853, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r"]
[412.131906, "o", "\u001b[?2004h>     if documents:\r\n\u001b[?2004l\r"]
[412.131962, "o", "\u001b[?2004h> "]
[412.132051, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r"]
[412.132112, "o", "\u001b[?2004h> "]
[412.132158, "o", "        for result_list in results:\r\n\u001b[?2004l\r"]
[412.132215, "o", "\u001b[?2004h> "]
[412.132266, "o", "            for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.132322, "o", "> "]
[412.132461, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r"]
[412.132518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.132627, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[412.132685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.132748, "o", "    return results, elapsed_time\r\n\u001b[?2004l\r"]
[412.132805, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
