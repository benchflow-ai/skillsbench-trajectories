[195.64962, "o", "Sequential index built in 0.753s\r\n  Vocabulary size: 392\r\n  Documents: 2000\r\n\r\nBuilding parallel index (1 worker)...\r\n"]
[196.915625, "o", "Parallel index built in 1.259s\r\n  Vocabulary size: 392\r\n  Documents: 2000\r\n"]
