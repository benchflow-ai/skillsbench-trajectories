[96.202465, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r"]
[96.202519, "o", "\u001b[?2004h> "]
[96.202573, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.202653, "o", "        vocabulary_size=len(vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[96.202701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.20275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.202798, "o", "def _worker_search_query(\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.202831, "o", ">     query: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.202889, "o", "    query_vector: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.202932, "o", "    query_norm: float,\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.202984, "o", "> "]
[96.203034, "o", "    inverted_index: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203086, "o", "    doc_vectors: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203136, "o", "    doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203188, "o", "    top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203238, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[96.20329, "o", "\u001b[?2004h> "]
[96.203361, "o", "    Worker function to search a single query.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203434, "o", "    Returns list of SearchResult objects.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203481, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203533, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203584, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[96.203634, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[96.203684, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203736, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203798, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203868, "o", "        if term in inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.203974, "o", "            for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204057, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.204111, "o", "\u001b[?2004h> "]
[96.204166, "o", "    # Compute cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204207, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.204259, "o", "> "]
[96.204309, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204391, "o", "        doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.204437, "o", "> "]
[96.204482, "o", "        doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.204528, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204578, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204622, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.20467, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204842, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.204951, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205037, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205142, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205251, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205415, "o", "    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.205468, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20552, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.205573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205612, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.205659, "o", ">     queries: List[str],\r\n\u001b[?2004l\r"]
[96.205705, "o", "\u001b[?2004h> "]
[96.205751, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205803, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r"]
[96.205854, "o", "\u001b[?2004h> "]
[96.205904, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.205953, "o", "    documents: List[Document] = None,\r\n\u001b[?2004l\r"]
[96.205999, "o", "\u001b[?2004h> "]
[96.206055, "o", ") -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.206103, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20617, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.206221, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[96.206273, "o", "\u001b[?2004h> "]
[96.206319, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.206371, "o", "> "]
[96.206421, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.2065, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.206545, "o", "> "]
[96.206622, "o", "        num_workers: Number of worker processes (default: CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.206751, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.206799, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.206831, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.206973, "o", "        Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207021, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207087, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207133, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207197, "o", "    # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.207245, "o", "> "]
[96.20729, "o", "    query_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207336, "o", "    query_norms = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207383, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20743, "o", "    for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207482, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.20753, "o", "> "]
[96.207578, "o", "        if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207642, "o", "            query_vectors.append({})\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.207688, "o", "> "]
[96.207734, "o", "            query_norms.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.207777, "o", "            continue\r\n\u001b[?2004l\r"]
[96.20789, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.208004, "o", "\u001b[?2004h>         query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208077, "o", "        query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208126, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208178, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208247, "o", "            if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208336, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.208382, "o", "> "]
[96.208426, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208522, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.20857, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208637, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.208685, "o", "> "]
[96.208753, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208806, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.208856, "o", "    # Prepare worker arguments\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.208907, "o", ">     worker_args = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.208958, "o", ">         (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20901, "o", "            queries[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.209065, "o", "            query_vectors[i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.209113, "o", "> "]
[96.209167, "o", "            query_norms[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.20922, "o", "            index.inverted_index,\r\n\u001b[?2004l\r"]
[96.209271, "o", "\u001b[?2004h> "]
[96.20932, "o", "            index.doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.209374, "o", "            index.doc_norms,\r\n\u001b[?2004l\r"]
[96.209441, "o", "\u001b[?2004h>             top_k,\r\n\u001b[?2004l\r"]
[96.209493, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[96.209545, "o", "\u001b[?2004h> "]
[96.209597, "o", "        for i in range(len(queries))\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.209649, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.209701, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.2098, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.209847, "o", "> "]
[96.209967, "o", "        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210019, "o", "> "]
[96.210064, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.210139, "o", "            results.append(future.result())\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210185, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.210249, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r"]
[96.210294, "o", "\u001b[?2004h>     if documents:\r\n\u001b[?2004l\r"]
[96.210346, "o", "\u001b[?2004h> "]
[96.21043, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210477, "o", "> "]
[96.21052, "o", "        for result_list in results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210573, "o", "> "]
[96.210628, "o", "            for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.210785, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210833, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.210924, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.210971, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.211015, "o", "    return results, elapsed_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.211058, "o", "> EOF\r\n\u001b[?2004l\r"]
[96.238953, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
[100.401834, "i", "python3 test_parallel.py\n"]
[100.402079, "o", "python3 test_parallel.py\r\n\u001b[?2004l\r"]
[100.470251, "o", "======================================================================\r\nTesting Parallel TF-IDF Implementation\r\n======================================================================\r\n\r\nGenerating test corpus...\r\n"]
[105.581664, "o", "Generated 2000 documents.\r\nGenerated 2000 documents\r\n\r\n======================================================================\r\nTest 1: Index Building Correctness\r\n======================================================================\r\n\r\nBuilding sequential index...\r\n"]
[106.367427, "o", "Sequential index built in 0.776s\r\n  Vocabulary size: 392\r\n  Documents: 2000\r\n\r\nBuilding parallel index (1 worker)...\r\n"]
[107.101605, "o", "Parallel index built in 0.730s\r\n  Vocabulary size: 386\r\n  Documents: 2000\r\n"]
[107.125314, "o", "\r\n❌ Correctness check FAILED with 13584 errors:\r\n  - vocabulary mismatch: 392 vs 386\r\n  - IDF mismatch for term hand: 1.747603366356004 vs 0.7486598904902041\r\n  - IDF mismatch for term causation: 3.0099154790312257 vs 2.017406150760383\r\n  - IDF mismatch for term administer: 2.6686572720940713 vs 1.6686572720940716\r\n  - IDF mismatch for term quarter: 3.488914671185539 vs 2.501036031717884\r\n  ... and 13579 more errors\r\n\r\n======================================================================\r\nTest 2: Index Building Performance\r\n======================================================================\r\n\r\nBuilding parallel index (2 workers)...\r\n"]
[107.690302, "o", "Parallel index built in 0.561s\r\nSpeedup: 1.38x\r\n\r\nBuilding parallel index (4 workers)...\r\n"]
[108.221771, "o", "Parallel index built in 0.497s\r\nSpeedup: 1.56x\r\n\r\n======================================================================\r\nTest 3: Search Correctness\r\n======================================================================\r\n\r\nSearching with 5 queries (sequential)...\r\n"]
[108.232856, "o", "Sequential search completed in 11.05ms\r\n\r\nSearching with 5 queries (parallel, 1 worker)...\r\n"]
[108.872682, "o", "Parallel search completed in 639.64ms\r\n"]
[108.873244, "o", "\r\n❌ Search correctness check FAILED with 91 errors:\r\n  - query 0, result 0: score mismatch: 0.38439616936568044 vs 0.38421678630877154\r\n  - query 0, result 1: score mismatch: 0.3807755460087654 vs 0.3600929298092881\r\n  - query 0, result 2: doc_id mismatch: 612 vs 624\r\n  - query 0, result 2: score mismatch: 0.3665630636926252 vs 0.357757066233992\r\n  - query 0, result 3: doc_id mismatch: 1707 vs 692\r\n  ... and 86 more errors\r\n\r\n======================================================================\r\nTest 4: Search Performance\r\n======================================================================\r\n\r\nSearching with 5 queries (parallel, 2 workers)...\r\n"]
[109.55714, "o", "Parallel search completed in 683.64ms\r\nSpeedup: 0.02x\r\n\r\nSearching with 5 queries (parallel, 4 workers)...\r\n"]
[110.219032, "o", "Parallel search completed in 661.75ms\r\nSpeedup: 0.02x\r\n\r\n======================================================================\r\nAll tests completed!\r\n======================================================================\r\n"]
[110.336255, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
[138.504027, "i", "cat > debug_parallel.py << 'EOF'\n#!/usr/bin/env python3\n\nimport time\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential\nfrom parallel_solution import build_tfidf_index_parallel\n\n# Generate small test corpus\nprint(\"Generating test corpus...\")\ndocuments = generate_corpus(10, seed=42)\nprint(f\"Generated {len(documents)} documents\")\nfor i, doc in enumerate(documents):\n    print(f\"  Doc {i}: id={doc.doc_id}, title={doc.title[:30]}...\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"Building sequential index...\")\nseq_result = build_tfidf_index_sequential(documents)\nprint(f\"Sequential: {seq_result.vocabulary_size} terms, {seq_result.num_documents} docs\")\nprint(f\"Sample IDF values:\")\nfor i, (term, idf) in enumerate(list(seq_result.index.idf.items())[:5]):\n    print(f\"  {term}: {idf:.4f}\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"Building parallel index...\")\npar_result = build_tfidf_index_parallel(documents, num_workers=1)\nprint(f\"Parallel: {par_result.vocabulary_size} terms, {par_result.num_documents} docs\")\nprint(f\"Sample IDF values:\")\nfor i, (term, idf) in enumerate(list(par_result.index.idf.items())[:5]):\n    print(f\"  {term}: {idf:.4f}\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"Comparing vocabularies...\")\nseq_vocab = set(seq_result.index.idf.keys())\npar_vocab = set(par_result.index.idf.keys())\n\nmissing_in_par = seq_vocab - par_vocab\nextra_in_par = par_vocab - seq_vocab\n\nif missing_in_par:\n    print(f\"\\nTerms missing in parallel ({len(missing_in_par)}):\")\n    for term in list(missing_in_par)[:10]:\n        df_seq = seq_result.index.document_frequencies.get(term, 0)\n        print(f\"  {term}: df={df_seq}\")\n\nif extra_in_par:\n    print(f\"\\nExtra terms in parallel ({len(extra_in_par)}):\")\n    for term in list(extra_in_par)[:10]:\n        df_par = par_result.index.document_frequencies.get(term, 0)\n        print(f\"  {term}: df={df_par}\")\nEOF\n"]
[138.504396, "o", "cat > debug_parallel.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.504424, "o", "> "]
[138.504543, "o", "from document_generator import generate_corpus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.504613, "o", "from sequential import build_tfidf_index_sequential\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.504769, "o", "from parallel_solution import build_tfidf_index_parallel\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[138.504808, "o", "\u001b[?2004h> # Generate small test corpus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.504955, "o", "print(\"Generating test corpus...\")\r\n\u001b[?2004l\r\u001b[?2004h> documents = generate_corpus(10, seed=42)\r\n\u001b[?2004l\r"]
[138.505021, "o", "\u001b[?2004h> "]
[138.505086, "o", "print(f\"Generated {len(documents)} documents\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
