[186.302067, "o", "    doc_norms = {}\r\n\u001b[?2004l\r"]
[186.302104, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rq\u001b[?2004h> "]
[186.302186, "o", "    for term in all_vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.302213, "o", "> "]
[186.302288, "o", "        posting_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.302371, "o", "        for doc_id, tf_dict in doc_tfs.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.30243, "o", "> "]
[186.302472, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.302532, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[186.302557, "o", "\u001b[?2004h> "]
[186.302621, "o", "                tfidf = tf * idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.302646, "o", "> "]
[186.302744, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[186.30277, "o", "\u001b[?2004h> "]
[186.302857, "o", "        inverted_index[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.302908, "o", "> \r\n\u001b[?2004l\rf\u001b[?2004h> "]
[186.302977, "o", "    # Compute doc vectors and norms\r\n\u001b[?2004l\r"]
[186.303026, "o", "\u001b[?2004h> "]
[186.303083, "o", "    for doc_id, tf_dict in doc_tfs.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.303109, "o", "> "]
[186.303158, "o", "        doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.303216, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r \u001b[?2004h"]
[186.30326, "o", "> "]
[186.303305, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[186.30335, "o", "\u001b[?2004h> "]
[186.303387, "o", "            tfidf = tf * idf[term]\r\n\u001b[?2004l\r,"]
[186.303432, "o", "\u001b[?2004h> "]
[186.30348, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\rl"]
[186.303525, "o", "\u001b[?2004h> "]
[186.303576, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[186.303603, "o", "\u001b[?2004h> "]
[186.303671, "o", "        doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.303731, "o", "> "]
[186.303784, "o", "        doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.303836, "o", "\u001b[?2004h>     # Create index\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.303887, "o", ">     index = TFIDFIndex(\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.303939, "o", "> "]
[186.303992, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304045, "o", "        vocabulary=all_vocabulary,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304112, "o", "        document_frequencies=document_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304138, "o", ">         idf=idf,\r\n\u001b[?2004l\r"]
[186.304205, "o", "\u001b[?2004h> "]
[186.304261, "o", "        inverted_index=dict(inverted_index),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304304, "o", "        doc_vectors=doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304358, "o", "        doc_norms=doc_norms,\r\n\u001b[?2004l\r"]
[186.304384, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.30445, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304493, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304547, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.3046, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304652, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304701, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r"]
[186.304749, "o", "\u001b[?2004h> "]
[186.304803, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304848, "o", "        vocabulary_size=len(all_vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304874, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304899, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.304995, "o", "\u001b[?2004h> "]
[186.305052, "o", "def _worker_search_query(\r\n\u001b[?2004l\r\u001b[?2004h>     query: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.3051, "o", "    query_vector: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305149, "o", "    query_norm: float,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305189, "o", "    inverted_index: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305231, "o", "    doc_vectors: dict,\r\n\u001b[?2004l\r"]
[186.305257, "o", "\u001b[?2004h> "]
[186.305322, "o", "    doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int,\r\n\u001b[?2004l\r"]
[186.305376, "o", "\u001b[?2004h> "]
[186.305453, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305499, "o", "    Worker function to search a single query.\r\n\u001b[?2004l\r"]
[186.305546, "o", "\u001b[?2004h> "]
[186.305603, "o", "    Returns list of SearchResult objects.\r\n\u001b[?2004l\r"]
[186.305645, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305693, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.30574, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305789, "o", "    # Find candidate documents\r\n\u001b[?2004l\r"]
[186.305843, "o", "\u001b[?2004h> "]
[186.305887, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.305934, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.305985, "o", "> "]
[186.306038, "o", "        if term in inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306089, "o", "> "]
[186.306132, "o", "            for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r"]
[186.306184, "o", "\u001b[?2004h> "]
[186.306225, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.306271, "o", "\u001b[?2004h> "]
[186.306319, "o", "    # Compute cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306366, "o", ">     scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.306406, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[186.306459, "o", "\u001b[?2004h> "]
[186.306537, "o", "        doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r"]
[186.306585, "o", "\u001b[?2004h> "]
[186.306647, "o", "        doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306703, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.306745, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.306787, "o", "            continue\r\n\u001b[?2004l\r"]
[186.306834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.306976, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r"]
[186.307024, "o", "\u001b[?2004h> "]
[186.307087, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[186.307141, "o", "\u001b[?2004h> "]
[186.307179, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.307232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.307282, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.307361, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.307408, "o", "> "]
[186.307501, "o", "    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.307553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.307604, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.307645, "o", "\u001b[?2004h> def batch_search_parallel(\r\n\u001b[?2004l\r"]
[186.307689, "o", "\u001b[?2004h> "]
[186.307738, "o", "    queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.307788, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.307834, "o", ">     top_k: int = 10,\r\n\u001b[?2004l\r"]
[186.307883, "o", "\u001b[?2004h> "]
[186.30793, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.30798, "o", "    documents: List[Document] = None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.308027, "o", "> "]
[186.308054, "o", ") -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[186.308099, "o", "\u001b[?2004h> "]
[186.308156, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.308202, "o", "\u001b[?2004h> "]
[186.308249, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.308301, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.308382, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r"]
[186.308428, "o", "\u001b[?2004h> "]
[186.30851, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r"]
[186.308557, "o", "\u001b[?2004h> "]
[186.308684, "o", "        num_workers: Number of worker processes (default: CPU count)\r\n\u001b[?2004l\r"]
[186.308711, "o", "\u001b[?2004h> "]
[186.308831, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.308885, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.308944, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.309107, "o", "        Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r"]
[186.309133, "o", "\u001b[?2004h> "]
[186.309158, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[186.309211, "o", "\u001b[?2004h> "]
[186.309292, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.309342, "o", "\u001b[?2004h> "]
[186.30943, "o", "    # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r"]
[186.309482, "o", "\u001b[?2004h> "]
[186.309532, "o", "    query_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.309557, "o", "    query_norms = []\r\n\u001b[?2004l\r"]
[186.309584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.309635, "o", "\u001b[?2004h> "]
[186.309736, "o", "    for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.30978, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[186.309827, "o", "\u001b[?2004h> "]
[186.309879, "o", "        if not query_tokens:\r\n\u001b[?2004l\r"]
[186.309933, "o", "\u001b[?2004h> "]
[186.309982, "o", "            query_vectors.append({})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310033, "o", "            query_norms.append(0.0)\r\n\u001b[?2004l\r"]
[186.310058, "o", "\u001b[?2004h> "]
[186.310084, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.310136, "o", "\u001b[?2004h> "]
[186.31022, "o", "        query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310247, "o", "        query_vector = {}\r\n\u001b[?2004l\r"]
[186.310294, "o", "\u001b[?2004h> "]
[186.310357, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.310405, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310451, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310504, "o", "            if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310567, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[186.310613, "o", "\u001b[?2004h> "]
[186.31067, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310778, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[186.310833, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310891, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310983, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.311037, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311082, "o", "    # Prepare worker arguments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311132, "o", "    worker_args = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.311181, "o", ">         (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311236, "o", "            queries[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311289, "o", "            query_vectors[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.31134, "o", "            query_norms[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311387, "o", "            index.inverted_index,\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.31143, "o", ">             index.doc_vectors,\r\n\u001b[?2004l\r"]
[186.311477, "o", "\u001b[?2004h> "]
[186.311533, "o", "            index.doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311587, "o", "            top_k,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.311629, "o", "> "]
[186.311682, "o", "        for i in range(len(queries))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.311742, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r"]
[186.311798, "o", "\u001b[?2004h> "]
[186.311845, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[186.311896, "o", "\u001b[?2004h> "]
[186.311998, "o", "        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.312053, "o", "> "]
[186.312105, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312151, "o", "            results.append(future.result())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.3122, "o", "\u001b[?2004h> "]
[186.312253, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.3123, "o", ">     if documents:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312375, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r"]
[186.312433, "o", "\u001b[?2004h> "]
[186.312484, "o", "        for result_list in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312535, "o", "            for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.31267, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.312723, "o", "\u001b[?2004h> "]
[186.312776, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.31283, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312857, "o", "    return results, elapsed_time\r\n\u001b[?2004l\r"]
[186.312934, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[186.324768, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
[189.759156, "i", "python3 test_parallel.py\n"]
[189.759567, "o", "python3 test_parallel.py\r\n\u001b[?2004l\r"]
