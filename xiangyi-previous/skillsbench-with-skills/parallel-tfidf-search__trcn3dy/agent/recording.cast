[611.318599, "o", "- Search: Uses ProcessPoolExecutor with query batches for efficient parallelization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.31865, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
