[186.299911, "o", "        futures = [executor.submit(_worker_tokenize_and_tf, doc) for doc in documents]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.300024, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
