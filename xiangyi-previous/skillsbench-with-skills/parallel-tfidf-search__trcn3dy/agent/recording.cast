[321.109349, "o", "    # Create index\r\n\u001b[?2004l\r\u001b[?2004h>     index = TFIDFIndex(\r\n\u001b[?2004l\r\u001b[?2004h>         num_documents=num_docs,\r\n\u001b[?2004l\r"]
[321.109479, "o", "\u001b[?2004h> "]
[321.109523, "o", "        vocabulary=all_vocabulary,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.109611, "o", "        document_frequencies=document_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h>         idf=idf,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.109692, "o", "        inverted_index=dict(inverted_index),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.109773, "o", "        doc_vectors=doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.109816, "o", "        doc_norms=doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[321.109931, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110007, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110079, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.11015, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.1102, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110318, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110399, "o", "        vocabulary_size=len(all_vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110446, "o", "def _worker_search_query(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110653, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h>     query_vector: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     query_norm: float,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110762, "o", "    inverted_index: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     doc_vectors: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110801, "o", "    doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110886, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.110967, "o", "    Worker function to search a single query.\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.111055, "o", "> "]
[321.111148, "o", "    Returns list of SearchResult objects.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111191, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.111235, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111278, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.111311, "o", "> "]
[321.111449, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h>     for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111488, "o", "        if term in inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111554, "o", "            for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111628, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.111679, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.111764, "o", "    # Compute cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.111821, "o", ">     scores = []\r\n\u001b[?2004l\r\u001b[?2004h>     for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[321.111857, "o", "\u001b[?2004h> "]
[321.111922, "o", "        doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.112007, "o", "        doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.112045, "o", "\u001b[?2004h> "]
[321.112078, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.112162, "o", ">             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.112356, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.112439, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.112505, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.112549, "o", "\u001b[?2004h> "]
[321.112582, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.112682, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.112721, "o", "> "]
[321.112842, "o", "    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.112922, "o", "\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.11299, "o", "\u001b[?2004h> def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113061, "o", "    queries: List[str],\r\n\u001b[?2004l\r"]
[321.113123, "o", "\u001b[?2004h>     index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113169, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.11326, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113319, "o", "    documents: List[Document] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113358, "o", ") -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r"]
[321.113418, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.113543, "o", "> "]
[321.1137, "o", "    Search for multiple queries in parallel using threading.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113776, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h>         index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113861, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.113973, "o", "        num_workers: Number of worker threads (default: CPU count)\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.114101, "o", ">         documents: Optional list of documents for title lookup"]
[321.114181, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114317, "o", "        Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114402, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114485, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114539, "o", "    # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114608, "o", "    query_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114664, "o", "    query_norms = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114715, "o", "    for query in queries:\r\n\u001b[?2004l\r"]
[321.114765, "o", "\u001b[?2004h> "]
[321.114821, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.114888, "o", "        if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.114955, "o", ">             query_vectors.append({})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.11504, "o", "            query_norms.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115121, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.115182, "o", "\u001b[?2004h> "]
[321.115263, "o", "        query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115322, "o", "        query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115364, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115435, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[321.115476, "o", "\u001b[?2004h> "]
[321.115518, "o", "            if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.11555, "o", "> "]
[321.115635, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115699, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.115749, "o", "> "]
[321.115804, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[321.11586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.115931, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116048, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116115, "o", "    # Prepare worker arguments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116147, "o", "    worker_args = [\r\n\u001b[?2004l\r"]
[321.116241, "o", "\u001b[?2004h>         (\r\n\u001b[?2004l\r\u001b[?2004h>             queries[i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.116302, "o", "> "]
[321.116362, "o", "            query_vectors[i],\r\n\u001b[?2004l\r\u001b[?2004h>             query_norms[i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.116397, "o", "> "]
[321.116488, "o", "            index.inverted_index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116536, "o", "            index.doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116585, "o", "            index.doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116628, "o", "            top_k,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[321.116669, "o", "\u001b[?2004h> "]
[321.116708, "o", "        for i in range(len(queries))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116777, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.116824, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.116947, "o", "    with ThreadPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117074, "o", "        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117233, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h>             results.append(future.result())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.117341, "o", "\u001b[?2004h> "]
[321.117409, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r\u001b[?2004h>     if documents:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117483, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.117514, "o", "> "]
[321.117613, "o", "        for result_list in results:\r\n\u001b[?2004l\r"]
[321.117687, "o", "\u001b[?2004h>             for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117798, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117864, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.117915, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[321.117981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.118042, "o", "    return results, elapsed_time\r\n\u001b[?2004l\r"]
[321.1181, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[321.14268, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
