[155.340496, "i", "cat > debug_parallel2.py << 'EOF'\n#!/usr/bin/env python3\n\nfrom document_generator import generate_corpus\nfrom sequential import tokenize, compute_term_frequencies\nfrom collections import defaultdict\nimport math\n\n# Generate small test corpus\nprint(\"Generating test corpus...\")\ndocuments = generate_corpus(10, seed=42)\nprint(f\"Generated {len(documents)} documents\\n\")\n\n# Manually process documents like sequential version\nprint(\"Sequential processing:\")\nall_tokens_seq = defaultdict(int)\ndoc_tfs_seq = {}\n\nfor doc in documents:\n    tokens = tokenize(doc.content)\n    tf = compute_term_frequencies(tokens)\n    doc_tfs_seq[doc.doc_id] = tf\n    for term in tf.keys():\n        all_tokens_seq[term] += 1\n    print(f\"Doc {doc.doc_id}: {len(tokens)} tokens, {len(tf)} unique terms\")\n\nprint(f\"\\nTotal unique terms (sequential): {len(all_tokens_seq)}\")\nprint(f\"Docs processed: {len(doc_tfs_seq)}\")\n\n# Check for 'review' and 'introduction'\nprint(f\"\\n'review' document frequency: {all_tokens_seq.get('review', 0)}\")\nprint(f\"'introduction' document frequency: {all_tokens_seq.get('introduction', 0)}\")\n\n# Now try parallel version\nprint(\"\\n\" + \"=\"*60)\nprint(\"Parallel processing (with debugging):\")\n\nfrom concurrent.futures import ProcessPoolExecutor\nfrom sequential import tokenize, compute_term_frequencies\n\ndef _worker_tokenize_and_tf_debug(doc):\n    tokens = tokenize(doc.content)\n    tf = compute_term_frequencies(tokens)\n    print(f\"  Worker processed doc {doc.doc_id}: {len(tokens)} tokens, {len(tf)} unique terms\")\n    return doc.doc_id, tf\n\nall_tokens_par = defaultdict(int)\ndoc_tfs_par = {}\n\nwith ProcessPoolExecutor(max_workers=1) as executor:\n    futures = [executor.submit(_worker_tokenize_and_tf_debug, doc) for doc in documents]\n    for i, future in enumerate(futures):\n        doc_id, tf = future.result()\n        doc_tfs_par[doc_id] = tf\n        for term in tf.keys():\n            all_tokens_par[term] += 1\n        print(f\"Main collected doc {doc_id}\")\n\nprint(f\"\\nTotal unique terms (parallel): {len(all_tokens_par)}\")\nprint(f\"Docs processed: {len(doc_tfs_par)}\")\n\nprint(f\"\\n'review' document frequency: {all_tokens_par.get('review', 0)}\")\nprint(f\"'introduction' document frequency: {all_tokens_par.get('introduction', 0)}\")\nEOF\n"]
[155.340973, "o", "cat > debug_parallel2.py << 'EOF'\r\n\u001b[?2004l\r"]
