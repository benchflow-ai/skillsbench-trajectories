[230.777526, "i", "cat > test_parallel_optimized.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nTest script for parallel TF-IDF with optimized workloads.\n\"\"\"\n\nimport time\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\n\ndef main():\n    print(\"=\" * 70)\n    print(\"Optimized Performance Testing\")\n    print(\"=\" * 70)\n\n    # Generate larger test corpus\n    print(\"\\nGenerating test corpus...\")\n    num_docs = 5000\n    documents = generate_corpus(num_docs, seed=42)\n    print(f\"Generated {len(documents)} documents\")\n\n    # Test 1: Index building performance\n    print(\"\\n\" + \"=\" * 70)\n    print(\"Test 1: Index Building Performance (5000 documents)\")\n    print(\"=\" * 70)\n\n    print(\"\\nBuilding sequential index...\")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f\"Sequential: {seq_result.elapsed_time:.3f}s\")\n\n    for num_workers in [1, 2, 4]:\n        print(f\"\\nBuilding parallel index ({num_workers} workers)...\")\n        par_result = build_tfidf_index_parallel(documents, num_workers=num_workers)\n        print(f\"Parallel: {par_result.elapsed_time:.3f}s\")\n        speedup = seq_result.elapsed_time / par_result.elapsed_time\n        print(f\"Speedup: {speedup:.2f}x\")\n\n    # Test 2: Search performance with many queries\n    print(\"\\n\" + \"=\" * 70)\n    print(\"Test 2: Search Performance (100 queries)\")\n    print(\"=\" * 70)\n\n    # Generate many test queries\n    test_queries = [\n        \"machine learning algorithm\",\n        \"data analysis\",\n        \"software development\",\n        \"scientific research\",\n        \"business strategy\",\n    ] * 20  # 100 queries\n\n    print(f\"\\nSearching with {len(test_queries)} queries (sequential)...\")\n    seq_search_start = time.perf_counter()\n    seq_search_results = batch_search_sequential(test_queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - seq_search_start\n    print(f\"Sequential: {seq_search_time*1000:.2f}ms\")\n\n    for num_workers in [1, 2, 4]:\n        print(f\"\\nSearching with {len(test_queries)} queries (parallel, {num_workers} workers)...\")\n        par_search_results, par_search_time = batch_search_parallel(\n            test_queries, seq_result.index, top_k=10, num_workers=num_workers, documents=documents\n        )\n        print(f\"Parallel: {par_search_time*1000:.2f}ms\")\n        speedup = seq_search_time / par_search_time\n        print(f\"Speedup: {speedup:.2f}x\")\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"Tests completed!\")\n    print(\"=\" * 70)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
