[611.345913, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r\u001b[?2004h>         num_documents=num_docs,\r\n\u001b[?2004l\r"]
[611.349448, "o", "\u001b[?2004h> "]
[611.349559, "o", "        vocabulary_size=len(all_vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _worker_search_batch(\r\n\u001b[?2004l\r\u001b[?2004h>     query_batch: List[str],\r\n\u001b[?2004l\r\u001b[?2004h>     query_vectors: List[dict],\r\n\u001b[?2004l\r\u001b[?2004h>     query_norms: List[float],\r\n\u001b[?2004l\r\u001b[?2004h>     inverted_index: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     doc_vectors: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> List[List[SearchResult]]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Worker function to search a batch of queries.\r\n\u001b[?2004l\r\u001b[?2004h>     Returns list of result lists.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for query_vector, query_norm in zip(query_vectors, query_norms):\r\n\u001b[?2004l\r\u001b[?2004h>         if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h>             results.append([])\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h>         candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h>         for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h>             if term in inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h>                 for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h>                     candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Compute cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h>         scores = []\r\n\u001b[?2004l\r\u001b[?2004h>         for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.349642, "o", "            doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r"]
[611.349714, "o", "\u001b[?2004h> "]
[611.349802, "o", "            doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r"]
[611.349885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.349981, "o", "            if doc_norm == 0:\r\n\u001b[?2004l\r"]
[611.350075, "o", "\u001b[?2004h> "]
[611.350164, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.350437, "o", "            dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r"]
[611.350543, "o", "\u001b[?2004h> "]
[611.350687, "o", "            similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[611.350792, "o", "\u001b[?2004h> "]
[611.350876, "o", "            scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[611.350967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[611.351018, "o", "\u001b[?2004h> "]
[611.351108, "o", "        # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.351197, "o", "> "]
[611.35131, "o", "        top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[611.351403, "o", "\u001b[?2004h> "]
[611.351588, "o", "        query_results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r"]
[611.351693, "o", "\u001b[?2004h> "]
[611.351778, "o", "        results.append(query_results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.351876, "o", ">     \r\n\u001b[?2004l\r"]
[611.351925, "o", "\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.351971, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[611.352085, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[611.352182, "o", "> def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.352228, "o", ">     queries: List[str],\r\n\u001b[?2004l\r"]
[611.352322, "o", "\u001b[?2004h> "]
[611.352414, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.352509, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.352599, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r"]
[611.352694, "o", "\u001b[?2004h> "]
[611.352784, "o", "    documents: List[Document] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.352933, "o", ") -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.353023, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.353163, "o", "    Search for multiple queries in parallel using batch processing.\r\n\u001b[?2004l\r"]
[611.353257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[611.353351, "o", "\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.353462, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r"]
[611.353499, "o", "\u001b[?2004h> "]
[611.353578, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r"]
[611.353629, "o", "\u001b[?2004h> "]
[611.353768, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.353927, "o", "        num_workers: Number of worker processes (default: CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.354051, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[611.354153, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[611.354235, "o", "\u001b[?2004h> "]
[611.354328, "o", "        Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r"]
[611.354429, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.354542, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.354642, "o", "    # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.354737, "o", "    query_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.354908, "o", "    query_norms = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.355024, "o", "    for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.355191, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.355285, "o", ">         if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h>             query_vectors.append({})\r\n"]
[611.355385, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[611.355474, "o", "            query_norms.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.3556, "o", "        query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[611.355692, "o", "\u001b[?2004h> "]
[611.355799, "o", "        query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.355909, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356015, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.3561, "o", "            if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356186, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356268, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[611.356361, "o", "\u001b[?2004h> "]
[611.356446, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356545, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r"]
[611.356636, "o", "\u001b[?2004h> "]
[611.35673, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356805, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.356919, "o", "    # Batch queries for parallel processing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357009, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357089, "o", "        import multiprocessing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357157, "o", "        num_workers = multiprocessing.cpu_count()\r\n\u001b[?2004l\r"]
[611.357238, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357337, "o", "    batch_size = max(1, len(queries) // num_workers)\r\n\u001b[?2004l\r"]
[611.357433, "o", "\u001b[?2004h>     query_batches = []\r\n\u001b[?2004l\r"]
[611.357523, "o", "\u001b[?2004h> "]
[611.35762, "o", "    vector_batches = []\r\n\u001b[?2004l\r\u001b[?2004h>     norm_batches = []\r\n\u001b[?2004l\r"]
[611.357704, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357786, "o", "    for i in range(0, len(queries), batch_size):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.357897, "o", "        query_batches.append(queries[i:i + batch_size])\r\n\u001b[?2004l\r"]
[611.357991, "o", "\u001b[?2004h> "]
[611.35808, "o", "        vector_batches.append(query_vectors[i:i + batch_size])\r\n\u001b[?2004l\r"]
[611.358164, "o", "\u001b[?2004h> "]
[611.358244, "o", "        norm_batches.append(query_norms[i:i + batch_size])\r\n\u001b[?2004l\r"]
[611.358336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.358443, "o", "    # Process batches in parallel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.358533, "o", "    all_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.358615, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[611.358711, "o", "\u001b[?2004h> "]
[611.358802, "o", "        futures = [\r\n\u001b[?2004l\r\u001b[?2004h>             executor.submit(\r\n\u001b[?2004l\r"]
[611.358899, "o", "\u001b[?2004h> "]
[611.35901, "o", "                _worker_search_batch,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359106, "o", "                query_batches[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359214, "o", "                vector_batches[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359319, "o", "                norm_batches[i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.359405, "o", ">                 index.inverted_index,"]
[611.359499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359592, "o", "                index.doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359687, "o", "                index.doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359793, "o", "                top_k,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.35988, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.359968, "o", "            for i in range(len(query_batches))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360083, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360183, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360287, "o", "            batch_results = future.result()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360425, "o", "            all_results.extend(batch_results)\r\n\u001b[?2004l\r"]
[611.360512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.36059, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360699, "o", "    if documents:\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.360793, "o", "> "]
[611.360898, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.360992, "o", "        for result_list in all_results:\r\n\u001b[?2004l\r"]
[611.361089, "o", "\u001b[?2004h>             for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.361184, "o", "> "]
[611.361288, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[611.361405, "o", ">     elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[611.361513, "o", "> "]
[611.361596, "o", "    return all_results, elapsed_time\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[611.365626, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
[615.493544, "i", "python3 test_final.py\n"]
[615.49403, "o", "python3 test_final.py\r\n\u001b[?2004l\r"]
