[831.679391, "i", "cat > verify_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nVerification script for parallel TF-IDF solution.\n\"\"\"\n\nimport inspect\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import (\n    build_tfidf_index_parallel,\n    batch_search_parallel,\n    ParallelIndexingResult,\n)\n\n\ndef verify_function_signatures():\n    \"\"\"Verify function signatures match requirements.\"\"\"\n    print(\"Verifying function signatures...\")\n    \n    # Check build_tfidf_index_parallel\n    sig = inspect.signature(build_tfidf_index_parallel)\n    params = list(sig.parameters.keys())\n    assert 'documents' in params, \"build_tfidf_index_parallel missing 'documents' parameter\"\n    assert 'num_workers' in params, \"build_tfidf_index_parallel missing 'num_workers' parameter\"\n    assert 'chunk_size' in params, \"build_tfidf_index_parallel missing 'chunk_size' parameter\"\n    print(\"  ✓ build_tfidf_index_parallel signature correct\")\n    \n    # Check batch_search_parallel\n    sig = inspect.signature(batch_search_parallel)\n    params = list(sig.parameters.keys())\n    assert 'queries' in params, \"batch_search_parallel missing 'queries' parameter\"\n    assert 'index' in params, \"batch_search_parallel missing 'index' parameter\"\n    assert 'top_k' in params, \"batch_search_parallel missing 'top_k' parameter\"\n    assert 'num_workers' in params, \"batch_search_parallel missing 'num_workers' parameter\"\n    assert 'documents' in params, \"batch_search_parallel missing 'documents' parameter\"\n    print(\"  ✓ batch_search_parallel signature correct\")\n\n\ndef verify_return_types():\n    \"\"\"Verify return types are correct.\"\"\"\n    print(\"\\nVerifying return types...\")\n    \n    documents = generate_corpus(100, seed=42)\n    \n    # Test build_tfidf_index_parallel\n    result = build_tfidf_index_parallel(documents, num_workers=1)\n    assert isinstance(result, ParallelIndexingResult), \"build_tfidf_index_parallel should return ParallelIndexingResult\"\n    assert hasattr(result, 'index'), \"ParallelIndexingResult missing 'index' attribute\"\n    assert hasattr(result, 'elapsed_time'), \"ParallelIndexingResult missing 'elapsed_time' attribute\"\n    assert hasattr(result, 'num_documents'), \"ParallelIndexingResult missing 'num_documents' attribute\"\n    assert hasattr(result, 'vocabulary_size'), \"ParallelIndexingResult missing 'vocabulary_size' attribute\"\n    print(\"  ✓ build_tfidf_index_parallel return type correct\")\n    \n    # Test batch_search_parallel\n    queries = [\"machine learning\", \"data science\"]\n    results, elapsed_time = batch_search_parallel(queries, result.index, top_k=5, num_workers=1, documents=documents)\n    assert isinstance(results, list), \"batch_search_parallel should return (list, float)\"\n    assert isinstance(elapsed_time, float), \"batch_search_parallel should return (list, float)\"\n    assert len(results) == len(queries), \"batch_search_parallel should return results for all queries\"\n    print(\"  ✓ batch_search_parallel return type correct\")\n\n\ndef verify_correctness():\n    \"\"\"Verify results are identical to sequential version.\"\"\"\n    print(\"\\nVerifying correctness...\")\n    \n    documents = generate_corpus(500, seed=42)\n    \n    # Build indexes\n    seq_result = build_tfidf_index_sequential(documents)\n    par_result = build_tfidf_index_parallel(documents, num_workers=1)\n    \n    # Check vocabulary\n    assert seq_result.index.vocabulary == par_result.index.vocabulary, \"Vocabularies don't match\"\n    print(\"  ✓ Vocabularies match\")\n    \n    # Check IDF values\n    for term in seq_result.index.idf:\n        assert term in par_result.index.idf, f\"Term {term} missing in parallel IDF\"\n        seq_idf = seq_result.index.idf[term]\n        par_idf = par_result.index.idf[term]\n        assert abs(seq_idf - par_idf) < 1e-9, f\"IDF mismatch for {term}: {seq_idf} vs {par_idf}\"\n    print(\"  ✓ IDF values match\")\n    \n    # Check search results\n    queries = [\"machine learning\", \"data analysis\", \"algorithm\"]\n    seq_results = batch_search_sequential(queries, seq_result.index, top_k=5, documents=do"]
[831.679565, "i", "cuments)\n    par_results, _ = batch_search_parallel(queries, par_result.index, top_k=5, num_workers=1, documents=documents)\n    \n    for q_idx, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\n        assert len(seq_res) == len(par_res), f\"Query {q_idx}: result count mismatch\"\n        for i, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f\"Query {q_idx}, result {i}: doc_id mismatch\"\n            assert abs(s.score - p.score) < 1e-6, f\"Query {q_idx}, result {i}: score mismatch\"\n    print(\"  ✓ Search results match\")\n\n\ndef main():\n    print(\"=\" * 70)\n    print(\"Parallel TF-IDF Solution Verification\")\n    print(\"=\" * 70)\n    \n    verify_function_signatures()\n    verify_return_types()\n    verify_correctness()\n    \n    print(\"\\n\" + \"=\" * 70)\n    print(\"✓ All verification checks PASSED!\")\n    print(\"=\" * 70)\n    print(\"\\nSolution Summary:\")\n    print(\"  - build_tfidf_index_parallel: Parallelizes document processing\")\n    print(\"  - batch_search_parallel: Parallelizes query processing\")\n    print(\"  - Results are identical to sequential version\")\n    print(\"  - Achieves speedup on multi-core systems\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[831.679887, "o", "cat > verify_solution.py << 'EOF'\r\n"]
