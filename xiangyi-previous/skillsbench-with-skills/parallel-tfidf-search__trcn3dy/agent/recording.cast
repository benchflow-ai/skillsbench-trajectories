[709.89357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.893621, "o", "\u001b[?2004h> "]
[709.893718, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r"]
[709.893785, "o", "\u001b[?2004h> "]
[709.893844, "o", "    documents: List[Document],\r\n\u001b[?2004l\r"]
[709.893925, "o", "\u001b[?2004h> "]
[709.893995, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.894081, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r"]
[709.894156, "o", "\u001b[?2004h> "]
[709.894209, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[709.894258, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[709.894306, "o", "\u001b[?2004h> "]
[709.894491, "o", "    Build TF-IDF index in parallel using chunked batch processing.\r\n\u001b[?2004l\r"]
[709.894539, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.894588, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.894639, "o", "> "]
[709.894751, "o", "        documents: List of Document objects\r\n\u001b[?2004l\r"]
[709.894802, "o", "\u001b[?2004h> "]
[709.894994, "o", "        num_workers: Number of worker processes (default: CPU count)\r\n\u001b[?2004l\r"]
[709.895066, "o", "\u001b[?2004h> "]
[709.895235, "o", "        chunk_size: Chunk size for batch processing (default: 500)\r\n\u001b[?2004l\r"]
[709.895285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.895338, "o", "    Returns:\r\n\u001b[?2004l\r"]
[709.895377, "o", "\u001b[?2004h> "]
[709.89557, "o", "        ParallelIndexingResult containing TFIDFIndex and timing info\r\n\u001b[?2004l\r"]
[709.895619, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[709.895669, "o", "\u001b[?2004h> "]
[709.895766, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[709.895815, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.895989, "o", "    # Phase 1: Chunk documents and process in parallel\r\n\u001b[?2004l\r"]
[709.896035, "o", "\u001b[?2004h> "]
[709.8963, "o", "    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.896353, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.896424, "o", "    doc_tfs = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.896475, "o", "> "]
[709.896529, "o", "    doc_terms = {}\r\n\u001b[?2004l\r"]
[709.896572, "o", "\u001b[?2004h> "]
[709.89664, "o", "    all_vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.896695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.896891, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.896955, "o", "> "]
[709.897184, "o", "        futures = [executor.submit(_worker_process_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r"]
[709.897216, "o", "\u001b[?2004h> "]
[709.897309, "o", "        for future in futures:\r\n\u001b[?2004l\r"]
[709.897372, "o", "\u001b[?2004h> "]
[709.897516, "o", "            chunk_tfs, chunk_terms = future.result()\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.897576, "o", "> "]
[709.897655, "o", "            doc_tfs.update(chunk_tfs)\r\n\u001b[?2004l\r"]
[709.897748, "o", "\u001b[?2004h> "]
[709.897812, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[709.897878, "o", "\u001b[?2004h> "]
[709.898065, "o", "            all_vocabulary.update(set().union(*chunk_terms.values()))\r\n\u001b[?2004l\r"]
[709.898125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[709.898191, "o", "> "]
[709.898252, "o", "    # Phase 2: Calculate document frequencies\r\n\u001b[?2004l\r"]
[709.898281, "o", "\u001b[?2004h> "]
[709.898381, "o", "    document_frequencies = {}\r\n\u001b[?2004l\r"]
[709.898407, "o", "\u001b[?2004h> "]
[709.89851, "o", "    for term in all_vocabulary:\r\n\u001b[?2004l\r"]
[709.898563, "o", "\u001b[?2004h> "]
[709.898755, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[709.898787, "o", "\u001b[?2004h> "]
[709.8989, "o", "        document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[709.898958, "o", "\u001b[?2004h> \r\n"]
[709.899015, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[709.899181, "o", "    # Phase 3: Compute IDF scores (with smoothing, matching sequential)\r\n\u001b[?2004l\r"]
[709.899237, "o", "\u001b[?2004h> "]
[709.899305, "o", "    num_docs = len(documents)\r\n\u001b[?2004l\r"]
[709.899355, "o", "\u001b[?2004h> "]
[709.899434, "o", "    idf = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.899564, "o", "    for term, df in document_frequencies.items():\r\n\u001b[?2004l\r"]
[709.899638, "o", "\u001b[?2004h> "]
[709.899804, "o", "        # IDF(t) = log(N / DF(t)) + 1 (smoothed, matching sequential)\r\n\u001b[?2004l\r"]
[709.899862, "o", "\u001b[?2004h> "]
[709.899989, "o", "        idf[term] = math.log(num_docs / df) + 1\r\n\u001b[?2004l\r"]
[709.90004, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.900201, "o", "    # Phase 4: Build inverted index and doc vectors\r\n\u001b[?2004l\r"]
[709.900257, "o", "\u001b[?2004h> "]
[709.900348, "o", "    inverted_index = defaultdict(list)\r\n\u001b[?2004l\r"]
[709.900401, "o", "\u001b[?2004h> "]
[709.90045, "o", "    doc_vectors = {}\r\n\u001b[?2004l\r"]
[709.900504, "o", "\u001b[?2004h> "]
[709.900566, "o", "    doc_norms = {}\r\n\u001b[?2004l\r"]
[709.900619, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.900689, "o", "    for term in all_vocabulary:\r\n\u001b[?2004l\r"]
[709.900718, "o", "\u001b[?2004h> "]
[709.900802, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[709.900856, "o", "\u001b[?2004h> "]
[709.900979, "o", "        for doc_id, tf_dict in doc_tfs.items():\r\n\u001b[?2004l\r"]
[709.901062, "o", "\u001b[?2004h> "]
[709.901109, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[709.901162, "o", "\u001b[?2004h> "]
[709.901248, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[709.901305, "o", "\u001b[?2004h> "]
[709.901407, "o", "                tfidf = tf * idf[term]\r\n\u001b[?2004l\r"]
[709.901467, "o", "\u001b[?2004h> "]
[709.901603, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[709.901658, "o", "\u001b[?2004h> "]
[709.90177, "o", "        inverted_index[term] = posting_list\r\n\u001b[?2004l\r"]
[709.901846, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.901943, "o", "    # Compute doc vectors and norms\r\n\u001b[?2004l\r"]
[709.902001, "o", "\u001b[?2004h> "]
[709.902116, "o", "    for doc_id, tf_dict in doc_tfs.items():\r\n\u001b[?2004l\r"]
[709.90215, "o", "\u001b[?2004h> "]
[709.902227, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[709.902282, "o", "\u001b[?2004h> "]
[709.902344, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[709.902398, "o", "\u001b[?2004h> "]
[709.902508, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[709.902545, "o", "\u001b[?2004h> "]
[709.902643, "o", "            tfidf = tf * idf[term]\r\n\u001b[?2004l\r"]
[709.902704, "o", "\u001b[?2004h> "]
[709.902787, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[709.902851, "o", "\u001b[?2004h> "]
[709.902949, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[709.902977, "o", "\u001b[?2004h> "]
[709.90311, "o", "        doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[709.903178, "o", "\u001b[?2004h> "]
[709.903241, "o", "        doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[709.903296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.903354, "o", "    # Create index\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.903412, "o", ">     index = TFIDFIndex(\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.903466, "o", "> "]
[709.903517, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.903571, "o", "        vocabulary=all_vocabulary,\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.903619, "o", "> "]
[709.903676, "o", "        document_frequencies=document_frequencies,\r\n\u001b[?2004l\r"]
[709.903737, "o", "\u001b[?2004h>         idf=idf,\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.903791, "o", "> "]
[709.903848, "o", "        inverted_index=dict(inverted_index),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.903901, "o", "        doc_vectors=doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.903959, "o", "> "]
[709.904013, "o", "        doc_norms=doc_norms,\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.904067, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904125, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[709.904184, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[709.904209, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[709.904284, "o", "\u001b[?2004h> "]
[709.90431, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904373, "o", "        elapsed_time=elapsed_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904431, "o", "        num_documents=num_docs,\r\n\u001b[?2004l\r"]
[709.90449, "o", "\u001b[?2004h> "]
[709.904547, "o", "        vocabulary_size=len(all_vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904602, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.904655, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904704, "o", "def _worker_search_query(\r\n\u001b[?2004l\r"]
[709.904752, "o", "\u001b[?2004h>     query: str,\r\n\u001b[?2004l\r"]
[709.904777, "o", "\u001b[?2004h> "]
[709.904851, "o", "    query_vector: dict,\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.904875, "o", ">     query_norm: float,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.904937, "o", "    inverted_index: dict,\r\n\u001b[?2004l\r"]
[709.904993, "o", "\u001b[?2004h> "]
[709.90505, "o", "    doc_vectors: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905106, "o", "    doc_norms: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905162, "o", "    top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905216, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.905272, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905321, "o", "    Worker function to search a single query.\r\n\u001b[?2004l\r"]
[709.905377, "o", "\u001b[?2004h> "]
[709.905459, "o", "    Returns list of SearchResult objects.\r\n\u001b[?2004l\r"]
[709.905515, "o", "\u001b[?2004h>     \"\"\""]
[709.905575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905604, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905673, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.905696, "o", "\u001b[?2004h> "]
[709.905767, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905822, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.905888, "o", "    for term in query_vector:\r\n\u001b[?2004l\r"]
[709.905917, "o", "\u001b[?2004h> "]
[709.905988, "o", "        if term in inverted_index:\r\n\u001b[?2004l\r"]
[709.906013, "o", "\u001b[?2004h> "]
[709.906067, "o", "            for doc_id, _ in inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.906132, "o", "> "]
[709.906191, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[709.906245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.906299, "o", "    # Compute cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.906353, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.906411, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[709.906469, "o", "\u001b[?2004h> "]
[709.906523, "o", "        doc_vector = doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.906577, "o", "> "]
[709.906635, "o", "        doc_norm = doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.90666, "o", "\u001b[?2004h>         if doc_norm == 0:"]
[709.906727, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.906788, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.906845, "o", "\u001b[?2004h> "]
[709.90694, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r"]
[709.907001, "o", "\u001b[?2004h> "]
[709.907064, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[709.90712, "o", "\u001b[?2004h> "]
[709.907179, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.907234, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.907291, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.907347, "o", "> "]
[709.907372, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[709.907443, "o", "\u001b[?2004h> "]
[709.90754, "o", "    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\r\n\u001b[?2004l\r"]
[709.907601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.907658, "o", "\u001b[?2004h>     return results\r\n\u001b[?2004l\r"]
[709.907704, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.90776, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.907809, "o", "    queries: List[str],\r\n\u001b[?2004l\r"]
[709.907869, "o", "\u001b[?2004h> "]
[709.907932, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.907986, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908054, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908105, "o", "    documents: List[Document] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908174, "o", ") -> tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r"]
[709.908224, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908313, "o", "    Search for multiple queries in parallel using threading.\r\n\u001b[?2004l\r"]
[709.908369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908429, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908486, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.908552, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r"]
[709.908609, "o", "\u001b[?2004h> "]
[709.908659, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r"]
[709.908711, "o", "\u001b[?2004h> "]
[709.908793, "o", "        num_workers: Number of worker threads (default: CPU count)\r\n\u001b[?2004l\r"]
[709.908849, "o", "\u001b[?2004h> "]
[709.908924, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r"]
[709.90898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.909037, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.909148, "o", "        Tuple of (results, elapsed_time) where results is a list of result lists\r\n\u001b[?2004l\r"]
[709.909205, "o", "\u001b[?2004h>     \"\"\""]
[709.909263, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.909318, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[709.909371, "o", "\u001b[?2004h> "]
[709.909436, "o", "    # Pre-compute query vectors for all queries\r\n\u001b[?2004l\r"]
[709.909494, "o", "\u001b[?2004h>     query_vectors = []\r\n\u001b[?2004l\r"]
[709.909551, "o", "\u001b[?2004h>     query_norms = []\r\n\u001b[?2004l\r"]
[709.909608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.909662, "o", "    for query in queries:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.909729, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[709.909786, "o", "\u001b[?2004h> "]
[709.909839, "o", "        if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.909893, "o", "            query_vectors.append({})\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.909943, "o", "> "]
[709.91, "o", "            query_norms.append(0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910066, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910139, "o", "        query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.910202, "o", "> "]
[709.91026, "o", "        query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910313, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[709.910367, "o", "> "]
[709.910422, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910485, "o", "            if term in index.idf:\r\n\u001b[?2004l\r"]
[709.91054, "o", "\u001b[?2004h> "]
[709.910595, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910659, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[709.910716, "o", "\u001b[?2004h> "]
[709.910776, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[709.910848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.910912, "o", "        query_vectors.append(query_vector)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911005, "o", "        query_norms.append(math.sqrt(query_norm_squared))\r\n\u001b[?2004l\r"]
[709.91106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[709.911116, "o", "> "]
[709.91117, "o", "    # Prepare worker arguments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911227, "o", "    worker_args = [\r\n\u001b[?2004l\r\u001b[?2004h>         (\r\n\u001b[?2004l\r"]
[709.91128, "o", "\u001b[?2004h>             queries[i],\r\n\u001b[?2004l\r"]
[709.911353, "o", "\u001b[?2004h> "]
[709.911391, "o", "            query_vectors[i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911412, "o", "            query_norms[i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.911438, "o", "> "]
[709.91158, "o", "            index.inverted_index,\r\n\u001b[?2004l\r\u001b[?2004h>             index.doc_vectors,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911601, "o", "            index.doc_norms,\r\n\u001b[?2004l\r"]
[709.911622, "o", "\u001b[?2004h> "]
[709.91174, "o", "            top_k,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911762, "o", "        for i in range(len(queries))\r\n\u001b[?2004l\r"]
[709.911778, "o", "\u001b[?2004h> "]
[709.911888, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.911995, "o", "    with ThreadPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.912019, "o", "> "]
[709.912142, "o", "        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.912165, "o", "> "]
[709.912252, "o", "        for future in futures:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.912319, "o", "            results.append(future.result())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.912388, "o", "    # Add titles if documents provided\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.912411, "o", "> "]
[709.912429, "o", "    if documents:\r\n\u001b[?2004l\r\u001b[?2004h"]
[709.912451, "o", "> "]
[709.912589, "o", "        doc_titles = {d.doc_id: d.title for d in documents}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.912613, "o", "        for result_list in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.912709, "o", "            for result in result_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[709.912857, "o", "                result.title = doc_titles.get(result.doc_id, f\"Document {result.doc_id}\")\r\n\u001b[?2004l\r"]
[709.912881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[709.912901, "o", "> "]
[709.913012, "o", "    elapsed_time = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[709.913034, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[709.91312, "o", "    return results, elapsed_time\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[709.913142, "o", "\r\n\u001b[?2004l\r"]
[709.914493, "o", "\u001b[?2004hroot@0d985fd47304:~/workspace# "]
