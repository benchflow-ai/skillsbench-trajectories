[45.555401, "o", "\u001b[?2004hroot@32a75f8c5685:~# "]
[69.116675, "i", "python3 << 'EOF'\nimport struct\nimport json\nfrom collections import defaultdict\n\n# Read binary STL file\nwith open('/root/scan_data.stl', 'rb') as f:\n    data = f.read()\n\nnum_triangles = struct.unpack('<I', data[80:84])[0]\n\n# Parse all triangles\ntriangles = []\noffset = 84\nfor i in range(num_triangles):\n    normal = struct.unpack('<3f', data[offset:offset+12])\n    v1 = struct.unpack('<3f', data[offset+12:offset+24])\n    v2 = struct.unpack('<3f', data[offset+24:offset+36])\n    v3 = struct.unpack('<3f', data[offset+36:offset+48])\n    attr = struct.unpack('<H', data[offset+48:offset+50])[0]\n    triangles.append({'vertices': [v1, v2, v3], 'material_id': attr, 'index': i})\n    offset += 50\n\n# Build vertex to triangle mapping\ndef vertex_key(v):\n    return (round(v[0], 5), round(v[1], 5), round(v[2], 5))\n\nvertex_to_triangles = defaultdict(set)\nfor i, t in enumerate(triangles):\n    for v in t['vertices']:\n        vertex_to_triangles[vertex_key(v)].add(i)\n\n# Union-Find for connected components\nparent = list(range(num_triangles))\ndef find(x):\n    if parent[x] != x:\n        parent[x] = find(parent[x])\n    return parent[x]\ndef union(x, y):\n    px, py = find(x), find(y)\n    if px != py:\n        parent[px] = py\n\n# Connect triangles sharing vertices\nfor vertex, tri_set in vertex_to_triangles.items():\n    tri_list = list(tri_set)\n    for i in range(len(tri_list)):\n        for j in range(i+1, len(tri_list)):\n            union(tri_list[i], tri_list[j])\n\n# Group triangles by component\ncomponents = defaultdict(list)\nfor i in range(num_triangles):\n    components[find(i)].append(i)\n\n# Find largest component\nlargest_comp = max(components.items(), key=lambda x: len(x[1]))\nlargest_tri_indices = largest_comp[1]\nprint(f\"Largest component has {len(largest_tri_indices)} triangles\")\n\n# Get material ID of largest component (should be consistent)\nmaterial_ids = set(triangles[i]['material_id'] for i in largest_tri_indices)\nprint(f\"Material IDs in largest component: {material_ids}\")\nmaterial_id = list(material_ids)[0]\n\n# Calculate signed volume using tetrahedron method\n# Volume = sum of (v1 . (v2 x v3)) / 6 for each triangle\ndef signed_volume_of_triangle(v1, v2, v3):\n    # Cross product v2 x v3\n    cross = (\n        v2[1]*v3[2] - v2[2]*v3[1],\n        v2[2]*v3[0] - v2[0]*v3[2],\n        v2[0]*v3[1] - v2[1]*v3[0]\n    )\n    # Dot product v1 . cross\n    dot = v1[0]*cross[0] + v1[1]*cross[1] + v1[2]*cross[2]\n    return dot / 6.0\n\ntotal_volume = 0.0\nfor i in largest_tri_indices:\n    t = triangles[i]\n    v1, v2, v3 = t['vertices']\n    total_volume += signed_volume_of_triangle(v1, v2, v3)\n\n# Volume should be positive (absolute value)\nvolume = abs(total_volume)\nprint(f\"Volume: {volume} cubic units\")\n\n# Density lookup (from material_density_table.md)\ndensity_table = {\n    1: 0.10,   # Generic Debris\n    10: 7.85,  # Standard Steel\n    25: 2.70,  # Aluminum 6061\n    42: 5.55,  # Unobtanium\n    99: 11.34  # Lead\n}\n\ndensity = density_table.get(material_id, None)\nprint(f\"Material ID: {material_id}, Density: {density} g/cm³\")\n\n# Calculate mass\nmass = volume * density\nprint(f\"Mass: {mass} g\")\n\n# Save result\nresult = {\n    \"main_part_mass\": round(mass, 2),\n    \"material_id\": material_id\n}\nprint(f\"Result: {json.dumps(result, indent=2)}\")\n\nwith open('/root/mass_report.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint(\"Saved to /root/mass_report.json\")\nEOF\n"]
