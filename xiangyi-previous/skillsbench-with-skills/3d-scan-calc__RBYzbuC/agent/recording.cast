[69.126298, "o", "    99: 11.34  # Lead\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.126367, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.126441, "o", "\u001b[?2004h> "]
[69.126508, "o", "density = density_table.get(material_id, None)\r\n\u001b[?2004l\r"]
[69.126642, "o", "\u001b[?2004h> "]
[69.126721, "o", "print(f\"Material ID: {material_id}, Density: {density} g/cm³\")\r\n\u001b[?2004l\r"]
[69.126791, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
