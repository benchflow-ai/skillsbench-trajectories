cat <<'EOF' > solve_dicke.py
import numpy as np
from qutip import *
import sys

# Force flush
def log(msg):
    print(msg)
    sys.stdout.flush()

log("Starting simulation script...")

# Parameters
N = 4
w0 = 1.0
wc = 1.0
g = 2.0 / np.sqrt(N)
kappa = 1.0
n_max = 16

# Operators
a = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])

sz_list = []
sp_list = []
sm_list = []

for i in range(N):
    ops = [qeye(2) for _ in range(N)]
    ops[i] = sigmaz()
    sz_list.append(tensor(qeye(n_max), *ops))
    
    ops = [qeye(2) for _ in range(N)]
    ops[i] = sigmap()
    sp_list.append(tensor(qeye(n_max), *ops))
    
    ops = [qeye(2) for _ in range(N)]
    ops[i] = sigmam()
    sm_list.append(tensor(qeye(n_max), *ops))

# Collective operators
Jz = sum([0.5 * sz for sz in sz_list])
Jp = sum(sp_list)
Jm = sum(sm_list)

# Hamiltonian
H = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)

# Common c_ops (Cavity loss)
c_ops_base = [np.sqrt(kappa) * a]

# Wigner grid
xvec = np.linspace(-6, 6, 1000)
pvec = np.linspace(-6, 6, 1000)

def solve_and_save(case_id, specific_c_ops):
    log(f"Solving Case {case_id}...")
    c_ops = c_ops_base + specific_c_ops
    
    # Steady state
    log(f"  Computing steady state for Case {case_id}...")
    rho_ss = steadystate(H, c_ops, method='iterative-lgmres', tol=1e-6)
    
    # Trace out spins (keep cavity, index 0)
    log(f"  Tracing out spins for Case {case_id}...")
    rho_cav = rho_ss.ptrace(0)
    
    # Wigner
    log(f"  Computing Wigner function for Case {case_id}...")
    W = wigner(rho_cav, xvec, pvec)
    
    # Save
    log(f"  Saving Case {case_id}...")
    np.savetxt(f"{case_id}.csv", W, delimiter=",")
    log(f"Saved {case_id}.csv")

# Define rates
gamma_phi = 0.01
gamma_up = 0.1
gamma_down = 0.1
gamma_up_coll = 0.1
gamma_down_coll = 0.1

# Case 1
c_ops_1 = []
for i in range(N):
    c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])
    c_ops_1.append(np.sqrt(gamma_up) * sp_list[i])
solve_and_save(1, c_ops_1)

# Case 2
c_ops_2 = []
for i in range(N):
    c_ops_2.append(np.sqrt(gamma_phi) * sz_list[i])
    c_ops_2.append(np.sqrt(gamma_down) * sm_list[i])
solve_and_save(2, c_ops_2)

# Case 3
c_ops_3 = []
for i in range(N):
    c_ops_3.append(np.sqrt(gamma_phi) * sz_list[i])
    c_ops_3.append(np.sqrt(gamma_down) * sm_list[i])
c_ops_3.append(np.sqrt(gamma_up_coll) * Jp)
solve_and_save(3, c_ops_3)

# Case 4
c_ops_4 = []
for i in range(N):
    c_ops_4.append(np.sqrt(gamma_phi) * sz_list[i])
    c_ops_4.append(np.sqrt(gamma_down) * sm_list[i])
c_ops_4.append(np.sqrt(gamma_down_coll) * Jm)
solve_and_save(4, c_ops_4)

log("All cases completed.")
EOF
