[94.049183, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[94.261952, "o", "\u001b[?2004hroot@b9514785d1d0:~# "]
[213.182935, "i", "cat <<EOF > solve_dicke.py\nimport numpy as np\nfrom qutip import *\nimport time\n\n# Parameters\nN = 4\nw0 = 1.0\nwc = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Operators\n# Hilbert space: Cavity (N=16) x Spin (2) x ... x Spin (2)\na = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])\n\nsz_list = []\nsp_list = []\nsm_list = []\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    sz_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmap()\n    sp_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmam()\n    sm_list.append(tensor(qeye(n_max), *ops))\n\n# Collective operators\nJz = sum([0.5 * sz for sz in sz_list])\nJp = sum(sp_list)\nJm = sum(sm_list)\n\n# Hamiltonian\nH = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\n# Common c_ops (Cavity loss)\nc_ops_base = [np.sqrt(kappa) * a]\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\ndef solve_and_save(case_id, specific_c_ops):\n    print(f\"Solving Case {case_id}...\")\n    c_ops = c_ops_base + specific_c_ops\n    \n    # Steady state\n    rho_ss = steadystate(H, c_ops)\n    \n    # Trace out spins (keep cavity, index 0)\n    rho_cav = rho_ss.ptrace(0)\n    \n    # Wigner\n    W = wigner(rho_cav, xvec, pvec)\n    \n    # Save\n    np.savetxt(f\"{case_id}.csv\", W, delimiter=\",\")\n    print(f\"Saved {case_id}.csv\")\n\n# Define rates\ngamma_phi = 0.01\ngamma_up = 0.1\ngamma_down = 0.1\ngamma_up_coll = 0.1\ngamma_down_coll = 0.1\n\n# Case 1\nc_ops_1 = []\nfor i in range(N):\n    c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_1.append(np.sqrt(gamma_up) * sp_list[i])\nsolve_and_save(1, c_ops_1)\n\n# Case 2\nc_ops_2 = []\nfor i in range(N):\n    c_ops_2.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_2.append(np.sqrt(gamma_down) * sm_list[i])\nsolve_and_save(2, c_ops_2)\n\n# Case 3\nc_ops_3 = []\nfor i in range(N):\n    c_ops_3.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_3.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_3.append(np.sqrt(gamma_up_coll) * Jp)\nsolve_and_save(3, c_ops_3)\n\n# Case 4\nc_ops_4 = []\nfor i in range(N):\n    c_ops_4.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_4.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_4.append(np.sqrt(gamma_down_coll) * Jm)\nsolve_and_save(4, c_ops_4)\nEOF\n"]
[213.189606, "o", "cat <<EOF > solve_dicke.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from qutip import *\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Parameters\r\n\u001b[?2004l\r\u001b[?2004h> N = 4\r\n\u001b[?2004l\r\u001b[?2004h> w0 = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> wc = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> g = 2.0 / np.sqrt(N)\r\n\u001b[?2004l\r\u001b[?2004h> kappa = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> n_max = 16\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Operators\r\n\u001b[?2004l\r\u001b[?2004h> # Hilbert space: Cavity (N=16) x Spin (2) x ... x Spin (2)\r\n\u001b[?2004l\r\u001b[?2004h> a = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sz_list = []\r\n\u001b[?2004l\r\u001b[?2004h> sp_list = []\r\n\u001b[?2004l\r\u001b[?2004h> sm_list = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmaz()\r\n\u001b[?2004l\r\u001b[?2004h>     sz_list.append(tensor(qeye(n_max), *ops))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmap()\r\n\u001b[?2004l\r\u001b[?2004h>     sp_list.append(tensor(qeye(n_max), *ops))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     ops = [qeye(2) for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h>     ops[i] = sigmam()\r\n\u001b[?2004l\r\u001b[?2004h>     sm_list.append(tensor(qeye(n_max), *ops))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Collective operators\r\n\u001b[?2004l\r\u001b[?2004h> Jz = sum([0.5 * sz for sz in sz_list])\r\n\u001b[?2004l\r\u001b[?2004h> Jp = sum(sp_list)\r\n\u001b[?2004l\r\u001b[?2004h> Jm = sum(sm_list)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hamiltonian\r\n\u001b[?2004l\r\u001b[?2004h> H = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Common c_ops (Cavity loss)\r\n\u001b[?2004l\r\u001b[?2004h> c_ops_base = [np.sqrt(kappa) * a]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Wigner grid\r\n\u001b[?2004l\r\u001b[?2004h> xvec = np.linspace(-6, 6, 1000)\r\n\u001b[?2004l\r\u001b[?2004h> pvec = np.linspace(-6, 6, 1000)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def solve_and_save(case_id, specific_c_ops):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Solving Case {case_id}...\")\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops = c_ops_base + specific_c_ops\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Steady state\r\n\u001b[?2004l\r\u001b[?2004h>     rho_ss = steadystate(H, c_ops)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Trace out spins (keep cavity, index 0)\r\n\u001b[?2004l\r\u001b[?2004h>     rho_cav = rho_ss.ptrace(0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Wigner\r\n\u001b[?2004l\r\u001b[?2004h>     W = wigner(rho_cav, xvec, pvec)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save\r\n\u001b[?2004l\r\u001b[?2004h>     np.savetxt(f\"{case_id}.csv\", W, delimiter=\",\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Saved {case_id}.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Define rates\r\n\u001b[?2004l\r\u001b[?2004h> gamma_phi = 0.01\r\n\u001b[?2004l\r\u001b[?2004h> gamma_up = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> gamma_up_coll = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> gamma_down_coll = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Case 1\r\n\u001b[?2004l\r\u001b[?2004h> c_ops_1 = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
