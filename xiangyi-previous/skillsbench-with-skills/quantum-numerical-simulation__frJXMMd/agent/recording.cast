[554.161268, "i", "cat <<EOF > solve_dicke.py\nimport numpy as np\nfrom qutip import *\nimport time\n\n# Parameters\nN = 4\nw0 = 1.0\nwc = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Operators\n# Hilbert space: Cavity (N=16) x Spin (2) x ... x Spin (2)\na = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])\n\nsz_list = []\nsp_list = []\nsm_list = []\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    sz_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmap()\n    sp_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmam()\n    sm_list.append(tensor(qeye(n_max), *ops))\n\n# Collective operators\nJz = sum([0.5 * sz for sz in sz_list])\nJp = sum(sp_list)\nJm = sum(sm_list)\n\n# Hamiltonian\nH = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\n# Common c_ops (Cavity loss)\nc_ops_base = [np.sqrt(kappa) * a]\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\ndef solve_and_save(case_id, specific_c_ops):\n    print(f\"Solving Case {case_id}...\")\n    c_ops = c_ops_base + specific_c_ops\n    \n    # Steady state\n    print(f\"  Computing steady state for Case {case_id}...\")\n    # Using iterative-lgmres for potentially better performance on larger systems\n    rho_ss = steadystate(H, c_ops, method='iterative-lgmres', tol=1e-6)\n    \n    # Trace out spins (keep cavity, index 0)\n    print(f\"  Tracing out spins for Case {case_id}...\")\n    rho_cav = rho_ss.ptrace(0)\n    \n    # Wigner\n    print(f\"  Computing Wigner function for Case {case_id}...\")\n    W = wigner(rho_cav, xvec, pvec)\n    \n    # Save\n    print(f\"  Saving Case {case_id}...\")\n    np.savetxt(f\"{case_id}.csv\", W, delimiter=\",\")\n    print(f\"Saved {case_id}.csv\")\n\n# Define rates\ngamma_phi = 0.01\ngamma_up = 0.1\ngamma_down = 0.1\ngamma_up_coll = 0.1\ngamma_down_coll = 0.1\n\n# Case 1\nc_ops_1 = []\nfor i in range(N):\n    c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_1.append(np.sqrt(gamma_up) * sp_list[i])\nsolve_and_save(1, c_ops_1)\n\n# Case 2\nc_ops_2 = []\nfor i in range(N):\n    c_ops_2.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_2.append(np.sqrt(gamma_down) * sm_list[i])\nsolve_and_save(2, c_ops_2)\n\n# Case 3\nc_ops_3 = []\nfor i in range(N):\n    c_ops_3.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_3.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_3.append(np.sqrt(gamma_up_coll) * Jp)\nsolve_and_save(3, c_ops_3)\n\n# Case 4\nc_ops_4 = []\nfor i in range(N):\n    c_ops_4.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_4.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_4.append(np.sqrt(gamma_down_coll) * Jm)\nsolve_and_save(4, c_ops_4)\nEOF\n"]
[554.163095, "o", "cat <<EOF > solve_dicke.py\r\nimport numpy as np\r\nfrom qutip import *\r\nimport time\r\n\r\n# Parameters\r\nN = 4\r\nw0 = 1.0\r\nwc = 1.0\r\ng = 2.0 / np.sqrt(N)\r\nkappa = 1.0\r\nn_max = 16\r\n\r\n# Operators\r\n# Hilbert space: Cavity (N=16) x Spin (2) x ... x Spin (2)\r\na = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])\r\n\r\nsz_list = []\r\nsp_list = []\r\nsm_list = []\r\n\r\nfor i in range(N):\r\n    ops = [qeye(2) for _ in range(N)]\r\n    ops[i] = sigmaz()\r\n    sz_list.append(tensor(qeye(n_max), *ops))\r\n    \r\n    ops = [qeye(2) for _ in range(N)]\r\n    ops[i] = sigmap()\r\n    sp_list.append(tensor(qeye(n_max), *ops))\r\n    \r\n    ops = [qeye(2) for _ in range(N)]\r\n    ops[i] = sigmam()\r\n    sm_list.append(tensor(qeye(n_max), *ops))\r\n\r\n# Collective operators\r\nJz = sum([0.5 * sz for sz in sz_list])\r\nJp = sum(sp_list)\r\nJm = sum(sm_list)\r\n\r\n# Hamiltonian\r\nH = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\r\n\r\n# Common c_ops (Cavity loss)\r\nc_ops_base = [np.sqrt(kappa) * a]\r\n\r\n# Wigner grid\r\nxvec = np.linspace(-6, 6, 1000)\r\npvec = np.linspace(-6, 6, 1000)\r\n\r\ndef solve_and_save(case_id, specific_c_ops):\r\n    print(f\"Solving Case {case_id}...\")\r\n    c_ops = c_ops_base + specific_c_ops\r\n    \r\n    # Steady state\r\n    print(f\"  Computing steady state for Case {case_id}...\")\r\n    # Using iterative-lgmres for potentially better performance on larger systems\r\n    rho_ss = steadystate(H, c_ops, method='iterative-lgmres', tol=1e-6)\r\n    \r\n    # Trace out spins (keep cavity, index 0)\r\n    print(f\"  Tracing out spins for Case {case_id}...\")\r\n    rho_cav = rho_ss.ptrace(0)\r\n    \r\n    # Wigner\r\n    print(f\"  Computing Wigner function for Case {case_id}...\")\r\n    W = wigner(rho_cav, xvec, pvec)\r\n    \r\n    # Save\r\n    print(f\"  Saving Case {case_id}...\")\r\n    np.savetxt(f\"{case_id}.csv\", W, delimiter=\",\")\r\n    print(f\"Saved {case_id}.csv\")\r\n\r\n# Define rates\r\ngamma_phi = 0.01\r\ngamma_up = 0.1\r\ngamma_down = 0.1\r\ngamma_up_coll = 0.1\r\ngamma_down_coll = 0.1\r\n\r\n# Case 1\r\nc_ops_1 = []\r\nfor i in range(N):\r\n    c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])\r\n    c_ops_1.append(np.sqrt(gamma_up) * sp_list[i])\r\nsolve_and_save(1, c_ops_1)\r\n\r\n# Case 2\r\nc_ops_2 = []\r\nfor i in range(N):\r\n    c_ops_2.append(np.sqrt(gamma_phi) * sz_list[i])\r\n    c_ops_2.append(np.sqrt(gamma_down) * sm_list[i])\r\nsolve_and_save(2, c_ops_2)\r\n\r\n# Case 3\r\nc_ops_3 = []\r\nfor i in range(N):\r\n    c_ops_3.append(np.sqrt(gamma_phi) * sz_list[i])\r\n    c_ops_3.append(np.sqrt(gamma_down) * sm_list[i])\r\nc_ops_3.append(np.sqrt(gamma_up_coll) * Jp)\r\nsolve_and_save(3, c_ops_3)\r\n\r\n# Case 4\r\nc_ops_4 = []\r\nfor i in range(N):\r\n    c_ops_4.append(np.sqrt(gamma_phi) * sz_list[i])\r\n    c_ops_4.append(np.sqrt(gamma_down) * sm_list[i])\r\nc_ops_4.append(np.sqrt(gamma_down_coll) * Jm)\r\nsolve_and_save(4, c_ops_4)\r\nEOF\r\n"]
[555.302339, "i", "python3 solve_dicke.py\n"]
