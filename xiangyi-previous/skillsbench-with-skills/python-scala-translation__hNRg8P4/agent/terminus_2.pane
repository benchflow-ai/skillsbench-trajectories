[?2004l[?2004h> class UniversalTokenizer(
[?2004l[?2004h>   stringTokenizer: Option[StringTokenizer] = None,
[?2004l[?2004h>   numericTokenizer: Option[NumericTokenizer] = None,
[?2004l[?2004h>   temporalTokenizer: Option[TemporalTokenizer] = None,
[?2004l[?2004h>   handleNull: Boolean = true,
[?2004l[?2004h>   nullToken: String = "<NULL>"
[?2004l[?2004h> ) extends BaseTokenizer[Any] {
[?2004l[?2004h> 
[?2004l[?2004h>   private val defaultStringTokenizer = stringTokenizer.getOrElse(new StringTokenizer())
[?2004l[?2004h>   private val defaultNumericTokenizer = numericTokenizer.getOrElse(new NumericTokenizer())
[?2004l[?2004h>   private val defaultTemporalTokenizer = temporalTokenizer.getOrElse(new TemporalTokenizer())
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Any): Token = {
[?2004l[?2004h>     value match {
[?2004l[?2004h>       case null if handleNull =>
[?2004l[?2004h>         Token(nullToken, TokenType.Null, Map("is_null" -> true))
[?2004l[?2004h> 
[?2004l[?2004h>       case null =>
[?2004l[?2004h>         throw new IllegalArgumentException("Null values not supported")
[?2004l[?2004h> 
[?2004l[?2004h>       case None if handleNull =>
[?2004l[?2004h>         Token(nullToken, TokenType.Null, Map("is_null" -> true))
[?2004l[?2004h> 
[?2004l[?2004h>       case Some(v) =>
[?2004l[?2004h>         tokenize(v)
[?2004l[?2004h> 
[?2004l[?2004h>       case s: String =>
[?2004l[?2004h>         defaultStringTokenizer.tokenize(s)
[?2004l[?2004h> 
[?2004l[?2004h>       case _: Int | _: Long | _: Float | _: Double | _: BigDecimal =>
[?2004l[?2004h>         defaultNumericTokenizer.tokenize(value)
[?2004l[?2004h> 
[?2004l[?2004h>       case _: LocalDate | _: LocalDateTime =>
[?2004l[?2004h>         defaultTemporalTokenizer.tokenize(value)
[?2004l[?2004h> 
[?2004l[?2004h>       case seq: Seq[_] =>
[?2004l[?2004h>         val tokens = seq.map(tokenize)
[?2004l[?2004h>         val concatenated = tokens.map(_.value).mkString(",")
[?2004l[?2004h>         Token(s"[$concatenated]", TokenType.Structured, Map("element_count" -> seq.length))
[?2004l[?2004h> 
[?2004l[?2004h>       case map: Map[_, _] =>
[?2004l[?2004h>         val pairs = map.map { case (k, v) =>
[?2004l[?2004h>           s"${tokenize(k).value}:${tokenize(v).value}"
[?2004l[?2004h>         }.mkString(",")
[?2004l[?2004h>         Token(s"{$pairs}", TokenType.Structured, Map("key_count" -> map.size))
[?2004l[?2004h> 
[?2004l[?2004h>       case t: Tokenizable =>
[?2004l[?2004h>         Token(t.toToken, TokenType.String, Map("custom_tokenizable" -> true))
[?2004l[?2004h> 
[?2004l[?2004h>       case _ =>
[?2004l[?2004h>         Token(value.toString, TokenType.String, Map("fallback" -> true))
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
