[?2004l[?2004h> 
[?2004l[?2004h> class TemporalTokenizer(
[?2004l[?2004h>   dateFormat: String = "yyyy-MM-dd",
[?2004l[?2004h>   datetimeFormat: String = "yyyy-MM-dd'T'HH:mm:ss"
[?2004l[?2004h> ) extends BaseTokenizer[Any] {
[?2004l[?2004h> 
[?2004l[?2004h>   private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)
[?2004l[?2004h>   private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Any): Token = {
[?2004l[?2004h>     val (formatted, temporalType) = value match {
[?2004l[?2004h>       case d: LocalDate =>
[?2004l[?2004h>         (d.format(dateFormatter), "date")
[?2004l[?2004h>       case dt: LocalDateTime =>
[?2004l[?2004h>         (dt.format(datetimeFormatter), "datetime")
[?2004l[?2004h>       case _ =>
[?2004l[?2004h>         throw new IllegalArgumentException(s"Unsupported temporal type: ${value.getClass}")
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     val metadata = Map(
[?2004l[?2004h>       "temporal_type" -> temporalType,
[?2004l[?2004h>       "format" -> (if (temporalType == "date") dateFormat else datetimeFormat)
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     Token(formatted, TokenType.Temporal, metadata)
[?2004l[?2004h>   }
[?2004l[?2004h> }
