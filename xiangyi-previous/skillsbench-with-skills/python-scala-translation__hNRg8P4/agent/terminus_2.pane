[?2004l[?2004h>       processed = processed.trim
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (lowercase) {
[?2004l[?2004h>       processed = processed.toLowerCase
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (uppercase) {
[?2004l[?2004h>       processed = processed.toUpperCase
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     maxLength.foreach { max =>
[?2004l[?2004h>       if (processed.length > max) {
[?2004l[?2004h>         processed = processed.take(max)
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     processed = prefix + processed + suffix
[?2004l[?2004h> 
[?2004l[?2004h>     val metadata = Map(
[?2004l[?2004h>       "original_length" -> value.length,
[?2004l[?2004h>       "processed_length" -> processed.length
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     Token(processed, TokenType.String, metadata)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> class NumericTokenizer(
[?2004l[?2004h>   precision: Option[Int] = None,
[?2004l[?2004h>   useScientific: Boolean = false,
[?2004l[?2004h>   prefix: String = "",
[?2004l[?2004h>   suffix: String = ""
