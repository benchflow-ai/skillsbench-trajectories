[?2004l[?2004h> class WhitespaceTokenizer(
[?2004l[?2004h>   lowercase: Boolean = false,
[?2004l[?2004h>   minLength: Int = 0,
[?2004l[?2004h>   maxLength: Option[Int] = None,
[?2004l[?2004h>   stripPunctuation: Boolean = false
[?2004l[?2004h> ) {
[?2004l[?2004h> 
[?2004l[?2004h>   private val punctuation = Set('.', ',', '!', '?', ';', ':', '\'', '"', '(', ')', '[', ']', '{', '}')
[?2004l[?2004h> 
[?2004l[?2004h>   private def processToken(word: String): Option[String] = {
[?2004l[?2004h>     var processed = word
[?2004l[?2004h> 
[?2004l[?2004h>     if (stripPunctuation) {
[?2004l[?2004h>       processed = processed.dropWhile(punctuation.contains).reverse.dropWhile(punctuation.contains).reverse
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (lowercase) {
[?2004l[?2004h>       processed = processed.toLowerCase
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (processed.length < minLength) {
[?2004l[?2004h>       return None
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     maxLength.foreach { max =>
[?2004l[?2004h>       if (processed.length > max) {
[?2004l[?2004h>         processed = processed.take(max)
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (processed.isEmpty) None else Some(processed)
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(text: String): Seq[Token] = {
[?2004l[?2004h>     val words = text.split("\\s+")
[?2004l[?2004h>     words.zipWithIndex.flatMap { case (word, i) =>
[?2004l[?2004h>       processToken(word).map { processed =>
[?2004l[?2004h>         Token(
[?2004l[?2004h>           value = processed,
[?2004l[?2004h>           tokenType = TokenType.String,
[?2004l[?2004h>           metadata = Map("position" -> i, "original" -> word)
[?2004l[?2004h>         )
[?2004l[?2004h>       }
[?2004l[?2004h>     }.toSeq
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizeToStrings(text: String): Seq[String] = {
[?2004l[?2004h>     tokenize(text).map(_.value)
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizeWithPositions(text: String): Seq[(String, Int, Int)] = {
[?2004l[?2004h>     val result = scala.collection.mutable.ListBuffer.empty[(String, Int, Int)]
[?2004l[?2004h>     var currentPos = 0
[?2004l[?2004h> 
[?2004l[?2004h>     text.split("\\s+").foreach { word =>
[?2004l[?2004h>       val start = text.indexOf(word, currentPos)
[?2004l[?2004h>       val end = start + word.length
[?2004l[?2004h> 
[?2004l[?2004h>       processToken(word).foreach { processed =>
[?2004l[?2004h>         result += ((processed, start, end))
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       currentPos = end
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     result.toSeq
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def countTokens(text: String): Int = {
[?2004l[?2004h>     tokenize(text).length
[?2004l[?2004h>   }
[?2004l[?2004h> }
