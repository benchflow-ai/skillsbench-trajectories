[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(value: Any): Token = {
[?2004l[?2004h>     val numValue: BigDecimal = value match {
[?2004l[?2004h>       case i: Int => BigDecimal(i)
[?2004l[?2004h>       case l: Long => BigDecimal(l)
[?2004l[?2004h>       case f: Float => BigDecimal(f.toDouble)
[?2004l[?2004h>       case d: Double => BigDecimal(d)
[?2004l[?2004h>       case bd: BigDecimal => bd
[?2004l[?2004h>       case _ => throw new IllegalArgumentException(s"Unsupported numeric type: ${value.getClass}")
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     val formatted = precision match {
[?2004l[?2004h>       case Some(p) => numValue.setScale(p, BigDecimal.RoundingMode.HALF_UP).toString
[?2004l[?2004h>       case None => numValue.toString
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     val processed = prefix + formatted + suffix
[?2004l[?2004h> 
[?2004l[?2004h>     val metadata = Map(
[?2004l[?2004h>       "original_value" -> value,
[?2004l[?2004h>       "numeric_type" -> value.getClass.getSimpleName
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     Token(processed, TokenType.Numeric, metadata)
[?2004l[?2004h>   }
