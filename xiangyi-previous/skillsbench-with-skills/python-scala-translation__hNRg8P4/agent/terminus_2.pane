[?2004l/**
 * Tokenizer module for converting various input types to standardized string tokens.
 */

import java.time.{LocalDate, LocalDateTime}
import java.time.format.DateTimeFormatter
import scala.util.{Try, Success, Failure}
import scala.collection.immutable.Seq

// ============================================================================
// Enums and Constants
// ============================================================================

sealed trait TokenType {
  def value: String
}

object TokenType {
  case object String extends TokenType { val value = "string" }
  case object Numeric extends TokenType { val value = "numeric" }
  case object Temporal extends TokenType { val value = "temporal" }
  case object Structured extends TokenType { val value = "structured" }
  case object Binary extends TokenType { val value = "binary" }
  case object Null extends TokenType { val value = "null" }
}

// ============================================================================
// Core Token Classes
// ============================================================================

case class Token(
  value: String,
  tokenType: TokenType,
  metadata: Map[String, Any] = Map.empty
) {
  def withMetadata(additionalMetadata: (String, Any)*): Token = {
    copy(metadata = metadata ++ additionalMetadata.toMap)
  }
}

class MutableTokenBatch {
  private var tokens: List[Token] = List.empty
  private var _processed: Boolean = false

  def add(token: Token): Unit = {
    if (_processed) {
      throw new RuntimeException("Batch already processed")
    }
    tokens = tokens :+ token
  }

  def markProcessed(): Unit = {
    _processed = true
  }

  def getTokens: List[Token] = tokens
  def isProcessed: Boolean = _processed
}

trait Tokenizable {
  def toToken: String
}

trait HasLength {
  def length: Int
}

trait TokenProcessor[-T] {
  def process(item: T): Unit
}

class TokenContainer[+T](private val items: Seq[T]) {
  def getAll: Seq[T] = items
  def mapTokens[R](func: T => R): Seq[R] = items.map(func)
}

class TokenSink[-T] {
  private var _received: List[Any] = List.empty

  def receive(item: T): Unit = {
    _received = _received :+ item
  }

  def drain(): List[Any] = {
    val result = _received
    _received = List.empty
    result
  }
}

class BivariantHandler[T](private var _value: T) {
  def get: T = _value
  def set(value: T): Unit = { _value = value }
  def transform(func: T => T): T = {
    _value = func(_value)
    _value
  }
}

// ============================================================================
// Tokenizer Implementations
// ============================================================================

trait BaseTokenizer[T] {
  def tokenize(value: T): Token

  def tokenizeBatch(values: Iterable[T]): Seq[Token] = {
    values.map(tokenize).toSeq
  }
}

class StringTokenizer(
  lowercase: Boolean = false,
  uppercase: Boolean = false,
  stripWhitespace: Boolean = true,
  maxLength: Option[Int] = None,
  prefix: String = "",
  suffix: String = ""
) extends BaseTokenizer[String] {

  def tokenize(value: String): Token = {
    var processed = value

    if (stripWhitespace) {
      processed = processed.trim
    }

    if (lowercase) {
      processed = processed.toLowerCase
    }

    if (uppercase) {
      processed = processed.toUpperCase
    }

    maxLength.foreach { max =>
      if (processed.length > max) {
        processed = processed.take(max)
      }
    }

    processed = prefix + processed + suffix

    val metadata = Map(
      "original_length" -> value.length,
      "processed_length" -> processed.length
    )

    Token(processed, TokenType.String, metadata)
  }
}

[?2004hroot@8c47ed7a6efb:~# sed -n '220,270p' /root/Tokenizer.scala
[?2004l
  private val defaultStringTokenizer = stringTokenizer.getOrElse(new StringTokenizer())
  private val defaultNumericTokenizer = numericTokenizer.getOrElse(new NumericTokenizer())
  private val defaultTemporalTokenizer = temporalTokenizer.getOrElse(new TemporalTokenizer())

  def tokenize(value: Any): Token = {
    value match {
      case null if handleNull =>
        Token(nullToken, TokenType.Null, Map("is_null" -> true))

      case null =>
        throw new IllegalArgumentException("Null values not supported")

      case None if handleNull =>
        Token(nullToken, TokenType.Null, Map("is_null" -> true))

      case Some(v) =>
        tokenize(v)

      case s: String =>
        defaultStringTokenizer.tokenize(s)

      case _: Int | _: Long | _: Float | _: Double | _: BigDecimal =>
        defaultNumericTokenizer.tokenize(value)

      case _: LocalDate | _: LocalDateTime =>
        defaultTemporalTokenizer.tokenize(value)

      case seq: Seq[_] =>
        val tokens = seq.map(tokenize)
        val concatenated = tokens.map(_.value).mkString(",")
        Token(s"[$concatenated]", TokenType.Structured, Map("element_count" -> seq.length))

      case list: List[_] =>
        val tokens = list.map(tokenize)
        val concatenated = tokens.map(_.value).mkString(",")
        Token(s"[$concatenated]", TokenType.Structured, Map("element_count" -> list.length))

      case map: Map[_, _] =>
        val pairs = map.map { case (k, v) =>
          s"${tokenize(k).value}:${tokenize(v).value}"
        }.mkString(",")
        Token(s"{$pairs}", TokenType.Structured, Map("key_count" -> map.size))

      case t: Tokenizable =>
        Token(t.toToken, TokenType.String, Map("custom_tokenizable" -> true))

      case _ =>
        Token(value.toString, TokenType.String, Map("fallback" -> true))
    }
  }
