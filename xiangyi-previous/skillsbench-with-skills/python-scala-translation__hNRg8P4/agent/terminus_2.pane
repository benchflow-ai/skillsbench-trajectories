[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> // Builder Pattern with Fluent Interface
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> class TokenizerBuilder[T] {
[?2004l[?2004h>   private var normalizers: List[String => String] = List.empty
[?2004l[?2004h>   private var validators: List[T => Boolean] = List.empty
[?2004l[?2004h>   private var metadata: Map[String, Any] = Map.empty
[?2004l[?2004h> 
[?2004l[?2004h>   def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {
[?2004l[?2004h>     normalizers = normalizers :+ normalizer
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {
[?2004l[?2004h>     validators = validators :+ validator
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withMetadata(additionalMetadata: (String, Any)*): TokenizerBuilder[T] = {
[?2004l[?2004h>     metadata = metadata ++ additionalMetadata.toMap
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def build(): T => Token = {
[?2004l[?2004h>     val capturedNormalizers = normalizers
[?2004l[?2004h>     val capturedValidators = validators
[?2004l[?2004h>     val capturedMetadata = metadata
[?2004l[?2004h> 
[?2004l[?2004h>     (value: T) => {
[?2004l[?2004h>       // Validate
[?2004l[?2004h>       capturedValidators.foreach { validator =>
[?2004l[?2004h>         if (!validator(value)) {
[?2004l[?2004h>           throw new IllegalArgumentException(s"Validation failed for $value")
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       // Convert to string
[?2004l[?2004h>       var strValue = value.toString
[?2004l[?2004h> 
[?2004l[?2004h>       // Normalize
[?2004l[?2004h>       capturedNormalizers.foreach { normalizer =>
[?2004l[?2004h>         strValue = normalizer(strValue)
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       Token(strValue, TokenType.String, capturedMetadata)
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
