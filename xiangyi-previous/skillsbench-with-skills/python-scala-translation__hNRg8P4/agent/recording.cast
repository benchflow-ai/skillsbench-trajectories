[238.555625, "i", "cat >> /root/Tokenizer.scala << 'EOF'\n\n// ============================================================================\n// Builder Pattern with Fluent Interface\n// ============================================================================\n\nclass TokenizerBuilder[T] {\n  private var normalizers: List[String => String] = List.empty\n  private var validators: List[T => Boolean] = List.empty\n  private var metadata: Map[String, Any] = Map.empty\n\n  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\n    normalizers = normalizers :+ normalizer\n    this\n  }\n\n  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {\n    validators = validators :+ validator\n    this\n  }\n\n  def withMetadata(additionalMetadata: (String, Any)*): TokenizerBuilder[T] = {\n    metadata = metadata ++ additionalMetadata.toMap\n    this\n  }\n\n  def build(): T => Token = {\n    val capturedNormalizers = normalizers\n    val capturedValidators = validators\n    val capturedMetadata = metadata\n\n    (value: T) => {\n      // Validate\n      capturedValidators.foreach { validator =>\n        if (!validator(value)) {\n          throw new IllegalArgumentException(s\"Validation failed for $value\")\n        }\n      }\n\n      // Convert to string\n      var strValue = value.toString\n\n      // Normalize\n      capturedNormalizers.foreach { normalizer =>\n        strValue = normalizer(strValue)\n      }\n\n      Token(strValue, TokenType.String, capturedMetadata)\n    }\n  }\n}\nEOF\n"]
