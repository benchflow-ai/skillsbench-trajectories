[169.645629, "o", "/**\r\n * Tokenizer module for converting various input types to standardized string tokens.\r\n */\r\n\r\nimport java.time.{LocalDate, LocalDateTime}\r\nimport java.time.format.DateTimeFormatter\r\nimport scala.util.{Try, Success, Failure}\r\nimport scala.collection.immutable.Seq\r\n\r\n// ============================================================================\r\n// Enums and Constants\r\n// ============================================================================\r\n\r\nsealed trait TokenType {\r\n  def value: String\r\n}\r\n\r\nobject TokenType {\r\n  case object String extends TokenType { val value = \"string\" }\r\n  case object Numeric extends TokenType { val value = \"numeric\" }\r\n  case object Temporal extends TokenType { val value = \"temporal\" }\r\n  case object Structured extends TokenType { val value = \"structured\" }\r\n  case object Binary extends TokenType { val value = \"binary\" }\r\n  case object Null extends TokenType { val value = \"null\" }\r\n}\r\n\r\n// ============================================================================\r\n// Core Token Classes\r\n// ============================================================================\r\n\r\ncase class Token(\r\n  value: String,\r\n  tokenType: TokenType,\r\n  metadata: Map[String, Any] = Map.empty\r\n) {\r\n  def withMetadata(additionalMetadata: (String, Any)*): Token = {\r\n    copy(metadata = metadata ++ additionalMetadata.toMap)\r\n  }\r\n}\r\n\r\nclass MutableTokenBatch {\r\n  private var tokens: List[Token] = List.empty\r\n  private var _processed: Boolean = false\r\n\r\n  def add(token: Token): Unit = {\r\n    if (_processed) {\r\n      throw new RuntimeException(\"Batch already processed\")\r\n    }\r\n    tokens = tokens :+ token\r\n  }\r\n\r\n  def markProcessed(): Unit = {\r\n    _processed = true\r\n  }\r\n\r\n  def getTokens: List[Token] = tokens\r\n  def isProcessed: Boolean = _processed\r\n}\r\n\r\ntrait Tokenizable {\r\n  def toToken: String\r\n}\r\n\r\ntrait HasLength {\r\n  def length: Int\r\n}\r\n\r\ntrait TokenProcessor[-T] {\r\n  def process(item: T): Unit\r\n}\r\n\r\nclass TokenContainer[+T](private val items: Seq[T]) {\r\n  def getAll: Seq[T] = items\r\n  def mapTokens[R](func: T => R): Seq[R] = items.map(func)\r\n}\r\n\r\nclass TokenSink[-T] {\r\n  private var _received: List[Any] = List.empty\r\n\r\n  def receive(item: T): Unit = {\r\n    _received = _received :+ item\r\n  }\r\n\r\n  def drain(): List[Any] = {\r\n    val result = _received\r\n    _received = List.empty\r\n    result\r\n  }\r\n}\r\n\r\nclass BivariantHandler[T](private var _value: T) {\r\n  def get: T = _value\r\n  def set(value: T): Unit = { _value = value }\r\n  def transform(func: T => T): T = {\r\n    _value = func(_value)\r\n    _value\r\n  }\r\n}\r\n\r\n// ============================================================================\r\n// Tokenizer Implementations\r\n// ============================================================================\r\n\r\ntrait BaseTokenizer[T] {\r\n  def tokenize(value: T): Token\r\n\r\n  def tokenizeBatch(values: Iterable[T]): Seq[Token] = {\r\n    values.map(tokenize).toSeq\r\n  }\r\n}\r\n\r\nclass StringTokenizer(\r\n  lowercase: Boolean = false,\r\n  uppercase: Boolean = false,\r\n  stripWhitespace: Boolean = true,\r\n  maxLength: Option[Int] = None,\r\n  prefix: String = \"\",\r\n  suffix: String = \"\"\r\n) extends BaseTokenizer[String] {\r\n\r\n  def tokenize(value: String): Token = {\r\n    var processed = value\r\n\r\n    if (stripWhitespace) {\r\n      processed = processed.trim\r\n    }\r\n\r\n    if (lowercase) {\r\n      processed = processed.toLowerCase\r\n    }\r\n\r\n    if (uppercase) {\r\n      processed = processed.toUpperCase\r\n    }\r\n"]
[169.645701, "o", "\r\n    maxLength.foreach { max =>\r\n      if (processed.length > max) {\r\n        processed = processed.take(max)\r\n      }\r\n    }\r\n\r\n    processed = prefix + processed + suffix\r\n\r\n    val metadata = Map(\r\n      \"original_length\" -> value.length,\r\n      \"processed_length\" -> processed.length\r\n    )\r\n\r\n    Token(processed, TokenType.String, metadata)\r\n  }\r\n}\r\n\r\n"]
[169.645914, "o", "\u001b[?2004hroot@8c47ed7a6efb:~# "]
[174.663841, "i", "sed -n '220,270p' /root/Tokenizer.scala\n"]
[174.664076, "o", "sed -n '220,270p' /root/Tokenizer.scala\r\n\u001b[?2004l\r"]
[174.665116, "o", "\r\n  private val defaultStringTokenizer = stringTokenizer.getOrElse(new StringTokenizer())\r\n  private val defaultNumericTokenizer = numericTokenizer.getOrElse(new NumericTokenizer())\r\n  private val defaultTemporalTokenizer = temporalTokenizer.getOrElse(new TemporalTokenizer())\r\n\r\n  def tokenize(value: Any): Token = {\r\n    value match {\r\n      case null if handleNull =>\r\n        Token(nullToken, TokenType.Null, Map(\"is_null\" -> true))\r\n\r\n      case null =>\r\n        throw new IllegalArgumentException(\"Null values not supported\")\r\n\r\n      case None if handleNull =>\r\n        Token(nullToken, TokenType.Null, Map(\"is_null\" -> true))\r\n\r\n      case Some(v) =>\r\n        tokenize(v)\r\n\r\n      case s: String =>\r\n        defaultStringTokenizer.tokenize(s)\r\n\r\n      case _: Int | _: Long | _: Float | _: Double | _: BigDecimal =>\r\n        defaultNumericTokenizer.tokenize(value)\r\n\r\n      case _: LocalDate | _: LocalDateTime =>\r\n        defaultTemporalTokenizer.tokenize(value)\r\n\r\n      case seq: Seq[_] =>\r\n        val tokens = seq.map(tokenize)\r\n        val concatenated = tokens.map(_.value).mkString(\",\")\r\n        Token(s\"[$concatenated]\", TokenType.Structured, Map(\"element_count\" -> seq.length))\r\n\r\n      case list: List[_] =>\r\n        val tokens = list.map(tokenize)\r\n        val concatenated = tokens.map(_.value).mkString(\",\")\r\n        Token(s\"[$concatenated]\", TokenType.Structured, Map(\"element_count\" -> list.length))\r\n\r\n      case map: Map[_, _] =>\r\n        val pairs = map.map { case (k, v) =>"]
[174.665157, "o", "\r\n          s\"${tokenize(k).value}:${tokenize(v).value}\"\r\n        }.mkString(\",\")\r\n        Token(s\"{$pairs}\", TokenType.Structured, Map(\"key_count\" -> map.size))\r\n\r\n      case t: Tokenizable =>\r\n        Token(t.toToken, TokenType.String, Map(\"custom_tokenizable\" -> true))\r\n\r\n      case _ =>\r\n        Token(value.toString, TokenType.String, Map(\"fallback\" -> true))\r\n    }\r\n  }\r\n"]
[174.665715, "o", "\u001b[?2004hroot@8c47ed7a6efb:~# "]
[190.254289, "i", "cat > /root/Tokenizer.scala << 'EOF'\n/**\n * Tokenizer module for converting various input types to standardized string tokens.\n */\n\nimport java.time.{LocalDate, LocalDateTime}\nimport java.time.format.DateTimeFormatter\nimport scala.util.{Try, Success, Failure}\nimport scala.collection.immutable.Seq\n\n// ============================================================================\n// Enums and Constants\n// ============================================================================\n\nsealed trait TokenType {\n  def value: String\n}\n\nobject TokenType {\n  case object String extends TokenType { val value = \"string\" }\n  case object Numeric extends TokenType { val value = \"numeric\" }\n  case object Temporal extends TokenType { val value = \"temporal\" }\n  case object Structured extends TokenType { val value = \"structured\" }\n  case object Binary extends TokenType { val value = \"binary\" }\n  case object Null extends TokenType { val value = \"null\" }\n}\n\n// ============================================================================\n// Core Token Classes\n// ============================================================================\n\ncase class Token(\n  value: String,\n  tokenType: TokenType,\n  metadata: Map[String, Any] = Map.empty\n) {\n  def withMetadata(additionalMetadata: (String, Any)*): Token = {\n    copy(metadata = metadata ++ additionalMetadata.toMap)\n  }\n}\n\nclass MutableTokenBatch {\n  private var tokens: List[Token] = List.empty\n  private var _processed: Boolean = false\n\n  def add(token: Token): Unit = {\n    if (_processed) {\n      throw new RuntimeException(\"Batch already processed\")\n    }\n    tokens = tokens :+ token\n  }\n\n  def markProcessed(): Unit = {\n    _processed = true\n  }\n\n  def getTokens: List[Token] = tokens\n  def isProcessed: Boolean = _processed\n}\n\ntrait Tokenizable {\n  def toToken: String\n}\n\ntrait HasLength {\n  def length: Int\n}\n\ntrait TokenProcessor[-T] {\n  def process(item: T): Unit\n}\n\nclass TokenContainer[+T](private val items: Seq[T]) {\n  def getAll: Seq[T] = items\n  def mapTokens[R](func: T => R): Seq[R] = items.map(func)\n}\n\nclass TokenSink[-T] {\n  private var _received: List[Any] = List.empty\n\n  def receive(item: T): Unit = {\n    _received = _received :+ item\n  }\n\n  def drain(): List[Any] = {\n    val result = _received\n    _received = List.empty\n    result\n  }\n}\n\nclass BivariantHandler[T](private var _value: T) {\n  def get: T = _value\n  def set(value: T): Unit = { _value = value }\n  def transform(func: T => T): T = {\n    _value = func(_value)\n    _value\n  }\n}\nEOF\n"]
