[205.237163, "o", "  private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237254, "o", "  private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[205.237317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.237382, "o", "  def tokenize(value: Any): Token = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237448, "o", "    val (formatted, temporalType) = value match {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237513, "o", "      case d: LocalDate =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237582, "o", "        (d.format(dateFormatter), \"date\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237661, "o", "      case dt: LocalDateTime =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237732, "o", "        (dt.format(datetimeFormatter), \"datetime\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237797, "o", "      case _ =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.237933, "o", "        throw new IllegalArgumentException(s\"Unsupported temporal type: ${value.getClass}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238003, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238071, "o", "    val metadata = Map(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238135, "o", "      \"temporal_type\" -> temporalType,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238232, "o", "      \"format\" -> (if (temporalType == \"date\") dateFormat else datetimeFormat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238301, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238376, "o", "    Token(formatted, TokenType.Temporal, metadata)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.238441, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
