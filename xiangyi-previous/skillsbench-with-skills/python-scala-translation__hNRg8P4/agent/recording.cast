[90.136081, "o", "      \"temporal_type\" -> temporalType,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.136215, "o", "      \"format\" -> (if (temporalType == \"date\") dateFormat else datetimeFormat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.136244, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.136272, "o", "\u001b[?2004h> "]
