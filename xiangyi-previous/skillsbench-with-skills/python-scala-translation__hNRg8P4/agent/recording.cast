[190.259654, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.25976, "o", "class BivariantHandler[T](private var _value: T) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.25979, "o", "  def get: T = _value\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.259818, "o", "> "]
[190.259903, "o", "  def set(value: T): Unit = { _value = value }\r\n\u001b[?2004l\r\u001b[?2004h> "]
