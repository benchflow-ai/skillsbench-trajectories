[90.134566, "o", "  private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)\r\n\u001b[?2004l\r"]
[90.134596, "o", "\u001b[?2004h> "]
[90.134753, "o", "  private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)\r\n\u001b[?2004l\r"]
[90.134799, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.134853, "o", "\u001b[?2004h> "]
[90.134892, "o", "  def tokenize(value: Any): Token = {\r\n\u001b[?2004l\r"]
[90.134919, "o", "\u001b[?2004h> "]
[90.13504, "o", "    val (formatted, temporalType) = value match {\r\n\u001b[?2004l\r"]
[90.135067, "o", "\u001b[?2004h> "]
[90.135133, "o", "      case d: LocalDate =>\r\n\u001b[?2004l\r"]
[90.135184, "o", "\u001b[?2004h> "]
[90.135262, "o", "        (d.format(dateFormatter), \"date\")\r\n\u001b[?2004l\r"]
[90.135288, "o", "\u001b[?2004h> "]
[90.135372, "o", "      case dt: LocalDateTime =>\r\n\u001b[?2004l\r"]
[90.135398, "o", "\u001b[?2004h> "]
[90.135542, "o", "        (dt.format(datetimeFormatter), \"datetime\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.135571, "o", "> "]
[90.135598, "o", "      case _ =>\r\n\u001b[?2004l\r"]
[90.135624, "o", "\u001b[?2004h> "]
[90.135871, "o", "        throw new IllegalArgumentException(s\"Unsupported temporal type: ${value.getClass}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.135927, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.13596, "o", "\u001b[?2004h> "]
