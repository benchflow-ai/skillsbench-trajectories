[190.260066, "o", "    _value = func(_value)\r\n\u001b[?2004l\r\u001b[?2004h>     _value\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[190.260095, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
