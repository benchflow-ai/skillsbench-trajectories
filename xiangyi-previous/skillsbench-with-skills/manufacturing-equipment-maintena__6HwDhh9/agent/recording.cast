[200.416567, "o", "STD LENGTH CM/MIN\r\nOPT LENGTH CM/MIN\r\nHEATER TECHNOLOGY\r\nFORCED CONVECTION\r\nIR/CONVECTION\r\nPROCESS GAS\r\nAI R\r\nHIGH PURITY N,\r\n\r\nVOLTAGES\r\n200V, 3PHASE, 50 HZ\r\n208V, 3PHASE, 60 HZ\r\n380V, 3PHASE, 50 HZ\r\n415V, 3PHASE, 50 HZ\r\n480V, 3PHASE, 60 HZ\r\n(AVAILABLE ON ALL MODELS)\r\n\r\n20\r\n\r\n"]
