[157.277726, "o", "HIGH PURITY N,\r\n\r\nVOLTAGES\r\n200V, 3PHASE, 50 HZ\r\n208V, 3PHASE, 60 HZ\r\n380V, 3PHASE, 50 HZ\r\n415V, 3PHASE, 50 HZ\r\n480V, 3PHASE, 60 HZ\r\n(AVAILABLE ON ALL MODELS)\r\n\r\n20\r\n\r\nX\r\n\r\n1143\r\n\r\n* Add 36 inches (914 mm) to overall machine\r\n\r\nlength for Dual Conveyor Extension Option.\r\n\r\n\f\fI\r\n1\r\n\r\n1\r\n\r\n"]
