[316.273393, "o", "\fPRODUCT MATRIX\r\n\r\nI\r\n\r\n4440\r\n\r\n4470MP 4470XP\r\n\r\n4470HP 4470XN\r\n\r\n4470HN 4480XG\r\n\r\n36\r\nN/A\r\n\r\n36\r\nN/A\r\n\r\n96\r\n120\r\n\r\n114\r\n138\r\n\r\n96\r\nN/A\r\n\r\n148\r\nNIA\r\n\r\n96\r\nN/A\r\n\r\n914\r\n\r\n914\r\n\r\n2438\r\n3048\r\n\r\n2895\r\n3505\r\n\r\n2438\r\n\r\n3759\r\n\r\n2438\r\n\r\n9-1 2\r\n\r\n"]
