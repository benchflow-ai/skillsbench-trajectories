[293.127628, "o", "24-32\r\n\r\n20-30 20-30\r\n\r\n60-80\r\n76-1 02\r\n\r\n70-100\r\n90-1 20\r\n\r\n60-80\r\n\r\n90-130\r\n\r\n60-80\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\nX\r\n\r\nCONVEYOR TYPE\r\nEDGE\r\nMESH\r\nDUAL (EDGE/MESH)\r\n\r\nN/A\r\nSTD\r\nN/A\r\n\r\nSTD\r\nN/A\r\nN/A\r\n\r\nSTD\r\nOPT\r\n"]
[293.12773, "o", "OPT\r\n\r\nSTD\r\nN/A\r\nN/A\r\n\r\nSTD\r\nOPT\r\nOPT\r\n\r\nSTD\r\nN/A\r\nN/A\r\n\r\nSTD\r\nOPT\r\nOPT\r\n\r\nCONTROLLER\r\nMICROPROCESSOR\r\nHOST INTERFACE\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nX\r\nX\r\n\r\nDIMENSIONS\r\nLENGTH IN\r\nWIDTH IN\r\n\r\n90\r\n50\r\n\r\n90\r\n47\r\n\r\n168\r\n45\r\n\r\n222\r\n45\r\n\r\n168\r\n45\r\n\r\nLENGTH MM\r\nWIDTH MM\r\n\r\n2286\r\n1258\r\n\r\n2286\r\n1194\r\n\r\n4274\r\n1143\r\n\r\n5639\r\n1143\r\n\r\n4274\r\n1143\r\n\r\nFEATURE\r\nPROCESS AREA\r\n"]
[293.127757, "o", "STDLENGTH IN\r\nOPTLENGTH IN\r\nSTDLENGTH MM\r\nOPTLENGTH MM\r\nPROCESS SPEED\r\nSTD LENGTH IN/MIN\r\nOPT LENGTH IN/MIN\r\nSTD LENGTH CM/MIN\r\nOPT LENGTH CM/MIN\r\nHEATER TECHNOLOGY\r\nFORCED CONVECTION\r\nIR/CONVECTION\r\nPROCESS GAS\r\nAI R\r\nHIGH PURITY N,\r\n\r\nVOLTAGES\r\n200V, 3PHASE, 50 HZ\r\n208V, 3PHASE, 60 HZ\r\n380V, 3PHASE, 50 HZ\r\n415V, 3PHASE, 50 HZ\r\n480V, 3PHASE, 60 HZ\r\n(AVAILABLE ON ALL MODELS)\r\n\r\n20\r\n\r\nX\r\n\r\n1143\r\n\r\n* Add 36 inches (914 mm) to overall machine\r\n\r\nlength for Dual Conveyor Extension Option.\r\n\r\n\f\fI\r\n1\r\n\r\n1\r\n\r\n!\r\n\r\n1\r\n1"]
