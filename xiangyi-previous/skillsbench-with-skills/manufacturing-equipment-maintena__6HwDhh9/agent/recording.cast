[222.919565, "o", "222\r\n45\r\n\r\n168\r\n45\r\n\r\nLENGTH MM\r\nWIDTH MM\r\n\r\n2286\r\n1258\r\n\r\n2286\r\n1194\r\n\r\n4274\r\n1143\r\n\r\n5639"]
[222.919613, "o", "\r\n1143\r\n\r\n4274\r\n1143\r\n\r\nFEATURE\r\nPROCESS AREA\r\nSTDLENGTH IN\r\nOPTLENGTH IN\r\nSTDLENGTH MM\r\nOPTLENGTH MM\r\nPROCESS SPEED\r\nSTD LENGTH IN/MIN\r\nOPT LENGTH IN/MIN\r\nSTD LENGTH CM/MIN\r\nOPT LENGTH CM/MIN"]
[222.919667, "o", "\r\nHEATER TECHNOLOGY\r\nFORCED CONVECTION\r\nIR/CONVECTION\r\nPROCESS GAS\r\nAI R\r\nHIGH PURITY N,\r\n\r\nVOLTAGES\r\n200V, 3PHASE, 50 HZ\r\n208V, 3PHASE, 60 HZ\r\n380V, 3PHASE, 50 HZ\r\n415V, 3PHASE, 50 HZ\r\n480V, 3PHASE, 60 HZ\r\n(AVAILABLE ON ALL MODELS)\r\n\r\n"]
[222.919716, "o", "20\r\n\r\nX\r\n\r\n1143\r\n\r\n* Add 36 inches (914 mm) to overall machine\r\n\r\nlength for Dual Conveyor Extension Option.\r\n\r\n\f\fI\r\n1\r\n\r\n1\r\n\r\n!\r\n\r\n1\r\n1"]
