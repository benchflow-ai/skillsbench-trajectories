[523.18095, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport json\nimport numpy as np\n\nmes_log = pd.read_csv('/app/data/mes_log.csv')\ntest_defects = pd.read_csv('/app/data/test_defects.csv')\ntc_data = pd.read_csv('/app/data/thermocouples.csv')\n\n# Q1\nramp_limit = 2.0\nmax_ramp_by_run = {}\nviolating_runs = []\nfor run_id in mes_log['run_id'].unique():\n    run_tc = tc_data[(tc_data['run_id'] == run_id) & (tc_data['tc_id'] == 'TC1')].sort_values('time_s')\n    if run_tc.empty: continue\n    preheat_data = run_tc[(run_tc['temp_c'] >= 100) & (run_tc['temp_c'] <= 150)]\n    if len(preheat_data) < 2: max_ramp = 0.0\n    else:\n        ramps = (preheat_data['temp_c'].values[1:] - preheat_data['temp_c'].values[:-1]) / (preheat_data['time_s'].values[1:] - preheat_data['time_s'].values[:-1])\n        max_ramp = np.max(ramps) if len(ramps) > 0 else 0.0\n    max_ramp_by_run[run_id] = {\"tc_id\": \"TC1\", \"max_preheat_ramp_c_per_s\": round(float(max_ramp), 2)}\n    if max_ramp > ramp_limit: violating_runs.append(run_id)\nq01 = {\"ramp_rate_limit_c_per_s\": ramp_limit, \"violating_runs\": sorted(violating_runs), \"max_ramp_by_run\": dict(sorted(max_ramp_by_run.items()))}\nwith open('/app/output/q01.json', 'w') as f: json.dump(q01, f, indent=2)\n\n# Q2\ntal_results = []\nfor _, row in mes_log.iterrows():\n    run_tc = tc_data[(tc_data['run_id'] == row['run_id']) & (tc_data['tc_id'] == 'TC1')].sort_values('time_s')\n    tal_s = 0.0\n    if not run_tc.empty:\n        above = run_tc[run_tc['temp_c'] > row['solder_liquidus_c']]\n        if not above.empty: tal_s = above['time_s'].max() - above['time_s'].min()\n    tal_results.append({\"run_id\": row['run_id'], \"tc_id\": \"TC1\", \"tal_s\": round(float(tal_s), 2), \"required_min_tal_s\": 30.0, \"required_max_tal_s\": 60.0, \"status\": \"compliant\" if 30 <= tal_s <= 60 else \"non-compliant\"})\nwith open('/app/output/q02.json', 'w') as f: json.dump(sorted(tal_results, key=lambda x: x['run_id']), f, indent=2)\n\n# Q3\nfailing_runs, min_peak_by_run = [], {}\nfor _, row in mes_log.iterrows():\n    run_tc = tc_data[tc_data['run_id'] == row['run_id']]\n    if run_tc.empty: failing_runs.append(row['run_id']); continue\n    peak_temp = run_tc['temp_c'].max()\n    tc_id_at_peak = run_tc.loc[run_tc['temp_c'].idxmax(), 'tc_id']\n    min_peak_by_run[row['run_id']] = {\"tc_id\": tc_id_at_peak, \"peak_temp_c\": round(float(peak_temp), 2), \"required_min_peak_c\": float(row['solder_liquidus_c'] + 20)}\n    if peak_temp < row['solder_liquidus_c'] + 20: failing_runs.append(row['run_id'])\nq03 = {\"failing_runs\": sorted(failing_runs), \"min_peak_by_run\": dict(sorted(min_peak_by_run.items()))}\nwith open('/app/output/q03.json', 'w') as f: json.dump(q03, f, indent=2)\n\n# Q4\nspeed_results = []\nfor _, row in mes_log.iterrows():\n    min_line_speed = (row['boards_per_min'] * row['board_length_cm']) / row['loading_factor']\n    meets = (row['conveyor_speed_cm_min'] >= min_line_speed - 0.01) and (60 <= row['conveyor_speed_cm_min'] <= 80)\n    speed_results.append({\"run_id\": row['run_id'], \"required_min_speed_cm_min\": round(float(min_line_speed), 2), \"actual_speed_cm_min\": round(float(row['conveyor_speed_cm_min']), 2), \"meets\": bool(meets)})\nwith open('/app/output/q04.json', 'w') as f: json.dump(sorted(speed_results, key=lambda x: x['run_id']), f, indent=2)\n\n# Q5\nfamily_runs = {}\nfor _, row in mes_log.iterrows():\n    yield_val = test_defects[(test_defects['run_id'] == row['run_id']) & (test_defects['defect_type'] == 'yield_summary')]['fp_yield_pct'].iloc[0]\n    if row['board_family'] not in family_runs: family_runs[row['board_family']] = []\n    family_runs[row['board_family']].append({\"run_id\": row['run_id'], \"yield\": yield_val, \"efficiency\": row['boards_per_min']})\nq05 = []\nfor family, runs in family_runs.items():\n    sorted_runs = sorted(runs, key=lambda x: (-x['yield'], -x['efficiency']))\n    q05.append({\"board_family\": family, \"best_run_id\": sorted_runs[0]['run_id'], \"runner_up_run_ids\": sorted([r['run_id'] for r in sorted_runs[1:]])})\nwith open('/app/output/q05.json', 'w') as f: json.dump(sorted(q05, key=lambda x: x['board_family']), f, indent=2)\nEOF\npython3 solution.py\n"]
[523.181247, "o", "cat << 'EOF' > solution.py\r\n\u001b[?2004l\r"]
[523.181366, "o", "\u001b[?2004h"]
[523.181399, "o", "> "]
[523.185389, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> mes_log = pd.read_csv('/app/data/mes_log.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_defects = pd.read_csv('/app/data/test_defects.csv')\r\n\u001b[?2004l\r\u001b[?2004h> tc_data = pd.read_csv('/app/data/thermocouples.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Q1\r\n\u001b[?2004l\r\u001b[?2004h> ramp_limit = 2.0\r\n\u001b[?2004l\r\u001b[?2004h> max_ramp_by_run = {}\r\n\u001b[?2004l\r\u001b[?2004h> violating_runs = []\r\n\u001b[?2004l\r\u001b[?2004h> for run_id in mes_log['run_id'].unique():\r\n\u001b[?2004l\r\u001b[?2004h>     run_tc = tc_data[(tc_data['run_id'] == run_id) & (tc_data['tc_id'] == 'TC1')].sort_values('time_s')\r\n\u001b[?2004l\r\u001b[?2004h>     if run_tc.empty: continue\r\n\u001b[?2004l\r\u001b[?2004h>     preheat_data = run_tc[(run_tc['temp_c'] >= 100) & (run_tc['temp_c'] <= 150)]\r\n\u001b[?2004l\r\u001b[?2004h>     if len(preheat_data) < 2: max_ramp = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.1895, "o", "        ramps = (preheat_data['temp_c'].values[1:] - preheat_data['temp_c'].values[:-1]) / (preheat_data['time_s'].values[1:] - preheat_data['time_s'].values[:-1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.189717, "o", "        max_ramp = np.max(ramps) if len(ramps) > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.189914, "o", "    max_ramp_by_run[run_id] = {\"tc_id\": \"TC1\", \"max_preheat_ramp_c_per_s\": round(float(max_ramp), 2)}\r\n\u001b[?2004l\r"]
[523.189959, "o", "\u001b[?2004h> "]
[523.19014, "o", "    if max_ramp > ramp_limit: violating_runs.append(run_id)\r\n\u001b[?2004l\r"]
[523.190244, "o", "\u001b[?2004h> "]
[523.190553, "o", "q01 = {\"ramp_rate_limit_c_per_s\": ramp_limit, \"violating_runs\": sorted(violating_runs), \"max_ramp_by_run\": dict(sorted(max_ramp_by_run.items()))}\r\n\u001b[?2004l\r"]
[523.190582, "o", "\u001b[?2004h> "]
[523.190783, "o", "with open('/app/output/q01.json', 'w') as f: json.dump(q01, f, indent=2)\r\n\u001b[?2004l\r"]
[523.190821, "o", "\u001b[?2004h"]
[523.190857, "o", "> \r\n\u001b[?2004l\r"]
[523.190886, "o", "\u001b[?2004h> "]
[523.19092, "o", "# Q2\r\n"]
[523.190952, "o", "\u001b[?2004l\r\u001b[?2004h"]
[523.19098, "o", "> "]
[523.191037, "o", "tal_results = []\r\n\u001b[?2004l\r"]
[523.191066, "o", "\u001b[?2004h"]
[523.19109, "o", "> "]
[523.19119, "o", "for _, row in mes_log.iterrows():\r\n\u001b[?2004l\r"]
[523.19122, "o", "\u001b[?2004h"]
[523.191247, "o", "> "]
[523.191526, "o", "    run_tc = tc_data[(tc_data['run_id'] == row['run_id']) & (tc_data['tc_id'] == 'TC1')].sort_values('time_s')\r\n\u001b[?2004l\r"]
[523.191569, "o", "\u001b[?2004h"]
[523.191593, "o", "> "]
[523.191646, "o", "    tal_s = 0.0\r\n\u001b[?2004l\r"]
[523.191689, "o", "\u001b[?2004h> "]
[523.191774, "o", "    if not run_tc.empty:\r\n\u001b[?2004l\r"]
[523.191804, "o", "\u001b[?2004h"]
[523.19183, "o", "> "]
[523.192011, "o", "        above = run_tc[run_tc['temp_c'] > row['solder_liquidus_c']]\r\n\u001b[?2004l\r"]
[523.192055, "o", "\u001b[?2004h"]
[523.19208, "o", "> "]
[523.192284, "o", "        if not above.empty: tal_s = above['time_s'].max() - above['time_s'].min()\r\n\u001b[?2004l\r"]
[523.192324, "o", "\u001b[?2004h"]
[523.192351, "o", "> "]
[523.192887, "o", "    tal_results.append({\"run_id\": row['run_id'], \"tc_id\": \"TC1\", \"tal_s\": round(float(tal_s), 2), \"required_min_tal_s\": 30.0, \"required_max_tal_s\": 60.0, \"status\": \"compliant\" if 30 <= tal_s <= 60 else \"non-compliant\"})\r\n\u001b[?2004l\r"]
[523.19293, "o", "\u001b[?2004h"]
[523.192953, "o", "> "]
[523.193251, "o", "with open('/app/output/q02.json', 'w') as f: json.dump(sorted(tal_results, key=lambda x: x['run_id']), f, indent=2)\r\n"]
[523.193275, "o", "\u001b[?2004l\r"]
[523.193325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[523.193403, "o", "\u001b[?2004h> "]
[523.194444, "o", "# Q3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.194511, "o", "failing_runs, min_peak_by_run = [], {}\r\n\u001b[?2004l\r\u001b[?2004h> for _, row in mes_log.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h>     run_tc = tc_data[tc_data['run_id'] == row['run_id']]\r\n\u001b[?2004l\r\u001b[?2004h>     if run_tc.empty: failing_runs.append(row['run_id']); continue\r\n\u001b[?2004l\r\u001b[?2004h>     peak_temp = run_tc['temp_c'].max()\r\n\u001b[?2004l\r\u001b[?2004h>     tc_id_at_peak = run_tc.loc[run_tc['temp_c'].idxmax(), 'tc_id']\r\n\u001b[?2004l\r\u001b[?2004h>     min_peak_by_run[row['run_id']] = {\"tc_id\": tc_id_at_peak, \"peak_temp_c\": round(float(peak_temp), 2), \"required_min_peak_c\": float(row['solder_liquidus_c'] + 20)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[523.194537, "o", "> "]
[523.194687, "o", "    if peak_temp < row['solder_liquidus_c'] + 20: failing_runs.append(row['run_id'])\r\n\u001b[?2004l\r"]
[523.194716, "o", "\u001b[?2004h> "]
[523.194934, "o", "q03 = {\"failing_runs\": sorted(failing_runs), \"min_peak_by_run\": dict(sorted(min_peak_by_run.items()))}\r\n\u001b[?2004l\r"]
[523.194964, "o", "\u001b[?2004h> "]
[523.195125, "o", "with open('/app/output/q03.json', 'w') as f: json.dump(q03, f, indent=2)\r\n\u001b[?2004l\r"]
[523.195161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[523.195187, "o", "\u001b[?2004h"]
[523.195215, "o", "> # Q4\r\n"]
[523.195244, "o", "\u001b[?2004l\r\u001b[?2004h"]
[523.195268, "o", "> "]
[523.195318, "o", "speed_results = []\r\n\u001b[?2004l\r"]
[523.195343, "o", "\u001b[?2004h"]
[523.195366, "o", "> "]
[523.195451, "o", "for _, row in mes_log.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.195625, "o", "    min_line_speed = (row['boards_per_min'] * row['board_length_cm']) / row['loading_factor']\r\n\u001b[?2004l\r"]
[523.195652, "o", "\u001b[?2004h> "]
[523.196215, "o", "    meets = (row['conveyor_speed_cm_min'] >= min_line_speed - 0.01) and (60 <= row['conveyor_speed_cm_min'] <= 80)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.196354, "o", "    speed_results.append({\"run_id\": row['run_id'], \"required_min_speed_cm_min\": round(float(min_line_speed), 2), \"actual_speed_cm_min\": round(float(row['conveyor_speed_cm_min']), 2), \"meets\": bool(meets)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.196563, "o", "with open('/app/output/q04.json', 'w') as f: json.dump(sorted(speed_results, key=lambda x: x['run_id']), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[523.196588, "o", "\u001b[?2004h> # Q5\r\n\u001b[?2004l\r"]
[523.196614, "o", "\u001b[?2004h> "]
[523.196702, "o", "family_runs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.19675, "o", "for _, row in mes_log.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.197048, "o", "    yield_val = test_defects[(test_defects['run_id'] == row['run_id']) & (test_defects['defect_type'] == 'yield_summary')]['fp_yield_pct'].iloc[0]\r\n\u001b[?2004l\r"]
[523.197073, "o", "\u001b[?2004h> "]
[523.197234, "o", "    if row['board_family'] not in family_runs: family_runs[row['board_family']] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[523.197258, "o", "> "]
[523.197507, "o", "    family_runs[row['board_family']].append({\"run_id\": row['run_id'], \"yield\": yield_val, \"efficiency\": row['boards_per_min']})\r\n\u001b[?2004l\r"]
[523.197533, "o", "\u001b[?2004h> "]
[523.197607, "o", "q05 = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[523.197637, "o", "> "]
[523.197714, "o", "for family, runs in family_runs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.197902, "o", "    sorted_runs = sorted(runs, key=lambda x: (-x['yield'], -x['efficiency']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.198516, "o", "    q05.append({\"board_family\": family, \"best_run_id\": sorted_runs[0]['run_id'], \"runner_up_run_ids\": sorted([r['run_id'] for r in sorted_runs[1:]])})\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/output/q05.json', 'w') as f: json.dump(sorted(q05, key=lambda x: x['board_family']), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[523.198626, "o", "EOF\r\n\u001b[?2004l\r"]
[523.210595, "o", "\u001b[?2004hroot@69bb9c2c52b2:/app# python3 solution.py\r\n\u001b[?2004l\r"]
