[250.151187, "o", "\r\n70-100\r\n90-1 20\r\n\r\n60-80\r\n\r\n90-130\r\n\r\n60-80\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\nX\r\n"]
