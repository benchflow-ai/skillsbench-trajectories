[266.663298, "o", "\r\nFEATURE\r\nPROCESS AREA\r\nSTDLENGTH IN\r\nOPTLENGTH IN\r\nSTDLENGTH MM\r\nOPTLENGTH MM\r\nPROCESS SPEED\r\nSTD LENGTH IN/MIN\r\nOPT LENGTH IN/MIN\r\nSTD LENGTH CM/MIN\r\nOPT LENGTH CM/MIN\r\nHEATER TECHNOLOGY\r\nFORCED CONVECTION\r\nIR/CONVECTION\r\nPROCESS GAS\r\nAI R\r\nHIGH PURITY N,\r\n\r\nVOLTAGES\r\n200V, 3PHASE, 50 HZ\r\n208V, 3PHASE, 60 HZ\r\n380V, 3PHASE, 50 HZ\r\n415V, 3PHASE, 50 HZ\r\n480V, 3PHASE, 60 HZ\r\n"]
