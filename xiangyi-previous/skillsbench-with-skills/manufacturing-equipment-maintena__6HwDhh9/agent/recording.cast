[309.91955, "o", "\r\n--\r\n\r\nPOWER COST\r\n\r\n$4,160\r\n\r\n$2,496\r\n"]
[309.919684, "o", "\r\nThe importance of factoring in operating costs\r\nshould be noted.\r\n\r\nMAINTENANCE\r\n--\r\nN/A\r\n\r\n36\r\nN/A\r\n\r\n96\r\n120\r\n\r\n114\r\n138\r\n\r\n96\r\nN/A\r\n\r\n148\r\nNIA\r\n\r\n96\r\nN/A\r\n\r\n914\r\n\r\n914\r\n"]
