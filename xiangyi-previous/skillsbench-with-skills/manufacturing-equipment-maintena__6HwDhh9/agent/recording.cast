[244.57253, "o", "60-80\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\n\r\nX\r\nX\r\n\r\nCONVEYOR TYPE\r\nEDGE\r\nMESH\r\nDUAL (EDGE/MESH)\r\n\r\nN/A\r\nSTD\r\nN/A\r\n\r\nSTD\r\nN/A\r\nN/A\r\n\r\nSTD\r\nOPT\r\nOPT\r\n\r\nSTD\r\nN/A\r\n"]
