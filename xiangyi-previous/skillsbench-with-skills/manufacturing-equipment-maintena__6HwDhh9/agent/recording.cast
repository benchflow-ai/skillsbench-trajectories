[261.06048, "o", "\r\n90\r\n50\r\n\r\n90\r\n47\r\n\r\n168\r\n45\r\n\r\n222\r\n45\r\n\r\n168\r\n45\r\n\r\nLENGTH MM\r\nWIDTH MM\r\n\r\n2286\r\n1258\r\n\r\n2286\r\n1194\r\n\r\n4274\r\n1143\r\n\r\n5639\r\n1143\r\n\r\n4274\r\n1143\r\n\r\nFEATURE\r\nPROCESS AREA\r\nSTDLENGTH IN\r\nOPTLENGTH IN\r\nSTDLENGTH MM\r\n"]
