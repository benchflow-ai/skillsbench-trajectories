[?2004hroot@836b23318f3e:/app# cat << 'EOF' > process_prs.py
[?2004l[?2004h> import json
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> 
[?2004l[?2004h> with open('merged_prs.json') as f:
[?2004l[?2004h>     merged_data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> total_merge_days = 0
[?2004l[?2004h> count = 0
[?2004l[?2004h> for item in merged_data['items']:
[?2004l[?2004h>     created_at = datetime.strptime(item['created_at'], '%Y-%m-%dT%H:%M:%SZ')
[?2004l[?2004h>     merged_at = datetime.strptime(item['closed_at'], '%Y-%m-%dT%H:%M:%SZ')
[?2004l[?2004h>     diff = merged_at - created_at
[?2004l[?2004h>     total_merge_days += diff.total_seconds() / (24 * 3600)
[?2004l[?2004h>     count += 1
[?2004l[?2004h> 
[?2004l[?2004h> avg_merge_days = round(total_merge_days / count, 1) if count > 0 else 0
[?2004l[?2004h> 
[?2004l[?2004h> with open('prs.json') as f:
[?2004l[?2004h>     all_prs = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> contributors = {}
[?2004l[?2004h> for item in all_prs['items']:
[?2004l[?2004h>     user = item['user']['login']
[?2004l[?2004h>     contributors[user] = contributors.get(user, 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> top_contributor = max(contributors, key=contributors.get) if contributors else ""
[?2004l[?2004h> 
[?2004l[?2004h> print(f"avg_merge_days: {avg_merge_days}")
[?2004l[?2004h> print(f"top_contributor: {top_contributor}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@836b23318f3e:/app# python3 process_prs.py
