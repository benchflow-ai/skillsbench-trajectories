[71.211463, "o", "\u001b[0;39m19\u001b[0m\r\n\u001b[?2004hroot@836b23318f3e:/app# "]
[71.52493, "i", "cat << 'EOF' > process_prs.py\nimport json\nfrom datetime import datetime\n\nwith open('merged_prs.json') as f:\n    merged_data = json.load(f)\n\ntotal_merge_days = 0\ncount = 0\nfor item in merged_data['items']:\n    created_at = datetime.strptime(item['created_at'], '%Y-%m-%dT%H:%M:%SZ')\n    merged_at = datetime.strptime(item['closed_at'], '%Y-%m-%dT%H:%M:%SZ')\n    diff = merged_at - created_at\n    total_merge_days += diff.total_seconds() / (24 * 3600)\n    count += 1\n\navg_merge_days = round(total_merge_days / count, 1) if count > 0 else 0\n\nwith open('prs.json') as f:\n    all_prs = json.load(f)\n\ncontributors = {}\nfor item in all_prs['items']:\n    user = item['user']['login']\n    contributors[user] = contributors.get(user, 0) + 1\n\ntop_contributor = max(contributors, key=contributors.get) if contributors else \"\"\n\nprint(f\"avg_merge_days: {avg_merge_days}\")\nprint(f\"top_contributor: {top_contributor}\")\nEOF\n"]
[71.525978, "o", "cat << 'EOF' > process_prs.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('merged_prs.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     merged_data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> total_merge_days = 0"]
[71.526327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.526593, "o", "count = 0\r\n\u001b[?2004l\r"]
[71.52669, "o", "\u001b[?2004h> for item in merged_data['items']:"]
[71.526817, "o", "\r\n"]
[71.527859, "o", "\u001b[?2004l\r\u001b[?2004h"]
[71.527929, "o", ">     created_at = datetime.strptime(item['created_at'], '%Y-%m-%dT%H:%M:%SZ')\r\n\u001b[?2004l\r\u001b[?2004h>     merged_at = datetime.strptime(item['closed_at'], '%Y-%m-%dT%H:%M:%SZ')\r\n\u001b[?2004l\r\u001b[?2004h>     diff = merged_at - created_at\r\n\u001b[?2004l\r\u001b[?2004h>     total_merge_days += diff.total_seconds() / (24 * 3600)\r\n\u001b[?2004l\r"]
[71.528138, "o", "\u001b[?2004h> "]
