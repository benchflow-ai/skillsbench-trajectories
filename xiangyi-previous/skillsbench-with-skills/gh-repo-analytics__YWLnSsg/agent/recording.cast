[71.528455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.528496, "o", "> "]
[71.5286, "o", "with open('prs.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.528696, "o", "    all_prs = json.load(f)\r\n\u001b[?2004l\r"]
[71.528796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
