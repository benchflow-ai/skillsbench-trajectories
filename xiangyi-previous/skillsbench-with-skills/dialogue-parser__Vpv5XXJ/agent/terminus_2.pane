[?2004hroot@40691a8e6f65:/app# cat > solution.py << 'EOF'
[?2004l] = scene_content
    
    # Second pass: parse each scene
    for scene_id, content in scenes.items():
        # Check if this is a choice menu (has numbered options)
        is_choice = any(re.match(r'^\d+\.', line) for line in content)
        
        if is_choice:
            # This is a choice node
            nodes.append({
                "id": scene_id,
                "text": "",
                "speaker": "",
                "type": "choice"
            })
            
            # Parse each choice option
            for line in content:
                choice_match = re.match(r'^(\d+)\. (.+?) -> (.+)$', line)
                if choice_match:
                    choice_text = choice_match.group(2)
                    target = choice_match.group(3)
                    
                    edges.append({
                        "from": scene_id,
                        "to": target,
                        "text": choice_text
                    })
        else:
            # This is a dialogue line node
            for line in content:
                dialogue_match = re.match(r'^(.+?): (.+?) -> (.+)$', line)
                if dialogue_match:
                    speaker = dialogue_match.group(1)
                    text = dialogue_match.group(2)
                    target = dialogue_match.group(3)
                    
                    nodes.append({
                        "id": scene_id,
                        "text": text,
                        "speaker": speaker,
                        "type": "line"
                    })
                    
                    edges.append({
                        "from": scene_id,
                        "to": target,
                        "text": ""
                    })
    
    return {
        "nodes": nodes,
        "edges": edges
    }

def generate_dot(graph):
    """
    Generate a Graphviz DOT format visualization.
    """
    dot_lines = ["digraph Dialogue {"]
    dot_lines.append("  rankdir=TB;")
    dot_lines.append("  node [shape=box];")
    dot_lines.append("")
    
    # Add nodes
    for node in graph["nodes"]:
        node_id = node["id"]
        label_parts = []
        
        if node["speaker"]:
            label_parts.append(f"{node['speaker']}")
        if node["text"]:
            label_parts.append(f"{node['text']}")
        
        label = "\\n".join(label_parts) if label_parts else node_id
        
        # Escape quotes in label
        label = label.replace('"', '\\"')
        
        shape = "diamond" if node["type"] == "choice" else "box"
        dot_lines.append(f'  "{node_id}" [label="{label}", shape={shape}];')
    
    dot_lines.append("")
    
    # Add edges
    for edge in graph["edges"]:
        from_node = edge["from"]
        to_node = edge["to"]
        edge_label = edge["text"].replace('"', '\\"') if edge["text"] else ""
        
        if edge_label:
            dot_lines.append(f'  "{from_node}" -> "{to_node}" [label="{edge_label}"];')
        else:
            dot_lines.append(f'  "{from_node}" -> "{to_node}";')
    
    dot_line[?2004h> import re
