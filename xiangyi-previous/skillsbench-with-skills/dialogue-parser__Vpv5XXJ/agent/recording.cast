[46.953959, "o", "head -30 dialogue.dot\r\n\u001b[?2004l\r"]
[46.954996, "o", "digraph Dialogue {\r\n  rankdir=TB;\r\n  node [shape=box];\r\n\r\n  \"Start\" [label=\"Narrator\\nThe tavern door creaks open. Smoke and laughter fill the air.\", shape=box];\r\n  \"TavernEntry\" [label=\"Narrator\\nThree figures catch your eye: a hooded stranger, a boisterous merchant, and the barkeep.\", shape=box];\r\n  \"TavernChoice\" [label=\"TavernChoice\", shape=diamond];\r\n  \"ObserveRoom\" [label=\"Narrator\\nYou notice the stranger slipping a note to the barkeep. The merchant counts gold nervously.\", shape=box];\r\n  \"ObserveChoice\" [label=\"ObserveChoice\", shape=diamond];\r\n  \"InterceptNote\" [label=\"Stranger\\nYou dare?!\", shape=box];\r\n  \"PickpocketAttempt\" [label=\"PickpocketAttempt\", shape=diamond];\r\n  \"PickpocketSuccess\" [label=\"Narrator\\n50 gold pieces heavier, you slip away. The merchant hasn't noticed... yet.\", shape=box];\r\n  \"PickpocketDistract\" [label=\"Merchant\\nWatch it, friend!\", shape=box];\r\n  \"MerchantAnnoyed\" [label=\"MerchantAnnoyed\", shape=diamond];\r\n  \"MerchantCalm\" [label=\"Merchant\\nHmph. Buy me a drink and we're even"]
[46.95506, "o", ".\", shape=box];\r\n  \"MerchantFight\" [label=\"Merchant\\nWhy you little—!\", shape=box];\r\n  \"PickpocketAfter\" [label=\"Narrator\\nBut where to spend your ill-gotten gains?\", shape=box];\r\n  \"PickpocketChoice\" [label=\"PickpocketChoice\", shape=diamond];\r\n  \"StrangerApproach\" [label=\"Stranger\\nYou have the look of someone seeking something.\", shape=box];\r\n  \"StrangerGreet\" [label=\"StrangerGreet\", shape=diamond];\r\n  \"CrimsonQuestStart\" [label=\"Stranger\\nThe Crimson Blade? Many seek it. Few survive.\", shape=box];\r\n  \"CrimsonWarning\" [label=\"CrimsonWarning\", shape=diamond];\r\n  \"CrimsonAccept\" [label=\"Stranger\\nThen you'll need a map. I have one... for a price.\", shape=box];\r\n  \"CrimsonPrice\" [label=\"CrimsonPrice\", shape=diamond];\r\n  \"CrimsonNegotiate\" [label=\"Stranger\\n100 gold, or a favor to be named later.\", shape=box];\r\n  \"CrimsonDeal\" [label=\"CrimsonDeal\", shape=diamond];\r\n  \"CrimsonGoldPath\" [label=\"Stranger\\nWise choice. No strings attached.\", shape=box];\r\n  \"CrimsonFavorPath\" [label=\"Stranger\\nRemember, I always c"]
[46.955077, "o", "ollect.\", shape=box];\r\n  \"CrimsonCompromise\" [label=\"Stranger\\nYou drive a hard bargain. Agreed.\", shape=box];\r\n  \"CrimsonDiscount\" [label=\"Stranger\\nYour silver tongue amuses me. 75 gold, final offer.\", shape=box];\r\n"]
[46.95516, "o", "\u001b[?2004h"]
