[32.759649, "i", ")\n    dot_lines.append(\"\")\n    \n    # Add nodes\n    for node in graph[\"nodes\"]:\n        node_id = node[\"id\"]\n        label_parts = []\n        \n        if node[\"speaker\"]:\n            label_parts.append(f\"{node['speaker']}\")\n        if node[\"text\"]:\n            label_parts.append(f\"{node['text']}\")\n        \n        label = \"\\\\n\".join(label_parts) if label_parts else node_id\n        \n        # Escape quotes in label\n        label = label.replace('\"', '\\\\\"')\n        \n        shape = \"diamond\" if node[\"type\"] == \"choice\" else \"box\"\n        dot_lines.append(f'  \"{node_id}\" [label=\"{label}\", shape={shape}];')\n    \n    dot_lines.append(\"\")\n    \n    # Add edges\n    for edge in graph[\"edges\"]:\n        from_node = edge[\"from\"]\n        to_node = edge[\"to\"]\n        edge_label = edge[\"text\"].replace('\"', '\\\\\"') if edge[\"text\"] else \"\"\n        \n        if edge_label:\n            dot_lines.append(f'  \"{from_node}\" -> \"{to_node}\" [label=\"{edge_label}\"];')\n        else:\n            dot_lines.append(f'  \"{from_node}\" -> \"{to_n"]
[32.759676, "o", "end({\r\n                \"id\": scene_id,\r\n                \"text\": \"\",\r\n                \"speake"]
[32.75972, "i", "ode}\";')\n    \n    dot_lines.append(\"}\")\n    return \"\\n\".join(dot_lines)\n\nif __name__ == \"__main__\":\n    # Read the script file\n    with open('/app/script.txt', 'r') as f:\n        script_text = f.read()\n    \n    # Parse the script\n    graph = parse_script(script_text)\n    \n    # Write JSON output\n    with open('/app/dialogue.json', 'w') as f:\n        json.dump(graph, f, indent=2)\n    \n    # Generate and write DOT visualization\n    dot_content = generate_dot(graph)\n    with open('/app/dialogue.dot', 'w') as f:\n        f.write(dot_content)\n    \n    print(f\"Parsed {len(graph['nodes'])} nodes and {len(graph['edges'])} edges\")\n    print(\"Output written to dialogue.json and dialogue.dot\")\nEOF\n"]
