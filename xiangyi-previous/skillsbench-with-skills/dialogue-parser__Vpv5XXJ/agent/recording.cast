[62.985117, "i", "python3 << 'VALIDATE'\nimport json\nfrom solution import parse_script\n\n# Load the generated graph\nwith open('/app/dialogue.json', 'r') as f:\n    graph = json.load(f)\n\nprint(f\"Total nodes: {len(graph['nodes'])}\")\nprint(f\"Total edges: {len(graph['edges'])}\")\n\n# Check that parse_script function exists and works\nwith open('/app/script.txt', 'r') as f:\n    test_graph = parse_script(f.read())\nprint(f\"\\nparse_script function works: {len(test_graph['nodes'])} nodes, {len(test_graph['edges'])} edges\")\n\n# Get all node IDs\nnode_ids = set(node['id'] for node in graph['nodes'])\nprint(f\"\\nUnique node IDs: {len(node_ids)}\")\n\n# Check edge targets\nedge_targets = set(edge['to'] for edge in graph['edges'])\nmissing_targets = edge_targets - node_ids - {'End'}  # 'End' is allowed to not exist\n\nif missing_targets:\n    print(f\"\\nWarning: Missing target nodes: {missing_targets}\")\nelse:\n    print(\"\\nAll edge targets exist (or are 'End')\")\n\n# Check reachability from Start\nreachable = set()\nto_visit = ['Start']\nwhile to_visit:\n    current"]
[62.985288, "i", " = to_visit.pop()\n    if current in reachable or current == 'End':\n        continue\n    reachable.add(current)\n    # Find all edges from current\n    for edge in graph['edges']:\n        if edge['from'] == current and edge['to'] not in reachable:\n            to_visit.append(edge['to'])\n\nprint(f\"\\nReachable nodes from Start: {len(reachable)}\")\nunreachable = node_ids - reachable\nif unreachable:\n    print(f\"Warning: Unreachable nodes: {unreachable}\")\nelse:\n    print(\"All nodes are reachable from Start\")\n\n# Check node types\nline_nodes = [n for n in graph['nodes'] if n['type'] == 'line']\nchoice_nodes = [n for n in graph['nodes'] if n['type'] == 'choice']\nprint(f\"\\nLine nodes: {len(line_nodes)}\")\nprint(f\"Choice nodes: {len(choice_nodes)}\")\n\n# Check for 'End' edges\nend_edges = [e for e in graph['edges'] if e['to'] == 'End']\nprint(f\"\\nEdges leading to 'End': {len(end_edges)}\")\n\nprint(\"\\n✓ Validation complete!\")\nVALIDATE\n"]
