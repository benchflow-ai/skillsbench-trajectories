[32.763995, "o", "    # Second pass: parse each scene\r\n\u001b[?2004l\r"]
[32.764025, "o", "\u001b[?2004h> "]
[32.764077, "o", "    for scene_id, content in scenes.items():\r\n\u001b[?2004l\r"]
[32.764103, "o", "\u001b[?2004h> "]
[32.764188, "o", "        # Check if this is a choice menu (has numbered options)\r\n\u001b[?2004l\r"]
[32.764206, "o", "\u001b[?2004h> "]
[32.764326, "o", "        is_choice = any(re.match(r'^\\d+\\.', line) for line in content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.764349, "o", "> "]
[32.764371, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.764405, "o", "        if is_choice:\r\n\u001b[?2004l\r"]
[32.764431, "o", "\u001b[?2004h> "]
[32.764478, "o", "            # This is a choice node\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.764504, "o", "> "]
[32.764553, "o", "            nodes.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.764574, "o", "> "]
[32.76463, "o", "                \"id\": scene_id,\r\n\u001b[?2004l\r"]
[32.764659, "o", "\u001b[?2004h> "]
[32.764688, "o", "                \"text\": \"\",\r\n\u001b[?2004l\r"]
[32.764715, "o", "\u001b[?2004h> "]
[32.764752, "o", "                \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[32.764774, "o", "\u001b[?2004h> "]
[32.764823, "o", "                \"type\": \"choice\"\r\n\u001b[?2004l\r"]
[32.764834, "o", "\u001b[?2004h> "]
[32.764863, "o", "            })\r\n\u001b[?2004l\r"]
[32.764884, "o", "\u001b[?2004h> "]
[32.764905, "o", "            \r\n\u001b[?2004l\r"]
[32.764934, "o", "\u001b[?2004h> "]
[32.764974, "o", "            # Parse each choice option\r\n\u001b[?2004l\r"]
[32.765003, "o", "\u001b[?2004h> "]
[32.765038, "o", "            for line in content:\r\n\u001b[?2004l\r"]
[32.765072, "o", "\u001b[?2004h> "]
[32.765165, "o", "                choice_match = re.match(r'^(\\d+)\\. (.+?) -> (.+)$', line)\r\n\u001b[?2004l\r"]
[32.765192, "o", "\u001b[?2004h> "]
[32.765231, "o", "                if choice_match:\r\n\u001b[?2004l\r"]
[32.765258, "o", "\u001b[?2004h> "]
[32.765344, "o", "                    choice_text = choice_match.group(2)\r\n\u001b[?2004l\r"]
[32.765388, "o", "\u001b[?2004h> "]
[32.765497, "o", "                    target = choice_match.group(3)\r\n\u001b[?2004l\r"]
[32.765519, "o", "\u001b[?2004h> "]
[32.765568, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.765592, "o", "> "]
[32.7657, "o", "                    edges.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.765791, "o", "                        \"from\": scene_id,\r\n\u001b[?2004l\r"]
[32.765831, "o", "\u001b[?2004h> "]
[32.765872, "o", "                        \"to\": target,\r\n\u001b[?2004l\r"]
[32.765926, "o", "\u001b[?2004h> "]
[32.765995, "o", "                        \"text\": choice_text\r\n\u001b[?2004l\r"]
[32.766034, "o", "\u001b[?2004h> "]
[32.766071, "o", "                    })\r\n\u001b[?2004l\r"]
[32.766107, "o", "\u001b[?2004h> "]
[32.766149, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.766253, "o", "            # This is a dialogue line node\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.766293, "o", "> "]
[32.766341, "o", "            for line in content:\r\n\u001b[?2004l\r"]
[32.766378, "o", "\u001b[?2004h> "]
[32.766524, "o", "                dialogue_match = re.match(r'^(.+?): (.+?) -> (.+)$', line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.766567, "o", "> "]
[32.766619, "o", "                if dialogue_match:\r\n\u001b[?2004l\r"]
[32.76666, "o", "\u001b[?2004h> "]
[32.76677, "o", "                    speaker = dialogue_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.76681, "o", "> "]
[32.766909, "o", "                    text = dialogue_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.766951, "o", "> "]
[32.767053, "o", "                    target = dialogue_match.group(3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.767116, "o", "> "]
[32.767158, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.76722, "o", "                    nodes.append({\r\n\u001b[?2004l\r"]
[32.767255, "o", "\u001b[?2004h> "]
[32.767334, "o", "                        \"id\": scene_id,\r\n\u001b[?2004l\r"]
[32.767375, "o", "\u001b[?2004h> "]
[32.767447, "o", "                        \"text\": text,\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.767488, "o", "> "]
[32.767569, "o", "                        \"speaker\": speaker,\r\n\u001b[?2004l\r"]
[32.767606, "o", "\u001b[?2004h> "]
[32.76768, "o", "                        \"type\": \"line\"\r\n\u001b[?2004l\r"]
[32.767722, "o", "\u001b[?2004h> "]
[32.767759, "o", "                    })\r\n\u001b[?2004l\r"]
[32.767798, "o", "\u001b[?2004h> "]
[32.767838, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.767877, "o", "> "]
[32.767933, "o", "                    edges.append({\r\n\u001b[?2004l\r"]
[32.767971, "o", "\u001b[?2004h> "]
[32.768049, "o", "                        \"from\": scene_id,\r\n\u001b[?2004l\r"]
[32.768088, "o", "\u001b[?2004h> "]
[32.768158, "o", "                        \"to\": target,\r\n\u001b[?2004l\r"]
[32.768197, "o", "\u001b[?2004h> "]
[32.768275, "o", "                        \"text\": \"\"\r\n\u001b[?2004l\r"]
[32.768317, "o", "\u001b[?2004h> "]
[32.768358, "o", "                    })\r\n\u001b[?2004l\r"]
[32.768398, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.768439, "o", "    return {\r\n\u001b[?2004l\r"]
[32.768477, "o", "\u001b[?2004h> "]
[32.768521, "o", "        \"nodes\": nodes,\r\n\u001b[?2004l\r"]
[32.768568, "o", "\u001b[?2004h> "]
[32.76861, "o", "        \"edges\": edges\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.768634, "o", "    }\r\n\u001b[?2004l\r"]
[32.768687, "o", "\u001b[?2004h> "]
[32.768726, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.76877, "o", "def generate_dot(graph):\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.768809, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.76893, "o", "    Generate a Graphviz DOT format visualization.\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.76897, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[32.769009, "o", "\u001b[?2004h> "]
[32.769077, "o", "    dot_lines = [\"digraph Dialogue {\"]\r\n\u001b[?2004l\r"]
[32.769114, "o", "\u001b[?2004h> "]
[32.769187, "o", "    dot_lines.append(\"  rankdir=TB;\")\r\n\u001b[?2004l\r"]
[32.769224, "o", "\u001b[?2004h> "]
[32.769306, "o", "    dot_lines.append(\"  node [shape=box];\")\r\n\u001b[?2004l\r"]
[32.769346, "o", "\u001b[?2004h> "]
[32.76939, "o", "    dot_lines.append(\"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.769429, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.769465, "o", "> "]
[32.769503, "o", "    # Add nodes\r\n\u001b[?2004l\r"]
[32.769542, "o", "\u001b[?2004h> "]
[32.769584, "o", "    for node in graph[\"nodes\"]:\r\n\u001b[?2004l\r"]
[32.769622, "o", "\u001b[?2004h> "]
[32.769672, "o", "        node_id = node[\"id\"]\r\n\u001b[?2004l\r"]
[32.769712, "o", "\u001b[?2004h> "]
[32.769754, "o", "        label_parts = []\r\n\u001b[?2004l\r"]
[32.769794, "o", "\u001b[?2004h> "]
[32.769834, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.769887, "o", "        if node[\"speaker\"]:\r\n\u001b[?2004l\r"]
[32.769926, "o", "\u001b[?2004h> "]
[32.770036, "o", "            label_parts.append(f\"{node['speaker']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.770075, "o", "> "]
[32.770125, "o", "        if node[\"text\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.770248, "o", "            label_parts.append(f\"{node['text']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.770302, "o", "> "]
[32.770342, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.770459, "o", "        label = \"\\\\n\".join(label_parts) if label_parts else node_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.770499, "o", ">         \r\n\u001b[?2004l\r"]
[32.770538, "o", "\u001b[?2004h> "]
[32.770598, "o", "        # Escape quotes in label\r\n\u001b[?2004l\r"]
[32.770639, "o", "\u001b[?2004h> "]
[32.770716, "o", "        label = label.replace('\"', '\\\\\"')\r\n\u001b[?2004l\r"]
[32.770747, "o", "\u001b[?2004h> "]
[32.77079, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.77083, "o", "> "]
[32.770937, "o", "        shape = \"diamond\" if node[\"type\"] == \"choice\" else \"box\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.770976, "o", "> "]
[32.771116, "o", "        dot_lines.append(f'  \"{node_id}\" [label=\"{label}\", shape={shape}];')\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.771158, "o", ">     \r\n\u001b[?2004l\r"]
[32.771224, "o", "\u001b[?2004h> "]
[32.771264, "o", "    dot_lines.append(\"\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.771302, "o", "\u001b[?2004h> "]
[32.771356, "o", "    # Add edges\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.77142, "o", "    for edge in graph[\"edges\"]:\r\n\u001b[?2004l\r"]
[32.77146, "o", "\u001b[?2004h> "]
[32.771519, "o", "        from_node = edge[\"from\"]\r\n\u001b[?2004l\r"]
[32.771557, "o", "\u001b[?2004h> "]
[32.77161, "o", "        to_node = edge[\"to\"]\r\n\u001b[?2004l\r"]
[32.771649, "o", "\u001b[?2004h> "]
[32.771796, "o", "        edge_label = edge[\"text\"].replace('\"', '\\\\\"') if edge[\"text\"] else \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.771835, "o", ">         \r\n\u001b[?2004l\r"]
[32.771873, "o", "\u001b[?2004h> "]
[32.771912, "o", "        if edge_label:\r\n\u001b[?2004l\r"]
[32.771965, "o", "\u001b[?2004h> "]
[32.772116, "o", "            dot_lines.append(f'  \"{from_node}\" -> \"{to_node}\" [label=\"{edge_label}\"];')\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.772156, "o", ">         else:\r\n\u001b[?2004l\r"]
[32.772195, "o", "\u001b[?2004h> "]
[32.772343, "o", "            dot_lines.append(f'  \"{from_node}\" -> \"{to_node}\";')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.772385, "o", "    \r\n\u001b[?2004l\r"]
[32.772424, "o", "\u001b[?2004h> "]
[32.772462, "o", "    dot_lines.append(\"}\")\r\n\u001b[?2004l\r"]
[32.772501, "o", "\u001b[?2004h> "]
[32.772546, "o", "    return \"\\n\".join(dot_lines)\r\n\u001b[?2004l\r"]
[32.772586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.772626, "o", "\u001b[?2004h> "]
[32.772673, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.772711, "o", "> "]
[32.772759, "o", "    # Read the script file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.772872, "o", "    with open('/app/script.txt', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.77291, "o", "> "]
[32.772958, "o", "        script_text = f.read()\r\n\u001b[?2004l\r"]
[32.772995, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.773034, "o", "\u001b[?2004h> "]
[32.773068, "o", "    # Parse the script\r\n\u001b[?2004l\r"]
[32.773123, "o", "\u001b[?2004h> "]
[32.773176, "o", "    graph = parse_script(script_text)\r\n\u001b[?2004l\r"]
[32.773215, "o", "\u001b[?2004h> "]
[32.773255, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.773292, "o", "    # Write JSON output\r\n\u001b[?2004l\r"]
[32.77333, "o", "\u001b[?2004h> "]
[32.773428, "o", "    with open('/app/dialogue.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.773469, "o", "> "]
[32.773537, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r"]
[32.773573, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.773622, "o", "\u001b[?2004h> "]
[32.773691, "o", "    # Generate and write DOT visualization\r\n\u001b[?2004l\r"]
[32.773732, "o", "\u001b[?2004h> "]
[32.773799, "o", "    dot_content = generate_dot(graph)\r\n\u001b[?2004l\r"]
[32.773839, "o", "\u001b[?2004h> "]
[32.773937, "o", "    with open('/app/dialogue.dot', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.773976, "o", "> "]
[32.77402, "o", "        f.write(dot_content)\r\n\u001b[?2004l\r"]
[32.774057, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[32.774097, "o", "\u001b[?2004h> "]
[32.774247, "o", "    print(f\"Parsed {len(graph['nodes'])} nodes and {len(graph['edges'])} edges\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.774287, "o", "> "]
[32.774408, "o", "    print(\"Output written to dialogue.json and dialogue.dot\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.774447, "o", "> EOF\r\n\u001b[?2004l\r"]
[32.776056, "o", "\u001b[?2004hroot@40691a8e6f65:/app# "]
[32.926304, "i", "python3 solution.py\n"]
[32.927747, "o", "python3 solution.py\r\n\u001b[?2004l\r"]
[32.949596, "o", "Parsed 204 nodes and 321 edges\r\nOutput written to dialogue.json and dialogue.dot\r\n"]
[32.952644, "o", "\u001b[?2004hroot@40691a8e6f65:/app# "]
[41.75612, "i", "ls -la\n"]
[41.756267, "o", "ls -la\r\n\u001b[?2004l\r"]
[41.757495, "o", "total 140\r\ndrwxr-xr-x 1 root root  4096 Jan 26 11:19 .\r\ndrwxr-xr-x 1 root root  4096 Jan 26 11:19 ..\r\n-rw-r--r-- 1 root root 36392 Jan 26 11:19 dialogue.dot\r\n"]
[41.757562, "o", "-rw-r--r-- 1 root root 62460 Jan 26 11:19 dialogue.json\r\n-rw-r--r-- 1 root root 22785 Jan 25 20:43 script.txt\r\n-rw-r--r-- 1 root root  4760 Jan 26 11:19 solution.py\r\n"]
[41.758148, "o", "\u001b[?2004hroot@40691a8e6f65:/app# "]
[41.864877, "i", "head -50 dialogue.json\n"]
[41.865021, "o", "head -50 dialogue.json\r\n\u001b[?2004l\r"]
[41.865962, "o", "{\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"Start\",\r\n      \"text\": \"The tavern door creaks open. Smoke and laughter fill the air.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"TavernEntry\",\r\n      \"text\": \"Three figures catch your eye: a hooded stranger, a boisterous merchant, and the barkeep.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"TavernChoice\",\r\n      \"text\": \"\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveRoom\",\r\n      \"text\": \"You notice the stranger slipping a note to the barkeep. The merchant counts gold nervously.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveChoice\",\r\n      \"text\": \"\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"InterceptNote\",\r\n      \"text\": \"You dare?!\",\r\n      \"speaker\": \"Stranger\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"PickpocketAttempt\",\r\n      \"text\": \"\",\r\n      \"speaker\": \"\",\r\n    "]
[41.865981, "o", "  \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"PickpocketSuccess\",\r\n      \"text\": \"50 gold pieces heavier, you slip away. The merchant hasn't noticed... yet.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n"]
[41.866126, "o", "\u001b[?2004hroot@40691a8e6f65:/app# "]
[46.840705, "i", "grep -A 30 '\"edges\"' dialogue.json | head -40\n"]
[46.840941, "o", "grep -A 30 '\"edges\"' dialogue.json | head -40\r\n\u001b[?2004l\r"]
[46.842593, "o", "  \"edges\": [\r\n    {\r\n      \"from\": \"Start\",\r\n      \"to\": \"TavernEntry\",\r\n      \"text\": \"\"\r\n    },\r\n    {\r\n      \"from\": \"TavernEntry\",\r\n      \"to\": \"TavernChoice\",\r\n      \"text\": \"\"\r\n    },\r\n    {\r\n      \"from\": \"TavernChoice\",\r\n      \"to\": \"StrangerApproach\",\r\n      \"text\": \"Approach the hooded stranger.\"\r\n    },\r\n    {\r\n      \"from\": \"TavernChoice\",\r\n"]
[46.842618, "o", "      \"to\": \"MerchantApproach\",\r\n      \"text\": \"Sit next to the merchant.\"\r\n    },\r\n    {\r\n      \"from\": \"TavernChoice\",\r\n      \"to\": \"BarkeepApproach\",\r\n      \"text\": \"Order a drink from the barkeep.\"\r\n    },\r\n    {"]
[46.842723, "o", "\r\n      \"from\": \"TavernChoice\",\r\n      \"to\": \"ObserveRoom\",\r\n      \"text\": \"[Observe] Study the room from the shadows.\"\r\n    },\r\n"]
[46.842847, "o", "\u001b[?2004hroot@40691a8e6f65:/app# "]
