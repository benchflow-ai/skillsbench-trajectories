[197.823714, "o", "API_KEY = os.environ.get('OPENAI_API_KEY')\r\n\u001b[?2004l\r\u001b[?2004h> if not API_KEY:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.823807, "o", "    raise SystemExit('Missing OPENAI_API_KEY')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[197.823854, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[197.823924, "o", "with open('/root/essays.txt','r',encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.823975, "o", "> "]
[197.824014, "o", "    text = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.824067, "o", "> "]
[197.824146, "o", "# Normalize whitespace but preserve paragraph breaks\r\n\u001b[?2004l\r"]
[197.824191, "o", "\u001b[?2004h> "]
[197.824322, "o", "paras = [p.strip() for p in text.split('\\n\\n') if p.strip()]\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.824371, "o", "> "]
[197.824422, "o", "text = '\\n\\n'.join(paras)\r\n\u001b[?2004l\r"]
[197.824461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.82453, "o", "max_chars = 3500  # keep below 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.824585, "o", "> "]
[197.824622, "o", "words = text.split()\r\n\u001b[?2004l\r\u001b[?2004h> chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.824668, "o", "current = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.82472, "o", "cur_len = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.824758, "o", "for w in words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.824809, "o", "    # +1 for space if needed\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.824847, "o", "> "]
[197.824895, "o", "    add_len = len(w) + (1 if current else 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.824945, "o", "> "]
[197.824994, "o", "    if cur_len + add_len > max_chars:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.825069, "o", "        chunks.append(' '.join(current))\r\n\u001b[?2004l\r"]
[197.825121, "o", "\u001b[?2004h> "]
[197.825171, "o", "        current = [w]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.825208, "o", "        cur_len = len(w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.825252, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.825301, "o", "        current.append(w)\r\n\u001b[?2004l\r"]
[197.825349, "o", "\u001b[?2004h> "]
[197.825398, "o", "        cur_len += add_len\r\n\u001b[?2004l\r\u001b[?2004h> if current:\r\n\u001b[?2004l\r"]
[197.825447, "o", "\u001b[?2004h> "]
[197.825492, "o", "    chunks.append(' '.join(current))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.825538, "o", "\u001b[?2004h> "]
[197.82563, "o", "print('Chunks:', len(chunks), 'maxlen', max(len(c) for c in chunks))\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.825675, "o", "> \r\n\u001b[?2004l\r"]
[197.825721, "o", "\u001b[?2004h> "]
[197.825764, "o", "os.makedirs('/root/tts_segments', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.825809, "o", "> "]
[197.825885, "o", "url = 'https://api.openai.com/v1/audio/speech'\r\n\u001b[?2004l\r"]
[197.825936, "o", "\u001b[?2004h> "]
[197.826088, "o", "headers = {'Authorization': f'Bearer {API_KEY}', 'Content-Type': 'application/json'}\r\n\u001b[?2004l\r"]
[197.826141, "o", "\u001b[?2004h> "]
[197.826193, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.82623, "o", "for i, chunk in enumerate(chunks, 1):\r\n\u001b[?2004l\r"]
[197.826256, "o", "\u001b[?2004h> "]
[197.826365, "o", "    out_path = f'/root/tts_segments/part_{i:03d}.mp3'\r\n\u001b[?2004l\r"]
[197.826407, "o", "\u001b[?2004h> "]
[197.826563, "o", "    payload = {'model': 'tts-1', 'voice': 'alloy', 'input': chunk, 'format': 'mp3'}\r\n\u001b[?2004l\r"]
[197.826614, "o", "\u001b[?2004h> "]
[197.826734, "o", "    print(f'Generating chunk {i}/{len(chunks)} len={len(chunk)}')\r\n\u001b[?2004l\r"]
[197.826786, "o", "\u001b[?2004h> "]
[197.82692, "o", "    r = requests.post(url, headers=headers, json=payload, timeout=120)\r\n\u001b[?2004l\r"]
[197.826977, "o", "\u001b[?2004h> "]
[197.827027, "o", "    if r.status_code != 200:\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.827076, "o", "> "]
[197.827131, "o", "        print('Error', r.status_code, r.text[:500])\r\n\u001b[?2004l\r"]
[197.827182, "o", "\u001b[?2004h> "]
[197.827244, "o", "        raise SystemExit('TTS failed')\r\n\u001b[?2004l\r"]
[197.827299, "o", "\u001b[?2004h> "]
[197.827345, "o", "    with open(out_path, 'wb') as f:\r\n\u001b[?2004l\r"]
[197.827398, "o", "\u001b[?2004h> "]
[197.827448, "o", "        f.write(r.content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.827518, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.827579, "o", "list_path = '/root/tts_segments/list.txt'\r\n\u001b[?2004l\r"]
[197.827631, "o", "\u001b[?2004h> "]
[197.827675, "o", "with open(list_path, 'w') as f:\r\n\u001b[?2004l\r"]
[197.827728, "o", "\u001b[?2004h> "]
[197.827772, "o", "    for i in range(1, len(chunks)+1):\r\n\u001b[?2004l\r"]
[197.827827, "o", "\u001b[?2004h> "]
[197.827938, "o", "        f.write(f\"file '/root/tts_segments/part_{i:03d}.mp3'\\n\")\r\n\u001b[?2004l\r"]
[197.827981, "o", "\u001b[?2004h> "]
[197.828033, "o", "print('Wrote list', list_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.828085, "o", "PY\r\n\u001b[?2004l\r"]
[197.929647, "o", "Chunks: 10 maxlen 3500\r\nGenerating chunk 1/10 len=3497\r\n"]
[198.834222, "i", "ffmpeg -f concat -safe 0 -i /root/tts_segments/list.txt -c copy /root/audiobook.mp3\n"]
[198.834375, "o", "ffmpeg -f concat -safe 0 -i /root/tts_segments/list.txt -c copy /root/audiobook.mp3\r\n"]
[199.874713, "i", "ls -lh /root/audiobook.mp3\n"]
[199.874891, "o", "ls -lh /root/audiobook.mp3\r\n"]
