[197.823242, "i", "python3 - <<'PY'\nimport os, requests, re\nAPI_KEY = os.environ.get('OPENAI_API_KEY')\nif not API_KEY:\n    raise SystemExit('Missing OPENAI_API_KEY')\n\nwith open('/root/essays.txt','r',encoding='utf-8') as f:\n    text = f.read()\n\n# Normalize whitespace but preserve paragraph breaks\nparas = [p.strip() for p in text.split('\\n\\n') if p.strip()]\ntext = '\\n\\n'.join(paras)\n\nmax_chars = 3500  # keep below 4096\nwords = text.split()\nchunks = []\ncurrent = []\ncur_len = 0\nfor w in words:\n    # +1 for space if needed\n    add_len = len(w) + (1 if current else 0)\n    if cur_len + add_len > max_chars:\n        chunks.append(' '.join(current))\n        current = [w]\n        cur_len = len(w)\n    else:\n        current.append(w)\n        cur_len += add_len\nif current:\n    chunks.append(' '.join(current))\n\nprint('Chunks:', len(chunks), 'maxlen', max(len(c) for c in chunks))\n\nos.makedirs('/root/tts_segments', exist_ok=True)\nurl = 'https://api.openai.com/v1/audio/speech'\nheaders = {'Authorization': f'Bearer {API_KEY}', 'Content-Type': 'application/json'}\n\nfor i, chunk in enumerate(chunks, 1):\n    out_path = f'/root/tts_segments/part_{i:03d}.mp3'\n    payload = {'model': 'tts-1', 'voice': 'alloy', 'input': chunk, 'format': 'mp3'}\n    print(f'Generating chunk {i}/{len(chunks)} len={len(chunk)}')\n    r = requests.post(url, headers=headers, json=payload, timeout=120)\n    if r.status_code != 200:\n        print('Error', r.status_code, r.text[:500])\n        raise SystemExit('TTS failed')\n    with open(out_path, 'wb') as f:\n        f.write(r.content)\n\nlist_path = '/root/tts_segments/list.txt'\nwith open(list_path, 'w') as f:\n    for i in range(1, len(chunks)+1):\n        f.write(f\"file '/root/tts_segments/part_{i:03d}.mp3'\\n\")\nprint('Wrote list', list_path)\nPY\n"]
[197.823427, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
