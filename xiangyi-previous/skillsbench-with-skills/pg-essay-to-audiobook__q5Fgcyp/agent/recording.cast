[134.582144, "i", "python3 - <<'PY'\nimport os, textwrap, requests\n\nAPI_KEY = os.environ.get('OPENAI_API_KEY')\nif not API_KEY:\n    raise SystemExit('Missing OPENAI_API_KEY')\n\n# Read text\nwith open('/root/essays.txt','r',encoding='utf-8') as f:\n    text = f.read()\n\n# Simple chunking by character length, trying to split on paragraph boundaries\nmax_chars = 3000\nchunks = []\ncurrent = []\ncurrent_len = 0\nfor para in text.split('\\n\\n'):\n    if not para.strip():\n        continue\n    if current_len + len(para) + 2 > max_chars and current:\n        chunks.append('\\n\\n'.join(current))\n        current = [para]\n        current_len = len(para)\n    else:\n        current.append(para)\n        current_len += len(para) + 2\nif current:\n    chunks.append('\\n\\n'.join(current))\n\nprint('Total chunks:', len(chunks))\n\nos.makedirs('/root/tts_segments', exist_ok=True)\n\nurl = 'https://api.openai.com/v1/audio/speech'\nheaders = {\n    'Authorization': f'Bearer {API_KEY}',\n    'Content-Type': 'application/json'\n}\n\nfor i, chunk in enumerate(chunks, 1):\n    out_path = f'/root/tts_segments/part_{i:03d}.mp3'\n    if os.path.exists(out_path) and os.path.getsize(out_path) > 0:\n        print('Skipping existing', out_path)\n        continue\n    payload = {\n        'model': 'tts-1',\n        'voice': 'alloy',\n        'input': chunk,\n        'format': 'mp3'\n    }\n    print(f'Generating chunk {i}/{len(chunks)} ...')\n    r = requests.post(url, headers=headers, json=payload, timeout=120)\n    if r.status_code != 200:\n        print('Error', r.status_code, r.text[:500])\n        raise SystemExit('TTS failed')\n    with open(out_path, 'wb') as f:\n        f.write(r.content)\n\n# Create concat list for ffmpeg\nlist_path = '/root/tts_segments/list.txt'\nwith open(list_path, 'w') as f:\n    for i in range(1, len(chunks)+1):\n        f.write(f\"file '/root/tts_segments/part_{i:03d}.mp3'\\n\")\nprint('Wrote list', list_path)\nPY\n"]
