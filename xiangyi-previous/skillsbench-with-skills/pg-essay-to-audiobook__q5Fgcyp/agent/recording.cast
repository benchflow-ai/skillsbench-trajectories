[61.321685, "o", "\u001b[?2004hroot@25430d87de17:~# "]
[109.474862, "i", "python3 - <<'PY'\nimport requests\nfrom bs4 import BeautifulSoup\n\nurls = {\n    \"Do Things that Don't Scale\": \"https://www.paulgraham.com/ds.html\",\n    \"Founder Mode\": \"https://www.paulgraham.com/foundermode.html\",\n}\n\ncombined = []\nfor title, url in urls.items():\n    html = requests.get(url, timeout=30).text\n    soup = BeautifulSoup(html, 'lxml')\n    for tag in soup(['script','style']):\n        tag.decompose()\n    fonts = soup.find_all('font')\n    if fonts:\n        main = max(fonts, key=lambda f: len(f.get_text()))\n        text = main.get_text(\"\\n\")\n    else:\n        text = soup.get_text(\"\\n\")\n    lines = [ln.strip() for ln in text.splitlines()]\n    lines = [ln for ln in lines if ln]\n    clean = \"\\n\".join(lines)\n    combined.append(f\"{title}\\nby Paul Graham\\n\\n{clean}\\n\")\n\nfull_text = \"\\n\\n\".join(combined)\nwith open('/root/essays.txt','w',encoding='utf-8') as f:\n    f.write(full_text)\nprint('Wrote', len(full_text), 'chars to /root/essays.txt')\nPY\n"]
