[36.919423, "i", "cat > solve_tasks.py << 'EOF'\nimport jax\nimport jax.numpy as jnp\nfrom jax import grad, jit, vmap\nimport numpy as np\n\n# Task 1: basic_reduce - compute mean of each row\nprint(\"Task 1: basic_reduce\")\nx = jnp.array(np.load('data/x.npy'))\nrow_means = jnp.mean(x, axis=1)\nnp.save('basic_reduce.npy', np.array(row_means))\nprint(f\"Output shape: {row_means.shape}\")\n\n# Task 2: map_square - square each element using vectorization\nprint(\"Task 2: map_square\")\nsquared = jnp.square(x)\nnp.save('map_square.npy', np.array(squared))\nprint(f\"Output shape: {squared.shape}\")\n\n# Task 3: grad_logistic - compute gradient of logistic loss\nprint(\"Task 3: grad_logistic\")\nlogistic_data = np.load('data/logistic.npz')\nx_log = jnp.array(logistic_data['x'])\ny_log = jnp.array(logistic_data['y'])\nw_log = jnp.array(logistic_data['w'])\n\ndef logistic_loss(w, x, y):\n    logits = jnp.dot(x, w)\n    # Logistic loss: mean of log(1 + exp(-y * logits))\n    return jnp.mean(jnp.log(1 + jnp.exp(-y * logits)))\n\ngrad_w = grad(logistic_loss)(w_log, x_log, y_log)\nnp.save('grad_logistic.npy', np.array(grad_w))\nprint(f\"Output shape: {grad_w.shape}\")\n\n# Task 4: scan_rnn - RNN forward pass using scan\nprint(\"Task 4: scan_rnn\")\nseq_data = np.load('data/seq.npz')\nseq = jnp.array(seq_data['seq'])\ninit = jnp.array(seq_data['init'])\nWx = jnp.array(seq_data['Wx'])\nWh = jnp.array(seq_data['Wh'])\nb = jnp.array(seq_data['b'])\n\ndef rnn_step(h, x):\n    h_new = jnp.tanh(jnp.dot(x, Wx) + jnp.dot(h, Wh) + b)\n    return h_new, h_new\n\nfinal_h, all_h = jax.lax.scan(rnn_step, init, seq)\nnp.save('scan_rnn.npy', np.array(all_h))\nprint(f\"Output shape: {all_h.shape}\")\n\n# Task 5: jit_mlp - 2-layer MLP with JIT\nprint(\"Task 5: jit_mlp\")\nmlp_data = np.load('data/mlp.npz')\nX_mlp = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\n@jit\ndef mlp_forward(X, W1, b1, W2, b2):\n    h = jnp.maximum(0, jnp.dot(X, W1) + b1)  # ReLU activation\n    out = jnp.dot(h, W2) + b2\n    return out\n\nmlp_output = mlp_forward(X_mlp, W1, b1, W2, b2)\nnp.save('jit_mlp.npy', np.array(mlp_output))\nprint(f\"Output shape: {mlp_output.shape}\")\n\nprint(\"All tasks completed!\")\nEOF\n"]
