[?2004hroot@0313a62ca3e1:/app# cat > solve_tasks.py << 'EOF'
[?2004l[?2004h> import jax
[?2004l[?2004h> import jax.numpy as jnp
[?2004l[?2004h> from jax import grad, jit, vmap
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Task 1: basic_reduce - compute mean of each row
[?2004l[?2004h> print("Task 1: basic_reduce")
[?2004l[?2004h> x = jnp.array(np.load('data/x.npy'))
[?2004l[?2004h> row_means = jnp.mean(x, axis=1)
[?2004l[?2004h> np.save('basic_reduce.npy', np.array(row_means))
[?2004l[?2004h> print(f"Output shape: {row_means.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 2: map_square - square each element using vectorization
[?2004l[?2004h> print("Task 2: map_square")
[?2004l[?2004h> squared = jnp.square(x)
[?2004l[?2004h> np.save('map_square.npy', np.array(squared))
[?2004l[?2004h> print(f"Output shape: {squared.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 3: grad_logistic - compute gradient of logistic loss
[?2004l[?2004h> print("Task 3: grad_logistic")
[?2004l[?2004h> logistic_data = np.load('data/logistic.npz')
[?2004l[?2004h> x_log = jnp.array(logistic_data['x'])
[?2004l[?2004h> y_log = jnp.array(logistic_data['y'])
[?2004l[?2004h> w_log = jnp.array(logistic_data['w'])
[?2004l[?2004h> 
[?2004l[?2004h> def logistic_loss(w, x, y):
[?2004l[?2004h>     logits = jnp.dot(x, w)
[?2004l[?2004h>     # Logistic loss: mean of log(1 + exp(-y * logits))
[?2004l[?2004h>     return jnp.mean(jnp.log(1 + jnp.exp(-y * logits)))
[?2004l[?2004h> 
[?2004l[?2004h> grad_w = grad(logistic_loss)(w_log, x_log, y_log)
[?2004l[?2004h> np.save('grad_logistic.npy', np.array(grad_w))
[?2004l[?2004h> print(f"Output shape: {grad_w.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 4: scan_rnn - RNN forward pass using scan
[?2004l[?2004h> print("Task 4: scan_rnn")
[?2004l[?2004h> seq_data = np.load('data/seq.npz')
[?2004l[?2004h> seq = jnp.array(seq_data['seq'])
[?2004l[?2004h> init = jnp.array(seq_data['init'])
[?2004l[?2004h> Wx = jnp.array(seq_data['Wx'])
[?2004l[?2004h> Wh = jnp.array(seq_data['Wh'])
[?2004l[?2004h> b = jnp.array(seq_data['b'])
[?2004l[?2004h> 
[?2004l[?2004h> def rnn_step(h, x):
[?2004l[?2004h>     h_new = jnp.tanh(jnp.dot(x, Wx) + jnp.dot(h, Wh) + b)
[?2004l[?2004h>     return h_new, h_new
[?2004l[?2004h> 
[?2004l[?2004h> final_h, all_h = jax.lax.scan(rnn_step, init, seq)
[?2004l[?2004h> np.save('scan_rnn.npy', np.array(all_h))
[?2004l[?2004h> print(f"Output shape: {all_h.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 5: jit_mlp - 2-layer MLP with JIT
[?2004l[?2004h> print("Task 5: jit_mlp")
[?2004l[?2004h> mlp_data = np.load('data/mlp.npz')
[?2004l[?2004h> X_mlp = jnp.array(mlp_data['X'])
[?2004l[?2004h> W1 = jnp.array(mlp_data['W1'])
[?2004l[?2004h> b1 = jnp.array(mlp_data['b1'])
[?2004l[?2004h> W2 = jnp.array(mlp_data['W2'])
[?2004l[?2004h> b2 = jnp.array(mlp_data['b2'])
[?2004l[?2004h> 
[?2004l[?2004h> @jit
[?2004l[?2004h> def mlp_forward(X, W1, b1, W2, b2):
[?2004l[?2004h>     h = jnp.maximum(0, jnp.dot(X, W1) + b1)  # ReLU activation
[?2004l[?2004h>     out = jnp.dot(h, W2) + b2
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> mlp_output = mlp_forward(X_mlp, W1, b1, W2, b2)
[?2004l[?2004h> np.save('jit_mlp.npy', np.array(mlp_output))
[?2004l[?2004h> print(f"Output shape: {mlp_output.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> print("All tasks completed!")
[?2004l[?2004h> EOF
