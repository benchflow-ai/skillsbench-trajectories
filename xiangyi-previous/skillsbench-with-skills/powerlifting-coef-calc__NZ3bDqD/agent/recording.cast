[39.896879, "o", "Column 23: MeetTown\r\nColumn 24: MeetName\r\nColumn 25: Sanctioned\r\n\r\nFirst 3 data rows:\r\nRow 2: ['Julien Comte', 'M', 'SBD', 'Raw', 43, '40-44', '40-49', 'MR-O', 82.25, '83']...\r\nRow 3: ['Matthew Starkey', 'M', 'SBD', 'Raw', 23, '20-23', '19-23', 'MR-Jr', 82.9, '83']...\r\nRow 4: ['Austin Keanu', 'M', 'SBD', 'Raw', 63, '60-64', '60-69', 'MR-M3', 122.4, '120+']...\r\n\r\nTotal rows: 21\r\nTotal columns: 25\r\n"]
[39.911293, "o", "\u001b[?2004hroot@1ca98a19ba89:~# "]
[67.523045, "i", "cat > process_dots.py << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\n\n# Get the sheets\ndata_sheet = wb['Data']\ndots_sheet = wb['Dots']\n\n# Clear the Dots sheet if it has any content\ndots_sheet.delete_rows(1, dots_sheet.max_row)\n\n# Step 1: Copy relevant columns to Dots sheet\n# Columns needed: Name (1), Sex (2), BodyweightKg (9), Best3SquatKg (11), Best3BenchKg (12), Best3DeadliftKg (13)\nsource_columns = [1, 2, 9, 11, 12, 13]  # Column indices in Data sheet\n\n# Copy headers first\nfor dest_col, src_col in enumerate(source_columns, 1):\n    header_value = data_sheet.cell(row=1, column=src_col).value\n    dots_sheet.cell(row=1, column=dest_col, value=header_value)\n\n# Copy data rows\nfor row_idx in range(2, data_sheet.max_row + 1):\n    for dest_col, src_col in enumerate(source_columns, 1):\n        value = data_sheet.cell(row=row_idx, column=src_col).value\n        dots_sheet.cell(row=row_idx, column=dest_col, value=value)\n\nprint(f\"Copied {data_sheet.max_row - 1} rows of data\")\nprint(f\"Columns copied: Name, Sex, BodyweightKg, Best3SquatKg, Best3BenchKg, Best3DeadliftKg\")\n\n# Step 2: Add TotalKg column header and formulas\ntotal_col = len(source_columns) + 1  # Column 7\ndots_sheet.cell(row=1, column=total_col, value=\"TotalKg\")\n\n# Add formula for each row: =ROUND(D2+E2+F2, 3)\nfor row_idx in range(2, data_sheet.max_row + 1):\n    formula = f\"=ROUND(D{row_idx}+E{row_idx}+F{row_idx},3)\"\n    dots_sheet.cell(row=row_idx, column=total_col, value=formula)\n\nprint(f\"Added TotalKg column with formulas\")\n\n# Step 3: Add Dots column header and formulas\ndots_col = total_col + 1  # Column 8\ndots_sheet.cell(row=1, column=dots_col, value=\"Dots\")\n\n# Dots formula constants\n# Men: A=-307.75076, B=24.0900756, C=-0.1918759221, D=0.0007391293, E=-0.000001093\n# Women: A=-57.96288, B=13.6175032, C=-0.1126655495, D=0.0005158568, E=-0.0000010706\n\n# Add Dots formula for each row\nfor row_idx in range(2, data_sheet.max_row + 1):\n    # Formula: ROUND(IF(B{row}=\"M\", 500/((-307.75076)+(24.0900756)*C{row}+(-0.1918759221)*C{row}^2+(0.0007391293)*C{row}^3+(-0.000001093)*C{row}^4)*G{row}, 500/((-57.96288)+(13.6175032)*C{row}+(-0.1126655495)*C{row}^2+(0.0005158568)*C{row}^3+(-0.0000010706)*C{row}^4)*G{row}), 3)\n    \n    # Men's formula component\n    men_denom = f\"((-307.75076)+(24.0900756)*C{row_idx}+(-0.1918759221)*C{row_idx}^2+(0.0007391293)*C{row_idx}^3+(-0.000001093)*C{row_idx}^4)\"\n    men_formula = f\"500/{men_denom}*G{row_idx}\"\n    \n    # Women's formula component  \n    women_denom = f\"((-57.96288)+(13.6175032)*C{row_idx}+(-0.1126655495)*C{row_idx}^2+(0.0005158568)*C{row_idx}^3+(-0.0000010706)*C{row_idx}^4)\"\n    women_formula = f\"500/{women_denom}*G{row_idx}\"\n    \n    # Combined IF formula with ROUND\n    formula = f'=ROUND(IF(B{row_idx}=\"M\",{men_formula},{women_formula}),3)'\n    \n    dots_sheet.cell(row=row_idx, column=dots_col, value=formula)\n\nprint(f\"Added Dots column with formulas\")\n\n# Save the workbook\nwb.save('/root/data/openipf.xlsx')\nprint(\"\\nWorkbook saved successfully!\")\n\nwb.close()\nEOF\n"]
