[39.896575, "o", "\r\nHeaders in Data sheet:\r\nColumn 1: Name\r\nColumn 2: Sex\r\nColumn 3: Event\r\nColumn 4: Equipment\r\nColumn 5: Age\r\nColumn 6: AgeClass\r\nColumn 7: BirthYearClass\r\nColumn 8: Division\r\nColumn 9: BodyweightKg\r\nColumn 10: WeightClassKg\r\nColumn 11: Best3SquatKg\r\nColumn 12: Best3BenchKg\r\nColumn 13: Best3DeadliftKg\r\nColumn 14: Place\r\nColumn 15: Tested\r\nColumn 16: Country\r\n"]
