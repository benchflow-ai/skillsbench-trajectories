[112.06652, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.066573, "o", "    # Calculate TotalKg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.066748, "o", "    if squat is not None and bench is not None and deadlift is not None:\r\n\u001b[?2004l\r"]
[112.066797, "o", "\u001b[?2004h> "]
[112.066919, "o", "        total_kg = round(squat + bench + deadlift, 3)\r\n\u001b[?2004l\r"]
[112.06697, "o", "\u001b[?2004h> "]
[112.066998, "o", "    else:\r\n\u001b[?2004l\r"]
[112.067064, "o", "\u001b[?2004h> "]
[112.067109, "o", "        total_kg = None\r\n\u001b[?2004l\r"]
[112.067158, "o", "\u001b[?2004h> "]
[112.067214, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.067269, "o", "    # Calculate Dots\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.067443, "o", "    dots_score = calculate_dots(sex, bw, total_kg) if total_kg else None\r\n\u001b[?2004l\r"]
[112.067498, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.067545, "o", "\u001b[?2004h> "]
[112.067591, "o", "    # Format output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.067704, "o", "    name_str = str(name)[:25] if name else \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.067756, "o", "> "]
[112.067815, "o", "    sex_str = str(sex) if sex else \"\"\r\n\u001b[?2004l\r"]
[112.067869, "o", "\u001b[?2004h> "]
[112.067983, "o", "    bw_str = f\"{bw:.2f}\" if bw else \"N/A\"\r\n\u001b[?2004l\r"]
[112.068026, "o", "\u001b[?2004h> "]
[112.068152, "o", "    squat_str = f\"{squat:.1f}\" if squat else \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.068205, "o", "> "]
[112.068302, "o", "    bench_str = f\"{bench:.1f}\" if bench else \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.068348, "o", "> "]
[112.068465, "o", "    dl_str = f\"{deadlift:.1f}\" if deadlift else \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.068517, "o", "> "]
[112.06863, "o", "    total_str = f\"{total_kg:.3f}\" if total_kg else \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.068678, "o", "> "]
[112.068798, "o", "    dots_str = f\"{dots_score:.3f}\" if dots_score else \"N/A\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.068851, "o", ">     \r\n\u001b[?2004l\r"]
[112.068904, "o", "\u001b[?2004h> "]
[112.069176, "o", "    print(f\"{name_str:<25} {sex_str:<5} {bw_str:<8} {squat_str:<8} {bench_str:<8} {dl_str:<8} {total_str:<10} {dots_str:<10}\")\r\n\u001b[?2004l\r"]
[112.069202, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.069261, "o", "\u001b[?2004h> "]
[112.069334, "o", "print(\"\\n\" + \"=\" * 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.069389, "o", "> "]
[112.069429, "o", "print(\"VERIFICATION COMPLETE\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.069479, "o", "print(\"=\" * 100)\r\n\u001b[?2004l\r"]
[112.069527, "o", "\u001b[?2004h> "]
[112.069588, "o", "print(\"\\nSummary:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.069716, "o", "print(f\"- Total lifters processed: {dots_sheet.max_row - 1}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.069762, "o", "> "]
[112.06988, "o", "print(f\"- Columns in Dots sheet: {dots_sheet.max_column}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.070155, "o", "print(f\"- Column headers: Name, Sex, BodyweightKg, Best3SquatKg, Best3BenchKg, Best3DeadliftKg, TotalKg, Dots\")\r\n\u001b[?2004l\r"]
[112.070204, "o", "\u001b[?2004h> "]
[112.070318, "o", "print(f\"- TotalKg formula: =ROUND(D[row]+E[row]+F[row],3)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.070367, "o", "> "]
[112.070574, "o", "print(f\"- Dots formula: Uses IF statement to apply different coefficients for Men and Women\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.070622, "o", "> "]
[112.070761, "o", "print(f\"- All calculations rounded to 3 decimal places as required\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.070808, "o", "> "]
[112.07094, "o", "print(\"\\nThe Excel file has been successfully updated with formulas.\")\r\n\u001b[?2004l\r"]
[112.07099, "o", "\u001b[?2004h> "]
