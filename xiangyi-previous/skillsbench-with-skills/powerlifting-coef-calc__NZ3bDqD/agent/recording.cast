[171.496175, "i", "cat > final_check.py << 'EOF'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\n\nprint(\"=\" * 80)\nprint(\"COMPREHENSIVE FINAL CHECK\")\nprint(\"=\" * 80)\n\n# Check both sheets exist\nprint(f\"\\nSheets in workbook: {wb.sheetnames}\")\nassert 'Data' in wb.sheetnames, \"Data sheet missing!\"\nassert 'Dots' in wb.sheetnames, \"Dots sheet missing!\"\nprint(\"✓ Both sheets present\")\n\n# Check Data sheet\ndata_sheet = wb['Data']\nprint(f\"\\nData sheet: {data_sheet.max_row} rows, {data_sheet.max_column} columns\")\n\n# Check Dots sheet structure\ndots_sheet = wb['Dots']\nprint(f\"\\nDots sheet: {dots_sheet.max_row} rows, {dots_sheet.max_column} columns\")\n\n# Verify headers\nexpected_headers = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg', 'TotalKg', 'Dots']\nactual_headers = [dots_sheet.cell(1, i).value for i in range(1, 9)]\n\nprint(\"\\nHeader verification:\")\nfor i, (expected, actual) in enumerate(zip(expected_headers, actual_headers), 1):\n    match = \"✓\" if expected == actual else \"✗\"\n    print(f\"  {match} Column {i}: Expected '{expected}', Got '{actual}'\")\n\nassert actual_headers == expected_headers, f\"Headers mismatch! Expected {expected_headers}, got {actual_headers}\"\nprint(\"✓ All headers correct\")\n\n# Verify formulas in a few rows\nprint(\"\\nFormula verification:\")\nfor row in [2, 10, 21]:\n    total_formula = dots_sheet.cell(row, 7).value\n    dots_formula = dots_sheet.cell(row, 8).value\n    \n    # Check TotalKg formula\n    assert total_formula.startswith('=ROUND('), f\"Row {row}: TotalKg formula doesn't start with =ROUND(\"\n    assert f'D{row}+E{row}+F{row}' in total_formula, f\"Row {row}: TotalKg formula missing correct cell references\"\n    assert ',3)' in total_formula, f\"Row {row}: TotalKg formula missing 3 decimal precision\"\n    \n    # Check Dots formula\n    assert dots_formula.startswith('=ROUND(IF('), f\"Row {row}: Dots formula doesn't start with =ROUND(IF(\"\n    assert f'B{row}=\"M\"' in dots_formula, f\"Row {row}: Dots formula missing sex check\"\n    assert '(-307.75076)' in dots_formula, f\"Row {row}: Dots formula missing men's A coefficient\"\n    assert '(-57.96288)' in dots_formula, f\"Row {row}: Dots formula missing women's A coefficient\"\n    assert f'C{row}' in dots_formula, f\"Row {row}: Dots formula missing bodyweight reference\"\n    assert f'G{row}' in dots_formula, f\"Row {row}: Dots formula missing total reference\"\n    assert ',3)' in dots_formula, f\"Row {row}: Dots formula missing 3 decimal precision\"\n    \n    print(f\"  ✓ Row {row}: Both formulas correct\")\n\nprint(\"✓ All formulas verified\")\n\n# Verify data integrity\nprint(\"\\nData integrity check:\")\nfor row in range(2, dots_sheet.max_row + 1):\n    name = dots_sheet.cell(row, 1).value\n    sex = dots_sheet.cell(row, 2).value\n    \n    assert name is not None, f\"Row {row}: Name is missing\"\n    assert sex in ['M', 'F'], f\"Row {row}: Sex must be M or F, got {sex}\"\n\nprint(f\"✓ All {dots_sheet.max_row - 1} lifters have valid data\")\n\n# Count men vs women\nmen_count = sum(1 for row in range(2, dots_sheet.max_row + 1) if dots_sheet.cell(row, 2).value == 'M')\nwomen_count = sum(1 for row in range(2, dots_sheet.max_row + 1) if dots_sheet.cell(row, 2).value == 'F')\nprint(f\"  - Men: {men_count}\")\nprint(f\"  - Women: {women_count}\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"FINAL VERIFICATION RESULT: ALL CHECKS PASSED ✓\")\nprint(\"=\" * 80)\nprint(\"\\nTask Summary:\")\nprint(\"1. ✓ Copied 6 required columns from Data to Dots sheet\")\nprint(\"2. ✓ Added TotalKg column with Excel formula (3 decimal precision)\")\nprint(\"3. ✓ Added Dots column with Excel formula (3 decimal precision)\")\nprint(\"4. ✓ All formulas use proper coefficients for Men and Women\")\nprint(\"5. ✓ Column names and order preserved from Data sheet\")\nprint(f\"6. ✓ Processed all {dots_sheet.max_row - 1} lifters\")\nprint(\"\\nThe Excel file is ready for use!\")\n\nwb.close()\nEOF\n"]
