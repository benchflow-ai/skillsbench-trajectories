[87.794998, "i", "python3 verify_dots.py\n"]
[87.795405, "o", "python3 verify_dots.py\r\n\u001b[?2004l\r"]
[87.921732, "o", "================================================================================\r\nDOTS SHEET VERIFICATION\r\n================================================================================\r\n\r\nHeaders:\r\nColumn 1: Name\r\nColumn 2: Sex\r\nColumn 3: BodyweightKg\r\nColumn 4: Best3SquatKg\r\nColumn 5: Best3BenchKg\r\nColumn 6: Best3DeadliftKg\r\nColumn 7: TotalKg\r\nColumn 8: Dots\r\n\r\nTotal rows (including header): 21\r\nTotal columns: 8\r\n\r\n================================================================================\r\nSAMPLE FORMULAS\r\n================================================================================\r\n"]
[87.921829, "o", "\r\nRow 2: Julien Comte (M, 82.25kg)\r\n  TotalKg formula: =ROUND(D2+E2+F2,3)\r\n  Dots formula: =ROUND(IF(B2=\"M\",500/((-307.75076)+(24.0900756)*C2+(-0.1918759221)*C2^2+(0.0007391293)*C2^3+(-0.000001093)*C2^4)*G2,500/((-57.96288)+(13.6175032)*C2+(...\r\n\r\nRow 3: Matthew Starkey (M, 82.9kg)\r\n  TotalKg formula: =ROUND(D3+E3+F3,3)\r\n  Dots formula: =ROUND(IF(B3=\"M\",500/((-307.75076)+(24.0900756)*C3+(-0.1918759221)*C3^2+(0.0007391293)*C3^3+(-0.000001093)*C3^4)*G3,500/((-57.96288)+(13.6175032)*C3+(...\r\n\r\nRow 4: Austin Keanu (M, 122.4kg)\r\n  TotalKg formula: =ROUND(D4+E4+F4,3)\r\n  Dots formula: =ROUND(IF(B4=\"M\",500/((-307.75076)+(24.0900756)*C4+(-0.1918759221)*C4^2+(0.0007391293)*C4^3+(-0.000001093)*C4^4)*G4,500/((-57.96288)+(13.6175032)*C4+(...\r\n\r\n================================================================================\r\nCALCULATED VALUES (after formulas evaluate)\r\n================================================================================\r\n"]
[87.931636, "o", "\r\nName                 Sex   BW(kg)   Squat    Bench    DL       Total    Dots    \r\n-------------------------------------------------------------------------------------\r\nJulien Comte         M     82.25    215      132.5    260                       \r\nMatthew Starkey      M     82.9     205      130      227.5                     \r\nAustin Keanu         M     122.4    275      142.5    235                       \r\n"]
[87.931708, "o", "Michelle McKeaveney  F     96.8     102.5    50       137.5                     \r\nTracy Klinger        F     130.82   62.5     57.5     117.5                     \r\n\r\n================================================================================\r\nNote: Calculated values will show as None until Excel evaluates the formulas.\r\nThe formulas are correctly inserted and will calculate when opened in Excel.\r\n================================================================================\r\n"]
[87.951705, "o", "\u001b[?2004hroot@1ca98a19ba89:~# "]
[112.060475, "i", "cat > final_verification.py << 'EOF'\nimport openpyxl\nimport math\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\ndots_sheet = wb['Dots']\n\nprint(\"=\" * 100)\nprint(\"FINAL VERIFICATION - MANUAL CALCULATION OF DOTS SCORES\")\nprint(\"=\" * 100)\n\n# Dots coefficients\nMEN_COEFFS = {\n    'A': -307.75076,\n    'B': 24.0900756,\n    'C': -0.1918759221,\n    'D': 0.0007391293,\n    'E': -0.000001093\n}\n\nWOMEN_COEFFS = {\n    'A': -57.96288,\n    'B': 13.6175032,\n    'C': -0.1126655495,\n    'D': 0.0005158568,\n    'E': -0.0000010706\n}\n\ndef calculate_dots(sex, bodyweight_kg, total_kg):\n    \"\"\"Calculate Dots score with 3 decimal precision\"\"\"\n    if not bodyweight_kg or not total_kg:\n        return None\n    \n    coeffs = MEN_COEFFS if sex == 'M' else WOMEN_COEFFS\n    \n    bw = bodyweight_kg\n    denominator = (coeffs['A'] + \n                   coeffs['B'] * bw + \n                   coeffs['C'] * bw**2 + \n                   coeffs['D'] * bw**3 + \n                   coeffs['E'] * bw**4)\n    \n    dots = (500 / denominator) * total_kg\n    return round(dots, 3)\n\nprint(f\"\\n{'Name':<25} {'Sex':<5} {'BW':<8} {'Squat':<8} {'Bench':<8} {'DL':<8} {'Total':<10} {'Dots':<10}\")\nprint(\"-\" * 100)\n\nfor row_idx in range(2, dots_sheet.max_row + 1):\n    name = dots_sheet.cell(row=row_idx, column=1).value\n    sex = dots_sheet.cell(row=row_idx, column=2).value\n    bw = dots_sheet.cell(row=row_idx, column=3).value\n    squat = dots_sheet.cell(row=row_idx, column=4).value\n    bench = dots_sheet.cell(row=row_idx, column=5).value\n    deadlift = dots_sheet.cell(row=row_idx, column=6).value\n    \n    # Calculate TotalKg\n    if squat is not None and bench is not None and deadlift is not None:\n        total_kg = round(squat + bench + deadlift, 3)\n    else:\n        total_kg = None\n    \n    # Calculate Dots\n    dots_score = calculate_dots(sex, bw, total_kg) if total_kg else None\n    \n    # Format output\n    name_str = str(name)[:25] if name else \"\"\n    sex_str = str(sex) if sex else \"\"\n    bw_str = f\"{bw:.2f}\" if bw else \"N/A\"\n    squat_str = f\"{squat:.1f}\" if squat else \"N/A\"\n    bench_str = f\"{bench:.1f}\" if bench else \"N/A\"\n    dl_str = f\"{deadlift:.1f}\" if deadlift else \"N/A\"\n    total_str = f\"{total_kg:.3f}\" if total_kg else \"N/A\"\n    dots_str = f\"{dots_score:.3f}\" if dots_score else \"N/A\"\n    \n    print(f\"{name_str:<25} {sex_str:<5} {bw_str:<8} {squat_str:<8} {bench_str:<8} {dl_str:<8} {total_str:<10} {dots_str:<10}\")\n\nprint(\"\\n\" + \"=\" * 100)\nprint(\"VERIFICATION COMPLETE\")\nprint(\"=\" * 100)\nprint(\"\\nSummary:\")\nprint(f\"- Total lifters processed: {dots_sheet.max_row - 1}\")\nprint(f\"- Columns in Dots sheet: {dots_sheet.max_column}\")\nprint(f\"- Column headers: Name, Sex, BodyweightKg, Best3SquatKg, Best3BenchKg, Best3DeadliftKg, TotalKg, Dots\")\nprint(f\"- TotalKg formula: =ROUND(D[row]+E[row]+F[row],3)\")\nprint(f\"- Dots formula: Uses IF statement to apply different coefficients for Men and Women\")\nprint(f\"- All calculations rounded to 3 decimal places as required\")\nprint(\"\\nThe Excel file has been successfully updated with formulas.\")\nprint(\"When opened in Excel, all formulas will automatically calculate.\")\n\nwb.close()\nEOF\n"]
