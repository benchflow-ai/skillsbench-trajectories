[30.935811, "o", "-rw-r--r-- 1 root root 8.9K Jan 25 20:43 data-readme.md\r\n-rw-r--r-- 1 root root  11K Jan 25 20:43 openipf.xlsx\r\n"]
[30.935961, "o", "\u001b[?2004hroot@1ca98a19ba89:~# "]
[39.642573, "i", "cat > examine_excel.py << 'EOF'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/data/openipf.xlsx')\n\n# Check sheet names\nprint(\"Sheet names:\", wb.sheetnames)\n\n# Load Data sheet\ndata_sheet = wb['Data']\n\n# Get headers (first row)\nheaders = []\nfor cell in data_sheet[1]:\n    headers.append(cell.value)\n\nprint(\"\\nHeaders in Data sheet:\")\nfor i, header in enumerate(headers, 1):\n    print(f\"Column {i}: {header}\")\n\n# Show first few rows\nprint(\"\\nFirst 3 data rows:\")\nfor row_idx in range(2, min(5, data_sheet.max_row + 1)):\n    row_data = [cell.value for cell in data_sheet[row_idx]]\n    print(f\"Row {row_idx}: {row_data[:10]}...\")  # Show first 10 columns\n\nprint(f\"\\nTotal rows: {data_sheet.max_row}\")\nprint(f\"Total columns: {data_sheet.max_column}\")\n\nwb.close()\nEOF\n"]
