[?2004hroot@1ca98a19ba89:~# cat > verify_dots.py << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Get the Dots sheet
[?2004l[?2004h> dots_sheet = wb['Dots']
[?2004l[?2004h> 
[?2004l[?2004h> print("=" * 80)
[?2004l[?2004h> print("DOTS SHEET VERIFICATION")
[?2004l[?2004h> print("=" * 80)
[?2004l[?2004h> 
[?2004l[?2004h> # Display headers
[?2004l[?2004h> print("\nHeaders:")
[?2004l[?2004h> headers = []
[?2004l[?2004h> for col_idx in range(1, 9):
[?2004l[?2004h>     header = dots_sheet.cell(row=1, column=col_idx).value
[?2004l[?2004h>     headers.append(header)
