[?2004l[?2004h>                    coeffs['B'] * bw + 
[?2004l[?2004h>                    coeffs['C'] * bw**2 + 
[?2004l[?2004h>                    coeffs['D'] * bw**3 + 
[?2004l[?2004h>                    coeffs['E'] * bw**4)
[?2004l[?2004h>     
[?2004l[?2004h>     dots = (500 / denominator) * total_kg
[?2004l[?2004h>     return round(dots, 3)
