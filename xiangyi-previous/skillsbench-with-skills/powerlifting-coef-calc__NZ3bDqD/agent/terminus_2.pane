[?2004hroot@1ca98a19ba89:~# cat > process_dots.py << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Get the sheets
[?2004l[?2004h> data_sheet = wb['Data']
[?2004l[?2004h> dots_sheet = wb['Dots']
[?2004l[?2004h> 
[?2004l[?2004h> # Clear the Dots sheet if it has any content
[?2004l[?2004h> dots_sheet.delete_rows(1, dots_sheet.max_row)
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Copy relevant columns to Dots sheet
[?2004l[?2004h> # Columns needed: Name (1), Sex (2), BodyweightKg (9), Best3SquatKg (11), Best3BenchKg (12), Best3DeadliftKg (13)
[?2004l[?2004h> source_columns = [1, 2, 9, 11, 12, 13]  # Column indices in Data sheet
[?2004l[?2004h> 
[?2004l[?2004h> # Copy headers first
[?2004l[?2004h> for dest_col, src_col in enumerate(source_columns, 1):
[?2004l[?2004h>     header_value = data_sheet.cell(row=1, column=src_col).value
[?2004l[?2004h>     dots_sheet.cell(row=1, column=dest_col, value=header_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Copy data rows
[?2004l[?2004h> for row_idx in range(2, data_sheet.max_row + 1):
[?2004l[?2004h>     for dest_col, src_col in enumerate(source_columns, 1):
[?2004l[?2004h>         value = data_sheet.cell(row=row_idx, column=src_col).value
[?2004l[?2004h>         dots_sheet.cell(row=row_idx, column=dest_col, value=value)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Copied {data_sheet.max_row - 1} rows of data")
[?2004l[?2004h> print(f"Columns copied: Name, Sex, BodyweightKg, Best3SquatKg, Best3BenchKg, Best3DeadliftKg")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Add TotalKg column header and formulas
[?2004l[?2004h> total_col = len(source_columns) + 1  # Column 7
[?2004l[?2004h> dots_sheet.cell(row=1, column=total_col, value="TotalKg")
[?2004l[?2004h> 
[?2004l[?2004h> # Add formula for each row: =ROUND(D2+E2+F2, 3)
[?2004l[?2004h> for row_idx in range(2, data_sheet.max_row + 1):
[?2004l[?2004h>     formula = f"=ROUND(D{row_idx}+E{row_idx}+F{row_idx},3)"
[?2004l[?2004h>     dots_sheet.cell(row=row_idx, column=total_col, value=formula)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Added TotalKg column with formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Add Dots column header and formulas
[?2004l[?2004h> dots_col = total_col + 1  # Column 8
[?2004l[?2004h> dots_sheet.cell(row=1, column=dots_col, value="Dots")
[?2004l[?2004h> 
[?2004l[?2004h> # Dots formula constants
[?2004l[?2004h> # Men: A=-307.75076, B=24.0900756, C=-0.1918759221, D=0.0007391293, E=-0.000001093
[?2004l[?2004h> # Women: A=-57.96288, B=13.6175032, C=-0.1126655495, D=0.0005158568, E=-0.0000010706
[?2004l[?2004h> 
[?2004l[?2004h> # Add Dots formula for each row
[?2004l[?2004h> for row_idx in range(2, data_sheet.max_row + 1):
[?2004l[?2004h>     # Formula: ROUND(IF(B{row}="M", 500/((-307.75076)+(24.0900756)*C{row}+(-0.1918759221)*C{row}^2+(0.0007391293)*C{row}^3+(-0.000001093)*C{row}^4)*G{row}, 500/((-57.96288)+(13.6175032)*C{row}+(-0.1126655495)*C{row}^2+(0.0005158568)*C{row}^3+(-0.0000010706)*C{row}^4)*G{row}), 3)
[?2004l[?2004h>     
[?2004l[?2004h>     # Men's formula component
[?2004l[?2004h>     men_denom = f"((-307.75076)+(24.0900756)*C{row_idx}+(-0.1918759221)*C{row_idx}^2+(0.0007391293)*C{row_idx}^3+(-0.000001093)*C{row_idx}^4)"
[?2004l[?2004h>     men_formula = f"500/{men_denom}*G{row_idx}"
[?2004l[?2004h>     
[?2004l[?2004h>     # Women's formula component  
[?2004l[?2004h>     women_denom = f"((-57.96288)+(13.6175032)*C{row_idx}+(-0.1126655495)*C{row_idx}^2+(0.0005158568)*C{row_idx}^3+(-0.0000010706)*C{row_idx}^4)"
[?2004l[?2004h>     women_formula = f"500/{women_denom}*G{row_idx}"
[?2004l[?2004h>     
[?2004l[?2004h>     # Combined IF formula with ROUND
[?2004l[?2004h>     formula = f'=ROUND(IF(B{row_idx}="M",{men_formula},{women_formula}),3)'
[?2004l[?2004h>     
[?2004l[?2004h>     dots_sheet.cell(row=row_idx, column=dots_col, value=formula)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Added Dots column with formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the workbook
[?2004l[?2004h> wb.save('/root/data/openipf.xlsx')
[?2004l[?2004h> print("\nWorkbook saved successfully!")
[?2004l[?2004h> 
[?2004l[?2004h> wb.close()
[?2004l[?2004h> EOF
