[?2004l[?2004h> def calculate_dots(sex, bodyweight_kg, total_kg):
[?2004l[?2004h>     """Calculate Dots score with 3 decimal precision"""
[?2004l[?2004h>     if not bodyweight_kg or not total_kg:
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     coeffs = MEN_COEFFS if sex == 'M' else WOMEN_COEFFS
[?2004l[?2004h>     
[?2004l[?2004h>     bw = bodyweight_kg
