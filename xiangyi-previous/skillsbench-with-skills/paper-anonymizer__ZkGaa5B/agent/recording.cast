[16.021997, "o", "Title:           Voice Evaluation of Reasoning Ability: Diagnosing the Modality-Induced Performance Gap\r\nAuthor:          Yueqian Lin; Zhengmian Hu; Qinsi Wang; Yudong Liu; Hengfan Zhang; Jayakumar Subramanian; Nikos Vlassis; Hai Helen Li; Yiran Chen\r\nCreator:         arXiv GenPDF (tex2pdf:)\r\nProducer:        pikepdf 8.15.1\r\nCustom Metadata: yes\r\nMetadata Stream: yes\r\nTagged:          no\r\n"]
