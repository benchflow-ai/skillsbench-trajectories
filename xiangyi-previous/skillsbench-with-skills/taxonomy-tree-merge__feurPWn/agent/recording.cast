[186.061646, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\nprint(\"Fixing NaN values in output files...\")\n\n# Fix unified_taxonomy_full.csv\ndf_full = pd.read_csv('/root/output/unified_taxonomy_full.csv')\nfor col in ['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']:\n    df_full[col] = df_full[col].fillna('')\ndf_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\nprint(\"Fixed unified_taxonomy_full.csv\")\n\n# Fix unified_taxonomy_hierarchy.csv\ndf_hier = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\nfor col in ['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']:\n    df_hier[col] = df_hier[col].fillna('')\ndf_hier.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\nprint(\"Fixed unified_taxonomy_hierarchy.csv\")\n\nprint(\"\\nVerifying fix...\")\nprint(\"Sample rows from unified_taxonomy_full.csv:\")\nprint(df_full[['source', 'depth', 'unified_level_1', 'unified_level_2', 'unified_level_3']].head(10))\nEOF\n"]
