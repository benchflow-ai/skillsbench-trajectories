[82.50817, "i", "cat > /root/unify_taxonomy.py << 'EOF'\nimport pandas as pd\nimport re\nfrom collections import defaultdict, Counter\nimport csv\n\ndef normalize_text(text):\n    if pd.isna(text): return \"\"\n    text = str(text).lower().strip()\n    text = re.sub(r'[&\\-_/]+', ' ', text)\n    text = re.sub(r'\\s+', ' ', text)\n    return text.strip()\n\ndef parse_path(path):\n    if pd.isna(path): return []\n    path = str(path).strip('\"').strip(\"'\")\n    levels = [level.strip() for level in path.split('>')]\n    return [l for l in levels if l]\n\ndef extract_words(text):\n    words = set(normalize_text(text).split())\n    stop_words = {'and', 'or', 'the', 'a', 'an', 'for', 'of', 'in', 'on', 'at', 'to', 'with', 'by'}\n    return words - stop_words\n\ndef word_overlap(t1, t2):\n    w1, w2 = extract_words(t1), extract_words(t2)\n    if not w1 or not w2: return 0.0\n    return len(w1 & w2) / len(w1 | w2)\n\ndef make_name(names, max_words=4):\n    word_freq = Counter()\n    for name in names[:100]:\n        word_freq.update(extract_words(name))\n    common = [w for w, _ in word_freq.most_common(max_words) if len(w) > 2]\n    if common:\n        return ' | '.join(common[:max_words])\n    if names:\n        words = names[0].split()[:max_words]\n        return ' | '.join(words)\n    return 'general'\n\nprint(\"Loading data...\")\namazon = pd.read_csv('/root/data/amazon_product_categories.csv')\namazon['source'] = 'amazon'\nfb = pd.read_csv('/root/data/fb_product_categories.csv')\nfb['source'] = 'facebook'\ngoogle = pd.read_csv('/root/data/google_shopping_product_categories.csv')\ngoogle['source'] = 'google'\n\nall_data = []\nfor df in [amazon, fb, google]:\n    src = df['source'].iloc[0]\n    for _, row in df.iterrows():\n        path = parse_path(row['category_path'])\n        if path:\n            all_data.append({'source': src, 'original': row['category_path'], 'path': path})\n\nprint(f\"Total paths: {len(all_data)}\")\nEOF\n"]
