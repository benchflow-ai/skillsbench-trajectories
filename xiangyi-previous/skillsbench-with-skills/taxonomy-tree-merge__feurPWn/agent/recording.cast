[201.556269, "i", "python3 << 'EOF'\nimport pandas as pd\n\ndf_full = pd.read_csv('/root/output/unified_taxonomy_full.csv')\ndf_hier = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\n\nprint(\"=== FINAL VERIFICATION ===\")\nprint(\"\\n1. Level 1 Categories (should be 10-20):\")\nlevel1_cats = df_full['unified_level_1'].unique()\nprint(f\"Total: {len(level1_cats)} ✓\")\n\nprint(\"\\n2. Source Distribution (should be relatively even):\")\nfor source in ['amazon', 'facebook', 'google']:\n    count = len(df_full[df_full['source'] == source])\n    pct = count / len(df_full) * 100\n    print(f\"  {source:10s}: {count:5d} ({pct:5.1f}%)\")\n\nprint(\"\\n3. Sample Level 2 counts per Level 1 (should be 3-20):\")\nfor l1 in sorted(level1_cats)[:5]:\n    l2_count = len(df_hier[(df_hier['unified_level_1'] == l1) & (df_hier['unified_level_2'] != '')]['unified_level_2'].unique())\n    print(f\"  {l1:40s}: {l2_count:2d} subcategories\")\n\nprint(\"\\n4. Example Mappings:\")\nprint(\"\\nAMAZON Examples:\")\nfor _, row in df_full[df_full['source'] == 'amazon'].head(3).iterrows():\n    print(f\"  Original: {row['category_path'][:70]}\")\n    unified = ' > '.join([row[f'unified_level_{i}'] for i in range(1, 6) if row[f'unified_level_{i}']])\n    print(f\"  Unified:  {unified}\")\n    print()\n\nprint(\"FACEBOOK Examples:\")\nfor _, row in df_full[df_full['source'] == 'facebook'].head(3).iterrows():\n    print(f\"  Original: {row['category_path'][:70]}\")\n    unified = ' > '.join([row[f'unified_level_{i}'] for i in range(1, 6) if row[f'unified_level_{i}']])\n    print(f\"  Unified:  {unified}\")\n    print()\n\nprint(\"GOOGLE Examples:\")\nfor _, row in df_full[df_full['source'] == 'google'].head(3).iterrows():\n    print(f\"  Original: {row['category_path'][:70]}\")\n    unified = ' > '.join([row[f'unified_level_{i}'] for i in range(1, 6) if row[f'unified_level_{i}']])\n    print(f\"  Unified:  {unified}\")\n    print()\nEOF\n"]
