[170.137365, "i", "python3 << 'EOF'\nimport pandas as pd\n\ndf_full = pd.read_csv('/root/output/unified_taxonomy_full.csv')\ndf_hier = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\n\nprint(\"=== UNIFIED TAXONOMY VERIFICATION ===\")\nprint(\"\\n1. Source Distribution:\")\nprint(df_full['source'].value_counts())\n\nprint(\"\\n2. Depth Distribution:\")\nprint(df_full['depth'].value_counts().sort_index())\n\nprint(\"\\n3. Level 1 Categories:\")\nlevel1_cats = df_full['unified_level_1'].unique()\nprint(f\"Total: {len(level1_cats)}\")\nfor i, cat in enumerate(sorted(level1_cats), 1):\n    count = len(df_full[df_full['unified_level_1'] == cat])\n    sources = df_full[df_full['unified_level_1'] == cat]['source'].unique()\n    print(f\"{i:2d}. {cat:40s} - {count:5d} items, sources: {', '.join(sources)}\")\n\nprint(\"\\n4. Hierarchy Statistics:\")\nprint(f\"Total unique paths: {len(df_hier)}\")\nfor level in range(1, 6):\n    col = f'unified_level_{level}'\n    non_empty = df_hier[df_hier[col] != ''][col].nunique()\n    print(f\"Level {level}: {non_empty} unique categories\")\n\nprint(\"\\n5. Sample Mappings by Source:\")\nfor source in ['amazon', 'facebook', 'google']:\n    print(f\"\\n{source.upper()}:\")\n    sample = df_full[df_full['source'] == source].head(3)\n    for _, row in sample.iterrows():\n        print(f\"  Original: {row['category_path'][:80]}...\")\n        unified = ' > '.join([row[f'unified_level_{i}'] for i in range(1, 6) if row[f'unified_level_{i}']])\n        print(f\"  Unified:  {unified}\")\n        print()\nEOF\n"]
