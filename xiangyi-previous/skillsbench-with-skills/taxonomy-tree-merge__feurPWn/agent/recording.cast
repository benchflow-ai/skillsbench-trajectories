[128.709604, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Create mapping for all original paths\nprint(\"Creating mappings...\")\nmappings = []\n\ndef find_best_match(item, taxonomy):\n    \"\"\"Find best unified category match for an item\"\"\"\n    path = item['path']\n    \n    # Find level 1\n    best_l1 = None\n    best_score = 0\n    for l1 in taxonomy.keys():\n        score = word_overlap(path[0], l1)\n        if score > best_score:\n            best_score = score\n            best_l1 = l1\n    \n    if not best_l1:\n        best_l1 = list(taxonomy.keys())[0]\n    \n    result = [best_l1, '', '', '', '']\n    \n    if len(path) >= 2 and taxonomy[best_l1]:\n        best_l2 = max(taxonomy[best_l1].keys(), \n                      key=lambda x: word_overlap(path[1], x), default=None)\n        if best_l2:\n            result[1] = best_l2\n            \n            if len(path) >= 3 and taxonomy[best_l1][best_l2]:\n                best_l3 = max(taxonomy[best_l1][best_l2].keys(),\n                             key=lambda x: word_overlap(path[2], x), default=None)\n                if best_l3:\n                    result[2] = best_l3\n                    \n                    if len(path) >= 4 and taxonomy[best_l1][best_l2][best_l3]:\n                        best_l4 = max(taxonomy[best_l1][best_l2][best_l3].keys(),\n                                     key=lambda x: word_overlap(path[3], x), default=None)\n                        if best_l4:\n                            result[3] = best_l4\n                            \n                            if len(path) >= 5 and taxonomy[best_l1][best_l2][best_l3][best_l4]:\n                                best_l5 = max(taxonomy[best_l1][best_l2][best_l3][best_l4].keys(),\n                                             key=lambda x: word_overlap(path[4], x), default=None)\n                                if best_l5:\n                                    result[4] = best_l5\n    \n    return result\n\nfor item in all_data:\n    unified = find_best_match(item, taxonomy)\n    depth = len([x for x in unified if x])\n    \n    mappings.append({\n        'source': item['source'],\n        'category_path': item['original'],\n        'depth': depth,\n        'unified_level_1': unified[0],\n        'unified_level_2': unified[1],\n        'unified_level_3': unified[2],\n        'unified_level_4': unified[3],\n        'unified_level_5': unified[4]\n    })\n\nprint(f\"Created {len(mappings)} mappings\")\n\n# Write unified_taxonomy_full.csv\nprint(\"Writing unified_taxonomy_full.csv...\")\ndf_full = pd.DataFrame(mappings)\ndf_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\n\n# Generate hierarchy CSV\nprint(\"Writing unified_taxonomy_hierarchy.csv...\")\nhierarchy_paths = set()\n\ndef add_paths(tax, path=[]):\n    if isinstance(tax, dict):\n        for key, value in tax.items():\n            new_path = path + [key]\n            # Pad to 5 levels\n            padded = new_path + [''] * (5 - len(new_path))\n            hierarchy_paths.add(tuple(padded))\n            add_paths(value, new_path)\n\nadd_paths(taxonomy)\n\nhierarchy_data = []\nfor path_tuple in sorted(hierarchy_paths):\n    hierarchy_data.append({\n        'unified_level_1': path_tuple[0],\n        'unified_level_2': path_tuple[1],\n        'unified_level_3': path_tuple[2],\n        'unified_level_4': path_tuple[3],\n        'unified_level_5': path_tuple[4]\n    })\n\ndf_hierarchy = pd.DataFrame(hierarchy_data)\ndf_hierarchy.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n\nprint(f\"\\nCompleted!\")\nprint(f\"Total unified paths in hierarchy: {len(hierarchy_data)}\")\nprint(f\"Level 1 categories: {len(taxonomy)}\")\nprint(f\"\\nOutput files:\")\nprint(\"  /root/output/unified_taxonomy_full.csv\")\nprint(\"  /root/output/unified_taxonomy_hierarchy.csv\")\nEOF\n"]
