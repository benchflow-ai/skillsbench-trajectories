[105.659121, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Build level 1 categories\nprint(\"Building Level 1...\")\nlevel1_cats = defaultdict(lambda: {'count': 0, 'sources': set(), 'items': []})\nfor item in all_data:\n    cat = normalize_text(item['path'][0])\n    level1_cats[cat]['count'] += 1\n    level1_cats[cat]['sources'].add(item['source'])\n    level1_cats[cat]['items'].append(item)\n\n# Cluster level 1 to 10-20 categories\nlevel1_sorted = sorted(level1_cats.items(), key=lambda x: x[1]['count'], reverse=True)\nlevel1_clusters = {}\nused = set()\n\nfor i, (cat, info) in enumerate(level1_sorted):\n    if i in used: continue\n    cluster_items = list(info['items'])\n    cluster_names = [cat]\n    used.add(i)\n    \n    # Merge similar categories\n    for j, (other_cat, other_info) in enumerate(level1_sorted[i+1:], start=i+1):\n        if j in used or len(level1_clusters) >= 15: continue\n        if word_overlap(cat, other_cat) > 0.4:\n            cluster_items.extend(other_info['items'])\n            cluster_names.append(other_cat)\n            used.add(j)\n    \n    names = [item['path'][0] for item in cluster_items[:100]]\n    l1_name = make_name(names)\n    level1_clusters[l1_name] = cluster_items\n    if len(level1_clusters) >= 18:\n        break\n\n# Add remaining to largest cluster if needed\nfor i, (cat, info) in enumerate(level1_sorted):\n    if i not in used:\n        largest = max(level1_clusters.items(), key=lambda x: len(x[1]))\n        level1_clusters[largest[0]].extend(info['items'])\n\nprint(f\"Level 1 categories: {len(level1_clusters)}\")\n\n# Build full taxonomy\ntaxonomy = {}\nfor l1_name, l1_items in level1_clusters.items():\n    taxonomy[l1_name] = {}\n    \n    # Level 2\n    level2_cats = defaultdict(lambda: {'items': []})\n    for item in l1_items:\n        if len(item['path']) >= 2:\n            cat2 = normalize_text(item['path'][1])\n            level2_cats[cat2]['items'].append(item)\n    \n    level2_sorted = sorted(level2_cats.items(), key=lambda x: len(x[1]['items']), reverse=True)[:15]\n    \n    for cat2, info2 in level2_sorted:\n        names2 = [item['path'][1] for item in info2['items'][:100]]\n        l2_name = make_name(names2)\n        if word_overlap(l1_name, l2_name) > 0.5:\n            l2_name = cat2.replace(l1_name.split('|')[0].strip(), '').strip() or 'products'\n        \n        taxonomy[l1_name][l2_name] = {}\n        \n        # Level 3\n        level3_cats = defaultdict(lambda: {'items': []})\n        for item in info2['items']:\n            if len(item['path']) >= 3:\n                cat3 = normalize_text(item['path'][2])\n                level3_cats[cat3]['items'].append(item)\n        \n        level3_sorted = sorted(level3_cats.items(), key=lambda x: len(x[1]['items']), reverse=True)[:12]\n        \n        for cat3, info3 in level3_sorted:\n            names3 = [item['path'][2] for item in info3['items'][:100]]\n            l3_name = make_name(names3)\n            taxonomy[l1_name][l2_name][l3_name] = {}\n            \n            # Level 4\n            level4_cats = defaultdict(lambda: {'items': []})\n            for item in info3['items']:\n                if len(item['path']) >= 4:\n                    cat4 = normalize_text(item['path'][3])\n                    level4_cats[cat4]['items'].append(item)\n            \n            level4_sorted = sorted(level4_cats.items(), key=lambda x: len(x[1]['items']), reverse=True)[:10]\n            \n            for cat4, info4 in level4_sorted:\n                names4 = [item['path'][3] for item in info4['items'][:100]]\n                l4_name = make_name(names4)\n                taxonomy[l1_name][l2_name][l3_name][l4_name] = {}\n                \n                # Level 5\n                level5_cats = defaultdict(lambda: {'items': []})\n                for item in info4['items']:\n                    if len(item['path']) >= 5:\n                        cat5 = normalize_text(item['path'][4])\n                        level5_cats[cat5]['items'].append(item)\n                \n                level5_sorted = sorted(level5_cats.items(), key=lambda x: len(x[1]['items']), reverse=True)[:8]\n                \n                for cat5, info5 in lev"]
[105.659297, "i", "el5_sorted:\n                    names5 = [item['path'][4] for item in info5['items'][:50]]\n                    l5_name = make_name(names5, max_words=3)\n                    taxonomy[l1_name][l2_name][l3_name][l4_name][l5_name] = info5['items']\n\nprint(\"Taxonomy built successfully\")\nEOF\n"]
