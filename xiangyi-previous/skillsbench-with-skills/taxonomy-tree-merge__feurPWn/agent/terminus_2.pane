[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import re
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def normalize_text(text):
[?2004l[?2004h>     if pd.isna(text): return ""
[?2004l[?2004h>     text = str(text).lower().strip()
[?2004l[?2004h>     text = re.sub(r'[&\-_/]+', ' ', text)
[?2004l[?2004h>     text = re.sub(r'\s+', ' ', text)
[?2004l[?2004h>     return text.strip()
[?2004l[?2004h> 
[?2004l[?2004h> def parse_path(path):
[?2004l[?2004h>     if pd.isna(path): return []
[?2004l[?2004h>     path = str(path).strip('"').strip("'")
[?2004l[?2004h>     levels = [level.strip() for level in path.split('>')]
[?2004l[?2004h>     return [l for l in levels if l]
[?2004l[?2004h> 
[?2004l[?2004h> def extract_words(text):
[?2004l[?2004h>     words = set(normalize_text(text).split())
[?2004l[?2004h>     stop_words = {'and', 'or', 'the', 'a', 'an', 'for', 'of', 'in', 'on', 'at', 'to', 'with', 'by'}
[?2004l[?2004h>     return words - stop_words
[?2004l[?2004h> 
[?2004l[?2004h> def word_overlap(t1, t2):
[?2004l[?2004h>     w1, w2 = extract_words(t1), extract_words(t2)
[?2004l[?2004h>     if not w1 or not w2: return 0.0
[?2004l[?2004h>     return len(w1 & w2) / len(w1 | w2)
[?2004l[?2004h> 
[?2004l[?2004h> def make_name(names, max_words=4):
[?2004l[?2004h>     word_freq = Counter()
[?2004l[?2004h>     for name in names[:100]:
[?2004l[?2004h>         word_freq.update(extract_words(name))
[?2004l[?2004h>     common = [w for w, _ in word_freq.most_common(max_words) if len(w) > 2]
[?2004l[?2004h>     if common:
[?2004l[?2004h>         return ' | '.join(common[:max_words])
[?2004l[?2004h>     if names:
[?2004l[?2004h>         words = names[0].split()[:max_words]
[?2004l[?2004h>         return ' | '.join(words)
[?2004l[?2004h>     return 'general'
[?2004l[?2004h> 
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> amazon = pd.read_csv('/root/data/amazon_product_categories.csv')
[?2004l[?2004h> amazon['source'] = 'amazon'
[?2004l[?2004h> fb = pd.read_csv('/root/data/fb_product_categories.csv')
[?2004l[?2004h> fb['source'] = 'facebook'
[?2004l[?2004h> google = pd.read_csv('/root/data/google_shopping_product_categories.csv')
[?2004l[?2004h> google['source'] = 'google'
[?2004l[?2004h> 
[?2004l[?2004h> all_data = []
[?2004l[?2004h> for df in [amazon, fb, google]:
[?2004l[?2004h>     src = df['source'].iloc[0]
[?2004l[?2004h>     for _, row in df.iterrows():
[?2004l[?2004h>         path = parse_path(row['category_path'])
[?2004l[?2004h>         if path:
[?2004l[?2004h>             all_data.append({'source': src, 'original': row['category_path'], 'path': path})
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total paths: {len(all_data)}")
