[?2004l[?2004h>                              key=lambda x: word_overlap(path[2], x), default=None)
[?2004l[?2004h>                 if best_l3:
[?2004l[?2004h>                     result[2] = best_l3
[?2004l[?2004h>                     
[?2004l[?2004h>                     if len(path) >= 4 and taxonomy[best_l1][best_l2][best_l3]:
[?2004l[?2004h>                         best_l4 = max(taxonomy[best_l1][best_l2][best_l3].keys(),
[?2004l[?2004h>                                      key=lambda x: word_overlap(path[3], x), default=None)
[?2004l[?2004h>                         if best_l4:
[?2004l[?2004h>                             result[3] = best_l4
[?2004l[?2004h>                             
[?2004l[?2004h>                             if len(path) >= 5 and taxonomy[best_l1][best_l2][best_l3][best_l4]:
