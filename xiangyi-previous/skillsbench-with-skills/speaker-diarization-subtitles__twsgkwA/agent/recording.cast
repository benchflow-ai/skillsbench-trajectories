[539.051221, "i", "cat <<EOF > process.py\nimport os\nimport json\nimport torch\nimport torchaudio\nimport whisper\nimport numpy as np\nfrom speechbrain.inference.speaker import EncoderClassifier\nfrom sklearn.cluster import AgglomerativeClustering\nfrom datetime import timedelta\n\n# Paths\nINPUT_FILE = \"/root/input.mp4\"\nAUDIO_FILE = \"/root/input.wav\"\nRTTM_FILE = \"/root/diarization.rttm\"\nASS_FILE = \"/root/subtitles.ass\"\nREPORT_FILE = \"/root/report.json\"\n\n# 1. Audio Extraction\nif not os.path.exists(AUDIO_FILE):\n    os.system(f\"ffmpeg -i {INPUT_FILE} -vn -acodec pcm_s16le -ar 16000 -ac 1 {AUDIO_FILE}\")\n\n# 2. Load Models\nprint(\"Loading Whisper...\")\nmodel = whisper.load_model(\"tiny\")\nprint(\"Loading SpeechBrain...\")\nclassifier = EncoderClassifier.from_hparams(source=\"speechbrain/spkrec-ecapa-voxceleb\", savedir=\"tmp_model\")\n\n# 3. Transcribe\nprint(\"Transcribing...\")\nresult = model.transcribe(AUDIO_FILE)\nsegments = result[\"segments\"]\n\n# 4. Diarization (Embedding + Clustering)\nprint(\"Extracting embeddings...\")\nwav, fs = torchaudio.load(AUDIO_FILE)\nembeddings = []\nvalid_segments = []\n\nfor seg in segments:\n    start = seg[\"start\"]\n    end = seg[\"end\"]\n    start_sample = int(start * fs)\n    end_sample = int(end * fs)\n    \n    if end_sample - start_sample < 160: \n        continue\n        \n    segment_wav = wav[:, start_sample:end_sample]\n    emb = classifier.encode_batch(segment_wav)\n    embeddings.append(emb.squeeze().cpu().numpy())\n    valid_segments.append(seg)\n\nembeddings = np.array(embeddings)\n\nprint(\"Clustering...\")\n# Normalize embeddings\nnorm = np.linalg.norm(embeddings, axis=1, keepdims=True)\nembeddings = embeddings / (norm + 1e-10)\n\n# Clustering\nclustering = AgglomerativeClustering(n_clusters=None, metric='cosine', linkage='average', distance_threshold=0.7)\nlabels = clustering.fit_predict(embeddings)\nnum_speakers = len(set(labels))\n\n# 5. Generate Files\n\n# RTTM\nprint(f\"Generating {RTTM_FILE}...\")\nwith open(RTTM_FILE, \"w\") as f:\n    for i, seg in enumerate(valid_segments):\n        start = seg[\"start\"]\n        duration = seg[\"end\"] - seg[\"start\"]\n        speaker = f\"spk{labels[i]:02d}\"\n        f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\n\n# ASS\nprint(f\"Generating {ASS_FILE}...\")\ndef format_time(seconds):\n    total_seconds = int(seconds)\n    hours = total_seconds // 3600\n    minutes = (total_seconds % 3600) // 60\n    secs = total_seconds % 60\n    centis = int((seconds - total_seconds) * 100)\n    return f\"{hours}:{minutes:02d}:{secs:02d}.{centis:02d}\"\n\nass_header = \"\"\"[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n\"\"\"\nwith open(ASS_FILE, \"w\") as f:\n    f.write(ass_header)\n    for i, seg in enumerate(valid_segments):\n        start_str = format_time(seg[\"start\"])\n        end_str = format_time(seg[\"end\"])\n        speaker = f\"SPEAKER_{labels[i]:02d}\"\n        text = seg[\"text\"].strip()\n        f.write(f\"Dialogue: 0,{start_str},{end_str},Default,,0,0,0,,{speaker}: {text}\\n\")\n\n# Report\nprint(f\"Generating {REPORT_FILE}...\")\ntotal_speech_time = sum([s[\"end\"] - s[\"start\"] for s in valid_segments])\naudio_duration = wav.shape[1] / fs\n\nreport = {\n    \"num_speakers_pred\": num_speakers,\n    \"total_speech_time_sec\": round(total_speech_time, 2),\n    \"audio_duration_sec\": round(audio_duration, 2),\n    \"steps_completed\": [\"audio_extraction\", \"diarization\", \"subtitle_generation\"],\n    \"commands_used\": [\"ffmpeg\", \"python3\"],\n    \"libraries_used\": [\"whisper\", \"speechbrain\", \"numpy\", \"scikit-learn\", \"torch\", \"torchaudio\"],\n    \"tools_used\": {\n        \"audio_extraction\": \"ffmpeg\",\n        \"diarization\": \"speechbrain + scikit-learn\",\n        \"transcription\": \"openai-whisper\"\n    },\n    \"notes\": \"Used Whisper for segmentation/transcription and SpeechBrain ECAPA-TDNN for speaker embeddings with Agglomerative Clustering.\"\n}\n\nwith open(REPORT_FILE, \"w\") as f:\n    json.dump(report, f, indent=2)\n\nprint(\"Done.\")\nEOF\n"]
