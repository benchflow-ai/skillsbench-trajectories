[1037.11226, "o", "                                            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/opt/venv/lib/python3.11/site-packages/whisper/decoding.py\", line 687, in _main_loop\r\n"]
[1037.112384, "o", "    logits = self.inference.logits(tokens, audio_features)\r\n"]
[1037.112498, "o", "             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/opt/venv/lib/python3.11/site-packages/whisper/decoding.py\", line 163, in logits\r\n    return self.model.decoder(tokens, audio_features, kv_cache=self.kv_cache)\r\n"]
