[1037.111899, "o", "             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/opt/venv/lib/python3.11/site-packages/torch/utils/_contextlib.py\", line 120, in decorate_context\r\n"]
[1037.11201, "o", "    return func(*args, **kwargs)\r\n"]
