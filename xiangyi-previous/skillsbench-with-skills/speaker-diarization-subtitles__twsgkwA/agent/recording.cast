[578.61582, "o", "Transcribing...\r\n"]
[578.616204, "o", "/opt/venv/lib/python3.11/site-packages/whisper/transcribe.py:115: UserWarning: FP16 is not supported on CPU; using FP32 instead\r\n  warnings.warn(\"FP16 is not supported on CPU; using FP32 instead\")\r\n"]
