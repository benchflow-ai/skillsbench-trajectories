[332.09113, "i", "cat <<EOF > check_tools.py\nimport torch\nimport speechbrain.pretrained\nfrom speechbrain.inference.speaker import EncoderClassifier\nimport whisper\n\nprint('Checking Whisper...')\nmodel = whisper.load_model('tiny')\nprint('Whisper loaded.')\n\nprint('Checking SpeechBrain...')\ntry:\n    classifier = EncoderClassifier.from_hparams(source='speechbrain/spkrec-ecapa-voxceleb', savedir='tmp_model')\n    print('SpeechBrain loaded.')\nexcept Exception as e:\n    print(f'SpeechBrain failed: {e}')\nEOF\n"]
[332.091361, "o", "cat <<EOF > check_tools.py\r\n\u001b[?2004l\r"]
[332.091421, "o", "\u001b[?2004h> "]
