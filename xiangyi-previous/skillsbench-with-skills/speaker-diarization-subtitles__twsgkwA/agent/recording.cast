[539.052266, "o", "RTTM_FILE = \"/root/diarization.rttm\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.052336, "o", "ASS_FILE = \"/root/subtitles.ass\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.052398, "o", "REPORT_FILE = \"/root/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.052461, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # 1. Audio Extraction\r\n\u001b[?2004l\r"]
[539.052496, "o", "\u001b[?2004h> "]
[539.052572, "o", "if not os.path.exists(AUDIO_FILE):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.05272, "o", "    os.system(f\"ffmpeg -i {INPUT_FILE} -vn -acodec pcm_s16le -ar 16000 -ac 1 {AUDIO_FILE}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[539.052821, "o", "> # 2. Load Models\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.052859, "o", "print(\"Loading Whisper...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.052889, "o", "model = whisper.load_model(\"tiny\")\r\n\u001b[?2004l\r"]
[539.052928, "o", "\u001b[?2004h> "]
[539.052963, "o", "print(\"Loading SpeechBrain...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.053038, "o", "> "]
[539.05316, "o", "classifier = EncoderClassifier.from_hparams(source=\"speechbrain/spkrec-ecapa-voxceleb\", savedir=\"tmp_model\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[539.053226, "o", "> # 3. Transcribe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053282, "o", "print(\"Transcribing...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053367, "o", "result = model.transcribe(AUDIO_FILE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053425, "o", "segments = result[\"segments\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053513, "o", "# 4. Diarization (Embedding + Clustering)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053583, "o", "print(\"Extracting embeddings...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053668, "o", "wav, fs = torchaudio.load(AUDIO_FILE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053708, "o", "embeddings = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053784, "o", "valid_segments = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.053817, "o", "for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.053848, "o", "> "]
[539.053886, "o", "    start = seg[\"start\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054005, "o", "    end = seg[\"end\"]\r\n\u001b[?2004l\r\u001b[?2004h>     start_sample = int(start * fs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054061, "o", "    end_sample = int(end * fs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.054098, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054184, "o", "    if end_sample - start_sample < 160: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054261, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054304, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054385, "o", "    segment_wav = wav[:, start_sample:end_sample]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054437, "o", "    emb = classifier.encode_batch(segment_wav)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054534, "o", "    embeddings.append(emb.squeeze().cpu().numpy())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054597, "o", "    valid_segments.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054675, "o", "embeddings = np.array(embeddings)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[539.05471, "o", "\u001b[?2004h> "]
[539.054785, "o", "print(\"Clustering...\")\r\n\u001b[?2004l\r\u001b[?2004h> # Normalize embeddings\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.054817, "o", "> "]
[539.054902, "o", "norm = np.linalg.norm(embeddings, axis=1, keepdims=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.054971, "o", "embeddings = embeddings / (norm + 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[539.05501, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[539.055042, "o", "# Clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055243, "o", "clustering = AgglomerativeClustering(n_clusters=None, metric='cosine', linkage='average', distance_threshold=0.7)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055313, "o", "labels = clustering.fit_predict(embeddings)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055367, "o", "num_speakers = len(set(labels))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[539.055404, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[539.055478, "o", "# 5. Generate Files\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # RTTM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055562, "o", "print(f\"Generating {RTTM_FILE}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055643, "o", "with open(RTTM_FILE, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.0557, "o", "    for i, seg in enumerate(valid_segments):\r\n\u001b[?2004l\r\u001b[?2004h"]
[539.055778, "o", "> "]
[539.055818, "o", "        start = seg[\"start\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.055916, "o", "        duration = seg[\"end\"] - seg[\"start\"]\r\n\u001b[?2004l\r\u001b[?2004h>         speaker = f\"spk{labels[i]:02d}\"\r\n\u001b[?2004l\r"]
[539.055948, "o", "\u001b[?2004h> "]
[539.056102, "o", "        f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[539.056176, "o", "> # ASS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056215, "o", "print(f\"Generating {ASS_FILE}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056294, "o", "def format_time(seconds):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056359, "o", "    total_seconds = int(seconds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.05645, "o", "    hours = total_seconds // 3600\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056523, "o", "    minutes = (total_seconds % 3600) // 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056556, "o", "    secs = total_seconds % 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056659, "o", "    centis = int((seconds - total_seconds) * 100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056757, "o", "    return f\"{hours}:{minutes:02d}:{secs:02d}.{centis:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[539.056794, "o", "\u001b[?2004h> "]
[539.056826, "o", "ass_header = \"\"\"[Events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.056964, "o", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[539.056999, "o", "\u001b[?2004h> "]
[539.057071, "o", "with open(ASS_FILE, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057134, "o", "    f.write(ass_header)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057207, "o", "    for i, seg in enumerate(valid_segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057265, "o", "        start_str = format_time(seg[\"start\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057342, "o", "        end_str = format_time(seg[\"end\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057415, "o", "        speaker = f\"SPEAKER_{labels[i]:02d}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057485, "o", "        text = seg[\"text\"].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057654, "o", "        f.write(f\"Dialogue: 0,{start_str},{end_str},Default,,0,0,0,,{speaker}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057715, "o", "# Report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057782, "o", "print(f\"Generating {REPORT_FILE}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.057878, "o", "total_speech_time = sum([s[\"end\"] - s[\"start\"] for s in valid_segments])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.05796, "o", "audio_duration = wav.shape[1] / fs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[539.058017, "o", "\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.05808, "o", "    \"num_speakers_pred\": num_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058191, "o", "    \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058272, "o", "    \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058436, "o", "    \"steps_completed\": [\"audio_extraction\", \"diarization\", \"subtitle_generation\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.05851, "o", "    \"commands_used\": [\"ffmpeg\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058698, "o", "    \"libraries_used\": [\"whisper\", \"speechbrain\", \"numpy\", \"scikit-learn\", \"torch\", \"torchaudio\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058766, "o", "    \"tools_used\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058804, "o", "        \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058899, "o", "        \"diarization\": \"speechbrain + scikit-learn\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.058989, "o", "        \"transcription\": \"openai-whisper\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.059059, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.059266, "o", "    \"notes\": \"Used Whisper for segmentation/transcription and SpeechBrain ECAPA-TDNN for speaker embeddings with Agglomerative Clustering.\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[539.059329, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[539.059396, "o", "with open(REPORT_FILE, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.059432, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.059508, "o", "print(\"Done.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[539.060634, "o", "\u001b[?2004hroot@fa3252de6636:/app/workspace# "]
[540.082771, "i", "python3 process.py\n"]
[540.084485, "o", "python3 process.py\r\n\u001b[?2004l\r"]
