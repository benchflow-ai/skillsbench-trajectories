[?2004l[?2004h> RTTM_FILE = "/root/diarization.rttm"
[?2004l[?2004h> ASS_FILE = "/root/subtitles.ass"
[?2004l[?2004h> REPORT_FILE = "/root/report.json"
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Audio Extraction
[?2004l[?2004h> if not os.path.exists(AUDIO_FILE):
[?2004l[?2004h>     os.system(f"ffmpeg -i {INPUT_FILE} -vn -acodec pcm_s16le -ar 16000 -ac 1 {AUDIO_FILE}")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Load Models
[?2004l[?2004h> print("Loading Whisper...")
[?2004l[?2004h> model = whisper.load_model("tiny")
[?2004l[?2004h> print("Loading SpeechBrain...")
[?2004l[?2004h> classifier = EncoderClassifier.from_hparams(source="speechbrain/spkrec-ecapa-voxceleb", savedir="tmp_model")
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Transcribe
[?2004l[?2004h> print("Transcribing...")
[?2004l[?2004h> result = model.transcribe(AUDIO_FILE)
[?2004l[?2004h> segments = result["segments"]
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Diarization (Embedding + Clustering)
[?2004l[?2004h> print("Extracting embeddings...")
[?2004l[?2004h> wav, fs = torchaudio.load(AUDIO_FILE)
[?2004l[?2004h> embeddings = []
[?2004l[?2004h> valid_segments = []
[?2004l[?2004h> 
[?2004l[?2004h> for seg in segments:
[?2004l[?2004h>     start = seg["start"]
[?2004l[?2004h>     end = seg["end"]
[?2004l[?2004h>     start_sample = int(start * fs)
[?2004l[?2004h>     end_sample = int(end * fs)
[?2004l[?2004h>     
[?2004l[?2004h>     if end_sample - start_sample < 160: 
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     segment_wav = wav[:, start_sample:end_sample]
[?2004l[?2004h>     emb = classifier.encode_batch(segment_wav)
[?2004l[?2004h>     embeddings.append(emb.squeeze().cpu().numpy())
[?2004l[?2004h>     valid_segments.append(seg)
[?2004l[?2004h> 
[?2004l[?2004h> embeddings = np.array(embeddings)
[?2004l[?2004h> 
[?2004l[?2004h> print("Clustering...")
[?2004l[?2004h> # Normalize embeddings
[?2004l[?2004h> norm = np.linalg.norm(embeddings, axis=1, keepdims=True)
[?2004l[?2004h> embeddings = embeddings / (norm + 1e-10)
[?2004l[?2004h> 
[?2004l[?2004h> # Clustering
[?2004l[?2004h> clustering = AgglomerativeClustering(n_clusters=None, metric='cosine', linkage='average', distance_threshold=0.7)
[?2004l[?2004h> labels = clustering.fit_predict(embeddings)
[?2004l[?2004h> num_speakers = len(set(labels))
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Generate Files
[?2004l[?2004h> 
[?2004l[?2004h> # RTTM
[?2004l[?2004h> print(f"Generating {RTTM_FILE}...")
[?2004l[?2004h> with open(RTTM_FILE, "w") as f:
[?2004l[?2004h>     for i, seg in enumerate(valid_segments):
[?2004l[?2004h>         start = seg["start"]
[?2004l[?2004h>         duration = seg["end"] - seg["start"]
[?2004l[?2004h>         speaker = f"spk{labels[i]:02d}"
[?2004l[?2004h>         f.write(f"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\n")
[?2004l[?2004h> 
[?2004l[?2004h> # ASS
[?2004l[?2004h> print(f"Generating {ASS_FILE}...")
[?2004l[?2004h> def format_time(seconds):
[?2004l[?2004h>     total_seconds = int(seconds)
[?2004l[?2004h>     hours = total_seconds // 3600
[?2004l[?2004h>     minutes = (total_seconds % 3600) // 60
[?2004l[?2004h>     secs = total_seconds % 60
[?2004l[?2004h>     centis = int((seconds - total_seconds) * 100)
[?2004l[?2004h>     return f"{hours}:{minutes:02d}:{secs:02d}.{centis:02d}"
[?2004l[?2004h> 
[?2004l[?2004h> ass_header = """[Events]
[?2004l[?2004h> Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
[?2004l[?2004h> """
[?2004l[?2004h> with open(ASS_FILE, "w") as f:
[?2004l[?2004h>     f.write(ass_header)
[?2004l[?2004h>     for i, seg in enumerate(valid_segments):
[?2004l[?2004h>         start_str = format_time(seg["start"])
[?2004l[?2004h>         end_str = format_time(seg["end"])
[?2004l[?2004h>         speaker = f"SPEAKER_{labels[i]:02d}"
[?2004l[?2004h>         text = seg["text"].strip()
[?2004l[?2004h>         f.write(f"Dialogue: 0,{start_str},{end_str},Default,,0,0,0,,{speaker}: {text}\n")
[?2004l[?2004h> 
[?2004l[?2004h> # Report
[?2004l[?2004h> print(f"Generating {REPORT_FILE}...")
[?2004l[?2004h> total_speech_time = sum([s["end"] - s["start"] for s in valid_segments])
