[102.92977, "o", "{\"url\":\"https://api.github.com/repos/cli/cli/pulls/10154\",\"id\":2255950901,\"node_id\":\"PR_kwDODKw3uc6GdxQ1\",\"html_url\":\"https://github.com/cli/cli/pull/10154\",\"diff_url\":\"https://github.com/cli/cli/pull/10154.diff\",\"patch_url\":\"https://github.com/cli/cli/pull/10154.patch\",\"issue_url\":\"https://api.github.com/repos/cli/cli/issues/10154\",\"number\":10154,\"state\":\"closed\",\"locked\":false,\"title\":\"gh gist delete: prompt for gist id\",\"user\":{\"login\":\"danochoa\",\"id\":11418369,\"node_id\":\"MDQ6VXNlcjExNDE4MzY5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/11418369?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/danochoa\",\"html_url\":\"https://github.com/danochoa\",\"followers_url\":\"https://api.github.com/users/danochoa/followers\",\"following_url\":\"https://api.github.com/users/danochoa/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/danochoa/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/danochoa/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/danochoa/subscriptions\",\"organizations_url\":\"https://api.github.com/users/danochoa/orgs\",\"repos_url\":\"https://api.github.com/users/danochoa/repos\",\"events_url\":\"https://api.github.com/users/danochoa/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/danochoa/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"Fixes #10073.\\r\\n\\r\\nThis changes `gh gist delete` to prompt the user to select a gist when no args are passed, instead of returning a message with usage info. And adds a confirm flag to prompt for confirmation. The code for prompting is already used by other commands (used `gh gist view` and `gh repo delete` for reference).\",\"created_at\":\"2024-12-30T23:29:24Z\",\"updated_at\":\"2025-01-14T22:42:14Z\",\"closed_at\":\"2025-01-14T22:42:14Z\",\"merged_at\":\"2025-01-14T22:42:14Z\",