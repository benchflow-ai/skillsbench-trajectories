[148.931261, "i", "total_pr=$(jq 'length' /tmp/prs.json); merged_pr=$(jq 'map(select(.merged_at!=null))|length' /tmp/prs.json); closed_pr=$(jq 'map(select(.closed_at!=null and .merged_at==null))|length' /tmp/prs.json); avg_merge=$(jq 'map(select(.merged_at!=null)) | map(((.merged_at|fromdateiso8601) - (.created_at|fromdateiso8601))/86400) | add/length' /tmp/prs.json); avg_merge=$(printf \"%.1f\" \"$avg_merge\"); top_contrib=$(jq -r 'group_by(.user.login) | map({user: .[0].user.login, count: length}) | max_by(.count).user' /tmp/prs.json); echo \"$total_pr $merged_pr $closed_pr $avg_merge $top_contrib\"\n"]
