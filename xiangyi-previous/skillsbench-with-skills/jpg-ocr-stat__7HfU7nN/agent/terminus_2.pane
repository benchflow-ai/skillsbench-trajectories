[?2004l[?2004h> 
[?2004l[?2004h> img_dir = '/app/workspace/dataset/img'
[?2004l[?2004h> files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith(('.png','.jpg','.jpeg','.tif','.tiff'))])
[?2004l[?2004h> 
[?2004l[?2004h> # regex patterns for dates
[?2004l[?2004h> # accept formats like DD/MM/YYYY, DD-MM-YYYY, YYYY-MM-DD, YYYY/MM/DD, DD.MM.YYYY
[?2004l[?2004h> pat1 = re.compile(r'(\d{4})[\-/\.](\d{1,2})[\-/\.](\d{1,2})')
[?2004l[?2004h> pat2 = re.compile(r'(\d{1,2})[\-/\.](\d{1,2})[\-/\.](\d{2,4})')
[?2004l[?2004h> 
[?2004l[?2004h> # keywords
[?2004l[?2004h> priority_keywords = [
[?2004l[?2004h>     'GRAND TOTAL',
[?2004l[?2004h>     'TOTAL RM', 'TOTAL: RM',
[?2004l[?2004h>     'TOTAL AMOUNT',
[?2004l[?2004h>     'TOTAL', 'AMOUNT', 'TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL'
[?2004l[?2004h> ]
[?2004l[?2004h> exclude_keywords = ['SUBTOTAL','SUB TOTAL','TAX','GST','SST','DISCOUNT','CHANGE','CASH TENDERED']
[?2004l[?2004h> 
[?2004l[?2004h> num_pat = re.compile(r'\b\d{1,3}(?:,\d{3})*(?:\.\d{2})\b|\b\d+\.\d{2}\b')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def extract_date(text):
[?2004l[?2004h>     # search for YYYY-MM-DD first
[?2004l[?2004h>     for m in pat1.finditer(text):
[?2004l[?2004h>         y,mn,d = m.group(1), m.group(2), m.group(3)
[?2004l[?2004h>         try:
[?2004l[?2004h>             dt = datetime(int(y), int(mn), int(d))
[?2004l[?2004h>             return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             continue
[?2004l[?2004h>     # search for DD/MM/YYYY etc
[?2004l[?2004h>     for m in pat2.finditer(text):
[?2004l[?2004h>         d,mn,y = m.group(1), m.group(2), m.group(3)
[?2004l[?2004h>         if len(y)==2:
[?2004l[?2004h>             y = '20'+y
[?2004l[?2004h>         try:
[?2004l[?2004h>             dt = datetime(int(y), int(mn), int(d))
[?2004l[?2004h>             return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             continue
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def extract_total(lines):
[?2004l[?2004h>     # lines as list
[?2004l[?2004h>     # preprocess: uppercase
[?2004l[?2004h>     up_lines = [ln.upper() for ln in lines]
[?2004l[?2004h>     # helper to find number in line
[?2004l[?2004h>     def find_num(ln):
[?2004l[?2004h>         nums = num_pat.findall(ln)
[?2004l[?2004h>         if nums:
[?2004l[?2004h>             return nums[-1]
[?2004l[?2004h>         return None
[?2004l[?2004h>     # check keywords in priority
[?2004l[?2004h>     for key in priority_keywords:
[?2004l[?2004h>         for i,ln in enumerate(up_lines):
[?2004l[?2004h>             if key in ln:
[?2004l[?2004h>                 # skip exclusions
[?2004l[?2004h>                 if any(ex in ln for ex in exclude_keywords):
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 num = find_num(ln)
[?2004l[?2004h>                 if num:
[?2004l[?2004h>                     return num
[?2004l[?2004h>                 # fallback next line
[?2004l[?2004h>                 if i+1 < len(up_lines):
[?2004l[?2004h>                     num = find_num(up_lines[i+1])
[?2004l[?2004h>                     if num:
[?2004l[?2004h>                         return num
[?2004l[?2004h>     # fallback: last numeric line not excluded
[?2004l[?2004h>     for ln in reversed(up_lines):
[?2004l[?2004h>         if any(ex in ln for ex in exclude_keywords):
[?2004l[?2004h>             continue
[?2004l[?2004h>         num = find_num(ln)
[?2004l[?2004h>         if num:
[?2004l[?2004h>             return num
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for f in files:
[?2004l[?2004h>     path = os.path.join(img_dir,f)
[?2004l[?2004h>     img = Image.open(path)
[?2004l[?2004h>     text = pytesseract.image_to_string(img)
[?2004l[?2004h>     lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
[?2004l[?2004h>     date = extract_date(text)
[?2004l[?2004h>     total = extract_total(lines)
[?2004l[?2004h>     # normalize total with two decimals
[?2004l[?2004h>     if total:
[?2004l[?2004h>         total = total.replace(',','')
[?2004l[?2004h>         try:
[?2004l[?2004h>             total = f"{float(total):.2f}"
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             total = None
[?2004l[?2004h>     rows.append({'filename': f, 'date': date, 'total_amount': total})
[?2004l[?2004h> 
[?2004l[?2004h> # create dataframe ordered by filename
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> DF = pd.DataFrame(rows)
