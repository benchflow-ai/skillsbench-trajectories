[52.640361, "o", "\"\"\"\r\nProvides the default implementation of :class:`ArrowFactory <arrow.factory.ArrowFactory>`\r\nmethods for use as a module API.\r\n\r\n\"\"\"\r\n\r\nfrom datetime import date, datetime\r\nfrom datetime import tzinfo as dt_tzinfo\r\nfrom time import struct_time\r\nfrom typing import Any, List, Optional, Tuple, Type, Union, overload\r\n\r\nfrom arrow.arrow import TZ_EXPR, Arrow\r\n"]
[52.640396, "o", "from arrow.constants import DEFAULT_LOCALE\r\nfrom arrow.factory import ArrowFactory\r\n\r\n# internal default factory.\r\n_factory = ArrowFactory()\r\n\r\n# TODO: Use Positional Only Argument (https://www.python.org/dev/peps/pep-0570/)\r\n#  after Python 3.7 deprecation\r\n\r\n\r\n@overload\r\ndef get(\r\n    *,\r\n    locale: str = DEFAULT_LOCALE,\r\n    tzinfo: Optional[TZ_EXPR] = None,\r\n    normalize_whitespace: bool = False,\r\n) -> Arrow: ...  # pragma: no cover\r\n\r\n"]
[52.640414, "o", "\r\n@overload\r\ndef get(\r\n    *args: int,\r\n    locale: str = DEFAULT_LOCALE,\r\n    tzinfo: Optional[TZ_EXPR] = None,\r\n    normalize_whitespace: bool = False,\r\n) -> Arrow: ...  # pragma: no cover\r\n\r\n"]
[52.640428, "o", "\r\n@overload\r\ndef get(\r\n    __obj: Union[\r\n        Arrow,\r\n"]
[52.640442, "o", "        datetime,\r\n        date,\r\n        struct_time,\r\n        dt_tzinfo,\r\n        int,\r\n        float,\r\n        str,"]
[52.640453, "o", "\r\n        Tuple[int, int, int],\r\n    ],\r\n    *,\r\n    locale: str = DEFAULT_LOCALE,\r\n"]
[52.640467, "o", "    tzinfo: Optional[TZ_EXPR] = None,\r\n    normalize_whitespace: bool = False,\r\n) -> Arrow: ...  # pragma: no cover\r\n\r\n\r\n@overload\r\ndef get("]
[52.640476, "o", "\r\n    __arg1: Union[datetime, date],\r\n    __arg2: TZ_EXPR,\r\n    *,\r\n    locale: str = DEFAULT_LOCALE,\r\n"]
[52.640489, "o", "    tzinfo: Optional[TZ_EXPR] = None,\r\n    normalize_whitespace: bool = False,\r\n) -> Arrow: ...  # pragma: no cover\r\n\r\n\r\n@overload\r\n"]
[52.640504, "o", "def get(\r\n    __arg1: str,\r\n    __arg2: Union[str, List[str]],\r\n    *,\r\n    locale: str = DEFAULT_LOCALE,\r\n    tzinfo: Optional[TZ_EXPR] = None,\r\n    normalize_whitespace: bool = False,\r\n"]
[52.64052, "o", ") -> Arrow: ...  # pragma: no cover\r\n\r\n\r\ndef get(*args: Any, **kwargs: Any) -> Arrow:\r\n    \"\"\"Calls the default :class:`ArrowFactory <arrow.factory.ArrowFactory>` ``get`` method.\"\"\"\r\n\r\n    return _factory.get(*args, **kwargs)\r\n\r\n\r\n"]
[52.640531, "o", "get.__doc__ = _factory.get.__doc__\r\n\r\n\r\ndef utcnow() -> Arrow:\r\n    \"\"\"Calls the default :class:`ArrowFactory <arrow.factory.ArrowFactory>` ``utcnow`` method.\"\"\"\r\n\r\n"]
[52.64055, "o", "    return _factory.utcnow()\r\n\r\n\r\nutcnow.__doc__ = _factory.utcnow.__doc__\r\n\r\n\r\ndef now(tz: Optional[TZ_EXPR] = None) -> Arrow:\r\n    \"\"\"Calls the default :class:`ArrowFactory <arrow.factory.ArrowFactory>` ``now`` method.\"\"\"\r\n\r\n"]
[52.64056, "o", "    return _factory.now(tz)\r\n\r\n\r\nnow.__doc__ = _factory.now.__doc__\r\n\r\n\r\n"]
[52.640571, "o", "def factory(type: Type[Arrow]) -> ArrowFactory:\r\n    \"\"\"Returns an :class:`.ArrowFactory` for the specified :class:`Arrow <arrow.arrow.Arrow>`\r\n    or derived type.\r\n\r\n"]
[52.640581, "o", "    :param type: the type, :class:`Arrow <arrow.arrow.Arrow>` or derived.\r\n\r\n    \"\"\"\r\n\r\n    return ArrowFactory(type)"]
[52.64059, "o", "\r\n\r\n\r\n__all__ = [\"get\", \"utcnow\", \"now\", \"factory\"]"]
[52.640601, "o", "\r\n"]
