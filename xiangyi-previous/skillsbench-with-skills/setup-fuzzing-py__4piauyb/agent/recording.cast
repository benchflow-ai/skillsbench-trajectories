[614.592501, "o", "from datetime import datetime"]
[614.592544, "o", "\r\n> "]
[614.592583, "o", "import arrow"]
[614.592618, "o", "\r\n> "]
[614.592726, "o", "from arrow import parser, formatter\r\n"]
[614.592764, "o", "> \r\n"]
[614.592799, "o", "> \r\n"]
[614.592834, "o", "> "]
[614.592898, "o", "def TestOneInput(data: bytes) -> None:\r\n"]
[614.592935, "o", "> "]
[614.593016, "o", "    fdp = atheris.FuzzedDataProvider(data)\r\n"]
[614.593064, "o", "> "]
[614.593165, "o", "    s = fdp.ConsumeUnicodeNoSurrogates(100)\r\n"]
[614.593261, "o", "> "]
[614.593316, "o", "    fmt = fdp.ConsumeUnicodeNoSurrogates(30)\r\n> "]
[614.59335, "o", "    try:\r\n"]
[614.593381, "o", "> "]
[614.593422, "o", "        arrow.get(s)\r\n"]
[614.593473, "o", "> "]
[614.593513, "o", "    except Exception:\r\n"]
[614.593546, "o", ">         pass\r\n"]
[614.593584, "o", "> "]
[614.593631, "o", "    # parse using Parser\r\n"]
[614.593679, "o", ">     try:\r\n"]
[614.593707, "o", "> "]
[614.593784, "o", "        parser.Parser().parse(s)\r\n"]
[614.593817, "o", "> "]
[614.593843, "o", "    except Exception:\r\n"]
[614.593875, "o", "> "]
[614.593911, "o", "        pass\r\n"]
[614.593945, "o", "> "]
[614.593985, "o", "    # format with formatter\r\n"]
[614.594015, "o", "> "]
[614.594067, "o", "    try:\r\n> "]
[614.594206, "o", "        formatter.Formatter().format(datetime.utcnow(), fmt)\r\n"]
[614.59425, "o", "> "]
[614.594281, "o", "    except Exception:\r\n"]
[614.594308, "o", "> "]
[614.594335, "o", "        pass\r\n"]
[614.594365, "o", "> "]
[614.594404, "o", "    # timestamp\r\n> "]
[614.594456, "o", "    try:\r\n> "]
[614.594554, "o", "        ts = fdp.ConsumeIntInRange(-10**12, 10**12)\r\n"]
[614.594622, "o", ">         arrow.get(ts)\r\n"]
[614.594642, "o", "> "]
[614.594693, "o", "    except Exception:\r\n"]
[614.594724, "o", "> "]
[614.594755, "o", "        pass\r\n> "]
[614.594798, "o", "    # tuple date\r\n"]
[614.594838, "o", ">     try:\r\n"]
[614.594887, "o", "> "]
[614.594947, "o", "        y = fdp.ConsumeIntInRange(1, 3000)\r\n"]
[614.594993, "o", "> "]
[614.595051, "o", "        m = fdp.ConsumeIntInRange(1, 12)\r\n"]
[614.59508, "o", "> "]
[614.595157, "o", "        d = fdp.ConsumeIntInRange(1, 31)\r\n"]
[614.595181, "o", "> "]
[614.595231, "o", "        arrow.get((y, m, d))\r\n"]
[614.595255, "o", "> "]
[614.595298, "o", "    except Exception:\r\n"]
[614.595321, "o", "> "]
[614.59536, "o", "        pass\r\n"]
[614.595391, "o", "> "]
[614.595413, "o", "\r\n"]
[614.595436, "o", "> \r\n"]
[614.595458, "o", "> "]
[614.595516, "o", "if __name__ == \"__main__\":\r\n"]
[614.595547, "o", "> "]
[614.595642, "o", "    atheris.Setup(sys.argv, TestOneInput)\r\n"]
[614.595671, "o", "> "]
[614.59571, "o", "    atheris.Fuzz()\r\n"]
[614.595737, "o", "> "]
[614.595759, "o", "EOF"]
[614.59578, "o", "\r\n"]
