[615.80549, "o", "> "]
[615.805523, "o", "    if choice == 0:\r\n"]
[615.805542, "o", "> "]
[615.805603, "o", "        return fdp.ConsumeUnicodeNoSurrogates(20)\r\n"]
[615.805617, "o", "> "]
[615.805652, "o", "    if choice == 1:\r\n"]
[615.805661, "o", "> "]
[615.80574, "o", "        return fdp.ConsumeIntInRange(-10**6, 10**6)\r\n"]
[615.805751, "o", "> "]
[615.805811, "o", "    if choice == 2:\r\n"]
[615.805821, "o", "> "]
[615.805891, "o", "        return fdp.ConsumeFloat()\r\n> "]
[615.805926, "o", "    if choice == 3:\r\n"]
[615.805946, "o", "> "]
[615.80599, "o", "        return fdp.ConsumeBool()\r\n"]
[615.806013, "o", "> "]
[615.806037, "o", "    if choice == 4:\r\n"]
[615.806069, "o", "> "]
[615.806195, "o", "        return [gen_value(fdp, depth + 1) for _ in range(fdp.ConsumeIntInRange(0, 3))]\r\n"]
[615.806249, "o", ">     # dict\r\n> "]
[615.806278, "o", "    d = {}\r\n> "]
[615.806365, "o", "    for _ in range(fdp.ConsumeIntInRange(0, 3)):\r\n> "]
