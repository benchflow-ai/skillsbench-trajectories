[95.871105, "o", "        if trailing_newline:\r\n            dst_contents = dst_contents + \"\\n\"\r\n        return dst_contents\r\n    else:\r\n        raise NothingChanged\r\n\r\n\r\ndef format_str(\r\n    src_contents: str, *, mode: Mode, lines: Collection[tuple[int, int]] = ()\r\n) -> str:\r\n    \"\"\"Reformat a string and return new contents.\r\n\r\n    `mode` determines formatting options, such as how many characters per line are\r\n    allowed.  Example:\r\n\r\n    >>> import black\r\n    >>> print(black.format_str(\"def f(arg:str='')->None:...\", mode=black.Mode()))\r\n    def f(arg: str = \"\") -> None:\r\n        ...\r\n\r\n    A more complex example:\r\n\r\n    >>> print(\r\n    ...   black.format_str(\r\n    ...     \"def f(arg:str='')->None: hey\",\r\n    ...     mode=black.Mode(\r\n    ...       target_versions={black.TargetVersion.PY36},\r\n    ...       line_length=10,\r\n    ...       string_normalization=False,\r\n    ...       is_pyi=False,\r\n    ...     ),\r\n    ...   ),\r\n    ... )\r\n    def f(\r\n        arg: str = '',\r\n    ) -> None:\r\n        hey\r\n"]
[95.871249, "o", "\r\n    \"\"\"\r\n    if lines:\r\n        lines = sanitized_lines(lines, src_contents)\r\n        if not lines:\r\n            return src_contents  # Nothing to format\r\n    dst_contents = _format_str_once(src_contents, mode=mode, lines=lines)\r\n    # Forced second pass to work around optional trailing commas (becoming\r\n    # forced trailing commas on pass 2) interacting differently with optional\r\n    # parentheses.  Admittedly ugly.\r\n    if src_contents != dst_contents:\r\n        if lines:\r\n            lines = adjusted_lines(lines, src_contents, dst_contents)\r\n        return _format_str_once(dst_contents, mode=mode, lines=lines)\r\n    return dst_contents\r\n\r\n\r\ndef _format_str_once(\r\n    src_contents: str, *, mode: Mode, lines: Collection[tuple[int, int]] = ()\r\n"]
