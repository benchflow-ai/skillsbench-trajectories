[614.966485, "i", "cat > /app/black/fuzz.py <<'EOF'\nimport sys\nimport atheris\nimport black\nfrom black import Mode\n\n\ndef TestOneInput(data: bytes) -> None:\n    fdp = atheris.FuzzedDataProvider(data)\n    src = fdp.ConsumeUnicodeNoSurrogates(2000)\n    line_length = fdp.ConsumeIntInRange(1, 200)\n    mode = Mode(line_length=line_length)\n    try:\n        black.format_str(src, mode=mode)\n    except Exception:\n        pass\n    try:\n        black.format_file_contents(src, fast=True, mode=mode)\n    except Exception:\n        pass\n\n\nif __name__ == \"__main__\":\n    atheris.Setup(sys.argv, TestOneInput)\n    atheris.Fuzz()\nEOF\n"]
[614.966677, "o", "cat > /app/black/fuzz.py <<'EOF'\r\n> import sys\r\n> import atheris\r\n> import black\r\n> from black import Mode\r\n> \r\n> \r\n> def TestOneInput(data: bytes) -> None:\r\n>     fdp = atheris.FuzzedDataProvider(data)\r\n>     src = fdp.ConsumeUnicodeNoSurrogates(2000)\r\n>     line_length = fdp.ConsumeIntInRange(1, 200)\r\n>     mode = Mode(line_length=line_length)\r\n>     try:\r\n>         black.format_str(src, mode=mode)\r\n>     except Exception:\r\n>         pass\r\n>     try:\r\n>         black.format_file_contents(src, fast=True, mode=mode)\r\n>     except Exception:\r\n>         pass\r\n> \r\n> \r\n> if __name__ == \"__main__\":\r\n>     atheris.Setup(sys.argv, TestOneInput)\r\n>     atheris.Fuzz()\r\n> EOF\r\n"]
