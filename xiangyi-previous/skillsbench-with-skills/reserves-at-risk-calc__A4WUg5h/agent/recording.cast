[212.786104, "o", "STEP 2:\r\nRow 11: Belarus - 7471\r\nRow 12: Georgia - 1002\r\nRow 13 (Total exposure): 87485.88726999999\r\n\r\nSTEP 3:\r\nRow 20: Belarus - Gold: 7471, TotalRes: 14425.9\r\nRow 21: Georgia - Gold: 1002, TotalRes: 6158.7\r\nRow 22: Moldova - Gold: 10.71, TotalRes: 5999.34\r\nRow 23: Uzbekistan - Gold: 55092.42, TotalRes: 66311.75\r\nRow 24: Czechia International Reserves - Gold: 1.709170062856128, TotalRes: 175830.49\r\nRow 25: Latvia - Gold: 921.28, TotalRes: 6076.9\r\nRow 24 (RaR): 1.709170062856128\r\n"]
