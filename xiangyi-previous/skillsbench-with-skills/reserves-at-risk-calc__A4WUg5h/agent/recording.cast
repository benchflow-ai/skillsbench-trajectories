[174.730762, "o", "\u001b[?2004hroot@d62981c34b6f:~/output# "]
[182.143606, "i", "python3 << 'EOF'\nimport openpyxl\nimport numpy as np\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_value = wb['Value']\nws_volume = wb['Volume']\nws_answer = wb['Answer']\n\n# Consolidate countries - use Value data primarily\nconsolidated = {}\n\n# Add Value data\nfor col in range(3, 16):\n    col_letter = chr(64 + col)\n    country_desc = ws_value[f'{col_letter}1'].value\n    if country_desc:\n        country_name = country_desc.split(':')[0].strip()\n        value_2025 = ws_value[f'{col_letter}18'].value\n        if value_2025:\n            consolidated[country_name] = value_2025\n\n# Add Volume data for countries not in Value\navg_price_2025 = 2708.33\nfor col in range(3, 13):\n    col_letter = chr(64 + col)\n    country_desc = ws_volume[f'{col_letter}1'].value\n    if country_desc:\n        country_name = country_desc.split(':')[0].strip()\n        volume_2025 = ws_volume[f'{col_letter}18'].value\n        if volume_2025 and volume_2025 != '#N/A':\n            # Check if already in consolidated\n            found = False\n            for key in consolidated:\n                if country_name.lower() in key.lower() or key.lower() in country_name.lower():\n                    found = True\n                    break\n            if not found:\n                consolidated[country_name] = volume_2025 * avg_price_2025\n\nprint(f\"Consolidated countries: {len(consolidated)}\")\nfor country, value in consolidated.items():\n    print(f\"{country}: {value}\")\n\n# Fill in Answer sheet STEP 2\n# Row 11: Countries and values\nrow_offset = 10\ncol_offset = 2  # Column B\n\nfor idx, (country, value) in enumerate(consolidated.items()):\n    if idx < 10:  # Limit to 10 countries\n        # Country name in column B\n        ws_answer.cell(row=11+idx, column=2).value = country\n        # Value in column C\n        ws_answer.cell(row=11+idx, column=3).value = value\n\n# Calculate total gold exposure (sum of all values)\ntotal_exposure = sum(consolidated.values())\nws_answer['C13'] = total_exposure\n\nprint(f\"\\nTotal gold exposure: {total_exposure}\")\n\nwb.save('/root/output/rar_result.xlsx')\nprint(\"\\nFilled in Answer sheet STEP 2\")\nwb.close()\nEOF\n"]
