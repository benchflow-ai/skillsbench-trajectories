[182.147933, "o", "                if country_name.lower() in key.lower() or key.lower() in country_name.lower():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.148039, "o", "                    found = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.148076, "o", "> "]
[182.148173, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.148246, "o", "            if not found:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.148451, "o", "                consolidated[country_name] = volume_2025 * avg_price_2025\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.148485, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.148634, "o", "print(f\"Consolidated countries: {len(consolidated)}\")\r\n\u001b[?2004l\r"]
[182.148669, "o", "\u001b[?2004h> "]
[182.148794, "o", "for country, value in consolidated.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.148832, "o", "> "]
[182.148907, "o", "    print(f\"{country}: {value}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.14894, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[182.149011, "o", "> "]
[182.149044, "o", "# Fill in Answer sheet STEP 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.14908, "o", "> "]
[182.149169, "o", "# Row 11: Countries and values\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.149202, "o", "> "]
[182.149234, "o", "row_offset = 10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.149334, "o", "col_offset = 2  # Column B\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.14937, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.149551, "o", "for idx, (country, value) in enumerate(consolidated.items()):\r\n\u001b[?2004l\r\u001b[?2004h"]
[182.149585, "o", "> "]
[182.149689, "o", "    if idx < 10:  # Limit to 10 countries\r\n\u001b[?2004l\r"]
[182.149727, "o", "\u001b[?2004h> "]
[182.149811, "o", "        # Country name in column B\r\n\u001b[?2004l\r\u001b[?2004h> "]
[182.149975, "o", "        ws_answer.cell(row=11+idx, column=2).value = country\r\n\u001b[?2004l\r"]
[182.150013, "o", "\u001b[?2004h> "]
