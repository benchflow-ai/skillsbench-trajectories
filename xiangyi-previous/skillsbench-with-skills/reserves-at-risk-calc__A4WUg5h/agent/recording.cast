[197.309122, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_total_res = wb['Total Reserves']\n\n# Extract all countries and their 2025 total reserves\ntotal_res_countries = {}\nfor col in range(3, 16):\n    col_letter = chr(64 + col)\n    country_desc = ws_total_res[f'{col_letter}1'].value\n    if country_desc:\n        country_name = country_desc.split(':')[0].strip()\n        res_2025 = ws_total_res[f'{col_letter}18'].value\n        if res_2025:\n            total_res_countries[country_name] = res_2025\n            print(f\"{country_name}: {res_2025}\")\n\nprint(f\"\\nTotal countries with 2025 total reserves: {len(total_res_countries)}\")\n\n# STEP 2 countries\nstep2_countries = {\n    'Belarus': 7471,\n    'Georgia': 1002,\n    'Moldova': 10.71,\n    'Ukraine': 3877.64,\n    'Uzbekistan': 55092.42,\n    'Czechia International Reserves': 10121.89,\n    'Latvia': 921.28,\n    'Czechia Intl Reserves': 6229.159,\n    'Slovakia': 2759.7882699999996\n}\n\n# Find matches\nprint(\"\\n=== STEP 3 CANDIDATES ===\")\nstep3_data = {}\nfor country in step2_countries:\n    for tr_country, tr_value in total_res_countries.items():\n        if country.lower() in tr_country.lower() or tr_country.lower() in country.lower():\n            step3_data[country] = (step2_countries[country], tr_value)\n            print(f\"{country} -> {tr_country}: Gold={step2_countries[country]}, TotalRes={tr_value}\")\n            break\n\nprint(f\"\\nMatching countries for STEP 3: {len(step3_data)}\")\n\nwb.close()\nEOF\n"]
