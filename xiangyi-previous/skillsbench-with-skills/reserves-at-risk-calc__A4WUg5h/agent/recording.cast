[123.958161, "i", "python3 << 'EOF'\nimport openpyxl\nimport numpy as np\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_gold = wb['Gold price']\n\n# Clear columns C, D, E\nfor row in range(2, 430):\n    ws_gold[f'C{row}'].value = None\n    ws_gold[f'D{row}'].value = None\n    ws_gold[f'E{row}'].value = None\n\nwb.save('/root/output/rar_result.xlsx')\nwb.close()\n\nprint(\"Cleared columns C, D, E\")\nEOF\n"]
