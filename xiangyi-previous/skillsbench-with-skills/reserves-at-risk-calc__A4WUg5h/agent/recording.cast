[205.107049, "i", "python3 << 'EOF'\nimport openpyxl\nimport numpy as np\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_answer = wb['Answer']\nws_total_res = wb['Total Reserves']\n\n# STEP 3 data (only countries with 2025 total reserves)\nstep3_countries = [\n    ('Belarus', 7471, 14425.9),\n    ('Georgia', 1002, 6158.7),\n    ('Moldova', 10.71, 5999.34),\n    ('Uzbekistan', 55092.42, 66311.75),\n    ('Czechia International Reserves', 10121.89, 175830.49),\n    ('Latvia', 921.28, 6076.9)\n]\n\n# Fill in STEP 3 rows 20-22\nfor idx, (country, gold_value, total_res) in enumerate(step3_countries):\n    row = 20 + idx\n    ws_answer.cell(row=row, column=2).value = country  # Country name in column B\n    ws_answer.cell(row=row, column=3).value = gold_value  # Gold value in column C\n    ws_answer.cell(row=row, column=4).value = total_res  # Total reserves in column D\n\n# Calculate RaR in row 24\n# RaR = (Total Gold Value / Total Reserves) * 12-month volatility * Z-score\ntotal_gold_value = sum([gold for _, gold, _ in step3_countries])\ntotal_reserves = sum([res for _, _, res in step3_countries])\nvol_12m = 3.826395  # From STEP 1\nz_score = 1.645  # From STEP 1\n\nrar = (total_gold_value / total_reserves) * vol_12m * z_score\n\nprint(f\"Total Gold Value (STEP 3): {total_gold_value}\")\nprint(f\"Total Reserves (STEP 3): {total_reserves}\")\nprint(f\"12-month volatility: {vol_12m}\")\nprint(f\"Z-score: {z_score}\")\nprint(f\"RaR: {rar}\")\n\nws_answer['C24'] = rar\n\nwb.save('/root/output/rar_result.xlsx')\nprint(\"\\nFilled in Answer sheet STEP 3 and calculated RaR\")\nwb.close()\nEOF\n"]
