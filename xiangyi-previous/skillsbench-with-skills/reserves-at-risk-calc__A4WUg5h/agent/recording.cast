[157.022047, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_value = wb['Value']\nws_volume = wb['Volume']\nws_gold = wb['Gold price']\n\n# Get country names from Value sheet (row 1, starting from column C)\ncountries_value = {}\nfor col in range(3, 16):  # Columns C to O\n    col_letter = chr(64 + col)\n    country_desc = ws_value[f'{col_letter}1'].value\n    if country_desc:\n        # Extract country name\n        country_name = country_desc.split(':')[0].strip()\n        value_2025 = ws_value[f'{col_letter}18'].value\n        if value_2025:\n            countries_value[country_name] = value_2025\n            print(f\"Value sheet - {country_name}: {value_2025}\")\n\nprint(f\"\\nTotal countries with 2025 data in Value: {len(countries_value)}\")\n\n# Get country names from Volume sheet\nprint(\"\\n=== VOLUME SHEET ===\")\nfor row in range(1, 20):\n    values = [ws_volume[f'{chr(65+col)}{row}'].value for col in range(12)]\n    print(f\"Row {row}: {values}\")\n\nwb.close()\nEOF\n"]
