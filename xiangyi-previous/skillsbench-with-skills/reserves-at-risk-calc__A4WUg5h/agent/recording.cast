[89.553883, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_gold = wb['Gold price']\n\n# Add formulas for log returns (Column C)\n# Starting from row 3 since we need previous price\nfor row in range(3, 430):\n    formula = f'=IF(B{row}=\"\",\"\",LN(B{row}/B{row-1})*100)'\n    ws_gold[f'C{row}'] = formula\n\n# Add formulas for 3-month volatility (Column D)\n# Need at least 3 data points, so start from row 5\nfor row in range(5, 430):\n    formula = f'=IF(COUNT(C{row-2}:C{row})=3,STDEV(C{row-2}:C{row}),\"\")'\n    ws_gold[f'D{row}'] = formula\n\n# Add formulas for 12-month volatility (Column E)\n# Need at least 12 data points, so start from row 14\nfor row in range(14, 430):\n    formula = f'=IF(COUNT(C{row-11}:C{row})=12,STDEV(C{row-11}:C{row}),\"\")'\n    ws_gold[f'E{row}'] = formula\n\nwb.save('/root/output/rar_result.xlsx')\nprint(\"Added formulas for log returns and volatility calculations\")\nEOF\n"]
