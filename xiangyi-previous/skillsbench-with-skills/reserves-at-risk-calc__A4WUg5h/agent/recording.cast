[44.038072, "i", "python3 << 'EOF'\nimport requests\nimport json\nimport pandas as pd\nfrom datetime import datetime, timedelta\n\n# Try to fetch gold price data from IMF API with proper parameters\ntry:\n    # Try the datamapper API with gold commodity code\n    url = 'https://www.imf.org/external/datamapper/api/v1/datasets/COMMODITIES/data'\n    params = {\n        'periods': '2024M12',\n        'dimensions.GEO': 'US'\n    }\n    response = requests.get(url, params=params, timeout=10)\n    print(f\"Status: {response.status_code}\")\n    print(f\"Response: {response.text[:500]}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\n\n# Alternative: Try World Bank API\nprint(\"\\nTrying World Bank API...\")\ntry:\n    url = 'https://api.worldbank.org/v2/country/US/indicator/PNGOLD.USD'\n    response = requests.get(url, timeout=10)\n    print(f\"Status: {response.status_code}\")\n    if response.status_code == 200:\n        data = response.json()\n        print(f\"Found {len(data[1])} records\")\n        for record in data[1][:5]:\n            print(record)\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
