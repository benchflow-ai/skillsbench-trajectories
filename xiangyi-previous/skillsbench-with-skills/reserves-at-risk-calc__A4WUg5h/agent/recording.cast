[211.95301, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_answer = wb['Answer']\n\nprint(\"=== VERIFICATION OF ANSWER SHEET ===\")\nprint(\"\\nSTEP 1:\")\nprint(f\"Row 3 (Z-score): {ws_answer['C3'].value}\")\nprint(f\"Row 4 (3-month volatility): {ws_answer['C4'].value}\")\nprint(f\"Row 5 (3-month volatility annualized): {ws_answer['C5'].value}\")\nprint(f\"Row 6 (12-month volatility): {ws_answer['C6'].value}\")\n\nprint(\"\\nSTEP 2:\")\nfor row in range(11, 13):\n    country = ws_answer.cell(row=row, column=2).value\n    value = ws_answer.cell(row=row, column=3).value\n    print(f\"Row {row}: {country} - {value}\")\nprint(f\"Row 13 (Total exposure): {ws_answer['C13'].value}\")\n\nprint(\"\\nSTEP 3:\")\nfor row in range(20, 26):\n    country = ws_answer.cell(row=row, column=2).value\n    gold_val = ws_answer.cell(row=row, column=3).value\n    total_res = ws_answer.cell(row=row, column=4).value\n    if country:\n        print(f\"Row {row}: {country} - Gold: {gold_val}, TotalRes: {total_res}\")\nprint(f\"Row 24 (RaR): {ws_answer['C24'].value}\")\n\nwb.close()\nprint(\"\\n=== FILE SAVED ===\")\nprint(\"Location: /root/output/rar_result.xlsx\")\nEOF\n"]
