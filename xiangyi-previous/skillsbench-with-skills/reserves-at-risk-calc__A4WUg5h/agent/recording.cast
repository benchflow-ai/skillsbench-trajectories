[24.6544, "i", "python3 << 'EOF'\nimport requests\nimport json\nfrom datetime import datetime\n\n# Try to get commodity data from IMF API\nurl = 'https://www.imf.org/external/datamapper/api/v1/datasets/COMMODITIES'\nresponse = requests.get(url)\nprint(f\"Status: {response.status_code}\")\nprint(f\"Response length: {len(response.text)}\")\nif len(response.text) < 500:\n    print(response.text)\nEOF\n"]
