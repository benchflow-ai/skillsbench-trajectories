[205.108252, "o", "\u001b[?2004h> "]
[205.10836, "o", "    ('Uzbekistan', 55092.42, 66311.75),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.10844, "o", "    ('Czechia International Reserves', 10121.89, 175830.49),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.108568, "o", "    ('Latvia', 921.28, 6076.9)\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.108663, "o", "\u001b[?2004h> "]
[205.108707, "o", "# Fill in STEP 3 rows 20-22\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.108899, "o", "for idx, (country, gold_value, total_res) in enumerate(step3_countries):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.10896, "o", "    row = 20 + idx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.109051, "o", "    ws_answer.cell(row=row, column=2).value = country  # Country name in column B\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.109219, "o", "    ws_answer.cell(row=row, column=3).value = gold_value  # Gold value in column C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.109414, "o", "    ws_answer.cell(row=row, column=4).value = total_res  # Total reserves in column D\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.109452, "o", "> # Calculate RaR in row 24\r\n\u001b[?2004l\r"]
[205.109489, "o", "\u001b[?2004h> "]
[205.109634, "o", "# RaR = (Total Gold Value / Total Reserves) * 12-month volatility * Z-score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.109768, "o", "total_gold_value = sum([gold for _, gold, _ in step3_countries])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.109932, "o", "total_reserves = sum([res for _, _, res in step3_countries])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110016, "o", "vol_12m = 3.826395  # From STEP 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110092, "o", "z_score = 1.645  # From STEP 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.110169, "o", "> "]
[205.110239, "o", "rar = (total_gold_value / total_reserves) * vol_12m * z_score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110278, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110402, "o", "print(f\"Total Gold Value (STEP 3): {total_gold_value}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.110441, "o", "> "]
[205.11055, "o", "print(f\"Total Reserves (STEP 3): {total_reserves}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110649, "o", "print(f\"12-month volatility: {vol_12m}\")\r\n\u001b[?2004l\r"]
[205.110718, "o", "\u001b[?2004h> print(f\"Z-score: {z_score}\")\r\n\u001b[?2004l\r"]
[205.110756, "o", "\u001b[?2004h> "]
[205.110844, "o", "print(f\"RaR: {rar}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ws_answer['C24'] = rar\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.110882, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.110991, "o", "wb.save('/root/output/rar_result.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111076, "o", "print(\"\\nFilled in Answer sheet STEP 3 and calculated RaR\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.111159, "o", "wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[205.986415, "o", "Total Gold Value (STEP 3): 74619.3\r\nTotal Reserves (STEP 3): 274803.08\r\n12-month volatility: 3.826395\r\nZ-score: 1.645\r\nRaR: 1.7091700628561277\r\n"]
[206.151392, "o", "\r\nFilled in Answer sheet STEP 3 and calculated RaR\r\n"]
