[?2004l[?2004h> 
[?2004ls[?2004h> # Simple VAD-based diarization using Whisper segments
[?2004l[?2004h> # We'll use the segments from Whisper and assign speakers based on clustering
[?2004l[?2004h> segments = result["segments"]
[?2004l[?2004h> 
[?2004lr[?2004h> print(f"Found {len(segments)} segments")
[?2004l[?2004h> 
[?2004lo[?2004h> # For simplicity, we'll use a basic approach:
[?2004l[?2004h> # Extract audio features for each segment and cluster them
[?2004l[?2004h> from sklearn.cluster import AgglomerativeClustering
[?2004l[?2004h> import torchaudio
[?2004l[?2004h> 
[?2004l"[?2004h> # Load audio for feature extraction
[?2004l[?2004h> waveform, sample_rate = torchaudio.load(audio_path)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract MFCC features for each segment
[?2004l[?2004h> from torchaudio.transforms import MFCC
[?2004l[?2004h> mfcc_transform = MFCC(sample_rate=sample_rate, n_mfcc=13)
[?2004l[?2004h> 
[?2004l[?2004h> features_list = []
[?2004l[?2004h> valid_segments = []
[?2004l[?2004h> 
[?2004l[?2004h> for seg in segments:
[?2004l[?2004h>     start_sample = int(seg["start"] * sample_rate)
[?2004l[?2004h>     end_sample = int(seg["end"] * sample_rate)
[?2004l[?2004h>     segment_audio = waveform[:, start_sample:end_sample]
[?2004l[?2004h>     
[?2004l[?2004h>     if segment_audio.shape[1] > 0:
[?2004l[?2004h>         mfcc = mfcc_transform(segment_audio)
[?2004l[?2004h>         # Average over time
[?2004l[?2004h>         features = mfcc.mean(dim=2).squeeze().numpy()
[?2004l[?2004h>         features_list.append(features)
[?2004l[?2004h>         valid_segments.append(seg)
[?2004l[?2004h> 
[?2004l[?2004h> if len(features_list) > 0:
[?2004l[?2004h>     features_array = np.array(features_list)
[?2004l[?2004h>     
[?2004l[?2004h>     # Cluster to find speakers (try 2-4 speakers)
[?2004l[?2004h>     n_speakers = min(3, len(valid_segments))
[?2004l[?2004h>     if len(valid_segments) > 1:
[?2004l[?2004h>         clustering = AgglomerativeClustering(n_clusters=n_speakers)
[?2004l[?2004h>         labels = clustering.fit_predict(features_array)
[?2004l[?2004h>     else:
[?2004l[?2004h>         labels = [0]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Detected {n_speakers} speakers")
[?2004l[?2004h>     
[?2004l[?2004h>     # Assign speakers to segments
[?2004l[?2004h>     for i, seg in enumerate(valid_segments):
[?2004l[?2004h>         seg["speaker"] = f"SPEAKER_{labels[i]:02d}"
[?2004l[?2004h> else:
[?2004l[?2004h>     print("No valid segments found")
[?2004l[?2004h>     valid_segments = segments
[?2004l[?2004h>     for seg in valid_segments:
[?2004l[?2004h>         seg["speaker"] = "SPEAKER_00"
[?2004l[?2004h>     n_speakers = 1
[?2004l[?2004h> 
[?2004l[?2004h> print("Generating output files...")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate RTTM file
[?2004l[?2004h> with open("/root/diarization.rttm", "w") as f:
[?2004l[?2004h>     for seg in valid_segments:
[?2004l[?2004h>         start = seg["start"]
[?2004l[?2004h>         end = seg["end"]
[?2004l[?2004h>         duration = end - start
[?2004l[?2004h>         speaker = seg["speaker"].lower().replace("speaker_", "spk")
[?2004l[?2004h>         # RTTM format: SPEAKER <filename> <channel> <start> <duration> <NA> <NA> <speaker> <NA> <NA>
[?2004l[?2004h>         f.write(f"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Generated diarization.rttm")
[?2004l[?2004h> 
[?2004l[?2004h> # Generate ASS subtitle file
[?2004l[?2004h> def format_timestamp(seconds):
[?2004l[?2004h>     td = timedelta(seconds=seconds)
[?2004l[?2004h>     hours = int(td.total_seconds() // 3600)
[?2004l[?2004h>     minutes = int((td.total_seconds() % 3600) // 60)
[?2004l[?2004h>     secs = td.total_seconds() % 60
[?2004l[?2004h>     return f"{hours}:{minutes:02d}:{secs:05.2f}"
[?2004l[?2004h> 
[?2004l[?2004h> with open("/root/subtitles.ass", "w") as f:
[?2004l[?2004h>     f.write("[Events]\n")
[?2004l[?2004h>     f.write("Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n")
[?2004l[?2004h>     
[?2004l[?2004h>     for seg in valid_segments:
[?2004l[?2004h>         start_time = format_timestamp(seg["start"])
[?2004l[?2004h>         end_time = format_timestamp(seg["end"])
[?2004l[?2004h>         speaker = seg["speaker"]
[?2004l[?2004h>         text = seg["text"].strip()
[?2004l[?2004h>         f.write(f"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{speaker}: {text}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Generated subtitles.ass")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate total speech time
[?2004l[?2004h> total_speech_time = sum(seg["end"] - seg["start"] for seg in valid_segments)
[?2004l[?2004h> 
