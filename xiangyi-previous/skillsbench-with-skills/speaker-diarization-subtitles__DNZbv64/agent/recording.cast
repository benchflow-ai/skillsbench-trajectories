[567.533279, "o", "    td = timedelta(seconds=seconds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.533309, "o", "> "]
[567.533376, "o", "    hours = int(td.total_seconds() // 3600)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.533457, "o", "    minutes = int((td.total_seconds() % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.533483, "o", "> "]
[567.53355, "o", "    secs = td.total_seconds() % 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.533617, "o", "    return f\"{hours}:{minutes:02d}:{secs:05.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.533646, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[567.53367, "o", "> "]
[567.533771, "o", "with open(\"/root/subtitles.ass\", \"w\") as f:\r\n\u001b[?2004l\r"]
[567.533813, "o", "\u001b[?2004h> "]
[567.533919, "o", "    f.write(\"[Events]\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.534153, "o", "    f.write(\"Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\\n\")\r\n\u001b[?2004l\r"]
[567.534183, "o", "\u001b[?2004h> "]
[567.534257, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.53434, "o", "    for seg in valid_segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.534372, "o", "> "]
[567.534447, "o", "        start_time = format_timestamp(seg[\"start\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.534475, "o", "> "]
[567.534539, "o", "        end_time = format_timestamp(seg[\"end\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.534567, "o", "> "]
[567.534631, "o", "        speaker = seg[\"speaker\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.534685, "o", "        text = seg[\"text\"].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.534859, "o", "        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{speaker}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.534912, "o", "print(\"Generated subtitles.ass\")\r\n\u001b[?2004l\r"]
[567.534939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[567.534968, "o", "\u001b[?2004h> "]
[567.535038, "o", "# Calculate total speech time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.535156, "o", "total_speech_time = sum(seg[\"end\"] - seg[\"start\"] for seg in valid_segments)\r\n\u001b[?2004l\r"]
[567.535178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[567.535198, "o", "\u001b[?2004h> "]
[567.535256, "o", "# Generate report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.535276, "o", "report = {\r\n\u001b[?2004l\r"]
[567.535303, "o", "\u001b[?2004h> "]
[567.535381, "o", "    \"num_speakers_pred\": n_speakers,\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.53541, "o", "> "]
[567.535486, "o", "    \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.535513, "o", "> "]
[567.53563, "o", "    \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.535688, "o", "    \"steps_completed\": [\r\n\u001b[?2004l\r"]
[567.535716, "o", "\u001b[?2004h> "]
[567.535785, "o", "        \"audio_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.535833, "o", "        \"speech_recognition\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.535855, "o", "> "]
[567.535921, "o", "        \"feature_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.535949, "o", "> "]
[567.536022, "o", "        \"speaker_clustering\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.536049, "o", "> "]
[567.536114, "o", "        \"diarization\",\r\n\u001b[?2004l\r"]
[567.536143, "o", "\u001b[?2004h> "]
[567.536219, "o", "        \"subtitle_generation\"\r\n\u001b[?2004l\r"]
[567.536244, "o", "\u001b[?2004h> "]
[567.536272, "o", "    ],\r\n\u001b[?2004l\r"]
[567.536474, "o", "\u001b[?2004h> "]
[567.536511, "o", "    \"commands_used\": [\"ffmpeg\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h>     \"libraries_used\": [\r\n\u001b[?2004l\r\u001b[?2004h>         \"torch\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.536541, "o", "> "]
[567.536641, "o", "        \"whisper\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"torchaudio\",\r\n\u001b[?2004l\r"]
[567.536705, "o", "\u001b[?2004h> "]
[567.536732, "o", "        \"sklearn\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.536807, "o", "        \"numpy\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.536843, "o", ">         \"wave\"\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r"]
[567.536867, "o", "\u001b[?2004h> "]
[567.536955, "o", "    \"tools_used\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.537042, "o", "        \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r"]
[567.537147, "o", "\u001b[?2004h> "]
[567.537225, "o", "        \"speech_recognition\": \"openai-whisper (tiny model)\",\r\n\u001b[?2004l\r"]
[567.537255, "o", "\u001b[?2004h> "]
[567.537366, "o", "        \"feature_extraction\": \"torchaudio MFCC\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.537429, "o", "> "]
[567.5375, "o", "        \"speaker_clustering\": \"sklearn AgglomerativeClustering\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.537596, "o", "        \"diarization\": \"MFCC-based clustering approach\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.53767, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.537974, "o", "    \"notes\": f\"Processed {len(valid_segments)} speech segments. Used Whisper tiny model for faster transcription on CPU, and MFCC features with agglomerative clustering for speaker diarization.\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[567.538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[567.538021, "o", "> "]
[567.538105, "o", "with open(\"/root/report.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.538204, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.538279, "o", "> \r\n\u001b[?2004l\r"]
[567.538312, "o", "\u001b[?2004h> print(\"Generated report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.538342, "o", "> "]
[567.538425, "o", "print(\"\\nDiarization complete!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.538503, "o", "print(f\"Speakers detected: {n_speakers}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.538608, "o", "print(f\"Total speech time: {total_speech_time:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[567.538727, "o", "print(f\"Audio duration: {audio_duration:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[567.538759, "o", "> EOF\r\n\u001b[?2004l\r"]
[567.539997, "o", "\u001b[?2004hroot@a89f9b301129:~# "]
[567.666273, "i", "python3 diarize_fast.py\n"]
[567.666445, "o", "python3 diarize_fast.py\r\n\u001b[?2004l\r"]
