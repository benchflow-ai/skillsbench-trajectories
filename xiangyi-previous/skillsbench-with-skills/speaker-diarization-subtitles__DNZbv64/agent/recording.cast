[55.497179, "o", "    valid_segments = segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.497258, "o", "    for seg in valid_segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.497309, "o", "        seg[\"speaker\"] = \"SPEAKER_00\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.497344, "o", "> "]
[55.497377, "o", "    n_speakers = 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.49741, "o", "> "]
[55.497444, "o", "print(\"Generating output files...\")\r\n\u001b[?2004l\r"]
[55.497476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.497624, "o", "# Generate RTTM file\r\n\u001b[?2004l\r\u001b[?2004h> with open(\"/root/diarization.rttm\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.497658, "o", "    for seg in valid_segments:\r\n\u001b[?2004l\r"]
[55.497692, "o", "\u001b[?2004h> "]
[55.497726, "o", "        start = seg[\"start\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.497758, "o", "> "]
[55.497887, "o", "        end = seg[\"end\"]\r\n\u001b[?2004l\r\u001b[?2004h>         duration = end - start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.497958, "o", "        speaker = seg[\"speaker\"].lower().replace(\"speaker_\", \"spk\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.497995, "o", "> "]
[55.498145, "o", "        # RTTM format: SPEAKER <filename> <channel> <start> <duration> <NA> <NA> <speaker> <NA> <NA>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498274, "o", "        f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.498313, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498373, "o", "print(\"Generated diarization.rttm\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[55.498409, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[55.498503, "o", "# Generate ASS subtitle file\r\n\u001b[?2004l\r\u001b[?2004h> def format_timestamp(seconds):\r\n\u001b[?2004l\r"]
[55.498537, "o", "\u001b[?2004h> "]
[55.498609, "o", "    td = timedelta(seconds=seconds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498735, "o", "    hours = int(td.total_seconds() // 3600)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498792, "o", "    minutes = int((td.total_seconds() % 3600) // 60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498887, "o", "    secs = td.total_seconds() % 60\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.498934, "o", "    return f\"{hours}:{minutes:02d}:{secs:05.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499023, "o", "with open(\"/root/subtitles.ass\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499079, "o", "    f.write(\"[Events]\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499223, "o", "    f.write(\"Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.499294, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499345, "o", "    for seg in valid_segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499406, "o", "        start_time = format_timestamp(seg[\"start\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.499442, "o", "> "]
[55.499512, "o", "        end_time = format_timestamp(seg[\"end\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.499562, "o", "        speaker = seg[\"speaker\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.499612, "o", "> "]
[55.499643, "o", "        text = seg[\"text\"].strip()\r\n\u001b[?2004l\r"]
[55.499759, "o", "\u001b[?2004h> "]
[55.499834, "o", "        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{speaker}: {text}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.49987, "o", "\u001b[?2004h> "]
[55.499904, "o", "print(\"Generated subtitles.ass\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.499937, "o", "\u001b[?2004h> "]
[55.499967, "o", "# Calculate total speech time\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.499999, "o", "> "]
[55.500121, "o", "total_speech_time = sum(seg[\"end\"] - seg[\"start\"] for seg in valid_segments)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.500156, "o", "> # Generate report\r\n\u001b[?2004l\r"]
[55.50019, "o", "\u001b[?2004h> report = {\r\n\u001b[?2004l\r"]
[55.500226, "o", "\u001b[?2004h> "]
[55.500341, "o", "    \"num_speakers_pred\": n_speakers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.500375, "o", "    \"total_speech_time_sec\": round(total_speech_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.500467, "o", "    \"audio_duration_sec\": round(audio_duration, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.500526, "o", ">     \"steps_completed\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.500576, "o", "        \"audio_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.500612, "o", "> "]
[55.500692, "o", "        \"speech_recognition\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.500732, "o", ">         \"feature_extraction\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.500761, "o", "        \"speaker_clustering\",\r\n\u001b[?2004l\r"]
[55.500798, "o", "\u001b[?2004h> "]
[55.500912, "o", "        \"diarization\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.500948, "o", "        \"subtitle_generation\"\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501027, "o", "    \"commands_used\": [\"ffmpeg\", \"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501079, "o", "    \"libraries_used\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501115, "o", "        \"torch\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501151, "o", "        \"whisper\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501219, "o", "        \"torchaudio\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.50126, "o", "        \"sklearn\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501289, "o", "        \"numpy\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501329, "o", "        \"wave\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501361, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501396, "o", "    \"tools_used\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.501429, "o", "> "]
[55.501633, "o", "        \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"speech_recognition\": \"openai-whisper (base model)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501667, "o", "        \"feature_extraction\": \"torchaudio MFCC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.501767, "o", "        \"speaker_clustering\": \"sklearn AgglomerativeClustering\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.5018, "o", "> "]
[55.501867, "o", "        \"diarization\": \"MFCC-based clustering approach\"\r\n\u001b[?2004l\r"]
[55.501901, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[55.501928, "o", "\u001b[?2004h> "]
[55.502245, "o", "    \"notes\": f\"Processed {len(valid_segments)} speech segments. Used Whisper for transcription with word-level timestamps, and MFCC features with agglomerative clustering for speaker diarization.\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.502271, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.502358, "o", "with open(\"/root/report.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.50242, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[55.502442, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[55.502773, "o", "print(\"Generated report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nDiarization complete!\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Speakers detected: {n_speakers}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.502856, "o", "print(f\"Total speech time: {total_speech_time:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.502971, "o", "print(f\"Audio duration: {audio_duration:.2f}s\")\r\n\u001b[?2004l\r"]
[55.503023, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[55.508904, "o", "\u001b[?2004hroot@a89f9b301129:~# "]
[55.646618, "i", "python3 diarize.py\n"]
[55.64686, "o", "python3 diarize.py\r\n\u001b[?2004l\r"]
