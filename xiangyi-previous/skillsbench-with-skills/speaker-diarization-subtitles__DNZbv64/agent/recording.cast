[55.490071, "i", "cat > diarize.py << 'EOF'\nimport torch\nimport whisper\nimport json\nimport wave\nfrom speechbrain.pretrained import SpeakerRecognition\nfrom pyannote.core import Segment, Annotation\nimport numpy as np\nfrom datetime import timedelta\n\nprint(\"Loading models...\")\n\n# Load Whisper for transcription\nwhisper_model = whisper.load_model(\"base\")\n\n# Load audio\naudio_path = \"/root/audio.wav\"\nprint(f\"Processing {audio_path}...\")\n\n# Get audio duration\nwith wave.open(audio_path, 'rb') as wf:\n    frames = wf.getnframes()\n    rate = wf.getframerate()\n    audio_duration = frames / float(rate)\n\nprint(f\"Audio duration: {audio_duration:.2f} seconds\")\n\n# Transcribe with Whisper (includes word-level timestamps)\nprint(\"Transcribing audio...\")\nresult = whisper_model.transcribe(audio_path, word_timestamps=True, language=\"en\")\n\nprint(\"Performing speaker diarization...\")\n\n# Simple VAD-based diarization using Whisper segments\n# We'll use the segments from Whisper and assign speakers based on clustering\nsegments = result[\"segments\"]\n\nprint(f\"Found {len(segments)} segments\")\n\n# For simplicity, we'll use a basic approach:\n# Extract audio features for each segment and cluster them\nfrom sklearn.cluster import AgglomerativeClustering\nimport torchaudio\n\n# Load audio for feature extraction\nwaveform, sample_rate = torchaudio.load(audio_path)\n\n# Extract MFCC features for each segment\nfrom torchaudio.transforms import MFCC\nmfcc_transform = MFCC(sample_rate=sample_rate, n_mfcc=13)\n\nfeatures_list = []\nvalid_segments = []\n\nfor seg in segments:\n    start_sample = int(seg[\"start\"] * sample_rate)\n    end_sample = int(seg[\"end\"] * sample_rate)\n    segment_audio = waveform[:, start_sample:end_sample]\n    \n    if segment_audio.shape[1] > 0:\n        mfcc = mfcc_transform(segment_audio)\n        # Average over time\n        features = mfcc.mean(dim=2).squeeze().numpy()\n        features_list.append(features)\n        valid_segments.append(seg)\n\nif len(features_list) > 0:\n    features_array = np.array(features_list)\n    \n    # Cluster to find speakers (try 2-4 speakers)\n    n_speakers = min(3, len(valid_segments))\n    if len(valid_segments) > 1:\n        clustering = AgglomerativeClustering(n_clusters=n_speakers)\n        labels = clustering.fit_predict(features_array)\n    else:\n        labels = [0]\n    \n    print(f\"Detected {n_speakers} speakers\")\n    \n    # Assign speakers to segments\n    for i, seg in enumerate(valid_segments):\n        seg[\"speaker\"] = f\"SPEAKER_{labels[i]:02d}\"\nelse:\n    print(\"No valid segments found\")\n    valid_segments = segments\n    for seg in valid_segments:\n        seg[\"speaker\"] = \"SPEAKER_00\"\n    n_speakers = 1\n\nprint(\"Generating output files...\")\n\n# Generate RTTM file\nwith open(\"/root/diarization.rttm\", \"w\") as f:\n    for seg in valid_segments:\n        start = seg[\"start\"]\n        end = seg[\"end\"]\n        duration = end - start\n        speaker = seg[\"speaker\"].lower().replace(\"speaker_\", \"spk\")\n        # RTTM format: SPEAKER <filename> <channel> <start> <duration> <NA> <NA> <speaker> <NA> <NA>\n        f.write(f\"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n\")\n\nprint(\"Generated diarization.rttm\")\n\n# Generate ASS subtitle file\ndef format_timestamp(seconds):\n    td = timedelta(seconds=seconds)\n    hours = int(td.total_seconds() // 3600)\n    minutes = int((td.total_seconds() % 3600) // 60)\n    secs = td.total_seconds() % 60\n    return f\"{hours}:{minutes:02d}:{secs:05.2f}\"\n\nwith open(\"/root/subtitles.ass\", \"w\") as f:\n    f.write(\"[Events]\\n\")\n    f.write(\"Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\\n\")\n    \n    for seg in valid_segments:\n        start_time = format_timestamp(seg[\"start\"])\n        end_time = format_timestamp(seg[\"end\"])\n        speaker = seg[\"speaker\"]\n        text = seg[\"text\"].strip()\n        f.write(f\"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{speaker}: {text}\\n\")\n\nprint(\"Generated subtitles.ass\")\n\n# Calculate total speech time\ntotal_speech_time = sum(seg[\"end\"] - seg[\"start\"] for seg in valid_segments)\n\n# Generate report\nreport = {\n    \"num_speakers_pred\": n_speake"]
[55.490253, "i", "rs,\n    \"total_speech_time_sec\": round(total_speech_time, 2),\n    \"audio_duration_sec\": round(audio_duration, 2),\n    \"steps_completed\": [\n        \"audio_extraction\",\n        \"speech_recognition\",\n        \"feature_extraction\",\n        \"speaker_clustering\",\n        \"diarization\",\n        \"subtitle_generation\"\n    ],\n    \"commands_used\": [\"ffmpeg\", \"python3\"],\n    \"libraries_used\": [\n        \"torch\",\n        \"whisper\",\n        \"torchaudio\",\n        \"sklearn\",\n        \"numpy\",\n        \"wave\"\n    ],\n    \"tools_used\": {\n        \"audio_extraction\": \"ffmpeg\",\n        \"speech_recognition\": \"openai-whisper (base model)\",\n        \"feature_extraction\": \"torchaudio MFCC\",\n        \"speaker_clustering\": \"sklearn AgglomerativeClustering\",\n        \"diarization\": \"MFCC-based clustering approach\"\n    },\n    \"notes\": f\"Processed {len(valid_segments)} speech segments. Used Whisper for transcription with word-level timestamps, and MFCC features with agglomerative clustering for speaker diarization.\"\n}\n\nwith open(\"/root/report.json\", \"w\") as f:\n    json.dump(report, f, indent=2)\n\nprint(\"Generated report.json\")\nprint(\"\\nDiarization complete!\")\nprint(f\"Speakers detected: {n_speakers}\")\nprint(f\"Total speech time: {total_speech_time:.2f}s\")\nprint(f\"Audio duration: {audio_duration:.2f}s\")\nEOF\n"]
