[?2004hroot@132d65a1e378:~# cat > recover_budget.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load workbook
[?2004l[?2004h> wb = load_workbook('nasa_budget_incomplete.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 1: Budget by Directorate
[?2004l[?2004h> ws1 = wb['Budget by Directorate']
[?2004l[?2004h> 
[?2004l[?2004h> # Read data to find missing values and calculate them
[?2004l[?2004h> df1 = pd.read_excel('nasa_budget_incomplete.xlsx', sheet_name='Budget by Directorate', header=1)
[?2004l[?2004h> 
[?2004l[?2004h> print("Analyzing Budget by Directorate...")
[?2004l[?2004h> print(df1)
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate missing values in Budget sheet
[?2004l[?2004h> # Row 3 (2016) - Total is missing
[?2004l[?2004h> row_2016 = [5589, 640, 687, 4030, 5029, 115, 2769, 389, 37]
[?2004l[?2004h> total_2016 = sum(row_2016)
[?2004l[?2004h> print(f"\n2016 Total: {total_2016}")
[?2004l[?2004h> ws1['K4'] = total_2016  # Row 4 in Excel (index 3 in df + header)
[?2004l[?2004h> 
[?2004l[?2004h> # Row 6 (2019) - Space Operations is missing
[?2004l[?2004h> # Total for 2019 is 21688
[?2004l[?2004h> row_2019_known = [6906, 725, 927, 5047, 110, 2755, 538, 41]
[?2004l[?2004h> total_2019 = 21688
[?2004l[?2004h> space_ops_2019 = total_2019 - sum(row_2019_known)
[?2004l[?2004h> print(f"2019 Space Operations: {space_ops_2019}")
[?2004l[?2004h> ws1['F8'] = space_ops_2019
[?2004l[?2004h> 
[?2004l[?2004h> # Row 7 (2020) - Science is missing
[?2004l[?2004h> row_2020_known = [819, 1100, 6017, 3989, 120, 2913, 373, 43]
[?2004l[?2004h> total_2020 = 22513
[?2004l[?2004h> science_2020 = total_2020 - sum(row_2020_known)
[?2004l[?2004h> print(f"2020 Science: {science_2020}")
[?2004l[?2004h> ws1['C9'] = science_2020
[?2004l[?2004h> 
[?2004l[?2004h> # Row 8 (2021) - Exploration and Total are missing
[?2004l[?2004h> # First get Total from YoY change: 2020 total * (1 + 3.43/100)
[?2004l[?2004h> total_2021 = round(total_2020 * (1 + 3.43/100))
[?2004l[?2004h> print(f"2021 Total: {total_2021}")
[?2004l[?2004h> ws1['K10'] = total_2021
[?2004l[?2004h> 
[?2004l[?2004h> # Now calculate Exploration
[?2004l[?2004h> row_2021_known = [7301, 829, 1100, 3986, 127, 2953, 390, 44]
[?2004l[?2004h> exploration_2021 = total_2021 - sum(row_2021_known)
[?2004l[?2004h> print(f"2021 Exploration: {exploration_2021}")
[?2004l[?2004h> ws1['F10'] = exploration_2021
[?2004l[?2004h> 
[?2004l[?2004h> # Row 10 (2023) - Aeronautics is missing
[?2004l[?2004h> row_2023_known = [8262, 1192, 7618, 4256, 143, 3106, 424, 47]
[?2004l[?2004h> total_2023 = 25984
[?2004l[?2004h> aero_2023 = total_2023 - sum(row_2023_known)
[?2004l[?2004h> print(f"2023 Aeronautics: {aero_2023}")
[?2004l[?2004h> ws1['D12'] = aero_2023
[?2004l[?2004h> 
[?2004l[?2004h> print("\n" + "="*80)
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 2: YoY Changes (%)
[?2004l[?2004h> ws2 = wb['YoY Changes (%)']
[?2004l[?2004h> df2 = pd.read_excel('nasa_budget_incomplete.xlsx', sheet_name='YoY Changes (%)', header=1)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAnalyzing YoY Changes...")
[?2004l[?2004h> 
[?2004l[?2004h> # 2019 Space Technology YoY change
[?2004l[?2004h> # From budget: 2019=927, 2018=760
[?2004l[?2004h> yoy_space_tech_2019 = round(((927 - 760) / 760) * 100, 2)
[?2004l[?2004h> print(f"2019 Space Technology YoY: {yoy_space_tech_2019}%")
[?2004l[?2004h> ws2['D7'] = yoy_space_tech_2019
[?2004l[?2004h> 
[?2004l[?2004h> # 2021 Science YoY change
[?2004l[?2004h> # From budget: 2021=7301, 2020=science_2020
[?2004l[?2004h> yoy_science_2021 = round(((7301 - science_2020) / science_2020) * 100, 2)
[?2004l[?2004h> print(f"2021 Science YoY: {yoy_science_2021}%")
[?2004l[?2004h> ws2['C9'] = yoy_science_2021
[?2004l[?2004h> 
[?2004l[?2004h> # 2021 Space Operations YoY change
[?2004l[?2004h> # From budget: 2021=3986, 2020=3989
[?2004l[?2004h> yoy_space_ops_2021 = round(((3986 - 3989) / 3989) * 100, 2)
[?2004l[?2004h> print(f"2021 Space Operations YoY: {yoy_space_ops_2021}%")
[?2004l[?2004h> ws2['F9'] = yoy_space_ops_2021
[?2004l[?2004h> 
[?2004l[?2004h> print("\n" + "="*80)
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 3: Directorate Shares (%)
[?2004l[?2004h> ws3 = wb['Directorate Shares (%)']
[?2004l[?2004h> df3 = pd.read_excel('nasa_budget_incomplete.xlsx', sheet_name='Directorate Shares (%)', header=1)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAnalyzing Directorate Shares...")
[?2004l[?2004h> 
[?2004l[?2004h> # 2016 Space Operations share
[?2004l[?2004h> # Budget: 5029, Total: total_2016
[?2004l[?2004h> share_space_ops_2016 = round((5029 / total_2016) * 100, 2)
[?2004l[?2004h> print(f"2016 Space Operations Share: {share_space_ops_2016}%")
[?2004l[?2004h> ws3['F5'] = share_space_ops_2016
[?2004l[?2004h> 
[?2004l[?2004h> # 2021 Science share
[?2004l[?2004h> # Budget: 7301, Total: total_2021
[?2004l[?2004h> share_science_2021 = round((7301 / total_2021) * 100, 2)
[?2004l[?2004h> print(f"2021 Science Share: {share_science_2021}%")
[?2004l[?2004h> ws3['C10'] = share_science_2021
[?2004l[?2004h> 
[?2004l[?2004h> print("\n" + "="*80)
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 4: Growth Analysis
[?2004l[?2004h> ws4 = wb['Growth Analysis']
[?2004l[?2004h> df4 = pd.read_excel('nasa_budget_incomplete.xlsx', sheet_name='Growth Analysis', header=1)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAnalyzing Growth Analysis...")
[?2004l[?2004h> 
[?2004l[?2004h> # FY2019 Exploration (from budget sheet)
[?2004l[?2004h> exploration_2019 = 5047
[?2004l[?2004h> print(f"FY2019 Exploration: {exploration_2019}")
[?2004l[?2004h> ws4['E5'] = exploration_2019
[?2004l[?2004h> 
[?2004l[?2004h> # 5-Year CAGR for Exploration
[?2004l[?2004h> # CAGR = ((FY2024/FY2019)^(1/5) - 1) * 100
[?2004l[?2004h> exploration_2024 = 7618
[?2004l[?2004h> cagr_exploration = round(((exploration_2024 / exploration_2019) ** (1/5) - 1) * 100, 2)
[?2004l[?2004h> print(f"Exploration 5-Year CAGR: {cagr_exploration}%")
[?2004l[?2004h> ws4['E4'] = cagr_exploration
[?2004l[?2004h> 
[?2004l[?2004h> # 5-Year Change for Science
[?2004l[?2004h> science_2019 = 6906
[?2004l[?2004h> science_2024 = 8440
[?2004l[?2004h> change_science = science_2024 - science_2019
[?2004l[?2004h> print(f"Science 5-Year Change: {change_science}")
[?2004l[?2004h> ws4['C7'] = change_science
[?2004l[?2004h> 
[?2004l[?2004h> # Average Annual Budget for Science
[?2004l[?2004h> avg_science = round((science_2019 + science_2020 + 7301 + 7614 + 8262 + science_2024) / 6, 1)
[?2004l[?2004h> print(f"Science Avg Annual Budget: {avg_science}")
[?2004l[?2004h> ws4['C8'] = avg_science
[?2004l[?2004h> 
[?2004l[?2004h> print("\n" + "="*80)
[?2004l[?2004h> print("\nSaving recovered budget to nasa_budget_recovered.xlsx...")
