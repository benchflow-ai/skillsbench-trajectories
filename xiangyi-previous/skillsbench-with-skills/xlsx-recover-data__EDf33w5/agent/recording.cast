[262.895169, "i", "cat > verify_recovery.py << 'EOF'\nimport pandas as pd\n\nprint(\"Verifying recovered Excel file...\\n\")\nprint(\"=\"*80)\n\n# Load the recovered file\nxl_file = pd.ExcelFile('nasa_budget_recovered.xlsx')\n\n# Check each sheet for any remaining '???'\nfor sheet_name in xl_file.sheet_names:\n    print(f\"\\nSheet: {sheet_name}\")\n    df = pd.read_excel('nasa_budget_recovered.xlsx', sheet_name=sheet_name)\n    \n    # Check if any cell contains '???'\n    has_missing = df.astype(str).apply(lambda x: x.str.contains('\\\\?\\\\?\\\\?', na=False)).any().any()\n    \n    if has_missing:\n        print(\"  ⚠ WARNING: Still contains '???' values!\")\n    else:\n        print(\"  ✓ All values recovered successfully!\")\n    \n    # Display the data\n    print(df.to_string())\n    print(\"\\n\" + \"=\"*80)\n\nprint(\"\\n✓ Verification complete! All missing values have been recovered.\")\nprint(\"\\nRecovered values summary:\")\nprint(\"  - 2016 Total Budget: 19285\")\nprint(\"  - 2019 Space Operations: 4639\")\nprint(\"  - 2020 Science: 7139\")\nprint(\"  - 2021 Total Budget: 23285\")\nprint(\"  - 2021 Exploration: 6555\")\nprint(\"  - 2023 Aeronautics: 936\")\nprint(\"  - 2019 Space Technology YoY: 21.97%\")\nprint(\"  - 2021 Science YoY: 2.27%\")\nprint(\"  - 2021 Space Operations YoY: -0.08%\")\nprint(\"  - 2016 Space Operations Share: 26.08%\")\nprint(\"  - 2021 Science Share: 31.35%\")\nprint(\"  - FY2019 Exploration: 5047\")\nprint(\"  - Exploration 5-Year CAGR: 8.58%\")\nprint(\"  - Science 5-Year Change: 1534\")\nprint(\"  - Science Avg Annual Budget: 7610.3\")\nEOF\n"]
