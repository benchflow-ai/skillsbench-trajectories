[293.557695, "i", "cat > recover_budget_v2.py << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load workbook\nwb = load_workbook('nasa_budget_incomplete.xlsx')\n\nprint(\"Searching for and replacing '???' values...\\n\")\n\n# Dictionary to store calculated values by sheet and position\nreplacements = {}\n\n# Sheet 1: Budget by Directorate\nws1 = wb['Budget by Directorate']\n\n# Find all cells with '???'\nfor row in ws1.iter_rows():\n    for cell in row:\n        if cell.value == '???':\n            print(f\"Found '???' in {ws1.title} at {cell.coordinate}\")\n            \n            # Determine which value to replace based on row/column\n            if cell.coordinate == 'K3':  # 2015 Total (should be 19487, already correct)\n                continue\n            elif cell.coordinate == 'K4':  # 2016 Total\n                value = 19285\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2016 Total)\")\n            elif cell.coordinate == 'F8':  # 2019 Space Operations\n                value = 4639\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2019 Space Operations)\")\n            elif cell.coordinate == 'C9':  # 2020 Science\n                value = 7139\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2020 Science)\")\n            elif cell.coordinate == 'F10':  # 2021 Exploration\n                value = 6555\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2021 Exploration)\")\n            elif cell.coordinate == 'K10':  # 2021 Total\n                value = 23285\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2021 Total)\")\n            elif cell.coordinate == 'D12':  # 2023 Aeronautics\n                value = 936\n                cell.value = value\n                print(f\"  -> Replaced with {value} (2023 Aeronautics)\")\n\n# Sheet 2: YoY Changes (%)\nws2 = wb['YoY Changes (%)']\n\nfor row in ws2.iter_rows():\n    for cell in row:\n        if cell.value == '???':\n            print(f\"Found '???' in {ws2.title} at {cell.coordinate}\")\n            \n            if cell.coordinate == 'D7':  # 2019 Space Technology YoY\n                value = 21.97\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (2019 Space Technology YoY)\")\n            elif cell.coordinate == 'C9':  # 2021 Science YoY\n                value = 2.27\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (2021 Science YoY)\")\n            elif cell.coordinate == 'F9':  # 2021 Space Operations YoY\n                value = -0.08\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (2021 Space Operations YoY)\")\n\n# Sheet 3: Directorate Shares (%)\nws3 = wb['Directorate Shares (%)']\n\nfor row in ws3.iter_rows():\n    for cell in row:\n        if cell.value == '???':\n            print(f\"Found '???' in {ws3.title} at {cell.coordinate}\")\n            \n            if cell.coordinate == 'F5':  # 2016 Space Operations Share\n                value = 26.08\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (2016 Space Operations Share)\")\n            elif cell.coordinate == 'C10':  # 2021 Science Share\n                value = 31.35\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (2021 Science Share)\")\n\n# Sheet 4: Growth Analysis\nws4 = wb['Growth Analysis']\n\nfor row in ws4.iter_rows():\n    for cell in row:\n        if cell.value == '???':\n            print(f\"Found '???' in {ws4.title} at {cell.coordinate}\")\n            \n            if cell.coordinate == 'E4':  # Exploration 5-Year CAGR\n                value = 8.58\n                cell.value = value\n                print(f\"  -> Replaced with {value}% (Exploration 5-Year CAGR)\")\n            elif cell.coordinate == 'E5':  # FY2019 Exploration\n                value = 5047\n                cell.value = value\n                print(f\"  -> Replaced with {value} (FY2019 Exploration)\")\n            elif cell.coordinate == 'C7':  #"]
[293.557766, "i", " Science 5-Year Change\n                value = 1534\n                cell.value = value\n                print(f\"  -> Replaced with {value} (Science 5-Year Change)\")\n            elif cell.coordinate == 'C8':  # Science Avg Annual Budget\n                value = 7610.3\n                cell.value = value\n                print(f\"  -> Replaced with {value} (Science Avg Annual Budget)\")\n\nprint(\"\\nSaving recovered budget to nasa_budget_recovered.xlsx...\")\nwb.save('nasa_budget_recovered.xlsx')\nprint(\"Done!\")\nEOF\n"]
