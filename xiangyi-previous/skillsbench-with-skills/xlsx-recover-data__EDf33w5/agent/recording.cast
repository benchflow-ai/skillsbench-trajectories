[326.147967, "i", "cat > recover_budget_final.py << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load workbook\nwb = load_workbook('nasa_budget_incomplete.xlsx')\n\nprint(\"Recovering all missing values...\\n\")\n\n# Sheet 1: Budget by Directorate\nws1 = wb['Budget by Directorate']\n\n# Calculate and replace missing values\n# K5: 2016 Total\nrow_2016 = [5589, 640, 687, 4030, 5029, 115, 2769, 389, 37]\nws1['K5'] = sum(row_2016)\nprint(f\"K5 (2016 Total): {sum(row_2016)}\")\n\n# F8: 2019 Space Operations\nrow_2019_known = [6906, 725, 927, 5047, 110, 2755, 538, 41]\nws1['F8'] = 21688 - sum(row_2019_known)\nprint(f\"F8 (2019 Space Operations): {21688 - sum(row_2019_known)}\")\n\n# B9: 2020 Science\nrow_2020_known = [819, 1100, 6017, 3989, 120, 2913, 373, 43]\nws1['B9'] = 22513 - sum(row_2020_known)\nprint(f\"B9 (2020 Science): {22513 - sum(row_2020_known)}\")\n\n# E10: 2021 Exploration\ntotal_2021 = round(22513 * (1 + 3.43/100))\nrow_2021_known = [7301, 829, 1100, 3986, 127, 2953, 390, 44]\nws1['E10'] = total_2021 - sum(row_2021_known)\nprint(f\"E10 (2021 Exploration): {total_2021 - sum(row_2021_known)}\")\n\n# K10: 2021 Total\nws1['K10'] = total_2021\nprint(f\"K10 (2021 Total): {total_2021}\")\n\n# C12: 2023 Aeronautics\nrow_2023_known = [8262, 1192, 7618, 4256, 143, 3106, 424, 47]\nws1['C12'] = 25984 - sum(row_2023_known)\nprint(f\"C12 (2023 Aeronautics): {25984 - sum(row_2023_known)}\")\n\n# Sheet 2: YoY Changes (%)\nws2 = wb['YoY Changes (%)']\n\n# D7: 2019 Space Technology YoY\nws2['D7'] = round(((927 - 760) / 760) * 100, 2)\nprint(f\"D7 (2019 Space Tech YoY): {round(((927 - 760) / 760) * 100, 2)}%\")\n\n# B9: 2021 Science YoY\nscience_2020 = 22513 - sum(row_2020_known)\nws2['B9'] = round(((7301 - science_2020) / science_2020) * 100, 2)\nprint(f\"B9 (2021 Science YoY): {round(((7301 - science_2020) / science_2020) * 100, 2)}%\")\n\n# F9: 2021 Space Operations YoY\nws2['F9'] = round(((3986 - 3989) / 3989) * 100, 2)\nprint(f\"F9 (2021 Space Ops YoY): {round(((3986 - 3989) / 3989) * 100, 2)}%\")\n\n# Sheet 3: Directorate Shares (%)\nws3 = wb['Directorate Shares (%)']\n\n# F5: 2016 Space Operations Share\ntotal_2016 = sum(row_2016)\nws3['F5'] = round((5029 / total_2016) * 100, 2)\nprint(f\"F5 (2016 Space Ops Share): {round((5029 / total_2016) * 100, 2)}%\")\n\n# B10: 2021 Science Share\nws3['B10'] = round((7301 / total_2021) * 100, 2)\nprint(f\"B10 (2021 Science Share): {round((7301 / total_2021) * 100, 2)}%\")\n\n# Sheet 4: Growth Analysis\nws4 = wb['Growth Analysis']\n\n# E4: Exploration 5-Year CAGR\nws4['E4'] = round(((7618 / 5047) ** (1/5) - 1) * 100, 2)\nprint(f\"E4 (Exploration CAGR): {round(((7618 / 5047) ** (1/5) - 1) * 100, 2)}%\")\n\n# E5: FY2019 Exploration\nws4['E5'] = 5047\nprint(f\"E5 (FY2019 Exploration): 5047\")\n\n# B7: Science 5-Year Change\nws4['B7'] = 8440 - 6906\nprint(f\"B7 (Science 5-Year Change): {8440 - 6906}\")\n\n# B8: Science Avg Annual Budget\nws4['B8'] = round((6906 + science_2020 + 7301 + 7614 + 8262 + 8440) / 6, 1)\nprint(f\"B8 (Science Avg Annual): {round((6906 + science_2020 + 7301 + 7614 + 8262 + 8440) / 6, 1)}\")\n\nprint(\"\\nSaving recovered budget to nasa_budget_recovered.xlsx...\")\nwb.save('nasa_budget_recovered.xlsx')\nprint(\"✓ All missing values recovered successfully!\")\nEOF\n"]
[326.148556, "o", "cat > recover_budget_final.py << 'EOF'"]
