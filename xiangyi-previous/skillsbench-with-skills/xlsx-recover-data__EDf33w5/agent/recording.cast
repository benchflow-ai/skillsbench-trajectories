[191.561667, "i", "cat > examine_excel.py << 'EOF'\nimport pandas as pd\nimport openpyxl\n\n# Load the Excel file\nxl_file = pd.ExcelFile('nasa_budget_incomplete.xlsx')\n\nprint(\"Sheet names:\")\nprint(xl_file.sheet_names)\nprint(\"\\n\" + \"=\"*80 + \"\\n\")\n\n# Read and display each sheet\nfor sheet_name in xl_file.sheet_names:\n    print(f\"Sheet: {sheet_name}\")\n    df = pd.read_excel('nasa_budget_incomplete.xlsx', sheet_name=sheet_name)\n    print(df.to_string())\n    print(\"\\n\" + \"=\"*80 + \"\\n\")\nEOF\n"]
