[355.449089, "i", "cat > final_summary.py << 'EOF'\nimport pandas as pd\n\nprint(\"=\"*80)\nprint(\"NASA BUDGET RECOVERY - FINAL SUMMARY\")\nprint(\"=\"*80)\n\nprint(\"\\n✓ Successfully recovered nasa_budget_recovered.xlsx\")\nprint(\"\\nAll missing values ('???') have been replaced with computed numeric values:\\n\")\n\nprint(\"BUDGET BY DIRECTORATE:\")\nprint(\"  • 2016 Total Budget: 19,285 million\")\nprint(\"  • 2019 Space Operations: 4,639 million\")\nprint(\"  • 2020 Science: 7,139 million\")\nprint(\"  • 2021 Exploration: 6,555 million\")\nprint(\"  • 2021 Total Budget: 23,285 million\")\nprint(\"  • 2023 Aeronautics: 936 million\")\n\nprint(\"\\nYEAR-OVER-YEAR CHANGES (%):\")\nprint(\"  • 2019 Space Technology: 21.97%\")\nprint(\"  • 2021 Science: 2.27%\")\nprint(\"  • 2021 Space Operations: -0.08%\")\n\nprint(\"\\nDIRECTORATE SHARES (%):\")\nprint(\"  • 2016 Space Operations: 26.08%\")\nprint(\"  • 2021 Science: 31.35%\")\n\nprint(\"\\nGROWTH ANALYSIS (FY2019-2024):\")\nprint(\"  • Exploration 5-Year CAGR: 8.58%\")\nprint(\"  • FY2019 Exploration Budget: 5,047 million\")\nprint(\"  • Science 5-Year Change: 1,534 million\")\nprint(\"  • Science Average Annual Budget: 7,610.3 million\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"VERIFICATION: Checking for any remaining '???' values...\")\nprint(\"=\"*80)\n\nxl_file = pd.ExcelFile('nasa_budget_recovered.xlsx')\nall_clean = True\n\nfor sheet_name in xl_file.sheet_names:\n    df = pd.read_excel('nasa_budget_recovered.xlsx', sheet_name=sheet_name)\n    has_missing = df.astype(str).apply(lambda x: x.str.contains('\\\\?\\\\?\\\\?', na=False)).any().any()\n    \n    if has_missing:\n        print(f\"  ✗ {sheet_name}: Still has missing values\")\n        all_clean = False\n    else:\n        print(f\"  ✓ {sheet_name}: Clean\")\n\nif all_clean:\n    print(\"\\n\" + \"=\"*80)\n    print(\"✓✓✓ SUCCESS! All missing values recovered successfully! ✓✓✓\")\n    print(\"=\"*80)\nelse:\n    print(\"\\n⚠ Warning: Some values may still be missing\")\nEOF\n"]
