[175.179734, "o", "                curr_event.append(events[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.179785, "o", ">             else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179896, "o", "                unique_events.append(np.median(curr_event))\r\n\u001b[?2004l\r\u001b[?2004h> "]
