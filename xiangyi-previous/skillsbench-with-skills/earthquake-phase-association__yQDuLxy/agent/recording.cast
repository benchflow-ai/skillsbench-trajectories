[175.177056, "i", "cat << 'EOF' > associate.py\nimport pandas as pd\nimport numpy as np\nfrom datetime import timedelta\n\npicks = pd.read_csv('picks.csv')\npicks['time'] = pd.to_datetime(picks['time'])\n\n# Match P and S picks at the same station\nevents = []\nfor station, s_picks in picks.groupby('station'):\n    ps = s_picks[s_picks['phase'] == 'P']\n    ss = s_picks[s_picks['phase'] == 'S']\n    \n    for _, p in ps.iterrows():\n        for _, s in ss.iterrows():\n            dt = (s['time'] - p['time']).total_seconds()\n            if 0 < dt < 20:\n                # t0 = tp - dt / (1.75 - 1)\n                t0 = p['time'] - timedelta(seconds=dt / 0.75)\n                events.append(t0.timestamp())\n\nif not events:\n    # Fallback to just P picks if no P-S pairs\n    print('No P-S pairs found, using P picks')\n    events = picks[picks['phase'] == 'P']['time'].apply(lambda x: x.timestamp()).tolist()\n\nevents.sort()\n\n# Simple clustering: group times within 5 seconds\nif not events:\n    unique_events = []\nelse:\n    unique_events = []\n    if events:\n        curr_event = [events[0]]\n        for i in range(1, len(events)):\n            if events[i] - np.median(curr_event) < 5:\n                curr_event.append(events[i])\n            else:\n                unique_events.append(np.median(curr_event))\n                curr_event = [events[i]]\n        unique_events.append(np.median(curr_event))\n\n# Convert back to ISO format\nimport datetime\nresults = []\nfor t in unique_events:\n    dt = datetime.datetime.fromtimestamp(t, tz=datetime.timezone.utc).replace(tzinfo=None)\n    results.append({'time': dt.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3]})\n\nres_df = pd.DataFrame(results)\nres_df.to_csv('/root/results.csv', index=False)\nprint(f'Found {len(res_df)} events.')\nEOF\npython3 associate.py\n"]
[175.177303, "o", "cat << 'EOF' > associate.py\r\n\u001b[?2004l\r"]
