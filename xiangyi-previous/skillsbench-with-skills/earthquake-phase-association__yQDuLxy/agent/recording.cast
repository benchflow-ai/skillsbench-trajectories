[21.372333, "i", "cat << 'EOF' > pick_phases.py\nimport seisbench.models as sbm\nimport obspy\nimport pandas as pd\n\n# Load model\nmodel = sbm.PhaseNet.from_pretrained(\"ethz\")\n\n# Load waveforms\nst = obspy.read('/root/data/wave.mseed')\n\n# Picking\npicks = model.classify(st, batch_size=256, threshold=0.1)\n\n# Convert picks to a DataFrame\npick_list = []\nfor p in picks:\n    pick_list.append({\n        \"network\": p.trace_id.split('.')[0],\n        \"station\": p.trace_id.split('.')[1],\n        \"phase\": p.phase,\n        \"time\": p.peak_time.datetime,\n        \"prob\": p.peak_value\n    })\n\ndf_picks = pd.DataFrame(pick_list)\ndf_picks.to_csv(\"picks.csv\", index=False)\nprint(f\"Picked {len(df_picks)} phases.\")\nEOF\npython3 pick_phases.py\n"]
