[175.179205, "o", "# Simple clustering: group times within 5 seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179268, "o", "if not events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179324, "o", "    unique_events = []\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[175.179376, "o", "\u001b[?2004h>     unique_events = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.179431, "o", ">     if events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179487, "o", "        curr_event = [events[0]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179556, "o", "        for i in range(1, len(events)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.179609, "o", "> "]
