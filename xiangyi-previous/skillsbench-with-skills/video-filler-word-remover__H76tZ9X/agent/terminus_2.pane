[?2004l[?2004h> 
[?2004l[?2004h> # Filler words to detect
[?2004l[?2004h> FILLER_WORDS = [
[?2004l[?2004h>     'um', 'uh', 'hum', 'hmm', 'mhm',
[?2004l[?2004h>     'like',
[?2004l[?2004h>     'you know',
[?2004l[?2004h>     'i mean',
[?2004l[?2004h>     'yeah',
[?2004l[?2004h>     'so',
[?2004l[?2004h>     'kind of',
[?2004l[?2004h>     'basically',
[?2004l[?2004h>     'i guess',
[?2004l[?2004h>     'well',
[?2004l[?2004h>     'okay'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def extract_audio(video_path, audio_path):
[?2004l[?2004h>     """Extract audio from video"""
[?2004l[?2004h>     print("Extracting audio from video...")
[?2004l[?2004h>     cmd = [
[?2004l[?2004h>         'ffmpeg',
[?2004l[?2004h>         '-i', video_path,
[?2004l[?2004h>         '-q:a', '9',
[?2004l[?2004h>         '-n',
[?2004l[?2004h>         audio_path
[?2004l[?2004h>     ]
[?2004l[?2004h>     subprocess.run(cmd, capture_output=True, check=True)
[?2004l[?2004h>     print(f"Audio extracted to {audio_path}")
[?2004l[?2004h> 
[?2004l[?2004h> def transcribe_audio(audio_path):
[?2004l[?2004h>     """Transcribe audio using Whisper tiny model"""
[?2004l[?2004h>     print("Loading Whisper tiny model...")
[?2004l[?2004h>     model = whisper.load_model("tiny")
[?2004l[?2004h>     
[?2004l[?2004h>     print("Transcribing audio...")
[?2004l[?2004h>     result = model.transcribe(audio_path, language="en", verbose=True)
[?2004l[?2004h>     return result
[?2004l[?2004h> 
[?2004l[?2004h> def detect_filler_words(result):
[?2004l[?2004h>     """Detect filler words from transcription result"""
[?2004l[?2004h>     annotations = []
[?2004l[?2004h>     seen = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Process segments to find filler words
[?2004l[?2004h>     for segment in result['segments']:
[?2004l[?2004h>         text = segment['text'].lower().strip()
[?2004l[?2004h>         start_time = segment['start']
[?2004l[?2004h>         end_time = segment['end']
[?2004l[?2004h>         
[?2004l[?2004h>         # Check each filler word
[?2004l[?2004h>         for filler in FILLER_WORDS:
[?2004l[?2004h>             if filler in text:
[?2004l[?2004h>                 # Find all occurrences
[?2004l[?2004h>                 words = text.split()
[?2004l[?2004h>                 filler_words = filler.split()
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Find positions
[?2004l[?2004h>                 for i in range(len(words) - len(filler_words) + 1):
[?2004l[?2004h>                     if ' '.join(words[i:i+len(filler_words)]) == filler:
[?2004l[?2004h>                         # Estimate timestamp based on word position
[?2004l[?2004h>                         word_duration = (end_time - start_time) / max(len(words), 1)
[?2004l[?2004h>                         timestamp = start_time + (i * word_duration)
[?2004l[?2004h>                         
[?2004l[?2004h>                         # Avoid duplicates
[?2004l[?2004h>                         key = (filler, round(timestamp, 1))
[?2004l[?2004h>                         if key not in seen:
[?2004l[?2004h>                             annotations.append({
[?2004l[?2004h>                                 "word": filler,
[?2004l[?2004h>                                 "timestamp": round(timestamp, 1)
[?2004l[?2004h>                             })
[?2004l[?2004h>                             seen.add(key)
[?2004l[?2004h>     
[?2004l[?2004h>     return annotations
[?2004l[?2004h> 
[?2004l[?2004h> def extract_and_stitch_clips(video_path, annotations, output_path):
[?2004l[?2004h>     """Extract clips at filler word timestamps and stitch them"""
[?2004l[?2004h>     if not annotations:
[?2004l[?2004h>         print("No filler words found!")
[?2004l[?2004h>         # Create empty video
[?2004l[?2004h>         cmd = ['ffmpeg', '-f', 'lavfi', '-i', 'color=c=black:s=1280x720:d=1', 
[?2004l[?2004h>                '-f', 'lavfi', '-i', 'anullsrc=r=44100:cl=mono:d=1',
[?2004l[?2004h>                '-c:v', 'libx264', '-c:a', 'aac', '-y', output_path]
[?2004l[?2004h>         subprocess.run(cmd, capture_output=True)
[?2004l[?2004h>         return
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Extracting {len(annotations)} clips...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Create a temporary directory for clips
[?2004l[?2004h>     clips_dir = "/tmp/filler_clips"
[?2004l[?2004h>     os.makedirs(clips_dir, exist_ok=True)
[?2004l[?2004h>     
[?2004l[?2004h>     clip_files = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract each clip (0.5 seconds around each filler word)
[?2004l[?2004h>     for i, annotation in enumerate(annotations):
[?2004l[?2004h>         timestamp = annotation['timestamp']
[?2004l[?2004h>         start = max(0, timestamp - 0.25)
[?2004l[?2004h>         duration = 0.5
[?2004l[?2004h>         
[?2004l[?2004h>         clip_path = f"{clips_dir}/clip_{i:04d}.mp4"
[?2004l[?2004h>         
[?2004l[?2004h>         cmd = [
[?2004l[?2004h>             'ffmpeg',
[?2004l[?2004h>             '-i', video_path,
[?2004l[?2004h>             '-ss', str(start),
[?2004l[?2004h>             '-t', str(duration),
[?2004l[?2004h>             '-c:v', 'libx264',
[?2004l[?2004h>             '-preset', 'ultrafast',
[?2004l[?2004h>             '-c:a', 'aac',
[?2004l[?2004h>             '-y',
[?2004l[?2004h>             clip_path
[?2004l[?2004h>         ]
[?2004l[?2004h>         
[?2004l[?2004h>         result = subprocess.run(cmd, capture_output=True)
[?2004l[?2004h>         if result.returncode == 0:
[?2004l[?2004h>             clip_files.append(clip_path)
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f"Warning: Failed to extract clip {i}")
[?2004l[?2004h>     
[?2004l[?2004h>     if not clip_files:
[?2004l[?2004h>         print("No clips extracted!")
[?2004l[?2004h>         return
[?2004l[?2004h>     
[?2004l[?2004h>     # Create concat file for ffmpeg
[?2004l[?2004h>     concat_file = "/tmp/concat.txt"
[?2004l[?2004h>     with open(concat_file, 'w') as f:
[?2004l[?2004h>         for clip_file in clip_files:
[?2004l[?2004h>             f.write(f"file '{clip_file}'\n")
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Stitching {len(clip_files)} clips...")
[?2004l[?2004h>     
[?2004l[?2004h>     # Concat clips
[?2004l[?2004h>     cmd = [
[?2004l[?2004h>         'ffmpeg',
[?2004l[?2004h>         '-f', 'concat',
[?2004l[?2004h>         '-safe', '0',
[?2004l[?2004h>         '-i', concat_file,
[?2004l[?2004h>         '-c:v', 'libx264',
[?2004l[?2004h>         '-preset', 'ultrafast',
[?2004l[?2004h>         '-c:a', 'aac',
[?2004l[?2004h>         '-y',
[?2004l[?2004h>         output_path
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     result = subprocess.run(cmd, capture_output=True)
[?2004l[?2004h>     if result.returncode != 0:
[?2004l[?2004h>         print(f"Error stitching clips: {result.stderr.decode()}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Clean up
[?2004l[?2004h>     for clip_file in clip_files:
[?2004l[?2004h>         try:
[?2004l[?2004h>             os.remove(clip_file)
[?2004l[?2004h>         except:
[?2004l[?2004h>             pass
[?2004l[?2004h>     try:
[?2004l[?2004h>         os.remove(concat_file)
[?2004l[?2004h>         os.rmdir(clips_dir)
[?2004l[?2004h>     except:
[?2004l[?2004h>         pass
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Output video saved to {output_path}")
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     input_video = "/root/input.mp4"
[?2004l[?2004h>     audio_file = "/tmp/audio.mp3"
[?2004l[?2004h>     output_json = "/root/annotations.json"
[?2004l[?2004h>     output_video = "/root/output.mp4"
[?2004l[?2004h>     
