[1165.814803, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[1165.830242, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.0.1\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m25.3\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[1165.895223, "o", "\u001b[?2004hroot@f4e78564dc03:~# "]
[1211.010128, "i", "cat > /root/process_video_v3.py << 'EOF'\nimport speech_recognition as sr\nimport json\nimport subprocess\nimport os\nfrom pydub import AudioSegment\nfrom pydub.utils import mediainfo\nimport re\n\n# Filler words to detect\nFILLER_WORDS = [\n    'um', 'uh', 'hum', 'hmm', 'mhm',\n    'like',\n    'you know',\n    'i mean',\n    'yeah',\n    'so',\n    'kind of',\n    'basically',\n    'i guess',\n    'well',\n    'okay'\n]\n\ndef extract_audio(video_path, audio_path):\n    \"\"\"Extract audio from video\"\"\"\n    print(\"Extracting audio from video...\")\n    cmd = [\n        'ffmpeg',\n        '-i', video_path,\n        '-q:a', '9',\n        '-n',\n        audio_path\n    ]\n    result = subprocess.run(cmd, capture_output=True)\n    if result.returncode == 0:\n        print(f\"Audio extracted to {audio_path}\")\n    else:\n        print(f\"Error extracting audio: {result.stderr.decode()}\")\n\ndef transcribe_audio_chunks(audio_path, chunk_duration=30000):\n    \"\"\"Transcribe audio in chunks using SpeechRecognition\"\"\"\n    print(\"Loading audio file...\")\n    audio = AudioSegment.from_file(audio_path)\n    \n    recognizer = sr.Recognizer()\n    full_text = \"\"\n    segments = []\n    \n    # Split audio into chunks\n    num_chunks = (len(audio) + chunk_duration - 1) // chunk_duration\n    print(f\"Transcribing {num_chunks} chunks...\")\n    \n    for i in range(num_chunks):\n        start = i * chunk_duration\n        end = min((i + 1) * chunk_duration, len(audio))\n        chunk = audio[start:end]\n        \n        # Export chunk to wav\n        chunk_path = f\"/tmp/chunk_{i}.wav\"\n        chunk.export(chunk_path, format=\"wav\")\n        \n        try:\n            with sr.AudioFile(chunk_path) as source:\n                audio_data = recognizer.record(source)\n                text = recognizer.recognize_google(audio_data)\n                \n                start_time = start / 1000.0\n                end_time = end / 1000.0\n                \n                segments.append({\n                    'text': text,\n                    'start': start_time,\n                    'end': end_time\n                })\n                \n                full_text += \" \" + text\n                print(f\"Chunk {i+1}/{num_chunks}: {text[:50]}...\")\n        except sr.UnknownValueError:\n            print(f\"Chunk {i+1}/{num_chunks}: [Could not understand audio]\")\n        except sr.RequestError as e:\n            print(f\"Chunk {i+1}/{num_chunks}: Error - {e}\")\n        finally:\n            os.remove(chunk_path)\n    \n    return {'segments': segments, 'text': full_text}\n\ndef detect_filler_words(result):\n    \"\"\"Detect filler words from transcription result\"\"\"\n    annotations = []\n    seen = set()\n    \n    # Process segments to find filler words\n    for segment in result['segments']:\n        text = segment['text'].lower().strip()\n        start_time = segment['start']\n        end_time = segment['end']\n        \n        # Check each filler word\n        for filler in FILLER_WORDS:\n            # Use word boundaries for better matching\n            pattern = r'\\b' + re.escape(filler) + r'\\b'\n            matches = re.finditer(pattern, text)\n            \n            for match in matches:\n                # Estimate timestamp based on character position\n                char_pos = match.start()\n                text_length = len(text)\n                if text_length > 0:\n                    relative_pos = char_pos / text_length\n                    timestamp = start_time + (relative_pos * (end_time - start_time))\n                else:\n                    timestamp = start_time\n                \n                # Avoid duplicates\n                key = (filler, round(timestamp, 1))\n                if key not in seen:\n                    annotations.append({\n                        \"word\": filler,\n                        \"timestamp\": round(timestamp, 1)\n                    })\n                    seen.add(key)\n    \n    return annotations\n\ndef extract_and_stitch_clips(video_path, annotations, output_path):\n    \"\"\"Extract clips at filler word timestamps and stitch them\"\"\"\n    if not annotations:\n        print(\"No filler words found!\")\n        # Create empty "]
[1211.010205, "i", "video\n        cmd = ['ffmpeg', '-f', 'lavfi', '-i', 'color=c=black:s=1280x720:d=1', \n               '-f', 'lavfi', '-i', 'anullsrc=r=44100:cl=mono:d=1',\n               '-c:v', 'libx264', '-preset', 'ultrafast', '-c:a', 'aac', '-y', output_path]\n        subprocess.run(cmd, capture_output=True)\n        return\n    \n    print(f\"Extracting {len(annotations)} clips...\")\n    \n    # Create a temporary directory for clips\n    clips_dir = \"/tmp/filler_clips\"\n    os.makedirs(clips_dir, exist_ok=True)\n    \n    clip_files = []\n    \n    # Extract each clip (0.5 seconds around each filler word)\n    for i, annotation in enumerate(annotations):\n        timestamp = annotation['timestamp']\n        start = max(0, timestamp - 0.25)\n        duration = 0.5\n        \n        clip_path = f\"{clips_dir}/clip_{i:04d}.mp4\"\n        \n        cmd = [\n            'ffmpeg',\n            '-i', video_path,\n            '-ss', str(start),\n            '-t', str(duration),\n            '-c:v', 'libx264',\n            '-preset', 'ultrafast',\n            '-c:a', 'aac',\n            '-y',\n            clip_path\n        ]\n        \n        result = subprocess.run(cmd, capture_output=True)\n        if result.returncode == 0:\n            clip_files.append(clip_path)\n        else:\n            print(f\"Warning: Failed to extract clip {i}\")\n    \n    if not clip_files:\n        print(\"No clips extracted!\")\n        return\n    \n    # Create concat file for ffmpeg\n    concat_file = \"/tmp/concat.txt\"\n    with open(concat_file, 'w') as f:\n        for clip_file in clip_files:\n            f.write(f\"file '{clip_file}'\\n\")\n    \n    print(f\"Stitching {len(clip_files)} clips...\")\n    \n    # Concat clips\n    cmd = [\n        'ffmpeg',\n        '-f', 'concat',\n        '-safe', '0',\n        '-i', concat_file,\n        '-c:v', 'libx264',\n        '-preset', 'ultrafast',\n        '-c:a', 'aac',\n        '-y',\n        output_path\n    ]\n    \n    result = subprocess.run(cmd, capture_output=True)\n    if result.returncode != 0:\n        print(f\"Error stitching clips: {result.stderr.decode()}\")\n    \n    # Clean up\n    for clip_file in clip_files:\n        try:\n            os.remove(clip_file)\n        except:\n            pass\n    try:\n        os.remove(concat_file)\n        os.rmdir(clips_dir)\n    except:\n        pass\n    \n    print(f\"Output video saved to {output_path}\")\n\ndef main():\n    input_video = \"/root/input.mp4\"\n    audio_file = \"/tmp/audio.mp3\"\n    output_json = \"/root/annotations.json\"\n    output_video = \"/root/output.mp4\"\n    \n    # Extract audio\n    extract_audio(input_video, audio_file)\n    \n    # Transcribe\n    result = transcribe_audio_chunks(audio_file)\n    \n    # Detect filler words\n    annotations = detect_filler_words(result)\n    \n    # Save annotations\n    with open(output_json, 'w') as f:\n        json.dump(annotations, f, indent=2)\n    \n    print(f\"Saved {len(annotations)} annotations to {output_json}\")\n    print(f\"Annotations: {annotations}\")\n    \n    # Extract and stitch clips\n    extract_and_stitch_clips(input_video, annotations, output_video)\n    \n    # Clean up audio\n    try:\n        os.remove(audio_file)\n    except:\n        pass\n    \n    print(\"Done!\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[1211.010592, "o", "cat > /root/process_video_v3.py << 'EOF'\r\n\u001b[?2004l\r"]
[1211.010677, "o", "\u001b[?2004h> "]
[1211.010822, "o", "import speech_recognition as sr\r\n\u001b[?2004l\r"]
[1211.010884, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[1211.010944, "o", "\u001b[?2004h> "]
[1211.011009, "o", "import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.011059, "o", "import os\r\n\u001b[?2004l\r"]
[1211.011092, "o", "\u001b[?2004h> "]
[1211.011209, "o", "from pydub import AudioSegment\r\n\u001b[?2004l\ro\u001b[?2004h"]
[1211.011267, "o", "> "]
[1211.01133, "o", "from pydub.utils import mediainfo\r\n\u001b[?2004l\r"]
[1211.011397, "o", "\u001b[?2004h> import re\r\n\u001b[?2004l\r'"]
[1211.011461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r-\u001b[?2004h> "]
[1211.011534, "o", "# Filler words to detect\r\n\u001b[?2004l\r"]
[1211.011592, "o", "\u001b[?2004h> "]
[1211.011649, "o", "FILLER_WORDS = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.011806, "o", "    'um', 'uh', 'hum', 'hmm', 'mhm',\r\n\u001b[?2004l\r"]
[1211.011876, "o", "\u001b[?2004h>     'like',\r\n\u001b[?2004l\r"]
[1211.011943, "o", "\u001b[?2004h>     'you know',\r\n\u001b[?2004l\r "]
[1211.011998, "o", "\u001b[?2004h> "]
[1211.012061, "o", "    'i mean',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.012117, "o", "    'yeah',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.012178, "o", "    'so',\r\n\u001b[?2004l\rc\u001b[?2004h"]
[1211.012231, "o", "> "]
[1211.012293, "o", "    'kind of',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.012361, "o", "    'basically',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.012424, "o", "> "]
[1211.012481, "o", "    'i guess',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.012539, "o", "    'well',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.012595, "o", "    'okay'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.012662, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[1211.012842, "o", "def extract_audio(video_path, audio_path):\r\n\u001b[?2004l\r"]
[1211.012872, "o", "\u001b[?2004h> "]
[1211.012999, "o", "    \"\"\"Extract audio from video\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.013175, "o", "    print(\"Extracting audio from video...\")\r\n\u001b[?2004l\r"]
[1211.013242, "o", "\u001b[?2004h> "]
[1211.013301, "o", "    cmd = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.013361, "o", "        'ffmpeg',\r\n\u001b[?2004l\r"]
[1211.013419, "o", "\u001b[?2004h> "]
[1211.013488, "o", "        '-i', video_path,\r\n\u001b[?2004l\r"]
[1211.013547, "o", "\u001b[?2004h> "]
[1211.013606, "o", "        '-q:a', '9',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.013662, "o", "> "]
[1211.013716, "o", "        '-n',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.01379, "o", "        audio_path\r\n\u001b[?2004l\r"]
[1211.013842, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[1211.013896, "o", "\u001b[?2004h> "]
[1211.014066, "o", "    result = subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r"]
[1211.014127, "o", "\u001b[?2004h> "]
[1211.014211, "o", "    if result.returncode == 0:\r\n\u001b[?2004l\r"]
[1211.014271, "o", "\u001b[?2004h> "]
[1211.014412, "o", "        print(f\"Audio extracted to {audio_path}\")\r\n\u001b[?2004l\r"]
[1211.014476, "o", "\u001b[?2004h> "]
[1211.014532, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.014787, "o", "        print(f\"Error extracting audio: {result.stderr.decode()}\")\r\n\u001b[?2004l\r"]
[1211.014815, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1211.015086, "o", "def transcribe_audio_chunks(audio_path, chunk_duration=30000):\r\n\u001b[?2004l\r"]
[1211.015148, "o", "\u001b[?2004h> "]
[1211.015332, "o", "    \"\"\"Transcribe audio in chunks using SpeechRecognition\"\"\"\r\n\u001b[?2004l\r"]
[1211.01539, "o", "\u001b[?2004h> "]
[1211.015507, "o", "    print(\"Loading audio file...\")\r\n\u001b[?2004l\r"]
[1211.015564, "o", "\u001b[?2004h> "]
[1211.015714, "o", "    audio = AudioSegment.from_file(audio_path)\r\n\u001b[?2004l\r"]
[1211.015777, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.015922, "o", "    recognizer = sr.Recognizer()\r\n\u001b[?2004l\r"]
[1211.01598, "o", "\u001b[?2004h> "]
[1211.016036, "o", "    full_text = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.016094, "o", "> "]
[1211.016152, "o", "    segments = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1211.016209, "o", "\u001b[?2004h> "]
[1211.01629, "o", "    # Split audio into chunks\r\n\u001b[?2004l\r"]
[1211.016343, "o", "\u001b[?2004h> "]
[1211.016593, "o", "    num_chunks = (len(audio) + chunk_duration - 1) // chunk_duration\r\n\u001b[?2004l\r"]
[1211.016653, "o", "\u001b[?2004h> "]
[1211.016814, "o", "    print(f\"Transcribing {num_chunks} chunks...\")\r\n\u001b[?2004l\r"]
[1211.016873, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.01695, "o", "> "]
[1211.01701, "o", "    for i in range(num_chunks):\r\n\u001b[?2004l\r"]
[1211.017084, "o", "\u001b[?2004h> "]
[1211.017178, "o", "        start = i * chunk_duration\r\n\u001b[?2004l\r"]
[1211.017248, "o", "\u001b[?2004h> "]
[1211.017436, "o", "        end = min((i + 1) * chunk_duration, len(audio))\r\n\u001b[?2004l\r"]
[1211.017536, "o", "\u001b[?2004h> "]
[1211.017656, "o", "        chunk = audio[start:end]\r\n\u001b[?2004l\r"]
[1211.017745, "o", "\u001b[?2004h> "]
[1211.017825, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.017981, "o", "        # Export chunk to wav\r\n\u001b[?2004l\r"]
[1211.018073, "o", "\u001b[?2004h> "]
[1211.018271, "o", "        chunk_path = f\"/tmp/chunk_{i}.wav\"\r\n\u001b[?2004l\r"]
[1211.018354, "o", "\u001b[?2004h> "]
[1211.01861, "o", "        chunk.export(chunk_path, format=\"wav\")\r\n\u001b[?2004l\r"]
[1211.018698, "o", "\u001b[?2004h> "]
[1211.018851, "o", "        \r\n\u001b[?2004l\r"]
[1211.018934, "o", "\u001b[?2004h> "]
[1211.019001, "o", "        try:\r\n\u001b[?2004l\r"]
[1211.01907, "o", "\u001b[?2004h> "]
[1211.02265, "o", "            with sr.AudioFile(chunk_path) as source:\r\n\u001b[?2004l\r"]
[1211.022741, "o", "\u001b[?2004h> "]
[1211.022956, "o", "                audio_data = recognizer.record(source)\r\n\u001b[?2004l\r"]
[1211.023038, "o", "\u001b[?2004h> "]
[1211.023295, "o", "                text = recognizer.recognize_google(audio_data)\r\n\u001b[?2004l\r"]
[1211.023379, "o", "\u001b[?2004h> "]
[1211.02345, "o", "                \r\n\u001b[?2004l\r',\u001b[?2004h> "]
[1211.023623, "o", "                start_time = start / 1000.0\r\n\u001b[?2004l\r"]
[1211.02369, "o", "\u001b[?2004h> "]
[1211.023823, "o", "                end_time = end / 1000.0\r\n\u001b[?2004l\r"]
[1211.023907, "o", "\u001b[?2004h> "]
[1211.023989, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.024107, "o", "                segments.append({\r\n\u001b[?2004l\r"]
[1211.024183, "o", "\u001b[?2004h> "]
[1211.024291, "o", "                    'text': text,\r\n\u001b[?2004l\r"]
[1211.024372, "o", "\u001b[?2004h> "]
[1211.024507, "o", "                    'start': start_time,\r\n\u001b[?2004l\r"]
[1211.024582, "o", "\u001b[?2004h> "]
[1211.02471, "o", "                    'end': end_time\r\n\u001b[?2004l\r"]
[1211.024794, "o", "\u001b[?2004h> "]
[1211.024872, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.02495, "o", "                \r\n\u001b[?2004l\r"]
[1211.025017, "o", "\u001b[?2004h> "]
[1211.025174, "o", "                full_text += \" \" + text\r\n\u001b[?2004l\r"]
[1211.025255, "o", "\u001b[?2004h> "]
[1211.025444, "o", "                print(f\"Chunk {i+1}/{num_chunks}: {text[:50]}...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.025525, "o", "> "]
[1211.025635, "o", "        except sr.UnknownValueError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.025715, "o", "> "]
[1211.025986, "o", "            print(f\"Chunk {i+1}/{num_chunks}: [Could not understand audio]\")\r\n\u001b[?2004l\r"]
[1211.026072, "o", "\u001b[?2004h> "]
[1211.026169, "o", "        except sr.RequestError as e:\r\n\u001b[?2004l\r"]
[1211.026236, "o", "\u001b[?2004h> "]
[1211.026471, "o", "            print(f\"Chunk {i+1}/{num_chunks}: Error - {e}\")\r\n\u001b[?2004l\r"]
[1211.026538, "o", "\u001b[?2004h> "]
[1211.02662, "o", "        finally:\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1211.026744, "o", "            os.remove(chunk_path)\r\n\u001b[?2004l\r"]
[1211.026813, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.026855, "o", "> "]
[1211.02709, "o", "    return {'segments': segments, 'text': full_text}\r\n\u001b[?2004l\r"]
[1211.027156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[1211.027284, "o", "def detect_filler_words(result):\r\n\u001b[?2004l\r"]
[1211.027351, "o", "\u001b[?2004h> "]
[1211.027532, "o", "    \"\"\"Detect filler words from transcription result\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.027599, "o", "> "]
[1211.02764, "o", "    annotations = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.027745, "o", "> "]
[1211.027821, "o", "    seen = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1211.027895, "o", "\u001b[?2004h> "]
[1211.028016, "o", "    # Process segments to find filler words\r\n\u001b[?2004l\r"]
[1211.028097, "o", "\u001b[?2004h> "]
[1211.028216, "o", "    for segment in result['segments']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.02829, "o", "> "]
[1211.028444, "o", "        text = segment['text'].lower().strip()\r\n\u001b[?2004l\r"]
[1211.028525, "o", "\u001b[?2004h> "]
[1211.028652, "o", "        start_time = segment['start']\r\n\u001b[?2004l\r"]
[1211.028734, "o", "\u001b[?2004h> "]
[1211.028845, "o", "        end_time = segment['end']\r\n\u001b[?2004l\r"]
[1211.028936, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[1211.029005, "o", "\u001b[?2004h> "]
[1211.029142, "o", "        # Check each filler word\r\n\u001b[?2004l\r"]
[1211.029225, "o", "\u001b[?2004h> "]
[1211.029343, "o", "        for filler in FILLER_WORDS:\r\n\u001b[?2004l\r"]
[1211.029425, "o", "\u001b[?2004h> "]
[1211.029599, "o", "            # Use word boundaries for better matching\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.029685, "o", "> "]
[1211.029843, "o", "            pattern = r'\\b' + re.escape(filler) + r'\\b'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.029926, "o", "> "]
[1211.030069, "o", "            matches = re.finditer(pattern, text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.030151, "o", "> "]
[1211.030219, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.030346, "o", "            for match in matches:\r\n\u001b[?2004l\r"]
[1211.030427, "o", "\u001b[?2004h> "]
[1211.030722, "o", "                # Estimate timestamp based on character position\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.030805, "o", "> "]
[1211.030875, "o", "                char_pos = match.start()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.030959, "o", "> "]
[1211.031031, "o", "                text_length = len(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.031104, "o", "                if text_length > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.031243, "o", "                    relative_pos = char_pos / text_length\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.031325, "o", "> "]
[1211.031449, "o", "                    timestamp = start_time + (relative_pos * (end_time - start_time))\r\n\u001b[?2004l\r"]
[1211.031531, "o", "\u001b[?2004h>                 else:\r\n\u001b[?2004l\r"]
[1211.03161, "o", "\u001b[?2004h> "]
[1211.031685, "o", "                    timestamp = start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.03177, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.031849, "o", "                # Avoid duplicates\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.031959, "o", "                key = (filler, round(timestamp, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.032026, "o", "> "]
[1211.03211, "o", "                if key not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.032183, "o", "                    annotations.append({\r\n\u001b[?2004l\r"]
[1211.032264, "o", "\u001b[?2004h> "]
[1211.032342, "o", "                        \"word\": filler,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.032441, "o", "                        \"timestamp\": round(timestamp, 1)\r\n\u001b[?2004l\r"]
[1211.032522, "o", "\u001b[?2004h>                     })\r\n\u001b[?2004l\r"]
[1211.032602, "o", "\u001b[?2004h> "]
[1211.03268, "o", "                    seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1211.032761, "o", "\u001b[?2004h>     return annotations\r\n\u001b[?2004l\r"]
[1211.032834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.032972, "o", "def extract_and_stitch_clips(video_path, annotations, output_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.033054, "o", "> "]
[1211.033133, "o", "    \"\"\"Extract clips at filler word timestamps and stitch them\"\"\"\r\n\u001b[?2004l\r"]
[1211.033215, "o", "\u001b[?2004h> "]
[1211.033301, "o", "    if not annotations:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.03338, "o", "        print(\"No filler words found!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.033445, "o", "        # Create empty video\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.03361, "o", "        cmd = ['ffmpeg', '-f', 'lavfi', '-i', 'color=c=black:s=1280x720:d=1', \r\n\u001b[?2004l\r"]
[1211.033692, "o", "\u001b[?2004h> "]
[1211.033783, "o", "               '-f', 'lavfi', '-i', 'anullsrc=r=44100:cl=mono:d=1',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.033866, "o", "> "]
[1211.034017, "o", "               '-c:v', 'libx264', '-preset', 'ultrafast', '-c:a', 'aac', '-y', output_path]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.034137, "o", "        subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.034216, "o", ">         return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.034297, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.034388, "o", "    print(f\"Extracting {len(annotations)} clips...\")\r\n\u001b[?2004l\r"]
[1211.034468, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.034547, "o", "    # Create a temporary directory for clips\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.034628, "o", "> "]
[1211.034709, "o", "    clips_dir = \"/tmp/filler_clips\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.034797, "o", "    os.makedirs(clips_dir, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.034861, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     clip_files = []\r\n\u001b[?2004l\r"]
[1211.034942, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035071, "o", "    # Extract each clip (0.5 seconds around each filler word)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035195, "o", "    for i, annotation in enumerate(annotations):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.035278, "o", "> "]
[1211.035359, "o", "        timestamp = annotation['timestamp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035423, "o", "        start = max(0, timestamp - 0.25)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.035505, "o", ">         duration = 0.5\r\n\u001b[?2004l\r"]
[1211.035585, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035695, "o", "        clip_path = f\"{clips_dir}/clip_{i:04d}.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.03577, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035853, "o", "        cmd = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.035923, "o", "            'ffmpeg',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.03599, "o", "            '-i', video_path,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.036073, "o", "> "]
[1211.036137, "o", "            '-ss', str(start),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.036176, "o", "            '-t', str(duration),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.036338, "o", "            '-c:v', 'libx264',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.036412, "o", "            '-preset', 'ultrafast',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.036488, "o", "            '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.036563, "o", ">             '-y',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.036637, "o", ">             clip_path\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.036713, "o", ">         ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.036794, "o", "        \r\n\u001b[?2004l\r"]
[1211.03688, "o", "\u001b[?2004h> "]
[1211.03697, "o", "        result = subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.037039, "o", "> "]
[1211.037103, "o", "        if result.returncode == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.037187, "o", "            clip_files.append(clip_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.037287, "o", ">         else:\r\n\u001b[?2004l\r"]
[1211.03737, "o", "\u001b[?2004h> "]
[1211.037446, "o", "            print(f\"Warning: Failed to extract clip {i}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.037512, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.037583, "o", "    if not clip_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.037669, "o", "        print(\"No clips extracted!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.037753, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.037822, "o", "    # Create concat file for ffmpeg\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.037905, "o", "> "]
[1211.037987, "o", "    concat_file = \"/tmp/concat.txt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.038068, "o", "    with open(concat_file, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.038129, "o", "        for clip_file in clip_files:\r\n\u001b[?2004l\r"]
[1211.038211, "o", "\u001b[?2004h> "]
[1211.038294, "o", "            f.write(f\"file '{clip_file}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.038375, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.038448, "o", "    print(f\"Stitching {len(clip_files)} clips...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.038525, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.038602, "o", "    # Concat clips\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.038683, "o", "    cmd = [\r\n\u001b[?2004l\r\u001b[?2004h>         'ffmpeg',\r\n\u001b[?2004l\r"]
[1211.038767, "o", "\u001b[?2004h>         '-f', 'concat',\r\n\u001b[?2004l\r"]
[1211.038844, "o", "\u001b[?2004h>         '-safe', '0',\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.038929, "o", ">         '-i', concat_file,\r\n\u001b[?2004l\r"]
[1211.039007, "o", "\u001b[?2004h>         '-c:v', 'libx264',\r\n\u001b[?2004l\r"]
[1211.039071, "o", "\u001b[?2004h> "]
[1211.039142, "o", "        '-preset', 'ultrafast',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039209, "o", "        '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039286, "o", "        '-y',\r\n\u001b[?2004l\r\u001b[?2004h>         output_path\r\n\u001b[?2004l\r"]
[1211.039364, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039433, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039517, "o", "    result = subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.039546, "o", "> "]
[1211.039668, "o", "    if result.returncode != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.03977, "o", "        print(f\"Error stitching clips: {result.stderr.decode()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.03983, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039897, "o", "    # Clean up\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.039964, "o", "    for clip_file in clip_files:\r\n\u001b[?2004l\r"]
[1211.040017, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[1211.040071, "o", "\u001b[?2004h> "]
[1211.040127, "o", "            os.remove(clip_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.040187, "o", ">         except:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.040239, "o", ">             pass\r\n\u001b[?2004l\r"]
[1211.040299, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.040384, "o", "        os.remove(concat_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.040438, "o", "> "]
[1211.040492, "o", "        os.rmdir(clips_dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.040544, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.040598, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1211.040659, "o", "\u001b[?2004h> "]
[1211.04074, "o", "    print(f\"Output video saved to {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.04079, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.04085, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.040909, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r"]
[1211.040982, "o", "\u001b[?2004h> "]
[1211.041035, "o", "    audio_file = \"/tmp/audio.mp3\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041126, "o", "    output_json = \"/root/annotations.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.041185, "o", "> "]
[1211.041291, "o", "    output_video = \"/root/output.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041366, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041435, "o", "    # Extract audio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041498, "o", "    extract_audio(input_video, audio_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.041551, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     # Transcribe\r\n\u001b[?2004l\r"]
[1211.041613, "o", "\u001b[?2004h> "]
[1211.041701, "o", "    result = transcribe_audio_chunks(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041756, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.041804, "o", "    # Detect filler words\r\n\u001b[?2004l\r"]
[1211.041863, "o", "\u001b[?2004h> "]
[1211.041937, "o", "    annotations = detect_filler_words(result)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.041991, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.042044, "o", "    # Save annotations\r\n\u001b[?2004l\r"]
[1211.042097, "o", "\u001b[?2004h> "]
[1211.04215, "o", "    with open(output_json, 'w') as f:\r\n\u001b[?2004l\r"]
[1211.042204, "o", "\u001b[?2004h> "]
[1211.042271, "o", "        json.dump(annotations, f, indent=2)\r\n\u001b[?2004l\r"]
[1211.042324, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.042499, "o", "    print(f\"Saved {len(annotations)} annotations to {output_json}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.042595, "o", "    print(f\"Annotations: {annotations}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.042653, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.042727, "o", "    # Extract and stitch clips\r\n\u001b[?2004l\r"]
[1211.042782, "o", "\u001b[?2004h> "]
[1211.0429, "o", "    extract_and_stitch_clips(input_video, annotations, output_video)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.042959, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.04301, "o", "    # Clean up audio\r\n\u001b[?2004l\r"]
[1211.043063, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.043112, "o", "> "]
[1211.043169, "o", "        os.remove(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.043223, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.043277, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.043328, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.043382, "o", "    print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1211.043445, "o", "\u001b[?2004h> "]
[1211.043496, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.043549, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
