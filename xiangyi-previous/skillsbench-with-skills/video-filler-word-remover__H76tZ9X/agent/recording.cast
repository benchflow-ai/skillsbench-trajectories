[708.865141, "o", "    'yeah',\r\n\u001b[?2004l\r\u001b[?2004h>     'so',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.86525, "o", "    'kind of',\r\n\u001b[?2004l\r\u001b[?2004h"]
