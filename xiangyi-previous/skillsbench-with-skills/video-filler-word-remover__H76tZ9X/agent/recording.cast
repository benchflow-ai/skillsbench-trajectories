[307.03386, "o", "            '-c:v', 'libx264',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.033942, "o", "            '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.034019, "o", "            '-y',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.034101, "o", "            clip_path\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[307.034179, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.034287, "o", "        subprocess.run(cmd, capture_output=True, check=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[307.034368, "o", "> "]
[307.034447, "o", "        clip_files.append(clip_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.034696, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.034851, "o", "    # Create concat file for ffmpeg\r\n\u001b[?2004l\r\u001b[?2004h>     concat_file = \"/tmp/concat.txt\"\r\n\u001b[?2004l\r\u001b[?2004h>     with open(concat_file, 'w') as f:\r\n\u001b[?2004l\r"]
[307.034953, "o", "\u001b[?2004h>         for clip_file in clip_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035039, "o", "            f.write(f\"file '{clip_file}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[307.035116, "o", "\u001b[?2004h> "]
[307.035196, "o", "    print(f\"Stitching {len(clip_files)} clips...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035275, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[307.035348, "o", ">     # Concat clips\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035417, "o", "    cmd = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035488, "o", "        'ffmpeg',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035558, "o", "        '-f', 'concat',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035638, "o", "        '-safe', '0',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.03571, "o", "        '-i', concat_file,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035787, "o", "        '-c', 'copy',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035859, "o", "        '-y',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.035933, "o", "        output_path\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[307.036005, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.041156, "o", "    subprocess.run(cmd, capture_output=True, check=True)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Clean up\r\n\u001b[?2004l\r\u001b[?2004h>     for clip_file in clip_files:\r\n\u001b[?2004l\r\u001b[?2004h>         os.remove(clip_file)\r\n\u001b[?2004l\r\u001b[?2004h>     os.remove(concat_file)\r\n\u001b[?2004l\r\u001b[?2004h>     os.rmdir(clips_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Output video saved to {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h>     output_json = \"/root/annotations.json\"\r\n\u001b[?2004l\r\u001b[?2004h>     output_video = \"/root/output.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Transcribe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.045549, "o", "    result = transcribe_video(input_video)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.045796, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Detect filler words\r\n\u001b[?2004l\r"]
[307.045907, "o", "\u001b[?2004h>     annotations = detect_filler_words(result)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.045999, "o", "    # Save annotations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.046082, "o", "    with open(output_json, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.046167, "o", "        json.dump(annotations, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[307.046248, "o", "> "]
[307.04633, "o", "    print(f\"Saved {len(annotations)} annotations to {output_json}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.046414, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.046496, "o", "    # Extract and stitch clips\r\n\u001b[?2004l\r\u001b[?2004h> "]
[307.046582, "o", "    extract_and_stitch_clips(input_video, annotations, output_video)\r\n\u001b[?2004l\r\u001b[?2004h"]
