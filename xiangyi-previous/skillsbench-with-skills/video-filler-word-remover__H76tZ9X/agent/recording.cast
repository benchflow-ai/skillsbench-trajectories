[708.865616, "o", "    'i guess',\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.865703, "o", "> "]
[708.86579, "o", "    'well',\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.865894, "o", "> "]
[708.865985, "o", "    'okay'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.866082, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[708.866179, "o", "\u001b[?2004h> "]
[708.866354, "o", "def extract_audio(video_path, audio_path):"]
[708.866413, "o", "\r\n"]
[708.86649, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.866587, "o", "> "]
[708.866734, "o", "    \"\"\"Extract audio from video\"\"\""]
[708.866819, "o", "\r\n\u001b[?2004l\r"]
[708.8669, "o", "\u001b[?2004h> "]
[708.867082, "o", "    print(\"Extracting audio from video...\")"]
[708.867131, "o", "\r\n\u001b[?2004l\r"]
[708.867182, "o", "\u001b[?2004h"]
[708.867239, "o", "> "]
[708.867322, "o", "    cmd = ["]
[708.867404, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.867495, "o", "> "]
[708.867582, "o", "        'ffmpeg',\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.867669, "o", "> "]
[708.867761, "o", "        '-i', video_path,"]
[708.867843, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.867929, "o", "> "]
[708.868011, "o", "        '-q:a', '9',"]
[708.868103, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.868183, "o", "        '-n',\r\n"]
[708.868269, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[708.868356, "o", "        audio_path"]
[708.868449, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.868524, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.86876, "o", "    subprocess.run(cmd, capture_output=True, check=True)"]
[708.868814, "o", "\r\n\u001b[?2004l\r"]
[708.868865, "o", "\u001b[?2004h"]
[708.86891, "o", "> "]
[708.869125, "o", "    print(f\"Audio extracted to {audio_path}\")"]
[708.869174, "o", "\r\n\u001b[?2004l\r"]
[708.869224, "o", "\u001b[?2004h"]
[708.869303, "o", "> "]
[708.86938, "o", "\r\n"]
[708.869473, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[708.869612, "o", "def transcribe_audio(audio_path):"]
[708.869686, "o", "\r\n\u001b[?2004l\r"]
[708.86978, "o", "\u001b[?2004h> "]
[708.869986, "o", "    \"\"\"Transcribe audio using Whisper tiny model\"\"\""]
[708.870053, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.870174, "o", "> "]
[708.870409, "o", "    print(\"Loading Whisper tiny model...\")"]
[708.870471, "o", "\r\n"]
[708.870526, "o", "\u001b[?2004l\r"]
[708.870598, "o", "\u001b[?2004h"]
[708.870659, "o", "> "]
[708.870876, "o", "    model = whisper.load_model(\"tiny\")"]
[708.870936, "o", "\r\n"]
[708.870991, "o", "\u001b[?2004l\r"]
[708.871058, "o", "\u001b[?2004h"]
[708.871118, "o", "> "]
[708.871192, "o", "    "]
[708.871253, "o", "\r\n"]
[708.871328, "o", "\u001b[?2004l\r"]
[708.871415, "o", "\u001b[?2004h> "]
[708.871572, "o", "    print(\"Transcribing audio...\")"]
[708.871631, "o", "\r\n"]
[708.871705, "o", "\u001b[?2004l\r"]
[708.871788, "o", "\u001b[?2004h"]
[708.871878, "o", "> "]
[708.872181, "o", "    result = model.transcribe(audio_path, language=\"en\", verbose=True)"]
[708.872245, "o", "\r\n"]
[708.872303, "o", "\u001b[?2004l\r"]
[708.872373, "o", "\u001b[?2004h"]
[708.87244, "o", "> "]
[708.87257, "o", "    return result"]
[708.87263, "o", "\r\n"]
[708.87269, "o", "\u001b[?2004l\r"]
[708.872762, "o", "\u001b[?2004h"]
[708.872851, "o", "> "]
[708.872942, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.873033, "o", "> "]
[708.873158, "o", "def detect_filler_words(result):"]
[708.873215, "o", "\r\n"]
[708.87335, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[708.873601, "o", "    \"\"\"Detect filler words from transcription result\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.873751, "o", "> "]
[708.873922, "o", "    annotations = []\r\n\u001b[?2004l\r"]
[708.873957, "o", "\u001b[?2004h>     seen = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[708.873989, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.874026, "o", "> "]
[708.874254, "o", "    # Process segments to find filler words\r\n\u001b[?2004l\r"]
[708.874289, "o", "\u001b[?2004h> "]
[708.874489, "o", "    for segment in result['segments']:\r\n\u001b[?2004l\r"]
[708.874518, "o", "\u001b[?2004h> "]
[708.874773, "o", "        text = segment['text'].lower().strip()\r\n\u001b[?2004l\r"]
[708.87495, "o", "\u001b[?2004h> "]
[708.875009, "o", "        start_time = segment['start']\r\n\u001b[?2004l\r"]
[708.875044, "o", "\u001b[?2004h> "]
[708.875221, "o", "        end_time = segment['end']\r\n\u001b[?2004l\r"]
[708.875253, "o", "\u001b[?2004h> "]
[708.875332, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[708.875368, "o", "> "]
[708.87553, "o", "        # Check each filler word\r\n\u001b[?2004l\r"]
[708.875562, "o", "\u001b[?2004h> "]
[708.875759, "o", "        for filler in FILLER_WORDS:\r\n\u001b[?2004l\r"]
[708.875787, "o", "\u001b[?2004h> "]
[708.875989, "o", "            if filler in text:\r\n\u001b[?2004l\r"]
[708.87602, "o", "\u001b[?2004h> "]
[708.876211, "o", "                # Find all occurrences\r\n\u001b[?2004l\r"]
[708.876245, "o", "\u001b[?2004h> "]
[708.876447, "o", "                words = text.split()\r\n\u001b[?2004l\r"]
[708.876512, "o", "\u001b[?2004h> "]
[708.876745, "o", "                filler_words = filler.split()\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.876779, "o", "> "]
[708.876974, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.877091, "o", "                # Find positions\r\n\u001b[?2004l\r"]
[708.877282, "o", "\u001b[?2004h> "]
[708.87751, "o", "                for i in range(len(words) - len(filler_words) + 1):\r\n\u001b[?2004l\r"]
[708.877552, "o", "\u001b[?2004h> "]
[708.877744, "o", "                    if ' '.join(words[i:i+len(filler_words)]) == filler:\r\n\u001b[?2004l\r"]
[708.87778, "o", "\u001b[?2004h> "]
[708.877946, "o", "                        # Estimate timestamp based on word position\r\n\u001b[?2004l\r"]
[708.87798, "o", "\u001b[?2004h> "]
[708.878186, "o", "                        word_duration = (end_time - start_time) / max(len(words), 1)\r\n\u001b[?2004l\r"]
[708.878218, "o", "\u001b[?2004h> "]
[708.878392, "o", "                        timestamp = start_time + (i * word_duration)\r\n\u001b[?2004l\r"]
[708.878426, "o", "\u001b[?2004h> "]
[708.878513, "o", "                        "]
[708.878607, "o", "\r\n"]
[708.878773, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.878854, "o", ">                         # Avoid duplicates"]
[708.878919, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.879097, "o", "                        key = (filler, round(timestamp, 1))"]
[708.879183, "o", "\r\n"]
[708.879223, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.879392, "o", ">                         if key not in seen:"]
[708.879487, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.879656, "o", "> "]
[708.879744, "o", "                            annotations.append({"]
[708.879916, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.880014, "o", ">                                 \"word\": filler,"]
[708.880206, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.880291, "o", ">                                 \"timestamp\": round(timestamp, 1)"]
[708.880431, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.880515, "o", ">                             })\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.880578, "o", "> "]
[708.88072, "o", "                            seen.add(key)"]
[708.880807, "o", "\r\n"]
[708.880879, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.880964, "o", ">     "]
[708.881086, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.881164, "o", ">     return annotations"]
[708.881247, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.881342, "o", "> \r\n\u001b[?2004l\r"]
[708.881528, "o", "\u001b[?2004h> "]
[708.881605, "o", "def extract_and_stitch_clips(video_path, annotations, output_path):"]
[708.881798, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.881883, "o", ">     \"\"\"Extract clips at filler word timestamps and stitch them\"\"\""]
[708.88201, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.882096, "o", ">     if not annotations:\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.88225, "o", "> "]
[708.882331, "o", "        print(\"No filler words found!\")"]
[708.882457, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.882557, "o", ">         # Create empty video\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.882627, "o", "> "]
[708.882836, "o", "        cmd = ['ffmpeg', '-f', 'lavfi', '-i', 'color=c=black:s=1280x720:d=1', "]
[708.882922, "o", "\r\n"]
[708.882988, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.883173, "o", "> "]
[708.883258, "o", "               '-f', 'lavfi', '-i', 'anullsrc=r=44100:cl=mono:d=1',"]
[708.883456, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.883545, "o", ">                '-c:v', 'libx264', '-c:a', 'aac', '-y', output_path]"]
[708.883719, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.883803, "o", ">         subprocess.run(cmd, capture_output=True)"]
[708.883903, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.883993, "o", ">         return\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.884074, "o", ">     "]
[708.884157, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.88422, "o", "> "]
[708.884382, "o", "    print(f\"Extracting {len(annotations)} clips...\")"]
[708.884467, "o", "\r\n"]
[708.884541, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.884623, "o", ">     "]
[708.884787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.884875, "o", ">     # Create a temporary directory for clips"]
[708.885031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.885117, "o", ">     clips_dir = \"/tmp/filler_clips\""]
[708.885293, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     os.makedirs(clips_dir, exist_ok=True)"]
[708.885381, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.885468, "o", "> "]
[708.885548, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[708.885669, "o", "> "]
[708.885751, "o", "    clip_files = []"]
[708.885829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.885907, "o", "> "]
[708.885987, "o", "    \r\n"]
[708.886174, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.886258, "o", ">     # Extract each clip (0.5 seconds around each filler word)"]
[708.886424, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.886509, "o", ">     for i, annotation in enumerate(annotations):"]
[708.886679, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.886766, "o", ">         timestamp = annotation['timestamp']"]
[708.886921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.887012, "o", ">         start = max(0, timestamp - 0.25)"]
[708.887125, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.88721, "o", ">         duration = 0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.887278, "o", "> "]
[708.887353, "o", "        "]
[708.887436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.887605, "o", "> "]
[708.887685, "o", "        clip_path = f\"{clips_dir}/clip_{i:04d}.mp4\""]
[708.887767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.887847, "o", ">         "]
[708.887953, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.888039, "o", ">         cmd = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.888156, "o", ">             'ffmpeg',"]
[708.88825, "o", "\r\n"]
[708.888389, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.888471, "o", ">             '-i', video_path,\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.888542, "o", "> "]
[708.888666, "o", "            '-ss', str(start),"]
[708.888754, "o", "\r\n"]
[708.888885, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.888973, "o", ">             '-t', str(duration),\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.88911, "o", ">             '-c:v', 'libx264',"]
[708.889194, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.889267, "o", "> "]
[708.889398, "o", "            '-preset', 'ultrafast',"]
[708.889482, "o", "\r\n"]
[708.889604, "o", "\u001b[?2004l\r\u001b[?2004h"]
[708.889686, "o", ">             '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.889797, "o", ">             '-y',"]
[708.889878, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.889958, "o", "> "]
[708.890062, "o", "            clip_path"]
[708.890145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.89024, "o", "> "]
[708.89032, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.890381, "o", "> "]
[708.89045, "o", "        "]
[708.890533, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.890714, "o", "> "]
[708.890799, "o", "        result = subprocess.run(cmd, capture_output=True)"]
[708.890947, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.891026, "o", ">         if result.returncode == 0:"]
[708.891187, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.891272, "o", ">             clip_files.append(clip_path)"]
[708.891378, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.891444, "o", ">         else:\r\n\u001b[?2004l\r"]
[708.89152, "o", "\u001b[?2004h"]
[708.89171, "o", "> "]
[708.891792, "o", "            print(f\"Warning: Failed to extract clip {i}\")"]
[708.891901, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.892043, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     if not clip_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.892136, "o", "        print(\"No clips extracted!\")\r\n\u001b[?2004l\r"]
[708.892177, "o", "\u001b[?2004h> "]
[708.892214, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.892352, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     # Create concat file for ffmpeg\r\n\u001b[?2004l\r"]
[708.892473, "o", "\u001b[?2004h> "]
[708.892555, "o", "    concat_file = \"/tmp/concat.txt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.892659, "o", "    with open(concat_file, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         for clip_file in clip_files:\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.892723, "o", "> "]
[708.89278, "o", "            f.write(f\"file '{clip_file}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[708.89284, "o", "\u001b[?2004h> "]
[708.892884, "o", "    print(f\"Stitching {len(clip_files)} clips...\")\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[708.892937, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.892986, "o", "    # Concat clips\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = ["]
[708.893035, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893082, "o", "        'ffmpeg',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893132, "o", "        '-f', 'concat',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893178, "o", "        '-safe', '0',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893259, "o", "        '-i', concat_file,\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.893313, "o", "> "]
[708.893366, "o", "        '-c:v', 'libx264',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893423, "o", "        '-preset', 'ultrafast',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893478, "o", "        '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893529, "o", "        '-y',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893572, "o", "        output_path\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[708.893623, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893719, "o", "    result = subprocess.run(cmd, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.893769, "o", "> "]
[708.893818, "o", "    if result.returncode != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.893912, "o", "        print(f\"Error stitching clips: {result.stderr.decode()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.893961, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894007, "o", "    # Clean up\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894062, "o", "    for clip_file in clip_files:\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.894107, "o", ">         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894173, "o", "            os.remove(clip_file)\r\n\u001b[?2004l\r"]
[708.894219, "o", "\u001b[?2004h>         except:\r\n\u001b[?2004l\r"]
[708.894274, "o", "\u001b[?2004h>             pass\r\n"]
[708.894324, "o", "\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.89438, "o", "        os.remove(concat_file)\r\n\u001b[?2004l\r"]
[708.894427, "o", "\u001b[?2004h> "]
[708.894477, "o", "        os.rmdir(clips_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     except:"]
[708.894526, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r"]
[708.894579, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894654, "o", "    print(f\"Output video saved to {output_path}\")\r\n\u001b[?2004l\r"]
[708.89471, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[708.894761, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894814, "o", "    input_video = \"/root/input.mp4\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.894865, "o", "    audio_file = \"/tmp/audio.mp3\"\r\n\u001b[?2004l\r"]
[708.894915, "o", "\u001b[?2004h> "]
[708.894955, "o", "    output_json = \"/root/annotations.json\"\r\n\u001b[?2004l\r"]
[708.895003, "o", "\u001b[?2004h> "]
[708.895044, "o", "    output_video = \"/root/output.mp4\"\r\n\u001b[?2004l\r"]
[708.895092, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.895138, "o", "    # Extract audio\r\n\u001b[?2004l\r"]
[708.895187, "o", "\u001b[?2004h> "]
[708.89525, "o", "    extract_audio(input_video, audio_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.895301, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[708.895347, "o", ">     # Transcribe\r\n\u001b[?2004l\r"]
[708.895402, "o", "\u001b[?2004h> "]
[708.895466, "o", "    result = transcribe_audio(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.895515, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.895597, "o", "    # Detect filler words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.895719, "o", "    annotations = detect_filler_words(result)\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.895774, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.89582, "o", "    # Save annotations\r\n\u001b[?2004l\r"]
[708.895873, "o", "\u001b[?2004h> "]
[708.895925, "o", "    with open(output_json, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.895987, "o", "        json.dump(annotations, f, indent=2)\r\n\u001b[?2004l\r"]
[708.896042, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.89614, "o", "    print(f\"Saved {len(annotations)} annotations to {output_json}\")\r\n\u001b[?2004l\r"]
[708.896194, "o", "\u001b[?2004h> "]
[708.896244, "o", "    print(f\"Annotations: {annotations}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896297, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896346, "o", "    # Extract and stitch clips\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896448, "o", "    extract_and_stitch_clips(input_video, annotations, output_video)\r\n\u001b[?2004l\r"]
[708.896495, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896553, "o", "    # Clean up audio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896612, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896662, "o", "        os.remove(audio_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.89671, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r"]
[708.896759, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896801, "o", "    print(\"Done!\")\r\n\u001b[?2004l\r"]
[708.89685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[708.896892, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[708.896942, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[708.896989, "o", "> EOF\r\n\u001b[?2004l\r"]
