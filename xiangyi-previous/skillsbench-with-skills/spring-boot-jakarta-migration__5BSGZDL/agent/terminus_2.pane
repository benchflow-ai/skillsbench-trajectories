[?2004l[?2004h> 
[?2004l[?2004h> /**
[?2004l[?2004h>  * Service for making external API calls using RestClient.
[?2004l[?2004h>  * This has been migrated from RestTemplate to RestClient in Spring Boot 3.
[?2004l[?2004h>  */
[?2004l[?2004h> @Service
[?2004l[?2004h> public class ExternalApiService {
[?2004l[?2004h> 
[?2004l[?2004h>     private final RestClient restClient;
[?2004l[?2004h> 
[?2004l[?2004h>     @Value("${external.api.base-url:https://api.example.com}")
[?2004l[?2004h>     private String baseUrl;
[?2004l[?2004h> 
[?2004l[?2004h>     public ExternalApiService(RestClient.Builder restClientBuilder) {
[?2004l[?2004h>         this.restClient = restClientBuilder.build();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Verify user email through external service
[?2004l[?2004h>      */
[?2004l[?2004h>     public boolean verifyEmail(String email) {
[?2004l[?2004h>         try {
[?2004l[?2004h>             String url = baseUrl + "/verify/email?email=" + email;
[?2004l[?2004h>             Map response = restClient.get()
[?2004l[?2004h>                     .uri(url)
[?2004l[?2004h>                     .retrieve()
[?2004l[?2004h>                     .body(Map.class);
[?2004l[?2004h>             if (response != null) {
[?2004l[?2004h>                 Object valid = response.get("valid");
[?2004l[?2004h>                 return Boolean.TRUE.equals(valid);
[?2004l[?2004h>             }
[?2004l[?2004h>             return false;
[?2004l[?2004h>         } catch (Exception e) {
[?2004l[?2004h>             // Log and return false on failure
[?2004l[?2004h>             return false;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Send notification to external notification service
[?2004l[?2004h>      */
[?2004l[?2004h>     public void sendNotification(String userId, String message) {
[?2004l[?2004h>         try {
[?2004l[?2004h>             String url = baseUrl + "/notifications";
[?2004l[?2004h> 
[?2004l[?2004h>             Map<String, String> payload = Map.of(
[?2004l[?2004h>                 "userId", userId,
[?2004l[?2004h>                 "message", message,
[?2004l[?2004h>                 "type", "USER_UPDATE"
[?2004l[?2004h>             );
[?2004l[?2004h> 
[?2004l[?2004h>             restClient.post()
[?2004l[?2004h>                     .uri(url)
[?2004l[?2004h>                     .contentType(MediaType.APPLICATION_JSON)
[?2004l[?2004h>                     .body(payload)
[?2004l[?2004h>                     .retrieve()
[?2004l[?2004h>                     .toBodilessEntity();
[?2004l[?2004h>         } catch (Exception e) {
[?2004l[?2004h>             // Log notification failure but don't throw
[?2004l[?2004h>             System.err.println("Failed to send notification: " + e.getMessage());
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Fetch user profile enrichment data from external service
