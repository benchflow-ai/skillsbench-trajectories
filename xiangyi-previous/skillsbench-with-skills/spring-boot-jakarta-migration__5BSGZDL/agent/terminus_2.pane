[?2004l[?2004h> import jakarta.servlet.http.HttpServletResponse;
[?2004l[?2004h> import org.springframework.beans.factory.annotation.Autowired;
[?2004l[?2004h> import org.springframework.context.annotation.Bean;
[?2004l[?2004h> import org.springframework.context.annotation.Configuration;
[?2004l[?2004h> import org.springframework.http.HttpMethod;
[?2004l[?2004h> import org.springframework.security.authentication.AuthenticationManager;
[?2004l[?2004h> import org.springframework.security.authentication.ProviderManager;
[?2004l[?2004h> import org.springframework.security.authentication.dao.DaoAuthenticationProvider;
[?2004l[?2004h> import org.springframework.security.config.annotation.method.configuration.EnableMethodSecurity;
[?2004l[?2004h> import org.springframework.security.config.annotation.web.builders.HttpSecurity;
