[?2004l[?2004h> import org.springframework.security.web.SecurityFilterChain;
[?2004l[?2004h> 
[?2004l[?2004h> /**
[?2004l[?2004h>  * Security configuration using Spring Security 6 component-based approach.
[?2004l[?2004h>  * This replaces the deprecated WebSecurityConfigurerAdapter pattern.
[?2004l[?2004h>  */
[?2004l[?2004h> @Configuration
[?2004l[?2004h> @EnableWebSecurity
[?2004l[?2004h> @EnableMethodSecurity(prePostEnabled = true)
[?2004l[?2004h> public class SecurityConfig {
[?2004l[?2004h> 
[?2004l[?2004h>     @Autowired
[?2004l[?2004h>     private UserDetailsService userDetailsService;
[?2004l[?2004h> 
[?2004l[?2004h>     @Bean
[?2004l[?2004h>     public PasswordEncoder passwordEncoder() {
