[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Bean
[?2004l[?2004h>     public AuthenticationManager authenticationManager() {
[?2004l[?2004h>         DaoAuthenticationProvider authenticationProvider = new DaoAuthenticationProvider();
[?2004l[?2004h>         authenticationProvider.setUserDetailsService(userDetailsService);
[?2004l[?2004h>         authenticationProvider.setPasswordEncoder(passwordEncoder());
[?2004l[?2004h>         return new ProviderManager(authenticationProvider);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Bean
[?2004l[?2004h>     public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
[?2004l[?2004h>         http
[?2004l[?2004h>             .csrf(csrf -> csrf.disable())
[?2004l[?2004h>             .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
[?2004l[?2004h>             .exceptionHandling(exceptionHandling -> exceptionHandling
[?2004l[?2004h>                 .authenticationEntryPoint((request, response, ex) -> {
[?2004l[?2004h>                     response.sendError(HttpServletResponse.SC_UNAUTHORIZED, ex.getMessage());
[?2004l[?2004h>                 })
[?2004l[?2004h>             )
[?2004l[?2004h>             .authorizeHttpRequests(authz -> authz
[?2004l[?2004h>                 // Public endpoints
[?2004l[?2004h>                 .requestMatchers(HttpMethod.POST, "/api/users").permitAll()
[?2004l[?2004h>                 .requestMatchers("/api/auth/**").permitAll()
[?2004l[?2004h>                 .requestMatchers("/h2-console/**").permitAll()
