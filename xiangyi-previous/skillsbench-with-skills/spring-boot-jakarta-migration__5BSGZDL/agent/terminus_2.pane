[?2004l[?2004h>                 .anyRequest().authenticated()
[?2004l[?2004h>             )
[?2004l[?2004h>             .headers(headers -> headers.frameOptions(frameOptions -> frameOptions.disable())); // For H2 console
[?2004l[?2004h> 
[?2004l[?2004h>         return http.build();
