[93.14826, "o", "                // Public endpoints\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.148273, "o", "> "]
[93.148396, "o", "                .requestMatchers(HttpMethod.POST, \"/api/users\").permitAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.148502, "o", "                .requestMatchers(\"/api/auth/**\").permitAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.148608, "o", "                .requestMatchers(\"/h2-console/**\").permitAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.148714, "o", "                .requestMatchers(\"/actuator/health\").permitAll()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.148821, "o", "                // All other endpoints require authentication\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.148902, "o", "                .anyRequest().authenticated()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.14893, "o", "            )\r\n\u001b[?2004l\r"]
[93.148957, "o", "\u001b[?2004h> "]
[93.149136, "o", "            .headers(headers -> headers.frameOptions(frameOptions -> frameOptions.disable())); // For H2 console\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.149163, "o", "\u001b[?2004h> "]
[93.149204, "o", "        return http.build();\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.149231, "o", ">     }\r\n"]
[93.149254, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[93.14928, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
