[528.811674, "o", "> "]
[528.811723, "o", "        # Load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.811792, "o", "        load = buses[i, 2]\r\n\u001b[?2004l\r"]
[528.811812, "o", "\u001b[?2004h> "]
[528.811859, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.811909, "o", "        # Net flow\r\n\u001b[?2004l\r"]
[528.811929, "o", "\u001b[?2004h> "]
[528.811997, "o", "        net_flow = 0\r\n\u001b[?2004l\r"]
[528.812019, "o", "\u001b[?2004h> "]
[528.812096, "o", "        for b in range(n_branch):\r\n\u001b[?2004l\r"]
[528.812117, "o", "\u001b[?2004h> "]
[528.812254, "o", "            if branches[b, 10] == 0:\r\n\u001b[?2004l\r"]
[528.812297, "o", "\u001b[?2004h> "]
[528.812371, "o", "                continue\r\n\u001b[?2004l\r"]
[528.812387, "o", "\u001b[?2004h"]
[528.812403, "o", "> "]
[528.812475, "o", "            \r\n\u001b[?2004l\r"]
[528.812496, "o", "\u001b[?2004h"]
[528.812546, "o", "> "]
[528.812637, "o", "            f_bus = int(branches[b, 0])\r\n\u001b[?2004l\r"]
[528.812676, "o", "\u001b[?2004h> "]
[528.8128, "o", "            t_bus = int(branches[b, 1])\r\n\u001b[?2004l\r"]
[528.812839, "o", "\u001b[?2004h> "]
[528.812931, "o", "            x = branches[b, 3]\r\n\u001b[?2004l\r"]
[528.812973, "o", "\u001b[?2004h> "]
[528.813013, "o", "            \r\n\u001b[?2004l\r"]
[528.813032, "o", "\u001b[?2004h> "]
[528.813109, "o", "            if x <= 1e-6:\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.813132, "o", "> "]
[528.813188, "o", "                continue\r\n\u001b[?2004l\r"]
[528.813208, "o", "\u001b[?2004h> "]
[528.813259, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.81328, "o", "> "]
[528.813359, "o", "            if f_bus == bus_num:\r\n\u001b[?2004l\r"]
[528.813375, "o", "\u001b[?2004h> "]
[528.813481, "o", "                f_idx = bus_idx[f_bus]\r\n\u001b[?2004l\r"]
[528.813498, "o", "\u001b[?2004h> "]
[528.813601, "o", "                t_idx = bus_idx[t_bus]\r\n\u001b[?2004l\r"]
[528.813621, "o", "\u001b[?2004h> "]
[528.813816, "o", "                net_flow += (theta[f_idx] - theta[t_idx]) / x * baseMVA\r\n\u001b[?2004l\r"]
[528.813835, "o", "\u001b[?2004h"]
[528.813852, "o", "> "]
[528.813945, "o", "            elif t_bus == bus_num:\r\n\u001b[?2004l\r"]
[528.813966, "o", "\u001b[?2004h> "]
[528.814075, "o", "                f_idx = bus_idx[f_bus]\r\n\u001b[?2004l\r"]
[528.814095, "o", "\u001b[?2004h> "]
[528.814204, "o", "                t_idx = bus_idx[t_bus]\r\n\u001b[?2004l\r"]
[528.814227, "o", "\u001b[?2004h> "]
[528.814408, "o", "                net_flow -= (theta[f_idx] - theta[t_idx]) / x * baseMVA\r\n\u001b[?2004l\r"]
[528.814428, "o", "\u001b[?2004h> "]
[528.814476, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.814498, "o", "> "]
[528.814646, "o", "        constraints.append(gen_power == load + net_flow)\r\n\u001b[?2004l\r"]
[528.814689, "o", "\u001b[?2004h> "]
[528.814707, "o", "    \r\n\u001b[?2004l\r"]
[528.814768, "o", "\u001b[?2004h"]
[528.81479, "o", "> "]
[528.814907, "o", "    # Branch flow limits\r\n"]
[528.814926, "o", "\u001b[?2004l\r\u001b[?2004h"]
[528.814972, "o", "> "]
[528.815063, "o", "    for b in range(n_branch):\r\n\u001b[?2004l\r"]
[528.815083, "o", "\u001b[?2004h"]
[528.815103, "o", "> "]
[528.81527, "o", "        if branches[b, 10] == 0:\r\n\u001b[?2004l\r"]
[528.815292, "o", "\u001b[?2004h"]
[528.81531, "o", "> "]
[528.81537, "o", "            continue\r\n\u001b[?2004l\r"]
[528.815392, "o", "\u001b[?2004h> "]
[528.815444, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.815464, "o", "> "]
[528.815544, "o", "        f_bus = int(branches[b, 0])\r\n\u001b[?2004l\r"]
[528.815565, "o", "\u001b[?2004h"]
[528.815583, "o", "> "]
[528.815674, "o", "        t_bus = int(branches[b, 1])\r\n\u001b[?2004l\r"]
[528.815695, "o", "\u001b[?2004h"]
[528.815714, "o", "> "]
[528.81579, "o", "        x = branches[b, 3]\r\n\u001b[?2004l\r"]
[528.815811, "o", "\u001b[?2004h> "]
[528.815905, "o", "        rate_a = branches[b, 5]\r\n\u001b[?2004l\r"]
[528.815926, "o", "\u001b[?2004h"]
