[319.718684, "i", "cat >> solve_dcopf.py << 'PART4'\n\ndef analyze_results(result, data):\n    buses = result['buses']\n    gens = result['gens']\n    branches = result['branches']\n    baseMVA = result['baseMVA']\n    bus_idx = result['bus_idx']\n    pg = result['pg']\n    theta = result['theta']\n    reserve = result['reserve']\n    gencost = result['gencost']\n    active_gens = result['active_gens']\n    \n    lmps = {}\n    \n    for i, bus in enumerate(buses):\n        bus_num = int(bus[0])\n        bus_gens = []\n        bus_gen_costs = []\n        \n        for g in range(len(gens)):\n            if int(gens[g, 0]) == bus_num and active_gens[g]:\n                bus_gens.append(g)\n                cost_data = gencost[g]\n                ncost = int(cost_data[3])\n                coeffs = cost_data[4:4+ncost]\n                \n                if ncost == 3:\n                    mc = 2 * coeffs[0] * pg[g] + coeffs[1]\n                elif ncost == 2:\n                    mc = coeffs[0]\n                else:\n                    mc = 50.0\n                bus_gen_costs.append(mc)\n        \n        if bus_gen_costs:\n            lmps[bus_num] = np.mean(bus_gen_costs)\n        else:\n            all_costs = []\n            for g in range(len(gens)):\n                if active_gens[g]:\n                    cost_data = gencost[g]\n                    ncost = int(cost_data[3])\n                    if ncost >= 2:\n                        coeffs = cost_data[4:4+ncost]\n                        mc = coeffs[1] if ncost == 3 else coeffs[0]\n                        all_costs.append(mc)\n            lmps[bus_num] = np.mean(all_costs) if all_costs else 50.0\n    \n    reserve_costs = []\n    for g in range(len(gens)):\n        if active_gens[g] and reserve[g] > 0.01:\n            cost_data = gencost[g]\n            ncost = int(cost_data[3])\n            if ncost >= 2:\n                coeffs = cost_data[4:4+ncost]\n                mc = coeffs[1] if ncost == 3 else coeffs[0]\n                reserve_costs.append(mc * 0.1)\n    \n    reserve_mcp = np.mean(reserve_costs) if reserve_costs else 5.0\nPART4\n"]
