[283.228016, "o", "def solve_dcopf_with_reserves(data, branch_modifications=None):\r\n\u001b[?2004l\r"]
[283.228055, "o", "\u001b[?2004h> "]
[283.228177, "o", "    baseMVA = data['baseMVA']\r\n\u001b[?2004l\r"]
[283.228312, "o", "\u001b[?2004h>     buses = np.array(data['bus'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.231514, "o", "    gens = np.array(data['gen'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.235804, "o", "    branches = np.array(data['branch']).copy()\r\n\u001b[?2004l\r\u001b[?2004h>     gencost = np.array(data['gencost'])\r\n\u001b[?2004l\r\u001b[?2004h>     reserve_capacity = np.array(data['reserve_capacity'])\r\n\u001b[?2004l\r\u001b[?2004h>     reserve_requirement = data['reserve_requirement']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if branch_modifications:\r\n\u001b[?2004l\r\u001b[?2004h>         for branch_idx, new_limit in branch_modifications.items():\r\n\u001b[?2004l\r\u001b[?2004h>             branches[branch_idx, 5] = new_limit\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     n_bus = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h>     n_gen = len(gens)\r\n\u001b[?2004l\r\u001b[?2004h>     n_branch = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     bus_nums = buses[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h>     bus_idx = {int(num): i for i, num in enumerate(bus_nums)}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     gen_status = gens[:, 7]\r\n\u001b[?2004l\r\u001b[?2004h>     active_gens = gen_status == 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     pg = cp.Variable(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h>     theta = cp.Variable(n_bus)\r\n\u001b[?2004l\r\u001b[?2004h>     reserve = cp.Variable(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     costs = []\r\n\u001b[?2004l\r\u001b[?2004h>     reserve_costs = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>         if not active_gens[i]:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         cost_data = gencost[i]\r\n\u001b[?2004l\r\u001b[?2004h>         ncost = int(cost_data[3])\r\n\u001b[?2004l\r\u001b[?2004h>         coeffs = cost_data[4:4+ncost]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if ncost == 3:\r\n\u001b[?2004l\r\u001b[?2004h>             costs.append(coeffs[0] * cp.square(pg[i]) + coeffs[1] * pg[i] + coeffs[2])\r\n\u001b[?2004l\r\u001b[?2004h>         elif ncost == 2:\r\n\u001b[?2004l\r\u001b[?2004h>             costs.append(coeffs[0] * pg[i] + coeffs[1])\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             costs.append(coeffs[-1])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         marginal_cost = coeffs[-2] if len(coeffs) >= 2 else 10.0\r\n\u001b[?2004l\r\u001b[?2004h>         reserve_costs.append(0.1 * marginal_cost * reserve[i])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     objective = cp.Minimize(cp.sum(costs) + cp.sum(reserve_costs))\r\n\u001b[?2004l\r\u001b[?2004h>     constraints = []\r\n\u001b[?2004l\r\u001b[?2004h> PART1\r\n\u001b[?2004l\r\u001b[?2004hroot@9ea04964a8fb:~# "]
[295.667028, "i", "cat >> solve_dcopf.py << 'PART2'\n    \n    for i in range(n_gen):\n        if active_gens[i]:\n            constraints.append(pg[i] >= gens[i, 9])\n            constraints.append(pg[i] <= gens[i, 8])\n            constraints.append(reserve[i] >= 0)\n            constraints.append(reserve[i] <= reserve_capacity[i])\n            constraints.append(pg[i] + reserve[i] <= gens[i, 8])\n        else:\n            constraints.append(pg[i] == 0)\n            constraints.append(reserve[i] == 0)\n    \n    constraints.append(cp.sum(reserve) >= reserve_requirement)\n    \n    slack_idx = None\n    for i, bus in enumerate(buses):\n        if bus[1] == 3:\n            slack_idx = i\n            constraints.append(theta[i] == 0)\n            break\n    \n    if slack_idx is None:\n        constraints.append(theta[0] == 0)\n    \n    for i in range(n_bus):\n        bus_num = int(buses[i, 0])\n        gen_injection = 0\n        for g in range(n_gen):\n            if int(gens[g, 0]) == bus_num and active_gens[g]:\n                gen_injection += pg[g]\n        \n        demand = buses[i, 2]\n        flow_out = 0\n        \n        for b in range(n_branch):\n            if branches[b, 10] == 0:\n                continue\n            f_bus = int(branches[b, 0])\n            t_bus = int(branches[b, 1])\n            x = branches[b, 3]\n            \n            if x == 0:\n                continue\n            \n            if f_bus == bus_num:\n                f_idx = bus_idx[f_bus]\n                t_idx = bus_idx[t_bus]\n                flow_out += (theta[f_idx] - theta[t_idx]) / x\n            elif t_bus == bus_num:\n                f_idx = bus_idx[f_bus]\n                t_idx = bus_idx[t_bus]\n                flow_out += (theta[t_idx] - theta[f_idx]) / x\n        \n        constraints.append(gen_injection == demand + flow_out)\nPART2\n"]
