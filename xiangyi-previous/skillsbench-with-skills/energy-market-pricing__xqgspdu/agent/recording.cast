[295.683868, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             slack_idx = i\r\n\u001b[?2004l\r\u001b[?2004h>             constraints.append(theta[i] == 0)\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if slack_idx is None:\r\n\u001b[?2004l\r\u001b[?2004h>         constraints.append(theta[0] == 0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n_bus):\r\n\u001b[?2004l\r\u001b[?2004h>         bus_num = int(buses[i, 0])\r\n\u001b[?2004l\r\u001b[?2004h>         gen_injection = 0\r\n\u001b[?2004l\r\u001b[?2004h>         for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>             if int(gens[g, 0]) == bus_num and active_gens[g]:\r\n\u001b[?2004l\r\u001b[?2004h>                 gen_injection += pg[g]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         demand = buses[i, 2]\r\n\u001b[?2004l\r\u001b[?2004h>         flow_out = 0\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for b in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h>             if branches[b, 10] == 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             f_bus = int(branches[b, 0])\r\n\u001b[?2004l\r\u001b[?2004h>             t_bus = int(branches[b, 1])\r\n\u001b[?2004l\r\u001b[?2004h>             x = branches[b, 3]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if x == 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if f_bus == bus_num:\r\n\u001b[?2004l\r\u001b[?2004h>                 f_idx = bus_idx[f_bus]\r\n\u001b[?2004l\r\u001b[?2004h>                 t_idx = bus_idx[t_bus]\r\n\u001b[?2004l\r\u001b[?2004h>                 flow_out += (theta[f_idx] - theta[t_idx]) / x\r\n\u001b[?2004l\r\u001b[?2004h>             elif t_bus == bus_num:\r\n\u001b[?2004l\r\u001b[?2004h>                 f_idx = bus_idx[f_bus]\r\n\u001b[?2004l\r\u001b[?2004h>                 t_idx = bus_idx[t_bus]\r\n\u001b[?2004l\r\u001b[?2004h>                 flow_out += (theta[t_idx] - theta[f_idx]) / x\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         constraints.append(gen_injection == demand + flow_out)\r\n\u001b[?2004l\r\u001b[?2004h> PART2\r\n\u001b[?2004l\r"]
[295.685222, "o", "\u001b[?2004hroot@9ea04964a8fb:~# "]
[306.263161, "i", "cat >> solve_dcopf.py << 'PART3'\n    \n    for b in range(n_branch):\n        if branches[b, 10] == 0:\n            continue\n        \n        f_bus = int(branches[b, 0])\n        t_bus = int(branches[b, 1])\n        x = branches[b, 3]\n        rate_a = branches[b, 5]\n        \n        if x == 0 or rate_a == 0:\n            continue\n        \n        f_idx = bus_idx[f_bus]\n        t_idx = bus_idx[t_bus]\n        \n        flow = (theta[f_idx] - theta[t_idx]) / x\n        flow_limit = rate_a / baseMVA\n        \n        constraints.append(flow <= flow_limit)\n        constraints.append(flow >= -flow_limit)\n    \n    problem = cp.Problem(objective, constraints)\n    problem.solve(solver=cp.ECOS, verbose=False)\n    \n    if problem.status not in [cp.OPTIMAL, cp.OPTIMAL_INACCURATE]:\n        print(f\"Warning: Solver status: {problem.status}\")\n    \n    result = {\n        'status': problem.status,\n        'total_cost': problem.value,\n        'pg': pg.value,\n        'theta': theta.value,\n        'reserve': reserve.value,\n        'buses': buses,\n        'gens': gens,\n        'branches': branches,\n        'baseMVA': baseMVA,\n        'bus_idx': bus_idx,\n        'gencost': gencost,\n        'active_gens': active_gens\n    }\n    \n    return result\nPART3\n"]
