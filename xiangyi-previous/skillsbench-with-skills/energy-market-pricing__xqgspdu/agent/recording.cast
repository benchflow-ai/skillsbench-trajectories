[343.34417, "i", "cat >> solve_dcopf.py << 'PART6'\n\ndef main():\n    data = load_network('network.json')\n    \n    print(\"Solving base case...\")\n    base_result = solve_dcopf_with_reserves(data)\n    base_analysis = analyze_results(base_result, data)\n    \n    print(f\"Base case total cost: ${base_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\n    print(f\"Base case binding lines: {len(base_analysis['binding_lines'])}\")\n    \n    branch_idx = 1446\n    original_limit = data['branch'][branch_idx][5]\n    new_limit = original_limit * 1.2\n    \n    print(f\"\\nModifying branch {branch_idx} (64->1501): {original_limit} MW -> {new_limit} MW\")\n    print(\"Solving counterfactual case...\")\n    \n    cf_result = solve_dcopf_with_reserves(data, {branch_idx: new_limit})\n    cf_analysis = analyze_results(cf_result, data)\n    \n    print(f\"Counterfactual total cost: ${cf_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\n    print(f\"Counterfactual binding lines: {len(cf_analysis['binding_lines'])}\")\n    \n    cost_reduction = base_analysis['total_cost_dollars_per_hour'] - cf_analysis['total_cost_dollars_per_hour']\n    print(f\"\\nCost reduction: ${cost_reduction:.2f}/hr\")\n    \n    lmp_drops = []\n    base_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in base_analysis['lmp_by_bus']}\n    cf_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in cf_analysis['lmp_by_bus']}\n    \n    for bus in base_lmps:\n        if bus in cf_lmps:\n            delta = cf_lmps[bus] - base_lmps[bus]\n            if delta < 0:\n                lmp_drops.append({\n                    'bus': bus,\n                    'base_lmp': base_lmps[bus],\n                    'cf_lmp': cf_lmps[bus],\n                    'delta': delta\n                })\n    \n    lmp_drops.sort(key=lambda x: x['delta'])\n    top_3_drops = lmp_drops[:3]\n    \n    congestion_relieved = True\n    for line in cf_analysis['binding_lines']:\n        if line['from'] == 64 and line['to'] == 1501:\n            congestion_relieved = False\n            break\n        if line['from'] == 1501 and line['to'] == 64:\n            congestion_relieved = False\n            break\nPART6\n"]
