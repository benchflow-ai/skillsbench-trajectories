[213.65428, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\n\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nprint(\"Branch columns:\", data['column_info']['branch'])\nprint(\"\\nGen columns:\", data['column_info']['gen'])\nprint(\"\\nBus columns:\", data['column_info']['bus'])\nprint(\"\\nGencost columns:\", data['column_info']['gencost'])\nprint(\"\\nReserve columns:\", data['column_info']['reserve'])\n\n# Find the branch from 64 to 1501\nbranches = np.array(data['branch'])\nfor i, branch in enumerate(branches):\n    if (branch[0] == 64 and branch[1] == 1501) or (branch[0] == 1501 and branch[1] == 64):\n        print(f\"\\nFound branch {i}: from bus {int(branch[0])} to bus {int(branch[1])}\")\n        print(f\"Branch data: {branch}\")\n        break\nEOF\n"]
