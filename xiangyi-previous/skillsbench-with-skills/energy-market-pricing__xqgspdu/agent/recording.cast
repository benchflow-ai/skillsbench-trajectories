[283.227602, "o", "import cvxpy as cp\r\n\u001b[?2004l\r"]
[283.227642, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[283.22775, "o", "def load_network(filename):\r\n\u001b[?2004l\r\u001b[?2004h> "]
