[528.798464, "o", "            A[b, f_idx] = 1\r\n\u001b[?2004l\r"]
[528.798486, "o", "\u001b[?2004h> "]
[528.798602, "o", "            A[b, t_idx] = -1\r\n\u001b[?2004l\r"]
[528.798621, "o", "\u001b[?2004h> "]
[528.798667, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.798723, "o", "    return A\r\n\u001b[?2004l\ri"]
