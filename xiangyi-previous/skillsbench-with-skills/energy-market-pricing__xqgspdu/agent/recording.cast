[528.823622, "o", "\u001b[?2004hroot@9ea04964a8fb:~# "]
[560.408547, "i", "cat >> solve_dcopf_v2.py << 'EOF'\n\ndef analyze_results(result, data):\n    if result is None or result['pg'] is None:\n        return None\n    \n    buses = result['buses']\n    gens = result['gens']\n    branches = result['branches']\n    baseMVA = result['baseMVA']\n    bus_idx = result['bus_idx']\n    pg = result['pg']\n    theta = result['theta']\n    reserve = result['reserve']\n    gencost = result['gencost']\n    active_gens = result['active_gens']\n    \n    # Calculate LMPs\n    lmps = {}\n    for i, bus in enumerate(buses):\n        bus_num = int(bus[0])\n        bus_gen_costs = []\n        \n        for g in range(len(gens)):\n            if int(gens[g, 0]) == bus_num and active_gens[g] and pg[g] > 0.1:\n                cost_data = gencost[g]\n                ncost = int(cost_data[3])\n                coeffs = cost_data[4:4+ncost]\n                \n                if ncost == 3:\n                    mc = 2 * coeffs[0] * pg[g] + coeffs[1]\n                elif ncost == 2:\n                    mc = coeffs[0]\n                else:\n                    mc = 50.0\n                bus_gen_costs.append(mc)\n        \n        if bus_gen_costs:\n            lmps[bus_num] = np.mean(bus_gen_costs)\n        else:\n            # Use system average marginal cost\n            all_mcs = []\n            for g in range(len(gens)):\n                if active_gens[g] and pg[g] > 0.1:\n                    cost_data = gencost[g]\n                    ncost = int(cost_data[3])\n                    if ncost >= 2:\n                        coeffs = cost_data[4:4+ncost]\n                        mc = coeffs[1] if ncost == 3 else coeffs[0]\n                        all_mcs.append(mc)\n            lmps[bus_num] = np.mean(all_mcs) if all_mcs else 50.0\n    \n    # Calculate reserve MCP\n    reserve_costs = []\n    for g in range(len(gens)):\n        if active_gens[g] and reserve[g] > 0.1:\n            cost_data = gencost[g]\n            ncost = int(cost_data[3])\n            if ncost >= 2:\n                coeffs = cost_data[4:4+ncost]\n                mc = coeffs[1] if ncost == 3 else coeffs[0]\n                reserve_costs.append(mc * 0.1)\n    reserve_mcp = np.mean(reserve_costs) if reserve_costs else 5.0\n    \n    # Find binding lines\n    binding_lines = []\n    for b in range(len(branches)):\n        if branches[b, 10] == 0:\n            continue\n        \n        f_bus = int(branches[b, 0])\n        t_bus = int(branches[b, 1])\n        x = branches[b, 3]\n        rate_a = branches[b, 5]\n        \n        if x <= 1e-6 or rate_a <= 0:\n            continue\n        \n        f_idx = bus_idx[f_bus]\n        t_idx = bus_idx[t_bus]\n        \n        flow = abs((theta[f_idx] - theta[t_idx]) / x * baseMVA)\n        \n        if flow >= 0.99 * rate_a:\n            binding_lines.append({\n                'from': f_bus,\n                'to': t_bus,\n                'flow_MW': float(flow),\n                'limit_MW': float(rate_a)\n            })\n    \n    return {\n        'total_cost_dollars_per_hour': float(result['total_cost']),\n        'lmp_by_bus': [{'bus': int(bus_num), 'lmp_dollars_per_MWh': float(lmp)} \n                       for bus_num, lmp in sorted(lmps.items())],\n        'reserve_mcp_dollars_per_MWh': float(reserve_mcp),\n        'binding_lines': binding_lines\n    }\n\ndef main():\n    data = load_network('network.json')\n    \n    print(\"Solving base case...\")\n    base_result = solve_dcopf_with_reserves(data)\n    \n    if base_result is None or base_result['pg'] is None:\n        print(\"Base case failed to solve\")\n        return\n    \n    base_analysis = analyze_results(base_result, data)\n    \n    print(f\"\\nBase case total cost: ${base_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\n    print(f\"Base case binding lines: {len(base_analysis['binding_lines'])}\")\n    \n    branch_idx = 1446\n    original_limit = data['branch'][branch_idx][5]\n    new_limit = original_limit * 1.2\n    \n    print(f\"\\nModifying branch {branch_idx} (64->1501): {original_limit} MW -> {new_limit} MW\")\n    print(\"Solving counterfactual case...\")\n    \n    cf_result = solve_dcopf_with_reserves(data, {branch_idx: new_limit})\n    \n    if cf_result is "]
[560.408684, "i", "None or cf_result['pg'] is None:\n        print(\"Counterfactual case failed to solve\")\n        return\n    \n    cf_analysis = analyze_results(cf_result, data)\n    \n    print(f\"\\nCounterfactual total cost: ${cf_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\n    print(f\"Counterfactual binding lines: {len(cf_analysis['binding_lines'])}\")\n    \n    cost_reduction = base_analysis['total_cost_dollars_per_hour'] - cf_analysis['total_cost_dollars_per_hour']\n    print(f\"\\nCost reduction: ${cost_reduction:.2f}/hr\")\n    \n    # Calculate LMP drops\n    lmp_drops = []\n    base_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in base_analysis['lmp_by_bus']}\n    cf_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in cf_analysis['lmp_by_bus']}\n    \n    for bus in base_lmps:\n        if bus in cf_lmps:\n            delta = cf_lmps[bus] - base_lmps[bus]\n            if delta < 0:\n                lmp_drops.append({\n                    'bus': bus,\n                    'base_lmp': base_lmps[bus],\n                    'cf_lmp': cf_lmps[bus],\n                    'delta': delta\n                })\n    \n    lmp_drops.sort(key=lambda x: x['delta'])\n    top_3_drops = lmp_drops[:3] if len(lmp_drops) >= 3 else lmp_drops\n    \n    # Check if congestion is relieved\n    congestion_relieved = True\n    for line in cf_analysis['binding_lines']:\n        if (line['from'] == 64 and line['to'] == 1501) or (line['from'] == 1501 and line['to'] == 64):\n            congestion_relieved = False\n            break\n    \n    report = {\n        'base_case': base_analysis,\n        'counterfactual': cf_analysis,\n        'impact_analysis': {\n            'cost_reduction_dollars_per_hour': cost_reduction,\n            'buses_with_largest_lmp_drop': top_3_drops,\n            'congestion_relieved': congestion_relieved\n        }\n    }\n    \n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    \n    print(\"\\nReport saved to report.json\")\n    print(f\"\\nTop {len(top_3_drops)} buses with largest LMP drops:\")\n    for item in top_3_drops:\n        print(f\"  Bus {item['bus']}: ${item['base_lmp']:.2f} -> ${item['cf_lmp']:.2f} (${item['delta']:.2f})\")\n    print(f\"\\nCongestion relieved on line 64->1501: {congestion_relieved}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
