[343.347278, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.347334, "o", "    for bus in base_lmps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.347372, "o", "> "]
[343.347408, "o", "        if bus in cf_lmps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.347509, "o", "            delta = cf_lmps[bus] - base_lmps[bus]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.347563, "o", "            if delta < 0:\r\n\u001b[?2004l\r"]
[343.347598, "o", "\u001b[?2004h> "]
[343.347685, "o", "                lmp_drops.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
