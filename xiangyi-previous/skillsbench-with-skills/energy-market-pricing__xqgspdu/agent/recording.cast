[528.798764, "o", "\u001b[?2004h"]
[528.798787, "o", "> "]
[528.799029, "o", "def solve_dcopf_with_reserves(data, branch_modifications=None):\r\n\u001b[?2004l\r"]
[528.799051, "o", "\u001b[?2004h> "]
[528.799178, "o", "    baseMVA = data['baseMVA']\r\n\u001b[?2004l\r"]
[528.799199, "o", "\u001b[?2004h> "]
[528.799344, "o", "    buses = np.array(data['bus'])\r\n\u001b[?2004l\r"]
[528.799366, "o", "\u001b[?2004h> "]
[528.799504, "o", "    gens = np.array(data['gen'])\r\n\u001b[?2004l\r"]
[528.799526, "o", "\u001b[?2004h> "]
[528.79972, "o", "    branches = np.array(data['branch']).copy()\r\n\u001b[?2004l\r"]
[528.79974, "o", "\u001b[?2004h> "]
