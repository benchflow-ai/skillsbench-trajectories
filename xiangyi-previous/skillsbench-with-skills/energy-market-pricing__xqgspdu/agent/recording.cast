[528.799937, "o", "\u001b[?2004h"]
[528.799954, "o", "> "]
[528.800203, "o", "    reserve_capacity = np.array(data['reserve_capacity'])\r\n\u001b[?2004l\r"]
[528.800247, "o", "\u001b[?2004h> "]
[528.800477, "o", "    reserve_requirement = data['reserve_requirement']\r\n\u001b[?2004l\r"]
[528.800496, "o", "\u001b[?2004h> "]
[528.800546, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.800568, "o", "> "]
[528.800723, "o", "    if branch_modifications:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.800997, "o", "        for branch_idx, new_limit in branch_modifications.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.80102, "o", "> "]
[528.8012, "o", "            branches[branch_idx, 5] = new_limit\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.801223, "o", "> "]
[528.801244, "o", "    \r\n\u001b[?2004l\r"]
[528.801305, "o", "\u001b[?2004h> "]
[528.801414, "o", "    n_bus = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.801435, "o", "> "]
[528.801539, "o", "    n_gen = len(gens)\r\n\u001b[?2004l\r"]
[528.801557, "o", "\u001b[?2004h> "]
[528.801695, "o", "    n_branch = len(branches)\r\n\u001b[?2004l\r"]
[528.801715, "o", "\u001b[?2004h> "]
[528.801765, "o", "    \r\n\u001b[?2004l\r"]
[528.801788, "o", "\u001b[?2004h> "]
[528.801963, "o", "    bus_nums = buses[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.801983, "o", "> "]
[528.802219, "o", "    bus_idx = {int(num): i for i, num in enumerate(bus_nums)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.802239, "o", "> "]
[528.802258, "o", "    \r\n\u001b[?2004l\r"]
[528.802279, "o", "\u001b[?2004h"]
[528.802301, "o", "> "]
[528.80241, "o", "    gen_status = gens[:, 7]\r\n\u001b[?2004l\r"]
[528.80243, "o", "\u001b[?2004h> "]
[528.802591, "o", "    active_gens = (gen_status == 1)\r\n\u001b[?2004l\r"]
[528.802615, "o", "\u001b[?2004h> "]
[528.802664, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.802756, "o", "    # Decision variables\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.802773, "o", "> "]
[528.80287, "o", "    pg = cp.Variable(n_gen)\r\n\u001b[?2004l\r"]
[528.802894, "o", "\u001b[?2004h> "]
[528.803184, "o", "    theta = cp.Variable(n_bus)\r\n"]
[528.803209, "o", "\u001b[?2004l\r"]
[528.803264, "o", "\u001b[?2004h> "]
[528.803418, "o", "    reserve = cp.Variable(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.803441, "o", "> "]
[528.803461, "o", "    \r\n\u001b[?2004l\r"]
[528.803523, "o", "\u001b[?2004h> "]
[528.803629, "o", "    # Build cost function\r\n\u001b[?2004l\r"]
[528.803651, "o", "\u001b[?2004h> "]
[528.803741, "o", "    costs = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.803761, "o", "> "]
[528.803885, "o", "    for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.803906, "o", "> "]
[528.804031, "o", "        cost_data = gencost[i]\r\n\u001b[?2004l\r"]
[528.804053, "o", "\u001b[?2004h> "]
[528.804221, "o", "        ncost = int(cost_data[3])\r\n\u001b[?2004l\r"]
[528.804244, "o", "\u001b[?2004h> "]
[528.804411, "o", "        coeffs = cost_data[4:4+ncost]\r\n\u001b[?2004l\r"]
[528.80443, "o", "\u001b[?2004h> "]
[528.804479, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.804499, "o", "> "]
[528.804635, "o", "        if ncost == 3:  # Quadratic\r\n\u001b[?2004l\r"]
[528.804655, "o", "\u001b[?2004h> "]
[528.805045, "o", "            costs.append(coeffs[0] * cp.square(pg[i]) + coeffs[1] * pg[i] + coeffs[2])\r\n\u001b[?2004l\r"]
[528.805064, "o", "\u001b[?2004h> "]
[528.80521, "o", "        elif ncost == 2:  # Linear\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.80523, "o", "> "]
[528.805364, "o", "            costs.append(coeffs[0] * pg[i] + coeffs[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.805384, "o", "> "]
[528.805436, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.805508, "o", "            costs.append(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.805529, "o", ">     \r\n"]
[528.805546, "o", "\u001b[?2004l\r"]
[528.805564, "o", "\u001b[?2004h> "]
[528.805696, "o", "    # Reserve costs (10% of marginal energy cost)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.805754, "o", "    reserve_cost = 0\r\n\u001b[?2004l\r"]
[528.805775, "o", "\u001b[?2004h> "]
[528.805859, "o", "    for i in range(n_gen):\r\n\u001b[?2004l\r"]
[528.80588, "o", "\u001b[?2004h> "]
[528.805946, "o", "        cost_data = gencost[i]\r\n\u001b[?2004l\r"]
[528.805966, "o", "\u001b[?2004h"]
[528.805984, "o", "> "]
[528.806066, "o", "        ncost = int(cost_data[3])\r\n\u001b[?2004l\r"]
[528.806087, "o", "\u001b[?2004h"]
[528.806105, "o", "> "]
[528.806163, "o", "        if ncost >= 2:\r\n\u001b[?2004l\r"]
[528.806185, "o", "\u001b[?2004h"]
[528.806204, "o", "> "]
[528.80631, "o", "            coeffs = cost_data[4:4+ncost]\r\n\u001b[?2004l\r"]
[528.806332, "o", "\u001b[?2004h"]
[528.806351, "o", "> "]
[528.806491, "o", "            mc = coeffs[1] if ncost == 3 else coeffs[0]\r\n\u001b[?2004l\r"]
[528.806512, "o", "\u001b[?2004h"]
[528.806529, "o", "> "]
[528.806653, "o", "            reserve_cost += 0.1 * mc * reserve[i]\r\n\u001b[?2004l\r"]
[528.806676, "o", "\u001b[?2004h"]
[528.806696, "o", "> "]
[528.806716, "o", "    \r\n\u001b[?2004l\r"]
[528.80679, "o", "\u001b[?2004h> "]
[528.806907, "o", "    objective = cp.Minimize(cp.sum(costs) + reserve_cost)\r\n"]
[528.806927, "o", "\u001b[?2004l\r"]
[528.806946, "o", "\u001b[?2004h"]
[528.806964, "o", "> "]
[528.807034, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.807088, "o", "    constraints = []\r\n\u001b[?2004l\r"]
[528.807129, "o", "\u001b[?2004h> "]
[528.807171, "o", "    \r\n\u001b[?2004l\r"]
[528.807191, "o", "\u001b[?2004h"]
[528.807211, "o", "> "]
[528.807303, "o", "    # Generator constraints\r\n\u001b[?2004l\r"]
[528.807322, "o", "\u001b[?2004h"]
[528.807341, "o", "> "]
[528.807406, "o", "    for i in range(n_gen):\r\n\u001b[?2004l\r"]
[528.807427, "o", "\u001b[?2004h"]
[528.807444, "o", "> "]
[528.807547, "o", "        if active_gens[i]:\r\n\u001b[?2004l\r"]
[528.807565, "o", "\u001b[?2004h"]
[528.807614, "o", "> "]
[528.80777, "o", "            constraints.append(pg[i] >= gens[i, 9])  # PMIN\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.807795, "o", "> "]
[528.807968, "o", "            constraints.append(pg[i] <= gens[i, 8])  # PMAX\r\n\u001b[?2004l\r"]
[528.807986, "o", "\u001b[?2004h"]
[528.808006, "o", "> "]
[528.808155, "o", "            constraints.append(reserve[i] >= 0)\r\n"]
[528.808177, "o", "\u001b[?2004l\r"]
[528.808196, "o", "\u001b[?2004h> "]
[528.808361, "o", "            constraints.append(reserve[i] <= reserve_capacity[i])\r\n\u001b[?2004l\r"]
[528.808382, "o", "\u001b[?2004h> "]
[528.808618, "o", "            constraints.append(pg[i] + reserve[i] <= gens[i, 8])  # Capacity coupling\r\n\u001b[?2004l\r"]
[528.808639, "o", "\u001b[?2004h> "]
[528.808689, "o", "        else:\r\n\u001b[?2004l\r"]
[528.80871, "o", "\u001b[?2004h> "]
[528.808836, "o", "            constraints.append(pg[i] == 0)\r\n\u001b[?2004l\r"]
[528.808854, "o", "\u001b[?2004h"]
[528.80887, "o", "> "]
[528.80905, "o", "            constraints.append(reserve[i] == 0)\r\n\u001b[?2004l\r"]
[528.809106, "o", "\u001b[?2004h"]
[528.809128, "o", "> "]
[528.809175, "o", "    \r\n"]
[528.809192, "o", "\u001b[?2004l\r"]
[528.809245, "o", "\u001b[?2004h> "]
[528.809352, "o", "    # System reserve requirement\r\n\u001b[?2004l\r"]
[528.80937, "o", "\u001b[?2004h"]
[528.8094, "o", "> "]
[528.809583, "o", "    constraints.append(cp.sum(reserve) >= reserve_requirement)\r\n\u001b[?2004l\r"]
[528.809604, "o", "\u001b[?2004h"]
[528.809623, "o", "> "]
[528.809644, "o", "    \r\n\u001b[?2004l\r"]
[528.809712, "o", "\u001b[?2004h> "]
[528.809787, "o", "    # Reference angle (slack bus)\r\n\u001b[?2004l\r"]
[528.809828, "o", "\u001b[?2004h> "]
[528.80988, "o", "    slack_idx = 0\r\n\u001b[?2004l\r"]
[528.8099, "o", "\u001b[?2004h> "]
[528.809999, "o", "    for i, bus in enumerate(buses):\r\n\u001b[?2004l\r"]
[528.810019, "o", "\u001b[?2004h> "]
[528.81009, "o", "        if bus[1] == 3:\r\n\u001b[?2004l\r"]
[528.810111, "o", "\u001b[?2004h> "]
[528.81018, "o", "            slack_idx = i\r\n"]
[528.810198, "o", "\u001b[?2004l\r"]
[528.810244, "o", "\u001b[?2004h> "]
[528.810309, "o", "            break\r\n\u001b[?2004l\r"]
[528.810329, "o", "\u001b[?2004h> "]
[528.810453, "o", "    constraints.append(theta[slack_idx] == 0)\r\n\u001b[?2004l\r"]
[528.810493, "o", "\u001b[?2004h> "]
[528.810531, "o", "    \r\n\u001b[?2004l\r"]
[528.810555, "o", "\u001b[?2004h> "]
[528.810646, "o", "    # Power balance at each bus\r\n\u001b[?2004l\r"]
[528.810667, "o", "\u001b[?2004h> "]
[528.810772, "o", "    for i in range(n_bus):\r\n\u001b[?2004l\r"]
[528.810798, "o", "\u001b[?2004h"]
[528.810816, "o", "> "]
[528.810926, "o", "        bus_num = int(buses[i, 0])\r\n\u001b[?2004l\r"]
[528.810945, "o", "\u001b[?2004h"]
[528.810994, "o", "> "]
[528.811034, "o", "        \r\n\u001b[?2004l\r"]
[528.811077, "o", "\u001b[?2004h> "]
[528.811148, "o", "        # Generation\r\n\u001b[?2004l\r"]
[528.811169, "o", "\u001b[?2004h> "]
[528.81123, "o", "        gen_power = 0\r\n\u001b[?2004l\r"]
[528.81125, "o", "\u001b[?2004h> "]
[528.811343, "o", "        for g in range(n_gen):\r\n\u001b[?2004l\r"]
[528.811362, "o", "\u001b[?2004h> "]
