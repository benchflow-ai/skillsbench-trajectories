[560.416013, "o", "\u001b[?2004h> "]
[560.416122, "o", "            cost_data = gencost[g]\r\n\u001b[?2004l\r"]
[560.416176, "o", "\u001b[?2004h> "]
[560.41627, "o", "            ncost = int(cost_data[3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.416314, "o", "> "]
[560.416358, "o", "            if ncost >= 2:\r\n\u001b[?2004l\r"]
[560.416403, "o", "\u001b[?2004h> "]
[560.416507, "o", "                coeffs = cost_data[4:4+ncost]\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.416552, "o", "> "]
[560.416683, "o", "                mc = coeffs[1] if ncost == 3 else coeffs[0]\r\n\u001b[?2004l\r"]
[560.416726, "o", "\u001b[?2004h> "]
[560.41683, "o", "                reserve_costs.append(mc * 0.1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.416873, "o", "> "]
[560.417037, "o", "    reserve_mcp = np.mean(reserve_costs) if reserve_costs else 5.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.417084, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417151, "o", "    # Find binding lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.417196, "o", "> "]
[560.417243, "o", "    binding_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417344, "o", "    for b in range(len(branches)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.417403, "o", "> "]
[560.417448, "o", "        if branches[b, 10] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417497, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.417541, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417603, "o", "        f_bus = int(branches[b, 0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417672, "o", "        t_bus = int(branches[b, 1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417732, "o", "        x = branches[b, 3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.417781, "o", "> "]
[560.417827, "o", "        rate_a = branches[b, 5]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[560.417872, "o", "\u001b[?2004h> "]
[560.417917, "o", "        if x <= 1e-6 or rate_a <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.417961, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418006, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418051, "o", "        f_idx = bus_idx[f_bus]\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.418095, "o", "> "]
[560.418141, "o", "        t_idx = bus_idx[t_bus]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[560.418187, "o", "\u001b[?2004h> "]
[560.418272, "o", "        flow = abs((theta[f_idx] - theta[t_idx]) / x * baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418316, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418361, "o", "        if flow >= 0.99 * rate_a:\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.418407, "o", "> "]
[560.418452, "o", "            binding_lines.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418497, "o", "                'from': f_bus,\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.418541, "o", "> "]
[560.418586, "o", "                'to': t_bus,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.41863, "o", "                'flow_MW': float(flow),\r\n\u001b[?2004l\r"]
[560.418677, "o", "\u001b[?2004h> "]
[560.418721, "o", "                'limit_MW': float(rate_a)\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.418769, "o", ">             })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.418818, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[560.418863, "o", "\u001b[?2004h> "]
[560.418947, "o", "        'total_cost_dollars_per_hour': float(result['total_cost']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.418994, "o", "> "]
[560.419083, "o", "        'lmp_by_bus': [{'bus': int(bus_num), 'lmp_dollars_per_MWh': float(lmp)} \r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419127, "o", "> "]
[560.419197, "o", "                       for bus_num, lmp in sorted(lmps.items())],\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419244, "o", "> "]
[560.419304, "o", "        'reserve_mcp_dollars_per_MWh': float(reserve_mcp),\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419348, "o", "> "]
[560.419393, "o", "        'binding_lines': binding_lines\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[560.419436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.419477, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.419542, "o", "    data = load_network('network.json')\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419584, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.419642, "o", "    print(\"Solving base case...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419686, "o", "> "]
[560.419731, "o", "    base_result = solve_dcopf_with_reserves(data)\r\n\u001b[?2004l\r"]
[560.419775, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.419867, "o", "    if base_result is None or base_result['pg'] is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.419914, "o", "> "]
[560.419958, "o", "        print(\"Base case failed to solve\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.420007, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[560.420053, "o", "\u001b[?2004h> "]
[560.420112, "o", "    base_analysis = analyze_results(base_result, data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.420169, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.420304, "o", "    print(f\"\\nBase case total cost: ${base_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.420348, "o", "> "]
[560.420434, "o", "    print(f\"Base case binding lines: {len(base_analysis['binding_lines'])}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.420478, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.420523, "o", "    branch_idx = 1446\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.420607, "o", "    original_limit = data['branch'][branch_idx][5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.420652, "o", "> "]
[560.420699, "o", "    new_limit = original_limit * 1.2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[560.420743, "o", "\u001b[?2004h> "]
[560.420866, "o", "    print(f\"\\nModifying branch {branch_idx} (64->1501): {original_limit} MW -> {new_limit} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.42091, "o", "> "]
[560.420955, "o", "    print(\"Solving counterfactual case...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421102, "o", "    cf_result = solve_dcopf_with_reserves(data, {branch_idx: new_limit})\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.421147, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421224, "o", "    if cf_result is None or cf_result['pg'] is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.421269, "o", "> "]
[560.421315, "o", "        print(\"Counterfactual case failed to solve\")\r\n\u001b[?2004l\r"]
[560.42136, "o", "\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.421407, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421483, "o", "    cf_analysis = analyze_results(cf_result, data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.421528, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421692, "o", "    print(f\"\\nCounterfactual total cost: ${cf_analysis['total_cost_dollars_per_hour']:.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.421806, "o", "    print(f\"Counterfactual binding lines: {len(cf_analysis['binding_lines'])}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.42185, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422008, "o", "    cost_reduction = base_analysis['total_cost_dollars_per_hour'] - cf_analysis['total_cost_dollars_per_hour']\r\n\u001b[?2004l\r"]
[560.422072, "o", "\u001b[?2004h> "]
[560.422118, "o", "    print(f\"\\nCost reduction: ${cost_reduction:.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422164, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.42221, "o", "    # Calculate LMP drops\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422254, "o", "    lmp_drops = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422407, "o", "    base_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in base_analysis['lmp_by_bus']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.42245, "o", "> "]
[560.422562, "o", "    cf_lmps = {item['bus']: item['lmp_dollars_per_MWh'] for item in cf_analysis['lmp_by_bus']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.422606, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422652, "o", "    for bus in base_lmps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.422713, "o", "        if bus in cf_lmps:\r\n\u001b[?2004l\r"]
[560.42276, "o", "\u001b[?2004h> "]
[560.42281, "o", "            delta = cf_lmps[bus] - base_lmps[bus]\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.422858, "o", ">             if delta < 0:\r\n\u001b[?2004l\r"]
[560.422903, "o", "\u001b[?2004h> "]
[560.422947, "o", "                lmp_drops.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.423005, "o", "                    'bus': bus,\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423051, "o", "> "]
[560.423095, "o", "                    'base_lmp': base_lmps[bus],\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.42314, "o", "> "]
[560.423183, "o", "                    'cf_lmp': cf_lmps[bus],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.423247, "o", "                    'delta': delta\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423292, "o", ">                 })\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423337, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.423405, "o", "    lmp_drops.sort(key=lambda x: x['delta'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423451, "o", "> "]
[560.423529, "o", "    top_3_drops = lmp_drops[:3] if len(lmp_drops) >= 3 else lmp_drops\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423576, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.423624, "o", "    # Check if congestion is relieved\r\n\u001b[?2004l\r"]
[560.423669, "o", "\u001b[?2004h> "]
[560.423713, "o", "    congestion_relieved = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.423794, "o", "    for line in cf_analysis['binding_lines']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.423839, "o", "> "]
[560.423958, "o", "        if (line['from'] == 64 and line['to'] == 1501) or (line['from'] == 1501 and line['to'] == 64):\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.424005, "o", "> "]
[560.424053, "o", "            congestion_relieved = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.424097, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[560.424152, "o", "\u001b[?2004h>     report = {\r\n\u001b[?2004l\r"]
[560.424199, "o", "\u001b[?2004h> "]
[560.424245, "o", "        'base_case': base_analysis,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.424306, "o", "        'counterfactual': cf_analysis,\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.424355, "o", "> "]
[560.424401, "o", "        'impact_analysis': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.424484, "o", "            'cost_reduction_dollars_per_hour': cost_reduction,\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.42453, "o", "> "]
[560.424589, "o", "            'buses_with_largest_lmp_drop': top_3_drops,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.42468, "o", "            'congestion_relieved': congestion_relieved\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.424729, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.424775, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[560.424826, "o", "> "]
[560.424871, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.424931, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.424973, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.425043, "o", "    print(\"\\nReport saved to report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.425089, "o", "> "]
[560.42516, "o", "    print(f\"\\nTop {len(top_3_drops)} buses with largest LMP drops:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.425205, "o", "> "]
[560.425256, "o", "    for item in top_3_drops:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.425419, "o", "        print(f\"  Bus {item['bus']}: ${item['base_lmp']:.2f} -> ${item['cf_lmp']:.2f} (${item['delta']:.2f})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.425466, "o", "> "]
[560.425556, "o", "    print(f\"\\nCongestion relieved on line 64->1501: {congestion_relieved}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[560.425602, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[560.425646, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[560.425691, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
