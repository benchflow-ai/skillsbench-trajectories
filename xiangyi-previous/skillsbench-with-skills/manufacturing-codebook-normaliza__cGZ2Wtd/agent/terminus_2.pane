[?2004l[?2004h>                 'category': entry.get('category_lv2', ''),
[?2004l[?2004h>                 'stations': str(entry.get('station_scope', '')).split(';')
[?2004l[?2004h>             })
[?2004l[?2004h>     return index
[?2004l[?2004h> 
[?2004le[?2004h> # Common defect patterns for better segmentation
[?2004l[?2004h> DEFECT_PATTERNS = [
[?2004l[?2004h>     # Fixture/probe issues
[?2004l[?2004h>     (r'治具[/\\]?探针接触不良[，,]?重插后偶尔OK', 'fixture_contact'),
[?2004l[?2004h>     (r'fixture contact unstable[,\s]*reseat sometimes passes', 'fixture_contact'),
