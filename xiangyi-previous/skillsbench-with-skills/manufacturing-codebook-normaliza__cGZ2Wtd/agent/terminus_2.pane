[?2004l[?2004h> # Convert score to calibrated confidence
[?2004l[?2004h> def calibrate_confidence(score, is_unknown):
[?2004l[?2004h>     if is_unknown:
[?2004l[?2004h>         # Unknown predictions should have low confidence
[?2004l[?2004h>         return round(max(0.05, min(0.35, score * 0.5)), 3)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calibrated confidence for known predictions
[?2004l[?2004h>     # Score range: 0.15 to 1.0 -> Confidence range: 0.4 to 0.98
[?2004l[?2004h>     if score >= 0.7:
[?2004l[?2004h>         conf = 0.90 + (score - 0.7) * 0.27  # 0.90 to 0.98
[?2004l[?2004h>     elif score >= 0.5:
[?2004l[?2004h>         conf = 0.75 + (score - 0.5) * 0.75  # 0.75 to 0.90
[?2004l[?2004h>     elif score >= 0.35:
[?2004l[?2004h>         conf = 0.55 + (score - 0.35) * 1.33  # 0.55 to 0.75
[?2004l[?2004h>     elif score >= 0.2:
[?2004l[?2004h>         conf = 0.40 + (score - 0.2) * 1.0  # 0.40 to 0.55
[?2004l[?2004h>     else:
[?2004l[?2004h>         conf = 0.35 + score * 0.25  # Below threshold
[?2004l[?2004h>     
[?2004l[?2004h>     return round(min(0.98, max(0.38, conf)), 3)
[?2004l[?2004h> 
[?2004l[?2004h> # Main processing function
[?2004l[?2004h> def process_records():
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     codebooks = load_codebooks()
[?2004l[?2004h>     keyword_index = build_keyword_index(codebooks)
[?2004l[?2004h>     logs_df = pd.read_csv('/app/data/test_center_logs.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     records = []
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, row in logs_df.iterrows():
[?2004l[?2004h>         record_id = row['record_id']
[?2004l[?2004h>         product_id = row['product_id']
[?2004l[?2004h>         station = row['station']
[?2004l[?2004h>         engineer_id = row['engineer_id']
[?2004l[?2004h>         raw_reason_text = row['raw_reason_text']
[?2004l[?2004h>         
[?2004l[?2004h>         # Get appropriate codebook
[?2004l[?2004h>         indexed_codebook = keyword_index.get(product_id, [])
[?2004l[?2004h>         
[?2004l[?2004h>         # Segment the raw text
[?2004l[?2004h>         segments = segment_text(raw_reason_text)
[?2004l[?2004h>         
[?2004l[?2004h>         normalized = []
[?2004l[?2004h>         segment_id = 1
[?2004l[?2004h>         
[?2004l[?2004h>         for span_text in segments:
[?2004l[?2004h>             span_text = span_text.strip()
[?2004l[?2004h>             if not span_text or len(span_text) < 2:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Find best match
[?2004l[?2004h>             best_entry, score, matched_kw = find_best_match(span_text, indexed_codebook, station)
[?2004l[?2004h>             
[?2004l[?2004h>             # Threshold for unknown
[?2004l[?2004h>             unknown_threshold = 0.18
[?2004l[?2004h>             
[?2004l[?2004h>             if best_entry is None or score < unknown_threshold:
[?2004l[?2004h>                 pred_code = "UNKNOWN"
[?2004l[?2004h>                 pred_label = ""
[?2004l[?2004h>                 confidence = calibrate_confidence(score, True)
[?2004l[?2004h>                 rationale = f"Low match score ({score:.2f}), no confident codebook match"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 pred_code = best_entry['code']
[?2004l[?2004h>                 pred_label = best_entry['standard_label']
[?2004l[?2004h>                 confidence = calibrate_confidence(score, False)
[?2004l[?2004h>                 if matched_kw:
[?2004l[?2004h>                     rationale = f"Matched keywords: {', '.join(matched_kw[:4])}"
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     rationale = f"Pattern match: {best_entry.get('category_lv2', 'category')}"
[?2004l[?2004h>             
[?2004l[?2004h>             normalized.append({
[?2004l[?2004h>                 "segment_id": f"{record_id}-S{segment_id}",
[?2004l[?2004h>                 "span_text": span_text,
[?2004l[?2004h>                 "pred_code": pred_code,
[?2004l[?2004h>                 "pred_label": pred_label,
[?2004l[?2004h>                 "confidence": confidence,
[?2004l[?2004h>                 "rationale": rationale
[?2004l[?2004h>             })
[?2004l[?2004h>             segment_id += 1
[?2004l[?2004h>         
[?2004l[?2004h>         # If no segments, create one with original text
[?2004l[?2004h>         if not normalized:
[?2004l[?2004h>             raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else ""
[?2004l[?2004h>             normalized.append({
[?2004l[?2004h>                 "segment_id": f"{record_id}-S1",
[?2004l[?2004h>                 "span_text": raw_str,
[?2004l[?2004h>                 "pred_code": "UNKNOWN",
