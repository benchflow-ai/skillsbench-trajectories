[?2004hroot@ae0862dcd395:/app# cat > /app/normalize.py << 'ENDSCRIPT'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # Load codebooks
[?2004l[?2004h> def load_codebooks():
[?2004l[?2004h>     codebooks = {}
[?2004l[?2004h>     for product in ['P1_POWER', 'P2_CTRL', 'P3_RF']:
[?2004l[?2004h>         df = pd.read_csv(f'/app/data/codebook_{product}.csv')
[?2004l[?2004h>         codebooks[product] = df.to_dict('records')
[?2004l[?2004h>     return codebooks
[?2004l[?2004h> 
[?2004l[?2004h> # Parse keywords from codebook entry
[?2004l[?2004h> def parse_keywords(keywords_str):
[?2004l[?2004h>     if pd.isna(keywords_str):
[?2004l[?2004h>         return []
[?2004l[?2004h>     # Split by comma and clean
[?2004l[?2004h>     keywords = [k.strip().lower() for k in str(keywords_str).split(',')]
[?2004l[?2004h>     return keywords
[?2004l[?2004h> 
[?2004l[?2004h> # Segment the raw reason text into parts
[?2004l[?2004h> def segment_text(raw_text):
[?2004l[?2004h>     if pd.isna(raw_text) or not raw_text:
[?2004l[?2004h>         return [raw_text] if raw_text else ['']
[?2004l[?2004h>     
[?2004l[?2004h>     # Common delimiters in the raw text
[?2004l[?2004h>     # Split by various separators: /, ;, &, +, 、, multiple spaces, newlines
[?2004l[?2004h>     # But preserve the original span text
[?2004l[?2004h>     
[?2004l[?2004h>     # First normalize some patterns
[?2004l[?2004h>     text = str(raw_text)
[?2004l[?2004h>     
[?2004l[?2004h>     # Split by common delimiters
[?2004l[?2004h>     delimiters = r'[/;;&+、\n]+|\s+[/;;&+、]\s+'
[?2004l[?2004h>     
[?2004l[?2004h>     # Find segments - split on delimiters but keep meaningful chunks
[?2004l[?2004h>     segments = re.split(r'\s*[/;+&、]\s*|\s{2,}', text)
[?2004l[?2004h>     
[?2004l[?2004h>     # Clean segments
[?2004l[?2004h>     cleaned = []
[?2004l[?2004h>     for seg in segments:
[?2004l[?2004h>         seg = seg.strip()
[?2004l[?2004h>         if seg and len(seg) > 1:  # Skip very short segments
[?2004l[?2004h>             cleaned.append(seg)
[?2004l[?2004h>     
[?2004l[?2004h>     return cleaned if cleaned else [text]
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate match score between text and codebook entry
[?2004l[?2004h> def calculate_match_score(text, codebook_entry, station):
[?2004l[?2004h>     text_lower = text.lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # Get keywords
[?2004l[?2004h>     keywords = parse_keywords(codebook_entry.get('keywords_examples', ''))
[?2004l[?2004h>     standard_label = str(codebook_entry.get('standard_label', '')).lower()
[?2004l[?2004h>     
[?2004l[?2004h>     # Check station scope
[?2004l[?2004h>     station_scope = str(codebook_entry.get('station_scope', ''))
[?2004l[?2004h>     station_match = station in station_scope if station else True
[?2004l[?2004h>     
[?2004l[?2004h>     # Count keyword matches
[?2004l[?2004h>     keyword_matches = 0
[?2004l[?2004h>     total_keywords = len(keywords)
[?2004l[?2004h>     matched_keywords = []
[?2004l[?2004h>     
[?2004l[?2004h>     for kw in keywords:
[?2004l[?2004h>         if kw in text_lower:
[?2004l[?2004h>             keyword_matches += 1
[?2004l[?2004h>             matched_keywords.append(kw)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check label words
[?2004l[?2004h>     label_words = re.findall(r'\w+', standard_label)
[?2004l[?2004h>     label_matches = sum(1 for w in label_words if w in text_lower)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate score
[?2004l[?2004h>     if total_keywords == 0:
[?2004l[?2004h>         keyword_score = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         keyword_score = keyword_matches / total_keywords
[?2004l[?2004h>     
[?2004l[?2004h>     # Boost score if station matches
[?2004l[?2004h>     station_bonus = 0.1 if station_match else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Combined score
[?2004l[?2004h>     score = keyword_score * 0.7 + (label_matches / max(len(label_words), 1)) * 0.2 + station_bonus
[?2004l[?2004h>     
[?2004l[?2004h>     return score, matched_keywords
[?2004l[?2004h> 
[?2004l[?2004h> # Find best matching codebook entry
[?2004l[?2004h> def find_best_match(text, codebook, station):
[?2004l[?2004h>     best_score = 0
[?2004l[?2004h>     best_entry = None
[?2004l[?2004h>     best_keywords = []
[?2004l[?2004h>     
[?2004l[?2004h>     for entry in codebook:
[?2004l[?2004h>         score, matched_kw = calculate_match_score(text, entry, station)
[?2004l[?2004h>         if score > best_score:
[?2004l[?2004h>             best_score = score
[?2004l[?2004h>             best_entry = entry
[?2004l[?2004h>             best_keywords = matched_kw
[?2004l[?2004h>     
[?2004l[?2004h>     return best_entry, best_score, best_keywords
[?2004l[?2004h> 
[?2004l[?2004h> ENDSCRIPT
[?2004l[?2004hroot@ae0862dcd395:/app# cat >> /app/normalize.py << 'ENDSCRIPT'
[?2004l[?2004h> 
[?2004l[?2004h> # Main processing function
[?2004l[?2004h> def process_records():
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     codebooks = load_codebooks()
[?2004l[?2004h>     logs_df = pd.read_csv('/app/data/test_center_logs.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     records = []
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, row in logs_df.iterrows():
[?2004l[?2004h>         record_id = row['record_id']
[?2004l[?2004h>         product_id = row['product_id']
[?2004l[?2004h>         station = row['station']
[?2004l[?2004h>         engineer_id = row['engineer_id']
[?2004l[?2004h>         raw_reason_text = row['raw_reason_text']
[?2004l[?2004h>         
[?2004l[?2004h>         # Get appropriate codebook
[?2004l[?2004h>         codebook = codebooks.get(product_id, [])
[?2004l[?2004h>         
[?2004l[?2004h>         # Segment the raw text
[?2004l[?2004h>         segments = segment_text(raw_reason_text)
[?2004l[?2004h>         
[?2004l[?2004h>         normalized = []
[?2004l[?2004h>         segment_id = 1
[?2004l[?2004h>         
[?2004l[?2004h>         for span_text in segments:
[?2004l[?2004h>             if not span_text or len(span_text.strip()) < 2:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # Find best match
[?2004l[?2004h>             best_entry, score, matched_kw = find_best_match(span_text, codebook, station)
[?2004l[?2004h>             
[?2004l[?2004h>             # Determine confidence and whether to mark as UNKNOWN
[?2004l[?2004h>             if best_entry is None or score < 0.15:
[?2004l[?2004h>                 pred_code = "UNKNOWN"
[?2004l[?2004h>                 pred_label = ""
[?2004l[?2004h>                 confidence = round(score * 0.5, 3) if score > 0 else 0.05
