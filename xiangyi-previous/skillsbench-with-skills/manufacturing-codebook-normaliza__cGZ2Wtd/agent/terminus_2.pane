[?2004l[?2004h>     (r'[A-Z0-9_]+\s*OS[，,\s]*(像)?开路', 'open_circuit'),
[?2004l[?2004h>     (r'[A-Z0-9_]+\s*OS \(open\) seen', 'open_circuit'),
[?2004l[?2004h>     
[?2004l[?2004h>     # Short circuit
[?2004l[?2004h>     (r'[A-Z0-9_]+\s*(短路|short)[，,]?可能连锡[/\\]?桥连', 'short_bridge'),
[?2004l[?2004h>     (r'[A-Z0-9_]+\s*short[,\s]*suspect.*bridge', 'short_bridge'),
[?2004l[?2004h>     
[?2004l[?2004h>     # Current issues
[?2004l[?2004h>     (r'静态电流偏高[，,]?疑似短路趋势[/\\]?器件异常', 'current_high'),
[?2004l[?2004h>     (r'idle current high[,\s]*suspect partial short[/\\]?component issue', 'current_high'),
[?2004l[?2004h>     
[?2004l[?2004h>     # Programming/Flash issues
[?2004l[?2004h>     (r'烧录失败[/\\]?写入失败[，,]?重烧不稳定', 'flash_fail'),
[?2004l[?2004h>     (r'program[/\\]?flash write failed[,\s]*reflash unstable', 'flash_fail'),
[?2004l[?2004h>     (r'校验失败[/\\]?CRC挂[，,]?疑似程序包或数据异常', 'crc_fail'),
[?2004l[?2004h>     (r'版本不符[/\\]?下错程序', 'version_mismatch'),
[?2004l[?2004h>     
[?2004l[?2004h>     # Intermittent/unstable
[?2004l[?2004h>     (r'[A-Z0-9_]+\s*功能不稳[，,]?疑似虚焊[/\\]?浮高', 'intermittent_cold_solder'),
[?2004l[?2004h>     (r'[A-Z0-9_]+\s*intermittent[,\s]*suspect cold solder', 'intermittent_cold_solder'),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Segment text more intelligently
[?2004l[?2004h> def segment_text(raw_text):
[?2004l[?2004h>     if pd.isna(raw_text) or not raw_text:
[?2004l[?2004h>         return [str(raw_text)] if raw_text else ['']
[?2004l[?2004h>     
[?2004l[?2004h>     text = str(raw_text).strip()
[?2004l[?2004h>     
[?2004l[?2004h>     # Try to identify major segments first
[?2004l[?2004h>     # Split on clear delimiters but preserve meaningful chunks
[?2004l[?2004h>     # Common separators: /, ;, &, +, 、 when surrounded by spaces or at phrase boundaries
[?2004l[?2004h>     
[?2004l[?2004h>     # First, normalize some obvious separators
[?2004l[?2004h>     # Split on patterns like " / ", " ; ", " & ", " + "
[?2004l[?2004h>     segments = re.split(r'\s*[;；]\s*|\s+[&+]\s+|\s*/\s+|\s+/\s*|\s*、\s*(?=[^，。])', text)
[?2004l[?2004h>     
[?2004l[?2004h>     # Clean and filter segments
[?2004l[?2004h>     cleaned = []
[?2004l[?2004h>     for seg in segments:
[?2004l[?2004h>         seg = seg.strip()
[?2004l[?2004h>         # Remove trailing noise words
[?2004l[?2004h>         seg = re.sub(r'\s+(NG|OK了|已处理|有问题|浮高|不稳定|接触不好|重测过|重测|返修)$', '', seg)
[?2004l[?2004h>         if seg and len(seg) >= 3:
[?2004l[?2004h>             cleaned.append(seg)
[?2004l[?2004h>     
[?2004l[?2004h>     # If we only got one segment or none, return the original
[?2004l[?2004h>     if len(cleaned) <= 1:
[?2004l[?2004h>         return [text] if text else ['']
[?2004l[?2004h>     
[?2004l[?2004h>     return cleaned
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate match score
[?2004l[?2004h> def calculate_match_score(text, indexed_entry, station):
[?2004l[?2004h>     text_lower = text.lower()
[?2004l[?2004h>     
[?2004l[?2004h>     keywords = indexed_entry['keywords']
[?2004l[?2004h>     label_words = indexed_entry['label_words']
[?2004l[?2004h>     stations = indexed_entry['stations']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check station scope
[?2004l[?2004h>     station_match = station in stations if station else True
[?2004l[?2004h>     
[?2004l[?2004h>     # Count keyword matches
[?2004l[?2004h>     keyword_matches = 0
[?2004l[?2004h>     matched_keywords = []
[?2004l[?2004h>     
[?2004l[?2004h>     for kw in keywords:
[?2004l[?2004h>         if len(kw) >= 2 and kw in text_lower:
[?2004l[?2004h>             keyword_matches += 1
[?2004l[?2004h>             matched_keywords.append(kw)
[?2004l[?2004h>     
[?2004l[?2004h>     # Count label word matches
[?2004l[?2004h>     label_matches = 0
[?2004l[?2004h>     for w in label_words:
[?2004l[?2004h>         if len(w) >= 2 and w in text_lower:
[?2004l[?2004h>             label_matches += 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate score
[?2004l[?2004h>     total_keywords = len(keywords)
[?2004l[?2004h>     if total_keywords == 0:
[?2004l[?2004h>         keyword_score = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         keyword_score = keyword_matches / total_keywords
[?2004l[?2004h>     
[?2004l[?2004h>     label_score = label_matches / max(len(label_words), 1)
[?2004l[?2004h>     
[?2004l[?2004h>     # Station bonus
[?2004l[?2004h>     station_bonus = 0.15 if station_match else -0.05
[?2004l[?2004h>     
[?2004l[?2004h>     # Combined score with weights
[?2004l[?2004h>     score = keyword_score * 0.65 + label_score * 0.25 + station_bonus
[?2004l[?2004h>     
[?2004l[?2004h>     # Bonus for multiple keyword matches
[?2004l[?2004h>     if keyword_matches >= 3:
[?2004l[?2004h>         score += 0.1
[?2004l[?2004h>     elif keyword_matches >= 2:
[?2004l[?2004h>         score += 0.05
[?2004l[?2004h>     
[?2004l[?2004h>     return min(score, 1.0), matched_keywords
[?2004l[?2004h> 
[?2004l[?2004h> # Find best match
[?2004l[?2004h> def find_best_match(text, indexed_codebook, station):
[?2004l[?2004h>     best_score = 0
[?2004l[?2004h>     best_entry = None
[?2004l[?2004h>     best_keywords = []
[?2004l[?2004h>     
[?2004l[?2004h>     for indexed in indexed_codebook:
[?2004l[?2004h>         score, matched_kw = calculate_match_score(text, indexed, station)
[?2004l[?2004h>         if score > best_score:
[?2004l[?2004h>             best_score = score
[?2004l[?2004h>             best_entry = indexed['entry']
[?2004l[?2004h>             best_keywords = matched_kw
[?2004l[?2004h>     
[?2004l[?2004h>     return best_entry, best_score, best_keywords
[?2004l[?2004h> 
[?2004l[?2004h> ENDSCRIPT
[?2004l[?2004hroot@ae0862dcd395:/app# cat >> /app/normalize_v2.py << 'ENDSCRIPT'
[?2004l= "UNKNOWN"
                pred_label = ""
                confidence = calibrate_confidence(score, True)
                rationale = f"Low match score ({score:.2f}), no confident codebook match"
            else:
                pred_code = best_entry['code']
                pred_label = best_entry['standard_label']
                confidence = calibrate_confidence(score, False)
                if matched_kw:
                    rationale = f"Matched keywords: {', '.join(matched_kw[:4])}"
                else:
                    rationale = f"Pattern match: {best_entry.get('category_lv2', 'category')}"
            
            normalized.append({
                "segment_id": f"{record_id}-S{segment_id}",
                "span_text": span_text,
                "pred_code": pred_code,
                "pred_label": pred_label,
                "confidence": confidence,
                "rationale": rationale
            })
            segment_id += 1
        
        # If no segments, create one with original text
        if not normalized:
            raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else ""
            normalized.append({
                "segment_id": f"{record_id}-S1",
                "span_text": raw_str,
                "pred_code": "UNKNOWN",
                "pred_label": "",
                "confidence": 0.05,
                "rationale": "Unable to parse or match text"
            })
        
        records.append({
            "record_id": record_id,
            "product_id": product_id,
            "station": station,
            "engineer_id": engineer_id,
            "raw_reason_text": str(raw_reason_text) if pd.notna(raw_reason_text) else "",
            "normalized": normalized
        })
        
        if (idx + 1) % 2000 == 0:
            print(f"Processed {idx + 1} records...")
    
    return {"records": records}

