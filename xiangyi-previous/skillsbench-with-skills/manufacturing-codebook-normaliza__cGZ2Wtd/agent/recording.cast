[251.481792, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[251.481848, "o", "> "]
[251.481915, "o", "    return round(min(0.98, max(0.38, conf)), 3)\r\n\u001b[?2004l\r"]
[251.482003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.48207, "o", "# Main processing function\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.482145, "o", "> "]
[251.482224, "o", "def process_records():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.482279, "o", "    # Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.482356, "o", "    codebooks = load_codebooks()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.482468, "o", "    keyword_index = build_keyword_index(codebooks)\r\n\u001b[?2004l\r"]
[251.482528, "o", "\u001b[?2004h> "]
[251.482646, "o", "    logs_df = pd.read_csv('/app/data/test_center_logs.csv')\r\n\u001b[?2004l\r"]
[251.482678, "o", "\u001b[?2004h> "]
[251.482781, "o", "    \r\n\u001b[?2004l\r"]
[251.482813, "o", "\u001b[?2004h>     records = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.482848, "o", "    \r\n\u001b[?2004l\r"]
[251.482886, "o", "\u001b[?2004h> "]
[251.483004, "o", "    for idx, row in logs_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.483069, "o", "> "]
[251.483136, "o", "        record_id = row['record_id']\r\n\u001b[?2004l\r"]
[251.483201, "o", "\u001b[?2004h> "]
[251.483263, "o", "        product_id = row['product_id']\r\n\u001b[?2004l\r"]
[251.48333, "o", "\u001b[?2004h> "]
[251.48339, "o", "        station = row['station']\r\n\u001b[?2004l\r"]
[251.483452, "o", "\u001b[?2004h> "]
[251.483529, "o", "        engineer_id = row['engineer_id']\r\n\u001b[?2004l\r"]
[251.48361, "o", "\u001b[?2004h> "]
[251.48369, "o", "        raw_reason_text = row['raw_reason_text']\r\n\u001b[?2004l\r"]
[251.483763, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[251.483835, "o", "\u001b[?2004h> "]
[251.483903, "o", "        # Get appropriate codebook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484102, "o", "        indexed_codebook = keyword_index.get(product_id, [])\r\n\u001b[?2004l\r"]
[251.484304, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484419, "o", "        # Segment the raw text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484518, "o", "        segments = segment_text(raw_reason_text)\r\n\u001b[?2004l\r"]
[251.48461, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484698, "o", "        normalized = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484797, "o", "        segment_id = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484881, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.484965, "o", "        for span_text in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.485075, "o", "            span_text = span_text.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.485153, "o", "> "]
[251.485241, "o", "            if not span_text or len(span_text) < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.485329, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.485402, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.48548, "o", "            # Find best match\r\n\u001b[?2004l\r"]
[251.48555, "o", "\u001b[?2004h> "]
[251.485744, "o", "            best_entry, score, matched_kw = find_best_match(span_text, indexed_codebook, station)\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.485826, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[251.485899, "o", "> "]
[251.485985, "o", "            # Threshold for unknown\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.48607, "o", "            unknown_threshold = 0.18\r\n\u001b[?2004l\r"]
[251.486154, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.486316, "o", "            if best_entry is None or score < unknown_threshold:\r\n\u001b[?2004l\r"]
[251.486396, "o", "\u001b[?2004h> "]
[251.486469, "o", "                pred_code = \"UNKNOWN\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.486749, "o", "                pred_label = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>                 confidence = calibrate_confidence(score, True)\r\n"]
[251.48686, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[251.486993, "o", "                rationale = f\"Low match score ({score:.2f}), no confident codebook match\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.487072, "o", ">             else:\r\n\u001b[?2004l\r"]
[251.487143, "o", "\u001b[?2004h> "]
[251.487211, "o", "                pred_code = best_entry['code']\r\n\u001b[?2004l\r"]
[251.487289, "o", "\u001b[?2004h> "]
[251.487382, "o", "                pred_label = best_entry['standard_label']\r\n\u001b[?2004l\r"]
[251.487459, "o", "\u001b[?2004h> "]
[251.48756, "o", "                confidence = calibrate_confidence(score, False)\r\n\u001b[?2004l\r"]
[251.487624, "o", "\u001b[?2004h> "]
[251.487697, "o", "                if matched_kw:\r\n\u001b[?2004l\r"]
[251.487772, "o", "\u001b[?2004h> "]
[251.487892, "o", "                    rationale = f\"Matched keywords: {', '.join(matched_kw[:4])}\"\r\n\u001b[?2004l\r"]
[251.487958, "o", "\u001b[?2004h> "]
[251.488032, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.48824, "o", "                    rationale = f\"Pattern match: {best_entry.get('category_lv2', 'category')}\"\r\n\u001b[?2004l\r"]
[251.488318, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[251.488408, "o", "\u001b[?2004h> "]
[251.488493, "o", "            normalized.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.488591, "o", "                \"segment_id\": f\"{record_id}-S{segment_id}\",\r\n\u001b[?2004l\r"]
[251.488674, "o", "\u001b[?2004h> "]
[251.488744, "o", "                \"span_text\": span_text,\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.48881, "o", "> "]
[251.488879, "o", "                \"pred_code\": pred_code,\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.488946, "o", "> "]
[251.489014, "o", "                \"pred_label\": pred_label,\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.489083, "o", "> "]
[251.489139, "o", "                \"confidence\": confidence,\r\n\u001b[?2004l\r"]
[251.489204, "o", "\u001b[?2004h> "]
[251.48928, "o", "                \"rationale\": rationale\r\n\u001b[?2004l\r"]
[251.489362, "o", "\u001b[?2004h> "]
[251.48943, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.489503, "o", ">             segment_id += 1\r\n\u001b[?2004l\r"]
[251.48957, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.489846, "o", "        # If no segments, create one with original text\r\n\u001b[?2004l\r\u001b[?2004h>         if not normalized:\r\n\u001b[?2004l\r"]
[251.490041, "o", "\u001b[?2004h>             raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else \"\"\r\n\u001b[?2004l\r"]
[251.490215, "o", "\u001b[?2004h>             normalized.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.490365, "o", "                \"segment_id\": f\"{record_id}-S1\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"span_text\": raw_str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.490471, "o", "                \"pred_code\": \"UNKNOWN\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.490614, "o", "                \"pred_label\": \"\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"confidence\": 0.05,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.490846, "o", "                \"rationale\": \"Unable to parse or match text\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.490873, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.491047, "o", "        records.append({\r\n\u001b[?2004l\r"]
[251.491093, "o", "\u001b[?2004h>             \"record_id\": record_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.491155, "o", "            \"product_id\": product_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.491203, "o", "            \"station\": station,\r\n\u001b[?2004l\r"]
[251.491233, "o", "\u001b[?2004h> "]
[251.491387, "o", "            \"engineer_id\": engineer_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.491545, "o", "            \"raw_reason_text\": str(raw_reason_text) if pd.notna(raw_reason_text) else \"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.491596, "o", "            \"normalized\": normalized\r\n\u001b[?2004l\r"]
[251.491667, "o", "\u001b[?2004h>         })"]
[251.491744, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[251.491863, "o", ">         if (idx + 1) % 2000 == 0:\r\n"]
[251.491891, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[251.491916, "o", "            print(f\"Processed {idx + 1} records...\")\r\n\u001b[?2004l\r"]
[251.491959, "o", "\u001b[?2004h> "]
[251.492011, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.492104, "o", "    return {\"records\": records}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[251.492131, "o", "> "]
[251.492246, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.49233, "o", "    print(\"Starting normalization v2...\")\r\n\u001b[?2004l\r"]
[251.492396, "o", "\u001b[?2004h> "]
[251.492442, "o", "    result = process_records()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[251.492525, "o", "\u001b[?2004h> "]
[251.492552, "o", "    # Save output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.492692, "o", "    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.492792, "o", "        json.dump(result, f, ensure_ascii=False, indent=2)\r\n\u001b[?2004l\r"]
[251.492846, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[251.492874, "o", "\u001b[?2004h> "]
[251.492974, "o", "    print(f\"Done! Processed {len(result['records'])} records.\")\r\n\u001b[?2004l\r"]
[251.493037, "o", "\u001b[?2004h> "]
[251.493059, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.493154, "o", "    # Quick stats\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.493244, "o", "    total_segs = sum(len(r['normalized']) for r in result['records'])\r\n\u001b[?2004l\r"]
[251.493312, "o", "\u001b[?2004h> "]
[251.493493, "o", "    unknown_segs = sum(1 for r in result['records'] for s in r['normalized'] if s['pred_code'] == 'UNKNOWN')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.493576, "o", "    print(f\"Total segments: {total_segs}\")\r\n\u001b[?2004l\r"]
[251.493643, "o", "\u001b[?2004h> "]
[251.493773, "o", "    print(f\"Unknown segments: {unknown_segs} ({100*unknown_segs/total_segs:.1f}%)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.493834, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
[251.497945, "o", "\u001b[?2004hroot@ae0862dcd395:/app# "]
[257.172071, "i", "python3 /app/normalize_v2.py\n"]
[257.172525, "o", "python3 /app/normalize_v2.py\r\n\u001b[?2004l\r"]
[257.833966, "o", "Starting normalization v2...\r\n"]
[258.503265, "o", "Processed 2000 records...\r\n"]
[259.062352, "o", "Processed 4000 records...\r\n"]
[259.646701, "o", "Processed 6000 records...\r\n"]
[260.240611, "o", "Processed 8000 records...\r\n"]
[260.968448, "o", "Processed 10000 records...\r\n"]
[261.593625, "o", "Processed 12000 records...\r\n"]
[262.286717, "o", "Done! Processed 12000 records.\r\n"]
[262.29292, "o", "Total segments: 20061\r\nUnknown segments: 480 (2.4%)\r\n"]
[262.481403, "o", "\u001b[?2004h"]
[262.481625, "o", "root@ae0862dcd395:/app# "]
[326.834488, "i", "python3 -c \"\nimport json\nwith open('/app/output/solution.json') as f:\n    data = json.load(f)\n\nconfidences = []\nunknown_conf = []\nknown_conf = []\n\nfor rec in data['records']:\n    for seg in rec['normalized']:\n        conf = seg['confidence']\n        confidences.append(conf)\n        if seg['pred_code'] == 'UNKNOWN':\n            unknown_conf.append(conf)\n        else:\n            known_conf.append(conf)\n\nconfidences.sort()\nknown_conf.sort()\nn = len(confidences)\nnk = len(known_conf)\n\nprint('=== Overall Confidence Stats ===')\nprint(f'Total segments: {n}')\nprint(f'Min: {min(confidences)}')\nprint(f'Max: {max(confidences)}')\nprint(f'Mean: {sum(confidences)/n:.3f}')\nprint(f'Q25: {confidences[n//4]}')\nprint(f'Q50: {confidences[n//2]}')\nprint(f'Q75: {confidences[3*n//4]}')\n\nprint('\\n=== Known Predictions ===')\nprint(f'Count: {nk}')\nprint(f'Min: {min(known_conf)}')\nprint(f'Max: {max(known_conf)}')\nprint(f'Mean: {sum(known_conf)/nk:.3f}')\nprint(f'Q25: {known_conf[nk//4]}')\nprint(f'Q50: {known_conf[nk//2]}')\nprint(f'Q75: {known_conf[3*nk//4]}')\n\nif unknown_conf:\n    print('\\n=== Unknown Predictions ===')\n    print(f'Count: {len(unknown_conf)}')\n    print(f'Min: {min(unknown_conf)}')\n    print(f'Max: {max(unknown_conf)}')\n    print(f'Mean: {sum(unknown_conf)/len(unknown_conf):.3f}')\n\"\n"]
[326.846812, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n"]
[326.85784, "o", "\u001b[?2004l\r\u001b[?2004h> with open('/app/output/solution.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> confidences = []\r\n\u001b[?2004l\r\u001b[?2004h> unknown_conf = []\r\n\u001b[?2004l\r\u001b[?2004h> known_conf = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for rec in data['records']:\r\n\u001b[?2004l\r\u001b[?2004h>     for seg in rec['normalized']:\r\n\u001b[?2004l\r\u001b[?2004h>         conf = seg['confidence']\r\n\u001b[?2004l\r\u001b[?2004h>         confidences.append(conf)\r\n\u001b[?2004l\r\u001b[?2004h>         if seg['pred_code'] == 'UNKNOWN':\r\n\u001b[?2004l\r\u001b[?2004h>             unknown_conf.append(conf)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             known_conf.append(conf)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> confidences.sort()\r\n\u001b[?2004l\r\u001b[?2004h> known_conf.sort()\r\n\u001b[?2004l\r\u001b[?2004h> n = len(confidences)\r\n\u001b[?2004l\r\u001b[?2004h> nk = len(known_conf)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('=== Overall Confidence Stats ===')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Total segments: {n}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Min: {min(confidences)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Max: {max(confidences)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Mean: {sum(confidences)/n:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q25: {confidences[n//4]}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q50: {confidences[n//2]}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q75: {confidences[3*n//4]}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('\\n=== Known Predictions ===')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Count: {nk}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Min: {min(known_conf)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Max: {max(known_conf)}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Mean: {sum(known_conf)/nk:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q25: {known_conf[nk//4]}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q50: {known_conf[nk//2]}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Q75: {known_conf[3*nk//4]}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if unknown_conf:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n=== Unknown Predictions ===')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Count: {len(unknown_conf)}')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Min: {min(unknown_conf)}')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Max: {max(unknown_conf)}')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Mean: {sum(unknown_conf)/len(unknown_conf):.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
