[353.415345, "i", "python3 -c \"\nimport json\nwith open('/app/output/solution.json') as f:\n    data = json.load(f)\n\n# Find some UNKNOWN predictions\nprint('=== Sample UNKNOWN predictions ===')\ncount = 0\nfor rec in data['records']:\n    for seg in rec['normalized']:\n        if seg['pred_code'] == 'UNKNOWN' and count < 5:\n            print(f\\\"Record: {rec['record_id']}, Product: {rec['product_id']}\\\")\n            print(f\\\"  Raw: {rec['raw_reason_text'][:80]}...\\\")\n            print(f\\\"  Span: {seg['span_text']}\\\")\n            print(f\\\"  Confidence: {seg['confidence']}\\\")\n            print()\n            count += 1\n\nprint('\\n=== Verify JSON structure ===')\nprint(f\\\"Total records: {len(data['records'])}\\\")\nprint(f\\\"First record keys: {list(data['records'][0].keys())}\\\")\nprint(f\\\"First normalized keys: {list(data['records'][0]['normalized'][0].keys())}\\\")\n\"\n"]
