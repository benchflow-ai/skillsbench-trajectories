[227.787514, "o", "    (r'校验失败[/\\\\]?CRC挂[，,]?疑似程序包或数据异常', 'crc_fail'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.787685, "o", "    (r'版本不符[/\\\\]?下错程序', 'version_mismatch'),\r\n\u001b[?2004l\r"]
[227.787722, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[227.787754, "o", "\u001b[?2004h> "]
[227.787878, "o", "    # Intermittent/unstable\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.788083, "o", "    (r'[A-Z0-9_]+\\s*功能不稳[，,]?疑似虚焊[/\\\\]?浮高', 'intermittent_cold_solder'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.788134, "o", "> "]
[227.788326, "o", "    (r'[A-Z0-9_]+\\s*intermittent[,\\s]*suspect cold solder', 'intermittent_cold_solder'),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[227.788367, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.788399, "o", "> "]
[227.788508, "o", "# Segment text more intelligently\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.788682, "o", "def segment_text(raw_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.788722, "o", "    if pd.isna(raw_text) or not raw_text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.788876, "o", "        return [str(raw_text)] if raw_text else ['']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.78892, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.789024, "o", "    text = str(raw_text).strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.789068, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.7891, "o", "> "]
[227.78921, "o", "    # Try to identify major segments first\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.789459, "o", "    # Split on clear delimiters but preserve meaningful chunks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.789611, "o", "    # Common separators: /, ;, &, +, 、 when surrounded by spaces or at phrase boundaries\r\n\u001b[?2004l\r"]
[227.789653, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[227.789684, "o", "\u001b[?2004h> "]
[227.789811, "o", "    # First, normalize some obvious separators\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.789848, "o", "> "]
[227.790076, "o", "    # Split on patterns like \" / \", \" ; \", \" & \", \" + \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.790265, "o", "    segments = re.split(r'\\s*[;；]\\s*|\\s+[&+]\\s+|\\s*/\\s+|\\s+/\\s*|\\s*、\\s*(?=[^，。])', text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.790308, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.790478, "o", "    # Clean and filter segments\r\n\u001b[?2004l\r\u001b[?2004h>     cleaned = []\r\n\u001b[?2004l\r"]
[227.790545, "o", "\u001b[?2004h>     for seg in segments:\r\n\u001b[?2004l\r"]
[227.79058, "o", "\u001b[?2004h> "]
[227.790809, "o", "        seg = seg.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.790899, "o", ">         # Remove trailing noise words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.791038, "o", "        seg = re.sub(r'\\s+(NG|OK了|已处理|有问题|浮高|不稳定|接触不好|重测过|重测|返修)$', '', seg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.791174, "o", "        if seg and len(seg) >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.791263, "o", "            cleaned.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.791304, "o", "    # If we only got one segment or none, return the original\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.791395, "o", "    if len(cleaned) <= 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792128, "o", "        return [text] if text else ['']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return cleaned\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate match score\r\n\u001b[?2004l\r\u001b[?2004h> def calculate_match_score(text, indexed_entry, station):\r\n\u001b[?2004l\r\u001b[?2004h>     text_lower = text.lower()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     keywords = indexed_entry['keywords']\r\n\u001b[?2004l\r\u001b[?2004h>     label_words = indexed_entry['label_words']\r\n\u001b[?2004l\r\u001b[?2004h>     stations = indexed_entry['stations']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792269, "o", "    # Check station scope\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792381, "o", "    station_match = station in stations if station else True\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Count keyword matches\r\n\u001b[?2004l\r"]
[227.792495, "o", "\u001b[?2004h>     keyword_matches = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792594, "o", "    matched_keywords = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for kw in keywords:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792684, "o", "        if len(kw) >= 2 and kw in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792778, "o", "            keyword_matches += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792868, "o", "            matched_keywords.append(kw)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.792974, "o", "    # Count label word matches\r\n\u001b[?2004l\r\u001b[?2004h>     label_matches = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.79306, "o", "    for w in label_words:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.793169, "o", "        if len(w) >= 2 and w in text_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.793259, "o", "            label_matches += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Calculate score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.793296, "o", "    total_keywords = len(keywords)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.793407, "o", "    if total_keywords == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         keyword_score = 0\r\n\u001b[?2004l\r"]
[227.793449, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.793565, "o", "        keyword_score = keyword_matches / total_keywords"]
[227.79361, "o", "\r\n"]
[227.793646, "o", "\u001b[?2004l\r"]
[227.793799, "o", "\u001b[?2004h"]
[227.793851, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     label_score = label_matches / max(len(label_words), 1)\r\n\u001b[?2004l\r"]
[227.793889, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.793925, "o", "> "]
[227.793959, "o", "    # Station bonus\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.793997, "o", "> "]
[227.794171, "o", "    station_bonus = 0.15 if station_match else -0.05\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Combined score with weights\r\n\u001b[?2004l\r"]
[227.79421, "o", "\u001b[?2004h> "]
[227.794319, "o", "    score = keyword_score * 0.65 + label_score * 0.25 + station_bonus\r\n\u001b[?2004l\r"]
[227.79436, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.794492, "o", "> "]
[227.794588, "o", "    # Bonus for multiple keyword matches\r\n\u001b[?2004l\r\u001b[?2004h>     if keyword_matches >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.794688, "o", "        score += 0.1\r\n\u001b[?2004l\r\u001b[?2004h>     elif keyword_matches >= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.794726, "o", "        score += 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.794753, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.794784, "o", "> "]
[227.794917, "o", "    return min(score, 1.0), matched_keywords\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Find best match\r\n"]
[227.794955, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[227.795038, "o", "def find_best_match(text, indexed_codebook, station):\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.795069, "o", ">     best_score = 0\r\n\u001b[?2004l\r"]
[227.795098, "o", "\u001b[?2004h> "]
[227.795198, "o", "    best_entry = None\r\n\u001b[?2004l\r\u001b[?2004h>     best_keywords = []\r\n"]
[227.795228, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[227.795266, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[227.795368, "o", "    for indexed in indexed_codebook:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.795567, "o", "        score, matched_kw = calculate_match_score(text, indexed, station)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.795607, "o", "        if score > best_score:\r\n\u001b[?2004l\r"]
[227.795639, "o", "\u001b[?2004h> "]
[227.795751, "o", "            best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.795816, "o", "            best_entry = indexed['entry']\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.795849, "o", "> "]
[227.795925, "o", "            best_keywords = matched_kw\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[227.795961, "o", "\u001b[?2004h> "]
[227.79607, "o", "    return best_entry, best_score, best_keywords\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.796108, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.796139, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
[227.79894, "o", "\u001b[?2004hroot@ae0862dcd395:/app# "]
[251.471872, "i", "cat >> /app/normalize_v2.py << 'ENDSCRIPT'\n\n# Convert score to calibrated confidence\ndef calibrate_confidence(score, is_unknown):\n    if is_unknown:\n        # Unknown predictions should have low confidence\n        return round(max(0.05, min(0.35, score * 0.5)), 3)\n    \n    # Calibrated confidence for known predictions\n    # Score range: 0.15 to 1.0 -> Confidence range: 0.4 to 0.98\n    if score >= 0.7:\n        conf = 0.90 + (score - 0.7) * 0.27  # 0.90 to 0.98\n    elif score >= 0.5:\n        conf = 0.75 + (score - 0.5) * 0.75  # 0.75 to 0.90\n    elif score >= 0.35:\n        conf = 0.55 + (score - 0.35) * 1.33  # 0.55 to 0.75\n    elif score >= 0.2:\n        conf = 0.40 + (score - 0.2) * 1.0  # 0.40 to 0.55\n    else:\n        conf = 0.35 + score * 0.25  # Below threshold\n    \n    return round(min(0.98, max(0.38, conf)), 3)\n\n# Main processing function\ndef process_records():\n    # Load data\n    codebooks = load_codebooks()\n    keyword_index = build_keyword_index(codebooks)\n    logs_df = pd.read_csv('/app/data/test_center_logs.csv')\n    \n    records = []\n    \n    for idx, row in logs_df.iterrows():\n        record_id = row['record_id']\n        product_id = row['product_id']\n        station = row['station']\n        engineer_id = row['engineer_id']\n        raw_reason_text = row['raw_reason_text']\n        \n        # Get appropriate codebook\n        indexed_codebook = keyword_index.get(product_id, [])\n        \n        # Segment the raw text\n        segments = segment_text(raw_reason_text)\n        \n        normalized = []\n        segment_id = 1\n        \n        for span_text in segments:\n            span_text = span_text.strip()\n            if not span_text or len(span_text) < 2:\n                continue\n            \n            # Find best match\n            best_entry, score, matched_kw = find_best_match(span_text, indexed_codebook, station)\n            \n            # Threshold for unknown\n            unknown_threshold = 0.18\n            \n            if best_entry is None or score < unknown_threshold:\n                pred_code = \"UNKNOWN\"\n                pred_label = \"\"\n                confidence = calibrate_confidence(score, True)\n                rationale = f\"Low match score ({score:.2f}), no confident codebook match\"\n            else:\n                pred_code = best_entry['code']\n                pred_label = best_entry['standard_label']\n                confidence = calibrate_confidence(score, False)\n                if matched_kw:\n                    rationale = f\"Matched keywords: {', '.join(matched_kw[:4])}\"\n                else:\n                    rationale = f\"Pattern match: {best_entry.get('category_lv2', 'category')}\"\n            \n            normalized.append({\n                \"segment_id\": f\"{record_id}-S{segment_id}\",\n                \"span_text\": span_text,\n                \"pred_code\": pred_code,\n                \"pred_label\": pred_label,\n                \"confidence\": confidence,\n                \"rationale\": rationale\n            })\n            segment_id += 1\n        \n        # If no segments, create one with original text\n        if not normalized:\n            raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else \"\"\n            normalized.append({\n                \"segment_id\": f\"{record_id}-S1\",\n                \"span_text\": raw_str,\n                \"pred_code\": \"UNKNOWN\",\n                \"pred_label\": \"\",\n                \"confidence\": 0.05,\n                \"rationale\": \"Unable to parse or match text\"\n            })\n        \n        records.append({\n            \"record_id\": record_id,\n            \"product_id\": product_id,\n            \"station\": station,\n            \"engineer_id\": engineer_id,\n            \"raw_reason_text\": str(raw_reason_text) if pd.notna(raw_reason_text) else \"\",\n            \"normalized\": normalized\n        })\n        \n        if (idx + 1) % 2000 == 0:\n            print(f\"Processed {idx + 1} records...\")\n    \n    return {\"records\": records}\n\nif __name__ == \"__main__\":\n    print(\"Starting normalization v2...\")\n    result = process_records()\n    \n    # Save output\n    with open('/app/output/solu"]
[251.47194, "i", "tion.json', 'w', encoding='utf-8') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    \n    print(f\"Done! Processed {len(result['records'])} records.\")\n    \n    # Quick stats\n    total_segs = sum(len(r['normalized']) for r in result['records'])\n    unknown_segs = sum(1 for r in result['records'] for s in r['normalized'] if s['pred_code'] == 'UNKNOWN')\n    print(f\"Total segments: {total_segs}\")\n    print(f\"Unknown segments: {unknown_segs} ({100*unknown_segs/total_segs:.1f}%)\")\nENDSCRIPT\n"]
[251.472393, "o", "cat >> /app/normalize_v2.py << 'ENDSCRIPT'\r\n\u001b[?2004l\r= \"UNKNOWN\"\r\n                pred_label = \"\"\r\n                confidence = calibrate_confidence(score, True)\r\n                rationale = f\"Low match score ({score:.2f}), no confident codebook match\"\r\n            else:\r\n                pred_code = best_entry['code']\r\n                pred_label = best_entry['standard_label']\r\n                confidence = calibrate_confidence(score, False)\r\n                if matched_kw:\r\n                    rationale = f\"Matched keywords: {', '.join(matched_kw[:4])}\"\r\n                else:\r\n                    rationale = f\"Pattern match: {best_entry.get('category_lv2', 'category')}\"\r\n            \r\n            normalized.append({\r\n                \"segment_id\": f\"{record_id}-S{segment_id}\",\r\n                \"span_text\": span_text,\r\n                \"pred_code\": pred_code,\r\n                \"pred_label\": pred_label,\r\n                \"confidence\": confidence,\r\n                \"rationale\": rationale\r\n            })\r\n            segment_id += 1\r\n        \r\n        # If no segments, create one with original text\r\n        if not normalized:\r\n            raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else \"\"\r\n            normalized.append({\r\n                \"segment_id\": f\"{record_id}-S1\",\r\n                \"span_text\": raw_str,\r\n                \"pred_code\": \"UNKNOWN\",\r\n                \"pred_label\": \"\",\r\n                \"confidence\": 0.05,\r\n                \"rationale\": \"Unable to parse or match text\"\r\n            })\r\n        \r\n        records.append({\r\n            \"record_id\": record_id,\r\n            \"product_id\": product_id,\r\n            \"station\": station,\r\n            \"engineer_id\": engineer_id,\r\n            \"raw_reason_text\": str(raw_reason_text) if pd.notna(raw_reason_text) else \"\",\r\n            \"normalized\": normalized\r\n        })\r\n        \r\n        if (idx + 1) % 2000 == 0:\r\n            print(f\"Processed {idx + 1} records...\")\r\n    \r\n    return {\"records\": records}\r\n\r\nif __name__ == \"__main__\":\r\n    print(\"Starting normalization v2...\")\r\n    result = process_records()\r\n    \r\n    # Save output\r\n    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\r\n  "]
