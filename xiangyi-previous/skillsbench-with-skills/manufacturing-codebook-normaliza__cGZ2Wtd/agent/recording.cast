[175.084819, "i", "python3 -c \"\nimport json\nwith open('/app/output/solution.json') as f:\n    data = json.load(f)\n\n# Check confidence distribution\nconfidences = []\nunknown_count = 0\ntotal_segments = 0\n\nfor rec in data['records']:\n    for seg in rec['normalized']:\n        total_segments += 1\n        confidences.append(seg['confidence'])\n        if seg['pred_code'] == 'UNKNOWN':\n            unknown_count += 1\n\nconfidences.sort()\nn = len(confidences)\nprint(f'Total segments: {total_segments}')\nprint(f'Unknown count: {unknown_count} ({100*unknown_count/total_segments:.1f}%)')\nprint(f'Min confidence: {min(confidences)}')\nprint(f'Max confidence: {max(confidences)}')\nprint(f'Mean confidence: {sum(confidences)/n:.3f}')\nprint(f'Q25: {confidences[n//4]}')\nprint(f'Q50 (median): {confidences[n//2]}')\nprint(f'Q75: {confidences[3*n//4]}')\n\"\n"]
