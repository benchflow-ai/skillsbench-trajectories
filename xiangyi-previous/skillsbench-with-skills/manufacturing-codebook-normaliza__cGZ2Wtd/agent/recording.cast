[326.992661, "o", "Mean: 0.667\r\nQ25: 0.53\r\nQ50: 0.696\r\nQ75: 0.769\r\n\r\n=== Known Predictions ===\r\nCount: 19581\r\n"]
[326.992931, "o", "Min: 0.396\r\n"]
