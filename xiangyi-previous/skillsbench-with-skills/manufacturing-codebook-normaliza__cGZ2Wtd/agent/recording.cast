[66.147025, "o", "\u001b[?2004hroot@ae0862dcd395:/app# "]
[86.649959, "i", "cat >> /app/normalize.py << 'ENDSCRIPT'\n\n# Main processing function\ndef process_records():\n    # Load data\n    codebooks = load_codebooks()\n    logs_df = pd.read_csv('/app/data/test_center_logs.csv')\n    \n    records = []\n    \n    for idx, row in logs_df.iterrows():\n        record_id = row['record_id']\n        product_id = row['product_id']\n        station = row['station']\n        engineer_id = row['engineer_id']\n        raw_reason_text = row['raw_reason_text']\n        \n        # Get appropriate codebook\n        codebook = codebooks.get(product_id, [])\n        \n        # Segment the raw text\n        segments = segment_text(raw_reason_text)\n        \n        normalized = []\n        segment_id = 1\n        \n        for span_text in segments:\n            if not span_text or len(span_text.strip()) < 2:\n                continue\n                \n            # Find best match\n            best_entry, score, matched_kw = find_best_match(span_text, codebook, station)\n            \n            # Determine confidence and whether to mark as UNKNOWN\n            if best_entry is None or score < 0.15:\n                pred_code = \"UNKNOWN\"\n                pred_label = \"\"\n                confidence = round(score * 0.5, 3) if score > 0 else 0.05\n                rationale = \"No matching codebook entry found\"\n            else:\n                pred_code = best_entry['code']\n                pred_label = best_entry['standard_label']\n                # Scale confidence based on score\n                if score >= 0.6:\n                    confidence = round(0.85 + score * 0.15, 3)\n                elif score >= 0.4:\n                    confidence = round(0.65 + score * 0.25, 3)\n                elif score >= 0.25:\n                    confidence = round(0.45 + score * 0.4, 3)\n                else:\n                    confidence = round(0.25 + score * 0.5, 3)\n                \n                confidence = min(confidence, 0.98)\n                rationale = f\"Matched keywords: {', '.join(matched_kw[:5])}\" if matched_kw else f\"Pattern match with {best_entry.get('category_lv2', '')}\"\n            \n            normalized.append({\n                \"segment_id\": f\"{record_id}-S{segment_id}\",\n                \"span_text\": span_text.strip(),\n                \"pred_code\": pred_code,\n                \"pred_label\": pred_label,\n                \"confidence\": confidence,\n                \"rationale\": rationale\n            })\n            segment_id += 1\n        \n        # If no segments were processed, add one with the full text\n        if not normalized:\n            normalized.append({\n                \"segment_id\": f\"{record_id}-S1\",\n                \"span_text\": str(raw_reason_text) if pd.notna(raw_reason_text) else \"\",\n                \"pred_code\": \"UNKNOWN\",\n                \"pred_label\": \"\",\n                \"confidence\": 0.05,\n                \"rationale\": \"Unable to parse or match text\"\n            })\n        \n        records.append({\n            \"record_id\": record_id,\n            \"product_id\": product_id,\n            \"station\": station,\n            \"engineer_id\": engineer_id,\n            \"raw_reason_text\": str(raw_reason_text) if pd.notna(raw_reason_text) else \"\",\n            \"normalized\": normalized\n        })\n        \n        if (idx + 1) % 1000 == 0:\n            print(f\"Processed {idx + 1} records...\")\n    \n    return {\"records\": records}\n\nif __name__ == \"__main__\":\n    print(\"Starting normalization...\")\n    result = process_records()\n    \n    # Save output\n    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    \n    print(f\"Done! Processed {len(result['records'])} records.\")\n    print(f\"Output saved to /app/output/solution.json\")\nENDSCRIPT\n"]
