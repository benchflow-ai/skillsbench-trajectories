[227.77477, "i", "cat > /app/normalize_v2.py << 'ENDSCRIPT'\nimport pandas as pd\nimport json\nimport re\nfrom collections import defaultdict\n\n# Load codebooks\ndef load_codebooks():\n    codebooks = {}\n    for product in ['P1_POWER', 'P2_CTRL', 'P3_RF']:\n        df = pd.read_csv(f'/app/data/codebook_{product}.csv')\n        codebooks[product] = df.to_dict('records')\n    return codebooks\n\n# Build keyword index for faster matching\ndef build_keyword_index(codebooks):\n    index = {}\n    for product, entries in codebooks.items():\n        index[product] = []\n        for entry in entries:\n            keywords_str = entry.get('keywords_examples', '')\n            if pd.isna(keywords_str):\n                keywords = []\n            else:\n                keywords = [k.strip().lower() for k in str(keywords_str).split(',')]\n            \n            # Also extract words from standard_label\n            label = str(entry.get('standard_label', '')).lower()\n            label_words = re.findall(r'[a-z]+|[\\u4e00-\\u9fff]+', label)\n            \n            index[product].append({\n                'entry': entry,\n                'keywords': keywords,\n                'label_words': label_words,\n                'category': entry.get('category_lv2', ''),\n                'stations': str(entry.get('station_scope', '')).split(';')\n            })\n    return index\n\n# Common defect patterns for better segmentation\nDEFECT_PATTERNS = [\n    # Fixture/probe issues\n    (r'治具[/\\\\]?探针接触不良[，,]?重插后偶尔OK', 'fixture_contact'),\n    (r'fixture contact unstable[,\\s]*reseat sometimes passes', 'fixture_contact'),\n    (r'探针磨损导致接触差[，,]?建议换针', 'probe_worn'),\n    (r'probe worn causing bad contact[,\\s]*replace pin', 'probe_worn'),\n    \n    # Open circuit\n    (r'[A-Z0-9_]+\\s*(开路|open)[，,]?疑似虚焊[/\\\\]?少锡', 'open_cold_solder'),\n    (r'[A-Z0-9_]+\\s*open[,\\s]*suspect cold solder[/\\\\]?missing solder', 'open_cold_solder'),\n    (r'[A-Z0-9_]+\\s*OS[，,\\s]*(像)?开路', 'open_circuit'),\n    (r'[A-Z0-9_]+\\s*OS \\(open\\) seen', 'open_circuit'),\n    \n    # Short circuit\n    (r'[A-Z0-9_]+\\s*(短路|short)[，,]?可能连锡[/\\\\]?桥连', 'short_bridge'),\n    (r'[A-Z0-9_]+\\s*short[,\\s]*suspect.*bridge', 'short_bridge'),\n    \n    # Current issues\n    (r'静态电流偏高[，,]?疑似短路趋势[/\\\\]?器件异常', 'current_high'),\n    (r'idle current high[,\\s]*suspect partial short[/\\\\]?component issue', 'current_high'),\n    \n    # Programming/Flash issues\n    (r'烧录失败[/\\\\]?写入失败[，,]?重烧不稳定', 'flash_fail'),\n    (r'program[/\\\\]?flash write failed[,\\s]*reflash unstable', 'flash_fail'),\n    (r'校验失败[/\\\\]?CRC挂[，,]?疑似程序包或数据异常', 'crc_fail'),\n    (r'版本不符[/\\\\]?下错程序', 'version_mismatch'),\n    \n    # Intermittent/unstable\n    (r'[A-Z0-9_]+\\s*功能不稳[，,]?疑似虚焊[/\\\\]?浮高', 'intermittent_cold_solder'),\n    (r'[A-Z0-9_]+\\s*intermittent[,\\s]*suspect cold solder', 'intermittent_cold_solder'),\n]\n\n# Segment text more intelligently\ndef segment_text(raw_text):\n    if pd.isna(raw_text) or not raw_text:\n        return [str(raw_text)] if raw_text else ['']\n    \n    text = str(raw_text).strip()\n    \n    # Try to identify major segments first\n    # Split on clear delimiters but preserve meaningful chunks\n    # Common separators: /, ;, &, +, 、 when surrounded by spaces or at phrase boundaries\n    \n    # First, normalize some obvious separators\n    # Split on patterns like \" / \", \" ; \", \" & \", \" + \"\n    segments = re.split(r'\\s*[;；]\\s*|\\s+[&+]\\s+|\\s*/\\s+|\\s+/\\s*|\\s*、\\s*(?=[^，。])', text)\n    \n    # Clean and filter segments\n    cleaned = []\n    for seg in segments:\n        seg = seg.strip()\n        # Remove trailing noise words\n        seg = re.sub(r'\\s+(NG|OK了|已处理|有问题|浮高|不稳定|接触不好|重测过|重测|返修)$', '', seg)\n        if seg and len(seg) >= 3:\n            cleaned.append(seg)\n    \n    # If we only got one segment or none, return the original\n    if len(cleaned) <= 1:\n        return [text] if text else ['']\n    \n    return cleaned\n\n# Ca"]
[227.774837, "i", "lculate match score\ndef calculate_match_score(text, indexed_entry, station):\n    text_lower = text.lower()\n    \n    keywords = indexed_entry['keywords']\n    label_words = indexed_entry['label_words']\n    stations = indexed_entry['stations']\n    \n    # Check station scope\n    station_match = station in stations if station else True\n    \n    # Count keyword matches\n    keyword_matches = 0\n    matched_keywords = []\n    \n    for kw in keywords:\n        if len(kw) >= 2 and kw in text_lower:\n            keyword_matches += 1\n            matched_keywords.append(kw)\n    \n    # Count label word matches\n    label_matches = 0\n    for w in label_words:\n        if len(w) >= 2 and w in text_lower:\n            label_matches += 1\n    \n    # Calculate score\n    total_keywords = len(keywords)\n    if total_keywords == 0:\n        keyword_score = 0\n    else:\n        keyword_score = keyword_matches / total_keywords\n    \n    label_score = label_matches / max(len(label_words), 1)\n    \n    # Station bonus\n    station_bonus = 0.15 if station_match else -0.05\n    \n    # Combined score with weights\n    score = keyword_score * 0.65 + label_score * 0.25 + station_bonus\n    \n    # Bonus for multiple keyword matches\n    if keyword_matches >= 3:\n        score += 0.1\n    elif keyword_matches >= 2:\n        score += 0.05\n    \n    return min(score, 1.0), matched_keywords\n\n# Find best match\ndef find_best_match(text, indexed_codebook, station):\n    best_score = 0\n    best_entry = None\n    best_keywords = []\n    \n    for indexed in indexed_codebook:\n        score, matched_kw = calculate_match_score(text, indexed, station)\n        if score > best_score:\n            best_score = score\n            best_entry = indexed['entry']\n            best_keywords = matched_kw\n    \n    return best_entry, best_score, best_keywords\n\nENDSCRIPT\n"]
