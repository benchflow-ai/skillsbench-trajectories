[158.59283, "o", "{\r\n  \"records\": [\r\n    {\r\n      \"record_id\": \"R0000001\",\r\n      \"product_id\": \"P3_RF\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E1\",\r\n      \"raw_reason_text\": \"治具/探针接触不良，重插后偶尔OK 浮高\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000001-S1\",\r\n          \"span_text\": \"治具\",\r\n          \"pred_code\": \"UNKNOWN\",\r\n          \"pred_label\": \"\",\r\n          \"confidence\": 0.05,\r\n          \"rationale\": \"No matching codebook entry found\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000001-S2\",\r\n          \"span_text\": \"探针接触不良，重插后偶尔OK 浮高\",\r\n          \"pred_code\": \"P3_RF-TS-019\",\r\n          \"pred_label\": \"Fixture contact unstable (pogo pin / clamp)\",\r\n          \"confidence\": 0.602,\r\n          \"rationale\": \"Matched keywords: 接触不良, 探针\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000002\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"FUNC\",\r\n      \"engineer_id\": \"E2\",\r\n      \"raw_reason_text\": \"静态电流偏高，疑似短路趋势/器件异常\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000002-S1\",\r\n          \"span_text\": \"静态电流偏高，疑似短路趋势\",\r\n          \"pred_code\": \"P1_POWER-EL-037\",\r\n          \"pred_label\": \"Idle current high / abnormal consumption\",\r\n          \"confidence\": 0.56,\r\n          \"rationale\": \"Matched keywords: 静态电流\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000002-S2\",\r\n          \"span_text\": \"器件异常\",\r\n          \"pred_code\": \"UNKNOWN\",\r\n          \"pred_label\": \"\",\r\n          \"confidence\": 0.05,\r\n          \"rationale\": \"No matching codebook entry found\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000003\",\r\n      \"product_id\": \"P2_CTRL\",\r\n      \"station\": \"FCT\",\r\n      \"engineer_id\": \"E4\",\r\n      \"raw_reason_text\": \"校验失败/CRC挂，疑似程序包或数据异常\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000003-S1\",\r\n          \"span_text\": \"校验失败\",\r\n          \"pred_code\": \"P2_CTRL-SW-031\",\r\n          \"pred_label\": \"Firmware verify failed (CRC/Checksum)\",\r\n          \"confidence\": 0.56,\r\n          \"rationale\": \"Matched keywords: 校验失败\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000003-S2\",\r\n          \"span_text\": \"CRC挂，疑似程序包或数据异常\",\r\n          \"pred_code\": \"P2_CTRL-SW-031\",\r\n          \"pred_label\": \"Firmware verify failed (CRC/Checksum)\",\r\n          \"confidence\": 0.576,\r\n          \"rationale\": \"Matched keywords: crc\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000004\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E1\",\r\n      \"raw_reason_text\": \"R152_NET open, suspect cold solder/missing solder / R152_NET 开路，疑似虚焊/少锡 NG\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000004-S1\",\r\n          \"span_text\": \"R152_NET open, suspect cold solder\",\r\n          \"pred_code\": \"P1_POWER-SD-013\",\r\n          \"pred_label\": \"Cold solder suspected: J3\",\r\n          \"confidence\": 0.6,\r\n          \"rationale\": \"Matched keywords: cold solder\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000004-S2\",\r\n          \"span_text\": \"missing solder\",\r\n          \"pred_code\": \"P1_POWER-CP-043\",\r\n          \"pred_label\": \"Missing component: J3\",\r\n          \"confidence\": 0.75,\r\n          \"rationale\": \"Matched keywords: missing\"\r\n        },\r\n"]
