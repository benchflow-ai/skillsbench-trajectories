[66.090787, "i", "cat > /app/normalize.py << 'ENDSCRIPT'\nimport pandas as pd\nimport json\nimport re\nfrom collections import defaultdict\n\n# Load codebooks\ndef load_codebooks():\n    codebooks = {}\n    for product in ['P1_POWER', 'P2_CTRL', 'P3_RF']:\n        df = pd.read_csv(f'/app/data/codebook_{product}.csv')\n        codebooks[product] = df.to_dict('records')\n    return codebooks\n\n# Parse keywords from codebook entry\ndef parse_keywords(keywords_str):\n    if pd.isna(keywords_str):\n        return []\n    # Split by comma and clean\n    keywords = [k.strip().lower() for k in str(keywords_str).split(',')]\n    return keywords\n\n# Segment the raw reason text into parts\ndef segment_text(raw_text):\n    if pd.isna(raw_text) or not raw_text:\n        return [raw_text] if raw_text else ['']\n    \n    # Common delimiters in the raw text\n    # Split by various separators: /, ;, &, +, 、, multiple spaces, newlines\n    # But preserve the original span text\n    \n    # First normalize some patterns\n    text = str(raw_text)\n    \n    # Split by common delimiters\n    delimiters = r'[/;;&+、\\n]+|\\s+[/;;&+、]\\s+'\n    \n    # Find segments - split on delimiters but keep meaningful chunks\n    segments = re.split(r'\\s*[/;+&、]\\s*|\\s{2,}', text)\n    \n    # Clean segments\n    cleaned = []\n    for seg in segments:\n        seg = seg.strip()\n        if seg and len(seg) > 1:  # Skip very short segments\n            cleaned.append(seg)\n    \n    return cleaned if cleaned else [text]\n\n# Calculate match score between text and codebook entry\ndef calculate_match_score(text, codebook_entry, station):\n    text_lower = text.lower()\n    \n    # Get keywords\n    keywords = parse_keywords(codebook_entry.get('keywords_examples', ''))\n    standard_label = str(codebook_entry.get('standard_label', '')).lower()\n    \n    # Check station scope\n    station_scope = str(codebook_entry.get('station_scope', ''))\n    station_match = station in station_scope if station else True\n    \n    # Count keyword matches\n    keyword_matches = 0\n    total_keywords = len(keywords)\n    matched_keywords = []\n    \n    for kw in keywords:\n        if kw in text_lower:\n            keyword_matches += 1\n            matched_keywords.append(kw)\n    \n    # Check label words\n    label_words = re.findall(r'\\w+', standard_label)\n    label_matches = sum(1 for w in label_words if w in text_lower)\n    \n    # Calculate score\n    if total_keywords == 0:\n        keyword_score = 0\n    else:\n        keyword_score = keyword_matches / total_keywords\n    \n    # Boost score if station matches\n    station_bonus = 0.1 if station_match else 0\n    \n    # Combined score\n    score = keyword_score * 0.7 + (label_matches / max(len(label_words), 1)) * 0.2 + station_bonus\n    \n    return score, matched_keywords\n\n# Find best matching codebook entry\ndef find_best_match(text, codebook, station):\n    best_score = 0\n    best_entry = None\n    best_keywords = []\n    \n    for entry in codebook:\n        score, matched_kw = calculate_match_score(text, entry, station)\n        if score > best_score:\n            best_score = score\n            best_entry = entry\n            best_keywords = matched_kw\n    \n    return best_entry, best_score, best_keywords\n\nENDSCRIPT\n"]
[66.091101, "o", "cat > /app/normalize.py << 'ENDSCRIPT'"]
