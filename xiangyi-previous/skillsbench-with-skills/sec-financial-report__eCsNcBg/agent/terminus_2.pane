[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> acc_q2='0000950123-25-008343'
[?2004l[?2004h> acc_q3='0001193125-25-282901'
[?2004l[?2004h> 
[?2004l[?2004h> # aggregate by CUSIP
[?2004l[?2004h> vals_q2=defaultdict(float)
[?2004l[?2004h> for chunk in pd.read_csv('/root/2025-q2/INFOTABLE.tsv', sep='\t', dtype=str, chunksize=200000):
[?2004l[?2004h>     c = chunk[chunk['ACCESSION_NUMBER']==acc_q2]
[?2004l[?2004h>     if len(c)==0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     for cusip, val in zip(c['CUSIP'], c['VALUE'].astype(float)):
[?2004l[?2004h>         vals_q2[cusip]+=val
[?2004l[?2004h> 
[?2004l[?2004h> vals_q3=defaultdict(float)
[?2004l[?2004h> for chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\t', dtype=str, chunksize=200000):
[?2004l[?2004h>     c = chunk[chunk['ACCESSION_NUMBER']==acc_q3]
[?2004l[?2004h>     if len(c)==0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     for cusip, val in zip(c['CUSIP'], c['VALUE'].astype(float)):
[?2004l[?2004h>         vals_q3[cusip]+=val
[?2004l[?2004h> 
[?2004l[?2004h> # compute increases
[?2004l[?2004h> changes=[]
[?2004l[?2004h> for cusip, v3 in vals_q3.items():
