[54.771606, "i", "python3 - <<'PY'\nimport pandas as pd\nacc='0001037389-25-000064'\npath='/root/2025-q3/INFOTABLE.tsv'\n# read columns\ncols = pd.read_csv(path, sep='\\t', nrows=5).columns\nprint(cols)\n# compute sum and count\nsum_value=0\ncount=0\nfor chunk in pd.read_csv(path, sep='\\t', dtype=str, chunksize=200000):\n    chunk = chunk[chunk['ACCESSION_NUMBER']==acc]\n    if len(chunk)==0:\n        continue\n    count += len(chunk)\n    sum_value += chunk['VALUE'].astype(float).sum()\nprint('count', count, 'sum_value', sum_value)\nPY\n"]
