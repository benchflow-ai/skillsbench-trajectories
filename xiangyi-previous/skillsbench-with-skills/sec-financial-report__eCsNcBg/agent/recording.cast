[115.133457, "o", "vals_q3=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.133605, "o", "for chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.133683, "o", "    c = chunk[chunk['ACCESSION_NUMBER']==acc_q3]\r\n\u001b[?2004l\r"]
[115.13373, "o", "\u001b[?2004h> "]
[115.133758, "o", "    if len(c)==0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
