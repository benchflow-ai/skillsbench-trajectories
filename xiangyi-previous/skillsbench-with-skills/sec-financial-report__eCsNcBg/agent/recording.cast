[193.572119, "i", "python3 - <<'PY'\nimport pandas as pd\nfrom collections import defaultdict\ncusip_target='69608A108'\nvalues=defaultdict(float)\nfor chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\n    cusip_upper = chunk['CUSIP'].str.upper()\n    c = chunk[cusip_upper==cusip_target]\n    if len(c)==0:\n        continue\n    for acc, val in zip(c['ACCESSION_NUMBER'], c['VALUE'].astype(float)):\n        values[acc]+=val\n\ncp = pd.read_csv('/root/2025-q3/COVERPAGE.tsv', sep='\\t', dtype=str)\nacc_to_name = dict(zip(cp['ACCESSION_NUMBER'], cp['FILINGMANAGER_NAME']))\nitems = sorted([(v, acc_to_name.get(acc, acc), acc) for acc, v in values.items()], reverse=True)\nprint('count entries', len(items))\nprint('top10', items[:10])\nPY\n"]
