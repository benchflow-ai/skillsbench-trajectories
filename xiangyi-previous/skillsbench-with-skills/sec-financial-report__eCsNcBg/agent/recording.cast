[157.185683, "i", "python3 - <<'PY'\nimport pandas as pd\nfrom collections import defaultdict\n\n# find palantir CUSIPs\ncusips=set()\nfor chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\n    mask = chunk['NAMEOFISSUER'].str.contains('palantir', case=False, na=False)\n    if mask.any():\n        cusips.update(chunk.loc[mask, 'CUSIP'].unique())\nprint('Palantir CUSIPs:', cusips)\n\n# assume one cusip\ncusip = list(cusips)[0]\n\nvalues=defaultdict(float)\nfor chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\n    c = chunk[chunk['CUSIP']==cusip]\n    if len(c)==0:\n        continue\n    for acc, val in zip(c['ACCESSION_NUMBER'], c['VALUE'].astype(float)):\n        values[acc]+=val\n\n# map accession to manager name\ncp = pd.read_csv('/root/2025-q3/COVERPAGE.tsv', sep='\\t', dtype=str)\nacc_to_name = dict(zip(cp['ACCESSION_NUMBER'], cp['FILINGMANAGER_NAME']))\n\nitems = sorted([(v, acc_to_name.get(acc, acc), acc) for acc, v in values.items()], reverse=True)\nprint('top3:', items[:3])\nPY\n"]
