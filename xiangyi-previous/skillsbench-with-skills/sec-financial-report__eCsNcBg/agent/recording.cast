[115.132206, "i", "python3 - <<'PY'\nimport pandas as pd\nfrom collections import defaultdict\n\nacc_q2='0000950123-25-008343'\nacc_q3='0001193125-25-282901'\n\n# aggregate by CUSIP\nvals_q2=defaultdict(float)\nfor chunk in pd.read_csv('/root/2025-q2/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\n    c = chunk[chunk['ACCESSION_NUMBER']==acc_q2]\n    if len(c)==0:\n        continue\n    for cusip, val in zip(c['CUSIP'], c['VALUE'].astype(float)):\n        vals_q2[cusip]+=val\n\nvals_q3=defaultdict(float)\nfor chunk in pd.read_csv('/root/2025-q3/INFOTABLE.tsv', sep='\\t', dtype=str, chunksize=200000):\n    c = chunk[chunk['ACCESSION_NUMBER']==acc_q3]\n    if len(c)==0:\n        continue\n    for cusip, val in zip(c['CUSIP'], c['VALUE'].astype(float)):\n        vals_q3[cusip]+=val\n\n# compute increases\nchanges=[]\nfor cusip, v3 in vals_q3.items():\n    v2 = vals_q2.get(cusip, 0.0)\n    diff = v3 - v2\n    if diff>0:\n        changes.append((diff, cusip, v2, v3))\n\nchanges.sort(reverse=True)\nprint('top5', changes[:5])\nPY\n"]
[115.132433, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[115.132509, "o", "\u001b[?2004h> "]
[115.132571, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.132615, "o", "from collections import defaultdict\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
