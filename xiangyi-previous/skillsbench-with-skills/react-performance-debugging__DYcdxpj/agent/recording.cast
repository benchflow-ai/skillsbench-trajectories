[20.837518, "o", "\r\n"]
[20.837674, "o", "  if (!res.ok) throw new Error('Failed to fetch products');"]
[20.83783, "o", "\r\n"]
[20.837986, "o", "  return res.json();"]
[20.838138, "o", "\r\n"]
[20.838298, "o", "}"]
[20.838458, "o", "\r\n"]
[20.838609, "o", "\r\n"]
