[20.844493, "o", "    method: 'POST',"]
[20.844652, "o", "\r\n"]
[20.844806, "o", "    headers: { 'Content-Type': 'application/json' },"]
[20.844957, "o", "\r\n"]
[20.845111, "o", "    body: JSON.stringify(data),"]
[20.845266, "o", "\r\n"]
[20.845426, "o", "  });"]
[20.845575, "o", "\r\n"]
[20.845721, "o", "  if (!res.ok) throw new Error('Failed to log analytics');"]
