[20.839201, "o", "\r\n"]
[20.839355, "o", "  if (!res.ok) throw new Error('Failed to fetch reviews');"]
[20.839509, "o", "\r\n"]
[20.839645, "o", "  return res.json();"]
[20.839782, "o", "\r\n"]
[20.839921, "o", "}"]
[20.840051, "o", "\r\n"]
[20.840185, "o", "\r\n"]
