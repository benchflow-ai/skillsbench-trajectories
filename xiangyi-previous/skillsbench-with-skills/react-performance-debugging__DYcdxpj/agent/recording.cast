[20.834183, "o", "// HTTP client for external API services"]
[20.834279, "o", "\r\n"]
[20.834378, "o", "// The actual API runs in a separate service - optimize how you use these calls!"]
[20.834463, "o", "\r\n"]
[20.834547, "o", "\r\n"]
[20.834838, "o", "const API_BASE = process.env.EXTERNAL_API_URL || 'http://localhost:3001';"]
[20.835016, "o", "\r\n"]
[20.835178, "o", "\r\n"]
[20.835335, "o", "export async function fetchUserFromService() {"]
[20.835488, "o", "\r\n"]
[20.835633, "o", "  const res = await fetch(`${API_BASE}/api/user`);"]
[20.835767, "o", "\r\n"]
[20.835874, "o", "  if (!res.ok) throw new Error('Failed to fetch user');"]
[20.835975, "o", "\r\n"]
[20.836088, "o", "  return res.json();"]
[20.83622, "o", "\r\n"]
[20.836547, "o", "}"]
[20.836731, "o", "\r\n"]
[20.836887, "o", "\r\n"]
