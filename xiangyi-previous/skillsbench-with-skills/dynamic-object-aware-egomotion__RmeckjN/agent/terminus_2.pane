[?2004l[?2004h>     with open(output_json, 'w') as f:
[?2004l[?2004h>         json.dump(dict(motion_dict), f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Save dynamic masks
[?2004l[?2004h>     print(f"Saving dynamic masks to {output_npz}...")
[?2004l[?2004h>     np.savez(output_npz, **masks_data)
[?2004l[?2004h>     
[?2004l[?2004h>     print("\nAnalysis complete!")
