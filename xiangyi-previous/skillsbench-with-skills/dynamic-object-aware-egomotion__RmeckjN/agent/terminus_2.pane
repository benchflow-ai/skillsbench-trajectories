[?2004l[?2004h> def mask_to_csr(mask):
[?2004l[?2004h>     """Convert binary mask to CSR sparse format (row-wise)"""
[?2004l[?2004h>     h, w = mask.shape
[?2004l[?2004h>     data = []
[?2004l[?2004h>     indices = []
[?2004l[?2004h>     indptr = [0]
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(h):
[?2004l[?2004h>         row = mask[i, :]
[?2004l[?2004h>         col_indices = np.where(row)[0]
[?2004l[?2004h>         data.extend(col_indices)
[?2004l[?2004h>         indices.extend(col_indices)
[?2004l[?2004h>         indptr.append(len(data))
[?2004l[?2004h>     
[?2004l[?2004h>     return np.array(data, dtype=np.uint32), np.array(indices, dtype=np.uint32), np.array(indptr, dtype=np.uint32)
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_video(video_path, output_json, output_npz, fps=6):
[?2004l[?2004h>     """Main analysis function"""
[?2004l[?2004h>     print(f"Loading video from {video_path}...")
