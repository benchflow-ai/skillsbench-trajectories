[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy import sparse
[?2004l[?2004h> import json
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004le[?2004h> def get_video_frames(video_path, fps=6):
[?2004l[?2004h>     """Extract frames from video at specified fps"""
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     video_fps = cap.get(cv2.CAP_PROP_FPS)
[?2004l[?2004h>     total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
[?2004l[?2004h>     
[?2004l[?2004h>     frame_interval = int(video_fps / fps) if video_fps > 0 else 1
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     frame_indices = []
[?2004l[?2004h>     
[?2004l[?2004h>     frame_count = 0
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, frame = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         if frame_count % frame_interval == 0:
[?2004l[?2004h>             frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))
[?2004l[?2004h>             frame_indices.append(frame_count)
[?2004l[?2004h>         frame_count += 1
[?2004l[?2004h>     
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     return frames, frame_indices
[?2004l[?2004h> 
[?2004ls[?2004h> def compute_optical_flow(prev_frame, curr_frame):
[?2004l[?2004h>     """Compute optical flow between frames"""
[?2004l[?2004h>     flow = cv2.calcOpticalFlowFarneback(
[?2004l[?2004h>         prev_frame, curr_frame, None, 0.5, 3, 15, 3, 5, 1.2, 0
[?2004l[?2004h>     )
[?2004lp[?2004h>     return flow
[?2004l[?2004h> 
[?2004l[?2004h> def classify_motion(flow):
[?2004l[?2004h>     """Classify camera motion from optical flow"""
[?2004l[?2004h>     h, w = flow.shape[:2]
[?2004l[?2004h>     fx = flow[..., 0]
[?2004l[?2004h>     fy = flow[..., 1]
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute statistics
[?2004l[?2004h>     mean_x = np.mean(fx)
[?2004l[?2004h>     mean_y = np.mean(fy)
[?2004l[?2004h>     std_x = np.std(fx)
[?2004l[?2004h>     std_y = np.std(fy)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for dominant motion direction
[?2004l[?2004h>     abs_mean_x = abs(mean_x)
[?2004l[?2004h>     abs_mean_y = abs(mean_y)
[?2004l[?2004h>     
[?2004l[?2004h>     # Threshold for motion detection
[?2004l[?2004h>     motion_threshold = 0.5
[?2004l[?2004h>     
[?2004l[?2004h>     if abs_mean_x < motion_threshold and abs_mean_y < motion_threshold:
[?2004l[?2004h>         return "Stay"
[?2004l[?2004h>     
[?2004l[?2004h>     # Pan (horizontal camera motion)
[?2004l[?2004h>     if abs_mean_x > abs_mean_y:
[?2004l[?2004h>         if mean_x > 0:
[?2004l[?2004h>             return "Pan Right"
[?2004l[?2004h>         else:
[?2004l[?2004h>             return "Pan Left"
[?2004l[?2004h>     # Tilt (vertical camera motion)
[?2004l[?2004h>     elif abs_mean_y > abs_mean_x:
[?2004l[?2004h>         if mean_y > 0:
[?2004l[?2004h>             return "Tilt Down"
[?2004l[?2004h>         else:
[?2004l[?2004h>             return "Tilt Up"
[?2004l[?2004h>     
[?2004l[?2004h>     return "Stay"
[?2004l[?2004h> 
[?2004l[?2004h> def detect_dynamic_objects(prev_frame, curr_frame, flow):
[?2004l[?2004h>     """Detect dynamic objects using frame difference and optical flow"""
[?2004l[?2004h>     h, w = prev_frame.shape
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute frame difference
[?2004l[?2004h>     diff = cv2.absdiff(prev_frame, curr_frame)
[?2004l[?2004h>     
[?2004l[?2004h>     # Threshold to get binary mask
[?2004l[?2004h>     _, diff_mask = cv2.threshold(diff, 30, 1, cv2.THRESH_BINARY)
[?2004l[?2004h>     
[?2004l[?2004h>     # Warp previous frame using optical flow
[?2004l[?2004h>     x, y = np.meshgrid(np.arange(w), np.arange(h))
[?2004l[?2004h>     map_x = (x + flow[..., 0]).astype(np.float32)
[?2004l[?2004h>     map_y = (y + flow[..., 1]).astype(np.float32)
[?2004l[?2004h>     
[?2004l[?2004h>     warped = cv2.remap(prev_frame, map_x, map_y, cv2.INTER_LINEAR)
[?2004l[?2004h>     
[?2004l[?2004h>     # Dynamic objects are where warped frame doesn't match current frame
[?2004l[?2004h>     dynamic_diff = cv2.absdiff(warped, curr_frame)
[?2004l[?2004h>     _, dynamic_mask = cv2.threshold(dynamic_diff, 20, 1, cv2.THRESH_BINARY)
[?2004l[?2004h>     
[?2004l[?2004h>     # Combine masks
[?2004l[?2004h>     combined_mask = np.logical_or(diff_mask, dynamic_mask).astype(np.uint8)
[?2004l[?2004h>     
[?2004l[?2004h>     # Morphological operations to clean up
[?2004l[?2004h>     kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
[?2004l[?2004h>     combined_mask = cv2.morphologyEx(combined_mask, cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>     
[?2004l[?2004h>     return combined_mask
[?2004l[?2004h> 
[?2004l[?2004h> def mask_to_csr(mask):
[?2004l[?2004h>     """Convert binary mask to CSR sparse format"""
[?2004l[?2004h>     # Convert to scipy sparse CSR format
[?2004l[?2004h>     csr_matrix = sparse.csr_matrix(mask)
[?2004l[?2004h>     return csr_matrix.data, csr_matrix.indices, csr_matrix.indptr
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_video(video_path, output_json, output_npz, fps=6):
[?2004l[?2004h>     """Main analysis function"""
[?2004l[?2004h>     print(f"Loading video from {video_path}...")
[?2004l[?2004h>     frames, frame_indices = get_video_frames(video_path, fps=fps)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Loaded {len(frames)} frames")
[?2004l[?2004h>     if len(frames) < 2:
[?2004l[?2004h>         print("Error: Not enough frames")
[?2004l[?2004h>         return
[?2004l[?2004h>     
[?2004l[?2004h>     # Motion classification
[?2004l[?2004h>     motion_dict = defaultdict(list)
[?2004l[?2004h>     
[?2004l[?2004h>     # Dynamic masks storage
[?2004l[?2004h>     masks_data = {"shape": [frames[0].shape[0], frames[0].shape[1]]}
[?2004l[?2004h>     
[?2004l[?2004h>     print("\nAnalyzing frames...")
[?2004l[?2004h>     for i in range(len(frames) - 1):
[?2004l[?2004h>         print(f"Processing frame pair {i}-{i+1}...")
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute optical flow
[?2004l[?2004h>         flow = compute_optical_flow(frames[i], frames[i+1])
[?2004l[?2004h>         
[?2004l[?2004h>         # Classify motion
[?2004l[?2004h>         motion_label = classify_motion(flow)
[?2004l[?2004h>         motion_dict[f"{i}->{i+1}"].append(motion_label)
[?2004l[?2004h>         
[?2004l[?2004h>         # Detect dynamic objects
[?2004l[?2004h>         dyn_mask = detect_dynamic_objects(frames[i], frames[i+1], flow)
[?2004l[?2004h>         
[?2004l[?2004h>         # Convert to CSR format
[?2004l[?2004h>         data, indices, indptr = mask_to_csr(dyn_mask)
[?2004l[?2004h>         masks_data[f"f_{i}_data"] = data
[?2004l[?2004h>         masks_data[f"f_{i}_indices"] = indices
[?2004l[?2004h>         masks_data[f"f_{i}_indptr"] = indptr
[?2004l[?2004h>     
[?2004l[?2004h>     # Save motion instructions
[?2004l[?2004h>     print(f"\nSaving motion instructions to {output_json}...")
[?2004l[?2004h>     with open(output_json, 'w') as f:
[?2004l[?2004h>         json.dump(dict(motion_dict), f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Save dynamic masks
[?2004l[?2004h>     print(f"Saving dynamic masks to {output_npz}...")
[?2004l[?2004h>     np.savez(output_npz, **masks_data)
[?2004l[?2004h>     
[?2004l[?2004h>     print("\nAnalysis complete!")
[?2004l[?2004h>     print(f"Motion labels: {set(v[0] for v in motion_dict.values())}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     analyze_video(
[?2004l[?2004h>         "/root/input.mp4",
[?2004l[?2004h>         "/root/pred_instructions.json",
[?2004l[?2004h>         "/root/pred_dyn_masks.npz",
[?2004l[?2004h>         fps=6
[?2004l[?2004h>     )
