[?2004l[?2004h>     
[?2004l[?2004h>     # Dynamic masks storage
[?2004l[?2004h>     masks_data = {"shape": np.array([frames[0].shape[0], frames[0].shape[1]], dtype=np.int32)}
[?2004l[?2004h>     
[?2004l[?2004h>     print("\nAnalyzing frames...")
[?2004l[?2004h>     for i in range(len(frames) - 1):
[?2004l[?2004h>         print(f"Processing frame pair {i}->{i+1}...")
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute optical flow
[?2004l[?2004h>         flow = compute_optical_flow(frames[i], frames[i+1])
[?2004l[?2004h>         
[?2004l[?2004h>         # Classify motion
[?2004l[?2004h>         motion_label = classify_motion(flow)
[?2004l[?2004h>         motion_dict[f"{i}->{i+1}"].append(motion_label)
[?2004l[?2004h>         
[?2004l[?2004h>         # Detect dynamic objects
[?2004l[?2004h>         dyn_mask = detect_dynamic_objects(frames[i], frames[i+1], flow)
[?2004l[?2004h>         
[?2004l[?2004h>         # Convert to CSR format
[?2004l[?2004h>         data, indices, indptr = mask_to_csr(dyn_mask)
