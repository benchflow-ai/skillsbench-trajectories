[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> # First, let's understand the NA sheet layout better
[?2004l[?2004h> # Column C: Real GDP - needs to be linked from WEO_Data
[?2004l[?2004h> # Column J: Baseline GDP Growth - needs to be linked from WEO_Data
[?2004l[?2004h> # Rows 3-25 contain years 2020-2042
[?2004l[?2004h> 
[?2004l[?2004h> # Create linking formulas for Real GDP (Column C)
[?2004l[?2004h> # Years 2020-2042 are in rows 3-25
[?2004l[?2004h> for i in range(24):  # 24 years from 2020 to 2043
[?2004l[?2004h>     year = 2020 + i
[?2004l[?2004h>     row = i + 3
[?2004l[?2004h>     # Link to WEO_Data sheet - Nominal GDP (Column C)
[?2004l[?2004h>     ws_na[f'C{row}'] = f"='WEO_Data'!C{i+4}"
[?2004l[?2004h> 
[?2004l[?2004h> # Create linking formulas for Baseline GDP Growth (Column J)
[?2004l[?2004h> for i in range(24):
[?2004l[?2004h>     year = 2020 + i
[?2004l[?2004h>     row = i + 3
[?2004l[?2004h>     # Link to WEO_Data sheet - GDP Growth Rate (Column E)
[?2004l[?2004h>     ws_na[f'J{row}'] = f"='WEO_Data'!E{i+4}"
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test - demand.xlsx')
