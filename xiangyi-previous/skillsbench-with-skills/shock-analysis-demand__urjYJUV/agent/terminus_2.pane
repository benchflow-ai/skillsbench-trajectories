[?2004hroot@b846c53d8222:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> # Create bell-shape allocation for 2026-2033 (8 years)
[?2004l[?2004h> # Years 2026-2033 are in rows 9-16
[?2004l[?2004h> # Bell shape: peak in middle (2029-2030, rows 12-13)
[?2004l[?2004h> # Using triangular distribution: 0%, 10%, 20%, 25%, 25%, 20%, 10%, 5% for years 2026-2033
[?2004l[?2004h> 
[?2004l[?2004h> allocation_percentages = {
[?2004l[?2004h>     9: 5,      # 2026: 5%
[?2004l[?2004h>     10: 10,    # 2027: 10%
[?2004l[?2004h>     11: 15,    # 2028: 15%
[?2004l[?2004h>     12: 20,    # 2029: 20%
[?2004l[?2004h>     13: 20,    # 2030: 20%
[?2004l[?2004h>     14: 15,    # 2031: 15%
[?2004l[?2004h>     15: 10,    # 2032: 10%
[?2004l[?2004h>     16: 5,     # 2033: 5%
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Fill allocation percentages
[?2004l[?2004h> for row, pct in allocation_percentages.items():
[?2004l[?2004h>     ws_na[f'D{row}'] = pct
[?2004l[?2004h> 
[?2004l[?2004h> # For other years (2020-2025, 2034-2042), allocation is 0
[?2004l[?2004h> for row in range(3, 9):  # 2020-2025
[?2004l[?2004h>     ws_na[f'D{row}'] = 0
[?2004l[?2004h> for row in range(17, 26):  # 2034-2042
[?2004l[?2004h>     ws_na[f'D{row}'] = 0
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test - demand.xlsx')
[?2004l[?2004h> print('Bell-shape allocation created for 2026-2033')
[?2004l[?2004h> print('Allocation: 5%, 10%, 15%, 20%, 20%, 15%, 10%, 5%')
[?2004l[?2004h> EOF
[?2004lBell-shape allocation created for 2026-2033
Allocation: 5%, 10%, 15%, 20%, 20%, 15%, 10%, 5%
[?2004hroot@b846c53d8222:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> # Create formulas for rows 3-25 (years 2020-2042)
[?2004l[?2004h> for row in range(3, 26):
[?2004l[?2004h>     # Column E: Project Investment = (D/100) * Total Investment
[?2004l[?2004h>     # Convert percentage to amount: D{row}% of $D$30
[?2004l[?2004h>     ws_na[f'E{row}'] = f'=D{row}*$D$30/100'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column F: Imports = Project Investment * Import Content Share
[?2004l[?2004h>     # E{row} * (D31/100) - import content share is in percentage
[?2004l[?2004h>     ws_na[f'F{row}'] = f'=E{row}*$D$31/100'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column G: GDP impact (I-M) = Project Investment - Imports
[?2004l[?2004h>     ws_na[f'G{row}'] = f'=E{row}-F{row}'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column H: Multiplier (just reference the assumption)
[?2004l[?2004h>     ws_na[f'H{row}'] = f'=$D$32'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column I: % of GDP = (GDP impact / Real GDP) * 100
[?2004l[?2004h>     # Need to handle division by zero
[?2004l[?2004h>     ws_na[f'I{row}'] = f'=IF(C{row}=0,0,(G{row}/C{row})*100)'
[?2004l[?2004h>     
[?2004l[?2004h>     # Column K: Projected Growth = Baseline Growth + Impact
[?2004l[?2004h>     # Impact = (GDP impact * Multiplier / Real GDP) * 100
[?2004l[?2004h>     ws_na[f'K{row}'] = f'=IF(C{row}=0,J{row},J{row}+(G{row}*H{row}/C{row})*100)'
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test - demand.xlsx')
[?2004l[?2004h> print('Calculation formulas created for all rows')
[?2004l[?2004h> print('Column E: Project Investment (Allocation % × Total Investment)')
[?2004l[?2004h> print('Column F: Imports (Investment × Import Content Share)')
[?2004l[?2004h> print('Column G: GDP impact (Investment - Imports)')
[?2004l[?2004h> print('Column H: Multiplier')
[?2004l[?2004h> print('Column I: % of GDP')
[?2004l[?2004h> print('Column K: Projected Growth')
[?2004l[?2004h> EOF
[?2004lCalculation formulas created for all rows
Column E: Project Investment (Allocation % × Total Investment)
Column F: Imports (Investment × Import Content Share)
Column G: GDP impact (Investment - Imports)
Column H: Multiplier
Column I: % of GDP
Column K: Projected Growth
