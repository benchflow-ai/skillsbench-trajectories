[?2004l[?2004h> # Add total formulas in row 43 (TOTAL row)
[?2004l[?2004h> # Sum of imports and use
[?2004l[?2004h> ws_sut['E43'] = '=SUM(E4:E41)'  # Total imports
[?2004l[?2004h> ws_sut['D43'] = '=SUM(D4:D41)'  # Total use
[?2004l[?2004h> 
[?2004l[?2004h> # Import content share formula in C46
[?2004l[?2004h> # Import Content Share = Total Imports / Total Use * 100
