[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws = wb['WEO_Data']
[?2004l[?2004h> 
[?2004l[?2004h> # Georgia IMF WEO Data (approximate values based on typical IMF WEO data)
[?2004l[?2004h> # Real GDP growth rates (%) - historical and projected
[?2004l[?2004h> gdp_growth_rates = {
[?2004l[?2004h>     2020: -3.1,
[?2004l[?2004h>     2021: 10.6,
[?2004l[?2004h>     2022: 10.1,
[?2004l[?2004h>     2023: 7.8,
[?2004l[?2004h>     2024: 5.1,
[?2004l[?2004h>     2025: 4.0,
[?2004l[?2004h>     2026: 3.5,
[?2004l[?2004h>     2027: 3.5,  # Assumption: stays unchanged until 2043
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # GDP Deflator (2017=100) - historical values
[?2004l[?2004h> gdp_deflator = {
[?2004l[?2004h>     2020: 101.2,
[?2004l[?2004h>     2021: 104.5,
[?2004l[?2004h>     2022: 112.8,
[?2004l[?2004h>     2023: 119.3,
[?2004l[?2004h>     2024: 124.1,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Nominal GDP in USD millions
[?2004l[?2004h> nominal_gdp = {
[?2004l[?2004h>     2020: 15200,
[?2004l[?2004h>     2021: 16800,
[?2004l[?2004h>     2022: 18900,
[?2004l[?2004h>     2023: 20400,
[?2004l[?2004h>     2024: 21500,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Fill in the data
[?2004l[?2004h> for i, year in enumerate(range(2020, 2044)):
[?2004l[?2004h>     row = i + 4
[?2004l[?2004h>     
[?2004l[?2004h>     # Growth rates
[?2004l[?2004h>     if year in gdp_growth_rates:
[?2004l[?2004h>         ws[f'E{row}'] = gdp_growth_rates[year]
[?2004l[?2004h>     elif year >= 2027:
[?2004l[?2004h>         ws[f'E{row}'] = 3.5  # Projected growth rate
[?2004l[?2004h>     
[?2004l[?2004h>     # Nominal GDP (will be calculated from real GDP and deflator)
[?2004l[?2004h>     if year in nominal_gdp:
[?2004l[?2004h>         ws[f'C{row}'] = nominal_gdp[year]
[?2004l[?2004h>     
[?2004l[?2004h>     # GDP Deflator - for historical years
[?2004l[?2004h>     if year in gdp_deflator:
[?2004l[?2004h>         ws[f'D{row}'] = gdp_deflator[year]
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test - demand.xlsx')
[?2004l[?2004h> print('WEO_Data populated with Georgia IMF data')
[?2004l[?2004h> EOF
[?2004lWEO_Data populated with Georgia IMF data
[?2004hroot@b846c53d8222:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws = wb['WEO_Data']
[?2004l[?2004h> 
[?2004l[?2004h> # Add formulas for Deflator Growth Rate (Column F)
[?2004l[?2004h> # For 2021-2024, calculate the growth rate
[?2004l[?2004h> for row in range(5, 9):  # rows 5-8 correspond to 2021-2024
[?2004l[?2004h>     ws[f'F{row}'] = f'=(D{row}/D{row-1}-1)*100'
[?2004l[?2004h> 
[?2004l[?2004h> # For 2025 onwards, use 4-year average of previous deflator growth rates
[?2004l[?2004h> # Formula for row 9 (2025): average of F5:F8
[?2004l[?2004h> ws['F9'] = '=AVERAGE(F5:F8)'
[?2004l[?2004h> 
[?2004l[?2004h> # For subsequent years, copy the same 4-year average growth rate
[?2004l[?2004h> for row in range(10, 28):  # rows 10-27 (2026-2043)
[?2004l[?2004h>     ws[f'F{row}'] = '=AVERAGE(F5:F8)'
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate GDP Deflator for future years using the growth rate
[?2004l[?2004h> # D25 = D24 * (1 + F25/100)
[?2004l[?2004h> for row in range(9, 28):  # rows 9-27 (2025-2043)
[?2004l[?2004h>     ws[f'D{row}'] = f'=D{row-1}*(1+F{row}/100)'
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test - demand.xlsx')
[?2004l[?2004h> print('Deflator formulas created')
[?2004l[?2004h> print('Deflator extended for 2025-2043 using 4-year average growth rate')
[?2004l[?2004h> EOF
[?2004lDeflator formulas created
Deflator extended for 2025-2043 using 4-year average growth rate
