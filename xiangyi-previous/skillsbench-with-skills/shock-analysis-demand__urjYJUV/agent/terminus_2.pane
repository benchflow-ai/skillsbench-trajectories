[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> # Fill in assumptions
[?2004l[?2004h> # D30: Total Investment in USD millions (6.5 billion USD = 6500 million)
[?2004l[?2004h> ws_na['D30'] = 6500
[?2004l[?2004h> 
[?2004l[?2004h> # D31: Import content share - will link to SUT Calc later
[?2004l[?2004h> # For now, set a placeholder that will be replaced
[?2004l[?2004h> ws_na['D31'] = "='SUT Calc'!C46"  # This will link to calculated import content share
[?2004l[?2004h> 
[?2004l[?2004h> # D32: Demand multiplier
[?2004l[?2004h> ws_na['D32'] = 0.8
