[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # First, create formulas in SUT Calc for import content calculation
[?2004l[?2004h> ws_sut = wb['SUT Calc']
