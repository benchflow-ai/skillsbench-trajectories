[33.578273, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws = wb['NA']\n\nprint('NA Sheet Content (first 15 rows):')\nfor row in range(1, 16):\n    row_data = []\n    for col in range(2, 12):  # B to K\n        cell = ws.cell(row, col)\n        row_data.append(str(cell.value)[:20] if cell.value else '')\n    print(f'Row {row}: {row_data}')\nEOF\n"]
