[25.617743, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Add missing sheets if they don't exist\nsheet_names_needed = ['WEO_Data', 'SUPPLY', 'USE', 'SUT Calc']\nfor sheet_name in sheet_names_needed:\n    if sheet_name not in wb.sheetnames:\n        wb.create_sheet(sheet_name)\n        print(f'Created sheet: {sheet_name}')\n    else:\n        print(f'Sheet already exists: {sheet_name}')\n\nwb.save('/root/test - demand.xlsx')\nprint('\\nSheets in workbook:', wb.sheetnames)\nEOF\n"]
