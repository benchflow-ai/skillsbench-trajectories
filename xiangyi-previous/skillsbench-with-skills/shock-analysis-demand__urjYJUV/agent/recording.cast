[194.048594, "o", "# Now update SUT Calc to link to SUPPLY and USE sheets"]
[194.048686, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[194.048758, "o", "> "]
[194.048918, "o", "ws_sut = wb['SUT Calc']"]
