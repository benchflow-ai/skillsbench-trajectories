[184.977997, "i", "python3 << 'EOF'\nimport openpyxl\nimport random\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Add sample data to SUPPLY sheet\nws_supply = wb['SUPPLY']\nfor i in range(1, 39):\n    row = i + 2\n    # Domestic supply: random value between 100-1000\n    ws_supply[f'B{row}'] = random.randint(100, 1000)\n    # Imports: 20-40% of domestic supply\n    domestic = ws_supply[f'B{row}'].value\n    import_pct = random.uniform(0.2, 0.4)\n    ws_supply[f'C{row}'] = round(domestic * import_pct)\n\n# Add sample data to USE sheet\nws_use = wb['USE']\nfor i in range(1, 39):\n    row = i + 2\n    # Domestic use: random value between 100-1000\n    ws_use[f'B{row}'] = random.randint(100, 1000)\n    # Imports used: 20-40% of domestic use\n    domestic = ws_use[f'B{row}'].value\n    import_pct = random.uniform(0.2, 0.4)\n    ws_use[f'C{row}'] = round(domestic * import_pct)\n\n# Add sum formulas for SUPPLY\nws_supply['B40'] = '=SUM(B4:B41)'\nws_supply['C40'] = '=SUM(C4:C41)'\n\n# Add sum formulas for USE\nws_use['B40'] = '=SUM(B4:B41)'\nws_use['C40'] = '=SUM(C4:C41)'\n\nwb.save('/root/test - demand.xlsx')\nprint('Sample data added to SUPPLY and USE sheets')\nprint('Each sheet has 38 product categories with realistic import shares (20-40%)')\nEOF\n"]
[184.981148, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add sample data to SUPPLY sheet\r\n\u001b[?2004l\r\u001b[?2004h> ws_supply = wb['SUPPLY']\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, 39):\r\n\u001b[?2004l\r\u001b[?2004h>     row = i + 2\r\n\u001b[?2004l\r\u001b[?2004h>     # Domestic supply: random value between 100-1000\r\n\u001b[?2004l\r\u001b[?2004h>     ws_supply[f'B{row}'] = random.randint(100, 1000)\r\n\u001b[?2004l\r\u001b[?2004h>     # Imports: 20-40% of domestic supply\r\n\u001b[?2004l\r\u001b[?2004h>     domestic = ws_supply[f'B{row}'].value\r\n\u001b[?2004l\r\u001b[?2004h>     import_pct = random.uniform(0.2, 0.4)\r\n\u001b[?2004l\r\u001b[?2004h>     ws_supply[f'C{row}'] = round(domestic * import_pct)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add sample data to USE sheet\r\n\u001b[?2004l\r\u001b[?2004h> ws_use = wb['USE']\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, 39):\r\n\u001b[?2004l\r\u001b[?2004h>     row = i + 2\r\n\u001b[?2004l\r\u001b[?2004h>     # Domestic use: random value between 100-1000\r\n\u001b[?2004l\r\u001b[?2004h>     ws_use[f'B{row}'] = random.randint(100, 1000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
