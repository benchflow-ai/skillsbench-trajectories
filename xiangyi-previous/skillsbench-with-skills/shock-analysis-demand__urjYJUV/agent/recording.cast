[194.046143, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Fix SUPPLY sheet - move totals to row 43\nws_supply = wb['SUPPLY']\nws_supply['B43'] = '=SUM(B4:B41)'\nws_supply['C43'] = '=SUM(C4:C41)'\n# Clear row 40\nws_supply['B40'].value = None\nws_supply['C40'].value = None\n\n# Fix USE sheet - move totals to row 43\nws_use = wb['USE']\nws_use['B43'] = '=SUM(B4:B41)'\nws_use['C43'] = '=SUM(C4:C41)'\n# Clear row 40\nws_use['B40'].value = None\nws_use['C40'].value = None\n\n# Now update SUT Calc to link to SUPPLY and USE sheets\nws_sut = wb['SUT Calc']\n\n# Link SUPPLY data to SUT Calc columns B and C\nfor i in range(1, 39):\n    row = i + 3\n    # Column B: Domestic Supply from SUPPLY sheet\n    ws_sut[f'B{row}'] = f\"='SUPPLY'!B{i+2}\"\n    # Column C: Imports from SUPPLY sheet (or we can use USE for imports)\n    ws_sut[f'C{row}'] = f\"='SUPPLY'!C{i+2}\"\n    # Column D: Use from USE sheet\n    ws_sut[f'D{row}'] = f\"='USE'!B{i+2}\"\n    # Column E: Imports from USE sheet\n    ws_sut[f'E{row}'] = f\"='USE'!C{i+2}\"\n\nwb.save('/root/test - demand.xlsx')\nprint('Fixed sum formulas in SUPPLY and USE sheets (moved to row 43)')\nprint('Updated SUT Calc to link to SUPPLY and USE sheets')\nEOF\n"]
