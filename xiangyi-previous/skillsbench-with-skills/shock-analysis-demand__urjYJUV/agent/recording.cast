[114.106834, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_na = wb['NA']\n\n# First, let's understand the NA sheet layout better\n# Column C: Real GDP - needs to be linked from WEO_Data\n# Column J: Baseline GDP Growth - needs to be linked from WEO_Data\n# Rows 3-25 contain years 2020-2042\n\n# Create linking formulas for Real GDP (Column C)\n# Years 2020-2042 are in rows 3-25\nfor i in range(24):  # 24 years from 2020 to 2043\n    year = 2020 + i\n    row = i + 3\n    # Link to WEO_Data sheet - Nominal GDP (Column C)\n    ws_na[f'C{row}'] = f\"='WEO_Data'!C{i+4}\"\n\n# Create linking formulas for Baseline GDP Growth (Column J)\nfor i in range(24):\n    year = 2020 + i\n    row = i + 3\n    # Link to WEO_Data sheet - GDP Growth Rate (Column E)\n    ws_na[f'J{row}'] = f\"='WEO_Data'!E{i+4}\"\n\nwb.save('/root/test - demand.xlsx')\nprint('Linking formulas created for Real GDP and Baseline GDP Growth')\nEOF\n"]
[114.110997, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> ws_na = wb['NA']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # First, let's understand the NA sheet layout better\r\n\u001b[?2004l\r\u001b[?2004h> # Column C: Real GDP - needs to be linked from WEO_Data\r\n\u001b[?2004l\r\u001b[?2004h> # Column J: Baseline GDP Growth - needs to be linked from WEO_Data\r\n\u001b[?2004l\r\u001b[?2004h> # Rows 3-25 contain years 2020-2042\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create linking formulas for Real GDP (Column C)\r\n\u001b[?2004l\r\u001b[?2004h> # Years 2020-2042 are in rows 3-25\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(24):  # 24 years from 2020 to 2043\r\n\u001b[?2004l\r\u001b[?2004h>     year = 2020 + i\r\n\u001b[?2004l\r\u001b[?2004h>     row = i + 3\r\n\u001b[?2004l\r\u001b[?2004h>     # Link to WEO_Data sheet - Nominal GDP (Column C)\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'C{row}'] = f\"='WEO_Data'!C{i+4}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create linking formulas for Baseline GDP Growth (Column J)\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(24):\r\n\u001b[?2004l\r\u001b[?2004h>     year = 2020 + i\r\n\u001b[?2004l\r\u001b[?2004h>     row = i + 3\r\n\u001b[?2004l\r\u001b[?2004h>     # Link to WEO_Data sheet - GDP Growth Rate (Column E)\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'J{row}'] = f\"='WEO_Data'!E{i+4}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('Linking formulas created for Real GDP and Baseline GDP Growth')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
