[41.318408, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws = wb['NA']\n\nprint('NA Sheet - All content:')\nfor row in range(1, 34):\n    row_data = []\n    for col in range(1, 12):  # A to K\n        cell = ws.cell(row, col)\n        value = cell.value\n        if value:\n            row_data.append(f'{chr(64+col)}: {str(value)[:30]}')\n    if row_data:\n        print(f'Row {row}: {row_data}')\nEOF\n"]
