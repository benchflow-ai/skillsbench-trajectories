[240.769441, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\nprint('='*60)\nprint('FINAL VERIFICATION - test - demand.xlsx')\nprint('='*60)\n\nprint('\\n1. WORKBOOK STRUCTURE')\nprint(f'   Sheets: {wb.sheetnames}')\nprint(f'   Total sheets: {len(wb.sheetnames)}')\n\nprint('\\n2. WEO_DATA SHEET')\nws_weo = wb['WEO_Data']\nprint(f'   Title: {ws_weo[\"A1\"].value}')\nprint(f'   Headers: Year, Real GDP, Nominal GDP, GDP Deflator, Growth Rate, Deflator Growth')\nprint(f'   Data range: 2020-2043 (24 years)')\nprint(f'   Key formulas:')\nprint(f'     - Deflator growth rate (F5-F8): =(D{row}/D{row-1}-1)*100')\nprint(f'     - Future deflator growth (F9-F27): =AVERAGE(F5:F8)')\nprint(f'     - Future deflator (D9-D27): =D{row-1}*(1+F{row}/100)')\n\nprint('\\n3. SUPPLY & USE SHEETS')\nws_supply = wb['SUPPLY']\nws_use = wb['USE']\nprint(f'   SUPPLY: {ws_supply[\"A1\"].value}')\nprint(f'     - 38 product categories (rows 4-41)')\nprint(f'     - Columns: Product, Domestic Supply, Imports')\nprint(f'     - Total row (43): Sum formulas in place')\nprint(f'   USE: {ws_use[\"A1\"].value}')\nprint(f'     - 38 product categories (rows 4-41)')\nprint(f'     - Columns: Product, Domestic Use, Imports Used')\nprint(f'     - Total row (43): Sum formulas in place')\n\nprint('\\n4. SUT CALC SHEET')\nws_sut = wb['SUT Calc']\nprint(f'   Purpose: Calculate import content share')\nprint(f'   Structure:')\nprint(f'     - 38 product rows (4-41)')\nprint(f'     - Linked to SUPPLY and USE sheets')\nprint(f'     - Total row (43): Sums all columns')\nprint(f'   Key formula:')\nprint(f'     - C46 (Import Content Share): =IF(D43=0,0,(E43/D43)*100)')\n\nprint('\\n5. SCENARIO 1 (BASE CASE)')\nws_s1 = wb['Scenario 1']\nprint(f'   Assumptions:')\nprint(f'     - Total Investment: {ws_s1[\"D30\"].value} USD millions')\nprint(f'     - Import Content Share: {ws_s1[\"D31\"].value} (linked to SUT Calc)')\nprint(f'     - Demand Multiplier: {ws_s1[\"D32\"].value}')\nprint(f'     - Project Allocation: Bell shape (2026-2033)')\nprint(f'   Data years: 2020-2042 (rows 3-25)')\nprint(f'   Key columns:')\nprint(f'     - C: Real GDP (linked to WEO_Data)')\nprint(f'     - D: Project Allocation %')\nprint(f'     - E: Project Investment')\nprint(f'     - F: Imports')\nprint(f'     - G: GDP impact (I-M)')\nprint(f'     - H: Multiplier')\nprint(f'     - I: % of GDP')\nprint(f'     - J: Baseline GDP Growth (linked to WEO_Data)')\nprint(f'     - K: Projected Growth')\n\nprint('\\n6. SCENARIO 2')\nws_s2 = wb['Scenario 2']\nprint(f'   Modification: Demand Multiplier = {ws_s2[\"D32\"].value}')\nprint(f'   Other assumptions: Same as Scenario 1')\nprint(f'   All formulas: Copied from Scenario 1')\n\nprint('\\n7. SCENARIO 3')\nws_s3 = wb['Scenario 3']\nprint(f'   Modification: Import Content Share = {ws_s3[\"D31\"].value}%')\nprint(f'   Other assumptions: Same as Scenario 1')\nprint(f'   All formulas: Copied from Scenario 1')\n\nprint('\\n' + '='*60)\nprint('FILE STATUS: READY FOR USE')\nprint('='*60)\nprint('\\nNext steps:')\nprint('1. Populate SUPPLY and USE sheets with actual geostat data')\nprint('2. Update WEO_Data with actual IMF WEO database values')\nprint('3. All formulas will automatically calculate results')\nprint('4. Review scenario results in Scenario 1, 2, and 3 sheets')\nEOF\n"]
