[95.445265, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Set up SUT Calc sheet\nws_sut = wb['SUT Calc']\n\n# Headers\nws_sut['A1'] = 'SUT Calculation - Import Content Analysis'\nws_sut['A1'].font = openpyxl.styles.Font(bold=True, size=12)\n\nws_sut['A3'] = 'Product Category'\nws_sut['B3'] = 'Supply (SUPPLY)'\nws_sut['C3'] = 'Domestic Supply'\nws_sut['D3'] = 'Use (USE)'\nws_sut['E3'] = 'Imports'\nws_sut['F3'] = 'Import Content %'\n\n# Add product rows (38 categories as per SUT standard)\nfor i in range(1, 39):\n    ws_sut[f'A{i+3}'] = f'Product {i}'\n\n# Add summary row\nws_sut['A43'] = 'TOTAL'\nws_sut['A43'].font = openpyxl.styles.Font(bold=True)\n\n# Add import content share calculation\nws_sut['A46'] = 'Import Content Share (%)'\nws_sut['B46'] = 'Formula will calculate total imports / total use'\n\nwb.save('/root/test - demand.xlsx')\nprint('SUT Calc sheet structure created with 38 product categories')\nEOF\n"]
[95.450307, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Set up SUT Calc sheet\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut = wb['SUT Calc']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Headers\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A1'] = 'SUT Calculation - Import Content Analysis'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A1'].font = openpyxl.styles.Font(bold=True, size=12)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A3'] = 'Product Category'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B3'] = 'Supply (SUPPLY)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['C3'] = 'Domestic Supply'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['D3'] = 'Use (USE)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['E3'] = 'Imports'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['F3'] = 'Import Content %'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add product rows (38 categories as per SUT standard)\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, 39):\r\n\u001b[?2004l\r\u001b[?2004h>     ws_sut[f'A{i+3}'] = f'Product {i}'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add summary row\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A43'] = 'TOTAL'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A43'].font = openpyxl.styles.Font(bold=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add import content share calculation\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A46'] = 'Import Content Share (%)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B46'] = 'Formula will calculate total imports / total use'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('SUT Calc sheet structure created with 38 product categories')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
