[165.272757, "i", "python3 << 'EOF'\nimport openpyxl\nfrom copy import copy\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Rename NA sheet to Scenario 1\nws_na = wb['NA']\nws_na.title = 'Scenario 1'\n\n# Create Scenario 2 by copying Scenario 1\nws_s2 = wb.copy_worksheet(ws_na)\nws_s2.title = 'Scenario 2'\n\n# Create Scenario 3 by copying Scenario 1\nws_s3 = wb.copy_worksheet(ws_na)\nws_s3.title = 'Scenario 3'\n\n# Update assumptions for Scenario 2\n# D32: Demand multiplier = 1.0\nws_s2['D32'] = 1.0\n\n# Update assumptions for Scenario 3\n# D31: Import content share = 50%\nws_s3['D31'] = 50  # 50% instead of calculated value\n\nwb.save('/root/test - demand.xlsx')\nprint('Scenario sheets created:')\nprint('Scenario 1: Original (multiplier=0.8, import content=calculated)')\nprint('Scenario 2: Demand multiplier = 1.0')\nprint('Scenario 3: Import content share = 50%')\nprint('\\nSheet names:', wb.sheetnames)\nEOF\n"]
