[206.883492, "o", "=== FILE STRUCTURE VERIFICATION ===\r\n\r\nSheets in workbook: ['Scenario 1', 'WEO_Data', 'SUPPLY', 'USE', 'SUT Calc', 'Scenario 2', 'Scenario 3']\r\n\r\n=== SCENARIO 1 VERIFICATION ===\r\n"]
[206.883565, "o", "Title: (empty)\r\nHeaders present: Row 1-2 contain headers\r\nYears: 2020-2042 (rows 3-25)\r\nAssumptions D30-D33:\r\n  D30 (Total Investment): 6500\r\n  D31 (Import Content): ='SUT Calc'!C46\r\n  D32 (Multiplier): 0.8\r\nSample formulas:\r\n  C3: ='WEO_Data'!C4\r\n  E9: =D9*$D$30/100\r\n"]
[206.883602, "o", "  K3: =IF(C3=0,J3,J3+(G3*H3/C3)*100)\r\n\r\n=== WEO_DATA VERIFICATION ===\r\nHeaders: Year, Real GDP, Nominal GDP, GDP Deflator, Growth Rate, Deflator Growth\r\n"]
[206.883632, "o", "Years: 2020-2043 (rows 4-27)\r\nSample data:\r\n  2020 Real GDP Growth: -3.1%\r\n  2024 GDP Deflator: 124.1\r\n"]
[206.883667, "o", "Sample formulas:\r\n  F5 (Deflator Growth): =(D5/D4-1)*100\r\n  F9 (2025 Deflator Growth): =AVERAGE(F5:F8)\r\n"]
[206.883699, "o", "\r\n=== SUT CALC VERIFICATION ===\r\nProduct categories: 38 (rows 4-41)\r\nLinking formulas: B4 = ='SUPPLY'!B3\r\n"]
[206.883736, "o", "Total row (43): B43=None, E43==SUM(E4:E41)\r\nImport content share formula (C46): =IF(D43=0,0,(E43/D43)*100)\r\n"]
[206.883773, "o", "\r\n=== SCENARIO 2 VERIFICATION ===\r\nD32 (Multiplier): 1\r\n"]
[206.883806, "o", "D31 (Import Content): ='SUT Calc'!C46\r\n\r\n=== SCENARIO 3 VERIFICATION ===\r\nD32 (Multiplier): 0.8\r\nD31 (Import Content): 50\r\n"]
[206.883837, "o", "\r\n=== FILE STATUS ===\r\nAll sheets created and linked\r\nAll formulas in place\r\nFile ready for use\r\n"]
[206.915121, "o", "\u001b[?2004hroot@b846c53d8222:~# "]
[215.536723, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_sut = wb['SUT Calc']\n\n# Fix the sum formula for column B (Domestic Supply)\nws_sut['B43'] = '=SUM(B4:B41)'\nws_sut['C43'] = '=SUM(C4:C41)'\nws_sut['D43'] = '=SUM(D4:D41)'\n\n# Verify and fix linking formulas if needed\nprint('Checking SUT Calc linking formulas:')\nfor i in range(1, 5):\n    row = i + 3\n    print(f'Row {row}:')\n    print(f'  B{row}: {ws_sut[f\"B{row}\"].value}')\n    print(f'  D{row}: {ws_sut[f\"D{row}\"].value}')\n    print(f'  E{row}: {ws_sut[f\"E{row}\"].value}')\n\nwb.save('/root/test - demand.xlsx')\nprint('\\nFixed SUT Calc sum formulas')\nEOF\n"]
