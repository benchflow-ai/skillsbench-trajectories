[175.134234, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Check Scenario 1 D31 formula\nws_s1 = wb['Scenario 1']\nprint('Scenario 1 - Assumptions:')\nprint(f'D30 (Total Investment): {ws_s1[\"D30\"].value}')\nprint(f'D31 (Import Content Share): {ws_s1[\"D31\"].value}')\nprint(f'D32 (Demand Multiplier): {ws_s1[\"D32\"].value}')\nprint(f'D33 (Project Allocation): {ws_s1[\"D33\"].value}')\n\n# Check Scenario 2\nws_s2 = wb['Scenario 2']\nprint('\\nScenario 2 - Assumptions:')\nprint(f'D30 (Total Investment): {ws_s2[\"D30\"].value}')\nprint(f'D31 (Import Content Share): {ws_s2[\"D31\"].value}')\nprint(f'D32 (Demand Multiplier): {ws_s2[\"D32\"].value}')\n\n# Check Scenario 3\nws_s3 = wb['Scenario 3']\nprint('\\nScenario 3 - Assumptions:')\nprint(f'D30 (Total Investment): {ws_s3[\"D30\"].value}')\nprint(f'D31 (Import Content Share): {ws_s3[\"D31\"].value}')\nprint(f'D32 (Demand Multiplier): {ws_s3[\"D32\"].value}')\n\n# Check a sample formula from Scenario 1\nprint('\\nScenario 1 - Sample formulas:')\nprint(f'C3 (Real GDP): {ws_s1[\"C3\"].value}')\nprint(f'D9 (Project Allocation %): {ws_s1[\"D9\"].value}')\nprint(f'E9 (Project Investment): {ws_s1[\"E9\"].value}')\nprint(f'F9 (Imports): {ws_s1[\"F9\"].value}')\nEOF\n"]
[175.147688, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check Scenario 1 D31 formula\r\n\u001b[?2004l\r\u001b[?2004h> ws_s1 = wb['Scenario 1']\r\n\u001b[?2004l\r\u001b[?2004h> print('Scenario 1 - Assumptions:')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D30 (Total Investment): {ws_s1[\"D30\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D31 (Import Content Share): {ws_s1[\"D31\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D32 (Demand Multiplier): {ws_s1[\"D32\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D33 (Project Allocation): {ws_s1[\"D33\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check Scenario 2\r\n\u001b[?2004l\r\u001b[?2004h> ws_s2 = wb['Scenario 2']\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nScenario 2 - Assumptions:')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D30 (Total Investment): {ws_s2[\"D30\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D31 (Import Content Share): {ws_s2[\"D31\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D32 (Demand Multiplier): {ws_s2[\"D32\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check Scenario 3\r\n\u001b[?2004l\r\u001b[?2004h> ws_s3 = wb['Scenario 3']\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nScenario 3 - Assumptions:')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D30 (Total Investment): {ws_s3[\"D30\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D31 (Import Content Share): {ws_s3[\"D31\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D32 (Demand Multiplier): {ws_s3[\"D32\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check a sample formula from Scenario 1\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nScenario 1 - Sample formulas:')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'C3 (Real GDP): {ws_s1[\"C3\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'D9 (Project Allocation %): {ws_s1[\"D9\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'E9 (Project Investment): {ws_s1[\"E9\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'F9 (Imports): {ws_s1[\"F9\"].value}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[175.400095, "o", "Scenario 1 - Assumptions:\r\nD30 (Total Investment): 6500\r\nD31 (Import Content Share): ='SUT Calc'!C46\r\nD32 (Demand Multiplier): 0.8\r\nD33 (Project Allocation): Bell shape (2026-2033)\r\n\r\nScenario 2 - Assumptions:\r\n"]
[175.400495, "o", "D30 (Total Investment): 6500\r\nD31 (Import Content Share): ='SUT Calc'!C46\r\nD32 (Demand Multiplier): 1\r\n\r\nScenario 3 - Assumptions:\r\nD30 (Total Investment): 6500\r\nD31 (Import Content Share): 50\r\nD32 (Demand Multiplier): 0.8\r\n\r\nScenario 1 - Sample formulas:\r\nC3 (Real GDP): ='WEO_Data'!C4\r\nD9 (Project Allocation %): 5\r\nE9 (Project Investment): =D9*$D$30/100\r\nF9 (Imports): =E9*$D$31/100\r\n"]
