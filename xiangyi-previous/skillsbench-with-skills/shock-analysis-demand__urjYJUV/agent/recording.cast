[50.548845, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.styles import Font, PatternFill\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws = wb['WEO_Data']\n\n# Set up WEO_Data sheet headers\nws['A1'] = 'WEO Data - Georgia'\nws['A1'].font = Font(bold=True, size=12)\n\nws['A3'] = 'Year'\nws['B3'] = 'Real GDP (2017=100)'\nws['C3'] = 'Nominal GDP (USD millions)'\nws['D3'] = 'GDP Deflator (2017=100)'\nws['E3'] = 'GDP Growth Rate (%)'\nws['F3'] = 'Deflator Growth Rate (%)'\n\n# Add years from 2020 to 2043\nfor i, year in enumerate(range(2020, 2044)):\n    ws[f'A{i+4}'] = year\n\nwb.save('/root/test - demand.xlsx')\nprint('WEO_Data sheet structure created')\nprint('Years 2020-2043 added')\nEOF\n"]
[50.549094, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[50.549198, "o", "\u001b[?2004h> "]
