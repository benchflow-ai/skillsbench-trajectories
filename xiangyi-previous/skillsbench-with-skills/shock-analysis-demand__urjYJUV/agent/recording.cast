[104.427415, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# Set up SUPPLY sheet\nws_supply = wb['SUPPLY']\nws_supply['A1'] = 'Supply Table (38x38)'\nws_supply['A2'] = 'Product'\nws_supply['B2'] = 'Domestic Supply'\nws_supply['C2'] = 'Imports'\n\nfor i in range(1, 39):\n    ws_supply[f'A{i+2}'] = f'Product {i}'\n    # Add placeholder for data - these would be populated from geostat\n    ws_supply[f'B{i+2}'] = 0\n    ws_supply[f'C{i+2}'] = 0\n\n# Set up USE sheet\nws_use = wb['USE']\nws_use['A1'] = 'Use Table (38x38)'\nws_use['A2'] = 'Product'\nws_use['B2'] = 'Domestic Use'\nws_use['C2'] = 'Imports Used'\n\nfor i in range(1, 39):\n    ws_use[f'A{i+2}'] = f'Product {i}'\n    # Add placeholder for data - these would be populated from geostat\n    ws_use[f'B{i+2}'] = 0\n    ws_use[f'C{i+2}'] = 0\n\nwb.save('/root/test - demand.xlsx')\nprint('SUPPLY and USE sheets created with 38 product structure')\nEOF\n"]
