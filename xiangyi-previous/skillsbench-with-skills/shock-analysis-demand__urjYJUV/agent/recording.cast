[136.23736, "o", "root@b846c53d8222:~# "]
[146.596597, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_na = wb['NA']\n\n# Create formulas for rows 3-25 (years 2020-2042)\nfor row in range(3, 26):\n    # Column E: Project Investment = (D/100) * Total Investment\n    # Convert percentage to amount: D{row}% of $D$30\n    ws_na[f'E{row}'] = f'=D{row}*$D$30/100'\n    \n    # Column F: Imports = Project Investment * Import Content Share\n    # E{row} * (D31/100) - import content share is in percentage\n    ws_na[f'F{row}'] = f'=E{row}*$D$31/100'\n    \n    # Column G: GDP impact (I-M) = Project Investment - Imports\n    ws_na[f'G{row}'] = f'=E{row}-F{row}'\n    \n    # Column H: Multiplier (just reference the assumption)\n    ws_na[f'H{row}'] = f'=$D$32'\n    \n    # Column I: % of GDP = (GDP impact / Real GDP) * 100\n    # Need to handle division by zero\n    ws_na[f'I{row}'] = f'=IF(C{row}=0,0,(G{row}/C{row})*100)'\n    \n    # Column K: Projected Growth = Baseline Growth + Impact\n    # Impact = (GDP impact * Multiplier / Real GDP) * 100\n    ws_na[f'K{row}'] = f'=IF(C{row}=0,J{row},J{row}+(G{row}*H{row}/C{row})*100)'\n\nwb.save('/root/test - demand.xlsx')\nprint('Calculation formulas created for all rows')\nprint('Column E: Project Investment (Allocation % × Total Investment)')\nprint('Column F: Imports (Investment × Import Content Share)')\nprint('Column G: GDP impact (Investment - Imports)')\nprint('Column H: Multiplier')\nprint('Column I: % of GDP')\nprint('Column K: Projected Growth')\nEOF\n"]
[146.602276, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> ws_na = wb['NA']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create formulas for rows 3-25 (years 2020-2042)\r\n\u001b[?2004l\r\u001b[?2004h> for row in range(3, 26):\r\n\u001b[?2004l\r\u001b[?2004h>     # Column E: Project Investment = (D/100) * Total Investment\r\n\u001b[?2004l\r\u001b[?2004h>     # Convert percentage to amount: D{row}% of $D$30\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'E{row}'] = f'=D{row}*$D$30/100'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Column F: Imports = Project Investment * Import Content Share\r\n\u001b[?2004l\r\u001b[?2004h>     # E{row} * (D31/100) - import content share is in percentage\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'F{row}'] = f'=E{row}*$D$31/100'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Column G: GDP impact (I-M) = Project Investment - Imports\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'G{row}'] = f'=E{row}-F{row}'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Column H: Multiplier (just reference the assumption)\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'H{row}'] = f'=$D$32'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Column I: % of GDP = (GDP impact / Real GDP) * 100\r\n\u001b[?2004l\r\u001b[?2004h>     # Need to handle division by zero\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'I{row}'] = f'=IF(C{row}=0,0,(G{row}/C{row})*100)'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Column K: Projected Growth = Baseline Growth + Impact\r\n\u001b[?2004l\r\u001b[?2004h>     # Impact = (GDP impact * Multiplier / Real GDP) * 100\r\n\u001b[?2004l\r\u001b[?2004h>     ws_na[f'K{row}'] = f'=IF(C{row}=0,J{row},J{row}+(G{row}*H{row}/C{row})*100)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('Calculation formulas created for all rows')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column E: Project Investment (Allocation % × Total Investment)')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column F: Imports (Investment × Import Content Share)')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column G: GDP impact (Investment - Imports)')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column H: Multiplier')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column I: % of GDP')\r\n\u001b[?2004l\r\u001b[?2004h> print('Column K: Projected Growth')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[146.975928, "o", "Calculation formulas created for all rows\r\nColumn E: Project Investment (Allocation % × Total Investment)\r\nColumn F: Imports (Investment × Import Content Share)\r\nColumn G: GDP impact (Investment - Imports)\r\nColumn H: Multiplier\r\nColumn I: % of GDP\r\nColumn K: Projected Growth\r\n"]
[147.020512, "o", "\u001b[?2004hroot@b846c53d8222:~# "]
[155.918465, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\n\n# First, create formulas in SUT Calc for import content calculation\nws_sut = wb['SUT Calc']\n\n# Add total formulas in row 43 (TOTAL row)\n# Sum of imports and use\nws_sut['E43'] = '=SUM(E4:E41)'  # Total imports\nws_sut['D43'] = '=SUM(D4:D41)'  # Total use\n\n# Import content share formula in C46\n# Import Content Share = Total Imports / Total Use * 100\nws_sut['C46'] = '=IF(D43=0,0,(E43/D43)*100)'\n\n# Add label\nws_sut['A46'] = 'Import Content Share (%)'\n\nwb.save('/root/test - demand.xlsx')\nprint('SUT Calc import content share formula created in C46')\nprint('Formula: =IF(D43=0,0,(E43/D43)*100)')\nEOF\n"]
