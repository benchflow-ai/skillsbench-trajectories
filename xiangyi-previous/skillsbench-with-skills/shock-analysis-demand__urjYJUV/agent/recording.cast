[263.164605, "o", "WEO_Data Sheet - Detailed Review\r\n============================================================\r\n\r\nHeaders (Row 3):\r\nA3: Year\r\nB3: Real GDP (2017=100)\r\n"]
[263.164799, "o", "C3: Nominal GDP (USD millions)\r\nD3: GDP Deflator (2017=100)\r\nE3: GDP Growth Rate (%)\r\nF3: Deflator Growth Rate (%)\r\n\r\nSample Data (2020-2024):\r\n\r\n2020:\r\n  Real GDP: None\r\n  Nominal GDP (USD millions): 15200\r\n  GDP Deflator: 101.2\r\n  Growth Rate: -3.1%\r\n  Deflator Growth: None\r\n\r\n2021:\r\n  Real GDP: None\r\n  Nominal GDP (USD millions): 16800\r\n  GDP Deflator: 104.5\r\n  Growth Rate: 10.6%\r\n"]
[263.164872, "o", "  Deflator Growth: =(D5/D4-1)*100\r\n\r\n2022:\r\n  Real GDP: None\r\n  Nominal GDP (USD millions): 18900\r\n  GDP Deflator: 112.8\r\n  Growth Rate: 10.1%\r\n  Deflator Growth: =(D6/D5-1)*100\r\n"]
[263.164938, "o", "\r\n2023:\r\n  Real GDP: None\r\n  Nominal GDP (USD millions): 20400\r\n  GDP Deflator: 119.3\r\n  Growth Rate: 7.8%\r\n  Deflator Growth: =(D7/D6-1)*100\r\n"]
[263.164998, "o", "\r\n2024:\r\n  Real GDP: None\r\n  Nominal GDP (USD millions): 21500\r\n  GDP Deflator: 124.1\r\n  Growth Rate: 5.1%\r\n  Deflator Growth: =(D8/D7-1)*100\r\n\r\n"]
[263.165061, "o", "============================================================\r\n\r\nNote: The nominal GDP values (Column C) are in USD millions\r\nExchange rate (Lari/USD): 2.746\r\nThis exchange rate should be used when converting from local currency\r\nif the original data is in Lari.\r\n"]
[263.191514, "o", "\u001b[?2004hroot@b846c53d8222:~# "]
[271.87059, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_weo = wb['WEO_Data']\n\n# Add exchange rate reference\nws_weo['A1'] = 'WEO Data - Georgia'\nws_weo['A2'] = 'Exchange Rate (Lari/USD): 2.746'\n\n# Calculate Real GDP index (Column B) from Nominal GDP / Deflator * 100\n# Real GDP Index = (Nominal GDP / Deflator) * 100\nfor row in range(4, 28):  # 2020-2043\n    # Real GDP = Nominal GDP / Deflator * 100\n    ws_weo[f'B{row}'] = f'=IF(D{row}=0,0,(C{row}/D{row})*100)'\n\nwb.save('/root/test - demand.xlsx')\nprint('Added Real GDP index formulas')\nprint('Formula: Real GDP = (Nominal GDP / Deflator) * 100')\nprint('\\nExchange rate reference added: 2.746 Lari/USD')\nEOF\n"]
