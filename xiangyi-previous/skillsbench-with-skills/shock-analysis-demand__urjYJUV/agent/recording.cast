[124.280575, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_na = wb['NA']\n\n# Fill in assumptions\n# D30: Total Investment in USD millions (6.5 billion USD = 6500 million)\nws_na['D30'] = 6500\n\n# D31: Import content share - will link to SUT Calc later\n# For now, set a placeholder that will be replaced\nws_na['D31'] = \"='SUT Calc'!C46\"  # This will link to calculated import content share\n\n# D32: Demand multiplier\nws_na['D32'] = 0.8\n\n# D33: Project allocation - this is descriptive\nws_na['D33'] = 'Bell shape (2026-2033)'\n\n# Add labels in Column C for clarity\nws_na['C30'] = 'Total Investment (USD millions)'\nws_na['C31'] = 'Import Content Share (%)'\nws_na['C32'] = 'Demand Multiplier'\nws_na['C33'] = 'Project Allocation'\n\nwb.save('/root/test - demand.xlsx')\nprint('Assumptions filled in NA sheet')\nprint('D30: 6500 (USD millions)')\nprint('D31: Linked to SUT Calc import content share')\nprint('D32: 0.8 (demand multiplier)')\nprint('D33: Bell shape allocation')\nEOF\n"]
[124.284884, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> ws_na = wb['NA']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fill in assumptions\r\n\u001b[?2004l\r\u001b[?2004h> # D30: Total Investment in USD millions (6.5 billion USD = 6500 million)\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['D30'] = 6500\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # D31: Import content share - will link to SUT Calc later\r\n\u001b[?2004l\r\u001b[?2004h> # For now, set a placeholder that will be replaced\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['D31'] = \"='SUT Calc'!C46\"  # This will link to calculated import content share\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # D32: Demand multiplier\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['D32'] = 0.8\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # D33: Project allocation - this is descriptive\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['D33'] = 'Bell shape (2026-2033)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add labels in Column C for clarity\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['C30'] = 'Total Investment (USD millions)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['C31'] = 'Import Content Share (%)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['C32'] = 'Demand Multiplier'\r\n\u001b[?2004l\r\u001b[?2004h> ws_na['C33'] = 'Project Allocation'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('Assumptions filled in NA sheet')\r\n\u001b[?2004l\r\u001b[?2004h> print('D30: 6500 (USD millions)')\r\n\u001b[?2004l\r\u001b[?2004h> print('D31: Linked to SUT Calc import content share')\r\n\u001b[?2004l\r\u001b[?2004h> print('D32: 0.8 (demand multiplier)')\r\n\u001b[?2004l\r\u001b[?2004h> print('D33: Bell shape allocation')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
