[194.050051, "o", "\u001b[?2004h"]
[194.050208, "o", "> "]
[194.050437, "o", "# Link SUPPLY data to SUT Calc columns B and C"]
[194.050556, "o", "\r\n"]
[194.050661, "o", "\u001b[?2004l\r"]
[194.050805, "o", "\u001b[?2004h"]
[194.050938, "o", "> "]
[194.051139, "o", "for i in range(1, 39):"]
[194.051271, "o", "\r\n"]
[194.051575, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[194.05163, "o", "    row = i + 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.051929, "o", "    # Column B: Domestic Supply from SUPPLY sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.052072, "o", "    ws_sut[f'B{row}'] = f\"='SUPPLY'!B{i+2}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.052217, "o", "    # Column C: Imports from SUPPLY sheet (or we can use USE for imports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[194.052378, "o", "> "]
[194.052556, "o", "    ws_sut[f'C{row}'] = f\"='SUPPLY'!C{i+2}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.052833, "o", "    # Column D: Use from USE sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.053136, "o", "    ws_sut[f'D{row}'] = f\"='USE'!B{i+2}\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Column E: Imports from USE sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.053331, "o", "    ws_sut[f'E{row}'] = f\"='USE'!C{i+2}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/test - demand.xlsx')\r\n\u001b[?2004l\r"]
[194.053384, "o", "\u001b[?2004h> "]
[194.053601, "o", "print('Fixed sum formulas in SUPPLY and USE sheets (moved to row 43)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.053834, "o", "print('Updated SUT Calc to link to SUPPLY and USE sheets')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
