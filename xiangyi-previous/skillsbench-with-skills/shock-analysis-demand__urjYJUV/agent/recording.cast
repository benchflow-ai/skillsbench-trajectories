[85.147082, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws = wb['WEO_Data']\n\n# Add formulas for Deflator Growth Rate (Column F)\n# For 2021-2024, calculate the growth rate\nfor row in range(5, 9):  # rows 5-8 correspond to 2021-2024\n    ws[f'F{row}'] = f'=(D{row}/D{row-1}-1)*100'\n\n# For 2025 onwards, use 4-year average of previous deflator growth rates\n# Formula for row 9 (2025): average of F5:F8\nws['F9'] = '=AVERAGE(F5:F8)'\n\n# For subsequent years, copy the same 4-year average growth rate\nfor row in range(10, 28):  # rows 10-27 (2026-2043)\n    ws[f'F{row}'] = '=AVERAGE(F5:F8)'\n\n# Calculate GDP Deflator for future years using the growth rate\n# D25 = D24 * (1 + F25/100)\nfor row in range(9, 28):  # rows 9-27 (2025-2043)\n    ws[f'D{row}'] = f'=D{row-1}*(1+F{row}/100)'\n\nwb.save('/root/test - demand.xlsx')\nprint('Deflator formulas created')\nprint('Deflator extended for 2025-2043 using 4-year average growth rate')\nEOF\n"]
