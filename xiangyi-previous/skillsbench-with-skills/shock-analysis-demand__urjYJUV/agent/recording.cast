[241.006223, "o", "\r\n\r\n1. WORKBOOK STRUCTURE"]
[241.006401, "o", "\r\n   Sheets: ['Scenario 1', 'WEO_Data', 'SUPPLY', 'USE', 'SUT Calc', 'Scenario 2', 'Scenario 3']\r\n   Total sheets: 7\r\n\r\n2. WEO_DATA SHEET\r\n   Title: WEO Data - Georgia\r\n   Headers: Year, Real GDP, Nominal GDP, GDP Deflator, Growth Rate, Deflator Growth\r\n   Data range: 2020-2043 (24 years)\r\n   Key formulas:\r\n"]
