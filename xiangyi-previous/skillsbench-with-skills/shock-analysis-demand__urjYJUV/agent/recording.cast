[135.669987, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test - demand.xlsx')\nws_na = wb['NA']\n\n# Create bell-shape allocation for 2026-2033 (8 years)\n# Years 2026-2033 are in rows 9-16\n# Bell shape: peak in middle (2029-2030, rows 12-13)\n# Using triangular distribution: 0%, 10%, 20%, 25%, 25%, 20%, 10%, 5% for years 2026-2033\n\nallocation_percentages = {\n    9: 5,      # 2026: 5%\n    10: 10,    # 2027: 10%\n    11: 15,    # 2028: 15%\n    12: 20,    # 2029: 20%\n    13: 20,    # 2030: 20%\n    14: 15,    # 2031: 15%\n    15: 10,    # 2032: 10%\n    16: 5,     # 2033: 5%\n}\n\n# Fill allocation percentages\nfor row, pct in allocation_percentages.items():\n    ws_na[f'D{row}'] = pct\n\n# For other years (2020-2025, 2034-2042), allocation is 0\nfor row in range(3, 9):  # 2020-2025\n    ws_na[f'D{row}'] = 0\nfor row in range(17, 26):  # 2034-2042\n    ws_na[f'D{row}'] = 0\n\nwb.save('/root/test - demand.xlsx')\nprint('Bell-shape allocation created for 2026-2033')\nprint('Allocation: 5%, 10%, 15%, 20%, 20%, 15%, 10%, 5%')\nEOF\n"]
