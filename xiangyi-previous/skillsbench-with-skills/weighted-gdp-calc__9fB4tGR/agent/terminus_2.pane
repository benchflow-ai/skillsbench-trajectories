Step 1 formulas saved!
[?2004hroot@b769f59607db:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('gdp.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> cols = ['H', 'I', 'J', 'K', 'L']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Net exports as % of GDP in H35:L40
[?2004l[?2004h> # Net Exports % of GDP = (Exports - Imports) / GDP * 100
[?2004l[?2004h> # Row mapping:
[?2004l[?2004h> # 35 -> UAE: exports row 12, imports row 19, GDP row 26
[?2004l[?2004h> # 36 -> Bahrain: exports row 13, imports row 20, GDP row 27
[?2004l[?2004h> # 37 -> Kuwait: exports row 14, imports row 21, GDP row 28
[?2004l[?2004h> # 38 -> Qatar: exports row 15, imports row 22, GDP row 29
[?2004l[?2004h> # 39 -> Oman: exports row 16, imports row 23, GDP row 30
[?2004l[?2004h> # 40 -> Saudi Arabia: exports row 17, imports row 24, GDP row 31
[?2004l[?2004h> 
[?2004l[?2004h> row_mapping = {
[?2004l[?2004h>     35: (12, 19, 26),  # UAE
[?2004l[?2004h>     36: (13, 20, 27),  # Bahrain
[?2004l[?2004h>     37: (14, 21, 28),  # Kuwait
[?2004l[?2004h>     38: (15, 22, 29),  # Qatar
[?2004l[?2004h>     39: (16, 23, 30),  # Oman
[?2004l[?2004h>     40: (17, 24, 31),  # Saudi Arabia
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Step 2: Net Exports as % of GDP ===")
[?2004l[?2004h> for row in range(35, 41):
[?2004l[?2004h>     exp_row, imp_row, gdp_row = row_mapping[row]
[?2004l[?2004h>     for col in cols:
[?2004l[?2004h>         # Formula: (Exports - Imports) / GDP * 100
[?2004l[?2004h>         formula = f'=({col}{exp_row}-{col}{imp_row})/{col}{gdp_row}*100'
[?2004l[?2004h>         task_sheet[f'{col}{row}'] = formula
[?2004l[?2004h>         print(f'{col}{row}: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Step 2: Statistics ===")
[?2004l[?2004h> # Row 42: min
[?2004l[?2004h> # Row 43: max
[?2004l[?2004h> # Row 44: median
[?2004l[?2004h> # Row 45: simple mean (AVERAGE)
[?2004l[?2004h> # Row 46: 25th percentile
[?2004l[?2004h> # Row 47: 75th percentile
[?2004l[?2004h> 
[?2004l[?2004h> for col in cols:
[?2004l[?2004h>     # MIN
[?2004l[?2004h>     formula = f'=MIN({col}35:{col}40)'
[?2004l[?2004h>     task_sheet[f'{col}42'] = formula
[?2004l[?2004h>     print(f'{col}42: {formula}')
[?2004l[?2004h>     
[?2004l[?2004h>     # MAX
[?2004l[?2004h>     formula = f'=MAX({col}35:{col}40)'
[?2004l[?2004h>     task_sheet[f'{col}43'] = formula
[?2004l[?2004h>     print(f'{col}43: {formula}')
[?2004l[?2004h>     
[?2004l[?2004h>     # MEDIAN
[?2004l[?2004h>     formula = f'=MEDIAN({col}35:{col}40)'
[?2004l[?2004h>     task_sheet[f'{col}44'] = formula
[?2004l[?2004h>     print(f'{col}44: {formula}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Simple mean (AVERAGE)
[?2004l[?2004h>     formula = f'=AVERAGE({col}35:{col}40)'
[?2004l[?2004h>     task_sheet[f'{col}45'] = formula
[?2004l[?2004h>     print(f'{col}45: {formula}')
[?2004l[?2004h>     
[?2004l[?2004h>     # 25th percentile
[?2004l[?2004h>     formula = f'=PERCENTILE({col}35:{col}40,0.25)'
[?2004l[?2004h>     task_sheet[f'{col}46'] = formula
[?2004l[?2004h>     print(f'{col}46: {formula}')
[?2004l[?2004h>     
[?2004l[?2004h>     # 75th percentile
[?2004l[?2004h>     formula = f'=PERCENTILE({col}35:{col}40,0.75)'
[?2004l[?2004h>     task_sheet[f'{col}47'] = formula
[?2004l[?2004h>     print(f'{col}47: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== Step 3: Weighted Mean using SUMPRODUCT ===")
[?2004l[?2004h> # Weighted mean = SUMPRODUCT(net_exports_pct * GDP) / SUM(GDP)
[?2004l[?2004h> # This weights each country's net exports % by their GDP
[?2004l[?2004h> for col in cols:
[?2004l[?2004h>     # SUMPRODUCT formula: sum of (net exports % * GDP) / sum of GDP
[?2004l[?2004h>     # Net exports % is in rows 35-40, GDP is in rows 26-31
[?2004l[?2004h>     formula = f'=SUMPRODUCT({col}35:{col}40,{col}26:{col}31)/SUM({col}26:{col}31)'
[?2004l[?2004h>     task_sheet[f'{col}50'] = formula
[?2004l[?2004h>     print(f'{col}50: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> # Save the workbook
[?2004l[?2004h> wb.save('gdp.xlsx')
[?2004l[?2004h> print("\nAll formulas saved!")
[?2004l[?2004h> wb.close()
[?2004l[?2004h> EOF
