[?2004hroot@b769f59607db:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('gdp.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Add INDEX-MATCH formulas for data lookup
[?2004l[?2004h> # The formula pattern: =INDEX(Data!$H$21:$M$40, MATCH($D{row}, Data!$B$21:$B$40, 0), MATCH({col}$9, Data!$H$4:$M$4, 0))
[?2004l[?2004h> 
[?2004l[?2004h> # Columns H to L correspond to columns 8 to 12
[?2004l[?2004h> cols = ['H', 'I', 'J', 'K', 'L']
[?2004l[?2004h> 
[?2004l[?2004h> # H12:L17 - Exports (rows 12-17)
[?2004l[?2004h> for row in range(12, 18):
[?2004l[?2004h>     for col in cols:
[?2004l[?2004h>         formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'
[?2004l[?2004h>         task_sheet[f'{col}{row}'] = formula
[?2004l[?2004h>         print(f'{col}{row}: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n--- Exports formulas added ---\n")
[?2004l[?2004h> 
[?2004l[?2004h> # H19:L24 - Imports (rows 19-24)
[?2004l[?2004h> for row in range(19, 25):
[?2004l[?2004h>     for col in cols:
[?2004l[?2004h>         formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'
[?2004l[?2004h>         task_sheet[f'{col}{row}'] = formula
[?2004l[?2004h>         print(f'{col}{row}: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n--- Imports formulas added ---\n")
[?2004l[?2004h> 
[?2004l[?2004h> # H26:L31 - GDP (rows 26-31)
[?2004l[?2004h> for row in range(26, 32):
[?2004l[?2004h>     for col in cols:
[?2004l[?2004h>         formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'
[?2004l[?2004h>         task_sheet[f'{col}{row}'] = formula
[?2004l[?2004h>         print(f'{col}{row}: {formula}')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n--- GDP formulas added ---\n")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the workbook
[?2004l[?2004h> wb.save('gdp.xlsx')
[?2004l[?2004h> print("Step 1 formulas saved!")
[?2004l[?2004h> wb.close()
