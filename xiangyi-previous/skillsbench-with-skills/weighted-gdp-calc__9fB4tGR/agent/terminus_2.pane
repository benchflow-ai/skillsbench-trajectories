[?2004l[?2004h> print("=== Data Sheet Headers ===")
[?2004l[?2004h> 
[?2004l[?2004h> # Print first few rows to understand structure
[?2004l[?2004h> for row in range(1, 5):
[?2004l[?2004h>     row_data = []
[?2004l[?2004h>     for col in range(1, 20):  # Columns A to S
[?2004l[?2004h>         cell = data_sheet.cell(row=row, column=col)
