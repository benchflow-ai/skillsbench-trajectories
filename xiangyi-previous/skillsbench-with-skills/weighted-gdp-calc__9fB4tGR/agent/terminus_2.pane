[?2004l[?2004h> 
[?2004l[?2004h> # Count formulas in each range
[?2004l[?2004h> ranges_to_check = [
[?2004l[?2004h>     ('H12:L17', 'Exports lookup'),
[?2004l[?2004h>     ('H19:L24', 'Imports lookup'),
[?2004l[?2004h>     ('H26:L31', 'GDP lookup'),
[?2004l[?2004h>     ('H35:L40', 'Net exports % GDP'),
[?2004l[?2004h>     ('H42:L47', 'Statistics'),
[?2004l[?2004h>     ('H50:L50', 'Weighted mean')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> for range_str, desc in ranges_to_check:
[?2004l[?2004h>     start, end = range_str.split(':')
[?2004l[?2004h>     start_col = start[0]
[?2004l[?2004h>     start_row = int(start[1:])
[?2004l[?2004h>     end_col = end[0]
[?2004l[?2004h>     end_row = int(end[1:])
[?2004l[?2004h>     
[?2004l[?2004h>     formula_count = 0
[?2004l[?2004h>     for row in range(start_row, end_row + 1):
[?2004l[?2004h>         for col in range(ord(start_col) - ord('A') + 1, ord(end_col) - ord('A') + 2):
[?2004l[?2004h>             cell = task_sheet.cell(row=row, column=col)
[?2004l[?2004h>             if cell.value and str(cell.value).startswith('='):
[?2004l[?2004h>                 formula_count += 1
[?2004l[?2004h>     
[?2004l[?2004h>     expected = (end_row - start_row + 1) * (ord(end_col) - ord(start_col) + 1)
[?2004l[?2004h>     status = "✓" if formula_count == expected else "✗"
[?2004l[?2004h>     print(f"{status} {range_str} ({desc}): {formula_count}/{expected} formulas")
[?2004l[?2004h> 
[?2004l[?2004h> wb.close()
