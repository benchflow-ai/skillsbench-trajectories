[20.66737, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('gdp.xlsx')\n\n# List all sheets\nprint(\"Sheets:\", wb.sheetnames)\n\n# Examine the Data sheet structure\ndata_sheet = wb['Data']\nprint(\"\\n=== Data Sheet ===\")\nprint(f\"Dimensions: {data_sheet.dimensions}\")\n\n# Print rows 21-40 to see the relevant data\nprint(\"\\nRows 21-40 (relevant data):\")\nfor row in range(21, 41):\n    row_data = []\n    for col in range(1, 15):  # Columns A to N\n        cell = data_sheet.cell(row=row, column=col)\n        val = cell.value\n        if val is not None:\n            row_data.append(f\"{col}:{val}\")\n    if row_data:\n        print(f\"Row {row}: {row_data}\")\n\nwb.close()\nEOF\n"]
