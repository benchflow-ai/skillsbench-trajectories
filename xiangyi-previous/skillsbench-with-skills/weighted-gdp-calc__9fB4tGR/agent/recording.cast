[50.466252, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('gdp.xlsx')\n\n# Examine the Data sheet header row\ndata_sheet = wb['Data']\nprint(\"=== Data Sheet Headers ===\")\n\n# Print first few rows to understand structure\nfor row in range(1, 5):\n    row_data = []\n    for col in range(1, 20):  # Columns A to S\n        cell = data_sheet.cell(row=row, column=col)\n        val = cell.value\n        if val is not None:\n            row_data.append(f\"{openpyxl.utils.get_column_letter(col)}{row}:{val}\")\n    if row_data:\n        print(f\"Row {row}: {row_data}\")\n\n# Also check row 10 if it has years\nprint(\"\\nRow 10:\")\nfor col in range(1, 20):\n    cell = data_sheet.cell(row=10, column=col)\n    val = cell.value\n    if val is not None:\n        print(f\"{openpyxl.utils.get_column_letter(col)}10: {val}\")\n\nwb.close()\nEOF\n"]
