[69.387496, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\n# Step 1: Add INDEX-MATCH formulas for data lookup\n# The formula pattern: =INDEX(Data!$H$21:$M$40, MATCH($D{row}, Data!$B$21:$B$40, 0), MATCH({col}$9, Data!$H$4:$M$4, 0))\n\n# Columns H to L correspond to columns 8 to 12\ncols = ['H', 'I', 'J', 'K', 'L']\n\n# H12:L17 - Exports (rows 12-17)\nfor row in range(12, 18):\n    for col in cols:\n        formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'\n        task_sheet[f'{col}{row}'] = formula\n        print(f'{col}{row}: {formula}')\n\nprint(\"\\n--- Exports formulas added ---\\n\")\n\n# H19:L24 - Imports (rows 19-24)\nfor row in range(19, 25):\n    for col in cols:\n        formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'\n        task_sheet[f'{col}{row}'] = formula\n        print(f'{col}{row}: {formula}')\n\nprint(\"\\n--- Imports formulas added ---\\n\")\n\n# H26:L31 - GDP (rows 26-31)\nfor row in range(26, 32):\n    for col in cols:\n        formula = f'=INDEX(Data!$H$21:$M$40,MATCH($D{row},Data!$B$21:$B$40,0),MATCH({col}$9,Data!$H$4:$M$4,0))'\n        task_sheet[f'{col}{row}'] = formula\n        print(f'{col}{row}: {formula}')\n\nprint(\"\\n--- GDP formulas added ---\\n\")\n\n# Save the workbook\nwb.save('gdp.xlsx')\nprint(\"Step 1 formulas saved!\")\nwb.close()\nEOF\n"]
