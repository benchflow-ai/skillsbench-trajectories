[95.479427, "o", "        print(f'{col}{row}: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.479538, "o", "print(\"\\n=== Step 2: Statistics ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.479793, "o", "# Row 42: min\r\n\u001b[?2004l\r\u001b[?2004h> # Row 43: max\r\n\u001b[?2004l\r"]
[95.481257, "o", "\u001b[?2004h> # Row 44: median\r\n\u001b[?2004l\r\u001b[?2004h> # Row 45: simple mean (AVERAGE)\r\n\u001b[?2004l\r\u001b[?2004h> # Row 46: 25th percentile\r\n\u001b[?2004l\r\u001b[?2004h> # Row 47: 75th percentile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.481378, "o", "for col in cols:\r\n\u001b[?2004l\r\u001b[?2004h>     # MIN\r\n\u001b[?2004l\r\u001b[?2004h>     formula = f'=MIN({col}35:{col}40)'\r\n\u001b[?2004l\r\u001b[?2004h>     task_sheet[f'{col}42'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}42: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # MAX\r\n\u001b[?2004l\r\u001b[?2004h>     formula = f'=MAX({col}35:{col}40)'\r\n\u001b[?2004l\r\u001b[?2004h>     task_sheet[f'{col}43'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}43: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # MEDIAN\r\n\u001b[?2004l\r\u001b[?2004h>     formula = f'=MEDIAN({col}35:{col}40)'\r\n\u001b[?2004l\r\u001b[?2004h>     task_sheet[f'{col}44'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}44: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Simple mean (AVERAGE)\r\n\u001b[?2004l\r\u001b[?2004h>     formula = f'=AVERAGE({col}35:{col}40)'\r\n\u001b[?2004l\r\u001b[?2004h>     task_sheet[f'{col}45'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}45: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 25th percentile\r\n\u001b[?2004l\r"]
[95.481759, "o", "\u001b[?2004h>     formula = f'=PERCENTILE({col}35:{col}40,0.25)'\r\n\u001b[?2004l\r\u001b[?2004h>     task_sheet[f'{col}46'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}46: {formula}')\r\n\u001b[?2004l\r"]
[95.481983, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 75th percentile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.482016, "o", "    formula = f'=PERCENTILE({col}35:{col}40,0.75)'\r\n\u001b[?2004l\r"]
[95.482196, "o", "\u001b[?2004h> "]
[95.482532, "o", "    task_sheet[f'{col}47'] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{col}47: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.482642, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== Step 3: Weighted Mean using SUMPRODUCT ===\")\r\n\u001b[?2004l\r\u001b[?2004h> # Weighted mean = SUMPRODUCT(net_exports_pct * GDP) / SUM(GDP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.482734, "o", "# This weights each country's net exports % by their GDP\r\n\u001b[?2004l\r\u001b[?2004h> for col in cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.482819, "o", "    # SUMPRODUCT formula: sum of (net exports % * GDP) / sum of GDP\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.482882, "o", "> "]
[95.482912, "o", "    # Net exports % is in rows 35-40, GDP is in rows 26-31\r\n\u001b[?2004l\r"]
[95.48294, "o", "\u001b[?2004h> "]
[95.483106, "o", "    formula = f'=SUMPRODUCT({col}35:{col}40,{col}26:{col}31)/SUM({col}26:{col}31)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.48317, "o", "    task_sheet[f'{col}50'] = formula\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.486255, "o", "    print(f'{col}50: {formula}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save the workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('gdp.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nAll formulas saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[96.048508, "o", "=== Step 2: Net Exports as % of GDP ==="]
[96.056436, "o", "\r\nH35: =(H12-H19)/H26*100\r\nI35: =(I12-I19)/I26*100\r\nJ35: =(J12-J19)/J26*100\r\nK35: =(K12-K19)/K26*100\r\nL35: =(L12-L19)/L26*100\r\nH36: =(H13-H20)/H27*100\r\nI36: =(I13-I20)/I27*100\r\nJ36: =(J13-J20)/J27*100\r\nK36: =(K13-K20)/K27*100\r\nL36: =(L13-L20)/L27*100\r\nH37: =(H14-H21)/H28*100\r\nI37: =(I14-I21)/I28*100\r\nJ37: =(J14-J21)/J28*100\r\nK37: =(K14-K21)/K28*100\r\nL37: =(L14-L21)/L28*100\r\nH38: =(H15-H22)/H29*100\r\nI38: =(I15-I22)/I29*100\r\nJ38: =(J15-J22)/J29*100\r\nK38: =(K15-K22)/K29*100\r\nL38: =(L15-L22)/L29*100\r\nH39: =(H16-H23)/H30*100\r\nI39: =(I16-I23)/I30*100\r\nJ39: =(J16-J23)/J30*100\r\nK39: =(K16-K23)/K30*100\r\nL39: =(L16-L23)/L30*100\r\nH40: =(H17-H24)/H31*100\r\nI40: =(I17-I24)/I31*100\r\nJ40: =(J17-J24)/J31*100\r\nK40: =(K17-K24)/K31*100\r\nL40: =(L17-L24)/L31*100\r\n\r\n=== Step 2: Statistics ===\r\nH42: =MIN(H35:H40)\r\nH43: =MAX(H35:H40)\r\nH44: =MEDIAN(H35:H40)\r\nH45: =AVERAGE(H35:H40)\r\nH46: =PERCENTILE(H35:H40,0.25)\r\nH47: =PERCENTILE(H35:H40,0.75)\r\nI42: =MIN(I35:I40)\r\nI43: =MAX(I35:I40)\r\nI44: =MEDIAN(I35:I40)\r\nI45: =AVERAGE(I35:I40)\r\nI46: =PERCENTILE(I35:I40,0.25)\r\nI47: =PERCENTILE(I35:I40,0.75)\r\nJ42: =MIN(J35:J40)\r\nJ43: =MAX(J35:J40)\r\nJ44: =MEDIAN(J35:J40)\r\nJ45: =AVERAGE(J35:J40)\r\nJ46: =PERCENTILE(J35:J40,0.25)\r\nJ47: =PERCENTILE(J35:J40,0.75)\r\nK42: =MIN(K35:K40)\r\nK43: =MAX(K35:K40)\r\nK44: =MEDIAN(K35:K40)\r\nK45: =AVERAGE(K35:K40)\r\nK46: =PERCENTILE(K35:K40,0.25)\r\nK47: =PERCENTILE(K35:K40,0.75)\r\nL42: =MIN(L35:L40)\r\nL43: =MAX(L35:L40)\r\nL44: =MEDIAN(L35:L40)\r\nL45: =AVERAGE(L35:L40)\r\nL46: =PERCENTILE(L35:L40,0.25)\r\nL47: =PERCENTILE(L35:L40,0.75)\r\n\r\n=== Step 3: Weighted Mean using SUMPRODUCT ===\r\nH50: =SUMPRODUCT(H35:H40,H26:H31)/SUM(H26:H31)\r\nI50: =SUMPRODUCT(I35:I40,I26:I31)/SUM(I26:I31)\r\nJ50: =SUMPRODUCT(J35:J40,J26:J31)/SUM(J26:J31)\r\nK50: =SUMPRODUCT(K35:K40,K26:K31)/SUM(K26:K31)\r\nL50: =SUMPRODUCT(L35:L40,L26:L31)/SUM(L26:L31)\r\n"]
[97.113349, "o", "\r\nAll formulas saved!\r\n"]
[97.214628, "o", "\u001b[?2004hroot@b769f59607db:~# "]
[115.486564, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load the workbook to verify\nwb = openpyxl.load_workbook('gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== Verification of Formulas ===\")\n\n# Check a sample of cells from each section\nprint(\"\\n--- Step 1: Data Lookup (sample) ---\")\nfor cell in ['H12', 'L17', 'H19', 'L24', 'H26', 'L31']:\n    print(f\"{cell}: {task_sheet[cell].value}\")\n\nprint(\"\\n--- Step 2: Net Exports % of GDP (sample) ---\")\nfor cell in ['H35', 'L40']:\n    print(f\"{cell}: {task_sheet[cell].value}\")\n\nprint(\"\\n--- Step 2: Statistics ---\")\nfor row in range(42, 48):\n    print(f\"H{row}: {task_sheet[f'H{row}'].value}\")\n\nprint(\"\\n--- Step 3: Weighted Mean ---\")\nfor col in ['H', 'I', 'J', 'K', 'L']:\n    print(f\"{col}50: {task_sheet[f'{col}50'].value}\")\n\nprint(\"\\n=== File verification complete ===\")\nwb.close()\nEOF\n"]
