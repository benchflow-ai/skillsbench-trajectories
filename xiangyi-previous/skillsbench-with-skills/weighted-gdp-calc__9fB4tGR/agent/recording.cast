[138.880131, "o", "=== Data Sheet - Row 4 headers ===\r\nA4: Database\r\nB4: Series_code\r\nC4: Country\r\nD4: Indicator\r\nE4: Indicator.Name\r\nF4: Frequency\r\nG4: Scale\r\nH4: 2018\r\nI4: 2019\r\nJ4: 2020\r\nK4: 2021\r\nL4: 2022\r\nM4: 2023\r\n\r\n=== Data Sheet - Column B (Series codes) rows 21-40 ===\r\nB21: 419BXGS_BP6.A\r\nB22: 443BXGS_BP6.A\r\nB23: 449BXGS_BP6.A\r\nB24: 453BXGS_BP6.A\r\nB25: 456BXGS_BP6.A\r\nB26: 466BXGS_BP6.A\r\nB28: 419BMGS_BP6.A\r\nB29: 443BMGS_BP6.A\r\nB30: 449BMGS_BP6.A\r\nB31: 453BMGS_BP6.A\r\nB32: 456BMGS_BP6.A"]
