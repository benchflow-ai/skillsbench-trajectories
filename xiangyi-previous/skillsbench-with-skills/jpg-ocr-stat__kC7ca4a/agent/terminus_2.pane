[?2004l[?2004h> def parse_total_amount(text):
[?2004l[?2004h>     """Extract total amount from OCR text using priority keywords"""
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     
[?2004l[?2004h>     # Exclusion keywords
[?2004l[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority keyword groups (in order of priority)
[?2004l[?2004h>     keyword_groups = [
[?2004l[?2004h>         ['GRAND TOTAL'],
[?2004l[?2004h>         ['TOTAL RM', 'TOTAL: RM'],
[?2004l[?2004h>         ['TOTAL AMOUNT'],
[?2004l[?2004h>         ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],
[?2004l[?2004h>     ]
