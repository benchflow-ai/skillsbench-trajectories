[?2004l[?2004h> 
[?2004l[?2004h> def extract_text_from_image(image_path):
[?2004l[?2004h>     """Extract text from image using Tesseract OCR"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         img = Image.open(image_path)
[?2004l[?2004h>         text = pytesseract.image_to_string(img)
[?2004l[?2004h>         return text
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error processing {image_path}: {e}")
[?2004l[?2004h>         return ""
[?2004l[?2004h> 
[?2004l[?2004h> def parse_date(text):
[?2004l[?2004h>     """Extract date from OCR text and convert to ISO format"""
[?2004l[?2004h>     # Common date patterns
[?2004l[?2004h>     date_patterns = [
[?2004l[?2004h>         r'(\d{4})[-/](\d{1,2})[-/](\d{1,2})',  # YYYY-MM-DD or YYYY/MM/DD
[?2004l[?2004h>         r'(\d{1,2})[-/](\d{1,2})[-/](\d{4})',  # DD-MM-YYYY or DD/MM/YYYY
[?2004l[?2004h>         r'(\d{1,2})\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+(\d{4})',  # DD Mon YYYY
[?2004l[?2004h>         r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+(\d{1,2}),?\s+(\d{4})',  # Mon DD, YYYY
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for pattern in date_patterns:
[?2004l[?2004h>         matches = re.finditer(pattern, text, re.IGNORECASE)
[?2004l[?2004h>         for match in matches:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 groups = match.groups()
[?2004l[?2004h>                 if len(groups) == 3:
[?2004l[?2004h>                     # Try different date format interpretations
[?2004l[?2004h>                     if groups[0].isdigit() and len(groups[0]) == 4:  # YYYY-MM-DD
[?2004l[?2004h>                         date_obj = datetime(int(groups[0]), int(groups[1]), int(groups[2]))
[?2004l[?2004h>                     elif groups[2].isdigit() and len(groups[2]) == 4:  # DD-MM-YYYY
[?2004l[?2004h>                         date_obj = datetime(int(groups[2]), int(groups[1]), int(groups[0]))
[?2004l[?2004h>                     elif not groups[0].isdigit():  # Mon DD YYYY
[?2004l[?2004h>                         month_map = {'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,
[?2004l[?2004h>                                    'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12}
[?2004l[?2004h>                         month = month_map.get(groups[0][:3].lower())
[?2004l[?2004h>                         if month:
[?2004l[?2004h>                             date_obj = datetime(int(groups[2]), month, int(groups[1]))
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             continue
[?2004l[?2004h>                     elif not groups[1].isdigit():  # DD Mon YYYY
[?2004l[?2004h>                         month_map = {'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,
[?2004l[?2004h>                                    'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12}
[?2004l[?2004h>                         month = month_map.get(groups[1][:3].lower())
[?2004l[?2004h>                         if month:
[?2004l[?2004h>                             date_obj = datetime(int(groups[2]), month, int(groups[0]))
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             continue
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                     
[?2004l[?2004h>                     return date_obj.strftime('%Y-%m-%d')
[?2004l[?2004h>             except (ValueError, IndexError):
[?2004l[?2004h>                 continue
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def parse_total_amount(text):
[?2004l[?2004h>     """Extract total amount from OCR text using priority keywords"""
[?2004l[?2004h>     lines = text.split('\n')
[?2004l[?2004h>     
[?2004l[?2004h>     # Exclusion keywords
[?2004l[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']
[?2004l[?2004h>     
[?2004l[?2004h>     # Priority keyword groups (in order of priority)
[?2004l[?2004h>     keyword_groups = [
[?2004l[?2004h>         ['GRAND TOTAL'],
[?2004l[?2004h>         ['TOTAL RM', 'TOTAL: RM'],
[?2004l[?2004h>         ['TOTAL AMOUNT'],
[?2004l[?2004h>         ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     # Pattern to match monetary values
[?2004l[?2004h>     money_pattern = r'(?:RM)?\s*([\d,]+\.\d{2})'
[?2004l[?2004h>     
[?2004l[?2004h>     for keyword_list in keyword_groups:
[?2004l[?2004h>         for i, line in enumerate(lines):
[?2004l[?2004h>             line_upper = line.upper()
[?2004l[?2004h>             
[?2004l[?2004h>             # Check if line contains exclusion keywords
[?2004l[?2004h>             if any(excl in line_upper for excl in exclusion_keywords):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Check if line contains any keyword from current priority group
[?2004l[?2004h>             for keyword in keyword_list:
[?2004l[?2004h>                 if keyword in line_upper:
[?2004l[?2004h>                     # Try to find amount on the same line
[?2004l[?2004h>                     match = re.search(money_pattern, line)
[?2004l[?2004h>                     if match:
[?2004l[?2004h>                         amount_str = match.group(1).replace(',', '')
[?2004l[?2004h>                         try:
[?2004l[?2004h>                             amount = float(amount_str)
[?2004l[?2004h>                             return f"{amount:.2f}"
[?2004l[?2004h>                         except ValueError:
[?2004l[?2004h>                             pass
[?2004l[?2004h>                     
[?2004l[?2004h>                     # If not found on same line, check next line
[?2004l[?2004h>                     if i + 1 < len(lines):
[?2004l[?2004h>                         next_line = lines[i + 1]
[?2004l[?2004h>                         match = re.search(money_pattern, next_line)
[?2004l[?2004h>                         if match:
[?2004l[?2004h>                             amount_str = match.group(1).replace(',', '')
[?2004l[?2004h>                             try:
[?2004l[?2004h>                                 amount = float(amount_str)
[?2004l[?2004h>                                 return f"{amount:.2f}"
[?2004l[?2004h>                             except ValueError:
[?2004l[?2004h>                                 pass
[?2004l[?2004h>         
[?2004l[?2004h>         # If found with current priority, don't check lower priorities
[?2004l[?2004h>         # Actually, we should only return if we found something, otherwise continue to next priority
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def process_receipts(img_dir, output_file):
[?2004l[?2004h>     """Process all receipt images and create Excel file"""
[?2004l[?2004h>     # Get all image files and sort by filename
[?2004l[?2004h>     image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]
[?2004l[?2004h>     image_files.sort()
[?2004l[?2004h>     
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for filename in image_files:
[?2004l[?2004h>         print(f"Processing {filename}...")
[?2004l[?2004h>         img_path = os.path.join(img_dir, filename)
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract text
[?2004l[?2004h>         text = extract_text_from_image(img_path)
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse date and total amount
[?2004l[?2004h>         date = parse_date(text)
[?2004l[?2004h>         total_amount = parse_total_amount(text)
[?2004l[?2004h>         
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'filename': filename,
[?2004l[?2004h>             'date': date,
[?2004l[?2004h>             'total_amount': total_amount
[?2004l[?2004h>         })
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"  Date: {date}, Total: {total_amount}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Create Excel file
[?2004l[?2004h>     wb = Workbook()
[?2004l[?2004h>     ws = wb.active
[?2004l[?2004h>     ws.title = "results"
[?2004l[?2004h>     
[?2004l[?2004h>     # Write header
[?2004l[?2004h>     ws.append(['filename', 'date', 'total_amount'])
[?2004l[?2004h>     
[?2004l[?2004h>     # Write data
[?2004l[?2004h>     for result in results:
[?2004l[?2004h>         ws.append([result['filename'], result['date'], result['total_amount']])
[?2004l[?2004h>     
[?2004l[?2004h>     # Save workbook
[?2004l[?2004h>     wb.save(output_file)
[?2004l[?2004h>     print(f"\nResults saved to {output_file}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     img_dir = "/app/workspace/dataset/img"
[?2004l[?2004h>     output_file = "/app/workspace/stat_ocr.xlsx"
[?2004l[?2004h>     process_receipts(img_dir, output_file)
