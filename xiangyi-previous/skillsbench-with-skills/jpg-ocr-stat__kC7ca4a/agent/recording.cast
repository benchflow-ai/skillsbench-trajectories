[308.629389, "o", "        result = result.replace(old, new)\r\n\u001b[?2004l\r"]
[308.629413, "o", "\u001b[?2004h> "]
[308.629479, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.629505, "o", "> "]
[308.629591, "o", "    return result\r\n\u001b[?2004l\r"]
[308.629618, "o", "\u001b[?2004h"]
[308.629645, "o", "> \r\n"]
[308.629668, "o", "\u001b[?2004l\r\u001b[?2004h"]
[308.629694, "o", "> "]
[308.629842, "o", "def parse_total_amount(text):\r\n\u001b[?2004l\r"]
[308.629866, "o", "\u001b[?2004h> "]
[308.630225, "o", "    \"\"\"Extract total amount from OCR text using priority keywords\"\"\"\r\n\u001b[?2004l\r"]
[308.630253, "o", "\u001b[?2004h> "]
[308.630409, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r"]
[308.630436, "o", "\u001b[?2004h> "]
[308.630498, "o", "    \r\n\u001b[?2004l\r"]
[308.630525, "o", "\u001b[?2004h> "]
[308.63066, "o", "    # Exclusion keywords\r\n\u001b[?2004l\r"]
[308.630687, "o", "\u001b[?2004h> "]
[308.630979, "o", "    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\r\n\u001b[?2004l\r"]
[308.631004, "o", "\u001b[?2004h> "]
[308.631031, "o", "    "]
[308.63106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.631083, "o", "> "]
[308.631225, "o", "    # Priority keyword groups (in order of priority)\r\n\u001b[?2004l\r"]
[308.631251, "o", "\u001b[?2004h> "]
[308.631393, "o", "    keyword_groups = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.631419, "o", "        ['GRAND TOTAL'],\r\n\u001b[?2004l\r"]
[308.631444, "o", "\u001b[?2004h"]
[308.631467, "o", "> "]
[308.631553, "o", "        ['TOTAL RM', 'TOTAL: RM'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.631577, "o", "> "]
[308.63163, "o", "        ['TOTAL AMOUNT'],\r\n\u001b[?2004l\r"]
[308.631654, "o", "\u001b[?2004h> "]
[308.631905, "o", "        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],\r\n\u001b[?2004l\r"]
[308.631939, "o", "\u001b[?2004h> "]
[308.631965, "o", "    ]\r\n\u001b[?2004l\r"]
[308.631988, "o", "\u001b[?2004h> "]
[308.632016, "o", "    \r\n"]
[308.632056, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[308.632381, "o", "    # Pattern to match monetary values - more flexible to catch OCR errors\r\n\u001b[?2004l\r\u001b[?2004h>     money_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.632657, "o", "        r'(?:RM)?\\s*([\\d,]+\\.\\d{2})',  # Standard format\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.632692, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[uUoOlI]{2})',  # OCR errors in decimals\r\n\u001b[?2004l\r"]
[308.632773, "o", "\u001b[?2004h> "]
[308.63293, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[\\duUoOlI]{2})',  # Mixed OCR errors\r\n\u001b[?2004l\r"]
[308.632967, "o", "\u001b[?2004h> "]
[308.633037, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.633066, "o", "    \r\n\u001b[?2004l\r"]
[308.633097, "o", "\u001b[?2004h"]
[308.633128, "o", "> "]
[308.633353, "o", "    for keyword_list in keyword_groups:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.633415, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[308.633444, "o", "\u001b[?2004h> "]
[308.633575, "o", "            line_upper = line.upper()\r\n\u001b[?2004l\r"]
[308.633606, "o", "\u001b[?2004h> "]
[308.633677, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.633706, "o", "> "]
[308.633945, "o", "            # Check if line contains exclusion keywords (but not if it also has TOTAL)\r\n\u001b[?2004l\r"]
[308.63398, "o", "\u001b[?2004h"]
[308.63401, "o", "> "]
[308.63424, "o", "            has_exclusion = any(excl in line_upper for excl in exclusion_keywords)\r\n\u001b[?2004l\r"]
[308.634271, "o", "\u001b[?2004h"]
[308.634299, "o", "> "]
[308.63452, "o", "            has_total_keyword = any(kw in line_upper for kw in keyword_list)\r\n\u001b[?2004l\r"]
[308.63458, "o", "\u001b[?2004h> "]
[308.634633, "o", "            \r\n\u001b[?2004l\r"]
[308.634684, "o", "\u001b[?2004h> "]
[308.634862, "o", "            if has_exclusion and not has_total_keyword:\r\n\u001b[?2004l\r"]
[308.634898, "o", "\u001b[?2004h"]
[308.634931, "o", "> "]
[308.63503, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.635098, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.635131, "o", "> "]
[308.635359, "o", "            # Check if line contains any keyword from current priority group\r\n\u001b[?2004l\r"]
[308.635393, "o", "\u001b[?2004h> "]
[308.63554, "o", "            for keyword in keyword_list:\r\n\u001b[?2004l\r"]
[308.635574, "o", "\u001b[?2004h> "]
[308.635723, "o", "                if keyword in line_upper:\r\n\u001b[?2004l\r"]
[308.635775, "o", "\u001b[?2004h> "]
[308.635939, "o", "                    # Try to find amount on the same line\r\n\u001b[?2004l\r"]
[308.635974, "o", "\u001b[?2004h> "]
[308.636125, "o", "                    for pattern in money_patterns:\r\n\u001b[?2004l\r"]
[308.636158, "o", "\u001b[?2004h> "]
[308.63633, "o", "                        match = re.search(pattern, line)\r\n\u001b[?2004l\r"]
[308.636363, "o", "\u001b[?2004h> "]
[308.636487, "o", "                        if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.636734, "o", "                            amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r"]
[308.636802, "o", "\u001b[?2004h"]
[308.636877, "o", "> "]
[308.63706, "o", "                            amount_str = fix_ocr_amount(amount_str)\r\n\u001b[?2004l\r"]
[308.637131, "o", "\u001b[?2004h> "]
[308.637261, "o", "                            try:\r\n\u001b[?2004l\r"]
[308.637333, "o", "\u001b[?2004h> "]
[308.637478, "o", "                                amount = float(amount_str)\r\n\u001b[?2004l\r"]
[308.637548, "o", "\u001b[?2004h> "]
[308.63771, "o", "                                return f\"{amount:.2f}\"\r\n\u001b[?2004l\r"]
[308.637779, "o", "\u001b[?2004h> "]
[308.637918, "o", "                            except ValueError:\r\n\u001b[?2004l\r"]
[308.637989, "o", "\u001b[?2004h> "]
[308.638098, "o", "                                pass\r\n\u001b[?2004l\r"]
[308.638171, "o", "\u001b[?2004h> "]
[308.638376, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.638557, "o", "                    # If not found on same line, check next line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.638643, "o", "                    if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.63872, "o", "> "]
[308.63884, "o", "                        next_line = lines[i + 1]\r\n\u001b[?2004l\r"]
[308.638914, "o", "\u001b[?2004h> "]
[308.639068, "o", "                        for pattern in money_patterns:\r\n\u001b[?2004l\r"]
[308.63914, "o", "\u001b[?2004h> "]
[308.63931, "o", "                            match = re.search(pattern, next_line)\r\n\u001b[?2004l\r"]
[308.639378, "o", "\u001b[?2004h> "]
[308.639446, "o", "                            if match:\r\n\u001b[?2004l\r"]
[308.639513, "o", "\u001b[?2004h> "]
[308.639727, "o", "                                amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r"]
[308.639818, "o", "\u001b[?2004h> "]
[308.640011, "o", "                                amount_str = fix_ocr_amount(amount_str)\r\n\u001b[?2004l\r"]
[308.64008, "o", "\u001b[?2004h> "]
[308.640189, "o", "                                try:\r\n\u001b[?2004l\r"]
[308.640259, "o", "\u001b[?2004h> "]
[308.640433, "o", "                                    amount = float(amount_str)\r\n\u001b[?2004l\r"]
[308.640504, "o", "\u001b[?2004h> "]
[308.640663, "o", "                                    return f\"{amount:.2f}\"\r\n\u001b[?2004l\r"]
[308.640734, "o", "\u001b[?2004h> "]
[308.64088, "o", "                                except ValueError:\r\n\u001b[?2004l\r"]
[308.64095, "o", "\u001b[?2004h> "]
[308.641053, "o", "                                    pass\r\n\u001b[?2004l\r"]
[308.641122, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.641196, "o", "\u001b[?2004h> "]
[308.64126, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.641326, "o", "\u001b[?2004h> "]
[308.641444, "o", "def process_receipts(img_dir, output_file):\r\n\u001b[?2004l\r"]
[308.641512, "o", "\u001b[?2004h> "]
[308.641666, "o", "    \"\"\"Process all receipt images and create Excel file\"\"\"\r\n\u001b[?2004l\r"]
[308.641735, "o", "\u001b[?2004h> "]
[308.641858, "o", "    # Get all image files and sort by filename\r\n\u001b[?2004l\r"]
[308.641927, "o", "\u001b[?2004h> "]
[308.642208, "o", "    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\r\n\u001b[?2004l\r"]
[308.642279, "o", "\u001b[?2004h> "]
[308.642347, "o", "    image_files.sort()\r\n\u001b[?2004l\r"]
[308.642415, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.642479, "o", "\u001b[?2004h> "]
[308.642543, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.642612, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.642729, "o", "    for filename in image_files:\r\n\u001b[?2004l\r"]
[308.642797, "o", "\u001b[?2004h> "]
[308.642923, "o", "        print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r"]
[308.642992, "o", "\u001b[?2004h> "]
[308.643128, "o", "        img_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r"]
[308.643202, "o", "\u001b[?2004h>         "]
[308.643272, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.643343, "o", "        # Extract text\r\n\u001b[?2004l\r"]
[308.643418, "o", "\u001b[?2004h> "]
[308.643535, "o", "        text = extract_text_from_image(img_path)\r\n\u001b[?2004l\r"]
[308.643604, "o", "\u001b[?2004h>         \r\n"]
[308.643664, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[308.643743, "o", "        # Parse date and total amount\r\n\u001b[?2004l\r"]
[308.643886, "o", "\u001b[?2004h>         date = parse_date(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.644009, "o", "        total_amount = parse_total_amount(text)\r\n\u001b[?2004l\r"]
[308.64407, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[308.644126, "o", "\u001b[?2004h> "]
[308.644187, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.644245, "o", "> "]
[308.644302, "o", "            'filename': filename,\r\n\u001b[?2004l\r"]
[308.644357, "o", "\u001b[?2004h> "]
[308.644415, "o", "            'date': date,\r\n\u001b[?2004l\r"]
[308.644473, "o", "\u001b[?2004h> "]
[308.644559, "o", "            'total_amount': total_amount\r\n\u001b[?2004l\r"]
[308.644618, "o", "\u001b[?2004h>         })"]
[308.644676, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[308.644733, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.64485, "o", "        print(f\"  Date: {date}, Total: {total_amount}\")\r\n\u001b[?2004l\r"]
[308.644907, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.644963, "o", "\u001b[?2004h> "]
[308.645023, "o", "    # Create Excel file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.645078, "o", "    wb = Workbook()\r\n\u001b[?2004l\r"]
[308.645136, "o", "\u001b[?2004h> "]
[308.645198, "o", "    ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.645271, "o", "    ws.title = \"results\"\r\n\u001b[?2004l\r"]
[308.645327, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.645384, "o", "\u001b[?2004h> "]
[308.645441, "o", "    # Write header\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.645546, "o", "    ws.append(['filename', 'date', 'total_amount'])\r\n\u001b[?2004l\r"]
[308.645598, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.645657, "o", "\u001b[?2004h> "]
[308.645776, "o", "    # Write data\r\n\u001b[?2004l\r\u001b[?2004h>     for result in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.645952, "o", "        ws.append([result['filename'], result['date'], result['total_amount']])\r\n\u001b[?2004l\r"]
[308.64601, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.646067, "o", "> "]
[308.646122, "o", "    # Save workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.646184, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r"]
[308.646241, "o", "\u001b[?2004h> "]
[308.64632, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r"]
[308.646379, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.64645, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[308.646482, "o", "\u001b[?2004h> "]
[308.646598, "o", "    img_dir = \"/app/workspace/dataset/img\"\r\n\u001b[?2004l\r"]
[308.646629, "o", "\u001b[?2004h> "]
[308.646743, "o", "    output_file = \"/app/workspace/stat_ocr.xlsx\"\r\n\u001b[?2004l\r"]
[308.646774, "o", "\u001b[?2004h> "]
[308.646879, "o", "    process_receipts(img_dir, output_file)\r\n\u001b[?2004l\r"]
[308.646912, "o", "\u001b[?2004h> "]
[308.646941, "o", "EOF\r\n\u001b[?2004l\r"]
[308.685218, "o", "\u001b[?2004hroot@ba8dcb88372b:/app/workspace# "]
[308.782155, "i", "python3 extract_receipts.py\n"]
[308.782736, "o", "python3 extract_receipts.py\r\n"]
