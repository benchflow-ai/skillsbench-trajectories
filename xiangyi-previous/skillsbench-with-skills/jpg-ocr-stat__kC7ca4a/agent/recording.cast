[580.678746, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('stat_ocr.xlsx')\n\nprint(f\"Number of sheets: {len(wb.sheetnames)}\")\nprint(f\"Sheet names: {wb.sheetnames}\")\n\nws = wb.active\nprint(f\"\\nActive sheet title: '{ws.title}'\")\nprint(f\"Number of columns: {ws.max_column}\")\nprint(f\"Number of rows: {ws.max_row}\")\n\n# Check header\nheader = [cell.value for cell in ws[1]]\nprint(f\"\\nHeader row: {header}\")\n\n# Verify data types and format\nprint(\"\\nSample data rows:\")\nfor i, row in enumerate(ws.iter_rows(min_row=2, max_row=5, values_only=True)):\n    print(f\"Row {i+2}: filename={row[0]!r}, date={row[1]!r}, total_amount={row[2]!r}\")\n\nprint(\"\\nTask requirements check:\")\nprint(f\"✓ Sheet name is 'results': {ws.title == 'results'}\")\nprint(f\"✓ Has 3 columns: {ws.max_column == 3}\")\nprint(f\"✓ Has 23 rows (1 header + 22 data): {ws.max_row == 23}\")\nprint(f\"✓ Header is correct: {header == ['filename', 'date', 'total_amount']}\")\nprint(f\"✓ Only 1 sheet: {len(wb.sheetnames) == 1}\")\nEOF\n"]
