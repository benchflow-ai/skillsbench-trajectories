[512.870889, "o", "\u001b[?2004h"]
[512.870914, "o", "> "]
[512.871019, "o", "        print(f\"Processing {filename}...\")"]
[512.871044, "o", "\r\n\u001b[?2004l\r"]
[512.87107, "o", "\u001b[?2004h> "]
[512.871197, "o", "        img_path = os.path.join(img_dir, filename)\r\n"]
[512.871224, "o", "\u001b[?2004l\r"]
[512.871248, "o", "\u001b[?2004h> "]
[512.871294, "o", "        \r\n\u001b[?2004l\r"]
[512.871338, "o", "\u001b[?2004h> "]
[512.871453, "o", "        text = extract_text_from_image(img_path)"]
