[512.859898, "o", "def fix_ocr_amount(amount_str):"]
[512.859954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.860134, "o", "    fixes = {'u': '0', 'U': '0', 'o': '0', 'O': '0', 'l': '1', 'I': '1', 'S': '5', 'Z': '2'}\r\n\u001b[?2004l\r"]
[512.86019, "o", "\u001b[?2004h> "]
[512.860257, "o", "    result = amount_str\r\n\u001b[?2004l\r"]
[512.860312, "o", "\u001b[?2004h> "]
[512.860377, "o", "    for old, new in fixes.items():\r\n\u001b[?2004l\r"]
[512.860432, "o", "\u001b[?2004h> "]
[512.860507, "o", "        result = result.replace(old, new)\r\n\u001b[?2004l\r"]
[512.860561, "o", "\u001b[?2004h> "]
[512.860613, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.860668, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.860749, "o", "def parse_total_amount(text):\r\n"]
[512.860805, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[512.860863, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r"]
[512.860918, "o", "\u001b[?2004h> "]
[512.860973, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.861056, "o", "    # More specific exclusion patterns\r\n\u001b[?2004l\r"]
[512.861112, "o", "\u001b[?2004h> "]
[512.861166, "o", "    exclusion_patterns = [\r\n\u001b[?2004l\r"]
[512.861218, "o", "\u001b[?2004h> "]
[512.861311, "o", "        'SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL',"]
[512.861336, "o", "\r\n\u001b[?2004l\r"]
[512.86137, "o", "\u001b[?2004h> "]
[512.861515, "o", "        'TOTAL GST', 'GST TOTAL', 'TOTAL TAX', 'TAX TOTAL',"]
[512.861545, "o", "\r\n\u001b[?2004l\r"]
[512.861576, "o", "\u001b[?2004h> "]
[512.861681, "o", "        'DISCOUNT', 'CHANGE', 'CASH TENDERED',"]
[512.861715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.861746, "o", "> "]
[512.861826, "o", "        'EXCLUDED', 'GST SUMMARY'\r\n\u001b[?2004l\r"]
[512.861855, "o", "\u001b[?2004h> "]
[512.861891, "o", "    ]\r\n\u001b[?2004l\r"]
[512.861919, "o", "\u001b[?2004h> "]
[512.861949, "o", "    \r\n\u001b[?2004l\r"]
[512.86198, "o", "\u001b[?2004h> "]
[512.862056, "o", "    keyword_groups = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.862085, "o", "> "]
[512.862121, "o", "        ['GRAND TOTAL'],\r\n\u001b[?2004l\r"]
[512.862178, "o", "\u001b[?2004h> "]
[512.862281, "o", "        ['TOTAL RM', 'TOTAL: RM', 'TOTAL (RM)'],\r\n\u001b[?2004l\r"]
[512.862324, "o", "\u001b[?2004h> "]
[512.862403, "o", "        ['TOTAL AMOUNT'],\r\n\u001b[?2004l\r"]
[512.862435, "o", "\u001b[?2004h> "]
[512.862615, "o", "        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', "]
[512.862651, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.862685, "o", "> "]
[512.862807, "o", "         'TOTAL SALES', 'TOTAL AFTER', 'TOTAL', 'AMOUNT'],"]
[512.862837, "o", "\r\n\u001b[?2004l\r"]
[512.862866, "o", "\u001b[?2004h> "]
[512.862898, "o", "    ]\r\n\u001b[?2004l\r"]
[512.862939, "o", "\u001b[?2004h> "]
[512.862975, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[512.863012, "o", "> "]
[512.863045, "o", "    money_patterns = [\r\n\u001b[?2004l\r"]
[512.863078, "o", "\u001b[?2004h> "]
[512.863172, "o", "        r'(?:RM)?\\s*([\\d,]+\\.\\d{2})',\r\n\u001b[?2004l\r"]
[512.8632, "o", "\u001b[?2004h"]
[512.863235, "o", "> "]
[512.86333, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[uUoOlI]{2})',\r\n\u001b[?2004l\r"]
[512.86336, "o", "\u001b[?2004h> "]
[512.863442, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[\\duUoOlI]{2})',\r\n\u001b[?2004l\r"]
[512.863473, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[512.863501, "o", "\u001b[?2004h> "]
[512.863575, "o", "    \r\n\u001b[?2004l\r"]
[512.863604, "o", "\u001b[?2004h> "]
[512.863694, "o", "    for keyword_list in keyword_groups:\r\n\u001b[?2004l\r"]
[512.863722, "o", "\u001b[?2004h> "]
[512.863846, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.863878, "o", "> "]
[512.86394, "o", "            line_upper = line.upper()\r\n\u001b[?2004l\r"]
[512.864001, "o", "\u001b[?2004h> "]
[512.864061, "o", "            \r\n\u001b[?2004l\r"]
[512.864091, "o", "\u001b[?2004h> "]
[512.864225, "o", "            # Skip if line matches exclusion patterns"]
[512.864253, "o", "\r\n\u001b[?2004l\r"]
[512.864302, "o", "\u001b[?2004h> "]
[512.864464, "o", "            if any(excl in line_upper for excl in exclusion_patterns):"]
[512.864496, "o", "\r\n\u001b[?2004l\r"]
[512.864525, "o", "\u001b[?2004h> "]
[512.864604, "o", "                continue\r\n"]
[512.864632, "o", "\u001b[?2004l\r\u001b[?2004h"]
[512.864659, "o", "> "]
[512.86471, "o", "            \r\n\u001b[?2004l\r"]
[512.86474, "o", "\u001b[?2004h"]
[512.864769, "o", "> "]
[512.864934, "o", "            # Check if line contains any keyword from current priority group"]
[512.864962, "o", "\r\n\u001b[?2004l\r"]
[512.865003, "o", "\u001b[?2004h> "]
[512.865108, "o", "            for keyword in keyword_list:"]
[512.865137, "o", "\r\n\u001b[?2004l\r"]
[512.865165, "o", "\u001b[?2004h> "]
[512.865272, "o", "                if keyword in line_upper:\r\n"]
[512.865305, "o", "\u001b[?2004l\r"]
[512.865334, "o", "\u001b[?2004h> "]
[512.865465, "o", "                    # Try to find amount on the same line"]
[512.865494, "o", "\r\n\u001b[?2004l\r"]
[512.865535, "o", "\u001b[?2004h"]
[512.865563, "o", "> "]
[512.865652, "o", "                    for pattern in money_patterns:\r\n\u001b[?2004l\r"]
[512.865694, "o", "\u001b[?2004h> "]
[512.865836, "o", "                        match = re.search(pattern, line)"]
[512.865866, "o", "\r\n\u001b[?2004l\r"]
[512.865894, "o", "\u001b[?2004h> "]
[512.865981, "o", "                        if match:\r\n"]
[512.866012, "o", "\u001b[?2004l\r\u001b[?2004h"]
[512.86604, "o", "> "]
[512.866203, "o", "                            amount_str = match.group(1).replace(',', '')"]
[512.866248, "o", "\r\n\u001b[?2004l\r"]
[512.866276, "o", "\u001b[?2004h> "]
[512.866432, "o", "                            amount_str = fix_ocr_amount(amount_str)"]
[512.866478, "o", "\r\n\u001b[?2004l\r"]
[512.86651, "o", "\u001b[?2004h> "]
[512.866602, "o", "                            try:\r\n"]
[512.866634, "o", "\u001b[?2004l\r\u001b[?2004h"]
[512.866664, "o", "> "]
[512.866812, "o", "                                amount = float(amount_str)"]
[512.866843, "o", "\r\n\u001b[?2004l\r"]
[512.866875, "o", "\u001b[?2004h> "]
[512.867023, "o", "                                return f\"{amount:.2f}\""]
[512.867059, "o", "\r\n\u001b[?2004l\r"]
[512.86709, "o", "\u001b[?2004h> "]
[512.86722, "o", "                            except ValueError:"]
[512.86725, "o", "\r\n\u001b[?2004l\r"]
[512.867287, "o", "\u001b[?2004h> "]
[512.867393, "o", "                                pass"]
[512.867424, "o", "\r\n\u001b[?2004l\r"]
[512.867453, "o", "\u001b[?2004h> "]
[512.867524, "o", "                    \r\n\u001b[?2004l\r"]
[512.867571, "o", "\u001b[?2004h> "]
[512.86773, "o", "                    # If not found on same line, check next line"]
[512.867787, "o", "\r\n\u001b[?2004l\r"]
[512.867825, "o", "\u001b[?2004h> "]
[512.86793, "o", "                    if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.867963, "o", "> "]
[512.868158, "o", "                        next_line = lines[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.868246, "o", "                        for pattern in money_patterns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.868283, "o", "> "]
[512.868392, "o", "                            match = re.search(pattern, next_line)\r\n\u001b[?2004l\r"]
[512.868426, "o", "\u001b[?2004h> "]
[512.868574, "o", "                            if match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.868606, "o", "> "]
[512.868753, "o", "                                amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.868784, "o", "> "]
[512.868929, "o", "                                amount_str = fix_ocr_amount(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.86896, "o", "> "]
[512.869048, "o", "                                try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.869082, "o", "> "]
[512.869214, "o", "                                    amount = float(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.869248, "o", "> "]
[512.869361, "o", "                                    return f\"{amount:.2f}\"\r\n\u001b[?2004l\r"]
[512.869505, "o", "\u001b[?2004h> "]
[512.86963, "o", "                                except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.869665, "o", "> "]
[512.869732, "o", "                                    pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.869765, "o", ">     \r\n\u001b[?2004l\r"]
[512.869833, "o", "\u001b[?2004h> "]
[512.869875, "o", "    return None\r\n\u001b[?2004l\r"]
[512.869908, "o", "\u001b[?2004h> "]
[512.869939, "o", "\r\n\u001b[?2004l\r"]
[512.869969, "o", "\u001b[?2004h> "]
