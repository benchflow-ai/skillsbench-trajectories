[420.063921, "o", "\u001b[?2004h> "]
[420.064214, "o", "        print(f\"Error processing {image_path}: {e}\")\r\n\u001b[?2004l\r"]
[420.064249, "o", "\u001b[?2004h> "]
[420.064423, "o", "        return \"\"\r\n\u001b[?2004l\r"]
[420.064465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.067844, "o", "def parse_date(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract date from OCR text and convert to ISO format\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     date_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', 'YYYY-MM-DD'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})', 'DD-MM-YYYY'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{4})', 'DD Mon YYYY'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{1,2}),?\\s+(\\d{4})', 'Mon DD YYYY'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.068009, "o", "        (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{2})(?!\\d)', 'DD-MM-YY'),\r\n\u001b[?2004l\r"]
[420.068306, "o", "\u001b[?2004h> "]
[420.068813, "o", "        (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{2})(?!\\d)', 'DD Mon YY'),\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r \u001b[?2004h> "]
[420.068879, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.069049, "o", "    month_map = {'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.069507, "o", "                 'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12}\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.069543, "o", ">     \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[420.069708, "o", "    for pattern, format_type in date_patterns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.069826, "o", "> "]
[420.069997, "o", "        matches = re.finditer(pattern, text, re.IGNORECASE)\r\n\u001b[?2004l\r"]
[420.070035, "o", "\u001b[?2004h> "]
[420.070137, "o", "        for match in matches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.070179, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.07022, "o", "> "]
[420.07033, "o", "                groups = match.groups()\r\n\u001b[?2004l\r"]
[420.070372, "o", "\u001b[?2004h> "]
[420.070572, "o", "                if len(groups) == 3:\r\n\u001b[?2004l\r"]
[420.070682, "o", "\u001b[?2004h> "]
[420.070893, "o", "                    if format_type == 'YYYY-MM-DD':\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.070928, "o", "> "]
[420.071317, "o", "                        date_obj = datetime(int(groups[0]), int(groups[1]), int(groups[2]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.071347, "o", "> "]
[420.071526, "o", "                    elif format_type == 'DD-MM-YYYY':\r\n\u001b[?2004l\r"]
[420.071613, "o", "\u001b[?2004h> "]
[420.09224, "o", "                        date_obj = datetime(int(groups[2]), int(groups[1]), int(groups[0]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.092332, "o", "> "]
[420.092912, "o", "                    elif format_type == 'DD Mon YYYY':\r\n\u001b[?2004l\r"]
[420.092964, "o", "\u001b[?2004h> "]
[420.09336, "o", "                        month = month_map.get(groups[1][:3].lower())\r\n\u001b[?2004l\r"]
[420.093391, "o", "\u001b[?2004h> "]
[420.093641, "o", "                        if month:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.094124, "o", "                            date_obj = datetime(int(groups[2]), month, int(groups[0]))\r\n\u001b[?2004l\r"]
[420.094156, "o", "\u001b[?2004h> "]
[420.094351, "o", "                        else:\r\n\u001b[?2004l\r"]
[420.094417, "o", "\u001b[?2004h> "]
[420.094586, "o", "                            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.094627, "o", "> "]
[420.095014, "o", "                    elif format_type == 'Mon DD YYYY':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.095322, "o", "                        month = month_map.get(groups[0][:3].lower())\r\n\u001b[?2004l\r"]
[420.095365, "o", "\u001b[?2004h> "]
[420.095971, "o", "                        if month:\r\n\u001b[?2004l\r"]
[420.096013, "o", "\u001b[?2004h> "]
[420.096509, "o", "                            date_obj = datetime(int(groups[2]), month, int(groups[1]))\r\n\u001b[?2004l\r"]
[420.096544, "o", "\u001b[?2004h> "]
[420.096722, "o", "                        else:\r\n\u001b[?2004l\r"]
[420.096748, "o", "\u001b[?2004h> "]
[420.09697, "o", "                            continue\r\n\u001b[?2004l\r"]
[420.096996, "o", "\u001b[?2004h"]
[420.097023, "o", "> "]
[420.097308, "o", "                    elif format_type == 'DD-MM-YY':\r\n\u001b[?2004l\r"]
[420.097352, "o", "\u001b[?2004h> "]
[420.097622, "o", "                        year = int(groups[2])\r\n\u001b[?2004l\r"]
[420.097654, "o", "\u001b[?2004h> "]
[420.098093, "o", "                        full_year = 2000 + year if year < 50 else 1900 + year\r\n\u001b[?2004l\r"]
[420.098126, "o", "\u001b[?2004h> "]
[420.098613, "o", "                        date_obj = datetime(full_year, int(groups[1]), int(groups[0]))"]
[420.098667, "o", "\r\n"]
[420.09871, "o", "\u001b[?2004l\r"]
[420.098778, "o", "\u001b[?2004h"]
[420.09883, "o", "> "]
[420.099167, "o", "                    elif format_type == 'DD Mon YY':"]
[420.099214, "o", "\r\n"]
[420.099261, "o", "\u001b[?2004l\r"]
[420.099326, "o", "\u001b[?2004h"]
[420.099375, "o", "> "]
[420.099809, "o", "                        month = month_map.get(groups[1][:3].lower())"]
[420.099862, "o", "\r\n"]
[420.099909, "o", "\u001b[?2004l\r"]
[420.099978, "o", "\u001b[?2004h"]
[420.100031, "o", "> "]
[420.100275, "o", "                        if month:"]
[420.100321, "o", "\r\n"]
[420.100368, "o", "\u001b[?2004l\r"]
[420.100436, "o", "\u001b[?2004h"]
[420.100496, "o", "> "]
[420.100832, "o", "                            year = int(groups[2])"]
[420.100898, "o", "\r\n"]
[420.100947, "o", "\u001b[?2004l\r"]
[420.101016, "o", "\u001b[?2004h"]
[420.101075, "o", "> "]
[420.101633, "o", "                            full_year = 2000 + year if year < 50 else 1900 + year"]
[420.101693, "o", "\r\n"]
[420.101751, "o", "\u001b[?2004l\r"]
[420.101827, "o", "\u001b[?2004h"]
[420.101883, "o", "> "]
[420.10241, "o", "                            date_obj = datetime(full_year, month, int(groups[0]))"]
[420.102466, "o", "\r\n"]
[420.102513, "o", "\u001b[?2004l\r"]
[420.102578, "o", "\u001b[?2004h"]
[420.102632, "o", "> "]
[420.102845, "o", "                        else:"]
[420.10289, "o", "\r\n"]
[420.102938, "o", "\u001b[?2004l\r"]
[420.103001, "o", "\u001b[?2004h"]
[420.103055, "o", "> "]
[420.103303, "o", "                            continue"]
[420.103353, "o", "\r\n"]
[420.103399, "o", "\u001b[?2004l\r"]
[420.103463, "o", "\u001b[?2004h"]
[420.103521, "o", "> "]
[420.103711, "o", "                    else:"]
[420.103767, "o", "\r\n"]
[420.103816, "o", "\u001b[?2004l\r"]
[420.104095, "o", "\u001b[?2004h> "]
[420.104214, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.10429, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.104541, "o", "                    if 2000 <= date_obj.year <= 2030:\r\n\u001b[?2004l\r"]
[420.10463, "o", "\u001b[?2004h> "]
[420.108118, "o", "                        return date_obj.strftime('%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h>             except (ValueError, IndexError):\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fix_ocr_amount(amount_str):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Fix common OCR errors in amount strings\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     fixes = {'u': '0', 'U': '0', 'o': '0', 'O': '0', 'l': '1', 'I': '1', 'S': '5', 'Z': '2'}\r\n\u001b[?2004l\r\u001b[?2004h>     result = amount_str\r\n\u001b[?2004l\r\u001b[?2004h>     for old, new in fixes.items():\r\n\u001b[?2004l\r\u001b[?2004h>         result = result.replace(old, new)\r\n\u001b[?2004l\r\u001b[?2004h>     return result\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract total amount from OCR text using priority keywords\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Exclusion keywords - must not match these\r\n\u001b[?2004l\r\u001b[?2004h>     exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED', 'EXCLUDED']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Priority keyword groups\r\n\u001b[?2004l\r\u001b[?2004h>     keyword_groups = [\r\n\u001b[?2004l\r\u001b[?2004h>         ['GRAND TOTAL'],\r\n\u001b[?2004l\r\u001b[?2004h>         ['TOTAL RM', 'TOTAL: RM', 'TOTAL (RM)'],\r\n\u001b[?2004l\r\u001b[?2004h>         ['TOTAL AMOUNT'],\r\n\u001b[?2004l\r\u001b[?2004h>         ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.108231, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     money_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.108303, "o", "> "]
[420.108336, "o", "        r'(?:RM)?\\s*([\\d,]+\\.\\d{2})',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.108517, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[uUoOlI]{2})',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.108767, "o", "        r'(?:RM)?\\s*([\\d,]+\\.[\\duUoOlI]{2})',\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.108844, "o", "    for keyword_list in keyword_groups:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.108997, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[420.109218, "o", "\u001b[?2004h> "]
[420.109341, "o", "            line_upper = line.upper()\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.109375, "o", "            # Skip if line contains exclusion keywords\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.109574, "o", "            if any(excl in line_upper for excl in exclusion_keywords):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.109702, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[420.109796, "o", "\u001b[?2004h> "]
[420.109898, "o", "            # Check if line contains any keyword from current priority group\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110003, "o", "            for keyword in keyword_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110035, "o", "                if keyword in line_upper:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110301, "o", "                    # Try to find amount on the same line\r\n\u001b[?2004l\r\u001b[?2004h>                     for pattern in money_patterns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110486, "o", "                        match = re.search(pattern, line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110667, "o", "                        if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.110838, "o", "                            amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h>                             amount_str = fix_ocr_amount(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111011, "o", "                            try:\r\n\u001b[?2004l\r\u001b[?2004h>                                 amount = float(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111052, "o", "                                return f\"{amount:.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111357, "o", "                            except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                                 pass\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111544, "o", "                    # If not found on same line, check next line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111702, "o", "                    if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111875, "o", "                        next_line = lines[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.111918, "o", "                        for pattern in money_patterns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.112116, "o", "                            match = re.search(pattern, next_line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.112274, "o", "                            if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.112442, "o", "                                amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.112678, "o", "                                amount_str = fix_ocr_amount(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.112913, "o", "                                try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113095, "o", "                                    amount = float(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113266, "o", "                                    return f\"{amount:.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113493, "o", "                                except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113688, "o", "                                    pass\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113858, "o", "def process_receipts(img_dir, output_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.113997, "o", "    \"\"\"Process all receipt images and create Excel file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.1142, "o", "    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\r\n\u001b[?2004l\r"]
[420.114442, "o", "\u001b[?2004h>     image_files.sort()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[420.114604, "o", "\u001b[?2004h>     for filename in image_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.114788, "o", "        print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.114945, "o", "        img_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115119, "o", "        text = extract_text_from_image(img_path)\r\n\u001b[?2004l\r\u001b[?2004h>         date = parse_date(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115307, "o", "        total_amount = parse_total_amount(text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115475, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'filename': filename,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.11567, "o", "            'date': date,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115843, "o", "            'total_amount': total_amount\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115885, "o", "        print(f\"  Date: {date}, Total: {total_amount}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.115934, "o", "    wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.116202, "o", "    ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h>     ws.title = \"results\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.116349, "o", "    ws.append(['filename', 'date', 'total_amount'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.116473, "o", "    for result in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.116671, "o", "        ws.append([result['filename'], result['date'], result['total_amount']])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[420.116796, "o", ">     wb.save(output_file)\r\n\u001b[?2004l\r"]
[420.116925, "o", "\u001b[?2004h> "]
[420.117042, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.117155, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
