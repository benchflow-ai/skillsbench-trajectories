[512.870145, "o", "> "]
[512.870371, "o", "    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]"]
[512.870403, "o", "\r\n\u001b[?2004l\r"]
[512.870433, "o", "\u001b[?2004h> "]
[512.870502, "o", "    image_files.sort()\r\n\u001b[?2004l\r"]
[512.870531, "o", "\u001b[?2004h"]
[512.870559, "o", ">     "]
