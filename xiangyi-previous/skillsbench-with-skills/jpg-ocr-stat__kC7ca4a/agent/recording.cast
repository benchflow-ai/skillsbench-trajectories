[460.002053, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport pytesseract\n\nfor img_name in ['094.jpg', '071.jpg']:\n    print(f\"\\n{'='*50}\")\n    print(f\"OCR Text for {img_name}\")\n    print('='*50)\n    img = Image.open(f'/app/workspace/dataset/img/{img_name}')\n    text = pytesseract.image_to_string(img)\n    print(text)\n    print('\\n=== Lines with TOTAL or AMOUNT ===')\n    for line in text.split('\\n'):\n        if 'TOTAL' in line.upper() or 'AMOUNT' in line.upper():\n            print(line)\nEOF\n"]
