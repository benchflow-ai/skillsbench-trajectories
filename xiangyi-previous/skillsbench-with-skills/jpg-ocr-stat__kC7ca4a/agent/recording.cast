[512.872423, "o", "        \r\n\u001b[?2004l\r"]
[512.872459, "o", "\u001b[?2004h> "]
[512.872585, "o", "        print(f\"  Date: {date}, Total: {total_amount}\")\r\n\u001b[?2004l\r"]
[512.872616, "o", "\u001b[?2004h"]
[512.872646, "o", ">     \r\n"]
