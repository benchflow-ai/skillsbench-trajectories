[50.315117, "o", "                    return date_obj.strftime('%Y-%m-%d')\r\n\u001b[?2004l\r"]
[50.31516, "o", "\u001b[?2004h> "]
[50.315276, "o", "            except (ValueError, IndexError):\r\n\u001b[?2004l\r"]
[50.315317, "o", "\u001b[?2004h> "]
[50.315389, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.315433, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.315474, "o", "> "]
[50.315515, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[50.315557, "o", "\u001b[?2004h> "]
[50.315627, "o", "def parse_total_amount(text):\r\n\u001b[?2004l\r"]
[50.315666, "o", "\u001b[?2004h> "]
[50.315865, "o", "    \"\"\"Extract total amount from OCR text using priority keywords\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.315921, "o", "> "]
[50.315969, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.316013, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.316054, "o", "> "]
[50.316112, "o", "    # Exclusion keywords\r\n\u001b[?2004l\r"]
[50.316157, "o", "\u001b[?2004h> "]
[50.316419, "o", "    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\r\n\u001b[?2004l\r"]
[50.316463, "o", "\u001b[?2004h> "]
[50.316505, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.316548, "o", "> "]
[50.31666, "o", "    # Priority keyword groups (in order of priority)\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.316705, "o", "> "]
[50.316745, "o", "    keyword_groups = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.316786, "o", "> "]
[50.316835, "o", "        ['GRAND TOTAL'],\r\n\u001b[?2004l\r"]
[50.316875, "o", "\u001b[?2004h> "]
[50.316971, "o", "        ['TOTAL RM', 'TOTAL: RM'],\r\n\u001b[?2004l\r"]
[50.317012, "o", "\u001b[?2004h"]
[50.317053, "o", "> "]
[50.31711, "o", "        ['TOTAL AMOUNT'],\r\n\u001b[?2004l\r"]
[50.317152, "o", "\u001b[?2004h> "]
[50.317389, "o", "        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.317433, "o", ">     ]\r\n\u001b[?2004l\r"]
[50.317475, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.317517, "o", "> "]
[50.317579, "o", "    # Pattern to match monetary values\r\n\u001b[?2004l\r"]
[50.317697, "o", "\u001b[?2004h> "]
[50.317777, "o", "    money_pattern = r'(?:RM)?\\s*([\\d,]+\\.\\d{2})'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.317888, "o", "    for keyword_list in keyword_groups:\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.317933, "o", "> "]
[50.318003, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[50.318046, "o", "\u001b[?2004h> "]
[50.318151, "o", "            line_upper = line.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.318205, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.318374, "o", "            # Check if line contains exclusion keywords\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.318548, "o", "            if any(excl in line_upper for excl in exclusion_keywords):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.318619, "o", "                continue\r\n\u001b[?2004l\r"]
[50.318665, "o", "\u001b[?2004h> "]
[50.318707, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.31889, "o", "            # Check if line contains any keyword from current priority group\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.318936, "o", "> "]
[50.319011, "o", "            for keyword in keyword_list:\r\n\u001b[?2004l\r"]
[50.319055, "o", "\u001b[?2004h> "]
[50.323095, "o", "                if keyword in line_upper:\r\n\u001b[?2004l\r\u001b[?2004h>                     # Try to find amount on the same line\r\n\u001b[?2004l\r\u001b[?2004h>                     match = re.search(money_pattern, line)\r\n\u001b[?2004l\r\u001b[?2004h>                     if match:\r\n\u001b[?2004l\r\u001b[?2004h>                         amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h>                         try:\r\n\u001b[?2004l\r\u001b[?2004h>                             amount = float(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h>                             return f\"{amount:.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h>                         except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                             pass\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>                     # If not found on same line, check next line\r\n\u001b[?2004l\r\u001b[?2004h>                     if i + 1 < len(lines):\r\n\u001b[?2004l\r\u001b[?2004h>                         next_line = lines[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h>                         match = re.search(money_pattern, next_line)\r\n\u001b[?2004l\r\u001b[?2004h>                         if match:\r\n\u001b[?2004l\r\u001b[?2004h>                             amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h>                             try:\r\n\u001b[?2004l\r\u001b[?2004h>                                 amount = float(amount_str)\r\n\u001b[?2004l\r\u001b[?2004h>                                 return f\"{amount:.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h>                             except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                                 pass\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # If found with current priority, don't check lower priorities\r\n\u001b[?2004l\r\u001b[?2004h>         # Actually, we should only return if we found something, otherwise continue to next priority\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def process_receipts(img_dir, output_file):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Process all receipt images and create Excel file\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Get all image files and sort by filename\r\n\u001b[?2004l\r\u001b[?2004h>     image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\r\n\u001b[?2004l\r\u001b[?2004h>     image_files.sort()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for filename in image_files:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Processing {filename}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         img_path = os.path.join(img_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Extract text\r\n\u001b[?2004l\r\u001b[?2004h>         text = extract_text_from_image(img_path)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Parse date and total amount\r\n\u001b[?2004l\r\u001b[?2004h>         date = parse_date(text)\r\n\u001b[?2004l\r\u001b[?2004h>         total_amount = parse_total_amount(text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         results.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'filename': filename,\r\n\u001b[?2004l\r\u001b[?2004h>             'date': date,\r\n\u001b[?2004l\r\u001b[?2004h>             'total_amount': total_amount\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[50.323174, "o", "\u001b[?2004h> "]
[50.32323, "o", "        print(f\"  Date: {date}, Total: {total_amount}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323285, "o", "    # Create Excel file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323336, "o", "    wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323386, "o", "    ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323437, "o", "    ws.title = \"results\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323482, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323531, "o", "    # Write header\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323603, "o", "    ws.append(['filename', 'date', 'total_amount'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323648, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323697, "o", "    # Write data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323861, "o", "    for result in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.327946, "o", "        ws.append([result['filename'], result['date'], result['total_amount']])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save workbook\r\n\u001b[?2004l\r\u001b[?2004h>     wb.save(output_file)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     img_dir = \"/app/workspace/dataset/img\"\r\n\u001b[?2004l\r\u001b[?2004h>     output_file = \"/app/workspace/stat_ocr.xlsx\"\r\n\u001b[?2004l\r\u001b[?2004h>     process_receipts(img_dir, output_file)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
