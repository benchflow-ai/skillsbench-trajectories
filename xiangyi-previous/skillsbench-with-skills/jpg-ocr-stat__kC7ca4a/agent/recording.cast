[366.560784, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('stat_ocr.xlsx')\nws = wb.active\n\nprint(\"All results:\")\nfor row in ws.iter_rows(values_only=True):\n    print(row)\n\n# Count None values\nnone_dates = 0\nnone_amounts = 0\nfor i, row in enumerate(ws.iter_rows(values_only=True)):\n    if i == 0:\n        continue\n    if row[1] is None:\n        none_dates += 1\n        print(f\"Missing date: {row[0]}\")\n    if row[2] is None:\n        none_amounts += 1\n        print(f\"Missing amount: {row[0]}\")\n\nprint(f\"\\nMissing dates: {none_dates}, Missing amounts: {none_amounts}\")\nEOF\n"]
[366.561116, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.561231, "o", "import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.56133, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.56142, "o", "wb = openpyxl.load_workbook('stat_ocr.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.561509, "o", "ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[366.561599, "o", "> print(\"All results:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.561753, "o", "for row in ws.iter_rows(values_only=True):"]
