[512.870615, "o", "\u001b[?2004h> "]
[512.870676, "o", "    results = []\r\n\u001b[?2004l\r"]
[512.870699, "o", "\u001b[?2004h> "]
[512.870727, "o", "    \r\n"]
[512.870752, "o", "\u001b[?2004l\r\u001b[?2004h"]
[512.870781, "o", "> "]
