[175.51419, "o", "\u001b[?2004h"]
[175.514303, "o", "> "]
[175.514681, "o", "                            year = int(groups[2])"]
[175.514821, "o", "\r\n"]
[175.514921, "o", "\u001b[?2004l\r"]
[175.515063, "o", "\u001b[?2004h"]
[175.515174, "o", "> "]
[175.515609, "o", "                            full_year = 2000 + year if year < 50 else 1900 + year"]
[175.515715, "o", "\r\n"]
[175.51585, "o", "\u001b[?2004l\r"]
[175.515959, "o", "\u001b[?2004h"]
[175.516058, "o", "> "]
[175.516412, "o", "                            date_obj = datetime(full_year, month, int(groups[0]))"]
[175.516604, "o", "\r\n"]
[175.516708, "o", "\u001b[?2004l\r"]
[175.51682, "o", "\u001b[?2004h> "]
[175.516894, "o", "                        else:\r\n\u001b[?2004l\r"]
[175.516923, "o", "\u001b[?2004h> "]
[175.517058, "o", "                            continue\r\n\u001b[?2004l\r\u001b[?2004h>                     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.517103, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.517219, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.517243, "o", "> "]
[175.517384, "o", "                    # Validate date is reasonable (between 2000 and 2030)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.517409, "o", "> "]
[175.51752, "o", "                    if 2000 <= date_obj.year <= 2030:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.517542, "o", "> "]
[175.517655, "o", "                        return date_obj.strftime('%Y-%m-%d')\r\n\u001b[?2004l\r"]
[175.517676, "o", "\u001b[?2004h> "]
[175.517777, "o", "            except (ValueError, IndexError):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.517798, "o", "> "]
[175.517848, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[175.517868, "o", "\u001b[?2004h"]
[175.517921, "o", "> "]
[175.517965, "o", "    return None\r\n\u001b[?2004l\r"]
[175.517986, "o", "\u001b[?2004h> "]
[175.51803, "o", "\r\n\u001b[?2004l\r"]
[175.518052, "o", "\u001b[?2004h> "]
[175.518113, "o", "def parse_total_amount(text):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.518135, "o", "> "]
[175.518241, "o", "    \"\"\"Extract total amount from OCR text using priority keywords\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.518264, "o", "> "]
[175.518319, "o", "    lines = text.split('\\n')\r\n\u001b[?2004l\r"]
[175.518341, "o", "\u001b[?2004h"]
[175.518387, "o", ">     "]
[175.518407, "o", "\r\n\u001b[?2004l\r"]
[175.518454, "o", "\u001b[?2004h> "]
[175.518511, "o", "    # Exclusion keywords\r\n\u001b[?2004l\r"]
[175.518531, "o", "\u001b[?2004h> "]
[175.518736, "o", "    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.518757, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.518811, "o", "> "]
[175.518907, "o", "    # Priority keyword groups (in order of priority)\r\n\u001b[?2004l\r"]
[175.518927, "o", "\u001b[?2004h> "]
[175.519096, "o", "    keyword_groups = [\r\n\u001b[?2004l\r\u001b[?2004h>         ['GRAND TOTAL'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.51912, "o", "        ['TOTAL RM', 'TOTAL: RM'],"]
[175.519175, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.519272, "o", "        ['TOTAL AMOUNT'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.519432, "o", "        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.519455, "o", "> "]
[175.51951, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.519531, "o", ">     \r\n\u001b[?2004l\r"]
[175.519578, "o", "\u001b[?2004h> "]
[175.519688, "o", "    # Pattern to match monetary values - more flexible\r\n\u001b[?2004l\r"]
[175.519711, "o", "\u001b[?2004h> "]
[175.519837, "o", "    money_pattern = r'(?:RM)?\\s*([\\d,]+\\.\\d{2})'\r\n\u001b[?2004l\r"]
[175.51986, "o", "\u001b[?2004h> "]
[175.519914, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.519936, "o", "> "]
[175.520042, "o", "    for keyword_list in keyword_groups:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.52007, "o", "> "]
[175.520164, "o", "        for i, line in enumerate(lines):\r\n\u001b[?2004l\r"]
[175.520187, "o", "\u001b[?2004h> "]
[175.520284, "o", "            line_upper = line.upper()\r\n\u001b[?2004l\r"]
[175.520312, "o", "\u001b[?2004h> "]
[175.520403, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.52048, "o", "            # Check if line contains exclusion keywords\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.520531, "o", "> "]
[175.520614, "o", "            if any(excl in line_upper for excl in exclusion_keywords):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.520664, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.520708, "o", "            \r\n\u001b[?2004l\r"]
[175.520806, "o", "\u001b[?2004h> "]
[175.520906, "o", "            # Check if line contains any keyword from current priority group\r\n\u001b[?2004l\r"]
[175.520955, "o", "\u001b[?2004h> "]
[175.52104, "o", "            for keyword in keyword_list:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.521091, "o", "> "]
[175.521186, "o", "                if keyword in line_upper:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.521304, "o", "                    # Try to find amount on the same line\r\n\u001b[?2004l\r"]
[175.521348, "o", "\u001b[?2004h> "]
[175.52145, "o", "                    match = re.search(money_pattern, line)\r\n\u001b[?2004l\r"]
[175.521496, "o", "\u001b[?2004h> "]
[175.521548, "o", "                    if match:\r\n\u001b[?2004l\r"]
[175.52159, "o", "\u001b[?2004h> "]
[175.521668, "o", "                        amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r"]
[175.521711, "o", "\u001b[?2004h> "]
[175.521752, "o", "                        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.521792, "o", "> "]
[175.521887, "o", "                            amount = float(amount_str)\r\n\u001b[?2004l\r"]
[175.521928, "o", "\u001b[?2004h> "]
[175.522008, "o", "                            return f\"{amount:.2f}\"\r\n\u001b[?2004l\r"]
[175.522048, "o", "\u001b[?2004h> "]
[175.522126, "o", "                        except ValueError:\r\n\u001b[?2004l\r"]
[175.522168, "o", "\u001b[?2004h> "]
[175.522222, "o", "                            pass\r\n\u001b[?2004l\r"]
[175.522265, "o", "\u001b[?2004h>                     \r\n\u001b[?2004l\r"]
[175.52232, "o", "\u001b[?2004h> "]
[175.522423, "o", "                    # If not found on same line, check next line\r\n\u001b[?2004l\r"]
[175.522466, "o", "\u001b[?2004h> "]
[175.522554, "o", "                    if i + 1 < len(lines):\r\n\u001b[?2004l\r"]
[175.522597, "o", "\u001b[?2004h> "]
[175.522675, "o", "                        next_line = lines[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.522718, "o", "> "]
[175.522799, "o", "                        match = re.search(money_pattern, next_line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.522844, "o", "> "]
[175.522963, "o", "                        if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.523079, "o", "                            amount_str = match.group(1).replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.52313, "o", "                            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.523244, "o", "                                amount = float(amount_str)\r\n\u001b[?2004l\r"]
[175.523293, "o", "\u001b[?2004h> "]
[175.523383, "o", "                                return f\"{amount:.2f}\"\r\n\u001b[?2004l\r"]
[175.523431, "o", "\u001b[?2004h> "]
[175.523505, "o", "                            except ValueError:\r\n\u001b[?2004l\r"]
[175.523547, "o", "\u001b[?2004h> "]
[175.523604, "o", "                                pass\r\n\u001b[?2004l\r"]
[175.523645, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[175.523686, "o", "\u001b[?2004h> "]
[175.523723, "o", "    return None\r\n\u001b[?2004l\r"]
[175.523779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.5242, "o", "def process_receipts(img_dir, output_file):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Process all receipt images and create Excel file\"\"\""]
[175.524729, "o", "\r\n\u001b[?2004l\r"]
[175.524797, "o", "\u001b[?2004h> "]
[175.52495, "o", "    # Get all image files and sort by filename\r\n"]
[175.52501, "o", "\u001b[?2004l\r\u001b[?2004h"]
[175.525069, "o", "> "]
[175.525334, "o", "    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\r\n"]
[175.525395, "o", "\u001b[?2004l\r"]
[175.525449, "o", "\u001b[?2004h"]
[175.525503, "o", "> "]
[175.525556, "o", "    image_files.sort()\r\n\u001b[?2004l\r"]
[175.525606, "o", "\u001b[?2004h> "]
[175.525657, "o", "    \r\n\u001b[?2004l\r"]
[175.52571, "o", "\u001b[?2004h> "]
[175.525905, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.526032, "o", "    for filename in image_files:\r\n"]
[175.526091, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.526249, "o", "        print(f\"Processing {filename}...\")\r\n"]
[175.526317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.526483, "o", "        img_path = os.path.join(img_dir, filename)\r\n"]
[175.526546, "o", "\u001b[?2004l\r\u001b[?2004h"]
[175.526602, "o", ">         "]
[175.526655, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.526709, "o", "> "]
[175.526871, "o", "        # Extract text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.52699, "o", "        text = extract_text_from_image(img_path)\r\n"]
[175.52705, "o", "\u001b[?2004l\r\u001b[?2004h"]
[175.527106, "o", "> "]
[175.527159, "o", "        \r\n\u001b[?2004l\r"]
[175.527213, "o", "\u001b[?2004h> "]
[175.527369, "o", "        # Parse date and total amount\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.527498, "o", "        date = parse_date(text)\r\n"]
[175.527561, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.527723, "o", "        total_amount = parse_total_amount(text)\r\n"]
[175.527875, "o", "\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.527969, "o", "        results.append({\r\n\u001b[?2004l\r"]
[175.528032, "o", "\u001b[?2004h> "]
[175.528133, "o", "            'filename': filename,\r\n\u001b[?2004l\r"]
[175.528192, "o", "\u001b[?2004h> "]
[175.528271, "o", "            'date': date,\r\n\u001b[?2004l\r"]
[175.528332, "o", "\u001b[?2004h> "]
[175.528443, "o", "            'total_amount': total_amount\r\n\u001b[?2004l\r"]
[175.528499, "o", "\u001b[?2004h> "]
[175.52857, "o", "        })\r\n\u001b[?2004l\r"]
[175.528762, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.528849, "o", "        print(f\"  Date: {date}, Total: {total_amount}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.528917, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.529324, "o", "    # Create Excel file\r\n\u001b[?2004l\r\u001b[?2004h>     wb = Workbook()\r\n\u001b[?2004l\r\u001b[?2004h>     ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h>     ws.title = \"results\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.52941, "o", "    # Write header\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.529736, "o", "    ws.append(['filename', 'date', 'total_amount'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Write data\r\n\u001b[?2004l\r\u001b[?2004h>     for result in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.529953, "o", "        ws.append([result['filename'], result['date'], result['total_amount']])\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[175.530028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.530094, "o", "    # Save workbook\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.530156, "o", "> "]
[175.530217, "o", "    wb.save(output_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.530282, "o", "> "]
[175.530373, "o", "    print(f\"\\nResults saved to {output_file}\")\r\n\u001b[?2004l\r"]
[175.530438, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.530506, "o", "> "]
[175.530569, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.530695, "o", "    img_dir = \"/app/workspace/dataset/img\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.530832, "o", "    output_file = \"/app/workspace/stat_ocr.xlsx\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.530891, "o", "> "]
[175.530976, "o", "    process_receipts(img_dir, output_file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.531037, "o", "> EOF\r\n\u001b[?2004l\r"]
[175.532687, "o", "\u001b[?2004hroot@ba8dcb88372b:/app/workspace# "]
