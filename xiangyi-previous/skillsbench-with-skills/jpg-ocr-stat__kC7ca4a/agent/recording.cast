[512.843219, "i", "cat > extract_receipts.py << 'EOF'\nimport os\nimport re\nfrom PIL import Image, ImageEnhance\nimport pytesseract\nfrom openpyxl import Workbook\nfrom datetime import datetime\n\ndef extract_text_from_image(image_path):\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        if len(text.strip()) < 50:\n            img_gray = img.convert('L')\n            enhancer = ImageEnhance.Contrast(img_gray)\n            img_enhanced = enhancer.enhance(2.0)\n            text = pytesseract.image_to_string(img_enhanced)\n        return text\n    except Exception as e:\n        print(f\"Error processing {image_path}: {e}\")\n        return \"\"\n\ndef parse_date(text):\n    date_patterns = [\n        (r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', 'YYYY-MM-DD'),\n        (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})', 'DD-MM-YYYY'),\n        (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{4})', 'DD Mon YYYY'),\n        (r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{1,2}),?\\s+(\\d{4})', 'Mon DD YYYY'),\n        (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{2})(?!\\d)', 'DD-MM-YY'),\n        (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{2})(?!\\d)', 'DD Mon YY'),\n    ]\n    \n    month_map = {'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,\n                 'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12}\n    \n    for pattern, format_type in date_patterns:\n        matches = re.finditer(pattern, text, re.IGNORECASE)\n        for match in matches:\n            try:\n                groups = match.groups()\n                if len(groups) == 3:\n                    if format_type == 'YYYY-MM-DD':\n                        date_obj = datetime(int(groups[0]), int(groups[1]), int(groups[2]))\n                    elif format_type == 'DD-MM-YYYY':\n                        date_obj = datetime(int(groups[2]), int(groups[1]), int(groups[0]))\n                    elif format_type == 'DD Mon YYYY':\n                        month = month_map.get(groups[1][:3].lower())\n    "]
[512.846187, "o", "cat > extract_receipts.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image, ImageEnhance\r\n\u001b[?2004l\r\u001b[?2004h> import pytesseract\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import Workbook\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_text_from_image(image_path):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         img = Image.open(image_path)\r\n\u001b[?2004l\r\u001b[?2004h>         text = pytesseract.image_to_string(img)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(text.strip()) < 50:\r\n\u001b[?2004l\r\u001b[?2004h>             img_gray = img.convert('L')\r\n\u001b[?2004l\r\u001b[?2004h>             enhancer = ImageEnhance.Contrast(img_gray)\r\n\u001b[?2004l\r\u001b[?2004h>             img_enhanced = enhancer.enhance(2.0)\r\n\u001b[?2004l\r\u001b[?2004h>             text = pytesseract.image_to_string(img_enhanced)\r\n\u001b[?2004l\r\u001b[?2004h>         return text\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error processing {image_path}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h>         return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_date(text):\r\n\u001b[?2004l\r\u001b[?2004h>     date_patterns = [\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', 'YYYY-MM-DD'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})', 'DD-MM-YYYY'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{4})', 'DD Mon YYYY'),\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{1,2}),?\\s+(\\d{4})', 'Mon DD YYYY'),"]
[512.846465, "i", "                    if month:\n                            date_obj = datetime(int(groups[2]), month, int(groups[0]))\n                        else:\n                            continue\n                    elif format_type == 'Mon DD YYYY':\n                        month = month_map.get(groups[0][:3].lower())\n                        if month:\n                            date_obj = datetime(int(groups[2]), month, int(groups[1]))\n                        else:\n                            continue\n                    elif format_type == 'DD-MM-YY':\n                        year = int(groups[2])\n                        full_year = 2000 + year if year < 50 else 1900 + year\n                        date_obj = datetime(full_year, int(groups[1]), int(groups[0]))\n                    elif format_type == 'DD Mon YY':\n                        month = month_map.get(groups[1][:3].lower())\n                        if month:\n                            year = int(groups[2])\n                            full_year = 2000 + year if year < 50 else 1900 + year\n                            date_obj = datetime(full_year, month, int(groups[0]))\n                        else:\n                            continue\n                    else:\n                        continue\n                    \n                    if 2000 <= date_obj.year <= 2030:\n                        return date_obj.strftime('%Y-%m-%d')\n            except (ValueError, IndexError):\n                continue\n    \n    return None\n\ndef fix_ocr_amount(amount_str):\n    fixes = {'u': '0', 'U': '0', 'o': '0', 'O': '0', 'l': '1', 'I': '1', 'S': '5', 'Z': '2'}\n    result = amount_str\n    for old, new in fixes.items():\n        result = result.replace(old, new)\n    return result\n\ndef parse_total_amount(text):\n    lines = text.split('\\n')\n    \n    # More specific exclusion patterns\n    exclusion_patterns = [\n        'SUBTOTAL', 'SUB TOTAL', 'SUB-TOTAL',\n        'TOTAL GST', 'GST TOTAL', 'TOTAL TAX', 'TAX TOTAL',\n        'DISCOUNT', 'CHANGE', 'CASH TENDERED',\n        'EXCLUDED', 'GST SUMMARY'\n    ]\n    \n    keyword_groups = [\n        ['GRAND TOTAL'],\n        ['TOTAL RM', 'TOTAL: RM', 'TOTAL (RM)'],\n        ['TOTAL AMOUNT'],\n        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', \n         'TOTAL SALES', 'TOTAL AFTER', 'TOTAL', 'AMOUNT'],\n    ]\n    \n    money_patterns = [\n        r'(?:RM)?\\s*([\\d,]+\\.\\d{2})',\n        r'(?:RM)?\\s*([\\d,]+\\.[uUoOlI]{2})',\n        r'(?:RM)?\\s*([\\d,]+\\.[\\duUoOlI]{2})',\n    ]\n    \n    for keyword_list in keyword_groups:\n        for i, line in enumerate(lines):\n            line_upper = line.upper()\n            \n            # Skip if line matches exclusion patterns\n            if any(excl in line_upper for excl in exclusion_patterns):\n                continue\n            \n            # Check if line contains any keyword from current priority group\n            for keyword in keyword_list:\n                if keyword in line_upper:\n                    # Try to find amount on the same line\n                    for pattern in money_patterns:\n                        match = re.search(pattern, line)\n                        if match:\n                            amount_str = match.group(1).replace(',', '')\n                            amount_str = fix_ocr_amount(amount_str)\n                            try:\n                                amount = float(amount_str)\n                                return f\"{amount:.2f}\"\n                            except ValueError:\n                                pass\n                    \n                    # If not found on same line, check next line\n                    if i + 1 < len(lines):\n                        next_line = lines[i + 1]\n                        for pattern in money_patterns:\n                            match = re.search(pattern, next_line)\n                            if match:\n                                amount_str = match.group(1).replace(',', '')\n                                amount_str = fix_ocr_amount(amount_str)\n                                try:\n                                    amount = float(amou"]
[512.846517, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{2})(?!\\d)', 'DD-MM-YY'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.846545, "i", "nt_str)\n                                    return f\"{amount:.2f}\"\n                                except ValueError:\n                                    pass\n    \n    return None\n\ndef process_receipts(img_dir, output_file):\n    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\n    image_files.sort()\n    \n    results = []\n    \n    for filename in image_files:\n        print(f\"Processing {filename}...\")\n        img_path = os.path.join(img_dir, filename)\n        \n        text = extract_text_from_image(img_path)\n        date = parse_date(text)\n        total_amount = parse_total_amount(text)\n        \n        results.append({\n            'filename': filename,\n            'date': date,\n            'total_amount': total_amount\n        })\n        \n        print(f\"  Date: {date}, Total: {total_amount}\")\n    \n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"results\"\n    \n    ws.append(['filename', 'date', 'total_amount'])\n    \n    for result in results:\n        ws.append([result['filename'], result['date'], result['total_amount']])\n    \n    wb.save(output_file)\n    print(f\"\\nResults saved to {output_file}\")\n\nif __name__ == \"__main__\":\n    img_dir = \"/app/workspace/dataset/img\"\n    output_file = \"/app/workspace/stat_ocr.xlsx\"\n    process_receipts(img_dir, output_file)\nEOF\n"]
