[337.051276, "o", "  Date: 2017-03-13, Total: 5.00"]
[337.051667, "o", "\r\n"]
[337.051811, "o", "Processing 094.jpg..."]
[337.05191, "o", "\r\n"]
[338.435086, "o", "  Date: 2018-02-09, Total: 5.90\r\nProcessing 097.jpg...\r\n"]
