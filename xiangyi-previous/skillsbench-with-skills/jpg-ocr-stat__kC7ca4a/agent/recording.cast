[566.573082, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('stat_ocr.xlsx')\nws = wb.active\n\nprint(\"Final results:\")\nfor row in ws.iter_rows(values_only=True):\n    print(row)\n\nnone_dates = sum(1 for i, row in enumerate(ws.iter_rows(values_only=True)) if i > 0 and row[1] is None)\nnone_amounts = sum(1 for i, row in enumerate(ws.iter_rows(values_only=True)) if i > 0 and row[2] is None)\n\nprint(f\"\\nMissing dates: {none_dates}, Missing amounts: {none_amounts}\")\nEOF\n"]
