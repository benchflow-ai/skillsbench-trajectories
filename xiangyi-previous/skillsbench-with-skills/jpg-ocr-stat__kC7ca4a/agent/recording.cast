[237.567822, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('stat_ocr.xlsx')\nws = wb.active\n\nprint(f\"Sheet name: {ws.title}\")\nprint(f\"Total rows: {ws.max_row}\")\nprint(f\"Total columns: {ws.max_column}\")\nprint(\"\\nAll rows:\")\nfor row in ws.iter_rows(values_only=True):\n    print(row)\n\n# Count None values\nnone_dates = 0\nnone_amounts = 0\nfor i, row in enumerate(ws.iter_rows(values_only=True)):\n    if i == 0:  # Skip header\n        continue\n    if row[1] is None:\n        none_dates += 1\n    if row[2] is None:\n        none_amounts += 1\n\nprint(f\"\\nStatistics:\")\nprint(f\"Receipts with missing dates: {none_dates}\")\nprint(f\"Receipts with missing amounts: {none_amounts}\")\nEOF\n"]
[237.569191, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('stat_ocr.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Sheet name: {ws.title}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total rows: {ws.max_row}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total columns: {ws.max_column}\")"]
[237.569353, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.569462, "o", "> print(\"\\nAll rows:\")"]
[237.569648, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.569712, "o", "> for row in ws.iter_rows(values_only=True):"]
[237.569778, "o", "\r\n"]
[237.569843, "o", "\u001b[?2004l\r"]
