[134.101008, "o", "\r\n\r\nGST fo. 000145047552\r\n\r\nInvoice number. 60000152273\r\n\r\n39.42 litre Punp # 09\r\npotas Rn 85. 84 €\r\n2\r\n\r\nRN / litre\r\nTotal RN 85. 54\r\nVisa RN 985. 54\r\n\r\nRelief GST  £ RN 0.00\r\nTotal Gross C RN 85.54\r\nShell Lo ae Card\r\n6018840059147765\r\n\r\nPoints Awarded: 39\r\n\r\nTite Nun OPT\r\n7B 02/18 08:28 10886 09\r\n"]
[134.10105, "o", "\r\nDiesel & Petrol RON9S5\r\npee Relief under Section\r\n6 (3) (b) GST Act 2014\r\n\r\nThank you\r\nPlease come again\r\n\r\n\r\n"]
[134.101084, "o", "=== End ===\r\n"]
[134.121853, "o", "\u001b[?2004hroot@ba8dcb88372b:/app/workspace# "]
[175.477606, "i", "cat > extract_receipts.py << 'EOF'\nimport os\nimport re\nfrom PIL import Image\nimport pytesseract\nfrom openpyxl import Workbook\nfrom datetime import datetime\n\ndef extract_text_from_image(image_path):\n    \"\"\"Extract text from image using Tesseract OCR\"\"\"\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        return text\n    except Exception as e:\n        print(f\"Error processing {image_path}: {e}\")\n        return \"\"\n\ndef parse_date(text):\n    \"\"\"Extract date from OCR text and convert to ISO format\"\"\"\n    # Common date patterns - updated to include 2-digit years\n    date_patterns = [\n        # 4-digit year formats\n        (r'(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})', 'YYYY-MM-DD'),\n        (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})', 'DD-MM-YYYY'),\n        (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{4})', 'DD Mon YYYY'),\n        (r'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{1,2}),?\\s+(\\d{4})', 'Mon DD YYYY'),\n        # 2-digit year formats\n        (r'(\\d{1,2})[-/](\\d{1,2})[-/](\\d{2})(?!\\d)', 'DD-MM-YY'),\n        (r'(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{2})(?!\\d)', 'DD Mon YY'),\n    ]\n    \n    month_map = {'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,\n                 'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12}\n    \n    for pattern, format_type in date_patterns:\n        matches = re.finditer(pattern, text, re.IGNORECASE)\n        for match in matches:\n            try:\n                groups = match.groups()\n                if len(groups) == 3:\n                    if format_type == 'YYYY-MM-DD':\n                        date_obj = datetime(int(groups[0]), int(groups[1]), int(groups[2]))\n                    elif format_type == 'DD-MM-YYYY':\n                        date_obj = datetime(int(groups[2]), int(groups[1]), int(groups[0]))\n                    elif format_type == 'DD Mon YYYY':\n                        month = month_map.get(groups[1][:3].lower())\n                 "]
[175.477856, "i", "       if month:\n                            date_obj = datetime(int(groups[2]), month, int(groups[0]))\n                        else:\n                            continue\n                    elif format_type == 'Mon DD YYYY':\n                        month = month_map.get(groups[0][:3].lower())\n                        if month:\n                            date_obj = datetime(int(groups[2]), month, int(groups[1]))\n                        else:\n                            continue\n                    elif format_type == 'DD-MM-YY':\n                        # Assume 2-digit year: 00-49 -> 2000-2049, 50-99 -> 1950-1999\n                        year = int(groups[2])\n                        full_year = 2000 + year if year < 50 else 1900 + year\n                        date_obj = datetime(full_year, int(groups[1]), int(groups[0]))\n                    elif format_type == 'DD Mon YY':\n                        month = month_map.get(groups[1][:3].lower())\n                        if month:\n                            year = int(groups[2])\n                            full_year = 2000 + year if year < 50 else 1900 + year\n                            date_obj = datetime(full_year, month, int(groups[0]))\n                        else:\n                            continue\n                    else:\n                        continue\n                    \n                    # Validate date is reasonable (between 2000 and 2030)\n                    if 2000 <= date_obj.year <= 2030:\n                        return date_obj.strftime('%Y-%m-%d')\n            except (ValueError, IndexError):\n                continue\n    \n    return None\n\ndef parse_total_amount(text):\n    \"\"\"Extract total amount from OCR text using priority keywords\"\"\"\n    lines = text.split('\\n')\n    \n    # Exclusion keywords\n    exclusion_keywords = ['SUBTOTAL', 'SUB TOTAL', 'TAX', 'GST', 'SST', 'DISCOUNT', 'CHANGE', 'CASH TENDERED']\n    \n    # Priority keyword groups (in order of priority)\n    keyword_groups = [\n        ['GRAND TOTAL'],\n        ['TOTAL RM', 'TOTAL: RM'],\n        "]
[175.477896, "o", "cat > extract_receipts.py << 'EOF'\r\n\u001b[?2004l\r"]
[175.477966, "o", "\u001b[?2004h> import os"]
[175.477998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.478029, "o", "> "]
[175.478057, "o", "import re\r\n\u001b[?2004l\r"]
[175.478087, "o", "\u001b[?2004h> "]
[175.478284, "o", "from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import pytesseract\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.478357, "o", "from openpyxl import Workbook\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.478389, "o", "> "]
[175.478482, "o", "from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.478513, "o", "\u001b[?2004h> "]
[175.4786, "i", "['TOTAL AMOUNT'],\n        ['TOTAL DUE', 'AMOUNT DUE', 'BALANCE DUE', 'NETT TOTAL', 'NET TOTAL', 'TOTAL', 'AMOUNT'],\n    ]\n    \n    # Pattern to match monetary values - more flexible\n    money_pattern = r'(?:RM)?\\s*([\\d,]+\\.\\d{2})'\n    \n    for keyword_list in keyword_groups:\n        for i, line in enumerate(lines):\n            line_upper = line.upper()\n            \n            # Check if line contains exclusion keywords\n            if any(excl in line_upper for excl in exclusion_keywords):\n                continue\n            \n            # Check if line contains any keyword from current priority group\n            for keyword in keyword_list:\n                if keyword in line_upper:\n                    # Try to find amount on the same line\n                    match = re.search(money_pattern, line)\n                    if match:\n                        amount_str = match.group(1).replace(',', '')\n                        try:\n                            amount = float(amount_str)\n                            return f\"{amount:.2f}\"\n                        except ValueError:\n                            pass\n                    \n                    # If not found on same line, check next line\n                    if i + 1 < len(lines):\n                        next_line = lines[i + 1]\n                        match = re.search(money_pattern, next_line)\n                        if match:\n                            amount_str = match.group(1).replace(',', '')\n                            try:\n                                amount = float(amount_str)\n                                return f\"{amount:.2f}\"\n                            except ValueError:\n                                pass\n    \n    return None\n\ndef process_receipts(img_dir, output_file):\n    \"\"\"Process all receipt images and create Excel file\"\"\"\n    # Get all image files and sort by filename\n    image_files = [f for f in os.listdir(img_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\n    image_files.sort()\n    \n    results = []\n    \n    for filename in im"]
[175.478639, "o", "def extract_text_from_image(image_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.478756, "i", "age_files:\n        print(f\"Processing {filename}...\")\n        img_path = os.path.join(img_dir, filename)\n        \n        # Extract text\n        text = extract_text_from_image(img_path)\n        \n        # Parse date and total amount\n        date = parse_date(text)\n        total_amount = parse_total_amount(text)\n        \n        results.append({\n            'filename': filename,\n            'date': date,\n            'total_amount': total_amount\n        })\n        \n        print(f\"  Date: {date}, Total: {total_amount}\")\n    \n    # Create Excel file\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"results\"\n    \n    # Write header\n    ws.append(['filename', 'date', 'total_amount'])\n    \n    # Write data\n    for result in results:\n        ws.append([result['filename'], result['date'], result['total_amount']])\n    \n    # Save workbook\n    wb.save(output_file)\n    print(f\"\\nResults saved to {output_file}\")\n\nif __name__ == \"__main__\":\n    img_dir = \"/app/workspace/dataset/img\"\n    output_file = \"/app/workspace/stat_ocr.xlsx\"\n    process_receipts(img_dir, output_file)\nEOF\n"]
