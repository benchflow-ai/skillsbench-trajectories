[?2004hroot@971248ce6459:~# mkdir -p /root/output
[?2004l[?2004hroot@971248ce6459:~# cat << 'EOF' > /root/analysis.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> from sklearn.ensemble import RandomForestRegressor
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> wt = pd.read_csv('/root/data/water_temperature.csv')
[?2004l[?2004h> climate = pd.read_csv('/root/data/climate.csv')
[?2004l[?2004h> land = pd.read_csv('/root/data/land_cover.csv')
[?2004l[?2004h> hydro = pd.read_csv('/root/data/hydrology.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge data
[?2004l[?2004h> df = wt.merge(climate, on='Year').merge(land, on='Year').merge(hydro, on='Year')
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Trend Analysis
[?2004l[?2004h> slope, intercept, r_value, p_value, std_err = linregress(df['Year'], df['WaterTemperature'])
[?2004l[?2004h> trend_result = pd.DataFrame({'slope': [slope], 'p-value': [p_value]})
[?2004l[?2004h> trend_result.to_csv('/root/output/trend_result.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Importance Analysis
[?2004l[?2004h> # Define categories
[?2004l[?2004h> categories = {
[?2004l[?2004h>     'Heat': ['AirTempLake', 'Shortwave', 'Longwave'],
[?2004l[?2004h>     'Flow': ['Precip', 'Inflow', 'Outflow'],
[?2004l[?2004h>     'Wind': ['WindSpeedLake'],
[?2004l[?2004h>     'Human': ['DevelopedArea', 'AgricultureArea']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> features = [col for cols in categories.values() for col in cols]
[?2004l[?2004h> X = df[features]
[?2004l[?2004h> y = df['WaterTemperature']
[?2004l[?2004h> 
[?2004l[?2004h> # Train Random Forest
[?2004l[?2004h> rf = RandomForestRegressor(n_estimators=100, random_state=42)
[?2004l[?2004h> rf.fit(X, y)
[?2004l[?2004h> importances = rf.feature_importances_
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate importances by category
[?2004l[?2004h> cat_importance = {}
[?2004l[?2004h> for cat, cols in categories.items():
[?2004l[?2004h>     cat_importance[cat] = sum(importances[features.index(col)] for col in cols)
[?2004l[?2004h> 
[?2004l[?2004h> # Find the most important category
[?2004l[?2004h> dominant_cat = max(cat_importance, key=cat_importance.get)
[?2004l[?2004h> contribution = cat_importance[dominant_cat]
[?2004l[?2004h> 
[?2004l[?2004h> # Save dominant factor
[?2004l[?2004h> dominant_factor = pd.DataFrame({'variable': [dominant_cat], 'contribution': [contribution]})
[?2004l[?2004h> dominant_factor.to_csv('/root/output/dominant_factor.csv', index=False)
[?2004l[?2004h> EOF
