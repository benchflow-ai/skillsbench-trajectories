[127.713947, "i", "cat <<EOF > debug_ppt.py\nfrom pptx import Presentation\n\nprint(\"--- Debugging Processed File ---\")\nprs = Presentation(\"/root/Awesome-Agent-Papers_processed.pptx\")\nlast_slide = prs.slides[-1]\nprint(f\"Last Slide Title: {last_slide.shapes.title.text}\")\n\nfor shape in last_slide.shapes:\n    if shape.has_text_frame and shape != last_slide.shapes.title:\n        print(f\"Shape {shape.name} TextFrame:\")\n        for i, p in enumerate(shape.text_frame.paragraphs):\n            print(f\"  Para {i}: '{p.text}'\")\n\nprint(\"\\n--- Debugging Title Extraction Logic ---\")\n# Re-check extraction logic on the original file (or processed if they are still there)\n# We can check processed file slides 0-2\nfor i, slide in enumerate(prs.slides[:3]):\n    print(f\"Slide {i}:\")\n    for shape in slide.shapes:\n        if not shape.has_text_frame:\n            continue\n        if shape.is_placeholder:\n            continue\n        if not shape.text.strip():\n            continue\n        print(f\"  Found Candidate: '{shape.text}'\")\n        print(f\"  Font: {shape.text_frame.paragraphs[0].font.name}, Size: {shape.text_frame.paragraphs[0].font.size}, Color: {shape.text_frame.paragraphs[0].font.color.rgb if shape.text_frame.paragraphs[0].font.color else 'None'}\")\nEOF\n"]
