[104.76821, "i", "cat <<EOF > verify_ppt.py\nfrom pptx import Presentation\n\nprs = Presentation(\"/root/Awesome-Agent-Papers_processed.pptx\")\nprint(f\"Total slides: {len(prs.slides)}\")\nlast_slide = prs.slides[-1]\nprint(f\"Last slide title: {last_slide.shapes.title.text}\")\nfor shape in last_slide.shapes:\n    if shape.has_text_frame and shape != last_slide.shapes.title:\n        print(\"Content found:\")\n        for p in shape.text_frame.paragraphs:\n            print(f\" - {p.text[:50]}...\")\n            # Check if xml indicates numbering\n            if '<a:buAutoNum' in p._p.xml:\n                print(\"   (Has auto-numbering XML)\")\nEOF\n"]
