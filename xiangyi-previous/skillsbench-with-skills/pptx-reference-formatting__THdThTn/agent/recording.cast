[92.545912, "o", "> "]
[92.546056, "o", "        # If the user wants strictly 'auto-numbered', manual '1. ', '2. ' is often accepted as a solution in scripts \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.546147, "o", "        # unless the file is meant to be edited later.\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.546198, "o", "> "]
[92.546256, "o", "        # Given the constraints, manual numbering is robust.\r\n\u001b[?2004l\r"]
[92.546281, "o", "\u001b[?2004h> "]
[92.546306, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.54638, "o", "\u001b[?2004h> "]
[92.546434, "o", "    text_frame.clear()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.546484, "o", "    for i, title in enumerate(unique_titles, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.54654, "o", "        p = text_frame.add_paragraph()\r\n\u001b[?2004l\r"]
[92.546591, "o", "\u001b[?2004h> "]
[92.546641, "o", "        p.text = title\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.546708, "o", "        # To make it a real numbered list, we'd need to tweak XML.\r\n\u001b[?2004l\r"]
[92.546753, "o", "\u001b[?2004h> "]
[92.546812, "o", "        # I'll add a snippet to try to enable numbering.\r\n\u001b[?2004l\r"]
[92.546863, "o", "\u001b[?2004h> "]
[92.546913, "o", "        pPr = p._p.get_or_add_pPr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.546962, "o", "        buFont = OxmlElement('a:buFont')\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.547015, "o", "> "]
[92.547066, "o", "        buFont.set('typeface', 'Arial')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.547119, "o", "        # pPr.append(buFont) # Optional\r\n\u001b[?2004l\r"]
[92.547163, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.547239, "o", "        buAutoNum = OxmlElement('a:buAutoNum')\r\n\u001b[?2004l\r"]
[92.547293, "o", "\u001b[?2004h> "]
[92.547338, "o", "        buAutoNum.set('type', 'arabicPeriod')\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.547386, "o", "> "]
[92.54743, "o", "        pPr.insert(0, buAutoNum)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.547485, "o", "    prs.save(output_path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[92.547529, "o", "> "]
