[157.453378, "i", "cat <<EOF > test_extraction.py\nfrom pptx import Presentation\n\nprs = Presentation(\"/root/Awesome-Agent-Papers.pptx\")\nprint(f\"Slide width: {prs.slide_width}, Slide height: {prs.slide_height}\")\n\nfound_titles = []\n\nfor i, slide in enumerate(prs.slides):\n    print(f\"Processing Slide {i}\")\n    for shape in slide.shapes:\n        if not shape.has_text_frame:\n            continue\n        \n        # Check placeholder status\n        is_placeholder = shape.is_placeholder\n        print(f\"  Shape {shape.shape_id} '{shape.name}': placeholder={is_placeholder}, text_len={len(shape.text)}\")\n        \n        if is_placeholder:\n            continue\n            \n        if not shape.text.strip():\n            continue\n            \n        print(f\"    -> MATCH! Text: {shape.text[:50]}...\")\n        found_titles.append(shape.text.strip())\n\nprint(f\"\\nTotal titles found: {len(found_titles)}\")\nprint(\"Titles:\")\nfor t in found_titles:\n    print(f\" - {t}\")\nEOF\n"]
