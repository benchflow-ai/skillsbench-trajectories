[157.752798, "o", "    -> MATCH! Text: MultiAgentBench : Evaluating the Collaboration and...\r\n\r\nTotal titles found: 5\r\nTitles:\r\n - Foam-Agent: Towards Automated Intelligent CFD Workflows\r\n - ReAct: Synergizing Reasoning and Acting in Language Models\r\n - ReAct: Synergizing Reasoning and Acting in Language Models\r\n - Why Do Multi-Agent LLM Systems Fail?\r\n - MultiAgentBench : Evaluating the Collaboration and Competition of LLM agents\r\n"]
[157.775375, "o", "\u001b[?2004hroot@ad6040846d38:~# "]
[186.231817, "i", "cat <<EOF > process_ppt.py\nfrom pptx import Presentation\nfrom pptx.util import Pt, Inches\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN\nfrom pptx.oxml.xmlchemy import OxmlElement\n\ndef set_formatting(shape, slide_width, slide_height):\n    # Set position and size\n    shape.left = 0\n    shape.width = slide_width\n    # Place at bottom, e.g., 0.5 inches from bottom\n    shape.top = slide_height - Inches(0.8)\n    \n    text_frame = shape.text_frame\n    text_frame.word_wrap = False\n    \n    # Apply formatting to all paragraphs\n    for p in text_frame.paragraphs:\n        p.alignment = PP_ALIGN.CENTER\n        p.font.name = 'Arial'\n        p.font.size = Pt(16)\n        p.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n        p.font.bold = False\n\ndef add_numbered_bullet(paragraph):\n    pPr = paragraph._p.get_or_add_pPr()\n    # Add auto-numbering XML\n    buAutoNum = OxmlElement('a:buAutoNum')\n    buAutoNum.set('type', 'arabicPeriod')\n    # Check if already exists to avoid duplication if run multiple times (though we create new here)\n    existing = pPr.find(buAutoNum.tag)\n    if existing is None:\n        pPr.insert(0, buAutoNum)\n\ndef process_presentation(input_path, output_path):\n    prs = Presentation(input_path)\n    slide_width = prs.slide_width\n    slide_height = prs.slide_height\n    \n    titles = []\n    \n    # 1. Process existing slides\n    for slide in prs.slides:\n        for shape in slide.shapes:\n            if not shape.has_text_frame or shape.is_placeholder:\n                continue\n            \n            text = shape.text.strip()\n            if not text:\n                continue\n                \n            # Found a dangling title\n            # Clean text (remove newlines)\n            clean_text = text.replace('\\n', ' ')\n            titles.append(clean_text)\n            \n            # Update text to clean version and apply formatting\n            shape.text_frame.text = clean_text\n            set_formatting(shape, slide_width, slide_height)\n            \n    # 2. Create Reference Slide\n    # Remove duplicates while preserving order\n    unique_titles = []\n    seen = set()\n    for t in titles:\n        if t not in seen:\n            unique_titles.append(t)\n            seen.add(t)\n            \n    layout = prs.slide_layouts[1] # Title and Content\n    ref_slide = prs.slides.add_slide(layout)\n    ref_slide.shapes.title.text = \"Reference\"\n    \n    content_placeholder = ref_slide.placeholders[1]\n    tf = content_placeholder.text_frame\n    tf.clear()\n    \n    # tf.clear() leaves one empty paragraph. Use it.\n    if unique_titles:\n        p = tf.paragraphs[0]\n        p.text = unique_titles[0]\n        add_numbered_bullet(p)\n        \n        for title in unique_titles[1:]:\n            p = tf.add_paragraph()\n            p.text = title\n            add_numbered_bullet(p)\n            \n    prs.save(output_path)\n\nif __name__ == \"__main__\":\n    process_presentation('/root/Awesome-Agent-Papers.pptx', '/root/Awesome-Agent-Papers_processed.pptx')\nEOF\n"]
