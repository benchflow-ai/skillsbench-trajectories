[?2004lm[?2004h> def process_presentation(input_path, output_path):
[?2004l[?2004h>     prs = Presentation(input_path)
[?2004l[?2004h>     slide_width = prs.slide_width
[?2004l[?2004h>     slide_height = prs.slide_height
[?2004l[?2004h>     
[?2004l[?2004h>     paper_titles = []
[?2004ll [?2004h>     
[?2004l[?2004h>     # Iterate through slides to process dangling titles
[?2004l[?2004h>     for slide in prs.slides:
[?2004l[?2004h>         # Identify dangling titles (text boxes that are not placeholders)
[?2004l[?2004h>         # We iterate a copy of shapes because we might modify them, though usually safe here
[?2004lt[?2004h>         for shape in slide.shapes:
[?2004l[?2004h>             if not shape.has_text_frame:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # Skip placeholders (Title, Content, etc.)
[?2004l[?2004h>             if shape.is_placeholder:
[?2004lL is too c[?2004h>                 continue
[?2004lto-[?2004h>             
[?2004l[?2004h>             # Check if it has text
[?2004l[?2004h>             if not shape.text.strip():
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # This is likely our dangling paper title
[?2004l[?2004h>             # Apply formatting
[?2004l[?2004h>             text_frame = shape.text_frame
[?2004l[?2004h>             text_frame.clear()  # Clear existing formatting to be safe, but we need the text back
[?2004l[?2004h>             
[?2004l[?2004h>             # Actually, better to iterate paragraphs/runs to preserve text but change style
[?2004l[?2004h>             # But requirement says 'change font type...', implies uniform style.
[?2004l[?2004h>             # Let's get the text first
[?2004l[?2004h>             full_text = shape.text.replace('\n', ' ').strip()
[?2004l[?2004h>             paper_titles.append(full_text)
[?2004l[?2004h>             
[?2004l[?2004h>             # Clear and set new text to ensure clean formatting
[?2004l[?2004h>             text_frame.text = full_text
[?2004l[?2004h>             
[?2004l[?2004h>             for paragraph in text_frame.paragraphs:
[?2004l[?2004h>                 paragraph.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>                 paragraph.font.name = 'Arial'
[?2004l[?2004h>                 paragraph.font.size = Pt(16)
[?2004l[?2004h>                 paragraph.font.color.rgb = RGBColor(0x98, 0x95, 0x96)
[?2004l[?2004h>                 paragraph.font.bold = False
[?2004l[?2004h>             
[?2004l[?2004h>             # Adjust box width to slide width (to ensure one line if possible)
[?2004l[?2004h>             shape.width = slide_width
[?2004l[?2004h>             shape.left = 0
[?2004l[?2004h>             
[?2004l[?2004h>             # Disable word wrap if possible to force one line? 
[?2004l[?2004h>             # python-pptx text_frame.word_wrap = False might help, but setting width wide is key.
[?2004l[?2004h>             text_frame.word_wrap = False
[?2004l[?2004h>             
[?2004l[?2004h>             # Put at bottom center
[?2004l[?2004h>             # We already centered horizontally by setting width=slide_width and align=center
[?2004l[?2004h>             # Now set vertical position. Let's say 0.5 inch from bottom.
[?2004l[?2004h>             shape.top = slide_height - Inches(1.0)
[?2004l[?2004h>             
[?2004l[?2004h>     # Remove duplicates from titles while preserving order (if desired, or just set)
[?2004l[?2004h>     # Requirement: 'remove duplicate papers'
[?2004l[?2004h>     unique_titles = []
[?2004l[?2004h>     seen = set()
[?2004l[?2004h>     for t in paper_titles:
[?2004l[?2004h>         if t not in seen:
[?2004l[?2004h>             unique_titles.append(t)
[?2004l[?2004h>             seen.add(t)
[?2004l[?2004h>             
[?2004l[?2004h>     # Create Reference slide
[?2004l[?2004h>     layout = prs.slide_layouts[1] # Title and Content
[?2004l[?2004h>     slide = prs.slides.add_slide(layout)
[?2004l[?2004h>     slide.shapes.title.text = "Reference"
[?2004l[?2004h>     
[?2004l[?2004h>     # Add content
[?2004l[?2004h>     content_placeholder = slide.placeholders[1]
[?2004l[?2004h>     text_frame = content_placeholder.text_frame
[?2004l[?2004h>     text_frame.clear()
[?2004l[?2004h>     
[?2004l[?2004h>     for title in unique_titles:
[?2004l[?2004h>         p = text_frame.add_paragraph()
[?2004l[?2004h>         p.text = title
[?2004l[?2004h>         # Auto-numbered bullet points? 
[?2004l[?2004h>         # PowerPoint handles bullets. Numbered bullets are a specific format.
[?2004l[?2004h>         # python-pptx doesn't easily support setting numbered lists on existing paragraphs without xml hacking.
[?2004l[?2004h>         # However, standard content placeholders usually default to bullet points.
[?2004l[?2004h>         # Requirement: 'auto-numbered bullet points'. 
[?2004l[?2004h>         # We can try to assume the template supports it or just use text numbering if necessary.
[?2004l[?2004h>         # But let's try to do it properly if possible, or just rely on default bullets.
[?2004l[?2004h>         # Actually, 'auto-numbered' implies a numbered list.
[?2004l[?2004h>         # Changing paragraph level to numbered requires interacting with pPr (paragraph properties).
[?2004l[?2004h>         
[?2004l[?2004h>         # Let's try a simple approach first: just add text. If we strictly need numbers:
[?2004l[?2004h>         # We can simulate it or try to set the type.
[?2004l[?2004h>         pass
[?2004l[?2004h>         
[?2004l[?2004h>     # To strictly set numbered bullets requires XML manipulation in python-pptx currently.
[?2004l[?2004h>     # Let's add a helper to set numbering if possible, or just proceed.
[?2004l[?2004h>     # Since I cannot easily verify XML correctness without trial, I will try to set the formatting via XML if I can,
[?2004l[?2004h>     # or simply rely on the text being there. However, 'auto-numbered' is specific.
[?2004l[?2004h>     # A safer fallback is to manually number them if I can't set the property.
[?2004l[?2004h>     # '1. Title', '2. Title'. That is visually auto-numbered.
[?2004l[?2004h>     # But the prompt says 'auto-numbered bullet points'.
[?2004l[?2004h>     # Let's try to set the XML for the text frame to be a numbered list.
[?2004l[?2004h>     
[?2004l[?2004h>     # Re-loop to set text with visual numbering if XML is too complex, 
[?2004l[?2004h>     # BUT 'auto-numbered bullet points' usually means the list feature.
[?2004l[?2004h>     # I will stick to adding paragraphs. I will try to set the numbering property.
[?2004l[?2004h>     
[?2004l[?2004h>     # A hack for numbering:
[?2004l[?2004h>     from pptx.oxml.xmlchemy import OxmlElement
[?2004l[?2004h>     def set_numbered_list(text_frame):
[?2004l[?2004h>         pPr = text_frame.paragraphs[0]._p.get_or_add_pPr()
[?2004l[?2004h>         # This is getting complicated. 
[?2004l[?2004h>         # Let's simply populate the text frame. 
[?2004l[?2004h>         # If the user wants strictly 'auto-numbered', manual '1. ', '2. ' is often accepted as a solution in scripts 
[?2004l[?2004h>         # unless the file is meant to be edited later.
[?2004l[?2004h>         # Given the constraints, manual numbering is robust.
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h>     text_frame.clear()
[?2004l[?2004h>     for i, title in enumerate(unique_titles, 1):
[?2004l[?2004h>         p = text_frame.add_paragraph()
[?2004l[?2004h>         p.text = title
[?2004l[?2004h>         # To make it a real numbered list, we'd need to tweak XML.
[?2004l[?2004h>         # I'll add a snippet to try to enable numbering.
[?2004l[?2004h>         pPr = p._p.get_or_add_pPr()
[?2004l[?2004h>         buFont = OxmlElement('a:buFont')
