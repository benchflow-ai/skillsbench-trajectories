[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.util import Pt, Inches
[?2004l[?2004h> from pptx.dml.color import RGBColor
[?2004l[?2004h> from pptx.enum.text import PP_ALIGN
[?2004l[?2004h> from pptx.oxml.xmlchemy import OxmlElement
[?2004l[?2004h> 
[?2004l[?2004h> def set_formatting(shape, slide_width, slide_height):
[?2004l[?2004h>     # Set position and size
[?2004l[?2004h>     shape.left = 0
[?2004l[?2004h>     shape.width = slide_width
[?2004l[?2004h>     # Place at bottom, e.g., 0.5 inches from bottom
[?2004l[?2004h>     shape.top = slide_height - Inches(0.8)
[?2004l[?2004h>     
[?2004l[?2004h>     text_frame = shape.text_frame
[?2004l[?2004h>     text_frame.word_wrap = False
[?2004l[?2004h>     
[?2004l[?2004h>     # Apply formatting to all paragraphs
[?2004l[?2004h>     for p in text_frame.paragraphs:
[?2004l[?2004h>         p.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>         p.font.name = 'Arial'
[?2004l[?2004h>         p.font.size = Pt(16)
[?2004l[?2004h>         p.font.color.rgb = RGBColor(0x98, 0x95, 0x96)
[?2004l[?2004h>         p.font.bold = False
[?2004l[?2004h> 
[?2004l[?2004h> def add_numbered_bullet(paragraph):
[?2004l[?2004h>     pPr = paragraph._p.get_or_add_pPr()
[?2004l[?2004h>     # Add auto-numbering XML
[?2004l[?2004h>     buAutoNum = OxmlElement('a:buAutoNum')
[?2004l[?2004h>     buAutoNum.set('type', 'arabicPeriod')
[?2004l[?2004h>     # Check if already exists to avoid duplication if run multiple times (though we create new here)
[?2004l[?2004h>     existing = pPr.find(buAutoNum.tag)
[?2004l[?2004h>     if existing is None:
[?2004l[?2004h>         pPr.insert(0, buAutoNum)
[?2004l[?2004h> 
[?2004l[?2004h> def process_presentation(input_path, output_path):
[?2004l[?2004h>     prs = Presentation(input_path)
[?2004l[?2004h>     slide_width = prs.slide_width
[?2004l[?2004h>     slide_height = prs.slide_height
[?2004l[?2004h>     
[?2004l[?2004h>     titles = []
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Process existing slides
[?2004l[?2004h>     for slide in prs.slides:
[?2004l[?2004h>         for shape in slide.shapes:
[?2004l[?2004h>             if not shape.has_text_frame or shape.is_placeholder:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             text = shape.text.strip()
[?2004l[?2004h>             if not text:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             # Found a dangling title
[?2004l[?2004h>             # Clean text (remove newlines)
[?2004l[?2004h>             clean_text = text.replace('\n', ' ')
[?2004l[?2004h>             titles.append(clean_text)
[?2004l[?2004h>             
[?2004l[?2004h>             # Update text to clean version and apply formatting
[?2004l[?2004h>             shape.text_frame.text = clean_text
[?2004l[?2004h>             set_formatting(shape, slide_width, slide_height)
[?2004l[?2004h>             
[?2004l[?2004h>     # 2. Create Reference Slide
[?2004l[?2004h>     # Remove duplicates while preserving order
[?2004l[?2004h>     unique_titles = []
[?2004l[?2004h>     seen = set()
[?2004l[?2004h>     for t in titles:
[?2004l[?2004h>         if t not in seen:
[?2004l[?2004h>             unique_titles.append(t)
[?2004l[?2004h>             seen.add(t)
[?2004l[?2004h>             
[?2004l[?2004h>     layout = prs.slide_layouts[1] # Title and Content
[?2004l[?2004h>     ref_slide = prs.slides.add_slide(layout)
[?2004l[?2004h>     ref_slide.shapes.title.text = "Reference"
[?2004l[?2004h>     
[?2004l[?2004h>     content_placeholder = ref_slide.placeholders[1]
[?2004l[?2004h>     tf = content_placeholder.text_frame
[?2004l[?2004h>     tf.clear()
[?2004l[?2004h>     
[?2004l[?2004h>     # tf.clear() leaves one empty paragraph. Use it.
[?2004l[?2004h>     if unique_titles:
[?2004l[?2004h>         p = tf.paragraphs[0]
[?2004l[?2004h>         p.text = unique_titles[0]
[?2004l[?2004h>         add_numbered_bullet(p)
[?2004l[?2004h>         
[?2004l[?2004h>         for title in unique_titles[1:]:
[?2004l[?2004h>             p = tf.add_paragraph()
[?2004l[?2004h>             p.text = title
[?2004l[?2004h>             add_numbered_bullet(p)
[?2004l[?2004h>             
[?2004l[?2004h>     prs.save(output_path)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     process_presentation('/root/Awesome-Agent-Papers.pptx', '/root/Awesome-Agent-Papers_processed.pptx')
