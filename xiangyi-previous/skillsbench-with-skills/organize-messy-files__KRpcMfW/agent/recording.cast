[164.138653, "o", "\u001b[?2004h"]
[164.13875, "o", "> "]
[164.138835, "o", "\r\n"]
[164.138921, "o", "\u001b[?2004l\r"]
[164.139015, "o", "\u001b[?2004h"]
[164.13912, "o", "> "]
[164.139248, "o", "def main():"]
[164.139334, "o", "\r\n"]
[164.139428, "o", "\u001b[?2004l\r"]
[164.139537, "o", "\u001b[?2004h"]
[164.139623, "o", "> "]
[164.139788, "o", "    source_dir = 'papers/all'"]
[164.13987, "o", "\r\n"]
[164.139954, "o", "\u001b[?2004l\r"]
[164.140049, "o", "\u001b[?2004h"]
[164.140143, "o", "> "]
[164.140268, "o", "    dest_dirs = {"]
[164.140398, "o", "\r\n"]
[164.14049, "o", "\u001b[?2004l\r"]
[164.140604, "o", "\u001b[?2004h"]
[164.140711, "o", "> "]
[164.140878, "o", "        'LLM': 'papers/LLM',"]
[164.14098, "o", "\r\n"]
[164.141085, "o", "\u001b[?2004l\r"]
[164.141203, "o", "\u001b[?2004h"]
[164.141308, "o", "> "]
[164.141594, "o", "        'trapped_ion_and_qc': 'papers/trapped_ion_and_qc',"]
[164.141693, "o", "\r\n"]
[164.141793, "o", "\u001b[?2004l\r"]
[164.141924, "o", "\u001b[?2004h"]
[164.142694, "o", "> "]
[164.143144, "o", "        'black_hole': 'papers/black_hole',"]
[164.143303, "o", "\r\n\u001b[?2004l\r"]
[164.143655, "o", "\u001b[?2004h> "]
[164.143818, "o", "        'DNA': 'papers/DNA',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.14397, "o", "        'music_history': 'papers/music_history'\r\n\u001b[?2004l\r"]
[164.144074, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.144153, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.144274, "o", "    files = os.listdir(source_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[164.144353, "o", "\u001b[?2004h> "]
[164.144426, "o", "    for filename in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.144559, "o", "        filepath = os.path.join(source_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.144626, "o", "> "]
[164.144722, "o", "        if not os.path.isfile(filepath):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.144814, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.144998, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.145146, "o", "        # Extract text based on file type\r\n\u001b[?2004l\r"]
[164.145205, "o", "\u001b[?2004h> "]
[164.145317, "o", "        if filename.lower().endswith('.pdf'):\r\n\u001b[?2004l\r"]
[164.145392, "o", "\u001b[?2004h> "]
[164.145657, "o", "            text = extract_pdf_text(filepath)\r\n\u001b[?2004l\r"]
[164.145747, "o", "\u001b[?2004h> "]
[164.14586, "o", "        elif filename.lower().endswith('.docx'):\r\n\u001b[?2004l\r"]
[164.145922, "o", "\u001b[?2004h> "]
[164.146026, "o", "            text = extract_docx_text(filepath)\r\n\u001b[?2004l\r"]
[164.146092, "o", "\u001b[?2004h> "]
[164.146197, "o", "        elif filename.lower().endswith('.pptx'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.146354, "o", "            text = extract_pptx_text(filepath)\r\n\u001b[?2004l\r"]
[164.146437, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.146504, "o", "> "]
[164.151648, "o", "            text = ''\r\n\u001b[?2004l\r"]
[164.151758, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[164.151817, "o", "\u001b[?2004h> "]
[164.151878, "o", "        # Classify\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.152014, "o", "        category = classify_file(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.15208, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.152141, "o", "        # Move file\r\n\u001b[?2004l\r"]
[164.152199, "o", "\u001b[?2004h> "]
[164.152319, "o", "        dest_path = os.path.join(dest_dirs[category], filename)\r\n\u001b[?2004l\r"]
[164.152381, "o", "\u001b[?2004h> "]
[164.152485, "o", "        shutil.move(filepath, dest_path)\r\n\u001b[?2004l\r"]
[164.15256, "o", "\u001b[?2004h> "]
[164.152692, "o", "        print(f'{filename} -> {category}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.152776, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.152855, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.152933, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.153008, "o", "> EOF\r\n\u001b[?2004l\r"]
