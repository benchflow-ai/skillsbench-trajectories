[164.132617, "o", "\u001b[?2004h"]
[164.132693, "o", "> "]
[164.132871, "o", "            score += text.count(kw.lower())"]
[164.132941, "o", "\r\n"]
[164.133008, "o", "\u001b[?2004l\r"]
