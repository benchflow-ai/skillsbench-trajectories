[164.136209, "o", "\u001b[?2004l\r"]
[164.1363, "o", "\u001b[?2004h"]
[164.136386, "o", "> "]
[164.13655, "o", "    for cat, score in scores.items():"]
[164.13664, "o", "\r\n"]
[164.136735, "o", "\u001b[?2004l\r"]
