[?2004l[?2004h>             'mutation', 'protein', 'rna', 'transcription', 'replication', 'helix', 'base pair',
[?2004l[?2004h>             'molecular biology', 'cell', 'enzyme', 'amino acid', 'biolog', 'organism', 'evolution'],
[?2004l[?2004h>     'music_history': ['music', 'composer', 'symphony', 'baroque', 'classical music', 'beethoven', 'mozart',
[?2004l[?2004h>                       'bach', 'opera', 'orchestra', 'sonata', 'concerto', 'musical', 'instrument',
[?2004l[?2004h>                       'melody', 'harmony', 'rhythm', 'romantic period', 'renaissance music', 'choir',
[?2004l[?2004h>                       'piano', 'violin', 'conductor']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def extract_pdf_text(filepath):
[?2004l[?2004h>     try:
[?2004l[?2004h>         result = subprocess.run(['pdftotext', filepath, '-'], capture_output=True, text=True, timeout=30)
[?2004l[?2004h>         return result.stdout.lower()
[?2004l[?2004h>     except:
[?2004l[?2004h>         return ''
[?2004l[?2004h> 
[?2004l[?2004h> def extract_docx_text(filepath):
[?2004l[?2004h>     try:
[?2004l[?2004h>         doc = Document(filepath)
[?2004l[?2004h>         text = ' '.join([para.text for para in doc.paragraphs])
[?2004l[?2004h>         return text.lower()
[?2004l[?2004h>     except:
[?2004l[?2004h>         return ''
[?2004l[?2004h> 
[?2004l[?2004h> def extract_pptx_text(filepath):
[?2004l[?2004h>     try:
[?2004l[?2004h>         prs = Presentation(filepath)
[?2004l[?2004h>         text = []
[?2004l[?2004h>         for slide in prs.slides:
[?2004l[?2004h>             for shape in slide.shapes:
[?2004l[?2004h>                 if hasattr(shape, 'text'):
[?2004l[?2004h>                     text.append(shape.text)
[?2004l[?2004h>         return ' '.join(text).lower()
[?2004l[?2004h>     except:
[?2004l[?2004h>         return ''
[?2004l[?2004h> 
[?2004l[?2004h> def classify_file(text):
[?2004l[?2004h>     scores = {}
[?2004l[?2004h>     for category, kws in keywords.items():
[?2004l[?2004h>         score = 0
[?2004l[?2004h>         for kw in kws:
[?2004l[?2004h>             score += text.count(kw.lower())
[?2004l[?2004h>         scores[category] = score
[?2004l[?2004h>     
[?2004l[?2004h>     # Find the category with highest score
[?2004l[?2004h>     max_score = max(scores.values())
[?2004l[?2004h>     if max_score == 0:
[?2004l[?2004h>         return 'music_history'  # Default category if no keywords found
[?2004l[?2004h>     
[?2004l[?2004h>     for cat, score in scores.items():
[?2004l[?2004h>         if score == max_score:
[?2004l[?2004h>             return cat
[?2004l[?2004h>     return 'music_history'
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     source_dir = 'papers/all'
[?2004l[?2004h>     dest_dirs = {
