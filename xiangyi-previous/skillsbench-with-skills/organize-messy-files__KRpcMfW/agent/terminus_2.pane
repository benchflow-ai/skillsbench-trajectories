[?2004l[?2004h>         'trapped_ion_and_qc': 'papers/trapped_ion_and_qc',
[?2004l[?2004h>         'black_hole': 'papers/black_hole',
[?2004l[?2004h>         'DNA': 'papers/DNA',
[?2004l[?2004h>         'music_history': 'papers/music_history'
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     files = os.listdir(source_dir)
[?2004l[?2004h>     
[?2004l[?2004h>     for filename in files:
[?2004l[?2004h>         filepath = os.path.join(source_dir, filename)
[?2004l[?2004h>         if not os.path.isfile(filepath):
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract text based on file type
[?2004l[?2004h>         if filename.lower().endswith('.pdf'):
[?2004l[?2004h>             text = extract_pdf_text(filepath)
[?2004l[?2004h>         elif filename.lower().endswith('.docx'):
[?2004l[?2004h>             text = extract_docx_text(filepath)
[?2004l[?2004h>         elif filename.lower().endswith('.pptx'):
[?2004l[?2004h>             text = extract_pptx_text(filepath)
[?2004l[?2004h>         else:
[?2004l[?2004h>             text = ''
[?2004l[?2004h>         
[?2004l[?2004h>         # Classify
[?2004l[?2004h>         category = classify_file(text)
[?2004l[?2004h>         
[?2004l[?2004h>         # Move file
