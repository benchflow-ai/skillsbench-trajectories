[?2004l[?2004h> import os
[?2004l[?2004h> import subprocess
[?2004l[?2004h> import shutil
[?2004l[?2004h> from docx import Document
[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> 
[?2004l[?2004h> # Define keywords for each category
[?2004l[?2004h> keywords = {
[?2004l[?2004h>     'LLM': ['language model', 'large language', 'llm', 'transformer', 'gpt', 'bert', 'attention mechanism', 
[?2004l[?2004h>             'neural network', 'nlp', 'natural language', 'token', 'embedding', 'fine-tuning', 'prompt',
[?2004l[?2004h>             'chatgpt', 'deep learning', 'machine learning', 'text generation', 'language understanding'],
[?2004l[?2004h>     'trapped_ion_and_qc': ['trapped ion', 'ion trap', 'quantum computing', 'qubit', 'quantum gate', 
[?2004l[?2004h>                            'entanglement', 'quantum information', 'quantum processor', 'quantum algorithm',
[?2004l[?2004h>                            'quantum error', 'quantum memory', 'quantum simulation', 'quantum state',
[?2004l[?2004h>                            'superposition', 'decoherence', 'quantum control', 'laser cooling', 'paul trap',
[?2004l[?2004h>                            'quantum logic', 'quantum bit', 'quantum circuit', 'quantum operation'],
[?2004l[?2004h>     'black_hole': ['black hole', 'event horizon', 'hawking', 'gravitational', 'singularity', 'spacetime',
