[?2004l# Proprietary Material Density Table

This table lists the density values for the proprietary materials used in the Constructo-95 system.
Use the Material ID found in the CAD file attributes to lookup the corresponding density.

| Material ID | Material Name | Density (g/cm³) | Description |
| :--- | :--- | :--- | :--- |
| **1** | Generic Debris | 0.10 | Low-density dust/noise artifacts. |
| **10** | Standard Steel | 7.85 | Common structural steel. |
| **25** | Aluminum 6061 | 2.70 | Aerospace grade aluminum. |
| **42** | Unobtanium | 5.55 | High-strength proprietary alloy. |
| **99** | Lead | 11.34 | Heavy ballast material. |

## Formula

$$ Mass = Volume \times Density $$

Note: Ensure volume is in $cm^3$ and density is in $g/cm^3$.
[?2004hroot@4b760350e83d:~# python3 << 'EOF'
[?2004l[?2004h> import struct
[?2004l[?2004h> import json
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # Read the binary STL file
[?2004l[?2004h> with open('/root/scan_data.stl', 'rb') as f:
[?2004l[?2004h>     # Read header (80 bytes)
[?2004l[?2004h>     header = f.read(80)
[?2004l[?2004h>     
[?2004l[?2004h>     # Read number of triangles (4 bytes, little-endian unsigned int)
[?2004l[?2004h>     num_triangles_bytes = f.read(4)
[?2004l[?2004h>     num_triangles = struct.unpack('<I', num_triangles_bytes)[0]
[?2004l[?2004h>     print(f"Number of triangles: {num_triangles}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Dictionary to store triangles by material ID
[?2004l[?2004h>     triangles_by_material = defaultdict(list)
[?2004l[?2004h>     
[?2004l[?2004h>     # Parse each triangle
[?2004l[?2004h>     for i in range(num_triangles):
[?2004l[?2004h>         # Each triangle record is 50 bytes:
[?2004l[?2004h>         # 12 bytes: normal vector (3 floats)
[?2004l[?2004h>         # 36 bytes: 3 vertices (9 floats)
[?2004l[?2004h>         # 2 bytes: attribute byte count (Material ID)
[?2004l[?2004h>         
[?2004l[?2004h>         normal = struct.unpack('<fff', f.read(12))
[?2004l[?2004h>         v1 = struct.unpack('<fff', f.read(12))
[?2004l[?2004h>         v2 = struct.unpack('<fff', f.read(12))
[?2004l[?2004h>         v3 = struct.unpack('<fff', f.read(12))
[?2004l[?2004h>         material_id_bytes = f.read(2)
[?2004l[?2004h>         material_id = struct.unpack('<H', material_id_bytes)[0]  # unsigned short
[?2004l[?2004h>         
[?2004l[?2004h>         triangles_by_material[material_id].append({
[?2004l[?2004h>             'normal': normal,
[?2004l[?2004h>             'v1': v1,
[?2004l[?2004h>             'v2': v2,
[?2004l[?2004h>             'v3': v3
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nMaterial IDs found: {sorted(triangles_by_material.keys())}")
[?2004l[?2004h>     print(f"Triangle counts by material:")
[?2004l[?2004h>     for mat_id in sorted(triangles_by_material.keys()):
[?2004l[?2004h>         print(f"  Material {mat_id}: {len(triangles_by_material[mat_id])} triangles")
[?2004l[?2004h>     
[?2004l[?2004h>     # Find the largest connected component (most triangles)
[?2004l[?2004h>     largest_material_id = max(triangles_by_material.keys(), 
[?2004l[?2004h>                               key=lambda x: len(triangles_by_material[x]))
[?2004l[?2004h>     largest_triangles = triangles_by_material[largest_material_id]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nLargest component: Material ID {largest_material_id} with {len(largest_triangles)} triangles")
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate volume using divergence theorem
[?2004l[?2004h>     # Volume = (1/6) * |sum of (v1 . (v2 x v3))| for all triangles
[?2004l[?2004h>     def cross_product(a, b):
[?2004l[?2004h>         return (
[?2004l[?2004h>             a[1]*b[2] - a[2]*b[1],
[?2004l[?2004h>             a[2]*b[0] - a[0]*b[2],
[?2004l[?2004h>             a[0]*b[1] - a[1]*b[0]
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def dot_product(a, b):
[?2004l[?2004h>         return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]
[?2004l[?2004h>     
[?2004l[?2004h>     volume_sum = 0.0
[?2004l[?2004h>     for tri in largest_triangles:
[?2004l[?2004h>         v1 = tri['v1']
[?2004l[?2004h>         v2 = tri['v2']
[?2004l[?2004h>         v3 = tri['v3']
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate v2 - v1 and v3 - v1
[?2004l[?2004h>         edge1 = (v2[0]-v1[0], v2[1]-v1[1], v2[2]-v1[2])
[?2004l[?2004h>         edge2 = (v3[0]-v1[0], v3[1]-v1[1], v3[2]-v1[2])
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate cross product
[?2004l[?2004h>         cross = cross_product(edge1, edge2)
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate dot product with v1
[?2004l[?2004h>         dot = dot_product(v1, cross)
[?2004l[?2004h>         
[?2004l[?2004h>         volume_sum += dot
[?2004l[?2004h>     
[?2004l[?2004h>     # Volume in cubic units (assuming STL is in mm, convert to cm³)
[?2004l[?2004h>     volume_mm3 = abs(volume_sum) / 6.0
[?2004l[?2004h>     volume_cm3 = volume_mm3 / 1000.0  # Convert mm³ to cm³
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\nVolume (mm³): {volume_mm3}")
[?2004l[?2004h>     print(f"Volume (cm³): {volume_cm3}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Material density table
[?2004l[?2004h>     density_table = {
[?2004l[?2004h>         1: 0.10,
[?2004l[?2004h>         10: 7.85,
[?2004l[?2004h>         25: 2.70,
[?2004l[?2004h>         42: 5.55,
[?2004l[?2004h>         99: 11.34
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     # Get density for the largest material
[?2004l[?2004h>     density = density_table.get(largest_material_id)
[?2004l[?2004h>     
[?2004l[?2004h>     if density is None:
[?2004l[?2004h>         print(f"ERROR: Material ID {largest_material_id} not found in density table")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print(f"Density for Material {largest_material_id}: {density} g/cm³")
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate mass
[?2004l[?2004h>         mass = volume_cm3 * density
[?2004l[?2004h>         print(f"\nMass: {mass} g")
[?2004l[?2004h>         
[?2004l[?2004h>         # Save to JSON
[?2004l[?2004h>         result = {
[?2004l[?2004h>             "main_part_mass": round(mass, 2),
[?2004l[?2004h>             "material_id": largest_material_id
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         with open('/root/mass_report.json', 'w') as out:
[?2004l[?2004h>             json.dump(result, out, indent=2)
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"\nResult saved to /root/mass_report.json")
[?2004l[?2004h>         print(json.dumps(result, indent=2))
[?2004l[?2004h> 
