[30.091179, "o", "> "]
[30.09122, "o", "            \"material_id\": largest_material_id\r\n\u001b[?2004l\r"]
[30.091259, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.091283, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.091348, "o", "> "]
[30.091394, "o", "        with open('/root/mass_report.json', 'w') as out:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.091479, "o", "            json.dump(result, out, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.091531, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.091611, "o", "        print(f\"\\nResult saved to /root/mass_report.json\")\r\n\u001b[?2004l\r"]
[30.091632, "o", "\u001b[?2004h> "]
