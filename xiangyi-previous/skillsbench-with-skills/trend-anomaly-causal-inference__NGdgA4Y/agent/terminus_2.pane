[?2004l[?2004h> # Identify demographic columns for feature engineering
[?2004l[?2004h> # Based on the head output earlier:
[?2004l[?2004h> # Q-demos-age, Q-demos-hispanic, Q-demos-race, Q-demos-education, Q-demos-income, Q-demos-gender, Q-sexual-orientation, Q-demos-state, ...
[?2004l[?2004h> 
[?2004l[?2004h> demo_cols = [
[?2004l[?2004h>     'Q-demos-age', 'Q-demos-hispanic', 'Q-demos-race', 'Q-demos-education', 
[?2004l[?2004h>     'Q-demos-income', 'Q-demos-gender', 'Q-sexual-orientation', 'Q-demos-state',
[?2004l[?2004h>     'Q-amazon-use-howmany', 'Q-amazon-use-hh-size', 'Q-amazon-use-how-oft',
[?2004l[?2004h>     'Q-substance-use-cigarettes', 'Q-substance-use-marijuana', 'Q-substance-use-alcohol',
[?2004l[?2004h>     'Q-personal-diabetes', 'Q-personal-wheelchair'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter for existing columns
[?2004l[?2004h> existing_cols = [col for col in demo_cols if col in survey.columns]
[?2004l[?2004h> 
[?2004l[?2004h> # One-hot encoding
[?2004l[?2004h> survey_features = pd.get_dummies(survey, columns=existing_cols, drop_first=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Keep ResponseID and the new features
[?2004l[?2004h> # The ResponseID is 'Survey ResponseID'
[?2004l[?2004h> output_cols = ['Survey ResponseID'] + [col for col in survey_features.columns if col not in survey.columns]
[?2004l[?2004h> survey_feature_engineered = survey_features[output_cols]
[?2004l[?2004h> 
[?2004l[?2004h> survey_feature_engineered.to_csv('/app/output/survey_feature_engineered.csv', index=False)
[?2004l[?2004h> print(f"Feature engineered survey: {survey_feature_engineered.shape}")
