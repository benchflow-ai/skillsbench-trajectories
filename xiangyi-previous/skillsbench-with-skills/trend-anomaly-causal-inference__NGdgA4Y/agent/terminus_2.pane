[?2004hroot@40089f4363bf:/app# mkdir -p /app/output
[?2004l[?2004hroot@40089f4363bf:/app# cat << 'EOF' > clean_data.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load datasets
[?2004l[?2004h> purchases = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv', low_memory=False)
[?2004l[?2004h> survey = pd.read_csv('/app/data/survey_dirty.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Clean purchases
[?2004l[?2004h> # 1. Convert Order Date
[?2004l[?2004h> purchases['Order Date'] = pd.to_datetime(purchases['Order Date'], errors='coerce')
[?2004l[?2004h> # 2. Convert Price and Quantity to numeric
[?2004l[?2004h> purchases['Purchase Price Per Unit'] = pd.to_numeric(purchases['Purchase Price Per Unit'], errors='coerce')
[?2004l[?2004h> purchases['Quantity'] = pd.to_numeric(purchases['Quantity'], errors='coerce')
[?2004l[?2004h> # 3. Drop rows with critical missing values
[?2004l[?2004h> purchases = purchases.dropna(subset=['Order Date', 'Purchase Price Per Unit', 'Quantity', 'Category', 'Survey ResponseID'])
[?2004l[?2004h> # 4. Filter for 2019-2020
[?2004l[?2004h> purchases = purchases[(purchases['Order Date'] >= '2019-01-01') & (purchases['Order Date'] <= '2020-12-31')]
[?2004l[?2004h> # 5. Remove duplicates
[?2004l[?2004h> purchases = purchases.drop_duplicates()
[?2004l[?2004h> # 6. Calculate Total Spend
[?2004l[?2004h> purchases['Total_Spend'] = purchases['Purchase Price Per Unit'] * purchases['Quantity']
[?2004l[?2004h> 
[?2004l[?2004h> # Clean survey
[?2004l[?2004h> # 1. Remove duplicates
[?2004l[?2004h> survey = survey.drop_duplicates(subset=['Survey ResponseID'])
[?2004l[?2004h> # 2. Basic cleaning of demographic columns (strip whitespace if any)
[?2004l[?2004h> for col in survey.columns:
[?2004l[?2004h>     if survey[col].dtype == 'object':
[?2004l[?2004h>         survey[col] = survey[col].str.strip()
[?2004l[?2004h> 
[?2004l[?2004h> # Keep only purchases from users in the survey
[?2004l[?2004h> purchases = purchases[purchases['Survey ResponseID'].isin(survey['Survey ResponseID'])]
[?2004l[?2004h> 
[?2004l[?2004h> # Save cleaned data
[?2004l[?2004h> survey.to_csv('/app/output/survey_cleaned.csv', index=False)
[?2004l[?2004h> purchases.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Cleaned purchases: {len(purchases)} rows")
[?2004l[?2004h> print(f"Cleaned survey: {len(survey)} rows")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@40089f4363bf:/app# python3 clean_data.py
[?2004lCleaned purchases: 438050 rows
Cleaned survey: 5027 rows
[?2004hroot@40089f4363bf:/app# cat << 'EOF' > detect_anomalies.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.linear_model import LinearRegression
[?2004l[?2004h> 
[?2004l[?2004h> # Load cleaned data
[?2004l[?2004h> purchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', parse_dates=['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate daily sales by category
[?2004l[?2004h> daily_sales = purchases.groupby(['Category', 'Order Date'])['Total_Spend'].sum().reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> categories = daily_sales['Category'].unique()
[?2004l[?2004h> anomaly_results = []
[?2004l[?2004h> 
[?2004l[?2004h> target_start = pd.Timestamp('2020-03-01')
[?2004l[?2004h> target_end = pd.Timestamp('2020-03-31')
[?2004l[?2004h> 
[?2004l[?2004h> for cat in categories:
[?2004l[?2004h>     cat_data = daily_sales[daily_sales['Category'] == cat].copy()
[?2004l[?2004h>     cat_data = cat_data.sort_values('Order Date')
[?2004l[?2004h>     
[?2004l[?2004h>     # Split into historical and target
[?2004l[?2004h>     hist_data = cat_data[cat_data['Order Date'] < target_start]
[?2004l[?2004h>     target_data = cat_data[(cat_data['Order Date'] >= target_start) & (cat_data['Order Date'] <= target_end)]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(hist_data) < 10:
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Prepare features for prediction (trend and day of week)
[?2004l[?2004h>     hist_data['days_since_start'] = (hist_data['Order Date'] - hist_data['Order Date'].min()).dt.days
[?2004l[?2004h>     hist_data['dow'] = hist_data['Order Date'].dt.dayofweek
[?2004l[?2004h>     
[?2004l[?2004h>     X_hist = pd.get_dummies(hist_data[['days_since_start', 'dow']], columns=['dow'])
[?2004l[?2004h>     y_hist = hist_data['Total_Spend']
[?2004l[?2004h>     
[?2004l[?2004h>     model = LinearRegression()
[?2004l[?2004h>     model.fit(X_hist, y_hist)
[?2004l[?2004h>     
[?2004l[?2004h>     # Predict for March 2020
[?2004l[?2004h>     # We need to create a range of dates for March 2020 to predict even if there were no sales on some days
[?2004l[?2004h>     march_dates = pd.date_range(start=target_start, end=target_end)
[?2004l[?2004h>     march_df = pd.DataFrame({'Order Date': march_dates})
[?2004l[?2004h>     march_df['days_since_start'] = (march_df['Order Date'] - hist_data['Order Date'].min()).dt.days
[?2004l[?2004h>     march_df['dow'] = march_df['Order Date'].dt.dayofweek
[?2004l[?2004h>     
[?2004l[?2004h>     X_march = pd.get_dummies(march_df[['days_since_start', 'dow']], columns=['dow'])
[?2004l[?2004h>     # Ensure all dow columns from training are present
[?2004l[?2004h>     for col in X_hist.columns:
[?2004l[?2004h>         if col not in X_march.columns:
[?2004l[?2004h>             X_march[col] = 0
[?2004l[?2004h>     X_march = X_march[X_hist.columns]
[?2004l[?2004h>     
[?2004l[?2004h>     y_pred = model.predict(X_march)
[?2004l[?2004h>     y_pred = np.maximum(y_pred, 0) # No negative sales predicted
[?2004l[?2004h>     
[?2004l[?2004h>     actual_march_sales = target_data['Total_Spend'].sum()
[?2004l[?2004h>     predicted_march_sales = y_pred.sum()
[?2004l[?2004h>     
[?2004l[?2004h>     if predicted_march_sales + actual_march_sales > 0:
[?2004l[?2004h>         # Deviation index from -100 to 100
[?2004l[?2004h>         index = 100 * (actual_march_sales - predicted_march_sales) / (actual_march_sales + predicted_march_sales)
[?2004l[?2004h>     else:
[?2004l[?2004h>         index = 0
[?2004l[?2004h>         
[?2004l[?2004h>     anomaly_results.append({'Category': cat, 'Anomaly_Index': index, 'Actual': actual_march_sales, 'Predicted': predicted_march_sales})
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_df = pd.DataFrame(anomaly_results)
[?2004l[?2004h> anomaly_df.to_csv('/app/output/category_anomaly_index.csv', index=False, columns=['Category', 'Anomaly_Index'])
[?2004l[?2004h> 
[?2004l[?2004h> # Identify top 10 surge and slump
[?2004l[?2004h> surge = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)
[?2004l[?2004h> slump = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)
[?2004l[?2004h> 
[?2004l[?2004h> print("Top 10 Surge Categories:")
[?2004l[?2004h> print(surge[['Category', 'Anomaly_Index']])
[?2004l[?2004h> print("\nTop 10 Slump Categories:")
[?2004l[?2004h> print(slump[['Category', 'Anomaly_Index']])
[?2004l[?2004h> EOF
