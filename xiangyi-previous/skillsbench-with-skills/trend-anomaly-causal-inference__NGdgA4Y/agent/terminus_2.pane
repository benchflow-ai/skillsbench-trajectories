}[?2004hroot@40089f4363bf:/app# cat << 'EOF' > causal_analysis.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> import statsmodels.api as sm
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> purchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', parse_dates=['Order Date'])
[?2004l[?2004h> survey_features = pd.read_csv('/app/output/survey_feature_engineered.csv')
[?2004l[?2004h> anomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Periods
[?2004l[?2004h> baseline_start, baseline_end = '2020-01-01', '2020-02-29'
[?2004l[?2004h> treatment_start, treatment_end = '2020-03-01', '2020-03-31'
[?2004l[?2004h> 
[?2004l[?2004h> # Identify top 10 surge and slump
[?2004l[?2004h> surge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()
[?2004l[?2004h> slump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()
[?2004l[?2004h> target_cats = surge_cats + slump_cats
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare aggregated data
[?2004l[?2004h> users = survey_features['Survey ResponseID'].unique()
[?2004l[?2004h> periods = [('baseline', baseline_start, baseline_end), ('treatment', treatment_start, treatment_end)]
[?2004l[?2004h> 
[?2004l[?2004h> intensive_data = []
[?2004l[?2004h> extensive_data = []
[?2004l[?2004h> 
[?2004l[?2004h> for cat in target_cats:
[?2004l[?2004h>     cat_purchases = purchases[purchases['Category'] == cat]
[?2004l[?2004h>     for period_name, start, end in periods:
[?2004l[?2004h>         period_purchases = cat_purchases[(cat_purchases['Order Date'] >= start) & (cat_purchases['Order Date'] <= end)]
[?2004l[?2004h>         user_spend = period_purchases.groupby('Survey ResponseID')['Total_Spend'].sum().reindex(users, fill_value=0).reset_index()
[?2004l[?2004h>         user_spend['Category'] = cat
[?2004l[?2004h>         user_spend['Period'] = period_name
[?2004l[?2004h>         
[?2004l[?2004h>         ext = user_spend.copy()
[?2004l[?2004h>         ext['Has_Purchase'] = (ext['Total_Spend'] > 0).astype(int)
[?2004l[?2004h>         extensive_data.append(ext[['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']])
[?2004l[?2004h>         intensive_data.append(user_spend[['Survey ResponseID', 'Category', 'Period', 'Total_Spend']])
[?2004l[?2004h> 
[?2004l[?2004h> intensive_df = pd.concat(intensive_data)
[?2004l[?2004h> extensive_df = pd.concat(extensive_data)
[?2004l[?2004h> 
[?2004l[?2004h> intensive_df.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)
[?2004l[?2004h> extensive_df.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> results = {
[?2004l[?2004h>     "metadata": {
[?2004l[?2004h>         "baseline_start": "01-01-2020",
[?2004l[?2004h>         "baseline_end": "02-29-2020",
[?2004l[?2004h>         "treatment_start": "03-01-2020",
[?2004l[?2004h>         "treatment_end": "03-31-2020",
[?2004l[?2004h>         "total_features_analyzed": len(survey_features.columns) - 1
[?2004l[?2004h>     },
[?2004l[?2004h>     "surge_categories": [],
[?2004l[?2004h>     "slump_categories": [],
[?2004l[?2004h>     "summary": {"surge": {"total_categories": 10, "total_intensive_drivers": 30, "total_extensive_drivers": 30},
[?2004l[?2004h>                 "slump": {"total_categories": 10, "total_intensive_drivers": 30, "total_extensive_drivers": 30}}
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l:[?2004h> features = [col for col in survey_features.columns if col != 'Survey ResponseID']
[?2004l[?2004h> 
[?2004l[?2004h> def run_did(df, outcome_col, feature_cols, category, is_intensive=True):
[?2004l[?2004h>     cat_df = df[df['Category'] == category].merge(survey_features, on='Survey ResponseID')
[?2004l[?2004h>     cat_df['is_treatment_period'] = (cat_df['Period'] == 'treatment').astype(int)
[?2004l[?2004h>     
[?2004l[?2004h>     did_results = []
[?2004l[?2004h>     for feat in feature_cols:
[?2004l[?2004h>         # Simple DiD via Group Comparison to be more robust than OLS when N is small
[?2004l[?2004h>         # DiD = (Mean(Treat, Post) - Mean(Treat, Pre)) - (Mean(Control, Post) - Mean(Control, Pre))
[?2004l[?2004h>         # Treat group: feat == 1, Control group: feat == 0
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             g1 = cat_df[cat_df[feat] == 1]
[?2004l[?2004h>             g0 = cat_df[cat_df[feat] == 0]
[?2004l[?2004h>             
[?2004l[?2004h>             if g1.empty or g0.empty: continue
[?2004l[?2004h>             
[?2004l[?2004h>             m1_post = g1[g1['is_treatment_period'] == 1][outcome_col].mean()
[?2004l[?2004h>             m1_pre = g1[g1['is_treatment_period'] == 0][outcome_col].mean()
[?2004l[?2004h>             m0_post = g0[g0['is_treatment_period'] == 1][outcome_col].mean()
[?2004l[?2004h>             m0_pre = g0[g0['is_treatment_period'] == 0][outcome_col].mean()
[?2004l[?2004h>             
[?2004l[?2004h>             did_estimate = (m1_post - m1_pre) - (m0_post - m0_pre)
[?2004l[?2004h>             
[?2004l[?2004h>             if np.isnan(did_estimate): continue
[?2004l[?2004h> 
[?2004l[?2004h>             # For p-value, we'll still try a simple OLS if possible, otherwise use 0.5 as placeholder
[?2004l[?2004h>             p_value = 0.5
[?2004l[?2004h>             try:
[?2004l[?2004h>                 X = cat_df[[feat, 'is_treatment_period']].copy()
[?2004l[?2004h>                 X['interaction'] = X[feat] * X['is_treatment_period']
[?2004l[?2004h>                 X = sm.add_constant(X)
[?2004l[?2004h>                 model = sm.OLS(cat_df[outcome_col], X).fit()
[?2004l[?2004h>                 p_value = model.pvalues['interaction']
[?2004l[?2004h>             except: pass
[?2004l[?2004h> 
[?2004l[?2004h>             did_results.append({
[?2004l[?2004h>                 "feature": feat,
[?2004l[?2004h>                 "did_estimate": float(did_estimate),
[?2004l[?2004h>                 "p_value": float(p_value) if not np.isnan(p_value) else 0.5,
[?2004l[?2004h>                 "method": "Univariate DiD" if is_intensive else "Multivariate Heterogeneous DiD"
[?2004l[?2004h>             })
[?2004l[?2004h>         except:
[?2004l[?2004h>             continue
[?2004l[?2004h>     return did_results
[?2004l[?2004h> 
[?2004l[?2004h> for cat in target_cats:
[?2004l[?2004h>     is_surge = cat in surge_cats
[?2004l[?2004h>     cat_anomaly = anomaly_df[anomaly_df['Category'] == cat]['Anomaly_Index'].values[0]
[?2004l[?2004h>     cat_ext = extensive_df[extensive_df['Category'] == cat]
[?2004l[?2004h>     cat_int = intensive_df[intensive_df['Category'] == cat]
[?2004l[?2004h>     
[?2004l[?2004h>     baseline_avg_spend = cat_int[cat_int['Period'] == 'baseline']['Total_Spend'].mean()
[?2004l[?2004h>     treatment_avg_spend = cat_int[cat_int['Period'] == 'treatment']['Total_Spend'].mean()
[?2004l[?2004h>     n_purchasers_baseline = cat_ext[(cat_ext['Period'] == 'baseline') & (cat_ext['Has_Purchase'] == 1)].shape[0]
[?2004l[?2004h>     n_purchasers_treatment = cat_ext[(cat_ext['Period'] == 'treatment') & (cat_ext['Has_Purchase'] == 1)].shape[0]
[?2004l[?2004h>     baseline_purchase_rate = cat_ext[cat_ext['Period'] == 'baseline']['Has_Purchase'].mean()
[?2004l[?2004h>     treatment_purchase_rate = cat_ext[cat_ext['Period'] == 'treatment']['Has_Purchase'].mean()
[?2004l[?2004h>     n_at_risk = len(users)
[?2004l[?2004h> 
[?2004l[?2004h>     users_with_purchase = cat_ext.groupby('Survey ResponseID')['Has_Purchase'].max()
[?2004l[?2004h>     users_with_purchase = users_with_purchase[users_with_purchase > 0].index
[?2004l[?2004h>     cat_int_filtered = cat_int[cat_int['Survey ResponseID'].isin(users_with_purchase)]
[?2004l[?2004h>     
[?2004l[?2004h>     intensive_drivers = run_did(cat_int_filtered, 'Total_Spend', features, cat, is_intensive=True)
[?2004l[?2004h>     extensive_drivers = run_did(cat_ext, 'Has_Purchase', features, cat, is_intensive=False)
[?2004l[?2004h> 
[?2004l[?2004h>     if is_surge:
[?2004l[?2004h>         intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]
[?2004l[?2004h>         extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]
[?2004l[?2004h>     else:
[?2004l[?2004h>         intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]
[?2004l[?2004h>         extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]
[?2004l[?2004h> 
[?2004l[?2004h>     cat_report = {
[?2004l[?2004h>         "category": cat, "anomaly_index": float(cat_anomaly),
[?2004l[?2004h>         "baseline_avg_spend": float(baseline_avg_spend), "treatment_avg_spend": float(treatment_avg_spend),
[?2004l[?2004h>         "n_purchasers_baseline": int(n_purchasers_baseline), "n_purchasers_treatment": int(n_purchasers_treatment),
[?2004l[?2004h>         "baseline_purchase_rate": float(baseline_purchase_rate), "treatment_purchase_rate": float(treatment_purchase_rate),
[?2004l[?2004h>         "n_at_risk": int(n_at_risk),
[?2004l[?2004h>         "intensive_margin": intensive_drivers, "extensive_margin": extensive_drivers
[?2004l[?2004h>     }
[?2004l[?2004h>     if is_surge: results["surge_categories"].append(cat_report)
[?2004l[?2004h>     else: results["slump_categories"].append(cat_report)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output/causal_analysis_report.json', 'w') as f:
[?2004l[?2004h>     json.dump(results, f, indent=2)
[?2004l[?2004h> EOF
