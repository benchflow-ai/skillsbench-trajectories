[44.549493, "o", "    X_march = X_march[X_hist.columns]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[44.549543, "o", "\u001b[?2004h> "]
[44.549598, "o", "    y_pred = model.predict(X_march)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.549699, "o", "    y_pred = np.maximum(y_pred, 0) # No negative sales predicted\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.549748, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.549829, "o", "    actual_march_sales = target_data['Total_Spend'].sum()\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.54988, "o", "> "]
[44.549931, "o", "    predicted_march_sales = y_pred.sum()\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[44.54998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.55003, "o", "    if predicted_march_sales + actual_march_sales > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550076, "o", "> "]
[44.550128, "o", "        # Deviation index from -100 to 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.550296, "o", "        index = 100 * (actual_march_sales - predicted_march_sales) / (actual_march_sales + predicted_march_sales)\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550343, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550391, "o", ">         index = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550443, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.550609, "o", "    anomaly_results.append({'Category': cat, 'Anomaly_Index': index, 'Actual': actual_march_sales, 'Predicted': predicted_march_sales})\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550663, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.550717, "o", "> "]
[44.550761, "o", "anomaly_df = pd.DataFrame(anomaly_results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.550892, "o", "anomaly_df.to_csv('/app/output/category_anomaly_index.csv', index=False, columns=['Category', 'Anomaly_Index'])\r\n\u001b[?2004l\r"]
[44.55095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.551004, "o", "> # Identify top 10 surge and slump\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.551111, "o", "surge = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.551164, "o", "> "]
[44.551242, "o", "slump = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.551295, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.551345, "o", "print(\"Top 10 Surge Categories:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.551401, "o", "print(surge[['Category', 'Anomaly_Index']])\r\n\u001b[?2004l\r"]
[44.551452, "o", "\u001b[?2004h> "]
[44.551504, "o", "print(\"\\nTop 10 Slump Categories:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.551557, "o", "print(slump[['Category', 'Anomaly_Index']])\r\n\u001b[?2004l\r"]
[44.55161, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[44.552856, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
[44.728283, "i", "python3 detect_anomalies.py\n"]
[44.728513, "o", "python3 detect_anomalies.py\r\n\u001b[?2004l\r"]
