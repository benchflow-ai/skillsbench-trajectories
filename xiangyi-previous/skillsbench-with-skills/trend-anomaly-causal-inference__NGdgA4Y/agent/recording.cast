[169.085391, "o", "                \"feature\": feat,\r\n\u001b[?2004l\r"]
[169.085411, "o", "\u001b[?2004h> "]
[169.085505, "o", "                \"did_estimate\": float(did_estimate),\r\n\u001b[?2004l\r"]
[169.085525, "o", "\u001b[?2004h> "]
[169.085658, "o", "                \"p_value\": float(p_value) if not np.isnan(p_value) else 0.5,\r\n\u001b[?2004l\r"]
[169.085683, "o", "\u001b[?2004h> "]
[169.085838, "o", "                \"method\": \"Univariate DiD\" if is_intensive else \"Multivariate Heterogeneous DiD\"\r\n\u001b[?2004l\r"]
[169.085863, "o", "\u001b[?2004h> "]
[169.085918, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.085958, "o", "        except:\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.08598, "o", "> "]
[169.086031, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.086055, "o", "> "]
[169.086105, "o", "    return did_results\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.086127, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[169.086145, "o", "> "]
[169.086206, "o", "for cat in target_cats:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.086274, "o", "    is_surge = cat in surge_cats\r\n\u001b[?2004l\r"]
[169.086298, "o", "\u001b[?2004h> "]
[169.08644, "o", "    cat_anomaly = anomaly_df[anomaly_df['Category'] == cat]['Anomaly_Index'].values[0]\r\n\u001b[?2004l\r"]
[169.086464, "o", "\u001b[?2004h> "]
[169.086567, "o", "    cat_ext = extensive_df[extensive_df['Category'] == cat]\r\n\u001b[?2004l\r"]
[169.086588, "o", "\u001b[?2004h> "]
[169.086686, "o", "    cat_int = intensive_df[intensive_df['Category'] == cat]\r\n\u001b[?2004l\r"]
[169.086708, "o", "\u001b[?2004h> "]
[169.086726, "o", "    \r\n\u001b[?2004l\r"]
[169.086749, "o", "\u001b[?2004h> "]
[169.086898, "o", "    baseline_avg_spend = cat_int[cat_int['Period'] == 'baseline']['Total_Spend'].mean()\r\n\u001b[?2004l\r"]
[169.086922, "o", "\u001b[?2004h> "]
[169.087067, "o", "    treatment_avg_spend = cat_int[cat_int['Period'] == 'treatment']['Total_Spend'].mean()\r\n\u001b[?2004l\r"]
[169.087087, "o", "\u001b[?2004h> "]
[169.087266, "o", "    n_purchasers_baseline = cat_ext[(cat_ext['Period'] == 'baseline') & (cat_ext['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r"]
[169.087314, "o", "\u001b[?2004h> "]
[169.087473, "o", "    n_purchasers_treatment = cat_ext[(cat_ext['Period'] == 'treatment') & (cat_ext['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.087515, "o", "> "]
[169.087627, "o", "    baseline_purchase_rate = cat_ext[cat_ext['Period'] == 'baseline']['Has_Purchase'].mean()\r\n\u001b[?2004l\r"]
[169.087671, "o", "\u001b[?2004h> "]
[169.087786, "o", "    treatment_purchase_rate = cat_ext[cat_ext['Period'] == 'treatment']['Has_Purchase'].mean()\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.087832, "o", "> "]
[169.087854, "o", "    n_at_risk = len(users)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.087873, "o", "\u001b[?2004h> "]
[169.088085, "o", "    users_with_purchase = cat_ext.groupby('Survey ResponseID')['Has_Purchase'].max()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.088174, "o", "    users_with_purchase = users_with_purchase[users_with_purchase > 0].index\r\n\u001b[?2004l\r"]
[169.088201, "o", "\u001b[?2004h> "]
[169.088337, "o", "    cat_int_filtered = cat_int[cat_int['Survey ResponseID'].isin(users_with_purchase)]\r\n\u001b[?2004l\r"]
[169.08836, "o", "\u001b[?2004h>     "]
[169.08838, "o", "\r\n\u001b[?2004l\r"]
[169.088403, "o", "\u001b[?2004h> "]
[169.088565, "o", "    intensive_drivers = run_did(cat_int_filtered, 'Total_Spend', features, cat, is_intensive=True)\r\n\u001b[?2004l\r"]
[169.088594, "o", "\u001b[?2004h> "]
[169.088732, "o", "    extensive_drivers = run_did(cat_ext, 'Has_Purchase', features, cat, is_intensive=False)\r\n\u001b[?2004l\r"]
[169.088758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.088775, "o", "\u001b[?2004h"]
[169.088795, "o", "> "]
[169.088875, "o", "    if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.08901, "o", "        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r"]
[169.089032, "o", "\u001b[?2004h> "]
[169.089196, "o", "        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r"]
[169.089219, "o", "\u001b[?2004h> "]
[169.089245, "o", "    else:\r\n\u001b[?2004l\r"]
[169.089265, "o", "\u001b[?2004h> "]
[169.089435, "o", "        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\r\n\u001b[?2004l\r"]
[169.089456, "o", "\u001b[?2004h> "]
[169.089627, "o", "        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\r\n\u001b[?2004l\r"]
[169.089666, "o", "\u001b[?2004h> "]
[169.08974, "o", "\r\n\u001b[?2004l\r"]
[169.089762, "o", "\u001b[?2004h> "]
[169.089833, "o", "    cat_report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.089932, "o", "        \"category\": cat, \"anomaly_index\": float(cat_anomaly),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.089975, "o", "> "]
[169.090111, "o", "        \"baseline_avg_spend\": float(baseline_avg_spend), \"treatment_avg_spend\": float(treatment_avg_spend),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.090159, "o", "> "]
[169.090302, "o", "        \"n_purchasers_baseline\": int(n_purchasers_baseline), \"n_purchasers_treatment\": int(n_purchasers_treatment),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.090342, "o", "> "]
[169.090495, "o", "        \"baseline_purchase_rate\": float(baseline_purchase_rate), \"treatment_purchase_rate\": float(treatment_purchase_rate),\r\n\u001b[?2004l\r"]
[169.090535, "o", "\u001b[?2004h> "]
[169.090556, "o", "        \"n_at_risk\": int(n_at_risk),\r\n\u001b[?2004l\r"]
[169.090582, "o", "\u001b[?2004h> "]
[169.090714, "o", "        \"intensive_margin\": intensive_drivers, \"extensive_margin\": extensive_drivers\r\n\u001b[?2004l\r"]
[169.090735, "o", "\u001b[?2004h> "]
[169.090756, "o", "    }\r\n\u001b[?2004l\r"]
[169.090783, "o", "\u001b[?2004h> "]
[169.090895, "o", "    if is_surge: results[\"surge_categories\"].append(cat_report)\r\n\u001b[?2004l\r"]
[169.090919, "o", "\u001b[?2004h> "]
[169.091007, "o", "    else: results[\"slump_categories\"].append(cat_report)\r\n\u001b[?2004l\r"]
[169.091027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.091052, "o", "\u001b[?2004h> "]
[169.091163, "o", "with open('/app/output/causal_analysis_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[169.091188, "o", "\u001b[?2004h> "]
[169.091262, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[169.091284, "o", "\u001b[?2004h> EOF\r\n"]
[169.091301, "o", "\u001b[?2004l\r"]
[169.139604, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
[169.195227, "i", "python3 causal_analysis.py\n"]
[169.205202, "o", "python3 causal_analysis.py\r\n\u001b[?2004l\r"]
[200.896854, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
