[57.742071, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
[57.888169, "i", "cat << 'EOF' > feature_engineering.py\nimport pandas as pd\n\n# Load cleaned survey data\nsurvey = pd.read_csv('/app/output/survey_cleaned.csv')\n\n# Identify demographic columns for feature engineering\n# Based on the head output earlier:\n# Q-demos-age, Q-demos-hispanic, Q-demos-race, Q-demos-education, Q-demos-income, Q-demos-gender, Q-sexual-orientation, Q-demos-state, ...\n\ndemo_cols = [\n    'Q-demos-age', 'Q-demos-hispanic', 'Q-demos-race', 'Q-demos-education', \n    'Q-demos-income', 'Q-demos-gender', 'Q-sexual-orientation', 'Q-demos-state',\n    'Q-amazon-use-howmany', 'Q-amazon-use-hh-size', 'Q-amazon-use-how-oft',\n    'Q-substance-use-cigarettes', 'Q-substance-use-marijuana', 'Q-substance-use-alcohol',\n    'Q-personal-diabetes', 'Q-personal-wheelchair'\n]\n\n# Filter for existing columns\nexisting_cols = [col for col in demo_cols if col in survey.columns]\n\n# One-hot encoding\nsurvey_features = pd.get_dummies(survey, columns=existing_cols, drop_first=True)\n\n# Keep ResponseID and the new features\n# The ResponseID is 'Survey ResponseID'\noutput_cols = ['Survey ResponseID'] + [col for col in survey_features.columns if col not in survey.columns]\nsurvey_feature_engineered = survey_features[output_cols]\n\nsurvey_feature_engineered.to_csv('/app/output/survey_feature_engineered.csv', index=False)\nprint(f\"Feature engineered survey: {survey_feature_engineered.shape}\")\nEOF\n"]
