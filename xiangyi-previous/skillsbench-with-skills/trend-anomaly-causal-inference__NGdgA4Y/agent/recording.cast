[17.745071, "i", "cat << 'EOF' > clean_data.py\nimport pandas as pd\nimport numpy as np\n\n# Load datasets\npurchases = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv', low_memory=False)\nsurvey = pd.read_csv('/app/data/survey_dirty.csv')\n\n# Clean purchases\n# 1. Convert Order Date\npurchases['Order Date'] = pd.to_datetime(purchases['Order Date'], errors='coerce')\n# 2. Convert Price and Quantity to numeric\npurchases['Purchase Price Per Unit'] = pd.to_numeric(purchases['Purchase Price Per Unit'], errors='coerce')\npurchases['Quantity'] = pd.to_numeric(purchases['Quantity'], errors='coerce')\n# 3. Drop rows with critical missing values\npurchases = purchases.dropna(subset=['Order Date', 'Purchase Price Per Unit', 'Quantity', 'Category', 'Survey ResponseID'])\n# 4. Filter for 2019-2020\npurchases = purchases[(purchases['Order Date'] >= '2019-01-01') & (purchases['Order Date'] <= '2020-12-31')]\n# 5. Remove duplicates\npurchases = purchases.drop_duplicates()\n# 6. Calculate Total Spend\npurchases['Total_Spend'] = purchases['Purchase Price Per Unit'] * purchases['Quantity']\n\n# Clean survey\n# 1. Remove duplicates\nsurvey = survey.drop_duplicates(subset=['Survey ResponseID'])\n# 2. Basic cleaning of demographic columns (strip whitespace if any)\nfor col in survey.columns:\n    if survey[col].dtype == 'object':\n        survey[col] = survey[col].str.strip()\n\n# Keep only purchases from users in the survey\npurchases = purchases[purchases['Survey ResponseID'].isin(survey['Survey ResponseID'])]\n\n# Save cleaned data\nsurvey.to_csv('/app/output/survey_cleaned.csv', index=False)\npurchases.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)\n\nprint(f\"Cleaned purchases: {len(purchases)} rows\")\nprint(f\"Cleaned survey: {len(survey)} rows\")\nEOF\n"]
