[78.961749, "o", "    return did_results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.961809, "o", "for cat in target_cats:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.961882, "o", "    is_surge = cat in surge_cats\r\n\u001b[?2004l\r"]
[78.961914, "o", "\u001b[?2004h> "]
[78.962032, "o", "    cat_anomaly = anomaly_df[anomaly_df['Category'] == cat]['Anomaly_Index'].values[0]\r\n\u001b[?2004l\r"]
[78.962061, "o", "\u001b[?2004h>     \r\n"]
[78.962159, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.962185, "o", "    # Stats for report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.962262, "o", "    cat_ext = extensive_df[extensive_df['Category'] == cat]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.962288, "o", "> "]
[78.962378, "o", "    cat_int = intensive_df[intensive_df['Category'] == cat]\r\n\u001b[?2004l\r"]
[78.9624, "o", "\u001b[?2004h>     "]
[78.962419, "o", "\r\n\u001b[?2004l\r"]
[78.962489, "o", "\u001b[?2004h> "]
[78.96262, "o", "    baseline_avg_spend = cat_int[cat_int['Period'] == 'baseline']['Total_Spend'].mean()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.962751, "o", "    treatment_avg_spend = cat_int[cat_int['Period'] == 'treatment']['Total_Spend'].mean()\r\n\u001b[?2004l\r"]
[78.962825, "o", "\u001b[?2004h> "]
[78.962987, "o", "    n_purchasers_baseline = cat_ext[(cat_ext['Period'] == 'baseline') & (cat_ext['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.963147, "o", "    n_purchasers_treatment = cat_ext[(cat_ext['Period'] == 'treatment') & (cat_ext['Has_Purchase'] == 1)].shape[0]\r\n\u001b[?2004l\r"]
[78.963209, "o", "\u001b[?2004h> "]
[78.963325, "o", "    baseline_purchase_rate = cat_ext[cat_ext['Period'] == 'baseline']['Has_Purchase'].mean()\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.963356, "o", "> "]
[78.963484, "o", "    treatment_purchase_rate = cat_ext[cat_ext['Period'] == 'treatment']['Has_Purchase'].mean()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.963533, "o", "    n_at_risk = len(users)\r\n\u001b[?2004l\r"]
[78.963563, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.963616, "o", ">     # Run DiD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.96378, "o", "    # For intensive margin, we'll use users who purchased in at least one period to avoid too many zeros\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.963922, "o", "    users_with_purchase = cat_ext.groupby('Survey ResponseID')['Has_Purchase'].max()\r\n\u001b[?2004l\r"]
[78.963984, "o", "\u001b[?2004h> "]
[78.964067, "o", "    users_with_purchase = users_with_purchase[users_with_purchase > 0].index\r\n\u001b[?2004l\r"]
[78.964097, "o", "\u001b[?2004h> "]
[78.964222, "o", "    cat_int_filtered = cat_int[cat_int['Survey ResponseID'].isin(users_with_purchase)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.964251, "o", ">     \r\n\u001b[?2004l\r"]
[78.964277, "o", "\u001b[?2004h> "]
[78.964418, "o", "    intensive_drivers = run_did(cat_int_filtered, 'Total_Spend', features, cat, is_intensive=True)\r\n\u001b[?2004l\r"]
[78.964481, "o", "\u001b[?2004h> "]
[78.964575, "o", "    extensive_drivers = run_did(cat_ext, 'Has_Purchase', features, cat, is_intensive=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.964631, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.96469, "o", ">     # Sort drivers\r\n\u001b[?2004l\r"]
[78.964743, "o", "\u001b[?2004h>     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.964799, "o", "> "]
[78.964899, "o", "        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r"]
[78.96493, "o", "\u001b[?2004h> "]
[78.965117, "o", "        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.96521, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.965319, "o", "        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\r\n\u001b[?2004l\r"]
[78.965396, "o", "\u001b[?2004h> "]
[78.96551, "o", "        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\r\n\u001b[?2004l\r"]
[78.965591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     cat_report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.96569, "o", "        \"category\": cat,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.96577, "o", "        \"anomaly_index\": float(cat_anomaly),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.965862, "o", "        \"baseline_avg_spend\": float(baseline_avg_spend),\r\n\u001b[?2004l\r"]
[78.965939, "o", "\u001b[?2004h> "]
[78.966011, "o", "        \"treatment_avg_spend\": float(treatment_avg_spend),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.966102, "o", "        \"n_purchasers_baseline\": int(n_purchasers_baseline),\r\n\u001b[?2004l\r"]
[78.966172, "o", "\u001b[?2004h> "]
[78.966249, "o", "        \"n_purchasers_treatment\": int(n_purchasers_treatment),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.966358, "o", "        \"baseline_purchase_rate\": float(baseline_purchase_rate),\r\n\u001b[?2004l\r"]
[78.966429, "o", "\u001b[?2004h> "]
[78.966497, "o", "        \"treatment_purchase_rate\": float(treatment_purchase_rate),\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.966564, "o", ">         \"n_at_risk\": int(n_at_risk),"]
[78.966631, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.966699, "o", "        \"intensive_margin\": intensive_drivers,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.966777, "o", "        \"extensive_margin\": extensive_drivers\r\n\u001b[?2004l\r"]
[78.966849, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.966917, "o", ">     if is_surge:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.967009, "o", "        results[\"surge_categories\"].append(cat_report)\r\n\u001b[?2004l\r"]
[78.967083, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.967163, "o", "        results[\"slump_categories\"].append(cat_report)\r\n\u001b[?2004l\r"]
[78.967235, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.967335, "o", "with open('/app/output/causal_analysis_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.967405, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.967473, "o", "> print(\"Causal analysis complete.\")"]
[78.967542, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[78.968854, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
[79.132443, "i", "python3 causal_analysis.py\n"]
[79.132913, "o", "python3 causal_analysis.py\r\n\u001b[?2004l\r"]
[94.381419, "o", "Causal analysis complete.\r\n"]
[94.65019, "o", "\u001b[?2004hroot@40089f4363bf:/app# "]
