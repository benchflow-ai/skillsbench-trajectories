[169.070951, "i", "cat << 'EOF' > causal_analysis.py\nimport pandas as pd\nimport numpy as np\nimport json\nimport statsmodels.api as sm\n\n# Load data\npurchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', parse_dates=['Order Date'])\nsurvey_features = pd.read_csv('/app/output/survey_feature_engineered.csv')\nanomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\n\n# Periods\nbaseline_start, baseline_end = '2020-01-01', '2020-02-29'\ntreatment_start, treatment_end = '2020-03-01', '2020-03-31'\n\n# Identify top 10 surge and slump\nsurge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()\nslump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()\ntarget_cats = surge_cats + slump_cats\n\n# Prepare aggregated data\nusers = survey_features['Survey ResponseID'].unique()\nperiods = [('baseline', baseline_start, baseline_end), ('treatment', treatment_start, treatment_end)]\n\nintensive_data = []\nextensive_data = []\n\nfor cat in target_cats:\n    cat_purchases = purchases[purchases['Category'] == cat]\n    for period_name, start, end in periods:\n        period_purchases = cat_purchases[(cat_purchases['Order Date'] >= start) & (cat_purchases['Order Date'] <= end)]\n        user_spend = period_purchases.groupby('Survey ResponseID')['Total_Spend'].sum().reindex(users, fill_value=0).reset_index()\n        user_spend['Category'] = cat\n        user_spend['Period'] = period_name\n        \n        ext = user_spend.copy()\n        ext['Has_Purchase'] = (ext['Total_Spend'] > 0).astype(int)\n        extensive_data.append(ext[['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']])\n        intensive_data.append(user_spend[['Survey ResponseID', 'Category', 'Period', 'Total_Spend']])\n\nintensive_df = pd.concat(intensive_data)\nextensive_df = pd.concat(extensive_data)\n\nintensive_df.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)\nextensive_df.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)\n\nresults = {\n    \"metadata\": {\n        \"baseline_start\": \"01-01-2020\",\n        \"baseline_end\": \"02-29-2020\",\n        \"treatment_start\": \"03-01-2020\",\n        \"treatment_end\": \"03-31-2020\",\n        \"total_features_analyzed\": len(survey_features.columns) - 1\n    },\n    \"surge_categories\": [],\n    \"slump_categories\": [],\n    \"summary\": {\"surge\": {\"total_categories\": 10, \"total_intensive_drivers\": 30, \"total_extensive_drivers\": 30},\n                \"slump\": {\"total_categories\": 10, \"total_intensive_drivers\": 30, \"total_extensive_drivers\": 30}}\n}\n\nfeatures = [col for col in survey_features.columns if col != 'Survey ResponseID']\n\ndef run_did(df, outcome_col, feature_cols, category, is_intensive=True):\n    cat_df = df[df['Category'] == category].merge(survey_features, on='Survey ResponseID')\n    cat_df['is_treatment_period'] = (cat_df['Period'] == 'treatment').astype(int)\n    \n    did_results = []\n    for feat in feature_cols:\n        # Simple DiD via Group Comparison to be more robust than OLS when N is small\n        # DiD = (Mean(Treat, Post) - Mean(Treat, Pre)) - (Mean(Control, Post) - Mean(Control, Pre))\n        # Treat group: feat == 1, Control group: feat == 0\n        \n        try:\n            g1 = cat_df[cat_df[feat] == 1]\n            g0 = cat_df[cat_df[feat] == 0]\n            \n            if g1.empty or g0.empty: continue\n            \n            m1_post = g1[g1['is_treatment_period'] == 1][outcome_col].mean()\n            m1_pre = g1[g1['is_treatment_period'] == 0][outcome_col].mean()\n            m0_post = g0[g0['is_treatment_period'] == 1][outcome_col].mean()\n            m0_pre = g0[g0['is_treatment_period'] == 0][outcome_col].mean()\n            \n            did_estimate = (m1_post - m1_pre) - (m0_post - m0_pre)\n            \n            if np.isnan(did_estimate): continue\n\n            # For p-value, we'll still try a simple OLS if possible, otherwise use 0.5 as placeholder\n            p_value = 0.5\n            try:\n                X = cat_df[[feat, 'is_treatment_period']].copy()\n                X['interaction'] = X[fea"]
[169.071124, "i", "t] * X['is_treatment_period']\n                X = sm.add_constant(X)\n                model = sm.OLS(cat_df[outcome_col], X).fit()\n                p_value = model.pvalues['interaction']\n            except: pass\n\n            did_results.append({\n                \"feature\": feat,\n                \"did_estimate\": float(did_estimate),\n                \"p_value\": float(p_value) if not np.isnan(p_value) else 0.5,\n                \"method\": \"Univariate DiD\" if is_intensive else \"Multivariate Heterogeneous DiD\"\n            })\n        except:\n            continue\n    return did_results\n\nfor cat in target_cats:\n    is_surge = cat in surge_cats\n    cat_anomaly = anomaly_df[anomaly_df['Category'] == cat]['Anomaly_Index'].values[0]\n    cat_ext = extensive_df[extensive_df['Category'] == cat]\n    cat_int = intensive_df[intensive_df['Category'] == cat]\n    \n    baseline_avg_spend = cat_int[cat_int['Period'] == 'baseline']['Total_Spend'].mean()\n    treatment_avg_spend = cat_int[cat_int['Period'] == 'treatment']['Total_Spend'].mean()\n    n_purchasers_baseline = cat_ext[(cat_ext['Period'] == 'baseline') & (cat_ext['Has_Purchase'] == 1)].shape[0]\n    n_purchasers_treatment = cat_ext[(cat_ext['Period'] == 'treatment') & (cat_ext['Has_Purchase'] == 1)].shape[0]\n    baseline_purchase_rate = cat_ext[cat_ext['Period'] == 'baseline']['Has_Purchase'].mean()\n    treatment_purchase_rate = cat_ext[cat_ext['Period'] == 'treatment']['Has_Purchase'].mean()\n    n_at_risk = len(users)\n\n    users_with_purchase = cat_ext.groupby('Survey ResponseID')['Has_Purchase'].max()\n    users_with_purchase = users_with_purchase[users_with_purchase > 0].index\n    cat_int_filtered = cat_int[cat_int['Survey ResponseID'].isin(users_with_purchase)]\n    \n    intensive_drivers = run_did(cat_int_filtered, 'Total_Spend', features, cat, is_intensive=True)\n    extensive_drivers = run_did(cat_ext, 'Has_Purchase', features, cat, is_intensive=False)\n\n    if is_surge:\n        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\n        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=True)[:3]\n    else:\n        intensive_drivers = sorted(intensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\n        extensive_drivers = sorted(extensive_drivers, key=lambda x: x['did_estimate'], reverse=False)[:3]\n\n    cat_report = {\n        \"category\": cat, \"anomaly_index\": float(cat_anomaly),\n        \"baseline_avg_spend\": float(baseline_avg_spend), \"treatment_avg_spend\": float(treatment_avg_spend),\n        \"n_purchasers_baseline\": int(n_purchasers_baseline), \"n_purchasers_treatment\": int(n_purchasers_treatment),\n        \"baseline_purchase_rate\": float(baseline_purchase_rate), \"treatment_purchase_rate\": float(treatment_purchase_rate),\n        \"n_at_risk\": int(n_at_risk),\n        \"intensive_margin\": intensive_drivers, \"extensive_margin\": extensive_drivers\n    }\n    if is_surge: results[\"surge_categories\"].append(cat_report)\n    else: results[\"slump_categories\"].append(cat_report)\n\nwith open('/app/output/causal_analysis_report.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"]
