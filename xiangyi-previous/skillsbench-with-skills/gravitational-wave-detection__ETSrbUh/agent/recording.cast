[97.30996, "i", "cat << 'EOF' > analyze_gw.py\nimport numpy as np\nimport pandas as pd\nfrom pycbc.types import read_timeseries\nfrom pycbc.filter import matched_filter, resample_to_delta_t\nfrom pycbc.waveform import get_fd_waveform\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\n\n# Parameters\nfilename = \"/root/data/PyCBC_T2_2.gwf\"\nchannel = \"H1:TEST-STRAIN\"\nmass_range = range(10, 41)\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nflow = 30.0\n\n# Load data\ndata = read_timeseries(filename, channel)\n\n# Condition data\ndata = data.highpass_fir(15, 512) # Highpass filter\n\n# Estimate PSD\ndelta_t = data.delta_t\nseg_len = int(2 / delta_t)\nseg_stride = int(seg_len / 2)\npsd = data.psd(2, avg_method='median')\npsd = interpolate(psd, data.delta_f)\npsd = inverse_spectrum_truncation(psd, int(2 * data.sample_rate), low_frequency_cutoff=flow)\n\nresults = []\n\nfor approx in approximants:\n    best_snr = 0\n    best_total_mass = 0\n    \n    for m1 in mass_range:\n        for m2 in range(10, m1 + 1): # Symmetry\n            hp, hc "]
[97.310009, "i", "= get_fd_waveform(approximant=approx,\n                                     mass1=m1,\n                                     mass2=m2,\n                                     delta_f=data.delta_f,\n                                     f_lower=flow)\n            \n            hp.resize(len(psd))\n            snr = matched_filter(hp, data, psd=psd, low_frequency_cutoff=flow)\n            \n            # Remove transients\n            snr = snr.crop(4, 4)\n            \n            max_snr = float(abs(snr).max())\n            if max_snr > best_snr:\n                best_snr = max_snr\n                best_total_mass = m1 + m2\n    \n    results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\n    print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\n\n# Save results\ndf = pd.DataFrame(results)\ndf.to_csv(\"/root/detection_results.csv\", index=False)\nEOF\n"]
