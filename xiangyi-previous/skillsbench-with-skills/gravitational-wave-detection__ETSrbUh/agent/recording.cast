[175.43857, "o", "\u001b[?2004h> "]
[175.438608, "o", "            \r\n\u001b[?2004l\r"]
[175.438627, "o", "\u001b[?2004h> "]
[175.438709, "o", "            hp.resize(len(psd))\r\n\u001b[?2004l\r"]
[175.438735, "o", "\u001b[?2004h"]
[175.438762, "o", "> "]
