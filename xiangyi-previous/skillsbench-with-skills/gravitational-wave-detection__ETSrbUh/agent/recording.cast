[932.972607, "o", "\u001b[?2004l\r"]
[932.972644, "o", "\u001b[?2004h"]
[932.972676, "o", "> "]
[932.972736, "o", "    g_fd_apps = fd_apps"]
[932.972762, "o", "\r\n"]
[932.972787, "o", "\u001b[?2004l\r"]
[932.972821, "o", "\u001b[?2004h"]
[932.972852, "o", "> "]
[932.972879, "o", "\r\n"]
[932.972915, "o", "\u001b[?2004l\r"]
[932.972953, "o", "\u001b[?2004h"]
[932.972985, "o", "> "]
[932.973058, "o", "def process_combination(args):"]
[932.973087, "o", "\r\n"]
[932.973113, "o", "\u001b[?2004l\r"]
[932.973149, "o", "\u001b[?2004h"]
[932.973183, "o", "> "]
[932.973248, "o", "    approx, m1, m2 = args"]
[932.973277, "o", "\r\n"]
[932.973309, "o", "\u001b[?2004l\r"]
[932.973348, "o", "\u001b[?2004h"]
[932.973381, "o", "> "]
[932.973453, "o", "    try:"]
[932.973481, "o", "\r\n"]
[932.973505, "o", "\u001b[?2004l\r"]
[932.97356, "o", "\u001b[?2004h"]
[932.973601, "o", "> "]
[932.973678, "o", "        if approx in g_td_apps:"]
[932.973705, "o", "\r\n"]
[932.973729, "o", "\u001b[?2004l\r"]
[932.973767, "o", "\u001b[?2004h"]
[932.9738, "o", "> "]
[932.973917, "o", "            hp, hc = get_td_waveform(approximant=approx,"]
[932.973946, "o", "\r\n"]
[932.973969, "o", "\u001b[?2004l\r"]
[932.974002, "o", "\u001b[?2004h"]
[932.974032, "o", "> "]
[932.974143, "o", "                                     mass1=m1, mass2=m2,"]
[932.97417, "o", "\r\n"]
[932.974194, "o", "\u001b[?2004l\r"]
[932.974232, "o", "\u001b[?2004h"]
[932.974265, "o", "> "]
[932.974405, "o", "                                     delta_t=g_data.delta_t, f_lower=g_flow)"]
[932.97443, "o", "\r\n"]
[932.974454, "o", "\u001b[?2004l\r"]
[932.974488, "o", "\u001b[?2004h"]
[932.974515, "o", "> "]
[932.974595, "o", "            hp.resize(len(g_data))"]
[932.97484, "o", "\r\n"]
[932.974896, "o", "\u001b[?2004l\r"]
[932.974941, "o", "\u001b[?2004h"]
[932.974969, "o", "> "]
[932.975063, "o", "            template = hp.to_frequencyseries()"]
[932.975083, "o", "\r\n"]
[932.975108, "o", "\u001b[?2004l\r"]
[932.975193, "o", "\u001b[?2004h> "]
[932.975247, "o", "        elif approx in g_fd_apps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.975359, "o", "            hp, hc = get_fd_waveform(approximant=approx,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.975442, "o", "                                     mass1=m1, mass2=m2,\r\n\u001b[?2004l\r"]
[932.975458, "o", "\u001b[?2004h> "]
[932.975753, "o", "                                     delta_f=g_data.delta_f, f_lower=g_flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.975821, "o", "            template = hp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.975863, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.976061, "o", "            return 0, 0\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         template.resize(len(g_psd))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.97624, "o", "        snr = matched_filter(template, g_data, psd=g_psd, low_frequency_cutoff=g_flow)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.976266, "o", "        snr = snr.crop(4, 4)\r\n\u001b[?2004l\r"]
[932.976325, "o", "\u001b[?2004h> "]
[932.976359, "o", "        max_snr = float(abs(snr).max())\r\n\u001b[?2004l\r"]
[932.976391, "o", "\u001b[?2004h> "]
[932.97657, "o", "        return max_snr, m1 + m2\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0, 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[932.976585, "o", "\u001b[?2004h"]
[932.976608, "o", "> "]
[932.976697, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.976754, "o", "    filename = \"/root/data/PyCBC_T2_2.gwf\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.976813, "o", "    channel = \"H1:TEST-STRAIN\"\r\n\u001b[?2004l\r"]
[932.976829, "o", "\u001b[?2004h> "]
[932.977046, "o", "    mass_range = range(10, 41)\r\n\u001b[?2004l\r\u001b[?2004h>     approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\n\u001b[?2004l\r\u001b[?2004h>     flow = 30.0\r\n\u001b[?2004l\r"]
[932.977065, "o", "\u001b[?2004h> "]
[932.977087, "o", "\r\n\u001b[?2004l\r"]
[932.977102, "o", "\u001b[?2004h> "]
[932.977195, "o", "    print(\"Loading and conditioning data...\")\r\n\u001b[?2004l\r"]
[932.977211, "o", "\u001b[?2004h> "]
[932.977267, "o", "    data = read_frame(filename, channel)\r\n\u001b[?2004l\r"]
[932.977291, "o", "\u001b[?2004h> "]
[932.977362, "o", "    data = data.highpass_fir(15, 512)\r\n\u001b[?2004l\r"]
[932.977377, "o", "\u001b[?2004h> "]
[932.977505, "o", "    data = resample_to_delta_t(data, 1.0/2048)\r\n\u001b[?2004l\r"]
[932.977533, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.977634, "o", "    psd = data.psd(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.977696, "o", "    psd = interpolate(psd, data.delta_f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.977857, "o", "    psd = inverse_spectrum_truncation(psd, int(2 * data.sample_rate), low_frequency_cutoff=flow)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[932.977908, "o", "\u001b[?2004h> "]
[932.978188, "o", "    td_apps = td_approximants()\r\n\u001b[?2004l\r\u001b[?2004h>     fd_apps = fd_approximants()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     # Use 128 workers as available\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.978293, "o", "    num_cores = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.97847, "o", "    pool = mp.Pool(processes=num_cores, initializer=init_worker, initargs=(data, psd, flow, td_apps, fd_apps))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[932.978489, "o", "\u001b[?2004h"]
[932.978501, "o", "> "]
[932.97856, "o", "    for approx in approximants:\r\n\u001b[?2004l\r"]
[932.978595, "o", "\u001b[?2004h> "]
[932.978805, "o", "        actual_approx = approx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.978858, "o", "        if approx == \"SEOBNRv4_opt\" and \"SEOBNRv4_opt\" not in td_apps and \"SEOBNRv4_opt\" not in fd_apps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.978973, "o", "            if \"SEOBNRv4\" in td_apps or \"SEOBNRv4\" in fd_apps:\r\n\u001b[?2004l\r"]
[932.978992, "o", "\u001b[?2004h> "]
[932.979103, "o", "                actual_approx = \"SEOBNRv4\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n"]
[932.979122, "o", "\u001b[?2004l\r"]
[932.979143, "o", "\u001b[?2004h> "]
[932.979225, "o", "        tasks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.979259, "o", "        for m1 in mass_range:\r\n\u001b[?2004l\r"]
[932.979279, "o", "\u001b[?2004h> "]
[932.979353, "o", "            for m2 in range(10, m1 + 1):\r\n\u001b[?2004l\r"]
[932.979371, "o", "\u001b[?2004h> "]
[932.979466, "o", "                tasks.append((actual_approx, m1, m2))\r\n\u001b[?2004l\r"]
[932.979489, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[932.979507, "o", "\u001b[?2004h> "]
[932.979695, "o", "        print(f\"Processing {approx} ({actual_approx}) with {len(tasks)} combinations using {num_cores} cores...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[932.979712, "o", "> "]
[932.979806, "o", "        worker_results = pool.map(process_combination, tasks)\r\n\u001b[?2004l\r"]
[932.979833, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[932.979855, "o", "\u001b[?2004h> "]
[932.979936, "o", "        best_snr, best_total_mass = 0, 0\r\n\u001b[?2004l\r"]
[932.97995, "o", "\u001b[?2004h> "]
[932.980019, "o", "        for snr, total_mass in worker_results:\r\n\u001b[?2004l\r"]
[932.980042, "o", "\u001b[?2004h> "]
[932.980094, "o", "            if snr > best_snr:\r\n\u001b[?2004l\r"]
[932.980104, "o", "\u001b[?2004h> "]
[932.980166, "o", "                best_snr = snr\r\n\u001b[?2004l\r"]
[932.980179, "o", "\u001b[?2004h> "]
[932.980259, "o", "                best_total_mass = total_mass\r\n\u001b[?2004l\r"]
[932.980282, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[932.980293, "o", "\u001b[?2004h> "]
[932.980711, "o", "        results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     pool.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.980728, "o", "    pool.join()\r\n"]
[932.980756, "o", "\u001b[?2004l\r"]
[932.980769, "o", "\u001b[?2004h> "]
[932.980858, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.980941, "o", "    df.to_csv(\"/root/detection_results.csv\", index=False)\r\n\u001b[?2004l\r"]
[932.980955, "o", "\u001b[?2004h> "]
[932.981056, "o", "    print(\"Results saved to /root/detection_results.csv\")\r\n\u001b[?2004l\r"]
[932.981076, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[933.037637, "o", "\u001b[?2004hroot@2b2631d877b1:~# "]
[933.607453, "i", "python3 analyze_gw.py\n"]
[933.607863, "o", "python3 analyze_gw.py"]
[933.607977, "o", "\r\n"]
[933.608016, "o", "\u001b[?2004l\r"]
[938.199952, "o", "Loading and conditioning data...\r\n"]
[946.356993, "o", "Processing SEOBNRv4_opt (SEOBNRv4_opt) with 496 combinations using 128 cores...\r\n"]
