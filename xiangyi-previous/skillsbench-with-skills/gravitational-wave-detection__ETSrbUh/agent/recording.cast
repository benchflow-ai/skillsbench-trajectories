[592.152705, "i", "cat << 'EOF' > analyze_gw.py\nimport numpy as np\nimport pandas as pd\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter, resample_to_delta_t\nfrom pycbc.waveform import get_fd_waveform, get_td_waveform, td_approximants, fd_approximants\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nimport multiprocessing as mp\n\ndef process_combination(args):\n    approx, m1, m2, data_resampled, psd, flow, td_apps, fd_apps = args\n    try:\n        if approx in td_apps:\n            hp, hc = get_td_waveform(approximant=approx,\n                                     mass1=m1, mass2=m2,\n                                     delta_t=data_resampled.delta_t, f_lower=flow)\n            hp.resize(len(data_resampled))\n            template = hp.to_frequencyseries()\n        elif approx in fd_apps:\n            hp, hc = get_fd_waveform(approximant=approx,\n                                     mass1=m1, mass2=m2,\n                                     delta_f=data_resampled.delta_f, f_lower=flow)\n            temp"]
[592.152871, "i", "late = hp\n        else:\n            return 0, 0\n        \n        template.resize(len(psd))\n        snr = matched_filter(template, data_resampled, psd=psd, low_frequency_cutoff=flow)\n        snr = snr.crop(4, 4)\n        max_snr = float(abs(snr).max())\n        return max_snr, m1 + m2\n    except Exception as e:\n        return 0, 0\n\nif __name__ == '__main__':\n    filename = \"/root/data/PyCBC_T2_2.gwf\"\n    channel = \"H1:TEST-STRAIN\"\n    mass_range = range(10, 41)\n    approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\n    flow = 30.0\n\n    data = read_frame(filename, channel)\n    data = data.highpass_fir(15, 512)\n    data_resampled = resample_to_delta_t(data, 1.0/2048)\n    \n    psd = data_resampled.psd(2)\n    psd = interpolate(psd, data_resampled.delta_f)\n    psd = inverse_spectrum_truncation(psd, int(2 * data_resampled.sample_rate), low_frequency_cutoff=flow)\n\n    td_apps = td_approximants()\n    fd_apps = fd_approximants()\n\n    results = []\n    pool = mp.Pool(mp.cpu_count())\n\n    for approx in approximants:\n"]
[592.153451, "o", "cat << 'EOF' > analyze_gw.py\r\n\u001b[?2004l\rlate = hp\r\n        else:\r\n            return 0, 0\r\n        \r\n        template.resize(len(psd))\r\n        snr = matched_filter(template, data_resampled, psd=psd, low_frequency_cutoff=flow)\r\n        snr = snr.crop(4, 4)\r\n        max_snr = float(abs(snr).max())\r\n        return max_snr, m1 + m2\r\n    except Exception as e:\r\n        return 0, 0\r\n\r\nif __name__ == '__main__':\r\n    filename = \"/root/data/PyCBC_T2_2.gwf\"\r\n    channel = \"H1:TEST-STRAIN\"\r\n    mass_range = range(10, 41)\r\n    approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\n    flow = 30.0\r\n\r\n    data = read_frame(filename, channel)\r\n    data = data.highpass_fir(15, 512)\r\n    data_resampled = resample_to_delta_t(data, 1.0/2048)\r\n    \r\n    psd = data_resampled.psd(2)\r\n    psd = interpolate(psd, data_resampled.delta_f)\r\n    psd = inverse_spectrum_truncation(psd, int(2 * data_resampled.sample_rate), low_frequency_cutoff=flow)\r\n\r\n    td_apps = td_approximants()\r\n    fd_apps = fd_approximants()\r\n\r\n    results = []"]
[592.153536, "i", "        actual_approx = approx\n        if approx == \"SEOBNRv4_opt\" and \"SEOBNRv4_opt\" not in td_apps and \"SEOBNRv4_opt\" not in fd_apps:\n            if \"SEOBNRv4\" in td_apps or \"SEOBNRv4\" in fd_apps:\n                actual_approx = \"SEOBNRv4\"\n        \n        tasks = []\n        for m1 in mass_range:\n            for m2 in range(10, m1 + 1):\n                tasks.append((actual_approx, m1, m2, data_resampled, psd, flow, td_apps, fd_apps))\n        \n        print(f\"Processing {approx} with {len(tasks)} combinations...\")\n        worker_results = pool.map(process_combination, tasks)\n        \n        best_snr, best_total_mass = 0, 0\n        for snr, total_mass in worker_results:\n            if snr > best_snr:\n                best_snr = snr\n                best_total_mass = total_mass\n        \n        results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\n        print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\n\n    pool.close()\n    df = pd.DataFrame(results)\n "]
[592.153573, "o", "\r\n    pool = mp.Pool(mp.cpu_count())\r\n\r\n    for approx in approximants:\r\n\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.153596, "i", "   df.to_csv(\"/root/detection_results.csv\", index=False)\nEOF\n"]
