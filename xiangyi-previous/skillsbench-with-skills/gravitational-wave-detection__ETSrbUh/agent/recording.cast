[175.439061, "o", "\u001b[?2004h> "]
[175.439096, "o", "            \r\n\u001b[?2004l\r"]
[175.439119, "o", "\u001b[?2004h> "]
[175.439228, "o", "            max_snr = float(abs(snr).max())\r\n\u001b[?2004l\r"]
[175.439248, "o", "\u001b[?2004h"]
[175.439274, "o", "> "]
[175.439343, "o", "            if max_snr > best_snr:\r\n\u001b[?2004l\r"]
[175.439366, "o", "\u001b[?2004h> "]
[175.439454, "o", "                best_snr = max_snr\r\n\u001b[?2004l\r"]
[175.439476, "o", "\u001b[?2004h"]
[175.439501, "o", "> "]
[175.439582, "o", "                best_total_mass = m1 + m2\r\n\u001b[?2004l\r"]
[175.439601, "o", "\u001b[?2004h"]
[175.439622, "o", ">     \r\n\u001b[?2004l\r"]
[175.439641, "o", "\u001b[?2004h> "]
[175.43989, "o", "    results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\r\n\u001b[?2004l\r"]
[175.439922, "o", "\u001b[?2004h> "]
[175.440113, "o", "    print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\r\n\u001b[?2004l\r"]
[175.440141, "o", "\u001b[?2004h"]
[175.440163, "o", "> \r\n\u001b[?2004l\r"]
[175.440183, "o", "\u001b[?2004h> "]
