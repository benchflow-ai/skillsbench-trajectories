[175.436426, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.436454, "o", "> "]
[175.436518, "o", "for approx in approximants:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.436528, "o", "> "]
[175.436589, "o", "    best_snr = 0\r\n\u001b[?2004l\r"]
[175.436597, "o", "\u001b[?2004h> "]
[175.436672, "o", "    best_total_mass = 0\r\n\u001b[?2004l\r"]
[175.436695, "o", "\u001b[?2004h"]
