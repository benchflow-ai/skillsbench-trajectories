[175.436831, "o", "\u001b[?2004h> "]
[175.436936, "o", "        for m2 in range(10, m1 + 1):\r\n\u001b[?2004l\r"]
[175.436945, "o", "\u001b[?2004h> "]
[175.437044, "o", "            if approx == \"TaylorT4\":\r\n\u001b[?2004l\r"]
[175.437066, "o", "\u001b[?2004h"]
[175.437087, "o", "> "]
[175.437221, "o", "                hp, hc = get_td_waveform(approximant=approx,\r\n\u001b[?2004l\r"]
[175.437243, "o", "\u001b[?2004h"]
[175.437274, "o", "> "]
[175.437429, "o", "                                         mass1=m1, mass2=m2,\r\n\u001b[?2004l\r"]
[175.43745, "o", "\u001b[?2004h> "]
[175.437657, "o", "                                         delta_t=data.delta_t, f_lower=flow)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.437669, "o", "> "]
[175.437812, "o", "                hp.resize(len(data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.437951, "o", "                hp = hp.to_frequencyseries()\r\n\u001b[?2004l\r\u001b[?2004h> "]
