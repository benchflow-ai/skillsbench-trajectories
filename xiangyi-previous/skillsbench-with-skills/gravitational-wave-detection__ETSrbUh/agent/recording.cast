[242.528641, "o", "python3 -c \"from pycbc.waveform import td_approximants; print('SEOBNRv4_opt' in td_approximants(), 'SEOBNRv4' in td_approximants())\"\r\n\u001b[?2004l\r"]
[243.526983, "i", "cat << 'EOF' > analyze_gw.py\nimport numpy as np\nimport pandas as pd\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter\nfrom pycbc.waveform import get_fd_waveform, get_td_waveform, td_approximants, fd_approximants\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\n\n# Parameters\nfilename = \"/root/data/PyCBC_T2_2.gwf\"\nchannel = \"H1:TEST-STRAIN\"\nmass_range = range(10, 41)\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nflow = 30.0\n\n# Load data\ndata = read_frame(filename, channel)\n\n# Condition data\ndata = data.highpass_fir(15, 512)\n\n# Estimate PSD\npsd = data.psd(2)\npsd = interpolate(psd, data.delta_f)\npsd = inverse_spectrum_truncation(psd, int(2 * data.sample_rate), low_frequency_cutoff=flow)\n\nresults = []\n\n# Check which approximants are TD or FD\ntd_apps = td_approximants()\nfd_apps = fd_approximants()\n\nfor approx in approximants:\n    best_snr = 0\n    best_total_mass = 0\n    \n    # Handle SEOBNRv4_opt if it is not available but SEOBNRv4 is\n    actual_approx = approx\n   "]
[243.527031, "o", "cat << 'EOF' > analyze_gw.py\r\nimport numpy as np\r\nimport pandas as pd\r\nfrom pycbc.frame"]
[243.52718, "i", " if approx == \"SEOBNRv4_opt\" and approx not in td_apps and approx not in fd_apps:\n        if \"SEOBNRv4\" in td_apps or \"SEOBNRv4\" in fd_apps:\n            actual_approx = \"SEOBNRv4\"\n    \n    print(f\"Processing {approx} using {actual_approx}...\")\n\n    for m1 in mass_range:\n        for m2 in range(10, m1 + 1):\n            if actual_approx in td_apps:\n                hp, hc = get_td_waveform(approximant=actual_approx,\n                                         mass1=m1, mass2=m2,\n                                         delta_t=data.delta_t, f_lower=flow)\n                hp.resize(len(data))\n                hp = hp.to_frequencyseries()\n            elif actual_approx in fd_apps:\n                hp, hc = get_fd_waveform(approximant=actual_approx,\n                                         mass1=m1, mass2=m2,\n                                         delta_f=data.delta_f, f_lower=flow)\n            else:\n                continue\n            \n            hp.resize(len(psd))\n            snr = matched_filter(hp, data, psd=psd"]
[243.527197, "o", " import read_frame\r\nfrom pycbc.filter import matched_filter\r\nfrom pycbc.waveform import get_fd_waveform, get_td_waveform, td_approximants, fd_approximants\r\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\r\n\r\n# Parameters\r\nfilename = \"/root/data/PyCBC_T2_2.gwf\"\r\nchannel = \"H1:TEST-STRAIN\"\r\nmass_range = range(10, 41)\r\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\nflow = 30.0\r\n\r\n# Load data\r\ndata = read_frame(filename, channel)\r\n\r\n# Condition data\r\ndata = data.highpass_fir(15, 512)\r\n\r\n# Estimate PSD\r\npsd = data.psd(2)\r\npsd = interpolate(psd, data.delta_f)\r\npsd = inverse_spectrum_truncation(psd, int(2 * data.sample_rate), low_frequency_cutoff=flow)\r\n\r\nresults = []\r\n\r\n# Check which approximants are TD or FD\r\ntd_apps = td_approximants()\r\nfd_apps = fd_approximants()\r\n\r\nfor approx in approximants:\r\n    best_snr = 0\r\n    best_total_mass = 0\r\n    \r\n    # Handle SEOBNRv4_opt if it is not available but SEOBNRv4 is\r\n    actual_approx = approx\r\n   "]
[243.527205, "i", ", low_frequency_cutoff=flow)\n            snr = snr.crop(4, 4)\n            \n            max_snr = float(abs(snr).max())\n            if max_snr > best_snr:\n                best_snr = max_snr\n                best_total_mass = m1 + m2\n    \n    results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\n    print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\n\n# Save results\ndf = pd.DataFrame(results)\ndf.to_csv(\"/root/detection_results.csv\", index=False)\nEOF\n"]
[243.527391, "o", " if approx == \"SEOBNRv4_opt\" and approx not in td_apps and approx not in fd_apps:\r\n        if \"SEOBNRv4\" in td_apps or \"SEOBNRv4\" in fd_apps:\r\n            actual_approx = \"SEOBNRv4\"\r\n    \r\n    print(f\"Processing {approx} using {actual_approx}...\")\r\n\r\n    for m1 in mass_range:\r\n        for m2 in range(10, m1 + 1):\r\n            if actual_approx in td_apps:\r\n                hp, hc = get_td_waveform(approximant=actual_approx,\r\n                                         mass1=m1, mass2=m2,\r\n                                         delta_t=data.delta_t, f_lower=flow)\r\n                hp.resize(len(data))\r\n                hp = hp.to_frequencyseries()\r\n            elif actual_approx in fd_apps:\r\n                hp, hc = get_fd_waveform(approximant=actual_approx,\r\n                                         mass1=m1, mass2=m2,\r\n                                         delta_f=data.delta_f, f_lower=flow)\r\n            else:\r\n                continue\r\n            \r\n            hp.resize(len(psd))\r\n            snr = matched_fi"]
[243.5274, "o", "lter(hp, data, psd=psd, low_frequency_cutoff=flow)\r\n            snr = snr.crop(4, 4)\r\n            \r\n            max_snr = float(abs(snr).max())\r\n            if max_snr > best_snr:\r\n                best_snr = max_snr\r\n                best_total_mass = m1 + m2\r\n    \r\n    results.append({\"approximant\": approx, \"snr\": best_snr, \"total_mass\": best_total_mass})\r\n    print(f\"Finished {approx}: SNR {best_snr}, Total Mass {best_total_mass}\")\r\n\r\n# Save results\r\ndf = pd.DataFrame(results)\r\ndf.to_csv(\"/root/detection_results.csv\", index=False)\r\nEOF\r\n"]
