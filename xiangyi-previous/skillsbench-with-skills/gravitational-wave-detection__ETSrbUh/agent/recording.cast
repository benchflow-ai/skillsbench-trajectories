[932.765088, "i", "cat << 'EOF' > analyze_gw.py\nimport numpy as np\nimport pandas as pd\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import matched_filter, resample_to_delta_t\nfrom pycbc.waveform import get_fd_waveform, get_td_waveform, td_approximants, fd_approximants\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nimport multiprocessing as mp\n\n# Global variables for workers to access via copy-on-write\ng_data = None\ng_psd = None\ng_flow = None\ng_td_apps = None\ng_fd_apps = None\n\ndef init_worker(data, psd, flow, td_apps, fd_apps):\n    global g_data, g_psd, g_flow, g_td_apps, g_fd_apps\n    g_data = data\n    g_psd = psd\n    g_flow = flow\n    g_td_apps = td_apps\n    g_fd_apps = fd_apps\n\ndef process_combination(args):\n    approx, m1, m2 = args\n    try:\n        if approx in g_td_apps:\n            hp, hc = get_td_waveform(approximant=approx,\n                                     mass1=m1, mass2=m2,\n                                     delta_t=g_data.delta_t, f_lower=g_flow)\n            hp.resize(len(g_data))\n      "]
[932.765148, "o", "cat << 'EOF' > analyze_gw.py\r\nimport numpy as np\r\nimport pandas as pd\r\nfrom pycbc.frame import read_frame\r\nfrom pycbc.filter import matched_filter, resample_to_delta_t\r\nfrom pycbc.waveform import get_fd_waveform, get_td_waveform, td_approximants, fd_approximants\r\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\r\nimport multiprocessing as mp\r\n\r\n# Global variables for workers to access via copy-on-write\r\ng_data = None\r\ng_psd = None\r\ng_flow = None\r\ng_td_apps = None\r\ng_fd_apps = None\r\n\r\ndef init_worker(data, psd, flow, td_apps, fd_apps):\r\n    global g_data, g_psd, g_flow, g_td_apps, g_fd_apps\r\n    g_data = data\r\n    g_psd = psd\r\n    g_flow = flow\r\n    g_td_apps = td_apps\r\n    g_fd_apps = fd_apps\r\n\r\ndef process_combination(args):\r\n    approx, m1, m2 = args\r\n    try:\r\n        if approx in g_td_apps:\r\n            hp, hc = get_td_waveform(approximant=approx,\r\n                                     mass1=m1, mass2=m2,\r\n                                     delta_t=g_data.delta_t, f_lower=g_flow)\r\n          "]
[932.765342, "i", "      template = hp.to_frequencyseries()\n        elif approx in g_fd_apps:\n            hp, hc = get_fd_waveform(approximant=approx,\n                                     mass1=m1, mass2=m2,\n                                     delta_f=g_data.delta_f, f_lower=g_flow)\n            template = hp\n        else:\n            return 0, 0\n        \n        template.resize(len(g_psd))\n        snr = matched_filter(template, g_data, psd=g_psd, low_frequency_cutoff=g_flow)\n        snr = snr.crop(4, 4)\n        max_snr = float(abs(snr).max())\n        return max_snr, m1 + m2\n    except Exception:\n        return 0, 0\n\nif __name__ == '__main__':\n    filename = \"/root/data/PyCBC_T2_2.gwf\"\n    channel = \"H1:TEST-STRAIN\"\n    mass_range = range(10, 41)\n    approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\n    flow = 30.0\n\n    print(\"Loading and conditioning data...\")\n    data = read_frame(filename, channel)\n    data = data.highpass_fir(15, 512)\n    data = resample_to_delta_t(data, 1.0/2048)\n    \n    psd = data.psd(2)\n    psd "]
[932.765356, "o", "  hp.resize(len(g_data))\r\n      "]
[932.765368, "i", "= interpolate(psd, data.delta_f)\n    psd = inverse_spectrum_truncation(psd, int(2 * data.sample_rate), low_frequency_cutoff=flow)\n\n    td_apps = td_approximants()\n    fd_apps = fd_approximants()\n\n    results = []\n    # Use 128 workers as available\n    num_cores = mp.cpu_count()\n    pool = mp.Pool(processes=num_cores, initializer=init_worker, initargs=(data, psd, flow, td_apps, fd_apps))\n\n    for approx in approximants:\n        actual_approx = approx\n        if approx == \"SEOBNRv4_opt\" and \"SEOBNRv4_opt\" not in td_apps and \"SEOBNRv4_opt\" not in fd_apps:\n            if \"SEOBNRv4\" in td_apps or \"SEOBNRv4\" in fd_apps:\n                actual_approx = \"SEOBNRv4\"\n        \n        tasks = []\n        for m1 in mass_range:\n            for m2 in range(10, m1 + 1):\n                tasks.append((actual_approx, m1, m2))\n        \n        print(f\"Processing {approx} ({actual_approx}) with {len(tasks)} combinations using {num_cores} cores...\")\n        worker_results = pool.map(process_combination, tasks)\n        \n        best"]
