[175.165561, "o", "> "]
[175.165626, "o", "    if current_block:\r\n\u001b[?2004l\r"]
[175.165652, "o", "\u001b[?2004h> "]
[175.165801, "o", "        node_blocks.append(current_block)\r\n\u001b[?2004l\r"]
[175.165827, "o", "\u001b[?2004h> "]
[175.165867, "o", "        \r\n\u001b[?2004l\r"]
[175.165894, "o", "\u001b[?2004h> "]
[175.165999, "o", "    parsed_nodes = []\r\n\u001b[?2004l\r"]
[175.166027, "o", "\u001b[?2004h> "]
[175.166121, "o", "    parsed_edges = []\r\n\u001b[?2004l\r"]
[175.166143, "o", "\u001b[?2004h> "]
[175.166169, "o", "    \r\n\u001b[?2004l\r"]
[175.166195, "o", "\u001b[?2004h> "]
[175.166309, "o", "    if not node_blocks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.166337, "o", "> "]
[175.166496, "o", "        return {\"nodes\": [], \"edges\": []}\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.166524, "o", "> "]
[175.16656, "o", "        \r\n\u001b[?2004l\r"]
[175.166583, "o", "\u001b[?2004h> "]
[175.166727, "o", "    first_node_id = node_blocks[0]['id']\r\n\u001b[?2004l\r"]
[175.166755, "o", "\u001b[?2004h> "]
[175.166931, "o", "    node_ids = set(b['id'] for b in node_blocks)\r\n\u001b[?2004l\r"]
[175.166945, "o", "\u001b[?2004h> "]
[175.166973, "o", "    \r\n\u001b[?2004l\r"]
[175.167001, "o", "\u001b[?2004h> "]
[175.167132, "o", "    # Pass 2: Parsing content\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.167158, "o", "> "]
[175.167274, "o", "    for block in node_blocks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.1673, "o", "> "]
[175.1674, "o", "        node_id = block['id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.167422, "o", "> "]
[175.167544, "o", "        lines = block['lines']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.167567, "o", "> "]
[175.167597, "o", "        \r\n\u001b[?2004l\r"]
[175.16762, "o", "\u001b[?2004h> "]
[175.167744, "o", "        is_choice = False\r\n\u001b[?2004l\r"]
[175.167769, "o", "\u001b[?2004h> "]
[175.167845, "o", "        choices = []\r\n\u001b[?2004l\r"]
[175.167871, "o", "\u001b[?2004h> "]
[175.167945, "o", "        dialogue_info = None\r\n\u001b[?2004l\r"]
[175.16797, "o", "\u001b[?2004h> "]
[175.167997, "o", "        \r\n\u001b[?2004l\r"]
[175.168021, "o", "\u001b[?2004h> "]
[175.168079, "o", "        for l in lines:\r\n\u001b[?2004l\r"]
[175.168105, "o", "\u001b[?2004h> "]
[175.16823, "o", "            # Split by last '->' to separate target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.168336, "o", "            parts = l.rsplit('->', 1)\r\n\u001b[?2004l\r"]
[175.168362, "o", "\u001b[?2004h> "]
[175.16843, "o", "            if len(parts) != 2:\r\n\u001b[?2004l\r"]
[175.168455, "o", "\u001b[?2004h> "]
[175.168521, "o", "                continue\r\n\u001b[?2004l\r"]
[175.168555, "o", "\u001b[?2004h> "]
[175.168582, "o", "                \r\n\u001b[?2004l\r"]
[175.168622, "o", "\u001b[?2004h> "]
[175.168715, "o", "            content = parts[0].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.16874, "o", "> "]
[175.16882, "o", "            target = parts[1].strip()\r\n\u001b[?2004l\r"]
[175.168849, "o", "\u001b[?2004h> "]
[175.168874, "o", "            \r\n\u001b[?2004l\r"]
[175.168898, "o", "\u001b[?2004h> "]
[175.169023, "o", "            # Check for choice: \"1. Text\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.169168, "o", "            m_choice = re.match(r'^(\\d+)\\.\\s+(.*)$', content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.169245, "o", "            if m_choice:\r\n\u001b[?2004l\r"]
[175.16927, "o", "\u001b[?2004h> "]
[175.169346, "o", "                is_choice = True\r\n\u001b[?2004l\r"]
[175.169362, "o", "\u001b[?2004h> "]
[175.169456, "o", "                choices.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.169502, "o", "> "]
[175.169592, "o", "                    'text': m_choice.group(2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.169608, "o", "> "]
[175.169704, "o", "                    'target': target\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.169719, "o", "> "]
[175.169768, "o", "                })\r\n\u001b[?2004l\r"]
[175.169809, "o", "\u001b[?2004h"]
[175.169849, "o", "> "]
[175.169889, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.169923, "o", "            \r\n\u001b[?2004l\r"]
[175.169954, "o", "\u001b[?2004h> "]
[175.170066, "o", "            # Check for dialogue: \"Speaker: Text\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.170095, "o", "> "]
[175.170237, "o", "            m_dialogue = re.match(r'^(.*?):\\s+(.*)$', content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.17031, "o", "            if m_dialogue:\r\n\u001b[?2004l\r"]
[175.170346, "o", "\u001b[?2004h> "]
[175.170419, "o", "                dialogue_info = {\r\n\u001b[?2004l\r"]
[175.170449, "o", "\u001b[?2004h> "]
[175.170561, "o", "                    'speaker': m_dialogue.group(1),\r\n\u001b[?2004l\r"]
[175.170588, "o", "\u001b[?2004h> "]
[175.170707, "o", "                    'text': m_dialogue.group(2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.170747, "o", "> "]
[175.170809, "o", "                    'target': target\r\n\u001b[?2004l\r"]
[175.170835, "o", "\u001b[?2004h> "]
[175.170878, "o", "                }\r\n\u001b[?2004l\r"]
[175.170904, "o", "\u001b[?2004h> "]
[175.170964, "o", "                continue\r\n\u001b[?2004l\r"]
[175.170994, "o", "\u001b[?2004h> "]
[175.171018, "o", "        \r\n\u001b[?2004l\r"]
[175.171042, "o", "\u001b[?2004h> "]
[175.171088, "o", "        node_obj = {\r\n\u001b[?2004l\r"]
[175.171114, "o", "\u001b[?2004h> "]
[175.171176, "o", "            \"id\": node_id,\r\n\u001b[?2004l\r"]
[175.171201, "o", "\u001b[?2004h> "]
[175.171272, "o", "            \"text\": \"\",\r\n\u001b[?2004l\r"]
[175.171311, "o", "\u001b[?2004h> "]
[175.171365, "o", "            \"speaker\": \"\",\r\n\u001b[?2004l\r"]
[175.171393, "o", "\u001b[?2004h> "]
[175.17146, "o", "            \"type\": \"line\"\r\n\u001b[?2004l\r"]
[175.171486, "o", "\u001b[?2004h> "]
[175.171515, "o", "        }\r\n\u001b[?2004l\r"]
[175.171546, "o", "\u001b[?2004h> "]
[175.171571, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.171595, "o", "> "]
[175.171644, "o", "        if is_choice:\r\n\u001b[?2004l\r"]
[175.171671, "o", "\u001b[?2004h> "]
[175.171772, "o", "            node_obj[\"type\"] = \"choice\"\r\n\u001b[?2004l\r"]
[175.171802, "o", "\u001b[?2004h> "]
[175.17186, "o", "            for c in choices:\r\n\u001b[?2004l\r"]
[175.171887, "o", "\u001b[?2004h> "]
[175.171983, "o", "                parsed_edges.append({\r\n\u001b[?2004l\r"]
[175.172011, "o", "\u001b[?2004h> "]
[175.1721, "o", "                    \"from\": node_id,\r\n\u001b[?2004l\r"]
[175.172125, "o", "\u001b[?2004h> "]
[175.172219, "o", "                    \"to\": c['target'],\r\n\u001b[?2004l\r"]
[175.172246, "o", "\u001b[?2004h> "]
[175.172343, "o", "                    \"text\": c['text']\r\n\u001b[?2004l\r"]
[175.172368, "o", "\u001b[?2004h> "]
[175.172406, "o", "                })\r\n\u001b[?2004l\r"]
[175.172433, "o", "\u001b[?2004h> "]
[175.1725, "o", "        elif dialogue_info:\r\n\u001b[?2004l\r"]
[175.172527, "o", "\u001b[?2004h> "]
[175.17262, "o", "            node_obj[\"type\"] = \"line\"\r\n\u001b[?2004l\r"]
[175.172647, "o", "\u001b[?2004h> "]
[175.172775, "o", "            node_obj[\"speaker\"] = dialogue_info['speaker']\r\n\u001b[?2004l\r"]
[175.172804, "o", "\u001b[?2004h> "]
[175.172915, "o", "            node_obj[\"text\"] = dialogue_info['text']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.172969, "o", "> "]
[175.173024, "o", "            parsed_edges.append({\r\n\u001b[?2004l\r"]
[175.17305, "o", "\u001b[?2004h> "]
[175.173129, "o", "                \"from\": node_id,\r\n\u001b[?2004l\r"]
[175.173155, "o", "\u001b[?2004h> "]
[175.173267, "o", "                \"to\": dialogue_info['target'],\r\n\u001b[?2004l\r"]
[175.173295, "o", "\u001b[?2004h> "]
[175.173358, "o", "                \"text\": \"\"\r\n\u001b[?2004l\r"]
[175.173386, "o", "\u001b[?2004h> "]
[175.173422, "o", "            })\r\n\u001b[?2004l\r"]
[175.173451, "o", "\u001b[?2004h> "]
[175.173476, "o", "        \r\n\u001b[?2004l\r"]
[175.173504, "o", "\u001b[?2004h> "]
[175.1736, "o", "        parsed_nodes.append(node_obj)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.173628, "o", "> "]
[175.173652, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.173677, "o", "> "]
[175.173753, "o", "    # Validation: Reachability BFS\r\n\u001b[?2004l\r"]
[175.173781, "o", "\u001b[?2004h> "]
[175.173831, "o", "    reachable = set()\r\n\u001b[?2004l\r"]
[175.173862, "o", "\u001b[?2004h> "]
[175.173922, "o", "    queue = [first_node_id]\r\n\u001b[?2004l\r"]
[175.173949, "o", "\u001b[?2004h> "]
[175.174025, "o", "    reachable.add(first_node_id)\r\n\u001b[?2004l\r"]
[175.174049, "o", "\u001b[?2004h> "]
[175.174074, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.174099, "o", "> "]
[175.174124, "o", "    idx = 0\r\n\u001b[?2004l\r"]
[175.17415, "o", "\u001b[?2004h> "]
[175.174216, "o", "    while idx < len(queue):\r\n\u001b[?2004l\r"]
[175.174247, "o", "\u001b[?2004h> "]
[175.174309, "o", "        curr = queue[idx]\r\n\u001b[?2004l\r"]
[175.174335, "o", "\u001b[?2004h> "]
[175.174375, "o", "        idx += 1\r\n\u001b[?2004l\r"]
[175.174408, "o", "\u001b[?2004h> "]
[175.174444, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.174519, "o", "        # Get outgoing edges\r\n\u001b[?2004l\r"]
[175.174548, "o", "\u001b[?2004h> "]
[175.174684, "o", "        outgoing = [e for e in parsed_edges if e['from'] == curr]\r\n\u001b[?2004l\r"]
[175.174716, "o", "\u001b[?2004h> "]
[175.17477, "o", "        for e in outgoing:\r\n\u001b[?2004l\r"]
[175.174794, "o", "\u001b[?2004h> "]
[175.174864, "o", "            tgt = e['to']\r\n\u001b[?2004l\r"]
[175.17489, "o", "\u001b[?2004h> "]
[175.174984, "o", "            if tgt not in reachable:\r\n\u001b[?2004l\r"]
[175.175011, "o", "\u001b[?2004h> "]
[175.175148, "o", "                # Check if target exists in parsed nodes or is \"End\"\r\n\u001b[?2004l\r"]
[175.175175, "o", "\u001b[?2004h> "]
[175.175275, "o", "                if tgt in node_ids:\r\n\u001b[?2004l\r"]
[175.175303, "o", "\u001b[?2004h> "]
[175.175398, "o", "                    reachable.add(tgt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.175427, "o", "> "]
[175.175505, "o", "                    queue.append(tgt)\r\n\u001b[?2004l\r"]
[175.175535, "o", "\u001b[?2004h> "]
[175.175614, "o", "                elif tgt == \"End\":\r\n\u001b[?2004l\r"]
[175.175644, "o", "\u001b[?2004h> "]
[175.175772, "o", "                    # End is reachable, but not a source node\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.175799, "o", "> "]
[175.175848, "o", "                    pass\r\n\u001b[?2004l\r"]
[175.175874, "o", "\u001b[?2004h> "]
[175.175898, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.175923, "o", "> "]
[175.176059, "o", "    final_nodes = [n for n in parsed_nodes if n['id'] in reachable]\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.176088, "o", ">     \r\n\u001b[?2004l\r"]
[175.176113, "o", "\u001b[?2004h> "]
[175.176296, "o", "    # Filter edges: must be from a reachable node AND (to a reachable node OR \"End\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.176351, "o", "    final_edges = []\r\n\u001b[?2004l\r"]
[175.176377, "o", "\u001b[?2004h> "]
[175.176449, "o", "    for e in parsed_edges:\r\n\u001b[?2004l\r"]
[175.176476, "o", "\u001b[?2004h> "]
[175.176568, "o", "        if e['from'] in reachable:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.176596, "o", "> "]
[175.176722, "o", "            if e['to'] in reachable or e['to'] == \"End\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.176823, "o", "                final_edges.append(e)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.176855, "o", ">     \r\n\u001b[?2004l\r"]
[175.176882, "o", "\u001b[?2004h> "]
[175.177037, "o", "    return {\"nodes\": final_nodes, \"edges\": final_edges}\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.177055, "o", "> \r\n\u001b[?2004l\r"]
[175.1771, "o", "\u001b[?2004h> "]
[175.177144, "o", "def generate_dot(graph):\r\n\u001b[?2004l\r"]
[175.177169, "o", "\u001b[?2004h> "]
[175.177258, "o", "    lines = [\"digraph Dialogue {\"]\r\n\u001b[?2004l\r"]
[175.177287, "o", "\u001b[?2004h> "]
[175.177391, "o", "    lines.append('  node [shape=box];')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.177415, "o", "    \r\n\u001b[?2004l\r"]
[175.177441, "o", "\u001b[?2004h> "]
[175.177509, "o", "    for n in graph['nodes']:\r\n\u001b[?2004l\r"]
[175.177538, "o", "\u001b[?2004h> "]
[175.177611, "o", "        if n['type'] == 'line':\r\n\u001b[?2004l\r"]
[175.177638, "o", "\u001b[?2004h> "]
[175.177776, "o", "            label = f\"{n['id']}\\\\n{n['speaker']}: {n['text']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.177816, "o", "        else:\r\n\u001b[?2004l\r"]
[175.177847, "o", "\u001b[?2004h> "]
[175.177911, "o", "            label = n['id']\r\n\u001b[?2004l\r"]
[175.177937, "o", "\u001b[?2004h> "]
[175.177963, "o", "        \r\n\u001b[?2004l\r"]
[175.177989, "o", "\u001b[?2004h> "]
[175.178061, "o", "        # Escape double quotes\r\n\u001b[?2004l\r"]
[175.178088, "o", "\u001b[?2004h> "]
[175.178196, "o", "        label = label.replace('\"', '\\\\\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.178226, "o", "> "]
[175.178343, "o", "        lines.append(f'  \"{n[\"id\"]}\" [label=\"{label}\"];')\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.178371, "o", "> "]
[175.178394, "o", "        \r\n\u001b[?2004l\r"]
[175.17842, "o", "\u001b[?2004h> "]
[175.178487, "o", "    for e in graph['edges']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.178514, "o", "> "]
[175.178566, "o", "        label = e['text']\r\n\u001b[?2004l\r"]
[175.178593, "o", "\u001b[?2004h> "]
[175.178691, "o", "        label = label.replace('\"', '\\\\\"')\r\n\u001b[?2004l\r"]
[175.178718, "o", "\u001b[?2004h> "]
[175.178876, "o", "        lines.append(f'  \"{e[\"from\"]}\" -> \"{e[\"to\"]}\" [label=\"{label}\"];')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.178909, "o", "        \r\n\u001b[?2004l\r"]
[175.178934, "o", "\u001b[?2004h> "]
[175.178985, "o", "    lines.append(\"}\")\r\n\u001b[?2004l\r"]
[175.179012, "o", "\u001b[?2004h> "]
[175.179079, "o", "    return \"\\n\".join(lines)\r\n\u001b[?2004l\r"]
[175.179106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.179135, "o", "\u001b[?2004h> "]
[175.179199, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[175.17923, "o", "\u001b[?2004h> "]
[175.179256, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.179281, "o", "> "]
[175.179385, "o", "        with open('/app/script.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[175.179412, "o", "\u001b[?2004h> "]
[175.179485, "o", "            content = f.read()\r\n\u001b[?2004l\r"]
[175.179513, "o", "\u001b[?2004h> "]
[175.179542, "o", "        \r\n\u001b[?2004l\r"]
[175.179568, "o", "\u001b[?2004h> "]
[175.179661, "o", "        graph = parse_script(content)\r\n\u001b[?2004l\r"]
[175.17969, "o", "\u001b[?2004h> "]
[175.179724, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.179846, "o", "        with open('/app/dialogue.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.179874, "o", "> "]
[175.179964, "o", "            json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r"]
[175.179994, "o", "\u001b[?2004h> "]
[175.180023, "o", "            \r\n\u001b[?2004l\r"]
[175.18005, "o", "\u001b[?2004h> "]
[175.180151, "o", "        dot_content = generate_dot(graph)\r\n\u001b[?2004l\r"]
[175.180181, "o", "\u001b[?2004h> "]
[175.180288, "o", "        with open('/app/dialogue.dot', 'w') as f:\r\n\u001b[?2004l\r"]
[175.180319, "o", "\u001b[?2004h> "]
[175.180392, "o", "            f.write(dot_content)\r\n\u001b[?2004l\r"]
[175.180418, "o", "\u001b[?2004h> "]
[175.180452, "o", "            \r\n\u001b[?2004l\r"]
[175.180478, "o", "\u001b[?2004h> "]
[175.180544, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[175.180573, "o", "\u001b[?2004h> "]
[175.180681, "o", "        print(f\"Error: {e}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.18071, "o", "> "]
[175.180746, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[175.18077, "o", "\u001b[?2004h> "]
[175.180797, "o", "EOF\r\n\u001b[?2004l\r"]
