[175.162309, "i", "cat << 'EOF' > /app/solution.py\nimport re\nimport json\nimport sys\n\ndef parse_script(text):\n    lines = text.split('\\n')\n    node_blocks = []\n    current_block = None\n    \n    # Pass 1: Block identification\n    for line in lines:\n        line = line.strip()\n        if not line:\n            continue\n        \n        m_header = re.match(r'^\\[(.*?)\\]$', line)\n        if m_header:\n            if current_block:\n                node_blocks.append(current_block)\n            current_block = {'id': m_header.group(1), 'lines': []}\n        else:\n            if current_block:\n                current_block['lines'].append(line)\n    \n    if current_block:\n        node_blocks.append(current_block)\n        \n    parsed_nodes = []\n    parsed_edges = []\n    \n    if not node_blocks:\n        return {\"nodes\": [], \"edges\": []}\n        \n    first_node_id = node_blocks[0]['id']\n    node_ids = set(b['id'] for b in node_blocks)\n    \n    # Pass 2: Parsing content\n    for block in node_blocks:\n        node_id = block['id']\n        lines = "]
[175.162493, "i", "block['lines']\n        \n        is_choice = False\n        choices = []\n        dialogue_info = None\n        \n        for l in lines:\n            # Split by last '->' to separate target\n            parts = l.rsplit('->', 1)\n            if len(parts) != 2:\n                continue\n                \n            content = parts[0].strip()\n            target = parts[1].strip()\n            \n            # Check for choice: \"1. Text\"\n            m_choice = re.match(r'^(\\d+)\\.\\s+(.*)$', content)\n            if m_choice:\n                is_choice = True\n                choices.append({\n                    'text': m_choice.group(2),\n                    'target': target\n                })\n                continue\n            \n            # Check for dialogue: \"Speaker: Text\"\n            m_dialogue = re.match(r'^(.*?):\\s+(.*)$', content)\n            if m_dialogue:\n                dialogue_info = {\n                    'speaker': m_dialogue.group(1),\n                    'text': m_dialogue.group(2),\n                    'targe"]
[175.16254, "o", "cat << 'EOF' > /app/solution.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.162571, "i", "t': target\n                }\n                continue\n        \n        node_obj = {\n            \"id\": node_id,\n            \"text\": \"\",\n            \"speaker\": \"\",\n            \"type\": \"line\"\n        }\n        \n        if is_choice:\n            node_obj[\"type\"] = \"choice\"\n            for c in choices:\n                parsed_edges.append({\n                    \"from\": node_id,\n                    \"to\": c['target'],\n                    \"text\": c['text']\n                })\n        elif dialogue_info:\n            node_obj[\"type\"] = \"line\"\n            node_obj[\"speaker\"] = dialogue_info['speaker']\n            node_obj[\"text\"] = dialogue_info['text']\n            parsed_edges.append({\n                \"from\": node_id,\n                \"to\": dialogue_info['target'],\n                \"text\": \"\"\n            })\n        \n        parsed_nodes.append(node_obj)\n        \n    # Validation: Reachability BFS\n    reachable = set()\n    queue = [first_node_id]\n    reachable.add(first_node_id)\n    \n    idx = 0\n    while idx < len(queue):\n"]
[175.162603, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[175.162627, "i", "        curr = queue[idx]\n        idx += 1\n        \n        # Get outgoing edges\n        outgoing = [e for e in parsed_edges if e['from'] == curr]\n        for e in outgoing:\n            tgt = e['to']\n            if tgt not in reachable:\n                # Check if target exists in parsed nodes or is \"End\"\n                if tgt in node_ids:\n                    reachable.add(tgt)\n                    queue.append(tgt)\n                elif tgt == \"End\":\n                    # End is reachable, but not a source node\n                    pass\n    \n    final_nodes = [n for n in parsed_nodes if n['id'] in reachable]\n    \n    # Filter edges: must be from a reachable node AND (to a reachable node OR \"End\")\n    final_edges = []\n    for e in parsed_edges:\n        if e['from'] in reachable:\n            if e['to'] in reachable or e['to'] == \"End\":\n                final_edges.append(e)\n    \n    return {\"nodes\": final_nodes, \"edges\": final_edges}\n\ndef generate_dot(graph):\n    lines = [\"digraph Dialogue {\"]\n    lines.append('  "]
[175.162654, "o", "\u001b[?2004h> "]
[175.162679, "i", "node [shape=box];')\n    \n    for n in graph['nodes']:\n        if n['type'] == 'line':\n            label = f\"{n['id']}\\\\n{n['speaker']}: {n['text']}\"\n        else:\n            label = n['id']\n        \n        # Escape double quotes\n        label = label.replace('\"', '\\\\\"')\n        lines.append(f'  \"{n[\"id\"]}\" [label=\"{label}\"];')\n        \n    for e in graph['edges']:\n        label = e['text']\n        label = label.replace('\"', '\\\\\"')\n        lines.append(f'  \"{e[\"from\"]}\" -> \"{e[\"to\"]}\" [label=\"{label}\"];')\n        \n    lines.append(\"}\")\n    return \"\\n\".join(lines)\n\nif __name__ == \"__main__\":\n    try:\n        with open('/app/script.txt', 'r') as f:\n            content = f.read()\n        \n        graph = parse_script(content)\n        \n        with open('/app/dialogue.json', 'w') as f:\n            json.dump(graph, f, indent=2)\n            \n        dot_content = generate_dot(graph)\n        with open('/app/dialogue.dot', 'w') as f:\n            f.write(dot_content)\n            \n    except Exception as e:\n        pr"]
