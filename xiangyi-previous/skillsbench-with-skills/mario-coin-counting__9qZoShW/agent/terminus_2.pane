[?2004hroot@2676f8d92917:~# cat > /root/process_frames.py << 'EOF'
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import csv
[?2004l[?2004h> import glob
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Get all keyframe files sorted
[?2004l[?2004h> keyframe_files = sorted(glob.glob('/root/keyframes_*.png'))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found {len(keyframe_files)} keyframes")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Convert all frames to grayscale in place
[?2004l[?2004h> for frame_path in keyframe_files:
[?2004l[?2004h>     img = cv2.imread(frame_path)
[?2004l[?2004h>     gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     cv2.imwrite(frame_path, gray)
[?2004l[?2004h>     print(f"Converted {frame_path} to grayscale")
[?2004l[?2004h> 
[?2004l[?2004h> # Load template images and convert to grayscale
[?2004l[?2004h> coin_template = cv2.imread('/root/coin.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> enemy_template = cv2.imread('/root/enemy.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> turtle_template = cv2.imread('/root/turtle.png', cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Coin template shape: {coin_template.shape}")
[?2004l[?2004h> print(f"Enemy template shape: {enemy_template.shape}")
[?2004l[?2004h> print(f"Turtle template shape: {turtle_template.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> def count_objects(frame, template, threshold=0.8):
[?2004l[?2004h>     """Count objects in frame using template matching"""
[?2004l[?2004h>     if frame is None or template is None:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Perform template matching
[?2004l[?2004h>     result = cv2.matchTemplate(frame, template, cv2.TM_CCOEFF_NORMED)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find locations where matching exceeds threshold
[?2004l[?2004h>     locations = np.where(result >= threshold)
[?2004l[?2004h>     
[?2004l[?2004h>     # Group nearby detections using non-maximum suppression
[?2004l[?2004h>     matches = list(zip(*locations[::-1]))
[?2004l[?2004h>     
[?2004l[?2004h>     if len(matches) == 0:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Simple clustering to avoid counting same object multiple times
[?2004l[?2004h>     template_h, template_w = template.shape
[?2004l[?2004h>     filtered_matches = []
[?2004l[?2004h>     
[?2004l[?2004h>     for match in matches:
[?2004l[?2004h>         # Check if this match is far enough from existing matches
[?2004l[?2004h>         is_new = True
[?2004l[?2004h>         for existing in filtered_matches:
[?2004l[?2004h>             distance = np.sqrt((match[0] - existing[0])**2 + (match[1] - existing[1])**2)
[?2004l[?2004h>             if distance < template_w * 0.5:  # If within half template width
[?2004l[?2004h>                 is_new = False
[?2004l[?2004h>                 break
[?2004l[?2004h>         if is_new:
[?2004l[?2004h>             filtered_matches.append(match)
[?2004l[?2004h>     
[?2004l[?2004h>     return len(filtered_matches)
[?2004l[?2004h> 
[?2004l[?2004h> # Process each frame and count objects
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for frame_path in keyframe_files:
[?2004l[?2004h>     frame = cv2.imread(frame_path, cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h>     
[?2004l[?2004h>     # Count each object type
[?2004l[?2004h>     coins = count_objects(frame, coin_template, threshold=0.8)
[?2004l[?2004h>     enemies = count_objects(frame, enemy_template, threshold=0.8)
[?2004l[?2004h>     turtles = count_objects(frame, turtle_template, threshold=0.8)
[?2004l[?2004h>     
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'frame_id': frame_path,
[?2004l[?2004h>         'coins': coins,
[?2004l[?2004h>         'enemies': enemies,
[?2004l[?2004h>         'turtles': turtles
[?2004l[?2004h>     })
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{frame_path}: coins={coins}, enemies={enemies}, turtles={turtles}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/counting_results.csv', 'w', newline='') as csvfile:
[?2004l[?2004h>     fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']
[?2004l[?2004h>     writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
[?2004l[?2004h>     
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     for result in results:
[?2004l[?2004h>         writer.writerow(result)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nResults written to /root/counting_results.csv")
[?2004l[?2004h> EOF
