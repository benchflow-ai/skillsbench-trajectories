[31.465125, "o", "\u001b[?2004hroot@2676f8d92917:~# "]
[47.599027, "i", "cat > /root/process_frames.py << 'EOF'\nimport cv2\nimport numpy as np\nimport csv\nimport glob\nimport os\n\n# Get all keyframe files sorted\nkeyframe_files = sorted(glob.glob('/root/keyframes_*.png'))\n\nprint(f\"Found {len(keyframe_files)} keyframes\")\n\n# Step 1: Convert all frames to grayscale in place\nfor frame_path in keyframe_files:\n    img = cv2.imread(frame_path)\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    cv2.imwrite(frame_path, gray)\n    print(f\"Converted {frame_path} to grayscale\")\n\n# Load template images and convert to grayscale\ncoin_template = cv2.imread('/root/coin.png', cv2.IMREAD_GRAYSCALE)\nenemy_template = cv2.imread('/root/enemy.png', cv2.IMREAD_GRAYSCALE)\nturtle_template = cv2.imread('/root/turtle.png', cv2.IMREAD_GRAYSCALE)\n\nprint(f\"Coin template shape: {coin_template.shape}\")\nprint(f\"Enemy template shape: {enemy_template.shape}\")\nprint(f\"Turtle template shape: {turtle_template.shape}\")\n\ndef count_objects(frame, template, threshold=0.8):\n    \"\"\"Count objects in frame using template matching\"\"\"\n    if frame is None or template is None:\n        return 0\n    \n    # Perform template matching\n    result = cv2.matchTemplate(frame, template, cv2.TM_CCOEFF_NORMED)\n    \n    # Find locations where matching exceeds threshold\n    locations = np.where(result >= threshold)\n    \n    # Group nearby detections using non-maximum suppression\n    matches = list(zip(*locations[::-1]))\n    \n    if len(matches) == 0:\n        return 0\n    \n    # Simple clustering to avoid counting same object multiple times\n    template_h, template_w = template.shape\n    filtered_matches = []\n    \n    for match in matches:\n        # Check if this match is far enough from existing matches\n        is_new = True\n        for existing in filtered_matches:\n            distance = np.sqrt((match[0] - existing[0])**2 + (match[1] - existing[1])**2)\n            if distance < template_w * 0.5:  # If within half template width\n                is_new = False\n                break\n        if is_new:\n            filtered_matches.append(match)\n    \n    return len(filtered_matches)\n\n# Process each frame and count objects\nresults = []\n\nfor frame_path in keyframe_files:\n    frame = cv2.imread(frame_path, cv2.IMREAD_GRAYSCALE)\n    \n    # Count each object type\n    coins = count_objects(frame, coin_template, threshold=0.8)\n    enemies = count_objects(frame, enemy_template, threshold=0.8)\n    turtles = count_objects(frame, turtle_template, threshold=0.8)\n    \n    results.append({\n        'frame_id': frame_path,\n        'coins': coins,\n        'enemies': enemies,\n        'turtles': turtles\n    })\n    \n    print(f\"{frame_path}: coins={coins}, enemies={enemies}, turtles={turtles}\")\n\n# Write results to CSV\nwith open('/root/counting_results.csv', 'w', newline='') as csvfile:\n    fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    \n    writer.writeheader()\n    for result in results:\n        writer.writerow(result)\n\nprint(\"\\nResults written to /root/counting_results.csv\")\nEOF\n"]
