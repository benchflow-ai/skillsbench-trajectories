[71.787717, "i", "cat > /tmp/parse_vulns.py << 'EOF'\nimport json\nimport csv\n\n# Load the trivy JSON output\nwith open('/tmp/trivy-output.json', 'r') as f:\n    data = json.load(f)\n\n# Extract vulnerabilities\nvulnerabilities = []\nfor result in data.get('Results', []):\n    for vuln in result.get('Vulnerabilities', []):\n        # Get CVSS score - prioritize from available sources\n        cvss_score = 'N/A'\n        cvss_data = vuln.get('CVSS', {})\n        \n        # Try to get CVSS score from different sources\n        if 'nvd' in cvss_data and 'V3Score' in cvss_data['nvd']:\n            cvss_score = cvss_data['nvd']['V3Score']\n        elif 'ghsa' in cvss_data and 'V3Score' in cvss_data['ghsa']:\n            cvss_score = cvss_data['ghsa']['V3Score']\n        elif 'redhat' in cvss_data and 'V3Score' in cvss_data['redhat']:\n            cvss_score = cvss_data['redhat']['V3Score']\n        else:\n            # Try to get from any available source\n            for source in cvss_data.values():\n                if isinstance(source, dict) and 'V3Score' in source:\n                    cvss_score = source['V3Score']\n                    break\n        \n        # Get fixed version - check if it exists\n        fixed_version = vuln.get('FixedVersion', 'N/A')\n        \n        # Get primary URL\n        url = vuln.get('PrimaryURL', 'N/A')\n        \n        # Create vulnerability record\n        vuln_record = {\n            'Package': vuln.get('PkgName', 'N/A'),\n            'Version': vuln.get('InstalledVersion', 'N/A'),\n            'CVE_ID': vuln.get('VulnerabilityID', 'N/A'),\n            'Severity': vuln.get('Severity', 'N/A'),\n            'CVSS_Score': cvss_score,\n            'Fixed_Version': fixed_version,\n            'Title': vuln.get('Title', 'N/A'),\n            'Url': url\n        }\n        \n        vulnerabilities.append(vuln_record)\n\n# Write to CSV\nwith open('/root/security_audit.csv', 'w', newline='') as csvfile:\n    fieldnames = ['Package', 'Version', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    \n    writer.writeheader()\n    for vuln in vulnerabilities:\n        writer.writerow(vuln)\n\nprint(f'Successfully wrote {len(vulnerabilities)} vulnerabilities to /root/security_audit.csv')\nEOF\n"]
