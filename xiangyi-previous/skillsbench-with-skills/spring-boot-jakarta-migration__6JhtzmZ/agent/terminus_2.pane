[?2004l[?2004h>     @Size(min = 3, max = 50, message = "Username must be between 3 and 50 characters")
[?2004l[?2004h>     private String username;
[?2004l[?2004h> 
[?2004l[?2004h>     @NotBlank(message = "Email is required")
[?2004l[?2004h>     @Email(message = "Invalid email format")
[?2004l[?2004h>     private String email;
[?2004l[?2004h> 
[?2004l[?2004h>     @NotBlank(message = "Password is required")
[?2004l[?2004h>     @Size(min = 8, message = "Password must be at least 8 characters")
[?2004l[?2004h>     private String password;
[?2004l[?2004h> 
[?2004l[?2004h>     private String firstName;
[?2004l[?2004h>     private String lastName;
[?2004l[?2004h>     private Role role;
[?2004l[?2004h> 
[?2004l[?2004h>     // Constructors
[?2004l[?2004h>     public CreateUserRequest() {}
[?2004l[?2004h> 
[?2004l[?2004h>     public CreateUserRequest(String username, String email, String password) {
[?2004l[?2004h>         this.username = username;
[?2004l[?2004h>         this.email = email;
