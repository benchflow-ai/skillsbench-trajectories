[?2004l[?2004h>         return authenticationConfiguration.getAuthenticationManager();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Bean
[?2004l[?2004h>     public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
[?2004l[?2004h>         http
[?2004l[?2004h>             .csrf(AbstractHttpConfigurer::disable)
[?2004l[?2004h>             .sessionManagement(session -> session
[?2004l[?2004h>                 .sessionCreationPolicy(SessionCreationPolicy.STATELESS))
[?2004l[?2004h>             .exceptionHandling(exception -> exception
[?2004l[?2004h>                 .authenticationEntryPoint((request, response, ex) -> {
[?2004l[?2004h>                     response.sendError(HttpServletResponse.SC_UNAUTHORIZED, ex.getMessage());
[?2004l[?2004h>                 }))
[?2004l[?2004h>             .authorizeHttpRequests(authorize -> authorize
[?2004l[?2004h>                 // Public endpoints
[?2004l[?2004h>                 .requestMatchers(HttpMethod.POST, "/api/users").permitAll()
[?2004l[?2004h>                 .requestMatchers("/api/auth/**").permitAll()
[?2004l[?2004h>                 .requestMatchers("/h2-console/**").permitAll()
[?2004l[?2004h>                 .requestMatchers("/actuator/health").permitAll()
[?2004l[?2004h>                 // All other endpoints require authentication
[?2004l[?2004h>                 .anyRequest().authenticated())
[?2004l[?2004h>             .headers(headers -> headers
[?2004l[?2004h>                 .frameOptions(HeadersConfigurer.FrameOptionsConfig::disable)); // For H2 console
[?2004l[?2004h> 
[?2004l[?2004h>         return http.build();
[?2004l[?2004h>     }
[?2004l[?2004h> }
