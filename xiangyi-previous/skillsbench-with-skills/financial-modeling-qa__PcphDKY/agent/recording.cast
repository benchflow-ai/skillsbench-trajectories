[44.056896, "i", "python3 << 'EOF'\nimport subprocess\nimport sys\n\n# Try to extract text from PDF\ntry:\n    result = subprocess.run(['pdftotext', '/root/background.pdf', '-'], \n                          capture_output=True, text=True, timeout=5)\n    if result.returncode == 0:\n        print(result.stdout)\n    else:\n        print(\"pdftotext not available, trying alternative method\")\nexcept:\n    print(\"pdftotext failed\")\n    # Try with pypdf if available\n    try:\n        from PyPDF2 import PdfReader\n        reader = PdfReader('/root/background.pdf')\n        for page in reader.pages:\n            print(page.extract_text())\n    except:\n        print(\"PyPDF2 not available either\")\nEOF\n"]
[44.0608, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try to extract text from PDF\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     result = subprocess.run(['pdftotext', '/root/background.pdf', '-'], \r\n\u001b[?2004l\r\u001b[?2004h>                           capture_output=True, text=True, timeout=5)\r\n\u001b[?2004l\r\u001b[?2004h>     if result.returncode == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         print(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"pdftotext not available, trying alternative method\")\r\n\u001b[?2004l\r\u001b[?2004h> except:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"pdftotext failed\")\r\n\u001b[?2004l\r\u001b[?2004h>     # Try with pypdf if available\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         from PyPDF2 import PdfReader\r\n\u001b[?2004l\r\u001b[?2004h>         reader = PdfReader('/root/background.pdf')\r\n\u001b[?2004l\r\u001b[?2004h>         for page in reader.pages:\r\n\u001b[?2004l\r\u001b[?2004h>             print(page.extract_text())\r\n\u001b[?2004l\r\u001b[?2004h>     except:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"PyPDF2 not available either\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
