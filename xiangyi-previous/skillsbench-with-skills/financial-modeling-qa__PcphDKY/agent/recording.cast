[85.813057, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read raw data\ndf_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)\n\nprint(f\"Total rows in raw data: {len(df_raw)}\")\nprint(f\"\\nRows 8-20 (checking for data):\")\nfor i in range(8, min(20, len(df_raw))):\n    print(f\"Row {i}: {df_raw.iloc[i, 2:10].tolist()}\")\n\nprint(f\"\\nRows 6000-6008 (checking end):\")\nfor i in range(max(0, len(df_raw)-10), len(df_raw)):\n    print(f\"Row {i}: {df_raw.iloc[i, 2:10].tolist()}\")\n\n# Check for empty rows\nprint(f\"\\nChecking rows with NaN in column 2 (Turn number):\")\nfor i in range(8, min(100, len(df_raw))):\n    if pd.isna(df_raw.iloc[i, 2]):\n        print(f\"Row {i} has NaN in Turn number\")\n        if i > 20:\n            break\nEOF\n"]
