[68.557331, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read the Formats sheet\ndf_formats = pd.read_excel('/root/data.xlsx', sheet_name='Formats', header=None)\n\nprint(\"Formats sheet (all non-NaN values):\")\nprint(\"\\nShape:\", df_formats.shape)\nprint(\"\\nContent:\")\nfor row_idx, row in df_formats.iterrows():\n    non_nan = [(i, val) for i, val in enumerate(row) if pd.notna(val)]\n    if non_nan:\n        print(f\"\\nRow {row_idx}:\")\n        for col_idx, val in non_nan:\n            print(f\"  Col {col_idx}: {val}\")\nEOF\n"]
