[114.843148, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read raw data\ndf_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)\n\n# Extract relevant columns\ndata = []\nfor i in range(9, len(df_raw)):\n    turn = df_raw.iloc[i, 2]\n    game = df_raw.iloc[i, 3]\n    rolls = df_raw.iloc[i, 4:10].tolist()\n    \n    if pd.notna(turn) and pd.notna(game):\n        roll_sum = sum([int(r) if pd.notna(r) else 0 for r in rolls])\n        data.append({\n            'Turn': int(turn),\n            'Game': int(game),\n            'RollSum': roll_sum\n        })\n\ndf = pd.DataFrame(data)\n\n# Group by game and get both turns\ngame_results = []\nfor game_num in sorted(df['Game'].unique()):\n    game_data = df[df['Game'] == game_num].sort_values('Turn')\n    turns = game_data['RollSum'].tolist()\n    \n    if len(turns) == 2:\n        turn1_sum = turns[0]\n        turn2_sum = turns[1]\n        if turn1_sum > turn2_sum:\n            winner = 1  # Turn 1 wins\n        elif turn2_sum > turn1_sum:\n            winner = 2  # Turn 2 wins\n        else:\n            winner = 0  # Tie\n        \n        game_results.append({\n            'Game': game_num,\n            'Turn1Sum': turn1_sum,\n            'Turn2Sum': turn2_sum,\n            'GameWinner': winner\n        })\n    else:\n        print(f\"Game {game_num} has {len(turns)} turns: {turns}\")\n\nresults_df = pd.DataFrame(game_results)\nprint(f\"Total games with 2 turns: {len(results_df)}\")\nprint(f\"\\nFirst 10 game results:\")\nprint(results_df.head(10))\nprint(f\"\\nLast 10 game results:\")\nprint(results_df.tail(10))\nprint(f\"\\nWinner distribution:\")\nprint(results_df['GameWinner'].value_counts().sort_index())\nEOF\n"]
