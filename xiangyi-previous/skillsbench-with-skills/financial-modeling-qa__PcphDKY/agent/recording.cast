[97.197942, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read raw data\ndf_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)\n\n# Extract relevant columns and skip header row\ndata = []\nfor i in range(9, len(df_raw)):\n    turn = df_raw.iloc[i, 2]\n    game = df_raw.iloc[i, 3]\n    rolls = df_raw.iloc[i, 4:10].tolist()\n    \n    # Skip rows with NaN values\n    if pd.notna(turn) and pd.notna(game):\n        data.append({\n            'Turn': int(turn),\n            'Game': int(game),\n            'Roll1': int(rolls[0]) if pd.notna(rolls[0]) else 0,\n            'Roll2': int(rolls[1]) if pd.notna(rolls[1]) else 0,\n            'Roll3': int(rolls[2]) if pd.notna(rolls[2]) else 0,\n            'Roll4': int(rolls[3]) if pd.notna(rolls[3]) else 0,\n            'Roll5': int(rolls[4]) if pd.notna(rolls[4]) else 0,\n            'Roll6': int(rolls[5]) if pd.notna(rolls[5]) else 0,\n        })\n\ndf = pd.DataFrame(data)\nprint(f\"Total data rows: {len(df)}\")\nprint(f\"Games: {df['Game'].min()} to {df['Game'].max()}\")\nprint(f\"Unique games: {df['Game'].nunique()}\")\nprint(f\"\\nFirst 10 rows:\")\nprint(df.head(10))\nprint(f\"\\nLast 10 rows:\")\nprint(df.tail(10))\n\n# Calculate sum of rolls for each turn\ndf['RollSum'] = df['Roll1'] + df['Roll2'] + df['Roll3'] + df['Roll4'] + df['Roll5'] + df['Roll6']\nprint(f\"\\nRoll sums - min: {df['RollSum'].min()}, max: {df['RollSum'].max()}, mean: {df['RollSum'].mean():.2f}\")\n\n# Group by game to see structure\nprint(f\"\\nSample game data (Game 1):\")\nprint(df[df['Game'] == 1])\nprint(f\"\\nSample game data (Game 2):\")\nprint(df[df['Game'] == 2])\nEOF\n"]
