[77.598169, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read raw data starting from row 8 (the header)\ndf_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)\n\n# Extract data starting from row 8 (header) and row 9 onwards (data)\nheader = df_raw.iloc[8, 2:10].tolist()  # Columns 2-9\ndata_rows = []\n\nfor row_idx in range(9, len(df_raw)):\n    row_data = df_raw.iloc[row_idx, 2:10].tolist()  # Columns 2-9\n    if pd.notna(row_data[0]):  # If Turn number is not NaN\n        data_rows.append(row_data)\n    else:\n        break  # Stop when we hit empty rows\n\n# Create dataframe\ndf = pd.DataFrame(data_rows, columns=header)\ndf = df.dropna(subset=['Turn number'])\n\nprint(f\"Total rows: {len(df)}\")\nprint(f\"\\nFirst 30 rows:\")\nprint(df.head(30))\nprint(f\"\\nGame numbers range: {df['Game number'].min()} to {df['Game number'].max()}\")\nprint(f\"\\nNumber of unique games: {df['Game number'].nunique()}\")\nEOF\n"]
