[60.559429, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read raw data\ndf_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)\n\n# Get the actual header row (row 8, 0-indexed)\nheader_row = df_raw.iloc[8].tolist()\nprint(\"Full header row:\")\nfor i, h in enumerate(header_row):\n    print(f\"Col {i}: {h}\")\n\n# Look at a few complete data rows\nprint(\"\\n\\nFirst 5 data rows (rows 9-13):\")\nfor row_idx in range(9, 14):\n    print(f\"\\nRow {row_idx}:\")\n    for i, val in enumerate(df_raw.iloc[row_idx]):\n        if pd.notna(val):\n            print(f\"  Col {i}: {val}\")\nEOF\n"]
