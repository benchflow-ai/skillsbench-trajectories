[?2004hroot@3086b14f7f9a:~# python3 << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> # Read raw data
[?2004l[?2004h> df_raw = pd.read_excel('/root/data.xlsx', sheet_name='Data', header=None)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract relevant columns
[?2004l[?2004h> data = []
[?2004l[?2004h> for i in range(9, len(df_raw)):
[?2004l[?2004h>     turn = df_raw.iloc[i, 2]
[?2004l[?2004h>     game = df_raw.iloc[i, 3]
[?2004l[?2004h>     rolls = df_raw.iloc[i, 4:10].tolist()
[?2004l[?2004h>     
[?2004l[?2004h>     if pd.notna(turn) and pd.notna(game):
[?2004l[?2004h>         roll_sum = sum([int(r) if pd.notna(r) else 0 for r in rolls])
[?2004l[?2004h>         data.append({
[?2004l[?2004h>             'Turn': int(turn),
[?2004l[?2004h>             'Game': int(game),
[?2004l[?2004h>             'RollSum': roll_sum
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.DataFrame(data)
[?2004l[?2004h> 
[?2004l[?2004h> # Group by game and determine winners
[?2004l[?2004h> game_winners = {}
[?2004l[?2004h> for game_num in sorted(df['Game'].unique()):
[?2004l[?2004h>     game_data = df[df['Game'] == game_num].sort_values('Turn')
[?2004l[?2004h>     turns = game_data['RollSum'].tolist()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(turns) == 2:
[?2004l[?2004h>         turn1_sum = turns[0]
[?2004l[?2004h>         turn2_sum = turns[1]
[?2004l[?2004h>         if turn1_sum > turn2_sum:
[?2004l[?2004h>             winner = 1  # Turn 1 wins
[?2004l[?2004h>         elif turn2_sum > turn1_sum:
[?2004l[?2004h>             winner = 2  # Turn 2 wins
[?2004l[?2004h>         else:
[?2004l[?2004h>             winner = 0  # Tie
[?2004l[?2004h>         game_winners[game_num] = winner
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total games with winners: {len(game_winners)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now match games in pairs and count match wins
[?2004l[?2004h> player1_match_wins = 0  # Player 1 plays odd games
[?2004l[?2004h> player2_match_wins = 0  # Player 2 plays even games
[?2004l[?2004h> 
[?2004l[?2004h> # Create matches: game 1 vs 2, game 3 vs 4, etc.
[?2004l[?2004h> for odd_game in range(1, 3000, 2):
[?2004l[?2004h>     even_game = odd_game + 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if both games exist
[?2004l[?2004h>     if odd_game in game_winners and even_game in game_winners:
[?2004l[?2004h>         odd_winner = game_winners[odd_game]
[?2004l[?2004h>         even_winner = game_winners[even_game]
[?2004l[?2004h>         
[?2004l[?2004h>         # Determine match winner
[?2004l[?2004h>         # If odd game's turn 1 wins, Player 1 wins the match
[?2004l[?2004h>         # If even game's turn 1 wins, Player 2 wins the match
[?2004l[?2004h>         if odd_winner == 1:  # Odd game won (Turn 1 of odd game won)
[?2004l[?2004h>             player1_match_wins += 1
[?2004l[?2004h>         elif even_winner == 1:  # Even game won (Turn 1 of even game won)
[?2004l[?2004h>             player2_match_wins += 1
[?2004l[?2004h>         # If tied (winner == 0), no one gets a match win
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nPlayer 1 (odd games) match wins: {player1_match_wins}")
[?2004l[?2004h> print(f"Player 2 (even games) match wins: {player2_match_wins}")
[?2004l[?2004h> print(f"Difference (Player 1 - Player 2): {player1_match_wins - player2_match_wins}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write answer to file
[?2004l[?2004h> with open('/root/answer.txt', 'w') as f:
[?2004l[?2004h>     f.write(str(player1_match_wins - player2_match_wins))
[?2004l[?2004h> 
