[?2004l[?2004h> import pycbc
[?2004l[?2004h> from pycbc.frame import read_frame
[?2004l[?2004h> from pycbc.filter import highpass, lowpass_fir, matched_filter
[?2004l[?2004h> from pycbc.waveform import get_td_waveform
[?2004l[?2004h> from pycbc.psd import interpolate, inverse_spectrum_truncation
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> # Read the data
[?2004l[?2004h> print("Reading data...")
[?2004l[?2004h> strain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')
[?2004l[?2004h> print(f"Data loaded: {len(strain)} samples at {strain.sample_rate} Hz")
[?2004l[?2004h> 
[?2004l[?2004h> # Condition the data
[?2004l[?2004h> print("Conditioning data...")
[?2004l[?2004h> # Highpass filter to remove low frequency noise
[?2004l[?2004h> strain = highpass(strain, 15.0)
[?2004l[?2004h> # Resample to 2048 Hz for efficiency
[?2004l[?2004h> strain = strain.resample(2048)
[?2004l[?2004h> print(f"Conditioned data: {len(strain)} samples at {strain.sample_rate} Hz")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate PSD for whitening
[?2004l[?2004h> print("Calculating PSD...")
[?2004l[?2004h> from pycbc.psd import welch
[?2004l[?2004h> psd = welch(strain, seg_len=4, seg_stride=2)
[?2004l[?2004h> psd = interpolate(psd, strain.delta_f)
[?2004l[?2004h> psd = inverse_spectrum_truncation(psd, int(4 * strain.sample_rate), low_frequency_cutoff=15.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Define approximants to test
[?2004l[?2004h> approximants = ["SEOBNRv4_opt", "IMRPhenomD", "TaylorT4"]
[?2004l[?2004h> mass_range = range(10, 41)  # 10 to 40 inclusive
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for approx in approximants:
[?2004l[?2004h>     print(f"\nTesting approximant: {approx}")
[?2004l[?2004h>     best_snr = 0
[?2004l[?2004h>     best_params = None
[?2004l[?2004h>     
[?2004l[?2004h>     for m1 in mass_range:
[?2004l[?2004h>         for m2 in mass_range:
[?2004l[?2004h>             if m2 > m1:  # Skip symmetric cases for efficiency
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             try:
[?2004l[?2004h>                 # Generate template
[?2004l[?2004h>                 hp, hc = get_td_waveform(
[?2004l[?2004h>                     approximant=approx,
[?2004l[?2004h>                     mass1=m1,
[?2004l[?2004h>                     mass2=m2,
[?2004l[?2004h>                     delta_t=strain.delta_t,
[?2004l[?2004h>                     f_lower=20.0
[?2004l[?2004h>                 )
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Resize template to match data
[?2004l[?2004h>                 hp.resize(len(strain))
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Perform matched filtering
[?2004l[?2004h>                 snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=20.0)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Get peak SNR
[?2004l[?2004h>                 peak_snr = abs(snr).numpy().max()
[?2004l[?2004h>                 
[?2004l[?2004h>                 if peak_snr > best_snr:
[?2004l[?2004h>                     best_snr = peak_snr
[?2004l[?2004h>                     best_params = (m1, m2)
[?2004l[?2004h>                     
[?2004l[?2004h>                 print(f"  m1={m1}, m2={m2}: SNR={peak_snr:.2f}", end='\r')
[?2004l[?2004h>                 
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 # Some parameter combinations may fail
[?2004l[?2004h>                 pass
[?2004l[?2004h>     
[?2004l[?2004h>     if best_params:
[?2004l[?2004h>         total_mass = best_params[0] + best_params[1]
[?2004l[?2004h>         print(f"\n  Best: m1={best_params[0]}, m2={best_params[1]}, SNR={best_snr:.2f}, M_total={total_mass}")
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'approximant': approx,
[?2004l[?2004h>             'snr': best_snr,
[?2004l[?2004h>             'total_mass': total_mass
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> print("\nWriting results to /root/detection_results.csv")
