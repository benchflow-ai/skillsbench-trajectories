[107.406154, "o", "cat > detect_gw.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.406188, "o", "import pycbc\r\n\u001b[?2004l\rsults:\")\r\nfor r in results:\r\n    print(f\""]
[107.406209, "o", "  {r['approximant']}: SNR={r['snr']:.2f}, M_total={r['total_mass']}\")\r\nEOF\r\n\u001b[?2004h> "]
[107.406274, "o", "from pycbc.frame import read_frame\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.406285, "o", "> "]
[107.406345, "o", "from pycbc.filter import highpass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.40642, "o", "from pycbc.filter import matched_filter\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.40643, "o", "> "]
[107.406491, "o", "from pycbc.waveform import get_td_waveform\r\n\u001b[?2004l\r"]
[107.406499, "o", "\u001b[?2004h> "]
[107.406622, "o", "from pycbc.psd import interpolate, inverse_spectrum_truncation, welch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.406651, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[107.40666, "o", "\u001b[?2004h> "]
[107.406686, "o", "import csv\r\n\u001b[?2004l\r"]
[107.406695, "o", "\u001b[?2004h> "]
[107.406714, "o", "\r\n\u001b[?2004l\r"]
[107.406736, "o", "\u001b[?2004h> "]
[107.406752, "o", "# Read the data\r\n\u001b[?2004l\r"]
[107.406775, "o", "\u001b[?2004h> "]
[107.406799, "o", "print(\"Reading data...\")\r\n\u001b[?2004l\r"]
[107.406828, "o", "\u001b[?2004h> "]
[107.406909, "o", "strain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\r\n\u001b[?2004l\r"]
[107.406917, "o", "\u001b[?2004h> "]
[107.40703, "o", "print(f\"Data loaded: {len(strain)} samples at {strain.sample_rate} Hz\")\r\n\u001b[?2004l\r"]
[107.407056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.407064, "o", "> "]
[107.407131, "o", "# Condition the data - highpass filter only\r\n\u001b[?2004l\r"]
[107.407139, "o", "\u001b[?2004h> "]
[107.407195, "o", "print(\"Conditioning data...\")\r\n\u001b[?2004l\r"]
[107.407203, "o", "\u001b[?2004h"]
[107.407229, "o", "> "]
[107.407266, "o", "strain = highpass(strain, 15.0)\r\n\u001b[?2004l\r"]
[107.407275, "o", "\u001b[?2004h> "]
[107.407402, "o", "print(f\"Conditioned data: {len(strain)} samples at {strain.sample_rate} Hz\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.40741, "o", "> \r\n\u001b[?2004l\r"]
[107.407441, "o", "\u001b[?2004h> "]
[107.407478, "o", "# Calculate PSD for whitening\r\n\u001b[?2004l\r"]
[107.407501, "o", "\u001b[?2004h> "]
[107.407537, "o", "print(\"Calculating PSD...\")\r\n\u001b[?2004l\r"]
[107.407568, "o", "\u001b[?2004h> "]
[107.407621, "o", "psd = welch(strain, seg_len=4, seg_stride=2)\r\n\u001b[?2004l\r"]
[107.407639, "o", "\u001b[?2004h> "]
[107.407695, "o", "psd = interpolate(psd, strain.delta_f)\r\n\u001b[?2004l\r"]
[107.407703, "o", "\u001b[?2004h> "]
[107.407851, "o", "psd = inverse_spectrum_truncation(psd, int(4 * strain.sample_rate), low_frequency_cutoff=15.0)\r\n\u001b[?2004l\r"]
[107.407859, "o", "\u001b[?2004h"]
[107.407866, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.407894, "o", "> "]
[107.407924, "o", "# Define approximants to test\r\n\u001b[?2004l\r"]
[107.407932, "o", "\u001b[?2004h> "]
[107.408025, "o", "approximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\r\n\u001b[?2004l\r"]
[107.408064, "o", "\u001b[?2004h> "]
[107.408113, "o", "mass_range = range(10, 41)  # 10 to 40 inclusive\r\n\u001b[?2004l\r"]
[107.408121, "o", "\u001b[?2004h> "]
[107.40815, "o", "\r\n\u001b[?2004l\r"]
[107.408175, "o", "\u001b[?2004h> "]
[107.408194, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.408209, "o", "\u001b[?2004h> "]
[107.40825, "o", "for approx in approximants:\r\n\u001b[?2004l\r"]
[107.408274, "o", "\u001b[?2004h> "]
[107.408332, "o", "    print(f\"\\nTesting approximant: {approx}\")\r\n\u001b[?2004l\r"]
[107.40834, "o", "\u001b[?2004h> "]
[107.408376, "o", "    best_snr = 0\r\n\u001b[?2004l\r"]
[107.4084, "o", "\u001b[?2004h> "]
[107.408424, "o", "    best_params = None\r\n\u001b[?2004l\r"]
[107.408432, "o", "\u001b[?2004h> "]
[107.408461, "o", "    count = 0\r\n\u001b[?2004l\r"]
[107.408469, "o", "\u001b[?2004h> "]
[107.408494, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.408519, "o", "> "]
[107.408541, "o", "    for m1 in mass_range:\r\n\u001b[?2004l\r"]
[107.408549, "o", "\u001b[?2004h> "]
[107.408598, "o", "        for m2 in mass_range:\r\n\u001b[?2004l\r"]
[107.408606, "o", "\u001b[?2004h> "]
[107.408705, "o", "            if m2 > m1:  # Skip symmetric cases for efficiency\r\n\u001b[?2004l\r"]
[107.408713, "o", "\u001b[?2004h> "]
[107.40876, "o", "                continue\r\n\u001b[?2004l\r"]
[107.408769, "o", "\u001b[?2004h> "]
[107.408796, "o", "            \r\n\u001b[?2004l\r"]
[107.40882, "o", "\u001b[?2004h> "]
[107.408843, "o", "            count += 1\r\n\u001b[?2004l\r"]
[107.408851, "o", "\u001b[?2004h> "]
[107.408885, "o", "            try:\r\n\u001b[?2004l\r"]
[107.408893, "o", "\u001b[?2004h> "]
[107.408967, "o", "                # Generate template\r\n\u001b[?2004l\r"]
[107.408978, "o", "\u001b[?2004h> "]
[107.409045, "o", "                hp, hc = get_td_waveform(\r\n\u001b[?2004l\r"]
[107.409071, "o", "\u001b[?2004h> "]
[107.40912, "o", "                    approximant=approx,\r\n\u001b[?2004l\r"]
[107.409128, "o", "\u001b[?2004h> "]
[107.409183, "o", "                    mass1=m1,\r\n\u001b[?2004l\r"]
[107.409193, "o", "\u001b[?2004h> "]
[107.409248, "o", "                    mass2=m2,\r\n\u001b[?2004l\r"]
[107.409256, "o", "\u001b[?2004h> "]
[107.409324, "o", "                    delta_t=strain.delta_t,\r\n\u001b[?2004l\r"]
[107.409332, "o", "\u001b[?2004h> "]
[107.409388, "o", "                    f_lower=20.0\r\n\u001b[?2004l\r"]
[107.409396, "o", "\u001b[?2004h> "]
[107.409431, "o", "                )\r\n\u001b[?2004l\r"]
[107.409439, "o", "\u001b[?2004h> "]
[107.409472, "o", "                \r\n\u001b[?2004l\r"]
[107.409482, "o", "\u001b[?2004h> "]
[107.409558, "o", "                # Resize template to match data\r\n\u001b[?2004l\r"]
[107.409566, "o", "\u001b[?2004h> "]
[107.409631, "o", "                hp.resize(len(strain))\r\n\u001b[?2004l\r"]
[107.409639, "o", "\u001b[?2004h> "]
[107.409672, "o", "                \r\n\u001b[?2004l\r"]
[107.409709, "o", "\u001b[?2004h> "]
[107.409754, "o", "                # Perform matched filtering\r\n\u001b[?2004l\r"]
[107.409762, "o", "\u001b[?2004h> "]
[107.409897, "o", "                snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=20.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.409917, "o", "> "]
[107.409944, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.409993, "o", "                # Get peak SNR\r\n\u001b[?2004l\r"]
[107.410001, "o", "\u001b[?2004h> "]
[107.410084, "o", "                peak_snr = abs(snr).numpy().max()\r\n\u001b[?2004l\r"]
[107.410091, "o", "\u001b[?2004h> "]
[107.410123, "o", "                \r\n\u001b[?2004l\r"]
[107.410131, "o", "\u001b[?2004h> "]
[107.410198, "o", "                if peak_snr > best_snr:\r\n\u001b[?2004l\r"]
[107.410218, "o", "\u001b[?2004h> "]
[107.410271, "o", "                    best_snr = peak_snr\r\n\u001b[?2004l\r"]
[107.41028, "o", "\u001b[?2004h> "]
[107.410347, "o", "                    best_params = (m1, m2)\r\n\u001b[?2004l\r"]
[107.410354, "o", "\u001b[?2004h> "]
[107.41039, "o", "                \r\n\u001b[?2004l\r"]
[107.410421, "o", "\u001b[?2004h> "]
[107.410459, "o", "                if count % 10 == 0:\r\n\u001b[?2004l\r"]
[107.410477, "o", "\u001b[?2004h> "]
[107.41062, "o", "                    print(f\"  Tested {count} templates, current best SNR: {best_snr:.2f}\", end='\\r')\r\n\u001b[?2004l\r"]
[107.410639, "o", "\u001b[?2004h> "]
[107.410662, "o", "                \r\n\u001b[?2004l\r"]
[107.41067, "o", "\u001b[?2004h> "]
[107.410729, "o", "            except Exception as e:\r\n\u001b[?2004l\r"]
[107.410737, "o", "\u001b[?2004h> "]
[107.410824, "o", "                # Some parameter combinations may fail\r\n\u001b[?2004l\r"]
[107.410843, "o", "\u001b[?2004h> "]
[107.410872, "o", "                pass\r\n\u001b[?2004l\r"]
[107.410881, "o", "\u001b[?2004h> "]
[107.410889, "o", "    "]
[107.410905, "o", "\r\n\u001b[?2004l\r"]
[107.410935, "o", "\u001b[?2004h> "]
[107.410951, "o", "    if best_params:\r\n\u001b[?2004l\r"]
[107.410973, "o", "\u001b[?2004h> "]
[107.411036, "o", "        total_mass = best_params[0] + best_params[1]\r\n\u001b[?2004l\r"]
[107.411044, "o", "\u001b[?2004h> "]
[107.411214, "o", "        print(f\"\\n  Best: m1={best_params[0]}, m2={best_params[1]}, SNR={best_snr:.2f}, M_total={total_mass}\")\r\n\u001b[?2004l\r"]
[107.411246, "o", "\u001b[?2004h> "]
[107.411268, "o", "        results.append({\r\n\u001b[?2004l\r"]
[107.411276, "o", "\u001b[?2004h> "]
[107.411335, "o", "            'approximant': approx,\r\n\u001b[?2004l\r"]
[107.411343, "o", "\u001b[?2004h> "]
[107.411395, "o", "            'snr': best_snr,\r\n\u001b[?2004l\r"]
[107.411402, "o", "\u001b[?2004h> "]
[107.411464, "o", "            'total_mass': total_mass\r\n\u001b[?2004l\r"]
[107.411496, "o", "\u001b[?2004h> "]
[107.411515, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.411538, "o", "\u001b[?2004h> "]
[107.411562, "o", "# Write results to CSV\r\n\u001b[?2004l\r"]
[107.411585, "o", "\u001b[?2004h> "]
[107.411662, "o", "print(\"\\nWriting results to /root/detection_results.csv\")\r\n\u001b[?2004l\r"]
[107.41167, "o", "\u001b[?2004h> "]
[107.411771, "o", "with open('/root/detection_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[107.411796, "o", "\u001b[?2004h> "]
[107.411902, "o", "    writer = csv.DictWriter(f, fieldnames=['approximant', 'snr', 'total_mass'])\r\n\u001b[?2004l\r"]
[107.411921, "o", "\u001b[?2004h> "]
[107.411956, "o", "    writer.writeheader()\r\n\u001b[?2004l\r"]
[107.41198, "o", "\u001b[?2004h> "]
[107.412016, "o", "    writer.writerows(results)\r\n\u001b[?2004l\r"]
[107.412024, "o", "\u001b[?2004h> "]
[107.412042, "o", "\r\n\u001b[?2004l\r"]
[107.412071, "o", "\u001b[?2004h> "]
[107.412096, "o", "print(\"\\nDetection complete!\")\r\n\u001b[?2004l\r"]
[107.412103, "o", "\u001b[?2004h> "]
[107.412142, "o", "print(\"\\nResults:\")\r\n\u001b[?2004l\r"]
[107.41216, "o", "\u001b[?2004h> "]
[107.412189, "o", "for r in results:\r\n\u001b[?2004l\r"]
[107.412214, "o", "\u001b[?2004h> "]
[107.412327, "o", "    print(f\"  {r['approximant']}: SNR={r['snr']:.2f}, M_total={r['total_mass']}\")\r\n\u001b[?2004l\r"]
[107.412335, "o", "\u001b[?2004h> "]
[107.412343, "o", "EOF\r\n\u001b[?2004l\r"]
[107.413543, "o", "\u001b[?2004hroot@32b10353d659:~# "]
[107.589004, "i", "python3 detect_gw.py\n"]
