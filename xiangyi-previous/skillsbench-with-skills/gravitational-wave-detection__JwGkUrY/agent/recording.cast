[29.473361, "i", "cat > detect_gw.py << 'EOF'\nimport pycbc\nfrom pycbc.frame import read_frame\nfrom pycbc.filter import highpass, lowpass_fir, matched_filter\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nimport numpy as np\nimport csv\n\n# Read the data\nprint(\"Reading data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nprint(f\"Data loaded: {len(strain)} samples at {strain.sample_rate} Hz\")\n\n# Condition the data\nprint(\"Conditioning data...\")\n# Highpass filter to remove low frequency noise\nstrain = highpass(strain, 15.0)\n# Resample to 2048 Hz for efficiency\nstrain = strain.resample(2048)\nprint(f\"Conditioned data: {len(strain)} samples at {strain.sample_rate} Hz\")\n\n# Calculate PSD for whitening\nprint(\"Calculating PSD...\")\nfrom pycbc.psd import welch\npsd = welch(strain, seg_len=4, seg_stride=2)\npsd = interpolate(psd, strain.delta_f)\npsd = inverse_spectrum_truncation(psd, int(4 * strain.sample_rate), low_frequency_cutoff=15.0)\n\n# Define approximants to"]
[29.473409, "i", " test\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nmass_range = range(10, 41)  # 10 to 40 inclusive\n\nresults = []\n\nfor approx in approximants:\n    print(f\"\\nTesting approximant: {approx}\")\n    best_snr = 0\n    best_params = None\n    \n    for m1 in mass_range:\n        for m2 in mass_range:\n            if m2 > m1:  # Skip symmetric cases for efficiency\n                continue\n            \n            try:\n                # Generate template\n                hp, hc = get_td_waveform(\n                    approximant=approx,\n                    mass1=m1,\n                    mass2=m2,\n                    delta_t=strain.delta_t,\n                    f_lower=20.0\n                )\n                \n                # Resize template to match data\n                hp.resize(len(strain))\n                \n                # Perform matched filtering\n                snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=20.0)\n                \n                # Get peak SNR\n                peak_snr = abs(s"]
[29.473418, "i", "nr).numpy().max()\n                \n                if peak_snr > best_snr:\n                    best_snr = peak_snr\n                    best_params = (m1, m2)\n                    \n                print(f\"  m1={m1}, m2={m2}: SNR={peak_snr:.2f}\", end='\\r')\n                \n            except Exception as e:\n                # Some parameter combinations may fail\n                pass\n    \n    if best_params:\n        total_mass = best_params[0] + best_params[1]\n        print(f\"\\n  Best: m1={best_params[0]}, m2={best_params[1]}, SNR={best_snr:.2f}, M_total={total_mass}\")\n        results.append({\n            'approximant': approx,\n            'snr': best_snr,\n            'total_mass': total_mass\n        })\n\n# Write results to CSV\nprint(\"\\nWriting results to /root/detection_results.csv\")\nwith open('/root/detection_results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['approximant', 'snr', 'total_mass'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(\"\\nDetection complete!\")\npri"]
[29.473443, "i", "nt(\"\\nResults:\")\nfor r in results:\n    print(f\"  {r['approximant']}: SNR={r['snr']:.2f}, M_total={r['total_mass']}\")\nEOF\n"]
