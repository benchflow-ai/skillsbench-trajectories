[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             config: Dictionary with nested structure from vehicle_params.yaml
[?2004l[?2004h>         """
[?2004l[?2004h>         self.config = config
[?2004l[?2004h>         
[?2004l[?2004h>         # Extract settings
[?2004l[?2004h>         self.set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>         self.time_headway = config['acc_settings']['time_headway']
[?2004l[?2004h>         self.min_distance = config['acc_settings']['min_distance']
[?2004l[?2004h>         self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']
[?2004l[?2004h>         self.max_accel = config['vehicle']['max_acceleration']
[?2004l[?2004h>         self.max_decel = config['vehicle']['max_deceleration']
[?2004l[?2004h>         
[?2004l[?2004h>         # Initialize PID controllers
[?2004l[?2004h>         pid_speed_config = config['pid_speed']
[?2004l[?2004h>         pid_distance_config = config['pid_distance']
[?2004l[?2004h>         
[?2004l[?2004h>         self.pid_speed = PIDController(
[?2004l[?2004h>             pid_speed_config['kp'],
[?2004l[?2004h>             pid_speed_config['ki'],
[?2004l[?2004h>             pid_speed_config['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>         
[?2004l[?2004h>         self.pid_distance = PIDController(
[?2004l[?2004h>             pid_distance_config['kp'],
[?2004l[?2004h>             pid_distance_config['ki'],
[?2004l[?2004h>             pid_distance_config['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def compute(self, ego_speed, lead_speed, distance, dt):
[?2004l[?2004h>         """Compute ACC acceleration command.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Current ego vehicle speed (m/s)
[?2004l[?2004h>             lead_speed: Lead vehicle speed (m/s) or None if no lead vehicle
[?2004l[?2004h>             distance: Distance to lead vehicle (m) or None if no lead vehicle
[?2004l[?2004h>             dt: Time step (seconds)
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             tuple: (acceleration_cmd, mode, distance_error)
[?2004l[?2004h>                 - acceleration_cmd: Acceleration command (m/s^2)
[?2004l[?2004h>                 - mode: Operating mode ('cruise', 'follow', or 'emergency')
[?2004l[?2004h>                 - distance_error: Distance error (m) or None in cruise mode
[?2004l[?2004h>         """
[?2004l[?2004h>         # Determine mode and compute acceleration
[?2004l[?2004h>         if lead_speed is None or distance is None:
[?2004l[?2004h>             # Cruise mode: no lead vehicle detected
[?2004l[?2004h>             mode = 'cruise'
[?2004l[?2004h>             distance_error = None
[?2004l[?2004h>             
[?2004l[?2004h>             # Speed control: maintain set speed
[?2004l[?2004h>             speed_error = self.set_speed - ego_speed
[?2004l[?2004h>             accel_cmd = self.pid_speed.compute(speed_error, dt)
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Lead vehicle detected: determine follow or emergency mode
[?2004l[?2004h>             # Calculate Time-To-Collision (TTC)
[?2004l[?2004h>             speed_diff = ego_speed - lead_speed
[?2004l[?2004h>             if speed_diff > 0.01:  # Only calculate TTC if closing in
[?2004l[?2004h>                 ttc = distance / speed_diff
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ttc = float('inf')
[?2004l[?2004h>             
[?2004l[?2004h>             # Check for emergency condition
[?2004l[?2004h>             if ttc < self.emergency_ttc_threshold and speed_diff > 0:
[?2004l[?2004h>                 mode = 'emergency'
[?2004l[?2004h>                 # Emergency braking
[?2004l[?2004h>                 accel_cmd = self.max_decel
[?2004l[?2004h>                 distance_error = distance - self.min_distance
[?2004l[?2004h>             else:
[?2004l[?2004h>                 mode = 'follow'
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Calculate desired distance based on time headway
[?2004l[?2004h>                 desired_distance = self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>                 distance_error = desired_distance - distance
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Dual control: speed and distance
[?2004l[?2004h>                 # Speed control to match lead vehicle
[?2004l[?2004h>                 speed_error = lead_speed - ego_speed
[?2004l[?2004h>                 speed_accel = self.pid_speed.compute(speed_error, dt)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Distance control to maintain safe gap
[?2004l[?2004h>                 distance_accel = self.pid_distance.compute(distance_error, dt)
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Combine: prioritize distance safety over speed matching
[?2004l[?2004h>                 # Weight distance control more heavily
[?2004l[?2004h>                 accel_cmd = 0.4 * speed_accel + 0.6 * distance_accel
[?2004l[?2004h>         
[?2004l[?2004h>         # Saturate acceleration to vehicle limits
[?2004l[?2004h>         accel_cmd = max(self.max_decel, min(self.max_accel, accel_cmd))
[?2004l[?2004h>         
[?2004l[?2004h>         return accel_cmd, mode, distance_error
