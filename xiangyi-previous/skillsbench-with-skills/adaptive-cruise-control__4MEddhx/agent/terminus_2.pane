[?2004l[?2004hroot@70733c13328d:~# cat > simulation.py << 'EOF'
[?2004l[?2004h> import csv
[?2004l[?2004h> import yaml
[?2004l[?2004h> from acc_system import AdaptiveCruiseControl
[?2004l[?2004h> 
[?2004l[?2004h> def load_config(vehicle_params_file, tuning_results_file):
[?2004l[?2004h>     """Load configuration from YAML files."""
[?2004l[?2004h>     with open(vehicle_params_file, 'r') as f:
[?2004l[?2004h>         vehicle_config = yaml.safe_load(f)
[?2004l[?2004h>     
[?2004l[?2004h>     with open(tuning_results_file, 'r') as f:
[?2004l[?2004h>         tuning_config = yaml.safe_load(f)
[?2004l[?2004h>     
[?2004l[?2004h>     # Merge tuning results into vehicle config
[?2004l[?2004h>     vehicle_config['pid_speed'] = tuning_config['pid_speed']
[?2004l[?2004h>     vehicle_config['pid_distance'] = tuning_config['pid_distance']
[?2004l[?2004h>     
[?2004l[?2004h>     return vehicle_config
[?2004l[?2004h> 
[?2004l[?2004h> def load_sensor_data(sensor_file):
[?2004l[?2004h>     """Load sensor data from CSV."""
[?2004l[?2004h>     data = []
[?2004l[?2004h>     with open(sensor_file, 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         for row in reader:
[?2004l[?2004h>             time_val = float(row['time'])
[?2004l[?2004h>             ego_speed = float(row['ego_speed'])
[?2004l[?2004h>             lead_speed = float(row['lead_speed']) if row['lead_speed'].strip() else None
[?2004l[?2004h>             distance = float(row['distance']) if row['distance'].strip() else None
[?2004l[?2004h>             data.append({
[?2004l[?2004h>                 'time': time_val,
[?2004l[?2004h>                 'ego_speed': ego_speed,
[?2004l[?2004h>                 'lead_speed': lead_speed,
[?2004l[?2004h>                 'distance': distance
[?2004l[?2004h>             })
[?2004l[?2004h>     return data
[?2004l[?2004h> 
[?2004l[?2004h> def simulate_acc(config, sensor_data):
[?2004l[?2004h>     """Run ACC simulation."""
[?2004l[?2004h>     acc = AdaptiveCruiseControl(config)
[?2004l[?2004h>     dt = config['simulation']['dt']
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     current_speed = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     for i, sensor_row in enumerate(sensor_data):
[?2004l[?2004h>         time_val = sensor_row['time']
[?2004l[?2004h>         lead_speed = sensor_row['lead_speed']
[?2004l[?2004h>         distance = sensor_row['distance']
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute ACC command
[?2004l[?2004h>         accel_cmd, mode, distance_error = acc.compute(
[?2004l[?2004h>             current_speed, lead_speed, distance, dt
[?2004l[?2004h>         )
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate TTC if lead vehicle present
[?2004l[?2004h>         if lead_speed is not None and distance is not None:
[?2004l[?2004h>             speed_diff = current_speed - lead_speed
[?2004l[?2004h>             if speed_diff > 0.01:
[?2004l[?2004h>                 ttc = distance / speed_diff
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ttc = None
[?2004l[?2004h>         else:
[?2004l[?2004h>             ttc = None
[?2004l[?2004h>         
[?2004l[?2004h>         # Update speed based on acceleration
[?2004l[?2004h>         current_speed += accel_cmd * dt
[?2004l[?2004h>         
[?2004l[?2004h>         # Clamp speed to non-negative
[?2004l[?2004h>         current_speed = max(0.0, current_speed)
[?2004l[?2004h>         
[?2004l[?2004h>         # Store result
[?2004l[?2004h>         result = {
[?2004l[?2004h>             'time': time_val,
[?2004l[?2004h>             'ego_speed': current_speed,
[?2004l[?2004h>             'acceleration_cmd': accel_cmd,
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': distance_error,
[?2004l[?2004h>             'distance': distance,
[?2004l[?2004h>             'ttc': ttc
[?2004l[?2004h>         }
[?2004l[?2004h>         results.append(result)
[?2004l[?2004h>     
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> def save_results(results, output_file):
[?2004l[?2004h>     """Save simulation results to CSV."""
[?2004l[?2004h>     with open(output_file, 'w', newline='') as f:
[?2004l[?2004h>         fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 
[?2004l[?2004h>                       'distance_error', 'distance', 'ttc']
[?2004l[?2004h>         writer = csv.DictWriter(f, fieldnames=fieldnames)
[?2004l[?2004h>         writer.writeheader()
[?2004l[?2004h>         
[?2004l[?2004h>         for result in results:
[?2004l[?2004h>             row = {
[?2004l[?2004h>                 'time': f"{result['time']:.1f}",
[?2004l[?2004h>                 'ego_speed': f"{result['ego_speed']:.1f}",
[?2004l[?2004h>                 'acceleration_cmd': f"{result['acceleration_cmd']:.1f}",
[?2004l[?2004h>                 'mode': result['mode'],
[?2004l[?2004h>                 'distance_error': f"{result['distance_error']:.2f}" if result['distance_error'] is not None else '',
[?2004l[?2004h>                 'distance': f"{result['distance']:.2f}" if result['distance'] is not None else '',
[?2004l[?2004h>                 'ttc': f"{result['ttc']:.2f}" if result['ttc'] is not None else ''
[?2004l[?2004h>             }
[?2004l[?2004h>             writer.writerow(row)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     # Load configuration
[?2004l[?2004h>     config = load_config('vehicle_params.yaml', 'tuning_results.yaml')
[?2004l[?2004h>     
[?2004l[?2004h>     # Load sensor data
[?2004l[?2004h>     sensor_data = load_sensor_data('sensor_data.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Run simulation
[?2004l[?2004h>     print(f"Running ACC simulation for {len(sensor_data)} timesteps...")
[?2004l[?2004h>     results = simulate_acc(config, sensor_data)
[?2004l[?2004h>     
