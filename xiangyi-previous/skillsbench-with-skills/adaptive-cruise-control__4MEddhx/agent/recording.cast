[59.490932, "o", "> "]
[59.491005, "o", "emergency_count = mode_values.count('emergency')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.491042, "o", "\u001b[?2004h> "]
[59.491202, "o", "print(f\"Rise time (to 90% set speed): {rise_time:.1f}s\" if rise_time else \"Rise time: Not reached\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.491267, "o", "print(f\"Peak speed: {peak_speed:.2f} m/s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.491355, "o", "print(f\"Speed overshoot: {overshoot:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.491479, "o", "print(f\"Steady-state error (last 10s): {ss_error:.2f} m/s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.491553, "o", "print(f\"\\nMode distribution:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.491618, "o", "print(f\"  Cruise mode: {cruise_count} samples\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.4917, "o", "print(f\"  Follow mode: {follow_count} samples\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.49182, "o", "print(f\"  Emergency mode: {emergency_count} samples\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
