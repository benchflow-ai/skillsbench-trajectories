[59.35713, "o", "70.4,40.1,3.0,follow,31.86,37.84,3.23\r\r\n70.5,40.4,3.0,follow,34.23,35.92,3.24\r\r\n70.6,39.6,-8.0,emergency,25.17,35.17,2.75\r\r\n70.7,39.9,3.0,follow,31.02,38.38,3.44\r\r\n70.8,40.2,3.0,follow,33.48,36.37,3.25\r\r\n70.9,40.5,3.0,follow,33.85,36.45,3.27\r\r\n71.0,40.8,3.0,follow,32.58,38.17,3.40\r\r\n71.1,40.0,-8.0,emergency,27.32,37.32,2.85\r\r\n71.2,39.2,-8.0,emergency,27.20,37.20,2.95\r\r\n71.3,39.5,3.0,follow,29.72,39.08,4.19\r\r\n71.4,39.8,3.0,follow,33.26,35.99,3.46\r\r\n"]
[59.357188, "o", "71.5,40.1,3.0,follow,31.99,37.71,3.24\r\r\n71.6,40.4,3.0,follow,33.41,36.74,3.71\r\r\n71.7,40.7,3.0,follow,33.62,36.98,3.24\r\r\n71.8,41.0,3.0,follow,32.69,38.36,3.57\r\r\n"]
[59.357436, "o", "\u001b[?2004hroot@70733c13328d:~# "]
[59.488707, "i", "python3 << 'PYEOF'\nimport csv\n\n# Analyze simulation results\nwith open('simulation_results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n\n# Find key metrics\nspeed_values = [float(r['ego_speed']) for r in rows]\nmode_values = [r['mode'] for r in rows]\n\n# Rise time (time to reach 90% of set speed 30 m/s)\nset_speed = 30.0\ntarget_speed = 0.9 * set_speed\nrise_time = None\nfor i, speed in enumerate(speed_values):\n    if speed >= target_speed:\n        rise_time = float(rows[i]['time'])\n        break\n\n# Peak speed and overshoot\npeak_speed = max(speed_values)\novershoot = ((peak_speed - set_speed) / set_speed * 100) if peak_speed > set_speed else 0\n\n# Steady-state error (last 10 seconds)\nss_speeds = speed_values[-100:]  # Last 100 samples = 10 seconds\nss_error = abs(sum(ss_speeds)/len(ss_speeds) - set_speed)\n\n# Count modes\ncruise_count = mode_values.count('cruise')\nfollow_count = mode_values.count('follow')\nemergency_count = mode_values.count('emergency')\n\nprint(f\"Rise time (to 90% set speed): {rise_time:.1f}s\" if rise_time else \"Rise time: Not reached\")\nprint(f\"Peak speed: {peak_speed:.2f} m/s\")\nprint(f\"Speed overshoot: {overshoot:.2f}%\")\nprint(f\"Steady-state error (last 10s): {ss_error:.2f} m/s\")\nprint(f\"\\nMode distribution:\")\nprint(f\"  Cruise mode: {cruise_count} samples\")\nprint(f\"  Follow mode: {follow_count} samples\")\nprint(f\"  Emergency mode: {emergency_count} samples\")\nprint(f\"\\nTotal samples: {len(rows)}\")\nPYEOF\n"]
[59.488941, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[59.488989, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[59.489032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
