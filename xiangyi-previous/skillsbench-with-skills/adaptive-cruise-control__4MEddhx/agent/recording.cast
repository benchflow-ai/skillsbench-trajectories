[98.924708, "i", "python3 << 'PYEOF'\nimport csv\n\nwith open('sensor_data.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n\nprint(\"Sample of sensor_data.csv:\")\nprint(\"\\nEarly cruise phase (no lead vehicle):\")\nfor i in range(0, 30, 5):\n    r = rows[i]\n    print(f\"  t={r['time']}: ego_speed={r['ego_speed']}, lead_speed={r['lead_speed']}, distance={r['distance']}\")\n\nprint(\"\\nTransition to follow phase (~70s):\")\nfor i in range(700, 730, 5):\n    r = rows[i]\n    print(f\"  t={r['time']}: ego_speed={r['ego_speed']}, lead_speed={r['lead_speed']}, distance={r['distance']}\")\n\nprint(\"\\nBack to cruise (~150s):\")\nfor i in range(1470, 1501, 5):\n    r = rows[i]\n    print(f\"  t={r['time']}: ego_speed={r['ego_speed']}, lead_speed={r['lead_speed']}, distance={r['distance']}\")\nPYEOF\n"]
