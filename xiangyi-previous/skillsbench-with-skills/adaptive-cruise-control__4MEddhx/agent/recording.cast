[59.4895, "o", "speed_values = [float(r['ego_speed']) for r in rows]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.489542, "o", "mode_values = [r['mode'] for r in rows]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.489588, "o", "\u001b[?2004h> "]
[59.489747, "o", "# Rise time (time to reach 90% of set speed 30 m/s)\r\n\u001b[?2004l\r\u001b[?2004h> set_speed = 30.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.489849, "o", "target_speed = 0.9 * set_speed\r\n\u001b[?2004l\r\u001b[?2004h> rise_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.489927, "o", "for i, speed in enumerate(speed_values):\r\n\u001b[?2004l\r\u001b[?2004h>     if speed >= target_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.489972, "o", "> "]
[59.49007, "o", "        rise_time = float(rows[i]['time'])\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.490147, "o", "\u001b[?2004h> "]
[59.49021, "o", "# Peak speed and overshoot\r\n\u001b[?2004l\r\u001b[?2004h> peak_speed = max(speed_values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.490366, "o", "overshoot = ((peak_speed - set_speed) / set_speed * 100) if peak_speed > set_speed else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.490404, "o", "\u001b[?2004h> "]
[59.490484, "o", "# Steady-state error (last 10 seconds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
