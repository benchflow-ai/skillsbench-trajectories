[30.469123, "o", "\u001b[?2004h> "]
[30.469177, "o", "            dt: Time step (seconds)\r\n\u001b[?2004l\r"]
[30.469202, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[30.469263, "o", "\u001b[?2004h> "]
[30.46933, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.469395, "o", "            tuple: (acceleration_cmd, mode, distance_error)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.469514, "o", "                - acceleration_cmd: Acceleration command (m/s^2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.469654, "o", "                - mode: Operating mode ('cruise', 'follow', or 'emergency')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.469772, "o", "                - distance_error: Distance error (m) or None in cruise mode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.46982, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.469863, "o", "> "]
[30.469912, "o", "        # Determine mode and compute acceleration\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.469967, "o", "> "]
[30.470018, "o", "        if lead_speed is None or distance is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470071, "o", "            # Cruise mode: no lead vehicle detected\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470129, "o", "            mode = 'cruise'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470191, "o", "            distance_error = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470239, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.47031, "o", "            # Speed control: maintain set speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470403, "o", "            speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470513, "o", "            accel_cmd = self.pid_speed.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470561, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470671, "o", "            # Lead vehicle detected: determine follow or emergency mode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470753, "o", "            # Calculate Time-To-Collision (TTC)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470838, "o", "            speed_diff = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.470961, "o", "            if speed_diff > 0.01:  # Only calculate TTC if closing in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471035, "o", "                ttc = distance / speed_diff\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.471088, "o", "> "]
[30.471138, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471188, "o", "                ttc = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[30.471233, "o", "\u001b[?2004h> "]
[30.471281, "o", "            # Check for emergency condition\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471384, "o", "            if ttc < self.emergency_ttc_threshold and speed_diff > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471444, "o", "                mode = 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471511, "o", "                # Emergency braking\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471591, "o", "                accel_cmd = self.max_decel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471703, "o", "                distance_error = distance - self.min_distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.47175, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.4718, "o", "                mode = 'follow'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.471841, "o", "                \r\n\u001b[?2004l\r"]
[30.471897, "o", "\u001b[?2004h> "]
[30.471954, "o", "                # Calculate desired distance based on time headway\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472102, "o", "                desired_distance = self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472205, "o", "                distance_error = desired_distance - distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472254, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472324, "o", "                # Dual control: speed and distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472424, "o", "                # Speed control to match lead vehicle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472509, "o", "                speed_error = lead_speed - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472639, "o", "                speed_accel = self.pid_speed.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472692, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.472738, "o", "> "]
[30.472783, "o", "                # Distance control to maintain safe gap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472904, "o", "                distance_accel = self.pid_distance.compute(distance_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.472948, "o", "                \r\n\u001b[?2004l\r"]
[30.472998, "o", "\u001b[?2004h> "]
[30.473106, "o", "                # Combine: prioritize distance safety over speed matching\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.473156, "o", "> "]
[30.47324, "o", "                # Weight distance control more heavily\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.473292, "o", "> "]
[30.473445, "o", "                accel_cmd = 0.4 * speed_accel + 0.6 * distance_accel\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[30.473502, "o", "\u001b[?2004h> "]
[30.473557, "o", "        # Saturate acceleration to vehicle limits\r\n\u001b[?2004l\r"]
[30.473617, "o", "\u001b[?2004h> "]
[30.473739, "o", "        accel_cmd = max(self.max_decel, min(self.max_accel, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.473788, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.473839, "o", "        return accel_cmd, mode, distance_error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.473889, "o", "EOF\r\n\u001b[?2004l\r"]
[30.47507, "o", "\u001b[?2004hroot@70733c13328d:~# "]
[35.068708, "i", "cat > tuning_results.yaml << 'EOF'\n# Tuned PID parameters for ACC system\n# Optimized to meet performance targets:\n# - Speed rise time < 10s\n# - Speed overshoot < 5%\n# - Speed steady-state error < 0.5 m/s\n# - Distance steady-state error < 2m\n\npid_speed:\n  kp: 0.8\n  ki: 0.15\n  kd: 0.5\n\npid_distance:\n  kp: 0.5\n  ki: 0.05\n  kd: 0.3\nEOF\n"]
[35.068931, "o", "cat > tuning_results.yaml << 'EOF'\r\n"]
[35.069015, "o", "\u001b[?2004l\r"]
[35.069074, "o", "\u001b[?2004h> # Tuned PID parameters for ACC system\r\n\u001b[?2004l\r"]
[35.069138, "o", "\u001b[?2004h> "]
[35.069193, "o", "# Optimized to meet performance targets:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.06927, "o", "# - Speed rise time < 10s\r\n\u001b[?2004l\r"]
[35.069336, "o", "\u001b[?2004h> "]
[35.069408, "o", "# - Speed overshoot < 5%\r\n\u001b[?2004l\r"]
[35.069469, "o", "\u001b[?2004h> # - Speed steady-state error < 0.5 m/s\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.069517, "o", "> "]
[35.06957, "o", "# - Distance steady-state error < 2m\r\n\u001b[?2004l\r"]
[35.069626, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pid_speed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.069676, "o", "  kp: 0.8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.069719, "o", "  ki: 0.15\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.069778, "o", "  kd: 0.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.069845, "o", "pid_distance:\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.069909, "o", ">   kp: 0.5\r\n\u001b[?2004l\r\u001b[?2004h>   ki: 0.05\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.069972, "o", ">   kd: 0.3\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[35.071205, "o", "\u001b[?2004hroot@70733c13328d:~# "]
[44.313422, "i", "cat > simulation.py << 'EOF'\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\ndef load_config(vehicle_params_file, tuning_results_file):\n    \"\"\"Load configuration from YAML files.\"\"\"\n    with open(vehicle_params_file, 'r') as f:\n        vehicle_config = yaml.safe_load(f)\n    \n    with open(tuning_results_file, 'r') as f:\n        tuning_config = yaml.safe_load(f)\n    \n    # Merge tuning results into vehicle config\n    vehicle_config['pid_speed'] = tuning_config['pid_speed']\n    vehicle_config['pid_distance'] = tuning_config['pid_distance']\n    \n    return vehicle_config\n\ndef load_sensor_data(sensor_file):\n    \"\"\"Load sensor data from CSV.\"\"\"\n    data = []\n    with open(sensor_file, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            time_val = float(row['time'])\n            ego_speed = float(row['ego_speed'])\n            lead_speed = float(row['lead_speed']) if row['lead_speed'].strip() else None\n            distance = float(row['distance']) if row['distance'].strip() else None\n            data.append({\n                'time': time_val,\n                'ego_speed': ego_speed,\n                'lead_speed': lead_speed,\n                'distance': distance\n            })\n    return data\n\ndef simulate_acc(config, sensor_data):\n    \"\"\"Run ACC simulation.\"\"\"\n    acc = AdaptiveCruiseControl(config)\n    dt = config['simulation']['dt']\n    results = []\n    \n    current_speed = 0.0\n    \n    for i, sensor_row in enumerate(sensor_data):\n        time_val = sensor_row['time']\n        lead_speed = sensor_row['lead_speed']\n        distance = sensor_row['distance']\n        \n        # Compute ACC command\n        accel_cmd, mode, distance_error = acc.compute(\n            current_speed, lead_speed, distance, dt\n        )\n        \n        # Calculate TTC if lead vehicle present\n        if lead_speed is not None and distance is not None:\n            speed_diff = current_speed - lead_speed\n            if speed_diff > 0.01:\n                ttc = distance / speed_diff\n            else:\n                ttc = None\n        else:\n            ttc = None\n        \n        # Update speed based on acceleration\n        current_speed += accel_cmd * dt\n        \n        # Clamp speed to non-negative\n        current_speed = max(0.0, current_speed)\n        \n        # Store result\n        result = {\n            'time': time_val,\n            'ego_speed': current_speed,\n            'acceleration_cmd': accel_cmd,\n            'mode': mode,\n            'distance_error': distance_error,\n            'distance': distance,\n            'ttc': ttc\n        }\n        results.append(result)\n    \n    return results\n\ndef save_results(results, output_file):\n    \"\"\"Save simulation results to CSV.\"\"\"\n    with open(output_file, 'w', newline='') as f:\n        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \n                      'distance_error', 'distance', 'ttc']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        \n        for result in results:\n            row = {\n                'time': f\"{result['time']:.1f}\",\n                'ego_speed': f\"{result['ego_speed']:.1f}\",\n                'acceleration_cmd': f\"{result['acceleration_cmd']:.1f}\",\n                'mode': result['mode'],\n                'distance_error': f\"{result['distance_error']:.2f}\" if result['distance_error'] is not None else '',\n                'distance': f\"{result['distance']:.2f}\" if result['distance'] is not None else '',\n                'ttc': f\"{result['ttc']:.2f}\" if result['ttc'] is not None else ''\n            }\n            writer.writerow(row)\n\nif __name__ == '__main__':\n    # Load configuration\n    config = load_config('vehicle_params.yaml', 'tuning_results.yaml')\n    \n    # Load sensor data\n    sensor_data = load_sensor_data('sensor_data.csv')\n    \n    # Run simulation\n    print(f\"Running ACC simulation for {len(sensor_data)} timesteps...\")\n    results = simulate_acc(config, sensor_data)\n    \n    # Save results\n    save_results(results, 'simulation_results.csv')\n    print(f\"Simulation comple"]
[44.313473, "i", "te. Results saved to simulation_results.csv\")\n    print(f\"Total rows: {len(results)}\")\nEOF\n"]
[44.3137, "o", "cat > simulation.py << 'EOF'\r\n\u001b[?2004l\r"]
[44.313768, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[44.313807, "o", "\u001b[?2004h> import yaml\r\n\u001b[?2004l\r"]
[44.313887, "o", "\u001b[?2004h> "]
[44.313964, "o", "from acc_system import AdaptiveCruiseControl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.314068, "o", "def load_config(vehicle_params_file, tuning_results_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.314139, "o", "    \"\"\"Load configuration from YAML files.\"\"\"\r\n\u001b[?2004l\r"]
[44.314164, "o", "\u001b[?2004h> "]
[44.314243, "o", "    with open(vehicle_params_file, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.314304, "o", "        vehicle_config = yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314332, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314356, "o", "> "]
[44.314449, "o", "    with open(tuning_results_file, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.314498, "o", "        tuning_config = yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314558, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314586, "o", "> "]
[44.314661, "o", "    # Merge tuning results into vehicle config\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.314717, "o", "    vehicle_config['pid_speed'] = tuning_config['pid_speed']\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314744, "o", "> "]
[44.314833, "o", "    vehicle_config['pid_distance'] = tuning_config['pid_distance']\r\n\u001b[?2004l\r"]
[44.314891, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.314921, "o", ">     return vehicle_config\r\n\u001b[?2004l\r"]
[44.314949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315049, "o", "def load_sensor_data(sensor_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315101, "o", "    \"\"\"Load sensor data from CSV.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.31513, "o", "    data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315197, "o", "    with open(sensor_file, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315259, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[44.315288, "o", "\u001b[?2004h> "]
[44.315367, "o", "        for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315396, "o", "            time_val = float(row['time'])\r\n\u001b[?2004l\r"]
[44.315426, "o", "\u001b[?2004h> "]
[44.315523, "o", "            ego_speed = float(row['ego_speed'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.315632, "o", "            lead_speed = float(row['lead_speed']) if row['lead_speed'].strip() else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.315662, "o", "> "]
[44.315772, "o", "            distance = float(row['distance']) if row['distance'].strip() else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.315834, "o", "> "]
[44.315868, "o", "            data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.31595, "o", "                'time': time_val,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316005, "o", "                'ego_speed': ego_speed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316065, "o", "                'lead_speed': lead_speed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316132, "o", "                'distance': distance\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.316159, "o", ">             })\r\n\u001b[?2004l\r"]
[44.316187, "o", "\u001b[?2004h> "]
[44.316218, "o", "    return data\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[44.31636, "o", "\u001b[?2004l\r\u001b[?2004h> def simulate_acc(config, sensor_data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316428, "o", "    \"\"\"Run ACC simulation.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316479, "o", "    acc = AdaptiveCruiseControl(config)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316532, "o", "    dt = config['simulation']['dt']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316561, "o", "    results = []\r\n\u001b[?2004l\r"]
[44.31659, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[44.316619, "o", "\u001b[?2004h> "]
[44.316648, "o", "    current_speed = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.316676, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.316706, "o", "> "]
[44.316772, "o", "    for i, sensor_row in enumerate(sensor_data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.316976, "o", "        time_val = sensor_row['time']\r\n\u001b[?2004l\r\u001b[?2004h>         lead_speed = sensor_row['lead_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317002, "o", "        distance = sensor_row['distance']\r\n\u001b[?2004l\r"]
[44.317076, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317106, "o", "        # Compute ACC command\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.31713, "o", "> "]
[44.317218, "o", "        accel_cmd, mode, distance_error = acc.compute(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317308, "o", "            current_speed, lead_speed, distance, dt\r\n\u001b[?2004l\r"]
[44.31736, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317426, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317466, "o", "        # Calculate TTC if lead vehicle present\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317572, "o", "        if lead_speed is not None and distance is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.31766, "o", "            speed_diff = current_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.317687, "o", "> "]
[44.317758, "o", "            if speed_diff > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317813, "o", "                ttc = distance / speed_diff\r\n\u001b[?2004l\r"]
[44.317844, "o", "\u001b[?2004h> "]
[44.317921, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.317975, "o", "                ttc = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318005, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318073, "o", "            ttc = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.318104, "o", "> "]
[44.318169, "o", "        # Update speed based on acceleration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318234, "o", "        current_speed += accel_cmd * dt\r\n\u001b[?2004l\r"]
[44.318262, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[44.31829, "o", "\u001b[?2004h> "]
[44.318371, "o", "        # Clamp speed to non-negative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318433, "o", "        current_speed = max(0.0, current_speed)\r\n\u001b[?2004l\r"]
[44.318482, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318545, "o", "        # Store result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318573, "o", "        result = {\r\n\u001b[?2004l\r"]
[44.318633, "o", "\u001b[?2004h> "]
[44.318666, "o", "            'time': time_val,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.31875, "o", "            'ego_speed': current_speed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318802, "o", "            'acceleration_cmd': accel_cmd,\r\n\u001b[?2004l\r"]
[44.318831, "o", "\u001b[?2004h> "]
[44.318885, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.318948, "o", "            'distance_error': distance_error,\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.318979, "o", "> "]
[44.319037, "o", "            'distance': distance,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.319091, "o", "            'ttc': ttc\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[44.319145, "o", "\u001b[?2004h> "]
[44.319173, "o", "        results.append(result)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.319227, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.319256, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.319284, "o", "> "]
[44.319335, "o", "def save_results(results, output_file):\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.319365, "o", "> "]
[44.31944, "o", "    \"\"\"Save simulation results to CSV.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.31956, "o", "    with open(output_file, 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.319662, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.319722, "o", "> "]
[44.319773, "o", "                      'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.319859, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)\r\n\u001b[?2004l\r"]
[44.319889, "o", "\u001b[?2004h> "]
[44.319975, "o", "        writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.320026, "o", "        for result in results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.320054, "o", "> "]
[44.320131, "o", "            row = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.320195, "o", "                'time': f\"{result['time']:.1f}\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.320266, "o", "                'ego_speed': f\"{result['ego_speed']:.1f}\",\r\n\u001b[?2004l\r"]
[44.320297, "o", "\u001b[?2004h> "]
[44.320393, "o", "                'acceleration_cmd': f\"{result['acceleration_cmd']:.1f}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.320415, "o", "> "]
[44.320567, "o", "                'mode': result['mode'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.320662, "o", "                'distance_error': f\"{result['distance_error']:.2f}\" if result['distance_error'] is not None else '',\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.320722, "o", "> "]
[44.320822, "o", "                'distance': f\"{result['distance']:.2f}\" if result['distance'] is not None else '',\r\n\u001b[?2004l\r"]
[44.320843, "o", "\u001b[?2004h> "]
[44.320977, "o", "                'ttc': f\"{result['ttc']:.2f}\" if result['ttc'] is not None else ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321003, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.321079, "o", ">             writer.writerow(row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[44.321108, "o", "\u001b[?2004h> "]
[44.321188, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     # Load configuration\r\n\u001b[?2004l\r"]
[44.321217, "o", "\u001b[?2004h> "]
[44.321361, "o", "    config = load_config('vehicle_params.yaml', 'tuning_results.yaml')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.321437, "o", "> "]
[44.321469, "o", "    # Load sensor data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321551, "o", "    sensor_data = load_sensor_data('sensor_data.csv')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321606, "o", "    # Run simulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321715, "o", "    print(f\"Running ACC simulation for {len(sensor_data)} timesteps...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.321774, "o", "> "]
[44.32185, "o", "    results = simulate_acc(config, sensor_data)\r\n\u001b[?2004l\r"]
[44.321901, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321974, "o", "    save_results(results, 'simulation_results.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.322004, "o", "> "]
[44.322127, "o", "    print(f\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.322193, "o", "    print(f\"Total rows: {len(results)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.322221, "o", "EOF\r\n\u001b[?2004l\r"]
[44.332844, "o", "\u001b[?2004hroot@70733c13328d:~# "]
[47.411908, "i", "python3 simulation.py\n"]
