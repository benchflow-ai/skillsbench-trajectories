[76.008333, "i", "python3 << 'PYEOF'\nimport csv\n\n# Analyze simulation results\nwith open('simulation_results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n\n# Find key metrics\nspeed_values = [float(r['ego_speed']) for r in rows]\nmode_values = [r['mode'] for r in rows]\ndistance_errors = []\nfor r in rows:\n    if r['distance_error'].strip():\n        distance_errors.append(float(r['distance_error']))\n\n# Rise time (time to reach 90% of set speed 30 m/s)\nset_speed = 30.0\ntarget_speed = 0.9 * set_speed\nrise_time = None\nfor i, speed in enumerate(speed_values):\n    if speed >= target_speed:\n        rise_time = float(rows[i]['time'])\n        break\n\n# Peak speed and overshoot\npeak_speed = max(speed_values)\novershoot = ((peak_speed - set_speed) / set_speed * 100) if peak_speed > set_speed else 0\n\n# Steady-state error (last 10 seconds in cruise mode)\nss_speeds = speed_values[-100:]  # Last 100 samples = 10 seconds\nss_error = abs(sum(ss_speeds)/len(ss_speeds) - set_speed)\n\n# Distance steady-state error\nif distance_errors:\n    ss_distance_error = abs(sum(distance_errors[-50:])/len(distance_errors[-50:]))\nelse:\n    ss_distance_error = 0\n\n# Minimum distance\nmin_distance = float('inf')\nfor r in rows:\n    if r['distance'].strip():\n        min_distance = min(min_distance, float(r['distance']))\n\n# Count modes\ncruise_count = mode_values.count('cruise')\nfollow_count = mode_values.count('follow')\nemergency_count = mode_values.count('emergency')\n\nprint(\"=== ACC SIMULATION PERFORMANCE METRICS ===\")\nprint(f\"\\nSpeed Control:\")\nprint(f\"  Rise time (to 90% set speed): {rise_time:.1f}s (target: <10s)\")\nprint(f\"  Peak speed: {peak_speed:.2f} m/s\")\nprint(f\"  Speed overshoot: {overshoot:.2f}% (target: <5%)\")\nprint(f\"  Steady-state error: {ss_error:.2f} m/s (target: <0.5 m/s)\")\n\nprint(f\"\\nDistance Control:\")\nprint(f\"  Distance steady-state error: {ss_distance_error:.2f} m (target: <2m)\")\nif min_distance != float('inf'):\n    print(f\"  Minimum distance: {min_distance:.2f} m (target: >5m)\")\n\nprint(f\"\\nMode Distribution:\")\nprint(f\"  Cruise mode: {cruise_count} samples ({100*cruise_count/len(rows):.1f}%)\")\nprint(f\"  Follow mode: {follow_count} samples ({100*follow_count/len(rows):.1f}%)\")\nprint(f\"  Emergency mode: {emergency_count} samples ({100*emergency_count/len(rows):.1f}%)\")\n\nprint(f\"\\nSimulation Duration: 150.0 seconds\")\nprint(f\"Total Samples: {len(rows)}\")\nPYEOF\n"]
