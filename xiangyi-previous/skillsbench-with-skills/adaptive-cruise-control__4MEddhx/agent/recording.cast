[21.199909, "o", "    def compute(self, error, dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.199956, "o", "        \"\"\"Compute PID output.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.200011, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         Args:\r\n\u001b[?2004l\r"]
