[59.490667, "o", "ss_error = abs(sum(ss_speeds)/len(ss_speeds) - set_speed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.490718, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Count modes\r\n\u001b[?2004l\r"]
[59.490752, "o", "\u001b[?2004h> "]
[59.49082, "o", "cruise_count = mode_values.count('cruise')\r\n\u001b[?2004l\r\u001b[?2004h> "]
