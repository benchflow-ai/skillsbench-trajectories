[91.864514, "o", "ss_error = abs(sum(ss_speeds)/len(ss_speeds) - set_speed)\r\n\u001b[?2004l\r"]
[91.864569, "o", "\u001b[?2004h> "]
[91.86463, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.864688, "o", "if distance_errors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.864825, "o", "    ss_distance_error = abs(sum(distance_errors[-50:])/len(distance_errors[-50:]))\r\n\u001b[?2004l\r"]
[91.864886, "o", "\u001b[?2004h> "]
[91.864914, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.864942, "o", "> "]
[91.865037, "o", "    ss_distance_error = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.865066, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.865128, "o", "min_distance = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.865187, "o", "for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.86528, "o", "    if r['distance'].strip():\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.865342, "o", "> "]
[91.86544, "o", "        min_distance = min(min_distance, float(r['distance']))\r\n\u001b[?2004l\r"]
[91.865491, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.865547, "o", "\u001b[?2004h> "]
