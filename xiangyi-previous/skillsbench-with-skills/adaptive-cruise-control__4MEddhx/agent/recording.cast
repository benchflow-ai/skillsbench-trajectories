[82.511873, "i", "cat > tuning_results.yaml << 'EOF'\n# Tuned PID parameters for ACC system\n# Optimized to meet performance targets:\n# - Speed rise time < 10s\n# - Speed overshoot < 5%\n# - Speed steady-state error < 0.5 m/s\n# - Distance steady-state error < 2m\n\npid_speed:\n  kp: 0.15\n  ki: 0.03\n  kd: 0.1\n\npid_distance:\n  kp: 0.1\n  ki: 0.01\n  kd: 0.05\nEOF\n"]
[82.512133, "o", "cat > tuning_results.yaml << 'EOF'\r\n\u001b[?2004l\r"]
[82.512213, "o", "\u001b[?2004h> "]
[82.512277, "o", "# Tuned PID parameters for ACC system\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512311, "o", "# Optimized to meet performance targets:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.51243, "o", "# - Speed rise time < 10s\r\n\u001b[?2004l\r\u001b[?2004h> # - Speed overshoot < 5%\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512527, "o", "# - Speed steady-state error < 0.5 m/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512586, "o", "# - Distance steady-state error < 2m\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[82.512654, "o", "\u001b[?2004h> pid_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.512709, "o", ">   kp: 0.15\r\n\u001b[?2004l\r\u001b[?2004h>   ki: 0.03\r\n\u001b[?2004l\r"]
[82.512778, "o", "\u001b[?2004h>   kd: 0.1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[82.512828, "o", "> pid_distance:\r\n\u001b[?2004l\r\u001b[?2004h>   kp: 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512873, "o", "  ki: 0.01\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512896, "o", "  kd: 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.512932, "o", "EOF\r\n\u001b[?2004l\r"]
