[70.296346, "i", "cat > extract_formulas.py << 'EOF'\nimport pdfplumber\nimport re\n\n# Open the PDF\npdf_path = 'latex_paper.pdf'\nformulas = []\n\nwith pdfplumber.open(pdf_path) as pdf:\n    for page_num, page in enumerate(pdf.pages, 1):\n        text = page.extract_text()\n        print(f\"\\n=== Page {page_num} ===\")\n        print(text)\n        print(\"\\n\" + \"=\"*50)\n\nEOF\n"]
[70.296632, "o", "cat > extract_formulas.py << 'EOF'"]
