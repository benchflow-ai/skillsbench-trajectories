[275.434356, "i", "python3 << 'PYEOF'\nimport re\n\n# Read the formulas\nwith open('/root/latex_formula_extraction.md', 'r') as f:\n    content = f.read()\n\nformulas = re.findall(r'\\$\\$(.+?)\\$\\$', content, re.DOTALL)\n\nprint(f\"Found {len(formulas)} formulas:\")\nfor i, formula in enumerate(formulas, 1):\n    print(f\"\\n{i}. {formula.strip()}\")\n    \n    # Check for balanced brackets\n    brackets = {'(': ')', '[': ']', '{': '}'}\n    stack = []\n    for char in formula:\n        if char in brackets.keys():\n            stack.append(char)\n        elif char in brackets.values():\n            if not stack:\n                print(f\"   WARNING: Unmatched closing bracket: {char}\")\n            else:\n                last = stack.pop()\n                if brackets[last] != char:\n                    print(f\"   WARNING: Mismatched brackets: {last} and {char}\")\n    \n    if stack:\n        print(f\"   WARNING: Unclosed brackets: {stack}\")\n    else:\n        print(\"   ✓ Brackets balanced\")\n\nPYEOF\n"]
[275.434794, "o", "python3 << 'PYEOF'"]
[275.43496, "o", "\r\n"]
