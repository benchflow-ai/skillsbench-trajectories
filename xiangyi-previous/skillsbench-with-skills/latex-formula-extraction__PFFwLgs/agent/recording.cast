[102.603122, "i", "cat > extract_display_formulas.py << 'EOF'\nimport pdfplumber\nimport re\n\n# Manual extraction based on the PDF content\nformulas = []\n\nwith pdfplumber.open('latex_paper.pdf') as pdf:\n    # Page 2 - Equation 1\n    page2_text = pdf.pages[1].extract_text()\n    \n    # Page 3 - Equations 3 and 4\n    page3_text = pdf.pages[2].extract_text()\n    \n    # Print to analyze structure\n    print(\"Page 2 around equation (1):\")\n    lines = page2_text.split('\\n')\n    for i, line in enumerate(lines):\n        if '(1)' in line or 'd2x' in line or 'dt2' in line:\n            start = max(0, i-3)\n            end = min(len(lines), i+4)\n            for j in range(start, end):\n                print(f\"{j}: {lines[j]}\")\n            break\n    \n    print(\"\\n\" + \"=\"*60)\n    print(\"Page 2 around equation (2):\")\n    for i, line in enumerate(lines):\n        if '(2)' in line and 'ρ' in line:\n            start = max(0, i-3)\n            end = min(len(lines), i+4)\n            for j in range(start, end):\n                print(f\"{j}: {lines[j]}\")\n            break\n    \n    print(\"\\n\" + \"=\"*60)\n    print(\"Page 3 around equation (3):\")\n    lines3 = page3_text.split('\\n')\n    for i, line in enumerate(lines3):\n        if '(3)' in line and 'exp' in line:\n            start = max(0, i-3)\n            end = min(len(lines3), i+4)\n            for j in range(start, end):\n                print(f\"{j}: {lines3[j]}\")\n            break\n    \n    print(\"\\n\" + \"=\"*60)\n    print(\"Page 3 around equation (4):\")\n    for i, line in enumerate(lines3):\n        if '(4)' in line and 'P' in line and 'cos' in line:\n            start = max(0, i-3)\n            end = min(len(lines3), i+4)\n            for j in range(start, end):\n                print(f\"{j}: {lines3[j]}\")\n            break\n\nEOF\npython3 extract_display_formulas.py\n"]
