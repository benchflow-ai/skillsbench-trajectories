[86.113742, "o", "        # Update ego speed for next timestep (simple integration)\r\n\u001b[?2004l\r"]
[86.113764, "o", "\u001b[?2004h> "]
[86.113848, "o", "        ego_speed = ego_speed + accel_cmd * dt\r\n\u001b[?2004l\r"]
[86.113868, "o", "\u001b[?2004h> "]
[86.1139, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.11392, "o", "> "]
[86.114008, "o", "        # Clamp speed to non-negative\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.11403, "o", "> "]
[86.11408, "o", "        ego_speed = max(0.0, ego_speed)\r\n\u001b[?2004l\r"]
[86.114099, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[86.114117, "o", "\u001b[?2004h> "]
[86.114171, "o", "    # Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.114193, "o", "> "]
[86.114286, "o", "    with open('simulation_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.114304, "o", "> "]
[86.114404, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \r\n\u001b[?2004l\r"]
[86.114423, "o", "\u001b[?2004h> "]
[86.114506, "o", "                      'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r"]
[86.114525, "o", "\u001b[?2004h> "]
[86.114616, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)\r\n\u001b[?2004l\r"]
[86.114637, "o", "\u001b[?2004h> "]
[86.114691, "o", "        writer.writeheader()\r\n\u001b[?2004l\r"]
[86.114714, "o", "\u001b[?2004h> "]
[86.114786, "o", "        writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.114803, "o", ">     \r\n\u001b[?2004l\r"]
[86.114824, "o", "\u001b[?2004h> "]
[86.114947, "o", "    print(f\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.114971, "o", "> "]
[86.115035, "o", "    print(f\"Total timesteps: {len(results)}\")\r\n\u001b[?2004l\r"]
[86.115054, "o", "\u001b[?2004h> "]
[86.115073, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115167, "o", "    # Calculate and print performance metrics\r\n\u001b[?2004l\r"]
[86.115186, "o", "\u001b[?2004h> "]
[86.115262, "o", "    analyze_results(results, vehicle_config)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.11528, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.1153, "o", "> \r\n\u001b[?2004l\r"]
[86.11532, "o", "\u001b[?2004h> "]
[86.115375, "o", "def analyze_results(results, config):\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.115394, "o", "> "]
[86.115489, "o", "    \"\"\"Analyze simulation results and print metrics.\"\"\"\r\n\u001b[?2004l\r"]
[86.115511, "o", "\u001b[?2004h> "]
[86.1156, "o", "    set_speed = config['acc_settings']['set_speed']\r\n\u001b[?2004l\r"]
[86.115629, "o", "\u001b[?2004h> "]
[86.115705, "o", "    min_gap = config['acc_settings']['min_distance']\r\n\u001b[?2004l\r"]
[86.115724, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[86.115745, "o", "\u001b[?2004h> "]
[86.115832, "o", "    # Find rise time (time to reach 90% of set speed)\r\n\u001b[?2004l\r"]
[86.115854, "o", "\u001b[?2004h> "]
[86.115884, "o", "    rise_time = None\r\n\u001b[?2004l\r"]
[86.115905, "o", "\u001b[?2004h> "]
[86.115938, "o", "    for r in results:\r\n\u001b[?2004l\r"]
[86.115959, "o", "\u001b[?2004h> "]
[86.116023, "o", "        if r['ego_speed'] >= 0.9 * set_speed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.116044, "o", "> "]
[86.116103, "o", "            rise_time = r['time']\r\n\u001b[?2004l\r"]
[86.116124, "o", "\u001b[?2004h> "]
[86.116154, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.116175, "o", ">     \r\n"]
[86.116194, "o", "\u001b[?2004l\r\u001b[?2004h"]
[86.116215, "o", "> "]
[86.116292, "o", "    # Find max speed (for overshoot calculation)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.116388, "o", "    max_speed = max(r['ego_speed'] for r in results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.116405, "o", "> "]
[86.116593, "o", "    overshoot = ((max_speed - set_speed) / set_speed) * 100 if max_speed > set_speed else 0\r\n\u001b[?2004l\r"]
[86.116615, "o", "\u001b[?2004h>     \r\n"]
[86.116635, "o", "\u001b[?2004l\r\u001b[?2004h"]
[86.116654, "o", "> "]
[86.116801, "o", "    # Calculate steady-state speed error (last 10 seconds of cruise before lead appears)\r\n\u001b[?2004l\r"]
[86.116821, "o", "\u001b[?2004h> "]
[86.116995, "o", "    cruise_speeds = [r['ego_speed'] for r in results if r['mode'] == 'cruise' and r['time'] > 20 and r['time'] < 30]\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.117017, "o", "> "]
[86.117052, "o", "    if cruise_speeds:\r\n\u001b[?2004l\r"]
[86.11707, "o", "\u001b[?2004h> "]
[86.117189, "o", "        ss_speed_error = abs(set_speed - sum(cruise_speeds) / len(cruise_speeds))\r\n\u001b[?2004l\r"]
[86.117208, "o", "\u001b[?2004h> "]
[86.11723, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.117285, "o", "        ss_speed_error = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.117302, "o", ">     \r\n\u001b[?2004l\r"]
[86.117322, "o", "\u001b[?2004h> "]
[86.117404, "o", "    # Find minimum distance during follow mode\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.117428, "o", "> "]
[86.117701, "o", "    follow_distances = [float(r['distance']) for r in results if r['distance'] and r['mode'] in ['follow', 'emergency']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.117755, "o", "    min_distance = min(follow_distances) if follow_distances else float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.117777, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.117799, "o", "> "]
[86.117861, "o", "    # Calculate distance steady-state error\r\n\u001b[?2004l\r"]
[86.117881, "o", "\u001b[?2004h> "]
[86.118051, "o", "    dist_errors = [float(r['distance_error']) for r in results if r['distance_error']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.118073, "o", "> "]
[86.118095, "o", "    if dist_errors:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.118116, "o", "> "]
[86.118207, "o", "        # Use last portion of follow mode for steady-state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.118364, "o", "        last_errors = dist_errors[-100:] if len(dist_errors) > 100 else dist_errors\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.118385, "o", "> "]
[86.118502, "o", "        ss_dist_error = abs(sum(last_errors) / len(last_errors))\r\n\u001b[?2004l\r"]
[86.118523, "o", "\u001b[?2004h> "]
[86.118542, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.1186, "o", "        ss_dist_error = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.118617, "o", ">     \r\n\u001b[?2004l\r"]
[86.11864, "o", "\u001b[?2004h> "]
[86.118711, "o", "    print(f\"\\n=== Performance Metrics ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.11873, "o", "> "]
[86.118874, "o", "    print(f\"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s\" if rise_time else \"Rise time: N/A\")\r\n\u001b[?2004l\r"]
[86.118897, "o", "\u001b[?2004h> "]
[86.118969, "o", "    print(f\"Maximum speed: {max_speed:.2f} m/s\")\r\n\u001b[?2004l\r"]
[86.118993, "o", "\u001b[?2004h> "]
[86.119067, "o", "    print(f\"Speed overshoot: {overshoot:.2f}%\")\r\n\u001b[?2004l\r"]
[86.119088, "o", "\u001b[?2004h> "]
[86.11921, "o", "    print(f\"Steady-state speed error: {ss_speed_error:.3f} m/s\")\r\n\u001b[?2004l\r"]
[86.119229, "o", "\u001b[?2004h> "]
[86.119318, "o", "    print(f\"Minimum following distance: {min_distance:.2f} m\")\r\n\u001b[?2004l\r"]
[86.119339, "o", "\u001b[?2004h> "]
[86.119451, "o", "    print(f\"Steady-state distance error: {ss_dist_error:.2f} m\")\r\n\u001b[?2004l\r"]
[86.119483, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[86.119501, "o", "\u001b[?2004h> "]
[86.119561, "o", "    # Check against targets\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.119584, "o", "> "]
[86.119634, "o", "    print(f\"\\n=== Target Compliance ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.119655, "o", "> "]
[86.119782, "o", "    print(f\"Rise time < 10s: {'PASS' if rise_time and rise_time < 10 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[86.119802, "o", "\u001b[?2004h> "]
[86.119949, "o", "    print(f\"Overshoot < 5%: {'PASS' if overshoot < 5 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[86.119968, "o", "\u001b[?2004h> "]
[86.120121, "o", "    print(f\"Speed SS error < 0.5 m/s: {'PASS' if ss_speed_error < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r"]
[86.120148, "o", "\u001b[?2004h> "]
[86.120258, "o", "    print(f\"Distance SS error < 2m: {'PASS' if ss_dist_error < 2 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.120278, "o", "> "]
[86.120387, "o", "    print(f\"Min distance > 5m: {'PASS' if min_distance > 5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.120406, "o", "> \r\n\u001b[?2004l\r"]
[86.120426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.120446, "o", "\u001b[?2004h> "]
[86.120491, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.120531, "o", "> "]
[86.12057, "o", "    run_simulation()\r\n\u001b[?2004l\r"]
[86.122901, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[86.128348, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[86.577376, "i", "python3 simulation.py\n"]
[86.577576, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[86.623784, "o", "Simulation complete. Results saved to simulation_results.csv\r\nTotal timesteps: 1501\r\n\r\n=== Performance Metrics ===\r\nRise time (to 90% of 30.0 m/s): 9.0s\r\nMaximum speed: 53.75 m/s\r\nSpeed overshoot: 79.16%\r\nSteady-state speed error: 4.373 m/s\r\nMinimum following distance: 1.95 m\r\nSteady-state distance error: 12.64 m\r\n\r\n=== Target Compliance ===\r\nRise time < 10s: PASS\r\nOvershoot < 5%: FAIL\r\nSpeed SS error < 0.5 m/s: FAIL\r\nDistance SS error < 2m: FAIL\r\nMin distance > 5m: FAIL\r\n"]
[86.630025, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[98.374742, "i", "head -50 simulation_results.csv\n"]
[98.374987, "o", "head -50 simulation_results.csv\r\n\u001b[?2004l\r"]
[98.375785, "o", "time,ego_speed,acceleration_cmd,mode,distance_error,distance,ttc\r\r\n0.0,0.0,3.0,cruise,,,\r\r\n0.1,0.30000000000000004,3.0,cruise,,,\r\r\n0.2,0.6000000000000001,3.0,cruise,,,\r\r\n0.3,0.9000000000000001,3.0,cruise,,,\r\r\n0.4,1.2000000000000002,3.0,cruise,,,\r\r\n0.5,1.5000000000000002,3.0,cruise,,,\r\r\n0.6,1.8000000000000003,3.0,cruise,,,\r\r\n0.7,2.1000000000000005,3.0,cruise,,,\r\r\n0.8,2.4000000000000004,3.0,cruise,,,\r\r\n0.9,2.7,3.0,cruise,,,\r\r\n1.0,3.0,3.0,cruise,,,\r\r\n1.1,3.3,3.0,cruise,,,\r\r\n1.2,3.5999999999999996,3.0,cruise,,,\r\r\n1.3,3.8999999999999995,3.0,cruise,,,\r\r\n1.4,4.199999999999999,3.0,cruise,,,\r\r\n1.5,4.499999999999999,3.0,cruise,,,\r\r\n1.6,4.799999999999999,3.0,cruise,,,\r\r\n1.7,5.099999999999999,3.0,cruise,,,\r\r\n1.8,5.399999999999999,3.0,cruise,,,\r\r\n1.9,5.699999999999998,3.0,cruise,,,\r\r\n2.0,5.999999999999998,3.0,cruise,,,\r\r\n2.1,6.299999999999998,3.0,cruise,,,\r\r\n2.2,6.599999999999998,3.0,cruise,,,\r\r\n2.3,6.899999999999998,3.0,cruise,,,\r\r\n2.4,7.1999999999999975,3.0,cruise,,,\r\r\n2.5,7.499999999999997,3.0,cruise,,,\r\r\n2.6,7.799999999999997,3.0,cruise,,,\r\r\n2.7,8.099999999999998,3.0,cruise,,,\r\r\n2.8,8.399999999999999,3.0,cruise,,,\r\r\n2.9,8.7,3.0,cruise,,,\r\r\n3.0,9.0,3.0,cruise,,,\r\r\n3.1,9.3,3.0,cruise,,,\r\r\n3.2,9.600000000000001,3.0,cruise,,,\r\r\n3.3,9.900000000000002,3.0,cruise,,,\r\r\n3.4,10.200000000000003,3.0,cruise,,,\r\r\n3.5,10.500000000000004,3.0,cruise,,,\r\r\n3.6,10.800000000000004,3.0,cruise,,,\r\r\n3.7,11.100000000000005,3.0,cruise,,,\r\r\n3.8,11.400000000000006,3.0,cruise,,,\r\r\n3.9,11.700000000000006,3.0,cruise,,,\r\r\n4.0,12.000000000000007,3.0,cruise,,,\r\r\n4.1,12.300000000000008,3.0,cruise,,,\r\r\n4.2,12.600000000000009,3.0,cruise,,,\r\r\n4.3,12.90000000000001,3.0,cruise,,,\r\r\n4.4,13.20000000000001,3.0,cruise,,,\r\r\n4.5,13.50000000000001,3.0,cruise,,,\r\r\n4.6,13.800000000000011,3.0,cruise,,,\r\r\n4.7,14.100000000000012,3.0,cruise,,,\r\r\n4.8,14.400000000000013,3.0,cruise,,,\r\r\n"]
