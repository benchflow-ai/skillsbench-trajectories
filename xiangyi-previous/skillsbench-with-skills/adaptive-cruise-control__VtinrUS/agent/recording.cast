[216.869691, "o", "32.8,25.5809289231,-0.7605788601,follow,-4.93,43.44,42.13\r\r\n32.9,25.504871037,-0.7671144701,follow,-4.91,43.34,59.79\r\r\n33.0,25.42815959,-0.8113309083,follow,-4.86,43.28,49.28\r\r\n33.1,25.3470264992,-0.3950902266,follow,-4.82,43.20,\r\r\n33.2,25.3075174765,-0.5283841219,follow,-4.65,43.31,136.39\r\r\n33.3,25.2546790644,-0.7301450744,follow,-4.60,43.28,41.43\r\r\n33.4,25.1816645569,-0.4817351496,follow,-4.59,43.18,\r\r\n33.5,25.133491042,-0.7223427036,follow,-4.47,43.23,41.04\r\r\n33.6,25.0612567716,-0.5518484544,follow,-4.46,43.13,\r\r\n33.7,25.0060719262,-0.8445134279,follow,-4.36,43.15,29.23\r\r\n33.8,24.9216205834,-0.8350008106,follow,-4.37,43.01,46.67\r\r\n33.9,24.8381205023,-0.5626719171,follow,-4.33,42.93,\r\r\n34.0,24.7818533106,-0.3443496972,follow,-4.21,42.96,\r\r\n34.1,24.7474183409,-0.3265340514,follow,-4.08,43.04,\r\r\n34.2,24.7147649357,-0.3489000569,follow,-3.99,43.08,\r\r\n34.3,24.67987493,-0.3780282777,follow,-3.91,43.11,\r\r\n34.4,24.6420721023,-0.5795831847,follow,-3.84,43.12,57.34\r\r\n34.5,24.5841137838,-0.5217742698,follow,-3.83,43.05,346.86\r\r\n34.6,24.5319363568,-0.4496014193,follow,-3.75,43.04,\r\r\n34.7,24.4869762149,-0.1475483987,follow,-3.67,43.06,\r\r\n34.8,24.472221375,-0.1314674546,follow,-3.52,43.19,\r\r\n34.9,24.4590746295,-0.4637462861,follow,-3.42,43.27,55.54\r\r\n35.0,24.4127000009,-0.2355800946,follow,-3.42,43.20,\r\r\n"]
