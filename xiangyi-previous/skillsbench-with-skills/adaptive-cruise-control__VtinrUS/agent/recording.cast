[53.659935, "i", "cat > pid_controller.py << 'EOF'\n\"\"\"PID Controller implementation for ACC system.\"\"\"\n\nclass PIDController:\n    \"\"\"A PID controller with anti-windup and derivative filtering.\"\"\"\n    \n    def __init__(self, kp, ki, kd):\n        \"\"\"\n        Initialize PID controller with gains.\n        \n        Args:\n            kp: Proportional gain\n            ki: Integral gain\n            kd: Derivative gain\n        \"\"\"\n        self.kp = kp\n        self.ki = ki\n        self.kd = kd\n        self.reset()\n    \n    def reset(self):\n        \"\"\"Reset the controller state.\"\"\"\n        self.integral = 0.0\n        self.prev_error = None\n        self.prev_derivative = 0.0\n    \n    def compute(self, error, dt):\n        \"\"\"\n        Compute PID control output.\n        \n        Args:\n            error: Current error (setpoint - measured)\n            dt: Time step in seconds\n        \n        Returns:\n            float: Control output\n        \"\"\"\n        if dt <= 0:\n            return 0.0\n        \n        # Proportional term\n        p_term = self.kp * error\n        \n        # Integral term with anti-windup\n        self.integral += error * dt\n        # Clamp integral to prevent windup\n        max_integral = 50.0 / (self.ki + 1e-10)\n        self.integral = max(-max_integral, min(max_integral, self.integral))\n        i_term = self.ki * self.integral\n        \n        # Derivative term with filtering\n        if self.prev_error is None:\n            derivative = 0.0\n        else:\n            derivative = (error - self.prev_error) / dt\n        \n        # Low-pass filter on derivative (alpha = 0.2)\n        alpha = 0.2\n        filtered_derivative = alpha * derivative + (1 - alpha) * self.prev_derivative\n        self.prev_derivative = filtered_derivative\n        d_term = self.kd * filtered_derivative\n        \n        self.prev_error = error\n        \n        return p_term + i_term + d_term\nEOF\n"]
[53.660168, "o", "cat > pid_controller.py << 'EOF'\r\n\u001b[?2004l\r"]
[53.660243, "o", "\u001b[?2004h> "]
