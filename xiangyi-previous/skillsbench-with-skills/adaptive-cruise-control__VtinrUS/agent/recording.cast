[53.662263, "o", "            dt: Time step in seconds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662291, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         Returns:\r\n\u001b[?2004l\r"]
[53.66237, "o", "\u001b[?2004h> "]
[53.6624, "o", "            float: Control output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662429, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662512, "o", "        if dt <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662538, "o", "            return 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[53.662637, "o", "\u001b[?2004h>         # Proportional term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662691, "o", "        p_term = self.kp * error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[53.662722, "o", "\u001b[?2004h> "]
[53.662818, "o", "        # Integral term with anti-windup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.662872, "o", "        self.integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.6629, "o", "> "]
[53.662969, "o", "        # Clamp integral to prevent windup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663038, "o", "        max_integral = 50.0 / (self.ki + 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663186, "o", "        self.integral = max(-max_integral, min(max_integral, self.integral))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663245, "o", "        i_term = self.ki * self.integral\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663298, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.66336, "o", "        # Derivative term with filtering\r\n\u001b[?2004l\r"]
[53.66339, "o", "\u001b[?2004h> "]
[53.663453, "o", "        if self.prev_error is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.6635, "o", "            derivative = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663547, "o", "        else:\r\n\u001b[?2004l\r"]
[53.663575, "o", "\u001b[?2004h> "]
[53.663654, "o", "            derivative = (error - self.prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663721, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663777, "o", "        # Low-pass filter on derivative (alpha = 0.2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.663804, "o", "> "]
[53.663878, "o", "        alpha = 0.2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.663966, "o", "        filtered_derivative = alpha * derivative + (1 - alpha) * self.prev_derivative\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.663998, "o", "> "]
[53.664078, "o", "        self.prev_derivative = filtered_derivative\r\n\u001b[?2004l\r"]
[53.664107, "o", "\u001b[?2004h> "]
[53.664174, "o", "        d_term = self.kd * filtered_derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.664204, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
