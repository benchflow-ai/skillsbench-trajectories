[134.671812, "o", "\u001b[?2004h> "]
[134.672068, "o", "        speed_pid = config.get('pid_speed', {'kp': 0.5, 'ki': 0.02, 'kd': 0.1})\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.672119, "o", "> "]
[134.672424, "o", "        dist_pid = config.get('pid_distance', {'kp': 0.3, 'ki': 0.01, 'kd': 1.5})\r\n\u001b[?2004l\r\u001b[?2004h"]
