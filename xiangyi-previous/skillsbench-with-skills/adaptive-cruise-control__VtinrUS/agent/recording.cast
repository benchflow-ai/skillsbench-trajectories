[53.665581, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[54.158177, "i", "cat > acc_system.py << 'EOF'\n\"\"\"Adaptive Cruise Control system implementation.\"\"\"\n\nfrom pid_controller import PIDController\n\n\nclass AdaptiveCruiseControl:\n    \"\"\"Adaptive Cruise Control with speed and distance control modes.\"\"\"\n    \n    def __init__(self, config):\n        \"\"\"\n        Initialize ACC system with configuration.\n        \n        Args:\n            config: Nested dict from vehicle_params.yaml\n        \"\"\"\n        # Vehicle parameters\n        self.max_acceleration = config['vehicle']['max_acceleration']\n        self.max_deceleration = config['vehicle']['max_deceleration']\n        \n        # ACC settings\n        self.set_speed = config['acc_settings']['set_speed']\n        self.time_headway = config['acc_settings']['time_headway']\n        self.min_distance = config['acc_settings']['min_distance']\n        self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']\n        \n        # PID controllers - will be set externally after tuning\n        speed_pid = config.get('pid_speed', {'kp': 1.0, 'ki': 0.1, 'kd': 0.05})\n        dist_pid = config.get('pid_distance', {'kp': 0.5, 'ki': 0.05, 'kd': 0.1})\n        \n        self.speed_controller = PIDController(\n            speed_pid['kp'], speed_pid['ki'], speed_pid['kd']\n        )\n        self.distance_controller = PIDController(\n            dist_pid['kp'], dist_pid['ki'], dist_pid['kd']\n        )\n    \n    def set_pid_gains(self, speed_gains, distance_gains):\n        \"\"\"\n        Update PID gains for both controllers.\n        \n        Args:\n            speed_gains: dict with 'kp', 'ki', 'kd' for speed controller\n            distance_gains: dict with 'kp', 'ki', 'kd' for distance controller\n        \"\"\"\n        self.speed_controller = PIDController(\n            speed_gains['kp'], speed_gains['ki'], speed_gains['kd']\n        )\n        self.distance_controller = PIDController(\n            distance_gains['kp'], distance_gains['ki'], distance_gains['kd']\n        )\n    \n    def compute_desired_distance(self, ego_speed):\n        \"\"\"\n        Compute desired following distance based on time headway.\n        \n        Args:\n            ego_speed: Current ego vehicle speed in m/s\n        \n        Returns:\n            float: Desired following distance in meters\n        \"\"\"\n        return self.min_distance + self.time_headway * ego_speed\n    \n    def compute_ttc(self, ego_speed, lead_speed, distance):\n        \"\"\"\n        Compute Time-To-Collision.\n        \n        Args:\n            ego_speed: Ego vehicle speed in m/s\n            lead_speed: Lead vehicle speed in m/s\n            distance: Distance to lead vehicle in meters\n        \n        Returns:\n            float: TTC in seconds, or float('inf') if not approaching\n        \"\"\"\n        relative_speed = ego_speed - lead_speed\n        if relative_speed <= 0 or distance <= 0:\n            return float('inf')\n        return distance / relative_speed\n    \n    def compute(self, ego_speed, lead_speed, distance, dt):\n        \"\"\"\n        Compute ACC control command.\n        \n        Args:\n            ego_speed: Current ego vehicle speed in m/s\n            lead_speed: Lead vehicle speed in m/s (None if no lead vehicle)\n            distance: Distance to lead vehicle in meters (None if no lead vehicle)\n            dt: Time step in seconds\n        \n        Returns:\n            tuple: (acceleration_cmd, mode, distance_error)\n                - acceleration_cmd: Commanded acceleration in m/s^2\n                - mode: 'cruise', 'follow', or 'emergency'\n                - distance_error: Distance error in meters (None in cruise mode)\n        \"\"\"\n        # Cruise mode - no lead vehicle detected\n        if lead_speed is None or distance is None:\n            speed_error = self.set_speed - ego_speed\n            accel_cmd = self.speed_controller.compute(speed_error, dt)\n            # Reset distance controller when in cruise mode\n            self.distance_controller.reset()\n            # Clamp acceleration\n            accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\n            return (accel_cmd, 'cruise', None)\n    "]
[54.158363, "i", "    \n        # Calculate TTC for emergency detection\n        ttc = self.compute_ttc(ego_speed, lead_speed, distance)\n        \n        # Emergency mode - TTC below threshold\n        if ttc < self.emergency_ttc_threshold:\n            # Apply maximum braking\n            accel_cmd = self.max_deceleration\n            desired_dist = self.compute_desired_distance(ego_speed)\n            distance_error = distance - desired_dist\n            return (accel_cmd, 'emergency', distance_error)\n        \n        # Follow mode - maintain safe following distance\n        desired_distance = self.compute_desired_distance(ego_speed)\n        distance_error = distance - desired_distance\n        \n        # Distance-based acceleration command\n        dist_accel = self.distance_controller.compute(distance_error, dt)\n        \n        # Also consider speed matching with lead vehicle\n        # Blend distance control with speed matching\n        speed_error = min(lead_speed, self.set_speed) - ego_speed\n        speed_accel = self.speed_controller.compute(speed_error, dt)\n        \n        # Use distance control primarily, with speed control influence\n        # When far behind (positive error), allow more acceleration\n        # When too close (negative error), prioritize braking\n        if distance_error < 0:\n            # Too close - prioritize distance control (braking)\n            accel_cmd = min(dist_accel, speed_accel)\n        else:\n            # Safe distance or farther - blend controls\n            accel_cmd = 0.6 * dist_accel + 0.4 * speed_accel\n        \n        # Clamp acceleration\n        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\n        \n        return (accel_cmd, 'follow', distance_error)\nEOF\n"]
[54.158581, "o", "cat > acc_system.py << 'EOF'\r\n\u001b[?2004l\r"]
[54.158686, "o", "\u001b[?2004h"]
[54.158734, "o", "> "]
[54.158791, "o", "\"\"\"Adaptive Cruise Control system implementation.\"\"\"\r\n\u001b[?2004l\r"]
[54.158822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[54.158917, "o", "from pid_controller import PIDController\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.158959, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.158986, "o", "\u001b[?2004h> "]
[54.159047, "o", "class AdaptiveCruiseControl:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159245, "o", "    \"\"\"Adaptive Cruise Control with speed and distance control modes.\"\"\"\r\n\u001b[?2004l\r"]
[54.159268, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.159315, "o", "> "]
[54.159369, "o", "    def __init__(self, config):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.159411, "o", ">         \"\"\""]
[54.159465, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159581, "o", "        Initialize ACC system with configuration.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159618, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159684, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159801, "o", "            config: Nested dict from vehicle_params.yaml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159849, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.159913, "o", "        # Vehicle parameters\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.159961, "o", "> "]
[54.160084, "o", "        self.max_acceleration = config['vehicle']['max_acceleration']\r\n\u001b[?2004l\rma\u001b[?2004h> "]
[54.160224, "o", "        self.max_deceleration = config['vehicle']['max_deceleration']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.160285, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16034, "o", "        # ACC settings\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[54.16045, "o", "        self.set_speed = config['acc_settings']['set_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.160629, "o", "        self.time_headway = config['acc_settings']['time_headway']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16081, "o", "        self.min_distance = config['acc_settings']['min_distance']\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.160833, "o", "> "]
[54.161063, "o", "        self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.161115, "o", "        \r\n\u001b[?2004l\r"]
[54.161152, "o", "\u001b[?2004h> "]
[54.161278, "o", "        # PID controllers - will be set externally after tuning\r\n\u001b[?2004l\ro\u001b[?2004h"]
[54.161302, "o", "> "]
[54.161502, "o", "        speed_pid = config.get('pid_speed', {'kp': 1.0, 'ki': 0.1, 'kd': 0.05})\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.161522, "o", "> "]
[54.161727, "o", "        dist_pid = config.get('pid_distance', {'kp': 0.5, 'ki': 0.05, 'kd': 0.1})\r\n\u001b[?2004l\r"]
[54.161783, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.161824, "o", "> "]
[54.161874, "o", "        self.speed_controller = PIDController(\r\n\u001b[?2004l\r"]
[54.161899, "o", "\u001b[?2004h> "]
[54.162015, "o", "            speed_pid['kp'], speed_pid['ki'], speed_pid['kd']\r\n\u001b[?2004l\rr\u001b[?2004h"]
[54.16204, "o", "> "]
[54.162087, "o", "        )\r\n\u001b[?2004l\r \u001b[?2004h> "]
[54.162225, "o", "        self.distance_controller = PIDController(\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.162278, "o", "> "]
[54.162399, "o", "            dist_pid['kp'], dist_pid['ki'], dist_pid['kd']\r\n\u001b[?2004l\r"]
[54.162423, "o", "\u001b[?2004h> "]
[54.162489, "o", "        )\r\n\u001b[?2004l\r(\u001b[?2004h>     \r\n"]
[54.162516, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.162654, "o", "    def set_pid_gains(self, speed_gains, distance_gains):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.162699, "o", "> "]
[54.162751, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16282, "o", "        Update PID gains for both controllers.\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.162861, "o", ">         \r\n\u001b[?2004l\r"]
[54.162907, "o", "\u001b[?2004h>         Args:\r\n\u001b[?2004l\r"]
[54.162949, "o", "\u001b[?2004h> "]
[54.163089, "o", "            speed_gains: dict with 'kp', 'ki', 'kd' for speed controller\r\n\u001b[?2004l\r"]
[54.16311, "o", "\u001b[?2004h> "]
[54.163283, "o", "            distance_gains: dict with 'kp', 'ki', 'kd' for distance controller\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163309, "o", "> "]
[54.163336, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163361, "o", "> "]
[54.163454, "o", "        self.speed_controller = PIDController(\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163499, "o", "> "]
[54.163574, "o", "            speed_gains['kp'], speed_gains['ki'], speed_gains['kd']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16362, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163657, "o", "> "]
[54.163705, "o", "        self.distance_controller = PIDController(\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163741, "o", "> "]
[54.163819, "o", "            distance_gains['kp'], distance_gains['ki'], distance_gains['kd']\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163855, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163916, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.163952, "o", "> "]
[54.163998, "o", "    def compute_desired_distance(self, ego_speed):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.164036, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16413, "o", "        Compute desired following distance based on time headway.\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.164182, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.164222, "o", ">         Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.164298, "o", "            ego_speed: Current ego vehicle speed in m/s\r\n\u001b[?2004l\r"]
[54.164352, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.164405, "o", ">         Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.164483, "o", "            float: Desired following distance in meters\r\n\u001b[?2004l\r"]
[54.16455, "o", "\u001b[?2004h> "]
[54.164591, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.164657, "o", "        return self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r"]
[54.164704, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[54.164732, "o", "\u001b[?2004h> "]
[54.164793, "o", "    def compute_ttc(self, ego_speed, lead_speed, distance):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.164814, "o", ">         \"\"\"\r\n\u001b[?2004l\r"]
[54.164908, "o", "\u001b[?2004h> "]
[54.164986, "o", "        Compute Time-To-Collision.\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165038, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165082, "o", "            ego_speed: Ego vehicle speed in m/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165143, "o", "            lead_speed: Lead vehicle speed in m/s\r\n\u001b[?2004l\r"]
[54.165196, "o", "\u001b[?2004h> "]
[54.165246, "o", "            distance: Distance to lead vehicle in meters\r\n\u001b[?2004l\r"]
[54.165273, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[54.165319, "o", "\u001b[?2004h> "]
[54.165384, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165445, "o", "            float: TTC in seconds, or float('inf') if not approaching\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.165494, "o", ">         \"\"\"\r\n\u001b[?2004l\r"]
[54.165545, "o", "\u001b[?2004h> "]
[54.165594, "o", "        relative_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165652, "o", "        if relative_speed <= 0 or distance <= 0:\r\n\u001b[?2004l\r"]
[54.165702, "o", "\u001b[?2004h> "]
[54.165756, "o", "            return float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165802, "o", "        return distance / relative_speed\r\n\u001b[?2004l\r"]
[54.16585, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16594, "o", "    def compute(self, ego_speed, lead_speed, distance, dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.165993, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.166038, "o", ">         Compute ACC control command.\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.166095, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.166149, "o", ">         Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.166206, "o", "            ego_speed: Current ego vehicle speed in m/s\r\n\u001b[?2004l\r"]
[54.166258, "o", "\u001b[?2004h> "]
[54.166339, "o", "            lead_speed: Lead vehicle speed in m/s (None if no lead vehicle)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.166365, "o", "> "]
[54.166482, "o", "            distance: Distance to lead vehicle in meters (None if no lead vehicle)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.166541, "o", "            dt: Time step in seconds\r\n\u001b[?2004l\r"]
[54.166565, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[54.166632, "o", "\u001b[?2004h> "]
[54.166682, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16673, "o", "            tuple: (acceleration_cmd, mode, distance_error)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.166854, "o", "                - acceleration_cmd: Commanded acceleration in m/s^2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16694, "o", "                - mode: 'cruise', 'follow', or 'emergency'\r\n\u001b[?2004l\r"]
[54.166998, "o", "\u001b[?2004h> "]
[54.167076, "o", "                - distance_error: Distance error in meters (None in cruise mode)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.167104, "o", ">         \"\"\"\r\n\u001b[?2004l\r"]
[54.167154, "o", "\u001b[?2004h> "]
[54.167219, "o", "        # Cruise mode - no lead vehicle detected\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.167264, "o", "> "]
[54.167313, "o", "        if lead_speed is None or distance is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.167394, "o", "            speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.16745, "o", "> "]
[54.167512, "o", "            accel_cmd = self.speed_controller.compute(speed_error, dt)\r\n\u001b[?2004l\r"]
[54.167567, "o", "\u001b[?2004h> "]
[54.167616, "o", "            # Reset distance controller when in cruise mode\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.16767, "o", "> "]
[54.167716, "o", "            self.distance_controller.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.167763, "o", "            # Clamp acceleration\r\n\u001b[?2004l\r"]
[54.167817, "o", "\u001b[?2004h> "]
[54.167907, "o", "            accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.167952, "o", "> "]
[54.168, "o", "            return (accel_cmd, 'cruise', None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168053, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.1681, "o", "> "]
[54.168146, "o", "        # Calculate TTC for emergency detection\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168225, "o", "        ttc = self.compute_ttc(ego_speed, lead_speed, distance)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.168273, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16835, "o", "        # Emergency mode - TTC below threshold\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.168374, "o", "> "]
[54.168439, "o", "        if ttc < self.emergency_ttc_threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168506, "o", "            # Apply maximum braking\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.168627, "o", "> "]
[54.168727, "o", "            accel_cmd = self.max_deceleration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168782, "o", "            desired_dist = self.compute_desired_distance(ego_speed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168835, "o", "            distance_error = distance - desired_dist\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168938, "o", "            return (accel_cmd, 'emergency', distance_error)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.168991, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169045, "o", "> "]
[54.169096, "o", "        # Follow mode - maintain safe following distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.169178, "o", "        desired_distance = self.compute_desired_distance(ego_speed)\r\n\u001b[?2004l\r"]
[54.169223, "o", "\u001b[?2004h> "]
[54.169279, "o", "        distance_error = distance - desired_distance\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169334, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169378, "o", "> "]
[54.169429, "o", "        # Distance-based acceleration command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.16952, "o", "        dist_accel = self.distance_controller.compute(distance_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169574, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.169648, "o", "        # Also consider speed matching with lead vehicle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.169741, "o", "        # Blend distance control with speed matching\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169786, "o", "> "]
[54.169857, "o", "        speed_error = min(lead_speed, self.set_speed) - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.169913, "o", "> "]
[54.169976, "o", "        speed_accel = self.speed_controller.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.170024, "o", ">         \r\n\u001b[?2004l\r"]
[54.170077, "o", "\u001b[?2004h> "]
[54.170137, "o", "        # Use distance control primarily, with speed control influence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.170257, "o", "        # When far behind (positive error), allow more acceleration\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.170301, "o", "> "]
[54.170359, "o", "        # When too close (negative error), prioritize braking\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.170413, "o", "> "]
[54.170465, "o", "        if distance_error < 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.17054, "o", "            # Too close - prioritize distance control (braking)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.170589, "o", "> "]
[54.170631, "o", "            accel_cmd = min(dist_accel, speed_accel)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.170688, "o", ">         else:\r\n\u001b[?2004l\r"]
[54.170749, "o", "\u001b[?2004h> "]
[54.170789, "o", "            # Safe distance or farther - blend controls\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.170883, "o", "            accel_cmd = 0.6 * dist_accel + 0.4 * speed_accel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.170938, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.170965, "o", "        # Clamp acceleration\r\n\u001b[?2004l\r"]
[54.171076, "o", "\u001b[?2004h> "]
[54.171154, "o", "        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[54.171231, "o", "\u001b[?2004h> "]
[54.171263, "o", "        return (accel_cmd, 'follow', distance_error)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[54.172414, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[85.781829, "i", "cat > tuning_results.yaml << 'EOF'\n# Tuned PID parameters for ACC system\n# Speed controller: targets rise time <10s, overshoot <5%, steady-state error <0.5 m/s\n# Distance controller: targets steady-state error <2m, minimum distance >5m\n\npid_speed:\n  kp: 1.2\n  ki: 0.08\n  kd: 0.3\n\npid_distance:\n  kp: 0.4\n  ki: 0.02\n  kd: 0.8\nEOF\n"]
