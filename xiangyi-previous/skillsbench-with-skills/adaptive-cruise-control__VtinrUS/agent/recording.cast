[149.779506, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[189.679025, "i", "cat > simulation.py << 'EOF'\n\"\"\"ACC Simulation runner with proper position tracking.\"\"\"\n\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\n\ndef load_yaml(filepath):\n    \"\"\"Load YAML configuration file.\"\"\"\n    with open(filepath, 'r') as f:\n        return yaml.safe_load(f)\n\n\ndef load_sensor_data(filepath):\n    \"\"\"Load sensor data from CSV file.\"\"\"\n    data = []\n    with open(filepath, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            entry = {\n                'time': float(row['time']),\n                'ref_ego_speed': float(row['ego_speed']) if row['ego_speed'] else 0.0,\n                'lead_speed': float(row['lead_speed']) if row['lead_speed'] else None,\n                'ref_distance': float(row['distance']) if row['distance'] else None\n            }\n            data.append(entry)\n    return data\n\n\ndef run_simulation():\n    \"\"\"Run the ACC simulation with proper position tracking.\"\"\"\n    # Load configurations\n    vehicle_config = load_yaml('vehicle_params.yaml')\n    tuning_config = load_yaml('tuning_results.yaml')\n    \n    # Load sensor data for lead vehicle information\n    sensor_data = load_sensor_data('sensor_data.csv')\n    \n    # Initialize ACC system\n    acc = AdaptiveCruiseControl(vehicle_config)\n    \n    # Update with tuned PID gains\n    acc.set_pid_gains(tuning_config['pid_speed'], tuning_config['pid_distance'])\n    \n    # Simulation parameters\n    dt = vehicle_config['simulation']['dt']\n    \n    # Initial state - ego vehicle\n    ego_speed = 0.0\n    ego_position = 0.0\n    \n    # Lead vehicle state (will be set when lead appears)\n    lead_position = None\n    lead_active = False\n    \n    # Results storage\n    results = []\n    \n    # Run simulation for each timestep\n    for i, sensor in enumerate(sensor_data):\n        time = sensor['time']\n        lead_speed = sensor['lead_speed']\n        \n        # Handle lead vehicle appearance/disappearance\n        if lead_speed is not None:\n            if not lead_active:\n                # Lead vehicle just appeared - initialize its position\n                # Use the reference distance from sensor data for initial gap\n                initial_distance = sensor['ref_distance'] if sensor['ref_distance'] else 50.0\n                lead_position = ego_position + initial_distance\n                lead_active = True\n            \n            # Calculate current distance\n            distance = lead_position - ego_position\n        else:\n            lead_active = False\n            lead_position = None\n            distance = None\n        \n        # Compute ACC command\n        accel_cmd, mode, distance_error = acc.compute(\n            ego_speed, lead_speed, distance, dt\n        )\n        \n        # Calculate TTC if lead vehicle present\n        if lead_speed is not None and distance is not None:\n            ttc = acc.compute_ttc(ego_speed, lead_speed, distance)\n            if ttc == float('inf'):\n                ttc_str = ''\n            else:\n                ttc_str = f'{ttc:.2f}'\n            distance_str = f'{distance:.2f}'\n            dist_error_str = f'{distance_error:.2f}' if distance_error is not None else ''\n        else:\n            ttc_str = ''\n            distance_str = ''\n            dist_error_str = ''\n        \n        # Store result\n        results.append({\n            'time': time,\n            'ego_speed': round(ego_speed, 10),\n            'acceleration_cmd': round(accel_cmd, 10),\n            'mode': mode,\n            'distance_error': dist_error_str,\n            'distance': distance_str,\n            'ttc': ttc_str\n        })\n        \n        # Update ego vehicle state\n        ego_speed = ego_speed + accel_cmd * dt\n        ego_speed = max(0.0, ego_speed)  # Can't go backwards\n        ego_position = ego_position + ego_speed * dt\n        \n        # Update lead vehicle position if active\n        if lead_active and lead_speed is not None:\n            lead_position = lead_position + lead_speed * dt\n    \n    # Write results to CSV\n    with open('simulation_results.csv', 'w', newline='') as f:\n        fieldnames = ['time', 'ego_speed"]
[189.679187, "i", "', 'acceleration_cmd', 'mode', \n                      'distance_error', 'distance', 'ttc']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        writer.writerows(results)\n    \n    print(f\"Simulation complete. Results saved to simulation_results.csv\")\n    print(f\"Total timesteps: {len(results)}\")\n    \n    # Calculate and print performance metrics\n    analyze_results(results, vehicle_config)\n    \n    return results\n\n\ndef analyze_results(results, config):\n    \"\"\"Analyze simulation results and print metrics.\"\"\"\n    set_speed = config['acc_settings']['set_speed']\n    \n    # Find rise time (time to reach 90% of set speed for the first time)\n    rise_time = None\n    for r in results:\n        if r['ego_speed'] >= 0.9 * set_speed:\n            rise_time = r['time']\n            break\n    \n    # Find max speed during cruise phase (before lead appears at t=30)\n    cruise_phase_speeds = [r['ego_speed'] for r in results if r['time'] < 30]\n    max_cruise_speed = max(cruise_phase_speeds) if cruise_phase_speeds else 0\n    \n    # Find overall max speed\n    max_speed = max(r['ego_speed'] for r in results)\n    \n    # Calculate overshoot during initial cruise phase\n    overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0\n    \n    # Calculate steady-state speed error (use t=25-29s, just before lead appears)\n    ss_cruise_speeds = [r['ego_speed'] for r in results if 25 <= r['time'] < 30]\n    if ss_cruise_speeds:\n        ss_speed_error = abs(set_speed - sum(ss_cruise_speeds) / len(ss_cruise_speeds))\n    else:\n        ss_speed_error = 0\n    \n    # Also check final cruise phase (t=140-150s)\n    final_cruise_speeds = [r['ego_speed'] for r in results if r['time'] >= 140 and r['mode'] == 'cruise']\n    if final_cruise_speeds:\n        final_ss_error = abs(set_speed - sum(final_cruise_speeds) / len(final_cruise_speeds))\n    else:\n        final_ss_error = ss_speed_error\n    \n    # Use the worse of the two for reporting\n    ss_speed_error = max(ss_speed_error, final_ss_error)\n    \n    # Find minimum distance during follow/emergency mode\n    follow_distances = []\n    for r in results:\n        if r['distance'] and r['mode'] in ['follow', 'emergency']:\n            try:\n                follow_distances.append(float(r['distance']))\n            except:\n                pass\n    min_distance = min(follow_distances) if follow_distances else float('inf')\n    \n    # Calculate distance steady-state error (last 20s of follow mode)\n    follow_results = [(r['time'], r['distance_error']) for r in results if r['distance_error']]\n    if follow_results:\n        # Get the last portion of follow mode\n        last_follow = [float(de) for t, de in follow_results if t > 100]\n        if not last_follow:\n            last_follow = [float(de) for t, de in follow_results[-50:]]\n        if last_follow:\n            ss_dist_error = abs(sum(last_follow) / len(last_follow))\n        else:\n            ss_dist_error = 0\n    else:\n        ss_dist_error = 0\n    \n    print(f\"\\n=== Performance Metrics ===\")\n    print(f\"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s\" if rise_time else \"Rise time: N/A\")\n    print(f\"Maximum cruise speed: {max_cruise_speed:.2f} m/s\")\n    print(f\"Speed overshoot: {overshoot:.2f}%\")\n    print(f\"Steady-state speed error: {ss_speed_error:.3f} m/s\")\n    print(f\"Minimum following distance: {min_distance:.2f} m\")\n    print(f\"Steady-state distance error: {ss_dist_error:.2f} m\")\n    \n    # Check against targets\n    print(f\"\\n=== Target Compliance ===\")\n    print(f\"Rise time < 10s: {'PASS' if rise_time and rise_time < 10 else 'FAIL'}\")\n    print(f\"Overshoot < 5%: {'PASS' if overshoot < 5 else 'FAIL'}\")\n    print(f\"Speed SS error < 0.5 m/s: {'PASS' if ss_speed_error < 0.5 else 'FAIL'}\")\n    print(f\"Distance SS error < 2m: {'PASS' if ss_dist_error < 2 else 'FAIL'}\")\n    print(f\"Min distance > 5m: {'PASS' if min_distance > 5 else 'FAIL'}\")\n\n\nif __name__ == '__main__':\n    run_simulation()\nEOF\n"]
[189.679501, "o", "cat > simulation.py << 'EOF'\r\n\u001b[?2004l\r"]
[189.679573, "o", "\u001b[?2004h> "]
[189.679905, "o", "\"\"\"ACC Simulation runner with proper position tracking.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.679994, "o", "> \r\n\u001b[?2004l\r"]
[189.680064, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[189.680102, "o", "\u001b[?2004h> import yaml\r\n"]
[189.680157, "o", "\u001b[?2004l\r\u001b[?2004h"]
[189.680235, "o", "> "]
[189.680408, "o", "from acc_system import AdaptiveCruiseControl\r\n\u001b[?2004l\r"]
[189.680466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rw"]
[189.680543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[189.680682, "o", "def load_yaml(filepath):\r\n\u001b[?2004l\r"]
[189.680736, "o", "\u001b[?2004h> "]
[189.680929, "o", "    \"\"\"Load YAML configuration file.\"\"\"\r\n\u001b[?2004l\r"]
[189.680983, "o", "\u001b[?2004h> "]
[189.681073, "o", "    with open(filepath, 'r') as f:\r\n\u001b[?2004l\r"]
[189.681134, "o", "\u001b[?2004h> "]
[189.68129, "o", "        return yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[189.68135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[189.681425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[189.681565, "o", "def load_sensor_data(filepath):\r\n\u001b[?2004l\r"]
[189.681596, "o", "\u001b[?2004h> "]
[189.681793, "o", "    \"\"\"Load sensor data from CSV file.\"\"\"\r\n\u001b[?2004l\r"]
[189.681845, "o", "\u001b[?2004h> "]
[189.681891, "o", "    data = []\r\n\u001b[?2004l\r"]
[189.681939, "o", "\u001b[?2004h> "]
[189.682097, "o", "    with open(filepath, 'r') as f:\r\n\u001b[?2004l\r"]
[189.682151, "o", "\u001b[?2004h> "]
[189.682321, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[189.682368, "o", "\u001b[?2004h> "]
[189.6825, "o", "        for row in reader:\r\n\u001b[?2004l\r"]
[189.682547, "o", "\u001b[?2004h> "]
[189.682662, "o", "            entry = {\r\n\u001b[?2004l\r"]
[189.682715, "o", "\u001b[?2004h> "]
[189.682965, "o", "                'time': float(row['time']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.683447, "o", "                'ref_ego_speed': float(row['ego_speed']) if row['ego_speed'] else 0.0,\r\n\u001b[?2004l\r"]
[189.683506, "o", "\u001b[?2004h> "]
[189.683894, "o", "                'lead_speed': float(row['lead_speed']) if row['lead_speed'] else None,\r\n\u001b[?2004l\r"]
[189.68396, "o", "\u001b[?2004h> "]
[189.684389, "o", "                'ref_distance': float(row['distance']) if row['distance'] else None\r\n\u001b[?2004l\r"]
[189.684448, "o", "\u001b[?2004h> "]
[189.684494, "o", "            }\r\n\u001b[?2004l\r"]
[189.684566, "o", "\u001b[?2004h> "]
[189.684672, "o", "            data.append(entry)\r\n\u001b[?2004l\r"]
[189.684697, "o", "\u001b[?2004h> "]
[189.684818, "o", "    return data\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[189.684872, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[189.684915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.685026, "o", "def run_simulation():\r\n\u001b[?2004l\r"]
[189.685077, "o", "\u001b[?2004h> "]
[189.685451, "o", "    \"\"\"Run the ACC simulation with proper position tracking.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.685588, "o", "    # Load configurations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.685777, "o", "    vehicle_config = load_yaml('vehicle_params.yaml')\r\n\u001b[?2004l\r"]
[189.685856, "o", "\u001b[?2004h> "]
[189.686108, "o", "    tuning_config = load_yaml('tuning_results.yaml')\r\n\u001b[?2004l\r"]
[189.686134, "o", "\u001b[?2004h> "]
[189.686202, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.686496, "o", "    # Load sensor data for lead vehicle information\r\n\u001b[?2004l\r"]
[189.686522, "o", "\u001b[?2004h> "]
[189.686838, "o", "    sensor_data = load_sensor_data('sensor_data.csv')\r\n\u001b[?2004l\r"]
[189.686865, "o", "\u001b[?2004h> "]
[189.686934, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.687091, "o", "    # Initialize ACC system\r\n\u001b[?2004l\r"]
[189.687151, "o", "\u001b[?2004h> "]
[189.687397, "o", "    acc = AdaptiveCruiseControl(vehicle_config)\r\n\u001b[?2004l\r"]
[189.687422, "o", "\u001b[?2004h> "]
[189.687478, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.687713, "o", "    # Update with tuned PID gains\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.687773, "o", "> "]
[189.688197, "o", "    acc.set_pid_gains(tuning_config['pid_speed'], tuning_config['pid_distance'])\r\n\u001b[?2004l\r"]
[189.688224, "o", "\u001b[?2004h> "]
[189.688292, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.68846, "o", "    # Simulation parameters\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.688527, "o", "> "]
[189.688749, "o", "    dt = vehicle_config['simulation']['dt']\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.688776, "o", "> "]
[189.688832, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.689041, "o", "    # Initial state - ego vehicle\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.689085, "o", "> "]
[189.689175, "o", "    ego_speed = 0.0\r\n\u001b[?2004l\r"]
[189.68922, "o", "\u001b[?2004h> "]
[189.689336, "o", "    ego_position = 0.0\r\n\u001b[?2004l\r"]
[189.689376, "o", "\u001b[?2004h> "]
[189.689419, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.68946, "o", "> "]
[189.689758, "o", "    # Lead vehicle state (will be set when lead appears)\r\n\u001b[?2004l\r"]
[189.689783, "o", "\u001b[?2004h> "]
[189.689933, "o", "    lead_position = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.689982, "o", "> "]
[189.690095, "o", "    lead_active = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.690142, "o", "> "]
[189.69019, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.690308, "o", "    # Results storage\r\n\u001b[?2004l\r"]
[189.690354, "o", "\u001b[?2004h> "]
[189.690445, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.690485, "o", "> "]
[189.690525, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.690761, "o", "    # Run simulation for each timestep\r\n\u001b[?2004l\r"]
[189.690786, "o", "\u001b[?2004h> "]
[189.691047, "o", "    for i, sensor in enumerate(sensor_data):\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.691073, "o", "> "]
[189.69125, "o", "        time = sensor['time']\r\n\u001b[?2004l\r"]
[189.691302, "o", "\u001b[?2004h> "]
[189.691515, "o", "        lead_speed = sensor['lead_speed']\r\n\u001b[?2004l\r"]
[189.69154, "o", "\u001b[?2004h> "]
[189.691591, "o", "        \r\n\u001b[?2004l\r"]
[189.691635, "o", "\u001b[?2004h> "]
[189.691949, "o", "        # Handle lead vehicle appearance/disappearance\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.692004, "o", "> "]
[189.692161, "o", "        if lead_speed is not None:\r\n\u001b[?2004l\r"]
[189.692204, "o", "\u001b[?2004h> "]
[189.692371, "o", "            if not lead_active:\r\n\u001b[?2004l\r"]
[189.692421, "o", "\u001b[?2004h> "]
[189.692818, "o", "                # Lead vehicle just appeared - initialize its position\r\n\u001b[?2004l\r"]
[189.692842, "o", "\u001b[?2004h> "]
[189.693272, "o", "                # Use the reference distance from sensor data for initial gap\r\n\u001b[?2004l\r"]
[189.693331, "o", "\u001b[?2004h> "]
[189.693836, "o", "                initial_distance = sensor['ref_distance'] if sensor['ref_distance'] else 50.0\r\n\u001b[?2004l\r"]
[189.693863, "o", "\u001b[?2004h> "]
[189.694233, "o", "                lead_position = ego_position + initial_distance\r\n\u001b[?2004l\r"]
[189.694261, "o", "\u001b[?2004h> "]
[189.694473, "o", "                lead_active = True\r\n\u001b[?2004l\r"]
[189.694522, "o", "\u001b[?2004h> "]
[189.694583, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.694631, "o", "> "]
[189.694848, "o", "            # Calculate current distance\r\n\u001b[?2004l\r"]
[189.694874, "o", "\u001b[?2004h> "]
[189.695177, "o", "            distance = lead_position - ego_position\r\n\u001b[?2004l\r"]
[189.695226, "o", "\u001b[?2004h> "]
[189.695298, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.695348, "o", "> "]
[189.695507, "o", "            lead_active = False\r\n\u001b[?2004l\r"]
[189.695555, "o", "\u001b[?2004h> "]
[189.695732, "o", "            lead_position = None\r\n\u001b[?2004l\r"]
[189.695776, "o", "\u001b[?2004h> "]
[189.695925, "o", "            distance = None\r\n\u001b[?2004l\r"]
[189.69597, "o", "\u001b[?2004h> "]
[189.696014, "o", "        \r\n\u001b[?2004l\r"]
[189.696065, "o", "\u001b[?2004h> "]
[189.69621, "o", "        # Compute ACC command\r\n\u001b[?2004l\r"]
[189.696257, "o", "\u001b[?2004h> "]
[189.696582, "o", "        accel_cmd, mode, distance_error = acc.compute(\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.696631, "o", "> "]
[189.696886, "o", "            ego_speed, lead_speed, distance, dt\r\n\u001b[?2004l\r"]
[189.696915, "o", "\u001b[?2004h> "]
[189.696986, "o", "        )\r\n\u001b[?2004l\r"]
[189.697039, "o", "\u001b[?2004h> "]
[189.697091, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.697144, "o", "> "]
[189.69738, "o", "        # Calculate TTC if lead vehicle present\r\n\u001b[?2004l\r"]
[189.697405, "o", "\u001b[?2004h> "]
[189.697754, "o", "        if lead_speed is not None and distance is not None:\r\n\u001b[?2004l\r"]
[189.697777, "o", "\u001b[?2004h> "]
[189.69817, "o", "            ttc = acc.compute_ttc(ego_speed, lead_speed, distance)\r\n\u001b[?2004l\r"]
[189.698194, "o", "\u001b[?2004h> "]
[189.698404, "o", "            if ttc == float('inf'):\r\n\u001b[?2004l\r"]
[189.698455, "o", "\u001b[?2004h> "]
[189.698606, "o", "                ttc_str = ''\r\n\u001b[?2004l\r"]
[189.698672, "o", "\u001b[?2004h> "]
[189.698749, "o", "            else:\r\n\u001b[?2004l\r"]
[189.698814, "o", "\u001b[?2004h> "]
[189.699002, "o", "                ttc_str = f'{ttc:.2f}'\r\n\u001b[?2004l\r"]
[189.699069, "o", "\u001b[?2004h> "]
[189.699297, "o", "            distance_str = f'{distance:.2f}'\r\n\u001b[?2004l\r"]
[189.699363, "o", "\u001b[?2004h> "]
[189.699872, "o", "            dist_error_str = f'{distance_error:.2f}' if distance_error is not None else ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.699968, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.700035, "o", "> "]
[189.700142, "o", "            ttc_str = ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.700188, "o", "> "]
[189.70034, "o", "            distance_str = ''\r\n\u001b[?2004l\r"]
[189.700385, "o", "\u001b[?2004h> "]
[189.700578, "o", "            dist_error_str = ''\r\n\u001b[?2004l\rn\u001b[?2004h"]
[189.700635, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.700684, "o", "> "]
[189.700737, "o", "        # Store result\r\n\u001b[?2004l\r"]
[189.700784, "o", "\u001b[?2004h> "]
[189.700856, "o", "        results.append({\r\n\u001b[?2004l\r"]
[189.7009, "o", "\u001b[?2004h> "]
[189.700984, "o", "            'time': time,\r\n\u001b[?2004l\r"]
[189.701033, "o", "\u001b[?2004h> "]
[189.701215, "o", "            'ego_speed': round(ego_speed, 10),\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.701266, "o", "> "]
[189.701441, "o", "            'acceleration_cmd': round(accel_cmd, 10),\r\n\u001b[?2004l\r"]
[189.701488, "o", "\u001b[?2004h> "]
[189.70157, "o", "            'mode': mode,\r\n\u001b[?2004l\r"]
[189.701615, "o", "\u001b[?2004h> "]
[189.701782, "o", "            'distance_error': dist_error_str,\r\n\u001b[?2004l\r"]
[189.701822, "o", "\u001b[?2004h> "]
[189.70196, "o", "            'distance': distance_str,\r\n\u001b[?2004l\r"]
[189.701998, "o", "\u001b[?2004h> "]
[189.702096, "o", "            'ttc': ttc_str\r\n\u001b[?2004l\r"]
[189.702133, "o", "\u001b[?2004h> "]
[189.702172, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.702213, "o", ">         \r\n\u001b[?2004l\r"]
[189.702251, "o", "\u001b[?2004h> "]
[189.702371, "o", "        # Update ego vehicle state\r\n\u001b[?2004l\r"]
[189.70239, "o", "\u001b[?2004h> "]
[189.702579, "o", "        ego_speed = ego_speed + accel_cmd * dt\r\n\u001b[?2004l\r"]
[189.702627, "o", "\u001b[?2004h> "]
[189.70285, "o", "        ego_speed = max(0.0, ego_speed)  # Can't go backwards\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.702876, "o", "> "]
[189.703114, "o", "        ego_position = ego_position + ego_speed * dt\r\n\u001b[?2004l\r"]
[189.703137, "o", "\u001b[?2004h> "]
[189.703217, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.703268, "o", "> "]
[189.703494, "o", "        # Update lead vehicle position if active\r\n\u001b[?2004l\r"]
[189.703517, "o", "\u001b[?2004h> "]
[189.703741, "o", "        if lead_active and lead_speed is not None:\r\n\u001b[?2004l\r"]
[189.703764, "o", "\u001b[?2004h> "]
[189.704295, "o", "            lead_position = lead_position + lead_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.704357, "o", "    # Write results to CSV\r\n\u001b[?2004l\r"]
[189.704384, "o", "\u001b[?2004h> "]
[189.704543, "o", "    with open('simulation_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[189.704609, "o", "\u001b[?2004h> "]
[189.704737, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \r\n\u001b[?2004l\r"]
[189.70476, "o", "\u001b[?2004h> "]
[189.704913, "o", "                      'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r"]
[189.704936, "o", "\u001b[?2004h> "]
[189.705102, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.705178, "o", "        writer.writeheader()\r\n\u001b[?2004l\r"]
[189.705206, "o", "\u001b[?2004h> "]
[189.705318, "o", "        writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.705387, "o", "    \r\n\u001b[?2004l\r"]
[189.705464, "o", "\u001b[?2004h> "]
[189.705563, "o", "    print(f\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.705621, "o", "> "]
[189.705706, "o", "    print(f\"Total timesteps: {len(results)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.705782, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.705908, "o", "    # Calculate and print performance metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.705962, "o", "> "]
[189.706043, "o", "    analyze_results(results, vehicle_config)\r\n\u001b[?2004l\r"]
[189.706087, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[189.706119, "o", "\u001b[?2004h> "]
[189.70618, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.706232, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[189.706278, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[189.706362, "o", "def analyze_results(results, config):\r\n\u001b[?2004l\r"]
[189.706413, "o", "\u001b[?2004h> "]
[189.706529, "o", "    \"\"\"Analyze simulation results and print metrics.\"\"\"\r\n\u001b[?2004l\r"]
[189.706576, "o", "\u001b[?2004h> "]
[189.706686, "o", "    set_speed = config['acc_settings']['set_speed']\r\n\u001b[?2004l\r"]
[189.706757, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[189.706826, "o", "\u001b[?2004h> "]
[189.706939, "o", "    # Find rise time (time to reach 90% of set speed for the first time)\r\n\u001b[?2004l\r"]
[189.706968, "o", "\u001b[?2004h> "]
[189.707031, "o", "    rise_time = None\r\n\u001b[?2004l\r"]
[189.707091, "o", "\u001b[?2004h> "]
[189.707145, "o", "    for r in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.707255, "o", "        if r['ego_speed'] >= 0.9 * set_speed:\r\n\u001b[?2004l\r"]
[189.707301, "o", "\u001b[?2004h> "]
[189.70737, "o", "            rise_time = r['time']\r\n\u001b[?2004l\r"]
[189.707417, "o", "\u001b[?2004h> "]
[189.707455, "o", "            break\r\n\u001b[?2004l\r"]
[189.707501, "o", "\u001b[?2004h> "]
[189.70754, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.707725, "o", "    # Find max speed during cruise phase (before lead appears at t=30)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.70791, "o", "    cruise_phase_speeds = [r['ego_speed'] for r in results if r['time'] < 30]\r\n\u001b[?2004l\r"]
[189.707961, "o", "\u001b[?2004h> "]
[189.708138, "o", "    max_cruise_speed = max(cruise_phase_speeds) if cruise_phase_speeds else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.708184, "o", ">     \r\n\u001b[?2004l\r"]
[189.708237, "o", "\u001b[?2004h> "]
[189.708279, "o", "    # Find overall max speed\r\n\u001b[?2004l\r"]
[189.708325, "o", "\u001b[?2004h> "]
[189.708443, "o", "    max_speed = max(r['ego_speed'] for r in results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.708482, "o", ">     \r\n\u001b[?2004l\r"]
[189.708548, "o", "\u001b[?2004h> "]
[189.708661, "o", "    # Calculate overshoot during initial cruise phase\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.708708, "o", "> "]
[189.708924, "o", "    overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0\r\n\u001b[?2004l\r"]
[189.708971, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[189.709017, "o", "\u001b[?2004h> "]
[189.709198, "o", "    # Calculate steady-state speed error (use t=25-29s, just before lead appears)\r\n\u001b[?2004l\r"]
[189.709242, "o", "\u001b[?2004h> "]
[189.709422, "o", "    ss_cruise_speeds = [r['ego_speed'] for r in results if 25 <= r['time'] < 30]\r\n\u001b[?2004l\r"]
[189.709471, "o", "\u001b[?2004h> "]
[189.709518, "o", "    if ss_cruise_speeds:\r\n\u001b[?2004l\r"]
[189.709564, "o", "\u001b[?2004h> "]
[189.709757, "o", "        ss_speed_error = abs(set_speed - sum(ss_cruise_speeds) / len(ss_cruise_speeds))\r\n\u001b[?2004l\r"]
[189.709807, "o", "\u001b[?2004h> "]
[189.709852, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.709914, "o", "        ss_speed_error = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.709964, "o", ">     \r\n\u001b[?2004l\r"]
[189.710012, "o", "\u001b[?2004h> "]
[189.710105, "o", "    # Also check final cruise phase (t=140-150s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.710385, "o", "    final_cruise_speeds = [r['ego_speed'] for r in results if r['time'] >= 140 and r['mode'] == 'cruise']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.710483, "o", "    if final_cruise_speeds:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.710538, "o", "> "]
[189.71073, "o", "        final_ss_error = abs(set_speed - sum(final_cruise_speeds) / len(final_cruise_speeds))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.710792, "o", "    else:\r\n\u001b[?2004l\r"]
[189.710848, "o", "\u001b[?2004h> "]
[189.710911, "o", "        final_ss_error = ss_speed_error\r\n\u001b[?2004l\r"]
[189.710957, "o", "\u001b[?2004h> "]
[189.711006, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.711124, "o", "    # Use the worse of the two for reporting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.711284, "o", "    ss_speed_error = max(ss_speed_error, final_ss_error)\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.711334, "o", ">     \r\n\u001b[?2004l\r"]
[189.711363, "o", "\u001b[?2004h> "]
[189.711486, "o", "    # Find minimum distance during follow/emergency mode\r\n\u001b[?2004l\r"]
[189.711516, "o", "\u001b[?2004h> "]
[189.711584, "o", "    follow_distances = []\r\n\u001b[?2004l\r"]
[189.71163, "o", "\u001b[?2004h> "]
[189.711682, "o", "    for r in results:\r\n\u001b[?2004l\r"]
[189.711732, "o", "\u001b[?2004h> "]
[189.711843, "o", "        if r['distance'] and r['mode'] in ['follow', 'emergency']:\r\n\u001b[?2004l\r"]
[189.711897, "o", "\u001b[?2004h> "]
[189.71195, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.712157, "o", "                follow_distances.append(float(r['distance']))\r\n\u001b[?2004l\r\u001b[?2004h>             except:\r\n\u001b[?2004l\r"]
[189.712218, "o", "\u001b[?2004h> "]
[189.712268, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.712316, "o", "> "]
[189.712462, "o", "    min_distance = min(follow_distances) if follow_distances else float('inf')\r\n\u001b[?2004l\r"]
[189.712508, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[189.712588, "o", "\u001b[?2004h> "]
[189.712718, "o", "    # Calculate distance steady-state error (last 20s of follow mode)\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.71277, "o", "> "]
[189.712979, "o", "    follow_results = [(r['time'], r['distance_error']) for r in results if r['distance_error']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.713025, "o", "> "]
[189.713071, "o", "    if follow_results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.713117, "o", "> "]
[189.71322, "o", "        # Get the last portion of follow mode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.713398, "o", "        last_follow = [float(de) for t, de in follow_results if t > 100]\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.713446, "o", "> "]
[189.713493, "o", "        if not last_follow:\r\n\u001b[?2004l\r"]
[189.732564, "o", "\u001b[?2004h> "]
[189.734067, "o", "            last_follow = [float(de) for t, de in follow_results[-50:]]\r\n\u001b[?2004l\r\u001b[?2004h>         if last_follow:\r\n\u001b[?2004l\r\u001b[?2004h>             ss_dist_error = abs(sum(last_follow) / len(last_follow))\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             ss_dist_error = 0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         ss_dist_error = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n=== Performance Metrics ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s\" if rise_time else \"Rise time: N/A\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Maximum cruise speed: {max_cruise_speed:.2f} m/s\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Speed overshoot: {overshoot:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Steady-state speed error: {ss_speed_error:.3f} m/s\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Minimum following distance: {min_distance:.2f} m\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Steady-state distance error: {ss_dist_error:.2f} m\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check against targets\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n=== Target Compliance ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Rise time < 10s: {'PASS' if rise_time and rise_time < 10 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Overshoot < 5%: {'PASS' if overshoot < 5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Speed SS error < 0.5 m/s: {'PASS' if ss_speed_error < 0.5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Distance SS error < 2m: {'PASS' if ss_dist_error < 2 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Min distance > 5m: {'PASS' if min_distance > 5 else 'FAIL'}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     run_simulation()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@5872ab224e04:~# "]
[190.199486, "i", "python3 simulation.py\n"]
[190.199715, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[190.253133, "o", "Simulation complete. Results saved to simulation_results.csv\r\nTotal timesteps: 1501\r\n"]
[190.253838, "o", "\r\n=== Performance Metrics ===\r\nRise time (to 90% of 30.0 m/s): 9.0s\r\nMaximum cruise speed: 35.12 m/s\r\nSpeed overshoot: 17.06%\r\nSteady-state speed error: 3.470 m/s\r\nMinimum following distance: 16.07 m\r\nSteady-state distance error: 2.63 m\r\n\r\n=== Target Compliance ===\r\nRise time < 10s: PASS\r\nOvershoot < 5%: FAIL\r\nSpeed SS error < 0.5 m/s: FAIL\r\nDistance SS error < 2m: FAIL\r\n"]
[190.253963, "o", "Min distance > 5m: PASS\r\n"]
[190.259566, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[204.461249, "i", "cat > tuning_results.yaml << 'EOF'\n# Tuned PID parameters for ACC system\n# Speed controller: targets rise time <10s, overshoot <5%, steady-state error <0.5 m/s\n# Distance controller: targets steady-state error <2m, minimum distance >5m\n\npid_speed:\n  kp: 0.35\n  ki: 0.05\n  kd: 0.2\n\npid_distance:\n  kp: 0.25\n  ki: 0.015\n  kd: 1.2\nEOF\n"]
[204.461523, "o", "cat > tuning_results.yaml << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.461612, "o", "# Tuned PID parameters for ACC system\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.461741, "o", "# Speed controller: targets rise time <10s, overshoot <5%, steady-state error <0.5 m/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.461882, "o", "# Distance controller: targets steady-state error <2m, minimum distance >5m\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.461956, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.462042, "o", "pid_speed:\r\n\u001b[?2004l\r\u001b[?2004h>   kp: 0.35\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.462116, "o", "  ki: 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.462169, "o", "  kd: 0.2\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.462221, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.462275, "o", "pid_distance:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.462324, "o", "  kp: 0.25\r\n\u001b[?2004l\r"]
[204.46237, "o", "\u001b[?2004h>   ki: 0.015\r\n\u001b[?2004l\r"]
[204.462415, "o", "\u001b[?2004h>   kd: 1.2\r\n\u001b[?2004l\r"]
[204.462467, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[204.463796, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[204.744793, "i", "python3 simulation.py\n"]
[204.745586, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[204.792063, "o", "Simulation complete. Results saved to simulation_results.csv\r\nTotal timesteps: 1501\r\n"]
[204.792835, "o", "\r\n=== Performance Metrics ===\r\nRise time (to 90% of 30.0 m/s): 9.0s\r\nMaximum cruise speed: 43.57 m/s\r\n"]
[204.792865, "o", "Speed overshoot: 45.25%\r\nSteady-state speed error: 2.978 m/s\r\nMinimum following distance: 22.74 m\r\nSteady-state distance error: 7.21 m\r\n\r\n=== Target Compliance ===\r\nRise time < 10s: PASS\r\nOvershoot < 5%: FAIL\r\nSpeed SS error < 0.5 m/s: FAIL\r\n"]
[204.792887, "o", "Distance SS error < 2m: FAIL\r\nMin distance > 5m: PASS\r\n"]
[204.797956, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[216.517645, "i", "awk -F',' 'NR>1 && NR<150 {print $1\",\"$2\",\"$3\",\"$4}' simulation_results.csv | head -50\n"]
[216.517992, "o", "awk -F',' 'NR>1 && NR<150 {print $1\",\"$2\",\"$3\",\"$4}' simulation_results.csv | head -50\r\n\u001b[?2004l\r"]
