[469.86706, "o", "### 3.3 Mode Distribution\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[469.867109, "o", "> "]
[469.867177, "o", "- **Cruise mode:** 0-30s (initial acceleration) and 130-150s (final cruise)\r\n\u001b[?2004l\r\u001b[?2004h"]
[469.86723, "o", "> "]
[469.867271, "o", "- **Follow mode:** 30-130s (following lead vehicle)\r\n\u001b[?2004l\r\u001b[?2004h"]
[469.867325, "o", "> "]
