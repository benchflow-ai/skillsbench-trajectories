[216.869497, "o", "28.0,32.4417905354,-0.7247556555,cruise,,,\r\r\n28.1,32.3693149699,-0.7135003222,cruise,,,\r\r\n28.2,32.2979649376,-0.7022794808,cruise,,,\r\r\n28.3,32.2277369896,-0.6910966937,cruise,,,\r\r\n28.4,32.1586273202,-0.6799554053,cruise,,,\r\r\n28.5,32.0906317796,-0.668858944,cruise,,,\r\r\n28.6,32.0237458852,-0.6578105241,cruise,,,\r\r\n28.7,31.9579648328,-0.6468132476,cruise,,,\r\r\n28.8,31.8932835081,-0.6358701067,cruise,,,\r\r\n28.9,31.8296964974,-0.6249839853,cruise,,,\r\r\n29.0,31.7671980989,-0.614157661,cruise,,,\r\r\n29.1,31.7057823328,-0.6033938073,cruise,,,\r\r\n29.2,31.6454429521,-0.5926949951,cruise,,,\r\r\n29.3,31.5861734525,-0.5820636951,cruise,,,\r\r\n29.4,31.527967083,-0.5715022792,cruise,,,\r\r\n29.5,31.4708168551,-0.5610130228,cruise,,,\r\r\n29.6,31.4147155528,-0.5505981063,cruise,,,\r\r\n29.7,31.3596557422,-0.5402596172,cruise,,,\r\r\n29.8,31.3056297805,-0.5299995517,cruise,,,\r\r\n29.9,31.2526298253,-0.519819817,cruise,,,\r\r\n30.0,31.2006478436,-1.4485700746,follow,-4.70,52.10,8.94\r\r\n30.1,31.0557908362,-2.3445161831,follow,-5.05,51.53,8.37\r\r\n30.2,30.8213392178,-2.5973286419,follow,-5.29,50.94,9.55\r\r\n30.3,30.5616063537,-2.6666657661,follow,-5.41,50.43,11.41\r\r\n30.4,30.294939777,-2.4591817089,follow,-5.43,50.02,9.14\r\r\n30.5,30.0490216062,-2.6629345368,follow,-5.58,49.49,9.47\r\r\n30.6,29.7827281525,-2.6838977196,follow,-5.68,49.00,13.60\r\r\n30.7,29.5143383805,-2.267253007,follow,-5.61,48.66,12.37\r\r\n30.8,29.2876130798,-2.1967420198,follow,-5.64,48.29,10.41\r\r\n30.9,29.0679388778,-2.3599912229,follow,-5.75,47.85,13.08\r\r\n31.0,28.8319397556,-2.1690808138,follow,-5.74,47.51,11.36\r\r\n31.1,28.6150316742,-2.2373967994,follow,-5.81,47.11,11.88\r\r\n31.2,28.3912919942,-2.2109607331,follow,-5.85,46.74,14.55\r\r\n31.3,28.1701959209,-2.1089946538,follow,-5.82,46.44,10.10\r\r\n31.4,27.9592964555,-2.2516622452,follow,-5.94,46.00,10.83\r\r\n31.5,27.734130231,-2.3035910834,follow,-6.00,45.60,14.46\r\r\n"]
