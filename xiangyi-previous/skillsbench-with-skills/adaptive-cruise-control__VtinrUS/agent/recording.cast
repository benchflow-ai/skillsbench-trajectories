[149.484483, "i", "awk -F',' 'NR>1 && $3!=\"\" {print $1\",\"$3\",\"$4}' sensor_data.csv | tail -30\n"]
[149.48488, "o", "awk -F',' 'NR>1 && $3!=\"\" {print $1\",\"$3\",\"$4}' sensor_data.csv | tail -30\r\n\u001b[?2004l\r"]
[149.486579, "o", "127.0,30.12,81.42\r\n127.1,29.39,74.77\r\n127.2,30.76,85.65\r\n127.3,29.41,86.5\r\n127.4,29.6,87.95\r\n127.5,28.3,88.95\r\n127.6,29.59,95.1\r\n127.7,27.82,96.67\r\n127.8,28.57,93.77\r\n127.9,30.68,99.2\r\n128.0,30.71,97.09\r\n128.1,30.38,97.78\r\n128.2,29.13,102.04\r\n128.3,29.96,108.74\r\n128.4,30.0,111.09\r\n128.5,28.96,111.69\r\n128.6,31.35,114.44\r\n128.7,30.79,115.77\r\n128.8,29.8,113.77\r\n128.9,30.02,119.53\r\n129.0,30.19,122.88\r\n129.1,28.16,124.76\r\n129.2,29.78,128.42\r\n129.3,29.39,128.68\r\n129.4,29.1,129.35\r\n129.5,29.75,134.17\r\n129.6,31.62,131.89\r\n129.7,30.58,130.45\r\n129.8,29.49,135.33\r\n129.9,30.52,134.92\r\n"]
