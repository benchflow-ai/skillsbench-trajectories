[134.670597, "o", "\u001b[?2004h> "]
[134.670909, "o", "        self.min_distance = config['acc_settings']['min_distance']\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.670937, "o", "> "]
[134.671424, "o", "        self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']\r\n\u001b[?2004l\r"]
[134.671449, "o", "\u001b[?2004h> "]
[134.671545, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
