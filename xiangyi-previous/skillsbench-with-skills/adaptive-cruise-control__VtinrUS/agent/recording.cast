[85.783791, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[86.104912, "i", "cat > simulation.py << 'EOF'\n\"\"\"ACC Simulation runner.\"\"\"\n\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\n\ndef load_yaml(filepath):\n    \"\"\"Load YAML configuration file.\"\"\"\n    with open(filepath, 'r') as f:\n        return yaml.safe_load(f)\n\n\ndef load_sensor_data(filepath):\n    \"\"\"Load sensor data from CSV file.\"\"\"\n    data = []\n    with open(filepath, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            entry = {\n                'time': float(row['time']),\n                'lead_speed': float(row['lead_speed']) if row['lead_speed'] else None,\n                'distance': float(row['distance']) if row['distance'] else None\n            }\n            data.append(entry)\n    return data\n\n\ndef run_simulation():\n    \"\"\"Run the ACC simulation.\"\"\"\n    # Load configurations\n    vehicle_config = load_yaml('vehicle_params.yaml')\n    tuning_config = load_yaml('tuning_results.yaml')\n    \n    # Load sensor data for lead vehicle information\n    sensor_data = load_sensor_data('sensor_data.csv')\n    \n    # Initialize ACC system\n    acc = AdaptiveCruiseControl(vehicle_config)\n    \n    # Update with tuned PID gains\n    acc.set_pid_gains(tuning_config['pid_speed'], tuning_config['pid_distance'])\n    \n    # Simulation parameters\n    dt = vehicle_config['simulation']['dt']\n    max_accel = vehicle_config['vehicle']['max_acceleration']\n    max_decel = vehicle_config['vehicle']['max_deceleration']\n    \n    # Initial state\n    ego_speed = 0.0\n    \n    # Results storage\n    results = []\n    \n    # Run simulation for each timestep\n    for i, sensor in enumerate(sensor_data):\n        time = sensor['time']\n        lead_speed = sensor['lead_speed']\n        lead_distance = sensor['distance']\n        \n        # Compute ACC command\n        accel_cmd, mode, distance_error = acc.compute(\n            ego_speed, lead_speed, lead_distance, dt\n        )\n        \n        # Calculate TTC if lead vehicle present\n        if lead_speed is not None and lead_distance is not None:\n            ttc = acc.compute_ttc(ego_speed, lead_speed, lead_distance)\n            if ttc == float('inf'):\n                ttc_str = ''\n            else:\n                ttc_str = f'{ttc:.2f}'\n            distance_str = f'{lead_distance:.2f}'\n            dist_error_str = f'{distance_error:.2f}' if distance_error is not None else ''\n        else:\n            ttc_str = ''\n            distance_str = ''\n            dist_error_str = ''\n        \n        # Store result\n        results.append({\n            'time': time,\n            'ego_speed': ego_speed,\n            'acceleration_cmd': accel_cmd,\n            'mode': mode,\n            'distance_error': dist_error_str,\n            'distance': distance_str,\n            'ttc': ttc_str\n        })\n        \n        # Update ego speed for next timestep (simple integration)\n        ego_speed = ego_speed + accel_cmd * dt\n        \n        # Clamp speed to non-negative\n        ego_speed = max(0.0, ego_speed)\n    \n    # Write results to CSV\n    with open('simulation_results.csv', 'w', newline='') as f:\n        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \n                      'distance_error', 'distance', 'ttc']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        writer.writerows(results)\n    \n    print(f\"Simulation complete. Results saved to simulation_results.csv\")\n    print(f\"Total timesteps: {len(results)}\")\n    \n    # Calculate and print performance metrics\n    analyze_results(results, vehicle_config)\n\n\ndef analyze_results(results, config):\n    \"\"\"Analyze simulation results and print metrics.\"\"\"\n    set_speed = config['acc_settings']['set_speed']\n    min_gap = config['acc_settings']['min_distance']\n    \n    # Find rise time (time to reach 90% of set speed)\n    rise_time = None\n    for r in results:\n        if r['ego_speed'] >= 0.9 * set_speed:\n            rise_time = r['time']\n            break\n    \n    # Find max speed (for overshoot calculation)\n    max_speed = max(r['ego_speed'] for r in results)\n    overshoot = ((max_speed - set_speed) / s"]
[86.104979, "i", "et_speed) * 100 if max_speed > set_speed else 0\n    \n    # Calculate steady-state speed error (last 10 seconds of cruise before lead appears)\n    cruise_speeds = [r['ego_speed'] for r in results if r['mode'] == 'cruise' and r['time'] > 20 and r['time'] < 30]\n    if cruise_speeds:\n        ss_speed_error = abs(set_speed - sum(cruise_speeds) / len(cruise_speeds))\n    else:\n        ss_speed_error = 0\n    \n    # Find minimum distance during follow mode\n    follow_distances = [float(r['distance']) for r in results if r['distance'] and r['mode'] in ['follow', 'emergency']]\n    min_distance = min(follow_distances) if follow_distances else float('inf')\n    \n    # Calculate distance steady-state error\n    dist_errors = [float(r['distance_error']) for r in results if r['distance_error']]\n    if dist_errors:\n        # Use last portion of follow mode for steady-state\n        last_errors = dist_errors[-100:] if len(dist_errors) > 100 else dist_errors\n        ss_dist_error = abs(sum(last_errors) / len(last_errors))\n    else:\n        ss_dist_error = 0\n    \n    print(f\"\\n=== Performance Metrics ===\")\n    print(f\"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s\" if rise_time else \"Rise time: N/A\")\n    print(f\"Maximum speed: {max_speed:.2f} m/s\")\n    print(f\"Speed overshoot: {overshoot:.2f}%\")\n    print(f\"Steady-state speed error: {ss_speed_error:.3f} m/s\")\n    print(f\"Minimum following distance: {min_distance:.2f} m\")\n    print(f\"Steady-state distance error: {ss_dist_error:.2f} m\")\n    \n    # Check against targets\n    print(f\"\\n=== Target Compliance ===\")\n    print(f\"Rise time < 10s: {'PASS' if rise_time and rise_time < 10 else 'FAIL'}\")\n    print(f\"Overshoot < 5%: {'PASS' if overshoot < 5 else 'FAIL'}\")\n    print(f\"Speed SS error < 0.5 m/s: {'PASS' if ss_speed_error < 0.5 else 'FAIL'}\")\n    print(f\"Distance SS error < 2m: {'PASS' if ss_dist_error < 2 else 'FAIL'}\")\n    print(f\"Min distance > 5m: {'PASS' if min_distance > 5 else 'FAIL'}\")\n\n\nif __name__ == '__main__':\n    run_simulation()\nEOF\n"]
