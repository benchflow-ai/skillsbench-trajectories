[134.672848, "o", "\u001b[?2004h> "]
[134.673144, "o", "            speed_pid['kp'], speed_pid['ki'], speed_pid['kd']\r\n\u001b[?2004l\r"]
[134.673171, "o", "\u001b[?2004h> "]
[134.673236, "o", "        )\r\n\u001b[?2004l\rf\u001b[?2004h> "]
[134.673489, "o", "        self.distance_controller = PIDController(\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.673518, "o", "> "]
[134.673819, "o", "            dist_pid['kp'], dist_pid['ki'], dist_pid['kd']\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.673876, "o", "> "]
[134.673915, "o", "        )\r\n\u001b[?2004l\r"]
[134.673964, "o", "\u001b[?2004h> "]
[134.674012, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.674149, "o", "        self.prev_mode = 'cruise'\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.674197, "o", "> "]
[134.674245, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.674477, "o", "    def set_pid_gains(self, speed_gains, distance_gains):\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.674521, "o", "> "]
[134.674566, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.67478, "o", "        Update PID gains for both controllers.\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.674833, "o", "> "]
[134.674881, "o", "        \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[134.674924, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.674969, "o", "> "]
[134.675365, "o", "            speed_gains: dict with 'kp', 'ki', 'kd' for speed controller\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.675392, "o", "> "]
[134.675823, "o", "            distance_gains: dict with 'kp', 'ki', 'kd' for distance controller\r\n\u001b[?2004l\r"]
[134.675856, "o", "\u001b[?2004h> "]
[134.675926, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.675976, "o", "> "]
[134.676217, "o", "        self.speed_controller = PIDController(\r\n\u001b[?2004l\r"]
[134.676243, "o", "\u001b[?2004h> "]
[134.676541, "o", "            speed_gains['kp'], speed_gains['ki'], speed_gains['kd']\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.676597, "o", "> "]
[134.676647, "o", "        )\r\n\u001b[?2004l\r2.\u001b[?2004h> "]
[134.676839, "o", "        self.distance_controller = PIDController(\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.67689, "o", "> "]
[134.677123, "o", "            distance_gains['kp'], distance_gains['ki'], distance_gains['kd']\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.677168, "o", "> "]
[134.677216, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.677264, "o", "    \r\n\u001b[?2004l\r"]
[134.677314, "o", "\u001b[?2004h> "]
[134.677569, "o", "    def compute_desired_distance(self, ego_speed):\r\n\u001b[?2004l\r"]
[134.677596, "o", "\u001b[?2004h> "]
[134.677657, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.67802, "o", "        Compute desired following distance based on time headway.\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.678069, "o", "> "]
[134.678155, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.678204, "o", ">         Args:\r\n\u001b[?2004l\r"]
[134.678235, "o", "\u001b[?2004h> "]
[134.678567, "o", "            ego_speed: Current ego vehicle speed in m/s\r\n\u001b[?2004l\r"]
[134.678622, "o", "\u001b[?2004h> "]
[134.678681, "o", "        \r\n\u001b[?2004l\red_\u001b[?2004h> "]
[134.678814, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.679054, "o", "            float: Desired following distance in meters\r\n\u001b[?2004l\r"]
[134.679088, "o", "\u001b[?2004h> "]
[134.679164, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.679425, "o", "        return self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.679455, "o", ">     \r\n\u001b[?2004l\r"]
[134.679528, "o", "\u001b[?2004h> "]
[134.679738, "o", "    def compute_ttc(self, ego_speed, lead_speed, distance):\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.679796, "o", "> "]
[134.679825, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.679947, "o", "        Compute Time-To-Collision.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.679976, "o", "        \r\n\u001b[?2004l\r"]
[134.680003, "o", "\u001b[?2004h> "]
[134.680085, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.680218, "o", "            ego_speed: Ego vehicle speed in m/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.680371, "o", "            lead_speed: Lead vehicle speed in m/s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.680549, "o", "            distance: Distance to lead vehicle in meters\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.680617, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.680663, "o", "        Returns:\r\n\u001b[?2004l\r"]
[134.68069, "o", "\u001b[?2004h> "]
[134.680885, "o", "            float: TTC in seconds, or float('inf') if not approaching\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.680944, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[134.680984, "o", "\u001b[?2004h> "]
[134.681084, "o", "        relative_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.681112, "o", "> "]
[134.681234, "o", "        if relative_speed <= 0 or distance <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.681279, "o", "> "]
[134.681345, "o", "            return float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.68139, "o", "> "]
[134.681469, "o", "        return distance / relative_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.681514, "o", ">     \r\n\u001b[?2004l\r"]
[134.681562, "o", "\u001b[?2004h> "]
[134.681754, "o", "    def compute(self, ego_speed, lead_speed, distance, dt):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r"]
[134.681836, "o", "\u001b[?2004h> "]
[134.681883, "o", "        Compute ACC control command.\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.681939, "o", "> "]
[134.681989, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.682035, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.682173, "o", "            ego_speed: Current ego vehicle speed in m/s\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.682224, "o", "> "]
[134.682398, "o", "            lead_speed: Lead vehicle speed in m/s (None if no lead vehicle)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.682446, "o", "> "]
[134.682635, "o", "            distance: Distance to lead vehicle in meters (None if no lead vehicle)\r\n\u001b[?2004l\r"]
[134.682685, "o", "\u001b[?2004h> "]
[134.682756, "o", "            dt: Time step in seconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.682801, "o", "> "]
[134.682861, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.682911, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.683063, "o", "            tuple: (acceleration_cmd, mode, distance_error)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.683115, "o", "> "]
[134.68327, "o", "                - acceleration_cmd: Commanded acceleration in m/s^2\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.683316, "o", "> "]
[134.683454, "o", "                - mode: 'cruise', 'follow', or 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.68368, "o", "                - distance_error: Distance error in meters (None in cruise mode)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.683743, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.683782, "o", "> "]
[134.683878, "o", "        # Cruise mode - no lead vehicle detected\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.683926, "o", "> "]
[134.684036, "o", "        if lead_speed is None or distance is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.684081, "o", "> "]
[134.684225, "o", "            # Reset distance controller when switching to cruise\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.684277, "o", "> "]
[134.684356, "o", "            if self.prev_mode != 'cruise':\r\n\u001b[?2004l\r"]
[134.684408, "o", "\u001b[?2004h> "]
[134.684508, "o", "                self.distance_controller.reset()\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.684584, "o", "> "]
[134.684774, "o", "                self.speed_controller.reset()  # Also reset speed controller to avoid windup\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.684819, "o", "> "]
[134.684873, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.684994, "o", "            speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r"]
[134.68504, "o", "\u001b[?2004h> "]
[134.685203, "o", "            accel_cmd = self.speed_controller.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.685248, "o", "> "]
[134.685302, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.685351, "o", "> "]
[134.685401, "o", "            # Clamp acceleration\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.685446, "o", "> "]
[134.685613, "o", "            accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.685658, "o", "> "]
[134.68571, "o", "            self.prev_mode = 'cruise'\r\n\u001b[?2004l\r"]
[134.685765, "o", "\u001b[?2004h> "]
[134.68586, "o", "            return (accel_cmd, 'cruise', None)\r\n\u001b[?2004l\r"]
[134.685908, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[134.685954, "o", "\u001b[?2004h> "]
[134.686048, "o", "        # Calculate TTC for emergency detection\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.686102, "o", "> "]
[134.686215, "o", "        ttc = self.compute_ttc(ego_speed, lead_speed, distance)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.686269, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.686401, "o", "        # Emergency mode - TTC below threshold\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.686513, "o", "        if ttc < self.emergency_ttc_threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.686667, "o", "            desired_dist = self.compute_desired_distance(ego_speed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.686714, "o", "> "]
[134.686815, "o", "            distance_error = distance - desired_dist\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.686967, "o", "            # Apply strong braking proportional to urgency\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.687023, "o", "> "]
[134.687092, "o", "            accel_cmd = self.max_deceleration\r\n\u001b[?2004l\r"]
[134.687145, "o", "\u001b[?2004h> "]
[134.687213, "o", "            self.prev_mode = 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.687241, "o", "> "]
[134.687369, "o", "            return (accel_cmd, 'emergency', distance_error)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.687396, "o", "> "]
[134.687456, "o", "        \r\n\u001b[?2004l\r"]
[134.687521, "o", "\u001b[?2004h> "]
[134.687612, "o", "        # Reset controllers when switching from cruise to follow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.687692, "o", "        if self.prev_mode == 'cruise':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.687746, "o", "            self.distance_controller.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.687796, "o", "            self.speed_controller.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.687824, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.68793, "o", "        # Follow mode - maintain safe following distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688095, "o", "        desired_distance = self.compute_desired_distance(ego_speed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688173, "o", "        distance_error = distance - desired_distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688237, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         # Use a combined approach:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.688292, "o", "> "]
[134.688407, "o", "        # 1. Distance-based control for gap maintenance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688482, "o", "        # 2. Speed matching to reduce relative velocity\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.688558, "o", ">         # Distance control\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688731, "o", "        dist_accel = self.distance_controller.compute(distance_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688778, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.688936, "o", "        # Speed matching with lead vehicle (capped at set_speed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.688995, "o", "> "]
[134.689084, "o", "        target_speed = min(lead_speed, self.set_speed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.689145, "o", "> "]
[134.689211, "o", "        speed_error = target_speed - ego_speed\r\n\u001b[?2004l\r"]
[134.689261, "o", "\u001b[?2004h> "]
[134.689392, "o", "        speed_accel = self.speed_controller.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.68944, "o", ">         \r\n"]
[134.689494, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[134.689591, "o", "        # Combine controls based on distance error\r\n\u001b[?2004l\r"]
[134.689638, "o", "\u001b[?2004h> "]
[134.689735, "o", "        if distance_error < -5:  # Much too close\r\n\u001b[?2004l\r"]
[134.689793, "o", "\u001b[?2004h> "]
[134.689943, "o", "            accel_cmd = min(dist_accel, speed_accel, -2.0)  # Ensure braking\r\n\u001b[?2004l\r"]
[134.689988, "o", "\u001b[?2004h> "]
[134.690111, "o", "        elif distance_error < 0:  # Slightly too close\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.690157, "o", "> "]
[134.690289, "o", "            accel_cmd = 0.7 * dist_accel + 0.3 * speed_accel\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.690345, "o", "> "]
[134.690483, "o", "        elif distance_error > 10:  # Far behind, can accelerate more\r\n\u001b[?2004l\r"]
[134.690512, "o", "\u001b[?2004h> "]
[134.690675, "o", "            accel_cmd = 0.5 * dist_accel + 0.5 * speed_accel\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.690726, "o", "> "]
[134.690782, "o", "        else:  # Good distance range\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.690829, "o", "> "]
[134.690945, "o", "            accel_cmd = 0.4 * dist_accel + 0.6 * speed_accel\r\n\u001b[?2004l\r"]
[134.69099, "o", "\u001b[?2004h> "]
[134.691042, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.691107, "o", "        # Clamp acceleration\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.691153, "o", "> "]
[134.691428, "o", "        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[134.691515, "o", "\u001b[?2004h> "]
[134.691585, "o", "        self.prev_mode = 'follow'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.691678, "o", "        return (accel_cmd, 'follow', distance_error)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.691729, "o", "EOF\r\n\u001b[?2004l\r"]
[134.693159, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
[135.184051, "i", "python3 simulation.py\n"]
[135.184281, "o", "python3 simulation.py\r\n\u001b[?2004l\r"]
[135.242853, "o", "Simulation complete. Results saved to simulation_results.csv\r\nTotal timesteps: 1501\r\n"]
[135.243574, "o", "\r\n=== Performance Metrics ===\r\nRise time (to 90% of 30.0 m/s): 9.0s\r\nMaximum speed: 46.41 m/s\r\nSpeed overshoot: 54.71%\r\n"]
[135.243605, "o", "Steady-state speed error: 3.869 m/s\r\nMinimum following distance: 1.95 m\r\nSteady-state distance error: 10.24 m\r\n\r\n=== Target Compliance ===\r\nRise time < 10s: PASS\r\nOvershoot < 5%: FAIL\r\nSpeed SS error < 0.5 m/s: FAIL\r\n"]
[135.243659, "o", "Distance SS error < 2m: FAIL\r\nMin distance > 5m: FAIL\r\n"]
[135.250347, "o", "\u001b[?2004hroot@5872ab224e04:~# "]
