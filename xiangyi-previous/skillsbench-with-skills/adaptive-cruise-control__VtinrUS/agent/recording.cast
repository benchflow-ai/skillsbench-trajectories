[387.320384, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[387.320553, "o", "\u001b[?2004h> "]
[387.322122, "o", "        for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h>             entry = {\r\n\u001b[?2004l\r\u001b[?2004h>                 'time': float(row['time']),\r\n\u001b[?2004l\r\u001b[?2004h>                 'ref_ego_speed': float(row['ego_speed']) if row['ego_speed'] else 0.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.331028, "o", "                'lead_speed': float(row['lead_speed']) if row['lead_speed'] else None,\r\n\u001b[?2004l\r"]
[387.331067, "o", "\u001b[?2004h> "]
[387.331512, "o", "                'ref_distance': float(row['distance']) if row['distance'] else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.331543, "o", "> "]
[387.331624, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.33165, "o", "> "]
[387.331756, "o", "            data.append(entry)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.331783, "o", "> "]
[387.331866, "o", "    return data"]
[387.331909, "o", "\r\n\u001b[?2004l\r"]
[387.331952, "o", "\u001b[?2004h> "]
[387.331979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.332014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.332042, "o", "> "]
[387.332119, "o", "def run_simulation():\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.332141, "o", "> "]
[387.332349, "o", "    \"\"\"Run the ACC simulation with proper position tracking.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.332375, "o", "> "]
[387.332461, "o", "    # Load configurations\r\n\u001b[?2004l\r"]
[387.332485, "o", "\u001b[?2004h> "]
[387.333599, "o", "    vehicle_config = load_yaml('vehicle_params.yaml')\r\n\u001b[?2004l\r\u001b[?2004h>     tuning_config = load_yaml('tuning_results.yaml')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Load sensor data for lead vehicle information\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.333696, "o", "    sensor_data = load_sensor_data('sensor_data.csv')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[387.33373, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[387.336612, "o", "    # Initialize ACC system\r\n\u001b[?2004l\r\u001b[?2004h>     acc = AdaptiveCruiseControl(vehicle_config)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Update with tuned PID gains\r\n\u001b[?2004l\r\u001b[?2004h>     acc.set_pid_gains(tuning_config['pid_speed'], tuning_config['pid_distance'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Simulation parameters\r\n\u001b[?2004l\r\u001b[?2004h>     dt = vehicle_config['simulation']['dt']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Initial state - ego vehicle\r\n\u001b[?2004l\r\u001b[?2004h>     ego_speed = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     ego_position = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Lead vehicle state\r\n\u001b[?2004l\r\u001b[?2004h>     lead_position = None\r\n\u001b[?2004l\r \u001b[?2004h>     lead_active = False\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r['\u001b[?2004h>     # Results storage\r\n\u001b[?2004l\r\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\r\n\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Run simulation\r\n\u001b[?2004l\r\u001b[?2004h>     for i, sensor in enumerate(sensor_data):\r\n\u001b[?2004l\r\u001b[?2004h>         time = sensor['time']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.336766, "o", "        lead_speed = sensor['lead_speed']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.336847, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.340576, "o", "        # Handle lead vehicle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.340668, "o", "        if lead_speed is not None:\r\n\u001b[?2004l\r"]
[387.340731, "o", "\u001b[?2004h> "]
[387.341075, "o", "            if not lead_active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.341554, "o", "                initial_distance = sensor['ref_distance'] if sensor['ref_distance'] else 50.0\r\n\u001b[?2004l\r"]
[387.341597, "o", "\u001b[?2004h> "]
[387.341933, "o", "                lead_position = ego_position + initial_distance\r\n\u001b[?2004l\r"]
[387.342003, "o", "\u001b[?2004h> "]
[387.342165, "o", "                lead_active = True\r\n\u001b[?2004l\r"]
[387.342224, "o", "\u001b[?2004h> "]
[387.34249, "o", "            distance = lead_position - ego_position\r\n\u001b[?2004l\r "]
[387.342552, "o", "\u001b[?2004h> "]
[387.342621, "o", "        else:\r\n\u001b[?2004l\r"]
[387.342683, "o", "\u001b[?2004h> "]
[387.342844, "o", "            lead_active = False\r\n\u001b[?2004l\r"]
[387.342919, "o", "\u001b[?2004h> "]
[387.343069, "o", "            lead_position = None\r\n\u001b[?2004l\r"]
[387.343107, "o", "\u001b[?2004h> "]
[387.343208, "o", "            distance = None\r\n\u001b[?2004l\r"]
[387.343298, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.343467, "o", "        # Compute ACC command\r\n\u001b[?2004l\r"]
[387.343488, "o", "\u001b[?2004h> "]
[387.343638, "o", "        accel_cmd, mode, distance_error = acc.compute(\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.343807, "o", "> "]
[387.343855, "o", "            ego_speed, lead_speed, distance, dt\r\n\u001b[?2004l\r"]
[387.343982, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r2\u001b[?2004h> "]
[387.344023, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.344152, "o", "        # Format output strings\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.344183, "o", "> "]
[387.344413, "o", "        if lead_speed is not None and distance is not None:\r\n\u001b[?2004l\r"]
[387.344438, "o", "\u001b[?2004h"]
[387.344461, "o", "> "]
[387.344699, "o", "            ttc = acc.compute_ttc(ego_speed, lead_speed, distance)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.345409, "o", "            ttc_str = '' if ttc == float('inf') else f'{ttc:.2f}'\r\n\u001b[?2004l\r"]
[387.345435, "o", "\u001b[?2004h> "]
[387.34569, "o", "            distance_str = f'{distance:.2f}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.346337, "o", "            dist_error_str = f'{distance_error:.2f}' if distance_error is not None else ''\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             ttc_str = ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.346407, "o", "            distance_str = ''\r\n\u001b[?2004l\r"]
[387.346498, "o", "\u001b[?2004h> "]
[387.346578, "o", "            dist_error_str = ''"]
[387.346645, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.346669, "o", "> "]
[387.346723, "o", "        \r\n\u001b[?2004l\r"]
[387.346746, "o", "\u001b[?2004h> "]
[387.346863, "o", "        results.append({\r\n\u001b[?2004l\r"]
[387.346889, "o", "\u001b[?2004h> "]
[387.347015, "o", "            'time': time,\r\n\u001b[?2004l\r"]
[387.347041, "o", "\u001b[?2004h> "]
[387.347234, "o", "            'ego_speed': round(ego_speed, 10),\r\n\u001b[?2004l\r"]
[387.347259, "o", "\u001b[?2004h> "]
[387.347379, "o", "            'acceleration_cmd': round(accel_cmd, 10),\r\n\u001b[?2004l\r"]
[387.347403, "o", "\u001b[?2004h> "]
[387.347475, "o", "            'mode': mode,\r\n\u001b[?2004l\r"]
[387.3475, "o", "\u001b[?2004h> "]
[387.347607, "o", "            'distance_error': dist_error_str,\r\n\u001b[?2004l\r"]
[387.347632, "o", "\u001b[?2004h> "]
[387.347727, "o", "            'distance': distance_str,\r\n\u001b[?2004l\r"]
[387.347783, "o", "\u001b[?2004h> "]
[387.34783, "o", "            'ttc': ttc_str\r\n\u001b[?2004l\r"]
[387.347878, "o", "\u001b[?2004h>         })\r\n"]
[387.347924, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[387.34797, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.348036, "o", "        # Update states\r\n\u001b[?2004l\r"]
[387.348093, "o", "\u001b[?2004h> "]
[387.348196, "o", "        ego_speed = max(0.0, ego_speed + accel_cmd * dt)\r\n\u001b[?2004l\r"]
[387.348244, "o", "\u001b[?2004h> "]
[387.348319, "o", "        ego_position += ego_speed * dt\r\n\u001b[?2004l\r"]
[387.348366, "o", "\u001b[?2004h>         "]
[387.348411, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.348536, "o", "        if lead_active and lead_speed is not None:\r\n\u001b[?2004l\r"]
[387.348575, "o", "\u001b[?2004h> "]
[387.348727, "o", "            lead_position += lead_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.348839, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Write results\r\n\u001b[?2004l\r"]
[387.348909, "o", "\u001b[?2004h> "]
[387.348969, "o", "    with open('simulation_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[387.349011, "o", "\u001b[?2004h> "]
[387.349163, "o", "        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', \r\n\u001b[?2004l\r"]
[387.349243, "o", "\u001b[?2004h"]
[387.349307, "o", "> "]
[387.34938, "o", "                      'distance_error', 'distance', 'ttc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.349588, "o", "        writer = csv.DictWriter(f, fieldnames=fieldnames)"]
[387.34965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.349703, "o", "> "]
[387.349777, "o", "        writer.writeheader()\r\n\u001b[?2004l\r"]
[387.349836, "o", "\u001b[?2004h> "]
[387.349901, "o", "        writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.349958, "o", ">     \r\n\u001b[?2004l\r"]
[387.350055, "o", "\u001b[?2004h"]
[387.350102, "o", "> "]
[387.350256, "o", "    print(f\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r"]
[387.350306, "o", "\u001b[?2004h> "]
[387.3504, "o", "    print(f\"Total timesteps: {len(results)}\")\r\n\u001b[?2004l\r"]
[387.350496, "o", "\u001b[?2004h> "]
[387.350531, "o", "    \r\n\u001b[?2004l\r"]
[387.350744, "o", "\u001b[?2004h>     analyze_results(results, vehicle_config)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.350896, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.350933, "o", "def analyze_results(results, config):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.351079, "o", "    \"\"\"Analyze simulation results and print metrics.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.351141, "o", "    set_speed = config['acc_settings']['set_speed']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.351219, "o", "    # Rise time (to 90% of set speed)\r\n\u001b[?2004l\r"]
[387.351266, "o", "\u001b[?2004h> "]
[387.351402, "o", "    rise_time = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.351461, "o", "    for r in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.3515, "o", "        if r['ego_speed'] >= 0.9 * set_speed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.35164, "o", "            rise_time = r['time']\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[387.351702, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[387.351763, "o", "> "]
[387.351837, "o", "    # Max speed during initial cruise (before t=30)\r\n\u001b[?2004l\r"]
[387.351898, "o", "\u001b[?2004h> "]
[387.352119, "o", "    cruise_speeds = [r['ego_speed'] for r in results if r['time'] < 30]\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.352187, "o", "> "]
[387.352337, "o", "    max_cruise_speed = max(cruise_speeds) if cruise_speeds else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.352423, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.352479, "o", "    # Overshoot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.352812, "o", "    overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0\r\n\u001b[?2004l\r"]
[387.352919, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.352995, "o", "    # Speed SS error (t=25-29s before lead appears)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.353062, "o", "> "]
[387.353125, "o", "    ss_cruise = [r['ego_speed'] for r in results if 25 <= r['time'] < 30]\r\n\u001b[?2004l\r"]
[387.353191, "o", "\u001b[?2004h> "]
[387.353379, "o", "    ss_speed_error = abs(set_speed - sum(ss_cruise) / len(ss_cruise)) if ss_cruise else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.353455, "o", ">     \r\n\u001b[?2004l\r"]
[387.353524, "o", "\u001b[?2004h> "]
[387.353691, "o", "    # Also check final cruise (t=140-150)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.353983, "o", "    final_cruise = [r['ego_speed'] for r in results if r['time'] >= 140 and r['mode'] == 'cruise']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.35408, "o", "    if final_cruise:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.354414, "o", "        final_ss = abs(set_speed - sum(final_cruise) / len(final_cruise))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.354511, "o", "        ss_speed_error = max(ss_speed_error, final_ss)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.35464, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.354768, "o", "    # Min distance during follow mode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.354904, "o", "    follow_dist = []\r\n\u001b[?2004l\r\u001b[?2004h>     for r in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.355089, "o", "        if r['distance'] and r['mode'] in ['follow', 'emergency']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.355195, "o", "            try:\r\n\u001b[?2004l\r"]
[387.355263, "o", "\u001b[?2004h> "]
[387.355345, "o", "                follow_dist.append(float(r['distance']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.355416, "o", ">             except:\r\n\u001b[?2004l\r"]
[387.355494, "o", "\u001b[?2004h> "]
[387.355565, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.355701, "o", "    min_distance = min(follow_dist) if follow_dist else float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.35576, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.355863, "o", "    # Distance SS error - use stable middle portion of follow mode (t=50-100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.355914, "o", ">     dist_errors = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.355956, "o", "> "]
[387.356003, "o", "    for r in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.356076, "o", "        if r['distance_error'] and 50 <= r['time'] <= 100:\r\n\u001b[?2004l\r"]
[387.35613, "o", "\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[387.356168, "o", "\u001b[?2004h> "]
[387.356245, "o", "                dist_errors.append(float(r['distance_error']))\r\n\u001b[?2004l\r"]
[387.356298, "o", "\u001b[?2004h>             except:\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.356346, "o", ">                 pass\r\n\u001b[?2004l\r"]
[387.356395, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.356443, "o", "    if dist_errors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.356565, "o", "        ss_dist_error = abs(sum(dist_errors) / len(dist_errors))\r\n\u001b[?2004l\r"]
[387.35662, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.356699, "o", "        # Fallback to all follow mode data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.356846, "o", "        all_errors = [float(r['distance_error']) for r in results if r['distance_error']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.357017, "o", "        ss_dist_error = abs(sum(all_errors) / len(all_errors)) if all_errors else 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[387.357092, "o", "\u001b[?2004h>     print(f\"\\n=== Performance Metrics ===\")\r\n\u001b[?2004l\r"]
[387.357143, "o", "\u001b[?2004h>     if rise_time:\r\n"]
[387.357189, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[387.357295, "o", "        print(f\"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.357341, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.357413, "o", "        print(\"Rise time: N/A\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.357505, "o", "    print(f\"Maximum cruise speed: {max_cruise_speed:.2f} m/s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.357549, "o", "> "]
[387.357591, "o", "    print(f\"Speed overshoot: {overshoot:.2f}%\")\r\n\u001b[?2004l\r"]
[387.357632, "o", "\u001b[?2004h> "]
[387.357704, "o", "    print(f\"Steady-state speed error: {ss_speed_error:.3f} m/s\")\r\n\u001b[?2004l\r"]
[387.357745, "o", "\u001b[?2004h> "]
