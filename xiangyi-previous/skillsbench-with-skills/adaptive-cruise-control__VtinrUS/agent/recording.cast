[53.661666, "o", "        self.prev_error = None\r\n\u001b[?2004l\r"]
[53.661695, "o", "\u001b[?2004h> "]
[53.661801, "o", "        self.prev_derivative = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.661865, "o", "    def compute(self, error, dt):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r"]
[53.661896, "o", "\u001b[?2004h> "]
