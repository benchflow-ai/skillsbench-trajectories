[?2004l[?2004h> """PID Controller implementation for ACC system."""
[?2004l[?2004h> 
[?2004l[?2004h> class PIDController:
[?2004l[?2004h>     """A PID controller with anti-windup and derivative filtering."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, kp, ki, kd):
[?2004l[?2004h>         """
[?2004l[?2004h>         Initialize PID controller with gains.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             kp: Proportional gain
[?2004l[?2004h>             ki: Integral gain
[?2004l[?2004h>             kd: Derivative gain
[?2004l[?2004h>         """
[?2004l[?2004h>         self.kp = kp
[?2004l[?2004h>         self.ki = ki
[?2004l[?2004h>         self.kd = kd
[?2004l[?2004h>         self.reset()
[?2004l[?2004h>     
[?2004l[?2004h>     def reset(self):
[?2004l[?2004h>         """Reset the controller state."""
[?2004l[?2004h>         self.integral = 0.0
[?2004l[?2004h>         self.prev_error = None
[?2004l[?2004h>         self.prev_derivative = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     def compute(self, error, dt):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute PID control output.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             error: Current error (setpoint - measured)
[?2004l[?2004h>             dt: Time step in seconds
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             float: Control output
[?2004l[?2004h>         """
[?2004l[?2004h>         if dt <= 0:
[?2004l[?2004h>             return 0.0
[?2004l[?2004h>         
[?2004l[?2004h>         # Proportional term
[?2004l[?2004h>         p_term = self.kp * error
[?2004l[?2004h>         
[?2004l[?2004h>         # Integral term with anti-windup
[?2004l[?2004h>         self.integral += error * dt
[?2004l[?2004h>         # Clamp integral to prevent windup
[?2004l[?2004h>         max_integral = 50.0 / (self.ki + 1e-10)
[?2004l[?2004h>         self.integral = max(-max_integral, min(max_integral, self.integral))
[?2004l[?2004h>         i_term = self.ki * self.integral
[?2004l[?2004h>         
[?2004l[?2004h>         # Derivative term with filtering
[?2004l[?2004h>         if self.prev_error is None:
[?2004l[?2004h>             derivative = 0.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             derivative = (error - self.prev_error) / dt
[?2004l[?2004h>         
[?2004l[?2004h>         # Low-pass filter on derivative (alpha = 0.2)
[?2004l[?2004h>         alpha = 0.2
[?2004l[?2004h>         filtered_derivative = alpha * derivative + (1 - alpha) * self.prev_derivative
[?2004l[?2004h>         self.prev_derivative = filtered_derivative
[?2004l[?2004h>         d_term = self.kd * filtered_derivative
[?2004l[?2004h>         
[?2004l[?2004h>         self.prev_error = error
[?2004l[?2004h>         
[?2004l[?2004h>         return p_term + i_term + d_term
[?2004l[?2004h> EOF
[?2004l[?2004hroot@5872ab224e04:~# cat > acc_system.py << 'EOF'
[?2004l[?2004h> """Adaptive Cruise Control system implementation."""
[?2004l[?2004h> 
[?2004lc[?2004h> from pid_controller import PIDController
[?2004l[?2004h> 
[?2004l [?2004h> 
[?2004l[?2004h> class AdaptiveCruiseControl:
[?2004l[?2004h>     """Adaptive Cruise Control with speed and distance control modes."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, config):
[?2004l[?2004h>         """
[?2004l[?2004h>         Initialize ACC system with configuration.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             config: Nested dict from vehicle_params.yaml
[?2004l[?2004h>         """
[?2004l[?2004h>         # Vehicle parameters
[?2004l[?2004h>         self.max_acceleration = config['vehicle']['max_acceleration']
[?2004lma[?2004h>         self.max_deceleration = config['vehicle']['max_deceleration']
[?2004l[?2004h>         
[?2004l[?2004h>         # ACC settings
[?2004l   [?2004h>         self.set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>         self.time_headway = config['acc_settings']['time_headway']
[?2004l[?2004h>         self.min_distance = config['acc_settings']['min_distance']
[?2004l[?2004h>         self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']
[?2004l[?2004h>         
[?2004l[?2004h>         # PID controllers - will be set externally after tuning
[?2004lo[?2004h>         speed_pid = config.get('pid_speed', {'kp': 1.0, 'ki': 0.1, 'kd': 0.05})
[?2004l[?2004h>         dist_pid = config.get('pid_distance', {'kp': 0.5, 'ki': 0.05, 'kd': 0.1})
[?2004l[?2004h>         
[?2004l[?2004h>         self.speed_controller = PIDController(
[?2004l[?2004h>             speed_pid['kp'], speed_pid['ki'], speed_pid['kd']
[?2004lr[?2004h>         )
[?2004l [?2004h>         self.distance_controller = PIDController(
[?2004l[?2004h>             dist_pid['kp'], dist_pid['ki'], dist_pid['kd']
[?2004l[?2004h>         )
[?2004l([?2004h>     
[?2004l[?2004h>     def set_pid_gains(self, speed_gains, distance_gains):
[?2004l[?2004h>         """
[?2004l[?2004h>         Update PID gains for both controllers.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             speed_gains: dict with 'kp', 'ki', 'kd' for speed controller
[?2004l[?2004h>             distance_gains: dict with 'kp', 'ki', 'kd' for distance controller
[?2004l[?2004h>         """
[?2004l[?2004h>         self.speed_controller = PIDController(
[?2004l[?2004h>             speed_gains['kp'], speed_gains['ki'], speed_gains['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>         self.distance_controller = PIDController(
[?2004l[?2004h>             distance_gains['kp'], distance_gains['ki'], distance_gains['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def compute_desired_distance(self, ego_speed):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute desired following distance based on time headway.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Current ego vehicle speed in m/s
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             float: Desired following distance in meters
[?2004l[?2004h>         """
[?2004l[?2004h>         return self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>     
[?2004l[?2004h>     def compute_ttc(self, ego_speed, lead_speed, distance):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute Time-To-Collision.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Ego vehicle speed in m/s
[?2004l[?2004h>             lead_speed: Lead vehicle speed in m/s
[?2004l[?2004h>             distance: Distance to lead vehicle in meters
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             float: TTC in seconds, or float('inf') if not approaching
[?2004l[?2004h>         """
[?2004l[?2004h>         relative_speed = ego_speed - lead_speed
[?2004l[?2004h>         if relative_speed <= 0 or distance <= 0:
[?2004l[?2004h>             return float('inf')
[?2004l[?2004h>         return distance / relative_speed
[?2004l[?2004h>     
[?2004l[?2004h>     def compute(self, ego_speed, lead_speed, distance, dt):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute ACC control command.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Current ego vehicle speed in m/s
[?2004l[?2004h>             lead_speed: Lead vehicle speed in m/s (None if no lead vehicle)
[?2004l[?2004h>             distance: Distance to lead vehicle in meters (None if no lead vehicle)
[?2004l[?2004h>             dt: Time step in seconds
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             tuple: (acceleration_cmd, mode, distance_error)
[?2004l[?2004h>                 - acceleration_cmd: Commanded acceleration in m/s^2
[?2004l[?2004h>                 - mode: 'cruise', 'follow', or 'emergency'
[?2004l[?2004h>                 - distance_error: Distance error in meters (None in cruise mode)
[?2004l[?2004h>         """
[?2004l[?2004h>         # Cruise mode - no lead vehicle detected
[?2004l[?2004h>         if lead_speed is None or distance is None:
[?2004l[?2004h>             speed_error = self.set_speed - ego_speed
[?2004l[?2004h>             accel_cmd = self.speed_controller.compute(speed_error, dt)
[?2004l[?2004h>             # Reset distance controller when in cruise mode
[?2004l[?2004h>             self.distance_controller.reset()
[?2004l[?2004h>             # Clamp acceleration
[?2004l[?2004h>             accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))
[?2004l[?2004h>             return (accel_cmd, 'cruise', None)
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate TTC for emergency detection
[?2004l[?2004h>         ttc = self.compute_ttc(ego_speed, lead_speed, distance)
[?2004l[?2004h>         
[?2004l[?2004h>         # Emergency mode - TTC below threshold
[?2004l[?2004h>         if ttc < self.emergency_ttc_threshold:
[?2004l[?2004h>             # Apply maximum braking
[?2004l[?2004h>             accel_cmd = self.max_deceleration
[?2004l[?2004h>             desired_dist = self.compute_desired_distance(ego_speed)
[?2004l[?2004h>             distance_error = distance - desired_dist
[?2004l[?2004h>             return (accel_cmd, 'emergency', distance_error)
[?2004l[?2004h>         
[?2004l[?2004h>         # Follow mode - maintain safe following distance
[?2004l[?2004h>         desired_distance = self.compute_desired_distance(ego_speed)
[?2004l[?2004h>         distance_error = distance - desired_distance
[?2004l[?2004h>         
[?2004l[?2004h>         # Distance-based acceleration command
[?2004l[?2004h>         dist_accel = self.distance_controller.compute(distance_error, dt)
[?2004l[?2004h>         
[?2004l[?2004h>         # Also consider speed matching with lead vehicle
[?2004l[?2004h>         # Blend distance control with speed matching
[?2004l[?2004h>         speed_error = min(lead_speed, self.set_speed) - ego_speed
[?2004l[?2004h>         speed_accel = self.speed_controller.compute(speed_error, dt)
[?2004l[?2004h>         
[?2004l[?2004h>         # Use distance control primarily, with speed control influence
[?2004l[?2004h>         # When far behind (positive error), allow more acceleration
[?2004l[?2004h>         # When too close (negative error), prioritize braking
[?2004l[?2004h>         if distance_error < 0:
[?2004l[?2004h>             # Too close - prioritize distance control (braking)
[?2004l[?2004h>             accel_cmd = min(dist_accel, speed_accel)
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Safe distance or farther - blend controls
[?2004l[?2004h>             accel_cmd = 0.6 * dist_accel + 0.4 * speed_accel
[?2004l[?2004h>         
[?2004l[?2004h>         # Clamp acceleration
[?2004l[?2004h>         accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))
[?2004l[?2004h>         
[?2004l[?2004h>         return (accel_cmd, 'follow', distance_error)
[?2004l[?2004h> EOF
