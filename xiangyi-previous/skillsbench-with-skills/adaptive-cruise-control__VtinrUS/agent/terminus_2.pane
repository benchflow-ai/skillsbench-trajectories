[?2004l[?2004hroot@5872ab224e04:~# cat > acc_system.py << 'EOF'
[?2004l[?2004h> """Adaptive Cruise Control system implementation."""
[?2004l[?2004h> 
[?2004l [?2004h> from pid_controller import PIDController
[?2004l[?2004h> 
[?2004lm[?2004h> 
[?2004li[?2004h> class AdaptiveCruiseControl:
[?2004l[?2004h>     """Adaptive Cruise Control with speed and distance control modes."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, config):
[?2004l[?2004h>         """
[?2004l[?2004h>         Initialize ACC system with configuration.
[?2004l[?2004h>         
[?2004l([?2004h>         Args:
[?2004l[?2004h>             config: Nested dict from vehicle_params.yaml
[?2004l[?2004h>         """
[?2004l[?2004h>         # Vehicle parameters
[?2004l[?2004h>         self.max_acceleration = config['vehicle']['max_acceleration']
[?2004l[?2004h>         self.max_deceleration = config['vehicle']['max_deceleration']
[?2004l[?2004h>         
[?2004l[?2004h>         # ACC settings
[?2004l[?2004h>         self.set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>         self.time_headway = config['acc_settings']['time_headway']
[?2004l[?2004h>         self.min_distance = config['acc_settings']['min_distance']
[?2004l[?2004h>         self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']
[?2004l[?2004h>         
[?2004l[?2004h>         # PID controllers - will be set externally after tuning
[?2004l[?2004h>         speed_pid = config.get('pid_speed', {'kp': 0.5, 'ki': 0.02, 'kd': 0.1})
[?2004l[?2004h>         dist_pid = config.get('pid_distance', {'kp': 0.3, 'ki': 0.01, 'kd': 1.5})
[?2004l[?2004h>         
[?2004l[?2004h>         self.speed_controller = PIDController(
[?2004l[?2004h>             speed_pid['kp'], speed_pid['ki'], speed_pid['kd']
[?2004l[?2004h>         )
[?2004lf[?2004h>         self.distance_controller = PIDController(
[?2004l[?2004h>             dist_pid['kp'], dist_pid['ki'], dist_pid['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>         
[?2004l[?2004h>         self.prev_mode = 'cruise'
[?2004l[?2004h>     
[?2004l[?2004h>     def set_pid_gains(self, speed_gains, distance_gains):
[?2004l[?2004h>         """
[?2004l[?2004h>         Update PID gains for both controllers.
[?2004l[?2004h>         
[?2004lp[?2004h>         Args:
[?2004l[?2004h>             speed_gains: dict with 'kp', 'ki', 'kd' for speed controller
[?2004l[?2004h>             distance_gains: dict with 'kp', 'ki', 'kd' for distance controller
[?2004l[?2004h>         """
[?2004l[?2004h>         self.speed_controller = PIDController(
[?2004l[?2004h>             speed_gains['kp'], speed_gains['ki'], speed_gains['kd']
[?2004l[?2004h>         )
[?2004l2.[?2004h>         self.distance_controller = PIDController(
[?2004l[?2004h>             distance_gains['kp'], distance_gains['ki'], distance_gains['kd']
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def compute_desired_distance(self, ego_speed):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute desired following distance based on time headway.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Current ego vehicle speed in m/s
[?2004l[?2004h>         
[?2004led_[?2004h>         Returns:
[?2004l[?2004h>             float: Desired following distance in meters
[?2004l[?2004h>         """
[?2004l[?2004h>         return self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>     
[?2004l[?2004h>     def compute_ttc(self, ego_speed, lead_speed, distance):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute Time-To-Collision.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Ego vehicle speed in m/s
[?2004l[?2004h>             lead_speed: Lead vehicle speed in m/s
[?2004l[?2004h>             distance: Distance to lead vehicle in meters
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             float: TTC in seconds, or float('inf') if not approaching
[?2004l[?2004h>         """
[?2004l[?2004h>         relative_speed = ego_speed - lead_speed
[?2004l[?2004h>         if relative_speed <= 0 or distance <= 0:
[?2004l[?2004h>             return float('inf')
[?2004l[?2004h>         return distance / relative_speed
[?2004l[?2004h>     
[?2004l[?2004h>     def compute(self, ego_speed, lead_speed, distance, dt):
[?2004l[?2004h>         """
[?2004l[?2004h>         Compute ACC control command.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             ego_speed: Current ego vehicle speed in m/s
[?2004l[?2004h>             lead_speed: Lead vehicle speed in m/s (None if no lead vehicle)
[?2004l[?2004h>             distance: Distance to lead vehicle in meters (None if no lead vehicle)
[?2004l[?2004h>             dt: Time step in seconds
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             tuple: (acceleration_cmd, mode, distance_error)
[?2004l[?2004h>                 - acceleration_cmd: Commanded acceleration in m/s^2
[?2004l[?2004h>                 - mode: 'cruise', 'follow', or 'emergency'
[?2004l[?2004h>                 - distance_error: Distance error in meters (None in cruise mode)
[?2004l[?2004h>         """
[?2004l[?2004h>         # Cruise mode - no lead vehicle detected
[?2004l[?2004h>         if lead_speed is None or distance is None:
[?2004l[?2004h>             # Reset distance controller when switching to cruise
[?2004l[?2004h>             if self.prev_mode != 'cruise':
[?2004l[?2004h>                 self.distance_controller.reset()
[?2004l[?2004h>                 self.speed_controller.reset()  # Also reset speed controller to avoid windup
[?2004l[?2004h>             
[?2004l[?2004h>             speed_error = self.set_speed - ego_speed
[?2004l[?2004h>             accel_cmd = self.speed_controller.compute(speed_error, dt)
[?2004l[?2004h>             
[?2004l[?2004h>             # Clamp acceleration
[?2004l[?2004h>             accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))
[?2004l[?2004h>             self.prev_mode = 'cruise'
[?2004l[?2004h>             return (accel_cmd, 'cruise', None)
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate TTC for emergency detection
[?2004l[?2004h>         ttc = self.compute_ttc(ego_speed, lead_speed, distance)
[?2004l[?2004h>         
[?2004l[?2004h>         # Emergency mode - TTC below threshold
