[?2004l[?2004h> def analyze_results(results, config):
[?2004l[?2004h>     """Analyze simulation results and print metrics."""
[?2004l[?2004h>     set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>     
[?2004l[?2004h>     # Find rise time (time to reach 90% of set speed for the first time)
[?2004l[?2004h>     rise_time = None
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['ego_speed'] >= 0.9 * set_speed:
[?2004l[?2004h>             rise_time = r['time']
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Find max speed during cruise phase (before lead appears at t=30)
[?2004l[?2004h>     cruise_phase_speeds = [r['ego_speed'] for r in results if r['time'] < 30]
[?2004l[?2004h>     max_cruise_speed = max(cruise_phase_speeds) if cruise_phase_speeds else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Find overall max speed
[?2004l[?2004h>     max_speed = max(r['ego_speed'] for r in results)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate overshoot during initial cruise phase
[?2004l[?2004h>     overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate steady-state speed error (use t=25-29s, just before lead appears)
[?2004l[?2004h>     ss_cruise_speeds = [r['ego_speed'] for r in results if 25 <= r['time'] < 30]
[?2004l[?2004h>     if ss_cruise_speeds:
[?2004l[?2004h>         ss_speed_error = abs(set_speed - sum(ss_cruise_speeds) / len(ss_cruise_speeds))
[?2004l[?2004h>     else:
[?2004l[?2004h>         ss_speed_error = 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Also check final cruise phase (t=140-150s)
[?2004l[?2004h>     final_cruise_speeds = [r['ego_speed'] for r in results if r['time'] >= 140 and r['mode'] == 'cruise']
[?2004l[?2004h>     if final_cruise_speeds:
[?2004l[?2004h>         final_ss_error = abs(set_speed - sum(final_cruise_speeds) / len(final_cruise_speeds))
[?2004l[?2004h>     else:
[?2004l[?2004h>         final_ss_error = ss_speed_error
[?2004l[?2004h>     
[?2004l[?2004h>     # Use the worse of the two for reporting
[?2004l[?2004h>     ss_speed_error = max(ss_speed_error, final_ss_error)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find minimum distance during follow/emergency mode
[?2004l[?2004h>     follow_distances = []
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['distance'] and r['mode'] in ['follow', 'emergency']:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 follow_distances.append(float(r['distance']))
[?2004l[?2004h>             except:
[?2004l[?2004h>                 pass
[?2004l[?2004h>     min_distance = min(follow_distances) if follow_distances else float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate distance steady-state error (last 20s of follow mode)
[?2004l[?2004h>     follow_results = [(r['time'], r['distance_error']) for r in results if r['distance_error']]
[?2004l[?2004h>     if follow_results:
[?2004l[?2004h>         # Get the last portion of follow mode
[?2004l[?2004h>         last_follow = [float(de) for t, de in follow_results if t > 100]
[?2004l[?2004h>         if not last_follow:
[?2004l[?2004h>             last_follow = [float(de) for t, de in follow_results[-50:]]
[?2004l[?2004h>         if last_follow:
[?2004l[?2004h>             ss_dist_error = abs(sum(last_follow) / len(last_follow))
[?2004l[?2004h>         else:
[?2004l[?2004h>             ss_dist_error = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         ss_dist_error = 0
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\n=== Performance Metrics ===")
[?2004l[?2004h>     print(f"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s" if rise_time else "Rise time: N/A")
[?2004l[?2004h>     print(f"Maximum cruise speed: {max_cruise_speed:.2f} m/s")
[?2004l[?2004h>     print(f"Speed overshoot: {overshoot:.2f}%")
[?2004l[?2004h>     print(f"Steady-state speed error: {ss_speed_error:.3f} m/s")
