[?2004hroot@5872ab224e04:~# cat > simulation.py << 'EOF'
[?2004l[?2004h> """ACC Simulation runner with proper position tracking."""
[?2004l[?2004h> 
[?2004l[?2004h> import csv
[?2004l[?2004h> import yaml
[?2004l[?2004h> from acc_system import AdaptiveCruiseControl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_yaml(filepath):
[?2004l[?2004h>     """Load YAML configuration file."""
[?2004l[?2004h>     with open(filepath, 'r') as f:
[?2004l[?2004h>         return yaml.safe_load(f)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l=[?2004h> def load_sensor_data(filepath):
[?2004l[?2004h>     """Load sensor data from CSV file."""
[?2004led [?2004h>     data = []
[?2004l[?2004h>     with open(filepath, 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         for row in reader:
[?2004l[?2004h>             entry = {
[?2004l[?2004h>                 'time': float(row['time']),
[?2004l[?2004h>                 'ref_ego_speed': float(row['ego_speed']) if row['ego_speed'] else 0.0,
[?2004l[?2004h>                 'lead_speed': float(row['lead_speed']) if row['lead_speed'] else None,
[?2004l[?2004h>                 'ref_distance': float(row['distance']) if row['distance'] else None
[?2004l[?2004h>             }
[?2004l[?2004h>             data.append(entry)
[?2004l[?2004h>     return data
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def run_simulation():
[?2004l[?2004h>     """Run the ACC simulation with proper position tracking."""
[?2004l[?2004h>     # Load configurations
[?2004l[?2004h>     vehicle_config = load_yaml('vehicle_params.yaml')
[?2004l[?2004h>     tuning_config = load_yaml('tuning_results.yaml')
[?2004l[?2004h>     
[?2004l[?2004h>     # Load sensor data for lead vehicle information
[?2004l[?2004h>     sensor_data = load_sensor_data('sensor_data.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize ACC system
[?2004l[?2004h>     acc = AdaptiveCruiseControl(vehicle_config)
[?2004l[?2004h>     
[?2004l[?2004h>     # Update with tuned PID gains
[?2004l[?2004h>     acc.set_pid_gains(tuning_config['pid_speed'], tuning_config['pid_distance'])
[?2004l[?2004h>     
[?2004l[?2004h>     # Simulation parameters
[?2004l[?2004h>     dt = vehicle_config['simulation']['dt']
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial state - ego vehicle
[?2004l[?2004h>     ego_speed = 0.0
[?2004l[?2004h>     ego_position = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Lead vehicle state
[?2004l[?2004h>     lead_position = None
[?2004l [?2004h>     lead_active = False
[?2004l[?2004h>     
[?2004l['[?2004h>     # Results storage
[?2004l[?2004h>     results = []
[?2004l
[?2004h>     
[?2004l[?2004h>     # Run simulation
[?2004l[?2004h>     for i, sensor in enumerate(sensor_data):
[?2004l[?2004h>         time = sensor['time']
[?2004l[?2004h>         lead_speed = sensor['lead_speed']
[?2004l[?2004h>         
[?2004l[?2004h>         # Handle lead vehicle
[?2004l[?2004h>         if lead_speed is not None:
[?2004l[?2004h>             if not lead_active:
[?2004l[?2004h>                 initial_distance = sensor['ref_distance'] if sensor['ref_distance'] else 50.0
[?2004l[?2004h>                 lead_position = ego_position + initial_distance
[?2004l[?2004h>                 lead_active = True
[?2004l[?2004h>             distance = lead_position - ego_position
[?2004l [?2004h>         else:
[?2004l[?2004h>             lead_active = False
[?2004l[?2004h>             lead_position = None
[?2004l[?2004h>             distance = None
[?2004l[?2004h>         
[?2004l[?2004h>         # Compute ACC command
[?2004l[?2004h>         accel_cmd, mode, distance_error = acc.compute(
[?2004l[?2004h>             ego_speed, lead_speed, distance, dt
[?2004l[?2004h>         )
[?2004l2[?2004h>         
[?2004l[?2004h>         # Format output strings
[?2004l[?2004h>         if lead_speed is not None and distance is not None:
[?2004l[?2004h>             ttc = acc.compute_ttc(ego_speed, lead_speed, distance)
[?2004l[?2004h>             ttc_str = '' if ttc == float('inf') else f'{ttc:.2f}'
[?2004l[?2004h>             distance_str = f'{distance:.2f}'
[?2004l[?2004h>             dist_error_str = f'{distance_error:.2f}' if distance_error is not None else ''
[?2004l[?2004h>         else:
[?2004l[?2004h>             ttc_str = ''
[?2004l[?2004h>             distance_str = ''
[?2004l[?2004h>             dist_error_str = ''
[?2004l[?2004h>         
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': time,
[?2004l[?2004h>             'ego_speed': round(ego_speed, 10),
[?2004l[?2004h>             'acceleration_cmd': round(accel_cmd, 10),
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': dist_error_str,
[?2004l[?2004h>             'distance': distance_str,
[?2004l[?2004h>             'ttc': ttc_str
[?2004l[?2004h>         })
[?2004l[?2004h>         
[?2004l[?2004h>         # Update states
[?2004l[?2004h>         ego_speed = max(0.0, ego_speed + accel_cmd * dt)
[?2004l[?2004h>         ego_position += ego_speed * dt
[?2004l[?2004h>         
[?2004l[?2004h>         if lead_active and lead_speed is not None:
[?2004l[?2004h>             lead_position += lead_speed * dt
[?2004l[?2004h>     
[?2004l[?2004h>     # Write results
[?2004l[?2004h>     with open('simulation_results.csv', 'w', newline='') as f:
[?2004l[?2004h>         fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 
[?2004l[?2004h>                       'distance_error', 'distance', 'ttc']
[?2004l[?2004h>         writer = csv.DictWriter(f, fieldnames=fieldnames)
[?2004l[?2004h>         writer.writeheader()
[?2004l[?2004h>         writer.writerows(results)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Simulation complete. Results saved to simulation_results.csv")
[?2004l[?2004h>     print(f"Total timesteps: {len(results)}")
[?2004l[?2004h>     
[?2004l[?2004h>     analyze_results(results, vehicle_config)
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_results(results, config):
[?2004l[?2004h>     """Analyze simulation results and print metrics."""
[?2004l[?2004h>     set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>     
[?2004l[?2004h>     # Rise time (to 90% of set speed)
[?2004l[?2004h>     rise_time = None
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['ego_speed'] >= 0.9 * set_speed:
[?2004l[?2004h>             rise_time = r['time']
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Max speed during initial cruise (before t=30)
[?2004l[?2004h>     cruise_speeds = [r['ego_speed'] for r in results if r['time'] < 30]
[?2004l[?2004h>     max_cruise_speed = max(cruise_speeds) if cruise_speeds else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Overshoot
[?2004l[?2004h>     overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Speed SS error (t=25-29s before lead appears)
[?2004l[?2004h>     ss_cruise = [r['ego_speed'] for r in results if 25 <= r['time'] < 30]
[?2004l[?2004h>     ss_speed_error = abs(set_speed - sum(ss_cruise) / len(ss_cruise)) if ss_cruise else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Also check final cruise (t=140-150)
[?2004l[?2004h>     final_cruise = [r['ego_speed'] for r in results if r['time'] >= 140 and r['mode'] == 'cruise']
[?2004l[?2004h>     if final_cruise:
[?2004l[?2004h>         final_ss = abs(set_speed - sum(final_cruise) / len(final_cruise))
[?2004l[?2004h>         ss_speed_error = max(ss_speed_error, final_ss)
[?2004l[?2004h>     
[?2004l[?2004h>     # Min distance during follow mode
[?2004l[?2004h>     follow_dist = []
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['distance'] and r['mode'] in ['follow', 'emergency']:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 follow_dist.append(float(r['distance']))
[?2004l[?2004h>             except:
[?2004l[?2004h>                 pass
[?2004l[?2004h>     min_distance = min(follow_dist) if follow_dist else float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     # Distance SS error - use stable middle portion of follow mode (t=50-100)
[?2004l[?2004h>     dist_errors = []
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['distance_error'] and 50 <= r['time'] <= 100:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 dist_errors.append(float(r['distance_error']))
[?2004l[?2004h>             except:
[?2004l[?2004h>                 pass
[?2004l[?2004h>     
[?2004l[?2004h>     if dist_errors:
[?2004l[?2004h>         ss_dist_error = abs(sum(dist_errors) / len(dist_errors))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Fallback to all follow mode data
[?2004l[?2004h>         all_errors = [float(r['distance_error']) for r in results if r['distance_error']]
[?2004l[?2004h>         ss_dist_error = abs(sum(all_errors) / len(all_errors)) if all_errors else 0
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\n=== Performance Metrics ===")
[?2004l[?2004h>     if rise_time:
[?2004l[?2004h>         print(f"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print("Rise time: N/A")
[?2004l[?2004h>     print(f"Maximum cruise speed: {max_cruise_speed:.2f} m/s")
[?2004l[?2004h>     print(f"Speed overshoot: {overshoot:.2f}%")
[?2004l[?2004h>     print(f"Steady-state speed error: {ss_speed_error:.3f} m/s")
[?2004l[?2004h>     print(f"Minimum following distance: {min_distance:.2f} m")
[?2004l[?2004h>     print(f"Steady-state distance error: {ss_dist_error:.2f} m")
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"\n=== Target Compliance ===")
[?2004l[?2004h>     print(f"Rise time < 10s: {'PASS' if rise_time and rise_time < 10 else 'FAIL'}")
[?2004l[?2004h>     print(f"Overshoot < 5%: {'PASS' if overshoot < 5 else 'FAIL'}")
[?2004l[?2004h>     print(f"Speed SS error < 0.5 m/s: {'PASS' if ss_speed_error < 0.5 else 'FAIL'}")
[?2004l[?2004h>     print(f"Distance SS error < 2m: {'PASS' if ss_dist_error < 2 else 'FAIL'}")
[?2004l[?2004h>     print(f"Min distance > 5m: {'PASS' if min_distance > 5 else 'FAIL'}")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     run_simulation()
