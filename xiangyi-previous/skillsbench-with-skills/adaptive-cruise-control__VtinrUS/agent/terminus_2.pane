[?2004l[?2004h> def analyze_results(results, config):
[?2004l[?2004h>     """Analyze simulation results and print metrics."""
[?2004l[?2004h>     set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>     min_gap = config['acc_settings']['min_distance']
[?2004l[?2004h>     
[?2004l[?2004h>     # Find rise time (time to reach 90% of set speed)
[?2004l[?2004h>     rise_time = None
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         if r['ego_speed'] >= 0.9 * set_speed:
[?2004l[?2004h>             rise_time = r['time']
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Find max speed (for overshoot calculation)
[?2004l[?2004h>     max_speed = max(r['ego_speed'] for r in results)
[?2004l[?2004h>     overshoot = ((max_speed - set_speed) / set_speed) * 100 if max_speed > set_speed else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate steady-state speed error (last 10 seconds of cruise before lead appears)
[?2004l[?2004h>     cruise_speeds = [r['ego_speed'] for r in results if r['mode'] == 'cruise' and r['time'] > 20 and r['time'] < 30]
[?2004l[?2004h>     if cruise_speeds:
[?2004l[?2004h>         ss_speed_error = abs(set_speed - sum(cruise_speeds) / len(cruise_speeds))
[?2004l[?2004h>     else:
[?2004l[?2004h>         ss_speed_error = 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Find minimum distance during follow mode
[?2004l[?2004h>     follow_distances = [float(r['distance']) for r in results if r['distance'] and r['mode'] in ['follow', 'emergency']]
[?2004l[?2004h>     min_distance = min(follow_distances) if follow_distances else float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate distance steady-state error
