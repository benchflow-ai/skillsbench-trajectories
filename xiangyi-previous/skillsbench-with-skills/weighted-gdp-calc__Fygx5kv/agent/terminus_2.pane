[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/gdp.xlsx')
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Calculate Net Exports % of GDP in H35:L40
[?2004l[?2004h> # Formula: (Exports - Imports) / GDP * 100
[?2004l[?2004h> # For row 35 (UAE): (H12-H19)/H26*100
[?2004l[?2004h> print("Filling Net Exports % of GDP (H35:L40)...")
[?2004l[?2004h> for row in range(35, 41):
[?2004l[?2004h>     exports_row = row - 23  # 35-23=12, 36-23=13, etc.
[?2004l[?2004h>     imports_row = row - 16  # 35-16=19, 36-16=20, etc.
[?2004l[?2004h>     gdp_row = row - 9       # 35-9=26, 36-9=27, etc.
[?2004l[?2004h>     
[?2004l[?2004h>     for col in range(8, 13):  # H=8 to L=12
[?2004l[?2004h>         col_letter = get_column_letter(col)
[?2004l[?2004h>         formula = f"=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100"
[?2004l[?2004h>         task_sheet[f"{col_letter}{row}"] = formula
[?2004l[?2004h>         print(f"  {col_letter}{row}: {formula}")
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/gdp.xlsx')
[?2004l[?2004h> print("\nNet Exports % of GDP formulas saved!")
[?2004l[?2004h> wb.close()
