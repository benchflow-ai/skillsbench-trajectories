[?2004l[?2004h> data_sheet = wb['Data']
[?2004l[?2004h> task_sheet = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> def get_data_value(series_code, year):
[?2004l[?2004h>     """Simulate INDEX/MATCH: find value in Data sheet"""
[?2004l[?2004h>     for row in range(1, 100):
[?2004l[?2004h>         if data_sheet.cell(row, 2).value == series_code:
[?2004l[?2004h>             for col in range(1, 20):
[?2004l[?2004h>                 if data_sheet.cell(4, col).value == year:
[?2004l[?2004h>                     return data_sheet.cell(row, col).value
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Calculating Weighted Mean ===")
[?2004l[?2004h> 
[?2004l[?2004h> years = [2019, 2020, 2021, 2022, 2023]
[?2004l[?2004h> 
[?2004l[?2004h> # First, collect all data
[?2004l[?2004h> exports_data = {}
[?2004l[?2004h> imports_data = {}
[?2004l[?2004h> gdp_data = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Populate Exports data (rows 12-17)
[?2004l[?2004h> for row in range(12, 18):
[?2004l[?2004h>     series_code = task_sheet.cell(row, 4).value
[?2004l[?2004h>     exports_data[row] = {}
[?2004l[?2004h>     for col_idx, col in enumerate(range(8, 13)):
[?2004l[?2004h>         year = years[col_idx]
[?2004l[?2004h>         value = get_data_value(series_code, year)
[?2004l[?2004h>         exports_data[row][col] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Populate Imports data (rows 19-24)
[?2004l[?2004h> for row in range(19, 25):
[?2004l[?2004h>     series_code = task_sheet.cell(row, 4).value
[?2004l[?2004h>     imports_data[row] = {}
[?2004l[?2004h>     for col_idx, col in enumerate(range(8, 13)):
[?2004l[?2004h>         year = years[col_idx]
[?2004l[?2004h>         value = get_data_value(series_code, year)
[?2004l[?2004h>         imports_data[row][col] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Populate GDP data (rows 26-31)
[?2004l[?2004h> for row in range(26, 32):
[?2004l[?2004h>     series_code = task_sheet.cell(row, 4).value
[?2004l[?2004h>     gdp_data[row] = {}
[?2004l[?2004h>     for col_idx, col in enumerate(range(8, 13)):
[?2004l[?2004h>         year = years[col_idx]
[?2004l[?2004h>         value = get_data_value(series_code, year)
[?2004l[?2004h>         gdp_data[row][col] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Net Exports % of GDP
[?2004l[?2004h> net_exports_pct = {}
[?2004l[?2004h> for row in range(35, 41):
[?2004l[?2004h>     exports_row = row - 23  # 35->12, 36->13, etc.
[?2004l[?2004h>     imports_row = row - 16  # 35->19, 36->20, etc.
[?2004l[?2004h>     gdp_row = row - 9       # 35->26, 36->27, etc.
[?2004l[?2004h>     net_exports_pct[row] = {}
[?2004l[?2004h>     
[?2004l[?2004h>     for col in range(8, 13):
[?2004l[?2004h>         exp = exports_data[exports_row][col]
[?2004l[?2004h>         imp = imports_data[imports_row][col]
[?2004l[?2004h>         gdp = gdp_data[gdp_row][col]
[?2004l[?2004h>         
[?2004l[?2004h>         if exp is not None and imp is not None and gdp is not None:
[?2004l[?2004h>             net_exp_pct = (exp - imp) / gdp * 100
[?2004l[?2004h>             net_exports_pct[row][col] = net_exp_pct
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate weighted mean for each year
[?2004l[?2004h> print("\nWeighted Mean Calculations:")
[?2004l[?2004h> for col in range(8, 13):
[?2004l[?2004h>     col_letter = get_column_letter(col)
[?2004l[?2004h>     year = years[col - 8]
[?2004l[?2004h>     
[?2004l[?2004h>     # Weighted mean = SUMPRODUCT(net_exports_pct, gdp) / SUM(gdp)
[?2004l[?2004h>     numerator = 0
[?2004l[?2004h>     denominator = 0
[?2004l[?2004h>     
[?2004l[?2004h>     for net_row in range(35, 41):
[?2004l[?2004h>         gdp_row = net_row - 9
[?2004l[?2004h>         net_pct = net_exports_pct[net_row][col]
[?2004l[?2004h>         gdp_val = gdp_data[gdp_row][col]
[?2004l[?2004h>         
[?2004l[?2004h>         numerator += net_pct * gdp_val
[?2004l[?2004h>         denominator += gdp_val
[?2004l[?2004h>     
[?2004l[?2004h>     weighted_mean = numerator / denominator
[?2004l[?2004h>     print(f"  {col_letter}50 (Year {year}): {weighted_mean:.6f}")
[?2004l[?2004h>     print(f"    Numerator (SUMPRODUCT): {numerator:.6f}")
[?2004l[?2004h>     print(f"    Denominator (SUM GDP): {denominator:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> wb.close()
[?2004l[?2004h> print("\nWeighted mean calculations complete!")
