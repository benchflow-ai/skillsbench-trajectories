[113.629709, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Adding statistical formulas...\\n\")\n\n# Row 42: MIN\nprint(\"Row 42 (MIN):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=MIN({col_letter}35:{col_letter}40)\"\n    task_sheet[f\"{col_letter}42\"] = formula\n    print(f\"  {col_letter}42: {formula}\")\n\n# Row 43: MAX\nprint(\"\\nRow 43 (MAX):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=MAX({col_letter}35:{col_letter}40)\"\n    task_sheet[f\"{col_letter}43\"] = formula\n    print(f\"  {col_letter}43: {formula}\")\n\n# Row 44: MEDIAN\nprint(\"\\nRow 44 (MEDIAN):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=MEDIAN({col_letter}35:{col_letter}40)\"\n    task_sheet[f\"{col_letter}44\"] = formula\n    print(f\"  {col_letter}44: {formula}\")\n\n# Row 45: AVERAGE (simple mean)\nprint(\"\\nRow 45 (AVERAGE):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=AVERAGE({col_letter}35:{col_letter}40)\"\n    task_sheet[f\"{col_letter}45\"] = formula\n    print(f\"  {col_letter}45: {formula}\")\n\n# Row 46: 25th PERCENTILE\nprint(\"\\nRow 46 (25th Percentile):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=PERCENTILE({col_letter}35:{col_letter}40,0.25)\"\n    task_sheet[f\"{col_letter}46\"] = formula\n    print(f\"  {col_letter}46: {formula}\")\n\n# Row 47: 75th PERCENTILE\nprint(\"\\nRow 47 (75th Percentile):\")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    formula = f\"=PERCENTILE({col_letter}35:{col_letter}40,0.75)\"\n    task_sheet[f\"{col_letter}47\"] = formula\n    print(f\"  {col_letter}47: {formula}\")\n\nwb.save('/root/gdp.xlsx')\nprint(\"\\nStatistical formulas saved!\")\nwb.close()\nEOF\n"]
