[22.602396, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== TASK SHEET - Row 10 (Headers) ===\")\nfor col in range(1, 13):\n    cell = task_sheet.cell(10, col)\n    print(f\"Col {col} ({chr(64+col)}): {cell.value}\")\n\nprint(\"\\n=== TASK SHEET - Rows 12-17, Columns A-L ===\")\nfor row in range(12, 18):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        print(f\"  {col_letter}{row}: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - First few rows ===\")\ndata_sheet = wb['Data']\nfor row in range(1, 6):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 8):\n        cell = data_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        print(f\"  {col_letter}{row}: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - Rows 21-25 ===\")\nfor row in range(21, 26):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 8):\n        cell = data_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        print(f\"  {col_letter}{row}: {cell.value}\")\n\nwb.close()\nEOF\n"]
