[38.740024, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\n\n# Check Task sheet row 10 completely\ntask_sheet = wb['Task']\nprint(\"=== TASK SHEET - Row 10 (Year Headers) ===\")\nfor col in range(1, 16):\n    cell = task_sheet.cell(10, col)\n    col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n    print(f\"{col_letter}10: {cell.value}\")\n\n# Check Data sheet row 1\ndata_sheet = wb['Data']\nprint(\"\\n=== DATA SHEET - Row 1 (Headers) ===\")\nfor col in range(1, 16):\n    cell = data_sheet.cell(1, col)\n    col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n    print(f\"{col_letter}1: {cell.value}\")\n\n# Check what's in B1 of Data sheet (referenced in Data rows)\nprint(f\"\\nData!B1 = {data_sheet['B1'].value}\")\nprint(f\"Task!B1 = {task_sheet['B1'].value}\")\n\nwb.close()\nEOF\n"]
