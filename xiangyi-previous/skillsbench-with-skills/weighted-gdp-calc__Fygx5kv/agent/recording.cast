[23.137738, "o", "  A16: None\r\n  B16: 449\r\n  C16: Oman\r\n  D16: 449BXGS_BP6.A\r\n  E16: Exports, Goods and Services\r\n  F16: US dollars\r\n  G16: Billions\r\n  H16: None\r\n  I16: None\r\n  J16: None\r\n  K16: None\r\n  L16: None\r\n\r\nRow 17:\r\n  A17: None\r\n  B17: 456\r\n  C17: Saudi Arabia\r\n  D17: 456BXGS_BP6.A\r\n  E17: Exports, Goods and Services\r\n  F17: US dollars\r\n  G17: Billions\r\n  H17: None\r\n  I17: None\r\n  J17: None\r\n  K17: None\r\n  L17: None\r\n\r\n=== DATA SHEET - First few rows ===\r\n\r\nRow 1:\r\n  A1: Database --> \r\n  B1: ID:WEO_PUBLISHED\r\n  C1: None\r\n  D1: None\r\n  E1: None\r\n  F1: None\r\n  G1: None\r\n\r\nRow 2:\r\n  A2: None\r\n  B2: None\r\n  C2: None\r\n  D2: None\r\n  E2: None\r\n  F2: None\r\n  G2: None\r\n\r\nRow 3:\r\n  A3: None\r\n  B3: None\r\n  C3: None\r\n  D3: None\r\n  E3: None\r\n  F3: None\r\n  G3: None\r\n\r\nRow 4:\r\n  A4: Database\r\n  B4: Series_code\r\n  C4: Country\r\n  D4: Indicator\r\n  E4: Indicator.Name\r\n  F4: Frequency\r\n  G4: Scale\r\n\r\nRow 5:\r\n  A5: None\r\n  B5: None\r\n  C5: None\r\n  D5: None\r\n  E5: None\r\n  F5: None\r\n  G5: None\r\n\r\n=== DATA SHEET - Rows 21-25 ===\r\n\r\nRow 21:\r\n  A21: =$B$1\r\n  B21: 419BXGS_BP6.A\r\n  C21: Bahrain\r\n  D21: BXGS_BP6\r\n  E21: Balance of Payments, Current Account, Goods and Services, Credit (BPM6)\r\n  F21: Annual\r\n  G21: Billions\r\n\r\nRow 22:\r\n  A22: =$B$1\r\n  B22: 443BXGS_BP6.A\r\n  C22: Kuwait\r\n  D22: BXGS_BP6\r\n  E22: Balance of Payments, Current Account, Goods and Services, Credit (BPM6)\r\n  F22: Annual\r\n  G22: Billions\r\n\r\nRow 23:\r\n  A23: =$B$1\r\n  B23: 449BXGS_BP6.A\r\n  C23: Oman\r\n  D23: BXGS_BP6\r\n  E23: Balance of Payments, Current Account, Goods and Services, Credit (BPM6)\r\n  F23: Annual\r\n  G23: Billions\r\n\r\nRow 24:\r\n  A24: =$B$1\r\n  B24: 453BXGS_BP6.A\r\n  C24: Qatar\r\n  D24: BXGS_BP6\r\n  E24: Balance of Payments, Current Account, Goods and Services, Credit (BPM6)\r\n  F24: Annual\r\n  G2