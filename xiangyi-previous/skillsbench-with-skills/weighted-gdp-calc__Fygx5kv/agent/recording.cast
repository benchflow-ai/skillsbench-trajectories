[211.834891, "o", "\u001b[?2004h>     stats[col] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835003, "o", "        'min': min(values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835111, "o", "        'max': max(values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835228, "o", "        'median': statistics.median(values),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835337, "o", "        'mean': statistics.mean(values),\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.835443, "o", "> "]
[211.835545, "o", "        'p25': sorted(values)[int(len(values)*0.25)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835649, "o", "        'p75': sorted(values)[int(len(values)*0.75)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835756, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.835859, "o", "    print(f\"\\n{col_letter} (Year {years[col-8]}):\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.83597, "o", "> "]
[211.836075, "o", "    print(f\"  Min: {stats[col]['min']:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.836183, "o", "    print(f\"  Max: {stats[col]['max']:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.836307, "o", "    print(f\"  Median: {stats[col]['median']:.4f}\")\r\n\u001b[?2004l\r"]
[211.836419, "o", "\u001b[?2004h> "]
[211.836523, "o", "    print(f\"  Mean: {stats[col]['mean']:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.83663, "o", "    print(f\"  25th percentile: {stats[col]['p25']:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.836767, "o", "    print(f\"  75th percentile: {stats[col]['p75']:.4f}\")\r\n\u001b[?2004l\r"]
[211.836878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[211.836955, "o", "\u001b[?2004h> "]
[211.837025, "o", "# Calculate weighted mean for each year\r\n"]
[211.837092, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[211.837188, "o", "print(\"\\nCalculating weighted mean...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.837256, "o", "> weighted_means = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.837316, "o", "> "]
[211.837382, "o", "for col in range(8, 13):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.837462, "o", "    col_letter = get_column_letter(col)\r\n\u001b[?2004l\r"]
[211.837528, "o", "\u001b[?2004h> "]
[211.837743, "o", "    numerator = sum(net_exports_data[row][col] * gdp_data[row+9][col] for row in range(35, 41))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.837908, "o", "    denominator = sum(gdp_data[row][col] for row in range(26, 32))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.838028, "o", "    weighted_mean = numerator / denominator\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.838092, "o", "> "]
[211.838163, "o", "    weighted_means[col] = weighted_mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.838354, "o", "    print(f\"  {col_letter}50 (Year {years[col-8]}): {weighted_mean:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[211.838427, "o", "\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.838492, "o", "> "]
[211.838555, "o", "print(\"\\nAll calculations complete!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.838621, "o", "EOF\r\n\u001b[?2004l\r"]
