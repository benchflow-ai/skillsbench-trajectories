[65.081725, "o", "print(\"\\n=== DATA SHEET - Checking if there's a header row with years ===\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Searching for year values in first 10 rows...\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in range(1, 11):\r\n\u001b[?2004l\r\u001b[?2004h>     for col in range(1, 20):\r\n\u001b[?2004l\r\u001b[?2004h>         cell = data_sheet.cell(row, col)\r\n\u001b[?2004l\r\u001b[?2004h>         if isinstance(cell.value, (int, float)) and 2019 <= cell.value <= 2025:\r\n\u001b[?2004l\r\u001b[?2004h>             col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Found {cell.value} at {col_letter}{row}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[65.682308, "o", "=== DATA SHEET - Row 1 and surrounding context ===\r\nA1: Database --> \r\nB1: ID:WEO_PUBLISHED\r\nC1: None\r\nD1: None\r\nE1: None\r\nF1: None\r\nG1: None\r\nH1: None\r\nI1: None\r\nJ1: None\r\nK1: None\r\nL1: None\r\nM1: None\r\nN1: None\r\n\r\n=== DATA SHEET - Rows 2-5 ===\r\n\r\nRow 2:\r\n  A2: None\r\n  B2: None\r\n  C2: None\r\n  D2: None\r\n  E2: None\r\n  F2: None\r\n  G2: None\r\n  H2: None\r\n  I2: None\r\n\r\nRow 3:\r\n  A3: None\r\n  B3: None\r\n  C3: None\r\n  D3: None\r\n  E3: None\r\n  F3: None\r\n  G3: None\r\n"]
