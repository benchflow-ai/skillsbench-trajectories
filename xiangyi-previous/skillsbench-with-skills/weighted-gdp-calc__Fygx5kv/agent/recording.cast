[86.00573, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\ndata_sheet = wb['Data']\n\n# Step 1: Fill in Exports data (H12:L17)\nprint(\"Filling Exports data (H12:L17)...\")\nfor row in range(12, 18):\n    for col in range(8, 13):  # H=8, I=9, J=10, K=11, L=12\n        col_letter = get_column_letter(col)\n        # Formula: =INDEX(Data.$H:$M, MATCH($D12, Data.$B:$B, 0), MATCH(H$9, Data.$4:$4, 0))\n        formula = f\"=INDEX(Data.$H:$M,MATCH($D{row},Data.$B:$B,0),MATCH({col_letter}$9,Data.$4:$4,0))\"\n        task_sheet[f\"{col_letter}{row}\"] = formula\n        print(f\"  {col_letter}{row}: {formula}\")\n\n# Step 2: Fill in Imports data (H19:L24)\nprint(\"\\nFilling Imports data (H19:L24)...\")\nfor row in range(19, 25):\n    for col in range(8, 13):\n        col_letter = get_column_letter(col)\n        formula = f\"=INDEX(Data.$H:$M,MATCH($D{row},Data.$B:$B,0),MATCH({col_letter}$9,Data.$4:$4,0))\"\n        task_sheet[f\"{col_letter}{row}\"] = formula\n        print(f\"  {col_letter}{row}: {formula}\")\n\n# Step 3: Fill in GDP data (H26:L31)\nprint(\"\\nFilling GDP data (H26:L31)...\")\nfor row in range(26, 32):\n    for col in range(8, 13):\n        col_letter = get_column_letter(col)\n        formula = f\"=INDEX(Data.$H:$M,MATCH($D{row},Data.$B:$B,0),MATCH({col_letter}$9,Data.$4:$4,0))\"\n        task_sheet[f\"{col_letter}{row}\"] = formula\n        print(f\"  {col_letter}{row}: {formula}\")\n\nwb.save('/root/gdp.xlsx')\nprint(\"\\nFormulas saved!\")\nwb.close()\nEOF\n"]
