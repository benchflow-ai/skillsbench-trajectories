[65.074221, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"=== DATA SHEET - Row 1 and surrounding context ===\")\nfor col in range(1, 15):\n    cell = data_sheet.cell(1, col)\n    col_letter = chr(64+col)\n    print(f\"{col_letter}1: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - Rows 2-5 ===\")\nfor row in range(2, 6):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 10):\n        cell = data_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        print(f\"  {col_letter}{row}: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - Checking if there's a header row with years ===\")\nprint(\"Searching for year values in first 10 rows...\")\nfor row in range(1, 11):\n    for col in range(1, 20):\n        cell = data_sheet.cell(row, col)\n        if isinstance(cell.value, (int, float)) and 2019 <= cell.value <= 2025:\n            col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n            print(f\"Found {cell.value} at {col_letter}{row}\")\n\nwb.close()\nEOF\n"]
