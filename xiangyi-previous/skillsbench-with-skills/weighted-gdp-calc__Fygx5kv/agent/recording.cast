[229.603891, "o", "> "]
[229.603983, "o", "        value = get_data_value(series_code, year)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604064, "o", "        imports_data[row][col] = value\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604127, "o", "# Populate GDP data (rows 26-31)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604191, "o", "for row in range(26, 32):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604297, "o", "    series_code = task_sheet.cell(row, 4).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604362, "o", "    gdp_data[row] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604434, "o", "    for col_idx, col in enumerate(range(8, 13)):\r\n\u001b[?2004l\r"]
[229.604487, "o", "\u001b[?2004h> "]
[229.604555, "o", "        year = years[col_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604629, "o", "        value = get_data_value(series_code, year)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604706, "o", "        gdp_data[row][col] = value\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.604773, "o", "# Calculate Net Exports % of GDP\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.604834, "o", "> net_exports_pct = {}\r\n\u001b[?2004l\r"]
[229.604901, "o", "\u001b[?2004h> "]
[229.604964, "o", "for row in range(35, 41):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.605062, "o", "    exports_row = row - 23  # 35->12, 36->13, etc.\r\n\u001b[?2004l\r"]
[229.605129, "o", "\u001b[?2004h> "]
[229.605214, "o", "    imports_row = row - 16  # 35->19, 36->20, etc.\r\n\u001b[?2004l\r"]
[229.605282, "o", "\u001b[?2004h> "]
[229.605378, "o", "    gdp_row = row - 9       # 35->26, 36->27, etc.\r\n\u001b[?2004l\r"]
[229.605444, "o", "\u001b[?2004h> "]
[229.605526, "o", "    net_exports_pct[row] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.605584, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.605684, "o", "    for col in range(8, 13):\r\n\u001b[?2004l\r"]
[229.605753, "o", "\u001b[?2004h> "]
[229.605845, "o", "        exp = exports_data[exports_row][col]\r\n\u001b[?2004l\r"]
[229.605913, "o", "\u001b[?2004h> "]
[229.605994, "o", "        imp = imports_data[imports_row][col]\r\n\u001b[?2004l\r"]
[229.60606, "o", "\u001b[?2004h> "]
[229.606126, "o", "        gdp = gdp_data[gdp_row][col]\r\n\u001b[?2004l\r"]
[229.606202, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[229.606271, "o", "\u001b[?2004h> "]
[229.6064, "o", "        if exp is not None and imp is not None and gdp is not None:\r\n\u001b[?2004l\r"]
[229.606466, "o", "\u001b[?2004h> "]
[229.606573, "o", "            net_exp_pct = (exp - imp) / gdp * 100\r\n\u001b[?2004l\r"]
[229.606639, "o", "\u001b[?2004h> "]
[229.606784, "o", "            net_exports_pct[row][col] = net_exp_pct\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.606938, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.607083, "o", "# Calculate weighted mean for each year\r\n\u001b[?2004l\r"]
[229.607191, "o", "\u001b[?2004h> "]
[229.607277, "o", "print(\"\\nWeighted Mean Calculations:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.607411, "o", "for col in range(8, 13):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.607512, "o", "    col_letter = get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.60761, "o", "    year = years[col - 8]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[229.607709, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[229.607791, "o", "    # Weighted mean = SUMPRODUCT(net_exports_pct, gdp) / SUM(gdp)\r\n\u001b[?2004l\r"]
[229.607883, "o", "\u001b[?2004h>     numerator = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.608442, "o", "    denominator = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for net_row in range(35, 41):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.608535, "o", "        gdp_row = net_row - 9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.609157, "o", "        net_pct = net_exports_pct[net_row][col]\r\n\u001b[?2004l\r"]
[229.609288, "o", "\u001b[?2004h> "]
[229.609379, "o", "        gdp_val = gdp_data[gdp_row][col]\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.609474, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.609562, "o", "        numerator += net_pct * gdp_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.609679, "o", "        denominator += gdp_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.609776, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.609862, "o", "    weighted_mean = numerator / denominator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.610006, "o", "    print(f\"  {col_letter}50 (Year {year}): {weighted_mean:.6f}\")\r\n\u001b[?2004l\r"]
[229.610117, "o", "\u001b[?2004h> "]
[229.610155, "o", "    print(f\"    Numerator (SUMPRODUCT): {numerator:.6f}\")\r\n\u001b[?2004l\r"]
[229.610186, "o", "\u001b[?2004h> "]
[229.610319, "o", "    print(f\"    Denominator (SUM GDP): {denominator:.6f}\")\r\n\u001b[?2004l\r"]
[229.610352, "o", "\u001b[?2004h> "]
[229.610382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[229.610413, "o", "> wb.close()"]
[229.610439, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[229.610557, "o", "print(\"\\nWeighted mean calculations complete!\")\r\n\u001b[?2004l\r"]
[229.610619, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[230.152302, "o", "=== Calculating Weighted Mean ===\r\n"]
[230.186671, "o", "\r\nWeighted Mean Calculations:\r\n  H50 (Year 2019): 12.219627\r\n    Numerator (SUMPRODUCT): 20753.006513\r\n    Denominator (SUM GDP): 1698.333895\r\n  I50 (Year 2020): 6.842838\r\n    Numerator (SUMPRODUCT): 9896.124142\r\n    Denominator (SUM GDP): 1446.201831\r\n  J50 (Year 2021): 15.583465\r\n    Numerator (SUMPRODUCT): 27089.058534\r\n    Denominator (SUM GDP): 1738.320665\r\n  K50 (Year 2022): 22.353305\r\n    Numerator (SUMPRODUCT): 49038.467828\r\n    Denominator (SUM GDP): 2193.790520\r\n"]
[230.18682, "o", "  L50 (Year 2023): 14.860040\r\n    Numerator (SUMPRODUCT): 31526.552550\r\n    Denominator (SUM GDP): 2121.565781\r\n\r\nWeighted mean calculations complete!\r\n"]
[230.214112, "o", "\u001b[?2004hroot@8ca429510c12:~# "]
[241.723515, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== FINAL VERIFICATION ===\")\nprint(\"\\nStep 1: INDEX/MATCH Formulas for Data Population\")\nprint(\"\\nExports (H12:L12):\")\nfor col in range(8, 13):\n    cell = task_sheet.cell(12, col)\n    col_letter = chr(64+col)\n    print(f\"  {col_letter}12: {cell.value}\")\n\nprint(\"\\nImports (H19:L19):\")\nfor col in range(8, 13):\n    cell = task_sheet.cell(19, col)\n    col_letter = chr(64+col)\n    print(f\"  {col_letter}19: {cell.value}\")\n\nprint(\"\\nGDP (H26:L26):\")\nfor col in range(8, 13):\n    cell = task_sheet.cell(26, col)\n    col_letter = chr(64+col)\n    print(f\"  {col_letter}26: {cell.value}\")\n\nprint(\"\\nStep 2: Net Exports % of GDP Formulas (H35:L35):\")\nfor col in range(8, 13):\n    cell = task_sheet.cell(35, col)\n    col_letter = chr(64+col)\n    print(f\"  {col_letter}35: {cell.value}\")\n\nprint(\"\\nStep 2: Statistics Formulas (Row 42-47, Column H):\")\nfor row in range(42, 48):\n    cell = task_sheet.cell(row, 8)\n    print(f\"  H{row}: {cell.value}\")\n\nprint(\"\\nStep 3: Weighted Mean Formula (H50:L50):\")\nfor col in range(8, 13):\n    cell = task_sheet.cell(50, col)\n    col_letter = chr(64+col)\n    print(f\"  {col_letter}50: {cell.value}\")\n\nprint(\"\\n=== SUMMARY ===\")\nprint(\"✓ Step 1: INDEX/MATCH formulas for data population (H12:L17, H19:L24, H26:L31)\")\nprint(\"✓ Step 2: Net Exports % of GDP calculations (H35:L40)\")\nprint(\"✓ Step 2: Statistical measures (min, max, median, mean, 25th percentile, 75th percentile)\")\nprint(\"✓ Step 3: Weighted mean using SUMPRODUCT formula\")\nprint(\"\\nAll formulas are in place. The file will calculate when opened in Excel.\")\n\nwb.close()\nEOF\n"]
