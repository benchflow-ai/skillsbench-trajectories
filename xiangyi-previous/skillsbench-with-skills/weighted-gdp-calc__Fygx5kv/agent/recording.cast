[256.243028, "o", "\u001b[?2004h> "]
[256.243098, "o", "        cell = task_sheet.cell(row, col)\r\n\u001b[?2004l\r"]
[256.243122, "o", "\u001b[?2004h> "]
[256.243169, "o", "        col_letter = chr(64+col)\r\n\u001b[?2004l\r"]
[256.243192, "o", "\u001b[?2004h> "]
[256.243235, "o", "        if cell.value is None:\r\n\u001b[?2004l\r"]
[256.243261, "o", "\u001b[?2004h> "]
[256.243335, "o", "            print(f\"  ❌ {col_letter}{row}: EMPTY\")\r\n\u001b[?2004l\r"]
[256.24336, "o", "\u001b[?2004h> "]
[256.243409, "o", "            all_have_formulas = False\r\n\u001b[?2004l\r"]
[256.243436, "o", "\u001b[?2004h> "]
[256.243523, "o", "        elif isinstance(cell.value, str) and '=' in cell.value:\r\n\u001b[?2004l\r"]
[256.243547, "o", "\u001b[?2004h> "]
[256.243635, "o", "            print(f\"  ✓ {col_letter}{row}: Has formula\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.243663, "o", ">         else:\r\n\u001b[?2004l\r"]
[256.243687, "o", "\u001b[?2004h> "]
[256.243796, "o", "            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\r\n\u001b[?2004l\r"]
[256.243821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[256.243848, "o", "\u001b[?2004h> "]
[256.243892, "o", "if all_have_formulas:\r\n\u001b[?2004l\r"]
[256.243919, "o", "\u001b[?2004h> "]
[256.244015, "o", "    print(\"  ✓ All Statistics cells have formulas\")\r\n\u001b[?2004l\r"]
[256.244039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.244101, "o", "# Check Weighted Mean (H50:L50)\r\n\u001b[?2004l\r"]
[256.244126, "o", "\u001b[?2004h> "]
[256.244244, "o", "print(\"\\nWeighted Mean (H50:L50) - All formulas should be SUMPRODUCT:\")\r\n\u001b[?2004l\r"]
[256.244266, "o", "\u001b[?2004h> "]
[256.244319, "o", "all_have_formulas = True\r\n\u001b[?2004l\r"]
[256.244344, "o", "\u001b[?2004h> "]
[256.244393, "o", "for col in range(8, 13):\r\n\u001b[?2004l\r"]
[256.244423, "o", "\u001b[?2004h> "]
[256.244484, "o", "    cell = task_sheet.cell(50, col)\r\n\u001b[?2004l\r"]
[256.244506, "o", "\u001b[?2004h> "]
[256.244564, "o", "    col_letter = chr(64+col)\r\n\u001b[?2004l\r"]
[256.24459, "o", "\u001b[?2004h> "]
[256.244644, "o", "    if cell.value is None:\r\n\u001b[?2004l\r"]
[256.244668, "o", "\u001b[?2004h> "]
[256.244748, "o", "        print(f\"  ❌ {col_letter}50: EMPTY\")\r\n\u001b[?2004l\r"]
[256.244782, "o", "\u001b[?2004h> "]
[256.244839, "o", "        all_have_formulas = False\r\n\u001b[?2004l\r"]
[256.244869, "o", "\u001b[?2004h> "]
[256.244962, "o", "    elif isinstance(cell.value, str) and 'SUMPRODUCT' in cell.value:\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.244986, "o", "> "]
[256.245071, "o", "        print(f\"  ✓ {col_letter}50: Has SUMPRODUCT formula\")\r\n\u001b[?2004l\r"]
[256.24511, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.245135, "o", "> "]
[256.245214, "o", "        print(f\"  ⚠ {col_letter}50: {cell.value}\")\r\n\u001b[?2004l\r"]
[256.245241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.245286, "o", "if all_have_formulas:\r\n\u001b[?2004l\r"]
[256.245311, "o", "\u001b[?2004h> "]
[256.245397, "o", "    print(\"  ✓ All Weighted Mean cells have formulas\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.24543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.245465, "o", "wb.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.245487, "o", "EOF\r\n\u001b[?2004l\r"]
