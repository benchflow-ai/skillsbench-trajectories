[87.330191, "o", "\u001b[?2004hroot@8ca429510c12:~# "]
[95.387059, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\n# Step 2: Calculate Net Exports % of GDP in H35:L40\n# Formula: (Exports - Imports) / GDP * 100\n# For row 35 (UAE): (H12-H19)/H26*100\nprint(\"Filling Net Exports % of GDP (H35:L40)...\")\nfor row in range(35, 41):\n    exports_row = row - 23  # 35-23=12, 36-23=13, etc.\n    imports_row = row - 16  # 35-16=19, 36-16=20, etc.\n    gdp_row = row - 9       # 35-9=26, 36-9=27, etc.\n    \n    for col in range(8, 13):  # H=8 to L=12\n        col_letter = get_column_letter(col)\n        formula = f\"=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100\"\n        task_sheet[f\"{col_letter}{row}\"] = formula\n        print(f\"  {col_letter}{row}: {formula}\")\n\nwb.save('/root/gdp.xlsx')\nprint(\"\\nNet Exports % of GDP formulas saved!\")\nwb.close()\nEOF\n"]
[95.389025, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[95.389455, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.389681, "o", "from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/root/gdp.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> task_sheet = wb['Task']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.389775, "o", "# Step 2: Calculate Net Exports % of GDP in H35:L40\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.389842, "o", "# Formula: (Exports - Imports) / GDP * 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.389927, "o", "> "]
[95.389963, "o", "# For row 35 (UAE): (H12-H19)/H26*100\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.390164, "o", "> "]
[95.390267, "o", "print(\"Filling Net Exports % of GDP (H35:L40)...\")\r\n\u001b[?2004l\r\u001b[?2004h> for row in range(35, 41):\r\n\u001b[?2004l\r"]
[95.390341, "o", "\u001b[?2004h> "]
[95.390399, "o", "    exports_row = row - 23  # 35-23=12, 36-23=13, etc.\r\n\u001b[?2004l\r"]
[95.390455, "o", "\u001b[?2004h> "]
[95.390546, "o", "    imports_row = row - 16  # 35-16=19, 36-16=20, etc.\r\n\u001b[?2004l\r"]
[95.390603, "o", "\u001b[?2004h> "]
[95.390723, "o", "    gdp_row = row - 9       # 35-9=26, 36-9=27, etc.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.390789, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[95.390851, "o", "> "]
[95.390913, "o", "    for col in range(8, 13):  # H=8 to L=12\r\n\u001b[?2004l\r"]
[95.390973, "o", "\u001b[?2004h> "]
[95.391106, "o", "        col_letter = get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.391306, "o", "        formula = f\"=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100\"\r\n\u001b[?2004l\r"]
[95.391399, "o", "\u001b[?2004h> "]
[95.391484, "o", "        task_sheet[f\"{col_letter}{row}\"] = formula\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.391606, "o", "        print(f\"  {col_letter}{row}: {formula}\")\r\n\u001b[?2004l\r"]
[95.391717, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.391819, "o", "wb.save('/root/gdp.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.391895, "o", "print(\"\\nNet Exports % of GDP formulas saved!\")\r\n\u001b[?2004l\r"]
[95.391948, "o", "\u001b[?2004h> wb.close()\r\n\u001b[?2004l\r"]
[95.391993, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[96.065583, "o", "Filling Net Exports % of GDP (H35:L40)...\r\n  H35: =(H12-H19)/H26*100\r\n"]
[96.065668, "o", "  I35: =(I12-I19)/I26*100\r\n  J35: =(J12-J19)/J26*100\r\n"]
[96.065982, "o", "  K35: =(K12-K19)/K26*100\r\n  L35: =(L12-L19)/L26*100\r\n  H36: =(H13-H20)/H27*100\r\n  I36: =(I13-I20)/I27*100\r\n  J36: =(J13-J20)/J27*100\r\n  K36: =(K13-K20)/K27*100\r\n  L36: =(L13-L20)/L27*100\r\n  H37: =(H14-H21)/H28*100\r\n  I37: =(I14-I21)/I28*100\r\n"]
[96.066015, "o", "  J37: =(J14-J21)/J28*100\r\n"]
[96.067399, "o", "  K37: =(K14-K21)/K28*100\r\n  L37: =(L14-L21)/L28*100\r\n  H38: =(H15-H22)/H29*100\r\n  I38: =(I15-I22)/I29*100\r\n  J38: =(J15-J22)/J29*100\r\n  K38: =(K15-K22)/K29*100\r\n  L38: =(L15-L22)/L29*100\r\n  H39: =(H16-H23)/H30*100\r\n  I39: =(I16-I23)/I30*100\r\n  J39: =(J16-J23)/J30*100\r\n  K39: =(K16-K23)/K30*100\r\n  L39: =(L16-L23)/L30*100\r\n  H40: =(H17-H24)/H31*100\r\n  I40: =(I17-I24)/I31*100\r\n  J40: =(J17-J24)/J31*100\r\n  K40: =(K17-K24)/K31*100\r\n  L40: =(L17-L24)/L31*100\r\n"]
[97.040743, "o", "\r\nNet Exports % of GDP formulas saved!\r\n"]
[97.146666, "o", "\u001b[?2004hroot@8ca429510c12:~# "]
[102.648357, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== TASK SHEET - Rows 42-55 ===\")\nfor row in range(42, 56):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 14):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n        value = str(cell.value)[:50] if cell.value else 'None'\n        print(f\"  {col_letter}{row}: {value}\")\n\nwb.close()\nEOF\n"]
