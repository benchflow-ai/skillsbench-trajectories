[72.900177, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"=== DATA SHEET - Row 4 (Headers) ===\")\nfor col in range(1, 15):\n    cell = data_sheet.cell(4, col)\n    col_letter = chr(64+col)\n    print(f\"{col_letter}4: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - Rows 5-40 (Data rows) ===\")\nfor row in range(5, 41):\n    b_val = data_sheet.cell(row, 2).value  # Series code\n    c_val = data_sheet.cell(row, 3).value  # Country\n    d_val = data_sheet.cell(row, 4).value  # Indicator\n    h_val = data_sheet.cell(row, 8).value  # 2018 data\n    i_val = data_sheet.cell(row, 9).value  # 2019 data\n    if b_val or c_val:\n        print(f\"Row {row}: Series={b_val}, Country={c_val}, Indicator={d_val}, 2018={h_val}, 2019={i_val}\")\n\nwb.close()\nEOF\n"]
