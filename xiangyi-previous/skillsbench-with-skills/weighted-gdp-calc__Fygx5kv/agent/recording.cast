[115.021637, "o", "\u001b[?2004hroot@8ca429510c12:~# "]
[122.092427, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"Adding weighted mean formula (Row 50)...\\n\")\n\n# Row 50: Weighted Mean using SUMPRODUCT\n# Weighted mean = SUMPRODUCT(Net Exports %, GDP) / SUM(GDP)\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    # Net Exports % values are in rows 35-40\n    # GDP values (weights) are in rows 26-31\n    formula = f\"=SUMPRODUCT({col_letter}35:{col_letter}40,{col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)\"\n    task_sheet[f\"{col_letter}50\"] = formula\n    print(f\"  {col_letter}50: {formula}\")\n\nwb.save('/root/gdp.xlsx')\nprint(\"\\nWeighted mean formula saved!\")\nwb.close()\nEOF\n"]
[122.092861, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]
