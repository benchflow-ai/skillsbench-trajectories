[55.397743, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== TASK SHEET - Rows 26-45 ===\")\nfor row in range(26, 46):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 14):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n        value = str(cell.value)[:40] if cell.value else 'None'\n        print(f\"  {col_letter}{row}: {value}\")\n\nwb.close()\nEOF\n"]
