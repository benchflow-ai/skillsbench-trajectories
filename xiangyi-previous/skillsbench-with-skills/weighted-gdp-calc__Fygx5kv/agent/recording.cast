[30.300901, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ndata_sheet = wb['Data']\n\nprint(\"=== DATA SHEET - Row 1 (Headers) ===\")\nfor col in range(1, 15):\n    cell = data_sheet.cell(1, col)\n    col_letter = chr(64+col) if col <= 26 else chr(64 + col//26) + chr(64 + col%26)\n    print(f\"Col {col_letter}: {cell.value}\")\n\nprint(\"\\n=== DATA SHEET - Rows 20-30 (Sample) ===\")\nfor row in range(20, 31):\n    print(f\"\\nRow {row}:\")\n    row_data = []\n    for col in range(1, 10):\n        cell = data_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        row_data.append(f\"{col_letter}:{cell.value}\")\n    print(\"  \" + \" | \".join(row_data))\n\nwb.close()\nEOF\n"]
