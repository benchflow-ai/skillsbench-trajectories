[46.152718, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.styles import PatternFill\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== TASK SHEET - Rows 1-20, Columns A-M ===\")\nfor row in range(1, 21):\n    print(f\"\\nRow {row}:\")\n    for col in range(1, 14):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col) if col <= 26 else 'A' + chr(64 + col - 26)\n        fill = cell.fill\n        fill_color = fill.start_color.rgb if fill and fill.start_color else 'None'\n        value = str(cell.value)[:30] if cell.value else 'None'\n        print(f\"  {col_letter}{row}: {value} (fill: {fill_color})\")\n\nwb.close()\nEOF\n"]
