[131.333192, "o", "=== VERIFICATION: Checking formulas ===\r\n\r\nExports data (H12:L12):\r\n  H12: =INDEX(Data.$H:$M,MATCH($D12,Data.$B:$B,0),MATCH(H$9,Data.$4:$4,0))\r\n  I12: =INDEX(Data.$H:$M,MATCH($D12,Data.$B:$B,0),MATCH(I$9,Data.$4:$4,0))\r\n  J12: =INDEX(Data.$H:$M,MATCH($D12,Data.$B:$B,0),MATCH(J$9,Data.$4:$4,0))\r\n  K12: =INDEX(Data.$H:$M,MATCH($D12,Data.$B:$B,0),MATCH(K$9,Data.$4:$4,0))\r\n  L12: =INDEX(Data.$H:$M,MATCH($D12,Data.$B:$B,0),MATCH(L$9,Data.$4:$4,0))\r\n\r\nImports data (H19:L19):\r\n  H19: =INDEX(Data.$H:$M,MATCH($D19,Data.$B:$B,0),MATCH(H$9,Data.$4:$4,0))\r\n  I19: =INDEX(Data.$H:$M,MATCH($D19,Data.$B:$B,0),MATCH(I$9,Data.$4:$4,0))\r\n"]
[131.333381, "o", "  J19: =INDEX(Data.$H:$M,MATCH($D19,Data.$B:$B,0),MATCH(J$9,Data.$4:$4,0))\r\n  K19: =INDEX(Data.$H:$M,MATCH($D19,Data.$B:$B,0),MATCH(K$9,Data.$4:$4,0))\r\n  L19: =INDEX(Data.$H:$M,MATCH($D19,Data.$B:$B,0),MATCH(L$9,Data.$4:$4,0))\r\n\r\nGDP data (H26:L26):\r\n  H26: =INDEX(Data.$H:$M,MATCH($D26,Data.$B:$B,0),MATCH(H$9,Data.$4:$4,0))\r\n  I26: =INDEX(Data.$H:$M,MATCH($D26,Data.$B:$B,0),MATCH(I$9,Data.$4:$4,0))\r\n  J26: =INDEX(Data.$H:$M,MATCH($D26,Data.$B:$B,0),MATCH(J$9,Data.$4:$4,0))\r\n  K26: =INDEX(Data.$H:$M,MATCH($D26,Data.$B:$B,0),MATCH(K$9,Data.$4:$4,0))\r\n  L26: =INDEX(Data.$H:$M,MATCH($D26,Data.$B:$B,0),MATCH(L$9,Data.$4:$4,0))\r\n\r\nNet Exports % of GDP (H35:L35):\r\n  H35: =(H12-H19)/H26*100\r\n  I35: =(I12-I19)/I26*100\r\n  J35: =(J12-J19)/J26*100\r\n  K35: =(K12-K19)/K26*100\r\n  L35: =(L12-L19)/L26*100\r\n\r\nStatistics (Row 42-47, Column H):\r\n  H42: =MIN(H35:H40)\r\n  H43: =MAX(H35:H40)\r\n  H44: =MEDIAN(H35:H40)\r\n  H45: =AVERAGE(H35:H40)\r\n  H46: =PERCENTILE(H35:H40,0.25)\r\n  H47: =PERCENTILE(H35:H40,0.75)\r\n\r\nWeighted Mean (H50:L50):\r\n  H50: =SUMPRODUCT(H35:H40,H26:H31)/SUM(H26:H31)\r\n  I50: =SUMPRODUCT(I35:I40,I26:I31)/SUM(I26:I31)\r\n  J50: =SUMPRODUCT(J35:J40,J26:J31)/SUM(J26:J31)\r\n  K50: =SUMPRODUCT(K35:K40,K26:K31)/SUM(K26:K31)\r\n  L50: =SUMPRODUCT(L35:L40,L26:L31)/SUM(L26:L31)\r\n"]
