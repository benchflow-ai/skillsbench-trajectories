[256.228346, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/gdp.xlsx')\ntask_sheet = wb['Task']\n\nprint(\"=== COMPREHENSIVE FORMULA CHECK ===\")\n\n# Check Exports (H12:L17)\nprint(\"\\nExports Data (H12:L17) - All formulas should be INDEX/MATCH:\")\nall_have_formulas = True\nfor row in range(12, 18):\n    for col in range(8, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        if cell.value is None:\n            print(f\"  ❌ {col_letter}{row}: EMPTY\")\n            all_have_formulas = False\n        elif isinstance(cell.value, str) and cell.value.startswith('=INDEX'):\n            print(f\"  ✓ {col_letter}{row}: Has INDEX/MATCH formula\")\n        else:\n            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All Exports cells have formulas\")\n\n# Check Imports (H19:L24)\nprint(\"\\nImports Data (H19:L24) - All formulas should be INDEX/MATCH:\")\nall_have_formulas = True\nfor row in range(19, 25):\n    for col in range(8, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        if cell.value is None:\n            print(f\"  ❌ {col_letter}{row}: EMPTY\")\n            all_have_formulas = False\n        elif isinstance(cell.value, str) and cell.value.startswith('=INDEX'):\n            print(f\"  ✓ {col_letter}{row}: Has INDEX/MATCH formula\")\n        else:\n            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All Imports cells have formulas\")\n\n# Check GDP (H26:L31)\nprint(\"\\nGDP Data (H26:L31) - All formulas should be INDEX/MATCH:\")\nall_have_formulas = True\nfor row in range(26, 32):\n    for col in range(8, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        if cell.value is None:\n            print(f\"  ❌ {col_letter}{row}: EMPTY\")\n            all_have_formulas = False\n        elif isinstance(cell.value, str) and cell.value.startswith('=INDEX'):\n            print(f\"  ✓ {col_letter}{row}: Has INDEX/MATCH formula\")\n        else:\n            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All GDP cells have formulas\")\n\n# Check Net Exports % (H35:L40)\nprint(\"\\nNet Exports % of GDP (H35:L40) - All formulas should be calculation formulas:\")\nall_have_formulas = True\nfor row in range(35, 41):\n    for col in range(8, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        if cell.value is None:\n            print(f\"  ❌ {col_letter}{row}: EMPTY\")\n            all_have_formulas = False\n        elif isinstance(cell.value, str) and '=' in cell.value:\n            print(f\"  ✓ {col_letter}{row}: Has formula\")\n        else:\n            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All Net Exports cells have formulas\")\n\n# Check Statistics (H42:L47)\nprint(\"\\nStatistics (H42:L47) - All formulas should be statistical functions:\")\nall_have_formulas = True\nfor row in range(42, 48):\n    for col in range(8, 13):\n        cell = task_sheet.cell(row, col)\n        col_letter = chr(64+col)\n        if cell.value is None:\n            print(f\"  ❌ {col_letter}{row}: EMPTY\")\n            all_have_formulas = False\n        elif isinstance(cell.value, str) and '=' in cell.value:\n            print(f\"  ✓ {col_letter}{row}: Has formula\")\n        else:\n            print(f\"  ⚠ {col_letter}{row}: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All Statistics cells have formulas\")\n\n# Check Weighted Mean (H50:L50)\nprint(\"\\nWeighted Mean (H50:L50) - All formulas should be SUMPRODUCT:\")\nall_have_formulas = True\nfor col in range(8, 13):\n    cell = task_sheet.cell(50, col)\n    col_letter = chr(64+col)\n    if cell.value is None:\n        print(f\"  ❌ {col_letter}50: EMPTY\")\n        all_have_formulas = False\n    elif isinstance(cell.value, str) and 'SUMPRODUCT' in cell.value:\n        print(f\"  ✓ {col_letter}50: Has SUMPRODUCT formula\")\n    else:\n        print(f\"  ⚠ {col_letter}50: {cell.value}\")\n\nif all_have_formulas:\n    print(\"  ✓ All Weighted Mean cells have formulas\")\n\nwb.cl"]
[256.228413, "i", "ose()\nEOF\n"]
