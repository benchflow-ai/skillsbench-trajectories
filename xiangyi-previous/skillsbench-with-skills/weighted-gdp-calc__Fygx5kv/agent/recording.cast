[114.29215, "o", "  I42: =MIN(I35:I40)\r\n  J42: =MIN(J35:J40)\r\n  K42: =MIN(K35:K40)\r\n  L42: =MIN(L35:L40)\r\n\r\nRow 43 (MAX):\r\n  H43: =MAX(H35:H40)\r\n  I43: =MAX(I35:I40)\r\n  J43: =MAX(J35:J40)\r\n  K43: =MAX(K35:K40)\r\n  L43: =MAX(L35:L40)\r\n\r\nRow 44 (MEDIAN):\r\n  H44: =MEDIAN(H35:H40)\r\n  I44: =MEDIAN(I35:I40)\r\n  J44: =MEDIAN(J35:J40)\r\n  K44: =MEDIAN(K35:K40)\r\n  L44: =MEDIAN(L35:L40)\r\n\r\n"]
[114.292206, "o", "Row 45 (AVERAGE):\r\n  H45: =AVERAGE(H35:H40)\r\n  I45: =AVERAGE(I35:I40)\r\n"]
