[?2004l[?2004h>     values='EARNERS',
[?2004l[?2004h>     aggfunc='sum',
[?2004l[?2004h>     fill_value=0
[?2004l[?2004h> ).reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Source Data - prepare the enriched data
[?2004l[?2004h> source_data = merged_df[['SA2_CODE', 'SA2_NAME', 'STATE', 'POPULATION_2023', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', 'Quarter', 'Total']].copy()
[?2004l[?2004h> 
