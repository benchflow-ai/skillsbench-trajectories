[?2004hroot@32b98887f65e:~# cat > /root/create_report.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> from openpyxl import Workbook
[?2004l[?2004h> from openpyxl.utils.dataframe import dataframe_to_rows
[?2004l[?2004h> 
[?2004l[?2004h> # Extract population data from PDF
[?2004l[?2004h> print("Extracting population data from PDF...")
[?2004l[?2004h> all_rows = []
[?2004l[?2004h> with pdfplumber.open('/root/population.pdf') as pdf:
[?2004l[?2004h>     for page_num, page in enumerate(pdf.pages):
[?2004l[?2004h>         tables = page.extract_tables()
[?2004l[?2004h>         for table in tables:
[?2004l[?2004h>             for i, row in enumerate(table):
[?2004l[?2004h>                 # Skip header rows (first row of first page or repeated headers)
[?2004l[?2004h>                 if row[0] == 'SA2_CODE':
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 if len(row) >= 4 and row[0]:
[?2004l[?2004h>                     all_rows.append(row[:4])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Extracted {len(all_rows)} rows from PDF")
[?2004l[?2004h> 
[?2004l[?2004h> # Create population dataframe
[?2004l[?2004h> pop_df = pd.DataFrame(all_rows, columns=['SA2_CODE', 'SA2_NAME', 'STATE', 'POPULATION_2023'])
[?2004l[?2004h> pop_df['SA2_CODE'] = pd.to_numeric(pop_df['SA2_CODE'], errors='coerce')
[?2004l[?2004h> pop_df['POPULATION_2023'] = pd.to_numeric(pop_df['POPULATION_2023'], errors='coerce')
[?2004l[?2004h> pop_df = pop_df.dropna(subset=['SA2_CODE'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Population dataframe shape: {pop_df.shape}")
[?2004l[?2004h> print(pop_df.head())
[?2004l[?2004h> 
[?2004l[?2004h> # Read income data
[?2004l[?2004h> print("\nReading income data...")
[?2004l[?2004h> income_df = pd.read_excel('/root/income.xlsx')
[?2004l[?2004h> print(f"Income dataframe shape: {income_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Merge dataframes
[?2004l[?2004h> print("\nMerging dataframes...")
[?2004l[?2004h> merged_df = pd.merge(pop_df, income_df, on='SA2_CODE', how='inner', suffixes=('', '_income'))
[?2004l[?2004h> # Keep only one SA2_NAME column
[?2004l[?2004h> if 'SA2_NAME_income' in merged_df.columns:
[?2004l[?2004h>     merged_df = merged_df.drop(columns=['SA2_NAME_income'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Merged dataframe shape: {merged_df.shape}")
[?2004l[?2004h> print(merged_df.head())
[?2004l[?2004h> 
[?2004l[?2004h> # Convert EARNERS and MEDIAN_INCOME to numeric
[?2004l[?2004h> merged_df['EARNERS'] = pd.to_numeric(merged_df['EARNERS'], errors='coerce')
[?2004l[?2004h> merged_df['MEDIAN_INCOME'] = pd.to_numeric(merged_df['MEDIAN_INCOME'], errors='coerce')
[?2004l[?2004h> merged_df['MEAN_INCOME'] = pd.to_numeric(merged_df['MEAN_INCOME'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Create quartiles based on MEDIAN_INCOME
[?2004l[?2004h> print("\nCreating quartiles...")
[?2004l[?2004h> merged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
[?2004l[?2004h> 
[?2004l[?2004h> # Create Total column
[?2004l[?2004h> merged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']
[?2004l[?2004h> 
[?2004l[?2004h> print(merged_df[['SA2_NAME', 'MEDIAN_INCOME', 'Quarter', 'Total']].head(10))
[?2004l[?2004h> 
[?2004l[?2004h> # Create pivot tables
[?2004l[?2004h> print("\nCreating pivot tables...")
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Population by State
[?2004l[?2004h> pivot_pop = merged_df.pivot_table(
[?2004l[?2004h>     index='STATE',
[?2004l[?2004h>     values='POPULATION_2023',
[?2004l[?2004h>     aggfunc='sum'
[?2004l[?2004h> ).reset_index()
[?2004l[?2004h> pivot_pop.columns = ['STATE', 'Sum of POPULATION_2023']
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Earners by State
[?2004l[?2004h> pivot_earners = merged_df.pivot_table(
[?2004l[?2004h>     index='STATE',
[?2004l[?2004h>     values='EARNERS',
[?2004l[?2004h>     aggfunc='sum'
[?2004l[?2004h> ).reset_index()
[?2004l[?2004h> pivot_earners.columns = ['STATE', 'Sum of EARNERS']
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Regions by State (count of SA2 regions)
[?2004l[?2004h> pivot_regions = merged_df.groupby('STATE').size().reset_index(name='Count')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. State Income Quartile
[?2004l[?2004h> pivot_quartile = merged_df.pivot_table(
