[51.194422, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.194486, "o", "# 3. Regions by State (count of SA2 regions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.194538, "o", "> "]
[51.194615, "o", "pivot_regions = merged_df.groupby('STATE').size().reset_index(name='Count')\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.19469, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.194739, "o", "# 4. State Income Quartile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.194787, "o", "pivot_quartile = merged_df.pivot_table(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.194826, "o", "    index='STATE',\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.194883, "o", "> "]
[51.194927, "o", "    columns='Quarter',\r\n\u001b[?2004l\r\u001b[?2004h>     values='EARNERS',\r\n\u001b[?2004l\r"]
[51.194987, "o", "\u001b[?2004h> "]
[51.19503, "o", "    aggfunc='sum',\r\n\u001b[?2004l\r\u001b[?2004h>     fill_value=0\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.195082, "o", "> "]
[51.195126, "o", ").reset_index()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.195175, "o", "# 5. Source Data - prepare the enriched data\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.195226, "o", "> "]
[51.195413, "o", "source_data = merged_df[['SA2_CODE', 'SA2_NAME', 'STATE', 'POPULATION_2023', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', 'Quarter', 'Total']].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.195475, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.195519, "o", "print(\"\\nPivot tables created successfully\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.195573, "o", "> "]
[51.195611, "o", "print(f\"Population by State: {pivot_pop.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.195697, "o", "print(f\"Earners by State: {pivot_earners.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.195752, "o", "> "]
[51.195795, "o", "print(f\"Regions by State: {pivot_regions.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.19584, "o", "> "]
[51.195891, "o", "print(f\"State Income Quartile: {pivot_quartile.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.195945, "o", "> "]
[51.195998, "o", "print(f\"Source Data: {source_data.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.196048, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Write to Excel\r\n\u001b[?2004l\r"]
[51.196096, "o", "\u001b[?2004h> "]
[51.196143, "o", "print(\"\\nWriting to Excel...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.196248, "o", "with pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.196292, "o", "> "]
[51.19639, "o", "    pivot_pop.to_excel(writer, sheet_name='Population by State', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.196503, "o", "    pivot_earners.to_excel(writer, sheet_name='Earners by State', index=False)\r\n\u001b[?2004l\r"]
[51.196555, "o", "\u001b[?2004h> "]
[51.196638, "o", "    pivot_regions.to_excel(writer, sheet_name='Regions by State', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.196661, "o", "> "]
[51.196842, "o", "    pivot_quartile.to_excel(writer, sheet_name='State Income Quartile', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.196898, "o", "    source_data.to_excel(writer, sheet_name='SourceData', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.196946, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.197035, "o", "print(\"\\nReport saved to /root/demographic_analysis.xlsx\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.197093, "o", "> EOF\r\n\u001b[?2004l\r"]
