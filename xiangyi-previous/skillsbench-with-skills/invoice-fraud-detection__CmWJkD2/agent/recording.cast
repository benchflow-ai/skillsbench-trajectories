[59.377214, "i", "cat << 'EOF' > check_v_mismatch.py\nimport pandas as pd\nimport pdfplumber\nfrom rapidfuzz import process, fuzz\n\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npos_df = pd.read_csv('/root/purchase_orders.csv')\nvendors = vendors_df.to_dict('records')\nvendor_names = [v['name'] for v in vendors]\n\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for i, page in enumerate(pdf.pages):\n        text = page.extract_text()\n        lines = text.split('\\n')\n        v_name, po_num = None, None\n        for line in lines:\n            if line.startswith('From:'): v_name = line.replace('From:', '').strip()\n            if 'PO Number:' in line: po_num = line.split('PO Number:')[-1].strip()\n        \n        best_match = process.extractOne(v_name, vendor_names, scorer=fuzz.token_sort_ratio)\n        if best_match and best_match[1] >= 80:\n            matched_vendor = next(v for v in vendors if v['name'] == best_match[0])\n            po_row = pos_df[pos_df['po_number'] == po_num]\n            if not po_row.empty:\n                po_data = po_row.iloc[0]\n                if po_data['vendor_id'] != matched_vendor['id']:\n                    print(f\"Page {i+1}: Vendor {v_name} ({matched_vendor['id']}) PO {po_num} (linked to {po_data['vendor_id']})\")\nEOF\npython3 check_v_mismatch.py\n"]
