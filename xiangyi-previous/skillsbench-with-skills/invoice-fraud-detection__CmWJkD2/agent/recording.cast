[35.201524, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.201568, "o", "> "]
[35.201616, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.201711, "o", "            po_data = po_row.iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.201765, "o", "> \r\n\u001b[?2004l\r"]
[35.201816, "o", "\u001b[?2004h> "]
[35.201866, "o", "            # 4. Amount Mismatch\r\n\u001b[?2004l\r"]
[35.201918, "o", "\u001b[?2004h> "]
[35.202021, "o", "            if abs(amount - po_data['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.202066, "o", "> "]
[35.202135, "o", "                fraud_report.append({\r\n\u001b[?2004l\r"]
[35.202199, "o", "\u001b[?2004h> "]
[35.202301, "o", "                    \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r"]
[35.202347, "o", "\u001b[?2004h> "]
[35.202442, "o", "                    \"vendor_name\": vendor_name,\r\n\u001b[?2004l\r"]
[35.202492, "o", "\u001b[?2004h> "]
[35.202584, "o", "                    \"invoice_amount\": amount,\r\n\u001b[?2004l\r"]
[35.202628, "o", "\u001b[?2004h> "]
[35.202692, "o", "                    \"iban\": iban,\r\n\u001b[?2004l\r"]
[35.202734, "o", "\u001b[?2004h> "]
[35.202936, "o", "                    \"po_number\": po_number if po_number != \"None\" else None,\r\n\u001b[?2004l\r"]
[35.202988, "o", "\u001b[?2004h> "]
[35.203086, "o", "                    \"reason\": \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.203138, "o", "> "]
[35.203182, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.203248, "o", "                continue\r\n\u001b[?2004l\r"]
[35.203302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.203351, "o", "> "]
[35.203401, "o", "            # 5. Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.20355, "o", "            if po_data['vendor_id'] != matched_vendor['id']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.203597, "o", "> "]
[35.203672, "o", "                fraud_report.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.203723, "o", "> "]
[35.203837, "o", "                    \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.203885, "o", "> "]
[35.203988, "o", "                    \"vendor_name\": vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.204038, "o", "> "]
[35.204122, "o", "                    \"invoice_amount\": amount,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.204177, "o", "> "]
[35.204223, "o", "                    \"iban\": iban,\r\n\u001b[?2004l\r"]
[35.204273, "o", "\u001b[?2004h> "]
[35.204444, "o", "                    \"po_number\": po_number if po_number != \"None\" else None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.204501, "o", "> "]
[35.204578, "o", "                    \"reason\": \"Vendor Mismatch\"\r\n\u001b[?2004l\r"]
[35.204625, "o", "\u001b[?2004h> "]
[35.204671, "o", "                })\r\n\u001b[?2004l\r"]
[35.204723, "o", "\u001b[?2004h> "]
[35.204774, "o", "                continue\r\n\u001b[?2004l\r"]
[35.204824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.20495, "o", "    with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.205005, "o", "> "]
[35.205088, "o", "        json.dump(fraud_report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.205138, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.205188, "o", "solve()\r\n\u001b[?2004l\r\u001b[?2004h> "]
