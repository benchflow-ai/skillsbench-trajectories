[104.380342, "o", "\u001b[?2004hroot@0dfa82c9f32d:~# "]
[117.99342, "i", "cat << 'EOF' > analyze_invoices.py\nimport pandas as pd\nimport pdfplumber\nimport json\nimport re\nfrom rapidfuzz import process, fuzz\n\ndef solve():\n    vendors_df = pd.read_excel('/root/vendors.xlsx')\n    pos_df = pd.read_csv('/root/purchase_orders.csv')\n\n    # Convert vendors to list of dicts for easier search\n    vendors = vendors_df.to_dict('records')\n    vendor_names = [v['name'] for v in vendors]\n\n    fraud_report = []\n\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        for i, page in enumerate(pdf.pages):\n            text = page.extract_text()\n            if not text:\n                continue\n\n            lines = text.split('\\n')\n            vendor_name = None\n            amount = None\n            iban = None\n            po_number = None\n\n            for line in lines:\n                if line.startswith('From:'):\n                    vendor_name = line.replace('From:', '').strip()\n                elif 'Total $' in line:\n                    amount_str = line.split('Total $')[-1].strip()\n                    amount = float(amount_str)\n                elif 'Payment IBAN:' in line:\n                    iban = line.split('Payment IBAN:')[-1].strip()\n                elif 'PO Number:' in line:\n                    po_val = line.split('PO Number:')[-1].strip()\n                    if po_val and po_val != 'None':\n                        po_number = po_val\n            \n            page_num = i + 1\n\n            # 1. Unknown Vendor\n            best_match = process.extractOne(vendor_name, vendor_names, scorer=fuzz.token_sort_ratio)\n            \n            matched_vendor = None\n            if best_match and best_match[1] >= 80: # Threshold for fuzzy matching\n                matched_vendor = next(v for v in vendors if v['name'] == best_match[0])\n            \n            if not matched_vendor:\n                fraud_report.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": vendor_name,\n                    \"invoice_amount\": amount,\n                    \"iban\": iban,\n                    \"po_number\": po_number,\n                    \"reason\": \"Unknown Vendor\"\n                })\n                continue\n\n            # 2. IBAN Mismatch\n            if iban != matched_vendor['iban']:\n                fraud_report.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": vendor_name,\n                    \"invoice_amount\": amount,\n                    \"iban\": iban,\n                    \"po_number\": po_number,\n                    \"reason\": \"IBAN Mismatch\"\n                })\n                continue\n\n            # 3. Invalid PO\n            po_row = pos_df[pos_df['po_number'] == po_number] if po_number else pd.DataFrame()\n            if po_row.empty:\n                fraud_report.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": vendor_name,\n                    \"invoice_amount\": amount,\n                    \"iban\": iban,\n                    \"po_number\": po_number,\n                    \"reason\": \"Invalid PO\"\n                })\n                continue\n            \n            po_data = po_row.iloc[0]\n\n            # 4. Amount Mismatch\n            if abs(amount - po_data['amount']) > 0.01:\n                fraud_report.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": vendor_name,\n                    \"invoice_amount\": amount,\n                    \"iban\": iban,\n                    \"po_number\": po_number,\n                    \"reason\": \"Amount Mismatch\"\n                })\n                continue\n\n            # 5. Vendor Mismatch\n            if po_data['vendor_id'] != matched_vendor['id']:\n                fraud_report.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": vendor_name,\n                    \"invoice_amount\": amount,\n                    \"iban\": iban,\n                    \"po_number\": po_number,\n                    \"reason\": \"Vendor Mismatch\"\n                })\n                continue\n\n    with open('/root/fraud_report.json', "]
[117.993492, "i", "'w') as f:\n        json.dump(fraud_report, f, indent=2)\n\nsolve()\nEOF\npython3 analyze_invoices.py\n"]
