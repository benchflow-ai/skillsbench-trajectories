[178.193614, "i", "cat > /tmp/compare_part4.txt << 'EOF'\n\nconst AdvancedAnalysis = memo(function AdvancedAnalysis({ products }: { products: Product[] }) {\n  const { priceStats, ratingStats, reviewStats, sortedByValue } = useMemo(() => {\n    const prices = products.map(p => p.price);\n    const ratings = products.map(p => p.rating);\n    const reviews = products.map(p => p.reviews);\n    return {\n      priceStats: {\n        mean: calculateMean(prices),\n        median: calculateMedian(prices),\n        std: calculateStd(prices),\n        variance: calculateVariance(prices),\n        q1: calculateQuantile(prices, 0.25),\n        q3: calculateQuantile(prices, 0.75),\n      },\n      ratingStats: {\n        mean: calculateMean(ratings),\n        median: calculateMedian(ratings),\n        std: calculateStd(ratings),\n      },\n      reviewStats: {\n        mean: calculateMean(reviews),\n        median: calculateMedian(reviews),\n        std: calculateStd(reviews),\n      },\n      sortedByValue: products.map(p => ({\n        name: p.name,\n        score: (p.rating / p.price) * 100,\n      })).sort((a, b) => b.score - a.score),\n    };\n  }, [products]);\n\n  return (\n    <div data-testid=\"advanced-content\" className=\"bg-white rounded-xl shadow-md p-6\">\n      <h2 className=\"text-xl font-bold mb-4\">Advanced Statistical Analysis</h2>\n      <div className=\"grid grid-cols-3 gap-6\">\n        <div>\n          <h3 className=\"font-semibold mb-3 text-gray-700\">Price Distribution</h3>\n          <div className=\"space-y-2 text-sm\">\n            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">${priceStats.mean.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Median:</span><span className=\"font-mono\">${priceStats.median.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Std Dev:</span><span className=\"font-mono\">${priceStats.std.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Variance:</span><span className=\"font-mono\">{priceStats.variance.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Q1 (25%):</span><span className=\"font-mono\">${priceStats.q1.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Q3 (75%):</span><span className=\"font-mono\">${priceStats.q3.toFixed(2)}</span></div>\n          </div>\n        </div>\n        <div>\n          <h3 className=\"font-semibold mb-3 text-gray-700\">Rating Analysis</h3>\n          <div className=\"space-y-2 text-sm\">\n            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">{ratingStats.mean.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Median:</span><span className=\"font-mono\">{ratingStats.median.toFixed(2)}</span></div>\n            <div className=\"flex justify-between\"><span>Std Dev:</span><span className=\"font-mono\">{ratingStats.std.toFixed(3)}</span></div>\n          </div>\n        </div>\n        <div>\n          <h3 className=\"font-semibold mb-3 text-gray-700\">Review Volume</h3>\n          <div className=\"space-y-2 text-sm\">\n            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">{reviewStats.mean.toFixed(0)}</span></div>\n            <div className=\"flex justify-between\"><span>Median:</span><span className=\"font-mono\">{reviewStats.median.toFixed(0)}</span></div>\n            <div className=\"flex justify-between\"><span>Std Dev:</span><span className=\"font-mono\">{reviewStats.std.toFixed(0)}</span></div>\n          </div>\n        </div>\n      </div>\nEOF\n"]
