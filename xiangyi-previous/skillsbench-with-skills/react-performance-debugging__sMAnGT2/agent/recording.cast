[150.023148, "i", "cat > /tmp/compare_part2.txt << 'EOF'\n\nfunction sortByKey<T>(arr: T[], key: keyof T): T[] {\n  return [...arr].sort((a, b) => {\n    if (a[key] < b[key]) return -1;\n    if (a[key] > b[key]) return 1;\n    return 0;\n  });\n}\n\nfunction meanByKey<T>(arr: T[], key: keyof T): number {\n  return arr.reduce((sum, item) => sum + (item[key] as number), 0) / arr.length;\n}\n\nfunction sumByKey<T>(arr: T[], key: keyof T): number {\n  return arr.reduce((sum, item) => sum + (item[key] as number), 0);\n}\n\nfunction maxByKey<T>(arr: T[], key: keyof T): T | undefined {\n  return arr.reduce((max, item) => (item[key] > max[key] ? item : max), arr[0]);\n}\n\nfunction minByKey<T>(arr: T[], key: keyof T): T | undefined {\n  return arr.reduce((min, item) => (item[key] < min[key] ? item : min), arr[0]);\n}\n\ninterface Product {\n  id: string;\n  name: string;\n  price: number;\n  category: string;\n  rating: number;\n  reviews: number;\n  inStock: boolean;\n}\n\nconst PRODUCTS: Product[] = [\n  { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },\n  { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },\n  { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },\n  { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },\n  { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },\n];\nEOF\n"]
