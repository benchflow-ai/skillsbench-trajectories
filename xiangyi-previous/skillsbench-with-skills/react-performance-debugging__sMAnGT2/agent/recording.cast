[81.518863, "o", "  const body = await request.json().catch(() => ({}));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Fetch user and config in parallel\r\n\u001b[?2004l\r\u001b[?2004h>   const [user, config] = await Promise.all([\r\n\u001b[?2004l\r\u001b[?2004h>     fetchUserFromService(),\r\n\u001b[?2004l\r\u001b[?2004h>     fetchConfigFromService(),\r\n\u001b[?2004l\r\u001b[?2004h>   ]);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Now fetch profile (depends on user.id) - this could also be parallelized\r\n\u001b[?2004l\r\u001b[?2004h>   // if we had a way to get user.id without fetching the full user first\r\n\u001b[?2004l\r\u001b[?2004h>   const profile = await fetchProfileFromService(user.id);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return NextResponse.json({\r\n\u001b[?2004l\r\u001b[?2004h>     success: true,\r\n\u001b[?2004l\r\u001b[?2004h>     user: { id: user.id, name: user.name },\r\n\u001b[?2004l\r\u001b[?2004h>     profile,\r\n\u001b[?2004l\r\u001b[?2004h>     config: { currency: config.currency },\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
