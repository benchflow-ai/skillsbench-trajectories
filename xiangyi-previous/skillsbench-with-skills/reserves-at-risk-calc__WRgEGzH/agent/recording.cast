[125.156855, "o", "\u001b[?2004hroot@d4c18aea30b6:~# "]
[141.391185, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\ndef normalize_country(c):\n    c = c.split(':')[0].strip()\n    c = c.replace('Kyrgyz Rep', 'Kyrgyz Republic')\n    # Add more normalization if needed\n    return c\n\n# Step 1: Extract Gold Price\nimf_df = pd.read_excel('imf_data.xls', sheet_name='External', skiprows=0)\ngold_data = imf_df[['Commodity', 'PGOLD']].iloc[3:].dropna()\ngold_data.columns = ['Date', 'Price']\ngold_data['Price'] = pd.to_numeric(gold_data['Price'])\ngold_data['Log Return'] = np.log(gold_data['Price'] / gold_data['Price'].shift(1)) * 100\ngold_data['3m Vol'] = gold_data['Log Return'].rolling(window=3).std()\ngold_data['12m Vol'] = gold_data['Log Return'].rolling(window=12).std()\n\nwb = load_workbook('data/test-rar.xlsx')\nws_gold = wb['Gold price']\nfor row in ws_gold.iter_rows(min_row=2, max_row=ws_gold.max_row):\n    for cell in row:\n        cell.value = None\n\nfor i, row in enumerate(gold_data.values, start=2):\n    ws_gold.cell(row=i, column=1, value=row[0])\n    ws_gold.cell(row=i, column=2, value=row[1])\n    ws_gold.cell(row=i, column=3, value=row[2])\n    ws_gold.cell(row=i, column=4, value=row[3])\n    ws_gold.cell(row=i, column=5, value=row[4])\n\nws_answer = wb['Answer']\nlatest_data = gold_data.iloc[-1]\nlatest_3m_vol = latest_data['3m Vol']\nlatest_12m_vol = latest_data['12m Vol']\nannualized_3m_vol = latest_3m_vol * np.sqrt(12)\n\nws_answer['B3'] = latest_3m_vol\nws_answer['B4'] = latest_12m_vol\nws_answer['B5'] = annualized_3m_vol\nws_answer['B6'] = latest_data['Price']\n\n# Step 2\ndef get_df_from_sheet(sheet_name):\n    df = pd.read_excel('data/test-rar.xlsx', sheet_name=sheet_name)\n    return df\n\ndf_val = get_df_from_sheet('Value')\ndf_vol = get_df_from_sheet('Volume')\ndf_res = get_df_from_sheet('Total Reserves')\n\nrow_val_2025 = df_val[df_val.iloc[:, 0].astype(str) == '2025'].iloc[0]\nrow_vol_2025 = df_vol[df_vol.iloc[:, 0].astype(str) == '2025'].iloc[0]\nrow_res_2025 = df_res[df_res.iloc[:, 0].astype(str) == '2025'].iloc[0]\n\n# Jan-Sep 2025 average gold price\ngold_2025 = gold_data[gold_data['Date'].str.contains('2025M')]\ngold_2025_jan_sep = gold_2025[gold_2025['Date'].str.match('2025M[1-9]$')]\navg_price_2025 = gold_2025_jan_sep['Price'].mean()\n\ncountries_step2 = {} # name -> value\n\nfor col in df_val.columns[2:]:\n    val = row_val_2025[col]\n    if pd.notnull(val):\n        name = normalize_country(col)\n        countries_step2[name] = val\n\nfor col in df_vol.columns[2:]:\n    val = row_vol_2025[col]\n    if pd.notnull(val):\n        name = normalize_country(col)\n        if name not in countries_step2:\n            # Convert Volume to Value\n            if 'Thous' in col:\n                value = (val / 1000) * avg_price_2025\n            else:\n                value = val * avg_price_2025\n            countries_step2[name] = value\n\n# Fill Step 2\nfor i, (name, val) in enumerate(countries_step2.items(), start=2):\n    ws_answer.cell(row=11, column=i, value=name)\n    ws_answer.cell(row=12, column=i, value=val)\n    ws_answer.cell(row=13, column=i, value=val * annualized_3m_vol / 100)\n\n# Step 3\nres_dict = {}\nfor col in df_res.columns[2:]:\n    val = row_res_2025[col]\n    if pd.notnull(val):\n        name = normalize_country(col)\n        res_dict[name] = val\n\nstep3_final = []\nfor name, val in countries_step2.items():\n    if name in res_dict:\n        step3_final.append((name, val, annualized_3m_vol, res_dict[name]))\n\nfor i, (name, val, vol, res) in enumerate(step3_final, start=2):\n    ws_answer.cell(row=20, column=i, value=name)\n    ws_answer.cell(row=21, column=i, value=val)\n    ws_answer.cell(row=22, column=i, value=vol)\n    ws_answer.cell(row=23, column=i, value=res)\n    ws_answer.cell(row=24, column=i, value=(val * vol / 100) / res)\n\nwb.save('/root/output/rar_result.xlsx')\nEOF\npython3 solution.py\n"]
