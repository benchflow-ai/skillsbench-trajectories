[116.380145, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\nimport re\n\ndef get_country_name(col_name):\n    return col_name.split(':')[0].split(' ')[0].strip() if ':' in col_name else col_name\n\n# Step 1: Extract Gold Price\nimf_df = pd.read_excel('imf_data.xls', sheet_name='External', skiprows=0)\ngold_data = imf_df[['Commodity', 'PGOLD']].iloc[3:].dropna()\ngold_data.columns = ['Date', 'Price']\ngold_data['Price'] = pd.to_numeric(gold_data['Price'])\ngold_data['Log Return'] = np.log(gold_data['Price'] / gold_data['Price'].shift(1)) * 100\ngold_data['3m Vol'] = gold_data['Log Return'].rolling(window=3).std()\ngold_data['12m Vol'] = gold_data['Log Return'].rolling(window=12).std()\n\n# Write to Gold price sheet\nwb = load_workbook('data/test-rar.xlsx')\nws_gold = wb['Gold price']\nfor row in ws_gold.iter_rows(min_row=2):\n    for cell in row:\n        cell.value = None\n\nfor i, row in enumerate(gold_data.values, start=2):\n    ws_gold.cell(row=i, column=1, value=row[0])\n    ws_gold.cell(row=i, column=2, value=row[1])\n    ws_gold.cell(row=i, column=3, value=row[2])\n    ws_gold.cell(row=i, column=4, value=row[3])\n    ws_gold.cell(row=i, column=5, value=row[4])\n\n# Answer Step 1\nws_answer = wb['Answer']\nlatest_data = gold_data.iloc[-1]\nlatest_3m_vol = latest_data['3m Vol']\nlatest_12m_vol = latest_data['12m Vol']\nannualized_3m_vol = latest_3m_vol * np.sqrt(12)\n\nws_answer['B3'] = latest_3m_vol\nws_answer['B4'] = latest_12m_vol\nws_answer['B5'] = annualized_3m_vol\nws_answer['B6'] = latest_data['Price']\n\n# Step 2\ndef get_2025_data(sheet_name):\n    df = pd.read_excel('data/test-rar.xlsx', sheet_name=sheet_name)\n    row_2025 = df[df.iloc[:, 0].astype(str) == '2025']\n    if row_2025.empty:\n        return pd.Series()\n    return row_2025.iloc[0]\n\nval_2025 = get_2025_data('Value')\nvol_2025 = get_2025_data('Volume')\n\n# Jan-Sep 2025 average gold price\ngold_2025 = gold_data[gold_data['Date'].str.contains('2025M')]\ngold_2025_jan_sep = gold_2025[gold_2025['Date'].str.match('2025M[1-9]$')]\navg_price_2025 = gold_2025_jan_sep['Price'].mean()\n\ncountries_value = {}\nfor col in val_2025.index[2:]:\n    if pd.notnull(val_2025[col]):\n        cname = col.split(':')[0].strip()\n        countries_value[cname] = val_2025[col]\n\ncountries_volume = {}\nfor col in vol_2025.index[2:]:\n    if pd.notnull(vol_2025[col]):\n        cname = col.split(':')[0].strip()\n        if cname not in countries_value:\n            # Convert volume to value\n            vol = vol_2025[col]\n            if 'Thous' in col:\n                vol = vol * 1000\n            elif 'Mil' in col:\n                vol = vol * 1000000\n            # Wait, if Value is in Mil.US$, then Volume * Price should also be in Mil.US$\n            # If Volume is in Mil.Troy Ounces, then Volume * Price is already in Mil.US$\n            # If Volume is in Thous.Troy Ounces, then (Volume/1000) * Price is in Mil.US$\n            if 'Thous' in col:\n                value = (vol_2025[col] / 1000) * avg_price_2025\n            else:\n                value = vol_2025[col] * avg_price_2025\n            countries_volume[cname] = value\n\n# Combine\nall_countries = countries_value.copy()\nall_countries.update(countries_volume)\n\n# Fill Answer Step 2\nfor i, (cname, val) in enumerate(all_countries.items(), start=0):\n    ws_answer.cell(row=11, column=i+2, value=cname)\n    ws_answer.cell(row=12, column=i+2, value=val)\n    ws_answer.cell(row=13, column=i+2, value=val * annualized_3m_vol / 100)\n\n# Step 3\nres_2025 = get_2025_data('Total Reserves')\nres_dict = {}\nfor col in res_2025.index[2:]:\n    if pd.notnull(res_2025[col]):\n        cname = col.split(':')[0].strip()\n        res_dict[cname] = res_2025[col]\n\nstep3_list = []\nfor cname, val in all_countries.items():\n    if cname in res_dict:\n        step3_list.append((cname, val, annualized_3m_vol, res_dict[cname]))\n\nfor i, (cname, val, vol, tot_res) in enumerate(step3_list, start=0):\n    ws_answer.cell(row=20, column=i+2, value=cname)\n    ws_answer.cell(row=21, column=i+2, value=val)\n    ws_answer.cell(row=22, column=i+2, value=vol)\n    ws_answer.cell(row=23, column=i+2,"]
[116.380209, "i", " value=tot_res)\n    ws_answer.cell(row=24, column=i+2, value=(val * vol / 100) / tot_res)\n\nwb.save('/root/output/rar_result.xlsx')\nEOF\npython3 solution.py\n"]
[116.3804, "o", "cat << 'EOF' > solution.py\r\n"]
