[76.384646, "o", "data_volume = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.384726, "o", "for row in ws_volume.iter_rows(min_row=1, values_only=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.384787, "o", "    data_volume.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.38491, "o", "df_volume = pd.DataFrame(data_volume[1:], columns=data_volume[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[76.384951, "o", "\u001b[?2004h> "]
[76.384992, "o", "# Find countries with 2025 data in Value\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385038, "o", "> "]
[76.385133, "o", "countries_2025 = df_value[df_value[2025].notnull()][['Country Name', 2025]].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385184, "o", "> "]
[76.385223, "o", "countries_2025.columns = ['Country', 'Value']\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385269, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.385317, "o", "# Jan-Sep 2025 average gold price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.38542, "o", "gold_2025 = gold_data[gold_data['Date'].str.contains('2025M')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385466, "o", "> "]
[76.385548, "o", "gold_2025_jan_sep = gold_2025[gold_2025['Date'].str.match('2025M[1-9]$')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385602, "o", "> "]
[76.38565, "o", "avg_price_2025 = gold_2025_jan_sep['Price'].mean()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.385682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.385758, "o", "# Check additional countries in Volume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.385834, "o", "countries_in_value = set(countries_2025['Country'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.385884, "o", "> "]
[76.385923, "o", "additional_countries = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.385965, "o", "for idx, row in df_volume.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.386025, "o", "    country = row['Country Name']\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386054, "o", "> "]
[76.3861, "o", "    val_2025 = row[2025]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386122, "o", "> "]
[76.386198, "o", "    if pd.notnull(val_2025) and country not in countries_in_value:\r\n\u001b[?2004l\r"]
[76.386219, "o", "\u001b[?2004h> "]
[76.386358, "o", "        additional_countries.append({'Country': country, 'Value': val_2025 * avg_price_2025})\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.38638, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386401, "o", "> "]
[76.386432, "o", "if additional_countries:\r\n\u001b[?2004l\r"]
[76.386451, "o", "\u001b[?2004h> "]
[76.386608, "o", "    countries_2025 = pd.concat([countries_2025, pd.DataFrame(additional_countries)], ignore_index=True)\r\n\u001b[?2004l\r"]
[76.386632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386653, "o", "> "]
[76.386685, "o", "# Fill Step 2 in Answer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.38679, "o", "for i, row in enumerate(countries_2025.itertuples(), start=0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386809, "o", "> "]
[76.386892, "o", "    ws_answer.cell(row=11, column=i+2, value=row.Country)\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.386911, "o", "> "]
[76.386999, "o", "    ws_answer.cell(row=12, column=i+2, value=row.Value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.387018, "o", "> "]
[76.387245, "o", "    # Row 13: Exposure = Value * Volatility (using 3m vol annualized? or 12m? Task says \"Gold price exposure ... capture a near-term valuation swing\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.387404, "o", "    # Usually exposure is Value * Volatility. Let's use annualized 3m vol as it's common for near-term.\r\n\u001b[?2004l\r"]
[76.387423, "o", "\u001b[?2004h> "]
[76.387518, "o", "    # Re-reading: \"Calculate the Gold price exposure in row 13\". \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.387538, "o", "> "]
[76.387685, "o", "    # Exposure = Value * annualized_3m_vol / 100 (since vol is in percentage)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.387811, "o", "    ws_answer.cell(row=13, column=i+2, value=row.Value * annualized_3m_vol / 100)\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.387831, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.387853, "o", "> # Step 3\r\n\u001b[?2004l\r"]
[76.387875, "o", "\u001b[?2004h> "]
[76.387939, "o", "ws_reserves = wb['Total Reserves']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.387977, "o", "data_reserves = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.387995, "o", "> "]
[76.388094, "o", "for row in ws_reserves.iter_rows(min_row=1, values_only=True):\r\n\u001b[?2004l\r"]
[76.388117, "o", "\u001b[?2004h> "]
[76.388168, "o", "    data_reserves.append(row)\r\n\u001b[?2004l\r"]
[76.38819, "o", "\u001b[?2004h> "]
[76.388313, "o", "df_reserves = pd.DataFrame(data_reserves[1:], columns=data_reserves[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[76.388335, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[76.388369, "o", "step3_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.388445, "o", "for row in countries_2025.itertuples():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.388501, "o", "    country = row.Country\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.388546, "o", "    val = row.Value\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.388567, "o", "> "]
[76.388612, "o", "    # Find 2025 total reserves\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.388631, "o", "> "]
[76.388746, "o", "    res_2025 = df_reserves[df_reserves['Country Name'] == country][2025].values\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.388766, "o", "> "]
[76.388856, "o", "    if len(res_2025) > 0 and pd.notnull(res_2025[0]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.388875, "o", "> "]
[76.388916, "o", "        step3_data.append({\r\n\u001b[?2004l\r"]
[76.38894, "o", "\u001b[?2004h> "]
[76.388984, "o", "            'Country': country,\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389005, "o", "> "]
[76.389049, "o", "            'Value': val,\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389069, "o", "> "]
[76.389116, "o", "            'Vol': annualized_3m_vol,\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389136, "o", "> "]
[76.389198, "o", "            'TotalReserves': res_2025[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389219, "o", "> "]
[76.389241, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[76.389262, "o", "\u001b[?2004h> "]
[76.389349, "o", "for i, item in enumerate(step3_data, start=0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.389448, "o", "    ws_answer.cell(row=20, column=i+2, value=item['Country'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389467, "o", "> "]
[76.389556, "o", "    ws_answer.cell(row=21, column=i+2, value=item['Value'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389576, "o", "> "]
[76.38966, "o", "    ws_answer.cell(row=22, column=i+2, value=item['Vol'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389681, "o", "> "]
[76.389775, "o", "    ws_answer.cell(row=23, column=i+2, value=item['TotalReserves'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389795, "o", "> "]
[76.389879, "o", "    # Row 24: RaR = (Value * Vol / 100) / TotalReserves\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.389899, "o", "> "]
[76.390052, "o", "    ws_answer.cell(row=24, column=i+2, value=(item['Value'] * item['Vol'] / 100) / item['TotalReserves'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.390076, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.390096, "o", "> "]
[76.390158, "o", "wb.save('/root/output/rar_result.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.390178, "o", "EOF\r\n\u001b[?2004l\r"]
