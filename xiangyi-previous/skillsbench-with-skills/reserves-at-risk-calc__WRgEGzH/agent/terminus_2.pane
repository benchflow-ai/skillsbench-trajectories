[?2004l[?2004h> latest_12m_vol = latest_data['12m Vol']
[?2004l[?2004h> annualized_3m_vol = latest_3m_vol * np.sqrt(12)
[?2004l[?2004h> 
[?2004l[?2004h> ws_answer['B3'] = latest_3m_vol
[?2004l[?2004h> ws_answer['B4'] = latest_12m_vol
[?2004l[?2004h> ws_answer['B5'] = annualized_3m_vol
[?2004l[?2004h> ws_answer['B6'] = latest_data['Price']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2
[?2004l[?2004h> def get_2025_data(sheet_name):
[?2004l[?2004h>     df = pd.read_excel('data/test-rar.xlsx', sheet_name=sheet_name)
[?2004l[?2004h>     row_2025 = df[df.iloc[:, 0].astype(str) == '2025']
[?2004l[?2004h>     if row_2025.empty:
[?2004l[?2004h>         return pd.Series()
[?2004l[?2004h>     return row_2025.iloc[0]
[?2004l[?2004h> 
[?2004l[?2004h> val_2025 = get_2025_data('Value')
[?2004l[?2004h> vol_2025 = get_2025_data('Volume')
[?2004l[?2004h> 
[?2004l[?2004h> # Jan-Sep 2025 average gold price
[?2004l[?2004h> gold_2025 = gold_data[gold_data['Date'].str.contains('2025M')]
[?2004l[?2004h> gold_2025_jan_sep = gold_2025[gold_2025['Date'].str.match('2025M[1-9]$')]
[?2004l[?2004h> avg_price_2025 = gold_2025_jan_sep['Price'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> countries_value = {}
[?2004l[?2004h> for col in val_2025.index[2:]:
[?2004l[?2004h>     if pd.notnull(val_2025[col]):
[?2004l[?2004h>         cname = col.split(':')[0].strip()
[?2004l[?2004h>         countries_value[cname] = val_2025[col]
[?2004l[?2004h> 
[?2004l[?2004h> countries_volume = {}
[?2004l[?2004h> for col in vol_2025.index[2:]:
[?2004l[?2004h>     if pd.notnull(vol_2025[col]):
[?2004l[?2004h>         cname = col.split(':')[0].strip()
[?2004l[?2004h>         if cname not in countries_value:
[?2004l[?2004h>             # Convert volume to value
[?2004l[?2004h>             vol = vol_2025[col]
[?2004l[?2004h>             if 'Thous' in col:
[?2004l[?2004h>                 vol = vol * 1000
[?2004l[?2004h>             elif 'Mil' in col:
[?2004l[?2004h>                 vol = vol * 1000000
[?2004l[?2004h>             # Wait, if Value is in Mil.US$, then Volume * Price should also be in Mil.US$
[?2004l[?2004h>             # If Volume is in Mil.Troy Ounces, then Volume * Price is already in Mil.US$
[?2004l[?2004h>             # If Volume is in Thous.Troy Ounces, then (Volume/1000) * Price is in Mil.US$
[?2004l[?2004h>             if 'Thous' in col:
[?2004l[?2004h>                 value = (vol_2025[col] / 1000) * avg_price_2025
[?2004l[?2004h>             else:
[?2004l[?2004h>                 value = vol_2025[col] * avg_price_2025
[?2004l[?2004h>             countries_volume[cname] = value
[?2004l[?2004h> 
[?2004l[?2004h> # Combine
[?2004l[?2004h> all_countries = countries_value.copy()
[?2004l[?2004h> all_countries.update(countries_volume)
[?2004l[?2004h> 
[?2004l[?2004h> # Fill Answer Step 2
[?2004l[?2004h> for i, (cname, val) in enumerate(all_countries.items(), start=0):
[?2004l[?2004h>     ws_answer.cell(row=11, column=i+2, value=cname)
[?2004l[?2004h>     ws_answer.cell(row=12, column=i+2, value=val)
[?2004l[?2004h>     ws_answer.cell(row=13, column=i+2, value=val * annualized_3m_vol / 100)
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3
[?2004l[?2004h> res_2025 = get_2025_data('Total Reserves')
[?2004l[?2004h> res_dict = {}
[?2004l[?2004h> for col in res_2025.index[2:]:
[?2004l[?2004h>     if pd.notnull(res_2025[col]):
[?2004l[?2004h>         cname = col.split(':')[0].strip()
[?2004l[?2004h>         res_dict[cname] = res_2025[col]
[?2004l[?2004h> 
[?2004l[?2004h> step3_list = []
[?2004l[?2004h> for cname, val in all_countries.items():
[?2004l[?2004h>     if cname in res_dict:
[?2004l[?2004h>         step3_list.append((cname, val, annualized_3m_vol, res_dict[cname]))
[?2004l[?2004h> 
[?2004l[?2004h> for i, (cname, val, vol, tot_res) in enumerate(step3_list, start=0):
[?2004l[?2004h>     ws_answer.cell(row=20, column=i+2, value=cname)
[?2004l[?2004h>     ws_answer.cell(row=21, column=i+2, value=val)
[?2004l[?2004h>     ws_answer.cell(row=22, column=i+2, value=vol)
[?2004l[?2004h>     ws_answer.cell(row=23, column=i+2, value=tot_res)
[?2004l[?2004h>     ws_answer.cell(row=24, column=i+2, value=(val * vol / 100) / tot_res)
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/output/rar_result.xlsx')
