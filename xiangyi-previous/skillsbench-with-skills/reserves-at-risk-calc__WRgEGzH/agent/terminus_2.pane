[?2004hroot@d4c18aea30b6:~# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004lCo[?2004h> import numpy as np
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l [?2004h> # Step 1: Extract Gold Price
[?2004l[?2004h> imf_df = pd.read_excel('imf_data.xls', sheet_name='External', skiprows=0)
[?2004l[?2004h> gold_data = imf_df[['Commodity', 'PGOLD']].iloc[3:].dropna()
[?2004l[?2004h> gold_data.columns = ['Date', 'Price']
[?2004l[?2004h> gold_data['Price'] = pd.to_numeric(gold_data['Price'])
[?2004l[?2004h> 
[?2004ls[?2004h> # Calculate log returns
[?2004l[?2004h> gold_data['Log Return'] = np.log(gold_data['Price'] / gold_data['Price'].shift(1)) * 100
[?2004l[?2004h> 
[?2004l][?2004h> # Calculate volatilities
[?2004l[?2004h> gold_data['3m Vol'] = gold_data['Log Return'].rolling(window=3).std()
[?2004l[?2004h> gold_data['12m Vol'] = gold_data['Log Return'].rolling(window=12).std()
[?2004l[?2004h> 
[?2004l.[?2004h> # Write to Gold price sheet
[?2004l[?2004h> wb = load_workbook('data/test-rar.xlsx')
[?2004l[?2004h> ws_gold = wb['Gold price']
[?2004l[?2004h> 
[?2004l[?2004h> # Clear existing data if any (except headers)
[?2004l[?2004h> for row in ws_gold.iter_rows(min_row=2):
[?2004l[?2004h>     for cell in row:
[?2004l[?2004h>         cell.value = None
[?2004l[?2004h> 
[?2004l[?2004h> for i, row in enumerate(gold_data.values, start=2):
[?2004l[?2004h>     ws_gold.cell(row=i, column=1, value=row[0]) # Date
[?2004l[?2004h>     ws_gold.cell(row=i, column=2, value=row[1]) # Price
[?2004l[?2004h>     ws_gold.cell(row=i, column=3, value=row[2]) # Log Return
[?2004l[?2004h>     ws_gold.cell(row=i, column=4, value=row[3]) # 3m Vol
[?2004l[?2004h>     ws_gold.cell(row=i, column=5, value=row[4]) # 12m Vol
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Fill Answer sheet
[?2004l[?2004h> ws_answer = wb['Answer']
[?2004l[?2004h> latest_data = gold_data.iloc[-1]
[?2004l[?2004h> latest_3m_vol = latest_data['3m Vol']
[?2004l[?2004h> latest_12m_vol = latest_data['12m Vol']
[?2004l[?2004h> annualized_3m_vol = latest_3m_vol * np.sqrt(12)
[?2004l[?2004h> 
[?2004l[?2004h> ws_answer['B3'] = latest_3m_vol
[?2004l[?2004h> ws_answer['B4'] = latest_12m_vol
[?2004l[?2004h> ws_answer['B5'] = annualized_3m_vol
[?2004l[?2004h> ws_answer['B6'] = latest_data['Price']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Gold reserves
[?2004l[?2004h> ws_value = wb['Value']
[?2004l[?2004h> ws_volume = wb['Volume']
[?2004l[?2004h> 
[?2004l[?2004h> # Read Value sheet
[?2004l[?2004h> data_value = []
[?2004l[?2004h> for row in ws_value.iter_rows(min_row=1, values_only=True):
[?2004l[?2004h>     data_value.append(row)
[?2004l[?2004h> df_value = pd.DataFrame(data_value[1:], columns=data_value[0])
[?2004l[?2004h> 
[?2004l[?2004h> # Read Volume sheet
[?2004l[?2004h> data_volume = []
[?2004l[?2004h> for row in ws_volume.iter_rows(min_row=1, values_only=True):
[?2004l[?2004h>     data_volume.append(row)
[?2004l[?2004h> df_volume = pd.DataFrame(data_volume[1:], columns=data_volume[0])
[?2004l[?2004h> 
[?2004l[?2004h> # Find countries with 2025 data in Value
[?2004l[?2004h> countries_2025 = df_value[df_value[2025].notnull()][['Country Name', 2025]].copy()
[?2004l[?2004h> countries_2025.columns = ['Country', 'Value']
[?2004l[?2004h> 
[?2004l[?2004h> # Jan-Sep 2025 average gold price
[?2004l[?2004h> gold_2025 = gold_data[gold_data['Date'].str.contains('2025M')]
[?2004l[?2004h> gold_2025_jan_sep = gold_2025[gold_2025['Date'].str.match('2025M[1-9]$')]
[?2004l[?2004h> avg_price_2025 = gold_2025_jan_sep['Price'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> # Check additional countries in Volume
[?2004l[?2004h> countries_in_value = set(countries_2025['Country'])
[?2004l[?2004h> additional_countries = []
[?2004l[?2004h> for idx, row in df_volume.iterrows():
[?2004l[?2004h>     country = row['Country Name']
[?2004l[?2004h>     val_2025 = row[2025]
[?2004l[?2004h>     if pd.notnull(val_2025) and country not in countries_in_value:
[?2004l[?2004h>         additional_countries.append({'Country': country, 'Value': val_2025 * avg_price_2025})
[?2004l[?2004h> 
[?2004l[?2004h> if additional_countries:
[?2004l[?2004h>     countries_2025 = pd.concat([countries_2025, pd.DataFrame(additional_countries)], ignore_index=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Fill Step 2 in Answer
[?2004l[?2004h> for i, row in enumerate(countries_2025.itertuples(), start=0):
[?2004l[?2004h>     ws_answer.cell(row=11, column=i+2, value=row.Country)
[?2004l[?2004h>     ws_answer.cell(row=12, column=i+2, value=row.Value)
[?2004l[?2004h>     # Row 13: Exposure = Value * Volatility (using 3m vol annualized? or 12m? Task says "Gold price exposure ... capture a near-term valuation swing")
[?2004l[?2004h>     # Usually exposure is Value * Volatility. Let's use annualized 3m vol as it's common for near-term.
[?2004l[?2004h>     # Re-reading: "Calculate the Gold price exposure in row 13". 
[?2004l[?2004h>     # Exposure = Value * annualized_3m_vol / 100 (since vol is in percentage)
[?2004l[?2004h>     ws_answer.cell(row=13, column=i+2, value=row.Value * annualized_3m_vol / 100)
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3
[?2004l[?2004h> ws_reserves = wb['Total Reserves']
[?2004l[?2004h> data_reserves = []
[?2004l[?2004h> for row in ws_reserves.iter_rows(min_row=1, values_only=True):
[?2004l[?2004h>     data_reserves.append(row)
[?2004l[?2004h> df_reserves = pd.DataFrame(data_reserves[1:], columns=data_reserves[0])
[?2004l[?2004h> 
[?2004l[?2004h> step3_data = []
[?2004l[?2004h> for row in countries_2025.itertuples():
[?2004l[?2004h>     country = row.Country
[?2004l[?2004h>     val = row.Value
[?2004l[?2004h>     # Find 2025 total reserves
[?2004l[?2004h>     res_2025 = df_reserves[df_reserves['Country Name'] == country][2025].values
[?2004l[?2004h>     if len(res_2025) > 0 and pd.notnull(res_2025[0]):
[?2004l[?2004h>         step3_data.append({
[?2004l[?2004h>             'Country': country,
[?2004l[?2004h>             'Value': val,
[?2004l[?2004h>             'Vol': annualized_3m_vol,
[?2004l[?2004h>             'TotalReserves': res_2025[0]
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> for i, item in enumerate(step3_data, start=0):
[?2004l[?2004h>     ws_answer.cell(row=20, column=i+2, value=item['Country'])
[?2004l[?2004h>     ws_answer.cell(row=21, column=i+2, value=item['Value'])
[?2004l[?2004h>     ws_answer.cell(row=22, column=i+2, value=item['Vol'])
[?2004l[?2004h>     ws_answer.cell(row=23, column=i+2, value=item['TotalReserves'])
[?2004l[?2004h>     # Row 24: RaR = (Value * Vol / 100) / TotalReserves
[?2004l[?2004h>     ws_answer.cell(row=24, column=i+2, value=(item['Value'] * item['Vol'] / 100) / item['TotalReserves'])
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/output/rar_result.xlsx')
