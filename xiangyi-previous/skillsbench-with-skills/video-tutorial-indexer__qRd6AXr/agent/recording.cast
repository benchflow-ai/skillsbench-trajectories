[157.365057, "o", "ffprobe -v error -select_streams v:0 -show_entries frame=pict_type,pts_time -of json /root/tutorial_video.mp4 > /tmp/frames.json\r\n\u001b[?2004l\r"]
[162.333371, "i", "python3 << 'EOF'\nimport json\n\nwith open('/tmp/frames.json', 'r') as f:\n    data = json.load(f)\n\niframes = [float(frame['pts_time']) for frame in data['frames'] if frame['pict_type'] == 'I']\nprint(f\"Total I-frames: {len(iframes)}\")\nprint(\"First 30 I-frame timestamps:\")\nfor i, ts in enumerate(iframes[:30]):\n    print(f\"{i}: {ts:.2f}s\")\nEOF\n"]
[162.333604, "o", "python3 << 'EOF'\r\nimport json\r\n\r\nwith open('/tmp/frames.json', 'r') as f:\r\n    data = json.load(f)\r\n\r\niframes = [float(frame['pts_time']) for frame in data['frames'] if frame['pict_type'] == 'I']\r\nprint(f\"Total I-frames: {len(iframes)}\")\r\nprint(\"First 30 I-frame timestamps:\")\r\nfor i, ts in enumerate(iframes[:30]):\r\n    print(f\"{i}: {ts:.2f}s\")\r\nEOF\r\n"]
