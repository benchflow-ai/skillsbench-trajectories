[200.560198, "i", "python3 << 'EOF'\nimport subprocess\nimport json\n\n# Try to extract text from video using ffmpeg and tesseract if available\n# First, let's check if we can detect scene changes more intelligently\n\n# Extract frames at the first 30 I-frame positions to analyze\niframes = [0.00, 6.00, 10.10, 12.00, 15.37, 18.00, 24.00, 30.00, 31.27, 32.70, \n           35.70, 37.13, 39.07, 41.43, 42.77, 45.57, 46.57, 52.57, 56.53, 58.53,\n           64.53, 69.87, 70.53, 76.53, 82.53, 88.53, 92.27, 94.27, 100.27, 106.27]\n\nprint(\"Extracting sample frames for analysis...\")\nfor i, ts in enumerate(iframes[:10]):\n    cmd = f\"ffmpeg -ss {ts} -i /root/tutorial_video.mp4 -vframes 1 -q:v 2 /tmp/sample_{i:03d}.jpg -y 2>/dev/null\"\n    subprocess.run(cmd, shell=True)\n    \nprint(\"Sample frames extracted to /tmp/sample_*.jpg\")\nEOF\n"]
