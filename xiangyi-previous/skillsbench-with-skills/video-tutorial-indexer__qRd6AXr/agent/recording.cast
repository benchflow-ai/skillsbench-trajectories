[341.421472, "i", "python3 << 'EOF'\nimport json\n\nchapter_titles = [\n    \"What we'll do\",\n    \"How we'll get there\",\n    \"Getting a floor plan\",\n    \"Getting started\",\n    \"Basic Navigation\",\n    \"Import your plan into Blender\",\n    \"Basic transform operations\",\n    \"Setting up the plan and units\",\n    \"It all starts with a plane\",\n    \"Scaling the plane to real dimensions\",\n    \"Getting the plan in place\",\n    \"Tracing the outline\",\n    \"Tracing inner walls\",\n    \"Break\",\n    \"Continue tracing inner walls\",\n    \"Remove doubled vertices\",\n    \"Save\",\n    \"Make the floor\",\n    \"Remove unnecessary geometry\",\n    \"Make the floor's faces\",\n    \"Make the background\",\n    \"Extruding the walls in Z\",\n    \"Reviewing face orientation\",\n    \"Adding thickness to walls with Modifiers\",\n    \"Fixing face orientation errors\",\n    \"Note on face orientation\",\n    \"Save As\",\n    \"If you need thick and thin walls\",\n    \"Great job!\"\n]\n\nchapter_timestamps = [\n    0, 15, 31, 37, 46, 57, 70, 83, 92, 214, 239, 306, 351, 380, 389,\n    574, 610, 624, 723, 863, 881, 911, 1022, 1043, 1137, 1181, 1255, 1319, 1368\n]\n\n# Create the JSON structure\noutput = {\n    \"video_info\": {\n        \"title\": \"In-Depth Floor Plan Tutorial Part 1\",\n        \"duration_seconds\": 1382\n    },\n    \"chapters\": [\n        {\"time\": time, \"title\": title}\n        for time, title in zip(chapter_timestamps, chapter_titles)\n    ]\n}\n\n# Write to file\nwith open('/root/tutorial_index.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(\"Created /root/tutorial_index.json\")\nprint(f\"Total chapters: {len(output['chapters'])}\")\nEOF\n"]
