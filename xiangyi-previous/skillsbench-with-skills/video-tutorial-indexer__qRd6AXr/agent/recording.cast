[223.155595, "i", "python3 << 'EOF'\nimport json\n\n# Known information:\n# - 29 chapters total\n# - Video duration: 1382 seconds\n# - Chapter titles are known\n\nchapter_titles = [\n    \"What we'll do\",\n    \"How we'll get there\",\n    \"Getting a floor plan\",\n    \"Getting started\",\n    \"Basic Navigation\",\n    \"Import your plan into Blender\",\n    \"Basic transform operations\",\n    \"Setting up the plan and units\",\n    \"It all starts with a plane\",\n    \"Scaling the plane to real dimensions\",\n    \"Getting the plan in place\",\n    \"Tracing the outline\",\n    \"Tracing inner walls\",\n    \"Break\",\n    \"Continue tracing inner walls\",\n    \"Remove doubled vertices\",\n    \"Save\",\n    \"Make the floor\",\n    \"Remove unnecessary geometry\",\n    \"Make the floor's faces\",\n    \"Make the background\",\n    \"Extruding the walls in Z\",\n    \"Reviewing face orientation\",\n    \"Adding thickness to walls with Modifiers\",\n    \"Fixing face orientation errors\",\n    \"Note on face orientation\",\n    \"Save As\",\n    \"If you need thick and thin walls\",\n    \"Great job!\"\n]\n\n# Looking at I-frame pattern, chapters likely start at these key timestamps\n# Based on typical tutorial structure:\n# - Introduction chapters are shorter (0-100s)\n# - Main content chapters are longer (100-1300s)\n# - Conclusion is brief (1300-1382s)\n\n# Let me use the irregular I-frames in the beginning as chapter markers\niframes = [0.00, 6.00, 10.10, 12.00, 15.37, 18.00, 24.00, 30.00, 31.27, 32.70,\n           35.70, 37.13, 39.07, 41.43, 42.77, 45.57, 46.57, 52.57, 56.53, 58.53,\n           64.53, 69.87, 70.53, 76.53, 82.53, 88.53, 92.27]\n\nprint(f\"Number of irregular I-frames: {len(iframes)}\")\nprint(f\"Number of chapters: {len(chapter_titles)}\")\nprint(\"\\nNeed to find timestamps for all 29 chapters...\")\nEOF\n"]
