[329.74745, "i", "python3 << 'EOF'\nimport json\n\nchapter_titles = [\n    \"What we'll do\",\n    \"How we'll get there\",\n    \"Getting a floor plan\",\n    \"Getting started\",\n    \"Basic Navigation\",\n    \"Import your plan into Blender\",\n    \"Basic transform operations\",\n    \"Setting up the plan and units\",\n    \"It all starts with a plane\",\n    \"Scaling the plane to real dimensions\",\n    \"Getting the plan in place\",\n    \"Tracing the outline\",\n    \"Tracing inner walls\",\n    \"Break\",\n    \"Continue tracing inner walls\",\n    \"Remove doubled vertices\",\n    \"Save\",\n    \"Make the floor\",\n    \"Remove unnecessary geometry\",\n    \"Make the floor's faces\",\n    \"Make the background\",\n    \"Extruding the walls in Z\",\n    \"Reviewing face orientation\",\n    \"Adding thickness to walls with Modifiers\",\n    \"Fixing face orientation errors\",\n    \"Note on face orientation\",\n    \"Save As\",\n    \"If you need thick and thin walls\",\n    \"Great job!\"\n]\n\n# Based on scene analysis and typical tutorial structure, map chapters to timestamps\n# Starting with 0 for first chapter, then using scene change timestamps\nchapter_timestamps = [\n    0,      # 1. What we'll do\n    15,     # 2. How we'll get there (estimated between scene changes)\n    31,     # 3. Getting a floor plan (scene change at 31.27)\n    37,     # 4. Getting started (scene change at 37.13)\n    46,     # 5. Basic Navigation (scene change at 45.57)\n    57,     # 6. Import your plan into Blender (scene change at 56.53)\n    70,     # 7. Basic transform operations (scene change at 69.87)\n    83,     # 8. Setting up the plan and units (scene change at 82.87)\n    92,     # 9. It all starts with a plane (scene change at 92.27)\n    214,    # 10. Scaling the plane to real dimensions (scene change at 214.23)\n    239,    # 11. Getting the plan in place (scene change at 238.80)\n    306,    # 12. Tracing the outline (scene change at 306.27)\n    351,    # 13. Tracing inner walls (scene change at 350.63)\n    380,    # 14. Break (scene change at 379.77)\n    389,    # 15. Continue tracing inner walls (scene change at 388.90)\n    574,    # 16. Remove doubled vertices (scene change at 573.53)\n    610,    # 17. Save (scene change at 609.83)\n    624,    # 18. Make the floor (scene change at 623.53)\n    723,    # 19. Remove unnecessary geometry (scene change at 723.10)\n    863,    # 20. Make the floor's faces (scene change at 863.33)\n    881,    # 21. Make the background (scene change at 881.07)\n    911,    # 22. Extruding the walls in Z (scene change at 910.90)\n    1022,   # 23. Reviewing face orientation (scene change at 1022.17)\n    1043,   # 24. Adding thickness to walls with Modifiers (scene change at 1042.63)\n    1137,   # 25. Fixing face orientation errors (scene change at 1137.03)\n    1181,   # 26. Note on face orientation (scene change at 1181.37)\n    1255,   # 27. Save As (scene change at 1254.93)\n    1319,   # 28. If you need thick and thin walls (scene change at 1319.30)\n    1368    # 29. Great job! (scene change at 1367.57)\n]\n\nprint(f\"Number of chapters: {len(chapter_titles)}\")\nprint(f\"Number of timestamps: {len(chapter_timestamps)}\")\nprint(\"\\nChapter mapping:\")\nfor i, (title, time) in enumerate(zip(chapter_titles, chapter_timestamps), 1):\n    print(f\"{i}. {title}: {time}s\")\nEOF\n"]
