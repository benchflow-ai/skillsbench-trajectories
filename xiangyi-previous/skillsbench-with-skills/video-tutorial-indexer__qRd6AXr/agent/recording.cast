[181.040982, "i", "python3 << 'EOF'\nimport json\n\n# Get all I-frame timestamps\nwith open('/tmp/frames.json', 'r') as f:\n    data = json.load(f)\n\niframes = [float(frame['pts_time']) for frame in data['frames'] if frame['pict_type'] == 'I']\n\n# Print all I-frames to see the full distribution\nprint(\"All I-frame timestamps:\")\nfor i, ts in enumerate(iframes):\n    print(f\"{i}: {ts:.2f}s\")\nEOF\n"]
