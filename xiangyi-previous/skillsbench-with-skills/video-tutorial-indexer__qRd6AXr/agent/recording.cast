[294.045678, "o", "\u001b[?2004hroot@dd6da4d9be2a:~# "]
[307.000117, "i", "python3 << 'EOF'\nimport json\nimport re\n\n# Parse scenes.txt to get timestamps with scene changes\nwith open('/tmp/scenes.txt', 'r') as f:\n    lines = f.readlines()\n\nscene_times = []\nfor i in range(0, len(lines), 2):\n    if i+1 < len(lines):\n        time_match = re.search(r'pts_time:(\\d+\\.\\d+)', lines[i])\n        score_match = re.search(r'lavfi\\.scene_score=([\\d\\.]+)', lines[i+1])\n        if time_match and score_match:\n            time = float(time_match.group(1))\n            score = float(score_match.group(1))\n            scene_times.append((time, score))\n\n# Sort by time\nscene_times.sort()\n\nprint(\"Scene changes with scores:\")\nfor time, score in scene_times:\n    print(f\"{time:.2f}s - score: {score:.3f}\")\n\nprint(f\"\\nTotal scene changes: {len(scene_times)}\")\nEOF\n"]
