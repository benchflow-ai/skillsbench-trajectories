[237.359861, "i", "python3 << 'EOF'\nimport json\n\n# All I-frame timestamps\nall_iframes = [0.00, 6.00, 10.10, 12.00, 15.37, 18.00, 24.00, 30.00, 31.27, 32.70,\n               35.70, 37.13, 39.07, 41.43, 42.77, 45.57, 46.57, 52.57, 56.53, 58.53,\n               64.53, 69.87, 70.53, 76.53, 82.53, 88.53, 92.27, 94.27, 100.27, 106.27]\n\n# Extend to include more timestamps from the middle and end\nfor i in range(30, 242):\n    ts = 94.27 + (i - 27) * 6.0\n    if ts <= 1382:\n        all_iframes.append(round(ts, 2))\n\n# Chapter 14 is \"Break\" - this should be around the middle of the video\n# Video is 1382s, so middle is around 691s\n# Let's look for I-frames around that time\n\nmiddle_time = 1382 / 2\nprint(f\"Middle of video: {middle_time:.2f}s\")\n\n# Find I-frames near the middle\nfor i, ts in enumerate(all_iframes):\n    if 680 < ts < 700:\n        print(f\"I-frame {i}: {ts:.2f}s\")\n\n# Also check for frames near the end for the last chapters\nprint(\"\\nI-frames near the end:\")\nfor i, ts in enumerate(all_iframes[-10:]):\n    print(f\"Frame: {ts:.2f}s\")\nEOF\n"]
