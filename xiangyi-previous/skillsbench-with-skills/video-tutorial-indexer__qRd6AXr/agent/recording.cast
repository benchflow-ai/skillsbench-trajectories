[237.360912, "o", "               64.53, 69.87, 70.53, 76.53, 82.53, 88.53, 92.27, 94.27, 100.27, 106.27]\r\n\u001b[?2004l\r"]
[237.360942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.361017, "o", "\u001b[?2004h> "]
[237.36113, "o", "# Extend to include more timestamps from the middle and end\r\n\u001b[?2004l\r"]
[237.361188, "o", "\u001b[?2004h> "]
[237.361248, "o", "for i in range(30, 242):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.361276, "o", "> "]
[237.361369, "o", "    ts = 94.27 + (i - 27) * 6.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.361425, "o", "    if ts <= 1382:\r\n"]
[237.361454, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.361567, "o", "        all_iframes.append(round(ts, 2))\r\n\u001b[?2004l\r"]
[237.361587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.361674, "o", "\u001b[?2004h> "]
[237.361799, "o", "# Chapter 14 is \"Break\" - this should be around the middle of the video\r\n\u001b[?2004l\r"]
[237.361855, "o", "\u001b[?2004h> "]
[237.361942, "o", "# Video is 1382s, so middle is around 691s\r\n\u001b[?2004l\r"]
[237.361973, "o", "\u001b[?2004h> "]
[237.362091, "o", "# Let's look for I-frames around that time\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.36215, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.362217, "o", "> "]
[237.362281, "o", "middle_time = 1382 / 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.362337, "o", "print(f\"Middle of video: {middle_time:.2f}s\")\r\n\u001b[?2004l\r"]
[237.362398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.362465, "o", "\u001b[?2004h> "]
[237.362533, "o", "# Find I-frames near the middle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.362564, "o", "for i, ts in enumerate(all_iframes):\r\n\u001b[?2004l\r"]
[237.362653, "o", "\u001b[?2004h> "]
[237.362685, "o", "    if 680 < ts < 700:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.362774, "o", "        print(f\"I-frame {i}: {ts:.2f}s\")\r\n\u001b[?2004l\r"]
[237.362803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.36283, "o", "\u001b[?2004h> "]
[237.362972, "o", "# Also check for frames near the end for the last chapters\r\n\u001b[?2004l\r"]
[237.363022, "o", "\u001b[?2004h> "]
[237.363077, "o", "print(\"\\nI-frames near the end:\")\r\n\u001b[?2004l\r"]
[237.363104, "o", "\u001b[?2004h> "]
[237.363266, "o", "for i, ts in enumerate(all_iframes[-10:]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.363349, "o", "    print(f\"Frame: {ts:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.363383, "o", "EOF\r\n\u001b[?2004l\r"]
