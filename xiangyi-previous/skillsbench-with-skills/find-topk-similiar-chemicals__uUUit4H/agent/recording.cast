[204.895232, "i", "cat <<EOF > /root/workspace/solution.py\nimport pdfplumber\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem, DataStructs\nfrom rdkit import RDLogger\nimport warnings\n\n# Suppress logs and warnings\nRDLogger.DisableLog('rdApp.*')\nwarnings.filterwarnings(\"ignore\")\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    # Helper to get fingerprint\n    def get_fp(name):\n        try:\n            # Use PubChem to get SMILES\n            compounds = pcp.get_compounds(name, 'name')\n            if not compounds:\n                return None\n            # Use smiles (which includes isomerism in newer pcp versions) as isomeric_smiles is deprecated\n            smiles = compounds[0].smiles\n            if not smiles:\n                return None\n            \n            mol = Chem.MolFromSmiles(smiles)\n            if not mol:\n                return None\n            \n            # Morgan fingerprints with Tanimoto similarity (radius = 2, include chirality)\n     "]
[204.895405, "i", "       return AllChem.GetMorganFingerprintAsBitVect(mol, 2, useChirality=True)\n        except Exception:\n            return None\n\n    # Get target fingerprint\n    target_fp = get_fp(target_molecule_name)\n    if target_fp is None:\n        return []\n\n    # Read PDF to get candidate names\n    candidates = set()\n    try:\n        with pdfplumber.open(molecule_pool_filepath) as pdf:\n            for page in pdf.pages:\n                text = page.extract_text()\n                if text:\n                    for line in text.split('\\n'):\n                        line = line.strip()\n                        if line:\n                            candidates.add(line)\n    except Exception as e:\n        print(f\"Error reading PDF: {e}\")\n        return []\n\n    candidate_scores = []\n    for name in candidates:\n        fp = get_fp(name)\n        if fp:\n            sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n            candidate_scores.append((name, sim))\n    \n    # Sort: Descending similarity (-x[1]), then Ascending name (x"]
[204.895467, "o", "cat <<EOF > /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[204.895519, "i", "[0])\n    candidate_scores.sort(key=lambda x: (-x[1], x[0]))\n    \n    return [x[0] for x in candidate_scores[:top_k]]\nEOF\n"]
