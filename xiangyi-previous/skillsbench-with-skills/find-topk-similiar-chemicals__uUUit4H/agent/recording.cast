[204.896508, "o", "            compounds = pcp.get_compounds(name, 'name')\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.896522, "o", "> "]
[204.896589, "o", "            if not compounds:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.896644, "o", "                return None\r\n\u001b[?2004l\r"]
[204.896657, "o", "\u001b[?2004h> "]
[204.896812, "o", "            # Use smiles (which includes isomerism in newer pcp versions) as isomeric_smiles is deprecated\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.896888, "o", "            smiles = compounds[0].smiles\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.8969, "o", "> "]
[204.896956, "o", "            if not smiles:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.897018, "o", "                return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.897065, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.897127, "o", "            mol = Chem.MolFromSmiles(smiles)\r\n\u001b[?2004l\r"]
[204.897139, "o", "\u001b[?2004h> "]
[204.897184, "o", "            if not mol:\r\n\u001b[?2004l\r"]
[204.897196, "o", "\u001b[?2004h> "]
[204.897241, "o", "                return None\r\n\u001b[?2004l\r"]
[204.897254, "o", "\u001b[?2004h> "]
[204.897301, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.897442, "o", "            # Morgan fingerprints with Tanimoto similarity (radius = 2, include chirality)\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.897455, "o", "> "]
[204.897584, "o", "            return AllChem.GetMorganFingerprintAsBitVect(mol, 2, useChirality=True)\r\n\u001b[?2004l\r"]
[204.897598, "o", "\u001b[?2004h> "]
[204.897665, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.897717, "o", "            return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[204.897729, "o", "\u001b[?2004h> "]
[204.897779, "o", "    # Get target fingerprint\r\n\u001b[?2004l\r"]
[204.897792, "o", "\u001b[?2004h> "]
[204.897859, "o", "    target_fp = get_fp(target_molecule_name)\r\n\u001b[?2004l\r"]
[204.897872, "o", "\u001b[?2004h> "]
[204.897913, "o", "    if target_fp is None:\r\n\u001b[?2004l\r"]
[204.897926, "o", "\u001b[?2004h> "]
[204.897978, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[204.89799, "o", "\u001b[?2004h> "]
[204.898054, "o", "    # Read PDF to get candidate names\r\n\u001b[?2004l\r"]
[204.898066, "o", "\u001b[?2004h> "]
[204.898112, "o", "    candidates = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.898123, "o", "> "]
[204.898186, "o", "    try:\r\n\u001b[?2004l\r"]
[204.898198, "o", "\u001b[?2004h> "]
[204.898246, "o", "        with pdfplumber.open(molecule_pool_filepath) as pdf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.898287, "o", "> "]
[204.898343, "o", "            for page in pdf.pages:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.898713, "o", "                text = page.extract_text()\r\n\u001b[?2004l\r\u001b[?2004h>                 if text:\r\n\u001b[?2004l\r\u001b[?2004h>                     for line in text.split('\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>                         line = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>                         if line:\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.898734, "o", "> "]
[204.898873, "o", "                            candidates.add(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.898908, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.89898, "o", "        print(f\"Error reading PDF: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.898996, "o", "        return []\r\n\u001b[?2004l\r"]
[204.899004, "o", "\u001b[?2004h> "]
[204.899018, "o", "\r\n\u001b[?2004l\r"]
[204.899024, "o", "\u001b[?2004h> "]
[204.899104, "o", "    candidate_scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.899125, "o", "    for name in candidates:\r\n\u001b[?2004l\r"]
[204.899157, "o", "\u001b[?2004h> "]
[204.899207, "o", "        fp = get_fp(name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.89924, "o", "        if fp:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.899354, "o", "            sim = DataStructs.TanimotoSimilarity(target_fp, fp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.899434, "o", "            candidate_scores.append((name, sim))\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.899446, "o", ">     \r\n"]
[204.899475, "o", "\u001b[?2004l\r"]
[204.89949, "o", "\u001b[?2004h> "]
[204.899641, "o", "    # Sort: Descending similarity (-x[1]), then Ascending name (x[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.899721, "o", "    candidate_scores.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.899736, "o", "> "]
[204.899753, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[204.899763, "o", "> "]
[204.899858, "o", "    return [x[0] for x in candidate_scores[:top_k]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.899872, "o", "> EOF\r\n\u001b[?2004l\r"]
[204.901243, "o", "\u001b[?2004hroot@fe1917110ea0:~# "]
[205.045094, "i", "cat <<EOF > final_test.py\nfrom workspace.solution import topk_tanimoto_similarity_molecules\nimport os\n\npdf_path = 'molecules.pdf'\ntarget = 'Aspirin'\ntop_k = 5\n\nprint(f\"Finding top {top_k} similar to {target}...\")\nresults = topk_tanimoto_similarity_molecules(target, pdf_path, top_k)\nprint(\"Results:\", results)\nEOF\n"]
