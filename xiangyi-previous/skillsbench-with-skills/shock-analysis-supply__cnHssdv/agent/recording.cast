[777.043177, "i", "cat <<EOF > download_data.py\nimport requests\n\ndef download_file(url, filename):\n    try:\n        print(f\"Downloading {url}...\")\n        response = requests.get(url, allow_redirects=True)\n        if response.status_code == 200:\n            with open(filename, 'wb') as f:\n                f.write(response.content)\n            print(f\"Saved {filename}\")\n        else:\n            print(f\"Failed to download {url}: Status {response.status_code}\")\n    except Exception as e:\n        print(f\"Error downloading {url}: {e}\")\n\n# PWT URL (trying a known version URL)\npwt_url = 'https://www.rug.nl/ggdc/docs/pwt1001.xlsx'\ndownload_file(pwt_url, 'pwt_source.xlsx')\n\n# ECB Data URL (from task description)\n# The URL provided is a web page. I might need to look for a download link or scrape.\n# Let's try to fetch the page content first to see if there's a direct download link or API endpoint.\n# For now, just the PWT.\nEOF\n"]
