[869.14758, "i", "cat <<EOF > find_links.py\nimport requests\nimport re\n\ndef find_pwt_link():\n    url = 'https://www.rug.nl/ggdc/productivity/pwt/?lang=en'\n    try:\n        print(f\"Fetching {url}...\")\n        response = requests.get(url)\n        if response.status_code == 200:\n            # Look for xlsx links\n            links = re.findall(r'href=[\"\\'](.*?.xlsx)[\"\\']', response.text)\n            print(\"Found PWT links:\", links)\n            return links\n    except Exception as e:\n        print(e)\n\ndef find_ecb_link():\n    url = 'https://data.ecb.europa.eu/data/geographical-areas/georgia?reference_area_name%5B0%5D=Georgia'\n    try:\n        print(f\"Fetching {url}...\")\n        response = requests.get(url)\n        if response.status_code == 200:\n            # Look for download links, often csv or xlsx\n            # This might be dynamic, but let's check for obvious hrefs\n            links = re.findall(r'href=[\"\\'](.*?.csv)[\"\\']', response.text)\n            print(\"Found ECB CSV links:\", links)\n    except Exception as e:\n        print(e)\n\nfind_pwt_link()\nfind_ecb_link()\nEOF\n"]
