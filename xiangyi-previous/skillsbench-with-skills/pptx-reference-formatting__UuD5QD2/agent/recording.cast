[73.738305, "o", "for idx, title in enumerate(paper_titles.keys(), 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.738355, "o", "    print(f\"{idx}. {title}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
