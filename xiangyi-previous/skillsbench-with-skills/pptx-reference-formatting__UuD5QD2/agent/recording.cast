[83.039393, "i", "cat > /root/verify_pptx.py << 'EOF'\nfrom pptx import Presentation\n\nprs = Presentation('/root/Awesome-Agent-Papers_processed.pptx')\nprint(f\"Total slides: {len(prs.slides)}\")\nprint(f\"\\nLast slide (Reference):\")\nlast_slide = prs.slides[-1]\nfor shape_idx, shape in enumerate(last_slide.shapes):\n    if hasattr(shape, \"text_frame\"):\n        print(f\"\\nShape {shape_idx}:\")\n        for para_idx, para in enumerate(shape.text_frame.paragraphs):\n            print(f\"  Para {para_idx}: {para.text[:70]}\")\nEOF\n"]
[83.039642, "o", "cat > /root/verify_pptx.py << 'EOF'\r\n\u001b[?2004l\r"]
[83.039724, "o", "\u001b[?2004h> "]
[83.039768, "o", "from pptx import Presentation\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.039883, "o", "prs = Presentation('/root/Awesome-Agent-Papers_processed.pptx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.039993, "o", "print(f\"Total slides: {len(prs.slides)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.040042, "o", "print(f\"\\nLast slide (Reference):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.040077, "o", "last_slide = prs.slides[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.040097, "o", "> "]
[83.040192, "o", "for shape_idx, shape in enumerate(last_slide.shapes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.040249, "o", "    if hasattr(shape, \"text_frame\"):\r\n\u001b[?2004l\r"]
[83.040275, "o", "\u001b[?2004h> "]
