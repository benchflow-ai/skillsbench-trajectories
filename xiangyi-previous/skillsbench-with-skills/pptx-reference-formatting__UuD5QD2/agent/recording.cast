[98.444538, "i", "cat > /root/process_pptx_final.py << 'EOF'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.enum.text import PP_ALIGN, MSO_ANCHOR\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\nfrom pptx.oxml.xmlchemy import OxmlElement\nfrom collections import OrderedDict\n\ndef add_numbering_to_paragraph(paragraph, number):\n    \"\"\"Add numbering to a paragraph\"\"\"\n    pPr = paragraph._element.get_or_add_pPr()\n    numPr = OxmlElement('a:buFont')\n    numPr.set('typeface', 'Arial')\n    pPr.append(numPr)\n    \n    # Add bullet character\n    buChar = OxmlElement('a:buChar')\n    buChar.set('char', f'{number}.')\n    pPr.append(buChar)\n\n# Load presentation\nprs = Presentation('/root/Awesome-Agent-Papers.pptx')\n\n# Collect all unique paper titles\npaper_titles = OrderedDict()\n\n# Process each slide\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"Processing slide {slide_idx + 1}\")\n    \n    # Find TEXT_BOX shapes (dangling titles)\n    for shape in slide.shapes:\n        # Check if it's a TEXT_BOX\n        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\n            if hasattr(shape, \"text_frame\"):\n                text = shape.text.strip()\n                if text:\n                    print(f\"  Found title: {text[:60]}...\")\n                    \n                    # Store unique titles\n                    if text not in paper_titles:\n                        paper_titles[text] = True\n                    \n                    # Format the text box\n                    text_frame = shape.text_frame\n                    text_frame.word_wrap = True\n                    text_frame.vertical_anchor = MSO_ANCHOR.MIDDLE\n                    \n                    # Format all paragraphs and runs\n                    for paragraph in text_frame.paragraphs:\n                        paragraph.alignment = PP_ALIGN.CENTER\n                        \n                        for run in paragraph.runs:\n                            run.font.name = 'Arial'\n                            run.font.size = Pt(16)\n                            run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n                            run.font.bold = False\n                    \n                    # Adjust shape position and size\n                    slide_width = prs.slide_width\n                    slide_height = prs.slide_height\n                    \n                    # Set width to 90% of slide width for single-line display\n                    shape.width = int(slide_width * 0.9)\n                    shape.left = int((slide_width - shape.width) / 2)\n                    \n                    # Position at bottom center (0.8 inches from bottom)\n                    shape.top = int(slide_height - Inches(0.8))\n                    shape.height = Inches(0.6)\n\nprint(f\"\\nTotal unique paper titles found: {len(paper_titles)}\")\nfor idx, title in enumerate(paper_titles.keys(), 1):\n    print(f\"{idx}. {title}\")\n\n# Create Reference slide\nblank_slide_layout = prs.slide_layouts[6]  # Blank layout\nreference_slide = prs.slides.add_slide(blank_slide_layout)\n\n# Add title \"Reference\" at the top\ntitle_box = reference_slide.shapes.add_textbox(Inches(0.5), Inches(0.5), Inches(9), Inches(0.8))\ntitle_frame = title_box.text_frame\ntitle_frame.text = \"Reference\"\ntitle_paragraph = title_frame.paragraphs[0]\ntitle_paragraph.alignment = PP_ALIGN.CENTER\ntitle_run = title_paragraph.runs[0]\ntitle_run.font.name = 'Arial'\ntitle_run.font.size = Pt(16)\ntitle_run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\ntitle_run.font.bold = False\n\n# Add content with auto-numbered bullet points\ncontent_box = reference_slide.shapes.add_textbox(Inches(0.8), Inches(1.5), Inches(8.4), Inches(5.5))\ncontent_frame = content_box.text_frame\ncontent_frame.word_wrap = True\n\nfor idx, title in enumerate(paper_titles.keys(), 1):\n    if idx == 1:\n        p = content_frame.paragraphs[0]\n    else:\n        p = content_frame.add_paragraph()\n    \n    # Set text\n    p.text = title\n    p.level = 0\n    \n    # Add numbering using XML\n    pPr = p._element.get_or_add_pPr()\n    numPr = OxmlElement('a:buChar')\n    numPr.set('char', f'{"]
[98.444694, "i", "idx}.')\n    # Remove existing bullet formatting if any\n    for child in list(pPr):\n        if 'bu' in child.tag:\n            pPr.remove(child)\n    pPr.insert(0, numPr)\n    \n    # Format text\n    for run in p.runs:\n        run.font.name = 'Arial'\n        run.font.size = Pt(16)\n        run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n        run.font.bold = False\n\n# Save processed presentation\nprs.save('/root/Awesome-Agent-Papers_processed.pptx')\nprint(\"\\nPresentation processed and saved to /root/Awesome-Agent-Papers_processed.pptx\")\nEOF\n"]
[98.445039, "o", "cat > /root/process_pptx_final.py << 'EOF'\r\n\u001b[?2004l\r"]
[98.445158, "o", "\u001b[?2004h> from pptx import Presentation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.445252, "o", "from pptx.util import Inches, Pt\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.445328, "o", "> "]
[98.445408, "o", "from pptx.enum.text import PP_ALIGN, MSO_ANCHOR\r\n\u001b[?2004l\r"]
[98.445479, "o", "\u001b[?2004h> "]
[98.44555, "o", "from pptx.dml.color import RGBColor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.445711, "o", "from pptx.enum.shapes import MSO_SHAPE_TYPE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.445787, "o", "from pptx.oxml.xmlchemy import OxmlElement\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[98.445854, "o", "from collections import OrderedDict\r\n\u001b[?2004l\r"]
[98.445916, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[98.446028, "o", "def add_numbering_to_paragraph(paragraph, number):\r\n\u001b[?2004l\r"]
[98.446105, "o", "\u001b[?2004h> "]
[98.446172, "o", "    \"\"\"Add numbering to a paragraph\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.446286, "o", "    pPr = paragraph._element.get_or_add_pPr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.446376, "o", "    numPr = OxmlElement('a:buFont')\r\n\u001b[?2004l\r"]
[98.446447, "o", "\u001b[?2004h>     numPr.set('typeface', 'Arial')\r\n\u001b[?2004l\rp"]
[98.446512, "o", "\u001b[?2004h>     pPr.append(numPr)\r\n\u001b[?2004l\r"]
[98.446569, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.44663, "o", "    # Add bullet character\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.446695, "o", "    buChar = OxmlElement('a:buChar')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.446761, "o", "    buChar.set('char', f'{number}.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.446829, "o", "    pPr.append(buChar)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.446896, "o", "\u001b[?2004h> # Load presentation\r\n\u001b[?2004l\r"]
[98.44696, "o", "\u001b[?2004h> "]
[98.447023, "o", "prs = Presentation('/root/Awesome-Agent-Papers.pptx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447094, "o", "# Collect all unique paper titles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447156, "o", "paper_titles = OrderedDict()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447225, "o", "# Process each slide\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447294, "o", "for slide_idx, slide in enumerate(prs.slides):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447379, "o", "    print(f\"Processing slide {slide_idx + 1}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447445, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447504, "o", "    # Find TEXT_BOX shapes (dangling titles)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447565, "o", "    for shape in slide.shapes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447626, "o", "        # Check if it's a TEXT_BOX\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447713, "o", "        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447793, "o", "            if hasattr(shape, \"text_frame\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447869, "o", "                text = shape.text.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.447935, "o", "                if text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.44803, "o", "                    print(f\"  Found title: {text[:60]}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.44811, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448181, "o", "                    # Store unique titles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.44825, "o", "                    if text not in paper_titles:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448333, "o", "                        paper_titles[text] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448404, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448488, "o", "                    # Format the text box\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448577, "o", "                    text_frame = shape.text_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448661, "o", "                    text_frame.word_wrap = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448772, "o", "                    text_frame.vertical_anchor = MSO_ANCHOR.MIDDLE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.448842, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.44891, "o", "                    # Format all paragraphs and runs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449022, "o", "                    for paragraph in text_frame.paragraphs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449129, "o", "                        paragraph.alignment = PP_ALIGN.CENTER\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.4492, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449264, "o", "                        for run in paragraph.runs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449354, "o", "                            run.font.name = 'Arial'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449442, "o", "                            run.font.size = Pt(16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449599, "o", "                            run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449678, "o", "                            run.font.bold = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449747, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449817, "o", "                    # Adjust shape position and size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449889, "o", "                    slide_width = prs.slide_width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.449983, "o", "                    slide_height = prs.slide_height\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450057, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450157, "o", "                    # Set width to 90% of slide width for single-line display\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450255, "o", "                    shape.width = int(slide_width * 0.9)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450373, "o", "                    shape.left = int((slide_width - shape.width) / 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450446, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.45054, "o", "                    # Position at bottom center (0.8 inches from bottom)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450651, "o", "                    shape.top = int(slide_height - Inches(0.8))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450728, "o", "                    shape.height = Inches(0.6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450868, "o", "print(f\"\\nTotal unique paper titles found: {len(paper_titles)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.450957, "o", "for idx, title in enumerate(paper_titles.keys(), 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451029, "o", "    print(f\"{idx}. {title}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451105, "o", "# Create Reference slide\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451185, "o", "blank_slide_layout = prs.slide_layouts[6]  # Blank layout\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451286, "o", "reference_slide = prs.slides.add_slide(blank_slide_layout)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.451359, "o", "\u001b[?2004h> # Add title \"Reference\" at the top\r\n\u001b[?2004l\r"]
[98.451427, "o", "\u001b[?2004h> "]
[98.451522, "o", "title_box = reference_slide.shapes.add_textbox(Inches(0.5), Inches(0.5), Inches(9), Inches(0.8))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451596, "o", "title_frame = title_box.text_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451665, "o", "title_frame.text = \"Reference\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451735, "o", "title_paragraph = title_frame.paragraphs[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451815, "o", "title_paragraph.alignment = PP_ALIGN.CENTER\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451887, "o", "title_run = title_paragraph.runs[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.451953, "o", "title_run.font.name = 'Arial'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.45202, "o", "title_run.font.size = Pt(16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452096, "o", "title_run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452166, "o", "title_run.font.bold = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452255, "o", "# Add content with auto-numbered bullet points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452509, "o", "content_box = reference_slide.shapes.add_textbox(Inches(0.8), Inches(1.5), Inches(8.4), Inches(5.5))\r\n\u001b[?2004l\r\u001b[?2004h> content_frame = content_box.text_frame\r\n\u001b[?2004l\r"]
[98.452597, "o", "\u001b[?2004h> content_frame.word_wrap = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452682, "o", "for idx, title in enumerate(paper_titles.keys(), 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452747, "o", "    if idx == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.452811, "o", "        p = content_frame.paragraphs[0]\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[98.452875, "o", "\u001b[?2004h> "]
[98.452943, "o", "        p = content_frame.add_paragraph()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453009, "o", "    # Set text\r\n\u001b[?2004l\r\u001b[?2004h>     p.text = title\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453082, "o", "    p.level = 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453149, "o", "    # Add numbering using XML\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453221, "o", "    pPr = p._element.get_or_add_pPr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453292, "o", "    numPr = OxmlElement('a:buChar')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453361, "o", "    numPr.set('char', f'{idx}.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453431, "o", "    # Remove existing bullet formatting if any\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453503, "o", "    for child in list(pPr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453569, "o", "        if 'bu' in child.tag:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453634, "o", "            pPr.remove(child)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453702, "o", "    pPr.insert(0, numPr)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453775, "o", "    # Format text\r\n\u001b[?2004l\r\u001b[?2004h>     for run in p.runs:\r\n\u001b[?2004l\r"]
[98.453844, "o", "\u001b[?2004h>         run.font.name = 'Arial'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.453908, "o", "        run.font.size = Pt(16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
