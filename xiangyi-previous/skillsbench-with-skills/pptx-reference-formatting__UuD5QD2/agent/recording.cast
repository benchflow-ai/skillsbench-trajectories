[56.717395, "i", "cat > /root/diagnose_pptx.py << 'EOF'\nfrom pptx import Presentation\n\nprs = Presentation('/root/Awesome-Agent-Papers.pptx')\n\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"\\n=== Slide {slide_idx + 1} ===\")\n    for shape_idx, shape in enumerate(slide.shapes):\n        print(f\"Shape {shape_idx}: {shape.shape_type}\")\n        if hasattr(shape, \"text\"):\n            print(f\"  Text: {repr(shape.text[:100])}\")\n        if hasattr(shape, \"text_frame\"):\n            print(f\"  Has text_frame: True\")\n            for para_idx, para in enumerate(shape.text_frame.paragraphs):\n                print(f\"    Paragraph {para_idx}: {repr(para.text[:80])}\")\n                for run in para.runs:\n                    print(f\"      Font: {run.font.name}, Size: {run.font.size}, Bold: {run.font.bold}\")\nEOF\n"]
