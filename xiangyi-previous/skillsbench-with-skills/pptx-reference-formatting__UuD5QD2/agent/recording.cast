[112.128378, "i", "cat > /root/final_verify.py << 'EOF'\nfrom pptx import Presentation\nfrom pptx.util import Pt\n\nprs = Presentation('/root/Awesome-Agent-Papers_processed.pptx')\nprint(f\"Total slides: {len(prs.slides)}\")\nprint(f\"Slide dimensions: {prs.slide_width.inches}\\\" x {prs.slide_height.inches}\\\"\")\n\nprint(\"\\n=== Verification of Processing ===\")\n\n# Check slides 2-6 for formatting\nfor slide_idx in range(1, 6):\n    slide = prs.slides[slide_idx]\n    print(f\"\\nSlide {slide_idx + 1}:\")\n    for shape in slide.shapes:\n        if shape.shape_type == 17:  # TEXT_BOX\n            if hasattr(shape, \"text_frame\"):\n                text = shape.text.strip()\n                if text and len(text) > 20:\n                    print(f\"  Title: {text[:60]}\")\n                    print(f\"  Position: top={shape.top.inches:.2f}\\\", left={shape.left.inches:.2f}\\\"\")\n                    print(f\"  Size: width={shape.width.inches:.2f}\\\", height={shape.height.inches:.2f}\\\"\")\n                    \n                    # Check formatting\n                    for para in shape.text_frame.paragraphs:\n                        for run in para.runs:\n                            print(f\"  Font: {run.font.name}\")\n                            print(f\"  Size: {run.font.size.pt if run.font.size else 'None'}\")\n                            print(f\"  Color: RGB({run.font.color.rgb})\" if run.font.color.rgb else \"Color: None\")\n                            print(f\"  Bold: {run.font.bold}\")\n                            break\n                        break\n\n# Check Reference slide\nprint(f\"\\nReference Slide (Slide {len(prs.slides)}):\")\nref_slide = prs.slides[-1]\nfor shape_idx, shape in enumerate(ref_slide.shapes):\n    if hasattr(shape, \"text_frame\"):\n        print(f\"\\nShape {shape_idx}:\")\n        for para_idx, para in enumerate(shape.text_frame.paragraphs):\n            text = para.text[:70]\n            print(f\"  Para {para_idx}: {text}\")\n            if para_idx < 5:  # Show first 5 paragraphs\n                for run in para.runs:\n                    if run.text.strip():\n                        print(f\"    Font: {run.font.name}, Size: {run.font.size.pt if run.font.size else 'None'}, Bold: {run.font.bold}\")\n                        break\n\nprint(\"\\n=== Verification Complete ===\")\nEOF\n"]
