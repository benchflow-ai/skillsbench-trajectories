[?2004l[?2004h> 
[?2004lr[?2004h> def add_numbering_to_paragraph(paragraph, number):
[?2004l[?2004h>     """Add numbering to a paragraph"""
[?2004l[?2004h>     pPr = paragraph._element.get_or_add_pPr()
[?2004l[?2004h>     numPr = OxmlElement('a:buFont')
[?2004l[?2004h>     numPr.set('typeface', 'Arial')
[?2004lp[?2004h>     pPr.append(numPr)
[?2004l[?2004h>     
[?2004l[?2004h>     # Add bullet character
[?2004l[?2004h>     buChar = OxmlElement('a:buChar')
[?2004l[?2004h>     buChar.set('char', f'{number}.')
[?2004l[?2004h>     pPr.append(buChar)
[?2004l[?2004h> 
[?2004l[?2004h> # Load presentation
[?2004l[?2004h> prs = Presentation('/root/Awesome-Agent-Papers.pptx')
[?2004l[?2004h> 
[?2004l[?2004h> # Collect all unique paper titles
[?2004l[?2004h> paper_titles = OrderedDict()
[?2004l[?2004h> 
