[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.util import Inches, Pt
[?2004l[?2004h> from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
[?2004l[?2004h> from pptx.dml.color import RGBColor
[?2004l[?2004h> from pptx.enum.shapes import MSO_SHAPE_TYPE
[?2004l[?2004h> from collections import OrderedDict
[?2004l[?2004h> 
[?2004l[?2004h> # Load presentation
[?2004l[?2004h> prs = Presentation('/root/Awesome-Agent-Papers.pptx')
[?2004l[?2004h> 
[?2004l[?2004h> # Collect all unique paper titles
[?2004l[?2004h> paper_titles = OrderedDict()
[?2004l[?2004h> 
[?2004l[?2004h> # Process each slide
[?2004l[?2004h> for slide_idx, slide in enumerate(prs.slides):
[?2004l[?2004h>     print(f"Processing slide {slide_idx + 1}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Find TEXT_BOX shapes (dangling titles)
[?2004l[?2004h>     for shape in slide.shapes:
[?2004l[?2004h>         # Check if it's a TEXT_BOX
[?2004l[?2004h>         if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:
[?2004l[?2004h>             if hasattr(shape, "text_frame"):
[?2004l[?2004h>                 text = shape.text.strip()
[?2004l[?2004h>                 if text:
[?2004l[?2004h>                     print(f"  Found title: {text[:60]}...")
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Store unique titles
[?2004l[?2004h>                     if text not in paper_titles:
[?2004l[?2004h>                         paper_titles[text] = True
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Format the text box
[?2004l[?2004h>                     text_frame = shape.text_frame
[?2004l[?2004h>                     text_frame.word_wrap = True
[?2004l[?2004h>                     text_frame.vertical_anchor = MSO_ANCHOR.MIDDLE
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Format all paragraphs and runs
[?2004l[?2004h>                     for paragraph in text_frame.paragraphs:
[?2004l[?2004h>                         paragraph.alignment = PP_ALIGN.CENTER
[?2004l[?2004h>                         
[?2004l[?2004h>                         for run in paragraph.runs:
[?2004l[?2004h>                             run.font.name = 'Arial'
[?2004l[?2004h>                             run.font.size = Pt(16)
[?2004l[?2004h>                             run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)
[?2004l[?2004h>                             run.font.bold = False
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Adjust shape position and size
[?2004l[?2004h>                     slide_width = prs.slide_width
[?2004l[?2004h>                     slide_height = prs.slide_height
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Set width to 90% of slide width for single-line display
[?2004l[?2004h>                     shape.width = int(slide_width * 0.9)
[?2004l[?2004h>                     shape.left = int((slide_width - shape.width) / 2)
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Position at bottom center (0.8 inches from bottom)
[?2004l[?2004h>                     shape.top = int(slide_height - Inches(0.8))
