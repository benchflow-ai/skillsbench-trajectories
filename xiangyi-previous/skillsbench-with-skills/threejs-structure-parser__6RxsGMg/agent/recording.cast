[8.426828, "o", "\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const mesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(geometry);\r\n\u001b[32m\u001b[K76\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const basePlatformMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(basePlatformGeometry);\r\n\u001b[32m\u001b[K112\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const axleHousingMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(axleHousingGeometry);\r\n"]
[8.426924, "o", "\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const hubMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(hubGeometry);\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const outerRimMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(outerRimGeometry);\r\n\u001b[32m\u001b[K182\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        const cabinBodyMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(cabinBodyGeometry);\r\n\u001b[32m\u001b[K190\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        const cabinRoofMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(cabinRoofGeometry);\r\n\u001b[32m\u001b[K197\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        const cabinFloorMesh = \u001b[01;31m\u001b[Knew THREE.Mesh\u001b[m\u001b[K(cabinFloorGeometry);\r\n"]
