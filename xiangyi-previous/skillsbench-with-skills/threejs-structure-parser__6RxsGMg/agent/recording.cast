[111.357625, "o", "\u001b[?2004h>   if (obj.type === 'Group') {\r\n\u001b[?2004l\r\u001b[?2004h>     groups.push(obj);\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.357705, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.357777, "o", "> let unnamedCount = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.357838, "o", "> for (const group of groups) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.357941, "o", "  let partName = group.name || `group_${unnamedCount++}`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.357996, "o", "> "]
[111.358056, "o", "  const partDir = path.join(partMeshesDir, partName);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.35813, "o", "  fs.mkdirSync(partDir, { recursive: true });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.358188, "o", "\u001b[?2004h> "]
[111.358255, "o", "  // Export direct child meshes of this group\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358317, "o", "  for (const child of group.children) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358367, "o", "    if (child.isMesh) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358465, "o", "      const meshName = child.name || `mesh_${child.id}`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358539, "o", "      const objText = exporter.parse(child);\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.35859, "o", "> "]
[111.358661, "o", "      fs.writeFileSync(path.join(partDir, `${meshName}.obj`), objText);\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.358712, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[111.358765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358834, "o", "  // Export the whole group as a link (part mesh)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.358908, "o", "  const groupObj = exporter.parse(group);\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.358961, "o", "> "]
[111.359033, "o", "  fs.writeFileSync(path.join(linksDir, `${partName}.obj`), groupObj);\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.359092, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.359142, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[111.360374, "o", "\u001b[?2004hroot@4e191e277b7f:~# "]
[111.461491, "i", "node /root/export_obj.mjs\n"]
[111.461703, "o", "node /root/export_obj.mjs\r\n\u001b[?2004l\r"]
