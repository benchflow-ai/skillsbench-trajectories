[54.899818, "o", "\u001b[?2004hroot@4e191e277b7f:~# "]
[111.355919, "i", "cat > /root/export_obj.mjs <<'EOF'\nimport fs from 'fs';\nimport path from 'path';\nimport { createScene } from '/root/data/object.js';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\n\nconst outputBase = '/root/output';\nconst partMeshesDir = path.join(outputBase, 'part_meshes');\nconst linksDir = path.join(outputBase, 'links');\n\nfs.mkdirSync(partMeshesDir, { recursive: true });\nfs.mkdirSync(linksDir, { recursive: true });\n\nconst scene = createScene();\nscene.updateMatrixWorld(true);\n\nconst exporter = new OBJExporter();\n\n// Collect all groups\nconst groups = [];\nscene.traverse(obj => {\n  if (obj.type === 'Group') {\n    groups.push(obj);\n  }\n});\n\nlet unnamedCount = 0;\n\nfor (const group of groups) {\n  let partName = group.name || `group_${unnamedCount++}`;\n  const partDir = path.join(partMeshesDir, partName);\n  fs.mkdirSync(partDir, { recursive: true });\n\n  // Export direct child meshes of this group\n  for (const child of group.children) {\n    if (child.isMesh) {\n      const meshName = child.name || `mesh_${child.id}`;\n      const objText = exporter.parse(child);\n      fs.writeFileSync(path.join(partDir, `${meshName}.obj`), objText);\n    }\n  }\n\n  // Export the whole group as a link (part mesh)\n  const groupObj = exporter.parse(group);\n  fs.writeFileSync(path.join(linksDir, `${partName}.obj`), groupObj);\n}\n\nEOF\n"]
[111.356271, "o", "cat > /root/export_obj.mjs <<'EOF'\r\n\u001b[?2004l\r"]
