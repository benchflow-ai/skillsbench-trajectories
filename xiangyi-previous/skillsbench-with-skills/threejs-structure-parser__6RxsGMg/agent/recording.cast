[8.263214, "o", "grep -R \"new THREE.Group\" -n /root/data/object.js\r\n\u001b[?2004l\r"]
[8.264233, "o", "\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const root = \u001b[01;31m\u001b[Knew THREE.Group\u001b[m\u001b[K();\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const support_structure = \u001b[01;31m\u001b[Knew THREE.Group\u001b[m\u001b[K();\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    const wheel_structure = \u001b[01;31m\u001b[Knew THREE.Group\u001b[m\u001b[K();\r\n\u001b[32m\u001b[K165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        const cabinGroup = \u001b[01;31m\u001b[Knew THREE.Group\u001b[m\u001b[K();\r\n"]
[8.264395, "o", "\u001b[?2004hroot@4e191e277b7f:~# "]
