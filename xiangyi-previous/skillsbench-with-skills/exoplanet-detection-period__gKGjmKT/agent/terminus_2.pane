[?2004hroot@43efcbe6ff62:~# cat <<EOF > solve_period.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from astropy.timeseries import BoxLeastSquares
[?2004l[?2004h> from scipy.ndimage import median_filter
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> data = np.loadtxt('/root/data/tess_lc.txt')
[?2004l[?2004h> time = data[:, 0]
[?2004l[?2004h> flux = data[:, 1]
[?2004l[?2004h> flags = data[:, 2]
[?2004l[?2004h> 
[?2004l[?2004h> # Filter good quality data
[?2004l[?2004h> mask = (flags == 0)
[?2004l[?2004h> time = time[mask]
[?2004l[?2004h> flux = flux[mask]
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate cadence and window size for detrending
[?2004l[?2004h> cadence = np.median(np.diff(time))
[?2004l[?2004h> window_days = 0.5
[?2004l[?2004h> window_points = int(window_days / cadence)
[?2004l[?2004h> if window_points % 2 == 0:
[?2004l[?2004h>     window_points += 1
[?2004l[?2004h> 
[?2004l[?2004h> # Detrending
[?2004l[?2004h> # Use a median filter to estimate the trend
[?2004l[?2004h> trend = median_filter(flux, size=window_points)
[?2004l[?2004h> flux_flat = flux / trend
[?2004l[?2004h> 
[?2004l[?2004h> # BLS Search
[?2004l[?2004h> model = BoxLeastSquares(time, flux_flat)
[?2004l[?2004h> 
[?2004l[?2004h> # Coarse search
[?2004l[?2004h> periods_coarse = np.linspace(0.5, 12.0, 10000)
[?2004l[?2004h> durations = np.linspace(0.05, 0.2, 5) # 1.2 to 4.8 hours
[?2004l[?2004h> periodogram_coarse = model.power(periods_coarse, durations)
[?2004l[?2004h> 
[?2004l[?2004h> best_period_coarse = periods_coarse[np.argmax(periodogram_coarse.power)]
[?2004l[?2004h> 
[?2004l[?2004h> # Fine search
[?2004l[?2004h> periods_fine = np.linspace(best_period_coarse - 0.1, best_period_coarse + 0.1, 10000)
[?2004l[?2004h> periodogram_fine = model.power(periods_fine, durations)
[?2004l[?2004h> 
[?2004l[?2004h> best_period = periods_fine[np.argmax(periodogram_fine.power)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found period: {best_period:.5f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write to file
[?2004l[?2004h> with open('/root/period.txt', 'w') as f:
[?2004l[?2004h>     f.write(f"{best_period:.5f}\n")
[?2004l[?2004h> EOF
