[82.872429, "i", "cat <<EOF > solve_period.py\nimport numpy as np\nfrom astropy.timeseries import BoxLeastSquares\nfrom scipy.ndimage import median_filter\n\n# Load data\ndata = np.loadtxt('/root/data/tess_lc.txt')\ntime = data[:, 0]\nflux = data[:, 1]\nflags = data[:, 2]\n\n# Filter good quality data\nmask = (flags == 0)\ntime = time[mask]\nflux = flux[mask]\n\n# Calculate cadence and window size for detrending\ncadence = np.median(np.diff(time))\nwindow_days = 0.5\nwindow_points = int(window_days / cadence)\nif window_points % 2 == 0:\n    window_points += 1\n\n# Detrending\n# Use a median filter to estimate the trend\ntrend = median_filter(flux, size=window_points)\nflux_flat = flux / trend\n\n# BLS Search\nmodel = BoxLeastSquares(time, flux_flat)\n\n# Coarse search\nperiods_coarse = np.linspace(0.5, 12.0, 10000)\ndurations = np.linspace(0.05, 0.2, 5) # 1.2 to 4.8 hours\nperiodogram_coarse = model.power(periods_coarse, durations)\n\nbest_period_coarse = periods_coarse[np.argmax(periodogram_coarse.power)]\n\n# Fine search\nperiods_fine = np.linspace(best_period_c"]
[82.872506, "i", "oarse - 0.1, best_period_coarse + 0.1, 10000)\nperiodogram_fine = model.power(periods_fine, durations)\n\nbest_period = periods_fine[np.argmax(periodogram_fine.power)]\n\nprint(f\"Found period: {best_period:.5f}\")\n\n# Write to file\nwith open('/root/period.txt', 'w') as f:\n    f.write(f\"{best_period:.5f}\\n\")\nEOF\npython3 solve_period.py\n"]
