[420.408271, "o", "                                .withTimestampAssigner((event, timestamp) -> event.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.408328, "o", "                );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[420.408382, "o", " \u001b[?2004h> "]
[420.408486, "o", "        // Filter only SUBMIT events (type 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.408651, "o", "        DataStream<TaskEvent> submitEvents = taskEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.408818, "o", "                .filter(event -> event.eventType == 0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[420.408878, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[420.40895, "o", "        // Read and parse job events\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.409004, "o", "> "]
[420.409093, "o", "        DataStream<JobEvent> jobEvents = env\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.409142, "o", "> "]
[420.409227, "o", "                .readTextFile(jobInput)\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.409275, "o", "> "]
[420.409436, "o", "                .map(new MapFunction<String, JobEvent>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.409485, "o", "> "]
[420.409542, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.409689, "o", "                    public JobEvent map(String line) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.409758, "o", "> "]
[420.40983, "o", "                        String[] fields = line.split(\",\", -1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.409904, "o", "                        JobEvent event = new JobEvent();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.410018, "o", "                        event.timestamp = Long.parseLong(fields[0]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.41007, "o", "> "]
[420.410117, "o", "                        event.missingInfo = fields[1];\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.41017, "o", "> "]
[420.410239, "o", "                        event.jobId = Long.parseLong(fields[2]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.410294, "o", "> "]
[420.410361, "o", "                        event.eventType = Integer.parseInt(fields[3]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.410418, "o", "> "]
[420.410472, "o", "                        event.user = fields[4];\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.410541, "o", "> "]
[420.410603, "o", "                        event.schedulingClass = Integer.parseInt(fields[5]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.410677, "o", "                        event.jobName = fields[6];\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.410732, "o", "> "]
[420.410793, "o", "                        event.logicalJobName = fields[7];\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.410837, "o", "> "]
[420.410897, "o", "                        return event;\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r"]
[420.41095, "o", "\u001b[?2004h> "]
[420.411007, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.411062, "o", "                .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.41118, "o", "                        WatermarkStrategy.<JobEvent>forMonotonousTimestamps()\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.411235, "o", "> "]
[420.411341, "o", "                                .withTimestampAssigner((event, timestamp) -> event.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.411383, "o", "                );\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.411441, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.411504, "o", "        // Filter job FINISH events (type 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.41159, "o", "        DataStream<JobEvent> finishedJobs = jobEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.411693, "o", "                .filter(event -> event.eventType == 4);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[420.411747, "o", "\u001b[?2004h> "]
[420.411811, "o", "        // Connect task submits with finished jobs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.411883, "o", "        DataStream<String> result = submitEvents\r\n\u001b[?2004l\r"]
[420.411937, "o", "\u001b[?2004h> "]
[420.411997, "o", "                .keyBy(event -> event.jobId)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412094, "o", "                .connect(finishedJobs.keyBy(event -> event.jobId))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.41225, "o", "                .process(new KeyedCoProcessFunction<Long, TaskEvent, JobEvent, String>() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412362, "o", "                    private ListState<Long> submitTimestampsState;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412417, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.41247, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.412522, "o", "> "]
[420.412587, "o", "                    public void open(Configuration parameters) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412726, "o", "                        submitTimestampsState = getRuntimeContext().getListState(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412905, "o", "                                new ListStateDescriptor<>(\"submitTimestamps\", Long.class));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.412971, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.413012, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.413162, "o", "                    public void processElement1(TaskEvent taskEvent, Context ctx,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.413307, "o", "                                                Collector<String> out) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.413453, "o", "                        // Store the timestamp of each SUBMIT event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.413543, "o", "                        submitTimestampsState.add(taskEvent.timestamp);\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.413566, "o", "> "]
[420.413587, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.413611, "o", "> \r\n\u001b[?2004l\r"]
[420.413634, "o", "\u001b[?2004h> "]
[420.413822, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h>                     public void processElement2(JobEvent jobEvent, Context ctx,\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.41385, "o", "> "]
[420.413971, "o", "                                                Collector<String> out) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414121, "o", "                        // When job finishes, compute sessions from stored timestamps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414229, "o", "                        List<Long> timestamps = new ArrayList<>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414352, "o", "                        for (Long ts : submitTimestampsState.get()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.41444, "o", "                            timestamps.add(ts);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414544, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h>                         \r\n\u001b[?2004l\r"]
[420.414569, "o", "\u001b[?2004h> "]
[420.414672, "o", "                        if (timestamps.isEmpty()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414701, "o", "                            return;\r\n\u001b[?2004l\r"]
[420.414721, "o", "\u001b[?2004h> "]
[420.414849, "o", "                        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414918, "o", "                        // Sort timestamps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.414986, "o", "                        Collections.sort(timestamps);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[420.415026, "o", "\u001b[?2004h> "]
[420.415113, "o", "                        // Compute sessions with gap threshold\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.415206, "o", "                        int maxSessionSize = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.415283, "o", "                        int currentSessionSize = 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.415316, "o", "> "]
[420.415393, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.415463, "o", "                        for (int i = 1; i < timestamps.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.415606, "o", "                            long gap = timestamps.get(i) - timestamps.get(i - 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.415698, "o", "                            if (gap <= sessionGapMicros) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.415775, "o", "> "]
[420.415824, "o", "                                // Still in the same session\r\n\u001b[?2004l\r"]
[420.415857, "o", "\u001b[?2004h> "]
[420.416065, "o", "                                currentSessionSize++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416127, "o", "                            } else {\r\n\u001b[?2004l\r\u001b[?2004h>                                 // New session starts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416281, "o", "                                maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416368, "o", "                                currentSessionSize = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416432, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416471, "o", "                        }\r\n\u001b[?2004l\r"]
[420.416502, "o", "\u001b[?2004h> "]
[420.41659, "o", "                        // Don't forget the last session\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416726, "o", "                        maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[420.416796, "o", "\u001b[?2004h> "]
[420.416881, "o", "                        out.collect(\"(\" + jobEvent.jobId + \",\" + maxSessionSize + \")\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416931, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.416996, "o", "                });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[420.417033, "o", "> "]
[420.417103, "o", "        result.writeAsText(outputPath).setParallelism(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[420.41714, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.417222, "o", "        env.execute(\"LongestSessionPerJob\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[420.417259, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
