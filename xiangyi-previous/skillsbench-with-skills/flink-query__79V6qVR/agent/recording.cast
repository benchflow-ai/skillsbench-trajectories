[553.31248, "o", ">                     }\r\n\u001b[?2004l\r"]
[553.312535, "o", "\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.312603, "o", "                .assignTimestampsAndWatermarks(\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.312655, "o", "> "]
[553.31274, "o", "                        WatermarkStrategy.<JobEvent>forMonotonousTimestamps()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.312897, "o", "                                .withTimestampAssigner((event, timestamp) -> event.timestamp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.312922, "o", ">                 );\r\n\u001b[?2004l\r"]
[553.312998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.31305, "o", "\u001b[?2004h> "]
[553.313103, "o", "        // Filter job completion events (FINISH=4 or KILL=5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.313178, "o", "        DataStream<JobEvent> completedJobs = jobEvents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.313296, "o", "                .filter(event -> event.eventType == 4 || event.eventType == 5);\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313344, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.313405, "o", "        // Connect task submits with completed jobs\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313436, "o", "> "]
[553.313497, "o", "        DataStream<String> result = submitEvents\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313546, "o", "> "]
[553.313597, "o", "                .keyBy(event -> event.jobId)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.313696, "o", "                .connect(completedJobs.keyBy(event -> event.jobId))\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313723, "o", "> "]
[553.313847, "o", "                .process(new KeyedCoProcessFunction<Long, TaskEvent, JobEvent, String>() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313874, "o", "> "]
[553.313965, "o", "                    private ListState<Long> submitTimestampsState;\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.313994, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.314059, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.314181, "o", "                    public void open(Configuration parameters) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.314232, "o", "> "]
[553.314325, "o", "                        submitTimestampsState = getRuntimeContext().getListState(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.314464, "o", "                                new ListStateDescriptor<>(\"submitTimestamps\", Long.class));\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.31455, "o", "> "]
[553.314584, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.31467, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.31477, "o", "                    public void processElement1(TaskEvent taskEvent, Context ctx,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.314914, "o", "                                                Collector<String> out) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.314942, "o", "> "]
[553.315028, "o", "                        // Store the timestamp of each SUBMIT event\r\n\u001b[?2004l\r"]
[553.315075, "o", "\u001b[?2004h> "]
[553.315159, "o", "                        submitTimestampsState.add(taskEvent.timestamp);\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.315205, "o", "> "]
[553.31525, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.315307, "o", "                    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.315424, "o", "                    public void processElement2(JobEvent jobEvent, Context ctx,\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.31547, "o", "> "]
[553.315575, "o", "                                                Collector<String> out) throws Exception {\r\n\u001b[?2004l\r"]
[553.315622, "o", "\u001b[?2004h> "]
[553.315749, "o", "                        // When job completes, compute sessions from stored timestamps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.315851, "o", "                        List<Long> timestamps = new ArrayList<>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.315899, "o", "> "]
[553.315969, "o", "                        for (Long ts : submitTimestampsState.get()) {\r\n\u001b[?2004l\r"]
[553.316015, "o", "\u001b[?2004h> "]
[553.316058, "o", "                            timestamps.add(ts);\r\n\u001b[?2004l\r"]
[553.316103, "o", "\u001b[?2004h> "]
[553.31613, "o", "                        }\r\n\u001b[?2004l\r"]
[553.316155, "o", "\u001b[?2004h> "]
[553.316239, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h"]
[553.3163, "o", "> "]
[553.316353, "o", "                        if (timestamps.isEmpty()) {\r\n\u001b[?2004l\r\u001b[?2004h>                             return;\r\n\u001b[?2004l\r"]
[553.316404, "o", "\u001b[?2004h>                         }\r\n\u001b[?2004l\r"]
[553.316453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.316501, "o", "                        // Sort timestamps\r\n\u001b[?2004l\r"]
[553.316546, "o", "\u001b[?2004h> "]
[553.316599, "o", "                        Collections.sort(timestamps);\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.316651, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.316728, "o", "                        // Compute sessions with gap threshold\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.316781, "o", "> "]
[553.316832, "o", "                        int maxSessionSize = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.316915, "o", "                        int currentSessionSize = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.316963, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317015, "o", "> "]
[553.31708, "o", "                        for (int i = 1; i < timestamps.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317137, "o", "> "]
[553.317229, "o", "                            long gap = timestamps.get(i) - timestamps.get(i - 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317276, "o", "> "]
[553.317326, "o", "                            if (gap <= sessionGapMicros) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317372, "o", "> "]
[553.317431, "o", "                                // Still in the same session\r\n\u001b[?2004l\r"]
[553.317477, "o", "\u001b[?2004h> "]
[553.317529, "o", "                                currentSessionSize++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317574, "o", "> "]
[553.317619, "o", "                            } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317665, "o", "> "]
[553.317713, "o", "                                // New session starts\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.317762, "o", "> "]
[553.317853, "o", "                                maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\r\n\u001b[?2004l\r"]
[553.317883, "o", "\u001b[?2004h> "]
[553.317959, "o", "                                currentSessionSize = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.318027, "o", "                            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.318071, "o", "                        }\r\n\u001b[?2004l\r"]
[553.318124, "o", "\u001b[?2004h> "]
[553.31818, "o", "                        // Don't forget the last session\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.318232, "o", "> "]
[553.318324, "o", "                        maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.318369, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.318513, "o", "                        out.collect(\"(\" + jobEvent.jobId + \",\" + maxSessionSize + \")\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.31856, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.318584, "o", "> "]
[553.31864, "o", "                });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
