[75.417263, "i", "cat > src/main/java/clusterdata/datatypes/JobEvent.java << 'EOF'\npackage clusterdata.datatypes;\n\npublic class JobEvent {\n    public long timestamp;\n    public String missingInfo;\n    public long jobId;\n    public int eventType;\n    public String user;\n    public int schedulingClass;\n    public String jobName;\n    public String logicalJobName;\n\n    public JobEvent() {}\n\n    public JobEvent(long timestamp, String missingInfo, long jobId, int eventType,\n                    String user, int schedulingClass, String jobName, String logicalJobName) {\n        this.timestamp = timestamp;\n        this.missingInfo = missingInfo;\n        this.jobId = jobId;\n        this.eventType = eventType;\n        this.user = user;\n        this.schedulingClass = schedulingClass;\n        this.jobName = jobName;\n        this.logicalJobName = logicalJobName;\n    }\n}\nEOF\n"]
