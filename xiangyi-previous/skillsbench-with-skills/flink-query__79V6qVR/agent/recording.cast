[553.311645, "o", "                        event.timestamp = Long.parseLong(fields[0]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.311684, "o", "                        event.missingInfo = fields[1];\r\n\u001b[?2004l\r"]
[553.311749, "o", "\u001b[?2004h> "]
[553.311807, "o", "                        event.jobId = Long.parseLong(fields[2]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.311938, "o", "                        event.eventType = Integer.parseInt(fields[3]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.312013, "o", "                        event.user = fields[4];\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.312063, "o", "> "]
[553.312151, "o", "                        event.schedulingClass = Integer.parseInt(fields[5]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.312241, "o", "                        event.jobName = fields[6];\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.312289, "o", "> "]
[553.312336, "o", "                        event.logicalJobName = fields[7];\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.312383, "o", "> "]
