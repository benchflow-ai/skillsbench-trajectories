[75.2385, "i", "cat > src/main/java/clusterdata/datatypes/TaskEvent.java << 'EOF'\npackage clusterdata.datatypes;\n\npublic class TaskEvent {\n    public long timestamp;\n    public String missingInfo;\n    public long jobId;\n    public long taskIndex;\n    public Long machineId;\n    public int eventType;\n    public String user;\n    public int schedulingClass;\n    public int priority;\n    public double cpuRequest;\n    public double memoryRequest;\n    public double diskRequest;\n    public int differentMachines;\n\n    public TaskEvent() {}\n\n    public TaskEvent(long timestamp, String missingInfo, long jobId, long taskIndex,\n                     Long machineId, int eventType, String user, int schedulingClass,\n                     int priority, double cpuRequest, double memoryRequest,\n                     double diskRequest, int differentMachines) {\n        this.timestamp = timestamp;\n        this.missingInfo = missingInfo;\n        this.jobId = jobId;\n        this.taskIndex = taskIndex;\n        this.machineId = machineId;\n        this.eventType = eventType;\n        this.user = user;\n        this.schedulingClass = schedulingClass;\n        this.priority = priority;\n        this.cpuRequest = cpuRequest;\n        this.memoryRequest = memoryRequest;\n        this.diskRequest = diskRequest;\n        this.differentMachines = differentMachines;\n    }\n}\nEOF\n"]
