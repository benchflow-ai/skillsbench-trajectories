[197.587075, "o", "\u001b[?2004h> "]
[197.587196, "o", "window_start_sec = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.587383, "o", "window_end_sec = 12.116\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.587739, "o", "window_duration_sec = window_end_sec - window_start_sec\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.58787, "o", "# Generate TTS audio using espeak-ng\r\n\u001b[?2004l\r"]
[197.588006, "o", "\u001b[?2004h> "]
[197.588216, "o", "print(\"Generating TTS audio with espeak-ng...\")\r\n\u001b[?2004l\r"]
[197.588355, "o", "\u001b[?2004h> subprocess.run([\r\n\u001b[?2004l\r"]
[197.588491, "o", "\u001b[?2004h> "]
[197.588681, "o", "    'espeak-ng', '-v', 'ja', '-w', '/tmp/tts_raw.wav',\r\n"]
[197.58883, "o", "\u001b[?2004l\r\u001b[?2004h>     target_text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.589008, "o", "], check=True, capture_output=True)\r\n\u001b[?2004l\r"]
[197.589184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get TTS duration"]
[197.589408, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.589658, "o", "    'ffprobe', '-v', 'quiet', '-print_format', 'json',\r\n\u001b[?2004l\r"]
[197.58987, "o", "\u001b[?2004h>     '-show_format', '/tmp/tts_raw.wav'\r\n\u001b[?2004l\r"]
[197.590067, "o", "\u001b[?2004h> "]
[197.590241, "o", "], capture_output=True, text=True, check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.590403, "o", "probe_data = json.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.590705, "o", "tts_duration_sec = float(probe_data['format']['duration'])\r\n\u001b[?2004l\r"]
[197.590834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.591153, "o", "print(f\"TTS duration: {tts_duration_sec}s, Target: {window_duration_sec}s\")\r\n\u001b[?2004l\r"]
[197.591239, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.591347, "o", "# Adjust speed to fit window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.591553, "o", "if tts_duration_sec < window_duration_sec:\r\n\u001b[?2004l\r"]
[197.591672, "o", "\u001b[?2004h> "]
[197.591781, "o", "    # Need to slow down or add silence\r\n\u001b[?2004l\r"]
[197.591906, "o", "\u001b[?2004h> "]
[197.592095, "o", "    speed_factor = tts_duration_sec / window_duration_sec\r\n\u001b[?2004l\r"]
[197.592211, "o", "\u001b[?2004h> "]
[197.592431, "o", "    if speed_factor < 0.5:  # Too slow, add silence instead\r\n\u001b[?2004l\r"]
[197.592551, "o", "\u001b[?2004h> "]
[197.592815, "o", "        silence_duration = window_duration_sec - tts_duration_sec\r\n\u001b[?2004l\r"]
[197.5929, "o", "\u001b[?2004h> "]
[197.593079, "o", "        print(f\"Adding {silence_duration}s of silence\")\r\n\u001b[?2004l\r"]
[197.593282, "o", "\u001b[?2004h>         subprocess.run([\r\n\u001b[?2004l\r"]
[197.593407, "o", "\u001b[?2004h> "]
[197.593528, "o", "            'ffmpeg', '-i', '/tmp/tts_raw.wav',\r\n\u001b[?2004l\r"]
[197.593647, "o", "\u001b[?2004h> "]
[197.593979, "o", "            '-f', 'lavfi', '-i', f'anullsrc=r=22050:cl=mono:d={silence_duration}',\r\n\u001b[?2004l\r"]
[197.594149, "o", "\u001b[?2004h> "]
[197.594403, "o", "            '-filter_complex', '[0:a][1:a]concat=n=2:v=0:a=1',\r\n\u001b[?2004l\r"]
[197.594593, "o", "\u001b[?2004h> "]
[197.594719, "o", "            '-y', '/tmp/tts_adjusted.wav'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.594909, "o", "        ], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.595097, "o", "        duration_control = \"pad_silence\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.59525, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.595511, "o", "        print(f\"Adjusting speed by factor: {speed_factor}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.595765, "o", "        subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.595957, "o", "            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\r\n\u001b[?2004l\r"]
[197.596149, "o", "\u001b[?2004h> "]
[197.596365, "o", "            '-filter:a', f'atempo={speed_factor}',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.596597, "o", "            '/tmp/tts_adjusted.wav'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.596806, "o", "        ], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.597013, "o", "        duration_control = \"rate_adjust\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.597263, "o", "elif tts_duration_sec > window_duration_sec:\r\n\u001b[?2004l\r"]
[197.597459, "o", "\u001b[?2004h>     # Need to speed up\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.597738, "o", "    speed_factor = tts_duration_sec / window_duration_sec\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.597984, "o", "    if speed_factor > 2.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.598149, "o", "        # Too fast for single atempo, chain them\r\n\u001b[?2004l\r"]
[197.598281, "o", "\u001b[?2004h> "]
[197.598529, "o", "        print(f\"Adjusting speed by factor: {speed_factor} (chained)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.598708, "o", ">         factor1 = 2.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.598901, "o", "        factor2 = speed_factor / 2.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.599077, "o", "        subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.599293, "o", "            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.599433, "o", "> "]
[197.599616, "o", "            '-filter:a', f'atempo={factor1},atempo={factor2}',\r\n\u001b[?2004l\r"]
[197.599764, "o", "\u001b[?2004h> "]
[197.600063, "o", "            '/tmp/tts_adjusted.wav'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.600154, "o", "        ], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.60037, "o", "        duration_control = \"rate_adjust\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.600518, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.600769, "o", "        print(f\"Adjusting speed by factor: {speed_factor}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.600906, "o", "        subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.601019, "o", "> "]
[197.601257, "o", "            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.601463, "o", "            '-filter:a', f'atempo={speed_factor}',\r\n\u001b[?2004l\r"]
[197.601595, "o", "\u001b[?2004h> "]
[197.601826, "o", "            '/tmp/tts_adjusted.wav'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.601957, "o", "        ], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.602083, "o", "> "]
[197.602186, "o", "        duration_control = \"rate_adjust\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.602329, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.602717, "o", "    subprocess.run(['cp', '/tmp/tts_raw.wav', '/tmp/tts_adjusted.wav'], check=True)\r\n\u001b[?2004l\r"]
[197.602855, "o", "\u001b[?2004h> "]
[197.60303, "o", "    duration_control = \"rate_adjust\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.60317, "o", "# First pass: measure loudness\r\n\u001b[?2004l\r"]
[197.603299, "o", "\u001b[?2004h> "]
[197.603524, "o", "print(\"Measuring loudness...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.603658, "o", "result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.603857, "o", "    'ffmpeg', '-i', '/tmp/tts_adjusted.wav',\r\n\u001b[?2004l\r"]
[197.603984, "o", "\u001b[?2004h> "]
[197.604245, "o", "    '-af', 'loudnorm=I=-23:TP=-1.5:LRA=11:print_format=json',\r\n\u001b[?2004l\r"]
[197.604423, "o", "\u001b[?2004h>     '-f', 'null', '-'\r\n"]
[197.604534, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[197.604835, "o", "], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\r\n\u001b[?2004l\r"]
[197.60497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.605225, "o", "# Extract loudness measurements\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.605325, "o", "json_start = result.stdout.rfind('{')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.605463, "o", "if json_start != -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.605717, "o", "    json_str = result.stdout[json_start:].strip()\r\n\u001b[?2004l\r"]
[197.605851, "o", "\u001b[?2004h> "]
[197.605964, "o", "    # Find the end of JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.606102, "o", "    brace_count = 0\r\n\u001b[?2004l\r\u001b[?2004h>     json_end = 0"]
[197.606216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.606325, "o", "    for i, char in enumerate(json_str):\r\n\u001b[?2004l\r"]
[197.606439, "o", "\u001b[?2004h> "]
[197.606573, "o", "        if char == '{':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.606699, "o", "            brace_count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.606818, "o", "        elif char == '}':\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.606975, "o", "> "]
[197.607088, "o", "            brace_count -= 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.607318, "o", "            if brace_count == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.607434, "o", "                json_end = i + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.607647, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.607776, "o", "    json_str = json_str[:json_end]\r\n\u001b[?2004l\r"]
[197.607889, "o", "\u001b[?2004h> "]
[197.608011, "o", "    loudnorm_data = json.loads(json_str)\r\n\u001b[?2004l\r"]
[197.608123, "o", "\u001b[?2004h> "]
[197.6083, "o", "    measured_i = loudnorm_data.get('input_i', '-23.0')\r\n\u001b[?2004l\r"]
[197.608606, "o", "\u001b[?2004h> "]
[197.608701, "o", "    measured_tp = loudnorm_data.get('input_tp', '-1.5')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.609002, "o", "    measured_lra = loudnorm_data.get('input_lra', '11.0')\r\n\u001b[?2004l\r"]
[197.609401, "o", "\u001b[?2004h> "]
[197.609494, "o", "    measured_thresh = loudnorm_data.get('input_thresh', '-33.0')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.60975, "o", "    target_offset = loudnorm_data.get('target_offset', '0.0')\r\n\u001b[?2004l\r"]
[197.609889, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.610045, "o", "    measured_i = '-23.0'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.610181, "o", "    measured_tp = '-1.5'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.610366, "o", "    measured_lra = '11.0'\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.610487, "o", "> "]
[197.610642, "o", "    measured_thresh = '-33.0'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.610783, "o", "    target_offset = '0.0'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.610965, "o", "print(f\"Measured I: {measured_i} LUFS\")\r\n\u001b[?2004l\r"]
[197.611118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.611307, "o", "# Second pass: apply normalization and convert to 48kHz mono\r\n\u001b[?2004l\r"]
[197.611435, "o", "\u001b[?2004h> "]
[197.611681, "o", "print(\"Normalizing audio to -23 LUFS and converting to 48kHz mono...\")\r\n"]
[197.611808, "o", "\u001b[?2004l\r\u001b[?2004h> subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.611953, "o", "    'ffmpeg', '-i', '/tmp/tts_adjusted.wav', '-y',\r\n\u001b[?2004l\r"]
[197.612078, "o", "\u001b[?2004h>     '-ar', '48000',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.612197, "o", "    '-ac', '1',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.612644, "o", "    '-af', f'loudnorm=I=-23:TP=-1.5:LRA=11:measured_I={measured_i}:measured_LRA={measured_lra}:measured_TP={measured_tp}:measured_thresh={measured_thresh}:offset={target_offset}:linear=true',\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.612812, "o", ">     '/outputs/tts_segments/seg_0.wav'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.612937, "o", "], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613061, "o", "print(\"Verifying final audio...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613229, "o", "# Get final audio properties\r\n\u001b[?2004l\r\u001b[?2004h> result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613374, "o", "    'ffprobe', '-v', 'quiet', '-print_format', 'json',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613533, "o", "    '-show_format', '-show_streams', '/outputs/tts_segments/seg_0.wav'\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.613675, "o", "> ], capture_output=True, text=True, check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613798, "o", "probe_data = json.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.613935, "o", "final_tts_duration = float(probe_data['format']['duration'])\r\n\u001b[?2004l\r"]
[197.614052, "o", "\u001b[?2004h> "]
[197.614159, "o", "final_sample_rate = int(probe_data['streams'][0]['sample_rate'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.614275, "o", "final_channels = int(probe_data['streams'][0]['channels'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.614392, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61459, "o", "print(f\"Final audio: {final_sample_rate}Hz, {final_channels} channel(s), {final_tts_duration}s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.614695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Measure final LUFS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.614822, "o", "result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.614939, "o", "    'ffmpeg', '-i', '/outputs/tts_segments/seg_0.wav',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615078, "o", "    '-af', 'loudnorm=I=-23:TP=-1.5:LRA=11:print_format=json',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615202, "o", "    '-f', 'null', '-'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615318, "o", "], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.615432, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615548, "o", "json_start = result.stdout.rfind('{')\r\n\u001b[?2004l\r\u001b[?2004h> if json_start != -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615681, "o", "    json_str = result.stdout[json_start:].strip()\r\n\u001b[?2004l\r"]
[197.61583, "o", "\u001b[?2004h>     brace_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.615907, "o", "    json_end = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616009, "o", "    for i, char in enumerate(json_str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616119, "o", "        if char == '{':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61629, "o", "            brace_count += 1\r\n\u001b[?2004l\r\u001b[?2004h>         elif char == '}':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616386, "o", "            brace_count -= 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616511, "o", "            if brace_count == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616656, "o", "                json_end = i + 1\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616781, "o", "    json_str = json_str[:json_end]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.616895, "o", "    loudnorm_data = json.loads(json_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61703, "o", "    measured_lufs = float(loudnorm_data.get('input_i', -23.0))\r\n\u001b[?2004l\r"]
[197.617197, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.617336, "o", "    measured_lufs = -23.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.617453, "o", "print(f\"Final measured LUFS: {measured_lufs}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.617572, "o", "# Create dubbed video\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.617697, "o", "print(\"Creating dubbed video...\")\r\n\u001b[?2004l\r\u001b[?2004h> subprocess.run([\r\n\u001b[?2004l\r"]
[197.617839, "o", "\u001b[?2004h> "]
[197.617955, "o", "    'ffmpeg', '-i', '/root/input.mp4', '-i', '/outputs/tts_segments/seg_0.wav', '-y',\r\n\u001b[?2004l\r"]
[197.618099, "o", "\u001b[?2004h>     '-map', '0:v', '-map', '1:a',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618231, "o", "    '-c:v', 'copy',\r\n\u001b[?2004l\r\u001b[?2004h>     '-c:a', 'aac',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61839, "o", "    '-b:a', '128k',\r\n\u001b[?2004l\r\u001b[?2004h>     '-ar', '48000',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618518, "o", "    '-ac', '1',\r\n\u001b[?2004l\r\u001b[?2004h>     '-shortest',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618602, "o", "    '/outputs/dubbed.mp4'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618726, "o", "], check=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618855, "o", "# Get final video duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.618973, "o", "result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.619091, "o", "    'ffprobe', '-v', 'quiet', '-print_format', 'json',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.619208, "o", "    '-show_format', '/outputs/dubbed.mp4'\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.619326, "o", "> "]
[197.619438, "o", "], capture_output=True, text=True, check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.619567, "o", "probe_data = json.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61973, "o", "new_duration_sec = float(probe_data['format']['duration'])\r\n\u001b[?2004l\r"]
[197.619854, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.61997, "o", "placed_start_sec = window_start_sec\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.620099, "o", "placed_end_sec = placed_start_sec + final_tts_duration\r\n\u001b[?2004l\r"]
[197.620263, "o", "\u001b[?2004h> drift_sec = placed_end_sec - window_end_sec\r\n\u001b[?2004l\r"]
[197.620355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nTiming verification:\")\r\n\u001b[?2004l\r"]
[197.620473, "o", "\u001b[?2004h> "]
[197.62059, "o", "print(f\"  Window: {window_start_sec}s - {window_end_sec}s ({window_duration_sec}s)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.620717, "o", "> "]
[197.620831, "o", "print(f\"  Placed: {placed_start_sec}s - {placed_end_sec:.3f}s ({final_tts_duration:.3f}s)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.620954, "o", "> print(f\"  Drift: {drift_sec:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621182, "o", "print(f\"  Start offset: {abs(placed_start_sec - window_start_sec)*1000:.1f}ms\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.621332, "o", "\u001b[?2004h> # Generate report\r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621456, "o", "    \"source_language\": \"en\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621568, "o", "    \"target_language\": target_lang,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621691, "o", "    \"audio_sample_rate_hz\": 48000,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621814, "o", "    \"audio_channels\": 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.621992, "o", "    \"original_duration_sec\": 12.052,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.622087, "o", "    \"new_duration_sec\": round(new_duration_sec, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.622143, "o", "    \"measured_lufs\": round(measured_lufs, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.622212, "o", "> "]
[197.622272, "o", "    \"speech_segments\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.622338, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.622439, "o", "            \"window_start_sec\": window_start_sec,\r\n\u001b[?2004l\r"]
[197.62251, "o", "\u001b[?2004h> "]
[197.622581, "o", "            \"window_end_sec\": window_end_sec,\r\n\u001b[?2004l\r"]
[197.622654, "o", "\u001b[?2004h> "]
[197.622734, "o", "            \"placed_start_sec\": placed_start_sec,\r\n\u001b[?2004l\r"]
[197.622826, "o", "\u001b[?2004h> "]
[197.622899, "o", "            \"placed_end_sec\": round(placed_end_sec, 2),\r\n\u001b[?2004l\r"]
[197.622998, "o", "\u001b[?2004h> "]
[197.62309, "o", "            \"source_text\": source_text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.623189, "o", "            \"target_text\": target_text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.623353, "o", "            \"window_duration_sec\": round(window_duration_sec, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.623447, "o", "> "]
[197.623513, "o", "            \"tts_duration_sec\": round(final_tts_duration, 2),\r\n\u001b[?2004l\r"]
[197.623603, "o", "\u001b[?2004h> "]
[197.623695, "o", "            \"drift_sec\": round(drift_sec, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.623823, "o", "            \"duration_control\": duration_control\r\n\u001b[?2004l\r"]
[197.623884, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n"]
[197.624, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.624046, "o", "\u001b[?2004h> "]
[197.624149, "o", "with open('/outputs/report.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[197.624217, "o", "\u001b[?2004h> "]
[197.624317, "o", "    json.dump(report, f, indent=2, ensure_ascii=False)\r\n\u001b[?2004l\r"]
[197.624387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.624478, "o", "print(f\"\\n✓ Dubbing complete!\")\r\n\u001b[?2004l\r"]
[197.624555, "o", "\u001b[?2004h> "]
[197.624648, "o", "print(f\"✓ Audio: /outputs/tts_segments/seg_0.wav\")\r\n\u001b[?2004l\r"]
[197.624721, "o", "\u001b[?2004h> "]
[197.624794, "o", "print(f\"✓ Video: /outputs/dubbed.mp4\")\r\n\u001b[?2004l\r"]
[197.624864, "o", "\u001b[?2004h> "]
[197.624942, "o", "print(f\"✓ Report: /outputs/report.json\")\r\n\u001b[?2004l\r"]
[197.62501, "o", "\u001b[?2004h> SCRIPT_EOF\r\n\u001b[?2004l\r"]
