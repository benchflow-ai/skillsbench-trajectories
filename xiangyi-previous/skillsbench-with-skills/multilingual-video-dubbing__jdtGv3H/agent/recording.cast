[142.224909, "o", "\u001b[?2004hroot@ebc29490d490:~# "]
[197.580976, "i", "cat > /root/dubbing_v3.py << 'SCRIPT_EOF'\nimport json\nimport subprocess\nimport os\nimport re\nfrom pathlib import Path\n\n# Read input files\nwith open('/root/target_language.txt', 'r') as f:\n    target_lang = f.read().strip()\n\nwith open('/root/reference_target_text.srt', 'r') as f:\n    srt_content = f.read()\n    lines = srt_content.strip().split('\\n')\n    target_text = lines[2] if len(lines) > 2 else ''\n\nwith open('/root/source_text.srt', 'r') as f:\n    srt_content = f.read()\n    lines = srt_content.strip().split('\\n')\n    source_text = lines[2] if len(lines) > 2 else ''\n\nprint(f\"Target language: {target_lang}\")\nprint(f\"Target text: {target_text}\")\nprint(f\"Source text: {source_text}\")\n\n# Segment timing\nwindow_start_sec = 0.0\nwindow_end_sec = 12.116\nwindow_duration_sec = window_end_sec - window_start_sec\n\n# Generate TTS audio using espeak-ng\nprint(\"Generating TTS audio with espeak-ng...\")\nsubprocess.run([\n    'espeak-ng', '-v', 'ja', '-w', '/tmp/tts_raw.wav',\n    target_text\n], check=True, capture_output=True)\n\n# Get TTS duration\nresult = subprocess.run([\n    'ffprobe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '/tmp/tts_raw.wav'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\ntts_duration_sec = float(probe_data['format']['duration'])\n\nprint(f\"TTS duration: {tts_duration_sec}s, Target: {window_duration_sec}s\")\n\n# Adjust speed to fit window\nif tts_duration_sec < window_duration_sec:\n    # Need to slow down or add silence\n    speed_factor = tts_duration_sec / window_duration_sec\n    if speed_factor < 0.5:  # Too slow, add silence instead\n        silence_duration = window_duration_sec - tts_duration_sec\n        print(f\"Adding {silence_duration}s of silence\")\n        subprocess.run([\n            'ffmpeg', '-i', '/tmp/tts_raw.wav',\n            '-f', 'lavfi', '-i', f'anullsrc=r=22050:cl=mono:d={silence_duration}',\n            '-filter_complex', '[0:a][1:a]concat=n=2:v=0:a=1',\n            '-y', '/tmp/tts_adjusted.wav'\n        ], check=True, capture_output=True)\n        duration_control = \"pad_silence\"\n    else:\n        print(f\"Adjusting speed by factor: {speed_factor}\")\n        subprocess.run([\n            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\n            '-filter:a', f'atempo={speed_factor}',\n            '/tmp/tts_adjusted.wav'\n        ], check=True, capture_output=True)\n        duration_control = \"rate_adjust\"\nelif tts_duration_sec > window_duration_sec:\n    # Need to speed up\n    speed_factor = tts_duration_sec / window_duration_sec\n    if speed_factor > 2.0:\n        # Too fast for single atempo, chain them\n        print(f\"Adjusting speed by factor: {speed_factor} (chained)\")\n        factor1 = 2.0\n        factor2 = speed_factor / 2.0\n        subprocess.run([\n            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\n            '-filter:a', f'atempo={factor1},atempo={factor2}',\n            '/tmp/tts_adjusted.wav'\n        ], check=True, capture_output=True)\n        duration_control = \"rate_adjust\"\n    else:\n        print(f\"Adjusting speed by factor: {speed_factor}\")\n        subprocess.run([\n            'ffmpeg', '-i', '/tmp/tts_raw.wav', '-y',\n            '-filter:a', f'atempo={speed_factor}',\n            '/tmp/tts_adjusted.wav'\n        ], check=True, capture_output=True)\n        duration_control = \"rate_adjust\"\nelse:\n    subprocess.run(['cp', '/tmp/tts_raw.wav', '/tmp/tts_adjusted.wav'], check=True)\n    duration_control = \"rate_adjust\"\n\n# First pass: measure loudness\nprint(\"Measuring loudness...\")\nresult = subprocess.run([\n    'ffmpeg', '-i', '/tmp/tts_adjusted.wav',\n    '-af', 'loudnorm=I=-23:TP=-1.5:LRA=11:print_format=json',\n    '-f', 'null', '-'\n], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n\n# Extract loudness measurements\njson_start = result.stdout.rfind('{')\nif json_start != -1:\n    json_str = result.stdout[json_start:].strip()\n    # Find the end of JSON\n    brace_count = 0\n    json_end = 0\n    for i, char in enumerate(json_str):\n        if char == '{':\n            brace_count += 1\n        elif char == '}':\n            brace_count -= 1\n            if "]
[197.58152, "i", "brace_count == 0:\n                json_end = i + 1\n                break\n    json_str = json_str[:json_end]\n    loudnorm_data = json.loads(json_str)\n    measured_i = loudnorm_data.get('input_i', '-23.0')\n    measured_tp = loudnorm_data.get('input_tp', '-1.5')\n    measured_lra = loudnorm_data.get('input_lra', '11.0')\n    measured_thresh = loudnorm_data.get('input_thresh', '-33.0')\n    target_offset = loudnorm_data.get('target_offset', '0.0')\nelse:\n    measured_i = '-23.0'\n    measured_tp = '-1.5'\n    measured_lra = '11.0'\n    measured_thresh = '-33.0'\n    target_offset = '0.0'\n\nprint(f\"Measured I: {measured_i} LUFS\")\n\n# Second pass: apply normalization and convert to 48kHz mono\nprint(\"Normalizing audio to -23 LUFS and converting to 48kHz mono...\")\nsubprocess.run([\n    'ffmpeg', '-i', '/tmp/tts_adjusted.wav', '-y',\n    '-ar', '48000',\n    '-ac', '1',\n    '-af', f'loudnorm=I=-23:TP=-1.5:LRA=11:measured_I={measured_i}:measured_LRA={measured_lra}:measured_TP={measured_tp}:measured_thresh={measured_thresh}:offset={target_offset}:linear=true',\n    '/outputs/tts_segments/seg_0.wav'\n], check=True, capture_output=True)\n\nprint(\"Verifying final audio...\")\n# Get final audio properties\nresult = subprocess.run([\n    'ffprobe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '-show_streams', '/outputs/tts_segments/seg_0.wav'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\nfinal_tts_duration = float(probe_data['format']['duration'])\nfinal_sample_rate = int(probe_data['streams'][0]['sample_rate'])\nfinal_channels = int(probe_data['streams'][0]['channels'])\n\nprint(f\"Final audio: {final_sample_rate}Hz, {final_channels} channel(s), {final_tts_duration}s\")\n\n# Measure final LUFS\nresult = subprocess.run([\n    'ffmpeg', '-i', '/outputs/tts_segments/seg_0.wav',\n    '-af', 'loudnorm=I=-23:TP=-1.5:LRA=11:print_format=json',\n    '-f', 'null', '-'\n], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n\njson_start = result.stdout.rfind('{')\nif json_start != -1:\n    json_str = result.stdout[json_start:].strip()\n    brace_count = 0\n    json_end = 0\n    for i, char in enumerate(json_str):\n        if char == '{':\n            brace_count += 1\n        elif char == '}':\n            brace_count -= 1\n            if brace_count == 0:\n                json_end = i + 1\n                break\n    json_str = json_str[:json_end]\n    loudnorm_data = json.loads(json_str)\n    measured_lufs = float(loudnorm_data.get('input_i', -23.0))\nelse:\n    measured_lufs = -23.0\n\nprint(f\"Final measured LUFS: {measured_lufs}\")\n\n# Create dubbed video\nprint(\"Creating dubbed video...\")\nsubprocess.run([\n    'ffmpeg', '-i', '/root/input.mp4', '-i', '/outputs/tts_segments/seg_0.wav', '-y',\n    '-map', '0:v', '-map', '1:a',\n    '-c:v', 'copy',\n    '-c:a', 'aac',\n    '-b:a', '128k',\n    '-ar', '48000',\n    '-ac', '1',\n    '-shortest',\n    '/outputs/dubbed.mp4'\n], check=True, capture_output=True)\n\n# Get final video duration\nresult = subprocess.run([\n    'ffprobe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '/outputs/dubbed.mp4'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\nnew_duration_sec = float(probe_data['format']['duration'])\n\nplaced_start_sec = window_start_sec\nplaced_end_sec = placed_start_sec + final_tts_duration\ndrift_sec = placed_end_sec - window_end_sec\n\nprint(f\"\\nTiming verification:\")\nprint(f\"  Window: {window_start_sec}s - {window_end_sec}s ({window_duration_sec}s)\")\nprint(f\"  Placed: {placed_start_sec}s - {placed_end_sec:.3f}s ({final_tts_duration:.3f}s)\")\nprint(f\"  Drift: {drift_sec:.3f}s\")\nprint(f\"  Start offset: {abs(placed_start_sec - window_start_sec)*1000:.1f}ms\")\n\n# Generate report\nreport = {\n    \"source_language\": \"en\",\n    \"target_language\": target_lang,\n    \"audio_sample_rate_hz\": 48000,\n    \"audio_channels\": 1,\n    \"original_duration_sec\": 12.052,\n    \"new_duration_sec\": round(new_duration_sec, 2),\n    \"measured_lufs\": round(measured_lufs, 1),\n    \"speech_segments\": [\n        {\n            \"window_start_sec\": window_start_sec,\n            \"window_end_sec\""]
[197.581717, "i", ": window_end_sec,\n            \"placed_start_sec\": placed_start_sec,\n            \"placed_end_sec\": round(placed_end_sec, 2),\n            \"source_text\": source_text,\n            \"target_text\": target_text,\n            \"window_duration_sec\": round(window_duration_sec, 2),\n            \"tts_duration_sec\": round(final_tts_duration, 2),\n            \"drift_sec\": round(drift_sec, 2),\n            \"duration_control\": duration_control\n        }\n    ]\n}\n\nwith open('/outputs/report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, indent=2, ensure_ascii=False)\n\nprint(f\"\\n✓ Dubbing complete!\")\nprint(f\"✓ Audio: /outputs/tts_segments/seg_0.wav\")\nprint(f\"✓ Video: /outputs/dubbed.mp4\")\nprint(f\"✓ Report: /outputs/report.json\")\nSCRIPT_EOF\n"]
