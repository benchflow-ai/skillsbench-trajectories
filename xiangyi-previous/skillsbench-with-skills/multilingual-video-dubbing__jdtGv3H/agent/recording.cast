[70.39234, "o", "placed_end_sec = placed_start_sec + final_tts_duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392432, "o", "drift_sec = placed_end_sec - window_end_sec\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392522, "o", "# Generate report\r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
