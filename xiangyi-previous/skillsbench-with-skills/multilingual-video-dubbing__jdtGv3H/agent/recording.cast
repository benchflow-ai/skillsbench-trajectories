[70.37288, "o", "> # Generate TTS audio\r\n\u001b[?2004l\r\u001b[?2004h> async def generate_tts():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.373265, "o", "    voice = \"ja-JP-NanamiNeural\"  # High quality Japanese voice\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.37343, "o", "    communicate = edge_tts.Communicate(target_text, voice)\r\n\u001b[?2004l\r"]
[70.373476, "o", "\u001b[?2004h> "]
[70.373621, "o", "    await communicate.save(\"/tmp/tts_raw.mp3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.373646, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
