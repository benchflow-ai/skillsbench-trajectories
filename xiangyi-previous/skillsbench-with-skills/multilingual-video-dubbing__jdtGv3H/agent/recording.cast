[70.391428, "o", "> "]
[70.391482, "o", "# Get final video duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.391567, "o", "result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.391667, "o", "    'ffprobe', '-v', 'quiet', '-print_format', 'json',\r\n\u001b[?2004l\r"]
