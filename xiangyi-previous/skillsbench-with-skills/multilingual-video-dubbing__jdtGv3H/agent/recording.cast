[70.392697, "o", "    \"target_language\": target_lang,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392777, "o", "    \"audio_sample_rate_hz\": 48000,\r\n\u001b[?2004l\r\u001b[?2004h>     \"audio_channels\": 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392858, "o", "    \"original_duration_sec\": 12.052,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392932, "o", "    \"new_duration_sec\": round(new_duration_sec, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.392979, "o", "    \"measured_lufs\": round(measured_lufs, 1),\r\n\u001b[?2004l\r"]
[70.393048, "o", "\u001b[?2004h> "]
[70.393238, "o", "    \"speech_segments\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.393268, "o", "            \"window_start_sec\": window_start_sec,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.39337, "o", "            \"window_end_sec\": window_end_sec,\r\n\u001b[?2004l\r"]
