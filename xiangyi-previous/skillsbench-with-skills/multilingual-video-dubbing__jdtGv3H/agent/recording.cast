[70.373827, "o", "> "]
[70.373922, "o", "asyncio.run(generate_tts())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[70.373994, "o", "> "]
[70.374058, "o", "# Convert to WAV and get duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.374079, "o", "> "]
