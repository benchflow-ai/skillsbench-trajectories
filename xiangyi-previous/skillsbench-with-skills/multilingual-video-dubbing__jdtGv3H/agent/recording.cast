[70.367039, "i", "cat > /root/dubbing.py << 'SCRIPT_EOF'\nimport asyncio\nimport edge_tts\nimport json\nimport subprocess\nimport os\nfrom pathlib import Path\n\n# Read input files\nwith open('/root/target_language.txt', 'r') as f:\n    target_lang = f.read().strip()\n\nwith open('/root/reference_target_text.srt', 'r') as f:\n    srt_content = f.read()\n    # Extract text from SRT (skip index and timecode lines)\n    lines = srt_content.strip().split('\\n')\n    target_text = lines[2] if len(lines) > 2 else ''\n\nwith open('/root/source_text.srt', 'r') as f:\n    srt_content = f.read()\n    lines = srt_content.strip().split('\\n')\n    source_text = lines[2] if len(lines) > 2 else ''\n\nprint(f\"Target language: {target_lang}\")\nprint(f\"Target text: {target_text}\")\nprint(f\"Source text: {source_text}\")\n\n# Segment timing\nwindow_start_sec = 0.0\nwindow_end_sec = 12.116\nwindow_duration_sec = window_end_sec - window_start_sec\n\n# Generate TTS audio\nasync def generate_tts():\n    voice = \"ja-JP-NanamiNeural\"  # High quality Japanese voice\n    communicate = edge_tts.Communicate(target_text, voice)\n    await communicate.save(\"/tmp/tts_raw.mp3\")\n\nprint(\"Generating TTS audio...\")\nasyncio.run(generate_tts())\n\n# Convert to WAV and get duration\nsubprocess.run([\n    'ffmpeg', '-i', '/tmp/tts_raw.mp3', '-y',\n    '/tmp/tts_initial.wav'\n], check=True, capture_output=True)\n\n# Get TTS duration\nresult = subprocess.run([\n    'ffprobe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '/tmp/tts_initial.wav'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\ntts_duration_sec = float(probe_data['format']['duration'])\n\nprint(f\"TTS duration: {tts_duration_sec}s, Target: {window_duration_sec}s\")\n\n# Adjust speed to fit window if needed\nif abs(tts_duration_sec - window_duration_sec) > 0.01:\n    speed_factor = tts_duration_sec / window_duration_sec\n    print(f\"Adjusting speed by factor: {speed_factor}\")\n    subprocess.run([\n        'ffmpeg', '-i', '/tmp/tts_initial.wav', '-y',\n        '-filter:a', f'atempo={speed_factor}',\n        '/tmp/tts_adjusted.wav'\n    ], check=True, capture_output=True)\n    duration_control = \"rate_adjust\"\nelse:\n    subprocess.run(['cp', '/tmp/tts_initial.wav', '/tmp/tts_adjusted.wav'], check=True)\n    duration_control = \"rate_adjust\"\n\n# Convert to 48kHz mono and normalize to -23 LUFS\nprint(\"Normalizing audio to -23 LUFS and converting to 48kHz mono...\")\nsubprocess.run([\n    'ffmpeg', '-i', '/tmp/tts_adjusted.wav', '-y',\n    '-ar', '48000',\n    '-ac', '1',\n    '-filter:a', 'loudnorm=I=-23:TP=-1.5:LRA=11:measured_I=-23:measured_LRA=11:measured_TP=-1.5:measured_thresh=-33:offset=0:linear=true:print_format=json',\n    '/outputs/tts_segments/seg_0.wav'\n], check=True, capture_output=True)\n\nprint(\"Measuring final LUFS...\")\nresult = subprocess.run([\n    'ffmpeg', '-i', '/outputs/tts_segments/seg_0.wav',\n    '-filter:a', 'loudnorm=I=-23:TP=-1.5:LRA=11:print_format=json',\n    '-f', 'null', '-'\n], capture_output=True, text=True, check=True, stderr=subprocess.STDOUT)\n\n# Extract LUFS measurement from output\nimport re\njson_match = re.search(r'\\{[^}]*\"input_i\"[^}]*\\}', result.stdout)\nif json_match:\n    loudnorm_data = json.loads(json_match.group())\n    measured_lufs = float(loudnorm_data.get('input_i', -23.0))\nelse:\n    measured_lufs = -23.0\n\nprint(f\"Measured LUFS: {measured_lufs}\")\n\n# Get final audio duration\nresult = subprocess.run([\n    'ffprobe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '/outputs/tts_segments/seg_0.wav'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\nfinal_tts_duration = float(probe_data['format']['duration'])\n\nprint(f\"Final TTS duration: {final_tts_duration}s\")\n\n# Create dubbed video\nprint(\"Creating dubbed video...\")\nsubprocess.run([\n    'ffmpeg', '-i', '/root/input.mp4', '-i', '/outputs/tts_segments/seg_0.wav', '-y',\n    '-map', '0:v', '-map', '1:a',\n    '-c:v', 'copy',\n    '-c:a', 'aac',\n    '-ar', '48000',\n    '-ac', '1',\n    '-shortest',\n    '/outputs/dubbed.mp4'\n], check=True, capture_output=True)\n\n# Get final video duration\nresult = subprocess.run([\n    'ffpr"]
[70.367103, "i", "obe', '-v', 'quiet', '-print_format', 'json',\n    '-show_format', '/outputs/dubbed.mp4'\n], capture_output=True, text=True, check=True)\nprobe_data = json.loads(result.stdout)\nnew_duration_sec = float(probe_data['format']['duration'])\n\nplaced_start_sec = window_start_sec\nplaced_end_sec = placed_start_sec + final_tts_duration\ndrift_sec = placed_end_sec - window_end_sec\n\n# Generate report\nreport = {\n    \"source_language\": \"en\",\n    \"target_language\": target_lang,\n    \"audio_sample_rate_hz\": 48000,\n    \"audio_channels\": 1,\n    \"original_duration_sec\": 12.052,\n    \"new_duration_sec\": round(new_duration_sec, 2),\n    \"measured_lufs\": round(measured_lufs, 1),\n    \"speech_segments\": [\n        {\n            \"window_start_sec\": window_start_sec,\n            \"window_end_sec\": window_end_sec,\n            \"placed_start_sec\": placed_start_sec,\n            \"placed_end_sec\": round(placed_end_sec, 2),\n            \"source_text\": source_text,\n            \"target_text\": target_text,\n            \"window_duration_sec\": round(window_duration_sec, 2),\n            \"tts_duration_sec\": round(final_tts_duration, 2),\n            \"drift_sec\": round(drift_sec, 2),\n            \"duration_control\": duration_control\n        }\n    ]\n}\n\nwith open('/outputs/report.json', 'w') as f:\n    json.dump(report, f, indent=2, ensure_ascii=False)\n\nprint(\"\\nDubbing complete!\")\nprint(f\"Drift: {drift_sec:.3f}s\")\nprint(f\"Report saved to /outputs/report.json\")\nSCRIPT_EOF\n"]
