[70.390671, "o", "\u001b[?2004h> "]
[70.390835, "o", "    'ffmpeg', '-i', '/root/input.mp4', '-i', '/outputs/tts_segments/seg_0.wav', '-y',\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.39086, "o", "> "]
[70.390957, "o", "    '-map', '0:v', '-map', '1:a',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.391005, "o", "    '-c:v', 'copy',\r\n\u001b[?2004l\r"]
