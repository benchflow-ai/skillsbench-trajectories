[70.375924, "o", "> "]
[70.37598, "o", "probe_data = json.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> tts_duration_sec = float(probe_data['format']['duration'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"TTS duration: {tts_duration_sec}s, Target: {window_duration_sec}s\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Adjust speed to fit window if needed\r\n\u001b[?2004l\r\u001b[?2004h> if abs(tts_duration_sec - window_duration_sec) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h>     speed_factor = tts_duration_sec / window_duration_sec\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Adjusting speed by factor: {speed_factor}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.376004, "o", "    subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.376093, "o", "        'ffmpeg', '-i', '/tmp/tts_initial.wav', '-y',\r\n\u001b[?2004l\r"]
[70.376116, "o", "\u001b[?2004h> "]
[70.376193, "o", "        '-filter:a', f'atempo={speed_factor}',\r\n\u001b[?2004l\r"]
[70.376215, "o", "\u001b[?2004h> "]
