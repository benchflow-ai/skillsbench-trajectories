[26.840638, "o", "\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K(:action \u001b[01;31m\u001b[Kpark\u001b[m\u001b[K_seg_pp_0_60_north\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K :effect (and (is-\u001b[01;31m\u001b[Kpark\u001b[m\u001b[Ked ?a seg_pp_0_60)\r\n\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K(:action \u001b[01;31m\u001b[Kpark\u001b[m\u001b[K_seg_pp_0_60_south\r\n\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K :effect (and (is-\u001b[01;31m\u001b[Kpark\u001b[m\u001b[Ked ?a seg_pp_0_60)\r\n"]
