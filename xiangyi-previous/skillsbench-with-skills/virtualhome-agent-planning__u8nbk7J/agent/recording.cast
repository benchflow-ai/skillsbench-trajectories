[27.489693, "o", "\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K\r\n\u001b[32m\u001b[K302\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K(:action move_seg_rwe_0_50_\u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K_south_south_medium\r\n\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not_occupied \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not_blocked \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K airplane_CFBEG)\r\n\u001b[32m\u001b[K321\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (occupied \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K322\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not (not_occupied \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K323\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (blocked \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K ?a)\r\n\u001b[32m\u001b[K324\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not (not_blocked \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K ?a))\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (at-segment ?a \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K)"]
[27.490223, "o", "\r\n\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K(:action move_\u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K_seg_rww_0_50_south_south_medium\r\n\u001b[32m\u001b[K341\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (at-segment ?a \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K349\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not (occupied \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not_occupied \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not (at-segment ?a \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K))\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not (blocked \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K ?a))\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                 (not_blocked \u001b[01;31m\u001b[Kseg_rw_0_400\u001b[m\u001b[K ?a)\r\n\u001b[?2004hroot@93e6e705df00:/app# "]
