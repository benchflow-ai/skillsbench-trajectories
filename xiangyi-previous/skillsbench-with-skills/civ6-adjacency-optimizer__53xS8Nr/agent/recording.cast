[778.518127, "i", "python3 - <<'PY'\nimport sqlite3, sys, itertools\nfrom collections import defaultdict\nsys.path.append('skills')\nfrom civ6lib.scripts import placement_rules as pr\nfrom civ6lib.scripts import hex_utils\n# Patch modules for adjacency_rules import\nsys.modules['hex_utils'] = hex_utils\nsys.modules['placement_rules'] = pr\nfrom civ6lib.scripts import adjacency_rules as ar\n\npath='/data/maps/e2e_test_case_0.Civ6Map'\nconn=sqlite3.connect(path)\ncur=conn.cursor()\nwidth, height = cur.execute('SELECT Width, Height FROM Map').fetchone()\n\n# Load base plot data\nplots = {row[0]: row for row in cur.execute('SELECT ID, TerrainType, IsImpassable FROM Plots').fetchall()}\nfeatures = {row[0]: row[1] for row in cur.execute('SELECT ID, FeatureType FROM PlotFeatures').fetchall() if row[1] is not None}\nresources = {row[0]: row[1] for row in cur.execute('SELECT ID, ResourceType FROM PlotResources').fetchall() if row[1] is not None}\n\n# River edges accumulation\nriver_edges = defaultdict(set)\nfor pid, ne, w, nw in cur.execute('SELECT ID, IsNEOfRiver, IsWOfRiver, IsNWOfRiver FROM PlotRivers').fetchall():\n    x, y = pid % width, pid // width\n    if ne:\n        river_edges[pid].add(1)\n        nx, ny = hex_utils.get_neighbor_at_direction(x, y, 1)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(hex_utils.get_opposite_direction(1))\n    if w:\n        river_edges[pid].add(3)\n        nx, ny = hex_utils.get_neighbor_at_direction(x, y, 3)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(hex_utils.get_opposite_direction(3))\n    if nw:\n        river_edges[pid].add(2)\n        nx, ny = hex_utils.get_neighbor_at_direction(x, y, 2)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(hex_utils.get_opposite_direction(2))\n\n# Build tiles dict\ntiles = {}\nfor pid, (_, terrain_type, impassable) in plots.items():\n    x, y = pid % width, pid // width\n    feature = features.get(pid)\n    resource = resources.get(pid)\n    # map terrain\n    if 'MOUNTAIN' in terrain_type:\n        terrain='MOUNTAIN'\n    elif terrain_type == 'TERRAIN_COAST':\n        terrain='COAST'\n    elif terrain_type == 'TERRAIN_OCEAN':\n        terrain='OCEAN'\n    elif terrain_type == 'TERRAIN_PLAINS':\n        terrain='PLAINS'\n    elif terrain_type == 'TERRAIN_GRASS':\n        terrain='GRASS'\n    else:\n        terrain=terrain_type\n    is_floodplains = (feature is not None and 'FLOODPLAINS' in feature)\n    tile = pr.Tile(x=x, y=y, terrain=terrain, feature=feature, is_hills=False,\n                   is_floodplains=is_floodplains,\n                   river_edges=list(river_edges.get(pid, [])), river_names=[],\n                   resource=resource, resource_type=None, improvement=None)\n    tiles[(x,y)] = tile\n\n# Candidate city centers: land tiles (not water, not mountain)\ncity_candidates = [(x,y) for (x,y),t in tiles.items() if not t.is_water and not t.is_mountain]\n\nspecialty_types = [pr.DistrictType.CAMPUS, pr.DistrictType.HOLY_SITE, pr.DistrictType.THEATER_SQUARE,\n                   pr.DistrictType.COMMERCIAL_HUB, pr.DistrictType.HARBOR, pr.DistrictType.INDUSTRIAL_ZONE]\n\nbest = None\nbest_total = -1\n\nfor cc in city_candidates:\n    rules = pr.PlacementRules(tiles, cc, population=9)\n    # precompute valid tiles for each district type within range 3\n    valid_tiles = {}\n    for d in specialty_types:\n        vals = []\n        for (x,y), t in tiles.items():\n            if hex_utils.hex_distance(cc[0], cc[1], x, y) > 3:\n                continue\n            if (x,y)==cc:\n                continue\n            res = rules.validate_district_placement(d, x, y, {})\n            if res.valid:\n                vals.append((x,y))\n        valid_tiles[d] = vals\n    # skip if insufficient\n    # iterate over combos of 3 district types\n    for types in itertools.combinations(specialty_types, 3):\n        # skip combos with empty valid lists\n        if any(len(valid_tiles[t])==0 for t in types):\n            continue\n        # iterate over placements\n        f"]
[778.518185, "i", "or coords in itertools.product(*(valid_tiles[t] for t in types)):\n            if len(set(coords)) < 3:\n                continue\n            placements = {cc: pr.DistrictType.CITY_CENTER}\n            for t,c in zip(types, coords):\n                placements[c]=t\n            adj_calc = ar.get_adjacency_calculator(tiles)\n            total, per = adj_calc.calculate_total_adjacency(placements)\n            # exclude city center adjacency entry\n            if total > best_total:\n                best_total = total\n                best = (cc, types, coords, total, per)\n\nprint('best_total', best_total)\nprint('best', best)\nconn.close()\nPY\n"]
