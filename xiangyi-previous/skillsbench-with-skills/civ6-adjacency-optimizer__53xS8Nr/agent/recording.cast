[778.526809, "o", "# Candidate city centers: land tiles (not water, not mountain)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.526991, "o", "city_candidates = [(x,y) for (x,y),t in tiles.items() if not t.is_water and not t.is_mountain]\r\n\u001b[?2004l\r"]
[778.527043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.52723, "o", "specialty_types = [pr.DistrictType.CAMPUS, pr.DistrictType.HOLY_SITE, pr.DistrictType.THEATER_SQUARE,\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.527282, "o", "> "]
[778.527456, "o", "                   pr.DistrictType.COMMERCIAL_HUB, pr.DistrictType.HARBOR, pr.DistrictType.INDUSTRIAL_ZONE]\r\n\u001b[?2004l\r"]
[778.52751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.527558, "o", "best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.527588, "o", "best_total = -1\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.527649, "o", "> \r\n\u001b[?2004l\r"]
[778.5277, "o", "\u001b[?2004h> "]
[778.527748, "o", "for cc in city_candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.527853, "o", "    rules = pr.PlacementRules(tiles, cc, population=9)\r\n\u001b[?2004l\r"]
[778.527904, "o", "\u001b[?2004h> "]
[778.528038, "o", "    # precompute valid tiles for each district type within range 3\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.528081, "o", ">     valid_tiles = {}\r\n\u001b[?2004l\r"]
[778.52813, "o", "\u001b[?2004h> "]
[778.528184, "o", "    for d in specialty_types:\r\n\u001b[?2004l\r"]
[778.528231, "o", "\u001b[?2004h> "]
[778.528257, "o", "        vals = []\r\n\u001b[?2004l\r"]
[778.528304, "o", "\u001b[?2004h> "]
[778.528383, "o", "        for (x,y), t in tiles.items():\r\n\u001b[?2004l\r"]
[778.52843, "o", "\u001b[?2004h> "]
[778.528554, "o", "            if hex_utils.hex_distance(cc[0], cc[1], x, y) > 3:\r\n\u001b[?2004l\r"]
[778.528596, "o", "\u001b[?2004h> "]
[778.528621, "o", "                continue\r\n\u001b[?2004l\r"]
[778.528689, "o", "\u001b[?2004h> "]
[778.528743, "o", "            if (x,y)==cc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.528791, "o", "> "]
[778.528842, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.52898, "o", "            res = rules.validate_district_placement(d, x, y, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.529034, "o", ">             if res.valid:\r\n\u001b[?2004l\r"]
[778.529087, "o", "\u001b[?2004h> "]
[778.529145, "o", "                vals.append((x,y))\r\n\u001b[?2004l\r"]
[778.529196, "o", "\u001b[?2004h> "]
[778.529242, "o", "        valid_tiles[d] = vals\r\n\u001b[?2004l\r"]
[778.529293, "o", "\u001b[?2004h> "]
[778.529337, "o", "    # skip if insufficient\r\n\u001b[?2004l\r"]
[778.529384, "o", "\u001b[?2004h> "]
[778.529473, "o", "    # iterate over combos of 3 district types\r\n\u001b[?2004l\r"]
[778.529526, "o", "\u001b[?2004h> "]
[778.529642, "o", "    for types in itertools.combinations(specialty_types, 3):\r\n\u001b[?2004l\r"]
[778.529688, "o", "\u001b[?2004h> "]
[778.529737, "o", "        # skip combos with empty valid lists\r\n\u001b[?2004l\r"]
[778.529788, "o", "\u001b[?2004h> "]
[778.529892, "o", "        if any(len(valid_tiles[t])==0 for t in types):\r\n\u001b[?2004l\r"]
[778.529935, "o", "\u001b[?2004h> "]
[778.52996, "o", "            continue\r\n\u001b[?2004l\r"]
[778.530005, "o", "\u001b[?2004h> "]
[778.530072, "o", "        # iterate over placements\r\n\u001b[?2004l\r"]
[778.530121, "o", "\u001b[?2004h> "]
[778.530266, "o", "        for coords in itertools.product(*(valid_tiles[t] for t in types)):\r\n\u001b[?2004l\r"]
[778.530314, "o", "\u001b[?2004h> "]
[778.530366, "o", "            if len(set(coords)) < 3:\r\n\u001b[?2004l\r"]
[778.530415, "o", "\u001b[?2004h> "]
[778.530464, "o", "                continue\r\n\u001b[?2004l\r"]
[778.530514, "o", "\u001b[?2004h> "]
[778.530625, "o", "            placements = {cc: pr.DistrictType.CITY_CENTER}\r\n\u001b[?2004l\r"]
[778.53069, "o", "\u001b[?2004h> "]
[778.530739, "o", "            for t,c in zip(types, coords):\r\n\u001b[?2004l\r"]
[778.530786, "o", "\u001b[?2004h> "]
[778.530846, "o", "                placements[c]=t\r\n\u001b[?2004l\r"]
[778.530895, "o", "\u001b[?2004h> "]
[778.531006, "o", "            adj_calc = ar.get_adjacency_calculator(tiles)\r\n\u001b[?2004l\r"]
[778.531057, "o", "\u001b[?2004h> "]
[778.531191, "o", "            total, per = adj_calc.calculate_total_adjacency(placements)\r\n\u001b[?2004l\r"]
[778.531242, "o", "\u001b[?2004h> "]
[778.531301, "o", "            # exclude city center adjacency entry\r\n\u001b[?2004l\r"]
[778.531347, "o", "\u001b[?2004h> "]
[778.531423, "o", "            if total > best_total:\r\n\u001b[?2004l\r"]
[778.531468, "o", "\u001b[?2004h> "]
[778.531532, "o", "                best_total = total\r\n\u001b[?2004l\r"]
[778.531581, "o", "\u001b[?2004h> "]
[778.531694, "o", "                best = (cc, types, coords, total, per)\r\n\u001b[?2004l\r"]
[778.531751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[778.531807, "o", "print('best_total', best_total)\r\n\u001b[?2004l\r"]
[778.531854, "o", "\u001b[?2004h> "]
[778.531896, "o", "print('best', best)\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.531939, "o", "> conn.close()\r\n\u001b[?2004l\r"]
[778.531984, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[778.593521, "o", "Traceback (most recent call last):\r\n  File \"<stdin>\", line 90, in <module>\r\nAttributeError: 'PlacementRules' object has no attribute 'validate_district_placement'\r\n"]
[778.600113, "o", "\u001b[?2004hroot@66ad69d03854:~# "]
[784.762059, "i", "grep -n \"def validate\" -n skills/civ6lib/scripts/placement_rules.py\n"]
[784.76241, "o", "grep -n \"def validate\" -n skills/civ6lib/scripts/placement_rules.py\r\n\u001b[?2004l\r"]
[784.764227, "o", "126:def validate_city_distances(\r\n241:def validate_district_count(\r\n278:def validate_district_uniqueness(\r\n445:    def validate_placement(\r\n"]
[784.764417, "o", "\u001b[?2004hroot@66ad69d03854:~# "]
[788.692441, "i", "sed -n '420,520p' skills/civ6lib/scripts/placement_rules.py\n"]
[788.692803, "o", "sed -n '420,520p' skills/civ6lib/scripts/placement_rules.py\r\n\u001b[?2004l\r"]
[788.694508, "o", "        self,\r\n        tiles: Dict[Tuple[int, int], Tile],\r\n        city_center: Tuple[int, int],\r\n        population: int,\r\n    ):\r\n        self.tiles = tiles\r\n        self.city_center = city_center\r\n        self.population = population\r\n\r\n    def get_tile(self, x: int, y: int) -> Optional[Tile]:\r\n        return self.tiles.get((x, y))\r\n\r\n    def max_specialty_districts(self) -> int:\r\n        \"\"\"Calculate max specialty districts based on population.\r\n\r\n        Formula: 1 + floor((population - 1) / 3)\r\n\r\n            Pop 1: 1 district\r\n            Pop 4: 2 districts\r\n            Pop 7: 3 districts\r\n            Pop 10: 4 districts\r\n            etc.\r\n        \"\"\"\r\n        return 1 + (self.population - 1) // 3\r\n\r\n    def validate_placement(\r\n        self,\r\n        district_type: DistrictType,\r\n        x: int,\r\n        y: int,\r\n        existing_placements: Dict[Tuple[int, int], DistrictType],\r\n    ) -> PlacementResult:\r\n        \"\"\"\r\n        Validate if a district can be placed at (x, y).\r\n\r\n        Args:\r\n            district_type: Type of district to place\r\n            x, y: Target coordinates\r\n            existing_placements: Already placed districts {(x,y): type}\r\n\r\n        Returns:\r\n            PlacementResult with valid=True/False and error messages\r\n        \"\"\"\r\n        errors: List[str] = []\r\n        warnings: List[str] = []\r\n\r\n        tile = self.get_tile(x, y)\r\n\r\n        # Basic checks\r\n"]
[788.694594, "o", "        if tile is None:\r\n            errors.append(f\"No tile data at ({x}, {y})\")\r\n            return PlacementResult(valid=False, errors=errors)\r\n\r\n        # Distance from City Center (must be within 3 tiles)\r\n        distance = hex_distance(x, y, self.city_center[0], self.city_center[1])\r\n        if distance > 3:\r\n            errors.append(f\"Too far from City Center (distance {distance} > 3)\")\r\n\r\n        # Cannot place on mountains\r\n        if tile.is_mountain:\r\n            errors.append(\"Cannot place district on Mountain\")\r\n\r\n        # Cannot place on natural wonders\r\n        if tile.is_natural_wonder:\r\n            errors.append(\"Cannot place district on Natural Wonder\")\r\n\r\n        # Cannot place on geothermal fissures (except City Center which is pre-placed)\r\n        # Note: City Center CAN be settled on geothermal, and it's NOT destroyed\r\n        if tile.feature == \"FEATURE_GEOTHERMAL_FISSURE\":\r\n            errors.append(\"Cannot place district on Geothermal Fissure\")\r\n\r\n        # Cannot place on existing district\r\n        if (x, y) in existing_placements:\r\n            existing = existing_placements[(x, y)]\r\n            errors.append(f\"Tile already has district: {existing.name}\")\r\n\r\n        # Cannot place on strategic/luxury resources\r\n        if tile.resource_type in (\"STRATEGIC\", \"LUXURY\"):\r\n            errors.append(f\"Cannot place on {tile.resource_type.lower()} resource: {tile.resource}\")\r\n\r\n        # Water district rules\r\n        if district_type in self.WATER_DISTRICTS:\r\n            if not (tile.is_coast or tile.is_lake):\r\n                errors.append(f\"{district_type.name} must be on Coast or Lake\")\r\n            # Check adjacent to land\r\n            has_land_neighbor = False\r\n            for nx, ny in get_neighbors(x, y):\r\n                ntile = self.get_tile(nx, ny)\r\n                if ntile and not ntile.is_water:\r\n                    has_land_neighbor = True\r\n                    break\r\n            if not has_land_neighbor:\r\n                errors.append(f\"{district_type.name} must be adjacent to land\")\r\n        else:\r\n            # Land districts cannot be on water\r\n            if tile.is_water:\r\n                errors.append(f\"{district_type.name} cannot be placed on water\")\r\n\r\n        # Flat land requirement\r\n        if district_type in self.FLAT_LAND_DISTRICTS:\r\n            if not tile.is_flat_land:\r\n"]
[788.694817, "o", "\u001b[?2004hroot@66ad69d03854:~# "]
[812.08184, "i", "sed -n '460,520p' skills/civ6lib/scripts/adjacency_rules.py\n"]
[812.082134, "o", "sed -n '460,520p' skills/civ6lib/scripts/adjacency_rules.py\r\n\u001b[?2004l\r"]
[812.083999, "o", "        self,\r\n        placements: Dict[Tuple[int, int], DistrictType],\r\n    ) -> Tuple[int, Dict[str, AdjacencyResult]]:\r\n        \"\"\"\r\n        Calculate total adjacency for all placed districts.\r\n\r\n        Applies destruction first, then calculates adjacency.\r\n\r\n        Returns:\r\n            (total_adjacency, per_district_results)\r\n        \"\"\"\r\n"]
[812.084343, "o", "        # Apply destruction from placements\r\n        modified_tiles = self.apply_destruction(placements)\r\n\r\n        total = 0\r\n        per_district: Dict[str, AdjacencyResult] = {}\r\n\r\n        for (x, y), district_type in placements.items():\r\n            if district_type == DistrictType.CITY_CENTER:\r\n                continue\r\n\r\n            result = self.calculate_district_adjacency(\r\n                district_type, x, y, modified_tiles, placements\r\n            )\r\n            total += result.total_bonus\r\n            per_district[f\"{district_type.name}@({x},{y})\"] = result\r\n\r\n        return total, per_district\r\n\r\n\r\ndef get_adjacency_calculator(\r\n    tiles: Dict[Tuple[int, int], Tile],\r\n) -> AdjacencyCalculator:\r\n    \"\"\"Factory function to get adjacency calculator.\"\"\"\r\n    return AdjacencyCalculator(tiles)\r\n\u001b[?2004hroot@66ad69d03854:~# "]
