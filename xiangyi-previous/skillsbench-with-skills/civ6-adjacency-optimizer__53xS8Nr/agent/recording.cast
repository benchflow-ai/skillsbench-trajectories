[64.954852, "i", "python3 - <<'PY'\nimport sqlite3, json\npath='/data/maps/e2e_test_case_0.Civ6Map'\nconn=sqlite3.connect(path)\ncur=conn.cursor()\nfor table in ['Map','MapAttributes','Plots','PlotAttributes','PlotFeatures','PlotResources','PlotRivers','PlotImprovements']:\n    cur.execute(f\"PRAGMA table_info({table})\")\n    print(table, cur.fetchall())\nprint('Map row', cur.execute('SELECT * FROM Map').fetchone())\nprint('MapAttributes sample', cur.execute('SELECT * FROM MapAttributes LIMIT 5').fetchall())\nprint('Plots sample', cur.execute('SELECT * FROM Plots LIMIT 5').fetchall())\nconn.close()\nPY\n"]
