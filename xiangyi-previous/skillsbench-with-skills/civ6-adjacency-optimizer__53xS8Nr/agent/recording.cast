[575.670744, "i", "python3 - <<'PY'\nimport sqlite3, sys\nfrom collections import Counter, defaultdict\nsys.path.append('skills/civ6lib/scripts')\nfrom placement_rules import Tile\nfrom hex_utils import get_neighbor_at_direction, get_opposite_direction\n\npath='/data/maps/e2e_test_case_0.Civ6Map'\nconn=sqlite3.connect(path)\ncur=conn.cursor()\nwidth, height = cur.execute('SELECT Width, Height FROM Map').fetchone()\n\n# Base plot data\nplots = {row[0]: row for row in cur.execute('SELECT ID, TerrainType, IsImpassable FROM Plots').fetchall()}\nfeatures = {row[0]: row[1] for row in cur.execute('SELECT ID, FeatureType FROM PlotFeatures').fetchall() if row[1] is not None}\nresources = {row[0]: row[1] for row in cur.execute('SELECT ID, ResourceType FROM PlotResources').fetchall() if row[1] is not None}\n\n# River edges accumulation\nriver_edges = defaultdict(set)  # id -> set of edge indices\nfor row in cur.execute('SELECT ID, IsNEOfRiver, IsWOfRiver, IsNWOfRiver FROM PlotRivers').fetchall():\n    pid, ne, w, nw = row\n    x, y = pid % width, pid // width\n    # direction indices: 1=NE,3=W,2=NW\n    if ne:\n        river_edges[pid].add(1)\n        nx, ny = get_neighbor_at_direction(x, y, 1)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(get_opposite_direction(1))\n    if w:\n        river_edges[pid].add(3)\n        nx, ny = get_neighbor_at_direction(x, y, 3)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(get_opposite_direction(3))\n    if nw:\n        river_edges[pid].add(2)\n        nx, ny = get_neighbor_at_direction(x, y, 2)\n        if 0 <= nx < width and 0 <= ny < height:\n            nid = ny*width + nx\n            river_edges[nid].add(get_opposite_direction(2))\n\n# Build tiles\nterr_counter = Counter()\nfeat_counter = Counter()\ncity_candidates = 0\nfor pid, (pid2, terrain_type, impassable) in plots.items():\n    x, y = pid % width, pid // width\n    feature = features.get(pid)\n    resource = resources.get(pid)\n    # map terrain\n    if 'MOUNTAIN' in terrain_type:\n        terrain='MOUNTAIN'\n    elif terrain_type == 'TERRAIN_COAST':\n        terrain='COAST'\n    elif terrain_type == 'TERRAIN_OCEAN':\n        terrain='OCEAN'\n    elif terrain_type == 'TERRAIN_PLAINS':\n        terrain='PLAINS'\n    elif terrain_type == 'TERRAIN_GRASS':\n        terrain='GRASS'\n    else:\n        terrain=terrain_type\n    is_floodplains = (feature is not None and 'FLOODPLAINS' in feature)\n    tile = Tile(x=x, y=y, terrain=terrain, feature=feature, is_hills=False, is_floodplains=is_floodplains, river_edges=list(river_edges.get(pid, [])), river_names=[], resource=resource, resource_type=None, improvement=None)\n    terr_counter[terrain] += 1\n    if feature: feat_counter[feature]+=1\n    if terrain not in ('OCEAN','COAST','LAKE','MOUNTAIN'):\n        city_candidates += 1\n\nprint('width height', width, height)\nprint('terrain counts', terr_counter)\nprint('feature counts', feat_counter)\nprint('candidate city center tiles', city_candidates)\nconn.close()\nPY\n"]
