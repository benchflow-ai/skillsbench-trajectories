[56.36596, "o", "slide size 12192000 6858000\r\n"]
[56.36601, "o", "Slide 1\r\n"]
[56.366266, "o", "  shape 1 text: Awesome-Agent-Papers\r\n"]
[56.366906, "o", "    left 1524000 top 1122363 width 9144000 height 2387600\r\n"]
[56.366929, "o", "Slide 2\r\n"]
[56.367035, "o", "  shape 1 text: Foam - Agent\r\n"]
[56.368099, "o", "    left 838200 top 365125 width 10515600 height 1325563\r\n"]
[56.368185, "o", "  shape 2 text: The paper presents Foam - Agent, a multi - agent framework automating CFD workflows from natural language. It features unique retrieval, file - generation and error - correction systems, lowering expertise barriers.\r\n"]
[56.36965, "o", "    left 838200 top 1825625 width 10515600 height 4351338\r\n"]
[56.369717, "o", "  shape 3 text: Foam-Agent: Towards Automated Intelligent CFD Workflows\r\n"]
[56.369774, "o", "    left 2648606 top 4254090 width 7903779 height 369332\r\nSlide 3\r\n"]
[56.369893, "o", "  shape 1 text: ReAct\r\n"]
[56.370863, "o", "    left 838200 top 365125 width 10515600 height 1325563\r\n"]
[56.370961, "o", "  shape 2 text: ReAct, a method for prompting large language models in a way that enables them to both reason about problems as well as operate by producing predefined actions which have external effects (e.g. interact with a wikipedia API, or take some action in some simulated text-based environment).\r\n"]
[56.372367, "o", "    left 838200 top 1825625 width 10515600 height 4351338\r\n"]
[56.372431, "o", "  shape 3 text: ReAct: Synergizing Reasoning and Acting in Language Models\r\n"]
[56.372502, "o", "    left 2113221 top 5009063 width 6097772 height 369332\r\n"]
[56.372521, "o", "Slide 4\r\n"]
[56.372646, "o", "  shape 1 text: ReAct\r\n"]
[56.373656, "o", "    left 838200 top 365125 width 10515600 height 1325563\r\n"]
[56.373759, "o", "  shape 3 text: ReAct: Synergizing Reasoning and Acting in Language Models\r\n"]
[56.373819, "o", "    left 371877 top 3161009 width 6097772 height 369332\r\nSlide 5\r\n"]
[56.37392, "o", "  shape 1 text: MAST\r\n"]
[56.374884, "o", "    left 838200 top 365125 width 10515600 height 1325563\r\n"]
[56.375064, "o", "  shape 2 text: Presents MAST, a taxonomy for MAS failures. Develops an LLM-as-a-Judge pipeline, and opensources data to guide MAS development.\r\n"]
[56.376405, "o", "    left 838200 top 1825625 width 10515600 height 4351338\r\n"]
[56.376495, "o", "  shape 3 text: Why Do Multi-Agent LLM Systems Fail?\r\n    left 4569342 top 4413915 width 6097772 height 369332\r\nSlide 6\r\n"]
[56.376627, "o", "  shape 1 text: MultiAgentBench\r\n"]
[56.377615, "o", "    left 838200 top 365125 width 10515600 height 1325563\r\n"]
[56.377706, "o", "  shape 2 text: Introduces MultiAgentBench to evaluate LLM - based multi - agent systems. Assesses collaboration and competition, evaluates protocols and strategies, code & data open - sourced.\r\n"]
[56.379106, "o", "    left 838200 top 1825625 width 10515600 height 4351338\r\n"]
[56.379187, "o", "  shape 3 text: MultiAgentBench : Evaluating the Collaboration and Competition of LLM agents\r\n"]
[56.379253, "o", "    left 3335965 top 4001294 width 6097772 height 646331\r\n"]
[56.402575, "o", "\u001b[?2004hroot@c39c18fba0d8:~# "]
[156.919581, "i", "/root/venv/bin/python - <<'PY'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN, MSO_ANCHOR\nfrom pptx.enum.shapes import PP_PLACEHOLDER\nfrom pptx.oxml import OxmlElement\nfrom pptx.oxml.ns import qn\n\nprs = Presentation('/root/Awesome-Agent-Papers.pptx')\nslide_width, slide_height = prs.slide_width, prs.slide_height\n\ntitles = []\nfor idx, slide in enumerate(prs.slides, 1):\n    if idx == 1:\n        continue\n    candidates = []\n    for shape in slide.shapes:\n        if not shape.has_text_frame:\n            continue\n        text = shape.text.strip()\n        if not text:\n            continue\n        l = len(text)\n        if 20 <= l <= 120:\n            candidates.append((l, shape, text))\n    if not candidates:\n        continue\n    candidates.sort(key=lambda x: x[0], reverse=True)\n    l, shape, text = candidates[0]\n    titles.append(text)\n\n    width = slide_width - Inches(1)\n    height = Inches(0.5)\n    left = int((slide_width - width) / 2)\n    top = int(slide_height - height - Inches(0.3))\n    shape.left, shape.top, shape.width, shape.height = left, top, width, height\n    tf = shape.text_frame\n    tf.word_wrap = False\n    tf.vertical_anchor = MSO_ANCHOR.MIDDLE\n    for p in tf.paragraphs:\n        p.alignment = PP_ALIGN.CENTER\n        for run in p.runs:\n            font = run.font\n            font.name = 'Arial'\n            font.size = Pt(16)\n            font.bold = False\n            font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n\n# remove duplicates preserving order\nseen = set()\nunique_titles = []\nfor t in titles:\n    if t not in seen:\n        seen.add(t)\n        unique_titles.append(t)\n\n# add reference slide\nlayout = prs.slide_layouts[1] if len(prs.slide_layouts) > 1 else prs.slide_layouts[0]\nref_slide = prs.slides.add_slide(layout)\nif ref_slide.shapes.title:\n    ref_slide.shapes.title.text = \"Reference\"\nelse:\n    ref_slide.shapes.add_textbox(Inches(0.5), Inches(0.2), slide_width-Inches(1), Inches(0.6)).text = \"Reference\"\n\nbody = None\nfor shape in ref_slide.shapes:\n    if shape.is_placeholder and shape.placeholder_format.type == PP_PLACEHOLDER.BODY:\n        body = shape\n        break\nif body is None:\n    body = ref_slide.shapes.add_textbox(Inches(1), Inches(1.5), slide_width-Inches(2), slide_height-Inches(2))\n\ntf = body.text_frame\ntf.clear()\nfor i, title in enumerate(unique_titles, 1):\n    if i == 1:\n        p = tf.paragraphs[0]\n    else:\n        p = tf.add_paragraph()\n    p.text = title\n    p.level = 0\n    pPr = p._pPr\n    # remove existing bullet elements\n    for child in list(pPr):\n        if child.tag in (qn('a:buChar'), qn('a:buAutoNum'), qn('a:buNone')):\n            pPr.remove(child)\n    bu = OxmlElement('a:buAutoNum')\n    bu.set('type', 'arabicPeriod')\n    if i == 1:\n        bu.set('startAt', '1')\n    pPr.insert(0, bu)\n\nprs.save('/root/Awesome-Agent-Papers_processed.pptx')\nPY\n"]
[156.919871, "o", "/root/venv/bin/python - <<'PY'\r\n"]
