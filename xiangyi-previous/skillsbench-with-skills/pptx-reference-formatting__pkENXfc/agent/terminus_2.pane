[?2004l[?2004h> # add reference slide
[?2004l[?2004h> layout = prs.slide_layouts[1] if len(prs.slide_layouts) > 1 else prs.slide_layouts[0]
[?2004l[?2004h> ref_slide = prs.slides.add_slide(layout)
