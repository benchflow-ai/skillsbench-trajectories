[?2004l[?2004h> body = None
[?2004l[?2004h> for shape in ref_slide.shapes:
[?2004l[?2004h>     if shape.is_placeholder and shape.placeholder_format.type == PP_PLACEHOLDER.BODY:
[?2004l[?2004h>         body = shape
[?2004l[?2004h>         break
[?2004l[?2004h> if body is None:
[?2004l[?2004h>     body = ref_slide.shapes.add_textbox(Inches(1), Inches(1.5), slide_width-Inches(2), slide_height-Inches(2))
[?2004l[?2004h> 
[?2004l[?2004h> tf = body.text_frame
[?2004l[?2004h> tf.clear()
[?2004l[?2004h> for i, title in enumerate(unique_titles, 1):
[?2004l[?2004h>     if i == 1:
