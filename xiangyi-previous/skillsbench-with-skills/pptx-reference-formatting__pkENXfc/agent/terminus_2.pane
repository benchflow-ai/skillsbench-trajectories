[?2004l[?2004h>         if child.tag in (qn('a:buChar'), qn('a:buAutoNum'), qn('a:buNone')):
[?2004l[?2004h>             pPr.remove(child)
[?2004l[?2004h>     bu = OxmlElement('a:buAutoNum')
