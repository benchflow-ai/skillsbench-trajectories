[?2004hroot@f11b82ccba1c:~# cat <<EOF > solve_fraud.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> from rapidfuzz import process, fuzz
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> vendors = pd.read_excel('/root/vendors.xlsx')
[?2004l[?2004h> pos = pd.read_csv('/root/purchase_orders.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Pre-process vendor names for fuzzy matching
[?2004l[?2004h> vendor_names = vendors['name'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> fraud_report = []
[?2004l[?2004h> 
[?2004l[?2004h> with pdfplumber.open('/root/invoices.pdf') as pdf:
[?2004l[?2004h>     for i, page in enumerate(pdf.pages):
[?2004l[?2004h>         page_num = i + 1
[?2004l[?2004h>         text = page.extract_text()
[?2004l[?2004h>         if not text:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         # Extract fields using Regex
[?2004l[?2004h>         # Note: Regex patterns based on previous inspection
[?2004l[?2004h>         v_match = re.search(r"From:\s*(.+)", text)
[?2004l[?2004h>         vendor_name_pdf = v_match.group(1).strip() if v_match else None
[?2004l[?2004h>         
[?2004l[?2004h>         a_match = re.search(r"Total\s*\$([\d\.]+)", text)
[?2004l[?2004h>         amount_pdf = float(a_match.group(1)) if a_match else 0.0
[?2004l[?2004h>         
[?2004l[?2004h>         i_match = re.search(r"Payment IBAN:\s*(.+)", text)
[?2004l[?2004h>         iban_pdf = i_match.group(1).strip() if i_match else None
[?2004l[?2004h>         
[?2004l[?2004h>         p_match = re.search(r"PO Number:\s*(.+)", text)
[?2004l[?2004h>         po_pdf = p_match.group(1).strip() if p_match else None
[?2004l[?2004h>         
[?2004l[?2004h>         reason = None
[?2004l[?2004h>         matched_vendor_row = None
[?2004l[?2004h>         
[?2004l[?2004h>         # Check 1: Unknown Vendor
[?2004l[?2004h>         # Using RapidFuzz for fuzzy matching. Threshold 80 handles minor typos.
[?2004l[?2004h>         match = process.extractOne(vendor_name_pdf, vendor_names, scorer=fuzz.ratio)
[?2004l[?2004h>         if match and match[1] >= 80:
[?2004l[?2004h>             matched_vendor_name = match[0]
[?2004l[?2004h>             matched_vendor_row = vendors[vendors['name'] == matched_vendor_name].iloc[0]
[?2004l[?2004h>         else:
[?2004l[?2004h>             reason = "Unknown Vendor"
[?2004l[?2004h>             
[?2004l[?2004h>         # Check 2: IBAN Mismatch
[?2004l[?2004h>         if not reason:
[?2004l[?2004h>             if matched_vendor_row['iban'] != iban_pdf:
[?2004l[?2004h>                 reason = "IBAN Mismatch"
[?2004l[?2004h>                 
[?2004l[?2004h>         po_row = None
[?2004l[?2004h>         # Check 3: Invalid PO
[?2004l[?2004h>         if not reason:
[?2004l[?2004h>             if po_pdf is None:
[?2004l[?2004h>                 reason = "Invalid PO"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 po_matches = pos[pos['po_number'] == po_pdf]
[?2004l[?2004h>                 if po_matches.empty:
[?2004l[?2004h>                     reason = "Invalid PO"
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     po_row = po_matches.iloc[0]
[?2004l[?2004h>                     
[?2004l[?2004h>         # Check 4: Amount Mismatch
[?2004l[?2004h>         if not reason:
[?2004l[?2004h>             # Tolerance of 0.01
[?2004l[?2004h>             if abs(po_row['amount'] - amount_pdf) > 0.01:
[?2004l[?2004h>                 reason = "Amount Mismatch"
[?2004l[?2004h>                 
[?2004l[?2004h>         # Check 5: Vendor Mismatch
[?2004l[?2004h>         if not reason:
[?2004l[?2004h>             if po_row['vendor_id'] != matched_vendor_row['id']:
[?2004l[?2004h>                 reason = "Vendor Mismatch"
[?2004l[?2004h>                 
[?2004l[?2004h>         if reason:
[?2004l[?2004h>             fraud_report.append({
[?2004l[?2004h>                 "invoice_page_number": page_num,
[?2004l[?2004h>                 "vendor_name": vendor_name_pdf,
[?2004l[?2004h>                 "invoice_amount": amount_pdf,
[?2004l[?2004h>                 "iban": iban_pdf,
[?2004l[?2004h>                 "po_number": po_pdf,
[?2004l[?2004h>                 "reason": reason
[?2004l[?2004h>             })
[?2004l[?2004h> 
[?2004l[?2004h> with open('/root/fraud_report.json', 'w') as f:
[?2004l[?2004h>     json.dump(fraud_report, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h> print(f"Processed {len(pdf.pages)} pages. Found {len(fraud_report)} fraudulent invoices.")
