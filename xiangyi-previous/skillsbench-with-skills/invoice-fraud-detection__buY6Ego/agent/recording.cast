[129.935935, "o", "\u001b[?2004hroot@f11b82ccba1c:~# "]
[203.119744, "i", "cat <<'EOF' > solve_fraud.py\nimport pandas as pd\nimport pdfplumber\nimport json\nimport re\nfrom rapidfuzz import process, fuzz\n\n# Load data\nvendors = pd.read_excel('/root/vendors.xlsx')\npos = pd.read_csv('/root/purchase_orders.csv')\n\n# Pre-process vendor names for fuzzy matching\nvendor_names = vendors['name'].tolist()\n\nfraud_report = []\n\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for i, page in enumerate(pdf.pages):\n        page_num = i + 1\n        text = page.extract_text()\n        if not text:\n            continue\n            \n        # Extract fields using Regex\n        # Patterns:\n        # Vendor: \"From: <Name>\"\n        # Amount: \"Total $<Amount>\"\n        # IBAN: \"Payment IBAN: <IBAN>\"\n        # PO: \"PO Number: <PO>\"\n        \n        v_match = re.search(r\"From:\\s*(.+)\", text)\n        vendor_name_pdf = v_match.group(1).strip() if v_match else None\n        \n        # Handle amount with potential spaces or symbols\n        a_match = re.search(r\"Total\\s*\\$?\\s*([\\d\\.]+)\", text)\n        amount_pdf = float(a_match.group(1)) if a_match else 0.0\n        \n        i_match = re.search(r\"Payment IBAN:\\s*(.+)\", text)\n        iban_pdf = i_match.group(1).strip() if i_match else None\n        \n        p_match = re.search(r\"PO Number:\\s*(.+)\", text)\n        po_pdf = p_match.group(1).strip() if p_match else None\n        \n        reason = None\n        matched_vendor_row = None\n        \n        # Check 1: Unknown Vendor\n        # Using RapidFuzz for fuzzy matching. Threshold 80 handles minor typos.\n        # We accept the best match if score >= 80.\n        match = process.extractOne(vendor_name_pdf, vendor_names, scorer=fuzz.ratio)\n        if match and match[1] >= 80:\n            matched_vendor_name = match[0]\n            matched_vendor_row = vendors[vendors['name'] == matched_vendor_name].iloc[0]\n        else:\n            reason = \"Unknown Vendor\"\n            \n        # Check 2: IBAN Mismatch\n        if not reason:\n            expected_iban = matched_vendor_row['iban']\n            # Simple string comparison\n            if expected_iban != iban_pdf:\n                reason = \"IBAN Mismatch\"\n                \n        po_row = None\n        # Check 3: Invalid PO\n        if not reason:\n            if po_pdf is None:\n                reason = \"Invalid PO\"\n            else:\n                # Check if PO exists in CSV\n                po_matches = pos[pos['po_number'] == po_pdf]\n                if po_matches.empty:\n                    reason = \"Invalid PO\"\n                else:\n                    po_row = po_matches.iloc[0]\n                    \n        # Check 4: Amount Mismatch\n        if not reason:\n            # Tolerance of 0.01\n            if abs(po_row['amount'] - amount_pdf) > 0.01:\n                reason = \"Amount Mismatch\"\n                \n        # Check 5: Vendor Mismatch\n        if not reason:\n            # Check if the PO's vendor ID matches the identified vendor's ID\n            if po_row['vendor_id'] != matched_vendor_row['id']:\n                reason = \"Vendor Mismatch\"\n                \n        if reason:\n            fraud_report.append({\n                \"invoice_page_number\": page_num,\n                \"vendor_name\": vendor_name_pdf,\n                \"invoice_amount\": amount_pdf,\n                \"iban\": iban_pdf,\n                \"po_number\": po_pdf,\n                \"reason\": reason\n            })\n\nwith open('/root/fraud_report.json', 'w') as f:\n    json.dump(fraud_report, f, indent=2)\n    \nprint(f\"Processed {len(pdf.pages)} pages. Found {len(fraud_report)} fraudulent invoices.\")\nEOF\npython3 solve_fraud.py\n"]
