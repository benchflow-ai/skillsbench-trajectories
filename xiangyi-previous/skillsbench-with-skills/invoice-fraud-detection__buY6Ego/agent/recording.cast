[26.353858, "i", "cat <<EOF > inspect_files.py\nimport pandas as pd\nimport pdfplumber\n\nprint(\"--- VENDORS.XLSX ---\")\ntry:\n    df_vendors = pd.read_excel('/root/vendors.xlsx')\n    print(df_vendors.head())\n    print(df_vendors.columns.tolist())\nexcept Exception as e:\n    print(e)\n\nprint(\"\\n--- PURCHASE_ORDERS.CSV ---\")\ntry:\n    df_po = pd.read_csv('/root/purchase_orders.csv')\n    print(df_po.head())\n    print(df_po.columns.tolist())\nexcept Exception as e:\n    print(e)\n\nprint(\"\\n--- INVOICES.PDF (Page 1) ---\")\ntry:\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        if len(pdf.pages) > 0:\n            text = pdf.pages[0].extract_text()\n            print(text)\nexcept Exception as e:\n    print(e)\nEOF\npython3 inspect_files.py\n"]
