[99.242567, "o", "                if po_matches.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.24261, "o", "> "]
[99.242664, "o", "                    reason = \"Invalid PO\"\r\n\u001b[?2004l\r"]
[99.24271, "o", "\u001b[?2004h> "]
[99.242748, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.24284, "o", "                    po_row = po_matches.iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.24287, "o", "> "]
[99.242922, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.24298, "o", "        # Check 4: Amount Mismatch\r\n\u001b[?2004l\r"]
[99.243025, "o", "\u001b[?2004h> "]
[99.243062, "o", "        if not reason:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243134, "o", "            # Tolerance of 0.01\r\n\u001b[?2004l\r"]
[99.243159, "o", "\u001b[?2004h> "]
[99.243286, "o", "            if abs(po_row['amount'] - amount_pdf) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243335, "o", "                reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.243373, "o", "> "]
[99.243425, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243462, "o", "        # Check 5: Vendor Mismatch\r\n\u001b[?2004l\r"]
[99.243487, "o", "\u001b[?2004h> "]
[99.24355, "o", "        if not reason:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243655, "o", "            if po_row['vendor_id'] != matched_vendor_row['id']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243693, "o", "                reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.243737, "o", "> "]
[99.243775, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.243794, "o", "        if reason:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.24385, "o", "            fraud_report.append({\r\n\u001b[?2004l\r"]
[99.243869, "o", "\u001b[?2004h> "]
[99.24394, "o", "                \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r"]
[99.243964, "o", "\u001b[?2004h> "]
[99.244096, "o", "                \"vendor_name\": vendor_name_pdf,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.244118, "o", "                \"invoice_amount\": amount_pdf,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.244178, "o", "                \"iban\": iban_pdf,\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.244197, "o", "> "]
[99.244246, "o", "                \"po_number\": po_pdf,\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.244264, "o", "> "]
[99.244311, "o", "                \"reason\": reason\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.244332, "o", "> "]
[99.244356, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.244377, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.24446, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.24448, "o", "> "]
[99.244542, "o", "    json.dump(fraud_report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.24456, "o", ">     \r\n\u001b[?2004l\r"]
[99.244581, "o", "\u001b[?2004h> "]
[99.244753, "o", "print(f\"Processed {len(pdf.pages)} pages. Found {len(fraud_report)} fraudulent invoices.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
