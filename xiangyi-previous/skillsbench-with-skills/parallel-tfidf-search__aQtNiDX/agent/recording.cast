[395.382341, "o", "    print(f\"Testing batch search with {len(queries)} queries...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sequential search\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nSequential batch search...\")\r\n\u001b[?2004l\r\u001b[?2004h>     import time\r\n\u001b[?2004l\r\u001b[?2004h>     start = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     seq_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h>     seq_time = time.perf_counter() - start\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Sequential time: {seq_time:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Parallel search with 4 workers\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nParallel batch search (4 workers)...\")\r\n\u001b[?2004l\r\u001b[?2004h>     par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Parallel time: {par_time:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     search_speedup = seq_time / par_time\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nBatch search speedup: {search_speedup:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Verify correctness\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nVerifying correctness (first 5 queries)...\")\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(min(5, len(queries))):\r\n\u001b[?2004l\r\u001b[?2004h>         seq_res = seq_results[i]\r\n\u001b[?2004l\r\u001b[?2004h>         par_res = par_results[i]\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(seq_res) == len(par_res), f\"Query {i} result count mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>         for j, (s, p) in enumerate(zip(seq_res, par_res)):\r\n\u001b[?2004l\r\u001b[?2004h>             assert s.doc_id == p.doc_id, f\"Query {i}, result {j}: doc_id mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>             assert abs(s.score - p.score) < 1e-9, f\"Query {i}, result {j}: score mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"✓ Correctness verified\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if search_speedup >= 2.0:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"✓ Search speedup target met: {search_speedup:.2f}x >= 2.0x\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"✗ Search speedup target not met: {search_speedup:.2f}x < 2.0x\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Summary:\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Index building: {index_speedup:.2f}x (target: 1.5x)\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Batch search:   {search_speedup:.2f}x (target: 2.0x)\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return index_speedup >= 1.5 and search_speedup >= 2.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     success = main()\r\n\u001b[?2004l\r\u001b[?2004h>     sys.exit(0 if success else 1)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
