[121.15703, "o", "    print(\"\\nVerifying correctness...\")\r\n\u001b[?2004l\r"]
[121.157112, "o", "\u001b[?2004h> "]
[121.157318, "o", "    assert seq_result.vocabulary_size == par_result.vocabulary_size, \"Vocabulary size mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.157517, "o", "    assert seq_result.num_documents == par_result.num_documents, \"Document count mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.157753, "o", "    assert seq_result.index.vocabulary == par_result.index.vocabulary, \"Vocabulary mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[121.157824, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[121.15789, "o", "    # Check a few IDF values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.15804, "o", "    sample_terms = list(seq_result.index.vocabulary)[:10]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.158114, "o", "    for term in sample_terms:\r\n\u001b[?2004l\r"]
[121.158176, "o", "\u001b[?2004h> "]
[121.158251, "o", "        seq_idf = seq_result.index.idf.get(term, 0)\r\n\u001b[?2004l\r"]
[121.158327, "o", "\u001b[?2004h> "]
[121.158404, "o", "        par_idf = par_result.index.idf.get(term, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.158466, "o", "> "]
[121.158622, "o", "        assert abs(seq_idf - par_idf) < 1e-9, f\"IDF mismatch for '{term}'\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[121.158685, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[121.158802, "o", "    print(\"✓ Index building correctness verified\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.158879, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.158951, "o", "    if speedup >= 1.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.159082, "o", "        print(f\"✓ Speedup target met: {speedup:.2f}x >= 1.5x\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.159156, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.159228, "o", "> "]
[121.159303, "o", "        print(f\"✗ Speedup target not met: {speedup:.2f}x < 1.5x\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.159374, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
