[121.160394, "o", "\u001b[?2004h> "]
[121.160465, "o", "        \"data science analysis\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.160533, "o", "        \"artificial intelligence\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.160572, "o", "> "]
[121.16069, "o", "        \"deep neural networks\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.160766, "o", "        \"computer vision systems\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
