[618.476881, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n"]
[618.476977, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[618.477076, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.47719, "o", ">     # Prepare document titles\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.477298, "o", "> "]
[618.477397, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r"]
[618.477493, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.477594, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.477688, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r"]
[618.488784, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Use more threads than CPUs to compensate for GIL\r\n\u001b[?2004l\r\u001b[?2004h>     # Threads share memory so no serialization overhead\r\n\u001b[?2004l\r\u001b[?2004h>     thread_workers = num_workers * 3\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Use ThreadPoolExecutor for better performance with shared memory\r\n\u001b[?2004l\r\u001b[?2004h>     results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with ThreadPoolExecutor(max_workers=thread_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h>         # Submit all queries\r\n\u001b[?2004l\r\u001b[?2004h>         future_to_idx = {\r\n\u001b[?2004l\r\u001b[?2004h>             executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h>             for idx, query in enumerate(queries)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Collect results in order\r\n\u001b[?2004l\r\u001b[?2004h>         for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r\u001b[?2004h>             idx = future_to_idx[future]\r\n\u001b[?2004l\r\u001b[?2004h>             results[idx] = future.result()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
