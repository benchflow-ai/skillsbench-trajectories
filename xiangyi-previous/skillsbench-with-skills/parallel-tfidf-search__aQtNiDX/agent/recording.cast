[506.638496, "i", "cat > parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\nimport multiprocessing as mp\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    \"\"\"\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    \"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    \"\"\"\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Merge results and calculate document frequencies\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores\n    5. Compute document vector norms for cosine similarity\n    \n    Args:\n        documents: List of Document objects to index\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Optimize chunk size for better parallelism\n    # Aim for 4-6x more chunks than workers\n    optimal_chunks = num_workers * 5\n    optimal_chunk_size = max(50, len(documents) // optimal_chunks)\n    actual_chunk_size = min(chunk_size, optimal_chunk_size)\n    \n    chunks = []\n    for i in range(0, len(documents), actual_chunk_size):\n        chunks.append(documents[i:i + actual_chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    \n    # Step 2: Calculate document frequencies (sequential - fast)\n    for term in index.vocabulary:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        index.document_frequencies[term] = df\n    \n    #"]
[506.638656, "i", " Step 3: Compute IDF scores (sequential - fast)\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\n    for term in index.vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * index.idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        index.inverted_index[term] = posting_list\n    \n    # Step 5: Build document vectors and compute norms (sequential - fast)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_query_batch(args):\n    \"\"\"\n    Search a batch of queries (for multiprocessing).\n    \n    Args:\n        args: Tuple of (queries, index, top_k, doc_titles)\n    \n    Returns:\n        List of search results for each query\n    \"\"\"\n    queries, index, top_k, doc_titles = args\n    from heapq import nlargest\n    \n    results = []\n    for query in queries:\n        # Tokenize query\n        query_tokens = tokenize(query)\n        if not query_tokens:\n            results.append([])\n            continue\n        \n        # Compute query TF\n        query_tf = compute_term_frequencies(query_tokens)\n        \n        # Compute query TF-IDF vector\n        query_vector = {}\n        query_norm_squared = 0.0\n        for term, tf in query_tf.items():\n            if term in index.idf:\n                tfidf = tf * index.idf[term]\n                query_vector[term] = tfidf\n                query_norm_squared += tfidf * tfidf\n        \n        if not query_vector:\n            results.append([])\n            continue\n        \n        query_norm = math.sqrt(query_norm_squared)\n        \n        # Find candidate documents\n        candidate_docs = set()\n        for term in query_vector:\n            if term in index.inverted_index:\n                for doc_id, _ in index.inverted_index[term]:\n                    candidate_docs.add(doc_id)\n        \n        # Compute cosine similarity for each candidate\n        scores = []\n        for doc_id in candidate_docs:\n            doc_vector = index.doc_vectors.get(doc_id, {})\n            doc_norm = index.doc_norms.get(doc_id, 0)\n            \n            if doc_norm == 0:\n                continue\n            \n            # Dot product\n            dot_product = sum(\n                query_vector.get(term, 0) * doc_vector.get(term, 0)\n                for term in query_vector\n            )\n            \n            # Cosine similarity\n            similarity = dot_product / (query_norm * doc_norm)\n            scores.append((doc_id, similarity))\n        \n        # Get top-k results\n        top_results = nlargest(top_k, scores, key=lambda x: x[1])\n        \n        # Build result objects\n        query_results = []\n        for doc_id, score in top_results:\n            query_results.append(\n                SearchResult(\n                    doc_id=doc_id,\n                    score=score,\n                    title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\n                )\n            )\n        results.append(query_results)\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n  "]
[506.638704, "i", "  top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    \"\"\"\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    # Split queries into batches for parallel processing\n    # Each worker gets a batch of queries to process\n    queries_per_batch = max(1, len(queries) // num_workers)\n    \n    query_batches = []\n    for i in range(0, len(queries), queries_per_batch):\n        batch = queries[i:i + queries_per_batch]\n        query_batches.append((batch, index, top_k, doc_titles))\n    \n    # Process query batches in parallel\n    all_results = []\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_search_query_batch, batch) for batch in query_batches]\n        \n        for future in futures:  # Maintain order\n            batch_results = future.result()\n            all_results.extend(batch_results)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return all_results, elapsed\nEOF\n"]
[506.638943, "o", "cat > parallel_solution.py << 'EOF'\r\n"]
[506.638973, "o", "\u001b[?2004l\r"]
[506.639154, "o", "\u001b[?2004h> "]
[506.639248, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.639316, "o", "> "]
[506.639751, "o", "Parallel TF-IDF Implementation\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> This module provides parallel implementations of:"]
[506.639828, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.640097, "o", "1. TF-IDF index building with parallel document processing\r\n\u001b[?2004l\r"]
[506.64017, "o", "\u001b[?2004h> "]
[506.640377, "o", "2. Batch search with parallel query processing\r\n\u001b[?2004l\r"]
[506.640437, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[506.640494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[506.640559, "o", "\u001b[?2004h> "]
[506.640614, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.64069, "o", "> "]
[506.640752, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.640944, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[506.641001, "o", "\u001b[?2004h> "]
[506.641312, "o", "from concurrent.futures import ProcessPoolExecutor, as_completed\r\n\u001b[?2004l\r"]
[506.641371, "o", "\u001b[?2004h> "]
[506.641528, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r"]
[506.641582, "o", "\u001b[?2004h> "]
[506.641794, "o", "from typing import List, Optional, Tuple\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.64185, "o", "> "]
[506.641992, "o", "import multiprocessing as mp\r\n\u001b[?2004l\r"]
[506.642053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.6422, "o", "from sequential import (\r\n\u001b[?2004l\r"]
[506.642256, "o", "\u001b[?2004h> "]
[506.642328, "o", "    TFIDFIndex,\r\n\u001b[?2004l\r"]
[506.642388, "o", "\u001b[?2004h> "]
[506.642464, "o", "    SearchResult,\r\n\u001b[?2004l\r"]
[506.642522, "o", "\u001b[?2004h> "]
[506.642585, "o", "    tokenize,\r\n\u001b[?2004l\r"]
[506.642643, "o", "\u001b[?2004h> "]
[506.642779, "o", "    compute_term_frequencies,\r\n\u001b[?2004l\r"]
[506.642837, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.642892, "o", "> "]
[506.64306, "o", "from document_generator import Document\r\n\u001b[?2004l\r"]
[506.643122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[506.643183, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[506.643559, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[506.64362, "o", "\u001b[?2004h> "]
[506.643688, "o", "# Data Structures\r\n\u001b[?2004l\r"]
[506.643746, "o", "\u001b[?2004h> "]
[506.644134, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[506.644193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.644248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.644324, "o", "@dataclass\r\n\u001b[?2004l\r"]
[506.644379, "o", "\u001b[?2004h> "]
[506.644516, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[506.644583, "o", "\u001b[?2004h> "]
[506.644832, "o", "    \"\"\"Result from parallel index building.\"\"\""]
[506.644931, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.644968, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.645116, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r"]
[506.645146, "o", "\u001b[?2004h> "]
[506.645292, "o", "    elapsed_time: float\r\n\u001b[?2004l\r"]
[506.645374, "o", "\u001b[?2004h> "]
[506.645459, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[506.645485, "o", "\u001b[?2004h> "]
[506.645639, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[506.645668, "o", "\u001b[?2004h> "]
[506.645695, "o", "\r\n\u001b[?2004l\r"]
[506.645733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[506.645761, "o", "\u001b[?2004h"]
[506.646689, "o", "> "]
[506.646771, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Parallel Index Building\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.646885, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.646915, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.647016, "o", "> \r\n\u001b[?2004l\r"]
[506.647085, "o", "\u001b[?2004h> "]
[506.647416, "o", "def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r"]
[506.647478, "o", "\u001b[?2004h>     \"\"\"\r\n"]
[506.647545, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[506.647841, "o", "    Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r"]
[506.647927, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.647964, "o", "> "]
[506.648034, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.648203, "o", "> "]
[506.648351, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r"]
[506.648479, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.648634, "o", ">     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.64885, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r"]
[506.648947, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[506.648979, "o", "\u001b[?2004h> "]
[506.649119, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r"]
[506.64927, "o", "\u001b[?2004h>     doc_terms = {}\r\n\u001b[?2004l\r"]
[506.649308, "o", "\u001b[?2004h> "]
[506.649436, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[506.649469, "o", "\u001b[?2004h> "]
[506.64951, "o", "    \r\n\u001b[?2004l\r"]
[506.649551, "o", "\u001b[?2004h> "]
[506.649705, "o", "    for doc in docs_chunk:\r\n\u001b[?2004l\r"]
[506.649743, "o", "\u001b[?2004h> "]
[506.649976, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r"]
[506.650007, "o", "\u001b[?2004h> "]
[506.650182, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r"]
[506.65022, "o", "\u001b[?2004h> "]
[506.650467, "o", "        tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r"]
[506.650504, "o", "\u001b[?2004h> "]
[506.650716, "o", "        doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r"]
[506.650755, "o", "\u001b[?2004h> "]
[506.650998, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r"]
[506.651037, "o", "\u001b[?2004h> "]
[506.651233, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[506.651263, "o", "\u001b[?2004h> "]
[506.651342, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.651603, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r"]
[506.651643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[506.65167, "o", "\u001b[?2004h"]
[506.651756, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.651899, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r"]
[506.651939, "o", "\u001b[?2004h> "]
[506.652111, "o", "    documents: List[Document],\r\n\u001b[?2004l\r"]
[506.65215, "o", "\u001b[?2004h> "]
[506.652358, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r"]
[506.652386, "o", "\u001b[?2004h> "]
[506.652545, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r"]
[506.652583, "o", "\u001b[?2004h> "]
[506.652776, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[506.652874, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[506.652906, "o", "\u001b[?2004h> "]
[506.653173, "o", "    Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.653196, "o", "> "]
[506.65324, "o", "    \r\n\u001b[?2004l\r"]
[506.65327, "o", "\u001b[?2004h> "]
[506.653364, "o", "    Steps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.653393, "o", "> "]
[506.653777, "o", "    1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.653806, "o", "> "]
[506.654106, "o", "    2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r"]
[506.654198, "o", "\u001b[?2004h> "]
[506.654302, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r"]
[506.654389, "o", "\u001b[?2004h> "]
[506.656819, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h>     5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h>         documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h>         chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.65687, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[506.656968, "o", "\u001b[?2004h> "]
[506.65703, "o", "    if num_workers is None:\r\n\u001b[?2004l\r"]
[506.657073, "o", "\u001b[?2004h> "]
[506.657194, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[506.657235, "o", "\u001b[?2004h> "]
[506.657312, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r"]
[506.657338, "o", "\u001b[?2004h> "]
[506.657505, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.657532, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.657735, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r"]
[506.657775, "o", "\u001b[?2004h> "]
[506.657904, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.658001, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.658036, "o", "    vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.658073, "o", ">     \r\n\u001b[?2004l\r"]
[506.658184, "o", "\u001b[?2004h> "]
[506.658283, "o", "    # Optimize chunk size for better parallelism\r\n\u001b[?2004l\r"]
[506.658315, "o", "\u001b[?2004h> "]
[506.658462, "o", "    # Aim for 4-6x more chunks than workers\r\n\u001b[?2004l\r"]
[506.65849, "o", "\u001b[?2004h> "]
[506.658612, "o", "    optimal_chunks = num_workers * 5\r\n\u001b[?2004l\r"]
[506.658642, "o", "\u001b[?2004h> "]
[506.658842, "o", "    optimal_chunk_size = max(50, len(documents) // optimal_chunks)\r\n\u001b[?2004l\r"]
[506.658871, "o", "\u001b[?2004h> "]
[506.659067, "o", "    actual_chunk_size = min(chunk_size, optimal_chunk_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.659097, "o", ">     \r\n\u001b[?2004l\r"]
[506.659124, "o", "\u001b[?2004h> "]
[506.659218, "o", "    chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.659416, "o", "    for i in range(0, len(documents), actual_chunk_size):\r\n\u001b[?2004l\r"]
[506.659446, "o", "\u001b[?2004h> "]
[506.659633, "o", "        chunks.append(documents[i:i + actual_chunk_size])\r\n\u001b[?2004l\r"]
[506.659674, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[506.659703, "o", "\u001b[?2004h> "]
[506.659814, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.659844, "o", "> "]
[506.660056, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.660338, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.660412, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.660573, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.660823, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.660993, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r"]
[506.661022, "o", "\u001b[?2004h> "]
[506.661172, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[506.661198, "o", "\u001b[?2004h> "]
[506.661347, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r"]
[506.661371, "o", "\u001b[?2004h> "]
[506.661395, "o", "    \r\n\u001b[?2004l\r"]
[506.661417, "o", "\u001b[?2004h> "]
[506.661545, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[506.661575, "o", "\u001b[?2004h>     \r\n"]
[506.661598, "o", "\u001b[?2004l\r\u001b[?2004h"]
[506.661618, "o", "> "]
[506.661823, "o", "    # Step 2: Calculate document frequencies (sequential - fast)\r\n\u001b[?2004l\r"]
[506.661852, "o", "\u001b[?2004h> "]
[506.661999, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.662125, "o", "> "]
[506.662246, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.662414, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.662453, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.662614, "o", "    # Step 3: Compute IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[506.66264, "o", "\u001b[?2004h> "]
[506.662738, "o", "    N = index.num_documents\r\n\u001b[?2004l\r"]
[506.662765, "o", "\u001b[?2004h> "]
[506.662942, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[506.662967, "o", "\u001b[?2004h> "]
[506.663114, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[506.663138, "o", "\u001b[?2004h> "]
[506.663165, "o", "    \r\n\u001b[?2004l\r"]
[506.663187, "o", "\u001b[?2004h> "]
[506.663428, "o", "    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.66345, "o", "> "]
[506.663556, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[506.663609, "o", "\u001b[?2004h> "]
[506.663674, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[506.663723, "o", "\u001b[?2004h> "]
[506.663874, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[506.663927, "o", "\u001b[?2004h> "]
[506.664017, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[506.664072, "o", "\u001b[?2004h> "]
[506.664157, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[506.664205, "o", "\u001b[?2004h> "]
[506.664332, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[506.664384, "o", "\u001b[?2004h> "]
[506.664532, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[506.664585, "o", "\u001b[?2004h> "]
[506.66477, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[506.664819, "o", "\u001b[?2004h> "]
[506.664953, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r"]
[506.664999, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[506.665042, "o", "\u001b[?2004h> "]
[506.665252, "o", "    # Step 5: Build document vectors and compute norms (sequential - fast)\r\n\u001b[?2004l\r"]
[506.665302, "o", "\u001b[?2004h> "]
[506.665447, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[506.665504, "o", "\u001b[?2004h> "]
[506.665558, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[506.66561, "o", "\u001b[?2004h> "]
[506.665675, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[506.665726, "o", "\u001b[?2004h> "]
[506.665845, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.66589, "o", "> "]
[506.666011, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[506.666064, "o", "\u001b[?2004h> "]
[506.666158, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[506.666212, "o", "\u001b[?2004h> "]
[506.66633, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[506.666375, "o", "\u001b[?2004h> "]
[506.666513, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.666562, "o", "> "]
[506.666707, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[506.666761, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.666805, "o", "> "]
[506.666936, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[506.666982, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.667024, "o", "> "]
[506.667116, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[506.667162, "o", "\u001b[?2004h> "]
[506.667207, "o", "        index=index,\r\n\u001b[?2004l\rl"]
[506.667252, "o", "\u001b[?2004h> "]
[506.667335, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r"]
[506.66738, "o", "\u001b[?2004h> "]
[506.667481, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[506.667532, "o", "\u001b[?2004h> "]
[506.667662, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r"]
[506.667708, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[506.667754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.667795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.668029, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[506.668078, "o", "\u001b[?2004h> "]
[506.668191, "o", "# Parallel Search Functions\r\n\u001b[?2004l\r"]
[506.668232, "o", "\u001b[?2004h> "]
[506.668497, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.668553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.668598, "o", "> "]
[506.66869, "o", "def _search_query_batch(args):"]
[506.668739, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.668787, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[506.668836, "o", "\u001b[?2004h> "]
[506.669014, "o", "    Search a batch of queries (for multiprocessing).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.669074, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.669118, "o", ">     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.669254, "o", "        args: Tuple of (queries, index, top_k, doc_titles)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.669301, "o", ">     \r\n\u001b[?2004l\r"]
[506.669349, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[506.669393, "o", "\u001b[?2004h> "]
[506.6695, "o", "        List of search results for each query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.669549, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.669658, "o", "    queries, index, top_k, doc_titles = args\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.669703, "o", "> "]
[506.669745, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r"]
[506.669788, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[506.669829, "o", "\u001b[?2004h> "]
[506.669872, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.669942, "o", "    for query in queries:\r\n\u001b[?2004l\r"]
[506.669998, "o", "\u001b[?2004h> "]
[506.670042, "o", "        # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.670149, "o", "        query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[506.670193, "o", "\u001b[?2004h> "]
[506.670237, "o", "        if not query_tokens:\r\n\u001b[?2004l\r"]
[506.67028, "o", "\u001b[?2004h> "]
[506.670334, "o", "            results.append([])\r\n\u001b[?2004l\r"]
[506.670378, "o", "\u001b[?2004h> "]
[506.670426, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.670469, "o", ">         \r\n\u001b[?2004l\r"]
[506.670511, "o", "\u001b[?2004h> "]
[506.67055, "o", "        # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.67069, "o", "        query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[506.670748, "o", "\u001b[?2004h> "]
[506.670796, "o", "        # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.67084, "o", "        query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.670925, "o", "        query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.670973, "o", "> "]
[506.671038, "o", "        for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[506.671088, "o", "\u001b[?2004h> "]
[506.671152, "o", "            if term in index.idf:\r\n\u001b[?2004l\r"]
[506.671198, "o", "\u001b[?2004h> "]
[506.671288, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[506.671334, "o", "\u001b[?2004h> "]
[506.671406, "o", "                query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[506.67145, "o", "\u001b[?2004h> "]
[506.671556, "o", "                query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.6716, "o", ">         \r\n\u001b[?2004l\r"]
[506.671648, "o", "\u001b[?2004h> "]
[506.671689, "o", "        if not query_vector:\r\n\u001b[?2004l\r"]
[506.671733, "o", "\u001b[?2004h> "]
[506.671787, "o", "            results.append([])\r\n\u001b[?2004l\r"]
[506.671837, "o", "\u001b[?2004h> "]
[506.671882, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.67193, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.672044, "o", "        query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r"]
[506.672099, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[506.672143, "o", "\u001b[?2004h> "]
[506.6722, "o", "        # Find candidate documents\r\n\u001b[?2004l\r"]
[506.672244, "o", "\u001b[?2004h> "]
[506.672333, "o", "        candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.672411, "o", "        for term in query_vector:\r\n\u001b[?2004l\r"]
[506.672459, "o", "\u001b[?2004h> "]
[506.672541, "o", "            if term in index.inverted_index:\r\n\u001b[?2004l\r"]
[506.672586, "o", "\u001b[?2004h> "]
[506.672715, "o", "                for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[506.672781, "o", "\u001b[?2004h> "]
[506.67285, "o", "                    candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[506.672913, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[506.672969, "o", "> "]
[506.673023, "o", "        # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r"]
[506.673088, "o", "\u001b[?2004h> "]
[506.673143, "o", "        scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673214, "o", "        for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[506.673261, "o", "\u001b[?2004h> "]
[506.673317, "o", "            doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r"]
[506.673364, "o", "\u001b[?2004h> "]
[506.67342, "o", "            doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.673483, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673538, "o", "            if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673598, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673715, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673783, "o", "            # Dot product\r\n\u001b[?2004l\r\u001b[?2004h>             dot_product = sum(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.673871, "o", "                query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.673923, "o", "> "]
[506.674019, "o", "                for term in query_vector\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r"]
[506.674074, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.674133, "o", "            # Cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.674217, "o", "            similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.674265, "o", "> "]
[506.674322, "o", "            scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[506.674401, "o", "\u001b[?2004h> "]
[506.67447, "o", "        # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.674558, "o", "        top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.674639, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         # Build result objects\r\n\u001b[?2004l\r"]
[506.674691, "o", "\u001b[?2004h>         query_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.674762, "o", "        for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[506.674827, "o", "\u001b[?2004h>             query_results.append(\r\n\u001b[?2004l\r"]
[506.674891, "o", "\u001b[?2004h>                 SearchResult(\r\n\u001b[?2004l\r"]
[506.674956, "o", "\u001b[?2004h>                     doc_id=doc_id,\r\n\u001b[?2004l\r"]
[506.675061, "o", "\u001b[?2004h> "]
[506.675121, "o", "                    score=score,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.675168, "o", "                    title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.675279, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.675391, "o", "        results.append(query_results)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[506.675449, "o", "\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[506.675666, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[506.675732, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h>     queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h>     index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h>     num_workers: Optional[int] = None,\r\n\u001b[?2004l\r"]
[506.675779, "o", "\u001b[?2004h> "]
[506.675876, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.675925, "o", ") -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.676023, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.676105, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.676154, "o", "> "]
[506.67621, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.676266, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.676312, "o", "> "]
[506.67637, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.676473, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h"]
[506.67652, "o", "> "]
[506.676587, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r"]
[506.676635, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.67694, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[506.684747, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Prepare document titles\r\n\u001b[?2004l\r\u001b[?2004h>     doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Split queries into batches for parallel processing\r\n\u001b[?2004l\r\u001b[?2004h>     # Each worker gets a batch of queries to process\r\n\u001b[?2004l\r\u001b[?2004h>     queries_per_batch = max(1, len(queries) // num_workers)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     query_batches = []\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(0, len(queries), queries_per_batch):\r\n\u001b[?2004l\r\u001b[?2004h>         batch = queries[i:i + queries_per_batch]\r\n\u001b[?2004l\r\u001b[?2004h>         query_batches.append((batch, index, top_k, doc_titles))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Process query batches in parallel\r\n\u001b[?2004l\r\u001b[?2004h>     all_results = []\r\n\u001b[?2004l\r\u001b[?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h>         futures = [executor.submit(_search_query_batch, batch) for batch in query_batches]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for future in futures:  # Maintain order\r\n\u001b[?2004l\r\u001b[?2004h>             batch_results = future.result()\r\n\u001b[?2004l\r\u001b[?2004h>             all_results.extend(batch_results)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return all_results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[506.686379, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[512.882434, "i", "python3 test_large.py\n"]
[512.882727, "o", "python3 test_large.py\r\n\u001b[?2004l\r"]
[512.967033, "o", "============================================================\r\nLarge-Scale Parallel TF-IDF Test\r\n============================================================\r\n"]
[542.559625, "o", "Generated 10000 documents.\r\n\r\nGenerated 10000 documents\r\n\r\nBuilding sequential index...\r\n"]
[547.757491, "o", "Sequential time: 5.151s\r\nVocabulary size: 392\r\n\r\nBuilding parallel index (4 workers)...\r\n"]
[551.308293, "o", "Parallel time: 3.514s\r\nVocabulary size: 392\r\n\r\nIndex building speedup: 1.47x\r\n✗ Index speedup target not met: 1.47x < 1.5x\r\n"]
