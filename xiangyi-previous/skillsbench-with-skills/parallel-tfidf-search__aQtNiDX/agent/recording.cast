[121.154667, "o", "> "]
[121.154758, "o", "    documents = generate_corpus(2000, seed=42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.154796, "o", "> "]
[121.154929, "o", "    print(f\"Generated {len(documents)} documents\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[121.15499, "o", "\u001b[?2004h> "]
[121.155056, "o", "    # Build sequential index\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.155137, "o", "> "]
[121.15521, "o", "    print(\"\\nBuilding sequential index...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.155277, "o", "    seq_result = build_tfidf_index_sequential(documents)\r\n\u001b[?2004l\r"]
[121.155345, "o", "\u001b[?2004h> "]
[121.155439, "o", "    print(f\"Sequential time: {seq_result.elapsed_time:.3f}s\")\r\n\u001b[?2004l\r"]
[121.155508, "o", "\u001b[?2004h> "]
[121.155596, "o", "    print(f\"Vocabulary size: {seq_result.vocabulary_size}\")\r\n\u001b[?2004l\r"]
[121.155628, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[121.155702, "o", "\u001b[?2004h> "]
[121.155814, "o", "    # Build parallel index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.155888, "o", "    print(\"\\nBuilding parallel index (4 workers)...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.15596, "o", "> "]
[121.156098, "o", "    par_result = build_tfidf_index_parallel(documents, num_workers=4, chunk_size=500)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.156254, "o", "    print(f\"Parallel time: {par_result.elapsed_time:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.15642, "o", "    print(f\"Vocabulary size: {par_result.vocabulary_size}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.156494, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.15657, "o", "    # Check speedup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.156725, "o", "    speedup = seq_result.elapsed_time / par_result.elapsed_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.156818, "o", "    print(f\"\\nSpeedup: {speedup:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.156891, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
