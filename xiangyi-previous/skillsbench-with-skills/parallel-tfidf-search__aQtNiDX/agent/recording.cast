[273.176269, "o", "\u001b[?2004h> "]
[273.176333, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.176381, "o", "> "]
[273.176437, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.176486, "o", "> "]
