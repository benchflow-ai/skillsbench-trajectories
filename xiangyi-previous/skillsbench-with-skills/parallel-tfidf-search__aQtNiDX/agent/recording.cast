[618.442287, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[618.442338, "o", "\u001b[?2004h> "]
[618.444872, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r\u001b[?2004h>     documents: List[Document],\r\n\u001b[?2004l\r\u001b[?2004h>     num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h>     chunk_size: int = 500,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Steps:\r\n\u001b[?2004l\r\u001b[?2004h>     1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h>     2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h>     3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.445048, "o", "> "]
[618.44513, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.445419, "o", "    5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r"]
[618.445457, "o", "\u001b[?2004h>     \r\n"]
[618.445488, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[618.445579, "o", "    Args:\r\n\u001b[?2004l\r"]
[618.445614, "o", "\u001b[?2004h> "]
[618.445873, "o", "        documents: List of Document objects to index\r\n\u001b[?2004l\r"]
[618.445899, "o", "\u001b[?2004h> "]
[618.446466, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.446542, "o", "        chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r"]
[618.4466, "o", "\u001b[?2004h>     \r\n"]
[618.446657, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[618.446713, "o", "    Returns:\r\n\u001b[?2004l\r"]
[618.446767, "o", "\u001b[?2004h> "]
[618.447101, "o", "        ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r"]
[618.44716, "o", "\u001b[?2004h>     \"\"\""]
[618.447219, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.447412, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[618.447469, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.447523, "o", "\u001b[?2004h> "]
[618.447663, "o", "    if num_workers is None:\r\n\u001b[?2004l\r"]
[618.44772, "o", "\u001b[?2004h> "]
[618.447887, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r"]
[618.447944, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.447999, "o", "\u001b[?2004h> "]
[618.448118, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r"]
[618.448178, "o", "\u001b[?2004h> "]
[618.448361, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[618.448421, "o", "\u001b[?2004h>     "]
[618.448476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.448799, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r"]
[618.448862, "o", "\u001b[?2004h> "]
[618.44896, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r"]
[618.449011, "o", "\u001b[?2004h> "]
[618.449093, "o", "    doc_terms = {}\r\n\u001b[?2004l\r"]
[618.449141, "o", "\u001b[?2004h> "]
[618.449257, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[618.449306, "o", "\u001b[?2004h> "]
[618.449354, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.449635, "o", "    # Optimize chunk size for better parallelism\r\n\u001b[?2004l\r"]
[618.44969, "o", "\u001b[?2004h> "]
[618.450024, "o", "    # Create more chunks than workers for better load balancing\r\n\u001b[?2004l\r"]
[618.45009, "o", "\u001b[?2004h> "]
[618.450292, "o", "    # Aim for 6-8x more chunks than workers\r\n\u001b[?2004l\r"]
[618.450346, "o", "\u001b[?2004h> "]
[618.450531, "o", "    optimal_chunks = num_workers * 7\r\n\u001b[?2004l\r"]
[618.450588, "o", "\u001b[?2004h> "]
[618.45096, "o", "    optimal_chunk_size = max(30, len(documents) // optimal_chunks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.451049, "o", "> "]
[618.451293, "o", "    actual_chunk_size = min(chunk_size, optimal_chunk_size)\r\n\u001b[?2004l\r"]
[618.451348, "o", "\u001b[?2004h>     \r\n"]
[618.4514, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[618.451555, "o", "    chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.451847, "o", "    for i in range(0, len(documents), actual_chunk_size):\r\n\u001b[?2004l\r"]
[618.451929, "o", "\u001b[?2004h> "]
[618.452185, "o", "        chunks.append(documents[i:i + actual_chunk_size])\r\n\u001b[?2004l\r"]
[618.452243, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.452294, "o", "\u001b[?2004h> "]
[618.452527, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r"]
[618.452596, "o", "\u001b[?2004h> "]
[618.452918, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[618.45298, "o", "\u001b[?2004h> "]
[618.453406, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r"]
[618.453526, "o", "\u001b[?2004h> "]
[618.453626, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.453774, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[618.453851, "o", "\u001b[?2004h> "]
[618.454169, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r"]
[618.454276, "o", "\u001b[?2004h> "]
[618.454476, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r"]
[618.454531, "o", "\u001b[?2004h> "]
[618.454726, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[618.45478, "o", "\u001b[?2004h> "]
[618.455026, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r"]
[618.455128, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.455255, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[618.455335, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.455409, "o", "\u001b[?2004h> "]
[618.455693, "o", "    # Step 2: Calculate document frequencies (sequential - fast)\r\n\u001b[?2004l\r"]
[618.455779, "o", "\u001b[?2004h> "]
[618.455901, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[618.455983, "o", "\u001b[?2004h> "]
[618.456312, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[618.456391, "o", "\u001b[?2004h> "]
[618.456593, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[618.456688, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.456993, "o", "    # Step 3: Compute IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[618.457076, "o", "\u001b[?2004h> "]
[618.457185, "o", "    N = index.num_documents\r\n\u001b[?2004l\r"]
[618.457266, "o", "\u001b[?2004h> "]
[618.45753, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[618.457613, "o", "\u001b[?2004h> "]
[618.457814, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[618.457896, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.458296, "o", "    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[618.458376, "o", "\u001b[?2004h> "]
[618.458524, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[618.45861, "o", "\u001b[?2004h> "]
[618.458684, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[618.458756, "o", "\u001b[?2004h> "]
[618.459002, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[618.459086, "o", "\u001b[?2004h> "]
[618.459201, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[618.459276, "o", "\u001b[?2004h> "]
[618.459433, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[618.459555, "o", "\u001b[?2004h> "]
[618.459705, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[618.459867, "o", "\u001b[?2004h> "]
[618.460004, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[618.460087, "o", "\u001b[?2004h> "]
[618.460355, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[618.460438, "o", "\u001b[?2004h> "]
[618.460664, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r"]
[618.460745, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.46082, "o", "> "]
[618.461139, "o", "    # Step 5: Build document vectors and compute norms (sequential - fast)\r\n\u001b[?2004l\r"]
[618.461224, "o", "\u001b[?2004h> "]
[618.461443, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[618.461525, "o", "\u001b[?2004h> "]
[618.461602, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[618.46168, "o", "\u001b[?2004h> "]
[618.461824, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.462083, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[618.462207, "o", "\u001b[?2004h> "]
[618.462313, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[618.462416, "o", "\u001b[?2004h> "]
[618.462545, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[618.462654, "o", "\u001b[?2004h> "]
[618.46282, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[618.462952, "o", "\u001b[?2004h> "]
[618.463083, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[618.463188, "o", "\u001b[?2004h> "]
[618.463449, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[618.463572, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.463793, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[618.463923, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.464063, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[618.464174, "o", "\u001b[?2004h> "]
[618.464276, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.464401, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r"]
[618.464508, "o", "\u001b[?2004h> "]
[618.464627, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[618.464757, "o", "\u001b[?2004h> "]
[618.464921, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r"]
[618.465035, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[618.465137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.465486, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[618.465606, "o", "\u001b[?2004h> # Parallel Search Functions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.465822, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[618.465956, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.466077, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h>     query: str,\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.466182, "o", ">     index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.466285, "o", "    top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.466387, "o", "    doc_titles: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.466489, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.466585, "o", "> "]
[618.466683, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.466785, "o", "\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.466888, "o", "        query: Search query string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.467013, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.467114, "o", "> "]
[618.467216, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.467333, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r"]
[618.467442, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[618.46754, "o", "\u001b[?2004h> "]
[618.467641, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.467739, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.467839, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.467955, "o", "\u001b[?2004h>     # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.468067, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.468168, "o", "    if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.468272, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[618.468371, "o", "\u001b[?2004h>     # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.468465, "o", "> "]
[618.468564, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[618.468693, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.468818, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h>     query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.468946, "o", ">     query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469062, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469179, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469295, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.469409, "o", ">             query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[618.469522, "o", "\u001b[?2004h> "]
[618.46964, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469756, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469871, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.469996, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.47011, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.470228, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h>     candidate_docs = set()"]
[618.470348, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for term in query_vector:\r\n\u001b[?2004l\r"]
[618.470463, "o", "\u001b[?2004h> "]
[618.470576, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.470693, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.4708, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[618.47091, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.471024, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.471126, "o", ">     scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.471229, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.471395, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r"]
[618.471515, "o", "\u001b[?2004h> "]
[618.471622, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.471725, "o", ">         if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.471832, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.471955, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         # Dot product\r\n\u001b[?2004l\r"]
[618.472072, "o", "\u001b[?2004h>         dot_product = sum(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.472249, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r"]
[618.472369, "o", "\u001b[?2004h>             for term in query_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.472471, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n"]
[618.472571, "o", "\u001b[?2004l\r\u001b[?2004h>         # Cosine similarity"]
[618.472695, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.472813, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.472923, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[618.473037, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.473142, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.473245, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[618.47341, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Build result objects\r\n\u001b[?2004l\r"]
[618.473507, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.473618, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[618.473703, "o", "\u001b[?2004h>         results.append("]
[618.473782, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.473863, "o", "            SearchResult(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.473953, "o", "                doc_id=doc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.474038, "o", "                score=score,\r\n\u001b[?2004l\r"]
