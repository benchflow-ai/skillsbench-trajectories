[121.159523, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.159592, "o", "> "]
[121.159661, "o", "def test_batch_search(seq_result, par_result, documents):\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.159726, "o", "> "]
[121.159791, "o", "    \"\"\"Test parallel batch search.\"\"\"\r\n\u001b[?2004l\r"]
[121.159826, "o", "\u001b[?2004h> "]
[121.159893, "o", "    print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
