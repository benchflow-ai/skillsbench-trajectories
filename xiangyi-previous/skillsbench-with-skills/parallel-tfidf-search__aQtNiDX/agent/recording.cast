[121.16097, "o", "        \"statistical models\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.16101, "o", ">     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.1611, "o", "    print(f\"\\nSearching {len(queries)} queries...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
