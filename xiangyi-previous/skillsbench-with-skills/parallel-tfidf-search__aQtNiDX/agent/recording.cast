[121.162377, "o", "    speedup = seq_time / par_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.162445, "o", ">     print(f\"\\nSpeedup: {speedup:.2f}x\")\r\n\u001b[?2004l\r"]
[121.162501, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.162568, "o", "    # Verify correctness\r\n\u001b[?2004l\r\u001b[?2004h> "]
