[731.52617, "o", "\u001b[?2004h> "]
[731.526198, "o", "\r\n\u001b[?2004l\r"]
[731.526451, "o", "\u001b[?2004h>     index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.526632, "o", "    elapsed_time: float\r\n"]
[731.526723, "o", "\u001b[?2004l\r"]
[731.526752, "o", "\u001b[?2004h> "]
[731.526976, "o", "    num_documents: int\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary_size: int\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.527005, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.527038, "o", "\r\n\u001b[?2004l\r"]
[731.52707, "o", "\u001b[?2004h> "]
[731.528659, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Parallel Index Building\r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.528902, "o", "    Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r"]
[731.529057, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r \u001b[?2004h"]
[731.52921, "o", ">     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.52936, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r"]
[731.529428, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.52971, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.52991, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r=\u001b[?2004h> "]
[731.530108, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.530208, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.531086, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.531198, "o", "    for doc in docs_chunk:\r\n\u001b[?2004l\r=\u001b[?2004h>         text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h>         tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h>         tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h>         doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r"]
[731.531315, "o", "\u001b[?2004h> "]
[731.531409, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.531441, "o", "> "]
[731.531615, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[731.531699, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.531996, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.532034, "o", "> \r\n\u001b[?2004l\rh\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[731.53206, "o", "> "]
[731.532218, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.532249, "o", "> "]
[731.532377, "o", "    documents: List[Document],\r\n\u001b[?2004l\r"]
[731.532407, "o", "\u001b[?2004h> "]
[731.532588, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r"]
[731.532672, "o", "\u001b[?2004h> "]
[731.532912, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.533115, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\rs\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.533309, "o", "    Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[731.533447, "o", ">     Steps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.533606, "o", "    1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r"]
[731.533746, "o", "\u001b[?2004h> "]
[731.533829, "o", "    2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.533943, "o", "> "]
[731.534077, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.534147, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.53423, "o", "> "]
[731.534415, "o", "    5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.534496, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[731.53458, "o", "\u001b[?2004h> "]
[731.534739, "o", "        documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.535152, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.535267, "o", "        chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r"]
[731.535819, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.535883, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.536046, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[731.536088, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.53614, "o", "\u001b[?2004h> "]
[731.536278, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.536306, "o", "> "]
[731.536859, "o", "        num_workers = min(mp.cpu_count(), 8)  # Cap at 8 for reasonable overhead\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.53692, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.537102, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[731.537155, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.537181, "o", "     \u001b[?2004h> "]
[731.537441, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.537466, "o", "> "]
[731.537574, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.537603, "o", "    doc_terms = {}\r\n\u001b[?2004l\r"]
[731.537624, "o", "\u001b[?2004h> "]
[731.537705, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[731.537745, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[731.537938, "o", "    # Use provided chunk_size or calculate based on workers\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.537964, "o", "> "]
[731.538159, "o", "    # For good load balancing, aim for 3-4x more chunks than workers\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.538184, "o", "> "]
[731.538291, "o", "    if chunk_size == 500:  # Default value\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.538317, "o", "> "]
[731.538642, "o", "        effective_chunk_size = max(200, len(documents) // (num_workers * 3))\r\n\u001b[?2004l\r"]
[731.538718, "o", "\u001b[?2004h> "]
[731.538765, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.538959, "o", "        effective_chunk_size = chunk_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.539018, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.539043, "o", "    chunks = []\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[731.539075, "o", "> "]
[731.539259, "o", "    for i in range(0, len(documents), effective_chunk_size):\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.53935, "o", "> "]
[731.539431, "o", "        chunks.append(documents[i:i + effective_chunk_size])\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.539519, "o", ">     \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[731.539656, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.539785, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.540058, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.540127, "o", ">         \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[731.540235, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.54026, "o", "> "]
[731.540445, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r"]
[731.54048, "o", "\u001b[?2004h> "]
[731.540624, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r"]
[731.541237, "o", "\u001b[?2004h> "]
[731.541291, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r\u001b[?2004h>             vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r \u001b[?2004h>     index.vocabulary = vocabulary\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Step 2: Calculate document frequencies (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.541315, "o", "> "]
[731.541403, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.541422, "o", "> "]
[731.541665, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.541778, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[731.541827, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rA"]
[731.54185, "o", "\u001b[?2004h> "]
[731.542, "o", "    # Step 3: Compute IDF scores (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.542022, "o", "> "]
[731.542215, "o", "    N = index.num_documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.54232, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[731.542347, "o", "\u001b[?2004h> "]
[731.542504, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.542528, "o", ">     \r\n\u001b[?2004l\r"]
[731.542548, "o", "\u001b[?2004h"]
[731.542568, "o", "> "]
[731.542763, "o", "    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.54279, "o", "> "]
[731.542902, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.542927, "o", "> "]
[731.543018, "o", "        posting_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.543165, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.54319, "o", "> "]
[731.543275, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.543387, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\rd:\u001b[?2004h"]
[731.543409, "o", "> "]
[731.543532, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.543553, "o", "> "]
[731.543706, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[731.54373, "o", "\u001b[?2004h> "]
[731.543894, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.543915, "o", "> "]
[731.544126, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.544151, "o", "    \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[731.544433, "o", "    # Step 5: Build document vectors and compute norms (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.544623, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.544729, "o", "        doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.544821, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.544842, "o", "> "]
[731.544967, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.544992, "o", "> "]
[731.545118, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545144, "o", "> "]
[731.545239, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\rs\u001b[?2004h"]
[731.54526, "o", "> "]
[731.545372, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545397, "o", "> "]
[731.545522, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545547, "o", "> "]
[731.545742, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545766, "o", "> "]
[731.545895, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545916, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.545934, "o", "> "]
[731.546043, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.546115, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.546139, "o", "> "]
[731.546228, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.547332, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[731.547359, "o", "\u001b[?2004h> "]
[731.547788, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.54794, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.547978, "o", "> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[731.548269, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.54842, "o", "# Parallel Search Functions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.548459, "o", "# ============================================================================"]
[731.54849, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.548529, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[731.548565, "o", "\u001b[?2004h> "]
[731.548602, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.54863, "o", "> "]
[731.548675, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.548707, "o", "> "]
[731.548742, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.548774, "o", ">     top_k: int,\r\n\u001b[?2004l\r"]
[731.548806, "o", "\u001b[?2004h> "]
[731.54893, "o", "    doc_titles: dict,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.54902, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549058, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.549093, "o", "\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[731.549167, "o", "\u001b[?2004h> "]
[731.549208, "o", "        query: Search query string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549309, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.549337, "o", "> "]
[731.549436, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549502, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.549569, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.549627, "o", "> "]
[731.549695, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549724, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549815, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.549842, "o", "> "]
[731.549871, "o", "    # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.549961, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550017, "o", "    if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550073, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.550128, "o", ">     \r\n\u001b[?2004l\r"]
[731.550157, "o", "\u001b[?2004h>     # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.550185, "o", "> "]
[731.550316, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.550347, "o", "> "]
[731.550409, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550478, "o", "    query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550559, "o", "    query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550633, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550699, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.55076, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.550788, "o", "> "]
[731.55085, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.550968, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551002, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551032, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551105, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[731.551139, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551205, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551261, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.55129, "o", "> "]
[731.551321, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.551353, "o", "> "]
[731.551419, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551482, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551566, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.551598, "o", "> "]
[731.551672, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.551703, "o", "\u001b[?2004h> "]
[731.551789, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551852, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.551883, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.55198, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552111, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[731.552139, "o", "\u001b[?2004h> "]
[731.552193, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552252, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552316, "o", "        # Dot product\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552341, "o", "        dot_product = sum(\r\n\u001b[?2004l\r"]
[731.552425, "o", "\u001b[?2004h> "]
[731.552503, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552572, "o", "            for term in query_vector\r\n\u001b[?2004l\r"]
[731.552639, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.552702, "o", ">         # Cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552809, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552922, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.552973, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.553021, "o", "> "]
[731.553121, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.553186, "o", "\u001b[?2004h>     # Build result objects\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553252, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.5533, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553349, "o", "        results.append(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553415, "o", "            SearchResult(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553477, "o", "                doc_id=doc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553536, "o", "                score=score,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553608, "o", "                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.553666, "o", ">             )\r\n\u001b[?2004l\r"]
[731.553721, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553764, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[731.553818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553871, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553923, "o", "    queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.553965, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.554011, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.554038, "o", "> "]
[731.554088, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.554165, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.554243, "o", ") -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.554299, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.554345, "o", "> "]
[731.554403, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[731.554456, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.554506, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r"]
[731.554559, "o", "\u001b[?2004h> "]
[731.554612, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.554663, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r"]
[731.55471, "o", "\u001b[?2004h> "]
[731.55478, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r"]
[731.554833, "o", "\u001b[?2004h> "]
[731.554887, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.554942, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.554997, "o", ">     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555045, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r"]
[731.555102, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.555154, "o", "> "]
[731.555205, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555259, "o", "    # Prepare document titles\r\n\u001b[?2004l\r"]
[731.555304, "o", "\u001b[?2004h> "]
[731.555363, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r"]
[731.55542, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.555466, "o", ">     if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555549, "o", "        num_workers = min(mp.cpu_count(), 8)  # Cap at 8\r\n\u001b[?2004l\r"]
[731.555596, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555689, "o", "    # Use significantly more threads to compensate for GIL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555824, "o", "    # Each search is somewhat I/O bound (dict lookups) so threads can help\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.555878, "o", "    thread_workers = num_workers * 4\r\n\u001b[?2004l\r"]
[731.555933, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[731.55598, "o", "> "]
[731.556025, "o", "    # Use ThreadPoolExecutor for better performance with shared memory\r\n\u001b[?2004l\r"]
[731.556084, "o", "\u001b[?2004h> "]
[731.556134, "o", "    results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556188, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556282, "o", "    with ThreadPoolExecutor(max_workers=thread_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.556336, "o", "> "]
[731.556388, "o", "        # Submit all queries\r\n\u001b[?2004l\r\u001b[?2004h>         future_to_idx = {\r\n\u001b[?2004l\r"]
[731.556439, "o", "\u001b[?2004h> "]
[731.556541, "o", "            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.556595, "o", "> "]
[731.556639, "o", "            for idx, query in enumerate(queries)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556713, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556758, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556805, "o", "        # Collect results in order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556873, "o", "        for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.556941, "o", "            idx = future_to_idx[future]\r\n\u001b[?2004l\r"]
[731.556989, "o", "\u001b[?2004h> "]
[731.557033, "o", "            results[idx] = future.result()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.557094, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.557142, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[731.557167, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[731.557219, "o", "\u001b[?2004h> "]
[731.55727, "o", "    return results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.557319, "o", "EOF\r\n\u001b[?2004l\r"]
[731.559162, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[737.247445, "i", "python3 test_large.py\n"]
[737.247662, "o", "python3 test_large.py\r\n\u001b[?2004l\r"]
[737.304072, "o", "============================================================\r\nLarge-Scale Parallel TF-IDF Test\r\n============================================================\r\n"]
[765.538707, "o", "Generated 10000 documents.\r\n\r\nGenerated 10000 documents\r\n\r\nBuilding sequential index...\r\n"]
[770.171048, "o", "Sequential time: 4.592s\r\nVocabulary size: 392\r\n\r\nBuilding parallel index (4 workers)...\r\n"]
[774.632701, "o", "Parallel time: 4.368s\r\nVocabulary size: 392\r\n\r\nIndex building speedup: 1.05x\r\n✗ Index speedup target not met: 1.05x < 1.5x\r\n\r\n============================================================\r\nTesting batch search with 400 queries...\r\n\r\nSequential batch search..."]
[774.632863, "o", "\r\n"]
[776.364583, "o", "Sequential time: 1.732s\r\n\r\nParallel batch search (4 workers)...\r\n"]
[778.068655, "o", "Parallel time: 1.703s\r\n\r\nBatch search speedup: 1.02x\r\n\r\nVerifying correctness (first 5 queries)...\r\n✓ Correctness verified\r\n✗ Search speedup target not met: 1.02x < 2.0x\r\n\r\n============================================================\r\nSummary:\r\n  Index building: 1.05x (target: 1.5x)\r\n  Batch search:   1.02x (target: 2.0x)\r\n============================================================\r\n"]
[778.432616, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[842.320107, "i", "cat > parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\nimport multiprocessing as mp\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    \"\"\"\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    \"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    \"\"\"\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Merge results and calculate document frequencies\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores\n    5. Compute document vector norms for cosine similarity\n    \n    Args:\n        documents: List of Document objects to index\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    # Determine number of workers\n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Calculate optimal chunk size\n    # Use smaller chunks for better load balancing (aim for 4-5x more chunks than workers)\n    if chunk_size == 500:  # Using default\n        effective_chunk_size = max(100, len(documents) // (num_workers * 4))\n    else:\n        effective_chunk_size = chunk_size\n    \n    chunks = []\n    for i in range(0, len(documents), effective_chunk_size):\n        chunks.append(documents[i:i + effective_chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    \n    # Step 2: Calculate document frequencies (sequential - fast)\n    for term in index.vocabulary:\n        df = sum(1 for doc_i"]
[842.320184, "i", "d in doc_terms if term in doc_terms[doc_id])\n        index.document_frequencies[term] = df\n    \n    # Step 3: Compute IDF scores (sequential - fast)\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\n    for term in index.vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * index.idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        index.inverted_index[term] = posting_list\n    \n    # Step 5: Build document vectors and compute norms (sequential - fast)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_single_query(\n    query: str,\n    index: TFIDFIndex,\n    top_k: int,\n    doc_titles: dict,\n) -> List[SearchResult]:\n    \"\"\"\n    Search for documents similar to a single query.\n    \n    Args:\n        query: Search query string\n        index: TF-IDF index to search\n        top_k: Number of top results to return\n        doc_titles: Dictionary mapping doc_id to title\n    \n    Returns:\n        List of SearchResult objects sorted by relevance\n    \"\"\"\n    from heapq import nlargest\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity for each candidate\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        # Dot product\n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        # Cosine similarity\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        results.append(\n            SearchResult(\n                doc_id=doc_id,\n                score=score,\n                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\n            )\n        )\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[L"]
[842.320227, "i", "ist[List[SearchResult]], float]:\n    \"\"\"\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    # Use many more threads to compensate for GIL\n    # Threading allows sharing the index without serialization overhead\n    thread_workers = num_workers * 8\n    \n    # Use ThreadPoolExecutor for better performance with shared memory\n    results = [None] * len(queries)  # Preserve order\n    \n    with ThreadPoolExecutor(max_workers=thread_workers) as executor:\n        # Submit all queries\n        future_to_idx = {\n            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\n            for idx, query in enumerate(queries)\n        }\n        \n        # Collect results in order\n        for future in as_completed(future_to_idx):\n            idx = future_to_idx[future]\n            results[idx] = future.result()\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return results, elapsed\nEOF\n"]
