[121.161759, "o", "    print(f\"Sequential time: {seq_time:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.161828, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Parallel search\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.161909, "o", "> "]
