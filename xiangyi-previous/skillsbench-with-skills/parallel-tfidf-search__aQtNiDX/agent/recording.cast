[121.164091, "o", "    print(\"Parallel TF-IDF Implementation Test\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.164154, "o", ">     print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.164208, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.164327, "o", "        seq_result, par_result, documents = test_index_building()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.164442, "o", "        test_batch_search(seq_result, par_result, documents)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[121.164492, "o", "\u001b[?2004h> "]
