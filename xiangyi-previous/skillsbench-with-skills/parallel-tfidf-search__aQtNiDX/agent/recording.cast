[842.324326, "o", "import multiprocessing as mp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from sequential import (\r\n\u001b[?2004l\r\u001b[?2004h>     TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     SearchResult,\r\n\u001b[?2004l\r\u001b[?2004h>     tokenize,\r\n\u001b[?2004l\r\u001b[?2004h>     compute_term_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> from document_generator import Document\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
