[842.322026, "o", "\u001b[?2004h> "]
[842.322094, "o", "import math\r\n\u001b[?2004l\r"]
[842.322119, "o", "\u001b[?2004h> "]
[842.322175, "o", "import time\r\n\u001b[?2004l\r"]
