[135.197851, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[183.032364, "i", "cat > parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    \"\"\"\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    \"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    \"\"\"\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Merge results and calculate document frequencies\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores\n    5. Compute document vector norms for cosine similarity\n    \n    Args:\n        documents: List of Document objects to index\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Split documents into chunks\n    chunks = []\n    for i in range(0, len(documents), chunk_size):\n        chunks.append(documents[i:i + chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    \n    # Step 2: Calculate document frequencies\n    for term in index.vocabulary:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        index.document_frequencies[term] = df\n    \n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores\n    for term in index.vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n        "]
[183.03243, "i", "    if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * index.idf[term]\n                posting_list.append((doc_id, tfidf))\n        # Sort by score descending for efficient top-k retrieval\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        index.inverted_index[term] = posting_list\n    \n    # Step 5: Build document vectors and compute norms\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_single_query(\n    query: str,\n    index: TFIDFIndex,\n    top_k: int,\n    doc_titles: dict,\n) -> List[SearchResult]:\n    \"\"\"\n    Search for documents similar to a single query.\n    \n    Args:\n        query: Search query string\n        index: TF-IDF index to search\n        top_k: Number of top results to return\n        doc_titles: Dictionary mapping doc_id to title\n    \n    Returns:\n        List of SearchResult objects sorted by relevance\n    \"\"\"\n    from heapq import nlargest\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity for each candidate\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        # Dot product\n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        # Cosine similarity\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        results.append(\n            SearchResult(\n                doc_id=doc_id,\n                score=score,\n                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\n            )\n        )\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    \"\"\"\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n   "]
[183.032596, "i", " \"\"\"\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    # For small number of queries, threading is better due to lower overhead\n    # Use ThreadPoolExecutor instead of ProcessPoolExecutor\n    results = [None] * len(queries)  # Preserve order\n    \n    with ThreadPoolExecutor(max_workers=num_workers) as executor:\n        # Submit all queries\n        future_to_idx = {\n            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\n            for idx, query in enumerate(queries)\n        }\n        \n        # Collect results in order\n        for future in as_completed(future_to_idx):\n            idx = future_to_idx[future]\n            results[idx] = future.result()\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return results, elapsed\nEOF\n"]
[183.032734, "o", "cat > parallel_solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[183.032776, "o", "\u001b[?2004h> "]
[183.032885, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[183.032954, "o", "\u001b[?2004h> \"\"\""]
[183.032983, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.033097, "o", "Parallel TF-IDF Implementation\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.033127, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h"]
[183.033186, "o", "> "]
[183.033356, "o", "This module provides parallel implementations of:\r\n\u001b[?2004l\r"]
[183.033407, "o", "\u001b[?2004h> "]
[183.033633, "o", "1. TF-IDF index building with parallel document processing\r\n\u001b[?2004l\r"]
[183.033658, "o", "\u001b[?2004h> "]
[183.033854, "o", "2. Batch search with parallel query processing\r\n\u001b[?2004l\r"]
[183.033909, "o", "\u001b[?2004h> "]
[183.033934, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.033959, "o", "> "]
[183.034034, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.034091, "o", "import time\r\n\u001b[?2004l\r"]
[183.03414, "o", "\u001b[?2004h> "]
[183.034326, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[183.034355, "o", "\u001b[?2004h> "]
[183.034839, "o", "from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\r\n\u001b[?2004l\r"]
[183.034868, "o", "\u001b[?2004h> "]
[183.035047, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r"]
[183.035079, "o", "\u001b[?2004h> "]
[183.03528, "o", "from typing import List, Optional, Tuple\r\n\u001b[?2004l\r"]
[183.035307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[183.035359, "o", "\u001b[?2004h> "]
[183.035487, "o", "from sequential import (\r\n\u001b[?2004l\r"]
[183.035532, "o", "\u001b[?2004h> "]
[183.035583, "o", "    TFIDFIndex,\r\n\u001b[?2004l\r"]
[183.035634, "o", "\u001b[?2004h> "]
[183.035678, "o", "    SearchResult,\r\n\u001b[?2004l\r "]
[183.03573, "o", "\u001b[?2004h> "]
[183.03578, "o", "    tokenize,\r\n\u001b[?2004l\r"]
[183.035806, "o", "\u001b[?2004h> "]
[183.035918, "o", "    compute_term_frequencies,\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.035973, "o", "> )\r\n\u001b[?2004l\r"]
[183.036001, "o", "\u001b[?2004h> "]
[183.036129, "o", "from document_generator import Document\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.036209, "o", "> \r\n\u001b[?2004l\r"]
[183.036264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.036521, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[183.036545, "o", "\u001b[?2004h> "]
[183.036621, "o", "# Data Structures\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.036658, "o", "> "]
[183.036963, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[183.036992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[183.037051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[183.037114, "o", "@dataclass\r\n\u001b[?2004l\r"]
[183.037166, "o", "\u001b[?2004h> "]
[183.03725, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[183.037301, "o", "\u001b[?2004h> "]
[183.037458, "o", "    \"\"\"Result from parallel index building.\"\"\"\r\n\u001b[?2004l\r"]
[183.037511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[183.037547, "o", "\u001b[?2004h> "]
[183.037622, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r"]
[183.03765, "o", "\u001b[?2004h> "]
[183.037763, "o", "    elapsed_time: float\r\n\u001b[?2004l\r"]
[183.037789, "o", "\u001b[?2004h> "]
[183.037866, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[183.037918, "o", "\u001b[?2004h> "]
[183.038016, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[183.038063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)"]
[183.038107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.038157, "o", "> "]
[183.038499, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[183.038525, "o", "\u001b[?2004h> "]
[183.038638, "o", "# Parallel Index Building\r\n\u001b[?2004l\r"]
[183.038692, "o", "\u001b[?2004h> "]
[183.038923, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[183.038948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r="]
[183.038996, "o", "\u001b[?2004h"]
[183.039046, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.039415, "o", "def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r"]
[183.03944, "o", "\u001b[?2004h> "]
[183.039508, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[183.03955, "o", "\u001b[?2004h> "]
[183.03978, "o", "    Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r"]
[183.039827, "o", "\u001b[?2004h> "]
[183.039878, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.039924, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.039947, "o", "> "]
[183.040183, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r"]
[183.04021, "o", "\u001b[?2004h> "]
[183.040236, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.040268, "o", "> "]
[183.040364, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.040582, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r"]
[183.040638, "o", "\u001b[?2004h> "]
[183.040708, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.040757, "o", "> "]
[183.040826, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r"]
[183.040869, "o", "\u001b[?2004h> "]
[183.040967, "o", "    doc_terms = {}\r\n\u001b[?2004l\r"]
[183.041015, "o", "\u001b[?2004h> "]
[183.041106, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[183.041157, "o", "\u001b[?2004h> "]
[183.041199, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.04137, "o", "    for doc in docs_chunk:\r\n\u001b[?2004l\r"]
[183.041421, "o", "\u001b[?2004h> "]
[183.041623, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r"]
[183.041666, "o", "\u001b[?2004h> "]
[183.041815, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r"]
[183.041859, "o", "\u001b[?2004h> "]
[183.042127, "o", "        tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r"]
[183.042191, "o", "\u001b[?2004h> "]
[183.042376, "o", "        doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r"]
[183.042431, "o", "\u001b[?2004h> "]
[183.042677, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r"]
[183.042735, "o", "\u001b[?2004h> "]
[183.0429, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[183.04295, "o", "\u001b[?2004h> "]
[183.042977, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.043217, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r"]
[183.043241, "o", "\u001b[?2004h"]
[183.043312, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.043365, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[183.043485, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r"]
[183.043529, "o", "\u001b[?2004h> "]
[183.043645, "o", "    documents: List[Document],\r\n\u001b[?2004l\r"]
[183.043692, "o", "\u001b[?2004h> "]
[183.043838, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r"]
[183.043889, "o", "\u001b[?2004h> "]
[183.043986, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r"]
[183.044014, "o", "\u001b[?2004h> "]
[183.044165, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[183.044192, "o", "\u001b[?2004h> "]
[183.044239, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[183.04429, "o", "\u001b[?2004h> "]
[183.044504, "o", "    Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r"]
[183.044528, "o", "\u001b[?2004h> "]
[183.044577, "o", "    \r\n\u001b[?2004l\r"]
[183.044605, "o", "\u001b[?2004h> "]
[183.044675, "o", "    Steps:\r\n\u001b[?2004l\r"]
[183.044703, "o", "\u001b[?2004h> "]
[183.044985, "o", "    1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.045013, "o", "> "]
[183.045206, "o", "    2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r"]
[183.045263, "o", "\u001b[?2004h> "]
[183.04538, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r"]
[183.045404, "o", "\u001b[?2004h> "]
[183.04564, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r"]
[183.045668, "o", "\u001b[?2004h> "]
[183.045989, "o", "    5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r"]
[183.046013, "o", "\u001b[?2004h> "]
[183.046094, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.046152, "o", ">     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.046356, "o", "        documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.046405, "o", "> "]
[183.046744, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r"]
[183.046775, "o", "\u001b[?2004h> "]
[183.046943, "o", "        chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r \u001b[?2004h"]
[183.046967, "o", ">     \r\n\u001b[?2004l\r"]
[183.046992, "o", "\u001b[?2004h> "]
[183.047071, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.047118, "o", "> "]
[183.047305, "o", "        ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r}\u001b[?2004h"]
[183.047329, "o", ">     \"\"\""]
[183.047354, "o", "\r\n\u001b[?2004l\r"]
[183.047384, "o", "\u001b[?2004h> "]
[183.047572, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[183.047621, "o", "\u001b[?2004h>     \r\n"]
[183.047649, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.047735, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r"]
[183.047782, "o", "\u001b[?2004h> "]
[183.047999, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[183.048023, "o", "\u001b[?2004h> "]
[183.048098, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.048438, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r"]
[183.048467, "o", "\u001b[?2004h> "]
[183.048547, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.048591, "o", "> "]
[183.048666, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.048718, "o", "> "]
[183.048813, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[183.048866, "o", "\u001b[?2004h> "]
[183.048894, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.04909, "o", "    # Split documents into chunks\r\n\u001b[?2004l\r"]
[183.049116, "o", "\u001b[?2004h> "]
[183.049195, "o", "    chunks = []\r\n\u001b[?2004l\r"]
[183.04924, "o", "\u001b[?2004h> "]
[183.04945, "o", "    for i in range(0, len(documents), chunk_size):\r\n\u001b[?2004l\r"]
[183.049482, "o", "\u001b[?2004h> "]
[183.049689, "o", "        chunks.append(documents[i:i + chunk_size])\r\n\u001b[?2004l\r"]
[183.049739, "o", "\u001b[?2004h> "]
[183.049768, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.049911, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r"]
[183.049936, "o", "\u001b[?2004h> "]
[183.050214, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[183.050265, "o", "\u001b[?2004h> "]
[183.050722, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r"]
[183.050773, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[183.050828, "o", "\u001b[?2004h> "]
[183.050991, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[183.051016, "o", "\u001b[?2004h> "]
[183.051432, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r"]
[183.051457, "o", "\u001b[?2004h> "]
[183.051667, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r"]
[183.051719, "o", "\u001b[?2004h> "]
[183.051871, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[183.051895, "o", "\u001b[?2004h> "]
[183.05212, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r"]
[183.052148, "o", "\u001b[?2004h> "]
[183.052171, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.052246, "o", "> "]
[183.052355, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[183.052388, "o", "\u001b[?2004h> "]
[183.052441, "o", "    \r\n\u001b[?2004l\r"]
[183.052469, "o", "\u001b[?2004h> "]
[183.052695, "o", "    # Step 2: Calculate document frequencies\r\n\u001b[?2004l\r] ="]
[183.052724, "o", "\u001b[?2004h> "]
[183.0529, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[183.052925, "o", "\u001b[?2004h"]
[183.052948, "o", "> "]
[183.053338, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[183.053367, "o", "\u001b[?2004h> "]
[183.053555, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[183.053618, "o", "\u001b[?2004h> "]
[183.053663, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.053826, "o", "    # Step 3: Compute IDF scores\r\n\u001b[?2004l\r"]
[183.053876, "o", "\u001b[?2004h> "]
[183.05396, "o", "    N = index.num_documents\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.053984, "o", "> "]
[183.054214, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[183.05426, "o", "\u001b[?2004h> "]
[183.054423, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[183.054476, "o", "\u001b[?2004h> "]
[183.054518, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.054728, "o", "    # Step 4: Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r"]
[183.054751, "o", "\u001b[?2004h> "]
[183.054891, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[183.054936, "o", "\u001b[?2004h> "]
[183.055017, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[183.055064, "o", "\u001b[?2004h> "]
[183.055263, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[183.055312, "o", "\u001b[?2004h> "]
[183.055429, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[183.055477, "o", "\u001b[?2004h> "]
[183.0556, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[183.055626, "o", "\u001b[?2004h> "]
[183.055773, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r:"]
[183.055798, "o", "\u001b[?2004h> "]
[183.056015, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[183.056041, "o", "\u001b[?2004h> "]
[183.056301, "o", "        # Sort by score descending for efficient top-k retrieval\r\n\u001b[?2004l\r"]
[183.056328, "o", "\u001b[?2004h> "]
[183.056558, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.056619, "o", "> "]
[183.056751, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r"]
[183.056778, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[183.056836, "o", "\u001b[?2004h> "]
[183.057043, "o", "    # Step 5: Build document vectors and compute norms\r\n\u001b[?2004l\r"]
[183.057069, "o", "\u001b[?2004h> "]
[183.057251, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[183.057274, "o", "\u001b[?2004h> "]
[183.057362, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[183.05739, "o", "\u001b[?2004h> "]
[183.057497, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[183.057552, "o", "\u001b[?2004h> "]
[183.057682, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[183.057705, "o", "\u001b[?2004h"]
[183.05773, "o", "> "]
[183.05788, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[183.057905, "o", "\u001b[?2004h> "]
[183.058071, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.05812, "o", "> "]
[183.058245, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[183.05827, "o", "\u001b[?2004h> "]
[183.058479, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[183.058502, "o", "\u001b[?2004h> "]
[183.058735, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[183.058762, "o", "\u001b[?2004h> "]
[183.058832, "o", "    \r\n\u001b[?2004l\r"]
[183.058876, "o", "\u001b[?2004h> "]
[183.058988, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.059042, "o", ">     \r\n\u001b[?2004l\r"]
[183.059085, "o", "\u001b[?2004h> "]
[183.059196, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[183.059249, "o", "\u001b[?2004h> "]
[183.059288, "o", "        index=index,\r\n\u001b[?2004l\r"]
[183.059327, "o", "\u001b[?2004h> "]
[183.05944, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r"]
[183.059488, "o", "\u001b[?2004h> "]
[183.059559, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[183.059614, "o", "\u001b[?2004h> "]
[183.059703, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r"]
[183.059747, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[183.059794, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.059849, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[183.059904, "o", "> "]
[183.060054, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.060135, "o", "# Parallel Search Functions\r\n\u001b[?2004l\r"]
[183.06019, "o", "\u001b[?2004h> "]
[183.060378, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.060431, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[183.060481, "o", "\u001b[?2004h> "]
[183.060527, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.060574, "o", "> "]
[183.060627, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.060687, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r"]
[183.060742, "o", "\u001b[?2004h> "]
[183.060797, "o", "    top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.060843, "o", "    doc_titles: dict,\r\n\u001b[?2004l\r"]
[183.060894, "o", "\u001b[?2004h> "]
[183.060934, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r"]
[183.060983, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[183.061029, "o", "\u001b[?2004h> "]
[183.061159, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.061187, "o", "> "]
[183.061236, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[183.061299, "o", "\u001b[?2004h> "]
[183.061371, "o", "        query: Search query string\r\n\u001b[?2004l\r"]
[183.061417, "o", "\u001b[?2004h> "]
[183.061508, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.06156, "o", "> "]
[183.061639, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r"]
[183.061692, "o", "\u001b[?2004h> "]
[183.061806, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r"]
[183.061832, "o", "\u001b[?2004h> "]
[183.061882, "o", "    \r\n\u001b[?2004l\r"]
[183.061941, "o", "\u001b[?2004h>     Returns:\r\n"]
[183.061989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.062102, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r"]
[183.062143, "o", "\u001b[?2004h>     \"\"\"\r\n"]
[183.062185, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.062267, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r"]
[183.062316, "o", "\u001b[?2004h> "]
[183.062367, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.062405, "o", "    # Tokenize query\r\n\u001b[?2004l\r"]
[183.062452, "o", "\u001b[?2004h> "]
[183.062534, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[183.062582, "o", "\u001b[?2004h> "]
[183.062628, "o", "    if not query_tokens:\r\n\u001b[?2004l\r"]
[183.062681, "o", "\u001b[?2004h> "]
[183.062722, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.062747, "o", "    \r\n\u001b[?2004l\r"]
[183.062794, "o", "\u001b[?2004h> "]
[183.062858, "o", "    # Compute query TF\r\n\u001b[?2004l\r"]
[183.062907, "o", "\u001b[?2004h> "]
[183.063011, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.063054, "o", ">     \r\n\u001b[?2004l\r"]
[183.063103, "o", "\u001b[?2004h> "]
[183.063162, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r"]
[183.063209, "o", "\u001b[?2004h> "]
[183.06325, "o", "    query_vector = {}\r\n\u001b[?2004l\r"]
[183.063303, "o", "\u001b[?2004h> "]
[183.063361, "o", "    query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.063408, "o", "> "]
[183.063484, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[183.063532, "o", "\u001b[?2004h> "]
[183.063583, "o", "        if term in index.idf:\r\n\u001b[?2004l\r"]
[183.063635, "o", "\u001b[?2004h> "]
[183.063715, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[183.063762, "o", "\u001b[?2004h> "]
[183.06386, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.063914, "o", "> "]
[183.063989, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[183.064016, "o", "\u001b[?2004h> "]
[183.06404, "o", "    \r\n\u001b[?2004l\r"]
[183.064094, "o", "\u001b[?2004h> "]
[183.064166, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.064233, "o", "> "]
[183.064289, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.064398, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r"]
[183.064449, "o", "\u001b[?2004h> "]
[183.064503, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.064549, "o", "    # Find candidate documents\r\n\u001b[?2004l\r"]
[183.064599, "o", "\u001b[?2004h> "]
[183.0647, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.064783, "o", "    for term in query_vector:\r\n\u001b[?2004l\r"]
[183.064833, "o", "\u001b[?2004h> "]
[183.064913, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r"]
[183.064966, "o", "\u001b[?2004h> "]
[183.065087, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[183.06514, "o", "\u001b[?2004h> "]
[183.065226, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[183.065278, "o", "\u001b[?2004h>     \r\n"]
[183.065329, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.065445, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r"]
[183.065498, "o", "\u001b[?2004h> "]
[183.065551, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.065601, "o", "> "]
[183.065645, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[183.065691, "o", "\u001b[?2004h> "]
[183.065815, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r"]
[183.065864, "o", "\u001b[?2004h> "]
[183.065976, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r"]
[183.066019, "o", "\u001b[?2004h> "]
[183.066065, "o", "        \r\n\u001b[?2004l\r"]
[183.066115, "o", "\u001b[?2004h> "]
[183.066163, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r"]
[183.066217, "o", "\u001b[?2004h> "]
[183.066263, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.066288, "o", "        \r\n\u001b[?2004l\r"]
[183.066334, "o", "\u001b[?2004h> "]
[183.066389, "o", "        # Dot product\r\n\u001b[?2004l\r"]
[183.066436, "o", "\u001b[?2004h> "]
[183.066484, "o", "        dot_product = sum(\r\n\u001b[?2004l\r"]
[183.066535, "o", "\u001b[?2004h> "]
[183.066675, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r"]
[183.066722, "o", "\u001b[?2004h> "]
[183.066804, "o", "            for term in query_vector\r\n\u001b[?2004l\r"]
[183.066853, "o", "\u001b[?2004h> "]
[183.06688, "o", "        )\r\n\u001b[?2004l\r"]
[183.066925, "o", "\u001b[?2004h> "]
[183.066973, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.067044, "o", "        # Cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.067094, "o", "> "]
[183.067209, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[183.067265, "o", "\u001b[?2004h> "]
[183.067364, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[183.067412, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[183.067458, "o", "\u001b[?2004h> "]
[183.0675, "o", "    # Get top-k results\r\n\u001b[?2004l\r"]
[183.067548, "o", "\u001b[?2004h> "]
[183.067687, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[183.067743, "o", "\u001b[?2004h> "]
[183.067795, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.067837, "o", "    # Build result objects\r\n\u001b[?2004l\r"]
[183.067884, "o", "\u001b[?2004h> "]
[183.067935, "o", "    results = []\r\n\u001b[?2004l\r"]
[183.067985, "o", "\u001b[?2004h> "]
[183.068046, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[183.068093, "o", "\u001b[?2004h> "]
[183.068154, "o", "        results.append(\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.068211, "o", "> "]
[183.06826, "o", "            SearchResult(\r\n\u001b[?2004l\r"]
[183.068315, "o", "\u001b[?2004h> "]
[183.06836, "o", "                doc_id=doc_id,\r\n"]
[183.068409, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.068482, "o", "                score=score,\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.068535, "o", "> "]
[183.06869, "o", "                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r"]
[183.068742, "o", "\u001b[?2004h> "]
[183.068792, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.068839, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.068893, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.068935, "o", "    return results\r\n\u001b[?2004l\r"]
[183.06898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[183.069029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.069088, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r"]
[183.069143, "o", "\u001b[?2004h> "]
[183.069183, "o", "    queries: List[str],\r\n\u001b[?2004l\r"]
[183.069235, "o", "\u001b[?2004h> "]
[183.069278, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r"]
[183.069324, "o", "\u001b[?2004h> "]
[183.069376, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r"]
[183.069428, "o", "\u001b[?2004h> "]
[183.069501, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r"]
[183.069552, "o", "\u001b[?2004h> "]
[183.069654, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r"]
[183.069705, "o", "\u001b[?2004h> "]
[183.069801, "o", ") -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r"]
[183.069848, "o", "\u001b[?2004h> "]
[183.0699, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.069941, "o", "> "]
[183.070008, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r"]
[183.070055, "o", "\u001b[?2004h> "]
[183.070106, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.070159, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.070207, "o", "> "]
[183.070272, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r"]
[183.070318, "o", "\u001b[?2004h> "]
[183.070405, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r"]
[183.070458, "o", "\u001b[?2004h> "]
[183.070554, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r"]
[183.0706, "o", "\u001b[?2004h> "]
[183.070757, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r"]
[183.070804, "o", "\u001b[?2004h> "]
[183.070944, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r"]
[183.070974, "o", "\u001b[?2004h> "]
[183.071038, "o", "    \r\n\u001b[?2004l\r"]
[183.071069, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[183.071115, "o", "\u001b[?2004h> "]
[183.071229, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r"]
[183.071282, "o", "\u001b[?2004h> "]
[183.071333, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.071415, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[183.071468, "o", "\u001b[?2004h>     \r\n"]
[183.071519, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[183.071573, "o", "    # Prepare document titles\r\n\u001b[?2004l\r"]
[183.071624, "o", "\u001b[?2004h> "]
[183.071796, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r"]
[183.071841, "o", "\u001b[?2004h> "]
[183.07189, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.072077, "o", "    # For small number of queries, threading is better due to lower overhead\r\n\u001b[?2004l\r"]
[183.072134, "o", "\u001b[?2004h> "]
[183.072257, "o", "    # Use ThreadPoolExecutor instead of ProcessPoolExecutor\r\n\u001b[?2004l\r"]
[183.07231, "o", "\u001b[?2004h> "]
[183.072429, "o", "    results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r"]
[183.072477, "o", "\u001b[?2004h> "]
[183.072527, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.07269, "o", "    with ThreadPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.072746, "o", "> "]
[183.072785, "o", "        # Submit all queries\r\n\u001b[?2004l\r"]
[183.072837, "o", "\u001b[?2004h> "]
[183.072885, "o", "        future_to_idx = {\r\n\u001b[?2004l\r"]
[183.072933, "o", "\u001b[?2004h> "]
[183.073157, "o", "            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[183.073185, "o", "> "]
[183.073295, "o", "            for idx, query in enumerate(queries)\r\n\u001b[?2004l\r"]
[183.073354, "o", "\u001b[?2004h> "]
[183.073396, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.073444, "o", "        \r\n\u001b[?2004l\r"]
[183.073493, "o", "\u001b[?2004h> "]
[183.073539, "o", "        # Collect results in order\r\n\u001b[?2004l\r"]
[183.073585, "o", "\u001b[?2004h> "]
[183.073706, "o", "        for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r"]
[183.073751, "o", "\u001b[?2004h> "]
[183.073828, "o", "            idx = future_to_idx[future]\r\n\u001b[?2004l\r"]
[183.073881, "o", "\u001b[?2004h> "]
[183.073973, "o", "            results[idx] = future.result()\r\n\u001b[?2004l\r"]
[183.074, "o", "\u001b[?2004h> "]
[183.074047, "o", "    \r\n\u001b[?2004l\r"]
[183.074101, "o", "\u001b[?2004h> "]
[183.074172, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[183.074219, "o", "\u001b[?2004h> "]
[183.074267, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[183.074334, "o", "    return results, elapsed\r\n\u001b[?2004l\r"]
[183.07439, "o", "\u001b[?2004h> EOF\r\n"]
[183.074441, "o", "\u001b[?2004l\r"]
[183.075882, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[203.072586, "i", "cat > test_parallel2.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Test script for parallel TF-IDF implementation with more queries.\"\"\"\n\nimport sys\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef test_with_many_queries():\n    print(\"=\"*60)\n    print(\"Parallel TF-IDF Implementation Test (Many Queries)\")\n    print(\"=\"*60)\n    \n    # Generate test corpus\n    documents = generate_corpus(2000, seed=42)\n    print(f\"\\nGenerated {len(documents)} documents\")\n    \n    # Build sequential index\n    print(\"\\nBuilding sequential index...\")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f\"Sequential time: {seq_result.elapsed_time:.3f}s\")\n    \n    # Build parallel index\n    print(\"\\nBuilding parallel index (4 workers)...\")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4, chunk_size=500)\n    print(f\"Parallel time: {par_result.elapsed_time:.3f}s\")\n    speedup = seq_result.elapsed_time / par_result.elapsed_time\n    print(f\"Speedup: {speedup:.2f}x\")\n    \n    # Create many test queries\n    query_templates = [\n        \"machine learning algorithms\",\n        \"data science analysis\",\n        \"artificial intelligence\",\n        \"deep neural networks\",\n        \"computer vision systems\",\n        \"natural language processing\",\n        \"reinforcement learning agents\",\n        \"statistical models\",\n        \"database management systems\",\n        \"cloud computing infrastructure\",\n        \"software engineering practices\",\n        \"web development frameworks\",\n        \"mobile application design\",\n        \"network security protocols\",\n        \"distributed systems architecture\",\n        \"algorithm optimization techniques\",\n    ]\n    \n    # Repeat queries to create a larger batch\n    queries = query_templates * 10  # 160 queries\n    \n    print(f\"\\n\" + \"=\"*60)\n    print(f\"Testing batch search with {len(queries)} queries...\")\n    \n    # Sequential search\n    print(\"\\nSequential batch search...\")\n    import time\n    start = time.perf_counter()\n    seq_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_time = time.perf_counter() - start\n    print(f\"Sequential time: {seq_time:.3f}s\")\n    \n    # Parallel search\n    print(\"\\nParallel batch search (4 workers)...\")\n    par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    print(f\"Parallel time: {par_time:.3f}s\")\n    \n    # Check speedup\n    speedup = seq_time / par_time\n    print(f\"\\nSpeedup: {speedup:.2f}x\")\n    \n    # Verify correctness for first few queries\n    print(\"\\nVerifying correctness (first 10 queries)...\")\n    for i in range(min(10, len(queries))):\n        seq_res = seq_results[i]\n        par_res = par_results[i]\n        assert len(seq_res) == len(par_res), f\"Query {i} result count mismatch\"\n        for j, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f\"Query {i}, result {j}: doc_id mismatch\"\n            assert abs(s.score - p.score) < 1e-9, f\"Query {i}, result {j}: score mismatch\"\n    \n    print(\"✓ Correctness verified\")\n    \n    if speedup >= 2.0:\n        print(f\"✓ Speedup target met: {speedup:.2f}x >= 2.0x\")\n    else:\n        print(f\"✗ Speedup target not met: {speedup:.2f}x < 2.0x\")\n    \n    return speedup >= 2.0\n\nif __name__ == \"__main__\":\n    success = test_with_many_queries()\n    sys.exit(0 if success else 1)\nEOF\n"]
