[121.164661, "o", "        print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.164733, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.164784, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
