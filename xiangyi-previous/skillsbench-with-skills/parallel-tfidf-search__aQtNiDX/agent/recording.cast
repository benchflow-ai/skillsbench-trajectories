[121.162887, "o", "    for i, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.16304, "o", "        assert len(seq_res) == len(par_res), f\"Query {i} result count mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.16313, "o", "        for j, (s, p) in enumerate(zip(seq_res, par_res)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.163278, "o", "            assert s.doc_id == p.doc_id, f\"Query {i}, result {j}: doc_id mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.163444, "o", "            assert abs(s.score - p.score) < 1e-9, f\"Query {i}, result {j}: score mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[121.163506, "o", "\u001b[?2004h> "]
[121.163566, "o", "    print(\"✓ Batch search correctness verified\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.163613, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     if speedup >= 2.0:\r\n\u001b[?2004l\r"]
[121.163664, "o", "\u001b[?2004h> "]
[121.163744, "o", "        print(f\"✓ Speedup target met: {speedup:.2f}x >= 2.0x\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.163798, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
