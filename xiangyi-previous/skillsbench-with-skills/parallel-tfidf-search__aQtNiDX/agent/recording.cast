[842.321012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.32131, "o", "This module provides parallel implementations of:\r\n\u001b[?2004l\r"]
[842.321336, "o", "\u001b[?2004h> "]
[842.321651, "o", "1. TF-IDF index building with parallel document processing\r\n\u001b[?2004l\r"]
[842.321672, "o", "\u001b[?2004h"]
[842.321708, "o", "> "]
[842.321914, "o", "2. Batch search with parallel query processing\r\n\u001b[?2004l\r"]
