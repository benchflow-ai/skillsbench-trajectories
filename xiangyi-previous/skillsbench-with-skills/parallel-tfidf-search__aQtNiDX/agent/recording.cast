[343.370242, "i", "cat > parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\nimport multiprocessing as mp\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    \"\"\"\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    \"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    \"\"\"\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Merge results and calculate document frequencies\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores\n    5. Compute document vector norms for cosine similarity\n    \n    Args:\n        documents: List of Document objects to index\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Optimize chunk size: aim for 2-4x more chunks than workers for load balancing\n    optimal_chunk_size = max(100, len(documents) // (num_workers * 3))\n    if chunk_size > optimal_chunk_size:\n        chunk_size = optimal_chunk_size\n    \n    chunks = []\n    for i in range(0, len(documents), chunk_size):\n        chunks.append(documents[i:i + chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    \n    # Step 2: Calculate document frequencies (sequential - fast)\n    for term in index.vocabulary:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        index.document_frequencies[term] = df\n    \n    # Step 3: Compute"]
[343.3703, "i", " IDF scores (sequential - fast)\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\n    for term in index.vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * index.idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        index.inverted_index[term] = posting_list\n    \n    # Step 5: Build document vectors and compute norms (sequential - fast)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_single_query(\n    query: str,\n    index: TFIDFIndex,\n    top_k: int,\n    doc_titles: dict,\n) -> List[SearchResult]:\n    \"\"\"\n    Search for documents similar to a single query.\n    \n    Args:\n        query: Search query string\n        index: TF-IDF index to search\n        top_k: Number of top results to return\n        doc_titles: Dictionary mapping doc_id to title\n    \n    Returns:\n        List of SearchResult objects sorted by relevance\n    \"\"\"\n    from heapq import nlargest\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity for each candidate\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        # Dot product\n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        # Cosine similarity\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        results.append(\n            SearchResult(\n                doc_id=doc_id,\n                score=score,\n                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\n            )\n        )\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    \"\"\"\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries:"]
[343.370364, "i", " List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    # Use ThreadPoolExecutor for better performance with shared memory\n    # Threads avoid serialization overhead and can share the index efficiently\n    results = [None] * len(queries)  # Preserve order\n    \n    with ThreadPoolExecutor(max_workers=num_workers) as executor:\n        # Submit all queries\n        future_to_idx = {\n            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\n            for idx, query in enumerate(queries)\n        }\n        \n        # Collect results in order\n        for future in as_completed(future_to_idx):\n            idx = future_to_idx[future]\n            results[idx] = future.result()\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return results, elapsed\nEOF\n"]
[343.370626, "o", "cat > parallel_solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[343.370688, "o", "\u001b[?2004h> "]
[343.370805, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[343.37087, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[343.370922, "o", "\u001b[?2004h> "]
[343.370982, "o", "Parallel TF-IDF Implementation\r\n\u001b[?2004l\r"]
[343.371022, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.371051, "o", "> "]
[343.371184, "o", "This module provides parallel implementations of:\r\n\u001b[?2004l\r"]
[343.371204, "o", "\u001b[?2004h> "]
[343.371396, "o", "1. TF-IDF index building with parallel document processing\r\n\u001b[?2004l\r"]
[343.37145, "o", "\u001b[?2004h> "]
[343.371573, "o", "2. Batch search with parallel query processing\r\n\u001b[?2004l\r"]
[343.371593, "o", "\u001b[?2004h> "]
[343.371662, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.371747, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.371804, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.371919, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[343.371941, "o", "\u001b[?2004h> "]
[343.372214, "o", "from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.372236, "o", "> "]
[343.372355, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r"]
[343.372387, "o", "\u001b[?2004h> "]
[343.372502, "o", "from typing import List, Optional, Tuple\r\n\u001b[?2004l\r"]
[343.372577, "o", "\u001b[?2004h> "]
[343.372638, "o", "import multiprocessing as mp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.37267, "o", "\u001b[?2004h"]
[343.372739, "o", "> "]
[343.372829, "o", "from sequential import (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.372876, "o", "    TFIDFIndex,\r\n\u001b[?2004l\rt"]
[343.372929, "o", "\u001b[?2004h> "]
[343.372981, "o", "    SearchResult,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.37304, "o", "    tokenize,\r\n\u001b[?2004l\r"]
[343.373072, "o", "\u001b[?2004h> "]
[343.373191, "o", "    compute_term_frequencies,\r\n\u001b[?2004l\r"]
[343.373239, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[343.373273, "o", "\u001b[?2004h> "]
[343.373402, "o", "from document_generator import Document\r\n\u001b[?2004l\r"]
[343.373424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rB"]
[343.373454, "o", "\u001b[?2004h> "]
[343.373532, "o", "\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[343.373938, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.373959, "o", "\u001b[?2004h> "]
[343.374068, "o", "# Data Structures\r\n\u001b[?2004l\r"]
[343.374145, "o", "\u001b[?2004h> "]
[343.374505, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.3746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.374662, "o", "@dataclass\r\n\u001b[?2004l\r"]
[343.374717, "o", "\u001b[?2004h> "]
[343.374838, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[343.374896, "o", "\u001b[?2004h> "]
[343.375093, "o", "    \"\"\"Result from parallel index building.\"\"\"\r\n\u001b[?2004l\r"]
[343.375165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[343.375204, "o", "\u001b[?2004h> "]
[343.375289, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.375317, "o", "> "]
[343.375411, "o", "    elapsed_time: float\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.37549, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[343.37555, "o", "\u001b[?2004h> "]
[343.37563, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[343.375691, "o", "\u001b[?2004h> \r\n"]
[343.375718, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rv\u001b[?2004h"]
[343.375778, "o", "> "]
[343.376077, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.376171, "o", "\u001b[?2004h> "]
[343.376204, "o", "# Parallel Index Building\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.376233, "o", "> "]
[343.376535, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.376608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[343.376654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[343.381927, "o", "def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h>         docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h>     doc_terms = {}\r\n\u001b[?2004l\rn\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for doc in docs_chunk:\r\n\u001b[?2004l\r\u001b[?2004h>         text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h>         tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h>         tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h>         doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.383151, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r"]
[343.3883, "o", "\u001b[?2004h>         vocabulary.update(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_tfidf_index_parallel(\r\n\u001b[?2004l\r\u001b[?2004h>     documents: List[Document],\r\n\u001b[?2004l\r\u001b[?2004h>     num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h>     chunk_size: int = 500,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Steps:\r\n\u001b[?2004l\r\u001b[?2004h>     1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h>     2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h>     3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h>     4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h>     5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h>         documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h>         chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h>     index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.388512, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r"]
[343.388553, "o", "\u001b[?2004h> "]
[343.388717, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.388801, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.388879, "o", "    vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.388923, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.389111, "o", "    # Optimize chunk size: aim for 2-4x more chunks than workers for load balancing\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.389199, "o", "> "]
[343.389414, "o", "    optimal_chunk_size = max(100, len(documents) // (num_workers * 3))\r\n\u001b[?2004l\r"]
[343.38948, "o", "\u001b[?2004h> "]
[343.389593, "o", "    if chunk_size > optimal_chunk_size:\r\n\u001b[?2004l\r"]
[343.389671, "o", "\u001b[?2004h> "]
[343.389791, "o", "        chunk_size = optimal_chunk_size\r\n\u001b[?2004l\r"]
[343.389862, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.389898, "o", "> "]
[343.389935, "o", "    chunks = []\r\n\u001b[?2004l\r"]
[343.389978, "o", "\u001b[?2004h> "]
[343.390151, "o", "    for i in range(0, len(documents), chunk_size):\r\n\u001b[?2004l\r"]
[343.390244, "o", "\u001b[?2004h> "]
[343.390396, "o", "        chunks.append(documents[i:i + chunk_size])\r\n\u001b[?2004l\r"]
[343.390489, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rend\u001b[?2004h> "]
[343.390614, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r"]
[343.390689, "o", "\u001b[?2004h> "]
[343.390835, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[343.390927, "o", "\u001b[?2004h> "]
[343.391149, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r"]
[343.391233, "o", "\u001b[?2004h> "]
[343.391312, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.391525, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[343.391594, "o", "\u001b[?2004h> "]
[343.391932, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r"]
[343.392027, "o", "\u001b[?2004h> "]
[343.392259, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r"]
[343.392355, "o", "\u001b[?2004h> "]
[343.392528, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[343.392565, "o", "\u001b[?2004h> "]
[343.392813, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r"]
[343.392901, "o", "\u001b[?2004h> "]
[343.392982, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.393152, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[343.393191, "o", "\u001b[?2004h> "]
[343.39323, "o", "    \r\n\u001b[?2004l\r"]
[343.393316, "o", "\u001b[?2004h> "]
[343.393635, "o", "    # Step 2: Calculate document frequencies (sequential - fast)\r\n\u001b[?2004l\r"]
[343.393731, "o", "\u001b[?2004h> "]
[343.393852, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[343.393939, "o", "\u001b[?2004h> "]
[343.394248, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[343.394352, "o", "\u001b[?2004h> "]
[343.394504, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[343.394543, "o", "\u001b[?2004h> "]
[343.394578, "o", "    \r\n\u001b[?2004l\r"]
[343.39465, "o", "\u001b[?2004h> "]
[343.394899, "o", "    # Step 3: Compute IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[343.39499, "o", "\u001b[?2004h> "]
[343.395063, "o", "    N = index.num_documents\r\n\u001b[?2004l\rto"]
[343.395102, "o", "\u001b[?2004h> "]
[343.395352, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[343.395442, "o", "\u001b[?2004h> "]
[343.3956, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[343.395701, "o", "\u001b[?2004h> "]
[343.395731, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.396093, "o", "    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[343.396189, "o", "\u001b[?2004h> "]
[343.396306, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r"]
[343.396391, "o", "\u001b[?2004h> "]
[343.396478, "o", "        posting_list = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.396544, "o", "> "]
[343.396705, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[343.396772, "o", "\u001b[?2004h> "]
[343.396887, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[343.396955, "o", "\u001b[?2004h> "]
[343.397318, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[343.397424, "o", "\u001b[?2004h> "]
[343.397654, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[343.397689, "o", "\u001b[?2004h> "]
[343.39789, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[343.397995, "o", "\u001b[?2004h> "]
[343.398258, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[343.398355, "o", "\u001b[?2004h> "]
[343.398507, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r"]
[343.398581, "o", "\u001b[?2004h> "]
[343.398615, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.398898, "o", "    # Step 5: Build document vectors and compute norms (sequential - fast)\r\n\u001b[?2004l\r"]
[343.398934, "o", "\u001b[?2004h> "]
[343.399154, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[343.399233, "o", "\u001b[?2004h> "]
[343.399289, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[343.399427, "o", "\u001b[?2004h> "]
[343.399548, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.399704, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[343.399777, "o", "\u001b[?2004h> "]
[343.399915, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[343.399991, "o", "\u001b[?2004h> "]
[343.400113, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[343.400189, "o", "\u001b[?2004h> "]
[343.400324, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[343.400397, "o", "\u001b[?2004h> "]
[343.400562, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[343.400633, "o", "\u001b[?2004h> "]
[343.401, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[343.401096, "o", "\u001b[?2004h> "]
[343.401131, "o", "    \r\n\u001b[?2004l\r"]
[343.401237, "o", "\u001b[?2004h> "]
[343.401426, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[343.401461, "o", "\u001b[?2004h> "]
[343.401562, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.401739, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[343.401822, "o", "\u001b[?2004h> "]
[343.401923, "o", "        index=index,\r\n\u001b[?2004l\r"]
[343.401959, "o", "\u001b[?2004h> "]
[343.402107, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r"]
[343.402136, "o", "\u001b[?2004h> "]
[343.402303, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[343.402335, "o", "\u001b[?2004h> "]
[343.402517, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r"]
[343.402585, "o", "\u001b[?2004h> "]
[343.402616, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.402704, "o", "\u001b[?2004h> "]
[343.402817, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.402874, "o", "\u001b[?2004h> "]
[343.402956, "o", "# Parallel Search Functions\r\n\u001b[?2004l\r"]
[343.403015, "o", "\u001b[?2004h> "]
[343.403152, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[343.40318, "o", "\u001b[?2004h"]
[343.40321, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.403246, "o", "> \r\n\u001b[?2004l\r"]
[343.403382, "o", "\u001b[?2004h> "]
[343.40341, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h>     query: str,\r\n\u001b[?2004l\r"]
[343.403434, "o", "\u001b[?2004h> "]
[343.403533, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.403563, "o", "    top_k: int,\r\n\u001b[?2004l\r"]
[343.403595, "o", "\u001b[?2004h> "]
[343.403706, "o", "    doc_titles: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.403791, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.403845, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.403899, "o", "> "]
[343.403983, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r"]
[343.404048, "o", "\u001b[?2004h> "]
[343.404079, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.40416, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.404249, "o", "        query: Search query string\r\n\u001b[?2004l\r"]
[343.404283, "o", "\u001b[?2004h> "]
[343.404394, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.404525, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r"]
[343.404594, "o", "\u001b[?2004h> "]
[343.404739, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.404773, "o", ">     \r\n\u001b[?2004l\r"]
[343.404838, "o", "\u001b[?2004h> "]
[343.404867, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.405027, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r"]
[343.405113, "o", "\u001b[?2004h> "]
[343.405185, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.405241, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r"]
[343.405297, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[343.405354, "o", "\u001b[?2004h> "]
[343.405412, "o", "    # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.405467, "o", "> "]
[343.40554, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[343.405594, "o", "\u001b[?2004h> "]
[343.405654, "o", "    if not query_tokens:\r\n\u001b[?2004l\r"]
[343.405707, "o", "\u001b[?2004h> "]
[343.405764, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.405817, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.405887, "o", "    # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.406026, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[343.406084, "o", "\u001b[?2004h> "]
[343.40615, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.406207, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r"]
[343.406264, "o", "\u001b[?2004h> "]
[343.406336, "o", "    query_vector = {}\r\n\u001b[?2004l\r"]
[343.406394, "o", "\u001b[?2004h> "]
[343.406451, "o", "    query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.406499, "o", "> "]
[343.406558, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[343.406607, "o", "\u001b[?2004h> "]
[343.40669, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.406783, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.406839, "o", "> "]
[343.406917, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[343.406976, "o", "\u001b[?2004h> "]
[343.407047, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[343.407125, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.407183, "o", ">     if not query_vector:\r\n"]
[343.407241, "o", "\u001b[?2004l\r\u001b[?2004h"]
[343.407296, "o", ">         return []\r\n\u001b[?2004l\r"]
[343.407354, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[343.407406, "o", "\u001b[?2004h> "]
[343.407483, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r"]
[343.407549, "o", "\u001b[?2004h> "]
[343.407603, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.407678, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.40775, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r"]
[343.407808, "o", "\u001b[?2004h> "]
[343.407886, "o", "    for term in query_vector:\r\n\u001b[?2004l\r"]
[343.407943, "o", "\u001b[?2004h> "]
[343.407991, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r"]
[343.408051, "o", "\u001b[?2004h> "]
[343.40818, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.408237, "o", "> "]
[343.408312, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.408382, "o", ">     \r\n\u001b[?2004l\r"]
[343.408451, "o", "\u001b[?2004h> "]
[343.408504, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r"]
[343.408562, "o", "\u001b[?2004h> "]
[343.408628, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.408677, "o", "> "]
[343.408837, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.408951, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.409058, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r"]
[343.409097, "o", "\u001b[?2004h>         \r\n"]
[343.409138, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.40925, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.40937, "o", "            continue\r\n\u001b[?2004l\r"]
[343.409415, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.409545, "o", "        # Dot product\r\n\u001b[?2004l\r\u001b[?2004h>         dot_product = sum(\r\n"]
[343.409586, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.409743, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r"]
[343.40978, "o", "\u001b[?2004h> "]
[343.409908, "o", "            for term in query_vector\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[343.409944, "o", "\u001b[?2004h> "]
[343.409972, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.410009, "o", "> "]
[343.410211, "o", "        # Cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.410246, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[343.410278, "o", "\u001b[?2004h> "]
[343.410451, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.410486, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.410615, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.410736, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[343.410768, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[343.4108, "o", "\u001b[?2004h> "]
[343.410904, "o", "    # Build result objects\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.411018, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.411128, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.411182, "o", "> "]
[343.411233, "o", "        results.append(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.411468, "o", "            SearchResult(\r\n\u001b[?2004l\r\u001b[?2004h>                 doc_id=doc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.41151, "o", "                score=score,\r\n\u001b[?2004l\r"]
[343.411539, "o", "\u001b[?2004h> "]
[343.411719, "o", "                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r"]
[343.411753, "o", "\u001b[?2004h> "]
[343.41178, "o", "            )\r\n\u001b[?2004l\r"]
[343.41181, "o", "\u001b[?2004h> "]
[343.411847, "o", "        )\r\n\u001b[?2004l\r"]
[343.411888, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[343.411918, "o", "\u001b[?2004h> "]
[343.412221, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.412255, "o", "    queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.412287, "o", "> "]
[343.412469, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.41257, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.412603, "o", "> "]
[343.412767, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.412952, "o", ") -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.412985, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[343.413017, "o", "\u001b[?2004h> "]
[343.413192, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[343.413221, "o", "\u001b[?2004h> "]
[343.413252, "o", "    Args:\r\n\u001b[?2004l\r"]
[343.413286, "o", "\u001b[?2004h> "]
[343.413494, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.413529, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.413557, "o", "> "]
[343.413721, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.413893, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.413928, "o", "> "]
[343.414174, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[343.414218, "o", "\u001b[?2004h> "]
[343.414396, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.41448, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[343.414515, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.414542, "o", "> "]
[343.41468, "o", "    # Prepare document titles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.414766, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.414792, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.414817, "o", "> "]
[343.414946, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.414975, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.414999, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.415164, "o", "    # Use ThreadPoolExecutor for better performance with shared memory\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.415193, "o", "> "]
[343.415332, "o", "    # Threads avoid serialization overhead and can share the index efficiently\r\n\u001b[?2004l\r"]
[343.415359, "o", "\u001b[?2004h> "]
[343.415465, "o", "    results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.415488, "o", ">     \r\n\u001b[?2004l\r"]
[343.415509, "o", "\u001b[?2004h> "]
[343.415652, "o", "    with ThreadPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.41568, "o", "> "]
[343.415797, "o", "        # Submit all queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.415825, "o", "        future_to_idx = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.415848, "o", "> "]
[343.41784, "o", "            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h>             for idx, query in enumerate(queries)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Collect results in order\r\n\u001b[?2004l\r\u001b[?2004h>         for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r\u001b[?2004h>             idx = future_to_idx[future]\r\n\u001b[?2004l\r\u001b[?2004h>             results[idx] = future.result()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return results, elapsed\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[343.418713, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[349.82111, "i", "python3 test_parallel2.py\n"]
[349.821308, "o", "python3 test_parallel2.py\r\n\u001b[?2004l\r"]
[349.901271, "o", "============================================================\r\nParallel TF-IDF Implementation Test (Many Queries)\r\n============================================================\r\n"]
[355.800418, "o", "Generated 2000 documents.\r\n\r\nGenerated 2000 documents\r\n\r\nBuilding sequential index...\r\n"]
[356.696675, "o", "Sequential time: 0.885s"]
[356.700776, "o", "\r\n"]
[356.700882, "o", "\r\nBuilding parallel index (4 workers)...\r\n"]
[357.413092, "o", "Parallel time: 0.703s\r\nSpeedup: 1.26x\r\n\r\n============================================================\r\nTesting batch search with 160 queries...\r\n\r\nSequential batch search..."]
[357.413156, "o", "\r\n"]
[357.534165, "o", "Sequential time: 0.121s\r\n\r\nParallel batch search (4 workers)...\r\n"]
[357.652745, "o", "Parallel time: 0.118s\r\n\r\nSpeedup: 1.02x\r\n\r\nVerifying correctness (first 10 queries)...\r\n"]
[357.6528, "o", "✓ Correctness verified\r\n✗ Speedup target not met: 1.02x < 2.0x\r\n"]
[357.725365, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[372.15342, "i", "python3 -c \"import multiprocessing; print(f'CPUs: {multiprocessing.cpu_count()}')\"\n"]
[372.156946, "o", "python3 -c \"import multiprocessing; print(f'CPUs: {multiprocessing.cpu_count()}')\"\r\n\u001b[?2004l\r"]
[372.179032, "o", "CPUs: 128\r\n"]
[372.184196, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[395.369224, "i", "cat > test_large.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Test with larger corpus to demonstrate speedup.\"\"\"\n\nimport sys\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef main():\n    print(\"=\"*60)\n    print(\"Large-Scale Parallel TF-IDF Test\")\n    print(\"=\"*60)\n    \n    # Use larger corpus\n    num_docs = 10000\n    documents = generate_corpus(num_docs, seed=42)\n    print(f\"\\nGenerated {len(documents)} documents\")\n    \n    # Build sequential index\n    print(\"\\nBuilding sequential index...\")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f\"Sequential time: {seq_result.elapsed_time:.3f}s\")\n    print(f\"Vocabulary size: {seq_result.vocabulary_size}\")\n    \n    # Build parallel index with 4 workers\n    print(\"\\nBuilding parallel index (4 workers)...\")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4, chunk_size=500)\n    print(f\"Parallel time: {par_result.elapsed_time:.3f}s\")\n    print(f\"Vocabulary size: {par_result.vocabulary_size}\")\n    \n    index_speedup = seq_result.elapsed_time / par_result.elapsed_time\n    print(f\"\\nIndex building speedup: {index_speedup:.2f}x\")\n    \n    if index_speedup >= 1.5:\n        print(f\"✓ Index speedup target met: {index_speedup:.2f}x >= 1.5x\")\n    else:\n        print(f\"✗ Index speedup target not met: {index_speedup:.2f}x < 1.5x\")\n    \n    # Create many queries\n    query_templates = [\n        \"machine learning algorithms\",\n        \"data science analysis\",\n        \"artificial intelligence systems\",\n        \"deep neural networks\",\n        \"computer vision processing\",\n        \"natural language understanding\",\n        \"reinforcement learning methods\",\n        \"statistical modeling techniques\",\n        \"database management optimization\",\n        \"cloud computing platforms\",\n        \"software engineering patterns\",\n        \"web development technologies\",\n        \"mobile application frameworks\",\n        \"network security measures\",\n        \"distributed systems design\",\n        \"algorithm complexity analysis\",\n        \"operating system kernels\",\n        \"compiler optimization strategies\",\n        \"parallel programming models\",\n        \"quantum computing principles\",\n    ]\n    \n    # Create 400 queries\n    queries = query_templates * 20\n    \n    print(f\"\\n\" + \"=\"*60)\n    print(f\"Testing batch search with {len(queries)} queries...\")\n    \n    # Sequential search\n    print(\"\\nSequential batch search...\")\n    import time\n    start = time.perf_counter()\n    seq_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_time = time.perf_counter() - start\n    print(f\"Sequential time: {seq_time:.3f}s\")\n    \n    # Parallel search with 4 workers\n    print(\"\\nParallel batch search (4 workers)...\")\n    par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    print(f\"Parallel time: {par_time:.3f}s\")\n    \n    search_speedup = seq_time / par_time\n    print(f\"\\nBatch search speedup: {search_speedup:.2f}x\")\n    \n    # Verify correctness\n    print(\"\\nVerifying correctness (first 5 queries)...\")\n    for i in range(min(5, len(queries))):\n        seq_res = seq_results[i]\n        par_res = par_results[i]\n        assert len(seq_res) == len(par_res), f\"Query {i} result count mismatch\"\n        for j, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f\"Query {i}, result {j}: doc_id mismatch\"\n            assert abs(s.score - p.score) < 1e-9, f\"Query {i}, result {j}: score mismatch\"\n    print(\"✓ Correctness verified\")\n    \n    if search_speedup >= 2.0:\n        print(f\"✓ Search speedup target met: {search_speedup:.2f}x >= 2.0x\")\n    else:\n        print(f\"✗ Search speedup target not met: {search_speedup:.2f}x < 2.0x\")\n    \n    print(\"\\n\" + \"=\"*60)\n    print(\"Summary:\")\n    print(f\"  Index building: {index_speedup:.2f}x (target: 1.5x)\")\n    print(f\"  Batch search:   {search_speedup:.2f}x (target:"]
[395.369281, "i", " 2.0x)\")\n    print(\"=\"*60)\n    \n    return index_speedup >= 1.5 and search_speedup >= 2.0\n\nif __name__ == \"__main__\":\n    success = main()\n    sys.exit(0 if success else 1)\nEOF\n"]
[395.369499, "o", "cat > test_large.py << 'EOF'\r\n\u001b[?2004l\r"]
[395.369524, "o", "\u001b[?2004h> "]
[395.369575, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[395.369598, "o", "\u001b[?2004h> "]
[395.369731, "o", "\"\"\"Test with larger corpus to demonstrate speedup.\"\"\"\r\n\u001b[?2004l\r"]
[395.369753, "o", "\u001b[?2004h> \r\n"]
[395.369777, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[395.369896, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.370051, "o", "from document_generator import generate_corpus\r\n\u001b[?2004l\r\u001b[?2004h"]
[395.370068, "o", "> "]
[395.370264, "o", "from sequential import build_tfidf_index_sequential, batch_search_sequential\r\n\u001b[?2004l\r\u001b[?2004h> "]
[395.370439, "o", "from parallel_solution import build_tfidf_index_parallel, batch_search_parallel\r\n\u001b[?2004l\r"]
[395.370461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
