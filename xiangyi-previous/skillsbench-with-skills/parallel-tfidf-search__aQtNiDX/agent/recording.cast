[89.687841, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.68787, "o", "> "]
[89.688139, "o", "from document_generator import Document\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.688194, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[89.688224, "o", "> "]
[89.688722, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.688813, "o", "# Data Structures\r\n\u001b[?2004l\r"]
[89.688857, "o", "\u001b[?2004h> "]
[89.689335, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[89.689413, "o", "\u001b[?2004h> "]
[89.689463, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.689553, "o", "> "]
[89.689669, "o", "@dataclass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.689742, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[89.689777, "o", "\u001b[?2004h> "]
[89.690107, "o", "    \"\"\"Result from parallel index building.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.690139, "o", "> \r\n\u001b[?2004l\r"]
[89.690219, "o", "\u001b[?2004h> "]
[89.690285, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r"]
[89.690361, "o", "\u001b[?2004h> "]
[89.690481, "o", "    elapsed_time: float\r\n\u001b[?2004l\r"]
[89.690518, "o", "\u001b[?2004h> "]
[89.690672, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[89.690727, "o", "\u001b[?2004h> "]
[89.690833, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[89.690924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r)\u001b[?2004h> \r\n\u001b[?2004l\r,"]
[89.690965, "o", "\u001b[?2004h> "]
[89.691454, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[89.691547, "o", "\u001b[?2004h> "]
[89.69177, "o", "# Parallel Index Building\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.692144, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[89.692186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h"]
[89.692222, "o", "> \r\n\u001b[?2004l\r"]
[89.692333, "o", "\u001b[?2004h> "]
[89.695604, "o", "def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r"]
[89.695655, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[89.695682, "o", "\u001b[?2004h> "]
[89.696033, "o", "    Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.696077, "o", ">     \r\n\u001b[?2004l\r"]
[89.696107, "o", "\u001b[?2004h> "]
[89.696199, "o", "    Args:\r\n\u001b[?2004l\re\u001b[?2004h> "]
[89.69651, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r"]
[89.696545, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.696575, "o", "\u001b[?2004h"]
[89.696604, "o", "> "]
[89.69671, "o", "    Returns:\r\n\u001b[?2004l\r"]
[89.696739, "o", "\u001b[?2004h> "]
[89.697045, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.697081, "o", "> "]
[89.697116, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[89.69714, "o", "\u001b[?2004h> "]
[89.69731, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.697339, "o", "> "]
[89.69745, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.69758, "o", "    vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.697621, "o", ">     "]
[89.697652, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.697684, "o", "> "]
[89.697836, "o", "    for doc in docs_chunk:\r\n\u001b[?2004l\r"]
[89.697867, "o", "\u001b[?2004h> "]
[89.698078, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r"]
[89.698111, "o", "\u001b[?2004h> "]
[89.698268, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r"]
[89.698308, "o", "\u001b[?2004h> "]
[89.698563, "o", "        tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r"]
[89.698597, "o", "\u001b[?2004h> "]
[89.698815, "o", "        doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r"]
[89.698853, "o", "\u001b[?2004h> "]
[89.69909, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.699126, "o", "> "]
[89.699304, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[89.699332, "o", "\u001b[?2004h> "]
[89.69936, "o", "    \r\n\u001b[?2004l\r"]
[89.699385, "o", "\u001b[?2004h> "]
[89.699643, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r"]
[89.699675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.699702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.699726, "o", " \u001b[?2004h"]
[89.699755, "o", "> "]
[89.699949, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.699982, "o", "> "]
[89.70025, "o", "    documents: List[Document],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.700384, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.700573, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r"]
[89.700613, "o", "\u001b[?2004h> "]
[89.70073, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[89.700759, "o", "\u001b[?2004h> "]
[89.700791, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[89.700829, "o", "\u001b[?2004h> "]
[89.701778, "o", "    Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Steps:\r\n\u001b[?2004l\r\u001b[?2004h>     1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.70195, "o", "    2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.70212, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.702436, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.70255, "o", "> "]
[89.702784, "o", "    5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.702819, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.702844, "o", "> "]
[89.702877, "o", "    Args:\r\n\u001b[?2004l\r"]
[89.702907, "o", "\u001b[?2004h> "]
[89.703128, "o", "        documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.703156, "o", "> "]
[89.703469, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.703736, "o", "        chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.703899, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\rc\u001b[?2004h"]
[89.703979, "o", "> "]
[89.704266, "o", "        ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.704303, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[89.704338, "o", "\u001b[?2004h> "]
[89.70453, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.704624, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.704808, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.705028, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.70513, "o", "    \r\n\u001b[?2004l\r"]
[89.705168, "o", "\u001b[?2004h> "]
[89.708735, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h>     doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Split documents into chunks\r\n\u001b[?2004l\r\u001b[?2004h>     chunks = []\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(0, len(documents), chunk_size):\r\n\u001b[?2004l\r\u001b[?2004h>         chunks.append(documents[i:i + chunk_size])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Process chunks in parallel\r\n\u001b[?2004l\r\u001b[?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h>         futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for future in as_completed(futures):\r\n\u001b[?2004l\r\u001b[?2004h>             chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r\u001b[?2004h>             doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r\u001b[?2004h>             doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.709351, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\rs\u001b[?2004h>     index.vocabulary = vocabulary\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Step 2: Calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.709435, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.709661, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r"]
[89.709723, "o", "\u001b[?2004h> "]
[89.709843, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[89.709903, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r \r\n\u001b[?2004h> "]
[89.710129, "o", "    # Step 3: Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h>     N = index.num_documents\r\n\u001b[?2004l\r"]
[89.710189, "o", "\u001b[?2004h> "]
[89.710367, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[89.710493, "o", "\u001b[?2004h> "]
[89.71054, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[89.710565, "o", "\u001b[?2004h> "]
[89.710599, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.710782, "o", "    # Step 4: Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.710836, "o", "> "]
[89.710912, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\rr\u001b[?2004h"]
[89.710972, "o", "> "]
[89.71104, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[89.711076, "o", "\u001b[?2004h> "]
[89.711229, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.711402, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.711531, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.711632, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.711703, "o", "> "]
[89.711822, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.711858, "o", "> "]
[89.712074, "o", "        # Sort by score descending for efficient top-k retrieval\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.71212, "o", "> "]
[89.712319, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.712397, "o", "> "]
[89.712487, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.712528, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.712707, "o", "    # Step 5: Build document vectors and compute norms\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.716718, "o", ">     for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h>         doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h>         norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h>             tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h>             doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h>             norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h>         index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h>         index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h>         index=index,\r\n\u001b[?2004l\r\u001b[?2004h>         elapsed_time=elapsed,\r\n\u001b[?2004l\r\u001b[?2004h>         num_documents=len(documents),\r\n\u001b[?2004l\r\u001b[?2004h>         vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> # Parallel Search Functions\r\n\u001b[?2004l\r\u001b[?2004h> # ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h>     query: str,\r\n\u001b[?2004l\r\u001b[?2004h>     index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h>     top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h>     doc_titles: dict,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[89.716756, "o", "\u001b[?2004h> "]
[89.716837, "o", "        query: Search query string\r\n\u001b[?2004l\r"]
[89.716864, "o", "\u001b[?2004h> "]
[89.717063, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.717091, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.717218, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r"]
[89.717246, "o", "\u001b[?2004h>     \r\n"]
[89.717271, "o", "\u001b[?2004l\r\u001b[?2004h"]
[89.717301, "o", "> "]
[89.717329, "o", "    Returns:\r\n\u001b[?2004l\r"]
[89.717359, "o", "\u001b[?2004h> "]
[89.717574, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.717598, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r"]
[89.717623, "o", "\u001b[?2004h"]
[89.717648, "o", ">     "]
[89.717671, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.7177, "o", "> "]
[89.717789, "o", "    # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.717935, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h>     if not query_tokens:\r\n\u001b[?2004l\r"]
[89.717972, "o", "\u001b[?2004h> "]
[89.718014, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.718046, "o", ">     \r\n"]
[89.718083, "o", "\u001b[?2004l\r\u001b[?2004h"]
[89.718128, "o", "> "]
[89.718163, "o", "    # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.718319, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[89.718366, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.718727, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h>     query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h>     query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[89.71877, "o", "\u001b[?2004h> "]
[89.718868, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.718982, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.719069, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[89.719105, "o", "\u001b[?2004h> "]
[89.719208, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[89.719235, "o", "\u001b[?2004h> "]
[89.719262, "o", "    \r\n\u001b[?2004l\r"]
[89.719291, "o", "\u001b[?2004h> "]
[89.719369, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.719393, "o", "> "]
[89.71942, "o", "        return []\r\n\u001b[?2004l\r"]
[89.719445, "o", "\u001b[?2004h> "]
[89.719468, "o", "    \r\n\u001b[?2004l\r"]
[89.719493, "o", "\u001b[?2004h"]
[89.719519, "o", "> "]
[89.719638, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.719665, "o", "    \r\n\u001b[?2004l\r"]
[89.71969, "o", "\u001b[?2004h> "]
[89.719803, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.719899, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.720006, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.720139, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.72027, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[89.720316, "o", "\u001b[?2004h> "]
[89.720483, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.720658, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r\u001b[?2004h>     scores = []\r\n"]
[89.720702, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[89.720866, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.720951, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.72107, "o", "> "]
[89.721196, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.721297, "o", ">         if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.721343, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.721458, "o", "        # Dot product\r\n\u001b[?2004l\r\u001b[?2004h>         dot_product = sum(\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.721486, "o", "> "]
[89.721592, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.721668, "o", "            for term in query_vector\r\n\u001b[?2004l\r"]
[89.721692, "o", "\u001b[?2004h> "]
[89.721719, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.721743, "o", ">         \r\n"]
[89.721767, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[89.721831, "o", "        # Cosine similarity\r\n\u001b[?2004l\r"]
[89.721857, "o", "\u001b[?2004h> "]
[89.721998, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.722024, "o", "> "]
[89.7221, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[89.722125, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.722153, "o", "\u001b[?2004h> "]
[89.722202, "o", "    # Get top-k results\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.722221, "o", "> "]
[89.722356, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.722378, "o", "    \r\n\u001b[?2004l\r"]
[89.722405, "o", "\u001b[?2004h> "]
[89.722473, "o", "    # Build result objects\r\n\u001b[?2004l\r"]
[89.722501, "o", "\u001b[?2004h> "]
[89.722535, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.722557, "o", "> "]
[89.722624, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r"]
[89.72265, "o", "\u001b[?2004h> "]
[89.722701, "o", "        results.append(\r\n\u001b[?2004l\r"]
[89.722725, "o", "\u001b[?2004h> "]
[89.722775, "o", "            SearchResult(\r\n\u001b[?2004l\r"]
[89.722797, "o", "\u001b[?2004h> "]
[89.722854, "o", "                doc_id=doc_id,\r\n\u001b[?2004l\r"]
[89.722877, "o", "\u001b[?2004h> "]
[89.722935, "o", "                score=score,\r\n\u001b[?2004l\r"]
[89.722964, "o", "\u001b[?2004h> "]
[89.723251, "o", "                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.72328, "o", "    return results\r\n"]
[89.723304, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[89.723327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.723351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.723417, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r"]
[89.723448, "o", "\u001b[?2004h> "]
[89.723493, "o", "    queries: List[str],\r\n\u001b[?2004l\r"]
[89.723518, "o", "\u001b[?2004h> "]
[89.723562, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r"]
[89.723587, "o", "\u001b[?2004h> "]
[89.72362, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r"]
[89.723643, "o", "\u001b[?2004h> "]
[89.723726, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.72375, "o", "> "]
[89.72419, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Search for multiple queries in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.724218, "o", "> "]
[89.724335, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.724988, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h>         top_k: Number of top results per query\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h>         documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725026, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725087, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725202, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.725241, "o", "\u001b[?2004h> "]
[89.725308, "o", "    # Prepare document titles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725511, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.725576, "o", "\u001b[?2004h>     # Process queries in parallel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725666, "o", "    results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r"]
[89.725721, "o", "\u001b[?2004h> "]
[89.725775, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725919, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.725999, "o", "        # Submit all queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726065, "o", "        future_to_idx = {\r\n\u001b[?2004l\r"]
[89.726142, "o", "\u001b[?2004h> "]
[89.726275, "o", "            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726393, "o", "            for idx, query in enumerate(queries)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.726457, "o", ">         }\r\n\u001b[?2004l\r"]
[89.726527, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726594, "o", "        # Collect results in order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726726, "o", "        for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726832, "o", "            idx = future_to_idx[future]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.726939, "o", "            results[idx] = future.result()\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.726997, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.727064, "o", "> "]
[89.727096, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.727168, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.72724, "o", "    return results, elapsed\r\n\u001b[?2004l\r"]
[89.727266, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[89.729148, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[94.950903, "i", "ls -la\n"]
[94.951154, "o", "ls -la\r\n\u001b[?2004l\r"]
[94.953419, "o", "total 60\r\ndrwxr-xr-x 1 root root  4096 Jan 26 19:44 .\r\ndrwx------ 1 root root  4096 Jan 26 19:42 ..\r\n"]
[94.953556, "o", "-rw-r--r-- 1 root root 19907 Jan 25 20:43 document_generator.py\r\n-rw-r--r-- 1 root root  8918 Jan 26 19:44 parallel_solution.py\r\n-rw-r--r-- 1 root root 12592 Jan 25 20:43 sequential.py\r\n"]
[94.953807, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[99.076031, "i", "find /root -name '*test*.py' -o -name 'test_*' 2>/dev/null | head -20\n"]
[99.076409, "o", "find /root -name '*test*.py' -o -name 'test_*' 2>/dev/null | head -20\r\n\u001b[?2004l\r"]
[99.098949, "o", "\u001b[?2004hroot@03dd581e8ae5:~/workspace# "]
[121.152031, "i", "cat > test_parallel.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Test script for parallel TF-IDF implementation.\"\"\"\n\nimport sys\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef test_index_building():\n    \"\"\"Test parallel index building.\"\"\"\n    print(\"Testing parallel index building...\")\n    \n    # Generate test corpus\n    documents = generate_corpus(2000, seed=42)\n    print(f\"Generated {len(documents)} documents\")\n    \n    # Build sequential index\n    print(\"\\nBuilding sequential index...\")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f\"Sequential time: {seq_result.elapsed_time:.3f}s\")\n    print(f\"Vocabulary size: {seq_result.vocabulary_size}\")\n    \n    # Build parallel index\n    print(\"\\nBuilding parallel index (4 workers)...\")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4, chunk_size=500)\n    print(f\"Parallel time: {par_result.elapsed_time:.3f}s\")\n    print(f\"Vocabulary size: {par_result.vocabulary_size}\")\n    \n    # Check speedup\n    speedup = seq_result.elapsed_time / par_result.elapsed_time\n    print(f\"\\nSpeedup: {speedup:.2f}x\")\n    \n    # Verify correctness\n    print(\"\\nVerifying correctness...\")\n    assert seq_result.vocabulary_size == par_result.vocabulary_size, \"Vocabulary size mismatch\"\n    assert seq_result.num_documents == par_result.num_documents, \"Document count mismatch\"\n    assert seq_result.index.vocabulary == par_result.index.vocabulary, \"Vocabulary mismatch\"\n    \n    # Check a few IDF values\n    sample_terms = list(seq_result.index.vocabulary)[:10]\n    for term in sample_terms:\n        seq_idf = seq_result.index.idf.get(term, 0)\n        par_idf = par_result.index.idf.get(term, 0)\n        assert abs(seq_idf - par_idf) < 1e-9, f\"IDF mismatch for '{term}'\"\n    \n    print(\"✓ Index building correctness verified\")\n    \n    if speedup >= 1.5:\n        print(f\"✓ Speedup target met: {speedup:.2f}x >= 1.5x\")\n    else:\n        print(f\"✗ Speedup target not met: {speedup:.2f}x < 1.5x\")\n    \n    return seq_result, par_result, documents\n\ndef test_batch_search(seq_result, par_result, documents):\n    \"\"\"Test parallel batch search.\"\"\"\n    print(\"\\n\" + \"=\"*60)\n    print(\"Testing parallel batch search...\")\n    \n    # Create test queries\n    queries = [\n        \"machine learning algorithms\",\n        \"data science analysis\",\n        \"artificial intelligence\",\n        \"deep neural networks\",\n        \"computer vision systems\",\n        \"natural language processing\",\n        \"reinforcement learning agents\",\n        \"statistical models\",\n    ]\n    \n    print(f\"\\nSearching {len(queries)} queries...\")\n    \n    # Sequential search\n    print(\"\\nSequential batch search...\")\n    import time\n    start = time.perf_counter()\n    seq_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_time = time.perf_counter() - start\n    print(f\"Sequential time: {seq_time:.3f}s\")\n    \n    # Parallel search\n    print(\"\\nParallel batch search (4 workers)...\")\n    par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    print(f\"Parallel time: {par_time:.3f}s\")\n    \n    # Check speedup\n    speedup = seq_time / par_time\n    print(f\"\\nSpeedup: {speedup:.2f}x\")\n    \n    # Verify correctness\n    print(\"\\nVerifying correctness...\")\n    assert len(seq_results) == len(par_results), \"Result count mismatch\"\n    \n    for i, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\n        assert len(seq_res) == len(par_res), f\"Query {i} result count mismatch\"\n        for j, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f\"Query {i}, result {j}: doc_id mismatch\"\n            assert abs(s.score - p.score) < 1e-9, f\"Query {i}, result {j}: score mismatch\"\n    \n    print(\"✓ Batch search correctness verified\")\n    \n    if speedup >= 2.0:\n        print(f\"✓ Speedup target met: {speedup:.2f}x >= 2.0x\")\n    else:\n    "]
[121.152094, "i", "    print(f\"✗ Speedup target not met: {speedup:.2f}x < 2.0x\")\n\ndef main():\n    print(\"=\"*60)\n    print(\"Parallel TF-IDF Implementation Test\")\n    print(\"=\"*60)\n    \n    try:\n        seq_result, par_result, documents = test_index_building()\n        test_batch_search(seq_result, par_result, documents)\n        \n        print(\"\\n\" + \"=\"*60)\n        print(\"All tests passed!\")\n        print(\"=\"*60)\n        return 0\n    except Exception as e:\n        print(f\"\\n✗ Test failed: {e}\")\n        import traceback\n        traceback.print_exc()\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF\n"]
