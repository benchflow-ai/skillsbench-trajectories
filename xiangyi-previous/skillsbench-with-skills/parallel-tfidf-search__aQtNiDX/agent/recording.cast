[842.328166, "o", "\u001b[?2004l\r\u001b[?2004h> def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.328293, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.328324, "o", "    Returns:\r\n\u001b[?2004l\r"]
[842.328349, "o", "\u001b[?2004h> "]
[842.329852, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h>     doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for doc in docs_chunk:\r\n\u001b[?2004l\r\u001b[?2004h>         text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h>         tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h>         tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h>         doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.329981, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.330138, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[842.330163, "o", "\u001b[?2004h> "]
[842.330186, "o", "    \r\n\u001b[?2004l\r"]
[842.33021, "o", "\u001b[?2004h> "]
[842.330626, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_tfidf_index_parallel(\r\n\u001b[?2004l\r"]
[842.330662, "o", "\u001b[?2004h> "]
[842.330791, "o", "    documents: List[Document],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.33196, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h>     chunk_size: int = 500,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Steps:\r\n\u001b[?2004l\r\u001b[?2004h>     1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.332182, "o", "    2. Merge results and calculate document frequencies\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.332294, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.33232, "o", "> "]
[842.336738, "o", "    4. Build inverted index with TF-IDF scores\r\n\u001b[?2004l\r\u001b[?2004h>     5. Compute document vector norms for cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Args:\r\n\u001b[?2004l\r\u001b[?2004h>         documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h>         chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h>         ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Determine number of workers\r\n\u001b[?2004l\r\u001b[?2004h>     if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h>         num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     index = TFIDFIndex()\r\n\u001b[?2004l\r\u001b[?2004h>     index.num_documents = len(documents)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h>     doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h>     vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.336935, "o", "    # Calculate optimal chunk size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.337341, "o", "    # Use smaller chunks for better load balancing (aim for 4-5x more chunks than workers)\r\n\u001b[?2004l\r"]
[842.337369, "o", "\u001b[?2004h> "]
[842.337597, "o", "    if chunk_size == 500:  # Using default\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.337623, "o", "> "]
[842.338016, "o", "        effective_chunk_size = max(100, len(documents) // (num_workers * 4))\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.338043, "o", "> "]
[842.338157, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.338338, "o", "        effective_chunk_size = chunk_size\r\n\u001b[?2004l\r"]
[842.338362, "o", "\u001b[?2004h> "]
[842.338385, "o", "    \r\n\u001b[?2004l\r"]
[842.338411, "o", "\u001b[?2004h> "]
[842.338618, "o", "    chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.338862, "o", "    for i in range(0, len(documents), effective_chunk_size):\r\n\u001b[?2004l\r"]
[842.338893, "o", "\u001b[?2004h> "]
[842.339174, "o", "        chunks.append(documents[i:i + effective_chunk_size])\r\n\u001b[?2004l\r"]
[842.339212, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.339238, "o", "\u001b[?2004h> "]
[842.339398, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r"]
[842.339425, "o", "\u001b[?2004h> "]
[842.339737, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[842.339765, "o", "\u001b[?2004h> "]
[842.340184, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r"]
[842.340217, "o", "\u001b[?2004h> "]
[842.340243, "o", "        \r\n\u001b[?2004l\r"]
[842.340274, "o", "\u001b[?2004h> "]
[842.340494, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[842.340523, "o", "\u001b[?2004h> "]
[842.340885, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.340973, "o", "> "]
[842.341101, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.342257, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r\u001b[?2004h>             vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     index.vocabulary = vocabulary\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Step 2: Calculate document frequencies (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h>     for term in index.vocabulary:\r\n\u001b[?2004l\rllel(\r\n    queries: List[str],\r\n    index: TFIDFIndex,\r\n    top_k: int = 10,\r\n    num_workers: Optional[int] = None,\r\n    documents: Optional[List[Doc\u001b[?2004h> "]
[842.342569, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.34275, "o", "        index.document_frequencies[term] = df\r\n\u001b[?2004l\r"]
[842.342774, "o", "\u001b[?2004h> "]
[842.342803, "o", "    \r\n\u001b[?2004l\r"]
[842.342831, "o", "\u001b[?2004h> "]
[842.343056, "o", "    # Step 3: Compute IDF scores (sequential - fast)\r\n\u001b[?2004l\r"]
[842.343077, "o", "\u001b[?2004h> "]
[842.343192, "o", "    N = index.num_documents\r\n\u001b[?2004l\r"]
[842.343215, "o", "\u001b[?2004h> "]
[842.343466, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r"]
[842.343491, "o", "\u001b[?2004h> "]
[842.343717, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r"]
[842.343742, "o", "\u001b[?2004h> "]
[842.34377, "o", "    \r\n\u001b[?2004l\r"]
[842.343791, "o", "\u001b[?2004h> "]
[842.34414, "o", "    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.344263, "o", "    for term in index.vocabulary:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.344388, "o", "        posting_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.344606, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.344731, "o", "> "]
[842.344801, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[842.344873, "o", "\u001b[?2004h> "]
[842.344964, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.345022, "o", "> "]
[842.345102, "o", "                tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.345158, "o", "> "]
[842.345291, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.345318, "o", "> "]
[842.345504, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.345549, "o", "> "]
[842.34568, "o", "        index.inverted_index[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.345731, "o", ">     \r\n\u001b[?2004l\r"]
[842.345773, "o", "\u001b[?2004h> "]
[842.345985, "o", "    # Step 5: Build document vectors and compute norms (sequential - fast)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.346038, "o", "> "]
[842.346236, "o", "    for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r"]
[842.346262, "o", "\u001b[?2004h> "]
[842.346401, "o", "        doc_vector = {}\r\n\u001b[?2004l\r"]
[842.34643, "o", "\u001b[?2004h> "]
[842.346552, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[842.346602, "o", "\u001b[?2004h> "]
[842.346697, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[842.34675, "o", "\u001b[?2004h> "]
[842.346855, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[842.346908, "o", "\u001b[?2004h> "]
[842.346994, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[842.347043, "o", "\u001b[?2004h> "]
[842.347159, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[842.347208, "o", "\u001b[?2004h> "]
[842.347339, "o", "        index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[842.347364, "o", "\u001b[?2004h> "]
[842.347548, "o", "        index.doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r"]
[842.347597, "o", "\u001b[?2004h> "]
[842.347647, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.347767, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[842.347817, "o", "\u001b[?2004h> "]
[842.347858, "o", "    \r\n\u001b[?2004l\rColl\u001b[?2004h> "]
[842.347944, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r"]
[842.347971, "o", "\u001b[?2004h> "]
[842.34805, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.348155, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r"]
[842.348204, "o", "\u001b[?2004h> "]
[842.348306, "o", "        num_documents=len(documents),\r\n\u001b[?2004l\r"]
[842.348358, "o", "\u001b[?2004h> "]
[842.348478, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r"]
[842.348529, "o", "\u001b[?2004h> "]
[842.348585, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[842.348635, "o", "\u001b[?2004h> "]
[842.348833, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[842.348891, "o", "\u001b[?2004h> "]
[842.348913, "o", "# Parallel Search Functions\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.348977, "o", "> "]
[842.349061, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[842.349088, "o", "\u001b[?2004h> \r\n"]
[842.34914, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[842.349182, "o", "\u001b[?2004h> "]
[842.349229, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.349281, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.349332, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.349386, "o", "    top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.349434, "o", ">     doc_titles: dict,\r\n\u001b[?2004l\r"]
[842.349484, "o", "\u001b[?2004h> "]
[842.349536, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n"]
[842.349585, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[842.34966, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.349684, "o", "\u001b[?2004h>     Args:\r\n\u001b[?2004l\r"]
[842.349737, "o", "\u001b[?2004h> "]
[842.349788, "o", "        query: Search query string\r\n\u001b[?2004l\r"]
[842.349834, "o", "\u001b[?2004h> "]
[842.349883, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.349949, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.349998, "o", "> "]
[842.35006, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.35011, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350159, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350229, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r"]
[842.350271, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.35033, "o", "    from heapq import nlargest\r\n\u001b[?2004l\r"]
[842.350381, "o", "\u001b[?2004h>     "]
[842.350427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350474, "o", "    # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350528, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.350553, "o", ">     if not query_tokens:\r\n\u001b[?2004l\r"]
[842.350601, "o", "\u001b[?2004h> "]
[842.350646, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350695, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350734, "o", "    # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.35083, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[842.350872, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350932, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.350989, "o", "    query_vector = {}\r\n\u001b[?2004l\r"]
[842.351044, "o", "\u001b[?2004h> "]
[842.351094, "o", "    query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351134, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.351182, "o", "> "]
[842.351226, "o", "        if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351281, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.351329, "o", "> "]
[842.351377, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351436, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[842.351486, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351532, "o", "    if not query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.351581, "o", ">         return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.35163, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351691, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.351741, "o", "\u001b[?2004h> "]
[842.351782, "o", "    # Find candidate documents\r\n\u001b[?2004l\r"]
[842.351831, "o", "\u001b[?2004h> "]
[842.351875, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351922, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.351981, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.352031, "o", "> "]
[842.352101, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352159, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r"]
[842.352209, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.352254, "o", "\u001b[?2004h> "]
[842.352302, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r"]
[842.352351, "o", "\u001b[?2004h>     scores = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.352396, "o", "> "]
[842.352442, "o", "    for doc_id in candidate_docs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352511, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.352564, "o", "> "]
[842.352606, "o", "        doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352668, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352731, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352773, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352824, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352874, "o", "        # Dot product\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.352915, "o", "        dot_product = sum(\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.352966, "o", "> "]
[842.353035, "o", "            query_vector.get(term, 0) * doc_vector.get(term, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.353084, "o", "> "]
[842.353125, "o", "            for term in query_vector\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.353166, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[842.353216, "o", "\u001b[?2004h> "]
[842.353258, "o", "        # Cosine similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.353337, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r"]
[842.353387, "o", "\u001b[?2004h> "]
[842.353446, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r"]
[842.353486, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.353548, "o", "    # Get top-k results\r\n\u001b[?2004l\r"]
[842.35359, "o", "\u001b[?2004h> "]
[842.353665, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[842.353692, "o", "\u001b[?2004h>     \r\n"]
[842.35374, "o", "\u001b[?2004l\r\u001b[?2004h"]
[842.353798, "o", ">     # Build result objects\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.353845, "o", ">     results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.353869, "o", "> "]
[842.353934, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.353983, "o", "        results.append(\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.35403, "o", ">             SearchResult(\r\n\u001b[?2004l\r"]
[842.354081, "o", "\u001b[?2004h> "]
[842.354129, "o", "                doc_id=doc_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.354175, "o", "                score=score,\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.354223, "o", "> "]
[842.354299, "o", "                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\r\n\u001b[?2004l\r"]
[842.354349, "o", "\u001b[?2004h>             )\r\n\u001b[?2004l\r"]
[842.354398, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[842.354446, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.354492, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[842.354538, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.354598, "o", "def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.354654, "o", "    queries: List[str],\r\n\u001b[?2004l\r"]
[842.3547, "o", "\u001b[?2004h>     index: TFIDFIndex,"]
[842.354753, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.354794, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.354843, "o", "> "]
[842.354892, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.354941, "o", "> "]
[842.354987, "o", "    documents: Optional[List[Document]] = None,\r\n\u001b[?2004l\r"]
[842.355032, "o", "\u001b[?2004h> "]
[842.355105, "o", ") -> Tuple[List[List[SearchResult]], float]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.355161, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.355204, "o", "    Search for multiple queries in parallel.\r\n\u001b[?2004l\r"]
[842.355246, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.355287, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.355349, "o", "        queries: List of search query strings\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.355399, "o", "> "]
[842.355444, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r"]
[842.355493, "o", "\u001b[?2004h> "]
[842.355541, "o", "        top_k: Number of top results per query\r\n\u001b[?2004l\r"]
[842.355588, "o", "\u001b[?2004h> "]
[842.355644, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.355685, "o", "> "]
[842.355741, "o", "        documents: Optional list of documents for title lookup\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.355793, "o", ">     \r\n\u001b[?2004l\r"]
[842.355842, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.35591, "o", "        Tuple of (list of result lists, elapsed_time)\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.355934, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[842.355983, "o", "\u001b[?2004h> "]
[842.356058, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.356106, "o", "\u001b[?2004h> "]
[842.356153, "o", "    # Prepare document titles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.356256, "o", "    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.356306, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.356361, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.356411, "o", "> "]
[842.35646, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[842.356506, "o", "\u001b[?2004h> "]
[842.356566, "o", "    # Use many more threads to compensate for GIL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.3567, "o", "    # Threading allows sharing the index without serialization overhead\r\n\u001b[?2004l\r"]
[842.356752, "o", "\u001b[?2004h> "]
[842.356813, "o", "    thread_workers = num_workers * 8\r\n\u001b[?2004l\r"]
[842.356862, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.356958, "o", "    # Use ThreadPoolExecutor for better performance with shared memory\r\n\u001b[?2004l\r"]
[842.357008, "o", "\u001b[?2004h> "]
[842.357087, "o", "    results = [None] * len(queries)  # Preserve order\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.357137, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.357233, "o", "    with ThreadPoolExecutor(max_workers=thread_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.357282, "o", "> "]
[842.357327, "o", "        # Submit all queries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.357372, "o", "        future_to_idx = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.35742, "o", "> "]
[842.357497, "o", "            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.357546, "o", "> "]
[842.357613, "o", "            for idx, query in enumerate(queries)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.357666, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[842.35771, "o", "\u001b[?2004h> "]
[842.357758, "o", "        # Collect results in order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.357824, "o", "        for future in as_completed(future_to_idx):\r\n\u001b[?2004l\r"]
[842.357874, "o", "\u001b[?2004h> "]
[842.357932, "o", "            idx = future_to_idx[future]\r\n\u001b[?2004l\r\u001b[?2004h"]
[842.35798, "o", "> "]
[842.358008, "o", "            results[idx] = future.result()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.358077, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.358138, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[842.358179, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
