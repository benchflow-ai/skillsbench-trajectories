[121.162164, "o", "    par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.162254, "o", "    print(f\"Parallel time: {par_time:.3f}s\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
