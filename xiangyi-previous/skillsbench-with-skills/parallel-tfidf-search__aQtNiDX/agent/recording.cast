[273.13038, "i", "cat > parallel_solution.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n\"\"\"\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\nimport multiprocessing as mp\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    \"\"\"Result from parallel index building.\"\"\"\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building Helper Functions\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    \"\"\"\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    \"\"\"\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef _compute_df_for_terms(args):\n    \"\"\"Compute document frequency for a subset of terms.\"\"\"\n    terms, doc_terms = args\n    df_dict = {}\n    for term in terms:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        df_dict[term] = df\n    return df_dict\n\n\ndef _build_posting_lists(args):\n    \"\"\"Build posting lists for a subset of terms.\"\"\"\n    terms, doc_term_freqs, idf = args\n    posting_lists = {}\n    for term in terms:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        posting_lists[term] = posting_list\n    return posting_lists\n\n\ndef _compute_doc_vectors_chunk(args):\n    \"\"\"Compute document vectors and norms for a chunk of documents.\"\"\"\n    doc_ids, doc_term_freqs, idf = args\n    doc_vectors = {}\n    doc_norms = {}\n    \n    for doc_id in doc_ids:\n        tf_dict = doc_term_freqs.get(doc_id, {})\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        doc_vectors[doc_id] = doc_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    return doc_vectors, doc_norms\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    \"\"\"\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Calculate document frequencies in parallel\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores in parallel\n    5. Compute document vector norms in parallel\n    \n    Args:\n        documents: List of Document objects to inde"]
[273.130454, "i", "x\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Use smaller chunks for better load balancing\n    effective_chunk_size = min(chunk_size, max(50, len(documents) // (num_workers * 4)))\n    chunks = []\n    for i in range(0, len(documents), effective_chunk_size):\n        chunks.append(documents[i:i + effective_chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    vocab_list = list(vocabulary)\n    \n    # Step 2: Calculate document frequencies in parallel\n    term_chunks = []\n    terms_per_chunk = max(10, len(vocab_list) // (num_workers * 2))\n    for i in range(0, len(vocab_list), terms_per_chunk):\n        term_chunks.append(vocab_list[i:i + terms_per_chunk])\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_compute_df_for_terms, (chunk, doc_terms)) \n                   for chunk in term_chunks]\n        \n        for future in as_completed(futures):\n            df_dict = future.result()\n            index.document_frequencies.update(df_dict)\n    \n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_build_posting_lists, \n                                    (chunk, doc_term_freqs, index.idf))\n                   for chunk in term_chunks]\n        \n        for future in as_completed(futures):\n            posting_lists = future.result()\n            index.inverted_index.update(posting_lists)\n    \n    # Step 5: Build document vectors and compute norms in parallel\n    doc_ids = list(doc_term_freqs.keys())\n    doc_id_chunks = []\n    docs_per_chunk = max(50, len(doc_ids) // (num_workers * 2))\n    for i in range(0, len(doc_ids), docs_per_chunk):\n        doc_id_chunks.append(doc_ids[i:i + docs_per_chunk])\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_compute_doc_vectors_chunk,\n                                    (chunk, doc_term_freqs, index.idf))\n                   for chunk in doc_id_chunks]\n        \n        for future in as_completed(futures):\n            doc_vecs, doc_nrms = future.result()\n            index.doc_vectors.update(doc_vecs)\n            index.doc_norms.update(doc_nrms)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_single_query(\n    query: str,\n    index: TFIDFIndex,\n    top_k: int,\n    doc_titles: dict,\n) -> List[SearchResult]:\n    \"\"\"\n    Search for documents similar to a single query.\n    \n    Args:\n        query: Search query string\n        index: TF-IDF index to search\n        top_k: Number of top results to return\n  "]
[273.130509, "i", "      doc_titles: Dictionary mapping doc_id to title\n    \n    Returns:\n        List of SearchResult objects sorted by relevance\n    \"\"\"\n    from heapq import nlargest\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity for each candidate\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        # Dot product\n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        # Cosine similarity\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        results.append(\n            SearchResult(\n                doc_id=doc_id,\n                score=score,\n                title=doc_titles.get(doc_id, f\"Document {doc_id}\"),\n            )\n        )\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    \"\"\"\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n    \"\"\"\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    # Use ThreadPoolExecutor for better performance with shared memory\n    results = [None] * len(queries)  # Preserve order\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    with ThreadPoolExecutor(max_workers=num_workers) as executor:\n        # Submit all queries\n        future_to_idx = {\n            executor.submit(_search_single_query, query, index, top_k, doc_titles): idx\n            for idx, query in enumerate(queries)\n        }\n        \n        # Collect results in order\n        for future in as_completed(future_to_idx):\n            idx = future_to_idx[future]\n            results[idx] = future.result()\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return results, elapsed\nEOF\n"]
[273.13136, "o", "cat > parallel_solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[273.131409, "o", "\u001b[?2004h> "]
[273.131667, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[273.131713, "o", "\u001b[?2004h> "]
[273.131784, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[273.131864, "o", "\u001b[?2004h> "]
[273.132044, "o", "Parallel TF-IDF Implementation\r\n\u001b[?2004l\r"]
[273.132082, "o", "\u001b[?2004h> \r\n"]
[273.132108, "o", "\u001b[?2004l\r\u001b[?2004h"]
[273.132142, "o", "> "]
[273.132402, "o", "This module provides parallel implementations of:\r\n\u001b[?2004l\r"]
[273.132505, "o", "\u001b[?2004h> "]
[273.132753, "o", "1. TF-IDF index building with parallel document processing\r\n\u001b[?2004l\r"]
[273.132781, "o", "\u001b[?2004h"]
[273.132802, "o", "> "]
[273.133038, "o", "2. Batch search with parallel query processing\r\n\u001b[?2004l\r"]
[273.133062, "o", "\u001b[?2004h"]
[273.133099, "o", "> "]
[273.133125, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[273.133153, "o", "\u001b[?2004h"]
[273.133183, "o", "> \r\n\u001b[?2004l\r"]
[273.13321, "o", "\u001b[?2004h> "]
[273.133328, "o", "import math"]
[273.133545, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.133703, "o", "from collections import defaultdict\r\n\u001b[?2004l\r"]
[273.133727, "o", "\u001b[?2004h"]
[273.133756, "o", "> "]
[273.134196, "o", "from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\r\n\u001b[?2004l\r"]
[273.134231, "o", "\u001b[?2004h> "]
[273.134443, "o", "from dataclasses import dataclass\r\n\u001b[?2004l\r"]
[273.134483, "o", "\u001b[?2004h> "]
[273.134716, "o", "from typing import List, Optional, Tuple\r\n\u001b[?2004l\r"]
[273.13475, "o", "\u001b[?2004h> "]
[273.134911, "o", "import multiprocessing as mp\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.134946, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.135113, "o", "from sequential import (\r\n\u001b[?2004l\r"]
[273.135148, "o", "\u001b[?2004h> "]
[273.13531, "o", "    TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.135429, "o", "    SearchResult,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.135539, "o", "    tokenize,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.135703, "o", "    compute_term_frequencies,\r\n\u001b[?2004l\r"]
[273.135741, "o", "\u001b[?2004h> "]
[273.135771, "o", ")\r\n\u001b[?2004l\r"]
[273.135812, "o", "\u001b[?2004h> "]
[273.136039, "o", "from document_generator import Document\r\n\u001b[?2004l\r"]
[273.136084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.136118, "o", "\u001b[?2004h> "]
[273.136154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.136185, "o", "> "]
[273.136602, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.136634, "o", "\u001b[?2004h> "]
[273.1368, "o", "# Data Structures\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.137223, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.137258, "o", "\u001b[?2004h> "]
[273.137287, "o", "\r\n\u001b[?2004l\r"]
[273.137321, "o", "\u001b[?2004h> "]
[273.137357, "o", "\r\n\u001b[?2004l\r"]
[273.137386, "o", "\u001b[?2004h> "]
[273.137601, "o", "@dataclass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.137682, "o", "class ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.137713, "o", "> "]
[273.137966, "o", "    \"\"\"Result from parallel index building.\"\"\"\r\n\u001b[?2004l\r"]
[273.137996, "o", "\u001b[?2004h> "]
[273.138023, "o", "\r\n\u001b[?2004l\r"]
[273.138164, "o", "\u001b[?2004h> "]
[273.138242, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.13827, "o", "> "]
[273.138408, "o", "    elapsed_time: float\r\n\u001b[?2004l\r"]
[273.138433, "o", "\u001b[?2004h> "]
[273.138607, "o", "    num_documents: int\r\n\u001b[?2004l\r"]
[273.138636, "o", "\u001b[?2004h> "]
[273.138775, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[273.138804, "o", "\u001b[?2004h"]
[273.13883, "o", "> \r\n\u001b[?2004l\r"]
[273.138972, "o", "\u001b[?2004h> "]
[273.139, "o", "\r\n\u001b[?2004l\r"]
[273.139106, "o", "\u001b[?2004h> "]
[273.13951, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.139585, "o", "\u001b[?2004h> "]
[273.139845, "o", "# Parallel Index Building Helper Functions\r\n\u001b[?2004l\r"]
[273.139937, "o", "\u001b[?2004h> "]
[273.140445, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.140479, "o", "\u001b[?2004h> "]
[273.140595, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.140624, "o", "\u001b[?2004h> "]
[273.141209, "o", "def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\r\n\u001b[?2004l\r"]
[273.14126, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[273.141293, "o", "\u001b[?2004h> "]
[273.141693, "o", "    Process a chunk of documents to compute term frequencies.\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.141737, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.141767, "o", "> "]
[273.142034, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.142185, "o", "        docs_chunk: List of Document objects to process\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[273.142317, "o", "\u001b[?2004h> "]
[273.142437, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.142659, "o", "        Tuple of (doc_term_freqs, doc_terms, vocabulary)\r\n\u001b[?2004l\r"]
[273.142748, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.142916, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.143039, "o", "    doc_terms = {}\r\n\u001b[?2004l\rend\u001b[?2004h"]
[273.143134, "o", "> "]
[273.143223, "o", "    vocabulary = set()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.143256, "o", "> "]
[273.143469, "o", "    for doc in docs_chunk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.143761, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.143965, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h>         tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.144097, "o", "        doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.144128, "o", "> "]
[273.144299, "o", "        doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.144329, "o", "> "]
[273.144496, "o", "        vocabulary.update(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.144523, "o", ">     \r\n\u001b[?2004l\r"]
[273.144547, "o", "\u001b[?2004h> "]
[273.144796, "o", "    return doc_term_freqs, doc_terms, vocabulary\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.144829, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.144856, "o", "> \r\n\u001b[?2004l\r"]
[273.14489, "o", "\u001b[?2004h> "]
[273.145115, "o", "def _compute_df_for_terms(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.14541, "o", "    \"\"\"Compute document frequency for a subset of terms.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.145565, "o", "    terms, doc_terms = args\r\n\u001b[?2004l\r"]
[273.145597, "o", "\u001b[?2004h> "]
[273.14571, "o", "    df_dict = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.145827, "o", "    for term in terms:\r\n\u001b[?2004l\r"]
[273.145853, "o", "\u001b[?2004h> "]
[273.146271, "o", "        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.146408, "o", "        df_dict[term] = df\r\n\u001b[?2004l\rl\r\n\u001b[?2004h"]
[273.146434, "o", "> "]
[273.146538, "o", "    return df_dict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.146561, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.146581, "o", "> \r\n\u001b[?2004l\r"]
[273.146604, "o", "\u001b[?2004h> "]
[273.146804, "o", "def _build_posting_lists(args):\r\n\u001b[?2004l\r"]
[273.146835, "o", "\u001b[?2004h> "]
[273.147129, "o", "    \"\"\"Build posting lists for a subset of terms.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.147328, "o", "    terms, doc_term_freqs, idf = args\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.147456, "o", "    posting_lists = {}\r\n\u001b[?2004l\r"]
[273.14748, "o", "\u001b[?2004h> "]
[273.147585, "o", "    for term in terms:\r\n\u001b[?2004l\r"]
[273.147605, "o", "\u001b[?2004h> "]
[273.147746, "o", "        posting_list = []\r\n\u001b[?2004l\r"]
[273.147769, "o", "\u001b[?2004h> "]
[273.148052, "o", "        for doc_id, tf_dict in doc_term_freqs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.14819, "o", "            if term in tf_dict:\r\n\u001b[?2004l\r"]
[273.148215, "o", "\u001b[?2004h> "]
[273.148384, "o", "                tf = tf_dict[term]\r\n\u001b[?2004l\r"]
[273.148409, "o", "\u001b[?2004h> "]
[273.148697, "o", "                tfidf = tf * idf[term]\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.148732, "o", "> "]
[273.149105, "o", "                posting_list.append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.149559, "o", "        posting_list.sort(key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.149842, "o", "        posting_lists[term] = posting_list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.149999, "o", "    return posting_lists\r\n\u001b[?2004l\r"]
[273.150027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r0\u001b[?2004h"]
[273.150045, "o", "> \r\n\u001b[?2004l\r,"]
[273.150068, "o", "\u001b[?2004h"]
[273.150101, "o", "> "]
[273.150328, "o", "def _compute_doc_vectors_chunk(args):\r\n\u001b[?2004l\r"]
[273.150359, "o", "\u001b[?2004h> "]
[273.150796, "o", "    \"\"\"Compute document vectors and norms for a chunk of documents.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.150985, "o", "    doc_ids, doc_term_freqs, idf = args\r\n\u001b[?2004l\r"]
[273.151016, "o", "\u001b[?2004h> "]
[273.15115, "o", "    doc_vectors = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.151225, "o", "> "]
[273.151307, "o", "    doc_norms = {}\r\n\u001b[?2004l\r"]
[273.151376, "o", "\u001b[?2004h> "]
[273.151401, "o", "    \r\n\u001b[?2004l\r"]
[273.151492, "o", "\u001b[?2004h> "]
[273.151584, "o", "    for doc_id in doc_ids:\r\n\u001b[?2004l\r"]
[273.151612, "o", "\u001b[?2004h> "]
[273.151839, "o", "        tf_dict = doc_term_freqs.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.151866, "o", "> "]
[273.15199, "o", "        doc_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.152122, "o", "        norm_squared = 0.0\r\n\u001b[?2004l\r"]
[273.152145, "o", "\u001b[?2004h> "]
[273.152337, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.152365, "o", "> "]
[273.152517, "o", "            tfidf = tf * idf[term]\r\n\u001b[?2004l\rh"]
[273.152543, "o", "\u001b[?2004h> "]
[273.152755, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.152928, "o", "            norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r"]
[273.152951, "o", "\u001b[?2004h> "]
[273.153165, "o", "        doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.153197, "o", "> "]
[273.153425, "o", "        doc_norms[doc_id] = math.sqrt(norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.153453, "o", "> "]
[273.153473, "o", "    \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[273.153674, "o", "    return doc_vectors, doc_norms\r\n\u001b[?2004l\r"]
[273.153701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h"]
[273.153721, "o", "> \r\n\u001b[?2004l\ra"]
[273.15375, "o", "\u001b[?2004h> "]
[273.154124, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.154149, "o", "> "]
[273.154269, "o", "# Parallel Index Building\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.154621, "o", "# ============================================================================\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra"]
[273.154646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h"]
[273.154662, "o", "> "]
[273.154802, "o", "def build_tfidf_index_parallel(\r\n\u001b[?2004l\r \u001b[?2004h> "]
[273.154876, "o", "    documents: List[Document],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.155034, "o", "    num_workers: Optional[int] = None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.155126, "o", "    chunk_size: int = 500,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.155211, "o", ") -> ParallelIndexingResult:\r\n\u001b[?2004l\r"]
[273.155237, "o", "\u001b[?2004h> "]
[273.155329, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.155465, "o", "    Build TF-IDF inverted index in parallel.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.15549, "o", "    \r\n\u001b[?2004l\r"]
[273.155513, "o", "\u001b[?2004h"]
[273.155534, "o", "> "]
[273.155688, "o", "    Steps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.155904, "o", "    1. Tokenize documents in parallel chunks and compute term frequencies\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.155939, "o", "> "]
[273.15607, "o", "    2. Calculate document frequencies in parallel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.156206, "o", "    3. Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.156238, "o", "> "]
[273.156372, "o", "    4. Build inverted index with TF-IDF scores in parallel\r\n\u001b[?2004l\r"]
[273.156412, "o", "\u001b[?2004h> "]
[273.156531, "o", "    5. Compute document vector norms in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.156633, "o", ">     \r\n\u001b[?2004l\re\u001b[?2004h>     Args:\r\n\u001b[?2004l\rc\u001b[?2004h> "]
[273.156827, "o", "        documents: List of Document objects to index\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.157062, "o", "        num_workers: Number of worker processes (None = CPU count)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.157231, "o", "        chunk_size: Number of documents per chunk\r\n\u001b[?2004l\r"]
[273.157309, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.157383, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.157586, "o", "        ParallelIndexingResult with the built index and timing info\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.157664, "o", "    \"\"\"\r\n\u001b[?2004l\r t\u001b[?2004h> "]
[273.157766, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.157836, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.15792, "o", "    if num_workers is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.157986, "o", "> "]
[273.158061, "o", "        num_workers = mp.cpu_count()\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.158143, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.158215, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r"]
[273.158282, "o", "\u001b[?2004h> "]
[273.158356, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[273.158424, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.158601, "o", "    # Step 1: Tokenize documents and compute TF in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.158671, "o", "> "]
[273.158739, "o", "    doc_term_freqs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.158807, "o", "    doc_terms = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.158885, "o", "    vocabulary = set()\r\n\u001b[?2004l\r"]
[273.158955, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.159107, "o", "    # Use smaller chunks for better load balancing\r\n\u001b[?2004l\r"]
[273.159184, "o", "\u001b[?2004h> "]
[273.159384, "o", "    effective_chunk_size = min(chunk_size, max(50, len(documents) // (num_workers * 4)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.159453, "o", ">     chunks = []\r\n\u001b[?2004l\r"]
[273.15952, "o", "\u001b[?2004h> "]
[273.159671, "o", "    for i in range(0, len(documents), effective_chunk_size):\r\n\u001b[?2004l\r"]
[273.159747, "o", "\u001b[?2004h> "]
[273.15988, "o", "        chunks.append(documents[i:i + effective_chunk_size])\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.159948, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.160049, "o", "    # Process chunks in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.160127, "o", "> "]
[273.160276, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.160349, "o", "> "]
[273.160557, "o", "        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.160633, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.160786, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.160862, "o", "> "]
[273.16104, "o", "            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\r\n\u001b[?2004l\r"]
[273.161116, "o", "\u001b[?2004h> "]
[273.161218, "o", "            doc_term_freqs.update(chunk_term_freqs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.161289, "o", "> "]
[273.161385, "o", "            doc_terms.update(chunk_terms)\r\n\u001b[?2004l\r"]
[273.161454, "o", "\u001b[?2004h> "]
[273.161544, "o", "            vocabulary.update(chunk_vocab)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.161616, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.161711, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.161776, "o", "> "]
[273.161843, "o", "    vocab_list = list(vocabulary)\r\n\u001b[?2004l\r"]
[273.161921, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.162089, "o", "    # Step 2: Calculate document frequencies in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.162162, "o", "> "]
[273.162231, "o", "    term_chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.162416, "o", "    terms_per_chunk = max(10, len(vocab_list) // (num_workers * 2))\r\n\u001b[?2004l\r"]
[273.162487, "o", "\u001b[?2004h> "]
[273.162624, "o", "    for i in range(0, len(vocab_list), terms_per_chunk):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.162697, "o", "> "]
[273.162832, "o", "        term_chunks.append(vocab_list[i:i + terms_per_chunk])\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.162903, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.163105, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[273.163178, "o", "\u001b[?2004h> "]
[273.163372, "o", "        futures = [executor.submit(_compute_df_for_terms, (chunk, doc_terms)) \r\n\u001b[?2004l\r"]
[273.163439, "o", "\u001b[?2004h> "]
[273.163537, "o", "                   for chunk in term_chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.16361, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.163758, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[273.163831, "o", "\u001b[?2004h> "]
[273.1639, "o", "            df_dict = future.result()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.164072, "o", "            index.document_frequencies.update(df_dict)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.164151, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.164243, "o", "    # Step 3: Compute IDF scores\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.164317, "o", "> "]
[273.164384, "o", "    N = index.num_documents\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.164528, "o", "    for term, df in index.document_frequencies.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.164597, "o", "> "]
[273.164725, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.164811, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.164994, "o", "    # Step 4: Build inverted index with TF-IDF scores in parallel\r\n\u001b[?2004l\r"]
[273.165064, "o", "\u001b[?2004h> "]
[273.165219, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.165291, "o", "> "]
[273.165417, "o", "        futures = [executor.submit(_build_posting_lists, \r\n\u001b[?2004l\r\u001b[?2004h"]
[273.165488, "o", "> "]
[273.165652, "o", "                                    (chunk, doc_term_freqs, index.idf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.165725, "o", "> "]
[273.165803, "o", "                   for chunk in term_chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.165873, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.16602, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r"]
[273.166093, "o", "\u001b[?2004h> "]
[273.16617, "o", "            posting_lists = future.result()\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.166241, "o", "> "]
[273.166366, "o", "            index.inverted_index.update(posting_lists)\r\n\u001b[?2004l\r"]
[273.166437, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.166622, "o", "    # Step 5: Build document vectors and compute norms in parallel\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.166695, "o", "> "]
[273.166771, "o", "    doc_ids = list(doc_term_freqs.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.16684, "o", "> "]
[273.166909, "o", "    doc_id_chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.167108, "o", "    docs_per_chunk = max(50, len(doc_ids) // (num_workers * 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.16718, "o", "> "]
[273.167292, "o", "    for i in range(0, len(doc_ids), docs_per_chunk):\r\n\u001b[?2004l\r"]
[273.167361, "o", "\u001b[?2004h> "]
[273.16751, "o", "        doc_id_chunks.append(doc_ids[i:i + docs_per_chunk])\r\n\u001b[?2004l\r"]
[273.16758, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.167783, "o", "    with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n\u001b[?2004l\r"]
[273.167853, "o", "\u001b[?2004h> "]
[273.16801, "o", "        futures = [executor.submit(_compute_doc_vectors_chunk,\r\n\u001b[?2004l\r"]
[273.168087, "o", "\u001b[?2004h> "]
[273.168261, "o", "                                    (chunk, doc_term_freqs, index.idf))\r\n\u001b[?2004l\r"]
[273.168332, "o", "\u001b[?2004h> "]
[273.168435, "o", "                   for chunk in doc_id_chunks]\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.168503, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.168654, "o", "        for future in as_completed(futures):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.168749, "o", "> "]
[273.168839, "o", "            doc_vecs, doc_nrms = future.result()\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.168906, "o", "> "]
[273.16901, "o", "            index.doc_vectors.update(doc_vecs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.169087, "o", "> "]
[273.169174, "o", "            index.doc_norms.update(doc_nrms)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.16924, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.169386, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[273.169454, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.169558, "o", "    return ParallelIndexingResult(\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.169631, "o", "> "]
[273.1697, "o", "        index=index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.169767, "o", "        elapsed_time=elapsed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.169836, "o", ">         num_documents=len(documents),\r\n\u001b[?2004l\r"]
[273.169906, "o", "\u001b[?2004h> "]
[273.169974, "o", "        vocabulary_size=len(index.vocabulary),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.170046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170144, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.170217, "o", "\u001b[?2004h> # Parallel Search Functions\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.170286, "o", "> "]
[273.170364, "o", "# ============================================================================\r\n\u001b[?2004l\r"]
[273.170435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170507, "o", "def _search_single_query(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170573, "o", "    query: str,\r\n\u001b[?2004l\r\u001b[?2004h>     index: TFIDFIndex,\r\n\u001b[?2004l\r"]
[273.17064, "o", "\u001b[?2004h>     top_k: int,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170709, "o", "    doc_titles: dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170778, "o", ") -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.170841, "o", "> "]
[273.170906, "o", "    Search for documents similar to a single query.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.170974, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171042, "o", "        query: Search query string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171116, "o", "        index: TF-IDF index to search\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171185, "o", "        top_k: Number of top results to return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.17127, "o", "        doc_titles: Dictionary mapping doc_id to title\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.171341, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[273.171413, "o", "\u001b[?2004h> "]
[273.171481, "o", "        List of SearchResult objects sorted by relevance\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[273.171549, "o", "\u001b[?2004h>     from heapq import nlargest\r\n\u001b[?2004l\r"]
[273.171615, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171679, "o", "    # Tokenize query\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.17175, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171816, "o", "    if not query_tokens:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.171883, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.171952, "o", "    # Compute query TF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.17202, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[273.172092, "o", "\u001b[?2004h> "]
[273.17216, "o", "    # Compute query TF-IDF vector\r\n\u001b[?2004l\r\u001b[?2004h>     query_vector = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.172229, "o", ">     query_norm_squared = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.172297, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.172367, "o", ">         if term in index.idf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.172432, "o", ">             tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[273.172498, "o", "\u001b[?2004h> "]
[273.172567, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.172637, "o", "            query_norm_squared += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[273.172708, "o", "\u001b[?2004h>     if not query_vector:\r\n\u001b[?2004l\r"]
[273.172748, "o", "\u001b[?2004h> "]
[273.172806, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.172832, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.172944, "o", "    query_norm = math.sqrt(query_norm_squared)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173084, "o", "    # Find candidate documents\r\n\u001b[?2004l\r\u001b[?2004h>     candidate_docs = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173144, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173186, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173269, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[273.17332, "o", "\u001b[?2004h> "]
[273.173367, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173415, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173483, "o", "    # Compute cosine similarity for each candidate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.173531, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.173576, "o", "> "]
