[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     print("="*60)
[?2004l[?2004h>     print("Large-Scale Parallel TF-IDF Test")
[?2004l[?2004h>     print("="*60)
[?2004l[?2004h>     
[?2004l[?2004h>     # Use larger corpus
[?2004l[?2004h>     num_docs = 10000
[?2004l[?2004h>     documents = generate_corpus(num_docs, seed=42)
[?2004l[?2004h>     print(f"\nGenerated {len(documents)} documents")
[?2004l[?2004h>     
[?2004l[?2004h>     # Build sequential index
