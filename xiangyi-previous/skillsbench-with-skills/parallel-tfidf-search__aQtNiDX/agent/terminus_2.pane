[?2004l[?2004h> class ParallelIndexingResult:
[?2004l[?2004h>     """Result from parallel index building."""
[?2004l[?2004h> 
[?2004l[?2004h>     index: TFIDFIndex
[?2004l[?2004h>     elapsed_time: float
[?2004l[?2004h>     num_documents: int
