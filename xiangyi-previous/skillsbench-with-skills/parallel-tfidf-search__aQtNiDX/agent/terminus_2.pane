[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class ParallelIndexingResult:
[?2004l[?2004h>     """Result from parallel index building."""
[?2004l[?2004h> 
[?2004l[?2004h>     index: TFIDFIndex
[?2004l[?2004h>     elapsed_time: float
[?2004l[?2004h>     num_documents: int
[?2004l[?2004h>     vocabulary_size: int
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> # Parallel Index Building
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Process a chunk of documents to compute term frequencies.
[?2004l[?2004h>     
[?2004l[?2004h>     Args:
[?2004l[?2004h>         docs_chunk: List of Document objects to process
[?2004l[?2004h>     
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         Tuple of (doc_term_freqs, doc_terms, vocabulary)
[?2004l[?2004h>     """
[?2004l[?2004h>     doc_term_freqs = {}
[?2004l[?2004h>     doc_terms = {}
[?2004l[?2004h>     vocabulary = set()
[?2004l[?2004h>     
[?2004l[?2004h>     for doc in docs_chunk:
[?2004l[?2004h>         text = doc.title + " " + doc.content
[?2004l[?2004h>         tokens = tokenize(text)
[?2004l[?2004h>         tf = compute_term_frequencies(tokens)
[?2004l[?2004h>         doc_term_freqs[doc.doc_id] = tf
[?2004l[?2004h>         doc_terms[doc.doc_id] = set(tf.keys())
[?2004l[?2004h>         vocabulary.update(tf.keys())
[?2004l[?2004h>     
[?2004l[?2004h>     return doc_term_freqs, doc_terms, vocabulary
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_tfidf_index_parallel(
[?2004l[?2004h>     documents: List[Document],
[?2004l[?2004h>     num_workers: Optional[int] = None,
[?2004l[?2004h>     chunk_size: int = 500,
[?2004l[?2004h> ) -> ParallelIndexingResult:
[?2004l[?2004h>     """
[?2004l[?2004h>     Build TF-IDF inverted index in parallel.
[?2004l[?2004h>     
[?2004l[?2004h>     Steps:
[?2004l[?2004h>     1. Tokenize documents in parallel chunks and compute term frequencies
[?2004l[?2004h>     2. Merge results and calculate document frequencies
[?2004l[?2004h>     3. Compute IDF scores
[?2004l[?2004h>     4. Build inverted index with TF-IDF scores
[?2004l[?2004h>     5. Compute document vector norms for cosine similarity
[?2004l[?2004h>     
[?2004l[?2004h>     Args:
[?2004l[?2004h>         documents: List of Document objects to index
[?2004l[?2004h>         num_workers: Number of worker processes (None = CPU count)
[?2004l[?2004h>         chunk_size: Number of documents per chunk
[?2004l[?2004h>     
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         ParallelIndexingResult with the built index and timing info
[?2004l[?2004h>     """
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004l[?2004h>     
[?2004l[?2004h>     if num_workers is None:
[?2004l[?2004h>         num_workers = mp.cpu_count()
[?2004l[?2004h>     
[?2004l[?2004h>     index = TFIDFIndex()
[?2004l[?2004h>     index.num_documents = len(documents)
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 1: Tokenize documents and compute TF in parallel
[?2004l[?2004h>     doc_term_freqs = {}
[?2004l[?2004h>     doc_terms = {}
[?2004l[?2004h>     vocabulary = set()
[?2004l[?2004h>     
[?2004l[?2004h>     # Optimize chunk size for better parallelism
[?2004l[?2004h>     # Create more chunks than workers for better load balancing
[?2004l[?2004h>     # Aim for 6-8x more chunks than workers
[?2004l[?2004h>     optimal_chunks = num_workers * 7
[?2004l[?2004h>     optimal_chunk_size = max(30, len(documents) // optimal_chunks)
[?2004l[?2004h>     actual_chunk_size = min(chunk_size, optimal_chunk_size)
[?2004l[?2004h>     
[?2004l[?2004h>     chunks = []
[?2004l[?2004h>     for i in range(0, len(documents), actual_chunk_size):
[?2004l[?2004h>         chunks.append(documents[i:i + actual_chunk_size])
[?2004l[?2004h>     
[?2004l[?2004h>     # Process chunks in parallel
[?2004l[?2004h>     with ProcessPoolExecutor(max_workers=num_workers) as executor:
[?2004l[?2004h>         futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]
[?2004l[?2004h>         
[?2004l[?2004h>         for future in as_completed(futures):
[?2004l[?2004h>             chunk_term_freqs, chunk_terms, chunk_vocab = future.result()
[?2004l[?2004h>             doc_term_freqs.update(chunk_term_freqs)
[?2004l[?2004h>             doc_terms.update(chunk_terms)
[?2004l[?2004h>             vocabulary.update(chunk_vocab)
[?2004l[?2004h>     
[?2004l[?2004h>     index.vocabulary = vocabulary
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 2: Calculate document frequencies (sequential - fast)
[?2004l[?2004h>     for term in index.vocabulary:
[?2004l[?2004h>         df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])
[?2004l[?2004h>         index.document_frequencies[term] = df
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 3: Compute IDF scores (sequential - fast)
[?2004l[?2004h>     N = index.num_documents
[?2004l[?2004h>     for term, df in index.document_frequencies.items():
[?2004l[?2004h>         index.idf[term] = math.log(N / df) + 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 4: Build inverted index with TF-IDF scores (sequential - fast)
[?2004l[?2004h>     for term in index.vocabulary:
[?2004l[?2004h>         posting_list = []
[?2004l[?2004h>         for doc_id, tf_dict in doc_term_freqs.items():
[?2004l[?2004h>             if term in tf_dict:
[?2004l[?2004h>                 tf = tf_dict[term]
[?2004l[?2004h>                 tfidf = tf * index.idf[term]
[?2004l[?2004h>                 posting_list.append((doc_id, tfidf))
[?2004l[?2004h>         posting_list.sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h>         index.inverted_index[term] = posting_list
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 5: Build document vectors and compute norms (sequential - fast)
[?2004l[?2004h>     for doc_id, tf_dict in doc_term_freqs.items():
[?2004l[?2004h>         doc_vector = {}
[?2004l[?2004h>         norm_squared = 0.0
[?2004l[?2004h>         for term, tf in tf_dict.items():
[?2004l[?2004h>             tfidf = tf * index.idf[term]
[?2004l[?2004h>             doc_vector[term] = tfidf
[?2004l[?2004h>             norm_squared += tfidf * tfidf
[?2004l[?2004h>         index.doc_vectors[doc_id] = doc_vector
[?2004l[?2004h>         index.doc_norms[doc_id] = math.sqrt(norm_squared)
[?2004l[?2004h>     
[?2004l[?2004h>     elapsed = time.perf_counter() - start_time
[?2004l[?2004h>     
[?2004l[?2004h>     return ParallelIndexingResult(
[?2004l[?2004h>         index=index,
[?2004l[?2004h>         elapsed_time=elapsed,
[?2004l[?2004h>         num_documents=len(documents),
[?2004l[?2004h>         vocabulary_size=len(index.vocabulary),
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> # Parallel Search Functions
[?2004l[?2004h> # ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _search_single_query(
[?2004l[?2004h>     query: str,
[?2004l[?2004h>     index: TFIDFIndex,
[?2004l[?2004h>     top_k: int,
[?2004l[?2004h>     doc_titles: dict,
[?2004l[?2004h> ) -> List[SearchResult]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Search for documents similar to a single query.
[?2004l[?2004h>     
[?2004l[?2004h>     Args:
[?2004l[?2004h>         query: Search query string
[?2004l[?2004h>         index: TF-IDF index to search
[?2004l[?2004h>         top_k: Number of top results to return
[?2004l[?2004h>         doc_titles: Dictionary mapping doc_id to title
[?2004l[?2004h>     
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         List of SearchResult objects sorted by relevance
[?2004l[?2004h>     """
[?2004l[?2004h>     from heapq import nlargest
[?2004l[?2004h>     
[?2004l[?2004h>     # Tokenize query
[?2004l[?2004h>     query_tokens = tokenize(query)
[?2004l[?2004h>     if not query_tokens:
[?2004l[?2004h>         return []
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute query TF
[?2004l[?2004h>     query_tf = compute_term_frequencies(query_tokens)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute query TF-IDF vector
[?2004l[?2004h>     query_vector = {}
[?2004l[?2004h>     query_norm_squared = 0.0
[?2004l[?2004h>     for term, tf in query_tf.items():
[?2004l[?2004h>         if term in index.idf:
[?2004l[?2004h>             tfidf = tf * index.idf[term]
[?2004l[?2004h>             query_vector[term] = tfidf
[?2004l[?2004h>             query_norm_squared += tfidf * tfidf
[?2004l[?2004h>     
[?2004l[?2004h>     if not query_vector:
[?2004l[?2004h>         return []
[?2004l[?2004h>     
[?2004l[?2004h>     query_norm = math.sqrt(query_norm_squared)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find candidate documents
[?2004l[?2004h>     candidate_docs = set()
[?2004l[?2004h>     for term in query_vector:
[?2004l[?2004h>         if term in index.inverted_index:
[?2004l[?2004h>             for doc_id, _ in index.inverted_index[term]:
[?2004l[?2004h>                 candidate_docs.add(doc_id)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute cosine similarity for each candidate
[?2004l[?2004h>     scores = []
[?2004l[?2004h>     for doc_id in candidate_docs:
[?2004l[?2004h>         doc_vector = index.doc_vectors.get(doc_id, {})
[?2004l[?2004h>         doc_norm = index.doc_norms.get(doc_id, 0)
[?2004l[?2004h>         
[?2004l[?2004h>         if doc_norm == 0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Dot product
[?2004l[?2004h>         dot_product = sum(
[?2004l[?2004h>             query_vector.get(term, 0) * doc_vector.get(term, 0)
[?2004l[?2004h>             for term in query_vector
[?2004l[?2004h>         )
[?2004l[?2004h>         
[?2004l[?2004h>         # Cosine similarity
[?2004l[?2004h>         similarity = dot_product / (query_norm * doc_norm)
[?2004l[?2004h>         scores.append((doc_id, similarity))
[?2004l[?2004h>     
[?2004l[?2004h>     # Get top-k results
[?2004l[?2004h>     top_results = nlargest(top_k, scores, key=lambda x: x[1])
[?2004l[?2004h>     
[?2004l[?2004h>     # Build result objects
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for doc_id, score in top_results:
[?2004l[?2004h>         results.append(
[?2004l[?2004h>             SearchResult(
[?2004l[?2004h>                 doc_id=doc_id,
[?2004l[?2004h>                 score=score,
[?2004l[?2004h>                 title=doc_titles.get(doc_id, f"Document {doc_id}"),
[?2004l[?2004h>             )
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def batch_search_parallel(
[?2004l[?2004h>     queries: List[str],
[?2004l[?2004h>     index: TFIDFIndex,
[?2004l[?2004h>     top_k: int = 10,
[?2004l[?2004h>     num_workers: Optional[int] = None,
[?2004l[?2004h>     documents: Optional[List[Document]] = None,
[?2004l[?2004h> ) -> Tuple[List[List[SearchResult]], float]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Search for multiple queries in parallel.
[?2004l[?2004h>     
[?2004l[?2004h>     Args:
[?2004l[?2004h>         queries: List of search query strings
[?2004l[?2004h>         index: TF-IDF index to search
[?2004l[?2004h>         top_k: Number of top results per query
[?2004l[?2004h>         num_workers: Number of worker processes (None = CPU count)
[?2004l[?2004h>         documents: Optional list of documents for title lookup
[?2004l[?2004h>     
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         Tuple of (list of result lists, elapsed_time)
[?2004l[?2004h>     """
[?2004l[?2004h>     start_time = time.perf_counter()
[?2004l[?2004h>     
[?2004l[?2004h>     # Prepare document titles
[?2004l[?2004h>     doc_titles = {d.doc_id: d.title for d in documents} if documents else {}
[?2004l[?2004h>     
[?2004l[?2004h>     if num_workers is None:
[?2004l[?2004h>         num_workers = mp.cpu_count()
[?2004l[?2004h>     
[?2004l[?2004h>     # Use more threads than CPUs to compensate for GIL
[?2004l[?2004h>     # Threads share memory so no serialization overhead
[?2004l[?2004h>     thread_workers = num_workers * 3
[?2004l[?2004h>     
[?2004l[?2004h>     # Use ThreadPoolExecutor for better performance with shared memory
[?2004l[?2004h>     results = [None] * len(queries)  # Preserve order
[?2004l[?2004h>     
[?2004l[?2004h>     with ThreadPoolExecutor(max_workers=thread_workers) as executor:
[?2004l[?2004h>         # Submit all queries
[?2004l[?2004h>         future_to_idx = {
[?2004l[?2004h>             executor.submit(_search_single_query, query, index, top_k, doc_titles): idx
[?2004l[?2004h>             for idx, query in enumerate(queries)
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         # Collect results in order
[?2004l[?2004h>         for future in as_completed(future_to_idx):
[?2004l[?2004h>             idx = future_to_idx[future]
[?2004l[?2004h>             results[idx] = future.result()
[?2004l[?2004h>     
[?2004l[?2004h>     elapsed = time.perf_counter() - start_time
[?2004l[?2004h>     
[?2004l[?2004h>     return results, elapsed
