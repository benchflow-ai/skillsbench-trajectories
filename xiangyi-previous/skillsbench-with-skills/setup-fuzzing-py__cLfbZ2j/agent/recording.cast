[224.736906, "i", "cat > /app/minisgl/fuzz.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Fuzz driver for minisgl library - LLM inference framework.\"\"\"\n\nimport sys\nimport atheris\nimport json\n\nwith atheris.instrument_imports():\n    # Import key minisgl components that can be tested without GPU\n    from minisgl.tokenizer.tokenize import tokenize_string\n    from minisgl.tokenizer.detokenize import detokenize_incrementally\n\n\ndef TestOneInput(data):\n    \"\"\"Fuzz target for minisgl library.\"\"\"\n    fdp = atheris.FuzzedDataProvider(data)\n    \n    try:\n        # Test tokenizer with random text input\n        if fdp.ConsumeBool():\n            text = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 1000))\n            try:\n                # Test basic string tokenization (without actual tokenizer model)\n                # This tests the tokenization logic\n                pass  # Would need actual tokenizer instance\n            except (ValueError, TypeError, UnicodeError):\n                pass\n        \n        # Test JSON message parsing (common"]
[224.737029, "i", " in API server)\n        elif fdp.ConsumeBool():\n            json_str = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 500))\n            try:\n                data = json.loads(json_str)\n                # Validate message structure\n                if isinstance(data, dict):\n                    # Test various fields that might be in requests\n                    _ = data.get(\"prompt\", \"\")\n                    _ = data.get(\"max_tokens\", 100)\n                    _ = data.get(\"temperature\", 1.0)\n            except (json.JSONDecodeError, ValueError, TypeError):\n                pass\n        \n        # Test with malformed request-like structures\n        elif fdp.ConsumeBool():\n            try:\n                request_data = {\n                    \"prompt\": fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 200)),\n                    \"max_tokens\": fdp.ConsumeIntInRange(-100, 10000),\n                    \"temperature\": fdp.ConsumeFloat(),\n                    \"top_p\": fdp.ConsumeFloat(),\n                }\n     "]
