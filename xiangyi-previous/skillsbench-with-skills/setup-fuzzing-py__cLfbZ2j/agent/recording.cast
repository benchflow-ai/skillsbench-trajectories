[168.865976, "i", "cat > /app/arrow/fuzz.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Fuzz driver for arrow library - date/time parsing and manipulation.\"\"\"\n\nimport sys\nimport atheris\n\nwith atheris.instrument_imports():\n    import arrow\n\n\ndef TestOneInput(data):\n    \"\"\"Fuzz target for arrow library.\"\"\"\n    fdp = atheris.FuzzedDataProvider(data)\n    \n    try:\n        # Test arrow.get() with random string input (main parsing function)\n        if fdp.ConsumeBool():\n            random_string = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 1000))\n            try:\n                arrow.get(random_string)\n            except (arrow.parser.ParserError, ValueError, TypeError, OverflowError):\n                pass\n        \n        # Test arrow.get() with format string\n        elif fdp.ConsumeBool():\n            date_string = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 100))\n            format_string = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 100))\n            try:\n                arrow.get(date_string, format_"]
[168.86621, "i", "string)\n            except (arrow.parser.ParserError, ValueError, TypeError, OverflowError):\n                pass\n        \n        # Test arrow.get() with timestamp\n        elif fdp.ConsumeBool():\n            timestamp = fdp.ConsumeFloat()\n            try:\n                arrow.get(timestamp)\n            except (ValueError, TypeError, OverflowError, OSError):\n                pass\n        \n        # Test Arrow.format() with random format string\n        elif fdp.ConsumeBool():\n            try:\n                arr = arrow.now()\n                format_str = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 100))\n                arr.format(format_str)\n            except (ValueError, TypeError, KeyError):\n                pass\n        \n        # Test Arrow.shift() with random parameters\n        elif fdp.ConsumeBool():\n            try:\n                arr = arrow.now()\n                years = fdp.ConsumeIntInRange(-1000, 1000)\n                months = fdp.ConsumeIntInRange(-100, 100)\n                days = fdp."]
[168.866228, "o", "cat > /app/arrow/fuzz.py << 'EOF'\r\n> #!/usr/bin/env python3\r\n> "]
[168.866261, "i", "ConsumeIntInRange(-1000, 1000)\n                arr.shift(years=years, months=months, days=days)\n            except (ValueError, TypeError, OverflowError):\n                pass\n        \n        # Test timezone handling\n        else:\n            tz_string = fdp.ConsumeUnicodeNoSurrogates(fdp.ConsumeIntInRange(0, 50))\n            try:\n                arrow.now(tz_string)\n            except (ValueError, TypeError, arrow.parser.ParserError):\n                pass\n                \n    except Exception:\n        # Catch any unexpected exceptions that might indicate bugs\n        pass\n\n\ndef main():\n    atheris.Setup(sys.argv, TestOneInput)\n    atheris.Fuzz()\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
