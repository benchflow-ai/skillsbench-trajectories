[23.222519, "o", "Sheet name: Sheet1\r\n\r\nTable contents:\r\nA1: Exchange Rate  B1: CNY  C1: USD  D1: EUR  E1: GBP  \r\nA2: CNY  B2: 1  C2: FORMULA: =ROUND(1/B3, 3)  D2: FORMULA: =ROUND(1/B4,3)  E2: FORMULA: =ROUND(1/B5, 3)  \r\nA3: USD  B3: 7.25  C3: 1  D3: FORMULA: =ROUND(1/C4, 3)  E3: FORMULA: =ROUND(1/C5, 3)  \r\nA4: EUR  B4: 7.85  C4: 1.08  D4: 1  E4: FORMULA: =ROUND(1/D5, 3)  \r\nA5: GBP  B5: 9.17  C5: 1.26  D5: 1.17  E5: 1  \r\n"]
