[41.997489, "i", "python3 << 'EOF'\nfrom pptx import Presentation\nfrom openpyxl import load_workbook\nimport zipfile\nimport os\n\n# Verify the results.pptx\nprint(\"=== Verifying /root/results.pptx ===\")\n\n# Check with python-pptx\nprs = Presentation('/root/results.pptx')\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f\"\\nSlide {slide_idx}:\")\n    for shape_idx, shape in enumerate(slide.shapes):\n        print(f\"  Shape {shape_idx}: {shape.shape_type}\")\n        if hasattr(shape, \"text\"):\n            print(f\"    Text: {shape.text}\")\n\n# Extract and verify the Excel file\nwith zipfile.ZipFile('/root/results.pptx', 'r') as zip_ref:\n    zip_ref.extractall('/tmp/results_check')\n\n# Load and check the Excel file\nwb = load_workbook('/tmp/results_check/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nws = wb.active\n\nprint(f\"\\n=== Excel Table Verification ===\")\nprint(f\"B3 (USD to CNY): {ws['B3'].value}\")\nprint(f\"C2 formula: {ws['C2'].value}\")\nprint(f\"C3 (USD to USD): {ws['C3'].value}\")\n\n# Verify formulas are preserved\nprint(f\"\\nFormula cells check:\")\nfor cell_coord in ['C2', 'D2', 'E2', 'D3', 'E3', 'D4', 'E4']:\n    cell = ws[cell_coord]\n    print(f\"  {cell_coord}: {cell.value}\")\n\nEOF\n"]
