[22.565727, "i", "python3 << 'EOF'\nfrom openpyxl import load_workbook\n\n# Load the embedded Excel file\nwb = load_workbook('/tmp/pptx_extracted/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nws = wb.active\n\nprint(f\"Sheet name: {ws.title}\")\nprint(f\"\\nTable contents:\")\n\n# Print the table\nfor row in ws.iter_rows(min_row=1, max_row=10, min_col=1, max_col=10, values_only=False):\n    for cell in row:\n        if cell.value is not None:\n            # Check if it's a formula\n            if isinstance(cell.value, str) and cell.value.startswith('='):\n                print(f\"{cell.coordinate}: FORMULA: {cell.value}\", end=\"  \")\n            else:\n                print(f\"{cell.coordinate}: {cell.value}\", end=\"  \")\n    print()\n\nEOF\n"]
