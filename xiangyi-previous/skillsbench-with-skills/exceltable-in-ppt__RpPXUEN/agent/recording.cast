[31.55635, "o", "\u001b[?2004hroot@b89390010f8a:~# "]
[35.45972, "i", "python3 << 'EOF'\nimport zipfile\nimport os\n\n# Create a new PPTX file from the modified extracted contents\ndef zipdir(path, ziph):\n    for root, dirs, files in os.walk(path):\n        for file in files:\n            file_path = os.path.join(root, file)\n            arcname = os.path.relpath(file_path, path)\n            ziph.write(file_path, arcname)\n\n# Create the results.pptx\nwith zipfile.ZipFile('/root/results.pptx', 'w', zipfile.ZIP_DEFLATED) as zipf:\n    zipdir('/tmp/pptx_extracted', zipf)\n\nprint(\"PPTX file created: /root/results.pptx\")\nprint(f\"File size: {os.path.getsize('/root/results.pptx')} bytes\")\n\nEOF\n"]
[35.460021, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
