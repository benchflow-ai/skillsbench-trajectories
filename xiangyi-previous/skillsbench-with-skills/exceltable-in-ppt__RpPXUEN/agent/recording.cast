[30.765707, "i", "python3 << 'EOF'\nfrom openpyxl import load_workbook\n\n# Load the embedded Excel file\nwb = load_workbook('/tmp/pptx_extracted/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nws = wb.active\n\n# Update B3 (USD to CNY rate) from 7.25 to 7.02\nws['B3'] = 7.02\n\nprint(f\"Updated B3 to 7.02\")\nprint(f\"B3 value: {ws['B3'].value}\")\nprint(f\"C2 formula: {ws['C2'].value}\")\n\n# Save the workbook\nwb.save('/tmp/pptx_extracted/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nprint(f\"\\nExcel file saved\")\n\nEOF\n"]
