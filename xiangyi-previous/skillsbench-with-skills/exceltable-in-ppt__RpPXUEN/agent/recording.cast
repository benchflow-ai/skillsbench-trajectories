[17.08719, "i", "python3 << 'EOF'\nimport zipfile\nimport os\nfrom lxml import etree\n\n# Extract PPTX (it's a ZIP file)\nwith zipfile.ZipFile('/root/input.pptx', 'r') as zip_ref:\n    zip_ref.extractall('/tmp/pptx_extracted')\n\n# List contents\nfor root, dirs, files in os.walk('/tmp/pptx_extracted'):\n    for file in files:\n        filepath = os.path.join(root, file)\n        print(filepath.replace('/tmp/pptx_extracted/', ''))\n\nEOF\n"]
