[41.999203, "o", "            print(f\"    Text: {shape.text}\")\r\n\u001b[?2004l\r"]
[41.999272, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999342, "o", "# Extract and verify the Excel file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999423, "o", "with zipfile.ZipFile('/root/results.pptx', 'r') as zip_ref:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999502, "o", "    zip_ref.extractall('/tmp/results_check')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.999573, "o", "\u001b[?2004h> # Load and check the Excel file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999731, "o", "wb = load_workbook('/tmp/results_check/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999822, "o", "ws = wb.active\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999895, "o", "print(f\"\\n=== Excel Table Verification ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.999965, "o", "print(f\"B3 (USD to CNY): {ws['B3'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000032, "o", "print(f\"C2 formula: {ws['C2'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000099, "o", "print(f\"C3 (USD to USD): {ws['C3'].value}\")\r\n\u001b[?2004l\r"]
[42.000164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000228, "o", "# Verify formulas are preserved\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000296, "o", "print(f\"\\nFormula cells check:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000366, "o", "for cell_coord in ['C2', 'D2', 'E2', 'D3', 'E3', 'D4', 'E4']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000432, "o", "    cell = ws[cell_coord]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000496, "o", "    print(f\"  {cell_coord}: {cell.value}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.000576, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[42.56737, "o", "=== Verifying /root/results.pptx ===\r\n"]
[42.593311, "o", "\r\nSlide 0:\r\n  Shape 0: EMBEDDED_OLE_OBJECT (7)\r\n  Shape 1: TEXT_BOX (17)\r\n    Text: Updated rate: \r\nUSD to CNY=7.02\r\n"]
[42.596794, "o", "\r\n=== Excel Table Verification ===\r\nB3 (USD to CNY): 7.02\r\nC2 formula: =ROUND(1/B3, 3)\r\nC3 (USD to USD): 1\r\n\r\nFormula cells check:\r\n"]
[42.596837, "o", "  C2: =ROUND(1/B3, 3)\r\n  D2: =ROUND(1/B4,3)\r\n  E2: =ROUND(1/B5, 3)\r\n  D3: =ROUND(1/C4, 3)\r\n  E3: =ROUND(1/C5, 3)\r\n  D4: 1\r\n  E4: =ROUND(1/D5, 3)\r\n"]
[42.63426, "o", "\u001b[?2004hroot@b89390010f8a:~# "]
[46.356435, "i", "ls -lh /root/results.pptx\n"]
[46.35668, "o", "ls -lh /root/results.pptx\r\n\u001b[?2004l\r"]
