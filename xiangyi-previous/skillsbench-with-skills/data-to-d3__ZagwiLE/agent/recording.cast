[85.831648, "i", "cat <<'EOF' > /root/output/css/style.css\nbody {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 0;\n}\n\nh1 {\n  text-align: center;\n  margin: 20px 0;\n}\n\n#container {\n  display: flex;\n  flex-direction: row;\n  gap: 20px;\n  padding: 10px 20px 30px 20px;\n}\n\n#bubble-chart {\n  flex: 1 1 60%;\n}\n\n#stock-table {\n  flex: 1 1 40%;\n  max-height: 650px;\n  overflow-y: auto;\n}\n\nsvg {\n  background: #f9f9f9;\n  border: 1px solid #ddd;\n}\n\n.tooltip {\n  position: absolute;\n  background: rgba(0, 0, 0, 0.8);\n  color: #fff;\n  padding: 6px 10px;\n  border-radius: 4px;\n  pointer-events: none;\n  font-size: 12px;\n}\n\n.node text {\n  pointer-events: none;\n  fill: #fff;\n  font-size: 10px;\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n.node.selected circle {\n  stroke: #000;\n  stroke-width: 2px;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\n\nthead th {\n  position: sticky;\n  top: 0;\n  background: #f0f0f0;\n  border-bottom: 1px solid #ccc;\n  padding: 8px;\n  text-align: left;\n}\n\ntbody td {\n  border-bottom: 1px solid #eee;\n  padding: 6px 8px;\n}\n\ntbody tr:hover {\n  background: #f5f5f5;\n  cursor: pointer;\n}\n\ntbody tr.selected {\n  background: #ffe4b5;\n}\n\n.legend text {\n  font-size: 12px;\n  alignment-baseline: middle;\n}\nEOF\n"]
