[86.018764, "i", "cat <<'EOF' > /root/output/js/visualization.js\nconst width = 600;\nconst height = 600;\n\nconst svg = d3.select(\"#bubble-chart\")\n  .append(\"svg\")\n  .attr(\"width\", width)\n  .attr(\"height\", height);\n\nconst tooltip = d3.select(\"body\")\n  .append(\"div\")\n  .attr(\"class\", \"tooltip\")\n  .style(\"opacity\", 0);\n\nfunction formatMarketCap(value) {\n  if (!value) return \"N/A\";\n  const absVal = Math.abs(value);\n  if (absVal >= 1e12) return (value / 1e12).toFixed(2) + \"T\";\n  if (absVal >= 1e9) return (value / 1e9).toFixed(2) + \"B\";\n  if (absVal >= 1e6) return (value / 1e6).toFixed(2) + \"M\";\n  return value.toFixed(2);\n}\n\nd3.csv(\"data/stock-descriptions.csv\").then(raw => {\n  const data = raw.map(d => ({\n    ticker: d.ticker,\n    sector: d.sector,\n    fullName: d[\"full name\"],\n    marketCap: d.marketCap ? +d.marketCap : null,\n    country: d.country,\n    website: d.website\n  }));\n\n  const sectors = Array.from(new Set(data.map(d => d.sector)));\n  const colorPalette = d3.schemeTableau10.concat(d3.schemeSet3, d3.schemeCategory10);\n  const colorScale = d3.scaleOrdinal()\n    .domain(sectors)\n    .range(colorPalette.slice(0, sectors.length));\n\n  const caps = data.filter(d => d.marketCap).map(d => d.marketCap);\n  const rScale = d3.scaleSqrt()\n    .domain(d3.extent(caps))\n    .range([12, 45]);\n\n  data.forEach(d => {\n    d.radius = d.marketCap ? rScale(d.marketCap) : 15;\n  });\n\n  const centerX = width / 2;\n  const centerY = height / 2;\n  const clusterRadius = Math.min(width, height) / 3;\n  const sectorCenters = {};\n  sectors.forEach((s, i) => {\n    const angle = (2 * Math.PI * i) / sectors.length;\n    sectorCenters[s] = {\n      x: centerX + clusterRadius * Math.cos(angle),\n      y: centerY + clusterRadius * Math.sin(angle)\n    };\n  });\n\n  data.forEach(d => {\n    d.clusterX = sectorCenters[d.sector].x;\n    d.clusterY = sectorCenters[d.sector].y;\n  });\n\n  const node = svg.append(\"g\")\n    .attr(\"class\", \"nodes\")\n    .selectAll(\"g\")\n    .data(data)\n    .enter()\n    .append(\"g\")\n    .attr(\"class\", \"node\");\n\n  node.append(\"circle\")\n    .attr(\"r\", d => d.radius)\n    .attr(\"fill\", d => colorScale(d.sector));\n\n  node.append(\"text\")\n    .text(d => d.ticker)\n    .attr(\"dy\", \"0.1em\");\n\n  const simulation = d3.forceSimulation(data)\n    .force(\"x\", d3.forceX(d => d.clusterX).strength(0.2))\n    .force(\"y\", d3.forceY(d => d.clusterY).strength(0.2))\n    .force(\"collide\", d3.forceCollide(d => d.radius + 1))\n    .force(\"charge\", d3.forceManyBody().strength(0.5))\n    .on(\"tick\", () => {\n      node.attr(\"transform\", d => `translate(${d.x},${d.y})`);\n    });\n\n  // Legend\n  const legend = svg.append(\"g\")\n    .attr(\"class\", \"legend\")\n    .attr(\"transform\", \"translate(10,10)\");\n\n  const legendItem = legend.selectAll(\"g\")\n    .data(sectors)\n    .enter()\n    .append(\"g\")\n    .attr(\"transform\", (d, i) => `translate(0, ${i * 18})`);\n\n  legendItem.append(\"rect\")\n    .attr(\"width\", 12)\n    .attr(\"height\", 12)\n    .attr(\"fill\", d => colorScale(d));\n\n  legendItem.append(\"text\")\n    .attr(\"x\", 18)\n    .attr(\"y\", 6)\n    .text(d => d);\n\n  // Table\n  const table = d3.select(\"#stock-table\").append(\"table\");\n  const columns = [\"Ticker symbol\", \"Full company name\", \"Sector\", \"Market cap\"];\n\n  table.append(\"thead\").append(\"tr\")\n    .selectAll(\"th\")\n    .data(columns)\n    .enter()\n    .append(\"th\")\n    .text(d => d);\n\n  const tbody = table.append(\"tbody\");\n  const rows = tbody.selectAll(\"tr\")\n    .data(data)\n    .enter()\n    .append(\"tr\")\n    .attr(\"data-ticker\", d => d.ticker)\n    .on(\"click\", (event, d) => highlight(d.ticker));\n\n  rows.append(\"td\").text(d => d.ticker);\n  rows.append(\"td\").text(d => d.fullName);\n  rows.append(\"td\").text(d => d.sector);\n  rows.append(\"td\").text(d => formatMarketCap(d.marketCap));\n\n  let selectedTicker = null;\n  function highlight(ticker) {\n    selectedTicker = ticker;\n    rows.classed(\"selected\", d => d.ticker === ticker);\n    node.classed(\"selected\", d => d.ticker === ticker);\n  }\n\n  // Interactions\n  node\n    .on(\"mouseover\", (event, d) => {\n      if (!d.marketCap) return;\n      tooltip\n        .style(\"opacity\", 1)\n        .html(`<strong>${d.ticker}</strong><"]
[86.019179, "i", "br>${d.fullName}<br>${d.sector}`);\n    })\n    .on(\"mousemove\", (event, d) => {\n      if (!d.marketCap) return;\n      tooltip\n        .style(\"left\", (event.pageX + 10) + \"px\")\n        .style(\"top\", (event.pageY - 28) + \"px\");\n    })\n    .on(\"mouseout\", (event, d) => {\n      tooltip.style(\"opacity\", 0);\n    })\n    .on(\"click\", (event, d) => highlight(d.ticker));\n});\nEOF\n"]
