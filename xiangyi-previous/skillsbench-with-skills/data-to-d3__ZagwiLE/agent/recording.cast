[86.03857, "o", "      if (!d.marketCap) return;\r\n\u001b[?2004l\r\u001b[?2004h>       tooltip\r\n\u001b[?2004l\r\u001b[?2004h>         .style(\"left\", (event.pageX + 10) + \"px\")\r\n\u001b[?2004l\r\u001b[?2004h>         .style(\"top\", (event.pageY - 28) + \"px\");\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     .on(\"mouseout\", (event, d) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.038888, "o", "      tooltip.style(\"opacity\", 0);\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     .on(\"click\", (event, d) => highlight(d.ticker));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
