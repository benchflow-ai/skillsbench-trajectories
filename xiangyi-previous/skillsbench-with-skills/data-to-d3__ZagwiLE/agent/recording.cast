[86.159851, "i", "cat <<'EOF' > /root/output/index.html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Stock Bubble Chart and Table</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <h1>Stock Overview</h1>\n  <div id=\"container\">\n    <div id=\"bubble-chart\"></div>\n    <div id=\"stock-table\"></div>\n  </div>\n  <script src=\"js/d3.v6.min.js\"></script>\n  <script src=\"js/visualization.js\"></script>\n</body>\n</html>\nEOF\n"]
[86.160232, "o", "cat <<'EOF' > /root/output/index.html\r\n\u001b[?2004l\r"]
[86.160301, "o", "\u001b[?2004h> "]
[86.160354, "o", "<!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.160404, "o", "<html lang=\"en\">\r\n\u001b[?2004l\r"]
[86.160474, "o", "\u001b[?2004h> <head>\r\n\u001b[?2004l\r"]
[86.160592, "o", "\u001b[?2004h> "]
[86.160651, "o", "  <meta charset=\"UTF-8\">\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.160729, "o", "  <title>Stock Bubble Chart and Table</title>\r\n\u001b[?2004l\r"]
[86.160779, "o", "\u001b[?2004h> "]
[86.16089, "o", "  <link rel=\"stylesheet\" href=\"css/style.css\">\r\n\u001b[?2004l\r"]
[86.160942, "o", "\u001b[?2004h> "]
[86.160992, "o", "</head>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.161037, "o", "<body>\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.161088, "o", "> "]
[86.161135, "o", "  <h1>Stock Overview</h1>\r\n"]
[86.161183, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.161237, "o", "  <div id=\"container\">"]
[86.161289, "o", "\r\n\u001b[?2004l\r"]
[86.16134, "o", "\u001b[?2004h> "]
[86.161389, "o", "    <div id=\"bubble-chart\"></div>\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.161447, "o", "> "]
[86.161514, "o", "    <div id=\"stock-table\"></div>\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.161656, "o", "> "]
[86.161786, "o", "  </div>\r\n\u001b[?2004l\r\u001b[?2004h>   <script src=\"js/d3.v6.min.js\"></script>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.161846, "o", "  <script src=\"js/visualization.js\"></script>\r\n\u001b[?2004l\r"]
[86.161913, "o", "\u001b[?2004h> "]
[86.161963, "o", "</body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h"]
