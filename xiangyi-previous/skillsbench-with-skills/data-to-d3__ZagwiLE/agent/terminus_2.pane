[?2004l[?2004h>   <link rel="stylesheet" href="css/style.css">
[?2004l[?2004h> </head>
[?2004l[?2004h> <body>
[?2004l[?2004h>   <h1>Stock Overview</h1>
[?2004l[?2004h>   <div id="container">
[?2004l[?2004h>     <div id="bubble-chart"></div>
[?2004l[?2004h>     <div id="stock-table"></div>
[?2004l[?2004h>   </div>
[?2004l[?2004h>   <script src="js/d3.v6.min.js"></script>
