[?2004l[?2004hroot@022bba8e26da:~# sed -n '1,80p' /root/output/js/visualization.js
[?2004lconst width = 600;
const height = 600;

const svg = d3.select("#bubble-chart")
  .append("svg")
  .attr("width", width)
  .attr("height", height);

const tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip")
  .style("opacity", 0);

function formatMarketCap(value) {
  if (!value) return "N/A";
  const absVal = Math.abs(value);
  if (absVal >= 1e12) return (value / 1e12).toFixed(2) + "T";
  if (absVal >= 1e9) return (value / 1e9).toFixed(2) + "B";
  if (absVal >= 1e6) return (value / 1e6).toFixed(2) + "M";
  return value.toFixed(2);
}

d3.csv("data/stock-descriptions.csv").then(raw => {
  const data = raw.map(d => ({
    ticker: d.ticker,
    sector: d.sector,
    fullName: d["full name"],
    marketCap: d.marketCap ? +d.marketCap : null,
    country: d.country,
    website: d.website
  }));

  const sectors = Array.from(new Set(data.map(d => d.sector)));
  const colorPalette = d3.schemeTableau10.concat(d3.schemeSet3, d3.schemeCategory10);
  const colorScale = d3.scaleOrdinal()
    .domain(sectors)
    .range(colorPalette.slice(0, sectors.length));

  const caps = data.filter(d => d.marketCap).map(d => d.marketCap);
  const rScale = d3.scaleSqrt()
    .domain(d3.extent(caps))
    .range([12, 45]);

  data.forEach(d => {
    d.radius = d.marketCap ? rScale(d.marketCap) : 15;
  });

  const centerX = width / 2;
  const centerY = height / 2;
  const clusterRadius = Math.min(width, height) / 3;
  const sectorCenters = {};
  sectors.forEach((s, i) => {
    const angle = (2 * Math.PI * i) / sectors.length;
    sectorCenters[s] = {
      x: centerX + clusterRadius * Math.cos(angle),
      y: centerY + clusterRadius * Math.sin(angle)
    };
  });

  data.forEach(d => {
    d.clusterX = sectorCenters[d.sector].x;
    d.clusterY = sectorCenters[d.sector].y;
  });

  const node = svg.append("g")
    .attr("class", "nodes")
    .selectAll("g")
    .data(data)
    .enter()
    .append("g")
    .attr("class", "node");

  node.append("circle")
    .attr("r", d => d.radius)
    .attr("fill", d => colorScale(d.sector));

  node.append("text")
    .text(d => d.ticker)
    .attr("dy", "0.1em");

[?2004hroot@022bba8e26da:~# sed -n '80,200p' /root/output/js/visualization.js
[?2004l
  const simulation = d3.forceSimulation(data)
    .force("x", d3.forceX(d => d.clusterX).strength(0.2))
    .force("y", d3.forceY(d => d.clusterY).strength(0.2))
    .force("collide", d3.forceCollide(d => d.radius + 1))
    .force("charge", d3.forceManyBody().strength(0.5))
    .on("tick", () => {
      node.attr("transform", d => `translate(${d.x},${d.y})`);
    });

  // Legend
  const legend = svg.append("g")
    .attr("class", "legend")
    .attr("transform", "translate(10,10)");

  const legendItem = legend.selectAll("g")
    .data(sectors)
    .enter()
    .append("g")
    .attr("transform", (d, i) => `translate(0, ${i * 18})`);

  legendItem.append("rect")
    .attr("width", 12)
    .attr("height", 12)
    .attr("fill", d => colorScale(d));

  legendItem.append("text")
    .attr("x", 18)
    .attr("y", 6)
    .text(d => d);

  // Table
  const table = d3.select("#stock-table").append("table");
  const columns = ["Ticker symbol", "Full company name", "Sector", "Market cap"];

  table.append("thead").append("tr")
    .selectAll("th")
    .data(columns)
    .enter()
    .append("th")
    .text(d => d);

  const tbody = table.append("tbody");
  const rows = tbody.selectAll("tr")
    .data(data)
    .enter()
    .append("tr")
    .attr("data-ticker", d => d.ticker)
    .on("click", (event, d) => highlight(d.ticker));

  rows.append("td").text(d => d.ticker);
  rows.append("td").text(d => d.fullName);
  rows.append("td").text(d => d.sector);
  rows.append("td").text(d => formatMarketCap(d.marketCap));

  let selectedTicker = null;
  function highlight(ticker) {
    selectedTicker = ticker;
    rows.classed("selected", d => d.ticker === ticker);
    node.classed("selected", d => d.ticker === ticker);
  }

  // Interactions
  node
    .on("mouseover", (event, d) => {
      if (!d.marketCap) return;
      tooltip
        .style("opacity", 1)
        .html(`<strong>${d.ticker}</strong><br>${d.fullName}<br>${d.sector}`);
    })
    .on("mousemove", (event, d) => {
      if (!d.marketCap) return;
      tooltip
        .style("left", (event.pageX + 10) + "px")
        .style("top", (event.pageY - 28) + "px");
    })
    .on("mouseout", (event, d) => {
      tooltip.style("opacity", 0);
    })
    .on("click", (event, d) => highlight(d.ticker));
});
