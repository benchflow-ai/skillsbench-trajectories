[72.346099, "i", "cat <<EOF > /root/process_berkshire.py\nimport csv\n\nq2_accession = \"0000950123-25-008343\"\nq3_accession = \"0001193125-25-282901\"\n\nq2_holdings = {}\nq3_holdings = {}\n\n# Read Q2\nwith open('/root/2025-q2/INFOTABLE.tsv', 'r') as f:\n    reader = csv.reader(f, delimiter='\\t')\n    for row in reader:\n        if row[0] == q2_accession:\n            cusip = row[4]\n            try:\n                value = float(row[6]) # VALUE is column 7 (index 6)\n            except ValueError:\n                continue\n            q2_holdings[cusip] = q2_holdings.get(cusip, 0) + value\n\n# Read Q3\nwith open('/root/2025-q3/INFOTABLE.tsv', 'r') as f:\n    reader = csv.reader(f, delimiter='\\t')\n    for row in reader:\n        if row[0] == q3_accession:\n            cusip = row[4]\n            try:\n                value = float(row[6])\n            except ValueError:\n                continue\n            q3_holdings[cusip] = q3_holdings.get(cusip, 0) + value\n\n# Calculate increase\nincreases = []\nfor cusip, val_q3 in q3_holdings.items():\n    val_q2 = q2_holdings.get(cusip, 0)\n    diff = val_q3 - val_q2\n    if diff > 0:\n        increases.append((cusip, diff))\n\n# Sort by difference descending\nincreases.sort(key=lambda x: x[1], reverse=True)\n\n# Print top 5\nprint([x[0] for x in increases[:5]])\nEOF\n"]
