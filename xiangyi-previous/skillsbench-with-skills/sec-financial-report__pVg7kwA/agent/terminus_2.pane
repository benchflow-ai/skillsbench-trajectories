[?2004hroot@571e3e69bd42:~# cat <<EOF > /root/process_berkshire.py
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> q2_accession = "0000950123-25-008343"
[?2004l[?2004h> q3_accession = "0001193125-25-282901"
[?2004l[?2004h> 
[?2004l[?2004h> q2_holdings = {}
[?2004l[?2004h> q3_holdings = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q2
[?2004l[?2004h> with open('/root/2025-q2/INFOTABLE.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         if row[0] == q2_accession:
[?2004l[?2004h>             cusip = row[4]
[?2004l[?2004h>             try:
[?2004l[?2004h>                 value = float(row[6]) # VALUE is column 7 (index 6)
[?2004l[?2004h>             except ValueError:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             q2_holdings[cusip] = q2_holdings.get(cusip, 0) + value
[?2004l[?2004h> 
[?2004l[?2004h> # Read Q3
[?2004l[?2004h> with open('/root/2025-q3/INFOTABLE.tsv', 'r') as f:
[?2004l[?2004h>     reader = csv.reader(f, delimiter='\t')
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         if row[0] == q3_accession:
[?2004l[?2004h>             cusip = row[4]
[?2004l[?2004h>             try:
[?2004l[?2004h>                 value = float(row[6])
[?2004l[?2004h>             except ValueError:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             q3_holdings[cusip] = q3_holdings.get(cusip, 0) + value
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate increase
[?2004l[?2004h> increases = []
[?2004l[?2004h> for cusip, val_q3 in q3_holdings.items():
[?2004l[?2004h>     val_q2 = q2_holdings.get(cusip, 0)
[?2004l[?2004h>     diff = val_q3 - val_q2
[?2004l[?2004h>     if diff > 0:
[?2004l[?2004h>         increases.append((cusip, diff))
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by difference descending
[?2004l[?2004h> increases.sort(key=lambda x: x[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Print top 5
[?2004l[?2004h> print([x[0] for x in increases[:5]])
