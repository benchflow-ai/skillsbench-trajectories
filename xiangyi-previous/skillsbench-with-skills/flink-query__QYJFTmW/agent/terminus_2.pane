[?2004lpackage clusterdata.datatypes;

import java.io.Serializable;

public class TaskEvent implements Serializable {
    public long timestamp;
    public String missingInfo;
    public long jobId;
    public long taskIndex;
    public long machineId;
    public int eventType;
    public String user;
    public int schedulingClass;
    public int priority;
    public double cpuRequest;
    public double memoryRequest;
    public double diskSpaceRequest;
    public int differentMachineConstraint;

    public TaskEvent() {}

    public TaskEvent(long timestamp, String missingInfo, long jobId, long taskIndex, long machineId,
                     int eventType, String user, int schedulingClass, int priority,
                     double cpuRequest, double memoryRequest, double diskSpaceRequest,
                     int differentMachineConstraint) {
        this.timestamp = timestamp;
        this.missingInfo = missingInfo;
        this.jobId = jobId;
        this.taskIndex = taskIndex;
        this.machineId = machineId;
        this.eventType = eventType;
        this.user = user;
        this.schedulingClass = schedulingClass;
        this.priority = priority;
        this.cpuRequest = cpuRequest;
        this.memoryRequest = memoryRequest;
        this.diskSpaceRequest = diskSpaceRequest;
        this.differentMachineConstraint = differentMachineConstraint;
    }

    public long getTimestamp() { return timestamp; }
    public long getJobId() { return jobId; }
    public int getEventType() { return eventType; }

    public static TaskEvent fromString(String line) {
        String[] p = line.split(",", -1);
        long ts = parseLong(p, 0);
        String missing = get(p, 1);
        long jobId = parseLong(p, 2);
        long taskIndex = parseLong(p, 3);
        long machineId = parseLong(p, 4);
        int eventType = parseInt(p, 5);
        String user = get(p, 6);
        int schedClass = parseInt(p, 7);
        int priority = parseInt(p, 8);
        double cpuReq = parseDouble(p, 9);
        double memReq = parseDouble(p, 10);
        double diskReq = parseDouble(p, 11);
        int diff = parseInt(p, 12);
        return new TaskEvent(ts, missing, jobId, taskIndex, machineId, eventType, user, schedClass, priority, cpuReq, memReq, diskReq, diff);
    }

    private static String get(String[] p, int idx) {
        if (idx >= p.length) return "";
        return p[idx];
    }

    private static long parseLong(String[] p, int idx) { return parseLong(get(p, idx)); }
    private static long parseLong(String s) { return (s == null || s.isEmpty()) ? -1L : Long.parseLong(s); }

    private static int parseInt(String[] p, int idx) { return parseInt(get(p, idx)); }
    private static int parseInt(String s) { return (s == null || s.isEmpty()) ? -1 : Integer.parseInt(s); }

    private static double parseDouble(String[] p, int idx) { return parseDouble(get(p, idx)); }
    private static double parseDouble(String s) { return (s == null || s.isEmpty()) ? 0.0 : Double.parseDouble(s); }
}
