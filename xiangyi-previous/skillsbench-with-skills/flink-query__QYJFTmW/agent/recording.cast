[493.297681, "o", "package clusterdata.datatypes;\r\n\r\nimport java.io.Serializable;\r\n\r\npublic class TaskEvent implements Serializable {\r\n    public long timestamp;\r\n"]
[493.297771, "o", "    public String missingInfo;\r\n    public long jobId;\r\n    public long taskIndex;\r\n    public long machineId;\r\n    public int eventType;\r\n    public String user;\r\n    public int schedulingClass;\r\n    public int priority;\r\n    public double cpuRequest;\r\n    public double memoryRequest;\r\n    public double diskSpaceRequest;\r\n    public int differentMachineConstraint;\r\n\r\n    public TaskEvent() {}\r\n\r\n    public TaskEvent(long timestamp, String missingInfo, long jobId, long taskIndex, long machineId,\r\n                     int eventType, String user, int schedulingClass, int priority,\r\n                     double cpuRequest, double memoryRequest, double diskSpaceRequest,\r\n                     int differentMachineConstraint) {"]
[493.297833, "o", "\r\n        this.timestamp = timestamp;\r\n        this.missingInfo = missingInfo;\r\n        this.jobId = jobId;\r\n        this.taskIndex = taskIndex;\r\n        this.machineId = machineId;\r\n        this.eventType = eventType;\r\n        this.user = user;\r\n        this.schedulingClass = schedulingClass;\r\n        this.priority = priority;\r\n        this.cpuRequest = cpuRequest;\r\n"]
[493.29793, "o", "        this.memoryRequest = memoryRequest;\r\n        this.diskSpaceRequest = diskSpaceRequest;\r\n        this.differentMachineConstraint = differentMachineConstraint;\r\n    }\r\n\r\n    public long getTimestamp() { return timestamp; }\r\n    public long getJobId() { return jobId; }\r\n    public int getEventType() { return eventType; }\r\n\r\n    public static TaskEvent fromString(String line) {\r\n        String[] p = line.split(\",\", -1);\r\n        long ts = parseLong(p, 0);\r\n        String missing = get(p, 1);\r\n        long jobId = parseLong(p, 2);"]
[493.298054, "o", "\r\n        long taskIndex = parseLong(p, 3);\r\n        long machineId = parseLong(p, 4);\r\n        int eventType = parseInt(p, 5);\r\n        String user = get(p, 6);\r\n        int schedClass = parseInt(p, 7);\r\n        int priority = parseInt(p, 8);\r\n        double cpuReq = parseDouble(p, 9);\r\n        double memReq = parseDouble(p, 10);\r\n        double diskReq = parseDouble(p, 11);\r\n        int diff = parseInt(p, 12);\r\n        return new TaskEvent(ts, missing, jobId, taskIndex, machineId, eventType, user, schedClass, priority, cpuReq, memReq, diskReq, diff);\r\n    }\r\n\r\n    private static String get(String[] p, int idx) {\r\n        if (idx >= p.length) return \"\";\r\n        return p[idx];\r\n    }\r\n\r\n    private static long parseLong(String[] p, int idx) { return parseLong(get(p, idx)); }\r\n    private static long parseLong(String s) { return (s == null || s.isEmpty()) ? -1L : Long.parseLong(s); }\r\n\r\n    private static int parseInt(String[] p, int idx) { return parseInt(get(p, idx)); }\r\n    private static int parseInt(String s) { return (s == null || s.isEmpty()) ? -1 : Integer.parseInt(s); }\r\n\r\n    private static double parseDouble(String[] p, int idx) { return parseDouble(get(p, idx)); }\r\n    private static double parseDouble(String s) { return (s == null || s.isEmpty()) ? 0.0 : Double.parseDouble(s); }\r\n}\r\n"]
