[141.361263, "o", "    <groupId>clusterdata-analysis</groupId>\r\n    <artifactId>clusterdata-analysis</artifactId>\r\n    <version>0.1</version>\r\n    <packaging>jar</packaging>\r\n\r\n    <name>Cluster data analysis</name>\r\n\r\n    <properties>\r\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\r\n        <flink.version>1.18.0</flink.version>\r\n        <target.java.version>11</target.java.version>\r\n        <scala.binary.version>2.12</scala.binary.version>\r\n        <maven.compiler.source>${target.java.version}</maven.compiler.source>\r\n        <maven.compiler.target>${target.java.version}</maven.compiler.target>\r\n        <log4j.version>2.17.1</log4j.version>\r\n    </properties>\r\n"]
[141.361288, "o", "\r\n    <repositories>\r\n        <repository>\r\n            <id>apache.snapshots</id>\r\n            <name>Apache Development Snapshot Repository</name>\r\n            <url>https://repository.apache.org/content/repositories/snapshots/</url>\r\n            <releases>\r\n                <enabled>false</enabled>\r\n            </releases>\r\n            <snapshots>\r\n                <enabled>true</enabled>\r\n            </snapshots>\r\n        </repository>\r\n    </repositories>\r\n\r\n    <dependencies>\r\n        <!-- Apache Flink dependencies -->\r\n\r\n        <!-- https://mvnrepository.com/artifact/org.apache.flink/flink-examples-streaming -->\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-examples-streaming</artifactId>\r\n            <version>1.18.0</version>\r\n        </dependency>\r\n\r\n"]
[141.361398, "o", "        <!-- These dependencies are provided, because they should not be packaged into the JAR file. -->\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-java</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-streaming-java</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-clients</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n"]
[141.36145, "o", "            <artifactId>flink-walkthrough-common</artifactId>\r\n            <version>${flink.version}</version>\r\n            <scope>provided</scope>\r\n        </dependency>\r\n\r\n        <!-- Add connector dependencies here. They must be in the default scope (compile). -->\r\n\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-connector-kafka</artifactId>\r\n            <version>1.17.0</version>\r\n        </dependency>\r\n\r\n        <dependency>\r\n            <groupId>org.apache.flink</groupId>\r\n            <artifactId>flink-connector-wikiedits</artifactId>\r\n            <version>${flink.version}</version>\r\n        </dependency>\r\n\r\n        <!-- Add logging framework, to produce console output when running in the IDE. -->\r\n        <!-- These dependencies are excluded from the application JAR by default. -->\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-slf4j-impl</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-api</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n        <dependency>\r\n            <groupId>org.apache.logging.log4j</groupId>\r\n            <artifactId>log4j-core</artifactId>\r\n            <version>${log4j.version}</version>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n    </dependencies>\r\n\r\n    <build>\r\n        <plugins>\r\n\r\n            <!-- Java Compiler -->\r\n            <plugin>\r\n                <groupId>org.apache.maven.plugins</groupId>\r\n                <artifactId>maven-compiler-plugin</artifactId>\r\n                <version>3.9.0</version>\r\n                <configuration>\r\n                    <source>${target.java.version}</source>\r\n                    <target>${target.java.version}</target>\r\n                </configuration>\r\n            </plugin>\r\n\r\n            <plugin>\r\n                <groupId>org.apache.maven.plugins</groupId>\r\n                <artifactId>maven-assembly-plugin</artifactId>\r\n                <version>3.3.0</version>\r\n                <configuration>\r\n                    <descriptorRefs>\r\n                        <descriptorRef>jar-with-dependencies</descriptorRef>\r\n                    </descriptorRefs>\r\n                </configuration>\r\n                <executions>\r\n                    <execution>\r\n                        <id>LongestSessionPerJob</id>\r\n                        <phase>package</phase>\r\n                        <goals>\r\n                            <goal>single</goal>\r\n                        </goals>\r\n                        <configuration>\r\n                            <finalName>LongestSessionPerJob</finalName>\r\n                            <archive>\r\n                                <manifestEntries>\r\n                                    <program-class>clusterdata.query.LongestSessionPerJob</program-class>\r\n                                </manifestEntries>\r\n                            </archive>\r\n                        </configuration>\r\n                    </execution>\r\n                </executions>\r\n            </plugin>\r\n\r\n        </plugins>\r\n\r\n        <pluginManagement>\r\n            <plugins>\r\n\r\n                <!-- This improves the out-of-the-box experience in Eclipse by resolving some warnings. -->\r\n                <plugin>\r\n                    <groupId>org.eclipse.m2e</groupId>\r\n                    <artifactId>lifecycle-mapping</artifactId>\r\n                    <version>1.0.0</version>\r\n                    <configuration>\r\n                        <lifecycleMappingMetadata>\r\n                            <pluginExecutions>\r\n                                <pluginExecution>\r\n                                    <pluginExecutionFilter>\r\n"]
[141.36151, "o", "                                        <groupId>org.apache.maven.plugins</groupId>\r\n                                        <artifactId>maven-shade-plugin</artifactId>\r\n                                        <versionRange>[3.2.4,)</versionRange>\r\n                                        <goals>\r\n                                            <goal>shade</goal>\r\n                                        </goals>\r\n                                    </pluginExecutionFilter>\r\n                                    <action>\r\n                                        <ignore/>\r\n                                    </action>\r\n                                </pluginExecution>\r\n                                <pluginExecution>\r\n                                    <pluginExecutionFilter>\r\n                                        <groupId>org.apache.maven.plugins</groupId>\r\n                                        <artifactId>maven-compiler-plugin</artifactId>\r\n                                        <versionRange>[3.9.0,)</versionRange>\r\n                                        <goals>\r\n                                            <goal>testCompile</goal>\r\n"]
