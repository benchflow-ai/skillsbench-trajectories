[478.241147, "i", "cat > /app/workspace/src/main/java/clusterdata/datatypes/JobEvent.java <<'EOF'\npackage clusterdata.datatypes;\n\nimport java.io.Serializable;\n\npublic class JobEvent implements Serializable {\n    public long timestamp;\n    public String missingInfo;\n    public long jobId;\n    public int eventType;\n    public String user;\n    public int schedulingClass;\n    public String jobName;\n    public String logicalJobName;\n\n    public JobEvent() {}\n\n    public JobEvent(long timestamp, String missingInfo, long jobId, int eventType, String user,\n                    int schedulingClass, String jobName, String logicalJobName) {\n        this.timestamp = timestamp;\n        this.missingInfo = missingInfo;\n        this.jobId = jobId;\n        this.eventType = eventType;\n        this.user = user;\n        this.schedulingClass = schedulingClass;\n        this.jobName = jobName;\n        this.logicalJobName = logicalJobName;\n    }\n\n    public long getTimestamp() { return timestamp; }\n    public long getJobId() { return jobId; }\n    public int getEventType() { return eventType; }\n\n    public boolean isTerminal() {\n        return eventType == 3 || eventType == 4 || eventType == 5;\n    }\n\n    public static JobEvent fromString(String line) {\n        String[] p = line.split(\",\", -1);\n        long ts = parseLong(p, 0);\n        String missing = get(p, 1);\n        long jobId = parseLong(p, 2);\n        int eventType = parseInt(p, 3);\n        String user = get(p, 4);\n        int schedClass = parseInt(p, 5);\n        String jobName = get(p, 6);\n        String logicalJobName = get(p, 7);\n        return new JobEvent(ts, missing, jobId, eventType, user, schedClass, jobName, logicalJobName);\n    }\n\n    private static String get(String[] p, int idx) {\n        if (idx >= p.length) return \"\";\n        return p[idx];\n    }\n\n    private static long parseLong(String[] p, int idx) { return parseLong(get(p, idx)); }\n    private static long parseLong(String s) { return (s == null || s.isEmpty()) ? -1L : Long.parseLong(s); }\n\n    private static int parseInt(String[] p, int idx) { return parseInt(get(p, idx)); }\n    private static int parseInt(String s) { return (s == null || s.isEmpty()) ? -1 : Integer.parseInt(s); }\n}\nEOF\n"]
