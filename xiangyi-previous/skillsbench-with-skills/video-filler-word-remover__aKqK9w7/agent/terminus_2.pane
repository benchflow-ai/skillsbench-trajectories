python3 - <<'PY'
import os, subprocess
seg_path = '/root/segments.txt'
clips_dir = '/root/clips'
concat_list = '/root/concat_list.txt'

# read segments
segments = []
with open(seg_path) as f:
    for line in f:
        if not line.strip():
            continue
        s,e = map(float, line.split())
        if e > s:
            segments.append((s,e))

# extract clips
with open(concat_list, 'w') as f:
    for idx,(s,e) in enumerate(segments,1):
        clip = os.path.join(clips_dir, f"clip{idx:04d}.mp4")
        cmd = [
            'ffmpeg','-y','-ss',str(s),'-to',str(e),'-i','/root/input.mp4',
            '-c:v','libx264','-c:a','aac','-preset','veryfast','-crf','23',clip
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        f.write(f"file '{clip}'\n")
PY
ffmpeg -y -f concat -safe 0 -i /root/concat_list.txt -c copy /root/output.mp4
ls -l /root/annotations.json /root/output.mp4
ls -l /root/annotations.json /root/segments.txt
