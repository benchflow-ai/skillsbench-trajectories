[127.644925, "o", "        if i+L-1 < n and [words[i+k]['word'].lower() for k in range(L)] == seq:\r\n\u001b[?2004l\r"]
[127.645042, "o", "\u001b[?2004h> "]
[127.645154, "o", "            start = words[i]['start']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.645242, "o", "            end = words[i+L-1]['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.645354, "o", "            annotations.append({'word': phrase, 'timestamp': float(start)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.645439, "o", "            segments.append((float(start), float(end)))\r\n\u001b[?2004l\r"]
[127.645524, "o", "\u001b[?2004h> "]
[127.645579, "o", "            i += L\r\n\u001b[?2004l\r\u001b[?2004h>             matched = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.645632, "o", "            break\r\n\u001b[?2004l\r"]
[127.645711, "o", "\u001b[?2004h"]
[127.645808, "o", ">     if matched:\r\n\u001b[?2004l\r"]
[127.645878, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if w in single:\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.645908, "o", "> "]
[127.646041, "o", "        start = float(words[i]['start'])\r\n\u001b[?2004l\r\u001b[?2004h>         end = float(words[i]['end'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.646152, "o", "        annotations.append({'word': w, 'timestamp': start})\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.646232, "o", "> "]
[127.646265, "o", "        segments.append((start, end))\r\n\u001b[?2004l\r\u001b[?2004h>     i += 1\r\n\u001b[?2004l\r"]
[127.646359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[127.646427, "o", "\u001b[?2004h> # save annotations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.646492, "o", "with open('/root/annotations.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.646556, "o", "    json.dump(annotations, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.646593, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # save segments list"]
[127.646691, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.646727, "o", "with open('/root/segments.txt','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.646786, "o", "    for s,e in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
