[128.777497, "i", "python3 - <<'PY'\nimport os, subprocess\nseg_path = '/root/segments.txt'\nclips_dir = '/root/clips'\nconcat_list = '/root/concat_list.txt'\n\n# read segments\nsegments = []\nwith open(seg_path) as f:\n    for line in f:\n        if not line.strip():\n            continue\n        s,e = map(float, line.split())\n        if e > s:\n            segments.append((s,e))\n\n# extract clips\nwith open(concat_list, 'w') as f:\n    for idx,(s,e) in enumerate(segments,1):\n        clip = os.path.join(clips_dir, f\"clip{idx:04d}.mp4\")\n        cmd = [\n            'ffmpeg','-y','-ss',str(s),'-to',str(e),'-i','/root/input.mp4',\n            '-c:v','libx264','-c:a','aac','-preset','veryfast','-crf','23',clip\n        ]\n        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n        f.write(f\"file '{clip}'\\n\")\nPY\n"]
[128.777839, "o", "python3 - <<'PY'\r\nimport os, subprocess\r\nseg_path = '/root/segments.txt'\r\nclips_dir = '/root/clips'\r\nconcat_list = '/root/concat_list.txt'\r\n\r\n# read segments\r\nsegments = []\r\nwith open(seg_path) as f:\r\n    for line in f:\r\n        if not line.strip():\r\n            continue\r\n        s,e = map(float, line.split())\r\n        if e > s:\r\n            segments.append((s,e))\r\n\r\n# extract clips\r\nwith open(concat_list, 'w') as f:\r\n    for idx,(s,e) in enumerate(segments,1):\r\n        clip = os.path.join(clips_dir, f\"clip{idx:04d}.mp4\")\r\n        cmd = [\r\n            'ffmpeg','-y','-ss',str(s),'-to',str(e),'-i','/root/input.mp4',\r\n            '-c:v','libx264','-c:a','aac','-preset','veryfast','-crf','23',clip\r\n        ]\r\n        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n        f.write(f\"file '{clip}'\\n\")\r\nPY\r\n"]
