[127.336694, "o", "\u001b[?2004hroot@c947477b169c:~# "]
[127.641716, "i", "python3 - <<'PY'\nimport wave, json, os\nfrom vosk import Model, KaldiRecognizer\n\nmodel_path = '/root/vosk-model-small-en-us-0.15'\naudio_path = '/root/audio.wav'\nwf = wave.open(audio_path, 'rb')\nmodel = Model(model_path)\nrec = KaldiRecognizer(model, wf.getframerate())\nrec.SetWords(True)\n\nwords = []\nwhile True:\n    data = wf.readframes(4000)\n    if len(data) == 0:\n        break\n    if rec.AcceptWaveform(data):\n        res = json.loads(rec.Result())\n        if 'result' in res:\n            words.extend(res['result'])\nres = json.loads(rec.FinalResult())\nif 'result' in res:\n    words.extend(res['result'])\n\nsingle = {'um','uh','hum','hmm','mhm','like','yeah','so','basically','well','okay'}\nmulti = [(['you','know'],'you know'), (['i','mean'],'i mean'), (['kind','of'],'kind of'), (['i','guess'],'i guess')]\n\nannotations = []\nsegments = []\n\ni = 0\nn = len(words)\nwhile i < n:\n    w = words[i]['word'].lower()\n    matched = False\n    for seq, phrase in multi:\n        L = len(seq)\n        if i+L-1 < n and [words[i+k]['word'].lower() for k in range(L)] == seq:\n            start = words[i]['start']\n            end = words[i+L-1]['end']\n            annotations.append({'word': phrase, 'timestamp': float(start)})\n            segments.append((float(start), float(end)))\n            i += L\n            matched = True\n            break\n    if matched:\n        continue\n    if w in single:\n        start = float(words[i]['start'])\n        end = float(words[i]['end'])\n        annotations.append({'word': w, 'timestamp': start})\n        segments.append((start, end))\n    i += 1\n\n# save annotations\nwith open('/root/annotations.json','w') as f:\n    json.dump(annotations, f, indent=2)\n\n# save segments list\nwith open('/root/segments.txt','w') as f:\n    for s,e in segments:\n        if e > s:\n            f.write(f\"{s} {e}\\n\")\n\nprint('annotations:', len(annotations))\nPY\n"]
