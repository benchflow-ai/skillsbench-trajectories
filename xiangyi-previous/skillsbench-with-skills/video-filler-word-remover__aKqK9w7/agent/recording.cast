[190.543495, "o", "-rw-r--r-- 1 root root 5206 Jan 26 12:43 /root/annotations.json\r\n-rw-r--r-- 1 root root 1374 Jan 26 12:43 /root/segments.txt\r\n"]
[190.543654, "o", "\u001b[?2004h"]
[190.54368, "o", "root@c947477b169c:~# "]
[190.543777, "o", "mkdir -p /root/clips\r\n\u001b[?2004l\r"]
[190.545139, "o", "\u001b[?2004hroot@c947477b169c:~# "]
[190.545258, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[190.545307, "o", "\u001b[?2004h> import os, subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.54539, "o", "> "]
[190.54546, "o", "seg_path = '/root/segments.txt'\r\n\u001b[?2004l\r"]
[190.545494, "o", "\u001b[?2004h> "]
[190.545533, "o", "clips_dir = '/root/clips'\r\n\u001b[?2004l\r"]
[190.54561, "o", "\u001b[?2004h> "]
[190.545689, "o", "concat_list = '/root/concat_list.txt'\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.545759, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.545809, "o", "segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.545863, "o", "with open(seg_path) as f:\r\n\u001b[?2004l\r"]
[190.545913, "o", "\u001b[?2004h"]
[190.545991, "o", "> "]
[190.546042, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546131, "o", "        if not line.strip():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546183, "o", "            continue\r\n\u001b[?2004l\r"]
[190.546234, "o", "\u001b[?2004h> "]
[190.546345, "o", "        s,e = map(float, line.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546435, "o", "        if e > s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546518, "o", "            segments.append((s,e))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546574, "o", "with open(concat_list, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546651, "o", "    for idx,(s,e) in enumerate(segments,1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.546791, "o", "        clip = os.path.join(clips_dir, f\"clip{idx:04d}.mp4\")\r\n\u001b[?2004l\r\u001b[?2004h>         cmd = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.546858, "o", "> "]
[190.546931, "o", "            'ffmpeg','-y','-ss',str(s),'-to',str(e),'-i','/root/input.mp4',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.547131, "o", "            '-c:v','libx264','-c:a','aac','-preset','veryfast','-crf','23',clip\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.5472, "o", ">         ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.547406, "o", "        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r"]
[190.547494, "o", "\u001b[?2004h>         f.write(f\"file '{clip}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.547558, "o", "> PY\r\n\u001b[?2004l\r"]
[195.291552, "i", "ffmpeg -y -f concat -safe 0 -i /root/concat_list.txt -c copy /root/output.mp4\n"]
[195.291774, "o", "ffmpeg -y -f concat -safe 0 -i /root/concat_list.txt -c copy /root/output.mp4\r\n"]
[195.783608, "i", "ls -l /root/annotations.json /root/output.mp4\n"]
[195.783808, "o", "ls -l /root/annotations.json /root/output.mp4\r\n"]
