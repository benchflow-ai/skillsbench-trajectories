 Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_connection_handler.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1698\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t    send_msg(ssh_connection:\u001b[01;31m\u001b[Kchannel_request\u001b[m\u001b[K_msg(Id, Type, WantReply, Data),\r\n"]
