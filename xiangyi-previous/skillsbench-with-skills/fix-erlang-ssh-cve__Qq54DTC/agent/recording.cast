[180.942877, "o", "\r\n   166\t    {ok, StateName, State}.\r\n   167\t\r\n"]
[180.942895, "o", "   168\t%%====================================================================\r\n   169\t%% Internal functions\r\n   170\t%%====================================================================\r\n   171\t\r\n   172\tconnected_state(Reply, Ssh1, User, Method, D0) ->\r\n   173\t    D1 = #data{ssh_params=Ssh} =\r\n   174\t        ssh_connection_handler:send_msg(Reply, D0#data{ssh_params = Ssh1}),"]
[180.942914, "o", "\r\n   175\t    ssh_connection_handler:handshake(ssh_connected, D1),\r\n   176\t    connected_fun(User, Method, D1),\r\n   177\t    D1#data{auth_user=User,\r\n   178\t            %% Note: authenticated=true MUST NOT be sent\r\n   179\t            %% before send_msg!\r\n   180\t            ssh_params = Ssh#ssh{authenticated = true}}.\r\n   181\t\r\n   182\t\r\n"]
[180.942932, "o", "   183\tset_max_initial_idle_timeout(#data{ssh_params = #ssh{opts=Opts}}) ->\r\n   184\t    {{timeout,max_initial_idle_time}, ?GET_OPT(max_initial_idle_time,Opts), none}.\r\n   185\t\r\n   186\tconnected_fun(User, Method, #data{ssh_params = #ssh{peer = {_,Peer}}} = D) ->\r\n   187\t    ?CALL_FUN(connectfun,D)(User, Peer, Method).\r\n"]
[180.942954, "o", "   188\t\r\n   189\t\r\n   190\tretry_fun(_, undefined, _) ->\r\n   191\t    ok;\r\n   192\tretry_fun(User, Reason, #data{ssh_params = #ssh{opts = Opts,\r\n   193\t\t\t\t\t\t\tpeer = {_,Peer}\r\n   194\t\t\t\t"]
[180.942974, "o", "\t\t       }}) ->\r\n   195\t    {Tag,Info} =\r\n   196\t\tcase Reason of\r\n   197\t\t    {error, Error} ->\r\n   198\t\t\t{failfun, Error};\r\n   199\t\t    _ ->\r\n   200\t\t\t{infofun, Reason}\r\n   201\t\tend,\r\n   202\t    Fun = ?GET_OPT(Tag, Opts),\r\n   203\t    try erlang:fun_info(Fun, arity)\r\n   204\t    of\r\n   205"]
[180.942996, "o", "\t\t{arity, 2} -> %% Backwards compatible\r\n   206\t\t    catch Fun(User, Info);\r\n   207\t\t{arity, 3} ->\r\n   208\t\t    catch Fun(User, Peer, Info);\r\n   209\t\t_ ->\r\n   210\t\t    ok\r\n   211\t    catch\r\n   212\t\t_:_ ->\r\n   213\t\t    ok\r\n   214\t    end.\r\n   215\t\r\n"]
