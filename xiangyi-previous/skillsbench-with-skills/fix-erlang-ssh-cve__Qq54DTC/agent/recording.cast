[238.584155, "o", "\u001b[32m\u001b[K781\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t{ConnReplies, NonConnReplies} = lists:splitwith(fun \u001b[01;31m\u001b[Knot_connected_filter\u001b[m\u001b[K/1, Replies),\r\n"]
[238.584187, "o", "\u001b[32m\u001b[K1999\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Knot_connected_filter\u001b[m\u001b[K({connection_reply, _Data}) -> true;\r\n\u001b[32m\u001b[K2000\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Knot_connected_filter\u001b[m\u001b[K(_) -> false.\r\n"]
