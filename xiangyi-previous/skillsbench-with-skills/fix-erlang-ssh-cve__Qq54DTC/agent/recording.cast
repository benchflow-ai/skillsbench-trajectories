[180.942705, "o", "\t\t\t    retry_fun(User, Reason, D0),\r\n   101\t                            D = ssh_connection_handler:send_msg(Reply, D0#data{ssh_params = Ssh}),\r\n   102\t\t\t\t    {keep_state, D}\r\n   103\t\t"]
[180.942726, "o", "\t    end;\r\n   104\t\t\tfalse ->\r\n   105\t\t\t    %% No we do not support this method (=/= none)\r\n   106\t\t\t    %% At least one non-erlang client does like this. Retry as the next event\r\n   107\t\t\t    {keep_state_and_data,\r\n   108\t\t\t     [{next_event, internal, Msg#ssh_msg_userauth_request{method=\"none\"}}]\r\n   109\t\t\t    }\r\n   110\t\t    end;\r\n   111"]
[180.942745, "o", "\t\r\n   112\t\t%% {\"ssh-connection\", Expected, Method} when Expected =/= ServiceName -> Do what?\r\n   113\t\t%% {ServiceName,      Expected, Method} when Expected =/= ServiceName -> Do what?\r\n   114\t\r\n   115\t\t{ServiceName, _, _} when ServiceName =/= \"ssh-connection\" ->\r\n   116\t            {Shutdown, D} =  \r\n   117\t                ?send_disconnect(?SSH_DISCONNECT_SERVICE_NOT_AVAILABLE,\r\n   118\t                                 io_lib:format(\"Unknown service: ~p\",[ServiceName]),\r\n   119"]
