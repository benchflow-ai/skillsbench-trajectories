[180.942786, "o", "\r\n   122\t\r\n   123\thandle_event(internal, #ssh_msg_userauth_info_response{} = Msg, {userauth_keyboard_interactive, server}, D0) ->\r\n   124\t    case ssh_auth:handle_userauth_info_response(Msg, D0#data.ssh_params) of\r\n   125\t\t{authorized, User, {Reply, Ssh1}} ->\r\n   126\t            D = connected_state(Reply, Ssh1, User, \"keyboard-interactive\", D0),\r\n   127\t            {next_state, {connected,server}, D,\r\n   128\t             [set_max_initial_idle_timeout(D),\r\n"]
