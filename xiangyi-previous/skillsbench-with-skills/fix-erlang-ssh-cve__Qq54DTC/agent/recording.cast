[219.710915, "o", "\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K-define(\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg),\r\n"]
[219.710956, "o", "\u001b[32m\u001b[K1161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_global_request{}            = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1162\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_request_success{}           = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_request_failure{}           = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                                                ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)\r\n\u001b[32m\u001b[K1168\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_open_confirmation{} = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1169\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_open_failure{}      = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n"]
[219.710993, "o", "\u001b[32m\u001b[K1170\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_window_adjust{}     = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1171\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_data{}              = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_extended_data{}     = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1173\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_eof{}               = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1174\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_close{}             = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n"]
[219.711025, "o", "\u001b[32m\u001b[K1175\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_request{}           = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1176\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_failure{}           = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n\u001b[32m\u001b[K1177\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                #ssh_msg_channel_success{}           = Msg -> {keep_state, D1, ?\u001b[01;31m\u001b[KCONNECTION_MSG\u001b[m\u001b[K(Msg)};\r\n"]
