[557.286944, "o", "nl -ba lib/ssh/src/ssh_connection_handler.erl | sed -n '748,780p'\r\n\u001b[?2004l\r"]
[557.288568, "o", "   748\thandle_event(internal, #ssh_msg_unimplemented{}, _StateName, _) ->\r\n   749\t    keep_state_and_data;\r\n   750\t\r\n   751\t%% Quick fix of failing test case (ssh_options_SUITE:ssh_msg_debug_fun_option_{client|server}/1)\r\n   752\thandle_event(cast, #ssh_msg_debug{} = Msg, State, D) ->\r\n   753\t    handle_event(internal, Msg, State, D);\r\n   754\t\r\n   755\thandle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n   756\t    debug_fun(Msg, D),\r\n   757\t    keep_state_and_data;\r\n   758\t\r\n   759\t%% Connection protocol messages must not be handled before authentication.\r\n   760\t%% Handling them early may lead to starting CLI/exec channels without auth.\r\n   761\thandle_event(internal, {conn_msg,_Msg}, StateName,\r\n   762\t             #data{ssh_params = #ssh{authenticated = false}} = D0)\r\n   763\t  when not ?CONNECTED(StateName) ->\r\n   764\t    {Shutdown, D} =\r\n   765\t        ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\r\n   766\t                         \"Received SSH connection message before authentication\",\r\n   767\t                         StateName, D0),\r\n   768\t    {stop, Shutdown, D};\r\n   769\t\r\n   770\thandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n   771\t                                                        event_queue = Qev0} = D0) ->\r\n   772\t    Role = ?role(StateName),\r\n   773\t    Rengotation = renegotiation(StateName),\r\n   774\t    try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of\r\n   775\t\t{disconnect, Reason0, RepliesConn} ->\r\n   776\t            {Repls, D} = send_replies(RepliesConn, D0),\r\n   777\t            case {Reason0,Role} of\r\n   778\t                {{_, Reason}, client} when ((StateName =/= {connected,client})\r\n   779\t                                            and (not Rengotation)) ->\r\n   780\t                    handshake({not_connected,Reason}, D);\r\n"]
[557.289386, "o", "\u001b[?2004hroot@b785f6759156:/app/workspace/otp_src_27.3.2# "]
