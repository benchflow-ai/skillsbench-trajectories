[378.154373, "i", "nl -ba lib/ssh/src/ssh_connection_handler.erl | sed -n '300,420p'\n"]
[378.155586, "o", "nl -ba lib/ssh/src/ssh_connection_handler.erl | sed -n '300,420p'\r\n\u001b[?2004l\r"]
[378.157251, "o", "   300\t%%--------------------------------------------------------------------\r\n   301\tconnection_info(ConnectionHandler, []) ->\r\n   302\t    connection_info(ConnectionHandler, conn_info_keys());\r\n   303\tconnection_info(ConnectionHandler, Key) when is_atom(Key) ->\r\n   304\t    case connection_info(ConnectionHandler, [Key]) of\r\n   305\t        [{Key,Val}] -> {Key,Val};\r\n   306\t        Other -> Other\r\n   307\t    end;\r\n"]
[378.157773, "o", "   308\tconnection_info(ConnectionHandler, Options) ->\r\n   309\t    call(ConnectionHandler, {connection_info, Options}).\r\n   310\t\r\n   311\t%%--------------------------------------------------------------------\r\n   312\t-spec channel_info(connection_ref(),\r\n   313\t\t\t   channel_id(),\r\n   314\t\t\t   [atom()]\r\n   315\t\t\t  ) -> proplists:proplist().\r\n   316\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   317\tchannel_info(ConnectionHandler, ChannelId, Options) ->\r\n   318\t    call(ConnectionHandler, {channel_info, ChannelId, Options}).\r\n   319\t\r\n   320\t%%--------------------------------------------------------------------\r\n   321\t-spec adjust_window(connection_ref(),\r\n   322\t\t\t    channel_id(),\r\n   323\t\t\t    integer()\r\n   324\t\t\t   ) -> ok.\r\n   325\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   326\tadjust_window(ConnectionHandler, Channel, Bytes) ->\r\n   327\t    cast(ConnectionHandler, {adjust_window, Channel, Bytes}).\r\n   328\t\r\n   329\t%%--------------------------------------------------------------------\r\n   330\t-spec close(connection_ref(),\r\n   331\t\t    channel_id()\r\n   332\t\t   ) -> ok.\r\n   333\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   334\tclose(ConnectionHandler, ChannelId) ->\r\n   335\t    case call(ConnectionHandler, {close, ChannelId}) of\r\n   336\t\tok ->\r\n   337\t\t    ok;\r\n   338\t\t{error, closed} ->\r\n   339\t\t    ok\r\n   340\t    end.\r\n   341\t\r\n   342"]
[378.157958, "o", "\t\r\n   343\t%%--------------------------------------------------------------------\r\n   344\tstore(ConnectionHandler, Key, Value) ->\r\n   345\t    cast(ConnectionHandler, {store,Key,Value}).\r\n   346\t\r\n   347\tretrieve(#connection{options=Opts}, Key) ->\r\n   348\t    try ?GET_INTERNAL_OPT(Key, Opts) of\r\n   349\t        Value ->\r\n   350\t            {ok,Value}\r\n   351\t    catch\r\n   352\t        error:{badkey,Key} ->\r\n   353\t            undefined\r\n   354\t    end;\r\n   355\tretrieve(ConnectionHandler, Key) ->\r\n   356\t    call(ConnectionHandler, {retrieve,Key}).\r\n   357\t\r\n   358\t%%--------------------------------------------------------------------\r\n   359\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   360\tset_sock_opts(ConnectionRef, SocketOptions) ->\r\n   361\t    try lists:foldr(fun({Name,_Val}, Acc) ->\r\n   362\t                            case prohibited_sock_option(Name) of\r\n   363\t                                true -> [Name|Acc];\r\n   364\t                                false -> Acc\r\n   365\t                            end\r\n   366\t                    end, [], SocketOptions)\r\n   367\t    of\r\n   368\t        [] ->\r\n   369\t            call(ConnectionRef, {set_sock_opts,SocketOptions});\r\n   370\t        Bad ->\r\n   371\t            {error, {not_allowed,Bad}}\r\n   372\t    catch\r\n   373\t        _:_ ->\r\n   374\t            {error, badarg}\r\n   375\t    end.\r\n   376\t\r\n   377\tprohibited_sock_option(active)    -> true;\r\n   378\tprohibited_sock_option(deliver)   -> true;\r\n   379\tprohibited_sock_option(mode)      -> true;\r\n   380\tprohibited_sock_option(packet)    -> true;\r\n   381\tprohibited_sock_option(_) -> false.\r\n   382\t\r\n   383\t%%--------------------------------------------------------------------\r\n   384\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   385\tget_sock_opts(ConnectionRef, SocketGetOptions) ->\r\n   386\t    call(ConnectionRef, {get_sock_opts,SocketGetOptions}).\r\n   387\t\r\n   388\t%%====================================================================\r\n   389\t%% Test support\r\n   390\t%%====================================================================\r\n   391\t%%--------------------------------------------------------------------\r\n   392\t-spec renegotiate(connection_ref()\r\n   393\t\t\t ) -> ok.\r\n   394\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n"]
[378.158924, "o", "   395\trenegotiate(ConnectionHandler) ->\r\n   396\t    cast(ConnectionHandler, force_renegotiate).\r\n   397\t\r\n   398\t%%--------------------------------------------------------------------\r\n   399\talg(ConnectionHandler) ->\r\n   400\t    call(ConnectionHandler, get_alg).\r\n   401\t\r\n   402\t%%====================================================================\r\n   403\t%% Intitialisation\r\n   404\t%%====================================================================\r\n   405\tinit([Role, Socket, Opts]) when Role==client ; Role==server ->\r\n   406\t    process_flag(trap_exit, true),\r\n   407\t    %% ssh_params will be updated after receiving socket_control event\r\n   408\t    %% in wait_for_socket state;\r\n   409\t    D = #data{socket = Socket, ssh_params = #ssh{role = Role, opts = Opts}},\r\n   410\t    {ok, {wait_for_socket, Role}, D}.\r\n   411\t\r\n   412\t%%%----------------------------------------------------------------\r\n   413\t%%% Connection start and initialization helpers\r\n   414\tinit_connection_record(Role, Socket, Opts) ->\r\n   415\t    {WinSz, PktSz} = init_inet_buffers_window(Socket),\r\n   416\t    C = #connection{channel_cache = ssh_client_channel:cache_create(),\r\n   417\t                    channel_id_seed = 0,\r\n   418\t                    suggest_window_size = WinSz,\r\n   419\t                    suggest_packet_size = PktSz,\r\n   420\t                    requests = [],\r\n"]
[378.159116, "o", "\u001b[?2004hroot@b785f6759156:/app/workspace/otp_src_27.3.2# "]
[378.388202, "i", "nl -ba lib/ssh/src/ssh_connection_handler.erl | sed -n '620,720p'\n"]
[378.388692, "o", "nl -ba lib/ssh/src/ssh_connection_handler.erl | sed -n '620,720p'\r\n\u001b[?2004l\r"]
[378.391453, "o", "   620\t\t    inet:setopts(Socket, [{packet, line},\r\n   621\t\t\t\t\t  {active, once},\r\n   622\t\t\t\t\t  % Expecting the version string which might\r\n   623\t\t\t\t\t  % be max ?MAX_PROTO_VERSION bytes:\r\n   624\t\t\t\t\t  {recbuf, ?MAX_PROTO_VERSION},\r\n   625\t\t\t\t\t  {nodelay,true}]),\r\n   626\t            Time = ?GET_OPT(hello_timeout, Ssh0#ssh.opts, infinity),\r\n   627\t\t    {keep_state, D#data{inet_initial_recbuf_size=Size}, [{state_timeout,Time,no_hello_received}] };\r\n   628\t\r\n   629\t\tOther ->\r\n   630\t            ?call_disconnectfun_and_log_cond(\"Option return\", \r\n   631\t                                             io_lib:format(\"Unexpected getopts return:~n  ~p\",[Other]),\r\n   632\t                                             StateName, D),\r\n   633\t\t    {stop, {shutdown,{unexpected_getopts_return, Other}}}\r\n   634\t    end;\r\n   635\t\r\n   636\thandle_event(internal, {info_line,_Line}, {hello,client}, D) ->\r\n   637\t    %% The server may send info lines to the client before the version_exchange\r\n   638\t    %% RFC4253/4.2\r\n   639\t    inet:setopts(D#data.socket, [{active, once}]),\r\n   640\t    keep_state_and_data;\r\n   641\t\r\n   642\thandle_event(internal, {info_line,Line}, {hello,server}=StateName, D) ->\r\n   643\t    %% But the client may NOT send them to the server. Openssh answers with cleartext,\r\n   644\t    %% and so do we\r\n   645\t    send_bytes(\"Protocol mismatch.\", D),\r\n   646\t    Msg = io_lib:format(\"Protocol mismatch in version exchange. Client sent info lines.~n~s\",\r\n   647\t                        [ssh_dbg:hex_dump(Line, 64)]),\r\n   648\t    ?call_disconnectfun_and_log_cond(\"Protocol mismatch.\", Msg, StateName, D),\r\n   649\t    {stop, {shutdown,\"Protocol mismatch in version exchange. Client sent info lines.\"}};\r\n   650\t\r\n   651\thandle_event(internal, {version_exchange,Version}, {hello,Role}, D0) ->\r\n   652\t    {NumVsn, StrVsn} = ssh_transport:handle_hello_version(Version),\r\n   653\t    case handle_version(NumVsn, StrVsn, D0#data.ssh_params) of\r\n   654\t\t{ok, Ssh1} ->\r\n   655\t\t    %% Since the hello part is finished correctly, we set the\r\n   656\t\t    %% socket to the packet handling mode (including recbuf size):\r\n   657\t\t    inet:setopts(D0#data.socket, [{packet,0},\r\n   658\t\t\t\t\t\t {mode,binary},\r\n   659\t\t\t\t\t\t {active, once},\r\n   660\t\t\t\t\t\t {recbuf, D0#data.inet_initial_recbuf_size}]),\r\n   661\t\t    {KeyInitMsg, SshPacket, Ssh} = ssh_transport:key_exchange_init_msg(Ssh1),\r\n"]
[378.391546, "o", "   662\t\t    send_bytes(SshPacket, D0),\r\n   663\t            D = D0#data{ssh_params = Ssh,\r\n   664\t                        key_exchange_init_msg = KeyInitMsg},\r\n   665\t\t    {next_state, {kexinit,Role,init}, D, {change_callback_module, ssh_fsm_kexinit}};\r\n   666\t\r\n   667\t\tnot_supported ->\r\n   668\t            {Shutdown, D} =\r\n   669\t                ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_VERSION_NOT_SUPPORTED,\r\n   670\t                                 io_lib:format(\"Offending version is ~p\",[string:chomp(Version)]),\r\n   671\t                                 {hello,Role},\r\n   672\t                                 D0),\r\n   673\t\t    {stop, Shutdown, D}\r\n   674\t    end;\r\n   675\t\r\n   676\t%%% timeout after tcp:connect but then nothing arrives\r\n   677\thandle_event(state_timeout, no_hello_received, {hello,_Role}=StateName, D0 = #data{ssh_params = Ssh0}) ->\r\n   678\t    MsgFun =\r\n   679\t        fun (debug) ->\r\n   680\t                Time = ?GET_OPT(hello_timeout, Ssh0#ssh.opts),\r\n   681\t                lists:concat([\"No HELLO received within \",ssh_lib:format_time_ms(Time)]);\r\n   682\t            (_) ->\r\n   683\t                [\"No HELLO received within hello_timeout\"]\r\n   684\t        end,\r\n   685\t    {Shutdown, D} =\r\n   686\t        ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, ?SELECT_MSG(MsgFun), StateName, D0),\r\n   687\t    {stop, Shutdown, D};\r\n   688\t\r\n   689\t\r\n   690\t%%% ######## {service_request, client|server} ####\r\n   691\t\r\n   692\thandle_event(internal, Msg = #ssh_msg_service_request{name=ServiceName}, StateName = {service_request,server}, D0) ->\r\n   693\t    case ServiceName of\r\n   694\t\t\"ssh-userauth\" ->\r\n   695\t\t    Ssh0 = #ssh{session_id=SessionId} = D0#data.ssh_params,\r\n   696\t\t    {ok, {Reply, Ssh}} = ssh_auth:handle_userauth_request(Msg, SessionId, Ssh0),\r\n   697\t            D = send_msg(Reply, D0#data{ssh_params = Ssh}),\r\n   698\t\t    {next_state, {userauth,server}, D, {change_callback_module,ssh_fsm_userauth_server}};\r\n   699\t\r\n   700\t\t_ ->\r\n   701\t            {Shutdown, D} =\r\n   702\t                ?send_disconnect(?SSH_DISCONNECT_SERVICE_NOT_AVAILABLE,\r\n   703\t                                 io_lib:format(\"Unknown service: ~p\",[ServiceName]),\r\n   704\t                                 StateName, D0),\r\n   705\t            {stop, Shutdown, D}\r\n   706\t    end;\r\n   707\t\r\n   708\thandle_event(internal, #ssh_msg_service_accept{name = \"ssh-userauth\"}, {service_request,client},\r\n   709\t\t     #data{ssh_params = #ssh{service=\"ssh-userauth\"} = Ssh0} = D0) ->\r\n   710\t    {Msg, Ssh} = ssh_auth:init_userauth_request_msg(Ssh0),\r\n   711\t    D = send_msg(Msg, D0#data{ssh_params = Ssh,\r\n   712\t                              auth_user = Ssh#ssh.user\r\n   713\t                             }),\r\n   714\t    {next_state, {userauth,client}, D, {change_callback_module,ssh_fsm_userauth_client}};\r\n   715\t\r\n   716\t\r\n   717\t%% Skip ext_info messages in connected state (for example from OpenSSH >= 7.7)\r\n   718\thandle_event(internal, #ssh_msg_ext_info{}, {connected,_Role}, D) ->\r\n   719\t    {keep_state, D};\r\n   720\t\r\n"]
