[278.810772, "o", "  1960\t\r\n  1961\tlimit_size(S, MaxLen) when is_integer(MaxLen) ->\r\n  1962\t    limit_size(S, lists:flatlength(S), MaxLen);\r\n  1963\tlimit_size(S, _) ->\r\n  1964\t"]
[278.810842, "o", "    S.\r\n  1965\t\r\n  1966\tlimit_size(S, Len, MaxLen) when Len =< MaxLen ->\r\n  1967\t    S;\r\n  1968\tlimit_size(S, Len, MaxLen) when Len =< (MaxLen + 5) ->\r\n  1969\t    %% Looks silly with e.g \"... (2 bytes skipped)\"\r\n  1970\t    S;\r\n  1971\tlimit_size(S, Len, MaxLen) when Len > MaxLen ->\r\n  1972\t    %% Cut\r\n  1973\t    io_lib:format(\"~s ... (~w bytes skipped)\",\r\n  1974\t                  [string:substr(lists:flatten(S), 1, MaxLen),\r\n  1975\t                   Len-MaxLen]).\r\n  1976\t\r\n  1977\t"]
[278.810881, "o", "crypto_log_info() ->\r\n  1978\t    try\r\n  1979\t        [{_,_,CI}] = crypto:info_lib(),\r\n  1980\t        case crypto:info_fips() of\r\n  1981\t            enabled ->\r\n  1982\t                <<\"(\",CI/binary,\". FIPS enabled)\">>;\r\n  1983\t            not_enabled ->\r\n  1984\t                <<\"(\",CI/binary,\". FIPS available but not enabled)\">>;\r\n  1985\t            _ ->\r\n"]
[278.810922, "o", "  1986\t                <<\"(\",CI/binary,\")\">>\r\n  1987\t        end\r\n  1988\t    catch\r\n  1989\t        _:_ -> \"\"\r\n  1990\t    end.\r\n  1991\t\r\n"]
[278.81096, "o", "  1992\tssh_log_version() ->\r\n  1993\t    case application:get_key(ssh,vsn) of\r\n  1994\t        {ok,Vsn} -> Vsn;\r\n  1995\t        undefined -> \"\"\r\n  1996\t    end.\r\n  1997\t\r\n  1998\t%%%----------------------------------------------------------------\r\n  1999\tnot_connected_filter({connection_reply, _Data}) -> true;\r\n  2000\tnot_connected_filter(_) -> false.\r\n  2001"]
[278.810998, "o", "\t\r\n  2002\t%%%----------------------------------------------------------------\r\n  2003\t\r\n  2004\tsend_replies({Repls,C = #connection{}}, D) when is_list(Repls) ->\r\n  2005\t    send_replies(Repls, D#data{connection_state=C});\r\n  2006"]
[278.811031, "o", "\tsend_replies(Repls, State) ->\r\n  2007\t    lists:foldl(fun get_repl/2, {[],State}, Repls).\r\n  2008\t\r\n  2009\tget_repl({connection_reply,Msg}, {CallRepls,S}) ->\r\n  2010\t    if is_record(Msg, ssh_msg_channel_success) ->\r\n  2011\t\t    update_inet_buffers(S#data.socket);\r\n  2012\t       true ->\r\n  2013\t\t"]
[278.811072, "o", "    ok\r\n  2014\t    end,\r\n  2015\t    {CallRepls, send_msg(Msg,S)};\r\n  2016\tget_repl({channel_data,undefined,_Data}, Acc) ->\r\n  2017\t    Acc;\r\n  2018\tget_repl({channel_data,Pid,Data}, Acc) ->\r\n"]
[278.81111, "o", "  2019\t    Pid ! {ssh_cm, self(), Data},\r\n  2020\t    Acc;\r\n  2021\tget_repl({channel_request_reply,From,Data}, {CallRepls,S}) ->\r\n  2022\t    {[{reply,From,Data}|CallRepls], S};\r\n  2023\tget_repl({flow_control,Cache,Channel,From,Msg}, {CallRepls,S}) ->\r\n  2024\t    ssh_client_channel:cache_update(Cache, Channel#channel{flow_control = undefined}),\r\n  2025\t    {[{reply,From,Msg}|CallRepls], S};\r\n"]
