[260.38982, "o", "   820\t    case StateName of\r\n   821\t        {connected,Role} ->\r\n   822\t            start_rekeying(Role, D0);\r\n   823\t        {ext_info,Role,renegotiate} ->\r\n   824\t            start_rekeying(Role, D0);\r\n   825\t        _ ->\r\n   826\t            %% Wrong state for starting a renegotiation, must be in re-negotiation\r\n   827\t            keep_state_and_data\r\n   828\t    end;\r\n   829\t\r\n   830\thandle_event({timeout,check_data_size}, _, StateName, D0) ->\r\n   831\t    %% Rekey due to sent data limit reached? (Can't be in {ext_info,...} if data is sent)\r\n   832\t    case StateName of\r\n   833\t        {connected,Role} ->\r\n   834\t            check_data_rekeying(Role, D0);\r\n   835\t        _ ->\r\n   836\t            %% Wrong state for starting a renegotiation, must be in re-negotiation\r\n   837\t            keep_state_and_data\r\n   838\t    end;\r\n   839\t\r\n   840\thandle_event({call,From}, get_alg, _, D) ->\r\n   841\t    #ssh{algorithms=Algs} = D#data.ssh_params,\r\n   842\t    {keep_state_and_data, [{reply,From,Algs}]};\r\n   843\t\r\n   844\thandle_event(cast, _, StateName, _) when not ?CONNECTED(StateName) ->\r\n"]
[260.389926, "o", "   845\t    {keep_state_and_data, [postpone]};\r\n   846\t\r\n   847\thandle_event(cast, {adjust_window,ChannelId,Bytes}, StateName, D) when ?CONNECTED(StateName) ->\r\n   848\t    case ssh_client_channel:cache_lookup(cache(D), ChannelId) of\r\n   849\t\t#channel{recv_window_size = WinSize,\r\n   850\t\t\t recv_window_pending = Pending,\r\n   851\t\t\t recv_packet_size = PktSize} = Channel\r\n   852\t\t  when (WinSize-Bytes) >= 2*PktSize ->\r\n   853\t\t    %% The peer can send at least two more *full* packet, no hurry.\r\n   854\t\t    ssh_client_channel:cache_update(cache(D),\r\n   855\t\t\t\t\t     Channel#channel{recv_window_pending = Pending + Bytes}),\r\n   856\t\t    keep_state_and_data;\r\n   857\t\r\n   858\t\t#channel{recv_window_size = WinSize,\r\n   859\t\t\t recv_window_pending = Pending,\r\n   860\t\t\t remote_id = Id} = Channel ->\r\n   861\t\t    %% Now we have to update the window - we can't receive so many more pkts\r\n   862\t\t    ssh_client_channel:cache_update(cache(D),\r\n   863\t\t\t\t\t     Channel#channel{recv_window_size =\r\n   864\t\t\t\t\t\t\t\t WinSize + Bytes + Pending,\r\n   865\t\t\t\t\t\t\t"]
[260.389986, "o", "     recv_window_pending = 0}),\r\n   866\t\t    Msg = ssh_connection:channel_adjust_window_msg(Id, Bytes + Pending),\r\n   867\t\t    {keep_state, send_msg(Msg,D)};\r\n   868\t\r\n   869\t\tundefined ->\r\n   870\t\t    keep_state_and_data\r\n   871\t    end;\r\n   872\t\r\n   873\thandle_event(cast, {reply_request,Resp,ChannelId}, StateName, D) when ?CONNECTED(StateName) ->\r\n   874\t    case ssh_client_channel:cache_lookup(cache(D), ChannelId) of\r\n   875\t        #channel{remote_id = RemoteId} when Resp== success ; Resp==failure ->\r\n   876\t            Msg =\r\n   877\t                case Resp of\r\n   878\t                    success -> ssh_connection:channel_success_msg(RemoteId);\r\n   879\t                    failure -> ssh_connection:channel_failure_msg(RemoteId)\r\n   880\t                end,\r\n   881\t            update_inet_buffers(D#data.socket),\r\n   882\t            {keep_state, send_msg(Msg,D)};\r\n   883\t\r\n   884\t        #channel{} ->\r\n"]
[260.390036, "o", "   885\t            Details = io_lib:format(\"Unhandled reply in state ~p:~n~p\", [StateName,Resp]),\r\n   886\t            {_Shutdown, D1} =\r\n   887\t                ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, Details, StateName, D),\r\n   888\t            {keep_state, D1};\r\n   889\t\r\n   890\t\tundefined ->\r\n   891\t\t    keep_state_and_data\r\n   892\t    end;\r\n   893\t\r\n   894\thandle_event(cast, {request,ChannelPid, ChannelId, Type, Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n   895\t    {keep_state,  handle_request(ChannelPid, ChannelId, Type, Data, false, none, D)};\r\n   896\t\r\n   897\thandle_event(cast, {request,ChannelId,Type,Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n   898\t    {keep_state,  handle_request(ChannelId, Type, Data, false, none, D)};\r\n   899\t\r\n   900\thandle_event(cast, {unknown,Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n   901\t    Msg = #ssh_msg_unimplemented{sequence = Data},\r\n   902\t    {keep_state, send_msg(Msg,D)};\r\n   903\t\r\n   904\thandle_event(cast, {global_request, Type, Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n   905\t    {keep_state, send_msg(ssh_connection:request_global_msg(Type,false,Data), D)};\r\n   906\t\r\n   907\t\r\n   908\t%%% Previously handle_sync_event began here\r\n   909\thandle_event({call,From}, get_print_info, StateName, D) ->\r\n   910\t    Reply =\r\n   911\t\ttry\r\n   912"]
