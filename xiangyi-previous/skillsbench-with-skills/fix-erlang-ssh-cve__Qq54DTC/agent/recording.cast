[519.259431, "o", "   740\t                io_lib:format(\"strict KEX violation: unexpected SSH_MSG_IGNORE \"\r\n   741\t                              \"send_sequence = ~p  recv_sequence = ~p\",\r\n   742\t                              [SendSeq, RecvSeq])\r\n"]
[519.260213, "o", "   743\t               );\r\n   744\t\r\n   745\thandle_event(internal, #ssh_msg_ignore{}, _StateName, _) ->\r\n   746\t    keep_state_and_data;\r\n   747\t\r\n   748\thandle_event(internal, #ssh_msg_unimplemented{}, _StateName, _) ->\r\n   749\t    keep_state_and_data;\r\n   750\t\r\n   751\t%% Quick fix of failing test case (ssh_options_SUITE:ssh_msg_debug_fun_option_{client|server}/1)\r\n   752\thandle_event(cast, #ssh_msg_debug{} = Msg, State, D) ->\r\n   753\t    handle_event(internal, Msg, State, D);\r\n   754\t\r\n   755\thandle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n   756\t    debug_fun(Msg, D),\r\n   757\t    keep_state_and_data;\r\n   758\t\r\n   759\thandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n   760\t                                                        event_queue = Qev0} = D0) ->\r\n   761\t    Role = ?role(StateName),\r\n   762\t    Rengotation = renegotiation(StateName),\r\n   763\t    try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of\r\n   764\t\t{disconnect, Reason0, RepliesConn} ->\r\n   765\t            {Repls, D} = send_replies(RepliesConn, D0),\r\n   766\t            case {Reason0,Role} of\r\n   767\t                {{_, Reason}, client} when ((StateName =/= {connected,client})\r\n   768\t                                            and (not Rengotation)) ->\r\n   769\t                    handshake({not_connected,Reason}, D);\r\n   770\t                _ ->\r\n   771\t                    ok\r\n   772\t            end,\r\n   773\t            {stop_and_reply, {shutdown,normal}, Repls, D};\r\n   774\t\r\n   775\t\t{Replies, Connection} when is_list(Replies) ->\r\n   776\t\t    {Repls, D} = \r\n   777\t\t\tcase StateName of\r\n   778\t\t\t    {connected,_} ->\r\n   779\t\t\t\tsend_replies(Replies, D0#data{connection_state=Connection});\r\n   780\t\t\t    _ ->\r\n   781\t\t\t\t{ConnReplies, NonConnReplies} = lists:splitwith(fun not_connected_filter/1, Replies),\r\n   782\t\t\t\tsend_replies(NonConnReplies, D0#data{event_queue = Qev0 ++ ConnReplies})\r\n   783\t\t\tend,\r\n   784\t            case {Msg, StateName} of\r\n   785\t                {#ssh_msg_channel_close{}, {connected,_}} ->\r\n   786\t                    {keep_state, D, [cond_set_idle_timer(D)|Repls]};\r\n   787\t                {#ssh_msg_channel_success{}, _} ->\r\n"]
[519.260746, "o", "   788\t                    update_inet_buffers(D#data.socket),\r\n   789\t                    {keep_state, D, Repls};\r\n   790\t                _ ->\r\n   791\t                    {keep_state, D, Repls}\r\n   792\t            end\r\n   793\t\r\n   794\t    catch\r\n   795\t\tClass:Error ->\r\n   796\t            {Repls, D1} = send_replies(ssh_connection:handle_stop(Connection0), D0),\r\n   797\t            {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_BY_APPLICATION,\r\n   798\t                                             io_lib:format(\"Internal error: ~p:~p\",[Class,Error]),\r\n   799\t                                             StateName, D1),\r\n   800\t            {stop_and_reply, Shutdown, Repls, D}\r\n   801\t    end;\r\n   802\t\r\n   803\t\r\n   804\thandle_event(enter, OldState, {connected,_}=NewState, D) ->\r\n   805\t    %% Entering the state where re-negotiation is possible\r\n   806\t    init_renegotiate_timers(OldState, NewState, D);\r\n   807\t\r\n   808\thandle_event(enter, OldState, {ext_info,_,renegotiate}=NewState, D) ->\r\n   809\t    %% Could be hanging in exit_info state if nothing else arrives\r\n   810\t    init_renegotiate_timers(OldState, NewState, D);\r\n   811\t\r\n   812\thandle_event(enter, {connected,_}=OldState, NewState, D) ->\r\n   813\t    %% Exiting the state where re-negotiation is possible\r\n   814\t    pause_renegotiate_timers(OldState, NewState, D);\r\n   815\t\r\n   816\thandle_event(cast, force_renegotiate, StateName, D) ->\r\n   817\t    handle_event({timeout,renegotiate}, undefined, StateName, D);\r\n   818\t\r\n   819\thandle_event({timeout,renegotiate}, _, StateName, D0) ->\r\n   820\t    case StateName of\r\n"]
