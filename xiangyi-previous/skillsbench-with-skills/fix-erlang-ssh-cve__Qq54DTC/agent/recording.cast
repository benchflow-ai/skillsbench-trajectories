[348.972554, "i", "nl -ba lib/ssh/src/ssh.hrl | sed -n '1220,1285p'\n"]
[348.973098, "o", "nl -ba lib/ssh/src/ssh.hrl | sed -n '1220,1285p'\r\n\u001b[?2004l\r"]
[348.974553, "o", "  1220\t\r\n  1221\t\t  c_lng=none,   %% client to server languages\r\n  1222\t\t  s_lng=none,   %% server to client languages\r\n  1223\t\r\n  1224\t\t  user_ack    = true,   %% client\r\n  1225\t\t  timeout     = infinity,\r\n  1226\t\r\n  1227\t\t  shared_secret,        %% K from key exchange\r\n  1228\t\t  exchanged_hash,       %% H from key exchange\r\n  1229\t\t  session_id,           %% same as FIRST exchanged_hash\r\n  1230\t\t  \r\n  1231\t\t  opts = [],\r\n  1232\t\t  send_sequence = 0,\r\n  1233\t\t  recv_sequence = 0,\r\n  1234\t\t  keyex_key,\r\n  1235\t\t  keyex_info,\r\n  1236\t\t  random_length_padding = ?MAX_RND_PADDING_LEN, % From RFC 4253 section 6.\r\n  1237\t\t  \r\n  1238\t\t  %% User auth\r\n  1239\t\t  user,\r\n  1240\t\t  service,\r\n  1241\t\t  userauth_quiet_mode,              %  boolean()\r\n  1242\t\t  userauth_methods,                 %  list( string() )  eg [\"keyboard-interactive\", \"password\"]\r\n  1243\t\t  userauth_supported_methods,       %  string() eg \"keyboard-interactive,password\"\r\n  1244\t          userauth_pubkeys,\r\n  1245\t\t  kb_tries_left = 0,                %  integer(), num tries left for \"keyboard-interactive\"\r\n  1246\t\t  userauth_preference,\r\n  1247\t\t  available_host_keys,\r\n  1248\t\t  pwdfun_user_state,\r\n  1249\t\t  authenticated = false\r\n  1250\t\t }).\r\n  1251\t\r\n  1252\t-record(alg,\r\n  1253\t\t{\r\n  1254\t\t  kex,\r\n  1255\t\t  hkey,\r\n  1256\t\t  send_mac,\r\n  1257\t\t  recv_mac,\r\n  1258\t\t  encrypt,\r\n  1259\t\t  decrypt,\r\n  1260\t\t  compress,\r\n  1261\t\t  decompress,\r\n  1262\t\t  c_lng,\r\n  1263\t\t  s_lng,\r\n  1264\t          send_ext_info,\r\n  1265\t          recv_ext_info,\r\n  1266\t          kex_strict_negotiated = false\r\n  1267\t\t }).\r\n  1268\t\r\n  1269\t-record(ssh_pty, {c_version = \"\", % client version string, e.g \"SSH-2.0-Erlang/4.10.5\"\r\n  1270\t                  term = \"\",      % e.g. \"xterm\"\r\n  1271\t\t\t  width = 80,\r\n  1272\t\t\t  height = 25,\r\n  1273\t\t\t  pixel_width = 1024,\r\n  1274\t\t\t  pixel_height = 768,\r\n  1275\t\t\t  modes = <<>>}).\r\n  1276\t\r\n  1277\t\r\n  1278\t%% dbg help macros\r\n  1279\t-define(wr_record(N,BlackList),\r\n  1280\t        wr_record(R=#N{}) ->  ssh_dbg:wr_record(R, record_info(fields,N), BlackList)\r\n  1281\t        ).\r\n  1282\t\r\n  1283\t-define(wr_record(N), ?wr_record(N, [])).\r\n  1284\t\r\n  1285\t\r\n"]
