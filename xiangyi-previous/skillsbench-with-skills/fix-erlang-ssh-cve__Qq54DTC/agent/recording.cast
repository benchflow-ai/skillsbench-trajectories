[94.35389, "o", "\u001b[32m\u001b[K567\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K-define(\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName),\r\n\u001b[32m\u001b[K844\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, _, StateName, _) when not ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K847\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {adjust_window,ChannelId,Bytes}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K873\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {reply_request,Resp,ChannelId}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n"]
[94.353921, "o", "\u001b[32m\u001b[K894\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {request,ChannelPid, ChannelId, Type, Data}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K897\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {request,ChannelId,Type,Data}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K900\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {unknown,Data}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K904\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event(cast, {global_request, Type, Data}, StateName, D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K974\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event({call,_}, _, StateName, _) when not ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K978\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K989\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1001\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                           Timeout}, StateName, D0) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n"]
[94.353939, "o", "\u001b[32m\u001b[K1020\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Khandle_event({call,From}, {global_request, Type, Data, Timeout}, StateName, D0) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1028\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1035\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n"]
[94.353963, "o", "\u001b[32m\u001b[K1045\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K             #data{connection_state = #connection{options = Opts}} = D) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1053\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t     D0 = #data{connection_state = C}) when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1080\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n"]
[94.353994, "o", "\u001b[32m\u001b[K1091\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n\u001b[32m\u001b[K1102\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  when ?\u001b[01;31m\u001b[KCONNECTED\u001b[m\u001b[K(StateName) ->\r\n"]
