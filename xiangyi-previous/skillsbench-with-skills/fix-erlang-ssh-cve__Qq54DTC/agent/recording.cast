[260.692438, "o", "  1877\t%%%----------------------------------------------------------------\r\n  1878\t-doc false.\r\n  1879\tsend_environment_vars(ConnectionRef, Channel, VarNames) ->\r\n  1880\t    lists:foldl(\r\n  1881\t      fun(Var, success) ->\r\n  1882\t              case os:getenv(Var) of\r\n  1883\t                  false ->\r\n  1884\t                      success;\r\n  1885\t                  Value ->\r\n  1886\t                      setenv(ConnectionRef, Channel, false,\r\n  1887\t                             Var, Value, infinity)\r\n  1888\t              end\r\n  1889\t      end, success, VarNames).\r\n"]
