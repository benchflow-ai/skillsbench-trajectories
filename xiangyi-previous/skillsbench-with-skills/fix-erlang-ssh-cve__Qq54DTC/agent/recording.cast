[533.417582, "o", "   720\t\r\n   721\thandle_event(internal, {#ssh_msg_kexinit{},_}, {connected,Role}, D0) ->\r\n   722\t    {KeyInitMsg, SshPacket, Ssh} = ssh_transport:key_exchange_init_msg(D0#data.ssh_params),\r\n   723\t    D = D0#data{ssh_params = Ssh,\r\n   724\t\t\tkey_exchange_init_msg = KeyInitMsg},\r\n"]
[533.417838, "o", "   725\t    send_bytes(SshPacket, D),\r\n   726\t    {next_state, {kexinit,Role,renegotiate}, D, [postpone, {change_callback_module,ssh_fsm_kexinit}]};\r\n   727\t\r\n   728\thandle_event(internal, #ssh_msg_disconnect{description=Desc} = Msg, StateName, D0) ->\r\n   729\t    {disconnect, _, RepliesCon} =\r\n   730\t\tssh_connection:handle_msg(Msg, D0#data.connection_state, ?role(StateName), D0#data.ssh_params),\r\n   731\t    {Actions,D} = send_replies(RepliesCon, D0),\r\n   732\t    disconnect_fun(\"Received disconnect: \"++Desc, D),\r\n   733\t    {stop_and_reply, {shutdown,Desc}, Actions, D};\r\n   734\t\r\n   735\thandle_event(internal, #ssh_msg_ignore{}, {_StateName, _Role, init},\r\n   736\t             #data{ssh_params = #ssh{kex_strict_negotiated = true,\r\n   737\t                                     send_sequence = SendSeq,\r\n   738\t                                     recv_sequence = RecvSeq}}) ->\r\n   739\t    ?DISCONNECT(?SSH_DISCONNECT_KEY_EXCHANGE_FAILED,\r\n   740\t                io_lib:format(\"strict KEX violation: unexpected SSH_MSG_IGNORE \"\r\n   741\t                              \"send_sequence = ~p  recv_sequence = ~p\",\r\n   742\t                              [SendSeq, RecvSeq])\r\n   743\t               );\r\n   744\t\r\n   745\thandle_event(internal, #ssh_msg_ignore{}, _StateName, _) ->\r\n   746\t    keep_state_and_data;\r\n   747\t\r\n   748\thandle_event(internal, #ssh_msg_unimplemented{}, _StateName, _) ->\r\n   749\t    keep_state_and_data;\r\n   750\t\r\n   751\t%% Quick fix of failing test case (ssh_options_SUITE:ssh_msg_debug_fun_option_{client|server}/1)\r\n   752\thandle_event(cast, #ssh_msg_debug{} = Msg, State, D) ->\r\n   753\t    handle_event(internal, Msg, State, D);\r\n   754\t\r\n   755\thandle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n   756\t    debug_fun(Msg, D),\r\n   757\t    keep_state_and_data;\r\n   758\t\r\n   759\thandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n   760\t                                                        event_queue = Qev0} = D0) ->\r\n   761\t    Role = ?role(StateName),\r\n   762\t    Rengotation = renegotiation(StateName),\r\n   763\t    try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of\r\n   764\t\t{disconnect, Reason0, RepliesConn} ->\r\n   765\t            {Repls, D} = send_replies(RepliesConn, D0),\r\n   766\t            case {Reason0,Role} of\r\n   767\t                {{_, Reason}, client} when ((StateName =/= {connected,client})\r\n   768\t                                            and (not Rengotation)) ->\r\n   769\t                    handshake({not_connected,Reason}, D);\r\n   770\t                _ ->\r\n"]
