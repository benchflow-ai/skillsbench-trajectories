[556.119722, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('lib/ssh/src/ssh_connection_handler.erl')\ntext = path.read_text()\nold = '''handle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\n    debug_fun(Msg, D),\n    keep_state_and_data;\n\nhandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\n                                                        event_queue = Qev0} = D0) ->\n'''\nnew = '''handle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\n    debug_fun(Msg, D),\n    keep_state_and_data;\n\n%% Connection protocol messages must not be handled before authentication.\n%% Handling them early may lead to starting CLI/exec channels without auth.\nhandle_event(internal, {conn_msg,_Msg}, StateName,\n             #data{ssh_params = #ssh{authenticated = false}} = D0)\n  when not ?CONNECTED(StateName) ->\n    {Shutdown, D} =\n        ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                         \"Received SSH connection message before authentication\",\n                         StateName, D0),\n    {stop, Shutdown, D};\n\nhandle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\n                                                        event_queue = Qev0} = D0) ->\n'''\nif old not in text:\n    raise SystemExit('Pattern not found for replacement')\npath.write_text(text.replace(old, new))\nPY\n"]
