[383.062399, "o", "   200\tstart_channel(ConnectionHandler, CallbackModule, ChannelId, Args, Exec) ->\r\n   201\t    {ok, {ConnectionSup,Role,Opts}} = call(ConnectionHandler, get_misc),\r\n   202\t    ssh_connection_sup:start_channel(Role, ConnectionSup,\r\n   203\t                                    ConnectionHandler, CallbackModule, ChannelId,\r\n   204\t                                    Args, Exec, Opts).\r\n   205\t\r\n   206\t%%--------------------------------------------------------------------\r\n   207\thandle_direct_tcpip(ConnectionHandler, ListenHost, ListenPort, ConnectToHost, ConnectToPort, Timeout) ->\r\n   208\t    call(ConnectionHandler, {handle_direct_tcpip, ListenHost, ListenPort, ConnectToHost, ConnectToPort, Timeout}).\r\n   209\t\r\n   210\t%%--------------------------------------------------------------------\r\n   211\t-spec request(connection_ref(),\r\n   212\t\t      pid(),\r\n   213\t\t      channel_id(),\r\n   214\t\t      string(),\r\n   215\t\t      boolean(),\r\n   216\t\t      iodata(),\r\n   217\t\t      timeout()\r\n   218\t\t     ) -> success | failure | ok | {error,timeout}.\r\n"]
[383.064029, "o", "   219\t\r\n   220\t-spec request(connection_ref(),\r\n   221\t\t      channel_id(),\r\n   222\t\t      string(),\r\n   223\t\t      boolean(),\r\n   224\t\t      iodata(),\r\n   225\t\t      timeout()\r\n   226\t\t     ) -> success | failure | ok | {error,timeout}.\r\n   227\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   228\trequest(ConnectionHandler, ChannelPid, ChannelId, Type, true, Data, Timeout) ->\r\n   229\t    call(ConnectionHandler, {request, ChannelPid, ChannelId, Type, Data, Timeout});\r\n   230\trequest(ConnectionHandler, ChannelPid, ChannelId, Type, false, Data, _) ->\r\n   231\t    cast(ConnectionHandler, {request, ChannelPid, ChannelId, Type, Data}).\r\n   232\t\r\n   233\trequest(ConnectionHandler, ChannelId, Type, true, Data, Timeout) ->\r\n   234\t    call(ConnectionHandler, {request, ChannelId, Type, Data, Timeout});\r\n   235\trequest(ConnectionHandler, ChannelId, Type, false, Data, _) ->\r\n   236\t    cast(ConnectionHandler, {request, ChannelId, Type, Data}).\r\n   237\t\r\n   238\t%%--------------------------------------------------------------------\r\n   239\t-spec reply_request(connection_ref(),\r\n   240\t\t\t    success | failure,\r\n   241\t\t\t    channel_id()\r\n   242\t\t\t   ) -> ok.\r\n   243\t\r\n   244\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   245\treply_request(ConnectionHandler, Status, ChannelId) ->\r\n   246\t    cast(ConnectionHandler, {reply_request, Status, ChannelId}).\r\n   247\t\r\n   248\t%%--------------------------------------------------------------------\r\n   249\tglobal_request(ConnectionHandler, Type, true, Data, Timeout) ->\r\n   250\t    call(ConnectionHandler, {global_request, Type, Data, Timeout});\r\n   251\tglobal_request(ConnectionHandler, Type, false, Data, _) ->\r\n   252\t    cast(ConnectionHandler, {global_request, Type, Data}).\r\n   253\t\r\n   254\t%%--------------------------------------------------------------------\r\n   255\t-spec send(connection_ref(),\r\n   256\t\t   channel_id(),\r\n   257\t\t   non_neg_integer(),\r\n   258\t\t   iodata(),\r\n   259\t\t   timeout()\r\n   260\t\t  ) -> ok | {error, timeout|closed}.\r\n   261\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   262\tsend(ConnectionHandler, ChannelId, Type, Data, Timeout) ->\r\n   263\t    call(ConnectionHandler, {data, ChannelId, Type, Data, Timeout}).\r\n   264\t\r\n   265\t%%--------------------------------------------------------------------\r\n   266\t-spec send_eof(connection_ref(),\r\n   267\t\t       channel_id()\r\n   268\t\t      ) -> ok | {error,closed}.\r\n   269\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   270\tsend_eof(ConnectionHandler, ChannelId) ->\r\n   271\t    call(ConnectionHandler, {eof, ChannelId}).\r\n   272\t\r\n   273\t%%--------------------------------------------------------------------\r\n   274\t-spec info(connection_ref()\r\n   275\t\t  ) -> {ok, [#channel{}]} .\r\n   276\t\r\n   277\t-spec info(connection_ref(),\r\n   278\t\t   pid() | all\r\n   279\t\t  ) -> {ok, [#channel{}]} .\r\n   280\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   281\tinfo(ConnectionHandler) ->\r\n   282\t    info(ConnectionHandler, all).\r\n   283\t\r\n   284\tinfo(ConnectionHandler, ChannelProcess) ->\r\n   285\t    call(ConnectionHandler, {info, ChannelProcess}).\r\n   286\t\r\n   287\t%%--------------------------------------------------------------------\r\n   288\t-type local_sock_info() :: {inet:ip_address(), non_neg_integer()} | string().\r\n   289\t-type peer_sock_info()  :: {inet:ip_address(), non_neg_integer()} | string().\r\n   290\t-type state_info() :: iolist().\r\n   291\t\r\n   292\t-spec get_print_info(connection_ref()\r\n   293\t\t\t    ) -> {{local_sock_info(), peer_sock_info()},\r\n   294\t\t\t\t  state_info()\r\n   295\t\t\t\t }.\r\n   296\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   297\tget_print_info(ConnectionHandler) ->\r\n   298\t    call(ConnectionHandler, get_print_info, 1000).\r\n   299\t\r\n   300\t%%--------------------------------------------------------------------\r\n   301\tconnection_info(ConnectionHandler, []) ->\r\n   302\t    connection_info(ConnectionHandler, conn_info_keys());\r\n   303\tconnection_info(ConnectionHandler, Key) w"]
[383.067766, "o", "hen is_atom(Key) ->\r\n   304\t    case connection_info(ConnectionHandler, [Key]) of\r\n   305\t        [{Key,Val}] -> {Key,Val};\r\n   306\t        Other -> Other\r\n   307\t    end;\r\n   308\tconnection_info(ConnectionHandler, Options) ->\r\n   309\t    call(ConnectionHandler, {connection_info, Options}).\r\n   310\t\r\n   311\t%%--------------------------------------------------------------------\r\n   312\t-spec channel_info(connection_ref(),\r\n   313\t\t\t   channel_id(),\r\n   314\t\t\t   [atom()]\r\n   315\t\t\t  ) -> proplists:proplist().\r\n   316\t%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .\r\n   317\tchannel_info(ConnectionHandler, ChannelId, Options) ->\r\n   318\t    call(ConnectionHandler, {channel_info, ChannelId, Options}).\r\n   319\t\r\n   320\t%%--------------------------------------------------------------------\r\n\u001b[?2004hroot@b785f6759156:/app/workspace/otp_src_27.3.2# "]
[518.301172, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: lib/ssh/src/ssh_connection_handler.erl\n@@\n-handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\n-                                                        event_queue = Qev0} = D0) ->\n+%% Connection protocol messages must not be handled before authentication.\n+%% Handling them early may lead to starting CLI/exec channels without auth.\n+handle_event(internal, {conn_msg,_Msg}, StateName,\n+             #data{ssh_params = #ssh{authenticated = false}} = D0)\n+  when not ?CONNECTED(StateName) ->\n+    {Shutdown, D} =\n+        ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n+                         \"Received SSH connection message before authentication\",\n+                         StateName, D0),\n+    {stop, Shutdown, D};\n+\n+handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\n+                                                        event_queue = Qev0} = D0) ->\n*** End Patch\nPATCH\n"]
[518.301462, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r"]
[518.301501, "o", "\u001b[?2004h> "]
[518.301635, "o", "*** Begin Patch\r\n\u001b[?2004l\r"]
[518.301676, "o", "\u001b[?2004h> "]
[518.301785, "o", "*** Update File: lib/ssh/src/ssh_connection_handler.erl\r\n\u001b[?2004l\r\u001b[?2004h> @@\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.302006, "o", "-handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.30224, "o", "-                                                        event_queue = Qev0} = D0) ->\r\n\u001b[?2004l\r"]
[518.302277, "o", "\u001b[?2004h> "]
[518.302451, "o", "+%% Connection protocol messages must not be handled before authentication.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.302664, "o", "+%% Handling them early may lead to starting CLI/exec channels without auth.\r\n\u001b[?2004l\r\u001b[?2004h"]
[518.302704, "o", "> "]
[518.302817, "o", "+handle_event(internal, {conn_msg,_Msg}, StateName,\r\n\u001b[?2004l\r\u001b[?2004h"]
[518.302852, "o", "> "]
[518.303018, "o", "+             #data{ssh_params = #ssh{authenticated = false}} = D0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.303127, "o", "+  when not ?CONNECTED(StateName) ->\r\n\u001b[?2004l\r"]
[518.303168, "o", "\u001b[?2004h> "]
[518.303269, "o", "+    {Shutdown, D} =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.303372, "o", "+        ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\r\n\u001b[?2004l\r"]
[518.303407, "o", "\u001b[?2004h> "]
[518.303627, "o", "+                         \"Received SSH connection message before authentication\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.303744, "o", "+                         StateName, D0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[518.303826, "o", "> "]
[518.303873, "o", "+    {stop, Shutdown, D};\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[518.303918, "o", "\u001b[?2004h> "]
[518.304145, "o", "+handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[518.304381, "o", "+                                                        event_queue = Qev0} = D0) ->\r\n\u001b[?2004l\r\u001b[?2004h"]
