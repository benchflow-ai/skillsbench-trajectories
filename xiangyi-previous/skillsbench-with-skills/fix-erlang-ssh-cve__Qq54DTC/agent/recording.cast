[291.487364, "o", "\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1900\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kcompress_final(#ssh{compress = 'zlib@openssh.com', \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = false} = Ssh) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1902\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kcompress_final(#ssh{compress = 'zlib@openssh.com', compress_ctx = Context, \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true} = Ssh) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1911\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kcompress(#ssh{compress = 'zlib@openssh.com', \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = false} = Ssh, Data) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1913\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kcompress(#ssh{compress = 'zlib@openssh.com', compress_ctx = Context, \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true} = Ssh, Data) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1937\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdecompress_final(#ssh{decompress = 'zlib@openssh.com', \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = false} = Ssh) ->\r\n"]
[291.487486, "o", "\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1939\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdecompress_final(#ssh{decompress = 'zlib@openssh.com', decompress_ctx = Context, \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true} = Ssh) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1948\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdecompress(#ssh{decompress = 'zlib@openssh.com', \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = false} = Ssh, Data) ->\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_transport.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1950\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdecompress(#ssh{decompress = 'zlib@openssh.com', decompress_ctx = Context, \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true} = Ssh, Data) ->\r\n"]
[291.487869, "o", "\u001b[35m\u001b[Klib/ssh/src/ssh_fsm_userauth_client.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    D = D0#data{ssh_params=Ssh#ssh{\u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true}},\r\n"]
[291.488011, "o", "\u001b[35m\u001b[Klib/ssh/src/ssh.hrl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K994\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K without any need of providing any password or key.\r\n\u001b[35m\u001b[Klib/ssh/src/ssh.hrl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1095\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  `N+1` is aborted. If `N` connections are \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K and still logged in, no\r\n\u001b[35m\u001b[Klib/ssh/src/ssh.hrl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1119\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  limited to `N-K`, where `K` is the number of \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K connections present\r\n\u001b[35m\u001b[Klib/ssh/src/ssh.hrl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1249\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t  \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = false\r\n"]
[291.488825, "o", "\u001b[35m\u001b[Klib/ssh/src/ssh_fsm_userauth_server.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            %% Note: \u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K=true MUST NOT be sent\r\n\u001b[35m\u001b[Klib/ssh/src/ssh_fsm_userauth_server.erl\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K180\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            ssh_params = Ssh#ssh{\u001b[01;31m\u001b[Kauthenticated\u001b[m\u001b[K = true}}.\r\n"]
