1b[m\u001b[K    \u001b[01;31m\u001b[Kexec\u001b[m\u001b[K_in_self_group(ConnectionHandler, ChannelId, WantReply, State,\r\n\u001b[32m\u001b[K794\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kexec\u001b[m\u001b[K_direct(ConnectionHandler, ChannelId, Cmd, ExecSpec, WantReply, State) ->\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                        {error, \"Bad \u001b[01;31m\u001b[Kexec\u001b[m\u001b[K fun in server\"}\r\n\u001b[32m\u001b[K816\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kexec\u001b[m\u001b[K_in_self_group(ConnectionHandler, ChannelId, WantReply, State, Fun).\r\n\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kexec\u001b[m\u001b[K_in_self_group(ConnectionHandler, ChannelId, WantReply, State, Fun) ->\r\n\u001b[32m\u001b[K835\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                       {error, \"Bad \u001b[01;31m\u001b[Kexec\u001b[m\u001b[K fun in server. Invalid return value: \"++t2str(X)}\r\n"]
