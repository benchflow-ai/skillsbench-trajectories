[278.544692, "o", "  1400\t%%%\r\n  1401\t%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\r\n  1402\t\r\n  1403\t%%%----------------------------------------------------------------\r\n  1404\t%%% Create the channel data when an ssh_msg_open_channel message\r\n  1405\t%%% of \"session\" typ is handled\r\n  1406\t%%%\r\n  1407\tsetup_session(#connection{channel_cache = Cache,\r\n  1408\t                          channel_id_seed = NewChannelID,\r\n  1409\t                          suggest_window_size = WinSz,\r\n  1410\t                          suggest_packet_size = PktSz\r\n  1411\t\t\t\t } = C,\r\n  1412\t\t      RemoteId, Type, WindowSize, PacketSize) when is_integer(WinSz),\r\n  1413\t                                                           is_integer(PktSz) ->\r\n  1414\t    NextChannelID = NewChannelID + 1,\r\n  1415\t    Channel =\r\n  1416\t        #channel{type = Type,\r\n  1417\t                 sys = \"ssh\",\r\n  1418\t                 local_id = NewChannelID,\r\n  1419\t                 recv_window_size = WinSz,\r\n  1420\t                 recv_packet_size = PktSz,\r\n  1421\t                 send_window_size = WindowSize,\r\n  1422\t                 send_packet_size = PacketSize,\r\n  1423\t                 send_buf = queue:new(),\r\n  1424\t                 remote_id = RemoteId\r\n  1425\t                },\r\n  1426\t    ssh_client_channel:cache_update(Cache, Channel),\r\n  1427\t    OpenConfMsg = channel_open_confirmation_msg(RemoteId, NewChannelID,\r\n  1428\t\t\t\t\t\t\tWinSz, \r\n  1429\t\t\t\t\t\t\tPktSz),\r\n  1430\t                Reply = {connection_reply, OpenConfMsg},\r\n  1431\t    {[Reply], C#connection{channel_id_seed = NextChannelID}}.\r\n  1432\t\r\n  1433\t\r\n  1434\t%%%----------------------------------------------------------------\r\n  1435\t%%% Start a cli or subsystem\r\n  1436\t%%%\r\n  1437\tstart_cli(#connection{options = Options, \r\n  1438\t\t\t      cli_spec = CliSpec,\r\n  1439\t\t\t      exec = Exec,\r\n  1440\t\t\t      connection_supervisor = ConnectionSup}, ChannelId) ->\r\n  1441\t    case CliSpec of\r\n  1442\t        no_cli ->\r\n  1443\t            {error, cli_disabled};\r\n  1444\t        {CbModule, Args} ->\r\n  1445\t            ssh_connection_sup:start_channel(server, ConnectionSup, self(), CbModule, ChannelId, Args, Exec, Options)\r\n  1446\t    end.\r\n  1447\t\r\n  1448\t\r\n  1449\tstart_subsystem(BinName, #connection{options = Options,\r\n  1450\t                                     connection_supervisor = ConnectionSup},\r\n  1451\t\t       #channel{local_id = ChannelId}, _ReplyMsg) ->\r\n  1452\t    Name = binary_to_list(BinName),\r\n  1453\t    case check_subsystem(Name, Options) of\r\n  1454\t\t{Callback, Opts} when is_atom(Callback), Callback =/= none ->\r\n  1455\t            ssh_connection_sup:start_channel(server, ConnectionSup, self(), Callback, ChannelId, Opts, undefined, Options);\r\n  1456\t        {none, _} ->\r\n  1457\t            {error, bad_subsystem};\r\n  1458\t\t{_, _} ->\r\n  1459\t\t    {error, legacy_option_not_supported}\r\n  1460\t    end.\r\n  1461\t\r\n  1462\t\r\n  1463\t%%% Helpers for starting cli/subsystems\r\n  1464\tcheck_subsystem(\"sftp\"= SsName, Options) ->\r\n  1465\t    case ?GET_OPT(subsystems, Options) of\r\n  1466\t\tno_subsys -> \t% FIXME: Can 'no_subsys' ever be matched?\r\n  1467\t\t    {SsName, {Cb, Opts}} = ssh_sftpd:subsystem_spec([]),\r\n  1468\t\t    {Cb, Opts};\r\n  1469\t\tSubSystems ->\r\n  1470\t\t    proplists:get_value(SsName, SubSystems, {none, []})\r\n  1471\t    end;\r\n  1472\t\r\n  1473\tcheck_subsystem(SsName, Options) ->\r\n  1474\t    Subsystems = ?GET_OPT(subsystems, Options),\r\n  1475\t    case proplists:get_value(SsName, Subsystems, {none, []}) of\r\n  1476\t\tFun when is_function(Fun) ->\r\n  1477\t\t    {Fun, []};\r\n  1478\t\t{_, _} = Value ->\r\n  1479\t\t    Value\r\n  1480\t    end.\r\n  1481\t\r\n  1482\t%%%----------------------------------------------------------------\r\n  1483\t%%%\r\n  1484\t%%% Send-window handling\r\n  1485\t%%%\r\n  1486\t\r\n  1487\tupdate_send_window(Channel, _, undefined,\r\n"]
[278.544842, "o", "  1488\t\t\t   #connection{channel_cache = Cache}) ->\r\n  1489\t    do_update_send_window(Channel, Cache);\r\n  1490\t\r\n  1491\tupdate_send_window(#channel{send_buf = SendBuffer} = Channel, DataType, Data,\r\n  1492\t\t\t   #connection{channel_cache = Cache}) ->\r\n  1493\t    do_update_send_window(Channel#channel{send_buf = queue:in({DataType, Data}, SendBuffer)},\r\n  1494\t\t\t\t  Cache).\r\n  1495\t\r\n  1496\tdo_update_send_window(Channel0, Cache) ->\r\n  1497\t    {SendMsgs, Channel} = get_window(Channel0, []),\r\n  1498\t    ssh_client_channel:cache_update(Cache, Channel), \r\n  1499\t    {SendMsgs, Channel}.\r\n  1500\t\r\n  1501\tget_window(#channel{send_window_size = 0\r\n  1502\t\t\t   } = Channel, Acc) ->\r\n  1503\t    {lists:reverse(Acc), Channel};\r\n  1504\tget_window(#channel{send_packet_size = 0\r\n  1505\t\t\t   } = Channel, Acc) ->\r\n  1506\t    {lists:reverse(Acc), Channel};\r\n  1507\tget_window(#channel{send_buf = Buffer, \r\n  1508\t\t\t    send_packet_size = PacketSize,\r\n  1509\t\t\t    send_window_size = WindowSize0\r\n  1510\t\t\t   } = Channel, Acc0) ->\r\n  1511\t    case queue:out(Buffer) of\r\n  1512\t\t{{value, {_, Data} = Msg}, NewBuffer} ->\r\n  1513\t\t    case handle_send_window(Msg, byte_size(Data), PacketSize, WindowSize0, Acc0) of\r\n  1514\t\t\t{WindowSize, Acc, {_, <<>>}} ->\r\n  1515\t\t\t    {lists:reverse(Acc), Channel#channel{send_window_size = WindowSize,\r\n  1516\t\t\t\t\t\t\t\t send_buf = NewBuffer}};\r\n  1517\t\t\t{WindowSize, Acc, Rest} ->\r\n  1518\t\t\t    get_window(Channel#channel{send_window_size = WindowSize,\r\n  1519\t\t\t\t\t\t       send_buf = queue:in_r(Rest, NewBuffer)}, Acc)\r\n  1520\t\t    end;\r\n\u001b[?2004hroot@b785f6759156:/app/workspace/otp_src_27.3.2# "]
