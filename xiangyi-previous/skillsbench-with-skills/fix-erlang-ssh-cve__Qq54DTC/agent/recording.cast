[377.934764, "o", "\u001b[32m\u001b[K760\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                                                        \u001b[01;31m\u001b[Kevent_queue\u001b[m\u001b[K = Qev0} = D0) ->\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\tsend_replies(NonConnReplies, D0#data{\u001b[01;31m\u001b[Kevent_queue\u001b[m\u001b[K = Qev0 ++ ConnReplies})\r\n"]
