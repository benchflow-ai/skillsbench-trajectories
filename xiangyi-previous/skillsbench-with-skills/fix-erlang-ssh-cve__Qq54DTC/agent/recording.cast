[260.692219, "o", "  1860\t    {[{channel_data, ChannelPid, Reply}], Connection}.\r\n  1861\t\r\n  1862\t\r\n  1863\trequest_reply_or_data(#channel{local_id = ChannelId, user = ChannelPid}, \r\n  1864\t\t\t      #connection{requests = Requests} = \r\n  1865\t\t\t      Connection, Reply) -> \r\n  1866\t    case lists:keysearch(ChannelId, 1, Requests) of\r\n  1867\t\t{value, {ChannelId, From}} ->\r\n  1868\t\t    {[{channel_request_reply, From, Reply}],\r\n"]
