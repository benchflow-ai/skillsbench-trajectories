   359	%% . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
   360	set_sock_opts(ConnectionRef, SocketOptions) ->
   361	    try lists:foldr(fun({Name,_Val}, Acc) ->
   362	                            case prohibited_sock_option(Name) of
   363	                                true -> [Name|Acc];
   364	                                false -> Acc
   365	                            end
   366	                    end, [], SocketOptions)
   367	    of
   368	        [] ->
   369	            call(ConnectionRef, {set_sock_opts,SocketOptions});
   370	        Bad ->
   371	            {error, {not_allowed,Bad}}
   372	    catch
   373	        _:_ ->
   374	            {error, badarg}
   375	    end.
   376	
   377	prohibited_sock_option(active)    -> true;
   378	prohibited_sock_option(deliver)   -> true;
   379	prohibited_sock_option(mode)      -> true;
   380	prohibited_sock_option(packet)    -> true;
   381	prohibited_sock_option(_) -> false.
   382	
