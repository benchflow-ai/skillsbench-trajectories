  1961	limit_size(S, MaxLen) when is_integer(MaxLen) ->
  1962	    limit_size(S, lists:flatlength(S), MaxLen);
  1963	limit_size(S, _) ->
  1964	    S.
  1965	
  1966	limit_size(S, Len, MaxLen) when Len =< MaxLen ->
  1967	    S;
  1968	limit_size(S, Len, MaxLen) when Len =< (MaxLen + 5) ->
  1969	    %% Looks silly with e.g "... (2 bytes skipped)"
  1970	    S;
  1971	limit_size(S, Len, MaxLen) when Len > MaxLen ->
  1972	    %% Cut
  1973	    io_lib:format("~s ... (~w bytes skipped)",
  1974	                  [string:substr(lists:flatten(S), 1, MaxLen),
  1975	                   Len-MaxLen]).
  1976	
  1977	crypto_log_info() ->
  1978	    try
  1979	        [{_,_,CI}] = crypto:info_lib(),
  1980	        case crypto:info_fips() of
  1981	            enabled ->
  1982	                <<"(",CI/binary,". FIPS enabled)">>;
  1983	            not_enabled ->
  1984	                <<"(",CI/binary,". FIPS available but not enabled)">>;
  1985	            _ ->
  1986	                <<"(",CI/binary,")">>
  1987	        end
  1988	    catch
  1989	        _:_ -> ""
  1990	    end.
  1991	
  1992	ssh_log_version() ->
  1993	    case application:get_key(ssh,vsn) of
  1994	        {ok,Vsn} -> Vsn;
  1995	        undefined -> ""
  1996	    end.
  1997	
  1998	%%%----------------------------------------------------------------
  1999	not_connected_filter({connection_reply, _Data}) -> true;
  2000	not_connected_filter(_) -> false.
