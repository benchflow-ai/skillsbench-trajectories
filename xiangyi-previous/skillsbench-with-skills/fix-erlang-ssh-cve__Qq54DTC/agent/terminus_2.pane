   690	%%% ######## {service_request, client|server} ####
   691	
   692	handle_event(internal, Msg = #ssh_msg_service_request{name=ServiceName}, StateName = {service_request,server}, D0) ->
   693	    case ServiceName of
   694		"ssh-userauth" ->
   695		    Ssh0 = #ssh{session_id=SessionId} = D0#data.ssh_params,
   696		    {ok, {Reply, Ssh}} = ssh_auth:handle_userauth_request(Msg, SessionId, Ssh0),
   697	            D = send_msg(Reply, D0#data{ssh_params = Ssh}),
   698		    {next_state, {userauth,server}, D, {change_callback_module,ssh_fsm_userauth_server}};
   699	
   700		_ ->
   701	            {Shutdown, D} =
   702	                ?send_disconnect(?SSH_DISCONNECT_SERVICE_NOT_AVAILABLE,
   703	                                 io_lib:format("Unknown service: ~p",[ServiceName]),
   704	                                 StateName, D0),
   705	            {stop, Shutdown, D}
   706	    end;
   707	
   708	handle_event(internal, #ssh_msg_service_accept{name = "ssh-userauth"}, {service_request,client},
   709		     #data{ssh_params = #ssh{service="ssh-userauth"} = Ssh0} = D0) ->
   710	    {Msg, Ssh} = ssh_auth:init_userauth_request_msg(Ssh0),
   711	    D = send_msg(Msg, D0#data{ssh_params = Ssh,
   712	                              auth_user = Ssh#ssh.user
   713	                             }),
   714	    {next_state, {userauth,client}, D, {change_callback_module,ssh_fsm_userauth_client}};
   715	
   716	
   717	%% Skip ext_info messages in connected state (for example from OpenSSH >= 7.7)
   718	handle_event(internal, #ssh_msg_ext_info{}, {connected,_Role}, D) ->
   719	    {keep_state, D};
