   761	    Role = ?role(StateName),
   762	    Rengotation = renegotiation(StateName),
   763	    try ssh_connection:handle_msg(Msg, Connection0, Role, D0#data.ssh_params) of
   764		{disconnect, Reason0, RepliesConn} ->
   765	            {Repls, D} = send_replies(RepliesConn, D0),
   766	            case {Reason0,Role} of
   767	                {{_, Reason}, client} when ((StateName =/= {connected,client})
   768	                                            and (not Rengotation)) ->
   769	                    handshake({not_connected,Reason}, D);
   770	                _ ->
   771	                    ok
   772	            end,
   773	            {stop_and_reply, {shutdown,normal}, Repls, D};
   774	
   775		{Replies, Connection} when is_list(Replies) ->
   776		    {Repls, D} = 
