   676	%%% timeout after tcp:connect but then nothing arrives
   677	handle_event(state_timeout, no_hello_received, {hello,_Role}=StateName, D0 = #data{ssh_params = Ssh0}) ->
   678	    MsgFun =
   679	        fun (debug) ->
   680	                Time = ?GET_OPT(hello_timeout, Ssh0#ssh.opts),
   681	                lists:concat(["No HELLO received within ",ssh_lib:format_time_ms(Time)]);
