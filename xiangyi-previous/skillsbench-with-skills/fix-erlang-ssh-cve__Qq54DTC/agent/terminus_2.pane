  2002	%%%----------------------------------------------------------------
  2003	
  2004	send_replies({Repls,C = #connection{}}, D) when is_list(Repls) ->
  2005	    send_replies(Repls, D#data{connection_state=C});
  2006	send_replies(Repls, State) ->
  2007	    lists:foldl(fun get_repl/2, {[],State}, Repls).
  2008	
  2009	get_repl({connection_reply,Msg}, {CallRepls,S}) ->
  2010	    if is_record(Msg, ssh_msg_channel_success) ->
  2011		    update_inet_buffers(S#data.socket);
  2012	       true ->
  2013		    ok
  2014	    end,
  2015	    {CallRepls, send_msg(Msg,S)};
  2016	get_repl({channel_data,undefined,_Data}, Acc) ->
  2017	    Acc;
  2018	get_repl({channel_data,Pid,Data}, Acc) ->
  2019	    Pid ! {ssh_cm, self(), Data},
  2020	    Acc;
  2021	get_repl({channel_request_reply,From,Data}, {CallRepls,S}) ->
  2022	    {[{reply,From,Data}|CallRepls], S};
  2023	get_repl({flow_control,Cache,Channel,From,Msg}, {CallRepls,S}) ->
  2024	    ssh_client_channel:cache_update(Cache, Channel#channel{flow_control = undefined}),
  2025	    {[{reply,From,Msg}|CallRepls], S};
