   727	
   728	handle_event(internal, #ssh_msg_disconnect{description=Desc} = Msg, StateName, D0) ->
   729	    {disconnect, _, RepliesCon} =
   730		ssh_connection:handle_msg(Msg, D0#data.connection_state, ?role(StateName), D0#data.ssh_params),
   731	    {Actions,D} = send_replies(RepliesCon, D0),
   732	    disconnect_fun("Received disconnect: "++Desc, D),
   733	    {stop_and_reply, {shutdown,Desc}, Actions, D};
