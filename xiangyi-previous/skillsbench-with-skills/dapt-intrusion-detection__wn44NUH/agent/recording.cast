[70.734727, "o", ">             "]
[70.734775, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.734863, "o", "        if sport is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.734912, "o", "> "]
[70.734975, "o", "            src_ports.append(sport)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735019, "o", "> "]
[70.735077, "o", "        if dport is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735121, "o", "> "]
[70.735197, "o", "            dst_ports.append(dport)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735244, "o", "> "]
[70.735294, "o", "            \r\n\u001b[?2004l\r \u001b[?2004h> "]
[70.735344, "o", "    elif p.haslayer(ARP):\r\n\u001b[?2004l\r_\u001b[?2004h"]
[70.735389, "o", "> "]
[70.735455, "o", "        proto_counts['arp'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735499, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[70.735547, "o", "# Protocol counts\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735592, "o", "> "]
[70.735685, "o", "print(f\"protocol_tcp,{proto_counts['tcp']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.73573, "o", "> "]
[70.735823, "o", "print(f\"protocol_udp,{proto_counts['udp']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.735867, "o", "> "]
[70.735963, "o", "print(f\"protocol_icmp,{proto_counts['icmp']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736008, "o", "> "]
[70.736108, "o", "print(f\"protocol_arp,{proto_counts['arp']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736154, "o", "> "]
[70.736241, "o", "print(f\"protocol_ip_total,{ip_total}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736289, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[70.736333, "o", "# Time / rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.736477, "o", "duration = max(timestamps) - min(timestamps) if timestamps else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.736547, "o", "print(f\"duration_seconds,{duration}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[70.736599, "o", "\u001b[?2004l\r\u001b[?2004h> if timestamps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736664, "o", ">     start_ts = min(timestamps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.73673, "o", ">     buckets = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736809, "o", ">     for ts in timestamps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.736862, "o", ">         bucket = int((ts - start_ts) // 60)\r\n\u001b[?2004l\r"]
[70.736912, "o", "\u001b[?2004h> "]
[70.736962, "o", "        buckets[bucket] += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.737014, "o", "> "]
[70.737067, "o", "    # Number of full or partial minutes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737132, "o", "    num_buckets = int(duration // 60) + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737238, "o", "    counts_list = [buckets[i] for i in range(num_buckets)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.73741, "o", "    print(f\"packets_per_minute_avg,{sum(counts_list)/len(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737474, "o", "    print(f\"packets_per_minute_max,{max(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737577, "o", "    print(f\"packets_per_minute_min,{min(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[70.737635, "o", "\u001b[?2004h> "]
[70.737704, "o", "    print(\"packets_per_minute_avg,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737766, "o", "    print(\"packets_per_minute_max,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737824, "o", "    print(\"packets_per_minute_min,0\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.737873, "o", "\u001b[?2004h> # Sizes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737948, "o", "print(f\"total_bytes,{total_bytes}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.737996, "o", "if sizes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738062, "o", "    print(f\"avg_packet_size,{sum(sizes)/len(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.738108, "o", "> "]
[70.738148, "o", "    print(f\"min_packet_size,{min(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.738195, "o", "> "]
[70.738246, "o", "    print(f\"max_packet_size,{max(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738295, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738336, "o", "    print(\"avg_packet_size,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738392, "o", "    print(\"min_packet_size,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.738437, "o", "> "]
[70.738483, "o", "    print(\"max_packet_size,0\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738543, "o", "# Entropy\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.738589, "o", "> "]
[70.738635, "o", "print(f\"dst_port_entropy,{shannon_entropy(dst_ports)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738716, "o", "print(f\"src_port_entropy,{shannon_entropy(src_ports)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.738769, "o", "> "]
[70.738828, "o", "print(f\"src_ip_entropy,{shannon_entropy(src_ips)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.738923, "o", "print(f\"dst_ip_entropy,{shannon_entropy(dst_ips)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739011, "o", "print(f\"unique_dst_ports,{len(set(dst_ports))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739056, "o", "> "]
[70.739101, "o", "print(f\"unique_src_ports,{len(set(src_ports))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739145, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Graph\r\n\u001b[?2004l\r"]
[70.73919, "o", "\u001b[?2004h> "]
[70.739234, "o", "nodes = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739279, "o", "num_nodes = len(nodes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739329, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739375, "o", "> "]
[70.73942, "o", "print(f\"num_nodes,{num_nodes}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739468, "o", "print(f\"num_edges,{num_edges}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739528, "o", "> "]
[70.73958, "o", "if num_nodes < 2:\r\n\u001b[?2004l\r\u001b[?2004h>     density = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739632, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.739688, "o", "    density = num_edges / (num_nodes * (num_nodes - 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739734, "o", "> "]
[70.739779, "o", "print(f\"network_density,{density}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739824, "o", "> "]
[70.739868, "o", "outdegrees = Counter(src for src, dst in edges)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.739913, "o", "> "]
[70.739956, "o", "indegrees = Counter(dst for src, dst in edges)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740002, "o", "> "]
[70.740087, "o", "print(f\"max_indegree,{max(indegrees.values()) if indegrees else 0}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.740207, "o", "print(f\"max_outdegree,{max(outdegrees.values()) if outdegrees else 0}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.740253, "o", "\u001b[?2004h> # Timing\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740298, "o", "> timestamps.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740343, "o", "> "]
[70.740432, "o", "iats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740477, "o", "> if iats:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.74054, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.740646, "o", "    iat_var = sum((x - iat_mean)**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740691, "o", "> "]
[70.740756, "o", "    iat_cv = (iat_var**0.5 / iat_mean) if iat_mean != 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740808, "o", "> "]
[70.740858, "o", "    print(f\"iat_mean,{iat_mean}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.740903, "o", "    print(f\"iat_variance,{iat_var}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.740948, "o", "> "]
[70.740992, "o", "    print(f\"iat_cv,{iat_cv}\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[70.741036, "o", "\u001b[?2004h> "]
[70.74108, "o", "    print(\"iat_mean,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741118, "o", "    print(\"iat_variance,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741166, "o", "    print(\"iat_cv,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.741213, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741259, "o", "# Producer/Consumer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741304, "o", "num_producers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741348, "o", "num_consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741392, "o", "for ip in nodes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741431, "o", "    sent = ip_sent[ip]\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.741475, "o", ">     recv = ip_recv[ip]\r\n\u001b[?2004l\r"]
[70.741525, "o", "\u001b[?2004h> "]
[70.741571, "o", "    if sent + recv > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741621, "o", "        pcr = (sent - recv) / (sent + recv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.741665, "o", ">         if pcr > 0.2:\r\n\u001b[?2004l\r"]
[70.741714, "o", "\u001b[?2004h> "]
[70.741759, "o", "            num_producers += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741809, "o", "        elif pcr < -0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.741861, "o", "            num_consumers += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.741919, "o", "> "]
[70.741951, "o", "print(f\"num_producers,{num_producers}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.742018, "o", "print(f\"num_consumers,{num_consumers}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.742047, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.742108, "o", "# Flows\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.742138, "o", "> print(f\"unique_flows,{len(flows)}\")\r\n\u001b[?2004l\r"]
[70.742209, "o", "\u001b[?2004h> bidi_flows = 0\r\n\u001b[?2004l\r"]
[70.742239, "o", "\u001b[?2004h> seen_flows = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.7423, "o", "for f in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.742436, "o", "    # f = (src_ip, dst_ip, src_port, dst_port, protocol)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.742487, "o", "    rev_f = (f[1], f[0], f[3], f[2], f[4])\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.742517, "o", ">     if rev_f in flows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.742575, "o", ">         bidi_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.742603, "o", "> "]
[70.742746, "o", "print(f\"bidirectional_flows,{bidi_flows}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"tcp_flows,{len(tcp_flows)}\")\r\n\u001b[?2004l\r"]
[70.74282, "o", "\u001b[?2004h> print(f\"udp_flows,{len(udp_flows)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.742904, "o", "\u001b[?2004h> "]
[70.742941, "o", "# Analysis (Very basic heuristic)\r\n\u001b[?2004l\r\u001b[?2004h> # is_traffic_benign\r\n\u001b[?2004l\r"]
[70.742972, "o", "\u001b[?2004h> "]
[70.74309, "o", "# has_port_scan: many flows to different ports on same IP or many IPs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743172, "o", "# has_dos_pattern: high packets per minute\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743222, "o", "# has_beaconing: low IAT variance\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.74326, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743324, "o", "# Heuristics for analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743407, "o", "has_port_scan = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743497, "o", "# Check if any source scanned many ports on a single destination\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743558, "o", "src_dst_ports = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.743594, "o", "> for f in flows:\r\n\u001b[?2004l\r"]
[70.743629, "o", "\u001b[?2004h> "]
[70.743706, "o", "    if f[4] in ['TCP', 'UDP']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743819, "o", "        src_dst_ports[(f[0], f[1])].add(f[3])\r\n\u001b[?2004l\r\u001b[?2004h> for ports in src_dst_ports.values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743911, "o", "    if len(ports) > 50: # Arbitrary threshold\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743964, "o", "        has_port_scan = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.743999, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744028, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.744176, "o", "has_dos_pattern = max(counts_list) > 10000 if counts_list else False # Arbitrary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.744292, "o", "has_beaconing = (iat_cv < 0.5 and iat_mean > 0.1) if iats else False # Arbitrary\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744326, "o", "> "]
[70.744427, "o", "is_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744498, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.744563, "o", "print(f\"is_traffic_benign,{str(is_traffic_benign).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.744653, "o", "print(f\"has_port_scan,{str(has_port_scan).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744691, "o", "> "]
[70.744758, "o", "print(f\"has_dos_pattern,{str(has_dos_pattern).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744791, "o", "> "]
[70.744856, "o", "print(f\"has_beaconing,{str(has_beaconing).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.744893, "o", "> EOF\r\n\u001b[?2004l\r"]
[70.74611, "o", "\u001b[?2004hroot@5d2beef910ef:~# "]
