[151.433477, "o", "metric,value\r\r\n# Protocol Distribution\r\r\nprotocol_tcp,32620\r\r\nprotocol_udp,25846\r\r\nprotocol_icmp,8\r\r\nprotocol_arp,54938\r\r\nprotocol_ip_total,58474\r\r\n# Time Series\r\r\nduration_seconds,26030.33075594902\r\r\npackets_per_minute_avg,262.9009216589862\r\r\npackets_per_minute_max,2372\r\r\npackets_per_minute_min,186\r\r\n# Size Statistics\r\r\ntotal_bytes,30889470\r\r\navg_packet_size,270.7251597297084\r\r\nmin_packet_size,42\r\r\nmax_packet_size,56538\r\r\n# Entropy Metrics (Shannon entropy in bits)\r\r\ndst_port_entropy,4.2811152557544006\r\r\nsrc_port_entropy,4.339615103245355\r\r\nsrc_ip_entropy,2.483323397319809\r\r\ndst_ip_entropy,2.46176185712535\r\r\nunique_dst_ports,1675\r\r\nunique_src_ports,1713\r\r\n# Graph/Topology Metrics\r\r\nnum_nodes,38\r\r\nnum_edges,58\r\r\nnetwork_density,0.041251778093883355\r\r\nmax_indegree,23\r\r\nmax_outdegree,27\r\r\n# Temporal Metrics\r\r\niat_mean,0.2281401142522132\r\r\niat_variance,0.06328160807943833\r\r\niat_cv,1.1026485193832714\r\r\nnum_producers,23\r\r\nnum_consumers,13\r\r\n# Flow Metrics\r\r\nunique_flows,3569\r\r\nbidirectional_flows,3518\r\r\ntcp_flows,3353\r\r\nudp_flows,214\r\r\n# Analysis Questions (true/false)\r\r\nis_traffic_benign,false\r\r\nhas_port_scan,true\r\r\nhas_dos_pattern,false\r\r\nhas_beaconing,false\r\r\n"]
