[110.699986, "o", "timestamps = []\r\n\u001b[?2004l\r"]
[110.700012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[110.700076, "o", "src_ips_counts = Counter()\r\n\u001b[?2004l\r"]
[110.7001, "o", "\u001b[?2004h> "]
[110.700159, "o", "dst_ips_counts = Counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.700224, "o", "src_ports_counts = Counter()\r\n\u001b[?2004l\r"]
[110.700249, "o", "\u001b[?2004h> "]
[110.700298, "o", "dst_ports_counts = Counter()\r\n\u001b[?2004l\r"]
[110.700323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h> "]
[110.700453, "o", "# Flows: (src_ip, dst_ip, src_port, dst_port, protocol)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.700477, "o", "flows = set()\r\n\u001b[?2004l\r"]
[110.700502, "o", "\u001b[?2004h> "]
[110.700572, "o", "tcp_flows = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.700597, "o", "udp_flows = set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[110.700659, "o", "\u001b[?2004h> "]
[110.700695, "o", "# Graph\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[110.700732, "o", "edges = set() # (src_ip, dst_ip)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h"]
[110.700768, "o", "> "]
[110.700794, "o", "# PCR computation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.700854, "o", "ip_sent = defaultdict(int)\r\n\u001b[?2004l\r i\u001b[?2004h"]
[110.700891, "o", "> "]
[110.700927, "o", "ip_recv = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[110.700964, "o", "\u001b[?2004h> "]
[110.701031, "o", "with PcapReader('/root/packets.pcap') as pr:\r\n\u001b[?2004l\rn"]
[110.701056, "o", "\u001b[?2004h> "]
[110.701081, "o", "    for p in pr:\r\n\u001b[?2004l\rt\u001b[?2004h"]
[110.701162, "o", "> "]
[110.701201, "o", "        ts = float(p.time)\r\n\u001b[?2004l\r =\u001b[?2004h> "]
[110.701226, "o", "        timestamps.append(ts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.701287, "o", "> "]
[110.701325, "o", "        size = len(p)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[110.701369, "o", "        sizes.append(size)\r\n\u001b[?2004l\r"]
[110.701405, "o", "\u001b[?2004h> "]
[110.701439, "o", "        total_bytes += size\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[110.701474, "o", "        \r\n\u001b[?2004l\r_v\u001b[?2004h> "]
[110.701545, "o", "        if p.haslayer(IP):\r\n\u001b[?2004l\r"]
[110.701571, "o", "\u001b[?2004h> "]
[110.70162, "o", "            ip_total += 1\r\n\u001b[?2004l\rea\u001b[?2004h> "]
[110.701691, "o", "            src_ip = p[IP].src\r\n\u001b[?2004l\r"]
[110.701742, "o", "\u001b[?2004h> "]
[110.701778, "o", "            dst_ip = p[IP].dst\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[110.70186, "o", "            src_ips_counts[src_ip] += 1\r\n\u001b[?2004l\r"]
[110.701895, "o", "\u001b[?2004h> "]
[110.70195, "o", "            dst_ips_counts[dst_ip] += 1\r\n\u001b[?2004l\r"]
[110.701985, "o", "\u001b[?2004h> "]
[110.702049, "o", "            edges.add((src_ip, dst_ip))\r\n\u001b[?2004l\rp\u001b[?2004h> "]
[110.702127, "o", "            ip_sent[src_ip] += size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.70222, "o", "            ip_recv[dst_ip] += size\r\n\u001b[?2004l\r= ("]
[110.70226, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[110.702315, "o", "\u001b[?2004h> "]
[110.70235, "o", "            proto = p[IP].proto\r\n\u001b[?2004l\r >\u001b[?2004h"]
[110.702391, "o", "> "]
[110.702415, "o", "            sport = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.702467, "o", "            dport = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.702505, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.702586, "o", "            if p.haslayer(TCP):\r\n\u001b[?2004l\r"]
[110.702622, "o", "\u001b[?2004h> "]
[110.702676, "o", "                proto_counts['tcp'] += 1\r\n\u001b[?2004l\rri"]
[110.702692, "o", "\u001b[?2004h> "]
[110.702775, "o", "                sport = p[TCP].sport\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.702871, "o", "                dport = p[TCP].dport\r\n\u001b[?2004l\rl\u001b[?2004h"]
[110.702891, "o", "> "]
[110.703031, "o", "                tcp_flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.703158, "o", "                flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.703181, "o", "> "]
[110.703242, "o", "            elif p.haslayer(UDP):\r\n\u001b[?2004l\r"]
[110.703264, "o", "\u001b[?2004h> "]
[110.703334, "o", "                proto_counts['udp'] += 1\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[110.703433, "o", "                sport = p[UDP].sport\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[110.703452, "o", "> "]
[110.70351, "o", "                dport = p[UDP].dport\r\n\u001b[?2004l\r"]
[110.703528, "o", "\u001b[?2004h> "]
[110.703655, "o", "                udp_flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\r\n\u001b[?2004l\r"]
[110.703673, "o", "\u001b[?2004h> "]
[110.703802, "o", "                flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.703881, "o", "            elif p.haslayer(ICMP):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.703902, "o", "> "]
[110.70398, "o", "                proto_counts['icmp'] += 1\r\n\u001b[?2004l\r \u001b[?2004h"]
[110.704002, "o", "> "]
[110.704127, "o", "                flows.add((src_ip, dst_ip, None, None, 'ICMP'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.704177, "o", "            else:\r\n\u001b[?2004l\ri"]
[110.704196, "o", "\u001b[?2004h> "]
[110.704312, "o", "                flows.add((src_ip, dst_ip, None, None, proto))\r\n\u001b[?2004l\r"]
[110.704335, "o", "\u001b[?2004h> "]
[110.704369, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.704388, "o", "> "]
[110.704444, "o", "            if sport is not None:\r\n\u001b[?2004l\r"]
[110.704465, "o", "\u001b[?2004h> "]
[110.70456, "o", "                src_ports_counts[sport] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.704639, "o", "            if dport is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.704739, "o", "                dst_ports_counts[dport] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.704782, "o", "                \r\n\u001b[?2004l\r"]
[110.7048, "o", "\u001b[?2004h> "]
[110.70485, "o", "        elif p.haslayer(ARP):\r\n\u001b[?2004l\r"]
[110.704868, "o", "\u001b[?2004h> "]
[110.704936, "o", "            proto_counts['arp'] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.704957, "o", "\r\n\u001b[?2004l\rp\u001b[?2004h"]
[110.704977, "o", "> "]
[110.70501, "o", "# Protocol counts\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.705031, "o", "> "]
[110.705107, "o", "print(f\"protocol_tcp,{proto_counts['tcp']}\")\r\n\u001b[?2004l\r"]
[110.705129, "o", "\u001b[?2004h> "]
[110.705212, "o", "print(f\"protocol_udp,{proto_counts['udp']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705295, "o", "print(f\"protocol_icmp,{proto_counts['icmp']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705377, "o", "print(f\"protocol_arp,{proto_counts['arp']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705448, "o", "print(f\"protocol_ip_total,{ip_total}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705472, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705508, "o", "# Time / rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705612, "o", "duration = max(timestamps) - min(timestamps) if timestamps else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705683, "o", "print(f\"duration_seconds,{duration}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705708, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705742, "o", "if timestamps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.705798, "o", "    start_ts = min(timestamps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.705818, "o", "> "]
[110.705861, "o", "    buckets = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.705882, "o", "> "]
[110.705914, "o", "    for ts in timestamps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.705936, "o", "> "]
[110.706002, "o", "        bucket = int((ts - start_ts) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.706023, "o", "> "]
[110.706067, "o", "        buckets[bucket] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.70609, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706163, "o", "    num_buckets = int(duration // 60) + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706263, "o", "    counts_list = [buckets[i] for i in range(num_buckets)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706394, "o", "    print(f\"packets_per_minute_avg,{sum(counts_list)/len(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706491, "o", "    print(f\"packets_per_minute_max,{max(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.706511, "o", "> "]
[110.70659, "o", "    print(f\"packets_per_minute_min,{min(counts_list)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.706614, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.706634, "o", "> "]
[110.706668, "o", "    counts_list = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706744, "o", "    print(\"packets_per_minute_avg,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706826, "o", "    print(\"packets_per_minute_max,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706889, "o", "    print(\"packets_per_minute_min,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.706908, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.706939, "o", "# Sizes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.707009, "o", "print(f\"total_bytes,{total_bytes}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707032, "o", "> if sizes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707055, "o", "> "]
[110.707135, "o", "    print(f\"avg_packet_size,{sum(sizes)/len(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707168, "o", "> "]
[110.707217, "o", "    print(f\"min_packet_size,{min(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.707292, "o", "    print(f\"max_packet_size,{max(sizes)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.707313, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707336, "o", "> "]
[110.707385, "o", "    print(\"avg_packet_size,0\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.70745, "o", "    print(\"min_packet_size,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707471, "o", "> "]
[110.707508, "o", "    print(\"max_packet_size,0\")\r\n\u001b[?2004l\r"]
[110.707527, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.707549, "o", "\u001b[?2004h> "]
[110.707573, "o", "# Entropy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.707722, "o", "print(f\"dst_port_entropy,{shannon_entropy(dst_ports_counts, sum(dst_ports_counts.values()))}\")\r\n\u001b[?2004l\r"]
[110.707743, "o", "\u001b[?2004h> "]
[110.707876, "o", "print(f\"src_port_entropy,{shannon_entropy(src_ports_counts, sum(src_ports_counts.values()))}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708016, "o", "print(f\"src_ip_entropy,{shannon_entropy(src_ips_counts, sum(src_ips_counts.values()))}\")\r\n\u001b[?2004l\r"]
[110.708037, "o", "\u001b[?2004h> "]
[110.708173, "o", "print(f\"dst_ip_entropy,{shannon_entropy(dst_ips_counts, sum(dst_ips_counts.values()))}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708262, "o", "print(f\"unique_dst_ports,{len(dst_ports_counts)}\")\r\n\u001b[?2004l\r"]
[110.708283, "o", "\u001b[?2004h> "]
[110.708357, "o", "print(f\"unique_src_ports,{len(src_ports_counts)}\")\r\n\u001b[?2004l\r"]
[110.70838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.708401, "o", "> # Graph\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.708421, "o", "> "]
[110.708521, "o", "nodes = set(src_ips_counts.keys()) | set(dst_ips_counts.keys())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708569, "o", "num_nodes = len(nodes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708617, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708686, "o", "print(f\"num_nodes,{num_nodes}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708754, "o", "print(f\"num_edges,{num_edges}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.708798, "o", "if num_nodes < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.70884, "o", "    density = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.708861, "o", "> else:\r\n\u001b[?2004l\r"]
[110.708883, "o", "\u001b[?2004h> "]
[110.708966, "o", "    density = num_edges / (num_nodes * (num_nodes - 1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709035, "o", "print(f\"network_density,{density}\")\r\n\u001b[?2004l\r"]
[110.709054, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.709078, "o", "\u001b[?2004h> "]
[110.709152, "o", "outdegrees = Counter(src for src, dst in edges)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709225, "o", "indegrees = Counter(dst for src, dst in edges)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709342, "o", "print(f\"max_indegree,{max(indegrees.values()) if indegrees else 0}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709472, "o", "print(f\"max_outdegree,{max(outdegrees.values()) if outdegrees else 0}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709493, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709513, "o", "# Timing\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.709534, "o", "> "]
[110.709574, "o", "timestamps.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709686, "o", "iats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709715, "o", "if iats:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.709735, "o", "> "]
[110.709789, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.709899, "o", "    iat_var = sum((x - iat_mean)**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.70992, "o", "> "]
[110.710005, "o", "    iat_cv = (iat_var**0.5 / iat_mean) if iat_mean != 0 else 0\r\n\u001b[?2004l\r"]
[110.710028, "o", "\u001b[?2004h> "]
[110.710079, "o", "    print(f\"iat_mean,{iat_mean}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710101, "o", "> "]
[110.710151, "o", "    print(f\"iat_variance,{iat_var}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710172, "o", "> "]
[110.710211, "o", "    print(f\"iat_cv,{iat_cv}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.71023, "o", "> else:\r\n\u001b[?2004l\r"]
[110.710249, "o", "\u001b[?2004h> "]
[110.710281, "o", "    iat_mean = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.710326, "o", "    iat_cv = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.710369, "o", "    print(\"iat_mean,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710389, "o", "> "]
[110.710427, "o", "    print(\"iat_variance,0\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710448, "o", "> "]
[110.710478, "o", "    print(\"iat_cv,0\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.710499, "o", "\u001b[?2004h> "]
[110.710544, "o", "# Producer/Consumer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.710586, "o", "num_producers = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710606, "o", "> "]
[110.710626, "o", "num_consumers = 0\r\n\u001b[?2004l\r"]
[110.710647, "o", "\u001b[?2004h> "]
[110.710665, "o", "for ip in nodes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.710686, "o", "> "]
[110.710721, "o", "    sent = ip_sent[ip]\r\n\u001b[?2004l\r"]
[110.710743, "o", "\u001b[?2004h> "]
[110.710774, "o", "    recv = ip_recv[ip]\r\n\u001b[?2004l\r"]
[110.710805, "o", "\u001b[?2004h> "]
[110.710838, "o", "    if sent + recv > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.710921, "o", "        pcr = (sent - recv) / (sent + recv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.71097, "o", "        if pcr > 0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711037, "o", "            num_producers += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711057, "o", "> "]
[110.711091, "o", "        elif pcr < -0.2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711116, "o", "> "]
[110.711146, "o", "            num_consumers += 1\r\n\u001b[?2004l\r"]
[110.711167, "o", "\u001b[?2004h> "]
[110.711227, "o", "print(f\"num_producers,{num_producers}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711306, "o", "print(f\"num_consumers,{num_consumers}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711324, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711357, "o", "# Flows\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711379, "o", "> "]
[110.711422, "o", "print(f\"unique_flows,{len(flows)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711442, "o", "> "]
[110.711463, "o", "bidi_flows = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711484, "o", "> "]
[110.711505, "o", "for f in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711581, "o", "    rev_f = (f[1], f[0], f[3], f[2], f[4])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711633, "o", "    if rev_f in flows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711655, "o", "> "]
[110.711685, "o", "        bidi_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711705, "o", "> "]
[110.711763, "o", "print(f\"bidirectional_flows,{bidi_flows}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.711784, "o", "> "]
[110.711834, "o", "print(f\"tcp_flows,{len(tcp_flows)}\")\r\n\u001b[?2004l\r"]
[110.711853, "o", "\u001b[?2004h> "]
[110.711905, "o", "print(f\"udp_flows,{len(udp_flows)}\")\r\n\u001b[?2004l\r"]
[110.711933, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.711993, "o", "# Heuristics for analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712034, "o", "has_port_scan = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712099, "o", "src_dst_ports = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.71212, "o", "> "]
[110.712138, "o", "for f in flows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.712158, "o", "> "]
[110.712208, "o", "    if f[4] in ['TCP', 'UDP']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712302, "o", "        src_dst_ports[(f[0], f[1])].add(f[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712367, "o", "for ports in src_dst_ports.values():\r\n\u001b[?2004l\r"]
[110.712406, "o", "\u001b[?2004h>     if len(ports) > 50:\r\n"]
[110.712426, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.712479, "o", "        has_port_scan = True\r\n\u001b[?2004l\r"]
[110.712504, "o", "\u001b[?2004h> "]
[110.712522, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.71254, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.712564, "o", "> "]
[110.712666, "o", "has_dos_pattern = max(counts_list) > 10000 if counts_list else False\r\n\u001b[?2004l\r"]
[110.712686, "o", "\u001b[?2004h> "]
[110.71278, "o", "has_beaconing = (iat_cv < 0.5 and iat_mean > 0.1) if iats else False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712909, "o", "is_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.712931, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.712953, "o", "> "]
[110.713042, "o", "print(f\"is_traffic_benign,{str(is_traffic_benign).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.713065, "o", "> "]
[110.713132, "o", "print(f\"has_port_scan,{str(has_port_scan).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.713232, "o", "print(f\"has_dos_pattern,{str(has_dos_pattern).lower()}\")\r\n\u001b[?2004l\r"]
[110.713253, "o", "\u001b[?2004h> "]
[110.713329, "o", "print(f\"has_beaconing,{str(has_beaconing).lower()}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.713355, "o", "EOF\r\n\u001b[?2004l\r"]
[110.737762, "o", "\u001b[?2004hroot@5d2beef910ef:~# "]
