[74.902499, "o", "cat /root/compute_stats.py\r\n\u001b[?2004l\r"]
[74.903245, "o", "import sys\r\nfrom scapy.all import *\r\nimport math\r\nfrom collections import Counter, defaultdict\r\n\r\ndef shannon_entropy(data):\r\n    if not data:\r\n        return 0\r\n    counts = Counter(data)\r\n    total = len(data)\r\n    entropy = 0\r\n    for count in counts.values():\r\n        p = count / total\r\n        entropy -= p * math.log2(p)\r\n    return entropy\r\n\r\npkts = rdpcap('/root/packets.pcap')\r\n\r\n# Basic counts\r\nproto_counts = Counter()\r\nip_total = 0\r\ntotal_bytes = 0\r\nsizes = []\r\ntimestamps = []\r\n\r\nsrc_ips = []\r\ndst_ips = []\r\nsrc_ports = []\r\ndst_ports = []\r\n\r\n# Flows: (src_ip, dst_ip, src_port, dst_port, protocol)\r\nflows = set()\r\ntcp_flows = set()\r\nudp_flows = set()\r\n\r\n# Graph\r\nedges = set() # (src_ip, dst_ip)\r\n\r\n# PCR computation: bytes sent/received per IP\r\nip_sent = defaultdict(int)\r\nip_recv = defaultdict(int)\r\n\r\nfor p in pkts:\r\n    ts = float(p.time)\r\n    timestamps.append(ts)\r\n    size = len(p)\r\n    sizes.append(size)\r\n    total_bytes += size\r\n    \r\n    if p.haslayer(IP):\r\n        ip_total += 1\r\n        src_ip = p[IP].src\r\n        dst_ip = p[IP].dst\r\n        src_ips.append(src_ip)\r\n        dst_ips.append(dst_ip)\r\n        edges.add((src_ip, dst_ip))\r\n        ip_sent[src_ip] += size\r\n        ip_recv[dst_ip] += size\r\n        \r\n        proto = p[IP].proto\r\n        sport = None\r\n        dport = None\r\n        \r\n        if p.haslayer(TCP):\r\n            proto_counts['tcp'] += 1\r\n            sport = p[TCP].sport\r\n            dport = p[TCP].dport\r\n            tcp_flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\r\n            flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\r\n        elif p.haslayer(UDP):\r\n            proto_counts['udp'] += 1\r\n            sport = p[UDP].sport\r\n            dport = p[UDP].dport\r\n            udp_flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\r\n            flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\r\n        elif p.haslayer(ICMP):\r\n            proto_counts['icmp'] += 1\r\n            flows.add((src_ip, dst_ip, None, None, 'ICMP'))\r\n        else:\r\n            # Other IP protocols\r\n            flows.add((src_ip, dst_ip, None, None, proto))\r\n            \r\n        if sport is not None:"]
[74.903323, "o", "\r\n            src_ports.append(sport)\r\n        if dport is not None:\r\n            dst_ports.append(dport)\r\n            \r\n    elif p.haslayer(ARP):\r\n        proto_counts['arp'] += 1\r\n\r\n# Protocol counts\r\nprint(f\"protocol_tcp,{proto_counts['tcp']}\")\r\nprint(f\"protocol_udp,{proto_counts['udp']}\")\r\nprint(f\"protocol_icmp,{proto_counts['icmp']}\")\r\nprint(f\"protocol_arp,{proto_counts['arp']}\")\r\nprint(f\"protocol_ip_total,{ip_total}\")\r\n\r\n# Time / rate\r\nduration = max(timestamps) - min(timestamps) if timestamps else 0\r\nprint(f\"duration_seconds,{duration}\")\r\n\r\nif timestamps:\r\n    start_ts = min(timestamps)\r\n    buckets = defaultdict(int)\r\n    for ts in timestamps:\r\n        bucket = int((ts - start_ts) // 60)\r\n        buckets[bucket] += 1\r\n    \r\n    # Number of full or partial minutes\r\n    num_buckets = int(duration // 60) + 1\r\n    counts_list = [buckets[i] for i in range(num_buckets)]\r\n    print(f\"packets_per_minute_avg,{sum(counts_list)/len(counts_list)}\")\r\n    print(f\"packets_per_minute_max,{max(counts_list)}\")\r\n    print(f\"packets_per_minute_min,{min(counts_list)}\")\r\nelse:\r\n    print(\"packets_per_minute_avg,0\")\r\n    print(\"packets_per_minute_max,0\")\r\n    print(\"packets_per_minute_min,0\")\r\n\r\n# Sizes\r\nprint(f\"total_bytes,{total_bytes}\")\r\nif sizes:\r\n    print(f\"avg_packet_size,{sum(sizes)/len(sizes)}\")\r\n    print(f\"min_packet_size,{min(sizes)}\")\r\n    print(f\"max_packet_size,{max(sizes)}\")\r\nelse:\r\n    print(\"avg_packet_size,0\")\r\n    print(\"min_packet_size,0\")\r\n    print(\"max_packet_size,0\")\r\n\r\n# Entropy\r\nprint(f\"dst_port_entropy,{shannon_entropy(dst_ports)}\")\r\nprint(f\"src_port_entropy,{shannon_entropy(src_ports)}\")\r\nprint(f\"src_ip_entropy,{shannon_entropy(src_ips)}\")\r\nprint(f\"dst_ip_entropy,{shannon_entropy(dst_ips)}\")\r\nprint(f\"unique_dst_ports,{len(set(dst_ports))}\")\r\nprint(f\"unique_src_ports,{len(set(src_ports))}\")\r\n\r\n# Graph\r\n"]
[74.903456, "o", "nodes = set(src_ips) | set(dst_ips)\r\nnum_nodes = len(nodes)\r\nnum_edges = len(edges)\r\nprint(f\"num_nodes,{num_nodes}\")\r\nprint(f\"num_edges,{num_edges}\")\r\nif num_nodes < 2:\r\n    density = 0\r\nelse:\r\n    density = num_edges / (num_nodes * (num_nodes - 1))\r\nprint(f\"network_density,{density}\")\r\n\r\noutdegrees = Counter(src for src, dst in edges)\r\nindegrees = Counter(dst for src, dst in edges)\r\nprint(f\"max_indegree,{max(indegrees.values()) if indegrees else 0}\")\r\nprint(f\"max_outdegree,{max(outdegrees.values()) if outdegrees else 0}\")\r\n\r\n# Timing\r\ntimestamps.sort()\r\niats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\r\nif iats:\r\n    iat_mean = sum(iats) / len(iats)\r\n    iat_var = sum((x - iat_mean)**2 for x in iats) / len(iats)\r\n    iat_cv = (iat_var**0.5 / iat_mean) if iat_mean != 0 else 0\r\n    print(f\"iat_mean,{iat_mean}\")\r\n    print(f\"iat_variance,{iat_var}\")\r\n    print(f\"iat_cv,{iat_cv}\")\r\nelse:\r\n    print(\"iat_mean,0\")\r\n    print(\"iat_variance,0\")\r\n    print(\"iat_cv,0\")\r\n\r\n# Producer/Consumer\r\nnum_producers = 0\r\nnum_consumers = 0\r\nfor ip in nodes:\r\n    sent = ip_sent[ip]\r\n    recv = ip_recv[ip]\r\n    if sent + recv > 0:\r\n        pcr = (sent - recv) / (sent + recv)\r\n        if pcr > 0.2:\r\n            num_producers += 1\r\n        elif pcr < -0.2:\r\n            num_consumers += 1\r\nprint(f\"num_producers,{num_producers}\")\r\nprint(f\"num_consumers,{num_consumers}\")\r\n\r\n# Flows\r\nprint(f\"unique_flows,{len(flows)}\")\r\nbidi_flows = 0\r\nseen_flows = set()\r\nfor f in flows:\r\n    # f = (src_ip, dst_ip, src_port, dst_port, protocol)\r\n    rev_f = (f[1], f[0], f[3], f[2], f[4])\r\n    if rev_f in flows:\r\n        bidi_flows += 1\r\nprint(f\"bidirectional_flows,{bidi_flows}\")\r\nprint(f\"tcp_flows,{len(tcp_flows)}\")\r\nprint(f\"udp_flows,{len(udp_flows)}\")\r\n\r\n# Analysis (Very basic heuristic)\r\n# is_traffic_benign\r\n# has_port_scan: many flows to different ports on same IP or many IPs\r\n# has_dos_pattern: high packets per minute\r\n# has_beaconing: low IAT variance\r\n\r\n# Heuristics for analysis flags\r\nhas_port_scan = False\r\n# Check if any source scanned many ports on a single destination\r\nsrc_dst_ports = defaultdict(set)\r\nfor f in flows:\r\n    if f[4] in ['TCP', 'UDP']:\r\n        src_dst_ports[(f[0], f[1])].add(f[3])\r\nfor ports in src_dst_ports.values():\r\n    if len(ports) > 50: # Arbitrary threshold\r\n        has_port_scan = True"]
[74.90356, "o", "\r\n        break\r\n\r\nhas_dos_pattern = max(counts_list) > 10000 if counts_list else False # Arbitrary\r\nhas_beaconing = (iat_cv < 0.5 and iat_mean > 0.1) if iats else False # Arbitrary\r\nis_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\r\n\r\nprint(f\"is_traffic_benign,{str(is_traffic_benign).lower()}\")\r\nprint(f\"has_port_scan,{str(has_port_scan).lower()}\")\r\nprint(f\"has_dos_pattern,{str(has_dos_pattern).lower()}\")\r\nprint(f\"has_beaconing,{str(has_beaconing).lower()}\")\r\n"]
