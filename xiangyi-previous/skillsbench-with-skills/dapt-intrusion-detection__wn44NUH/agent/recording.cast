[150.409904, "i", "cat << 'EOF' > /root/update_csv.py\nimport csv\n\nresults = {}\nwith open('/root/results.txt', 'r') as f:\n    for line in f:\n        if ',' in line:\n            k, v = line.strip().split(',', 1)\n            results[k] = v\n\noutput = []\nwith open('/root/network_stats.csv', 'r') as f:\n    reader = csv.reader(f)\n    for row in reader:\n        if not row:\n            output.append([])\n            continue\n        metric = row[0]\n        if metric in results:\n            output.append([metric, results[metric]])\n        else:\n            output.append(row)\n\nwith open('/root/network_stats.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerows(output)\nEOF\n"]
