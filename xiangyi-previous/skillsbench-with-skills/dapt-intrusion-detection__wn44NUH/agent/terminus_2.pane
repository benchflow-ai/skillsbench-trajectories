[?2004l[?2004h> src_dst_ports = defaultdict(set)
[?2004l[?2004h> for f in flows:
[?2004l[?2004h>     if f[4] in ['TCP', 'UDP']:
[?2004l[?2004h>         src_dst_ports[(f[0], f[1])].add(f[3])
[?2004l[?2004h> for ports in src_dst_ports.values():
[?2004l[?2004h>     if len(ports) > 50: # Arbitrary threshold
[?2004l[?2004h>         has_port_scan = True
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> has_dos_pattern = max(counts_list) > 10000 if counts_list else False # Arbitrary
[?2004l[?2004h> has_beaconing = (iat_cv < 0.5 and iat_mean > 0.1) if iats else False # Arbitrary
[?2004l[?2004h> is_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)
[?2004l[?2004h> 
