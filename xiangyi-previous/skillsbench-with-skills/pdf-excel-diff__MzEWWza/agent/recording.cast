[60.355135, "i", "cat <<EOF > compare_records.py\nimport pandas as pd\nimport pdfplumber\nimport json\n\ndef clean_currency(val):\n    if isinstance(val, str):\n        return int(val.replace(',', ''))\n    return val\n\ndef clean_int(val):\n    return int(val)\n\ndef clean_float(val):\n    return float(val)\n\n# 1. Read Excel (Current Data)\ndf_excel = pd.read_excel('/root/employees_current.xlsx')\n# Ensure ID is string\ndf_excel['ID'] = df_excel['ID'].astype(str)\n\n# Convert Excel dataframe to a dict of dicts for easy lookup: {ID: {col: val, ...}}\n# We need to ensure types are native Python types for JSON serialization later\nexcel_records = {}\nfor _, row in df_excel.iterrows():\n    rec = row.to_dict()\n    # explicit type conversion for consistency\n    rec['Salary'] = int(rec['Salary'])\n    rec['Years'] = int(rec['Years'])\n    rec['Score'] = float(rec['Score'])\n    excel_records[rec['ID']] = rec\n\n# 2. Read PDF (Old Data)\npdf_rows = []\nwith pdfplumber.open('/root/employees_backup.pdf') as pdf:\n    for page in pdf.pages:\n        table = page.extract_table()\n        if table:\n            pdf_rows.extend(table)\n\n# Extract header and data\nheader = pdf_rows[0]\npdf_data = []\nfor row in pdf_rows[1:]:\n    # Skip repeated headers if any\n    if row == header:\n        continue\n    # Map row to dictionary\n    record = dict(zip(header, row))\n    pdf_data.append(record)\n\n# Clean PDF data and build dict\npdf_records = {}\nfor rec in pdf_data:\n    emp_id = rec['ID']\n    \n    # Type conversion to match Excel\n    try:\n        rec['Salary'] = clean_currency(rec['Salary'])\n        rec['Years'] = clean_int(rec['Years'])\n        rec['Score'] = clean_float(rec['Score'])\n    except ValueError as e:\n        print(f\"Skipping malformed row for {emp_id}: {e}\")\n        continue\n        \n    pdf_records[emp_id] = rec\n\n# 3. Compare\ndeleted_employees = []\nmodified_employees = []\n\n# Check for deleted (in PDF but not in Excel)\nfor emp_id in pdf_records:\n    if emp_id not in excel_records:\n        deleted_employees.append(emp_id)\n\n# Check for modifications (in both)\ncolumns_to_compare = ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']\n\nfor emp_id, old_rec in pdf_records.items():\n    if emp_id in excel_records:\n        new_rec = excel_records[emp_id]\n        for field in columns_to_compare:\n            old_val = old_rec[field]\n            new_val = new_rec[field]\n            \n            # Compare\n            if old_val != new_val:\n                # Handle potential floating point epsilon issues if necessary, \n                # but simple equality usually works for simple decimals like 4.3 vs 4.3\n                # If strict equality fails for floats, we might need math.isclose, \n                # but let's assume standard values.\n                \n                modified_employees.append({\n                    \"id\": emp_id,\n                    \"field\": field,\n                    \"old_value\": old_val,\n                    \"new_value\": new_val\n                })\n\n# 4. Sort results\ndeleted_employees.sort()\nmodified_employees.sort(key=lambda x: x['id'])\n\noutput = {\n    \"deleted_employees\": deleted_employees,\n    \"modified_employees\": modified_employees\n}\n\n# 5. Write JSON\nwith open('/root/diff_report.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(\"Comparison complete. Report generated.\")\nEOF\n"]
