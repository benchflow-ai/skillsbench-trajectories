[22.618239, "i", "cat <<EOF > inspect_data.py\nimport pandas as pd\nimport pdfplumber\n\nprint(\"--- Excel Data Inspection ---\")\ntry:\n    df_excel = pd.read_excel('/root/employees_current.xlsx')\n    print(\"Columns:\", df_excel.columns.tolist())\n    print(df_excel.head())\nexcept Exception as e:\n    print(f\"Error reading Excel: {e}\")\n\nprint(\"\\n--- PDF Data Inspection ---\")\ntry:\n    with pdfplumber.open('/root/employees_backup.pdf') as pdf:\n        first_page = pdf.pages[0]\n        table = first_page.extract_table()\n        if table:\n            print(\"First few rows of PDF table:\")\n            for row in table[:5]:\n                print(row)\n        else:\n            print(\"No table found on first page.\")\nexcept Exception as e:\n    print(f\"Error reading PDF: {e}\")\nEOF\n"]
