\n      \"new_value\": \"QA\"\r\n    },\r\n    {\r\n      \"id\": \"EMP02747\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 56000,\r\n      \"new_value\": 68000\r\n    },\r\n    {\r\n      \"id\": \"EMP03288\",\r\n      \"field\": \"Dept\",\r\n      \"old_value\": \"Ops\",\r\n      \"new_value\": \"HR\"\r\n    },\r\n    {\r\n      \"id\": \"EMP03671\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 142000,\r\n      \"new_value\": 152000\r\n    },\r\n    {\r\n      \"id\": \"EMP04744\",\r\n      \"field\": \"Years\",\r\n      \"old_value\": 5,\r\n      \"new_value\": 6\r\n    },\r\n    {\r\n      \"id\": \"EMP05566\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 81000,\r\n      \"new_value\": 93000\r\n    },\r\n    {\r\n      \"id\": \"EMP06168\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 89000,\r\n      \"new_value\": 84000\r\n    },\r\n    {\r\n      \"id\": \"EMP07590\",\r\n      \"field\": \"Years\",\r\n      \"old_value\": 6,\r\n      \"new_value\": 8\r\n    },\r\n    {\r\n      \"id\": \"EMP08190\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 67000,\r\n      \"new_value\": 92000\r\n    },\r\n    {\r\n      \"id\": \"EMP08218\",\r\n      \"field\": \"Salary\",\r\n      \"old_value\": 73000,\r\n      \"new_value\": 98000\r\n    },\r\n    {\r\n      \"id\": \"EMP08925\",\r\n      \"field\": \"Years\",\r\n      \"old_value\": 1,\r\n      \"new_value\": 2\r\n    }\r\n  ]\r\n}\u001b[?2004hroot@c5a29d18c496:~# "]
