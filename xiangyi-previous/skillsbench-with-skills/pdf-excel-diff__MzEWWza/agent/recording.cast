[60.360415, "o", "> "]
[60.360467, "o", "    # Type conversion to match Excel\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.360518, "o", "> "]
[60.360596, "o", "        rec['Salary'] = clean_currency(rec['Salary'])\r\n\u001b[?2004l\r"]
[60.360619, "o", "\u001b[?2004h> "]
[60.360749, "o", "        rec['Years'] = clean_int(rec['Years'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.360803, "o", "> "]
[60.360867, "o", "        rec['Score'] = clean_float(rec['Score'])\r\n\u001b[?2004l\r"]
[60.360895, "o", "\u001b[?2004h> "]
[60.360965, "o", "    except ValueError as e:\r\n\u001b[?2004l\r"]
[60.360994, "o", "\u001b[?2004h> "]
[60.361129, "o", "        print(f\"Skipping malformed row for {emp_id}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.361177, "o", "> "]
[60.361206, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.361236, "o", "        \r\n\u001b[?2004l\r"]
[60.361306, "o", "\u001b[?2004h> "]
[60.361335, "o", "    pdf_records[emp_id] = rec\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.361394, "o", "\u001b[?2004h> # 3. Compare\r\n\u001b[?2004l\r"]
[60.361427, "o", "\u001b[?2004h> "]
[60.361506, "o", "deleted_employees = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.361593, "o", "modified_employees = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.361626, "o", "\u001b[?2004h> "]
[60.36174, "o", "# Check for deleted (in PDF but not in Excel)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.361809, "o", "for emp_id in pdf_records:\r\n\u001b[?2004l\r"]
[60.361864, "o", "\u001b[?2004h> "]
[60.361914, "o", "    if emp_id not in excel_records:\r\n\u001b[?2004l\r"]
[60.361966, "o", "\u001b[?2004h> "]
[60.362036, "o", "        deleted_employees.append(emp_id)\r\n\u001b[?2004l\r"]
[60.362118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.362175, "o", "\u001b[?2004h> "]
[60.362236, "o", "# Check for modifications (in both)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.362433, "o", "columns_to_compare = ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.362461, "o", "> \r\n\u001b[?2004l\r"]
[60.362546, "o", "\u001b[?2004h> "]
[60.362616, "o", "for emp_id, old_rec in pdf_records.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.362651, "o", "> "]
[60.362717, "o", "    if emp_id in excel_records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.362804, "o", "        new_rec = excel_records[emp_id]\r\n\u001b[?2004l\r"]
[60.362831, "o", "\u001b[?2004h> "]
[60.362924, "o", "        for field in columns_to_compare:\r\n\u001b[?2004l\r"]
[60.362953, "o", "\u001b[?2004h> "]
[60.36304, "o", "            old_val = old_rec[field]\r\n\u001b[?2004l\r"]
[60.363066, "o", "\u001b[?2004h> "]
[60.363175, "o", "            new_val = new_rec[field]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.3632, "o", "            \r\n\u001b[?2004l\r"]
[60.363262, "o", "\u001b[?2004h> "]
[60.363292, "o", "            # Compare\r\n\u001b[?2004l\r"]
[60.363321, "o", "\u001b[?2004h> "]
[60.363418, "o", "            if old_val != new_val:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.363609, "o", "                # Handle potential floating point epsilon issues if necessary, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.363842, "o", "                # but simple equality usually works for simple decimals like 4.3 vs 4.3\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.363871, "o", "> "]
[60.364046, "o", "                # If strict equality fails for floats, we might need math.isclose, \r\n\u001b[?2004l\r"]
[60.364097, "o", "\u001b[?2004h> "]
[60.364192, "o", "                # but let's assume standard values.\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.364246, "o", "> "]
[60.364276, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.364371, "o", "                modified_employees.append({\r\n\u001b[?2004l\r"]
[60.3644, "o", "\u001b[?2004h> "]
[60.364475, "o", "                    \"id\": emp_id,\r\n\u001b[?2004l\r"]
[60.364506, "o", "\u001b[?2004h> "]
[60.364578, "o", "                    \"field\": field,\r\n\u001b[?2004l\r"]
[60.364634, "o", "\u001b[?2004h> "]
[60.364707, "o", "                    \"old_value\": old_val,\r\n\u001b[?2004l\r"]
[60.364735, "o", "\u001b[?2004h> "]
[60.364831, "o", "                    \"new_value\": new_val\r\n\u001b[?2004l\r"]
[60.364885, "o", "\u001b[?2004h> "]
[60.364915, "o", "                })\r\n\u001b[?2004l\r"]
[60.364968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[60.364998, "o", "> "]
[60.365024, "o", "# 4. Sort results\r\n\u001b[?2004l\r"]
[60.365079, "o", "\u001b[?2004h> "]
[60.365134, "o", "deleted_employees.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.365247, "o", "modified_employees.sort(key=lambda x: x['id'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.365303, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.365332, "o", "output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.365423, "o", "    \"deleted_employees\": deleted_employees,\r\n\u001b[?2004l\r"]
[60.365471, "o", "\u001b[?2004h> "]
[60.365539, "o", "    \"modified_employees\": modified_employees\r\n\u001b[?2004l\r"]
[60.365565, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[60.365592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.365646, "o", "\u001b[?2004h> "]
[60.365694, "o", "# 5. Write JSON\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.365726, "o", "> "]
[60.365844, "o", "with open('/root/diff_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.365907, "o", "    json.dump(output, f, indent=2)\r\n\u001b[?2004l\r"]
[60.365966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.365998, "o", "\u001b[?2004h> "]
[60.366095, "o", "print(\"Comparison complete. Report generated.\")\r\n\u001b[?2004l\r"]
[60.36615, "o", "\u001b[?2004h> EOF"]
[60.366182, "o", "\r\n\u001b[?2004l\r"]
[60.367579, "o", "\u001b[?2004hroot@c5a29d18c496:~# "]
[60.473996, "i", "python3 compare_records.py\n"]
[60.474244, "o", "python3 compare_records.py\r\n\u001b[?2004l\r"]
[95.646222, "i", "ls -l /root/diff_report.json\n"]
[95.646406, "o", "ls -l /root/diff_report.json\r\n"]
[95.791684, "i", "cat /root/diff_report.json\n"]
[95.791895, "o", "cat /root/diff_report.json\r\n"]
[118.048856, "o", "Comparison complete. Report generated.\r\n"]
[119.49643, "o", "\u001b[?2004hroot@c5a29d18c496:~# "]
