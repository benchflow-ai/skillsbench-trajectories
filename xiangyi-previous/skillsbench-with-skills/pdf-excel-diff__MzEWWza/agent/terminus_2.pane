[?2004hroot@c5a29d18c496:~# cat <<EOF > compare_records.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def clean_currency(val):
[?2004l[?2004h>     if isinstance(val, str):
[?2004l[?2004h>         return int(val.replace(',', ''))
[?2004l[?2004h>     return val
[?2004l[?2004h> 
[?2004l[?2004h> def clean_int(val):
[?2004l[?2004h>     return int(val)
[?2004l[?2004h> 
[?2004l[?2004h> def clean_float(val):
[?2004l[?2004h>     return float(val)
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Read Excel (Current Data)
[?2004l[?2004h> df_excel = pd.read_excel('/root/employees_current.xlsx')
[?2004l[?2004h> # Ensure ID is string
[?2004l[?2004h> df_excel['ID'] = df_excel['ID'].astype(str)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert Excel dataframe to a dict of dicts for easy lookup: {ID: {col: val, ...}}
[?2004l[?2004h> # We need to ensure types are native Python types for JSON serialization later
[?2004l[?2004h> excel_records = {}
[?2004l[?2004h> for _, row in df_excel.iterrows():
[?2004l[?2004h>     rec = row.to_dict()
[?2004l[?2004h>     # explicit type conversion for consistency
[?2004l[?2004h>     rec['Salary'] = int(rec['Salary'])
[?2004l[?2004h>     rec['Years'] = int(rec['Years'])
[?2004l[?2004h>     rec['Score'] = float(rec['Score'])
[?2004l[?2004h>     excel_records[rec['ID']] = rec
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Read PDF (Old Data)
[?2004l[?2004h> pdf_rows = []
[?2004l[?2004h> with pdfplumber.open('/root/employees_backup.pdf') as pdf:
[?2004l[?2004h>     for page in pdf.pages:
[?2004l[?2004h>         table = page.extract_table()
[?2004l[?2004h>         if table:
[?2004l[?2004h>             pdf_rows.extend(table)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract header and data
[?2004l[?2004h> header = pdf_rows[0]
[?2004l[?2004h> pdf_data = []
[?2004l[?2004h> for row in pdf_rows[1:]:
[?2004l[?2004h>     # Skip repeated headers if any
[?2004l[?2004h>     if row == header:
[?2004l[?2004h>         continue
[?2004l[?2004h>     # Map row to dictionary
[?2004l[?2004h>     record = dict(zip(header, row))
[?2004l[?2004h>     pdf_data.append(record)
[?2004l[?2004h> 
[?2004l[?2004h> # Clean PDF data and build dict
[?2004l[?2004h> pdf_records = {}
[?2004l[?2004h> for rec in pdf_data:
[?2004l[?2004h>     emp_id = rec['ID']
[?2004l[?2004h>     
[?2004l[?2004h>     # Type conversion to match Excel
[?2004l[?2004h>     try:
[?2004l[?2004h>         rec['Salary'] = clean_currency(rec['Salary'])
[?2004l[?2004h>         rec['Years'] = clean_int(rec['Years'])
[?2004l[?2004h>         rec['Score'] = clean_float(rec['Score'])
[?2004l[?2004h>     except ValueError as e:
[?2004l[?2004h>         print(f"Skipping malformed row for {emp_id}: {e}")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     pdf_records[emp_id] = rec
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Compare
[?2004l[?2004h> deleted_employees = []
[?2004l[?2004h> modified_employees = []
[?2004l[?2004h> 
[?2004l[?2004h> # Check for deleted (in PDF but not in Excel)
[?2004l[?2004h> for emp_id in pdf_records:
[?2004l[?2004h>     if emp_id not in excel_records:
[?2004l[?2004h>         deleted_employees.append(emp_id)
[?2004l[?2004h> 
[?2004l[?2004h> # Check for modifications (in both)
[?2004l[?2004h> columns_to_compare = ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']
[?2004l[?2004h> 
[?2004l[?2004h> for emp_id, old_rec in pdf_records.items():
[?2004l[?2004h>     if emp_id in excel_records:
[?2004l[?2004h>         new_rec = excel_records[emp_id]
[?2004l[?2004h>         for field in columns_to_compare:
[?2004l[?2004h>             old_val = old_rec[field]
[?2004l[?2004h>             new_val = new_rec[field]
[?2004l[?2004h>             
[?2004l[?2004h>             # Compare
[?2004l[?2004h>             if old_val != new_val:
[?2004l[?2004h>                 # Handle potential floating point epsilon issues if necessary, 
[?2004l[?2004h>                 # but simple equality usually works for simple decimals like 4.3 vs 4.3
[?2004l[?2004h>                 # If strict equality fails for floats, we might need math.isclose, 
[?2004l[?2004h>                 # but let's assume standard values.
[?2004l[?2004h>                 
[?2004l[?2004h>                 modified_employees.append({
[?2004l[?2004h>                     "id": emp_id,
[?2004l[?2004h>                     "field": field,
[?2004l[?2004h>                     "old_value": old_val,
[?2004l[?2004h>                     "new_value": new_val
[?2004l[?2004h>                 })
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Sort results
[?2004l[?2004h> deleted_employees.sort()
[?2004l[?2004h> modified_employees.sort(key=lambda x: x['id'])
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     "deleted_employees": deleted_employees,
[?2004l[?2004h>     "modified_employees": modified_employees
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Write JSON
[?2004l[?2004h> with open('/root/diff_report.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Comparison complete. Report generated.")
[?2004l[?2004h> EOF
