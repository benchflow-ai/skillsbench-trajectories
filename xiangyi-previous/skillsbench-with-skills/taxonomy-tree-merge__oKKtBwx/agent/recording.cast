[40.043903, "i", "cat << 'EOF' > /root/analyze_taxonomy.py\nimport pandas as pd\n\ndf = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\n\nprint(f\"Total unique paths: {len(df)}\")\n\n# Check Level 1\nl1_counts = df['unified_level_1'].nunique()\nprint(f\"Level 1 categories: {l1_counts}\")\n\n# Check subcategories per parent\nfor i in range(1, 5):\n    parent_cols = [f'unified_level_{j}' for j in range(1, i+1)]\n    child_col = f'unified_level_{i+1}'\n    counts = df.groupby(parent_cols)[child_col].nunique()\n    print(f\"Level {i+1} subcategories per parent: min={counts.min()}, max={counts.max()}, avg={counts.mean():.2f}\")\n    if counts.max() > 20 or counts.min() < 3:\n        print(f\"  Warning: Level {i+1} has parents with {counts.max()} children (max) or {counts.min()} children (min)\")\n\nEOF\npython3 /root/analyze_taxonomy.py\n"]
