[60.934782, "o", "\u001b[?2004h> "]
[60.934979, "o", "def group_children(children_list, level_idx):\r\n\u001b[?2004l\r"]
[60.935013, "o", "\u001b[?2004h> "]
[60.935314, "o", "    # children_list is a list of (original_parts, source, original_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.935353, "o", "> "]
[60.935569, "o", "    if not children_list:\r\n\u001b[?2004l\r\u001b[?2004h>         return {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.935605, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.935831, "o", "    # Extract the name at level_idx if available\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.935914, "o", ">     groups = {}\r\n"]
[60.935982, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[60.936147, "o", "    for parts, source, path in children_list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.936342, "o", "        name_parts = clean_name(parts[level_idx]) if level_idx < len(parts) else [\"general\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.936429, "o", "        name = \" \".join(name_parts)\r\n\u001b[?2004l\r"]
[60.936502, "o", "\u001b[?2004h> "]
[60.93658, "o", "        if name not in groups:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.936812, "o", "            groups[name] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.936899, "o", "> "]
[60.936973, "o", "        groups[name].append((parts, source, path))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.937046, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.937113, "o", "    if 3 <= len(groups) <= 20:\r\n\u001b[?2004l\r\u001b[?2004h>         return groups"]
[60.937176, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[60.93724, "o", "\u001b[?2004h> "]
[60.937484, "o", "    if len(groups) < 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.937583, "o", "        # Too few groups, try to split by the next level if available\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.937652, "o", "        new_groups = {}\r\n\u001b[?2004l\r"]
[60.937792, "o", "\u001b[?2004h"]
[60.937965, "o", "> "]
[60.938141, "o", "        for name, items in groups.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.938536, "o", ">             if level_idx + 1 < max(len(it[0]) for it in items):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.938658, "o", "                subgroups = group_children(items, level_idx + 1)\r\n\u001b[?2004l\r"]
[60.938769, "o", "\u001b[?2004h> "]
[60.942036, "o", "                for subname, subitems in subgroups.items():\r\n\u001b[?2004l\r\u001b[?2004h>                     combined_name = f\"{name} {subname}\"\r\n\u001b[?2004l\r\u001b[?2004h>                     new_groups[combined_name] = subitems\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 new_groups[name] = items\r\n\u001b[?2004l\r\u001b[?2004h>         if 3 <= len(new_groups) <= 20:\r\n\u001b[?2004l\r\u001b[?2004h>             return new_groups\r\n\u001b[?2004l\r\u001b[?2004h>         groups = new_groups # Keep whatever we got\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if len(groups) > 20:\r\n\u001b[?2004l\r\u001b[?2004h>         # Too many groups, cluster them by common words\r\n\u001b[?2004l\r\u001b[?2004h>         sorted_groups = sorted(groups.items(), key=lambda x: len(x[1]), reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h>         top_groups = sorted_groups[:19]\r\n\u001b[?2004l\r\u001b[?2004h>         others = []\r\n\u001b[?2004l\r\u001b[?2004h>         for _, items in sorted_groups[19:]:\r\n\u001b[?2004l\r\u001b[?2004h>             others.extend(items)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         final_groups = {name: items for name, items in top_groups}\r\n\u001b[?2004l\r\u001b[?2004h>         if others:\r\n\u001b[?2004l\r\u001b[?2004h>             final_groups['other | miscellaneous'] = others\r\n\u001b[?2004l\r\u001b[?2004h>         return final_groups\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return groups\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Recursive building of the taxonomy\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> l1_groups = {}\r\n\u001b[?2004l\r\u001b[?2004h> for item in all_paths:\r\n\u001b[?2004l\r\u001b[?2004h>     l1 = item['l1']\r\n\u001b[?2004l\r\u001b[?2004h>     if l1 not in l1_groups:\r\n\u001b[?2004l\r\u001b[?2004h>         l1_groups[l1] = []\r\n\u001b[?2004l\r\u001b[?2004h>     l1_groups[l1].append((item['parts'], item['source'], item['path']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for l1_name, l1_items in l1_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.942174, "o", "    l2_groups = group_children(l1_items, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.942256, "o", "    for l2_name, l2_items in l2_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.942323, "o", "> "]
[60.942393, "o", "        l3_groups = group_children(l2_items, 2)\r\n\u001b[?2004l\r"]
[60.942463, "o", "\u001b[?2004h> "]
[60.942576, "o", "        for l3_name, l3_items in l3_groups.items():\r\n\u001b[?2004l\r"]
[60.942648, "o", "\u001b[?2004h> "]
[60.942746, "o", "            l4_groups = group_children(l3_items, 3)\r\n\u001b[?2004l\r"]
[60.942815, "o", "\u001b[?2004h> "]
[60.942926, "o", "            for l4_name, l4_items in l4_groups.items():\r\n\u001b[?2004l\r"]
[60.942997, "o", "\u001b[?2004h> "]
[60.943098, "o", "                l5_groups = group_children(l4_items, 4)\r\n\u001b[?2004l\r"]
[60.943171, "o", "\u001b[?2004h> "]
[60.943285, "o", "                for l5_name, l5_items in l5_groups.items():\r\n\u001b[?2004l\r"]
[60.943359, "o", "\u001b[?2004h> "]
[60.943467, "o", "                    for parts, source, path in l5_items:\r\n\u001b[?2004l\r"]
[60.943542, "o", "\u001b[?2004h> "]
[60.943627, "o", "                        results.append({\r\n\u001b[?2004l\r"]
[60.943698, "o", "\u001b[?2004h> "]
[60.943786, "o", "                            'source': source,\r\n\u001b[?2004l\r"]
[60.943854, "o", "\u001b[?2004h> "]
[60.943952, "o", "                            'category_path': path,\r\n\u001b[?2004l\r"]
[60.944026, "o", "\u001b[?2004h> "]
[60.944137, "o", "                            'depth': min(len(parts), 5),\r\n\u001b[?2004l\r"]
[60.944212, "o", "\u001b[?2004h> "]
[60.944311, "o", "                            'unified_level_1': l1_name,\r\n\u001b[?2004l\r"]
[60.944384, "o", "\u001b[?2004h> "]
[60.944544, "o", "                            'unified_level_2': format_name(clean_name(l2_name)),\r\n\u001b[?2004l\r"]
[60.944614, "o", "\u001b[?2004h> "]
[60.944769, "o", "                            'unified_level_3': format_name(clean_name(l3_name)),\r\n\u001b[?2004l\r"]
[60.944839, "o", "\u001b[?2004h> "]
[60.944991, "o", "                            'unified_level_4': format_name(clean_name(l4_name)),\r\n\u001b[?2004l\r"]
[60.945059, "o", "\u001b[?2004h> "]
[60.945211, "o", "                            'unified_level_5': format_name(clean_name(l5_name))\r\n\u001b[?2004l\r"]
[60.945288, "o", "\u001b[?2004h> "]
[60.945354, "o", "                        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.94542, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.945498, "o", "# Final cleaning and overlap check\r\n\u001b[?2004l\r"]
[60.945566, "o", "\u001b[?2004h> "]
[60.945636, "o", "def fix_overlap(row):\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.945699, "o", "> "]
[60.945799, "o", "    levels = [row[f'unified_level_{i}'] for i in range(1, 6)]\r\n\u001b[?2004l\r"]
[60.945865, "o", "\u001b[?2004h> "]
[60.945961, "o", "    new_levels = [levels[0]]\r\n\u001b[?2004l\r"]
[60.946047, "o", "\u001b[?2004h>     for i in range(1, 5):\r\n"]
[60.946118, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[60.946347, "o", "        curr = set(levels[i].split(\" | \"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946406, "o", "        prev = set(new_levels[i-1].split(\" | \"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946534, "o", "        if not curr.difference(prev):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946613, "o", "            # Full overlap, add a suffix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946698, "o", "            new_levels.append(levels[i] + \" | sub\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946762, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.946827, "o", "            # Remove overlapping words\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.9469, "o", "> "]
[60.947004, "o", "            diff = [w for w in levels[i].split(\" | \") if w not in prev]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947056, "o", "            if not diff:\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.947114, "o", "> "]
[60.947192, "o", "                 new_levels.append(levels[i] + \" | sub\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.947277, "o", "> "]
[60.947357, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947436, "o", "                 new_levels.append(\" | \".join(diff[:5]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947497, "o", "    return new_levels\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947565, "o", "final_rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947625, "o", "for r in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.94769, "o", "    fixed = fix_overlap(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947753, "o", "    for i in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.947852, "o", "        r[f'unified_level_{i+1}'] = fixed[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.94792, "o", "> "]
[60.947985, "o", "    final_rows.append(r)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.948052, "o", "df_final = pd.DataFrame(final_rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.948195, "o", "df_final.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.948271, "o", "> "]
[60.948565, "o", "df_hierarchy = df_final[['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']].drop_duplicates()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.94866, "o", "df_hierarchy.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
