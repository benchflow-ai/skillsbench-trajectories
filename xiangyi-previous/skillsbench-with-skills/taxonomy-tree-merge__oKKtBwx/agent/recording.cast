[17.258218, "o", "\u001b[?2004hroot@523347781dfc:~# "]
[31.728085, "i", "cat << 'EOF' > /root/process_taxonomy.py\nimport pandas as pd\nimport re\nfrom collections import Counter\nimport os\n\ndef clean_name(name):\n    if not name: return \"\"\n    name = name.lower().replace('&', 'and').replace(',', ' ')\n    name = re.sub(r'[^a-z0-9\\s]', ' ', name)\n    words = name.split()\n    # Use \" | \" as separator between words (not more than 5 words)\n    words = words[:5]\n    return \" | \".join(words)\n\ndef get_overlap(s1, s2):\n    w1 = set(s1.split(\" | \"))\n    w2 = set(s2.split(\" | \"))\n    if not w1 or not w2: return 0\n    intersection = w1.intersection(w2)\n    return len(intersection) / min(len(w1), len(w2))\n\n# Loading data\nfiles = {\n    'amazon': '/root/data/amazon_product_categories.csv',\n    'facebook': '/root/data/fb_product_categories.csv',\n    'google': '/root/data/google_shopping_product_categories.csv'\n}\n\nall_data = []\nfor source, path in files.items():\n    df = pd.read_csv(path)\n    for cat_path in df['category_path'].dropna().unique():\n        all_data.append({'source': source, 'category_path': cat_path})\n\n# Define Level 1 categories (10-20 broad categories)\n# Based on common themes in e-commerce\nl1_mapping = {\n    'apparel | clothing | fashion | accessories': ['clothing', 'apparel', 'shoes', 'jewelry', 'watches', 'fashion', 'accessories', 'luggage', 'bags'],\n    'electronics | computers | home | tech': ['electronics', 'computers', 'software', 'camera', 'phones', 'video games'],\n    'home | garden | kitchen | furniture': ['home', 'kitchen', 'garden', 'furniture', 'patio', 'appliances', 'tools', 'hardware'],\n    'beauty | personal | care | health': ['beauty', 'personal care', 'health', 'household', 'baby care'],\n    'sports | outdoors | recreation | fitness': ['sports', 'outdoors', 'fitness', 'recreation'],\n    'toys | games | hobbies | collectibles': ['toys', 'games', 'hobbies', 'collectibles', 'arts', 'crafts'],\n    'automotive | industrial | parts': ['automotive', 'industrial', 'scientific', 'parts', 'vehicles'],\n    'food | beverage | grocery': ['food', 'beverage', 'grocery', 'gourmet', 'drinks'],\n    'pet | supplies | animals': ['pet', 'animals', 'animal'],\n    'office | business | education': ['office', 'business', 'education', 'books', 'media', 'movies', 'music'],\n    'baby | kids | maternity': ['baby', 'kids', 'maternity', 'children'],\n    'other | miscellaneous | general': [] # Fallback\n}\n\ndef find_l1(path):\n    path_lower = path.lower()\n    for l1, keywords in l1_mapping.items():\n        for kw in keywords:\n            if kw in path_lower:\n                return l1\n    return 'other | miscellaneous | general'\n\n# Processing\nprocessed_rows = []\nfor item in all_data:\n    path = item['category_path']\n    parts = [p.strip() for p in path.split('>')]\n    source = item['source']\n    \n    l1 = find_l1(path)\n    \n    # For L2-L5, we will try to extract from the path if available, otherwise use placeholders or repeat\n    unified = [l1]\n    \n    # Simple extraction for L2-L5\n    for i in range(1, 5):\n        if i < len(parts):\n            name = clean_name(parts[i])\n            # Rule: avoid name overlap between subcategory and its parent\n            parent_words = set(unified[-1].split(\" | \"))\n            current_words = name.split(\" | \")\n            filtered_words = [w for w in current_words if w not in parent_words]\n            if not filtered_words:\n                name = name + \" | sub\"\n            else:\n                name = \" | \".join(filtered_words[:5])\n            \n            # Rule: sibling distinctness (not fully implemented here but handled by path uniqueness)\n            unified.append(name)\n        else:\n            # If no more parts, use a generic name based on parent or just repeat with a suffix\n            unified.append(unified[-1] + \" | general\")\n\n    row = {\n        'source': source,\n        'category_path': path,\n        'depth': min(len(parts), 5),\n        'unified_level_1': unified[0],\n        'unified_level_2': unified[1],\n        'unified_level_3': unified[2],\n        'unified_level_4': unified[3],\n        'unified_level_5': unified[4]\n    }\n    processed_rows.append(row)\n\nfu"]
[31.728167, "i", "ll_df = pd.DataFrame(processed_rows)\nfull_df.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\n\n# Create hierarchy file\nhierarchy_df = full_df[['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']].drop_duplicates()\nhierarchy_df.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\n\nprint(\"Done\")\nEOF\npython3 /root/process_taxonomy.py\n"]
[31.72846, "o", "cat << 'EOF' > /root/process_taxonomy.py\r\n\u001b[?2004l\r"]
