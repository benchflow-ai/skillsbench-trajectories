[82.412012, "o", "                for j in range(3 - len(groups)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.412158, "o", "                    new_name = f\"{name} | {chr(65+j)}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.412323, "o", "                    start = j * len(items_to_split) // (3 - len(groups) + 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.412481, "o", "                    end = (j+1) * len(items_to_split) // (3 - len(groups) + 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.412635, "o", "                    groups[new_name] = items_to_split[start:end]\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.412783, "o", ">                 # Add remaining\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.412936, "o", "                remaining_name = f\"{name} | {chr(65+3-len(groups))}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.413224, "o", "                groups[remaining_name] = items_to_split[(3-len(groups)) * len(items_to_split) // (3-len(groups)+1):]\r\n\u001b[?2004l\r"]
[82.413494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return groups\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r"]
[82.413696, "o", "\u001b[?2004h> l1_groups = {}\r\n\u001b[?2004l\r\u001b[?2004h> for item in all_paths:\r\n\u001b[?2004l\r\u001b[?2004h>     l1 = item['l1']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.413847, "o", "    if l1 not in l1_groups:\r\n\u001b[?2004l\r\u001b[?2004h>         l1_groups[l1] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.414038, "o", "    l1_groups[l1].append((item['parts'], item['source'], item['path']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.414409, "o", "for l1_name, l1_items in l1_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.41476, "o", "    l2_groups = group_items(l1_items, 1)\r\n\u001b[?2004l\r\u001b[?2004h>     for l2_name, l2_items in l2_groups.items():\r\n\u001b[?2004l\r"]
[82.41493, "o", "\u001b[?2004h> "]
[82.415152, "o", "        l3_groups = group_items(l2_items, 2)\r\n\u001b[?2004l\r"]
[82.415342, "o", "\u001b[?2004h> "]
[82.415524, "o", "        for l3_name, l3_items in l3_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h>             l4_groups = group_items(l3_items, 3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.415576, "o", "            for l4_name, l4_items in l4_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.415787, "o", "                l5_groups = group_items(l4_items, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.415932, "o", "                for l5_name, l5_items in l5_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.415968, "o", "> "]
[82.416512, "o", "                    for parts, source, path in l5_items:\r\n\u001b[?2004l\r\u001b[?2004h>                         results.append({\r\n\u001b[?2004l\r\u001b[?2004h>                             'source': source,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.416676, "o", "                            'category_path': path,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.416844, "o", "                            'l1': l1_name, 'l2': l2_name, 'l3': l3_name, 'l4': l4_name, 'l5': l5_name\r\n\u001b[?2004l\r"]
[82.416878, "o", "\u001b[?2004h> "]
[82.416986, "o", "                        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.417115, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.417209, "o", "def finalize_name(curr, prev_name):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.41727, "o", "    curr_words = curr.split(\" | \")\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.417301, "o", "> "]
[82.417411, "o", "    prev_words = set(prev_name.split(\" | \"))\r\n\u001b[?2004l\r"]
[82.417444, "o", "\u001b[?2004h> "]
[82.41761, "o", "    diff = [w for w in curr_words if w not in prev_words]\r\n\u001b[?2004l\r"]
[82.417641, "o", "\u001b[?2004h> "]
[82.417742, "o", "    if not diff:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.417911, "o", "        return curr_words[0] + \" | sub\" if curr_words else \"sub\"\r\n\u001b[?2004l\r"]
[82.418081, "o", "\u001b[?2004h>     return \" | \".join(diff[:5])\r\n\u001b[?2004l\r"]
[82.418173, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.418269, "o", "final_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.418365, "o", "for r in results:\r\n\u001b[?2004l\r\u001b[?2004h>     u1 = r['l1']"]
[82.418455, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.418542, "o", "    u2 = finalize_name(r['l2'], u1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.418682, "o", "    u3 = finalize_name(r['l3'], u1 + \" | \" + u2)\r\n\u001b[?2004l\r"]
[82.418779, "o", "\u001b[?2004h> "]
[82.418889, "o", "    u4 = finalize_name(r['l4'], u1 + \" | \" + u2 + \" | \" + u3)\r\n\u001b[?2004l\r"]
[82.418984, "o", "\u001b[?2004h> "]
[82.419126, "o", "    u5 = finalize_name(r['l5'], u1 + \" | \" + u2 + \" | \" + u3 + \" | \" + u4)\r\n"]
[82.419242, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[82.419336, "o", "\u001b[?2004h>     final_data.append({\r\n\u001b[?2004l\r"]
[82.419423, "o", "\u001b[?2004h> "]
[82.419511, "o", "        'source': r['source'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.419631, "o", "        'category_path': r['category_path'],\r\n\u001b[?2004l\r"]
[82.419717, "o", "\u001b[?2004h> "]
[82.419831, "o", "        'depth': min(len(r['category_path'].split('>')), 5),\r\n\u001b[?2004l\r"]
[82.419918, "o", "\u001b[?2004h> "]
[82.420003, "o", "        'unified_level_1': u1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.420087, "o", "        'unified_level_2': u2,\r\n\u001b[?2004l\r"]
[82.42017, "o", "\u001b[?2004h> "]
[82.420303, "o", "        'unified_level_3': u3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.4204, "o", "        'unified_level_4': u4,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.420482, "o", "        'unified_level_5': u5\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[82.420623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.420778, "o", "pd.DataFrame(final_data).to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r"]
[82.42087, "o", "\u001b[?2004h> "]
[82.42133, "o", "pd.DataFrame(final_data)[['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']].drop_duplicates().to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\r\n\u001b[?2004l\r"]
