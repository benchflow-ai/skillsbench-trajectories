[16.715093, "i", "cat << 'EOF' > /root/process_taxonomy.py\nimport pandas as pd\nimport re\nfrom collections import Counter\n\ndef normalize(text):\n    if not isinstance(text, str): return \"\"\n    text = text.lower()\n    text = re.sub(r'[^a-z0-9&/\\s>]', '', text)\n    return text.strip()\n\ndef get_paths(file_path, col='category_path'):\n    df = pd.read_csv(file_path)\n    return df[col].dropna().unique().tolist()\n\namazon_paths = get_paths('/root/data/amazon_product_categories.csv')\nfb_paths = get_paths('/root/data/fb_product_categories.csv')\ngoogle_paths = get_paths('/root/data/google_shopping_product_categories.csv')\n\nprint(f\"Amazon: {len(amazon_paths)}\")\nprint(f\"FB: {len(fb_paths)}\")\nprint(f\"Google: {len(google_paths)}\")\nEOF\npython3 /root/process_taxonomy.py\n"]
[16.71533, "o", "cat << 'EOF' > /root/process_taxonomy.py\r\n\u001b[?2004l\r"]
