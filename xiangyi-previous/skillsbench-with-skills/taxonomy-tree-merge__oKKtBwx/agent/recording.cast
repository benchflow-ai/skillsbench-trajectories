[82.375444, "i", "cat << 'EOF' > /root/process_taxonomy.py\nimport pandas as pd\nimport re\nfrom collections import Counter\nimport numpy as np\n\ndef clean_name(name):\n    if not name: return [\"general\"]\n    name = name.lower().replace('&', 'and').replace(',', ' ')\n    name = re.sub(r'[^a-z0-9\\s]', ' ', name)\n    words = name.split()\n    return words[:5]\n\ndef format_name(words):\n    if not words: return \"general\"\n    return \" | \".join(words)\n\n# Loading data\nfiles = {\n    'amazon': '/root/data/amazon_product_categories.csv',\n    'facebook': '/root/data/fb_product_categories.csv',\n    'google': '/root/data/google_shopping_product_categories.csv'\n}\n\nall_paths = []\nfor source, path in files.items():\n    df = pd.read_csv(path)\n    for cat_path in df['category_path'].dropna().unique():\n        all_paths.append({'source': source, 'path': cat_path, 'parts': [p.strip() for p in cat_path.split('>') if p.strip()]})\n\nl1_mapping = {\n    'apparel | accessories | fashion': ['clothing', 'apparel', 'shoes', 'jewelry', 'watches', 'fashion', 'accessories', 'luggage', 'bags', 'eyewear'],\n    'electronics | computers | tech': ['electronics', 'computers', 'software', 'camera', 'phones', 'video games', 'audio', 'mobile'],\n    'home | garden | kitchen': ['home', 'kitchen', 'garden', 'furniture', 'patio', 'appliances', 'decor', 'bedding', 'bath'],\n    'beauty | personal | care': ['beauty', 'personal care', 'fragrance', 'makeup', 'hair care', 'skin care'],\n    'health | wellness | medical': ['health', 'wellness', 'medical', 'vitamins', 'supplements', 'first aid'],\n    'sports | outdoors | fitness': ['sports', 'outdoors', 'fitness', 'recreation', 'exercise', 'cycling', 'camping'],\n    'toys | games | hobbies': ['toys', 'games', 'hobbies', 'collectibles', 'puzzles', 'dolls'],\n    'arts | crafts | diy': ['arts', 'crafts', 'diy', 'sewing', 'painting', 'scrapbooking'],\n    'automotive | vehicles | parts': ['automotive', 'vehicles', 'parts', 'tires', 'car care'],\n    'food | beverage | grocery': ['food', 'beverage', 'grocery', 'gourmet', 'drinks', 'cooking'],\n    'pet | supplies | animals': ['pet', 'animals', 'animal', 'dog', 'cat', 'bird', 'fish'],\n    'office | business | industrial': ['office', 'business', 'industrial', 'scientific', 'supplies', 'stationery'],\n    'media | books | entertainment': ['books', 'movies', 'music', 'media', 'instruments', 'dvds'],\n    'baby | kids | maternity': ['baby', 'kids', 'maternity', 'children', 'toddler', 'nursery'],\n    'tools | hardware | building': ['tools', 'hardware', 'building', 'electrical', 'plumbing', 'construction']\n}\n\ndef assign_l1(parts):\n    full_path = \" \".join(parts).lower()\n    for l1, keywords in l1_mapping.items():\n        if any(kw in full_path for kw in keywords):\n            return l1\n    return 'general | miscellaneous | other'\n\nfor item in all_paths:\n    item['l1'] = assign_l1(item['parts'])\n\ndef group_items(items, level_idx):\n    if not items:\n        return {}\n    \n    groups = {}\n    for it in items:\n        parts, source, path = it\n        name = format_name(clean_name(parts[level_idx])) if level_idx < len(parts) else \"general\"\n        if name not in groups:\n            groups[name] = []\n        groups[name].append(it)\n    \n    # If > 20, cluster\n    if len(groups) > 20:\n        sorted_groups = sorted(groups.items(), key=lambda x: len(x[1]), reverse=True)\n        new_groups = dict(sorted_groups[:19])\n        other_items = []\n        for _, itms in sorted_groups[19:]:\n            other_items.extend(itms)\n        new_groups['other | variety'] = other_items\n        groups = new_groups\n\n    # If < 3 and we have enough items to potentially split or if we can merge\n    # But wait, if we only have 1 or 2 unique names at this level, we must provide at least 3.\n    # This is hard if there's no more data. We'll add \" | collection A\", \" | collection B\" etc.\n    if len(groups) < 3:\n        names = list(groups.keys())\n        for i, name in enumerate(names):\n            if len(groups) < 3 and len(groups[name]) >= 3:\n                # Split this group into 2 or 3\n                items_to_split = groups.pop(name)\n           "]
[82.375529, "i", "     for j in range(3 - len(groups)):\n                    new_name = f\"{name} | {chr(65+j)}\"\n                    start = j * len(items_to_split) // (3 - len(groups) + 1)\n                    end = (j+1) * len(items_to_split) // (3 - len(groups) + 1)\n                    groups[new_name] = items_to_split[start:end]\n                # Add remaining\n                remaining_name = f\"{name} | {chr(65+3-len(groups))}\"\n                groups[remaining_name] = items_to_split[(3-len(groups)) * len(items_to_split) // (3-len(groups)+1):]\n\n    return groups\n\nresults = []\nl1_groups = {}\nfor item in all_paths:\n    l1 = item['l1']\n    if l1 not in l1_groups:\n        l1_groups[l1] = []\n    l1_groups[l1].append((item['parts'], item['source'], item['path']))\n\nfor l1_name, l1_items in l1_groups.items():\n    l2_groups = group_items(l1_items, 1)\n    for l2_name, l2_items in l2_groups.items():\n        l3_groups = group_items(l2_items, 2)\n        for l3_name, l3_items in l3_groups.items():\n            l4_groups = group_items(l3_items, 3)\n            for l4_name, l4_items in l4_groups.items():\n                l5_groups = group_items(l4_items, 4)\n                for l5_name, l5_items in l5_groups.items():\n                    for parts, source, path in l5_items:\n                        results.append({\n                            'source': source,\n                            'category_path': path,\n                            'l1': l1_name, 'l2': l2_name, 'l3': l3_name, 'l4': l4_name, 'l5': l5_name\n                        })\n\ndef finalize_name(curr, prev_name):\n    curr_words = curr.split(\" | \")\n    prev_words = set(prev_name.split(\" | \"))\n    diff = [w for w in curr_words if w not in prev_words]\n    if not diff:\n        return curr_words[0] + \" | sub\" if curr_words else \"sub\"\n    return \" | \".join(diff[:5])\n\nfinal_data = []\nfor r in results:\n    u1 = r['l1']\n    u2 = finalize_name(r['l2'], u1)\n    u3 = finalize_name(r['l3'], u1 + \" | \" + u2)\n    u4 = finalize_name(r['l4'], u1 + \" | \" + u2 + \" | \" + u3)\n    u5 = finalize_name(r['l5'], u1 + \" | \" + u2 + \" | \" + u3 + \" | \" + u4)\n    \n    final_data.append({\n        'source': r['source'],\n        'category_path': r['category_path'],\n        'depth': min(len(r['category_path'].split('>')), 5),\n        'unified_level_1': u1,\n        'unified_level_2': u2,\n        'unified_level_3': u3,\n        'unified_level_4': u4,\n        'unified_level_5': u5\n    })\n\npd.DataFrame(final_data).to_csv('/root/output/unified_taxonomy_full.csv', index=False)\npd.DataFrame(final_data)[['unified_level_1', 'unified_level_2', 'unified_level_3', 'unified_level_4', 'unified_level_5']].drop_duplicates().to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\nEOF\npython3 /root/process_taxonomy.py\npython3 /root/analyze_taxonomy.py\n"]
