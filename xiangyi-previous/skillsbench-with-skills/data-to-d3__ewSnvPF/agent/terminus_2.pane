[?2004l[?2004h> // Stock Visualization Dashboard
[?2004l[?2004h> 
[?2004ls[?2004h> // Dimensions
[?2004l [?2004h> const width = 600;
[?2004l  [?2004h> const height = 550;
[?2004l[?2004h> const margin = { top: 20, right: 20, bottom: 20, left: 20 };
[?2004l[?2004h> 
[?2004l[?2004h> // Format market cap for display
[?2004l[?2004h> function formatMarketCap(value) {
[?2004lec[?2004h>     if (!value || isNaN(value)) return 'N/A';
[?2004l[?2004h>     const num = parseFloat(value);
[?2004l[?2004h>     if (num >= 1e12) return (num / 1e12).toFixed(2) + 'T';
[?2004l[?2004h>     if (num >= 1e9) return (num / 1e9).toFixed(2) + 'B';
[?2004l[?2004h>     if (num >= 1e6) return (num / 1e6).toFixed(2) + 'M';
[?2004ll[?2004h>     return num.toFixed(2);
[?2004l [?2004h> }
[?2004l  [?2004h> 
[?2004l [?2004h> // Color scale for sectors
[?2004l[?2004h> const sectorColors = d3.scaleOrdinal(d3.schemeTableau10);
[?2004l[?2004h> 
[?2004l[?2004h> // Global state
[?2004l[?2004h> let selectedTicker = null;
[?2004l[?2004h> let stockData = [];
[?2004l[?2004h> 
[?2004l[?2004h> // Load and process data
[?2004l[?2004h> d3.csv('data/stock-descriptions.csv').then(data => {
[?2004l[?2004h>     // Process the data
[?2004l[?2004h>     stockData = data.map(d => ({
[?2004l[?2004h>         ticker: d.ticker,
[?2004l[?2004h>         sector: d.sector || 'ETF',
[?2004l[?2004h>         name: d['full name'],
[?2004l[?2004h>         marketCap: parseFloat(d.marketCap) || 0,
[?2004l[?2004h>         country: d.country,
[?2004l[?2004h>         website: d.website,
[?2004l[?2004h>         isETF: d.sector === 'ETF' || !d.sector || d.sector === ''
[?2004l[?2004h>     }));
[?2004l [?2004h> 
[?2004l=[?2004h>     // Get unique sectors for coloring
[?2004l[?2004h>     const sectors = [...new Set(stockData.map(d => d.sector))].sort();
[?2004l[?2004h>     sectorColors.domain(sectors);
[?2004l[?2004h> 
[?2004l.[?2004h>     // Create visualizations
[?2004l[?2004h>     createBubbleChart(stockData, sectors);
[?2004l[?2004h>     createDataTable(stockData);
[?2004l[?2004h>     createLegend(sectors);
[?2004l[?2004h> });
[?2004l[?2004h> 
[?2004l[?2004h> function createBubbleChart(data, sectors) {
[?2004l[?2004h>     const svg = d3.select('#bubble-chart')
[?2004l[?2004h>         .append('svg')
[?2004l[?2004h>         .attr('width', width)
[?2004l[?2004h>         .attr('height', height);
[?2004l[?2004h> 
[?2004l([?2004h>     const chartArea = svg.append('g')
[?2004l[?2004h>         .attr('transform', `translate(${margin.left}, ${margin.top})`);
[?2004l[?2004h> 
[?2004lh[?2004h>     const innerWidth = width - margin.left - margin.right;
[?2004l[?2004h>     const innerHeight = height - margin.top - margin.bottom;
[?2004l[?2004h> 
[?2004lt[?2004h>     // Scale for bubble size based on market cap
[?2004l[?2004h>     const maxMarketCap = d3.max(data, d => d.marketCap) || 1;
[?2004l[?2004h>     const radiusScale = d3.scaleSqrt()
[?2004l[?2004h>         .domain([0, maxMarketCap])
[?2004l[?2004h>         .range([8, 45]);
[?2004l[?2004h> 
[?2004l [?2004h>     // Calculate sector centers for clustering
[?2004l[?2004h>     const sectorCenters = {};
[?2004l[?2004h>     const numSectors = sectors.length;
[?2004l[?2004h>     const cols = Math.ceil(Math.sqrt(numSectors));
[?2004l[?2004h>     const rows = Math.ceil(numSectors / cols);
[?2004l[?2004h>     const cellWidth = innerWidth / cols;
[?2004l[?2004h>     const cellHeight = innerHeight / rows;
[?2004l[?2004h> 
[?2004ln[?2004h>     sectors.forEach((sector, i) => {
[?2004l[?2004h>         const col = i % cols;
[?2004l[?2004h>         const row = Math.floor(i / cols);
[?2004l[?2004h>         sectorCenters[sector] = {
[?2004l[?2004h>             x: cellWidth * (col + 0.5),
[?2004l[?2004h>             y: cellHeight * (row + 0.5)
[?2004l[?2004h>         };
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l
[?2004h>     // Create nodes with initial positions
[?2004l[?2004h>     const nodes = data.map(d => ({
[?2004l[?2004h>         ...d,
[?2004l[?2004h>         radius: d.isETF ? 12 : radiusScale(d.marketCap),
[?2004l[?2004h>         x: sectorCenters[d.sector]?.x + (Math.random() - 0.5) * 50 || innerWidth / 2,
[?2004l[?2004h>         y: sectorCenters[d.sector]?.y + (Math.random() - 0.5) * 50 || innerHeight / 2
[?2004l[?2004h>     }));
[?2004l[?2004h> 
[?2004lc[?2004h>     // Create force simulation
[?2004l[?2004h>     const simulation = d3.forceSimulation(nodes)
[?2004l[?2004h>         .force('x', d3.forceX(d => sectorCenters[d.sector]?.x || innerWidth / 2).strength(0.3))
[?2004l[?2004h>         .force('y', d3.forceY(d => sectorCenters[d.sector]?.y || innerHeight / 2).strength(0.3))
[?2004l[?2004h>         .force('collide', d3.forceCollide(d => d.radius + 2).strength(1))
[?2004l[?2004h>         .force('center', d3.forceCenter(innerWidth / 2, innerHeight / 2).strength(0.05));
[?2004l[?2004h> 
[?2004li[?2004h>     // Create bubble groups
[?2004l[?2004h>     const bubbleGroups = chartArea.selectAll('.bubble-group')
[?2004l[?2004h>         .data(nodes)
[?2004l[?2004h>         .enter()
[?2004l[?2004h>         .append('g')
[?2004l[?2004h>         .attr('class', 'bubble-group');
[?2004l[?2004h> 
[?2004l[?2004h>     // Create bubbles
[?2004l[?2004h>     const bubbles = bubbleGroups.append('circle')
[?2004l[?2004h>         .attr('class', 'bubble')
[?2004l[?2004h>         .attr('r', d => d.radius)
[?2004l[?2004h>         .attr('fill', d => sectorColors(d.sector))
[?2004l[?2004h>         .attr('stroke', '#fff')
[?2004l[?2004h>         .attr('stroke-width', 1.5)
[?2004l[?2004h>         .attr('data-ticker', d => d.ticker);
[?2004l[?2004h> 
[?2004l[?2004h>     // Add labels
[?2004l[?2004h>     const labels = bubbleGroups.append('text')
[?2004l[?2004h>         .attr('class', 'bubble-label')
[?2004l[?2004h>         .text(d => d.ticker)
[?2004l[?2004h>         .style('font-size', d => Math.min(d.radius * 0.6, 12) + 'px');
[?2004l[?2004h> 
[?2004l[?2004h>     // Tooltip
[?2004l[?2004h>     const tooltip = d3.select('#tooltip');
[?2004l[?2004h> 
[?2004l[?2004h>     // Bubble interactions
[?2004l[?2004h>     bubbles
[?2004l[?2004h>         .on('mouseover', function(event, d) {
[?2004l[?2004h>             if (!d.isETF) {
[?2004l[?2004h>                 tooltip
[?2004l[?2004h>                     .html(`<strong>${d.ticker}</strong>
[?2004l[?2004h>                            <div>${d.name}</div>
[?2004l[?2004h>                            <div>Sector: ${d.sector}</div>
[?2004l[?2004h>                            <div>Market Cap: ${formatMarketCap(d.marketCap)}</div>`)
[?2004l[?2004h>                     .style('left', (event.pageX + 15) + 'px')
[?2004l[?2004h>                     .style('top', (event.pageY - 10) + 'px')
[?2004l[?2004h>                     .classed('visible', true);
[?2004l[?2004h>             }
[?2004l[?2004h>         })
[?2004l[?2004h>         .on('mousemove', function(event, d) {
[?2004l[?2004h>             if (!d.isETF) {
[?2004l[?2004h>                 tooltip
[?2004l[?2004h>                     .style('left', (event.pageX + 15) + 'px')
[?2004l[?2004h>                     .style('top', (event.pageY - 10) + 'px');
[?2004l[?2004h>             }
[?2004l[?2004h>         })
[?2004l[?2004h>         .on('mouseout', function() {
[?2004l[?2004h>             tooltip.classed('visible', false);
[?2004l[?2004h>         })
[?2004l[?2004h>         .on('click', function(event, d) {
[?2004l[?2004h>             selectStock(d.ticker);
[?2004l[?2004h>         });
[?2004l[?2004h> 
[?2004l[?2004h>     // Update positions on simulation tick
[?2004l[?2004h>     simulation.on('tick', () => {
[?2004l[?2004h>         bubbleGroups.attr('transform', d => {
[?2004l[?2004h>             // Keep bubbles within bounds
[?2004l[?2004h>             d.x = Math.max(d.radius, Math.min(innerWidth - d.radius, d.x));
[?2004l[?2004h>             d.y = Math.max(d.radius, Math.min(innerHeight - d.radius, d.y));
[?2004l[?2004h>             return `translate(${d.x}, ${d.y})`;
[?2004l[?2004h>         });
