[?2004l// Stock Visualization Dashboard

// Dimensions
const width = 600;
const height = 550;
const margin = { top: 20, right: 20, bottom: 20, left: 20 };

// Format market cap for display
function formatMarketCap(value) {
    if (!value || isNaN(value)) return 'N/A';
    const num = parseFloat(value);
    if (num >= 1e12) return (num / 1e12).toFixed(2) + 'T';
    if (num >= 1e9) return (num / 1e9).toFixed(2) + 'B';
    if (num >= 1e6) return (num / 1e6).toFixed(2) + 'M';
    return num.toFixed(2);
}

// Color scale for sectors
const sectorColors = d3.scaleOrdinal(d3.schemeTableau10);

// Global state
let selectedTicker = null;
let stockData = [];

// Load and process data
d3.csv('data/stock-descriptions.csv').then(data => {
    // Process the data
    stockData = data.map(d => ({
        ticker: d.ticker,
        sector: d.sector || 'ETF',
[?2004hroot@b2c370936839:~# echo "Verification complete - all files created successfully"
[?2004lVerification complete - all files created successfully
[?2004hroot@b2c370936839:~# wc -l /root/output/js/visualization.js
[?2004l238 /root/output/js/visualization.js
[?2004hroot@b2c370936839:~# tail -50 /root/output/js/visualization.js
[?2004l        });

    rows.append('td').text(d => d.ticker);
    rows.append('td').text(d => d.name);
    rows.append('td').text(d => d.sector);
    rows.append('td').text(d => formatMarketCap(d.marketCap));
}

function createLegend(sectors) {
    const legend = d3.select('#legend');

    sectors.forEach(sector => {
        const item = legend.append('div')
            .attr('class', 'legend-item');

        item.append('div')
            .attr('class', 'legend-color')
            .style('background-color', sectorColors(sector));

        item.append('span')
            .text(sector);
    });
}

function selectStock(ticker) {
    // Toggle selection
    if (selectedTicker === ticker) {
        selectedTicker = null;
    } else {
        selectedTicker = ticker;
    }

    // Update bubble selection
    d3.selectAll('.bubble')
        .classed('selected', d => d.ticker === selectedTicker);

    // Update table selection
    d3.selectAll('#data-table tbody tr')
        .classed('selected', function() {
            return d3.select(this).attr('data-ticker') === selectedTicker;
        });

    // Scroll to selected row in table
    if (selectedTicker) {
        const selectedRow = document.querySelector(`#data-table tr[data-ticker="${selectedTicker}"]`);
        if (selectedRow) {
            selectedRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
}
