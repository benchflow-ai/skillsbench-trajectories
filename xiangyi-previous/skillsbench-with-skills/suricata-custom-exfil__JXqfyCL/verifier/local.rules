# Custom exfiltration detection rule
# Detects HTTP POST requests to /telemetry/v2/report with exfil mode
# and suspicious body patterns (Base64 blob + hex signature)
alert http any any -> any any (msg:"Custom HTTP Exfiltration - Telemetry Blob with Signature"; flow:to_server,established; content:"POST"; http_method; content:"/telemetry/v2/report"; http_uri; content:"X-TLM-Mode"; http_header; content:"exfil"; http_header; content:"blob="; http_client_body; pcre:"/blob=[A-Za-z0-9+\/]{80,}/"; content:"sig="; http_client_body; pcre:"/sig=[0-9a-fA-F]{64}/"; sid:1000001; rev:1;)
