[427.095799, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\nimport pandas as pd\nimport numpy as np\n\n# Load and verify all the data is correct\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\n\n# Verify Value sheet 2025 data\nws_value = wb['Value']\nprint(\"VALUE SHEET - 2025 DATA (Row 18):\")\nfor col in range(2, 18):\n    header = ws_value.cell(1, col).value\n    val = ws_value.cell(18, col).value\n    if val is not None and header is not None:\n        country = str(header).split(':')[0].strip() if header else 'N/A'\n        print(f\"  {country}: {val}\")\n\n# Verify Volume sheet 2025 data\nws_volume = wb['Volume']\nprint(\"\\nVOLUME SHEET - 2025 DATA (Row 18):\")\nfor col in range(2, 12):\n    header = ws_volume.cell(1, col).value\n    val = ws_volume.cell(18, col).value\n    if val is not None and header is not None:\n        country = str(header).split(':')[0].strip() if header else 'N/A'\n        print(f\"  {country}: {val}\")\n\n# Calculate Slovakia value\nprint(\"\\nSLOVAKIA CALCULATION:\")\nprint(\"  Volume: 1.019 million troy ounces\")\navg_price = 3202.8236082355647\nprint(f\"  Jan-Sep 2025 avg gold price: {avg_price:.2f} USD/oz\")\nprint(f\"  Slovakia value: {1.019 * avg_price:.2f} million USD\")\n\nprint(\"\\nFile saved successfully!\")\nENDSCRIPT\n"]
