[352.909778, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_total = wb['Total Reserves']\n\nprint(\"Total Reserves - Row 1 (headers) and Row 18 (2025 data):\")\nfor col in range(1, 17):\n    header = ws_total.cell(1, col).value\n    data_2025 = ws_total.cell(18, col).value\n    if header or data_2025:\n        col_letter = openpyxl.utils.get_column_letter(col)\n        print(f\"Col {col_letter}: Header='{str(header)[:60] if header else 'None'}' | 2025={data_2025}\")\nENDSCRIPT\n"]
