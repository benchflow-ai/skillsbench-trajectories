[482.212425, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_answer = wb['Answer']\nws_gold = wb['Gold price']\n\nprint(\"FINAL FORMULA VERIFICATION:\")\nprint()\n\n# Check that row 430 in Gold price has all the formulas\nprint(\"Gold price row 430 (2025M9):\")\nprint(f\"  C430 (log return): {ws_gold.cell(430, 3).value}\")\nprint(f\"  D430 (3-mo vol): {ws_gold.cell(430, 4).value}\")\nprint(f\"  E430 (12-mo vol): {ws_gold.cell(430, 5).value}\")\nprint()\n\n# Check Answer sheet formulas\nprint(\"Answer sheet Step 1:\")\nprint(f\"  C3 (Z-score): {ws_answer.cell(3, 3).value}\")\nprint(f\"  C4 (3-mo vol): {ws_answer.cell(4, 3).value}\")\nprint(f\"  C5 (3-mo ann): {ws_answer.cell(5, 3).value}\")\nprint(f\"  C6 (12-mo vol): {ws_answer.cell(6, 3).value}\")\nprint()\n\n# Check Step 2 exposure formula\nprint(\"Answer sheet Step 2 exposure (row 13):\")\nfor col in range(3, 6):\n    print(f\"  {openpyxl.utils.get_column_letter(col)}13: {ws_answer.cell(13, col).value}\")\nprint()\n\n# Check Step 3 formulas\nprint(\"Answer sheet Step 3:\")\nprint(f\"  C22 (exposure): {ws_answer.cell(22, 3).value}\")\nprint(f\"  C23 (total res): {ws_answer.cell(23, 3).value}\")\nprint(f\"  C24 (RaR): {ws_answer.cell(24, 3).value}\")\nprint()\nprint(\"All formulas verified!\")\nENDSCRIPT\n"]
