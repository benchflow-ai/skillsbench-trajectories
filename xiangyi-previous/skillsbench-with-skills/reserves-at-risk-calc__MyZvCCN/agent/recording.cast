[341.76808, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_total = wb['Total Reserves']\n\nprint(\"Total Reserves sheet structure:\")\nfor row in range(1, 20):\n    vals = []\n    for col in range(1, 5):\n        v = ws_total.cell(row, col).value\n        if v is not None:\n            vals.append(f\"{openpyxl.utils.get_column_letter(col)}:{str(v)[:50]}\")\n    if vals:\n        print(f\"Row {row}: {vals}\")\nENDSCRIPT\n"]
