[238.101044, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport openpyxl\n\n# Read the sheets as dataframes to analyze\nvalue_df = pd.read_excel('/root/output/rar_result.xlsx', sheet_name='Value', header=None)\nvolume_df = pd.read_excel('/root/output/rar_result.xlsx', sheet_name='Volume', header=None)\ntotal_df = pd.read_excel('/root/output/rar_result.xlsx', sheet_name='Total Reserves', header=None)\n\n# Get 2025 data from Value sheet (row 17, 0-indexed)\nprint(\"Value sheet - 2025 data (row 17):\")\nvalue_2025 = value_df.iloc[17, :]\nfor col in range(2, value_df.shape[1]):\n    country_desc = str(value_df.iloc[0, col])\n    val = value_2025[col]\n    if pd.notna(val):\n        # Extract country name from description\n        country = country_desc.split(':')[0].strip()\n        print(f\"  Col {col}: {country} = {val}\")\n\nprint(\"\\nVolume sheet - 2025 data (row 17):\")\nvolume_2025 = volume_df.iloc[17, :]\nfor col in range(2, volume_df.shape[1]):\n    country_desc = str(volume_df.iloc[0, col])\n    val = volume_2025[col]\n    if pd.notna(val):\n        country = country_desc.split(':')[0].strip()\n        print(f\"  Col {col}: {country} = {val}\")\n\nprint(\"\\nTotal Reserves sheet - 2025 data (row 17):\")\ntotal_2025 = total_df.iloc[17, :]\nfor col in range(2, total_df.shape[1]):\n    country_desc = str(total_df.iloc[0, col])\n    val = total_2025[col]\n    if pd.notna(val):\n        country = country_desc.split(':')[0].strip()\n        print(f\"  Col {col}: {country} = {val}\")\nENDSCRIPT\n"]
