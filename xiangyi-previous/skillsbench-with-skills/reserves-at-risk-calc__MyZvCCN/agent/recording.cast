[309.102632, "o", "    ws_answer.cell(24, col).value = f\"={col_letter}22/{col_letter}23*100\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Step 3 data and formulas added\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[309.102713, "o", "> # Save the workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[309.102781, "o", "wb.save('/root/output/rar_result.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[309.102842, "o", "print(\"\\nWorkbook saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[309.102908, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
