[94.202171, "i", "python3 << 'EOF'\nimport pandas as pd\n\n# Read IMF data\ndf = pd.read_excel('external-data.xls', sheet_name='External', header=None)\n\n# Get gold price column info\nprint(\"Gold price column (76):\")\nprint(f\"Code: {df.iloc[0, 76]}\")\nprint(f\"Description: {df.iloc[1, 76]}\")\nprint(f\"Data Type: {df.iloc[2, 76]}\")\nprint(f\"Frequency: {df.iloc[3, 76]}\")\nprint()\n\n# Show first and last few data points\nprint(\"First 10 data points (from row 4):\")\nfor i in range(4, 14):\n    print(f\"{df.iloc[i, 0]}: {df.iloc[i, 76]}\")\n\nprint(\"\\nLast 20 data points:\")\nfor i in range(max(4, df.shape[0]-20), df.shape[0]):\n    print(f\"{df.iloc[i, 0]}: {df.iloc[i, 76]}\")\nEOF\n"]
