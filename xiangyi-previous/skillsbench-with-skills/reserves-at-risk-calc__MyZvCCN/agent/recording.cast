[328.832108, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\n\n# Load and verify the workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\n\n# Check Gold price sheet\nws_gold = wb['Gold price']\nprint(\"Gold price sheet - first few rows:\")\nfor row in range(1, 8):\n    print(f\"Row {row}: A={ws_gold.cell(row, 1).value}, B={ws_gold.cell(row, 2).value}, C={ws_gold.cell(row, 3).value}, D={ws_gold.cell(row, 4).value}, E={ws_gold.cell(row, 5).value}\")\n\nprint(\"\\nGold price sheet - last few rows:\")\nfor row in range(425, 431):\n    print(f\"Row {row}: A={ws_gold.cell(row, 1).value}, B={ws_gold.cell(row, 2).value}, C={ws_gold.cell(row, 3).value}, D={ws_gold.cell(row, 4).value}, E={ws_gold.cell(row, 5).value}\")\n\n# Check Answer sheet\nws_answer = wb['Answer']\nprint(\"\\nAnswer sheet content:\")\nfor row in range(1, 25):\n    vals = []\n    for col in range(1, 15):\n        v = ws_answer.cell(row, col).value\n        if v is not None:\n            vals.append(f\"{openpyxl.utils.get_column_letter(col)}:{v}\")\n    if vals:\n        print(f\"Row {row}: {vals}\")\nENDSCRIPT\n"]
