67725679204']\r\nRow 13: ['B:Gold valuation exposure (95% one-sided shock)', 'C:=C12*$C$3*$C$5/100', 'D:=D12*$C$3*$C$5/100', 'E:=E12*$C$3*$C$5/100', 'F:=F12*$C$3*$C$5/100', 'G:=G12*$C$3*$C$5/100', 'H:=H12*$C$3*$C$5/100', 'I:=I12*$C$3*$C$5/100', 'J:=J12*$C$3*$C$5/100', 'K:=K12*$C$3*$C$5/100']\r\nRow 16: ['B:STEP 3']\r\nRow 20: ['B:Country', 'C:Belarus', 'D:Georgia', 'E:Moldova', 'F:Uzbekistan', 'G:Czechia', 'H:Latvia', 'I:Lithuania']\r\nRow 21: ['B:Gold reserves \\n(in millions of USD)', 'C:7471', 'D:1002', 'E:10.71', 'F:55092.42', 'G:10121.89', 'H:921.28', 'I:807.1']\r\nRow 22: ['B:Gold valuation exposure (95% one-sided shock)', 'C:=C21*$C$3*$C$5/100', 'D:=D21*$C$3*$C$5/100', 'E:=E21*$C$3*$C$5/100', 'F:=F21*$C$3*$C$5/100', 'G:=G21*$C$3*$C$5/100', 'H:=H21*$C$3*$C$5/100', 'I:=I21*$C$3*$C$5/100']\r\nRow 23: ['B:Total Reserve', 'C:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&C20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'D:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&D20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'E:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&E20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'F:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&F20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'G:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&G20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'H:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&H20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))', 'I:=INDEX(\\'Total Reserves\\'!$B$18:$P$18,MATCH(\"*\"&I20&\"*\",\\'Total Reserves\\'!$B$1:$P$1,0))']\r\nRow 24: ['B:RaR(in percent of total reserves)', 'C:=C22/C23*100', 'D:=D22/D23*100', 'E:=E22/E23*100', 'F:=F22/F23*100', 'G:=G22/G23*100', 'H:=H22/H23*100', 'I:=I22/I23*100']\r\n"]
