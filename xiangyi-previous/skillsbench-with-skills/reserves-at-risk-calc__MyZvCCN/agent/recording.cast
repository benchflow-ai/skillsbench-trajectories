[84.164195, "i", "python3 << 'EOF'\nimport pandas as pd\n\n# Read IMF data\ndf = pd.read_excel('external-data.xls', sheet_name='External', header=None)\n\n# Look for gold in the first two rows (commodity codes and descriptions)\nfor col in range(df.shape[1]):\n    code = str(df.iloc[0, col]).upper() if pd.notna(df.iloc[0, col]) else ''\n    desc = str(df.iloc[1, col]).upper() if pd.notna(df.iloc[1, col]) else ''\n    if 'GOLD' in code or 'GOLD' in desc:\n        print(f\"Column {col}: Code={df.iloc[0, col]}, Desc={df.iloc[1, col][:100] if pd.notna(df.iloc[1, col]) else 'N/A'}\")\nEOF\n"]
