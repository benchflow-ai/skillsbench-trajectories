[409.022908, "i", "python3 << 'ENDSCRIPT'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\n\nprint(\"=\" * 60)\nprint(\"FINAL VERIFICATION\")\nprint(\"=\" * 60)\n\n# Check Gold price sheet\nws_gold = wb['Gold price']\nprint(\"\\n1. GOLD PRICE SHEET:\")\nprint(f\"   Total rows: {ws_gold.max_row}\")\nprint(f\"   Last date: {ws_gold.cell(430, 1).value}\")\nprint(f\"   Last price: {ws_gold.cell(430, 2).value}\")\nprint(f\"   Log return formula: {ws_gold.cell(430, 3).value}\")\nprint(f\"   3-month vol formula: {ws_gold.cell(430, 4).value}\")\nprint(f\"   12-month vol formula: {ws_gold.cell(430, 5).value}\")\n\n# Check Answer sheet\nws_answer = wb['Answer']\nprint(\"\\n2. ANSWER SHEET - STEP 1:\")\nprint(f\"   Z-score (95%): {ws_answer.cell(3, 3).value}\")\nprint(f\"   3-month vol: {ws_answer.cell(4, 3).value}\")\nprint(f\"   3-month annualized: {ws_answer.cell(5, 3).value}\")\nprint(f\"   12-month vol: {ws_answer.cell(6, 3).value}\")\n\nprint(\"\\n3. ANSWER SHEET - STEP 2:\")\nprint(\"   Countries:\", end=\" \")\nfor col in range(3, 12):\n    v = ws_answer.cell(11, col).value\n    if v:\n        print(v, end=\", \")\nprint()\nprint(\"   Gold reserves:\", end=\" \")\nfor col in range(3, 12):\n    v = ws_answer.cell(12, col).value\n    if v:\n        print(f\"{v:.2f}\" if isinstance(v, float) else v, end=\", \")\nprint()\nprint(f\"   Exposure formula (C13): {ws_answer.cell(13, 3).value}\")\n\nprint(\"\\n4. ANSWER SHEET - STEP 3:\")\nprint(\"   Countries:\", end=\" \")\nfor col in range(3, 10):\n    v = ws_answer.cell(20, col).value\n    if v:\n        print(v, end=\", \")\nprint()\nprint(\"   Gold reserves:\", end=\" \")\nfor col in range(3, 10):\n    v = ws_answer.cell(21, col).value\n    if v:\n        print(f\"{v:.2f}\" if isinstance(v, float) else v, end=\", \")\nprint()\nprint(f\"   Exposure formula (C22): {ws_answer.cell(22, 3).value}\")\nprint(f\"   Total Reserve formula (C23): {ws_answer.cell(23, 3).value}\")\nprint(f\"   RaR formula (C24): {ws_answer.cell(24, 3).value}\")\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Verification complete!\")\nprint(\"=\" * 60)\nENDSCRIPT\n"]
