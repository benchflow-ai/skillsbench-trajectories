[?2004l[?2004h>         label = 'Dolly In' if mean_rad > 0 else 'Dolly Out'
[?2004l[?2004h> 
[?2004l[?2004h>     labels[f"{i}->{i+1}"] = [label]
[?2004l[?2004h> 
[?2004l[?2004h>     # estimate affine global motion using features
[?2004l[?2004h>     p0 = cv2.goodFeaturesToTrack(prev_gray, maxCorners=500, qualityLevel=0.01, minDistance=7)
[?2004l[?2004h>     if p0 is not None:
[?2004l[?2004h>         p1, st, err = cv2.calcOpticalFlowPyrLK(prev_gray, nxt_gray, p0, None)
[?2004l[?2004h>         good0 = p0[st==1]
[?2004l[?2004h>         good1 = p1[st==1]
[?2004l[?2004h>         if len(good0) >= 6:
[?2004l[?2004h>             M, inliers = cv2.estimateAffinePartial2D(good0, good1)
[?2004l[?2004h>         else:
[?2004l[?2004h>             M = None
[?2004l[?2004h>     else:
[?2004l[?2004h>         M = None
[?2004l[?2004h> 
[?2004l[?2004h>     if M is not None:
[?2004l[?2004h>         # compute global flow from affine
[?2004l[?2004h>         A = M[:, :2]
[?2004l[?2004h>         b = M[:, 2]
[?2004l[?2004h>         coords = np.stack([xs, ys], axis=-1).astype(np.float32)
[?2004l[?2004h>         global_flow = coords @ A.T + b - coords
[?2004l[?2004h>         gdx = global_flow[...,0]
[?2004l[?2004h>         gdy = global_flow[...,1]
[?2004l[?2004h>         res = np.sqrt((dx-gdx)**2 + (dy-gdy)**2)
[?2004l[?2004h>     else:
