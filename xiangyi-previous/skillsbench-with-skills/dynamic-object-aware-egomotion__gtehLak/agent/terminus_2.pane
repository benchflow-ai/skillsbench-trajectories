[?2004l[?2004h>     thresh = 0.5
[?2004l[?2004h>     candidates = {
[?2004l[?2004h>         'h': abs(mean_dx),
[?2004l[?2004h>         'v': abs(mean_dy),
[?2004l[?2004h>         'r': abs(mean_rad)
[?2004l[?2004h>     }
[?2004l[?2004h>     max_key = max(candidates, key=candidates.get)
[?2004l[?2004h>     if candidates[max_key] < thresh:
[?2004l[?2004h>         label = 'Stay'
[?2004l[?2004h>     elif max_key == 'h':
[?2004l[?2004h>         label = 'Pan Left' if mean_dx > 0 else 'Pan Right'
