[?2004l[?2004h> 
[?2004l[?2004h>     # dynamic mask threshold
[?2004l[?2004h>     dyn_mask = res > 1.0
[?2004l[?2004h>     # remove small noise by simple morphological opening
[?2004l[?2004h>     dyn_mask = cv2.morphologyEx(dyn_mask.astype(np.uint8)*255, cv2.MORPH_OPEN, np.ones((3,3),np.uint8)) > 0
[?2004l[?2004h> 
[?2004l[?2004h>     csr = sparse.csr_matrix(dyn_mask)
