[?2004l[?2004h>     dx = flow[...,0]
[?2004l[?2004h>     dy = flow[...,1]
[?2004l[?2004h>     mean_dx = float(np.mean(dx))
[?2004l[?2004h>     mean_dy = float(np.mean(dy))
[?2004l[?2004h> 
[?2004l[?2004h>     # radial component for dolly
[?2004l[?2004h>     ys, xs = np.mgrid[0:h, 0:w]
[?2004l[?2004h>     cx, cy = w/2.0, h/2.0
[?2004l[?2004h>     vx = xs - cx
[?2004l[?2004h>     vy = ys - cy
[?2004l[?2004h>     norm = np.sqrt(vx*vx + vy*vy) + 1e-6
[?2004l[?2004h>     rad = (dx*vx + dy*vy) / norm
[?2004l[?2004h>     mean_rad = float(np.mean(rad))
[?2004l[?2004h> 
