import json
from pathlib import Path

metrics = json.load(open('/root/metrics.json'))

in_path = Path('/root/network_stats.csv')
lines = in_path.read_text().splitlines()
new_lines = []
for line in lines:
    if line.startswith('#') or line.strip() == '':
        new_lines.append(line)
        continue
    if ',' in line:
        key = line.split(',',1)[0].strip()
        if key in metrics:
            new_lines.append(f"{key},{metrics[key]}")
        else:
            new_lines.append(line)
    else:
        new_lines.append(line)

in_path.write_text('\n'.join(new_lines) + '\n')
PY
