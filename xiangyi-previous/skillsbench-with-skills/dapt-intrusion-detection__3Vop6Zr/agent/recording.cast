[13.883927, "o", "drwxr-xr-x 3 root root     4096 Jan 26 06:52 \u001b[01;34m.gemini\u001b[0m\r\ndrwxr-xr-x 3 root root     4096 Jan 26 06:52 \u001b[01;34m.goose\u001b[0m\r\ndrwxr-xr-x 3 root root     4096 Jan 26 06:52 \u001b[01;34m.opencode\u001b[0m\r\n-rw-r--r-- 1 root root      161 Apr 22  2024 .profile\r\n-rw-r--r-- 1 root root      793 Jan 25 20:43 network_stats.csv\r\n-rw-r--r-- 1 root root 32715078 Jan 25 20:43 packets.pcap\r\ndrwxr-xr-x 4 root root     4096 Jan 25 20:43 \u001b[01;34mskills\u001b[0m\r\n"]
