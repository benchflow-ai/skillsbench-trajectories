[220.159555, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\n\nmetrics = json.load(open('/root/metrics.json'))\n\nin_path = Path('/root/network_stats.csv')\nlines = in_path.read_text().splitlines()\nnew_lines = []\nfor line in lines:\n    if line.startswith('#') or line.strip() == '':\n        new_lines.append(line)\n        continue\n    if ',' in line:\n        key = line.split(',',1)[0].strip()\n        if key in metrics:\n            new_lines.append(f\"{key},{metrics[key]}\")\n        else:\n            new_lines.append(line)\n    else:\n        new_lines.append(line)\n\nin_path.write_text('\\n'.join(new_lines) + '\\n')\nPY\n"]
[220.159783, "o", "python3 - <<'PY'\r\nimport json\r\nfrom pathlib import Path\r\n\r\nmetrics = json.load(open('/root/metrics.json'))\r\n\r\nin_path = Path('/root/network_stats.csv')\r\nlines = in_path.read_text().splitlines()\r\nnew_lines = []\r\nfor line in lines:\r\n    if line.startswith('#') or line.strip() == '':\r\n        new_lines.append(line)\r\n        continue\r\n    if ',' in line:\r\n        key = line.split(',',1)[0].strip()\r\n        if key in metrics:\r\n            new_lines.append(f\"{key},{metrics[key]}\")\r\n        else:\r\n            new_lines.append(line)\r\n    else:\r\n        new_lines.append(line)\r\n\r\nin_path.write_text('\\n'.join(new_lines) + '\\n')\r\nPY\r\n"]
