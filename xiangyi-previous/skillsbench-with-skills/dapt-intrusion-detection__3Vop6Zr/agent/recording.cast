[160.957763, "o", "    iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r"]
[160.95781, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.957856, "o", "\u001b[?2004h> "]
[160.957908, "o", "# producer/consumer\r\n\u001b[?2004l\r"]
[160.957957, "o", "\u001b[?2004h> "]
[160.957997, "o", "num_producers = num_consumers = 0\r\n\u001b[?2004l\r"]
[160.958048, "o", "\u001b[?2004h> "]
[160.958098, "o", "for ip in nodes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.958222, "o", "    sent = bytes_sent[ip]; recv = bytes_recv[ip]\r\n\u001b[?2004l\r"]
[160.958267, "o", "\u001b[?2004h> "]
[160.958315, "o", "    denom = sent + recv\r\n\u001b[?2004l\r"]
[160.95837, "o", "\u001b[?2004h> "]
[160.958424, "o", "    if denom == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.958478, "o", ">         continue\r\n\u001b[?2004l\r"]
[160.958525, "o", "\u001b[?2004h> "]
[160.958576, "o", "    pcr = (sent - recv) / denom\r\n\u001b[?2004l\r"]
[160.958623, "o", "\u001b[?2004h> "]
[160.958664, "o", "    if pcr > 0.2:\r\n\u001b[?2004l\r"]
[160.958708, "o", "\u001b[?2004h> "]
[160.958757, "o", "        num_producers += 1\r\n\u001b[?2004l\r"]
[160.958808, "o", "\u001b[?2004h> "]
[160.958845, "o", "    elif pcr < -0.2:\r\n\u001b[?2004l\r"]
[160.958895, "o", "\u001b[?2004h> "]
[160.958938, "o", "        num_consumers += 1\r\n\u001b[?2004l\r"]
[160.958983, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.959008, "o", "> "]
