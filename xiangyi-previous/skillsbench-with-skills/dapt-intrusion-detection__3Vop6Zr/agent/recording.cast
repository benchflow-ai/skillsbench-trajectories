[160.965285, "o", "\u001b[?2004h> "]
[160.965339, "o", "    'udp_flows': udp_flows,\r\n\u001b[?2004l\r"]
[160.965389, "o", "\u001b[?2004h> "]
[160.965505, "o", "    'is_traffic_benign': str(is_traffic_benign).lower(),\r\n\u001b[?2004l\r"]
[160.965556, "o", "\u001b[?2004h> "]
[160.965663, "o", "    'has_port_scan': str(has_port_scan).lower(),\r\n\u001b[?2004l\r"]
[160.965716, "o", "\u001b[?2004h> "]
[160.965833, "o", "    'has_dos_pattern': str(has_dos_pattern).lower(),\r\n\u001b[?2004l\r"]
[160.965881, "o", "\u001b[?2004h> "]
[160.965982, "o", "    'has_beaconing': str(has_beaconing).lower(),\r\n\u001b[?2004l\r"]
[160.966032, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[160.966081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.966116, "o", "import json\r\n\u001b[?2004l\r"]
[160.966161, "o", "\u001b[?2004h> "]
[160.966252, "o", "with open('/root/metrics.json','w') as f:\r\n\u001b[?2004l\r"]
