[63.346007, "o", "> else:\r\n\u001b[?2004l\r '\u001b[?2004h> "]
[63.346167, "o", "    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\r\n\u001b[?2004l\r"]
[63.346212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[63.346259, "o", "# size stats\r\n\u001b[?2004l\r"]
[63.346306, "o", "\u001b[?2004h> total_bytes = sum(lengths)\r\n\u001b[?2004l\r"]
[63.346368, "o", "\u001b[?2004h> "]
[63.346508, "o", "avg_packet_size = sum(lengths) / len(lengths) if lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.346562, "o", "> "]
[63.346616, "o", "min_packet_size = min(lengths) if lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.346703, "o", "max_packet_size = max(lengths) if lengths else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.346753, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.346808, "o", "# entropy function\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.346859, "o", "\u001b[?2004h> "]
[63.346913, "o", "def shannon_entropy(values):\r\n\u001b[?2004l\r\u001b[?2004h>     if not values:\r\n\u001b[?2004l\r"]
[63.346984, "o", "\u001b[?2004h> "]
[63.347038, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h>     c = Counter(values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347084, "o", "    total = sum(c.values())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347143, "o", "    ent = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347195, "o", "    for count in c.values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347245, "o", "        p = count / total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347288, "o", "        ent -= p * math.log2(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347331, "o", "    return ent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.347385, "o", "\u001b[?2004h> "]
[63.347424, "o", "src_ip_entropy = shannon_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.347478, "o", "> "]
[63.347521, "o", "dst_ip_entropy = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347596, "o", "src_port_entropy = shannon_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.347642, "o", "> "]
[63.347686, "o", "dst_port_entropy = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.34776, "o", "unique_src_ports = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.347806, "o", "> "]
[63.347861, "o", "unique_dst_ports = len(set(dst_ports))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347909, "o", "# graph metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.347974, "o", "nodes = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.34802, "o", "num_nodes = len(nodes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.348075, "o", "> "]
[63.348126, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.34822, "o", "network_density = (num_edges / (num_nodes * (num_nodes - 1))) if num_nodes > 1 else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.348278, "o", "\u001b[?2004h> "]
[63.34833, "o", "# indegree/outdegree\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.348382, "o", "outdegree = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.348427, "o", "indegree = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.34848, "o", "for s,d in edges:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.348525, "o", "    outdegree[s].add(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.348568, "o", "    indegree[d].add(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349127, "o", "max_outdegree = max((len(v) for v in outdegree.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h> max_indegree = max((len(v) for v in indegree.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # IAT stats\r\n\u001b[?2004l\r\u001b[?2004h> if len(timestamps) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>     ts_sorted = sorted(timestamps)\r\n\u001b[?2004l\r\u001b[?2004h>     iats = [ts_sorted[i+1] - ts_sorted[i] for i in range(len(ts_sorted)-1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349195, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r"]
[63.349241, "o", "\u001b[?2004h>     # population variance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349381, "o", "    iat_variance = sum((x-iat_mean)**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349473, "o", "    iat_std = math.sqrt(iat_variance)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349608, "o", "    iat_cv = iat_std / iat_mean if iat_mean != 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.349657, "o", "else:\r\n\u001b[?2004l\r"]
[63.349715, "o", "\u001b[?2004h> "]
[63.349774, "o", "    iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.349835, "o", "> # producer/consumer\r\n\u001b[?2004l\r"]
[63.349887, "o", "\u001b[?2004h> "]
[63.349947, "o", "num_producers = num_consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.349998, "o", "> for ip in nodes:\r\n\u001b[?2004l\r"]
[63.350047, "o", "\u001b[?2004h>     sent = bytes_sent[ip]\r\n\u001b[?2004l\r"]
[63.350104, "o", "\u001b[?2004h>     recv = bytes_recv[ip]\r\n\u001b[?2004l\r"]
[63.350158, "o", "\u001b[?2004h>     denom = sent + recv\r\n\u001b[?2004l\r"]
[63.350206, "o", "\u001b[?2004h>     if denom == 0:\r\n\u001b[?2004l\r"]
[63.350255, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[63.350302, "o", "\u001b[?2004h> "]
[63.350352, "o", "    pcr = (sent - recv) / denom\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350403, "o", "    if pcr > 0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350454, "o", "        num_producers += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350505, "o", "    elif pcr < -0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.35056, "o", "        num_consumers += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.350607, "o", "\u001b[?2004h> # flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350663, "o", "unique_flows = len(flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350724, "o", "tcp_flows = len(tcp_flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.350788, "o", "> udp_flows = len(udp_flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.35084, "o", "> # bidirectional flows\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.350899, "o", "> flow_set = set(flow_keys)\r\n\u001b[?2004l\r"]
[63.350931, "o", "\u001b[?2004h> "]
[63.351091, "o", "bidirectional_flows = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351159, "o", "for key in flow_keys:\r\n\u001b[?2004l\r\u001b[?2004h>     src, dst, sport, dport, proto = key\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351227, "o", "    rev = (dst, src, dport, sport, proto)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351279, "o", "    if rev in flow_set:\r\n\u001b[?2004l\r\u001b[?2004h>         bidirectional_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.351337, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351387, "o", "# analysis flags (basic heuristics)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351432, "o", "# define simple thresholds\r\n\u001b[?2004l\r"]
[63.351488, "o", "\u001b[?2004h> "]
[63.351555, "o", "has_port_scan = max_outdegree > 50 and unique_dst_ports > 50\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351874, "o", "has_dos_pattern = packets_per_minute_max > packets_per_minute_avg * 10 if packets_per_minute_avg>0 else False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.351954, "o", "# beaconing: low variance of IAT and at least some traffic\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353012, "o", "has_beaconing = (iat_mean > 0 and iat_variance < (iat_mean * 0.1)**2)\r\n\u001b[?2004l\r\u001b[?2004h> # benign if no flags\r\n\u001b[?2004l\r\u001b[?2004h> is_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> metrics = {\r\n\u001b[?2004l\r\u001b[?2004h>     'protocol_tcp': protocol_tcp,\r\n\u001b[?2004l\r\u001b[?2004h>     'protocol_udp': protocol_udp,\r\n\u001b[?2004l\r\u001b[?2004h>     'protocol_icmp': protocol_icmp,\r\n\u001b[?2004l\r\u001b[?2004h>     'protocol_arp': protocol_arp,\r\n\u001b[?2004l\r\u001b[?2004h>     'protocol_ip_total': protocol_ip_total,\r\n\u001b[?2004l\r\u001b[?2004h>     'duration_seconds': duration_seconds,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353112, "o", "    'packets_per_minute_avg': packets_per_minute_avg,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353215, "o", "    'packets_per_minute_max': packets_per_minute_max,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353312, "o", "    'packets_per_minute_min': packets_per_minute_min,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353372, "o", "    'total_bytes': total_bytes,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353444, "o", "    'avg_packet_size': avg_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.353496, "o", "> "]
[63.353559, "o", "    'min_packet_size': min_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.35361, "o", ">     'max_packet_size': max_packet_size,\r\n\u001b[?2004l\r"]
[63.353657, "o", "\u001b[?2004h> "]
[63.353711, "o", "    'dst_port_entropy': dst_port_entropy,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.353761, "o", "> "]
[63.353818, "o", "    'src_port_entropy': src_port_entropy,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353869, "o", "    'src_ip_entropy': src_ip_entropy,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.353915, "o", "    'dst_ip_entropy': dst_ip_entropy,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.35396, "o", "> "]
[63.354009, "o", "    'unique_dst_ports': unique_dst_ports,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.354061, "o", "> "]
[63.354112, "o", "    'unique_src_ports': unique_src_ports,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354165, "o", "    'num_nodes': num_nodes,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354209, "o", "    'num_edges': num_edges,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354275, "o", "    'network_density': network_density,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.354329, "o", "> "]
[63.354379, "o", "    'max_indegree': max_indegree,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354418, "o", "    'max_outdegree': max_outdegree,\r\n\u001b[?2004l\r"]
[63.354471, "o", "\u001b[?2004h> "]
[63.354526, "o", "    'iat_mean': iat_mean,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354572, "o", "    'iat_variance': iat_variance,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354623, "o", "    'iat_cv': iat_cv,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354678, "o", "    'num_producers': num_producers,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.354724, "o", "> "]
[63.35477, "o", "    'num_consumers': num_consumers,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.354823, "o", "> "]
[63.354863, "o", "    'unique_flows': unique_flows,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.354906, "o", "    'bidirectional_flows': bidirectional_flows,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.354951, "o", "> "]
[63.354995, "o", "    'tcp_flows': tcp_flows,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.355039, "o", "    'udp_flows': udp_flows,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.355146, "o", "    'is_traffic_benign': str(is_traffic_benign).lower(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.355228, "o", "    'has_port_scan': str(has_port_scan).lower(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.355276, "o", "> "]
[63.355324, "o", "    'has_dos_pattern': str(has_dos_pattern).lower(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.355368, "o", "> "]
[63.355415, "o", "    'has_beaconing': str(has_beaconing).lower(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.355467, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.355517, "o", "\u001b[?2004h> "]
[63.355567, "o", "for k,v in metrics.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.355617, "o", "    print(k, v)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[93.299792, "o", "Traceback (most recent call last):\r\n  File \"<stdin>\", line 127, in <module>\r\nTypeError: unsupported operand type(s) for /: 'float' and 'EDecimal'\r\n"]
[95.074407, "i", "python3 - <<'PY'\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\nimport math\nfrom collections import Counter, defaultdict\npcap = rdpcap('/root/packets.pcap')\nlengths = [len(pkt) for pkt in pcap]\ntimestamps = [pkt.time for pkt in pcap]\nprotocol_tcp = protocol_udp = protocol_icmp = protocol_arp = 0\nprotocol_ip_total = 0\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\nedges = set()\nbytes_sent = defaultdict(int)\nbytes_recv = defaultdict(int)\nflow_keys = set(); tcp_flow_keys = set(); udp_flow_keys = set()\nfor pkt in pcap:\n    if IP in pkt:\n        protocol_ip_total += 1\n        ip = pkt[IP]\n        src_ips.append(ip.src); dst_ips.append(ip.dst)\n        edges.add((ip.src, ip.dst))\n        bytes_sent[ip.src] += len(pkt)\n        bytes_recv[ip.dst] += len(pkt)\n        if TCP in pkt:\n            protocol_tcp += 1\n            tcp = pkt[TCP]\n            src_ports.append(tcp.sport); dst_ports.append(tcp.dport)\n            key = (ip.src, ip.dst, tcp.sport, tcp.dport, 'TCP')\n            flow_keys.add(key); tcp_flow_keys.add(key)\n        elif UDP in pkt:\n            protocol_udp += 1\n            udp = pkt[UDP]\n            src_ports.append(udp.sport); dst_ports.append(udp.dport)\n            key = (ip.src, ip.dst, udp.sport, udp.dport, 'UDP')\n            flow_keys.add(key); udp_flow_keys.add(key)\n        elif ICMP in pkt:\n            protocol_icmp += 1\n    elif ARP in pkt:\n        protocol_arp += 1\n\nduration_seconds = max(timestamps) - min(timestamps) if timestamps else 0\nif timestamps:\n    first = min(timestamps)\n    buckets = defaultdict(int)\n    for t in timestamps:\n        bucket = int((t - first) // 60)\n        buckets[bucket] += 1\n    counts = list(buckets.values())\n    packets_per_minute_avg = sum(counts) / len(counts)\n    packets_per_minute_max = max(counts)\n    packets_per_minute_min = min(counts)\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\ntotal_bytes = sum(lengths)\navg_packet_size = sum(lengths) / len(lengths) if lengths else 0\nmin_packet_size = min(lengths) if lengths else 0\nmax_packet_size = max(lengths) if lengths else 0\n\ndef shannon_entropy(values):\n    if not values:\n        return 0\n    c = Counter(values)\n    total = sum(c.values())\n    ent = 0.0\n    for count in c.values():\n        p = count / total\n        ent -= p * math.log2(p)\n    return ent\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\nnodes = set(src_ips) | set(dst_ips)\nnum_nodes = len(nodes)\nnum_edges = len(edges)\nnetwork_density = (num_edges / (num_nodes * (num_nodes - 1))) if num_nodes > 1 else 0\noutdegree = defaultdict(set)\nindegree = defaultdict(set)\nfor s,d in edges:\n    outdegree[s].add(d)\n    indegree[d].add(s)\nmax_outdegree = max((len(v) for v in outdegree.values()), default=0)\nmax_indegree = max((len(v) for v in indegree.values()), default=0)\n\nif len(timestamps) > 1:\n    ts_sorted = sorted(timestamps)\n    iats = [ts_sorted[i+1] - ts_sorted[i] for i in range(len(ts_sorted)-1)]\n    iat_mean = sum(iats) / len(iats)\n    iat_variance = sum((x-iat_mean)**2 for x in iats) / len(iats)\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = iat_std / iat_mean if iat_mean != 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\nnum_producers = num_consumers = 0\nfor ip in nodes:\n    sent = bytes_sent[ip]; recv = bytes_recv[ip]\n    denom = sent + recv\n    if denom == 0:\n        continue\n    pcr = (sent - recv) / denom\n    if pcr > 0.2:\n        num_producers += 1\n    elif pcr < -0.2:\n        num_consumers += 1\n\nunique_flows = len(flow_keys)\ntcp_flows = len(tcp_flow_keys)\nudp_flows = len(udp_flow_keys)\nflow_set = set(flow_keys)\nbidirectional_flows = 0\nfor key in flow_keys:\n    src, dst, sport, dport, proto = key\n    rev = (dst, src, dport, sport, proto)\n    if rev in flow_set:\n        bidirectional_flows += 1\n\nhas_port_scan = max_outdegree > 50 and unique_dst_ports > 50\nhas_dos_pattern = packets_per_minute"]
[95.07447, "i", "_max > packets_per_minute_avg * 10 if packets_per_minute_avg>0 else False\nhas_beaconing = (iat_mean > 0 and iat_variance < (iat_mean * 0.1)**2)\nis_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\n\nmetrics = {\n    'protocol_tcp': protocol_tcp,\n    'protocol_udp': protocol_udp,\n    'protocol_icmp': protocol_icmp,\n    'protocol_arp': protocol_arp,\n    'protocol_ip_total': protocol_ip_total,\n    'duration_seconds': duration_seconds,\n    'packets_per_minute_avg': packets_per_minute_avg,\n    'packets_per_minute_max': packets_per_minute_max,\n    'packets_per_minute_min': packets_per_minute_min,\n    'total_bytes': total_bytes,\n    'avg_packet_size': avg_packet_size,\n    'min_packet_size': min_packet_size,\n    'max_packet_size': max_packet_size,\n    'dst_port_entropy': dst_port_entropy,\n    'src_port_entropy': src_port_entropy,\n    'src_ip_entropy': src_ip_entropy,\n    'dst_ip_entropy': dst_ip_entropy,\n    'unique_dst_ports': unique_dst_ports,\n    'unique_src_ports': unique_src_ports,\n    'num_nodes': num_nodes,\n    'num_edges': num_edges,\n    'network_density': network_density,\n    'max_indegree': max_indegree,\n    'max_outdegree': max_outdegree,\n    'iat_mean': iat_mean,\n    'iat_variance': iat_variance,\n    'iat_cv': iat_cv,\n    'num_producers': num_producers,\n    'num_consumers': num_consumers,\n    'unique_flows': unique_flows,\n    'bidirectional_flows': bidirectional_flows,\n    'tcp_flows': tcp_flows,\n    'udp_flows': udp_flows,\n    'is_traffic_benign': str(is_traffic_benign).lower(),\n    'has_port_scan': str(has_port_scan).lower(),\n    'has_dos_pattern': str(has_dos_pattern).lower(),\n    'has_beaconing': str(has_beaconing).lower(),\n}\nimport json\nwith open('/root/metrics.json','w') as f:\n    json.dump(metrics,f,indent=2)\nprint('done')\nPY\n"]
