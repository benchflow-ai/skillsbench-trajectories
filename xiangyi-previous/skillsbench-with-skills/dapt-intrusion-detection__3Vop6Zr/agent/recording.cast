[160.959118, "o", "\u001b[?2004h> "]
[160.95916, "o", "unique_flows = len(flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.959248, "o", "tcp_flows = len(tcp_flow_keys)\r\n\u001b[?2004l\r"]
[160.959293, "o", "\u001b[?2004h> "]
[160.959358, "o", "udp_flows = len(udp_flow_keys)\r\n\u001b[?2004l\r"]
[160.959402, "o", "\u001b[?2004h> "]
[160.959452, "o", "flow_set = set(flow_keys)\r\n\u001b[?2004l\r"]
[160.959498, "o", "\u001b[?2004h> "]
[160.959541, "o", "bidirectional_flows = 0\r\n\u001b[?2004l\r"]
[160.959595, "o", "\u001b[?2004h> "]
[160.959632, "o", "for key in flow_keys:\r\n\u001b[?2004l\r"]
[160.959676, "o", "\u001b[?2004h> "]
[160.959765, "o", "    src, dst, sport, dport, proto = key\r\n\u001b[?2004l\r"]
[160.959812, "o", "\u001b[?2004h> "]
