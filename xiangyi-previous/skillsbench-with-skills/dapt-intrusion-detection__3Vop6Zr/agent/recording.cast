[96.756478, "o", "    'max_packet_size': max_packet_size,\r\n\u001b[?2004l\r"]
[96.75653, "o", "\u001b[?2004h> "]
[96.756613, "o", "    'dst_port_entropy': dst_port_entropy,\r\n\u001b[?2004l\r"]
[96.75666, "o", "\u001b[?2004h> "]
