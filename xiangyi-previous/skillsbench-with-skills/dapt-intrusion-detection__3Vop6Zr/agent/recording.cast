[63.340444, "i", "python3 - <<'PY'\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\nimport math, statistics\nfrom collections import Counter, defaultdict\npcap = rdpcap('/root/packets.pcap')\n\n# Basic lists\nlengths = [len(pkt) for pkt in pcap]\ntimestamps = [pkt.time for pkt in pcap]\n\n# Protocol counts\nprotocol_tcp = protocol_udp = protocol_icmp = protocol_arp = 0\nprotocol_ip_total = 0\n\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\n\n# graph edges\nedges = set()\n\n# bytes per IP\nbytes_sent = defaultdict(int)\nbytes_recv = defaultdict(int)\n\n# flow keys\nflow_keys = set()\ntcp_flow_keys = set()\nudp_flow_keys = set()\n\nfor pkt in pcap:\n    if IP in pkt:\n        protocol_ip_total += 1\n        ip = pkt[IP]\n        src_ips.append(ip.src)\n        dst_ips.append(ip.dst)\n        edges.add((ip.src, ip.dst))\n        bytes_sent[ip.src] += len(pkt)\n        bytes_recv[ip.dst] += len(pkt)\n        if TCP in pkt:\n            protocol_tcp += 1\n            tcp = pkt[TCP]\n            src_ports.append(tcp.sport)\n            dst_ports.append(tcp.dport)\n            key = (ip.src, ip.dst, tcp.sport, tcp.dport, 'TCP')\n            flow_keys.add(key)\n            tcp_flow_keys.add(key)\n        elif UDP in pkt:\n            protocol_udp += 1\n            udp = pkt[UDP]\n            src_ports.append(udp.sport)\n            dst_ports.append(udp.dport)\n            key = (ip.src, ip.dst, udp.sport, udp.dport, 'UDP')\n            flow_keys.add(key)\n            udp_flow_keys.add(key)\n        elif ICMP in pkt:\n            protocol_icmp += 1\n    elif ARP in pkt:\n        protocol_arp += 1\n\n# duration\nduration_seconds = max(timestamps) - min(timestamps) if timestamps else 0\n\n# packets per minute buckets\nif timestamps:\n    first = min(timestamps)\n    buckets = defaultdict(int)\n    for t in timestamps:\n        bucket = int((t - first) // 60)\n        buckets[bucket] += 1\n    counts = list(buckets.values())\n    packets_per_minute_avg = sum(counts) / len(counts)\n    packets_per_minute_max = max(counts)\n    packets_per_minute_min = min(counts)\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\n# size stats\ntotal_bytes = sum(lengths)\navg_packet_size = sum(lengths) / len(lengths) if lengths else 0\nmin_packet_size = min(lengths) if lengths else 0\nmax_packet_size = max(lengths) if lengths else 0\n\n# entropy function\n\ndef shannon_entropy(values):\n    if not values:\n        return 0\n    c = Counter(values)\n    total = sum(c.values())\n    ent = 0.0\n    for count in c.values():\n        p = count / total\n        ent -= p * math.log2(p)\n    return ent\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\n# graph metrics\nnodes = set(src_ips) | set(dst_ips)\nnum_nodes = len(nodes)\nnum_edges = len(edges)\nnetwork_density = (num_edges / (num_nodes * (num_nodes - 1))) if num_nodes > 1 else 0\n\n# indegree/outdegree\noutdegree = defaultdict(set)\nindegree = defaultdict(set)\nfor s,d in edges:\n    outdegree[s].add(d)\n    indegree[d].add(s)\nmax_outdegree = max((len(v) for v in outdegree.values()), default=0)\nmax_indegree = max((len(v) for v in indegree.values()), default=0)\n\n# IAT stats\nif len(timestamps) > 1:\n    ts_sorted = sorted(timestamps)\n    iats = [ts_sorted[i+1] - ts_sorted[i] for i in range(len(ts_sorted)-1)]\n    iat_mean = sum(iats) / len(iats)\n    # population variance\n    iat_variance = sum((x-iat_mean)**2 for x in iats) / len(iats)\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = iat_std / iat_mean if iat_mean != 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\n# producer/consumer\nnum_producers = num_consumers = 0\nfor ip in nodes:\n    sent = bytes_sent[ip]\n    recv = bytes_recv[ip]\n    denom = sent + recv\n    if denom == 0:\n        continue\n    pcr = (sent - recv) / denom\n    if pcr > 0.2:\n        num_producers += 1\n    elif pcr < -0.2:\n        num_consumers += 1\n\n# flows\nunique_flows = len(flow_keys)\ntcp_flows = len(tcp_flow_keys)\nudp_flows = len(ud"]
[63.340504, "i", "p_flow_keys)\n# bidirectional flows\nflow_set = set(flow_keys)\nbidirectional_flows = 0\nfor key in flow_keys:\n    src, dst, sport, dport, proto = key\n    rev = (dst, src, dport, sport, proto)\n    if rev in flow_set:\n        bidirectional_flows += 1\n\n# analysis flags (basic heuristics)\n# define simple thresholds\nhas_port_scan = max_outdegree > 50 and unique_dst_ports > 50\nhas_dos_pattern = packets_per_minute_max > packets_per_minute_avg * 10 if packets_per_minute_avg>0 else False\n# beaconing: low variance of IAT and at least some traffic\nhas_beaconing = (iat_mean > 0 and iat_variance < (iat_mean * 0.1)**2)\n# benign if no flags\nis_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\n\nmetrics = {\n    'protocol_tcp': protocol_tcp,\n    'protocol_udp': protocol_udp,\n    'protocol_icmp': protocol_icmp,\n    'protocol_arp': protocol_arp,\n    'protocol_ip_total': protocol_ip_total,\n    'duration_seconds': duration_seconds,\n    'packets_per_minute_avg': packets_per_minute_avg,\n    'packets_per_minute_max': packets_per_minute_max,\n    'packets_per_minute_min': packets_per_minute_min,\n    'total_bytes': total_bytes,\n    'avg_packet_size': avg_packet_size,\n    'min_packet_size': min_packet_size,\n    'max_packet_size': max_packet_size,\n    'dst_port_entropy': dst_port_entropy,\n    'src_port_entropy': src_port_entropy,\n    'src_ip_entropy': src_ip_entropy,\n    'dst_ip_entropy': dst_ip_entropy,\n    'unique_dst_ports': unique_dst_ports,\n    'unique_src_ports': unique_src_ports,\n    'num_nodes': num_nodes,\n    'num_edges': num_edges,\n    'network_density': network_density,\n    'max_indegree': max_indegree,\n    'max_outdegree': max_outdegree,\n    'iat_mean': iat_mean,\n    'iat_variance': iat_variance,\n    'iat_cv': iat_cv,\n    'num_producers': num_producers,\n    'num_consumers': num_consumers,\n    'unique_flows': unique_flows,\n    'bidirectional_flows': bidirectional_flows,\n    'tcp_flows': tcp_flows,\n    'udp_flows': udp_flows,\n    'is_traffic_benign': str(is_traffic_benign).lower(),\n    'has_port_scan': str(has_port_scan).lower(),\n    'has_dos_pattern': str(has_dos_pattern).lower(),\n    'has_beaconing': str(has_beaconing).lower(),\n}\n\nfor k,v in metrics.items():\n    print(k, v)\nPY\n"]
