[160.964664, "o", "\u001b[?2004h> "]
[160.96474, "o", "    'num_producers': num_producers,\r\n\u001b[?2004l\r"]
[160.964785, "o", "\u001b[?2004h> "]
[160.964855, "o", "    'num_consumers': num_consumers,\r\n\u001b[?2004l\r"]
[160.964901, "o", "\u001b[?2004h> "]
[160.964975, "o", "    'unique_flows': unique_flows,\r\n\u001b[?2004l\r"]
[160.965021, "o", "\u001b[?2004h> "]
