[194.920165, "o", "\u001b[?2004hroot@cc07442f401c:~# cat /root/metrics.json\r\n\u001b[?2004l\r"]
[194.92117, "o", "{\r\n  \"protocol_tcp\": 32620,\r\n  \"protocol_udp\": 25846,\r\n  \"protocol_icmp\": 8,\r\n  \"protocol_arp\": 54938,\r\n  \"protocol_ip_total\": 58474,\r\n  \"duration_seconds\": 26030.33075594902,\r\n  \"packets_per_minute_avg\": 262.9009216589862,\r\n  \"packets_per_minute_max\": 2372,\r\n  \"packets_per_minute_min\": 186,\r\n  \"total_bytes\": 30889470,\r\n  \"avg_packet_size\": 270.7251597297084,\r\n  \"min_packet_size\": 42,\r\n  \"max_packet_size\": 56538,\r\n  \"dst_port_entropy\": 4.2811152557544006,\r\n  \"src_port_entropy\": 4.339615103245355,\r\n  \"src_ip_entropy\": 2.483323397319809,\r\n  \"dst_ip_entropy\": 2.46176185712535,\r\n  \"unique_dst_ports\": 1675,\r\n  \"unique_src_ports\": 1713,\r\n  \"num_nodes\": 38,\r\n  \"num_edges\": 58,\r\n  \"network_density\": 0.041251778093883355,\r\n  \"max_indegree\": 23,\r\n  \"max_outdegree\": 27,\r\n  \"iat_mean\": 0.2281401142522132,\r\n  \"iat_variance\": 0.06328160807943833,\r\n  \"iat_cv\": 1.1026485193832714,\r\n  \"num_producers\": 23,\r\n  \"num_consumers\": 13,\r\n  \"unique_flows\": 3567,\r\n  \"bidirectional_flows\": 3516,\r\n  \"tcp_flows\": 3353,\r\n  \"udp_flows\": 214,\r\n  \"is_traffic_benign\": \"true\",\r\n  \"has_port_scan\": \"false\",\r\n  \"has_dos_pattern\": \"false\",\r\n  \"has_beaconing\": \"false\"\r\n}"]
[194.937189, "o", "\u001b[?2004hroot@cc07442f401c:~# "]
[202.198475, "i", "cat > /tmp/compute.py <<'PY'\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\nimport math\nfrom collections import Counter, defaultdict\nimport json\n\npcap = rdpcap('/root/packets.pcap')\nlengths = [int(len(pkt)) for pkt in pcap]\ntimestamps = [float(pkt.time) for pkt in pcap]\n\nprotocol_tcp = protocol_udp = protocol_icmp = protocol_arp = 0\nprotocol_ip_total = 0\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\nedges = set()\nbytes_sent = defaultdict(int)\nbytes_recv = defaultdict(int)\nflow_keys = set(); tcp_flow_keys = set(); udp_flow_keys = set()\n\nfor pkt in pcap:\n    if IP in pkt:\n        protocol_ip_total += 1\n        ip = pkt[IP]\n        src_ips.append(ip.src); dst_ips.append(ip.dst)\n        edges.add((ip.src, ip.dst))\n        bytes_sent[ip.src] += len(pkt)\n        bytes_recv[ip.dst] += len(pkt)\n        if TCP in pkt:\n            protocol_tcp += 1\n            tcp = pkt[TCP]\n            src_ports.append(int(tcp.sport)); dst_ports.append(int(tcp.dport))\n            key = (ip.src, ip.dst, int(tcp.sport), int(tcp.dport), 'TCP')\n            flow_keys.add(key); tcp_flow_keys.add(key)\n        elif UDP in pkt:\n            protocol_udp += 1\n            udp = pkt[UDP]\n            src_ports.append(int(udp.sport)); dst_ports.append(int(udp.dport))\n            key = (ip.src, ip.dst, int(udp.sport), int(udp.dport), 'UDP')\n            flow_keys.add(key); udp_flow_keys.add(key)\n        elif ICMP in pkt:\n            protocol_icmp += 1\n    elif ARP in pkt:\n        protocol_arp += 1\n\n# duration\nif timestamps:\n    duration_seconds = float(max(timestamps) - min(timestamps))\nelse:\n    duration_seconds = 0.0\n\n# packets per minute buckets\nif timestamps:\n    first = min(timestamps)\n    buckets = defaultdict(int)\n    for t in timestamps:\n        bucket = int((float(t) - float(first)) // 60)\n        buckets[bucket] += 1\n    counts = list(buckets.values())\n    packets_per_minute_avg = float(sum(counts) / len(counts))\n    packets_per_minute_max = max(counts)\n    packets_per_minute_min = min(counts)\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\n# size stats\ntotal_bytes = sum(lengths)\navg_packet_size = float(sum(lengths) / len(lengths)) if lengths else 0\nmin_packet_size = min(lengths) if lengths else 0\nmax_packet_size = max(lengths) if lengths else 0\n\n# entropy\ndef shannon_entropy(values):\n    if not values:\n        return 0.0\n    c = Counter(values)\n    total = sum(c.values())\n    ent = 0.0\n    for count in c.values():\n        p = count / total\n        ent -= p * math.log2(p)\n    return ent\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\n# graph\nnodes = set(src_ips) | set(dst_ips)\nnum_nodes = len(nodes)\nnum_edges = len(edges)\nnetwork_density = (num_edges / (num_nodes * (num_nodes - 1))) if num_nodes > 1 else 0\noutdegree = defaultdict(set)\nindegree = defaultdict(set)\nfor s,d in edges:\n    outdegree[s].add(d)\n    indegree[d].add(s)\nmax_outdegree = max((len(v) for v in outdegree.values()), default=0)\nmax_indegree = max((len(v) for v in indegree.values()), default=0)\n\n# IAT\nif len(timestamps) > 1:\n    ts_sorted = sorted(timestamps)\n    iats = [float(ts_sorted[i+1] - ts_sorted[i]) for i in range(len(ts_sorted)-1)]\n    iat_mean = float(sum(iats) / len(iats))\n    iat_variance = float(sum((x-iat_mean)**2 for x in iats) / len(iats))\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = float(iat_std / iat_mean) if iat_mean != 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\n# producer/consumer\nnum_producers = num_consumers = 0\nfor ip in nodes:\n    sent = bytes_sent[ip]; recv = bytes_recv[ip]\n    denom = sent + recv\n    if denom == 0:\n        continue\n    pcr = (sent - recv) / denom\n    if pcr > 0.2:\n        num_producers += 1\n    elif pcr < -0.2:\n        num_consumers += 1\n\n# flows\nunique_flows = len(flow_keys)\ntcp_flows = len(tcp_flow_keys)\nudp_flows = len(udp_flow_keys)\nflow_set = set(flow_keys)\nbi"]
[202.198643, "i", "directional_flows = 0\nfor key in flow_keys:\n    src, dst, sport, dport, proto = key\n    rev = (dst, src, dport, sport, proto)\n    if rev in flow_set:\n        bidirectional_flows += 1\n\n# analysis flags\nhas_port_scan = max_outdegree > 50 and unique_dst_ports > 50\nhas_dos_pattern = packets_per_minute_max > packets_per_minute_avg * 10 if packets_per_minute_avg>0 else False\nhas_beaconing = (iat_mean > 0 and iat_variance < (iat_mean * 0.1)**2)\nis_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\n\nmetrics = {\n    'protocol_tcp': protocol_tcp,\n    'protocol_udp': protocol_udp,\n    'protocol_icmp': protocol_icmp,\n    'protocol_arp': protocol_arp,\n    'protocol_ip_total': protocol_ip_total,\n    'duration_seconds': duration_seconds,\n    'packets_per_minute_avg': packets_per_minute_avg,\n    'packets_per_minute_max': packets_per_minute_max,\n    'packets_per_minute_min': packets_per_minute_min,\n    'total_bytes': total_bytes,\n    'avg_packet_size': avg_packet_size,\n    'min_packet_size': min_packet_size,\n    'max_packet_size': max_packet_size,\n    'dst_port_entropy': dst_port_entropy,\n    'src_port_entropy': src_port_entropy,\n    'src_ip_entropy': src_ip_entropy,\n    'dst_ip_entropy': dst_ip_entropy,\n    'unique_dst_ports': unique_dst_ports,\n    'unique_src_ports': unique_src_ports,\n    'num_nodes': num_nodes,\n    'num_edges': num_edges,\n    'network_density': network_density,\n    'max_indegree': max_indegree,\n    'max_outdegree': max_outdegree,\n    'iat_mean': iat_mean,\n    'iat_variance': iat_variance,\n    'iat_cv': iat_cv,\n    'num_producers': num_producers,\n    'num_consumers': num_consumers,\n    'unique_flows': unique_flows,\n    'bidirectional_flows': bidirectional_flows,\n    'tcp_flows': tcp_flows,\n    'udp_flows': udp_flows,\n    'is_traffic_benign': str(is_traffic_benign).lower(),\n    'has_port_scan': str(has_port_scan).lower(),\n    'has_dos_pattern': str(has_dos_pattern).lower(),\n    'has_beaconing': str(has_beaconing).lower(),\n}\n\nwith open('/root/metrics.json','w') as f:\n    json.dump(metrics,f,indent=2)\nprint('done')\nPY\n"]
[202.198941, "o", "cat > /tmp/compute.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.199065, "o", "from scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\r\n\u001b[?2004l\rkey\u001b[?2004h> "]
[202.199136, "o", "import math\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[202.199204, "o", "from collections import Counter, defaultdict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.199275, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[202.199358, "o", "pcap = rdpcap('/root/packets.pcap')\r\n\u001b[?2004l\r"]
[202.19944, "o", "\u001b[?2004h> "]
[202.199525, "o", "lengths = [int(len(pkt)) for pkt in pcap]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.199655, "o", "timestamps = [float(pkt.time) for pkt in pcap]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h"]
[202.199716, "o", "> "]
[202.199858, "o", "protocol_tcp = protocol_udp = protocol_icmp = protocol_arp = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.199912, "o", "protocol_ip_total = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.199945, "o", "src_ips = []\r\n\u001b[?2004l\r"]
[202.199994, "o", "\u001b[?2004h> "]
[202.200035, "o", "dst_ips = []\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[202.200083, "o", "src_ports = []\r\n\u001b[?2004l\r"]
[202.200105, "o", "\u001b[?2004h> "]
[202.200151, "o", "dst_ports = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.200217, "o", "> "]
[202.200266, "o", "edges = set()\r\n\u001b[?2004l\r"]
[202.200315, "o", "\u001b[?2004h> "]
[202.200412, "o", "bytes_sent = defaultdict(int)\r\n\u001b[?2004l\r"]
[202.200452, "o", "\u001b[?2004h> "]
[202.200563, "o", "bytes_recv = defaultdict(int)\r\n\u001b[?2004l\r"]
[202.200614, "o", "\u001b[?2004h> "]
[202.20076, "o", "flow_keys = set(); tcp_flow_keys = set(); udp_flow_keys = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.200809, "o", "> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[202.200873, "o", "for pkt in pcap:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20093, "o", "    if IP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.201016, "o", "        protocol_ip_total += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.201079, "o", "> "]
[202.201156, "o", "        ip = pkt[IP]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.201284, "o", "        src_ips.append(ip.src); dst_ips.append(ip.dst)\r\n\u001b[?2004l\r"]
[202.201347, "o", "\u001b[?2004h> "]
[202.201404, "o", "        edges.add((ip.src, ip.dst))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.201454, "o", "> "]
[202.20152, "o", "        bytes_sent[ip.src] += len(pkt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.201571, "o", "> "]
[202.20164, "o", "        bytes_recv[ip.dst] += len(pkt)\r\n\u001b[?2004l\rp\u001b[?2004h"]
[202.201701, "o", "> "]
[202.201762, "o", "        if TCP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.201812, "o", "            protocol_tcp += 1\r\n\u001b[?2004l\r"]
[202.201838, "o", "\u001b[?2004h> "]
[202.201879, "o", "            tcp = pkt[TCP]\r\n\u001b[?2004l\r"]
[202.201931, "o", "\u001b[?2004h> "]
[202.202114, "o", "            src_ports.append(int(tcp.sport)); dst_ports.append(int(tcp.dport))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.202164, "o", "> "]
[202.202325, "o", "            key = (ip.src, ip.dst, int(tcp.sport), int(tcp.dport), 'TCP')\r\n\u001b[?2004l\r"]
[202.202376, "o", "\u001b[?2004h> "]
[202.202488, "o", "            flow_keys.add(key); tcp_flow_keys.add(key)\r\n\u001b[?2004l\r"]
[202.202536, "o", "\u001b[?2004h> "]
[202.202582, "o", "        elif UDP in pkt:\r\n\u001b[?2004l\r"]
[202.202634, "o", "\u001b[?2004h> "]
[202.202668, "o", "            protocol_udp += 1\r\n\u001b[?2004l\r"]
[202.202693, "o", "\u001b[?2004h> "]
[202.202767, "o", "            udp = pkt[UDP]\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.202793, "o", "> "]
[202.202986, "o", "            src_ports.append(int(udp.sport)); dst_ports.append(int(udp.dport))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.203035, "o", "> "]
[202.203191, "o", "            key = (ip.src, ip.dst, int(udp.sport), int(udp.dport), 'UDP')\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.203214, "o", "> "]
[202.203359, "o", "            flow_keys.add(key); udp_flow_keys.add(key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.203408, "o", "> "]
[202.203467, "o", "        elif ICMP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.203492, "o", "> "]
[202.203564, "o", "            protocol_icmp += 1\r\n\u001b[?2004l\r"]
[202.203622, "o", "\u001b[?2004h> "]
[202.203678, "o", "    elif ARP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.203729, "o", "        protocol_arp += 1\r\n\u001b[?2004l\r"]
[202.203785, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[202.203842, "o", "# duration\r\n\u001b[?2004l\r \u001b[?2004h> "]
[202.203903, "o", "if timestamps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20402, "o", "    duration_seconds = float(max(timestamps) - min(timestamps))\r\n\u001b[?2004l\r"]
[202.20408, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.204147, "o", "    duration_seconds = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.204198, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[202.204258, "o", "# packets per minute buckets\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.204304, "o", "> if timestamps:\r\n\u001b[?2004l\r"]
[202.20433, "o", "\u001b[?2004h> "]
[202.204414, "o", "    first = min(timestamps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.204436, "o", "> "]
[202.204509, "o", "    buckets = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.204557, "o", "> "]
[202.204598, "o", "    for t in timestamps:\r\n\u001b[?2004l\r"]
[202.204652, "o", "\u001b[?2004h> "]
[202.204761, "o", "        bucket = int((float(t) - float(first)) // 60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.20483, "o", "> "]
[202.204893, "o", "        buckets[bucket] += 1\r\n\u001b[?2004l\r'\u001b[?2004h> "]
[202.204963, "o", "    counts = list(buckets.values())\r\n\u001b[?2004l\r"]
[202.205011, "o", "\u001b[?2004h> "]
[202.205168, "o", "    packets_per_minute_avg = float(sum(counts) / len(counts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.205194, "o", "> "]
[202.205292, "o", "    packets_per_minute_max = max(counts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.205406, "o", "    packets_per_minute_min = min(counts)\r\n\u001b[?2004l\r,\u001b[?2004h"]
[202.205459, "o", "> else:\r\n\u001b[?2004l\r"]
[202.205498, "o", "\u001b[?2004h> "]
[202.205637, "o", "    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.205686, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.205731, "o", "# size stats\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.205776, "o", "total_bytes = sum(lengths)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.205879, "o", "avg_packet_size = float(sum(lengths) / len(lengths)) if lengths else 0\r\n\u001b[?2004l\r"]
[202.205926, "o", "\u001b[?2004h> "]
[202.205976, "o", "min_packet_size = min(lengths) if lengths else 0\r\n\u001b[?2004l\r"]
[202.206021, "o", "\u001b[?2004h> "]
[202.206073, "o", "max_packet_size = max(lengths) if lengths else 0\r\n\u001b[?2004l\r"]
[202.206118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # entropy\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.206163, "o", "> "]
[202.206206, "o", "def shannon_entropy(values):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20625, "o", "    if not values:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206288, "o", "        return 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206349, "o", "    c = Counter(values)\r\n\u001b[?2004l\r"]
[202.206379, "o", "\u001b[?2004h> "]
[202.206407, "o", "    total = sum(c.values())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20646, "o", "    ent = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.206508, "o", "> "]
[202.206562, "o", "    for count in c.values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206611, "o", "        p = count / total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206647, "o", "        ent -= p * math.log2(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20673, "o", "    return ent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206784, "o", "src_ip_entropy = shannon_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.206833, "o", "> "]
[202.206889, "o", "dst_ip_entropy = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.206972, "o", "src_port_entropy = shannon_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207053, "o", "dst_port_entropy = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207109, "o", "unique_src_ports = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.207169, "o", "> unique_dst_ports = len(set(dst_ports))\r\n\u001b[?2004l\r"]
[202.207237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # graph\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207302, "o", "nodes = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.207373, "o", "> num_nodes = len(nodes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207439, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207557, "o", "network_density = (num_edges / (num_nodes * (num_nodes - 1))) if num_nodes > 1 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207629, "o", "outdegree = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.20768, "o", "indegree = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207746, "o", "for s,d in edges:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207796, "o", "    outdegree[s].add(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207853, "o", "    indegree[d].add(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.207921, "o", "max_outdegree = max((len(v) for v in outdegree.values()), default=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.207971, "o", "> "]
[202.208034, "o", "max_indegree = max((len(v) for v in indegree.values()), default=0)\r\n\u001b[?2004l\r"]
[202.208083, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # IAT\r\n\u001b[?2004l\r"]
[202.208126, "o", "\u001b[?2004h> "]
[202.20819, "o", "if len(timestamps) > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208248, "o", "    ts_sorted = sorted(timestamps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208381, "o", "    iats = [float(ts_sorted[i+1] - ts_sorted[i]) for i in range(len(ts_sorted)-1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208443, "o", "    iat_mean = float(sum(iats) / len(iats))\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.208492, "o", "> "]
[202.208567, "o", "    iat_variance = float(sum((x-iat_mean)**2 for x in iats) / len(iats))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208631, "o", "    iat_std = math.sqrt(iat_variance)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.208679, "o", "> "]
[202.208756, "o", "    iat_cv = float(iat_std / iat_mean) if iat_mean != 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208819, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208892, "o", "    iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[202.208956, "o", "> # producer/consumer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.208997, "o", "num_producers = num_consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209039, "o", "for ip in nodes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209133, "o", "    sent = bytes_sent[ip]; recv = bytes_recv[ip]\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.209187, "o", ">     denom = sent + recv\r\n\u001b[?2004l\r"]
[202.209234, "o", "\u001b[?2004h>     if denom == 0:\r\n\u001b[?2004l\r"]
[202.209279, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[202.209321, "o", "\u001b[?2004h> "]
[202.209374, "o", "    pcr = (sent - recv) / denom\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209416, "o", "    if pcr > 0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209457, "o", "        num_producers += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209517, "o", "    elif pcr < -0.2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.209552, "o", ">         num_consumers += 1\r\n\u001b[?2004l\r"]
[202.2096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[202.209649, "o", "> # flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209693, "o", "unique_flows = len(flow_keys)\r\n\u001b[?2004l\r"]
[202.209717, "o", "\u001b[?2004h> "]
[202.209765, "o", "tcp_flows = len(tcp_flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.209812, "o", "> "]
[202.20985, "o", "udp_flows = len(udp_flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.2099, "o", "flow_set = set(flow_keys)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209949, "o", "bidirectional_flows = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.209995, "o", "for key in flow_keys:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210041, "o", "    src, dst, sport, dport, proto = key\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.210087, "o", "> "]
[202.210155, "o", "    rev = (dst, src, dport, sport, proto)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210202, "o", "    if rev in flow_set:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.210244, "o", "> "]
[202.210289, "o", "        bidirectional_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[202.210335, "o", "> # analysis flags\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.210381, "o", "> "]
[202.210443, "o", "has_port_scan = max_outdegree > 50 and unique_dst_ports > 50\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210618, "o", "has_dos_pattern = packets_per_minute_max > packets_per_minute_avg * 10 if packets_per_minute_avg>0 else False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210728, "o", "has_beaconing = (iat_mean > 0 and iat_variance < (iat_mean * 0.1)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210842, "o", "is_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\r\n\u001b[?2004l\r"]
[202.21089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210932, "o", "metrics = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210998, "o", "    'protocol_tcp': protocol_tcp,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211052, "o", "    'protocol_udp': protocol_udp,\r\n\u001b[?2004l\r"]
[202.211097, "o", "\u001b[?2004h> "]
[202.211138, "o", "    'protocol_icmp': protocol_icmp,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211191, "o", "    'protocol_arp': protocol_arp,\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.211232, "o", "> "]
[202.211284, "o", "    'protocol_ip_total': protocol_ip_total,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211339, "o", "    'duration_seconds': duration_seconds,\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.21139, "o", "> "]
[202.211441, "o", "    'packets_per_minute_avg': packets_per_minute_avg,\r\n\u001b[?2004l\r"]
[202.211488, "o", "\u001b[?2004h> "]
[202.211546, "o", "    'packets_per_minute_max': packets_per_minute_max,\r\n\u001b[?2004l\r"]
[202.211593, "o", "\u001b[?2004h> "]
[202.211648, "o", "    'packets_per_minute_min': packets_per_minute_min,\r\n\u001b[?2004l\r"]
[202.211688, "o", "\u001b[?2004h>     'total_bytes': total_bytes,\r\n\u001b[?2004l\r"]
[202.211736, "o", "\u001b[?2004h> "]
[202.211794, "o", "    'avg_packet_size': avg_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.211839, "o", "> "]
[202.211882, "o", "    'min_packet_size': min_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211945, "o", "    'max_packet_size': max_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.211988, "o", "> "]
[202.212042, "o", "    'dst_port_entropy': dst_port_entropy,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212106, "o", "    'src_port_entropy': src_port_entropy,\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.212141, "o", "> "]
[202.21219, "o", "    'src_ip_entropy': src_ip_entropy,\r\n\u001b[?2004l\r\u001b[?2004h> "]
