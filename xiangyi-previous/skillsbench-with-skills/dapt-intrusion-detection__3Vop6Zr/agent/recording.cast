[8.400757, "o", "metric,value\r\n# Protocol Distribution\r\nprotocol_tcp,\r\nprotocol_udp,\r\nprotocol_icmp,\r\nprotocol_arp,\r\nprotocol_ip_total,\r\n# Time Series\r\nduration_seconds,\r\npackets_per_minute_avg,\r\npackets_per_minute_max,\r\npackets_per_minute_min,\r\n# Size Statistics\r\ntotal_bytes,\r\navg_packet_size,\r\nmin_packet_size,\r\nmax_packet_size,\r\n# Entropy Metrics (Shannon entropy in bits)\r\ndst_port_entropy,\r\nsrc_port_entropy,\r\nsrc_ip_entropy,\r\ndst_ip_entropy,\r\nunique_dst_ports,\r\nunique_src_ports,\r\n# Graph/Topology Metrics\r\nnum_nodes,\r\nnum_edges,\r\nnetwork_density,\r\nmax_indegree,\r\nmax_outdegree,\r\n# Temporal Metrics\r\niat_mean,\r\niat_variance,\r\niat_cv,\r\nnum_producers,\r\nnum_consumers,\r\n# Flow Metrics\r\nunique_flows,\r\nbidirectional_flows,\r\ntcp_flows,\r\nudp_flows,\r\n"]
[8.400793, "o", "# Analysis Questions (true/false)\r\nis_traffic_benign,\r\nhas_port_scan,\r\nhas_dos_pattern,\r\nhas_beaconing,\r\n"]
