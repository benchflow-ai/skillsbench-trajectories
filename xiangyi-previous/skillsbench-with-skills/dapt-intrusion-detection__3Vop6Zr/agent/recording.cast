[96.751115, "o", "\u001b[?2004h> "]
[96.751184, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r"]
[96.751229, "o", "\u001b[?2004h> "]
[96.751427, "o", "    iat_variance = sum((x-iat_mean)**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.751497, "o", "    iat_std = math.sqrt(iat_variance)\r\n\u001b[?2004l\r"]
[96.751545, "o", "\u001b[?2004h> "]
[96.751654, "o", "    iat_cv = iat_std / iat_mean if iat_mean != 0 else 0\r\n\u001b[?2004l\r"]
[96.751705, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[96.751754, "o", "\u001b[?2004h> "]
[96.751808, "o", "    iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r"]
