[260.109736, "i", "cat <<'PY' > /root/workspace/solution.py\n#!/usr/bin/env python3\n\"\"\"Find top-k similar molecules using Morgan fingerprints and Tanimoto similarity.\"\"\"\nimport os\nimport json\nimport time\nimport urllib.parse\nimport urllib.request\nimport urllib.error\nfrom typing import List, Tuple, Optional\n\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem, DataStructs\nimport PyPDF2\n\n# Cache file for name->SMILES to avoid repeated HTTP calls\nCACHE_PATH = os.path.join(os.path.dirname(__file__), \"smiles_cache.json\")\n\n\ndef _load_cache() -> dict:\n    if os.path.exists(CACHE_PATH):\n        try:\n            with open(CACHE_PATH, \"r\") as f:\n                return json.load(f)\n        except Exception:\n            return {}\n    return {}\n\n\ndef _save_cache(cache: dict) -> None:\n    try:\n        with open(CACHE_PATH, \"w\") as f:\n            json.dump(cache, f)\n    except Exception:\n        pass\n\n\ndef _read_molecule_names(filepath: str) -> List[str]:\n    ext = os.path.splitext(filepath)[1].lower()\n    if ext == \".pdf\":\n        reader = P"]
[260.110039, "i", "yPDF2.PdfReader(filepath)\n        text = \"\\n\".join((p.extract_text() or \"\") for p in reader.pages)\n        lines = [ln.strip() for ln in text.splitlines() if ln.strip()]\n    else:\n        with open(filepath, \"r\") as f:\n            lines = [ln.strip() for ln in f if ln.strip()]\n    # Remove duplicates while preserving order\n    seen = set()\n    names = []\n    for ln in lines:\n        if ln not in seen:\n            names.append(ln)\n            seen.add(ln)\n    return names\n\n\ndef _query_cactus_smiles(name: str, retries: int = 3, sleep: float = 1.0) -> Optional[str]:\n    \"\"\"Query NCI CACTUS for SMILES.\"\"\"\n    url = f\"https://cactus.nci.nih.gov/chemical/structure/{urllib.parse.quote(name)}/smiles\"\n    for i in range(retries):\n        try:\n            with urllib.request.urlopen(url, timeout=10) as f:\n                txt = f.read().decode().strip()\n            if not txt or txt.lower().startswith(\"error\"):\n                return None\n            # CACTUS may return multi-line results\n            return txt.splitlin"]
[260.110196, "o", "cat <<'PY' > /root/workspace/solution.py\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.110238, "i", "es()[0].strip()\n        except Exception:\n            if i == retries - 1:\n                return None\n            time.sleep(sleep)\n    return None\n\n\ndef _query_pubchem_smiles(name: str, retries: int = 2, sleep: float = 1.0) -> Optional[str]:\n    \"\"\"Query PubChem for SMILES (fallback).\"\"\"\n    url = (\n        \"https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/\"\n        f\"{urllib.parse.quote(name)}/property/IsomericSMILES,CanonicalSMILES/JSON\"\n    )\n    for i in range(retries):\n        try:\n            with urllib.request.urlopen(url, timeout=10) as f:\n                data = json.load(f)\n            props = data.get(\"PropertyTable\", {}).get(\"Properties\", [])\n            if not props:\n                return None\n            entry = props[0]\n            return entry.get(\"IsomericSMILES\") or entry.get(\"CanonicalSMILES\")\n        except Exception:\n            if i == retries - 1:\n                return None\n            time.sleep(sleep)\n    return None\n\n\ndef _get_smiles(name: str, cache: dict) -> Optional[str"]
[260.110465, "o", "\"\"\"Find top-k similar molecules using Morgan fingerprints and Tanimoto similarity.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.parse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.110603, "i", "]:\n    if name in cache:\n        return cache[name]\n    smiles = _query_cactus_smiles(name)\n    if not smiles:\n        smiles = _query_pubchem_smiles(name)\n    if smiles:\n        cache[name] = smiles\n    return smiles\n\n\ndef _fingerprint_from_smiles(smiles: str):\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return None\n    return AllChem.GetMorganFingerprintAsBitVect(mol, radius=2, nBits=2048, useChirality=True)\n\n\ndef topk_tanimoto_similarity_molecules(\n    target_molecule_name: str,\n    molecule_pool_filepath: str,\n    top_k: int,\n) -> List[Tuple[str, float]]:\n    \"\"\"Return top-k most similar molecules (name, similarity) from a pool.\n\n    Uses Morgan fingerprints (radius=2, include chirality) and Tanimoto similarity.\n    Results are sorted by similarity descending and name ascending for ties.\n    \"\"\"\n    names = _read_molecule_names(molecule_pool_filepath)\n    cache = _load_cache()\n\n    target_smiles = _get_smiles(target_molecule_name, cache)\n    if not target_smiles:\n        raise ValueEr"]
[260.110733, "o", "import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.111161, "i", "ror(f\"Could not resolve SMILES for target molecule: {target_molecule_name}\")\n    target_fp = _fingerprint_from_smiles(target_smiles)\n    if target_fp is None:\n        raise ValueError(f\"Invalid SMILES for target molecule: {target_smiles}\")\n\n    results: List[Tuple[str, float]] = []\n    for name in names:\n        smiles = _get_smiles(name, cache)\n        if not smiles:\n            continue\n        fp = _fingerprint_from_smiles(smiles)\n        if fp is None:\n            continue\n        sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n        results.append((name, float(sim)))\n\n    # Save cache for future use\n    _save_cache(cache)\n\n    # Sort by similarity desc, then name asc\n    results.sort(key=lambda x: (-x[1], x[0]))\n    return results[: int(top_k)]\n\n\nif __name__ == \"__main__\":\n    import argparse\n\n    parser = argparse.ArgumentParser(description=\"Compute top-k similar molecules from a pool.\")\n    parser.add_argument(\"target\", help=\"Target molecule name\")\n    parser.add_argument(\"pool\", help=\"Path to mo"]
[260.111308, "o", "from typing import List, Tuple, Optional\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rror(f\"Could not resolve SMILES for target molecule: {target_molecule_name}\")\r\n    target_fp = _fingerprint_from_smiles(target_smiles)\r\n    if target_fp is None:\r\n        raise ValueError(f\"Invalid SMILES for target molecule: {target_smiles}\")\r\n\r\n    results: List[Tuple[str, float]] = []\r\n    \u001b[?2004h> from rdkit import Chem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.111384, "i", "lecule pool (PDF or text)\")\n    parser.add_argument(\"-k\", \"--top_k\", type=int, default=5, help=\"Number of top results\")\n    args = parser.parse_args()\n\n    results = topk_tanimoto_similarity_molecules(args.target, args.pool, args.top_k)\n    for name, sim in results:\n        print(f\"{name}\\t{sim:.4f}\")\nPY\n"]
