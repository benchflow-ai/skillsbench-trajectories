[260.120452, "o", "\u001b[?2004h> "]
[260.120502, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[260.12053, "o", "\u001b[?2004h> "]
[260.120623, "o", "            if i == retries - 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.120675, "o", "                return None\r\n\u001b[?2004l\r"]
[260.120708, "o", "\u001b[?2004h> "]
[260.1208, "o", "            time.sleep(sleep)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.120836, "o", "    return None\r\n\u001b[?2004l\r"]
[260.120871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.120896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.120919, "o", "\u001b[?2004h> "]
[260.121099, "o", "def _query_pubchem_smiles(name: str, retries: int = 2, sleep: float = 1.0) -> Optional[str]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.121109, "o", "> "]
[260.121257, "o", "    \"\"\"Query PubChem for SMILES (fallback).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.121294, "o", "    url = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.121449, "o", "        \"https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.121605, "o", "        f\"{urllib.parse.quote(name)}/property/IsomericSMILES,CanonicalSMILES/JSON\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.121616, "o", "    )\r\n\u001b[?2004l\r"]
[260.121654, "o", "\u001b[?2004h> "]
[260.121709, "o", "    for i in range(retries):\r\n"]
[260.121735, "o", "\u001b[?2004l\r"]
[260.121758, "o", "\u001b[?2004h> "]
[260.121779, "o", "        try:\r\n\u001b[?2004l\r"]
[260.121802, "o", "\u001b[?2004h> "]
[260.121937, "o", "            with urllib.request.urlopen(url, timeout=10) as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.121947, "o", "> "]
[260.122037, "o", "                data = json.load(f)\r\n\u001b[?2004l\r"]
[260.122045, "o", "\u001b[?2004h> "]
[260.122192, "o", "            props = data.get(\"PropertyTable\", {}).get(\"Properties\", [])\r\n\u001b[?2004l\r"]
[260.122219, "o", "\u001b[?2004h> "]
[260.122269, "o", "            if not props:\r\n\u001b[?2004l\r"]
[260.122305, "o", "\u001b[?2004h> "]
[260.122373, "o", "                return None\r\n\u001b[?2004l\r"]
[260.122398, "o", "\u001b[?2004h> "]
[260.122468, "o", "            entry = props[0]\r\n\u001b[?2004l\r"]
[260.122487, "o", "\u001b[?2004h"]
[260.122514, "o", "> "]
[260.122661, "o", "            return entry.get(\"IsomericSMILES\") or entry.get(\"CanonicalSMILES\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.122681, "o", "> "]
[260.122732, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[260.122752, "o", "\u001b[?2004h"]
[260.122773, "o", "> "]
[260.122847, "o", "            if i == retries - 1:\r\n\u001b[?2004l\r"]
[260.122871, "o", "\u001b[?2004h> "]
[260.122926, "o", "                return None\r\n\u001b[?2004l\r"]
[260.122946, "o", "\u001b[?2004h"]
[260.122972, "o", "> "]
[260.123032, "o", "            time.sleep(sleep)\r\n\u001b[?2004l\r"]
[260.123051, "o", "\u001b[?2004h> "]
[260.123091, "o", "    return None\r\n\u001b[?2004l\r"]
[260.12312, "o", "\u001b[?2004h> "]
[260.123155, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.123182, "o", "\u001b[?2004h> "]
[260.123316, "o", "def _get_smiles(name: str, cache: dict) -> Optional[str]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.12337, "o", "    if name in cache:\r\n\u001b[?2004l\r"]
[260.123395, "o", "\u001b[?2004h> "]
[260.123466, "o", "        return cache[name]\r\n\u001b[?2004l\r"]
[260.123493, "o", "\u001b[?2004h> "]
[260.123585, "o", "    smiles = _query_cactus_smiles(name)\r\n\u001b[?2004l\r"]
[260.123618, "o", "\u001b[?2004h> "]
[260.123648, "o", "    if not smiles:\r\n\u001b[?2004l\r"]
[260.123681, "o", "\u001b[?2004h> "]
[260.12378, "o", "        smiles = _query_pubchem_smiles(name)\r\n\u001b[?2004l\r"]
[260.123808, "o", "\u001b[?2004h> "]
[260.123837, "o", "    if smiles:\r\n\u001b[?2004l\r"]
[260.123884, "o", "\u001b[?2004h> "]
[260.123938, "o", "        cache[name] = smiles\r\n\u001b[?2004l\r"]
[260.123966, "o", "\u001b[?2004h> "]
[260.124013, "o", "    return smiles\r\n\u001b[?2004l\r"]
[260.124045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.124072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.124101, "o", "\u001b[?2004h> "]
[260.124207, "o", "def _fingerprint_from_smiles(smiles: str):\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.124234, "o", "> "]
[260.124306, "o", "    mol = Chem.MolFromSmiles(smiles)\r\n\u001b[?2004l\r"]
[260.124333, "o", "\u001b[?2004h> "]
[260.124384, "o", "    if mol is None:\r\n\u001b[?2004l\r"]
[260.124422, "o", "\u001b[?2004h"]
[260.124448, "o", "> "]
[260.12448, "o", "        return None\r\n\u001b[?2004l\r"]
[260.124516, "o", "\u001b[?2004h> "]
[260.124701, "o", "    return AllChem.GetMorganFingerprintAsBitVect(mol, radius=2, nBits=2048, useChirality=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.124731, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.124755, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.124782, "o", "> "]
[260.124865, "o", "def topk_tanimoto_similarity_molecules(\r\n\u001b[?2004l\r"]
[260.124891, "o", "\u001b[?2004h> "]
[260.124957, "o", "    target_molecule_name: str,\r\n\u001b[?2004l\r"]
[260.124983, "o", "\u001b[?2004h> "]
[260.125064, "o", "    molecule_pool_filepath: str,\r\n\u001b[?2004l\r"]
[260.12509, "o", "\u001b[?2004h> "]
[260.125132, "o", "    top_k: int,\r\n\u001b[?2004l\r"]
[260.125164, "o", "\u001b[?2004h> "]
[260.125233, "o", ") -> List[Tuple[str, float]]:\r\n\u001b[?2004l\r"]
[260.12526, "o", "\u001b[?2004h> "]
[260.125424, "o", "    \"\"\"Return top-k most similar molecules (name, similarity) from a pool.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[260.125457, "o", "\u001b[?2004l\r\u001b[?2004h"]
[260.125482, "o", "> "]
[260.125645, "o", "    Uses Morgan fingerprints (radius=2, include chirality) and Tanimoto similarity.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.125795, "o", "    Results are sorted by similarity descending and name ascending for ties.\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.125829, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[260.12586, "o", "\u001b[?2004h> "]
[260.125981, "o", "    names = _read_molecule_names(molecule_pool_filepath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.126014, "o", "> "]
[260.126053, "o", "    cache = _load_cache()\r\n\u001b[?2004l\r"]
[260.126087, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.126113, "o", "\u001b[?2004h> "]
[260.126242, "o", "    target_smiles = _get_smiles(target_molecule_name, cache)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.126275, "o", "> "]
[260.126315, "o", "    if not target_smiles:\r\n\u001b[?2004l\r"]
[260.126338, "o", "\u001b[?2004h"]
[260.126374, "o", "> "]
[260.126548, "o", "        raise ValueError(f\"Could not resolve SMILES for target molecule: {target_molecule_name}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.126579, "o", "> "]
[260.126697, "o", "    target_fp = _fingerprint_from_smiles(target_smiles)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.126765, "o", "    if target_fp is None:\r\n\u001b[?2004l\r"]
[260.126792, "o", "\u001b[?2004h> "]
[260.126946, "o", "        raise ValueError(f\"Invalid SMILES for target molecule: {target_smiles}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.126977, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.127092, "o", "    results: List[Tuple[str, float]] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.127148, "o", "    for name in names:\r\n\u001b[?2004l\r"]
[260.127172, "o", "\u001b[?2004h> "]
[260.127277, "o", "        smiles = _get_smiles(name, cache)\r\n\u001b[?2004l\r"]
[260.127304, "o", "\u001b[?2004h> "]
[260.127349, "o", "        if not smiles:\r\n\u001b[?2004l\r"]
[260.127378, "o", "\u001b[?2004h> "]
[260.127436, "o", "            continue\r\n\u001b[?2004l\r"]
[260.127463, "o", "\u001b[?2004h> "]
[260.127568, "o", "        fp = _fingerprint_from_smiles(smiles)\r\n\u001b[?2004l\r"]
[260.127599, "o", "\u001b[?2004h> "]
[260.127641, "o", "        if fp is None:\r\n\u001b[?2004l\r"]
[260.127672, "o", "\u001b[?2004h> "]
[260.127712, "o", "            continue\r\n\u001b[?2004l\r"]
[260.127738, "o", "\u001b[?2004h> "]
[260.127871, "o", "        sim = DataStructs.TanimotoSimilarity(target_fp, fp)\r\n\u001b[?2004l\r"]
[260.127897, "o", "\u001b[?2004h> "]
[260.127998, "o", "        results.append((name, float(sim)))\r\n\u001b[?2004l\r"]
[260.128031, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[260.128063, "o", "> "]
[260.128121, "o", "    # Save cache for future use\r\n\u001b[?2004l\r"]
[260.128153, "o", "\u001b[?2004h> "]
[260.128199, "o", "    _save_cache(cache)\r\n\u001b[?2004l\r"]
[260.128231, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.128254, "o", "\u001b[?2004h> "]
[260.128371, "o", "    # Sort by similarity desc, then name asc\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.128453, "o", "> "]
[260.128493, "o", "    results.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.128521, "o", "> "]
[260.128586, "o", "    return results[: int(top_k)]\r\n\u001b[?2004l\r"]
[260.128611, "o", "\u001b[?2004h> \r\n"]
[260.128635, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[260.128666, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.128742, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[260.128768, "o", "\u001b[?2004h> "]
[260.128814, "o", "    import argparse\r\n\u001b[?2004l\r"]
[260.128844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.128872, "o", "\u001b[?2004h> "]
[260.129059, "o", "    parser = argparse.ArgumentParser(description=\"Compute top-k similar molecules from a pool.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.129093, "o", "> "]
[260.12921, "o", "    parser.add_argument(\"target\", help=\"Target molecule name\")\r\n\u001b[?2004l\r"]
[260.129236, "o", "\u001b[?2004h> "]
[260.129389, "o", "    parser.add_argument(\"pool\", help=\"Path to molecule pool (PDF or text)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.129422, "o", "> "]
[260.129578, "o", "    parser.add_argument(\"-k\", \"--top_k\", type=int, default=5, help=\"Number of top results\")\r\n\u001b[?2004l\r"]
[260.129611, "o", "\u001b[?2004h> "]
[260.12967, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[260.129701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[260.129725, "o", "\u001b[?2004h"]
[260.129756, "o", "> "]
[260.129916, "o", "    results = topk_tanimoto_similarity_molecules(args.target, args.pool, args.top_k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.129949, "o", "> "]
[260.129991, "o", "    for name, sim in results:\r\n\u001b[?2004l\r"]
[260.130018, "o", "\u001b[?2004h> "]
[260.130119, "o", "        print(f\"{name}\\t{sim:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.130148, "o", "> PY\r\n\u001b[?2004l\r"]
[260.152402, "o", "\u001b[?2004hroot@38b568a99daf:~# "]
[269.556364, "i", "ls -la /root/workspace\n"]
[269.556522, "o", "ls -la /root/workspace\r\n\u001b[?2004l\r"]
[269.561005, "o", "total 24\r\ndrwxr-xr-x 2 root root 4096 Jan 26 11:32 .\r\ndrwx------ 1 root root 4096 Jan 26 11:28 ..\r\n-rw-r--r-- 1 root root 1510 Jan 26 11:29 molecules.txt\r\n-rw-r--r-- 1 root root 5382 Jan 26 11:32 solution.py\r\n"]
[269.561285, "o", "\u001b[?2004hroot@38b568a99daf:~# "]
[269.704815, "i", "sed -n '1,20p' /root/workspace/solution.py\n"]
[269.704979, "o", "sed -n '1,20p' /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[269.706496, "o", "#!/usr/bin/env python3\r\n\"\"\"Find top-k similar molecules using Morgan fingerprints and Tanimoto similarity.\"\"\"\r\nimport os\r\nimport json\r\n"]
[269.706547, "o", "import time\r\nimport urllib.parse\r\nimport urllib.request\r\nimport urllib.error\r\nfrom typing import List, Tuple, Optional\r\n\r\nfrom rdkit import Chem\r\nfrom rdkit.Chem import AllChem, DataStructs\r\nimport PyPDF2\r\n\r\n# Cache file for name->SMILES to avoid repeated HTTP calls\r\nCACHE_PATH = os.path.join(os.path.dirname(__file__), \"smiles_cache.json\")\r\n\r\n\r\ndef _load_cache() -> dict:\r\n    if os.path.exists(CACHE_PATH):\r\n"]
[269.706754, "o", "\u001b[?2004hroot@38b568a99daf:~# "]
