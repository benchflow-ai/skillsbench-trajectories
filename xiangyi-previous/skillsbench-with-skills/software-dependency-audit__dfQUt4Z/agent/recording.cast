[24.745194, "o", "\u001b[?2004hroot@4871a6b56664:~# "]
[24.882828, "i", "cat << 'EOF' > parse_results.py\nimport json\nimport csv\n\nwith open('audit_results.json', 'r') as f:\n    data = json.load(f)\n\nresults = []\nif 'Results' in data:\n    for result in data['Results']:\n        if 'Vulnerabilities' in result:\n            for vuln in result['Vulnerabilities']:\n                package = vuln.get('PkgName', 'N/A')\n                version = vuln.get('InstalledVersion', 'N/A')\n                cve_id = vuln.get('VulnerabilityID', 'N/A')\n                severity = vuln.get('Severity', 'N/A')\n                \n                # Get CVSS score (preferring NVD or GHSA if available)\n                cvss_score = 'N/A'\n                cvss_data = vuln.get('CVSS', {})\n                if cvss_data:\n                    # Try to find a representative score\n                    for source, values in cvss_data.items():\n                        if 'V3Score' in values:\n                            cvss_score = values['V3Score']\n                            break\n                        elif 'V2Score' in values:\n                            cvss_score = values['V2Score']\n                            break\n\n                fixed_version = vuln.get('FixedVersion', 'N/A')\n                title = vuln.get('Title', vuln.get('Description', 'N/A')).replace('\\n', ' ').replace('\\r', '')\n                url = vuln.get('PrimaryURL', 'N/A')\n                \n                results.append({\n                    'Package': package,\n                    'Version': version,\n                    'CVE_ID': cve_id,\n                    'Severity': severity,\n                    'CVSS_Score': cvss_score,\n                    'Fixed_Version': fixed_version,\n                    'Title': title,\n                    'Url': url\n                })\n\nwith open('/root/security_audit.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['Package', 'Version', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url'])\n    writer.writeheader()\n    for row in results:\n        writer.writerow(row)\nEOF\n"]
