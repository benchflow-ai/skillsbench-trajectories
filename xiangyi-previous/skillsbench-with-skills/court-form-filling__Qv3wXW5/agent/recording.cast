[27.21608, "i", "cat << 'EOF' > inspect_fields.py\nfrom pypdf import PdfReader\n\nreader = PdfReader('/root/sc100-blank.pdf')\nfields = reader.get_fields()\n\nfor field_name, field_data in fields.items():\n    # Filtering to reduce output and find relevant fields\n    if \"Page2\" in field_name or \"Page3\" in field_name or \"Page4\" in field_name:\n        print(f\"{field_name}\")\nEOF\n"]
