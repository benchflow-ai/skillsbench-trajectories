[47.433913, "i", "cat << 'EOF' > fill_form.py\nfrom pypdf import PdfReader, PdfWriter\n\nreader = PdfReader('/root/sc100-blank.pdf')\nwriter = PdfWriter()\n\npage = reader.pages[0]\nwriter.add_page(page)\n# Add other pages if needed, but we should probably handle all of them\nfor i in range(1, len(reader.pages)):\n    writer.add_page(reader.pages[i])\n\nfields = {\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffName1[0]': 'Joyce He',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffPhone1[0]': '4125886066',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffAddress1[0]': '655 S Fair Oaks Ave',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffCity1[0]': 'Sunnyvale',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffState1[0]': 'CA',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffZip1[0]': '94086',\n    'SC-100[0].Page2[0].List1[0].Item1[0].EmailAdd1[0]': 'he1998@gmail.com',\n    \n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantName1[0]': 'Zhi Chen',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantPhone1[0]': '5125658878',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantAddress1[0]': '299 W Washington Ave',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantCity1[0]': 'Sunnyvale',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantState1[0]': 'CA',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantZip1[0]': '94086',\n\n    'SC-100[0].Page2[0].List3[0].PlaintiffClaimAmount1[0]': '1500',\n    'SC-100[0].Page2[0].List3[0].Lia[0].FillField2[0]': 'Failed to return security deposit based on the signed roommate sublease contract after moving out.',\n    \n    'SC-100[0].Page3[0].List3[0].Lib[0].Date1[0]': '2025-09-30',\n    'SC-100[0].Page3[0].List3[0].Lib[0].Date2[0]': '2026-01-19',\n    'SC-100[0].Page3[0].List3[0].Lic[0].FillField1[0]': 'The amount is listed on the signed roommate sublease contract.',\n    \n    'SC-100[0].Page3[0].List4[0].Item4[0].Checkbox50[0]': '/Yes',\n    'SC-100[0].Page3[0].List5[0].Lia[0].Checkbox5cb[0]': '/Yes',\n    'SC-100[0].Page3[0].List6[0].item6[0].ZipCode1[0]': '94086',\n    'SC-100[0].Page3[0].List7[0].item7[0].Checkbox60[1]': '/Yes',\n    'SC-100[0].Page3[0].List8[0].item8[0].Checkbox61[1]': '/Yes',\n\n    'SC-100[0].Page4[0].Sign[0].Date1[0]': '2026-01-19',\n    'SC-100[0].Page4[0].Sign[0].PlaintiffName1[0]': 'Joyce He',\n    \n    # Captions\n    'SC-100[0].Page2[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\n    'SC-100[0].Page3[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\n    'SC-100[0].Page4[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\n}\n\nwriter.update_page_form_field_values(writer.pages[1], fields)\nwriter.update_page_form_field_values(writer.pages[2], fields)\nwriter.update_page_form_field_values(writer.pages[3], fields)\n\nwith open('/root/sc100-filled.pdf', 'wb') as output_stream:\n    writer.write(output_stream)\nEOF\n"]
[47.437826, "o", "cat << 'EOF' > fill_form.py\r\n\u001b[?2004l\r\u001b[?2004h> from pypdf import PdfReader, PdfWriter\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> reader = PdfReader('/root/sc100-blank.pdf')\r\n\u001b[?2004l\r\u001b[?2004h> writer = PdfWriter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> page = reader.pages[0]\r\n\u001b[?2004l\r\u001b[?2004h> writer.add_page(page)\r\n\u001b[?2004l\r\u001b[?2004h> # Add other pages if needed, but we should probably handle all of them\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, len(reader.pages)):\r\n\u001b[?2004l\r\u001b[?2004h>     writer.add_page(reader.pages[i])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fields = {\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffName1[0]': 'Joyce He',\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffPhone1[0]': '4125886066',\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffAddress1[0]': '655 S Fair Oaks Ave',\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffCity1[0]': 'Sunnyvale',\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffState1[0]': 'CA',"]
