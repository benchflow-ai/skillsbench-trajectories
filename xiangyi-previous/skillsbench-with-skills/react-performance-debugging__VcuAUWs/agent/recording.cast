[343.22671, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.226863, "o", "- Made analytics logging fire-and-forget (non-blocking)"]
[343.227028, "o", "\r\n"]
[343.227181, "o", "\u001b[?2004l\r"]
[343.227676, "o", "\u001b[?2004h"]
[343.227836, "o", "> - Parallelize user and products fetch with `Promise.all`"]
