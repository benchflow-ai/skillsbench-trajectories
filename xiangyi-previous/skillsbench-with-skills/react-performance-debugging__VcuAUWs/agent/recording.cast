[153.883467, "o", "\u001b[?2004h> "]
[153.883857, "o", "  return arr.reduce((sum, val) => sum + val, 0) / arr.length;\r\n\u001b[?2004l\r"]
[153.883901, "o", "\u001b[?2004h> }"]
