[153.88435, "o", "function median(arr: number[]): number {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.892769, "o", "  const sorted = [...arr].sort((a, b) => a - b);\r\n\u001b[?2004l\r"]
[153.892833, "o", "\u001b[?2004h> "]
[153.893051, "o", "  const mid = Math.floor(sorted.length / 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.893472, "o", "  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];\r\n\u001b[?2004l\r"]
[153.893502, "o", "\u001b[?2004h> "]
