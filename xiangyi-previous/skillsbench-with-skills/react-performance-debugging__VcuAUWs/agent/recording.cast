[153.921672, "o", "> "]
[153.92187, "o", "  // Memoize all statistical calculations\r\n\u001b[?2004l\r"]
[153.921918, "o", "\u001b[?2004h> "]
[153.922074, "o", "  const stats = useMemo(() => {\r\n\u001b[?2004l\r"]
[153.922114, "o", "\u001b[?2004h> "]
[153.922367, "o", "    const prices = products.map(p => p.price);\r\n\u001b[?2004l\r"]
[153.92241, "o", "\u001b[?2004h> "]
[153.92266, "o", "    const ratings = products.map(p => p.rating);\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.922707, "o", "> "]
[153.922967, "o", "    const reviews = products.map(p => p.reviews);\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.92301, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[153.923047, "o", "> "]
[153.923209, "o", "    const priceStats = {\r\n\u001b[?2004l\r"]
[153.923248, "o", "\u001b[?2004h> "]
[153.923405, "o", "      mean: mean(prices),\r\n\u001b[?2004l\r"]
[153.923445, "o", "\u001b[?2004h> "]
[153.923623, "o", "      median: median(prices),\r\n\u001b[?2004l\r"]
[153.923668, "o", "\u001b[?2004h> "]
[153.923797, "o", "      std: std(prices),\r\n\u001b[?2004l\r"]
[153.923834, "o", "\u001b[?2004h> "]
[153.92404, "o", "      variance: variance(prices),\r\n\u001b[?2004l\r"]
[153.924079, "o", "\u001b[?2004h> "]
