[153.89403, "o", "  const avg = mean(arr);\r\n\u001b[?2004l\r"]
[153.894067, "o", "\u001b[?2004h> "]
[153.900653, "o", "  const squareDiffs = arr.map(val => Math.pow(val - avg, 2));\r\n\u001b[?2004l\r\u001b[?2004h>   return Math.sqrt(mean(squareDiffs));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function variance(arr: number[]): number {\r\n\u001b[?2004l\r\u001b[?2004h>   const avg = mean(arr);\r\n\u001b[?2004l\r\u001b[?2004h>   const squareDiffs = arr.map(val => Math.pow(val - avg, 2));\r\n\u001b[?2004l\r\u001b[?2004h>   return mean(squareDiffs);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function quantile(arr: number[], q: number): number {\r\n\u001b[?2004l\r\u001b[?2004h>   const sorted = [...arr].sort((a, b) => a - b);\r\n\u001b[?2004l\r\u001b[?2004h>   const pos = (sorted.length - 1) * q;\r\n\u001b[?2004l\r\u001b[?2004h>   const base = Math.floor(pos);\r\n\u001b[?2004l\r\u001b[?2004h>   const rest = pos - base;\r\n\u001b[?2004l\r\u001b[?2004h>   if (sorted[base + 1] !== undefined) {\r\n\u001b[?2004l\r\u001b[?2004h>     return sorted[base] + rest * (sorted[base + 1] - sorted[base]);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return sorted[base];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function ComparisonTable({ products }: { products: Product[] }) {\r\n\u001b[?2004l\r\u001b[?2004h>   // Memoize calculations\r\n\u001b[?2004l\r\u001b[?2004h>   const stats = useMemo(() => {\r\n\u001b[?2004l\r\u001b[?2004h>     const sorted = [...products].sort((a, b) => a.price - b.price);\r\n\u001b[?2004l\r\u001b[?2004h>     const avgPrice = mean(products.map(p => p.price));\r\n\u001b[?2004l\r\u001b[?2004h>     const totalReviews = products.reduce((sum, p) => sum + p.reviews, 0);\r\n\u001b[?2004l\r\u001b[?2004h>     const bestRated = products.reduce((max, p) => p.rating > max.rating ? p : max);\r\n\u001b[?2004l\r\u001b[?2004h>     const cheapest = products.reduce((min, p) => p.price < min.price ? p : min);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[153.902333, "o", "    return { sorted, avgPrice, totalReviews, bestRated, cheapest };\r\n\u001b[?2004l\r"]
