[153.926401, "o", "\u001b[?2004h> "]
[153.926562, "o", "      std: std(reviews),\r\n\u001b[?2004l\r"]
[153.926599, "o", "\u001b[?2004h> "]
[153.926654, "o", "    };\r\n\u001b[?2004l\r"]
[153.926687, "o", "\u001b[?2004h> "]
[153.926724, "o", "\r\n\u001b[?2004l\r"]
[153.926754, "o", "\u001b[?2004h> "]
[153.927065, "o", "    // Calculate value score: rating / price * 100\r\n\u001b[?2004l\r"]
[153.927106, "o", "\u001b[?2004h> "]
[153.927375, "o", "    const valueScores = products.map(p => ({\r\n\u001b[?2004l\r"]
[153.927415, "o", "\u001b[?2004h> "]
[153.927533, "o", "      name: p.name,\r\n\u001b[?2004l\r"]
[153.927568, "o", "\u001b[?2004h> "]
[153.927834, "o", "      score: (p.rating / p.price) * 100,\r\n\u001b[?2004l\r"]
[153.927875, "o", "\u001b[?2004h> "]
[153.927943, "o", "    }));\r\n\u001b[?2004l\r"]
[153.927982, "o", "\u001b[?2004h> "]
[153.928415, "o", "    const sortedByValue = valueScores.sort((a, b) => b.score - a.score);\r\n\u001b[?2004l\r"]
[153.928461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[153.92849, "o", "> "]
[153.928907, "o", "    return { priceStats, ratingStats, reviewStats, sortedByValue };\r\n\u001b[?2004l\r"]
[153.92896, "o", "\u001b[?2004h> "]
