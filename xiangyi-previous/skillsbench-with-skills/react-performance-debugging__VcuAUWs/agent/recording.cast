[153.924345, "o", "> "]
[153.924533, "o", "      q3: quantile(prices, 0.75),\r\n\u001b[?2004l\r"]
[153.924585, "o", "\u001b[?2004h> "]
[153.924644, "o", "    };\r\n\u001b[?2004l\r"]
[153.924678, "o", "\u001b[?2004h> "]
[153.924717, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.924754, "o", "> "]
[153.924919, "o", "    const ratingStats = {\r\n\u001b[?2004l\r"]
[153.924958, "o", "\u001b[?2004h> "]
[153.925134, "o", "      mean: mean(ratings),\r\n\u001b[?2004l\r"]
[153.925171, "o", "\u001b[?2004h> "]
[153.925363, "o", "      median: median(ratings),\r\n\u001b[?2004l\r"]
[153.9254, "o", "\u001b[?2004h> "]
[153.925562, "o", "      std: std(ratings),\r\n\u001b[?2004l\r"]
[153.925601, "o", "\u001b[?2004h> "]
[153.925661, "o", "    };\r\n\u001b[?2004l\r"]
[153.925698, "o", "\u001b[?2004h> "]
[153.925733, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[153.925763, "o", "> "]
[153.925923, "o", "    const reviewStats = {\r\n\u001b[?2004l\r"]
[153.925959, "o", "\u001b[?2004h> "]
[153.92614, "o", "      mean: mean(reviews),\r\n\u001b[?2004l\r"]
[153.926178, "o", "\u001b[?2004h> "]
