[?2004l[?2004h> // src/app/compare/page.tsx
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useState, useMemo } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   reviews: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // Sample products to compare
[?2004l[?2004h> const PRODUCTS: Product[] = [
[?2004l[?2004h>   { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },
[?2004l[?2004h>   { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },
[?2004l[?2004h>   { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },
[?2004l[?2004h>   { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },
[?2004l[?2004h>   { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },
[?2004l[?2004h> ];
[?2004l[?2004h> 
[?2004l[?2004h> // Native JS utility functions to replace lodash
[?2004l[?2004h> function mean(arr: number[]): number {
[?2004l[?2004h>   return arr.reduce((sum, val) => sum + val, 0) / arr.length;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function median(arr: number[]): number {
[?2004l[?2004h>   const sorted = [...arr].sort((a, b) => a - b);
[?2004l[?2004h>   const mid = Math.floor(sorted.length / 2);
[?2004l[?2004h>   return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function std(arr: number[]): number {
[?2004l[?2004h>   const avg = mean(arr);
[?2004l[?2004h>   const squareDiffs = arr.map(val => Math.pow(val - avg, 2));
[?2004l[?2004h>   return Math.sqrt(mean(squareDiffs));
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function variance(arr: number[]): number {
[?2004l[?2004h>   const avg = mean(arr);
[?2004l[?2004h>   const squareDiffs = arr.map(val => Math.pow(val - avg, 2));
[?2004l[?2004h>   return mean(squareDiffs);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function quantile(arr: number[], q: number): number {
[?2004l[?2004h>   const sorted = [...arr].sort((a, b) => a - b);
[?2004l[?2004h>   const pos = (sorted.length - 1) * q;
[?2004l[?2004h>   const base = Math.floor(pos);
[?2004l[?2004h>   const rest = pos - base;
[?2004l[?2004h>   if (sorted[base + 1] !== undefined) {
[?2004l[?2004h>     return sorted[base] + rest * (sorted[base + 1] - sorted[base]);
[?2004l[?2004h>   }
[?2004l[?2004h>   return sorted[base];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function ComparisonTable({ products }: { products: Product[] }) {
[?2004l[?2004h>   // Memoize calculations
[?2004l[?2004h>   const stats = useMemo(() => {
[?2004l[?2004h>     const sorted = [...products].sort((a, b) => a.price - b.price);
[?2004l[?2004h>     const avgPrice = mean(products.map(p => p.price));
[?2004l[?2004h>     const totalReviews = products.reduce((sum, p) => sum + p.reviews, 0);
[?2004l[?2004h>     const bestRated = products.reduce((max, p) => p.rating > max.rating ? p : max);
[?2004l[?2004h>     const cheapest = products.reduce((min, p) => p.price < min.price ? p : min);
[?2004l[?2004h>     
[?2004l[?2004h>     return { sorted, avgPrice, totalReviews, bestRated, cheapest };
[?2004l[?2004h>   }, [products]);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div className="bg-white rounded-xl shadow-md p-6">
[?2004l[?2004h>       <h2 className="text-xl font-bold mb-4">Comparison Overview</h2>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="grid grid-cols-4 gap-4 mb-6 text-center">
[?2004l[?2004h>         <div className="bg-blue-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-blue-600">${stats.avgPrice.toFixed(2)}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Avg Price</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-green-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-green-600">{stats.totalReviews.toLocaleString()}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Total Reviews</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-yellow-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-yellow-600">{stats.bestRated.name}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Best Rated</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>         <div className="bg-purple-50 p-4 rounded-lg">
[?2004l[?2004h>           <div className="text-2xl font-bold text-purple-600">{stats.cheapest.name}</div>
[?2004l[?2004h>           <div className="text-sm text-gray-600">Best Value</div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l<[?2004h>       <table className="w-full">
[?2004l[?2004h>         <thead className="bg-gray-50">
[?2004l[?2004h>           <tr>
[?2004l[?2004h>             <th className="px-4 py-3 text-left">Product</th>
[?2004l[?2004h>             <th className="px-4 py-3 text-right">Price</th>
[?2004l[?2004h>             <th className="px-4 py-3 text-right">Rating</th>
[?2004l[?2004h>             <th className="px-4 py-3 text-right">Reviews</th>
[?2004l[?2004h>             <th className="px-4 py-3 text-center">Stock</th>
[?2004l[?2004h>           </tr>
[?2004l[?2004h>         </thead>
[?2004l[?2004h>         <tbody>
[?2004l[?2004h>           {stats.sorted.map((product) => (
[?2004l[?2004h>             <tr key={product.id} className="border-t">
[?2004l[?2004h>               <td className="px-4 py-3 font-medium">{product.name}</td>
[?2004l[?2004h>               <td className="px-4 py-3 text-right">${product.price.toFixed(2)}</td>
[?2004l[?2004h>               <td className="px-4 py-3 text-right">{'★'.repeat(Math.round(product.rating))} {product.rating}</td>
[?2004l[?2004h>               <td className="px-4 py-3 text-right">{product.reviews.toLocaleString()}</td>
[?2004l[?2004h>               <td className="px-4 py-3 text-center">
[?2004l[?2004h>                 <span className={`px-2 py-1 rounded-full text-xs ${product.inStock ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
[?2004l[?2004h>                   {product.inStock ? 'In Stock' : 'Out of Stock'}
[?2004l[?2004h>                 </span>
[?2004l[?2004h>               </td>
[?2004l[?2004h>             </tr>
[?2004l[?2004h>           ))}
[?2004l[?2004h>         </tbody>
[?2004l[?2004h>       </table>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function AdvancedAnalysis({ products }: { products: Product[] }) {
[?2004l[?2004h>   // Memoize all statistical calculations
[?2004l[?2004h>   const stats = useMemo(() => {
[?2004l[?2004h>     const prices = products.map(p => p.price);
[?2004l[?2004h>     const ratings = products.map(p => p.rating);
[?2004l[?2004h>     const reviews = products.map(p => p.reviews);
[?2004l[?2004h> 
[?2004l[?2004h>     const priceStats = {
[?2004l[?2004h>       mean: mean(prices),
[?2004l[?2004h>       median: median(prices),
[?2004l[?2004h>       std: std(prices),
[?2004l[?2004h>       variance: variance(prices),
[?2004l[?2004h>       q1: quantile(prices, 0.25),
[?2004l[?2004h>       q3: quantile(prices, 0.75),
[?2004l[?2004h>     };
[?2004l[?2004h> 
[?2004l[?2004h>     const ratingStats = {
[?2004l[?2004h>       mean: mean(ratings),
[?2004l[?2004h>       median: median(ratings),
[?2004l[?2004h>       std: std(ratings),
[?2004l[?2004h>     };
[?2004l[?2004h> 
[?2004l[?2004h>     const reviewStats = {
[?2004l[?2004h>       mean: mean(reviews),
[?2004l[?2004h>       median: median(reviews),
[?2004l[?2004h>       std: std(reviews),
[?2004l[?2004h>     };
[?2004l[?2004h> 
[?2004l[?2004h>     // Calculate value score: rating / price * 100
[?2004l[?2004h>     const valueScores = products.map(p => ({
[?2004l[?2004h>       name: p.name,
[?2004l[?2004h>       score: (p.rating / p.price) * 100,
[?2004l[?2004h>     }));
[?2004l[?2004h>     const sortedByValue = valueScores.sort((a, b) => b.score - a.score);
[?2004l[?2004h> 
[?2004l[?2004h>     return { priceStats, ratingStats, reviewStats, sortedByValue };
[?2004l[?2004h>   }, [products]);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div data-testid="advanced-content" className="bg-white rounded-xl shadow-md p-6">
[?2004l[?2004h>       <h2 className="text-xl font-bold mb-4">Advanced Statistical Analysis</h2>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="grid grid-cols-3 gap-6">
[?2004l[?2004h>         <div>
[?2004l[?2004h>           <h3 className="font-semibold mb-3 text-gray-700">Price Distribution</h3>
[?2004l[?2004h>           <div className="space-y-2 text-sm">
[?2004l[?2004h>             <div className="flex justify-between"><span>Mean:</span><span className="font-mono">${stats.priceStats.mean.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Median:</span><span className="font-mono">${stats.priceStats.median.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Std Dev:</span><span className="font-mono">${stats.priceStats.std.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Variance:</span><span className="font-mono">{stats.priceStats.variance.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Q1 (25%):</span><span className="font-mono">${stats.priceStats.q1.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Q3 (75%):</span><span className="font-mono">${stats.priceStats.q3.toFixed(2)}</span></div>
[?2004l[?2004h>           </div>
[?2004l[?2004h>         </div>
[?2004l[?2004h> 
[?2004l[?2004h>         <div>
[?2004l[?2004h>           <h3 className="font-semibold mb-3 text-gray-700">Rating Analysis</h3>
[?2004l[?2004h>           <div className="space-y-2 text-sm">
[?2004l[?2004h>             <div className="flex justify-between"><span>Mean:</span><span className="font-mono">{stats.ratingStats.mean.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Median:</span><span className="font-mono">{stats.ratingStats.median.toFixed(2)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Std Dev:</span><span className="font-mono">{stats.ratingStats.std.toFixed(3)}</span></div>
[?2004l[?2004h>           </div>
[?2004l[?2004h>         </div>
[?2004l[?2004h> 
[?2004l[?2004h>         <div>
[?2004l[?2004h>           <h3 className="font-semibold mb-3 text-gray-700">Review Volume</h3>
[?2004l[?2004h>           <div className="space-y-2 text-sm">
[?2004l[?2004h>             <div className="flex justify-between"><span>Mean:</span><span className="font-mono">{stats.reviewStats.mean.toFixed(0)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Median:</span><span className="font-mono">{stats.reviewStats.median.toFixed(0)}</span></div>
[?2004l[?2004h>             <div className="flex justify-between"><span>Std Dev:</span><span className="font-mono">{stats.reviewStats.std.toFixed(0)}</span></div>
[?2004l[?2004h>           </div>
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="mt-6">
[?2004l[?2004h>         <h3 className="font-semibold mb-3 text-gray-700">Value Score Ranking (Rating/Price × 100)</h3>
[?2004l[?2004h>         <div className="space-y-2">
[?2004l[?2004h>           {stats.sortedByValue.map((item, i) => (
