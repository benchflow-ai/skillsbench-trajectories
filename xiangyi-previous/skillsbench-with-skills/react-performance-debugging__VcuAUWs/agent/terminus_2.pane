[?2004l[?2004h> // src/components/ProductCard.tsx
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { memo } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> interface Props {
