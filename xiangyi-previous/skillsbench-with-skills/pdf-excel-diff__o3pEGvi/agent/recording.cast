[26.179706, "i", "python3 << 'EOF'\nimport pdfplumber\nimport pandas as pd\nimport json\n\n# Extract data from PDF\nwith pdfplumber.open('/root/employees_backup.pdf') as pdf:\n    all_tables = []\n    for page in pdf.pages:\n        tables = page.extract_tables()\n        for table in tables:\n            all_tables.extend(table)\n    \n    # First row should be header\n    if all_tables:\n        header = all_tables[0]\n        data = all_tables[1:]\n        pdf_df = pd.DataFrame(data, columns=header)\n        print(\"PDF columns:\", pdf_df.columns.tolist())\n        print(\"PDF shape:\", pdf_df.shape)\n        print(\"PDF first 5 rows:\")\n        print(pdf_df.head())\nEOF\n"]
