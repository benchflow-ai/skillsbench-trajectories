[122.557325, "i", "python3 << 'SCRIPT'\nimport pdfplumber\nimport pandas as pd\nimport json\n\n# Extract all data from PDF\nprint('Extracting PDF data...')\nwith pdfplumber.open('/root/employees_backup.pdf') as pdf:\n    all_rows = []\n    header = None\n    for page_num, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        for table in tables:\n            for row in table:\n                if header is None:\n                    header = row\n                elif row != header:  # Skip repeated headers\n                    all_rows.append(row)\n\npdf_df = pd.DataFrame(all_rows, columns=header)\nprint(f'PDF extracted: {len(pdf_df)} rows')\n\n# Read Excel file\nexcel_df = pd.read_excel('/root/employees_current.xlsx')\nprint(f'Excel loaded: {len(excel_df)} rows')\n\n# Clean PDF data - convert Salary to int (remove commas)\npdf_df['Salary'] = pdf_df['Salary'].str.replace(',', '').astype(int)\npdf_df['Years'] = pdf_df['Years'].astype(int)\npdf_df['Score'] = pdf_df['Score'].astype(float)\n\n# Set ID as index for easier comparison\npdf_dict = pdf_df.set_index('ID').to_dict('index')\nexcel_dict = excel_df.set_index('ID').to_dict('index')\n\npdf_ids = set(pdf_df['ID'])\nexcel_ids = set(excel_df['ID'])\n\n# Find deleted employees\ndeleted = sorted(pdf_ids - excel_ids)\nprint(f'Deleted employees: {len(deleted)}')\n\n# Find modified employees\nmodified = []\ncommon_ids = pdf_ids & excel_ids\nfor emp_id in sorted(common_ids):\n    old = pdf_dict[emp_id]\n    new = excel_dict[emp_id]\n    for field in ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:\n        old_val = old[field]\n        new_val = new[field]\n        # Handle numeric comparisons\n        if field in ['Salary', 'Years']:\n            old_val = int(old_val)\n            new_val = int(new_val)\n        elif field == 'Score':\n            old_val = float(old_val)\n            new_val = float(new_val)\n        \n        if old_val != new_val:\n            modified.append({\n                'id': emp_id,\n                'field': field,\n                'old_value': old_val,\n                'new_value': new_val\n            })\n\nprint(f'Modified records: {len(modified)}')\n\n# Sort modified by ID\nmodified.sort(key=lambda x: x['id'])\n\n# Create result\nresult = {\n    'deleted_employees': deleted,\n    'modified_employees': modified\n}\n\n# Write to file\nwith open('/root/diff_report.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Report written to /root/diff_report.json')\nprint('\\nFirst 5 deleted:', deleted[:5])\nprint('First 5 modified:', modified[:5])\nSCRIPT\n"]
