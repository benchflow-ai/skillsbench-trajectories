[122.559735, "o", "pdf_df['Score'] = pdf_df['Score'].astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.559789, "o", "\u001b[?2004h> "]
[122.55984, "o", "# Set ID as index for easier comparison\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.55993, "o", "pdf_dict = pdf_df.set_index('ID').to_dict('index')\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.559981, "o", "> "]
[122.560035, "o", "excel_dict = excel_df.set_index('ID').to_dict('index')\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.560086, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560139, "o", "pdf_ids = set(pdf_df['ID'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560207, "o", "excel_ids = set(excel_df['ID'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560257, "o", "# Find deleted employees\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.560307, "o", "> "]
[122.560353, "o", "deleted = sorted(pdf_ids - excel_ids)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560404, "o", "print(f'Deleted employees: {len(deleted)}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560457, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560504, "o", "# Find modified employees\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560549, "o", "modified = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560592, "o", "common_ids = pdf_ids & excel_ids\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560652, "o", "for emp_id in sorted(common_ids):\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.560703, "o", "> "]
[122.560754, "o", "    old = pdf_dict[emp_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560802, "o", "    new = excel_dict[emp_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560935, "o", "    for field in ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.560977, "o", "        old_val = old[field]\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.561026, "o", "> "]
[122.561079, "o", "        new_val = new[field]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561124, "o", "        # Handle numeric comparisons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561187, "o", "        if field in ['Salary', 'Years']:\r\n\u001b[?2004l\r"]
[122.561237, "o", "\u001b[?2004h> "]
[122.561292, "o", "            old_val = int(old_val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.561351, "o", ">             new_val = int(new_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.5614, "o", "        elif field == 'Score':\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.561446, "o", "> "]
[122.561494, "o", "            old_val = float(old_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561539, "o", "            new_val = float(new_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561584, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561627, "o", "        if old_val != new_val:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.561674, "o", "> "]
[122.561727, "o", "            modified.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561781, "o", "                'id': emp_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561844, "o", "                'field': field,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561893, "o", "                'old_value': old_val,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.561953, "o", "                'new_value': new_val\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.562, "o", ">             })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[122.56205, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[122.562098, "o", "print(f'Modified records: {len(modified)}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.562147, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562202, "o", "# Sort modified by ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562253, "o", "modified.sort(key=lambda x: x['id'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.562303, "o", "> # Create result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562358, "o", "result = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562408, "o", "    'deleted_employees': deleted,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562461, "o", "    'modified_employees': modified\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.562511, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562624, "o", "# Write to file\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/diff_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[122.562685, "o", "\u001b[?2004h> "]
[122.562756, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562813, "o", "print('Report written to /root/diff_report.json')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.562869, "o", "print('\\nFirst 5 deleted:', deleted[:5])\r\n\u001b[?2004l\r"]
[122.562915, "o", "\u001b[?2004h> "]
[122.562953, "o", "print('First 5 modified:', modified[:5])\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.563006, "o", "> SCRIPT\r\n\u001b[?2004l\r"]
