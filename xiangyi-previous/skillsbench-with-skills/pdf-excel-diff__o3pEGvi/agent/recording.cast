[82.360712, "i", "python3 << 'SCRIPT'\nimport pdfplumber\nimport pandas as pd\n\nwith open('/tmp/debug.txt', 'w') as f:\n    with pdfplumber.open('/root/employees_backup.pdf') as pdf:\n        f.write(f'Number of pages: {len(pdf.pages)}\\n')\n        page = pdf.pages[0]\n        tables = page.extract_tables()\n        f.write(f'Tables on first page: {len(tables)}\\n')\n        if tables:\n            f.write(f'First table rows: {len(tables[0])}\\n')\n            for i, row in enumerate(tables[0][:5]):\n                f.write(f'Row {i}: {row}\\n')\nprint('Done')\nSCRIPT\n"]
