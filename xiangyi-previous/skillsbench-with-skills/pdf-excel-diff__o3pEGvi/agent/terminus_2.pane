[?2004l[?2004h> 
[?2004l[?2004h> # Extract all data from PDF
[?2004l[?2004h> print('Extracting PDF data...')
[?2004l[?2004h> with pdfplumber.open('/root/employees_backup.pdf') as pdf:
[?2004l[?2004h>     all_rows = []
[?2004l[?2004h>     header = None
[?2004l[?2004h>     for page_num, page in enumerate(pdf.pages):
[?2004l[?2004h>         tables = page.extract_tables()
[?2004l[?2004h>         for table in tables:
[?2004l[?2004h>             for row in table:
[?2004l[?2004h>                 if header is None:
[?2004l[?2004h>                     header = row
[?2004l[?2004h>                 elif row != header:  # Skip repeated headers
[?2004l[?2004h>                     all_rows.append(row)
[?2004l[?2004h> 
[?2004l[?2004h> pdf_df = pd.DataFrame(all_rows, columns=header)
[?2004l[?2004h> print(f'PDF extracted: {len(pdf_df)} rows')
[?2004l[?2004h> 
[?2004l[?2004h> # Read Excel file
[?2004l[?2004h> excel_df = pd.read_excel('/root/employees_current.xlsx')
[?2004l[?2004h> print(f'Excel loaded: {len(excel_df)} rows')
[?2004l[?2004h> 
[?2004l[?2004h> # Clean PDF data - convert Salary to int (remove commas)
[?2004l[?2004h> pdf_df['Salary'] = pdf_df['Salary'].str.replace(',', '').astype(int)
[?2004l[?2004h> pdf_df['Years'] = pdf_df['Years'].astype(int)
[?2004l[?2004h> pdf_df['Score'] = pdf_df['Score'].astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> # Set ID as index for easier comparison
[?2004l[?2004h> pdf_dict = pdf_df.set_index('ID').to_dict('index')
[?2004l[?2004h> excel_dict = excel_df.set_index('ID').to_dict('index')
[?2004l[?2004h> 
[?2004l[?2004h> pdf_ids = set(pdf_df['ID'])
[?2004l[?2004h> excel_ids = set(excel_df['ID'])
[?2004l[?2004h> 
[?2004l[?2004h> # Find deleted employees
[?2004l[?2004h> deleted = sorted(pdf_ids - excel_ids)
[?2004l[?2004h> print(f'Deleted employees: {len(deleted)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Find modified employees
[?2004l[?2004h> modified = []
[?2004l[?2004h> common_ids = pdf_ids & excel_ids
[?2004l[?2004h> for emp_id in sorted(common_ids):
[?2004l[?2004h>     old = pdf_dict[emp_id]
[?2004l[?2004h>     new = excel_dict[emp_id]
[?2004l[?2004h>     for field in ['First', 'Last', 'Dept', 'Position', 'Salary', 'Years', 'Location', 'Score']:
[?2004l[?2004h>         old_val = old[field]
[?2004l[?2004h>         new_val = new[field]
[?2004l[?2004h>         # Handle numeric comparisons
[?2004l[?2004h>         if field in ['Salary', 'Years']:
[?2004l[?2004h>             old_val = int(old_val)
[?2004l[?2004h>             new_val = int(new_val)
[?2004l[?2004h>         elif field == 'Score':
[?2004l[?2004h>             old_val = float(old_val)
[?2004l[?2004h>             new_val = float(new_val)
[?2004l[?2004h>         
[?2004l[?2004h>         if old_val != new_val:
[?2004l[?2004h>             modified.append({
[?2004l[?2004h>                 'id': emp_id,
[?2004l[?2004h>                 'field': field,
[?2004l[?2004h>                 'old_value': old_val,
[?2004l[?2004h>                 'new_value': new_val
[?2004l[?2004h>             })
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Modified records: {len(modified)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Sort modified by ID
[?2004l[?2004h> modified.sort(key=lambda x: x['id'])
[?2004l[?2004h> 
[?2004l[?2004h> # Create result
[?2004l[?2004h> result = {
[?2004l[?2004h>     'deleted_employees': deleted,
[?2004l[?2004h>     'modified_employees': modified
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write to file
[?2004l[?2004h> with open('/root/diff_report.json', 'w') as f:
