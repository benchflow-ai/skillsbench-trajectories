[138.803925, "o", "Expected: {\"wyckoff_multiplicity_dict\": {\"a\": 4, \"c\": 8}, \"wyckoff_coordinates_dict\": {\"a\": [\"0\", \"1/2\", \"1/2\"], \"c\": [\"3/8\", \"1/9\", \"8/9\"]}}\r\nGot:      {'wyckoff_multiplicity_dict': {'a': 4, 'c': 8}, 'wyckoff_coordinates_dict': {'a': ['0', '1/2', '1/2'], 'c': ['3/8', '1/9', '8/9']}}\r\nMatch: True\r\n"]
