[78.140473, "i", "python3 << 'EOF'\nimport sys\nsys.path.insert(0, '/root/workspace')\nfrom solution import analyze_wyckoff_position_multiplicities_and_coordinates\n\n# Test with multiple CIF files\ntest_files = [\n    '/root/cif_files/Al2O3_mp-7048.cif',\n    '/root/cif_files/C_mp-169.cif',\n    '/root/cif_files/SiO2_mp-6945.cif',\n    '/root/cif_files/FeS2_mp-1522.cif'\n]\n\nfor f in test_files:\n    print(f\"\\n=== {f.split('/')[-1]} ===\")\n    try:\n        result = analyze_wyckoff_position_multiplicities_and_coordinates(f)\n        print(result)\n    except Exception as e:\n        print(f\"Error: {e}\")\nEOF\n"]
