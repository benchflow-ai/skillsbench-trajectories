[114.171474, "o", "cat /root/workspace/solution.py\r\n\u001b[?2004l\r"]
[114.172715, "o", "from typing import Any\r\nfrom fractions import Fraction\r\nfrom pymatgen.core import Structure\r\nfrom pymatgen.symmetry.analyzer import SpacegroupAnalyzer\r\n\r\n\r\ndef decimal_to_fraction(val: float, max_denom: int = 12) -> str:\r\n    \"\"\"\r\n    Convert a decimal value to a fraction string with denominator <= max_denom.\r\n    The value is normalized to [0, 1) range first.\r\n    \"\"\"\r\n    # Normalize to [0, 1) range\r\n    val = val % 1.0"]
[114.173059, "o", "\r\n    # Handle values very close to 0 or 1\r\n    if abs(val) < 1e-9:\r\n        return \"0\"\r\n    if abs(val - 1.0) < 1e-9:\r\n        return \"0\"\r\n    \r\n    frac = Fraction(val).limit_denominator(max_denom)\r\n    if frac.denominator == 1:\r\n        return str(frac.numerator % 1) if frac.numerator >= 1 else str(frac.numerator)\r\n    return f\"{frac.numerator}/{frac.denominator}\"\r\n\r\n\r\ndef analyze_wyckoff_position_multiplicities_and_coordinates(filepath: str) -> dict[str, dict] | dict[str, Any]:\r\n    \"\"\"\r\n    Analyze a CIF file to extract Wyckoff position multiplicities and \r\n    calculate approximate coordinates for the first atom of each Wyckoff position.\r\n    \r\n    Args:\r\n        filepath: Path to the CIF file\r\n        \r\n    Returns:\r\n        Dictionary containing:\r\n        - wyckoff_multiplicity_dict: mapping of Wyckoff letter to multiplicity\r\n        - wyckoff_coordinates_dict: mapping of Wyckoff letter to list of fractional coordinates\r\n    \"\"\"\r\n    # Read the structure from CIF file\r\n    structure = Structure.from_file(filepath)\r\n    \r\n    # Get symmetry information\r\n    sga = SpacegroupAnalyzer(structure)\r\n    symmetrized = sga.get_symmetrized_structure()\r\n    \r\n    # Get Wyckoff symbols and equivalent sites\r\n    wyckoff_symbols = symmetrized.wyckoff_symbols\r\n    equivalent_sites = symmetrized.equivalent_sites\r\n    \r\n    wyckoff_multiplicity_dict = {}\r\n    wyckoff_coordinates_dict = {}\r\n    \r\n    for wsym, sites in zip(wyckoff_symbols, equivalent_sites):\r\n        # Extract multiplicity (digits) and letter (alphabetic characters)\r\n        multiplicity = int(''.join(c for c in wsym if c.isdigit()))\r\n        letter = ''.join(c for c in wsym if c.isalpha())\r\n        \r\n        # Store multiplicity\r\n        wyckoff_multiplicity_dict[letter] = multiplicity\r\n        \r\n        # Get the first site's fractional coordinates\r\n        first_site = sites[0]\r\n        frac_coords = first_site.frac_coords\r\n        \r\n        # Convert to fraction strings\r\n        coord_strings = [decimal_to_fraction(c) for c in frac_coords]\r\n        wyckoff_coordinates_dict[letter] = coord_strings\r\n    \r\n    return {\r\n        \"wyckoff_multiplicity_dict\": wyckoff_multiplicity_dict,\r\n        \"wyckoff_coordinates_dict\": wyckoff_coordinates_dict\r\n    }\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    # Test with the example file\r\n    result = analyze_wyckoff_position_multiplicities_and_coordinates(\"/root/cif_files/FeS2_mp-226.cif\")\r\n    print(result)\r\n"]
[114.173196, "o", "\u001b[?2004hroot@7f0b73151ff8:~# "]
