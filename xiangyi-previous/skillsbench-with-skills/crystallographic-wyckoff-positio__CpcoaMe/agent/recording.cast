[47.439109, "i", "python3 << 'EOF'\nfrom pymatgen.core import Structure\nfrom pymatgen.symmetry.analyzer import SpacegroupAnalyzer\nfrom fractions import Fraction\n\ndef decimal_to_fraction(val, max_denom=12):\n    # Normalize to [0, 1)\n    val = val % 1.0\n    frac = Fraction(val).limit_denominator(max_denom)\n    if frac.denominator == 1:\n        return str(frac.numerator)\n    return f\"{frac.numerator}/{frac.denominator}\"\n\ns = Structure.from_file('/root/cif_files/FeS2_mp-226.cif')\nsga = SpacegroupAnalyzer(s)\nsymmetrized = sga.get_symmetrized_structure()\n\nwyckoff_symbols = symmetrized.wyckoff_symbols\nequivalent_sites = symmetrized.equivalent_sites\n\nprint(\"Wyckoff symbols:\", wyckoff_symbols)\n\nfor i, (wsym, sites) in enumerate(zip(wyckoff_symbols, equivalent_sites)):\n    # Extract letter and multiplicity\n    mult = int(''.join(c for c in wsym if c.isdigit()))\n    letter = ''.join(c for c in wsym if c.isalpha())\n    first_site = sites[0]\n    coords = first_site.frac_coords\n    print(f\"Wyckoff {letter}: mult={mult}, first coords={coords}\")\n    frac_coords = [decimal_to_fraction(c) for c in coords]\n    print(f\"  As fractions: {frac_coords}\")\nEOF\n"]
