[320.785267, "o", "    model = sbm.PhaseNet.from_pretrained('stead')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[320.785305, "o", "\u001b[?2004h> "]
[320.785378, "o", "    print('Picking phases...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.785555, "o", "    output = model.classify(stream, P_threshold=0.3, S_threshold=0.3)\r\n\u001b[?2004l\r\u001b[?2004h>     picks = output.picks\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.785623, "o", ">     print(f'Picked {len(picks)} phases')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[320.78566, "o", "\u001b[?2004h> "]
[320.785778, "o", "    # Organize picks by station\r\n\u001b[?2004l\r\u001b[?2004h>     picks_by_station = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.785816, "o", "    for p in picks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.785883, "o", "        parts = p.trace_id.split('.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.786548, "o", "        net = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h>         sta = parts[1]\r\n\u001b[?2004l\r\u001b[?2004h>         key = f'{net}.{sta}'\r\n\u001b[?2004l\r\u001b[?2004h>         if key not in picks_by_station:\r\n\u001b[?2004l\r"]
[320.7866, "o", "\u001b[?2004h> "]
[320.78674, "o", "            picks_by_station[key] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.786788, "o", "        picks_by_station[key].append(p)\r\n\u001b[?2004l\r"]
[320.78682, "o", "\u001b[?2004h> \r\n"]
[320.794066, "o", "\u001b[?2004l\r\u001b[?2004h"]
[320.7943, "o", ">     origin_times = []\r\n\u001b[?2004l\r\u001b[?2004h>     vp = 6.0\r\n\u001b[?2004l\r\u001b[?2004h>     vs = vp / 1.75\r\n\u001b[?2004l\r"]
[320.79436, "o", "\u001b[?2004h>     r = vp / vs\r\n\u001b[?2004l\r"]
[320.794403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[320.794447, "o", "> "]
[320.79467, "o", "    print('Associating...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.794717, "o", ">     for sta, p_list in picks_by_station.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.794838, "o", "        ps = [x for x in p_list if x.phase == 'P']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.794945, "o", "        ss = [x for x in p_list if x.phase == 'S']\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.795036, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.795131, "o", "        for p_pick in ps:\r\n\u001b[?2004l\r"]
[320.795244, "o", "\u001b[?2004h>             for s_pick in ss:\r\n\u001b[?2004l\r"]
[320.795284, "o", "\u001b[?2004h> "]
[320.79541, "o", "                if s_pick.peak_time > p_pick.peak_time:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.795543, "o", "                    dt = s_pick.peak_time - p_pick.peak_time\r\n\u001b[?2004l\r"]
[320.795686, "o", "\u001b[?2004h> "]
[320.79587, "o", "                    if dt < 60:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796016, "o", "                        t0_correction = dt / (r - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796148, "o", "                        t0 = p_pick.peak_time - t0_correction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796272, "o", "                        origin_times.append(t0.datetime.timestamp())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[320.796316, "o", ">     if not origin_times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796498, "o", "        print('No events associated.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.796672, "o", ">         pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796794, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.796927, "o", "    print(f'Generated {len(origin_times)} candidate origin times')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.797074, "o", "    X = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.797247, "o", "    # Clustering parameters: eps=5s, min_samples=3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.797381, "o", "    db = DBSCAN(eps=5, min_samples=3).fit(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.797453, "o", "    labels = db.labels_\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[320.797556, "o", "\u001b[?2004h>     events = []\r\n\u001b[?2004l\r"]
[320.797629, "o", "\u001b[?2004h>     unique_labels = set(labels)\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.797693, "o", "> "]
[320.797917, "o", "    n_clusters = len(unique_labels) - (1 if -1 in unique_labels else 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.79799, "o", "> "]
[320.798097, "o", "    print(f'Found {n_clusters} clusters')\r\n\u001b[?2004l\r\u001b[?2004h"]
[320.79816, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.798928, "o", "    for k in unique_labels:\r\n\u001b[?2004l\r\u001b[?2004h>         if k == -1:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         class_member_mask = (labels == k)\r\n\u001b[?2004l\r\u001b[?2004h>         cluster_times = X[class_member_mask]\r\n\u001b[?2004l\r\u001b[?2004h>         mean_time = np.mean(cluster_times)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799007, "o", "        dt_obj = datetime.utcfromtimestamp(mean_time)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799124, "o", "        t_iso = dt_obj.isoformat(timespec='milliseconds')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799208, "o", "        events.append(t_iso)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[320.799255, "o", "\u001b[?2004h> "]
[320.799301, "o", "    events.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799348, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799416, "o", "    df = pd.DataFrame({'time': events})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799541, "o", "    df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799705, "o", "    print(f'Results saved to /root/results.csv with {len(events)} events')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799755, "o", "    if len(events) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799851, "o", "        print(df.head())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[320.799975, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     solve()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[320.820271, "o", "\u001b[?2004hroot@f06751ee1c65:~# "]
[320.820351, "o", "python3 solve.py\r\n\u001b[?2004l\r"]
