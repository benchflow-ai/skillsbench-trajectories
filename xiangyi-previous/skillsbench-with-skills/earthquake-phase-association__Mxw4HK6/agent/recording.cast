[299.881704, "i", "cat > solve.py <<EOF\nimport seisbench.models as sbm\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom datetime import datetime\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef solve():\n    print('Loading data...')\n    stream = obspy.read('/root/data/wave.mseed')\n    print(f'Loaded {len(stream)} traces')\n\n    print('Loading PhaseNet...')\n    model = sbm.PhaseNet.from_pretrained('stead')\n    \n    print('Picking phases...')\n    output = model.classify(stream, P_threshold=0.3, S_threshold=0.3)\n    picks = output.picks\n    print(f'Picked {len(picks)} phases')\n\n    # Organize picks by station\n    picks_by_station = {}\n    for p in picks:\n        parts = p.trace_id.split('.')\n        net = parts[0]\n        sta = parts[1]\n        key = f'{net}.{sta}'\n        if key not in picks_by_station:\n            picks_by_station[key] = []\n        picks_by_station[key].append(p)\n\n    origin_times = []\n    vp = 6.0\n    vs = vp / 1.75\n    r = vp / vs\n\n    print('Associating...')\n    for sta, p_list in picks_by_station.items():\n        ps = [x for x in p_list if x.phase == 'P']\n        ss = [x for x in p_list if x.phase == 'S']\n        \n        for p_pick in ps:\n            for s_pick in ss:\n                if s_pick.peak_time > p_pick.peak_time:\n                    dt = s_pick.peak_time - p_pick.peak_time\n                    if dt < 60:\n                        t0_correction = dt / (r - 1)\n                        t0 = p_pick.peak_time - t0_correction\n                        origin_times.append(t0.datetime.timestamp())\n\n    if not origin_times:\n        print('No events associated.')\n        pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\n        return\n\n    print(f'Generated {len(origin_times)} candidate origin times')\n    \n    X = np.array(origin_times).reshape(-1, 1)\n    # Clustering parameters: eps=5s, min_samples=3\n    db = DBSCAN(eps=5, min_samples=3).fit(X)\n    labels = db.labels_\n\n    events = []\n    unique_labels = set(labels)\n    n_clusters = len(unique_lab"]
[299.882165, "o", "cat > solve.py <<EOF\r\nimport seisbench.models as sbm\r\nimport obspy\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.cluster import DBSCAN\r\nfrom datetime import datetime\r\nimport warnings\r\nwarnings.filterwarnings('ignore')\r\n\r\ndef solve():\r\n    print('Loading data...')\r\n    stream = obspy.read('/root/data/wave.mseed')\r\n    print(f'Loaded {len(stream)} traces')\r\n\r\n    print('Loading PhaseNet...')\r\n    model = sbm.PhaseNet.from_pretrained('stead')\r\n    \r\n    print('Picking phases...')\r\n    output = model.classify(stream, P_threshold=0.3, S_threshold=0.3)\r\n    picks = output.picks\r\n    print(f'Picked {len(picks)} phases')\r\n\r\n    # Organize picks by station\r\n    picks_by_station = {}\r\n    for p in picks:\r\n        parts = p.trace_id.split('.')\r\n        net = parts[0]\r\n        sta = parts[1]\r\n        key = f'{net}.{sta}'\r\n        if key not in picks_by_station:\r\n            picks_by_station[key] = []\r\n        picks_by_station[key].append(p)\r\n\r\n    origin_times = []\r\n    vp = 6.0\r\n    vs = vp / 1.75\r\n    r = vp / vs\r\n\r\n    print('Associating...')\r\n    for sta, p_list in picks_by_station.items():\r\n        ps = [x for x in p_list if x.phase == 'P']\r\n        ss = [x for x in p_list if x.phase == 'S']\r\n        \r\n        for p_pick in ps:\r\n            for s_pick in ss:\r\n                if s_pick.peak_time > p_pick.peak_time:\r\n                    dt = s_pick.peak_time - p_pick.peak_time\r\n                    if dt < 60:\r\n                        t0_correction = dt / (r - 1)\r\n                        t0 = p_pick.peak_time - t0_correction\r\n                        origin_times.append(t0.datetime.timestamp())\r\n\r\n    if not origin_times:\r\n        print('No events associated.')\r\n        pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\r\n        return\r\n\r\n    print(f'Generated {len(origin_times)} candidate origin times')\r\n    \r\n    X = np.array(origin_times).reshape(-1, 1)\r\n    # Clustering parameters: eps=5s, min_samples=3\r\n    db = DBSCAN(eps=5, min_samples=3).fit(X)\r\n    labels = db.labels_\r\n\r\n    events = []\r\n    unique_labels = set(labels)\r\n    n_clusters = len(unique_lab"]
[299.8822, "i", "els) - (1 if -1 in unique_labels else 0)\n    print(f'Found {n_clusters} clusters')\n\n    for k in unique_labels:\n        if k == -1:\n            continue\n        \n        class_member_mask = (labels == k)\n        cluster_times = X[class_member_mask]\n        mean_time = np.mean(cluster_times)\n        \n        dt_obj = datetime.utcfromtimestamp(mean_time)\n        t_iso = dt_obj.isoformat(timespec='milliseconds')\n        events.append(t_iso)\n\n    events.sort()\n    \n    df = pd.DataFrame({'time': events})\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Results saved to /root/results.csv with {len(events)} events')\n    if len(events) > 0:\n        print(df.head())\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
[299.882328, "o", "els) - (1 if -1 in unique_labels else 0)\r\n    print(f'Found {n_clusters} clusters')\r\n\r\n    for k in unique_labels:\r\n        if k == -1:\r\n            continue\r\n        \r\n        class_member_mask = (labels == k)\r\n        cluster_times = X[class_member_mask]\r\n        mean_time = np.mean(cluster_times)\r\n        \r\n        dt_obj = datetime.utcfromtimestamp(mean_time)\r\n        t_iso = dt_obj.isoformat(timespec='milliseconds')\r\n        events.append(t_iso)\r\n\r\n    events.sort()\r\n    \r\n    df = pd.DataFrame({'time': events})\r\n    df.to_csv('/root/results.csv', index=False)\r\n    print(f'Results saved to /root/results.csv with {len(events)} events')\r\n    if len(events) > 0:\r\n        print(df.head())\r\n\r\nif __name__ == '__main__':\r\n    solve()\r\nEOF\r\n"]
