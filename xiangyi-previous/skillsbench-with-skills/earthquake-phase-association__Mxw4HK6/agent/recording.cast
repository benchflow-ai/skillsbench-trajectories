[190.917825, "o", "    vs = vp / 1.75\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.917947, "o", "    r = vp / vs # 1.75"]
[190.918064, "o", "\r\n"]
[190.918161, "o", "\u001b[?2004l\r"]
[190.918204, "o", "\u001b[?2004h> "]
[190.918255, "o", "\r\n"]
[190.918423, "o", "\u001b[?2004l\r"]
[190.918512, "o", "\u001b[?2004h>     print('Associating...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.918661, "o", "> "]
[190.918797, "o", "    for sta, p_list in picks_by_station.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.918933, "o", "        # Separate P and S\r\n\u001b[?2004l\r\u001b[?2004h>         ps = [x for x in p_list if x.phase == 'P']"]
[190.91903, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.919124, "o", "        ss = [x for x in p_list if x.phase == 'S']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.919201, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.919459, "o", "        # Simple association: P and S on same station within time window\r\n\u001b[?2004l\r\u001b[?2004h>         for p_pick in ps:\r\n\u001b[?2004l\r"]
[190.919622, "o", "\u001b[?2004h> "]
[190.919678, "o", "            for s_pick in ss:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.919788, "o", "                # Check if S is after P\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.919878, "o", "> "]
[190.919969, "o", "                if s_pick.peak_time > p_pick.peak_time:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92006, "o", "                    dt = s_pick.peak_time - p_pick.peak_time\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.920138, "o", "> "]
[190.920288, "o", "                    # Assume local/regional events, S-P usually < 60s\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.920367, "o", "> "]
[190.920441, "o", "                    if dt < 60:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92065, "o", "                        # t0 = tP - (tS - tP) / (r - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.920749, "o", "                        t0_correction = dt / (r - 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.920789, "o", "> "]
[190.920931, "o", "                        t0 = p_pick.peak_time - t0_correction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.921183, "o", "                        origin_times.append(t0.datetime.timestamp())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.921279, "o", "    if not origin_times:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92138, "o", "        print('No events associated.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.921508, "o", "        # Create empty file or handle error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.921726, "o", "        pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.921819, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.921924, "o", "\u001b[?2004h> "]
[190.922042, "o", "    print(f'Generated {len(origin_times)} candidate origin times')\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.922156, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.922259, "o", "    # Clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.922338, "o", "    X = np.array(origin_times).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.922376, "o", "> "]
[190.922679, "o", "    # eps=3 seconds (generous for P-S picking errors), min_samples=3 (need support from multiple stations/phases)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92287, "o", "    # Adjust min_samples based on data volume. If network is sparse, maybe 2.\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.922898, "o", "> "]
[190.923013, "o", "    # Let's try min_samples=3 first.\r\n\u001b[?2004l\r"]
[190.92304, "o", "\u001b[?2004h> "]
[190.923165, "o", "    db = DBSCAN(eps=5, min_samples=3).fit(X)\r\n\u001b[?2004l\r"]
[190.923191, "o", "\u001b[?2004h> "]
[190.923295, "o", "    labels = db.labels_\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.923321, "o", "> \r\n\u001b[?2004l\r"]
[190.923345, "o", "\u001b[?2004h"]
[190.923368, "o", "> "]
[190.923549, "o", "    events = []\r\n\u001b[?2004l\r\u001b[?2004h>     unique_labels = set(labels)\r\n\u001b[?2004l\r"]
[190.923577, "o", "\u001b[?2004h> "]
[190.923812, "o", "    print(f'Found {len(unique_labels) - (1 if -1 in unique_labels else 0)} clusters')\r\n\u001b[?2004l\r"]
[190.92384, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.923943, "o", "\u001b[?2004h>     for k in unique_labels:\r\n\u001b[?2004l\r"]
[190.923972, "o", "\u001b[?2004h"]
[190.923996, "o", "> "]
[190.924121, "o", "        if k == -1:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r"]
[190.924148, "o", "\u001b[?2004h> "]
[190.924168, "o", "        \r\n\u001b[?2004l\r"]
[190.924189, "o", "\u001b[?2004h"]
[190.924338, "o", ">         class_member_mask = (labels == k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.924453, "o", "        cluster_times = X[class_member_mask]\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.924481, "o", "> "]
[190.924587, "o", "        mean_time = np.mean(cluster_times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.924683, "o", "> "]
[190.924785, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92481, "o", "        # Convert to ISO format\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.92491, "o", "        # SeisBench/Obspy uses UTC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.925071, "o", "        t_iso = datetime.utcfromtimestamp(mean_time).isoformat(timespec='milliseconds')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.925158, "o", "        events.append(t_iso)\r\n\u001b[?2004l\r"]
[190.925186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.925209, "o", "\u001b[?2004h> "]
[190.925337, "o", "    # Sort events by time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.925363, "o", "    events.sort()\r\n\u001b[?2004l\r"]
[190.925386, "o", "\u001b[?2004h"]
[190.925415, "o", "> "]
[190.925439, "o", "    \r\n\u001b[?2004l\r"]
[190.92547, "o", "\u001b[?2004h> "]
[190.925689, "o", "    # Save\r\n\u001b[?2004l\r\u001b[?2004h>     df = pd.DataFrame({'time': events})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.925782, "o", "    df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[190.92581, "o", "\u001b[?2004h> "]
[190.925992, "o", "    print('Results saved to /root/results.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
