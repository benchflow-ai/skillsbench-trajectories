[77.468998, "o", "        B[n + i, i] = R / J\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.469059, "o", ">     return A, B\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.46914, "o", "> "]
[77.469194, "o", "def discretize_system(A, B, dt):\r\n\u001b[?2004l\r\u001b[?2004h>     n = A.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469232, "o", "    m = B.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469372, "o", "    M = np.zeros((n + m, n + m))\r\n\u001b[?2004l\r\u001b[?2004h>     M[:n, :n] = A * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469425, "o", "    M[:n, n:] = B * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469496, "o", "    expM = linalg.expm(M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469579, "o", "    return expM[:n, :n], expM[:n, n:]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.469643, "o", "def compute_lqr_gain(A, B, Q, R):\r\n\u001b[?2004l\r\u001b[?2004h> "]
