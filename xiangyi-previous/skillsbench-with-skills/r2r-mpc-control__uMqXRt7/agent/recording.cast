[6.693056, "o", "drwx------ 1 root root 4096 Jan 26 13:25 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root 4096 Jan 26 13:26 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.agents\u001b[0m\r\n-rw-r--r-- 1 root root 3106 Apr 22  2024 .bashrc\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.cache\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.claude\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.codex\u001b[0m\r\ndrwxr-xr-x 4 root root 4096 Jan 26 13:26 \u001b[01;34m.config\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.factory\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.gemini\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.goose\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 13:11 \u001b[01;34m.opencode\u001b[0m\r\n-rw-r--r-- 1 root root  161 Apr 22  2024 .profile\r\n-rw-r--r-- 1 root root 6709 Jan 25 20:43 r2r_simulator.py\r\n-rw-r--r-- 1 root root  304 Jan 25 20:43 system_config.json\r\n"]
