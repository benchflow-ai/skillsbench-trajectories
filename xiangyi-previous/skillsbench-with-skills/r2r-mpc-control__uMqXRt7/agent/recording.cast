[77.468157, "o", ">     for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.468213, "o", ">         A[i, i] = -v_ref[i] / L\r\n\u001b[?2004l\r"]
[77.468266, "o", "\u001b[?2004h>         if i > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.468376, "o", "            A[i, i-1] = v_ref[i-1] / L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.468442, "o", "        A[i, n + i] = (EA - T_ref[i]) / L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.468497, "o", "        if i > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.468582, "o", "            A[i, n + i - 1] = -(EA - T_ref[i-1]) / L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.46865, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
