[17.451857, "o", "Paragraphs with placeholders:\r\n"]
[17.452129, "o", "1 '{{COMPANY_NAME}}'\r\n"]
[17.452287, "o", "3 'Date: {{DATE}}'\r\n"]
[17.452376, "o", "5 '{{CANDIDATE_FULL_NAME}}'\r\n"]
[17.452437, "o", "6 '{{STREET_ADDRESS}}'\r\n"]
[17.45268, "o", "7 '{{CITY}}, {{STATE}} {{ZIP_CODE}}'\r\n"]
[17.452836, "o", "9 'RE: Offer of Employment - {{POSITION}}'\r\n"]
[17.452945, "o", "11 'Dear {{CANDIDATE_FULL_NAME}},'\r\n"]
[17.453178, "o", "13 'We are pleased to extend an offer of employment for the position of {{POSITION}} in our {{DEPARTMENT}} department.'\r\n"]
