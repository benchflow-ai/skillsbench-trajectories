[31.338927, "i", "python3 - <<'PY'\nimport json\nfrom docx import Document\n\nwith open('employee_data.json') as f:\n    data=json.load(f)\n\nreloc_yes = str(data.get('RELOCATION_PACKAGE','')).strip().lower() == 'yes'\n\n\ndef process_text(text):\n    # handle conditional relocation block\n    if '{{IF_RELOCATION}}' in text and '{{END_IF_RELOCATION}}' in text:\n        start = text.index('{{IF_RELOCATION}}')\n        end = text.index('{{END_IF_RELOCATION}}')\n        inner = text[start+len('{{IF_RELOCATION}}'):end]\n        if reloc_yes:\n            text = text[:start] + inner + text[end+len('{{END_IF_RELOCATION}}'):]\n        else:\n            text = text[:start] + text[end+len('{{END_IF_RELOCATION}}'):]\n    # replace placeholders\n    for k,v in data.items():\n        text = text.replace('{{'+k+'}}', str(v))\n    return text\n\n\ndoc=Document('offer_letter_template.docx')\n\nfor p in doc.paragraphs:\n    if '{{' in p.text:\n        new_text = process_text(p.text)\n        if new_text != p.text:\n            p.text = new_text\n\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for p in cell.paragraphs:\n                if '{{' in p.text:\n                    new_text = process_text(p.text)\n                    if new_text != p.text:\n                        p.text = new_text\n\noutput = '/root/offer_letter_filled.docx'\n\ndoc.save(output)\nprint('saved', output)\nPY\n"]
