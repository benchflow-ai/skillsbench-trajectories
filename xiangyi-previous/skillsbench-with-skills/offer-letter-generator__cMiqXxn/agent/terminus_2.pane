[?2004hroot@f337d396456a:~# python3 - <<'PY'
[?2004l[?2004h> import json
[?2004l[?2004h> from docx import Document
[?2004l[?2004h> 
[?2004l[?2004h> with open('employee_data.json') as f:
[?2004l[?2004h>     data=json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> reloc_yes = str(data.get('RELOCATION_PACKAGE','')).strip().lower() == 'yes'
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def process_text(text):
[?2004l[?2004h>     # handle conditional relocation block
[?2004l[?2004h>     if '{{IF_RELOCATION}}' in text and '{{END_IF_RELOCATION}}' in text:
[?2004l[?2004h>         start = text.index('{{IF_RELOCATION}}')
[?2004l[?2004h>         end = text.index('{{END_IF_RELOCATION}}')
[?2004l[?2004h>         inner = text[start+len('{{IF_RELOCATION}}'):end]
[?2004l[?2004h>         if reloc_yes:
[?2004l[?2004h>             text = text[:start] + inner + text[end+len('{{END_IF_RELOCATION}}'):]
[?2004l[?2004h>         else:
[?2004l[?2004h>             text = text[:start] + text[end+len('{{END_IF_RELOCATION}}'):]
[?2004l[?2004h>     # replace placeholders
[?2004l[?2004h>     for k,v in data.items():
[?2004l[?2004h>         text = text.replace('{{'+k+'}}', str(v))
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> doc=Document('offer_letter_template.docx')
[?2004l[?2004h> 
[?2004l[?2004h> for p in doc.paragraphs:
[?2004l[?2004h>     if '{{' in p.text:
[?2004l[?2004h>         new_text = process_text(p.text)
[?2004l[?2004h>         if new_text != p.text:
[?2004l[?2004h>             p.text = new_text
[?2004l[?2004h> 
[?2004l[?2004h> for table in doc.tables:
[?2004l[?2004h>     for row in table.rows:
[?2004l[?2004h>         for cell in row.cells:
[?2004l[?2004h>             for p in cell.paragraphs:
[?2004l[?2004h>                 if '{{' in p.text:
[?2004l[?2004h>                     new_text = process_text(p.text)
[?2004l[?2004h>                     if new_text != p.text:
[?2004l[?2004h>                         p.text = new_text
[?2004l[?2004h> 
[?2004l[?2004h> output = '/root/offer_letter_filled.docx'
[?2004l[?2004h> 
[?2004l[?2004h> doc.save(output)
[?2004l[?2004h> print('saved', output)
[?2004l[?2004h> PY
