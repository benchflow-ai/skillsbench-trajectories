[?2004l[?2004h>     if "January 8" in text and "January 9" in text:
[?2004l[?2004h>         possible_dates = [datetime.date(2026, 1, 8), datetime.date(2026, 1, 9)]
[?2004l[?2004h>     elif "January 6" in text and "7th" in text:
[?2004l[?2004h>         possible_dates = [datetime.date(2026, 1, 6), datetime.date(2026, 1, 7)]
[?2004l[?2004h>     elif "January 8" in text:
[?2004l[?2004h>          possible_dates = [datetime.date(2026, 1, 8)]
[?2004l[?2004h>          
[?2004l[?2004h>     # Extract time constraints
[?2004l[?2004h>     start_hour = 9
[?2004l[?2004h>     end_hour = 17
[?2004l[?2004h>     
