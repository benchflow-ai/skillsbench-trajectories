[?2004l[?2004h> def main():
[?2004l[?2004h>     # Load input
[?2004l[?2004h>     with open(INPUT_FILE, 'r') as f:
[?2004l[?2004h>         requests = json.load(f)
[?2004l[?2004h>         
[?2004l[?2004h>     # Auth
[?2004l[?2004h>     try:
[?2004l[?2004h>         calendar_service = get_service('calendar', CALENDAR_TOKEN_PATH, SCOPES_CALENDAR)
[?2004l[?2004h>         gmail_service = get_service('gmail', GMAIL_TOKEN_PATH, SCOPES_GMAIL)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(e)
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     sent_results = []
[?2004l[?2004h> 
[?2004l[?2004h>     for req in requests:
[?2004l[?2004h>         email_text = req['email_text']
[?2004l[?2004h>         from_email = req['from_email']
[?2004l[?2004h>         
[?2004l[?2004h>         constraints = parse_email_content(email_text)
[?2004l[?2004h>         
