[?2004l[?2004h>     # Example 3: "9:30am and 11:30am"
[?2004l[?2004h>     
[?2004l[?2004h>     time_match = re.search(r'(\d{1,2}:?\d{0,2})\s*(am|pm)?\s*(to|and)\s*(\d{1,2}:?\d{0,2})\s*(am|pm)', text, re.IGNORECASE)
[?2004l[?2004h>     if time_match:
