[?2004l[?2004h> def check_calendar_availability(service, date, start_time_constraint, end_time_constraint, duration_hours):
[?2004l[?2004h>     # Define the search window for the day
[?2004l[?2004h>     time_min = datetime.datetime.combine(date, start_time_constraint).isoformat() + 'Z'
[?2004l[?2004h>     time_max = datetime.datetime.combine(date, end_time_constraint).isoformat() + 'Z'
[?2004l[?2004h>     
[?2004l[?2004h>     events_result = service.events().list(calendarId='primary', timeMin=time_min, timeMax=time_max, singleEvents=True, orderBy='startTime').execute()
[?2004l[?2004h>     events = events_result.get('items', [])
[?2004l[?2004h>     
[?2004l[?2004h>     # Find a slot
[?2004l[?2004h>     current_start = datetime.datetime.combine(date, start_time_constraint)
[?2004l[?2004h>     window_end = datetime.datetime.combine(date, end_time_constraint)
[?2004l[?2004h>     
[?2004l[?2004h>     # Iterate through events to find gaps
[?2004l[?2004h>     # We need to sort events just in case
[?2004l[?2004h>     busy_slots = []
[?2004l[?2004h>     for event in events:
[?2004l[?2004h>         start = event['start'].get('dateTime', event['start'].get('date'))
[?2004l[?2004h>         end = event['end'].get('dateTime', event['end'].get('date'))
[?2004l[?2004h>         # Parse to datetime objects (naive for simplicity, assuming local time matches)
[?2004l[?2004h>         # Note: The API returns RFC3339 timestamps (e.g., 2026-01-08T10:00:00-07:00). We should handle timezones properly or assume local.
[?2004l[?2004h>         # For this task, let's assume everything is in the same timezone or ignore offset for simplicity if possible, 
[?2004l[?2004h>         # but correct way is to use dateutil parser.
[?2004l[?2004h>         busy_slots.append((date_parser.parse(start), date_parser.parse(end)))
[?2004l[?2004h>         
[?2004l[?2004h>     # Sort busy slots
[?2004l[?2004h>     busy_slots.sort(key=lambda x: x[0])
[?2004l[?2004h>     
[?2004l[?2004h>     # Try to fit the meeting
[?2004l[?2004h>     meeting_duration = datetime.timedelta(hours=duration_hours)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check availability
[?2004l[?2004h>     # Simplification: Convert everything to offset-naive for comparison if we assume same timezone context
[?2004l[?2004h>     # Or better, keep offsets. Let's try to find the first gap.
[?2004l[?2004h>     
[?2004l[?2004h>     # We need to ensure current_start has timezone info if busy_slots do.
[?2004l[?2004h>     # Let's assume the calendar events have timezone info. We should add timezone info to current_start.
[?2004l[?2004h>     # However, we don't know the local timezone easily without querying settings. 
[?2004l[?2004h>     # Let's try to infer from the first event or default to UTC if no events.
[?2004l[?2004h>     
[?2004l[?2004h>     tzinfo = datetime.timezone.utc
[?2004l[?2004h>     if busy_slots:
[?2004l[?2004h>         tzinfo = busy_slots[0][0].tzinfo
[?2004l[?2004h>         
[?2004l[?2004h>     current_start = current_start.replace(tzinfo=tzinfo)
[?2004l[?2004h>     window_end = window_end.replace(tzinfo=tzinfo)
[?2004l[?2004h>     
[?2004l[?2004h>     for busy_start, busy_end in busy_slots:
[?2004l[?2004h>         if current_start + meeting_duration <= busy_start:
[?2004l[?2004h>             return current_start, current_start + meeting_duration
[?2004l[?2004h>         current_start = max(current_start, busy_end)
[?2004l[?2004h>         
[?2004l[?2004h>     if current_start + meeting_duration <= window_end:
[?2004l[?2004h>         return current_start, current_start + meeting_duration
[?2004l[?2004h>         
[?2004l[?2004h>     return None, None
[?2004l[?2004h> 
[?2004l[?2004h> def send_email(service, to_email, subject, body_text):
[?2004l[?2004h>     message = MIMEText(body_text)
[?2004l[?2004h>     message['to'] = to_email
[?2004l[?2004h>     message['subject'] = subject
[?2004l[?2004h>     raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')
[?2004l[?2004h>     body = {'raw': raw_message}
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         message = service.users().messages().send(userId='me', body=body).execute()
[?2004l[?2004h>         return message['id']
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'An error occurred: {e}')
[?2004l[?2004h>         return None
