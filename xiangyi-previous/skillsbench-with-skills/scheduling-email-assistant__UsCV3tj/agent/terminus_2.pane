[?2004l[?2004h>     # Example 3: "January 6th or 7th, 2026"
[?2004l[?2004h>     
[?2004l[?2004h>     year = 2026 # Hardcoded based on examples, or extract
[?2004l[?2004h>     
[?2004l[?2004h>     possible_dates = []
[?2004l[?2004h>     
[?2004l [?2004h>     # Normalize text for easier parsing
[?2004l[?2004h>     norm_text = text.replace('th,', ',').replace('st,', ',').replace('nd,', ',').replace('rd,', ',')
[?2004l[?2004h>     
