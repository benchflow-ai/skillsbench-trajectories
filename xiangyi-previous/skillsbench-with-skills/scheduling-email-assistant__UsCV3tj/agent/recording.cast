[319.741075, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.741108, "o", "> "]
[319.741227, "o", "                h = int(t_str)\r\n\u001b[?2004l\r"]
[319.741265, "o", "\u001b[?2004h> "]
[319.741365, "o", "                m = 0\r\n\u001b[?2004l\r"]
[319.741395, "o", "\u001b[?2004h> "]
[319.741644, "o", "            if ampm and ampm.lower() == 'pm' and h != 12:\r\n\u001b[?2004l\r"]
[319.741672, "o", "\u001b[?2004h> "]
[319.741807, "o", "                h += 12\r\n\u001b[?2004l\r"]
[319.741838, "o", "\u001b[?2004h> "]
[319.742093, "o", "            if ampm and ampm.lower() == 'am' and h == 12:\r\n\u001b[?2004l\r"]
[319.742123, "o", "\u001b[?2004h> "]
[319.742239, "o", "                h = 0\r\n\u001b[?2004l\r"]
[319.74227, "o", "\u001b[?2004h> "]
[319.742424, "o", "            return datetime.time(h, m)\r\n\u001b[?2004l\r"]
[319.74245, "o", "\u001b[?2004h> "]
[319.742529, "o", "            \r\n\u001b[?2004l\r"]
[319.742557, "o", "\u001b[?2004h> "]
[319.742752, "o", "        start_time = parse_time(t1_str, t1_ampm)\r\n\u001b[?2004l\r"]
[319.742781, "o", "\u001b[?2004h> "]
[319.742976, "o", "        end_time = parse_time(t2_str, t2_ampm)\r\n\u001b[?2004l\r"]
[319.743003, "o", "\u001b[?2004h> "]
[319.743064, "o", "    else:\r\n\u001b[?2004l\r"]
[319.74309, "o", "\u001b[?2004h> "]
[319.743217, "o", "        # Fallback default\r\n\u001b[?2004l\r"]
[319.743247, "o", "\u001b[?2004h> "]
[319.743428, "o", "        start_time = datetime.time(9, 0)\r\n\u001b[?2004l\r"]
[319.743456, "o", "\u001b[?2004h> "]
[319.743648, "o", "        end_time = datetime.time(17, 0)\r\n\u001b[?2004l\r"]
[319.743674, "o", "\u001b[?2004h> "]
[319.743744, "o", "        \r\n\u001b[?2004l\r"]
[319.74377, "o", "\u001b[?2004h> "]
[319.743842, "o", "    return {\r\n\u001b[?2004l\r"]
[319.743867, "o", "\u001b[?2004h> "]
[319.744013, "o", "        'duration': duration,\r\n\u001b[?2004l\r"]
[319.744039, "o", "\u001b[?2004h"]
[319.744064, "o", "> "]
[319.74421, "o", "        'dates': possible_dates,\r\n\u001b[?2004l\r"]
[319.744239, "o", "\u001b[?2004h> "]
[319.744402, "o", "        'start_time': start_time,\r\n\u001b[?2004l\r"]
[319.744429, "o", "\u001b[?2004h> "]
[319.74477, "o", "        'end_time': end_time\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.745615, "o", "def check_calendar_availability(service, date, start_time_constraint, end_time_constraint, duration_hours):\r\n\u001b[?2004l\r\u001b[?2004h>     # Define the search window for the day\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.745746, "o", "    time_min = datetime.datetime.combine(date, start_time_constraint).isoformat() + 'Z'\r\n\u001b[?2004l\r"]
[319.745794, "o", "\u001b[?2004h> "]
[319.746351, "o", "    time_max = datetime.datetime.combine(date, end_time_constraint).isoformat() + 'Z'\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[319.746403, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.747109, "o", "    events_result = service.events().list(calendarId='primary', timeMin=time_min, timeMax=time_max, singleEvents=True, orderBy='startTime').execute()\r\n\u001b[?2004l\r"]
[319.747147, "o", "\u001b[?2004h> "]
[319.747486, "o", "    events = events_result.get('items', [])\r\n\u001b[?2004l\r"]
[319.747525, "o", "\u001b[?2004h> "]
[319.747557, "o", "    \r\n\u001b[?2004l\r"]
[319.747592, "o", "\u001b[?2004h> "]
[319.747823, "o", "    # Find a slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.748063, "o", "    current_start = datetime.datetime.combine(date, start_time_constraint)\r\n\u001b[?2004l\r"]
[319.748091, "o", "\u001b[?2004h> "]
[319.7484, "o", "    window_end = datetime.datetime.combine(date, end_time_constraint)\r\n\u001b[?2004l\r"]
[319.748428, "o", "\u001b[?2004h> "]
[319.748569, "o", "    \r\n\u001b[?2004l\r"]
[319.748602, "o", "\u001b[?2004h> "]
[319.748736, "o", "    # Iterate through events to find gaps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.748876, "o", "    # We need to sort events just in case\r\n\u001b[?2004l\r"]
[319.748913, "o", "\u001b[?2004h> "]
[319.74904, "o", "    busy_slots = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.749147, "o", "    for event in events:\r\n\u001b[?2004l\r"]
[319.749185, "o", "\u001b[?2004h> "]
[319.749497, "o", "        start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r"]
[319.749531, "o", "\u001b[?2004h> "]
[319.749848, "o", "        end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r"]
[319.749886, "o", "\u001b[?2004h> "]
[319.750276, "o", "        # Parse to datetime objects (naive for simplicity, assuming local time matches)\r\n\u001b[?2004l\r"]
[319.750304, "o", "\u001b[?2004h> "]
[319.750912, "o", "        # Note: The API returns RFC3339 timestamps (e.g., 2026-01-08T10:00:00-07:00). We should handle timezones properly or assume local.\r\n\u001b[?2004l\r"]
[319.75094, "o", "\u001b[?2004h> "]
[319.751452, "o", "        # For this task, let's assume everything is in the same timezone or ignore offset for simplicity if possible, \r\n\u001b[?2004l\r"]
[319.751496, "o", "\u001b[?2004h> "]
[319.751731, "o", "        # but correct way is to use dateutil parser.\r\n\u001b[?2004l\r"]
[319.751762, "o", "\u001b[?2004h> "]
[319.752087, "o", "        busy_slots.append((date_parser.parse(start), date_parser.parse(end)))\r\n\u001b[?2004l\r"]
[319.752118, "o", "\u001b[?2004h> "]
[319.752157, "o", "        \r\n\u001b[?2004l\r"]
[319.752201, "o", "\u001b[?2004h> "]
[319.752393, "o", "    # Sort busy slots\r\n\u001b[?2004l\r\u001b[?2004h>     busy_slots.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.752502, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.752599, "o", "    # Try to fit the meeting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.752755, "o", "    meeting_duration = datetime.timedelta(hours=duration_hours)\r\n\u001b[?2004l\r"]
[319.752854, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.752946, "o", "    # Check availability\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.753174, "o", "    # Simplification: Convert everything to offset-naive for comparison if we assume same timezone context"]
[319.753275, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.753386, "o", "    # Or better, keep offsets. Let's try to find the first gap.\r\n\u001b[?2004l\r"]
[319.753483, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.75363, "o", "    # We need to ensure current_start has timezone info if busy_slots do.\r\n\u001b[?2004l\r"]
[319.753726, "o", "\u001b[?2004h> "]
[319.756492, "o", "    # Let's assume the calendar events have timezone info. We should add timezone info to current_start.\r\n\u001b[?2004l\r"]
[319.756723, "o", "\u001b[?2004h"]
[319.756848, "o", "> "]
[319.757162, "o", "    # However, we don't know the local timezone easily without querying settings. "]
[319.757275, "o", "\r\n"]
[319.757377, "o", "\u001b[?2004l\r"]
[319.757514, "o", "\u001b[?2004h"]
[319.757628, "o", "> "]
[319.757946, "o", "    # Let's try to infer from the first event or default to UTC if no events."]
[319.758058, "o", "\r\n"]
[319.758158, "o", "\u001b[?2004l\r"]
[319.758286, "o", "\u001b[?2004h"]
[319.761814, "o", "> "]
[319.762065, "o", "    "]
[319.762166, "o", "\r\n"]
[319.762256, "o", "\u001b[?2004l\r"]
[319.762377, "o", "\u001b[?2004h"]
[319.762479, "o", "> "]
[319.762646, "o", "    tzinfo = datetime.timezone.utc"]
[319.762737, "o", "\r\n"]
[319.762826, "o", "\u001b[?2004l\r"]
[319.762937, "o", "\u001b[?2004h"]
[319.763035, "o", "> "]
[319.763164, "o", "    if busy_slots:"]
[319.76326, "o", "\r\n"]
[319.76335, "o", "\u001b[?2004l\r"]
[319.763457, "o", "\u001b[?2004h"]
[319.764023, "o", "> "]
[319.764258, "o", "        tzinfo = busy_slots[0][0].tzinfo"]
[319.764368, "o", "\r\n"]
[319.764466, "o", "\u001b[?2004l\r"]
[319.764598, "o", "\u001b[?2004h"]
[319.764709, "o", "> "]
[319.764823, "o", "        "]
[319.764914, "o", "\r\n"]
[319.765013, "o", "\u001b[?2004l\r"]
[319.765145, "o", "\u001b[?2004h"]
[319.765265, "o", "> "]
[319.765517, "o", "    current_start = current_start.replace(tzinfo=tzinfo)"]
[319.765625, "o", "\r\n"]
[319.765732, "o", "\u001b[?2004l\r"]
[319.765884, "o", "\u001b[?2004h"]
[319.766009, "o", "> "]
[319.766241, "o", "    window_end = window_end.replace(tzinfo=tzinfo)"]
[319.766358, "o", "\r\n"]
[319.766468, "o", "\u001b[?2004l\r"]
[319.766604, "o", "\u001b[?2004h"]
[319.766723, "o", "> "]
[319.766842, "o", "    "]
[319.766946, "o", "\r\n"]
[319.767049, "o", "\u001b[?2004l\r"]
[319.767173, "o", "\u001b[?2004h"]
[319.767289, "o", "> "]
[319.767907, "o", "    for busy_start, busy_end in busy_slots:\r\n\u001b[?2004l\r\u001b[?2004h>         if current_start + meeting_duration <= busy_start:\r\n\u001b[?2004l\r\u001b[?2004h>             return current_start, current_start + meeting_duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.768109, "o", "        current_start = max(current_start, busy_end)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[319.768235, "o", ">     if current_start + meeting_duration <= window_end:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.768342, "o", "        return current_start, current_start + meeting_duration\r\n\u001b[?2004l\r"]
[319.768529, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.768675, "o", "def send_email(service, to_email, subject, body_text):\r\n\u001b[?2004l\r\u001b[?2004h>     message = MIMEText(body_text)\r\n\u001b[?2004l\r"]
[319.768784, "o", "\u001b[?2004h> "]
[319.768884, "o", "    message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h>     message['subject'] = subject\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.769117, "o", ">     raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.76928, "o", "    body = {'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.769504, "o", "        message = service.users().messages().send(userId='me', body=body).execute()\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.769668, "o", ">         return message['id']\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n"]
[319.769904, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[319.770057, "o", "        print(f'An error occurred: {e}')\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     # Load input\r\n\u001b[?2004l\r"]
[319.770199, "o", "\u001b[?2004h>     with open(INPUT_FILE, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.770307, "o", "        requests = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.770437, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>     # Auth\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.77055, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.773891, "o", "        calendar_service = get_service('calendar', CALENDAR_TOKEN_PATH, SCOPES_CALENDAR)\r\n\u001b[?2004l\r\u001b[?2004h>         gmail_service = get_service('gmail', GMAIL_TOKEN_PATH, SCOPES_GMAIL)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(e)\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     sent_results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for req in requests:\r\n\u001b[?2004l\r\u001b[?2004h>         email_text = req['email_text']\r\n\u001b[?2004l\r\u001b[?2004h>         from_email = req['from_email']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         constraints = parse_email_content(email_text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         proposed_start = None\r\n\u001b[?2004l\r\u001b[?2004h>         proposed_end = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         for date in constraints['dates']:\r\n\u001b[?2004l\r\u001b[?2004h>             start, end = check_calendar_availability(\r\n\u001b[?2004l\r\u001b[?2004h>                 calendar_service, \r\n\u001b[?2004l\r\u001b[?2004h>                 date, \r\n\u001b[?2004l\r\u001b[?2004h>                 constraints['start_time'], \r\n\u001b[?2004l\r\u001b[?2004h>                 constraints['end_time'], \r\n\u001b[?2004l\r\u001b[?2004h>                 constraints['duration']\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h>             if start:\r\n\u001b[?2004l\r\u001b[?2004h>                 proposed_start = start\r\n\u001b[?2004l\r\u001b[?2004h>                 proposed_end = end\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if proposed_start:\r\n\u001b[?2004l\r\u001b[?2004h>             # Format the reply\r\n\u001b[?2004l\r\u001b[?2004h>             day_name = proposed_start.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h>             month = proposed_start.strftime('%B')\r\n\u001b[?2004l\r\u001b[?2004h>             dd = proposed_start.strftime('%d')\r\n\u001b[?2004l\r\u001b[?2004h>             yyyy = proposed_start.strftime('%Y')\r\n\u001b[?2004l\r\u001b[?2004h>             date_formatted = f\"{month} {dd}, {yyyy}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.774189, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h>             time_range = f\"{proposed_start.strftime('%I:%M %p')} - {proposed_end.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[319.774339, "o", "\u001b[?2004h> "]
[319.774896, "o", "            reply_body = f\"Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: {day_name}, {date_formatted}\\nTime: {time_range}\\nDuration: {constraints['duration']} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench\"\r\n\u001b[?2004l\r"]
[319.775092, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.775221, "o", "            print(f\"Sending email to {from_email}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.7754, "o", "            msg_id = send_email(gmail_service, from_email, \"Re: Meeting Request\", reply_body)\r\n\u001b[?2004l\r"]
[319.775516, "o", "\u001b[?2004h>             if msg_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.775629, "o", "                sent_results.append({\"messageId\": msg_id})\r\n\u001b[?2004l\r"]
[319.775731, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.775842, "o", "            print(f\"Could not find a slot for request from {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.775954, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h>     # Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.77606, "o", "    with open(RESULTS_FILE, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.776172, "o", "        json.dump({\"sent_results\": sent_results}, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.77628, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.776393, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
