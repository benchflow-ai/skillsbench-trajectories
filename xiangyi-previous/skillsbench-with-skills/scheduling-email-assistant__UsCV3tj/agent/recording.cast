[701.89319, "o", "def parse_email_content(text):\r\n\u001b[?2004l\r\u001b[?2004h>     # Extract duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[701.893257, "o", ">     duration = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893325, "o", "    if '1.5 hour' in text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[701.89339, "o", ">         duration = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893502, "o", "    elif 'one-hour' in text or '1 hour' in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893568, "o", "        duration = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893637, "o", "    elif '45-minute' in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893703, "o", "        duration = 0.75\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.893769, "o", "    # Dates\r\n\u001b[?2004l\r\u001b[?2004h>     possible_dates = []\r\n\u001b[?2004l\r"]
[701.8939, "o", "\u001b[?2004h> "]
[701.893982, "o", "    if \"January 8\" in text and \"January 9\" in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894051, "o", "        possible_dates = [datetime.date(2026, 1, 8), datetime.date(2026, 1, 9)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894116, "o", "    elif \"January 6\" in text and \"7th\" in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894246, "o", "        possible_dates = [datetime.date(2026, 1, 6), datetime.date(2026, 1, 7)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894315, "o", "    elif \"January 8\" in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894409, "o", "         possible_dates = [datetime.date(2026, 1, 8)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894467, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894525, "o", "         # Default fallback if parsing fails\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894621, "o", "         possible_dates = [datetime.date(2026, 1, 8)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.89468, "o", "         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894735, "o", "    # Time constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894787, "o", "    start_time = datetime.time(9, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.894848, "o", "    end_time = datetime.time(17, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.8949, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895097, "o", "    time_match = re.search(r'(\\d{1,2}:?\\d{0,2})\\s*(am|pm)?\\s*(to|and|between)\\s*(\\d{1,2}:?\\d{0,2})\\s*(am|pm)', text, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895166, "o", "    if time_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895226, "o", "        t1_str = time_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895298, "o", "        t1_ampm = time_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895368, "o", "        t2_str = time_match.group(4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895433, "o", "        t2_ampm = time_match.group(5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895491, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.89556, "o", "        if not t1_ampm and t2_ampm: t1_ampm = t2_ampm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895655, "o", "        if not t2_ampm and t1_ampm: t2_ampm = t1_ampm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895714, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895772, "o", "        def parse_time(t_str, ampm):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895825, "o", "            if ':' in t_str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895914, "o", "                h, m = map(int, t_str.split(':'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.895973, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896027, "o", "                h = int(t_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896079, "o", "                m = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896166, "o", "            if ampm and ampm.lower() == 'pm' and h != 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.89622, "o", "                h += 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896331, "o", "            if ampm and ampm.lower() == 'am' and h == 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896384, "o", "                h = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896452, "o", "            return datetime.time(h, m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896503, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896556, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896622, "o", "            start_time = parse_time(t1_str, t1_ampm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896712, "o", "            end_time = parse_time(t2_str, t2_ampm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896765, "o", "        except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896819, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[701.896873, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896934, "o", "        'duration': duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.896999, "o", "        'dates': possible_dates,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897066, "o", "        'start_time': start_time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897134, "o", "        'end_time': end_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897187, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897267, "o", "def send_email(service, to_email, subject, body_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897337, "o", "    message = MIMEText(body_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897398, "o", "    message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897464, "o", "    message['subject'] = subject\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897598, "o", "    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897671, "o", "    body = {'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897725, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.89788, "o", "        message = service.users().messages().send(userId='me', body=body).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.897947, "o", "        return message['id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898004, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898082, "o", "        print(f'Gmail API error: {e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898146, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898199, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898256, "o", "    with open(INPUT_FILE, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898321, "o", "        requests = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898375, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[701.898428, "o", "\u001b[?2004h> "]
[701.898516, "o", "        gmail_service = get_service('gmail', GMAIL_TOKEN_PATH, SCOPES_GMAIL)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898573, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898658, "o", "        print(f\"Service creation failed: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898715, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898772, "o", "    sent_results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[701.898834, "o", "\u001b[?2004h>     for req in requests:\r\n\u001b[?2004l\r\u001b[?2004h"]
[701.898888, "o", "> "]
[701.89894, "o", "        email_text = req['email_text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.898994, "o", "        from_email = req['from_email']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899047, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899111, "o", "        constraints = parse_email_content(email_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899167, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899274, "o", "        # MOCK Availability: Always pick the start time of the first date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899345, "o", "        date = constraints['dates'][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899481, "o", "        proposed_start = datetime.datetime.combine(date, constraints['start_time'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899629, "o", "        proposed_end = proposed_start + datetime.timedelta(hours=constraints['duration'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.89969, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899753, "o", "        day_name = proposed_start.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899842, "o", "        month = proposed_start.strftime('%B')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.899919, "o", "        dd = proposed_start.strftime('%d')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900002, "o", "        yyyy = proposed_start.strftime('%Y')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.90009, "o", "        date_formatted = f\"{month} {dd}, {yyyy}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900155, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900283, "o", "        time_range = f\"{proposed_start.strftime('%I:%M %p')} - {proposed_end.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900349, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900783, "o", "        reply_body = f\"Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: {day_name}, {date_formatted}\\nTime: {time_range}\\nDuration: {constraints['duration']} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900815, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.900918, "o", "        print(f\"Sending email to {from_email}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.90106, "o", "        msg_id = send_email(gmail_service, from_email, \"Re: Meeting Request\", reply_body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901124, "o", "        if msg_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901202, "o", "            sent_results.append({\"messageId\": msg_id})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901273, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901329, "o", "    with open(RESULTS_FILE, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901422, "o", "        json.dump({\"sent_results\": sent_results}, f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[701.901485, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[701.90154, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[701.903108, "o", "\u001b[?2004hroot@76062851be33:~# "]
[703.907077, "i", "python3 solve_task.py\n"]
[703.907343, "o", "python3 solve_task.py\r\n\u001b[?2004l\r"]
