[569.154388, "o", "webm=01;35:*.webp=01;35:*.ogm=01;35:*.mp4=01;35:*.m4v=01;35:*.mp4v=01;35:*.vob=01;35:*.qt=01;35:*.nuv=01;35:*.wmv=01;35:*.asf=01;35:*.rm=01;35:*.rmvb=01;35:*.flc=01;35:*.avi=01;35:*.fli=01;35:*.flv=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.yuv=01;35:*.cgm=01;35:*.emf=01;35:*.ogv=01;35:*.ogx=01;35:*.aac=00;36:*.au=00;36:*.flac=00;36:*.m4a=00;36:*.mid=00;36:*.midi=00;36:*.mka=00;36:*.mp3=00;36:*.mpc=00;36:*.ogg=00;36:*.ra=00;36:*.wav=00;36:*.oga=00;36:*.opus=00;36:*.spx=00;36:*.xspf=00;36:*~=00;90:*#=00;90:*.bak=00;90:*.crdownload=00;90:*.dpkg-dist=00;90:*.dpkg-new=00;90:*.dpkg-old=00;90:*.dpkg-tmp=00;90:*.old=00;90:*.orig=00;90:*.part=00;90:*.rej=00;90:*.rpmnew=00;90:*.rpmorig=00;90:*.rpmsave=00;90:*.swp=00;90:*.tmp=00;90:*.ucf-dist=00;90:*.ucf-new=00;90:*.ucf-old=00;90:\r\nLESSCLOSE=/usr/bin/lesspipe %s %s\r\nTERM=tmux-256color\r\nLESSOPEN=| /usr/bin/lesspipe %s\r\nTMUX_PANE=%0\r\nSHLVL=2\r\nLC_CTYPE=C.UTF-8\r\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\r\nDEBIAN_FRONTEND=noninteractive\r\nTERM_PROGRAM=tmux\r\n_=/usr/bin/env\r\n\u001b[?2004hroot@76062851be33:~# "]
[569.697183, "i", "cat /root/verifier-skills/gmail-skill/scripts/gmail-read.js\n"]
[569.697538, "o", "cat /root/verifier-skills/gmail-skill/scripts/gmail-read.js\r\n\u001b[?2004l\r"]
[569.698591, "o", "#!/usr/bin/env node\r\n\r\nimport { google } from 'googleapis';\r\nimport minimist from 'minimist';\r\nimport { getAuthClient, parseAccountArg } from './auth/auth-utils.js';\r\nimport { logAction } from './action-logger.js';\r\n\r\nfunction decodeBody(body) {\r\n  if (!body.data) return '';\r\n  return Buffer.from(body.data, 'base64').toString('utf-8');\r\n}\r\n\r\nfunction extractBody(payload) {\r\n  if (payload.body && payload.body.data) {\r\n    return decodeBody(payload.body);\r\n  }\r\n\r\n  if (payload.parts) {\r\n    // Try to find text/plain first, fall back to text/html\r\n    const textPart = payload.parts.find(part => part.mimeType === 'text/plain');\r\n    if (textPart && textPart.body.data) {\r\n      return decodeBody(textPart.body);\r\n    }\r\n\r\n    const htmlPart = payload.parts.find(part => part.mimeType === 'text/html');\r\n    if (htmlPart && htmlPart.body.data) {\r\n      return decodeBody(htmlPart.body);\r\n    }\r\n\r\n    // Recursively search nested parts\r\n    for (const part of payload.parts) {\r\n      if (part.parts) {\r\n        const body = extractBody(part);\r\n        if (body) return body;\r\n      }\r\n    }\r\n  }\r\n\r\n  return '';\r\n}\r\n\r\nasync function readMessage(args) {\r\n  if (!args.id) {\r\n    throw new Error('Missing required argument: --id (message ID)');\r\n  }\r\n\r\n  // Get authenticated client for specified account (or default)\r\n  const accountId = parseAccountArg(args);\r\n  const oauth2Client = await getAuthClient(accountId);\r\n\r\n  const gmail = google.gmail({ version: 'v1', auth: oauth2Client });\r\n\r\n  // Get message details\r\n  const message = await gmail.users.messages.get({\r\n    userId: 'me',\r\n    id: args.id,\r\n    format: 'full'\r\n  });\r\n\r\n  const headers = message.data.payload.headers;\r\n  const getHeader = (name) => headers.find(h => h.name === name)?.value || '';\r\n\r\n  const result = {\r\n    success: true,\r\n    id: message.data.id,\r\n    threadId: message.data.threadId,\r\n    from: getHeader('From'),\r\n    to: getHeader('To'),\r\n    cc: getHeader('Cc'),\r\n    bcc: getHeader('Bcc'),\r\n    subject: getHeader('Subject'),\r\n    date: getHeader('Date'),\r\n    labels: message.data.labelIds || [],\r\n    snippet: message.data.snippet,\r\n    body: extractBody(message.data.payload),\r\n    account: accountId || 'default'\r\n  };"]
[569.698719, "o", "\r\n\r\n  // Optionally get thread if requested\r\n  if (args.thread) {\r\n    const thread = await gmail.users.threads.get({\r\n      userId: 'me',\r\n      id: message.data.threadId\r\n    });\r\n\r\n    result.thread = {\r\n      id: thread.data.id,\r\n      messageCount: thread.data.messages.length,\r\n      messages: thread.data.messages.map(msg => ({\r\n        id: msg.id,\r\n        snippet: msg.snippet,\r\n        from: msg.payload.headers.find(h => h.name === 'From')?.value,\r\n        date: msg.payload.headers.find(h => h.name === 'Date')?.value\r\n      }))\r\n    };\r\n  }\r\n\r\n  return result;\r\n}\r\n\r\n// Main execution\r\nconst args = minimist(process.argv.slice(2));\r\nconst startTime = Date.now();\r\n\r\nreadMessage(args)\r\n  .then(result => {\r\n    // Log the action\r\n    logAction('read', args, result, {\r\n      account: result.account,"]
[569.698748, "o", "\r\n      duration: Date.now() - startTime\r\n    });\r\n\r\n    console.log(JSON.stringify(result, null, 2));\r\n  })\r\n  .catch(error => {\r\n    const errorResult = {\r\n      success: false,\r\n      error: error.message\r\n    };\r\n\r\n    // Log the failed action\r\n    logAction('read', args, errorResult, {\r\n      account: args.account || 'default',\r\n      duration: Date.now() - startTime,\r\n      failed: true\r\n    });\r\n\r\n    console.error(JSON.stringify(errorResult, null, 2));\r\n    process.exit(1);\r\n  });\r\n"]
[569.698922, "o", "\u001b[?2004hroot@76062851be33:~# "]
[574.813157, "i", "cat /root/verifier-skills/gmail-skill/scripts/auth/auth-utils.js\n"]
[574.813577, "o", "cat /root/verifier-skills/gmail-skill/scripts/auth/auth-utils.js\r\n\u001b[?2004l\r"]
[574.815297, "o", "#!/usr/bin/env node\r\n\r\nimport { google } from 'googleapis';\r\nimport { readFileSync, writeFileSync, existsSync } from 'fs';\r\nimport { fileURLToPath } from 'url';\r\nimport { dirname, join } from 'path';\r\n\r\nconst __filename = fileURLToPath(import.meta.url);\r\nconst __dirname = dirname(__filename);\r\n\r\nconst TOKEN_PATH = join(__dirname, 'tokens.json');\r\nconst CREDENTIALS_PATH = join(__dirname, 'credentials.json');\r\n\r\n/**\r\n"]
[574.815608, "o", " * Load the multi-account token configuration\r\n * @returns {Object} Token configuration with accounts\r\n */\r\nexport function loadTokenConfig() {\r\n  if (!existsSync(TOKEN_PATH)) {\r\n    throw new Error(`Token file not found. Run: npm run setup`);\r\n  }\r\n\r\n  const content = readFileSync(TOKEN_PATH, 'utf8');\r\n  const data = JSON.parse(content);\r\n\r\n  // Check if it's the old single-account format\r\n  if (data.access_token && !data.accounts) {\r\n    // Old format detected, migrate automatically\r\n    console.error('⚠️  Migrating token.json to multi-account format...');\r\n    const migratedConfig = {\r\n      defaultAccount: 'default',\r\n      accounts: {\r\n"]
[574.815698, "o", "        default: data\r\n      }\r\n    };\r\n    saveTokenConfig(migratedConfig);\r\n    return migratedConfig;\r\n  }\r\n\r\n  return data;\r\n}\r\n\r\n/**\r\n * Save the multi-account token configuration\r\n * @param {Object} config - Token configuration to save\r\n */\r\nexport function saveTokenConfig(config) {\r\n  writeFileSync(TOKEN_PATH, JSON.stringify(config, null, 2), { mode: 0o600 });\r\n}\r\n\r\n/**\r\n * Get the default account ID\r\n * @returns {string} Default account ID\r\n */\r\nexport function getDefaultAccount() {\r\n  const config = loadTokenConfig();\r\n  return config.defaultAccount || Object.keys(config.accounts)[0];\r\n}\r\n\r\n/**\r\n * Set the default account ID\r\n * @param {string} accountId - Account ID to set as default\r\n */\r\nexport function setDefaultAccount(accountId) {\r\n  const config = loadTokenConfig();\r\n  if (!config.accounts[accountId]) {\r\n    throw new Error(`Account '${accountId}' not found`);\r\n  }\r\n  config.defaultAccount = accountId;\r\n  saveTokenConfig(config);\r\n}\r\n\r\n/**\r\n * List all configured accounts\r\n * @returns {Array} Array of account objects with id, email, and scopes\r\n */\r\nexport function listAccounts() {\r\n  const config = loadTokenConfig();\r\n  return Object.entries(config.accounts).map(([id, data]) => ({\r\n    id,\r\n    email: data.email || 'unknown',\r\n    scope: data.scope || '',\r\n    isDefault: id === config.defaultAccount\r\n  }));\r\n}\r\n\r\n/**\r\n * Load tokens for a specific account\r\n * @param {string} accountId - Account ID (defaults to default account)\r\n * @returns {Object} Token object for the account\r\n */\r\nexport function loadTokens(accountId = null) {\r\n  const config = loadTokenConfig();\r\n  const targetAccount = accountId || config.defaultAccount;\r\n\r\n  if (!config.accounts[targetAccount]) {\r\n    const available = Object.keys(config.accounts).join(', ');\r\n    throw new Error(\r\n      `Account '${targetAccount}' not found. Available accounts: ${available}`\r\n    );\r\n  }\r\n\r\n  return config.accounts[targetAccount];\r\n}\r\n\r\n/**\r\n"]
[574.815729, "o", " * Save tokens for a specific account\r\n * @param {string} accountId - Account ID\r\n * @param {Object} tokens - Token object to save\r\n * @param {string} email - Email address for the account (optional)\r\n */\r\nexport function saveTokens(accountId, tokens, email = null) {\r\n  const config = existsSync(TOKEN_PATH) ? loadTokenConfig() : { accounts: {} };\r\n\r\n"]
[574.815759, "o", "  if (!config.accounts) {\r\n    config.accounts = {};\r\n  }\r\n\r\n  // Preserve existing email if not provided"]
[574.815783, "o", "\r\n  const existingEmail = config.accounts[accountId]?.email;\r\n\r\n  config.accounts[accountId] = {\r\n    ...tokens,\r\n    ...(email && { email }),"]
[574.815809, "o", "\r\n    ...(!email && existingEmail && { email: existingEmail })\r\n  };\r\n\r\n  // Set as default if it's the first account\r\n  if (!config.defaultAccount || Object.keys(config.accounts).length === 1) {\r\n"]
[574.815836, "o", "    config.defaultAccount = accountId;\r\n  }\r\n\r\n  saveTokenConfig(config);\r\n}"]
[574.815858, "o", "\r\n\r\n/**\r\n * Remove an account\r\n * @param {string} accountId - Account ID to remove\r\n */"]
[574.815887, "o", "\r\nexport function removeAccount(accountId) {\r\n  const config = loadTokenConfig();\r\n\r\n  if (!config.accounts[accountId]) {\r\n    throw new Error(`Account '${accountId}' not found`);"]
[574.815914, "o", "\r\n  }\r\n\r\n  delete config.accounts[accountId];\r\n\r\n  // Update default if we removed it\r\n"]
[574.815943, "o", "  if (config.defaultAccount === accountId) {\r\n    const remaining = Object.keys(config.accounts);\r\n    config.defaultAccount = remaining.length > 0 ? remaining[0] : null;\r\n  }\r\n\r\n"]
[574.815966, "o", "  saveTokenConfig(config);\r\n}\r\n\r\n/**\r\n * Check if an account's token needs refresh (within 5 minutes of expiry)\r\n * @param {Object} tokens - Token object"]
[574.816, "o", "\r\n * @returns {boolean} True if token needs refresh\r\n */\r\nfunction needsRefresh(tokens) {\r\n  if (!tokens.expiry_date) return false;"]
[574.816023, "o", "\r\n  const expiryTime = new Date(tokens.expiry_date);\r\n  const now = new Date();\r\n  const fiveMinutes = 5 * 60 * 1000;\r\n  return (expiryTime - now) < fiveMinutes;\r\n}\r\n\r\n/**\r\n * Refresh access token if needed\r\n * @param {string} accountId - Account ID (defaults to default account)\r\n * @returns {Object} Current tokens (refreshed if needed)\r\n */\r\nexport async function refreshTokenIfNeeded(accountId = null) {\r\n  const tokens = loadTokens(accountId);\r\n  const targetAccount = accountId || getDefaultAccount();\r\n\r\n  if (!needsRefresh(tokens)) {\r\n    return tokens;\r\n  }\r\n\r\n  // Token needs refresh"]
[574.816047, "o", "\r\n  if (!tokens.refresh_token) {\r\n    throw new Error(`No refresh token available for account '${targetAccount}'. Please re-authenticate.`);\r\n  }\r\n\r\n"]
[574.816068, "o", "  // Load credentials\r\n  if (!existsSync(CREDENTIALS_PATH)) {\r\n    throw new Error(`Credentials file not found at ${CREDENTIALS_PATH}`);\r\n  }\r\n\r\n"]
[574.816093, "o", "  const credentials = JSON.parse(readFileSync(CREDENTIALS_PATH, 'utf8'));\r\n  const { client_id, client_secret } = credentials.installed || credentials.web;\r\n\r\n  // Create OAuth client and refresh\r\n  const oauth2Client = new google.auth.OAuth2(client_id, client_secret);"]
[574.816116, "o", "\r\n  oauth2Client.setCredentials(tokens);\r\n\r\n  try {\r\n    const { credentials: newTokens } = await oauth2Client.refreshAccessToken();\r\n"]
[574.816141, "o", "    const refreshedTokens = {\r\n      access_token: newTokens.access_token,\r\n      refresh_token: newTokens.refresh_token || tokens.refresh_token, // Keep old refresh token if not provided\r\n      scope: newTokens.scope || tokens.scope,\r\n"]
[574.816168, "o", "      token_type: newTokens.token_type || 'Bearer',\r\n      expiry_date: newTokens.expiry_date\r\n    };\r\n\r\n    // Save refreshed tokens\r\n    saveTokens(targetAccount, refreshedTokens);\r\n"]
[574.816201, "o", "\r\n    return refreshedTokens;\r\n  } catch (error) {\r\n    throw new Error(`Failed to refresh token for account '${targetAccount}': ${error.message}`);\r\n  }\r\n}\r\n"]
[574.81623, "o", "\r\n/**\r\n * Get authenticated OAuth2 client for an account\r\n * @param {string} accountId - Account ID (defaults to default account)\r\n * @returns {Object} Authenticated OAuth2 client\r\n"]
[574.816257, "o", " */\r\nexport async function getAuthClient(accountId = null) {\r\n  const tokens = await refreshTokenIfNeeded(accountId);\r\n\r\n  // Load credentials\r\n  if (!existsSync(CREDENTIALS_PATH)) {"]
[574.816279, "o", "\r\n    throw new Error(`Credentials file not found at ${CREDENTIALS_PATH}`);\r\n  }\r\n\r\n  const credentials = JSON.parse(readFileSync(CREDENTIALS_PATH, 'utf8'));"]
[574.816299, "o", "\r\n  const { client_id, client_secret } = credentials.installed || credentials.web;\r\n\r\n  const oauth2Client = new google.auth.OAuth2(client_id, client_secret);\r\n  oauth2Client.setCredentials(tokens);\r\n"]
[574.816321, "o", "\r\n  return oauth2Client;\r\n}\r\n\r\n/**\r\n * Parse account argument from command line args"]
[574.816343, "o", "\r\n * @param {Object} args - Parsed command line arguments\r\n * @returns {string|null} Account ID or null for default\r\n */\r\n"]
[574.816368, "o", "export function parseAccountArg(args) {\r\n  return args.account || null;\r\n}\r\n"]
[574.817967, "o", "\u001b[?2004h"]
[574.818049, "o", "root@76062851be33:~# "]
[593.66444, "i", "cat /root/verifier-skills/gmail-skill/README.md\n"]
[593.665, "o", "cat /root/verifier-skills/gmail-skill/README.md\r\n\u001b[?2004l\r"]
[593.665935, "o", "# Gmail Skill - Detailed Usage Guide\r\n\r\nToken-efficient Gmail management through CLI scripts for Claude Code.\r\n\r\n## Quick Start\r\n\r\nAll scripts are in the `scripts/` directory and output JSON.\r\n\r\n## gmail-send.js - Send Emails\r\n\r\nSend emails with support for HTML, CC/BCC, and custom headers.\r\n\r\n### Basic Usage\r\n```bash\r\nnode gmail-send.js --to \"user@example.com\" --subject \"Hello\" --body \"Message body\"\r\n```\r\n\r\n### Advanced Options\r\n```bash\r\nnode gmail-send.js \\\r\n  --to \"user@example.com\" \\\r\n  --cc \"cc@example.com\" \\\r\n  --bcc \"bcc@example.com\" \\\r\n  --subject \"Project Update\" \\\r\n  --body \"The project is complete.\" \\\r\n  --reply-to \"reply@example.com\"\r\n```\r\n\r\n### HTML Email\r\n```bash\r\nnode gmail-send.js \\\r\n  --to \"user@example.com\" \\\r\n  --subject \"Newsletter\" \\\r\n  --html \"<h1>Welcome</h1><p>This is HTML content</p>\""]
[593.665969, "o", "\r\n```\r\n\r\n### Output\r\n```json\r\n{\r\n  \"success\": true,\r\n  \"messageId\": \"18d1234567890\",\r\n  \"threadId\": \"18d1234567890\",\r\n  \"to\": \"user@example.com\",\r\n  \"subject\": \"Hello\"\r\n}\r\n```\r\n\r\n## gmail-search.js - Search Emails\r\n\r\nSearch emails using Gmail's powerful query syntax.\r\n\r\n### Basic Search\r\n```bash\r\nnode gmail-search.js --query \"is:unread\" --limit 10\r\n```\r\n\r\n### Search Operators\r\n```bash\r\n# From specific sender\r\nnode gmail-search.js --query \"from:boss@company.com\"\r\n\r\n# Emails with attachments\r\nnode gmail-search.js --query \"has:attachment\"\r\n\r\n# Date range\r\n"]
[593.666002, "o", "node gmail-search.js --query \"after:2024/01/01 before:2024/12/31\"\r\n\r\n# Subject search\r\nnode gmail-search.js --query \"subject:invoice\"\r\n\r\n"]
[593.666029, "o", "# Combine operators\r\nnode gmail-search.js --query \"from:client@example.com has:attachment is:unread\"\r\n\r\n# Complex search\r\nnode gmail-search.js --query \"is:important OR is:starred\" --limit 20\r\n```\r\n\r\n"]
[593.666057, "o", "### Output\r\n```json\r\n{\r\n  \"success\": true,\r\n  \"count\": 3,\r\n  \"total\": 150,"]
[593.666081, "o", "\r\n  \"query\": \"is:unread\",\r\n  \"messages\": [\r\n    {\r\n      \"id\": \"18d1234567890\",\r\n      \"threadId\": \"18d1234567890\","]
[593.666107, "o", "\r\n      \"from\": \"sender@example.com\",\r\n      \"to\": \"you@gmail.com\",\r\n      \"subject\": \"Project Update\",\r\n      \"date\": \"Mon, 15 Jan 2024 10:30:00 -0800\",\r\n      \"snippet\": \"The project is progressing well...\","]
[593.66613, "o", "\r\n      \"labels\": [\"INBOX\", \"UNREAD\"]\r\n    }\r\n  ]\r\n}"]
[593.666155, "o", "\r\n```\r\n\r\n## gmail-read.js - Read Messages\r\n\r\nRead full message content and thread details.\r\n"]
[593.666181, "o", "\r\n### Read Single Message\r\n```bash\r\nnode gmail-read.js --id \"18d1234567890\"\r\n```\r\n\r\n### Read Message with Thread Context"]
[593.666221, "o", "\r\n```bash\r\nnode gmail-read.js --id \"18d1234567890\" --thread\r\n```\r\n\r\n### Output\r\n```json\r\n{\r\n  \"success\": true,\r\n  \"id\": \"18d1234567890\","]
[593.666243, "o", "\r\n  \"threadId\": \"18d1234567890\",\r\n  \"from\": \"sender@example.com\",\r\n  \"to\": \"you@gmail.com\",\r\n  \"subject\": \"Project Update\",\r\n  \"date\": \"Mon, 15 Jan 2024 10:30:00 -0800\","]
[593.66627, "o", "\r\n  \"labels\": [\"INBOX\", \"UNREAD\"],\r\n  \"snippet\": \"The project is progressing well...\",\r\n  \"body\": \"Full email body content here...\"\r\n}\r\n"]
[593.666293, "o", "```\r\n\r\n## gmail-labels.js - Manage Labels\r\n\r\nList, create, add, and remove labels.\r\n\r\n"]
[593.666315, "o", "### List All Labels\r\n```bash\r\nnode gmail-labels.js --action list\r\n```\r\n"]
[593.666339, "o", "\r\n### Create New Label\r\n```bash\r\nnode gmail-labels.js --action create --name \"Project Alpha\"\r\n```\r\n"]
[593.666362, "o", "\r\n### Add Label to Message\r\n```bash\r\n# Using label name\r\nnode gmail-labels.js --action add --id \"18d1234567890\" --label \"Important\"\r\n"]
[593.666386, "o", "\r\n# Using label ID\r\nnode gmail-labels.js --action add --id \"18d1234567890\" --label \"Label_123\"\r\n```\r\n\r\n### Remove Label from Message\r\n"]
[593.666413, "o", "```bash\r\nnode gmail-labels.js --action remove --id \"18d1234567890\" --label \"Important\"\r\n```\r\n\r\n### Output (list)\r\n```json"]
[593.666438, "o", "\r\n{\r\n  \"success\": true,\r\n  \"action\": \"list\","]
[593.666471, "o", "\r\n  \"count\": 15,\r\n  \"labels\": [\r\n    {\r\n      \"id\": \"INBOX\","]
[593.666497, "o", "\r\n      \"name\": \"INBOX\",\r\n      \"type\": \"system\"\r\n    },\r\n    {\r\n      \"id\": \"Label_123\",\r\n      \"name\": \"Project Alpha\",\r\n      \"type\": \"user\"\r\n    }\r\n  ]\r\n}\r\n```\r\n\r\n## gmail-drafts.js - Manage Drafts\r\n\r\nCreate, update, send, and delete draft emails.\r\n\r\n### List Drafts\r\n```bash\r\nnode gmail-drafts.js --action list --limit 10\r\n```\r\n\r\n### Create Draft\r\n```bash\r\nnode gmail-drafts.js \\"]
[593.666521, "o", "\r\n  --action create \\\r\n  --to \"user@example.com\" \\\r\n  --subject \"Draft Subject\" \\\r\n  --body \"Draft body text\"\r\n```"]
[593.666544, "o", "\r\n\r\n### Update Draft\r\n```bash\r\nnode gmail-drafts.js \\\r\n"]
[593.666568, "o", "  --action update \\\r\n  --id \"r-1234567890\" \\\r\n  --to \"user@example.com\" \\\r\n  --subject \"Updated Subject\" \\\r\n  --body \"Updated body text\""]
[593.666588, "o", "\r\n```\r\n\r\n### Send Draft\r\n```bash\r\nnode gmail-draf"]
[593.666611, "o", "ts.js --action send --id \"r-1234567890\"\r\n```\r\n\r\n### Delete Draft\r\n```bash\r\n"]
[593.666637, "o", "node gmail-drafts.js --action delete --id \"r-1234567890\"\r\n```\r\n\r\n### Output (create)\r\n```json\r\n"]
[593.666664, "o", "{\r\n  \"success\": true,\r\n  \"action\": \"create\",\r\n  \"draftId\": \"r-1234567890\",\r\n"]
[593.666688, "o", "  \"to\": \"user@example.com\",\r\n  \"subject\": \"Draft Subject\"\r\n}\r\n```\r\n\r\n## Common Workflows\r\n"]
[593.66671, "o", "\r\n### 1. Find and Reply to Unread Emails\r\n```bash\r\n# Search for unread emails\r\nnode gmail-search.js --query \"is:unread\" --limit 5 > /tmp/unread.json\r\n"]
[593.666732, "o", "\r\n# Read first message\r\nMESSAGE_ID=$(cat /tmp/unread.json | jq -r '.messages[0].id')\r\nnode gmail-read.js --id \"$MESSAGE_ID\" > /tmp/message.json\r\n\r\n"]
[593.666758, "o", "# Send reply\r\nSENDER=$(cat /tmp/message.json | jq -r '.from')\r\nSUBJECT=$(cat /tmp/message.json | jq -r '.subject')\r\nnode gmail-send.js --to \"$SENDER\" --subject \"Re: $SUBJECT\" --body \"Thanks for your message!\"\r\n```"]
[593.66678, "o", "\r\n\r\n### 2. Organize Emails by Label\r\n```bash\r\n# Search for project-related emails\r\nnode gmail-search.js --query \"subject:project alpha\" > /tmp/results.json"]
[593.666806, "o", "\r\n\r\n# Create label\r\nnode gmail-labels.js --action create --name \"Project Alpha\"\r\n\r\n# Add label to each message\r\n"]
[593.666831, "o", "cat /tmp/results.json | jq -r '.messages[].id' | while read id; do\r\n  node gmail-labels.js --action add --id \"$id\" --label \"Project Alpha\"\r\ndone\r\n```\r\n"]
[593.666852, "o", "\r\n### 3. Draft Review Workflow\r\n```bash\r\n# Create draft\r\nnode gmail-drafts.js --action create \\"]
[593.666877, "o", "\r\n  --to \"client@example.com\" \\\r\n  --subject \"Proposal\" \\\r\n  --body \"Initial draft text\" > /tmp/draft.json\r\n\r\nDRAFT_ID=$(cat /tmp/draft.json | jq -r '.draftId')"]
[593.666897, "o", "\r\n\r\n# Update after review\r\nnode gmail-drafts.js --action update \\\r\n  --id \"$DRAFT_ID\" \\\r\n"]
[593.666922, "o", "  --to \"client@example.com\" \\\r\n  --subject \"Proposal - Final\" \\\r\n  --body \"Revised draft text\"\r\n\r\n# Send when ready\r\n"]
[593.666948, "o", "node gmail-drafts.js --action send --id \"$DRAFT_ID\"\r\n```\r\n\r\n## Gmail Search Operators Reference\r\n\r\n"]
[593.666973, "o", "| Operator | Example | Description |\r\n|----------|---------|-------------|\r\n| `from:` | `from:user@example.com` | Emails from sender |\r\n| `to:` | `to:user@example.com` | Emails to recipient |\r\n| `subject:` | `subject:invoice` | Subject contains word |"]
[593.666999, "o", "\r\n| `has:attachment` | `has:attachment` | Has any attachment |\r\n| `filename:` | `filename:pdf` | Attachment filename |\r\n| `is:unread` | `is:unread` | Unread emails |\r\n| `is:read` | `is:read` | Read emails |"]
[593.667024, "o", "\r\n| `is:starred` | `is:starred` | Starred emails |\r\n| `is:important` | `is:important` | Important emails |\r\n| `label:` | `label:work` | Has specific label |\r\n| `after:` | `after:2024/01/01` | After date |\r\n"]
[593.667047, "o", "| `before:` | `before:2024/12/31` | Before date |\r\n| `older_than:` | `older_than:7d` | Older than (d/m/y) |\r\n| `newer_than:` | `newer_than:2d` | Newer than (d/m/y) |\r\n\r\n## Error Handling"]
[593.66707, "o", "\r\n\r\nAll scripts return JSON error objects:\r\n\r\n```json\r\n{\r\n  \"success\": false,"]
[593.66709, "o", "\r\n  \"error\": \"Token not found. Run: npm run setup\"\r\n}\r\n```\r\n\r\n"]
[593.667115, "o", "Common errors:\r\n- **Token not found**: Run `npm run setup` to authenticate\r\n- **Invalid credentials**: Check `scripts/auth/credentials.json`\r\n- **Permission denied**: Ensure Gmail API scope is granted\r\n- **Message not found**: Invalid message/draft ID"]
[593.667144, "o", "\r\n\r\n## Tips for Claude\r\n\r\n1. **Parse JSON efficiently**: Use `jq` for extracting specific fields\r\n2. **Chain operations**: Save intermediate results to `/tmp/` files\r\n3. **Validate IDs**: Check that message/draft IDs exist before operations\r\n4. **User-friendly output**: Convert JSON to readable summaries for users\r\n5. **Error handling**: Check `success` field and handle errors gracefully\r\n"]
