[487.406958, "o", "        duration = 1.5\r\n\u001b[?2004l\r"]
[487.406984, "o", "\u001b[?2004h> "]
[487.407139, "o", "    elif 'one-hour' in text or '1 hour' in text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.40717, "o", "> "]
[487.407244, "o", "        duration = 1.0\r\n\u001b[?2004l\r"]
[487.407279, "o", "\u001b[?2004h> "]
[487.407369, "o", "    elif '45-minute' in text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.407401, "o", "> "]
[487.407476, "o", "        duration = 0.75\r\n\u001b[?2004l\r"]
[487.407507, "o", "\u001b[?2004h> "]
[487.407534, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[487.407566, "o", "> "]
[487.407598, "o", "    # Dates\r\n\u001b[?2004l\r"]
[487.407626, "o", "\u001b[?2004h> "]
[487.407768, "o", "    possible_dates = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.408036, "o", "    norm_text = text.replace('th,', ',').replace('st,', ',').replace('nd,', ',').replace('rd,', ',')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.408063, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[487.408139, "o", "> "]
[487.408227, "o", "    # Parsing logic tailored to examples\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.408306, "o", "    # \"January 8th, 2026\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.408335, "o", "> "]
[487.408435, "o", "    # \"January 8th and January 9th, 2026\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.408542, "o", "    # \"January 6th or 7th, 2026\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.40857, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.40874, "o", "    if \"January 8\" in text and \"January 9\" in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.408984, "o", "        possible_dates = [datetime.date(2026, 1, 8), datetime.date(2026, 1, 9)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.409149, "o", "    elif \"January 6\" in text and \"7th\" in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.409397, "o", "        possible_dates = [datetime.date(2026, 1, 6), datetime.date(2026, 1, 7)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.409508, "o", "    elif \"January 8\" in text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.409538, "o", "> "]
[487.409705, "o", "         possible_dates = [datetime.date(2026, 1, 8)]\r\n\u001b[?2004l\r"]
[487.409733, "o", "\u001b[?2004h> "]
[487.409765, "o", "         \r\n\u001b[?2004l\r"]
[487.409813, "o", "\u001b[?2004h> "]
[487.42204, "o", "    # Time constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.42236, "o", "    start_time = datetime.time(9, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.422571, "o", "    end_time = datetime.time(17, 0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[487.422667, "o", "\u001b[?2004h> "]
[487.422967, "o", "    time_match = re.search(r'(\\d{1,2}:?\\d{0,2})\\s*(am|pm)?\\s*(to|and|between)\\s*(\\d{1,2}:?\\d{0,2})\\s*(am|pm)', text, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.42313, "o", ">     if time_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.42338, "o", "        t1_str = time_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.430306, "o", "        t1_ampm = time_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.430542, "o", ">         # group 3 is separator\r\n\u001b[?2004l\rar\u001b[?2004h> "]
[487.430665, "o", "        t2_str = time_match.group(4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.430913, "o", "        t2_ampm = time_match.group(5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.430962, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.43132, "o", "        if not t1_ampm and t2_ampm: t1_ampm = t2_ampm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.431685, "o", "        if not t2_ampm and t1_ampm: t2_ampm = t1_ampm\r\n\u001b[?2004l\r"]
[487.431891, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[487.432012, "o", "\u001b[?2004h> "]
[487.432229, "o", "        def parse_time(t_str, ampm):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.432268, "o", "            if ':' in t_str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.432623, "o", "                h, m = map(int, t_str.split(':'))\r\n\u001b[?2004l\r"]
[487.43266, "o", "\u001b[?2004h> "]
[487.432983, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 h = int(t_str)\r\n\u001b[?2004l\r"]
[487.433192, "o", "\u001b[?2004h>                 m = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.43345, "o", "            if ampm and ampm.lower() == 'pm' and h != 12:\r\n\u001b[?2004l\r"]
[487.433696, "o", "\u001b[?2004h>                 h += 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.433991, "o", "            if ampm and ampm.lower() == 'am' and h == 12:\r\n\u001b[?2004l\r"]
[487.434024, "o", "\u001b[?2004h> "]
[487.4343, "o", "                h = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.434483, "o", "            return datetime.time(h, m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.434532, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.434744, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.434985, "o", "            start_time = parse_time(t1_str, t1_ampm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.435247, "o", "            end_time = parse_time(t2_str, t2_ampm)"]
[487.435437, "o", "\r\n\u001b[?2004l\r"]
[487.435655, "o", "\u001b[?2004h>         except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.435687, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[487.435716, "o", "\u001b[?2004h> "]
[487.436111, "o", "    # Refine time parsing for \"between 9:30am and 11:30am\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.436506, "o", "    # The regex above handles \"to\" and \"and\". \"between\" is added.\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.436545, "o", ">     \r\n\u001b[?2004l\r"]
[487.436572, "o", "\u001b[?2004h> "]
[487.436751, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.43684, "o", "        'duration': duration,\r\n\u001b[?2004l\r"]
[487.43687, "o", "\u001b[?2004h> "]
[487.437065, "o", "        'dates': possible_dates,\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.437096, "o", "> "]
[487.437269, "o", "        'start_time': start_time,\r\n\u001b[?2004l\r"]
[487.437301, "o", "\u001b[?2004h> "]
[487.437456, "o", "        'end_time': end_time\r\n\u001b[?2004l\r"]
[487.437487, "o", "\u001b[?2004h> "]
[487.437617, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.438174, "o", "def check_calendar_availability(service, date, start_time_constraint, end_time_constraint, duration_hours):\r\n\u001b[?2004l\r"]
[487.43826, "o", "\u001b[?2004h> "]
[487.438636, "o", "    time_min = datetime.datetime.combine(date, start_time_constraint).isoformat() + 'Z'\r\n\u001b[?2004l\r"]
[487.438671, "o", "\u001b[?2004h> "]
[487.439019, "o", "    time_max = datetime.datetime.combine(date, end_time_constraint).isoformat() + 'Z'\r\n\u001b[?2004l\r"]
[487.439053, "o", "\u001b[?2004h> "]
[487.439086, "o", "    \r\n\u001b[?2004l\r"]
[487.439129, "o", "\u001b[?2004h> "]
[487.43917, "o", "    try:\r\n\u001b[?2004l\r"]
[487.43921, "o", "\u001b[?2004h> "]
[487.439814, "o", "        events_result = service.events().list(calendarId='primary', timeMin=time_min, timeMax=time_max, singleEvents=True, orderBy='startTime').execute()\r\n\u001b[?2004l\r"]
[487.439844, "o", "\u001b[?2004h> "]
[487.440044, "o", "        events = events_result.get('items', [])\r\n\u001b[?2004l\r"]
[487.44007, "o", "\u001b[?2004h> "]
[487.440223, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[487.440292, "o", "\u001b[?2004h> "]
[487.440361, "o", "        print(f\"Calendar API error: {e}\")\r\n\u001b[?2004l\r"]
[487.440437, "o", "\u001b[?2004h> "]
[487.440519, "o", "        return None, None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.440644, "o", "    current_start = datetime.datetime.combine(date, start_time_constraint)\r\n\u001b[?2004l\r"]
[487.440703, "o", "\u001b[?2004h> "]
[487.440805, "o", "    window_end = datetime.datetime.combine(date, end_time_constraint)\r\n\u001b[?2004l\r"]
[487.440873, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.440901, "o", "    busy_slots = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.440973, "o", "    for event in events:\r\n\u001b[?2004l\r"]
[487.441003, "o", "\u001b[?2004h> "]
[487.441161, "o", "        start = event['start'].get('dateTime', event['start'].get('date'))\r\n\u001b[?2004l\r"]
[487.441189, "o", "\u001b[?2004h> "]
[487.441343, "o", "        end = event['end'].get('dateTime', event['end'].get('date'))\r\n\u001b[?2004l\r"]
[487.441371, "o", "\u001b[?2004h> "]
[487.441535, "o", "        busy_slots.append((date_parser.parse(start), date_parser.parse(end)))\r\n\u001b[?2004l\r"]
[487.441572, "o", "\u001b[?2004h> "]
[487.44161, "o", "        \r\n\u001b[?2004l\r"]
[487.441639, "o", "\u001b[?2004h> "]
[487.441738, "o", "    busy_slots.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.441845, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.441996, "o", "    meeting_duration = datetime.timedelta(hours=duration_hours)\r\n\u001b[?2004l\r"]
[487.442073, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.442161, "o", "    tzinfo = datetime.timezone.utc\r\n\u001b[?2004l\r"]
[487.44219, "o", "\u001b[?2004h> "]
[487.442257, "o", "    if busy_slots:\r\n\u001b[?2004l\r"]
[487.442286, "o", "\u001b[?2004h> "]
[487.442408, "o", "        tzinfo = busy_slots[0][0].tzinfo\r\n\u001b[?2004l\r"]
[487.442437, "o", "\u001b[?2004h"]
[487.442469, "o", "> "]
[487.4425, "o", "        \r\n\u001b[?2004l\r"]
[487.442531, "o", "\u001b[?2004h"]
[487.442561, "o", "> "]
[487.442702, "o", "    current_start = current_start.replace(tzinfo=tzinfo)\r\n\u001b[?2004l\r"]
[487.442731, "o", "\u001b[?2004h> "]
[487.442873, "o", "    window_end = window_end.replace(tzinfo=tzinfo)\r\n\u001b[?2004l\r"]
[487.442935, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[487.442995, "o", "\u001b[?2004h> "]
[487.443087, "o", "    for busy_start, busy_end in busy_slots:\r\n\u001b[?2004l\r"]
[487.443146, "o", "\u001b[?2004h> "]
[487.443281, "o", "        # Ensure busy_start matches tz of current_start\r\n\u001b[?2004l\r"]
[487.443344, "o", "\u001b[?2004h> "]
[487.443463, "o", "        busy_start = busy_start.astimezone(tzinfo)\r\n\u001b[?2004l\r"]
[487.443531, "o", "\u001b[?2004h> "]
[487.443627, "o", "        busy_end = busy_end.astimezone(tzinfo)\r\n\u001b[?2004l\r"]
[487.443687, "o", "\u001b[?2004h>         \r\n"]
[487.443755, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[487.443897, "o", "        if current_start + meeting_duration <= busy_start:\r\n\u001b[?2004l\r"]
[487.443964, "o", "\u001b[?2004h> "]
[487.44411, "o", "            return current_start, current_start + meeting_duration\r\n\u001b[?2004l\r"]
[487.444176, "o", "\u001b[?2004h> "]
[487.444288, "o", "        current_start = max(current_start, busy_end)\r\n\u001b[?2004l\r"]
[487.444348, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[487.444415, "o", "\u001b[?2004h> "]
[487.444539, "o", "    if current_start + meeting_duration <= window_end:\r\n\u001b[?2004l\r"]
[487.44461, "o", "\u001b[?2004h> "]
[487.444746, "o", "        return current_start, current_start + meeting_duration\r\n\u001b[?2004l\r"]
[487.444805, "o", "\u001b[?2004h>         \r\n"]
[487.444865, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[487.444925, "o", "    return None, None\r\n\u001b[?2004l\r"]
[487.445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.445154, "o", "def send_email(service, to_email, subject, body_text):\r\n\u001b[?2004l\r"]
[487.445345, "o", "\u001b[?2004h>     message = MIMEText(body_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.445466, "o", "    message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.44554, "o", "    message['subject'] = subject\r\n\u001b[?2004l\r"]
[487.445605, "o", "\u001b[?2004h> "]
[487.445784, "o", "    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\r\n\u001b[?2004l\r"]
[487.445853, "o", "\u001b[?2004h> "]
[487.445914, "o", "    body = {'raw': raw_message}\r\n"]
[487.445982, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[487.446048, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[487.446117, "o", "\u001b[?2004h> "]
[487.446293, "o", "        message = service.users().messages().send(userId='me', body=body).execute()\r\n\u001b[?2004l\r"]
[487.446355, "o", "\u001b[?2004h> "]
[487.446414, "o", "        return message['id']\r\n\u001b[?2004l\r"]
[487.446474, "o", "\u001b[?2004h> "]
[487.446534, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.446593, "o", "> "]
[487.446665, "o", "        print(f'Gmail API error: {e}')\r\n\u001b[?2004l\r"]
[487.446733, "o", "\u001b[?2004h> "]
[487.446792, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.446849, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.446915, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.447017, "o", "    with open(INPUT_FILE, 'r') as f:\r\n\u001b[?2004l\r"]
[487.447076, "o", "\u001b[?2004h> "]
[487.447149, "o", "        requests = json.load(f)\r\n\u001b[?2004l\r"]
[487.447214, "o", "\u001b[?2004h>         "]
[487.447274, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n"]
[487.44734, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[487.447546, "o", "        calendar_service = get_service('calendar', CALENDAR_TOKEN_PATH, SCOPES_CALENDAR)\r\n\u001b[?2004l\r"]
[487.447605, "o", "\u001b[?2004h> "]
[487.44779, "o", "        gmail_service = get_service('gmail', GMAIL_TOKEN_PATH, SCOPES_GMAIL)\r\n\u001b[?2004l\r"]
[487.44785, "o", "\u001b[?2004h> "]
[487.447923, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[487.447981, "o", "\u001b[?2004h> "]
[487.448095, "o", "        print(f\"Service creation failed: {e}\")\r\n\u001b[?2004l\r"]
[487.448154, "o", "\u001b[?2004h> "]
[487.448224, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[487.448289, "o", "\u001b[?2004h> "]
[487.448349, "o", "    sent_results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[487.448415, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[487.448475, "o", "    for req in requests:\r\n\u001b[?2004l\r"]
[487.448534, "o", "\u001b[?2004h> "]
[487.448614, "o", "        email_text = req['email_text']\r\n\u001b[?2004l\r"]
[487.448673, "o", "\u001b[?2004h> "]
[487.448765, "o", "        from_email = req['from_email']\r\n\u001b[?2004l\r"]
[487.448827, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[487.448886, "o", "\u001b[?2004h> "]
[487.449013, "o", "        constraints = parse_email_content(email_text)\r\n\u001b[?2004l\r"]
[487.449072, "o", "\u001b[?2004h>         \r\n"]
[487.449137, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[487.449218, "o", "        proposed_start = None\r\n\u001b[?2004l\r"]
[487.449281, "o", "\u001b[?2004h> "]
[487.449341, "o", "        proposed_end = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[487.449401, "o", ">         \r\n\u001b[?2004l\r"]
[487.449461, "o", "\u001b[?2004h> "]
[487.44955, "o", "        for date in constraints['dates']:\r\n\u001b[?2004l\r"]
[487.44961, "o", "\u001b[?2004h> "]
[487.449735, "o", "            start, end = check_calendar_availability(\r\n\u001b[?2004l\r"]
[487.449811, "o", "\u001b[?2004h> "]
[487.449896, "o", "                calendar_service, \r\n\u001b[?2004l\r"]
[487.449973, "o", "\u001b[?2004h> "]
[487.450069, "o", "                date, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.450167, "o", "                constraints['start_time'], \r\n\u001b[?2004l\r"]
[487.450284, "o", "\u001b[?2004h> "]
[487.450412, "o", "                constraints['end_time'], \r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.450555, "o", "                constraints['duration']\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r"]
