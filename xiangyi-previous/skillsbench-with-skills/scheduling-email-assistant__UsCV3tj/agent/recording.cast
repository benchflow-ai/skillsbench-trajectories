[594.198247, "o", "{\r\n  \"name\": \"gmail-skill\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"Gmail management CLI scripts for Claude Code\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"setup\": \"node scripts/auth/setup-oauth.js\"\r\n  },\r\n  \"dependencies\": {\r\n    \"googleapis\": \"^144.0.0\",\r\n    \"minimist\": \"^1.2.8\",\r\n    \"open\": \"^10.1.0\",\r\n    \"mailcomposer\": \"^4.0.1\"\r\n  },\r\n  \"keywords\": [\"gmail\", \"claude-code\", \"skill\"],\r\n  \"author\": \"\",\r\n  \"license\": \"MIT\"\r\n}\r\n"]
