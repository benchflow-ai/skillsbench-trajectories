[825.569336, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f\"Node script returned failure: {output}\")\r\n\u001b[?2004l\r\u001b[?2004h>                 return None\r\n\u001b[?2004l\r\u001b[?2004h>         except json.JSONDecodeError:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Failed to parse JSON output: {result.stdout}\")\r\n\u001b[?2004l\r\u001b[?2004h>             return None\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         os.chdir(cwd)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     with open(INPUT_FILE, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         requests = json.load(f)\r\n\u001b[?2004l\r"]
[825.569375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[825.573716, "o", "    sent_results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for req in requests:\r\n\u001b[?2004l\r\u001b[?2004h>         email_text = req['email_text']\r\n\u001b[?2004l\r\u001b[?2004h>         from_email = req['from_email']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         constraints = parse_email_content(email_text)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # MOCK Availability\r\n\u001b[?2004l\r\u001b[?2004h>         date = constraints['dates'][0]\r\n\u001b[?2004l\r\u001b[?2004h>         proposed_start = datetime.datetime.combine(date, constraints['start_time'])\r\n\u001b[?2004l\r\u001b[?2004h>         proposed_end = proposed_start + datetime.timedelta(hours=constraints['duration'])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         day_name = proposed_start.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h>         month = proposed_start.strftime('%B')\r\n\u001b[?2004l\r\u001b[?2004h>         dd = proposed_start.strftime('%d')\r\n\u001b[?2004l\r\u001b[?2004h>         yyyy = proposed_start.strftime('%Y')\r\n\u001b[?2004l\r\u001b[?2004h>         date_formatted = f\"{month} {dd}, {yyyy}\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         time_range = f\"{proposed_start.strftime('%I:%M %p')} - {proposed_end.strftime('%I:%M %p')}\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         reply_body = f\"Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: {day_name}, {date_formatted}\\nTime: {time_range}\\nDuration: {constraints['duration']} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Sending email to {from_email}...\")\r\n\u001b[?2004l\r\u001b[?2004h>         msg_id = send_email_node(from_email, \"Re: Meeting Request\", reply_body)\r\n\u001b[?2004l\r\u001b[?2004h>         if msg_id:\r\n\u001b[?2004l\r\u001b[?2004h>             sent_results.append({\"messageId\": msg_id})\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     with open(RESULTS_FILE, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump({\"sent_results\": sent_results}, f)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
