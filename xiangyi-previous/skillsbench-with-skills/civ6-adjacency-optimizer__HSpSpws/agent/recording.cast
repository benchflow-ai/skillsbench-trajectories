[252.342432, "o", "      14\r\n    ],\r\n    \"COMMERCIAL_HUB\": [\r\n      20,\r\n      13\r\n    ],\r\n    \"HARBOR\": [\r\n      21,\r\n      12"]
[252.342607, "o", "\r\n    ]\r\n  },\r\n  \"adjacency_bonuses\": {\r\n    \"CAMPUS\": 7,\r\n    \"COMMERCIAL_HUB\": 4,\r\n    \"HARBOR\": 3\r\n  },\r\n  \"total_adjacency\": 14\r\n}\r\n"]
