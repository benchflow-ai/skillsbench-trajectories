[259.124886, "o", "cat /output/scenario_3.json\r\n\u001b[?2004l\r"]
[259.12609, "o", "{\r\n  \"city_center\": [\r\n    21,\r\n    13\r\n  ],\r\n  \"placements\": {\r\n    \"CAMPUS\": [\r\n      21,\r\n      14\r\n    ],\r\n    \"COMMERCIAL_HUB\": [\r\n      20,\r\n      13\r\n    ],\r\n    \"HARBOR\": [\r\n      21,\r\n      12\r\n    ]\r\n  },\r\n  \"adjacency_bonuses\": {\r\n    \"CAMPUS\": 7,\r\n    \"COMMERCIAL_HUB\": 4,\r\n    \"HARBOR\": 3\r\n  },\r\n  \"total_adjacency\": 14\r\n}\r\n"]
[259.126233, "o", "\u001b[?2004hroot@c65979f7338e:~# "]
[315.680807, "i", "cat <<EOF > solve.py\nimport json\nimport math\n\nwith open('map_dump.json') as f:\n    data = json.load(f)\n\nwidth = data['map']['Width']\nheight = data['map']['Height']\nwrap_x = data['map']['WrapX']\n\ngrid = {}\nfor p in data['plots']:\n    pid = p['ID']\n    x = pid % width\n    y = pid // width\n    grid[(x, y)] = {\n        'id': pid,\n        'terrain': p['TerrainType'],\n        'features': [],\n        'x': x, 'y': y\n    }\n\nfor f in data['features'].values():\n    pid = f['ID']\n    x = pid % width\n    y = pid // width\n    if (x, y) in grid:\n        grid[(x, y)]['features'].append(f['FeatureType'])\n\nriver_edges = {}\nfor r in data['rivers'].values():\n    pid = r['ID']\n    x = pid % width\n    y = pid // width\n    if r.get('IsWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'W')] = True\n    if r.get('IsNWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NW')] = True\n    if r.get('IsNEOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NE')] = True\n\nfor (x,y), node in grid.items():\n    offset = y % 2\n    if river_edges.get((x,y,'W')):\n        w_neighbor = ((x-1)%width, y) if wrap_x else (x-1, y)\n        if w_neighbor in grid: grid[w_neighbor]['has_river'] = True\n    if river_edges.get((x,y,'NW')):\n        nw_nx = x - 1 + offset\n        nw_ny = y + 1\n        nw_neighbor = (nw_nx%width, nw_ny) if wrap_x else (nw_nx, nw_ny)\n        if nw_neighbor in grid: grid[nw_neighbor]['has_river'] = True\n    if river_edges.get((x,y,'NE')):\n        ne_nx = x + offset\n        ne_ny = y + 1\n        ne_neighbor = (ne_nx%width, ne_ny) if wrap_x else (ne_nx, ne_ny)\n        if ne_neighbor in grid: grid[ne_neighbor]['has_river'] = True\n\ndef get_neighbors(x, y):\n    offset = y % 2\n    candidates = [\n        (x - 1, y),\n        (x + 1, y),\n        (x - 1 + offset, y - 1),\n        (x + offset, y - 1),\n        (x - 1 + offset, y + 1),\n        (x + offset, y + 1)\n    ]\n    valid = []\n    for nx, ny in candidates:\n        if wrap_x:\n            nx = nx % width\n        if 0 <= nx < width and 0 <= ny < height:\n            valid.append((nx, ny))\n    return valid\n\ndef is_mountain(node):\n    return 'MOUNTAIN' in node['terrain']\n\ndef is_coast(node):\n    return node['terrain'] == 'TERRAIN_COAST'\n\ndef is_water(node):\n    return node['terrain'] in ['TERRAIN_COAST', 'TERRAIN_OCEAN']\n\ndef is_valid_land(node):\n    return not is_water(node) and not is_mountain(node) and 'ICE' not in node['features']\n\ndef calc_campus(node, neighbors, dist_neighbors):\n    score = 0\n    score += sum(1 for n in neighbors if is_mountain(grid[n]))\n    score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\n    score += sum(2 for n in neighbors if 'FEATURE_REEF' in grid[n]['features'])\n    score += sum(2 for n in neighbors if 'FEATURE_GEOTHERMAL_FISSURE' in grid[n]['features'])\n    score += dist_neighbors // 2\n    return score\n\ndef calc_holy_site(node, neighbors, dist_neighbors):\n    score = 0\n    score += sum(1 for n in neighbors if is_mountain(grid[n]))\n    score += sum(1 for n in neighbors if 'FEATURE_FOREST' in grid[n]['features']) // 2\n    score += dist_neighbors // 2\n    return score\n\ndef calc_commercial_hub(node, neighbors, dist_neighbors):\n    score = 0\n    if node.get('has_river'):\n        score += 2\n    score += dist_neighbors // 2\n    return score\n\ndef calc_theater_square(node, neighbors, dist_neighbors):\n    score = 0\n    score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\n    score += dist_neighbors // 2\n    return score\n\ndef calc_harbor(node, neighbors, dist_neighbors):\n    score = 0\n    score += dist_neighbors // 2\n    return score\n\ncity_candidates = []\nfor coord, node in grid.items():\n    if is_valid_land(node):\n        city_candidates.append(coord)\n\ndef get_dist_score(dtype, coord, placed_districts, cc_coord):\n    neighbors = get_neighbors(coord[0], coord[1])\n    dist_neighbors = 0\n    for n in neighbors:\n        if n in placed_districts or n == cc_coord:\n            dist_neighbors += 1\n    node = grid[coord]\n    score = 0\n    if dtype == 'CAMPUS':\n        score = calc_campus(node, neighbors"]
[315.681012, "i", ", dist_neighbors)\n    elif dtype == 'HOLY_SITE':\n        score = calc_holy_site(node, neighbors, dist_neighbors)\n    elif dtype == 'COMMERCIAL_HUB':\n        score = calc_commercial_hub(node, neighbors, dist_neighbors)\n        # +2 from Harbor (Major Adjacency)\n        for n in neighbors:\n            if placed_districts.get(n) == 'HARBOR':\n                score += 2\n    elif dtype == 'THEATER_SQUARE':\n        score = calc_theater_square(node, neighbors, dist_neighbors)\n    elif dtype == 'HARBOR':\n        score = calc_harbor(node, neighbors, dist_neighbors)\n        if cc_coord in neighbors:\n            score += 2\n    return score\n\nintrinsic_scores = {}\nfor coord, node in grid.items():\n    neighbors = get_neighbors(*coord)\n    scores = {}\n    scores['CAMPUS'] = calc_campus(node, neighbors, 0)\n    scores['HOLY_SITE'] = calc_holy_site(node, neighbors, 0)\n    scores['COMMERCIAL_HUB'] = 2 if node.get('has_river') else 0\n    scores['THEATER_SQUARE'] = calc_theater_square(node, neighbors, 0)\n    scores['HARBOR'] = 0\n    intrinsic_scores[coord] = scores\n\ncandidate_priority = []\nfor cc in city_candidates:\n    score = 0\n    neighbors = get_neighbors(*cc)\n    for n in neighbors:\n        if n in intrinsic_scores:\n             score += max(intrinsic_scores[n].values())\n    candidate_priority.append((score, cc))\ncandidate_priority.sort(key=lambda x: x[0], reverse=True)\n\nbest_total = -1\nbest_solution = None\n\nfor _, cc in candidate_priority[:50]:\n    n1 = get_neighbors(*cc)\n    valid_spots = []\n    for n in n1:\n        if n not in valid_spots: valid_spots.append(n)\n    for n in n1:\n        for n2 in get_neighbors(*n):\n            if n2 != cc and n2 not in valid_spots: valid_spots.append(n2)\n    \n    land_spots = [p for p in valid_spots if is_valid_land(grid[p])]\n    coast_spots = [p for p in valid_spots if is_coast(grid[p])]\n    \n    top_land = sorted(land_spots, key=lambda p: max(intrinsic_scores[p].values()), reverse=True)[:6]\n    top_coast = coast_spots[:3]\n    pool = top_land + top_coast\n    if len(pool) < 3: continue\n    \n    import itertools\n    for spot_combo in itertools.combinations(pool, 3):\n        spot_types = []\n        for spot in spot_combo:\n            if is_coast(grid[spot]): spot_types.append(['HARBOR'])\n            else: spot_types.append(['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE'])\n        \n        for types in itertools.product(*spot_types):\n            placements = {}\n            for i in range(3):\n                placements[spot_combo[i]] = types[i]\n            if len(set(types)) != 3: continue\n                \n            current_adj = 0\n            bonuses = {}\n            for spot, dtype in placements.items():\n                score = get_dist_score(dtype, spot, placements, cc)\n                bonuses[dtype] = score\n                current_adj += score\n            \n            if current_adj > best_total:\n                best_total = current_adj\n                best_solution = {\n                    \"city_center\": list(cc),\n                    \"placements\": {k: list(v) for v, k in placements.items()},\n                    \"adjacency_bonuses\": bonuses,\n                    \"total_adjacency\": current_adj\n                }\n\nprint(json.dumps(best_solution, indent=2))\nEOF\npython3 solve.py > /output/scenario_3.json\n"]
