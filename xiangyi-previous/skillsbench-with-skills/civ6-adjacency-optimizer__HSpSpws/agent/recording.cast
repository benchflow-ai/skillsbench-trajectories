[155.087245, "o", "{\r\n  \"map\": {\r\n    \"ID\": \"Default\",\r\n    \"Width\": 44,\r\n    \"Height\": 26,\r\n    \"TopLatitude\": 90,\r\n    \"BottomLatitude\": -90,\r\n    \"WrapX\": 1,\r\n    \"WrapY\": 0,\r\n    \"MapSizeType\": \"MAPSIZE_DUEL\"\r\n  },\r\n  \"plots\": [\r\n    {\r\n      \"ID\": 0,\r\n      \"TerrainType\": \"TERRAIN_OCEAN\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 1,\r\n      \"TerrainType\": \"TERRAIN_OCEAN\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 2,\r\n      \"TerrainType\": \"TERRAIN_OCEAN\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 3,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 4,\r\n      \"TerrainType\": \"TERRAIN_OCEAN\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 5,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 6,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 7,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 8,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 9,\r\n      \"TerrainType\": \"TERRAIN_OCEAN\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 10,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 11,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n    {\r\n      \"ID\": 12,\r\n      \"TerrainType\": \"TERRAIN_COAST\",\r\n      \"ContinentType\": \"\",\r\n      \"IsImpassable\": 1\r\n    },\r\n"]
