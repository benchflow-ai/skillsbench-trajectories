[315.710542, "o", "    for spot_combo in itertools.combinations(pool, 3):\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.710592, "o", "> "]
[315.710642, "o", "        spot_types = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.710705, "o", "        for spot in spot_combo:\r\n\u001b[?2004l\r"]
[315.710755, "o", "\u001b[?2004h> "]
[315.710877, "o", "            if is_coast(grid[spot]): spot_types.append(['HARBOR'])\r\n\u001b[?2004l\r"]
[315.710927, "o", "\u001b[?2004h> "]
[315.711096, "o", "            else: spot_types.append(['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE'])\r\n\u001b[?2004l\r"]
[315.711152, "o", "\u001b[?2004h> "]
[315.71121, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.711274, "o", "        for types in itertools.product(*spot_types):\r\n\u001b[?2004l\r"]
[315.711325, "o", "\u001b[?2004h> "]
[315.71138, "o", "            placements = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.71144, "o", "            for i in range(3):\r\n\u001b[?2004l\r"]
[315.711514, "o", "\u001b[?2004h> "]
[315.711608, "o", "                placements[spot_combo[i]] = types[i]\r\n\u001b[?2004l\r"]
[315.711668, "o", "\u001b[?2004h> "]
[315.711737, "o", "            if len(set(types)) != 3: continue\r\n\u001b[?2004l\r"]
[315.711785, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[315.711836, "o", "\u001b[?2004h> "]
[315.711884, "o", "            current_adj = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.711933, "o", "> "]
[315.71198, "o", "            bonuses = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712028, "o", "> "]
[315.712094, "o", "            for spot, dtype in placements.items():\r\n\u001b[?2004l\r"]
[315.712143, "o", "\u001b[?2004h> "]
[315.712246, "o", "                score = get_dist_score(dtype, spot, placements, cc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712295, "o", "> "]
[315.712345, "o", "                bonuses[dtype] = score\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712393, "o", "> "]
[315.712442, "o", "                current_adj += score\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712489, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712537, "o", "> "]
[315.712586, "o", "            if current_adj > best_total:\r\n\u001b[?2004l\r"]
[315.712638, "o", "\u001b[?2004h> "]
[315.712686, "o", "                best_total = current_adj\r\n\u001b[?2004l\r"]
[315.712734, "o", "\u001b[?2004h> "]
[315.712782, "o", "                best_solution = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.712832, "o", "> "]
[315.712881, "o", "                    \"city_center\": list(cc),\r\n\u001b[?2004l\r"]
[315.712932, "o", "\u001b[?2004h> "]
[315.715532, "o", "                    \"placements\": {k: list(v) for v, k in placements.items()},\r\n\u001b[?2004l\r\u001b[?2004h>                     \"adjacency_bonuses\": bonuses,\r\n\u001b[?2004l\r\u001b[?2004h>                     \"total_adjacency\": current_adj\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(best_solution, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@c65979f7338e:~# python3 solve.py > /output/scenario_3.json\r\n\u001b[?2004l\r"]
