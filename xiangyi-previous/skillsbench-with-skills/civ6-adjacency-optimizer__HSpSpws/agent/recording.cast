[315.68155, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.681697, "o", "import math\r\n\u001b[?2004l\rT\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.681761, "o", "with open('map_dump.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.681861, "o", "    data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[315.681915, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[315.682011, "o", "width = data['map']['Width']\r\n\u001b[?2004l\r"]
[315.682061, "o", "\u001b[?2004h> "]
[315.682157, "o", "height = data['map']['Height']\r\n\u001b[?2004l\r"]
