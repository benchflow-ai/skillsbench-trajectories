[147.718233, "i", "cat <<EOF > dump_map.py\nimport sqlite3\nimport json\n\ndef row_to_dict(cursor, row):\n    return {col[0]: row[idx] for idx, col in enumerate(cursor.description)}\n\nconn = sqlite3.connect('/data/maps/e2e_test_case_0.Civ6Map')\ncursor = conn.cursor()\n\nmap_info = row_to_dict(cursor, cursor.execute('SELECT * FROM Map').fetchone())\nplots = [row_to_dict(cursor, row) for row in cursor.execute('SELECT * FROM Plots').fetchall()]\nfeatures = {row['ID']: row for row in [row_to_dict(cursor, r) for r in cursor.execute('SELECT * FROM PlotFeatures').fetchall()]}\nresources = {row['ID']: row for row in [row_to_dict(cursor, r) for r in cursor.execute('SELECT * FROM PlotResources').fetchall()]}\nrivers = {row['ID']: row for row in [row_to_dict(cursor, r) for r in cursor.execute('SELECT * FROM PlotRivers').fetchall()]}\n\ndata = {\n    'map': map_info,\n    'plots': plots,\n    'features': features,\n    'resources': resources,\n    'rivers': rivers\n}\n\nprint(json.dumps(data, indent=2))\nEOF\npython3 dump_map.py > map_dump.json\n"]
