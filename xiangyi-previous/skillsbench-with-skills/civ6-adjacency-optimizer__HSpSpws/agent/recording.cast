[237.331134, "i", "cat <<EOF > solve.py\nimport json\nimport math\n\n# Load Data\nwith open('map_dump.json') as f:\n    data = json.load(f)\n\nwidth = data['map']['Width']\nheight = data['map']['Height']\nwrap_x = data['map']['WrapX']\n\n# Parse Plots\ngrid = {}\nfor p in data['plots']:\n    pid = p['ID']\n    x = pid % width\n    y = pid // width\n    grid[(x, y)] = {\n        'id': pid,\n        'terrain': p['TerrainType'],\n        'features': [],\n        'river_edges': [], # To be filled\n        'x': x, 'y': y\n    }\n\n# Add Features\nfor fid, f in data['features'].items():\n    pid = int(fid)\n    if pid in data['features']:\n        # Wait, features dict keys are IDs, but is it PlotID? \n        # The schema was ID, FeatureType. In PlotFeatures, ID is likely PlotID.\n        # Let's verify this assumption. Usually ID is the primary key of the table, but here it acts as a foreign key to Plots? \n        # Or is ID the row ID? \n        # In Civ6Map, PlotFeatures usually maps PlotIndex -> Feature. \n        # Let's assume the key in the dict (which came from 'ID' column) is the Plot ID.\n        pass\n\n# Re-reading dump logic: \n# features = {row['ID']: row ...}\n# If ID is unique per row in PlotFeatures table, then it's just a row ID. \n# But PlotFeatures usually links a Plot to a Feature. \n# Let's check the schema again. \n# PlotFeatures: ['ID', 'FeatureType']\n# In Civ6 DBs, usually tables like PlotFeatures have (PlotID, FeatureType) or (ID, FeatureType) where ID is PlotID.\n# Since there's only ID and FeatureType, ID must be the PlotID.\n\nfor f in data['features'].values():\n    pid = f['ID']\n    x = pid % width\n    y = pid // width\n    if (x, y) in grid:\n        grid[(x, y)]['features'].append(f['FeatureType'])\n\n# Add Rivers\n# PlotRivers: ['ID', 'IsNEOfRiver', 'IsWOfRiver', 'IsNWOfRiver', ...]\nfor r in data['rivers'].values():\n    pid = r['ID']\n    x = pid % width\n    y = pid // width\n    if (x, y) in grid:\n        # Store river info. A plot is \"on a river\" if any edge is a river.\n        # Edges: NE, W, NW. \n        # If any is 1, it has a river.\n        # Also need to check neighbors' edges that touch this plot.\n        # But for Commercial Hub, we just need \"Is adjacent to River\".\n        # If any edge of the hex is a river, the tile is adjacent to a river.\n        # The columns IsNEOfRiver etc tell us if specific edges are rivers.\n        edges = [r.get('IsNEOfRiver', 0), r.get('IsWOfRiver', 0), r.get('IsNWOfRiver', 0)]\n        if any(e == 1 for e in edges):\n             grid[(x, y)]['river'] = True\n        # We also need to check if neighbors have rivers on shared edges.\n        # However, usually the DB stores all river segments.\n        # If the current plot has 'IsWOfRiver', that is the West edge.\n        # The East edge is the West edge of the neighbor to the East.\n        # So we need to propagate or check all.\n        # Actually, simpler: A plot is river-adjacent if it has ANY river edge.\n        # The DB entry for Plot P tells if W, NW, NE edges are rivers.\n        # We need to check P's W, NW, NE.\n        # AND P's neighbors who share edges with P.\n        # E neighbor's W edge = P's E edge.\n        # SW neighbor's NE edge = P's SW edge.\n        # SE neighbor's NW edge = P's SE edge.\n\n# Let's build a proper function for neighbors\ndef get_neighbors(x, y):\n    # Odd-r offset (typical for Civ)\n    # Even rows (0, 2, ...): (x-1, y-1), (x, y-1), (x-1, y), (x+1, y), (x-1, y+1), (x, y+1)\n    # Odd rows (1, 3, ...):  (x, y-1), (x+1, y-1), (x-1, y), (x+1, y), (x, y+1), (x+1, y+1)\n    # Wait, let's verify odd-r vs even-r vs others. \n    # Civ 6 maps usually start at (0,0) bottom-left or top-left. \n    # Let's assume standard \"Odd-Q\" or \"Odd-R\". \n    # Most sources say Civ 6 uses \"pointy topped hexes\" and \"odd-offset\" for columns? Or rows?\n    # Width 44, Height 26. \n    # Let's assume standard Civ logic: \n    # y is row. x is col.\n    # offset depends on y.\n    # if y is odd, x is shifted.\n    \n    # Neighbors for (x,y):\n    # West: (x-1, y)\n    # East: (x+1, y)\n    # NW, NE, SW, SE depend on parity of y.\n    \n    # Parity 0 (Even Row):\n    # NW: (x-1, y+1) ? Coordina"]
[237.331379, "i", "te system usually has y going up or down.\n    # Let's assume y goes up (0 at bottom). \n    # Actually, let's stick to the list of 6 neighbors.\n    # Common Civ6 offset:\n    # neighbors = [\n    #    (x-1, y), (x+1, y), \n    #    (x + (y%2) - 1, y-1), (x + (y%2), y-1),\n    #    (x + (y%2) - 1, y+1), (x + (y%2), y+1)\n    # ]\n    # This covers the 6 directions.\n    \n    n = []\n    offset = y % 2\n    # Directions: W, E, SW, SE, NW, NE (assuming y increases upwards or downwards)\n    # Using the standard odd-r formula:\n    candidates = [\n        (x - 1, y),\n        (x + 1, y),\n        (x - 1 + offset, y - 1),\n        (x + offset, y - 1),\n        (x - 1 + offset, y + 1),\n        (x + offset, y + 1)\n    ]\n    \n    valid = []\n    for nx, ny in candidates:\n        if wrap_x:\n            nx = nx % width\n        if 0 <= nx < width and 0 <= ny < height:\n            valid.append((nx, ny))\n    return valid\n\n# Precompute river adjacency\n# First, populate intrinsic edges\nriver_edges = {} # (x, y, dir) -> bool. Dir: 0=W, 1=NW, 2=NE (matching DB columns)\nfor r in data['rivers'].values():\n    pid = r['ID']\n    x = pid % width\n    y = pid // width\n    if r.get('IsWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'W')] = True\n    if r.get('IsNWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NW')] = True\n    if r.get('IsNEOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NE')] = True\n\n# Now propagate to neighbors to set 'has_river' for them too\n# W edge of (x,y) is E edge of (x-1, y)\n# NW edge of (x,y) is SE edge of neighbor in NW direction\n# NE edge of (x,y) is SW edge of neighbor in NE direction\n\n# We need exact neighbor mapping to propagate.\n# Let's define directions explicitly.\n# Even y (offset 0): \n#   NW is (x-1, y+1) (assuming y increases)\n#   NE is (x, y+1)\n# Odd y (offset 1):\n#   NW is (x, y+1)\n#   NE is (x+1, y+1)\n# (This assumes y increases going \"up\" or \"down\" and consistent with the formula above)\n\n# Let's verify the formula:\n# (x - 1 + offset, y + 1) -> if offset=0: x-1. if offset=1: x. -> This matches NW.\n# (x + offset, y + 1)     -> if offset=0: x.   if offset=1: x+1. -> This matches NE.\n\n# So:\n# NW neighbor of (x,y) is (x - 1 + (y%2), y + 1)\n# NE neighbor of (x,y) is (x + (y%2), y + 1)\n# W neighbor is (x-1, y)\n\n# Propagation:\nfor (x,y), node in grid.items():\n    offset = y % 2\n    # Check W edge (shared with W neighbor)\n    if river_edges.get((x,y,'W')):\n        w_neighbor = ((x-1)%width, y) if wrap_x else (x-1, y)\n        if w_neighbor in grid: grid[w_neighbor]['has_river'] = True\n    \n    # Check NW edge (shared with NW neighbor)\n    if river_edges.get((x,y,'NW')):\n        # NW neighbor shares SE edge. \n        nw_nx = x - 1 + offset\n        nw_ny = y + 1 # Assuming y+1 is the row \"above\" or \"below\". Direction doesn't matter for adjacency.\n        nw_neighbor = (nw_nx%width, nw_ny) if wrap_x else (nw_nx, nw_ny)\n        if nw_neighbor in grid: grid[nw_neighbor]['has_river'] = True\n        \n    # Check NE edge (shared with NE neighbor)\n    if river_edges.get((x,y,'NE')):\n        # NE neighbor shares SW edge.\n        ne_nx = x + offset\n        ne_ny = y + 1\n        ne_neighbor = (ne_nx%width, ne_ny) if wrap_x else (ne_nx, ne_ny)\n        if ne_neighbor in grid: grid[ne_neighbor]['has_river'] = True\n\n# Helper to check terrain\ndef is_mountain(node):\n    return 'MOUNTAIN' in node['terrain']\n\ndef is_coast(node):\n    return node['terrain'] == 'TERRAIN_COAST'\n\ndef is_water(node):\n    return node['terrain'] in ['TERRAIN_COAST', 'TERRAIN_OCEAN']\n\ndef is_valid_land(node):\n    return not is_water(node) and not is_mountain(node) and 'ICE' not in node['features']\n\n# Adjacency Calculators\ndef calc_campus(node, neighbors, dist_neighbors):\n    score = 0\n    # Mountains\n    score += sum(1 for n in neighbors if is_mountain(grid[n]))\n    # Rainforest\n    score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\n    # Reef\n    score += sum(2 for n in neighbors if 'FEATURE_REEF' in grid[n]['features'])\n    # Geothermal\n    score += sum(2 for n in neighbors if 'FEATURE_GEOTHERMAL_FISSURE"]
[237.331453, "i", "' in grid[n]['features'])\n    # Districts\n    score += dist_neighbors // 2\n    return score\n\ndef calc_holy_site(node, neighbors, dist_neighbors):\n    score = 0\n    score += sum(1 for n in neighbors if is_mountain(grid[n]))\n    score += sum(1 for n in neighbors if 'FEATURE_FOREST' in grid[n]['features']) // 2\n    score += dist_neighbors // 2\n    return score\n\ndef calc_commercial_hub(node, neighbors, dist_neighbors):\n    score = 0\n    if node.get('has_river'):\n        score += 2\n    # Harbor adjacency handled in combination check\n    score += dist_neighbors // 2\n    return score\n\ndef calc_theater_square(node, neighbors, dist_neighbors):\n    score = 0\n    # Wonders (None)\n    # Rainforest\n    score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\n    # Entertainment Complex / Water Park (handled in combination)\n    score += dist_neighbors // 2\n    return score\n\ndef calc_harbor(node, neighbors, dist_neighbors):\n    score = 0\n    # City Center (handled in combination)\n    # Coastal Resources (None)\n    score += dist_neighbors // 2\n    return score\n\ndef calc_industrial_zone(node, neighbors, dist_neighbors):\n    score = 0\n    # Mines/Quarries (None)\n    # Aqueduct/Canal/Dam (None)\n    score += dist_neighbors // 2\n    return score\n\n# Solver\nbest_total = -1\nbest_solution = None\n\n# 1. Identify valid City Center locations\ncity_candidates = []\nfor coord, node in grid.items():\n    if is_valid_land(node):\n        city_candidates.append(coord)\n\nprint(f\"Found {len(city_candidates)} valid city center locations.\")\n\n# Optimization: Only check candidates with some potential\n# For simplicity, we might have to check many. \n# But we can filter: City Center should probably be near Mountains, Rivers, or Coast to enable good districts.\n\nDISTRICT_TYPES = ['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE', 'HARBOR']\n# Industrial Zone is useless without resources/mines here (only district adjacency)\n\ndef get_dist_score(dtype, coord, placed_districts, cc_coord):\n    neighbors = get_neighbors(coord[0], coord[1])\n    dist_neighbors = 0\n    for n in neighbors:\n        if n in placed_districts or n == cc_coord:\n            dist_neighbors += 1\n    \n    node = grid[coord]\n    score = 0\n    if dtype == 'CAMPUS':\n        score = calc_campus(node, neighbors, dist_neighbors)\n    elif dtype == 'HOLY_SITE':\n        score = calc_holy_site(node, neighbors, dist_neighbors)\n    elif dtype == 'COMMERCIAL_HUB':\n        score = calc_commercial_hub(node, neighbors, dist_neighbors)\n        # +1 from Harbor\n        for n in neighbors:\n            if placed_districts.get(n) == 'HARBOR':\n                score += 1\n    elif dtype == 'THEATER_SQUARE':\n        score = calc_theater_square(node, neighbors, dist_neighbors)\n    elif dtype == 'HARBOR':\n        score = calc_harbor(node, neighbors, dist_neighbors)\n        # +2 from City Center\n        if cc_coord in neighbors:\n            score += 2\n    return score\n\n# Main Loop\n# Limit candidates to speed up? \n# Let's try to evaluate intrinsic value of each plot for each district type.\n# Then for each city candidate, pick the best nearby spots.\n\nimport time\nstart_time = time.time()\n\nchecked = 0\n\n# Pre-calculate intrinsic scores for all plots for each district type (ignoring district adjacency)\nintrinsic_scores = {}\nfor coord, node in grid.items():\n    neighbors = get_neighbors(*coord)\n    scores = {}\n    scores['CAMPUS'] = calc_campus(node, neighbors, 0)\n    scores['HOLY_SITE'] = calc_holy_site(node, neighbors, 0)\n    scores['COMMERCIAL_HUB'] = 2 if node.get('has_river') else 0\n    scores['THEATER_SQUARE'] = calc_theater_square(node, neighbors, 0)\n    scores['HARBOR'] = 0 # Depends on CC\n    intrinsic_scores[coord] = scores\n\n# Sort city candidates by sum of best 3 nearby intrinsic scores?\n# This helps prioritize.\ncandidate_priority = []\nfor cc in city_candidates:\n    # Get all valid tiles within range 3\n    # BFS to find range 3\n    # But for adjacency, we usually care about range 1 or 2 for clustering.\n    # Let's just look at immediate neighbors for clustering potential.\n    # Actually, we need"]
[237.331501, "i", " to place 3 districts. They can be anywhere in range 3.\n    # But to get adjacency bonuses, they usually need to be clustered.\n    \n    # Heuristic: Score = Sum of intrinsic scores of all neighbors.\n    score = 0\n    neighbors = get_neighbors(*cc)\n    for n in neighbors:\n        if n in intrinsic_scores:\n             score += max(intrinsic_scores[n].values())\n    candidate_priority.append((score, cc))\n\ncandidate_priority.sort(key=lambda x: x[0], reverse=True)\n\n# Check top 50 candidates\nfor _, cc in candidate_priority[:50]:\n    # Find valid district spots within range 3 (simplified to range 2 for clustering)\n    # Range 1 neighbors\n    n1 = get_neighbors(*cc)\n    valid_spots = []\n    for n in n1:\n        if n not in valid_spots:\n             valid_spots.append(n)\n    # Range 2\n    for n in n1:\n        for n2 in get_neighbors(*n):\n            if n2 != cc and n2 not in valid_spots:\n                valid_spots.append(n2)\n    \n    # Filter valid spots by terrain\n    # Harbor needs Coast. Others need Land.\n    land_spots = [p for p in valid_spots if is_valid_land(grid[p])]\n    coast_spots = [p for p in valid_spots if is_coast(grid[p])]\n    \n    # We need to choose 3 districts.\n    # Possible sets: 3 Land, 2 Land 1 Coast, etc.\n    # District types: Campus, Holy Site, Comm Hub, Theater, Harbor.\n    \n    # Brute force combinations of 3 spots from (land_spots + coast_spots)\n    # Limit spots to top intrinsic ones?\n    \n    # Let's take top 6 land spots by intrinsic score and top 3 coast spots.\n    top_land = sorted(land_spots, key=lambda p: max(intrinsic_scores[p].values()), reverse=True)[:6]\n    top_coast = coast_spots[:3] # Harbor intrinsic is 0, so just take any.\n    \n    pool = top_land + top_coast\n    if len(pool) < 3: continue\n    \n    import itertools\n    for spot_combo in itertools.combinations(pool, 3):\n        # Assign types to spots\n        # We have 3 spots. We need to assign types.\n        # Types allowed: \n        # If spot is coast -> Harbor\n        # If spot is land -> Campus, Holy Site, Comm Hub, Theater\n        \n        # Determine possible types for each spot\n        spot_types = []\n        for spot in spot_combo:\n            if is_coast(grid[spot]):\n                spot_types.append(['HARBOR'])\n            else:\n                spot_types.append(['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE'])\n        \n        for types in itertools.product(*spot_types):\n            # types is a tuple like ('CAMPUS', 'HARBOR', 'COMMERCIAL_HUB')\n            # Calculate total adjacency\n            \n            # Construct placement dict\n            placements = {}\n            for i in range(3):\n                placements[spot_combo[i]] = types[i]\n            \n            # Verify uniqueness of types? \n            # Rules say \"Which districts to build\". Usually unique per city.\n            # Yes, a city can only build one of each district.\n            if len(set(types)) != 3:\n                continue\n                \n            current_adj = 0\n            bonuses = {}\n            \n            for spot, dtype in placements.items():\n                score = get_dist_score(dtype, spot, placements, cc)\n                bonuses[dtype] = score\n                current_adj += score\n            \n            if current_adj > best_total:\n                best_total = current_adj\n                best_solution = {\n                    \"city_center\": list(cc),\n                    \"placements\": {k: list(v) for v, k in placements.items()},\n                    \"adjacency_bonuses\": bonuses,\n                    \"total_adjacency\": current_adj\n                }\n\n# Output solution\nprint(json.dumps(best_solution, indent=2))\n\nEOF\npython3 solve.py > /output/scenario_3.json\n"]
