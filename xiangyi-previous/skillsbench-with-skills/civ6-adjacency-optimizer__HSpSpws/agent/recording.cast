[237.332316, "o", "height = data['map']['Height']\r\n\u001b[?2004l\r\u001b[?2004h> wrap_x = data['map']['WrapX']\r\n\u001b[?2004l\r"]
[237.332363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r,\u001b[?2004h> "]
[237.332455, "o", "# Parse Plots\r\n\u001b[?2004l\r\u001b[?2004h> grid = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.33254, "o", "for p in data['plots']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.33263, "o", "    pid = p['ID']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.33272, "o", "    x = pid % width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.332817, "o", "    y = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.332892, "o", "    grid[(x, y)] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.332983, "o", "> "]
[237.333031, "o", "        'id': pid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333121, "o", "        'terrain': p['TerrainType'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333197, "o", "        'features': [],\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.333282, "o", "> "]
[237.333364, "o", "        'river_edges': [], # To be filled\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333468, "o", "        'x': x, 'y': y\r\n\u001b[?2004l\r"]
[237.3336, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333661, "o", "# Add Features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333759, "o", "for fid, f in data['features'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333801, "o", "    pid = int(fid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.333921, "o", "    if pid in data['features']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.334092, "o", "        # Wait, features dict keys are IDs, but is it PlotID? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.334335, "o", "        # The schema was ID, FeatureType. In PlotFeatures, ID is likely PlotID.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.3347, "o", "        # Let's verify this assumption. Usually ID is the primary key of the table, but here it acts as a foreign key to Plots? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.334788, "o", "        # Or is ID the row ID? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.334996, "o", "        # In Civ6Map, PlotFeatures usually maps PlotIndex -> Feature. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.335254, "o", "        # Let's assume the key in the dict (which came from 'ID' column) is the Plot ID.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.335324, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.335358, "o", "\u001b[?2004h> "]
[237.335446, "o", "# Re-reading dump logic: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.33574, "o", "# features = {row['ID']: row ...}\r\n\u001b[?2004l\r\u001b[?2004h> # If ID is unique per row in PlotFeatures table, then it's just a row ID. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.347561, "o", "# But PlotFeatures usually links a Plot to a Feature. \r\n\u001b[?2004l\r\u001b[?2004h> # Let's check the schema again. \r\n\u001b[?2004l\r\u001b[?2004h> # PlotFeatures: ['ID', 'FeatureType']\r\n\u001b[?2004l\r\u001b[?2004h> # In Civ6 DBs, usually tables like PlotFeatures have (PlotID, FeatureType) or (ID, FeatureType) where ID is PlotID.\r\n\u001b[?2004l\r\u001b[?2004h> # Since there's only ID and FeatureType, ID must be the PlotID.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for f in data['features'].values():\r\n\u001b[?2004l\r\u001b[?2004h>     pid = f['ID']\r\n\u001b[?2004l\r\u001b[?2004h>     x = pid % width\r\n\u001b[?2004l\r\u001b[?2004h>     y = pid // width\r\n\u001b[?2004l\r\u001b[?2004h>     if (x, y) in grid:\r\n\u001b[?2004l\r\u001b[?2004h>         grid[(x, y)]['features'].append(f['FeatureType'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Add Rivers\r\n\u001b[?2004l\r\u001b[?2004h> # PlotRivers: ['ID', 'IsNEOfRiver', 'IsWOfRiver', 'IsNWOfRiver', ...]\r\n\u001b[?2004l\r\u001b[?2004h> for r in data['rivers'].values():\r\n\u001b[?2004l\r\u001b[?2004h>     pid = r['ID']\r\n\u001b[?2004l\r\u001b[?2004h>     x = pid % width\r\n\u001b[?2004l\r\u001b[?2004h>     y = pid // width\r\n\u001b[?2004l\r\u001b[?2004h>     if (x, y) in grid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.347852, "o", "        # Store river info. A plot is \"on a river\" if any edge is a river.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.347902, "o", "> "]
[237.348008, "o", "        # Edges: NE, W, NW. \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.348078, "o", "> "]
[237.348222, "o", "        # If any is 1, it has a river.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.348259, "o", "> "]
[237.348589, "o", "        # Also need to check neighbors' edges that touch this plot.\r\n\u001b[?2004l\r"]
[237.348669, "o", "\u001b[?2004h> "]
[237.348997, "o", "        # But for Commercial Hub, we just need \"Is adjacent to River\".\r\n\u001b[?2004l\r"]
[237.349071, "o", "\u001b[?2004h> "]
[237.349436, "o", "        # If any edge of the hex is a river, the tile is adjacent to a river.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.349507, "o", "> "]
[237.349834, "o", "        # The columns IsNEOfRiver etc tell us if specific edges are rivers.\r\n\u001b[?2004l\r"]
[237.349902, "o", "\u001b[?2004h> "]
[237.350352, "o", "        edges = [r.get('IsNEOfRiver', 0), r.get('IsWOfRiver', 0), r.get('IsNWOfRiver', 0)]\r\n\u001b[?2004l\r"]
[237.350396, "o", "\u001b[?2004h> "]
[237.350586, "o", "        if any(e == 1 for e in edges):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.350679, "o", "> "]
[237.350819, "o", "             grid[(x, y)]['river'] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.350887, "o", "> "]
[237.351189, "o", "        # We also need to check if neighbors have rivers on shared edges.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.351259, "o", "> "]
[237.351551, "o", "        # However, usually the DB stores all river segments.\r\n\u001b[?2004l\r"]
[237.351638, "o", "\u001b[?2004h> "]
[237.351812, "o", "        # If the current plot has 'IsWOfRiver', that is the West edge.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.352092, "o", "        # The East edge is the West edge of the neighbor to the East.\r\n\u001b[?2004l\r"]
[237.352205, "o", "\u001b[?2004h> "]
[237.352329, "o", "        # So we need to propagate or check all.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.352431, "o", "> "]
[237.359904, "o", "        # Actually, simpler: A plot is river-adjacent if it has ANY river edge.\r\n\u001b[?2004l\r"]
[237.36006, "o", "\u001b[?2004h> "]
[237.360312, "o", "        # The DB entry for Plot P tells if W, NW, NE edges are rivers.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.360367, "o", "> "]
[237.360533, "o", "        # We need to check P's W, NW, NE.\r\n\u001b[?2004l\r"]
[237.360651, "o", "\u001b[?2004h> "]
[237.360829, "o", "        # AND P's neighbors who share edges with P.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.36091, "o", "> "]
[237.361026, "o", "        # E neighbor's W edge = P's E edge.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.361087, "o", "> "]
[237.361229, "o", "        # SW neighbor's NE edge = P's SW edge.\r\n\u001b[?2004l\r"]
[237.361278, "o", "\u001b[?2004h> "]
[237.361436, "o", "        # SE neighbor's NW edge = P's SE edge.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.361481, "o", "> \r\n\u001b[?2004l\r"]
[237.361527, "o", "\u001b[?2004h> "]
[237.361673, "o", "# Let's build a proper function for neighbors\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.361716, "o", "> "]
[237.361797, "o", "def get_neighbors(x, y):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.361841, "o", "> "]
[237.361971, "o", "    # Odd-r offset (typical for Civ)\r\n\u001b[?2004l\r"]
[237.362017, "o", "\u001b[?2004h> "]
[237.362346, "o", "    # Even rows (0, 2, ...): (x-1, y-1), (x, y-1), (x-1, y), (x+1, y), (x-1, y+1), (x, y+1)\r\n\u001b[?2004l\r"]
[237.362392, "o", "\u001b[?2004h> "]
[237.362723, "o", "    # Odd rows (1, 3, ...):  (x, y-1), (x+1, y-1), (x-1, y), (x+1, y), (x, y+1), (x+1, y+1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.362781, "o", "> "]
[237.362947, "o", "    # Wait, let's verify odd-r vs even-r vs others. \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.362994, "o", "> "]
[237.363225, "o", "    # Civ 6 maps usually start at (0,0) bottom-left or top-left. \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.36327, "o", "> "]
[237.363445, "o", "    # Let's assume standard \"Odd-Q\" or \"Odd-R\". \r\n\u001b[?2004l\r"]
[237.363505, "o", "\u001b[?2004h> "]
[237.363907, "o", "    # Most sources say Civ 6 uses \"pointy topped hexes\" and \"odd-offset\" for columns? Or rows?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.36402, "o", "    # Width 44, Height 26. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.364214, "o", "    # Let's assume standard Civ logic: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.364345, "o", "    # y is row. x is col.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.364394, "o", "> "]
[237.364476, "o", "    # offset depends on y.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.364521, "o", "> "]
[237.364641, "o", "    # if y is odd, x is shifted.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.364688, "o", ">     \r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[237.364744, "o", "> "]
[237.364802, "o", "    # Neighbors for (x,y):\r\n\u001b[?2004l\r"]
[237.364847, "o", "\u001b[?2004h> "]
[237.364914, "o", "    # West: (x-1, y)\r\n\u001b[?2004l\rrs\u001b[?2004h"]
[237.364958, "o", "> "]
[237.365014, "o", "    # East: (x+1, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.365058, "o", "> "]
[237.36522, "o", "    # NW, NE, SW, SE depend on parity of y.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.365275, "o", "    \r\n\u001b[?2004l\r \u001b[?2004h> "]
[237.365399, "o", "    # Parity 0 (Even Row):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.365702, "o", "    # NW: (x-1, y+1) ? Coordinate system usually has y going up or down.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.365753, "o", "> "]
[237.365889, "o", "    # Let's assume y goes up (0 at bottom). \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.365933, "o", "> "]
[237.366134, "o", "    # Actually, let's stick to the list of 6 neighbors.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.366182, "o", "> "]
[237.366283, "o", "    # Common Civ6 offset:\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.366328, "o", "> "]
[237.366394, "o", "    # neighbors = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.36644, "o", "> "]
[237.366523, "o", "    #    (x-1, y), (x+1, y), \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.366569, "o", "> "]
[237.366757, "o", "    #    (x + (y%2) - 1, y-1), (x + (y%2), y-1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.366805, "o", "> "]
[237.366963, "o", "    #    (x + (y%2) - 1, y+1), (x + (y%2), y+1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.367009, "o", "> "]
[237.367056, "o", "    # ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.367276, "o", "    # This covers the 6 directions.\r\n\u001b[?2004l\r"]
[237.367321, "o", "\u001b[?2004h"]
[237.367364, "o", ">     \r\n\u001b[?2004l\r"]
[237.367409, "o", "\u001b[?2004h> "]
[237.367455, "o", "    n = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.367526, "o", "> "]
[237.375496, "o", "    offset = y % 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.375582, "o", ">     # Directions: W, E, SW, SE, NW, NE (assuming y increases upwards or downwards)\r\n\u001b[?2004l\r\u001b[?2004h>     # Using the standard odd-r formula:\r\n\u001b[?2004l\r\u001b[?2004h>     candidates = [\r\n\u001b[?2004l\r\u001b[?2004h>         (x - 1, y),\r\n\u001b[?2004l\r\u001b[?2004h>         (x + 1, y),\r\n\u001b[?2004l\r\u001b[?2004h>         (x - 1 + offset, y - 1),\r\n\u001b[?2004l\r\u001b[?2004h>         (x + offset, y - 1),\r\n\u001b[?2004l\r\u001b[?2004h>         (x - 1 + offset, y + 1),\r\n\u001b[?2004l\r\u001b[?2004h>         (x + offset, y + 1)\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r+\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     valid = []\r\n\u001b[?2004l\r\u001b[?2004h>     for nx, ny in candidates:\r\n\u001b[?2004l\r\u001b[?2004h>         if wrap_x:\r\n\u001b[?2004l\r\u001b[?2004h>             nx = nx % width\r\n\u001b[?2004l\r\u001b[?2004h>         if 0 <= nx < width and 0 <= ny < height:\r\n\u001b[?2004l\r\u001b[?2004h>             valid.append((nx, ny))\r\n\u001b[?2004l\r\u001b[?2004h>     return valid\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> # Precompute river adjacency\r\n\u001b[?2004l\r\u001b[?2004h> # First, populate intrinsic edges\r\n\u001b[?2004l\r\u001b[?2004h> river_edges = {} # (x, y, dir) -> bool. Dir: 0=W, 1=NW, 2=NE (matching DB columns)\r\n\u001b[?2004l\r\u001b[?2004h> for r in data['rivers'].values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.375635, "o", "    pid = r['ID']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.375702, "o", "    x = pid % width\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.375755, "o", "> "]
[237.375825, "o", "    y = pid // width\r\n\u001b[?2004l\r"]
[237.375877, "o", "\u001b[?2004h> "]
[237.376272, "o", "    if r.get('IsWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'W')] = True\r\n\u001b[?2004l\r"]
[237.37632, "o", "\u001b[?2004h> "]
[237.376762, "o", "    if r.get('IsNWOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NW')] = True\r\n\u001b[?2004l\r"]
[237.376818, "o", "\u001b[?2004h> "]
[237.377239, "o", "    if r.get('IsNEOfRiver'): grid[(x,y)]['has_river'] = True; river_edges[(x,y,'NE')] = True\r\n\u001b[?2004l\r"]
[237.377299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[237.37735, "o", "\u001b[?2004h> "]
[237.377635, "o", "# Now propagate to neighbors to set 'has_river' for them too\r\n\u001b[?2004l\r"]
[237.377688, "o", "\u001b[?2004h> "]
[237.377901, "o", "# W edge of (x,y) is E edge of (x-1, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.377974, "o", "> "]
[237.378135, "o", "# NW edge of (x,y) is SE edge of neighbor in NW direction\r\n\u001b[?2004l\r"]
[237.378186, "o", "\u001b[?2004h> "]
[237.378392, "o", "# NE edge of (x,y) is SW edge of neighbor in NE direction\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.378447, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h"]
[237.378497, "o", "> "]
[237.378642, "o", "# We need exact neighbor mapping to propagate.\r\n\u001b[?2004l\r"]
[237.378692, "o", "\u001b[?2004h> "]
[237.378901, "o", "# Let's define directions explicitly.\r\n\u001b[?2004l\r"]
[237.378981, "o", "\u001b[?2004h> "]
[237.37911, "o", "# Even y (offset 0): \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.379281, "o", "#   NW is (x-1, y+1) (assuming y increases)\r\n\u001b[?2004l\r"]
[237.379309, "o", "\u001b[?2004h> "]
[237.379416, "o", "#   NE is (x, y+1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.379469, "o", "> "]
[237.379553, "o", "# Odd y (offset 1):\r\n\u001b[?2004l\r"]
[237.379579, "o", "\u001b[?2004h> "]
[237.37973, "o", "#   NW is (x, y+1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.379828, "o", "#   NE is (x+1, y+1)\r\n\u001b[?2004l\rZ\u001b[?2004h> "]
[237.380155, "o", "# (This assumes y increases going \"up\" or \"down\" and consistent with the formula above)\r\n\u001b[?2004l\r"]
[237.380183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[237.38021, "o", "> "]
[237.38036, "o", "# Let's verify the formula:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.380664, "o", "# (x - 1 + offset, y + 1) -> if offset=0: x-1. if offset=1: x. -> This matches NW.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.380693, "o", "> "]
[237.381026, "o", "# (x + offset, y + 1)     -> if offset=0: x.   if offset=1: x+1. -> This matches NE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.381058, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.381083, "o", "> "]
[237.381113, "o", "# So:\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.381142, "o", "> "]
[237.381393, "o", "# NW neighbor of (x,y) is (x - 1 + (y%2), y + 1)\r\n\u001b[?2004l\r"]
[237.381421, "o", "\u001b[?2004h> "]
[237.381687, "o", "# NE neighbor of (x,y) is (x + (y%2), y + 1)\r\n\u001b[?2004l\r"]
[237.381717, "o", "\u001b[?2004h> "]
[237.381862, "o", "# W neighbor is (x-1, y)\r\n\u001b[?2004l\r"]
[237.381894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.381924, "o", "\u001b[?2004h> "]
[237.382088, "o", "# Propagation:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.382268, "o", "for (x,y), node in grid.items():\r\n\u001b[?2004l\r"]
[237.382302, "o", "\u001b[?2004h> "]
[237.38243, "o", "    offset = y % 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.3827, "o", "    # Check W edge (shared with W neighbor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.382733, "o", "> "]
[237.382935, "o", "    if river_edges.get((x,y,'W')):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.382965, "o", "> "]
[237.383266, "o", "        w_neighbor = ((x-1)%width, y) if wrap_x else (x-1, y)\r\n\u001b[?2004l\r"]
[237.383294, "o", "\u001b[?2004h> "]
[237.385666, "o", "        if w_neighbor in grid: grid[w_neighbor]['has_river'] = True\r\n\u001b[?2004l\r"]
[237.385701, "o", "\u001b[?2004h> "]
[237.385847, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.38606, "o", "    # Check NW edge (shared with NW neighbor)\r\n\u001b[?2004l\r"]
[237.38609, "o", "\u001b[?2004h> "]
[237.386319, "o", "    if river_edges.get((x,y,'NW')):\r\n\u001b[?2004l\r"]
[237.386352, "o", "\u001b[?2004h> "]
[237.386494, "o", "        # NW neighbor shares SE edge. \r\n\u001b[?2004l\r"]
[237.386577, "o", "\u001b[?2004h> "]
[237.386603, "o", "        nw_nx = x - 1 + offset\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.386627, "o", "> "]
[237.387111, "o", "        nw_ny = y + 1 # Assuming y+1 is the row \"above\" or \"below\". Direction doesn't matter for adjacency.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.387157, "o", "> "]
[237.387364, "o", "        nw_neighbor = (nw_nx%width, nw_ny) if wrap_x else (nw_nx, nw_ny)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.387612, "o", "        if nw_neighbor in grid: grid[nw_neighbor]['has_river'] = True\r\n\u001b[?2004l\r"]
[237.387643, "o", "\u001b[?2004h> "]
[237.387762, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.387968, "o", "    # Check NE edge (shared with NE neighbor)\r\n\u001b[?2004l\r"]
[237.388051, "o", "\u001b[?2004h> "]
[237.388181, "o", "    if river_edges.get((x,y,'NE')):\r\n\u001b[?2004l\r"]
[237.388259, "o", "\u001b[?2004h> "]
[237.388406, "o", "        # NE neighbor shares SW edge.\r\n\u001b[?2004l\r"]
[237.388483, "o", "\u001b[?2004h> "]
[237.388575, "o", "        ne_nx = x + offset\r\n\u001b[?2004l\r"]
[237.388652, "o", "\u001b[?2004h> "]
[237.388727, "o", "        ne_ny = y + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.3888, "o", "> "]
[237.389112, "o", "        ne_neighbor = (ne_nx%width, ne_ny) if wrap_x else (ne_nx, ne_ny)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.389191, "o", "> "]
[237.389414, "o", "        if ne_neighbor in grid: grid[ne_neighbor]['has_river'] = True\r\n\u001b[?2004l\r"]
[237.389489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h"]
[237.38956, "o", "> "]
[237.389632, "o", "# Helper to check terrain\r\n\u001b[?2004l\r"]
[237.389703, "o", "\u001b[?2004h> "]
[237.389774, "o", "def is_mountain(node):\r\n\u001b[?2004l\r"]
[237.389854, "o", "\u001b[?2004h> "]
[237.389933, "o", "    return 'MOUNTAIN' in node['terrain']\r\n\u001b[?2004l\r"]
[237.390004, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[237.39008, "o", "def is_coast(node):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.390282, "o", "    return node['terrain'] == 'TERRAIN_COAST'\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.390362, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[237.390446, "o", "def is_water(node):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.39077, "o", "    return node['terrain'] in ['TERRAIN_COAST', 'TERRAIN_OCEAN']\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.390856, "o", "> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[237.390945, "o", "def is_valid_land(node):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.391019, "o", "> "]
[237.39143, "o", "    return not is_water(node) and not is_mountain(node) and 'ICE' not in node['features']\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.395516, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[237.398852, "o", "# Adjacency Calculators\r\n\u001b[?2004l\r\u001b[?2004h> def calc_campus(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     # Mountains\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(1 for n in neighbors if is_mountain(grid[n]))\r\n\u001b[?2004l\r\u001b[?2004h>     # Rainforest\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\r\n\u001b[?2004l\r\u001b[?2004h>     # Reef\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(2 for n in neighbors if 'FEATURE_REEF' in grid[n]['features'])\r\n\u001b[?2004l\r\u001b[?2004h>     # Geothermal\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(2 for n in neighbors if 'FEATURE_GEOTHERMAL_FISSURE' in grid[n]['features'])\r\n\u001b[?2004l\r\u001b[?2004h>     # Districts\r\n\u001b[?2004l\r\u001b[?2004h>     score += dist_neighbors // 2\r\n\u001b[?2004l\r\u001b[?2004h>     return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> def calc_holy_site(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(1 for n in neighbors if is_mountain(grid[n]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.398903, "o", "    score += sum(1 for n in neighbors if 'FEATURE_FOREST' in grid[n]['features']) // 2\r\n\u001b[?2004l\r\u001b[?2004h>     score += dist_neighbors // 2\r\n\u001b[?2004l\r\u001b[?2004h>     return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r)\u001b[?2004h> def calc_commercial_hub(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\ri\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     if node.get('has_river'):\r\n\u001b[?2004l\r\u001b[?2004h>         score += 2\r\n\u001b[?2004l\r\u001b[?2004h>     # Harbor adjacency handled in combination check\r\n\u001b[?2004l\r\u001b[?2004h>     score += dist_neighbors // 2\r\n\u001b[?2004l\r\u001b[?2004h>     return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> def calc_theater_square(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     # Wonders (None)\r\n\u001b[?2004l\r\u001b[?2004h>     # Rainforest\r\n\u001b[?2004l\r\u001b[?2004h>     score += sum(1 for n in neighbors if 'FEATURE_JUNGLE' in grid[n]['features']) // 2\r\n\u001b[?2004l\r\u001b[?2004h>     # Entertainment Complex / Water Park (handled in combination)\r\n\u001b[?2004l\r\u001b[?2004h>     score += dist_neighbors // 2\r\n\u001b[?2004l\r\u001b[?2004h>     return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> def calc_harbor(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.399236, "o", "    # City Center (handled in combination)\r\n\u001b[?2004l\r"]
[237.399336, "o", "\u001b[?2004h>     # Coastal Resources (None)\r\n\u001b[?2004l\r\u001b[?2004h>     score += dist_neighbors // 2\r\n\u001b[?2004l\r\u001b[?2004h>     return score\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.399422, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[237.399541, "o", "def calc_industrial_zone(node, neighbors, dist_neighbors):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.399635, "o", "    score = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.399719, "o", "    # Mines/Quarries (None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.39979, "o", "> "]
[237.399866, "o", "    # Aqueduct/Canal/Dam (None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.399964, "o", "    score += dist_neighbors // 2\r\n\u001b[?2004l\r"]
[237.400037, "o", "\u001b[?2004h> "]
[237.400118, "o", "    return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[237.400188, "o", "\u001b[?2004h> # Solver\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.40026, "o", "best_total = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.400331, "o", "best_solution = None\r\n\u001b[?2004l\r"]
[237.400402, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[237.400479, "o", "# 1. Identify valid City Center locations\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.400554, "o", "> "]
[237.400631, "o", "city_candidates = []\r\n\u001b[?2004l\rp\u001b[?2004h> "]
[237.400702, "o", "for coord, node in grid.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.400824, "o", "    if is_valid_land(node):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.400908, "o", "> "]
[237.400982, "o", "        city_candidates.append(coord)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h"]
[237.401055, "o", "> "]
[237.401283, "o", "print(f\"Found {len(city_candidates)} valid city center locations.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rb"]
[237.401371, "o", "\u001b[?2004h> "]
[237.401589, "o", "# Optimization: Only check candidates with some potential\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.401829, "o", "# For simplicity, we might have to check many. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.402318, "o", "# But we can filter: City Center should probably be near Mountains, Rivers, or Coast to enable good districts.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.402401, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.40273, "o", "DISTRICT_TYPES = ['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE', 'HARBOR']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.403114, "o", "# Industrial Zone is useless without resources/mines here (only district adjacency)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.403169, "o", "\u001b[?2004h> "]
[237.403366, "o", "def get_dist_score(dtype, coord, placed_districts, cc_coord):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.403567, "o", "    neighbors = get_neighbors(coord[0], coord[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.403625, "o", "> "]
[237.403681, "o", "    dist_neighbors = 0\r\n\u001b[?2004l\r"]
[237.403742, "o", "\u001b[?2004h> "]
[237.403824, "o", "    for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.404034, "o", ">         if n in placed_districts or n == cc_coord:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404178, "o", "            dist_neighbors += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404264, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404342, "o", "    node = grid[coord]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404419, "o", "    score = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404538, "o", "    if dtype == 'CAMPUS':\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.404629, "o", "> "]
[237.404799, "o", "        score = calc_campus(node, neighbors, dist_neighbors)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.404941, "o", "    elif dtype == 'HOLY_SITE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.405171, "o", "        score = calc_holy_site(node, neighbors, dist_neighbors)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.405345, "o", "    elif dtype == 'COMMERCIAL_HUB':\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.405404, "o", "> "]
[237.405602, "o", "        score = calc_commercial_hub(node, neighbors, dist_neighbors)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.405859, "o", "        # +1 from Harbor\r\n\u001b[?2004l\r\u001b[?2004h>         for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.405958, "o", "            if placed_districts.get(n) == 'HARBOR':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.406044, "o", "                score += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.406176, "o", "    elif dtype == 'THEATER_SQUARE':\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.406262, "o", "> "]
[237.40644, "o", "        score = calc_theater_square(node, neighbors, dist_neighbors)\r\n\u001b[?2004l\r"]
[237.406525, "o", "\u001b[?2004h>     elif dtype == 'HARBOR':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.406872, "o", "        score = calc_harbor(node, neighbors, dist_neighbors)\r\n\u001b[?2004l\r\u001b[?2004h>         # +2 from City Center\r\n\u001b[?2004l\r"]
[237.407101, "o", "\u001b[?2004h>         if cc_coord in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h>             score += 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.407182, "o", "    return score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.40725, "o", "\u001b[?2004h> # Main Loop\r\n\u001b[?2004l\r"]
[237.407307, "o", "\u001b[?2004h> "]
[237.407387, "o", "# Limit candidates to speed up? \r\n\u001b[?2004l\r\u001b[?2004h"]
[237.407441, "o", "> "]
[237.407721, "o", "# Let's try to evaluate intrinsic value of each plot for each district type.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.407892, "o", "# Then for each city candidate, pick the best nearby spots.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.407955, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.408008, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.408085, "o", "start_time = time.time()\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.408138, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.408193, "o", "checked = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.408241, "o", "\u001b[?2004h> "]
[237.408592, "o", "# Pre-calculate intrinsic scores for all plots for each district type (ignoring district adjacency)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.408664, "o", "intrinsic_scores = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.408886, "o", "for coord, node in grid.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.409048, "o", "    neighbors = get_neighbors(*coord)\r\n\u001b[?2004l\r\u001b[?2004h>     scores = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.409239, "o", "    scores['CAMPUS'] = calc_campus(node, neighbors, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.409306, "o", "> "]
[237.409449, "o", "    scores['HOLY_SITE'] = calc_holy_site(node, neighbors, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.409511, "o", "> "]
[237.409681, "o", "    scores['COMMERCIAL_HUB'] = 2 if node.get('has_river') else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.409741, "o", "> "]
[237.409932, "o", "    scores['THEATER_SQUARE'] = calc_theater_square(node, neighbors, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.409994, "o", "> "]
[237.410103, "o", "    scores['HARBOR'] = 0 # Depends on CC\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.410157, "o", "> "]
[237.410245, "o", "    intrinsic_scores[coord] = scores\r\n\u001b[?2004l\r"]
[237.410297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.410424, "o", "# Sort city candidates by sum of best 3 nearby intrinsic scores?\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.41048, "o", "> # This helps prioritize.\r\n\u001b[?2004l\r"]
[237.410533, "o", "\u001b[?2004h> "]
[237.410588, "o", "candidate_priority = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.410676, "o", "for cc in city_candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.41073, "o", "    # Get all valid tiles within range 3\r\n\u001b[?2004l\r"]
[237.410783, "o", "\u001b[?2004h> "]
[237.410834, "o", "    # BFS to find range 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411074, "o", "    # But for adjacency, we usually care about range 1 or 2 for clustering.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411203, "o", "    # Let's just look at immediate neighbors for clustering potential.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411334, "o", "    # Actually, we need to place 3 districts. They can be anywhere in range 3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411503, "o", "    # But to get adjacency bonuses, they usually need to be clustered.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[237.411579, "o", "\u001b[?2004h> "]
[237.411717, "o", "    # Heuristic: Score = Sum of intrinsic scores of all neighbors.\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.411788, "o", "> "]
[237.41184, "o", "    neighbors = get_neighbors(*cc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411891, "o", "    for n in neighbors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.411977, "o", "        if n in intrinsic_scores:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412118, "o", "             score += max(intrinsic_scores[n].values())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412226, "o", "    candidate_priority.append((score, cc))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[237.41231, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.41239, "o", "candidate_priority.sort(key=lambda x: x[0], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412467, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.41254, "o", "# Check top 50 candidates\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412617, "o", "for _, cc in candidate_priority[:50]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412781, "o", "    # Find valid district spots within range 3 (simplified to range 2 for clustering)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412868, "o", "    # Range 1 neighbors\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.412949, "o", "    n1 = get_neighbors(*cc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413025, "o", "    valid_spots = []\r\n\u001b[?2004l\r\u001b[?2004h>     for n in n1:\r\n\u001b[?2004l\r"]
[237.413105, "o", "\u001b[?2004h> "]
[237.413189, "o", "        if n not in valid_spots:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413266, "o", "             valid_spots.append(n)\r\n\u001b[?2004l\r\u001b[?2004h>     # Range 2\r\n\u001b[?2004l\r"]
[237.413334, "o", "\u001b[?2004h>     for n in n1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413426, "o", "        for n2 in get_neighbors(*n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413547, "o", "            if n2 != cc and n2 not in valid_spots:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413646, "o", "                valid_spots.append(n2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413717, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.413788, "o", "    # Filter valid spots by terrain\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.41388, "o", "    # Harbor needs Coast. Others need Land.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.413948, "o", "> "]
[237.414033, "o", "    land_spots = [p for p in valid_spots if is_valid_land(grid[p])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.414232, "o", "    coast_spots = [p for p in valid_spots if is_coast(grid[p])]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.414328, "o", "    # We need to choose 3 districts.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.414434, "o", "    # Possible sets: 3 Land, 2 Land 1 Coast, etc.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.414597, "o", "    # District types: Campus, Holy Site, Comm Hub, Theater, Harbor.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[237.414673, "o", "\u001b[?2004h> "]
[237.414823, "o", "    # Brute force combinations of 3 spots from (land_spots + coast_spots)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.414898, "o", "    # Limit spots to top intrinsic ones?\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[237.414967, "o", "\u001b[?2004h> "]
[237.415054, "o", "    # Let's take top 6 land spots by intrinsic score and top 3 coast spots.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415217, "o", "    top_land = sorted(land_spots, key=lambda p: max(intrinsic_scores[p].values()), reverse=True)[:6]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415347, "o", "    top_coast = coast_spots[:3] # Harbor intrinsic is 0, so just take any.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415412, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415471, "o", "    pool = top_land + top_coast\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415587, "o", "    if len(pool) < 3: continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415819, "o", "    import itertools\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.415956, "o", "    for spot_combo in itertools.combinations(pool, 3):\r\n\u001b[?2004l\r\u001b[?2004h>         # Assign types to spots\r\n\u001b[?2004l\r\u001b[?2004h>         # We have 3 spots. We need to assign types.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.416088, "o", ">         # Types allowed: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.416217, "o", "        # If spot is coast -> Harbor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.416298, "o", "        # If spot is land -> Campus, Holy Site, Comm Hub, Theater\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.41644, "o", "        # Determine possible types for each spot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.416524, "o", "        spot_types = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.416593, "o", "        for spot in spot_combo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.416661, "o", "            if is_coast(grid[spot]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.416729, "o", "> "]
[237.416825, "o", "                spot_types.append(['HARBOR'])\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r"]
[237.416908, "o", "\u001b[?2004h> "]
[237.417149, "o", "                spot_types.append(['CAMPUS', 'HOLY_SITE', 'COMMERCIAL_HUB', 'THEATER_SQUARE'])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.417294, "o", "        for types in itertools.product(*spot_types):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.417418, "o", "            # types is a tuple like ('CAMPUS', 'HARBOR', 'COMMERCIAL_HUB')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.417543, "o", "            # Calculate total adjacency\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.417659, "o", "            # Construct placement dict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.417772, "o", "            placements = {}\r\n\u001b[?2004l\r\u001b[?2004h>             for i in range(3):\r\n\u001b[?2004l\r"]
[237.417895, "o", "\u001b[?2004h>                 placements[spot_combo[i]] = types[i]\r\n\u001b[?2004l\r"]
[237.41801, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.418122, "o", "            # Verify uniqueness of types? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.418237, "o", "            # Rules say \"Which districts to build\". Usually unique per city.\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.418348, "o", "> "]
[237.418466, "o", "            # Yes, a city can only build one of each district.\r\n\u001b[?2004l\r\u001b[?2004h>             if len(set(types)) != 3:\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.418583, "o", ">                 continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[237.418699, "o", "\u001b[?2004h>             current_adj = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.418812, "o", "            bonuses = {}\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.418931, "o", "            for spot, dtype in placements.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419105, "o", "                score = get_dist_score(dtype, spot, placements, cc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419186, "o", "                bonuses[dtype] = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419274, "o", "                current_adj += score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419399, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419437, "o", "            if current_adj > best_total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419656, "o", "                best_total = current_adj\r\n\u001b[?2004l\r\u001b[?2004h>                 best_solution = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419748, "o", "                    \"city_center\": list(cc),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419866, "o", "                    \"placements\": {k: list(v) for v, k in placements.items()},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.419953, "o", "                    \"adjacency_bonuses\": bonuses,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.420048, "o", "                    \"total_adjacency\": current_adj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.420129, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.420208, "o", "# Output solution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.420289, "o", "print(json.dumps(best_solution, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
