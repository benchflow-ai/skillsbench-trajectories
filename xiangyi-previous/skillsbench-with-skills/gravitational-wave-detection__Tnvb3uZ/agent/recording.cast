[430.131759, "o", "                \r\n\u001b[?2004l\r"]
[430.131767, "o", "\u001b[?2004h"]
[430.13178, "o", "> "]
[430.131886, "o", "                if peak > best_snr:\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.131899, "o", "> "]
[430.13199, "o", "                    best_snr = peak\r\n\u001b[?2004l\r"]
[430.132004, "o", "\u001b[?2004h"]
[430.132015, "o", "> "]
[430.132121, "o", "                    best_total_mass = m1 + m2\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.132136, "o", "> "]
[430.132225, "o", "            except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.13224, "o", "> "]
[430.132377, "o", "                print(f\"Error with {approx} m1={m1} m2={m2}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.132398, "o", "> "]
[430.132447, "o", "                continue\r\n\u001b[?2004l\r"]
[430.132471, "o", "\u001b[?2004h> "]
[430.132498, "o", "    \r\n\u001b[?2004l\r"]
[430.132505, "o", "\u001b[?2004h"]
[430.132519, "o", "> "]
[430.132689, "o", "    print(f\"Result for {approx}: SNR={best_snr}, Mass={best_total_mass}\")\r\n\u001b[?2004l\r"]
[430.132702, "o", "\u001b[?2004h> "]
[430.13284, "o", "    results.append((approx, best_snr, best_total_mass))\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.132857, "o", "> \r\n\u001b[?2004l\r"]
[430.132869, "o", "\u001b[?2004h> "]
[430.132993, "o", "with open(\"/root/detection_results.csv\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.133003, "o", "> "]
[430.133117, "o", "    f.write(\"approximant,snr,total_mass\\n\")\r\n\u001b[?2004l\r"]
[430.133127, "o", "\u001b[?2004h> "]
[430.133189, "o", "    for r in results:\r\n\u001b[?2004l\r"]
[430.133197, "o", "\u001b[?2004h"]
[430.133211, "o", "> "]
[430.133315, "o", "        f.write(f\"{r[0]},{r[1]},{r[2]}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[430.133329, "o", "> \r\n\u001b[?2004l\r"]
[430.133348, "o", "\u001b[?2004h"]
[430.133361, "o", "> "]
[430.133391, "o", "print(\"Done.\")\r\n\u001b[?2004l\r"]
[430.133415, "o", "\u001b[?2004h> "]
[430.133437, "o", "EOF\r\n\u001b[?2004l\r"]
