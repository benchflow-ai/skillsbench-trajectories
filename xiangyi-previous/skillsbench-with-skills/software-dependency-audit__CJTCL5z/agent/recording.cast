[112.156363, "i", "cat <<EOF > /root/parse_trivy.py\nimport json\nimport csv\n\ninput_file = '/root/trivy_output.json'\noutput_file = '/root/security_audit.csv'\n\ntry:\n    with open(input_file, 'r') as f:\n        data = json.load(f)\n\n    with open(output_file, 'w', newline='') as csvfile:\n        writer = csv.writer(csvfile)\n        writer.writerow(['Package', 'Version', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url'])\n\n        if 'Results' in data:\n            for result in data['Results']:\n                if 'Vulnerabilities' in result:\n                    for vuln in result['Vulnerabilities']:\n                        package = vuln.get('PkgName', 'N/A')\n                        version = vuln.get('InstalledVersion', 'N/A')\n                        cve_id = vuln.get('VulnerabilityID', 'N/A')\n                        severity = vuln.get('Severity', 'N/A')\n\n                        # CVSS Score extraction logic\n                        cvss_score = 'N/A'\n                        cvss = vuln.get('CVSS', {})\n                        if cvss:\n                            # Priority: nvd > ghsa > redhat\n                            sources = ['nvd', 'ghsa', 'redhat']\n                            for source in sources:\n                                if source in cvss:\n                                    if 'V3Score' in cvss[source]:\n                                        cvss_score = cvss[source]['V3Score']\n                                        break\n                                    elif 'V2Score' in cvss[source]:\n                                        cvss_score = cvss[source]['V2Score']\n                                        break\n                        \n                        fixed_version = vuln.get('FixedVersion', 'N/A')\n                        # Prefer Title, fallback to Description (truncated if too long to keep it readable, though CSV handles newlines)\n                        title = vuln.get('Title', '')\n                        if not title:\n                            title = vuln.get('Description', 'N/A')\n                        \n                        # Clean up title/description to remove newlines for cleaner CSV\n                        title = title.replace('\\n', ' ').strip()\n\n                        url = vuln.get('PrimaryURL', '')\n                        if not url and 'References' in vuln and vuln['References']:\n                             url = vuln['References'][0]\n                        if not url:\n                            url = 'N/A'\n\n                        writer.writerow([package, version, cve_id, severity, cvss_score, fixed_version, title, url])\n    print(\"CSV generation complete.\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
