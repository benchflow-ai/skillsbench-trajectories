[?2004l[?2004h> import json
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> input_file = '/root/trivy_output.json'
[?2004l[?2004h> output_file = '/root/security_audit.csv'
[?2004l[?2004h> 
[?2004l[?2004h> try:
