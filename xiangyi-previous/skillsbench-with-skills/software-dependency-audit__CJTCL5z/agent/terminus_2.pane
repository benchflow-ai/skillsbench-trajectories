[?2004l[?2004h>         data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h>     with open(output_file, 'w', newline='') as csvfile:
[?2004l[?2004h>         writer = csv.writer(csvfile)
[?2004l[?2004h>         writer.writerow(['Package', 'Version', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url'])
[?2004l[?2004h> 
[?2004l[?2004h>         if 'Results' in data:
[?2004l[?2004h>             for result in data['Results']:
[?2004l[?2004h>                 if 'Vulnerabilities' in result:
[?2004l[?2004h>                     for vuln in result['Vulnerabilities']:
[?2004l[?2004h>                         package = vuln.get('PkgName', 'N/A')
[?2004l[?2004h>                         version = vuln.get('InstalledVersion', 'N/A')
[?2004l[?2004h>                         cve_id = vuln.get('VulnerabilityID', 'N/A')
[?2004l[?2004h>                         severity = vuln.get('Severity', 'N/A')
[?2004l[?2004h> 
[?2004l[?2004h>                         # CVSS Score extraction logic
[?2004l[?2004h>                         cvss_score = 'N/A'
[?2004l[?2004h>                         cvss = vuln.get('CVSS', {})
[?2004l[?2004h>                         if cvss:
[?2004l[?2004h>                             # Priority: nvd > ghsa > redhat
[?2004l[?2004h>                             sources = ['nvd', 'ghsa', 'redhat']
[?2004l[?2004h>                             for source in sources:
[?2004l[?2004h>                                 if source in cvss:
[?2004l[?2004h>                                     if 'V3Score' in cvss[source]:
[?2004l[?2004h>                                         cvss_score = cvss[source]['V3Score']
[?2004l[?2004h>                                         break
[?2004l[?2004h>                                     elif 'V2Score' in cvss[source]:
[?2004l[?2004h>                                         cvss_score = cvss[source]['V2Score']
[?2004l[?2004h>                                         break
[?2004l[?2004h>                         
[?2004l[?2004h>                         fixed_version = vuln.get('FixedVersion', 'N/A')
[?2004l[?2004h>                         # Prefer Title, fallback to Description (truncated if too long to keep it readable, though CSV handles newlines)
[?2004l[?2004h>                         title = vuln.get('Title', '')
[?2004l[?2004h>                         if not title:
[?2004l[?2004h>                             title = vuln.get('Description', 'N/A')
[?2004l[?2004h>                         
[?2004l[?2004h>                         # Clean up title/description to remove newlines for cleaner CSV
[?2004l[?2004h>                         title = title.replace('\n', ' ').strip()
[?2004l[?2004h> 
[?2004l[?2004h>                         url = vuln.get('PrimaryURL', '')
[?2004l[?2004h>                         if not url and 'References' in vuln and vuln['References']:
[?2004l[?2004h>                              url = vuln['References'][0]
[?2004l[?2004h>                         if not url:
[?2004l[?2004h>                             url = 'N/A'
[?2004l[?2004h> 
[?2004l[?2004h>                         writer.writerow([package, version, cve_id, severity, cvss_score, fixed_version, title, url])
[?2004l[?2004h>     print("CSV generation complete.")
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f"Error: {e}")
