[326.909131, "i", "python3 << 'EOF'\n# Final verification of formulas\nimport fitz\n\ndoc = fitz.open(\"latex_paper.pdf\")\n\n# Get all pages and look for specific formula elements\nfor page_num in range(len(doc)):\n    page = doc[page_num]\n    text = page.get_text()\n    \n    # Check for specific elements\n    if \"sgn\" in text:\n        print(f\"Page {page_num+1}: Found 'sgn'\")\n    if \"ρc\" in text or \"ρ_c\" in text:\n        print(f\"Page {page_num+1}: Found rho_c\")\n    if \"Pe\" in text or \"P_e\" in text:\n        print(f\"Page {page_num+1}: Found P_e\")\n    if \"Hi,M\" in text or \"H_{i,M}\" in text:\n        print(f\"Page {page_num+1}: Found H_i,M\")\n\nprint(\"\\nFormula verification complete.\")\nEOF\n"]
[326.912323, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> # Final verification of formulas\r\n\u001b[?2004l\r\u001b[?2004h> import fitz\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> doc = fitz.open(\"latex_paper.pdf\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get all pages and look for specific formula elements\r\n\u001b[?2004l\r\u001b[?2004h> for page_num in range(len(doc)):\r\n\u001b[?2004l\r\u001b[?2004h>     page = doc[page_num]\r\n\u001b[?2004l\r\u001b[?2004h>     text = page.get_text()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check for specific elements\r\n\u001b[?2004l\r\u001b[?2004h>     if \"sgn\" in text:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Page {page_num+1}: Found 'sgn'\")\r\n\u001b[?2004l\r\u001b[?2004h>     if \"ρc\" in text or \"ρ_c\" in text:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Page {page_num+1}: Found rho_c\")\r\n\u001b[?2004l\r\u001b[?2004h>     if \"Pe\" in text or \"P_e\" in text:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Page {page_num+1}: Found P_e\")\r\n\u001b[?2004l\r\u001b[?2004h>     if \"Hi,M\" in text or \"H_{i,M}\" in text:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Page {page_num+1}: Found H_i,M\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nFormula verification complete.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
