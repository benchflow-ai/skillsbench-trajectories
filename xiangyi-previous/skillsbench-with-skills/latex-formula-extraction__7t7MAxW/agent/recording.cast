[311.564633, "i", "python3 << 'EOF'\n# Let's look at the PDF text for potential issues\nimport fitz\n\ndoc = fitz.open(\"latex_paper.pdf\")\n\n# Check page 2 for equation 1\npage = doc[1]\ntext = page.get_text()\n\n# Look for the equation context\nif \"kq\" in text:\n    idx = text.find(\"kq\")\n    print(\"Context around kq:\")\n    print(repr(text[max(0,idx-20):idx+50]))\n\n# Check for k_q vs kq\nprint(\"\\n---\")\nprint(\"Checking for subscript patterns...\")\nif \"k_q\" in text or \"k_{q}\" in text:\n    print(\"Found k_q or k_{q}\")\nelse:\n    print(\"No k_q found - it's likely kq (k times q)\")\nEOF\n"]
