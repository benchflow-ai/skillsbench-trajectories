[274.329308, "i", "python3 << 'EOF'\nimport fitz\n\ndoc = fitz.open(\"latex_paper.pdf\")\npage = doc[2]  # Page 3\n\n# Get the text blocks around equation 3\nblocks = page.get_text(\"blocks\")\nfor i, block in enumerate(blocks):\n    if block[6] == 0:  # text block\n        text = block[4]\n        if \"exp\" in text or \"H_{i,M}\" in text or \"Hi,M\" in text or \"σ\" in text:\n            print(f\"Block {i}:\")\n            print(repr(text))\n            print(\"---\")\nEOF\n"]
