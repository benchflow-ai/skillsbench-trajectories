[205.492734, "i", "python3 << 'EOF'\nimport fitz\n\ndoc = fitz.open(\"latex_paper.pdf\")\npage = doc[2]  # Page 3\n\n# Get detailed text with positions\nblocks = page.get_text(\"dict\")[\"blocks\"]\nfor block in blocks:\n    if \"lines\" in block:\n        for line in block[\"lines\"]:\n            text = \"\"\n            for span in line[\"spans\"]:\n                text += span[\"text\"]\n            if \"exp\" in text or \"η\" in text or \"Ω\" in text or \"prod\" in text or \"H_\" in text:\n                print(f\"Line: {text}\")\nEOF\n"]
