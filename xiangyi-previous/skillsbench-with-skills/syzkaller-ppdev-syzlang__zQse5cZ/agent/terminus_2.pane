include <linux/ppdev.h>
include <linux/parport.h>

resource fd_ppdev[fd]

syz_open_dev$ppdev(dev ptr[in, string["/dev/parport#"]], id intptr, flags flags[open_flags]) fd_ppdev

write$ppdev(fd fd_ppdev, buf ptr[in, array[int8]], count len[buf])
read$ppdev(fd fd_ppdev, buf ptr[out, array[int8]], count len[buf])

ioctl$PPSETMODE(fd fd_ppdev, cmd const[PPSETMODE], arg ptr[in, flags[ieee1284_mode, int32]])
ioctl$PPRSTATUS(fd fd_ppdev, cmd const[PPRSTATUS], arg ptr[out, int8])
[?2004hroot@4c4571cfef51:~# python3 << 'PYEOF'
[?2004l[?2004h> import struct
[?2004l[?2004h> 
[?2004l[?2004h> # PP_IOCTL = 'p' = 0x70
[?2004l[?2004h> PP_IOCTL = ord('p')
[?2004l[?2004h> 
[?2004l[?2004h> def _IO(type_val, nr):
[?2004l[?2004h>     return (type_val << 8) | nr
[?2004l[?2004h> 
[?2004l[?2004h> def _IOR(type_val, nr, size):
[?2004l[?2004h>     return (2 << 30) | (size << 16) | (type_val << 8) | nr
[?2004l[?2004h> 
[?2004l[?2004h> def _IOW(type_val, nr, size):
[?2004l[?2004h>     return (1 << 30) | (size << 16) | (type_val << 8) | nr
[?2004l[?2004h> 
[?2004l[?2004h> # Sizes for amd64
[?2004l[?2004h> SIZE_INT = 4
[?2004l[?2004h> SIZE_UCHAR = 1
[?2004l[?2004h> SIZE_UINT = 4
[?2004l[?2004h> SIZE_TIMEVAL_64 = 16  # amd64
[?2004l[?2004h> SIZE_TIMEVAL_32 = 8   # 386
[?2004l[?2004h> SIZE_FROB = 2  # struct ppdev_frob_struct { uchar, uchar }
[?2004l[?2004h> 
