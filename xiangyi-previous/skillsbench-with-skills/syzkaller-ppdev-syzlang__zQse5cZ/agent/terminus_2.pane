[?2004l[?2004h> print(f"PPRCONTROL = {hex(_IOR(PP_IOCTL, 0x83, SIZE_UCHAR))}")
[?2004l[?2004h> print(f"PPWCONTROL = {hex(_IOW(PP_IOCTL, 0x84, SIZE_UCHAR))}")
[?2004l[?2004h> print(f"PPRDATA = {hex(_IOR(PP_IOCTL, 0x85, SIZE_UCHAR))}")
[?2004l[?2004h> print(f"PPWDATA = {hex(_IOW(PP_IOCTL, 0x86, SIZE_UCHAR))}")
[?2004l[?2004h> print(f"PPCLAIM = {hex(_IO(PP_IOCTL, 0x8b))}")
[?2004l[?2004h> print(f"PPRELEASE = {hex(_IO(PP_IOCTL, 0x8c))}")
[?2004l[?2004h> print(f"PPYIELD = {hex(_IO(PP_IOCTL, 0x8d))}")
[?2004l[?2004h> print(f"PPFCONTROL = {hex(_IOW(PP_IOCTL, 0x8e, SIZE_FROB))}")
[?2004l[?2004h> print(f"PPEXCL = {hex(_IO(PP_IOCTL, 0x8f))}")
[?2004l[?2004h> print(f"PPDATADIR = {hex(_IOW(PP_IOCTL, 0x90, SIZE_INT))}")
[?2004l[?2004h> print(f"PPNEGOT = {hex(_IOW(PP_IOCTL, 0x91, SIZE_INT))}")
[?2004l[?2004h> print(f"PPWCTLONIRQ = {hex(_IOW(PP_IOCTL, 0x92, SIZE_UCHAR))}")
[?2004l[?2004h> print(f"PPCLRIRQ = {hex(_IOR(PP_IOCTL, 0x93, SIZE_INT))}")
[?2004l[?2004h> print(f"PPSETPHASE = {hex(_IOW(PP_IOCTL, 0x94, SIZE_INT))}")
[?2004l[?2004h> print(f"PPGETTIME_64 = {hex(_IOR(PP_IOCTL, 0x95, SIZE_TIMEVAL_64))}")
[?2004l[?2004h> print(f"PPSETTIME_64 = {hex(_IOW(PP_IOCTL, 0x96, SIZE_TIMEVAL_64))}")
[?2004l[?2004h> print(f"PPGETTIME_32 = {hex(_IOR(PP_IOCTL, 0x95, SIZE_TIMEVAL_32))}")
