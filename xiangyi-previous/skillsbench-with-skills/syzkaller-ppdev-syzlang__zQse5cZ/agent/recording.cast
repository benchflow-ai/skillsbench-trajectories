[172.859528, "o", "\u001b[?2004h> SIZE_UCHAR = 1\r\n\u001b[?2004l\r"]
[172.859622, "o", "\u001b[?2004h> SIZE_UINT = 4\r\n\u001b[?2004l\r\u001b[?2004h"]
[172.859803, "o", "> SIZE_TIMEVAL_64 = 16  # amd64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.860767, "o", "SIZE_TIMEVAL_32 = 8   # 386\r\n\u001b[?2004l\r\u001b[?2004h> SIZE_FROB = 2  # struct ppdev_frob_struct { uchar, uchar }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"# amd64 values\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"PPSETMODE = {hex(_IOW(PP_IOCTL, 0x80, SIZE_INT))}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"PPRSTATUS = {hex(_IOR(PP_IOCTL, 0x81, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"PPRCONTROL = {hex(_IOR(PP_IOCTL, 0x83, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.860935, "o", "print(f\"PPWCONTROL = {hex(_IOW(PP_IOCTL, 0x84, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.861034, "o", "print(f\"PPRDATA = {hex(_IOR(PP_IOCTL, 0x85, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r"]
[172.861107, "o", "\u001b[?2004h> "]
[172.861212, "o", "print(f\"PPWDATA = {hex(_IOW(PP_IOCTL, 0x86, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r"]
[172.861283, "o", "\u001b[?2004h> "]
[172.861362, "o", "print(f\"PPCLAIM = {hex(_IO(PP_IOCTL, 0x8b))}\")\r\n\u001b[?2004l\r"]
[172.861447, "o", "\u001b[?2004h> "]
[172.861533, "o", "print(f\"PPRELEASE = {hex(_IO(PP_IOCTL, 0x8c))}\")\r\n\u001b[?2004l\r"]
[172.861601, "o", "\u001b[?2004h> "]
[172.861685, "o", "print(f\"PPYIELD = {hex(_IO(PP_IOCTL, 0x8d))}\")\r\n\u001b[?2004l\r"]
[172.861724, "o", "\u001b[?2004h> "]
[172.861878, "o", "print(f\"PPFCONTROL = {hex(_IOW(PP_IOCTL, 0x8e, SIZE_FROB))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[172.861944, "o", "> "]
[172.862024, "o", "print(f\"PPEXCL = {hex(_IO(PP_IOCTL, 0x8f))}\")\r\n\u001b[?2004l\r"]
[172.862092, "o", "\u001b[?2004h> "]
[172.862211, "o", "print(f\"PPDATADIR = {hex(_IOW(PP_IOCTL, 0x90, SIZE_INT))}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[172.86228, "o", "> "]
[172.862385, "o", "print(f\"PPNEGOT = {hex(_IOW(PP_IOCTL, 0x91, SIZE_INT))}\")\r\n\u001b[?2004l\r"]
[172.862451, "o", "\u001b[?2004h> "]
[172.862575, "o", "print(f\"PPWCTLONIRQ = {hex(_IOW(PP_IOCTL, 0x92, SIZE_UCHAR))}\")\r\n\u001b[?2004l\r"]
[172.862641, "o", "\u001b[?2004h> "]
[172.862757, "o", "print(f\"PPCLRIRQ = {hex(_IOR(PP_IOCTL, 0x93, SIZE_INT))}\")\r\n\u001b[?2004l\r"]
[172.862822, "o", "\u001b[?2004h> "]
[172.862942, "o", "print(f\"PPSETPHASE = {hex(_IOW(PP_IOCTL, 0x94, SIZE_INT))}\")\r\n\u001b[?2004l\r"]
[172.863017, "o", "\u001b[?2004h> "]
[172.863153, "o", "print(f\"PPGETTIME_64 = {hex(_IOR(PP_IOCTL, 0x95, SIZE_TIMEVAL_64))}\")\r\n\u001b[?2004l\r"]
