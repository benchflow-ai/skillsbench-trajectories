[172.858932, "o", "    return (2 << 30) | (size << 16) | (type_val << 8) | nr\r\n\u001b[?2004l\r"]
[172.859049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.859084, "o", "def _IOW(type_val, nr, size):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.859222, "o", "    return (1 << 30) | (size << 16) | (type_val << 8) | nr\r\n\u001b[?2004l\r"]
[172.85925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[172.859279, "o", "\u001b[?2004h> "]
