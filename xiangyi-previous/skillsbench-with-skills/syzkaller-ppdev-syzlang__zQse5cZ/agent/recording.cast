[153.333639, "o", "\r\ninclude <linux/ppdev.h>\r\ninclude <linux/parport.h>\r\n\r\n"]
[153.333709, "o", "resource fd_ppdev[fd]\r\n\r\nsyz_open_dev$ppdev(dev ptr[in, string[\"/dev/parport#\"]], id intptr, flags flags[open_flags]) fd_ppdev\r\n\r\nwrite$ppdev(fd fd_ppdev, buf ptr[in, array[int8]], count len[buf])\r\nread$ppdev(fd fd_ppdev, buf ptr[out, array[int8]], count len[buf])\r\n\r\nioctl$PPSETMODE(fd fd_ppdev, cmd const[PPSETMODE], arg ptr[in, flags[ieee1284_mode, int32]])\r\nioctl$PPRSTATUS(fd fd_ppdev, cmd const[PPRSTATUS], arg ptr[out, int8])\r\n"]
[153.334309, "o", "\u001b[?2004h"]
[153.334415, "o", "root@4c4571cfef51:~# "]
[172.857741, "i", "python3 << 'PYEOF'\nimport struct\n\n# PP_IOCTL = 'p' = 0x70\nPP_IOCTL = ord('p')\n\ndef _IO(type_val, nr):\n    return (type_val << 8) | nr\n\ndef _IOR(type_val, nr, size):\n    return (2 << 30) | (size << 16) | (type_val << 8) | nr\n\ndef _IOW(type_val, nr, size):\n    return (1 << 30) | (size << 16) | (type_val << 8) | nr\n\n# Sizes for amd64\nSIZE_INT = 4\nSIZE_UCHAR = 1\nSIZE_UINT = 4\nSIZE_TIMEVAL_64 = 16  # amd64\nSIZE_TIMEVAL_32 = 8   # 386\nSIZE_FROB = 2  # struct ppdev_frob_struct { uchar, uchar }\n\nprint(\"# amd64 values\")\nprint(f\"PPSETMODE = {hex(_IOW(PP_IOCTL, 0x80, SIZE_INT))}\")\nprint(f\"PPRSTATUS = {hex(_IOR(PP_IOCTL, 0x81, SIZE_UCHAR))}\")\nprint(f\"PPRCONTROL = {hex(_IOR(PP_IOCTL, 0x83, SIZE_UCHAR))}\")\nprint(f\"PPWCONTROL = {hex(_IOW(PP_IOCTL, 0x84, SIZE_UCHAR))}\")\nprint(f\"PPRDATA = {hex(_IOR(PP_IOCTL, 0x85, SIZE_UCHAR))}\")\nprint(f\"PPWDATA = {hex(_IOW(PP_IOCTL, 0x86, SIZE_UCHAR))}\")\nprint(f\"PPCLAIM = {hex(_IO(PP_IOCTL, 0x8b))}\")\nprint(f\"PPRELEASE = {hex(_IO(PP_IOCTL, 0x8c))}\")\nprint(f\"PPYIELD = {hex(_IO(PP_IOCTL, 0x8d))}\")\nprint(f\"PPFCONTROL = {hex(_IOW(PP_IOCTL, 0x8e, SIZE_FROB))}\")\nprint(f\"PPEXCL = {hex(_IO(PP_IOCTL, 0x8f))}\")\nprint(f\"PPDATADIR = {hex(_IOW(PP_IOCTL, 0x90, SIZE_INT))}\")\nprint(f\"PPNEGOT = {hex(_IOW(PP_IOCTL, 0x91, SIZE_INT))}\")\nprint(f\"PPWCTLONIRQ = {hex(_IOW(PP_IOCTL, 0x92, SIZE_UCHAR))}\")\nprint(f\"PPCLRIRQ = {hex(_IOR(PP_IOCTL, 0x93, SIZE_INT))}\")\nprint(f\"PPSETPHASE = {hex(_IOW(PP_IOCTL, 0x94, SIZE_INT))}\")\nprint(f\"PPGETTIME_64 = {hex(_IOR(PP_IOCTL, 0x95, SIZE_TIMEVAL_64))}\")\nprint(f\"PPSETTIME_64 = {hex(_IOW(PP_IOCTL, 0x96, SIZE_TIMEVAL_64))}\")\nprint(f\"PPGETTIME_32 = {hex(_IOR(PP_IOCTL, 0x95, SIZE_TIMEVAL_32))}\")\nprint(f\"PPSETTIME_32 = {hex(_IOW(PP_IOCTL, 0x96, SIZE_TIMEVAL_32))}\")\nprint(f\"PPGETMODES = {hex(_IOR(PP_IOCTL, 0x97, SIZE_UINT))}\")\nprint(f\"PPGETMODE = {hex(_IOR(PP_IOCTL, 0x98, SIZE_INT))}\")\nprint(f\"PPGETPHASE = {hex(_IOR(PP_IOCTL, 0x99, SIZE_INT))}\")\nprint(f\"PPGETFLAGS = {hex(_IOR(PP_IOCTL, 0x9a, SIZE_INT))}\")\nprint(f\"PPSETFLAGS = {hex(_IOW(PP_IOCTL, 0x9b, SIZE_INT))}\")\nPYEOF\n"]
[172.858018, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[172.858114, "o", "\u001b[?2004h> import struct\r\n"]
