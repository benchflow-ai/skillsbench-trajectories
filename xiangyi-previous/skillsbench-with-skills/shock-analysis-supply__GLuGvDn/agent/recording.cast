[353.045816, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[367.817174, "i", "python3 << 'EOF'\nimport requests\nimport json\n\nprint('Fetching IMF WEO data with proper parsing...')\n\n# Try different approach - fetch the data and look for Georgia\nurl_growth = 'https://www.imf.org/external/datamapper/api/v1/NGDP_RPCH/915'\nheaders = {'User-Agent': 'Mozilla/5.0'}\n\ntry:\n    resp = requests.get(url_growth, headers=headers, timeout=15)\n    if resp.status_code == 200:\n        data = resp.json()\n        # Navigate the structure\n        if 'values' in data and 'NGDP_RPCH' in data['values']:\n            countries = data['values']['NGDP_RPCH']\n            print(f'Available country codes: {list(countries.keys())[:20]}')\n            \n            # Look for Georgia - try different codes\n            for code in ['GEO', '915', 'ge']:\n                if code in countries:\n                    print(f'\\nFound Georgia data with code {code}:')\n                    georgia_data = countries[code]\n                    years = sorted([int(k) for k in georgia_data.keys() if k.isdigit()])\n                    print(f'Years: {years}')\n                    for year in range(2000, 2028):\n                        if str(year) in georgia_data:\n                            print(f'{year}: {georgia_data[str(year)]}')\n                    break\nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()\n\nEOF\n"]
