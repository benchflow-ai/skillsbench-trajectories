[47.321816, "o", "        if 'values' in data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.321898, "o", "            print(f'Sample data: {list(data[\"values\"].items())[:5]}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.321993, "o", "> "]
