[738.294094, "o", "\u001b[?2004h> "]
[738.294169, "o", "ws_prod.cell(row=36, column=1).value = 'Year'\r\n\u001b[?2004l\r"]
[738.294227, "o", "\u001b[?2004h> "]
[738.294279, "o", "ws_prod.cell(row=36, column=4).value = 'LnZ'\r\n\u001b[?2004l\r"]
[738.29433, "o", "\u001b[?2004h> "]
[738.294385, "o", "ws_prod.cell(row=36, column=5).value = 'LnZ_HP'\r\n\u001b[?2004l\r"]
[738.294443, "o", "\u001b[?2004h> "]
[738.294519, "o", "ws_prod.cell(row=36, column=6).value = 'Diff'\r\n\u001b[?2004l\r"]
[738.294567, "o", "\u001b[?2004h> "]
[738.294645, "o", "ws_prod.cell(row=36, column=7).value = 'Diff2'\r\n\u001b[?2004l\r"]
[738.294701, "o", "\u001b[?2004h> "]
[738.294762, "o", "ws_prod.cell(row=36, column=8).value = 'Residual'\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.294814, "o", "> "]
