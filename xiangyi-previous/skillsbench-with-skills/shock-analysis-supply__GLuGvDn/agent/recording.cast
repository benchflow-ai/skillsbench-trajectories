[692.105963, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[701.920411, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\nws_cfc = wb['CFC data']\nws_pwt = wb['PWT']\n\nprint('Setting up CFC data sheet formulas...')\n\n# Column D: Capital Stock (link from PWT)\n# Column E: Depreciation rate = CFC / Capital Stock\n\nfor row_idx in range(2, ws_cfc.max_row + 1):\n    year = ws_cfc.cell(row=row_idx, column=2).value\n    \n    if year and isinstance(year, int):\n        # Find corresponding year in PWT sheet\n        for pwt_row in range(2, ws_pwt.max_row + 1):\n            pwt_year = ws_pwt.cell(row=pwt_row, column=1).value\n            if pwt_year == year:\n                # Link capital stock from PWT\n                ws_cfc.cell(row=row_idx, column=4).value = f'=PWT!B{pwt_row}'\n                # Calculate depreciation rate = CFC / Capital Stock\n                ws_cfc.cell(row=row_idx, column=5).value = f'=IF(D{row_idx}>0,C{row_idx}/D{row_idx},\"\")'\n                break\n\nwb.save('/root/test-supply.xlsx')\nprint('CFC data sheet formulas added!')\n\n# Now set up the Production sheet\nprint('\\nSetting up Production sheet...')\nws_prod = wb['Production']\n\n# B3: Calculate average depreciation rate from most recent 8 years (2016-2023)\n# Find rows for 2016-2023 in CFC data\ndep_rates = []\nfor row_idx in range(2, ws_cfc.max_row + 1):\n    year = ws_cfc.cell(row=row_idx, column=2).value\n    if year and 2016 <= year <= 2023:\n        dep_rates.append(f'E{row_idx}')\n\nif dep_rates:\n    # Create AVERAGE formula\n    formula = f'=AVERAGE(CFC!{dep_rates[0]}:CFC!{dep_rates[-1]})'\n    ws_prod.cell(row=3, column=2).value = formula\n    print(f'Added depreciation rate formula in B3')\n\nwb.save('/root/test-supply.xlsx')\nprint('Production sheet updated!')\n\nEOF\n"]
