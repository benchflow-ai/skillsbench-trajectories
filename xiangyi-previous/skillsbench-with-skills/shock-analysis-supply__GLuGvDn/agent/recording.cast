[349.640046, "i", "python3 << 'EOF'\nimport requests\nimport json\n\nprint('Fetching IMF WEO data for Georgia...')\n\n# Georgia country code is 915\n# NGDP_R = Real GDP in constant prices\n# NGDP_RPCH = Real GDP growth rate\n\nurl_gdp = 'https://www.imf.org/external/datamapper/api/v1/NGDP_R/915'\nurl_growth = 'https://www.imf.org/external/datamapper/api/v1/NGDP_RPCH/915'\n\nheaders = {'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'}\n\ntry:\n    # Fetch Real GDP\n    resp_gdp = requests.get(url_gdp, headers=headers, timeout=15)\n    if resp_gdp.status_code == 200:\n        data_gdp = resp_gdp.json()\n        print('Successfully fetched Real GDP data')\n        gdp_values = data_gdp.get('values', {})\n        print(f'Years available: {sorted([int(k) for k in gdp_values.keys() if k.isdigit()])[:10]}')\n        \n    # Fetch Growth Rate\n    resp_growth = requests.get(url_growth, headers=headers, timeout=15)\n    if resp_growth.status_code == 200:\n        data_growth = resp_growth.json()\n        print('Successfully fetched Growth Rate data')\n        growth_values = data_growth.get('values', {})\n        print(f'Sample growth data: {dict(list(growth_values.items())[:5])}')\n        \nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()\n\nEOF\n"]
