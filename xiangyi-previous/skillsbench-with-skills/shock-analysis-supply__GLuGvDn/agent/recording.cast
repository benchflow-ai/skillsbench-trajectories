[738.295091, "o", "\u001b[?2004h> "]
[738.295164, "o", "print('\\n4. Linking LnZ to HP Filter section...')\r\n\u001b[?2004l\r"]
[738.295219, "o", "\u001b[?2004h> "]
[738.295304, "o", "for row_offset, source_row in enumerate(range(6, 28), start=37):\r\n\u001b[?2004l\r"]
[738.295358, "o", "\u001b[?2004h> "]
[738.295463, "o", "    year = ws_prod.cell(row=source_row, column=3).value\r\n\u001b[?2004l\r"]
[738.295515, "o", "\u001b[?2004h> "]
[738.295614, "o", "    ws_prod.cell(row=row_offset, column=1).value = year\r\n\u001b[?2004l\r"]
[738.295672, "o", "\u001b[?2004h> "]
[738.295777, "o", "    ws_prod.cell(row=row_offset, column=4).value = f'=H{source_row}'\r\n\u001b[?2004l\r"]
[738.295824, "o", "\u001b[?2004h> "]
[738.295921, "o", "    # Column E will be LnZ_HP (placeholder for solver)\r\n\u001b[?2004l\r"]
[738.295969, "o", "\u001b[?2004h> "]
[738.296041, "o", "    ws_prod.cell(row=row_offset, column=5).value = f'=D{row_offset}'\r\n\u001b[?2004l\r"]
[738.296136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[738.296166, "o", "\u001b[?2004h> "]
[738.296251, "o", "print('LnZ linked to HP Filter section (D37:D58)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.29631, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.296372, "o", "# Step 4: Set up second difference and residual calculations\r\n\u001b[?2004l\r"]
[738.296431, "o", "\u001b[?2004h> "]
[738.296519, "o", "print('\\n5. Setting up difference calculations...')\r\n\u001b[?2004l\r"]
[738.296567, "o", "\u001b[?2004h> "]
[738.296679, "o", "for row_idx in range(39, 58):  # Starting from 39 (third data row)\r\n\u001b[?2004l\r"]
[738.296736, "o", "\u001b[?2004h> "]
[738.296776, "o", "    # First difference\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.296923, "o", "    ws_prod.cell(row=row_idx, column=6).value = f'=E{row_idx}-E{row_idx-1}'\r\n\u001b[?2004l\r"]
[738.296977, "o", "\u001b[?2004h> "]
[738.297029, "o", "    # Second difference\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.297155, "o", "    ws_prod.cell(row=row_idx, column=7).value = f'=F{row_idx}-F{row_idx-1}'\r\n\u001b[?2004l\r"]
[738.297214, "o", "\u001b[?2004h> "]
[738.297262, "o", "    # Residual = LnZ - LnZ_HP\r\n\u001b[?2004l\r"]
[738.297308, "o", "\u001b[?2004h> "]
[738.297463, "o", "    ws_prod.cell(row=row_idx, column=8).value = f'=D{row_idx}-E{row_idx}'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[738.297514, "o", "\u001b[?2004h> "]
[738.297577, "o", "print('Difference calculations added')\r\n\u001b[?2004l\r"]
[738.297623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.297692, "o", "# Step 5: Set up objective function\r\n\u001b[?2004l\r"]
[738.297762, "o", "\u001b[?2004h> "]
[738.297826, "o", "print('\\n6. Setting up objective function...')\r\n\u001b[?2004l\r"]
[738.297881, "o", "\u001b[?2004h> "]
[738.297973, "o", "ws_prod.cell(row=35, column=10).value = 'Sum of Squares'\r\n\u001b[?2004l\r"]
[738.298024, "o", "\u001b[?2004h> "]
[738.298199, "o", "ws_prod.cell(row=35, column=11).value = '=SUMPRODUCT(H37:H58,H37:H58)+100*SUMPRODUCT(G39:G58,G39:G58)'\r\n\u001b[?2004l\r"]
