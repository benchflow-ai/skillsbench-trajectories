[47.321194, "o", "headers = {'User-Agent': 'Mozilla/5.0'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
