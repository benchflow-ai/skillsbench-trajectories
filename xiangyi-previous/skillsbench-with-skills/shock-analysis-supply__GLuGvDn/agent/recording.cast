[840.188539, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[863.026347, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('/root/test-supply.xlsx', data_only=False)\n\nprint('=== COMPREHENSIVE FILE VERIFICATION ===' )\nprint('\\n1. WEO_Data Sheet Verification')\nws_weo = wb['WEO_Data']\nprint(f'   Real GDP data (2000, 2010, 2020, 2027):')\nfor row in [8, 18, 28, 35]:\n    year = ws_weo.cell(row=row, column=1).value\n    gdp = ws_weo.cell(row=row, column=3).value\n    growth = ws_weo.cell(row=row, column=4).value\n    print(f'   {year}: GDP={gdp}, Growth={growth}%')\n\nprint('\\n2. PWT Sheet Verification')\nws_pwt = wb['PWT']\nprint(f'   Capital Stock (rnna) data:')\nfor row in [2, 12, 22, 32]:\n    year = ws_pwt.cell(row=row, column=1).value\n    rnna = ws_pwt.cell(row=row, column=2).value\n    print(f'   {year}: {rnna}')\n\nprint('\\n3. CFC Data Sheet Verification')\nws_cfc = wb['CFC data']\nprint(f'   CFC and Depreciation Rate data:')\nfor row in [2, 7, 12, 22]:\n    year = ws_cfc.cell(row=row, column=2).value\n    cfc = ws_cfc.cell(row=row, column=3).value\n    k_stock = ws_cfc.cell(row=row, column=4).value\n    dep_rate = ws_cfc.cell(row=row, column=5).value\n    print(f'   {year}: CFC={cfc}, K_stock_formula={type(k_stock).__name__}, DepRate_formula={type(dep_rate).__name__}')\n\nprint('\\n4. Investment Sheet Verification')\nws_inv = wb['Investment']\nprint(f'   Investment data (2026-2029):')\nfor row in range(2, 6):\n    year = ws_inv.cell(row=row, column=2).value\n    inv = ws_inv.cell(row=row, column=3).value\n    print(f'   {year}: {inv}')\n\nprint('\\n5. Production Sheet Key Formulas')\nws_prod = wb['Production']\nprint(f'   B2 (Capital share): {ws_prod[\"B2\"].value}')\nprint(f'   B3 (Avg Depreciation): {ws_prod[\"B3\"].value}')\nprint(f'   F6 (LnK formula): {ws_prod[\"F6\"].value}')\nprint(f'   G6 (LnY formula): {ws_prod[\"G6\"].value}')\nprint(f'   H6 (LnZ formula): {ws_prod[\"H6\"].value}')\nprint(f'   E59 (K/Y Anchor): {ws_prod[\"E59\"].value}')\nprint(f'   G62 (Ystar_base): {ws_prod[\"G62\"].value}')\nprint(f'   I62 (K_with): {ws_prod[\"I62\"].value}')\nprint(f'   J62 (Ystar_with): {ws_prod[\"J62\"].value}')\n\nprint('\\n6. Summary Section')\nprint(f'   Total Investment formula: {ws_prod[\"B87\"].value}')\nprint(f'   Cumulative Impact formula: {ws_prod[\"B110\"].value}')\nprint(f'   Average Annual Impact formula: {ws_prod[\"B111\"].value}')\n\nprint('\\n=== VERIFICATION COMPLETE ===')\nprint('All sheets and formulas are in place!')\nprint('The Excel file is ready for analysis in LibreOffice Calc or Excel.')\n\nEOF\n"]
