[47.319383, "i", "python3 << 'EOF'\nimport requests\nimport json\nfrom datetime import datetime\n\n# First, let's try to get IMF WEO data for Georgia\n# The IMF WEO database has a JSON API\nprint('Attempting to fetch IMF WEO data for Georgia...')\n\n# IMF WEO API endpoint\nurl = 'https://www.imf.org/external/datamapper/api/v1/NGDP_R/915'\nheaders = {'User-Agent': 'Mozilla/5.0'}\n\ntry:\n    response = requests.get(url, headers=headers, timeout=10)\n    if response.status_code == 200:\n        data = response.json()\n        print('Successfully fetched NGDP_R (Real GDP) data')\n        print(f'Keys in response: {data.keys()}')\n        if 'values' in data:\n            print(f'Sample data: {list(data[\"values\"].items())[:5]}')\nexcept Exception as e:\n    print(f'Error fetching data: {e}')\n\nEOF\n"]
