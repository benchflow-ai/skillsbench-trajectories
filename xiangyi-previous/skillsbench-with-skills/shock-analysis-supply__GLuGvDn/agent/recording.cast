[738.293469, "o", "    ws_prod.cell(row=row_idx, column=8).value = f'=IF(AND(G{row_idx}<>\"\",F{row_idx}<>\"\"),G{row_idx}-$B$2*F{row_idx},\"\")'\r\n\u001b[?2004l\r"]
