[780.063763, "o", "Verifying Production sheet structure...\r\n"]
[780.063995, "o", "\r\nSheet dimensions: A1:P103\r\n\r\nKey assumptions:\r\n"]
[780.064152, "o", "B2 (Capital share): 0.35\r\nB3 (Depreciation rate formula): =AVERAGE(CFC!E22:CFC!E29)\r\n\r\nData section (rows 6-10):\r\nRow 6: Year=2002, K==PWT!B14, Y==WEO_Data!C10\r\nRow 7: Year=2003, K==PWT!B15, Y==WEO_Data!C11\r\nRow 8: Year=2004, K==PWT!B16, Y==WEO_Data!C12\r\nRow 9: Year=2005, K==PWT!B17, Y==WEO_Data!C13\r\nRow 10: Year=2006, K==PWT!B18, Y==WEO_Data!C14\r\n\r\nHP Filter section (rows 35-40):\r\nRow 35: HP Filter (lambda=100) | K/Y | K\r\nRow 36: Year | LnZ | LnZ_HP\r\nRow 37: 2002 | =H6 | =D37\r\nRow 38: 2003 | =H7 | =D38\r\nRow 39: 2004 | =H8 | =D39\r\nRow 40: 2005 | =H9 | =D40\r\n\r\nProduction Function section (rows 60-65):\r\nRow 60: Production Function Analysis | None | 2026\r\nRow 61: Year | K | Y\r\nRow 62: 2002 | =D6 | =E6\r\nRow 63: 2003 | =D7 | =E7\r\nRow 64: 2004 | =D8 | =E8\r\nRow 65: 2005 | =D9 | =E9\r\n\r\nFile saved successfully!\r\n"]
[780.064238, "o", "File size: 53983 bytes\r\n"]
[780.092743, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[832.855169, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\nws_prod = wb['Production']\n\nprint('Adding summary section...')\n\n# Add summary section at bottom (starting row 85)\nws_prod.cell(row=85, column=1).value = 'SUMMARY OF RESULTS'\nws_prod.cell(row=86, column=1).value = 'Investment Shock Period'\nws_prod.cell(row=86, column=2).value = '2026-2033'\nws_prod.cell(row=87, column=1).value = 'Total Investment'\nws_prod.cell(row=87, column=2).value = '=SUM(Investment!C2:C9)'\n\nws_prod.cell(row=89, column=1).value = 'GDP Impact Analysis'\nws_prod.cell(row=90, column=1).value = 'Year'\nws_prod.cell(row=90, column=2).value = 'Ystar_base'\nws_prod.cell(row=90, column=3).value = 'Ystar_with'\nws_prod.cell(row=90, column=4).value = 'Impact (Ystar_with - Ystar_base)'\nws_prod.cell(row=90, column=5).value = 'Impact %'\n\n# Add formulas for impact calculation (2026-2043, rows 91-108)\nfor row_offset, year in enumerate(range(2026, 2044), start=91):\n    prod_row = 62 + (year - 2002)  # Map to production function section\n    ws_prod.cell(row=row_offset, column=1).value = year\n    ws_prod.cell(row=row_offset, column=2).value = f'=G{prod_row}'\n    ws_prod.cell(row=row_offset, column=3).value = f'=J{prod_row}'\n    ws_prod.cell(row=row_offset, column=4).value = f'=C{row_offset}-B{row_offset}'\n    ws_prod.cell(row=row_offset, column=5).value = f'=IF(B{row_offset}<>0,D{row_offset}/B{row_offset},\"\")'\n\nprint('Summary section added')\n\n# Add final statistics\nws_prod.cell(row=110, column=1).value = 'Cumulative Impact 2026-2043'\nws_prod.cell(row=110, column=2).value = '=SUM(D91:D108)'\n\nws_prod.cell(row=111, column=1).value = 'Average Annual Impact'\nws_prod.cell(row=111, column=2).value = '=AVERAGE(D91:D108)'\n\nws_prod.cell(row=112, column=1).value = 'Peak Impact Year'\nws_prod.cell(row=112, column=2).value = '=MAX(D91:D108)'\n\nwb.save('/root/test-supply.xlsx')\nprint('Summary section saved!')\n\n# Final verification\nprint('\\nFinal file verification:')\nprint(f'Total rows in Production sheet: {ws_prod.max_row}')\nprint(f'Total columns in Production sheet: {ws_prod.max_column}')\nprint('\\nAll sheets in workbook:')\nfor sheet in wb.sheetnames:\n    print(f'  - {sheet}')\n\nprint('\\nFile ready for analysis!')\nprint('Location: /root/test-supply.xlsx')\n\nEOF\n"]
