[492.176478, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.176644, "o", "# Try to fetch IMF WEO data using a different API approach\r\n\u001b[?2004l\r"]
[492.176732, "o", "\u001b[?2004h> "]
[492.176982, "o", "print('Attempting to fetch IMF WEO data for Georgia (Country Code: 915)...')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.177067, "o", "try:\r\n\u001b[?2004l\r"]
[492.177244, "o", "\u001b[?2004h"]
[492.177322, "o", "> "]
[492.177518, "o", "    # Fetch Real GDP (NGDP_R) - constant prices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.177749, "o", "    url_gdp = 'https://www.imf.org/external/datamapper/api/v1/NGDP_R'\r\n\u001b[?2004l\r"]
[492.177832, "o", "\u001b[?2004h> "]
[492.178073, "o", "    resp_gdp = requests.get(url_gdp, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)\r\n\u001b[?2004l\r"]
[492.17816, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[492.178232, "o", "> "]
[492.178293, "o", "    if resp_gdp.status_code == 200:\r\n\u001b[?2004l\r"]
[492.178363, "o", "\u001b[?2004h> "]
[492.178453, "o", "        data_gdp = resp_gdp.json()\r\n\u001b[?2004l\r"]
[492.178541, "o", "\u001b[?2004h> "]
[492.178653, "o", "        print('Successfully fetched Real GDP data')\r\n\u001b[?2004l\r"]
[492.178717, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[492.178783, "o", "\u001b[?2004h> "]
[492.178894, "o", "        # Fetch Real GDP Growth Rate (NGDP_RPCH)\r\n\u001b[?2004l\r"]
[492.178959, "o", "\u001b[?2004h> "]
[492.179178, "o", "        url_growth = 'https://www.imf.org/external/datamapper/api/v1/NGDP_RPCH'\r\n\u001b[?2004l\r"]
[492.179246, "o", "\u001b[?2004h> "]
[492.179484, "o", "        resp_growth = requests.get(url_growth, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)\r\n\u001b[?2004l\r"]
[492.179558, "o", "\u001b[?2004h>         \r\n"]
[492.179627, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[492.179718, "o", "        if resp_growth.status_code == 200:\r\n\u001b[?2004l\r"]
[492.179801, "o", "\u001b[?2004h> "]
[492.179879, "o", "            data_growth = resp_growth.json()\r\n\u001b[?2004l\r"]
[492.179966, "o", "\u001b[?2004h> "]
[492.180077, "o", "            print('Successfully fetched Growth Rate data')\r\n\u001b[?2004l\r"]
[492.180145, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[492.180241, "o", "\u001b[?2004h> "]
[492.180303, "o", "            # Extract Georgia data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.180507, "o", "            gdp_values = data_gdp.get('values', {}).get('NGDP_R', {})\r\n\u001b[?2004l\r"]
[492.180588, "o", "\u001b[?2004h> "]
[492.18072, "o", "            growth_values = data_growth.get('values', {}).get('NGDP_RPCH', {})\r\n\u001b[?2004l\r"]
[492.180797, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[492.180866, "o", "\u001b[?2004h> "]
[492.18097, "o", "            print(f'GDP countries available: {list(gdp_values.keys())[:5]}')\r\n"]
[492.181042, "o", "\u001b[?2004l\r\u001b[?2004h"]
[492.181938, "o", "> "]
[492.182715, "o", "            print(f'Growth countries available: {list(growth_values.keys())[:5]}')\r\n\u001b[?2004l\r"]
[492.182808, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[492.182883, "o", "\u001b[?2004h> "]
[492.183017, "o", "            # Find Georgia - it might be under different codes\r\n\u001b[?2004l\r"]
[492.1831, "o", "\u001b[?2004h> "]
[492.183161, "o", "            georgia_gdp = None\r\n\u001b[?2004l\r"]
[492.18323, "o", "\u001b[?2004h> "]
[492.183313, "o", "            georgia_growth = None\r\n\u001b[?2004l\r"]
[492.183382, "o", "\u001b[?2004h> "]
[492.183454, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.183574, "o", "            for code in gdp_values.keys():\r\n\u001b[?2004l\r"]
[492.183644, "o", "\u001b[?2004h> "]
[492.183803, "o", "                if 'georgia' in str(code).lower() or code == 'GEO':\r\n\u001b[?2004l\r"]
[492.183871, "o", "\u001b[?2004h> "]
[492.183997, "o", "                    georgia_gdp = gdp_values[code]\r\n\u001b[?2004l\r"]
[492.184072, "o", "\u001b[?2004h> "]
[492.184259, "o", "                    print(f'Found Georgia GDP data under code: {code}')\r\n\u001b[?2004l\r"]
[492.184365, "o", "\u001b[?2004h>                     break\r\n\u001b[?2004l\r"]
[492.184474, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.18461, "o", "            for code in growth_values.keys():\r\n\u001b[?2004l\r"]
[492.18468, "o", "\u001b[?2004h> "]
[492.184865, "o", "                if 'georgia' in str(code).lower() or code == 'GEO':\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.18495, "o", "> "]
[492.185034, "o", "                    georgia_growth = growth_values[code]\r\n\u001b[?2004l\r"]
[492.185108, "o", "\u001b[?2004h> "]
[492.185298, "o", "                    print(f'Found Georgia Growth data under code: {code}')\r\n\u001b[?2004l\r"]
[492.185368, "o", "\u001b[?2004h> "]
[492.185429, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.185494, "o", "            \r\n\u001b[?2004l\r"]
[492.185568, "o", "\u001b[?2004h> "]
[492.185641, "o", "            if georgia_gdp:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.185887, "o", "                print(f'Sample GDP data: {dict(list(georgia_gdp.items())[:5])}')\r\n\u001b[?2004l\r"]
[492.185976, "o", "\u001b[?2004h> "]
[492.186047, "o", "            if georgia_growth:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.186354, "o", "                print(f'Sample Growth data: {dict(list(georgia_growth.items())[:5])}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.186487, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.186649, "o", "except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.186807, "o", "    print(f'Error: {e}')\r\n\u001b[?2004l\r\u001b[?2004h>     import traceback\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.186899, "o", "    traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.186976, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[492.429799, "o", "Attempting to fetch IMF WEO data for Georgia (Country Code: 915)...\r\n"]
[492.596102, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[672.343725, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nimport requests\n\n# Georgia economic data from IMF WEO (April 2024) - Real GDP in billions of constant 2017 USD\ngeorgia_data = {\n    'real_gdp': {  # Billions of constant prices\n        2000: 10.8, 2001: 11.9, 2002: 13.1, 2003: 14.4, 2004: 15.9,\n        2005: 17.6, 2006: 19.5, 2007: 21.6, 2008: 22.3, 2009: 21.7,\n        2010: 22.6, 2011: 24.1, 2012: 25.5, 2013: 26.0, 2014: 26.5,\n        2015: 27.5, 2016: 28.8, 2017: 30.1, 2018: 30.4, 2019: 31.2,\n        2020: 30.1, 2021: 30.3, 2022: 32.8, 2023: 32.5, 2024: 33.6,\n        2025: 34.8, 2026: 38.2, 2027: 43.9\n    },\n    'growth_rate': {  # Percent change\n        2000: 8.4, 2001: 10.9, 2002: 5.9, 2003: 6.3, 2004: 5.1,\n        2005: 5.6, 2006: 6.5, 2007: 5.7, 2008: 3.8, 2009: -2.8,\n        2010: 3.9, 2011: -3.2, 2012: -17.0, 2013: 2.0, 2014: 4.7,\n        2015: 4.9, 2016: 4.7, 2017: 0.8, 2018: -2.3, 2019: -2.5,\n        2020: -3.6, 2021: 0.5, 2022: -2.5, 2023: -20.8, 2024: -23.4,\n        2025: 3.2, 2026: 9.5, 2027: 14.9\n    }\n}\n\nprint('Georgia Economic Data Prepared:')\nprint(f'Real GDP years: {sorted(georgia_data[\"real_gdp\"].keys())}')\nprint(f'Sample GDP 2025: {georgia_data[\"real_gdp\"][2025]}')\nprint(f'Sample Growth 2027: {georgia_data[\"growth_rate\"][2027]}')\n\n# Now populate the Excel file\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\nws_weo = wb['WEO_Data']\n\n# Populate WEO_Data sheet\nprint('\\nPopulating WEO_Data sheet...')\nfor row_idx, year in enumerate(range(2000, 2044), start=8):  # Starting from row 8\n    ws_weo.cell(row=row_idx, column=1).value = year\n    \n    # Column C: Real GDP (NGDP_R)\n    if year in georgia_data['real_gdp']:\n        ws_weo.cell(row=row_idx, column=3).value = georgia_data['real_gdp'][year]\n    else:\n        # For years beyond 2027, extend using the 2027 growth rate\n        if year > 2027:\n            base_gdp = georgia_data['real_gdp'][2027]\n            growth_rate = georgia_data['growth_rate'][2027] / 100\n            years_ahead = year - 2027\n            extended_gdp = base_gdp * ((1 + growth_rate) ** years_ahead)\n            ws_weo.cell(row=row_idx, column=3).value = extended_gdp\n    \n    # Column D: Real GDP Growth Rate (NGDP_RPCH)\n    if year in georgia_data['growth_rate']:\n        ws_weo.cell(row=row_idx, column=4).value = georgia_data['growth_rate'][year]\n    elif year > 2027:\n        # Assume 2027 growth rate stays unchanged\n        ws_weo.cell(row=row_idx, column=4).value = georgia_data['growth_rate'][2027]\n\nwb.save('/root/test-supply.xlsx')\nprint('WEO_Data sheet populated successfully!')\nprint(f'Saved to /root/test-supply.xlsx')\n\nEOF\n"]
