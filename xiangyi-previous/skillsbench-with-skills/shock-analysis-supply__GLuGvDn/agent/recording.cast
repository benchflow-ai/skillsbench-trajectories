[758.830763, "o", ">     if year <= 2023:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.83081, "o", "        # Use actual K\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.830907, "o", "> "]
[758.830986, "o", "        ws_prod.cell(row=row_offset, column=5).value = f'=IF(B{row_offset}<>\"\",B{row_offset},\"\")'\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.831051, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.831116, "o", "        # K_extended = K/Y_anchor * Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.831286, "o", "        ws_prod.cell(row=row_offset, column=5).value = f'=IF(C{row_offset}<>\"\",E$59*C{row_offset},\"\")'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[758.83135, "o", "\u001b[?2004h> "]
[758.831413, "o", "print('Extended K formulas added')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.831493, "o", "# Step 4: Link LnZ_trend from HP Filter (column F)\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.831571, "o", "> print('\\n4. Linking LnZ_trend...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.831634, "o", "> "]
[758.831707, "o", "for row_offset, year in enumerate(range(2002, 2024), start=62):  # 2002-2023\r\n\u001b[?2004l\r"]
[758.831771, "o", "\u001b[?2004h>     hp_row = 37 + (year - 2002)\r\n\u001b[?2004l\r"]
[758.831848, "o", "\u001b[?2004h> "]
[758.831908, "o", "    ws_prod.cell(row=row_offset, column=6).value = f'=E{hp_row}'\r\n\u001b[?2004l\r"]
[758.831976, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.832043, "o", "print('LnZ_trend linked')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.832134, "o", "# Step 5: Calculate Ystar_base = exp(LnZ_trend + alpha*ln(K))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.83222, "o", "print('\\n5. Setting up Ystar_base calculation...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.832271, "o", "> "]
[758.832309, "o", "for row_offset in range(62, 84):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.832544, "o", "    ws_prod.cell(row=row_offset, column=7).value = f'=IF(AND(F{row_offset}<>\"\",E{row_offset}<>\"\"),EXP(F{row_offset}+$B$2*LN(E{row_offset})),\"\")'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[758.832586, "o", "\u001b[?2004h> "]
[758.83263, "o", "print('Ystar_base formulas added')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[758.832675, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[758.832821, "o", "# Step 6: Link Investment from Investment sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.832892, "o", "print('\\n6. Linking Investment data...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.832971, "o", "for row_offset, year in enumerate(range(2002, 2044), start=62):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833083, "o", "    # Investment is in Investment sheet, rows 2-9 for years 2026-2033\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.833162, "o", "> "]
[758.83321, "o", "    if 2026 <= year <= 2033:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833251, "o", "        inv_row = 2 + (year - 2026)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833432, "o", "        ws_prod.cell(row=row_offset, column=8).value = f'=IF(Investment!B{inv_row}={year},Investment!C{inv_row},0)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833514, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.8336, "o", "        ws_prod.cell(row=row_offset, column=8).value = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[758.833667, "o", "\u001b[?2004l\r\u001b[?2004h> print('Investment data linked')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.833736, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833811, "o", "# Step 7: Calculate K_with (K with investment shock)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.833876, "o", "print('\\n7. Setting up K_with calculation...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.833921, "o", "> "]
[758.833994, "o", "for row_offset, year in enumerate(range(2002, 2044), start=62):\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.834041, "o", ">     if year == 2002:\r\n\u001b[?2004l\r"]
[758.834085, "o", "\u001b[?2004h> "]
[758.834208, "o", "        # Starting K_with = K_extended\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.834329, "o", "        ws_prod.cell(row=row_offset, column=9).value = f'=E{row_offset}'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.8344, "o", "        prev_row = row_offset - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.83452, "o", "        # K_with(t) = K_with(t-1) * (1 - depreciation_rate) + Investment(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.834585, "o", "> "]
[758.83468, "o", "        ws_prod.cell(row=row_offset, column=9).value = f'=I{prev_row}*(1-$B$3)+H{row_offset}'\r\n\u001b[?2004l\r"]
[758.834745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.834808, "o", "print('K_with formulas added')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.834872, "o", "# Step 8: Calculate Ystar_with\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.834958, "o", "print('\\n8. Setting up Ystar_with calculation...')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.835024, "o", "> for row_offset in range(62, 84):\r\n\u001b[?2004l\r"]
[758.835085, "o", "\u001b[?2004h> "]
[758.83532, "o", "    ws_prod.cell(row=row_offset, column=10).value = f'=IF(AND(F{row_offset}<>\"\",I{row_offset}<>\"\"),EXP(F{row_offset}+$B$2*LN(I{row_offset})),\"\")'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.835446, "o", "print('Ystar_with formulas added')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.835525, "o", "wb.save('/root/test-supply.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.835593, "o", "print('\\nProduction Function section setup complete!')\r\n\u001b[?2004l\r\u001b[?2004h"]
[758.83566, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[759.022083, "o", "Setting up Production Function section...\r\n\r\n1. Setting up K/Y ratio and extended K...\r\n"]
[759.023754, "o", "Years and K/Y ratio formulas added\r\n\r\n2. Setting up K/Y anchor calculation...\r\n\r\n3. Setting up extended K calculation...\r\n"]
[759.02384, "o", "Extended K formulas added\r\n\r\n4. Linking LnZ_trend...\r\n"]
[759.023895, "o", "LnZ_trend linked\r\n\r\n5. Setting up Ystar_base calculation...\r\n"]
[759.023948, "o", "Ystar_base formulas added\r\n\r\n6. Linking Investment data...\r\n"]
[759.024052, "o", "Investment data linked\r\n\r\n7. Setting up K_with calculation...\r\n"]
[759.02416, "o", "K_with formulas added\r\n\r\n8. Setting up Ystar_with calculation...\r\n"]
[759.024233, "o", "Ystar_with formulas added\r\n"]
[759.124504, "o", "\r\nProduction Function section setup complete!\r\n"]
[759.148227, "o", "\u001b[?2004hroot@dc85ff4b9598:~# "]
[779.843138, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\nws_prod = wb['Production']\n\nprint('Verifying Production sheet structure...')\nprint(f'\\nSheet dimensions: {ws_prod.dimensions}')\n\n# Check key cells\nprint('\\nKey assumptions:')\nprint(f'B2 (Capital share): {ws_prod[\"B2\"].value}')\nprint(f'B3 (Depreciation rate formula): {ws_prod[\"B3\"].value}')\n\nprint('\\nData section (rows 6-10):')\nfor row in range(6, 11):\n    year = ws_prod.cell(row=row, column=3).value\n    k_formula = ws_prod.cell(row=row, column=4).value\n    y_formula = ws_prod.cell(row=row, column=5).value\n    print(f'Row {row}: Year={year}, K={k_formula}, Y={y_formula}')\n\nprint('\\nHP Filter section (rows 35-40):')\nfor row in range(35, 41):\n    col_a = ws_prod.cell(row=row, column=1).value\n    col_d = ws_prod.cell(row=row, column=4).value\n    col_e = ws_prod.cell(row=row, column=5).value\n    print(f'Row {row}: {col_a} | {col_d} | {col_e}')\n\nprint('\\nProduction Function section (rows 60-65):')\nfor row in range(60, 66):\n    col_a = ws_prod.cell(row=row, column=1).value\n    col_b = ws_prod.cell(row=row, column=2).value\n    col_c = ws_prod.cell(row=row, column=3).value\n    print(f'Row {row}: {col_a} | {col_b} | {col_c}')\n\nprint('\\nFile saved successfully!')\nprint(f'File size: {len(open(\"/root/test-supply.xlsx\", \"rb\").read())} bytes')\n\nEOF\n"]
