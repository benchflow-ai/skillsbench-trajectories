[738.290818, "i", "python3 << 'EOF'\nimport openpyxl\nimport math\n\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\nws_prod = wb['Production']\n\nprint('Setting up complete Production sheet formulas...')\n\n# Step 1: Add LnK and LnY formulas in columns F and G (rows 6-29)\nprint('\\n1. Adding LnK and LnY formulas...')\nfor row_idx in range(6, 30):\n    # LnK = LN(K) in column F\n    ws_prod.cell(row=row_idx, column=6).value = f'=IF(D{row_idx}>0,LN(D{row_idx}),\"\")'\n    # LnY = LN(Y) in column G\n    ws_prod.cell(row=row_idx, column=7).value = f'=IF(E{row_idx}>0,LN(E{row_idx}),\"\")'\n\nprint('LnK and LnY formulas added (columns F and G)')\n\n# Step 2: Calculate LnZ (TFP residual) = LnY - alpha*LnK\n# alpha (capital's share) is in B2\nprint('\\n2. Adding LnZ formulas...')\nfor row_idx in range(6, 30):\n    # LnZ = LnY - alpha*LnK\n    ws_prod.cell(row=row_idx, column=8).value = f'=IF(AND(G{row_idx}<>\"\",F{row_idx}<>\"\"),G{row_idx}-$B$2*F{row_idx},\"\")'\n\nprint('LnZ formulas added (column H)')\n\n# Step 3: Set up HP Filter section starting at row 35\nprint('\\n3. Setting up HP Filter section...')\nws_prod.cell(row=35, column=1).value = 'HP Filter (lambda=100)'\nws_prod.cell(row=36, column=1).value = 'Year'\nws_prod.cell(row=36, column=4).value = 'LnZ'\nws_prod.cell(row=36, column=5).value = 'LnZ_HP'\nws_prod.cell(row=36, column=6).value = 'Diff'\nws_prod.cell(row=36, column=7).value = 'Diff2'\nws_prod.cell(row=36, column=8).value = 'Residual'\nws_prod.cell(row=36, column=9).value = 'Objective'\n\n# Link LnZ to D37:D58 (for years 2002-2023, 22 years)\nprint('\\n4. Linking LnZ to HP Filter section...')\nfor row_offset, source_row in enumerate(range(6, 28), start=37):\n    year = ws_prod.cell(row=source_row, column=3).value\n    ws_prod.cell(row=row_offset, column=1).value = year\n    ws_prod.cell(row=row_offset, column=4).value = f'=H{source_row}'\n    # Column E will be LnZ_HP (placeholder for solver)\n    ws_prod.cell(row=row_offset, column=5).value = f'=D{row_offset}'\n\nprint('LnZ linked to HP Filter section (D37:D58)')\n\n# Step 4: Set up second difference and residual calculations\nprint('\\n5. Setting up difference calculations...')\nfor row_idx in range(39, 58):  # Starting from 39 (third data row)\n    # First difference\n    ws_prod.cell(row=row_idx, column=6).value = f'=E{row_idx}-E{row_idx-1}'\n    # Second difference\n    ws_prod.cell(row=row_idx, column=7).value = f'=F{row_idx}-F{row_idx-1}'\n    # Residual = LnZ - LnZ_HP\n    ws_prod.cell(row=row_idx, column=8).value = f'=D{row_idx}-E{row_idx}'\n\nprint('Difference calculations added')\n\n# Step 5: Set up objective function\nprint('\\n6. Setting up objective function...')\nws_prod.cell(row=35, column=10).value = 'Sum of Squares'\nws_prod.cell(row=35, column=11).value = '=SUMPRODUCT(H37:H58,H37:H58)+100*SUMPRODUCT(G39:G58,G39:G58)'\n\nprint('Objective function added (P5)')\n\nwb.save('/root/test-supply.xlsx')\nprint('\\nAll HP Filter formulas added successfully!')\n\nEOF\n"]
