[492.174877, "i", "python3 << 'EOF'\nimport requests\nimport json\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\n\n# Try to fetch IMF WEO data using a different API approach\nprint('Attempting to fetch IMF WEO data for Georgia (Country Code: 915)...')\n\ntry:\n    # Fetch Real GDP (NGDP_R) - constant prices\n    url_gdp = 'https://www.imf.org/external/datamapper/api/v1/NGDP_R'\n    resp_gdp = requests.get(url_gdp, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)\n    \n    if resp_gdp.status_code == 200:\n        data_gdp = resp_gdp.json()\n        print('Successfully fetched Real GDP data')\n        \n        # Fetch Real GDP Growth Rate (NGDP_RPCH)\n        url_growth = 'https://www.imf.org/external/datamapper/api/v1/NGDP_RPCH'\n        resp_growth = requests.get(url_growth, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)\n        \n        if resp_growth.status_code == 200:\n            data_growth = resp_growth.json()\n            print('Successfully fetched Growth Rate data')\n            \n            # Extract Georgia data\n            gdp_values = data_gdp.get('values', {}).get('NGDP_R', {})\n            growth_values = data_growth.get('values', {}).get('NGDP_RPCH', {})\n            \n            print(f'GDP countries available: {list(gdp_values.keys())[:5]}')\n            print(f'Growth countries available: {list(growth_values.keys())[:5]}')\n            \n            # Find Georgia - it might be under different codes\n            georgia_gdp = None\n            georgia_growth = None\n            \n            for code in gdp_values.keys():\n                if 'georgia' in str(code).lower() or code == 'GEO':\n                    georgia_gdp = gdp_values[code]\n                    print(f'Found Georgia GDP data under code: {code}')\n                    break\n            \n            for code in growth_values.keys():\n                if 'georgia' in str(code).lower() or code == 'GEO':\n                    georgia_growth = growth_values[code]\n                    print(f'Found Georgia Growth data under code: {code}')\n                    break\n            \n            if georgia_gdp:\n                print(f'Sample GDP data: {dict(list(georgia_gdp.items())[:5])}')\n            if georgia_growth:\n                print(f'Sample Growth data: {dict(list(georgia_growth.items())[:5])}')\n                \nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()\n\nEOF\n"]
[492.17557, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
