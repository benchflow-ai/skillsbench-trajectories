[37.514045, "i", "python3 << 'EOF'\nimport openpyxl\nwb = openpyxl.load_workbook('/root/test-supply.xlsx')\n\n# Check PWT sheet\nws_pwt = wb['PWT']\nprint('PWT sheet structure:')\nfor row in range(1, min(15, ws_pwt.max_row + 1)):\n    row_data = [ws_pwt.cell(row, col).value for col in range(1, 4)]\n    print(f'Row {row}: {row_data}')\n\nprint('\\n' + '='*50)\n\n# Check CFC data sheet\nws_cfc = wb['CFC data']\nprint('\\nCFC data sheet structure:')\nfor row in range(1, min(15, ws_cfc.max_row + 1)):\n    row_data = [ws_cfc.cell(row, col).value for col in range(1, 6)]\n    print(f'Row {row}: {row_data}')\n\nprint('\\n' + '='*50)\n\n# Check Production sheet\nws_prod = wb['Production']\nprint('\\nProduction sheet structure (first 20 rows):')\nfor row in range(1, 21):\n    row_data = [ws_prod.cell(row, col).value for col in range(1, 6)]\n    print(f'Row {row}: {row_data}')\nEOF\n"]
