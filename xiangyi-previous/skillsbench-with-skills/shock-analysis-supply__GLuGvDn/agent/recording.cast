[402.412956, "i", "python3 << 'EOF'\nfrom playwright.async_api import async_playwright\nimport asyncio\nimport json\n\nasync def fetch_imf_data():\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        \n        # Navigate to IMF WEO database\n        print('Navigating to IMF WEO database...')\n        await page.goto('https://www.imf.org/external/datamapper/api/v1/NGDP_R', timeout=30000)\n        \n        # Get page content\n        content = await page.content()\n        print(f'Page loaded, content length: {len(content)}')\n        \n        await browser.close()\n\n# Run the async function\ntry:\n    asyncio.run(fetch_imf_data())\nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()\n\nEOF\n"]
