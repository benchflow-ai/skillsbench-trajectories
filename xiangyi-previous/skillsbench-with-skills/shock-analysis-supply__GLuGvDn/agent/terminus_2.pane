[?2004l[?2004h> import requests
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> print('Fetching IMF WEO data with proper parsing...')
[?2004l[?2004h> 
[?2004l[?2004h> # Try different approach - fetch the data and look for Georgia
[?2004l[?2004h> url_growth = 'https://www.imf.org/external/datamapper/api/v1/NGDP_RPCH/915'
[?2004l[?2004h> headers = {'User-Agent': 'Mozilla/5.0'}
[?2004l[?2004h> 
[?2004l[?2004h> try:
[?2004l[?2004h>     resp = requests.get(url_growth, headers=headers, timeout=15)
[?2004l[?2004h>     if resp.status_code == 200:
[?2004l[?2004h>         data = resp.json()
[?2004l[?2004h>         # Navigate the structure
[?2004l[?2004h>         if 'values' in data and 'NGDP_RPCH' in data['values']:
[?2004l[?2004h>             countries = data['values']['NGDP_RPCH']
[?2004l[?2004h>             print(f'Available country codes: {list(countries.keys())[:20]}')
[?2004l[?2004h>             
[?2004l[?2004h>             # Look for Georgia - try different codes
[?2004l[?2004h>             for code in ['GEO', '915', 'ge']:
[?2004l[?2004h>                 if code in countries:
[?2004l[?2004h>                     print(f'\nFound Georgia data with code {code}:')
[?2004l[?2004h>                     georgia_data = countries[code]
[?2004l[?2004h>                     years = sorted([int(k) for k in georgia_data.keys() if k.isdigit()])
[?2004l[?2004h>                     print(f'Years: {years}')
[?2004l[?2004h>                     for year in range(2000, 2028):
[?2004l[?2004h>                         if str(year) in georgia_data:
[?2004l[?2004h>                             print(f'{year}: {georgia_data[str(year)]}')
[?2004l[?2004h>                     break
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f'Error: {e}')
[?2004l[?2004h>     import traceback
[?2004l[?2004h>     traceback.print_exc()
[?2004l[?2004h> 
