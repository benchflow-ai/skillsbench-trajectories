[?2004l[?2004h> import openpyxl
[?2004l   [?2004h> 
[?2004l [?2004h> wb = openpyxl.load_workbook('/root/test-supply.xlsx')
[?2004l[?2004h> ws_prod = wb['Production']
[?2004l[?2004h> ws_inv = wb['Investment']
[?2004l[?2004h> 
[?2004l[?2004h> print('Setting up Production Function section...')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: K/Y ratio and extended K calculations (rows 60-75)
[?2004l[?2004h> print('\n1. Setting up K/Y ratio and extended K...')
[?2004l[?2004h> ws_prod.cell(row=60, column=1).value = 'Production Function Analysis'
[?2004l[?2004h> ws_prod.cell(row=61, column=1).value = 'Year'
[?2004l[?2004h> ws_prod.cell(row=61, column=2).value = 'K'
[?2004l[?2004h> ws_prod.cell(row=61, column=3).value = 'Y'
[?2004l[?2004h> ws_prod.cell(row=61, column=4).value = 'K/Y'
[?2004l[?2004h> ws_prod.cell(row=61, column=5).value = 'K_extended'
[?2004l[?2004h> ws_prod.cell(row=61, column=6).value = 'LnZ_trend'
[?2004l[?2004h> ws_prod.cell(row=61, column=7).value = 'Ystar_base'
[?2004l[?2004h> ws_prod.cell(row=61, column=8).value = 'Investment'
[?2004l[?2004h> ws_prod.cell(row=61, column=9).value = 'K_with'
[?2004l[?2004h> ws_prod.cell(row=61, column=10).value = 'Ystar_with'
[?2004l[?2004h> 
[?2004l[?2004h> # Populate years 2002-2043 (rows 62-83)
[?2004l[?2004h> for row_offset, year in enumerate(range(2002, 2044), start=62):
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=1).value = year
[?2004l[?2004h>     
[?2004l[?2004h>     # K and Y for 2002-2025 (from earlier data)
[?2004l[?2004h>     if 2002 <= year <= 2025:
[?2004l[?2004h>         source_row = 6 + (year - 2002)
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=2).value = f'=D{source_row}'
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=3).value = f'=E{source_row}'
[?2004l[?2004h>     else:
[?2004l[?2004h>         # For 2026+, use WEO_Data for Y
[?2004l[?2004h>         for weo_row in range(8, 50):
[?2004l[?2004h>             weo_year = ws_prod.parent['WEO_Data'].cell(row=weo_row, column=1).value
[?2004l[?2004h>             if weo_year == year:
[?2004l[?2004h>                 ws_prod.cell(row=row_offset, column=3).value = f'=WEO_Data!C{weo_row}'
[?2004l[?2004h>                 break
[?2004l[?2004h>     
[?2004l[?2004h>     # K/Y ratio (only for 2002-2023 to calculate anchor)
[?2004l[?2004h>     if 2002 <= year <= 2023:
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=4).value = f'=IF(AND(B{row_offset}<>"",C{row_offset}<>""),B{row_offset}/C{row_offset},"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('Years and K/Y ratio formulas added')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Calculate average K/Y for last 9 years (2015-2023) as anchor
[?2004l[?2004h> print('\n2. Setting up K/Y anchor calculation...')
[?2004l[?2004h> ky_anchor_formula = '=AVERAGE(D71:D79)'  # Rows for 2015-2023
[?2004l[?2004h> ws_prod.cell(row=59, column=4).value = 'K/Y Anchor (2015-2023)'
[?2004l[?2004h> ws_prod.cell(row=59, column=5).value = ky_anchor_formula
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Extended K using anchor
[?2004l[?2004h> print('\n3. Setting up extended K calculation...')
[?2004l[?2004h> for row_offset, year in enumerate(range(2002, 2044), start=62):
[?2004l[?2004h>     if year <= 2023:
[?2004l[?2004h>         # Use actual K
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=5).value = f'=IF(B{row_offset}<>"",B{row_offset},"")'
[?2004l[?2004h>     else:
[?2004l[?2004h>         # K_extended = K/Y_anchor * Y
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=5).value = f'=IF(C{row_offset}<>"",E$59*C{row_offset},"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('Extended K formulas added')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Link LnZ_trend from HP Filter (column F)
[?2004l[?2004h> print('\n4. Linking LnZ_trend...')
[?2004l[?2004h> for row_offset, year in enumerate(range(2002, 2024), start=62):  # 2002-2023
[?2004l[?2004h>     hp_row = 37 + (year - 2002)
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=6).value = f'=E{hp_row}'
[?2004l[?2004h> 
[?2004l[?2004h> print('LnZ_trend linked')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Calculate Ystar_base = exp(LnZ_trend + alpha*ln(K))
[?2004l[?2004h> print('\n5. Setting up Ystar_base calculation...')
[?2004l[?2004h> for row_offset in range(62, 84):
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=7).value = f'=IF(AND(F{row_offset}<>"",E{row_offset}<>""),EXP(F{row_offset}+$B$2*LN(E{row_offset})),"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('Ystar_base formulas added')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Link Investment from Investment sheet
[?2004l[?2004h> print('\n6. Linking Investment data...')
[?2004l[?2004h> for row_offset, year in enumerate(range(2002, 2044), start=62):
[?2004l[?2004h>     # Investment is in Investment sheet, rows 2-9 for years 2026-2033
[?2004l[?2004h>     if 2026 <= year <= 2033:
[?2004l[?2004h>         inv_row = 2 + (year - 2026)
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=8).value = f'=IF(Investment!B{inv_row}={year},Investment!C{inv_row},0)'
[?2004l[?2004h>     else:
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=8).value = 0
[?2004l[?2004h> 
[?2004l[?2004h> print('Investment data linked')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 7: Calculate K_with (K with investment shock)
[?2004l[?2004h> print('\n7. Setting up K_with calculation...')
[?2004l[?2004h> for row_offset, year in enumerate(range(2002, 2044), start=62):
[?2004l[?2004h>     if year == 2002:
[?2004l[?2004h>         # Starting K_with = K_extended
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=9).value = f'=E{row_offset}'
[?2004l[?2004h>     else:
[?2004l[?2004h>         prev_row = row_offset - 1
[?2004l[?2004h>         # K_with(t) = K_with(t-1) * (1 - depreciation_rate) + Investment(t)
[?2004l[?2004h>         ws_prod.cell(row=row_offset, column=9).value = f'=I{prev_row}*(1-$B$3)+H{row_offset}'
[?2004l[?2004h> 
[?2004l[?2004h> print('K_with formulas added')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 8: Calculate Ystar_with
[?2004l[?2004h> print('\n8. Setting up Ystar_with calculation...')
[?2004l[?2004h> for row_offset in range(62, 84):
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=10).value = f'=IF(AND(F{row_offset}<>"",I{row_offset}<>""),EXP(F{row_offset}+$B$2*LN(I{row_offset})),"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('Ystar_with formulas added')
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test-supply.xlsx')
