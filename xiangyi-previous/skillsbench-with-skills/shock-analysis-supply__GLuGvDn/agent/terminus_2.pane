[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/test-supply.xlsx')
[?2004l[?2004h> ws_prod = wb['Production']
[?2004l[?2004h> 
[?2004l[?2004h> print('Setting up complete Production sheet formulas...')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Add LnK and LnY formulas in columns F and G (rows 6-29)
[?2004l[?2004h> print('\n1. Adding LnK and LnY formulas...')
[?2004l[?2004h> for row_idx in range(6, 30):
[?2004l[?2004h>     # LnK = LN(K) in column F
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=6).value = f'=IF(D{row_idx}>0,LN(D{row_idx}),"")'
[?2004l[?2004h>     # LnY = LN(Y) in column G
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=7).value = f'=IF(E{row_idx}>0,LN(E{row_idx}),"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('LnK and LnY formulas added (columns F and G)')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Calculate LnZ (TFP residual) = LnY - alpha*LnK
[?2004l[?2004h> # alpha (capital's share) is in B2
[?2004l[?2004h> print('\n2. Adding LnZ formulas...')
[?2004l[?2004h> for row_idx in range(6, 30):
[?2004l[?2004h>     # LnZ = LnY - alpha*LnK
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=8).value = f'=IF(AND(G{row_idx}<>"",F{row_idx}<>""),G{row_idx}-$B$2*F{row_idx},"")'
[?2004l[?2004h> 
[?2004l[?2004h> print('LnZ formulas added (column H)')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Set up HP Filter section starting at row 35
[?2004l[?2004h> print('\n3. Setting up HP Filter section...')
[?2004l[?2004h> ws_prod.cell(row=35, column=1).value = 'HP Filter (lambda=100)'
[?2004l[?2004h> ws_prod.cell(row=36, column=1).value = 'Year'
[?2004l[?2004h> ws_prod.cell(row=36, column=4).value = 'LnZ'
[?2004l[?2004h> ws_prod.cell(row=36, column=5).value = 'LnZ_HP'
[?2004l[?2004h> ws_prod.cell(row=36, column=6).value = 'Diff'
[?2004l[?2004h> ws_prod.cell(row=36, column=7).value = 'Diff2'
[?2004l[?2004h> ws_prod.cell(row=36, column=8).value = 'Residual'
[?2004l[?2004h> ws_prod.cell(row=36, column=9).value = 'Objective'
[?2004l[?2004h> 
[?2004l[?2004h> # Link LnZ to D37:D58 (for years 2002-2023, 22 years)
[?2004l[?2004h> print('\n4. Linking LnZ to HP Filter section...')
[?2004l[?2004h> for row_offset, source_row in enumerate(range(6, 28), start=37):
[?2004l[?2004h>     year = ws_prod.cell(row=source_row, column=3).value
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=1).value = year
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=4).value = f'=H{source_row}'
[?2004l[?2004h>     # Column E will be LnZ_HP (placeholder for solver)
[?2004l[?2004h>     ws_prod.cell(row=row_offset, column=5).value = f'=D{row_offset}'
[?2004l[?2004h> 
[?2004l[?2004h> print('LnZ linked to HP Filter section (D37:D58)')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Set up second difference and residual calculations
[?2004l[?2004h> print('\n5. Setting up difference calculations...')
[?2004l[?2004h> for row_idx in range(39, 58):  # Starting from 39 (third data row)
[?2004l[?2004h>     # First difference
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=6).value = f'=E{row_idx}-E{row_idx-1}'
[?2004l[?2004h>     # Second difference
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=7).value = f'=F{row_idx}-F{row_idx-1}'
[?2004l[?2004h>     # Residual = LnZ - LnZ_HP
[?2004l[?2004h>     ws_prod.cell(row=row_idx, column=8).value = f'=D{row_idx}-E{row_idx}'
[?2004l[?2004h> 
[?2004l[?2004h> print('Difference calculations added')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Set up objective function
[?2004l[?2004h> print('\n6. Setting up objective function...')
[?2004l[?2004h> ws_prod.cell(row=35, column=10).value = 'Sum of Squares'
[?2004l[?2004h> ws_prod.cell(row=35, column=11).value = '=SUMPRODUCT(H37:H58,H37:H58)+100*SUMPRODUCT(G39:G58,G39:G58)'
[?2004l[?2004h> 
[?2004l[?2004h> print('Objective function added (P5)')
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('/root/test-supply.xlsx')
[?2004l[?2004h> print('\nAll HP Filter formulas added successfully!')
