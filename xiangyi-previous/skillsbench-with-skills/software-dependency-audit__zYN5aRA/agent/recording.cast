[61.003871, "i", "python3 << 'EOFPYTHON'\nimport json\nimport subprocess\nimport csv\nimport sys\nfrom collections import defaultdict\n\n# Parse package-lock.json to get packages\nwith open('/root/package-lock.json', 'r') as f:\n    data = json.load(f)\n\npackages_list = []\n\nif 'packages' in data:\n    for pkg_path, pkg_info in data['packages'].items():\n        if pkg_path and pkg_path != '' and 'version' in pkg_info:\n            parts = pkg_path.split('node_modules/')[-1].split('/')\n            if len(parts) >= 1:\n                pkg_name = '/'.join(parts)\n                version = pkg_info['version']\n                packages_list.append((pkg_name, version))\n\n# Remove duplicates and keep unique package-version pairs\npackages_set = set(packages_list)\npackages_list = sorted(list(packages_set))\n\nprint(f\"Total package-version pairs: {len(packages_list)}\")\nprint(\"\\nFirst 20 packages:\")\nfor pkg_name, version in packages_list[:20]:\n    print(f\"{pkg_name}@{version}\")\n\nEOFPYTHON\n"]
