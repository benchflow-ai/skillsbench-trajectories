[24.848963, "i", "python3 << 'EOF'\nimport json\n\nwith open('/root/package-lock.json', 'r') as f:\n    data = json.load(f)\n\npackages = {}\nif 'packages' in data:\n    for pkg_path, pkg_info in data['packages'].items():\n        if pkg_path and pkg_path != '':\n            # Extract package name and version\n            if 'version' in pkg_info:\n                packages[pkg_path] = pkg_info['version']\n\n# Print first 20 packages\nfor i, (path, version) in enumerate(list(packages.items())[:20]):\n    print(f\"{path}: {version}\")\n\nprint(f\"\\nTotal packages: {len(packages)}\")\nEOF\n"]
