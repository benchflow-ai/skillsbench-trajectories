[69.699118, "i", "python3 << 'EOFPYTHON'\nimport json\nimport subprocess\nimport csv\nimport time\n\n# Parse package-lock.json\nwith open('/root/package-lock.json', 'r') as f:\n    data = json.load(f)\n\npackages_list = []\n\nif 'packages' in data:\n    for pkg_path, pkg_info in data['packages'].items():\n        if pkg_path and pkg_path != '' and 'version' in pkg_info:\n            parts = pkg_path.split('node_modules/')[-1].split('/')\n            if len(parts) >= 1:\n                pkg_name = '/'.join(parts)\n                version = pkg_info['version']\n                packages_list.append((pkg_name, version))\n\npackages_set = set(packages_list)\npackages_list = sorted(list(packages_set))\n\n# Query OSV database for vulnerabilities\nvulnerabilities = []\n\nprint(f\"Checking {len(packages_list)} packages for vulnerabilities...\")\nprint(\"This may take a while...\\n\")\n\nfor i, (pkg_name, version) in enumerate(packages_list):\n    if i % 100 == 0:\n        print(f\"Progress: {i}/{len(packages_list)}\")\n    \n    # Query OSV API\n    try:\n        curl_cmd = f'curl -s -X POST https://api.osv.dev/v1/query -H \"Content-Type: application/json\" -d \\'{{\"package\": {{\"ecosystem\": \"npm\", \"name\": \"{pkg_name}\"}}, \"version\": \"{version}\"}}\\' 2>/dev/null'\n        result = subprocess.run(curl_cmd, shell=True, capture_output=True, text=True, timeout=5)\n        \n        if result.stdout:\n            try:\n                response = json.loads(result.stdout)\n                if 'vulns' in response:\n                    for vuln in response['vulns']:\n                        vulnerabilities.append({\n                            'package': pkg_name,\n                            'version': version,\n                            'vuln': vuln\n                        })\n            except json.JSONDecodeError:\n                pass\n    except Exception as e:\n        pass\n    \n    time.sleep(0.1)  # Rate limiting\n\nprint(f\"\\nFound {len(vulnerabilities)} vulnerabilities\")\nif vulnerabilities:\n    print(\"Sample vulnerabilities:\")\n    for v in vulnerabilities[:3]:\n        print(json.dumps(v, indent=2))\n\nEOFPYTHON\n"]
