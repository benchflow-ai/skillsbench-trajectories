[198.82707, "i", "python3 << 'EOFPYTHON'\nimport json\n\nwith open('/tmp/trivy_results.json', 'r') as f:\n    data = json.load(f)\n\nif 'Results' in data:\n    for result in data['Results']:\n        if 'Misconfigurations' in result:\n            print(f\"Found {len(result['Misconfigurations'])} misconfigurations\")\n        if 'Vulnerabilities' in result:\n            vulns = result['Vulnerabilities']\n            print(f\"Found {len(vulns)} vulnerabilities\")\n            print(\"\\nVulnerabilities:\")\n            for vuln in vulns[:5]:  # Show first 5\n                print(json.dumps(vuln, indent=2))\n\nEOFPYTHON\n"]
