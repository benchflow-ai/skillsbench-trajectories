[54.11541, "i", "python3 << 'EOFPYTHON'\nimport json\nimport subprocess\nimport csv\nfrom collections import defaultdict\n\n# Parse package-lock.json\nwith open('/root/package-lock.json', 'r') as f:\n    data = json.load(f)\n\n# Extract unique packages with their versions\npackages_dict = defaultdict(set)\n\nif 'packages' in data:\n    for pkg_path, pkg_info in data['packages'].items():\n        if pkg_path and pkg_path != '' and 'version' in pkg_info:\n            # Extract package name from path\n            # Format: node_modules/package-name or node_modules/@scope/package-name\n            parts = pkg_path.split('node_modules/')[-1].split('/')\n            if len(parts) >= 1:\n                pkg_name = '/'.join(parts)\n                version = pkg_info['version']\n                packages_dict[pkg_name].add(version)\n\n# Print some packages to verify extraction\nprint(\"Sample packages extracted:\")\nfor i, (pkg_name, versions) in enumerate(list(packages_dict.items())[:10]):\n    print(f\"{pkg_name}: {versions}\")\n\nprint(f\"\\nTotal unique packages: {len(packages_dict)}\")\n\nEOFPYTHON\n"]
