[594.893613, "o", "\u001b[?2004h> "]
[594.893875, "o", "  const pos = (sorted.length - 1) * q;\r\n\u001b[?2004l\r"]
[594.893914, "o", "\u001b[?2004h> "]
[594.894086, "o", "  const base = Math.floor(pos);\r\n\u001b[?2004l\r"]
[594.894118, "o", "\u001b[?2004h> "]
[594.89426, "o", "  const rest = pos - base;\r\n\u001b[?2004l\r"]
[594.894296, "o", "\u001b[?2004h> "]
