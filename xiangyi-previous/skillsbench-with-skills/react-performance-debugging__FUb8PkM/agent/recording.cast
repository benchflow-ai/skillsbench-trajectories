[666.589171, "o", "// src/lib/api-client.ts\r\n// HTTP client for external API services\r\n// The actual API runs in a separate service - optimize how you use these calls!\r\n\r\nconst API_BASE = process.env.EXTERNAL_API_URL || 'http://localhost:3001';\r\nconst DEFAULT_REVALIDATE = 60;\r\n\r\ntype FetchOptions = RequestInit & { next?: { revalidate?: number } };\r\n\r\n"]
[666.589213, "o", "async function fetchJson<T>(path: string, init?: FetchOptions): Promise<T> {\r\n  const res = await fetch(`${API_BASE}${path}`, {\r\n    next: { revalidate: DEFAULT_REVALIDATE },\r\n    ...init,\r\n  });\r\n\r\n  if (!res.ok) {\r\n"]
[666.589253, "o", "    throw new Error(`Failed to fetch ${path}`);\r\n  }\r\n\r\n  return res.json();\r\n}\r\n\r\n"]
[666.589294, "o", "export function fetchUserFromService() {\r\n  return fetchJson('/api/user', { next: { revalidate: 30 } });\r\n}\r\n\r\nexport function fetchProductsFromService() {\r\n  return fetchJson('/api/products', { next: { revalidate: 60 } });\r\n}\r\n\r\nexport function fetchReviewsFromService() {\r\n"]
[666.589326, "o", "  return fetchJson('/api/reviews', { next: { revalidate: 60 } });\r\n}\r\n\r\nexport function fetchConfigFromService() {\r\n  return fetchJson('/api/config', { next: { revalidate: 300 } });\r\n}"]
[666.589363, "o", "\r\n\r\nexport function fetchProfileFromService(userId: string) {\r\n  return fetchJson(`/api/profile/${userId}`, { next: { revalidate: 30 } });\r\n}\r\n\r\nexport async function logAnalyticsToService(data: unknown) {"]
[666.589395, "o", "\r\n  const res = await fetch(`${API_BASE}/api/analytics`, {\r\n    method: 'POST',\r\n    headers: { 'Content-Type': 'application/json' },\r\n    body: JSON.stringify(data),\r\n    keepalive: true,\r\n"]
[666.589426, "o", "  });\r\n  if (!res.ok) throw new Error('Failed to log analytics');\r\n  return res.json();\r\n}\r\n"]
