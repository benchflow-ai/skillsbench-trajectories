} as { mean: number; median: number; std: number; variance: number; q1?: number; q3?: number };\r\n\r\n  if (withQuantiles) {\r\n    stats.q1 = quantileValue(values, 0.25);\r\n    stats.q3 = quantileValue(values, 0.75);\r\n  }\r\n\r\n  return stats;\r\n};\r\n\r\nfunction ComparisonTable({ products }: { products: Product[] }) {\r\n  const { sorted, avgPrice, totalReviews, bestRated, cheapest } = useMemo(() => {\r\n    if (!products.length) {\r\n      return { sorted: [], avgPrice: 0, totalReviews: 0, bestRated: undefined, cheapest: undefined };\r\n    }\r\n\r\n    const sorted = [...products].sort((a, b) => a.price - b.price);\r\n    const avgPrice = products.reduce((sum, product) => sum + product.price, 0) / products.length;\r\n    const totalReviews = products.reduce((sum, product) => sum + product.reviews, 0);\r\n"]
