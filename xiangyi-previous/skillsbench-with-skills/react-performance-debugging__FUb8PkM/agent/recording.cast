[594.890237, "o", "const average = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;\r\n\u001b[?2004l\r"]
[594.890285, "o", "\u001b[?2004h> "]
[594.89071, "o", "const sortedValues = (values: number[]) => [...values].sort((a, b) => a - b);\r\n\u001b[?2004l\r"]
[594.890753, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
