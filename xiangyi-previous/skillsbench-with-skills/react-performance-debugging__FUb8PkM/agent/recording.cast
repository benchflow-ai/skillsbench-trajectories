[643.778823, "o", "// src/app/compare/page.tsx\r\n'use client';\r\n\r\nimport { useMemo, useState } from 'react';\r\n\r\ninterface Product {\r\n  id: string;\r\n  name: string;\r\n  price: number;\r\n  category: string;\r\n  rating: number;\r\n  reviews: number;\r\n  inStock: boolean;\r\n}\r\n\r\n// Sample products to compare\r\nconst PRODUCTS: Product[] = [\r\n  { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },\r\n  { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },\r\n  { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },\r\n  { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },\r\n  { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },\r\n];\r\n\r\nconst average = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;\r\nconst sortedValues = (values: number[]) => [...values].sort((a, b) => a - b);\r\n\r\nconst medianValue = (values: number[]) => {\r\n  const sorted = sortedValues(values);\r\n  const mid = Math.floor(sorted.length / 2);\r\n  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];\r\n};\r\n\r\nconst varianceValue = (values: number[], mean: number) =>\r\n"]
[643.779962, "o", "  values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / values.length;\r\n\r\nconst quantileValue = (values: number[], q: number) => {\r\n  const sorted = sortedValues(values);\r\n  const pos = (sorted.length - 1) * q;\r\n  const base = Math.floor(pos);\r\n  const rest = pos - base;\r\n  const next = sorted[base + 1];\r\n  return next !== undefined ? sorted[base] + rest * (next - sorted[base]) : sorted[base];\r\n};\r\n\r\nconst getStats = (values: number[], withQuantiles = false) => {\r\n  const mean = average(values);\r\n  const median = medianValue(values);\r\n  const variance = varianceValue(values, mean);\r\n  const stats = {\r\n    mean,\r\n    median,\r\n    std: Math.sqrt(variance),\r\n    variance,\r\n  } as { mean: number; median: number; std: number; variance: number; q1?: number; q3?: number };\r\n\r\n  if (withQuantiles) {\r\n    stats.q1 = quantileValue(values, 0.25);\r\n    stats.q3 = quantileValue(values, 0.75);\r\n  }\r\n\r\n  return stats;\r\n};\r\n\r\nfunction ComparisonTable({ products }: { products: Product[] }) {\r\n  const { sorted, avgPrice, totalReviews, bestRated, cheapest } = useMemo(() => {\r\n    if (!products.length) {\r\n      return { sorted: [], avgPrice: 0, totalReviews: 0, bestRated: undefined, cheapest: undefined };\r\n    }\r\n\r\n    const sorted = [...products].sort((a, b) => a.price - b.price);\r\n    const avgPrice = products.reduce((sum, product) => sum + product.price, 0) / products.length;\r\n    const totalReviews = products.reduce((sum, product) => sum + product.reviews, 0);\r\n    const bestRated = products.reduce((best, product) => (best.rating > product.rating ? best : product), products[0]);\r\n    const cheapest = products.reduce((best, product) => (best.price < product.price ? best : product), products[0]);\r\n\r\n    return { sorted, avgPrice, totalReviews, bestRated, cheapest };\r\n  }, [products]);\r\n\r\n  return (\r\n    <div className=\"bg-white rounded-xl shadow-md p-6\">\r\n      <h2 className=\"text-xl font-bold mb-4\">Comparison Overview</h2>\r\n\r\n      <div className=\"grid grid-cols-4 gap-4 mb-6 text-center\">\r\n        <div className=\"bg-blue-50 p-4 rounded-lg\">\r\n          <div className=\"text-2xl font-bold text-blue-600\">${avgPrice.toFixed(2)}</div>\r\n          <div className=\"text-sm text-gray-600\">Avg Price</div>\r\n        </div>\r\n        <div className=\"bg-green-50 p-4 rounded-lg\">\r\n          <div className=\"text-2xl font-bold text-green-600\">{totalReviews.toLocaleString()}</div>\r\n          <div className=\"text-sm text-gray-600\">Total Reviews</div>\r\n        </div>\r\n        <div className=\"bg-yellow-50 p-4 rounded-lg\">\r\n          <div className=\"text-2xl font-bold text-yellow-600\">{bestRated?.name}</div>\r\n          <div className=\"text-sm text-gray-600\">Best Rated</div>\r\n        </div>\r\n        <div className=\"bg-purple-50 p-4 rounded-lg\">\r\n          <div className=\"text-2xl font-bold text-purple-600\">{cheapest?.name}</div>\r\n          <div className=\"text-sm text-gray-600\">Best Value</div>\r\n        </div>\r\n      </div>\r\n\r\n      <table className=\"w-full\">\r\n        <thead className=\"bg-gray-50\">\r\n          <tr>\r\n            <th className=\"px-4 py-3 text-left\">Product</th>\r\n            <th className=\"px-4 py-3 text-right\">Price</th>\r\n            <th className=\"px-4 py-3 text-right\">Rating</th>\r\n            <th className=\"px-4 py-3 text-right\">Reviews</th>\r\n            <th className=\"px-4 py-3 text-center\">Stock</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {sorted.map((product) => (\r\n            <tr key={product.id} className=\"border-t\">\r\n              <td className=\"px-4 py-3 font-medium\">{product.name}</td>\r\n              <td className=\"px-4 py-3 text-right\">${product.price.toFixed(2)}</td>\r\n              <td className=\"px-4 py-3 text-right\">{'★'.repeat(Math.round(product.rating))} {product.rating}</td>\r\n              <td className=\"px-4 py-3 text-right\">{product.reviews.toLocaleString()}</td>\r\n              <td className=\"px-4 py-3 text-center\">\r\n"]
