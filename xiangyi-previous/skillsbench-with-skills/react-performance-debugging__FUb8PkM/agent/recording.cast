[593.326694, "i", "cat <<'EOF' > src/app/api/checkout/route.ts\n// src/app/api/checkout/route.ts\nimport { NextRequest, NextResponse } from 'next/server';\nimport {\n  fetchUserFromService,\n  fetchConfigFromService,\n  fetchProfileFromService,\n} from '@/services/api-client';\n\nexport const dynamic = 'force-dynamic';\n\nexport async function POST(_request: NextRequest) {\n  const userPromise = fetchUserFromService();\n  const configPromise = fetchConfigFromService();\n\n  const user = await userPromise;\n  const profilePromise = fetchProfileFromService(user.id);\n\n  const [config, profile] = await Promise.all([configPromise, profilePromise]);\n\n  return NextResponse.json({\n    success: true,\n    user: { id: user.id, name: user.name },\n    profile,\n    config: { currency: config.currency },\n  });\n}\nEOF\n"]
