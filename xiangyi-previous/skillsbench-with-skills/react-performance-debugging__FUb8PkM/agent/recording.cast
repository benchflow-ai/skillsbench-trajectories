[142.240425, "o", "nl -ba src/app/compare/page.tsx | sed -n '1,190p'\r\n\u001b[?2004l\r     1\t// src/app/compare/page.tsx\r\n     2\t'use client';\r\n     3\t\r\n     4\timport { useState } from 'react';\r\n     5\timport { groupBy, sortBy, meanBy, sumBy, maxBy, minBy } from 'lodash';\r\n     6\timport { mean, std, median, quantileSeq, variance } from 'mathjs';\r\n     7\t\r\n     8\tinterface Product {\r\n     9\t  id: string;\r\n    10\t  name: string;\r\n    11\t  price: number;\r\n    12\t  category: string;\r\n    13\t  rating: number;\r\n    14\t  reviews: number;\r\n    15\t  inStock: boolean;\r\n    16\t}\r\n    17\t\r\n    18\t// Sample products to compare\r\n    19\tconst PRODUCTS: Product[] = [\r\n    20\t  { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },\r\n    21\t  { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },\r\n    22\t  { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },\r\n    23\t  { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },\r\n    24\t  { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },\r\n    25\t];\r\n    26\t\r\n    27\tfunction ComparisonTable({ products }: { products: Product[] }) {\r\n    28\t  // Using lodash for data transformations\r\n    29\t  const sorted = sortBy(products, ['price']);\r\n    30\t  const avgPrice = meanBy(products, 'price');\r\n    31\t  const totalReviews = sumBy(products, 'reviews');\r\n    32\t  const bestRated = maxBy(products, 'rating');\r\n    33\t  const cheapest = minBy(products, 'price');\r\n    34\t\r\n    35\t  return (\r\n    36\t    <div className=\"bg-white rounded-xl shadow-md p-6\">\r\n    37\t      <h2 className=\"text-xl font-bold mb-4\">Comparison Overview</h2>\r\n    38\t\r\n    39\t      <div className=\"grid grid-cols-4 gap-4 mb-6 text-center\">\r\n    40\t        <div className=\"bg-blue-50 p-4 rounded-lg\">\r\n    41\t          <div className=\"text-2xl font-bold text-blue-600\">${avgPrice.toFixed(2)}</div>\r\n    42\t          <div className=\"text-sm text-gray-600\">Avg Price</div>\r\n    43\t        </div>\r\n    44\t        <div className=\"bg-green-50 p-4 rounded-lg\">\r\n    45\t          <div className=\"text-2xl font-bold text-green-600\">{totalReviews.toLocaleString()}</div>\r\n    46\t          <div className=\"text-sm text-gray-600\">Total Reviews</div>\r\n    47\t        </div>\r\n    48\t        <div className=\"bg-yellow-50 p-4 rounded-lg\">\r\n    49\t          <div className=\"text-2xl font-bold text-yellow-600\">{bestRated?.name}</div>\r\n    50\t          <div className=\"text-sm text-gray-600\">Best Rated</div>\r\n    51\t        </div>\r\n    52\t        <div className=\"bg-purple-50 p-4 rounded-lg\">\r\n    53\t          <div className=\"text-2xl font-bold text-purple-600\">{cheapest?.name}</div>\r\n    54\t          <div className=\"text-sm text-gray-600\">Best Value</div>\r\n    55\t        </div>\r\n    56\t      </div>\r\n    57\t\r\n    58\t      <table className=\"w-full\">\r\n    59\t        <thead className=\"bg-gray-50\">\r\n    60\t          <tr>\r\n    61\t            <th className=\"px-4 py-3 text-left\">Product</th>\r\n    62\t            <th className=\"px-4 py-3 text-right\">Price</th>\r\n    63\t            <th className=\"px-4 py-3 text-right\">Rating</th>\r\n    64\t            <th className=\"px-4 py-3 text-right\">Reviews</th>\r\n    65\t            <th className=\"px-4 py-3 text-center\">Stock</th>\r\n    66\t          </tr>\r\n    67\t        </thead>\r\n    68\t        <tbody>\r\n    69\t          {sorted.map((product) => (\r\n    70\t            <tr key={product.id} className=\"border-t\">\r\n    71\t              <td className=\"px-4 py-3 font-medium\">{product.name}</td>\r\n    72\t              <td className=\"px-4 py-3 text-right\">${product.price.toFixed(2)}</td>\r\n    73\t              <td className=\"px-4 py-3 text-right\">{'★'.repeat(Math.round(product.rating))} {product.rating}</td>\r\n    74\t              <td className=\"px-4 py-3 text-right\">{product.reviews.toLocaleString()}</td>\r\n    75\t              <td className=\"px-4"]
[142.240532, "o", " py-3 text-center\">\r\n    76\t                <span className={`px-2 py-1 rounded-full text-xs ${product.inStock ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>\r\n    77\t                  {product.inStock ? 'In Stock' : 'Out of Stock'}\r\n    78\t                </span>\r\n    79\t              </td>\r\n    80\t            </tr>\r\n    81\t          ))}\r\n    82\t        </tbody>\r\n    83\t      </table>\r\n    84\t    </div>\r\n    85\t  );\r\n    86\t}\r\n    87\t\r\n    88\tfunction AdvancedAnalysis({ products }: { products: Product[] }) {\r\n    89\t  // Using mathjs for statistical calculations\r\n    90\t  const prices = products.map(p => p.price);\r\n    91\t  const ratings = products.map(p => p.rating);\r\n    92\t  const reviews = products.map(p => p.reviews);\r\n    93\t\r\n    94\t  const priceStats = {\r\n    95\t    mean: mean(prices),\r\n    96\t    median: median(prices),\r\n    97\t    std: std(prices),\r\n    98\t    variance: variance(prices),\r\n    99\t    q1: quantileSeq(prices, 0.25),\r\n   100\t    q3: quantileSeq(prices, 0.75),\r\n   101\t  };\r\n   102\t\r\n   103\t  const ratingStats = {\r\n   104\t    mean: mean(ratings),\r\n   105\t    median: median(ratings),\r\n   106\t    std: std(ratings),\r\n   107\t  };\r\n   108\t\r\n   109\t  const reviewStats = {\r\n   110\t    mean: mean(reviews),\r\n   111\t    median: median(reviews),\r\n   112\t    std: std(reviews),\r\n   113\t  };\r\n   114\t\r\n   115\t  // Calculate value score: rating / price * 100\r\n   116\t  const valueScores = products.map(p => ({\r\n   117\t    name: p.name,\r\n   118\t    score: (p.rating / p.price) * 100,\r\n   119\t  }));\r\n   120\t  const sortedByValue = sortBy(valueScores, 'score').reverse();\r\n   121\t\r\n   122\t  return (\r\n   123\t    <div data-testid=\"advanced-content\" className=\"bg-white rounded-xl shadow-md p-6\">\r\n   124\t      <h2 className=\"text-xl font-bold mb-4\">Advanced Statistical Analysis</h2>\r\n   125\t\r\n   126\t      <div className=\"grid grid-cols-3 gap-6\">\r\n   127\t        <div>\r\n   128\t          <h3 className=\"font-semibold mb-3 text-gray-700\">Price Distribution</h3>\r\n   129\t          <div className=\"space-y-2 text-sm\">\r\n   130\t            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">${Number(priceStats.mean).toFixed(2)}</span></div>\r\n   131\t            <div className=\"flex justify-between\"><span>Median:</span><span className=\"font-mono\">${Number(priceStats.median).toFixed(2)}</span></div>\r\n   132\t            <div className=\"flex justify-between\"><span>Std Dev:</span><span className=\"font-mono\">${Number(priceStats.std).toFixed(2)}</span></div>\r\n   133\t            <div className=\"flex justify-between\"><span>Variance:</span><span className=\"font-mono\">{Number(priceStats.variance).toFixed(2)}</span></div>\r\n   134\t            <div className=\"flex justify-between\"><span>Q1 (25%):</span><span className=\"font-mono\">${Number(priceStats.q1).toFixed(2)}</span></div>\r\n   135\t            <div className=\"flex justify-between\"><span>Q3 (75%):</span><span className=\"font-mono\">${Number(priceStats.q3).toFixed(2)}</span></div>\r\n   136\t          </div>\r\n   137\t        </div>\r\n   138\t\r\n   139\t        <div>\r\n   140\t          <h3 className=\"font-semibold mb-3 text-gray-700\">Rating Analysis</h3>\r\n   141\t          <div className=\"space-y-2 text-sm\">\r\n   142\t            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">{Number(ratingStats.mean).toFixed(2)}</span></div>\r\n   143\t            <div className=\"flex justify-between\"><span>Median:</span><span className=\"font-mono\">{Number(ratingStats.median).toFixed(2)}</span></div>\r\n   144\t            <div className=\"flex justify-between\"><span>Std Dev:</span><span className=\"font-mono\">{Number(ratingStats.std).toFixed(3)}</span></div>\r\n   145\t          </div>\r\n   146\t        </div>\r\n   147\t\r\n   148\t        <div>\r\n   149\t          <h3 className=\"font-semibold mb-3 text-gray-700\">Review Volume</h3>\r\n   150\t          <div className=\"space-y-2 text-sm\">\r\n   151\t            <div className=\"flex justify-between\"><span>Mean:</span><span className=\"font-mono\">{Number(reviewStats.mean).toFixed(0)}</span></div>\r\n   152\t            <div c"]
