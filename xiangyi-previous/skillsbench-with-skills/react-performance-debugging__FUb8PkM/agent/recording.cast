[594.891591, "o", "\u001b[?2004h> "]
[594.892162, "o", "  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];\r\n\u001b[?2004l\r\u001b[?2004h> };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[594.892215, "o", "> "]
[594.89277, "o", "const varianceValue = (values: number[], mean: number) =>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[594.89297, "o", "  values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / values.length;\r\n\u001b[?2004l\r"]
