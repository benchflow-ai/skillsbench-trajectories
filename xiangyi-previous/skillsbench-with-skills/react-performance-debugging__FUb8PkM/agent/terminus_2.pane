[?2004l[?2004h> // src/components/ProductList.tsx
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useCallback, useMemo, useState } from 'react';
[?2004l[?2004h> import { ProductCard } from './ProductCard';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> interface Review {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   productId: string;
[?2004l[?2004h>   text: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   author: string;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> interface Props {
[?2004l[?2004h>   products: Product[];
[?2004l[?2004h>   reviews: Review[];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export function ProductList({ products, reviews }: Props) {
[?2004l[?2004h>   const [cart, setCart] = useState<string[]>([]);
[?2004l[?2004h>   const [filter, setFilter] = useState('');
[?2004l[?2004h>   const [sortBy, setSortBy] = useState<'price' | 'rating'>('price');
[?2004l[?2004h> 
[?2004l[?2004h>   const reviewCounts = useMemo(() => {
[?2004l[?2004h>     const counts: Record<string, number> = {};
[?2004l[?2004h>     for (const review of reviews) {
[?2004l[?2004h>       counts[review.productId] = (counts[review.productId] ?? 0) + 1;
[?2004l[?2004h>     }
[?2004l[?2004h>     return counts;
[?2004l[?2004h>   }, [reviews]);
[?2004l[?2004h> 
[?2004l[?2004h>   const filteredProducts = useMemo(() => {
[?2004l[?2004h>     const normalizedFilter = filter.trim().toLowerCase();
[?2004l[?2004h>     return [...products]
[?2004l[?2004h>       .filter((product) => product.inStock)
[?2004l[?2004h>       .filter((product) => !normalizedFilter || product.name.toLowerCase().includes(normalizedFilter))
[?2004l[?2004h>       .sort((a, b) => (sortBy === 'price' ? a.price - b.price : b.rating - a.rating));
[?2004l[?2004h>   }, [products, filter, sortBy]);
[?2004l[?2004h> 
[?2004l[?2004h>   const cartSet = useMemo(() => new Set(cart), [cart]);
[?2004l[?2004h> 
[?2004l[?2004h>   const handleAddToCart = useCallback((productId: string) => {
[?2004l[?2004h>     setCart((prev) => (prev.includes(productId) ? prev : [...prev, productId]));
[?2004l[?2004h>   }, []);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div>
[?2004l[?2004h>       <div className="mb-6 flex flex-wrap gap-4 items-center">
[?2004l[?2004h>         <input
[?2004l[?2004h>           type="text"
[?2004l[?2004h>           placeholder="Search products..."
[?2004l[?2004h>           value={filter}
[?2004l[?2004h>           onChange={(e) => setFilter(e.target.value)}
[?2004l[?2004h>           className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
[?2004l[?2004h>         />
[?2004l[?2004h>         <select
[?2004l[?2004h>           value={sortBy}
[?2004l[?2004h>           onChange={(e) => setSortBy(e.target.value as 'price' | 'rating')}
[?2004l[?2004h>           className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
[?2004l[?2004h>         >
[?2004l[?2004h>           <option value="price">Sort by Price</option>
[?2004l[?2004h>           <option value="rating">Sort by Rating</option>
[?2004l[?2004h>         </select>
[?2004l[?2004h>         <div data-testid="cart-count" className="ml-auto px-4 py-2 bg-blue-100 text-blue-800 rounded-lg font-medium">
[?2004l[?2004h>           Cart: {cart.length} items
[?2004l[?2004h>         </div>
[?2004l[?2004h>       </div>
[?2004l[?2004h> 
[?2004l[?2004h>       <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
[?2004l[?2004h>         {filteredProducts.map((product) => (
[?2004l[?2004h>           <ProductCard
[?2004l[?2004h>             key={product.id}
[?2004l[?2004h>             product={product}
[?2004l[?2004h>             reviewCount={reviewCounts[product.id] ?? 0}
[?2004l[?2004h>             onAddToCart={handleAddToCart}
[?2004l[?2004h>             isInCart={cartSet.has(product.id)}
[?2004l[?2004h>           />
[?2004l[?2004h>         ))}
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@9b16d4041cbf:/app# cat <<'EOF' > src/app/compare/page.tsx
[?2004l[?2004h> // src/app/compare/page.tsx
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useMemo, useState } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> interface Product {
[?2004l[?2004h>   id: string;
[?2004l[?2004h>   name: string;
[?2004l[?2004h>   price: number;
[?2004l[?2004h>   category: string;
[?2004l[?2004h>   rating: number;
[?2004l[?2004h>   reviews: number;
[?2004l[?2004h>   inStock: boolean;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // Sample products to compare
[?2004l[?2004h> const PRODUCTS: Product[] = [
[?2004l[?2004h>   { id: '1', name: 'Premium Headphones', price: 299.99, category: 'Electronics', rating: 4.5, reviews: 1250, inStock: true },
[?2004l[?2004h>   { id: '2', name: 'Wireless Earbuds', price: 149.99, category: 'Electronics', rating: 4.2, reviews: 3420, inStock: true },
[?2004l[?2004h>   { id: '3', name: 'Studio Monitor', price: 449.99, category: 'Electronics', rating: 4.8, reviews: 567, inStock: false },
[?2004l[?2004h>   { id: '4', name: 'Portable Speaker', price: 79.99, category: 'Electronics', rating: 4.0, reviews: 2100, inStock: true },
[?2004l[?2004h>   { id: '5', name: 'Noise Canceling Pro', price: 379.99, category: 'Electronics', rating: 4.7, reviews: 890, inStock: true },
[?2004l[?2004h> ];
[?2004l[?2004h> 
[?2004l[?2004h> const average = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;
[?2004l[?2004h> const sortedValues = (values: number[]) => [...values].sort((a, b) => a - b);
[?2004l[?2004h> 
[?2004l[?2004h> const medianValue = (values: number[]) => {
[?2004l[?2004h>   const sorted = sortedValues(values);
[?2004l[?2004h>   const mid = Math.floor(sorted.length / 2);
[?2004l[?2004h>   return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
[?2004l[?2004h> };
[?2004l[?2004h> 
[?2004l[?2004h> const varianceValue = (values: number[], mean: number) =>
[?2004l[?2004h>   values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / values.length;
[?2004l[?2004h> 
[?2004l[?2004h> const quantileValue = (values: number[], q: number) => {
[?2004l[?2004h>   const sorted = sortedValues(values);
[?2004l[?2004h>   const pos = (sorted.length - 1) * q;
[?2004l[?2004h>   const base = Math.floor(pos);
[?2004l[?2004h>   const rest = pos - base;
[?2004l[?2004h>   const next = sorted[base + 1];
[?2004l[?2004h>   return next !== undefined ? sorted[base] + rest * (next - sorted[base]) : sorted[base];
