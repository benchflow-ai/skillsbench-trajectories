[?2004l// src/lib/api-client.ts
// HTTP client for external API services
// The actual API runs in a separate service - optimize how you use these calls!

const API_BASE = process.env.EXTERNAL_API_URL || 'http://localhost:3001';
const DEFAULT_REVALIDATE = 60;

type FetchOptions = RequestInit & { next?: { revalidate?: number } };

async function fetchJson<T>(path: string, init?: FetchOptions): Promise<T> {
  const res = await fetch(`${API_BASE}${path}`, {
    next: { revalidate: DEFAULT_REVALIDATE },
    ...init,
  });

  if (!res.ok) {
    throw new Error(`Failed to fetch ${path}`);
  }

  return res.json();
}

export function fetchUserFromService() {
  return fetchJson('/api/user', { next: { revalidate: 30 } });
}

export function fetchProductsFromService() {
  return fetchJson('/api/products', { next: { revalidate: 60 } });
}

export function fetchReviewsFromService() {
  return fetchJson('/api/reviews', { next: { revalidate: 60 } });
}

export function fetchConfigFromService() {
  return fetchJson('/api/config', { next: { revalidate: 300 } });
}

export function fetchProfileFromService(userId: string) {
  return fetchJson(`/api/profile/${userId}`, { next: { revalidate: 30 } });
}

export async function logAnalyticsToService(data: unknown) {
  const res = await fetch(`${API_BASE}/api/analytics`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
    keepalive: true,
  });
  if (!res.ok) throw new Error('Failed to log analytics');
  return res.json();
}
