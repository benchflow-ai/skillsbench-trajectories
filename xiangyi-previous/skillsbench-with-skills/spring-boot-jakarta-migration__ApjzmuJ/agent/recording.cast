[152.434637, "o", "\u001b[?2004h> "]
[152.43468, "o", "                .toBodilessEntity();\r\n\u001b[?2004l\r"]
[152.434708, "o", "\u001b[?2004h> "]
[152.434738, "o", "            return true;\r\n\u001b[?2004l\r"]
[152.43476, "o", "\u001b[?2004h> "]
[152.434801, "o", "        } catch (Exception e) {\r\n\u001b[?2004l\r"]
[152.434831, "o", "\u001b[?2004h> "]
