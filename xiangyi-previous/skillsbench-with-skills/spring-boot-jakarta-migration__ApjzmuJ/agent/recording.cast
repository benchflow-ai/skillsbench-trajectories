[152.429523, "o", "\u001b[?2004h"]
[152.429562, "o", "> "]
[152.42959, "o", "    private String baseUrl;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.42962, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.429659, "o", "    public ExternalApiService() {\r\n\u001b[?2004l\r"]
[152.429689, "o", "\u001b[?2004h> "]
[152.429744, "o", "        this.restClient = RestClient.builder()\r\n\u001b[?2004l\r"]
[152.429779, "o", "\u001b[?2004h> "]
[152.429798, "o", "            .build();\r\n\u001b[?2004l\r"]
[152.42983, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[152.429854, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.42988, "o", "    /**\r\n\u001b[?2004l\r"]
[152.429906, "o", "\u001b[?2004h> "]
[152.42996, "o", "     * Verify user email through external service\r\n\u001b[?2004l\r"]
[152.429986, "o", "\u001b[?2004h>      */\r\n\u001b[?2004l\r"]
[152.430002, "o", "\u001b[?2004h> "]
[152.430081, "o", "    public boolean verifyEmail(String email) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.430111, "o", "> "]
[152.43014, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.430232, "o", "            String url = baseUrl + \"/verify/email?email=\" + email;\r\n\u001b[?2004l\r"]
[152.430254, "o", "\u001b[?2004h> "]
[152.430334, "o", "            Map<String, Object> response = restClient.get()\r\n\u001b[?2004l\r"]
[152.430363, "o", "\u001b[?2004h> "]
[152.430392, "o", "                .uri(url)\r\n\u001b[?2004l\r"]
[152.430416, "o", "\u001b[?2004h> "]
[152.430451, "o", "                .retrieve()\r\n\u001b[?2004l\r"]
[152.430473, "o", "\u001b[?2004h> "]
[152.430517, "o", "                .body(Map.class);\r\n\u001b[?2004l\r"]
[152.43054, "o", "\u001b[?2004h> "]
[152.430557, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.430586, "o", "> "]
[152.430621, "o", "            if (response != null) {\r\n\u001b[?2004l\r"]
[152.43065, "o", "\u001b[?2004h> "]
[152.430717, "o", "                Object valid = response.get(\"valid\");\r\n\u001b[?2004l\r"]
[152.430743, "o", "\u001b[?2004h> "]
[152.430807, "o", "                return Boolean.TRUE.equals(valid);\r\n\u001b[?2004l\r"]
[152.430828, "o", "\u001b[?2004h> "]
[152.430864, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.430898, "o", "            return false;\r\n\u001b[?2004l\r"]
[152.430927, "o", "\u001b[?2004h> "]
[152.430961, "o", "        } catch (Exception e) {\r\n\u001b[?2004l\r"]
[152.430982, "o", "\u001b[?2004h> "]
[152.431054, "o", "            // Log and return false on failure\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.431088, "o", "> "]
[152.431117, "o", "            return false;\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.431146, "o", ">         }\r\n"]
[152.431173, "o", "\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[152.431194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.431221, "o", "\u001b[?2004h>     /**\r\n\u001b[?2004l\r"]
[152.43125, "o", "\u001b[?2004h> "]
[152.431326, "o", "     * Send notification to external notification service\r\n\u001b[?2004l\r"]
[152.431355, "o", "\u001b[?2004h> "]
[152.431385, "o", "     */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.431468, "o", "    public void sendNotification(String userId, String message) {\r\n\u001b[?2004l\r"]
[152.431491, "o", "\u001b[?2004h> "]
[152.431521, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.431626, "o", "            String url = baseUrl + \"/notifications\";\r\n\u001b[?2004l\r"]
[152.431652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.431676, "o", "\u001b[?2004h> "]
[152.43174, "o", "            Map<String, String> payload = Map.of(\r\n\u001b[?2004l\r"]
[152.431769, "o", "\u001b[?2004h> "]
[152.431806, "o", "                \"userId\", userId,\r\n\u001b[?2004l\r"]
[152.431836, "o", "\u001b[?2004h> "]
[152.431876, "o", "                \"message\", message,\r\n\u001b[?2004l\r"]
[152.431905, "o", "\u001b[?2004h> "]
[152.431949, "o", "                \"type\", \"USER_UPDATE\"\r\n\u001b[?2004l\r"]
[152.431974, "o", "\u001b[?2004h> "]
[152.432005, "o", "            );\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.432034, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.432071, "o", "            restClient.post()\r\n\u001b[?2004l\r"]
[152.432096, "o", "\u001b[?2004h> "]
[152.43213, "o", "                .uri(url)\r\n\u001b[?2004l\r"]
[152.432159, "o", "\u001b[?2004h> "]
[152.432229, "o", "                .contentType(MediaType.APPLICATION_JSON)\r\n\u001b[?2004l\r"]
[152.432259, "o", "\u001b[?2004h> "]
[152.432292, "o", "                .body(payload)\r\n\u001b[?2004l\r"]
[152.432322, "o", "\u001b[?2004h> "]
[152.432351, "o", "                .retrieve()\r\n\u001b[?2004l\r"]
[152.432378, "o", "\u001b[?2004h> "]
[152.432423, "o", "                .toBodilessEntity();\r\n\u001b[?2004l\r"]
[152.432451, "o", "\u001b[?2004h> "]
[152.432488, "o", "        } catch (Exception e) {\r\n\u001b[?2004l\r"]
[152.432517, "o", "\u001b[?2004h> "]
[152.432585, "o", "            // Log notification failure but don't throw\r\n\u001b[?2004l\r"]
[152.432614, "o", "\u001b[?2004h> "]
[152.432721, "o", "            System.err.println(\"Failed to send notification: \" + e.getMessage());\r\n\u001b[?2004l\r"]
[152.432732, "o", "\u001b[?2004h"]
[152.43275, "o", "> "]
[152.432773, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.432807, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
