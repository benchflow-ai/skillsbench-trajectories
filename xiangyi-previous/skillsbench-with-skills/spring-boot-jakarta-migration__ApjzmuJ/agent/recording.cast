[152.43345, "o", "\u001b[?2004h> "]
[152.43351, "o", "                .accept(MediaType.APPLICATION_JSON)\r\n\u001b[?2004l\r"]
[152.433536, "o", "\u001b[?2004h> "]
[152.433571, "o", "                .retrieve()\r\n\u001b[?2004l\r"]
[152.433599, "o", "\u001b[?2004h> "]
[152.433638, "o", "                .body(Map.class);\r\n\u001b[?2004l\r"]
[152.433666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.433695, "o", "\u001b[?2004h> "]
[152.433777, "o", "            return response != null ? response : Collections.emptyMap();\r\n\u001b[?2004l\r"]
[152.433806, "o", "\u001b[?2004h> "]
[152.433844, "o", "        } catch (Exception e) {\r\n\u001b[?2004l\r"]
[152.433877, "o", "\u001b[?2004h> "]
[152.433924, "o", "            return Collections.emptyMap();\r\n\u001b[?2004l\r"]
[152.433949, "o", "\u001b[?2004h> "]
[152.433978, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[152.434006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
