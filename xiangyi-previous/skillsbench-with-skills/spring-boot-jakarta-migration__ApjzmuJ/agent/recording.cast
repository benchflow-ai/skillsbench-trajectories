[152.432868, "o", "\u001b[?2004h> "]
[152.432942, "o", "     * Fetch user profile enrichment data from external service\r\n\u001b[?2004l\r"]
[152.432973, "o", "\u001b[?2004h>      */\r\n\u001b[?2004l\r"]
[152.432999, "o", "\u001b[?2004h> "]
[152.433084, "o", "    public Map<String, Object> enrichUserProfile(String userId) {\r\n\u001b[?2004l\r"]
[152.433114, "o", "\u001b[?2004h> "]
[152.433142, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
