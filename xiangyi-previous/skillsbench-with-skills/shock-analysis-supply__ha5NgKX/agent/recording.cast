[179.440318, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load PWT file\nwb = openpyxl.load_workbook('pwt1001.xlsx', read_only=True)\nprint('Sheet names:', wb.sheetnames)\n\n# Check the first sheet for structure\nfor sheet_name in wb.sheetnames[:3]:\n    ws = wb[sheet_name]\n    print(f'\\n=== Sheet: {sheet_name} ===')\n    row_count = 0\n    for row in ws.iter_rows(max_row=5, values_only=True):\n        print(row[:15])  # First 15 columns\n        row_count += 1\nEOF\n"]
