[141.500449, "i", "python3 << 'EOF'\nimport urllib.request\nimport ssl\n\n# Create SSL context that doesn't verify certificates\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# PWT 10.01 direct download URL\nurl = 'https://www.rug.nl/ggdc/docs/pwt1001.xlsx'\nprint(f'Downloading from {url}...')\n\ntry:\n    urllib.request.urlretrieve(url, 'pwt1001.xlsx')\n    print('Download complete!')\nexcept Exception as e:\n    print(f'Error: {e}')\n    # Try alternative URL\n    url2 = 'https://dataverse.nl/api/access/datafile/354098'\n    print(f'Trying alternative: {url2}')\n    try:\n        urllib.request.urlretrieve(url2, 'pwt1001.xlsx')\n        print('Download complete from alternative!')\n    except Exception as e2:\n        print(f'Error 2: {e2}')\nEOF\n"]
