[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import glob
[?2004l[?2004h> import os
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def count_objects(image_gray, template_path, threshold=0.8):
[?2004l[?2004h>     if not os.path.exists(template_path):
[?2004l[?2004h>         return 0
[?2004l[?2004h>     template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h>     if template is None:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     
[?2004l[?2004h>     w, h = template.shape[::-1]
[?2004l[?2004h>     res = cv2.matchTemplate(image_gray, template, cv2.TM_CCOEFF_NORMED)
[?2004l[?2004h>     loc = np.where(res >= threshold)
[?2004l[?2004h>     
[?2004l[?2004h>     # Non-maximum suppression to avoid multiple counts for the same object
[?2004l[?2004h>     pts = []
[?2004l[?2004h>     for pt in zip(*loc[::-1]):
[?2004l[?2004h>         pts.append(pt)
[?2004l[?2004h>     
[?2004l[?2004h>     if not pts:
[?2004l[?2004h>         return 0
[?2004l[?2004h>         
[?2004l[?2004h>     # Simple clustering: remove points that are too close to each other
[?2004l[?2004h>     # We'll use a greedy approach: pick a point, remove all points within distance w/2, h/2
[?2004l[?2004h>     # Actually, let's just count connected components or use a simpler distance check
[?2004l[?2004h>     
[?2004l[?2004h>     # A simpler approach for this task might be sufficient if exact bounding boxes aren't needed
[?2004l[?2004h>     # but we need a count. Let's do a simple distance filter.
[?2004l[?2004h>     
[?2004l[?2004h>     filtered_pts = []
[?2004l[?2004h>     pts = sorted(pts, key=lambda x: res[x[1], x[0]], reverse=True)
[?2004l[?2004h>     
[?2004l[?2004h>     while pts:
[?2004l[?2004h>         pt = pts.pop(0)
[?2004l[?2004h>         filtered_pts.append(pt)
[?2004l[?2004h>         # Remove points that are close
[?2004l[?2004h>         pts = [p for p in pts if abs(p[0] - pt[0]) > w/2 or abs(p[1] - pt[1]) > h/2]
[?2004l[?2004h>         
[?2004l[?2004h>     return len(filtered_pts)
[?2004l[?2004h> 
[?2004l[?2004h> # Get sorted list of keyframes
[?2004l[?2004h> frames = sorted(glob.glob('/root/keyframes_*.png'))
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for frame_path in frames:
[?2004l[?2004h>     # Step 3: Convert to grayscale and overwrite
[?2004l[?2004h>     img = cv2.imread(frame_path)
[?2004l[?2004h>     if img is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     cv2.imwrite(frame_path, gray)
[?2004l[?2004h>     
[?2004l[?2004h>     # Reload grayscale image (or just use 'gray' variable)
[?2004l[?2004h>     # We need to use the grayscale image for detection
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 4 & 5: Count objects
[?2004l[?2004h>     n_coins = count_objects(gray, '/root/coin.png', threshold=0.8)
[?2004l[?2004h>     n_enemies = count_objects(gray, '/root/enemy.png', threshold=0.8)
[?2004l[?2004h>     n_turtles = count_objects(gray, '/root/turtle.png', threshold=0.8)
[?2004l[?2004h>     
[?2004l[?2004h>     results.append([frame_path, n_coins, n_enemies, n_turtles])
[?2004l[?2004h>     print(f"Processed {frame_path}: coins={n_coins}, enemies={n_enemies}, turtles={n_turtles}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Write CSV
[?2004l[?2004h> with open('/root/counting_results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.writer(f)
[?2004l[?2004h>     writer.writerow(['frame_id', 'coins', 'enemies', 'turtles'])
[?2004l[?2004h>     writer.writerows(results)
[?2004l[?2004h> 
[?2004l[?2004h> print("Processing complete.")
