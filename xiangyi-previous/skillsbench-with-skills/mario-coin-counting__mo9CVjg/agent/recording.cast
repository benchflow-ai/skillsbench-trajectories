[63.721503, "i", "cat << 'EOF' > /root/process_frames.py\nimport cv2\nimport numpy as np\nimport glob\nimport os\nimport csv\n\ndef count_objects(image_gray, template_path, threshold=0.8):\n    if not os.path.exists(template_path):\n        return 0\n    template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n    if template is None:\n        return 0\n    \n    w, h = template.shape[::-1]\n    res = cv2.matchTemplate(image_gray, template, cv2.TM_CCOEFF_NORMED)\n    loc = np.where(res >= threshold)\n    \n    # Non-maximum suppression to avoid multiple counts for the same object\n    pts = []\n    for pt in zip(*loc[::-1]):\n        pts.append(pt)\n    \n    if not pts:\n        return 0\n        \n    # Simple clustering: remove points that are too close to each other\n    # We'll use a greedy approach: pick a point, remove all points within distance w/2, h/2\n    # Actually, let's just count connected components or use a simpler distance check\n    \n    # A simpler approach for this task might be sufficient if exact bounding boxes aren't needed\n    # but we need a count. Let's do a simple distance filter.\n    \n    filtered_pts = []\n    pts = sorted(pts, key=lambda x: res[x[1], x[0]], reverse=True)\n    \n    while pts:\n        pt = pts.pop(0)\n        filtered_pts.append(pt)\n        # Remove points that are close\n        pts = [p for p in pts if abs(p[0] - pt[0]) > w/2 or abs(p[1] - pt[1]) > h/2]\n        \n    return len(filtered_pts)\n\n# Get sorted list of keyframes\nframes = sorted(glob.glob('/root/keyframes_*.png'))\n\nresults = []\n\nfor frame_path in frames:\n    # Step 3: Convert to grayscale and overwrite\n    img = cv2.imread(frame_path)\n    if img is None:\n        continue\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    cv2.imwrite(frame_path, gray)\n    \n    # Reload grayscale image (or just use 'gray' variable)\n    # We need to use the grayscale image for detection\n    \n    # Step 4 & 5: Count objects\n    n_coins = count_objects(gray, '/root/coin.png', threshold=0.8)\n    n_enemies = count_objects(gray, '/root/enemy.png', threshold=0.8)\n    n_turtles = count_objects(gray, '/root/turtle.png', threshold=0.8)\n    \n    results.append([frame_path, n_coins, n_enemies, n_turtles])\n    print(f\"Processed {frame_path}: coins={n_coins}, enemies={n_enemies}, turtles={n_turtles}\")\n\n# Step 6: Write CSV\nwith open('/root/counting_results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['frame_id', 'coins', 'enemies', 'turtles'])\n    writer.writerows(results)\n\nprint(\"Processing complete.\")\nEOF\n"]
