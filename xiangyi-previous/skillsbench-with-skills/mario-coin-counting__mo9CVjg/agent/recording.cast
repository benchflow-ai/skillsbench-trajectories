[63.725634, "o", "    # Step 4 & 5: Count objects\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.725736, "o", "    n_coins = count_objects(gray, '/root/coin.png', threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.725861, "o", "    n_enemies = count_objects(gray, '/root/enemy.png', threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.725982, "o", "    n_turtles = count_objects(gray, '/root/turtle.png', threshold=0.8)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726118, "o", "    results.append([frame_path, n_coins, n_enemies, n_turtles])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726277, "o", "    print(f\"Processed {frame_path}: coins={n_coins}, enemies={n_enemies}, turtles={n_turtles}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726341, "o", "# Step 6: Write CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726434, "o", "with open('/root/counting_results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726494, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726621, "o", "    writer.writerow(['frame_id', 'coins', 'enemies', 'turtles'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726674, "o", "    writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.726746, "o", "print(\"Processing complete.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[63.727895, "o", "\u001b[?2004hroot@cfd8208c5b9b:~# "]
