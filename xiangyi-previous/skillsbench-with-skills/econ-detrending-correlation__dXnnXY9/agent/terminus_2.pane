[?2004hroot@6b29b5bef447:~# cat << 'EOF' > calculate.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from statsmodels.tsa.filters.hp_filter import hpfilter
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> def get_data(file, col):
[?2004l[?2004h>     df = pd.read_excel(file, engine='xlrd')
[?2004l[?2004h>     ann, qtr, cur_y = {}, {}, None
[?2004l[?2004h>     for i in range(len(df)):
[?2004l[?2004h>         lbl = str(df.iloc[i, 0]).strip()
[?2004l[?2004h>         val = df.iloc[i, col]
[?2004l[?2004h>         m = re.search(r'(\d{4})', lbl)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             y = int(m.group(1))
[?2004l[?2004h>             if ':' in lbl:
[?2004l[?2004h>                 cur_y = y
[?2004l[?2004h>                 try: qtr.setdefault(y, []).append(float(val))
[?2004l[?2004h>                 except: pass
[?2004l[?2004h>             elif lbl.endswith('.') or (len(lbl) == 4 and lbl.isdigit()):
[?2004l[?2004h>                 try: ann[y] = float(val)
[?2004l[?2004h>                 except: pass
[?2004l[?2004h>         elif lbl in ['I.', 'II.', 'III.', 'IV.', 'I p.', 'II p.', 'III p.', 'IV p.', 'II', 'III', 'IV']:
[?2004l[?2004h>             if cur_y is not None:
[?2004l[?2004h>                 try: qtr.setdefault(cur_y, []).append(float(val))
[?2004l[?2004h>                 except: pass
[?2004l[?2004h>     res = {}
[?2004l[?2004h>     for y in range(1973, 2025):
[?2004l[?2004h>         if y == 2024 and y in qtr: res[y] = np.mean(qtr[y])
[?2004l[?2004h>         elif y in ann: res[y] = ann[y]
[?2004l[?2004h>         elif y in qtr: res[y] = np.mean(qtr[y])
[?2004l[?2004h>     return pd.Series(res)
[?2004l[?2004h> 
[?2004l[?2004h> pce = get_data('ERP-2025-table10.xls', 1)
[?2004l[?2004h> pfi = get_data('ERP-2025-table12.xls', 1)
[?2004l[?2004h> cpi = pd.read_excel('CPI.xlsx').set_index('Year')['CPI_2024']
[?2004l[?2004h> 
[?2004l[?2004h> years = range(1973, 2025)
[?2004l[?2004h> data = pd.DataFrame({'pce': pce, 'pfi': pfi, 'cpi': cpi}).reindex(years)
[?2004l[?2004h> 
[?2004l[?2004h> log_rpce = np.log(data['pce'] / data['cpi'])
[?2004l[?2004h> log_rpfi = np.log(data['pfi'] / data['cpi'])
[?2004l[?2004h> 
[?2004l[?2004h> cyc_pce, _ = hpfilter(log_rpce, lamb=100)
[?2004l[?2004h> cyc_pfi, _ = hpfilter(log_rpfi, lamb=100)
[?2004l[?2004h> 
[?2004l[?2004h> corr = cyc_pce.corr(cyc_pfi)
[?2004l[?2004h> print(f'{corr:.5f}')
[?2004l[?2004h> with open('answer.txt', 'w') as f: f.write(f'{corr:.5f}\n')
[?2004l[?2004h> EOF
