[13.934519, "i", "cat << 'EOF' > inspect_files.py\nimport pandas as pd\n\ndef inspect(file_path, engine=None):\n    print(f\"\\n--- Inspecting {file_path} ---\")\n    try:\n        df = pd.read_excel(file_path, engine=engine)\n        print(df.head(20))\n        print(df.tail(10))\n    except Exception as e:\n        print(f\"Error reading {file_path}: {e}\")\n\ninspect('ERP-2025-table10.xls', engine='xlrd')\ninspect('ERP-2025-table12.xls', engine='xlrd')\ninspect('CPI.xlsx', engine='openpyxl')\nEOF\npython3 inspect_files.py\n"]
