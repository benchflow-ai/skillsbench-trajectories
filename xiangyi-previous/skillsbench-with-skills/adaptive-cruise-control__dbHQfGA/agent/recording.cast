[58.427527, "o", "            if relative_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.427614, "o", "                ttc = distance / relative_speed\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.427667, "o", "\u001b[?2004h> "]
