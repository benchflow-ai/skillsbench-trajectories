[207.952572, "o", "> "]
[207.952608, "o", "        if not np.isnan(csv_distance):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.952704, "o", "            lead_pos = csv_ego_pos + csv_distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.952792, "o", "            lead_speed = csv_lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.952874, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.952944, "o", "            # My distance to lead vehicle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953004, "o", "            my_distance = lead_pos - my_ego_pos\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.953061, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953117, "o", "            lead_speed = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.95317, "o", "            my_distance = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953341, "o", "        accel_cmd, mode, dist_err = acc.compute(my_ego_speed, lead_speed, my_distance, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953372, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953402, "o", "        ttc = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.95351, "o", "        if my_distance is not None and lead_speed is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953601, "o", "            rel_speed = my_ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953661, "o", "            if rel_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953742, "o", "                ttc = my_distance / rel_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953793, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953847, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.9539, "o", "            'time': time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.953959, "o", "            'ego_speed': round(my_ego_speed, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954055, "o", "            'acceleration_cmd': round(accel_cmd, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954108, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954273, "o", "            'distance_error': round(dist_err, 2) if dist_err is not None else '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954388, "o", "            'distance': round(my_distance, 2) if my_distance is not None else '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954479, "o", "            'ttc': round(ttc, 2) if ttc is not None else ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954536, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.95459, "o", "        # Update my ego state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.95471, "o", "        my_ego_pos += my_ego_speed * dt + 0.5 * accel_cmd * dt**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954775, "o", "        my_ego_speed += accel_cmd * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.954858, "o", "        my_ego_speed = max(0, my_ego_speed)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[207.954913, "o", "\u001b[?2004h> "]
[207.954965, "o", "        # Update CSV ego position for next step\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.955028, "o", "        csv_ego_pos += csv_ego_speed * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.955083, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.955136, "o", "    df_results = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.955227, "o", "    df_results.to_csv('simulation_results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.955371, "o", "    print(\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
