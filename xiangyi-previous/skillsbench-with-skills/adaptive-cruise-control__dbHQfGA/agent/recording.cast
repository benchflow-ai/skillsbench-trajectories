[53.347305, "o", "        p = self.kp * error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347359, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347414, "o", "        # Integral term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347456, "o", "        self.integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.347503, "o", "> "]
[53.347556, "o", "        i = self.ki * self.integral\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347597, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347644, "o", "        # Derivative term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347715, "o", "        derivative = (error - self.prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.347772, "o", "        d = self.kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.347825, "o", "> "]
[53.347875, "o", "        self.prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.347919, "o", ">         output = p + i + d\r\n\u001b[?2004l\r"]
[53.347971, "o", "\u001b[?2004h> "]
[53.34801, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         # Anti-windup\r\n\u001b[?2004l\r"]
[53.348056, "o", "\u001b[?2004h> "]
[53.348109, "o", "        lower, upper = self.output_limits\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.348155, "o", "> "]
[53.348203, "o", "        if lower is not None or upper is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.348293, "o", "            if upper is not None and output > upper:\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.348356, "o", "> "]
[53.348443, "o", "                # If output is saturated, we stop integrating if the error has the same sign\r\n\u001b[?2004l\r"]
[53.348469, "o", "\u001b[?2004h> "]
[53.348551, "o", "                if error > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.348599, "o", "                    self.integral -= error * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.348644, "o", "> "]
[53.348698, "o", "                output = upper\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.348762, "o", "            elif lower is not None and output < lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.348814, "o", "> "]
[53.348956, "o", "                if error < 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.349013, "o", "                    self.integral -= error * dt\r\n\u001b[?2004l\r\u001b[?2004h>                 output = lower\r\n\u001b[?2004l\r"]
[53.349064, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.349114, "o", "        return output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.349164, "o", "EOF\r\n\u001b[?2004l\r"]
[53.367994, "o", "\u001b[?2004hroot@b544bb5f2e92:~# "]
[58.424125, "i", "cat <<EOF > acc_system.py\nfrom pid_controller import PIDController\n\nclass AdaptiveCruiseControl:\n    def __init__(self, config):\n        self.config = config\n        self.set_speed = config['acc_settings']['set_speed']\n        self.time_headway = config['acc_settings']['time_headway']\n        self.min_distance = config['acc_settings']['min_distance']\n        self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']\n        self.max_accel = config['vehicle']['max_acceleration']\n        self.max_decel = config['vehicle']['max_deceleration']\n\n        self.pid_speed = PIDController(\n            config['pid_speed']['kp'],\n            config['pid_speed']['ki'],\n            config['pid_speed']['kd'],\n            output_limits=(self.max_decel, self.max_accel)\n        )\n        self.pid_distance = PIDController(\n            config['pid_distance']['kp'],\n            config['pid_distance']['ki'],\n            config['pid_distance']['kd'],\n            output_limits=(self.max_decel, self.max_accel)\n        )\n\n    def compute(self, ego_speed, lead_speed, distance, dt):\n        mode = 'cruise'\n        acceleration_cmd = 0.0\n        distance_error = None\n\n        if distance is not None and not (isinstance(distance, float) and distance != distance): # check for None or NaN\n            # Lead vehicle detected\n            safe_distance = self.min_distance + self.time_headway * ego_speed\n            distance_error = distance - safe_distance\n            \n            relative_speed = ego_speed - lead_speed\n            ttc = float('inf')\n            if relative_speed > 0:\n                ttc = distance / relative_speed\n\n            if ttc < self.emergency_ttc_threshold:\n                mode = 'emergency'\n                acceleration_cmd = self.max_decel\n                # Reset integral terms when in emergency to avoid issues after\n                self.pid_speed.reset()\n                self.pid_distance.reset()\n            else:\n                mode = 'follow'\n                acceleration_cmd = self.pid_distance.compute(distance_error, dt)\n        else:\n            # No lead vehicle\n            mode = 'cruise'\n            speed_error = self.set_speed - ego_speed\n            acceleration_cmd = self.pid_speed.compute(speed_error, dt)\n\n        # Apply acceleration limits (already handled by PIDController but for safety)\n        acceleration_cmd = max(self.max_decel, min(self.max_accel, acceleration_cmd))\n\n        return acceleration_cmd, mode, distance_error\nEOF\n"]
[58.42438, "o", "cat <<EOF > acc_system.py\r\n\u001b[?2004l\r"]
