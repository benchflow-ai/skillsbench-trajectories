[511.75122, "o", "            config['pid_distance']['kd'],\r\n\u001b[?2004l\r"]
[511.751249, "o", "\u001b[?2004h> "]
[511.751335, "o", "            output_limits=(self.max_decel, self.max_accel)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751364, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751447, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751497, "o", "        self.filtered_distance = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751581, "o", "        self.filtered_lead_speed = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751626, "o", "        self.alpha = 0.2 # Filter constant\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.751684, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751755, "o", "    def compute(self, ego_speed, lead_speed, distance, dt):\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.75181, "o", "> "]
[511.751864, "o", "        mode = 'cruise'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751918, "o", "        acceleration_cmd = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.751963, "o", "        distance_error = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.75204, "o", "        # Always compute speed-based acceleration\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.752095, "o", "> "]
[511.752138, "o", "        speed_error = self.set_speed - ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.752249, "o", "        accel_speed = self.pid_speed.compute(speed_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[511.7523, "o", "\u001b[?2004h> "]
[511.752421, "o", "        if distance is not None and not (isinstance(distance, float) and distance != distance):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.752491, "o", "            # Filter distance and lead speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.752545, "o", "> "]
[511.752584, "o", "            if self.filtered_distance is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.752638, "o", "> "]
[511.752691, "o", "                self.filtered_distance = distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.752767, "o", "                self.filtered_lead_speed = lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.752811, "o", "> "]
[511.752877, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.752998, "o", "                self.filtered_distance = self.alpha * distance + (1 - self.alpha) * self.filtered_distance\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.753046, "o", "> "]
[511.753186, "o", "                self.filtered_lead_speed = self.alpha * lead_speed + (1 - self.alpha) * self.filtered_lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753245, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753301, "o", "            distance = self.filtered_distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753392, "o", "            lead_speed = self.filtered_lead_speed\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[511.753422, "o", "\u001b[?2004h> "]
[511.753474, "o", "            # Lead vehicle detected\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.75361, "o", "            safe_distance = self.min_distance + self.time_headway * ego_speed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753697, "o", "            distance_error = distance - safe_distance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753756, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753823, "o", "            relative_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.753852, "o", "> "]
[511.753929, "o", "            ttc = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.753974, "o", "            if relative_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754034, "o", "                ttc = distance / relative_speed\r\n\u001b[?2004l\r"]
[511.754081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754148, "o", "            if ttc < self.emergency_ttc_threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754214, "o", "                mode = 'emergency'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754303, "o", "                acceleration_cmd = self.max_decel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754372, "o", "                self.pid_speed.reset()\r\n\u001b[?2004l\r"]
[511.754425, "o", "\u001b[?2004h> "]
[511.75447, "o", "                self.pid_distance.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754532, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754594, "o", "                mode = 'follow'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.754686, "o", "                accel_dist = self.pid_distance.compute(distance_error, dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.754743, "o", "> "]
[511.754794, "o", "                acceleration_cmd = min(accel_speed, accel_dist)\r\n\u001b[?2004l\r"]
[511.754848, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[511.754889, "o", "\u001b[?2004h> "]
[511.75494, "o", "            # No lead vehicle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.75499, "o", "            mode = 'cruise'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.755033, "o", "            acceleration_cmd = accel_speed\r\n\u001b[?2004l\r\u001b[?2004h"]
[511.755062, "o", "> "]
[511.755159, "o", "            self.pid_distance.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.755225, "o", "            self.filtered_distance = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.755287, "o", "            self.filtered_lead_speed = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[511.755334, "o", "\u001b[?2004h> "]
[511.755383, "o", "        # Apply acceleration limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[511.755508, "o", "        acceleration_cmd = max(self.max_decel, min(self.max_accel, acceleration_cmd))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[511.755561, "o", "\u001b[?2004h> "]
[511.755611, "o", "        return acceleration_cmd, mode, distance_error\r\n\u001b[?2004l\r"]
[511.755661, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[511.757112, "o", "\u001b[?2004hroot@b544bb5f2e92:~# "]
[514.124408, "i", "cat <<EOF > tuning_results.yaml\npid_speed:\n  kp: 0.8\n  ki: 0.1\n  kd: 0.1\npid_distance:\n  kp: 1.2\n  ki: 0.2\n  kd: 0.5\nEOF\npython3 simulation.py\npython3 check_metrics.py\n"]
