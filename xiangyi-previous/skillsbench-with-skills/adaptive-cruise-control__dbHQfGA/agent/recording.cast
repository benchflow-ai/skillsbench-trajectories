[26.224397, "o", "\u001b[?2004h> "]
[26.224555, "o", "        # The sensor_data.csv ego_speed might be different if it's from real-world driving,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.224646, "o", "        # but the task says \"initial speed ~0 m/s\".\r\n\u001b[?2004l\r"]
[26.224706, "o", "\u001b[?2004h> "]
[26.224796, "o", "        # We should use our own ego_speed state.\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.224881, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[26.224955, "o", "> "]
[26.225079, "o", "        accel_cmd, mode, dist_err = acc.compute(ego_speed, lead_speed, distance, dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.225152, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.225223, "o", "        # Calculate TTC for logging\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.225287, "o", "        ttc = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.225361, "o", "> "]
[26.225558, "o", "        if distance is not None and not np.isnan(distance) and lead_speed is not None and not np.isnan(lead_speed):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.225635, "o", "            rel_speed = ego_speed - lead_speed\r\n\u001b[?2004l\r"]
[26.225666, "o", "\u001b[?2004h> "]
[26.225764, "o", "            if rel_speed > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.225838, "o", "                ttc = distance / rel_speed\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.225911, "o", "\u001b[?2004h> "]
[26.226009, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.226075, "o", "            'time': time,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.22615, "o", "            'ego_speed': round(ego_speed, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.226226, "o", "> "]
[26.226283, "o", "            'acceleration_cmd': round(accel_cmd, 2),\r\n\u001b[?2004l\r"]
[26.226344, "o", "\u001b[?2004h> "]
[26.226415, "o", "            'mode': mode,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.226582, "o", "            'distance_error': round(dist_err, 2) if dist_err is not None else '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.226748, "o", "            'distance': round(distance, 2) if not np.isnan(distance) else '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.226884, "o", "            'ttc': round(ttc, 2) if ttc is not None else ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.226939, "o", ">         })\r\n\u001b[?2004l\r"]
[26.227003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.227083, "o", "        # Update ego speed for next step\r\n\u001b[?2004l\r"]
[26.227155, "o", "\u001b[?2004h> "]
[26.227227, "o", "        ego_speed += accel_cmd * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.227375, "o", "        ego_speed = max(0, ego_speed) # Speed cannot be negative\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[26.227451, "o", "> "]
[26.227509, "o", "    # Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.227572, "o", "    df_results = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.227645, "o", "> "]
[26.227708, "o", "    df_results.to_csv('simulation_results.csv', index=False)\r\n\u001b[?2004l\r"]
[26.227783, "o", "\u001b[?2004h> "]
[26.227892, "o", "    print(\"Simulation complete. Results saved to simulation_results.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[26.227922, "o", "> "]
[26.228024, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.2281, "o", "    run_simulation()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[26.229435, "o", "\u001b[?2004hroot@b544bb5f2e92:~# "]
[29.619432, "i", "cat <<EOF > tuning_results.yaml\npid_speed:\n  kp: 0.5\n  ki: 0.05\n  kd: 0.1\npid_distance:\n  kp: 0.4\n  ki: 0.02\n  kd: 0.2\nEOF\n"]
[29.619644, "o", "cat <<EOF > tuning_results.yaml\r\n\u001b[?2004l\r"]
[29.619719, "o", "\u001b[?2004h> "]
[29.619753, "o", "pid_speed:\r\n\u001b[?2004l\r\u001b[?2004h>   kp: 0.5\r\n\u001b[?2004l\r\u001b[?2004h>   ki: 0.05\r\n\u001b[?2004l\r"]
[29.619818, "o", "\u001b[?2004h>   kd: 0.1\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.619846, "o", "> "]
