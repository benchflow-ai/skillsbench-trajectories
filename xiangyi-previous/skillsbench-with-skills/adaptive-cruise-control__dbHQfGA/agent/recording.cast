[29.619909, "o", "\u001b[?2004h> "]
[29.619941, "o", "  kp: 0.4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.619999, "o", "  ki: 0.02\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.620032, "o", "  kd: 0.2\r\n\u001b[?2004l\r"]
