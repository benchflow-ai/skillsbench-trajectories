[36.497626, "i", "cat <<EOF > check_metrics.py\nimport pandas as pd\nimport numpy as np\n\ndef check():\n    df = pd.read_csv('simulation_results.csv')\n    \n    # Speed metrics (during cruise mode, usually at the beginning)\n    cruise_df = df[df['mode'] == 'cruise']\n    if not cruise_df.empty:\n        target_speed = 30.0\n        # Rise time: time to reach 90% of target speed (27.0 m/s)\n        reached_90 = cruise_df[cruise_df['ego_speed'] >= 0.9 * target_speed]\n        if not reached_90.empty:\n            rise_time = reached_90.iloc[0]['time']\n            print(f\"Speed Rise Time: {rise_time}s\")\n        else:\n            print(\"Target speed (90%) not reached in cruise mode\")\n\n        max_speed = cruise_df['ego_speed'].max()\n        overshoot = (max_speed - target_speed) / target_speed * 100\n        print(f\"Speed Overshoot: {max(0, overshoot):.2f}%\")\n\n        # Steady state error (last 10s of cruise if available)\n        last_cruise = cruise_df[cruise_df['time'] > cruise_df['time'].max() - 10]\n        ss_error_speed = np.abs(last_cruise['ego_speed'] - target_speed).mean()\n        print(f\"Speed SS Error: {ss_error_speed:.2f} m/s\")\n\n    # Distance metrics (during follow mode)\n    follow_df = df[df['mode'] == 'follow']\n    if not follow_df.empty:\n        # Distance SS error\n        # We need to calculate the actual distance error as distance - safe_distance\n        # But distance_error is already in the CSV\n        # Wait, the CSV might have empty strings for distance_error where it's not applicable.\n        dist_errs = pd.to_numeric(follow_df['distance_error'], errors='coerce').dropna()\n        ss_error_dist = np.abs(dist_errs).mean()\n        print(f\"Distance SS Error: {ss_error_dist:.2f} m\")\n\n        min_dist = pd.to_numeric(df['distance'], errors='coerce').min()\n        print(f\"Minimum Distance: {min_dist:.2f} m\")\n\ncheck()\nEOF\npython3 check_metrics.py\n"]
