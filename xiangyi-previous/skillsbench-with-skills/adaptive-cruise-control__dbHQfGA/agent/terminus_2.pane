[?2004hroot@b544bb5f2e92:~# cat <<EOF > simulation.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import yaml
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from acc_system import AdaptiveCruiseControl
[?2004l[?2004h> 
[?2004l[?2004h> def run_simulation():
[?2004l[?2004h>     with open('vehicle_params.yaml', 'r') as f:
[?2004l[?2004h>         config = yaml.safe_load(f)
[?2004l[?2004h>     try:
[?2004l[?2004h>         with open('tuning_results.yaml', 'r') as f:
[?2004l[?2004h>             tuning = yaml.safe_load(f)
[?2004l[?2004h>         config['pid_speed'].update(tuning['pid_speed'])
[?2004l[?2004h>         config['pid_distance'].update(tuning['pid_distance'])
[?2004l[?2004h>     except FileNotFoundError:
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h>     sensor_data = pd.read_csv('sensor_data.csv')
[?2004l[?2004h>     acc = AdaptiveCruiseControl(config)
[?2004l[?2004h>     dt = config['simulation']['dt']
[?2004l[?2004h> 
[?2004l[?2004h>     results = []
[?2004l[?2004h>     my_ego_speed = 0.0
[?2004l[?2004h>     my_ego_pos = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     # We need to reconstruct the lead vehicle's position
[?2004l[?2004h>     # The CSV gives us ego_speed(csv) and distance(csv)
[?2004l[?2004h>     # We can integrate ego_speed(csv) to get ego_pos(csv)
[?2004l[?2004h>     csv_ego_pos = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     for i, row in sensor_data.iterrows():
[?2004l[?2004h>         time = row['time']
[?2004l[?2004h>         csv_ego_speed = row['ego_speed']
[?2004l[?2004h>         csv_lead_speed = row['lead_speed']
[?2004l[?2004h>         csv_distance = row['distance']
[?2004l[?2004h> 
[?2004l[?2004h>         # Lead vehicle absolute position and speed
[?2004l[?2004h>         if not np.isnan(csv_distance):
[?2004l[?2004h>             lead_pos = csv_ego_pos + csv_distance
[?2004l[?2004h>             lead_speed = csv_lead_speed
[?2004l[?2004h>             
[?2004l[?2004h>             # My distance to lead vehicle
[?2004l[?2004h>             my_distance = lead_pos - my_ego_pos
[?2004l[?2004h>         else:
[?2004l[?2004h>             lead_speed = None
[?2004l[?2004h>             my_distance = None
[?2004l[?2004h> 
[?2004l[?2004h>         accel_cmd, mode, dist_err = acc.compute(my_ego_speed, lead_speed, my_distance, dt)
[?2004l[?2004h>         
[?2004l[?2004h>         ttc = None
[?2004l[?2004h>         if my_distance is not None and lead_speed is not None:
[?2004l[?2004h>             rel_speed = my_ego_speed - lead_speed
[?2004l[?2004h>             if rel_speed > 0:
[?2004l[?2004h>                 ttc = my_distance / rel_speed
[?2004l[?2004h> 
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': time,
[?2004l[?2004h>             'ego_speed': round(my_ego_speed, 2),
[?2004l[?2004h>             'acceleration_cmd': round(accel_cmd, 2),
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': round(dist_err, 2) if dist_err is not None else '',
[?2004l[?2004h>             'distance': round(my_distance, 2) if my_distance is not None else '',
[?2004l[?2004h>             'ttc': round(ttc, 2) if ttc is not None else ''
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h>         # Update my ego state
[?2004l[?2004h>         my_ego_pos += my_ego_speed * dt + 0.5 * accel_cmd * dt**2
[?2004l[?2004h>         my_ego_speed += accel_cmd * dt
[?2004l[?2004h>         my_ego_speed = max(0, my_ego_speed)
[?2004l[?2004h> 
[?2004l[?2004h>         # Update CSV ego position for next step
[?2004l[?2004h>         csv_ego_pos += csv_ego_speed * dt
[?2004l[?2004h> 
[?2004l[?2004h>     df_results = pd.DataFrame(results)
[?2004l[?2004h>     df_results.to_csv('simulation_results.csv', index=False)
[?2004l[?2004h>     print("Simulation complete. Results saved to simulation_results.csv")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     run_simulation()
[?2004l[?2004h> EOF
