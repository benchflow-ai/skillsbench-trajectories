[?2004l[?2004h>         lead_speed = row['lead_speed']
[?2004l[?2004h>         distance = row['distance']
[?2004l[?2004h> 
[?2004l[?2004h>         # In a real simulation, ego_speed at t=0 is 0.0.
[?2004l[?2004h>         # The sensor_data.csv ego_speed might be different if it's from real-world driving,
[?2004l[?2004h>         # but the task says "initial speed ~0 m/s".
[?2004l[?2004h>         # We should use our own ego_speed state.
[?2004l[?2004h>         
[?2004l[?2004h>         accel_cmd, mode, dist_err = acc.compute(ego_speed, lead_speed, distance, dt)
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate TTC for logging
[?2004l[?2004h>         ttc = None
[?2004l[?2004h>         if distance is not None and not np.isnan(distance) and lead_speed is not None and not np.isnan(lead_speed):
[?2004l[?2004h>             rel_speed = ego_speed - lead_speed
[?2004l[?2004h>             if rel_speed > 0:
[?2004l[?2004h>                 ttc = distance / rel_speed
[?2004l[?2004h> 
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'time': time,
[?2004l[?2004h>             'ego_speed': round(ego_speed, 2),
[?2004l[?2004h>             'acceleration_cmd': round(accel_cmd, 2),
[?2004l[?2004h>             'mode': mode,
[?2004l[?2004h>             'distance_error': round(dist_err, 2) if dist_err is not None else '',
[?2004l[?2004h>             'distance': round(distance, 2) if not np.isnan(distance) else '',
[?2004l[?2004h>             'ttc': round(ttc, 2) if ttc is not None else ''
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h>         # Update ego speed for next step
[?2004l[?2004h>         ego_speed += accel_cmd * dt
[?2004l[?2004h>         ego_speed = max(0, ego_speed) # Speed cannot be negative
[?2004l[?2004h> 
[?2004l[?2004h>     # Save results
[?2004l[?2004h>     df_results = pd.DataFrame(results)
[?2004l[?2004h>     df_results.to_csv('simulation_results.csv', index=False)
[?2004l[?2004h>     print("Simulation complete. Results saved to simulation_results.csv")
