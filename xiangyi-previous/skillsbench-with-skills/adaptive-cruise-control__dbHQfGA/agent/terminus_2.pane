[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def check():
[?2004l[?2004h>     df = pd.read_csv('simulation_results.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Speed metrics (during cruise mode)
[?2004l[?2004h>     cruise_df = df[df['mode'] == 'cruise']
[?2004l[?2004h>     if not cruise_df.empty:
[?2004l[?2004h>         target_speed = 30.0
[?2004l[?2004h>         reached_90 = cruise_df[cruise_df['ego_speed'] >= 0.9 * target_speed]
[?2004l[?2004h>         if not reached_90.empty:
[?2004l[?2004h>             rise_time = reached_90.iloc[0]['time']
[?2004l[?2004h>             print(f"Speed Rise Time: {rise_time}s")
[?2004l[?2004h>         
[?2004l[?2004h>         max_speed = cruise_df['ego_speed'].max()
[?2004l[?2004h>         overshoot = (max_speed - target_speed) / target_speed * 100
[?2004l[?2004h>         print(f"Speed Overshoot: {max(0, overshoot):.2f}%")
[?2004l[?2004h> 
[?2004l[?2004h>         last_cruise = cruise_df[cruise_df['time'] > cruise_df['time'].max() - 2]
[?2004l[?2004h>         ss_error_speed = np.abs(last_cruise['ego_speed'] - target_speed).mean()
[?2004l[?2004h>         print(f"Speed SS Error: {ss_error_speed:.2f} m/s")
[?2004l[?2004h> 
[?2004l[?2004h>     # Distance metrics (during follow mode)
[?2004l[?2004h>     # Only consider follow mode where we are actually following (ego_speed < set_speed - 0.5)
[?2004l[?2004h>     follow_df = df[(df['mode'] == 'follow') & (df['ego_speed'] < 29.5)]
[?2004l[?2004h>     if not follow_df.empty:
[?2004l[?2004h>         dist_errs = pd.to_numeric(follow_df['distance_error'], errors='coerce').dropna()
[?2004l[?2004h>         ss_error_dist = np.abs(dist_errs).mean()
[?2004l[?2004h>         print(f"Distance SS Error (Filtered): {ss_error_dist:.2f} m")
[?2004l[?2004h>     else:
[?2004l[?2004h>         print("No stable follow mode detected (ego_speed < 29.5)")
[?2004l[?2004h> 
[?2004l[?2004h>     min_dist = pd.to_numeric(df['distance'], errors='coerce').min()
[?2004l[?2004h>     print(f"Minimum Distance: {min_dist:.2f} m")
[?2004l[?2004h> 
[?2004l[?2004h> check()
