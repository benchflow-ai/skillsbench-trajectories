[?2004l[?2004h> from pid_controller import PIDController
[?2004l[?2004h> 
[?2004l[?2004h> class AdaptiveCruiseControl:
[?2004l[?2004h>     def __init__(self, config):
[?2004l[?2004h>         self.config = config
[?2004l[?2004h>         self.set_speed = config['acc_settings']['set_speed']
[?2004l[?2004h>         self.time_headway = config['acc_settings']['time_headway']
[?2004l[?2004h>         self.min_distance = config['acc_settings']['min_distance']
[?2004l[?2004h>         self.emergency_ttc_threshold = config['acc_settings']['emergency_ttc_threshold']
[?2004l[?2004h>         self.max_accel = config['vehicle']['max_acceleration']
[?2004l[?2004h>         self.max_decel = config['vehicle']['max_deceleration']
[?2004l[?2004h> 
[?2004l[?2004h>         self.pid_speed = PIDController(
[?2004l[?2004h>             config['pid_speed']['kp'],
[?2004l[?2004h>             config['pid_speed']['ki'],
[?2004l[?2004h>             config['pid_speed']['kd'],
[?2004l[?2004h>             output_limits=(self.max_decel, self.max_accel)
[?2004l[?2004h>         )
[?2004l[?2004h>         self.pid_distance = PIDController(
[?2004l[?2004h>             config['pid_distance']['kp'],
[?2004l[?2004h>             config['pid_distance']['ki'],
[?2004l[?2004h>             config['pid_distance']['kd'],
[?2004l[?2004h>             output_limits=(self.max_decel, self.max_accel)
[?2004l[?2004h>         )
[?2004l[?2004h> 
[?2004l[?2004h>     def compute(self, ego_speed, lead_speed, distance, dt):
[?2004l[?2004h>         mode = 'cruise'
[?2004l[?2004h>         acceleration_cmd = 0.0
[?2004l[?2004h>         distance_error = None
[?2004l[?2004h> 
[?2004l[?2004h>         # Always compute speed-based acceleration
[?2004l[?2004h>         speed_error = self.set_speed - ego_speed
[?2004l[?2004h>         accel_speed = self.pid_speed.compute(speed_error, dt)
[?2004l[?2004h> 
[?2004l[?2004h>         if distance is not None and not (isinstance(distance, float) and distance != distance): 
[?2004l[?2004h>             # Lead vehicle detected
[?2004l[?2004h>             safe_distance = self.min_distance + self.time_headway * ego_speed
[?2004l[?2004h>             distance_error = distance - safe_distance
[?2004l[?2004h>             
[?2004l[?2004h>             relative_speed = ego_speed - lead_speed
[?2004l[?2004h>             ttc = float('inf')
[?2004l[?2004h>             if relative_speed > 0:
[?2004l[?2004h>                 ttc = distance / relative_speed
[?2004l[?2004h> 
[?2004l[?2004h>             if ttc < self.emergency_ttc_threshold:
[?2004l[?2004h>                 mode = 'emergency'
[?2004l[?2004h>                 acceleration_cmd = self.max_decel
[?2004l[?2004h>                 self.pid_speed.reset()
[?2004l[?2004h>                 self.pid_distance.reset()
[?2004l[?2004h>             else:
[?2004l[?2004h>                 mode = 'follow'
[?2004l[?2004h>                 accel_dist = self.pid_distance.compute(distance_error, dt)
[?2004l[?2004h>                 # Use the more conservative acceleration
[?2004l[?2004h>                 acceleration_cmd = min(accel_speed, accel_dist)
[?2004l[?2004h>         else:
[?2004l[?2004h>             # No lead vehicle
[?2004l[?2004h>             mode = 'cruise'
[?2004l[?2004h>             acceleration_cmd = accel_speed
[?2004l[?2004h>             self.pid_distance.reset()
[?2004l[?2004h> 
[?2004l[?2004h>         # Apply acceleration limits
[?2004l[?2004h>         acceleration_cmd = max(self.max_decel, min(self.max_accel, acceleration_cmd))
[?2004l[?2004h> 
[?2004l[?2004h>         return acceleration_cmd, mode, distance_error
