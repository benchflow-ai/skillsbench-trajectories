[?2004l[?2004h> class PIDController:
[?2004l[?2004h>     def __init__(self, kp, ki, kd, output_limits=(None, None)):
[?2004l[?2004h>         self.kp = kp
[?2004l[?2004h>         self.ki = ki
[?2004l[?2004h>         self.kd = kd
[?2004l[?2004h>         self.output_limits = output_limits
[?2004l[?2004h>         self.integral = 0
[?2004l[?2004h>         self.prev_error = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def reset(self):
[?2004l[?2004h>         self.integral = 0
[?2004l[?2004h>         self.prev_error = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def compute(self, error, dt):
[?2004l[?2004h>         if dt <= 0:
[?2004l[?2004h>             return 0
[?2004l[?2004h>         
[?2004l[?2004h>         # Proportional term
[?2004l[?2004h>         p = self.kp * error
[?2004l[?2004h>         
[?2004l[?2004h>         # Integral term
[?2004l[?2004h>         self.integral += error * dt
[?2004l[?2004h>         i = self.ki * self.integral
[?2004l[?2004h>         
[?2004l[?2004h>         # Derivative term
[?2004l[?2004h>         derivative = (error - self.prev_error) / dt
[?2004l[?2004h>         d = self.kd * derivative
[?2004l[?2004h>         self.prev_error = error
[?2004l[?2004h>         
[?2004l[?2004h>         output = p + i + d
[?2004l[?2004h>         
[?2004l[?2004h>         # Anti-windup
[?2004l[?2004h>         lower, upper = self.output_limits
[?2004l[?2004h>         if lower is not None or upper is not None:
[?2004l[?2004h>             if upper is not None and output > upper:
[?2004l[?2004h>                 # If output is saturated, we stop integrating if the error has the same sign
[?2004l[?2004h>                 if error > 0:
[?2004l[?2004h>                     self.integral -= error * dt
[?2004l[?2004h>                 output = upper
[?2004l[?2004h>             elif lower is not None and output < lower:
[?2004l[?2004h>                 if error < 0:
[?2004l[?2004h>                     self.integral -= error * dt
[?2004l[?2004h>                 output = lower
[?2004l[?2004h>                 
[?2004l[?2004h>         return output
[?2004l[?2004h> EOF
