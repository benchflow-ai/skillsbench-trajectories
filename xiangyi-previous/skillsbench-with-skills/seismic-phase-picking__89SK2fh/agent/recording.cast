[94.088874, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.089194, "o", ">         if len(early_triggers) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.089247, "o", "            p_picks.append(early_triggers[0])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # For S-wave: use horizontal components, lower frequency"]
[94.089369, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.089706, "o", "    sos_s = signal.butter(4, [1, 10], btype='band', fs=fs, output='sos')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.089793, "o", "    horizontal_1 = signal.sosfilt(sos_s, trace_data[:, 0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.090003, "o", "    horizontal_2 = signal.sosfilt(sos_s, trace_data[:, 1])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[94.09009, "o", "\u001b[?2004h> "]
[94.090289, "o", "    # Combine horizontal components\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.090453, "o", "    horizontal_combined = np.sqrt(horizontal_1**2 + horizontal_2**2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.090618, "o", "    # Calculate STA/LTA for S-wave\r\n\u001b[?2004l\r"]
[94.090778, "o", "\u001b[?2004h> "]
[94.090921, "o", "    cf_s = sta_lta(horizontal_combined, int(sta_s/dt), int(lta_s/dt))\r\n\u001b[?2004l\r"]
[94.090956, "o", "\u001b[?2004h> "]
[94.0914, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Pick S-wave arrivals (should be after P-wave)\r\n\u001b[?2004l\r\u001b[?2004h>     s_picks = []\r\n\u001b[?2004l\r\u001b[?2004h>     above_threshold_s = cf_s > threshold_s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.091739, "o", "    triggers_s = np.where(np.diff(above_threshold_s.astype(int)) == 1)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.091777, "o", "    # S-wave should come after P-wave\r\n\u001b[?2004l\r"]
[94.091806, "o", "\u001b[?2004h> "]
[94.092058, "o", "    search_start = p_picks[0] + int(0.2/dt) if len(p_picks) > 0 else int(0.5/dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.09209, "o", "    \r\n\u001b[?2004l\r"]
[94.092362, "o", "\u001b[?2004h> "]
[94.092552, "o", "    for trigger in triggers_s:\r\n\u001b[?2004l\r\u001b[?2004h>         if trigger > search_start and trigger < len(cf_s) - int(1.0/dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.092591, "o", "            s_picks.append(trigger)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.092815, "o", "            break  # Take first good S-wave pick\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[94.092851, "o", "> "]
[94.093061, "o", "    return p_picks, s_picks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Test on one file\r\n\u001b[?2004l\r"]
[94.093195, "o", "\u001b[?2004h> "]
[94.093531, "o", "sample_file = '/root/data/BG.ACR..DP.0215954.npz'\r\n\u001b[?2004l\r\u001b[?2004h> data = np.load(sample_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.093726, "o", "trace = data['data']\r\n\u001b[?2004l\r\u001b[?2004h> dt = float(data['dt'])"]
[94.093771, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.093807, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[94.093836, "o", "> "]
[94.094173, "o", "p_picks, s_picks = pick_phases(trace, dt)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"P picks: {p_picks}\")"]
[94.094212, "o", "\r\n\u001b[?2004l\r"]
[94.094438, "o", "\u001b[?2004h> print(f\"S picks: {s_picks}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.094514, "o", "print(f\"Trace length: {len(trace)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.09471, "o", "print(f\"Sampling rate: {1/dt} Hz\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.094745, "o", "EOF\r\n\u001b[?2004l\r"]
