[?2004l[?2004h> 
[?2004lr[?2004h> def fuzzy_match(str1, str2, threshold=0.85):
[?2004l[?2004h>     """Return True if strings are similar enough (handles typos and variations)"""
[?2004l[?2004h>     # Normalize strings: lowercase, remove extra spaces
[?2004l[?2004h>     s1 = ' '.join(str1.lower().split())
[?2004l[?2004h>     s2 = ' '.join(str2.lower().split())
[?2004l[?2004h>     
[?2004l[?2004h>     # Direct match
[?2004l[?2004h>     if s1 == s2:
[?2004lce[?2004h>         return True
[?2004l[?2004h>     
[?2004l[?2004h>     # Check similarity ratio
[?2004l[?2004h>     ratio = SequenceMatcher(None, s1, s2).ratio()
[?2004l[?2004h>     if ratio >= threshold:
[?2004l[?2004h>         return True
[?2004l[?2004h>     
[?2004l[?2004h>     # Handle common variations (Ltd vs Limited, Inc vs Incorporated, etc.)
[?2004l[?2004h>     variations = [
[?2004l[?2004h>         ('limited', 'ltd'),
[?2004l[?2004h>         ('incorporated', 'inc'),
[?2004l[?2004h>         ('corporation', 'corp'),
[?2004l[?2004h>         ('company', 'co'),
[?2004l[?2004h>     ]
[?2004l [?2004h>     
[?2004l [?2004h>     for full, abbr in variations:
[?2004l[?2004h>         s1_var = s1.replace(full, abbr).replace(abbr, full)
[?2004l[?2004h>         s2_var = s2.replace(full, abbr).replace(abbr, full)
[?2004l[?2004h>         if s1_var == s2 or s2_var == s1:
[?2004l[?2004h>             return True
[?2004l[?2004h>     
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> def find_vendor_by_name(vendor_name, vendors_df):
[?2004l[?2004h>     """Find vendor by fuzzy matching name, return vendor row or None"""
[?2004l[?2004h>     for idx, row in vendors_df.iterrows():
[?2004l[?2004h>         if fuzzy_match(vendor_name, row['name']):
[?2004l[?2004h>             return row
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def extract_invoices_from_pdf(pdf_path):
[?2004l[?2004h>     """Extract invoice data from PDF"""
[?2004l[?2004h>     invoices = []
[?2004l[?2004h>     
[?2004l[?2004h>     with pdfplumber.open(pdf_path) as pdf:
[?2004l[?2004h>         for page_num, page in enumerate(pdf.pages, start=1):
[?2004l[?2004h>             text = page.extract_text()
[?2004l[?2004h>             
[?2004l[?2004h>             # Parse invoice fields
[?2004l[?2004h>             vendor_match = re.search(r'From:\s*(.+)', text)
[?2004l[?2004h>             amount_match = re.search(r'Total\s+\$([\d,]+\.\d{2})', text)
[?2004l[?2004h>             iban_match = re.search(r'Payment IBAN:\s*(.+)', text)
[?2004l[?2004h>             po_match = re.search(r'PO Number:\s*(.+)', text)
[?2004l[?2004h>             
[?2004l[?2004h>             if vendor_match and amount_match and iban_match:
[?2004l[?2004h>                 vendor_name = vendor_match.group(1).strip()
[?2004l[?2004h>                 amount = float(amount_match.group(1).replace(',', ''))
[?2004l[?2004h>                 iban = iban_match.group(1).strip()
[?2004l[?2004h>                 po_number = po_match.group(1).strip() if po_match else None
[?2004l[?2004h>                 
[?2004l[?2004h>                 invoices.append({
[?2004l[?2004h>                     'page_number': page_num,
[?2004l[?2004h>                     'vendor_name': vendor_name,
[?2004l[?2004h>                     'amount': amount,
[?2004l[?2004h>                     'iban': iban,
[?2004l[?2004h>                     'po_number': po_number
[?2004l[?2004h>                 })
[?2004l[?2004h>     
[?2004l[?2004h>     return invoices
[?2004l[?2004h> 
[?2004l[?2004h> def detect_fraud(invoices, vendors_df, pos_df):
[?2004l[?2004h>     """Detect fraudulent invoices based on criteria"""
[?2004l[?2004h>     fraudulent = []
[?2004l[?2004h>     
[?2004l[?2004h>     for invoice in invoices:
