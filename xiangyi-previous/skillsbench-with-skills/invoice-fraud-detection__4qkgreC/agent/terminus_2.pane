[?2004l[?2004h> def normalize_and_create_variations(name):
[?2004l[?2004h>     """Create variations of vendor name for fuzzy matching"""
[?2004l[?2004h>     # Remove periods and normalize whitespace
[?2004l[?2004h>     normalized = ' '.join(name.replace('.', '').lower().split())
[?2004l[?2004h>     
[?2004l[?2004h>     # Common suffixes to handle
[?2004l[?2004h>     suffixes = ['limited', 'ltd', 'incorporated', 'inc', 'corporation', 'corp', 'company', 'co']
[?2004l[?2004h>     
[?2004l[?2004h>     variations = [normalized]
[?2004l[?2004h>     
[?2004l[?2004h>     # For each suffix, create variations with it removed
[?2004l[?2004h>     for suffix in suffixes:
[?2004l[?2004h>         # Try removing the suffix from the end
[?2004l[?2004h>         if normalized.endswith(' ' + suffix):
[?2004l[?2004h>             base = normalized[:-len(suffix)-1].strip()
[?2004l[?2004h>             variations.append(base)
[?2004l[?2004h>             
[?2004l[?2004h>             # Also add variations with other suffixes
[?2004l[?2004h>             for other_suffix in suffixes:
[?2004l[?2004h>                 if other_suffix != suffix:
[?2004l[?2004h>                     variations.append(base + ' ' + other_suffix)
[?2004l[?2004h>     
[?2004l[?2004h>     return list(set(variations))  # Remove duplicates
[?2004l[?2004h> 
[?2004l[?2004h> def find_vendor_by_name(vendor_name, vendors_df):
[?2004l[?2004h>     """Find vendor by fuzzy matching name, return vendor row or None"""
[?2004l[?2004h>     # First try exact match (case-insensitive, no periods)
[?2004l[?2004h>     normalized_invoice = ' '.join(vendor_name.replace('.', '').lower().split())
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, row in vendors_df.iterrows():
[?2004l[?2004h>         normalized_vendor = ' '.join(row['name'].replace('.', '').lower().split())
[?2004l[?2004h>         if normalized_invoice == normalized_vendor:
[?2004l[?2004h>             return row
[?2004l[?2004h>     
[?2004ln[?2004h>     # Then try variations
[?2004l[?2004h>     invoice_variations = normalize_and_create_variations(vendor_name)
[?2004l[?2004h>     
[?2004l.[?2004h>     for idx, row in vendors_df.iterrows():
[?2004l[?2004h>         vendor_variations = normalize_and_create_variations(row['name'])
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if any variation matches
[?2004l[?2004h>         for inv_var in invoice_variations:
[?2004l[?2004h>             for vend_var in vendor_variations:
[?2004l[?2004h>                 if inv_var == vend_var:
[?2004l[?2004h>                     return row
[?2004l[?2004h>                 # Also check high similarity for typos
[?2004l[?2004h>                 ratio = SequenceMatcher(None, inv_var, vend_var).ratio()
[?2004l[?2004h>                 if ratio >= 0.95:
[?2004l[?2004h>                     return row
[?2004l[?2004h>     
[?2004l[?2004h>     return None
