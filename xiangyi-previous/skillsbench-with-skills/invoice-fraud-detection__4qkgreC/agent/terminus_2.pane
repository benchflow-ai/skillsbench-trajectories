[?2004l[?2004h> 
[?2004l[?2004h> def normalize_vendor_name(name):
[?2004l[?2004h>     """Normalize vendor name for comparison"""
[?2004l[?2004h>     # Convert to lowercase and normalize whitespace
[?2004l[?2004h>     normalized = ' '.join(name.lower().split())
[?2004l[?2004h>     
[?2004l[?2004h>     # Apply common variations
[?2004l[?2004h>     replacements = [
[?2004l[?2004h>         ('limited', 'ltd'),
[?2004l[?2004h>         ('incorporated', 'inc'),
[?2004l[?2004h>         ('corporation', 'corp'),
[?2004lv[?2004h>         ('company', 'co'),
[?2004l[?2004h>     ]
[?2004lpo[?2004h>     
[?2004lb[?2004h>     # Create variations
[?2004l[?2004h>     variations = [normalized]
[?2004l[?2004h>     for full, abbr in replacements:
[?2004l[?2004h>         if full in normalized:
[?2004l[?2004h>             variations.append(normalized.replace(full, abbr))
[?2004lf[?2004h>         if abbr in normalized:
[?2004lrs[?2004h>             variations.append(normalized.replace(abbr, full))
[?2004l[?2004h>     
[?2004l[?2004h>     return variations
[?2004l[?2004h> 
[?2004l
[?2004h> def find_vendor_by_name(vendor_name, vendors_df):
[?2004l[?2004h>     """Find vendor by fuzzy matching name, return vendor row or None"""
[?2004l[?2004h>     # First try exact match (case-insensitive)
[?2004l[?2004h>     for idx, row in vendors_df.iterrows():
[?2004l[?2004h>         if vendor_name.lower().strip() == row['name'].lower().strip():
[?2004l[?2004h>             return row
[?2004l[?2004h>     
[?2004l[?2004h>     # Then try normalized variations
[?2004l[?2004h>     invoice_variations = normalize_vendor_name(vendor_name)
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, row in vendors_df.iterrows():
[?2004l[?2004h>         vendor_variations = normalize_vendor_name(row['name'])
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if any variation matches
[?2004l[?2004h>         for inv_var in invoice_variations:
[?2004l[?2004h>             for vend_var in vendor_variations:
[?2004l[?2004h>                 if inv_var == vend_var:
[?2004l[?2004h>                     return row
[?2004l[?2004h>                 # Also check high similarity for typos
[?2004l[?2004h>                 ratio = SequenceMatcher(None, inv_var, vend_var).ratio()
[?2004l[?2004h>                 if ratio >= 0.95:  # Very high threshold for safety
[?2004l[?2004h>                     return row
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
