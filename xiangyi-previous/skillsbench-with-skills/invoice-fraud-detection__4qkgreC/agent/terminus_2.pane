[?2004l[?2004h> def detect_fraud(invoices, vendors_df, pos_df):
[?2004l[?2004h>     """Detect fraudulent invoices based on criteria"""
[?2004l[?2004h>     fraudulent = []
[?2004l[?2004h>     
[?2004l[?2004h>     for invoice in invoices:
[?2004l[?2004h>         fraud_reason = None
[?2004l[?2004h>         
[?2004l[?2004h>         # Criterion 1: Unknown Vendor
[?2004l[?2004h>         vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)
[?2004l[?2004h>         if vendor is None:
[?2004l[?2004h>             fraud_reason = "Unknown Vendor"
[?2004l[?2004h>         
[?2004l[?2004h>         # Criterion 2: IBAN Mismatch (only if vendor exists)
[?2004l[?2004h>         elif invoice['iban'] != vendor['iban']:
[?2004l[?2004h>             fraud_reason = "IBAN Mismatch"
[?2004l[?2004h>         
[?2004l[?2004h>         # Check PO-related criteria only if we have a PO number
[?2004l[?2004h>         elif invoice['po_number'] is not None:
[?2004l[?2004h>             po = pos_df[pos_df['po_number'] == invoice['po_number']]
[?2004l[?2004h>             
[?2004l[?2004h>             # Criterion 3: Invalid PO
[?2004l[?2004h>             if po.empty:
[?2004l[?2004h>                 fraud_reason = "Invalid PO"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 po_row = po.iloc[0]
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Criterion 4: Amount Mismatch
[?2004l[?2004h>                 if abs(invoice['amount'] - po_row['amount']) > 0.01:
[?2004l[?2004h>                     fraud_reason = "Amount Mismatch"
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Criterion 5: Vendor Mismatch
[?2004l[?2004h>                 elif vendor['id'] != po_row['vendor_id']:
[?2004l[?2004h>                     fraud_reason = "Vendor Mismatch"
[?2004l[?2004h>         
[?2004l[?2004h>         # Add to fraudulent list if any criterion matched
[?2004l[?2004h>         if fraud_reason:
[?2004l[?2004h>             fraudulent.append({
[?2004l[?2004h>                 'invoice_page_number': invoice['page_number'],
[?2004l[?2004h>                 'vendor_name': invoice['vendor_name'],
[?2004l[?2004h>                 'invoice_amount': invoice['amount'],
[?2004l[?2004h>                 'iban': invoice['iban'],
[?2004l[?2004h>                 'po_number': invoice['po_number'],
[?2004l[?2004h>                 'reason': fraud_reason
[?2004l[?2004h>             })
[?2004l[?2004h>     
[?2004l[?2004h>     return fraudulent
[?2004l[?2004h> 
[?2004l[?2004h> # Main execution
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     vendors_df = pd.read_excel('/root/vendors.xlsx')
[?2004l[?2004h>     pos_df = pd.read_csv('/root/purchase_orders.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract invoices
[?2004l[?2004h>     print("Extracting invoices from PDF...")
[?2004l[?2004h>     invoices = extract_invoices_from_pdf('/root/invoices.pdf')
[?2004l[?2004h>     print(f"Extracted {len(invoices)} invoices")
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect fraud
