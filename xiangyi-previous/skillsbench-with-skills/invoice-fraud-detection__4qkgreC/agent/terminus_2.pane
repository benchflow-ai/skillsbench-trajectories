[?2004l[?2004h>             
[?2004l[?2004h>             # Parse invoice fields
[?2004l[?2004h>             vendor_match = re.search(r'From:\s*(.+)', text)
[?2004l[?2004h>             amount_match = re.search(r'Total\s+\$([\d,]+\.\d{2})', text)
[?2004l[?2004h>             iban_match = re.search(r'Payment IBAN:\s*(.+)', text)
[?2004l[?2004h>             po_match = re.search(r'PO Number:\s*(.+)', text)
[?2004l[?2004h>             
[?2004l[?2004h>             if vendor_match and amount_match and iban_match:
[?2004l[?2004h>                 vendor_name = vendor_match.group(1).strip()
[?2004l[?2004h>                 amount = float(amount_match.group(1).replace(',', ''))
[?2004l[?2004h>                 iban = iban_match.group(1).strip()
[?2004l[?2004h>                 po_number = po_match.group(1).strip() if po_match else None
[?2004l[?2004h>                 
[?2004l[?2004h>                 invoices.append({
[?2004l[?2004h>                     'page_number': page_num,
[?2004l[?2004h>                     'vendor_name': vendor_name,
[?2004l[?2004h>                     'amount': amount,
[?2004l[?2004h>                     'iban': iban,
[?2004l[?2004h>                     'po_number': po_number
[?2004l[?2004h>                 })
[?2004l[?2004h>     
[?2004l[?2004h>     return invoices
