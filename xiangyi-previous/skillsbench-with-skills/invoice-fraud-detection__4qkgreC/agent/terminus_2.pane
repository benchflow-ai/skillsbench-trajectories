[?2004l[?2004h>         
[?2004l[?2004h>         # Criterion 1: Unknown Vendor
[?2004l[?2004h>         vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)
[?2004l[?2004h>         if vendor is None:
[?2004l[?2004h>             fraud_reason = "Unknown Vendor"
[?2004l[?2004h>         
[?2004l[?2004h>         # Criterion 2: IBAN Mismatch (only if vendor exists)
[?2004l[?2004h>         elif invoice['iban'] != vendor['iban']:
[?2004l[?2004h>             fraud_reason = "IBAN Mismatch"
[?2004l[?2004h>         
[?2004l[?2004h>         # Check PO-related criteria only if we have a PO number
[?2004l[?2004h>         elif invoice['po_number'] is not None:
[?2004l[?2004h>             po = pos_df[pos_df['po_number'] == invoice['po_number']]
[?2004l[?2004h>             
[?2004l[?2004h>             # Criterion 3: Invalid PO
[?2004l[?2004h>             if po.empty:
[?2004l[?2004h>                 fraud_reason = "Invalid PO"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 po_row = po.iloc[0]
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Criterion 4: Amount Mismatch
[?2004l[?2004h>                 if abs(invoice['amount'] - po_row['amount']) > 0.01:
[?2004l[?2004h>                     fraud_reason = "Amount Mismatch"
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Criterion 5: Vendor Mismatch
[?2004l[?2004h>                 elif vendor['id'] != po_row['vendor_id']:
[?2004l[?2004h>                     fraud_reason = "Vendor Mismatch"
[?2004l[?2004h>         
[?2004l[?2004h>         # Add to fraudulent list if any criterion matched
[?2004l[?2004h>         if fraud_reason:
[?2004l[?2004h>             fraudulent.append({
