[?2004l[?2004h>                 'vendor_name': invoice['vendor_name'],
[?2004l[?2004h>                 'invoice_amount': invoice['amount'],
[?2004l[?2004h>                 'iban': invoice['iban'],
[?2004l[?2004h>                 'po_number': invoice['po_number'],
[?2004l[?2004h>                 'reason': fraud_reason
[?2004l[?2004h>             })
[?2004l[?2004h>     
[?2004l[?2004h>     return fraudulent
