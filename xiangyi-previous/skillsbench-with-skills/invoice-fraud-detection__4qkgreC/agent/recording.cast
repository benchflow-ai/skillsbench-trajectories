[188.53788, "i", "python3 << 'EOF'\nimport pandas as pd\nimport pdfplumber\nimport re\nfrom difflib import SequenceMatcher\n\ndef fuzzy_match(str1, str2, threshold=0.85):\n    s1 = ' '.join(str1.lower().split())\n    s2 = ' '.join(str2.lower().split())\n    if s1 == s2:\n        return True\n    ratio = SequenceMatcher(None, s1, s2).ratio()\n    return ratio >= threshold\n\ndef find_vendor_by_name(vendor_name, vendors_df):\n    for idx, row in vendors_df.iterrows():\n        if fuzzy_match(vendor_name, row['name']):\n            return row\n    return None\n\n# Load data\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npos_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Extract page 2 invoice\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    text = pdf.pages[1].extract_text()\n\nvendor_match = re.search(r'From:\\s*(.+)', text)\namount_match = re.search(r'Total\\s+\\$([\\d,]+\\.\\d{2})', text)\niban_match = re.search(r'Payment IBAN:\\s*(.+)', text)\npo_match = re.search(r'PO Number:\\s*(.+)', text)\n\nvendor_name = vendor_match.group(1).strip()\namount = float(amount_match.group(1).replace(',', ''))\niban = iban_match.group(1).strip()\npo_number = po_match.group(1).strip()\n\nprint(f\"Invoice Page 2:\")\nprint(f\"  Vendor Name: {vendor_name}\")\nprint(f\"  Amount: {amount}\")\nprint(f\"  IBAN: {iban}\")\nprint(f\"  PO: {po_number}\")\n\n# Step through fraud detection\nprint(f\"\\nFraud Detection Steps:\")\n\n# Step 1: Find vendor\nvendor = find_vendor_by_name(vendor_name, vendors_df)\nif vendor is None:\n    print(f\"1. Unknown Vendor: YES - STOP\")\nelse:\n    print(f\"1. Unknown Vendor: NO\")\n    print(f\"   Found vendor: {vendor['id']} - {vendor['name']} - {vendor['iban']}\")\n    \n    # Step 2: IBAN match\n    if iban != vendor['iban']:\n        print(f\"2. IBAN Mismatch: YES - STOP\")\n        print(f\"   Invoice IBAN: {iban}\")\n        print(f\"   Vendor IBAN: {vendor['iban']}\")\n    else:\n        print(f\"2. IBAN Mismatch: NO\")\n        \n        # Step 3-5: PO checks\n        if po_number:\n            po = pos_df[pos_df['po_number'] == po_number]\n            if po.empty:\n                print(f\"3. Invalid PO: YES - STOP\")\n            else:\n                print(f\"3. Invalid PO: NO\")\n                po_row = po.iloc[0]\n                print(f\"   PO: {po_row['po_number']} - Vendor {po_row['vendor_id']} - Amount {po_row['amount']}\")\n                \n                # Amount mismatch\n                if abs(amount - po_row['amount']) > 0.01:\n                    print(f\"4. Amount Mismatch: YES - STOP\")\n                    print(f\"   Invoice: {amount}, PO: {po_row['amount']}, Diff: {abs(amount - po_row['amount'])}\")\n                else:\n                    print(f\"4. Amount Mismatch: NO\")\n                    \n                    # Vendor mismatch\n                    if vendor['id'] != po_row['vendor_id']:\n                        print(f\"5. Vendor Mismatch: YES - STOP\")\n                        print(f\"   Invoice Vendor: {vendor['id']}, PO Vendor: {po_row['vendor_id']}\")\n                    else:\n                        print(f\"5. Vendor Mismatch: NO\")\n                        print(f\"   LEGITIMATE INVOICE\")\nEOF\n"]
