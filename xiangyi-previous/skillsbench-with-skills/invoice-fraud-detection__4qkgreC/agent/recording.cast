[189.390031, "o", "Invoice Page 2:\r\n  Vendor Name: Vendor 3\r\n  Amount: 8347.33\r\n  IBAN: IBAN000000003\r\n  PO: PO-1412\r\n\r\nFraud Detection Steps:\r\n"]
