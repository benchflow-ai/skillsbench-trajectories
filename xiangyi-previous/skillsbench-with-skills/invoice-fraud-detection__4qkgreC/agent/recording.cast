[273.237615, "i", "python3 << 'EOF'\nimport pandas as pd\n\nvendors_df = pd.read_excel('/root/vendors.xlsx')\n\n# Search for vendors with 'fuzzy' or 'match' or 'systems' in the name\nprint(\"Vendors containing 'fuzzy', 'match', or 'systems':\")\nfor idx, row in vendors_df.iterrows():\n    name_lower = row['name'].lower()\n    if 'fuzzy' in name_lower or 'match' in name_lower or 'system' in name_lower:\n        print(f\"  {row['id']}: {row['name']} - {row['iban']}\")\n\nprint(\"\\nTotal vendors in database:\", len(vendors_df))\nprint(\"\\nSample of vendor names:\")\nprint(vendors_df['name'].head(30).tolist())\nEOF\n"]
