[249.610826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[249.610873, "o", "\u001b[?2004h> "]
[249.610898, "o", "# Spot check one legitimate invoice\r\n\u001b[?2004l\r"]
