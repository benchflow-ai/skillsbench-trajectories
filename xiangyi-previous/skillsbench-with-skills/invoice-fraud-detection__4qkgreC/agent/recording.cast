[224.556583, "o", "Fraud report saved to /root/fraud_report.json\r\n"]
[224.662295, "o", "\u001b[?2004hroot@3b20cb8d9516:~# "]
[235.061147, "i", "python3 << 'EOF'\nimport json\n\n# Load and analyze the report\nwith open('/root/fraud_report.json') as f:\n    report = json.load(f)\n\nprint(f\"Total fraudulent invoices: {len(report)}\")\n\n# Check page 2\npage_2 = [inv for inv in report if inv['invoice_page_number'] == 2]\nif page_2:\n    print(f\"\\nPage 2:\")\n    print(json.dumps(page_2[0], indent=2))\n\n# Breakdown by reason\nprint(\"\\nFraud breakdown:\")\nreasons = {}\nfor inv in report:\n    reasons[inv['reason']] = reasons.get(inv['reason'], 0) + 1\nfor reason, count in sorted(reasons.items()):\n    print(f\"  {reason}: {count}\")\n\n# Show samples of each fraud type\nprint(\"\\nSample of each fraud type:\")\nfor reason in sorted(reasons.keys()):\n    sample = next((inv for inv in report if inv['reason'] == reason), None)\n    if sample:\n        print(f\"\\n{reason}:\")\n        print(f\"  Page {sample['invoice_page_number']}: {sample['vendor_name']} - ${sample['invoice_amount']} - PO: {sample['po_number']}\")\nEOF\n"]
