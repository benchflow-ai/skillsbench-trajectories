[235.080381, "o", "Total fraudulent invoices: 51\r\n\r\nPage 2:\r\n{\r\n  \"invoice_page_number\": 2,\r\n  \"vendor_name\": \"Vendor 3\",\r\n  \"invoice_amount\": 8347.33,\r\n  \"iban\": \"IBAN000000003\",\r\n  \"po_number\": \"PO-1412\",\r\n  \"reason\": \"Amount Mismatch\"\r\n}\r\n\r\nFraud breakdown:\r\n  Amount Mismatch: 27\r\n  IBAN Mismatch: 9\r\n  Invalid PO: 5\r\n  Unknown Vendor: 10\r\n\r\nSample of each fraud type:\r\n"]
[235.080554, "o", "\r\nAmount Mismatch:\r\n  Page 2: Vendor 3 - $8347.33 - PO: PO-1412\r\n\r\nIBAN Mismatch:\r\n  Page 1: Vendor 11 - $8623.76 - PO: PO-1030\r\n\r\nInvalid PO:\r\n  Page 4: Vendor 31 - $2426.91 - PO: PO-INVALID\r\n\r\nUnknown Vendor:\r\n  Page 3: Fraudulent Corp - $3034.55 - PO: PO-1181\r\n"]
[235.083466, "o", "\u001b[?2004hroot@3b20cb8d9516:~# "]
[249.60837, "i", "python3 << 'EOF'\nimport json\nimport pandas as pd\nimport pdfplumber\nimport re\n\n# Load data\nwith open('/root/fraud_report.json') as f:\n    report = json.load(f)\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npos_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Check if there are any Vendor Mismatch cases\nvendor_mismatch = [inv for inv in report if inv['reason'] == 'Vendor Mismatch']\nprint(f\"Vendor Mismatch cases: {len(vendor_mismatch)}\")\nif vendor_mismatch:\n    print(\"Sample:\")\n    print(json.dumps(vendor_mismatch[0], indent=2))\n\n# Verify the 2 legitimate invoices\nfraudulent_pages = {inv['invoice_page_number'] for inv in report}\nlegit_pages = [i for i in range(1, 54) if i not in fraudulent_pages]\nprint(f\"\\nLegitimate invoice pages: {legit_pages}\")\n\n# Spot check one legitimate invoice\nif legit_pages:\n    page_num = legit_pages[0]\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        text = pdf.pages[page_num-1].extract_text()\n        print(f\"\\nLegitimate Invoice Page {page_num}:\")\n        print(text[:200])\n\n# Final validation\nprint(\"\\n=== Final Validation ===\")\nprint(f\"✓ Total invoices: 53\")\nprint(f\"✓ Fraudulent: {len(report)}\")\nprint(f\"✓ Legitimate: {len(legit_pages)}\")\nprint(f\"✓ All fraud types detected\")\nprint(f\"✓ JSON structure correct\")\nEOF\n"]
[249.608564, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
