[250.416233, "o", "Vendor Mismatch cases: 0\r\n\r\nLegitimate invoice pages: [51, 53]\r\n"]
[250.440334, "o", "\r\nLegitimate Invoice Page 51:\r\nInvoice Page 51\r\nFrom: Safe Vendor Ltd\r\nTotal $1000.00\r\nPayment IBAN: IBANSAFE001\r\nPO Number: PO-9001\r\n"]
[250.441049, "o", "\r\n=== Final Validation ===\r\n✓ Total invoices: 53\r\n✓ Fraudulent: 51\r\n✓ Legitimate: 2\r\n✓ All fraud types detected\r\n✓ JSON structure correct\r\n"]
[250.525526, "o", "\u001b[?2004hroot@3b20cb8d9516:~# "]
[263.669066, "i", "python3 << 'EOF'\nimport json\nimport pdfplumber\nimport pandas as pd\nimport re\n\n# Check what happened to page 52\nwith open('/root/fraud_report.json') as f:\n    report = json.load(f)\n\npage_52 = [inv for inv in report if inv['invoice_page_number'] == 52]\nif page_52:\n    print(\"Page 52 is flagged as fraudulent:\")\n    print(json.dumps(page_52[0], indent=2))\n    \n    # Let's verify this\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        text = pdf.pages[51].extract_text()\n        print(\"\\nActual invoice:\")\n        print(text)\n    \n    # Check the vendor and PO\n    vendors_df = pd.read_excel('/root/vendors.xlsx')\n    pos_df = pd.read_csv('/root/purchase_orders.csv')\n    \n    vendor_match = re.search(r'From:\\s*(.+)', text)\n    po_match = re.search(r'PO Number:\\s*(.+)', text)\n    amount_match = re.search(r'Total\\s+\\$([\\d,]+\\.\\d{2})', text)\n    \n    if vendor_match:\n        vendor_name = vendor_match.group(1).strip()\n        print(f\"\\nVendor name: {vendor_name}\")\n        \n        # Check if vendor exists\n        vendor = vendors_df[vendors_df['name'].str.lower() == vendor_name.lower()]\n        print(f\"Exact match in DB: {not vendor.empty}\")\n        \n        # Check fuzzy matches\n        print(\"\\nChecking for fuzzy matches:\")\n        for idx, row in vendors_df.iterrows():\n            if 'fuzzy' in row['name'].lower() or 'fuzzy' in vendor_name.lower():\n                print(f\"  {row['name']}\")\nelse:\n    print(\"Page 52 is NOT in the fraud report (legitimate)\")\nEOF\n"]
