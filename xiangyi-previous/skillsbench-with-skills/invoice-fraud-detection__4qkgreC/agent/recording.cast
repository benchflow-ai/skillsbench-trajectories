[163.183412, "i", "python3 << 'EOF'\nimport pandas as pd\n\n# Quick check of the vendor data\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npos_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Check vendor 3 and V413\nv3 = vendors_df[vendors_df['id'] == 'V003']\nv413 = vendors_df[vendors_df['id'] == 'V413']\n\nprint(\"Vendor 3:\")\nprint(v3)\nprint(\"\\nVendor V413:\")\nprint(v413)\n\n# Check PO-1412\npo = pos_df[pos_df['po_number'] == 'PO-1412']\nprint(\"\\nPO-1412:\")\nprint(po)\nEOF\n"]
