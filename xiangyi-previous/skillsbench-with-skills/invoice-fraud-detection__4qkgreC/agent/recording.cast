[96.373669, "o", "vendors_df = pd.read_excel('/root/vendors.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.373746, "o", "pos_df = pd.read_csv('/root/purchase_orders.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.373793, "o", "> \r\n\u001b[?2004l\r"]
