[291.439367, "i", "python3 << 'EOF'\nfrom difflib import SequenceMatcher\n\ndef normalize_vendor_name(name):\n    normalized = ' '.join(name.lower().split())\n    replacements = [\n        ('limited', 'ltd'),\n        ('incorporated', 'inc'),\n        ('corporation', 'corp'),\n        ('company', 'co'),\n    ]\n    variations = [normalized]\n    for full, abbr in replacements:\n        if full in normalized:\n            variations.append(normalized.replace(full, abbr))\n        if abbr in normalized:\n            variations.append(normalized.replace(abbr, full))\n    return variations\n\ninvoice_name = \"Fuzzy Match Systems Inc.\"\nvendor_name = \"Fuzzy Match Systems\"\n\nprint(f\"Invoice: {invoice_name}\")\nprint(f\"Vendor: {vendor_name}\")\n\ninvoice_vars = normalize_vendor_name(invoice_name)\nvendor_vars = normalize_vendor_name(vendor_name)\n\nprint(f\"\\nInvoice variations: {invoice_vars}\")\nprint(f\"Vendor variations: {vendor_vars}\")\n\nmatched = False\nfor inv_var in invoice_vars:\n    for vend_var in vendor_vars:\n        if inv_var == vend_var:\n            print(f\"\\nExact match found: '{inv_var}' == '{vend_var}'\")\n            matched = True\n        else:\n            ratio = SequenceMatcher(None, inv_var, vend_var).ratio()\n            print(f\"Comparing '{inv_var}' vs '{vend_var}': {ratio:.3f}\")\n            if ratio >= 0.95:\n                print(f\"  -> High similarity match!\")\n                matched = True\n\nprint(f\"\\nMatched: {matched}\")\nEOF\n"]
