[249.611109, "o", "\u001b[?2004h> "]
[249.611173, "o", "    with pdfplumber.open('/root/invoices.pdf') as pdf:\r\n\u001b[?2004l\r"]
[249.611221, "o", "\u001b[?2004h> "]
[249.611263, "o", "        text = pdf.pages[page_num-1].extract_text()\r\n\u001b[?2004l\r\u001b[?2004h"]
[249.611314, "o", "> "]
[249.61136, "o", "        print(f\"\\nLegitimate Invoice Page {page_num}:\")\r\n\u001b[?2004l\r"]
