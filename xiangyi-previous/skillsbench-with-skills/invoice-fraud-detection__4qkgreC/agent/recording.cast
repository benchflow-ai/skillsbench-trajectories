[337.699359, "o", "Total fraudulent invoices: 50\r\nLegitimate pages: [51, 52, 53]\r\n\r\n✓ Page 52 is correctly identified as legitimate\r\n\r\nFraud breakdown:\r\n  Amount Mismatch: 27\r\n  IBAN Mismatch: 9\r\n  Invalid PO: 5\r\n  Unknown Vendor: 9\r\n\r\nFirst 3 fraudulent invoices:\r\n\r\nPage 1:\r\n  Vendor: Vendor 11\r\n  Amount: $8623.76\r\n  PO: PO-1030\r\n  Reason: IBAN Mismatch\r\n\r\nPage 2:\r\n  Vendor: Vendor 3\r\n  Amount: $8347.33\r\n  PO: PO-1412\r\n  Reason: Amount Mismatch\r\n\r\nPage 3:\r\n  Vendor: Fraudulent Corp\r\n  Amount: $3034.55\r\n  PO: PO-1181\r\n  Reason: Unknown Vendor\r\n"]
[337.703102, "o", "\u001b[?2004hroot@3b20cb8d9516:~# "]
[354.528533, "i", "python3 << 'EOF'\nimport json\n\n# Final validation\nwith open('/root/fraud_report.json') as f:\n    report = json.load(f)\n\nprint(\"=== FINAL VALIDATION ===\")\nprint(f\"✓ JSON is valid and parseable\")\nprint(f\"✓ Total fraudulent invoices: {len(report)}\")\nprint(f\"✓ Only fraudulent invoices included (not all 53)\")\n\n# Check all required fields\nrequired_fields = ['invoice_page_number', 'vendor_name', 'invoice_amount', 'iban', 'po_number', 'reason']\nall_fields_present = True\nfor inv in report:\n    for field in required_fields:\n        if field not in inv:\n            print(f\"✗ Missing field '{field}' in page {inv.get('invoice_page_number', '?')}\")\n            all_fields_present = False\n\nif all_fields_present:\n    print(f\"✓ All required fields present in all entries\")\n\n# Check data types\nprint(f\"✓ invoice_page_number is integer: {isinstance(report[0]['invoice_page_number'], int)}\")\nprint(f\"✓ invoice_amount is float: {isinstance(report[0]['invoice_amount'], float)}\")\nprint(f\"✓ po_number can be null: {any(inv['po_number'] is None for inv in report) or 'all have PO'}\")\n\n# Check fraud reasons are valid\nvalid_reasons = ['Unknown Vendor', 'IBAN Mismatch', 'Invalid PO', 'Amount Mismatch', 'Vendor Mismatch']\nall_reasons_valid = all(inv['reason'] in valid_reasons for inv in report)\nprint(f\"✓ All fraud reasons are valid: {all_reasons_valid}\")\n\n# Check page numbers are 1-based\nmin_page = min(inv['invoice_page_number'] for inv in report)\nmax_page = max(inv['invoice_page_number'] for inv in report)\nprint(f\"✓ Page numbers range: {min_page} to {max_page} (1-based indexing)\")\n\nprint(\"\\n=== TASK COMPLETE ===\")\nprint(f\"Fraud report saved to: /root/fraud_report.json\")\nprint(f\"Total invoices analyzed: 53\")\nprint(f\"Fraudulent invoices detected: {len(report)}\")\nprint(f\"Legitimate invoices: {53 - len(report)}\")\nEOF\n"]
