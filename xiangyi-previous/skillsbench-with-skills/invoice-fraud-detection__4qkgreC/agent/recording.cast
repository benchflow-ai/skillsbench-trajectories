[111.618726, "i", "python3 << 'EOF'\nimport json\nimport pdfplumber\nimport pandas as pd\n\n# Load fraud report\nwith open('/root/fraud_report.json') as f:\n    fraud_data = json.load(f)\n\nfraudulent_pages = {inv['invoice_page_number'] for inv in fraud_data}\nall_pages = set(range(1, 54))  # 53 pages total\nlegit_pages = all_pages - fraudulent_pages\n\nprint(f\"Fraudulent pages: {len(fraudulent_pages)}\")\nprint(f\"Legitimate pages: {sorted(legit_pages)}\")\n\n# Check one of the legitimate invoices\nif legit_pages:\n    page_num = min(legit_pages)\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        text = pdf.pages[page_num-1].extract_text()\n        print(f\"\\n=== Legitimate Invoice Page {page_num} ===\")\n        print(text)\n        \n    # Verify it against data\n    vendors_df = pd.read_excel('/root/vendors.xlsx')\n    pos_df = pd.read_csv('/root/purchase_orders.csv')\n    \n    import re\n    vendor_match = re.search(r'From:\\s*(.+)', text)\n    amount_match = re.search(r'Total\\s+\\$([\\d,]+\\.\\d{2})', text)\n    iban_match = re.search(r'Payment IBAN:\\s*(.+)', text)\n    po_match = re.search(r'PO Number:\\s*(.+)', text)\n    \n    if all([vendor_match, amount_match, iban_match, po_match]):\n        vendor_name = vendor_match.group(1).strip()\n        amount = float(amount_match.group(1).replace(',', ''))\n        iban = iban_match.group(1).strip()\n        po_number = po_match.group(1).strip()\n        \n        print(f\"\\nParsed data:\")\n        print(f\"  Vendor: {vendor_name}\")\n        print(f\"  Amount: {amount}\")\n        print(f\"  IBAN: {iban}\")\n        print(f\"  PO: {po_number}\")\n        \n        # Check vendor\n        vendor = vendors_df[vendors_df['name'] == vendor_name]\n        if not vendor.empty:\n            print(f\"  Vendor found: {vendor.iloc[0]['id']} - {vendor.iloc[0]['name']} - {vendor.iloc[0]['iban']}\")\n            print(f\"  IBAN matches: {iban == vendor.iloc[0]['iban']}\")\n        \n        # Check PO\n        po = pos_df[pos_df['po_number'] == po_number]\n        if not po.empty:\n            print(f\"  PO found: {po.iloc[0]['po_number']} - Vendor {po.iloc[0]['vendor_id']} - Amount {po.iloc[0]['amount']}\")\n            print(f\"  Amount matches: {abs(amount - po.iloc[0]['amount']) <= 0.01}\")\n            if not vendor.empty:\n                print(f\"  Vendor ID matches: {vendor.iloc[0]['id'] == po.iloc[0]['vendor_id']}\")\nEOF\n"]
