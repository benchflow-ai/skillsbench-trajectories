[318.421684, "i", "cat > /root/fraud_detection_final.py << 'EOF'\nimport pandas as pd\nimport pdfplumber\nimport json\nimport re\nfrom difflib import SequenceMatcher\n\ndef normalize_and_create_variations(name):\n    \"\"\"Create variations of vendor name for fuzzy matching\"\"\"\n    # Remove periods and normalize whitespace\n    normalized = ' '.join(name.replace('.', '').lower().split())\n    \n    # Common suffixes to handle\n    suffixes = ['limited', 'ltd', 'incorporated', 'inc', 'corporation', 'corp', 'company', 'co']\n    \n    variations = [normalized]\n    \n    # For each suffix, create variations with it removed\n    for suffix in suffixes:\n        # Try removing the suffix from the end\n        if normalized.endswith(' ' + suffix):\n            base = normalized[:-len(suffix)-1].strip()\n            variations.append(base)\n            \n            # Also add variations with other suffixes\n            for other_suffix in suffixes:\n                if other_suffix != suffix:\n                    variations.append(base + ' ' + other_suffix)\n    \n    return list(set(variations))  # Remove duplicates\n\ndef find_vendor_by_name(vendor_name, vendors_df):\n    \"\"\"Find vendor by fuzzy matching name, return vendor row or None\"\"\"\n    # First try exact match (case-insensitive, no periods)\n    normalized_invoice = ' '.join(vendor_name.replace('.', '').lower().split())\n    \n    for idx, row in vendors_df.iterrows():\n        normalized_vendor = ' '.join(row['name'].replace('.', '').lower().split())\n        if normalized_invoice == normalized_vendor:\n            return row\n    \n    # Then try variations\n    invoice_variations = normalize_and_create_variations(vendor_name)\n    \n    for idx, row in vendors_df.iterrows():\n        vendor_variations = normalize_and_create_variations(row['name'])\n        \n        # Check if any variation matches\n        for inv_var in invoice_variations:\n            for vend_var in vendor_variations:\n                if inv_var == vend_var:\n                    return row\n                # Also check high similarity for typos\n                ratio = SequenceMatcher(None, inv_var, vend_var).ratio()\n                if ratio >= 0.95:\n                    return row\n    \n    return None\n\ndef extract_invoices_from_pdf(pdf_path):\n    \"\"\"Extract invoice data from PDF\"\"\"\n    invoices = []\n    \n    with pdfplumber.open(pdf_path) as pdf:\n        for page_num, page in enumerate(pdf.pages, start=1):\n            text = page.extract_text()\n            \n            # Parse invoice fields\n            vendor_match = re.search(r'From:\\s*(.+)', text)\n            amount_match = re.search(r'Total\\s+\\$([\\d,]+\\.\\d{2})', text)\n            iban_match = re.search(r'Payment IBAN:\\s*(.+)', text)\n            po_match = re.search(r'PO Number:\\s*(.+)', text)\n            \n            if vendor_match and amount_match and iban_match:\n                vendor_name = vendor_match.group(1).strip()\n                amount = float(amount_match.group(1).replace(',', ''))\n                iban = iban_match.group(1).strip()\n                po_number = po_match.group(1).strip() if po_match else None\n                \n                invoices.append({\n                    'page_number': page_num,\n                    'vendor_name': vendor_name,\n                    'amount': amount,\n                    'iban': iban,\n                    'po_number': po_number\n                })\n    \n    return invoices\n\ndef detect_fraud(invoices, vendors_df, pos_df):\n    \"\"\"Detect fraudulent invoices based on criteria\"\"\"\n    fraudulent = []\n    \n    for invoice in invoices:\n        fraud_reason = None\n        \n        # Criterion 1: Unknown Vendor\n        vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)\n        if vendor is None:\n            fraud_reason = \"Unknown Vendor\"\n        \n        # Criterion 2: IBAN Mismatch (only if vendor exists)\n        elif invoice['iban'] != vendor['iban']:\n            fraud_reason = \"IBAN Mismatch\"\n        \n        # Check PO-related criteria only if we have a PO number\n        elif invoice['po_number'] is not None:\n            po = pos_df[pos_df['po_number'] == invoic"]
[318.421756, "i", "e['po_number']]\n            \n            # Criterion 3: Invalid PO\n            if po.empty:\n                fraud_reason = \"Invalid PO\"\n            else:\n                po_row = po.iloc[0]\n                \n                # Criterion 4: Amount Mismatch\n                if abs(invoice['amount'] - po_row['amount']) > 0.01:\n                    fraud_reason = \"Amount Mismatch\"\n                \n                # Criterion 5: Vendor Mismatch\n                elif vendor['id'] != po_row['vendor_id']:\n                    fraud_reason = \"Vendor Mismatch\"\n        \n        # Add to fraudulent list if any criterion matched\n        if fraud_reason:\n            fraudulent.append({\n                'invoice_page_number': invoice['page_number'],\n                'vendor_name': invoice['vendor_name'],\n                'invoice_amount': invoice['amount'],\n                'iban': invoice['iban'],\n                'po_number': invoice['po_number'],\n                'reason': fraud_reason\n            })\n    \n    return fraudulent\n\n# Main execution\nif __name__ == '__main__':\n    # Load data\n    vendors_df = pd.read_excel('/root/vendors.xlsx')\n    pos_df = pd.read_csv('/root/purchase_orders.csv')\n    \n    # Extract invoices\n    print(\"Extracting invoices from PDF...\")\n    invoices = extract_invoices_from_pdf('/root/invoices.pdf')\n    print(f\"Extracted {len(invoices)} invoices\")\n    \n    # Detect fraud\n    print(\"Detecting fraud...\")\n    fraudulent_invoices = detect_fraud(invoices, vendors_df, pos_df)\n    print(f\"Found {len(fraudulent_invoices)} fraudulent invoices\")\n    \n    # Save report\n    with open('/root/fraud_report.json', 'w') as f:\n        json.dump(fraudulent_invoices, f, indent=2)\n    \n    print(\"Fraud report saved to /root/fraud_report.json\")\nEOF\n"]
[318.422122, "o", "cat > /root/fraud_detection_final.py << 'EOF'\r\n\u001b[?2004l\r"]
[318.422195, "o", "\u001b[?2004h> "]
[318.422254, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.422283, "o", "> "]
[318.422382, "o", "import pdfplumber\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.422415, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.422444, "o", "> "]
[318.422526, "o", "import re\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[318.422641, "o", "from difflib import SequenceMatcher\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.422667, "o", "> \r\n\u001b[?2004l\r"]
[318.422692, "o", "\u001b[?2004h> "]
[318.422844, "o", "def normalize_and_create_variations(name):\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.422892, "o", "> "]
[318.423082, "o", "    \"\"\"Create variations of vendor name for fuzzy matching\"\"\"\r\n\u001b[?2004l\r"]
[318.423106, "o", "\u001b[?2004h> "]
[318.42328, "o", "    # Remove periods and normalize whitespace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.423517, "o", "    normalized = ' '.join(name.replace('.', '').lower().split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.423579, "o", "    \r\n\u001b[?2004l\r"]
[318.423622, "o", "\u001b[?2004h> "]
[318.423695, "o", "    # Common suffixes to handle\r\n\u001b[?2004l\r"]
[318.423745, "o", "\u001b[?2004h> "]
[318.424019, "o", "    suffixes = ['limited', 'ltd', 'incorporated', 'inc', 'corporation', 'corp', 'company', 'co']\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.424045, "o", "> "]
[318.424104, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.424537, "o", "    variations = [normalized]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.424612, "o", "    # For each suffix, create variations with it removed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.424816, "o", "    for suffix in suffixes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.424971, "o", "        # Try removing the suffix from the end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.425115, "o", "        if normalized.endswith(' ' + suffix):\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.425165, "o", "> "]
[318.425313, "o", "            base = normalized[:-len(suffix)-1].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.425371, "o", "> "]
[318.425444, "o", "            variations.append(base)\r\n\u001b[?2004l\r"]
[318.425496, "o", "\u001b[?2004h> "]
[318.425547, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.42572, "o", "            # Also add variations with other suffixes\r\n\u001b[?2004l\r"]
[318.425745, "o", "\u001b[?2004h> "]
[318.42587, "o", "            for other_suffix in suffixes:\r\n\u001b[?2004l\r"]
[318.425931, "o", "\u001b[?2004h> "]
[318.42605, "o", "                if other_suffix != suffix:\r\n\u001b[?2004l\r"]
[318.426077, "o", "\u001b[?2004h> "]
[318.426279, "o", "                    variations.append(base + ' ' + other_suffix)\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.426339, "o", ">     \r\n\u001b[?2004l\r"]
[318.426385, "o", "\u001b[?2004h> "]
[318.426562, "o", "    return list(set(variations))  # Remove duplicates\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[318.426624, "o", "> "]
[318.426712, "o", "def find_vendor_by_name(vendor_name, vendors_df):\r\n\u001b[?2004l\r"]
[318.426757, "o", "\u001b[?2004h> "]
[318.426973, "o", "    \"\"\"Find vendor by fuzzy matching name, return vendor row or None\"\"\"\r\n\u001b[?2004l\r"]
[318.427022, "o", "\u001b[?2004h> "]
[318.427248, "o", "    # First try exact match (case-insensitive, no periods)\r\n\u001b[?2004l\r"]
[318.427277, "o", "\u001b[?2004h> "]
[318.427609, "o", "    normalized_invoice = ' '.join(vendor_name.replace('.', '').lower().split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.42764, "o", "    \r\n\u001b[?2004l\r"]
[318.427703, "o", "\u001b[?2004h> "]
[318.42778, "o", "    for idx, row in vendors_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.42783, "o", "> "]
[318.428092, "o", "        normalized_vendor = ' '.join(row['name'].replace('.', '').lower().split())\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.428122, "o", "> "]
[318.428281, "o", "        if normalized_invoice == normalized_vendor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.42834, "o", "            return row\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.428398, "o", ">     \r\n\u001b[?2004l\rn\u001b[?2004h"]
[318.428456, "o", "> "]
[318.42849, "o", "    # Then try variations\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.428546, "o", "> "]
[318.428755, "o", "    invoice_variations = normalize_and_create_variations(vendor_name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.428818, "o", "    \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[318.428932, "o", "    for idx, row in vendors_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429182, "o", "        vendor_variations = normalize_and_create_variations(row['name'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429231, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429294, "o", "        # Check if any variation matches\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.429345, "o", "> "]
[318.429398, "o", "        for inv_var in invoice_variations:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429455, "o", "            for vend_var in vendor_variations:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429536, "o", "                if inv_var == vend_var:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429603, "o", "                    return row\r\n\u001b[?2004l\r"]
[318.429662, "o", "\u001b[?2004h> "]
[318.429756, "o", "                # Also check high similarity for typos\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.42988, "o", "                ratio = SequenceMatcher(None, inv_var, vend_var).ratio()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.429964, "o", "                if ratio >= 0.95:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.430012, "o", "                    return row\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.43006, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.430114, "o", "    return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.430199, "o", "def extract_invoices_from_pdf(pdf_path):\r\n\u001b[?2004l\r"]
[318.430257, "o", "\u001b[?2004h> "]
[318.430309, "o", "    \"\"\"Extract invoice data from PDF\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.430353, "o", "    invoices = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.430404, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.430461, "o", "    with pdfplumber.open(pdf_path) as pdf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.430525, "o", "> "]
[318.430576, "o", "        for page_num, page in enumerate(pdf.pages, start=1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.43065, "o", "            text = page.extract_text()\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.430679, "o", ">             \r\n\u001b[?2004l\r"]
[318.430754, "o", "\u001b[?2004h> "]
[318.430793, "o", "            # Parse invoice fields\r\n\u001b[?2004l\r"]
[318.430837, "o", "\u001b[?2004h> "]
[318.430933, "o", "            vendor_match = re.search(r'From:\\s*(.+)', text)\r\n\u001b[?2004l\r"]
[318.430983, "o", "\u001b[?2004h> "]
[318.431077, "o", "            amount_match = re.search(r'Total\\s+\\$([\\d,]+\\.\\d{2})', text)\r\n\u001b[?2004l\r"]
[318.431128, "o", "\u001b[?2004h> "]
[318.431194, "o", "            iban_match = re.search(r'Payment IBAN:\\s*(.+)', text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.431238, "o", "> "]
[318.431308, "o", "            po_match = re.search(r'PO Number:\\s*(.+)', text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.431356, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.431445, "o", "            if vendor_match and amount_match and iban_match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.431489, "o", "> "]
[318.431546, "o", "                vendor_name = vendor_match.group(1).strip()\r\n\u001b[?2004l\r"]
[318.431589, "o", "\u001b[?2004h> "]
[318.431685, "o", "                amount = float(amount_match.group(1).replace(',', ''))\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.431735, "o", "> "]
[318.4318, "o", "                iban = iban_match.group(1).strip()\r\n\u001b[?2004l\r"]
[318.431845, "o", "\u001b[?2004h> "]
[318.431928, "o", "                po_number = po_match.group(1).strip() if po_match else None\r\n\u001b[?2004l\r"]
[318.431981, "o", "\u001b[?2004h> "]
[318.432032, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432082, "o", "                invoices.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432128, "o", "                    'page_number': page_num,\r\n\u001b[?2004l\r"]
[318.432184, "o", "\u001b[?2004h> "]
[318.432269, "o", "                    'vendor_name': vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432319, "o", "> "]
[318.432362, "o", "                    'amount': amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432411, "o", "                    'iban': iban,\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432463, "o", "> "]
[318.432509, "o", "                    'po_number': po_number\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432558, "o", "> "]
[318.432607, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432654, "o", "    return invoices\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432702, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432749, "o", "def detect_fraud(invoices, vendors_df, pos_df):\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432794, "o", "> "]
[318.432847, "o", "    \"\"\"Detect fraudulent invoices based on criteria\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.432872, "o", "> "]
[318.432938, "o", "    fraudulent = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.432994, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.433044, "o", "    for invoice in invoices:\r\n\u001b[?2004l\r\u001b[?2004h>         fraud_reason = None\r\n\u001b[?2004l\r"]
[318.433095, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.433147, "o", "        # Criterion 1: Unknown Vendor\r\n\u001b[?2004l\r"]
[318.433192, "o", "\u001b[?2004h> "]
[318.433328, "o", "        vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.433394, "o", "        if vendor is None:\r\n\u001b[?2004l\r"]
[318.433445, "o", "\u001b[?2004h> "]
[318.433504, "o", "            fraud_reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.433549, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.433653, "o", "        # Criterion 2: IBAN Mismatch (only if vendor exists)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.433739, "o", "        elif invoice['iban'] != vendor['iban']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.43381, "o", "            fraud_reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r"]
[318.433853, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.43398, "o", "        # Check PO-related criteria only if we have a PO number\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.434026, "o", "> "]
[318.434067, "o", "        elif invoice['po_number'] is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.434118, "o", "> "]
[318.434193, "o", "            po = pos_df[pos_df['po_number'] == invoice['po_number']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434239, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434294, "o", "            # Criterion 3: Invalid PO\r\n\u001b[?2004l\r"]
[318.434343, "o", "\u001b[?2004h> "]
[318.434388, "o", "            if po.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434441, "o", "                fraud_reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.434485, "o", "> "]
[318.434529, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434619, "o", "                po_row = po.iloc[0]\r\n\u001b[?2004l\r"]
[318.434663, "o", "\u001b[?2004h> "]
[318.434714, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434768, "o", "                # Criterion 4: Amount Mismatch\r\n\u001b[?2004l\r"]
[318.434816, "o", "\u001b[?2004h> "]
[318.434894, "o", "                if abs(invoice['amount'] - po_row['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.434979, "o", "                    fraud_reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r"]
[318.435031, "o", "\u001b[?2004h> "]
[318.435083, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.43513, "o", "                # Criterion 5: Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435211, "o", "                elif vendor['id'] != po_row['vendor_id']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.43531, "o", "                    fraud_reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435359, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435455, "o", "        # Add to fraudulent list if any criterion matched\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.435481, "o", "> "]
[318.435529, "o", "        if fraud_reason:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.435557, "o", "> "]
[318.435622, "o", "            fraudulent.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435698, "o", "                'invoice_page_number': invoice['page_number'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435801, "o", "                'vendor_name': invoice['vendor_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.435903, "o", "                'invoice_amount': invoice['amount'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.435955, "o", "> "]
[318.436003, "o", "                'iban': invoice['iban'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.436052, "o", "> "]
[318.436129, "o", "                'po_number': invoice['po_number'],\r\n\u001b[?2004l\r"]
[318.436182, "o", "\u001b[?2004h> "]
[318.436226, "o", "                'reason': fraud_reason\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.436251, "o", ">             })\r\n\u001b[?2004l\r"]
[318.436314, "o", "\u001b[?2004h> "]
[318.436367, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.436417, "o", "    return fraudulent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
