[61.49628, "o", "                    'iban': iban,\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.496335, "o", "> "]
[61.49638, "o", "                    'po_number': po_number\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.496425, "o", ">                 })\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.496476, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.496513, "o", "    return invoices\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.4966, "o", "def detect_fraud(invoices, vendors_df, pos_df):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.49669, "o", "    \"\"\"Detect fraudulent invoices based on criteria\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.496714, "o", "> "]
[61.496779, "o", "    fraudulent = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.49682, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     for invoice in invoices:\r\n\u001b[?2004l\r"]
[61.496867, "o", "\u001b[?2004h> "]
[61.49692, "o", "        fraud_reason = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.496957, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.497053, "o", "        # Criterion 1: Unknown Vendor\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.497096, "o", "> "]
[61.497257, "o", "        vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.497343, "o", "        if vendor is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.497392, "o", "            fraud_reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.497445, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.497579, "o", "        # Criterion 2: IBAN Mismatch (only if vendor exists)\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.497603, "o", "> "]
[61.497769, "o", "        elif invoice['iban'] != vendor['iban']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.497804, "o", "            fraud_reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.49793, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[61.498019, "o", ">         # Check PO-related criteria only if we have a PO number\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.4981, "o", "        elif invoice['po_number'] is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.498147, "o", "> "]
[61.498221, "o", "            po = pos_df[pos_df['po_number'] == invoice['po_number']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.498247, "o", ">             \r\n\u001b[?2004l\r"]
[61.498296, "o", "\u001b[?2004h> "]
[61.498359, "o", "            # Criterion 3: Invalid PO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.498396, "o", "            if po.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.498465, "o", "                fraud_reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.498513, "o", "> "]
[61.498558, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.498595, "o", "                po_row = po.iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.498633, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.498706, "o", "                # Criterion 4: Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.49883, "o", "                if abs(invoice['amount'] - po_row['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.49892, "o", "                    fraud_reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.498964, "o", "> "]
[61.49901, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499049, "o", "                # Criterion 5: Vendor Mismatch\r\n\u001b[?2004l\r"]
[61.499103, "o", "\u001b[?2004h> "]
[61.499164, "o", "                elif vendor['id'] != po_row['vendor_id']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499269, "o", "                    fraud_reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499323, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499392, "o", "        # Add to fraudulent list if any criterion matched\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499452, "o", "        if fraud_reason:\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.499499, "o", "> "]
[61.499549, "o", "            fraudulent.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499618, "o", "                'invoice_page_number': invoice['page_number'],\r\n\u001b[?2004l\r"]
[61.499662, "o", "\u001b[?2004h> "]
[61.499717, "o", "                'vendor_name': invoice['vendor_name'],\r\n\u001b[?2004l\r"]
[61.499767, "o", "\u001b[?2004h> "]
[61.499812, "o", "                'invoice_amount': invoice['amount'],\r\n\u001b[?2004l\r"]
[61.499866, "o", "\u001b[?2004h> "]
[61.499902, "o", "                'iban': invoice['iban'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.499982, "o", "                'po_number': invoice['po_number'],\r\n\u001b[?2004l\r"]
[61.50003, "o", "\u001b[?2004h> "]
[61.500081, "o", "                'reason': fraud_reason\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.50013, "o", ">             })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[61.500179, "o", "\u001b[?2004h>     return fraudulent\r\n\u001b[?2004l\r"]
[61.500221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.500264, "o", "# Main execution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.500307, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.500351, "o", ">     # Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.500445, "o", "    vendors_df = pd.read_excel('/root/vendors.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.500494, "o", "> "]
[61.500541, "o", "    pos_df = pd.read_csv('/root/purchase_orders.csv')\r\n\u001b[?2004l\r"]
[61.500584, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[61.500635, "o", ">     # Extract invoices\r\n\u001b[?2004l\r"]
[61.500678, "o", "\u001b[?2004h> "]
[61.500716, "o", "    print(\"Extracting invoices from PDF...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.500807, "o", "    invoices = extract_invoices_from_pdf('/root/invoices.pdf')\r\n\u001b[?2004l\r"]
[61.50085, "o", "\u001b[?2004h> "]
[61.500898, "o", "    print(f\"Extracted {len(invoices)} invoices\")\r\n\u001b[?2004l\r"]
[61.500922, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[61.500947, "o", "> "]
[61.501031, "o", "    # Detect fraud\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.501081, "o", "    print(\"Detecting fraud...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.501153, "o", "    fraudulent_invoices = detect_fraud(invoices, vendors_df, pos_df)\r\n\u001b[?2004l\r"]
[61.5012, "o", "\u001b[?2004h> "]
[61.501292, "o", "    print(f\"Found {len(fraudulent_invoices)} fraudulent invoices\")\r\n\u001b[?2004l\r"]
[61.501331, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.501374, "o", "    # Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.50146, "o", "    with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[61.501509, "o", "\u001b[?2004h> "]
[61.501559, "o", "        json.dump(fraudulent_invoices, f, indent=2)\r\n\u001b[?2004l\r"]
[61.501606, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[61.501643, "o", "> "]
[61.50169, "o", "    print(\"Fraud report saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r"]
[61.501739, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
