[96.373153, "i", "python3 << 'EOF'\nimport pdfplumber\nimport pandas as pd\n\n# Load reference data\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npos_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Check a few sample pages to verify the logic\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    # Check pages that were NOT flagged as fraudulent\n    for page_num in [51, 52, 53]:  # Last few pages\n        if page_num <= len(pdf.pages):\n            text = pdf.pages[page_num-1].extract_text()\n            print(f\"\\n=== Page {page_num} ===\")\n            print(text)\nEOF\n"]
[96.373419, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.373529, "o", "import pdfplumber\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r"]
