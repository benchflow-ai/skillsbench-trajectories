[216.328253, "o", "            if vendor_match and amount_match and iban_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.328344, "o", "                vendor_name = vendor_match.group(1).strip()\r\n\u001b[?2004l\r"]
[216.32839, "o", "\u001b[?2004h> "]
[216.328464, "o", "                amount = float(amount_match.group(1).replace(',', ''))\r\n\u001b[?2004l\r"]
[216.32851, "o", "\u001b[?2004h> "]
[216.328555, "o", "                iban = iban_match.group(1).strip()\r\n\u001b[?2004l\r"]
[216.3286, "o", "\u001b[?2004h> "]
[216.328689, "o", "                po_number = po_match.group(1).strip() if po_match else None\r\n\u001b[?2004l\r"]
[216.328734, "o", "\u001b[?2004h> "]
[216.328771, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.32881, "o", "                invoices.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.328878, "o", "                    'page_number': page_num,\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.328923, "o", "> "]
[216.328964, "o", "                    'vendor_name': vendor_name,\r\n\u001b[?2004l\r"]
[216.329014, "o", "\u001b[?2004h> "]
[216.329052, "o", "                    'amount': amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329105, "o", "                    'iban': iban,\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.32915, "o", "> "]
[216.329188, "o", "                    'po_number': po_number\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.329232, "o", "> "]
[216.329283, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[216.329334, "o", "\u001b[?2004h>     return invoices\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[216.329383, "o", "> "]
[216.329436, "o", "def detect_fraud(invoices, vendors_df, pos_df):\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.32948, "o", "> "]
[216.329531, "o", "    \"\"\"Detect fraudulent invoices based on criteria\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.329569, "o", ">     fraudulent = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329614, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.32965, "o", "    for invoice in invoices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329705, "o", "        fraud_reason = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329744, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329804, "o", "        # Criterion 1: Unknown Vendor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329947, "o", "        vendor = find_vendor_by_name(invoice['vendor_name'], vendors_df)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.329994, "o", "        if vendor is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330074, "o", "            fraud_reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.330099, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[216.330146, "o", "> "]
[216.330214, "o", "        # Criterion 2: IBAN Mismatch (only if vendor exists)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330295, "o", "        elif invoice['iban'] != vendor['iban']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.33037, "o", "            fraud_reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330417, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330514, "o", "        # Check PO-related criteria only if we have a PO number\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330593, "o", "        elif invoice['po_number'] is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.330637, "o", "> "]
[216.330716, "o", "            po = pos_df[pos_df['po_number'] == invoice['po_number']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.330759, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330822, "o", "            # Criterion 3: Invalid PO\r\n\u001b[?2004l\r"]
[216.330852, "o", "\u001b[?2004h> "]
[216.33088, "o", "            if po.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.330968, "o", "                fraud_reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331029, "o", "            else:\r\n\u001b[?2004l\r"]
[216.331074, "o", "\u001b[?2004h> "]
[216.3311, "o", "                po_row = po.iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331149, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.33123, "o", "                # Criterion 4: Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331329, "o", "                if abs(invoice['amount'] - po_row['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331407, "o", "                    fraud_reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.331463, "o", "> "]
[216.331511, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331559, "o", "                # Criterion 5: Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331632, "o", "                elif vendor['id'] != po_row['vendor_id']:\r\n\u001b[?2004l\r"]
[216.331676, "o", "\u001b[?2004h> "]
[216.331739, "o", "                    fraud_reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331783, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.33187, "o", "        # Add to fraudulent list if any criterion matched\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.331913, "o", "        if fraud_reason:\r\n\u001b[?2004l\r"]
[216.331957, "o", "\u001b[?2004h> "]
[216.332, "o", "            fraudulent.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332086, "o", "                'invoice_page_number': invoice['page_number'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332188, "o", "                'vendor_name': invoice['vendor_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332274, "o", "                'invoice_amount': invoice['amount'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332355, "o", "                'iban': invoice['iban'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332454, "o", "                'po_number': invoice['po_number'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332509, "o", "                'reason': fraud_reason\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.33255, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.332598, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332649, "o", "    return fraudulent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[216.332698, "o", "\u001b[?2004h> # Main execution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332742, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.332781, "o", "    # Load data\r\n\u001b[?2004l\r"]
[216.332824, "o", "\u001b[?2004h> "]
[216.332882, "o", "    vendors_df = pd.read_excel('/root/vendors.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.332932, "o", "> "]
[216.332974, "o", "    pos_df = pd.read_csv('/root/purchase_orders.csv')\r\n\u001b[?2004l\r"]
[216.333019, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[216.333049, "o", ">     # Extract invoices\r\n\u001b[?2004l\r"]
[216.333103, "o", "\u001b[?2004h> "]
[216.333195, "o", "    print(\"Extracting invoices from PDF...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333252, "o", "    invoices = extract_invoices_from_pdf('/root/invoices.pdf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333345, "o", "    print(f\"Extracted {len(invoices)} invoices\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333398, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333428, "o", "    # Detect fraud\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.33352, "o", "    print(\"Detecting fraud...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333589, "o", "    fraudulent_invoices = detect_fraud(invoices, vendors_df, pos_df)\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.33362, "o", "> "]
[216.333704, "o", "    print(f\"Found {len(fraudulent_invoices)} fraudulent invoices\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.333736, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[216.333767, "o", "> "]
[216.333816, "o", "    # Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333884, "o", "    with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.333977, "o", "        json.dump(fraudulent_invoices, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.334007, "o", ">     \r\n\u001b[?2004l\r"]
[216.334036, "o", "\u001b[?2004h> "]
[216.33413, "o", "    print(\"Fraud report saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[216.335528, "o", "\u001b[?2004hroot@3b20cb8d9516:~# "]
[222.641361, "i", "python3 /root/fraud_detection_fixed.py\n"]
