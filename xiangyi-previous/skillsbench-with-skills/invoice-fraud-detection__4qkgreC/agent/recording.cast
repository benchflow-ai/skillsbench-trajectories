[337.674743, "i", "python3 << 'EOF'\nimport json\n\n# Load and verify the final report\nwith open('/root/fraud_report.json') as f:\n    report = json.load(f)\n\nprint(f\"Total fraudulent invoices: {len(report)}\")\n\n# Check which pages are legitimate\nfraudulent_pages = {inv['invoice_page_number'] for inv in report}\nlegit_pages = [i for i in range(1, 54) if i not in fraudulent_pages]\nprint(f\"Legitimate pages: {legit_pages}\")\n\n# Check page 52 specifically\npage_52 = [inv for inv in report if inv['invoice_page_number'] == 52]\nif page_52:\n    print(f\"\\nERROR: Page 52 is still flagged as fraudulent!\")\n    print(json.dumps(page_52[0], indent=2))\nelse:\n    print(f\"\\n✓ Page 52 is correctly identified as legitimate\")\n\n# Fraud breakdown\nprint(\"\\nFraud breakdown:\")\nreasons = {}\nfor inv in report:\n    reasons[inv['reason']] = reasons.get(inv['reason'], 0) + 1\nfor reason, count in sorted(reasons.items()):\n    print(f\"  {reason}: {count}\")\n\n# Show first few entries\nprint(\"\\nFirst 3 fraudulent invoices:\")\nfor i in range(min(3, len(report))):\n    print(f\"\\nPage {report[i]['invoice_page_number']}:\")\n    print(f\"  Vendor: {report[i]['vendor_name']}\")\n    print(f\"  Amount: ${report[i]['invoice_amount']}\")\n    print(f\"  PO: {report[i]['po_number']}\")\n    print(f\"  Reason: {report[i]['reason']}\")\nEOF\n"]
