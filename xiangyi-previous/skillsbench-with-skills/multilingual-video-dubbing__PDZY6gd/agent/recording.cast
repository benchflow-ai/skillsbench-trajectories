[204.0053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[204.005345, "o", "\u001b[?2004h> "]
[204.005826, "o", "text = \"前略テレビの前の視聴者様。このアニメに出てくるやつらは不良です。だから決して。このアニメなので。\"\r\n\u001b[?2004l\r"]
[204.005867, "o", "\u001b[?2004h> "]
[204.005922, "o", "x, sr = pyopenjtalk.tts(text)\r\n\u001b[?2004l\r"]
[204.005957, "o", "\u001b[?2004h> "]
[204.006057, "o", "# x is int16, convert to float32\r\n\u001b[?2004l\r"]
[204.006096, "o", "\u001b[?2004h> "]
