[204.004703, "i", "cat <<EOF > generate_audio.py\nimport pyopenjtalk\nimport soundfile as sf\nimport numpy as np\n\ntext = \"前略テレビの前の視聴者様。このアニメに出てくるやつらは不良です。だから決して。このアニメなので。\"\nx, sr = pyopenjtalk.tts(text)\n# x is int16, convert to float32\nx = x.astype(np.float32) / 32768.0\nsf.write('/outputs/tts_segments/seg_0.wav', x, sr)\nprint(f\"Saved wav with sample rate {sr}, duration {len(x)/sr}s\")\nEOF\n"]
[204.00501, "o", "cat <<EOF > generate_audio.py\r\n"]
[204.005156, "o", "\u001b[?2004l\r\u001b[?2004h> import pyopenjtalk\r\n\u001b[?2004l\r\u001b[?2004h> "]
