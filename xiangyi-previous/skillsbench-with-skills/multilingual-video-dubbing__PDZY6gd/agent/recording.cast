[204.006356, "o", "sf.write('/outputs/tts_segments/seg_0.wav', x, sr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.006399, "o", "> "]
[204.006513, "o", "print(f\"Saved wav with sample rate {sr}, duration {len(x)/sr}s\")\r\n\u001b[?2004l\r"]
