[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> # Dots coefficients - standard IPF Dots formula
[?2004l[?2004h> # Based on bodyweight ranges for each sex
[?2004l[?2004h> # Format: (max_bodyweight, male_coeff, female_coeff, mx_coeff)
[?2004l[?2004h> dots_coefficients = [
[?2004l[?2004h>     (40, 0.75, 0.897, 0.75),
[?2004l[?2004h>     (43, 0.755, 0.903, 0.755),
[?2004l[?2004h>     (47, 0.765, 0.924, 0.765),
[?2004l[?2004h>     (52, 0.785, 0.949, 0.785),
[?2004l[?2004h>     (56, 0.807, 0.971, 0.807),
[?2004l[?2004h>     (60, 0.829, 0.994, 0.829),
[?2004l[?2004h>     (67.5, 0.851, 1.019, 0.851),
[?2004l[?2004h>     (75, 0.874, 1.046, 0.874),
[?2004l[?2004h>     (82.5, 0.896, 1.073, 0.896),
[?2004l[?2004h>     (90, 0.921, 1.099, 0.921),
[?2004l[?2004h>     (100, 0.949, 1.125, 0.949),
[?2004l[?2004h>     (110, 0.971, 1.149, 0.971),
[?2004l[?2004h>     (125, 0.997, 1.175, 0.997),
[?2004l[?2004h>     (145, 1.020, 1.199, 1.020),
[?2004l[?2004h>     (float('inf'), 1.050, 1.249, 1.050)  # 145+ kg
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def get_dots_coefficient(bodyweight, sex):
[?2004l[?2004h>     """Get Dots coefficient based on bodyweight and sex"""
[?2004l[?2004h>     if bodyweight is None or sex is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     sex_idx = {'M': 1, 'F': 2, 'Mx': 3}.get(sex, 1)
[?2004l[?2004h>     
[?2004l[?2004h>     for max_bw, m_coeff, f_coeff, mx_coeff in dots_coefficients:
[?2004l[?2004h>         if bodyweight <= max_bw:
[?2004l[?2004h>             coeffs = [m_coeff, f_coeff, mx_coeff]
[?2004l[?2004h>             return round(coeffs[sex_idx - 1], 3)
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> data_sheet = wb['Data']
[?2004l[?2004h> dots_sheet = wb['Dots']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Copy headers to Dots sheet
[?2004l[?2004h> headers = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg']
[?2004l[?2004h> for col_idx, header in enumerate(headers, 1):
[?2004l[?2004h>     dots_sheet.cell(1, col_idx).value = header
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Copy data rows
[?2004l[?2004h> for row_idx in range(2, data_sheet.max_row + 1):
[?2004l[?2004h>     name = data_sheet.cell(row_idx, 1).value
[?2004l[?2004h>     sex = data_sheet.cell(row_idx, 2).value
[?2004l[?2004h>     bw = data_sheet.cell(row_idx, 9).value
[?2004l[?2004h>     squat = data_sheet.cell(row_idx, 11).value
[?2004l[?2004h>     bench = data_sheet.cell(row_idx, 12).value
[?2004l[?2004h>     deadlift = data_sheet.cell(row_idx, 13).value
[?2004l[?2004h>     
[?2004l[?2004h>     dots_sheet.cell(row_idx, 1).value = name
[?2004l[?2004h>     dots_sheet.cell(row_idx, 2).value = sex
[?2004l[?2004h>     dots_sheet.cell(row_idx, 3).value = bw
[?2004l[?2004h>     dots_sheet.cell(row_idx, 4).value = squat
[?2004l[?2004h>     dots_sheet.cell(row_idx, 5).value = bench
[?2004l[?2004h>     dots_sheet.cell(row_idx, 6).value = deadlift
[?2004l[?2004h> 
[?2004l[?2004h> print("Data copied successfully!")
[?2004l[?2004h> print(f"Rows copied: {data_sheet.max_row - 1}")
[?2004l[?2004h> 
