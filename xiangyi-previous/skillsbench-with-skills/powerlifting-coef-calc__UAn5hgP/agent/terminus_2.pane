[?2004hroot@92423c4386ba:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = load_workbook('/root/data/openipf.xlsx')
[?2004l[?2004h> dots_sheet = wb['Dots']
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Add TotalKg column header
[?2004l[?2004h> dots_sheet.cell(1, 7).value = 'TotalKg'
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Add TotalKg formulas for each row
[?2004l[?2004h> for row_idx in range(2, 22):  # rows 2-21
[?2004l[?2004h>     # Formula: =D{row} + E{row} + F{row}
[?2004l[?2004h>     formula = f"=D{row_idx}+E{row_idx}+F{row_idx}"
[?2004l[?2004h>     dots_sheet.cell(row_idx, 7).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> print("TotalKg column added with formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Add Dots column header
[?2004l[?2004h> dots_sheet.cell(1, 8).value = 'Dots'
[?2004l[?2004h> 
[?2004l[?2004h> # Create a complex formula for Dots calculation
[?2004l[?2004h> # The formula needs to:
[?2004l[?2004h> # 1. Look up the coefficient based on Sex (column B) and BodyweightKg (column C)
[?2004l[?2004h> # 2. Multiply TotalKg (column G) by the coefficient
[?2004l[?2004h> # 3. Round to 3 decimal places
[?2004l[?2004h> 
[?2004l[?2004h> # Dots coefficients lookup - we'll create nested IFs
[?2004l[?2004h> # Structure: IF(Sex="M", male_coeff_lookup, IF(Sex="F", female_coeff_lookup, mx_coeff_lookup))
[?2004l[?2004h> 
[?2004l[?2004h> # Male coefficients by bodyweight
[?2004l[?2004h> male_coeff_formula = """
[?2004l[?2004h> IF(C{row}<=40, 0.75,
[?2004l[?2004h> IF(C{row}<=43, 0.755,
[?2004l[?2004h> IF(C{row}<=47, 0.765,
[?2004l[?2004h> IF(C{row}<=52, 0.785,
[?2004l[?2004h> IF(C{row}<=56, 0.807,
[?2004l[?2004h> IF(C{row}<=60, 0.829,
[?2004l[?2004h> IF(C{row}<=67.5, 0.851,
[?2004l[?2004h> IF(C{row}<=75, 0.874,
[?2004l[?2004h> IF(C{row}<=82.5, 0.896,
[?2004l[?2004h> IF(C{row}<=90, 0.921,
[?2004l[?2004h> IF(C{row}<=100, 0.949,
[?2004l[?2004h> IF(C{row}<=110, 0.971,
[?2004l[?2004h> IF(C{row}<=125, 0.997,
[?2004l[?2004h> IF(C{row}<=145, 1.020, 1.050))))))))))))
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> # Female coefficients by bodyweight
[?2004l[?2004h> female_coeff_formula = """
[?2004l[?2004h> IF(C{row}<=40, 0.897,
[?2004l[?2004h> IF(C{row}<=43, 0.903,
[?2004l[?2004h> IF(C{row}<=47, 0.924,
[?2004l[?2004h> IF(C{row}<=52, 0.949,
[?2004l[?2004h> IF(C{row}<=56, 0.971,
[?2004l[?2004h> IF(C{row}<=60, 0.994,
[?2004l[?2004h> IF(C{row}<=67.5, 1.019,
[?2004l[?2004h> IF(C{row}<=75, 1.046,
[?2004l[?2004h> IF(C{row}<=82.5, 1.073,
[?2004l[?2004h> IF(C{row}<=90, 1.099,
[?2004l[?2004h> IF(C{row}<=100, 1.125,
[?2004l[?2004h> IF(C{row}<=110, 1.149,
[?2004l[?2004h> IF(C{row}<=125, 1.175,
[?2004l[?2004h> IF(C{row}<=145, 1.199, 1.249))))))))))))
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> # Mx coefficients by bodyweight (same as male)
[?2004l[?2004h> mx_coeff_formula = male_coeff_formula
[?2004l[?2004h> 
[?2004l[?2004h> # Create the full Dots formula
[?2004l[?2004h> for row_idx in range(2, 22):  # rows 2-21
[?2004l[?2004h>     # Build the coefficient lookup
[?2004l[?2004h>     male_lookup = male_coeff_formula.format(row=row_idx).replace('\n', '')
[?2004l[?2004h>     female_lookup = female_coeff_formula.format(row=row_idx).replace('\n', '')
[?2004l[?2004h>     mx_lookup = mx_coeff_formula.format(row=row_idx).replace('\n', '')
[?2004l[?2004h>     
[?2004l[?2004h>     # Build the full formula with sex-based coefficient selection
[?2004l[?2004h>     coeff_formula = f"IF(B{row_idx}=\"M\", {male_lookup}, IF(B{row_idx}=\"F\", {female_lookup}, {mx_lookup}))"
[?2004l[?2004h>     
[?2004l[?2004h>     # Final formula: =ROUND(G{row} * coefficient, 3)
[?2004l[?2004h>     formula = f"=ROUND(G{row_idx}*{coeff_formula}, 3)"
[?2004l[?2004h>     dots_sheet.cell(row_idx, 8).value = formula
[?2004l[?2004h> 
[?2004l[?2004h> print("Dots column added with formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the workbook
[?2004l[?2004h> wb.save('/root/data/openipf.xlsx')
[?2004l[?2004h> print("Workbook saved with TotalKg and Dots columns!")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004lTotalKg column added with formulas
Dots column added with formulas
Workbook saved with TotalKg and Dots columns!
[?2004hroot@92423c4386ba:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
