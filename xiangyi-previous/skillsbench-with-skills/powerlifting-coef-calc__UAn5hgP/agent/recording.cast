[12.196335, "o", "Sheet names: ['Data', 'Dots']\r\n\r\nData sheet - First row (headers):\r\nCol 1: Name\r\nCol 2: Sex\r\nCol 3: Event\r\nCol 4: Equipment\r\nCol 5: Age\r\nCol 6: AgeClass\r\nCol 7: BirthYearClass"]
[12.19653, "o", "\r\nCol 8: Division\r\nCol 9: BodyweightKg\r\nCol 10: WeightClassKg\r\nCol 11: Best3SquatKg\r\nCol 12: Best3BenchKg\r\nCol 13: Best3DeadliftKg\r\nCol 14: Place\r\nCol 15: Tested\r\nCol 16: Country\r\nCol 17: State\r\nCol 18: Federation\r\nCol 19: ParentFederation\r\nCol 20: Date\r\nCol 21: MeetCountry\r\nCol 22: MeetState\r\nCol 23: MeetTown\r\nCol 24: MeetName\r\nCol 25: Sanctioned\r\n\r\nTotal rows in Data sheet: 21\r\n"]
[12.196606, "o", "Total columns in Data sheet: 25\r\n\r\nDots sheet - max_row: 1, max_column: 1\r\n"]
[12.212273, "o", "\u001b[?2004hroot@92423c4386ba:~# "]
[20.208444, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/root/data/openipf.xlsx')\ndata_sheet = wb['Data']\n\n# Print first few rows of data\nprint(\"Sample data rows:\")\nfor row_idx in range(2, min(5, data_sheet.max_row + 1)):\n    name = data_sheet.cell(row_idx, 1).value\n    sex = data_sheet.cell(row_idx, 2).value\n    bw = data_sheet.cell(row_idx, 9).value\n    squat = data_sheet.cell(row_idx, 11).value\n    bench = data_sheet.cell(row_idx, 12).value\n    deadlift = data_sheet.cell(row_idx, 13).value\n    print(f\"Row {row_idx}: {name}, Sex={sex}, BW={bw}, Squat={squat}, Bench={bench}, DL={deadlift}\")\n\nEOF\n"]
