[106.447843, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.44789, "o", "# Load the workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.447977, "o", "wb = load_workbook('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r"]
[106.448025, "o", "\u001b[?2004h> dots_sheet = wb['Dots']\r\n\u001b[?2004l\r"]
[106.448091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.448144, "o", "# Calculate and write values for each row\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.448191, "o", "> "]
[106.448236, "o", "for row_idx in range(2, 22):  # rows 2-21\r\n\u001b[?2004l\r"]
[106.448297, "o", "\u001b[?2004h> "]
[106.448346, "o", "    squat = dots_sheet.cell(row_idx, 4).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.448446, "o", "    bench = dots_sheet.cell(row_idx, 5).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.44857, "o", "    deadlift = dots_sheet.cell(row_idx, 6).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.448631, "o", "    sex = dots_sheet.cell(row_idx, 2).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.448713, "o", "    bw = dots_sheet.cell(row_idx, 3).value\r\n\u001b[?2004l\r"]
[106.448786, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.448842, "o", ">     # Calculate TotalKg\r\n\u001b[?2004l\r"]
[106.448893, "o", "\u001b[?2004h> "]
[106.448974, "o", "    if squat is not None and bench is not None and deadlift is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449074, "o", "        total_kg = squat + bench + deadlift\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.44918, "o", "        # Keep the formula but also set the value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449282, "o", "        dots_sheet.cell(row_idx, 7).value = total_kg\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.44934, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449391, "o", "        # Calculate Dots\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449485, "o", "        coeff = get_dots_coefficient(bw, sex)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449555, "o", "        if coeff is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449652, "o", "            dots = round(total_kg * coeff, 3)\r\n\u001b[?2004l\r"]
[106.449705, "o", "\u001b[?2004h> "]
[106.449787, "o", "            dots_sheet.cell(row_idx, 8).value = dots\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449839, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.449971, "o", "        print(f\"Row {row_idx}: TotalKg={total_kg}, Dots={dots if coeff else 'N/A'}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[106.450026, "o", "\u001b[?2004h> "]
[106.450079, "o", "# Save the workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.450126, "o", "wb.save('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.450219, "o", "print(\"\\nWorkbook saved with calculated values!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.450271, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
