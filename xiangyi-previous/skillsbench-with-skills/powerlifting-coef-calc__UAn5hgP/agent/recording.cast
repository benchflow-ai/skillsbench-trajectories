[106.447324, "o", "> "]
[106.44738, "o", "        elif bodyweight <= 100: return 0.949\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.447469, "o", "        elif bodyweight <= 110: return 0.971\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.447532, "o", "> "]
[106.44759, "o", "        elif bodyweight <= 125: return 0.997\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.447646, "o", "        elif bodyweight <= 145: return 1.020\r\n\u001b[?2004l\r"]
[106.447699, "o", "\u001b[?2004h> "]
[106.447745, "o", "        else: return 1.050\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
