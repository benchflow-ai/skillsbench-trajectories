[30.896538, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\n# Dots coefficients - standard IPF Dots formula\n# Based on bodyweight ranges for each sex\n# Format: (max_bodyweight, male_coeff, female_coeff, mx_coeff)\ndots_coefficients = [\n    (40, 0.75, 0.897, 0.75),\n    (43, 0.755, 0.903, 0.755),\n    (47, 0.765, 0.924, 0.765),\n    (52, 0.785, 0.949, 0.785),\n    (56, 0.807, 0.971, 0.807),\n    (60, 0.829, 0.994, 0.829),\n    (67.5, 0.851, 1.019, 0.851),\n    (75, 0.874, 1.046, 0.874),\n    (82.5, 0.896, 1.073, 0.896),\n    (90, 0.921, 1.099, 0.921),\n    (100, 0.949, 1.125, 0.949),\n    (110, 0.971, 1.149, 0.971),\n    (125, 0.997, 1.175, 0.997),\n    (145, 1.020, 1.199, 1.020),\n    (float('inf'), 1.050, 1.249, 1.050)  # 145+ kg\n]\n\ndef get_dots_coefficient(bodyweight, sex):\n    \"\"\"Get Dots coefficient based on bodyweight and sex\"\"\"\n    if bodyweight is None or sex is None:\n        return None\n    \n    sex_idx = {'M': 1, 'F': 2, 'Mx': 3}.get(sex, 1)\n    \n    for max_bw, m_coeff, f_coeff, mx_coeff in dots_coefficients:\n        if bodyweight <= max_bw:\n            coeffs = [m_coeff, f_coeff, mx_coeff]\n            return round(coeffs[sex_idx - 1], 3)\n    \n    return None\n\n# Load the workbook\nwb = load_workbook('/root/data/openipf.xlsx')\ndata_sheet = wb['Data']\ndots_sheet = wb['Dots']\n\n# Step 1: Copy headers to Dots sheet\nheaders = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg']\nfor col_idx, header in enumerate(headers, 1):\n    dots_sheet.cell(1, col_idx).value = header\n\n# Step 2: Copy data rows\nfor row_idx in range(2, data_sheet.max_row + 1):\n    name = data_sheet.cell(row_idx, 1).value\n    sex = data_sheet.cell(row_idx, 2).value\n    bw = data_sheet.cell(row_idx, 9).value\n    squat = data_sheet.cell(row_idx, 11).value\n    bench = data_sheet.cell(row_idx, 12).value\n    deadlift = data_sheet.cell(row_idx, 13).value\n    \n    dots_sheet.cell(row_idx, 1).value = name\n    dots_sheet.cell(row_idx, 2).value = sex\n    dots_sheet.cell(row_idx, 3).value = bw\n    dots_sheet.cell(row_idx, 4).value = squat\n    dots_sheet.cell(row_idx, 5).value = bench\n    dots_sheet.cell(row_idx, 6).value = deadlift\n\nprint(\"Data copied successfully!\")\nprint(f\"Rows copied: {data_sheet.max_row - 1}\")\n\n# Save the workbook\nwb.save('/root/data/openipf.xlsx')\nprint(\"Workbook saved!\")\n\nEOF\n"]
