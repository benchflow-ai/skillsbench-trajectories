[30.897744, "o", "    (60, 0.829, 0.994, 0.829),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.897785, "o", "    (67.5, 0.851, 1.019, 0.851),\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.89783, "o", "> "]
[30.897881, "o", "    (75, 0.874, 1.046, 0.874),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.897925, "o", "    (82.5, 0.896, 1.073, 0.896),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898019, "o", "    (90, 0.921, 1.099, 0.921),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898071, "o", "    (100, 0.949, 1.125, 0.949),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898105, "o", "    (110, 0.971, 1.149, 0.971),\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.898146, "o", "> "]
[30.898191, "o", "    (125, 0.997, 1.175, 0.997),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898236, "o", "    (145, 1.020, 1.199, 1.020),\r\n\u001b[?2004l\r"]
[30.898281, "o", "\u001b[?2004h> "]
[30.898328, "o", "    (float('inf'), 1.050, 1.249, 1.050)  # 145+ kg\r\n\u001b[?2004l\r"]
[30.898377, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[30.898429, "o", "\u001b[?2004h> "]
[30.898473, "o", "def get_dots_coefficient(bodyweight, sex):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898571, "o", "    \"\"\"Get Dots coefficient based on bodyweight and sex\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.898618, "o", "> "]
[30.898664, "o", "    if bodyweight is None or sex is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.89871, "o", ">         return None\r\n\u001b[?2004l\r"]
[30.898763, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.898818, "o", "    sex_idx = {'M': 1, 'F': 2, 'Mx': 3}.get(sex, 1)\r\n\u001b[?2004l\r"]
[30.898843, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[30.898909, "o", "\u001b[?2004h> "]
[30.898961, "o", "    for max_bw, m_coeff, f_coeff, mx_coeff in dots_coefficients:\r\n\u001b[?2004l\r"]
[30.899061, "o", "\u001b[?2004h>         if bodyweight <= max_bw:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.899113, "o", "            coeffs = [m_coeff, f_coeff, mx_coeff]\r\n\u001b[?2004l\r"]
[30.899156, "o", "\u001b[?2004h> "]
[30.899203, "o", "            return round(coeffs[sex_idx - 1], 3)\r\n\u001b[?2004l\r"]
[30.899255, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.899306, "o", ">     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[30.899349, "o", "> # Load the workbook\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.899396, "o", "> "]
[30.899447, "o", "wb = load_workbook('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.899496, "o", "> data_sheet = wb['Data']\r\n\u001b[?2004l\r"]
[30.899553, "o", "\u001b[?2004h> dots_sheet = wb['Dots']\r\n\u001b[?2004l\r"]
[30.899603, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.899641, "o", "# Step 1: Copy headers to Dots sheet\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.89968, "o", "> "]
[30.89981, "o", "headers = ['Name', 'Sex', 'BodyweightKg', 'Best3SquatKg', 'Best3BenchKg', 'Best3DeadliftKg']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.899881, "o", "for col_idx, header in enumerate(headers, 1):\r\n\u001b[?2004l\r"]
[30.899936, "o", "\u001b[?2004h> "]
[30.899976, "o", "    dots_sheet.cell(1, col_idx).value = header\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[30.900033, "o", "\u001b[?2004h> "]
[30.900084, "o", "# Step 2: Copy data rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.900133, "o", "for row_idx in range(2, data_sheet.max_row + 1):\r\n\u001b[?2004l\r"]
[30.900186, "o", "\u001b[?2004h> "]
[30.900231, "o", "    name = data_sheet.cell(row_idx, 1).value\r\n\u001b[?2004l\r"]
[30.900287, "o", "\u001b[?2004h> "]
[30.900337, "o", "    sex = data_sheet.cell(row_idx, 2).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.900403, "o", "    bw = data_sheet.cell(row_idx, 9).value\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.900455, "o", "> "]
[30.900497, "o", "    squat = data_sheet.cell(row_idx, 11).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.900586, "o", "    bench = data_sheet.cell(row_idx, 12).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.900669, "o", "    deadlift = data_sheet.cell(row_idx, 13).value\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.900714, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.900788, "o", "    dots_sheet.cell(row_idx, 1).value = name\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.90084, "o", "> "]
[30.900886, "o", "    dots_sheet.cell(row_idx, 2).value = sex\r\n\u001b[?2004l\r"]
[30.900934, "o", "\u001b[?2004h> "]
[30.900982, "o", "    dots_sheet.cell(row_idx, 3).value = bw\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901037, "o", "    dots_sheet.cell(row_idx, 4).value = squat\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.901088, "o", "> "]
[30.901133, "o", "    dots_sheet.cell(row_idx, 5).value = bench\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.901181, "o", "> "]
[30.901229, "o", "    dots_sheet.cell(row_idx, 6).value = deadlift\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[30.901279, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[30.901328, "o", "print(\"Data copied successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901397, "o", "print(f\"Rows copied: {data_sheet.max_row - 1}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901442, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901487, "o", "# Save the workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901529, "o", "wb.save('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[30.901576, "o", "> "]
[30.901622, "o", "print(\"Workbook saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.901668, "o", "EOF\r\n\u001b[?2004l\r"]
[31.006817, "o", "Data copied successfully!\r\nRows copied: 20\r\n"]
[31.093342, "o", "Workbook saved!\r\n"]
[31.108905, "o", "\u001b[?2004hroot@92423c4386ba:~# "]
[43.186108, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/root/data/openipf.xlsx')\ndots_sheet = wb['Dots']\n\n# Step 2: Add TotalKg column header\ndots_sheet.cell(1, 7).value = 'TotalKg'\n\n# Step 3: Add TotalKg formulas for each row\nfor row_idx in range(2, 22):  # rows 2-21\n    # Formula: =D{row} + E{row} + F{row}\n    formula = f\"=D{row_idx}+E{row_idx}+F{row_idx}\"\n    dots_sheet.cell(row_idx, 7).value = formula\n\nprint(\"TotalKg column added with formulas\")\n\n# Step 4: Add Dots column header\ndots_sheet.cell(1, 8).value = 'Dots'\n\n# Create a complex formula for Dots calculation\n# The formula needs to:\n# 1. Look up the coefficient based on Sex (column B) and BodyweightKg (column C)\n# 2. Multiply TotalKg (column G) by the coefficient\n# 3. Round to 3 decimal places\n\n# Dots coefficients lookup - we'll create nested IFs\n# Structure: IF(Sex=\"M\", male_coeff_lookup, IF(Sex=\"F\", female_coeff_lookup, mx_coeff_lookup))\n\n# Male coefficients by bodyweight\nmale_coeff_formula = \"\"\"\nIF(C{row}<=40, 0.75,\nIF(C{row}<=43, 0.755,\nIF(C{row}<=47, 0.765,\nIF(C{row}<=52, 0.785,\nIF(C{row}<=56, 0.807,\nIF(C{row}<=60, 0.829,\nIF(C{row}<=67.5, 0.851,\nIF(C{row}<=75, 0.874,\nIF(C{row}<=82.5, 0.896,\nIF(C{row}<=90, 0.921,\nIF(C{row}<=100, 0.949,\nIF(C{row}<=110, 0.971,\nIF(C{row}<=125, 0.997,\nIF(C{row}<=145, 1.020, 1.050))))))))))))\n\"\"\"\n\n# Female coefficients by bodyweight\nfemale_coeff_formula = \"\"\"\nIF(C{row}<=40, 0.897,\nIF(C{row}<=43, 0.903,\nIF(C{row}<=47, 0.924,\nIF(C{row}<=52, 0.949,\nIF(C{row}<=56, 0.971,\nIF(C{row}<=60, 0.994,\nIF(C{row}<=67.5, 1.019,\nIF(C{row}<=75, 1.046,\nIF(C{row}<=82.5, 1.073,\nIF(C{row}<=90, 1.099,\nIF(C{row}<=100, 1.125,\nIF(C{row}<=110, 1.149,\nIF(C{row}<=125, 1.175,\nIF(C{row}<=145, 1.199, 1.249))))))))))))\n\"\"\"\n\n# Mx coefficients by bodyweight (same as male)\nmx_coeff_formula = male_coeff_formula\n\n# Create the full Dots formula\nfor row_idx in range(2, 22):  # rows 2-21\n    # Build the coefficient lookup\n    male_lookup = male_coeff_formula.format(row=row_idx).replace('\\n', '')\n    female_lookup = female_coeff_formula.format(row=row_idx).replace('\\n', '')\n    mx_lookup = mx_coeff_formula.format(row=row_idx).replace('\\n', '')\n    \n    # Build the full formula with sex-based coefficient selection\n    coeff_formula = f\"IF(B{row_idx}=\\\"M\\\", {male_lookup}, IF(B{row_idx}=\\\"F\\\", {female_lookup}, {mx_lookup}))\"\n    \n    # Final formula: =ROUND(G{row} * coefficient, 3)\n    formula = f\"=ROUND(G{row_idx}*{coeff_formula}, 3)\"\n    dots_sheet.cell(row_idx, 8).value = formula\n\nprint(\"Dots column added with formulas\")\n\n# Save the workbook\nwb.save('/root/data/openipf.xlsx')\nprint(\"Workbook saved with TotalKg and Dots columns!\")\n\nEOF\n"]
[43.192856, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load the workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb = load_workbook('/root/data/openipf.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> dots_sheet = wb['Dots']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Step 2: Add TotalKg column header\r\n\u001b[?2004l\r\u001b[?2004h> dots_sheet.cell(1, 7).value = 'TotalKg'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Step 3: Add TotalKg formulas for each row\r\n\u001b[?2004l\r\u001b[?2004h> for row_idx in range(2, 22):  # rows 2-21\r\n\u001b[?2004l\r\u001b[?2004h>     # Formula: =D{row} + E{row} + F{row}\r\n\u001b[?2004l\r\u001b[?2004h>     formula = f\"=D{row_idx}+E{row_idx}+F{row_idx}\"\r\n\u001b[?2004l\r\u001b[?2004h>     dots_sheet.cell(row_idx, 7).value = formula\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"TotalKg column added with formulas\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Step 4: Add Dots column header\r\n\u001b[?2004l\r\u001b[?2004h> dots_sheet.cell(1, 8).value = 'Dots'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create a complex formula for Dots calculation\r\n\u001b[?2004l\r\u001b[?2004h> # The formula needs to:\r\n\u001b[?2004l\r\u001b[?2004h> # 1. Look up the coefficient based on Sex (column B) and BodyweightKg (column C)\r\n\u001b[?2004l\r\u001b[?2004h> # 2. Multiply TotalKg (column G) by the coefficient\r\n\u001b[?2004l\r\u001b[?2004h> # 3. Round to 3 decimal places\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Dots coefficients lookup - we'll create nested IFs\r\n\u001b[?2004l\r\u001b[?2004h> # Structure: IF(Sex=\"M\", male_coeff_lookup, IF(Sex=\"F\", female_coeff_lookup, mx_coeff_lookup))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Male coefficients by bodyweight\r\n\u001b[?2004l\r\u001b[?2004h> male_coeff_formula = \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=40, 0.75,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=43, 0.755,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=47, 0.765,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=52, 0.785,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=56, 0.807,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=60, 0.829,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=67.5, 0.851,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=75, 0.874,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=82.5, 0.896,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=90, 0.921,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=100, 0.949,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=110, 0.971,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=125, 0.997,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=145, 1.020, 1.050))))))))))))\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Female coefficients by bodyweight\r\n\u001b[?2004l\r\u001b[?2004h> female_coeff_formula = \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=40, 0.897,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=43, 0.903,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=47, 0.924,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=52, 0.949,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=56, 0.971,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=60, 0.994,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=67.5, 1.019,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=75, 1.046,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=82.5, 1.073,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=90, 1.099,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=100, 1.125,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=110, 1.149,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=125, 1.175,\r\n\u001b[?2004l\r\u001b[?2004h> IF(C{row}<=145, 1.199, 1.249))))))))))))\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Mx coefficients by bodyweight (same as male)\r\n\u001b[?2004l\r\u001b[?2004h> mx_coeff_formula = male_coeff_formula\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create the full Dots formula\r\n\u001b[?2004l\r\u001b[?2004h> for row_idx in range(2, 22):  # rows 2-21\r\n\u001b[?2004l\r\u001b[?2004h>     # Build the coefficient lookup\r\n\u001b[?2004l\r\u001b[?2004h>     male_lookup = male_coeff_formula.format(row=row_idx).replace('\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h>     female_lookup = female_coeff_formula.format(row=row_idx).replace('\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h>     mx_lookup = mx_coeff_formula.format(row=row_idx).replace('\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
