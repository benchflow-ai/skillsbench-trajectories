[59.204573, "i", "python3 << 'EOF'\n# Manual verification of Dots calculation\n# Row 2: Julien Comte, M, BW=82.25, Squat=215, Bench=132.5, DL=260\n\nname = \"Julien Comte\"\nsex = \"M\"\nbw = 82.25\nsquat = 215\nbench = 132.5\ndeadlift = 260\n\n# TotalKg\ntotal = squat + bench + deadlift\nprint(f\"TotalKg: {total}\")\n\n# Get coefficient for male at 82.25kg\n# 82.25 is between 75 and 82.5, so use 0.896\nif bw <= 82.5:\n    coeff = 0.896\nelse:\n    coeff = 0.921\n\nprint(f\"Coefficient for {sex} at {bw}kg: {coeff}\")\n\n# Dots\ndots = round(total * coeff, 3)\nprint(f\"Dots: {dots}\")\n\nprint(f\"\\nExpected for {name}: TotalKg={total}, Dots={dots}\")\n\nEOF\n"]
