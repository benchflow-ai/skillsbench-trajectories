[106.442261, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Dots coefficients lookup function\ndef get_dots_coefficient(bodyweight, sex):\n    \"\"\"Get Dots coefficient based on bodyweight and sex\"\"\"\n    if bodyweight is None or sex is None:\n        return None\n    \n    # Male coefficients\n    if sex == 'M':\n        if bodyweight <= 40: return 0.75\n        elif bodyweight <= 43: return 0.755\n        elif bodyweight <= 47: return 0.765\n        elif bodyweight <= 52: return 0.785\n        elif bodyweight <= 56: return 0.807\n        elif bodyweight <= 60: return 0.829\n        elif bodyweight <= 67.5: return 0.851\n        elif bodyweight <= 75: return 0.874\n        elif bodyweight <= 82.5: return 0.896\n        elif bodyweight <= 90: return 0.921\n        elif bodyweight <= 100: return 0.949\n        elif bodyweight <= 110: return 0.971\n        elif bodyweight <= 125: return 0.997\n        elif bodyweight <= 145: return 1.020\n        else: return 1.050\n    \n    # Female coefficients\n    elif sex == 'F':\n        if bodyweight <= 40: return 0.897\n        elif bodyweight <= 43: return 0.903\n        elif bodyweight <= 47: return 0.924\n        elif bodyweight <= 52: return 0.949\n        elif bodyweight <= 56: return 0.971\n        elif bodyweight <= 60: return 0.994\n        elif bodyweight <= 67.5: return 1.019\n        elif bodyweight <= 75: return 1.046\n        elif bodyweight <= 82.5: return 1.073\n        elif bodyweight <= 90: return 1.099\n        elif bodyweight <= 100: return 1.125\n        elif bodyweight <= 110: return 1.149\n        elif bodyweight <= 125: return 1.175\n        elif bodyweight <= 145: return 1.199\n        else: return 1.249\n    \n    # Mx coefficients (same as male)\n    elif sex == 'Mx':\n        if bodyweight <= 40: return 0.75\n        elif bodyweight <= 43: return 0.755\n        elif bodyweight <= 47: return 0.765\n        elif bodyweight <= 52: return 0.785\n        elif bodyweight <= 56: return 0.807\n        elif bodyweight <= 60: return 0.829\n        elif bodyweight <= 67.5: return 0.851\n        elif bodyweight <= 75: return 0.874\n        elif bodyweight <= 82.5: return 0.896\n        elif bodyweight <= 90: return 0.921\n        elif bodyweight <= 100: return 0.949\n        elif bodyweight <= 110: return 0.971\n        elif bodyweight <= 125: return 0.997\n        elif bodyweight <= 145: return 1.020\n        else: return 1.050\n    \n    return None\n\n# Load the workbook\nwb = load_workbook('/root/data/openipf.xlsx')\ndots_sheet = wb['Dots']\n\n# Calculate and write values for each row\nfor row_idx in range(2, 22):  # rows 2-21\n    squat = dots_sheet.cell(row_idx, 4).value\n    bench = dots_sheet.cell(row_idx, 5).value\n    deadlift = dots_sheet.cell(row_idx, 6).value\n    sex = dots_sheet.cell(row_idx, 2).value\n    bw = dots_sheet.cell(row_idx, 3).value\n    \n    # Calculate TotalKg\n    if squat is not None and bench is not None and deadlift is not None:\n        total_kg = squat + bench + deadlift\n        # Keep the formula but also set the value\n        dots_sheet.cell(row_idx, 7).value = total_kg\n        \n        # Calculate Dots\n        coeff = get_dots_coefficient(bw, sex)\n        if coeff is not None:\n            dots = round(total_kg * coeff, 3)\n            dots_sheet.cell(row_idx, 8).value = dots\n        \n        print(f\"Row {row_idx}: TotalKg={total_kg}, Dots={dots if coeff else 'N/A'}\")\n\n# Save the workbook\nwb.save('/root/data/openipf.xlsx')\nprint(\"\\nWorkbook saved with calculated values!\")\n\nEOF\n"]
[106.442518, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[106.442622, "o", "\u001b[?2004h> "]
[106.442745, "o", "import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.442826, "o", "# Dots coefficients lookup function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.442891, "o", "def get_dots_coefficient(bodyweight, sex):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.442988, "o", "    \"\"\"Get Dots coefficient based on bodyweight and sex\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.443065, "o", "    if bodyweight is None or sex is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.443091, "o", "> "]
