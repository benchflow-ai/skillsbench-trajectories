[51.653681, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/root/data/openipf.xlsx', data_only=False)\ndots_sheet = wb['Dots']\n\nprint(\"Verification of Dots sheet:\")\nprint(\"\\nHeaders:\")\nfor col_idx in range(1, 9):\n    header = dots_sheet.cell(1, col_idx).value\n    print(f\"Col {col_idx}: {header}\")\n\nprint(\"\\nFirst few data rows (with formulas):\")\nfor row_idx in range(2, 5):\n    name = dots_sheet.cell(row_idx, 1).value\n    sex = dots_sheet.cell(row_idx, 2).value\n    bw = dots_sheet.cell(row_idx, 3).value\n    squat = dots_sheet.cell(row_idx, 4).value\n    bench = dots_sheet.cell(row_idx, 5).value\n    deadlift = dots_sheet.cell(row_idx, 6).value\n    total_formula = dots_sheet.cell(row_idx, 7).value\n    dots_formula = dots_sheet.cell(row_idx, 8).value\n    \n    print(f\"\\nRow {row_idx}: {name}\")\n    print(f\"  Sex: {sex}, BW: {bw}kg\")\n    print(f\"  Lifts: Squat={squat}, Bench={bench}, DL={deadlift}\")\n    print(f\"  TotalKg formula: {total_formula}\")\n    print(f\"  Dots formula (first 100 chars): {str(dots_formula)[:100]}...\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"Now loading with data_only=True to see calculated values...\")\nwb_data = load_workbook('/root/data/openipf.xlsx', data_only=True)\ndots_sheet_data = wb_data['Dots']\n\nprint(\"\\nCalculated values (first few rows):\")\nfor row_idx in range(2, 5):\n    name = dots_sheet_data.cell(row_idx, 1).value\n    total_kg = dots_sheet_data.cell(row_idx, 7).value\n    dots = dots_sheet_data.cell(row_idx, 8).value\n    print(f\"Row {row_idx}: {name} - TotalKg: {total_kg}, Dots: {dots}\")\n\nEOF\n"]
