[?2004hroot@2faff0194c1f:~# python3 << 'ENDSCRIPT'
[?2004l[?2004h> from pypdf import PdfReader, PdfWriter
[?2004l[?2004h> 
[?2004l[?2004h> # Read the blank form
[?2004l[?2004h> reader = PdfReader('/root/sc100-blank.pdf')
[?2004l[?2004h> writer = PdfWriter()
[?2004l[?2004h> 
[?2004l[?2004h> # Add all pages from the reader
[?2004l[?2004h> for page in reader.pages:
[?2004l[?2004h>     writer.add_page(page)
[?2004l[?2004h> 
[?2004l[?2004h> # Define the field values to fill
[?2004l[?2004h> field_updates = {
[?2004l[?2004h>     # Court info - Santa Clara County (where defendant lives - Sunnyvale)
[?2004l[?2004h>     'SC-100[0].Page1[0].CaptionRight[0].County[0].CourtInfo[0]': 'Santa Clara',
[?2004l[?2004h>     
[?2004l[?2004h>     # Plaintiff 1 info
[?2004l[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffName1[0]': 'Joyce He',
[?2004l[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffAddress1[0]': '655 S Fair Oaks Ave',
[?2004l[?2004h>     'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffCity1[0]': 'Sunnyvale',
