[176.180681, "i", "python3 << 'ENDSCRIPT'\nimport fitz\n\ndoc = fitz.open('/root/sc100-filled.pdf')\n\nprint('=== Filled Form Fields ===')\nfor page_num, page in enumerate(doc):\n    for widget in page.widgets():\n        if widget.field_value and widget.field_value != 'Off' and widget.field_value != '':\n            print(f'Page {page_num+1}: {widget.field_name} = \"{widget.field_value}\"')\n\ndoc.close()\nENDSCRIPT\n"]
