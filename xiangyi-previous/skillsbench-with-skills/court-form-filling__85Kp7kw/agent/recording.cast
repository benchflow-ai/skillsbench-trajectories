[154.929728, "i", "python3 << 'ENDSCRIPT'\nimport fitz  # PyMuPDF\n\n# Open the PDF\ndoc = fitz.open('/root/sc100-blank.pdf')\n\n# Define all field values to fill\ntext_fields = {\n    # Court info - Santa Clara County\n    'SC-100[0].Page1[0].CaptionRight[0].County[0].CourtInfo[0]': 'Santa Clara',\n    \n    # Plaintiff 1 info\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffName1[0]': 'Joyce He',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffAddress1[0]': '655 S Fair Oaks Ave',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffCity1[0]': 'Sunnyvale',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffState1[0]': 'CA',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffZip1[0]': '94086',\n    'SC-100[0].Page2[0].List1[0].Item1[0].PlaintiffPhone1[0]': '4125886066',\n    'SC-100[0].Page2[0].List1[0].Item1[0].EmailAdd1[0]': 'he1998@gmail.com',\n    \n    # Defendant 1 info\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantName1[0]': 'Zhi Chen',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantAddress1[0]': '299 W Washington Ave',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantCity1[0]': 'Sunnyvale',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantState1[0]': 'CA',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantZip1[0]': '94086',\n    'SC-100[0].Page2[0].List2[0].item2[0].DefendantPhone1[0]': '5125658878',\n    \n    # Claim amount\n    'SC-100[0].Page2[0].List3[0].PlaintiffClaimAmount1[0]': '1500.00',\n    \n    # Why defendant owes money\n    'SC-100[0].Page2[0].List3[0].Lia[0].FillField2[0]': 'Defendant failed to return my security deposit of $1500 based on the signed roommate sublease contract after moving out.',\n    \n    # When did this happen - date range\n    'SC-100[0].Page3[0].List3[0].Lib[0].Date2[0]': '2025-09-30',\n    'SC-100[0].Page3[0].List3[0].Lib[0].Date3[0]': '2026-01-19',\n    \n    # How calculated\n    'SC-100[0].Page3[0].List3[0].Lic[0].FillField1[0]': 'The amount is listed on the signed roommate sublease contract.',\n    \n    # Zip code for venue\n    'SC-100[0].Page3[0].List6[0].item6[0].ZipCode1[0]': '94086',\n    \n    # Plaintiff name on page 3\n    'SC-100[0].Page3[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\n    \n    # Plaintiff name on page 4\n    'SC-100[0].Page4[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\n    \n    # Signature section - plaintiff name and date\n    'SC-100[0].Page4[0].Sign[0].PlaintiffName1[0]': 'Joyce He',\n    'SC-100[0].Page4[0].Sign[0].Date1[0]': '2026-01-19',\n}\n\n# Checkboxes to check (set to True/Yes)\ncheckboxes_on = [\n    'SC-100[0].Page3[0].List4[0].Item4[0].Checkbox50[0]',  # Asked defendant to pay - Yes\n    'SC-100[0].Page3[0].List5[0].Lia[0].Checkbox5cb[0]',   # Venue - where defendant lives\n    'SC-100[0].Page3[0].List8[0].item8[0].Checkbox61[1]',  # Not suing a public entity - No\n    'SC-100[0].Page4[0].List9[0].Item9[0].Checkbox62[1]',  # Have not filed more than 12 claims - No\n    'SC-100[0].Page4[0].List10[0].li10[0].Checkbox63[1]',  # Claim is not for more than $2500 - No\n]\n\n# Fill all pages\nfor page in doc:\n    for widget in page.widgets():\n        field_name = widget.field_name\n        \n        # Fill text fields\n        if field_name in text_fields:\n            widget.field_value = text_fields[field_name]\n            widget.update()\n            print(f'Filled: {field_name} = {text_fields[field_name]}')\n        \n        # Check checkboxes\n        if field_name in checkboxes_on:\n            widget.field_value = True\n            widget.update()\n            print(f'Checked: {field_name}')\n\n# Save the filled PDF\ndoc.save('/root/sc100-filled.pdf')\ndoc.close()\n\nprint('\\nPDF filled and saved successfully!')\nENDSCRIPT\n"]
