[154.941835, "o", "    'SC-100[0].Page3[0].List6[0].item6[0].ZipCode1[0]': '94086',\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Plaintiff name on page 3\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page3[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Plaintiff name on page 4\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page4[0].PxCaption[0].Plaintiff[0]': 'Joyce He',\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Signature section - plaintiff name and date\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page4[0].Sign[0].PlaintiffName1[0]': 'Joyce He',\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page4[0].Sign[0].Date1[0]': '2026-01-19',\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Checkboxes to check (set to True/Yes)\r\n\u001b[?2004l\r\u001b[?2004h> checkboxes_on = [\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page3[0].List4[0].Item4[0].Checkbox50[0]',  # Asked defendant to pay - Yes\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page3[0].List5[0].Lia[0].Checkbox5cb[0]',   # Venue - where defendant lives\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page3[0].List8[0].item8[0].Checkbox61[1]',  # Not suing a public entity - No\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page4[0].List9[0].Item9[0].Checkbox62[1]',  # Have not filed more than 12 claims - No\r\n\u001b[?2004l\r\u001b[?2004h>     'SC-100[0].Page4[0].List10[0].li10[0].Checkbox63[1]',  # Claim is not for more than $2500 - No\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fill all pages\r\n\u001b[?2004l\r\u001b[?2004h> for page in doc:\r\n\u001b[?2004l\r\u001b[?2004h>     for widget in page.widgets():\r\n\u001b[?2004l\r\u001b[?2004h>         field_name = widget.field_name\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Fill text fields\r\n\u001b[?2004l\r\u001b[?2004h>         if field_name in text_fields:\r\n\u001b[?2004l\r\u001b[?2004h>             widget.field_value = text_fields[field_name]\r\n\u001b[?2004l\r\u001b[?2004h>             widget.update()\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'Filled: {field_name} = {text_fields[field_name]}')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Check checkboxes\r\n\u001b[?2004l\r\u001b[?2004h>         if field_name in checkboxes_on:\r\n\u001b[?2004l\r\u001b[?2004h>             widget.field_value = True\r\n\u001b[?2004l\r\u001b[?2004h>             widget.update()\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'Checked: {field_name}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save the filled PDF\r\n\u001b[?2004l\r\u001b[?2004h> doc.save('/root/sc100-filled.pdf')\r\n\u001b[?2004l\r\u001b[?2004h> doc.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('\\nPDF filled and saved successfully!')\r\n"]
