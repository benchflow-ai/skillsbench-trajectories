[57.651681, "i", "python3 << 'EOF'\nimport pypdf\nreader = pypdf.PdfReader('/root/sc100-blank.pdf')\nfields = reader.get_fields()\nif fields:\n    for field_name, field_info in sorted(fields.items()):\n        if 'Lia' in field_name or '5a' in field_name.lower() or 'checkbox5' in field_name.lower():\n            tu = field_info.get('/TU', '')\n            ft = field_info.get('/FT', '')\n            states = field_info.get('/_States_', '')\n            print(f'{field_name} | {ft} | {tu} | {states}')\nEOF\n"]
