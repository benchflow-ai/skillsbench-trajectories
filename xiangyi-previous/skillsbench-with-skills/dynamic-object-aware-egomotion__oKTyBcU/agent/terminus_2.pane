[?2004hroot@9da2291a665c:~# cat << 'EOF' > solution.py
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> def get_csr(mask):
[?2004l[?2004h>     # mask is HxW boolean array
[?2004l[?2004h>     # CSR representation: data, indices, indptr
[?2004l[?2004h>     # Since it's a binary mask, 'data' is just all True values
[?2004l[?2004h>     rows, cols = np.where(mask)
[?2004l[?2004h>     data = np.ones(len(rows), dtype=bool)
[?2004l[?2004h>     indices = cols.astype(np.int32)
[?2004l[?2004h>     
[?2004l[?2004h>     H, W = mask.shape
[?2004l[?2004h>     indptr = np.zeros(H + 1, dtype=np.int32)
[?2004l[?2004h>     counts = np.bincount(rows, minlength=H)
[?2004l[?2004h>     indptr[1:] = np.cumsum(counts)
[?2004l[?2004h>     return data, indices, indptr
[?2004l[?2004h> 
[?2004l[?2004h> video_path = '/root/input.mp4'
[?2004l[?2004h> cap = cv2.VideoCapture(video_path)
[?2004l[?2004h> original_fps = cap.get(cv2.CAP_PROP_FPS)
[?2004l[?2004h> target_fps = 6
[?2004l[?2004h> skip = max(1, int(round(original_fps / target_fps)))
[?2004l[?2004h> 
[?2004l[?2004h> frames = []
[?2004l[?2004h> count = 0
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, frame = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     if count % skip == 0:
[?2004l[?2004h>         frames.append(frame)
[?2004l[?2004h>     count += 1
[?2004l[?2004h> cap.release()
[?2004l[?2004h> 
[?2004l[?2004h> labels_dict = {}
[?2004l[?2004h> masks_data = {}
[?2004l[?2004h> 
[?2004l[?2004h> H, W = frames[0].shape[:2]
[?2004l[?2004h> masks_data['shape'] = np.array([H, W])
[?2004l[?2004h> 
[?2004l[?2004h> orb = cv2.ORB_create(nfeatures=2000)
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(len(frames) - 1):
[?2004l[?2004h>     f1 = frames[i]
[?2004l[?2004h>     f2 = frames[i+1]
[?2004l[?2004h>     
[?2004l[?2004h>     gray1 = cv2.cvtColor(f1, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     gray2 = cv2.cvtColor(f2, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     
[?2004l[?2004h>     kp1, des1 = orb.detectAndCompute(gray1, None)
[?2004l[?2004h>     kp2, des2 = orb.detectAndCompute(gray2, None)
[?2004l[?2004h>     
[?2004l[?2004h>     bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
[?2004l[?2004h>     matches = bf.match(des1, des2)
[?2004l[?2004h>     matches = sorted(matches, key=lambda x: x.distance)
[?2004l[?2004h>     
[?2004l[?2004h>     src_pts = np.float32([kp1[m.queryIdx].pt for m in matches]).reshape(-1, 1, 2)
[?2004l[?2004h>     dst_pts = np.float32([kp2[m.trainIdx].pt for m in matches]).reshape(-1, 1, 2)
[?2004l[?2004h>     
[?2004l[?2004h>     # Estimate transformation (Rotation, Translation, Scale)
[?2004l[?2004h>     M, inliers = cv2.estimateAffinePartial2D(src_pts, dst_pts, method=cv2.RANSAC, ransacReprojThreshold=3.0)
[?2004l[?2004h>     
[?2004l[?2004h>     motion_labels = []
[?2004l[?2004h>     if M is not None:
[?2004l[?2004h>         tx = M[0, 2]
[?2004l[?2004h>         ty = M[1, 2]
[?2004l[?2004h>         s = np.sqrt(M[0, 0]**2 + M[0, 1]**2)
[?2004l[?2004h>         angle = np.arctan2(M[1, 0], M[0, 1]) # simplified rotation check
[?2004l[?2004h>         # More robust angle
[?2004l[?2004h>         angle = np.arctan2(M[1, 0], M[0, 0])
[?2004l[?2004h>         
[?2004l[?2004h>         # Thresholds for labels (tuning might be needed)
[?2004l[?2004h>         if abs(tx) > 1.5: motion_labels.append("Pan Left" if tx > 0 else "Pan Right")
[?2004l[?2004h>         if abs(ty) > 1.5: motion_labels.append("Tilt Down" if ty > 0 else "Tilt Up")
[?2004l[?2004h>         if s > 1.005: motion_labels.append("Dolly In")
[?2004l[?2004h>         elif s < 0.995: motion_labels.append("Dolly Out")
[?2004l[?2004h>         if abs(angle) > 0.005:
[?2004l[?2004h>             motion_labels.append("Roll Left" if angle < 0 else "Roll Right")
[?2004l[?2004h>             
[?2004l[?2004h>     if not motion_labels:
[?2004l[?2004h>         motion_labels.append("Stay")
[?2004l[?2004h>     
[?2004l[?2004h>     labels_dict[f"{i}->{i+1}"] = motion_labels
[?2004l[?2004h>     
[?2004l[?2004h>     # Dynamic object detection
[?2004l[?2004h>     if M is not None:
[?2004l[?2004h>         warped_f1 = cv2.warpAffine(f1, M, (W, H))
[?2004l[?2004h>         diff = cv2.absdiff(warped_f1, f2)
[?2004l[?2004h>         diff_gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>         _, mask = cv2.threshold(diff_gray, 30, 255, cv2.THRESH_BINARY)
[?2004l[?2004h>         # Clean up mask
[?2004l[?2004h>         kernel = np.ones((5,5), np.uint8)
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_DILATE, kernel)
[?2004l[?2004h>     else:
[?2004l[?2004h>         mask = np.zeros((H, W), dtype=np.uint8)
[?2004l[?2004h>         
[?2004l[?2004h>     binary_mask = mask > 0
[?2004l[?2004h>     data, indices, indptr = get_csr(binary_mask)
[?2004l[?2004h>     masks_data[f"f_{i}_data"] = data
[?2004l[?2004h>     masks_data[f"f_{i}_indices"] = indices
[?2004l[?2004h>     masks_data[f"f_{i}_indptr"] = indptr
[?2004l[?2004h> 
[?2004l[?2004h> # Last frame mask (empty or repeat last)
[?2004l[?2004h> last_idx = len(frames) - 1
[?2004l[?2004h> data, indices, indptr = get_csr(np.zeros((H, W), dtype=bool))
[?2004l[?2004h> masks_data[f"f_{last_idx}_data"] = data
[?2004l[?2004h> masks_data[f"f_{last_idx}_indices"] = indices
[?2004l[?2004h> masks_data[f"f_{last_idx}_indptr"] = indptr
[?2004l[?2004h> 
[?2004l[?2004h> with open('/root/pred_instructions.json', 'w') as f:
[?2004l[?2004h>     json.dump(labels_dict, f, indent=2)
[?2004l[?2004h> 
