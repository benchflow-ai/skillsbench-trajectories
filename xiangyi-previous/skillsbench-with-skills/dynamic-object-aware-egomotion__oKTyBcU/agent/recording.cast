[42.082205, "o", "-rw-r--r-- 1 root root 22807449 Jan 26 11:17 /root/pred_dyn_masks.npz\r\n-rw-r--r-- 1 root root     1322 Jan 26 11:17 /root/pred_instructions.json\r\n\u001b[?2004hroot@9da2291a665c:~# "]
[42.253901, "i", "head -n 20 /root/pred_instructions.json\n"]
[42.254277, "o", "head -n 20 /root/pred_instructions.json\r\n\u001b[?2004l\r"]
[42.255367, "o", "{\r\n  \"0->1\": [\r\n    \"Pan Right\",\r\n    \"Tilt Up\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"1->2\": [\r\n    \"Pan Right\",\r\n    \"Tilt Up\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"2->3\": [\r\n    \"Pan Right\",\r\n    \"Tilt Up\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"3->4\": [\r\n    \"Pan Right\",\r\n    \"Tilt Up\",\r\n    \"Dolly In\"\r\n"]
[42.255544, "o", "\u001b[?2004hroot@9da2291a665c:~# "]
[42.404327, "i", "python3 -c \"import numpy as np; data = np.load('/root/pred_dyn_masks.npz'); print('Keys:', list(data.keys())[:10]); print('Shape:', data['shape'])\"\n"]
[42.404923, "o", "python3 -c \"import numpy as np; data = np.load('/root/pred_dyn_masks.npz'); print('Keys:', list(data.keys())[:10]); print('Shape:', data['shape'])\"\r\n\u001b[?2004l\r"]
[42.758741, "o", "Keys: ['shape', 'f_0_data', 'f_0_indices', 'f_0_indptr', 'f_1_data', 'f_1_indices', 'f_1_indptr', 'f_2_data', 'f_2_indices', 'f_2_indptr']\r\n"]
[42.759237, "o", "Shape: [ 720 1280]\r\n"]
[42.778063, "o", "\u001b[?2004hroot@9da2291a665c:~# "]
[81.964409, "i", "cat << 'EOF' > solution.py\nimport cv2\nimport numpy as np\nimport json\n\ndef get_csr(mask):\n    rows, cols = np.where(mask)\n    data = np.ones(len(rows), dtype=bool)\n    indices = cols.astype(np.int32)\n    H, W = mask.shape\n    indptr = np.zeros(H + 1, dtype=np.int32)\n    counts = np.bincount(rows, minlength=H)\n    indptr[1:] = np.cumsum(counts)\n    return data, indices, indptr\n\nvideo_path = '/root/input.mp4'\ncap = cv2.VideoCapture(video_path)\noriginal_fps = cap.get(cv2.CAP_PROP_FPS)\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\nduration = total_frames / original_fps\n\ntarget_fps = 6\nsample_times = np.arange(0, duration, 1/target_fps)\nsample_indices = [int(round(t * original_fps)) for t in sample_times]\nsample_indices = [i for i in sample_indices if i < total_frames]\nsample_indices = sorted(list(set(sample_indices)))\n\nframes = []\nfor idx in sample_indices:\n    cap.set(cv2.CAP_PROP_POS_FRAMES, idx)\n    ret, frame = cap.read()\n    if ret:\n        frames.append(frame)\ncap.release()\n\nlabels_dict = {}\nmasks_data = {}\nH, W = frames[0].shape[:2]\nmasks_data['shape'] = np.array([H, W])\n\norb = cv2.ORB_create(nfeatures=2000)\n\nfor i in range(len(frames) - 1):\n    f1 = frames[i]\n    f2 = frames[i+1]\n    gray1 = cv2.cvtColor(f1, cv2.COLOR_BGR2GRAY)\n    gray2 = cv2.cvtColor(f2, cv2.COLOR_BGR2GRAY)\n    kp1, des1 = orb.detectAndCompute(gray1, None)\n    kp2, des2 = orb.detectAndCompute(gray2, None)\n    \n    bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)\n    matches = bf.match(des1, des2)\n    \n    M = None\n    if len(matches) > 10:\n        src_pts = np.float32([kp1[m.queryIdx].pt for m in matches]).reshape(-1, 1, 2)\n        dst_pts = np.float32([kp2[m.trainIdx].pt for m in matches]).reshape(-1, 1, 2)\n        M, inliers = cv2.estimateAffinePartial2D(src_pts, dst_pts, method=cv2.RANSAC, ransacReprojThreshold=3.0)\n    \n    motion_labels = []\n    if M is not None:\n        tx = M[0, 2]\n        ty = M[1, 2]\n        s = np.sqrt(M[0, 0]**2 + M[0, 1]**2)\n        angle = np.arctan2(M[1, 0], M[0, 0])\n        \n        if tx > 1.5: motion_labels.append(\"Pan Left\")\n        elif tx < -1.5: motion_labels.append(\"Pan Right\")\n        if ty > 1.5: motion_labels.append(\"Tilt Up\")\n        elif ty < -1.5: motion_labels.append(\"Tilt Down\")\n        if s > 1.005: motion_labels.append(\"Dolly In\")\n        elif s < 0.995: motion_labels.append(\"Dolly Out\")\n        if angle > 0.005: motion_labels.append(\"Roll Right\")\n        elif angle < -0.005: motion_labels.append(\"Roll Left\")\n            \n    if not motion_labels:\n        motion_labels.append(\"Stay\")\n    \n    labels_dict[f\"{i}->{i+1}\"] = motion_labels\n    \n    if M is not None:\n        warped_f1 = cv2.warpAffine(f1, M, (W, H))\n        diff = cv2.absdiff(warped_f1, f2)\n        diff_gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)\n        _, mask = cv2.threshold(diff_gray, 30, 255, cv2.THRESH_BINARY)\n        kernel = np.ones((5,5), np.uint8)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_DILATE, kernel)\n    else:\n        mask = np.zeros((H, W), dtype=np.uint8)\n        \n    data, indices, indptr = get_csr(mask > 0)\n    masks_data[f\"f_{i}_data\"] = data\n    masks_data[f\"f_{i}_indices\"] = indices\n    masks_data[f\"f_{i}_indptr\"] = indptr\n\ndata, indices, indptr = get_csr(np.zeros((H, W), dtype=bool))\nmasks_data[f\"f_{len(frames)-1}_data\"] = data\nmasks_data[f\"f_{len(frames)-1}_indices\"] = indices\nmasks_data[f\"f_{len(frames)-1}_indptr\"] = indptr\n\nwith open('/root/pred_instructions.json', 'w') as f:\n    json.dump(labels_dict, f, indent=2)\nnp.savez('/root/pred_dyn_masks.npz', **masks_data)\nEOF\npython3 solution.py\n"]
