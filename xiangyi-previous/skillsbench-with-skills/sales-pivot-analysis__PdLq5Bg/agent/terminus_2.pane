[?2004hroot@e7421e831bd8:~# cat <<EOF > process_demographics.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Read Income Data
[?2004l[?2004h> print("Reading income data...")
[?2004l[?2004h> income_df = pd.read_excel('/root/income.xlsx')
[?2004l[?2004h> income_df['SA2_CODE'] = income_df['SA2_CODE'].astype(str)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Read Population PDF
[?2004l[?2004h> print("Reading population PDF...")
[?2004l[?2004h> pdf_rows = []
[?2004l[?2004h> header = None
[?2004l[?2004h> 
[?2004l[?2004h> with pdfplumber.open('/root/population.pdf') as pdf:
[?2004l[?2004h>     for i, page in enumerate(pdf.pages):
[?2004l[?2004h>         tables = page.extract_tables()
[?2004l[?2004h>         for table in tables:
[?2004l[?2004h>             if not table: continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Identify header on the first page
[?2004l[?2004h>             current_rows = table
[?2004l[?2004h>             if i == 0 and header is None:
[?2004l[?2004h>                 header = current_rows[0]
[?2004l[?2004h>                 # Fix truncated header if likely
[?2004l[?2004h>                 if header[-1] == 'POPULATION_20':
[?2004l[?2004h>                     header[-1] = 'POPULATION_2023'
[?2004l[?2004h>                 current_rows = current_rows[1:]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 # Skip header if repeated
[?2004l[?2004h>                 if header and current_rows[0] == header:
[?2004l[?2004h>                     current_rows = current_rows[1:]
[?2004l[?2004h>             
[?2004l[?2004h>             pdf_rows.extend(current_rows)
[?2004l[?2004h> 
[?2004l[?2004h> if not header:
[?2004l[?2004h>     # Fallback if header wasn't found as expected, though unlikely based on inspection
[?2004l[?2004h>     header = ['SA2_CODE', 'SA2_NAME', 'STATE', 'POPULATION_2023']
[?2004l[?2004h> 
[?2004l[?2004h> pop_df = pd.DataFrame(pdf_rows, columns=header)
[?2004l[?2004h> pop_df['SA2_CODE'] = pop_df['SA2_CODE'].astype(str)
[?2004l[?2004h> # Clean numeric columns (remove commas if any)
[?2004l[?2004h> pop_df['POPULATION_2023'] = pd.to_numeric(pop_df['POPULATION_2023'].astype(str).str.replace(',', ''), errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Merge Data
[?2004l[?2004h> print("Merging data...")
[?2004l[?2004h> # Use SA2_CODE as key. Inner join.
[?2004l[?2004h> merged_df = pd.merge(income_df, pop_df[['SA2_CODE', 'STATE', 'POPULATION_2023']], on='SA2_CODE', how='inner')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Enrich Data
[?2004l[?2004h> print("Enriching data...")
[?2004l[?2004h> # Total = EARNERS * MEDIAN_INCOME
[?2004l[?2004h> merged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']
[?2004l[?2004h> 
[?2004l[?2004h> # Quarter - Q1-Q4 based on MEDIAN_INCOME
[?2004l[?2004h> merged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], 4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Create Pivot Tables
[?2004l[?2004h> print("Creating pivot tables...")
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 1: Population by State (Rows: STATE, Values: Sum of POPULATION_2023)
[?2004l[?2004h> pivot1 = merged_df.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 2: Earners by State (Rows: STATE, Values: Sum of EARNERS)
[?2004l[?2004h> pivot2 = merged_df.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 3: Regions by State (Rows: STATE, Values: Count (number of SA2 regions))
[?2004l[?2004h> # Counting SA2_CODE gives the number of regions
[?2004l[?2004h> pivot3 = merged_df.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')
[?2004l[?2004h> pivot3.rename(columns={'SA2_CODE': 'Region_Count'}, inplace=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 4: State Income Quartile (Rows: STATE, Columns: Quarter, Values: Sum of EARNERS)
[?2004l[?2004h> pivot4 = merged_df.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum')
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 5: SourceData
[?2004l[?2004h> source_data = merged_df
[?2004l[?2004h> 
[?2004l[?2004h> # 6. Save to Excel
[?2004l[?2004h> output_path = '/root/demographic_analysis.xlsx'
[?2004l[?2004h> print(f"Saving to {output_path}...")
[?2004l[?2004h> with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
[?2004l[?2004h>     pivot1.to_excel(writer, sheet_name='Population by State')
[?2004l[?2004h>     pivot2.to_excel(writer, sheet_name='Earners by State')
[?2004l[?2004h>     pivot3.to_excel(writer, sheet_name='Regions by State')
