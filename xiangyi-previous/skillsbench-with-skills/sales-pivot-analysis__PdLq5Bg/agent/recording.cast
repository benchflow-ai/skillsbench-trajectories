[23.814669, "i", "cat <<EOF > inspect_data.py\nimport pandas as pd\nimport pdfplumber\n\nprint(\"--- INCOME XLSX ---\")\ntry:\n    df_income = pd.read_excel('/root/income.xlsx')\n    print(df_income.head())\n    print(df_income.columns)\nexcept Exception as e:\n    print(e)\n\nprint(\"\\n--- POPULATION PDF ---\")\ntry:\n    with pdfplumber.open('/root/population.pdf') as pdf:\n        page = pdf.pages[0]\n        text = page.extract_text()\n        print(\"Text preview:\")\n        print(text[:500])\n        print(\"Table extraction preview:\")\n        tables = page.extract_tables()\n        if tables:\n            for row in tables[0][:5]:\n                print(row)\nexcept Exception as e:\n    print(e)\nEOF\n"]
