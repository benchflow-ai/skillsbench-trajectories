[77.108021, "o", "\u001b[?2004hroot@e7421e831bd8:~# "]
[112.611502, "i", "cat <<EOF > process_demographics.py\nimport pandas as pd\nimport pdfplumber\nimport numpy as np\n\n# 1. Read Income Data\nprint(\"Reading income data...\")\nincome_df = pd.read_excel('/root/income.xlsx')\nincome_df['SA2_CODE'] = income_df['SA2_CODE'].astype(str)\n\n# 2. Read Population PDF\nprint(\"Reading population PDF...\")\npdf_rows = []\nheader = None\n\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for i, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        for table in tables:\n            if not table: continue\n            \n            # Identify header on the first page\n            current_rows = table\n            if i == 0 and header is None:\n                header = current_rows[0]\n                if header[-1] == 'POPULATION_20':\n                    header[-1] = 'POPULATION_2023'\n                current_rows = current_rows[1:]\n            else:\n                if header and current_rows[0] == header:\n                    current_rows = current_rows[1:]\n            \n            pdf_rows.extend(current_rows)\n\nif not header:\n    header = ['SA2_CODE', 'SA2_NAME', 'STATE', 'POPULATION_2023']\n\npop_df = pd.DataFrame(pdf_rows, columns=header)\npop_df['SA2_CODE'] = pop_df['SA2_CODE'].astype(str)\npop_df['POPULATION_2023'] = pd.to_numeric(pop_df['POPULATION_2023'].astype(str).str.replace(',', ''), errors='coerce')\n\n# 3. Merge Data\nprint(\"Merging data...\")\nmerged_df = pd.merge(income_df, pop_df[['SA2_CODE', 'STATE', 'POPULATION_2023']], on='SA2_CODE', how='inner')\n\n# 4. Clean Numeric Columns for Calculation\nprint(\"Cleaning numeric columns...\")\ndef clean_currency(x):\n    if isinstance(x, str):\n        return x.replace('$', '').replace(',', '').strip()\n    return x\n\nmerged_df['EARNERS'] = merged_df['EARNERS'].apply(clean_currency)\nmerged_df['EARNERS'] = pd.to_numeric(merged_df['EARNERS'], errors='coerce')\n\nmerged_df['MEDIAN_INCOME'] = merged_df['MEDIAN_INCOME'].apply(clean_currency)\nmerged_df['MEDIAN_INCOME'] = pd.to_numeric(merged_df['MEDIAN_INCOME'], errors='coerce')\n\n# 5. Enrich Data\nprint(\"Enriching data...\")\nmerged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\n\nprint(\"Calculating quartiles...\")\nmerged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], 4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\n\n# 6. Create Pivot Tables\nprint(\"Creating pivot tables...\")\n\npivot1 = merged_df.pivot_table(index='STATE', values='POPULATION_2023', aggfunc='sum')\npivot2 = merged_df.pivot_table(index='STATE', values='EARNERS', aggfunc='sum')\npivot3 = merged_df.pivot_table(index='STATE', values='SA2_CODE', aggfunc='count')\n# Rename the column for clarity in the output file\npivot3.columns = ['Count']\n\npivot4 = merged_df.pivot_table(index='STATE', columns='Quarter', values='EARNERS', aggfunc='sum')\n\n# 7. Save to Excel\noutput_path = '/root/demographic_analysis.xlsx'\nprint(f\"Saving to {output_path}...\")\nwith pd.ExcelWriter(output_path, engine='openpyxl') as writer:\n    pivot1.to_excel(writer, sheet_name='Population by State')\n    pivot2.to_excel(writer, sheet_name='Earners by State')\n    pivot3.to_excel(writer, sheet_name='Regions by State')\n    pivot4.to_excel(writer, sheet_name='State Income Quartile')\n    merged_df.to_excel(writer, sheet_name='SourceData', index=False)\n\nprint(\"Done.\")\nEOF\n"]
