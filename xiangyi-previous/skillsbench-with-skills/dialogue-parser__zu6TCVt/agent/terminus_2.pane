[?2004l[?2004h> def validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:
[?2004l[?2004h>     """
[?2004l[?2004h>     Validate the graph for reachability and edge integrity.
[?2004l[?2004h>     
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         Tuple of (is_valid, list_of_errors)
[?2004l[?2004h>     """
[?2004l[?2004h>     errors = []
[?2004l[?2004h>     nodes = graph["nodes"]
[?2004l[?2004h>     edges = graph["edges"]
[?2004l[?2004h>     
[?2004l[?2004h>     node_ids = {n["id"] for n in nodes}
[?2004l[?2004h>     
[?2004l[?2004h>     # Check all edge targets exist (except End)
[?2004l[?2004h>     for edge in edges:
[?2004l[?2004h>         if edge["to"] not in node_ids and edge["to"] != "End":
[?2004l[?2004h>             errors.append(f"Edge target '{edge['to']}' from '{edge['from']}' does not exist")
[?2004l[?2004h>     
[?2004l[?2004h>     # Check reachability from Start
[?2004l[?2004h>     if "Start" not in node_ids:
[?2004l[?2004h>         errors.append("No 'Start' node found")
[?2004l[?2004h>     else:
[?2004l[?2004h>         reachable = set()
[?2004l[?2004h>         queue = deque(["Start"])
[?2004l[?2004h>         reachable.add("Start")
[?2004l[?2004h>         
[?2004l[?2004h>         while queue:
[?2004l[?2004h>             current = queue.popleft()
[?2004l[?2004h>             for edge in edges:
[?2004l[?2004h>                 if edge["from"] == current and edge["to"] not in reachable:
[?2004l[?2004h>                     reachable.add(edge["to"])
[?2004l[?2004h>                     if edge["to"] != "End":
[?2004l[?2004h>                         queue.append(edge["to"])
[?2004l[?2004h>         
[?2004l[?2004h>         unreachable = node_ids - reachable - {"End"}
[?2004l[?2004h>         for node_id in unreachable:
[?2004l[?2004h>             errors.append(f"Node '{node_id}' is not reachable from 'Start'")
[?2004l[?2004h>     
[?2004l[?2004h>     return len(errors) == 0, errors
