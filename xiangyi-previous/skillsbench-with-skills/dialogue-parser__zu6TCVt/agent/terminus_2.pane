[?2004hroot@e21e7ca3003c:/app# cat > /app/solution.py << 'EOF'
[?2004l    continue
                
            # Check if this is a dialogue line (contains a colon and arrow)
            if ':' in line and '->' in line:
                # This is a dialogue line with a target
                match = re.match(r'([^:]+):\s*(.+?)\s*->\s*(.+)$', line)
                if match:
                    speaker = match.group(1).strip()
                    text_content = match.group(2).strip()
                    target = match.group(3).strip()
                    
                    # Create node for this dialogue line
                    node = {
                        "id": scene_id,
                        "text": text_content,
                        "speaker": speaker,
                        "type": "line"
                    }
                    
                    # Only add if not already added (scenes should have one main dialogue)
                    if not any(n["id"] == scene_id for n in nodes):
                        nodes.append(node)
                        node_ids.add(scene_id)
                    
                    # Create edge
                    edge = {
                        "from": scene_id,
                        "to": target,
                        "text": ""
                    }
                    edges.append(edge)
                    first_line = False
            
            # Check if this is a choice line (starts with number)
            elif re.match(r'^\d+\.', line):
                # This is a choice option
                match = re.match(r'^(\d+)\.\s*(?:\[([^\]]+)\]\s*)?(.+?)\s*->\s*(.+)$', line)
                if match:
