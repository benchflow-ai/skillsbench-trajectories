[141.203355, "i", "cat > /app/solution.py << 'EOFPYTHON'\nimport json\nimport re\nfrom typing import Dict, List, Set, Tuple, Any\nfrom collections import deque\n\ndef parse_script(text: str) -> Dict[str, Any]:\n    \"\"\"\n    Parse a dialogue script into a structured graph with nodes and edges.\n    \"\"\"\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split by scene headers that are on their own line: ^[SceneName]$\n    # Use a more careful approach\n    lines = text.split('\\n')\n    \n    current_scene = None\n    current_content = []\n    scene_data = {}\n    \n    for line in lines:\n        # Check if this is a scene header (line that starts and ends with brackets)\n        scene_match = re.match(r'^\\[([^\\]]+)\\]\\s*$', line)\n        \n        if scene_match:\n            # Save previous scene if exists\n            if current_scene and current_content:\n                scene_data[current_scene] = '\\n'.join(current_content)\n            \n            # Start new scene\n            current_scene = scene_match.group(1).strip()\n            cur"]
[141.203531, "i", "rent_content = []\n        else:\n            # Add to current scene content\n            if current_scene:\n                current_content.append(line)\n    \n    # Don't forget the last scene\n    if current_scene and current_content:\n        scene_data[current_scene] = '\\n'.join(current_content)\n    \n    # Now parse each scene\n    for scene_id, scene_content in scene_data.items():\n        scene_lines = [l.strip() for l in scene_content.split('\\n') if l.strip()]\n        \n        if not scene_lines:\n            continue\n        \n        # Parse scene content\n        dialogue_text = \"\"\n        dialogue_speaker = \"\"\n        dialogue_target = None\n        choices = []  # List of (choice_num, tag, text, target)\n        \n        for line in scene_lines:\n            # Check for dialogue line (speaker: text -> target)\n            if ':' in line and '->' in line and not choices:\n                match = re.match(r'([^:]+):\\s*(.+?)\\s*->\\s*(.+)$', line)\n                if match:\n                    dialogue_speaker = match.g"]
