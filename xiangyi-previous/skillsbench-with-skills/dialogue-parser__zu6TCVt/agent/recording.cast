[76.671669, "i", "cat > /app/solution.py << 'EOFPYTHON'\nimport json\nimport re\nfrom typing import Dict, List, Set, Tuple, Any\nfrom collections import deque\n\ndef parse_script(text: str) -> Dict[str, Any]:\n    \"\"\"\n    Parse a dialogue script into a structured graph with nodes and edges.\n    \n    Args:\n        text: The script content as a string\n        \n    Returns:\n        A dictionary with 'nodes' and 'edges' keys containing the parsed graph\n    \"\"\"\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split by scene headers [SceneName]\n    scene_pattern = r'\\[([^\\]]+)\\]'\n    parts = re.split(scene_pattern, text.strip())\n    \n    # Process alternating headers and content\n    i = 1\n    while i < len(parts):\n        scene_id = parts[i].strip()\n        scene_content = parts[i + 1].strip() if i + 1 < len(parts) else \"\"\n        i += 2\n        \n        if not scene_content:\n            continue\n        \n        lines = [l.strip() for l in scene_content.split('\\n') if l.strip()]\n        \n        # Parse scene content\n        "]
[76.671718, "i", "dialogue_line = None\n        dialogue_target = None\n        choices = []  # List of (choice_num, tag, text, target)\n        \n        for line in lines:\n            # Check for dialogue line (speaker: text -> target)\n            if ':' in line and '->' in line and not choices:  # Dialogue comes before choices\n                match = re.match(r'([^:]+):\\s*(.+?)\\s*->\\s*(.+)$', line)\n                if match:\n                    speaker = match.group(1).strip()\n                    dialogue_line = match.group(2).strip()\n                    dialogue_target = match.group(3).strip()\n            \n            # Check for choice lines (numbered)\n            elif re.match(r'^\\d+\\.', line):\n                match = re.match(r'^(\\d+)\\.\\s*(?:\\[([^\\]]+)\\]\\s*)?(.+?)\\s*->\\s*(.+)$', line)\n                if match:\n                    choice_num = match.group(1)\n                    tag = match.group(2)  # Optional tag\n                    choice_text = match.group(3).strip()\n                    target = match.group(4).strip()\n    "]
[76.671725, "i", "                choices.append((choice_num, tag, choice_text, target))\n        \n        # Create scene node\n        scene_node = {\n            \"id\": scene_id,\n            \"text\": dialogue_line if dialogue_line else \"\",\n            \"speaker\": \"\",\n            \"type\": \"line\"\n        }\n        nodes.append(scene_node)\n        node_ids.add(scene_id)\n        \n        # Handle dialogue line with target\n        if dialogue_line and dialogue_target:\n            if choices:\n                # If there are choices, connect dialogue to first choice instead\n                first_choice_id = f\"{scene_id}_choice_{choices[0][0]}\"\n                edge = {\"from\": scene_id, \"to\": first_choice_id, \"text\": \"\"}\n                edges.append(edge)\n            else:\n                # No choices, direct edge to target\n                edge = {\"from\": scene_id, \"to\": dialogue_target, \"text\": \"\"}\n                edges.append(edge)\n        elif choices:\n            # Scene has only choices, connect to first choice\n            first_choice_"]
