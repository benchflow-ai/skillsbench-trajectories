[76.691891, "o", "004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     errors = []\r\n\u001b[?2004l\r\u001b[?2004h>     nodes = graph[\"nodes\"]\r\n\u001b[?2004l\r\u001b[?2004h>     edges = graph[\"edges\"]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     node_ids = {n[\"id\"] for n in nodes}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check all edge targets exist (except End)\r\n\u001b[?2004l\r\u001b[?2004h>     for edge in edges:\r\n\u001b[?2004l\r\u001b[?2004h>         if edge[\"to\"] not in node_ids and edge[\"to\"] != \"End\":\r\n\u001b[?2004l\r\u001b[?2004h>             errors.append(f\"Edge target '{edge['to']}' from '{edge['from']}' does not exist\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check reachability from Start\r\n\u001b[?2004l\r\u001b[?2004h>     if \"Start\" not in node_ids:\r\n\u001b[?2004l\r\u001b[?2004h>         errors.append(\"No 'Start' node found\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         reachable = set()\r\n\u001b[?2004l\r\u001b[?2004h>         queue = deque([\"Start\"])\r\n\u001b[?2004l\r\u001b[?2004h>         reachable.add(\"Start\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         while queue:\r\n\u001b["]
