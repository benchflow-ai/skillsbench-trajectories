[40.848359, "i", "cat > /app/solution.py << 'EOFILE'\nimport json\nimport re\nfrom typing import Dict, List, Set, Tuple, Any\nfrom collections import deque\n\ndef parse_script(text: str) -> Dict[str, Any]:\n    \"\"\"\n    Parse a dialogue script into a structured graph with nodes and edges.\n    \n    Args:\n        text: The script content as a string\n        \n    Returns:\n        A dictionary with 'nodes' and 'edges' keys containing the parsed graph\n    \"\"\"\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split by scene headers [SceneName]\n    scene_pattern = r'\\[([^\\]]+)\\]'\n    parts = re.split(scene_pattern, text.strip())\n    \n    # Process alternating headers and content\n    i = 1\n    while i < len(parts):\n        scene_id = parts[i].strip()\n        scene_content = parts[i + 1].strip() if i + 1 < len(parts) else \"\"\n        i += 2\n        \n        if not scene_content:\n            continue\n        \n        lines = [l.strip() for l in scene_content.split('\\n') if l.strip()]\n        \n        # First line should be the dialog"]
[40.848405, "i", "ue line (speaker: text -> target)\n        dialogue_line_found = False\n        choice_nodes_in_scene = []\n        \n        for line_idx, line in enumerate(lines):\n            # Check for dialogue line with arrow\n            if ':' in line and '->' in line and not dialogue_line_found:\n                match = re.match(r'([^:]+):\\s*(.+?)\\s*->\\s*(.+)$', line)\n                if match:\n                    speaker = match.group(1).strip()\n                    dialogue_text = match.group(2).strip()\n                    target = match.group(3).strip()\n                    \n                    # Create dialogue node\n                    node = {\n                        \"id\": scene_id,\n                        \"text\": dialogue_text,\n                        \"speaker\": speaker,\n                        \"type\": \"line\"\n                    }\n                    nodes.append(node)\n                    node_ids.add(scene_id)\n                    \n                    # Create edge to target\n                    edge = {\n                "]
[40.848533, "i", "        \"from\": scene_id,\n                        \"to\": target,\n                        \"text\": \"\"\n                    }\n                    edges.append(edge)\n                    dialogue_line_found = True\n            \n            # Check for choice lines (numbered)\n            elif re.match(r'^\\d+\\.', line):\n                match = re.match(r'^(\\d+)\\.\\s*(?:\\[([^\\]]+)\\]\\s*)?(.+?)\\s*->\\s*(.+)$', line)\n                if match:\n                    choice_num = match.group(1)\n                    tag = match.group(2)  # Optional tag\n                    choice_text = match.group(3).strip()\n                    target = match.group(4).strip()\n                    \n                    # Create unique choice node ID\n                    choice_id = f\"{scene_id}_choice_{choice_num}\"\n                    \n                    # Build full choice text\n                    full_text = f\"[{tag}] {choice_text}\" if tag else choice_text\n                    \n                    # Create choice node\n                    choice_node "]
[40.848544, "o", "cat > /app/solution.py << 'EOFILE'\r\n\u001b[?2004l\r"]
[40.848588, "i", "= {\n                        \"id\": choice_id,\n                        \"text\": full_text,\n                        \"speaker\": \"\",\n                        \"type\": \"choice\"\n                    }\n                    nodes.append(choice_node)\n                    node_ids.add(choice_id)\n                    choice_nodes_in_scene.append(choice_id)\n                    \n                    # Create edge from choice to target\n                    choice_edge = {\n                        \"from\": choice_id,\n                        \"to\": target,\n                        \"text\": \"\"\n                    }\n                    edges.append(choice_edge)\n        \n        # If there are choices but no dialogue line, create a placeholder dialogue node\n        if not dialogue_line_found and choice_nodes_in_scene:\n            node = {\n                \"id\": scene_id,\n                \"text\": \"\",\n                \"speaker\": \"\",\n                \"type\": \"line\"\n            }\n            nodes.append(node)\n            node_ids.add(scene_id)\n     "]
[40.848617, "o", "        \"from\": scene_id,\r\n                        \"to\": target,\r\n                        \"text\": \"\"\r\n                    }\r\n                    edges.append(edge)\r\n                    dialogue_line_found = True\r\n            \r\n            # Check for choice lines (numbered)\r\n            elif re.match(r'^\\d+\\.', line):\r\n                match = re.match(r'^(\\d+)\\.\\s*(?:\\[([^\\]]+)"]
[40.848638, "i", "   \n        # Connect dialogue line to first choice if choices exist\n        if dialogue_line_found and choice_nodes_in_scene:\n            # Replace the edge from dialogue to target with edge to first choice\n            # Remove the old edge\n            edges = [e for e in edges if not (e[\"from\"] == scene_id and e[\"type\"] != \"choice\")]\n            # Add edge to first choice\n            first_choice_edge = {\n                \"from\": scene_id,\n                \"to\": choice_nodes_in_scene[0],\n                \"text\": \"\"\n            }\n            edges.insert(-len(choice_nodes_in_scene), first_choice_edge)\n    \n    # Ensure End node exists\n    if \"End\" not in node_ids:\n        nodes.append({\n            \"id\": \"End\",\n            \"text\": \"The End\",\n            \"speaker\": \"Narrator\",\n            \"type\": \"line\"\n        })\n        node_ids.add(\"End\")\n    \n    return {\n        \"nodes\": nodes,\n        \"edges\": edges\n    }\n\n\ndef validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:\n    \"\"\"\n    Validate the graph "]
[40.848657, "o", "\\]\\s*)?(.+?)\\s*->\\s*(.+)$', line)\r\n                if match:\r\n                    choice_num = match.group(1)\r\n                    tag = match.group(2)  # Optional tag\r\n                    choice_text = match.group(3).strip()\r\n                    target = match.group(4).strip()"]
[40.848676, "i", "for reachability and edge integrity.\n    \n    Returns:\n        Tuple of (is_valid, list_of_errors)\n    \"\"\"\n    errors = []\n    nodes = graph[\"nodes\"]\n    edges = graph[\"edges\"]\n    \n    node_ids = {n[\"id\"] for n in nodes}\n    \n    # Check all edge targets exist (except End)\n    for edge in edges:\n        if edge[\"to\"] not in node_ids and edge[\"to\"] != \"End\":\n            errors.append(f\"Edge target '{edge['to']}' from '{edge['from']}' does not exist\")\n    \n    # Check reachability from Start\n    if \"Start\" not in node_ids:\n        errors.append(\"No 'Start' node found\")\n    else:\n        reachable = set()\n        queue = deque([\"Start\"])\n        reachable.add(\"Start\")\n        \n        while queue:\n            current = queue.popleft()\n            for edge in edges:\n                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\n                    reachable.add(edge[\"to\"])\n                    if edge[\"to\"] != \"End\":\n                        queue.append(edge[\"to\"])\n        \n        unreachable = node"]
[40.848697, "o", "\r\n                    \r\n                    # Create unique choice node ID\r\n                    choice_id = f\"{scene_id}_choice_{choice_num}\"\r\n                    \r\n                    # Build full choi"]
[40.848717, "i", "_ids - reachable - {\"End\"}\n        for node_id in unreachable:\n            errors.append(f\"Node '{node_id}' is not reachable from 'Start'\")\n    \n    return len(errors) == 0, errors\n\n\nif __name__ == \"__main__\":\n    with open('/app/script.txt', 'r') as f:\n        script_content = f.read()\n    \n    graph = parse_script(script_content)\n    \n    # Validate\n    is_valid, validation_errors = validate_graph(graph)\n    if validation_errors:\n        print(\"Validation warnings:\")\n        for error in validation_errors:\n            print(f\"  - {error}\")\n    \n    # Save JSON\n    with open('/app/dialogue.json', 'w') as f:\n        json.dump(graph, f, indent=2)\n    \n    print(f\"\\nParsed successfully!\")\n    print(f\"Total nodes: {len(graph['nodes'])}\")\n    print(f\"Total edges: {len(graph['edges'])}\")\n    print(f\"Graph valid: {is_valid}\")\nEOFILE\n"]
