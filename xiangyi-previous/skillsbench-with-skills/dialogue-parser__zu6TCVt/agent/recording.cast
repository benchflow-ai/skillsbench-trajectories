[40.852398, "o", "\u001b[?2004h"]
[40.852409, "o", "> "]
[40.852615, "o", "        scene_content = parts[i + 1].strip() if i + 1 < len(parts) else \"\"\r\n\u001b[?2004l\r"]
[40.852641, "o", "\u001b[?2004h> "]
[40.852684, "o", "        i += 2\r\n\u001b[?2004l\r"]
