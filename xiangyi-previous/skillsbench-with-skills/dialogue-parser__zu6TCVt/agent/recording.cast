[40.850064, "o", "\u001b[?2004h> "]
[40.850257, "o", "        text: The script content as a string\r\n\u001b[?2004l\r"]
[40.850267, "o", "\u001b[?2004h> "]
[40.850318, "o", "        \r\n\u001b[?2004l\r"]
[40.850341, "o", "\u001b[?2004h"]
[40.850367, "o", "> "]
