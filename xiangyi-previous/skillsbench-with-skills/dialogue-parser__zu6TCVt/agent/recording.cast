[141.212266, "o", "            \"type\": \"line\"\r\n\u001b[?2004l\r"]
[141.212279, "o", "\u001b[?2004h> "]
[141.212317, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.212461, "o", "        nodes.append(node)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.212491, "o", "        node_ids.add(scene_id)\r\n\u001b[?2004l\r"]
[141.212575, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r \u001b[?2004h"]
[141.212614, "o", ">         # Create edges\r\n\u001b[?2004l\r"]
[141.21265, "o", "\u001b[?2004h"]
[141.212688, "o", ">         if choices:\r\n\u001b[?2004l\r"]
[141.212728, "o", "\u001b[?2004h> "]
[141.212884, "o", "            # Scene has choices - create choice nodes and edges\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.212896, "o", "> "]
[141.213078, "o", "            for choice_num, tag, choice_text, target in choices:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.213091, "o", "> "]
[141.2132, "o", "                # Create choice node\r\n\u001b[?2004l\r"]
[141.213212, "o", "\u001b[?2004h> "]
[141.213384, "o", "                choice_id = f\"{scene_id}_choice_{choice_num}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.213395, "o", "> "]
[141.213606, "o", "                full_text = f\"[{tag}] {choice_text}\" if tag else choice_text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.213649, "o", "                \r\n\u001b[?2004l\r"]
[141.213678, "o", "\u001b[?2004h> "]
[141.213751, "o", "                choice_node = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.213763, "o", "> "]
[141.213852, "o", "                    \"id\": choice_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.213863, "o", "> "]
[141.213945, "o", "                    \"text\": full_text,\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.213956, "o", "> "]
[141.214093, "o", "                    \"speaker\": \"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.214177, "o", "                    \"type\": \"choice\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.214221, "o", "                }\r\n\u001b[?2004l\r"]
[141.21426, "o", "\u001b[?2004h> "]
[141.214333, "o", "                nodes.append(choice_node)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.214344, "o", "> "]
[141.214455, "o", "                node_ids.add(choice_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.214469, "o", "> "]
[141.214518, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[141.214552, "o", "> "]
[141.214647, "o", "                # Edge from scene to choice\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.214657, "o", "> "]
[141.214838, "o", "                edge = {\"from\": scene_id, \"to\": choice_id, \"text\": \"\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.214867, "o", "                edges.append(edge)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.214942, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.214981, "o", "                # Edge from choice to target\r\n\u001b[?2004l\r"]
[141.214998, "o", "\u001b[?2004h> "]
[141.215122, "o", "                choice_edge = {\"from\": choice_id, \"to\": target, \"text\": \"\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215195, "o", "                edges.append(choice_edge)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215244, "o", "        elif dialogue_target:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215339, "o", "            # Scene has dialogue with target, no choices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215466, "o", "            edge = {\"from\": scene_id, \"to\": dialogue_target, \"text\": \"\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215524, "o", "            edges.append(edge)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.215549, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.2156, "o", "    # Ensure End node exists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21567, "o", "    if \"End\" not in node_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21572, "o", "        nodes.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.215749, "o", "> "]
[141.215772, "o", "            \"id\": \"End\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.215796, "o", "> "]
[141.215838, "o", "            \"text\": \"The End\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.215867, "o", "> "]
[141.215903, "o", "            \"speaker\": \"Narrator\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.21593, "o", "> "]
[141.215961, "o", "            \"type\": \"line\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.215986, "o", ">         })\r\n\u001b[?2004l\r"]
[141.216013, "o", "\u001b[?2004h> "]
[141.216057, "o", "        node_ids.add(\"End\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.216083, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[141.216109, "o", "> "]
[141.216136, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216178, "o", "        \"nodes\": nodes,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216226, "o", "        \"edges\": edges\r\n\u001b[?2004l\r"]
[141.216251, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216276, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.216304, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21641, "o", "def validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216422, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[141.216458, "o", "\u001b[?2004h> "]
[141.216532, "o", "    Validate the graph for reachability and edge integrity.\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.216544, "o", "> "]
[141.216581, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216608, "o", "    errors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216667, "o", "    nodes = graph[\"nodes\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216722, "o", "    edges = graph[\"edges\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216751, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.216824, "o", "    node_ids = {n[\"id\"] for n in nodes}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21686, "o", "    \r\n\u001b[?2004l\r"]
[141.216887, "o", "\u001b[?2004h> "]
[141.216929, "o", "    # Check all edge targets exist (except End)\r\n\u001b[?2004l\r"]
[141.216958, "o", "\u001b[?2004h> "]
[141.216982, "o", "    for edge in edges:\r\n\u001b[?2004l\r"]
[141.21701, "o", "\u001b[?2004h> "]
[141.217092, "o", "        if edge[\"to\"] not in node_ids and edge[\"to\"] != \"End\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.217102, "o", "> "]
[141.217265, "o", "            errors.append(f\"Edge target '{edge['to']}' from '{edge['from']}' does not exist\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[141.217317, "o", "\u001b[?2004h> "]
[141.217342, "o", "    # Check reachability from Start\r\n\u001b[?2004l\r"]
[141.217366, "o", "\u001b[?2004h> "]
[141.217411, "o", "    if \"Start\" not in node_ids:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.217448, "o", "> "]
[141.217507, "o", "        errors.append(\"No 'Start' node found\")\r\n\u001b[?2004l\r"]
[141.217545, "o", "\u001b[?2004h> "]
[141.217573, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.217607, "o", "        reachable = set()\r\n\u001b[?2004l\r"]
[141.217643, "o", "\u001b[?2004h> "]
[141.217681, "o", "        queue = deque([\"Start\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.217722, "o", "        reachable.add(\"Start\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.217749, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.2178, "o", "        while queue:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21787, "o", "            current = queue.popleft()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21793, "o", "            for edge in edges:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218051, "o", "                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218146, "o", "                    reachable.add(edge[\"to\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218225, "o", "                    if edge[\"to\"] != \"End\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218311, "o", "                        queue.append(edge[\"to\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.218323, "o", "> "]
[141.218361, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218442, "o", "        unreachable = node_ids - reachable - {\"End\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218507, "o", "        for node_id in unreachable:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.218543, "o", "> "]
[141.218639, "o", "            errors.append(f\"Node '{node_id}' is not reachable from 'Start'\")\r\n\u001b[?2004l\r"]
[141.218651, "o", "\u001b[?2004h>     "]
[141.218687, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218736, "o", "    return len(errors) == 0, errors\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.218766, "o", "> \r\n\u001b[?2004l\r"]
[141.218802, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218863, "o", "def generate_dot(graph: Dict[str, Any]) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.21889, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.218997, "o", "    Generate a Graphviz DOT representation of the dialogue graph.\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.219007, "o", "> "]
[141.219044, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[141.219069, "o", "\u001b[?2004h> "]
[141.219112, "o", "    lines = [\"digraph Dialogue {\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219159, "o", "    lines.append(\"  rankdir=LR;\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.219191, "o", "> "]
[141.219265, "o", "    lines.append(\"  node [shape=box, style=rounded];\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219276, "o", "    \r\n\u001b[?2004l\r"]
[141.219313, "o", "\u001b[?2004h> "]
[141.219339, "o", "    nodes = graph[\"nodes\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219393, "o", "    edges = graph[\"edges\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.219429, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219498, "o", "    # Add nodes with proper escaping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219548, "o", "    for node in nodes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219653, "o", "        node_id = node[\"id\"].replace(\"-\", \"_\").replace(\" \", \"_\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.219666, "o", "> "]
[141.219762, "o", "        # Escape quotes and special characters in label\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219878, "o", "        label = node[\"text\"][:50].replace('\"', '\\\\\"').replace('\\n', ' ')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.219952, "o", "        if node[\"type\"] == \"choice\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220077, "o", "            lines.append(f'  {node_id} [label=\"{label}\", shape=diamond];')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220115, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220155, "o", "> "]
[141.220234, "o", "            lines.append(f'  {node_id} [label=\"{label}\"];')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220245, "o", "    \r\n\u001b[?2004l\r"]
[141.22028, "o", "\u001b[?2004h>     # Add edges\r\n\u001b[?2004l\r"]
[141.220309, "o", "\u001b[?2004h> "]
[141.220341, "o", "    for edge in edges:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220448, "o", "        from_id = edge[\"from\"].replace(\"-\", \"_\").replace(\" \", \"_\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220461, "o", "> "]
[141.220567, "o", "        to_id = edge[\"to\"].replace(\"-\", \"_\").replace(\" \", \"_\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220647, "o", "        lines.append(f'  {from_id} -> {to_id};')\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220658, "o", "> "]
[141.220693, "o", "    \r\n\u001b[?2004l\r"]
[141.22072, "o", "\u001b[?2004h>     lines.append(\"}\")\r\n\u001b[?2004l\r"]
[141.220743, "o", "\u001b[?2004h> "]
[141.220783, "o", "    return \"\\n\".join(lines)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220811, "o", "> \r\n\u001b[?2004l\r"]
[141.220838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.220873, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220901, "o", "> "]
[141.220956, "o", "    with open('/app/script.txt', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.220979, "o", "> "]
[141.221022, "o", "        script_content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.221049, "o", ">     \r\n\u001b[?2004l\r"]
[141.221077, "o", "\u001b[?2004h> "]
[141.221125, "o", "    graph = parse_script(script_content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.22115, "o", "> "]
[141.221176, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221203, "o", "    # Validate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221285, "o", "    is_valid, validation_errors = validate_graph(graph)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.221298, "o", "> "]
[141.221346, "o", "    if validation_errors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221418, "o", "        print(\"Validation warnings:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221509, "o", "        for error in validation_errors[:10]:\r\n\u001b[?2004l\r"]
[141.22154, "o", "\u001b[?2004h> "]
[141.221564, "o", "            print(f\"  - {error}\")\r\n\u001b[?2004l\r"]
[141.221592, "o", "\u001b[?2004h> "]
[141.22165, "o", "        if len(validation_errors) > 10:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221792, "o", "            print(f\"  ... and {len(validation_errors) - 10} more errors\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221837, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.221869, "o", "> "]
[141.221893, "o", "        print(\"Graph is valid!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221929, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.221961, "o", "    # Save JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.22204, "o", "    with open('/app/dialogue.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.222053, "o", "> "]
[141.222117, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.222154, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222204, "o", "    # Generate and save DOT\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.22224, "o", "> "]
[141.222283, "o", "    dot_content = generate_dot(graph)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222364, "o", "    with open('/app/dialogue.dot', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222422, "o", "        f.write(dot_content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222456, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222513, "o", "    print(f\"\\nParsed successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222598, "o", "    print(f\"Total nodes: {len(graph['nodes'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222684, "o", "    print(f\"Total edges: {len(graph['edges'])}\")\r\n\u001b[?2004l\r"]
[141.222697, "o", "\u001b[?2004h> "]
[141.222763, "o", "    print(f\"Graph valid: {is_valid}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222874, "o", "    print(f\"Files created: /app/dialogue.json, /app/dialogue.dot\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.222905, "o", "EOFPYTHON\r\n\u001b[?2004l\r"]
[141.224228, "o", "\u001b[?2004hroot@e21e7ca3003c:/app# "]
[144.658196, "i", "python3 /app/solution.py\n"]
[144.658355, "o", "python3 /app/solution.py\r\n\u001b[?2004l\r"]
[144.700174, "o", "Graph is valid!\r\n"]
[144.722996, "o", "\r\nParsed successfully!\r\nTotal nodes: 380\r\nTotal edges: 496\r\nGraph valid: True\r\nFiles created: /app/dialogue.json, /app/dialogue.dot\r\n"]
[144.72699, "o", "\u001b[?2004hroot@e21e7ca3003c:/app# "]
[149.270585, "i", "ls -lh /app/dialogue.* && echo '---' && head -50 /app/dialogue.json\n"]
[149.270801, "o", "ls -lh /app/dialogue.* && echo '---' && head -50 /app/dialogue.json\r\n\u001b[?2004l\r"]
