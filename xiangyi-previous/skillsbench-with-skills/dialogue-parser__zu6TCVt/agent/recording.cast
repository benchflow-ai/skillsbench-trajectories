[40.865848, "o", "                \"from\": scene_id,\r\n\u001b[?2004l\r"]
[40.865871, "o", "\u001b[?2004h> "]
[40.865967, "o", "                \"to\": choice_nodes_in_scene[0],\r\n\u001b[?2004l\r"]
[40.86599, "o", "\u001b[?2004h> "]
[40.866046, "o", "                \"text\": \"\"\r\n\u001b[?2004l\r"]
[40.866076, "o", "\u001b[?2004h> "]
[40.866102, "o", "            }\r\n\u001b[?2004l\r"]
[40.866124, "o", "\u001b[?2004h> "]
[40.866273, "o", "            edges.insert(-len(choice_nodes_in_scene), first_choice_edge)\r\n\u001b[?2004l\r"]
[40.866295, "o", "\u001b[?2004h> "]
[40.866315, "o", "    \r\n\u001b[?2004l\r"]
[40.866339, "o", "\u001b[?2004h> "]
[40.86639, "o", "    # Ensure End node exists\r\n\u001b[?2004l\r"]
[40.866406, "o", "\u001b[?2004h> "]
[40.866475, "o", "    if \"End\" not in node_ids:\r\n\u001b[?2004l\r"]
[40.866503, "o", "\u001b[?2004h> "]
[40.866546, "o", "        nodes.append({\r\n\u001b[?2004l\r"]
[40.866565, "o", "\u001b[?2004h> "]
[40.866619, "o", "            \"id\": \"End\",\r\n\u001b[?2004l\r"]
[40.866644, "o", "\u001b[?2004h> "]
[40.866707, "o", "            \"text\": \"The End\",\r\n\u001b[?2004l\r"]
[40.866727, "o", "\u001b[?2004h> "]
[40.866816, "o", "            \"speaker\": \"Narrator\",\r\n\u001b[?2004l\r"]
[40.866839, "o", "\u001b[?2004h> "]
[40.866894, "o", "            \"type\": \"line\"\r\n\u001b[?2004l\r"]
[40.866915, "o", "\u001b[?2004h> "]
[40.866941, "o", "        })\r\n\u001b[?2004l\r"]
[40.86696, "o", "\u001b[?2004h> "]
[40.867021, "o", "        node_ids.add(\"End\")\r\n\u001b[?2004l\r"]
[40.867043, "o", "\u001b[?2004h> "]
[40.867066, "o", "    \r\n\u001b[?2004l\r"]
[40.867096, "o", "\u001b[?2004h"]
[40.867126, "o", "> "]
[40.867155, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.867197, "o", "        \"nodes\": nodes,\r\n\u001b[?2004l\r"]
[40.867219, "o", "\u001b[?2004h> "]
[40.867269, "o", "        \"edges\": edges\r\n\u001b[?2004l\r"]
[40.86729, "o", "\u001b[?2004h> "]
[40.867314, "o", "    }\r\n\u001b[?2004l\r"]
[40.867336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.867358, "o", "> \r\n\u001b[?2004l\r"]
[40.867388, "o", "\u001b[?2004h> "]
[40.86752, "o", "def validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:\r\n\u001b[?2004l\r"]
[40.867548, "o", "\u001b[?2004h> "]
[40.867587, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.867722, "o", "    Validate the graph for reachability and edge integrity.\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.867734, "o", "> "]
[40.86777, "o", "    \r\n\u001b[?2004l\r"]
[40.867797, "o", "\u001b[?2004h>     Returns:\r\n\u001b[?2004l\r"]
[40.867824, "o", "\u001b[?2004h> "]
[40.86792, "o", "        Tuple of (is_valid, list_of_errors)\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.867934, "o", "> "]
[40.867978, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[40.868009, "o", "\u001b[?2004h> "]
[40.868044, "o", "    errors = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.868085, "o", "> "]
[40.868119, "o", "    nodes = graph[\"nodes\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.868181, "o", "    edges = graph[\"edges\"]\r\n\u001b[?2004l\r"]
[40.868217, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[40.868259, "o", "\u001b[?2004h> "]
[40.868322, "o", "    node_ids = {n[\"id\"] for n in nodes}\r\n\u001b[?2004l\r"]
[40.868357, "o", "\u001b[?2004h> "]
[40.8684, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.868487, "o", "    # Check all edge targets exist (except End)\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.868502, "o", "> "]
[40.868551, "o", "    for edge in edges:\r\n\u001b[?2004l\r"]
[40.868588, "o", "\u001b[?2004h> "]
[40.868712, "o", "        if edge[\"to\"] not in node_ids and edge[\"to\"] != \"End\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.868727, "o", "> "]
[40.868929, "o", "            errors.append(f\"Edge target '{edge['to']}' from '{edge['from']}' does not exist\")\r\n\u001b[?2004l\r"]
[40.868938, "o", "\u001b[?2004h> "]
[40.868966, "o", "    \r\n\u001b[?2004l\r"]
[40.868989, "o", "\u001b[?2004h> "]
[40.869054, "o", "    # Check reachability from Start\r\n\u001b[?2004l\r"]
[40.869076, "o", "\u001b[?2004h> "]
[40.869153, "o", "    if \"Start\" not in node_ids:\r\n\u001b[?2004l\r"]
[40.869182, "o", "\u001b[?2004h> "]
[40.869265, "o", "        errors.append(\"No 'Start' node found\")\r\n\u001b[?2004l\r"]
[40.869287, "o", "\u001b[?2004h> "]
[40.869304, "o", "    else:\r\n"]
[40.869326, "o", "\u001b[?2004l\r"]
[40.869356, "o", "\u001b[?2004h> "]
[40.869393, "o", "        reachable = set()\r\n\u001b[?2004l\r"]
[40.869421, "o", "\u001b[?2004h> "]
[40.869485, "o", "        queue = deque([\"Start\"])\r\n\u001b[?2004l\r"]
[40.869533, "o", "\u001b[?2004h> "]
[40.869582, "o", "        reachable.add(\"Start\")\r\n\u001b[?2004l\r"]
[40.869601, "o", "\u001b[?2004h> "]
[40.869619, "o", "        \r\n\u001b[?2004l\r"]
[40.869643, "o", "\u001b[?2004h> "]
[40.869694, "o", "        while queue:\r\n\u001b[?2004l\r"]
[40.86971, "o", "\u001b[?2004h> "]
[40.869797, "o", "            current = queue.popleft()\r\n\u001b[?2004l\r"]
[40.869826, "o", "\u001b[?2004h"]
[40.869848, "o", "> "]
[40.869883, "o", "            for edge in edges:\r\n\u001b[?2004l\r"]
[40.869902, "o", "\u001b[?2004h> "]
[40.870065, "o", "                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\r\n\u001b[?2004l\r"]
[40.870087, "o", "\u001b[?2004h"]
[40.870117, "o", "> "]
[40.870186, "o", "                    reachable.add(edge[\"to\"])\r\n\u001b[?2004l\r"]
[40.870209, "o", "\u001b[?2004h> "]
[40.870299, "o", "                    if edge[\"to\"] != \"End\":\r\n\u001b[?2004l\r"]
[40.870308, "o", "\u001b[?2004h> "]
[40.870421, "o", "                        queue.append(edge[\"to\"])\r\n\u001b[?2004l\r"]
[40.870444, "o", "\u001b[?2004h> "]
[40.870463, "o", "        \r\n\u001b[?2004l\r"]
[40.870486, "o", "\u001b[?2004h> "]
[40.870594, "o", "        unreachable = node_ids - reachable - {\"End\"}\r\n\u001b[?2004l\r"]
[40.870619, "o", "\u001b[?2004h> "]
[40.870692, "o", "        for node_id in unreachable:\r\n\u001b[?2004l\r"]
[40.870723, "o", "\u001b[?2004h> "]
[40.870879, "o", "            errors.append(f\"Node '{node_id}' is not reachable from 'Start'\")\r\n\u001b[?2004l\r"]
[40.870899, "o", "\u001b[?2004h"]
[40.870929, "o", ">     \r\n\u001b[?2004l\r"]
[40.870953, "o", "\u001b[?2004h> "]
[40.871009, "o", "    return len(errors) == 0, errors\r\n\u001b[?2004l\r"]
[40.871031, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.871064, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.871088, "o", "\u001b[?2004h> "]
[40.871141, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[40.871164, "o", "\u001b[?2004h> "]
[40.871254, "o", "    with open('/app/script.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[40.871279, "o", "\u001b[?2004h> "]
[40.871346, "o", "        script_content = f.read()\r\n\u001b[?2004l\r"]
[40.871366, "o", "\u001b[?2004h> "]
[40.871397, "o", "    \r\n\u001b[?2004l\r"]
[40.871421, "o", "\u001b[?2004h> "]
[40.871486, "o", "    graph = parse_script(script_content)\r\n\u001b[?2004l\r"]
[40.871506, "o", "\u001b[?2004h> "]
[40.871529, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.871547, "o", "> "]
[40.871576, "o", "    # Validate\r\n\u001b[?2004l\r"]
[40.871596, "o", "\u001b[?2004h> "]
[40.871723, "o", "    is_valid, validation_errors = validate_graph(graph)\r\n\u001b[?2004l\r"]
[40.871747, "o", "\u001b[?2004h> "]
[40.871805, "o", "    if validation_errors:\r\n\u001b[?2004l\r"]
[40.871828, "o", "\u001b[?2004h> "]
[40.871911, "o", "        print(\"Validation warnings:\")\r\n\u001b[?2004l\r"]
[40.871941, "o", "\u001b[?2004h> "]
[40.872014, "o", "        for error in validation_errors:\r\n\u001b[?2004l\r"]
[40.872037, "o", "\u001b[?2004h> "]
[40.872112, "o", "            print(f\"  - {error}\")\r\n\u001b[?2004l\r"]
[40.872141, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[40.872166, "o", "\u001b[?2004h> "]
[40.872207, "o", "    # Save JSON\r\n\u001b[?2004l\r"]
[40.872235, "o", "\u001b[?2004h> "]
[40.872328, "o", "    with open('/app/dialogue.json', 'w') as f:\r\n\u001b[?2004l\r"]
[40.872353, "o", "\u001b[?2004h> "]
[40.872432, "o", "        json.dump(graph, f, indent=2)\r\n\u001b[?2004l\r"]
[40.872451, "o", "\u001b[?2004h> "]
[40.872479, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.8725, "o", "> "]
[40.872568, "o", "    print(f\"\\nParsed successfully!\")\r\n\u001b[?2004l\r"]
[40.872598, "o", "\u001b[?2004h> "]
[40.872695, "o", "    print(f\"Total nodes: {len(graph['nodes'])}\")\r\n\u001b[?2004l\r"]
[40.872716, "o", "\u001b[?2004h> "]
[40.872821, "o", "    print(f\"Total edges: {len(graph['edges'])}\")\r\n\u001b[?2004l\r"]
[40.872845, "o", "\u001b[?2004h> "]
[40.872923, "o", "    print(f\"Graph valid: {is_valid}\")\r\n\u001b[?2004l\r"]
[40.872944, "o", "\u001b[?2004h> "]
[40.872963, "o", "EOFILE\r\n\u001b[?2004l\r"]
[40.874499, "o", "\u001b[?2004hroot@e21e7ca3003c:/app# "]
[44.257431, "i", "python3 /app/solution.py\n"]
[44.257593, "o", "python3 /app/solution.py\r\n\u001b[?2004l\r"]
