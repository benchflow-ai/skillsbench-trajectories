[141.204347, "i", "t, \"text\": \"\"}\n            edges.append(edge)\n    \n    # Ensure End node exists\n    if \"End\" not in node_ids:\n        nodes.append({\n            \"id\": \"End\",\n            \"text\": \"The End\",\n            \"speaker\": \"Narrator\",\n            \"type\": \"line\"\n        })\n        node_ids.add(\"End\")\n    \n    return {\n        \"nodes\": nodes,\n        \"edges\": edges\n    }\n\n\ndef validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:\n    \"\"\"\n    Validate the graph for reachability and edge integrity.\n    \"\"\"\n    errors = []\n    nodes = graph[\"nodes\"]\n    edges = graph[\"edges\"]\n    \n    node_ids = {n[\"id\"] for n in nodes}\n    \n    # Check all edge targets exist (except End)\n    for edge in edges:\n        if edge[\"to\"] not in node_ids and edge[\"to\"] != \"End\":\n            errors.append(f\"Edge target '{edge['to']}' from '{edge['from']}' does not exist\")\n    \n    # Check reachability from Start\n    if \"Start\" not in node_ids:\n        errors.append(\"No 'Start' node found\")\n    else:\n        reachable = set()\n        queu"]
[141.204363, "i", "e = deque([\"Start\"])\n        reachable.add(\"Start\")\n        \n        while queue:\n            current = queue.popleft()\n            for edge in edges:\n                if edge[\"from\"] == current and edge[\"to\"] not in reachable:\n                    reachable.add(edge[\"to\"])\n                    if edge[\"to\"] != \"End\":\n                        queue.append(edge[\"to\"])\n        \n        unreachable = node_ids - reachable - {\"End\"}\n        for node_id in unreachable:\n            errors.append(f\"Node '{node_id}' is not reachable from 'Start'\")\n    \n    return len(errors) == 0, errors\n\n\ndef generate_dot(graph: Dict[str, Any]) -> str:\n    \"\"\"\n    Generate a Graphviz DOT representation of the dialogue graph.\n    \"\"\"\n    lines = [\"digraph Dialogue {\"]\n    lines.append(\"  rankdir=LR;\")\n    lines.append(\"  node [shape=box, style=rounded];\")\n    \n    nodes = graph[\"nodes\"]\n    edges = graph[\"edges\"]\n    \n    # Add nodes with proper escaping\n    for node in nodes:\n        node_id = node[\"id\"].replace(\"-\", \"_\").replace(\" \", \"_"]
[141.204372, "i", "\")\n        # Escape quotes and special characters in label\n        label = node[\"text\"][:50].replace('\"', '\\\\\"').replace('\\n', ' ')\n        if node[\"type\"] == \"choice\":\n            lines.append(f'  {node_id} [label=\"{label}\", shape=diamond];')\n        else:\n            lines.append(f'  {node_id} [label=\"{label}\"];')\n    \n    # Add edges\n    for edge in edges:\n        from_id = edge[\"from\"].replace(\"-\", \"_\").replace(\" \", \"_\")\n        to_id = edge[\"to\"].replace(\"-\", \"_\").replace(\" \", \"_\")\n        lines.append(f'  {from_id} -> {to_id};')\n    \n    lines.append(\"}\")\n    return \"\\n\".join(lines)\n\n\nif __name__ == \"__main__\":\n    with open('/app/script.txt', 'r') as f:\n        script_content = f.read()\n    \n    graph = parse_script(script_content)\n    \n    # Validate\n    is_valid, validation_errors = validate_graph(graph)\n    if validation_errors:\n        print(\"Validation warnings:\")\n        for error in validation_errors[:10]:\n            print(f\"  - {error}\")\n        if len(validation_errors) > 10:\n            prin"]
[141.204384, "o", "    # Split by scene headers that are on their own line: ^[SceneName]$\r\n"]
[141.204391, "i", "t(f\"  ... and {len(validation_errors) - 10} more errors\")\n    else:\n        print(\"Graph is valid!\")\n    \n    # Save JSON\n    with open('/app/dialogue.json', 'w') as f:\n        json.dump(graph, f, indent=2)\n    \n    # Generate and save DOT\n    dot_content = generate_dot(graph)\n    with open('/app/dialogue.dot', 'w') as f:\n        f.write(dot_content)\n    \n    print(f\"\\nParsed successfully!\")\n    print(f\"Total nodes: {len(graph['nodes'])}\")\n    print(f\"Total edges: {len(graph['edges'])}\")\n    print(f\"Graph valid: {is_valid}\")\n    print(f\"Files created: /app/dialogue.json, /app/dialogue.dot\")\nEOFPYTHON\n"]
