[50.008677, "o", "{\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"Start\",\r\n      \"text\": \"The tavern door creaks open. Smoke and laughter fill the air.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"TavernEntry\",\r\n      \"text\": \"Three figures catch your eye: a hooded stranger, a boisterous merchant, and the barkeep.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"TavernChoice_choice_1\",\r\n      \"text\": \"Approach the hooded stranger.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"TavernChoice_choice_2\",\r\n      \"text\": \"Sit next to the merchant.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"TavernChoice_choice_3\",\r\n      \"text\": \"Order a drink from the barkeep.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"TavernChoice\",\r\n      \"text\": \"\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveRoom\",\r\n      \"text\": \"You notice the stranger slipping a note "]
[50.008709, "o", "to the barkeep. The merchant counts gold nervously.\",\r\n      \"speaker\": \"Narrator\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveChoice_choice_1\",\r\n      \"text\": \"Intercept the note.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveChoice_choice_2\",\r\n      \"text\": \"Pickpocket the merchant.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveChoice_choice_3\",\r\n      \"text\": \"Pretend you saw nothing.\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"choice\"\r\n    },\r\n    {\r\n      \"id\": \"ObserveChoice\",\r\n      \"text\": \"\",\r\n      \"speaker\": \"\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n      \"id\": \"InterceptNote\",\r\n      \"text\": \"You dare?!\",\r\n      \"speaker\": \"Stranger\",\r\n      \"type\": \"line\"\r\n    },\r\n    {\r\n"]
