[40.851176, "o", "\u001b[?2004h"]
[40.851204, "o", "> "]
[40.851372, "o", "    # Split by scene headers [SceneName]\r\n\u001b[?2004l\r"]
[40.851398, "o", "\u001b[?2004h> "]
