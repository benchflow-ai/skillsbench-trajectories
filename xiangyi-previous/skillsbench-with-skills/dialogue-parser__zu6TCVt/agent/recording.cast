[167.466478, "i", "python3 << 'PYEOF'\nimport json\n\nwith open('/app/dialogue.json', 'r') as f:\n    graph = json.load(f)\n\nprint(\"JSON Structure:\")\nprint(f\"  Top-level keys: {list(graph.keys())}\")\nprint(f\"  Number of nodes: {len(graph['nodes'])}\")\nprint(f\"  Number of edges: {len(graph['edges'])}\")\n\nprint(\"\\nSample nodes:\")\nfor node in graph['nodes'][:5]:\n    print(f\"  - id: {node['id']}, type: {node['type']}, speaker: {node['speaker']}, text: {node['text'][:40]}...\")\n\nprint(\"\\nSample edges:\")\nfor edge in graph['edges'][:5]:\n    print(f\"  - {edge['from']} -> {edge['to']}\")\n\nprint(\"\\nValidation:\")\nnode_ids = {n['id'] for n in graph['nodes']}\nprint(f\"  All nodes have id, text, speaker, type: {all('id' in n and 'text' in n and 'speaker' in n and 'type' in n for n in graph['nodes'])}\")\nprint(f\"  All edges have from, to, text: {all('from' in e and 'to' in e and 'text' in e for e in graph['edges'])}\")\nprint(f\"  Start node exists: {'Start' in node_ids}\")\nprint(f\"  End node exists: {'End' in node_ids}\")\nPYEOF\n"]
