[119.092358, "i", "python3 - <<'PY'\nimport pandas as pd\nacc = pd.read_csv('/app/data/accommodations/clean_accommodations_2022.csv')\nfor city in ['Cleveland','Columbus','Cincinnati']:\n    sub = acc[acc['city'].str.lower()==city.lower()]\n    print('\\n', city, sub.shape)\n    # filter pet-friendly\n    pet = sub[~sub['house_rules'].str.contains('No pets', case=False, na=False)]\n    print('pet-friendly count', pet.shape)\n    print(pet[['NAME','room type','price','house_rules','maximum occupancy']].head(10).to_string(index=False))\nPY\n"]
