[177.012012, "i", "python3 - <<'PY'\nimport pandas as pd\n\ncities = ['Cleveland','Columbus','Cincinnati']\nrest = pd.read_csv('/app/data/restaurants/clean_restaurant_2022.csv')\nfor city in cities:\n    sub = rest[rest['City'].str.lower()==city.lower()]\n    print('\\n', city)\n    for cuisine in ['American','Mediterranean','Chinese','Italian']:\n        match = sub[sub['Cuisines'].str.contains(cuisine, case=False, na=False)]\n        if not match.empty:\n            print(cuisine, match[['Name','Cuisines','Average Cost']].head(5).to_string(index=False))\n        else:\n            print(cuisine, 'NO MATCH')\nPY\n"]
