[144.406725, "o", "(:action \u001b[01;31m\u001b[Kmove_seg_twe4_0_50_seg_rwe_0_50\u001b[m\u001b[K_south_south_medium\r\n\r\n :parameters    (?a - airplane)\r\n\r\n :precondition  (and\r\n                 (has-type ?a medium)\r\n                 (is-moving ?a)\r\n                 (facing ?a south)\r\n                 (at-segment ?a seg_twe4_0_50)\r\n                 (not_occupied seg_rwe_0_50)\r\n                 (not_blocked seg_rwe_0_50 airplane_DAEWH)\r\n"]
