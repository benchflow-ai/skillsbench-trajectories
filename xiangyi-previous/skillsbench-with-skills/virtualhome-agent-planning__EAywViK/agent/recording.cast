[74.982594, "i", "python3 << 'EOF'\nimport re\n\n# Read domain01\nwith open('/app/airport/domain01.pddl', 'r') as f:\n    content = f.read()\n\n# Extract all move action names\nmove_actions = re.findall(r'\\(:action\\s+(move_[^\\s]+)', content)\n\nprint(\"All move actions:\")\nfor i, action in enumerate(move_actions, 1):\n    print(f\"{i}. {action}\")\n\n# Manual parsing - let's look at the structure\nprint(\"\\n\\nManual parsing of first action:\")\naction = move_actions[0]\nprint(f\"Action: {action}\")\nprint(f\"Parts: {action.split('_')}\")\n\n# Try different regex\nfor action in move_actions:\n    # Pattern: move_seg_PP_0_60_seg_PPDOOR_0_40_north_north_medium\n    # Find all numbers and letters between 'seg' keywords\n    parts = action.split('_')\n    print(f\"\\n{action}\")\n    print(f\"Parts: {parts}\")\n    \n    # Find 'seg' positions\n    seg_pos = [i for i, p in enumerate(parts) if p == 'seg']\n    print(f\"Seg positions: {seg_pos}\")\n    \n    if len(seg_pos) >= 2:\n        # From seg\n        from_parts = ['seg']\n        for i in range(seg_pos[0]+1, seg_pos[1]):\n            from_parts.append(parts[i])\n        \n        # To seg  \n        to_parts = ['seg']\n        for i in range(seg_pos[1]+1, len(parts)):\n            if parts[i] in ['north', 'south', 'medium']:\n                break\n            to_parts.append(parts[i])\n        \n        from_seg = '_'.join(from_parts)\n        to_seg = '_'.join(to_parts)\n        print(f\"From: {from_seg}, To: {to_seg}\")\n\nEOF\n"]
