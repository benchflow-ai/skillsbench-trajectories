[157.134867, "i", "python3 << 'EOF'\nimport re\nfrom collections import deque\n\n# Read domain02 and task02\nwith open('/app/airport/domain02.pddl', 'r') as f:\n    domain02_content = f.read()\nwith open('/app/airport/task02.pddl', 'r') as f:\n    problem_content = f.read()\n\n# Extract move action names\nmove_actions = re.findall(r'\\(:action\\s+(move_[^\\s]+)', domain02_content)\n\n# Build transition graph for moves\ntransitions = {}\naction_map = {}\n\nfor action in move_actions:\n    parts = action.split('_')\n    seg_pos = [i for i, p in enumerate(parts) if p == 'seg']\n    \n    if len(seg_pos) >= 2:\n        from_parts = ['seg']\n        for i in range(seg_pos[0]+1, seg_pos[1]):\n            from_parts.append(parts[i])\n        \n        to_parts = ['seg']\n        for i in range(seg_pos[1]+1, len(parts)):\n            if parts[i] in ['north', 'south', 'medium']:\n                break\n            to_parts.append(parts[i])\n        \n        from_seg = '_'.join(from_parts)\n        to_seg = '_'.join(to_parts)\n        \n        if from_seg not in transitions:\n            transitions[from_seg] = []\n        transitions[from_seg].append((to_seg, action))\n        action_map[(from_seg, to_seg)] = action\n\n# Extract startup and takeoff actions\nstartup_actions = re.findall(r'\\(:action\\s+(startup_[^\\s]+)', domain02_content)\ntakeoff_actions = re.findall(r'\\(:action\\s+(takeoff_[^\\s]+)', domain02_content)\n\nprint(f\"Startup actions for seg_twe4_0_50:\")\nfor action in startup_actions:\n    if 'seg_twe4_0_50' in action:\n        print(f\"  {action}\")\n\n# Extract initial state and goal\ninit_match = re.search(r'\\(at-segment\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\nairplane = init_match.group(1)\nstart_seg = init_match.group(2)\n\ngoal_match = re.search(r'\\(airborne\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\ngoal_seg = goal_match.group(2)\n\nprint(f\"\\nStart: {start_seg}, Goal: {goal_seg}\")\nprint(f\"Airplane: {airplane}\")\n\n# BFS to find path\ndef find_path(start, goal):\n    queue = deque([(start, [start])])\n    visited = {start}\n    \n    while queue:\n        current, path = queue.popleft()\n        \n        if current == goal:\n            return path\n        \n        if current in transitions:\n            for next_seg, _ in transitions[current]:\n                if next_seg not in visited:\n                    visited.add(next_seg)\n                    queue.append((next_seg, path + [next_seg]))\n    \n    return None\n\npath = find_path(start_seg, goal_seg)\n\nif path:\n    print(f\"\\nPath found: {path}\")\n    \n    # Generate plan\n    plan_lines = []\n    for i in range(len(path) - 1):\n        from_seg = path[i]\n        to_seg = path[i+1]\n        action = action_map[(from_seg, to_seg)]\n        plan_lines.append(f\"{action}({airplane})\")\n        \n        # Add startup if this is the transition to seg_rwe_0_50\n        if to_seg == 'seg_rwe_0_50':\n            # Add startup at from_seg before this move\n            startup_pattern = f\"startup_{from_seg}_south_medium\"\n            matching_startup = [a for a in startup_actions if a == startup_pattern]\n            if matching_startup:\n                # Insert startup before the move\n                plan_lines.pop()  # Remove the move we just added\n                plan_lines.append(f\"{matching_startup[0]}({airplane})\")\n                plan_lines.append(f\"{action}({airplane})\")\n    \n    # Add takeoff\n    plan_lines.append(f\"takeoff_seg_rwe_0_50_south({airplane})\")\n    \n    # Write plan\n    with open('/app/task02.txt', 'w') as f:\n        for line in plan_lines:\n            f.write(line + '\\n')\n    \n    print(f\"\\nUpdated plan written to /app/task02.txt\")\n    for line in plan_lines:\n        print(f\"  {line}\")\n\nEOF\n"]
[157.145472, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from collections import deque\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read domain02 and task02\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/airport/domain02.pddl', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     domain02_content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/airport/task02.pddl', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     problem_content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract move action names\r\n\u001b[?2004l\r\u001b[?2004h> move_actions = re.findall(r'\\(:action\\s+(move_[^\\s]+)', domain02_content)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build transition graph for moves\r\n\u001b[?2004l\r\u001b[?2004h> transitions = {}\r\n\u001b[?2004l\r\u001b[?2004h> action_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for action in move_actions:\r\n\u001b[?2004l\r\u001b[?2004h>     parts = action.split('_')\r\n\u001b[?2004l\r\u001b[?2004h>     seg_pos = [i for i, p in enumerate(parts) if p == 'seg']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if len(seg_pos) >= 2:\r\n\u001b[?2004l\r\u001b[?2004h>         from_parts = ['seg']\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(seg_pos[0]+1, seg_pos[1]):\r\n\u001b[?2004l\r\u001b[?2004h>             from_parts.append(parts[i])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         to_parts = ['seg']\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(seg_pos[1]+1, len(parts)):\r\n\u001b[?2004l\r\u001b[?2004h>             if parts[i] in ['north', 'south', 'medium']:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             to_parts.append(parts[i])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         from_seg = '_'.join(from_parts)\r\n\u001b[?2004l\r\u001b[?2004h>         to_seg = '_'.join(to_parts)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if from_seg not in transitions:\r\n\u001b[?2004l\r\u001b[?2004h>             transitions[from_seg] = []\r\n\u001b[?2004l\r\u001b[?2004h>         transitions[from_seg].append((to_seg, action))\r\n\u001b[?2004l\r\u001b[?2004h>         action_map[(from_seg, to_seg)] = action\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract startup and takeoff actions\r\n\u001b[?2004l\r\u001b[?2004h> startup_actions = re.findall(r'\\(:action\\s+(startup_[^\\s]+)', domain02_content)\r\n\u001b[?2004l\r\u001b[?2004h> takeoff_actions = re.findall(r'\\(:action\\s+(takeoff_[^\\s]+)', domain02_content)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Startup actions for seg_twe4_0_50:\")\r\n\u001b[?2004l\r\u001b[?2004h> for action in startup_actions:\r\n\u001b[?2004l\r\u001b[?2004h>     if 'seg_twe4_0_50' in action:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  {action}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract initial state and goal\r\n\u001b[?2004l\r\u001b[?2004h> init_match = re.search(r'\\(at-segment\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\r\n\u001b[?2004l\r\u001b[?2004h> airplane = init_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h> start_seg = init_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> goal_match = re.search(r'\\(airborne\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\r\n\u001b[?2004l\r\u001b[?2004h> goal_seg = goal_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nStart: {start_seg}, Goal: {goal_seg}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
