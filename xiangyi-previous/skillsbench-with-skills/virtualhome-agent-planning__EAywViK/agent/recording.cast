[51.052803, "i", "python3 << 'EOF'\nimport re\n\n# Read domain01\nwith open('/app/airport/domain01.pddl', 'r') as f:\n    content = f.read()\n\n# Find all action definitions\naction_blocks = re.findall(r'\\(:action\\s+([^\\s]+)(.*?)(?=\\(:action|\\)\\s*$)', content, re.DOTALL)\n\nprint(f\"Found {len(action_blocks)} action blocks\")\n\n# Manually extract transition info from move actions\nmove_pattern = r'\\(:action\\s+(move_([^_]+)_([^_]+)_[^)]*?)\\s+:parameters\\s+\\(\\?a\\s+-\\s+airplane\\)\\s+:precondition\\s+\\(and(.*?)\\)\\s+:effect\\s+\\(and(.*?)\\)'\nmatches = re.findall(move_pattern, content, re.DOTALL)\n\nprint(f\"\\nFound {len(matches)} move actions\")\n\ntransitions = {}\nfor full_name, from_seg, to_seg, precond, effect in matches[:10]:\n    from_seg_clean = f\"seg_{from_seg}\"\n    to_seg_clean = f\"seg_{to_seg}\"\n    print(f\"\\nAction: {full_name[:60]}...\")\n    print(f\"  From: {from_seg_clean}\")\n    print(f\"  To: {to_seg_clean}\")\n\nEOF\n"]
