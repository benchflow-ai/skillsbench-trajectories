[36.006184, "i", "python3 << 'EOF'\nimport re\n\n# Read domain01 and task01\nwith open('/app/airport/domain01.pddl', 'r') as f:\n    domain01 = f.read()\n\nwith open('/app/airport/task01.pddl', 'r') as f:\n    task01 = f.read()\n\n# Extract all move actions from domain01\nmove_actions = re.findall(r'\\(:action (move_[^\\s]+)', domain01)\nprint(f\"Found {len(move_actions)} move actions in domain01\")\nprint(\"First few move actions:\")\nfor action in move_actions[:5]:\n    print(f\"  {action}\")\n\nEOF\n"]
