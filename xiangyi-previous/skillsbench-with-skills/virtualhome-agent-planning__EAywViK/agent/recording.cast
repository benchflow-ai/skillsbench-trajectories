[108.785377, "o", "                transitions[from_seg] = []\r\n\u001b[?2004l\r"]
[108.785439, "o", "\u001b[?2004h"]
[108.785469, "o", "> "]
[108.785622, "o", "            transitions[from_seg].append((to_seg, action))\r\n"]
[108.785684, "o", "\u001b[?2004l\r"]
