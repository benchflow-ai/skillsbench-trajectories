[108.790911, "o", "\u001b[?2004h"]
[108.791105, "o", "> "]
[108.791321, "o", "        else:  # airborne"]
[108.791423, "o", "\r\n"]
[108.791584, "o", "\u001b[?2004l\r"]
[108.791695, "o", "\u001b[?2004h"]
[108.791782, "o", "> "]
[108.791965, "o", "            goal_seg = goal_match.group(4)"]
[108.792079, "o", "\r\n"]
[108.792155, "o", "\u001b[?2004l\r"]
[108.792254, "o", "\u001b[?2004h"]
[108.792343, "o", "> "]
[108.792573, "o", "            goal_type = 'airborne'\r\n\u001b[?2004l\r"]
[108.792617, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[108.792649, "o", "> "]
[108.792831, "o", "    print(f\"Start: {start_seg}, Goal: {goal_seg} ({goal_type})\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.792949, "o", "    print(f\"Airplane: {airplane}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.793413, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[108.793498, "o", "> "]
[108.793565, "o", "    # BFS to find path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.793744, "o", "    def find_path(start, goal):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.793819, "o", "        queue = deque([(start, [start])])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.793891, "o", "        visited = {start}\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.793977, "o", "        while queue:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.794104, "o", "            current, path = queue.popleft()\r\n\u001b[?2004l\r"]
[108.794191, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.79428, "o", "            if current == goal:\r\n\u001b[?2004l\r"]
[108.794352, "o", "\u001b[?2004h> "]
[108.794443, "o", "                return path\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[108.794503, "o", "\u001b[?2004h> "]
[108.794583, "o", "            if current in transitions:\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.794644, "o", "> "]
[108.794745, "o", "                for next_seg, _ in transitions[current]:\r\n\u001b[?2004l\r"]
[108.794807, "o", "\u001b[?2004h> "]
[108.794901, "o", "                    if next_seg not in visited:\r\n\u001b[?2004l\r"]
[108.794965, "o", "\u001b[?2004h> "]
[108.795044, "o", "                        visited.add(next_seg)\r\n\u001b[?2004l\r"]
[108.795106, "o", "\u001b[?2004h> "]
[108.795254, "o", "                        queue.append((next_seg, path + [next_seg]))\r\n\u001b[?2004l\r"]
[108.795341, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.795432, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.795549, "o", "    path = find_path(start_seg, goal_seg)\r\n\u001b[?2004l\r"]
[108.795637, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.795708, "o", "    if path:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.795793, "o", "        print(f\"Path found: {path}\")\r\n\u001b[?2004l\r"]
[108.795872, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.795951, "o", "        # Generate plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.796035, "o", "        plan_lines = []\r\n\u001b[?2004l\r"]
[108.796096, "o", "\u001b[?2004h> "]
[108.796175, "o", "        for i in range(len(path) - 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.796246, "o", "> "]
[108.796314, "o", "            from_seg = path[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.796391, "o", "            to_seg = path[i+1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.796454, "o", "> "]
[108.796572, "o", "            action = action_map[(from_seg, to_seg)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.796699, "o", "            plan_lines.append(f\"{action}({airplane})\")\r\n\u001b[?2004l\r"]
[108.79678, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[108.796842, "o", "> "]
[108.796956, "o", "        # Add startup and takeoff if goal is airborne\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.797071, "o", "        if goal_type == 'airborne':\r\n\u001b[?2004l\r"]
[108.797131, "o", "\u001b[?2004h> "]
[108.797239, "o", "            # Find appropriate startup action for goal_seg\r\n\u001b[?2004l\r"]
[108.797305, "o", "\u001b[?2004h> "]
[108.797419, "o", "            # Format: startup_seg_RWE_0_50_south_medium\r\n\u001b[?2004l\r"]
[108.797478, "o", "\u001b[?2004h> "]
[108.797564, "o", "            startup_pattern = f\"startup_{goal_seg}_\"\r\n\u001b[?2004l\r"]
[108.797626, "o", "\u001b[?2004h> "]
[108.797832, "o", "            matching_startup = [a for a in startup_actions if a.startswith(startup_pattern)]\r\n\u001b[?2004l\r"]
[108.798003, "o", "\u001b[?2004h>             if matching_startup:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.798189, "o", "                plan_lines.append(f\"{matching_startup[0]}({airplane})\")\r\n\u001b[?2004l\r"]
[108.798263, "o", "\u001b[?2004h> "]
[108.798359, "o", "                print(f\"Added startup: {matching_startup[0]}\")\r\n\u001b[?2004l\r"]
[108.798423, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[108.798485, "o", "\u001b[?2004h> "]
[108.798595, "o", "            # Find appropriate takeoff action for goal_seg\r\n\u001b[?2004l\r"]
[108.798658, "o", "\u001b[?2004h> "]
[108.798751, "o", "            # Format: takeoff_seg_RWE_0_50_south\r\n\u001b[?2004l\r"]
[108.799021, "o", "\u001b[?2004h>             takeoff_pattern = f\"takeoff_{goal_seg}_\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.799187, "o", "            matching_takeoff = [a for a in takeoff_actions if a.startswith(takeoff_pattern)]\r\n\u001b[?2004l\r"]
[108.799296, "o", "\u001b[?2004h>             if matching_takeoff:\r\n\u001b[?2004l\r"]
[108.799368, "o", "\u001b[?2004h> "]
[108.7995, "o", "                plan_lines.append(f\"{matching_takeoff[0]}({airplane})\")\r\n\u001b[?2004l\r"]
[108.799649, "o", "\u001b[?2004h> "]
[108.799928, "o", "                print(f\"Added takeoff: {matching_takeoff[0]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.80015, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h>         # Write plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.800232, "o", "        with open(output_file, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.800534, "o", "            for line in plan_lines:\r\n\u001b[?2004l\r\u001b[?2004h>                 f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.800818, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"\\nPlan written to {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.801004, "o", "        for line in plan_lines:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  {line}\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n"]
[108.801123, "o", "\u001b[?2004l\r\u001b[?2004h>         print(\"No path found!\")\r\n\u001b[?2004l\r"]
