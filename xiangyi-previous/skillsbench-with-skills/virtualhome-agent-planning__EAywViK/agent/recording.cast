[135.558604, "o", "\r\n                (is-moving ?a - airplane)\r\n                (is-pushing ?a - airplane)\r\n--\r\n :precondition  (and\r\n                 (has-type ?a medium)\r\n                 (is-pushing ?a)\r\n--\r\n :precondition  (and\r\n                 (has-type ?a medium)\r\n                 (is-pushing ?a)\r\n--\r\n :parameters (?a - airplane)\r\n\r\n :precondition (and (is-pushing ?a)\r\n--\r\n               )\r\n\r\n :effect       (and (not (is-pushing ?a))\r\n--\r\n :parameters (?a - airplane)\r\n\r\n :precondition (and (is-pushing ?a)\r\n--\r\n               )\r\n\r\n :effect       (and (not (is-pushing ?a))\r\n--\r\n :parameters (?a - airplane)\r\n\r\n"]
