[108.785872, "o", "            action_map[(from_seg, to_seg)] = action\r\n\u001b[?2004l\r"]
[108.785944, "o", "\u001b[?2004h"]
[108.786151, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.786213, "o", "    # Extract startup and takeoff actions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.786303, "o", "    startup_actions = re.findall(r'\\(:action\\s+(startup_[^\\s]+)', domain_content)\r\n\u001b[?2004l\r"]
[108.786434, "o", "\u001b[?2004h> "]
[108.789192, "o", "    takeoff_actions = re.findall(r'\\(:action\\s+(takeoff_[^\\s]+)', domain_content)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Extract initial state\r\n\u001b[?2004l\r\u001b[?2004h>     init_match = re.search(r'\\(at-segment\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\r\n\u001b[?2004l\r\u001b[?2004h>     if init_match:\r\n\u001b[?2004l\r\u001b[?2004h>         airplane = init_match.group(1)\r\n\u001b[?2004l\r\u001b[?2004h>         start_seg = init_match.group(2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Extract goal\r\n\u001b[?2004l\r\u001b[?2004h>     goal_match = re.search(r'\\(is-parked\\s+(\\S+)\\s+(\\S+)\\)|\\(airborne\\s+(\\S+)\\s+(\\S+)\\)', problem_content)\r\n\u001b[?2004l\r\u001b[?2004h>     if goal_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.789423, "o", "        if goal_match.group(1):  # is-parked"]
[108.789526, "o", "\r\n"]
[108.789627, "o", "\u001b[?2004l\r"]
[108.789744, "o", "\u001b[?2004h"]
[108.789843, "o", "> "]
[108.790043, "o", "            goal_seg = goal_match.group(2)"]
[108.790145, "o", "\r\n"]
[108.790246, "o", "\u001b[?2004l\r"]
[108.790355, "o", "\u001b[?2004h"]
