[121.758832, "o", "\u001b[01;31m\u001b[K(:action takeoff_seg_rwe_0_50_south\u001b[m\u001b[K\r\n\r\n :parameters (?a - airplane)\r\n\r\n :precondition (and (at-segment ?a seg_rwe_0_50)\r\n                    (facing ?a south)\r\n                    (is-moving ?a)\r\n               )\r\n\r\n :effect (and (not (occupied seg_rwe_0_50))\r\n              (not_occupied seg_rwe_0_50)\r\n"]
