[95.52696, "i", "python3 << 'EOF'\nimport re\nfrom collections import deque\n\n# Read domain02 to see what actions are available\nwith open('/app/airport/domain02.pddl', 'r') as f:\n    domain02_content = f.read()\n\n# Extract all action names\nall_actions = re.findall(r'\\(:action\\s+([^\\s]+)', domain02_content)\n\nprint(f\"Total actions in domain02: {len(all_actions)}\")\nprint(\"\\nAction types:\")\n\nmove_actions = [a for a in all_actions if a.startswith('move_')]\nstartup_actions = [a for a in all_actions if a.startswith('startup_')]\ntakeoff_actions = [a for a in all_actions if a.startswith('takeoff_')]\nother_actions = [a for a in all_actions if not a.startswith('move_') and not a.startswith('startup_') and not a.startswith('takeoff_')]\n\nprint(f\"Move actions: {len(move_actions)}\")\nprint(f\"Startup actions: {len(startup_actions)}\")\nprint(f\"Takeoff actions: {len(takeoff_actions)}\")\nprint(f\"Other actions: {len(other_actions)}\")\n\nif takeoff_actions:\n    print(\"\\nTakeoff actions:\")\n    for action in takeoff_actions[:5]:\n        print(f\"  {action}\")\n\nif startup_actions:\n    print(\"\\nStartup actions (first 5):\")\n    for action in startup_actions[:5]:\n        print(f\"  {action}\")\n\nEOF\n"]
