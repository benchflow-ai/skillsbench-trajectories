[43.638626, "i", "python3 << 'EOF'\nimport re\n\n# Read domain01\nwith open('/app/airport/domain01.pddl', 'r') as f:\n    domain01_text = f.read()\n\n# Extract action blocks\naction_pattern = r'\\(:action\\s+([^\\s]+).*?:precondition\\s*\\(and([^)]*?)\\)\\s*:effect\\s*\\(and([^)]*?)\\)\\s*\\)'\nactions = re.findall(action_pattern, domain01_text, re.DOTALL)\n\nprint(f\"Found {len(actions)} actions in domain01\")\n\n# Build a transition graph\ntransitions = {}\nfor action_name, precond, effect in actions:\n    # Extract 'at-segment' transitions\n    at_match_pre = re.search(r'\\(at-segment\\s+\\?a\\s+([^)]+)\\)', precond)\n    at_match_eff = re.search(r'\\(at-segment\\s+\\?a\\s+([^)]+)\\)', effect)\n    \n    if at_match_pre and at_match_eff:\n        from_seg = at_match_pre.group(1).strip()\n        to_seg = at_match_eff.group(1).strip()\n        if from_seg not in transitions:\n            transitions[from_seg] = []\n        transitions[from_seg].append((to_seg, action_name))\n\nprint(\"\\nTransition graph:\")\nfor from_seg in sorted(transitions.keys()):\n    print(f\"  {from_seg}:\")\n    for to_seg, action in transitions[from_seg]:\n        print(f\"    -> {to_seg} ({action})\")\n\nEOF\n"]
[43.638954, "o", "python3 << 'EOF'"]
