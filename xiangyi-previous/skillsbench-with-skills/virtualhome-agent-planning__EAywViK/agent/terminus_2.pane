[?2004l[?2004h> def find_path(start, goal, graph):
[?2004l[?2004h>     queue = deque([(start, [start])])
[?2004l[?2004h>     visited = {start}
[?2004l[?2004h>     
[?2004l[?2004h>     while queue:
[?2004l[?2004h>         current, path = queue.popleft()
[?2004l[?2004h>         
[?2004l[?2004h>         if current == goal:
[?2004l[?2004h>             return path
[?2004l[?2004h>         
[?2004l[?2004h>         if current in graph:
[?2004l[?2004h>             for next_seg, action in graph[current]:
[?2004l[?2004h>                 if next_seg not in visited:
[?2004l[?2004h>                     visited.add(next_seg)
[?2004l[?2004h>                     queue.append((next_seg, path + [next_seg]))
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
