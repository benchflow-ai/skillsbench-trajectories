[?2004l[?2004h> import re
[?2004l[?2004h> from collections import deque
[?2004l[?2004h> 
[?2004l[?2004h> def parse_domain_and_generate_plan(domain_file, problem_file, output_file):
[?2004l[?2004h>     # Read files
[?2004l[?2004h>     with open(domain_file, 'r') as f:
[?2004l[?2004h>         domain_content = f.read()
[?2004l[?2004h>     with open(problem_file, 'r') as f:
[?2004l[?2004h>         problem_content = f.read()
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract move action names
[?2004l[?2004h>     move_actions = re.findall(r'\(:action\s+(move_[^\s]+)', domain_content)
[?2004l[?2004h>     
[?2004l[?2004h>     # Build transition graph
