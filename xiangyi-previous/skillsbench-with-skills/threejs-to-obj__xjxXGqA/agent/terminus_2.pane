[?2004l[?2004h> import { createScene } from './data/object.js';
[?2004l[?2004h> import * as fs from 'fs';
[?2004l[?2004h> 
[?2004l[?2004h> // Create the scene from the Three.js file
[?2004l[?2004h> const root = createScene();
[?2004l[?2004h> 
[?2004l[?2004h> // Apply -90 degree X rotation to convert from Three.js Y-up to Blender Z-up
[?2004l[?2004h> // In Three.js, Y is up. In Blender, Z is up.
[?2004l[?2004h> // Rotating -90 degrees around X axis transforms Y-up to Z-up
[?2004l[?2004h> root.rotation.x = -Math.PI / 2;
[?2004l[?2004h> 
[?2004l[?2004h> // Update the world matrix to bake in the transformation
[?2004l[?2004h> root.updateMatrixWorld(true);
[?2004l[?2004h> 
[?2004l[?2004h> // Create the exporter and export
[?2004l[?2004h> const exporter = new OBJExporter();
