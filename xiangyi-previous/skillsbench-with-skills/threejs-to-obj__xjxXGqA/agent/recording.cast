[35.296911, "i", "cat > /root/convert.js << 'EOF'\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from './data/object.js';\nimport * as fs from 'fs';\n\n// Create the scene from the Three.js file\nconst root = createScene();\n\n// Apply -90 degree X rotation to convert from Three.js Y-up to Blender Z-up\n// In Three.js, Y is up. In Blender, Z is up.\n// Rotating -90 degrees around X axis transforms Y-up to Z-up\nroot.rotation.x = -Math.PI / 2;\n\n// Update the world matrix to bake in the transformation\nroot.updateMatrixWorld(true);\n\n// Create the exporter and export\nconst exporter = new OBJExporter();\nconst objData = exporter.parse(root);\n\n// Write to output file\nfs.writeFileSync('/root/output/object.obj', objData);\n\nconsole.log('Successfully exported to /root/output/object.obj');\nEOF\n"]
