[26.256332, "o", "\u001b[?2004hroot@61b0a81a93eb:~# "]
[34.38615, "i", "cat << 'EOF' > /root/process_frames.py\nimport cv2\nimport numpy as np\nimport csv\nimport os\n\ndef count_matches(img_gray, template_path, threshold=0.9):\n    template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n    if template is None:\n        return 0\n    w, h = template.shape[::-1]\n    res = cv2.matchTemplate(img_gray, template, cv2.TM_CCOEFF_NORMED)\n    loc = np.where(res >= threshold)\n    \n    points = list(zip(*loc[::-1]))\n    if not points:\n        return 0\n    \n    # Basic Non-Maximum Suppression to avoid double counting\n    points.sort(key=lambda x: x[0])\n    unique_points = []\n    while points:\n        pt = points.pop(0)\n        unique_points.append(pt)\n        points = [p for p in points if abs(p[0] - pt[0]) > w/2 or abs(p[1] - pt[1]) > h/2]\n    \n    return len(unique_points)\n\nkeyframes = sorted([f for f in os.listdir('/root') if f.startswith('keyframes_') and f.endswith('.png')])\nresults = []\n\nfor kf in keyframes:\n    path = os.path.join('/root', kf)\n    img = cv2.imread(path)\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    cv2.imwrite(path, gray)\n    \n    coins = count_matches(gray, '/root/coin.png')\n    enemies = count_matches(gray, '/root/enemy.png')\n    turtles = count_matches(gray, '/root/turtle.png')\n    \n    results.append({\n        'frame_id': path,\n        'coins': coins,\n        'enemies': enemies,\n        'turtles': turtles\n    })\n\nwith open('/root/counting_results.csv', 'w', newline='') as csvfile:\n    fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    writer.writeheader()\n    for row in results:\n        writer.writerow(row)\nEOF\n"]
