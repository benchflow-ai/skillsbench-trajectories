[198.390484, "o", "\u001b[?2004hroot@64149b234f46:~# "]
[211.765273, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\n\ndef sta_lta_improved(trace, dt, sta_len=0.5, lta_len=5.0):\n    \"\"\"Improved STA/LTA using absolute values.\"\"\"\n    sta_samples = max(1, int(sta_len / dt))\n    lta_samples = max(1, int(lta_len / dt))\n    \n    abs_trace = np.abs(trace)\n    sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')\n    lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')\n    \n    lta[lta < 1e-20] = 1e-20\n    ratio = sta / lta\n    return ratio\n\ndef pick_phases_corrected(data, dt, channels):\n    \"\"\"Phase picking with proper P/S ordering.\"\"\"\n    picks = []\n    \n    # Compute RMS across all channels\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    \n    # Apply STA/LTA\n    ratio = sta_lta_improved(rms, dt, sta_len=0.3, lta_len=2.0)\n    \n    # Find all peaks with adaptive threshold\n    threshold = np.percentile(ratio[100:], 85)\n    peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]\n    \n    # If too few peaks, lower threshold\n    if len(peaks) < 2:\n        threshold = np.percentile(ratio[100:], 70)\n        peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]\n    \n    # Sort peaks by index (temporal order)\n    peaks = np.sort(peaks)\n    \n    # Assign P and S based on temporal order\n    if len(peaks) > 0:\n        picks.append(('P', int(peaks[0])))\n    if len(peaks) > 1:\n        picks.append(('S', int(peaks[1])))\n    \n    return picks\n\n# Process all files\ndata_dir = '/root/data/'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict['data']\n            dt = float(data_dict['dt'])\n            channels = str(data_dict['channels'])\n            \n            picks = pick_phases_corrected(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    'file_name': filename,\n                    'phase': phase,\n                    'pick_idx': idx\n                })\n        except Exception as e:\n            print(f\"Error processing {filename}: {e}\")\n\n# Write results to CSV\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f\"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files\")\nprint(f\"Found {len(results)} picks\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\n\n# Verify P before S\nfiles_with_both = {}\nfor r in results:\n    fname = r['file_name']\n    if fname not in files_with_both:\n        files_with_both[fname] = {'P': [], 'S': []}\n    files_with_both[fname][r['phase']].append(int(r['pick_idx']))\n\nwarnings = 0\nfor fname, picks in files_with_both.items():\n    if len(picks['P']) > 0 and len(picks['S']) > 0:\n        if picks['P'][0] >= picks['S'][0]:\n            warnings += 1\n\nprint(f\"Files with P before S: {100 - warnings}/100\")\n\nEOF\n"]
[211.765679, "o", "python3 << 'EOF'"]
