[240.645096, "o", ">     "]
[240.645448, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[240.645595, "o", "    peaks, _ = signal.find_peaks(signal_data, height=threshold, distance=min_distance_samples)"]
[240.645717, "o", "\r\n"]
[240.64583, "o", "\u001b[?2004l\r"]
[240.645966, "o", "\u001b[?2004h"]
[240.646086, "o", "> "]
[240.64625, "o", "    "]
[240.646437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[240.646551, "o", ">     if len(peaks) < 2:"]
