[240.642735, "o", "def find_peaks_adaptive(signal_data, dt, min_distance_samples=50):"]
[240.642846, "o", "\r\n"]
[240.642959, "o", "\u001b[?2004l\r"]
[240.64311, "o", "\u001b[?2004h"]
[240.643329, "o", "> "]
[240.643437, "o", "    \"\"\"Find peaks with adaptive threshold.\"\"\""]
[240.643546, "o", "\r\n"]
[240.643801, "o", "\u001b[?2004l\r\u001b[?2004h"]
