[240.651437, "o", "\u001b[?2004l\r\u001b[?2004h"]
[240.651683, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[240.651827, "o", "> def pick_phases_advanced(data, dt, channels):"]
[240.651954, "o", "\r\n"]
[240.652134, "o", "\u001b[?2004l\r"]
[240.652456, "o", "\u001b[?2004h"]
[240.652599, "o", ">     \"\"\"Advanced phase picking using multiple methods.\"\"\""]
[240.652737, "o", "\r\n"]
[240.652911, "o", "\u001b[?2004l\r"]
[240.653097, "o", "\u001b[?2004h"]
[240.653306, "o", "> "]
[240.653497, "o", "    picks = []"]
[240.653743, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[240.654027, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[240.654215, "o", ">     # Method 1: STA/LTA on RMS"]
[240.654426, "o", "\r\n"]
[240.654752, "o", "\u001b[?2004l\r\u001b[?2004h"]
[240.65492, "o", ">     rms = np.sqrt(np.mean(data**2, axis=1))"]
[240.655079, "o", "\r\n"]
[240.655832, "o", "\u001b[?2004l\r"]
[240.65605, "o", "\u001b[?2004h>     sta_lta_ratio = sta_lta_picker(rms, dt, sta_len=0.3, lta_len=2.0)"]
[240.656236, "o", "\r\n"]
[240.65641, "o", "\u001b[?2004l\r"]
[240.656613, "o", "\u001b[?2004h"]
[240.657123, "o", "> "]
[240.657286, "o", "    peaks_sta_lta = find_peaks_adaptive(sta_lta_ratio, dt, min_distance_samples=int(0.5/dt))"]
[240.65744, "o", "\r\n"]
[240.657581, "o", "\u001b[?2004l\r"]
[240.657737, "o", "\u001b[?2004h"]
[240.65787, "o", "> "]
[240.65801, "o", "    "]
[240.658143, "o", "\r\n"]
[240.6583, "o", "\u001b[?2004l\r"]
[240.658518, "o", "\u001b[?2004h"]
[240.658648, "o", ">     # Method 2: Energy on RMS"]
[240.658796, "o", "\r\n"]
[240.658987, "o", "\u001b[?2004l\r\u001b[?2004h"]
[240.659231, "o", "> "]
[240.659448, "o", "    energy = energy_picker(rms, dt, window=101)"]
[240.659671, "o", "\r\n"]
[240.659961, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[240.660199, "o", "    peaks_energy = find_peaks_adaptive(energy, dt, min_distance_samples=int(0.5/dt))"]
[240.660328, "o", "\r\n"]
[240.660448, "o", "\u001b[?2004l\r"]
[240.660594, "o", "\u001b[?2004h"]
[240.660741, "o", "> "]
[240.660879, "o", "    "]
[240.661163, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[240.661284, "o", ">     # Method 3: STA/LTA on vertical channel (if available)"]
[240.661393, "o", "\r\n"]
[240.66151, "o", "\u001b[?2004l\r"]
[240.661768, "o", "\u001b[?2004h"]
[240.661874, "o", ">     channel_list = channels.split(',')"]
