[197.549531, "i", "python3 << 'EOF'\nimport csv\nimport numpy as np\n\n# Load results\nresults = []\nwith open('/root/results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        results.append(row)\n\nprint(\"Results Summary:\")\nprint(f\"Total picks: {len(results)}\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\nprint()\n\n# Check P before S\nprint(\"Checking P vs S timing:\")\nfiles_with_both = {}\nfor r in results:\n    fname = r['file_name']\n    if fname not in files_with_both:\n        files_with_both[fname] = {'P': [], 'S': []}\n    files_with_both[fname][r['phase']].append(int(r['pick_idx']))\n\nwarnings = 0\nfor fname, picks in files_with_both.items():\n    if len(picks['P']) > 0 and len(picks['S']) > 0:\n        if picks['P'][0] >= picks['S'][0]:\n            print(f\"  WARNING: {fname} - P({picks['P'][0]}) >= S({picks['S'][0]})\")\n            warnings += 1\n\nif warnings == 0:\n    print(\"  All P picks come before S picks ✓\")\nelse:\n    print(f\"  Found {warnings} files with P after S\")\n\nprint()\nprint(\"Sample picks:\")\nfor i in range(10):\n    r = results[i]\n    print(f\"  {r['file_name']}: {r['phase']} at index {r['pick_idx']}\")\n\nprint()\nprint(\"Statistics on pick indices:\")\np_indices = [int(r['pick_idx']) for r in results if r['phase'] == 'P']\ns_indices = [int(r['pick_idx']) for r in results if r['phase'] == 'S']\nprint(f\"P picks - min: {min(p_indices)}, max: {max(p_indices)}, mean: {np.mean(p_indices):.0f}\")\nprint(f\"S picks - min: {min(s_indices)}, max: {max(s_indices)}, mean: {np.mean(s_indices):.0f}\")\n\nEOF\n"]
