[379.427975, "o", "\u001b[?2004hroot@64149b234f46:~# "]
[393.225424, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\n\ndef compute_sta_lta(trace, dt, sta_len=0.5, lta_len=5.0):\n    \"\"\"Compute STA/LTA ratio.\"\"\"\n    sta_samples = max(1, int(sta_len / dt))\n    lta_samples = max(1, int(lta_len / dt))\n    \n    abs_trace = np.abs(trace)\n    sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')\n    lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')\n    \n    lta[lta < 1e-20] = 1e-20\n    return sta / lta\n\ndef pick_phases_optimized(data, dt, channels):\n    \"\"\"Optimized phase picking.\"\"\"\n    picks = []\n    \n    # Compute RMS across all channels\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    \n    # Apply multiple STA/LTA with different parameters\n    ratio1 = compute_sta_lta(rms, dt, sta_len=0.2, lta_len=2.0)\n    ratio2 = compute_sta_lta(rms, dt, sta_len=0.5, lta_len=5.0)\n    ratio3 = compute_sta_lta(rms, dt, sta_len=0.1, lta_len=1.0)\n    \n    # Combine ratios (average)\n    combined_ratio = (ratio1 + ratio2 + ratio3) / 3.0\n    \n    # Find peaks with adaptive threshold\n    min_dist = int(0.5 / dt)\n    \n    # Try different thresholds\n    for percentile in [85, 80, 75, 70]:\n        threshold = np.percentile(combined_ratio[100:], percentile)\n        peaks, _ = signal.find_peaks(combined_ratio, height=threshold, distance=min_dist)\n        \n        if len(peaks) >= 2:\n            break\n    \n    # Sort peaks by index (temporal order)\n    peaks = np.sort(peaks)\n    \n    # Assign P and S\n    if len(peaks) > 0:\n        picks.append(('P', int(peaks[0])))\n    if len(peaks) > 1:\n        picks.append(('S', int(peaks[1])))\n    \n    return picks\n\n# Process all files\ndata_dir = '/root/data/'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict['data']\n            dt = float(data_dict['dt'])\n            channels = str(data_dict['channels'])\n            \n            picks = pick_phases_optimized(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    'file_name': filename,\n                    'phase': phase,\n                    'pick_idx': idx\n                })\n        except Exception as e:\n            print(f\"Error processing {filename}: {e}\")\n\n# Write results to CSV\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f\"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files\")\nprint(f\"Found {len(results)} picks\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\n\n# Verify P before S\nfiles_dict = {}\nfor r in results:\n    fname = r['file_name']\n    if fname not in files_dict:\n        files_dict[fname] = {}\n    files_dict[fname][r['phase']] = int(r['pick_idx'])\n\nwarnings = 0\nfor fname, picks in files_dict.items():\n    if 'P' in picks and 'S' in picks:\n        if picks['P'] >= picks['S']:\n            warnings += 1\n\nprint(f\"Files with P before S: {100 - warnings}/100\")\nprint(\"\\nResults saved to /root/results.csv\")\n\nEOF\n"]
[393.239965, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def compute_sta_lta(trace, dt, sta_len=0.5, lta_len=5.0):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Compute STA/LTA ratio.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     sta_samples = max(1, int(sta_len / dt))\r\n\u001b[?2004l\r\u001b[?2004h>     lta_samples = max(1, int(lta_len / dt))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     abs_trace = np.abs(trace)\r\n\u001b[?2004l\r\u001b[?2004h>     sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h>     lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     lta[lta < 1e-20] = 1e-20\r\n\u001b[?2004l\r\u001b[?2004h>     return sta / lta\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def pick_phases_optimized(data, dt, channels):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Optimized phase picking.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     picks = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Compute RMS across all channels\r\n\u001b[?2004l\r\u001b[?2004h>     rms = np.sqrt(np.mean(data**2, axis=1))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Apply multiple STA/LTA with different parameters\r\n\u001b[?2004l\r\u001b[?2004h>     ratio1 = compute_sta_lta(rms, dt, sta_len=0.2, lta_len=2.0)\r\n\u001b[?2004l\r\u001b[?2004h>     ratio2 = compute_sta_lta(rms, dt, sta_len=0.5, lta_len=5.0)\r\n\u001b[?2004l\r\u001b[?2004h>     ratio3 = compute_sta_lta(rms, dt, sta_len=0.1, lta_len=1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Combine ratios (average)\r\n\u001b[?2004l\r\u001b[?2004h>     combined_ratio = (ratio1 + ratio2 + ratio3) / 3.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find peaks with adaptive threshold\r\n\u001b[?2004l\r\u001b[?2004h>     min_dist = int(0.5 / dt)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Try different thresholds\r\n\u001b[?2004l\r\u001b[?2004h>     for percentile in [85, 80, 75, 70]:\r\n\u001b[?2004l\r\u001b[?2004h>         threshold = np.percentile(combined_ratio[100:], percentile)\r\n\u001b[?2004l\r\u001b[?2004h>         peaks, _ = signal.find_peaks(combined_ratio, height=threshold, distance=min_dist)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if len(peaks) >= 2:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort peaks by index (temporal order)\r\n\u001b[?2004l\r\u001b[?2004h>     peaks = np.sort(peaks)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Assign P and S\r\n\u001b[?2004l\r\u001b[?2004h>     if len(peaks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('P', int(peaks[0])))\r\n\u001b[?2004l\r\u001b[?2004h>     if len(peaks) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('S', int(peaks[1])))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return picks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Process all files\r\n\u001b[?2004l\r\u001b[?2004h> data_dir = '/root/data/'\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for filename in sorted(os.listdir(data_dir)):\r\n\u001b[?2004l\r\u001b[?2004h>     if filename.endswith('.npz'):\r\n\u001b[?2004l\r\u001b[?2004h>         filepath = os.path.join(data_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             data_dict = np.load(filepath)\r\n\u001b[?2004l\r\u001b[?2004h>             waveform = data_dict['data']\r\n\u001b[?2004l\r\u001b[?2004h>             dt = float(data_dict['dt'])\r\n\u001b[?2004l\r\u001b[?2004h>             channels = str(data_dict['channels'])\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             picks = pick_phases_optimized(waveform, dt, channels)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             for phase, idx in picks:\r\n\u001b[?2004l\r\u001b[?2004h>                 results.append({\r\n\u001b[?2004l\r\u001b[?2004h>                     'file_name': filename,\r\n\u001b[?2004l\r\u001b[?2004h>                     'phase': phase,\r\n\u001b[?2004l\r\u001b[?2004h>                     'pick_idx': idx\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Error processing {filename}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/results.csv', 'w', newline='') as f:"]
