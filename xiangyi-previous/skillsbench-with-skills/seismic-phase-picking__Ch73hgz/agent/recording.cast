[267.140058, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\nimport csv\n\n# Load ground truth and compare with our picks\ndata_dir = '/root/data/'\nresults = {}\n\nwith open('/root/results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        fname = row['file_name']\n        if fname not in results:\n            results[fname] = {}\n        results[fname][row['phase']] = int(row['pick_idx'])\n\n# Check ground truth\nprint(\"Analyzing ground truth information:\")\nprint()\n\nfor filename in sorted(os.listdir(data_dir))[:5]:  # Check first 5 files\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        data_dict = np.load(filepath)\n        \n        p_remark = str(data_dict['p_remark'])\n        s_remark = str(data_dict['s_remark'])\n        p_weight = str(data_dict['p_weight'])\n        s_weight = str(data_dict['s_weight'])\n        \n        print(f\"File: {filename}\")\n        print(f\"  Ground truth - P: {p_remark} (weight={p_weight}), S: {s_remark} (weight={s_weight})\")\n        \n        if filename in results:\n            if 'P' in results[filename]:\n                print(f\"  Our pick - P: {results[filename]['P']}\")\n            if 'S' in results[filename]:\n                print(f\"  Our pick - S: {results[filename]['S']}\")\n        print()\n\nEOF\n"]
