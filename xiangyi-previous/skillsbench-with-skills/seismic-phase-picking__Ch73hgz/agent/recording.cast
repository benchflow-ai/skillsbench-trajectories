[176.184533, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\n\ndef compute_envelope(trace, window=51):\n    \"\"\"Compute envelope using Hilbert transform or moving RMS.\"\"\"\n    # Use moving RMS as it's more stable\n    rms = np.sqrt(np.convolve(trace**2, np.ones(window)/window, mode='same'))\n    return rms\n\ndef kurtosis_picker(trace, window=101):\n    \"\"\"Detect phase arrivals using kurtosis.\"\"\"\n    kurtosis_vals = []\n    for i in range(window, len(trace) - window):\n        window_data = trace[i-window//2:i+window//2]\n        if len(window_data) > 0:\n            # Compute kurtosis\n            mean = np.mean(window_data)\n            std = np.std(window_data)\n            if std > 0:\n                kurt = np.mean(((window_data - mean) / std) ** 4) - 3\n            else:\n                kurt = 0\n            kurtosis_vals.append(kurt)\n        else:\n            kurtosis_vals.append(0)\n    \n    return np.array(kurtosis_vals)\n\ndef sta_lta_improved(trace, dt, sta_len=0.5, lta_len=5.0):\n    \"\"\"Improved STA/LTA using absolute values.\"\"\"\n    sta_samples = max(1, int(sta_len / dt))\n    lta_samples = max(1, int(lta_len / dt))\n    \n    # Use absolute values\n    abs_trace = np.abs(trace)\n    \n    # Smooth with moving average\n    sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')\n    lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')\n    \n    # Avoid division by zero\n    lta[lta < 1e-20] = 1e-20\n    \n    ratio = sta / lta\n    return ratio\n\ndef pick_phases_improved(data, dt, channels):\n    \"\"\"Improved phase picking using multiple methods.\"\"\"\n    picks = []\n    \n    # Compute RMS across all channels\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    \n    # Method 1: STA/LTA on RMS\n    ratio = sta_lta_improved(rms, dt, sta_len=0.3, lta_len=2.0)\n    \n    # Find peaks in STA/LTA ratio\n    threshold = np.percentile(ratio[100:], 90)  # Use 90th percentile as threshold\n    peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]\n    \n    # If no peaks found with high threshold, use lower threshold\n    if len(peaks) == 0:\n        threshold = np.percentile(ratio[100:], 75)\n        peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]\n    \n    # Sort peaks by prominence\n    if len(peaks) > 0:\n        prominences = signal.peak_prominences(ratio, peaks)[0]\n        sorted_indices = np.argsort(-prominences)  # Sort descending\n        peaks = peaks[sorted_indices]\n    \n    # First peak is P, second is S\n    if len(peaks) > 0:\n        picks.append(('P', int(peaks[0])))\n    if len(peaks) > 1:\n        picks.append(('S', int(peaks[1])))\n    \n    return picks\n\n# Process all files\ndata_dir = '/root/data/'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict['data']\n            dt = float(data_dict['dt'])\n            channels = str(data_dict['channels'])\n            \n            picks = pick_phases_improved(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    'file_name': filename,\n                    'phase': phase,\n                    'pick_idx': idx\n                })\n        except Exception as e:\n            print(f\"Error processing {filename}: {e}\")\n\n# Write results to CSV\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f\"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files\")\nprint(f\"Found {len(results)} picks\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\nprint(f\"Results written to /root/results.csv\")\n\nEOF\n"]
