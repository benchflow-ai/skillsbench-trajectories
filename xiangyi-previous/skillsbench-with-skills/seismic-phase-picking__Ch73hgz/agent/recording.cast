[154.771881, "i", "python3 << 'EOF'\nimport numpy as np\n\nfilepath = '/root/data/BG.ACR..DP.0215954.npz'\ndata_dict = np.load(filepath)\nwaveform = data_dict['data']\n\n# Find non-zero samples\nnon_zero_mask = np.any(waveform != 0, axis=1)\nnon_zero_indices = np.where(non_zero_mask)[0]\n\nprint(f\"Total samples: {len(waveform)}\")\nprint(f\"Non-zero samples: {len(non_zero_indices)}\")\nif len(non_zero_indices) > 0:\n    print(f\"Non-zero range: {non_zero_indices[0]} to {non_zero_indices[-1]}\")\n    print(f\"Non-zero data range: [{waveform[non_zero_mask].min():.2e}, {waveform[non_zero_mask].max():.2e}]\")\n\n# Check a different file\nprint(\"\\n\" + \"=\"*50)\nfilepath2 = '/root/data/PB.B045..EH.0385872.npz'\ndata_dict2 = np.load(filepath2)\nwaveform2 = data_dict2['data']\n\nnon_zero_mask2 = np.any(waveform2 != 0, axis=1)\nnon_zero_indices2 = np.where(non_zero_mask2)[0]\n\nprint(f\"\\nFile: PB.B045..EH.0385872.npz\")\nprint(f\"Total samples: {len(waveform2)}\")\nprint(f\"Non-zero samples: {len(non_zero_indices2)}\")\nif len(non_zero_indices2) > 0:\n    print(f\"Non-zero range: {non_zero_indices2[0]} to {non_zero_indices2[-1]}\")\n    print(f\"Non-zero data range: [{waveform2[non_zero_mask2].min():.2e}, {waveform2[non_zero_mask2].max():.2e}]\")\n    print(f\"\\nSample values around index 69 (our P pick):\")\n    print(waveform2[60:80])\n\nEOF\n"]
