[225.337721, "o", "  Median: 91\r\n  Std: 150\r\n\r\nSample picks (first 15):\r\n  BG.ACR..DP.0215954.npz: P at index 3998\r\n  BG.ACR..DP.0215954.npz: S at index 4049\r\n  BG.ACR..DP.0346833.npz: P at index 15\r\n  BG.ACR..DP.0346833.npz: S at index 69\r\n  BG.AL6..DP.0301915.npz: P at index 18\r\n  BG.AL6..DP.0301915.npz: S at index 75\r\n  BG.BRP..DP.0414480.npz: P at index 15\r\n  BG.BRP..DP.0414480.npz: S at index 84\r\n  BG.DRK..DP.0351524.npz: P at index 16\r\n  BG.DRK..DP.0351524.npz: S at index 69\r\n"]
