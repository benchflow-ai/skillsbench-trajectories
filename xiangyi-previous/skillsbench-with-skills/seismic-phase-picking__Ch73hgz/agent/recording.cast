[133.463164, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\n\n# Analyze a few sample files\ndata_dir = '/root/data/'\nsample_files = [\n    'BG.ACR..DP.0215954.npz',\n    'BG.AL6..DP.0301915.npz',\n    'PB.B045..EH.0385872.npz'\n]\n\nfor filename in sample_files:\n    filepath = os.path.join(data_dir, filename)\n    data_dict = np.load(filepath)\n    waveform = data_dict['data']\n    dt = float(data_dict['dt'])\n    channels = str(data_dict['channels'])\n    p_remark = str(data_dict['p_remark'])\n    s_remark = str(data_dict['s_remark'])\n    \n    print(f\"\\nFile: {filename}\")\n    print(f\"  dt: {dt}, channels: {channels}\")\n    print(f\"  p_remark: {p_remark}, s_remark: {s_remark}\")\n    print(f\"  waveform shape: {waveform.shape}\")\n    print(f\"  waveform range: [{waveform.min():.6f}, {waveform.max():.6f}]\")\n    print(f\"  waveform RMS: {np.sqrt(np.mean(waveform**2)):.6f}\")\n    \n    # Compute energy for each channel\n    for i, ch in enumerate(channels.split(',')):\n        energy = np.sqrt(np.sum(waveform[:, i]**2))\n        print(f\"    Channel {ch}: energy={energy:.6f}\")\n\nEOF\n"]
[133.463418, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[133.463663, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.4637, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.463867, "o", "# Analyze a few sample files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.463928, "o", "data_dir = '/root/data/'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.464086, "o", "sample_files = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.464119, "o", "    'BG.ACR..DP.0215954.npz',\r\n\u001b[?2004l\r"]
[133.464268, "o", "\u001b[?2004h> "]
[133.464319, "o", "    'BG.AL6..DP.0301915.npz',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.464479, "o", "    'PB.B045..EH.0385872.npz'\r\n\u001b[?2004l\r"]
[133.464515, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[133.464618, "o", "\u001b[?2004h> "]
[133.464799, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.46499, "o", "for filename in sample_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.465035, "o", "    filepath = os.path.join(data_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>     data_dict = np.load(filepath)\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.465263, "o", "> "]
[133.465463, "o", "    waveform = data_dict['data']\r\n\u001b[?2004l\r\u001b[?2004h>     dt = float(data_dict['dt'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.465503, "o", "    channels = str(data_dict['channels'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.465754, "o", "    p_remark = str(data_dict['p_remark'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
