[240.66276, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[240.662866, "o", "    if len(channel_list) > 0:"]
[240.663004, "o", "\r\n"]
[240.663259, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[240.663373, "o", "        # Assume last channel is vertical (Z component)"]
