[244.033957, "o", "Processed 100 files\r\nFound 200 picks\r\nP picks: 100\r\nS picks: 100\r\n"]
[244.181749, "o", "\u001b[?2004h"]
[244.182311, "o", "root@64149b234f46:~# "]
[253.97187, "i", "python3 << 'EOF'\nimport csv\nimport numpy as np\n\n# Load results\nresults = []\nwith open('/root/results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        results.append(row)\n\nfiles_dict = {}\nfor r in results:\n    fname = r['file_name']\n    if fname not in files_dict:\n        files_dict[fname] = {}\n    files_dict[fname][r['phase']] = int(r['pick_idx'])\n\n# Check P before S\nwarnings = 0\nfor fname, picks in files_dict.items():\n    if 'P' in picks and 'S' in picks:\n        if picks['P'] >= picks['S']:\n            warnings += 1\n            print(f\"WARNING: {fname} - P({picks['P']}) >= S({picks['S']})\")\n\nif warnings == 0:\n    print(\"✓ All P picks come before S picks\")\nelse:\n    print(f\"✗ Found {warnings} files with P after S\")\n\nprint()\n\n# Analyze P-S differences\np_s_diffs = []\nfor fname, picks in files_dict.items():\n    if 'P' in picks and 'S' in picks:\n        diff = picks['S'] - picks['P']\n        p_s_diffs.append(diff)\n\nif p_s_diffs:\n    print(\"P-S time differences (samples, dt=0.01s):\")\n    print(f\"  Min: {min(p_s_diffs)} ({min(p_s_diffs)*0.01:.3f}s)\")\n    print(f\"  Max: {max(p_s_diffs)} ({max(p_s_diffs)*0.01:.3f}s)\")\n    print(f\"  Mean: {np.mean(p_s_diffs):.0f} ({np.mean(p_s_diffs)*0.01:.3f}s)\")\n    print(f\"  Median: {np.median(p_s_diffs):.0f} ({np.median(p_s_diffs)*0.01:.3f}s)\")\n\nprint()\nprint(f\"Total files with both P and S: {len([f for f in files_dict.values() if 'P' in f and 'S' in f])}\")\nprint(f\"Total files with only P: {len([f for f in files_dict.values() if 'P' in f and 'S' not in f])}\")\nprint(f\"Total files with only S: {len([f for f in files_dict.values() if 'P' not in f and 'S' in f])}\")\nprint(f\"Total files with no picks: {len([f for f in files_dict.values() if 'P' not in f and 'S' not in f])}\")\n\nEOF\n"]
