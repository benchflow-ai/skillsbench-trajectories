[111.870852, "o", "    # Compute envelope (absolute value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.87097, "o", "    envelope = np.abs(trace)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.871085, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Compute STA and LTA\r\n\u001b[?2004l\r"]
[111.871203, "o", "\u001b[?2004h> "]
[111.871387, "o", "    sta = np.convolve(envelope, np.ones(sta_samples)/sta_samples, mode='same')\r\n\u001b[?2004l\r"]
[111.871525, "o", "\u001b[?2004h> "]
[111.871656, "o", "    lta = np.convolve(envelope, np.ones(lta_samples)/lta_samples, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.871844, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.871987, "o", "    # Avoid division by zero\r\n\u001b[?2004l\r\u001b[?2004h>     lta[lta == 0] = 1e-10\r\n\u001b[?2004l\r"]
[111.87203, "i", "a/'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict['data']\n            dt = float(data_dict['dt'])\n            channels = str(data_dict['channels'])\n            \n            picks = pick_phases(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    'file_name': filename,\n                    'phase': phase,\n                    'pick_idx': int(idx)\n                })\n        except Exception as e:\n            print(f\"Error processing {filename}: {e}\")\n\n# Write results to CSV\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f\"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files\")\nprint(f\"Found {len(results)} picks\")\nprint(f\"Results written to /root/results.csv\")\n\nEOF\n"]
[111.872488, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Compute ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.872755, "o", "    ratio = sta / lta\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return ratio\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def find_peaks_simple(ratio, threshold=2.0, min_distance=100):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.873015, "o", "    Find peaks in STA/LTA ratio above threshold.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[111.873067, "o", "\u001b[?2004h>     peaks = []\r\n\u001b[?2004l\r\u001b[?2004h>     in_peak = False\r\n\u001b[?2004l\r\u001b[?2004h>     peak_start = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.873342, "o", "    \r\n\u001b[?2004l\r"]
[111.873554, "o", "\u001b[?2004h>     for i in range(len(ratio)):\r\n\u001b[?2004l\r\u001b[?2004h>         if ratio[i] > threshold and not in_peak:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.873759, "o", "            in_peak = True\r\n\u001b[?2004l\r\u001b[?2004h>             peak_start = i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.873977, "o", "        elif ratio[i] <= threshold and in_peak:\r\n\u001b[?2004l\r\u001b[?2004h>             in_peak = False\r\n\u001b[?2004l\r"]
[111.874168, "o", "\u001b[?2004h>             # Record peak center\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.874351, "o", "            peak_idx = peak_start + np.argmax(ratio[peak_start:i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.874546, "o", "            if len(peaks) == 0 or peak_idx - peaks[-1] > min_distance:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.874739, "o", "                peaks.append(peak_idx)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return peaks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.874923, "o", "\u001b[?2004h> def pick_phases(data, dt, channels):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.875105, "o", "    Pick P and S waves from seismic data.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.875287, "o", "    Returns lists of (phase, index) tuples.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     picks = []\r\n\u001b[?2004l\r"]
[111.875489, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Combine all channels (RMS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.875692, "o", "    rms = np.sqrt(np.mean(data**2, axis=1))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.875912, "o", "    # Apply STA/LTA\r\n\u001b[?2004l\r\u001b[?2004h>     ratio = sta_lta_picker(rms, dt, sta_len=0.3, lta_len=3.0)"]
[111.876127, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find peaks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.876312, "o", "    peaks = find_peaks_simple(ratio, threshold=1.8, min_distance=200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.876482, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.876661, "o", "    # First peak is likely P wave, second is likely S wave\r\n\u001b[?2004l\r\u001b[?2004h>     if len(peaks) > 0:"]
[111.879917, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.87998, "o", "> "]
[111.880196, "o", "        picks.append(('P', peaks[0]))"]
[111.880297, "o", "\r\n"]
[111.880382, "o", "\u001b[?2004l\r"]
[111.880474, "o", "\u001b[?2004h"]
[111.880564, "o", "> "]
[111.880704, "o", "    if len(peaks) > 1:"]
[111.880771, "o", "\r\n"]
[111.880844, "o", "\u001b[?2004l\r"]
[111.880927, "o", "\u001b[?2004h"]
[111.881007, "o", "> "]
[111.881172, "o", "        picks.append(('S', peaks[1]))"]
[111.881244, "o", "\r\n"]
[111.881338, "o", "\u001b[?2004l\r"]
[111.881438, "o", "\u001b[?2004h"]
[111.881516, "o", "> "]
[111.881603, "o", "    "]
[111.881672, "o", "\r\n"]
[111.881741, "o", "\u001b[?2004l\r"]
[111.881819, "o", "\u001b[?2004h"]
[111.881899, "o", "> "]
[111.88201, "o", "    return picks"]
