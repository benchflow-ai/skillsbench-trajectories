n\u001b[?2004l\r\u001b[?2004h>     # First peak is P, second is S\r\n\u001b[?2004l\r\u001b[?2004h>     if len(peaks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('P', int(peaks[0])))\r\n\u001b[?2004l\r\u001b[?2004h>     if len(peaks) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('S', int(peaks[1])))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return picks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Process all files\r\n\u001b[?2004l\r\u001b[?2004h> data_dir = '/root/data/'\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for filename in sorted(os.listdir(data_dir)):\r\n\u001b[?2004l\r\u001b[?2004h>     if filename.endswith('.npz'):\r\n\u001b[?2004l\r\u001b[?2004h>         filepath = os.path.join(data_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             data_dict = np.load(filepath)\r\n\u001b[?2004l\r\u001b[?2004h>             waveform = data_dict['data']\r\n\u001b[?2004l\r\u001b[?2004h>             dt = float(data_dict['dt'])\r\n\u001b[?2004l\r\u001b[?2004h>             channels = str(data_dict['channels'])\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             picks = pick_phases_improved(waveform, dt, channels)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             for phase, idx in picks:\r\n\u001b[?2004l\r\u001b[?2004h>                 results.append({\r\n\u001b[?2004l\r\u001b[?2004h>                     'file_name': filename,\r\n\u001b[?2004l\r\u001b[?2004h>                     'phase': phase,\r\n\u001b[?2004l\r\u001b[?2004h>                     'pick_idx': idx\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Error processing {filename}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write results to CSV\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/results.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\r\n\u001b[?2004l\r\u001b[?2004h>     writer.writeheader()\r\n\u001b[?2004l\r\u001b[?2004h>     writer.writerows(results)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
