[214.739516, "o", "\u001b[?2004hroot@64149b234f46:~# "]
[224.376186, "i", "python3 << 'EOF'\nimport csv\nimport numpy as np\n\n# Load results\nresults = []\nwith open('/root/results.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        results.append(row)\n\nprint(\"Results Analysis:\")\nprint(f\"Total picks: {len(results)}\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\nprint()\n\n# Analyze P-S time differences\np_s_diffs = []\nfiles_dict = {}\nfor r in results:\n    fname = r['file_name']\n    if fname not in files_dict:\n        files_dict[fname] = {}\n    files_dict[fname][r['phase']] = int(r['pick_idx'])\n\nfor fname, picks in files_dict.items():\n    if 'P' in picks and 'S' in picks:\n        diff = picks['S'] - picks['P']\n        p_s_diffs.append(diff)\n\nif p_s_diffs:\n    print(\"P-S time differences (in samples):\")\n    print(f\"  Min: {min(p_s_diffs)}\")\n    print(f\"  Max: {max(p_s_diffs)}\")\n    print(f\"  Mean: {np.mean(p_s_diffs):.0f}\")\n    print(f\"  Median: {np.median(p_s_diffs):.0f}\")\n    print(f\"  Std: {np.std(p_s_diffs):.0f}\")\n\nprint()\nprint(\"Sample picks (first 15):\")\nfor i in range(min(15, len(results))):\n    r = results[i]\n    print(f\"  {r['file_name']}: {r['phase']} at index {r['pick_idx']}\")\n\nEOF\n"]
