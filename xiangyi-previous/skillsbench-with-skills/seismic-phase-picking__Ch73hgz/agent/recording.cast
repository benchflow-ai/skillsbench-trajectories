[189.620989, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load results\nresults = pd.read_csv('/root/results.csv')\n\nprint(\"Results Summary:\")\nprint(f\"Total picks: {len(results)}\")\nprint(f\"P picks: {len(results[results['phase'] == 'P'])}\")\nprint(f\"S picks: {len(results[results['phase'] == 'S'])}\")\nprint()\n\n# Check P before S\nprint(\"Checking P vs S timing:\")\nfor filename in results['file_name'].unique():\n    file_picks = results[results['file_name'] == filename].sort_values('phase')\n    p_picks = file_picks[file_picks['phase'] == 'P']['pick_idx'].values\n    s_picks = file_picks[file_picks['phase'] == 'S']['pick_idx'].values\n    \n    if len(p_picks) > 0 and len(s_picks) > 0:\n        if p_picks[0] >= s_picks[0]:\n            print(f\"  WARNING: {filename} - P({p_picks[0]}) >= S({s_picks[0]})\")\n            break\nelse:\n    print(\"  All P picks come before S picks ✓\")\n\nprint()\nprint(\"Sample picks:\")\nprint(results.head(10))\nprint()\nprint(\"Statistics on pick indices:\")\nprint(f\"P picks - min: {results[results['phase'] == 'P']['pick_idx'].min()}, \"\n      f\"max: {results[results['phase'] == 'P']['pick_idx'].max()}, \"\n      f\"mean: {results[results['phase'] == 'P']['pick_idx'].mean():.0f}\")\nprint(f\"S picks - min: {results[results['phase'] == 'S']['pick_idx'].min()}, \"\n      f\"max: {results[results['phase'] == 'S']['pick_idx'].max()}, \"\n      f\"mean: {results[results['phase'] == 'S']['pick_idx'].mean():.0f}\")\n\nEOF\n"]
[189.621323, "o", "python3 << 'EOF'"]
[189.621717, "o", "\r\n"]
[189.621965, "o", "\u001b[?2004l\r"]
[189.622256, "o", "\u001b[?2004h"]
[189.622501, "o", "> "]
