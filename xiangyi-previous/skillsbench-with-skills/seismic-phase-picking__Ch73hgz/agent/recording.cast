[211.811386, "o", "print(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.811572, "o", "# Verify P before S\r\n\u001b[?2004l\r\u001b[?2004h> files_with_both = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.811612, "o", "for r in results:\r\n\u001b[?2004l\r\u001b[?2004h>     fname = r['file_name']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.811771, "o", "    if fname not in files_with_both:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.811867, "o", "        files_with_both[fname] = {'P': [], 'S': []}\r\n\u001b[?2004l\r"]
[211.811991, "o", "\u001b[?2004h> "]
[211.812065, "o", "    files_with_both[fname][r['phase']].append(int(r['pick_idx']))\r\n\u001b[?2004l\r"]
[211.812218, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> warnings = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.812461, "o", "> for fname, picks in files_with_both.items():\r\n\u001b[?2004l\r\u001b[?2004h>     if len(picks['P']) > 0 and len(picks['S']) > 0:\r\n\u001b[?2004l\r"]
[211.812725, "o", "\u001b[?2004h> "]
[211.812771, "o", "        if picks['P'][0] >= picks['S'][0]:\r\n\u001b[?2004l\r\u001b[?2004h>             warnings += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.813079, "o", "print(f\"Files with P before S: {100 - warnings}/100\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
