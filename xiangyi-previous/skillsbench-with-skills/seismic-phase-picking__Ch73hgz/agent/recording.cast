[240.629163, "i", "python3 << 'EOF'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\n\ndef sta_lta_picker(trace, dt, sta_len=0.5, lta_len=5.0):\n    \"\"\"STA/LTA picker.\"\"\"\n    sta_samples = max(1, int(sta_len / dt))\n    lta_samples = max(1, int(lta_len / dt))\n    \n    abs_trace = np.abs(trace)\n    sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')\n    lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')\n    \n    lta[lta < 1e-20] = 1e-20\n    return sta / lta\n\ndef energy_picker(trace, dt, window=101):\n    \"\"\"Energy-based picker.\"\"\"\n    energy = np.convolve(trace**2, np.ones(window)/window, mode='same')\n    return energy\n\ndef find_peaks_adaptive(signal_data, dt, min_distance_samples=50):\n    \"\"\"Find peaks with adaptive threshold.\"\"\"\n    # Use percentile-based threshold\n    threshold = np.percentile(signal_data[100:], 80)\n    \n    peaks, _ = signal.find_peaks(signal_data, height=threshold, distance=min_distance_samples)\n    \n    if len(peaks) < 2:\n        threshold = np.percentile(signal_data[100:], 70)\n        peaks, _ = signal.find_peaks(signal_data, height=threshold, distance=min_distance_samples)\n    \n    if len(peaks) < 2:\n        threshold = np.percentile(signal_data[100:], 60)\n        peaks, _ = signal.find_peaks(signal_data, height=threshold, distance=min_distance_samples)\n    \n    return np.sort(peaks)\n\ndef pick_phases_advanced(data, dt, channels):\n    \"\"\"Advanced phase picking using multiple methods.\"\"\"\n    picks = []\n    \n    # Method 1: STA/LTA on RMS\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    sta_lta_ratio = sta_lta_picker(rms, dt, sta_len=0.3, lta_len=2.0)\n    peaks_sta_lta = find_peaks_adaptive(sta_lta_ratio, dt, min_distance_samples=int(0.5/dt))\n    \n    # Method 2: Energy on RMS\n    energy = energy_picker(rms, dt, window=101)\n    peaks_energy = find_peaks_adaptive(energy, dt, min_distance_samples=int(0.5/dt))\n    \n    # Method 3: STA/LTA on vertical channel (if available)\n    channel_list = channels.split(',')\n    peaks_vertical = []\n    if len(channel_list) > 0:\n        # Assume last channel is vertical (Z component)\n        vertical_idx = len(channel_list) - 1\n        vertical_data = data[:, vertical_idx]\n        sta_lta_vert = sta_lta_picker(vertical_data, dt, sta_len=0.3, lta_len=2.0)\n        peaks_vertical = find_peaks_adaptive(sta_lta_vert, dt, min_distance_samples=int(0.5/dt))\n    \n    # Combine peaks from all methods\n    all_peaks = []\n    for p in peaks_sta_lta:\n        all_peaks.append(p)\n    for p in peaks_energy:\n        if not any(abs(p - ap) < int(0.2/dt) for ap in all_peaks):\n            all_peaks.append(p)\n    for p in peaks_vertical:\n        if not any(abs(p - ap) < int(0.2/dt) for ap in all_peaks):\n            all_peaks.append(p)\n    \n    all_peaks = np.sort(np.array(all_peaks))\n    \n    # Assign P and S based on temporal order\n    if len(all_peaks) > 0:\n        picks.append(('P', int(all_peaks[0])))\n    if len(all_peaks) > 1:\n        picks.append(('S', int(all_peaks[1])))\n    \n    return picks\n\n# Process all files\ndata_dir = '/root/data/'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith('.npz'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict['data']\n            dt = float(data_dict['dt'])\n            channels = str(data_dict['channels'])\n            \n            picks = pick_phases_advanced(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    'file_name': filename,\n                    'phase': phase,\n                    'pick_idx': idx\n                })\n        except Exception as e:\n            print(f\"Error processing {filename}: {e}\")\n\n# Write results to CSV\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f\"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files\")\nprint(f\"F"]
[240.629293, "i", "ound {len(results)} picks\")\nprint(f\"P picks: {len([r for r in results if r['phase'] == 'P'])}\")\nprint(f\"S picks: {len([r for r in results if r['phase'] == 'S'])}\")\n\nEOF\n"]
