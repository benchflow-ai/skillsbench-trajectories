[240.666838, "o", "> "]
[240.667009, "o", "    "]
[240.667249, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[240.667364, "o", ">     # Combine peaks from all methods"]
[240.6675, "o", "\r\n"]
[240.667668, "o", "\u001b[?2004l\r\u001b[?2004h"]
[240.67184, "o", ">     all_peaks = []"]
[240.671973, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for p in peaks_sta_lta:\r\n\u001b[?2004l\r\u001b[?2004h>         all_peaks.append(p)\r\n\u001b[?2004l\r\u001b[?2004h>     for p in peaks_energy:\r\n\u001b[?2004l\r\u001b[?2004h>         if not any(abs(p - ap) < int(0.2/dt) for ap in all_peaks):\r\n\u001b[?2004l\r\u001b[?2004h>             all_peaks.append(p)\r\n\u001b[?2004l\r\u001b[?2004h>     for p in peaks_vertical:\r\n\u001b[?2004l\r\u001b[?2004h>         if not any(abs(p - ap) < int(0.2/dt) for ap in all_peaks):\r\n\u001b[?2004l\r\u001b[?2004h>             all_peaks.append(p)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     all_peaks = np.sort(np.array(all_peaks))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Assign P and S based on temporal order\r\n\u001b[?2004l\r\u001b[?2004h>     if len(all_peaks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('P', int(all_peaks[0])))\r\n\u001b[?2004l\r\u001b[?2004h>     if len(all_peaks) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>         picks.append(('S', int(all_peaks[1])))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return picks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Process all files\r\n\u001b[?2004l\r\u001b[?2004h> data_dir = '/root/data/'\r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for filename in sorted(os.listdir(data_dir)):\r\n\u001b[?2004l\r\u001b[?2004h>     if filename.endswith('.npz'):\r\n\u001b[?2004l\r\u001b[?2004h>         filepath = os.path.join(data_dir, filename)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             data_dict = np.load(filepath)\r\n\u001b[?2004l\r\u001b[?2004h>             waveform = data_dict['data']\r\n\u001b[?2004l\r\u001b[?2004h>             dt = float(data_dict['dt'])"]
[240.679769, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             channels = str(data_dict['channels'])\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             picks = pick_phases_advanced(waveform, dt, channels)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             for phase, idx in picks:\r\n\u001b[?2004l\r\u001b[?2004h>                 results.append({\r\n\u001b[?2004l\r\u001b[?2004h>                     'file_name': filename,\r\n\u001b[?2004l\r\u001b[?2004h>                     'phase': phase,\r\n\u001b[?2004l\r\u001b[?2004h>                     'pick_idx': idx\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n"]
