[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def compute_envelope(trace, window=51):
[?2004l[?2004h>     """Compute envelope using Hilbert transform or moving RMS."""
[?2004l[?2004h>     # Use moving RMS as it's more stable
[?2004l[?2004h>     rms = np.sqrt(np.convolve(trace**2, np.ones(window)/window, mode='same'))
[?2004l[?2004h>     return rms
[?2004l[?2004h> 
[?2004l[?2004h> def kurtosis_picker(trace, window=101):
[?2004l[?2004h>     """Detect phase arrivals using kurtosis."""
[?2004l[?2004h>     kurtosis_vals = []
[?2004l[?2004h>     for i in range(window, len(trace) - window):
[?2004l[?2004h>         window_data = trace[i-window//2:i+window//2]
[?2004l[?2004h>         if len(window_data) > 0:
[?2004l[?2004h>             # Compute kurtosis
[?2004l[?2004h>             mean = np.mean(window_data)
[?2004l[?2004h>             std = np.std(window_data)
[?2004l[?2004h>             if std > 0:
[?2004l[?2004h>                 kurt = np.mean(((window_data - mean) / std) ** 4) - 3
[?2004l[?2004h>             else:
[?2004l[?2004h>                 kurt = 0
[?2004l[?2004h>             kurtosis_vals.append(kurt)
[?2004l[?2004h>         else:
[?2004l[?2004h>             kurtosis_vals.append(0)
[?2004l[?2004h>     
[?2004l[?2004h>     return np.array(kurtosis_vals)
[?2004l[?2004h> 
[?2004l[?2004h> def sta_lta_improved(trace, dt, sta_len=0.5, lta_len=5.0):
[?2004l[?2004h>     """Improved STA/LTA using absolute values."""
[?2004l[?2004h>     sta_samples = max(1, int(sta_len / dt))
[?2004l[?2004h>     lta_samples = max(1, int(lta_len / dt))
[?2004l[?2004h>     
[?2004l[?2004h>     # Use absolute values
[?2004l[?2004h>     abs_trace = np.abs(trace)
[?2004l[?2004h>     
[?2004l[?2004h>     # Smooth with moving average
[?2004l[?2004h>     sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')
[?2004l[?2004h>     lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')
[?2004l[?2004h>     
[?2004l[?2004h>     # Avoid division by zero
[?2004l[?2004h>     lta[lta < 1e-20] = 1e-20
[?2004l[?2004h>     
[?2004l[?2004h>     ratio = sta / lta
[?2004l[?2004h>     return ratio
[?2004l[?2004h> 
[?2004l[?2004h> def pick_phases_improved(data, dt, channels):
[?2004l[?2004h>     """Improved phase picking using multiple methods."""
[?2004l[?2004h>     picks = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute RMS across all channels
[?2004l[?2004h>     rms = np.sqrt(np.mean(data**2, axis=1))
[?2004l[?2004h>     
[?2004l[?2004h>     # Method 1: STA/LTA on RMS
[?2004l[?2004h>     ratio = sta_lta_improved(rms, dt, sta_len=0.3, lta_len=2.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find peaks in STA/LTA ratio
[?2004l[?2004h>     threshold = np.percentile(ratio[100:], 90)  # Use 90th percentile as threshold
[?2004l[?2004h>     peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]
[?2004l[?2004h>     
[?2004l[?2004h>     # If no peaks found with high threshold, use lower threshold
[?2004l[?2004h>     if len(peaks) == 0:
[?2004l[?2004h>         threshold = np.percentile(ratio[100:], 75)
[?2004l[?2004h>         peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort peaks by prominence
[?2004l[?2004h>     if len(peaks) > 0:
[?2004l[?2004h>         prominences = signal.peak_prominences(ratio, peaks)[0]
[?2004l[?2004h>         sorted_indices = np.argsort(-prominences)  # Sort descending
[?2004l[?2004h>         peaks = peaks[sorted_indices]
[?2004l[?2004h>     
[?2004l[?2004h>     # First peak is P, second is S
[?2004l[?2004h>     if len(peaks) > 0:
[?2004l[?2004h>         picks.append(('P', int(peaks[0])))
[?2004l[?2004h>     if len(peaks) > 1:
[?2004l[?2004h>         picks.append(('S', int(peaks[1])))
[?2004l[?2004h>     
[?2004l[?2004h>     return picks
[?2004l[?2004h> 
[?2004l[?2004h> # Process all files
[?2004l[?2004h> data_dir = '/root/data/'
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for filename in sorted(os.listdir(data_dir)):
[?2004l[?2004h>     if filename.endswith('.npz'):
[?2004l[?2004h>         filepath = os.path.join(data_dir, filename)
[?2004l[?2004h>         try:
[?2004l[?2004h>             data_dict = np.load(filepath)
[?2004l[?2004h>             waveform = data_dict['data']
[?2004l[?2004h>             dt = float(data_dict['dt'])
[?2004l[?2004h>             channels = str(data_dict['channels'])
[?2004l[?2004h>             
[?2004l[?2004h>             picks = pick_phases_improved(waveform, dt, channels)
[?2004l[?2004h>             
[?2004l[?2004h>             for phase, idx in picks:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     'file_name': filename,
[?2004l[?2004h>                     'phase': phase,
[?2004l[?2004h>                     'pick_idx': idx
[?2004l[?2004h>                 })
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error processing {filename}: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     writer.writerows(results)
[?2004l[?2004h> 
