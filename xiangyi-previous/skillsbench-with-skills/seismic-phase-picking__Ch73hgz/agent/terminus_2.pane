[?2004l[?2004h> def sta_lta_improved(trace, dt, sta_len=0.5, lta_len=5.0):
[?2004l[?2004h>     """Improved STA/LTA using absolute values."""
[?2004l[?2004h>     sta_samples = max(1, int(sta_len / dt))
[?2004l[?2004h>     lta_samples = max(1, int(lta_len / dt))
[?2004l[?2004h>     
[?2004l[?2004h>     abs_trace = np.abs(trace)
[?2004l[?2004h>     sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode='same')
[?2004l[?2004h>     lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode='same')
[?2004l[?2004h>     
[?2004l[?2004h>     lta[lta < 1e-20] = 1e-20
[?2004l[?2004h>     ratio = sta / lta
[?2004l[?2004h>     return ratio
[?2004l[?2004h> 
[?2004l[?2004h> def pick_phases_corrected(data, dt, channels):
[?2004l[?2004h>     """Phase picking with proper P/S ordering."""
[?2004l[?2004h>     picks = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute RMS across all channels
[?2004l[?2004h>     rms = np.sqrt(np.mean(data**2, axis=1))
[?2004l[?2004h>     
[?2004l[?2004h>     # Apply STA/LTA
[?2004l[?2004h>     ratio = sta_lta_improved(rms, dt, sta_len=0.3, lta_len=2.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find all peaks with adaptive threshold
[?2004l[?2004h>     threshold = np.percentile(ratio[100:], 85)
[?2004l[?2004h>     peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]
[?2004l[?2004h>     
[?2004l[?2004h>     # If too few peaks, lower threshold
[?2004l[?2004h>     if len(peaks) < 2:
[?2004l[?2004h>         threshold = np.percentile(ratio[100:], 70)
[?2004l[?2004h>         peaks = signal.find_peaks(ratio, height=threshold, distance=int(0.5/dt))[0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort peaks by index (temporal order)
[?2004l[?2004h>     peaks = np.sort(peaks)
[?2004l[?2004h>     
[?2004l[?2004h>     # Assign P and S based on temporal order
[?2004l[?2004h>     if len(peaks) > 0:
[?2004l[?2004h>         picks.append(('P', int(peaks[0])))
[?2004l[?2004h>     if len(peaks) > 1:
[?2004l[?2004h>         picks.append(('S', int(peaks[1])))
[?2004l[?2004h>     
[?2004l[?2004h>     return picks
[?2004l[?2004h> 
[?2004l[?2004h> # Process all files
[?2004l[?2004h> data_dir = '/root/data/'
[?2004l[?2004h> results = []
