[?2004l[?2004h>                     'file_name': filename,
[?2004l[?2004h>                     'phase': phase,
[?2004l[?2004h>                     'pick_idx': idx
[?2004l[?2004h>                 })
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error processing {filename}: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/results.csv', 'w', newline='') as f:
