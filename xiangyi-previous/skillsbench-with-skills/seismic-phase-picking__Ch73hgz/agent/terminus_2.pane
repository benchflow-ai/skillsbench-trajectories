[?2004hroot@64149b234f46:~# python3 << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> import csv
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> def sta_lta_picker(trace, dt, sta_len=0.5, lta_len=5.0):
[?2004l[?2004h>     """
[?2004l[?2004h>     Simple STA/LTA picker for phase detection.
[?2004l[?2004h>     Returns indices where STA/LTA ratio exceeds threshold.
[?2004l[?2004h>     """
[?2004l[?2004h>     sta_samples = int(sta_len / dt)
[?2004l[?2004h>     lta_samples = int(lta_len / dt)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute envelope (absolute value)
[?2004l[?2004h>     envelope = np.abs(trace)
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute STA and LTA
[?2004l[?2004h>     sta = np.convolve(envelope, np.ones(sta_samples)/sta_samples, mode='same')
[?2004l[?2004h>     lta = np.convolve(envelope, np.ones(lta_samples)/lta_samples, mode='same')
[?2004l[?2004h>     
[?2004l[?2004h>     # Avoid division by zero
[?2004l[?2004h>     lta[lta == 0] = 1e-10
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute ratio
[?2004l[?2004h>     ratio = sta / lta
[?2004l[?2004h>     
[?2004l[?2004h>     return ratio
[?2004l[?2004h> 
[?2004l[?2004h> def find_peaks_simple(ratio, threshold=2.0, min_distance=100):
[?2004l[?2004h>     """
[?2004l[?2004h>     Find peaks in STA/LTA ratio above threshold.
[?2004l[?2004h>     """
[?2004l[?2004h>     peaks = []
[?2004l[?2004h>     in_peak = False
[?2004l[?2004h>     peak_start = 0
[?2004l[?2004h>     
[?2004l[?2004h>     for i in range(len(ratio)):
[?2004l[?2004h>         if ratio[i] > threshold and not in_peak:
[?2004l[?2004h>             in_peak = True
[?2004l[?2004h>             peak_start = i
[?2004l[?2004h>         elif ratio[i] <= threshold and in_peak:
[?2004l[?2004h>             in_peak = False
[?2004l[?2004h>             # Record peak center
[?2004l[?2004h>             peak_idx = peak_start + np.argmax(ratio[peak_start:i])
[?2004l[?2004h>             if len(peaks) == 0 or peak_idx - peaks[-1] > min_distance:
[?2004l[?2004h>                 peaks.append(peak_idx)
[?2004l[?2004h>     
[?2004l[?2004h>     return peaks
[?2004l[?2004h> 
[?2004l[?2004h> def pick_phases(data, dt, channels):
[?2004l[?2004h>     """
[?2004l[?2004h>     Pick P and S waves from seismic data.
[?2004l[?2004h>     Returns lists of (phase, index) tuples.
[?2004l[?2004h>     """
[?2004l[?2004h>     picks = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Combine all channels (RMS)
[?2004l[?2004h>     rms = np.sqrt(np.mean(data**2, axis=1))
[?2004l[?2004h>     
[?2004l[?2004h>     # Apply STA/LTA
[?2004l[?2004h>     ratio = sta_lta_picker(rms, dt, sta_len=0.3, lta_len=3.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find peaks
[?2004l[?2004h>     peaks = find_peaks_simple(ratio, threshold=1.8, min_distance=200)
[?2004l[?2004h>     
[?2004l[?2004h>     # First peak is likely P wave, second is likely S wave
[?2004l[?2004h>     if len(peaks) > 0:
[?2004l[?2004h>         picks.append(('P', peaks[0]))
[?2004l[?2004h>     if len(peaks) > 1:
[?2004l[?2004h>         picks.append(('S', peaks[1]))
[?2004l[?2004h>     
[?2004l[?2004h>     return picks
[?2004l[?2004h> 
[?2004l[?2004h> # Process all files
[?2004l[?2004h> data_dir = '/root/data/'
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for filename in sorted(os.listdir(data_dir)):
[?2004l[?2004h>     if filename.endswith('.npz'):
[?2004l[?2004h>         filepath = os.path.join(data_dir, filename)
[?2004l[?2004h>         try:
[?2004l[?2004h>             data_dict = np.load(filepath)
[?2004l[?2004h>             waveform = data_dict['data']
[?2004l[?2004h>             dt = float(data_dict['dt'])
[?2004l[?2004h>             channels = str(data_dict['channels'])
[?2004l[?2004h>             
[?2004l[?2004h>             picks = pick_phases(waveform, dt, channels)
[?2004l[?2004h>             
[?2004l[?2004h>             for phase, idx in picks:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     'file_name': filename,
[?2004l[?2004h>                     'phase': phase,
[?2004l[?2004h>                     'pick_idx': int(idx)
[?2004l[?2004h>                 })
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error processing {filename}: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write results to CSV
[?2004l[?2004h> with open('/root/results.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.DictWriter(f, fieldnames=['file_name', 'phase', 'pick_idx'])
[?2004l[?2004h>     writer.writeheader()
[?2004l[?2004h>     writer.writerows(results)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Processed {len([f for f in os.listdir(data_dir) if f.endswith('.npz')])} files")
[?2004l[?2004h> print(f"Found {len(results)} picks")
[?2004l[?2004h> print(f"Results written to /root/results.csv")
[?2004l[?2004h> 
