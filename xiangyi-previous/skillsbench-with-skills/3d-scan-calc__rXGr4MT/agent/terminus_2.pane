[?2004l[?2004h>     ntri=struct.unpack('<I',f.read(4))[0]
[?2004l[?2004h>     tris=[]
[?2004l[?2004h>     attrs=[]
[?2004l[?2004h>     for i in range(ntri):
[?2004l[?2004h>         data=f.read(50)
[?2004l[?2004h>         if len(data)<50: break
[?2004l[?2004h>         vals=struct.unpack('<12fH',data)
[?2004l[?2004h>         # normal = vals[0:3]
[?2004l[?2004h>         v1=vals[3:6]; v2=vals[6:9]; v3=vals[9:12]
[?2004l[?2004h>         attr=vals[12]
[?2004l[?2004h>         tris.append((v1,v2,v3))
[?2004l[?2004h>         attrs.append(attr)
[?2004l[?2004h> 
[?2004l[?2004h> print('triangles',len(tris))
[?2004l[?2004h> # union-find
[?2004l[?2004h> parent=list(range(len(tris)))
[?2004l[?2004h> rank=[0]*len(tris)
[?2004l[?2004h> 
[?2004l[?2004h> def find(x):
[?2004l[?2004h>     while parent[x]!=x:
[?2004l[?2004h>         parent[x]=parent[parent[x]]
[?2004l[?2004h>         x=parent[x]
[?2004l[?2004h>     return x
[?2004l[?2004h> 
[?2004l[?2004h> def union(a,b):
[?2004l[?2004h>     ra,rb=find(a),find(b)
[?2004l[?2004h>     if ra==rb: return
[?2004l[?2004h>     if rank[ra]<rank[rb]: ra,rb=rb,ra
[?2004l[?2004h>     parent[rb]=ra
[?2004l[?2004h>     if rank[ra]==rank[rb]: rank[ra]+=1
[?2004l[?2004h> 
[?2004l[?2004h> # map vertex to triangle indices
[?2004l[?2004h> vmap=collections.defaultdict(list)
[?2004l[?2004h> for i,(v1,v2,v3) in enumerate(tris):
[?2004l[?2004h>     for v in (v1,v2,v3):
[?2004l[?2004h>         vmap[v].append(i)
[?2004l[?2004h> 
[?2004l[?2004h> for inds in vmap.values():
[?2004l[?2004h>     if len(inds)>1:
[?2004l[?2004h>         first=inds[0]
[?2004l[?2004h>         for j in inds[1:]:
[?2004l[?2004h>             union(first,j)
[?2004l[?2004h> 
[?2004l[?2004h> # compute volume per component
[?2004l[?2004h> comp_vol=collections.defaultdict(float)
[?2004l[?2004h> comp_ids=collections.defaultdict(list)
[?2004l[?2004h> 
[?2004l[?2004h> def tri_volume(v1,v2,v3):
[?2004l[?2004h>     # signed volume of tetrahedron with origin
[?2004l[?2004h>     return (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) - v1[1]*(v2[0]*v3[2]-v2[2]*v3[0]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0]))/6.0
[?2004l[?2004h> 
[?2004l[?2004h> for i,(v1,v2,v3) in enumerate(tris):
[?2004l[?2004h>     r=find(i)
[?2004l[?2004h>     comp_vol[r]+=tri_volume(v1,v2,v3)
[?2004l[?2004h>     comp_ids[r].append(attrs[i])
[?2004l[?2004h> 
[?2004l[?2004h> # largest by absolute volume
[?2004l[?2004h> largest=max(comp_vol.items(), key=lambda kv: abs(kv[1]))
[?2004l[?2004h> comp=largest[0]
[?2004l[?2004h> volume=abs(largest[1])
[?2004l[?2004h> # material id as most common
