[39.54356, "i", "python3 - <<'PY'\nimport struct\npath='/root/scan_data.stl'\nwith open(path,'rb') as f:\n    f.read(80); n=struct.unpack('<I',f.read(4))[0]\n    mins=[1e9,1e9,1e9]; maxs=[-1e9,-1e9,-1e9]\n    for i in range(n):\n        data=f.read(50)\n        if len(data)<50: break\n        vals=struct.unpack('<12fH',data)\n        for v in (vals[3:6],vals[6:9],vals[9:12]):\n            for j in range(3):\n                mins[j]=min(mins[j],v[j]); maxs[j]=max(maxs[j],v[j])\n    print('bbox mins',mins,'maxs',maxs)\n    print('size', [maxs[j]-mins[j] for j in range(3)])\nPY\n"]
