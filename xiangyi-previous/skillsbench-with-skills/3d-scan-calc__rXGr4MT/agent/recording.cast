[6.09865, "o", "\u001b[?2004hroot@562d026d3f1d:~# "]
[6.336162, "i", "sed -n '1,200p' /root/material_density_table.md\n"]
[6.336403, "o", "sed -n '1,200p' /root/material_density_table.md\r\n\u001b[?2004l\r"]
[6.337573, "o", "# Proprietary Material Density Table\r\n\r\nThis table lists the density values for the proprietary materials used in the Constructo-95 system.\r\nUse the Material ID found in the CAD file attributes to lookup the corresponding density.\r\n\r\n| Material ID | Material Name | Density (g/cm³) | Description |\r\n| :--- | :--- | :--- | :--- |\r\n| **1** | Generic Debris | 0.10 | Low-density dust/noise artifacts. |\r\n| **10** | Standard Steel | 7.85 | Common structural steel. |\r\n| **25** | Aluminum 6061 | 2.70 | Aerospace grade aluminum. |\r\n| **42** | Unobtanium | 5.55 | High-strength proprietary alloy. |\r\n| **99** | Lead | 11.34 | Heavy ballast material. |\r\n\r\n## Formula\r\n\r\n$$ Mass = Volume \\times Density $$\r\n\r\nNote: Ensure volume is in $cm^3$ and density is in $g/cm^3$.\r\n"]
[6.337771, "o", "\u001b[?2004hroot@562d026d3f1d:~# "]
[25.336239, "i", "python3 - <<'PY'\nimport struct, math, collections, json\npath='/root/scan_data.stl'\nwith open(path,'rb') as f:\n    header=f.read(80)\n    ntri=struct.unpack('<I',f.read(4))[0]\n    tris=[]\n    attrs=[]\n    for i in range(ntri):\n        data=f.read(50)\n        if len(data)<50: break\n        vals=struct.unpack('<12fH',data)\n        # normal = vals[0:3]\n        v1=vals[3:6]; v2=vals[6:9]; v3=vals[9:12]\n        attr=vals[12]\n        tris.append((v1,v2,v3))\n        attrs.append(attr)\n\nprint('triangles',len(tris))\n# union-find\nparent=list(range(len(tris)))\nrank=[0]*len(tris)\n\ndef find(x):\n    while parent[x]!=x:\n        parent[x]=parent[parent[x]]\n        x=parent[x]\n    return x\n\ndef union(a,b):\n    ra,rb=find(a),find(b)\n    if ra==rb: return\n    if rank[ra]<rank[rb]: ra,rb=rb,ra\n    parent[rb]=ra\n    if rank[ra]==rank[rb]: rank[ra]+=1\n\n# map vertex to triangle indices\nvmap=collections.defaultdict(list)\nfor i,(v1,v2,v3) in enumerate(tris):\n    for v in (v1,v2,v3):\n        vmap[v].append(i)\n\nfor inds in vmap.values():\n    if len(inds)>1:\n        first=inds[0]\n        for j in inds[1:]:\n            union(first,j)\n\n# compute volume per component\ncomp_vol=collections.defaultdict(float)\ncomp_ids=collections.defaultdict(list)\n\ndef tri_volume(v1,v2,v3):\n    # signed volume of tetrahedron with origin\n    return (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) - v1[1]*(v2[0]*v3[2]-v2[2]*v3[0]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0]))/6.0\n\nfor i,(v1,v2,v3) in enumerate(tris):\n    r=find(i)\n    comp_vol[r]+=tri_volume(v1,v2,v3)\n    comp_ids[r].append(attrs[i])\n\n# largest by absolute volume\nlargest=max(comp_vol.items(), key=lambda kv: abs(kv[1]))\ncomp=largest[0]\nvolume=abs(largest[1])\n# material id as most common\nfrom collections import Counter\nmat_id=Counter(comp_ids[comp]).most_common(1)[0][0]\nprint('largest component volume',volume,'material',mat_id,'triangles',len(comp_ids[comp]))\n# maybe need to inspect component counts\nprint('num components',len(comp_vol))\nPY\n"]
