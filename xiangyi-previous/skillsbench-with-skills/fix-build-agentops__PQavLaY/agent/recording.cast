[177.368445, "o", "\r\n"]
[177.368462, "o", "from .host_env import get_host_env"]
[177.368477, "o", "\r\n"]
[177.368491, "o", "from .http_client import HttpClient"]
[177.368505, "o", "\r\n"]
[177.368519, "o", "from .helpers import safe_serialize, get_agentops_version"]
[177.368537, "o", "\r\n"]
[177.368552, "o", "\r\n"]
[177.368566, "o", "from os import environ"]
[177.36858, "o", "\r\n"]
[177.368594, "o", "\r\n"]
[177.368608, "o", "\r\n"]
[177.368622, "o", "class MetaClient(type):"]
[177.368636, "o", "\r\n"]
[177.36865, "o", "    \"\"\"Metaclass to automatically decorate methods with exception handling and provide a shared exception handler.\"\"\""]
[177.368666, "o", "\r\n"]
[177.36868, "o", "\r\n"]
[177.368694, "o", "    def __new__(cls, name, bases, dct):"]
[177.368708, "o", "\r\n"]
[177.368721, "o", "        # Wrap each method with the handle_exceptions decorator"]
[177.368735, "o", "\r\n"]
[177.36875, "o", "        for method_name, method in dct.items():"]
[177.368764, "o", "\r\n"]
[177.368778, "o", "            if (callable(method) and not method_name.startswith(\"__\")) or method_name == \"__init__\":"]
[177.368792, "o", "\r\n"]
[177.368806, "o", "                dct[method_name] = handle_exceptions(method)"]
[177.36882, "o", "\r\n"]
[177.368834, "o", "\r\n"]
[177.368848, "o", "        return super().__new__(cls, name, bases, dct)"]
[177.368861, "o", "\r\n"]
[177.368875, "o", "\r\n"]
[177.368888, "o", "    def send_exception_to_server(cls, exception, api_key):"]
[177.368901, "o", "\r\n"]
[177.368915, "o", "        \"\"\"Class method to send exception to server.\"\"\""]
[177.368929, "o", "\r\n"]
[177.368942, "o", "        if api_key:"]
[177.368958, "o", "\r\n"]
[177.368972, "o", "            exception_type = type(exception).__name__"]
[177.368987, "o", "\r\n"]
[177.369, "o", "            exception_message = str(exception)"]
[177.369014, "o", "\r\n"]
[177.369027, "o", "            exception_traceback = traceback.format_exc()"]
[177.369041, "o", "\r\n"]
[177.369055, "o", "            developer_error = {"]
[177.369068, "o", "\r\n"]
[177.369082, "o", "                \"sdk_version\": get_agentops_version(),"]
[177.369096, "o", "\r\n"]
[177.369109, "o", "                \"type\": exception_type,"]
[177.369123, "o", "\r\n"]
[177.369137, "o", "                \"message\": exception_message,"]
[177.369151, "o", "\r\n"]
[177.369164, "o", "                \"stack_trace\": exception_traceback,"]
[177.369179, "o", "\r\n"]
[177.369192, "o", "                \"host_env\": get_host_env()"]
[177.369206, "o", "\r\n"]
[177.36922, "o", "            }"]
[177.369234, "o", "\r\n"]
[177.369247, "o", "\r\n"]
[177.369261, "o", "            HttpClient.post(\"https://api.agentops.ai/developer_errors\","]
[177.369275, "o", "\r\n"]
[177.369289, "o", "                            safe_serialize(developer_error).encode(\"utf-8\"),"]
[177.369303, "o", "\r\n"]
[177.369317, "o", "                            api_key=api_key)"]
[177.369331, "o", "\r\n"]
[177.369346, "o", "\r\n"]
[177.36936, "o", "\r\n"]
[177.369374, "o", "def handle_exceptions(method):"]
[177.369387, "o", "\r\n"]
[177.369405, "o", "    \"\"\"Decorator within the metaclass to wrap method execution in try-except block.\"\"\""]
[177.36942, "o", "\r\n"]
[177.369433, "o", "\r\n"]
[177.369447, "o", "    def wrapper(self, *args, **kwargs):"]
[177.369461, "o", "\r\n"]
[177.369474, "o", "        try:"]
[177.369488, "o", "\r\n"]
[177.369707, "o", "            return method(self, *args, **kwargs)"]
[177.369721, "o", "\r\n"]
[177.369735, "o", "        except Exception as e:"]
[177.369748, "o", "\r\n"]
[177.369762, "o", "            logger.warning(f\"🖇 AgentOps: Error: {e}\")"]
[177.369776, "o", "\r\n"]
[177.369789, "o", "            config = getattr(self, 'config', None)"]
[177.369802, "o", "\r\n"]
[177.369816, "o", "            if config is not None:"]
[177.369829, "o", "\r\n"]
[177.369844, "o", "                type(self).send_exception_to_server(e, self.config._api_key)"]
[177.36986, "o", "\r\n"]
[177.369874, "o", "            raise e"]
[177.369887, "o", "\r\n"]
[177.369901, "o", "\r\n"]
[177.369915, "o", "    return wrapper"]
[177.369928, "o", "\r\n"]
