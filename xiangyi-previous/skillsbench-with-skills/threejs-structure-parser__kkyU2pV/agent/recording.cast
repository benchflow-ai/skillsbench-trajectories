[61.247003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[61.247053, "o", "\u001b[?2004h> // Traverse and export\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.24709, "o", "> "]
[61.247139, "o", "scene.children.forEach((part) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.247195, "o", "    if (part.isGroup) {\r\n\u001b[?2004l\r"]
[61.247247, "o", "\u001b[?2004h> "]
[61.247327, "o", "        console.log(`\\nProcessing part: ${part.name}`);\r\n\u001b[?2004l\r"]
[61.247352, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[61.247415, "o", "\u001b[?2004h> "]
[61.247487, "o", "        // Create directory for this part\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.247538, "o", "> "]
[61.247609, "o", "        const partDir = path.join(partMeshesDir, part.name);\r\n\u001b[?2004l\r"]
[61.24766, "o", "\u001b[?2004h> "]
[61.247707, "o", "        fs.mkdirSync(partDir, { recursive: true });\r\n\u001b[?2004l\r"]
[61.247733, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[61.247793, "o", "\u001b[?2004h> "]
[61.24785, "o", "        // Export individual meshes in this part\r\n\u001b[?2004l\r"]
[61.247901, "o", "\u001b[?2004h> "]
[61.247952, "o", "        part.traverse((child) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.248014, "o", "            if (child.isMesh && child.geometry) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.248066, "o", "> "]
[61.248127, "o", "                const meshName = child.name || 'unnamed_mesh';\r\n\u001b[?2004l\r"]
[61.248179, "o", "\u001b[?2004h> "]
[61.248239, "o", "                console.log(`  - Exporting mesh: ${meshName}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.248294, "o", "> "]
[61.248347, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.248398, "o", "                const objContent = exportToOBJ(child);\r\n\u001b[?2004l\r"]
[61.248453, "o", "\u001b[?2004h> "]
[61.248564, "o", "                const objPath = path.join(partDir, `${meshName}.obj`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.248643, "o", "> "]
[61.248767, "o", "                fs.writeFileSync(objPath, objContent);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.248842, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.248992, "o", "        // Export the entire part as a single OBJ in links\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249154, "o", "        console.log(`  - Exporting part to links: ${part.name}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249288, "o", "        const partObjContent = exportGroupToOBJ(part);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249447, "o", "        const partObjPath = path.join(linksDir, `${part.name}.obj`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249573, "o", "        fs.writeFileSync(partObjPath, partObjContent);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249629, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.249706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.249758, "o", "console.log('\\nExport complete!');\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.249835, "o", "> "]
[61.249934, "o", "console.log(`Part meshes saved to: ${partMeshesDir}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.25005, "o", "console.log(`Links saved to: ${linksDir}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.250076, "o", "> "]
[61.250131, "o", "SCRIPT_EOF\r\n\u001b[?2004l\r"]
[61.25127, "o", "\u001b[?2004hroot@4c3f9a35caac:~/workspace# "]
