[?2004hroot@b0935b5f72dd:~# cat <<EOF > solve.py
[?2004l[?2004h> import zipfile
[?2004l[?2004h> import shutil
[?2004l[?2004h> import os
[?2004l[?2004h> from pptx import Presentation
[?2004l[?2004h> from pptx.enum.shapes import MSO_SHAPE_TYPE
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Extract text box content
[?2004l[?2004h> prs = Presentation("input.pptx")
[?2004l[?2004h> slide = prs.slides[0]
[?2004l[?2004h> 
[?2004l[?2004h> rate_text = None
[?2004l[?2004h> for shape in slide.shapes:
[?2004l[?2004h>     if shape.has_text_frame:
[?2004l[?2004h>         text = shape.text
[?2004l[?2004h>         if "Updated rate:" in text:
[?2004l[?2004h>             rate_text = text
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h> if not rate_text:
[?2004l[?2004h>     print("Could not find rate text")
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Found rate text: {rate_text}")
[?2004l[?2004h> 
[?2004l[?2004h> # Parse rate text: "Updated rate:\nUSD to CNY=7.02"
[?2004l[?2004h> # We need to be robust. Let's look for "X to Y=Z"
[?2004l[?2004h> match = re.search(r'([A-Z]{3})\s+to\s+([A-Z]{3})\s*=\s*([0-9.]+)', rate_text)
[?2004l[?2004h> if not match:
[?2004l[?2004h>     print("Could not parse rate text")
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> src_currency = match.group(1)
[?2004l[?2004h> tgt_currency = match.group(2)
[?2004l[?2004h> new_rate = float(match.group(3))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Updating {src_currency} to {tgt_currency} with {new_rate}")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Extract embedded Excel file
[?2004l[?2004h> excel_path = "ppt/embeddings/Microsoft_Excel_Worksheet.xlsx"
[?2004l[?2004h> with zipfile.ZipFile("input.pptx", "r") as zin:
[?2004l[?2004h>     with open("temp_excel.xlsx", "wb") as f:
[?2004l[?2004h>         f.write(zin.read(excel_path))
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Modify Excel file
[?2004l[?2004h> wb = openpyxl.load_workbook("temp_excel.xlsx")
[?2004l[?2004h> ws = wb.active
[?2004l[?2004h> 
[?2004l[?2004h> # Find row and column indices
[?2004l[?2004h> # Row headers are in column A (index 1), starting from row 2
[?2004l[?2004h> # Column headers are in row 1, starting from column B (index 2)
[?2004l[?2004h> 
[?2004l[?2004h> row_idx = None
[?2004l[?2004h> col_idx = None
[?2004l[?2004h> 
[?2004l[?2004h> # Find row for src_currency
[?2004l[?2004h> for r in range(2, ws.max_row + 1):
[?2004l[?2004h>     cell_val = ws.cell(row=r, column=1).value
[?2004l[?2004h>     if cell_val == src_currency:
[?2004l[?2004h>         row_idx = r
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> # Find column for tgt_currency
[?2004l[?2004h> for c in range(2, ws.max_column + 1):
[?2004l[?2004h>     cell_val = ws.cell(row=1, column=c).value
[?2004l[?2004h>     if cell_val == tgt_currency:
[?2004l[?2004h>         col_idx = c
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> if row_idx and col_idx:
[?2004l[?2004h>     print(f"Updating cell at ({row_idx}, {col_idx})")
[?2004l[?2004h>     ws.cell(row=row_idx, column=col_idx).value = new_rate
[?2004l[?2004h> else:
[?2004l[?2004h>     print(f"Could not find cell for {src_currency} -> {tgt_currency}")
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> wb.save("temp_excel_modified.xlsx")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Repackage into results.pptx
[?2004l[?2004h> with zipfile.ZipFile("input.pptx", "r") as zin:
[?2004l[?2004h>     with zipfile.ZipFile("results.pptx", "w") as zout:
[?2004l[?2004h>         for item in zin.infolist():
[?2004l[?2004h>             if item.filename == excel_path:
[?2004l[?2004h>                 zout.write("temp_excel_modified.xlsx", excel_path)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 zout.writestr(item, zin.read(item.filename))
[?2004l[?2004h> 
[?2004l[?2004h> print("Done. Saved to results.pptx")
[?2004l[?2004h> EOF
