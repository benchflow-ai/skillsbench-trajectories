[67.870105, "o", "cat skills/jax-skills/jax_skills.py\r\n\u001b[?2004l\r"]
[67.871009, "o", "import jax\r\nimport jax.numpy as jnp\r\nimport numpy as np\r\n\r\n\r\ndef load(path):\r\n    if path.endswith(\".npz\"):\r\n        return dict(np.load(path))\r\n    return jnp.array(np.load(path))\r\n\r\n\r\ndef save(data, path):\r\n    np.save(path, np.array(data))\r\n\r\n\r\ndef map_op(array, op):\r\n    if op == \"square\":\r\n        return jax.vmap(lambda x: x * x)(array)\r\n    raise ValueError(\"Unknown op\")\r\n\r\n\r\ndef reduce_op(array, op, axis):\r\n    if op == \"mean\":\r\n        return jnp.mean(array, axis=axis)\r\n    raise ValueError(\"Unknown reduce op\")\r\n\r\n\r\ndef logistic_grad(x, y, w):\r\n    def loss(w):\r\n        logits = x @ w\r\n        return jnp.mean(jnp.logaddexp(0, -y * logits))\r\n\r\n    return jax.grad(loss)(w)\r\n\r\n\r\ndef rnn_scan(seq, Wx, Wh, b):\r\n    def step(h, x):\r\n        h_new = jnp.tanh(Wx @ x + Wh @ h + b)\r\n        return h_new, h_new\r\n\r\n    h0 = jnp.zeros(Wh.shape[0])\r\n    _, hseq = jax.lax.scan(step, h0, seq)\r\n    return hseq\r\n\r\n\r\ndef jit_run(fn, args):\r\n    return jax.jit(fn)(*args)\r\n"]
[67.871225, "o", "\u001b[?2004hroot@9fd20d920808:/app# "]
[78.801975, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nfrom jax import grad, jit\nimport numpy as np\n\n# Task 3: grad_logistic - CORRECTED\nprint(\"Task 3: grad_logistic (CORRECTED)\")\nlogistic_data = np.load('data/logistic.npz')\nx = jnp.array(logistic_data['x'])\ny = jnp.array(logistic_data['y'])\nw = jnp.array(logistic_data['w'])\n\ndef logistic_loss(w):\n    logits = x @ w\n    return jnp.mean(jnp.logaddexp(0, -y * logits))\n\ngrad_loss = grad(logistic_loss)\nresult = grad_loss(w)\nprint(f\"Gradient shape: {result.shape}\")\nprint(f\"Gradient values: {result}\")\nnp.save('grad_logistic.npy', np.array(result))\nprint(f\"Saved to grad_logistic.npy\")\n\n# Task 4: scan_rnn - CORRECTED\nprint(\"\\nTask 4: scan_rnn (CORRECTED)\")\nseq_data = np.load('data/seq.npz')\nseq = jnp.array(seq_data['seq'])\nWx = jnp.array(seq_data['Wx'])\nWh = jnp.array(seq_data['Wh'])\nb = jnp.array(seq_data['b'])\n\ndef rnn_scan(seq, Wx, Wh, b):\n    def step(h, x):\n        h_new = jnp.tanh(Wx @ x + Wh @ h + b)\n        return h_new, h_new\n    \n    h0 = jnp.zeros(Wh.shape[0])\n    _, hseq = jax.lax.scan(step, h0, seq)\n    return hseq\n\nresult = rnn_scan(seq, Wx, Wh, b)\nprint(f\"RNN output shape: {result.shape}\")\nprint(f\"First 3 timesteps:\\n{result[:3]}\")\nnp.save('scan_rnn.npy', np.array(result))\nprint(f\"Saved to scan_rnn.npy\")\n\n# Task 5: jit_mlp - CORRECTED\nprint(\"\\nTask 5: jit_mlp (CORRECTED)\")\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\ndef mlp_forward(X, W1, b1, W2, b2):\n    h = jnp.tanh(X @ W1 + b1)\n    output = h @ W2 + b2\n    return output\n\nresult = jax.jit(mlp_forward)(X, W1, b1, W2, b2)\nprint(f\"MLP output shape: {result.shape}\")\nprint(f\"Output values:\\n{result}\")\nnp.save('jit_mlp.npy', np.array(result))\nprint(f\"Saved to jit_mlp.npy\")\n\nprint(\"\\nAll tasks corrected and saved!\")\nEOF\n"]
