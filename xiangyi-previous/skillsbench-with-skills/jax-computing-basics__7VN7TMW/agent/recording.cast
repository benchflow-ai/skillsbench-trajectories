[140.182217, "i", "python3 << 'EOF'\nimport jax.numpy as jnp\nimport numpy as np\nfrom numpy.linalg import lstsq\n\nmlp_data = np.load('data/mlp.npz')\nX = np.array(mlp_data['X'])\nW1 = np.array(mlp_data['W1'])\nb1 = np.array(mlp_data['b1'])\nW2 = np.array(mlp_data['W2'])\nb2 = np.array(mlp_data['b2'])\n\nref = np.load('reference/jit_mlp.npy')\n\n# Try to reverse engineer the hidden layer\n# If output = h @ W2 + b2, then h @ W2 = output - b2\noutput_minus_b2 = ref - b2\nprint(f\"output - b2 shape: {output_minus_b2.shape}\")\nprint(f\"output - b2 first row: {output_minus_b2[0]}\")\n\n# Now solve for h: h @ W2 = output_minus_b2\n# This means h = output_minus_b2 @ W2^{-1}\n# But W2 is (10, 2), so we can't directly invert it\n# Let's try least squares: h = (output_minus_b2 @ W2.T) / (W2 @ W2.T)\n\n# Actually, let's just check what h would need to be\n# For each sample, we have: h_i @ W2 = output_i - b2\n# where h_i is (10,), W2 is (10, 2), output_i - b2 is (2,)\n\n# Let's use least squares for the first sample\nsample_idx = 0\noutput_target = output_minus_b2[sample_idx]  # shape (2,)\n# Solve: W2.T @ h = output_target\nh_test, residuals, rank, s = lstsq(W2.T, output_target, rcond=None)\nprint(f\"\\nReverse engineered h[0]: {h_test}\")\nprint(f\"Residuals: {residuals}\")\n\n# Check what tanh(X @ W1 + b1) gives\nh_computed = np.tanh(X @ W1 + b1)\nprint(f\"\\nComputed h[0]: {h_computed[0]}\")\n\n# Check if maybe there's a different activation\nprint(f\"\\nTrying different activations:\")\nprint(f\"relu: {np.maximum(0, X[0] @ W1 + b1)}\")\nprint(f\"sigmoid: {1 / (1 + np.exp(-(X[0] @ W1 + b1)))}\")\nprint(f\"linear: {X[0] @ W1 + b1}\")\nEOF\n"]
[140.182433, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
