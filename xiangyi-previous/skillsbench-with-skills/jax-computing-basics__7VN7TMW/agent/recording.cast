[179.136795, "i", "python3 << 'EOF'\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = np.array(mlp_data['X'])\nW1 = np.array(mlp_data['W1'])\nb1 = np.array(mlp_data['b1'])\nW2 = np.array(mlp_data['W2'])\nb2 = np.array(mlp_data['b2'])\n\nmy_output = np.load('jit_mlp.npy')\nref = np.load('reference/jit_mlp.npy')\n\ndiff = my_output - ref\nprint(\"Difference statistics:\")\nprint(f\"Mean difference: {np.mean(diff)}\")\nprint(f\"Std of difference: {np.std(diff)}\")\nprint(f\"Min difference: {np.min(diff)}\")\nprint(f\"Max difference: {np.max(diff)}\")\nprint(f\"\\nDifference per sample:\")\nfor i in range(len(diff)):\n    print(f\"Sample {i}: {diff[i]}\")\n\n# Check if there's a pattern - maybe one weight matrix is wrong\nprint(f\"\\nWeight statistics:\")\nprint(f\"W1 range: [{W1.min()}, {W1.max()}]\")\nprint(f\"W2 range: [{W2.min()}, {W2.max()}]\")\nprint(f\"b1 range: [{b1.min()}, {b1.max()}]\")\nprint(f\"b2 range: [{b2.min()}, {b2.max()}]\")\n\nprint(f\"\\nOutput statistics:\")\nprint(f\"My output range: [{my_output.min()}, {my_output.max()}]\")\nprint(f\"Ref output range: [{ref.min()}, {ref.max()}]\")\nEOF\n"]
