[208.136311, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nprint(\"Task 5: jit_mlp - CORRECTED with ReLU\")\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\ndef mlp_forward(X, W1, b1, W2, b2):\n    h = jnp.maximum(0, X @ W1 + b1)  # ReLU activation\n    output = h @ W2 + b2\n    return output\n\nresult = jax.jit(mlp_forward)(X, W1, b1, W2, b2)\nprint(f\"MLP output shape: {result.shape}\")\nprint(f\"Output values:\\n{result}\")\nnp.save('jit_mlp.npy', np.array(result))\nprint(f\"Saved to jit_mlp.npy\")\n\n# Verify it matches reference\nref = np.load('reference/jit_mlp.npy')\nif np.allclose(result, ref, rtol=1e-5, atol=1e-6):\n    print(\"\\n✓ PERFECT MATCH with reference!\")\nelse:\n    print(f\"\\nMax difference: {np.max(np.abs(result - ref))}\")\nEOF\n"]
[208.136536, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.136586, "o", "import jax\r\n\u001b[?2004l\r\u001b[?2004h> "]
