[104.115935, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nprint(\"Hidden layer computation:\")\nh = jnp.tanh(X @ W1 + b1)\nprint(f\"h[0]: {h[0]}\")\n\nprint(\"\\nOutput computation:\")\noutput = h @ W2 + b2\nprint(f\"output[0]: {output[0]}\")\n\nref = np.load('reference/jit_mlp.npy')\nprint(f\"\\nreference[0]: {ref[0]}\")\nprint(f\"difference[0]: {output[0] - ref[0]}\")\n\n# Check if maybe the output layer also has tanh\noutput_tanh = jnp.tanh(h @ W2 + b2)\nprint(f\"\\nWith tanh on output: {output_tanh[0]}\")\nprint(f\"Difference with tanh: {output_tanh[0] - ref[0]}\")\nEOF\n"]
