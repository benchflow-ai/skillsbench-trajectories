[91.679361, "o", "print(\"Verifying corrected outputs with reference:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.679468, "o", "files = ['basic_reduce', 'map_square', 'grad_logistic', 'scan_rnn', 'jit_mlp']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.679519, "o", "\u001b[?2004h> "]
[91.679558, "o", "for fname in files:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[91.679604, "o", "\u001b[?2004h> "]
[91.679652, "o", "        output = np.load(f'{fname}.npy')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.679746, "o", "        ref = np.load(f'reference/{fname}.npy')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.679798, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.679844, "o", "        if output.shape != ref.shape:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680012, "o", "            print(f\"\\n{fname}: SHAPE MISMATCH - Output {output.shape} vs Reference {ref.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680061, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680152, "o", "            if np.allclose(output, ref, rtol=1e-5, atol=1e-6):\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.680203, "o", "> "]
[91.680253, "o", "                print(f\"{fname}: ✓ MATCH\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680302, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680385, "o", "                max_diff = np.max(np.abs(output - ref))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680524, "o", "                print(f\"{fname}: VALUES DIFFER - Max difference: {max_diff}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680639, "o", "                print(f\"  Output first row: {output.flat[:3]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680747, "o", "                print(f\"  Reference first row: {ref.flat[:3]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680806, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680889, "o", "        print(f\"{fname}: ERROR - {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.680932, "o", "EOF\r\n\u001b[?2004l\r"]
