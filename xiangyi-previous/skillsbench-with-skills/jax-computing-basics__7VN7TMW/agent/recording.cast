[52.25778, "o", ">             if np.allclose(output, ref, rtol=1e-5, atol=1e-6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.257851, "o", "                print(f\"{fname}: ✓ MATCH\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
