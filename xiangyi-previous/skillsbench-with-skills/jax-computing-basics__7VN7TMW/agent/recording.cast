[208.13665, "o", "> import numpy as np\r\n\u001b[?2004l\r"]
[208.136674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[208.136705, "o", "> "]
[208.136868, "o", "print(\"Task 5: jit_mlp - CORRECTED with ReLU\")\r\n\u001b[?2004l\r\u001b[?2004h> mlp_data = np.load('data/mlp.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.136918, "o", "X = jnp.array(mlp_data['X'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.136961, "o", "W1 = jnp.array(mlp_data['W1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137029, "o", "b1 = jnp.array(mlp_data['b1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137078, "o", "W2 = jnp.array(mlp_data['W2'])\r\n\u001b[?2004l\r"]
[208.137123, "o", "\u001b[?2004h> "]
[208.13717, "o", "b2 = jnp.array(mlp_data['b2'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.137206, "o", "\u001b[?2004h> "]
[208.137268, "o", "def mlp_forward(X, W1, b1, W2, b2):\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.137307, "o", "> "]
[208.137352, "o", "    h = jnp.maximum(0, X @ W1 + b1)  # ReLU activation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137401, "o", "    output = h @ W2 + b2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137441, "o", "    return output\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[208.137481, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[208.137541, "o", "result = jax.jit(mlp_forward)(X, W1, b1, W2, b2)\r\n\u001b[?2004l\r"]
[208.137585, "o", "\u001b[?2004h> "]
[208.137624, "o", "print(f\"MLP output shape: {result.shape}\")\r\n\u001b[?2004l\r"]
[208.137679, "o", "\u001b[?2004h> "]
[208.137716, "o", "print(f\"Output values:\\n{result}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137769, "o", "np.save('jit_mlp.npy', np.array(result))\r\n\u001b[?2004l\r"]
[208.137813, "o", "\u001b[?2004h> "]
[208.137839, "o", "print(f\"Saved to jit_mlp.npy\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.137899, "o", "\u001b[?2004h> "]
[208.13795, "o", "# Verify it matches reference\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.137999, "o", "ref = np.load('reference/jit_mlp.npy')\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.138047, "o", "> "]
[208.138094, "o", "if np.allclose(result, ref, rtol=1e-5, atol=1e-6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.138186, "o", "    print(\"\\n✓ PERFECT MATCH with reference!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.138234, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.138318, "o", "    print(f\"\\nMax difference: {np.max(np.abs(result - ref))}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.138369, "o", "EOF\r\n\u001b[?2004l\r"]
