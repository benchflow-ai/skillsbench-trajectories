[148.735363, "i", "python3 << 'EOF'\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nref = np.load('reference/jit_mlp.npy')\n\nprint(\"Testing different MLP configurations:\")\n\n# 1. Linear hidden layer\noutput_linear = jnp.tanh((X @ W1 + b1) @ W2 + b2)\nprint(f\"1. Linear hidden (tanh output): {output_linear[0]}\")\nprint(f\"   Max diff: {np.max(np.abs(output_linear - ref))}\")\n\n# 2. tanh hidden, linear output (already tested)\noutput_tanh = jnp.tanh(X @ W1 + b1) @ W2 + b2\nprint(f\"2. Tanh hidden, linear output: {output_tanh[0]}\")\nprint(f\"   Max diff: {np.max(np.abs(output_tanh - ref))}\")\n\n# 3. Maybe output should also be tanh\noutput_both_tanh = jnp.tanh(jnp.tanh(X @ W1 + b1) @ W2 + b2)\nprint(f\"3. Both tanh: {output_both_tanh[0]}\")\nprint(f\"   Max diff: {np.max(np.abs(output_both_tanh - ref))}\")\n\n# 4. Maybe weights are scaled by something\nfor scale in [0.1, 0.5, 1.0, 2.0, 10.0]:\n    output_scaled = jnp.tanh(X @ (W1 * scale) + b1) @ W2 + b2\n    diff = np.max(np.abs(output_scaled - ref))\n    if diff < 0.01:\n        print(f\"4. Scaled W1 by {scale}: Max diff: {diff}\")\n        print(f\"   Output[0]: {output_scaled[0]}\")\nEOF\n"]
