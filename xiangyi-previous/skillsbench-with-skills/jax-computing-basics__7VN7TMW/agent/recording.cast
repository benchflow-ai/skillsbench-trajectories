[91.678885, "i", "python3 << 'EOF'\nimport numpy as np\n\nprint(\"Verifying corrected outputs with reference:\")\nfiles = ['basic_reduce', 'map_square', 'grad_logistic', 'scan_rnn', 'jit_mlp']\n\nfor fname in files:\n    try:\n        output = np.load(f'{fname}.npy')\n        ref = np.load(f'reference/{fname}.npy')\n        \n        if output.shape != ref.shape:\n            print(f\"\\n{fname}: SHAPE MISMATCH - Output {output.shape} vs Reference {ref.shape}\")\n        else:\n            if np.allclose(output, ref, rtol=1e-5, atol=1e-6):\n                print(f\"{fname}: ✓ MATCH\")\n            else:\n                max_diff = np.max(np.abs(output - ref))\n                print(f\"{fname}: VALUES DIFFER - Max difference: {max_diff}\")\n                print(f\"  Output first row: {output.flat[:3]}\")\n                print(f\"  Reference first row: {ref.flat[:3]}\")\n    except Exception as e:\n        print(f\"{fname}: ERROR - {e}\")\nEOF\n"]
