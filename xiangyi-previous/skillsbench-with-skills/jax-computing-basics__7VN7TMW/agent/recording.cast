[159.930768, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nref = np.load('reference/jit_mlp.npy')\n\nprint(\"Testing with vmap:\")\n\n# Maybe the MLP should be vmapped?\ndef mlp_single(x):\n    h = jnp.tanh(x @ W1 + b1)\n    return h @ W2 + b2\n\noutput_vmap = jax.vmap(mlp_single)(X)\nprint(f\"With vmap: {output_vmap[0]}\")\nprint(f\"Max diff: {np.max(np.abs(output_vmap - ref))}\")\n\n# Or maybe each sample should be processed separately?\nprint(f\"\\nDirect computation comparison:\")\nfor i in range(min(3, len(X))):\n    h = jnp.tanh(X[i] @ W1 + b1)\n    output = h @ W2 + b2\n    print(f\"Sample {i}: computed {output}, reference {ref[i]}, diff {output - ref[i]}\")\nEOF\n"]
