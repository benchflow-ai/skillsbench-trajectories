[24.402208, "o", "\u001b[?2004hroot@9fd20d920808:/app# "]
[36.73317, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nfrom jax import grad, jit, vmap\nimport numpy as np\nimport json\n\n# Load problem configuration\nwith open('problem.json', 'r') as f:\n    problems = json.load(f)\n\n# Task 1: basic_reduce - compute mean of each row\nprint(\"Task 1: basic_reduce\")\nx = np.load('data/x.npy')\nx_jax = jnp.array(x)\nresult = jnp.mean(x_jax, axis=1)\nprint(f\"Input shape: {x.shape}, Output shape: {result.shape}\")\nnp.save('basic_reduce.npy', np.array(result))\nprint(f\"Saved to basic_reduce.npy\")\n\n# Task 2: map_square - apply square function using vectorization\nprint(\"\\nTask 2: map_square\")\nx = np.load('data/x.npy')\nx_jax = jnp.array(x)\nresult = jnp.square(x_jax)\nprint(f\"Input shape: {x.shape}, Output shape: {result.shape}\")\nnp.save('map_square.npy', np.array(result))\nprint(f\"Saved to map_square.npy\")\n\n# Task 3: grad_logistic - compute gradient of logistic loss\nprint(\"\\nTask 3: grad_logistic\")\nlogistic_data = np.load('data/logistic.npz')\nx = jnp.array(logistic_data['x'])\ny = jnp.array(logistic_data['y'])\nw = jnp.array(logistic_data['w'])\n\ndef logistic_loss(w, x, y):\n    logits = jnp.dot(x, w)\n    predictions = 1.0 / (1.0 + jnp.exp(-logits))\n    loss = -jnp.mean(y * jnp.log(predictions + 1e-10) + (1 - y) * jnp.log(1 - predictions + 1e-10))\n    return loss\n\ngrad_loss = grad(logistic_loss)\nresult = grad_loss(w, x, y)\nprint(f\"Gradient shape: {result.shape}\")\nnp.save('grad_logistic.npy', np.array(result))\nprint(f\"Saved to grad_logistic.npy\")\n\n# Task 4: scan_rnn - implement RNN forward pass using scan\nprint(\"\\nTask 4: scan_rnn\")\nseq_data = np.load('data/seq.npz')\nseq = jnp.array(seq_data['seq'])\ninit = jnp.array(seq_data['init'])\nWx = jnp.array(seq_data['Wx'])\nWh = jnp.array(seq_data['Wh'])\nb = jnp.array(seq_data['b'])\n\ndef rnn_step(h, x_t):\n    h_new = jnp.tanh(jnp.dot(x_t, Wx) + jnp.dot(h, Wh) + b)\n    return h_new, h_new\n\nfrom jax import lax\n_, result = lax.scan(rnn_step, init, seq)\nprint(f\"RNN output shape: {result.shape}\")\nnp.save('scan_rnn.npy', np.array(result))\nprint(f\"Saved to scan_rnn.npy\")\n\n# Task 5: jit_mlp - implement and JIT compile a 2-layer MLP\nprint(\"\\nTask 5: jit_mlp\")\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\n@jit\ndef mlp_forward(X, W1, b1, W2, b2):\n    h = jnp.tanh(jnp.dot(X, W1) + b1)\n    output = jnp.dot(h, W2) + b2\n    return output\n\nresult = mlp_forward(X, W1, b1, W2, b2)\nprint(f\"MLP output shape: {result.shape}\")\nnp.save('jit_mlp.npy', np.array(result))\nprint(f\"Saved to jit_mlp.npy\")\n\nprint(\"\\nAll tasks completed!\")\nEOF\n"]
