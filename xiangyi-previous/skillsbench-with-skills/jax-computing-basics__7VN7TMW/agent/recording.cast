[161.820841, "o", "\u001b[?2004hroot@9fd20d920808:/app# "]
[171.194817, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport json\n\n# Final verification of all tasks\nwith open('problem.json', 'r') as f:\n    problems = json.load(f)\n\nprint(\"Final Verification of All Tasks:\")\nprint(\"=\"*50)\n\nfor problem in problems:\n    task_id = problem['id']\n    input_path = problem['input']\n    output_path = problem['output']\n    description = problem['description']\n    \n    try:\n        output = np.load(output_path)\n        ref = np.load(f'reference/{task_id}.npy')\n        \n        match = np.allclose(output, ref, rtol=1e-5, atol=1e-6)\n        status = \"✓ PASS\" if match else \"✗ FAIL\"\n        \n        print(f\"\\n{task_id}: {status}\")\n        print(f\"  Description: {description}\")\n        print(f\"  Output shape: {output.shape}\")\n        if not match:\n            max_diff = np.max(np.abs(output - ref))\n            print(f\"  Max difference: {max_diff}\")\n    except Exception as e:\n        print(f\"\\n{task_id}: ERROR - {e}\")\n\nprint(\"\\n\" + \"=\"*50)\nEOF\n"]
