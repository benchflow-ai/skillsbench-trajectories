[197.737497, "i", "python3 << 'EOF'\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nref = np.load('reference/jit_mlp.npy')\n\nprint(\"Testing remaining activation functions:\")\n\n# ReLU hidden layer\noutput_relu = jnp.maximum(0, X @ W1 + b1) @ W2 + b2\nprint(f\"ReLU hidden: max_diff = {np.max(np.abs(output_relu - ref)):.6f}\")\n\n# Linear (no activation) hidden layer  \noutput_linear = (X @ W1 + b1) @ W2 + b2\nprint(f\"Linear hidden: max_diff = {np.max(np.abs(output_linear - ref)):.6f}\")\n\n# Sigmoid hidden layer\noutput_sigmoid = (1.0 / (1.0 + jnp.exp(-(X @ W1 + b1)))) @ W2 + b2\nprint(f\"Sigmoid hidden: max_diff = {np.max(np.abs(output_sigmoid - ref)):.6f}\")\n\n# Check if maybe the output should have an activation too\noutput_relu_relu = jnp.maximum(0, jnp.maximum(0, X @ W1 + b1) @ W2 + b2)\nprint(f\"ReLU hidden, ReLU output: max_diff = {np.max(np.abs(output_relu_relu - ref)):.6f}\")\n\noutput_linear_relu = jnp.maximum(0, (X @ W1 + b1) @ W2 + b2)\nprint(f\"Linear hidden, ReLU output: max_diff = {np.max(np.abs(output_linear_relu - ref)):.6f}\")\nEOF\n"]
