[98.931785, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nprint(\"Testing MLP computation:\")\nprint(f\"X shape: {X.shape}\")\nprint(f\"W1 shape: {W1.shape}\")\nprint(f\"b1 shape: {b1.shape}\")\nprint(f\"W2 shape: {W2.shape}\")\nprint(f\"b2 shape: {b2.shape}\")\n\n# Test forward pass\nh = jnp.tanh(X @ W1 + b1)\nprint(f\"\\nHidden layer shape: {h.shape}\")\nprint(f\"Hidden layer first row: {h[0]}\")\n\noutput = h @ W2 + b2\nprint(f\"\\nOutput shape: {output.shape}\")\nprint(f\"Output first row: {output[0]}\")\n\n# Compare with reference\nref = np.load('reference/jit_mlp.npy')\nprint(f\"\\nReference first row: {ref[0]}\")\nprint(f\"Difference: {output[0] - ref[0]}\")\n\n# Try different formulations\nprint(\"\\n=== Trying alternative formulations ===\")\n\n# Maybe the output should use a different activation?\noutput_relu = jnp.maximum(0, h @ W2 + b2)\nprint(f\"With ReLU: {output_relu[0]}\")\n\n# Maybe weights are transposed?\noutput_t = jnp.tanh(X @ W1.T + b1)\nprint(f\"With W1.T: {output_t[0]}\")\nEOF\n"]
