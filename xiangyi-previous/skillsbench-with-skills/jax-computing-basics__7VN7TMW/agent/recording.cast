[115.318293, "i", "python3 << 'EOF'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nmlp_data = np.load('data/mlp.npz')\nX = jnp.array(mlp_data['X'])\nW1 = jnp.array(mlp_data['W1'])\nb1 = jnp.array(mlp_data['b1'])\nW2 = jnp.array(mlp_data['W2'])\nb2 = jnp.array(mlp_data['b2'])\n\nref = np.load('reference/jit_mlp.npy')\n\nprint(\"Testing different weight orderings:\")\n\n# Current approach\noutput1 = jnp.tanh(X @ W1 + b1) @ W2 + b2\nprint(f\"Current (X @ W1 + b1) @ W2 + b2: {output1[0]}\")\nprint(f\"Difference: {np.max(np.abs(output1 - ref))}\")\n\n# Try with transposed W2\noutput2 = jnp.tanh(X @ W1 + b1) @ W2.T + b2\nprint(f\"\\nWith W2.T: {output2[0]}\")\nprint(f\"Difference: {np.max(np.abs(output2 - ref))}\")\n\n# Try with transposed W1\noutput3 = jnp.tanh(X @ W1.T + b1) @ W2 + b2\nprint(f\"\\nWith W1.T: {output3[0]}\")\nprint(f\"Difference: {np.max(np.abs(output3 - ref))}\")\n\n# Try with both transposed\noutput4 = jnp.tanh(X @ W1.T + b1) @ W2.T + b2\nprint(f\"\\nWith W1.T and W2.T: {output4[0]}\")\nprint(f\"Difference: {np.max(np.abs(output4 - ref))}\")\n\n# Try different order of operations\noutput5 = (X @ W1 + b1)\noutput5 = jnp.tanh(output5)\noutput5 = output5 @ W2 + b2\nprint(f\"\\nStep by step: {output5[0]}\")\nprint(f\"Difference: {np.max(np.abs(output5 - ref))}\")\nEOF\n"]
[115.318516, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
