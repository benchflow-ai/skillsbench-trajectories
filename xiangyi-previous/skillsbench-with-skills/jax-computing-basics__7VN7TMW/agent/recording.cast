[36.733994, "o", "# Task 1: basic_reduce - compute mean of each row\r\n\u001b[?2004l\r"]
[36.734041, "o", "\u001b[?2004h> "]
[36.734069, "o", "print(\"Task 1: basic_reduce\")\r\n\u001b[?2004l\r"]
[36.734096, "o", "\u001b[?2004h> "]
[36.734186, "o", "x = np.load('data/x.npy')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734215, "o", "x_jax = jnp.array(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734283, "o", "result = jnp.mean(x_jax, axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734361, "o", "print(f\"Input shape: {x.shape}, Output shape: {result.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734415, "o", "np.save('basic_reduce.npy', np.array(result))\r\n\u001b[?2004l\r"]
[36.734474, "o", "\u001b[?2004h> "]
[36.734518, "o", "print(f\"Saved to basic_reduce.npy\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734632, "o", "# Task 2: map_square - apply square function using vectorization\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734688, "o", "print(\"\\nTask 2: map_square\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734739, "o", "x = np.load('data/x.npy')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734786, "o", "x_jax = jnp.array(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.734841, "o", "result = jnp.square(x_jax)\r\n\u001b[?2004l\r"]
[36.734918, "o", "\u001b[?2004h> "]
[36.734977, "o", "print(f\"Input shape: {x.shape}, Output shape: {result.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735044, "o", "np.save('map_square.npy', np.array(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735106, "o", "print(f\"Saved to map_square.npy\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.735173, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735229, "o", "# Task 3: grad_logistic - compute gradient of logistic loss\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.735275, "o", "> "]
[36.735327, "o", "print(\"\\nTask 3: grad_logistic\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735376, "o", "logistic_data = np.load('data/logistic.npz')\r\n\u001b[?2004l\r"]
[36.735425, "o", "\u001b[?2004h> "]
[36.735482, "o", "x = jnp.array(logistic_data['x'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735538, "o", "y = jnp.array(logistic_data['y'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735575, "o", "w = jnp.array(logistic_data['w'])\r\n\u001b[?2004l\r"]
[36.735622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735669, "o", "def logistic_loss(w, x, y):\r\n\u001b[?2004l\r"]
[36.735695, "o", "\u001b[?2004h> "]
[36.73576, "o", "    logits = jnp.dot(x, w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735798, "o", "    predictions = 1.0 / (1.0 + jnp.exp(-logits))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.735991, "o", "    loss = -jnp.mean(y * jnp.log(predictions + 1e-10) + (1 - y) * jnp.log(1 - predictions + 1e-10))\r\n\u001b[?2004l\r\u001b[?2004h>     return loss\r\n\u001b[?2004l\r"]
[36.736045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736093, "o", "grad_loss = grad(logistic_loss)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736149, "o", "result = grad_loss(w, x, y)\r\n\u001b[?2004l\r"]
[36.736195, "o", "\u001b[?2004h> "]
[36.736242, "o", "print(f\"Gradient shape: {result.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736303, "o", "np.save('grad_logistic.npy', np.array(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736371, "o", "print(f\"Saved to grad_logistic.npy\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.73642, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736497, "o", "# Task 4: scan_rnn - implement RNN forward pass using scan\r\n\u001b[?2004l\r"]
[36.736523, "o", "\u001b[?2004h> "]
[36.736572, "o", "print(\"\\nTask 4: scan_rnn\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736632, "o", "seq_data = np.load('data/seq.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736684, "o", "seq = jnp.array(seq_data['seq'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736748, "o", "init = jnp.array(seq_data['init'])\r\n\u001b[?2004l\r"]
[36.736802, "o", "\u001b[?2004h> "]
[36.736853, "o", "Wx = jnp.array(seq_data['Wx'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736902, "o", "Wh = jnp.array(seq_data['Wh'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.736952, "o", "b = jnp.array(seq_data['b'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.737002, "o", "\u001b[?2004h> def rnn_step(h, x_t):\r\n\u001b[?2004l\r"]
[36.737052, "o", "\u001b[?2004h> "]
[36.737103, "o", "    h_new = jnp.tanh(jnp.dot(x_t, Wx) + jnp.dot(h, Wh) + b)\r\n\u001b[?2004l\r"]
[36.737155, "o", "\u001b[?2004h> "]
[36.7372, "o", "    return h_new, h_new\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737248, "o", "from jax import lax\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737302, "o", "_, result = lax.scan(rnn_step, init, seq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.73738, "o", "print(f\"RNN output shape: {result.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737472, "o", "np.save('scan_rnn.npy', np.array(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737521, "o", "print(f\"Saved to scan_rnn.npy\")\r\n\u001b[?2004l\r"]
[36.737569, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737647, "o", "# Task 5: jit_mlp - implement and JIT compile a 2-layer MLP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737702, "o", "print(\"\\nTask 5: jit_mlp\")\r\n\u001b[?2004l\r"]
[36.737754, "o", "\u001b[?2004h> "]
[36.737807, "o", "mlp_data = np.load('data/mlp.npz')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737858, "o", "X = jnp.array(mlp_data['X'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737908, "o", "W1 = jnp.array(mlp_data['W1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.737946, "o", "b1 = jnp.array(mlp_data['b1'])\r\n\u001b[?2004l\r"]
[36.738, "o", "\u001b[?2004h> "]
[36.73805, "o", "W2 = jnp.array(mlp_data['W2'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738091, "o", "b2 = jnp.array(mlp_data['b2'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738141, "o", "@jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738183, "o", "def mlp_forward(X, W1, b1, W2, b2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738254, "o", "    h = jnp.tanh(jnp.dot(X, W1) + b1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738321, "o", "    output = jnp.dot(h, W2) + b2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738362, "o", "    return output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738418, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738461, "o", "result = mlp_forward(X, W1, b1, W2, b2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738539, "o", "print(f\"MLP output shape: {result.shape}\")\r\n\u001b[?2004l\r"]
[36.738585, "o", "\u001b[?2004h> "]
[36.738627, "o", "np.save('jit_mlp.npy', np.array(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.73868, "o", "print(f\"Saved to jit_mlp.npy\")\r\n\u001b[?2004l\r"]
[36.738732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738783, "o", "print(\"\\nAll tasks completed!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.738834, "o", "EOF\r\n\u001b[?2004l\r"]
