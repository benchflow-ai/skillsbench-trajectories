[115.319964, "o", "print(f\"Difference: {np.max(np.abs(output1 - ref))}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try with transposed W2\r\n\u001b[?2004l\r\u001b[?2004h> output2 = jnp.tanh(X @ W1 + b1) @ W2.T + b2\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nWith W2.T: {output2[0]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
