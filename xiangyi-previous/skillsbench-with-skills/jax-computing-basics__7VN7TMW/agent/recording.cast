[172.091819, "o", "\r\nbasic_reduce: ✓ PASS\r\n  Description: Given array x, compute mean of each row.\r\n  Output shape: (10,)\r\n"]
[172.092145, "o", "\r\nmap_square: ✓ PASS\r\n  Description: Apply square function to each element using vectorization.\r\n  Output shape: (10, 5)\r\n"]
[172.092432, "o", "\r\ngrad_logistic: ✓ PASS\r\n  Description: Compute gradient of logistic loss.\r\n"]
[172.092524, "o", "  Output shape: (4,)\r\n"]
[172.092692, "o", "\r\nscan_rnn: ✓ PASS\r\n  Description: Implement RNN forward pass using scan.\r\n  Output shape: (15, 3)\r\n"]
[172.092931, "o", "\r\njit_mlp: ✗ FAIL\r\n  Description: Implement and JIT compile a 2-layer MLP.\r\n  Output shape: (8, 2)\r\n"]
[172.093023, "o", "  Max difference: 0.1477133333683014\r\n\r\n==================================================\r\n"]
