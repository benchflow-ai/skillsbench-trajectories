[59.480753, "i", "python3 << 'EOF'\nimport numpy as np\n\n# Examine reference outputs to understand expected values\nprint(\"=== Reference Outputs ===\")\nprint(\"\\ngrad_logistic reference:\")\nref = np.load('reference/grad_logistic.npy')\nprint(f\"Shape: {ref.shape}\")\nprint(f\"Values: {ref}\")\n\nprint(\"\\nscan_rnn reference:\")\nref = np.load('reference/scan_rnn.npy')\nprint(f\"Shape: {ref.shape}\")\nprint(f\"First 3 timesteps:\\n{ref[:3]}\")\n\nprint(\"\\njit_mlp reference:\")\nref = np.load('reference/jit_mlp.npy')\nprint(f\"Shape: {ref.shape}\")\nprint(f\"Values:\\n{ref}\")\n\n# Check logistic data again\nprint(\"\\n=== Logistic Data Review ===\")\nlogistic_data = np.load('data/logistic.npz')\nprint(f\"y values: {logistic_data['y']}\")\nprint(f\"Unique y values: {np.unique(logistic_data['y'])}\")\nEOF\n"]
[59.480979, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
