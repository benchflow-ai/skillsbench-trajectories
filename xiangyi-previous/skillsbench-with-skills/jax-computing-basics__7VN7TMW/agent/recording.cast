[218.622001, "i", "python3 << 'EOF'\nimport numpy as np\nimport json\n\nwith open('problem.json', 'r') as f:\n    problems = json.load(f)\n\nprint(\"Final Verification - All Tasks:\")\nprint(\"=\"*60)\n\nall_pass = True\nfor problem in problems:\n    task_id = problem['id']\n    output = np.load(f'{task_id}.npy')\n    ref = np.load(f'reference/{task_id}.npy')\n    \n    match = np.allclose(output, ref, rtol=1e-5, atol=1e-6)\n    status = \"✓ PASS\" if match else \"✗ FAIL\"\n    \n    if not match:\n        all_pass = False\n    \n    print(f\"{task_id:20s} {status}\")\n\nprint(\"=\"*60)\nif all_pass:\n    print(\"\\n🎉 ALL TASKS PASSED! 🎉\")\nelse:\n    print(\"\\n⚠️  Some tasks failed\")\nEOF\n"]
