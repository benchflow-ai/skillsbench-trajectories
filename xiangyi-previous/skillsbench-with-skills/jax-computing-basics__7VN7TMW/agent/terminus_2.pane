[?2004hroot@9fd20d920808:/app# python3 << 'EOF'
[?2004l[?2004h> import jax
[?2004l[?2004h> import jax.numpy as jnp
[?2004l[?2004h> from jax import grad, jit, vmap
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load problem configuration
[?2004l[?2004h> with open('problem.json', 'r') as f:
[?2004l[?2004h>     problems = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> # Task 1: basic_reduce - compute mean of each row
[?2004l[?2004h> print("Task 1: basic_reduce")
[?2004l[?2004h> x = np.load('data/x.npy')
[?2004l[?2004h> x_jax = jnp.array(x)
[?2004l[?2004h> result = jnp.mean(x_jax, axis=1)
[?2004l[?2004h> print(f"Input shape: {x.shape}, Output shape: {result.shape}")
[?2004l[?2004h> np.save('basic_reduce.npy', np.array(result))
[?2004l[?2004h> print(f"Saved to basic_reduce.npy")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 2: map_square - apply square function using vectorization
[?2004l[?2004h> print("\nTask 2: map_square")
[?2004l[?2004h> x = np.load('data/x.npy')
[?2004l[?2004h> x_jax = jnp.array(x)
[?2004l[?2004h> result = jnp.square(x_jax)
[?2004l[?2004h> print(f"Input shape: {x.shape}, Output shape: {result.shape}")
[?2004l[?2004h> np.save('map_square.npy', np.array(result))
[?2004l[?2004h> print(f"Saved to map_square.npy")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 3: grad_logistic - compute gradient of logistic loss
[?2004l[?2004h> print("\nTask 3: grad_logistic")
[?2004l[?2004h> logistic_data = np.load('data/logistic.npz')
[?2004l[?2004h> x = jnp.array(logistic_data['x'])
[?2004l[?2004h> y = jnp.array(logistic_data['y'])
[?2004l[?2004h> w = jnp.array(logistic_data['w'])
[?2004l[?2004h> 
[?2004l[?2004h> def logistic_loss(w, x, y):
[?2004l[?2004h>     logits = jnp.dot(x, w)
[?2004l[?2004h>     predictions = 1.0 / (1.0 + jnp.exp(-logits))
[?2004l[?2004h>     loss = -jnp.mean(y * jnp.log(predictions + 1e-10) + (1 - y) * jnp.log(1 - predictions + 1e-10))
[?2004l[?2004h>     return loss
[?2004l[?2004h> 
[?2004l[?2004h> grad_loss = grad(logistic_loss)
[?2004l[?2004h> result = grad_loss(w, x, y)
[?2004l[?2004h> print(f"Gradient shape: {result.shape}")
[?2004l[?2004h> np.save('grad_logistic.npy', np.array(result))
[?2004l[?2004h> print(f"Saved to grad_logistic.npy")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 4: scan_rnn - implement RNN forward pass using scan
[?2004l[?2004h> print("\nTask 4: scan_rnn")
[?2004l[?2004h> seq_data = np.load('data/seq.npz')
[?2004l[?2004h> seq = jnp.array(seq_data['seq'])
[?2004l[?2004h> init = jnp.array(seq_data['init'])
[?2004l[?2004h> Wx = jnp.array(seq_data['Wx'])
[?2004l[?2004h> Wh = jnp.array(seq_data['Wh'])
[?2004l[?2004h> b = jnp.array(seq_data['b'])
[?2004l[?2004h> 
[?2004l[?2004h> def rnn_step(h, x_t):
[?2004l[?2004h>     h_new = jnp.tanh(jnp.dot(x_t, Wx) + jnp.dot(h, Wh) + b)
[?2004l[?2004h>     return h_new, h_new
[?2004l[?2004h> 
[?2004l[?2004h> from jax import lax
[?2004l[?2004h> _, result = lax.scan(rnn_step, init, seq)
[?2004l[?2004h> print(f"RNN output shape: {result.shape}")
[?2004l[?2004h> np.save('scan_rnn.npy', np.array(result))
[?2004l[?2004h> print(f"Saved to scan_rnn.npy")
[?2004l[?2004h> 
[?2004l[?2004h> # Task 5: jit_mlp - implement and JIT compile a 2-layer MLP
[?2004l[?2004h> print("\nTask 5: jit_mlp")
[?2004l[?2004h> mlp_data = np.load('data/mlp.npz')
[?2004l[?2004h> X = jnp.array(mlp_data['X'])
[?2004l[?2004h> W1 = jnp.array(mlp_data['W1'])
[?2004l[?2004h> b1 = jnp.array(mlp_data['b1'])
[?2004l[?2004h> W2 = jnp.array(mlp_data['W2'])
[?2004l[?2004h> b2 = jnp.array(mlp_data['b2'])
[?2004l[?2004h> 
[?2004l[?2004h> @jit
[?2004l[?2004h> def mlp_forward(X, W1, b1, W2, b2):
[?2004l[?2004h>     h = jnp.tanh(jnp.dot(X, W1) + b1)
[?2004l[?2004h>     output = jnp.dot(h, W2) + b2
[?2004l[?2004h>     return output
[?2004l[?2004h> 
[?2004l[?2004h> result = mlp_forward(X, W1, b1, W2, b2)
[?2004l[?2004h> print(f"MLP output shape: {result.shape}")
[?2004l[?2004h> np.save('jit_mlp.npy', np.array(result))
[?2004l[?2004h> print(f"Saved to jit_mlp.npy")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAll tasks completed!")
