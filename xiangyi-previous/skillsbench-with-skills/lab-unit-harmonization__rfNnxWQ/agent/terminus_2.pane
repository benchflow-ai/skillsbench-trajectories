[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004lr[?2004h> # Load the data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Initial rows: {len(df)}")
[?2004l[?2004h> print(f"Columns: {len(df.columns)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Function to clean and convert values
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val) or val == '' or str(val).strip() == '':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     val = str(val).strip()
[?2004l[?2004h>     val = val.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(val)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Clean all numeric columns
[?2004l[?2004h> print("Cleaning values...")
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with missing values
[?2004l[?2004h> print("Removing rows with missing values...")
[?2004l[?2004h> df_clean = df.dropna().copy()
[?2004l[?2004h> print(f"Rows after removing missing values: {len(df_clean)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Define conversions with better thresholds
[?2004l[?2004h> # Strategy: if value is outside the ENTIRE possible range for US units, it's in alternative units
[?2004l[?2004h> conversions = {
[?2004l[?2004h>     'Serum_Creatinine': {'factor': 88.4, 'threshold': 25},  # >25 mg/dL is impossible, likely µmol/L
[?2004l[?2004h>     'BUN': {'factor': 0.357, 'threshold': 150},  # >150 mg/dL rare, likely mmol/L  
[?2004l[?2004h>     'Magnesium': {'factor': 0.411, 'threshold': 7},  # >7 mg/dL impossible, likely mmol/L
[?2004l[?2004h>     'Serum_Calcium': {'factor': 0.25, 'threshold': 18},  # >18 mg/dL impossible, likely mmol/L
[?2004l[?2004h>     'Ionized_Calcium': {'factor': 0.25, 'threshold': 8},  # >8 mg/dL impossible, likely mmol/L
[?2004l[?2004h>     'Phosphorus': {'factor': 0.323, 'threshold': 30},  # >30 mg/dL impossible, likely mmol/L
[?2004l[?2004h>     'Vitamin_D_25OH': {'factor': 2.496, 'threshold': 200},  # >200 ng/mL rare, likely nmol/L
[?2004l[?2004h>     'Vitamin_D_1_25OH': {'factor': 2.4, 'threshold': 200},  # >200 pg/mL rare, likely pmol/L
[?2004l[?2004h>     'Hemoglobin': {'factor': 10, 'threshold': 25},  # >25 g/dL impossible, likely g/L
[?2004l[?2004h>     'Total_Bilirubin': {'factor': 17.1, 'threshold': 40},  # >40 mg/dL very rare, likely µmol/L
[?2004l[?2004h>     'Direct_Bilirubin': {'factor': 17.1, 'threshold': 25},  # >25 mg/dL very rare, likely µmol/L
[?2004l[?2004h>     'Albumin_Serum': {'factor': 10, 'threshold': 7},  # >7 g/dL impossible, likely g/L
[?2004l[?2004h>     'Total_Protein': {'factor': 10, 'threshold': 12},  # >12 g/dL impossible, likely g/L
[?2004l[?2004h>     'Prealbumin': {'factor': 10, 'threshold': 60},  # >60 mg/dL impossible, likely mg/L
[?2004l[?2004h>     'CRP': {'factor': 10, 'threshold': 50},  # >50 mg/dL very high, likely mg/L
[?2004l[?2004h>     'Serum_Iron': {'factor': 0.179, 'threshold': 500},  # >500 µg/dL impossible, likely µmol/L
[?2004l[?2004h>     'TIBC': {'factor': 0.179, 'threshold': 700},  # >700 µg/dL impossible, likely µmol/L
[?2004l[?2004h>     'Total_Cholesterol': {'factor': 0.0259, 'threshold': 500},  # >500 mg/dL very rare, likely mmol/L
[?2004l[?2004h>     'LDL_Cholesterol': {'factor': 0.0259, 'threshold': 400},  # >400 mg/dL very rare, likely mmol/L
[?2004l[?2004h>     'HDL_Cholesterol': {'factor': 0.0259, 'threshold': 150},  # >150 mg/dL very rare, likely mmol/L
[?2004l[?2004h>     'Triglycerides': {'factor': 0.0113, 'threshold': 3000},  # >3000 mg/dL very rare, likely mmol/L
[?2004l[?2004h>     'Non_HDL_Cholesterol': {'factor': 0.0259, 'threshold': 500},  # >500 mg/dL very rare, likely mmol/L
[?2004l[?2004h>     'Glucose': {'factor': 0.0555, 'threshold': 1000},  # >1000 mg/dL extreme, likely mmol/L
[?2004l[?2004h>     'Uric_Acid': {'factor': 59.48, 'threshold': 20},  # >20 mg/dL impossible, likely µmol/L
[?2004l[?2004h>     'Troponin_I': {'factor': 1000, 'threshold': 500},  # >500 ng/mL impossible, likely pg/mL
[?2004l[?2004h>     'Troponin_T': {'factor': 1000, 'threshold': 500},  # >500 ng/mL impossible, likely pg/mL
[?2004l[?2004h>     'Free_T4': {'factor': 12.87, 'threshold': 10},  # >10 ng/dL impossible, likely pmol/L
[?2004l[?2004h>     'Free_T3': {'factor': 0.6536, 'threshold': 20},  # >20 pg/mL impossible, likely pmol/L
[?2004l[?2004h>     'Lactate': {'factor': 0.111, 'threshold': 50},  # >50 mg/dL impossible, likely mmol/L
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> print("Applying unit conversions...")
[?2004l[?2004h> for col, params in conversions.items():
[?2004l[?2004h>     if col in df_clean.columns:
[?2004l[?2004h>         mask = df_clean[col] > params['threshold']
[?2004l[?2004h>         if mask.sum() > 0:
[?2004l[?2004h>             df_clean.loc[mask, col] = df_clean.loc[mask, col] / params['factor']
[?2004l[?2004h>             print(f"  {col}: converted {mask.sum()} values from alternative unit")
[?2004l[?2004h> 
[?2004l[?2004h> # Round all numeric columns to 2 decimal places
[?2004l[?2004h> print("Rounding to 2 decimal places...")
[?2004l[?2004h> for col in df_clean.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df_clean.loc[:, col] = df_clean[col].round(2)
[?2004l[?2004h>         df_clean.loc[:, col] = df_clean[col].apply(lambda x: f"{x:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the harmonized data
[?2004l[?2004h> output_path = '/root/ckd_lab_data_harmonized.csv'
[?2004l[?2004h> df_clean.to_csv(output_path, index=False)
[?2004l[?2004h> print(f"\nHarmonized data saved to: {output_path}")
[?2004l[?2004h> print(f"Final rows: {len(df_clean)}")
