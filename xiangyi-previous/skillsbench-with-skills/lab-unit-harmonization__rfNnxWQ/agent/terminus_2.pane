[?2004hroot@78eb3f04de25:~/environment/data# tail -20 ckd_feature_descriptions.csv
[?2004lUric_Acid,Uric Acid,Purine metabolism end product; often elevated in CKD; associated with gout
Urine_Albumin,Urine Albumin,Albumin in urine; early marker of kidney damage
Urine_Creatinine,Urine Creatinine,Used to calculate protein/albumin ratios and assess collection adequacy
Albumin_to_Creatinine_Ratio_Urine,Urine Albumin-to-Creatinine Ratio (UACR),Key marker for CKD staging and progression; spot urine test
Protein_to_Creatinine_Ratio_Urine,Urine Protein-to-Creatinine Ratio (UPCR),Estimates 24-hour proteinuria from spot sample
Urine_Protein,Urine Protein (Total),Total protein in urine including albumin and other proteins
Urine_pH,Urine pH,Acidity of urine; relevant for stone risk and acid-base status
Urine_Specific_Gravity,Urine Specific Gravity,Concentration of urine; reflects hydration and concentrating ability
BNP,B-type Natriuretic Peptide,Cardiac hormone; elevated in heart failure and volume overload (higher baseline in CKD)
NT_proBNP,N-terminal pro-BNP,Inactive BNP fragment; more stable than BNP; elevated in CKD
Troponin_I,Troponin I,Cardiac muscle protein; marker of myocardial injury (may be elevated in CKD)
Troponin_T,Troponin T,Cardiac muscle protein; marker of myocardial injury (often elevated in ESRD)
Free_T4,Free Thyroxine (T4),Unbound active thyroid hormone
Free_T3,Free Triiodothyronine (T3),Most active thyroid hormone; may be low in sick euthyroid syndrome
pH_Arterial,Arterial Blood pH,Blood acidity; often low in CKD due to metabolic acidosis
pCO2_Arterial,Arterial pCO2,Partial pressure of carbon dioxide; respiratory component of acid-base
pO2_Arterial,Arterial pO2,Partial pressure of oxygen; oxygenation status
Lactate,Lactate,Anaerobic metabolism marker; elevated in hypoperfusion/sepsis
Beta2_Microglobulin,Beta-2 Microglobulin,Middle molecule; accumulates in dialysis; associated with amyloidosis
Aluminum,Aluminum,Toxic metal; can accumulate in dialysis patients; causes bone disease
[?2004hroot@78eb3f04de25:~/environment/data# cd /root
[?2004l[?2004hroot@78eb3f04de25:~# cat > harmonize_lab_data.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> # Load the data
[?2004l[?2004h> print("Loading data...")
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Initial rows: {len(df)}")
[?2004l[?2004h> print(f"Columns: {len(df.columns)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Function to clean and convert values
[?2004l[?2004h> def clean_value(val):
[?2004l[?2004h>     if pd.isna(val) or val == '' or val.strip() == '':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     # Convert to string and strip whitespace
[?2004l[?2004h>     val = str(val).strip()
[?2004l[?2004h>     # Replace comma with period for decimal separator
[?2004l[?2004h>     val = val.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(val)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Clean all numeric columns (all except patient_id)
[?2004l[?2004h> print("Cleaning values...")
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with any missing values
[?2004l[?2004h> print("Removing rows with missing values...")
[?2004l[?2004h> df_clean = df.dropna()
[?2004l[?2004h> print(f"Rows after removing missing values: {len(df_clean)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Define physiological ranges and conversion factors for US conventional units
[?2004l[?2004h> # Format: {column: (normal_min, normal_max, alt_unit_factor, alt_unit_threshold)}
[?2004l[?2004h> # alt_unit_threshold: if value > this, likely using alternative unit
[?2004l[?2004h> 
[?2004l[?2004h> conversions = {
[?2004l[?2004h>     # Serum_Creatinine: mg/dL (0.5-1.5), alternative µmol/L (divide by 88.4)
[?2004l[?2004h>     'Serum_Creatinine': {'min': 0.5, 'max': 15.0, 'alt_factor': 88.4, 'alt_threshold': 20},
[?2004l[?2004h>     
[?2004l[?2004h>     # BUN: mg/dL (7-25), alternative mmol/L (divide by 0.357)
[?2004l[?2004h>     'BUN': {'min': 5, 'max': 200, 'alt_factor': 0.357, 'alt_threshold': 100},
[?2004l[?2004h>     
[?2004l[?2004h>     # Cystatin_C: mg/L (0.5-1.5)
[?2004l[?2004h>     'Cystatin_C': {'min': 0.4, 'max': 10.0, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Sodium: mEq/L (135-145), alternative mmol/L (same)
[?2004l[?2004h>     'Sodium': {'min': 120, 'max': 160, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Potassium: mEq/L (3.5-5.5), alternative mmol/L (same)
[?2004l[?2004h>     'Potassium': {'min': 2.5, 'max': 8.0, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Chloride: mEq/L (95-110)
[?2004l[?2004h>     'Chloride': {'min': 80, 'max': 120, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004lp[?2004h>     # Bicarbonate: mEq/L (22-30)
[?2004l[?2004h>     'Bicarbonate': {'min': 10, 'max': 40, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Magnesium: mg/dL (1.5-2.5), alternative mmol/L (divide by 0.411)
[?2004l[?2004h>     'Magnesium': {'min': 1.0, 'max': 5.0, 'alt_factor': 0.411, 'alt_threshold': 6},
[?2004l[?2004h>     
[?2004l[?2004h>     # Serum_Calcium: mg/dL (8.5-10.5), alternative mmol/L (divide by 0.25)
[?2004l[?2004h>     'Serum_Calcium': {'min': 6.0, 'max': 15.0, 'alt_factor': 0.25, 'alt_threshold': 20},
[?2004l[?2004h>     
[?2004l[?2004h>     # Ionized_Calcium: mg/dL (4.5-5.5), alternative mmol/L (divide by 0.25)
[?2004l[?2004h>     'Ionized_Calcium': {'min': 3.0, 'max': 7.0, 'alt_factor': 0.25, 'alt_threshold': 10},
[?2004l[?2004h>     
[?2004l[?2004h>     # Phosphorus: mg/dL (2.5-4.5), alternative mmol/L (divide by 0.323)
[?2004l[?2004h>     'Phosphorus': {'min': 1.5, 'max': 20.0, 'alt_factor': 0.323, 'alt_threshold': 25},
[?2004l[?2004h>     
[?2004l[?2004h>     # Hemoglobin: g/dL (12-18), alternative g/L (divide by 10)
[?2004l[?2004h>     'Hemoglobin': {'min': 5, 'max': 20, 'alt_factor': 10, 'alt_threshold': 50},
[?2004l[?2004h>     
[?2004l[?2004h>     # Hematocrit: % (36-54)
[?2004l[?2004h>     'Hematocrit': {'min': 15, 'max': 65, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # RBC_Count: million/µL (4-6)
[?2004l[?2004h>     'RBC_Count': {'min': 2.0, 'max': 8.0, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # WBC_Count: thousand/µL (4-11)
[?2004l[?2004h>     'WBC_Count': {'min': 1.0, 'max': 50.0, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Platelet_Count: thousand/µL (150-450)
[?2004l[?2004h>     'Platelet_Count': {'min': 50, 'max': 800, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Serum_Iron: µg/dL (50-170), alternative µmol/L (divide by 0.179)
[?2004l[?2004h>     'Serum_Iron': {'min': 20, 'max': 400, 'alt_factor': 0.179, 'alt_threshold': 500},
[?2004l[?2004h>     
[?2004l[?2004h>     # TIBC: µg/dL (250-450), alternative µmol/L (divide by 0.179)
[?2004l[?2004h>     'TIBC': {'min': 200, 'max': 600, 'alt_factor': 0.179, 'alt_threshold': 800},
[?2004l[?2004h>     
[?2004l[?2004h>     # Transferrin_Saturation: % (20-50)
[?2004l[?2004h>     'Transferrin_Saturation': {'min': 5, 'max': 100, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Ferritin: ng/mL (20-300), alternative µg/L (same)
[?2004l[?2004h>     'Ferritin': {'min': 5, 'max': 10000, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Total_Bilirubin: mg/dL (0.1-1.2), alternative µmol/L (divide by 17.1)
[?2004l[?2004h>     'Total_Bilirubin': {'min': 0.05, 'max': 500, 'alt_factor': 17.1, 'alt_threshold': 50},
[?2004l[?2004h>     
[?2004l[?2004h>     # Direct_Bilirubin: mg/dL (0-0.3), alternative µmol/L (divide by 17.1)
[?2004l[?2004h>     'Direct_Bilirubin': {'min': 0.0, 'max': 200, 'alt_factor': 17.1, 'alt_threshold': 30},
[?2004l[?2004h>     
[?2004l[?2004h>     # Albumin_Serum: g/dL (3.5-5.5), alternative g/L (divide by 10)
[?2004l[?2004h>     'Albumin_Serum': {'min': 1.5, 'max': 6.5, 'alt_factor': 10, 'alt_threshold': 10},
[?2004l[?2004h>     
[?2004l[?2004h>     # Total_Protein: g/dL (6-8.5), alternative g/L (divide by 10)
[?2004l[?2004h>     'Total_Protein': {'min': 4.0, 'max': 10.0, 'alt_factor': 10, 'alt_threshold': 15},
[?2004l[?2004h>     
[?2004l[?2004h>     # Prealbumin: mg/dL (15-40), alternative mg/L (divide by 10)
[?2004l[?2004h>     'Prealbumin': {'min': 5, 'max': 50, 'alt_factor': 10, 'alt_threshold': 100},
[?2004l[?2004h>     
[?2004l[?2004h>     # CRP: mg/dL (0-1), alternative mg/L (divide by 10)
[?2004l[?2004h>     'CRP': {'min': 0.0, 'max': 50.0, 'alt_factor': 10, 'alt_threshold': 100},
[?2004l[?2004h>     
[?2004l[?2004h>     # Cholesterol: mg/dL (120-240), alternative mmol/L (divide by 0.0259)
[?2004l[?2004h>     'Total_Cholesterol': {'min': 80, 'max': 400, 'alt_factor': 0.0259, 'alt_threshold': 15},
[?2004l[?2004h>     'LDL_Cholesterol': {'min': 40, 'max': 300, 'alt_factor': 0.0259, 'alt_threshold': 10},
[?2004l[?2004h>     'HDL_Cholesterol': {'min': 20, 'max': 100, 'alt_factor': 0.0259, 'alt_threshold': 5},
[?2004l[?2004h>     'Non_HDL_Cholesterol': {'min': 50, 'max': 350, 'alt_factor': 0.0259, 'alt_threshold': 15},
[?2004l[?2004h>     
[?2004l[?2004h>     # Triglycerides: mg/dL (50-200), alternative mmol/L (divide by 0.0113)
[?2004l[?2004h>     'Triglycerides': {'min': 30, 'max': 2000, 'alt_factor': 0.0113, 'alt_threshold': 25},
[?2004l[?2004h>     
[?2004l[?2004h>     # Glucose: mg/dL (70-125), alternative mmol/L (divide by 0.0555)
[?2004l[?2004h>     'Glucose': {'min': 40, 'max': 1000, 'alt_factor': 0.0555, 'alt_threshold': 30},
[?2004l[?2004h>     
[?2004l[?2004h>     # HbA1c: % (4-6.5)
[?2004l[?2004h>     'HbA1c': {'min': 3.5, 'max': 20.0, 'alt_factor': None, 'alt_threshold': None},
[?2004l[?2004h>     
[?2004l[?2004h>     # Uric_Acid: mg/dL (3-7), alternative µmol/L (divide by 59.48)
[?2004l[?2004h>     'Uric_Acid': {'min': 1.5, 'max': 15.0, 'alt_factor': 59.48, 'alt_threshold': 100},
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> print("Applying unit conversions...")
[?2004l[?2004h> # Apply conversions
[?2004l[?2004h> for col, params in conversions.items():
[?2004l[?2004h>     if col in df_clean.columns:
[?2004l[?2004h>         if params['alt_factor'] and params['alt_threshold']:
[?2004l[?2004h>             # Identify values likely in alternative units
[?2004l[?2004h>             mask = df_clean[col] > params['alt_threshold']
[?2004l[?2004h>             # Convert those values
[?2004l[?2004h>             df_clean.loc[mask, col] = df_clean.loc[mask, col] / params['alt_factor']
[?2004l[?2004h>             if mask.sum() > 0:
[?2004l[?2004h>                 print(f"  {col}: converted {mask.sum()} values from alternative unit")
[?2004l[?2004h> 
[?2004l[?2004h> # Round all numeric columns to 2 decimal places
[?2004l[?2004h> print("Rounding to 2 decimal places...")
[?2004l[?2004h> for col in df_clean.columns:
