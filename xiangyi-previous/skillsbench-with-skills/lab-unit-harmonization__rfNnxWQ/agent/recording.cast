[121.755681, "o", "\u001b[?2004h> "]
[121.755733, "o", "        return float(val)\r\n\u001b[?2004l\r\u001b[?2004h>     except:\r\n\u001b[?2004l\r"]
[121.755784, "o", "\u001b[?2004h> "]
[121.755844, "o", "        return np.nan\r\n\u001b[?2004l\r"]
[121.7559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[121.756022, "o", "# Clean all numeric columns (all except patient_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
