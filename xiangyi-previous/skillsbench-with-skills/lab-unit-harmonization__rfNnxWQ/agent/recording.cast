[121.76921, "o", "    # Other\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769345, "o", "    'Beta2_Microglobulin': {'alt_factor': None, 'alt_threshold': None},  # mg/L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769467, "o", "    'Aluminum': {'alt_factor': None, 'alt_threshold': None},  # µg/L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769501, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.769529, "o", "\u001b[?2004h> "]
[121.769591, "o", "print(\"Applying unit conversions...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.769623, "o", "> "]
[121.769653, "o", "# Apply conversions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769732, "o", "for col, params in conversions.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769793, "o", "    if col in df_clean.columns:\r\n\u001b[?2004l\r"]
[121.769823, "o", "\u001b[?2004h> "]
[121.769907, "o", "        if params['alt_factor'] and params['alt_threshold']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.769943, "o", "> "]
[121.770008, "o", "            # Identify values likely in alternative units\r\n\u001b[?2004l\r"]
[121.770042, "o", "\u001b[?2004h> "]
[121.770116, "o", "            mask = df_clean[col] > params['alt_threshold']\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.770149, "o", "> "]
[121.770182, "o", "            # Convert those values\r\n\u001b[?2004l\r"]
[121.77021, "o", "\u001b[?2004h> "]
[121.770352, "o", "            df_clean.loc[mask, col] = df_clean.loc[mask, col] / params['alt_factor']\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.770392, "o", "> "]
[121.770425, "o", "            if mask.sum() > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.770572, "o", "                print(f\"  {col}: converted {mask.sum()} values from alternative unit\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.77061, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.770678, "o", "# Round all numeric columns to 2 decimal places\r\n\u001b[?2004l\r"]
[121.770712, "o", "\u001b[?2004h> "]
[121.770757, "o", "print(\"Rounding to 2 decimal places...\")\r\n\u001b[?2004l\r"]
[121.770791, "o", "\u001b[?2004h> "]
[121.770823, "o", "for col in df_clean.columns:\r\n\u001b[?2004l\r"]
[121.770855, "o", "\u001b[?2004h> "]
[121.770887, "o", "    if col != 'patient_id':\r\n\u001b[?2004l\r"]
[121.770924, "o", "\u001b[?2004h> "]
[121.770981, "o", "        df_clean[col] = df_clean[col].round(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.771017, "o", "> "]
[121.771064, "o", "        # Format to ensure 2 decimal places\r\n\u001b[?2004l\r"]
[121.771095, "o", "\u001b[?2004h> "]
[121.771181, "o", "        df_clean[col] = df_clean[col].apply(lambda x: f\"{x:.2f}\")\r\n\u001b[?2004l\r"]
[121.771215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.771264, "o", "# Save the harmonized data\r\n\u001b[?2004l\r"]
[121.7713, "o", "\u001b[?2004h> "]
[121.771358, "o", "output_path = '/root/ckd_lab_data_harmonized.csv'\r\n\u001b[?2004l\r"]
[121.771392, "o", "\u001b[?2004h> "]
[121.771441, "o", "df_clean.to_csv(output_path, index=False)\r\n\u001b[?2004l\r"]
[121.771474, "o", "\u001b[?2004h> "]
[121.771538, "o", "print(f\"\\nHarmonized data saved to: {output_path}\")\r\n\u001b[?2004l\r"]
[121.771573, "o", "\u001b[?2004h> "]
[121.77162, "o", "print(f\"Final rows: {len(df_clean)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
