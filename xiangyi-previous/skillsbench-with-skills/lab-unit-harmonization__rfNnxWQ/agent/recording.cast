[209.921036, "i", "cat > harmonize_lab_data.py << 'ENDOFSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\nprint(\"Loading data...\")\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\nprint(f\"Initial rows: {len(df)}\")\nprint(f\"Columns: {len(df.columns)}\")\n\n# Function to clean and convert values\ndef clean_value(val):\n    if pd.isna(val) or val == '' or str(val).strip() == '':\n        return np.nan\n    val = str(val).strip()\n    val = val.replace(',', '.')\n    try:\n        return float(val)\n    except:\n        return np.nan\n\n# Clean all numeric columns\nprint(\"Cleaning values...\")\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\n\n# Remove rows with missing values\nprint(\"Removing rows with missing values...\")\ndf_clean = df.dropna().copy()\nprint(f\"Rows after removing missing values: {len(df_clean)}\")\n\n# Define conversions with better thresholds\n# Strategy: if value is outside the ENTIRE possible range for US units, it's in alternative units\nconversions = "]
[209.921079, "i", "{\n    'Serum_Creatinine': {'factor': 88.4, 'threshold': 25},  # >25 mg/dL is impossible, likely µmol/L\n    'BUN': {'factor': 0.357, 'threshold': 150},  # >150 mg/dL rare, likely mmol/L  \n    'Magnesium': {'factor': 0.411, 'threshold': 7},  # >7 mg/dL impossible, likely mmol/L\n    'Serum_Calcium': {'factor': 0.25, 'threshold': 18},  # >18 mg/dL impossible, likely mmol/L\n    'Ionized_Calcium': {'factor': 0.25, 'threshold': 8},  # >8 mg/dL impossible, likely mmol/L\n    'Phosphorus': {'factor': 0.323, 'threshold': 30},  # >30 mg/dL impossible, likely mmol/L\n    'Vitamin_D_25OH': {'factor': 2.496, 'threshold': 200},  # >200 ng/mL rare, likely nmol/L\n    'Vitamin_D_1_25OH': {'factor': 2.4, 'threshold': 200},  # >200 pg/mL rare, likely pmol/L\n    'Hemoglobin': {'factor': 10, 'threshold': 25},  # >25 g/dL impossible, likely g/L\n    'Total_Bilirubin': {'factor': 17.1, 'threshold': 40},  # >40 mg/dL very rare, likely µmol/L\n    'Direct_Bilirubin': {'factor': 17.1, 'threshold': 25},  # >25 mg/dL very rare, likely µmo"]
[209.921095, "i", "l/L\n    'Albumin_Serum': {'factor': 10, 'threshold': 7},  # >7 g/dL impossible, likely g/L\n    'Total_Protein': {'factor': 10, 'threshold': 12},  # >12 g/dL impossible, likely g/L\n    'Prealbumin': {'factor': 10, 'threshold': 60},  # >60 mg/dL impossible, likely mg/L\n    'CRP': {'factor': 10, 'threshold': 50},  # >50 mg/dL very high, likely mg/L\n    'Serum_Iron': {'factor': 0.179, 'threshold': 500},  # >500 µg/dL impossible, likely µmol/L\n    'TIBC': {'factor': 0.179, 'threshold': 700},  # >700 µg/dL impossible, likely µmol/L\n    'Total_Cholesterol': {'factor': 0.0259, 'threshold': 500},  # >500 mg/dL very rare, likely mmol/L\n    'LDL_Cholesterol': {'factor': 0.0259, 'threshold': 400},  # >400 mg/dL very rare, likely mmol/L\n    'HDL_Cholesterol': {'factor': 0.0259, 'threshold': 150},  # >150 mg/dL very rare, likely mmol/L\n    'Triglycerides': {'factor': 0.0113, 'threshold': 3000},  # >3000 mg/dL very rare, likely mmol/L\n    'Non_HDL_Cholesterol': {'factor': 0.0259, 'threshold': 500},  # >500 mg/dL very ra"]
[209.921101, "i", "re, likely mmol/L\n    'Glucose': {'factor': 0.0555, 'threshold': 1000},  # >1000 mg/dL extreme, likely mmol/L\n    'Uric_Acid': {'factor': 59.48, 'threshold': 20},  # >20 mg/dL impossible, likely µmol/L\n    'Troponin_I': {'factor': 1000, 'threshold': 500},  # >500 ng/mL impossible, likely pg/mL\n    'Troponin_T': {'factor': 1000, 'threshold': 500},  # >500 ng/mL impossible, likely pg/mL\n    'Free_T4': {'factor': 12.87, 'threshold': 10},  # >10 ng/dL impossible, likely pmol/L\n    'Free_T3': {'factor': 0.6536, 'threshold': 20},  # >20 pg/mL impossible, likely pmol/L\n    'Lactate': {'factor': 0.111, 'threshold': 50},  # >50 mg/dL impossible, likely mmol/L\n}\n\nprint(\"Applying unit conversions...\")\nfor col, params in conversions.items():\n    if col in df_clean.columns:\n        mask = df_clean[col] > params['threshold']\n        if mask.sum() > 0:\n            df_clean.loc[mask, col] = df_clean.loc[mask, col] / params['factor']\n            print(f\"  {col}: converted {mask.sum()} values from alternative unit\")\n\n# Round "]
[209.921107, "i", "all numeric columns to 2 decimal places\nprint(\"Rounding to 2 decimal places...\")\nfor col in df_clean.columns:\n    if col != 'patient_id':\n        df_clean.loc[:, col] = df_clean[col].round(2)\n        df_clean.loc[:, col] = df_clean[col].apply(lambda x: f\"{x:.2f}\")\n\n# Save the harmonized data\noutput_path = '/root/ckd_lab_data_harmonized.csv'\ndf_clean.to_csv(output_path, index=False)\nprint(f\"\\nHarmonized data saved to: {output_path}\")\nprint(f\"Final rows: {len(df_clean)}\")\nprint(f\"Final columns: {len(df_clean.columns)}\")\n\nENDOFSCRIPT\n"]
