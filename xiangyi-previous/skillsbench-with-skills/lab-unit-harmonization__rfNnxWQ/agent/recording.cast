[121.768885, "o", "    'pCO2_Arterial': {'alt_factor': None, 'alt_threshold': None},  # mmHg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769011, "o", "    'pO2_Arterial': {'alt_factor': None, 'alt_threshold': None},  # mmHg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.769144, "o", "    'Lactate': {'alt_factor': 0.111, 'alt_threshold': 20},  # mmol/L to mg/dL\r\n\u001b[?2004l\r\u001b[?2004h> "]
