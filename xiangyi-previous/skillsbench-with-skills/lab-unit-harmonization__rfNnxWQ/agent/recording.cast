[121.756139, "o", "> "]
[121.756177, "o", "for col in df.columns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.756215, "o", "> "]
[121.756274, "o", "    if col != 'patient_id':\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.756324, "o", "> "]
[121.756418, "o", "        df[col] = df[col].apply(clean_value)\r\n\u001b[?2004l\r"]
[121.756452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[121.75649, "o", "\u001b[?2004h> "]
[121.756558, "o", "# Remove rows with any missing values\r\n\u001b[?2004l\r"]
[121.756593, "o", "\u001b[?2004h> "]
[121.756722, "o", "print(\"Removing rows with missing values...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.756759, "o", "> "]
[121.756804, "o", "df_clean = df.dropna()\r\n\u001b[?2004l\r\u001b[?2004h"]
