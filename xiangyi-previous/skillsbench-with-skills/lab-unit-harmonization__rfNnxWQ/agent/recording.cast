[303.814138, "i", "python3 << 'EOF'\nimport pandas as pd\nimport re\n\nprint(\"=\" * 60)\nprint(\"FINAL VALIDATION OF HARMONIZED DATA\")\nprint(\"=\" * 60)\n\n# Load the data\ndf = pd.read_csv('/root/ckd_lab_data_harmonized.csv')\n\nprint(f\"\\n1. File location: /root/ckd_lab_data_harmonized.csv\")\nprint(f\"2. Total rows (including header): {len(df) + 1}\")\nprint(f\"3. Data rows: {len(df)}\")\nprint(f\"4. Total columns: {len(df.columns)}\")\n\n# Check column names\nprint(f\"\\n5. First few columns: {', '.join(df.columns[:5])}\")\nprint(f\"   Last few columns: {', '.join(df.columns[-5:])}\")\n\n# Read raw file to check formatting\nwith open('/root/ckd_lab_data_harmonized.csv') as f:\n    content = f.read()\n    \n# Check for scientific notation\nsci_notation = re.findall(r'\\d+\\.\\d+e[+-]?\\d+', content, re.IGNORECASE)\nprint(f\"\\n6. Scientific notation found: {len(sci_notation)}\")\n\n# Check a sample of values for proper formatting\nprint(\"\\n7. Sample values from different rows:\")\nfor idx in [0, 100, 500, 1000, 2000, 2547]:\n    if idx < len(df):\n        row = df.iloc[idx]\n     "]
