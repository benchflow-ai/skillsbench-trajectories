[121.753223, "i", "cat > harmonize_lab_data.py << 'ENDOFSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\nprint(\"Loading data...\")\ndf = pd.read_csv('/root/environment/data/ckd_lab_data.csv', dtype=str)\n\nprint(f\"Initial rows: {len(df)}\")\nprint(f\"Columns: {len(df.columns)}\")\n\n# Function to clean and convert values\ndef clean_value(val):\n    if pd.isna(val) or val == '' or str(val).strip() == '':\n        return np.nan\n    # Convert to string and strip whitespace\n    val = str(val).strip()\n    # Replace comma with period for decimal separator\n    val = val.replace(',', '.')\n    try:\n        return float(val)\n    except:\n        return np.nan\n\n# Clean all numeric columns (all except patient_id)\nprint(\"Cleaning values...\")\nfor col in df.columns:\n    if col != 'patient_id':\n        df[col] = df[col].apply(clean_value)\n\n# Remove rows with any missing values\nprint(\"Removing rows with missing values...\")\ndf_clean = df.dropna()\nprint(f\"Rows after removing missing values: {len(df_clean)}\")\n\n# Define physiological ranges and co"]
[121.753263, "i", "nversion factors for US conventional units\nconversions = {\n    # Kidney function markers\n    'Serum_Creatinine': {'alt_factor': 88.4, 'alt_threshold': 20},  # µmol/L to mg/dL\n    'BUN': {'alt_factor': 0.357, 'alt_threshold': 100},  # mmol/L to mg/dL\n    'eGFR': {'alt_factor': None, 'alt_threshold': None},  # mL/min/1.73m2\n    'Cystatin_C': {'alt_factor': None, 'alt_threshold': None},  # mg/L\n    'BUN_Creatinine_Ratio': {'alt_factor': None, 'alt_threshold': None},\n    \n    # Electrolytes\n    'Sodium': {'alt_factor': None, 'alt_threshold': None},  # mEq/L\n    'Potassium': {'alt_factor': None, 'alt_threshold': None},  # mEq/L\n    'Chloride': {'alt_factor': None, 'alt_threshold': None},  # mEq/L\n    'Bicarbonate': {'alt_factor': None, 'alt_threshold': None},  # mEq/L\n    'Anion_Gap': {'alt_factor': None, 'alt_threshold': None},  # mEq/L\n    'Magnesium': {'alt_factor': 0.411, 'alt_threshold': 6},  # mmol/L to mg/dL\n    \n    # Mineral metabolism\n    'Serum_Calcium': {'alt_factor': 0.25, 'alt_threshold': 20},  # mm"]
