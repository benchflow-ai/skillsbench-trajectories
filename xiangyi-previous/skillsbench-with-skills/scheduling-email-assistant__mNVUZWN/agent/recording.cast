[792.616342, "i", "cd /root/.agents/skills/gmail-skill && node send_emails_direct.mjs 2>&1\n"]
[792.616778, "o", "cd /root/.agents/skills/gmail-skill && node send_emails_direct.mjs 2>&1\r\n\u001b[?2004l\r"]
