[794.248082, "o", "Result: {\r\n  success: \u001b[33mtrue\u001b[39m,\r\n  messageId: \u001b[32m'msg_1769457365409_1'\u001b[39m,\r\n  threadId: \u001b[32m'thread_1'\u001b[39m,\r\n  to: \u001b[32m'amanda.lee@example.hr-solutions.com'\u001b[39m\r\n}\r\n"]
