[785.929431, "o", ">   \r\n\u001b[?2004l\r"]
[785.929454, "o", "\u001b[?2004h"]
[785.929477, "o", "> "]
[785.929581, "o", "  const result = await gmail.users.messages.send({\r\n\u001b[?2004l\r"]
[785.929609, "o", "\u001b[?2004h> "]
[785.929655, "o", "    userId: 'me',\r\n\u001b[?2004l\r"]
[785.929683, "o", "\u001b[?2004h> "]
[785.929742, "o", "    requestBody: {\r\n\u001b[?2004l\r"]
[785.929771, "o", "\u001b[?2004h> "]
[785.929828, "o", "      raw: encodedMessage\r\n\u001b[?2004l\r"]
[785.929853, "o", "\u001b[?2004h> "]
[785.929877, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[785.929906, "o", ">   });"]
[785.929932, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
