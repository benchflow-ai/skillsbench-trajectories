[794.25739, "o", "Result: {\r\n  success: \u001b[33mtrue\u001b[39m,\r\n  messageId: \u001b[32m'msg_1769457365428_2'\u001b[39m,\r\n  threadId: \u001b[32m'thread_2'\u001b[39m,\r\n  to: \u001b[32m'john.smith@example.com'\u001b[39m\r\n}\r\nSending email to rwilson@example.consulting.net...\r\n"]
[794.261349, "o", "Mock API: Creating message msg_1769457365436_3\r\n"]
