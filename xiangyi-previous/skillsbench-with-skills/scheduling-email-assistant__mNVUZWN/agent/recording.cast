[785.930159, "o", "\u001b[?2004h>     success: true,\r\n\u001b[?2004l\r\u001b[?2004h>     messageId: result.data.id,\r\n\u001b[?2004l\r"]
[785.930186, "o", "\u001b[?2004h> "]
[785.930302, "o", "    threadId: result.data.threadId,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.931204, "o", "    to: meeting.from_email\r\n\u001b[?2004l\r"]
[785.9313, "o", "\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async function main() {\r\n\u001b[?2004l\r\u001b[?2004h>   const sentResults = [];\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   for (const meeting of meetings) {\r\n\u001b[?2004l\r\u001b[?2004h>     try {\r\n\u001b[?2004l\r\u001b[?2004h>       console.log(`Sending email to ${meeting.from_email}...`);\r\n\u001b[?2004l\r\u001b[?2004h>       const result = await sendEmail(meeting);\r\n\u001b[?2004l\r\u001b[?2004h>       console.log(`Result:`, result);\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h>       if (result.success && result.messageId) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.931391, "o", "        sentResults.push({ messageId: result.messageId });\r\n\u001b[?2004l\r\u001b[?2004h"]
[785.931423, "o", ">       } else {\r\n"]
[785.931448, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[785.931592, "o", "        sentResults.push({ messageId: `failed_${meeting.from_email}` });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.931645, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.931688, "o", "    } catch (e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.932003, "o", "      console.error(`Error sending to ${meeting.from_email}:`, e.message);\r\n\u001b[?2004l\r\u001b[?2004h>       sentResults.push({ messageId: `error_${meeting.from_email}` });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[785.932073, "o", "\u001b[?2004h> "]
[785.932117, "o", "  const results = { sent_results: sentResults };\r\n\u001b[?2004l\r\u001b[?2004h"]
[785.932155, "o", "> "]
[785.932225, "o", "  writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r"]
[785.932263, "o", "\u001b[?2004h> "]
[785.932473, "o", "  console.log('\\nResults saved to /root/results.json');\r\n\u001b[?2004l\r\u001b[?2004h>   console.log(JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[785.932522, "o", "\u001b[?2004l\r\u001b[?2004h> "]
