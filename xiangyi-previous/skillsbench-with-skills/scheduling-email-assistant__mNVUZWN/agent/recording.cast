l-skill/scripts/gmail-send.js',\r\n\u001b[?2004l\r\u001b[?2004h>       '--to', meeting.from_email,\r\n\u001b[?2004l\r\u001b[?2004h>       '--subject', 'Re: Meeting Request',\r\n\u001b[?2004l\r\u001b[?2004h>       '--body', body\r\n\u001b[?2004l\r\u001b[?2004h>     ]);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     let stdout = '';\r\n\u001b[?2004l\r\u001b[?2004h>     let stderr = '';\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     child.stdout.on('data', (data) => { stdout += data; });\r\n\u001b[?2004l\r\u001b[?2004h>     child.stderr.on('data', (data) => { stderr += data; });\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     child.on('close', (code) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const output = stdout || stderr;\r\n\u001b[?2004l\r\u001b[?2004h>       try {\r\n\u001b[?2004l\r\u001b[?2004h>         const result = JSON.parse(output);\r\n\u001b[?2004l\r\u001b[?2004h>         resolve(result);\r\n\u001b[?2004l\r\u001b[?2004h>       } catch (e) {\r\n\u001b[?2004l\r\u001b[?2004h>         reject(new Error(`Failed to parse output: ${output}`));\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async function main() {\r\n\u001b[?2004l\r\u001b[?2004h>   const sentResults = [];\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   for (const meeting of meetings) {\r\n\u001b[?2004l\r\u001b[?2004h>     try {\r\n\u001b[?2004l\r\u001b[?2004h>       console.log(`Sending email to ${meeting.from_email}...`);\r\n\u001b[?2004l\r\u001b[?2004h>       const result = await sendEmail(meeting);\r\n\u001b[?2004l\r\u001b[?2004h>       console.log(`Result:`, result);\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h>       if (result.success && result.messageId) {\r\n\u001b[?2004l\r\u001b[?2004h>         sentResults.push({ messageId: result.messageId });\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h>         sentResults.push({ messageId: `failed_${meeting.from_email}` });\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     } catch (e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
