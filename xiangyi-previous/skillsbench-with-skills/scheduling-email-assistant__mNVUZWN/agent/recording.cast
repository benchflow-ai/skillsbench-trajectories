[483.954567, "o", "        'node', '/root/.agents/skills/gmail-skill/scripts/gmail-send.js',\r\n\u001b[?2004l\r"]
[483.954601, "o", "\u001b[?2004h> "]
[483.954675, "o", "        '--to', meeting['from_email'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.954744, "o", "        '--subject', 'Re: Meeting Request',\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.95478, "o", "> "]
[483.954808, "o", "        '--body', body\r\n\u001b[?2004l\r\u001b[?2004h>     ]"]
[483.95484, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.954877, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     try:"]
[483.954908, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.955048, "o", "        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)\r\n\u001b[?2004l\r"]
[483.955081, "o", "\u001b[?2004h> "]
[483.955159, "o", "        # Try stdout first, then stderr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.955303, "o", "        output_text = result.stdout.strip() if result.stdout.strip() else result.stderr.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.955425, "o", "        print(f\"Output for {meeting['from_email']}: {output_text}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.955458, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[483.955488, "o", "> "]
[483.955518, "o", "        if output_text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.955548, "o", "> "]
[483.95566, "o", "            output = json.loads(output_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.955692, "o", "            if output.get('success'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.955814, "o", "                sent_results.append({'messageId': output['messageId']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.955846, "o", "> "]
[483.955945, "o", "                print(f\"Successfully sent to {meeting['from_email']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.955978, "o", "> "]
[483.956006, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.956142, "o", "                print(f\"API failed for {meeting['from_email']}: {output.get('error')}\")\r\n\u001b[?2004l\r"]
[483.956172, "o", "\u001b[?2004h> "]
[483.956284, "o", "                # The API failed, but we still need to record something\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.956315, "o", "> "]
[483.956508, "o", "                sent_results.append({'messageId': f\"failed_{meeting['from_email'].replace('@', '_at_').replace('.', '_')}\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.95654, "o", "        else:\r\n\u001b[?2004l\r"]
[483.956567, "o", "\u001b[?2004h> "]
[483.956654, "o", "            print(f\"No output for {meeting['from_email']}\")\r\n\u001b[?2004l\r"]
[483.956685, "o", "\u001b[?2004h> "]
[483.956869, "o", "            sent_results.append({'messageId': f\"no_output_{meeting['from_email'].replace('@', '_at_').replace('.', '_')}\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.956902, "o", "> "]
[483.956929, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.95696, "o", "> "]
[483.957062, "o", "        print(f\"Error sending to {meeting['from_email']}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.95724, "o", "        sent_results.append({'messageId': f\"error_{meeting['from_email'].replace('@', '_at_').replace('.', '_')}\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.95727, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.957297, "o", "# Save results\r\n\u001b[?2004l\r"]
[483.957327, "o", "\u001b[?2004h> "]
[483.957427, "o", "with open('/root/results.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.957511, "o", "    json.dump({'sent_results': sent_results}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.957549, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.95763, "o", "print(\"\\nResults saved to /root/results.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.957661, "o", "> "]
[483.957742, "o", "print(json.dumps({'sent_results': sent_results}, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
