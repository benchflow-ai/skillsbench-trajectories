[785.925933, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.926004, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r"]
[785.926073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.926129, "o", "Best regards,\r\n\u001b[?2004l\r\u001b[?2004h> "]
