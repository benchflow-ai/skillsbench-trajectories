[148.233467, "o", "{\r\n  \"name\": \"google-calendar-skill\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"Claude skill for managing Google Calendar - search, create, update events and answer calendar questions\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"setup\": \"node scripts/auth/setup-oauth.js\"\r\n  },\r\n  \"keywords\": [\r\n    \"google-calendar\",\r\n    \"calendar\",\r\n    \"claude-skill\",\r\n    \"productivity\"\r\n  ],\r\n  \"author\": \"\",\r\n  \"license\": \"MIT\",\r\n  \"dependencies\": {\r\n    \"googleapis\": \"^144.0.0\",\r\n    \"minimist\": \"^1.2.8\",\r\n    \"open\": \"^10.1.0\"\r\n  }\r\n}\r\n"]
