[785.926603, "o", "\u001b[?2004h> "]
[785.926672, "o", "    'Content-Type: text/html; charset=utf-8',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927207, "o", "    ''\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const message = headers.join('\\r\\n') + body;\r\n\u001b[?2004l\r\u001b[?2004h>   return Buffer.from(message)\r\n\u001b[?2004l\r\u001b[?2004h>     .toString('base64')\r\n\u001b[?2004l\r\u001b[?2004h>     .replace(/\\+/g, '-')\r\n\u001b[?2004l\r\u001b[?2004h>     .replace(/\\//g, '_')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927315, "o", "    .replace(/=+$/, '');\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[785.92741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927467, "o", "async function sendEmail(meeting) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927561, "o", "  const body = emailTemplate\r\n\u001b[?2004l\r"]
[785.927625, "o", "\u001b[?2004h> "]
[785.927682, "o", "    .replace('{date}', meeting.date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927782, "o", "    .replace('{time_range}', meeting.time_range)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927903, "o", "    .replace('{duration}', meeting.duration);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.927935, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.928033, "o", "  // Create OAuth2 client with mock credentials\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.928143, "o", "  const oauth2Client = new google.auth.OAuth2(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.928202, "o", "    'test-client-id',\r\n\u001b[?2004l\r\u001b[?2004h"]
[785.928241, "o", "> "]
[785.928574, "o", "    'test-client-secret'\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h>   oauth2Client.setCredentials({\r\n\u001b[?2004l\r\u001b[?2004h>     access_token: 'mock-access-token',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.928613, "o", "    refresh_token: 'mock-refresh-token',\r\n\u001b[?2004l\r"]
[785.928642, "o", "\u001b[?2004h> "]
[785.928709, "o", "    expiry_date: 9999999999999\r\n\u001b[?2004l\r"]
[785.928733, "o", "\u001b[?2004h> "]
[785.928759, "o", "  });\r\n\u001b[?2004l\r"]
[785.928784, "o", "\u001b[?2004h>   "]
[785.928809, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[785.928833, "o", "> "]
[785.928968, "o", "  const gmail = google.gmail({ version: 'v1', auth: oauth2Client });\r\n\u001b[?2004l\r"]
[785.928997, "o", "\u001b[?2004h>   "]
[785.929024, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[785.929131, "o", "  const encodedMessage = createEmailMessage(\r\n\u001b[?2004l\r"]
[785.929158, "o", "\u001b[?2004h> "]
[785.929215, "o", "    meeting.from_email,\r\n\u001b[?2004l\r"]
[785.929241, "o", "\u001b[?2004h> "]
[785.929306, "o", "    'Re: Meeting Request',\r\n\u001b[?2004l\r"]
[785.929337, "o", "\u001b[?2004h> "]
