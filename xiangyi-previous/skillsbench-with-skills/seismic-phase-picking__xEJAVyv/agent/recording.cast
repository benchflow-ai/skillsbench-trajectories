[133.086674, "i", "cat <<EOF > inspect_more.py\nimport numpy as np\nimport os\nimport random\n\nfiles = [f for f in os.listdir('/root/data/') if f.endswith('.npz')]\nselected = random.sample(files, min(5, len(files)))\n\nfor f in selected:\n    path = os.path.join('/root/data/', f)\n    try:\n        data = np.load(path)\n        d = data['data']\n        ch = data['channels']\n        print(f\"File: {f}\")\n        print(f\"  Channels: {ch}\")\n        print(f\"  Shape: {d.shape}\")\n        print(f\"  Std Dev per col: {np.std(d, axis=0)}\")\n        print(f\"  Max val: {np.max(np.abs(d))}\")\n    except Exception as e:\n        print(f\"Error reading {f}: {e}\")\nEOF\n"]
