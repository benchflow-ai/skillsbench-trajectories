[208.318854, "o", "    # Pick S\r\n\u001b[?2004l\r"]
[208.318934, "o", "\u001b[?2004h>     # S must be after P\r\n\u001b[?2004l\r\u001b[?2004h>     s_thr = 4.0\r\n\u001b[?2004l\r\u001b[?2004h>     final_s = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     start_search = 0\r\n\u001b[?2004l\r\u001b[?2004h>     if final_p is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         start_search = final_p + int(0.5 * fs) # 0.5s buffer\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if start_search < len(cf_s):\r\n\u001b[?2004l\r\u001b[?2004h>         s_picks = np.where(cf_s[start_search:] > s_thr)[0]\r\n\u001b[?2004l\r\u001b[?2004h>         if len(s_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>             final_s = start_search + s_picks[0]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     # If P was not found but S was found (rare/weird), maybe discard S?\r\n"]
[208.318971, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[208.319273, "o", "    # Or if P found and S found, check if S is reasonable.\r\n\u001b[?2004l\r"]
[208.319399, "o", "\u001b[?2004h> "]
