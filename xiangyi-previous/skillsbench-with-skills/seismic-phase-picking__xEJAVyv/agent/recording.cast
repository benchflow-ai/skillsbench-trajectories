[329.257554, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.257692, "o", "def butter_bandpass(lowcut, highcut, fs, order=2):\r\n\u001b[?2004l\r"]
[329.257732, "o", "\u001b[?2004h> "]
[329.257793, "o", "    nyq = 0.5 * fs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.25791, "o", "    low = lowcut / nyq\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.259671, "o", ">     high = highcut / nyq\r\n\u001b[?2004l\r\u001b[?2004h>     b, a = butter(order, [low, high], btype='band')\r\n\u001b[?2004l\r\u001b[?2004h>     return b, a\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def filter_data(data, lowcut, highcut, fs, order=2):\r\n\u001b[?2004l\r\u001b[?2004h>     if np.max(np.abs(data)) == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         return data\r\n\u001b[?2004l\r\u001b[?2004h>     b, a = butter_bandpass(lowcut, highcut, fs, order=order)\r\n\u001b[?2004l\r\u001b[?2004h>     y = lfilter(b, a, data)\r\n\u001b[?2004l\r\u001b[?2004h>     return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def classic_sta_lta(data, nsta, nlta):\r\n\u001b[?2004l\r\u001b[?2004h>     sq = data ** 2\r\n\u001b[?2004l\r\u001b[?2004h>     cs = np.cumsum(sq)\r\n\u001b[?2004l\r\u001b[?2004h>     # Pad to handle indices\r\n\u001b[?2004l\r\u001b[?2004h>     cs = np.pad(cs, (1, 0), 'constant', constant_values=0)\r\n\u001b[?2004l\r"]
[329.259788, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.259817, "o", "    idxs = np.arange(nlta, len(data))\r\n\u001b[?2004l\r"]
[329.259844, "o", "\u001b[?2004h> "]
[329.259871, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[329.259894, "o", "> "]
[329.260012, "o", "    sta = (cs[idxs+1] - cs[idxs+1-nsta]) / nsta\r\n\u001b[?2004l\r"]
[329.260038, "o", "\u001b[?2004h> "]
[329.260153, "o", "    lta = (cs[idxs+1] - cs[idxs+1-nlta]) / nlta\r\n\u001b[?2004l\r"]
[329.260176, "o", "\u001b[?2004h> "]
[329.260207, "o", "    \r\n\u001b[?2004l\r"]
[329.260234, "o", "\u001b[?2004h> "]
[329.260294, "o", "    # Avoid div by zero\r\n\u001b[?2004l\r"]
[329.260319, "o", "\u001b[?2004h> "]
[329.260888, "o", "    lta[lta < 1e-10] = 1e-10\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.261037, "o", "    ratio = np.zeros(len(data))\r\n\u001b[?2004l\r\u001b[?2004h>     ratio[idxs] = sta / lta\r\n\u001b[?2004l\r\u001b[?2004h>     return ratio\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_picks(file_path, debug=False):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.261211, "o", "        npz = np.load(file_path)\r\n\u001b[?2004l\r\u001b[?2004h>         data = npz['data']\r\n\u001b[?2004l\r"]
[329.261273, "o", "\u001b[?2004h>         dt = float(npz['dt'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.261376, "o", "> "]
[329.261458, "o", "        fs = 1.0 / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.26153, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.261628, "o", "        print(f\"Error loading {file_path}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.261692, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[329.261789, "o", "\u001b[?2004h> "]
[329.261871, "o", "    stds = np.std(data, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.26196, "o", "    active_cols = np.where(stds > 1e-20)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.262052, "o", ">     \r\n\u001b[?2004l\r"]
[329.262141, "o", "\u001b[?2004h>     if len(active_cols) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.262228, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.262294, "o", "    z_idx = 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.262364, "o", "    h_idxs = [0, 1]\r\n\u001b[?2004l\r"]
[329.262586, "o", "\u001b[?2004h> "]
[329.262665, "o", "    if 2 not in active_cols:\r\n\u001b[?2004l\r"]
[329.262752, "o", "\u001b[?2004h> "]
[329.262848, "o", "        z_idx = active_cols[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.26351, "o", "        h_idxs = [c for c in active_cols if c != z_idx]\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         h_idxs = [c for c in h_idxs if c in active_cols]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Process Z for P-wave\r\n\u001b[?2004l\r\u001b[?2004h>     z_data = data[:, z_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.263654, "o", "    # Normalize\r\n\u001b[?2004l\r\u001b[?2004h>     if np.max(np.abs(z_data)) > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.263757, "o", "> "]
[329.263838, "o", "        z_data = z_data / np.max(np.abs(z_data))\r\n\u001b[?2004l\r"]
[329.263872, "o", "\u001b[?2004h"]
[329.264055, "o", "> "]
[329.264146, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.264379, "o", "    z_data = z_data - np.mean(z_data)\r\n\u001b[?2004l\r"]
[329.264509, "o", "\u001b[?2004h> "]
[329.264602, "o", "    z_filt = filter_data(z_data, 1.0, 20.0, fs)\r\n\u001b[?2004l\r"]
[329.264656, "o", "\u001b[?2004h> "]
[329.264701, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.264958, "o", "    nsta = int(0.5 * fs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.26512, "o", "> "]
[329.265396, "o", "    nlta = int(10.0 * fs)\r\n\u001b[?2004l\r"]
[329.265493, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[329.265535, "o", "> "]
[329.265721, "o", "    cf_p = classic_sta_lta(z_filt, nsta, nlta)"]
[329.265768, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.266059, "o", "    \r\n\u001b[?2004l\r"]
[329.266127, "o", "\u001b[?2004h>     if debug:"]
[329.266165, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.266211, "o", "> "]
[329.266395, "o", "        print(f\"{os.path.basename(file_path)} P max STA/LTA: {np.max(cf_p)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.266438, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.266611, "o", "    p_thr = 3.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.266916, "o", "    p_picks = np.where(cf_p > p_thr)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.266962, "o", "    final_p = None\r\n\u001b[?2004l\r"]
[329.267065, "o", "\u001b[?2004h> "]
[329.267121, "o", "    if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.267161, "o", "> "]
[329.26733, "o", "        # Trigger logic: take first crossing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.26762, "o", "        # To be more robust, find the peak of the trigger window?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.267839, "o", "        # Simple: first index > threshold\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.26789, "o", "        final_p = p_picks[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.26793, "o", ">     \r\n\u001b[?2004l\r"]
[329.267961, "o", "\u001b[?2004h> "]
[329.268064, "o", "    # Process H for S-wave\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268122, "o", "    if len(h_idxs) > 0:\r\n\u001b[?2004l\r"]
[329.268166, "o", "\u001b[?2004h> "]
[329.268277, "o", "        h_data = np.zeros_like(z_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268363, "o", "        for idx in h_idxs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268454, "o", "            d = data[:, idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268599, "o", "            if np.max(np.abs(d)) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268707, "o", "                d = d / np.max(np.abs(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.268799, "o", "            d = d - np.mean(d)\r\n\u001b[?2004l\r"]
[329.269161, "o", "\u001b[?2004h>             d = filter_data(d, 1.0, 20.0, fs)\r\n\u001b[?2004l\r\u001b[?2004h>             h_data += d**2\r\n\u001b[?2004l\r\u001b[?2004h>         h_comb = np.sqrt(h_data)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n"]
[329.269204, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[329.2694, "o", "        h_comb = np.abs(z_filt)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.269506, "o", "    cf_s = classic_sta_lta(h_comb, nsta, nlta)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.269689, "o", "    if debug:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.269738, "o", "        print(f\"{os.path.basename(file_path)} S max STA/LTA: {np.max(cf_s)}\")\r\n\u001b[?2004l\r"]
[329.269779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[329.269817, "o", "\u001b[?2004h> "]
[329.269856, "o", "    s_thr = 3.5\r\n\u001b[?2004l\r"]
[329.269984, "o", "\u001b[?2004h> "]
[329.270089, "o", "    final_s = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.270131, "o", "    start_search = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.270167, "o", "    if final_p is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.270208, "o", "> "]
[329.270603, "o", "        start_search = final_p + int(0.5 * fs)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.271065, "o", "    if start_search < len(cf_s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.2712, "o", "        s_picks = np.where(cf_s[start_search:] > s_thr)[0]"]
[329.272043, "o", "\r\n\u001b[?2004l\r"]
[329.27211, "o", "\u001b[?2004h> "]
[329.272291, "o", "        if len(s_picks) > 0:\r\n\u001b[?2004l\r"]
[329.272333, "o", "\u001b[?2004h> "]
[329.272616, "o", "            final_s = start_search + s_picks[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.272653, "o", "> "]
[329.272688, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[329.272726, "o", "> "]
[329.272885, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.273006, "o", "    fname = os.path.basename(file_path)\r\n\u001b[?2004l\r"]
[329.273054, "o", "\u001b[?2004h"]
[329.273086, "o", "> "]
[329.273257, "o", "    if final_p is not None:\r\n\u001b[?2004l\r"]
[329.273291, "o", "\u001b[?2004h> "]
[329.273632, "o", "        results.append({'file_name': fname, 'phase': 'P', 'pick_idx': final_p})\r\n\u001b[?2004l\r"]
[329.27368, "o", "\u001b[?2004h> "]
[329.273811, "o", "    if final_s is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.274137, "o", "        results.append({'file_name': fname, 'phase': 'S', 'pick_idx': final_s})\r\n\u001b[?2004l\r"]
[329.274169, "o", "\u001b[?2004h> "]
[329.274241, "o", "        \r\n\u001b[?2004l\r"]
[329.27427, "o", "\u001b[?2004h> "]
[329.274326, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.274354, "o", "> \r\n\u001b[?2004l\r"]
[329.274418, "o", "\u001b[?2004h> "]
[329.2745, "o", "all_results = []\r\n\u001b[?2004l\r"]
[329.274524, "o", "\u001b[?2004h"]
[329.274549, "o", "> "]
[329.27474, "o", "data_dir = '/root/data/'\r\n\u001b[?2004l\r"]
[329.2748, "o", "\u001b[?2004h> "]
[329.274932, "o", "files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[329.274964, "o", "> "]
[329.275046, "o", "for i, f in enumerate(files):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.275111, "o", "    debug = i < 5\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.275139, "o", "> "]
[329.275277, "o", "    res = get_picks(os.path.join(data_dir, f), debug=debug)\r\n\u001b[?2004l\r"]
[329.275311, "o", "\u001b[?2004h> "]
[329.27538, "o", "    all_results.extend(res)\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.275409, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[329.275433, "o", "> "]
[329.275516, "o", "df = pd.DataFrame(all_results)\r\n\u001b[?2004l\r"]
[329.275545, "o", "\u001b[?2004h> "]
[329.275724, "o", "if not df.empty:\r\n\u001b[?2004l\r"]
[329.275762, "o", "\u001b[?2004h> "]
[329.275874, "o", "    df = df[['file_name', 'phase', 'pick_idx']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.276084, "o", "    df.to_csv('/root/results.csv', index=False)\r\n"]
[329.276135, "o", "\u001b[?2004l\r\u001b[?2004h"]
[329.276168, "o", "> "]
[329.276312, "o", "    print(f\"Saved {len(df)} picks to results.csv\")\r\n\u001b[?2004l\r"]
[329.276348, "o", "\u001b[?2004h"]
[329.276375, "o", "> else:\r\n\u001b[?2004l\r"]
[329.276418, "o", "\u001b[?2004h"]
[329.276455, "o", "> "]
[329.276611, "o", "    print(\"No picks found\")\r\n\u001b[?2004l\r"]
[329.276789, "o", "\u001b[?2004h"]
[329.276827, "o", "> EOF"]
[329.276867, "o", "\r\n"]
