[362.237965, "o", "\u001b[?2004hroot@9c3e828de35c:~# "]
[418.068198, "i", "cat <<EOF > solver.py\nimport numpy as np\nimport pandas as pd\nimport os\nfrom scipy.signal import butter, lfilter\n\ndef butter_bandpass(lowcut, highcut, fs, order=2):\n    nyq = 0.5 * fs\n    low = lowcut / nyq\n    high = highcut / nyq\n    b, a = butter(order, [low, high], btype='band')\n    return b, a\n\ndef filter_data(data, lowcut, highcut, fs, order=2):\n    if np.max(np.abs(data)) == 0:\n        return data\n    b, a = butter_bandpass(lowcut, highcut, fs, order=order)\n    y = lfilter(b, a, data)\n    return y\n\ndef classic_sta_lta(data, nsta, nlta):\n    sq = data ** 2\n    cs = np.cumsum(sq)\n    cs = np.pad(cs, (1, 0), 'constant', constant_values=0)\n    idxs = np.arange(nlta, len(data))\n    sta = (cs[idxs+1] - cs[idxs+1-nsta]) / nsta\n    lta = (cs[idxs+1] - cs[idxs+1-nlta]) / nlta\n    lta[lta < 1e-10] = 1e-10\n    ratio = np.zeros(len(data))\n    ratio[idxs] = sta / lta\n    return ratio\n\ndef get_picks(file_path, debug=False):\n    try:\n        npz = np.load(file_path)\n        data = npz['data']\n        dt = float(npz['dt'])\n        fs = 1.0 / dt\n    except Exception as e:\n        print(f\"Error loading {file_path}: {e}\")\n        return []\n\n    stds = np.std(data, axis=0)\n    active_cols = np.where(stds > 1e-20)[0]\n    if len(active_cols) == 0: return []\n\n    z_idx = 2\n    h_idxs = [0, 1]\n    if 2 not in active_cols:\n        z_idx = active_cols[-1]\n        h_idxs = [c for c in active_cols if c != z_idx]\n    else:\n        h_idxs = [c for c in h_idxs if c in active_cols]\n\n    # P-wave (Z)\n    z_data = data[:, z_idx]\n    if np.max(np.abs(z_data)) > 0: z_data = z_data / np.max(np.abs(z_data))\n    z_data = z_data - np.mean(z_data)\n    z_filt = filter_data(z_data, 1.0, 20.0, fs)\n    \n    nsta = int(0.5 * fs)\n    nlta = int(10.0 * fs)\n    cf_p = classic_sta_lta(z_filt, nsta, nlta)\n    \n    p_thr = 3.5\n    # Find crossings for P\n    p_crossings = np.where((cf_p[:-1] <= p_thr) & (cf_p[1:] > p_thr))[0] + 1\n    final_p = p_crossings[0] if len(p_crossings) > 0 else None\n\n    # S-wave (H)\n    if len(h_idxs) > 0:\n        h_data = np.zeros_like(z_data)\n        for idx in h_idxs:\n            d = data[:, idx]\n            if np.max(np.abs(d)) > 0: d = d / np.max(np.abs(d))\n            d = d - np.mean(d)\n            d = filter_data(d, 1.0, 20.0, fs)\n            h_data += d**2\n        h_comb = np.sqrt(h_data)\n    else:\n        h_comb = np.abs(z_filt)\n        \n    cf_s = classic_sta_lta(h_comb, nsta, nlta)\n    s_thr = 4.0\n    \n    s_crossings = np.where((cf_s[:-1] <= s_thr) & (cf_s[1:] > s_thr))[0] + 1\n    \n    final_s = None\n    if final_p is not None:\n        start_search = final_p + int(0.5 * fs)\n        valid_s = s_crossings[s_crossings > start_search]\n        if len(valid_s) > 0:\n            final_s = valid_s[0]\n    else:\n        # If no P found, try to find S anyway\n        valid_s = s_crossings[s_crossings > nlta]\n        if len(valid_s) > 0:\n            final_s = valid_s[0]\n            \n    if debug:\n        print(f\"{os.path.basename(file_path)} P: {final_p}, S: {final_s}\")\n\n    results = []\n    fname = os.path.basename(file_path)\n    if final_p is not None:\n        results.append({'file_name': fname, 'phase': 'P', 'pick_idx': final_p})\n    if final_s is not None:\n        results.append({'file_name': fname, 'phase': 'S', 'pick_idx': final_s})\n        \n    return results\n\nall_results = []\ndata_dir = '/root/data/'\nfiles = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n\nfor i, f in enumerate(files):\n    debug = i < 5\n    res = get_picks(os.path.join(data_dir, f), debug=debug)\n    all_results.extend(res)\n\ndf = pd.DataFrame(all_results)\nif not df.empty:\n    df = df[['file_name', 'phase', 'pick_idx']]\n    df.to_csv('/root/results.csv', index=False)\n    print(f\"Saved {len(df)} picks to results.csv\")\nelse:\n    print(\"No picks found\")\nEOF\n"]
