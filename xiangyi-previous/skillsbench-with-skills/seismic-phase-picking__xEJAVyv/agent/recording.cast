[208.321534, "o", "\u001b[?2004h> "]
[208.321643, "o", "all_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.321706, "o", "data_dir = '/root/data/'\r\n\u001b[?2004l\r"]
[208.321741, "o", "\u001b[?2004h> "]
[208.321936, "o", "files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\r\n\u001b[?2004l\r"]
[208.321974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.322006, "o", "\u001b[?2004h> "]
[208.322124, "o", "for f in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.322233, "o", "    res = get_picks(os.path.join(data_dir, f))\r\n\u001b[?2004l\r"]
[208.32227, "o", "\u001b[?2004h> "]
[208.322359, "o", "    all_results.extend(res)\r\n\u001b[?2004l\r"]
[208.322394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.322424, "o", "\u001b[?2004h> "]
[208.322518, "o", "df = pd.DataFrame(all_results)\r\n\u001b[?2004l\r"]
