arch + s_picks[0]\r\n            \r\n    # If P was not found but S was found (rare/weird), maybe discard S?\r\n    # Or if P found and S found, check if S is reasonable.\r\n    \r\n    results = []\r\n    fname = os.path.basename(file_path)\r\n    if final_p is not None:\r\n        results.append({'file_\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import butter, lfilter\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def butter_bandpass(lowcut, highcut, fs, order=2):\r\n\u001b[?2004l\r\u001b[?2004h>     nyq = 0.5 * fs\r\n\u001b[?2004l\r\u001b[?2004h>     low = lowcut / nyq\r\n\u001b[?2004l\r\u001b[?2004h>     high = highcut / nyq\r\n\u001b[?2004l\r\u001b[?2004h>     b, a = butter(order, [low, high], btype='band')\r\n\u001b[?2004l\r\u001b[?2004h> "]
