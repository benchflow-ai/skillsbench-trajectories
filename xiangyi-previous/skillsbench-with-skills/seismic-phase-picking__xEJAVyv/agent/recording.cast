[94.763688, "i", "cat <<EOF > inspect_data.py\nimport numpy as np\nimport os\n\nfiles = [f for f in os.listdir('/root/data/') if f.endswith('.npz')]\nif not files:\n    print('No npz files found')\n    exit()\n\nf = files[0]\npath = os.path.join('/root/data/', f)\ndata = np.load(path)\nprint(f\"File: {f}\")\nprint(f\"Keys: {list(data.keys())}\")\nprint(f\"Data shape: {data['data'].shape}\")\nprint(f\"dt: {data['dt']}\")\nprint(f\"Channels: {data['channels']}\")\n\nd = data['data']\nprint(f\"Data stats (mean/std/max):\")\nprint(f\"{np.mean(d, axis=0)}\")\nprint(f\"{np.std(d, axis=0)}\")\nprint(f\"{np.max(d, axis=0)}\")\nEOF\n"]
