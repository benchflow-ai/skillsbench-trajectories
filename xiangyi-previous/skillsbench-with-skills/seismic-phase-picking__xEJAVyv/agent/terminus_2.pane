[?2004l[?2004h> from scipy.signal import butter, lfilter
[?2004l[?2004h> 
[?2004l[?2004h> def butter_bandpass(lowcut, highcut, fs, order=2):
[?2004l[?2004h>     nyq = 0.5 * fs
[?2004l[?2004h>     low = lowcut / nyq
[?2004l[?2004h>     high = highcut / nyq
[?2004l[?2004h>     b, a = butter(order, [low, high], btype='band')
[?2004l[?2004h>     return b, a
[?2004l[?2004h> 
[?2004l[?2004h> def filter_data(data, lowcut, highcut, fs, order=2):
[?2004l[?2004h>     if np.max(np.abs(data)) == 0:
[?2004l[?2004h>         return data
[?2004l[?2004h>     b, a = butter_bandpass(lowcut, highcut, fs, order=order)
[?2004l[?2004h>     y = lfilter(b, a, data)
[?2004l[?2004h>     return y
[?2004l[?2004h> 
[?2004l[?2004h> def classic_sta_lta(data, nsta, nlta):
[?2004l[?2004h>     sq = data ** 2
[?2004l[?2004h>     cs = np.cumsum(sq)
[?2004l[?2004h>     cs = np.pad(cs, (1, 0), 'constant', constant_values=0)
[?2004l[?2004h>     idxs = np.arange(nlta, len(data))
[?2004l[?2004h>     sta = (cs[idxs+1] - cs[idxs+1-nsta]) / nsta
[?2004l[?2004h>     lta = (cs[idxs+1] - cs[idxs+1-nlta]) / nlta
[?2004l[?2004h>     lta[lta < 1e-10] = 1e-10
[?2004l[?2004h>     ratio = np.zeros(len(data))
[?2004l[?2004h>     ratio[idxs] = sta / lta
[?2004l[?2004h>     return ratio
[?2004l[?2004h> 
[?2004l[?2004h> def get_picks(file_path, debug=False):
[?2004l[?2004h>     try:
[?2004l[?2004h>         npz = np.load(file_path)
[?2004l[?2004h>         data = npz['data']
[?2004l[?2004h>         dt = float(npz['dt'])
[?2004l[?2004h>         fs = 1.0 / dt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error loading {file_path}: {e}")
[?2004l[?2004h>         return []
[?2004l[?2004h> 
[?2004l[?2004h>     stds = np.std(data, axis=0)
[?2004l[?2004h>     active_cols = np.where(stds > 1e-20)[0]
[?2004l[?2004h>     if len(active_cols) == 0: return []
[?2004l[?2004h> 
[?2004l[?2004h>     z_idx = 2
[?2004l[?2004h>     h_idxs = [0, 1]
[?2004l[?2004h>     if 2 not in active_cols:
[?2004l[?2004h>         z_idx = active_cols[-1]
[?2004l[?2004h>         h_idxs = [c for c in active_cols if c != z_idx]
[?2004l[?2004h>     else:
[?2004l[?2004h>         h_idxs = [c for c in h_idxs if c in active_cols]
[?2004l[?2004h> 
[?2004l[?2004h>     # P-wave (Z)
[?2004l[?2004h>     z_data = data[:, z_idx]
[?2004l[?2004h>     if np.max(np.abs(z_data)) > 0: z_data = z_data / np.max(np.abs(z_data))
[?2004l[?2004h>     z_data = z_data - np.mean(z_data)
[?2004l[?2004h>     z_filt = filter_data(z_data, 1.0, 20.0, fs)
[?2004l[?2004h>     
[?2004l[?2004h>     nsta = int(0.5 * fs)
[?2004l[?2004h>     nlta = int(10.0 * fs)
[?2004l[?2004h>     cf_p = classic_sta_lta(z_filt, nsta, nlta)
[?2004l[?2004h>     
[?2004l[?2004h>     p_thr = 3.5
[?2004l[?2004h>     # Find crossings for P
[?2004l[?2004h>     p_crossings = np.where((cf_p[:-1] <= p_thr) & (cf_p[1:] > p_thr))[0] + 1
[?2004l[?2004h>     final_p = p_crossings[0] if len(p_crossings) > 0 else None
[?2004l[?2004h> 
[?2004l[?2004h>     # S-wave (H)
[?2004l[?2004h>     if len(h_idxs) > 0:
[?2004l[?2004h>         h_data = np.zeros_like(z_data)
[?2004l[?2004h>         for idx in h_idxs:
[?2004l[?2004h>             d = data[:, idx]
[?2004l[?2004h>             if np.max(np.abs(d)) > 0: d = d / np.max(np.abs(d))
[?2004l[?2004h>             d = d - np.mean(d)
[?2004l[?2004h>             d = filter_data(d, 1.0, 20.0, fs)
[?2004l[?2004h>             h_data += d**2
[?2004l[?2004h>         h_comb = np.sqrt(h_data)
[?2004l[?2004h>     else:
[?2004l[?2004h>         h_comb = np.abs(z_filt)
[?2004l[?2004h>         
[?2004l[?2004h>     cf_s = classic_sta_lta(h_comb, nsta, nlta)
[?2004l[?2004h>     s_thr = 4.0
[?2004l[?2004h>     
[?2004l[?2004h>     s_crossings = np.where((cf_s[:-1] <= s_thr) & (cf_s[1:] > s_thr))[0] + 1
[?2004l[?2004h>     
[?2004l[?2004h>     final_s = None
[?2004l[?2004h>     if final_p is not None:
[?2004l[?2004h>         start_search = final_p + int(0.5 * fs)
[?2004l[?2004h>         valid_s = s_crossings[s_crossings > start_search]
[?2004l[?2004h>         if len(valid_s) > 0:
[?2004l[?2004h>             final_s = valid_s[0]
[?2004l[?2004h>     else:
[?2004l[?2004h>         # If no P found, try to find S anyway
[?2004l[?2004h>         valid_s = s_crossings[s_crossings > nlta]
[?2004l[?2004h>         if len(valid_s) > 0:
[?2004l[?2004h>             final_s = valid_s[0]
[?2004l[?2004h>             
[?2004l[?2004h>     if debug:
[?2004l[?2004h>         print(f"{os.path.basename(file_path)} P: {final_p}, S: {final_s}")
[?2004l[?2004h> 
[?2004l[?2004h>     results = []
[?2004l[?2004h>     fname = os.path.basename(file_path)
[?2004l[?2004h>     if final_p is not None:
[?2004l[?2004h>         results.append({'file_name': fname, 'phase': 'P', 'pick_idx': final_p})
[?2004l[?2004h>     if final_s is not None:
