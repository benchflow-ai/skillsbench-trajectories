[?2004lf len(active_cols) == 0:
        return []

    # Determine Z and H indices
    # If 3 channels, assume 2 is Z, 0/1 are H
    # If 'EHZ' and only col 2 is active, Z=2
    z_idx = 2
    h_idxs = [0, 1]
    
    if 2 not in active_cols:
        # Fallback: take the active column with highest energy as Z?
        # Or just take the first active one
        z_idx = active_cols[-1]
        h_idxs = [c for c in active_cols if c != z_idx]
