[?2004hroot@e4420c693c68:~# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, os
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> from sklearn.linear_model import LinearRegression
[?2004l[?2004h> 
[?2004l[?2004h> # load data
[?2004l[?2004h> wt = pd.read_csv('/root/data/water_temperature.csv')
[?2004l[?2004h> climate = pd.read_csv('/root/data/climate.csv')
[?2004l[?2004h> land = pd.read_csv('/root/data/land_cover.csv')
[?2004l[?2004h> hydro = pd.read_csv('/root/data/hydrology.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # trend analysis
[?2004l[?2004h> res = linregress(wt['Year'], wt['WaterTemperature'])
[?2004l[?2004h> os.makedirs('/root/output', exist_ok=True)
[?2004l[?2004h> trend_df = pd.DataFrame({'slope':[res.slope], 'p-value':[res.pvalue]})
[?2004l[?2004h> trend_df.to_csv('/root/output/trend_result.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # merge for regression
[?2004l[?2004h> merged = wt.merge(climate, on='Year').merge(land, on='Year').merge(hydro, on='Year')
[?2004l[?2004h> 
[?2004l[?2004h> y = merged['WaterTemperature'].values
[?2004l[?2004h> X = merged.drop(columns=['Year','WaterTemperature'])
[?2004l[?2004h> 
[?2004l[?2004h> # standardize predictors
[?2004l[?2004h> X_std = (X - X.mean())/X.std(ddof=0)
[?2004l[?2004h> 
[?2004l[?2004h> # linear regression
[?2004l[?2004h> model = LinearRegression()
[?2004l[?2004h> model.fit(X_std, y)
[?2004l[?2004h> coefs = pd.Series(model.coef_, index=X.columns)
[?2004l[?2004h> abs_coefs = coefs.abs()
[?2004l[?2004h> 
[?2004l[?2004h> # category mapping
[?2004l[?2004h> category_map = {
[?2004l[?2004h>     'AirTempLake':'Heat',
[?2004l[?2004h>     'Shortwave':'Heat',
[?2004l[?2004h>     'Longwave':'Heat',
[?2004l[?2004h>     'Precip':'Flow',
[?2004l[?2004h>     'Inflow':'Flow',
[?2004l[?2004h>     'Outflow':'Flow',
[?2004l[?2004h>     'WindSpeedLake':'Wind',
[?2004l[?2004h>     'DevelopedArea':'Human',
[?2004l[?2004h>     'AgricultureArea':'Human'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> cat_contrib = {}
[?2004l[?2004h> for var, coef in abs_coefs.items():
[?2004l[?2004h>     cat = category_map.get(var, 'Other')
[?2004l[?2004h>     cat_contrib[cat] = cat_contrib.get(cat, 0) + coef
[?2004l[?2004h> 
[?2004l[?2004h> # compute percentage contribution
[?2004l[?2004h> cat_contrib = pd.Series(cat_contrib)
[?2004l[?2004h> percent = cat_contrib / cat_contrib.sum() * 100
[?2004l[?2004h> 
[?2004l[?2004h> # get dominant category
[?2004l[?2004h> dominant_cat = percent.idxmax()
[?2004l[?2004h> dominant_pct = percent.loc[dominant_cat]
[?2004l[?2004h> 
[?2004l[?2004h> dom_df = pd.DataFrame({'variable':[dominant_cat], 'contribution':[dominant_pct]})
[?2004l[?2004h> dom_df.to_csv('/root/output/dominant_factor.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('trend_result.csv')
[?2004l[?2004h> print(trend_df)
[?2004l[?2004h> print('\ndominant_factor.csv')
[?2004l[?2004h> print(dom_df)
