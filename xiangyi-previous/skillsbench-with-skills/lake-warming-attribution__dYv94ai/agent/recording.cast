[7.393002, "o", "\u001b[?2004hroot@e4420c693c68:~# "]
[38.950792, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np, os\nfrom scipy.stats import linregress\nfrom sklearn.linear_model import LinearRegression\n\n# load data\nwt = pd.read_csv('/root/data/water_temperature.csv')\nclimate = pd.read_csv('/root/data/climate.csv')\nland = pd.read_csv('/root/data/land_cover.csv')\nhydro = pd.read_csv('/root/data/hydrology.csv')\n\n# trend analysis\nres = linregress(wt['Year'], wt['WaterTemperature'])\nos.makedirs('/root/output', exist_ok=True)\ntrend_df = pd.DataFrame({'slope':[res.slope], 'p-value':[res.pvalue]})\ntrend_df.to_csv('/root/output/trend_result.csv', index=False)\n\n# merge for regression\nmerged = wt.merge(climate, on='Year').merge(land, on='Year').merge(hydro, on='Year')\n\ny = merged['WaterTemperature'].values\nX = merged.drop(columns=['Year','WaterTemperature'])\n\n# standardize predictors\nX_std = (X - X.mean())/X.std(ddof=0)\n\n# linear regression\nmodel = LinearRegression()\nmodel.fit(X_std, y)\ncoefs = pd.Series(model.coef_, index=X.columns)\nabs_coefs = coefs.abs()\n\n# category mapping\ncategory_map = {\n    'AirTempLake':'Heat',\n    'Shortwave':'Heat',\n    'Longwave':'Heat',\n    'Precip':'Flow',\n    'Inflow':'Flow',\n    'Outflow':'Flow',\n    'WindSpeedLake':'Wind',\n    'DevelopedArea':'Human',\n    'AgricultureArea':'Human'\n}\n\ncat_contrib = {}\nfor var, coef in abs_coefs.items():\n    cat = category_map.get(var, 'Other')\n    cat_contrib[cat] = cat_contrib.get(cat, 0) + coef\n\n# compute percentage contribution\ncat_contrib = pd.Series(cat_contrib)\npercent = cat_contrib / cat_contrib.sum() * 100\n\n# get dominant category\ndominant_cat = percent.idxmax()\ndominant_pct = percent.loc[dominant_cat]\n\ndom_df = pd.DataFrame({'variable':[dominant_cat], 'contribution':[dominant_pct]})\ndom_df.to_csv('/root/output/dominant_factor.csv', index=False)\n\nprint('trend_result.csv')\nprint(trend_df)\nprint('\\ndominant_factor.csv')\nprint(dom_df)\nPY\n"]
