[164.694948, "i", "python3 - <<'PY'\nimport pandas as pd\n\ndf = pd.read_excel('/root/data/external-data.xls', sheet_name='External')\n# row 0 contains Commodity.Description\nrow0 = df.iloc[0]\ncols = []\nfor col, val in row0.items():\n    if isinstance(val, str) and ('Gold' in val or 'gold' in val):\n        cols.append((col, val))\nprint('gold-related columns:')\nfor c,v in cols:\n    print(c, '->', v)\nPY\n"]
