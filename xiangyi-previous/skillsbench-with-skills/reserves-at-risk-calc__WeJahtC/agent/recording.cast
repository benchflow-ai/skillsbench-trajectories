[48.791335, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/root/data/test-rar.xlsx')\nfor name in ['Value','Volume','Total Reserves']:\n    ws=wb[name]\n    print('\\n',name)\n    for r in range(1,6):\n        print(r, [ws.cell(r,c).value for c in range(1,ws.max_column+1)])\n    print('...last row', ws.max_row, [ws.cell(ws.max_row,c).value for c in range(1,ws.max_column+1)])\n\nwsA=wb['Answer']\nprint('\\nAnswer rows 15-24:')\nfor r in range(15,25):\n    print(r, [wsA.cell(r,c).value for c in range(1,12)])\nPY\n"]
