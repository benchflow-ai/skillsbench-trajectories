[199.748638, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/root/data/test-rar.xlsx')\nws=wb['Answer']\n\ndef show_row(r):\n    vals=[]\n    for c in range(1,12):\n        vals.append(f\"{get_column_letter(c)}{r}:{ws.cell(r,c).value}\")\n    print('row', r, vals)\n\nfor r in range(3,7):\n    show_row(r)\nfor r in range(11,14):\n    show_row(r)\nfor r in range(20,25):\n    show_row(r)\nPY\n"]
