[496.544081, "o", "exposures = {k: v * (z*vol3/100) for k,v in values.items()}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[496.544153, "o", "print('exposures (vol3):')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[496.544215, "o", "for k,v in exposures.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[496.544258, "o", "    print(k, v)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
[496.544294, "o", "\u001b[?2004l\r"]
