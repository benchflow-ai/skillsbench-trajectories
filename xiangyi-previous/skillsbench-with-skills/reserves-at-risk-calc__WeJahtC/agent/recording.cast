[496.542394, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\n# values from Value sheet 2025 row\nvalues = {\n    'Belarus':7471,\n    'Georgia':1002,\n    'Moldova':10.71,\n    'Ukraine':3877.64,\n    'Uzbekistan':55092.42,\n    'Czechia':10121.89,\n    'Latvia':921.28,\n    'Lithuania':807.1\n}\n# average Jan-Sep 2025 gold price\navg_price = 3202.8236082355647\nslovakia_volume = 1.019\nvalues['Slovakia'] = slovakia_volume * avg_price\n# volatility and z-score\nz = 1.645\nvol3 = 4.813322962293496  # percent\nvol3_ann = vol3 * (12**0.5)\nprint('Slovakia value', values['Slovakia'])\nprint('vol3', vol3, 'vol3_ann', vol3_ann)\n# compute exposures using vol3\nexposures = {k: v * (z*vol3/100) for k,v in values.items()}\nprint('exposures (vol3):')\nfor k,v in exposures.items():\n    print(k, v)\nPY\n"]
