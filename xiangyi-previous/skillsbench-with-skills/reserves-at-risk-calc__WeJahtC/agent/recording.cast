[32.372398, "i", "python3 - <<'PY'\nimport pandas as pd\nimport openpyxl\nwb=openpyxl.load_workbook('/root/data/test-rar.xlsx')\nws=wb['Gold price']\nfor r in range(1,8):\n    print([ws.cell(r,c).value for c in range(1,6)])\nprint('...last rows')\nfor r in range(ws.max_row-3, ws.max_row+1):\n    print(r,[ws.cell(r,c).value for c in range(1,6)])\n\nwsA=wb['Answer']\nfor r in range(1,15):\n    print(r,[wsA.cell(r,c).value for c in range(1,12)])\nPY\n"]
