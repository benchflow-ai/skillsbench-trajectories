[405.355908, "i", "python3 - <<'PY'\nimport pandas as pd, numpy as np\n\ndf = pd.read_excel('/root/data/external-data.xls', sheet_name='External')\n# data from row 3 onward\nseries = df.loc[3:, ['Commodity','PGOLD']].copy()\nseries.columns = ['Period','Gold']\nseries = series[series['Period'].notna()]\nseries['Gold'] = pd.to_numeric(series['Gold'], errors='coerce')\n# compute log returns\nseries['logret'] = np.log(series['Gold']/series['Gold'].shift(1))*100\n# rolling vol\nseries['vol3'] = series['logret'].rolling(3).std()\nseries['vol12'] = series['logret'].rolling(12).std()\n# get latest non-null values\nlatest = series.dropna(subset=['Gold']).iloc[-1]\nprint('latest period', latest['Period'])\nprint('latest gold', latest['Gold'])\nprint('latest logret', latest['logret'])\nprint('latest vol3', latest['vol3'])\nprint('latest vol12', latest['vol12'])\n# Jan-Sep 2025 average price\navg_2025 = series[series['Period'].isin([f'2025M{i}' for i in range(1,10)])]['Gold'].mean()\nprint('avg Jan-Sep 2025', avg_2025)\nPY\n"]
