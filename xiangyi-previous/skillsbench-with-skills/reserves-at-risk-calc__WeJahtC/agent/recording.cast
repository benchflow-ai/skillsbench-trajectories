[247.061759, "i", "python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\n\nfor sheet in ['Value','Volume','Total Reserves']:\n    df = pd.read_excel('/root/data/test-rar.xlsx', sheet_name=sheet, header=None)\n    # row indices 0-based; row0 is .DESC, row17 is 2025\n    desc = df.iloc[0]\n    data2025 = df.iloc[17]\n    print('\\n', sheet, '2025 data')\n    for col in range(len(desc)):\n        name = desc[col]\n        val = data2025[col]\n        if isinstance(name, str) and name not in ['.DESC', None] and not (pd.isna(val)):\n            # extract country name before ':'\n            country = name.split(':')[0]\n            print(col, country, val)\nPY\n"]
