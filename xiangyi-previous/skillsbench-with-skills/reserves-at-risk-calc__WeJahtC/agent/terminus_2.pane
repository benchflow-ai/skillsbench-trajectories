[?2004hroot@2a8f8493f1a3:~# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_excel('/root/data/external-data.xls', sheet_name='External')
[?2004l[?2004h> # data from row 3 onward
[?2004l[?2004h> series = df.loc[3:, ['Commodity','PGOLD']].copy()
[?2004l[?2004h> series.columns = ['Period','Gold']
[?2004l[?2004h> series = series[series['Period'].notna()]
[?2004l[?2004h> series['Gold'] = pd.to_numeric(series['Gold'], errors='coerce')
[?2004l[?2004h> # compute log returns
[?2004l[?2004h> series['logret'] = np.log(series['Gold']/series['Gold'].shift(1))*100
[?2004l[?2004h> # rolling vol
[?2004l[?2004h> series['vol3'] = series['logret'].rolling(3).std()
[?2004l[?2004h> series['vol12'] = series['logret'].rolling(12).std()
[?2004l[?2004h> # get latest non-null values
[?2004l[?2004h> latest = series.dropna(subset=['Gold']).iloc[-1]
[?2004l[?2004h> print('latest period', latest['Period'])
[?2004l[?2004h> print('latest gold', latest['Gold'])
[?2004l[?2004h> print('latest logret', latest['logret'])
[?2004l[?2004h> print('latest vol3', latest['vol3'])
[?2004l[?2004h> print('latest vol12', latest['vol12'])
[?2004l[?2004h> # Jan-Sep 2025 average price
[?2004l[?2004h> avg_2025 = series[series['Period'].isin([f'2025M{i}' for i in range(1,10)])]['Gold'].mean()
[?2004l[?2004h> print('avg Jan-Sep 2025', avg_2025)
