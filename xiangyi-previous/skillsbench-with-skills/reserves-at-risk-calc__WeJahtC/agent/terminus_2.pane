[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> # values from Value sheet 2025 row
[?2004l[?2004h> values = {
[?2004l[?2004h>     'Belarus':7471,
[?2004l[?2004h>     'Georgia':1002,
[?2004l[?2004h>     'Moldova':10.71,
[?2004l[?2004h>     'Ukraine':3877.64,
[?2004l[?2004h>     'Uzbekistan':55092.42,
[?2004l[?2004h>     'Czechia':10121.89,
[?2004l[?2004h>     'Latvia':921.28,
[?2004l[?2004h>     'Lithuania':807.1
[?2004l[?2004h> }
[?2004l[?2004h> # average Jan-Sep 2025 gold price
[?2004l[?2004h> avg_price = 3202.8236082355647
[?2004l[?2004h> slovakia_volume = 1.019
[?2004l[?2004h> values['Slovakia'] = slovakia_volume * avg_price
[?2004l[?2004h> # volatility and z-score
[?2004l[?2004h> z = 1.645
[?2004l[?2004h> vol3 = 4.813322962293496  # percent
[?2004l[?2004h> vol3_ann = vol3 * (12**0.5)
[?2004l[?2004h> print('Slovakia value', values['Slovakia'])
[?2004l[?2004h> print('vol3', vol3, 'vol3_ann', vol3_ann)
[?2004l[?2004h> # compute exposures using vol3
[?2004l[?2004h> exposures = {k: v * (z*vol3/100) for k,v in values.items()}
[?2004l[?2004h> print('exposures (vol3):')
