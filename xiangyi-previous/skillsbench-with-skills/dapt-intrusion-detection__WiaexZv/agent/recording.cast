[55.946719, "i", "cat > analyze_pcap.py << 'EOF'\nimport math\nfrom collections import defaultdict, Counter\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\nimport csv\n\n# Read pcap file\nprint(\"Reading pcap file...\")\npackets = rdpcap('packets.pcap')\nprint(f\"Loaded {len(packets)} packets\")\n\n# Initialize counters and data structures\nprotocol_counts = {'tcp': 0, 'udp': 0, 'icmp': 0, 'arp': 0, 'ip_total': 0}\ntimestamps = []\npacket_sizes = []\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\nip_graph_edges = set()  # (src_ip, dst_ip)\nip_src_set = set()\nip_dst_set = set()\nip_outdegree = defaultdict(set)  # src_ip -> set of dst_ips\nip_indegree = defaultdict(set)   # dst_ip -> set of src_ips\nip_bytes_sent = defaultdict(int)\nip_bytes_recv = defaultdict(int)\nflows = set()  # (src_ip, dst_ip, src_port, dst_port, protocol)\n\n# Parse packets\nfor pkt in packets:\n    # Timestamp\n    if hasattr(pkt, 'time'):\n        timestamps.append(float(pkt.time))\n    \n    # Packet size\n    packet_sizes.append(len(pkt))\n    \n    # Protocol counts\n    if IP in pkt:\n        protocol_counts['ip_total'] += 1\n        src_ip = pkt[IP].src\n        dst_ip = pkt[IP].dst\n        src_ips.append(src_ip)\n        dst_ips.append(dst_ip)\n        ip_src_set.add(src_ip)\n        ip_dst_set.add(dst_ip)\n        \n        # Graph edges\n        ip_graph_edges.add((src_ip, dst_ip))\n        ip_outdegree[src_ip].add(dst_ip)\n        ip_indegree[dst_ip].add(src_ip)\n        \n        # Bytes sent/received for PCR\n        ip_bytes_sent[src_ip] += len(pkt)\n        ip_bytes_recv[dst_ip] += len(pkt)\n        \n        if TCP in pkt:\n            protocol_counts['tcp'] += 1\n            src_port = pkt[TCP].sport\n            dst_port = pkt[TCP].dport\n            src_ports.append(src_port)\n            dst_ports.append(dst_port)\n            flows.add((src_ip, dst_ip, src_port, dst_port, 'tcp'))\n        elif UDP in pkt:\n            protocol_counts['udp'] += 1\n            src_port = pkt[UDP].sport\n            dst_port = pkt[UDP].dport\n            src_ports.append(src_port)\n            dst_ports.append(dst_port)\n            flows.add((src_ip, dst_ip, src_port, dst_port, 'udp'))\n        elif ICMP in pkt:\n            protocol_counts['icmp'] += 1\n    \n    if ARP in pkt:\n        protocol_counts['arp'] += 1\n\nprint(\"Computing statistics...\")\n\n# Time/Rate metrics\ntimestamps.sort()\nduration_seconds = timestamps[-1] - timestamps[0] if len(timestamps) > 1 else 0\n\n# Packets per minute buckets\nif duration_seconds > 0:\n    bucket_size = 60.0  # 60 seconds\n    min_time = timestamps[0]\n    packets_per_bucket = defaultdict(int)\n    for ts in timestamps:\n        bucket = int((ts - min_time) / bucket_size)\n        packets_per_bucket[bucket] += 1\n    \n    bucket_counts = list(packets_per_bucket.values())\n    packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0\n    packets_per_minute_max = max(bucket_counts) if bucket_counts else 0\n    packets_per_minute_min = min(bucket_counts) if bucket_counts else 0\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\n# Size statistics\ntotal_bytes = sum(packet_sizes)\navg_packet_size = total_bytes / len(packet_sizes) if packet_sizes else 0\nmin_packet_size = min(packet_sizes) if packet_sizes else 0\nmax_packet_size = max(packet_sizes) if packet_sizes else 0\n\n# Shannon entropy function\ndef shannon_entropy(data):\n    if not data:\n        return 0.0\n    counts = Counter(data)\n    total = len(data)\n    entropy = 0.0\n    for count in counts.values():\n        p = count / total\n        if p > 0:\n            entropy -= p * math.log2(p)\n    return entropy\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\n# Graph metrics\nall_ips = ip_src_set | ip_dst_set\nnum_nodes = len(all_ips)\nnum_edges = len(ip_graph_edges)\nif num_nodes >= 2:\n    network_density = num_edges / (num_nodes * (num_nodes - 1))\nelse:\n    network_density = 0\n\nmax_out"]
[55.946795, "i", "degree = max(len(dsts) for dsts in ip_outdegree.values()) if ip_outdegree else 0\nmax_indegree = max(len(srcs) for srcs in ip_indegree.values()) if ip_indegree else 0\n\n# Inter-arrival times\niats = []\nfor i in range(1, len(timestamps)):\n    iats.append(timestamps[i] - timestamps[i-1])\n\nif iats:\n    iat_mean = sum(iats) / len(iats)\n    iat_variance = sum((x - iat_mean) ** 2 for x in iats) / len(iats)\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\n# Producer/Consumer Ratio\nnum_producers = 0\nnum_consumers = 0\nfor ip in all_ips:\n    sent = ip_bytes_sent.get(ip, 0)\n    recv = ip_bytes_recv.get(ip, 0)\n    total = sent + recv\n    if total > 0:\n        pcr = (sent - recv) / total\n        if pcr > 0.2:\n            num_producers += 1\n        elif pcr < -0.2:\n            num_consumers += 1\n\n# Flow metrics\nunique_flows = len(flows)\ntcp_flows = sum(1 for f in flows if f[4] == 'tcp')\nudp_flows = sum(1 for f in flows if f[4] == 'udp')\n\n# Bidirectional flows\nbidirectional_flows = 0\nfor src_ip, dst_ip, src_port, dst_port, proto in flows:\n    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\n    if reverse in flows:\n        bidirectional_flows += 1\nbidirectional_flows = bidirectional_flows // 2  # Each pair counted twice\n\n# Analysis flags\nis_traffic_benign = 'true'\nhas_port_scan = 'false'\nhas_dos_pattern = 'false'\nhas_beaconing = 'false'\n\n# Port scan detection: high outdegree with many unique dst ports per src IP\nfor src_ip in ip_outdegree:\n    # Count unique dst ports from this src\n    dst_ports_from_src = set()\n    for src, dst, sp, dp, proto in flows:\n        if src == src_ip:\n            dst_ports_from_src.add(dp)\n    if len(dst_ports_from_src) > 100:  # Many ports contacted\n        has_port_scan = 'true'\n        is_traffic_benign = 'false'\n        break\n\n# DoS pattern: very high packet rate\nif packets_per_minute_max > 10000:  # Very high rate\n    has_dos_pattern = 'true'\n    is_traffic_benign = 'false'\n\n# Beaconing: low IAT coefficient of variation (regular intervals)\nif iat_cv < 0.3 and iat_mean > 0 and len(iats) > 10:\n    has_beaconing = 'true'\n    is_traffic_benign = 'false'\n\nprint(\"Writing results...\")\n\n# Read CSV and update values\nresults = {\n    'protocol_tcp': protocol_counts['tcp'],\n    'protocol_udp': protocol_counts['udp'],\n    'protocol_icmp': protocol_counts['icmp'],\n    'protocol_arp': protocol_counts['arp'],\n    'protocol_ip_total': protocol_counts['ip_total'],\n    'duration_seconds': duration_seconds,\n    'packets_per_minute_avg': packets_per_minute_avg,\n    'packets_per_minute_max': packets_per_minute_max,\n    'packets_per_minute_min': packets_per_minute_min,\n    'total_bytes': total_bytes,\n    'avg_packet_size': avg_packet_size,\n    'min_packet_size': min_packet_size,\n    'max_packet_size': max_packet_size,\n    'dst_port_entropy': dst_port_entropy,\n    'src_port_entropy': src_port_entropy,\n    'src_ip_entropy': src_ip_entropy,\n    'dst_ip_entropy': dst_ip_entropy,\n    'unique_dst_ports': unique_dst_ports,\n    'unique_src_ports': unique_src_ports,\n    'num_nodes': num_nodes,\n    'num_edges': num_edges,\n    'network_density': network_density,\n    'max_indegree': max_indegree,\n    'max_outdegree': max_outdegree,\n    'iat_mean': iat_mean,\n    'iat_variance': iat_variance,\n    'iat_cv': iat_cv,\n    'num_producers': num_producers,\n    'num_consumers': num_consumers,\n    'unique_flows': unique_flows,\n    'bidirectional_flows': bidirectional_flows,\n    'tcp_flows': tcp_flows,\n    'udp_flows': udp_flows,\n    'is_traffic_benign': is_traffic_benign,\n    'has_port_scan': has_port_scan,\n    'has_dos_pattern': has_dos_pattern,\n    'has_beaconing': has_beaconing,\n}\n\n# Read original CSV and update\nlines = []\nwith open('network_stats.csv', 'r') as f:\n    for line in f:\n        line = line.rstrip('\\n')\n        if line.startswith('#') or line == 'metric,value':\n            lines.append(line)\n        else:\n            parts = line.split(',')\n            if len(parts) == 2:\n                metric = parts[0]\n                if metric in result"]
[55.946852, "i", "s:\n                    value = results[metric]\n                    lines.append(f\"{metric},{value}\")\n                else:\n                    lines.append(line)\n            else:\n                lines.append(line)\n\n# Write back\nwith open('network_stats.csv', 'w') as f:\n    for line in lines:\n        f.write(line + '\\n')\n\nprint(\"Done!\")\nEOF\n"]
