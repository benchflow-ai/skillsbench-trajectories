[55.968566, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read original CSV and update\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.968599, "o", "lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.968756, "o", "with open('network_stats.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.968792, "o", "        line = line.rstrip('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.96888, "o", "        if line.startswith('#') or line == 'metric,value':\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.968947, "o", "> "]
[55.968985, "o", "            lines.append(line)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.96902, "o", "> "]
[55.969129, "o", "            parts = line.split(',')\r\n\u001b[?2004l\r\u001b[?2004h>             if len(parts) == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969199, "o", "                metric = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.969255, "o", "> "]
[55.96929, "o", "                if metric in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969357, "o", "                    value = results[metric]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969446, "o", "                    lines.append(f\"{metric},{value}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969513, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969576, "o", "                    lines.append(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969644, "o", "            else:\r\n\u001b[?2004l\r"]
[55.96968, "o", "\u001b[?2004h>                 lines.append(line)\r\n\u001b[?2004l\r"]
[55.969769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write back\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969837, "o", "with open('network_stats.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.969869, "o", "    for line in lines:\r\n\u001b[?2004l\r"]
[55.96995, "o", "\u001b[?2004h>         f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.970016, "o", "\u001b[?2004h> "]
