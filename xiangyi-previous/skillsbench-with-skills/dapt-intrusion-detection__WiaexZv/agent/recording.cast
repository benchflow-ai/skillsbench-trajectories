[55.953203, "o", "            flows.add((src_ip, dst_ip, src_port, dst_port, 'tcp'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.953281, "o", "        elif UDP in pkt:\r\n\u001b[?2004l\r\r\n#\u001b[?2004h"]
[55.953311, "o", "> "]
[55.953404, "o", "            protocol_counts['udp'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.95344, "o", "> "]
[55.953523, "o", "            src_port = pkt[UDP].sport\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.953559, "o", "> "]
[55.953645, "o", "            dst_port = pkt[UDP].dport\r\n\u001b[?2004l\r"]
[55.95368, "o", "\u001b[?2004h> "]
[55.953771, "o", "            src_ports.append(src_port)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.953806, "o", "> "]
[55.953891, "o", "            dst_ports.append(dst_port)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.953925, "o", "> "]
[55.954091, "o", "            flows.add((src_ip, dst_ip, src_port, dst_port, 'udp'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.954129, "o", "> "]
[55.954198, "o", "        elif ICMP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.954307, "o", "            protocol_counts['icmp'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.954341, "o", ">     \r\n\u001b[?2004l\ri\u001b[?2004h"]
[55.954404, "o", ">     if ARP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.95444, "o", "> "]
[55.954521, "o", "        protocol_counts['arp'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.954614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.954673, "o", "print(\"Computing statistics...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.954709, "o", "> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[55.95477, "o", "# Time/Rate metrics\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.95481, "o", "> "]
[55.95484, "o", "timestamps.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.954935, "o", "> "]
[55.95507, "o", "duration_seconds = timestamps[-1] - timestamps[0] if len(timestamps) > 1 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955107, "o", "> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[55.955175, "o", "# Packets per minute buckets\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955212, "o", "> "]
[55.955287, "o", "if duration_seconds > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.955361, "o", "    bucket_size = 60.0  # 60 seconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955396, "o", "> "]
[55.955457, "o", "    min_time = timestamps[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955491, "o", "> "]
[55.955586, "o", "    packets_per_bucket = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955621, "o", "> "]
[55.955684, "o", "    for ts in timestamps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955718, "o", "> "]
[55.955832, "o", "        bucket = int((ts - min_time) / bucket_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955868, "o", "> "]
[55.95594, "o", "        packets_per_bucket[bucket] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.955977, "o", ">     \r\n\u001b[?2004l\r"]
[55.956038, "o", "\u001b[?2004h> "]
[55.956129, "o", "    bucket_counts = list(packets_per_bucket.values())\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.956167, "o", "> "]
[55.956416, "o", "    packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.956617, "o", "    packets_per_minute_max = max(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.956652, "o", "> "]
[55.95683, "o", "    packets_per_minute_min = min(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.956867, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.956901, "o", "> "]
[55.957108, "o", "    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[55.957146, "o", "\u001b[?2004h> "]
[55.957213, "o", "# Size statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.957281, "o", "total_bytes = sum(packet_sizes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.957314, "o", "> "]
[55.957506, "o", "avg_packet_size = total_bytes / len(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.957669, "o", "min_packet_size = min(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.957704, "o", "> "]
[55.957831, "o", "max_packet_size = max(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r"]
[55.957868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[55.9579, "o", "\u001b[?2004h> "]
[55.957996, "o", "# Shannon entropy function\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958049, "o", "def shannon_entropy(data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958102, "o", "    if not data:\r\n\u001b[?2004l\r"]
[55.958167, "o", "\u001b[?2004h> "]
[55.958206, "o", "        return 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.95826, "o", "    counts = Counter(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.958301, "o", "> "]
[55.958334, "o", "    total = len(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958439, "o", "    entropy = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958499, "o", "    for count in counts.values():\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.958534, "o", "> "]
[55.958609, "o", "        p = count / total\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.958646, "o", "> "]
[55.958684, "o", "        if p > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.958716, "o", "> "]
[55.958845, "o", "            entropy -= p * math.log2(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958882, "o", "    return entropy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.958916, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.959028, "o", "src_ip_entropy = shannon_entropy(src_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.959061, "o", "> "]
[55.959148, "o", "dst_ip_entropy = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.959183, "o", "> "]
[55.959291, "o", "src_port_entropy = shannon_entropy(src_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.959322, "o", "> "]
[55.959446, "o", "dst_port_entropy = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.959479, "o", "> "]
[55.959569, "o", "unique_src_ports = len(set(src_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.959604, "o", "> "]
[55.959684, "o", "unique_dst_ports = len(set(dst_ports))\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.95972, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[55.959794, "o", "# Graph metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.959865, "o", "all_ips = ip_src_set | ip_dst_set\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.9599, "o", "> "]
[55.959972, "o", "num_nodes = len(all_ips)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.960049, "o", "num_edges = len(ip_graph_edges)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.960083, "o", "> "]
[55.960143, "o", "if num_nodes >= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.960314, "o", "    network_density = num_edges / (num_nodes * (num_nodes - 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.960349, "o", "> else:\r\n\u001b[?2004l\r"]
[55.960414, "o", "\u001b[?2004h> "]
[55.960449, "o", "    network_density = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.960482, "o", "\u001b[?2004h> "]
[55.960726, "o", "max_outdegree = max(len(dsts) for dsts in ip_outdegree.values()) if ip_outdegree else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.960932, "o", "max_indegree = max(len(srcs) for srcs in ip_indegree.values()) if ip_indegree else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.960966, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[55.961046, "o", "# Inter-arrival times\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.961079, "o", "iats = []\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[55.961178, "o", "for i in range(1, len(timestamps)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.961213, "o", "> "]
[55.961328, "o", "    iats.append(timestamps[i] - timestamps[i-1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.961362, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[55.961397, "o", "if iats:\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[55.961431, "o", "> "]
[55.961541, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.961637, "o", "    iat_variance = sum((x - iat_mean) ** 2 for x in iats) / len(iats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.961675, "o", "> "]
[55.961748, "o", "    iat_std = math.sqrt(iat_variance)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.961808, "o", "    iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.961841, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.961903, "o", ">     iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r"]
[55.961961, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962017, "o", "# Producer/Consumer Ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962053, "o", "num_producers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962087, "o", "num_consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962179, "o", "for ip in all_ips:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962214, "o", "    sent = ip_bytes_sent.get(ip, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962284, "o", "    recv = ip_bytes_recv.get(ip, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962341, "o", "    total = sent + recv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962378, "o", "    if total > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962443, "o", "        pcr = (sent - recv) / total\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.962481, "o", "> "]
[55.962515, "o", "        if pcr > 0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962631, "o", "            num_producers += 1\r\n\u001b[?2004l\r\u001b[?2004h>         elif pcr < -0.2:\r\n\u001b[?2004l\r"]
[55.962665, "o", "\u001b[?2004h> "]
[55.962729, "o", "            num_consumers += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962764, "o", "# Flow metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962822, "o", "unique_flows = len(flows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.962907, "o", "tcp_flows = sum(1 for f in flows if f[4] == 'tcp')\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.962943, "o", "> "]
[55.963012, "o", "udp_flows = sum(1 for f in flows if f[4] == 'udp')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.963048, "o", "\u001b[?2004h> "]
[55.963083, "o", "# Bidirectional flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963178, "o", "bidirectional_flows = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963235, "o", "for src_ip, dst_ip, src_port, dst_port, proto in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963319, "o", "    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.963355, "o", "> "]
[55.963388, "o", "    if reverse in flows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963481, "o", "        bidirectional_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.96357, "o", "bidirectional_flows = bidirectional_flows // 2  # Each pair counted twice\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.963605, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963669, "o", "# Analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963705, "o", "is_traffic_benign = 'true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.96378, "o", "has_port_scan = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963817, "o", "has_dos_pattern = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.963879, "o", "has_beaconing = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.963916, "o", "\u001b[?2004h> "]
[55.964027, "o", "# Port scan detection: high outdegree with many unique dst ports per src IP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.964084, "o", "for src_ip in ip_outdegree:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.964152, "o", "    # Count unique dst ports from this src\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.964186, "o", "> "]
[55.964219, "o", "    dst_ports_from_src = set()\r\n\u001b[?2004l\r"]
[55.964254, "o", "\u001b[?2004h> "]
[55.96436, "o", "    for src, dst, sp, dp, proto in flows:\r\n\u001b[?2004l\r\u001b[?2004h>         if src == src_ip:\r\n\u001b[?2004l\r"]
[55.964394, "o", "\u001b[?2004h> "]
[55.964462, "o", "            dst_ports_from_src.add(dp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.964551, "o", "    if len(dst_ports_from_src) > 100:  # Many ports contacted\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.964585, "o", "> "]
[55.96465, "o", "        has_port_scan = 'true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.964711, "o", "        is_traffic_benign = 'false'\r\n\u001b[?2004l\r"]
[55.964746, "o", "\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.964812, "o", "> # DoS pattern: very high packet rate\r\n\u001b[?2004l\r"]
[55.964844, "o", "\u001b[?2004h> "]
[55.964915, "o", "if packets_per_minute_max > 10000:  # Very high rate\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.964986, "o", "> "]
[55.965023, "o", "    has_dos_pattern = 'true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.96509, "o", "    is_traffic_benign = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965176, "o", "# Beaconing: low IAT coefficient of variation (regular intervals)\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.96521, "o", "> "]
[55.965273, "o", "if iat_cv < 0.3 and iat_mean > 0 and len(iats) > 10:\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.965307, "o", "> "]
[55.965341, "o", "    has_beaconing = 'true'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965429, "o", "    is_traffic_benign = 'false'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965481, "o", "print(\"Writing results...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.965515, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965587, "o", "# Read CSV and update values\r\n\u001b[?2004l\r\u001b[?2004h> results = {\r\n\u001b[?2004l\r"]
[55.965626, "o", "\u001b[?2004h> "]
[55.965702, "o", "    'protocol_tcp': protocol_counts['tcp'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965755, "o", "    'protocol_udp': protocol_counts['udp'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.96579, "o", "> "]
[55.96585, "o", "    'protocol_icmp': protocol_counts['icmp'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.965925, "o", "    'protocol_arp': protocol_counts['arp'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.965959, "o", "> "]
[55.966024, "o", "    'protocol_ip_total': protocol_counts['ip_total'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.966059, "o", "> "]
[55.96614, "o", "    'duration_seconds': duration_seconds,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.966196, "o", "    'packets_per_minute_avg': packets_per_minute_avg,\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.966233, "o", "> "]
[55.966301, "o", "    'packets_per_minute_max': packets_per_minute_max,\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.966337, "o", "> "]
[55.966409, "o", "    'packets_per_minute_min': packets_per_minute_min,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.966457, "o", "    'total_bytes': total_bytes,\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.966492, "o", "> "]
[55.966547, "o", "    'avg_packet_size': avg_packet_size,\r\n\u001b[?2004l\r\u001b[?2004h> "]
