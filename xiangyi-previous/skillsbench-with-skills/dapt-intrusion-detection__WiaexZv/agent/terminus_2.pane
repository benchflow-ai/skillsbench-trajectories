[?2004l_[?2004h> # Shannon entropy function
[?2004l[?2004h> def shannon_entropy(data):
[?2004l[?2004h>     if not data:
[?2004l[?2004h>         return 0.0
[?2004l[?2004h>     counts = Counter(data)
[?2004l[?2004h>     total = len(data)
[?2004l[?2004h>     entropy = 0.0
[?2004l[?2004h>     for count in counts.values():
[?2004l[?2004h>         p = count / total
[?2004l[?2004h>         if p > 0:
[?2004l[?2004h>             entropy -= p * math.log2(p)
[?2004l[?2004h>     return entropy
[?2004l[?2004h> 
[?2004l[?2004h> src_ip_entropy = shannon_entropy(src_ips)
[?2004l[?2004h> dst_ip_entropy = shannon_entropy(dst_ips)
