[?2004l[?2004h> 
[?2004lo[?2004h> # Packets per minute buckets
[?2004l[?2004h> if duration_seconds > 0:
[?2004l[?2004h>     bucket_size = 60.0  # 60 seconds
[?2004l[?2004h>     min_time = timestamps[0]
[?2004l[?2004h>     packets_per_bucket = defaultdict(int)
[?2004l[?2004h>     for ts in timestamps:
[?2004l[?2004h>         bucket = int((ts - min_time) / bucket_size)
[?2004l[?2004h>         packets_per_bucket[bucket] += 1
[?2004l[?2004h>     
[?2004l[?2004h>     bucket_counts = list(packets_per_bucket.values())
[?2004l[?2004h>     packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0
[?2004l[?2004h>     packets_per_minute_max = max(bucket_counts) if bucket_counts else 0
[?2004l[?2004h>     packets_per_minute_min = min(bucket_counts) if bucket_counts else 0
[?2004l[?2004h> else:
