[139.079082, "o", "=== COMPLETE OFFER LETTER ===\r\n\r\n"]
[139.07932, "o", "EMPLOYMENT OFFER\r\n"]
[139.079427, "o", "Nexus Technologies Inc.\r\n"]
[139.079574, "o", "Date: January 15, 2024\r\n"]
[139.079645, "o", "Sarah Chen\r\n"]
[139.079715, "o", "456 Oak Avenue, Apt 7B\r\n"]
[139.079939, "o", "San Jose, CA 95123\r\n"]
[139.080065, "o", "RE: Offer of Employment - Senior Software Engineer\r\n"]
[139.080216, "o", "Dear Sarah Chen,\r\n"]
[139.080403, "o", "We are pleased to extend an offer of employment for the position of Senior Software Engineer in our Platform Engineering department.\r\n"]
[139.080544, "o", "Employment Details:\r\n"]
[139.080605, "o", "Relocation Assistance:\r\n"]
[139.080729, "o", "You are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\n"]
[139.080825, "o", "You will receive 20 days of PTO annually.\r\n"]
[139.081037, "o", "Please respond by January 22, 2024.\r\n"]
[139.081145, "o", "Sincerely,\r\n"]
[139.081242, "o", "Jennifer Walsh\r\n"]
[139.081305, "o", "Director of Human Resources\r\n"]
[139.081399, "o", "Nexus Technologies Inc.\r\n\r\n=== EMPLOYMENT DETAILS TABLES ===\r\n"]
[139.08189, "o", "  Position: | Senior Software Engineer\r\n"]
[139.08212, "o", "  Department: | Platform Engineering\r\n"]
[139.082312, "o", "  Start Date: | February 12, 2024\r\n"]
[139.082501, "o", "  Reports To: | Michael Rodriguez\r\nBasic Information:\r\n"]
[139.082817, "o", "  Base Salary: | $185,000 per year\r\n"]
[139.083013, "o", "  Sign-on Bonus: | $25,000\r\n"]
[139.083196, "o", "  Equity Grant: | 5,000 shares\r\nCompensation:\r\n"]
[139.15654, "o", "\u001b[?2004hroot@263c65acd4c0:~# "]
