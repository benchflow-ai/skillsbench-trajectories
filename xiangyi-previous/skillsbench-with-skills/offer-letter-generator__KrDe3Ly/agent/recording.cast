[106.017463, "o", "      Cell: '${{BASE_SALARY}} per year'\r\n"]
[106.017549, "o", "      Cell: 'Sign-on Bonus:'\r\n"]
[106.017595, "o", "      Cell: '${{SIGNING_BONUS}}'\r\n"]
[106.017676, "o", "      Cell: 'Equity Grant:'\r\n"]
