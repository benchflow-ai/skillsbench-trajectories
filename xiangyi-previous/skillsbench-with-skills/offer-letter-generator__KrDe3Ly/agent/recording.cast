[64.305265, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[64.393477, "o", "=== OFFER LETTER CONTENT ===\r\n"]
[64.393623, "o", "EMPLOYMENT OFFER\r\n"]
[64.393683, "o", "Nexus Technologies Inc.\r\n\r\n"]
[64.393774, "o", "Date: January 15, 2024\r\n\r\n"]
[64.393824, "o", "Sarah Chen\r\n"]
[64.393855, "o", "456 Oak Avenue, Apt 7B\r\n"]
[64.393983, "o", "San Jose, CA 95123\r\n\r\n"]
[64.394052, "o", "RE: Offer of Employment - Senior Software Engineer\r\n"]
[64.394103, "o", "\r\n"]
[64.394153, "o", "Dear Sarah Chen,\r\n\r\n"]
[64.394256, "o", "We are pleased to extend an offer of employment for the position of Senior Software Engineer in our Platform Engineering department.\r\n"]
[64.394322, "o", "\r\nEmployment Details:\r\n\r\n"]
[64.39437, "o", "Relocation Assistance:\r\n"]
[64.394448, "o", "You are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\n\r\n"]
[64.394502, "o", "You will receive 20 days of PTO annually.\r\n"]
[64.394546, "o", "\r\n"]
[64.394626, "o", "Please respond by January 22, 2024.\r\n\r\n"]
[64.39467, "o", "\r\n"]
[64.39472, "o", "Sincerely,\r\n\r\n"]
[64.394757, "o", "Jennifer Walsh\r\n"]
[64.394807, "o", "Director of Human Resources\r\n"]
[64.394847, "o", "Nexus Technologies Inc.\r\n\r\n=== TABLE CONTENT ===\r\n"]
[64.395068, "o", "Basic Information:\r\n"]
[64.395149, "o", "Compensation:\r\n"]
[64.41216, "o", "\u001b[?2004hroot@263c65acd4c0:~# "]
