[80.807699, "i", "python3 -c \"\nfrom docx import Document\ndoc = Document('offer_letter_template.docx')\nprint('=== TEMPLATE TABLE CONTENT ===')\nfor i, table in enumerate(doc.tables):\n    print(f'\\nTable {i+1}:')\n    for j, row in enumerate(table.rows):\n        print(f'  Row {j+1}:')\n        for k, cell in enumerate(row.cells):\n            for para in cell.paragraphs:\n                if para.text.strip():\n                    print(f'    Cell {k+1}: {repr(para.text)}')\n                # Also show runs to see if placeholders are split\n                runs_text = [r.text for r in para.runs if r.text]\n                if len(runs_text) > 1:\n                    print(f'      Runs: {runs_text}')\n\"\n"]
