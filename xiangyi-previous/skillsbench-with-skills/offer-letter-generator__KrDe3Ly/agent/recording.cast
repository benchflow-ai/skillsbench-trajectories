[6.54041, "o", "{\r\n    \"DOC_ID\": \"OFFER-2024-00847\",\r\n    \"COMPANY_NAME\": \"Nexus Technologies Inc.\",\r\n    \"DATE\": \"January 15, 2024\",\r\n    \"CANDIDATE_FULL_NAME\": \"Sarah Chen\",\r\n    \"STREET_ADDRESS\": \"456 Oak Avenue, Apt 7B\",\r\n    \"CITY\": \"San Jose\",\r\n    \"STATE\": \"CA\",\r\n    \"ZIP_CODE\": \"95123\",\r\n    \"POSITION\": \"Senior Software Engineer\",\r\n    \"DEPARTMENT\": \"Platform Engineering\",\r\n    \"START_DATE\": \"February 12, 2024\",\r\n    \"MANAGER_NAME\": \"Michael Rodriguez\",\r\n    \"BASE_SALARY\": \"185,000\",\r\n    \"SIGNING_BONUS\": \"25,000\",\r\n    \"EQUITY_SHARES\": \"5,000\",\r\n    \"RELOCATION_PACKAGE\": \"Yes\",\r\n    \"RELOCATION_AMOUNT\": \"15,000\",\r\n    \"RELOCATION_DAYS\": \"30\",\r\n    \"PTO_DAYS\": \"20\",\r\n    \"RESPONSE_DEADLINE\": \"January 22, 2024\",\r\n    \"HR_NAME\": \"Jennifer Walsh\",\r\n    \"HR_TITLE\": \"Director of Human Resources\"\r\n}\r\n"]
