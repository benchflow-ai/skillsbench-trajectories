[105.928134, "i", "python3 -c \"\nfrom docx import Document\ndoc = Document('offer_letter_template.docx')\nprint('=== CHECKING FOR NESTED TABLES ===')\nfor i, table in enumerate(doc.tables):\n    print(f'Table {i+1}:')\n    for row in table.rows:\n        for cell in row.cells:\n            if cell.tables:\n                print(f'  Found nested table with {len(cell.tables)} tables')\n                for nested in cell.tables:\n                    print(f'    Nested table has {len(nested.rows)} rows')\n                    for nrow in nested.rows:\n                        for ncell in nrow.cells:\n                            text = ''.join(p.text for p in ncell.paragraphs)\n                            if text.strip():\n                                print(f'      Cell: {repr(text)}')\n\"\n"]
