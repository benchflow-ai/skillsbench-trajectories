[21.961014, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv\u001b[0m\u001b[33m\r\n\u001b[0m"]
[22.012586, "o", "\u001b[?2004hroot@263c65acd4c0:~# "]
[38.061767, "i", "cat > fill_template.py << 'EOF'\nimport json\nfrom docx import Document\nimport re\n\n# Load employee data\nwith open('employee_data.json', 'r') as f:\n    data = json.load(f)\n\n# Open the template\ndoc = Document('offer_letter_template.docx')\n\ndef replace_placeholders(text, data):\n    \"\"\"Replace {{PLACEHOLDER}} patterns with values from data\"\"\"\n    for key, value in data.items():\n        placeholder = '{{' + key + '}}'\n        text = text.replace(placeholder, str(value))\n    return text\n\ndef handle_conditional(text, data):\n    \"\"\"Handle IF_RELOCATION conditional sections\"\"\"\n    if data.get('RELOCATION_PACKAGE', 'No') == 'Yes':\n        # Keep content but remove markers\n        text = text.replace('{{IF_RELOCATION}}', '')\n        text = text.replace('{{END_IF_RELOCATION}}', '')\n    else:\n        # Remove the entire conditional section\n        pattern = r'\\{\\{IF_RELOCATION\\}\\}.*?\\{\\{END_IF_RELOCATION\\}\\}'\n        text = re.sub(pattern, '', text, flags=re.DOTALL)\n    return text\n\ndef process_paragraph(paragraph, data):\n    \"\"\"Process a single paragraph\"\"\"\n    full_text = ''.join(run.text for run in paragraph.runs)\n    new_text = handle_conditional(full_text, data)\n    new_text = replace_placeholders(new_text, data)\n    \n    if full_text != new_text:\n        # Clear existing runs and add new text\n        if paragraph.runs:\n            # Preserve formatting from first run\n            first_run = paragraph.runs[0]\n            for run in paragraph.runs:\n                run.text = ''\n            first_run.text = new_text\n\n# Process all paragraphs in the document\nfor paragraph in doc.paragraphs:\n    process_paragraph(paragraph, data)\n\n# Process tables if any\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                process_paragraph(paragraph, data)\n\n# Save the result\ndoc.save('/root/offer_letter_filled.docx')\nprint('Offer letter saved to /root/offer_letter_filled.docx')\nEOF\n"]
