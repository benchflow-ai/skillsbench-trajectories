[138.983093, "i", "python3 -c \"\nfrom docx import Document\n\ndef print_table(table, indent=0):\n    prefix = '  ' * indent\n    for row in table.rows:\n        row_data = []\n        for cell in row.cells:\n            cell_text = ' '.join(p.text.strip() for p in cell.paragraphs if p.text.strip())\n            if cell_text:\n                row_data.append(cell_text)\n            for nested in cell.tables:\n                print_table(nested, indent + 1)\n        if row_data:\n            print(prefix + ' | '.join(row_data))\n\ndoc = Document('/root/offer_letter_filled.docx')\nprint('=== COMPLETE OFFER LETTER ===')\nprint()\nfor para in doc.paragraphs:\n    if para.text.strip():\n        print(para.text)\n\nprint('\\n=== EMPLOYMENT DETAILS TABLES ===')\nfor table in doc.tables:\n    print_table(table)\n\"\n"]
