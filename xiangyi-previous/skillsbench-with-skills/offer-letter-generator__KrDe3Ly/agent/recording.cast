[47.153674, "o", "EMPLOYMENT OFFER\r\n"]
[47.157062, "o", "Nexus Technologies Inc.\r\nDate: January 15, 2024\r\nSarah Chen\r\n456 Oak Avenue, Apt 7B\r\nSan Jose, CA 95123\r\nRE: Offer of Employment - Senior Software Engineer\r\nDear Sarah Chen,\r\nWe are pleased to extend an offer of employment for the position of Senior Software Engineer in our Platform Engineering department.\r\nEmployment Details:\r\nRelocation Assistance:\r\nYou are eligible for a relocation package of $15,000. This includes moving expenses and temporary housing for 30 days.\r\nYou will receive 20 days of PTO annually.\r\nPlease respond by January 22, 2024.\r\nSincerely,\r\nJennifer Walsh\r\nDirector of Human Resources\r\nNexus Technologies Inc.\r\nBasic Information:\r\nCompensation:\r\n"]
[47.174347, "o", "\u001b[?2004hroot@263c65acd4c0:~# "]
[55.87582, "i", "python3 -c \"\nfrom docx import Document\ndoc = Document('/root/offer_letter_filled.docx')\nall_text = []\nfor para in doc.paragraphs:\n    all_text.append(para.text)\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for para in cell.paragraphs:\n                all_text.append(para.text)\nfull_text = '\\n'.join(all_text)\nif '{{' in full_text:\n    print('WARNING: Unreplaced placeholders found:')\n    import re\n    placeholders = re.findall(r'\\{\\{[^}]+\\}\\}', full_text)\n    for p in set(placeholders):\n        print(f'  {p}')\nelse:\n    print('SUCCESS: All placeholders have been replaced!')\n\"\n"]
[55.876011, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
