[?2004l[?2004h>         # Keep content but remove markers
[?2004l[?2004h>         text = text.replace('{{IF_RELOCATION}}', '')
[?2004l[?2004h>         text = text.replace('{{END_IF_RELOCATION}}', '')
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Remove the entire conditional section
[?2004l[?2004h>         pattern = r'\{\{IF_RELOCATION\}\}.*?\{\{END_IF_RELOCATION\}\}'
[?2004l[?2004h>         text = re.sub(pattern, '', text, flags=re.DOTALL)
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> def process_paragraph(paragraph, data):
[?2004l[?2004h>     """Process a single paragraph"""
