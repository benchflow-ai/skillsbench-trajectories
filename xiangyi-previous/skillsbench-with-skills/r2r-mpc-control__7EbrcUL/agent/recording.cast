[66.335908, "i", "python3 << 'EOF'\nimport json\n\n# Check a few entries from control_log\nwith open('/root/control_log.json', 'r') as f:\n    log = json.load(f)\n    print(\"Sample control_log entries:\")\n    for i in [0, 50, 100, 250, 499]:\n        entry = log['data'][i]\n        print(f\"\\nEntry {i} (t={entry['time']:.3f}s):\")\n        print(f\"  T3: {entry['tensions'][2]:.2f}N (ref: {entry['references'][2]:.2f}N)\")\n        print(f\"  v3: {entry['velocities'][2]:.4f} (ref: {entry['references'][8]:.4f})\")\n        print(f\"  u3: {entry['control_inputs'][2]:.4f} N*m\")\n\nEOF\n"]
