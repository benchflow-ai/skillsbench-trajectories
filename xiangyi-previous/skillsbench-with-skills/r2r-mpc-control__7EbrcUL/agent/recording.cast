[36.040795, "o", "> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.040881, "o", "> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041008, "o", "MPC Controller for R2R Web Handling System\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041047, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041188, "o", "Derives linearized state-space model and implements MPC controller.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041221, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.041255, "o", "\u001b[?2004h> "]
[36.04129, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041395, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041446, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.041481, "o", "> "]
[36.041613, "o", "from scipy.linalg import solve_continuous_are, expm\r\n\u001b[?2004l\r"]
[36.041727, "o", "\u001b[?2004h> "]
[36.041786, "o", "from scipy.optimize import minimize\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.041831, "o", "> "]
[36.041878, "o", "sys.path.insert(0, '/root')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.041987, "o", "from r2r_simulator import R2RSimulator\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.042035, "o", "> \r\n\u001b[?2004l\r\"\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.042079, "o", "\u001b[?2004h> class R2RMPC:\r\n\u001b[?2004l\r"]
[36.042125, "o", "\u001b[?2004h> "]
[36.042223, "o", "    \"\"\"MPC Controller for R2R system.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.04227, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.042401, "o", "    def __init__(self, simulator, horizon_N=9):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.042487, "o", "        self.sim = simulator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.042609, "o", "        self.horizon_N = horizon_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.042727, "o", "        self.params = simulator.get_params()\r\n\u001b[?2004l\r"]
[36.042776, "o", "\u001b[?2004h> "]
[36.042865, "o", "        \r\n\u001b[?2004l\rr\u001b[?2004h>         # Extract parameters\r\n\u001b[?2004l\r"]
[36.042891, "o", "\u001b[?2004h> "]
[36.04305, "o", "        self.EA = self.params[\"EA\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.043211, "o", "        self.J = self.params[\"J\"]\r\n\u001b[?2004l\r"]
[36.043263, "o", "\u001b[?2004h> "]
[36.043423, "o", "        self.R = self.params[\"R\"]\r\n\u001b[?2004l\r"]
[36.043466, "o", "\u001b[?2004h"]
[36.043504, "o", "> "]
[36.043626, "o", "        self.fb = self.params[\"fb\"]\r\n\u001b[?2004l\r"]
[36.043663, "o", "\u001b[?2004h> "]
[36.04379, "o", "        self.L = self.params[\"L\"]\r\n\u001b[?2004l\r"]
[36.043819, "o", "\u001b[?2004h"]
[36.043881, "o", "> "]
[36.044352, "o", "        self.v0 = self.params[\"v0\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.044454, "o", "        self.dt = self.params[\"dt\"]\r\n\u001b[?2004l\r"]
[36.044495, "o", "\u001b[?2004h> "]
[36.044642, "o", "        self.num_sec = self.params[\"num_sections\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.044721, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.044809, "o", "        # Derive linearized model\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.044952, "o", "        self._derive_linearized_model()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.044995, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.045101, "o", "        # Design MPC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.045151, "o", "        self._design_mpc()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.045181, "o", "r\u001b[?2004h> "]
[36.045336, "o", "    def _compute_reference_operating_point(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.045525, "o", "        \"\"\"Compute steady-state reference at initial conditions.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.045669, "o", "        x_ref, u_ref = self.sim.get_reference(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.045756, "o", "        return x_ref, u_ref\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.04579, "o", "> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[36.045927, "o", "    def _derive_linearized_model(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.046149, "o", "        \"\"\"Derive linearized A and B matrices at initial operating point.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.046416, "o", "        x_ref, u_ref = self._compute_reference_operating_point()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.046449, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.046585, "o", "        # Numerical differentiation to get A and B matrices\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.04661, "o", "> "]
[36.046713, "o", "        nx = 12  # 6 tensions + 6 velocities\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.046735, "o", "> "]
[36.046841, "o", "        nu = 6   # 6 motor torques\r\n\u001b[?2004l\r"]
[36.046864, "o", "\u001b[?2004h> "]
[36.04689, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.046991, "o", "        self.A = np.zeros((nx, nx))\r\n\u001b[?2004l\r"]
[36.047023, "o", "\u001b[?2004h> "]
[36.047171, "o", "        self.B = np.zeros((nx, nu))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[36.047207, "o", "\u001b[?2004h> "]
[36.04732, "o", "        # Compute B matrix (input sensitivity)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.047386, "o", "        eps = 1e-6\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.047497, "o", "        for j in range(nu):\r\n\u001b[?2004l\rx\u001b[?2004h> "]
[36.047595, "o", "            u_pert = u_ref.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.047624, "o", "> "]
[36.047657, "o", "            u_pert[j] += eps\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.047677, "o", "> "]
[36.047705, "o", "            \r\n\u001b[?2004l\r"]
[36.047736, "o", "\u001b[?2004h> "]
[36.047882, "o", "            # Simulate one step with perturbed input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.047969, "o", "            x_test = x_ref.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.047988, "o", "> "]
[36.048142, "o", "            dx_du = self._compute_dynamics(x_test, u_pert)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.048163, "o", "> "]
[36.04827, "o", "            self.B[:, j] = dx_du / eps\r\n\u001b[?2004l\r"]
[36.048289, "o", "\u001b[?2004h> "]
[36.048314, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.048336, "o", "> "]
[36.048454, "o", "        # Compute A matrix (state sensitivity)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.048475, "o", "> "]
[36.048541, "o", "        for i in range(nx):\r\n\u001b[?2004l\r"]
[36.048561, "o", "\u001b[?2004h> "]
[36.048671, "o", "            x_pert = x_ref.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.04874, "o", "            x_pert[i] += eps\r\n\u001b[?2004l\r"]
[36.048758, "o", "\u001b[?2004h> "]
[36.048798, "o", "            \r\n\u001b[?2004l\rd"]
[36.048816, "o", "\u001b[?2004h> "]
[36.048968, "o", "            # Compute dynamics with perturbed state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.049171, "o", "            dx_dx = self._compute_dynamics(x_pert, u_ref)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.049398, "o", "            self.A[:, i] = (dx_dx - self._compute_dynamics(x_ref, u_ref)) / eps\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r "]
[36.049431, "o", "\u001b[?2004h> "]
[36.049553, "o", "        # Discretize: Ad = I + A*dt, Bd = B*dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.04969, "o", "        self.Ad = np.eye(nx) + self.A * self.dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.049812, "o", "        self.Bd = self.B * self.dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.049846, "o", "        \r\n\u001b[?2004l\rlo\u001b[?2004h"]
[36.04987, "o", "> "]
[36.050065, "o", "        print(f\"A matrix condition number: {np.linalg.cond(self.A):.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.050241, "o", "        print(f\"B matrix rank: {np.linalg.matrix_rank(self.B)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.050261, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h"]
[36.050288, "o", "> "]
[36.050374, "o", "    def _compute_dynamics(self, x, u):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.050396, "o", "> "]
[36.050605, "o", "        \"\"\"Compute state derivatives dx/dt given state x and input u.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.05067, "o", "        T = x[:6]\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.05069, "o", "> "]
[36.050746, "o", "        v = x[6:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.050791, "o", "> "]
[36.050846, "o", "        u = np.array(u)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.050866, "o", "> "]
[36.050888, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.050908, "o", "> "]
[36.051018, "o", "        v0 = self.v0  # Inlet velocity\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.051037, "o", "> "]
[36.051062, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.051082, "o", "> "]
[36.051158, "o", "        # Tension dynamics\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.051176, "o", "> "]
[36.051307, "o", "        v_prev = np.concatenate([[v0], v[:-1]])\r\n\u001b[?2004l\r"]
[36.051329, "o", "\u001b[?2004h> "]
[36.051462, "o", "        T_prev = np.concatenate([[0], T[:-1]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.05148, "o", "> "]
[36.051622, "o", "        dT_dt = (self.EA / self.L) * (v - v_prev) + \\\r\n\u001b[?2004l\r"]
[36.05164, "o", "\u001b[?2004h> "]
[36.051804, "o", "                (1 / self.L) * (v_prev * T_prev - v * T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.051841, "o", "        \r\n\u001b[?2004l\r_\u001b[?2004h"]
[36.051865, "o", "> "]
[36.051931, "o", "        # Velocity dynamics\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.05196, "o", "> "]
[36.052084, "o", "        T_next = np.concatenate([T[1:], [0]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.052105, "o", "> "]
[36.052257, "o", "        dv_dt = (self.R**2 / self.J) * (T_next - T) + \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.05243, "o", "                (self.R / self.J) * u - (self.fb / self.J) * v\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.052449, "o", "> "]
[36.052469, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.052488, "o", "> "]
[36.052605, "o", "        return np.concatenate([dT_dt, dv_dt])\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.052624, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[36.052717, "o", "    def _design_mpc(self):\r\n\u001b[?2004l\r"]
[36.052737, "o", "\u001b[?2004h> "]
[36.052892, "o", "        \"\"\"Design MPC controller with Q and R matrices.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.052944, "o", "        nx = 12\r\n\u001b[?2004l\r"]
[36.052964, "o", "\u001b[?2004h> "]
[36.053008, "o", "        nu = 6\r\n\u001b[?2004l\rt\u001b[?2004h"]
[36.053031, "o", ">         "]
[36.053053, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.053157, "o", "        # Design Q and R matrices\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.053179, "o", "> "]
[36.053298, "o", "        # Penalize tension errors more heavily\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.053316, "o", "> "]
[36.053536, "o", "        Q_diag = np.array([100.0] * 6 + [0.1] * 6)  # Tension: 100, Velocity: 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.05369, "o", "        R_diag = np.array([0.033] * 6)  # Control effort\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.053708, "o", "> "]
[36.05374, "o", "        \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[36.053833, "o", "        self.Q = np.diag(Q_diag)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.053851, "o", "> "]
[36.053937, "o", "        self.R = np.diag(R_diag)\r\n\u001b[?2004l\ro\u001b[?2004h"]
[36.053955, "o", "> "]
[36.053975, "o", "        \r\n\u001b[?2004l\r"]
[36.053995, "o", "\u001b[?2004h> "]
[36.054108, "o", "        # Compute LQR gain for terminal cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.054125, "o", "> "]
[36.054158, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.05435, "o", "            P = solve_continuous_are(self.A, self.B, self.Q, self.R)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.054367, "o", "> "]
[36.054527, "o", "            self.K_lqr = np.linalg.inv(self.R) @ self.B.T @ P\r\n\u001b[?2004l\r"]
[36.05455, "o", "\u001b[?2004h> "]
[36.054687, "o", "            print(f\"LQR gain computed successfully\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.054749, "o", "        except:\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.054858, "o", "> "]
[36.054922, "o", "            # Fallback to simple proportional gain\r\n\u001b[?2004l\r"]
[36.054942, "o", "\u001b[?2004h> "]
[36.055104, "o", "            self.K_lqr = np.zeros((nu, nx))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.055182, "o", "            for i in range(nu):\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[36.055302, "o", "                self.K_lqr[i, i] = 0.1\r\n\u001b[?2004l\r') a\u001b[?2004h> "]
[36.055486, "o", "            print(f\"Using fallback LQR gain\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.055519, "o", "> "]
[36.055559, "o", "        # Store parameters\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.055586, "o", "> "]
[36.055684, "o", "        self.Q_diag = Q_diag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.055769, "o", "        self.R_diag = R_diag\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.055791, "o", ".\u001b[?2004h> "]
[36.055955, "o", "    def compute_control(self, x, t_idx):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.056045, "o", "        \"\"\"Compute MPC control input.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.056179, "o", "        x_ref, u_ref = self.sim.get_reference(t_idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.056201, "o", "        \r\n\u001b[?2004l\r"]
[36.056224, "o", "\u001b[?2004h> "]
[36.056312, "o", "        # Simple MPC: use LQR feedback around reference\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.056333, "o", "> "]
[36.056361, "o", "        dx = x - x_ref\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.056385, "o", "> "]
[36.056429, "o", "        u = u_ref - self.K_lqr @ dx\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.056452, "o", ">         \r\n\u001b[?2004l\r"]
[36.056473, "o", "\u001b[?2004h> "]
[36.056562, "o", "        # Clamp control inputs to reasonable bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.056616, "o", "        u = np.clip(u, -10, 10)\r\n\u001b[?2004l\r"]
[36.056635, "o", "\u001b[?2004h> "]
[36.05666, "o", "        \r\n\u001b[?2004l\r"]
[36.056689, "o", "\u001b[?2004h> "]
[36.056708, "o", "        return u\r\n\u001b[?2004l\r"]
[36.056726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.056746, "o", "\u001b[?2004h> "]
[36.056811, "o", "    def get_controller_params(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.056832, "o", "> "]
[36.056908, "o", "        \"\"\"Return controller parameters for saving.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.056926, "o", "> "]
[36.056949, "o", "        return {\r\n\u001b[?2004l\r"]
[36.05698, "o", "\u001b[?2004h> "]
[36.057027, "o", "            \"horizon_N\": self.horizon_N,\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057046, "o", "> "]
[36.057111, "o", "            \"Q_diag\": self.Q_diag.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057131, "o", "> "]
[36.05719, "o", "            \"R_diag\": self.R_diag.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057208, "o", "> "]
[36.05727, "o", "            \"K_lqr\": self.K_lqr.tolist(),\r\n\u001b[?2004l\r"]
[36.05729, "o", "\u001b[?2004h> "]
[36.057354, "o", "            \"A_matrix\": self.A.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057376, "o", "> "]
[36.057429, "o", "            \"B_matrix\": self.B.tolist()\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057448, "o", ">         }\r\n\u001b[?2004l\r"]
[36.057465, "o", "\u001b[?2004h> \r\n"]
[36.057486, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[36.057507, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.057594, "o", "def run_controller(sim, controller, duration=5.0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057614, "o", "> "]
[36.057688, "o", "    \"\"\"Run controller through simulator and log data.\"\"\"\r\n\u001b[?2004l\r"]
[36.05771, "o", "\u001b[?2004h> "]
[36.057736, "o", "    log_data = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057754, "o", ">     \r\n\u001b[?2004l\r"]
[36.057773, "o", "\u001b[?2004h> "]
[36.05781, "o", "    x = sim.reset()\r\n\u001b[?2004l\r"]
[36.05783, "o", "\u001b[?2004h> "]
[36.05785, "o", "    t_idx = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.057869, "o", ">     \r\n\u001b[?2004l\r"]
[36.057893, "o", "\u001b[?2004h> "]
[36.05795, "o", "    num_steps = int(duration / sim.dt)\r\n\u001b[?2004l\r"]
[36.057967, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.057986, "o", "\u001b[?2004h> "]
[36.058043, "o", "    for step in range(num_steps):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.058071, "o", "> "]
[36.0581, "o", "        t = sim.get_time()\r\n\u001b[?2004l\r"]
[36.058119, "o", "\u001b[?2004h> "]
[36.058143, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.058185, "o", "        # Get reference\r\n\u001b[?2004l\r"]
[36.058204, "o", "\u001b[?2004h> "]
[36.058273, "o", "        x_ref, u_ref = sim.get_reference(t_idx)\r\n\u001b[?2004l\r"]
[36.058294, "o", "\u001b[?2004h> "]
[36.058314, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.058361, "o", "        # Compute control\r\n\u001b[?2004l\r"]
[36.058383, "o", "\u001b[?2004h> "]
[36.058451, "o", "        u = controller.compute_control(x, t_idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.058474, "o", ">         \r\n\u001b[?2004l\r"]
[36.058493, "o", "\u001b[?2004h> "]
[36.058535, "o", "        # Step simulator\r\n\u001b[?2004l\r"]
[36.058557, "o", "\u001b[?2004h> "]
[36.05859, "o", "        x = sim.step(u)\r\n\u001b[?2004l\r"]
[36.05861, "o", "\u001b[?2004h> "]
[36.058631, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.058667, "o", "        # Log data\r\n\u001b[?2004l\r"]
[36.058687, "o", "\u001b[?2004h> "]
[36.058718, "o", "        log_entry = {\r\n\u001b[?2004l\r"]
[36.058742, "o", "\u001b[?2004h> "]
[36.058804, "o", "            \"time\": float(t),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.058826, "o", "> "]
[36.058875, "o", "            \"tensions\": x[:6].tolist(),\r\n\u001b[?2004l\r"]
[36.058895, "o", "\u001b[?2004h> "]
[36.058952, "o", "            \"velocities\": x[6:].tolist(),\r\n\u001b[?2004l\r"]
[36.058971, "o", "\u001b[?2004h> "]
[36.059039, "o", "            \"control_inputs\": u.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.059064, "o", "> "]
[36.059114, "o", "            \"references\": x_ref.tolist()\r\n\u001b[?2004l\r"]
[36.059134, "o", "\u001b[?2004h> "]
[36.059156, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.059215, "o", "        log_data.append(log_entry)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.059234, "o", "> "]
[36.059256, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.05929, "o", "        t_idx += 1\r\n\u001b[?2004l\r"]
[36.059312, "o", "\u001b[?2004h> "]
[36.059331, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.05935, "o", "> "]
[36.059389, "o", "        if step % 100 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.059409, "o", "> "]
[36.059515, "o", "            print(f\"Step {step}/{num_steps}, t={t:.2f}s, T3={x[2]:.2f}N\")\r\n\u001b[?2004l\r"]
[36.059534, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.059564, "o", "\u001b[?2004h> "]
[36.059581, "o", "    return log_data\r\n\u001b[?2004l\r"]
[36.059599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.059618, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.059638, "o", "\u001b[?2004h> "]
[36.059698, "o", "def compute_metrics(log_data, sim):\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.059718, "o", "> "]
[36.05977, "o", "    \"\"\"Compute performance metrics.\"\"\"\r\n\u001b[?2004l\r"]
[36.05979, "o", "\u001b[?2004h> "]
[36.059884, "o", "    tensions = np.array([entry[\"tensions\"] for entry in log_data])\r\n\u001b[?2004l\r"]
[36.059903, "o", "\u001b[?2004h> "]
[36.059988, "o", "    times = np.array([entry[\"time\"] for entry in log_data])\r\n\u001b[?2004l\r"]
[36.06001, "o", "\u001b[?2004h> "]
[36.060148, "o", "    references = np.array([entry[\"references\"][:6] for entry in log_data])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.060171, "o", "\u001b[?2004h> "]
[36.06026, "o", "    # Steady-state error (after settling, last 1 second)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.060281, "o", "> "]
[36.060371, "o", "    settling_idx = int(len(log_data) * 0.8)  # Last 20% of data\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.060391, "o", "> "]
[36.060513, "o", "    ss_error = np.mean(np.abs(tensions[settling_idx:] - references[settling_idx:]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.060533, "o", ">     \r\n\u001b[?2004l\r"]
[36.060554, "o", "\u001b[?2004h> "]
[36.060643, "o", "    # Settling time (when error drops below 5% of step change)\r\n\u001b[?2004l\r"]
[36.060662, "o", "\u001b[?2004h> "]
[36.060717, "o", "    step_time_idx = int(0.5 / sim.dt)\r\n\u001b[?2004l\r"]
[36.060736, "o", "\u001b[?2004h> "]
[36.060811, "o", "    target_tension_3 = 44.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.06084, "o", "    initial_tension_3 = 20.0\r\n\u001b[?2004l\r"]
[36.060862, "o", "\u001b[?2004h> "]
[36.060988, "o", "    threshold = initial_tension_3 + 0.05 * (target_tension_3 - initial_tension_3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.061013, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.061064, "o", "    settling_time = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.061085, "o", "> "]
[36.061172, "o", "    for i in range(step_time_idx, len(tensions)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.061237, "o", "        if tensions[i, 2] >= threshold:\r\n\u001b[?2004l\r"]
[36.06126, "o", "\u001b[?2004h> "]
[36.061364, "o", "            settling_time = times[i] - 0.5  # Relative to step\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.061393, "o", "            break\r\n\u001b[?2004l\r"]
[36.061414, "o", "\u001b[?2004h> "]
[36.061455, "o", "    if settling_time is None:\r\n\u001b[?2004l\r"]
[36.061478, "o", "\u001b[?2004h> "]
[36.061538, "o", "        settling_time = times[-1] - 0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.06156, "o", ">     \r\n\u001b[?2004l\r"]
[36.061579, "o", "\u001b[?2004h> "]
[36.06162, "o", "    # Max and min tensions\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.06164, "o", "> "]
[36.061688, "o", "    max_tension = np.max(tensions)\r\n\u001b[?2004l\r"]
[36.061712, "o", "\u001b[?2004h> "]
[36.06176, "o", "    min_tension = np.min(tensions)\r\n\u001b[?2004l\r"]
[36.061782, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.061808, "o", "\u001b[?2004h> "]
[36.061829, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.06185, "o", "> "]
[36.06191, "o", "        \"steady_state_error\": float(ss_error),\r\n\u001b[?2004l\r"]
[36.061931, "o", "\u001b[?2004h> "]
[36.062003, "o", "        \"settling_time\": float(settling_time),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062023, "o", "> "]
[36.06209, "o", "        \"max_tension\": float(max_tension),\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062109, "o", "> "]
[36.062166, "o", "        \"min_tension\": float(min_tension)\r\n\u001b[?2004l\r"]
[36.062187, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[36.062216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.062238, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062259, "o", "> "]
[36.06228, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.062357, "o", "    print(\"Initializing R2R Simulator...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062377, "o", "> "]
[36.06241, "o", "    sim = R2RSimulator()\r\n\u001b[?2004l\r"]
[36.062434, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.062458, "o", "\u001b[?2004h> "]
[36.062549, "o", "    print(\"Deriving linearized model and designing MPC...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062568, "o", "> "]
[36.062627, "o", "    controller = R2RMPC(sim, horizon_N=9)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062645, "o", ">     \r\n\u001b[?2004l\r"]
[36.062664, "o", "\u001b[?2004h> "]
[36.062743, "o", "    print(\"Running controller for 5 seconds...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.062779, "o", "> "]
[36.06287, "o", "    log_data = run_controller(sim, controller, duration=5.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.06289, "o", ">     \r\n\u001b[?2004l\r"]
[36.062911, "o", "\u001b[?2004h> "]
[36.062977, "o", "    print(\"Computing performance metrics...\")\r\n\u001b[?2004l\r"]
[36.062999, "o", "\u001b[?2004h> "]
[36.063067, "o", "    metrics = compute_metrics(log_data, sim)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.063092, "o", ">     \r\n\u001b[?2004l\r"]
[36.063114, "o", "\u001b[?2004h> "]
[36.063169, "o", "    print(\"\\n=== Performance Metrics ===\")\r\n\u001b[?2004l\r"]
[36.063188, "o", "\u001b[?2004h> "]
[36.063298, "o", "    print(f\"Steady-state error: {metrics['steady_state_error']:.4f} N\")\r\n\u001b[?2004l\r"]
[36.063318, "o", "\u001b[?2004h> "]
[36.063411, "o", "    print(f\"Settling time: {metrics['settling_time']:.4f} s\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.063431, "o", "> "]
[36.063513, "o", "    print(f\"Max tension: {metrics['max_tension']:.4f} N\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.063535, "o", "> "]
[36.063612, "o", "    print(f\"Min tension: {metrics['min_tension']:.4f} N\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.06363, "o", ">     \r\n\u001b[?2004l\r"]
[36.06365, "o", "\u001b[?2004h> "]
[36.063686, "o", "    # Save outputs\r\n\u001b[?2004l\r"]
[36.063708, "o", "\u001b[?2004h> "]
[36.063759, "o", "    print(\"\\nSaving output files...\")\r\n\u001b[?2004l\r"]
[36.063778, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[36.063797, "o", "\u001b[?2004h> "]
[36.063884, "o", "    with open('/root/controller_params.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.063904, "o", "> "]
[36.064003, "o", "        json.dump(controller.get_controller_params(), f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.064034, "o", ">     \r\n\u001b[?2004l\r"]
[36.064055, "o", "\u001b[?2004h> "]
[36.06414, "o", "    with open('/root/control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.064266, "o", "        json.dump({\"phase\": \"control\", \"data\": log_data}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.064285, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.064305, "o", "> "]
[36.064379, "o", "    with open('/root/metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.0644, "o", "> "]
[36.064453, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[36.064485, "o", "\u001b[?2004h>     "]
[36.064509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.066558, "o", "    print(\"Done! Output files saved.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.0666, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[36.08248, "o", "\u001b[?2004hroot@c01520149a9b:~# "]
[39.414002, "i", "python3 /root/mpc_controller.py\n"]
[39.414292, "o", "python3 /root/mpc_controller.py\r\n\u001b[?2004l\r"]
[40.105688, "o", "Initializing R2R Simulator...\r\n"]
[40.108379, "o", "Deriving linearized model and designing MPC...\r\n"]
[40.109207, "o", "A matrix condition number: 1.05e+07\r\n"]
[40.109322, "o", "B matrix rank: 6\r\n"]
[40.112846, "o", "LQR gain computed successfully\r\nRunning controller for 5 seconds...\r\n"]
[40.113004, "o", "Step 0/500, t=0.00s, T3=19.99N\r\n"]
[40.116719, "o", "Step 100/500, t=1.00s, T3=44.44N\r\n"]
[40.120667, "o", "Step 200/500, t=2.00s, T3=44.08N\r\n"]
[40.126519, "o", "Step 300/500, t=3.00s, T3=44.79N\r\n"]
[40.132957, "o", "Step 400/500, t=4.00s, T3=43.89N\r\n"]
[40.137553, "o", "Computing performance metrics...\r\n"]
[40.138109, "o", "\r\n=== Performance Metrics ===\r\nSteady-state error: 0.3533 N\r\nSettling time: 0.0500 s\r\nMax tension: 45.0947 N\r\nMin tension: 19.1449 N\r\n\r\nSaving output files...\r\n"]
[40.240049, "o", "Done! Output files saved.\r\n"]
[40.284503, "o", "\u001b[?2004hroot@c01520149a9b:~# "]
[56.482262, "i", "ls -lh /root/*.json\n"]
[56.482548, "o", "ls -lh /root/*.json\r\n\u001b[?2004l\r"]
[56.487068, "o", "-rw-r--r-- 1 root root 429K Jan 26 13:27 /root/control_log.json\r\n-rw-r--r-- 1 root root 6.6K Jan 26 13:27 /root/controller_params.json\r\n-rw-r--r-- 1 root root  161 Jan 26 13:27 /root/metrics.json\r\n-rw-r--r-- 1 root root  304 Jan 25 20:43 /root/system_config.json\r\n"]
[56.487271, "o", "\u001b[?2004hroot@c01520149a9b:~# "]
[56.638814, "i", "python3 << 'EOF'\nimport json\n\n# Verify controller_params.json\nwith open('/root/controller_params.json', 'r') as f:\n    params = json.load(f)\n    print(\"=== controller_params.json ===\")\n    print(f\"Keys: {list(params.keys())}\")\n    print(f\"horizon_N: {params['horizon_N']}\")\n    print(f\"Q_diag length: {len(params['Q_diag'])}\")\n    print(f\"R_diag length: {len(params['R_diag'])}\")\n    print(f\"K_lqr shape: {len(params['K_lqr'])}x{len(params['K_lqr'][0])}\")\n    print(f\"A_matrix shape: {len(params['A_matrix'])}x{len(params['A_matrix'][0])}\")\n    print(f\"B_matrix shape: {len(params['B_matrix'])}x{len(params['B_matrix'][0])}\")\n\n# Verify control_log.json\nwith open('/root/control_log.json', 'r') as f:\n    log = json.load(f)\n    print(\"\\n=== control_log.json ===\")\n    print(f\"Phase: {log['phase']}\")\n    print(f\"Number of data points: {len(log['data'])}\")\n    print(f\"First entry keys: {list(log['data'][0].keys())}\")\n    print(f\"First entry time: {log['data'][0]['time']}\")\n    print(f\"Last entry time: {log['data'][-1]['time']}\")\n    print(f\"Duration: {log['data'][-1]['time'] - log['data'][0]['time']:.2f}s\")\n    print(f\"First tensions: {log['data'][0]['tensions']}\")\n    print(f\"Last tensions: {log['data'][-1]['tensions']}\")\n\n# Verify metrics.json\nwith open('/root/metrics.json', 'r') as f:\n    metrics = json.load(f)\n    print(\"\\n=== metrics.json ===\")\n    print(f\"Keys: {list(metrics.keys())}\")\n    for key, value in metrics.items():\n        print(f\"{key}: {value}\")\n\nEOF\n"]
[56.639024, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[56.639098, "o", "\u001b[?2004h> import json\r\n"]
[56.639136, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639209, "o", "# Verify controller_params.json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639265, "o", "with open('/root/controller_params.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.639292, "o", "> "]
[56.639359, "o", "    params = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.639396, "o", ">     print(\"=== controller_params.json ===\")\r\n\u001b[?2004l\r"]
[56.639416, "o", "\u001b[?2004h> "]
[56.6395, "o", "    print(f\"Keys: {list(params.keys())}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639571, "o", "    print(f\"horizon_N: {params['horizon_N']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639679, "o", "    print(f\"Q_diag length: {len(params['Q_diag'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639764, "o", "    print(f\"R_diag length: {len(params['R_diag'])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.639917, "o", "    print(f\"K_lqr shape: {len(params['K_lqr'])}x{len(params['K_lqr'][0])}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
