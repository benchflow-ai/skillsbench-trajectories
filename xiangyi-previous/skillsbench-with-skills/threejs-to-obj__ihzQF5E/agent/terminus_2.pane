}
[?2004hroot@ae2e379e192b:~# cat > /root/convert.js << 'EOF'
[?2004l[?2004h> import * as THREE from 'three';
[?2004l[?2004h> import { createScene } from './data/object.js';
[?2004l[?2004h> import * as fs from 'fs';
[?2004l[?2004h> 
[?2004lt[?2004h> // Create the scene
[?2004l[?2004h> const scene = createScene();
[?2004l[?2004h> 
[?2004lo[?2004h> // Prepare output data
[?2004l[?2004h> const vertices = [];
[?2004ld[?2004h> const faces = [];
[?2004lte[?2004h> let vertexOffset = 1; // OBJ format uses 1-based indexing
[?2004ln[?2004h> 
[?2004l'[?2004h> // Matrix for converting Y-up (Three.js) to Z-up (Blender)
[?2004l)[?2004h> // This is a -90 degree rotation around X axis
[?2004l[?2004h> const yUpToZUp = new THREE.Matrix4();
[?2004l[?2004h> yUpToZUp.makeRotationX(-Math.PI / 2);
[?2004l[?2004h> 
[?2004ls[?2004h> // Traverse the scene and extract geometry
[?2004l[?2004h> scene.traverse((object) => {
[?2004l[?2004h>   if (object instanceof THREE.Mesh) {
[?2004l[?2004h>     // Get world matrix for this object
[?2004l[?2004h>     object.updateWorldMatrix(true, false);
[?2004l[?2004h>     const worldMatrix = object.matrixWorld.clone();
[?2004l[?2004h>     
[?2004l[?2004h>     // Apply Y-up to Z-up conversion
[?2004l[?2004h>     const finalMatrix = new THREE.Matrix4();
[?2004l[?2004h>     finalMatrix.multiplyMatrices(yUpToZUp, worldMatrix);
[?2004l[?2004h>     
[?2004l[?2004h>     const geometry = object.geometry;
[?2004l[?2004h>     
[?2004l[?2004h>     // Clone geometry to avoid modifying original
[?2004l[?2004h>     const geo = geometry.clone();
[?2004l[?2004h>     
[?2004l[?2004h>     // Apply the transformation matrix to the geometry
[?2004l[?2004h>     geo.applyMatrix4(finalMatrix);
[?2004l[?2004h>     
[?2004l[?2004h>     // Extract vertices
[?2004l[?2004h>     const positions = geo.attributes.position;
[?2004l[?2004h>     const startVertex = vertexOffset;
[?2004l[?2004h>     
[?2004l[?2004h>     for (let i = 0; i < positions.count; i++) {
[?2004l[?2004h>       const x = positions.getX(i);
[?2004l[?2004h>       const y = positions.getY(i);
[?2004l[?2004h>       const z = positions.getZ(i);
[?2004l[?2004h>       vertices.push(`v ${x} ${y} ${z}`);
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     // Extract faces
[?2004l[?2004h>     if (geo.index) {
[?2004l[?2004h>       // Indexed geometry
[?2004l[?2004h>       const indices = geo.index;
[?2004l[?2004h>       for (let i = 0; i < indices.count; i += 3) {
[?2004l[?2004h>         const a = indices.getX(i) + startVertex;
[?2004l[?2004h>         const b = indices.getX(i + 1) + startVertex;
[?2004l[?2004h>         const c = indices.getX(i + 2) + startVertex;
[?2004l[?2004h>         faces.push(`f ${a} ${b} ${c}`);
[?2004l[?2004h>       }
[?2004l[?2004h>     } else {
[?2004l[?2004h>       // Non-indexed geometry
[?2004l[?2004h>       for (let i = 0; i < positions.count; i += 3) {
[?2004l[?2004h>         const a = i + startVertex;
[?2004l[?2004h>         const b = i + 1 + startVertex;
[?2004l[?2004h>         const c = i + 2 + startVertex;
[?2004l[?2004h>         faces.push(`f ${a} ${b} ${c}`);
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     vertexOffset += positions.count;
[?2004l[?2004h>   } else if (object instanceof THREE.InstancedMesh) {
[?2004l[?2004h>     // Handle instanced meshes
[?2004l[?2004h>     const instanceCount = object.count;
[?2004l[?2004h>     const geometry = object.geometry;
[?2004l[?2004h>     
[?2004l[?2004h>     // Get world matrix for the InstancedMesh object itself
[?2004l[?2004h>     object.updateWorldMatrix(true, false);
[?2004l[?2004h>     const baseWorldMatrix = object.matrixWorld.clone();
[?2004l[?2004h>     
[?2004l[?2004h>     for (let instanceId = 0; instanceId < instanceCount; instanceId++) {
[?2004l[?2004h>       // Get the instance matrix
