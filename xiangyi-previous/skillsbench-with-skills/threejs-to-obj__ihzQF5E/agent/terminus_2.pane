[?2004l[?2004h>       const startVertex = vertexOffset;
[?2004l[?2004h>       
[?2004l[?2004h>       for (let i = 0; i < positions.count; i++) {
[?2004l[?2004h>         const x = positions.getX(i);
[?2004l[?2004h>         const y = positions.getY(i);
[?2004l[?2004h>         const z = positions.getZ(i);
[?2004l[?2004h>         vertices.push(`v ${x} ${y} ${z}`);
[?2004l[?2004h>       }
[?2004l[?2004h>       
[?2004l[?2004h>       // Extract faces
