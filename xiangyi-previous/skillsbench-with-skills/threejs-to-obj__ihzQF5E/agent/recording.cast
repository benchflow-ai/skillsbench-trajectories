[42.34574, "o", "        const c = i + 2 + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.345805, "o", "        faces.push(`f ${a} ${b} ${c}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.345853, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[42.345906, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.345961, "o", "    vertexOffset += positions.count;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346075, "o", "  } else if (object instanceof THREE.InstancedMesh) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346123, "o", "    // Handle instanced meshes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346201, "o", "    const instanceCount = object.count;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346274, "o", "    const geometry = object.geometry;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346323, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346413, "o", "    // Get world matrix for the InstancedMesh object itself\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346506, "o", "    object.updateWorldMatrix(true, false);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346598, "o", "    const baseWorldMatrix = object.matrixWorld.clone();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346652, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.346749, "o", "    for (let instanceId = 0; instanceId < instanceCount; instanceId++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.346803, "o", ">       // Get the instance matrix\r\n\u001b[?2004l\r"]
[42.346855, "o", "\u001b[?2004h> "]
[42.346912, "o", "      const instanceMatrix = new THREE.Matrix4();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347033, "o", "      object.getMatrixAt(instanceId, instanceMatrix);\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.347088, "o", "> "]
[42.347136, "o", "      // Combine base world matrix with instance matrix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347221, "o", "      const worldMatrix = new THREE.Matrix4();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.34736, "o", "      worldMatrix.multiplyMatrices(baseWorldMatrix, instanceMatrix);\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r"]
[42.34741, "o", "\u001b[?2004h> "]
[42.347461, "o", "      // Apply Y-up to Z-up conversion\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347538, "o", "      const finalMatrix = new THREE.Matrix4();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347716, "o", "      finalMatrix.multiplyMatrices(yUpToZUp, worldMatrix);\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347793, "o", "      // Clone geometry to avoid modifying original\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347864, "o", "      const geo = geometry.clone();\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r"]
[42.347915, "o", "\u001b[?2004h> "]
[42.347991, "o", "      // Apply the transformation matrix to the geometry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348054, "o", "      geo.applyMatrix4(finalMatrix);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348106, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348159, "o", "      // Extract vertices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348242, "o", "      const positions = geo.attributes.position;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348316, "o", "      const startVertex = vertexOffset;\r\n\u001b[?2004l\r"]
[42.348377, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348453, "o", "      for (let i = 0; i < positions.count; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348526, "o", "        const x = positions.getX(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348597, "o", "        const y = positions.getY(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348668, "o", "        const z = positions.getZ(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348756, "o", "        vertices.push(`v ${x} ${y} ${z}`);\r\n\u001b[?2004l\r"]
[42.348819, "o", "\u001b[?2004h> "]
[42.348876, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348928, "o", "      // Extract faces\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.348981, "o", "      if (geo.index) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349039, "o", "        // Indexed geometry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349113, "o", "        const indices = geo.index;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349207, "o", "        for (let i = 0; i < indices.count; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349305, "o", "          const a = indices.getX(i) + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349429, "o", "          const b = indices.getX(i + 1) + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349508, "o", "          const c = indices.getX(i + 2) + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349587, "o", "          faces.push(`f ${a} ${b} ${c}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.349636, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349684, "o", "      } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349733, "o", "        // Non-indexed geometry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349852, "o", "        for (let i = 0; i < positions.count; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349915, "o", "          const a = i + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.349991, "o", "          const b = i + 1 + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.35008, "o", "          const c = i + 2 + startVertex;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350155, "o", "          faces.push(`f ${a} ${b} ${c}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350206, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[42.350256, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.35032, "o", "      vertexOffset += positions.count;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350371, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.350421, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350479, "o", "// Write OBJ file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350529, "o", "const objContent = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350595, "o", "  '# OBJ file exported from Three.js',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350686, "o", "  '# Converted to Blender Z-up coordinate system',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350737, "o", "  '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350786, "o", "  ...vertices,\r\n\u001b[?2004l\r\u001b[?2004h>   '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350836, "o", "  ...faces\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350885, "o", "].join('\\n');\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.350983, "o", "fs.writeFileSync('/root/output/object.obj', objContent);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[42.351028, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[42.351067, "o", "console.log(`Export complete!`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.351182, "o", "console.log(`Vertices: ${vertices.length}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.351275, "o", "console.log(`Faces: ${faces.length}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.351354, "o", "console.log(`Output: /root/output/object.obj`);\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[42.352419, "o", "\u001b[?2004hroot@ae2e379e192b:~# "]
[48.280743, "i", "node /root/convert.js\n"]
[48.2811, "o", "node /root/convert.js\r\n\u001b[?2004l\r"]
[48.413389, "o", "Export complete!\r\n"]
[48.413829, "o", "Vertices: 4850\r\n"]
[48.414803, "o", "Faces: 8108\r\nOutput: /root/output/object.obj"]
[48.414871, "o", "\r\n"]
[48.427622, "o", "\u001b[?2004hroot@ae2e379e192b:~# "]
