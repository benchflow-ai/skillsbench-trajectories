[42.340274, "i", "cat > /root/convert.js << 'EOF'\nimport * as THREE from 'three';\nimport { createScene } from './data/object.js';\nimport * as fs from 'fs';\n\n// Create the scene\nconst scene = createScene();\n\n// Prepare output data\nconst vertices = [];\nconst faces = [];\nlet vertexOffset = 1; // OBJ format uses 1-based indexing\n\n// Matrix for converting Y-up (Three.js) to Z-up (Blender)\n// This is a -90 degree rotation around X axis\nconst yUpToZUp = new THREE.Matrix4();\nyUpToZUp.makeRotationX(-Math.PI / 2);\n\n// Traverse the scene and extract geometry\nscene.traverse((object) => {\n  if (object instanceof THREE.Mesh) {\n    // Get world matrix for this object\n    object.updateWorldMatrix(true, false);\n    const worldMatrix = object.matrixWorld.clone();\n    \n    // Apply Y-up to Z-up conversion\n    const finalMatrix = new THREE.Matrix4();\n    finalMatrix.multiplyMatrices(yUpToZUp, worldMatrix);\n    \n    const geometry = object.geometry;\n    \n    // Clone geometry to avoid modifying original\n    const geo = geometry.clone();\n    \n    // Apply the transformation matrix to the geometry\n    geo.applyMatrix4(finalMatrix);\n    \n    // Extract vertices\n    const positions = geo.attributes.position;\n    const startVertex = vertexOffset;\n    \n    for (let i = 0; i < positions.count; i++) {\n      const x = positions.getX(i);\n      const y = positions.getY(i);\n      const z = positions.getZ(i);\n      vertices.push(`v ${x} ${y} ${z}`);\n    }\n    \n    // Extract faces\n    if (geo.index) {\n      // Indexed geometry\n      const indices = geo.index;\n      for (let i = 0; i < indices.count; i += 3) {\n        const a = indices.getX(i) + startVertex;\n        const b = indices.getX(i + 1) + startVertex;\n        const c = indices.getX(i + 2) + startVertex;\n        faces.push(`f ${a} ${b} ${c}`);\n      }\n    } else {\n      // Non-indexed geometry\n      for (let i = 0; i < positions.count; i += 3) {\n        const a = i + startVertex;\n        const b = i + 1 + startVertex;\n        const c = i + 2 + startVertex;\n        faces.push(`f ${a} ${b} ${c}`);\n      }\n    }\n    \n    vertexOffset += positions.count;\n  } else if (object instanceof THREE.InstancedMesh) {\n    // Handle instanced meshes\n    const instanceCount = object.count;\n    const geometry = object.geometry;\n    \n    // Get world matrix for the InstancedMesh object itself\n    object.updateWorldMatrix(true, false);\n    const baseWorldMatrix = object.matrixWorld.clone();\n    \n    for (let instanceId = 0; instanceId < instanceCount; instanceId++) {\n      // Get the instance matrix\n      const instanceMatrix = new THREE.Matrix4();\n      object.getMatrixAt(instanceId, instanceMatrix);\n      \n      // Combine base world matrix with instance matrix\n      const worldMatrix = new THREE.Matrix4();\n      worldMatrix.multiplyMatrices(baseWorldMatrix, instanceMatrix);\n      \n      // Apply Y-up to Z-up conversion\n      const finalMatrix = new THREE.Matrix4();\n      finalMatrix.multiplyMatrices(yUpToZUp, worldMatrix);\n      \n      // Clone geometry to avoid modifying original\n      const geo = geometry.clone();\n      \n      // Apply the transformation matrix to the geometry\n      geo.applyMatrix4(finalMatrix);\n      \n      // Extract vertices\n      const positions = geo.attributes.position;\n      const startVertex = vertexOffset;\n      \n      for (let i = 0; i < positions.count; i++) {\n        const x = positions.getX(i);\n        const y = positions.getY(i);\n        const z = positions.getZ(i);\n        vertices.push(`v ${x} ${y} ${z}`);\n      }\n      \n      // Extract faces\n      if (geo.index) {\n        // Indexed geometry\n        const indices = geo.index;\n        for (let i = 0; i < indices.count; i += 3) {\n          const a = indices.getX(i) + startVertex;\n          const b = indices.getX(i + 1) + startVertex;\n          const c = indices.getX(i + 2) + startVertex;\n          faces.push(`f ${a} ${b} ${c}`);\n        }\n      } else {\n        // Non-indexed geometry\n        for (let i = 0; i < positions.count; i += 3) {\n          const a = i + startVertex;\n          const b = i + 1 + startVertex;\n          const c = i + 2 + st"]
[42.340344, "i", "artVertex;\n          faces.push(`f ${a} ${b} ${c}`);\n        }\n      }\n      \n      vertexOffset += positions.count;\n    }\n  }\n});\n\n// Write OBJ file\nconst objContent = [\n  '# OBJ file exported from Three.js',\n  '# Converted to Blender Z-up coordinate system',\n  '',\n  ...vertices,\n  '',\n  ...faces\n].join('\\n');\n\nfs.writeFileSync('/root/output/object.obj', objContent);\n\nconsole.log(`Export complete!`);\nconsole.log(`Vertices: ${vertices.length}`);\nconsole.log(`Faces: ${faces.length}`);\nconsole.log(`Output: /root/output/object.obj`);\nEOF\n"]
