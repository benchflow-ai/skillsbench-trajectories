[306.313318, "o", "\u001b[?2004h"]
[306.313348, "o", "> "]
[306.313437, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r"]
[306.313476, "o", "\u001b[?2004h> "]
[306.313507, "o", "    \r\n\u001b[?2004l\r"]
[306.31354, "o", "\u001b[?2004h"]
[306.313568, "o", "> "]
[306.313694, "o", "    with open('/app/output/schedule.csv', 'w') as f:\r\n\u001b[?2004l\r"]
[306.313744, "o", "\u001b[?2004h> "]
[306.313872, "o", "        f.write('job,op,machine,start,end,dur\\n')\r\n\u001b[?2004l\r"]
[306.313929, "o", "\u001b[?2004h> "]
