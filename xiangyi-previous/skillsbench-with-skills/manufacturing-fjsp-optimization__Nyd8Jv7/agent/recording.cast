[361.501344, "o", "> "]
[361.501736, "o", "    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\r\n\u001b[?2004l\r"]
[361.501789, "o", "\u001b[?2004h> "]
[361.501901, "o", "    scheduled = set()\r\n\u001b[?2004l\r"]
[361.501951, "o", "\u001b[?2004h> "]
[361.502093, "o", "    \r\n\u001b[?2004l\r"]
[361.502179, "o", "\u001b[?2004h> "]
[361.502231, "o", "    while len(scheduled) < len(all_ops):\r\n\u001b[?2004l\r"]
[361.502264, "o", "\u001b[?2004h> "]
[361.502374, "o", "        best = None\r\n\u001b[?2004l\r"]
[361.502405, "o", "\u001b[?2004h> "]
[361.502589, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r"]
[361.502619, "o", "\u001b[?2004h> "]
[361.502687, "o", "        \r\n\u001b[?2004l\r"]
[361.50272, "o", "\u001b[?2004h> "]
[361.504747, "o", "        for j, o in all_ops:\r\n\u001b[?2004l\r\u001b[?2004h>             if (j, o) in scheduled:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             if o > 0 and (j, o-1) not in scheduled:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             machine, duration = choices[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h>             prev_end = 0\r\n\u001b[?2004l\r\u001b[?2004h>             if o > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 for s in schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.505033, "o", "                    if s['job'] == j and s['op'] == o - 1:\r\n\u001b[?2004l\r"]
[361.505077, "o", "\u001b[?2004h> "]
[361.505305, "o", "                        prev_end = s['end']\r\n\u001b[?2004l\r"]
[361.505346, "o", "\u001b[?2004h> "]
[361.505511, "o", "                        break\r\n\u001b[?2004l\r"]
[361.505556, "o", "\u001b[?2004h> "]
[361.505634, "o", "            \r\n\u001b[?2004l\r"]
[361.505674, "o", "\u001b[?2004h> "]
[361.506008, "o", "            earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r"]
[361.506043, "o", "\u001b[?2004h> "]
[361.506631, "o", "            start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.50668, "o", "> "]
[361.50683, "o", "            if start < best_start:\r\n\u001b[?2004l\r"]
[361.506872, "o", "\u001b[?2004h> "]
[361.507168, "o", "                best = (j, o, machine, duration, start)\r\n\u001b[?2004l\r"]
[361.507221, "o", "\u001b[?2004h> "]
[361.507393, "o", "                best_start = start\r\n\u001b[?2004l\r"]
[361.507427, "o", "\u001b[?2004h> "]
[361.507482, "o", "        \r\n\u001b[?2004l\r"]
[361.507517, "o", "\u001b[?2004h> "]
[361.507625, "o", "        if best is None:\r\n\u001b[?2004l\r"]
[361.507667, "o", "\u001b[?2004h> "]
[361.507754, "o", "            return None\r\n\u001b[?2004l\r"]
[361.50779, "o", "\u001b[?2004h> "]
[361.507824, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.507859, "o", "> "]
[361.508033, "o", "        j, o, machine, duration, start = best\r\n\u001b[?2004l\r"]
[361.508066, "o", "\u001b[?2004h> "]
[361.508172, "o", "        schedule.append({\r\n\u001b[?2004l\r"]
[361.508216, "o", "\u001b[?2004h> "]
[361.508412, "o", "            'job': j, 'op': o, 'machine': machine,\r\n\u001b[?2004l\r"]
[361.508448, "o", "\u001b[?2004h> "]
[361.508747, "o", "            'start': start, 'end': start + duration, 'dur': duration\r\n\u001b[?2004l\r"]
[361.508785, "o", "\u001b[?2004h> "]
[361.508845, "o", "        })\r\n\u001b[?2004l\r"]
[361.508883, "o", "\u001b[?2004h> "]
[361.509238, "o", "        machine_available[machine] = start + duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.5094, "o", "        scheduled.add((j, o))\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.509441, "o", "> "]
[361.509479, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.509607, "o", "    return schedule\r\n\u001b[?2004l\r"]
[361.509645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.509679, "o", "\u001b[?2004h> "]
[361.509943, "o", "def evaluate(schedule, baseline_ops, downtime):\r\n\u001b[?2004l\r"]
[361.509982, "o", "\u001b[?2004h> "]
[361.510256, "o", "    makespan = max(op['end'] for op in schedule)\r\n\u001b[?2004l\r"]
[361.51029, "o", "\u001b[?2004h> "]
[361.510717, "o", "    changes = sum(1 for op in schedule if op['machine'] != baseline_ops[(op['job'], op['op'])]['machine'])\r\n\u001b[?2004l\r"]
[361.510757, "o", "\u001b[?2004h> "]
[361.518671, "o", "    shift = sum(abs(op['start'] - baseline_ops[(op['job'], op['op'])]['start']) for op in schedule)\r\n\u001b[?2004l\r"]
[361.518726, "o", "\u001b[?2004h> "]
[361.519333, "o", "    violations = sum(1 for op in schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtime))\r\n\u001b[?2004l\r"]
[361.519369, "o", "\u001b[?2004h> "]
[361.519655, "o", "    return makespan, changes, shift, violations\r\n\u001b[?2004l\r"]
[361.519693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.519732, "o", "\u001b[?2004h> "]
[361.520021, "o", "# Build all possible choices for each operation\r\n\u001b[?2004l\r"]
[361.520064, "o", "\u001b[?2004h> "]
[361.520154, "o", "all_choices = {}\r\n\u001b[?2004l\r"]
[361.52019, "o", "\u001b[?2004h> "]
[361.520361, "o", "for j in range(len(jobs)):\r\n\u001b[?2004l\r"]
[361.520407, "o", "\u001b[?2004h> "]
[361.520597, "o", "    for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[361.520635, "o", "\u001b[?2004h> "]
[361.520784, "o", "        key = (j, o)\r\n\u001b[?2004l\r"]
[361.520823, "o", "\u001b[?2004h> "]
[361.52098, "o", "        baseline_op = baseline_ops[key]\r\n\u001b[?2004l\r"]
[361.521018, "o", "\u001b[?2004h> "]
[361.521247, "o", "        alts = jobs[j][o]\r\n\u001b[?2004l\r"]
[361.521288, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.521378, "o", "        if key in frozen_must_change:\r\n"]
[361.521413, "o", "\u001b[?2004l\r"]
[361.521445, "o", "\u001b[?2004h> "]
[361.521565, "o", "            # Must use different machine\r\n"]
[361.521597, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.521826, "o", "            all_choices[key] = [(m, d) for m, d in alts if m != baseline_op['machine']]"]
[361.521859, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.521896, "o", "> "]
[361.521928, "o", "        else:\r\n\u001b[?2004l\r"]
[361.521959, "o", "\u001b[?2004h> "]
[361.522091, "o", "            all_choices[key] = alts\r\n\u001b[?2004l\r"]
[361.522141, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.522269, "o", "# Get baseline choice for each operation\r\n\u001b[?2004l\r"]
[361.522304, "o", "\u001b[?2004h> "]
[361.522354, "o", "baseline_choice = {}\r\n\u001b[?2004l\r"]
[361.522396, "o", "\u001b[?2004h> "]
[361.522507, "o", "for key, op in baseline_ops.items():\r\n"]
[361.522544, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.52265, "o", "    for m, d in jobs[key[0]][key[1]]:\r\n\u001b[?2004l\r"]
[361.522686, "o", "\u001b[?2004h> "]
[361.522776, "o", "        if m == op['machine']:\r\n\u001b[?2004l\r"]
[361.522809, "o", "\u001b[?2004h> "]
[361.522939, "o", "            baseline_choice[key] = (m, d)\r\n\u001b[?2004l\r"]
[361.522979, "o", "\u001b[?2004h> "]
[361.523028, "o", "            break\r\n\u001b[?2004l\r"]
[361.523061, "o", "\u001b[?2004h> "]
[361.523095, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.523296, "o", "# Operations that CAN be changed (not frozen, or frozen with violation)\r\n"]
[361.523327, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.523387, "o", "can_change = []\r\n\u001b[?2004l\r"]
[361.523427, "o", "\u001b[?2004h> "]
[361.523504, "o", "for key in all_choices:\r\n\u001b[?2004l\r"]
[361.523536, "o", "\u001b[?2004h> "]
[361.523638, "o", "    baseline_op = baseline_ops[key]\r\n"]
[361.523671, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.523772, "o", "    if key in frozen_must_change:\r\n"]
[361.523809, "o", "\u001b[?2004l\r\u001b[?2004h"]
[361.523839, "o", "> "]
[361.523927, "o", "        continue  # Already must change\r\n\u001b[?2004l\r"]
[361.523961, "o", "\u001b[?2004h> "]
[361.52412, "o", "    if baseline_op['start'] >= freeze_until:  # Not frozen\r\n"]
[361.524158, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.524261, "o", "        can_change.append(key)\r\n"]
[361.524294, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.524324, "o", "\u001b[?2004h> "]
[361.524457, "o", "print(f\"Can optionally change: {can_change}\")\r\n"]
[361.524489, "o", "\u001b[?2004l\r\u001b[?2004h"]
[361.524523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.524558, "o", "> "]
[361.524649, "o", "# Try different combinations of changes\r\n"]
[361.524678, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.524794, "o", "best_schedule = None\r\n\u001b[?2004l\r"]
[361.524826, "o", "\u001b[?2004h> "]
[361.524947, "o", "best_score = (float('inf'), float('inf'), float('inf'))\r\n\u001b[?2004l\r"]
[361.524988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.525133, "o", "\u001b[?2004h> "]
[361.525193, "o", "# Start with baseline + required changes\r\n\u001b[?2004l\r\u001b[?2004h> base = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.52526, "o", "for key in all_choices:\r\n\u001b[?2004l\r"]
[361.525309, "o", "\u001b[?2004h> "]
[361.525385, "o", "    if key in frozen_must_change:\r\n\u001b[?2004l\r"]
[361.525421, "o", "\u001b[?2004h> "]
[361.525609, "o", "        base[key] = all_choices[key][0]  # Use first alternative\r\n"]
[361.525649, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.52569, "o", "    else:\r\n\u001b[?2004l\r"]
[361.525729, "o", "\u001b[?2004h> "]
[361.525842, "o", "        base[key] = baseline_choice[key]\r\n\u001b[?2004l\r"]
[361.525881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.525975, "o", "\u001b[?2004h> "]
[361.526123, "o", "# Try adding 0 to (max_changes - len(frozen_must_change)) optional changes\r\n\u001b[?2004l\r"]
[361.526168, "o", "\u001b[?2004h> "]
[361.526338, "o", "remaining_budget = max_machine_changes - len(frozen_must_change)\r\n"]
[361.526384, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.526566, "o", "print(f\"Remaining change budget: {remaining_budget}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.526619, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.526723, "o", "for num_extra in range(remaining_budget + 1):\r\n\u001b[?2004l\r"]
[361.526769, "o", "\u001b[?2004h> "]
[361.526919, "o", "    for extra_ops in combinations(can_change, num_extra):\r\n\u001b[?2004l\r"]
[361.526961, "o", "\u001b[?2004h> "]
[361.527123, "o", "        # For each extra op, try all non-baseline alternatives\r\n\u001b[?2004l\r"]
[361.52717, "o", "\u001b[?2004h> "]
[361.527243, "o", "        alt_options = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.527284, "o", "> "]
[361.527342, "o", "        for key in extra_ops:\r\n"]
[361.527382, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.52752, "o", "            baseline_m = baseline_choice[key][0]\r\n\u001b[?2004l\r"]
[361.527561, "o", "\u001b[?2004h> "]
[361.527754, "o", "            non_baseline = [(m, d) for m, d in all_choices[key] if m != baseline_m]"]
[361.527799, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.527834, "o", "> "]
[361.527886, "o", "            if non_baseline:\r\n\u001b[?2004l\r"]
[361.527922, "o", "\u001b[?2004h> "]
[361.528123, "o", "                alt_options.append([(key, alt) for alt in non_baseline])\r\n"]
[361.528162, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.528207, "o", "        \r\n\u001b[?2004l\r"]
[361.528251, "o", "\u001b[?2004h> "]
[361.52837, "o", "        if len(alt_options) != len(extra_ops):\r\n\u001b[?2004l\r"]
[361.528407, "o", "\u001b[?2004h> "]
[361.528552, "o", "            continue  # Some ops have no alternatives\r\n"]
[361.528585, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.528619, "o", "        \r\n\u001b[?2004l\r"]
[361.528654, "o", "\u001b[?2004h> "]
[361.528742, "o", "        if not alt_options:\r\n\u001b[?2004l\r"]
[361.528767, "o", "\u001b[?2004h> "]
[361.528875, "o", "            alt_combos = [[]]\r\n\u001b[?2004l\r"]
[361.528902, "o", "\u001b[?2004h> "]
[361.529119, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.529158, "o", "            from itertools import product\r\n\u001b[?2004l\r"]
[361.529198, "o", "\u001b[?2004h> "]
[361.52936, "o", "            alt_combos = list(product(*alt_options))\r\n\u001b[?2004l\r"]
[361.529405, "o", "\u001b[?2004h> "]
[361.529445, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.529486, "o", "> "]
[361.529641, "o", "        for combo in alt_combos:\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.529703, "o", ">             choices = dict(base)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.529757, "o", "> "]
[361.529825, "o", "            for key, alt in combo:\r\n\u001b[?2004l\r"]
[361.52987, "o", "\u001b[?2004h> "]
[361.529962, "o", "                choices[key] = alt\r\n\u001b[?2004l\r"]
[361.530109, "o", "\u001b[?2004h> "]
[361.530162, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.530278, "o", "            schedule = schedule_with_choices(jobs, downtime, num_machines, choices)"]
[361.53032, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.530386, "o", "            if schedule:\r\n\u001b[?2004l\r"]
[361.530424, "o", "\u001b[?2004h> "]
[361.530666, "o", "                makespan, changes, shift, violations = evaluate(schedule, baseline_ops, downtime)\r\n"]
[361.530706, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.530763, "o", "                \r\n\u001b[?2004l\r"]
[361.530802, "o", "\u001b[?2004h> "]
[361.531152, "o", "                if violations == 0 and changes <= max_machine_changes and shift <= max_start_shift and makespan <= max_makespan:\r\n\u001b[?2004l\r"]
[361.531288, "o", "\u001b[?2004h> "]
[361.531329, "o", "                    if (makespan, changes, shift) < best_score:\r\n\u001b[?2004l\r"]
[361.53138, "o", "\u001b[?2004h> "]
[361.531551, "o", "                        best_score = (makespan, changes, shift)\r\n\u001b[?2004l\r"]
[361.531608, "o", "\u001b[?2004h> "]
[361.531726, "o", "                        best_schedule = schedule\r\n\u001b[?2004l\r"]
[361.531771, "o", "\u001b[?2004h> "]
[361.531996, "o", "                        print(f\"Found: makespan={makespan}, changes={changes}, shift={shift}\")"]
[361.532047, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.532093, "o", "\u001b[?2004h> "]
[361.532144, "o", "if best_schedule:\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.532196, "o", "> "]
[361.532279, "o", "    schedule = best_schedule\r\n\u001b[?2004l\r"]
[361.532329, "o", "\u001b[?2004h> "]
[361.532553, "o", "    makespan, changes, shift, violations = evaluate(schedule, baseline_ops, downtime)\r\n"]
[361.532601, "o", "\u001b[?2004l\r\u001b[?2004h>     "]
[361.532651, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.532845, "o", "    print(f\"\\nBest schedule:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.532944, "o", "    print(f\"  Makespan: {makespan}\")\r\n"]
[361.532992, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.533095, "o", "    print(f\"  Changes: {changes}\")\r\n\u001b[?2004l\r"]
[361.533136, "o", "\u001b[?2004h> "]
[361.533234, "o", "    print(f\"  Shift: {shift}\")\r\n"]
[361.533282, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.533393, "o", "    print(f\"  Violations: {violations}\")\r\n"]
[361.533452, "o", "\u001b[?2004l\r\u001b[?2004h>     "]
[361.533502, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.533695, "o", "    schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\r\n"]
[361.533749, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[361.533803, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.533884, "o", "    for op in schedule:\r\n\u001b[?2004l\r"]
[361.533937, "o", "\u001b[?2004h> "]
[361.534151, "o", "        baseline_op = baseline_ops[(op['job'], op['op'])]\r\n\u001b[?2004l\r"]
[361.534214, "o", "\u001b[?2004h> "]
[361.534343, "o", "        changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \""]
[361.534403, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.534698, "o", "        print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")"]
