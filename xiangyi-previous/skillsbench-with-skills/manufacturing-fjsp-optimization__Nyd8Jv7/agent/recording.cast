[438.456611, "i", "cat > /app/solve.py << 'EOF'\nimport json\nimport csv\nfrom itertools import combinations, product\n\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row['machine'])\n            s = int(row['start'])\n            e = int(row['end'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\njobs, num_machines = parse_instance('/app/data/instance.txt')\ndowntime = parse_downtime('/app/data/downtime.csv')\n\nwith open('/app/data/policy.json') as f:\n    policy = json.load(f)\nwith open('/app/data/baseline_solution.json') as f:\n    baseline = json.load(f)\n\nbaseline_ops = {(op['job'], op['op']): op for op in baseline['schedule']}\nfreeze_until = policy['freeze']['freeze_until']\nmax_machine_changes = policy['change_budget']['max_machine_changes']\nmax_start_shift = policy['change_budget']['max_total_start_shift_L1']\nmax_makespan = baseline['makespan'] * policy['guards']['max_makespan_ratio']\n\n# Find frozen ops with violations (must change)\nfrozen_must_change = set()\nfor key, op in baseline_ops.items():\n    if op['start'] < freeze_until and overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\n        frozen_must_change.add(key)\n\nprint(f\"Must change: {frozen_must_change}\")\nprint(f\"Max makespan: {max_makespan}, baseline: {baseline['makespan']}\")\n\ndef schedule_with_choices(choices):\n    machine_available = [0] * num_machines\n    schedule = []\n    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\n    scheduled = set()\n    \n    while len(scheduled) < len(all_ops):\n        best = None\n        best_start = float('inf')\n        \n        for j, o in all_ops:\n            if (j, o) in scheduled or (o > 0 and (j, o-1) not in scheduled):\n                continue\n            \n            machine, duration = choices[(j, o)]\n            prev_end = next((s['end'] for s in schedule if s['job'] == j and s['op'] == o-1), 0) if o > 0 else 0\n            earliest = max(machine_available[machine], prev_end)\n            start = get_available_start(machine, earliest, duration, downtime)\n            \n            if start < best_start:\n                best = (j, o, machine, duration, start)\n                best_start = start\n        \n        if best is None:\n            return None\n        \n        j, o, machine, duration, start = best\n        schedule.append({'job': j, 'op': o, 'machine': machine, 'start': start, 'end': start + duration, 'dur': duration})\n        "]
[438.456788, "i", "machine_available[machine] = start + duration\n        scheduled.add((j, o))\n    \n    return schedule\n\ndef evaluate(schedule):\n    makespan = max(op['end'] for op in schedule)\n    changes = sum(1 for op in schedule if op['machine'] != baseline_ops[(op['job'], op['op'])]['machine'])\n    shift = sum(abs(op['start'] - baseline_ops[(op['job'], op['op'])]['start']) for op in schedule)\n    violations = sum(1 for op in schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtime))\n    return makespan, changes, shift, violations\n\n# Get all alternatives for each operation\nall_alts = {}\nfor j in range(len(jobs)):\n    for o in range(len(jobs[j])):\n        key = (j, o)\n        baseline_op = baseline_ops[key]\n        if key in frozen_must_change:\n            all_alts[key] = [(m, d) for m, d in jobs[j][o] if m != baseline_op['machine']]\n        else:\n            all_alts[key] = jobs[j][o]\n\n# Baseline choice for each op\nbaseline_choice = {}\nfor key, op in baseline_ops.items():\n    for m, d in jobs[key[0]][key[1]]:\n        if m == op['machine']:\n            baseline_choice[key] = (m, d)\n            break\n\n# Ops that can optionally change\ncan_change = [key for key in all_alts if key not in frozen_must_change and baseline_ops[key]['start'] >= freeze_until]\n\nbest_schedule = None\nbest_score = (float('inf'), float('inf'), float('inf'))\n\nremaining_budget = max_machine_changes - len(frozen_must_change)\nprint(f\"Can change up to {remaining_budget} more operations\")\n\n# Try all combinations\nfor num_extra in range(remaining_budget + 1):\n    for extra_ops in combinations(can_change, num_extra):\n        # Build list of alternatives for each extra op\n        alt_lists = []\n        for key in extra_ops:\n            baseline_m = baseline_choice[key][0]\n            non_baseline = [(m, d) for m, d in all_alts[key] if m != baseline_m]\n            if non_baseline:\n                alt_lists.append([(key, alt) for alt in non_baseline])\n        \n        if len(alt_lists) != len(extra_ops):\n            continue\n        \n        combos = list(product(*alt_lists)) if alt_lists else [[]]\n        \n        for combo in combos:\n            choices = {}\n            for key in all_alts:\n                if key in frozen_must_change:\n                    choices[key] = all_alts[key][0]\n                else:\n                    choices[key] = baseline_choice.get(key, all_alts[key][0])\n            \n            for key, alt in combo:\n                choices[key] = alt\n            \n            schedule = schedule_with_choices(choices)\n            if schedule:\n                makespan, changes, shift, violations = evaluate(schedule)\n                \n                if violations == 0 and changes <= max_machine_changes and shift <= max_start_shift and makespan <= max_makespan:\n                    if makespan < best_score[0] or (makespan == best_score[0] and (changes, shift) < (best_score[1], best_score[2])):\n                        best_score = (makespan, changes, shift)\n                        best_schedule = schedule\n                        print(f\"Found: makespan={makespan}, changes={changes}, shift={shift}\")\n\nif best_schedule:\n    schedule = best_schedule\n    makespan, changes, shift, violations = evaluate(schedule)\n    \n    print(f\"\\nBest: makespan={makespan}, changes={changes}, shift={shift}\")\n    \n    schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\n    \n    for op in schedule:\n        baseline_op = baseline_ops[(op['job'], op['op'])]\n        changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \"\n        print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")\n    \n    solution = {\"status\": \"FEASIBLE\", \"makespan\": makespan, \"schedule\": schedule}\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w') as f:\n        f.write('job,op,machine,start,end,dur\\n')\n        for op in schedule:\n            f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\n    \n    prin"]
[438.456859, "i", "t(\"\\nSaved!\")\nelse:\n    print(\"No feasible solution!\")\nEOF\n"]
