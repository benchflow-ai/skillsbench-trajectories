[438.464376, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.464422, "o", "> "]
[438.464625, "o", "def overlaps_downtime(machine, start, end, downtime):\r\n\u001b[?2004l\r"]
[438.464673, "o", "\u001b[?2004h> "]
[438.464815, "o", "    if machine not in downtime:\r\n\u001b[?2004l\r"]
[438.46488, "o", "\u001b[?2004h> "]
[438.464943, "o", "        return False\r\n\u001b[?2004l\r"]
[438.464997, "o", "\u001b[?2004h> "]
[438.465165, "o", "    for ds, de in downtime[machine]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.465329, "o", "        if start < de and end > ds:\r\n\u001b[?2004l\r"]
[438.465378, "o", "\u001b[?2004h> "]
[438.465457, "o", "            return True\r\n\u001b[?2004l\r"]
[438.465505, "o", "\u001b[?2004h> "]
[438.465578, "o", "    return False\r\n\u001b[?2004l\r"]
[438.465628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.465674, "o", "> "]
[438.465942, "o", "def get_available_start(machine, earliest, duration, downtime):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.46603, "o", "    start = earliest\r\n\u001b[?2004l\r"]
[438.466087, "o", "\u001b[?2004h> "]
[438.466195, "o", "    if machine not in downtime:\r\n\u001b[?2004l\r"]
[438.466248, "o", "\u001b[?2004h> "]
[438.466319, "o", "        return start\r\n\u001b[?2004l\r"]
[438.466377, "o", "\u001b[?2004h> "]
[438.466474, "o", "    for _ in range(100):\r\n\u001b[?2004l\r"]
[438.466532, "o", "\u001b[?2004h> "]
[438.466656, "o", "        end = start + duration\r\n\u001b[?2004l\r"]
[438.466708, "o", "\u001b[?2004h> "]
[438.466799, "o", "        conflict = False\r\n\u001b[?2004l\r"]
[438.466847, "o", "\u001b[?2004h> "]
[438.46704, "o", "        for ds, de in sorted(downtime[machine]):\r\n\u001b[?2004l\r"]
[438.467089, "o", "\u001b[?2004h> "]
[438.467242, "o", "            if start < de and end > ds:\r\n\u001b[?2004l\r"]
[438.467289, "o", "\u001b[?2004h> "]
[438.467393, "o", "                start = de\r\n\u001b[?2004l\r"]
[438.467439, "o", "\u001b[?2004h> "]
[438.467573, "o", "                conflict = True\r\n\u001b[?2004l\r"]
[438.467619, "o", "\u001b[?2004h> "]
[438.467699, "o", "                break\r\n\u001b[?2004l\r"]
[438.467744, "o", "\u001b[?2004h> "]
[438.467863, "o", "        if not conflict:\r\n\u001b[?2004l\r"]
[438.467912, "o", "\u001b[?2004h> "]
[438.468004, "o", "            return start\r\n"]
[438.468049, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[438.468124, "o", "    return start\r\n\u001b[?2004l\r"]
[438.46817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.468214, "o", "> "]
[438.468439, "o", "jobs, num_machines = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r"]
[438.468487, "o", "\u001b[?2004h> "]
[438.468649, "o", "downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r"]
[438.468717, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.46887, "o", "with open('/app/data/policy.json') as f:\r\n\u001b[?2004l\r"]
[438.468918, "o", "\u001b[?2004h> "]
[438.469016, "o", "    policy = json.load(f)\r\n\u001b[?2004l\r"]
[438.469062, "o", "\u001b[?2004h> "]
[438.469237, "o", "with open('/app/data/baseline_solution.json') as f:\r\n\u001b[?2004l\r"]
[438.469285, "o", "\u001b[?2004h> "]
[438.469397, "o", "    baseline = json.load(f)\r\n\u001b[?2004l\r"]
[438.469443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.469724, "o", "baseline_ops = {(op['job'], op['op']): op for op in baseline['schedule']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.469778, "o", "> "]
[438.469941, "o", "freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.46999, "o", "> "]
[438.470221, "o", "max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.47027, "o", "> "]
[438.470486, "o", "max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r"]
[438.470537, "o", "\u001b[?2004h> "]
[438.470785, "o", "max_makespan = baseline['makespan'] * policy['guards']['max_makespan_ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.470834, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.471025, "o", "# Find frozen ops with violations (must change)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.471078, "o", "> "]
[438.471158, "o", "frozen_must_change = set()\r\n\u001b[?2004l\r"]
[438.471204, "o", "\u001b[?2004h> "]
[438.471346, "o", "for key, op in baseline_ops.items():\r\n\u001b[?2004l\r"]
[438.471393, "o", "\u001b[?2004h> "]
[438.471739, "o", "    if op['start'] < freeze_until and overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.471789, "o", "> "]
[438.471915, "o", "        frozen_must_change.add(key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.471964, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.472138, "o", "print(f\"Must change: {frozen_must_change}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.472188, "o", "> "]
[438.472423, "o", "print(f\"Max makespan: {max_makespan}, baseline: {baseline['makespan']}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.472472, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.472622, "o", "def schedule_with_choices(choices):\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.472671, "o", "> "]
[438.472829, "o", "    machine_available = [0] * num_machines\r\n\u001b[?2004l\r"]
[438.47288, "o", "\u001b[?2004h> "]
[438.472926, "o", "    schedule = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.472971, "o", "> "]
[438.47326, "o", "    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.473309, "o", "> "]
[438.473384, "o", "    scheduled = set()\r\n\u001b[?2004l\r"]
[438.473433, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[438.473479, "o", "\u001b[?2004h> "]
[438.47365, "o", "    while len(scheduled) < len(all_ops):\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.473699, "o", "> "]
[438.473746, "o", "        best = None\r\n"]
[438.473794, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[438.473946, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.473996, "o", ">         \r\n\u001b[?2004l\r"]
[438.474041, "o", "\u001b[?2004h> "]
[438.474177, "o", "        for j, o in all_ops:\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.474224, "o", "> "]
[438.474484, "o", "            if (j, o) in scheduled or (o > 0 and (j, o-1) not in scheduled):\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.474538, "o", "> "]
[438.474617, "o", "                continue\r\n\u001b[?2004l\r"]
[438.474666, "o", "\u001b[?2004h> "]
[438.474713, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.474911, "o", "            machine, duration = choices[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.474963, "o", "> "]
[438.475325, "o", "            prev_end = next((s['end'] for s in schedule if s['job'] == j and s['op'] == o-1), 0) if o > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.47538, "o", "> "]
[438.475584, "o", "            earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.475631, "o", "> "]
[438.475884, "o", "            start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.475931, "o", "> "]
[438.475977, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.476138, "o", "            if start < best_start:\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.476186, "o", "> "]
[438.47638, "o", "                best = (j, o, machine, duration, start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.476547, "o", "                best_start = start\r\n\u001b[?2004l\r"]
[438.476599, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[438.476647, "o", "\u001b[?2004h> "]
[438.476772, "o", "        if best is None:\r\n\u001b[?2004l\r"]
[438.476827, "o", "\u001b[?2004h> "]
[438.476906, "o", "            return None\r\n\u001b[?2004l\r"]
[438.476954, "o", "\u001b[?2004h> "]
[438.476999, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.477043, "o", "> "]
[438.477221, "o", "        j, o, machine, duration, start = best\r\n\u001b[?2004l\r"]
[438.477269, "o", "\u001b[?2004h> "]
[438.477647, "o", "        schedule.append({'job': j, 'op': o, 'machine': machine, 'start': start, 'end': start + duration, 'dur': duration})\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.477701, "o", "> "]
[438.47788, "o", "        machine_available[machine] = start + duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.477989, "o", "        scheduled.add((j, o))\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.478038, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.478104, "o", "    return schedule\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.478151, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.478216, "o", "def evaluate(schedule):\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.478261, "o", "> "]
[438.478368, "o", "    makespan = max(op['end'] for op in schedule)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.478587, "o", "    changes = sum(1 for op in schedule if op['machine'] != baseline_ops[(op['job'], op['op'])]['machine'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.478791, "o", "    shift = sum(abs(op['start'] - baseline_ops[(op['job'], op['op'])]['start']) for op in schedule)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.479012, "o", "    violations = sum(1 for op in schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtime))\r\n\u001b[?2004l\r"]
[438.479059, "o", "\u001b[?2004h> "]
[438.479122, "o", "    return makespan, changes, shift, violations\r\n\u001b[?2004l\r"]
[438.479168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.479276, "o", "# Get all alternatives for each operation\r\n\u001b[?2004l\r"]
[438.479321, "o", "\u001b[?2004h> all_alts = {}\r\n\u001b[?2004l\r"]
[438.47937, "o", "\u001b[?2004h> "]
[438.479415, "o", "for j in range(len(jobs)):\r\n\u001b[?2004l\r"]
[438.479461, "o", "\u001b[?2004h> "]
[438.479527, "o", "    for o in range(len(jobs[j])):\r\n\u001b[?2004l\r"]
[438.479572, "o", "\u001b[?2004h> "]
[438.479617, "o", "        key = (j, o)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.479662, "o", "> "]
[438.47974, "o", "        baseline_op = baseline_ops[key]\r\n\u001b[?2004l\r"]
[438.47979, "o", "\u001b[?2004h> "]
[438.479854, "o", "        if key in frozen_must_change:\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.479896, "o", "> "]
[438.480069, "o", "            all_alts[key] = [(m, d) for m, d in jobs[j][o] if m != baseline_op['machine']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.480115, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.480158, "o", "> "]
[438.480223, "o", "            all_alts[key] = jobs[j][o]\r\n\u001b[?2004l\r"]
[438.480268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.480312, "o", "> "]
[438.480361, "o", "# Baseline choice for each op\r\n\u001b[?2004l\r"]
[438.480406, "o", "\u001b[?2004h> "]
[438.480451, "o", "baseline_choice = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.480559, "o", "for key, op in baseline_ops.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.480604, "o", "> "]
[438.480664, "o", "    for m, d in jobs[key[0]][key[1]]:\r\n\u001b[?2004l\r"]
[438.480731, "o", "\u001b[?2004h> "]
[438.480784, "o", "        if m == op['machine']:\r\n\u001b[?2004l\r"]
[438.480829, "o", "\u001b[?2004h> "]
[438.480904, "o", "            baseline_choice[key] = (m, d)\r\n\u001b[?2004l\r"]
[438.48095, "o", "\u001b[?2004h> "]
[438.480995, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.481041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.481121, "o", "# Ops that can optionally change\r\n\u001b[?2004l\r"]
[438.481167, "o", "\u001b[?2004h> "]
[438.481419, "o", "can_change = [key for key in all_alts if key not in frozen_must_change and baseline_ops[key]['start'] >= freeze_until]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[438.481469, "o", "\u001b[?2004h> "]
[438.481518, "o", "best_schedule = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.48166, "o", "best_score = (float('inf'), float('inf'), float('inf'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.481706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.481846, "o", "remaining_budget = max_machine_changes - len(frozen_must_change)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.481991, "o", "print(f\"Can change up to {remaining_budget} more operations\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.482037, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.482082, "o", "# Try all combinations\r\n\u001b[?2004l\r"]
[438.482127, "o", "\u001b[?2004h> "]
[438.482229, "o", "for num_extra in range(remaining_budget + 1):\r\n\u001b[?2004l\r"]
[438.482278, "o", "\u001b[?2004h> "]
[438.482386, "o", "    for extra_ops in combinations(can_change, num_extra):\r\n\u001b[?2004l\r"]
[438.482435, "o", "\u001b[?2004h> "]
[438.482523, "o", "        # Build list of alternatives for each extra op\r\n\u001b[?2004l\r"]
[438.482569, "o", "\u001b[?2004h> "]
[438.482613, "o", "        alt_lists = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.482662, "o", "> "]
[438.482706, "o", "        for key in extra_ops:\r\n\u001b[?2004l\r"]
[438.482751, "o", "\u001b[?2004h> "]
[438.483571, "o", "            baseline_m = baseline_choice[key][0]\r\n\u001b[?2004l\r\u001b[?2004h>             non_baseline = [(m, d) for m, d in all_alts[key] if m != baseline_m]\r\n\u001b[?2004l\r\u001b[?2004h>             if non_baseline:\r\n\u001b[?2004l\r\u001b[?2004h>                 alt_lists.append([(key, alt) for alt in non_baseline])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if len(alt_lists) != len(extra_ops):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         combos = list(product(*alt_lists)) if alt_lists else [[]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.483698, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         for combo in combos:\r\n\u001b[?2004l\r\u001b[?2004h>             choices = {}\r\n\u001b[?2004l\r"]
[438.483739, "o", "\u001b[?2004h> "]
[438.483858, "o", "            for key in all_alts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.483924, "o", "                if key in frozen_must_change:\r\n\u001b[?2004l\r"]
[438.483958, "o", "\u001b[?2004h> "]
[438.484089, "o", "                    choices[key] = all_alts[key][0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.484128, "o", "> "]
[438.484199, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.484351, "o", "                    choices[key] = baseline_choice.get(key, all_alts[key][0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.484387, "o", ">             \r\n\u001b[?2004l\r"]
[438.484427, "o", "\u001b[?2004h> "]
[438.484537, "o", "            for key, alt in combo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.484604, "o", "                choices[key] = alt\r\n\u001b[?2004l\r"]
[438.484698, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.484844, "o", "            schedule = schedule_with_choices(choices)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.484912, "o", "            if schedule:\r\n\u001b[?2004l\r"]
[438.484948, "o", "\u001b[?2004h> "]
[438.485093, "o", "                makespan, changes, shift, violations = evaluate(schedule)\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.48513, "o", "> "]
[438.485166, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.4852, "o", "> "]
[438.48551, "o", "                if violations == 0 and changes <= max_machine_changes and shift <= max_start_shift and makespan <= max_makespan:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.485716, "o", "                    if makespan < best_score[0] or (makespan == best_score[0] and (changes, shift) < (best_score[1], best_score[2])):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.485843, "o", "                        best_score = (makespan, changes, shift)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.48588, "o", "                        best_schedule = schedule\r\n\u001b[?2004l\r"]
[438.485906, "o", "\u001b[?2004h"]
