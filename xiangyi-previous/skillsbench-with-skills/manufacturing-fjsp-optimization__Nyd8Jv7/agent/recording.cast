[124.948028, "o", "        for _ in range(num_ops):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.948323, "o", "            parts = list(map(int, lines[i].split()))\r\n\u001b[?2004l\r"]
[124.948396, "o", "\u001b[?2004h> "]
[124.948792, "o", "            i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.948831, "o", "            num_alts = parts[0]\r\n\u001b[?2004l\r"]
[124.948867, "o", "\u001b[?2004h> "]
[124.949101, "o", "            alternatives = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.949314, "o", "            idx = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.949486, "o", "            for _ in range(num_alts):\r\n\u001b[?2004l\r"]
[124.949541, "o", "\u001b[?2004h> "]
[124.9497, "o", "                machine = parts[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.949933, "o", "                duration = parts[idx + 1]\r\n\u001b[?2004l\r"]
[124.94999, "o", "\u001b[?2004h> "]
[124.950233, "o", "                alternatives.append((machine, duration))\r\n\u001b[?2004l\r"]
[124.950282, "o", "\u001b[?2004h> "]
[124.950472, "o", "                idx += 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.950629, "o", "            ops.append(alternatives)\r\n\u001b[?2004l\r"]
[124.950667, "o", "\u001b[?2004h> "]
[124.950806, "o", "        jobs.append(ops)\r\n\u001b[?2004l\r"]
[124.950836, "o", "\u001b[?2004h> "]
[124.951021, "o", "    return jobs, num_machines\r\n\u001b[?2004l\r"]
[124.951163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rw\u001b[?2004h> "]
[124.951388, "o", "def parse_downtime(filename):\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.951565, "o", "> "]
[124.951713, "o", "    downtime = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.951873, "o", "    with open(filename, 'r') as f:"]
[124.951985, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.95217, "o", "        reader = csv.DictReader(f)"]
[124.952275, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.952352, "o", "> "]
[124.952514, "o", "        for row in reader:"]
[124.952608, "o", "\r\n\u001b[?2004l\r"]
[124.952769, "o", "\u001b[?2004h> "]
[124.952941, "o", "            m = int(row['machine'])"]
[124.953041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.953148, "o", "> "]
[124.95332, "o", "            s = int(row['start'])"]
[124.953437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.953599, "o", "            e = int(row['end'])\r\n\u001b[?2004l\r"]
[124.95363, "o", "\u001b[?2004h> "]
[124.953819, "o", "            if m not in downtime:\r\n\u001b[?2004l\r"]
[124.953857, "o", "\u001b[?2004h> "]
[124.954057, "o", "                downtime[m] = []\r\n\u001b[?2004l\r"]
[124.954247, "o", "\u001b[?2004h> "]
[124.954413, "o", "            downtime[m].append((s, e))\r\n\u001b[?2004l\r"]
[124.954448, "o", "\u001b[?2004h>     return downtime\r\n\u001b[?2004l\r"]
[124.954491, "o", "\u001b[?2004h> "]
[124.954529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.954568, "o", "> "]
[124.954827, "o", "def parse_policy(filename):\r\n\u001b[?2004l\r"]
[124.954959, "o", "\u001b[?2004h> "]
[124.955092, "o", "    with open(filename, 'r') as f:"]
[124.955241, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.955366, "o", "> "]
[124.955418, "o", "        return json.load(f)\r\n\u001b[?2004l\r"]
[124.955453, "o", "\u001b[?2004h> "]
[124.955488, "o", "\r\n\u001b[?2004l\r"]
[124.955524, "o", "\u001b[?2004h> "]
[124.955805, "o", "def parse_baseline(filename):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.955904, "o", "    with open(filename, 'r') as f:\r\n\u001b[?2004l\r"]
[124.955944, "o", "\u001b[?2004h> "]
[124.95612, "o", "        return json.load(f)\r\n\u001b[?2004l\r"]
[124.956161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.95634, "o", "\u001b[?2004h> "]
[124.956482, "o", "def overlaps_downtime(machine, start, end, downtime):\r\n\u001b[?2004l\r"]
[124.956523, "o", "\u001b[?2004h> "]
[124.956728, "o", "    if machine not in downtime:\r\n\u001b[?2004l\r"]
[124.956758, "o", "\u001b[?2004h> "]
[124.956919, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.95708, "o", "> "]
[124.957177, "o", "    for ds, de in downtime[machine]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.957374, "o", "        if start < de and end > ds:\r\n\u001b[?2004l\r"]
[124.957414, "o", "\u001b[?2004h> "]
[124.957555, "o", "            return True\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.957591, "o", "> "]
[124.957733, "o", "    return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.958124, "o", "def get_available_start(machine, earliest, duration, downtime):\r\n\u001b[?2004l\r"]
[124.958159, "o", "\u001b[?2004h> "]
[124.958326, "o", "    start = earliest\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.958523, "o", "    if machine not in downtime:\r\n\u001b[?2004l\r"]
[124.958566, "o", "\u001b[?2004h> "]
[124.958702, "o", "        return start\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.958908, "o", ">     for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.959096, "o", "        end = start + duration\r\n\u001b[?2004l\r"]
[124.959141, "o", "\u001b[?2004h> "]
[124.959316, "o", "        conflict = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.959577, "o", "        for ds, de in sorted(downtime[machine]):\r\n\u001b[?2004l\r"]
[124.959611, "o", "\u001b[?2004h> "]
[124.959848, "o", "            if start < de and end > ds:\r\n\u001b[?2004l\r"]
[124.95989, "o", "\u001b[?2004h> "]
[124.960152, "o", "                start = de\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.960338, "o", "                conflict = True\r\n\u001b[?2004l\r"]
[124.960441, "o", "\u001b[?2004h> "]
[124.960564, "o", "                break\r\n\u001b[?2004l\r"]
[124.960845, "o", "\u001b[?2004h>         if not conflict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.961059, "o", "            return start\r\n\u001b[?2004l\r"]
[124.961313, "o", "\u001b[?2004h>     return start\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.961703, "o", "jobs, num_machines = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r"]
[124.961742, "o", "\u001b[?2004h> "]
[124.962087, "o", "downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r"]
[124.962486, "o", "\u001b[?2004h> policy = parse_policy('/app/data/policy.json')\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.962558, "o", "> "]
[124.962994, "o", "baseline = parse_baseline('/app/data/baseline_solution.json')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.963219, "o", "baseline_ops = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.963428, "o", "> for op in baseline['schedule']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.963609, "o", "    baseline_ops[(op['job'], op['op'])] = op\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.963771, "o", "> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[124.963951, "o", "freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.963989, "o", "> "]
[124.964406, "o", "max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.964904, "o", "max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.965304, "o", "max_makespan_ratio = policy['guards']['max_makespan_ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.965353, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[124.965754, "o", "# Build schedule using list scheduling with downtime avoidance\r\n\u001b[?2004l\r"]
[124.966098, "o", "\u001b[?2004h> "]
[124.966336, "o", "# Track: machine availability, job operation completion times\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.966572, "o", "> \r\n\u001b[?2004l\rh\u001b[?2004h> "]
[124.966834, "o", "def schedule_jobs(jobs, downtime, baseline_ops, freeze_until, num_machines):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.967007, "o", "    machine_available = [0] * num_machines\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.967056, "o", "> "]
[124.967587, "o", "    job_op_end = {j: 0 for j in range(len(jobs))}  # end time of last completed op for each job\r\n\u001b[?2004l\r"]
[124.967668, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.96797, "o", "    schedule = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.968273, "o", "    machine_changes = 0\r\n\u001b[?2004l\r"]
[124.968309, "o", "\u001b[?2004h> "]
[124.968476, "o", "    total_start_shift = 0\r\n\u001b[?2004l\r"]
[124.968512, "o", "\u001b[?2004h> "]
[124.968636, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.969036, "o", "    # Process operations in order: for each job, ops must be sequential\r\n\u001b[?2004l\r"]
[124.969071, "o", "\u001b[?2004h> "]
[124.969582, "o", "    # We'll use a priority queue approach: always schedule the earliest available operation\r\n\u001b[?2004l\r"]
[124.969613, "o", "\u001b[?2004h> "]
[124.969652, "o", "    \r\n\u001b[?2004l\r"]
[124.969692, "o", "\u001b[?2004h> "]
[124.969906, "o", "    pending = []  # (job, op_idx)\r\n\u001b[?2004l\r"]
[124.96994, "o", "\u001b[?2004h> "]
[124.970129, "o", "    for j in range(len(jobs)):\r\n\u001b[?2004l\r"]
[124.970163, "o", "\u001b[?2004h> "]
[124.970372, "o", "        pending.append((j, 0))\r\n\u001b[?2004l\r"]
[124.970401, "o", "\u001b[?2004h> "]
[124.970539, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.970629, "o", "    scheduled_ops = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.970662, "o", "    \r\n\u001b[?2004l\r"]
[124.970693, "o", "\u001b[?2004h"]
[124.970727, "o", "> "]
[124.970917, "o", "    while pending:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.970952, "o", "        # Find the operation that can start earliest\r\n\u001b[?2004l\r"]
[124.971088, "o", "\u001b[?2004h>         best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.971188, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r"]
[124.971224, "o", "\u001b[?2004h"]
[124.971254, "o", "> "]
[124.971409, "o", "        best_machine = None\r\n\u001b[?2004l\r\u001b[?2004h>         best_duration = None\r\n"]
[124.97145, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.971577, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.971674, "o", "        for j, op_idx in pending:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.971791, "o", "            if (j, op_idx) in scheduled_ops:\r\n"]
[124.971825, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.971951, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.972046, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.972164, "o", "            # Check if previous op is done\r\n"]
[124.972195, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.972391, "o", "            if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:"]
[124.972424, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.972455, "o", "> "]
[124.972621, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.972652, "o", "> "]
[124.972805, "o", "            baseline_op = baseline_ops.get((j, op_idx))\r\n\u001b[?2004l\r"]
[124.972841, "o", "\u001b[?2004h> "]
[124.973085, "o", "            is_frozen = baseline_op and baseline_op['start'] < freeze_until\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973145, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973401, "o", "            alternatives = jobs[j][op_idx]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973574, "o", "            for machine, duration in alternatives:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973754, "o", "                # If frozen, must use same machine\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973906, "o", "                if is_frozen and machine != baseline_op['machine']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.973957, "o", "                    continue\r\n\u001b[?2004l\r"]
[124.974016, "o", "\u001b[?2004h> "]
[124.974278, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h>                 # Earliest start: max of (machine available, previous op end)"]
[124.974326, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.974554, "o", "                prev_end = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 if op_idx > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.974709, "o", "                    # Find end time of previous op\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.974844, "o", "                    for s in schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.975851, "o", "                        if s['job'] == j and s['op'] == op_idx - 1:\r\n\u001b[?2004l\r\u001b[?2004h>                             prev_end = s['end']\r\n\u001b[?2004l\r\u001b[?2004h>                             break\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>                 # If frozen, must use same start time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.975898, "o", "                if is_frozen:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.975928, "o", "> "]
[124.976195, "o", "                    start = baseline_op['start']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976289, "o", "                    # But we need to check if this conflicts with machine availability\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.976327, "o", "> "]
[124.97646, "o", "                    if start < machine_available[machine]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976659, "o", "                        # Can't schedule at frozen time, skip this alternative\r\n\u001b[?2004l\r"]
[124.976711, "o", "\u001b[?2004h> "]
[124.976849, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.976888, "o", "                else:\r\n\u001b[?2004l\r"]
[124.976922, "o", "\u001b[?2004h> "]
[124.977156, "o", "                    start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r"]
[124.977264, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.977363, "o", "                if start < best_start:\r\n\u001b[?2004l\r"]
[124.977462, "o", "\u001b[?2004h> "]
[124.977554, "o", "                    best = (j, op_idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.977646, "o", "                    best_start = start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.977768, "o", "                    best_machine = machine\r\n\u001b[?2004l\r"]
[124.977866, "o", "\u001b[?2004h> "]
[124.977993, "o", "                    best_duration = duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.978094, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.978199, "o", "        if best is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.97834, "o", "            print(\"ERROR: Could not schedule any operation!\")\r\n\u001b[?2004l\r"]
[124.978442, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.978535, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.978629, "o", "        j, op_idx = best\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.978762, "o", "        baseline_op = baseline_ops.get((j, op_idx))\r\n\u001b[?2004l\r"]
[124.978861, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.978956, "o", "        # Track changes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.979055, "o", "        if baseline_op:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.979148, "o", "> "]
[124.979239, "o", "            if best_machine != baseline_op['machine']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.979335, "o", "> "]
[124.979428, "o", "                machine_changes += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.979591, "o", "            total_start_shift += abs(best_start - baseline_op['start'])\r\n\u001b[?2004l\r"]
[124.979684, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.979774, "o", "        schedule.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.979863, "o", ">             'job': j,\r\n\u001b[?2004l\r"]
[124.979955, "o", "\u001b[?2004h>             'op': op_idx,\r\n\u001b[?2004l\r"]
[124.980053, "o", "\u001b[?2004h> "]
[124.980144, "o", "            'machine': best_machine,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.98023, "o", "            'start': best_start,\r\n\u001b[?2004l\r"]
[124.980303, "o", "\u001b[?2004h> "]
