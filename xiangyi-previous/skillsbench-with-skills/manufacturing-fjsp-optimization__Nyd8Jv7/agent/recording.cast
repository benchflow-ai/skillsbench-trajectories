[215.601682, "o", "Frozen with downtime violation: Job 2 Op 0\r\n"]
[215.601987, "o", "\r\nSchedule generated:\r\n  Makespan: 36 (baseline: 36)\r\n  Machine changes: 5 (max: 4)\r\n  Total start shift: 64 (max: 120)\r\n  Downtime violations: 0\r\n  Job 0 Op 0: M1 [0-5] dur=5\r\n  Job 1 Op 0: M0 [0-5] dur=5\r\n  Job 2 Op 0: M2 [0-6] dur=6\r\n  Job 3 Op 0: M0 [5-12] dur=7\r\n  Job 0 Op 1: M2 [6-12] dur=6\r\n  Job 2 Op 1: M0 [12-20] dur=8\r\n  Job 0 Op 2: M0 [20-25] dur=5\r\n  Job 1 Op 1: M1 [20-26] dur=6\r\n  Job 2 Op 2: M0 [25-31] dur=6\r\n  Job 3 Op 1: M2 [25-32] dur=7\r\n  Job 1 Op 2: M1 [26-34] dur=8\r\n  Job 3 Op 2: M0 [32-36] dur=4\r\n\r\nSolution violates constraints!\r\n"]
[215.619508, "o", "\u001b[?2004hroot@65eabde849fa:/app# "]
[264.533383, "i", "cat > /app/solve.py << 'EOF'\nimport json\nimport csv\nfrom itertools import product\n\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row['machine'])\n            s = int(row['start'])\n            e = int(row['end'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef parse_baseline(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\n# Load data\njobs, num_machines = parse_instance('/app/data/instance.txt')\ndowntime = parse_downtime('/app/data/downtime.csv')\npolicy = parse_policy('/app/data/policy.json')\nbaseline = parse_baseline('/app/data/baseline_solution.json')\n\nbaseline_ops = {}\nfor op in baseline['schedule']:\n    baseline_ops[(op['job'], op['op'])] = op\n\nfreeze_until = policy['freeze']['freeze_until']\nmax_machine_changes = policy['change_budget']['max_machine_changes']\nmax_start_shift = policy['change_budget']['max_total_start_shift_L1']\n\nprint(\"Baseline schedule:\")\nfor key in sorted(baseline_ops.keys()):\n    op = baseline_ops[key]\n    violation = \"VIOLATION\" if overlaps_downtime(op['machine'], op['start'], op['end'], downtime) else \"ok\"\n    frozen = \"FROZEN\" if op['start'] < freeze_until else \"\"\n    print(f\"  Job {key[0]} Op {key[1]}: M{op['machine']} [{op['start']}-{op['end']}] {frozen} {violation}\")\n\n# Try to find a schedule that minimizes machine changes\n# Priority: keep baseline machine if possible, only change when needed for downtime\n\ndef schedule_with_choices(jobs, downtime, baseline_ops, num_machines, choices):\n    \"\"\"Schedule with given machine choices. Returns schedule or None if infeasible.\"\"\"\n    machine_available = [0] * num_machines\n    schedule = []\n    \n    # Sort operations by job and op index for precedence\n    all_ops = []\n    for j in range(len(jobs)):\n        for o in range(len(jobs[j])):\n            all_ops.append((j, o))\n    \n    scheduled = set()\n    \n    for _ in range(len(all_ops)):\n        # Find next schedulable operation\n        best = None\n        best_start = float('inf')\n        \n        for j, o in all_ops:\n            if (j, o) in scheduled:\n                continue\n            if o > 0 and (j, o-1) not in scheduled:\n                continue\n            \n            machine, duration = choices[(j, o)]\n            \n            prev_end = 0\n            if o > 0:\n                for s in schedule:\n   "]
[264.533624, "i", "                 if s['job'] == j and s['op'] == o - 1:\n                        prev_end = s['end']\n                        break\n            \n            earliest = max(machine_available[machine], prev_end)\n            start = get_available_start(machine, earliest, duration, downtime)\n            \n            if start < best_start:\n                best = (j, o, machine, duration, start)\n                best_start = start\n        \n        if best is None:\n            return None\n        \n        j, o, machine, duration, start = best\n        schedule.append({\n            'job': j,\n            'op': o,\n            'machine': machine,\n            'start': start,\n            'end': start + duration,\n            'dur': duration\n        })\n        machine_available[machine] = start + duration\n        scheduled.add((j, o))\n    \n    return schedule\n\ndef evaluate_schedule(schedule, baseline_ops, downtime):\n    \"\"\"Evaluate a schedule. Returns (makespan, machine_changes, start_shift, violations).\"\"\"\n    makespan = max(op['end'] for op in schedule)\n    machine_changes = 0\n    start_shift = 0\n    violations = 0\n    \n    for op in schedule:\n        key = (op['job'], op['op'])\n        baseline_op = baseline_ops[key]\n        if op['machine'] != baseline_op['machine']:\n            machine_changes += 1\n        start_shift += abs(op['start'] - baseline_op['start'])\n        if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\n            violations += 1\n    \n    return makespan, machine_changes, start_shift, violations\n\n# Identify which operations MUST change machine (frozen with downtime violation)\nmust_change = set()\nfor key, op in baseline_ops.items():\n    if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\n        must_change.add(key)\n\nprint(f\"\\nOperations that must change: {must_change}\")\n\n# Generate all possible machine choices\n# For each operation, list valid alternatives\nvalid_choices = {}\nfor j in range(len(jobs)):\n    for o in range(len(jobs[j])):\n        key = (j, o)\n        baseline_op = baseline_ops[key]\n        alts = jobs[j][o]\n        \n        if key in must_change:\n            # Must use different machine\n            valid = [(m, d) for m, d in alts if m != baseline_op['machine']]\n        else:\n            # Prefer baseline machine, but include alternatives\n            baseline_alt = [(m, d) for m, d in alts if m == baseline_op['machine']]\n            other_alts = [(m, d) for m, d in alts if m != baseline_op['machine']]\n            valid = baseline_alt + other_alts  # baseline first\n        \n        valid_choices[key] = valid\n        print(f\"  Job {j} Op {o}: baseline M{baseline_op['machine']}, choices {valid}\")\n\n# Try baseline machines first, then explore changes\nbest_schedule = None\nbest_score = (float('inf'), float('inf'), float('inf'))\n\n# Start with baseline choices (except must_change)\nbase_choices = {}\nfor key in valid_choices:\n    base_choices[key] = valid_choices[key][0]  # First choice (baseline if possible)\n\n# Try all combinations of changes for must_change operations\nfrom itertools import product\n\n# For operations not in must_change, we might still need to change some\n# Let's try a greedy approach first\n\nschedule = schedule_with_choices(jobs, downtime, baseline_ops, num_machines, base_choices)\nif schedule:\n    makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)\n    print(f\"\\nBase schedule: makespan={makespan}, changes={mc}, shift={ss}, violations={viol}\")\n    if viol == 0 and mc <= max_machine_changes and ss <= max_start_shift:\n        best_schedule = schedule\n        best_score = (makespan, mc, ss)\n\n# If still have violations or too many changes, try other combinations\nif best_schedule is None or best_score[1] > max_machine_changes:\n    print(\"\\nTrying alternative combinations...\")\n    \n    # Try keeping more operations on baseline\n    # The key insight: we only MUST change operations with downtime violations\n    # For others, keep baseline machine\n    \n    for key in valid_choices:\n        if key not in must_change:\n            baseline_op = baselin"]
[264.550131, "o", "cat > /app/solve.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> from itertools import product\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_instance(filename):\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         lines = [l.strip() for l in f.readlines() if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h>     first_line = lines[0].split()\r\n\u001b[?2004l\r\u001b[?2004h>     num_jobs = int(first_line[0])\r\n\u001b[?2004l\r\u001b[?2004h>     num_machines = int(first_line[1])\r\n\u001b[?2004l\r\u001b[?2004h>     jobs = []\r\n\u001b[?2004l\r\u001b[?2004h>     i = 1\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(num_jobs):\r\n\u001b[?2004l\r\u001b[?2004h>         num_ops = int(lines[i])\r\n\u001b[?2004l\r\u001b[?2004h>         i += 1\r\n\u001b[?2004l\r\u001b[?2004h>         ops = []\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(num_ops):\r\n\u001b[?2004l\r\u001b[?2004h>             parts = list(map(int, lines[i].split()))\r\n\u001b[?2004l\r\u001b[?2004h>             i += 1\r\n\u001b[?2004l\r\u001b[?2004h>             num_alts = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h>             alternatives = []\r\n\u001b[?2004l\r\u001b[?2004h>             idx = 1\r\n\u001b[?2004l\r\u001b[?2004h>             for _ in range(num_alts):\r\n\u001b[?2004l\r\u001b[?2004h>                 machine = parts[idx]\r\n\u001b[?2004l\r\u001b[?2004h>                 duration = parts[idx + 1]\r\n\u001b[?2004l\r\u001b[?2004h>                 alternatives.append((machine, duration))\r\n\u001b[?2004l\r\u001b[?2004h>                 idx += 2\r\n\u001b[?2004l\r\u001b[?2004h>             ops.append(alternatives)\r\n\u001b[?2004l\r\u001b[?2004h>         jobs.append(ops)\r\n\u001b[?2004l\r\u001b[?2004h>     return jobs, num_machines\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_downtime(filename):\r\n\u001b[?2004l\r\u001b[?2004h>     downtime = {}\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         reader = csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h>         for row in reader:\r\n\u001b[?2004l\r\u001b[?2004h>             m = int(row['machine'])\r\n\u001b[?2004l\r\u001b[?2004h>             s = int(row['start'])\r\n\u001b[?2004l\r\u001b[?2004h>             e = int(row['end'])\r\n\u001b[?2004l\r\u001b[?2004h>             if m not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h>                 downtime[m] = []\r\n\u001b[?2004l\r\u001b[?2004h>             downtime[m].append((s, e))\r\n\u001b[?2004l\r\u001b[?2004h>     return downtime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_policy(filename):\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         return json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_baseline(filename):\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filename, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         return json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def overlaps_downtime(machine, start, end, downtime):\r\n\u001b[?2004l\r\u001b[?2004h>     if machine not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h>     for ds, de in downtime[machine]:\r\n\u001b[?2004l\r\u001b[?2004h>         if start < de and end > ds:\r\n\u001b[?2004l\r\u001b[?2004h>             return True\r\n\u001b[?2004l\r\u001b[?2004h>     return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_available_start(machine, earliest, duration, downtime):\r\n\u001b[?2004l\r\u001b[?2004h>     start = earliest\r\n\u001b[?2004l\r\u001b[?2004h>     if machine not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h>         return start\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(100):\r\n\u001b[?2004l\r\u001b[?2004h>         end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h>         conflict = False\r\n\u001b[?2004l\r\u001b[?2004h>         for ds, de in sorted(downtime[machine]):\r\n\u001b[?2004l\r\u001b[?2004h>             if start < de and end > ds:\r\n\u001b[?2004l\r\u001b[?2004h>                 start = de\r\n\u001b[?2004l\r\u001b[?2004h>                 conflict = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         if not conflict:\r\n\u001b[?2004l\r\u001b[?2004h>             return start\r\n\u001b[?2004l\r\u001b[?2004h>     return start\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> jobs, num_machines = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r\u001b[?2004h> downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r\u001b[?2004h> policy = parse_policy('/app/data/policy.json')\r\n\u001b[?2004l\r\u001b[?2004h> baseline = parse_baseline('/app/data/baseline_solution.json')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> baseline_ops = {}\r\n\u001b[?2004l\r\u001b[?2004h> for op "]
[264.550431, "i", "e_ops[key]\n            baseline_machine = baseline_op['machine']\n            baseline_dur = baseline_op['dur']\n            # Find the baseline alternative\n            for m, d in jobs[key[0]][key[1]]:\n                if m == baseline_machine:\n                    base_choices[key] = (m, d)\n                    break\n    \n    schedule = schedule_with_choices(jobs, downtime, baseline_ops, num_machines, base_choices)\n    if schedule:\n        makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)\n        print(f\"Adjusted schedule: makespan={makespan}, changes={mc}, shift={ss}, violations={viol}\")\n        if viol == 0 and mc <= max_machine_changes:\n            if (makespan, mc, ss) < best_score:\n                best_schedule = schedule\n                best_score = (makespan, mc, ss)\n\nif best_schedule:\n    schedule = best_schedule\n    makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)\n    \n    print(f\"\\nFinal schedule:\")\n    print(f\"  Makespan: {makespan} (baseline: {baseline['makespan']})\")\n    print(f\"  Machine changes: {mc} (max: {max_machine_changes})\")\n    print(f\"  Total start shift: {ss} (max: {max_start_shift})\")\n    print(f\"  Downtime violations: {viol}\")\n    \n    schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\n    \n    for op in schedule:\n        baseline_op = baseline_ops[(op['job'], op['op'])]\n        changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \"\n        print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")\n    \n    solution = {\n        \"status\": \"FEASIBLE\",\n        \"makespan\": makespan,\n        \"schedule\": schedule\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w') as f:\n        f.write('job,op,machine,start,end,dur\\n')\n        for op in schedule:\n            f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\n    \n    print(\"\\nSolution saved!\")\nelse:\n    print(\"\\nNo feasible solution found!\")\n\nEOF\n"]
[264.550683, "o", "in baseline['schedule']:\r\n\u001b[?2004l\r\u001b[?2004h>     baseline_ops[(op['job'], op['op'])] = op\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r\u001b[?2004h> max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r\u001b[?2004h> max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Baseline schedule:\")\r\n\u001b[?2004l\r\u001b[?2004h> for key in sorted(baseline_ops.keys()):\r\n\u001b[?2004l\r\u001b[?2004h>     op = baseline_ops[key]\r\n\u001b[?2004l\r\u001b[?2004h>     violation = \"VIOLATION\" if overlaps_downtime(op['machine'], op['start'], op['end'], downtime) else \"ok\"\r\n\u001b[?2004l\r\u001b[?2004h>     frozen = \"FROZEN\" if op['start'] < freeze_until else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Job {key[0]} Op {key[1]}: M{op['machine']} [{op['start']}-{op['end']}] {frozen} {violation}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try to find a schedule that minimizes machine changes\r\n\u001b[?2004l\r\u001b[?2004h> # Priority: keep baseline machine if possible, only change when needed for downtime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def schedule_with_choices(jobs, downtime, baseline_ops, num_machines, choices):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Schedule with given machine choices. Returns schedule or None if infeasible.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     machine_available = [0] * num_machines\r\n\u001b[?2004l\r\u001b[?2004h>     schedule = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort operations by job and op index for precedence\r\n\u001b[?2004l\r\u001b[?2004h>     all_ops = []\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(len(jobs)):\r\n\u001b[?2004l\r\u001b[?2004h>         for o in range(len(j