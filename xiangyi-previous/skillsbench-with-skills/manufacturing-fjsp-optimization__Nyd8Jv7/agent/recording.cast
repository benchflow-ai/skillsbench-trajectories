[83.690726, "o", "Jobs: 4, Machines: 3\r\n  Job 0: [[(0, 6), (1, 5)], [(1, 7), (2, 6)], [(0, 5), (2, 8)]]\r\n  Job 1: [[(0, 5), (2, 7)], [(1, 6), (2, 5)], [(0, 7), (1, 8)]]\r\n  Job 2: [[(1, 4), (2, 6)], [(0, 8), (1, 7)], [(0, 6), (2, 5)]]\r\n  Job 3: [[(0, 7), (1, 6)], [(1, 5), (2, 7)], [(0, 4), (2, 6)]]\r\nDowntime: {1: [(5, 20)], 2: [(12, 25)]}\r\n\r\nFreeze until: 6\r\nMax machine changes: 4\r\nMax start shift L1: 120\r\nMax makespan: 39.6\r\nFrozen: Job 1 Op 0 - machine 0, 0-5\r\nFrozen: Job 0 Op 0 - machine 1, 0-5\r\nFrozen: Job 3 Op 0 - machine 0, 5-12\r\nFrozen: Job 2 Op 0 - machine 1, 5-9\r\n"]
[83.6908, "o", "Frozen: Job 0 Op 1 - machine 2, 5-11\r\n\r\nBaseline violations:\r\n  Job 2 Op 0: machine 1, 5-9\r\n  Job 1 Op 1: machine 1, 9-15\r\n  Job 2 Op 2: machine 2, 11-16\r\n  Job 3 Op 1: machine 1, 15-20\r\n  Job 3 Op 2: machine 2, 20-26\r\n"]
[83.694807, "o", "\u001b[?2004hroot@65eabde849fa:/app# "]
[124.942973, "i", "cat > /app/solve.py << 'EOF'\nimport json\nimport csv\nfrom copy import deepcopy\n\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row['machine'])\n            s = int(row['start'])\n            e = int(row['end'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef parse_baseline(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\n# Load data\njobs, num_machines = parse_instance('/app/data/instance.txt')\ndowntime = parse_downtime('/app/data/downtime.csv')\npolicy = parse_policy('/app/data/policy.json')\nbaseline = parse_baseline('/app/data/baseline_solution.json')\n\nbaseline_ops = {}\nfor op in baseline['schedule']:\n    baseline_ops[(op['job'], op['op'])] = op\n\nfreeze_until = policy['freeze']['freeze_until']\nmax_machine_changes = policy['change_budget']['max_machine_changes']\nmax_start_shift = policy['change_budget']['max_total_start_shift_L1']\nmax_makespan_ratio = policy['guards']['max_makespan_ratio']\n\n# Build schedule using list scheduling with downtime avoidance\n# Track: machine availability, job operation completion times\n\ndef schedule_jobs(jobs, downtime, baseline_ops, freeze_until, num_machines):\n    machine_available = [0] * num_machines\n    job_op_end = {j: 0 for j in range(len(jobs))}  # end time of last completed op for each job\n    \n    schedule = []\n    machine_changes = 0\n    total_start_shift = 0\n    \n    # Process operations in order: for each job, ops must be sequential\n    # We'll use a priority queue approach: always schedule the earliest available operation\n    \n    pending = []  # (job, op_idx)\n    for j in range(len(jobs)):\n        pending.append((j, 0))\n    \n    scheduled_ops = set()\n    \n    while pending:\n        # Find the operation that can start earliest\n        best = None\n        best_start = float('inf')\n        best_machine = None\n        best_duration = None\n        \n        for j, op_idx in pending:\n            if (j, op_idx) in scheduled_ops:\n                continue\n                \n            # Check if previous op is done\n            if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:\n                continue\n            \n            baseline_op = baseline_ops.get((j, op_idx))\n            is_frozen = baseline_op and baseline_op['start'] < freeze_until\n            \n            alternatives = jobs[j][op"]
[124.943245, "i", "_idx]\n            \n            for machine, duration in alternatives:\n                # If frozen, must use same machine\n                if is_frozen and machine != baseline_op['machine']:\n                    continue\n                \n                # Earliest start: max of (machine available, previous op end)\n                prev_end = 0\n                if op_idx > 0:\n                    # Find end time of previous op\n                    for s in schedule:\n                        if s['job'] == j and s['op'] == op_idx - 1:\n                            prev_end = s['end']\n                            break\n                \n                earliest = max(machine_available[machine], prev_end)\n                \n                # If frozen, must use same start time\n                if is_frozen:\n                    start = baseline_op['start']\n                    # But we need to check if this conflicts with machine availability\n                    if start < machine_available[machine]:\n                        # Can't schedule at frozen time, skip this alternative\n                        continue\n                else:\n                    start = get_available_start(machine, earliest, duration, downtime)\n                \n                if start < best_start:\n                    best = (j, op_idx)\n                    best_start = start\n                    best_machine = machine\n                    best_duration = duration\n        \n        if best is None:\n            print(\"ERROR: Could not schedule any operation!\")\n            break\n        \n        j, op_idx = best\n        baseline_op = baseline_ops.get((j, op_idx))\n        \n        # Track changes\n        if baseline_op:\n            if best_machine != baseline_op['machine']:\n                machine_changes += 1\n            total_start_shift += abs(best_start - baseline_op['start'])\n        \n        schedule.append({\n            'job': j,\n            'op': op_idx,\n            'machine': best_machine,\n            'start': best_start,\n            'end': best_start + best_duration,\n            'dur': best_duration\n        })\n        \n        machine_available[best_machine] = best_start + best_duration\n        scheduled_ops.add((j, op_idx))\n        \n        # Add next operation for this job\n        if op_idx + 1 < len(jobs[j]):\n            pending.append((j, op_idx + 1))\n        \n        # Remove scheduled from pending\n        pending = [(jj, oo) for jj, oo in pending if (jj, oo) not in scheduled_ops]\n    \n    return schedule, machine_changes, total_start_shift\n\nschedule, machine_changes, total_start_shift = schedule_jobs(\n    jobs, downtime, baseline_ops, freeze_until, num_machines\n)\n\nmakespan = max(op['end'] for op in schedule)\n\nprint(f\"\\nSchedule generated:\")\nprint(f\"  Makespan: {makespan}\")\nprint(f\"  Machine changes: {machine_changes}\")\nprint(f\"  Total start shift: {total_start_shift}\")\n\n# Check for violations\nviolations = 0\nfor op in schedule:\n    if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\n        print(f\"  VIOLATION: Job {op['job']} Op {op['op']} on machine {op['machine']}, {op['start']}-{op['end']}\")\n        violations += 1\n\nprint(f\"  Downtime violations: {violations}\")\n\n# Sort schedule by start time\nschedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\n\nfor op in schedule:\n    print(f\"  Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}] dur={op['dur']}\")\n\nEOF\n"]
[124.943587, "o", "cat > /app/solve.py << 'EOF'\r\n"]
