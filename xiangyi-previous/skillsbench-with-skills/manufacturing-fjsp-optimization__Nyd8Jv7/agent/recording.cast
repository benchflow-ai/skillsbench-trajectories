[265.689033, "o", "Baseline schedule:\r\n  Job 0 Op 0: M1 [0-5] FROZEN ok\r\n  Job 0 Op 1: M2 [5-11] FROZEN ok\r\n  Job 0 Op 2: M0 [24-29]  ok\r\n  Job 1 Op 0: M0 [0-5] FROZEN ok\r\n  Job 1 Op 1: M1 [9-15]  VIOLATION\r\n  Job 1 Op 2: M0 [29-36]  ok\r\n  Job 2 Op 0: M1 [5-9] FROZEN VIOLATION\r\n  Job 2 Op 1: M0 [16-24]  ok\r\n"]
[265.689209, "o", "  Job 2 Op 2: M2 [11-16]  VIOLATION\r\n  Job 3 Op 0: M0 [5-12] FROZEN ok\r\n  Job 3 Op 1: M1 [15-20]  VIOLATION\r\n  Job 3 Op 2: M2 [20-26]  VIOLATION\r\n\r\nOperations that must change: {(3, 1), (1, 1), (2, 0), (2, 2), (3, 2)}\r\n  Job 0 Op 0: baseline M1, choices [(1, 5), (0, 6)]\r\n  Job 0 Op 1: baseline M2, choices [(2, 6), (1, 7)]\r\n  Job 0 Op 2: baseline M0, choices [(0, 5), (2, 8)]\r\n  Job 1 Op 0: baseline M0, choices [(0, 5), (2, 7)]\r\n  Job 1 Op 1: baseline M1, choices [(2, 5)]\r\n  Job 1 Op 2: baseline M0, choices [(0, 7), (1, 8)]\r\n  Job 2 Op 0: baseline M1, choices [(2, 6)]\r\n  Job 2 Op 1: baseline M0, choices [(0, 8), (1, 7)]\r\n  Job 2 Op 2: baseline M2, choices [(0, 6)]\r\n  Job 3 Op 0: baseline M0, choices [(0, 7), (1, 6)]\r\n  Job 3 Op 1: baseline M1, choices [(2, 7)]\r\n"]
[265.689275, "o", "  Job 3 Op 2: baseline M2, choices [(0, 4)]\r\n"]
[265.689522, "o", "\r\nBase schedule: makespan=42, changes=5, shift=84, violations=0\r\n\r\nTrying alternative combinations...\r\nAdjusted schedule: makespan=42, changes=5, shift=84, violations=0\r\n\r\nNo feasible solution found!\r\n"]
[265.700511, "o", "\u001b[?2004h"]
[265.700713, "o", "root@65eabde849fa:/app# "]
[306.274178, "i", "cat > /app/solve.py << 'EOF'\nimport json\nimport csv\n\ndef parse_instance(filename):\n    with open(filename, 'r') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row['machine'])\n            s = int(row['start'])\n            e = int(row['end'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef parse_baseline(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\n# Load data\njobs, num_machines = parse_instance('/app/data/instance.txt')\ndowntime = parse_downtime('/app/data/downtime.csv')\npolicy = parse_policy('/app/data/policy.json')\nbaseline = parse_baseline('/app/data/baseline_solution.json')\n\nbaseline_ops = {}\nfor op in baseline['schedule']:\n    baseline_ops[(op['job'], op['op'])] = op\n\nfreeze_until = policy['freeze']['freeze_until']\nmax_machine_changes = policy['change_budget']['max_machine_changes']\nmax_start_shift = policy['change_budget']['max_total_start_shift_L1']\n\n# Only Job 2 Op 0 is frozen AND has violation - must change machine\n# Others can keep machine but shift timing\n\ndef schedule_greedy(jobs, downtime, baseline_ops, num_machines, frozen_must_change):\n    \"\"\"Greedy scheduler that keeps baseline machines when possible.\"\"\"\n    machine_available = [0] * num_machines\n    schedule = []\n    \n    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\n    scheduled = set()\n    \n    while len(scheduled) < len(all_ops):\n        best = None\n        best_start = float('inf')\n        best_machine = None\n        best_duration = None\n        \n        for j, o in all_ops:\n            if (j, o) in scheduled:\n                continue\n            if o > 0 and (j, o-1) not in scheduled:\n                continue\n            \n            baseline_op = baseline_ops[(j, o)]\n            alternatives = jobs[j][o]\n            \n            # Determine which machines to try\n            if (j, o) in frozen_must_change:\n                # Must use different machine\n                try_machines = [(m, d) for m, d in alternatives if m != baseline_op['machine']]\n            else:\n                # Prefer baseline machine, but can use others\n                baseline_alts = [(m, d) for m, d in alternatives if m == baseline_op['machine']]\n                other_alts = [(m, d) for m, d in alternatives if m != baseline_op['machine']]\n                try_machines = baseline_alts + other_alts\n            "]
[306.274425, "i", "\n            for machine, duration in try_machines:\n                prev_end = 0\n                if o > 0:\n                    for s in schedule:\n                        if s['job'] == j and s['op'] == o - 1:\n                            prev_end = s['end']\n                            break\n                \n                earliest = max(machine_available[machine], prev_end)\n                start = get_available_start(machine, earliest, duration, downtime)\n                \n                # For non-frozen-must-change, prefer baseline machine even if later\n                if (j, o) not in frozen_must_change and machine == baseline_op['machine']:\n                    # Use baseline machine with adjusted timing\n                    if start < best_start or best_machine != baseline_op['machine']:\n                        best = (j, o)\n                        best_start = start\n                        best_machine = machine\n                        best_duration = duration\n                    break  # Don't try other machines if baseline works\n                elif start < best_start:\n                    best = (j, o)\n                    best_start = start\n                    best_machine = machine\n                    best_duration = duration\n        \n        if best is None:\n            print(\"ERROR: Cannot schedule any operation\")\n            break\n        \n        j, o = best\n        schedule.append({\n            'job': j,\n            'op': o,\n            'machine': best_machine,\n            'start': best_start,\n            'end': best_start + best_duration,\n            'dur': best_duration\n        })\n        machine_available[best_machine] = best_start + best_duration\n        scheduled.add((j, o))\n    \n    return schedule\n\n# Only frozen operations with violations must change machine\nfrozen_must_change = set()\nfor key, op in baseline_ops.items():\n    is_frozen = op['start'] < freeze_until\n    has_violation = overlaps_downtime(op['machine'], op['start'], op['end'], downtime)\n    if is_frozen and has_violation:\n        frozen_must_change.add(key)\n\nprint(f\"Frozen operations that must change machine: {frozen_must_change}\")\n\nschedule = schedule_greedy(jobs, downtime, baseline_ops, num_machines, frozen_must_change)\n\n# Evaluate\nmakespan = max(op['end'] for op in schedule)\nmachine_changes = 0\nstart_shift = 0\nviolations = 0\n\nfor op in schedule:\n    key = (op['job'], op['op'])\n    baseline_op = baseline_ops[key]\n    if op['machine'] != baseline_op['machine']:\n        machine_changes += 1\n    start_shift += abs(op['start'] - baseline_op['start'])\n    if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\n        violations += 1\n\nprint(f\"\\nSchedule:\")\nprint(f\"  Makespan: {makespan} (baseline: {baseline['makespan']})\")\nprint(f\"  Machine changes: {machine_changes} (max: {max_machine_changes})\")\nprint(f\"  Start shift L1: {start_shift} (max: {max_start_shift})\")\nprint(f\"  Violations: {violations}\")\n\nschedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\n\nfor op in schedule:\n    baseline_op = baseline_ops[(op['job'], op['op'])]\n    changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \"\n    print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}] dur={op['dur']}\")\n\nif violations == 0 and machine_changes <= max_machine_changes and start_shift <= max_start_shift:\n    solution = {\n        \"status\": \"FEASIBLE\",\n        \"makespan\": makespan,\n        \"schedule\": schedule\n    }\n    \n    with open('/app/output/solution.json', 'w') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open('/app/output/schedule.csv', 'w') as f:\n        f.write('job,op,machine,start,end,dur\\n')\n        for op in schedule:\n            f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\n    \n    print(\"\\nSolution saved!\")\nelse:\n    print(\"\\nSolution violates constraints, not saved.\")\n\nEOF\n"]
