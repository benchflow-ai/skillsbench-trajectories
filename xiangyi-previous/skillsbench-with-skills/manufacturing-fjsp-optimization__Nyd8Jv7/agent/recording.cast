[306.314055, "o", "\u001b[?2004h> "]
[306.316014, "o", "            f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nSolution saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nSolution violates constraints, not saved.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
