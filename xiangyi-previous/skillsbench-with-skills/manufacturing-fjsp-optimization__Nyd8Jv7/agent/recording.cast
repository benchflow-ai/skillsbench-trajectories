[264.577201, "o", "        if op['machine'] != baseline_op['machine']:"]
[264.577306, "o", "\r\n"]
[264.577391, "o", "\u001b[?2004l\r"]
[264.5775, "o", "\u001b[?2004h"]
[264.57759, "o", "> "]
[264.577845, "o", "            machine_changes += 1"]
[264.577933, "o", "\r\n"]
[264.578042, "o", "\u001b[?2004l\r"]
[264.578161, "o", "\u001b[?2004h"]
[264.578288, "o", "> "]
[264.578643, "o", "        start_shift += abs(op['start'] - baseline_op['start'])"]
[264.578728, "o", "\r\n"]
[264.578807, "o", "\u001b[?2004l\r"]
[264.578912, "o", "\u001b[?2004h"]
[264.579005, "o", "> "]
[264.579494, "o", "        if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):"]
[264.579581, "o", "\r\n"]
[264.579659, "o", "\u001b[?2004l\r"]
[264.579765, "o", "\u001b[?2004h"]
[264.579859, "o", "> "]
[264.580085, "o", "            violations += 1"]
[264.580164, "o", "\r\n"]
[264.580239, "o", "\u001b[?2004l\r"]
[264.580337, "o", "\u001b[?2004h"]
[264.580417, "o", "> "]
[264.580521, "o", "    "]
[264.580597, "o", "\r\n"]
[264.58071, "o", "\u001b[?2004l\r"]
[264.580807, "o", "\u001b[?2004h"]
[264.580936, "o", "> "]
[264.581285, "o", "    return makespan, machine_changes, start_shift, violations"]
[264.581371, "o", "\r\n"]
[264.58145, "o", "\u001b[?2004l\r"]
[264.5816, "o", "\u001b[?2004h"]
[264.581822, "o", "> "]
[264.581987, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.582468, "o", "# Identify which operations MUST change machine (frozen with downtime violation)"]
[264.58258, "o", "\r\n"]
[264.582669, "o", "\u001b[?2004l\r"]
[264.582777, "o", "\u001b[?2004h"]
[264.582886, "o", "> "]
[264.583101, "o", "must_change = set()"]
[264.583196, "o", "\r\n"]
[264.583295, "o", "\u001b[?2004l\r"]
[264.583433, "o", "\u001b[?2004h"]
[264.583595, "o", "> "]
[264.58381, "o", "for key, op in baseline_ops.items():"]
[264.583936, "o", "\r\n"]
[264.584047, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.584202, "o", "> "]
[264.58466, "o", "    if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):"]
[264.584812, "o", "\r\n"]
[264.584925, "o", "\u001b[?2004l\r"]
[264.585062, "o", "\u001b[?2004h"]
[264.585196, "o", "> "]
[264.585426, "o", "        must_change.add(key)"]
[264.585518, "o", "\r\n"]
[264.585628, "o", "\u001b[?2004l\r"]
[264.585787, "o", "\u001b[?2004h> "]
[264.586, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586387, "o", "print(f\"\\nOperations that must change: {must_change}\")"]
[264.586505, "o", "\r\n"]
[264.586588, "o", "\u001b[?2004l\r"]
[264.586692, "o", "\u001b[?2004h"]
[264.586823, "o", "> "]
[264.586936, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.587085, "o", "> "]
[264.587308, "o", "# Generate all possible machine choices"]
[264.587401, "o", "\r\n"]
[264.587516, "o", "\u001b[?2004l\r"]
[264.587649, "o", "\u001b[?2004h> "]
[264.587919, "o", "# For each operation, list valid alternatives"]
[264.587998, "o", "\r\n"]
[264.588087, "o", "\u001b[?2004l\r"]
[264.588195, "o", "\u001b[?2004h"]
[264.588313, "o", "> "]
[264.588442, "o", "valid_choices = {}"]
[264.588566, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.588704, "o", "> "]
[264.588829, "o", "for j in range(len(jobs)):\r\n\u001b[?2004l\r"]
[264.5889, "o", "\u001b[?2004h> "]
[264.589096, "o", "    for o in range(len(jobs[j])):\r\n"]
[264.589274, "o", "\u001b[?2004l\r\u001b[?2004h>         key = (j, o)"]
[264.589414, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589533, "o", "        baseline_op = baseline_ops[key]"]
[264.589613, "o", "\r\n"]
[264.589711, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[264.589814, "o", "        alts = jobs[j][o]"]
[264.589894, "o", "\r\n"]
[264.589989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[264.590118, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.59017, "o", ">         if key in must_change:"]
[264.590248, "o", "\r\n"]
[264.590375, "o", "\u001b[?2004l\r\u001b[?2004h>             # Must use different machine"]
[264.590437, "o", "\r\n"]
[264.590511, "o", "\u001b[?2004l\r"]
[264.590686, "o", "\u001b[?2004h>             valid = [(m, d) for m, d in alts if m != baseline_op['machine']]"]
[264.59074, "o", "\r\n"]
[264.590797, "o", "\u001b[?2004l\r"]
[264.590863, "o", "\u001b[?2004h"]
[264.590925, "o", "> "]
[264.591007, "o", "        else:"]
[264.591184, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.591236, "o", ">             # Prefer baseline machine, but include alternatives"]
[264.591296, "o", "\r\n"]
[264.591372, "o", "\u001b[?2004l\r"]
[264.59156, "o", "\u001b[?2004h"]
[264.591616, "o", ">             baseline_alt = [(m, d) for m, d in alts if m == baseline_op['machine']]"]
[264.591678, "o", "\r\n"]
[264.591733, "o", "\u001b[?2004l\r"]
[264.591803, "o", "\u001b[?2004h"]
[264.591988, "o", "> "]
[264.59204, "o", "            other_alts = [(m, d) for m, d in alts if m != baseline_op['machine']]"]
[264.592093, "o", "\r\n"]
[264.592147, "o", "\u001b[?2004l\r"]
[264.592218, "o", "\u001b[?2004h"]
[264.592384, "o", "> "]
[264.592439, "o", "            valid = baseline_alt + other_alts  # baseline first"]
[264.592491, "o", "\r\n"]
[264.592541, "o", "\u001b[?2004l\r"]
[264.592606, "o", "\u001b[?2004h"]
[264.592683, "o", "> "]
[264.598969, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.599187, "o", ">         valid_choices[key] = valid"]
[264.599617, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.599778, "o", ">         print(f\"  Job {j} Op {o}: baseline M{baseline_op['machine']}, choices {valid}\")"]
[264.599895, "o", "\r\n"]
[264.599991, "o", "\u001b[?2004l\r"]
[264.60012, "o", "\u001b[?2004h"]
[264.600263, "o", "> "]
[264.600509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.600591, "o", "> # Try baseline machines first, then explore changes"]
[264.600701, "o", "\r\n"]
[264.600865, "o", "\u001b[?2004l\r"]
[264.601015, "o", "\u001b[?2004h> best_schedule = None"]
[264.601157, "o", "\r\n"]
[264.601419, "o", "\u001b[?2004l\r\u001b[?2004h> best_score = (float('inf'), float('inf'), float('inf'))"]
[264.60155, "o", "\r\n"]
[264.601689, "o", "\u001b[?2004l\r"]
[264.601864, "o", "\u001b[?2004h> "]
[264.602083, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Start with baseline choices (except must_change)"]
[264.602205, "o", "\r\n"]
[264.602344, "o", "\u001b[?2004l\r"]
[264.602528, "o", "\u001b[?2004h> "]
[264.602679, "o", "base_choices = {}\r\n"]
[264.602831, "o", "\u001b[?2004l\r\u001b[?2004h> for key in valid_choices:"]
[264.602964, "o", "\r\n"]
[264.603285, "o", "\u001b[?2004l\r\u001b[?2004h>     base_choices[key] = valid_choices[key][0]  # First choice (baseline if possible)"]
[264.60341, "o", "\r\n"]
[264.603495, "o", "\u001b[?2004l\r"]
[264.603614, "o", "\u001b[?2004h"]
[264.603727, "o", "> "]
[264.60401, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.604079, "o", "> # Try all combinations of changes for must_change operations"]
[264.604181, "o", "\r\n"]
[264.604265, "o", "\u001b[?2004l\r"]
[264.604483, "o", "\u001b[?2004h"]
[264.604562, "o", "> from itertools import product"]
[264.604701, "o", "\r\n"]
[264.605622, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.605934, "o", "> # For operations not in must_change, we might still need to change some"]
[264.606049, "o", "\r\n"]
[264.606157, "o", "\u001b[?2004l\r"]
[264.606276, "o", "\u001b[?2004h"]
[264.606476, "o", "> "]
[264.606547, "o", "# Let's try a greedy approach first"]
[264.606641, "o", "\r\n"]
[264.606791, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.607152, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.607227, "o", "> schedule = schedule_with_choices(jobs, downtime, baseline_ops, num_machines, base_choices)"]
[264.607327, "o", "\r\n"]
[264.607419, "o", "\u001b[?2004l\r"]
[264.607531, "o", "\u001b[?2004h"]
[264.607622, "o", "> "]
[264.607748, "o", "if schedule:"]
[264.607851, "o", "\r\n"]
[264.608183, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.608259, "o", ">     makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)"]
[264.608371, "o", "\r\n"]
[264.60855, "o", "\u001b[?2004l\r"]
[264.608672, "o", "\u001b[?2004h"]
[264.609062, "o", "> "]
[264.609146, "o", "    print(f\"\\nBase schedule: makespan={makespan}, changes={mc}, shift={ss}, violations={viol}\")"]
[264.609248, "o", "\r\n"]
[264.609348, "o", "\u001b[?2004l\r"]
[264.609456, "o", "\u001b[?2004h"]
[264.609554, "o", "> "]
[264.609849, "o", "    if viol == 0 and mc <= max_machine_changes and ss <= max_start_shift:"]
[264.609943, "o", "\r\n"]
[264.61003, "o", "\u001b[?2004l\r"]
[264.610148, "o", "\u001b[?2004h"]
[264.610242, "o", "> "]
[264.61042, "o", "        best_schedule = schedule"]
[264.610531, "o", "\r\n"]
[264.61066, "o", "\u001b[?2004l\r"]
[264.610877, "o", "\u001b[?2004h>         best_score = (makespan, mc, ss)"]
[264.610979, "o", "\r\n"]
[264.611093, "o", "\u001b[?2004l\r"]
[264.611228, "o", "\u001b[?2004h"]
[264.611523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.6116, "o", "> # If still have violations or too many changes, try other combinations"]
[264.611698, "o", "\r\n"]
[264.611782, "o", "\u001b[?2004l\r"]
[264.611893, "o", "\u001b[?2004h"]
[264.612158, "o", "> if best_schedule is None or best_score[1] > max_machine_changes:"]
[264.612252, "o", "\r\n"]
[264.612343, "o", "\u001b[?2004l\r"]
[264.612448, "o", "\u001b[?2004h"]
[264.61268, "o", "> "]
[264.612769, "o", "    print(\"\\nTrying alternative combinations...\")"]
[264.612878, "o", "\r\n"]
[264.613007, "o", "\u001b[?2004l\r"]
[264.613142, "o", "\u001b[?2004h"]
[264.613431, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.613517, "o", ">     # Try keeping more operations on baseline"]
[264.613626, "o", "\r\n"]
[264.613751, "o", "\u001b[?2004l\r"]
[264.614077, "o", "\u001b[?2004h> "]
[264.614159, "o", "    # The key insight: we only MUST change operations with downtime violations"]
[264.614259, "o", "\r\n"]
[264.614365, "o", "\u001b[?2004l\r"]
[264.614475, "o", "\u001b[?2004h"]
[264.614694, "o", "> "]
[264.614774, "o", "    # For others, keep baseline machine"]
[264.614871, "o", "\r\n"]
[264.615005, "o", "\u001b[?2004l\r"]
[264.615324, "o", "\u001b[?2004h>     "]
[264.615515, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for key in valid_choices:"]
[264.615652, "o", "\r\n"]
[264.615875, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.615952, "o", ">         if key not in must_change:"]
[264.616081, "o", "\r\n"]
[264.616308, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.616391, "o", ">             baseline_op = baseline_ops[key]"]
[264.616495, "o", "\r\n"]
[264.616623, "o", "\u001b[?2004l\r"]
[264.61686, "o", "\u001b[?2004h>             baseline_machine = baseline_op['machine']"]
[264.617123, "o", "\r\n"]
[264.617259, "o", "\u001b[?2004l\r"]
[264.617407, "o", "\u001b[?2004h"]
[264.617614, "o", ">             baseline_dur = baseline_op['dur']"]
[264.617736, "o", "\r\n"]
[264.617866, "o", "\u001b[?2004l\r"]
[264.618119, "o", "\u001b[?2004h"]
[264.618208, "o", ">             # Find the baseline alternative"]
[264.618315, "o", "\r\n"]
[264.618454, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.618649, "o", ">             for m, d in jobs[key[0]][key[1]]:"]
[264.618762, "o", "\r\n"]
[264.618888, "o", "\u001b[?2004l\r"]
[264.619102, "o", "\u001b[?2004h> "]
[264.619176, "o", "                if m == baseline_machine:"]
[264.619274, "o", "\r\n"]
[264.619565, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.619645, "o", ">                     base_choices[key] = (m, d)"]
[264.619742, "o", "\r\n"]
[264.619871, "o", "\u001b[?2004l\r"]
[264.620046, "o", "\u001b[?2004h> "]
[264.620127, "o", "                    break"]
[264.620298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.620437, "o", ">     \r\n\u001b[?2004l\r"]
[264.620765, "o", "\u001b[?2004h>     schedule = schedule_with_choices(jobs, downtime, baseline_ops, num_machines, base_choices)"]
[264.620896, "o", "\r\n"]
[264.620992, "o", "\u001b[?2004l\r"]
[264.621107, "o", "\u001b[?2004h"]
[264.621211, "o", "> "]
[264.621359, "o", "    if schedule:"]
[264.621456, "o", "\r\n"]
[264.621588, "o", "\u001b[?2004l\r"]
[264.621921, "o", "\u001b[?2004h>         makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)"]
[264.622017, "o", "\r\n"]
[264.622113, "o", "\u001b[?2004l\r"]
[264.622227, "o", "\u001b[?2004h"]
[264.622336, "o", "> "]
[264.622705, "o", "        print(f\"Adjusted schedule: makespan={makespan}, changes={mc}, shift={ss}, violations={viol}\")"]
[264.622798, "o", "\r\n"]
[264.622891, "o", "\u001b[?2004l\r"]
[264.623004, "o", "\u001b[?2004h"]
[264.623105, "o", "> "]
[264.623341, "o", "        if viol == 0 and mc <= max_machine_changes:"]
[264.623437, "o", "\r\n"]
[264.623533, "o", "\u001b[?2004l\r"]
[264.623646, "o", "\u001b[?2004h"]
[264.623754, "o", "> "]
[264.62397, "o", "            if (makespan, mc, ss) < best_score:"]
[264.624056, "o", "\r\n"]
[264.624135, "o", "\u001b[?2004l\r"]
[264.624219, "o", "\u001b[?2004h"]
[264.624298, "o", "> "]
[264.62445, "o", "                best_schedule = schedule"]
[264.624517, "o", "\r\n"]
[264.624575, "o", "\u001b[?2004l\r"]
[264.62479, "o", "\u001b[?2004h"]
[264.624845, "o", ">                 best_score = (makespan, mc, ss)"]
[264.624915, "o", "\r\n"]
[264.624986, "o", "\u001b[?2004l\r"]
[264.625083, "o", "\u001b[?2004h"]
[264.625199, "o", "> \r\n\u001b[?2004l\r"]
[264.625307, "o", "\u001b[?2004h> if best_schedule:"]
[264.625495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.625558, "o", ">     schedule = best_schedule"]
[264.625666, "o", "\r\n"]
[264.625923, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[264.625989, "o", "    makespan, mc, ss, viol = evaluate_schedule(schedule, baseline_ops, downtime)"]
[264.626183, "o", "\r\n"]
[264.626454, "o", "\u001b[?2004l\r\u001b[?2004h"]
[264.626632, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.626702, "o", ">     print(f\"\\nFinal schedule:\")"]
[264.626821, "o", "\r\n"]
[264.628025, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[264.630186, "o", "    print(f\"  Makespan: {makespan} (baseline: {baseline['makespan']})\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Machine changes: {mc} (max: {max_machine_changes})\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Total start shift: {ss} (max: {max_start_shift})\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  Downtime violations: {viol}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h>         baseline_op = baseline_ops[(op['job'], op['op'])]\r\n\u001b[?2004l\r\u001b[?2004h>         changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \"\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     solution = {\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"FEASIBLE\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"makespan\": makespan,\r\n\u001b[?2004l\r\u001b[?2004h>         \"schedule\": schedule\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.630364, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.630432, "o", "    with open('/app/output/schedule.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.630845, "o", "        f.write('job,op,machine,start,end,dur\\n')\r\n\u001b[?2004l\r\u001b[?2004h>         for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
