[165.062557, "o", "> "]
[165.062908, "o", "        baseline_op = baseline_ops.get((j, op_idx))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if baseline_op:\r\n\u001b[?2004l\r"]
