[165.057741, "o", "> "]
[165.057819, "o", "                \r\n\u001b[?2004l\r"]
[165.057851, "o", "\u001b[?2004h> "]
[165.058076, "o", "                # If frozen and no violation, try to keep same start"]
[165.058152, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.058183, "o", "> "]
[165.05836, "o", "                if is_frozen and not has_frozen_violation:"]
