[490.433795, "o", "def schedule_with_choices(choices):\r\n\u001b[?2004l\r"]
[490.433832, "o", "\u001b[?2004h> "]
[490.434009, "o", "    machine_available = [0] * num_machines\r\n\u001b[?2004l\r"]
[490.434044, "o", "\u001b[?2004h> "]
[490.434141, "o", "    schedule = []\r\n\u001b[?2004l\r"]
[490.434178, "o", "\u001b[?2004h> "]
[490.434494, "o", "    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\r\n\u001b[?2004l\r"]
[490.434526, "o", "\u001b[?2004h> "]
[490.43463, "o", "    scheduled = set()\r\n\u001b[?2004l\r"]
[490.43467, "o", "\u001b[?2004h> "]
[490.434702, "o", "    \r\n\u001b[?2004l\r"]
[490.43474, "o", "\u001b[?2004h> "]
[490.434907, "o", "    while len(scheduled) < len(all_ops):\r\n\u001b[?2004l\r"]
[490.434945, "o", "\u001b[?2004h> "]
[490.435037, "o", "        best = None\r\n\u001b[?2004l\r"]
[490.43507, "o", "\u001b[?2004h> "]
[490.435231, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r"]
[490.435266, "o", "\u001b[?2004h> "]
[490.435313, "o", "        \r\n\u001b[?2004l\r"]
[490.435344, "o", "\u001b[?2004h> "]
[490.43547, "o", "        for j, o in all_ops:\r\n\u001b[?2004l\r"]
[490.435508, "o", "\u001b[?2004h> "]
[490.435816, "o", "            if (j, o) in scheduled or (o > 0 and (j, o-1) not in scheduled):\r\n\u001b[?2004l\r"]
[490.435851, "o", "\u001b[?2004h> "]
[490.435965, "o", "                continue\r\n\u001b[?2004l\r"]
[490.436007, "o", "\u001b[?2004h> "]
[490.436069, "o", "            \r\n\u001b[?2004l\r"]
[490.436107, "o", "\u001b[?2004h> "]
[490.436319, "o", "            machine, duration = choices[(j, o)]\r\n\u001b[?2004l\r"]
[490.436352, "o", "\u001b[?2004h> "]
[490.436844, "o", "            prev_end = next((s['end'] for s in schedule if s['job'] == j and s['op'] == o-1), 0) if o > 0 else 0\r\n\u001b[?2004l\r"]
[490.436882, "o", "\u001b[?2004h"]
[490.436918, "o", "> "]
[490.4373, "o", "            earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r"]
[490.43734, "o", "\u001b[?2004h> "]
[490.437661, "o", "            start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r"]
[490.437695, "o", "\u001b[?2004h> "]
[490.437763, "o", "            \r\n\u001b[?2004l\r"]
[490.437794, "o", "\u001b[?2004h> "]
[490.437903, "o", "            if start < best_start:\r\n\u001b[?2004l\r"]
[490.437963, "o", "\u001b[?2004h> "]
[490.438084, "o", "                best = (j, o, machine, duration, start)\r\n\u001b[?2004l\r"]
[490.438116, "o", "\u001b[?2004h> "]
[490.438216, "o", "                best_start = start\r\n\u001b[?2004l\r"]
[490.438249, "o", "\u001b[?2004h> "]
[490.438281, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[490.438312, "o", "> "]
[490.438377, "o", "        if best is None:\r\n\u001b[?2004l\r"]
[490.438413, "o", "\u001b[?2004h> "]
[490.438474, "o", "            return None\r\n\u001b[?2004l\r"]
[490.43851, "o", "\u001b[?2004h> "]
[490.438543, "o", "        \r\n\u001b[?2004l\r"]
[490.438572, "o", "\u001b[?2004h> "]
[490.438687, "o", "        j, o, machine, duration, start = best\r\n\u001b[?2004l\r"]
[490.438722, "o", "\u001b[?2004h> "]
[490.43896, "o", "        schedule.append({'job': j, 'op': o, 'machine': machine, 'start': start, 'end': start + duration, 'dur': duration})\r\n\u001b[?2004l\r"]
[490.438996, "o", "\u001b[?2004h> "]
[490.439116, "o", "        machine_available[machine] = start + duration\r\n\u001b[?2004l\r"]
[490.439145, "o", "\u001b[?2004h> "]
[490.439228, "o", "        scheduled.add((j, o))\r\n\u001b[?2004l\r"]
[490.43926, "o", "\u001b[?2004h>     "]
[490.4393, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[490.439372, "o", "    return schedule\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.439406, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[490.439438, "o", "> "]
[490.439497, "o", "def evaluate(schedule):\r\n\u001b[?2004l\r"]
[490.439528, "o", "\u001b[?2004h> "]
[490.43964, "o", "    makespan = max(op['end'] for op in schedule)\r\n\u001b[?2004l\r"]
[490.439671, "o", "\u001b[?2004h> "]
[490.439891, "o", "    changes = sum(1 for op in schedule if op['machine'] != baseline_ops[(op['job'], op['op'])]['machine'])\r\n\u001b[?2004l\r"]
[490.43992, "o", "\u001b[?2004h> "]
[490.440129, "o", "    shift = sum(abs(op['start'] - baseline_ops[(op['job'], op['op'])]['start']) for op in schedule)\r\n\u001b[?2004l\r"]
[490.440162, "o", "\u001b[?2004h> "]
[490.4404, "o", "    violations = sum(1 for op in schedule if overlaps_downtime(op['machine'], op['start'], op['end'], downtime))\r\n\u001b[?2004l\r"]
[490.440431, "o", "\u001b[?2004h> "]
[490.44054, "o", "    return makespan, changes, shift, violations\r\n\u001b[?2004l\r"]
[490.440577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[490.440608, "o", "\u001b[?2004h> "]
[490.440777, "o", "# Build all choices - for each op, list all valid alternatives\r\n\u001b[?2004l\r"]
[490.440809, "o", "\u001b[?2004h> "]
[490.441028, "o", "all_keys = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\r\n\u001b[?2004l\r"]
[490.441063, "o", "\u001b[?2004h> "]
[490.441096, "o", "\r\n\u001b[?2004l\r"]
[490.44113, "o", "\u001b[?2004h> "]
[490.441286, "o", "# For each operation, determine valid alternatives\r\n\u001b[?2004l\r"]
[490.441331, "o", "\u001b[?2004h> "]
[490.441391, "o", "valid_alts = {}\r\n\u001b[?2004l\r"]
[490.441429, "o", "\u001b[?2004h"]
[490.44146, "o", "> "]
[490.441539, "o", "for key in all_keys:\r\n\u001b[?2004l\r"]
[490.441571, "o", "\u001b[?2004h"]
[490.441601, "o", "> "]
[490.441661, "o", "    j, o = key\r\n\u001b[?2004l\r"]
[490.441695, "o", "\u001b[?2004h"]
[490.441728, "o", "> "]
[490.441831, "o", "    baseline_op = baseline_ops[key]\r\n\u001b[?2004l\r"]
[490.441864, "o", "\u001b[?2004h> "]
[490.44198, "o", "    is_frozen = baseline_op['start'] < freeze_until\r\n\u001b[?2004l\r"]
[490.442012, "o", "\u001b[?2004h> "]
[490.442255, "o", "    has_violation = overlaps_downtime(baseline_op['machine'], baseline_op['start'], baseline_op['end'], downtime)\r\n\u001b[?2004l\r"]
[490.442292, "o", "\u001b[?2004h>     "]
[490.442327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[490.442413, "o", "    if is_frozen and has_violation:\r\n\u001b[?2004l\r"]
[490.442449, "o", "\u001b[?2004h> "]
[490.442526, "o", "        # Must change machine\r\n\u001b[?2004l\r"]
[490.442564, "o", "\u001b[?2004h> "]
[490.442752, "o", "        valid_alts[key] = [(m, d) for m, d in jobs[j][o] if m != baseline_op['machine']]\r\n\u001b[?2004l\r"]
[490.442784, "o", "\u001b[?2004h> "]
[490.442849, "o", "    elif is_frozen:\r\n\u001b[?2004l\r"]
[490.442885, "o", "\u001b[?2004h> "]
[490.443, "o", "        # Must keep machine (frozen without violation)\r\n\u001b[?2004l\r"]
[490.443036, "o", "\u001b[?2004h> "]
[490.443236, "o", "        valid_alts[key] = [(m, d) for m, d in jobs[j][o] if m == baseline_op['machine']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.443269, "o", "> "]
[490.443304, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.443338, "o", "> "]
[490.443487, "o", "        # Can use any alternative\r\n\u001b[?2004l\r"]
[490.443541, "o", "\u001b[?2004h> "]
[490.443643, "o", "        valid_alts[key] = jobs[j][o]\r\n\u001b[?2004l\r"]
[490.443679, "o", "\u001b[?2004h"]
[490.443708, "o", "> \r\n\u001b[?2004l\r"]
[490.443741, "o", "\u001b[?2004h> "]
[490.44384, "o", "print(\"Valid alternatives:\")\r\n\u001b[?2004l\r"]
[490.443873, "o", "\u001b[?2004h> "]
[490.443991, "o", "for key in sorted(valid_alts.keys()):\r\n\u001b[?2004l\r"]
[490.444034, "o", "\u001b[?2004h"]
[490.444064, "o", "> "]
[490.444194, "o", "    baseline_m = baseline_ops[key]['machine']\r\n\u001b[?2004l\r"]
[490.444337, "o", "\u001b[?2004h> "]
[490.444441, "o", "    print(f\"  {key}: baseline M{baseline_m}, valid: {valid_alts[key]}\")\r\n\u001b[?2004l\r"]
[490.44449, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[490.444527, "o", "\u001b[?2004h> "]
[490.444672, "o", "# Try all combinations (brute force for small problem)\r\n\u001b[?2004l\r"]
[490.444725, "o", "\u001b[?2004h> "]
[490.444802, "o", "best_schedule = None\r\n\u001b[?2004l\r"]
[490.444834, "o", "\u001b[?2004h> "]
[490.445004, "o", "best_score = (float('inf'), float('inf'), float('inf'))\r\n\u001b[?2004l\r"]
[490.445045, "o", "\u001b[?2004h> "]
[490.445078, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.445114, "o", "> "]
[490.445265, "o", "# Generate all possible choice combinations\r\n\u001b[?2004l\r"]
[490.445301, "o", "\u001b[?2004h> "]
[490.445505, "o", "alt_lists = [[(key, alt) for alt in valid_alts[key]] for key in all_keys]\r\n\u001b[?2004l\r"]
[490.445551, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[490.445582, "o", "\u001b[?2004h"]
[490.445616, "o", "> "]
[490.445808, "o", "print(f\"\\nTotal combinations: {sum(1 for _ in product(*alt_lists))}\")\r\n\u001b[?2004l\r"]
[490.445844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[490.445883, "o", "\u001b[?2004h> "]
[490.445995, "o", "for combo in product(*alt_lists):\r\n\u001b[?2004l\r"]
[490.446035, "o", "\u001b[?2004h> "]
[490.446181, "o", "    choices = {key: alt for key, alt in combo}\r\n\u001b[?2004l\r"]
[490.446216, "o", "\u001b[?2004h"]
[490.446269, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[490.446312, "o", "> "]
[490.446348, "o", "    # Count changes\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.446381, "o", "> "]
[490.446622, "o", "    changes = sum(1 for key, (m, d) in choices.items() if m != baseline_ops[key]['machine'])\r\n\u001b[?2004l\r"]
[490.44666, "o", "\u001b[?2004h> "]
[490.446735, "o", "    if changes > max_changes:\r\n\u001b[?2004l\r"]
[490.446767, "o", "\u001b[?2004h> "]
[490.446819, "o", "        continue\r\n\u001b[?2004l\r"]
[490.446848, "o", "\u001b[?2004h"]
[490.446893, "o", ">     \r\n\u001b[?2004l\r"]
[490.44692, "o", "\u001b[?2004h> "]
[490.447012, "o", "    schedule = schedule_with_choices(choices)\r\n\u001b[?2004l\r"]
[490.447042, "o", "\u001b[?2004h"]
[490.447073, "o", "> "]
[490.447117, "o", "    if schedule:\r\n\u001b[?2004l\r"]
[490.447147, "o", "\u001b[?2004h> "]
[490.447312, "o", "        makespan, changes, shift, violations = evaluate(schedule)\r\n\u001b[?2004l\r"]
[490.447354, "o", "\u001b[?2004h> "]
[490.447406, "o", "        \r\n\u001b[?2004l\r"]
[490.447448, "o", "\u001b[?2004h"]
[490.447479, "o", "> "]
[490.447755, "o", "        if violations == 0 and changes <= max_changes and shift <= max_shift and makespan <= max_makespan:\r\n\u001b[?2004l\r"]
[490.447803, "o", "\u001b[?2004h"]
[490.44783, "o", "> "]
[490.448165, "o", "            if makespan < best_score[0] or (makespan == best_score[0] and (changes, shift) < (best_score[1], best_score[2])):\r\n\u001b[?2004l\r"]
[490.448219, "o", "\u001b[?2004h"]
[490.448247, "o", "> "]
[490.448383, "o", "                best_score = (makespan, changes, shift)\r\n\u001b[?2004l\r"]
[490.44843, "o", "\u001b[?2004h> "]
[490.448559, "o", "                best_schedule = schedule\r\n\u001b[?2004l\r"]
[490.448598, "o", "\u001b[?2004h> "]
[490.448996, "o", "                print(f\"Found: makespan={makespan}, changes={changes}, shift={shift}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[490.449068, "o", "if best_schedule:\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.450534, "o", "> "]
[490.450607, "o", "    schedule = best_schedule\r\n\u001b[?2004l\r\u001b[?2004h>     makespan, changes, shift, violations = evaluate(schedule)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\nBest: makespan={makespan}, changes={changes}, shift={shift}\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h>         baseline_op = baseline_ops[(op['job'], op['op'])]\r\n\u001b[?2004l\r\u001b[?2004h>         changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[490.450824, "o", "        print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}]\")\r\n\u001b[?2004l\r"]
[490.450861, "o", "\u001b[?2004h"]
[490.450901, "o", ">     "]
[490.450933, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[490.450967, "o", "> "]
[490.451204, "o", "    solution = {\"status\": \"FEASIBLE\", \"makespan\": makespan, \"schedule\": schedule}\r\n\u001b[?2004l\r"]
[490.451242, "o", "\u001b[?2004h>     "]
[490.451271, "o", "\r\n\u001b[?2004l\r"]
[490.451308, "o", "\u001b[?2004h> "]
[490.451464, "o", "    with open('/app/output/solution.json', 'w') as f:\r\n\u001b[?2004l\r"]
[490.451504, "o", "\u001b[?2004h> "]
[490.451617, "o", "        json.dump(solution, f, indent=2)\r\n\u001b[?2004l\r"]
[490.451651, "o", "\u001b[?2004h> "]
[490.451682, "o", "    \r\n\u001b[?2004l\r"]
[490.451712, "o", "\u001b[?2004h> "]
[490.451888, "o", "    with open('/app/output/schedule.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[490.452019, "o", "        f.write('job,op,machine,start,end,dur\\n')\r\n\u001b[?2004l\r"]
[490.452054, "o", "\u001b[?2004h> "]
[490.452147, "o", "        for op in schedule:\r\n\u001b[?2004l\r"]
[490.45218, "o", "\u001b[?2004h> "]
[490.453686, "o", "            f.write(f\"{op['job']},{op['op']},{op['machine']},{op['start']},{op['end']},{op['dur']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"\\nSaved!\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"No feasible solution!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[490.557232, "o", "\u001b[?2004hroot@65eabde849fa:/app# "]
[491.348605, "i", "python3 /app/solve.py\n"]
