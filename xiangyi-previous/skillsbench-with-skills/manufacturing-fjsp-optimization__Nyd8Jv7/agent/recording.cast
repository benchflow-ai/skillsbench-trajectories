[491.371234, "o", "Valid alternatives:\r\n  (0, 0): baseline M1, valid: [(1, 5)]\r\n  (0, 1): baseline M2, valid: [(2, 6)]\r\n  (0, 2): baseline M0, valid: [(0, 5), (2, 8)]\r\n  (1, 0): baseline M0, valid: [(0, 5)]\r\n  (1, 1): baseline M1, valid: [(1, 6), (2, 5)]\r\n  (1, 2): baseline M0, valid: [(0, 7), (1, 8)]\r\n  (2, 0): baseline M1, valid: [(2, 6)]\r\n  (2, 1): baseline M0, valid: [(0, 8), (1, 7)]\r\n  (2, 2): baseline M2, valid: [(0, 6), (2, 5)]\r\n  (3, 0): baseline M0, valid: [(0, 7)]\r\n  (3, 1): baseline M1, valid: [(1, 5), (2, 7)]\r\n"]
