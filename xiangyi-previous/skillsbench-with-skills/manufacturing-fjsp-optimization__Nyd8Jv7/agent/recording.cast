[573.620891, "i", "python3 -c \"\nimport json\n\n# Load solution\nwith open('/app/output/solution.json') as f:\n    sol = json.load(f)\n\n# Load baseline and policy\nwith open('/app/data/baseline_solution.json') as f:\n    baseline = json.load(f)\nwith open('/app/data/policy.json') as f:\n    policy = json.load(f)\n\n# Check constraints\nprint('=== SOLUTION VERIFICATION ===')\nprint(f'Status: {sol[\\\"status\\\"]}')\nprint(f'Makespan: {sol[\\\"makespan\\\"]}')\nprint(f'Operations scheduled: {len(sol[\\\"schedule\\\"])}')\nprint()\n\n# Downtime windows\ndowntime = {1: [(5, 20)], 2: [(12, 25)]}\n\nviolations = 0\nfor op in sol['schedule']:\n    m = op['machine']\n    if m in downtime:\n        for ds, de in downtime[m]:\n            if op['start'] < de and op['end'] > ds:\n                print(f'VIOLATION: Job {op[\\\"job\\\"]} Op {op[\\\"op\\\"]} on M{m} [{op[\\\"start\\\"]}-{op[\\\"end\\\"]}]')\n                violations += 1\n\nprint(f'Downtime violations: {violations}')\n\n# Machine changes\nbaseline_ops = {(op['job'], op['op']): op for op in baseline['schedule']}\nchanges = sum(1 for op in sol['schedule'] if op['machine'] != baseline_ops[(op['job'], op['op'])]['machine'])\nprint(f'Machine changes: {changes} (max: {policy[\\\"change_budget\\\"][\\\"max_machine_changes\\\"]})')\n\n# Start shift\nshift = sum(abs(op['start'] - baseline_ops[(op['job'], op['op'])]['start']) for op in sol['schedule'])\nprint(f'Start shift L1: {shift} (max: {policy[\\\"change_budget\\\"][\\\"max_total_start_shift_L1\\\"]})')\n\n# Makespan ratio\nmax_ms = baseline['makespan'] * policy['guards']['max_makespan_ratio']\nprint(f'Max makespan allowed: {max_ms}')\n\nprint()\nif violations == 0 and changes <= 4 and shift <= 120 and sol['makespan'] <= max_ms:\n    print('ALL CONSTRAINTS SATISFIED - SOLUTION IS VALID')\nelse:\n    print('SOLUTION INVALID')\n\"\n"]
