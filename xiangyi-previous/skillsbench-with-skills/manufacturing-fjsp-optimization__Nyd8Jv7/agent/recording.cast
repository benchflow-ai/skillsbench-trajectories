[306.289267, "o", "freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.289452, "o", "max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r"]
[306.289473, "o", "\u001b[?2004h> "]
[306.289674, "o", "max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r"]
[306.289695, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[306.289713, "o", "\u001b[?2004h> "]
[306.289906, "o", "# Only Job 2 Op 0 is frozen AND has violation - must change machine\r\n\u001b[?2004l\r"]
[306.289934, "o", "\u001b[?2004h> "]
[306.290062, "o", "# Others can keep machine but shift timing\r\n\u001b[?2004l\r"]
[306.290085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[306.290105, "o", "\u001b[?2004h> "]
[306.290373, "o", "def schedule_greedy(jobs, downtime, baseline_ops, num_machines, frozen_must_change):\r\n\u001b[?2004l\r"]
[306.290395, "o", "\u001b[?2004h> "]
[306.290644, "o", "    \"\"\"Greedy scheduler that keeps baseline machines when possible.\"\"\"\r\n\u001b[?2004l\r"]
[306.290665, "o", "\u001b[?2004h> "]
[306.290837, "o", "    machine_available = [0] * num_machines\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.290859, "o", "> "]
[306.290915, "o", "    schedule = []\r\n\u001b[?2004l\r"]
[306.290938, "o", "\u001b[?2004h> "]
[306.290974, "o", "    \r\n\u001b[?2004l\r"]
[306.291, "o", "\u001b[?2004h> "]
[306.291252, "o", "    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.291273, "o", "> "]
[306.291358, "o", "    scheduled = set()\r\n\u001b[?2004l\r"]
[306.291376, "o", "\u001b[?2004h> "]
[306.291397, "o", "    \r\n\u001b[?2004l\r"]
[306.291417, "o", "\u001b[?2004h> "]
[306.29155, "o", "    while len(scheduled) < len(all_ops):\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.291572, "o", "> "]
[306.291641, "o", "        best = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.291666, "o", "> "]
[306.29178, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r"]
[306.291799, "o", "\u001b[?2004h> "]
[306.291911, "o", "        best_machine = None\r\n\u001b[?2004l\r"]
[306.291931, "o", "\u001b[?2004h> "]
[306.292026, "o", "        best_duration = None\r\n\u001b[?2004l\r"]
[306.292046, "o", "\u001b[?2004h> "]
[306.292093, "o", "        \r\n\u001b[?2004l\r"]
[306.292113, "o", "\u001b[?2004h"]
[306.292138, "o", "> "]
[306.292223, "o", "        for j, o in all_ops:\r\n\u001b[?2004l\r"]
[306.292245, "o", "\u001b[?2004h> "]
[306.292343, "o", "            if (j, o) in scheduled:\r\n\u001b[?2004l\r"]
[306.292363, "o", "\u001b[?2004h> "]
[306.292438, "o", "                continue\r\n\u001b[?2004l\r"]
[306.292455, "o", "\u001b[?2004h> "]
[306.292622, "o", "            if o > 0 and (j, o-1) not in scheduled:\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.292647, "o", "> "]
[306.292819, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.293792, "o", "            \r\n\u001b[?2004l\r"]
[306.295536, "o", "\u001b[?2004h>             baseline_op = baseline_ops[(j, o)]\r\n\u001b[?2004l\r\u001b[?2004h>             alternatives = jobs[j][o]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Determine which machines to try\r\n\u001b[?2004l\r\u001b[?2004h>             if (j, o) in frozen_must_change:\r\n\u001b[?2004l\r\u001b[?2004h>                 # Must use different machine\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.295939, "o", "                try_machines = [(m, d) for m, d in alternatives if m != baseline_op['machine']]\r\n\u001b[?2004l\r"]
[306.295977, "o", "\u001b[?2004h"]
[306.296112, "o", "> "]
[306.296259, "o", "            else:\r\n\u001b[?2004l\r"]
[306.29634, "o", "\u001b[?2004h> "]
[306.29675, "o", "                # Prefer baseline machine, but can use others\r\n\u001b[?2004l\r"]
[306.296782, "o", "\u001b[?2004h> "]
[306.297325, "o", "                baseline_alts = [(m, d) for m, d in alternatives if m == baseline_op['machine']]\r\n"]
[306.297358, "o", "\u001b[?2004l\r"]
[306.297388, "o", "\u001b[?2004h> "]
[306.297631, "o", "                other_alts = [(m, d) for m, d in alternatives if m != baseline_op['machine']]"]
[306.29766, "o", "\r\n\u001b[?2004l\r"]
[306.297707, "o", "\u001b[?2004h> "]
[306.29786, "o", "                try_machines = baseline_alts + other_alts\r\n\u001b[?2004l\r"]
[306.297903, "o", "\u001b[?2004h> "]
[306.297968, "o", "            \r\n\u001b[?2004l\r"]
[306.298014, "o", "\u001b[?2004h> "]
[306.298153, "o", "            for machine, duration in try_machines:\r\n\u001b[?2004l\r"]
[306.298182, "o", "\u001b[?2004h"]
[306.298211, "o", "> "]
[306.298301, "o", "                prev_end = 0\r\n"]
[306.29833, "o", "\u001b[?2004l\r"]
[306.29836, "o", "\u001b[?2004h> "]
[306.298446, "o", "                if o > 0:\r\n"]
[306.298476, "o", "\u001b[?2004l\r"]
[306.298506, "o", "\u001b[?2004h> "]
[306.29862, "o", "                    for s in schedule:\r\n"]
[306.298651, "o", "\u001b[?2004l\r"]
[306.298686, "o", "\u001b[?2004h> "]
[306.298843, "o", "                        if s['job'] == j and s['op'] == o - 1:\r\n\u001b[?2004l\r"]
[306.298895, "o", "\u001b[?2004h> "]
[306.299023, "o", "                            prev_end = s['end']\r\n\u001b[?2004l\r"]
[306.299066, "o", "\u001b[?2004h> "]
[306.299162, "o", "                            break\r\n\u001b[?2004l\r"]
[306.299192, "o", "\u001b[?2004h> "]
[306.299268, "o", "                \r\n"]
[306.299306, "o", "\u001b[?2004l\r\u001b[?2004h"]
[306.299336, "o", "> "]
[306.299491, "o", "                earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r"]
[306.299534, "o", "\u001b[?2004h> "]
[306.299741, "o", "                start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r"]
[306.299792, "o", "\u001b[?2004h> "]
[306.299847, "o", "                \r\n\u001b[?2004l\r"]
[306.299877, "o", "\u001b[?2004h"]
[306.299909, "o", "> "]
[306.300121, "o", "                # For non-frozen-must-change, prefer baseline machine even if later"]
[306.300164, "o", "\r\n\u001b[?2004l\r"]
[306.300193, "o", "\u001b[?2004h"]
[306.300225, "o", "> "]
[306.300447, "o", "                if (j, o) not in frozen_must_change and machine == baseline_op['machine']:"]
[306.300477, "o", "\r\n"]
[306.300504, "o", "\u001b[?2004l\r"]
[306.300534, "o", "\u001b[?2004h> "]
[306.300723, "o", "                    # Use baseline machine with adjusted timing"]
[306.30076, "o", "\r\n\u001b[?2004l\r"]
[306.300793, "o", "\u001b[?2004h> "]
[306.301025, "o", "                    if start < best_start or best_machine != baseline_op['machine']:"]
[306.301056, "o", "\r\n\u001b[?2004l\r"]
[306.301085, "o", "\u001b[?2004h"]
[306.301115, "o", "> "]
[306.301205, "o", "                        best = (j, o)\r\n\u001b[?2004l\r"]
[306.301302, "o", "\u001b[?2004h"]
[306.301336, "o", "> "]
[306.301433, "o", "                        best_start = start\r\n\u001b[?2004l\r"]
[306.301505, "o", "\u001b[?2004h"]
[306.301534, "o", "> "]
[306.30167, "o", "                        best_machine = machine"]
[306.301701, "o", "\r\n\u001b[?2004l\r"]
[306.301732, "o", "\u001b[?2004h> "]
[306.301867, "o", "                        best_duration = duration"]
[306.301897, "o", "\r\n\u001b[?2004l\r"]
[306.301927, "o", "\u001b[?2004h"]
[306.301957, "o", "> "]
[306.302152, "o", "                    break  # Don't try other machines if baseline works\r\n"]
[306.302184, "o", "\u001b[?2004l\r"]
[306.30222, "o", "\u001b[?2004h"]
[306.30226, "o", "> "]
[306.302381, "o", "                elif start < best_start:"]
[306.302416, "o", "\r\n\u001b[?2004l\r"]
[306.302454, "o", "\u001b[?2004h> "]
[306.302568, "o", "                    best = (j, o)\r\n"]
[306.302598, "o", "\u001b[?2004l\r\u001b[?2004h"]
[306.30263, "o", "> "]
[306.302742, "o", "                    best_start = start"]
[306.302775, "o", "\r\n\u001b[?2004l\r"]
[306.302804, "o", "\u001b[?2004h> "]
[306.302938, "o", "                    best_machine = machine"]
[306.302973, "o", "\r\n\u001b[?2004l\r"]
[306.303003, "o", "\u001b[?2004h"]
[306.303031, "o", "> "]
[306.303155, "o", "                    best_duration = duration"]
[306.303184, "o", "\r\n\u001b[?2004l\r"]
[306.303215, "o", "\u001b[?2004h"]
[306.303242, "o", "> "]
[306.303275, "o", "        \r\n\u001b[?2004l\r"]
[306.303303, "o", "\u001b[?2004h"]
[306.303332, "o", "> "]
[306.303416, "o", "        if best is None:\r\n"]
[306.303442, "o", "\u001b[?2004l\r\u001b[?2004h"]
[306.30347, "o", "> "]
[306.303638, "o", "            print(\"ERROR: Cannot schedule any operation\")"]
[306.303667, "o", "\r\n\u001b[?2004l\r"]
[306.30526, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         j, o = best\r\n\u001b[?2004l\r\u001b[?2004h>         schedule.append({\r\n\u001b[?2004l\r\u001b[?2004h>             'job': j,\r\n\u001b[?2004l\r\u001b[?2004h>             'op': o,\r\n\u001b[?2004l\r\u001b[?2004h>             'machine': best_machine,\r\n\u001b[?2004l\r\u001b[?2004h>             'start': best_start,\r\n\u001b[?2004l\r\u001b[?2004h>             'end': best_start + best_duration,\r\n\u001b[?2004l\r\u001b[?2004h>             'dur': best_duration\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         machine_available[best_machine] = best_start + best_duration"]
[306.305295, "o", "\r\n\u001b[?2004l\r"]
[306.305343, "o", "\u001b[?2004h> "]
[306.305439, "o", "        scheduled.add((j, o))\r\n"]
[306.305474, "o", "\u001b[?2004l\r\u001b[?2004h"]
[306.305506, "o", ">     \r\n\u001b[?2004l\r"]
[306.305534, "o", "\u001b[?2004h"]
[306.305561, "o", "> "]
[306.305628, "o", "    return schedule"]
[306.305655, "o", "\r\n\u001b[?2004l\r"]
[306.305687, "o", "\u001b[?2004h> "]
[306.305716, "o", "\r\n\u001b[?2004l\r"]
[306.305745, "o", "\u001b[?2004h> "]
[306.305917, "o", "# Only frozen operations with violations must change machine\r\n\u001b[?2004l\r"]
[306.305957, "o", "\u001b[?2004h> "]
[306.30614, "o", "frozen_must_change = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.306184, "o", "> for key, op in baseline_ops.items():\r\n\u001b[?2004l\r"]
[306.30622, "o", "\u001b[?2004h> "]
[306.306364, "o", "    is_frozen = op['start'] < freeze_until"]
[306.3064, "o", "\r\n\u001b[?2004l\r"]
[306.306435, "o", "\u001b[?2004h> "]
[306.308081, "o", "    has_violation = overlaps_downtime(op['machine'], op['start'], op['end'], downtime)"]
[306.308124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if is_frozen and has_violation:\r\n\u001b[?2004l\r\u001b[?2004h>         frozen_must_change.add(key)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Frozen operations that must change machine: {frozen_must_change}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> schedule = schedule_greedy(jobs, downtime, baseline_ops, num_machines, frozen_must_change)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Evaluate\r\n\u001b[?2004l\r\u001b[?2004h> makespan = max(op['end'] for op in schedule)\r\n\u001b[?2004l\r\u001b[?2004h> machine_changes = 0\r\n\u001b[?2004l\r\u001b[?2004h> start_shift = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.308184, "o", "violations = 0\r\n\u001b[?2004l\r"]
[306.308216, "o", "\u001b[?2004h"]
[306.308248, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[306.308276, "o", "> "]
[306.308325, "o", "for op in schedule:\r\n\u001b[?2004l\r"]
[306.308353, "o", "\u001b[?2004h"]
[306.308383, "o", "> "]
[306.308468, "o", "    key = (op['job'], op['op'])\r\n\u001b[?2004l\r"]
[306.30851, "o", "\u001b[?2004h> "]
[306.308615, "o", "    baseline_op = baseline_ops[key]\r\n\u001b[?2004l\r"]
[306.308647, "o", "\u001b[?2004h> "]
[306.308793, "o", "    if op['machine'] != baseline_op['machine']:\r\n\u001b[?2004l\r"]
[306.308853, "o", "\u001b[?2004h> "]
[306.30893, "o", "        machine_changes += 1\r\n\u001b[?2004l\r"]
[306.308971, "o", "\u001b[?2004h"]
[306.308999, "o", "> "]
[306.309164, "o", "    start_shift += abs(op['start'] - baseline_op['start'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.30935, "o", "    if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\r\n\u001b[?2004l\r"]
[306.309432, "o", "\u001b[?2004h> "]
[306.309515, "o", "        violations += 1"]
[306.309545, "o", "\r\n\u001b[?2004l\r"]
[306.309574, "o", "\u001b[?2004h> "]
[306.311116, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[306.311157, "o", "> print(f\"\\nSchedule:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Makespan: {makespan} (baseline: {baseline['makespan']})\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Machine changes: {machine_changes} (max: {max_machine_changes})\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Start shift L1: {start_shift} (max: {max_start_shift})\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Violations: {violations}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> schedule.sort(key=lambda x: (x['start'], x['job'], x['op']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for op in schedule:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.311217, "o", "    baseline_op = baseline_ops[(op['job'], op['op'])]\r\n\u001b[?2004l\r"]
[306.311277, "o", "\u001b[?2004h"]
[306.311312, "o", "> "]
[306.311494, "o", "    changed = \"*\" if op['machine'] != baseline_op['machine'] else \" \""]
[306.311525, "o", "\r\n\u001b[?2004l\r"]
[306.311568, "o", "\u001b[?2004h"]
[306.311596, "o", "> "]
[306.311865, "o", "    print(f\"  {changed} Job {op['job']} Op {op['op']}: M{op['machine']} [{op['start']}-{op['end']}] dur={op['dur']}\")\r\n\u001b[?2004l\r"]
[306.311935, "o", "\u001b[?2004h> "]
[306.311967, "o", "\r\n\u001b[?2004l\r"]
[306.311997, "o", "\u001b[?2004h> "]
[306.312261, "o", "if violations == 0 and machine_changes <= max_machine_changes and start_shift <= max_start_shift:"]
[306.312315, "o", "\r\n\u001b[?2004l\r"]
[306.312342, "o", "\u001b[?2004h"]
[306.312369, "o", "> "]
[306.31244, "o", "    solution = {\r\n\u001b[?2004l\r"]
[306.312481, "o", "\u001b[?2004h> "]
