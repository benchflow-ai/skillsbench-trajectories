[214.488162, "o", "    with open(filename, 'r') as f:\r\n\u001b[?2004l\r"]
[214.488232, "o", "\u001b[?2004h"]
[214.488287, "o", "> "]
[214.488462, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[214.488503, "o", "\u001b[?2004h> "]
[214.488644, "o", "        for row in reader:\r\n\u001b[?2004l\r"]
[214.488718, "o", "\u001b[?2004h> "]
[214.488879, "o", "            m = int(row['machine'])\r\n\u001b[?2004l\r"]
[214.488967, "o", "\u001b[?2004h> "]
[214.489092, "o", "            s = int(row['start'])\r\n\u001b[?2004l\r"]
[214.489158, "o", "\u001b[?2004h> "]
[214.489327, "o", "            e = int(row['end'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.4896, "o", "            if m not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.489797, "o", "                downtime[m] = []\r\n\u001b[?2004l\r"]
[214.489878, "o", "\u001b[?2004h> "]
[214.490068, "o", "            downtime[m].append((s, e))\r\n\u001b[?2004l\r"]
[214.490204, "o", "\u001b[?2004h>     return downtime\r\n\u001b[?2004l\r"]
[214.490323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.49044, "o", "def parse_policy(filename):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.490631, "o", "    with open(filename, 'r') as f:\r\n\u001b[?2004l\r"]
[214.490702, "o", "\u001b[?2004h> "]
[214.490798, "o", "        return json.load(f)\r\n\u001b[?2004l\r"]
[214.490866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.491042, "o", "def parse_baseline(filename):\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.491112, "o", "> "]
[214.491227, "o", "    with open(filename, 'r') as f:\r\n\u001b[?2004l\r"]
[214.491296, "o", "\u001b[?2004h> "]
[214.491379, "o", "        return json.load(f)\r\n\u001b[?2004l\r"]
[214.491446, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.491771, "o", "def overlaps_downtime(machine, start, end, downtime):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.491969, "o", "    if machine not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.492033, "o", "> "]
[214.492097, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.492547, "o", "    for ds, de in downtime[machine]:\r\n\u001b[?2004l\r\u001b[?2004h>         if start < de and end > ds:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.492665, "o", "            return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.492876, "o", "    return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.494309, "o", "def get_available_start(machine, earliest, duration, downtime):\r\n\u001b[?2004l\r\u001b[?2004h>     start = earliest"]
[214.498374, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.498718, "o", ">     if machine not in downtime:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.498963, "o", "        return start\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(100):\r\n\u001b[?2004l\rc\u001b[?2004h> "]
[214.499117, "o", "        end = start + duration\r\n\u001b[?2004l\r\u001b[?2004h>         conflict = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.499303, "o", "        for ds, de in sorted(downtime[machine]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.499532, "o", "            if start < de and end > ds:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.499671, "o", "                start = de\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.49977, "o", "                conflict = True"]
[214.499861, "o", "\r\n\u001b[?2004l\r"]
[214.499943, "o", "\u001b[?2004h> "]
[214.500018, "o", "                break\r\n\u001b[?2004l\r"]
[214.500099, "o", "\u001b[?2004h> "]
[214.50018, "o", "        if not conflict:\r\n\u001b[?2004l\r"]
[214.500258, "o", "\u001b[?2004h> "]
[214.50035, "o", "            return start\r\n\u001b[?2004l\r"]
[214.50044, "o", "\u001b[?2004h> "]
[214.500522, "o", "    return start\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.500597, "o", "> # Load data"]
[214.500667, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.504775, "o", "jobs, num_machines = parse_instance('/app/data/instance.txt')\r\n\u001b[?2004l\r\u001b[?2004h> downtime = parse_downtime('/app/data/downtime.csv')\r\n\u001b[?2004l\r\u001b[?2004h> policy = parse_policy('/app/data/policy.json')\r\n\u001b[?2004l\r\u001b[?2004h> baseline = parse_baseline('/app/data/baseline_solution.json')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> baseline_ops = {}\r\n\u001b[?2004l\r\u001b[?2004h> for op in baseline['schedule']:\r\n\u001b[?2004l\r\u001b[?2004h>     baseline_ops[(op['job'], op['op'])] = op\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> freeze_until = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r\u001b[?2004h> max_machine_changes = policy['change_budget']['max_machine_changes']\r\n\u001b[?2004l\r\u001b[?2004h> max_start_shift = policy['change_budget']['max_total_start_shift_L1']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check which frozen ops have downtime violations - they must change machine\r\n\u001b[?2004l\r\u001b[?2004h> frozen_with_downtime = set()\r\n\u001b[?2004l\r\u001b[?2004h> for key, op in baseline_ops.items():\r\n\u001b[?2004l\r\u001b[?2004h>     if op['start'] < freeze_until:\r\n\u001b[?2004l\r\u001b[?2004h>         if overlaps_downtime(op['machine'], op['start'], op['end'], downtime):\r\n\u001b[?2004l\r\u001b[?2004h>             frozen_with_downtime.add(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.505091, "o", "            print(f\"Frozen with downtime violation: Job {key[0]} Op {key[1]}\")\r\n\u001b[?2004l\r"]
[214.505157, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.505595, "o", "def schedule_jobs(jobs, downtime, baseline_ops, freeze_until, num_machines, frozen_with_downtime):\r\n\u001b[?2004l\r"]
[214.505653, "o", "\u001b[?2004h> "]
[214.505835, "o", "    machine_available = [0] * num_machines\r\n\u001b[?2004l\r"]
[214.505888, "o", "\u001b[?2004h> "]
[214.505969, "o", "    schedule = []\r\n\u001b[?2004l\r"]
[214.506022, "o", "\u001b[?2004h> "]
[214.506125, "o", "    machine_changes = 0\r\n\u001b[?2004l\r"]
[214.506176, "o", "\u001b[?2004h> "]
[214.506293, "o", "    total_start_shift = 0\r\n\u001b[?2004l\r"]
[214.50634, "o", "\u001b[?2004h> "]
[214.506391, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.506623, "o", "    pending = [(j, 0) for j in range(len(jobs))]\r\n\u001b[?2004l\r"]
[214.506672, "o", "\u001b[?2004h> "]
[214.50679, "o", "    scheduled_ops = set()\r\n\u001b[?2004l\r"]
[214.506839, "o", "\u001b[?2004h> "]
[214.506884, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.506978, "o", "    iteration = 0\r\n\u001b[?2004l\r"]
[214.507028, "o", "\u001b[?2004h> "]
[214.507144, "o", "    max_iterations = 1000\r\n\u001b[?2004l\r"]
[214.507195, "o", "\u001b[?2004h> "]
[214.50725, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.507587, "o", "    while pending and iteration < max_iterations:\r\n\u001b[?2004l\r"]
[214.50764, "o", "\u001b[?2004h"]
[214.507687, "o", "> "]
[214.507771, "o", "        iteration += 1\r\n\u001b[?2004l\r"]
[214.507817, "o", "\u001b[?2004h> "]
[214.507912, "o", "        best = None\r\n\u001b[?2004l\r"]
[214.507957, "o", "\u001b[?2004h> "]
[214.508109, "o", "        best_start = float('inf')\r\n\u001b[?2004l\r"]
[214.50816, "o", "\u001b[?2004h> "]
[214.50835, "o", "        best_machine = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.508456, "o", "        best_duration = None\r\n\u001b[?2004l\r"]
[214.508508, "o", "\u001b[?2004h> "]
[214.508557, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.508602, "o", "> "]
[214.508784, "o", "        for j, op_idx in list(pending):\r\n\u001b[?2004l\r"]
[214.508856, "o", "\u001b[?2004h> "]
[214.509038, "o", "            if (j, op_idx) in scheduled_ops:\r\n\u001b[?2004l\r"]
[214.509103, "o", "\u001b[?2004h> "]
[214.509204, "o", "                continue\r\n\u001b[?2004l\r"]
[214.509272, "o", "\u001b[?2004h> "]
[214.509552, "o", "            if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:\r\n\u001b[?2004l\r"]
[214.50962, "o", "\u001b[?2004h> "]
[214.50973, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.509797, "o", "> "]
[214.509865, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.510105, "o", "            baseline_op = baseline_ops.get((j, op_idx))\r\n\u001b[?2004l\r"]
[214.510227, "o", "\u001b[?2004h> "]
[214.51054, "o", "            is_frozen = baseline_op and baseline_op['start'] < freeze_until\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.510862, "o", "            has_downtime_violation = (j, op_idx) in frozen_with_downtime\r\n\u001b[?2004l\r"]
[214.510958, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[214.511046, "o", "\u001b[?2004h> "]
[214.511277, "o", "            alternatives = jobs[j][op_idx]\r\n\u001b[?2004l\r"]
[214.511377, "o", "\u001b[?2004h>             \r\n"]
[214.511457, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[214.511741, "o", "            for machine, duration in alternatives:\r\n\u001b[?2004l\r"]
[214.511835, "o", "\u001b[?2004h> "]
[214.512271, "o", "                # If frozen with downtime violation, must change machine (skip original)\r\n\u001b[?2004l\r"]
[214.512363, "o", "\u001b[?2004h> "]
[214.51288, "o", "                if is_frozen and has_downtime_violation and machine == baseline_op['machine']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.512984, "o", "> "]
[214.513076, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.513188, "o", "                \r\n\u001b[?2004l\r"]
[214.513268, "o", "\u001b[?2004h> "]
[214.514436, "o", "                # If frozen without downtime violation, must keep same machine\r\n\u001b[?2004l\r"]
[214.514556, "o", "\u001b[?2004h> "]
[214.514776, "o", "                if is_frozen and not has_downtime_violation and machine != baseline_op['machine']:\r\n"]
[214.514847, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[214.514919, "o", "                    continue\r\n\u001b[?2004l\r"]
[214.514988, "o", "\u001b[?2004h>                 \r\n\u001b[?2004l\r"]
[214.515052, "o", "\u001b[?2004h> "]
[214.515133, "o", "                # Get previous op end time\r\n\u001b[?2004l\r"]
[214.5152, "o", "\u001b[?2004h> "]
[214.515265, "o", "                prev_end = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.515329, "o", "> "]
[214.515413, "o", "                if op_idx > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.515518, "o", "                    for s in schedule:\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.515585, "o", "> "]
[214.515666, "o", "                        if s['job'] == j and s['op'] == op_idx - 1:\r\n\u001b[?2004l\r"]
[214.51573, "o", "\u001b[?2004h> "]
[214.515836, "o", "                            prev_end = s['end']\r\n\u001b[?2004l\r"]
[214.515882, "o", "\u001b[?2004h> "]
[214.515976, "o", "                            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.516006, "o", ">                 \r\n\u001b[?2004l\r"]
[214.516037, "o", "\u001b[?2004h"]
[214.516079, "o", "> "]
[214.516224, "o", "                earliest = max(machine_available[machine], prev_end)\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.516254, "o", "> "]
[214.516415, "o", "                start = get_available_start(machine, earliest, duration, downtime)\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.516448, "o", "> "]
[214.516484, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.516551, "o", "> "]
[214.516647, "o", "                if start < best_start:\r\n\u001b[?2004l\r"]
[214.516679, "o", "\u001b[?2004h> "]
[214.516799, "o", "                    best = (j, op_idx)\r\n\u001b[?2004l\r"]
[214.516833, "o", "\u001b[?2004h> "]
[214.516942, "o", "                    best_start = start\r\n\u001b[?2004l\r"]
[214.516979, "o", "\u001b[?2004h> "]
[214.517087, "o", "                    best_machine = machine\r\n\u001b[?2004l\r"]
[214.517124, "o", "\u001b[?2004h> "]
[214.517238, "o", "                    best_duration = duration\r\n\u001b[?2004l\r"]
[214.517273, "o", "\u001b[?2004h> "]
[214.517303, "o", "        \r\n\u001b[?2004l\r"]
[214.517345, "o", "\u001b[?2004h"]
[214.517388, "o", "> "]
[214.517422, "o", "        if best is None:"]
[214.517457, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.517489, "o", "> "]
[214.517584, "o", "            # Debug: print what's pending\r\n\u001b[?2004l\r"]
[214.517616, "o", "\u001b[?2004h> "]
[214.517764, "o", "            print(f\"Cannot schedule. Pending: {pending}\")\r\n\u001b[?2004l\r"]
[214.517802, "o", "\u001b[?2004h> "]
[214.517922, "o", "            print(f\"Scheduled: {scheduled_ops}\")\r\n\u001b[?2004l\r"]
[214.517983, "o", "\u001b[?2004h> "]
[214.518074, "o", "            for j, op_idx in pending:\r\n\u001b[?2004l\r"]
[214.518109, "o", "\u001b[?2004h> "]
[214.519685, "o", "                if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:\r\n\u001b[?2004l\r\u001b[?2004h>                     print(f\"  Job {j} Op {op_idx} waiting for Op {op_idx-1}\")\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     print(f\"  Job {j} Op {op_idx} ready but no valid alternative\")\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         j, op_idx = best\r\n\u001b[?2004l\r\u001b[?2004h>         baseline_op = baseline_ops.get((j, op_idx))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if baseline_op:\r\n\u001b[?2004l\r\u001b[?2004h>             if best_machine != baseline_op['machine']:\r\n\u001b[?2004l\r\u001b[?2004h>                 machine_changes += 1\r\n\u001b[?2004l\r\u001b[?2004h>             total_start_shift += abs(best_start - baseline_op['start'])"]
[214.519737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[214.519777, "o", "\u001b[?2004h> "]
[214.519847, "o", "        schedule.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.519902, "o", ">             'job': j,\r\n\u001b[?2004l\r"]
[214.519941, "o", "\u001b[?2004h> "]
[214.519995, "o", "            'op': op_idx,\r\n\u001b[?2004l\r"]
[214.520027, "o", "\u001b[?2004h> "]
[214.52012, "o", "            'machine': best_machine,\r\n\u001b[?2004l\r"]
[214.520151, "o", "\u001b[?2004h> "]
[214.520233, "o", "            'start': best_start,\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.520265, "o", "> "]
[214.520367, "o", "            'end': best_start + best_duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.520461, "o", "            'dur': best_duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.520509, "o", "        })\r\n\u001b[?2004l\r"]
[214.520559, "o", "\u001b[?2004h> "]
[214.520594, "o", "        \r\n\u001b[?2004l\r"]
[214.520631, "o", "\u001b[?2004h> "]
[214.520798, "o", "        machine_available[best_machine] = best_start + best_duration"]
[214.520836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.520945, "o", "        scheduled_ops.add((j, op_idx))\r\n\u001b[?2004l\r"]
[214.520985, "o", "\u001b[?2004h> "]
[214.521025, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.521061, "o", "> "]
[214.521139, "o", "        if op_idx + 1 < len(jobs[j]):\r\n\u001b[?2004l\r"]
[214.521174, "o", "\u001b[?2004h> "]
[214.521278, "o", "            pending.append((j, op_idx + 1))\r\n\u001b[?2004l\r"]
[214.52132, "o", "\u001b[?2004h> "]
[214.521363, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.521546, "o", "        pending = [(jj, oo) for jj, oo in pending if (jj, oo) not in scheduled_ops]"]
[214.521578, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.521609, "o", ">     \r\n"]
[214.521642, "o", "\u001b[?2004l\r\u001b[?2004h"]
[214.521674, "o", "> "]
[214.521774, "o", "    return schedule, machine_changes, total_start_shift\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.521805, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.521855, "o", "> "]
[214.521985, "o", "schedule, machine_changes, total_start_shift = schedule_jobs(\r\n"]
[214.522019, "o", "\u001b[?2004l\r\u001b[?2004h"]
[214.522048, "o", "> "]
[214.522271, "o", "    jobs, downtime, baseline_ops, freeze_until, num_machines, frozen_with_downtime\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[214.522323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
