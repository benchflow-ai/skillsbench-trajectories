AIpRnhcY/hqdefault_15866.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLBOpw51mtfBfB6cujP08Q3GvO0q3A\",\r\n            \"width\": 336,\r\n            \"height\": 188\r\n          }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  {\r\n    \"chapterRenderer\": {\r\n      \"title\": {\r\n        \"simpleText\": \"Getting a floor plan\"\r\n      },\r\n      \"timeRangeStartMillis\": 25000,\r\n      \"onActiveCommand\": {\r\n        \"clickTrackingParams\": \"CM4BEMaHBiITCKXPwt2LqZIDFVeJZQMdfB8rbcoBBG6hwRA=\",\r\n        \"setActivePanelItemAction\": {\r\n          \"panelTargetId\": \"engagement-panel-macro-markers-description-chapters\",\r\n          \"itemIndex\": 2\r\n        }\r\n      },\r\n      \"thumbnail\": {\r\n        \"thumbnails\": [\r\n          {\r\n"]
