[781.04906, "i", "python3 - <<'PY'\nimport re, json, urllib.request\nurl='https://www.youtube.com/watch?v=94kAIpRnhcY'\nhtml=urllib.request.urlopen(url).read().decode('utf-8')\n# extract ytInitialPlayerResponse\nm=re.search(r\"ytInitialPlayerResponse\\s*=\\s*(\\{.*?\\})\\s*;\", html)\nprint('found player response', bool(m))\nif m:\n    data=json.loads(m.group(1))\n    # try to find chapters\n    chapters=None\n    if 'chapters' in data.get('videoDetails', {}):\n        chapters=data['videoDetails']['chapters']\n    # check in data['playerOverlays'] maybe?\n    # search through response for 'chapters'\n    def find_chapters(obj):\n        if isinstance(obj, dict):\n            if 'chapters' in obj:\n                return obj['chapters']\n            for v in obj.values():\n                res=find_chapters(v)\n                if res is not None:\n                    return res\n        elif isinstance(obj, list):\n            for v in obj:\n                res=find_chapters(v)\n                if res is not None:\n                    return res\n        return None\n    chapters = find_chapters(data)\n    print('chapters found', chapters is not None)\n    if chapters:\n        print(json.dumps(chapters[:3], indent=2))\n\n# extract ytInitialData\nm=re.search(r\"ytInitialData\\s*=\\s*(\\{.*?\\})\\s*;\", html)\nprint('found initial data', bool(m))\nif m:\n    data=json.loads(m.group(1))\n    def find_chapters(obj):\n        if isinstance(obj, dict):\n            if 'chapters' in obj:\n                return obj['chapters']\n            for v in obj.values():\n                res=find_chapters(v)\n                if res is not None:\n                    return res\n        elif isinstance(obj, list):\n            for v in obj:\n                res=find_chapters(v)\n                if res is not None:\n                    return res\n        return None\n    chapters=find_chapters(data)\n    print('chapters in initial data', chapters is not None)\n    if chapters:\n        print(json.dumps(chapters[:3], indent=2))\nPY\n"]
[781.049255, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
