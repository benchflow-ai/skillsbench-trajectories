[815.901011, "i", "python3 - <<'PY'\nimport urllib.request, json\nurl='https://www.youtube.com/watch?v=94kAIpRnhcY'\nhtml=urllib.request.urlopen(url).read().decode('utf-8')\n\ndef extract_json(varname):\n    idx = html.find(varname)\n    if idx==-1:\n        return None\n    start = html.find('{', idx)\n    if start==-1:\n        return None\n    depth=0\n    for i in range(start, len(html)):\n        if html[i]=='{':\n            depth+=1\n        elif html[i]=='}':\n            depth-=1\n            if depth==0:\n                return html[start:i+1]\n    return None\n\ndef find_chapters(obj):\n    if isinstance(obj, dict):\n        if 'chapters' in obj:\n            return obj['chapters']\n        for v in obj.values():\n            res = find_chapters(v)\n            if res is not None:\n                return res\n    elif isinstance(obj, list):\n        for v in obj:\n            res = find_chapters(v)\n            if res is not None:\n                return res\n    return None\n\njs = extract_json('ytInitialData')\nif not js:\n    raise SystemExit('ytInitialData not found')\nobj = json.loads(js)\nchapters = find_chapters(obj)\nprint('chapters count', len(chapters))\nfor ch in chapters:\n    r = ch.get('chapterRenderer', {})\n    title = r.get('title', {}).get('simpleText')\n    t_ms = r.get('timeRangeStartMillis')\n    print(title, t_ms/1000)\nPY\n"]
