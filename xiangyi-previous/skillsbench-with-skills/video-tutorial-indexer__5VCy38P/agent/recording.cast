[781.786714, "o", "\u001b[?2004hroot@400fe2102d25:~# "]
[801.3472, "i", "python3 - <<'PY'\nimport urllib.request, re, json\nurl='https://www.youtube.com/watch?v=94kAIpRnhcY'\nhtml=urllib.request.urlopen(url).read().decode('utf-8')\n\ndef extract_json(varname):\n    idx = html.find(varname)\n    if idx==-1:\n        return None\n    # find first '{' after varname\n    start = html.find('{', idx)\n    if start==-1:\n        return None\n    # bracket matching\n    depth=0\n    for i in range(start, len(html)):\n        if html[i]=='{':\n            depth+=1\n        elif html[i]=='}':\n            depth-=1\n            if depth==0:\n                end=i+1\n                return html[start:end]\n    return None\n\ndef find_chapters(obj):\n    if isinstance(obj, dict):\n        if 'chapters' in obj:\n            return obj['chapters']\n        for v in obj.values():\n            res = find_chapters(v)\n            if res is not None:\n                return res\n    elif isinstance(obj, list):\n        for v in obj:\n            res = find_chapters(v)\n            if res is not None:\n                return res\n    return None\n\nfor var in ['ytInitialPlayerResponse', 'ytInitialData']:\n    js = extract_json(var)\n    print(var, 'found', js is not None)\n    if js:\n        try:\n            data=json.loads(js)\n        except Exception as e:\n            print('json load error', e)\n            continue\n        chapters = find_chapters(data)\n        print('chapters found', chapters is not None)\n        if chapters:\n            print('chapters type', type(chapters), 'len', len(chapters))\n            print(json.dumps(chapters[:2], indent=2))\n            break\nPY\n"]
