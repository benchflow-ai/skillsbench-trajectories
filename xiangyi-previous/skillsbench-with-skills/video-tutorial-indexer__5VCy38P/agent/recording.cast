[781.050291, "o", "print('found player response', bool(m))\r\n\u001b[?2004l\r\u001b[?2004h> if m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.05036, "o", "    data=json.loads(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h"]
