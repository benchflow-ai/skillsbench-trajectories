[100.681232, "o", "python3 -c \"import geopandas as gpd; df = gpd.read_file('/root/earthquakes_2024.json'); print(df.columns); print(df.index.name)\"\r\n\u001b[?2004l\r"]
[101.483239, "o", "Index(['id', 'mag', 'place', 'time', 'updated', 'tz', 'url', 'detail', 'felt',\r\n       'cdi', 'mmi', 'alert', 'status', 'tsunami', 'sig', 'net', 'code', 'ids',\r\n       'sources', 'types', 'nst', 'dmin', 'rms', 'gap', 'magType', 'type',\r\n       'title', 'geometry'],\r\n      dtype='object')\r\nNone\r\n"]
[101.570987, "o", "\u001b[?2004hroot@484926532b24:~# "]
[124.281528, "i", "cat << 'EOF' > solve_earthquake.py\nimport geopandas as gpd\nimport pandas as pd\nimport json\nfrom datetime import datetime, timezone\n\n# Load data\nprint(\"Loading data...\")\neq = gpd.read_file('/root/earthquakes_2024.json')\nplates = gpd.read_file('/root/PB2002_plates.json')\nboundaries = gpd.read_file('/root/PB2002_boundaries.json')\n\n# Get Pacific Plate\npacific_plate_row = plates[plates['Code'] == 'PA']\nif len(pacific_plate_row) == 0:\n    raise ValueError(\"Pacific plate not found\")\npacific_plate_geom = pacific_plate_row.geometry.iloc[0]\n\n# Ensure CRS matches (should be 4326)\nif eq.crs != plates.crs:\n    eq = eq.to_crs(plates.crs)\n\nprint(\"Filtering earthquakes within Pacific plate...\")\n# Filter earthquakes within Pacific Plate\n# Check validity of plate geom just in case\nif not pacific_plate_geom.is_valid:\n    pacific_plate_geom = pacific_plate_geom.buffer(0)\n\nin_pacific = eq.within(pacific_plate_geom)\neq_pacific = eq[in_pacific].copy()\nprint(f\"Found {len(eq_pacific)} earthquakes in Pacific plate.\")\n\n# Get Pacific Boundaries\nprint(\"Filtering boundaries...\")\npacific_boundaries = boundaries[(boundaries['PlateA'] == 'PA') | (boundaries['PlateB'] == 'PA')]\nboundary_geom = pacific_boundaries.unary_union\n\n# Project to a Pacific-centered equidistant projection\n# Using Equidistant Cylindrical centered at 150W\ncustom_crs = '+proj=eqc +lat_ts=0 +lat_0=0 +lon_0=-150 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs'\n\nprint(\"Projecting data...\")\neq_pacific_proj = eq_pacific.to_crs(custom_crs)\nboundary_proj = gpd.GeoSeries([boundary_geom], crs=boundaries.crs).to_crs(custom_crs).iloc[0]\n\n# Calculate distances\nprint(\"Calculating distances...\")\neq_pacific['distance_km'] = eq_pacific_proj.distance(boundary_proj) / 1000.0\n\n# Find max distance\nif len(eq_pacific) == 0:\n    print(\"No earthquakes found in Pacific plate.\")\n    exit(1)\n\nfurthest_idx = eq_pacific['distance_km'].idxmax()\nfurthest_eq = eq_pacific.loc[furthest_idx]\n\nprint(f\"Furthest earthquake ID: {furthest_eq['id']} at {furthest_eq['distance_km']:.2f} km\")\n\n# Format time\nts = furthest_eq['time']\n# Input is ms timestamp\ndt = datetime.fromtimestamp(ts / 1000.0, tz=timezone.utc)\ntime_str = dt.strftime('%Y-%m-%dT%H:%M:%SZ')\n\noutput = {\n    \"id\": furthest_eq['id'],\n    \"place\": furthest_eq['place'],\n    \"time\": time_str,\n    \"magnitude\": furthest_eq['mag'],\n    \"latitude\": furthest_eq.geometry.y,\n    \"longitude\": furthest_eq.geometry.x,\n    \"distance_km\": round(furthest_eq['distance_km'], 2)\n}\n\nwith open('/root/answer.json', 'w') as f:\n    json.dump(output, f, indent=2)\n    \nprint(\"Done. Result saved to /root/answer.json\")\nEOF\n"]
