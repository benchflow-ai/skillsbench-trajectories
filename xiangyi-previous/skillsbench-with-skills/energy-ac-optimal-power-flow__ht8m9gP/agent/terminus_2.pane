[?2004l[?2004h> 
[?2004ln[?2004h> is_quadratic = any(g['c2'] > 1e-6 for g in gen_data)
[?2004l[?2004h> if is_quadratic:
[?2004l [?2004h>     lam_min = min(g['c1'] for g in gen_data)
[?2004l[?2004h>     lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)
[?2004l[?2004h>     for _ in range(50):
[?2004l[?2004h>         lam = (lam_min + lam_max) / 2
[?2004l[?2004h>         p_sum = 0
[?2004l[?2004h>         for g in gen_data:
[?2004l[?2004h>             if g['c2'] > 1e-6: p = (lam - g['c1']) / (2*g['c2'])
[?2004l[?2004h>             else: p = g['pmax'] if lam > g['c1'] else g['pmin']
[?2004l[?2004h>             p = max(g['pmin'], min(g['pmax'], p))
[?2004l[?2004h>             p_sum += p
[?2004l[?2004h>         if abs(p_sum - total_gen_req) < 1e-2: break
[?2004l[?2004h>         if p_sum > total_gen_req: lam_max = lam
[?2004l[?2004h>         else: lam_min = lam
[?2004l[?2004h>     for g in gen_data:
