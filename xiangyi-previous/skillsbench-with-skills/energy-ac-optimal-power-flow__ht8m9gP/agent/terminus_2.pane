[?2004l[?2004h> 
[?2004l[?2004h>         z = complex(r, x)
[?2004l[?2004h>         y = 1.0 / z
[?2004l[?2004h>         bc = complex(0, b_chg / 2.0)
[?2004l[?2004h>         
[?2004l[?2004h>         # Transformer model
[?2004l[?2004h>         if tap == 0: tap = 1.0
[?2004l[?2004h>         tr = tap * cmath.exp(1j * math.radians(shift))
[?2004l[?2004h>         
[?2004l[?2004h>         Y[i][i] += (y + bc) / (abs(tr)**2)
[?2004l[?2004h>         Y[j][j] += (y + bc)
[?2004l[?2004h>         Y[i][j] -= y / tr.conjugate()
[?2004l[?2004h>         Y[j][i] -= y / tr
[?2004l[?2004h>         
[?2004l[?2004h>     return Y, bus_map
[?2004l[?2004h> 
[?2004l [?2004h> def run_power_flow(buses, gens, branches, baseMVA):
[?2004l[?2004h>     nb = len(buses)
[?2004l[?2004h>     Y, bus_map = get_ybus(buses, branches)
[?2004l[?2004h>     
[?2004l[?2004h>     # Initial State
[?2004l[?2004h>     Vm = [b[7] for b in buses]
[?2004l[?2004h>     Va = [math.radians(b[8]) for b in buses]
[?2004l[?2004h>     
[?2004l[?2004h>     # Bus Types: 1=PQ, 2=PV, 3=Slack
[?2004l[?2004h>     bus_types = [int(b[1]) for b in buses]
[?2004l[?2004h>     
[?2004l[?2004h>     # Net injections (Generation - Load)
[?2004l[?2004h>     P_inj = [-b[2]/baseMVA for b in buses]
[?2004l[?2004h>     Q_inj = [-b[3]/baseMVA for b in buses]
[?2004l[?2004h>     
[?2004l[?2004h>     # Add generation
[?2004l[?2004h>     gen_bus_map = {}
[?2004l[?2004h>     for g in gens:
[?2004l[?2004h>         gb = g[0]
[?2004l[?2004h>         if gb in bus_map:
[?2004l[?2004h>             idx = bus_map[gb]
[?2004l[?2004h>             if g[7] > 0: # Status
[?2004l[?2004h>                 P_inj[idx] += g[1]/baseMVA
[?2004l[?2004h>                 Q_inj[idx] += g[2]/baseMVA
[?2004l[?2004h>                 if bus_types[idx] == 2: # PV bus
[?2004l[?2004h>                     Vm[idx] = g[5]
[?2004l[?2004h> 
[?2004l [?2004h>     # Newton-Raphson
[?2004l[?2004h>     max_iter = 20
[?2004l[?2004h>     tol = 1e-4
[?2004l[?2004h>     
[?2004l[?2004h>     # Indices to solve for
[?2004l[?2004h>     pv_pq_idx = [i for i, t in enumerate(bus_types) if t in [1, 2]]
[?2004l[?2004h>     pq_idx = [i for i, t in enumerate(bus_types) if t == 1]
[?2004l[?2004h>     
[?2004l[?2004h>     for it in range(max_iter):
[?2004l[?2004h>         # Calculate mismatch
[?2004l[?2004h>         mismatch_P = []
[?2004l[?2004h>         mismatch_Q = []
[?2004l[?2004h>         
[?2004l[?2004h>         current_P = [0.0] * nb
[?2004l[?2004h>         current_Q = [0.0] * nb
[?2004l[?2004h>         
[?2004l[?2004h>         for i in range(nb):
[?2004l[?2004h>             sum_yv = 0j
[?2004l[?2004h>             for j in range(nb):
[?2004l[?2004h>                 if Y[i][j] != 0j:
[?2004l[?2004h>                     sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])
[?2004l[?2004h>             S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()
[?2004l[?2004h>             current_P[i] = S.real
[?2004l[?2004h>             current_Q[i] = S.imag
[?2004l[?2004h>             
[?2004l[?2004h>         dP = [P_inj[i] - current_P[i] for i in pv_pq_idx]
[?2004l[?2004h>         dQ = [Q_inj[i] - current_Q[i] for i in pq_idx]
[?2004l[?2004h>         
[?2004l[?2004h>         mismatch = max([abs(x) for x in dP + dQ]) if (dP+dQ) else 0
[?2004l[?2004h>         if mismatch < tol:
[?2004l[?2004h>             print(f"Converged in {it} iterations")
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         # Jacobian
[?2004l[?2004h>         # J11: dP/dVa, J12: dP/dVm
[?2004l[?2004h>         # J21: dQ/dVa, J22: dQ/dVm
[?2004l[?2004h>         
[?2004l[?2004h>         n_unknowns = len(pv_pq_idx) + len(pq_idx)
[?2004l[?2004h>         J = Matrix(n_unknowns, n_unknowns)
[?2004l[?2004h>         
[?2004l[?2004h>         # Populate Jacobian (Simplified for brevity, standard polar formulation)
[?2004l[?2004h>         # Map full index to reduced index
[?2004l[?2004h>         row_map = 0
[?2004l[?2004h>         for i in pv_pq_idx:
[?2004l[?2004h>             col_map = 0
[?2004l[?2004h>             for j in pv_pq_idx:
[?2004l[?2004h>                 # dPi/dVa_j
[?2004l[?2004h>                 val = 0.0
[?2004l[?2004h>                 if i == j:
[?2004l[?2004h>                      for k in range(nb):
[?2004l[?2004h>                          if k != i:
[?2004l[?2004h>                              # -V_i V_k (G sin - B cos)
[?2004l[?2004h>                              G = Y[i][k].real
[?2004l[?2004h>                              B = Y[i][k].imag
[?2004l[?2004h>                              th = Va[i] - Va[k]
[?2004l[?2004h>                              val += -Vm[i]*Vm[k]*(G*math.sin(th) - B*math.cos(th))
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     # V_i V_j (G sin - B cos)
[?2004l[?2004h>                     G = Y[i][j].real
[?2004l[?2004h>                     B = Y[i][j].imag
[?2004l[?2004h>                     th = Va[i] - Va[j]
[?2004l[?2004h>                     val = Vm[i]*Vm[j]*(G*math.sin(th) - B*math.cos(th))
[?2004l[?2004h>                 J.data[row_map][col_map] = val
[?2004l[?2004h>                 col_map += 1
[?2004l[?2004h>             
[?2004l[?2004h>             for j in pq_idx:
[?2004l[?2004h>                 # dPi/dVm_j
[?2004l[?2004h>                 val = 0.0
[?2004l[?2004h>                 if i == j:
[?2004l[?2004h>                     for k in range(nb):
[?2004l[?2004h>                         if k != i:
[?2004l[?2004h>                              # V_k (G cos + B sin)
[?2004l[?2004h>                              G = Y[i][k].real
[?2004l[?2004h>                              B = Y[i][k].imag
[?2004l[?2004h>                              th = Va[i] - Va[k]
[?2004l[?2004h>                              val += Vm[k]*(G*math.cos(th) + B*math.sin(th))
[?2004l[?2004h>                     val += 2*Vm[i]*Y[i][i].real
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     # V_i (G cos + B sin)
[?2004l[?2004h>                     G = Y[i][j].real
[?2004l[?2004h>                     B = Y[i][j].imag
[?2004l[?2004h>                     th = Va[i] - Va[j]
[?2004l[?2004h>                     val = Vm[i]*(G*math.cos(th) + B*math.sin(th))
[?2004l[?2004h>                 J.data[row_map][col_map] = val
[?2004l[?2004h>                 col_map += 1
[?2004l[?2004h>             row_map += 1
[?2004l[?2004h>             
[?2004l[?2004h>         for i in pq_idx:
[?2004l[?2004h>             col_map = 0
[?2004l[?2004h>             for j in pv_pq_idx:
[?2004l[?2004h>                 # dQi/dVa_j
[?2004l[?2004h>                 val = 0.0
[?2004l[?2004h>                 if i == j:
[?2004l[?2004h>                      for k in range(nb):
[?2004l[?2004h>                          if k != i:
[?2004l[?2004h>                              # -V_i V_k (G cos + B sin)
[?2004l[?2004h>                              G = Y[i][k].real
[?2004l[?2004h>                              B = Y[i][k].imag
[?2004l[?2004h>                              th = Va[i] - Va[k]
[?2004l[?2004h>                              val += -Vm[i]*Vm[k]*(G*math.cos(th) + B*math.sin(th))
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     # V_i V_j (G cos + B sin)
[?2004l[?2004h>                     G = Y[i][j].real
[?2004l[?2004h>                     B = Y[i][j].imag
[?2004l[?2004h>                     th = Va[i] - Va[j]
[?2004l[?2004h>                     val = Vm[i]*Vm[j]*(G*math.cos(th) + B*math.sin(th))
[?2004l[?2004h>                 J.data[row_map][col_map] = val
[?2004l[?2004h>                 col_map += 1
[?2004l[?2004h>                 
[?2004l[?2004h>             for j in pq_idx:
[?2004l[?2004h>                 # dQi/dVm_j
[?2004l[?2004h>                 val = 0.0
[?2004l[?2004h>                 if i == j:
[?2004l[?2004h>                     for k in range(nb):
[?2004l[?2004h>                         if k != i:
[?2004l[?2004h>                              # V_k (G sin - B cos)
[?2004l[?2004h>                              G = Y[i][k].real
[?2004l[?2004h>                              B = Y[i][k].imag
[?2004l[?2004h>                              th = Va[i] - Va[k]
[?2004l[?2004h>                              val += Vm[k]*(G*math.sin(th) - B*math.cos(th))
[?2004l[?2004h>                     val -= 2*Vm[i]*Y[i][i].imag
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     # V_i (G sin - B cos)
[?2004l[?2004h>                     G = Y[i][j].real
[?2004l[?2004h>                     B = Y[i][j].imag
[?2004l[?2004h>                     th = Va[i] - Va[j]
[?2004l[?2004h>                     val = Vm[i]*(G*math.sin(th) - B*math.cos(th))
[?2004l[?2004h>                 J.data[row_map][col_map] = val
[?2004l[?2004h>                 col_map += 1
[?2004l[?2004h>             row_map += 1
[?2004l[?2004h> 
[?2004l[?2004h>         # Solve J * dx = mismatch
[?2004l[?2004h>         rhs = dP + dQ
[?2004l[?2004h>         try:
[?2004l[?2004h>             dx = solve_linear_system(J, rhs)
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print("Matrix singular or error:", e)
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         # Update state
[?2004l[?2004h>         idx = 0
[?2004l[?2004h>         for i in pv_pq_idx:
[?2004l[?2004h>             Va[i] += dx[idx]
[?2004l[?2004h>             idx += 1
[?2004l[?2004h>         for i in pq_idx:
[?2004l[?2004h>             Vm[i] += dx[idx]
[?2004l[?2004h>             idx += 1
[?2004l[?2004h>             
[?2004l[?2004h>     # Update data structures with results
[?2004l[?2004h>     for i in range(nb):
[?2004l[?2004h>         buses[i][7] = Vm[i]
[?2004l[?2004h>         buses[i][8] = math.degrees(Va[i])
[?2004l[?2004h>         
[?2004l[?2004h>     # Recalculate Slack/PV Gen Q
[?2004l[?2004h>     for i in range(nb):
[?2004l[?2004h>         sum_yv = 0j
[?2004l[?2004h>         for j in range(nb):
[?2004l[?2004h>             if Y[i][j] != 0j:
[?2004l[?2004h>                 sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])
[?2004l[?2004h>         S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()
[?2004l[?2004h>         P_calc = S.real * baseMVA
[?2004l[?2004h>         Q_calc = S.imag * baseMVA
[?2004l[?2004h>         
[?2004l[?2004h>         # Update Gen Q
[?2004l[?2004h>         # Find gens at this bus
[?2004l[?2004h>         bus_gens = [g for g in gens if bus_map[g[0]] == i]
[?2004l[?2004h>         if bus_gens:
[?2004l[?2004h>             # Distribute Q mismatch among gens (simplified)
[?2004l[?2004h>             # Or just set the first one
[?2004l[?2004h>             # Load P, Q
[?2004l[?2004h>             Pd = buses[i][2]
[?2004l[?2004h>             Qd = buses[i][3]
[?2004l[?2004h>             
[?2004l[?2004h>             # P_gen_total = P_calc + Pd
[?2004l[?2004h>             # Q_gen_total = Q_calc + Qd
[?2004l[?2004h>             
[?2004l[?2004h>             # For Slack bus, update P and Q
[?2004l[?2004h>             if bus_types[i] == 3:
[?2004l[?2004h>                 P_gen_req = P_calc + Pd
[?2004l[?2004h>                 bus_gens[0][1] = P_gen_req
[?2004l[?2004h>                 
[?2004l[?2004h>             if bus_types[i] in [2, 3]:
[?2004l[?2004h>                 Q_gen_req = Q_calc + Qd
[?2004l[?2004h>                 # Distribute Q based on capacity or just to first gen
[?2004l[?2004h>                 bus_gens[0][2] = Q_gen_req
[?2004l[?2004h> 
[?2004l[?2004h>     return buses, gens
[?2004l[?2004h> 
[?2004l:[?2004h> # --- Main Execution ---
[?2004l[?2004h> data = json.load(open("network.json"))
[?2004l[?2004h> buses = data['bus']
[?2004l[?2004h> gens = data['gen']
[?2004l[?2004h> branches = data['branch']
[?2004l[?2004h> baseMVA = data['baseMVA']
[?2004l[?2004h> gencosts = data['gencost']
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Economic Dispatch (Approximation)
[?2004l[?2004h> # Calculate total load
[?2004l[?2004h> total_load = sum(b[2] for b in buses)
[?2004l[?2004h> # Add losses estimate (e.g. 2%)
[?2004l[?2004h> total_gen_req = total_load * 1.02
[?2004l[?2004h> 
[?2004l([?2004h> # Collect gen costs
[?2004l[?2004h> # Assuming quadratic cost: c2*P^2 + c1*P + c0
[?2004l  [?2004h> # gencost format: [model, startup, shutdown, n, c(n-1), ..., c0]
[?2004l[?2004h> gen_data = []
[?2004l[?2004h> for i, g in enumerate(gens):
[?2004l[?2004h>     cost_entry = gencosts[i]
[?2004l[?2004h>     # Parse cost
[?2004l[?2004h>     # We assume model 2 (polynomial) and n=3 (quadratic) or n=2 (linear) for simplicity
[?2004l[?2004h>     # If n=3: c2, c1, c0. If n=2: c1, c0 (c2=0)
[?2004l[?2004h>     n = int(cost_entry[3])
[?2004l[?2004h>     c2, c1, c0 = 0.0, 0.0, 0.0
[?2004l[?2004h>     if n >= 3:
[?2004l[?2004h>         c2 = cost_entry[4]
[?2004l[?2004h>         c1 = cost_entry[5]
[?2004l[[?2004h>         c0 = cost_entry[6]
[?2004ls[?2004h>     elif n == 2:
[?2004l[?2004h>         c1 = cost_entry[4]
[?2004l[?2004h>         c0 = cost_entry[5]
[?2004l[?2004h>     
[?2004l[?2004h>     gen_data.append({
[?2004l[?2004h>         'id': i,
[?2004l[?2004h>         'pmin': g[9],
[?2004l[?2004h>         'pmax': g[8],
[?2004l[?2004h>         'c2': c2,
[?2004l   [?2004h>         'c1': c1,
[?2004l[?2004h>         'c0': c0,
[?2004l[?2004h>         'gen_idx': i
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Simple Lambda Iteration for ED
[?2004l[?2004h> # Minimize sum(c2*P^2 + c1*P + c0) s.t. sum(P) = total_gen_req
[?2004l[?2004h> # dC/dP = 2*c2*P + c1 = lambda
[?2004l[?2004h> # P = (lambda - c1) / (2*c2)
[?2004l[?2004h> # If c2 is small/zero, this is linear, use sorting.
[?2004l[?2004h> 
[?2004l
[?2004h> # Check if any quadratic
[?2004lte [?2004h> is_quadratic = any(g['c2'] > 1e-6 for g in gen_data)
[?2004l[?2004h> 
[?2004l[?2004h> if is_quadratic:
[?2004l[?2004h>     lam_min = min(g['c1'] for g in gen_data)
[?2004l[?2004h>     lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)
[?2004l[?2004h>     
[?2004l[?2004h>     for _ in range(50):
[?2004l[?2004h>         lam = (lam_min + lam_max) / 2
[?2004l[?2004h>         p_sum = 0
[?2004l[?2004h>         for g in gen_data:
[?2004l[?2004h>             if g['c2'] > 1e-6:
[?2004l[?2004h>                 p = (lam - g['c1']) / (2*g['c2'])
[?2004l[?2004h>             else:
[?2004l[?2004h>                 p = g['pmax'] if lam > g['c1'] else g['pmin']
[?2004l[?2004h>             p = max(g['pmin'], min(g['pmax'], p))
[?2004l[?2004h>             p_sum += p
[?2004l[?2004h>         
[?2004l[?2004h>         if abs(p_sum - total_gen_req) < 1e-2:
[?2004l[?2004h>             break
[?2004l[?2004h>         if p_sum > total_gen_req:
[?2004l[?2004h>             lam_max = lam
[?2004l[?2004h>         else:
[?2004l[?2004h>             lam_min = lam
[?2004l[?2004h>             
[?2004l[?2004h>     # Assign P
[?2004l[?2004h>     for g in gen_data:
[?2004l[?2004h>         if g['c2'] > 1e-6:
[?2004l[?2004h>             p = (lam - g['c1']) / (2*g['c2'])
[?2004l[?2004h>         else:
[?2004l[?2004h>             p = g['pmax'] if lam > g['c1'] else g['pmin']
[?2004l[?2004h>         p = max(g['pmin'], min(g['pmax'], p))
[?2004l[?2004h>         gens[g['gen_idx']][1] = p
[?2004l[?2004h> else:
[?2004l[?2004h>     # Linear ED: Sort by c1
[?2004l[?2004h>     gen_data.sort(key=lambda x: x['c1'])
[?2004l[?2004h>     rem_load = total_gen_req
[?2004l[?2004h>     for g in gen_data:
[?2004l[?2004h>         p_avail = g['pmax'] - g['pmin']
[?2004l[?2004h>         take = min(p_avail, rem_load - g['pmin'] if rem_load > g['pmin'] else 0)
[?2004l[?2004h>         # This logic is slightly buggy for base load, let's just fill up cheapest
[?2004l[?2004h>         # Better: Set all to Pmin. Fill rest.
[?2004l[?2004h>         pass
[?2004l[?2004h>     
[?2004l[?2004h>     # Reset to Pmin
[?2004l[?2004h>     curr_gen = 0
[?2004l[?2004h>     for g in gen_data:
[?2004l[?2004h>         gens[g['gen_idx']][1] = g['pmin']
[?2004l[?2004h>         curr_gen += g['pmin']
[?2004l[?2004h>         
[?2004l[?2004h>     needed = total_gen_req - curr_gen
[?2004l[?2004h>     for g in gen_data:
[?2004l[?2004h>         if needed <= 0: break
[?2004l[?2004h>         avail = g['pmax'] - g['pmin']
[?2004l[?2004h>         take = min(avail, needed)
[?2004l[?2004h>         gens[g['gen_idx']][1] += take
[?2004l[?2004h>         needed -= take
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Solve Power Flow
[?2004l[?2004h> buses, gens = run_power_flow(buses, gens, branches, baseMVA)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Generate Report
[?2004l[?2004h> report = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate totals
[?2004l[?2004h> total_load_mw = sum(b[2] for b in buses)
[?2004l[?2004h> total_load_mvar = sum(b[3] for b in buses)
[?2004l[?2004h> total_gen_mw = sum(g[1] for g in gens if g[7]>0)
[?2004l[?2004h> total_gen_mvar = sum(g[2] for g in gens if g[7]>0)
[?2004l[?2004h> total_losses = total_gen_mw - total_load_mw # Approx
[?2004l[?2004h> 
[?2004l[?2004h> # Cost
[?2004l[?2004h> total_cost = 0
[?2004l[?2004h> for i, g in enumerate(gens):
[?2004l[?2004h>     if g[7] == 0: continue
[?2004l[?2004h>     pg = g[1]
[?2004l[?2004h>     # Re-parse cost to be sure
[?2004l[?2004h>     cost_entry = gencosts[i]
[?2004l[?2004h>     n = int(cost_entry[3])
[?2004l[?2004h>     cost = 0
[?2004l[?2004h>     if n >= 3:
[?2004l[?2004h>         cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]
[?2004l[?2004h>     elif n == 2:
[?2004l[?2004h>         cost = cost_entry[4]*pg + cost_entry[5]
