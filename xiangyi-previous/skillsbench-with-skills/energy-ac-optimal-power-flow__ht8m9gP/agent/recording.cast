[593.472833, "o", "\u001b[?2004hroot@8ea9e48eb6c0:~# "]
[593.602046, "i", "cat << 'EOF' > solve.py\nimport json\nimport math\nimport cmath\nimport sys\n\n# --- Minimal Matrix/Vector Library ---\nclass Matrix:\n    def __init__(self, rows, cols, data=None):\n        self.rows = rows\n        self.cols = cols\n        self.data = data if data else [[0.0] * cols for _ in range(rows)]\n\n    def __getitem__(self, idx):\n        return self.data[idx]\n\n    @staticmethod\n    def identity(n):\n        res = Matrix(n, n)\n        for i in range(n):\n            res[i][i] = 1.0\n        return res\n\n    def multiply_vec(self, vec):\n        if self.cols != len(vec):\n            raise ValueError(\"Dimension mismatch\")\n        res = [0.0] * self.rows\n        for i in range(self.rows):\n            sum_val = 0.0\n            row = self.data[i]\n            for j in range(self.cols):\n                sum_val += row[j] * vec[j]\n            res[i] = sum_val\n        return res\n\ndef solve_linear_system(A, b):\n    n = len(b)\n    M = [row[:] + [b[i]] for i, row in enumerate(A.data)]\n    for i in range(n):\n        max_row = i\n        for k in range(i + 1, n):\n            if abs(M[k][i]) > abs(M[max_row][i]):\n                max_row = k\n        M[i], M[max_row] = M[max_row], M[i]\n        if abs(M[i][i]) < 1e-12:\n            continue\n        for k in range(i + 1, n):\n            factor = M[k][i] / M[i][i]\n            for j in range(i, n + 1):\n                M[k][j] -= factor * M[i][j]\n    x = [0.0] * n\n    for i in range(n - 1, -1, -1):\n        sum_ax = sum(M[i][j] * x[j] for j in range(i + 1, n))\n        if abs(M[i][i]) > 1e-12:\n            x[i] = (M[i][n] - sum_ax) / M[i][i]\n    return x\n\n# --- Power System Classes ---\ndef get_ybus(buses, branches):\n    nb = len(buses)\n    bus_map = {b[0]: i for i, b in enumerate(buses)}\n    Y = [[0j] * nb for _ in range(nb)]\n    for i, b in enumerate(buses):\n        gs, bs = b[4], b[5]\n        Y[i][i] += complex(gs, bs)\n    for br in branches:\n        f, t = br[0], br[1]\n        if f not in bus_map or t not in bus_map: continue\n        i, j = bus_map[f], bus_map[t]\n        r, x, b_chg = br[2], br[3], br[4]\n        tap, shift = br[8], br[9]\n        status = br[10]\n        if status == 0: continue\n        z = complex(r, x)\n        y = 1.0 / z\n        bc = complex(0, b_chg / 2.0)\n        if tap == 0: tap = 1.0\n        tr = tap * cmath.exp(1j * math.radians(shift))\n        Y[i][i] += (y + bc) / (abs(tr)**2)\n        Y[j][j] += (y + bc)\n        Y[i][j] -= y / tr.conjugate()\n        Y[j][i] -= y / tr\n    return Y, bus_map\n\ndef run_power_flow(buses, gens, branches, baseMVA):\n    nb = len(buses)\n    Y, bus_map = get_ybus(buses, branches)\n    Vm = [b[7] for b in buses]\n    Va = [math.radians(b[8]) for b in buses]\n    bus_types = [int(b[1]) for b in buses]\n    P_inj = [-b[2]/baseMVA for b in buses]\n    Q_inj = [-b[3]/baseMVA for b in buses]\n    gen_bus_map = {}\n    for g in gens:\n        gb = g[0]\n        if gb in bus_map:\n            idx = bus_map[gb]\n            if g[7] > 0:\n                P_inj[idx] += g[1]/baseMVA\n                Q_inj[idx] += g[2]/baseMVA\n                if bus_types[idx] == 2:\n                    Vm[idx] = g[5]\n    max_iter = 20\n    tol = 1e-4\n    pv_pq_idx = [i for i, t in enumerate(bus_types) if t in [1, 2]]\n    pq_idx = [i for i, t in enumerate(bus_types) if t == 1]\n    \n    for it in range(max_iter):\n        current_P = [0.0] * nb\n        current_Q = [0.0] * nb\n        for i in range(nb):\n            sum_yv = 0j\n            for j in range(nb):\n                if Y[i][j] != 0j:\n                    sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\n            S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\n            current_P[i] = S.real\n            current_Q[i] = S.imag\n        dP = [P_inj[i] - current_P[i] for i in pv_pq_idx]\n        dQ = [Q_inj[i] - current_Q[i] for i in pq_idx]\n        mismatch = max([abs(x) for x in dP + dQ]) if (dP+dQ) else 0\n        print(f\"Iter {it}: Max mismatch = {mismatch:.6f}\")\n        if mismatch < tol:\n            print(f\"Converged in {it} iterations\")\n            break\n        \n        n_unknowns = len(pv_pq_idx) + len(pq_idx)\n        J = Matrix(n_unknowns, "]
[593.602198, "i", "n_unknowns)\n        row_map = 0\n        for i in pv_pq_idx:\n            col_map = 0\n            for j in pv_pq_idx:\n                val = 0.0\n                G = Y[i][j].real\n                B = Y[i][j].imag\n                th = Va[i] - Va[j]\n                if i == j:\n                     for k in range(nb):\n                         if k != i:\n                             Gk = Y[i][k].real\n                             Bk = Y[i][k].imag\n                             thk = Va[i] - Va[k]\n                             val += -Vm[i]*Vm[k]*(Gk*math.sin(thk) - Bk*math.cos(thk))\n                else:\n                    val = Vm[i]*Vm[j]*(G*math.sin(th) - B*math.cos(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            for j in pq_idx:\n                val = 0.0\n                G = Y[i][j].real\n                B = Y[i][j].imag\n                th = Va[i] - Va[j]\n                if i == j:\n                    for k in range(nb):\n                        if k != i:\n                             Gk = Y[i][k].real\n                             Bk = Y[i][k].imag\n                             thk = Va[i] - Va[k]\n                             val += Vm[k]*(Gk*math.cos(thk) + Bk*math.sin(thk))\n                    val += 2*Vm[i]*Y[i][i].real\n                else:\n                    val = Vm[i]*(G*math.cos(th) + B*math.sin(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            row_map += 1\n        for i in pq_idx:\n            col_map = 0\n            for j in pv_pq_idx:\n                val = 0.0\n                G = Y[i][j].real\n                B = Y[i][j].imag\n                th = Va[i] - Va[j]\n                if i == j:\n                     for k in range(nb):\n                         if k != i:\n                             Gk = Y[i][k].real\n                             Bk = Y[i][k].imag\n                             thk = Va[i] - Va[k]\n                             val += -Vm[i]*Vm[k]*(Gk*math.cos(thk) + Bk*math.sin(thk))\n                else:\n                    val = Vm[i]*Vm[j]*(G*math.cos(th) + B*math.sin(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            for j in pq_idx:\n                val = 0.0\n                G = Y[i][j].real\n                B = Y[i][j].imag\n                th = Va[i] - Va[j]\n                if i == j:\n                    for k in range(nb):\n                        if k != i:\n                             Gk = Y[i][k].real\n                             Bk = Y[i][k].imag\n                             thk = Va[i] - Va[k]\n                             val += Vm[k]*(Gk*math.sin(thk) - Bk*math.cos(thk))\n                    val -= 2*Vm[i]*Y[i][i].imag\n                else:\n                    val = Vm[i]*(G*math.sin(th) - B*math.cos(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            row_map += 1\n        rhs = dP + dQ\n        try:\n            dx = solve_linear_system(J, rhs)\n        except Exception as e:\n            print(\"Matrix singular or error:\", e)\n            break\n        idx = 0\n        for i in pv_pq_idx:\n            Va[i] += dx[idx]\n            idx += 1\n        for i in pq_idx:\n            # Clamp voltage update to prevent divergence\n            update = dx[idx]\n            if update > 0.1: update = 0.1\n            if update < -0.1: update = -0.1\n            Vm[i] += update\n            if Vm[i] < 0.1: Vm[i] = 0.1\n            if Vm[i] > 1.5: Vm[i] = 1.5\n            idx += 1\n    for i in range(nb):\n        buses[i][7] = Vm[i]\n        buses[i][8] = math.degrees(Va[i])\n    # Update Slack/PV Gen Q\n    for i in range(nb):\n        sum_yv = 0j\n        for j in range(nb):\n            if Y[i][j] != 0j:\n                sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\n        S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\n        P_calc = S.real * baseMVA\n        Q_calc = S.imag * baseMVA\n        bus_gens = [g for g in gens if bus_map[g[0]] == i]\n        if bus_gens:\n            Pd = buses[i][2]\n            Qd = buses[i][3]\n            if bus_types[i] == 3:\n                P_"]
[593.602317, "i", "gen_req = P_calc + Pd\n                bus_gens[0][1] = P_gen_req\n            if bus_types[i] in [2, 3]:\n                Q_gen_req = Q_calc + Qd\n                bus_gens[0][2] = Q_gen_req\n    return buses, gens, mismatch\n\n# --- Main ---\ndata = json.load(open(\"network.json\"))\nbuses = data['bus']\ngens = data['gen']\nbranches = data['branch']\nbaseMVA = data['baseMVA']\ngencosts = data['gencost']\n\n# ED Logic\ntotal_load = sum(b[2] for b in buses)\ntotal_gen_req = total_load * 1.02\ngen_data = []\nfor i, g in enumerate(gens):\n    cost_entry = gencosts[i]\n    n = int(cost_entry[3])\n    c2, c1, c0 = 0.0, 0.0, 0.0\n    if n >= 3:\n        c2 = cost_entry[4]; c1 = cost_entry[5]; c0 = cost_entry[6]\n    elif n == 2:\n        c1 = cost_entry[4]; c0 = cost_entry[5]\n    gen_data.append({'id': i, 'pmin': g[9], 'pmax': g[8], 'c2': c2, 'c1': c1, 'c0': c0, 'gen_idx': i})\n\nis_quadratic = any(g['c2'] > 1e-6 for g in gen_data)\nif is_quadratic:\n    lam_min = min(g['c1'] for g in gen_data)\n    lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)\n    for _ in range(50):\n        lam = (lam_min + lam_max) / 2\n        p_sum = 0\n        for g in gen_data:\n            if g['c2'] > 1e-6: p = (lam - g['c1']) / (2*g['c2'])\n            else: p = g['pmax'] if lam > g['c1'] else g['pmin']\n            p = max(g['pmin'], min(g['pmax'], p))\n            p_sum += p\n        if abs(p_sum - total_gen_req) < 1e-2: break\n        if p_sum > total_gen_req: lam_max = lam\n        else: lam_min = lam\n    for g in gen_data:\n        if g['c2'] > 1e-6: p = (lam - g['c1']) / (2*g['c2'])\n        else: p = g['pmax'] if lam > g['c1'] else g['pmin']\n        p = max(g['pmin'], min(g['pmax'], p))\n        gens[g['gen_idx']][1] = p\nelse:\n    gen_data.sort(key=lambda x: x['c1'])\n    for g in gen_data:\n        gens[g['gen_idx']][1] = g['pmin']\n    curr_gen = sum(g['pmin'] for g in gen_data)\n    needed = total_gen_req - curr_gen\n    for g in gen_data:\n        if needed <= 0: break\n        avail = g['pmax'] - g['pmin']\n        take = min(avail, needed)\n        gens[g['gen_idx']][1] += take\n        needed -= take\n\nbuses, gens, final_mismatch = run_power_flow(buses, gens, branches, baseMVA)\n\nreport = {}\ntotal_load_mw = sum(b[2] for b in buses)\ntotal_load_mvar = sum(b[3] for b in buses)\ntotal_gen_mw = sum(g[1] for g in gens if g[7]>0)\ntotal_gen_mvar = sum(g[2] for g in gens if g[7]>0)\ntotal_losses = total_gen_mw - total_load_mw\ntotal_cost = 0\nfor i, g in enumerate(gens):\n    if g[7] == 0: continue\n    pg = g[1]\n    cost_entry = gencosts[i]\n    n = int(cost_entry[3])\n    cost = 0\n    if n >= 3: cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]\n    elif n == 2: cost = cost_entry[4]*pg + cost_entry[5]\n    total_cost += cost\n\nreport[\"summary\"] = {\n    \"total_cost_per_hour\": total_cost,\n    \"total_load_MW\": total_load_mw,\n    \"total_load_MVAr\": total_load_mvar,\n    \"total_generation_MW\": total_gen_mw,\n    \"total_generation_MVAr\": total_gen_mvar,\n    \"total_losses_MW\": total_losses,\n    \"solver_status\": \"optimal\" if final_mismatch < 1e-3 else \"failed\"\n}\nreport[\"generators\"] = []\nfor i, g in enumerate(gens):\n    report[\"generators\"].append({\n        \"id\": i+1, \"bus\": int(g[0]), \"pg_MW\": g[1], \"qg_MVAr\": g[2],\n        \"pmin_MW\": g[9], \"pmax_MW\": g[8], \"qmin_MVAr\": g[4], \"qmax_MVAr\": g[3]\n    })\nreport[\"buses\"] = []\nmax_v_viol = 0\nfor i, b in enumerate(buses):\n    v = b[7]\n    vmin, vmax = b[12], b[11]\n    viol = max(0, vmin - v, v - vmax)\n    max_v_viol = max(max_v_viol, viol)\n    report[\"buses\"].append({\n        \"id\": int(b[0]), \"vm_pu\": b[7], \"va_deg\": b[8], \"vmin_pu\": b[12], \"vmax_pu\": b[11]\n    })\nreport[\"most_loaded_branches\"] = []\nbus_map = {b[0]: i for i, b in enumerate(buses)}\nmax_br_overload = 0\nfor br in branches:\n    f, t = br[0], br[1]\n    if f not in bus_map or t not in bus_map: continue\n    i, j = bus_map[f], bus_map[t]\n    if br[10] == 0: continue\n    r, x, b_chg = br[2], br[3], br[4]\n    tap, shift = br[8], br[9]\n    if tap == 0: tap = 1.0\n    tr = tap * cmath.exp(1j * math.radians(shift))\n    z = complex(r, x)\n    y = 1.0 / z\n    bc = complex(0, b_chg / 2.0)\n    Vi ="]
[593.602366, "i", " cmath.rect(buses[i][7], math.radians(buses[i][8]))\n    Vj = cmath.rect(buses[j][7], math.radians(buses[j][8]))\n    Yff = (y + bc) / (abs(tr)**2)\n    Yft = -y / tr.conjugate()\n    S_f = Vi * (Yff*Vi + Yft*Vj).conjugate()\n    S_f_mva = abs(S_f) * baseMVA\n    limit = br[5]\n    loading = 0\n    if limit > 0:\n        loading = (S_f_mva / limit) * 100\n        if S_f_mva > limit: max_br_overload = max(max_br_overload, S_f_mva - limit)\n    if loading > 90:\n        report[\"most_loaded_branches\"].append({\n            \"from_bus\": int(f), \"to_bus\": int(t), \"loading_pct\": loading,\n            \"flow_from_MVA\": S_f_mva, \"flow_to_MVA\": 0.0, \"limit_MVA\": limit\n        })\n\nreport[\"feasibility_check\"] = {\n    \"max_p_mismatch_MW\": final_mismatch * baseMVA,\n    \"max_q_mismatch_MVAr\": final_mismatch * baseMVA,\n    \"max_voltage_violation_pu\": max_v_viol,\n    \"max_branch_overload_MVA\": max_br_overload\n}\n\nwith open(\"report.json\", \"w\") as f:\n    json.dump(report, f, indent=2)\nprint(\"Done.\")\nEOF\n"]
