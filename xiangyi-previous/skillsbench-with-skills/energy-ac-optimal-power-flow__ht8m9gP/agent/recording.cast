[593.64456, "o", "\u001b[?2004h>         rhs = dP + dQ\r\n\u001b[?2004l\rMV"]
[593.644587, "o", "\u001b[?2004h> "]
[593.644653, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.644773, "o", "            dx = solve_linear_system(J, rhs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.644885, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.644999, "o", "            print(\"Matrix singular or error:\", e)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.645033, "o", "> "]
[593.645092, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.645158, "o", "        idx = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.645179, "o", "> "]
[593.645201, "o", "        for i in pv_pq_idx:\r\n\u001b[?2004l\r"]
[593.645249, "o", "\u001b[?2004h> "]
[593.64531, "o", "            Va[i] += dx[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.645404, "o", "            idx += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.645462, "o", "> "]
[593.645488, "o", "        for i in pq_idx:\r\n\u001b[?2004l\r"]
[593.645517, "o", "\u001b[?2004h> "]
[593.645699, "o", "            # Clamp voltage update to prevent divergence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.645792, "o", "            update = dx[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.645856, "o", "> "]
[593.645938, "o", "            if update > 0.1: update = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.646077, "o", "            if update < -0.1: update = -0.1\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.646134, "o", "> "]
[593.646205, "o", "            Vm[i] += update\r\n\u001b[?2004l\r,\u001b[?2004h> "]
[593.646325, "o", "            if Vm[i] < 0.1: Vm[i] = 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.646446, "o", "            if Vm[i] > 1.5: Vm[i] = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.646507, "o", "            idx += 1\r\n\u001b[?2004l\r"]
[593.646533, "o", "\u001b[?2004h> "]
[593.646643, "o", "    for i in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.646699, "o", "> "]
[593.646722, "o", "        buses[i][7] = Vm[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.646851, "o", "        buses[i][8] = math.degrees(Va[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.646906, "o", "> "]
[593.646954, "o", "    # Update Slack/PV Gen Q\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.647015, "o", "> "]
[593.647035, "o", "    for i in range(nb):\r\n\u001b[?2004l\r"]
[593.647096, "o", "\u001b[?2004h>         sum_yv = 0j\r\n\u001b[?2004l\r"]
[593.647123, "o", "\u001b[?2004h> "]
[593.647177, "o", "        for j in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.648421, "o", "            if Y[i][j] != 0j:\r\n\u001b[?2004l\r\u001b[?2004h>                 sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\r\n\u001b[?2004l\r\u001b[?2004h>         S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h>         P_calc = S.real * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>         Q_calc = S.imag * baseMVA\r\n\u001b[?2004l\r[\u001b[?2004h>         bus_gens = [g for g in gens if bus_map[g[0]] == i]\r\n\u001b[?2004l\r\u001b[?2004h>         if bus_gens:\r\n\u001b[?2004l\r\u001b[?2004h>             Pd = buses[i][2]\r\n\u001b[?2004l\r\u001b[?2004h>             Qd = buses[i][3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.648455, "o", "            if bus_types[i] == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.64861, "o", "                P_gen_req = P_calc + Pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.648718, "o", "                bus_gens[0][1] = P_gen_req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.648829, "o", "            if bus_types[i] in [2, 3]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.648851, "o", "> "]
[593.648921, "o", "                Q_gen_req = Q_calc + Qd\r\n\u001b[?2004l\r2\u001b[?2004h"]
[593.648943, "o", "> "]
[593.649061, "o", "                bus_gens[0][2] = Q_gen_req\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.649081, "o", "> "]
[593.649163, "o", "    return buses, gens, mismatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.649216, "o", "> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[593.649267, "o", "# --- Main ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.649363, "o", "data = json.load(open(\"network.json\"))\r\n\u001b[?2004l\r"]
[593.649384, "o", "\u001b[?2004h> "]
[593.649676, "o", "buses = data['bus']\r\n\u001b[?2004l\r\u001b[?2004h> gens = data['gen']\r\n\u001b[?2004l\r\u001b[?2004h> branches = data['branch']\r\n\u001b[?2004l\r\u001b[?2004h> baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.649783, "o", "gencosts = data['gencost']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[593.649845, "o", "> "]
[593.649868, "o", "# ED Logic\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[593.649966, "o", "total_load = sum(b[2] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65001, "o", "> "]
[593.650067, "o", "total_gen_req = total_load * 1.02\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650084, "o", "> "]
[593.65014, "o", "gen_data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650242, "o", "for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650299, "o", "> "]
[593.650316, "o", "    cost_entry = gencosts[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65038, "o", "    n = int(cost_entry[3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650408, "o", "> "]
[593.65046, "o", "    c2, c1, c0 = 0.0, 0.0, 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650508, "o", "> "]
[593.65053, "o", "    if n >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650727, "o", "        c2 = cost_entry[4]; c1 = cost_entry[5]; c0 = cost_entry[6]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.650791, "o", "    elif n == 2:\r\n\u001b[?2004l\r"]
[593.650824, "o", "\u001b[?2004h> "]
[593.650953, "o", "        c1 = cost_entry[4]; c0 = cost_entry[5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.650975, "o", "> "]
[593.651257, "o", "    gen_data.append({'id': i, 'pmin': g[9], 'pmax': g[8], 'c2': c2, 'c1': c1, 'c0': c0, 'gen_idx': i})\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.651365, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[593.651439, "o", "is_quadratic = any(g['c2'] > 1e-6 for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651504, "o", "if is_quadratic:\r\n\u001b[?2004l\r \u001b[?2004h> "]
[593.651632, "o", "    lam_min = min(g['c1'] for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651771, "o", "    lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.651822, "o", "    for _ in range(50):\r\n\u001b[?2004l\r"]
[593.651883, "o", "\u001b[?2004h> "]
[593.651914, "o", "        lam = (lam_min + lam_max) / 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65198, "o", "        p_sum = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652059, "o", "        for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652112, "o", "            if g['c2'] > 1e-6: p = (lam - g['c1']) / (2*g['c2'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.652142, "o", "> "]
[593.652228, "o", "            else: p = g['pmax'] if lam > g['c1'] else g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.652254, "o", "> "]
[593.652363, "o", "            p = max(g['pmin'], min(g['pmax'], p))\r\n\u001b[?2004l\r"]
[593.652389, "o", "\u001b[?2004h>             p_sum += p\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652516, "o", "        if abs(p_sum - total_gen_req) < 1e-2: break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652555, "o", "        if p_sum > total_gen_req: lam_max = lam\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.652608, "o", "> "]
[593.652648, "o", "        else: lam_min = lam\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652702, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652782, "o", "        if g['c2'] > 1e-6: p = (lam - g['c1']) / (2*g['c2'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.652882, "o", "        else: p = g['pmax'] if lam > g['c1'] else g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.652928, "o", "> "]
[593.652967, "o", "        p = max(g['pmin'], min(g['pmax'], p))\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65302, "o", "> "]
[593.653063, "o", "        gens[g['gen_idx']][1] = p\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653109, "o", "> "]
[593.653157, "o", "    gen_data.sort(key=lambda x: x['c1'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653201, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653258, "o", "> "]
[593.653297, "o", "        gens[g['gen_idx']][1] = g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653368, "o", "    curr_gen = sum(g['pmin'] for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653394, "o", "> "]
[593.653443, "o", "    needed = total_gen_req - curr_gen\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653467, "o", "> "]
[593.653497, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653595, "o", "> "]
[593.653645, "o", "        if needed <= 0: break\r\n\u001b[?2004l\r\u001b[?2004h>         avail = g['pmax'] - g['pmin']\r\n\u001b[?2004l\r"]
[593.653683, "o", "\u001b[?2004h>         take = min(avail, needed)\r\n\u001b[?2004l\r"]
[593.653712, "o", "\u001b[?2004h> "]
[593.653772, "o", "        gens[g['gen_idx']][1] += take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653825, "o", "        needed -= take\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.653855, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.653983, "o", "buses, gens, final_mismatch = run_power_flow(buses, gens, branches, baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.654008, "o", "\u001b[?2004h> "]
[593.654079, "o", "report = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654106, "o", "total_load_mw = sum(b[2] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654178, "o", "total_load_mvar = sum(b[3] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.654206, "o", "> "]
[593.654262, "o", "total_gen_mw = sum(g[1] for g in gens if g[7]>0)\r\n\u001b[?2004l\r"]
[593.654292, "o", "\u001b[?2004h> "]
[593.654467, "o", "total_gen_mvar = sum(g[2] for g in gens if g[7]>0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654529, "o", "total_losses = total_gen_mw - total_load_mw\r\n\u001b[?2004l\r\u001b[?2004h> total_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654559, "o", "for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654619, "o", "    if g[7] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654681, "o", "    pg = g[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654713, "o", "    cost_entry = gencosts[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654777, "o", "    n = int(cost_entry[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.654808, "o", "    cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65492, "o", "    if n >= 3: cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.65495, "o", "> "]
[593.655035, "o", "    elif n == 2: cost = cost_entry[4]*pg + cost_entry[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65509, "o", "    total_cost += cost\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.655144, "o", "\u001b[?2004h> "]
[593.655172, "o", "report[\"summary\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655245, "o", "    \"total_cost_per_hour\": total_cost,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655293, "o", "    \"total_load_MW\": total_load_mw,\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.655321, "o", "> "]
[593.655394, "o", "    \"total_load_MVAr\": total_load_mvar,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65545, "o", "    \"total_generation_MW\": total_gen_mw,\r\n\u001b[?2004l\r"]
[593.65548, "o", "\u001b[?2004h> "]
[593.655551, "o", "    \"total_generation_MVAr\": total_gen_mvar,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655607, "o", "    \"total_losses_MW\": total_losses,\r\n\u001b[?2004l\r"]
[593.655636, "o", "\u001b[?2004h> "]
[593.655734, "o", "    \"solver_status\": \"optimal\" if final_mismatch < 1e-3 else \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.655807, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655839, "o", "report[\"generators\"] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.655894, "o", "for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.655922, "o", "> "]
[593.655979, "o", "    report[\"generators\"].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.65608, "o", "        \"id\": i+1, \"bus\": int(g[0]), \"pg_MW\": g[1], \"qg_MVAr\": g[2],\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656137, "o", "> "]
[593.656211, "o", "        \"pmin_MW\": g[9], \"pmax_MW\": g[8], \"qmin_MVAr\": g[4], \"qmax_MVAr\": g[3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656232, "o", ">     })\r\n\u001b[?2004l\r"]
[593.656292, "o", "\u001b[?2004h> report[\"buses\"] = []\r\n\u001b[?2004l\r"]
[593.656323, "o", "\u001b[?2004h> "]
[593.656353, "o", "max_v_viol = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656409, "o", "for i, b in enumerate(buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656466, "o", ">     v = b[7]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656493, "o", ">     vmin, vmax = b[12], b[11]\r\n\u001b[?2004l\r"]
[593.656575, "o", "\u001b[?2004h> "]
[593.656602, "o", "    viol = max(0, vmin - v, v - vmax)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656732, "o", "    max_v_viol = max(max_v_viol, viol)\r\n\u001b[?2004l\r\u001b[?2004h>     report[\"buses\"].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.656864, "o", "        \"id\": int(b[0]), \"vm_pu\": b[7], \"va_deg\": b[8], \"vmin_pu\": b[12], \"vmax_pu\": b[11]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.656889, "o", ">     })\r\n\u001b[?2004l\r"]
[593.656999, "o", "\u001b[?2004h> "]
[593.657059, "o", "report[\"most_loaded_branches\"] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657087, "o", "bus_map = {b[0]: i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657143, "o", "max_br_overload = 0\r\n\u001b[?2004l\r"]
[593.657175, "o", "\u001b[?2004h> for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657275, "o", "    f, t = br[0], br[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657325, "o", "    if f not in bus_map or t not in bus_map: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.657379, "o", "> "]
[593.657415, "o", "    i, j = bus_map[f], bus_map[t]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657477, "o", "    if br[10] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657551, "o", "    r, x, b_chg = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657597, "o", "    tap, shift = br[8], br[9]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.657627, "o", "> "]
[593.657658, "o", "    if tap == 0: tap = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.657687, "o", "> "]
[593.657793, "o", "    tr = tap * cmath.exp(1j * math.radians(shift))\r\n\u001b[?2004l\r\u001b[?2004h>     z = complex(r, x)\r\n\u001b[?2004l\r"]
[593.657821, "o", "\u001b[?2004h> "]
[593.657875, "o", "    y = 1.0 / z\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.657934, "o", "    bc = complex(0, b_chg / 2.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658023, "o", "    Vi = cmath.rect(buses[i][7], math.radians(buses[i][8]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.658086, "o", "> "]
[593.658139, "o", "    Vj = cmath.rect(buses[j][7], math.radians(buses[j][8]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658404, "o", "    Yff = (y + bc) / (abs(tr)**2)\r\n\u001b[?2004l\r\u001b[?2004h>     Yft = -y / tr.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h>     S_f = Vi * (Yff*Vi + Yft*Vj).conjugate()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658457, "o", "    S_f_mva = abs(S_f) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658514, "o", "    limit = br[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658544, "o", "    loading = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658572, "o", "    if limit > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658661, "o", "        loading = (S_f_mva / limit) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658779, "o", "        if S_f_mva > limit: max_br_overload = max(max_br_overload, S_f_mva - limit)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.658825, "o", "> "]
[593.658855, "o", "    if loading > 90:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.658927, "o", "        report[\"most_loaded_branches\"].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659045, "o", "            \"from_bus\": int(f), \"to_bus\": int(t), \"loading_pct\": loading,\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659092, "o", "> "]
[593.659177, "o", "            \"flow_from_MVA\": S_f_mva, \"flow_to_MVA\": 0.0, \"limit_MVA\": limit\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659203, "o", ">         })\r\n\u001b[?2004l\r"]
[593.659266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659301, "o", "> report[\"feasibility_check\"] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659357, "o", "> "]
[593.659447, "o", "    \"max_p_mismatch_MW\": final_mismatch * baseMVA,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659504, "o", "    \"max_q_mismatch_MVAr\": final_mismatch * baseMVA,\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659535, "o", "> "]
[593.659592, "o", "    \"max_voltage_violation_pu\": max_v_viol,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659669, "o", "    \"max_branch_overload_MVA\": max_br_overload\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.659694, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[593.659718, "o", "\u001b[?2004h> "]
[593.659893, "o", "with open(\"report.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.659922, "o", "print(\"Done.\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
