[593.636847, "o", "                             Gk = Y[i][k].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.636873, "o", "> "]
[593.637108, "o", "                             Bk = Y[i][k].imag\r\n\u001b[?2004l\r"]
[593.637136, "o", "\u001b[?2004h> "]
[593.637385, "o", "                             thk = Va[i] - Va[k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.637409, "o", "> "]
[593.637877, "o", "                             val += Vm[k]*(Gk*math.cos(thk) + Bk*math.sin(thk))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.637952, "o", "                    val += 2*Vm[i]*Y[i][i].real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.638049, "o", "                else:\r\n\u001b[?2004l\r"]
[593.638074, "o", "\u001b[?2004h> "]
