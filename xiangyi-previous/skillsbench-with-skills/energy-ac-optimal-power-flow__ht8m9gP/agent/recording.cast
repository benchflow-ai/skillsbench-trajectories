[530.988885, "o", "{\r\n  \"summary\": {\r\n    \"total_cost_per_hour\": 1116861.8115773879,\r\n    \"total_load_MW\": 23525.85,\r\n    \"total_load_MVAr\": 7787.97,\r\n    \"total_generation_MW\": 114630.94692055024,\r\n    \"total_generation_MVAr\": -7026544.586392037,\r\n    \"total_losses_MW\": 91105.09692055025,\r\n    \"solver_status\": \"optimal\"\r\n  },\r\n  \"generators\": [\r\n    {\r\n      \"id\": 1,\r\n      \"bus\": 43,\r\n      \"pg_MW\": 91352.57992055024,\r\n      \"qg_MVAr\": -45052.5199205937,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 718.0,\r\n      \"qmin_MVAr\": 0.0,\r\n      \"qmax_MVAr\": 10.0\r\n"]
