[593.630608, "o", "\u001b[?2004h> "]
[593.631043, "o", "                             val += -Vm[i]*Vm[k]*(Gk*math.sin(thk) - Bk*math.cos(thk))\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.631111, "o", "> "]
