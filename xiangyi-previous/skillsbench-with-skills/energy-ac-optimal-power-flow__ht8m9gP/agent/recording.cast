[593.638932, "o", "        for i in pq_idx:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.638955, "o", "> "]
[593.639023, "o", "            col_map = 0\r\n\u001b[?2004l\r"]
[593.639052, "o", "\u001b[?2004h> "]
[593.639131, "o", "            for j in pv_pq_idx:\r\n\u001b[?2004l\r"]
[593.639151, "o", "\u001b[?2004h> "]
[593.639214, "o", "                val = 0.0\r\n\u001b[?2004l\r"]
[593.639237, "o", "\u001b[?2004h> "]
