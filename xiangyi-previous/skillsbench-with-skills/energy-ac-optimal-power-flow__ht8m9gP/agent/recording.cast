[593.642566, "o", "                if i == j:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.642743, "o", "                    for k in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.642883, "o", "                        if k != i:\r\n\u001b[?2004l\re\u001b[?2004h> "]
[593.643015, "o", "                             Gk = Y[i][k].real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.643401, "o", "                             Bk = Y[i][k].imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.643844, "o", "                             thk = Va[i] - Va[k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.643939, "o", "                             val += Vm[k]*(Gk*math.sin(thk) - Bk*math.cos(thk))\r\n\u001b[?2004l\r\u001b[?2004h>                     val -= 2*Vm[i]*Y[i][i].imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.643989, "o", "                else:\r\n\u001b[?2004l\rmma\u001b[?2004h> "]
