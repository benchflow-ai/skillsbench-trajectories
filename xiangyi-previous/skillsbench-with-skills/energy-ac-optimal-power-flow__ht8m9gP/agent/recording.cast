[593.629016, "o", "> "]
[593.629169, "o", "                G = Y[i][j].real\r\n\u001b[?2004l\r \u001b[?2004h> "]
[593.629286, "o", "                B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.629314, "o", "> "]
