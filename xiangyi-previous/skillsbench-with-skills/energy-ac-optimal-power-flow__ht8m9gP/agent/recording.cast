[593.602578, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.602635, "o", "> import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.602688, "o", "import cmath\r\n\u001b[?2004l\r"]
[593.602735, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[593.602778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.602936, "o", "# --- Minimal Matrix/Vector Library ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.603014, "o", "class Matrix:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.603111, "o", "    def __init__(self, rows, cols, data=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.603139, "o", "> "]
[593.603199, "o", "        self.rows = rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.603288, "o", "        self.cols = cols\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.603336, "o", "> "]
[593.603517, "o", "        self.data = data if data else [[0.0] * cols for _ in range(rows)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.603541, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[593.603671, "o", "    def __getitem__(self, idx):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.603692, "o", "> "]
[593.603842, "o", "        return self.data[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60389, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[593.603927, "o", "    @staticmethod\r\n\u001b[?2004l\r"]
[593.603983, "o", "\u001b[?2004h> "]
[593.604037, "o", "    def identity(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.604138, "o", "        res = Matrix(n, n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.604181, "o", "> "]
[593.604222, "o", "        for i in range(n):\r\n\u001b[?2004l\r"]
[593.604252, "o", "\u001b[?2004h> "]
[593.604333, "o", "            res[i][i] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.604383, "o", "> "]
[593.604427, "o", "        return res\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.604518, "o", "    def multiply_vec(self, vec):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.604561, "o", "> "]
[593.604621, "o", "        if self.cols != len(vec):\r\n\u001b[?2004l\r"]
[593.604665, "o", "\u001b[?2004h> "]
[593.604788, "o", "            raise ValueError(\"Dimension mismatch\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.604883, "o", "        res = [0.0] * self.rows\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60491, "o", "> "]
[593.604994, "o", "        for i in range(self.rows):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.605047, "o", "> "]
[593.605115, "o", "            sum_val = 0.0\r\n\u001b[?2004l\r"]
[593.605138, "o", "\u001b[?2004h> "]
[593.605249, "o", "            row = self.data[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.605302, "o", "> "]
[593.605376, "o", "            for j in range(self.cols):\r\n\u001b[?2004l\r"]
[593.60543, "o", "\u001b[?2004h> "]
[593.605508, "o", "                sum_val += row[j] * vec[j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60556, "o", "> "]
[593.605621, "o", "            res[i] = sum_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.605666, "o", "        return res\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60571, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.605786, "o", "def solve_linear_system(A, b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60583, "o", "> "]
[593.605853, "o", "    n = len(b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.606014, "o", "    M = [row[:] + [b[i]] for i, row in enumerate(A.data)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606038, "o", "> "]
[593.606095, "o", "    for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.606162, "o", "        max_row = i\r\n\u001b[?2004l\r"]
[593.606185, "o", "\u001b[?2004h> "]
[593.606271, "o", "        for k in range(i + 1, n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606317, "o", "> "]
[593.606429, "o", "            if abs(M[k][i]) > abs(M[max_row][i]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606473, "o", "> "]
[593.606539, "o", "                max_row = k\r\n\u001b[?2004l\rV\u001b[?2004h> "]
[593.606659, "o", "        M[i], M[max_row] = M[max_row], M[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606703, "o", "> "]
[593.606761, "o", "        if abs(M[i][i]) < 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606815, "o", "> "]
[593.606856, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.606928, "o", "        for k in range(i + 1, n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.606973, "o", "> "]
[593.607044, "o", "            factor = M[k][i] / M[i][i]\r\n\u001b[?2004l\r"]
[593.607084, "o", "\u001b[?2004h> "]
[593.607158, "o", "            for j in range(i, n + 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.607199, "o", "> "]
[593.607294, "o", "                M[k][j] -= factor * M[i][j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.607336, "o", "> "]
[593.607373, "o", "    x = [0.0] * n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.607474, "o", "    for i in range(n - 1, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.607509, "o", "> "]
[593.607653, "o", "        sum_ax = sum(M[i][j] * x[j] for j in range(i + 1, n))\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60769, "o", "> "]
[593.607769, "o", "        if abs(M[i][i]) > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.607828, "o", "> "]
[593.607931, "o", "            x[i] = (M[i][n] - sum_ax) / M[i][i]\r\n\u001b[?2004l\r"]
[593.60798, "o", "\u001b[?2004h> "]
[593.608017, "o", "    return x\r\n\u001b[?2004l\r][\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[593.608061, "o", "> "]
[593.608109, "o", "# --- Power System Classes ---\r\n\u001b[?2004l\r"]
[593.608154, "o", "\u001b[?2004h> "]
[593.608204, "o", "def get_ybus(buses, branches):\r\n\u001b[?2004l\r"]
[593.60825, "o", "\u001b[?2004h> "]
[593.608289, "o", "    nb = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.60833, "o", "> "]
[593.608442, "o", "    bus_map = {b[0]: i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r"]
[593.608487, "o", "\u001b[?2004h> "]
[593.608654, "o", "    Y = [[0j] * nb for _ in range(nb)]\r\n\u001b[?2004l\r"]
[593.6087, "o", "\u001b[?2004h> "]
[593.608811, "o", "    for i, b in enumerate(buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.608837, "o", "> "]
[593.608912, "o", "        gs, bs = b[4], b[5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.608961, "o", "> "]
[593.609023, "o", "        Y[i][i] += complex(gs, bs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.609062, "o", "> "]
[593.609097, "o", "    for br in branches:\r\n\u001b[?2004l\r"]
[593.609132, "o", "\u001b[?2004h> "]
[593.609198, "o", "        f, t = br[0], br[1]\r\n\u001b[?2004l\r \u001b[?2004h"]
[593.609235, "o", "> "]
[593.609382, "o", "        if f not in bus_map or t not in bus_map: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.609478, "o", "        i, j = bus_map[f], bus_map[t]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.609517, "o", "> "]
[593.609607, "o", "        r, x, b_chg = br[2], br[3], br[4]\r\n\u001b[?2004l\r"]
[593.609657, "o", "\u001b[?2004h> "]
[593.609709, "o", "        tap, shift = br[8], br[9]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.609733, "o", "> "]
[593.609785, "o", "        status = br[10]\r\n\u001b[?2004l\r \u001b[?2004h"]
[593.609827, "o", "> "]
[593.609882, "o", "        if status == 0: continue\r\n\u001b[?2004l\r \u001b[?2004h"]
[593.609932, "o", "> "]
[593.609981, "o", "        z = complex(r, x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.610033, "o", "> "]
[593.610076, "o", "        y = 1.0 / z\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.61014, "o", "        bc = complex(0, b_chg / 2.0)\r\n\u001b[?2004l\r"]
[593.610185, "o", "\u001b[?2004h> "]
[593.61024, "o", "        if tap == 0: tap = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.610279, "o", "> "]
[593.610407, "o", "        tr = tap * cmath.exp(1j * math.radians(shift))\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.610447, "o", "> "]
[593.61053, "o", "        Y[i][i] += (y + bc) / (abs(tr)**2)\r\n\u001b[?2004l\r"]
[593.610571, "o", "\u001b[?2004h> "]
[593.610619, "o", "        Y[j][j] += (y + bc)\r\n\u001b[?2004l\r"]
[593.610663, "o", "\u001b[?2004h> "]
[593.610732, "o", "        Y[i][j] -= y / tr.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.610776, "o", "> "]
[593.610818, "o", "        Y[j][i] -= y / tr\r\n\u001b[?2004l\r"]
[593.610868, "o", "\u001b[?2004h> "]
[593.610911, "o", "    return Y, bus_map\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r."]
[593.610952, "o", "\u001b[?2004h> "]
[593.611116, "o", "def run_power_flow(buses, gens, branches, baseMVA):\r\n\u001b[?2004l\r"]
[593.611158, "o", "\u001b[?2004h> "]
[593.611238, "o", "    nb = len(buses)\r\n\u001b[?2004l\r"]
[593.611287, "o", "\u001b[?2004h> "]
[593.611387, "o", "    Y, bus_map = get_ybus(buses, branches)\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.611434, "o", "> "]
[593.61148, "o", "    Vm = [b[7] for b in buses]\r\n\u001b[?2004l\r"]
[593.611503, "o", "\u001b[?2004h> "]
[593.611732, "o", "    Va = [math.radians(b[8]) for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.611773, "o", "> "]
[593.619807, "o", "    bus_types = [int(b[1]) for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h>     P_inj = [-b[2]/baseMVA for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h>     Q_inj = [-b[3]/baseMVA for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h>     gen_bus_map = {}\r\n\u001b[?2004l\r\u001b[?2004h>     for g in gens:\r\n\u001b[?2004l\r\u001b[?2004h>         gb = g[0]\r\n\u001b[?2004l\r\u001b[?2004h>         if gb in bus_map:\r\n\u001b[?2004l\r\u001b[?2004h>             idx = bus_map[gb]\r\n\u001b[?2004l\r\u001b[?2004h>             if g[7] > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 P_inj[idx] += g[1]/baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>                 Q_inj[idx] += g[2]/baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>                 if bus_types[idx] == 2:\r\n\u001b[?2004l\r\u001b[?2004h>                     Vm[idx] = g[5]\r\n\u001b[?2004l\r\u001b[?2004h>     max_iter = 20\r\n\u001b[?2004l\r\u001b[?2004h>     tol = 1e-4\r\n\u001b[?2004l\r\u001b[?2004h>     pv_pq_idx = [i for i, t in enumerate(bus_types) if t in [1, 2]]\r\n\u001b[?2004l\r\u001b[?2004h>     pq_idx = [i for i, t in enumerate(bus_types) if t == 1]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for it in range(max_iter):\r\n\u001b[?2004l\r\u001b[?2004h>         current_P = [0.0] * nb\r\n\u001b[?2004l\r\u001b[?2004h>         current_Q = [0.0] * nb\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h>             sum_yv = 0j\r\n\u001b[?2004l\r\u001b[?2004h>             for j in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h>                 if Y[i][j] != 0j:\r\n\u001b[?2004l\r\u001b[?2004h>                     sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\r\n\u001b[?2004l\r\u001b[?2004h>             S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h>             current_P[i] = S.real\r\n\u001b[?2004l\r\u001b[?2004h>             current_Q[i] = S.imag\r\n\u001b[?2004l\r\u001b[?2004h>         dP = [P_inj[i] - current_P[i] for i in pv_pq_idx]\r\n\u001b[?2004l\r\u001b[?2004h>         dQ = [Q_inj[i] - current_Q[i] for i in pq_idx]\r\n\u001b[?2004l\r\u001b[?2004h>         mismatch = max([abs(x) for x in dP + dQ]) if (dP+dQ) else 0\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Iter {it}: Max mismatch = {mismatch:.6f}\")\r\n\u001b[?2004l\r\u001b[?2004h>         if mismatch < tol:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"Converged in {it} iterations\")\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.627968, "o", "        n_unknowns = len(pv_pq_idx) + len(pq_idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.628201, "o", "        J = Matrix(n_unknowns, n_unknowns)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.628273, "o", "        row_map = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.628305, "o", "> "]
