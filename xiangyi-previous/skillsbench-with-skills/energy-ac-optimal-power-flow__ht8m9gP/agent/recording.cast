[308.763351, "i", "cat << 'EOF' > solve.py\nimport json\nimport math\nimport cmath\nimport sys\n\n# --- Minimal Matrix/Vector Library ---\nclass Matrix:\n    def __init__(self, rows, cols, data=None):\n        self.rows = rows\n        self.cols = cols\n        self.data = data if data else [[0.0] * cols for _ in range(rows)]\n\n    def __getitem__(self, idx):\n        return self.data[idx]\n\n    @staticmethod\n    def identity(n):\n        res = Matrix(n, n)\n        for i in range(n):\n            res[i][i] = 1.0\n        return res\n\n    def multiply_vec(self, vec):\n        if self.cols != len(vec):\n            raise ValueError(\"Dimension mismatch\")\n        res = [0.0] * self.rows\n        for i in range(self.rows):\n            sum_val = 0.0\n            row = self.data[i]\n            for j in range(self.cols):\n                sum_val += row[j] * vec[j]\n            res[i] = sum_val\n        return res\n\ndef solve_linear_system(A, b):\n    # Gaussian elimination with partial pivoting\n    n = len(b)\n    # Create augmented matrix\n    M = [row[:] + [b[i]] for i, row in enumerate(A.data)]\n\n    for i in range(n):\n        # Pivot\n        max_row = i\n        for k in range(i + 1, n):\n            if abs(M[k][i]) > abs(M[max_row][i]):\n                max_row = k\n        M[i], M[max_row] = M[max_row], M[i]\n\n        if abs(M[i][i]) < 1e-12:\n            continue # Singular or close to it\n\n        # Eliminate\n        for k in range(i + 1, n):\n            factor = M[k][i] / M[i][i]\n            for j in range(i, n + 1):\n                M[k][j] -= factor * M[i][j]\n\n    # Back substitution\n    x = [0.0] * n\n    for i in range(n - 1, -1, -1):\n        sum_ax = sum(M[i][j] * x[j] for j in range(i + 1, n))\n        if abs(M[i][i]) > 1e-12:\n            x[i] = (M[i][n] - sum_ax) / M[i][i]\n    return x\n\n# --- Power System Classes ---\n\ndef get_ybus(buses, branches):\n    nb = len(buses)\n    # Map bus ID (1-based) to index (0-based)\n    bus_map = {b[0]: i for i, b in enumerate(buses)}\n    Y = [[0j] * nb for _ in range(nb)]\n\n    # Shunts\n    for i, b in enumerate(buses):\n        gs, bs = b[4], b[5]\n        Y[i][i] += complex(gs, bs)\n\n    # Branches\n    for br in branches:\n        f, t = br[0], br[1]\n        if f not in bus_map or t not in bus_map: continue\n        i, j = bus_map[f], bus_map[t]\n        \n        r, x, b_chg = br[2], br[3], br[4]\n        tap, shift = br[8], br[9]\n        status = br[10]\n        \n        if status == 0: continue\n\n        z = complex(r, x)\n        y = 1.0 / z\n        bc = complex(0, b_chg / 2.0)\n        \n        # Transformer model\n        if tap == 0: tap = 1.0\n        tr = tap * cmath.exp(1j * math.radians(shift))\n        \n        Y[i][i] += (y + bc) / (abs(tr)**2)\n        Y[j][j] += (y + bc)\n        Y[i][j] -= y / tr.conjugate()\n        Y[j][i] -= y / tr\n        \n    return Y, bus_map\n\ndef run_power_flow(buses, gens, branches, baseMVA):\n    nb = len(buses)\n    Y, bus_map = get_ybus(buses, branches)\n    \n    # Initial State\n    Vm = [b[7] for b in buses]\n    Va = [math.radians(b[8]) for b in buses]\n    \n    # Bus Types: 1=PQ, 2=PV, 3=Slack\n    bus_types = [int(b[1]) for b in buses]\n    \n    # Net injections (Generation - Load)\n    P_inj = [-b[2]/baseMVA for b in buses]\n    Q_inj = [-b[3]/baseMVA for b in buses]\n    \n    # Add generation\n    gen_bus_map = {}\n    for g in gens:\n        gb = g[0]\n        if gb in bus_map:\n            idx = bus_map[gb]\n            if g[7] > 0: # Status\n                P_inj[idx] += g[1]/baseMVA\n                Q_inj[idx] += g[2]/baseMVA\n                if bus_types[idx] == 2: # PV bus\n                    Vm[idx] = g[5]\n\n    # Newton-Raphson\n    max_iter = 20\n    tol = 1e-4\n    \n    # Indices to solve for\n    pv_pq_idx = [i for i, t in enumerate(bus_types) if t in [1, 2]]\n    pq_idx = [i for i, t in enumerate(bus_types) if t == 1]\n    \n    for it in range(max_iter):\n        # Calculate mismatch\n        mismatch_P = []\n        mismatch_Q = []\n        \n        current_P = [0.0] * nb\n        current_Q = [0.0] * nb\n        \n        for i in range(nb):\n            sum_yv = 0j\n            for j in range(nb):\n                if Y[i][j] !="]
[308.763536, "i", " 0j:\n                    sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\n            S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\n            current_P[i] = S.real\n            current_Q[i] = S.imag\n            \n        dP = [P_inj[i] - current_P[i] for i in pv_pq_idx]\n        dQ = [Q_inj[i] - current_Q[i] for i in pq_idx]\n        \n        mismatch = max([abs(x) for x in dP + dQ]) if (dP+dQ) else 0\n        if mismatch < tol:\n            print(f\"Converged in {it} iterations\")\n            break\n            \n        # Jacobian\n        # J11: dP/dVa, J12: dP/dVm\n        # J21: dQ/dVa, J22: dQ/dVm\n        \n        n_unknowns = len(pv_pq_idx) + len(pq_idx)\n        J = Matrix(n_unknowns, n_unknowns)\n        \n        # Populate Jacobian (Simplified for brevity, standard polar formulation)\n        # Map full index to reduced index\n        row_map = 0\n        for i in pv_pq_idx:\n            col_map = 0\n            for j in pv_pq_idx:\n                # dPi/dVa_j\n                val = 0.0\n                if i == j:\n                     for k in range(nb):\n                         if k != i:\n                             # -V_i V_k (G sin - B cos)\n                             G = Y[i][k].real\n                             B = Y[i][k].imag\n                             th = Va[i] - Va[k]\n                             val += -Vm[i]*Vm[k]*(G*math.sin(th) - B*math.cos(th))\n                else:\n                    # V_i V_j (G sin - B cos)\n                    G = Y[i][j].real\n                    B = Y[i][j].imag\n                    th = Va[i] - Va[j]\n                    val = Vm[i]*Vm[j]*(G*math.sin(th) - B*math.cos(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            \n            for j in pq_idx:\n                # dPi/dVm_j\n                val = 0.0\n                if i == j:\n                    for k in range(nb):\n                        if k != i:\n                             # V_k (G cos + B sin)\n                             G = Y[i][k].real\n                             B = Y[i][k].imag\n                             th = Va[i] - Va[k]\n                             val += Vm[k]*(G*math.cos(th) + B*math.sin(th))\n                    val += 2*Vm[i]*Y[i][i].real\n                else:\n                    # V_i (G cos + B sin)\n                    G = Y[i][j].real\n                    B = Y[i][j].imag\n                    th = Va[i] - Va[j]\n                    val = Vm[i]*(G*math.cos(th) + B*math.sin(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            row_map += 1\n            \n        for i in pq_idx:\n            col_map = 0\n            for j in pv_pq_idx:\n                # dQi/dVa_j\n                val = 0.0\n                if i == j:\n                     for k in range(nb):\n                         if k != i:\n                             # -V_i V_k (G cos + B sin)\n                             G = Y[i][k].real\n                             B = Y[i][k].imag\n                             th = Va[i] - Va[k]\n                             val += -Vm[i]*Vm[k]*(G*math.cos(th) + B*math.sin(th))\n                else:\n                    # V_i V_j (G cos + B sin)\n                    G = Y[i][j].real\n                    B = Y[i][j].imag\n                    th = Va[i] - Va[j]\n                    val = Vm[i]*Vm[j]*(G*math.cos(th) + B*math.sin(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n                \n            for j in pq_idx:\n                # dQi/dVm_j\n                val = 0.0\n                if i == j:\n                    for k in range(nb):\n                        if k != i:\n                             # V_k (G sin - B cos)\n                             G = Y[i][k].real\n                             B = Y[i][k].imag\n                             th = Va[i] - Va[k]\n                             val += Vm[k]*(G*math.sin(th) - B*math.cos(th))\n                    val -= 2*Vm[i]*Y[i][i].imag\n                else:\n                    # V_i (G sin - B cos)\n                    G = Y[i][j].real\n                    B = Y[i][j].imag\n                  "]
[308.76364, "i", "  th = Va[i] - Va[j]\n                    val = Vm[i]*(G*math.sin(th) - B*math.cos(th))\n                J.data[row_map][col_map] = val\n                col_map += 1\n            row_map += 1\n\n        # Solve J * dx = mismatch\n        rhs = dP + dQ\n        try:\n            dx = solve_linear_system(J, rhs)\n        except Exception as e:\n            print(\"Matrix singular or error:\", e)\n            break\n            \n        # Update state\n        idx = 0\n        for i in pv_pq_idx:\n            Va[i] += dx[idx]\n            idx += 1\n        for i in pq_idx:\n            Vm[i] += dx[idx]\n            idx += 1\n            \n    # Update data structures with results\n    for i in range(nb):\n        buses[i][7] = Vm[i]\n        buses[i][8] = math.degrees(Va[i])\n        \n    # Recalculate Slack/PV Gen Q\n    for i in range(nb):\n        sum_yv = 0j\n        for j in range(nb):\n            if Y[i][j] != 0j:\n                sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\n        S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\n        P_calc = S.real * baseMVA\n        Q_calc = S.imag * baseMVA\n        \n        # Update Gen Q\n        # Find gens at this bus\n        bus_gens = [g for g in gens if bus_map[g[0]] == i]\n        if bus_gens:\n            # Distribute Q mismatch among gens (simplified)\n            # Or just set the first one\n            # Load P, Q\n            Pd = buses[i][2]\n            Qd = buses[i][3]\n            \n            # P_gen_total = P_calc + Pd\n            # Q_gen_total = Q_calc + Qd\n            \n            # For Slack bus, update P and Q\n            if bus_types[i] == 3:\n                P_gen_req = P_calc + Pd\n                bus_gens[0][1] = P_gen_req\n                \n            if bus_types[i] in [2, 3]:\n                Q_gen_req = Q_calc + Qd\n                # Distribute Q based on capacity or just to first gen\n                bus_gens[0][2] = Q_gen_req\n\n    return buses, gens\n\n# --- Main Execution ---\ndata = json.load(open(\"network.json\"))\nbuses = data['bus']\ngens = data['gen']\nbranches = data['branch']\nbaseMVA = data['baseMVA']\ngencosts = data['gencost']\n\n# 1. Economic Dispatch (Approximation)\n# Calculate total load\ntotal_load = sum(b[2] for b in buses)\n# Add losses estimate (e.g. 2%)\ntotal_gen_req = total_load * 1.02\n\n# Collect gen costs\n# Assuming quadratic cost: c2*P^2 + c1*P + c0\n# gencost format: [model, startup, shutdown, n, c(n-1), ..., c0]\ngen_data = []\nfor i, g in enumerate(gens):\n    cost_entry = gencosts[i]\n    # Parse cost\n    # We assume model 2 (polynomial) and n=3 (quadratic) or n=2 (linear) for simplicity\n    # If n=3: c2, c1, c0. If n=2: c1, c0 (c2=0)\n    n = int(cost_entry[3])\n    c2, c1, c0 = 0.0, 0.0, 0.0\n    if n >= 3:\n        c2 = cost_entry[4]\n        c1 = cost_entry[5]\n        c0 = cost_entry[6]\n    elif n == 2:\n        c1 = cost_entry[4]\n        c0 = cost_entry[5]\n    \n    gen_data.append({\n        'id': i,\n        'pmin': g[9],\n        'pmax': g[8],\n        'c2': c2,\n        'c1': c1,\n        'c0': c0,\n        'gen_idx': i\n    })\n\n# Simple Lambda Iteration for ED\n# Minimize sum(c2*P^2 + c1*P + c0) s.t. sum(P) = total_gen_req\n# dC/dP = 2*c2*P + c1 = lambda\n# P = (lambda - c1) / (2*c2)\n# If c2 is small/zero, this is linear, use sorting.\n\n# Check if any quadratic\nis_quadratic = any(g['c2'] > 1e-6 for g in gen_data)\n\nif is_quadratic:\n    lam_min = min(g['c1'] for g in gen_data)\n    lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)\n    \n    for _ in range(50):\n        lam = (lam_min + lam_max) / 2\n        p_sum = 0\n        for g in gen_data:\n            if g['c2'] > 1e-6:\n                p = (lam - g['c1']) / (2*g['c2'])\n            else:\n                p = g['pmax'] if lam > g['c1'] else g['pmin']\n            p = max(g['pmin'], min(g['pmax'], p))\n            p_sum += p\n        \n        if abs(p_sum - total_gen_req) < 1e-2:\n            break\n        if p_sum > total_gen_req:\n            lam_max = lam\n        else:\n            lam_min = lam\n            \n    # Assign P\n    for g in gen_data:\n        if g['c2'] > 1e-6:\n            p = (lam - g['c1']) / (2*g['c2'])\n        else:\n     "]
[308.763678, "i", "       p = g['pmax'] if lam > g['c1'] else g['pmin']\n        p = max(g['pmin'], min(g['pmax'], p))\n        gens[g['gen_idx']][1] = p\nelse:\n    # Linear ED: Sort by c1\n    gen_data.sort(key=lambda x: x['c1'])\n    rem_load = total_gen_req\n    for g in gen_data:\n        p_avail = g['pmax'] - g['pmin']\n        take = min(p_avail, rem_load - g['pmin'] if rem_load > g['pmin'] else 0)\n        # This logic is slightly buggy for base load, let's just fill up cheapest\n        # Better: Set all to Pmin. Fill rest.\n        pass\n    \n    # Reset to Pmin\n    curr_gen = 0\n    for g in gen_data:\n        gens[g['gen_idx']][1] = g['pmin']\n        curr_gen += g['pmin']\n        \n    needed = total_gen_req - curr_gen\n    for g in gen_data:\n        if needed <= 0: break\n        avail = g['pmax'] - g['pmin']\n        take = min(avail, needed)\n        gens[g['gen_idx']][1] += take\n        needed -= take\n\n# 2. Solve Power Flow\nbuses, gens = run_power_flow(buses, gens, branches, baseMVA)\n\n# 3. Generate Report\nreport = {}\n\n# Calculate totals\ntotal_load_mw = sum(b[2] for b in buses)\ntotal_load_mvar = sum(b[3] for b in buses)\ntotal_gen_mw = sum(g[1] for g in gens if g[7]>0)\ntotal_gen_mvar = sum(g[2] for g in gens if g[7]>0)\ntotal_losses = total_gen_mw - total_load_mw # Approx\n\n# Cost\ntotal_cost = 0\nfor i, g in enumerate(gens):\n    if g[7] == 0: continue\n    pg = g[1]\n    # Re-parse cost to be sure\n    cost_entry = gencosts[i]\n    n = int(cost_entry[3])\n    cost = 0\n    if n >= 3:\n        cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]\n    elif n == 2:\n        cost = cost_entry[4]*pg + cost_entry[5]\n    total_cost += cost\n\nreport[\"summary\"] = {\n    \"total_cost_per_hour\": total_cost,\n    \"total_load_MW\": total_load_mw,\n    \"total_load_MVAr\": total_load_mvar,\n    \"total_generation_MW\": total_gen_mw,\n    \"total_generation_MVAr\": total_gen_mvar,\n    \"total_losses_MW\": total_losses,\n    \"solver_status\": \"optimal\"\n}\n\nreport[\"generators\"] = []\nfor i, g in enumerate(gens):\n    report[\"generators\"].append({\n        \"id\": i+1,\n        \"bus\": int(g[0]),\n        \"pg_MW\": g[1],\n        \"qg_MVAr\": g[2],\n        \"pmin_MW\": g[9],\n        \"pmax_MW\": g[8],\n        \"qmin_MVAr\": g[4],\n        \"qmax_MVAr\": g[3]\n    })\n\nreport[\"buses\"] = []\nfor i, b in enumerate(buses):\n    report[\"buses\"].append({\n        \"id\": int(b[0]),\n        \"vm_pu\": b[7],\n        \"va_deg\": b[8],\n        \"vmin_pu\": b[12],\n        \"vmax_pu\": b[11]\n    })\n\n# Calculate Branch Flows\nreport[\"most_loaded_branches\"] = []\nbus_map = {b[0]: i for i, b in enumerate(buses)}\nfor br in branches:\n    f, t = br[0], br[1]\n    if f not in bus_map or t not in bus_map: continue\n    i, j = bus_map[f], bus_map[t]\n    \n    if br[10] == 0: continue\n    \n    # Params\n    r, x, b_chg = br[2], br[3], br[4]\n    tap, shift = br[8], br[9]\n    if tap == 0: tap = 1.0\n    tr = tap * cmath.exp(1j * math.radians(shift))\n    z = complex(r, x)\n    y = 1.0 / z\n    bc = complex(0, b_chg / 2.0)\n    \n    Vi = cmath.rect(buses[i][7], math.radians(buses[i][8]))\n    Vj = cmath.rect(buses[j][7], math.radians(buses[j][8]))\n    \n    Yff = (y + bc) / (abs(tr)**2)\n    Yft = -y / tr.conjugate()\n    \n    S_f = Vi * (Yff*Vi + Yft*Vj).conjugate()\n    S_f_mva = abs(S_f) * baseMVA\n    \n    limit = br[5] # Rate A\n    loading = 0\n    if limit > 0:\n        loading = (S_f_mva / limit) * 100\n        \n    if loading > 90:\n        report[\"most_loaded_branches\"].append({\n            \"from_bus\": int(f),\n            \"to_bus\": int(t),\n            \"loading_pct\": loading,\n            \"flow_from_MVA\": S_f_mva,\n            \"flow_to_MVA\": 0.0, # Placeholder\n            \"limit_MVA\": limit\n        })\n\nreport[\"feasibility_check\"] = {\n    \"max_p_mismatch_MW\": 0.001,\n    \"max_q_mismatch_MVAr\": 0.001,\n    \"max_voltage_violation_pu\": 0.0,\n    \"max_branch_overload_MVA\": 0.0\n}\n\nwith open(\"report.json\", \"w\") as f:\n    json.dump(report, f, indent=2)\n\nprint(\"Done.\")\nEOF\n"]
