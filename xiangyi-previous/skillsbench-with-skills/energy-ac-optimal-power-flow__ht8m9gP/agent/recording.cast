[593.629802, "o", "\u001b[?2004h> "]
[593.629905, "o", "                         if k != i:\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.629927, "o", "> "]
[593.630127, "o", "                             Gk = Y[i][k].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.630148, "o", "> "]
[593.630317, "o", "                             Bk = Y[i][k].imag\r\n\u001b[?2004l\rs\u001b[?2004h"]
[593.63034, "o", "> "]
