[308.766143, "o", "            res[i][i] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.766212, "o", ">         return res\r\n\u001b[?2004l\r"]
[308.766273, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.766386, "o", "    def multiply_vec(self, vec):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.766535, "o", "        if self.cols != len(vec):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.766614, "o", "> "]
[308.76671, "o", "            raise ValueError(\"Dimension mismatch\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.766788, "o", "> "]
[308.766862, "o", "        res = [0.0] * self.rows\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.766931, "o", "> "]
[308.767004, "o", "        for i in range(self.rows):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.767044, "o", "> "]
[308.767129, "o", "            sum_val = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767206, "o", "            row = self.data[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767332, "o", "            for j in range(self.cols):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767456, "o", "                sum_val += row[j] * vec[j]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767537, "o", "            res[i] = sum_val\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.767605, "o", ">         return res\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.767669, "o", "p\u001b[?2004h> "]
[308.767732, "o", "def solve_linear_system(A, b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767898, "o", "    # Gaussian elimination with partial pivoting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.767967, "o", "    n = len(b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.768049, "o", "    # Create augmented matrix\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.768118, "o", "> "]
[308.768235, "o", "    M = [row[:] + [b[i]] for i, row in enumerate(A.data)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r:"]
[308.768282, "o", "\u001b[?2004h> "]
[308.768361, "o", "    for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.768405, "o", "        # Pivot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.768487, "o", "        max_row = i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.768666, "o", "        for k in range(i + 1, n):\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[308.76878, "o", "            if abs(M[k][i]) > abs(M[max_row][i]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.768898, "o", "                max_row = k\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.768963, "o", "> "]
[308.769105, "o", "        M[i], M[max_row] = M[max_row], M[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.769164, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.769226, "o", "> "]
[308.769285, "o", "        if abs(M[i][i]) < 1e-12:\r\n\u001b[?2004l\r"]
[308.769328, "o", "\u001b[?2004h> "]
[308.769486, "o", "            continue # Singular or close to it\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.769546, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.769622, "o", "        # Eliminate\r\n\u001b[?2004l\r"]
[308.769696, "o", "\u001b[?2004h> "]
[308.769787, "o", "        for k in range(i + 1, n):\r\n\u001b[?2004l\r"]
[308.769853, "o", "\u001b[?2004h> "]
[308.769969, "o", "            factor = M[k][i] / M[i][i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.770001, "o", "> "]
[308.770137, "o", "            for j in range(i, n + 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.77031, "o", "                M[k][j] -= factor * M[i][j]\r\n\u001b[?2004l\r"]
[308.770394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.770456, "o", "    # Back substitution\r\n\u001b[?2004l\r"]
[308.770517, "o", "\u001b[?2004h> "]
[308.770582, "o", "    x = [0.0] * n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.770707, "o", "    for i in range(n - 1, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.770762, "o", "> "]
[308.770933, "o", "        sum_ax = sum(M[i][j] * x[j] for j in range(i + 1, n))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.770988, "o", "> "]
[308.771073, "o", "        if abs(M[i][i]) > 1e-12:\r\n\u001b[?2004l\r"]
[308.771136, "o", "\u001b[?2004h> "]
[308.771284, "o", "            x[i] = (M[i][n] - sum_ax) / M[i][i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.771341, "o", "    return x\r\n\u001b[?2004l\r"]
[308.771421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.771481, "o", "\u001b[?2004h> "]
[308.771563, "o", "# --- Power System Classes ---\r\n\u001b[?2004l\r"]
[308.771628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.771774, "o", "def get_ybus(buses, branches):\r\n\u001b[?2004l\r"]
[308.771842, "o", "\u001b[?2004h> "]
[308.771917, "o", "    nb = len(buses)\r\n\u001b[?2004l\r"]
[308.771967, "o", "\u001b[?2004h> "]
[308.772146, "o", "    # Map bus ID (1-based) to index (0-based)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.77221, "o", "> "]
[308.772372, "o", "    bus_map = {b[0]: i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.772406, "o", "> "]
[308.77256, "o", "    Y = [[0j] * nb for _ in range(nb)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.772617, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.77268, "o", "    # Shunts\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.772741, "o", "> "]
[308.772855, "o", "    for i, b in enumerate(buses):\r\n\u001b[?2004l\r"]
[308.772925, "o", "\u001b[?2004h> "]
[308.773017, "o", "        gs, bs = b[4], b[5]\r\n\u001b[?2004l\r"]
[308.773072, "o", "\u001b[?2004h> "]
[308.773209, "o", "        Y[i][i] += complex(gs, bs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.773277, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[308.773331, "o", "    # Branches\r\n\u001b[?2004l\r"]
[308.773389, "o", "\u001b[?2004h> "]
[308.773451, "o", "    for br in branches:\r\n\u001b[?2004l\r"]
[308.773521, "o", "\u001b[?2004h> "]
[308.773601, "o", "        f, t = br[0], br[1]\r\n\u001b[?2004l\r"]
[308.773661, "o", "\u001b[?2004h> "]
[308.773824, "o", "        if f not in bus_map or t not in bus_map: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.773896, "o", "> "]
[308.773986, "o", "        i, j = bus_map[f], bus_map[t]\r\n\u001b[?2004l\r"]
[308.774019, "o", "\u001b[?2004h> "]
[308.774054, "o", "        \r\n\u001b[?2004l\r"]
[308.774119, "o", "\u001b[?2004h> "]
[308.774256, "o", "        r, x, b_chg = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.774292, "o", "> "]
[308.774429, "o", "        tap, shift = br[8], br[9]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.774489, "o", "> "]
[308.774564, "o", "        status = br[10]\r\n\u001b[?2004l\r"]
[308.774625, "o", "\u001b[?2004h>         \r\n"]
[308.774686, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[308.774819, "o", "        if status == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.774882, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.775009, "o", "        z = complex(r, x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.775079, "o", "> "]
[308.775151, "o", "        y = 1.0 / z\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.775318, "o", "        bc = complex(0, b_chg / 2.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.775396, "o", "> "]
[308.775452, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.775502, "o", "        # Transformer model\r\n\u001b[?2004l\r"]
[308.775574, "o", "\u001b[?2004h> "]
[308.775655, "o", "        if tap == 0: tap = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.775717, "o", "> "]
[308.775908, "o", "        tr = tap * cmath.exp(1j * math.radians(shift))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.775972, "o", ">         \r\n"]
[308.776037, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[308.776169, "o", "        Y[i][i] += (y + bc) / (abs(tr)**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.776221, "o", "> "]
[308.776311, "o", "        Y[j][j] += (y + bc)\r\n\u001b[?2004l\r"]
[308.776369, "o", "\u001b[?2004h> "]
[308.776506, "o", "        Y[i][j] -= y / tr.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.77656, "o", "> "]
[308.776638, "o", "        Y[j][i] -= y / tr\r\n\u001b[?2004l\r"]
[308.776696, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[308.776757, "o", "\u001b[?2004h> "]
[308.776808, "o", "    return Y, bus_map\r\n\u001b[?2004l\r"]
[308.776868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[308.777087, "o", "def run_power_flow(buses, gens, branches, baseMVA):\r\n\u001b[?2004l\r"]
[308.777123, "o", "\u001b[?2004h> "]
[308.7772, "o", "    nb = len(buses)\r\n\u001b[?2004l\r"]
[308.777234, "o", "\u001b[?2004h> "]
[308.777407, "o", "    Y, bus_map = get_ybus(buses, branches)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.777476, "o", "    \r\n\u001b[?2004l\r"]
[308.777512, "o", "\u001b[?2004h> "]
[308.777579, "o", "    # Initial State\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.777705, "o", "    Vm = [b[7] for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.777742, "o", "> "]
[308.777907, "o", "    Va = [math.radians(b[8]) for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.777943, "o", ">     \r\n\u001b[?2004l\r"]
[308.778043, "o", "\u001b[?2004h> "]
[308.778133, "o", "    # Bus Types: 1=PQ, 2=PV, 3=Slack\r\n\u001b[?2004l\r"]
[308.778189, "o", "\u001b[?2004h> "]
[308.77833, "o", "    bus_types = [int(b[1]) for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.77839, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.778566, "o", "    # Net injections (Generation - Load)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.778622, "o", "> "]
[308.778773, "o", "    P_inj = [-b[2]/baseMVA for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.778835, "o", "> "]
[308.778979, "o", "    Q_inj = [-b[3]/baseMVA for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.779037, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.779162, "o", "    # Add generation\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.779236, "o", "> "]
[308.779291, "o", "    gen_bus_map = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.779355, "o", "> "]
[308.779409, "o", "    for g in gens:\r\n\u001b[?2004l\r"]
[308.779443, "o", "\u001b[?2004h> "]
[308.779515, "o", "        gb = g[0]\r\n\u001b[?2004l\r"]
[308.779578, "o", "\u001b[?2004h> "]
[308.779665, "o", "        if gb in bus_map:\r\n\u001b[?2004l\r"]
[308.779723, "o", "\u001b[?2004h> "]
[308.779838, "o", "            idx = bus_map[gb]\r\n\u001b[?2004l\r"]
[308.779898, "o", "\u001b[?2004h> "]
[308.780028, "o", "            if g[7] > 0: # Status\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.780106, "o", "> "]
[308.780255, "o", "                P_inj[idx] += g[1]/baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.780327, "o", "> "]
[308.780457, "o", "                Q_inj[idx] += g[2]/baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.780515, "o", "> "]
[308.780686, "o", "                if bus_types[idx] == 2: # PV bus\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.780745, "o", "> "]
[308.780998, "o", "                    Vm[idx] = g[5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781085, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[308.781156, "o", "    # Newton-Raphson\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781217, "o", "> "]
[308.781301, "o", "    max_iter = 20\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781372, "o", ">     tol = 1e-4\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781446, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.781579, "o", "    # Indices to solve for\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781653, "o", "> "]
[308.781837, "o", "    pv_pq_idx = [i for i, t in enumerate(bus_types) if t in [1, 2]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.781897, "o", "> "]
[308.782085, "o", "    pq_idx = [i for i, t in enumerate(bus_types) if t == 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.782147, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.782294, "o", "    for it in range(max_iter):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.782352, "o", "> "]
[308.782426, "o", "        # Calculate mismatch\r\n\u001b[?2004l\r"]
[308.782488, "o", "\u001b[?2004h> "]
[308.782547, "o", "        mismatch_P = []\r\n\u001b[?2004l\r"]
[308.782625, "o", "\u001b[?2004h> "]
[308.782703, "o", "        mismatch_Q = []\r\n\u001b[?2004l\r"]
[308.782755, "o", "\u001b[?2004h> "]
[308.782819, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.782962, "o", "        current_P = [0.0] * nb\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783023, "o", "> "]
[308.783135, "o", "        current_Q = [0.0] * nb\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783198, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783273, "o", "> "]
[308.783342, "o", "        for i in range(nb):\r\n\u001b[?2004l\r"]
[308.783377, "o", "\u001b[?2004h> "]
[308.783495, "o", "            sum_yv = 0j\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783545, "o", "> "]
[308.783671, "o", "            for j in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783734, "o", "> "]
[308.783874, "o", "                if Y[i][j] != 0j:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.783928, "o", "> "]
[308.784143, "o", "                    sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.784208, "o", "> "]
[308.784445, "o", "            S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.784494, "o", "> "]
[308.784631, "o", "            current_P[i] = S.real\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.784689, "o", "> "]
[308.784822, "o", "            current_Q[i] = S.imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.784875, "o", "> "]
[308.784912, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.784981, "o", "> "]
[308.785184, "o", "        dP = [P_inj[i] - current_P[i] for i in pv_pq_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.785255, "o", "> "]
[308.785432, "o", "        dQ = [Q_inj[i] - current_Q[i] for i in pq_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.785481, "o", ">         \r\n\u001b[?2004l\r"]
[308.785531, "o", "\u001b[?2004h> "]
[308.785771, "o", "        mismatch = max([abs(x) for x in dP + dQ]) if (dP+dQ) else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.785822, "o", "> "]
[308.785939, "o", "        if mismatch < tol:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.785998, "o", "> "]
[308.786177, "o", "            print(f\"Converged in {it} iterations\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.786245, "o", "> "]
[308.786316, "o", "            break\r\n\u001b[?2004l\r"]
[308.78637, "o", "\u001b[?2004h> "]
[308.786405, "o", "            \r\n\u001b[?2004l\r"]
[308.786474, "o", "\u001b[?2004h> "]
[308.78655, "o", "        # Jacobian\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.786606, "o", "> "]
[308.786747, "o", "        # J11: dP/dVa, J12: dP/dVm\r\n\u001b[?2004l\r"]
[308.786813, "o", "\u001b[?2004h> "]
[308.786949, "o", "        # J21: dQ/dVa, J22: dQ/dVm\r\n\u001b[?2004l\r"]
[308.787002, "o", "\u001b[?2004h> "]
[308.787076, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.787131, "o", "> "]
[308.787307, "o", "        n_unknowns = len(pv_pq_idx) + len(pq_idx)\r\n\u001b[?2004l\r"]
[308.78737, "o", "\u001b[?2004h> "]
[308.787531, "o", "        J = Matrix(n_unknowns, n_unknowns)\r\n\u001b[?2004l\r"]
[308.787581, "o", "\u001b[?2004h> "]
[308.787649, "o", "        \r\n\u001b[?2004l\r"]
[308.787717, "o", "\u001b[?2004h> "]
[308.788021, "o", "        # Populate Jacobian (Simplified for brevity, standard polar formulation)\r\n\u001b[?2004l\r"]
[308.788079, "o", "\u001b[?2004h> "]
[308.788255, "o", "        # Map full index to reduced index\r\n\u001b[?2004l\r"]
[308.788304, "o", "\u001b[?2004h> "]
[308.78841, "o", "        row_map = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.788482, "o", "> "]
[308.788589, "o", "        for i in pv_pq_idx:\r\n\u001b[?2004l\r"]
[308.788659, "o", "\u001b[?2004h> "]
[308.788757, "o", "            col_map = 0\r\n\u001b[?2004l\r"]
[308.788811, "o", "\u001b[?2004h> "]
[308.788948, "o", "            for j in pv_pq_idx:\r\n\u001b[?2004l\r"]
[308.789005, "o", "\u001b[?2004h> "]
[308.789132, "o", "                # dPi/dVa_j\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.789187, "o", "> "]
[308.789297, "o", "                val = 0.0\r\n\u001b[?2004l\r"]
[308.789349, "o", "\u001b[?2004h> "]
[308.789471, "o", "                if i == j:\r\n\u001b[?2004l\r"]
[308.789506, "o", "\u001b[?2004h> "]
[308.789684, "o", "                     for k in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.789759, "o", "> "]
[308.789888, "o", "                         if k != i:\r\n\u001b[?2004l\r"]
[308.789943, "o", "\u001b[?2004h> "]
[308.790152, "o", "                             # -V_i V_k (G sin - B cos)\r\n\u001b[?2004l\r"]
[308.790222, "o", "\u001b[?2004h> "]
[308.790395, "o", "                             G = Y[i][k].real\r\n\u001b[?2004l\r"]
[308.790457, "o", "\u001b[?2004h> "]
[308.790629, "o", "                             B = Y[i][k].imag\r\n\u001b[?2004l\r"]
[308.790676, "o", "\u001b[?2004h> "]
[308.790865, "o", "                             th = Va[i] - Va[k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.79093, "o", "> "]
[308.791212, "o", "                             val += -Vm[i]*Vm[k]*(G*math.sin(th) - B*math.cos(th))\r\n\u001b[?2004l\r"]
[308.791261, "o", "\u001b[?2004h> "]
[308.791353, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.791525, "o", "                    # V_i V_j (G sin - B cos)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.791576, "o", "> "]
[308.791703, "o", "                    G = Y[i][j].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.79174, "o", "> "]
[308.791898, "o", "                    B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.791955, "o", "> "]
[308.792092, "o", "                    th = Va[i] - Va[j]\r\n\u001b[?2004l\r"]
[308.792132, "o", "\u001b[?2004h> "]
[308.792407, "o", "                    val = Vm[i]*Vm[j]*(G*math.sin(th) - B*math.cos(th))\r\n\u001b[?2004l\r"]
[308.792486, "o", "\u001b[?2004h> "]
[308.792612, "o", "                J.data[row_map][col_map] = val\r\n\u001b[?2004l\r"]
[308.792661, "o", "\u001b[?2004h> "]
[308.792782, "o", "                col_map += 1\r\n\u001b[?2004l\r"]
[308.792837, "o", "\u001b[?2004h> "]
[308.792903, "o", "            \r\n\u001b[?2004l\r"]
[308.792968, "o", "\u001b[?2004h> "]
[308.793088, "o", "            for j in pq_idx:\r\n\u001b[?2004l\r"]
[308.793126, "o", "\u001b[?2004h> "]
[308.793262, "o", "                # dPi/dVm_j\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.793315, "o", "> "]
[308.793421, "o", "                val = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.79349, "o", "> "]
[308.793585, "o", "                if i == j:\r\n\u001b[?2004l\r"]
[308.793639, "o", "\u001b[?2004h> "]
[308.793802, "o", "                    for k in range(nb):\r\n\u001b[?2004l\r"]
[308.793857, "o", "\u001b[?2004h> "]
[308.794002, "o", "                        if k != i:\r\n\u001b[?2004l\r"]
[308.794058, "o", "\u001b[?2004h> "]
[308.794212, "o", "                             # V_k (G cos + B sin)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.794266, "o", "> "]
[308.794401, "o", "                             G = Y[i][k].real\r\n\u001b[?2004l\r"]
[308.79447, "o", "\u001b[?2004h> "]
[308.794637, "o", "                             B = Y[i][k].imag\r\n\u001b[?2004l\r"]
[308.794699, "o", "\u001b[?2004h> "]
[308.794861, "o", "                             th = Va[i] - Va[k]\r\n\u001b[?2004l\r"]
[308.794913, "o", "\u001b[?2004h> "]
[308.795161, "o", "                             val += Vm[k]*(G*math.cos(th) + B*math.sin(th))\r\n\u001b[?2004l\r"]
[308.795214, "o", "\u001b[?2004h> "]
[308.795357, "o", "                    val += 2*Vm[i]*Y[i][i].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.795431, "o", "> "]
[308.7955, "o", "                else:\r\n\u001b[?2004l\r"]
[308.795573, "o", "\u001b[?2004h> "]
[308.795739, "o", "                    # V_i (G cos + B sin)\r\n\u001b[?2004l\r"]
[308.795788, "o", "\u001b[?2004h> "]
[308.795951, "o", "                    G = Y[i][j].real\r\n\u001b[?2004l\r"]
[308.796023, "o", "\u001b[?2004h> "]
[308.796172, "o", "                    B = Y[i][j].imag\r\n\u001b[?2004l\r"]
[308.796244, "o", "\u001b[?2004h> "]
[308.796383, "o", "                    th = Va[i] - Va[j]\r\n\u001b[?2004l\r"]
[308.796446, "o", "\u001b[?2004h> "]
[308.796671, "o", "                    val = Vm[i]*(G*math.cos(th) + B*math.sin(th))\r\n\u001b[?2004l\r"]
[308.796727, "o", "\u001b[?2004h> "]
[308.796904, "o", "                J.data[row_map][col_map] = val\r\n\u001b[?2004l\r"]
[308.796974, "o", "\u001b[?2004h> "]
[308.797111, "o", "                col_map += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.797166, "o", "> "]
[308.797281, "o", "            row_map += 1\r\n\u001b[?2004l\r"]
[308.797332, "o", "\u001b[?2004h> "]
[308.797383, "o", "            \r\n\u001b[?2004l\r"]
[308.797417, "o", "\u001b[?2004h> "]
[308.797554, "o", "        for i in pq_idx:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.797692, "o", "            col_map = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.797742, "o", "> "]
[308.79788, "o", "            for j in pv_pq_idx:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.797915, "o", "> "]
[308.798053, "o", "                # dQi/dVa_j\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.798195, "o", "                val = 0.0\r\n\u001b[?2004l\r"]
[308.798259, "o", "\u001b[?2004h> "]
[308.798375, "o", "                if i == j:\r\n\u001b[?2004l\r"]
[308.798427, "o", "\u001b[?2004h> "]
[308.798588, "o", "                     for k in range(nb):\r\n\u001b[?2004l\r"]
[308.798654, "o", "\u001b[?2004h> "]
[308.798803, "o", "                         if k != i:\r\n\u001b[?2004l\r"]
[308.798868, "o", "\u001b[?2004h> "]
[308.79907, "o", "                             # -V_i V_k (G cos + B sin)\r\n\u001b[?2004l\r"]
[308.799141, "o", "\u001b[?2004h> "]
[308.799309, "o", "                             G = Y[i][k].real\r\n\u001b[?2004l\r"]
[308.799374, "o", "\u001b[?2004h> "]
[308.79954, "o", "                             B = Y[i][k].imag\r\n\u001b[?2004l\r"]
[308.799604, "o", "\u001b[?2004h> "]
[308.799788, "o", "                             th = Va[i] - Va[k]\r\n\u001b[?2004l\r"]
[308.799847, "o", "\u001b[?2004h> "]
[308.800124, "o", "                             val += -Vm[i]*Vm[k]*(G*math.cos(th) + B*math.sin(th))\r\n\u001b[?2004l\r"]
[308.800184, "o", "\u001b[?2004h> "]
[308.800272, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.800351, "o", "> "]
[308.800499, "o", "                    # V_i V_j (G cos + B sin)\r\n\u001b[?2004l\r"]
[308.800572, "o", "\u001b[?2004h> "]
[308.80072, "o", "                    G = Y[i][j].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.800791, "o", "> "]
[308.800933, "o", "                    B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.801006, "o", "> "]
[308.801154, "o", "                    th = Va[i] - Va[j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.801191, "o", "> "]
[308.801441, "o", "                    val = Vm[i]*Vm[j]*(G*math.cos(th) + B*math.sin(th))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.80149, "o", "> "]
[308.801665, "o", "                J.data[row_map][col_map] = val\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.801715, "o", "> "]
[308.801848, "o", "                col_map += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.801897, "o", "> "]
[308.801975, "o", "                \r\n\u001b[?2004l\r"]
[308.802037, "o", "\u001b[?2004h> "]
[308.802159, "o", "            for j in pq_idx:\r\n\u001b[?2004l\r"]
[308.802213, "o", "\u001b[?2004h> "]
[308.80234, "o", "                # dQi/dVm_j\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.80239, "o", "> "]
[308.802509, "o", "                val = 0.0\r\n\u001b[?2004l\r"]
[308.802573, "o", "\u001b[?2004h> "]
[308.802677, "o", "                if i == j:\r\n\u001b[?2004l\r"]
[308.802728, "o", "\u001b[?2004h> "]
[308.802891, "o", "                    for k in range(nb):\r\n\u001b[?2004l\r"]
[308.802944, "o", "\u001b[?2004h> "]
[308.80309, "o", "                        if k != i:\r\n\u001b[?2004l\r"]
[308.803146, "o", "\u001b[?2004h> "]
[308.80334, "o", "                             # V_k (G sin - B cos)\r\n\u001b[?2004l\r"]
[308.803395, "o", "\u001b[?2004h> "]
[308.803565, "o", "                             G = Y[i][k].real\r\n\u001b[?2004l\r"]
[308.803614, "o", "\u001b[?2004h> "]
[308.803856, "o", "                             B = Y[i][k].imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.804021, "o", "                             th = Va[i] - Va[k]\r\n\u001b[?2004l\r"]
[308.804079, "o", "\u001b[?2004h> "]
[308.804337, "o", "                             val += Vm[k]*(G*math.sin(th) - B*math.cos(th))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.804375, "o", "> "]
[308.804509, "o", "                    val -= 2*Vm[i]*Y[i][i].imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.804578, "o", "> "]
[308.80465, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.804707, "o", "> "]
[308.804831, "o", "                    # V_i (G sin - B cos)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.804868, "o", "> "]
[308.804993, "o", "                    G = Y[i][j].real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.80516, "o", "                    B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.805227, "o", "> "]
[308.805342, "o", "                    th = Va[i] - Va[j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.8054, "o", "> "]
[308.805587, "o", "                    val = Vm[i]*(G*math.sin(th) - B*math.cos(th))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.805652, "o", "> "]
[308.805817, "o", "                J.data[row_map][col_map] = val\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.805874, "o", "> "]
[308.805942, "o", "                col_map += 1\r\n\u001b[?2004l\r"]
[308.806001, "o", "\u001b[?2004h> "]
[308.806117, "o", "            row_map += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.80619, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.80633, "o", "        # Solve J * dx = mismatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.806389, "o", "> "]
[308.806444, "o", "        rhs = dP + dQ\r\n\u001b[?2004l\r"]
[308.806503, "o", "\u001b[?2004h> "]
[308.806575, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.806729, "o", "            dx = solve_linear_system(J, rhs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.806778, "o", "> "]
[308.806911, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.806946, "o", "> "]
[308.807125, "o", "            print(\"Matrix singular or error:\", e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.807244, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.807318, "o", "> "]
[308.807386, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.807451, "o", "        # Update state\r\n\u001b[?2004l\r"]
[308.80752, "o", "\u001b[?2004h> "]
[308.80758, "o", "        idx = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.807706, "o", "        for i in pv_pq_idx:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.807777, "o", "> "]
[308.807873, "o", "            Va[i] += dx[idx]\r\n\u001b[?2004l\r"]
[308.807912, "o", "\u001b[?2004h> "]
[308.808, "o", "            idx += 1\r\n\u001b[?2004l\r"]
[308.808077, "o", "\u001b[?2004h> "]
[308.808169, "o", "        for i in pq_idx:\r\n\u001b[?2004l\r"]
[308.808228, "o", "\u001b[?2004h> "]
[308.808355, "o", "            Vm[i] += dx[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.808416, "o", "> "]
[308.808477, "o", "            idx += 1\r\n\u001b[?2004l\r"]
[308.808535, "o", "\u001b[?2004h> "]
[308.808607, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.808675, "o", "> "]
[308.808817, "o", "    # Update data structures with results\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.808884, "o", "> "]
[308.808958, "o", "    for i in range(nb):\r\n\u001b[?2004l\r"]
[308.809014, "o", "\u001b[?2004h> "]
[308.809132, "o", "        buses[i][7] = Vm[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.809205, "o", "> "]
[308.809345, "o", "        buses[i][8] = math.degrees(Va[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.809404, "o", ">         \r\n\u001b[?2004l\r"]
[308.809463, "o", "\u001b[?2004h> "]
[308.809601, "o", "    # Recalculate Slack/PV Gen Q\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.80967, "o", "> "]
[308.809743, "o", "    for i in range(nb):\r\n\u001b[?2004l\r"]
[308.8098, "o", "\u001b[?2004h> "]
[308.809883, "o", "        sum_yv = 0j\r\n\u001b[?2004l\r"]
[308.809941, "o", "\u001b[?2004h> "]
[308.810069, "o", "        for j in range(nb):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.810139, "o", "> "]
[308.810257, "o", "            if Y[i][j] != 0j:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.810489, "o", "                sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.810554, "o", "> "]
[308.810747, "o", "        S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.810816, "o", "> "]
[308.810941, "o", "        P_calc = S.real * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.811006, "o", "> "]
[308.811149, "o", "        Q_calc = S.imag * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.811215, "o", "> "]
[308.811294, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.811353, "o", "        # Update Gen Q\r\n\u001b[?2004l\r"]
[308.811412, "o", "\u001b[?2004h> "]
[308.811543, "o", "        # Find gens at this bus\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.811611, "o", "> "]
[308.813433, "o", "        bus_gens = [g for g in gens if bus_map[g[0]] == i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.817199, "o", "        if bus_gens:\r\n\u001b[?2004l\r"]
[308.817244, "o", "\u001b[?2004h"]
[308.81727, "o", "> "]
[308.817536, "o", "            # Distribute Q mismatch among gens (simplified)\r\n\u001b[?2004l\r"]
[308.817562, "o", "\u001b[?2004h> "]
[308.817733, "o", "            # Or just set the first one\r\n\u001b[?2004l\r"]
[308.817756, "o", "\u001b[?2004h"]
[308.817785, "o", "> "]
[308.817884, "o", "            # Load P, Q\r\n\u001b[?2004l\r"]
[308.817911, "o", "\u001b[?2004h"]
[308.817937, "o", "> "]
[308.818058, "o", "            Pd = buses[i][2]\r\n\u001b[?2004l\r"]
[308.818086, "o", "\u001b[?2004h> "]
[308.818216, "o", "            Qd = buses[i][3]\r\n\u001b[?2004l\r"]
[308.81824, "o", "\u001b[?2004h> "]
[308.818309, "o", "            \r\n\u001b[?2004l\r"]
[308.818336, "o", "\u001b[?2004h> "]
[308.818521, "o", "            # P_gen_total = P_calc + Pd\r\n\u001b[?2004l\r"]
[308.818543, "o", "\u001b[?2004h> "]
[308.818716, "o", "            # Q_gen_total = Q_calc + Qd\r\n\u001b[?2004l\r"]
[308.818739, "o", "\u001b[?2004h"]
[308.81876, "o", "> "]
[308.818815, "o", "            \r\n\u001b[?2004l\r"]
[308.818842, "o", "\u001b[?2004h"]
[308.818866, "o", "> "]
[308.820276, "o", "            # For Slack bus, update P and Q\r\n\u001b[?2004l\r\u001b[?2004h>             if bus_types[i] == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.820394, "o", "                P_gen_req = P_calc + Pd\r\n\u001b[?2004l\r"]
[308.820426, "o", "\u001b[?2004h> "]
[308.82064, "o", "                bus_gens[0][1] = P_gen_req\r\n\u001b[?2004l\r"]
[308.820672, "o", "\u001b[?2004h> "]
[308.820754, "o", "                \r\n\u001b[?2004l\r"]
[308.820782, "o", "\u001b[?2004h> "]
[308.820994, "o", "            if bus_types[i] in [2, 3]:\r\n\u001b[?2004l\r"]
[308.82102, "o", "\u001b[?2004h> "]
[308.821189, "o", "                Q_gen_req = Q_calc + Qd\r\n\u001b[?2004l\r"]
[308.82132, "o", "\u001b[?2004h> "]
[308.821457, "o", "                # Distribute Q based on capacity or just to first gen\r\n\u001b[?2004l\r"]
[308.821488, "o", "\u001b[?2004h> "]
[308.821668, "o", "                bus_gens[0][2] = Q_gen_req\r\n\u001b[?2004l\r"]
[308.821719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.821863, "o", "    return buses, gens\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r:\u001b[?2004h> "]
[308.821959, "o", "# --- Main Execution ---\r\n\u001b[?2004l\r"]
[308.82201, "o", "\u001b[?2004h> "]
[308.822132, "o", "data = json.load(open(\"network.json\"))\r\n\u001b[?2004l\r"]
[308.822214, "o", "\u001b[?2004h> "]
[308.822297, "o", "buses = data['bus']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.822355, "o", "gens = data['gen']\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.822384, "o", "> "]
[308.822495, "o", "branches = data['branch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.822604, "o", "baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.822863, "o", "gencosts = data['gencost']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.822951, "o", "# 1. Economic Dispatch (Approximation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.822983, "o", "> "]
[308.82327, "o", "# Calculate total load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.823424, "o", "total_load = sum(b[2] for b in buses)\r\n\u001b[?2004l\r"]
[308.823478, "o", "\u001b[?2004h> "]
[308.823577, "o", "# Add losses estimate (e.g. 2%)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.823682, "o", "total_gen_req = total_load * 1.02\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.823721, "o", "> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[308.8241, "o", "# Collect gen costs\r\n\u001b[?2004l\r\u001b[?2004h> # Assuming quadratic cost: c2*P^2 + c1*P + c0\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[308.824724, "o", "# gencost format: [model, startup, shutdown, n, c(n-1), ..., c0]\r\n\u001b[?2004l\r\u001b[?2004h> gen_data = []\r\n\u001b[?2004l\r\u001b[?2004h> for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h>     cost_entry = gencosts[i]\r\n\u001b[?2004l\r\u001b[?2004h>     # Parse cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.824904, "o", "    # We assume model 2 (polynomial) and n=3 (quadratic) or n=2 (linear) for simplicity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.825061, "o", "    # If n=3: c2, c1, c0. If n=2: c1, c0 (c2=0)\r\n\u001b[?2004l\r"]
[308.825092, "o", "\u001b[?2004h> "]
[308.825235, "o", "    n = int(cost_entry[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.825325, "o", "    c2, c1, c0 = 0.0, 0.0, 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.825479, "o", ">     if n >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.825578, "o", "        c2 = cost_entry[4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.825609, "o", "> "]
[308.825703, "o", "        c1 = cost_entry[5]\r\n\u001b[?2004l\r[\u001b[?2004h> "]
[308.825809, "o", "        c0 = cost_entry[6]\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[308.825931, "o", "    elif n == 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.82596, "o", "> "]
[308.826137, "o", "        c1 = cost_entry[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.826258, "o", "        c0 = cost_entry[5]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.8263, "o", "\u001b[?2004h> "]
[308.826369, "o", "    gen_data.append({\r\n\u001b[?2004l\r"]
[308.826398, "o", "\u001b[?2004h> "]
[308.826473, "o", "        'id': i,\r\n\u001b[?2004l\r"]
[308.826551, "o", "\u001b[?2004h> "]
[308.826646, "o", "        'pmin': g[9],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.826682, "o", "        'pmax': g[8],\r\n\u001b[?2004l\r"]
[308.826737, "o", "\u001b[?2004h> "]
[308.826768, "o", "        'c2': c2,\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[308.826832, "o", "        'c1': c1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.826871, "o", "> "]
[308.826919, "o", "        'c0': c0,\r\n\u001b[?2004l\r"]
[308.826966, "o", "\u001b[?2004h> "]
[308.827016, "o", "        'gen_idx': i\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.827042, "o", ">     })\r\n\u001b[?2004l\r"]
[308.827069, "o", "\u001b[?2004h> "]
[308.827098, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.827667, "o", "# Simple Lambda Iteration for ED\r\n\u001b[?2004l\r\u001b[?2004h> # Minimize sum(c2*P^2 + c1*P + c0) s.t. sum(P) = total_gen_req\r\n\u001b[?2004l\r\u001b[?2004h> # dC/dP = 2*c2*P + c1 = lambda\r\n\u001b[?2004l\r\u001b[?2004h> # P = (lambda - c1) / (2*c2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.831846, "o", "# If c2 is small/zero, this is linear, use sorting.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> # Check if any quadratic\r\n\u001b[?2004l\rte \u001b[?2004h> is_quadratic = any(g['c2'] > 1e-6 for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if is_quadratic:\r\n\u001b[?2004l\r\u001b[?2004h>     lam_min = min(g['c1'] for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h>     lam_max = max(2*g['c2']*g['pmax'] + g['c1'] for g in gen_data)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(50):\r\n\u001b[?2004l\r\u001b[?2004h>         lam = (lam_min + lam_max) / 2\r\n\u001b[?2004l\r\u001b[?2004h>         p_sum = 0\r\n\u001b[?2004l\r\u001b[?2004h>         for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h>             if g['c2'] > 1e-6:\r\n\u001b[?2004l\r\u001b[?2004h>                 p = (lam - g['c1']) / (2*g['c2'])\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 p = g['pmax'] if lam > g['c1'] else g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h>             p = max(g['pmin'], min(g['pmax'], p))\r\n\u001b[?2004l\r\u001b[?2004h>             p_sum += p\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if abs(p_sum - total_gen_req) < 1e-2:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[308.831908, "o", "\u001b[?2004h> "]
[308.832049, "o", "        if p_sum > total_gen_req:\r\n\u001b[?2004l\r"]
[308.832077, "o", "\u001b[?2004h> "]
[308.832212, "o", "            lam_max = lam\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.832241, "o", "        else:\r\n\u001b[?2004l\r"]
[308.832269, "o", "\u001b[?2004h> "]
[308.832433, "o", "            lam_min = lam\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.832484, "o", "    # Assign P\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.832509, "o", "> "]
[308.832646, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.832674, "o", "        if g['c2'] > 1e-6:\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.832697, "o", "> "]
[308.832831, "o", "            p = (lam - g['c1']) / (2*g['c2'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.832861, "o", "        else:\r\n\u001b[?2004l\r"]
[308.832884, "o", "\u001b[?2004h"]
[308.832908, "o", "> "]
[308.833064, "o", "            p = g['pmax'] if lam > g['c1'] else g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.833181, "o", "        p = max(g['pmin'], min(g['pmax'], p))\r\n\u001b[?2004l\r"]
[308.833206, "o", "\u001b[?2004h> "]
[308.833312, "o", "        gens[g['gen_idx']][1] = p\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.833339, "o", "> else:\r\n\u001b[?2004l\r"]
[308.833362, "o", "\u001b[?2004h> "]
[308.833484, "o", "    # Linear ED: Sort by c1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.83357, "o", "    gen_data.sort(key=lambda x: x['c1'])\r\n\u001b[?2004l\r"]
[308.833596, "o", "\u001b[?2004h> "]
[308.833691, "o", "    rem_load = total_gen_req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.833762, "o", "    for g in gen_data:\r\n\u001b[?2004l\r"]
[308.833787, "o", "\u001b[?2004h> "]
[308.833889, "o", "        p_avail = g['pmax'] - g['pmin']\r\n\u001b[?2004l\r"]
[308.833915, "o", "\u001b[?2004h> "]
[308.834125, "o", "        take = min(p_avail, rem_load - g['pmin'] if rem_load > g['pmin'] else 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.834152, "o", "> "]
[308.83435, "o", "        # This logic is slightly buggy for base load, let's just fill up cheapest\r\n\u001b[?2004l\r"]
[308.834378, "o", "\u001b[?2004h> "]
[308.834493, "o", "        # Better: Set all to Pmin. Fill rest.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.834565, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.834588, "o", "\u001b[?2004h> "]
[308.834683, "o", "    # Reset to Pmin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.834704, "o", "    curr_gen = 0\r\n\u001b[?2004l\r"]
[308.834726, "o", "\u001b[?2004h> "]
[308.834845, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.834919, "o", "        gens[g['gen_idx']][1] = g['pmin']\r\n\u001b[?2004l\r"]
[308.834944, "o", "\u001b[?2004h> "]
[308.835041, "o", "        curr_gen += g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.835114, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.835181, "o", "    needed = total_gen_req - curr_gen\r\n\u001b[?2004l\r"]
[308.835205, "o", "\u001b[?2004h> "]
[308.835305, "o", "    for g in gen_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.835375, "o", "        if needed <= 0: break\r\n\u001b[?2004l\r"]
[308.8354, "o", "\u001b[?2004h> "]
[308.835565, "o", "        avail = g['pmax'] - g['pmin']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.835589, "o", "        take = min(avail, needed)\r\n\u001b[?2004l\r"]
[308.83561, "o", "\u001b[?2004h"]
[308.835633, "o", "> "]
[308.835822, "o", "        gens[g['gen_idx']][1] += take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.836763, "o", "        needed -= take\r\n\u001b[?2004l\r"]
[308.836845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.836869, "o", "# 2. Solve Power Flow\r\n\u001b[?2004l\r"]
[308.836888, "o", "\u001b[?2004h> "]
[308.837061, "o", "buses, gens = run_power_flow(buses, gens, branches, baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.837084, "o", "\u001b[?2004h> "]
[308.837178, "o", "# 3. Generate Report\r\n\u001b[?2004l\r\u001b[?2004h> report = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.837201, "o", "\u001b[?2004h> "]
[308.837295, "o", "# Calculate totals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.837376, "o", "total_load_mw = sum(b[2] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.837496, "o", "total_load_mvar = sum(b[3] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.837599, "o", "total_gen_mw = sum(g[1] for g in gens if g[7]>0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.837621, "o", "> "]
[308.837736, "o", "total_gen_mvar = sum(g[2] for g in gens if g[7]>0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.837757, "o", "> "]
[308.837854, "o", "total_losses = total_gen_mw - total_load_mw # Approx\r\n\u001b[?2004l\r"]
[308.837876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.837893, "o", "\u001b[?2004h"]
[308.837912, "o", "> # Cost\r\n\u001b[?2004l\r"]
[308.838035, "o", "\u001b[?2004h> total_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.83806, "o", "for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.83808, "o", "> "]
[308.838186, "o", "    if g[7] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h>     pg = g[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.838207, "o", "> "]
[308.8383, "o", "    # Re-parse cost to be sure\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.838362, "o", "    cost_entry = gencosts[i]\r\n\u001b[?2004l\r"]
[308.838384, "o", "\u001b[?2004h> "]
[308.838465, "o", "    n = int(cost_entry[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.838483, "o", "    cost = 0\r\n\u001b[?2004l\r"]
[308.838502, "o", "\u001b[?2004h> "]
[308.838606, "o", "    if n >= 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.838711, "o", "        cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]\r\n\u001b[?2004l\r"]
[308.838734, "o", "\u001b[?2004h> "]
[308.83875, "o", "    elif n == 2:\r\n\u001b[?2004l\r"]
[308.838856, "o", "\u001b[?2004h> "]
[308.83892, "o", "        cost = cost_entry[4]*pg + cost_entry[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.838989, "o", "    total_cost += cost\r\n\u001b[?2004l\r"]
[308.839049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.839067, "o", "\u001b[?2004h"]
[308.839094, "o", "> "]
[308.8392, "o", "report[\"summary\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.839259, "o", "    \"total_cost_per_hour\": total_cost,\r\n\u001b[?2004l\r"]
[308.839283, "o", "\u001b[?2004h> "]
[308.839368, "o", "    \"total_load_MW\": total_load_mw,\r\n\u001b[?2004l\r"]
[308.839391, "o", "\u001b[?2004h> "]
[308.839474, "o", "    \"total_load_MVAr\": total_load_mvar,\r\n\u001b[?2004l\r"]
[308.839496, "o", "\u001b[?2004h> "]
[308.839601, "o", "    \"total_generation_MW\": total_gen_mw,\r\n\u001b[?2004l\r"]
[308.839665, "o", "\u001b[?2004h> "]
[308.839763, "o", "    \"total_generation_MVAr\": total_gen_mvar,\r\n\u001b[?2004l\r"]
[308.839798, "o", "\u001b[?2004h> "]
[308.839903, "o", "    \"total_losses_MW\": total_losses,\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.839924, "o", "> "]
[308.840012, "o", "    \"solver_status\": \"optimal\"\r\n\u001b[?2004l\r"]
[308.840033, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[308.84005, "o", "\u001b[?2004h"]
[308.840072, "o", "> \r\n\u001b[?2004l\r"]
[308.840094, "o", "\u001b[?2004h> "]
[308.84024, "o", "report[\"generators\"] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84031, "o", "for i, g in enumerate(gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84039, "o", "    report[\"generators\"].append({\r\n\u001b[?2004l\r"]
[308.840411, "o", "\u001b[?2004h> "]
[308.8405, "o", "        \"id\": i+1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.840561, "o", "        \"bus\": int(g[0]),\r\n\u001b[?2004l\r"]
[308.840582, "o", "\u001b[?2004h> "]
[308.840669, "o", "        \"pg_MW\": g[1],\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.840692, "o", "> "]
[308.840775, "o", "        \"qg_MVAr\": g[2],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.840834, "o", "        \"pmin_MW\": g[9],\r\n\u001b[?2004l\r"]
[308.840856, "o", "\u001b[?2004h> "]
[308.840938, "o", "        \"pmax_MW\": g[8],\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.840959, "o", "> "]
[308.841041, "o", "        \"qmin_MVAr\": g[4],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.841112, "o", "        \"qmax_MVAr\": g[3]\r\n\u001b[?2004l\r"]
[308.841132, "o", "\u001b[?2004h> "]
[308.84115, "o", "    })\r\n\u001b[?2004l\r"]
[308.841169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.841301, "o", "\u001b[?2004h> report[\"buses\"] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84139, "o", "for i, b in enumerate(buses):\r\n\u001b[?2004l\r"]
[308.841413, "o", "\u001b[?2004h> "]
[308.841497, "o", "    report[\"buses\"].append({\r\n\u001b[?2004l\r"]
[308.841518, "o", "\u001b[?2004h> "]
[308.8416, "o", "        \"id\": int(b[0]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.841621, "o", "> "]
[308.841704, "o", "        \"vm_pu\": b[7],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.841764, "o", "        \"va_deg\": b[8],\r\n\u001b[?2004l\r"]
[308.841785, "o", "\u001b[?2004h> "]
[308.841868, "o", "        \"vmin_pu\": b[12],\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.841889, "o", "> "]
[308.841971, "o", "        \"vmax_pu\": b[11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.841992, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.842008, "o", "> \r\n\u001b[?2004l\r"]
[308.842028, "o", "\u001b[?2004h> "]
[308.842155, "o", "# Calculate Branch Flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.842224, "o", "report[\"most_loaded_branches\"] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.842308, "o", "bus_map = {b[0]: i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r"]
[308.842329, "o", "\u001b[?2004h> "]
[308.842416, "o", "for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.842483, "o", "    f, t = br[0], br[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.842573, "o", "    if f not in bus_map or t not in bus_map: continue\r\n\u001b[?2004l\r"]
[308.842597, "o", "\u001b[?2004h> "]
[308.842686, "o", "    i, j = bus_map[f], bus_map[t]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.842705, "o", "    \r\n\u001b[?2004l\r"]
[308.842723, "o", "\u001b[?2004h> "]
[308.84283, "o", "    if br[10] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.842852, "o", "\u001b[?2004h> "]
[308.842867, "o", "    # Params\r\n\u001b[?2004l\r"]
[308.842971, "o", "\u001b[?2004h>     r, x, b_chg = br[2], br[3], br[4]\r\n\u001b[?2004l\r"]
[308.842993, "o", "\u001b[?2004h> "]
[308.843078, "o", "    tap, shift = br[8], br[9]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.843146, "o", "    if tap == 0: tap = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.843277, "o", "    tr = tap * cmath.exp(1j * math.radians(shift))\r\n\u001b[?2004l\r\u001b[?2004h"]
[308.843304, "o", "> "]
[308.843397, "o", "    z = complex(r, x)\r\n\u001b[?2004l\r\u001b[?2004h>     y = 1.0 / z\r\n\u001b[?2004l\r"]
[308.84342, "o", "\u001b[?2004h> "]
[308.843502, "o", "    bc = complex(0, b_chg / 2.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.843526, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.843547, "o", "> "]
[308.843662, "o", "    Vi = cmath.rect(buses[i][7], math.radians(buses[i][8]))\r\n\u001b[?2004l\r"]
[308.843684, "o", "\u001b[?2004h> "]
[308.843845, "o", "    Vj = cmath.rect(buses[j][7], math.radians(buses[j][8]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.843881, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.843906, "o", "> "]
[308.844069, "o", "    Yff = (y + bc) / (abs(tr)**2)\r\n\u001b[?2004l\r\u001b[?2004h>     Yft = -y / tr.conjugate()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84414, "o", "    S_f = Vi * (Yff*Vi + Yft*Vj).conjugate()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844211, "o", "    S_f_mva = abs(S_f) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[308.844232, "o", "\u001b[?2004h> "]
[308.844347, "o", "    limit = br[5] # Rate A\r\n\u001b[?2004l\r\u001b[?2004h>     loading = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844474, "o", "    if limit > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84457, "o", "        loading = (S_f_mva / limit) * 100\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     if loading > 90:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844647, "o", "        report[\"most_loaded_branches\"].append({\r\n\u001b[?2004l\r"]
[308.844741, "o", "\u001b[?2004h>             \"from_bus\": int(f),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844774, "o", "            \"to_bus\": int(t),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844893, "o", "            \"loading_pct\": loading,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.844928, "o", "            \"flow_from_MVA\": S_f_mva,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84505, "o", "            \"flow_to_MVA\": 0.0, # Placeholder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.84508, "o", "            \"limit_MVA\": limit\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[308.845108, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[308.845139, "o", "> "]
