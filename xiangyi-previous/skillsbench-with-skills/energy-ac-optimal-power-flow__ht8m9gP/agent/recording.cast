[593.631527, "o", "\u001b[?2004h> "]
[593.63171, "o", "                J.data[row_map][col_map] = val\r\n\u001b[?2004l\r"]
[593.631801, "o", "\u001b[?2004h> "]
[593.631866, "o", "                col_map += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.632002, "o", "            for j in pq_idx:\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[593.632143, "o", "                val = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.632339, "o", "                G = Y[i][j].real\r\n\u001b[?2004l\r\u001b[?2004h"]
[593.632372, "o", "> "]
[593.635942, "o", "                B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
