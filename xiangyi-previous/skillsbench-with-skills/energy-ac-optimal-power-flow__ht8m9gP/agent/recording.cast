[593.641963, "o", "                val = 0.0\r\n"]
[593.641997, "o", "\u001b[?2004l\r\u001b[?2004h"]
[593.642045, "o", "> "]
[593.642201, "o", "                G = Y[i][j].real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[593.642342, "o", "                B = Y[i][j].imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
