[308.845357, "o", "> "]
[308.845473, "o", "    \"max_voltage_violation_pu\": 0.0,\r\n\u001b[?2004l\r\u001b[?2004h>     \"max_branch_overload_MVA\": 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[308.845504, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[308.84553, "o", "\u001b[?2004h> "]
[308.845678, "o", "with open(\"report.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
