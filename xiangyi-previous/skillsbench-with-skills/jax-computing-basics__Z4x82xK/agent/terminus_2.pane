[?2004hroot@404d1f3e81f1:/app# cat <<EOF > solve_tasks.py
[?2004l[?2004h> import jax
[?2004l[?2004h> import jax.numpy as jnp
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # 1. basic_reduce
[?2004l[?2004h> x = jnp.load('data/x.npy')
[?2004l[?2004h> res1 = jnp.mean(x, axis=1)
[?2004l[?2004h> np.save('basic_reduce.npy', np.array(res1))
[?2004l[?2004h> 
[?2004l[?2004h> # 2. map_square
[?2004l[?2004h> # Apply square function to each element using vectorization.
[?2004l[?2004h> def square(x):
[?2004l[?2004h>     return x ** 2
[?2004l[?2004h> res2 = jax.vmap(jax.vmap(square))(x)
[?2004l[?2004h> # Alternatively, just x**2 but the task says 'using vectorization', 
[?2004l[?2004h> # usually meaning vmap in JAX context, though JAX arrays are already vectorized.
[?2004l[?2004h> # Let's use simple x**2 as it's the standard way in JAX/numpy too.
[?2004l[?2004h> # However, to be safe with the 'description', I'll show use of vmap if it's element-wise.
[?2004l[?2004h> # Actually, jnp.square(x) is also fine. Let's use vmap to be explicit.
[?2004l[?2004h> # For a 2D array, we need to vmap twice or vmap over the flattened array.
[?2004l[?2004h> # Actually vmap(square) on a 1D array works, so vmap(vmap(square)) for 2D.
[?2004l[?2004h> # But jnp.square(x) is easier. Let's stick with what's expected in JAX.
[?2004l[?2004h> res2 = jax.vmap(lambda row: jax.vmap(lambda el: el**2)(row))(x)
[?2004l[?2004h> np.save('map_square.npy', np.array(res2))
[?2004l[?2004h> 
[?2004l[?2004h> # 3. grad_logistic
[?2004l[?2004h> # Compute gradient of logistic loss.
[?2004l[?2004h> # Loss = -sum(y * log(sigmoid(x @ w)) + (1 - y) * log(1 - sigmoid(x @ w)))
[?2004l[?2004h> # or simply use the formula for logistic loss gradient.
[?2004l[?2004h> def logistic_loss(w, x, y):
[?2004l[?2004h>     logits = jnp.dot(x, w)
[?2004l[?2004h>     # Binary cross entropy loss
[?2004l[?2004h>     # Using jax.nn.sigmoid_binary_cross_entropy or similar is better for stability
[?2004l[?2004h>     # But let's write it out or use a stable version.
[?2004l[?2004h>     # loss = -jnp.mean(y * jax.nn.log_sigmoid(logits) + (1 - y) * jnp.log(1 - jax.nn.sigmoid(logits)))
[?2004l[?2004h>     # More stable: 
[?2004l[?2004h>     max_val = jnp.maximum(0, logits)
[?2004l[?2004h>     loss = jnp.mean(max_val - logits * y + jnp.log(1 + jnp.exp(-jnp.abs(logits))))
[?2004l[?2004h>     return loss
[?2004l[?2004h> 
[?2004l[?2004h> data_log = np.load('data/logistic.npz')
[?2004l[?2004h> x_log, y_log, w_log = data_log['x'], data_log['y'], data_log['w']
[?2004l[?2004h> grad_fn = jax.grad(logistic_loss)
[?2004l[?2004h> res3 = grad_fn(w_log, x_log, y_log)
[?2004l[?2004h> np.save('grad_logistic.npy', np.array(res3))
[?2004l[?2004h> 
[?2004l[?2004h> # 4. scan_rnn
[?2004l[?2004h> # Implement RNN forward pass using scan.
[?2004l[?2004h> # h_t = tanh(h_{t-1} W_h + x_t W_x + b)
[?2004l[?2004h> data_seq = np.load('data/seq.npz')
[?2004l[?2004h> seq, h_init, Wx, Wh, b = data_seq['seq'], data_seq['init'], data_seq['Wx'], data_seq['Wh'], data_seq['b']
[?2004l[?2004h> 
[?2004l[?2004h> def rnn_step(h, x):
[?2004l[?2004h>     h_next = jnp.tanh(jnp.dot(h, Wh) + jnp.dot(x, Wx) + b)
[?2004l[?2004h>     return h_next, h_next
[?2004l[?2004h> 
[?2004l[?2004h> _, h_seq = jax.lax.scan(rnn_step, h_init, seq)
[?2004l[?2004h> np.save('scan_rnn.npy', np.array(h_seq))
[?2004l[?2004h> 
[?2004l[?2004h> # 5. jit_mlp
[?2004l[?2004h> # Implement and JIT compile a 2-layer MLP.
[?2004l[?2004h> data_mlp = np.load('data/mlp.npz')
[?2004l[?2004h> X_mlp, W1, b1, W2, b2 = data_mlp['X'], data_mlp['W1'], data_mlp['b1'], data_mlp['W2'], data_mlp['b2']
[?2004l[?2004h> 
[?2004l[?2004h> @jax.jit
[?2004l[?2004h> def mlp(X, W1, b1, W2, b2):
[?2004l[?2004h>     layer1 = jax.nn.relu(jnp.dot(X, W1) + b1)
[?2004l[?2004h>     layer2 = jnp.dot(layer1, W2) + b2
[?2004l[?2004h>     return layer2
[?2004l[?2004h> 
[?2004l[?2004h> res5 = mlp(X_mlp, W1, b1, W2, b2)
[?2004l[?2004h> np.save('jit_mlp.npy', np.array(res5))
[?2004l[?2004h> EOF
