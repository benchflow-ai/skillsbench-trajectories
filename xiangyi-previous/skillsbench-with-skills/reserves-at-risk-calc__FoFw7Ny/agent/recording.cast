[441.9288, "i", "python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\nprint(\"Completing Step 2 and Step 3...\\n\")\n\nwb = load_workbook('/tmp/step1_complete.xlsx')\nws_value = wb['Value']\nws_volume = wb['Volume']\nws_total = wb['Total Reserves']\nws_answer = wb['Answer']\n\navg_gold_price_2025 = 1922.20\nz_score_95 = 1.645\nlatest_3m_vol = 58.4253\n\n# Combine all countries with gold reserves\nall_gold_reserves = {\n    'Belarus': 7471.00,\n    'Georgia': 1002.00,\n    'Moldova': 10.71,\n    'Ukraine': 3877.64,\n    'Uzbekistan': 55092.42,\n    'Czechia': 10121.89,  # Simplified name\n    'Latvia': 921.28,\n    'Lithuania': 807.10,\n    'Slovakia': 1958.72  # From Volume conversion\n}\n\nprint(\"=== STEP 2: All Countries with Gold Reserves ===\")\nfor country, reserves in all_gold_reserves.items():\n    print(f\"{country}: ${reserves:.2f} million\")\n\n# Calculate gold valuation exposure for each country\n# Formula: Gold reserves * z_score * volatility / 100\ngold_exposures = {}\nfor country, reserves in all_gold_reserves.items():\n    exposure = reserves * z_score_95 * latest_3m_vol / 100\n    gold_exposures[country] = exposure\n\nprint(\"\\n=== Gold Valuation Exposure (95% one-sided shock) ===\")\nfor country, exposure in gold_exposures.items():\n    print(f\"{country}: ${exposure:.2f} million\")\n\n# Fill Step 2 in Answer sheet (rows 11-13, starting from column C)\ncol_idx = 3  # Start from column C\nfor country in sorted(all_gold_reserves.keys()):\n    ws_answer.cell(row=11, column=col_idx, value=country)\n    ws_answer.cell(row=12, column=col_idx, value=all_gold_reserves[country])\n    ws_answer.cell(row=13, column=col_idx, value=gold_exposures[country])\n    col_idx += 1\n\nprint(\"\\nStep 2 completed and filled in Answer sheet!\")\n\nwb.save('/tmp/step2_complete.xlsx')\nprint(\"Saved Step 2\\n\")\n\nPYEOF\n"]
