[462.358959, "i", "python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\nprint(\"=== STEP 3: Total Reserves and RaR Calculation ===\\n\")\n\nwb = load_workbook('/tmp/step2_complete.xlsx')\nws_total = wb['Total Reserves']\nws_answer = wb['Answer']\n\n# Countries from Step 2\nall_gold_reserves = {\n    'Belarus': 7471.00,\n    'Georgia': 1002.00,\n    'Moldova': 10.71,\n    'Ukraine': 3877.64,\n    'Uzbekistan': 55092.42,\n    'Czechia': 10121.89,\n    'Latvia': 921.28,\n    'Lithuania': 807.10,\n    'Slovakia': 1958.72\n}\n\ngold_exposures = {\n    'Belarus': 7180.35,\n    'Georgia': 963.02,\n    'Moldova': 10.29,\n    'Ukraine': 3726.79,\n    'Uzbekistan': 52949.11,\n    'Czechia': 9728.11,\n    'Latvia': 885.44,\n    'Lithuania': 775.70,\n    'Slovakia': 1882.52\n}\n\n# Extract Total Reserves country names\ntotal_countries = {}\nfor col_idx in range(2, ws_total.max_column + 1):\n    desc = ws_total.cell(row=1, column=col_idx).value\n    if desc:\n        country = desc.split(':')[0].strip()\n        total_countries[col_idx] = country\n\nprint(f\"Found {len(total_countries)} countries in Total Reserves sheet\")\n\n# Find 2025 data row in Total Reserves\ntotal_2025_row = None\nfor row_idx in range(10, ws_total.max_row + 1):\n    year_cell = ws_total.cell(row=row_idx, column=1).value\n    if year_cell and '2025' in str(year_cell):\n        total_2025_row = row_idx\n        print(f\"Found 2025 data in Total Reserves at row {row_idx}\")\n        break\n\n# Extract 2025 Total Reserves data\ncountries_total_reserves = {}\nif total_2025_row:\n    for col_idx, country in total_countries.items():\n        value = ws_total.cell(row=total_2025_row, column=col_idx).value\n        if value is not None and value != 0:\n            countries_total_reserves[country] = float(value)\n            print(f\"  {country}: ${value:.2f} million\")\n\nprint(f\"\\nCountries with 2025 Total Reserves: {len(countries_total_reserves)}\")\n\n# Match countries from Step 2 with Total Reserves\nmatched_countries = {}\nfor country in all_gold_reserves.keys():\n    # Try to find matching country in Total Reserves\n    for tr_country in countries_total_reserves.keys():\n        # Flexible matching\n        if (country.lower() in tr_country.lower() or \n            tr_country.lower() in country.lower() or\n            country.lower().replace('czechia', 'czech') in tr_country.lower()):\n            matched_countries[country] = countries_total_reserves[tr_country]\n            print(f\"\\nMatched: {country} -> {tr_country}\")\n            print(f\"  Total Reserves: ${countries_total_reserves[tr_country]:.2f} million\")\n            break\n\nprint(f\"\\nTotal matched countries: {len(matched_countries)}\")\n\nPYEOF\n"]
[462.359293, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[462.359354, "o", "\u001b[?2004h> "]
[462.35946, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
