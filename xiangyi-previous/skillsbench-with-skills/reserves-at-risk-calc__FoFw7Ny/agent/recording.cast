[423.559116, "i", "python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\nprint(\"=== STEP 2: Gold Reserves and Exposure ===\")\n\nwb = load_workbook('/tmp/step1_complete.xlsx')\nws_value = wb['Value']\nws_volume = wb['Volume']\nws_answer = wb['Answer']\n\navg_gold_price_2025 = 1922.20  # From Step 1\nz_score_95 = 1.645\nlatest_3m_vol = 58.4253\n\n# Extract countries with 2025 Value data\nvalue_countries = {}\nvalue_2025_row = None\n\nfor row_idx in range(10, ws_value.max_row + 1):\n    year_cell = ws_value.cell(row=row_idx, column=1).value\n    if year_cell and '2025' in str(year_cell):\n        value_2025_row = row_idx\n        break\n\nif value_2025_row:\n    for col_idx in range(2, ws_value.max_column + 1):\n        desc = ws_value.cell(row=1, column=col_idx).value\n        if desc:\n            country = desc.split(':')[0].strip()\n            value = ws_value.cell(row=value_2025_row, column=col_idx).value\n            if value is not None and value != 0:\n                value_countries[country] = float(value)\n\nprint(f\"Countries with 2025 Value data: {len(value_countries)}\")\nfor country, val in value_countries.items():\n    print(f\"  {country}: ${val:.2f} million\")\n\n# Extract countries with 2025 Volume data\nvolume_countries = {}\nvolume_2025_row = None\n\nfor row_idx in range(10, ws_volume.max_row + 1):\n    year_cell = ws_volume.cell(row=row_idx, column=1).value\n    if year_cell and '2025' in str(year_cell):\n        volume_2025_row = row_idx\n        break\n\nif volume_2025_row:\n    for col_idx in range(2, ws_volume.max_column + 1):\n        desc = ws_volume.cell(row=1, column=col_idx).value\n        if desc:\n            country = desc.split(':')[0].strip()\n            volume = ws_volume.cell(row=volume_2025_row, column=col_idx).value\n            if volume is not None and volume != 0:\n                volume_countries[country] = float(volume)\n\nprint(f\"\\nCountries with 2025 Volume data: {len(volume_countries)}\")\nfor country, vol in volume_countries.items():\n    print(f\"  {country}: {vol} troy oz\")\n\n# Find countries in Volume but not in Value\nadditional_countries = {}\nfor country, volume in volume_countries.items():\n    # Normalize country names for comparison\n    country_normalized = country.replace('Intl Reserves', 'International Reserves').strip()\n    \n    # Check if this country is NOT in value_countries\n    found = False\n    for val_country in value_countries.keys():\n        val_normalized = val_country.replace('Intl Reserves', 'International Reserves').strip()\n        if country_normalized.lower() in val_normalized.lower() or val_normalized.lower() in country_normalized.lower():\n            found = True\n            break\n    \n    if not found:\n        # Convert volume to value (assuming volume is in millions of troy ounces)\n        # Gold price is per troy ounce, so value = volume * price\n        value_millions = volume * avg_gold_price_2025\n        additional_countries[country] = value_millions\n        print(f\"\\nAdditional country from Volume: {country}\")\n        print(f\"  Volume: {volume} million troy oz\")\n        print(f\"  Converted value: ${value_millions:.2f} million\")\n\nPYEOF\n"]
