[423.563973, "o", "volume_2025_row = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[423.564029, "o", "\u001b[?2004h> "]
[423.564157, "o", "for row_idx in range(10, ws_volume.max_row + 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.564218, "o", "> "]
[423.564321, "o", "    year_cell = ws_volume.cell(row=row_idx, column=1).value\r\n\u001b[?2004l\r"]
[423.564379, "o", "\u001b[?2004h> "]
[423.564502, "o", "    if year_cell and '2025' in str(year_cell):\r\n\u001b[?2004l\r"]
[423.564554, "o", "\u001b[?2004h> "]
[423.564641, "o", "        volume_2025_row = row_idx\r\n\u001b[?2004l\r"]
[423.564693, "o", "\u001b[?2004h> "]
[423.56475, "o", "        break\r\n\u001b[?2004l\r"]
[423.564803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.564886, "o", "if volume_2025_row:\r\n\u001b[?2004l\r"]
[423.56494, "o", "\u001b[?2004h> "]
[423.56511, "o", "    for col_idx in range(2, ws_volume.max_column + 1):\r\n\u001b[?2004l\r"]
[423.565172, "o", "\u001b[?2004h> "]
[423.565324, "o", "        desc = ws_volume.cell(row=1, column=col_idx).value\r\n\u001b[?2004l\r"]
[423.565388, "o", "\u001b[?2004h>         if desc:\r\n\u001b[?2004l\r"]
[423.565465, "o", "\u001b[?2004h"]
[423.56553, "o", "> "]
[423.565578, "o", "            country = desc.split(':')[0].strip()\r\n\u001b[?2004l\r"]
[423.565625, "o", "\u001b[?2004h> "]
[423.565802, "o", "            volume = ws_volume.cell(row=volume_2025_row, column=col_idx).value\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.565874, "o", "> "]
[423.565944, "o", "            if volume is not None and volume != 0:\r\n\u001b[?2004l\r"]
[423.565997, "o", "\u001b[?2004h> "]
[423.56615, "o", "                volume_countries[country] = float(volume)\r\n\u001b[?2004l\r"]
[423.566225, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[423.566269, "o", "\u001b[?2004h> "]
[423.566418, "o", "print(f\"\\nCountries with 2025 Volume data: {len(volume_countries)}\")\r\n\u001b[?2004l\r"]
[423.566444, "o", "\u001b[?2004h> "]
[423.566757, "o", "for country, vol in volume_countries.items():\r\n\u001b[?2004l\r"]
[423.566818, "o", "\u001b[?2004h>     print(f\"  {country}: {vol} troy oz\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.566935, "o", "# Find countries in Volume but not in Value\r\n\u001b[?2004l\r"]
[423.566995, "o", "\u001b[?2004h> "]
[423.56705, "o", "additional_countries = {}\r\n\u001b[?2004l\r"]
[423.567106, "o", "\u001b[?2004h> "]
[423.567202, "o", "for country, volume in volume_countries.items():\r\n\u001b[?2004l\r"]
[423.567252, "o", "\u001b[?2004h> "]
[423.567351, "o", "    # Normalize country names for comparison\r\n\u001b[?2004l\r"]
[423.567402, "o", "\u001b[?2004h> "]
[423.567616, "o", "    country_normalized = country.replace('Intl Reserves', 'International Reserves').strip()\r\n\u001b[?2004l\r"]
[423.567643, "o", "\u001b[?2004h> "]
[423.567714, "o", "    \r\n"]
[423.56774, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[423.567855, "o", "    # Check if this country is NOT in value_countries\r\n\u001b[?2004l\r"]
[423.567933, "o", "\u001b[?2004h> "]
[423.567985, "o", "    found = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.56804, "o", "> "]
[423.568091, "o", "    for val_country in value_countries.keys():\r\n\u001b[?2004l\r"]
[423.568147, "o", "\u001b[?2004h> "]
[423.568361, "o", "        val_normalized = val_country.replace('Intl Reserves', 'International Reserves').strip()\r\n\u001b[?2004l\r"]
[423.568419, "o", "\u001b[?2004h> "]
[423.568745, "o", "        if country_normalized.lower() in val_normalized.lower() or val_normalized.lower() in country_normalized.lower():\r\n\u001b[?2004l\r"]
[423.568824, "o", "\u001b[?2004h> "]
[423.568925, "o", "            found = True\r\n\u001b[?2004l\r"]
[423.56899, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.569045, "o", ">     \r\n\u001b[?2004l\r"]
[423.569133, "o", "\u001b[?2004h> "]
[423.569191, "o", "    if not found:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.569349, "o", "        # Convert volume to value (assuming volume is in millions of troy ounces)\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.569412, "o", "> "]
[423.569551, "o", "        # Gold price is per troy ounce, so value = volume * price\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.569608, "o", "> "]
[423.569697, "o", "        value_millions = volume * avg_gold_price_2025\r\n\u001b[?2004l\r"]
[423.569751, "o", "\u001b[?2004h"]
[423.569805, "o", "> "]
[423.569894, "o", "        additional_countries[country] = value_millions\r\n\u001b[?2004l\r"]
[423.569941, "o", "\u001b[?2004h> "]
[423.57011, "o", "        print(f\"\\nAdditional country from Volume: {country}\")\r\n\u001b[?2004l\r"]
[423.570143, "o", "\u001b[?2004h> "]
[423.570311, "o", "        print(f\"  Volume: {volume} million troy oz\")\r\n\u001b[?2004l\r"]
[423.570362, "o", "\u001b[?2004h> "]
[423.570515, "o", "        print(f\"  Converted value: ${value_millions:.2f} million\")\r\n\u001b[?2004l\r"]
[423.57057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[423.570622, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[424.149081, "o", "=== STEP 2: Gold Reserves and Exposure ===\r\n"]
[424.382055, "o", "Countries with 2025 Value data: 8\r\n  Belarus: $7471.00 million\r\n  Georgia: $1002.00 million\r\n  Moldova: $10.71 million\r\n  Ukraine: $3877.64 million\r\n  Uzbekistan: $55092.42 million\r\n  Czechia International Reserves: $10121.89 million\r\n  Latvia: $921.28 million\r\n  Lithuania: $807.10 million\r\n"]
[424.382108, "o", "\r\nCountries with 2025 Volume data: 4\r\n  Uzbekistan: 12.55 troy oz\r\n  Czechia Intl Reserves: 2.3 troy oz\r\n  Slovakia: 1.019 troy oz\r\n  Latvia: 0.21 troy oz\r\n\r\nAdditional country from Volume: Slovakia\r\n  Volume: 1.019 million troy oz\r\n  Converted value: $1958.72 million\r\n"]
