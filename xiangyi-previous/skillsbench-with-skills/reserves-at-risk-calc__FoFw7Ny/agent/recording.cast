[462.361898, "o", "> "]
[462.361966, "o", "    'Ukraine': 3726.79,\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.362017, "o", ">     'Uzbekistan': 52949.11,\r\n\u001b[?2004l\r"]
[462.362066, "o", "\u001b[?2004h> "]
[462.362101, "o", "    'Czechia': 9728.11,\r\n\u001b[?2004l\r"]
[462.362134, "o", "\u001b[?2004h> "]
[462.362187, "o", "    'Latvia': 885.44,\r\n\u001b[?2004l\r"]
[462.362278, "o", "\u001b[?2004h> "]
[462.362309, "o", "    'Lithuania': 775.70,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.36241, "o", "    'Slovakia': 1882.52\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[462.362469, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.362568, "o", "# Extract Total Reserves country names\r\n\u001b[?2004l\r"]
[462.362624, "o", "\u001b[?2004h> "]
[462.362686, "o", "total_countries = {}\r\n\u001b[?2004l\r"]
[462.36272, "o", "\u001b[?2004h> "]
[462.362813, "o", "for col_idx in range(2, ws_total.max_column + 1):\r\n\u001b[?2004l\r"]
[462.36287, "o", "\u001b[?2004h> "]
[462.362976, "o", "    desc = ws_total.cell(row=1, column=col_idx).value\r\n\u001b[?2004l\r"]
[462.363022, "o", "\u001b[?2004h> "]
[462.363053, "o", "    if desc:\r\n\u001b[?2004l\r"]
[462.363081, "o", "\u001b[?2004h> "]
[462.363211, "o", "        country = desc.split(':')[0].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.363328, "o", "        total_countries[col_idx] = country\r\n\u001b[?2004l\r"]
[462.363355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.363404, "o", "\u001b[?2004h> "]
[462.363576, "o", "print(f\"Found {len(total_countries)} countries in Total Reserves sheet\")\r\n\u001b[?2004l\r"]
[462.363632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.363682, "o", "\u001b[?2004h> "]
[462.363741, "o", "# Find 2025 data row in Total Reserves\r\n\u001b[?2004l\r"]
[462.363787, "o", "\u001b[?2004h> "]
[462.363816, "o", "total_2025_row = None\r\n\u001b[?2004l\r"]
[462.363897, "o", "\u001b[?2004h> "]
[462.36396, "o", "for row_idx in range(10, ws_total.max_row + 1):\r\n\u001b[?2004l\r"]
[462.363986, "o", "\u001b[?2004h> "]
[462.364139, "o", "    year_cell = ws_total.cell(row=row_idx, column=1).value\r\n\u001b[?2004l\r"]
[462.364186, "o", "\u001b[?2004h> "]
[462.364285, "o", "    if year_cell and '2025' in str(year_cell):\r\n\u001b[?2004l\r"]
[462.364313, "o", "\u001b[?2004h> "]
[462.364393, "o", "        total_2025_row = row_idx\r\n\u001b[?2004l\r"]
[462.364423, "o", "\u001b[?2004h> "]
[462.364606, "o", "        print(f\"Found 2025 data in Total Reserves at row {row_idx}\")\r\n\u001b[?2004l\r"]
[462.364651, "o", "\u001b[?2004h> "]
[462.364679, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.364704, "o", "> \r\n\u001b[?2004l\r"]
[462.364783, "o", "\u001b[?2004h> "]
[462.364838, "o", "# Extract 2025 Total Reserves data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.36493, "o", "countries_total_reserves = {}\r\n\u001b[?2004l\r"]
[462.364955, "o", "\u001b[?2004h> "]
[462.365011, "o", "if total_2025_row:\r\n\u001b[?2004l\r"]
[462.365042, "o", "\u001b[?2004h> "]
[462.365195, "o", "    for col_idx, country in total_countries.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.365222, "o", "> "]
[462.365396, "o", "        value = ws_total.cell(row=total_2025_row, column=col_idx).value\r\n\u001b[?2004l\r"]
[462.365424, "o", "\u001b[?2004h> "]
[462.365538, "o", "        if value is not None and value != 0:\r\n\u001b[?2004l\r"]
[462.365566, "o", "\u001b[?2004h> "]
[462.365723, "o", "            countries_total_reserves[country] = float(value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.365749, "o", "> "]
[462.365894, "o", "            print(f\"  {country}: ${value:.2f} million\")\r\n\u001b[?2004l\r"]
[462.365921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.365972, "o", "\u001b[?2004h> "]
[462.366149, "o", "print(f\"\\nCountries with 2025 Total Reserves: {len(countries_total_reserves)}\")\r\n\u001b[?2004l\r"]
[462.366174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.366226, "o", "\u001b[?2004h> "]
[462.366328, "o", "# Match countries from Step 2 with Total Reserves\r\n\u001b[?2004l\r"]
[462.366353, "o", "\u001b[?2004h> "]
[462.366438, "o", "matched_countries = {}\r\n\u001b[?2004l\r"]
[462.366494, "o", "\u001b[?2004h> "]
[462.366543, "o", "for country in all_gold_reserves.keys():\r\n\u001b[?2004l\r"]
[462.366569, "o", "\u001b[?2004h> "]
[462.366704, "o", "    # Try to find matching country in Total Reserves\r\n\u001b[?2004l\r"]
[462.366757, "o", "\u001b[?2004h> "]
[462.366882, "o", "    for tr_country in countries_total_reserves.keys():\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.366908, "o", "> "]
[462.366973, "o", "        # Flexible matching\r\n\u001b[?2004l\r"]
[462.366999, "o", "\u001b[?2004h> "]
[462.367142, "o", "        if (country.lower() in tr_country.lower() or \r\n\u001b[?2004l\r\u001b[?2004h"]
[462.367168, "o", "> "]
[462.367303, "o", "            tr_country.lower() in country.lower() or\r\n\u001b[?2004l\r"]
[462.367329, "o", "\u001b[?2004h> "]
[462.367552, "o", "            country.lower().replace('czechia', 'czech') in tr_country.lower()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.367753, "o", "            matched_countries[country] = countries_total_reserves[tr_country]\r\n\u001b[?2004l\r"]
[462.367809, "o", "\u001b[?2004h> "]
[462.367928, "o", "            print(f\"\\nMatched: {country} -> {tr_country}\")\r\n\u001b[?2004l\r"]
[462.367975, "o", "\u001b[?2004h> "]
[462.368188, "o", "            print(f\"  Total Reserves: ${countries_total_reserves[tr_country]:.2f} million\")\r\n\u001b[?2004l\r"]
[462.368233, "o", "\u001b[?2004h> "]
[462.368284, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[462.368334, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[462.368386, "o", "> "]
[462.368492, "o", "print(f\"\\nTotal matched countries: {len(matched_countries)}\")\r\n\u001b[?2004l\r"]
[462.368538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[462.368569, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[463.070732, "o", "=== STEP 3: Total Reserves and RaR Calculation ===\r\n\r\n"]
[463.300102, "o", "Found 14 countries in Total Reserves sheet\r\nFound 2025 data in Total Reserves at row 18\r\n  Armenia: $5086.30 million\r\n  Belarus: $14425.90 million\r\n  Georgia: $6158.70 million\r\n  Kazakhstan: $65727.00 million\r\n  Moldova: $5999.34 million\r\n  Uzbekistan: $66311.75 million\r\n  Czechia International Reserves (EOP, NSA, Mil.US$): $175830.49 million\r\n  Latvia: $6076.90 million\r\n  Lithuania: $7082.70 million\r\n\r\nCountries with 2025 Total Reserves: 9\r\n"]
[463.300271, "o", "\r\nMatched: Belarus -> Belarus\r\n  Total Reserves: $14425.90 million\r\n\r\nMatched: Georgia -> Georgia\r\n  Total Reserves: $6158.70 million\r\n\r\nMatched: Moldova -> Moldova\r\n  Total Reserves: $5999.34 million\r\n\r\nMatched: Uzbekistan -> Uzbekistan\r\n  Total Reserves: $66311.75 million\r\n\r\nMatched: Czechia -> Czechia International Reserves (EOP, NSA, Mil.US$)\r\n  Total Reserves: $175830.49 million\r\n\r\nMatched: Latvia -> Latvia\r\n  Total Reserves: $6076.90 million\r\n\r\nMatched: Lithuania -> Lithuania\r\n"]
[463.300356, "o", "  Total Reserves: $7082.70 million\r\n\r\nTotal matched countries: 7\r\n"]
[463.386057, "o", "\u001b[?2004hroot@9269fdf9fecf:~# "]
[483.679532, "i", "python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\nprint(\"Finalizing Step 3 and saving result...\\n\")\n\nwb = load_workbook('/tmp/step2_complete.xlsx')\nws_answer = wb['Answer']\n\n# Data from Step 2 and matched Total Reserves\nstep3_data = {\n    'Belarus': {'gold_reserves': 7471.00, 'exposure': 7180.35, 'total_reserves': 14425.90},\n    'Georgia': {'gold_reserves': 1002.00, 'exposure': 963.02, 'total_reserves': 6158.70},\n    'Moldova': {'gold_reserves': 10.71, 'exposure': 10.29, 'total_reserves': 5999.34},\n    'Uzbekistan': {'gold_reserves': 55092.42, 'exposure': 52949.11, 'total_reserves': 66311.75},\n    'Czechia': {'gold_reserves': 10121.89, 'exposure': 9728.11, 'total_reserves': 175830.49},\n    'Latvia': {'gold_reserves': 921.28, 'exposure': 885.44, 'total_reserves': 6076.90},\n    'Lithuania': {'gold_reserves': 807.10, 'exposure': 775.70, 'total_reserves': 7082.70}\n}\n\nprint(\"=== STEP 3: RaR Calculation ===\")\nprint(\"Countries included (have both gold reserves and total reserves):\")\n\n# Calculate RaR for each country\nfor country, data in step3_data.items():\n    rar = (data['exposure'] / data['total_reserves']) * 100\n    data['rar'] = rar\n    print(f\"\\n{country}:\")\n    print(f\"  Gold Reserves: ${data['gold_reserves']:.2f} million\")\n    print(f\"  Gold Exposure: ${data['exposure']:.2f} million\")\n    print(f\"  Total Reserves: ${data['total_reserves']:.2f} million\")\n    print(f\"  RaR: {rar:.4f}%\")\n\n# Fill Step 3 in Answer sheet (rows 20-24, starting from column C)\ncol_idx = 3  # Start from column C\nfor country in sorted(step3_data.keys()):\n    data = step3_data[country]\n    ws_answer.cell(row=20, column=col_idx, value=country)\n    ws_answer.cell(row=21, column=col_idx, value=data['gold_reserves'])\n    ws_answer.cell(row=22, column=col_idx, value=data['exposure'])\n    ws_answer.cell(row=23, column=col_idx, value=data['total_reserves'])\n    ws_answer.cell(row=24, column=col_idx, value=data['rar'])\n    col_idx += 1\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"All steps completed!\")\nprint(\"=\"*50)\n\n# Save final result to /root/output/rar_result.xlsx\nwb.save('/root/output/rar_result.xlsx')\nprint(\"\\nFinal workbook saved to: /root/output/rar_result.xlsx\")\n\n# Verify the file was saved\nimport os\nif os.path.exists('/root/output/rar_result.xlsx'):\n    file_size = os.path.getsize('/root/output/rar_result.xlsx')\n    print(f\"File size: {file_size} bytes\")\n    print(\"\\nTask completed successfully!\")\nelse:\n    print(\"ERROR: File was not saved properly\")\n\nPYEOF\n"]
