[151.380144, "i", "python3 << 'EOF'\nimport pandas as pd\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Read the IMF data file\ntry:\n    # Try reading as Excel file\n    xls = pd.ExcelFile('imf_data.xls')\n    print(\"Sheet names:\", xls.sheet_names)\n    print(\"\\nFirst sheet preview:\")\n    df = pd.read_excel('imf_data.xls', sheet_name=0, nrows=20)\n    print(df.head(20))\nexcept Exception as e:\n    print(f\"Error: {e}\")\n    # Try alternative reading method\n    try:\n        df = pd.read_csv('imf_data.xls', sep='\\t', nrows=20)\n        print(\"Read as CSV:\")\n        print(df.head(20))\n    except Exception as e2:\n        print(f\"CSV Error: {e2}\")\nEOF\n"]
