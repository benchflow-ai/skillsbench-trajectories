[243.477967, "i", "python3 << 'EOF'\nimport requests\nimport json\n\n# Try World Bank Commodity Price Data (Pink Sheet)\nurl = 'https://api.worldbank.org/v2/sources/40/indicators/PGOLD/data'\nparams = {\n    'format': 'json',\n    'per_page': 1000,\n    'date': '1990M01:2025M12'\n}\n\ntry:\n    response = requests.get(url, params=params, timeout=15)\n    print(f\"Status: {response.status_code}\")\n    if response.status_code == 200:\n        data = response.json()\n        print(f\"Data type: {type(data)}\")\n        if isinstance(data, list) and len(data) > 1:\n            print(f\"Number of records: {len(data[1]) if len(data) > 1 else 0}\")\n            if len(data) > 1 and len(data[1]) > 0:\n                print(\"Sample records:\")\n                for i in range(min(5, len(data[1]))):\n                    print(data[1][i])\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\n"]
