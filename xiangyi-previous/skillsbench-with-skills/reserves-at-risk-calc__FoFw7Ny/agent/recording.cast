[313.525028, "i", "python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\nprint(\"Loading workbook and examining data sheets...\")\nwb = load_workbook('/tmp/gold_populated.xlsx')\n\n# Read Value sheet\nws_value = wb['Value']\nprint(\"\\n=== Value Sheet Structure ===\")\nfor i, row in enumerate(ws_value.iter_rows(min_row=1, max_row=10, values_only=True), 1):\n    print(f\"Row {i}: {row[:5]}...\")  # Show first 5 columns\n\n# Read Volume sheet\nws_volume = wb['Volume']\nprint(\"\\n=== Volume Sheet Structure ===\")\nfor i, row in enumerate(ws_volume.iter_rows(min_row=1, max_row=10, values_only=True), 1):\n    print(f\"Row {i}: {row[:5]}...\")  # Show first 5 columns\n\n# Read Total Reserves sheet\nws_total = wb['Total Reserves']\nprint(\"\\n=== Total Reserves Sheet Structure ===\")\nfor i, row in enumerate(ws_total.iter_rows(min_row=1, max_row=10, values_only=True), 1):\n    print(f\"Row {i}: {row[:5]}...\")  # Show first 5 columns\n\n# Find the year 2025 in the data\nprint(\"\\n=== Looking for 2025 data ===\")\n\n# Check Value sheet for 2025\nfor i, row in enumerate(ws_value.iter_rows(min_row=1, max_row=50, values_only=True), 1):\n    if row[0] and '2025' in str(row[0]):\n        print(f\"Value sheet row {i}: {row[:10]}\")\n        break\n\nPYEOF\n"]
[313.525302, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
