[54.759429, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('/root/data/test-rar.xlsx')\n\n# Check Answer sheet\nprint(\"\\n=== Answer Sheet ===\")\nws = wb['Answer']\nfor row in ws.iter_rows(min_row=1, max_row=25, values_only=True):\n    if any(cell is not None for cell in row):\n        print(row)\n\nprint(\"\\n=== Value Sheet (first 10 rows) ===\")\nws = wb['Value']\nfor row in ws.iter_rows(min_row=1, max_row=10, values_only=True):\n    print(row)\n\nprint(\"\\n=== Volume Sheet (first 10 rows) ===\")\nws = wb['Volume']\nfor row in ws.iter_rows(min_row=1, max_row=10, values_only=True):\n    print(row)\n\nprint(\"\\n=== Total Reserves Sheet (first 10 rows) ===\")\nws = wb['Total Reserves']\nfor row in ws.iter_rows(min_row=1, max_row=10, values_only=True):\n    print(row)\nEOF\n"]
