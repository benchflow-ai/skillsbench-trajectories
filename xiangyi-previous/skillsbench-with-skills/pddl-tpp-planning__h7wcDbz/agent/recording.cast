[43.569165, "o", "(define (problem TPP)\r\n(:domain TPP-Propositional)\r\n(:objects\r\n\tgoods1 goods2 - goods\r\n\ttruck1 - truck\r\n\tmarket1 - market\r\n\tdepot1 - depot\r\n\tlevel0 level1 - level)\r\n\r\n(:init\r\n\t(next level1 level0)\r\n\t(ready-to-load goods1 market1 level0)\r\n\t(ready-to-load goods2 market1 level0)\r\n\t(stored goods1 level0)\r\n\t(stored goods2 level0)\r\n\t(loaded goods1 truck1 level0)\r\n\t"]
[43.569347, "o", "(loaded goods2 truck1 level0)\r\n\t(connected depot1 market1)\r\n\t(connected market1 depot1)\r\n\t(on-sale goods1 market1 level1)\r\n"]
[43.569573, "o", "\t(on-sale goods2 market1 level1)\r\n\t(at truck1 depot1))\r\n\r\n(:goal (and\r\n\t(stored goods1 level1)\r\n"]
[43.569747, "o", "\t(stored goods2 level1)))\r\n\r\n)\r\n"]
