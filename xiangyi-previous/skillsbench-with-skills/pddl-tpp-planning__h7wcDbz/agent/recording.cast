[90.888797, "o", "\u001b[?2004h"]
[90.888957, "o", "> "]
[90.889145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.889245, "o", "> # Read problem.json"]
[90.889398, "o", "\r\n\u001b[?2004l\r"]
[90.889628, "o", "\u001b[?2004h> "]
[90.889736, "o", "with open('problem.json', 'r') as f:"]
[90.889842, "o", "\r\n"]
[90.890089, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.890204, "o", ">     tasks = json.load(f)"]
[90.890342, "o", "\r\n"]
[90.890572, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.891064, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.891255, "o", "> # Solve each task\r\n\u001b[?2004l\r\u001b[?2004h> for task in tasks:"]
[90.891536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.89166, "o", ">     print(f\"Solving {task['id']}...\")"]
[90.891777, "o", "\r\n"]
[90.891945, "o", "\u001b[?2004l\r"]
[90.892102, "o", "\u001b[?2004h> "]
[90.892256, "o", "    \r\n\u001b[?2004l\r"]
[90.892438, "o", "\u001b[?2004h> "]
[90.892572, "o", "    # Load problem"]
[90.89272, "o", "\r\n\u001b[?2004l\r"]
[90.892908, "o", "\u001b[?2004h> "]
[90.893017, "o", "    reader = PDDLReader()"]
[90.89317, "o", "\r\n"]
[90.893472, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.893585, "o", "    problem = reader.parse_problem(task['domain'], task['problem'])"]
[90.893692, "o", "\r\n"]
[90.8938, "o", "\u001b[?2004l\r"]
[90.893935, "o", "\u001b[?2004h"]
[90.894264, "o", "> "]
[90.894408, "o", "    "]
[90.894582, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.89468, "o", ">     # Generate plan"]
[90.894813, "o", "\r\n"]
[90.895045, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.895137, "o", "    with OneshotPlanner(name=\"pyperplan\") as planner:"]
[90.895231, "o", "\r\n"]
[90.895328, "o", "\u001b[?2004l\r"]
[90.895442, "o", "\u001b[?2004h"]
[90.895653, "o", "> "]
[90.895749, "o", "        result = planner.solve(problem)"]
[90.89584, "o", "\r\n"]
[90.895959, "o", "\u001b[?2004l\r"]
[90.896081, "o", "\u001b[?2004h"]
[90.89621, "o", ">     "]
[90.896382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.896476, "o", "    if result.plan is None:"]
[90.896603, "o", "\r\n"]
[90.896834, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.896929, "o", ">         print(f\"No plan found for {task['id']}\")"]
[90.897027, "o", "\r\n"]
[90.897158, "o", "\u001b[?2004l\r"]
[90.897327, "o", "\u001b[?2004h"]
[90.897453, "o", ">         continue"]
[90.897584, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.897715, "o", ">     "]
[90.897854, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.897967, "o", "    # Save plan"]
[90.898105, "o", "\r\n"]
[90.898386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.898626, "o", "    output_path = task['plan_output']"]
[90.898762, "o", "\r\n"]
[90.898933, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.899151, "o", "> "]
[90.899278, "o", "    with open(output_path, 'w') as f:"]
[90.899379, "o", "\r\n"]
[90.899507, "o", "\u001b[?2004l\r"]
[90.899728, "o", "\u001b[?2004h"]
[90.899824, "o", ">         for action in result.plan.actions:"]
[90.899924, "o", "\r\n"]
[90.900024, "o", "\u001b[?2004l\r"]
[90.90026, "o", "\u001b[?2004h"]
[90.900366, "o", ">             f.write(str(action) + \"\\n\")"]
[90.900464, "o", "\r\n"]
[90.900589, "o", "\u001b[?2004l\r"]
[90.900719, "o", "\u001b[?2004h"]
[90.900852, "o", ">     "]
[90.901075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.901189, "o", ">     print(f\"Plan saved to {output_path}\")"]
[90.90131, "o", "\r\n"]
[90.901453, "o", "\u001b[?2004l\r"]
[90.901667, "o", "\u001b[?2004h> \r\n"]
[90.901775, "o", "\u001b[?2004l\r\u001b[?2004h> print(\"All tasks completed!\")"]
[90.901898, "o", "\r\n"]
[90.902047, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.902419, "o", "> EOF"]
[90.902557, "o", "\r\n\u001b[?2004l\r"]
[90.908068, "o", "\u001b[?2004h"]
[90.908314, "o", "root@779bd7b01007:/app# "]
