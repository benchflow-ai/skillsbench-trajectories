[?2004hroot@83b4e92a292b:~# cat > /root/create_report.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> from openpyxl import Workbook
[?2004l[?2004h> from openpyxl.utils.dataframe import dataframe_to_rows
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Read income data
[?2004l[?2004h> print("Reading income data...")
[?2004l[?2004h> income_df = pd.read_excel('/root/income.xlsx')
[?2004l[?2004h> print(f"Income data: {income_df.shape[0]} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Read population data from PDF
[?2004l[?2004h> print("Reading population data from PDF...")
[?2004l[?2004h> population_data = []
[?2004l[?2004h> 
[?2004l[?2004h> with pdfplumber.open('/root/population.pdf') as pdf:
[?2004l[?2004h>     for page_num, page in enumerate(pdf.pages):
[?2004l[?2004h>         print(f"Processing page {page_num + 1}/{len(pdf.pages)}")
[?2004l[?2004h>         table = page.extract_table()
[?2004l[?2004h>         if table:
[?2004l[?2004h>             # Skip header row on first page, and header rows on subsequent pages
[?2004l[?2004h>             start_idx = 1 if page_num == 0 else 1
[?2004l[?2004h>             for row in table[start_idx:]:
[?2004l[?2004h>                 if row and len(row) >= 4 and row[0] and row[0] != 'SA2_CODE':
[?2004l[?2004h>                     try:
[?2004l[?2004h>                         sa2_code = int(row[0]) if row[0] else None
[?2004l[?2004h>                         sa2_name = row[1]
[?2004l[?2004h>                         state = row[2]
[?2004l[?2004h>                         population = int(row[3]) if row[3] else None
[?2004l[?2004h>                         if sa2_code and population is not None:
[?2004l[?2004h>                             population_data.append({
[?2004l[?2004h>                                 'SA2_CODE': sa2_code,
[?2004l[?2004h>                                 'SA2_NAME': sa2_name,
[?2004l[?2004h>                                 'STATE': state,
[?2004l[?2004h>                                 'POPULATION_2023': population
[?2004l[?2004h>                             })
[?2004l[?2004h>                     except (ValueError, IndexError) as e:
[?2004l[?2004h>                         continue
[?2004l[?2004h> 
[?2004l[?2004h> population_df = pd.DataFrame(population_data)
[?2004l[?2004h> print(f"Population data: {population_df.shape[0]} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Merge the data
[?2004l[?2004h> print("Merging data...")
[?2004l[?2004h> merged_df = pd.merge(income_df, population_df, on='SA2_CODE', how='inner')
[?2004l[?2004h> print(f"Merged data: {merged_df.shape[0]} rows")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate quartiles for MEDIAN_INCOME
[?2004l[?2004h> merged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate Total
[?2004l[?2004h> merged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']
[?2004l[?2004h> 
[?2004l[?2004h> # Create Excel writer
[?2004l[?2004h> print("Creating Excel file...")
[?2004l[?2004h> with pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:
[?2004l[?2004h>     
[?2004l[?2004h>     # Sheet 5: SourceData (original enriched data)
[?2004l[?2004h>     print("Creating SourceData sheet...")
[?2004l[?2004h>     source_cols = ['SA2_CODE', 'SA2_NAME', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', 
[?2004l[?2004h>                    'STATE', 'POPULATION_2023', 'Quarter', 'Total']
[?2004l[?2004h>     merged_df[source_cols].to_excel(writer, sheet_name='SourceData', index=False)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sheet 1: Population by State
[?2004l[?2004h>     print("Creating Population by State pivot...")
[?2004l[?2004h>     pivot1 = merged_df.groupby('STATE')['POPULATION_2023'].sum().reset_index()
[?2004l[?2004h>     pivot1.columns = ['STATE', 'Sum of POPULATION_2023']
[?2004l[?2004h>     pivot1.to_excel(writer, sheet_name='Population by State', index=False)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sheet 2: Earners by State
[?2004l[?2004h>     print("Creating Earners by State pivot...")
[?2004l[?2004h>     pivot2 = merged_df.groupby('STATE')['EARNERS'].sum().reset_index()
[?2004l[?2004h>     pivot2.columns = ['STATE', 'Sum of EARNERS']
[?2004l[?2004h>     pivot2.to_excel(writer, sheet_name='Earners by State', index=False)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sheet 3: Regions by State
[?2004l[?2004h>     print("Creating Regions by State pivot...")
[?2004l[?2004h>     pivot3 = merged_df.groupby('STATE').size().reset_index()
[?2004l[?2004h>     pivot3.columns = ['STATE', 'Count of SA2 regions']
[?2004l[?2004h>     pivot3.to_excel(writer, sheet_name='Regions by State', index=False)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sheet 4: State Income Quartile
[?2004l[?2004h>     print("Creating State Income Quartile pivot...")
[?2004l[?2004h>     pivot4 = merged_df.pivot_table(
[?2004l[?2004h>         values='EARNERS',
[?2004l[?2004h>         index='STATE',
[?2004l[?2004h>         columns='Quarter',
[?2004l[?2004h>         aggfunc='sum',
[?2004l[?2004h>         fill_value=0
[?2004l[?2004h>     ).reset_index()
[?2004l[?2004h>     pivot4.to_excel(writer, sheet_name='State Income Quartile', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print("Done! File saved to /root/demographic_analysis.xlsx")
