[174.368059, "i", "python3 << 'EOF'\nimport pandas as pd\n\nprint(\"=\" * 60)\nprint(\"FINAL VERIFICATION OF DEMOGRAPHIC_ANALYSIS.XLSX\")\nprint(\"=\" * 60)\n\n# Verify all sheets\nxl_file = pd.ExcelFile('/root/demographic_analysis.xlsx')\nprint(f\"\\n✓ File location: /root/demographic_analysis.xlsx\")\nprint(f\"✓ Number of sheets: {len(xl_file.sheet_names)}\")\nprint(f\"✓ Sheet names: {xl_file.sheet_names}\")\n\nexpected_sheets = ['Population by State', 'Earners by State', 'Regions by State', 'State Income Quartile', 'SourceData']\nfor sheet in expected_sheets:\n    if sheet in xl_file.sheet_names:\n        print(f\"  ✓ {sheet} - Present\")\n    else:\n        print(f\"  ✗ {sheet} - MISSING\")\n\n# Check Sheet 1: Population by State\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Sheet 1: Population by State\")\ndf1 = pd.read_excel('/root/demographic_analysis.xlsx', sheet_name='Population by State')\nprint(f\"  Rows: STATE\")\nprint(f\"  Values: Sum of POPULATION_2023\")\nprint(f\"  ✓ Columns: {df1.columns.tolist()}\")\nprint(f\"  ✓ Row count: {len(df1)}\")\nprint(df1.head(3))\n\n# Check Sheet 2: Earners by State\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Sheet 2: Earners by State\")\ndf2 = pd.read_excel('/root/demographic_analysis.xlsx', sheet_name='Earners by State')\nprint(f\"  Rows: STATE\")\nprint(f\"  Values: Sum of EARNERS\")\nprint(f\"  ✓ Columns: {df2.columns.tolist()}\")\nprint(f\"  ✓ Row count: {len(df2)}\")\nprint(df2.head(3))\n\n# Check Sheet 3: Regions by State\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Sheet 3: Regions by State\")\ndf3 = pd.read_excel('/root/demographic_analysis.xlsx', sheet_name='Regions by State')\nprint(f\"  Rows: STATE\")\nprint(f\"  Values: Count (number of SA2 regions)\")\nprint(f\"  ✓ Columns: {df3.columns.tolist()}\")\nprint(f\"  ✓ Row count: {len(df3)}\")\nprint(df3.head(3))\n\n# Check Sheet 4: State Income Quartile\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Sheet 4: State Income Quartile\")\ndf4 = pd.read_excel('/root/demographic_analysis.xlsx', sheet_name='State Income Quartile')\nprint(f\"  Rows: STATE\")\nprint(f\"  Columns: Quarter (Q1, Q2, Q3, Q4)\")\nprint(f\"  Values: Sum of EARNERS\")\nprint(f\"  ✓ Columns: {df4.columns.tolist()}\")\nprint(f\"  ✓ Row count: {len(df4)}\")\nprint(df4.head(3))\n\n# Check Sheet 5: SourceData\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Sheet 5: SourceData\")\ndf5 = pd.read_excel('/root/demographic_analysis.xlsx', sheet_name='SourceData')\nprint(f\"  ✓ Columns: {df5.columns.tolist()}\")\nprint(f\"  ✓ Row count: {len(df5)}\")\nprint(f\"  ✓ Has 'Quarter' column: {'Quarter' in df5.columns}\")\nprint(f\"  ✓ Has 'Total' column: {'Total' in df5.columns}\")\nprint(f\"  ✓ Quarter values: {df5['Quarter'].unique()}\")\nprint(\"\\nSample data:\")\nprint(df5[['SA2_CODE', 'SA2_NAME', 'STATE', 'EARNERS', 'MEDIAN_INCOME', 'POPULATION_2023', 'Quarter', 'Total']].head(3))\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"ALL REQUIREMENTS VERIFIED SUCCESSFULLY!\")\nprint(\"=\" * 60)\nEOF\n"]
