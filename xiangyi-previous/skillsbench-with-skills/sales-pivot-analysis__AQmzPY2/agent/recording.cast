[117.769813, "o", "            for row in table[start_idx:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.769902, "o", "                if row and len(row) >= 4 and row[0] and row[0] != 'SA2_CODE':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.769958, "o", "                    try:\r\n\u001b[?2004l\r"]
[117.770015, "o", "\u001b[?2004h> "]
[117.770078, "o", "                        sa2_code = int(row[0]) if row[0] else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.770149, "o", "                        sa2_name = row[1]\r\n\u001b[?2004l\r"]
[117.770211, "o", "\u001b[?2004h> "]
[117.770273, "o", "                        state = row[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.770343, "o", "                        population = int(row[3]) if row[3] else None\r\n\u001b[?2004l\r"]
[117.7704, "o", "\u001b[?2004h> "]
[117.77048, "o", "                        if sa2_code and population is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.770562, "o", "                            population_data.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.77062, "o", "> "]
[117.770685, "o", "                                'SA2_CODE': sa2_code,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.770751, "o", "                                'SA2_NAME_POP': sa2_name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.77081, "o", "> "]
[117.770859, "o", "                                'STATE': state,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.77094, "o", "                                'POPULATION_2023': population\r\n\u001b[?2004l\r"]
[117.770985, "o", "\u001b[?2004h> "]
[117.771027, "o", "                            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.771107, "o", "                    except (ValueError, IndexError) as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.771148, "o", "> "]
[117.77119, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.771239, "o", "\u001b[?2004h> print()\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.771284, "o", "> "]
[117.771327, "o", "population_df = pd.DataFrame(population_data)\r\n\u001b[?2004l\r"]
[117.77137, "o", "\u001b[?2004h> "]
[117.771435, "o", "print(f\"Population data: {population_df.shape[0]} rows\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.77148, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.771522, "o", "# Merge the data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.771566, "o", "print(\"Merging data...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.771683, "o", "merged_df = pd.merge(income_df, population_df, on='SA2_CODE', how='inner')\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.771728, "o", "> "]
[117.771767, "o", "print(f\"Merged data: {merged_df.shape[0]} rows\")\r\n\u001b[?2004l\r"]
[117.771819, "o", "\u001b[?2004h> "]
[117.771875, "o", "print(f\"Merged columns: {merged_df.columns.tolist()}\")\r\n\u001b[?2004l\r"]
[117.771932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772002, "o", "# Ensure MEDIAN_INCOME is numeric\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772133, "o", "merged_df['MEDIAN_INCOME'] = pd.to_numeric(merged_df['MEDIAN_INCOME'], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.772186, "o", "> "]
[117.772236, "o", "merged_df = merged_df.dropna(subset=['MEDIAN_INCOME'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772344, "o", "print(f\"After cleaning MEDIAN_INCOME: {merged_df.shape[0]} rows\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.77242, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Calculate quartiles for MEDIAN_INCOME\r\n\u001b[?2004l\r"]
[117.772485, "o", "\u001b[?2004h> "]
[117.77262, "o", "merged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'], duplicates='drop')\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.772683, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772733, "o", "# Calculate Total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772801, "o", "merged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.772824, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.77288, "o", "# Create Excel writer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.772932, "o", "print(\"Creating Excel file...\")\r\n\u001b[?2004l\r"]
[117.772984, "o", "\u001b[?2004h> "]
[117.773089, "o", "with pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.773143, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.773191, "o", "    # Sheet 5: SourceData (original enriched data)\r\n\u001b[?2004l\r"]
[117.773215, "o", "\u001b[?2004h> "]
[117.773311, "o", "    print(\"Creating SourceData sheet...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.773415, "o", "    source_cols = ['SA2_CODE', 'SA2_NAME', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.77347, "o", "> "]
[117.773532, "o", "                   'STATE', 'POPULATION_2023', 'Quarter', 'Total']\r\n\u001b[?2004l\r"]
[117.773576, "o", "\u001b[?2004h> "]
[117.773672, "o", "    merged_df[source_cols].to_excel(writer, sheet_name='SourceData', index=False)\r\n\u001b[?2004l\r"]
[117.773696, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[117.77372, "o", "\u001b[?2004h> "]
[117.773791, "o", "    # Sheet 1: Population by State\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.773859, "o", "    print(\"Creating Population by State pivot...\")\r\n\u001b[?2004l\r"]
[117.773913, "o", "\u001b[?2004h> "]
[117.773992, "o", "    pivot1 = merged_df.groupby('STATE')['POPULATION_2023'].sum().reset_index()\r\n\u001b[?2004l\r"]
[117.774047, "o", "\u001b[?2004h> "]
[117.77409, "o", "    pivot1.columns = ['STATE', 'Sum of POPULATION_2023']\r\n\u001b[?2004l\r"]
[117.774128, "o", "\u001b[?2004h> "]
[117.77422, "o", "    pivot1.to_excel(writer, sheet_name='Population by State', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.774277, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.77433, "o", ">     # Sheet 2: Earners by State\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.77441, "o", "    print(\"Creating Earners by State pivot...\")\r\n\u001b[?2004l\r"]
[117.774447, "o", "\u001b[?2004h> "]
[117.774521, "o", "    pivot2 = merged_df.groupby('STATE')['EARNERS'].sum().reset_index()\r\n\u001b[?2004l\r"]
[117.774566, "o", "\u001b[?2004h> "]
[117.774647, "o", "    pivot2.columns = ['STATE', 'Sum of EARNERS']\r\n\u001b[?2004l\r"]
[117.774699, "o", "\u001b[?2004h> "]
[117.774764, "o", "    pivot2.to_excel(writer, sheet_name='Earners by State', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.774816, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.774883, "o", "    # Sheet 3: Regions by State\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.774949, "o", "    print(\"Creating Regions by State pivot...\")\r\n\u001b[?2004l\r"]
[117.775006, "o", "\u001b[?2004h> "]
[117.775078, "o", "    pivot3 = merged_df.groupby('STATE').size().reset_index()\r\n\u001b[?2004l\r"]
[117.775129, "o", "\u001b[?2004h> "]
[117.775191, "o", "    pivot3.columns = ['STATE', 'Count of SA2 regions']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.775292, "o", "    pivot3.to_excel(writer, sheet_name='Regions by State', index=False)\r\n\u001b[?2004l\r"]
[117.775342, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.775389, "o", "    # Sheet 4: State Income Quartile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.775482, "o", "    print(\"Creating State Income Quartile pivot...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.775525, "o", "> "]
[117.775566, "o", "    pivot4 = merged_df.pivot_table(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.775609, "o", "        values='EARNERS',\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.775652, "o", ">         index='STATE',\r\n\u001b[?2004l\r"]
[117.775692, "o", "\u001b[?2004h> "]
[117.775733, "o", "        columns='Quarter',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.775779, "o", "        aggfunc='sum',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.77582, "o", "        fill_value=0\r\n\u001b[?2004l\r"]
[117.775859, "o", "\u001b[?2004h>     ).reset_index()\r\n\u001b[?2004l\r"]
[117.775895, "o", "\u001b[?2004h> "]
[117.775996, "o", "    pivot4.to_excel(writer, sheet_name='State Income Quartile', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.776038, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.776121, "o", "print(\"Done! File saved to /root/demographic_analysis.xlsx\")\r\n\u001b[?2004l\r"]
[117.776164, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
