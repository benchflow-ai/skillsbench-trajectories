[91.963576, "o", "\u001b[?2004hroot@83b4e92a292b:~# "]
[117.766974, "i", "cat > /root/create_report.py << 'EOF'\nimport pandas as pd\nimport pdfplumber\nfrom openpyxl import Workbook\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nimport numpy as np\n\n# Read income data\nprint(\"Reading income data...\")\nincome_df = pd.read_excel('/root/income.xlsx')\nprint(f\"Income data: {income_df.shape[0]} rows\")\nprint(f\"Income columns: {income_df.columns.tolist()}\")\n\n# Read population data from PDF\nprint(\"Reading population data from PDF...\")\npopulation_data = []\n\nwith pdfplumber.open('/root/population.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        print(f\"Processing page {page_num + 1}/{len(pdf.pages)}\", end='\\r')\n        table = page.extract_table()\n        if table:\n            # Skip header row on first page, and header rows on subsequent pages\n            start_idx = 1 if page_num == 0 else 1\n            for row in table[start_idx:]:\n                if row and len(row) >= 4 and row[0] and row[0] != 'SA2_CODE':\n                    try:\n                        sa2_code = int(row[0]) if row[0] else None\n                        sa2_name = row[1]\n                        state = row[2]\n                        population = int(row[3]) if row[3] else None\n                        if sa2_code and population is not None:\n                            population_data.append({\n                                'SA2_CODE': sa2_code,\n                                'SA2_NAME_POP': sa2_name,\n                                'STATE': state,\n                                'POPULATION_2023': population\n                            })\n                    except (ValueError, IndexError) as e:\n                        continue\n\nprint()\npopulation_df = pd.DataFrame(population_data)\nprint(f\"Population data: {population_df.shape[0]} rows\")\n\n# Merge the data\nprint(\"Merging data...\")\nmerged_df = pd.merge(income_df, population_df, on='SA2_CODE', how='inner')\nprint(f\"Merged data: {merged_df.shape[0]} rows\")\nprint(f\"Merged columns: {merged_df.columns.tolist()}\")\n\n# Ensure MEDIAN_INCOME is numeric\nmerged_df['MEDIAN_INCOME'] = pd.to_numeric(merged_df['MEDIAN_INCOME'], errors='coerce')\nmerged_df = merged_df.dropna(subset=['MEDIAN_INCOME'])\nprint(f\"After cleaning MEDIAN_INCOME: {merged_df.shape[0]} rows\")\n\n# Calculate quartiles for MEDIAN_INCOME\nmerged_df['Quarter'] = pd.qcut(merged_df['MEDIAN_INCOME'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'], duplicates='drop')\n\n# Calculate Total\nmerged_df['Total'] = merged_df['EARNERS'] * merged_df['MEDIAN_INCOME']\n\n# Create Excel writer\nprint(\"Creating Excel file...\")\nwith pd.ExcelWriter('/root/demographic_analysis.xlsx', engine='openpyxl') as writer:\n    \n    # Sheet 5: SourceData (original enriched data)\n    print(\"Creating SourceData sheet...\")\n    source_cols = ['SA2_CODE', 'SA2_NAME', 'EARNERS', 'MEDIAN_INCOME', 'MEAN_INCOME', \n                   'STATE', 'POPULATION_2023', 'Quarter', 'Total']\n    merged_df[source_cols].to_excel(writer, sheet_name='SourceData', index=False)\n    \n    # Sheet 1: Population by State\n    print(\"Creating Population by State pivot...\")\n    pivot1 = merged_df.groupby('STATE')['POPULATION_2023'].sum().reset_index()\n    pivot1.columns = ['STATE', 'Sum of POPULATION_2023']\n    pivot1.to_excel(writer, sheet_name='Population by State', index=False)\n    \n    # Sheet 2: Earners by State\n    print(\"Creating Earners by State pivot...\")\n    pivot2 = merged_df.groupby('STATE')['EARNERS'].sum().reset_index()\n    pivot2.columns = ['STATE', 'Sum of EARNERS']\n    pivot2.to_excel(writer, sheet_name='Earners by State', index=False)\n    \n    # Sheet 3: Regions by State\n    print(\"Creating Regions by State pivot...\")\n    pivot3 = merged_df.groupby('STATE').size().reset_index()\n    pivot3.columns = ['STATE', 'Count of SA2 regions']\n    pivot3.to_excel(writer, sheet_name='Regions by State', index=False)\n    \n    # Sheet 4: State Income Quartile\n    print(\"Creating State Income Quartile pivot...\")\n    pivot4 = merged_df.pivot_table(\n        values='EARNERS',\n        index='STATE',\n        columns='Quarter',\n        aggfunc='sum',\n        fill_value=0\n    ).reset_index()\n    "]
[117.767028, "i", "pivot4.to_excel(writer, sheet_name='State Income Quartile', index=False)\n\nprint(\"Done! File saved to /root/demographic_analysis.xlsx\")\nEOF\n"]
