[155.59514, "o", "\u001b[?2004l\r"]
[155.59521, "o", "\u001b[?2004h"]
[155.595292, "o", "> "]
[155.595443, "o", "        f = bus_map[int(br[0])]\r\n\u001b[?2004l\r"]
[155.595509, "o", "\u001b[?2004h> "]
[155.595658, "o", "        t = bus_map[int(br[1])]\r\n\u001b[?2004l\r"]
[155.595789, "o", "\u001b[?2004h>         x = br[3]\r\n\u001b[?2004l\r"]
[155.595942, "o", "\u001b[?2004h> "]
[155.596105, "o", "        limit = br[5] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.596655, "o", "        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.596826, "o", "            limit *= 1.2\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[155.596971, "o", "\u001b[?2004h>         if br[10] > 0:\r\n\u001b[?2004l\r"]
[155.597036, "o", "\u001b[?2004h> "]
[155.597215, "o", "            # (1/x) * (theta_f - theta_t) <= limit\r\n\u001b[?2004l\r"]
[155.597313, "o", "\u001b[?2004h> "]
[155.597446, "o", "            row = np.zeros(n_vars)\r\n\u001b[?2004l\r"]
