[155.60901, "o", "        \"delta\": float(deltas[idx])\r\n\u001b[?2004l\r"]
[155.609056, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.609097, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.609235, "o", "line_binding_in_cf = any(l['from'] in [64, 1501] and l['to'] in [64, 1501] for l in cf_case['binding_lines'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.609297, "o", "\u001b[?2004h> "]
[155.609343, "o", "report[\"impact_analysis\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.609474, "o", "    \"cost_reduction_dollars_per_hour\": base_case['total_cost'] - cf_case['total_cost'],\r\n\u001b[?2004l\r"]
[155.609513, "o", "\u001b[?2004h> "]
[155.609596, "o", "    \"buses_with_largest_lmp_drop\": buses_with_largest_lmp_drop,\r\n\u001b[?2004l\r"]
[155.609646, "o", "\u001b[?2004h> "]
[155.609686, "o", "    \"congestion_relieved\": not line_binding_in_cf\r\n\u001b[?2004l\r"]
