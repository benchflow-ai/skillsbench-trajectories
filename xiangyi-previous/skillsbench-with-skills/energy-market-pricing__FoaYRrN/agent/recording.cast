[238.758472, "o", "    for i, br in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.758554, "o", "        f_idx = bus_map[int(br[0])]\r\n\u001b[?2004l\r"]
[238.758629, "o", "\u001b[?2004h> "]
[238.758702, "o", "        t_idx = bus_map[int(br[1])]\r\n\u001b[?2004l\r"]
[238.758761, "o", "\u001b[?2004h> "]
[238.758835, "o", "        x = br[3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.758899, "o", "        limit = br[5]\r\n\u001b[?2004l\r"]
[238.758967, "o", "\u001b[?2004h> "]
[238.765422, "o", "        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\r\n\u001b[?2004l\r\u001b[?2004h>             limit *= 1.2\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         flow = (1.0 / x) * (theta[f_idx] - theta[t_idx]) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(flow) >= 0.99 * limit:\r\n\u001b[?2004l\r\u001b[?2004h>             binding_lines.append({\"from\": int(br[0]), \"to\": int(br[1]), \"flow_MW\": float(flow), \"limit_MW\": float(limit)})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h>         \"total_cost\": float(sol['primal objective']),\r\n\u001b[?2004l\r\u001b[?2004h>         \"LMPs\": LMPs.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h>         \"res_mcp\": float(res_mcp),\r\n\u001b[?2004l\r\u001b[?2004h>         \"binding_lines\": binding_lines\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('network.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     network = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> base_case = solve_dc_opf(network)\r\n\u001b[?2004l\r\u001b[?2004h> cf_case = solve_dc_opf(network, line_relax=(64, 1501))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> buses = network['bus']\r\n\u001b[?2004l\r\u001b[?2004h> bus_ids = [int(b[0]) for b in buses]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"base_case\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"total_cost_dollars_per_hour\": base_case['total_cost'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, base_case['LMPs'])],\r\n\u001b[?2004l\r\u001b[?2004h>         \"reserve_mcp_dollars_per_MWh\": base_case['res_mcp'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"binding_lines\": base_case['binding_lines']\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     \"counterfactual\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"total_cost_dollars_per_hour\": cf_case['total_cost'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, cf_case['LMPs'])],\r\n\u001b[?2004l\r\u001b[?2004h>         \"reserve_mcp_dollars_per_MWh\": cf_case['res_mcp'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"binding_lines\": cf_case['binding_lines']\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> base_lmps = np.array(base_case['LMPs'])\r\n\u001b[?2004l\r\u001b[?2004h> cf_lmps = np.array(cf_case['LMPs'])\r\n\u001b[?2004l\r\u001b[?2004h> deltas = cf_lmps - base_lmps\r\n\u001b[?2004l\r\u001b[?2004h> sorted_indices = np.argsort(deltas)\r\n\u001b[?2004l\r\u001b[?2004h> top_3_indices = sorted_indices[:3]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> buses_with_largest_lmp_drop = []\r\n\u001b[?2004l\r\u001b[?2004h> for idx in top_3_indices:\r\n\u001b[?2004l\r\u001b[?2004h>     buses_with_largest_lmp_drop.append({\r\n\u001b[?2004l\r\u001b[?2004h>         \"bus\": int(bus_ids[idx]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"base_lmp\": float(base_lmps[idx]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"cf_lmp\": float(cf_lmps[idx]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"delta\": float(deltas[idx])\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.76573, "o", "line_binding_in_cf = any((l['from'] == 64 and l['to'] == 1501) or (l['from'] == 1501 and l['to'] == 64) for l in cf_case['binding_lines'])\r\n\u001b[?2004l\r"]
[238.765801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.765923, "o", "report[\"impact_analysis\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.766146, "o", "    \"cost_reduction_dollars_per_hour\": base_case['total_cost'] - cf_case['total_cost'],\r\n\u001b[?2004l\r"]
[238.766211, "o", "\u001b[?2004h> "]
[238.766363, "o", "    \"buses_with_largest_lmp_drop\": buses_with_largest_lmp_drop,\r\n\u001b[?2004l\r"]
[238.766426, "o", "\u001b[?2004h> "]
[238.766547, "o", "    \"congestion_relieved\": not line_binding_in_cf\r\n\u001b[?2004l\r"]
[238.766613, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[238.766671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[238.766729, "o", "> "]
[238.766869, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.766938, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r"]
[238.766997, "o", "\u001b[?2004h> EOF\r\n"]
