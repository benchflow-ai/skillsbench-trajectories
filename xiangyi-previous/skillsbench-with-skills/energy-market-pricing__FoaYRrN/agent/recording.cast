[155.605994, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[155.606055, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.606111, "o", "with open('network.json') as f:\r\n\u001b[?2004l\r"]
[155.606161, "o", "\u001b[?2004h> "]
[155.606197, "o", "    network = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.606243, "o", "\u001b[?2004h> "]
[155.606293, "o", "base_case = solve_dc_opf(network)\r\n\u001b[?2004l\r"]
[155.606339, "o", "\u001b[?2004h> "]
[155.606428, "o", "cf_case = solve_dc_opf(network, line_relax=(64, 1501))\r\n\u001b[?2004l\r\u001b[?2004h"]
