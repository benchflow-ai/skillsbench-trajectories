[155.599874, "o", "\u001b[?2004h> "]
[155.599984, "o", "    G = np.array(G)\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.600049, "o", "> "]
[155.600128, "o", "    h = np.array(h)\r\n"]
