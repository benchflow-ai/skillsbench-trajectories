[155.600322, "o", "\u001b[?2004h> "]
[155.600396, "o", "    # Solve LP\r\n\u001b[?2004l\r"]
[155.600468, "o", "\u001b[?2004h> "]
[155.600629, "o", "    sol = solvers.lp(matrix(c), matrix(G), matrix(h), matrix(A_eq), matrix(b_eq))\r\n\u001b[?2004l\r"]
[155.600706, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.600809, "o", "    if sol['status'] != 'optimal':\r\n\u001b[?2004l\r"]
[155.600871, "o", "\u001b[?2004h> "]
[155.600936, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.600997, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.601102, "o", "    x_sol = np.array(sol['x']).flatten()\r\n\u001b[?2004l\r"]
[155.601164, "o", "\u001b[?2004h> "]
[155.601241, "o", "    Pg = x_sol[:num_gens] * baseMVA\r\n\u001b[?2004l\r"]
[155.601323, "o", "\u001b[?2004h> "]
[155.601419, "o", "    R = x_sol[num_gens:2*num_gens] * baseMVA\r\n\u001b[?2004l\r"]
[155.601485, "o", "\u001b[?2004h> "]
[155.601546, "o", "    theta = x_sol[2*num_gens:]\r\n\u001b[?2004l\r"]
[155.601612, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[155.601676, "o", "\u001b[?2004h> "]
[155.603486, "o", "    # LMPs are duals of power balance constraints\r\n\u001b[?2004l\r\u001b[?2004h>     # In cvxopt, sol['y'] are duals for equality constraints\r\n\u001b[?2004l\r\u001b[?2004h>     # The first num_buses equality constraints are power balance\r\n\u001b[?2004l\r\u001b[?2004h>     # Note: cvxopt duals 'y' might have a sign difference depending on formulation\r\n\u001b[?2004l\r\u001b[?2004h>     # Objective is min c'x s.t. Gx <= h, Ax = b. \r\n\u001b[?2004l\r\u001b[?2004h>     # LMPs are duals of Ax = b. \r\n\u001b[?2004l\r\u001b[?2004h>     # Looking at the results, we'll see if the sign is correct.\r\n\u001b[?2004l\r\u001b[?2004h>     LMPs = np.array(sol['y']).flatten()[:num_buses] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>     # Reserve MCP is dual of the reserve requirement constraint\r\n\u001b[?2004l\r\u001b[?2004h>     # It's one of the inequality constraints. \r\n\u001b[?2004l\r\u001b[?2004h>     # In cvxopt, sol['z'] are duals for Gx <= h\r\n\u001b[?2004l\r\u001b[?2004h>     # Reserve constraint was -sum(R) <= -Rreq, which was at index (2*num_gens + 2*num_gens)\r\n\u001b[?2004l\r\u001b[?2004h>     res_mcp_idx = 4 * num_gens\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.60361, "o", "    res_mcp = np.array(sol['z']).flatten()[res_mcp_idx] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.603673, "o", "\u001b[?2004h> "]
[155.603727, "o", "    total_cost = sol['primal objective']\r\n\u001b[?2004l\r"]
[155.603776, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[155.603824, "o", "> "]
[155.603873, "o", "    # Binding lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.603937, "o", "    binding_lines = []\r\n\u001b[?2004l\r"]
[155.603987, "o", "\u001b[?2004h> "]
[155.604691, "o", "    for i, br in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h>         f_idx = bus_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h>         t_idx = bus_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h>         x = br[3]\r\n\u001b[?2004l\r\u001b[?2004h>         limit = br[5]\r\n\u001b[?2004l\r\u001b[?2004h>         if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\r\n"]
[155.60536, "o", "\u001b[?2004l\r\u001b[?2004h>             limit *= 1.2\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         flow = (1.0 / x) * (theta[f_idx] - theta[t_idx]) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>         if abs(flow) >= 0.99 * limit:\r\n\u001b[?2004l\r\u001b[?2004h>             binding_lines.append({\"from\": int(br[0]), \"to\": int(br[1]), \"flow_MW\": float(flow), \"limit_MW\": float(limit)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.60543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     return {"]
[155.605468, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.605559, "o", "        \"total_cost\": float(total_cost),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.605625, "o", "        \"Pg\": Pg.tolist(),\r\n\u001b[?2004l\r"]
[155.605655, "o", "\u001b[?2004h> "]
[155.605722, "o", "        \"R\": R.tolist(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.605774, "o", "        \"LMPs\": LMPs.tolist(),\r\n\u001b[?2004l\r"]
[155.605813, "o", "\u001b[?2004h> "]
