[155.606515, "o", "buses = network['bus']\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.60656, "o", "> "]
[155.606602, "o", "bus_ids = [int(b[0]) for b in buses]\r\n\u001b[?2004l\r"]
[155.606646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.606691, "o", "# Prepare report\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.606736, "o", "> report = {\r\n\u001b[?2004l\r"]
[155.606772, "o", "\u001b[?2004h> "]
[155.60681, "o", "    \"base_case\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.606933, "o", "        \"total_cost_dollars_per_hour\": base_case['total_cost'],\r\n\u001b[?2004l\r"]
[155.60698, "o", "\u001b[?2004h> "]
[155.607164, "o", "        \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, base_case['LMPs'])],\r\n\u001b[?2004l\r"]
[155.607206, "o", "\u001b[?2004h> "]
[155.607279, "o", "        \"reserve_mcp_dollars_per_MWh\": base_case['res_mcp'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.607326, "o", "> "]
[155.607369, "o", "        \"binding_lines\": base_case['binding_lines']\r\n\u001b[?2004l\r"]
[155.607407, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.607452, "o", "    \"counterfactual\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.6075, "o", "> "]
[155.607558, "o", "        \"total_cost_dollars_per_hour\": cf_case['total_cost'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.607735, "o", "        \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, cf_case['LMPs'])],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.60785, "o", "        \"reserve_mcp_dollars_per_MWh\": cf_case['res_mcp'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.607945, "o", "        \"binding_lines\": cf_case['binding_lines']\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.607991, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608029, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608079, "o", "# Impact analysis\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608123, "o", "base_lmps = np.array(base_case['LMPs'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.608169, "o", "> "]
[155.608209, "o", "cf_lmps = np.array(cf_case['LMPs'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608251, "o", "deltas = cf_lmps - base_lmps\r\n\u001b[?2004l\r"]
[155.60829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608365, "o", "# Buses with largest LMP drop (most negative delta)\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.608415, "o", "> "]
[155.608453, "o", "sorted_indices = np.argsort(deltas)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.6085, "o", "top_3_indices = sorted_indices[:3]\r\n\u001b[?2004l\r"]
[155.608546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608582, "o", "buses_with_largest_lmp_drop = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.608627, "o", "> "]
[155.608665, "o", "for idx in top_3_indices:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608714, "o", "    buses_with_largest_lmp_drop.append({\r\n\u001b[?2004l\r"]
[155.60876, "o", "\u001b[?2004h> "]
[155.608799, "o", "        \"bus\": int(bus_ids[idx]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.608862, "o", "        \"base_lmp\": float(base_lmps[idx]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.60891, "o", "> "]
