[155.564909, "i", "cat << 'EOF' > solve_market.py\nimport json\nimport numpy as np\nfrom cvxopt import matrix, solvers, sparse\n\ndef solve_dc_opf(network, line_relax=None):\n    baseMVA = network['baseMVA']\n    buses = network['bus']\n    gens = network['gen']\n    branches = network['branch']\n    gencost = network['gencost']\n    res_cap = network['reserve_capacity']\n    res_req = network['reserve_requirement']\n\n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n    \n    bus_map = {int(b[0]): i for i, b in enumerate(buses)}\n    \n    # Pd\n    Pd = np.array([b[2] for b in buses]) / baseMVA\n    \n    # B matrix\n    B = np.zeros((num_buses, num_buses))\n    for i, br in enumerate(branches):\n        f = bus_map[int(br[0])]\n        t = bus_map[int(br[1])]\n        x = br[3]\n        if br[10] > 0: # status\n            b_val = 1.0 / x\n            B[f, f] += b_val\n            B[t, t] += b_val\n            B[f, t] -= b_val\n            B[t, f] -= b_val\n\n    # Variables: [Pg (num_gens), R (num_gens), theta (num_buses)]\n    n_vars = num_gens + num_gens + num_buses\n    \n    # Objective: minimize c1 * Pg\n    c = np.zeros(n_vars)\n    for i in range(num_gens):\n        c[i] = gencost[i][5] * baseMVA\n    \n    # Equality constraints: B * theta - sum(Pg) = -Pd\n    # A_eq * x = b_eq\n    A_eq = np.zeros((num_buses, n_vars))\n    for i in range(num_buses):\n        A_eq[i, num_gens + num_gens + i] = 1.0 # theta coefficient for B calculation later\n    \n    # We'll fill B and Pg later\n    A_eq = []\n    for i in range(num_buses):\n        row = np.zeros(n_vars)\n        # sum(Pg) at this bus\n        for g_idx, g in enumerate(gens):\n            if bus_map[int(g[0])] == i:\n                row[g_idx] = -1.0\n        # B * theta\n        # This is inefficient for large systems, use sparse later\n        A_eq.append(row)\n    \n    A_eq = np.array(A_eq)\n    for i in range(num_buses):\n        for j in range(num_buses):\n            if B[i, j] != 0:\n                A_eq[i, num_gens + num_gens + j] = B[i, j]\n    \n    b_eq = -Pd\n\n    # Reference bus thet"]
[155.569396, "o", "cat << 'EOF' > solve_market.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from cvxopt import matrix, solvers, sparse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def solve_dc_opf(network, line_relax=None):\r\n\u001b[?2004l\r\u001b[?2004h>     baseMVA = network['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h>     buses = network['bus']\r\n\u001b[?2004l\r\u001b[?2004h>     gens = network['gen']\r\n\u001b[?2004l\r\u001b[?2004h>     branches = network['branch']\r\n\u001b[?2004l\r\u001b[?2004h>     gencost = network['gencost']\r\n\u001b[?2004l\r\u001b[?2004h>     res_cap = network['reserve_capacity']\r\n\u001b[?2004l\r\u001b[?2004h>     res_req = network['reserve_requirement']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     num_buses = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h>     num_gens = len(gens)\r\n\u001b[?2004l\r\u001b[?2004h>     num_branches = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     bus_map = {int(b[0]): i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Pd\r\n\u001b[?2004l\r\u001b[?2004h>     Pd = np.array([b[2] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # B matrix\r\n\u001b[?2004l\r\u001b[?2004h>     B = np.zeros((num_buses, num_buses))\r\n\u001b[?2004l\r\u001b[?2004h>     for i, br in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h>         f = bus_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h>         t = bus_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h>         x = br[3]\r\n\u001b[?2004l\r\u001b[?2004h>         if br[10] > 0: # status\r\n\u001b[?2004l\r\u001b[?2004h>             b_val = 1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h>             B[f, f] += b_val\r\n\u001b[?2004l\r\u001b[?2004h>             B[t, t] += b_val\r\n\u001b[?2004l\r\u001b[?2004h>             B[f, t] -= b_val\r\n\u001b[?2004l\r\u001b[?2004h>             B[t, f] -= b_val\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Variables: [Pg (num_gens), R (num_gens), theta (num_buses)]\r\n\u001b[?2004l\r\u001b[?2004h>     n_vars = num_gens + num_gens + num_buses\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Objective: minimize c1 * Pg\r\n\u001b[?2004l\r\u001b[?2004h>     c = np.zeros(n_vars)\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[155.569554, "i", "a = 0\n    ref_row = np.zeros(n_vars)\n    ref_row[num_gens + num_gens + 0] = 1.0\n    A_eq = np.vstack([A_eq, ref_row])\n    b_eq = np.append(b_eq, 0.0)\n\n    # Inequality constraints: G * x <= h\n    G = []\n    h = []\n\n    # Pg limits: Pg + R <= Pmax, Pg >= Pmin\n    for i in range(num_gens):\n        # Pg + R <= Pmax\n        row = np.zeros(n_vars)\n        row[i] = 1.0\n        row[num_gens + i] = 1.0\n        G.append(row)\n        h.append(gens[i][8] / baseMVA)\n        # -Pg <= -Pmin\n        row = np.zeros(n_vars)\n        row[i] = -1.0\n        G.append(row)\n        h.append(-gens[i][9] / baseMVA)\n    \n    # Reserve limits: R <= Rmax, R >= 0\n    for i in range(num_gens):\n        # R <= Rmax\n        row = np.zeros(n_vars)\n        row[num_gens + i] = 1.0\n        G.append(row)\n        h.append(res_cap[i] / baseMVA)\n        # -R <= 0\n        row = np.zeros(n_vars)\n        row[num_gens + i] = -1.0\n        G.append(row)\n        h.append(0.0)\n\n    # Total reserve requirement: sum(R) >= Rreq => -sum(R) <= -Rreq\n    row = np.zeros(n_vars)\n    for i in range(num_gens):\n        row[num_gens + i] = -1.0\n    G.append(row)\n    h.append(-res_req / baseMVA)\n\n    # Branch flow limits: |1/x * (theta_f - theta_t)| <= Limit\n    for i, br in enumerate(branches):\n        f = bus_map[int(br[0])]\n        t = bus_map[int(br[1])]\n        x = br[3]\n        limit = br[5] / baseMVA\n        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n            limit *= 1.2\n        \n        if br[10] > 0:\n            # (1/x) * (theta_f - theta_t) <= limit\n            row = np.zeros(n_vars)\n            row[num_gens + num_gens + f] = 1.0 / x\n            row[num_gens + num_gens + t] = -1.0 / x\n            G.append(row)\n            h.append(limit)\n            # -(1/x) * (theta_f - theta_t) <= limit\n            row = np.zeros(n_vars)\n            row[num_gens + num_gens + f] = -1.0 / x\n            row[num_gens + num_gens + t] = 1.0 / x\n            G.append(row)\n            h.append(limit)\n\n    G = np.array(G)\n    h = np.array(h)\n\n    # Solve LP\n    sol = solvers.lp(matrix(c), matrix(G), matrix(h), matrix(A_eq), matrix(b_eq))\n    \n    if sol['status'] != 'optimal':\n        return None\n\n    x_sol = np.array(sol['x']).flatten()\n    Pg = x_sol[:num_gens] * baseMVA\n    R = x_sol[num_gens:2*num_gens] * baseMVA\n    theta = x_sol[2*num_gens:]\n    \n    # LMPs are duals of power balance constraints\n    # In cvxopt, sol['y'] are duals for equality constraints\n    # The first num_buses equality constraints are power balance\n    # Note: cvxopt duals 'y' might have a sign difference depending on formulation\n    # Objective is min c'x s.t. Gx <= h, Ax = b. \n    # LMPs are duals of Ax = b. \n    # Looking at the results, we'll see if the sign is correct.\n    LMPs = np.array(sol['y']).flatten()[:num_buses] / baseMVA\n    # Reserve MCP is dual of the reserve requirement constraint\n    # It's one of the inequality constraints. \n    # In cvxopt, sol['z'] are duals for Gx <= h\n    # Reserve constraint was -sum(R) <= -Rreq, which was at index (2*num_gens + 2*num_gens)\n    res_mcp_idx = 4 * num_gens\n    res_mcp = np.array(sol['z']).flatten()[res_mcp_idx] / baseMVA\n\n    total_cost = sol['primal objective']\n    \n    # Binding lines\n    binding_lines = []\n    for i, br in enumerate(branches):\n        f_idx = bus_map[int(br[0])]\n        t_idx = bus_map[int(br[1])]\n        x = br[3]\n        limit = br[5]\n        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n            limit *= 1.2\n        \n        flow = (1.0 / x) * (theta[f_idx] - theta[t_idx]) * baseMVA\n        if abs(flow) >= 0.99 * limit:\n            binding_lines.append({\"from\": int(br[0]), \"to\": int(br[1]), \"flow_MW\": float(flow), \"limit_MW\": float(limit)})\n\n    return {\n        \"total_cost\": float(total_cost),\n        \"Pg\": Pg.tolist(),\n        \"R\": R.tolist(),\n        \"LMPs\": LMPs.tolist(),\n        \"res_mcp\": float(res_mcp),\n        \"binding_lines"]
[155.569621, "o", "        c[i] = gencost[i][5] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Equality constraints: B * theta - sum(Pg) = -Pd\r\n\u001b[?2004l\r\u001b[?2004h>     # A_eq * x = b_eq\r\n\u001b[?2004l\r\u001b[?2004h"]
[155.569696, "i", "\": binding_lines\n    }\n\nwith open('network.json') as f:\n    network = json.load(f)\n\nbase_case = solve_dc_opf(network)\ncf_case = solve_dc_opf(network, line_relax=(64, 1501))\n\nbuses = network['bus']\nbus_ids = [int(b[0]) for b in buses]\n\n# Prepare report\nreport = {\n    \"base_case\": {\n        \"total_cost_dollars_per_hour\": base_case['total_cost'],\n        \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, base_case['LMPs'])],\n        \"reserve_mcp_dollars_per_MWh\": base_case['res_mcp'],\n        \"binding_lines\": base_case['binding_lines']\n    },\n    \"counterfactual\": {\n        \"total_cost_dollars_per_hour\": cf_case['total_cost'],\n        \"lmp_by_bus\": [{\"bus\": bid, \"lmp_dollars_per_MWh\": lmp} for bid, lmp in zip(bus_ids, cf_case['LMPs'])],\n        \"reserve_mcp_dollars_per_MWh\": cf_case['res_mcp'],\n        \"binding_lines\": cf_case['binding_lines']\n    }\n}\n\n# Impact analysis\nbase_lmps = np.array(base_case['LMPs'])\ncf_lmps = np.array(cf_case['LMPs'])\ndeltas = cf_lmps - base_lmps\n\n# Buses with largest LMP drop (most negative delta)\nsorted_indices = np.argsort(deltas)\ntop_3_indices = sorted_indices[:3]\n\nbuses_with_largest_lmp_drop = []\nfor idx in top_3_indices:\n    buses_with_largest_lmp_drop.append({\n        \"bus\": int(bus_ids[idx]),\n        \"base_lmp\": float(base_lmps[idx]),\n        \"cf_lmp\": float(cf_lmps[idx]),\n        \"delta\": float(deltas[idx])\n    })\n\nline_binding_in_cf = any(l['from'] in [64, 1501] and l['to'] in [64, 1501] for l in cf_case['binding_lines'])\n\nreport[\"impact_analysis\"] = {\n    \"cost_reduction_dollars_per_hour\": base_case['total_cost'] - cf_case['total_cost'],\n    \"buses_with_largest_lmp_drop\": buses_with_largest_lmp_drop,\n    \"congestion_relieved\": not line_binding_in_cf\n}\n\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\nEOF\npython3 solve_market.py\n"]
