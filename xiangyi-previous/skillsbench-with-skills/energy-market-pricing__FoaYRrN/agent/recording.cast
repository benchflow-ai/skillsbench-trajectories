[155.59789, "o", "\u001b[?2004h> "]
[155.598053, "o", "            row[num_gens + num_gens + t] = -1.0 / x\r\n\u001b[?2004l\r"]
[155.598121, "o", "\u001b[?2004h> "]
[155.598264, "o", "            G.append(row)\r\n\u001b[?2004l\r"]
[155.59833, "o", "\u001b[?2004h> "]
[155.59849, "o", "            h.append(limit)\r\n\u001b[?2004l\r"]
[155.598553, "o", "\u001b[?2004h> "]
[155.598742, "o", "            # -(1/x) * (theta_f - theta_t) <= limit\r\n\u001b[?2004l\r"]
[155.598819, "o", "\u001b[?2004h> "]
[155.598946, "o", "            row = np.zeros(n_vars)\r\n\u001b[?2004l\r"]
[155.599018, "o", "\u001b[?2004h> "]
[155.599171, "o", "            row[num_gens + num_gens + f] = -1.0 / x\r\n\u001b[?2004l\r"]
[155.59924, "o", "\u001b[?2004h> "]
[155.599381, "o", "            row[num_gens + num_gens + t] = 1.0 / x\r\n\u001b[?2004l\r"]
[155.599451, "o", "\u001b[?2004h> "]
