[84.166245, "o", "Title nodejs-semver: Regular expression denial of service\r\nPrimaryURL https://avd.aquasec.com/nvd/cve-2022-25883\r\nCVSS keys ['ghsa', 'nvd', 'redhat']\r\nCVSS {'ghsa': {'V3Vector': 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H', 'V3Score': 7.5}, 'nvd': {'V3Vector': 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H', 'V3Score': 7.5}, 'redhat': {'V3Vector': 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H', 'V3Score': 7.5}}\r\n--- CVE-2026-23745\r\nPkg tar 6.1.11\r\nSeverity HIGH\r\nFixed 7.5.3\r\nTitle node-tar: tar: node-tar: Arbitrary file overwrite and symlink poisoning via unsanitized linkpaths in archives\r\nPrimaryURL https://avd.aquasec.com/nvd/cve-2026-23745\r\nCVSS keys ['redhat']\r\nCVSS {'redhat': {'V3Vector': 'CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:C/C:H/I:H/A:H', 'V3Score': 8.2}}\r\n--- CVE-2026-23950\r\nPkg tar 6.1.11\r\nSeverity HIGH\r\nFixed 7.5.4\r\nTitle node-tar: tar: node-tar: Arbitrary file overwrite via Unicode path collision race condition\r\nPrimaryURL https://avd.aquasec.com/nvd/cve-2026-23950\r\nCVSS keys ['ghsa', 'redhat']\r\nCVSS {'ghsa': {'V3Vector': 'CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:H/A:L', 'V3Score': 8.8}, 'redhat': {'V3Vector': 'CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:H/A:L', 'V3Score': 8.8}}\r\n"]
[84.168881, "o", "\u001b[?2004hroot@9e1f8a418973:~# "]
[98.201653, "i", "python3 - <<'PY'\nimport json, csv\nfrom pathlib import Path\n\nwith open('/root/trivy.json') as f:\n    data=json.load(f)\n\nrows=[]\nfor res in data.get('Results',[]):\n    for v in res.get('Vulnerabilities') or []:\n        if v.get('Severity') not in ('HIGH','CRITICAL'):\n            continue\n        cve=v.get('VulnerabilityID')\n        pkg=v.get('PkgName')\n        ver=v.get('InstalledVersion')\n        sev=v.get('Severity')\n        fixed=v.get('FixedVersion') or 'N/A'\n        title=v.get('Title') or v.get('Description','')\n        url=v.get('PrimaryURL') or ''\n        # CVSS score selection priority\n        cvss=v.get('CVSS') or {}\n        score=None\n        for source in ('nvd','ghsa','redhat'):\n            if source in cvss and cvss[source].get('V3Score') is not None:\n                score=cvss[source].get('V3Score')\n                break\n        rows.append([pkg, ver, cve, sev, score if score is not None else '', fixed, title, url])\n\nwith open('/root/security_audit.csv','w',newline='') as f:\n    writer=csv.writer(f)\n    writer.writerow(['Package','Version','CVE_ID','Severity','CVSS_Score','Fixed_Version','Title','Url'])\n    writer.writerows(rows)\n\nprint('Wrote', len(rows), 'rows')\nPY\n"]
