[102.498649, "o", "def split_text(text, max_length=4000):\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.498697, "o", "> "]
[102.498741, "o", "    # Split by sentences to avoid cutting words\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.498796, "o", "> "]
[102.498837, "o", "    sentences = text.replace('\\n', ' ').split('. ')\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.498892, "o", "> "]
[102.498937, "o", "    chunks = []\r\n\u001b[?2004l\r\u001b[?2004h>     current_chunk = \"\"\r\n\u001b[?2004l\r"]
[102.498995, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499036, "o", ">     for sentence in sentences:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499095, "o", "        # Add the period back\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499149, "o", "> "]
[102.499189, "o", "        sentence = sentence.strip() + \". \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499332, "o", "        if len(current_chunk) + len(sentence) > max_length:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499403, "o", "            chunks.append(current_chunk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499441, "o", "            current_chunk = sentence\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499496, "o", "> "]
[102.499536, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499583, "o", "            current_chunk += sentence\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[102.499636, "o", "\u001b[?2004h> "]
[102.499693, "o", "    if current_chunk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.499748, "o", "        chunks.append(current_chunk)\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499789, "o", ">     return chunks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499835, "o", "> audio_files = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.499889, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.49993, "o", "> for i, url in enumerate(urls):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.5, "o", "    print(f\"Processing {url}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.500062, "o", "    text = get_essay_text(url)\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.500116, "o", "> "]
[102.500164, "o", "    if not text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.50022, "o", "        print(f\"Skipping {url} (no text found)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.500266, "o", ">         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.50032, "o", "> "]
[102.50036, "o", "    print(f\"Found {len(text)} characters.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.500417, "o", "    chunks = split_text(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.50047, "o", "> "]
[102.500513, "o", "    print(f\"Split into {len(chunks)} chunks.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.500556, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.500605, "o", "    for j, chunk in enumerate(chunks):\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.500662, "o", "> "]
[102.500709, "o", "        if not chunk.strip(): continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.500761, "o", "        filename = f\"part_{i}_{j}.mp3\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.500815, "o", "> "]
[102.500914, "o", "        print(f\"Generating audio for chunk {j+1}/{len(chunks)} of essay {i+1}...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.50097, "o", ">         \r\n\u001b[?2004l\r"]
[102.501011, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.501075, "o", "            response = client.audio.speech.create(\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501132, "o", "> "]
[102.501175, "o", "                model=\"tts-1\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.50123, "o", "                voice=\"alloy\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501274, "o", ">                 input=chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.501327, "o", "            )\r\n\u001b[?2004l\r"]
[102.501368, "o", "\u001b[?2004h>             # Save to file\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501423, "o", "> "]
[102.501463, "o", "            with open(filename, 'wb') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.501527, "o", "                f.write(response.content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501579, "o", "> "]
[102.50162, "o", "            audio_files.append(filename)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.501676, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501722, "o", "> "]
[102.501772, "o", "            print(f\"Error generating audio: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.501829, "o", "\u001b[?2004h> "]
[102.501872, "o", "if not audio_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.501913, "o", "    print(\"No audio files generated.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.501968, "o", ">     exit(1)\r\n\u001b[?2004l\r"]
[102.502008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502055, "o", "# Create file list for ffmpeg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502096, "o", "list_filename = \"files.txt\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.502152, "o", "> "]
[102.502193, "o", "with open(list_filename, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502239, "o", "    for filename in audio_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502336, "o", "        f.write(f\"file '{os.path.abspath(filename)}'\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.502389, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502433, "o", "output_file = \"/root/audiobook.mp3\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502665, "o", "print(f\"Concatenating to {output_file}...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Use ffmpeg to concatenate\r\n\u001b[?2004l\r\u001b[?2004h> subprocess.run(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502858, "o", "    [\"ffmpeg\", \"-f\", \"concat\", \"-safe\", \"0\", \"-i\", list_filename, \"-c\", \"copy\", output_file, \"-y\"],\r\n\u001b[?2004l\r\u001b[?2004h>     check=True\r\n\u001b[?2004l\r"]
[102.502926, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502961, "o", "# Cleanup temporary files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.502998, "o", "for f in audio_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.503126, "o", "    if os.path.exists(f):\r\n\u001b[?2004l\r\u001b[?2004h>         os.remove(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.503162, "o", "if os.path.exists(list_filename):\r\n\u001b[?2004l\r"]
[102.503192, "o", "\u001b[?2004h> "]
[102.503324, "o", "    os.remove(list_filename)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Task complete!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.503409, "o", "EOF\r\n\u001b[?2004l\r"]
[102.504586, "o", "\u001b[?2004hroot@d5c91059a918:~# "]
[102.969411, "i", "./venv/bin/python create_audiobook.py\n"]
