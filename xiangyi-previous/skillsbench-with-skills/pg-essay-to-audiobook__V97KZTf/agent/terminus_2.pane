[?2004hroot@d5c91059a918:~# cat << 'EOF' > create_audiobook.py
[?2004l[?2004h> import os
[?2004l[?2004h> import requests
[?2004l[?2004h> from bs4 import BeautifulSoup
[?2004l[?2004h> from openai import OpenAI
[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> client = OpenAI()
[?2004l[?2004h> 
[?2004l[?2004h> urls = [
[?2004l[?2004h>     "https://paulgraham.com/ds.html",
[?2004l[?2004h>     "https://paulgraham.com/foundermode.html"
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def get_essay_text(url):
[?2004l[?2004h>     try:
[?2004l[?2004h>         response = requests.get(url)
[?2004l[?2004h>         response.raise_for_status()
[?2004l[?2004h>         soup = BeautifulSoup(response.content, 'html.parser')
[?2004l[?2004h>         # Paul Graham's essays are typically in <font face="verdana"> tags
[?2004l[?2004h>         fonts = soup.find_all('font', face='verdana')
[?2004l[?2004h>         if not fonts:
[?2004l[?2004h>             return ""
[?2004l[?2004h>         # Heuristic: The essay is likely the font tag with the most text
[?2004l[?2004h>         essay_font = max(fonts, key=lambda f: len(f.get_text()))
[?2004l[?2004h>         text = essay_font.get_text()
[?2004l[?2004h>         # Basic cleaning
[?2004l[?2004h>         return text.strip()
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error fetching {url}: {e}")
[?2004l[?2004h>         return ""
[?2004l[?2004h> 
[?2004l[?2004h> def split_text(text, max_length=4000):
[?2004l[?2004h>     # Split by sentences to avoid cutting words
[?2004l[?2004h>     sentences = text.replace('\n', ' ').split('. ')
[?2004l[?2004h>     chunks = []
[?2004l[?2004h>     current_chunk = ""
[?2004l[?2004h>     
[?2004l[?2004h>     for sentence in sentences:
[?2004l[?2004h>         # Add the period back
[?2004l[?2004h>         sentence = sentence.strip() + ". "
[?2004l[?2004h>         if len(current_chunk) + len(sentence) > max_length:
[?2004l[?2004h>             chunks.append(current_chunk)
[?2004l[?2004h>             current_chunk = sentence
[?2004l[?2004h>         else:
[?2004l[?2004h>             current_chunk += sentence
[?2004l[?2004h>             
[?2004l[?2004h>     if current_chunk:
[?2004l[?2004h>         chunks.append(current_chunk)
[?2004l[?2004h>     return chunks
[?2004l[?2004h> 
[?2004l[?2004h> audio_files = []
[?2004l[?2004h> 
[?2004l[?2004h> for i, url in enumerate(urls):
[?2004l[?2004h>     print(f"Processing {url}...")
[?2004l[?2004h>     text = get_essay_text(url)
[?2004l[?2004h>     if not text:
[?2004l[?2004h>         print(f"Skipping {url} (no text found)")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     print(f"Found {len(text)} characters.")
[?2004l[?2004h>     chunks = split_text(text)
[?2004l[?2004h>     print(f"Split into {len(chunks)} chunks.")
[?2004l[?2004h>     
[?2004l[?2004h>     for j, chunk in enumerate(chunks):
[?2004l[?2004h>         if not chunk.strip(): continue
[?2004l[?2004h>         filename = f"part_{i}_{j}.mp3"
[?2004l[?2004h>         print(f"Generating audio for chunk {j+1}/{len(chunks)} of essay {i+1}...")
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             response = client.audio.speech.create(
[?2004l[?2004h>                 model="tts-1",
[?2004l[?2004h>                 voice="alloy",
[?2004l[?2004h>                 input=chunk
[?2004l[?2004h>             )
[?2004l[?2004h>             # Save to file
[?2004l[?2004h>             with open(filename, 'wb') as f:
[?2004l[?2004h>                 f.write(response.content)
[?2004l[?2004h>             audio_files.append(filename)
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"Error generating audio: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> if not audio_files:
[?2004l[?2004h>     print("No audio files generated.")
[?2004l[?2004h>     exit(1)
[?2004l[?2004h> 
[?2004l[?2004h> # Create file list for ffmpeg
[?2004l[?2004h> list_filename = "files.txt"
[?2004l[?2004h> with open(list_filename, "w") as f:
[?2004l[?2004h>     for filename in audio_files:
[?2004l[?2004h>         f.write(f"file '{os.path.abspath(filename)}'\n")
[?2004l[?2004h> 
[?2004l[?2004h> output_file = "/root/audiobook.mp3"
[?2004l[?2004h> print(f"Concatenating to {output_file}...")
[?2004l[?2004h> 
[?2004l[?2004h> # Use ffmpeg to concatenate
[?2004l[?2004h> subprocess.run(
[?2004l[?2004h>     ["ffmpeg", "-f", "concat", "-safe", "0", "-i", list_filename, "-c", "copy", output_file, "-y"],
[?2004l[?2004h>     check=True
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Cleanup temporary files
[?2004l[?2004h> for f in audio_files:
[?2004l[?2004h>     if os.path.exists(f):
[?2004l[?2004h>         os.remove(f)
