[805.666771, "o", "Usage: pdftext [OPTIONS] PDF_PATH\r\n\r\n  Extract plain text or JSON from PDF.\r\n\r\nOptions:\r\n  --out_path PATH    Path to the output text file, defaults to stdout\r\n  --json             Output json instead of plain text\r\n  --sort             Attempt to sort the text by reading order\r\n  --keep_hyphens     Keep hyphens in words\r\n  --page_range TEXT  Page numbers or ranges to extract, comma separated like\r\n                     1,2-4,10\r\n  --flatten_pdf      Flatten form fields and annotations into page contents\r\n  --keep_chars       Keep character level information\r\n  --workers INTEGER  Number of workers to use for parallel processing\r\n  --help             Show this message and exit.\r\n"]
