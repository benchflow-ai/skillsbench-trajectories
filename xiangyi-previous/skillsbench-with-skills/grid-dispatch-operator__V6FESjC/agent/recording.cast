[1271.19064, "o", "\u001b[?2004h> "]
[1271.190812, "o", "    B_bus = coo_matrix((b_bus_vals, (b_bus_rows, b_bus_cols)), shape=(nb, nb))\r\n\u001b[?2004l\rls\u001b[?2004h> \r\n\u001b[?2004l\r"]
