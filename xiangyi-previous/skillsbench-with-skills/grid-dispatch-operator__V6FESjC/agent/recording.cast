[186.293355, "i", "cat << 'EOF' > solve_dispatch.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize, LinearConstraint, Bounds\nfrom scipy.sparse import coo_matrix, csr_matrix, vstack, eye\nimport time\n\ndef solve():\n    print(\"Loading data...\")\n    with open('network.json') as f:\n        data = json.load(f)\n\n    # Extract data\n    bus = np.array(data['bus'])\n    gen = np.array(data['gen'])\n    branch = np.array(data['branch'])\n    gencost = np.array(data['gencost'])\n    reserve_cap = np.array(data['reserve_capacity'])\n    reserve_req = data['reserve_requirement']\n    baseMVA = data['baseMVA']\n\n    # Dimensions\n    nb = bus.shape[0]\n    ng = gen.shape[0]\n    nl = branch.shape[0]\n\n    # Column indices\n    BUS_I, BUS_TYPE, PD, QD, GS, BS, BUS_AREA, VM, VA, BASE_KV, ZONE, VMAX, VMIN = range(13)\n    GEN_BUS, PG, QG, QMAX, QMIN, VG, MBASE, GEN_STATUS, PMAX, PMIN = range(10)\n    F_BUS, T_BUS, BR_R, BR_X, BR_B, RATE_A, RATE_B, RATE_C, TAP, SHIFT, BR_STATUS, ANGMIN, ANGMAX = range(13)\n    MODEL, STARTUP, SHUTDOWN, NCOST, COST0, COST1, COST2 = range(7) # Assuming NCOST=3 quadratic\n\n    # Mappings\n    bus_id_to_idx = {int(b_id): i for i, b_id in enumerate(bus[:, BUS_I])}\n    ref_bus_idx = np.where(bus[:, BUS_TYPE] == 3)[0][0]\n\n    # Build B matrices\n    print(\"Building matrices...\")\n    stat = branch[:, BR_STATUS].astype(bool)\n    f = np.array([bus_id_to_idx[int(x)] for x in branch[stat, F_BUS]])\n    t = np.array([bus_id_to_idx[int(x)] for x in branch[stat, T_BUS]])\n    x = branch[stat, BR_X]\n    b = 1.0 / x\n    # Tap ratio (ignore phase shift for simple DC)\n    tap = branch[stat, TAP]\n    tap[tap == 0] = 1.0\n    b = b / tap # Approximation\n\n    # Branch admittance matrix (Flow = B_branch * theta)\n    # Flow_ij = (theta_i - theta_j) / x_ij\n    # We need to map this to sparse matrix\n    # Rows: active branches, Cols: buses\n    nl_active = np.sum(stat)\n    \n    # B_branch construction\n    # Flow = b * (theta_f - theta_t)\n    vals = np.concatenate([b, -b])\n    rows = np.concatenate([np.arange(nl_active), np.arange(nl_active)])\n    cols = np.concatenate([f, t])\n    B_branch = coo_matrix((vals, (rows, cols)), shape=(nl_active, nb))\n\n    # B_bus construction\n    # P_inj = B_bus * theta\n    # B_bus_ii = sum(b_ik)\n    # B_bus_ij = -b_ij\n    \n    # Off-diagonals\n    Y_off = -b\n    # Diagonals\n    Y_diag_f = b\n    Y_diag_t = b\n    \n    # Aggregate for B_bus\n    # contributions from each branch to f and t\n    # (f, f) += b, (t, t) += b, (f, t) -= b, (t, f) -= b\n    b_bus_rows = np.concatenate([f, t, f, t])\n    b_bus_cols = np.concatenate([f, t, t, f])\n    b_bus_vals = np.concatenate([b, b, -b, -b])\n    B_bus = coo_matrix((b_bus_vals, (b_bus_rows, b_bus_cols)), shape=(nb, nb))\n\n    # Optimization Variables: [Pg (ng), Rg (ng), Theta (nb)]\n    # Total size = 2*ng + nb\n    n_vars = 2 * ng + nb\n    \n    # Indices\n    idx_pg = slice(0, ng)\n    idx_rg = slice(ng, 2*ng)\n    idx_th = slice(2*ng, n_vars)\n\n    # 1. Objective Function\n    # Minimize Sum(Cost(Pg))\n    # Cost is c2*P^2 + c1*P + c0\n    # gencost cols: MODEL, STARTUP, SHUTDOWN, NCOST, c2, c1, c0\n    # Note: gencost coefficients are [c2, c1, c0] if NCOST=3\n    # We need to check NCOST. Assuming 3 for quadratic.\n    \n    c2 = np.zeros(ng)\n    c1 = np.zeros(ng)\n    c0 = np.zeros(ng)\n    \n    for i in range(ng):\n        gc = gencost[i]\n        if gc[MODEL] == 2: # Polynomial\n            nc = int(gc[NCOST])\n            if nc == 3:\n                c2[i] = gc[4]\n                c1[i] = gc[5]\n                c0[i] = gc[6]\n            elif nc == 2:\n                c1[i] = gc[4]\n                c0[i] = gc[5]\n    \n    def objective(x):\n        pg = x[idx_pg]\n        return np.sum(c2 * pg**2 + c1 * pg + c0)\n\n    def jacobian(x):\n        pg = x[idx_pg]\n        grad = np.zeros(n_vars)\n        grad[idx_pg] = 2 * c2 * pg + c1\n        return grad\n\n    # 2. Constraints\n    constraints = []\n\n    # A. Equality: Power Balance\n    # P_gen - P_load = B_bus * theta\n    # sum(Pg_at_bus_i) - Pd_i = (B_bus * theta)_i\n    # Rearrange: sum(Pg) - B_bus * theta = Pd\n    \n    # Map gens to buses\n    C_g = coo_matrix((np.ones"]
[186.293512, "i", "(ng), (gen[:, GEN_BUS].astype(int)-1, np.arange(ng))), shape=(nb, ng))\n    # Note: gen bus is 1-indexed in file, convert to 0-indexed using map\n    # Wait, simple subtraction might be wrong if bus numbering is non-consecutive.\n    # Use bus_id_to_idx mapping.\n    gen_bus_indices = [bus_id_to_idx[int(b_id)] for b_id in gen[:, GEN_BUS]]\n    C_g = coo_matrix((np.ones(ng), (gen_bus_indices, np.arange(ng))), shape=(nb, ng))\n\n    # Construct A_eq for: [Pg, Rg, Th]\n    # [C_g, 0, -B_bus] * x = Pd\n    \n    # Pd vector\n    Pd = bus[:, PD]\n    \n    # Combine matrices\n    # C_g is (nb, ng)\n    # Zero block is (nb, ng)\n    # -B_bus is (nb, nb)\n    \n    # A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus]) # This is dense in hstack if not careful\n    # Build manually using coo/csr\n    \n    # We need to use LinearConstraint\n    # A_eq needs to be (nb, n_vars)\n    \n    # Parts:\n    # 1. Pg part: C_g\n    # 2. Rg part: Zeros\n    # 3. Theta part: -B_bus\n    \n    # Stack these\n    from scipy.sparse import hstack\n    A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus])\n    \n    constraints.append(LinearConstraint(A_eq, Pd, Pd))\n\n    # B. Inequality: Reserve Req\n    # sum(Rg) >= Req\n    # [0, 1...1, 0] * x >= Req\n    A_res = np.zeros(n_vars)\n    A_res[idx_rg] = 1.0\n    constraints.append(LinearConstraint(A_res.reshape(1, -1), [reserve_req], [np.inf]))\n\n    # C. Inequality: Gen Capacity Coupling\n    # Pg + Rg <= Pmax\n    # [I, I, 0] * x <= Pmax\n    # I is identity (ng, ng)\n    I_ng = eye(ng)\n    A_cap = hstack([I_ng, I_ng, csr_matrix((ng, nb))])\n    constraints.append(LinearConstraint(A_cap, -np.inf, gen[:, PMAX]))\n\n    # D. Inequality: Line Flow Limits\n    # -Limit <= B_branch * theta <= Limit\n    # [0, 0, B_branch] * x\n    A_flow = hstack([csr_matrix((nl_active, 2*ng)), B_branch])\n    limits = branch[stat, RATE_A]\n    # Handle limits=0 (unlimited)\n    limits[limits == 0] = 1e6 # Large number\n    constraints.append(LinearConstraint(A_flow, -limits, limits))\n\n    # E. Equality: Reference Bus Angle = 0\n    # [0, 0, ... 1 ... ] * x = 0\n    A_ref = np.zeros(n_vars)\n    A_ref[2*ng + ref_bus_idx] = 1.0\n    constraints.append(LinearConstraint(A_ref.reshape(1, -1), [0], [0]))\n\n    # 3. Bounds\n    # Pg: [Pmin, Pmax]\n    # Rg: [0, ReserveCap]\n    # Theta: [-inf, inf]\n    \n    lb = np.concatenate([gen[:, PMIN], np.zeros(ng), np.full(nb, -np.inf)])\n    ub = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\n    bounds = Bounds(lb, ub)\n\n    # Initial guess\n    x0 = np.zeros(n_vars)\n    x0[idx_pg] = (gen[:, PMIN] + gen[:, PMAX]) / 2\n    x0[idx_rg] = reserve_req / ng\n\n    print(f\"Solving optimization with {n_vars} variables...\")\n    res = minimize(objective, x0, jac=jacobian, bounds=bounds, constraints=constraints, method='SLSQP', options={'disp': True, 'maxiter': 200})\n\n    print(\"Optimization finished. Success:\", res.success)\n    print(\"Message:\", res.message)\n\n    # Extract results\n    pg_res = res.x[idx_pg]\n    rg_res = res.x[idx_rg]\n    theta_res = res.x[idx_th]\n\n    # Calculate outputs\n    total_cost = objective(res.x)\n    total_load = np.sum(bus[:, PD])\n    total_gen = np.sum(pg_res)\n    total_reserve = np.sum(rg_res)\n    \n    # Line flows\n    flows = B_branch.dot(theta_res)\n    loadings = np.abs(flows) / limits * 100\n    \n    # Top 3 loaded lines\n    # Map back to original indices\n    active_indices = np.where(stat)[0]\n    sorted_idx = np.argsort(loadings)[::-1]\n    \n    top_lines = []\n    for i in range(min(3, len(sorted_idx))):\n        idx = sorted_idx[i]\n        orig_idx = active_indices[idx]\n        top_lines.append({\n            \"from\": int(branch[orig_idx, F_BUS]),\n            \"to\": int(branch[orig_idx, T_BUS]),\n            \"loading_pct\": float(round(loadings[idx], 2))\n        })\n\n    # Operating Margin\n    # Uncommitted capacity = sum(Pmax - Pg - Rg)\n    # But only for ON generators? Usually margin is system wide.\n    # Assuming all gens in list are available or checking status.\n    # Using gen status\n    status = gen[:, GEN_STATUS] > 0\n    margin = np.sum(gen[status, PMAX] - pg_res[status] - rg_res[status])\n\n    # Generator Disp"]
[186.293594, "i", "atch List\n    gen_dispatch = []\n    for i in range(ng):\n        gen_dispatch.append({\n            \"id\": i+1,\n            \"bus\": int(gen[i, GEN_BUS]),\n            \"output_MW\": float(round(pg_res[i], 2)),\n            \"reserve_MW\": float(round(rg_res[i], 2)),\n            \"pmax_MW\": float(gen[i, PMAX])\n        })\n\n    report = {\n        \"generator_dispatch\": gen_dispatch,\n        \"totals\": {\n            \"cost_dollars_per_hour\": float(round(total_cost, 2)),\n            \"load_MW\": float(round(total_load, 2)),\n            \"generation_MW\": float(round(total_gen, 2)),\n            \"reserve_MW\": float(round(total_reserve, 2))\n        },\n        \"most_loaded_lines\": top_lines,\n        \"operating_margin_MW\": float(round(margin, 2))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Report generated.\")\n\nif __name__ == \"__main__\":\n    solve()\nEOF\n"]
[186.293749, "o", "cat << 'EOF' > solve_dispatch.py\r\n\u001b[?2004l\r"]
[186.293807, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[186.293835, "o", "\u001b[?2004h> "]
[186.293968, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.29409, "o", "from scipy.optimize import minimize, LinearConstraint, Bounds\r\n\u001b[?2004l\r"]
[186.294117, "o", "\u001b[?2004h> "]
[186.294299, "o", "from scipy.sparse import coo_matrix, csr_matrix, vstack, eye\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.29435, "o", "> "]
[186.2944, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[186.294443, "o", "def solve():\r\n\u001b[?2004l\rn"]
[186.294488, "o", "\u001b[?2004h> "]
[186.294571, "o", "    print(\"Loading data...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.294614, "o", "> "]
[186.294725, "o", "    with open('network.json') as f:\r\n\u001b[?2004l\r"]
[186.294748, "o", "\u001b[?2004h> "]
[186.294835, "o", "        data = json.load(f)\r\n\u001b[?2004l\r"]
[186.294876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r]\u001b[?2004h> "]
[186.294977, "o", "    # Extract data\r\n\u001b[?2004l\r"]
[186.295021, "o", "\u001b[?2004h> "]
[186.295142, "o", "    bus = np.array(data['bus'])\r\n\u001b[?2004l\r"]
[186.295166, "o", "\u001b[?2004h> "]
[186.295293, "o", "    gen = np.array(data['gen'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.295318, "o", "> "]
[186.295465, "o", "    branch = np.array(data['branch'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.295513, "o", "> "]
[186.295633, "o", "    gencost = np.array(data['gencost'])\r\n\u001b[?2004l\r"]
[186.295677, "o", "\u001b[?2004h> "]
[186.295844, "o", "    reserve_cap = np.array(data['reserve_capacity'])\r\n\u001b[?2004l\r"]
[186.295887, "o", "\u001b[?2004h> "]
[186.296032, "o", "    reserve_req = data['reserve_requirement']\r\n\u001b[?2004l\r"]
[186.296061, "o", "\u001b[?2004h> "]
[186.296186, "o", "    baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.296216, "o", "> \r\n\u001b[?2004l\rb\u001b[?2004h> "]
[186.296293, "o", "    # Dimensions\r\n\u001b[?2004l\r"]
[186.296346, "o", "\u001b[?2004h> "]
[186.296429, "o", "    nb = bus.shape[0]\r\n\u001b[?2004l\r"]
[186.296454, "o", "\u001b[?2004h> "]
[186.296554, "o", "    ng = gen.shape[0]\r\n\u001b[?2004l\r"]
[186.296581, "o", "\u001b[?2004h> "]
[186.296711, "o", "    nl = branch.shape[0]\r\n\u001b[?2004l\r"]
[186.296741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rb"]
[186.296793, "o", "\u001b[?2004h> "]
[186.296873, "o", "    # Column indices\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.296921, "o", "> "]
[186.297166, "o", "    BUS_I, BUS_TYPE, PD, QD, GS, BS, BUS_AREA, VM, VA, BASE_KV, ZONE, VMAX, VMIN = range(13)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.297186, "o", "> "]
[186.297399, "o", "    GEN_BUS, PG, QG, QMAX, QMIN, VG, MBASE, GEN_STATUS, PMAX, PMIN = range(10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.297421, "o", "> "]
[186.297723, "o", "    F_BUS, T_BUS, BR_R, BR_X, BR_B, RATE_A, RATE_B, RATE_C, TAP, SHIFT, BR_STATUS, ANGMIN, ANGMAX = range(13)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.297786, "o", "> "]
[186.298026, "o", "    MODEL, STARTUP, SHUTDOWN, NCOST, COST0, COST1, COST2 = range(7) # Assuming NCOST=3 quadratic\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.298049, "o", "> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[186.298121, "o", "    # Mappings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.29834, "o", "    bus_id_to_idx = {int(b_id): i for i, b_id in enumerate(bus[:, BUS_I])}\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.298367, "o", "> "]
[186.298514, "o", "    ref_bus_idx = np.where(bus[:, BUS_TYPE] == 3)[0][0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.298555, "o", "> \r\n\u001b[?2004l\rv\u001b[?2004h> "]
[186.298619, "o", "    # Build B matrices\r\n\u001b[?2004l\r"]
[186.298659, "o", "\u001b[?2004h> "]
[186.298779, "o", "    print(\"Building matrices...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.298828, "o", "> "]
[186.298929, "o", "    stat = branch[:, BR_STATUS].astype(bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.298952, "o", "> "]
[186.299142, "o", "    f = np.array([bus_id_to_idx[int(x)] for x in branch[stat, F_BUS]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.299355, "o", "    t = np.array([bus_id_to_idx[int(x)] for x in branch[stat, T_BUS]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.299381, "o", "> "]
[186.299437, "o", "    x = branch[stat, BR_X]\r\n\u001b[?2004l\r"]
[186.299478, "o", "\u001b[?2004h> "]
[186.299515, "o", "    b = 1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.29965, "o", "    # Tap ratio (ignore phase shift for simple DC)\r\n\u001b[?2004l\r"]
[186.299699, "o", "\u001b[?2004h> "]
[186.299749, "o", "    tap = branch[stat, TAP]\r\n\u001b[?2004l\ri\u001b[?2004h"]
[186.299773, "o", "> "]
[186.299842, "o", "    tap[tap == 0] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.299886, "o", "> "]
[186.299962, "o", "    b = b / tap # Approximation\r\n\u001b[?2004l\r"]
[186.300003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[186.300197, "o", "    # Branch admittance matrix (Flow = B_branch * theta)\r\n\u001b[?2004l\r"]
[186.300244, "o", "\u001b[?2004h> "]
[186.300324, "o", "    # Flow_ij = (theta_i - theta_j) / x_ij\r\n\u001b[?2004l\r"]
[186.300375, "o", "\u001b[?2004h> "]
[186.300475, "o", "    # We need to map this to sparse matrix\r\n\u001b[?2004l\r"]
[186.3005, "o", "\u001b[?2004h> "]
[186.300613, "o", "    # Rows: active branches, Cols: buses\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.300638, "o", "> "]
[186.300752, "o", "    nl_active = np.sum(stat)\r\n\u001b[?2004l\r"]
[186.300777, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[186.300831, "o", "> "]
[186.3009, "o", "    # B_branch construction\r\n\u001b[?2004l\r"]
[186.300954, "o", "\u001b[?2004h> "]
[186.301062, "o", "    # Flow = b * (theta_f - theta_t)\r\n\u001b[?2004l\r"]
[186.301102, "o", "\u001b[?2004h> "]
[186.301196, "o", "    vals = np.concatenate([b, -b])\r\n\u001b[?2004l\r"]
[186.301241, "o", "\u001b[?2004h> "]
[186.301416, "o", "    rows = np.concatenate([np.arange(nl_active), np.arange(nl_active)])\r\n\u001b[?2004l\r"]
[186.301457, "o", "\u001b[?2004h> "]
[186.301529, "o", "    cols = np.concatenate([f, t])\r\n\u001b[?2004l\r"]
[186.301574, "o", "\u001b[?2004h> "]
[186.30173, "o", "    B_branch = coo_matrix((vals, (rows, cols)), shape=(nl_active, nb))\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.301769, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[186.301861, "o", "    # B_bus construction\r\n\u001b[?2004l\r"]
[186.301886, "o", "\u001b[?2004h> "]
[186.301994, "o", "    # P_inj = B_bus * theta\r\n\u001b[?2004l\r"]
[186.302037, "o", "\u001b[?2004h> "]
[186.302111, "o", "    # B_bus_ii = sum(b_ik)\r\n\u001b[?2004l\r"]
[186.302161, "o", "\u001b[?2004h> "]
[186.302251, "o", "    # B_bus_ij = -b_ij\r\n\u001b[?2004l\r"]
[186.302292, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[186.302338, "o", "\u001b[?2004h> "]
[186.302392, "o", "    # Off-diagonals\r\n\u001b[?2004l\r"]
[186.302434, "o", "\u001b[?2004h> "]
[186.302476, "o", "    Y_off = -b\r\n\u001b[?2004l\r"]
[186.302521, "o", "\u001b[?2004h> "]
[186.302592, "o", "    # Diagonals\r\n\u001b[?2004l\r"]
[186.302633, "o", "\u001b[?2004h> "]
[186.3027, "o", "    Y_diag_f = b\r\n\u001b[?2004l\r"]
[186.302751, "o", "\u001b[?2004h> "]
[186.302791, "o", "    Y_diag_t = b\r\n\u001b[?2004l\r"]
[186.302816, "o", "\u001b[?2004h> "]
[186.302867, "o", "    \r\n\u001b[?2004l\r"]
[186.302893, "o", "\u001b[?2004h> "]
[186.302977, "o", "    # Aggregate for B_bus\r\n\u001b[?2004l\r"]
[186.303028, "o", "\u001b[?2004h> "]
[186.303142, "o", "    # contributions from each branch to f and t\r\n\u001b[?2004l\r"]
[186.303197, "o", "\u001b[?2004h> "]
[186.303324, "o", "    # (f, f) += b, (t, t) += b, (f, t) -= b, (t, f) -= b\r\n\u001b[?2004l\r"]
[186.303368, "o", "\u001b[?2004h> "]
[186.303489, "o", "    b_bus_rows = np.concatenate([f, t, f, t])\r\n\u001b[?2004l\r"]
[186.303512, "o", "\u001b[?2004h> "]
[186.303639, "o", "    b_bus_cols = np.concatenate([f, t, t, f])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.303659, "o", "> "]
[186.303807, "o", "    b_bus_vals = np.concatenate([b, b, -b, -b])\r\n\u001b[?2004l\r"]
[186.303835, "o", "\u001b[?2004h> "]
[186.304093, "o", "    B_bus = coo_matrix((b_bus_vals, (b_bus_rows, b_bus_cols)), shape=(nb, nb))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.304119, "o", "b\u001b[?2004h> "]
[186.30431, "o", "    # Optimization Variables: [Pg (ng), Rg (ng), Theta (nb)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304364, "o", "> "]
[186.304405, "o", "    # Total size = 2*ng + nb\r\n\u001b[?2004l\r"]
[186.304449, "o", "\u001b[?2004h> "]
[186.30452, "o", "    n_vars = 2 * ng + nb\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.304562, "o", ">     \r\n\u001b[?2004l\r"]
[186.304586, "o", "\u001b[?2004h> "]
[186.304635, "o", "    # Indices\r\n\u001b[?2004l\r"]
[186.304677, "o", "\u001b[?2004h> "]
[186.304808, "o", "    idx_pg = slice(0, ng)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.304917, "o", "    idx_rg = slice(ng, 2*ng)\r\n\u001b[?2004l\r"]
[186.304944, "o", "\u001b[?2004h> "]
[186.305078, "o", "    idx_th = slice(2*ng, n_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.305102, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[186.305227, "o", "    # 1. Objective Function\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.305278, "o", "> "]
[186.305356, "o", "    # Minimize Sum(Cost(Pg))\r\n\u001b[?2004l\r"]
[186.305397, "o", "\u001b[?2004h> "]
[186.305527, "o", "    # Cost is c2*P^2 + c1*P + c0\r\n\u001b[?2004l\r"]
[186.305552, "o", "\u001b[?2004h> "]
[186.305733, "o", "    # gencost cols: MODEL, STARTUP, SHUTDOWN, NCOST, c2, c1, c0\r\n\u001b[?2004l\r"]
[186.305779, "o", "\u001b[?2004h> "]
[186.305961, "o", "    # Note: gencost coefficients are [c2, c1, c0] if NCOST=3\r\n\u001b[?2004l\r"]
[186.305987, "o", "\u001b[?2004h> "]
[186.306146, "o", "    # We need to check NCOST. Assuming 3 for quadratic.\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306187, "o", ">     \r\n\u001b[?2004l\r"]
[186.306235, "o", "\u001b[?2004h> "]
[186.306316, "o", "    c2 = np.zeros(ng)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306359, "o", "> "]
[186.306402, "o", "    c1 = np.zeros(ng)\r\n\u001b[?2004l\r"]
[186.306427, "o", "\u001b[?2004h> "]
[186.306503, "o", "    c0 = np.zeros(ng)\r\n\u001b[?2004l\r"]
[186.306528, "o", "\u001b[?2004h> "]
[186.306552, "o", "    \r\n\u001b[?2004l\r"]
[186.306578, "o", "\u001b[?2004h> "]
[186.306694, "o", "    for i in range(ng):\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.306719, "o", "> "]
[186.30679, "o", "        gc = gencost[i]\r\n\u001b[?2004l\r"]
[186.306843, "o", "\u001b[?2004h> "]
[186.306955, "o", "        if gc[MODEL] == 2: # Polynomial\r\n\u001b[?2004l\r"]
[186.30701, "o", "\u001b[?2004h> "]
[186.307105, "o", "            nc = int(gc[NCOST])\r\n\u001b[?2004l\r"]
[186.307156, "o", "\u001b[?2004h> "]
[186.307199, "o", "            if nc == 3:\r\n\u001b[?2004l\r"]
[186.30725, "o", "\u001b[?2004h> "]
[186.307328, "o", "                c2[i] = gc[4]\r\n\u001b[?2004l\r"]
[186.307368, "o", "\u001b[?2004h> "]
[186.307474, "o", "                c1[i] = gc[5]\r\n\u001b[?2004l\r"]
[186.307514, "o", "\u001b[?2004h> "]
[186.307589, "o", "                c0[i] = gc[6]\r\n\u001b[?2004l\r"]
[186.307638, "o", "\u001b[?2004h> "]
[186.307684, "o", "            elif nc == 2:\r\n\u001b[?2004l\r"]
[186.307727, "o", "\u001b[?2004h> "]
[186.307797, "o", "                c1[i] = gc[4]\r\n\u001b[?2004l\r"]
[186.307849, "o", "\u001b[?2004h> "]
[186.307912, "o", "                c0[i] = gc[5]\r\n\u001b[?2004l\r"]
[186.307936, "o", "\u001b[?2004h> "]
[186.307992, "o", "    \r\n\u001b[?2004l\r(b\u001b[?2004h> "]
[186.308035, "o", "    def objective(x):\r\n\u001b[?2004l\r"]
[186.308059, "o", "\u001b[?2004h> "]
[186.308134, "o", "        pg = x[idx_pg]\r\n\u001b[?2004l\r"]
[186.308161, "o", "\u001b[?2004h> "]
[186.30829, "o", "        return np.sum(c2 * pg**2 + c1 * pg + c0)\r\n\u001b[?2004l\r"]
[186.308314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[186.308369, "o", "    def jacobian(x):\r\n\u001b[?2004l\rad\u001b[?2004h"]
[186.308397, "o", "> "]
[186.30846, "o", "        pg = x[idx_pg]\r\n\u001b[?2004l\r"]
[186.308503, "o", "\u001b[?2004h> "]
[186.308582, "o", "        grad = np.zeros(n_vars)\r\n\u001b[?2004l\r"]
[186.308609, "o", "\u001b[?2004h> "]
[186.308741, "o", "        grad[idx_pg] = 2 * c2 * pg + c1\r\n\u001b[?2004l\r"]
[186.308792, "o", "\u001b[?2004h> "]
[186.308821, "o", "        return grad\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[186.308871, "o", "\u001b[?2004h> "]
[186.308931, "o", "    # 2. Constraints\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.309002, "o", "> "]
[186.30903, "o", "    constraints = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rw"]
[186.309092, "o", "\u001b[?2004h> "]
[186.309151, "o", "    # A. Equality: Power Balance\r\n\u001b[?2004l\r"]
[186.309175, "o", "\u001b[?2004h> "]
[186.309276, "o", "    # P_gen - P_load = B_bus * theta\r\n\u001b[?2004l\r"]
[186.309302, "o", "\u001b[?2004h> "]
[186.309423, "o", "    # sum(Pg_at_bus_i) - Pd_i = (B_bus * theta)_i\r\n\u001b[?2004l\r"]
[186.309468, "o", "\u001b[?2004h> "]
[186.309597, "o", "    # Rearrange: sum(Pg) - B_bus * theta = Pd\r\n\u001b[?2004l\r"]
[186.309649, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[186.309688, "o", "> "]
[186.309737, "o", "    # Map gens to buses\r\n\u001b[?2004l\r"]
[186.309777, "o", "\u001b[?2004h> "]
[186.310042, "o", "    C_g = coo_matrix((np.ones(ng), (gen[:, GEN_BUS].astype(int)-1, np.arange(ng))), shape=(nb, ng))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310268, "o", "    # Note: gen bus is 1-indexed in file, convert to 0-indexed using map\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310563, "o", "    # Wait, simple subtraction might be wrong if bus numbering is non-consecutive.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.310636, "o", "    # Use bus_id_to_idx mapping.\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.310691, "o", "> "]
[186.310878, "o", "    gen_bus_indices = [bus_id_to_idx[int(b_id)] for b_id in gen[:, GEN_BUS]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.310905, "o", "> "]
[186.311215, "o", "    C_g = coo_matrix((np.ones(ng), (gen_bus_indices, np.arange(ng))), shape=(nb, ng))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[186.311344, "o", "    # Construct A_eq for: [Pg, Rg, Th]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.311401, "o", "> "]
[186.311442, "o", "    # [C_g, 0, -B_bus] * x = Pd\r\n\u001b[?2004l\r"]
[186.311466, "o", "\u001b[?2004h> "]
[186.311517, "o", "    \r\n\u001b[?2004l\r"]
[186.311545, "o", "\u001b[?2004h> "]
[186.311617, "o", "    # Pd vector\r\n\u001b[?2004l\r \u001b[?2004h> "]
[186.311688, "o", "    Pd = bus[:, PD]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[186.311731, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[186.311794, "o", "    # Combine matrices\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.311841, "o", "> "]
[186.311885, "o", "    # C_g is (nb, ng)\r\n\u001b[?2004l\r"]
[186.31195, "o", "\u001b[?2004h> "]
[186.311996, "o", "    # Zero block is (nb, ng)\r\n\u001b[?2004l\r"]
[186.312021, "o", "\u001b[?2004h> "]
[186.312089, "o", "    # -B_bus is (nb, nb)\r\n\u001b[?2004l\r"]
[186.312117, "o", "\u001b[?2004h> "]
[186.312156, "o", "    \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[186.312438, "o", "    # A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus]) # This is dense in hstack if not careful\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312478, "o", "    # Build manually using coo/csr\r\n\u001b[?2004l\r"]
[186.312558, "o", "\u001b[?2004h> "]
[186.312585, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312709, "o", "    # We need to use LinearConstraint\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.312735, "o", "> "]
[186.312865, "o", "    # A_eq needs to be (nb, n_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.312926, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.312979, "o", "    # Parts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.313031, "o", "> "]
[186.31308, "o", "    # 1. Pg part: C_g\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.31312, "o", "> "]
[186.313149, "o", "    # 2. Rg part: Zeros\r\n\u001b[?2004l\r"]
[186.313199, "o", "\u001b[?2004h> "]
[186.313239, "o", "    # 3. Theta part: -B_bus\r\n\u001b[?2004l\r"]
[186.313299, "o", "\u001b[?2004h>     "]
[186.313348, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.313398, "o", "    # Stack these\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.313451, "o", "    from scipy.sparse import hstack\r\n\u001b[?2004l\r"]
[186.313501, "o", "\u001b[?2004h> "]
[186.313618, "o", "    A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.313661, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.313764, "o", "    constraints.append(LinearConstraint(A_eq, Pd, Pd))\r\n\u001b[?2004l\r"]
[186.313816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.313859, "o", "    # B. Inequality: Reserve Req\r\n\u001b[?2004l\r"]
[186.31391, "o", "\u001b[?2004h> "]
[186.313957, "o", "    # sum(Rg) >= Req\r\n\u001b[?2004l\r"]
[186.313996, "o", "\u001b[?2004h> "]
[186.314048, "o", "    # [0, 1...1, 0] * x >= Req\r\n\u001b[?2004l\r"]
[186.314097, "o", "\u001b[?2004h> "]
[186.314138, "o", "    A_res = np.zeros(n_vars)\r\n\u001b[?2004l\r"]
[186.31418, "o", "\u001b[?2004h> "]
[186.314226, "o", "    A_res[idx_rg] = 1.0\r\n\u001b[?2004l\r"]
[186.31427, "o", "\u001b[?2004h> "]
[186.314431, "o", "    constraints.append(LinearConstraint(A_res.reshape(1, -1), [reserve_req], [np.inf]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.314482, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.314542, "o", "    # C. Inequality: Gen Capacity Coupling\r\n\u001b[?2004l\r"]
[186.314594, "o", "\u001b[?2004h> "]
[186.314632, "o", "    # Pg + Rg <= Pmax\r\n\u001b[?2004l\r"]
[186.314685, "o", "\u001b[?2004h> "]
[186.314722, "o", "    # [I, I, 0] * x <= Pmax\r\n\u001b[?2004l\r"]
[186.314765, "o", "\u001b[?2004h> "]
[186.314816, "o", "    # I is identity (ng, ng)\r\n\u001b[?2004l\r"]
[186.314867, "o", "\u001b[?2004h> "]
[186.314919, "o", "    I_ng = eye(ng)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.315041, "o", "    A_cap = hstack([I_ng, I_ng, csr_matrix((ng, nb))])\r\n\u001b[?2004l\r"]
[186.315085, "o", "\u001b[?2004h> "]
[186.315195, "o", "    constraints.append(LinearConstraint(A_cap, -np.inf, gen[:, PMAX]))\r\n\u001b[?2004l\r"]
[186.315246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.315311, "o", "    # D. Inequality: Line Flow Limits\r\n\u001b[?2004l\r"]
[186.315356, "o", "\u001b[?2004h> "]
[186.315421, "o", "    # -Limit <= B_branch * theta <= Limit\r\n\u001b[?2004l\r"]
[186.315465, "o", "\u001b[?2004h> "]
[186.315511, "o", "    # [0, 0, B_branch] * x\r\n\u001b[?2004l\r"]
[186.315558, "o", "\u001b[?2004h> "]
[186.315668, "o", "    A_flow = hstack([csr_matrix((nl_active, 2*ng)), B_branch])\r\n\u001b[?2004l\r"]
[186.315712, "o", "\u001b[?2004h> "]
[186.315752, "o", "    limits = branch[stat, RATE_A]\r\n\u001b[?2004l\r"]
[186.315795, "o", "\u001b[?2004h> "]
[186.315861, "o", "    # Handle limits=0 (unlimited)\r\n\u001b[?2004l\r"]
[186.315961, "o", "\u001b[?2004h> "]
[186.31605, "o", "    limits[limits == 0] = 1e6 # Large number\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.316111, "o", "    constraints.append(LinearConstraint(A_flow, -limits, limits))\r\n\u001b[?2004l\r"]
[186.316137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.316199, "o", "\u001b[?2004h> "]
[186.31627, "o", "    # E. Equality: Reference Bus Angle = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.316324, "o", "> "]
[186.316375, "o", "    # [0, 0, ... 1 ... ] * x = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.316418, "o", "> "]
[186.316464, "o", "    A_ref = np.zeros(n_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.31651, "o", "> "]
[186.31656, "o", "    A_ref[2*ng + ref_bus_idx] = 1.0\r\n\u001b[?2004l\r"]
[186.316605, "o", "\u001b[?2004h> "]
[186.327663, "o", "    constraints.append(LinearConstraint(A_ref.reshape(1, -1), [0], [0]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 3. Bounds\r\n\u001b[?2004l\r\u001b[?2004h>     # Pg: [Pmin, Pmax]\r\n\u001b[?2004l\r\u001b[?2004h>     # Rg: [0, ReserveCap]\r\n\u001b[?2004l\r\u001b[?2004h>     # Theta: [-inf, inf]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     lb = np.concatenate([gen[:, PMIN], np.zeros(ng), np.full(nb, -np.inf)])\r\n\u001b[?2004l\r\u001b[?2004h>     ub = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\r\n\u001b[?2004l\r\u001b[?2004h>     bounds = Bounds(lb, ub)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Initial guess\r\n\u001b[?2004l\r\u001b[?2004h>     x0 = np.zeros(n_vars)\r\n\u001b[?2004l\r\u001b[?2004h>     x0[idx_pg] = (gen[:, PMIN] + gen[:, PMAX]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>     x0[idx_rg] = reserve_req / ng\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Solving optimization with {n_vars} variables...\")\r\n\u001b[?2004l\r\u001b[?2004h>     res = minimize(objective, x0, jac=jacobian, bounds=bounds, constraints=constraints, method='SLSQP', options={'disp': True, 'maxiter': 200})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Optimization finished. Success:\", res.success)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Message:\", res.message)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Extract results\r\n\u001b[?2004l\r\u001b[?2004h>     pg_res = res.x[idx_pg]\r\n\u001b[?2004l\r\u001b[?2004h>     rg_res = res.x[idx_rg]\r\n\u001b[?2004l\r\u001b[?2004h>     theta_res = res.x[idx_th]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Calculate outputs\r\n\u001b[?2004l\r\u001b[?2004h>     total_cost = objective(res.x)\r\n\u001b[?2004l\r\u001b[?2004h>     total_load = np.sum(bus[:, PD])\r\n\u001b[?2004l\r\u001b[?2004h>     total_gen = np.sum(pg_res)\r\n\u001b[?2004l\r\u001b[?2004h>     total_reserve = np.sum(rg_res)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Line flows\r\n\u001b[?2004l\r\u001b[?2004h>     flows = B_branch.dot(theta_res)\r\n\u001b[?2004l\r\u001b[?2004h>     loadings = np.abs(flows) / limits * 100\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Top 3 loaded lines\r\n\u001b[?2004l\r\u001b[?2004h>     # Map back to original indices\r\n\u001b[?2004l\r\u001b[?2004h>     active_indices = np.where(stat)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     sorted_idx = np.argsort(loadings)[::-1]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     top_lines = []\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(min(3, len(sorted_idx))):\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.330405, "o", "> "]
[186.330499, "o", "        idx = sorted_idx[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.330558, "o", "        orig_idx = active_indices[idx]\r\n\u001b[?2004l\r"]
[186.330605, "o", "\u001b[?2004h> "]
[186.330655, "o", "        top_lines.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.330776, "o", "            \"from\": int(branch[orig_idx, F_BUS]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.330831, "o", "> "]
[186.330882, "o", "            \"to\": int(branch[orig_idx, T_BUS]),\r\n\u001b[?2004l\r"]
[186.331019, "o", "\u001b[?2004h> "]
[186.331075, "o", "            \"loading_pct\": float(round(loadings[idx], 2))\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[186.331124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.331177, "o", "    # Operating Margin\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.331225, "o", "> "]
[186.331298, "o", "    # Uncommitted capacity = sum(Pmax - Pg - Rg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.331348, "o", "> "]
[186.33146, "o", "    # But only for ON generators? Usually margin is system wide.\r\n\u001b[?2004l\r"]
[186.331669, "o", "\u001b[?2004h>     # Assuming all gens in list are available or checking status.\r\n\u001b[?2004l\r\u001b[?2004h> "]
