[1271.185076, "o", "\u001b[?2004h> "]
[1271.185219, "o", "    BUS_I, BUS_TYPE, PD = 0, 1, 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.185299, "o", "    GEN_BUS, PG, PMAX, PMIN = 0, 1, 8, 9\r\n\u001b[?2004l\r"]
[1271.185392, "o", "\u001b[?2004h> "]
