[444.624001, "i", "cat << 'EOF' >> solve_dispatch_v2.py\n        u6 = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\n        \n        # Stack A\n        A = vstack([A1, A2, A3, A4, A5, A6]).tocsc()\n        l = np.concatenate([l1, l2, l3, l4, l5, l6])\n        u = np.concatenate([u1, u2, u3, u4, u5, u6])\n        \n        prob = osqp.OSQP()\n        prob.setup(P_mat, q_vec, A, l, u, verbose=True)\n        res = prob.solve()\n        \n        if res.info.status != 'solved':\n            print(\"OSQP did not solve optimally:\", res.info.status)\n            \n        x = res.x\n        \n    except ImportError:\n        print(\"OSQP not found, using Scipy SLSQP (approx)...\", flush=True)\n        from scipy.optimize import minimize, LinearConstraint, Bounds\n        \n        # ... (Previous Scipy implementation logic)\n        # Simplified for brevity in this fallback block\n        # Assuming OSQP works based on pip command\n        sys.exit(1)\n\n    # Extract results\n    pg_res = x[:ng]\n    rg_res = x[ng:2*ng]\n    theta_res = x[2*ng:]\n\n    total_cost = np.sum(c2 * pg_res**2 + c1 * pg_res + c0)\n    total_load = np.sum(bus[:, PD])\n    total_gen = np.sum(pg_res)\n    total_reserve = np.sum(rg_res)\n    \n    flows = B_branch.dot(theta_res)\n    limits = branch[stat, RATE_A]\n    limits[limits == 0] = 1e6\n    loadings = np.abs(flows) / limits * 100\n    \n    active_indices = np.where(stat)[0]\n    sorted_idx = np.argsort(loadings)[::-1]\n    \n    top_lines = []\n    for i in range(min(3, len(sorted_idx))):\n        idx = sorted_idx[i]\n        orig_idx = active_indices[idx]\n        top_lines.append({\n            \"from\": int(branch[orig_idx, F_BUS]),\n            \"to\": int(branch[orig_idx, T_BUS]),\n            \"loading_pct\": float(round(loadings[idx], 2))\n        })\n\n    status = gen[:, GEN_STATUS] > 0\n    margin = np.sum(gen[status, PMAX] - pg_res[status] - rg_res[status])\n\n    gen_dispatch = []\n    for i in range(ng):\n        gen_dispatch.append({\n            \"id\": i+1,\n            \"bus\": int(gen[i, GEN_BUS]),\n            \"output_MW\": float(round(pg_res[i], 2)),\n            \"reserve_MW\": float(round(rg_res[i], 2)),\n            \"pmax_MW\": float(gen[i, PMAX])\n        })\n\n    report = {\n        \"generator_dispatch\": gen_dispatch,\n        \"totals\": {\n            \"cost_dollars_per_hour\": float(round(total_cost, 2)),\n            \"load_MW\": float(round(total_load, 2)),\n            \"generation_MW\": float(round(total_gen, 2)),\n            \"reserve_MW\": float(round(total_reserve, 2))\n        },\n        \"most_loaded_lines\": top_lines,\n        \"operating_margin_MW\": float(round(margin, 2))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Report generated.\")\n\nif __name__ == \"__main__\":\n    solve()\nEOF\n"]
[445.636642, "i", "source venv/bin/activate && python3 solve_dispatch_v2.py\n"]
[492.724774, "i", "cat << 'EOF' > solve_dispatch_v2.py\nimport json\nimport numpy as np\nimport time\nfrom scipy.sparse import coo_matrix, csr_matrix, vstack, eye, hstack, diags\nimport sys\n\ndef solve():\n    print(\"Loading data...\", flush=True)\n    with open('network.json') as f:\n        data = json.load(f)\n\n    # Extract data\n    bus = np.array(data['bus'])\n    gen = np.array(data['gen'])\n    branch = np.array(data['branch'])\n    gencost = np.array(data['gencost'])\n    reserve_cap = np.array(data['reserve_capacity'])\n    reserve_req = data['reserve_requirement']\n    baseMVA = data['baseMVA']\n\n    nb = bus.shape[0]\n    ng = gen.shape[0]\n    nl = branch.shape[0]\n\n    # Indices\n    BUS_I, BUS_TYPE, PD = 0, 1, 2\n    GEN_BUS, PG, PMAX, PMIN = 0, 1, 8, 9\n    GEN_STATUS = 7\n    F_BUS, T_BUS, BR_X, RATE_A, TAP, BR_STATUS = 0, 1, 3, 5, 8, 10\n    MODEL, NCOST = 0, 3\n\n    bus_id_to_idx = {int(b_id): i for i, b_id in enumerate(bus[:, BUS_I])}\n    ref_bus_idx = np.where(bus[:, BUS_TYPE] == 3)[0][0]\n\n    print(\"Building matrices...\", flush=True)\n    stat = branch[:, BR_STATUS].astype(bool)\n    f = np.array([bus_id_to_idx[int(x)] for x in branch[stat, F_BUS]])\n    t = np.array([bus_id_to_idx[int(x)] for x in branch[stat, T_BUS]])\n    x_val = branch[stat, BR_X]\n    b = 1.0 / x_val\n    tap = branch[stat, TAP]\n    tap[tap == 0] = 1.0\n    b = b / tap\n\n    nl_active = np.sum(stat)\n    vals = np.concatenate([b, -b])\n    rows = np.concatenate([np.arange(nl_active), np.arange(nl_active)])\n    cols = np.concatenate([f, t])\n    B_branch = coo_matrix((vals, (rows, cols)), shape=(nl_active, nb))\n\n    b_bus_rows = np.concatenate([f, t, f, t])\n    b_bus_cols = np.concatenate([f, t, t, f])\n    b_bus_vals = np.concatenate([b, b, -b, -b])\n    B_bus = coo_matrix((b_bus_vals, (b_bus_rows, b_bus_cols)), shape=(nb, nb))\n\n    # Costs\n    c2 = np.zeros(ng)\n    c1 = np.zeros(ng)\n    c0 = np.zeros(ng)\n    for i in range(ng):\n        gc = gencost[i]\n        if gc[MODEL] == 2 and gc[NCOST] == 3:\n            c2[i] = gc[4]\n            c1[i] = gc[5]\n            c0[i] = gc[6]\n        elif gc[MODEL] == 2 and gc[NCOST] == 2:\n            c1[i] = gc[4]\n            c0[i] = gc[5]\n\n    # Variables: Pg, Rg, Theta\n    n_vars = 2 * ng + nb\nEOF\n"]
[493.326641, "i", "cat << 'EOF' >> solve_dispatch_v2.py\n    # Try OSQP\n    try:\n        import osqp\n        print(\"Using OSQP solver...\", flush=True)\n        \n        P_diag = np.concatenate([2*c2, np.zeros(ng), np.zeros(nb)])\n        P_mat = diags(P_diag, format='csc')\n        q_vec = np.concatenate([c1, np.zeros(ng), np.zeros(nb)])\n        \n        gen_bus_indices = [bus_id_to_idx[int(b_id)] for b_id in gen[:, GEN_BUS]]\n        C_g = coo_matrix((np.ones(ng), (gen_bus_indices, np.arange(ng))), shape=(nb, ng))\n        A1 = hstack([C_g, csr_matrix((nb, ng)), -B_bus])\n        l1 = bus[:, PD]\n        u1 = bus[:, PD]\n        \n        A2 = hstack([csr_matrix((1, ng)), csr_matrix(np.ones((1, ng))), csr_matrix((1, nb))])\n        l2 = np.array([reserve_req])\n        u2 = np.array([np.inf])\n        \n        A3 = hstack([eye(ng), eye(ng), csr_matrix((ng, nb))])\n        l3 = np.full(ng, -np.inf)\n        u3 = gen[:, PMAX]\n        \n        A4 = hstack([csr_matrix((nl_active, 2*ng)), B_branch])\n        limits = branch[stat, RATE_A]\n        limits[limits == 0] = 1e6\n        l4 = -limits\n        u4 = limits\n        \n        A5 = csr_matrix((1, n_vars))\n        A5[0, 2*ng + ref_bus_idx] = 1.0\n        l5 = np.array([0.0])\n        u5 = np.array([0.0])\n        \n        A6 = eye(n_vars)\n        l6 = np.concatenate([gen[:, PMIN], np.zeros(ng), np.full(nb, -np.inf)])\n        u6 = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\n        \n        A = vstack([A1, A2, A3, A4, A5, A6]).tocsc()\n        l = np.concatenate([l1, l2, l3, l4, l5, l6])\n        u = np.concatenate([u1, u2, u3, u4, u5, u6])\n        \n        prob = osqp.OSQP()\n        prob.setup(P_mat, q_vec, A, l, u, verbose=True)\n        res = prob.solve()\n        x = res.x\n        \n    except Exception as e:\n        print(f\"OSQP failed: {e}\", flush=True)\n        sys.exit(1)\n\n    pg_res = x[:ng]\n    rg_res = x[ng:2*ng]\n    theta_res = x[2*ng:]\n\n    total_cost = np.sum(c2 * pg_res**2 + c1 * pg_res + c0)\n    total_load = np.sum(bus[:, PD])\n    total_gen = np.sum(pg_res)\n    total_reserve"]
[493.327035, "i", " = np.sum(rg_res)\n    \n    flows = B_branch.dot(theta_res)\n    limits = branch[stat, RATE_A]\n    limits[limits == 0] = 1e6\n    loadings = np.abs(flows) / limits * 100\n    \n    active_indices = np.where(stat)[0]\n    sorted_idx = np.argsort(loadings)[::-1]\n    \n    top_lines = []\n    for i in range(min(3, len(sorted_idx))):\n        idx = sorted_idx[i]\n        orig_idx = active_indices[idx]\n        top_lines.append({\n            \"from\": int(branch[orig_idx, F_BUS]),\n            \"to\": int(branch[orig_idx, T_BUS]),\n            \"loading_pct\": float(round(loadings[idx], 2))\n        })\n\n    status = gen[:, GEN_STATUS] > 0\n    margin = np.sum(gen[status, PMAX] - pg_res[status] - rg_res[status])\n\n    gen_dispatch = []\n    for i in range(ng):\n        gen_dispatch.append({\n            \"id\": i+1,\n            \"bus\": int(gen[i, GEN_BUS]),\n            \"output_MW\": float(round(pg_res[i], 2)),\n            \"reserve_MW\": float(round(rg_res[i], 2)),\n            \"pmax_MW\": float(gen[i, PMAX])\n        })\n\n    report = {\n        \"generator_dispatch\": gen_dispatch,\n        \"totals\": {\n            \"cost_dollars_per_hour\": float(round(total_cost, 2)),\n            \"load_MW\": float(round(total_load, 2)),\n            \"generation_MW\": float(round(total_gen, 2)),\n            \"reserve_MW\": float(round(total_reserve, 2))\n        },\n        \"most_loaded_lines\": top_lines,\n        \"operating_margin_MW\": float(round(margin, 2))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    print(\"Report generated.\")\n\nif __name__ == \"__main__\":\n    solve()\nEOF\n"]
