[1271.188227, "o", "    b = 1.0 / x_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.188391, "o", "    tap = branch[stat, TAP]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.188501, "o", "    tap[tap == 0] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.188637, "o", "    b = b / tap\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.188762, "o", "    nl_active = np.sum(stat)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1271.18891, "o", ">     vals = np.concatenate([b, -b])\r\n"]
[1271.189085, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1271.189252, "o", "    rows = np.concatenate([np.arange(nl_active), np.arange(nl_active)])\r\n\u001b[?2004l\r"]
[1271.189395, "o", "\u001b[?2004h> "]
[1271.189557, "o", "    cols = np.concatenate([f, t])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.189758, "o", "    B_branch = coo_matrix((vals, (rows, cols)), shape=(nl_active, nb))\r\n\u001b[?2004l\r"]
[1271.189898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.190024, "o", "    b_bus_rows = np.concatenate([f, t, f, t])\r\n\u001b[?2004l\r"]
[1271.190167, "o", "\u001b[?2004h> "]
