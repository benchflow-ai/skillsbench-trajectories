[1271.185604, "o", "> "]
[1271.185806, "o", "    F_BUS, T_BUS, BR_X, RATE_A, TAP, BR_STATUS = 0, 1, 3, 5, 8, 10\r\n\u001b[?2004l\r"]
[1271.185931, "o", "\u001b[?2004h> "]
[1271.186024, "o", "    MODEL, NCOST = 0, 3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1271.186128, "o", "\u001b[?2004h> "]
[1271.186395, "o", "    bus_id_to_idx = {int(b_id): i for i, b_id in enumerate(bus[:, BUS_I])}\r\n\u001b[?2004l\r"]
[1271.186543, "o", "\u001b[?2004h> "]
[1271.186662, "o", "    ref_bus_idx = np.where(bus[:, BUS_TYPE] == 3)[0][0]\r\n\u001b[?2004l\r"]
[1271.186776, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.186937, "o", "    print(\"Building matrices...\", flush=True)\r\n\u001b[?2004l\r"]
[1271.187069, "o", "\u001b[?2004h> "]
[1271.187174, "o", "    stat = branch[:, BR_STATUS].astype(bool)\r\n\u001b[?2004l\r"]
[1271.187303, "o", "\u001b[?2004h> "]
[1271.187592, "o", "    f = np.array([bus_id_to_idx[int(x)] for x in branch[stat, F_BUS]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.187932, "o", "    t = np.array([bus_id_to_idx[int(x)] for x in branch[stat, T_BUS]])\r\n\u001b[?2004l\r"]
