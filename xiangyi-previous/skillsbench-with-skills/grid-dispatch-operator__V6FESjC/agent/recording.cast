[1267.243291, "o", "            c0[i] = gc[5]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[1267.243452, "o", "    # Variables: Pg, Rg, Theta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.24358, "o", "    n_vars = 2 * ng + nb\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r \u001b[?2004h>     # Try OSQP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.243607, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.243887, "o", ">         import osqp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.243976, "o", "        print(\"Using OSQP solver...\", flush=True)\r\n\u001b[?2004l\r"]
[1267.24409, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[1267.244298, "o", "        # P matrix (Hessian): 0.5 * x' P x\r\n\u001b[?2004l\rat\u001b[?2004h> "]
[1267.244782, "o", "        # We have Minimize sum(c2*Pg^2 + c1*Pg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.245371, "o", "        # OSQP minimizes 0.5 x' P x + q' x\r\n\u001b[?2004l\r\u001b[?2004h>         # So P diagonal should be 2*c2\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.245632, "o", "        P_diag = np.concatenate([2*c2, np.zeros(ng), np.zeros(nb)])\r\n\u001b[?2004l\r"]
[1267.245775, "o", "\u001b[?2004h> "]
[1267.245889, "o", "        P_mat = diags(P_diag, format='csc')\r\n\u001b[?2004l\r"]
[1267.246014, "o", "\u001b[?2004h> "]
[1267.24629, "o", "        q_vec = np.concatenate([c1, np.zeros(ng), np.zeros(nb)])\r\n\u001b[?2004l\r"]
[1267.246399, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.246598, "o", "        # Constraints: l <= A x <= u\r\n\u001b[?2004l\r"]
[1267.246649, "o", "\u001b[?2004h> "]
[1267.246918, "o", "        # 1. Power Balance: Pg - B_bus theta = Pd\r\n\u001b[?2004l\r"]
[1267.246971, "o", "\u001b[?2004h> "]
[1267.247126, "o", "        # [I_g_map, 0, -B_bus]\r\n\u001b[?2004l\r"]
[1267.247186, "o", "\u001b[?2004h> "]
[1267.247617, "o", "        gen_bus_indices = [bus_id_to_idx[int(b_id)] for b_id in gen[:, GEN_BUS]]\r\n\u001b[?2004l\r"]
[1267.247959, "o", "\u001b[?2004h> "]
[1267.248231, "o", "        C_g = coo_matrix((np.ones(ng), (gen_bus_indices, np.arange(ng))), shape=(nb, ng))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.248481, "o", ">         A1 = hstack([C_g, csr_matrix((nb, ng)), -B_bus])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.248733, "o", ">         l1 = bus[:, PD]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.249018, "o", "        u1 = bus[:, PD]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.249302, "o", "        # 2. Reserve Req: sum(Rg) >= Req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.249462, "o", "        A2 = hstack([csr_matrix((1, ng)), csr_matrix(np.ones((1, ng))), csr_matrix((1, nb))])\r\n\u001b[?2004l\r"]
[1267.249617, "o", "\u001b[?2004h>         l2 = np.array([reserve_req])\r\n\u001b[?2004l\r"]
[1267.249744, "o", "\u001b[?2004h> "]
[1267.249953, "o", "        u2 = np.array([np.inf])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.250134, "o", "        # 3. Capacity: Pg + Rg <= Pmax\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.250347, "o", "        A3 = hstack([eye(ng), eye(ng), csr_matrix((ng, nb))])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.250502, "o", ">         l3 = np.full(ng, -np.inf)\r\n\u001b[?2004l\r"]
[1267.250615, "o", "\u001b[?2004h>         u3 = gen[:, PMAX]\r\n\u001b[?2004l\r"]
[1267.250792, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.25098, "o", "        # 4. Flow Limits: -Lim <= B_branch theta <= Lim\r\n\u001b[?2004l\r"]
[1267.251129, "o", "\u001b[?2004h> "]
[1267.251289, "o", "        A4 = hstack([csr_matrix((nl_active, 2*ng)), B_branch])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.251457, "o", ">         limits = branch[stat, RATE_A]\r\n\u001b[?2004l\r"]
[1267.251626, "o", "\u001b[?2004h>         limits[limits == 0] = 1e6\r\n\u001b[?2004l\r"]
[1267.251763, "o", "\u001b[?2004h>         l4 = -limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.251922, "o", "        u4 = limits\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[1267.252087, "o", "\u001b[?2004h>         # 5. Ref Angle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.252261, "o", "        A5 = csr_matrix((1, n_vars))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.252389, "o", "        A5[0, 2*ng + ref_bus_idx] = 1.0\r\n\u001b[?2004l\r"]
[1267.252734, "o", "\u001b[?2004h> "]
[1267.252841, "o", "        l5 = np.array([0.0])\r\n\u001b[?2004l\r\u001b[?2004h>         u5 = np.array([0.0])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # 6. Variable Bounds\r\n\u001b[?2004l\r\u001b[?2004h>         # Pg: Pmin..Pmax\r\n\u001b[?2004l\r\u001b[?2004h>         # Rg: 0..ReserveCap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.252904, "o", "        # Theta: -inf..inf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.25314, "o", "        A6 = eye(n_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.253517, "o", "        l6 = np.concatenate([gen[:, PMIN], np.zeros(ng), np.full(nb, -np.inf)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.25372, "o", "        u6 = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.253838, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.253957, "o", "        # Stack A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.25409, "o", "        A = vstack([A1, A2, A3, A4, A5, A6]).tocsc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.254204, "o", "        l = np.concatenate([l1, l2, l3, l4, l5, l6])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.254258, "o", "> "]
[1267.254461, "o", "        u = np.concatenate([u1, u2, u3, u4, u5, u6])\r\n\u001b[?2004l\r"]
[1267.254488, "o", "\u001b[?2004h> "]
[1267.254574, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.254678, "o", "> "]
[1267.254704, "o", "        prob = osqp.OSQP()\r\n\u001b[?2004l\r"]
[1267.254765, "o", "\u001b[?2004h> "]
[1267.255063, "o", "        prob.setup(P_mat, q_vec, A, l, u, verbose=True)\r\n"]
[1267.255104, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1267.255239, "o", "        res = prob.solve()\r\n\u001b[?2004l\r"]
[1267.255385, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[1267.255505, "o", "\u001b[?2004h> "]
[1267.255603, "o", "        if res.info.status != 'solved':\r\n\u001b[?2004l\r"]
[1267.255653, "o", "\u001b[?2004h> "]
[1267.255917, "o", "            print(\"OSQP did not solve optimally:\", res.info.status)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[1267.256006, "o", "\u001b[?2004h> "]
[1267.25609, "o", "        x = res.x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.256141, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.256235, "o", "> "]
[1267.256297, "o", "    except ImportError:\r\n\u001b[?2004l\r"]
[1267.256326, "o", "\u001b[?2004h> "]
[1267.256803, "o", "        print(\"OSQP not found, using Scipy SLSQP (approx)...\", flush=True)\r\n\u001b[?2004l\r   \u001b[?2004h"]
[1267.256904, "o", "> "]
[1267.257234, "o", "        from scipy.optimize import minimize, LinearConstraint, Bounds\r\n\u001b[?2004l\r"]
[1267.25737, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.257601, "o", "        # ... (Previous Scipy implementation logic)\r\n\u001b[?2004l\r"]
[1267.257751, "o", "\u001b[?2004h> "]
[1267.25798, "o", "        # Simplified for brevity in this fallback block\r\n\u001b[?2004l\r"]
[1267.258119, "o", "\u001b[?2004h> "]
[1267.258247, "o", "        # Assuming OSQP works based on pip command\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.258336, "o", ">         sys.exit(1)\r\n\u001b[?2004l\r"]
[1267.258473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.258614, "o", "    # Extract results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.258734, "o", "    pg_res = x[:ng]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.258845, "o", "    rg_res = x[ng:2*ng]\r\n\u001b[?2004l\r"]
[1267.258951, "o", "\u001b[?2004h> "]
[1267.259091, "o", "    theta_res = x[2*ng:]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.259229, "o", "> "]
[1267.259323, "o", "    total_cost = np.sum(c2 * pg_res**2 + c1 * pg_res + c0)\r\n\u001b[?2004l\r"]
[1267.259355, "o", "\u001b[?2004h> "]
[1267.259553, "o", "    total_load = np.sum(bus[:, PD])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.259609, "o", "> "]
[1267.259761, "o", "    total_gen = np.sum(pg_res)\r\n\u001b[?2004l\r"]
[1267.25981, "o", "\u001b[?2004h> "]
[1267.259968, "o", "    total_reserve = np.sum(rg_res)\r\n\u001b[?2004l\r"]
[1267.260017, "o", "\u001b[?2004h>     "]
[1267.260048, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.260078, "o", "> "]
[1267.260261, "o", "    flows = B_branch.dot(theta_res)\r\n\u001b[?2004l\r"]
[1267.260322, "o", "\u001b[?2004h> "]
[1267.260479, "o", "    limits = branch[stat, RATE_A]\r\n\u001b[?2004l\r"]
[1267.26053, "o", "\u001b[?2004h> "]
[1267.260695, "o", "    limits[limits == 0] = 1e6\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.260743, "o", "> "]
[1267.261072, "o", "    loadings = np.abs(flows) / limits * 100\r\n\u001b[?2004l\r"]
[1267.261107, "o", "\u001b[?2004h> "]
[1267.261211, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.261385, "o", "    active_indices = np.where(stat)[0]\r\n\u001b[?2004l\r"]
[1267.261413, "o", "\u001b[?2004h> "]
[1267.261671, "o", "    sorted_idx = np.argsort(loadings)[::-1]\r\n\u001b[?2004l\r"]
[1267.261726, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1267.261779, "o", "\u001b[?2004h> "]
[1267.261881, "o", "    top_lines = []\r\n\u001b[?2004l\r"]
[1267.261916, "o", "\u001b[?2004h> "]
[1267.262157, "o", "    for i in range(min(3, len(sorted_idx))):\r\n\u001b[?2004l\r"]
[1267.262183, "o", "\u001b[?2004h> "]
[1267.262349, "o", "        idx = sorted_idx[i]\r\n\u001b[?2004l\r"]
[1267.262401, "o", "\u001b[?2004h> "]
[1267.262587, "o", "        orig_idx = active_indices[idx]\r\n\u001b[?2004l\r"]
[1267.262617, "o", "\u001b[?2004h> "]
[1267.26277, "o", "        top_lines.append({\r\n\u001b[?2004l\r"]
[1267.262796, "o", "\u001b[?2004h> "]
[1267.263058, "o", "            \"from\": int(branch[orig_idx, F_BUS]),\r\n\u001b[?2004l\r"]
[1267.263093, "o", "\u001b[?2004h> "]
[1267.263326, "o", "            \"to\": int(branch[orig_idx, T_BUS]),\r\n\u001b[?2004l\r"]
[1267.263388, "o", "\u001b[?2004h> "]
[1267.263643, "o", "            \"loading_pct\": float(round(loadings[idx], 2))\r\n\u001b[?2004l\r"]
[1267.263715, "o", "\u001b[?2004h> "]
[1267.263772, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.263798, "o", "> \r\n\u001b[?2004l\r"]
[1267.263828, "o", "\u001b[?2004h> "]
[1267.264022, "o", "    status = gen[:, GEN_STATUS] > 0\r\n\u001b[?2004l\r"]
[1267.264073, "o", "\u001b[?2004h> "]
[1267.264419, "o", "    margin = np.sum(gen[status, PMAX] - pg_res[status] - rg_res[status])\r\n\u001b[?2004l\r"]
[1267.264443, "o", "\u001b[?2004h> "]
[1267.26451, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.264779, "o", "    gen_dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.264812, "o", "    for i in range(ng):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.265031, "o", "        gen_dispatch.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.26506, "o", "> "]
[1267.265111, "o", "            \"id\": i+1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.265333, "o", "            \"bus\": int(gen[i, GEN_BUS]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.26558, "o", "            \"output_MW\": float(round(pg_res[i], 2)),\r\n\u001b[?2004l\r"]
[1267.265629, "o", "\u001b[?2004h> "]
[1267.265791, "o", "            \"reserve_MW\": float(round(rg_res[i], 2)),\r\n\u001b[?2004l\r"]
[1267.265844, "o", "\u001b[?2004h> "]
[1267.266036, "o", "            \"pmax_MW\": float(gen[i, PMAX])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.266105, "o", ">         })\r\n\u001b[?2004l\rd"]
[1267.266132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.266254, "o", "    report = {\r\n\u001b[?2004l\r"]
[1267.26628, "o", "\u001b[?2004h> "]
[1267.266474, "o", "        \"generator_dispatch\": gen_dispatch,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.266566, "o", "> "]
[1267.266609, "o", "        \"totals\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.26698, "o", "            \"cost_dollars_per_hour\": float(round(total_cost, 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.267177, "o", "            \"load_MW\": float(round(total_load, 2)),\r\n\u001b[?2004l\r"]
[1267.267252, "o", "\u001b[?2004h> "]
[1267.267487, "o", "            \"generation_MW\": float(round(total_gen, 2)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1267.267769, "o", "            \"reserve_MW\": float(round(total_reserve, 2))\r\n\u001b[?2004l\r"]
[1267.267826, "o", "\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[1267.267879, "o", "\u001b[?2004h> "]
[1267.268083, "o", "        \"most_loaded_lines\": top_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.268129, "o", "> "]
[1267.268365, "o", "        \"operating_margin_MW\": float(round(margin, 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1267.268414, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1267.268495, "o", "\u001b[?2004h> "]
[1267.26861, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[1267.268698, "o", "\u001b[?2004h> "]
[1267.324897, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Report generated.\")\r\n\u001b[?2004l\rb\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\rv\u001b[?2004h>     solve()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1267.347738, "o", "\u001b[?2004h(venv) root@7452b99f7363:~# "]
[1267.347902, "o", "source venv/bin/activate && python3 solve_dispatch_v2.py\r\n\u001b[?2004l\r"]
[1268.809595, "o", "Loading data...\r\n"]
[1268.874505, "o", "Building matrices...\r\n"]
[1268.936843, "o", "OSQP not found, using Scipy SLSQP (approx)..."]
[1268.936923, "o", "\r\n"]
[1271.075544, "o", "\u001b[?2004h(venv) root@7452b99f7363:~# "]
[1271.075861, "o", "cat << 'EOF' >> solve_dispatch_v2.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.075893, "o", "        u6 = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Stack A\r\n\u001b[?2004l\r"]
[1271.076034, "o", "\u001b[?2004h> "]
[1271.076122, "o", "        A = vstack([A1, A2, A3, A4, A5, A6]).tocsc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.078141, "o", "        l = np.concatenate([l1, l2, l3, l4, l5, l6])\r\n\u001b[?2004l\r\u001b[?2004h>         u = np.concatenate([u1, u2, u3, u4, u5, u6])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         prob = osqp.OSQP()\r\n\u001b[?2004l\r\u001b[?2004h>         prob.setup(P_mat, q_vec, A, l, u, verbose=True)\r\n\u001b[?2004l\r\u001b[?2004h>         res = prob.solve()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if res.info.status != 'solved':\r\n\u001b[?2004l\r\u001b[?2004h>             print(\"OSQP did not solve optimally:\", res.info.status)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         x = res.x\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     except ImportError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.078547, "o", "        print(\"OSQP not found, using Scipy SLSQP (approx)...\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.078963, "o", "        from scipy.optimize import minimize, LinearConstraint, Bounds\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[1271.078997, "o", "\u001b[?2004h> "]
[1271.079658, "o", "        # ... (Previous Scipy implementation logic)\r\n\u001b[?2004l\r\u001b[?2004h>         # Simplified for brevity in this fallback block\r\n\u001b[?2004l\r\u001b[?2004h>         # Assuming OSQP works based on pip command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.079765, "o", "        sys.exit(1)"]
[1271.079861, "o", "\r\n"]
[1271.079923, "o", "\u001b[?2004l\r"]
[1271.079994, "o", "\u001b[?2004h"]
[1271.08014, "o", "> "]
[1271.080243, "o", "\r\n"]
[1271.080326, "o", "\u001b[?2004l\r"]
[1271.08042, "o", "\u001b[?2004h"]
[1271.080506, "o", "> "]
[1271.080703, "o", "    # Extract results"]
[1271.080795, "o", "\r\n"]
[1271.080881, "o", "\u001b[?2004l\r"]
[1271.080982, "o", "\u001b[?2004h"]
[1271.081071, "o", "> "]
[1271.081236, "o", "    pg_res = x[:ng]"]
