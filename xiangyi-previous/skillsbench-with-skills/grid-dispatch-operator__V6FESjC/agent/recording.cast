[1271.184762, "o", ">     ng = gen.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1271.184883, "o", "    nl = branch.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
