[89.781356, "i", "cat > src/components/LateBanner.tsx << 'EOF'\n'use client';\n\nimport { useState, useEffect } from 'react';\n\nconst API_URL = '';\n\nexport default function LateBanner() {\n  const [text, setText] = useState<string>('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetch(`${API_URL}/api/late-banner`)\n      .then(r => r.json())\n      .then(data => {\n        setText(data.text);\n        setLoading(false);\n      });\n  }, []);\n\n  return (\n    <div\n      data-testid=\"late-banner\"\n      className=\"bg-[#ff6b35] text-white py-32 px-4 text-center font-bold text-[28px]\"\n      style={{ minHeight: '192px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}\n    >\n      {loading ? (\n        <div style={{ width: '250px', height: '40px', backgroundColor: 'rgba(255, 255, 255, 0.2)', borderRadius: '4px', animation: 'pulse 2s infinite' }} />\n      ) : (\n        text\n      )}\n    </div>\n  );\n}\nEOF\n"]
[89.781941, "o", "cat > src/components/LateBanner.tsx << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> 'use client';\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import { useState, useEffect } from 'react';\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
