[89.785738, "o", "  const [loading, setLoading] = useState(true);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   useEffect(() => {\r\n\u001b[?2004l\r\u001b[?2004h>     fetch(`${API_URL}/api/late-banner`)\r\n\u001b[?2004l\r\u001b[?2004h>       .then(r => r.json())\r\n\u001b[?2004l\r\u001b[?2004h>       .then(data => {\r\n\u001b[?2004l\r\u001b[?2004h>         setText(data.text);\r\n\u001b[?2004l\r\u001b[?2004h>         setLoading(false);\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>   }, []);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return (\r\n\u001b[?2004l\r\u001b[?2004h>     <div\r\n\u001b[?2004l\r\u001b[?2004h>       data-testid=\"late-banner\"\r\n\u001b[?2004l\r\u001b[?2004h>       className=\"bg-[#ff6b35] text-white py-32 px-4 text-center font-bold text-[28px]\"\r\n\u001b[?2004l\r\u001b[?2004h>       style={{ minHeight: '192px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}\r\n\u001b[?2004l\r\u001b[?2004h>     >\r\n\u001b[?2004l\r\u001b[?2004h>       {loading ? (\r\n\u001b[?2004l\r\u001b[?2004h>         <div style={{ width: '250px', height: '40px', backgroundColor: 'rgba(255, 255, 255, 0.2)', borderRadius: '4px', animation: 'pulse 2s infinite' }} />\r\n\u001b[?2004l\r\u001b[?2004h>       ) : (\r\n\u001b[?2004l\r\u001b[?2004h>         text\r\n\u001b[?2004l\r\u001b[?2004h>       )}\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h"]
