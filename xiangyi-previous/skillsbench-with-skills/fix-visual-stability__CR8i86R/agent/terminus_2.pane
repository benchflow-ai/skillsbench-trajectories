[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useState, useEffect } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> const API_URL = '';
[?2004l[?2004h> 
[?2004l[?2004h> interface ResultsBarProps {
[?2004l[?2004h>   page: number;
[?2004l[?2004h>   totalProducts: number;
[?2004l[?2004h>   onPageChange: (page: number) => void;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export default function ResultsBar({ page, totalProducts, onPageChange }: ResultsBarProps) {
[?2004l[?2004h>   const [visible, setVisible] = useState(false);
[?2004l[?2004h>   const [loading, setLoading] = useState(true);
[?2004l[?2004h>   const perPage = 15;
[?2004l[?2004h>   const totalPages = Math.ceil(totalProducts / perPage) || 1;
[?2004l[?2004h> 
[?2004l[?2004h>   useEffect(() => {
[?2004l[?2004h>     fetch(`${API_URL}/api/results-bar`)
[?2004l[?2004h>       .then(r => r.json())
[?2004l[?2004h>       .then(data => {
[?2004l[?2004h>         setVisible(data.visible);
[?2004l[?2004h>         setLoading(false);
[?2004l[?2004h>       });
[?2004l[?2004h>   }, []);
[?2004l[?2004h> 
[?2004l[?2004h>   if (totalProducts === 0 && !loading) return null;
[?2004l[?2004h> 
[?2004l[?2004h>   if (loading) {
[?2004l[?2004h>     return (
[?2004l[?2004h>       <div
[?2004l[?2004h>         data-testid="results-bar"
[?2004l[?2004h>         className="flex justify-between items-center bg-[var(--card-bg)] py-4 px-5 mb-5 rounded-lg text-sm"
[?2004l[?2004h>         style={{ minHeight: '40px' }}
[?2004l[?2004h>       >
[?2004l[?2004h>         <div style={{ width: '150px', height: '16px', backgroundColor: 'var(--border-color)', borderRadius: '4px', animation: 'pulse 2s infinite' }} />
[?2004l[?2004h>         <div style={{ width: '150px', height: '16px', backgroundColor: 'var(--border-color)', borderRadius: '4px', animation: 'pulse 2s infinite' }} />
[?2004l[?2004h>         <div style={{ width: '100px', height: '16px', backgroundColor: 'var(--border-color)', borderRadius: '4px', animation: 'pulse 2s infinite' }} />
[?2004l[?2004h>       </div>
[?2004l[?2004h>     );
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   if (!visible || totalProducts === 0) return null;
[?2004l[?2004h> 
[?2004l[?2004h>   const start = (page - 1) * perPage + 1;
[?2004l[?2004h>   const end = Math.min(page * perPage, totalProducts);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div
[?2004l[?2004h>       data-testid="results-bar"
[?2004l[?2004h>       className="flex justify-between items-center bg-[var(--card-bg)] py-4 px-5 mb-5 rounded-lg text-sm"
[?2004l[?2004h>     >
[?2004l[?2004h>       <span>Showing {start}-{end} of {totalProducts} products</span>
[?2004l[?2004h>       <div data-testid="pagination" className="flex items-center gap-3">
[?2004l[?2004h>         <button
[?2004l[?2004h>           data-testid="prev-page-btn"
[?2004l[?2004h>           disabled={page === 1}
[?2004l[?2004h>           onClick={() => onPageChange(page - 1)}
[?2004l[?2004h>           className="px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}
[?2004l[?2004h>         >
[?2004l[?2004h>           ← Prev
[?2004l[?2004h>         </button>
[?2004l[?2004h>         <span>Page {page} of {totalPages}</span>
[?2004l[?2004h>         <button
[?2004l[?2004h>           data-testid="next-page-btn"
[?2004l[?2004h>           disabled={page === totalPages}
[?2004l[?2004h>           onClick={() => onPageChange(page + 1)}
[?2004l[?2004h>           className="px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}
[?2004l[?2004h>         >
[?2004l[?2004h>           Next →
[?2004l[?2004h>         </button>
[?2004l[?2004h>       </div>
[?2004l[?2004h>       <span>Sort: Price ▼</span>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> EOF
