[394.965961, "o", "\u001b[?2004hroot@2468af58d42a:~# "]
[662.844975, "i", "cat > /root/process_video.py << 'EOF'\nimport json\nimport subprocess\nfrom faster_whisper import WhisperModel\nimport os\n\n# Filler words to detect (case-insensitive)\nFILLER_WORDS = [\n    \"um\", \"uh\", \"hum\", \"hmm\", \"mhm\",\n    \"like\",\n    \"you know\",\n    \"i mean\",\n    \"yeah\",\n    \"so\",\n    \"kind of\",\n    \"basically\",\n    \"i guess\",\n    \"well\",\n    \"okay\"\n]\n\nprint(\"Loading Whisper model...\")\nmodel = WhisperModel(\"base\", device=\"cpu\", compute_type=\"int8\")\n\nprint(\"Transcribing video...\")\nsegments, info = model.transcribe(\"/root/input.mp4\", word_timestamps=True)\n\nfillers = []\n\nprint(\"Detecting filler words...\")\nfor segment in segments:\n    if hasattr(segment, 'words') and segment.words:\n        for word in segment.words:\n            word_text = word.word.strip().lower()\n            # Check single words\n            if word_text in FILLER_WORDS:\n                fillers.append({\n                    \"word\": word_text,\n                    \"timestamp\": round(word.start, 1)\n                })\n            \n# Check for multi-word phrases\nprint(\"Checking for multi-word phrases...\")\nfor segment in segments:\n    if hasattr(segment, 'words') and segment.words:\n        words_list = segment.words\n        for i in range(len(words_list)):\n            # Check 2-word phrases\n            if i < len(words_list) - 1:\n                phrase = f\"{words_list[i].word.strip()} {words_list[i+1].word.strip()}\".lower()\n                if phrase in FILLER_WORDS:\n                    fillers.append({\n                        \"word\": phrase,\n                        \"timestamp\": round(words_list[i].start, 1)\n                    })\n\nprint(f\"Found {len(fillers)} filler words\")\n\n# Save to JSON\nwith open('/root/annotations.json', 'w') as f:\n    json.dump(fillers, f, indent=2)\n\nprint(\"Saved annotations to /root/annotations.json\")\nprint(f\"Sample: {fillers[:5]}\")\nEOF\n"]
[662.845569, "o", "cat > /root/process_video.py << 'EOF'\r\n"]
[662.845715, "o", "\u001b[?2004l\r\u001b[?2004h"]
[662.84581, "o", "> import json"]
[662.846007, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.846187, "o", "> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.846244, "o", "> from faster_whisper import WhisperModel"]
[662.846302, "o", "\r\n"]
[662.846361, "o", "\u001b[?2004l\r"]
