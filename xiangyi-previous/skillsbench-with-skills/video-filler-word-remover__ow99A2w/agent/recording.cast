[662.846543, "o", "> import os"]
[662.846625, "o", "\r\n\u001b[?2004l\r"]
[662.846853, "o", "\u001b[?2004h> "]
[662.84692, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Filler words to detect (case-insensitive)\r\n\u001b[?2004l\r"]
[662.846993, "o", "\u001b[?2004h"]
[662.847073, "o", "> "]
[662.847176, "o", "FILLER_WORDS = ["]
[662.847239, "o", "\r\n"]
[662.84735, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[662.847713, "o", "    \"um\", \"uh\", \"hum\", \"hmm\", \"mhm\","]
[662.848406, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \"like\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"you know\",\r\n\u001b[?2004l\r"]
[662.849223, "o", "\u001b[?2004h> "]
[662.84978, "o", "    \"i mean\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"yeah\",\r\n\u001b[?2004l\r"]
[662.849939, "o", "\u001b[?2004h>     \"so\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"kind of\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.849967, "o", "    \"basically\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.850012, "o", "    \"i guess\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.850043, "o", "> "]
[662.850069, "o", "    \"well\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.850123, "o", "    \"okay\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.850437, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loading Whisper model...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.850591, "o", "model = WhisperModel(\"base\", device=\"cpu\", compute_type=\"int8\")"]
[662.850677, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.850703, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.850772, "o", "print(\"Transcribing video...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.850804, "o", "> "]
[662.850982, "o", "segments, info = model.transcribe(\"/root/input.mp4\", word_timestamps=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.851017, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[662.851234, "o", "> fillers = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Detecting filler words...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.85129, "o", "for segment in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.851324, "o", "> "]
[662.851465, "o", "    if hasattr(segment, 'words') and segment.words:\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.851957, "o", "> "]
[662.851994, "o", "        for word in segment.words:\r\n\u001b[?2004l\r\u001b[?2004h>             word_text = word.word.strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h>             # Check single words\r\n\u001b[?2004l\r\u001b[?2004h>             if word_text in FILLER_WORDS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.852045, "o", "                fillers.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.852069, "o", "> "]
[662.852165, "o", "                    \"word\": word_text,\r\n\u001b[?2004l\r"]
[662.852191, "o", "\u001b[?2004h> "]
[662.852333, "o", "                    \"timestamp\": round(word.start, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.852399, "o", "                })\r\n\u001b[?2004l\r"]
[662.852426, "o", "\u001b[?2004h> "]
[662.85246, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[662.852492, "o", "> "]
[662.852564, "o", "# Check for multi-word phrases\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.8531, "o", "print(\"Checking for multi-word phrases...\")\r\n\u001b[?2004l\r\u001b[?2004h> for segment in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.853132, "o", "> "]
[662.853794, "o", "    if hasattr(segment, 'words') and segment.words:\r\n\u001b[?2004l\r\u001b[?2004h>         words_list = segment.words\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.853828, "o", "        for i in range(len(words_list)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.853904, "o", "            # Check 2-word phrases\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.853935, "o", "> "]
[662.854046, "o", "            if i < len(words_list) - 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.854289, "o", "                phrase = f\"{words_list[i].word.strip()} {words_list[i+1].word.strip()}\".lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.854323, "o", "> "]
[662.854408, "o", "                if phrase in FILLER_WORDS:\r\n\u001b[?2004l\r"]
[662.854435, "o", "\u001b[?2004h> "]
[662.854595, "o", "                    fillers.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.855311, "o", "                        \"word\": phrase,\r\n\u001b[?2004l\r\u001b[?2004h>                         \"timestamp\": round(words_list[i].start, 1)\r\n\u001b[?2004l\r\u001b[?2004h>                     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Found {len(fillers)} filler words\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.855353, "o", "# Save to JSON\r\n"]
[662.856063, "o", "\u001b[?2004l\r\u001b[?2004h"]
[662.856106, "o", "> "]
[662.856235, "o", "with open('/root/annotations.json', 'w') as f:\r\n\u001b[?2004l\r"]
[662.856277, "o", "\u001b[?2004h> "]
[662.856366, "o", "    json.dump(fillers, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[662.85639, "o", "\u001b[?2004h> "]
[662.856541, "o", "print(\"Saved annotations to /root/annotations.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.856572, "o", "> "]
[662.856664, "o", "print(f\"Sample: {fillers[:5]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.856695, "o", "EOF\r\n\u001b[?2004l\r"]
[662.950248, "o", "\u001b[?2004hroot@2468af58d42a:~# "]
[664.618894, "i", "python3 /root/process_video.py\n"]
[664.619611, "o", "python3 /root/process_video.py\r\n\u001b[?2004l\r"]
[672.228751, "o", "Loading Whisper model...\r\n"]
[676.949739, "o", "Transcribing video..."]
[676.949933, "o", "\r\n"]
[680.382254, "o", "Detecting filler words...\r\n"]
[736.575278, "o", "Checking for multi-word phrases...\r\nFound 32 filler words\r\n"]
[736.576089, "o", "Saved annotations to /root/annotations.json\r\n"]
[736.576194, "o", "Sample: [{'word': 'so', 'timestamp': np.float64(0.8)}, {'word': 'like', 'timestamp': np.float64(33.6)}, {'word': 'like', 'timestamp': np.float64(35.5)}, {'word': 'so', 'timestamp': np.float64(39.2)}, {'word': 'like', 'timestamp': np.float64(41.1)}]\r\n"]
[736.729873, "o", "\u001b[?2004h"]
[736.733651, "o", "root@2468af58d42a:~# "]
[992.706061, "i", "cat /root/annotations.json | head -20\n"]
[992.706268, "o", "cat /root/annotations.json | head -20\r\n\u001b[?2004l\r"]
[992.830089, "o", "[\r\n  {\r\n    \"word\": \"so\",\r\n    \"timestamp\": 0.8\r\n  },\r\n  {\r\n    \"word\": \"like\",\r\n    \"timestamp\": 33.6\r\n  },\r\n  {\r\n    \"word\": \"like\",\r\n    \"timestamp\": 35.5\r\n  },\r\n  {\r\n    \"word\": \"so\",\r\n    \"timestamp\": 39.2\r\n  },\r\n  {\r\n    \"word\": \"like\",\r\n    \"timestamp\": 41.1\r\n"]
[992.832779, "o", "\u001b[?2004hroot@2468af58d42a:~# "]
[996.905135, "i", "python3 -c \"import json; data = json.load(open('/root/annotations.json')); print(f'Total fillers: {len(data)}'); print('First 3:', data[:3])\"\n"]
[996.905633, "o", "python3 -c \"import json; data = json.load(open('/root/annotations.json')); print(f'Total fillers: {len(data)}'); print('First 3:', data[:3])\"\r\n\u001b[?2004l\r"]
[997.034384, "o", "Total fillers: 32"]
[997.034604, "o", "\r\nFirst 3: [{'word': 'so', 'timestamp': 0.8}, {'word': 'like', 'timestamp': 33.6}, {'word': 'like', 'timestamp': 35.5}]\r\n"]
[997.039407, "o", "\u001b[?2004hroot@2468af58d42a:~# "]
[1017.614267, "i", "cat > /root/create_compilation.py << 'EOF'\nimport json\nimport subprocess\nimport os\n\n# Load annotations\nwith open('/root/annotations.json', 'r') as f:\n    fillers = json.load(f)\n\nprint(f\"Processing {len(fillers)} filler word clips...\")\n\n# Create temporary directory for clips\nos.makedirs('/tmp/clips', exist_ok=True)\n\n# Extract each clip (1.5 seconds: 0.5 before, 1.0 after the timestamp)\nclip_files = []\nfor i, filler in enumerate(fillers):\n    timestamp = filler['timestamp']\n    start_time = max(0, timestamp - 0.5)  # 0.5 seconds before\n    duration = 1.5  # Total duration of clip\n    \n    output_file = f'/tmp/clips/clip_{i:04d}.mp4'\n    clip_files.append(output_file)\n    \n    # Extract clip using ffmpeg\n    cmd = [\n        'ffmpeg', '-y', '-i', '/root/input.mp4',\n        '-ss', str(start_time),\n        '-t', str(duration),\n        '-c:v', 'libx264', '-c:a', 'aac',\n        '-avoid_negative_ts', 'make_zero',\n        output_file\n    ]\n    \n    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    if (i + 1) % 10 == 0:\n        print(f\"Extracted {i + 1}/{len(fillers)} clips...\")\n\nprint(f\"Extracted all {len(fillers)} clips\")\n\n# Create concat file for ffmpeg\nconcat_file = '/tmp/clips/concat.txt'\nwith open(concat_file, 'w') as f:\n    for clip_file in clip_files:\n        f.write(f\"file '{clip_file}'\\n\")\n\nprint(\"Concatenating clips...\")\n# Concatenate all clips\ncmd = [\n    'ffmpeg', '-y', '-f', 'concat', '-safe', '0',\n    '-i', concat_file,\n    '-c', 'copy',\n    '/root/output.mp4'\n]\n\nresult = subprocess.run(cmd, capture_output=True, text=True)\nif result.returncode == 0:\n    print(\"Successfully created /root/output.mp4\")\nelse:\n    print(\"Error concatenating clips, trying with re-encoding...\")\n    # Try again with re-encoding if copy fails\n    cmd = [\n        'ffmpeg', '-y', '-f', 'concat', '-safe', '0',\n        '-i', concat_file,\n        '-c:v', 'libx264', '-c:a', 'aac',\n        '/root/output.mp4'\n    ]\n    subprocess.run(cmd)\n    print(\"Created /root/output.mp4 with re-encoding\")\n\n# Cleanup\nimport shutil\nshutil.rmtree('/tmp/clips')\nprint(\"Cleanup complete\")\nEOF\n"]
