[?2004l[?2004h>     fillers = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Processing {len(fillers)} filler word clips...")
[?2004l[?2004h> 
[?2004l[?2004h> # Create temporary directory for clips
[?2004l[?2004h> os.makedirs('/tmp/clips', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Extract each clip (1.5 seconds: 0.5 before, 1.0 after the timestamp)
[?2004l[?2004h> clip_files = []
[?2004l[?2004h> for i, filler in enumerate(fillers):
[?2004l[?2004h>     timestamp = filler['timestamp']
[?2004l[?2004h>     start_time = max(0, timestamp - 0.5)  # 0.5 seconds before
[?2004l[?2004h>     duration = 1.5  # Total duration of clip
[?2004l[?2004h>     
[?2004l[?2004h>     output_file = f'/tmp/clips/clip_{i:04d}.mp4'
[?2004l[?2004h>     clip_files.append(output_file)
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract clip using ffmpeg
[?2004l[?2004h>     cmd = [
[?2004l[?2004h>         'ffmpeg', '-y', '-i', '/root/input.mp4',
[?2004l[?2004h>         '-ss', str(start_time),
[?2004l[?2004h>         '-t', str(duration),
[?2004l[?2004h>         '-c:v', 'libx264', '-c:a', 'aac',
[?2004l[?2004h>         '-avoid_negative_ts', 'make_zero',
[?2004l[?2004h>         output_file
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
[?2004l[?2004h>     if (i + 1) % 10 == 0:
[?2004l[?2004h>         print(f"Extracted {i + 1}/{len(fillers)} clips...")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Extracted all {len(fillers)} clips")
[?2004l[?2004h> 
[?2004l[?2004h> # Create concat file for ffmpeg
[?2004l[?2004h> concat_file = '/tmp/clips/concat.txt'
[?2004l[?2004h> with open(concat_file, 'w') as f:
[?2004l[?2004h>     for clip_file in clip_files:
