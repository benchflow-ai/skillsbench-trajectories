syz_open_dev$ppdev(dev ptr[in, string["/dev/parport#"]], id intptr, flags flags[open_flags]) fd_ppdev

ioctl$PPSETMODE(fd fd_ppdev, cmd const[PPSETMODE], mode flags[ppdev_mode_flags])
ioctl$PPRSTATUS(fd fd_ppdev, cmd const[PPRSTATUS], val ptr[out, int8])
