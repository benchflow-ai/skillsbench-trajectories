 const[PPGETMODE], mode ptr[out, int32])\nioctl$PPGETPHASE(fd fd_ppdev, cmd const[PPGETPHASE], phase ptr[out, int32])\nioctl$PPGETFLAGS(fd fd_ppdev, cmd const[PPGETFLAGS], flags ptr[out, int32])\nioctl$PPSETFLAGS(fd fd_ppdev, cmd const[PPSETFLAGS], flags ptr[in, flags[ppdev_flags, int32]])\n\nppdev_frob_struct {\n\tmask int8\n\tval int8\n}\n\nppdev_mode_flags = IEEE1284_MODE_NIBBLE, IEEE1284_MODE_BYTE, IEEE1284_MODE_COMPAT, IEEE1284_MODE_BECP, IEEE1284_MODE_ECP, IEEE1284_MODE_ECPRLE, IEEE1284_MODE_ECPSWE, IEEE1284_MODE_EPP, IEEE1284_MODE_EPPSL, IEEE1284_MODE_EPPSWE, IEEE1284_DEVICEID, IEEE1284_EXT_LINK, IEEE1284_ADDR, IEEE1284_DATA\n\nppdev_flags = PP_FASTWRITE, PP_FASTREAD, PP_W91284PIC\nEOF\n"]
