[12.747594, "o", "\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.agents\u001b[0m\r\n-rw-r--r-- 1 root root 3106 Apr 22  2024 .bashrc\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.cache\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.claude\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.codex\u001b[0m\r\ndrwxr-xr-x 4 root root 4096 Jan 26 11:20 \u001b[01;34m.config\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.factory\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.gemini\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.goose\u001b[0m\r\ndrwxr-xr-x 3 root root 4096 Jan 26 06:53 \u001b[01;34m.opencode\u001b[0m\r\n-rw-r--r-- 1 root root  161 Apr 22  2024 .profile\r\n-rw-r--r-- 1 root root 5916 Jan 25 20:43 hvac_simulator.py\r\n-rw-r--r-- 1 root root  130 Jan 25 20:43 room_config.json\r\n"]
