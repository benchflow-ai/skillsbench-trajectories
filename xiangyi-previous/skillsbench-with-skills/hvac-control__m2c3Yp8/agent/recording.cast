[106.680116, "o", "    \r\n\u001b[?2004l\r"]
[106.680142, "o", "\u001b[?2004h> "]
[106.683495, "o", "    y = temps[1:] - T_ambient\r\n\u001b[?2004l\r\u001b[?2004h>     x1 = temps[:-1] - T_ambient\r\n\u001b[?2004l\r\u001b[?2004h>     x2 = powers[:-1]\r\n\u001b[?2004l\r\u001b[?2004h>     X = np.column_stack((x1, x2))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)\r\n\u001b[?2004l\r\u001b[?2004h>     A, B = coeffs\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Derived parameters\r\n\u001b[?2004l\r\u001b[?2004h>     # A = 1 - dt/tau  -> tau = dt / (1 - A)\r\n\u001b[?2004l\r\u001b[?2004h>     # B = K * dt / tau -> K = B * tau / dt = B / (1 - A)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     tau_est = dt / (1.0 - A)\r\n\u001b[?2004l\r\u001b[?2004h>     K_est = B / (1.0 - A)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.683619, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.683672, "o", "    # R-squared calculation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.683776, "o", "    y_pred = X @ coeffs\r\n\u001b[?2004l\r"]
[106.683831, "o", "\u001b[?2004h>     ss_res = np.sum((y - y_pred)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.683935, "o", "    ss_tot = np.sum((y - np.mean(y))**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.683989, "o", "> "]
[106.684121, "o", "    r_squared = 1 - (ss_res / ss_tot)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.684175, "o", "    est_params = {\r\n\u001b[?2004l\r"]
[106.684269, "o", "\u001b[?2004h> "]
[106.684322, "o", "        \"K\": float(K_est),\r\n\u001b[?2004l\r\u001b[?2004h>         \"tau\": float(tau_est),\r\n"]
[106.68437, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.684465, "o", "        \"r_squared\": float(r_squared),\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.684499, "o", "> "]
[106.684676, "o", "        \"fitting_error\": float(np.sqrt(ss_res / len(y)))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.684728, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.684916, "o", "    with open(\"estimated_params.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.68585, "o", "        json.dump(est_params, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Estimated K: {K_est:.4f}, tau: {tau_est:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # --- Step 3: Gain Tuning ---\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Tuning gains...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.685911, "o", "    # IMC Tuning for First Order Process\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.687503, "o", "    # Target settling time < 120s. \r\n\u001b[?2004l\r\u001b[?2004h>     # Settling time approx 4 * lambda.\r\n\u001b[?2004l\r\u001b[?2004h>     # We choose lambda = 25.0s (settling ~100s)\r\n\u001b[?2004l\r\u001b[?2004h>     lambda_val = 25.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # PI Gains\r\n\u001b[?2004l\r\u001b[?2004h>     # Kp = tau / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h>     # Ki = 1 / (K * lambda)\r\n\u001b[?2004l\r\u001b[?2004h>     Kp = tau_est / (K_est * lambda_val)\r\n\u001b[?2004l\r"]
[106.687555, "o", "\u001b[?2004h> "]
[106.687641, "o", "    Ki = 1.0 / (K_est * lambda_val)\r\n\u001b[?2004l\r"]
[106.687674, "o", "\u001b[?2004h> "]
[106.687711, "o", "    Kd = 0.0\r\n\u001b[?2004l\r"]
[106.687743, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[106.687776, "o", "\u001b[?2004h> "]
[106.687844, "o", "    tuned_gains = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.687948, "o", "        \"Kp\": float(Kp),\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.687984, "o", "> "]
[106.688052, "o", "        \"Ki\": float(Ki),\r\n\u001b[?2004l\r# \u001b[?2004h"]
[106.688084, "o", "> "]
[106.688154, "o", "        \"Kd\": float(Kd),\r\n\u001b[?2004l\r"]
[106.688187, "o", "\u001b[?2004h> "]
[106.688299, "o", "        \"lambda\": float(lambda_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.688337, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.688382, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.688428, "o", "> "]
[106.688543, "o", "    with open(\"tuned_gains.json\", \"w\") as f:\r\n\u001b[?2004l\r"]
[106.688583, "o", "\u001b[?2004h> "]
[106.688734, "o", "        json.dump(tuned_gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.688776, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.688827, "o", "> "]
[106.688951, "o", "    print(f\"Gains: Kp={Kp:.4f}, Ki={Ki:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.68899, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.689135, "o", "    # --- Step 4: Closed-loop Control ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.689176, "o", "> "]
[106.689261, "o", "    print(\"Running control...\")\r\n\u001b[?2004l\r"]
[106.689302, "o", "\u001b[?2004h> "]
[106.689346, "o", "    sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.689431, "o", "    setpoint = 22.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.689514, "o", "    duration = 160.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.689558, "o", "> "]
[106.689626, "o", "    steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.689667, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.689708, "o", "> "]
[106.689753, "o", "    control_data = []\r\n\u001b[?2004l\r"]
[106.689794, "o", "\u001b[?2004h> "]
[106.689853, "o", "    integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.689931, "o", "    prev_error = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.689971, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.690006, "o", "> "]
[106.690065, "o", "    # Get initial state\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.690104, "o", "> "]
[106.690346, "o", "    # Note: simulator reset returns initial temp but doesn't give full dict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.690558, "o", "    # We need to manually construct the first log or just start loop\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.690614, "o", "> "]
[106.690924, "o", "    # Let's get initial reading properly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.690994, "o", "    current_temp = sim._get_measurement() # accessing internal for initial reading consistent with reset\r\n\u001b[?2004l\r\u001b[?2004h>     # Actually sim.reset() returns the temp.\r\n\u001b[?2004l\r\u001b[?2004h>     current_temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[106.691171, "o", "\u001b[?2004h>     for i in range(steps):"]
[106.691225, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         # Current time\r\n\u001b[?2004l\r\u001b[?2004h>         t = i * dt\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.691266, "o", "        error = setpoint - current_temp\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.691309, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.69135, "o", "        # PI Control\r\n\u001b[?2004l\r"]
[106.691415, "o", "\u001b[?2004h> "]
[106.692625, "o", "        # Proportional\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.692679, "o", "        P = Kp * error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Integral with anti-windup clamping logic\r\n\u001b[?2004l\r\u001b[?2004h>         # We calculate tentative integral term\r\n\u001b[?2004l\r\u001b[?2004h>         integral_tentative = integral + error * dt\r\n\u001b[?2004l\r\u001b[?2004h>         I = Ki * integral_tentative\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Derivative (on error)\r\n\u001b[?2004l\r\u001b[?2004h>         if i == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             D = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             D = Kd * (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>         u = P + I + D\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Actuator saturation\r\n\u001b[?2004l\r\u001b[?2004h>         u_clamped = np.clip(u, 0.0, 100.0)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Back-calculation / Clamping for integrator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.692843, "o", "        # If output is saturated, do not update integral if error is driving it further into saturation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.692992, "o", "        # Simple method: only update integral if not saturated OR if error helps desaturate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.693056, "o", "        if (u_clamped == u):\r\n\u001b[?2004l\r"]
[106.693078, "o", "\u001b[?2004h> "]
[106.69315, "o", "            integral = integral_tentative\r\n\u001b[?2004l\r"]
[106.693179, "o", "\u001b[?2004h> "]
[106.693202, "o", "        else:\r\n\u001b[?2004l\r"]
[106.693228, "o", "\u001b[?2004h> "]
[106.693345, "o", "            # Saturated. Check sign.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.693443, "o", "            # If u > 100 and error < 0 (trying to reduce), allow integration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.693571, "o", "            # If u < 0 and error > 0 (trying to increase), allow integration\r\n\u001b[?2004l\r"]
[106.693596, "o", "\u001b[?2004h> "]
[106.693656, "o", "            # Otherwise keep old integral\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.693689, "o", "> "]
[106.693783, "o", "            if (u > 100 and error < 0) or (u < 0 and error > 0):\r\n\u001b[?2004l\r"]
[106.693834, "o", "\u001b[?2004h> "]
[106.693874, "o", "                integral = integral_tentative\r\n\u001b[?2004l\r"]
[106.693929, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[106.69397, "o", "\u001b[?2004h>         # Apply to plant\r\n"]
[106.694018, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.69406, "o", "        res = sim.step(u_clamped)\r\n\u001b[?2004l\r"]
[106.694114, "o", "\u001b[?2004h> "]
[106.694153, "o", "        current_temp = res[\"temperature\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.694202, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.694243, "o", "        log_entry = {\r\n\u001b[?2004l\r"]
[106.694296, "o", "\u001b[?2004h> "]
[106.694335, "o", "            \"time\": res[\"time\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.69441, "o", "            \"temperature\": res[\"temperature\"],\r\n\u001b[?2004l\r"]
[106.694465, "o", "\u001b[?2004h> "]
[106.694505, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.694579, "o", "            \"heater_power\": res[\"heater_power\"],\r\n\u001b[?2004l\r"]
[106.694605, "o", "\u001b[?2004h> "]
[106.694666, "o", "            \"error\": round(error, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.694695, "o", ">         }"]
[106.694717, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.694782, "o", "        control_data.append(log_entry)\r\n\u001b[?2004l\r"]
[106.694812, "o", "\u001b[?2004h> "]
[106.694947, "o", "        prev_error = error\r\n"]
[106.695062, "o", "\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.695243, "o", "    with open(\"control_log.json\", \"w\") as f:"]
[106.695392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump({\r\n\u001b[?2004l\r\u001b[?2004h>             \"phase\": \"control\","]
[106.695456, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             \"setpoint\": setpoint,"]
[106.695565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.695642, "o", ">             \"data\": control_data"]
[106.695704, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.695788, "o", "        }, f, indent=2)"]
[106.69583, "o", "\r\n\u001b[?2004l\r"]
[106.695888, "o", "\u001b[?2004h"]
[106.695929, "o", "> "]
[106.695973, "o", "\r\n\u001b[?2004l\r"]
[106.696017, "o", "\u001b[?2004h"]
[106.696108, "o", ">     # --- Step 5: Metrics ---"]
[106.696153, "o", "\r\n\u001b[?2004l\r"]
[106.696208, "o", "\u001b[?2004h"]
[106.696331, "o", "> "]
[106.696385, "o", "    temps_ctrl = [d[\"temperature\"] for d in control_data]"]
[106.696427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.696534, "o", "    times_ctrl = [d[\"time\"] for d in control_data]"]
[106.696589, "o", "\r\n"]
[106.696634, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.696677, "o", "    "]
[106.696785, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.696837, "o", ">     max_temp = max(temps_ctrl)"]
[106.696884, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.696972, "o", ">     final_temp = temps_ctrl[-1]"]
[106.697028, "o", "\r\n\u001b[?2004l\r"]
[106.697144, "o", "\u001b[?2004h"]
[106.697193, "o", ">     steady_state_error = abs(final_temp - setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.697252, "o", "> "]
[106.697292, "o", "    \r\n\u001b[?2004l\r"]
[106.697367, "o", "\u001b[?2004h"]
[106.697416, "o", ">     # Overshoot"]
[106.697532, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.697582, "o", "    # (Max - Setpoint) / (Setpoint - Initial)\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.697678, "o", ">     # Initial is approx 18.0"]
[106.697728, "o", "\r\n"]
[106.697773, "o", "\u001b[?2004l\r\u001b[?2004h"]
[106.697903, "o", ">     initial_temp_ctrl = control_data[0][\"temperature\"]"]
[106.697957, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.698166, "o", ">     step_size = setpoint - initial_temp_ctrl\r\n\u001b[?2004l\r\u001b[?2004h>     overshoot_val = max(0.0, max_temp - setpoint)\r\n\u001b[?2004l\r"]
[106.698221, "o", "\u001b[?2004h> "]
[106.698363, "o", "    overshoot_pct = overshoot_val / step_size if step_size > 0 else 0.0"]
[106.698414, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.698453, "o", "> "]
[106.698494, "o", "    "]
[106.698536, "o", "\r\n\u001b[?2004l\r"]
[106.698601, "o", "\u001b[?2004h"]
[106.698677, "o", ">     # Rise time (10% to 90%)"]
[106.698823, "o", "\r\n"]
[106.698884, "o", "\u001b[?2004l\r\u001b[?2004h>     low_bound = initial_temp_ctrl + 0.1 * step_size"]
[106.699007, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.699061, "o", ">     high_bound = initial_temp_ctrl + 0.9 * step_size"]
[106.699241, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.699294, "o", ">     t_10 = next((d[\"time\"] for d in control_data if d[\"temperature\"] >= low_bound), None)"]
[106.69934, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.699536, "o", "    t_90 = next((d[\"time\"] for d in control_data if d[\"temperature\"] >= high_bound), None)"]
[106.699595, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.699759, "o", ">     rise_time = (t_90 - t_10) if (t_10 is not None and t_90 is not None) else 0.0"]
[106.69981, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.699851, "o", "> "]
[106.699902, "o", "    "]
[106.699959, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.700033, "o", ">     # Settling time"]
[106.700094, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.700134, "o", "> "]
[106.700238, "o", "    # Time after which error stays within 0.5C"]
[106.700289, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.700328, "o", "> "]
[106.700397, "o", "    settling_time = 0.0"]
[106.700451, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.700549, "o", ">     for d in reversed(control_data):"]
[106.700601, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.700718, "o", ">         if abs(d[\"temperature\"] - setpoint) > 0.5:"]
[106.70077, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.70089, "o", ">             # Found the last point outside band"]
[106.700951, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.701105, "o", ">             # Settling time is the time of the NEXT point (or this point?)"]
[106.701157, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.701225, "o", "> "]
[106.701328, "o", "            # Usually defined as time to enter and stay."]
[106.701372, "o", "\r\n\u001b[?2004l\r"]
[106.701416, "o", "\u001b[?2004h"]
[106.701456, "o", "> "]
[106.701615, "o", "            # So if this point is at T, and it's outside, the settling time is > T."]
[106.701674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.701774, "o", ">             settling_time = d[\"time\"]"]
[106.701821, "o", "\r\n\u001b[?2004l\r"]
[106.701864, "o", "\u001b[?2004h"]
[106.701907, "o", "> "]
[106.70197, "o", "            break"]
[106.702014, "o", "\r\n\u001b[?2004l\r"]
[106.702059, "o", "\u001b[?2004h"]
[106.702096, "o", "> "]
[106.702136, "o", "    "]
[106.702177, "o", "\r\n\u001b[?2004l\r"]
[106.702219, "o", "\u001b[?2004h"]
[106.702258, "o", "> "]
[106.702316, "o", "    metrics = {"]
[106.702358, "o", "\r\n\u001b[?2004l\r"]
[106.70241, "o", "\u001b[?2004h"]
[106.702506, "o", "> "]
[106.7026, "o", "        \"rise_time\": round(rise_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.702677, "o", "        \"overshoot\": round(overshoot_pct, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.702724, "o", "        \"settling_time\": round(settling_time, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.702776, "o", "> "]
[106.70283, "o", "        \"steady_state_error\": round(steady_state_error, 4),\r\n\u001b[?2004l\r"]
[106.702873, "o", "\u001b[?2004h> "]
[106.702947, "o", "        \"max_temp\": round(max_temp, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.702993, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.703064, "o", "    with open(\"metrics.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.703147, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.703194, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.703232, "o", "    print(\"Metrics:\", metrics)\r\n\u001b[?2004l\r"]
[106.703271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.703326, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[106.703406, "o", "\u001b[?2004h> "]
[106.703466, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
