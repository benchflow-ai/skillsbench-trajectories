[39.919159, "o", "\u001b[?2004h> "]
[39.919216, "o", "    case i: Int => _numericTokenizer.tokenize(i)\r\n\u001b[?2004l\r"]
[39.919266, "o", "\u001b[?2004h> "]
[39.919307, "o", "    case l: Long => _numericTokenizer.tokenize(l)\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.919357, "o", "> "]
