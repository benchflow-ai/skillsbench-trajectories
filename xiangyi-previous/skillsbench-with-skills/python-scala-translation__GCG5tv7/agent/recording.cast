[30.72462, "o", "\u001b[?2004hroot@1f5240b60e61:~# "]
[39.91225, "i", "cat << 'EOF' >> /root/Tokenizer.scala\n\n// ============================================================================\n// Tokenizer Implementations\n// ============================================================================\n\ntrait BaseTokenizer[T] {\n  def tokenize(value: T): Token\n\n  def tokenizeBatch(values: Iterable[T]): Iterator[Token] = {\n    values.iterator.map(tokenize)\n  }\n}\n\nclass StringTokenizer(\n    encoding: String = \"UTF-8\",\n    normalizer: String => String = identity\n) extends BaseTokenizer[Either[String, Array[Byte]]] {\n  // In Scala, we can use Either to represent str or bytes, or just have overloads.\n  // Given the python code used Union[str, bytes], Either or overloads are appropriate.\n  \n  def tokenize(value: Either[String, Array[Byte]]): Token = {\n    val strValue = value match {\n      case Left(s) => s\n      case Right(b) => new String(b, encoding)\n    }\n    Token(normalizer(strValue), TokenType.STRING)\n  }\n\n  // Convenience overloads\n  def tokenize(s: String): Token = tokenize(Left(s))\n  def tokenize(b: Array[Byte]): Token = tokenize(Right(b))\n}\n\nclass NumericTokenizer(\n    precision: Int = 6,\n    formatOptions: Map[String, Any] = Map.empty\n) extends BaseTokenizer[Any] { // Using Any to handle Int, Long, Float, Double, BigDecimal\n\n  def tokenize(value: Any): Token = {\n    val strValue = value match {\n      case d: BigDecimal => s\"%.${precision}f\".format(d)\n      case d: Double => s\"%.${precision}f\".format(d)\n      case f: Float => s\"%.${precision}f\".format(f)\n      case i: Int => i.toString\n      case l: Long => l.toString\n      case _ => value.toString\n    }\n    Token(strValue, TokenType.NUMERIC, Map(\"original_type\" -> value.getClass.getSimpleName))\n  }\n}\n\nclass TemporalTokenizer(formatStr: Option[String] = None) extends BaseTokenizer[Any] {\n  private val ISO_FORMAT = DateTimeFormatter.ofPattern(\"yyyy-MM-dd'T'HH:mm:ss\")\n  private val DATE_FORMAT = DateTimeFormatter.ofPattern(\"yyyy-MM-dd\")\n\n  def tokenize(value: Any): Token = {\n    val formatted = (value, formatStr) match {\n      case (dt: LocalDateTime, Some(fmt)) => dt.format(DateTimeFormatter.ofPattern(fmt))\n      case (dt: LocalDateTime, None) => dt.format(ISO_FORMAT)\n      case (d: LocalDate, Some(fmt)) => d.format(DateTimeFormatter.ofPattern(fmt))\n      case (d: LocalDate, None) => d.format(DATE_FORMAT)\n      case (d: java.util.Date, Some(fmt)) => \n        new java.text.SimpleDateFormat(fmt).format(d)\n      case (d: java.util.Date, None) => \n        new java.text.SimpleDateFormat(\"yyyy-MM-dd'T'HH:mm:ss\").format(d)\n      case _ => value.toString\n    }\n    Token(formatted, TokenType.TEMPORAL)\n  }\n}\n\n// ============================================================================\n// Advanced: Union Types and Overloads\n// ============================================================================\n\nclass UniversalTokenizer {\n  private val _stringTokenizer = new StringTokenizer()\n  private val _numericTokenizer = new NumericTokenizer()\n  private val _temporalTokenizer = new TemporalTokenizer()\n\n  def tokenize(value: Any): Token = value match {\n    case null => Token(\"NULL\", TokenType.NULL)\n    case t: Tokenizable => Token(t.toToken(), TokenType.STRUCTURED)\n    case s: String => _stringTokenizer.tokenize(s)\n    case b: Array[Byte] => _stringTokenizer.tokenize(b)\n    case i: Int => _numericTokenizer.tokenize(i)\n    case l: Long => _numericTokenizer.tokenize(l)\n    case f: Float => _numericTokenizer.tokenize(f)\n    case d: Double => _numericTokenizer.tokenize(d)\n    case bd: BigDecimal => _numericTokenizer.tokenize(bd)\n    case dt: LocalDateTime => _temporalTokenizer.tokenize(dt)\n    case d: LocalDate => _temporalTokenizer.tokenize(d)\n    case d: java.util.Date => _temporalTokenizer.tokenize(d)\n    case _ => Token(value.toString, TokenType.STRING, Map(\"fallback\" -> true))\n  }\n}\nEOF\n"]
