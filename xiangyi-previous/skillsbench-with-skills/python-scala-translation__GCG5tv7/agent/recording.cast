[39.91831, "o", "class UniversalTokenizer {\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.91836, "o", "> "]
[39.918403, "o", "  private val _stringTokenizer = new StringTokenizer()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.918493, "o", "  private val _numericTokenizer = new NumericTokenizer()\r\n\u001b[?2004l\r"]
[39.918543, "o", "\u001b[?2004h> "]
[39.918597, "o", "  private val _temporalTokenizer = new TemporalTokenizer()\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.91865, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[39.918689, "o", "> "]
[39.918736, "o", "  def tokenize(value: Any): Token = value match {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.918793, "o", "    case null => Token(\"NULL\", TokenType.NULL)\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.918837, "o", "> "]
