[?2004l[?2004h>     // Simple JSON stringifier
[?2004l[?2004h>     value match {
[?2004l[?2004h>       case JsonString(s) => s"\"$s\""
[?2004l[?2004h>       case JsonNumber(n) => n.toString
[?2004l[?2004h>       case JsonBoolean(b) => b.toString
[?2004l[?2004h>       case JsonNull => "null"
[?2004l[?2004h>       case JsonArray(arr) => arr.map(stringify).mkString("[", ", ", "]")
[?2004l[?2004h>       case JsonObject(obj) => obj.map { case (k, v) => s"\"$k\": ${stringify(v)}" }.mkString("{", ", ", "}")
