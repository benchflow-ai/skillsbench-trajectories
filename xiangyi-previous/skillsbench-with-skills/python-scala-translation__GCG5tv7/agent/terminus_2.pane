[?2004l[?2004h> class WhitespaceTokenizer(
[?2004l[?2004h>     val lowercase: Boolean = false,
[?2004l[?2004h>     val minLength: Int = 0,
[?2004l[?2004h>     val maxLength: Option[Int] = None,
[?2004l[?2004h>     val stripPunctuation: Boolean = false
[?2004l[?2004h> ) {
[?2004l[?2004h>   private val punctuation = ".,!?;:'\"()[]{}".toSet
[?2004l[?2004h> 
[?2004l[?2004h>   private def processToken(word: String): Option[String] = {
[?2004l[?2004h>     var processed = word
[?2004l[?2004h>     if (stripPunctuation) {
[?2004l[?2004h>       processed = processed.replaceAll("^[" + java.util.regex.Pattern.quote(punctuation.mkString) + "]+", "")
[?2004l[?2004h>       processed = processed.replaceAll("[" + java.util.regex.Pattern.quote(punctuation.mkString) + "]+$", "")
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (lowercase) {
[?2004l[?2004h>       processed = processed.toLowerCase
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (processed.length < minLength) {
[?2004l[?2004h>       return None
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     maxLength.foreach { max =>
[?2004l[?2004h>       if (processed.length > max) {
[?2004l[?2004h>         processed = processed.substring(0, max)
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (processed.isEmpty) None else Some(processed)
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenize(text: String): List[Token] = {
[?2004l[?2004h>     text.split("\\s+").zipWithIndex.flatMap { case (word, i) =>
[?2004l[?2004h>       processToken(word).map { processed =>
[?2004l[?2004h>         Token(value = processed, tokenType = TokenType.STRING, metadata = Map("position" -> i, "original" -> word))
[?2004l[?2004h>       }
[?2004l[?2004h>     }.toList
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizeToStrings(text: String): List[String] = {
[?2004l[?2004h>     tokenize(text).map(_.value)
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {
[?2004l[?2004h>     var currentPos = 0
[?2004l[?2004h>     text.split("\\s+").flatMap { word =>
[?2004l[?2004h>       val start = text.indexOf(word, currentPos)
[?2004l[?2004h>       val end = start + word.length
[?2004l[?2004h>       currentPos = end
[?2004l[?2004h>       processToken(word).map { processed =>
[?2004l[?2004h>         (processed, start, end)
[?2004l[?2004h>       }
[?2004l[?2004h>     }.toList
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def countTokens(text: String): Int = {
[?2004l[?2004h>     tokenize(text).length
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
