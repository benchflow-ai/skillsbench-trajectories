[?2004l[?2004h> // Builder Pattern with Fluent Interface
[?2004l[?2004h> // ============================================================================
[?2004l[?2004h> 
[?2004l[?2004h> class TokenizerBuilder[T] {
[?2004l[?2004h>   private val _normalizers = mutable.ListBuffer.empty[String => String]
[?2004l[?2004h>   private val _validators = mutable.ListBuffer.empty[T => Boolean]
[?2004l[?2004h>   private val _metadata = mutable.Map.empty[String, Any]
[?2004l[?2004h> 
[?2004l[?2004h>   def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {
[?2004l[?2004h>     _normalizers += normalizer
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {
[?2004l[?2004h>     _validators += validator
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def withMetadata(metadata: (String, Any)*): TokenizerBuilder[T] = {
[?2004l[?2004h>     _metadata ++= metadata
[?2004l[?2004h>     this
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   def build(): T => Token = {
[?2004l[?2004h>     val normalizers = _normalizers.toList
[?2004l[?2004h>     val validators = _validators.toList
[?2004l[?2004h>     val metadata = _metadata.toMap
[?2004l[?2004h> 
[?2004l[?2004h>     (value: T) => {
[?2004l[?2004h>       for (validator <- validators) {
[?2004l[?2004h>         if (!validator(value)) {
[?2004l[?2004h>           throw new IllegalArgumentException(s"Validation failed for $value")
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       var strValue = value.toString
[?2004l[?2004h>       for (normalizer <- normalizers) {
[?2004l[?2004h>         strValue = normalizer(strValue)
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       Token(strValue, TokenType.STRING, metadata)
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
