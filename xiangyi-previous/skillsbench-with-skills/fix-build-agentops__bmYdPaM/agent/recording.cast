[55.843106, "o", "> "]
[55.843904, "o", "The `get_ISO_time()` function in `agentops/helpers.py` uses `timespec='milliseconds'` which only provides 3 decimal places of precision (e.g., '2024-05-04T02:36:17.528Z'). When an ActionEvent is instantiated, both `init_timestamp` and `end_timestamp` are set using the same default factory `get_ISO_time()`. If the event is recorded within the same millisecond it was created, both timestamps will be identical."]
[55.843955, "o", "\r\n"]
[55.843996, "o", "\u001b[?2004l\r"]
[55.844054, "o", "\u001b[?2004h"]
[55.844093, "o", "> "]
