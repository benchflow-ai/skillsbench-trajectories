[55.844161, "o", "\u001b[?2004l\r"]
[55.844205, "o", "\u001b[?2004h"]
[55.844242, "o", "> "]
[55.844732, "o", "The test expects that after a 0.15 second sleep between event creation and recording, the timestamps should be different. However, with only millisecond precision, if both operations happen within the same millisecond, the timestamps appear identical."]
[55.844784, "o", "\r\n"]
[55.844819, "o", "\u001b[?2004l\r"]
[55.844886, "o", "\u001b[?2004h"]
[55.844928, "o", "> "]
[55.844966, "o", "\r\n"]
[55.844996, "o", "\u001b[?2004l\r"]
[55.845042, "o", "\u001b[?2004h"]
[55.845078, "o", "> "]
[55.845116, "o", "Fix:"]
[55.845151, "o", "\r\n"]
[55.845186, "o", "\u001b[?2004l\r"]
[55.845236, "o", "\u001b[?2004h"]
[55.84527, "o", "> "]
[55.84579, "o", "Increase timestamp precision from milliseconds to microseconds by changing `timespec='milliseconds'` to `timespec='microseconds'` in the `get_ISO_time()` function. This will provide 6 decimal places of precision, allowing sub-millisecond differences to be captured."]
[55.845847, "o", "\r\n"]
