焊, 浮高, U202\"\r\nP1_POWER,P1_POWER-SD-018,Cold solder suspected: Q15,SOLDER,COLD_SOLDER,ICT;FCT,\"cold solder, 虚焊, 浮高, Q15\"\r\nP1_POWER,P1_POWER-TS-019,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-TS-020,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-TS-021,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-TS-022,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-TS-023,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-TS-024,Fixture contact unstable (pogo pin / clamp),TEST_SYSTEM,FIXTURE_CONTACT,ICT;FCT;FUNC;BST,\"fixture, pogo, 接触不良, 探针, reseat\"\r\nP1_POWER,P1_POWER-SW-025,Programming failed (flash write),FW_SW,FLASH_FAIL,FLASH;FCT,\"flash fail, 烧录失败, write fail, program fail\"\r\nP1_POWER,P1_POWER-SW-026,Programming failed (flash write),FW_SW,FLASH_FAIL,FLASH;FCT,\"flash fail, 烧录失败, write fail, program fail\"\r\nP1_POWER,P1_POWER-SW-027,Programming failed (flash write),FW_SW,FLASH_FAIL,FLASH;FCT,\"flash fail, 烧录失败, write fail, program fail\"\r\nP1_POWER,P1_POWER-SW-028,Programming failed (flash write),FW_SW,FLASH_FAIL,FLASH;FCT,\"flash fail, 烧录失败, write fail, program fail\"\r\nP1_POWER,P1_POWER-SW-029,Programming failed (flash write),FW_SW,FLASH_FAIL,FLASH;FCT,\"flash fail, 烧录失败, write fail, program fail\"\r\n"]
