[220.781188, "o", ">             product_id = row['product_id'].strip()\r\n\u001b[?2004l\r\u001b[?2004h>             station = row['station'].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.781281, "o", "            engineer_id = row['engineer_id'].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.781371, "o", "            raw_reason = row['raw_reason_text'].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.781448, "o", ">             \r\n\u001b[?2004l\r"]
[220.781518, "o", "\u001b[?2004h> "]
[220.78159, "o", "            if not record_id or not product_id or not raw_reason:\r\n\u001b[?2004l\r"]
[220.781662, "o", "\u001b[?2004h>                 continue\r\n"]
[220.784722, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[220.784817, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.784897, "o", "            # Get the appropriate codebook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.784968, "o", "            if product_id not in codebooks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785036, "o", "                continue\r\n\u001b[?2004l\r"]
[220.785109, "o", "\u001b[?2004h> "]
[220.785182, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785253, "o", "            product_codebook = codebooks[product_id]\r\n\u001b[?2004l\r"]
[220.785323, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.78544, "o", "            # Segment the raw reason text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785535, "o", "            segments = segment_text(raw_reason)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785616, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.7857, "o", "            normalized = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785784, "o", "            segment_idx = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.785874, "o", "            for segment in segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.785953, "o", "> "]
[220.786024, "o", "                if not segment or len(segment) < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.786096, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.78617, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.786246, "o", "                match = match_segment(segment, product_codebook, station)\r\n\u001b[?2004l\r"]
[220.786318, "o", "\u001b[?2004h> "]
[220.786375, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.786428, "o", "                normalized.append({\r\n\u001b[?2004l\r"]
[220.786481, "o", "\u001b[?2004h> "]
[220.786582, "o", "                    'segment_id': f'{record_id}-S{segment_idx}',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.786694, "o", "                    'span_text': segment,\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.786744, "o", "> "]
[220.786806, "o", "                    'pred_code': match['code'],\r\n\u001b[?2004l\r"]
[220.786859, "o", "\u001b[?2004h> "]
[220.786933, "o", "                    'pred_label': match['label'],\r\n\u001b[?2004l\r"]
[220.786983, "o", "\u001b[?2004h> "]
[220.787178, "o", "                    'confidence': round(match['confidence'], 3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.787307, "o", "                    'rationale': generate_rationale(match, segment)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.787381, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.78744, "o", "                segment_idx += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.787501, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.787558, "o", "            if normalized:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.78765, "o", "                results['records'].append({\r\n\u001b[?2004l\r"]
[220.787707, "o", "\u001b[?2004h> "]
[220.787761, "o", "                    'record_id': record_id,\r\n\u001b[?2004l\r"]
[220.787813, "o", "\u001b[?2004h> "]
[220.787867, "o", "                    'product_id': product_id,\r\n\u001b[?2004l\r"]
[220.78792, "o", "\u001b[?2004h> "]
[220.787977, "o", "                    'station': station,\r\n\u001b[?2004l\r"]
[220.788036, "o", "\u001b[?2004h> "]
[220.788103, "o", "                    'engineer_id': engineer_id,\r\n\u001b[?2004l\r"]
[220.788156, "o", "\u001b[?2004h> "]
[220.78823, "o", "                    'raw_reason_text': raw_reason,\r\n\u001b[?2004l\r"]
[220.788283, "o", "\u001b[?2004h> "]
[220.78885, "o", "                    'normalized': normalized\r\n\u001b[?2004l\r"]
[220.788995, "o", "\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create output directory\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/app/output', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Process and save\r\n\u001b[?2004l\r\u001b[?2004h> results = process_logs()\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/output/solution.json', 'w', encoding='utf-8') as f:"]
