[336.84259, "i", "python3 << 'PYEOF'\nimport json\n\nwith open('/app/output/solution.json', 'r', encoding='utf-8') as f:\n    data = json.load(f)\n\n# Check records from different products\nfor product in ['P1_POWER', 'P2_CTRL', 'P3_RF']:\n    for record in data['records']:\n        if record['product_id'] == product:\n            print(f\"\\n=== {product} Sample ===\")\n            print(f\"Record: {record['record_id']}\")\n            print(f\"Station: {record['station']}\")\n            print(f\"Raw: {record['raw_reason_text'][:60]}...\")\n            print(f\"Segments: {len(record['normalized'])}\")\n            for i, seg in enumerate(record['normalized'][:2], 1):\n                print(f\"  S{i}: '{seg['span_text']}'\")\n                print(f\"      Code: {seg['pred_code']}, Label: {seg['pred_label'][:40]}...\")\n                print(f\"      Confidence: {seg['confidence']}, Rationale: {seg['rationale'][:50]}...\")\n            break\nPYEOF\n"]
