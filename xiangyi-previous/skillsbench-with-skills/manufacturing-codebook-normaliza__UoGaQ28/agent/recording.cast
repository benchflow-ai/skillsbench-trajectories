[308.92306, "i", "python3 << 'PYEOF'\nimport json\n\nwith open('/app/output/solution.json', 'r', encoding='utf-8') as f:\n    data = json.load(f)\n\nprint(f'Total records: {len(data[\"records\"])}')\n\n# Count by product\nproduct_counts = {}\nfor record in data['records']:\n    product = record['product_id']\n    product_counts[product] = product_counts.get(product, 0) + 1\n\nprint(f'Records by product:')\nfor product, count in sorted(product_counts.items()):\n    print(f'  {product}: {count}')\n\n# Sample record\nif data['records']:\n    sample = data['records'][10]\n    print(f'\\nSample record R{sample[\"record_id\"][-7:]}:')\n    print(f'  Product: {sample[\"product_id\"]}')\n    print(f'  Station: {sample[\"station\"]}')\n    print(f'  Raw reason: {sample[\"raw_reason_text\"][:80]}...')\n    print(f'  Segments: {len(sample[\"normalized\"])}')\n    for seg in sample['normalized'][:2]:\n        print(f'    - {seg[\"span_text\"]}: {seg[\"pred_code\"]} (conf: {seg[\"confidence\"]})')\nPYEOF\n"]
