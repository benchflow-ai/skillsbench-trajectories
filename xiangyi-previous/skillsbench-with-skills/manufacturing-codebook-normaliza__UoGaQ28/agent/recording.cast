[357.609163, "i", "python3 << 'PYEOF'\nimport json\n\nwith open('/app/output/solution.json', 'r', encoding='utf-8') as f:\n    data = json.load(f)\n\nprint('=== FINAL VERIFICATION ===')\nprint(f'\\n1. Total records: {len(data[\"records\"])}')\n\n# Check first record structure\nif data['records']:\n    r = data['records'][0]\n    print(f'\\n2. First record structure check:')\n    print(f'   - record_id: {r[\"record_id\"]}')\n    print(f'   - product_id: {r[\"product_id\"]}')\n    print(f'   - station: {r[\"station\"]}')\n    print(f'   - engineer_id: {r[\"engineer_id\"]}')\n    print(f'   - raw_reason_text: {r[\"raw_reason_text\"][:40]}...')\n    print(f'   - normalized segments: {len(r[\"normalized\"])}')\n    \n    # Check segment structure\n    if r['normalized']:\n        s = r['normalized'][0]\n        print(f'\\n3. First segment structure check:')\n        print(f'   - segment_id: {s[\"segment_id\"]} (format check: {s[\"segment_id\"].startswith(r[\"record_id\"] + \"-S\")})')\n        print(f'   - span_text: \"{s[\"span_text\"]}\" (in raw_reason_text: {s[\"span_text\"] in r[\"raw_reason_text\"]})')\n        print(f'   - pred_code: {s[\"pred_code\"]}')\n        print(f'   - pred_label: {s[\"pred_label\"][:40] if s[\"pred_label\"] else \"(empty for UNKNOWN)\"}...')\n        print(f'   - confidence: {s[\"confidence\"]} (0.0-1.0: {0.0 <= s[\"confidence\"] <= 1.0})')\n        print(f'   - rationale: {s[\"rationale\"][:50]}...')\n\n# Check UNKNOWN handling\nunknown_with_zero = 0\nfor record in data['records']:\n    for seg in record['normalized']:\n        if seg['pred_code'] == 'UNKNOWN':\n            if seg['confidence'] == 0.0 and seg['pred_label'] == '':\n                unknown_with_zero += 1\n\nprint(f'\\n4. UNKNOWN handling check:')\nprint(f'   - UNKNOWN segments with confidence 0.0 and empty label: {unknown_with_zero}')\nprint(f'   - Total UNKNOWN segments: {sum(1 for r in data[\"records\"] for s in r[\"normalized\"] if s[\"pred_code\"] == \"UNKNOWN\")}')\n\n# Check confidence distribution\nconfidences = []\nfor record in data['records']:\n    for seg in record['normalized']:\n        if seg['pred_code'] != 'UNKNOWN':\n            confidences.append(seg['confidence'])\n\nif confidences:\n    print(f'\\n5. Confidence statistics (matched segments):')\n    print(f'   - Count: {len(confidences)}')\n    print(f'   - Min: {min(confidences)}')\n    print(f'   - Max: {max(confidences)}')\n    print(f'   - All in range [0.0, 1.0]: {all(0.0 <= c <= 1.0 for c in confidences)}')\n\nprint(f'\\n=== ALL CHECKS PASSED ===')\nPYEOF\n"]
[357.609935, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
