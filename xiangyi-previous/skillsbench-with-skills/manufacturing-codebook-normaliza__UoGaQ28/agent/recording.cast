[317.317787, "i", "python3 << 'PYEOF'\nimport json\nfrom collections import Counter\n\nwith open('/app/output/solution.json', 'r', encoding='utf-8') as f:\n    data = json.load(f)\n\n# Analyze confidence distribution\nconfidences = []\nunknown_count = 0\nmatched_count = 0\n\nfor record in data['records']:\n    for seg in record['normalized']:\n        if seg['pred_code'] == 'UNKNOWN':\n            unknown_count += 1\n        else:\n            matched_count += 1\n            confidences.append(seg['confidence'])\n\nprint(f'Total segments: {unknown_count + matched_count}')\nprint(f'Matched: {matched_count} ({100*matched_count/(unknown_count+matched_count):.1f}%)')\nprint(f'Unknown: {unknown_count} ({100*unknown_count/(unknown_count+matched_count):.1f}%)')\n\nif confidences:\n    confidences.sort()\n    print(f'\\nConfidence statistics (for matched segments):')\n    print(f'  Min: {min(confidences):.3f}')\n    print(f'  Max: {max(confidences):.3f}')\n    print(f'  Mean: {sum(confidences)/len(confidences):.3f}')\n    print(f'  Median: {confidences[len(confidences)//2]:.3f}')\n    print(f'  25th percentile: {confidences[len(confidences)//4]:.3f}')\n    print(f'  75th percentile: {confidences[3*len(confidences)//4]:.3f}')\nPYEOF\n"]
[317.31801, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
