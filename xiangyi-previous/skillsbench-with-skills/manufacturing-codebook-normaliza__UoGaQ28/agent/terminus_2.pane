[?2004l[?2004h> import csv
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> from difflib import SequenceMatcher
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Load codebooks
[?2004l[?2004h> def load_codebooks():
[?2004l[?2004h>     codebooks = {}
[?2004l[?2004h>     for product in ['P1_POWER', 'P2_CTRL', 'P3_RF']:
[?2004l[?2004h>         codebooks[product] = {}
[?2004l[?2004h>         with open(f'/app/data/codebook_{product}.csv', 'r', encoding='utf-8') as f:
[?2004l[?2004h>             reader = csv.DictReader(f)
[?2004l[?2004h>             for row in reader:
[?2004l[?2004h>                 code = row['code']
[?2004l[?2004h>                 codebooks[product][code] = {
[?2004l[?2004h>                     'standard_label': row['standard_label'],
[?2004l[?2004h>                     'category_lv1': row['category_lv1'],
[?2004l[?2004h>                     'category_lv2': row['category_lv2'],
[?2004l[?2004h>                     'station_scope': row['station_scope'],
[?2004l[?2004h>                     'keywords': [k.strip() for k in row['keywords_examples'].split(',')]
[?2004l[?2004h>                 }
[?2004l[?2004h>     return codebooks
[?2004l[?2004h> 
[?2004l[?2004h> # Segment raw reason text - improved for Chinese
[?2004l[?2004h> def segment_text(text):
[?2004l[?2004h>     # Split by common delimiters
[?2004l[?2004h>     segments = re.split(r'[，,；;/\\|、&\s]+', text)
[?2004l[?2004h>     segments = [s.strip() for s in segments if s.strip() and len(s.strip()) > 0]
[?2004l[?2004h>     return segments
[?2004l[?2004h> 
[?2004l,[?2004h> # Calculate similarity score
[?2004l[?2004h> def similarity_score(s1, s2):
[?2004l[?2004h>     return SequenceMatcher(None, s1.lower(), s2.lower()).ratio()
[?2004l[?2004h> 
[?2004l[?2004h> # Match segment to codebook - improved
[?2004l[?2004h> def match_segment(segment, codebook, station):
[?2004l[?2004h>     best_match = None
[?2004l[?2004h>     best_score = 0
[?2004l[?2004h>     best_code = 'UNKNOWN'
[?2004l[?2004h>     match_type = 'none'
[?2004l[?2004h>     
[?2004l[?2004h>     segment_lower = segment.lower()
[?2004l[?2004h>     
[?2004l[?2004h>     for code, entry in codebook.items():
[?2004l[?2004h>         # Check if station is in scope
[?2004l[?2004h>         if station not in entry['station_scope']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Keyword matching with partial match support
[?2004l[?2004h>         keyword_score = 0
[?2004l[?2004h>         matched_keyword = ''
[?2004l[?2004h>         for keyword in entry['keywords']:
[?2004l[?2004h>             keyword_lower = keyword.lower()
[?2004l[?2004h>             # Exact keyword match
[?2004l[?2004h>             if keyword_lower == segment_lower:
[?2004l[?2004h>                 keyword_score = 1.0
[?2004l[?2004h>                 matched_keyword = keyword
[?2004l[?2004h>                 break
[?2004l[?2004h>             # Substring match
[?2004l[?2004h>             elif keyword_lower in segment_lower or segment_lower in keyword_lower:
[?2004l[?2004h>                 # Calculate partial match score
[?2004l[?2004h>                 partial_score = len(set(segment_lower) & set(keyword_lower)) / max(len(set(segment_lower)), len(set(keyword_lower)))
[?2004l[?2004h>                 if partial_score > keyword_score:
[?2004l[?2004h>                     keyword_score = partial_score * 0.85
[?2004l[?2004h>                     matched_keyword = keyword
[?2004l[?2004h>         
[?2004l[?2004h>         # Similarity matching with label
[?2004l[?2004h>         label_sim = similarity_score(segment, entry['standard_label'])
[?2004l[?2004h>         
[?2004l[?2004h>         # Combined score (keyword matching has higher weight)
[?2004l[?2004h>         if keyword_score > 0:
[?2004l[?2004h>             combined_score = keyword_score * 0.7 + label_sim * 0.3
[?2004l[?2004h>             current_match_type = 'keyword'
[?2004l[?2004h>         else:
[?2004l[?2004h>             combined_score = label_sim * 0.5
[?2004l[?2004h>             current_match_type = 'similarity'
[?2004l[?2004h>         
[?2004l[?2004h>         if combined_score > best_score:
[?2004l[?2004h>             best_score = combined_score
[?2004l[?2004h>             best_match = entry
[?2004l[?2004h>             best_code = code
[?2004l[?2004h>             match_type = current_match_type
[?2004l[?2004h>     
[?2004l[?2004h>     # If no good match found, return UNKNOWN
[?2004l[?2004h>     if best_score < 0.35:
[?2004l[?2004h>         return {
[?2004l[?2004h>             'code': 'UNKNOWN',
[?2004l[?2004h>             'label': '',
[?2004l[?2004h>             'confidence': 0.0,
[?2004l[?2004h>             'match_type': 'none'
[?2004l[?2004h>         }
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'code': best_code,
[?2004l[?2004h>         'label': best_match['standard_label'],
[?2004l[?2004h>         'confidence': min(best_score, 1.0),
[?2004l[?2004h>         'match_type': match_type
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Generate rationale
[?2004l[?2004h> def generate_rationale(match, segment):
[?2004l[?2004h>     if match['code'] == 'UNKNOWN':
[?2004l[?2004h>         return f'No matching codebook entry found for "{segment}". Manual review recommended.'
[?2004l[?2004h>     elif match['match_type'] == 'keyword':
[?2004l[?2004h>         return f'Matched via keyword matching with confidence {round(match["confidence"], 3)}'
[?2004l[?2004h>     else:
[?2004l[?2004h>         return f'Matched via similarity analysis with confidence {round(match["confidence"], 3)}'
[?2004l[?2004h> 
[?2004l[?2004h> # Main processing
[?2004l[?2004h> def process_logs():
[?2004l[?2004h>     codebooks = load_codebooks()
[?2004l[?2004h>     results = {'records': []}
[?2004l[?2004h>     segment_counter = {}
[?2004l[?2004h>     
[?2004l[?2004h>     with open('/app/data/test_center_logs.csv', 'r', encoding='utf-8') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         for row in reader:
[?2004l[?2004h>             record_id = row['record_id'].strip()
[?2004l[?2004h>             product_id = row['product_id'].strip()
[?2004l[?2004h>             station = row['station'].strip()
[?2004l[?2004h>             engineer_id = row['engineer_id'].strip()
[?2004l[?2004h>             raw_reason = row['raw_reason_text'].strip()
[?2004l[?2004h>             
[?2004l[?2004h>             if not record_id or not product_id or not raw_reason:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # Get the appropriate codebook
[?2004l[?2004h>             if product_id not in codebooks:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             product_codebook = codebooks[product_id]
[?2004l[?2004h>             
[?2004l[?2004h>             # Segment the raw reason text
[?2004l[?2004h>             segments = segment_text(raw_reason)
[?2004l[?2004h>             
[?2004l[?2004h>             normalized = []
[?2004l[?2004h>             segment_idx = 1
[?2004l[?2004h>             for segment in segments:
[?2004l[?2004h>                 if not segment:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 
[?2004l[?2004h>                 match = match_segment(segment, product_codebook, station)
[?2004l[?2004h>                 
[?2004l[?2004h>                 normalized.append({
[?2004l[?2004h>                     'segment_id': f'{record_id}-S{segment_idx}',
[?2004l[?2004h>                     'span_text': segment,
[?2004l[?2004h>                     'pred_code': match['code'],
[?2004l[?2004h>                     'pred_label': match['label'],
[?2004l[?2004h>                     'confidence': round(match['confidence'], 3),
[?2004l[?2004h>                     'rationale': generate_rationale(match, segment)
[?2004l[?2004h>                 })
[?2004l[?2004h>                 segment_idx += 1
[?2004l[?2004h>             
[?2004l[?2004h>             if normalized:  # Only add records with normalized segments
[?2004l[?2004h>                 results['records'].append({
[?2004l[?2004h>                     'record_id': record_id,
[?2004l[?2004h>                     'product_id': product_id,
[?2004l[?2004h>                     'station': station,
[?2004l[?2004h>                     'engineer_id': engineer_id,
[?2004l[?2004h>                     'raw_reason_text': raw_reason,
[?2004l[?2004h>                     'normalized': normalized
[?2004l[?2004h>                 })
[?2004l[?2004h>     
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> # Create output directory
[?2004l[?2004h> os.makedirs('/app/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Process and save
[?2004l[?2004h> results = process_logs()
[?2004l[?2004h> with open('/app/output/solution.json', 'w', encoding='utf-8') as f:
[?2004l[?2004h>     json.dump(results, f, ensure_ascii=False, indent=2)
