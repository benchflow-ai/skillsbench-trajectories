[145.064184, "o", "\u001b[?2004h>     x = str(x).strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064246, "o", "    if x == '':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064275, "o", "        return np.nan"]
[145.064333, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064417, "o", "    # Replace comma with dot\r\n"]
[145.064466, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.06454, "o", "    x = x.replace(',', '.')"]
[145.064609, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064658, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064699, "o", "        return float(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064744, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064787, "o", "        return np.nan\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.064826, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064865, "o", "# Apply cleaning\r\n\u001b[?2004l\r"]
[145.064933, "o", "\u001b[?2004h> "]
[145.064957, "o", "for col in df.columns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.064996, "o", "    if col != 'patient_id':\r\n"]
[145.065037, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.065101, "o", "        df[col] = df[col].apply(clean_value)\r\n"]
[145.065146, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.065192, "o", "\u001b[?2004h> "]
[145.065286, "o", "# Drop rows with missing values\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.06534, "o", "> "]
[145.065382, "o", "df = df.dropna()\r\n\u001b[?2004l\r"]
[145.065426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.065468, "o", "\u001b[?2004h> "]
[145.065518, "o", "# Harmonization Rules\r\n"]
[145.065579, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.065695, "o", "# Feature: (Threshold, Operation, Factor)\r\n\u001b[?2004l\r"]
[145.065731, "o", "\u001b[?2004h> "]
[145.065867, "o", "# Operation: 'div' means if value > threshold, divide by factor\r\n\u001b[?2004l\r"]
[145.065912, "o", "\u001b[?2004h> "]
[145.065996, "o", "# Operation: 'mul' means if value < threshold, multiply by factor\r\n"]
[145.066036, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[145.066074, "o", "> rules = {\r\n\u001b[?2004l\r"]
[145.066111, "o", "\u001b[?2004h> "]
[145.066167, "o", "    'Serum_Creatinine': (20, 'div', 88.4),\r\n\u001b[?2004l\r"]
[145.066205, "o", "\u001b[?2004h> "]
[145.066249, "o", "    'BUN': (10, 'mul', 2.8),\r\n\u001b[?2004l\r"]
[145.066285, "o", "\u001b[?2004h> "]
[145.066678, "o", "    'Total_Bilirubin': (5, 'div', 17.1),\r\n\u001b[?2004l\r\u001b[?2004h>     'Direct_Bilirubin': (5, 'div', 17.1),\r\n\u001b[?2004l\r\u001b[?2004h>     'Albumin_Serum': (10, 'div', 10.0),\r\n\u001b[?2004l\r\u001b[?2004h>     'Total_Protein': (15, 'div', 10.0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.06677, "o", "> "]
[145.066842, "o", "    'Glucose': (30, 'mul', 18.0182),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.066926, "o", "    'Uric_Acid': (20, 'div', 59.48),\r\n\u001b[?2004l\r"]
[145.066963, "o", "\u001b[?2004h> "]
[145.067029, "o", "    'Serum_Iron': (40, 'mul', 5.58),\r\n\u001b[?2004l\r"]
[145.067072, "o", "\u001b[?2004h"]
[145.067109, "o", "> "]
[145.067215, "o", "    'Total_Cholesterol': (15, 'mul', 38.67),\r\n\u001b[?2004l\r"]
[145.06726, "o", "\u001b[?2004h> "]
[145.067334, "o", "    'LDL_Cholesterol': (15, 'mul', 38.67),\r\n"]
[145.067375, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.067438, "o", "    'HDL_Cholesterol': (15, 'mul', 38.67),\r\n\u001b[?2004l\r"]
[145.067476, "o", "\u001b[?2004h> "]
[145.067541, "o", "    'Non_HDL_Cholesterol': (15, 'mul', 38.67),\r\n"]
[145.067577, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.067638, "o", "    'Triglycerides': (10, 'mul', 88.57),\r\n"]
[145.06768, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.067727, "o", "    'Lactate': (10, 'mul', 9.008),\r\n"]
[145.067764, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.067823, "o", "    'pO2_Arterial': (20, 'mul', 7.5006),\r\n"]
[145.06786, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.06792, "o", "    'pCO2_Arterial': (10, 'mul', 7.5006),\r\n\u001b[?2004l\r"]
[145.067961, "o", "\u001b[?2004h> "]
[145.068045, "o", "    'Troponin_I': (100, 'div', 1000.0),\r\n\u001b[?2004l\r"]
[145.068106, "o", "\u001b[?2004h> "]
[145.06819, "o", "    'Troponin_T': (100, 'div', 1000.0),\r\n"]
[145.068268, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.068442, "o", "    'Magnesium': (1.2, 'mul', 2.43), # Assuming mmol/L < 1.2 -> mg/dL\r\n\u001b[?2004l\r"]
[145.068471, "o", "\u001b[?2004h> "]
[145.068657, "o", "    'Phosphate': (2.0, 'mul', 3.097), # Assuming mmol/L < 2.0 -> mg/dL"]
[145.068712, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.068909, "o", "    'Calcium': (4.0, 'mul', 4.0), # Assuming mmol/L < 4.0 -> mg/dL (approx factor 4)\r\n"]
[145.068961, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[145.06901, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.069059, "o", "\u001b[?2004h> "]
[145.069102, "o", "# Apply rules\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.069144, "o", "> "]
[145.06926, "o", "for col, (threshold, op, factor) in rules.items():\r\n"]
[145.069304, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.069384, "o", "    if col in df.columns:\r\n"]
[145.069429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.069494, "o", "        if op == 'div':\r\n"]
[145.069538, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.069661, "o", "            df[col] = df[col].apply(lambda x: x / factor if x > threshold else x)\r\n"]
[145.069704, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.069742, "o", "        elif op == 'mul':\r\n\u001b[?2004l\r"]
[145.069809, "o", "\u001b[?2004h> "]
[145.069973, "o", "            df[col] = df[col].apply(lambda x: x * factor if x < threshold else x)\r\n"]
[145.070027, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.070074, "o", "# Round to 2 decimal places\r\n\u001b[?2004l\r"]
[145.070116, "o", "\u001b[?2004h> "]
[145.070181, "o", "for col in df.columns:\r\n"]
[145.070238, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.070293, "o", "    if col != 'patient_id':\r\n\u001b[?2004l\r"]
[145.070333, "o", "\u001b[?2004h> "]
[145.070429, "o", "        df[col] = df[col].round(2)\r\n"]
[145.070469, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.070511, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.070556, "o", "# Save output"]
[145.070593, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.070717, "o", "df.to_csv('/root/ckd_lab_data_harmonized.csv', index=False, float_format='%.2f')\r\n\u001b[?2004l\r"]
[145.070762, "o", "\u001b[?2004h> "]
[145.070863, "o", "print(\"Harmonization complete. Saved to /root/ckd_lab_data_harmonized.csv\")\r\n"]
[145.070943, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[145.07098, "o", "\u001b[?2004l\r"]
