[?2004hroot@53e5f8d6f612:~# cat << 'EOF' > clean_and_inspect.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Function to clean numeric values
[?2004l[?2004h> def clean_value(x):
[?2004l[?2004h>     if pd.isna(x):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     if isinstance(x, (int, float)):
[?2004l[?2004h>         return float(x)
[?2004l[?2004h>     x = str(x).strip()
[?2004l[?2004h>     if x == '':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     # Replace comma with dot
[?2004l[?2004h>     x = x.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(x)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Apply cleaning to all columns except patient_id
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with any missing values
[?2004l[?2004h> initial_rows = len(df)
[?2004l[?2004h> df_clean = df.dropna()
[?2004l[?2004h> print(f"Dropped {initial_rows - len(df_clean)} rows with missing values. Remaining: {len(df_clean)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Print stats for each column to identify unit issues
[?2004l[?2004h> pd.set_option('display.max_rows', None)
[?2004l[?2004h> stats = df_clean.describe().transpose()[['min', 'max', 'mean', '50%']]
[?2004l[?2004h> print(stats)
[?2004l[?2004h> EOF
