[?2004hroot@53e5f8d6f612:~# cat << 'EOF' > harmonize.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> # We know the first row is header
[?2004l[?2004h> df = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Cleaning function
[?2004l[?2004h> def clean_value(x):
[?2004l[?2004h>     if pd.isna(x):
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     if isinstance(x, (int, float)):
[?2004l[?2004h>         return float(x)
[?2004l[?2004h>     x = str(x).strip()
[?2004l[?2004h>     if x == '':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     # Replace comma with dot
[?2004l[?2004h>     x = x.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(x)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Apply cleaning
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].apply(clean_value)
[?2004l[?2004h> 
[?2004l[?2004h> # Drop rows with missing values
[?2004l[?2004h> df = df.dropna()
[?2004l[?2004h> 
[?2004l[?2004h> # Harmonization Rules
[?2004l[?2004h> # Feature: (Threshold, Operation, Factor)
[?2004l[?2004h> # Operation: 'div' means if value > threshold, divide by factor
[?2004l[?2004h> # Operation: 'mul' means if value < threshold, multiply by factor
[?2004l[?2004h> 
[?2004l[?2004h> rules = {
[?2004l[?2004h>     'Serum_Creatinine': (20, 'div', 88.4),
[?2004l[?2004h>     'BUN': (10, 'mul', 2.8),
[?2004l[?2004h>     'Total_Bilirubin': (5, 'div', 17.1),
[?2004l[?2004h>     'Direct_Bilirubin': (5, 'div', 17.1),
[?2004l[?2004h>     'Albumin_Serum': (10, 'div', 10.0),
[?2004l[?2004h>     'Total_Protein': (15, 'div', 10.0),
[?2004l[?2004h>     'Glucose': (30, 'mul', 18.0182),
[?2004l[?2004h>     'Uric_Acid': (20, 'div', 59.48),
[?2004l[?2004h>     'Serum_Iron': (40, 'mul', 5.58),
[?2004l[?2004h>     'Total_Cholesterol': (15, 'mul', 38.67),
[?2004l[?2004h>     'LDL_Cholesterol': (15, 'mul', 38.67),
[?2004l[?2004h>     'HDL_Cholesterol': (15, 'mul', 38.67),
[?2004l[?2004h>     'Non_HDL_Cholesterol': (15, 'mul', 38.67),
[?2004l[?2004h>     'Triglycerides': (10, 'mul', 88.57),
[?2004l[?2004h>     'Lactate': (10, 'mul', 9.008),
[?2004l[?2004h>     'pO2_Arterial': (20, 'mul', 7.5006),
[?2004l[?2004h>     'pCO2_Arterial': (10, 'mul', 7.5006),
[?2004l[?2004h>     'Troponin_I': (100, 'div', 1000.0),
[?2004l[?2004h>     'Troponin_T': (100, 'div', 1000.0),
[?2004l[?2004h>     'Magnesium': (1.2, 'mul', 2.43), # Assuming mmol/L < 1.2 -> mg/dL
[?2004l[?2004h>     'Phosphate': (2.0, 'mul', 3.097), # Assuming mmol/L < 2.0 -> mg/dL
[?2004l[?2004h>     'Calcium': (4.0, 'mul', 4.0), # Assuming mmol/L < 4.0 -> mg/dL (approx factor 4)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Apply rules
[?2004l[?2004h> for col, (threshold, op, factor) in rules.items():
[?2004l[?2004h>     if col in df.columns:
[?2004l[?2004h>         if op == 'div':
[?2004l[?2004h>             df[col] = df[col].apply(lambda x: x / factor if x > threshold else x)
[?2004l[?2004h>         elif op == 'mul':
[?2004l[?2004h>             df[col] = df[col].apply(lambda x: x * factor if x < threshold else x)
[?2004l[?2004h> 
[?2004l[?2004h> # Round to 2 decimal places
[?2004l[?2004h> for col in df.columns:
[?2004l[?2004h>     if col != 'patient_id':
[?2004l[?2004h>         df[col] = df[col].round(2)
[?2004l[?2004h> 
[?2004l[?2004h> # Save output
[?2004l[?2004h> df.to_csv('/root/ckd_lab_data_harmonized.csv', index=False, float_format='%.2f')
[?2004l[?2004h> print("Harmonization complete. Saved to /root/ckd_lab_data_harmonized.csv")
[?2004l[?2004h> EOF
