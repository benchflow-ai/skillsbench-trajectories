[?2004l[?2004h> treatment_end = datetime(2020, 3, 31)
[?2004l[?2004h> 
[?2004l[?2004h> # Create daily sales by category
[?2004l[?2004h> purchases['Date'] = purchases['Order Date'].dt.date
[?2004l[?2004h> daily_category_sales = purchases.groupby(['Date', 'Category'])['Total_Spend'].sum().reset_index()
[?2004l[?2004h> daily_category_sales['Date'] = pd.to_datetime(daily_category_sales['Date'])
[?2004l[?2004h> 
