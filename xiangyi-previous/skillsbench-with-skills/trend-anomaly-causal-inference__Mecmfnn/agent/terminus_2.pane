[?2004l[?2004h>                 (purchases_top['Period'] == period)
[?2004l[?2004h>             ]
[?2004l[?2004h>             has_purchase = 1 if len(user_cat_period) > 0 else 0
[?2004l[?2004h>             extensive_data.append({
