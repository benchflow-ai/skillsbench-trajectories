[?2004l[?2004h>     if baseline_start <= date <= baseline_end:
[?2004l[?2004h>         return 'baseline'
[?2004l[?2004h>     elif treatment_start <= date <= treatment_end:
[?2004l[?2004h>         return 'treatment'
[?2004l[?2004h>     else:
[?2004l[?2004h>         return 'other'
