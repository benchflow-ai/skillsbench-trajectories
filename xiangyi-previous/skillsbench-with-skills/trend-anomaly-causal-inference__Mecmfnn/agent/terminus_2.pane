[?2004l[?2004hroot@57894e7c7587:/app# cat >> analysis.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: DiD Causal Analysis
[?2004l[?2004h> print("\nStep 5: Performing DiD causal analysis...")
[?2004l[?2004h> 
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> import statsmodels.api as sm
[?2004l[?2004h> from statsmodels.formula.api import ols
[?2004l[?2004h> 
[?2004l[?2004h> # Merge intensive data with features
[?2004l[?2004h> intensive_merged = intensive_df.merge(survey_fe, on='Survey ResponseID', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge extensive data with features
[?2004l[?2004h> extensive_merged = extensive_df.merge(survey_fe, on='Survey ResponseID', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # Function to perform univariate DiD for intensive margin
[?2004l[?2004h> def univariate_did_intensive(data, category, feature):
[?2004l[?2004h>     cat_data = data[data['Category'] == category].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if feature has variation
[?2004l[?2004h>     if cat_data[feature].nunique() < 2:
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     # Create treatment and post indicators
[?2004l[?2004h>     cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)
[?2004l[?2004h>     cat_data['treated'] = cat_data[feature]
[?2004l[?2004h>     cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']
[?2004l[?2004h>     
[?2004l[?2004h>     # Remove rows with missing values
[?2004l[?2004h>     cat_data = cat_data[['Total_Spend', 'post', 'treated', 'did_interaction']].dropna()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(cat_data) < 10:
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Run regression: Y = b0 + b1*post + b2*treated + b3*(post*treated)
[?2004l[?2004h>         X = cat_data[['post', 'treated', 'did_interaction']]
[?2004l[?2004h>         X = sm.add_constant(X)
[?2004l[?2004h>         y = cat_data['Total_Spend']
[?2004l[?2004h>         
[?2004l[?2004h>         model = sm.OLS(y, X).fit()
[?2004l[?2004h>         
[?2004l[?2004h>         # DiD estimate is the coefficient on the interaction term
[?2004l[?2004h>         did_estimate = model.params['did_interaction']
[?2004l[?2004h>         p_value = model.pvalues['did_interaction']
[?2004l[?2004h>         
[?2004l[?2004h>         return {
[?2004l[?2004h>             'feature': feature,
[?2004l[?2004h>             'did_estimate': round(float(did_estimate), 2),
[?2004l[?2004h>             'p_value': round(float(p_value), 4),
[?2004l[?2004h>             'method': 'Univariate DiD'
[?2004l[?2004h>         }
[?2004l[?2004h>     except:
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> # Function to perform multivariate heterogeneous DiD for extensive margin
[?2004l[?2004h> def multivariate_did_extensive(data, category, features):
[?2004l[?2004h>     cat_data = data[data['Category'] == category].copy()
[?2004l[?2004h>     cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)
[?2004l[?2004h>     
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for feature in features:
[?2004l[?2004h>         if cat_data[feature].nunique() < 2:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         cat_data['treated'] = cat_data[feature]
[?2004l[?2004h>         cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']
[?2004l[?2004h>         
[?2004l[?2004h>         # Prepare data
[?2004l[?2004h>         analysis_data = cat_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()
[?2004l[?2004h>         
[?2004l[?2004h>         if len(analysis_data) < 10:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             X = analysis_data[['post', 'treated', 'did_interaction']]
[?2004l[?2004h>             X = sm.add_constant(X)
[?2004l[?2004h>             y = analysis_data['Has_Purchase']
[?2004l[?2004h>             
[?2004l[?2004h>             model = sm.OLS(y, X).fit()
[?2004l[?2004h>             
[?2004l[?2004h>             did_estimate = model.params['did_interaction']
[?2004l[?2004h>             p_value = model.pvalues['did_interaction']
[?2004l[?2004h>             
[?2004l[?2004h>             results.append({
[?2004l[?2004h>                 'feature': feature,
[?2004l[?2004h>                 'did_estimate': round(float(did_estimate), 4),
[?2004l[?2004h>                 'p_value': round(float(p_value), 4),
[?2004l[?2004h>                 'method': 'Multivariate Heterogeneous DiD'
[?2004l[?2004h>             })
[?2004l[?2004h>         except:
[?2004l[?2004h>             continue
[?2004l[?2004h>     
[?2004l[?2004h>     return results
[?2004l[?2004h> 
