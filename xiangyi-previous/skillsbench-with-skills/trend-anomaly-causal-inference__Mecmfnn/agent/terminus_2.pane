[?2004l[?2004h> # Step 4: Create intensive margin data (optimized)
[?2004l[?2004h> print("\nStep 4: Creating intensive margin data (optimized)...")
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate spending by user-category-period
[?2004l[?2004h> intensive_agg = purchases_top.groupby(['Survey ResponseID', 'Category', 'Period'])['Total_Spend'].sum().reset_index()
[?2004l[?2004h> 
