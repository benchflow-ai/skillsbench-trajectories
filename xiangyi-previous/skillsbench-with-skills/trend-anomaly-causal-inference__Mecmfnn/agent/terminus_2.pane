[?2004hroot@57894e7c7587:/app# mkdir -p /app/output
[?2004l[?2004hroot@57894e7c7587:/app# cat > analysis.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> import json
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Data Cleaning
[?2004l[?2004h> print("Step 1: Loading and cleaning data...")
[?2004l[?2004h> 
[?2004l[?2004h> # Load survey data
[?2004l[?2004h> survey = pd.read_csv('/app/data/survey_dirty.csv')
[?2004l[?2004h> print(f"Survey raw shape: {survey.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Clean survey data
[?2004l[?2004h> # Remove duplicates based on Survey ResponseID
[?2004l[?2004h> survey = survey.drop_duplicates(subset=['Survey ResponseID'], keep='first')
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows where Survey ResponseID is missing
[?2004l[?2004h> survey = survey[survey['Survey ResponseID'].notna()]
[?2004l[?2004h> 
[?2004l[?2004h> # Save cleaned survey
[?2004l[?2004h> survey.to_csv('/app/output/survey_cleaned.csv', index=False)
[?2004l[?2004h> print(f"Survey cleaned shape: {survey.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Load purchases data
[?2004l[?2004h> purchases = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')
[?2004l[?2004h> print(f"Purchases raw shape: {purchases.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Clean purchases data
[?2004l[?2004h> # Convert Order Date to datetime
[?2004l[?2004h> purchases['Order Date'] = pd.to_datetime(purchases['Order Date'], errors='coerce')
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with missing critical fields
[?2004l[?2004h> purchases = purchases[purchases['Order Date'].notna()]
[?2004l[?2004h> purchases = purchases[purchases['Survey ResponseID'].notna()]
[?2004l[?2004h> purchases = purchases[purchases['Category'].notna()]
[?2004l[?2004h> purchases = purchases[purchases['Purchase Price Per Unit'].notna()]
[?2004l[?2004h> purchases = purchases[purchases['Quantity'].notna()]
[?2004l[?2004h> 
[?2004l[?2004h> # Remove duplicates
[?2004l[?2004h> purchases = purchases.drop_duplicates()
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate total spend per transaction
[?2004l[?2004h> purchases['Total_Spend'] = purchases['Purchase Price Per Unit'] * purchases['Quantity']
[?2004l[?2004h> 
[?2004l[?2004h> # Filter to only include 2019-2020 data
[?2004l[?2004h> purchases = purchases[(purchases['Order Date'].dt.year >= 2019) & (purchases['Order Date'].dt.year <= 2020)]
[?2004l[?2004h> 
[?2004l[?2004h> # Save cleaned purchases
[?2004l[?2004h> purchases.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)
[?2004l[?2004h> print(f"Purchases cleaned shape: {purchases.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@57894e7c7587:/app# cat >> analysis.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Anomaly Detection
[?2004l[?2004h> print("\nStep 2: Detecting anomalies in March 2020...")
[?2004l[?2004h> 
[?2004l[?2004h> # Define periods
[?2004l[?2004h> baseline_start = datetime(2020, 1, 1)
[?2004l[?2004h> baseline_end = datetime(2020, 2, 29)
[?2004l[?2004h> treatment_start = datetime(2020, 3, 1)
[?2004l[?2004h> treatment_end = datetime(2020, 3, 31)
[?2004l[?2004h> 
[?2004l[?2004h> # Create daily sales by category
[?2004l[?2004h> purchases['Date'] = purchases['Order Date'].dt.date
[?2004l[?2004h> daily_category_sales = purchases.groupby(['Date', 'Category'])['Total_Spend'].sum().reset_index()
[?2004l[?2004h> daily_category_sales['Date'] = pd.to_datetime(daily_category_sales['Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Get all categories
[?2004l[?2004h> categories = purchases['Category'].unique()
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_results = []
[?2004l[?2004h> 
[?2004l[?2004h> for category in categories:
[?2004l[?2004h>     cat_data = daily_category_sales[daily_category_sales['Category'] == category].copy()
[?2004l[?2004h>     cat_data = cat_data.sort_values('Date')
[?2004l[?2004h>     
[?2004l[?2004h>     # Historical data (before March 2020)
[?2004l[?2004h>     historical = cat_data[cat_data['Date'] < treatment_start]
[?2004l[?2004h>     
[?2004l[?2004h>     # March 2020 data
[?2004l[?2004h>     march_2020 = cat_data[(cat_data['Date'] >= treatment_start) & (cat_data['Date'] <= treatment_end)]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(historical) > 0 and len(march_2020) > 0:
[?2004l[?2004h>         # Calculate baseline statistics from historical data
[?2004l[?2004h>         hist_mean = historical['Total_Spend'].mean()
[?2004l[?2004h>         hist_std = historical['Total_Spend'].std()
[?2004l[?2004h>         
[?2004l[?2004h>         # March 2020 average
[?2004l[?2004h>         march_mean = march_2020['Total_Spend'].mean()
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate z-score
[?2004l[?2004h>         if hist_std > 0:
[?2004l[?2004h>             z_score = (march_mean - hist_mean) / hist_std
[?2004l[?2004h>         else:
[?2004l[?2004h>             z_score = 0
[?2004l[?2004h>         
[?2004l[?2004h>         # Convert to anomaly index (-100 to 100)
[?2004l[?2004h>         # Use tanh to bound the values
[?2004l[?2004h>         anomaly_index = np.tanh(z_score / 2) * 100
[?2004l[?2004h>         
[?2004l[?2004h>         anomaly_results.append({
[?2004l[?2004h>             'Category': category,
[?2004l[?2004h>             'Anomaly_Index': round(anomaly_index, 2)
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> # Create anomaly dataframe and save
[?2004l[?2004h> anomaly_df = pd.DataFrame(anomaly_results)
[?2004l[?2004h> anomaly_df = anomaly_df.sort_values('Anomaly_Index', ascending=False)
[?2004l[?2004h> anomaly_df.to_csv('/app/output/category_anomaly_index.csv', index=False)
[?2004l[?2004h> print(f"Anomaly detection complete. {len(anomaly_df)} categories analyzed.")
[?2004l[?2004h> 
[?2004l[?2004h> # Get top 10 surge and slump categories
[?2004l[?2004h> top_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()
[?2004l[?2004h> top_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Top 10 surge categories: {top_surge[:3]}...")
[?2004l[?2004h> print(f"Top 10 slump categories: {top_slump[:3]}...")
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@57894e7c7587:/app# cat >> analysis.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Feature Engineering on Demographics
[?2004l[?2004h> print("\nStep 3: Feature engineering on demographic data...")
[?2004l[?2004h> 
[?2004l[?2004h> survey_fe = survey.copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Create engineered features from survey data
[?2004l[?2004h> feature_cols = []
[?2004l[?2004h> 
[?2004l[?2004h> # Age groups
[?2004l[?2004h> for age_group in survey_fe['Q-demos-age'].dropna().unique():
[?2004l[?2004h>     col_name = f'age_{age_group.replace(" ", "_").replace("-", "to")}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-age'] == age_group).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Hispanic
[?2004l[?2004h> for val in survey_fe['Q-demos-hispanic'].dropna().unique():
[?2004l[?2004h>     col_name = f'hispanic_{val}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-hispanic'] == val).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Race
[?2004l[?2004h> for race in survey_fe['Q-demos-race'].dropna().unique():
[?2004l[?2004h>     col_name = f'race_{race.replace(" ", "_").replace(",", "").replace("or", "").replace("(", "").replace(")", "").replace("__", "_")}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-race'] == race).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Education
[?2004l[?2004h> for edu in survey_fe['Q-demos-education'].dropna().unique():
[?2004l[?2004h>     col_name = f'education_{edu.replace(" ", "_").replace(",", "").replace("'", "")}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-education'] == edu).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Income
[?2004l[?2004h> for inc in survey_fe['Q-demos-income'].dropna().unique():
[?2004l[?2004h>     col_name = f'income_{inc.replace(" ", "_").replace(",", "").replace("$", "").replace("-", "to")}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-income'] == inc).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Gender
[?2004l[?2004h> for gender in survey_fe['Q-demos-gender'].dropna().unique():
[?2004l[?2004h>     col_name = f'gender_{gender}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-demos-gender'] == gender).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # Sexual orientation
[?2004l[?2004h> for orient in survey_fe['Q-sexual-orientation'].dropna().unique():
[?2004l[?2004h>     col_name = f'orientation_{orient.replace(" ", "_").replace(",", "").replace("(", "").replace(")", "")}'
[?2004l[?2004h>     survey_fe[col_name] = (survey_fe['Q-sexual-orientation'] == orient).astype(int)
[?2004l[?2004h>     feature_cols.append(col_name)
[?2004l[?2004h> 
[?2004l[?2004h> # State
[?2004l[?2004h> for state in survey_fe['Q-demos-state'].dropna().unique():
[?2004l[?2004h>     col_name = f'state_{state.replace(" ", "_")}'
