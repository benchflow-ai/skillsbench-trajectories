        temp_data = cat_data.copy()
        temp_data['treated'] = temp_data[feature]
        temp_data['did_interaction'] = temp_data['post'] * temp_data['treated']
        
        analysis_data = temp_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()
        
        if len(analysis_data) < 10:
            continue
        
        try:
            X = analysis_data[['post', 'treated', 'did_interaction']]
            X = sm.add_constant(X)
            y = analysis_data['Has_Purchase']
            
