[656.337765, "o", "    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.337923, "o", "    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\r\n\u001b[?2004l\r"]
[656.338053, "o", "\u001b[?2004h> "]
[656.338232, "o", "    treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
