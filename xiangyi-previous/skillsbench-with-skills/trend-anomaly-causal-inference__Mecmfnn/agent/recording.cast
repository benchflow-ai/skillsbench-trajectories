[46.652228, "i", "cat >> analysis.py << 'EOF'\n\n# Step 2: Anomaly Detection\nprint(\"\\nStep 2: Detecting anomalies in March 2020...\")\n\n# Define periods\nbaseline_start = datetime(2020, 1, 1)\nbaseline_end = datetime(2020, 2, 29)\ntreatment_start = datetime(2020, 3, 1)\ntreatment_end = datetime(2020, 3, 31)\n\n# Create daily sales by category\npurchases['Date'] = purchases['Order Date'].dt.date\ndaily_category_sales = purchases.groupby(['Date', 'Category'])['Total_Spend'].sum().reset_index()\ndaily_category_sales['Date'] = pd.to_datetime(daily_category_sales['Date'])\n\n# Get all categories\ncategories = purchases['Category'].unique()\n\nanomaly_results = []\n\nfor category in categories:\n    cat_data = daily_category_sales[daily_category_sales['Category'] == category].copy()\n    cat_data = cat_data.sort_values('Date')\n    \n    # Historical data (before March 2020)\n    historical = cat_data[cat_data['Date'] < treatment_start]\n    \n    # March 2020 data\n    march_2020 = cat_data[(cat_data['Date'] >= treatment_start) & (cat_data['Date'] <= treatment_end)]\n    \n    if len(historical) > 0 and len(march_2020) > 0:\n        # Calculate baseline statistics from historical data\n        hist_mean = historical['Total_Spend'].mean()\n        hist_std = historical['Total_Spend'].std()\n        \n        # March 2020 average\n        march_mean = march_2020['Total_Spend'].mean()\n        \n        # Calculate z-score\n        if hist_std > 0:\n            z_score = (march_mean - hist_mean) / hist_std\n        else:\n            z_score = 0\n        \n        # Convert to anomaly index (-100 to 100)\n        # Use tanh to bound the values\n        anomaly_index = np.tanh(z_score / 2) * 100\n        \n        anomaly_results.append({\n            'Category': category,\n            'Anomaly_Index': round(anomaly_index, 2)\n        })\n\n# Create anomaly dataframe and save\nanomaly_df = pd.DataFrame(anomaly_results)\nanomaly_df = anomaly_df.sort_values('Anomaly_Index', ascending=False)\nanomaly_df.to_csv('/app/output/category_anomaly_index.csv', index=False)\nprint(f\"Anomaly detection complete. {len(anomaly_df)} categories analyzed.\")\n\n# Get top 10 surge and slump categories\ntop_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()\ntop_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()\n\nprint(f\"Top 10 surge categories: {top_surge[:3]}...\")\nprint(f\"Top 10 slump categories: {top_slump[:3]}...\")\n\nEOF\n"]
