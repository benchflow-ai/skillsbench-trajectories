[656.273624, "i", "_margin']) for r in slump_results),\n            'total_extensive_drivers': sum(len(r['extensive_margin']) for r in slump_results)\n        }\n    }\n}\n\nwith open('/app/output/causal_analysis_report.json', 'w') as f:\n    json.dump(final_report, f, indent=2)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"DiD Analysis Complete!\")\nprint(\"=\"*60)\nprint(f\"\\nTotal features analyzed: {len(feature_cols)}\")\nprint(f\"Surge categories: {len(surge_results)}\")\nprint(f\"Slump categories: {len(slump_results)}\")\nprint(f\"\\nFinal report saved to: /app/output/causal_analysis_report.json\")\nprint(\"\\nDone!\")\nENDOFFILE\n"]
