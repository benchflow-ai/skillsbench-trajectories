[656.277636, "o", "print(\"Loading data for DiD analysis...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.277682, "o", "> \r\n\u001b[?2004l\rv\u001b[?2004h> "]
[656.277744, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.278077, "o", "survey = pd.read_csv('/app/output/survey_cleaned.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.278451, "o", "purchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.278859, "o", "purchases['Order Date'] = pd.to_datetime(purchases['Order Date'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.279118, "o", "anomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.279493, "o", "survey_fe = pd.read_csv('/app/output/survey_feature_engineered.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.27993, "o", "intensive_df = pd.read_csv('/app/output/user_category_period_aggregated_intensive.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.280341, "o", "extensive_df = pd.read_csv('/app/output/user_category_period_aggregated_extensive.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.280644, "o", "print(f\"Intensive data: {intensive_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.280936, "o", "print(f\"Extensive data: {extensive_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[656.281177, "o", "# Get feature columns (exclude Survey ResponseID)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.281708, "o", "feature_cols = [col for col in survey_fe.columns if col != 'Survey ResponseID']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.281779, "o", "print(f\"Features to analyze: {len(feature_cols)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rb\u001b[?2004h> "]
[656.286839, "o", "# Define periods\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.286917, "o", "> "]
[656.289117, "o", "baseline_start = datetime(2020, 1, 1)\r\n\u001b[?2004l\r"]
[656.289286, "o", "\u001b[?2004h> "]
[656.289326, "o", "baseline_end = datetime(2020, 2, 29)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.289592, "o", "treatment_start = datetime(2020, 3, 1)\r\n\u001b[?2004l\r"]
[656.289635, "o", "\u001b[?2004h> "]
[656.289831, "o", "treatment_end = datetime(2020, 3, 31)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[656.289952, "o", "# Get top categories\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.290079, "o", "> "]
[656.290313, "o", "top_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()\r\n\u001b[?2004l\r"]
[656.290358, "o", "\u001b[?2004h> "]
[656.291012, "o", "top_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> top_categories = top_surge + top_slump\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[656.291095, "o", "# Filter purchases for statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.29174, "o", "purchases_top = purchases[purchases['Category'].isin(top_categories)].copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> def assign_period(date):\r\n\u001b[?2004l\r"]
[656.291916, "o", "\u001b[?2004h>     if baseline_start <= date <= baseline_end:\r\n\u001b[?2004l\rk\u001b[?2004h> "]
[656.292157, "o", "        return 'baseline'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.292668, "o", "    elif treatment_start <= date <= treatment_end:\r\n\u001b[?2004l\r\u001b[?2004h>         return 'treatment'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         return 'other'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[656.292767, "o", "\u001b[?2004h> "]
[656.293068, "o", "purchases_top['Period'] = purchases_top['Order Date'].apply(assign_period)\r\n\u001b[?2004l\r"]
[656.293137, "o", "\u001b[?2004h> "]
[656.29366, "o", "purchases_top = purchases_top[purchases_top['Period'].isin(['baseline', 'treatment'])]\r\n\u001b[?2004l\r"]
[656.293693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[656.293883, "o", "# Merge with features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.294353, "o", "intensive_merged = intensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\r\n"]
[656.294387, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[656.294748, "o", "extensive_merged = extensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.29482, "o", "> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[656.295134, "o", "print(\"\\nMerged data ready for analysis\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rx\u001b[?2004h> # DiD functions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.295402, "o", "def univariate_did_intensive(data, category, feature):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.295646, "o", "    \"\"\"Perform univariate DiD for intensive margin\"\"\"\r\n\u001b[?2004l\r)\r\n \u001b[?2004h"]
[656.295675, "o", "> "]
[656.296049, "o", "    cat_data = data[data['Category'] == category].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.296244, "o", "    if cat_data[feature].nunique() < 2:\r\n\u001b[?2004l\r,\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.296657, "o", "    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\r\n\u001b[?2004l\r"]
[656.296684, "o", "\u001b[?2004h> "]
[656.296934, "o", "    cat_data['treated'] = cat_data[feature]\r\n\u001b[?2004l\ren\u001b[?2004h> "]
[656.29732, "o", "    cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.297543, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.297858, "o", "    analysis_data = cat_data[['Total_Spend', 'post', 'treated', 'did_interaction']].dropna()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\r\n"]
[656.298107, "o", "\u001b[?2004h> "]
[656.298157, "o", "    if len(analysis_data) < 10:\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.298252, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.29841, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.298741, "o", "        X = analysis_data[['post', 'treated', 'did_interaction']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.298783, "o", "        X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.299023, "o", "        y = analysis_data['Total_Spend']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.299061, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.299265, "o", "        model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.299304, "o", ">         \r\n"]
[656.299342, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[656.299626, "o", "        did_estimate = model.params['did_interaction']\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.29966, "o", "> "]
[656.299891, "o", "        p_value = model.pvalues['did_interaction']\r\n\u001b[?2004l\r"]
[656.299936, "o", "\u001b[?2004h> "]
[656.299967, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.300122, "o", "        return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.300264, "o", "            'feature': feature,\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.30031, "o", "> "]
[656.300565, "o", "            'did_estimate': round(float(did_estimate), 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.300597, "o", "> "]
[656.300776, "o", "            'p_value': round(float(p_value), 4),\r\n\u001b[?2004l\r"]
[656.300825, "o", "\u001b[?2004h> "]
[656.306298, "o", "            'method': 'Univariate DiD'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.306446, "o", "        }\r\n\u001b[?2004l\rch"]
[656.30728, "o", "\u001b[?2004h"]
[656.307374, "o", ">     except:\r\n\u001b[?2004l\r"]
[656.307402, "o", "\u001b[?2004h> "]
[656.30755, "o", "        return None\r\n\u001b[?2004l\r"]
[656.307608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[656.307693, "o", "> "]
[656.307976, "o", "def multivariate_did_extensive(data, category, features):\r\n\u001b[?2004l\r"]
[656.308139, "o", "\u001b[?2004h> "]
[656.308822, "o", "    \"\"\"Perform multivariate heterogeneous DiD for extensive margin\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.309088, "o", "    cat_data = data[data['Category'] == category].copy()\r\n\u001b[?2004l\r"]
[656.309137, "o", "\u001b[?2004h> "]
[656.309518, "o", "    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\r\n\u001b[?2004l\r"]
[656.309576, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r \u001b[?2004h> "]
[656.309728, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[656.309763, "o", "\u001b[?2004h> "]
[656.309925, "o", "    for feature in features:\r\n\u001b[?2004l\r"]
[656.30995, "o", "\u001b[?2004h> "]
[656.3102, "o", "        if cat_data[feature].nunique() < 2:\r\n\u001b[?2004l\r"]
[656.310224, "o", "\u001b[?2004h> "]
[656.310352, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.310406, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.310629, "o", "        temp_data = cat_data.copy()\r\n\u001b[?2004l\r"]
[656.310726, "o", "\u001b[?2004h> "]
[656.31093, "o", "        temp_data['treated'] = temp_data[feature]\r\n\u001b[?2004l\r"]
[656.31097, "o", "\u001b[?2004h> "]
[656.311339, "o", "        temp_data['did_interaction'] = temp_data['post'] * temp_data['treated']\r\n\u001b[?2004l\r"]
[656.311415, "o", "\u001b[?2004h> "]
[656.311508, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.312014, "o", "        analysis_data = temp_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.312311, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         if len(analysis_data) < 10:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.312436, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[656.312791, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.313228, "o", "            X = analysis_data[['post', 'treated', 'did_interaction']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.313268, "o", "            X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.313656, "o", "            y = analysis_data['Has_Purchase']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.31383, "o", "            model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.313931, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.31442, "o", "            did_estimate = model.params['did_interaction']\r\n\u001b[?2004l\r\u001b[?2004h>             p_value = model.pvalues['did_interaction']\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.314778, "o", "            results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.314832, "o", "                'feature': feature,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.315144, "o", "                'did_estimate': round(float(did_estimate), 4),\r\n\u001b[?2004l\r"]
[656.315309, "o", "\u001b[?2004h> "]
[656.315397, "o", "                'p_value': round(float(p_value), 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.315852, "o", "                'method': 'Multivariate Heterogeneous DiD'\r\n\u001b[?2004l\r"]
[656.315948, "o", "\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h>         except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.316219, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.316313, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra"]
[656.316501, "o", "\u001b[?2004h> "]
[656.316535, "o", "print(\"\\nStarting DiD analysis...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.316821, "o", "print(\"Analyzing surge categories...\")\r\n\u001b[?2004l\r"]
[656.316949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> surge_results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.325448, "o", "for i, category in enumerate(top_surge, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.325727, "o", "    print(f\"  [{i}/10] Processing {category}...\")\r\n\u001b[?2004l\rnt\u001b[?2004h>     \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[656.325968, "o", "    anomaly_idx = anomaly_df[anomaly_df['Category'] == category]['Anomaly_Index'].values[0]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[656.326069, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[656.326372, "o", "    cat_purchases = purchases_top[purchases_top['Category'] == category]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.326722, "o", "    baseline_purchases = cat_purchases[cat_purchases['Period'] == 'baseline']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.327021, "o", "    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\r\n\u001b[?2004l\rtensive,\r\n        'exte"]
[656.327281, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.327551, "o", "    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.328265, "o", ">     treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.328319, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.328832, "o", "    n_purchasers_baseline = baseline_purchases['Survey ResponseID'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.328949, "o", "    n_purchasers_treatment = treatment_purchases['Survey ResponseID'].nunique()\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.329313, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     n_at_risk = len(survey)\r\n\u001b[?2004l\r"]
[656.329574, "o", "\u001b[?2004h> "]
[656.329624, "o", "    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.330405, "o", "    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.330739, "o", "    # Intensive margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.330836, "o", "    intensive_drivers = []\r\n\u001b[?2004l\r\u001b[?2004h>     for feature in feature_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.331197, "o", "        result = univariate_did_intensive(intensive_merged, category, feature)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.331584, "o", "        if result:\r\n\u001b[?2004l\r\u001b[?2004h>             intensive_drivers.append(result)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.331614, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.332265, "o", "    intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.332313, "o", "    top_intensive = intensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.332612, "o", "    # Extensive margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.333142, "o", "    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.333433, "o", "    extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.333661, "o", "    top_extensive = extensive_drivers[:3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[656.333791, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.334043, "o", "    surge_results.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'category': category,\r\n\u001b[?2004l\r"]
[656.334364, "o", "\u001b[?2004h> "]
[656.334495, "o", "        'anomaly_index': round(float(anomaly_idx), 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.334949, "o", "        'baseline_avg_spend': round(float(baseline_avg_spend), 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.335069, "o", "        'treatment_avg_spend': round(float(treatment_avg_spend), 2),\r\n\u001b[?2004l\r"]
[656.33521, "o", "\u001b[?2004h> "]
[656.335459, "o", "        'n_purchasers_baseline': int(n_purchasers_baseline),\r\n\u001b[?2004l\r\u001b[?2004h> "]
