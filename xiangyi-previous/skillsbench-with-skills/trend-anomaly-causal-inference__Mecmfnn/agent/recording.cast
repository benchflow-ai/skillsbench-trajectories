[103.552268, "i", "cat >> analysis.py << 'EOF'\n\n# Step 5: DiD Causal Analysis\nprint(\"\\nStep 5: Performing DiD causal analysis...\")\n\nfrom scipy import stats\nimport statsmodels.api as sm\nfrom statsmodels.formula.api import ols\n\n# Merge intensive data with features\nintensive_merged = intensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\n\n# Merge extensive data with features\nextensive_merged = extensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\n\n# Function to perform univariate DiD for intensive margin\ndef univariate_did_intensive(data, category, feature):\n    cat_data = data[data['Category'] == category].copy()\n    \n    # Check if feature has variation\n    if cat_data[feature].nunique() < 2:\n        return None\n    \n    # Create treatment and post indicators\n    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\n    cat_data['treated'] = cat_data[feature]\n    cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\n    \n    # Remove rows with missing values\n    cat_data = cat_data[['Total_Spend', 'post', 'treated', 'did_interaction']].dropna()\n    \n    if len(cat_data) < 10:\n        return None\n    \n    try:\n        # Run regression: Y = b0 + b1*post + b2*treated + b3*(post*treated)\n        X = cat_data[['post', 'treated', 'did_interaction']]\n        X = sm.add_constant(X)\n        y = cat_data['Total_Spend']\n        \n        model = sm.OLS(y, X).fit()\n        \n        # DiD estimate is the coefficient on the interaction term\n        did_estimate = model.params['did_interaction']\n        p_value = model.pvalues['did_interaction']\n        \n        return {\n            'feature': feature,\n            'did_estimate': round(float(did_estimate), 2),\n            'p_value': round(float(p_value), 4),\n            'method': 'Univariate DiD'\n        }\n    except:\n        return None\n\n# Function to perform multivariate heterogeneous DiD for extensive margin\ndef multivariate_did_extensive(data, category, features):\n    cat_data = data[data['Category'] == category].copy()\n    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\n    \n    results = []\n    \n    for feature in features:\n        if cat_data[feature].nunique() < 2:\n            continue\n        \n        cat_data['treated'] = cat_data[feature]\n        cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\n        \n        # Prepare data\n        analysis_data = cat_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()\n        \n        if len(analysis_data) < 10:\n            continue\n        \n        try:\n            X = analysis_data[['post', 'treated', 'did_interaction']]\n            X = sm.add_constant(X)\n            y = analysis_data['Has_Purchase']\n            \n            model = sm.OLS(y, X).fit()\n            \n            did_estimate = model.params['did_interaction']\n            p_value = model.pvalues['did_interaction']\n            \n            results.append({\n                'feature': feature,\n                'did_estimate': round(float(did_estimate), 4),\n                'p_value': round(float(p_value), 4),\n                'method': 'Multivariate Heterogeneous DiD'\n            })\n        except:\n            continue\n    \n    return results\n\nEOF\n"]
[103.552628, "o", "cat >> analysis.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[103.552772, "o", "\u001b[?2004h> # Step 5: DiD Causal Analysis\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.552805, "o", "print(\"\\nStep 5: Performing DiD causal analysis...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.552959, "o", "from scipy import stats\r\n\u001b[?2004l\r\u001b[?2004h> import statsmodels.api as sm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.553052, "o", "from statsmodels.formula.api import ols\r\n\u001b[?2004l\r"]
[103.553125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.553184, "o", "# Merge intensive data with features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.553294, "o", "intensive_merged = intensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\r\n\u001b[?2004l\r"]
[103.553348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[103.553388, "o", "\u001b[?2004h> "]
[103.553419, "o", "# Merge extensive data with features\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.553447, "o", "> "]
[103.553587, "o", "extensive_merged = extensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.553644, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[103.553703, "o", "> "]
[103.553759, "o", "# Function to perform univariate DiD for intensive margin\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.553815, "o", "> "]
[103.553869, "o", "def univariate_did_intensive(data, category, feature):\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.553919, "o", "> "]
[103.553981, "o", "    cat_data = data[data['Category'] == category].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.554033, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.554094, "o", "    # Check if feature has variation\r\n\u001b[?2004l\r"]
[103.554152, "o", "\u001b[?2004h> "]
[103.554213, "o", "    if cat_data[feature].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.554266, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.554322, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.554376, "o", "    # Create treatment and post indicators\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.554435, "o", "> "]
[103.554501, "o", "    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\r\n\u001b[?2004l\r"]
[103.554557, "o", "\u001b[?2004h> "]
[103.55461, "o", "    cat_data['treated'] = cat_data[feature]\r\n\u001b[?2004l\r"]
[103.554666, "o", "\u001b[?2004h> "]
[103.554739, "o", "    cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\r\n\u001b[?2004l\r"]
[103.554793, "o", "\u001b[?2004h>     \r\n"]
[103.554849, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.554903, "o", "    # Remove rows with missing values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.55502, "o", "    cat_data = cat_data[['Total_Spend', 'post', 'treated', 'did_interaction']].dropna()\r\n\u001b[?2004l\r"]
[103.555072, "o", "\u001b[?2004h>     \r\n"]
[103.555104, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.555184, "o", "    if len(cat_data) < 10:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.555238, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.555293, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[103.555349, "o", "\u001b[?2004h> "]
[103.555409, "o", "        # Run regression: Y = b0 + b1*post + b2*treated + b3*(post*treated)\r\n\u001b[?2004l\r"]
[103.555442, "o", "\u001b[?2004h> "]
[103.555535, "o", "        X = cat_data[['post', 'treated', 'did_interaction']]\r\n\u001b[?2004l\r"]
[103.555581, "o", "\u001b[?2004h> "]
[103.555646, "o", "        X = sm.add_constant(X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.555702, "o", "        y = cat_data['Total_Spend']\r\n\u001b[?2004l\r"]
[103.55575, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[103.555805, "o", "> "]
[103.555857, "o", "        model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.555905, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.555995, "o", "        # DiD estimate is the coefficient on the interaction term\r\n\u001b[?2004l\r"]
[103.556024, "o", "\u001b[?2004h> "]
[103.556111, "o", "        did_estimate = model.params['did_interaction']\r\n\u001b[?2004l\r"]
[103.556165, "o", "\u001b[?2004h> "]
[103.556223, "o", "        p_value = model.pvalues['did_interaction']\r\n\u001b[?2004l\r"]
[103.556276, "o", "\u001b[?2004h> "]
[103.556327, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         return {\r\n\u001b[?2004l\r"]
[103.556374, "o", "\u001b[?2004h> "]
[103.556427, "o", "            'feature': feature,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.556508, "o", "            'did_estimate': round(float(did_estimate), 2),\r\n\u001b[?2004l\r"]
[103.556558, "o", "\u001b[?2004h> "]
[103.556616, "o", "            'p_value': round(float(p_value), 4),\r\n\u001b[?2004l\r"]
[103.556664, "o", "\u001b[?2004h> "]
[103.556717, "o", "            'method': 'Univariate DiD'\r\n\u001b[?2004l\r"]
[103.556742, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[103.556802, "o", "\u001b[?2004h>     except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.556864, "o", "        return None\r\n\u001b[?2004l\r"]
[103.556927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557087, "o", "# Function to perform multivariate heterogeneous DiD for extensive margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557162, "o", "def multivariate_did_extensive(data, category, features):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557236, "o", "    cat_data = data[data['Category'] == category].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557359, "o", "    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557418, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557448, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[103.557519, "o", "> "]
[103.557571, "o", "    for feature in features:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557626, "o", "        if cat_data[feature].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557682, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.55773, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.557791, "o", "        cat_data['treated'] = cat_data[feature]\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.557838, "o", "> "]
[103.557887, "o", "        cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\r\n\u001b[?2004l\r"]
[103.557911, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[103.557973, "o", "\u001b[?2004h>         # Prepare data\r\n\u001b[?2004l\r"]
[103.558026, "o", "\u001b[?2004h> "]
[103.558217, "o", "        analysis_data = cat_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558294, "o", "        if len(analysis_data) < 10:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558351, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558402, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558492, "o", "            X = analysis_data[['post', 'treated', 'did_interaction']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558547, "o", "            X = sm.add_constant(X)\r\n\u001b[?2004l\r"]
[103.558574, "o", "\u001b[?2004h> "]
[103.558651, "o", "            y = analysis_data['Has_Purchase']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558713, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558761, "o", "            model = sm.OLS(y, X).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558827, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.558896, "o", "            did_estimate = model.params['did_interaction']\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.558944, "o", "> "]
[103.558993, "o", "            p_value = model.pvalues['did_interaction']\r\n\u001b[?2004l\r"]
[103.559044, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.559094, "o", "            results.append({\r\n\u001b[?2004l\r"]
[103.559149, "o", "\u001b[?2004h> "]
[103.559187, "o", "                'feature': feature,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.559283, "o", "                'did_estimate': round(float(did_estimate), 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.559306, "o", "> "]
[103.559371, "o", "                'p_value': round(float(p_value), 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.559391, "o", "> "]
[103.559477, "o", "                'method': 'Multivariate Heterogeneous DiD'\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.559497, "o", "> "]
[103.559516, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.559536, "o", "> "]
[103.559563, "o", "        except:\r\n\u001b[?2004l\r"]
[103.559585, "o", "\u001b[?2004h> "]
[103.559603, "o", "            continue\r\n\u001b[?2004l\r"]
[103.559623, "o", "\u001b[?2004h> "]
[103.559644, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.559793, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[103.560802, "o", "\u001b[?2004hroot@57894e7c7587:/app# "]
[125.519432, "i", "cat >> analysis.py << 'EOF'\n\n# Analyze each category\nprint(\"\\nAnalyzing surge categories...\")\nsurge_results = []\n\nfor category in top_surge:\n    print(f\"  Processing {category}...\")\n    \n    # Get anomaly index\n    anomaly_idx = anomaly_df[anomaly_df['Category'] == category]['Anomaly_Index'].values[0]\n    \n    # Calculate baseline and treatment statistics\n    cat_purchases = purchases_top[purchases_top['Category'] == category]\n    \n    baseline_purchases = cat_purchases[cat_purchases['Period'] == 'baseline']\n    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\n    \n    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\n    \n    n_purchasers_baseline = baseline_purchases['Survey ResponseID'].nunique()\n    n_purchasers_treatment = treatment_purchases['Survey ResponseID'].nunique()\n    \n    n_at_risk = len(all_users)\n    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin analysis\n    intensive_drivers = []\n    for feature in feature_cols:\n        result = univariate_did_intensive(intensive_merged, category, feature)\n        if result:\n            intensive_drivers.append(result)\n    \n    # Sort by did_estimate (descending for surge - largest positive effects)\n    intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    top_intensive = intensive_drivers[:3]\n    \n    # Extensive margin analysis\n    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\n    \n    # Sort by did_estimate (descending for surge - largest positive effects)\n    extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    top_extensive = extensive_drivers[:3]\n    \n    surge_results.append({\n        'category': category,\n        'anomaly_index': round(float(anomaly_idx), 2),\n        'baseline_avg_spend': round(float(baseline_avg_spend), 2),\n        'treatment_avg_spend': round(float(treatment_avg_spend), 2),\n        'n_purchasers_baseline': int(n_purchasers_baseline),\n        'n_purchasers_treatment': int(n_purchasers_treatment),\n        'baseline_purchase_rate': round(float(baseline_purchase_rate), 4),\n        'treatment_purchase_rate': round(float(treatment_purchase_rate), 4),\n        'n_at_risk': int(n_at_risk),\n        'intensive_margin': top_intensive,\n        'extensive_margin': top_extensive\n    })\n\nprint(\"\\nAnalyzing slump categories...\")\nslump_results = []\n\nfor category in top_slump:\n    print(f\"  Processing {category}...\")\n    \n    # Get anomaly index\n    anomaly_idx = anomaly_df[anomaly_df['Category'] == category]['Anomaly_Index'].values[0]\n    \n    # Calculate baseline and treatment statistics\n    cat_purchases = purchases_top[purchases_top['Category'] == category]\n    \n    baseline_purchases = cat_purchases[cat_purchases['Period'] == 'baseline']\n    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\n    \n    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\n    \n    n_purchasers_baseline = baseline_purchases['Survey ResponseID'].nunique()\n    n_purchasers_treatment = treatment_purchases['Survey ResponseID'].nunique()\n    \n    n_at_risk = len(all_users)\n    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin analysis\n    intensive_drivers = []\n    for feature in feature_cols:\n        result = univariate_did_intensive(intensive_merged, category, feature)\n        if result:\n            intensive_drivers.append(result)\n    \n    # Sort by did_estimate (ascending for slump - largest negative effects)\n    intensive_drivers.sort(key=l"]
[125.519488, "i", "ambda x: x['did_estimate'])\n    top_intensive = intensive_drivers[:3]\n    \n    # Extensive margin analysis\n    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\n    \n    # Sort by did_estimate (ascending for slump - largest negative effects)\n    extensive_drivers.sort(key=lambda x: x['did_estimate'])\n    top_extensive = extensive_drivers[:3]\n    \n    slump_results.append({\n        'category': category,\n        'anomaly_index': round(float(anomaly_idx), 2),\n        'baseline_avg_spend': round(float(baseline_avg_spend), 2),\n        'treatment_avg_spend': round(float(treatment_avg_spend), 2),\n        'n_purchasers_baseline': int(n_purchasers_baseline),\n        'n_purchasers_treatment': int(n_purchasers_treatment),\n        'baseline_purchase_rate': round(float(baseline_purchase_rate), 4),\n        'treatment_purchase_rate': round(float(treatment_purchase_rate), 4),\n        'n_at_risk': int(n_at_risk),\n        'intensive_margin': top_intensive,\n        'extensive_margin': top_extensive\n    })\n\nEOF\n"]
