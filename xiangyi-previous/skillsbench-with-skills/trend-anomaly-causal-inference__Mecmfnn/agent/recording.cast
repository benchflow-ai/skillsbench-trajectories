[656.273001, "i", "cat > did_analysis.py << 'ENDOFFILE'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport json\nimport warnings\nimport statsmodels.api as sm\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data for DiD analysis...\")\n\n# Load data\nsurvey = pd.read_csv('/app/output/survey_cleaned.csv')\npurchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\npurchases['Order Date'] = pd.to_datetime(purchases['Order Date'])\nanomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\nsurvey_fe = pd.read_csv('/app/output/survey_feature_engineered.csv')\nintensive_df = pd.read_csv('/app/output/user_category_period_aggregated_intensive.csv')\nextensive_df = pd.read_csv('/app/output/user_category_period_aggregated_extensive.csv')\n\nprint(f\"Intensive data: {intensive_df.shape}\")\nprint(f\"Extensive data: {extensive_df.shape}\")\n\n# Get feature columns (exclude Survey ResponseID)\nfeature_cols = [col for col in survey_fe.columns if col != 'Survey ResponseID']\nprint(f\"Features to analyze: {len(feature_cols)}\")\n\n# Define periods\nbaseline_start = datetime(2020, 1, 1)\nbaseline_end = datetime(2020, 2, 29)\ntreatment_start = datetime(2020, 3, 1)\ntreatment_end = datetime(2020, 3, 31)\n\n# Get top categories\ntop_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()\ntop_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()\ntop_categories = top_surge + top_slump\n\n# Filter purchases for statistics\npurchases_top = purchases[purchases['Category'].isin(top_categories)].copy()\n\ndef assign_period(date):\n    if baseline_start <= date <= baseline_end:\n        return 'baseline'\n    elif treatment_start <= date <= treatment_end:\n        return 'treatment'\n    else:\n        return 'other'\n\npurchases_top['Period'] = purchases_top['Order Date'].apply(assign_period)\npurchases_top = purchases_top[purchases_top['Period'].isin(['baseline', 'treatment'])]\n\n# Merge with features\nintensive_merged = intensive_df.merge(survey_fe, on='Survey ResponseID', how='left')\nextensive_merged = extensive_df.m"]
[656.273432, "o", "cat > did_analysis.py << 'ENDOFFILE'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.273481, "i", "erge(survey_fe, on='Survey ResponseID', how='left')\n\nprint(\"\\nMerged data ready for analysis\")\n\n# DiD functions\ndef univariate_did_intensive(data, category, feature):\n    \"\"\"Perform univariate DiD for intensive margin\"\"\"\n    cat_data = data[data['Category'] == category].copy()\n    \n    if cat_data[feature].nunique() < 2:\n        return None\n    \n    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\n    cat_data['treated'] = cat_data[feature]\n    cat_data['did_interaction'] = cat_data['post'] * cat_data['treated']\n    \n    analysis_data = cat_data[['Total_Spend', 'post', 'treated', 'did_interaction']].dropna()\n    \n    if len(analysis_data) < 10:\n        return None\n    \n    try:\n        X = analysis_data[['post', 'treated', 'did_interaction']]\n        X = sm.add_constant(X)\n        y = analysis_data['Total_Spend']\n        \n        model = sm.OLS(y, X).fit()\n        \n        did_estimate = model.params['did_interaction']\n        p_value = model.pvalues['did_interaction']\n        \n        return {\n            'feature': feature,\n            'did_estimate': round(float(did_estimate), 2),\n            'p_value': round(float(p_value), 4),\n            'method': 'Univariate DiD'\n        }\n    except:\n        return None\n\ndef multivariate_did_extensive(data, category, features):\n    \"\"\"Perform multivariate heterogeneous DiD for extensive margin\"\"\"\n    cat_data = data[data['Category'] == category].copy()\n    cat_data['post'] = (cat_data['Period'] == 'treatment').astype(int)\n    \n    results = []\n    \n    for feature in features:\n        if cat_data[feature].nunique() < 2:\n            continue\n        \n        temp_data = cat_data.copy()\n        temp_data['treated'] = temp_data[feature]\n        temp_data['did_interaction'] = temp_data['post'] * temp_data['treated']\n        \n        analysis_data = temp_data[['Has_Purchase', 'post', 'treated', 'did_interaction']].dropna()\n        \n        if len(analysis_data) < 10:\n            continue\n        \n        try:\n            X = analysis_data[['post', 'treated', 'did_interaction']]\n            X = sm.add_constant(X)\n            y = analysis_data['Has_Purchase']\n            \n            model = sm.OLS(y, X).fit()\n            \n            did_estimate = model.params['did_interaction']\n            p_value = model.pvalues['did_interaction']\n            \n            results.append({\n                'feature': feature,\n                'did_estimate': round(float(did_estimate), 4),\n                'p_value': round(float(p_value), 4),\n                'method': 'Multivariate Heterogeneous DiD'\n            })\n        except:\n            continue\n    \n    return results\n\nprint(\"\\nStarting DiD analysis...\")\nprint(\"Analyzing surge categories...\")\n\nsurge_results = []\nfor i, category in enumerate(top_surge, 1):\n    print(f\"  [{i}/10] Processing {category}...\")\n    \n    anomaly_idx = anomaly_df[anomaly_df['Category'] == category]['Anomaly_Index'].values[0]\n    \n    cat_purchases = purchases_top[purchases_top['Category'] == category]\n    baseline_purchases = cat_purchases[cat_purchases['Period'] == 'baseline']\n    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\n    \n    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\n    \n    n_purchasers_baseline = baseline_purchases['Survey ResponseID'].nunique()\n    n_purchasers_treatment = treatment_purchases['Survey ResponseID'].nunique()\n    \n    n_at_risk = len(survey)\n    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin\n    intensive_drivers = []\n    for feature in feature_cols:\n        result = univariate_did_intensive(intensive_merged, category, feature)\n        if result:\n            intensive_drivers.append(result)\n    \n    intensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    top_intensive"]
[656.273519, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[656.273557, "i", " = intensive_drivers[:3]\n    \n    # Extensive margin\n    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\n    extensive_drivers.sort(key=lambda x: x['did_estimate'], reverse=True)\n    top_extensive = extensive_drivers[:3]\n    \n    surge_results.append({\n        'category': category,\n        'anomaly_index': round(float(anomaly_idx), 2),\n        'baseline_avg_spend': round(float(baseline_avg_spend), 2),\n        'treatment_avg_spend': round(float(treatment_avg_spend), 2),\n        'n_purchasers_baseline': int(n_purchasers_baseline),\n        'n_purchasers_treatment': int(n_purchasers_treatment),\n        'baseline_purchase_rate': round(float(baseline_purchase_rate), 4),\n        'treatment_purchase_rate': round(float(treatment_purchase_rate), 4),\n        'n_at_risk': int(n_at_risk),\n        'intensive_margin': top_intensive,\n        'extensive_margin': top_extensive\n    })\n\nprint(\"\\nAnalyzing slump categories...\")\n\nslump_results = []\nfor i, category in enumerate(top_slump, 1):\n    print(f\"  [{i}/10] Processing {category}...\")\n    \n    anomaly_idx = anomaly_df[anomaly_df['Category'] == category]['Anomaly_Index'].values[0]\n    \n    cat_purchases = purchases_top[purchases_top['Category'] == category]\n    baseline_purchases = cat_purchases[cat_purchases['Period'] == 'baseline']\n    treatment_purchases = cat_purchases[cat_purchases['Period'] == 'treatment']\n    \n    baseline_avg_spend = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg_spend = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0\n    \n    n_purchasers_baseline = baseline_purchases['Survey ResponseID'].nunique()\n    n_purchasers_treatment = treatment_purchases['Survey ResponseID'].nunique()\n    \n    n_at_risk = len(survey)\n    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin\n    intensive_drivers = []\n    for feature in feature_cols:\n        result = univariate_did_intensive(intensive_merged, category, feature)\n        if result:\n            intensive_drivers.append(result)\n    \n    intensive_drivers.sort(key=lambda x: x['did_estimate'])\n    top_intensive = intensive_drivers[:3]\n    \n    # Extensive margin\n    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\n    extensive_drivers.sort(key=lambda x: x['did_estimate'])\n    top_extensive = extensive_drivers[:3]\n    \n    slump_results.append({\n        'category': category,\n        'anomaly_index': round(float(anomaly_idx), 2),\n        'baseline_avg_spend': round(float(baseline_avg_spend), 2),\n        'treatment_avg_spend': round(float(treatment_avg_spend), 2),\n        'n_purchasers_baseline': int(n_purchasers_baseline),\n        'n_purchasers_treatment': int(n_purchasers_treatment),\n        'baseline_purchase_rate': round(float(baseline_purchase_rate), 4),\n        'treatment_purchase_rate': round(float(treatment_purchase_rate), 4),\n        'n_at_risk': int(n_at_risk),\n        'intensive_margin': top_intensive,\n        'extensive_margin': top_extensive\n    })\n\nprint(\"\\nGenerating final report...\")\n\nfinal_report = {\n    'metadata': {\n        'baseline_start': baseline_start.strftime('%m-%d-%Y'),\n        'baseline_end': baseline_end.strftime('%m-%d-%Y'),\n        'treatment_start': treatment_start.strftime('%m-%d-%Y'),\n        'treatment_end': treatment_end.strftime('%m-%d-%Y'),\n        'total_features_analyzed': len(feature_cols)\n    },\n    'surge_categories': surge_results,\n    'slump_categories': slump_results,\n    'summary': {\n        'surge': {\n            'total_categories': len(surge_results),\n            'total_intensive_drivers': sum(len(r['intensive_margin']) for r in surge_results),\n            'total_extensive_drivers': sum(len(r['extensive_margin']) for r in surge_results)\n        },\n        'slump': {\n            'total_categories': len(slump_results),\n            'total_intensive_drivers': sum(len(r['intensive"]
