[69.78989, "i", "cat >> analysis.py << 'EOF'\n\n# Step 3: Feature Engineering on Demographics\nprint(\"\\nStep 3: Feature engineering on demographic data...\")\n\nsurvey_fe = survey.copy()\n\n# Create engineered features from survey data\nfeature_cols = []\n\n# Age groups\nfor age_group in survey_fe['Q-demos-age'].dropna().unique():\n    col_name = f'age_{age_group.replace(\" \", \"_\").replace(\"-\", \"to\")}'\n    survey_fe[col_name] = (survey_fe['Q-demos-age'] == age_group).astype(int)\n    feature_cols.append(col_name)\n\n# Hispanic\nfor val in survey_fe['Q-demos-hispanic'].dropna().unique():\n    col_name = f'hispanic_{val}'\n    survey_fe[col_name] = (survey_fe['Q-demos-hispanic'] == val).astype(int)\n    feature_cols.append(col_name)\n\n# Race\nfor race in survey_fe['Q-demos-race'].dropna().unique():\n    col_name = f'race_{race.replace(\" \", \"_\").replace(\",\", \"\").replace(\"or\", \"\").replace(\"(\", \"\").replace(\")\", \"\").replace(\"__\", \"_\")}'\n    survey_fe[col_name] = (survey_fe['Q-demos-race'] == race).astype(int)\n    feature_cols.append(col_name)\n\n# Education\nfor edu in survey_fe['Q-demos-education'].dropna().unique():\n    col_name = f'education_{edu.replace(\" \", \"_\").replace(\",\", \"\").replace(\"'\", \"\")}'\n    survey_fe[col_name] = (survey_fe['Q-demos-education'] == edu).astype(int)\n    feature_cols.append(col_name)\n\n# Income\nfor inc in survey_fe['Q-demos-income'].dropna().unique():\n    col_name = f'income_{inc.replace(\" \", \"_\").replace(\",\", \"\").replace(\"$\", \"\").replace(\"-\", \"to\")}'\n    survey_fe[col_name] = (survey_fe['Q-demos-income'] == inc).astype(int)\n    feature_cols.append(col_name)\n\n# Gender\nfor gender in survey_fe['Q-demos-gender'].dropna().unique():\n    col_name = f'gender_{gender}'\n    survey_fe[col_name] = (survey_fe['Q-demos-gender'] == gender).astype(int)\n    feature_cols.append(col_name)\n\n# Sexual orientation\nfor orient in survey_fe['Q-sexual-orientation'].dropna().unique():\n    col_name = f'orientation_{orient.replace(\" \", \"_\").replace(\",\", \"\").replace(\"(\", \"\").replace(\")\", \"\")}'\n    survey_fe[col_name] = (survey_fe['Q-sexual-orientation'] == orient).astype(int)\n    feature_cols.append(col_name)\n\n# State\nfor state in survey_fe['Q-demos-state'].dropna().unique():\n    col_name = f'state_{state.replace(\" \", \"_\")}'\n    survey_fe[col_name] = (survey_fe['Q-demos-state'] == state).astype(int)\n    feature_cols.append(col_name)\n\n# Household size\nfor hh_size in survey_fe['Q-amazon-use-howmany'].dropna().unique():\n    col_name = f'hh_size_{hh_size.replace(\" \", \"_\").replace(\"!\", \"\").replace(\"(\", \"\").replace(\")\", \"\")}'\n    survey_fe[col_name] = (survey_fe['Q-amazon-use-howmany'] == hh_size).astype(int)\n    feature_cols.append(col_name)\n\n# Household members\nfor hh_mem in survey_fe['Q-amazon-use-hh-size'].dropna().unique():\n    col_name = f'hh_members_{str(hh_mem).replace(\" \", \"_\").replace(\"!\", \"\").replace(\"(\", \"\").replace(\")\", \"\")}'\n    survey_fe[col_name] = (survey_fe['Q-amazon-use-hh-size'] == hh_mem).astype(int)\n    feature_cols.append(col_name)\n\n# Purchase frequency\nfor freq in survey_fe['Q-amazon-use-how-oft'].dropna().unique():\n    col_name = f'purchase_freq_{freq.replace(\" \", \"_\")}'\n    survey_fe[col_name] = (survey_fe['Q-amazon-use-how-oft'] == freq).astype(int)\n    feature_cols.append(col_name)\n\n# Substance use and health\nfor col in ['Q-substance-use-cigarettes', 'Q-substance-use-marijuana', 'Q-substance-use-alcohol', \n            'Q-personal-diabetes', 'Q-personal-wheelchair']:\n    for val in survey_fe[col].dropna().unique():\n        col_name = f'{col.replace(\"Q-\", \"\").replace(\"-\", \"_\")}_{val}'\n        survey_fe[col_name] = (survey_fe[col] == val).astype(int)\n        feature_cols.append(col_name)\n\n# Save feature engineered survey\nsurvey_fe_output = survey_fe[['Survey ResponseID'] + feature_cols]\nsurvey_fe_output.to_csv('/app/output/survey_feature_engineered.csv', index=False)\nprint(f\"Feature engineering complete. {len(feature_cols)} features created.\")\n\nEOF\n"]
