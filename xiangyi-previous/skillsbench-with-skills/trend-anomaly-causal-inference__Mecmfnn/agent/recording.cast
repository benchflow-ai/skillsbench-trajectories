Category'].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> top_categories = top_surge + top_slump\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nTop surge categories: {top_surge[:3]}...\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Top slump categories: {top_slump[:3]}...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Filter purchases to top categories and add period\r\n\u001b[?2004l\r\u001b[?2004h> purchases_top = purchases[purchases['Category'].isin(top_categories)].copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def assign_period(date):\r\n\u001b[?2004l\r\u001b[?2004h>     if baseline_start <= date <= baseline_end:\r\n\u001b[?2004l\r\u001b[?2004h>         return 'baseline'\r\n\u001b[?2004l\r\u001b[?2004h>     elif treatment_start <= date <= treatment_end:\r\n\u001b[?2004l\r\u001b[?2004h>         return 'treatment'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         return 'other'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> purchases_top['Period'] = purchases_top['Order Date'].apply(assign_period)\r\n\u001b[?2004l\r\u001b[?2004h> purchases_top = purchases_top[purchases_top['Period'].isin(['baseline', 'treatment'])]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nFiltered purchases for top categories: {purchases_top.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Step 4: Create intensive margin data (optimized)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nStep 4: Creating intensive margin data (optimized)...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Aggregate spending by user-category-period\r\n\u001b[?2004l\r\u001b[?2004h> intensive_agg = purchases_top.groupby(['Survey ResponseID', 'Category', 'Period'])['Total_Spend'].sum().reset_index()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create complete combinations of all users, categories, and periods\r\n\u001b[?2004l\r\u001b[?2004h> all_users = survey['Survey ResponseID'].unique()\r\n\u001b[?2004l\r\u001b[?2004h> user_cat_period_combinations = pd.MultiIndex.from_product(\r\n\u001b[?2004l\r\u001b[?2004h>     [all_users, top_categories, ['baseline', 'treatment']],\r\n\u001b[?2004l\r\u001b[?2004h>     names=['Survey ResponseID', 'Category', 'Period']\r\n\u001b[?2004l\r\u001b[?2004h> ).to_frame(index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Merge with actual spending data\r\n\u001b[?2004l\r\u001b[?2004h> intensive_df = user_cat_period_combinations.merge(\r\n\u001b[?2004l\r\u001b[?2004h>     intensive_agg,\r\n\u001b[?2004l\r\u001b[?2004h>     on=['Survey ResponseID', 'Category', 'Period'],\r\n\u001b[?2004l\r\u001b[?2004h>     how='left'\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fill missing spending with 0\r\n\u001b[?2004l\r\u001b[?2004h> intensive_df['Total_Spend'] = intensive_df['Total_Spend'].fillna(0)\r\n\u001b[?2004l\r\u001b[?200"]
