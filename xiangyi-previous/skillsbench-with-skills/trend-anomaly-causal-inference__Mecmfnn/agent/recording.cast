[595.28055, "i", "cat > analysis_optimized.py << 'ENDOFFILE'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport json\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading previously generated files...\")\n\n# Load the cleaned and processed data from previous run\nsurvey = pd.read_csv('/app/output/survey_cleaned.csv')\npurchases = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\npurchases['Order Date'] = pd.to_datetime(purchases['Order Date'])\nanomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\nsurvey_fe = pd.read_csv('/app/output/survey_feature_engineered.csv')\n\nprint(f\"Survey: {survey.shape}\")\nprint(f\"Purchases: {purchases.shape}\")\nprint(f\"Anomaly results: {anomaly_df.shape}\")\nprint(f\"Feature engineered survey: {survey_fe.shape}\")\n\n# Define periods\nbaseline_start = datetime(2020, 1, 1)\nbaseline_end = datetime(2020, 2, 29)\ntreatment_start = datetime(2020, 3, 1)\ntreatment_end = datetime(2020, 3, 31)\n\n# Get top categories\ntop_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()\ntop_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()\ntop_categories = top_surge + top_slump\n\nprint(f\"\\nTop surge categories: {top_surge[:3]}...\")\nprint(f\"Top slump categories: {top_slump[:3]}...\")\n\n# Filter purchases to top categories and add period\npurchases_top = purchases[purchases['Category'].isin(top_categories)].copy()\n\ndef assign_period(date):\n    if baseline_start <= date <= baseline_end:\n        return 'baseline'\n    elif treatment_start <= date <= treatment_end:\n        return 'treatment'\n    else:\n        return 'other'\n\npurchases_top['Period'] = purchases_top['Order Date'].apply(assign_period)\npurchases_top = purchases_top[purchases_top['Period'].isin(['baseline', 'treatment'])]\n\nprint(f\"\\nFiltered purchases for top categories: {purchases_top.shape}\")\n\n# Step 4: Create intensive margin data (optimized)\nprint(\"\\nStep 4: Creating intensive margin data (optimized)...\")\n\n# Aggregate spending by user-category-period\nintensive_agg = purchases_top.groupby(['Survey ResponseID', 'Category', 'Period'])['Total_Spend'].sum().reset_index()\n\n# Create complete combinations of all users, categories, and periods\nall_users = survey['Survey ResponseID'].unique()\nuser_cat_period_combinations = pd.MultiIndex.from_product(\n    [all_users, top_categories, ['baseline', 'treatment']],\n    names=['Survey ResponseID', 'Category', 'Period']\n).to_frame(index=False)\n\n# Merge with actual spending data\nintensive_df = user_cat_period_combinations.merge(\n    intensive_agg,\n    on=['Survey ResponseID', 'Category', 'Period'],\n    how='left'\n)\n\n# Fill missing spending with 0\nintensive_df['Total_Spend'] = intensive_df['Total_Spend'].fillna(0)\n\nintensive_df.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)\nprint(f\"Intensive margin data created: {intensive_df.shape}\")\n\n# Step 5: Create extensive margin data (optimized)\nprint(\"\\nStep 5: Creating extensive margin data (optimized)...\")\n\n# Create Has_Purchase indicator\nextensive_agg = purchases_top.groupby(['Survey ResponseID', 'Category', 'Period']).size().reset_index(name='count')\nextensive_agg['Has_Purchase'] = 1\n\n# Merge with complete combinations\nextensive_df = user_cat_period_combinations.merge(\n    extensive_agg[['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']],\n    on=['Survey ResponseID', 'Category', 'Period'],\n    how='left'\n)\n\n# Fill missing purchases with 0\nextensive_df['Has_Purchase'] = extensive_df['Has_Purchase'].fillna(0).astype(int)\n\nextensive_df.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)\nprint(f\"Extensive margin data created: {extensive_df.shape}\")\n\nprint(\"\\nData preparation complete!\")\nENDOFFILE\n"]
[595.280854, "o", "cat > analysis_optimized.py << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
