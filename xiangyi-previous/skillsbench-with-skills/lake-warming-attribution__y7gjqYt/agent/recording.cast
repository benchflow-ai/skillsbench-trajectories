[33.383662, "o", "\u001b[?2004hroot@d87c40b32163:~# "]
[33.532373, "i", "cat > /root/analyze.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy import stats\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.preprocessing import StandardScaler\n\n# Load all data\nwater_temp = pd.read_csv('/root/data/water_temperature.csv')\nclimate = pd.read_csv('/root/data/climate.csv')\nland_cover = pd.read_csv('/root/data/land_cover.csv')\nhydrology = pd.read_csv('/root/data/hydrology.csv')\n\n# Merge all data on Year\ndata = water_temp.merge(climate, on='Year').merge(land_cover, on='Year').merge(hydrology, on='Year')\n\n# 1. Trend Analysis - Linear regression of WaterTemperature vs Year\nX_trend = data[['Year']].values\ny_trend = data['WaterTemperature'].values\n\n# Perform linear regression\nslope, intercept, r_value, p_value, std_err = stats.linregress(X_trend.flatten(), y_trend)\n\n# Save trend results\ntrend_result = pd.DataFrame({\n    'slope': [slope],\n    'p-value': [p_value]\n})\ntrend_result.to_csv('/root/output/trend_result.csv', index=False)\nprint(f\"Trend Analysis: slope={slope:.6f}, p-value={p_value:.6f}\")\n\n# 2. Identify dominant driving factor\n# Categorize variables\ncategories = {\n    'Heat': ['AirTempLake', 'Shortwave', 'Longwave'],\n    'Wind': ['WindSpeedLake'],\n    'Flow': ['Outflow', 'Inflow'],\n    'Human': ['DevelopedArea', 'AgricultureArea']\n}\n\n# Calculate contribution for each variable using correlation with water temperature\ncontributions = {}\nfor category, variables in categories.items():\n    for var in variables:\n        if var in data.columns:\n            # Calculate correlation with water temperature\n            corr, _ = stats.pearsonr(data[var], data['WaterTemperature'])\n            # Use absolute correlation as contribution measure\n            contributions[var] = {'category': category, 'correlation': abs(corr), 'raw_corr': corr}\n\n# Alternative approach: Use regression coefficients\n# Standardize all predictor variables\npredictor_vars = []\nfor vars_list in categories.values():\n    predictor_vars.extend(vars_list)\n\nX_factors = data[predictor_vars].values\ny_temp = data['WaterTemperature'].values\n\n# Standardize to compare coefficients fairly\nscaler = StandardScaler()\nX_factors_scaled = scaler.fit_transform(X_factors)\n\n# Fit regression model\nmodel = LinearRegression()\nmodel.fit(X_factors_scaled, y_temp)\n\n# Get coefficients\ncoefficients = {}\nfor i, var in enumerate(predictor_vars):\n    coefficients[var] = abs(model.coef_[i])\n\n# Calculate category contributions by summing absolute coefficients\ncategory_contributions = {}\nfor category, variables in categories.items():\n    total_contrib = sum(coefficients.get(var, 0) for var in variables)\n    category_contributions[category] = total_contrib\n\n# Find dominant category\ntotal_contribution = sum(category_contributions.values())\ndominant_category = max(category_contributions, key=category_contributions.get)\ndominant_contribution_pct = (category_contributions[dominant_category] / total_contribution) * 100\n\n# Find the most important variable in the dominant category\ndominant_var = None\nmax_coef = 0\nfor var in categories[dominant_category]:\n    if coefficients[var] > max_coef:\n        max_coef = coefficients[var]\n        dominant_var = var\n\nprint(f\"\\nDominant Category: {dominant_category}\")\nprint(f\"Contribution: {dominant_contribution_pct:.2f}%\")\nprint(f\"Most important variable: {dominant_var}\")\n\n# Save dominant factor results\ndominant_result = pd.DataFrame({\n    'variable': [dominant_category],\n    'contribution': [dominant_contribution_pct]\n})\ndominant_result.to_csv('/root/output/dominant_factor.csv', index=False)\n\nprint(\"\\nAnalysis complete. Results saved to /root/output/\")\nEOF\n"]
