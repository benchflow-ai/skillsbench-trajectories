[33.538858, "o", "        max_coef = coefficients[var]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.538929, "o", "        dominant_var = var\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.538981, "o", "\u001b[?2004h> "]
[33.539031, "o", "print(f\"\\nDominant Category: {dominant_category}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.539117, "o", "print(f\"Contribution: {dominant_contribution_pct:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.539168, "o", "> "]
[33.539206, "o", "print(f\"Most important variable: {dominant_var}\")\r\n\u001b[?2004l\r"]
[33.539252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.5393, "o", "# Save dominant factor results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.539357, "o", "dominant_result = pd.DataFrame({\r\n\u001b[?2004l\r"]
[33.539402, "o", "\u001b[?2004h> "]
[33.539448, "o", "    'variable': [dominant_category],\r\n\u001b[?2004l\r"]
[33.539493, "o", "\u001b[?2004h> "]
[33.53952, "o", "    'contribution': [dominant_contribution_pct]\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.539564, "o", "> })\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.539612, "o", "> "]
[33.539674, "o", "dominant_result.to_csv('/root/output/dominant_factor.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.539719, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.539811, "o", "print(\"\\nAnalysis complete. Results saved to /root/output/\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.539859, "o", "EOF\r\n\u001b[?2004l\r"]
