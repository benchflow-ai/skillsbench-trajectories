[433.486792, "i", "cat <<'EOF' > src/components/Banner.tsx\n'use client';\n\nimport { useState, useEffect } from 'react';\n\nconst API_URL = '';\n\nexport default function Banner() {\n  const [promo, setPromo] = useState<string | null>(null);\n\n  useEffect(() => {\n    fetch(`${API_URL}/api/banner`)\n      .then(r => r.json())\n      .then(data => setPromo(data.text));\n  }, []);\n\n  return (\n    <div\n      data-testid=\"promo-banner\"\n      className=\"bg-[#0070f3] text-white py-24 px-4 text-center font-bold text-2xl\"\n    >\n      <span className={promo ? '' : 'opacity-0'}>\n        {promo || 'Loading promotion'}\n      </span>\n    </div>\n  );\n}\nEOF\n"]
