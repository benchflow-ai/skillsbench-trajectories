[29.575589, "o", "\u001b[?2004hroot@c92b3e38e982:~# "]
[29.714452, "i", "cat > /root/analysis.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom scipy import stats\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load data\nwater_temp = pd.read_csv('/root/data/water_temperature.csv')\nclimate = pd.read_csv('/root/data/climate.csv')\nland_cover = pd.read_csv('/root/data/land_cover.csv')\nhydrology = pd.read_csv('/root/data/hydrology.csv')\n\n# Merge all data on Year\ndf = water_temp.merge(climate, on='Year').merge(land_cover, on='Year').merge(hydrology, on='Year')\nprint(\"Merged data shape:\", df.shape)\nprint(df.head())\n\n# Task 1: Trend analysis - linear regression of WaterTemperature vs Year\nslope, intercept, r_value, p_value, std_err = stats.linregress(df['Year'], df['WaterTemperature'])\nprint(f\"\\nTrend Analysis:\")\nprint(f\"Slope: {slope}\")\nprint(f\"P-value: {p_value}\")\n\n# Save trend result\ntrend_result = pd.DataFrame({'slope': [slope], 'p-value': [p_value]})\ntrend_result.to_csv('/root/output/trend_result.csv', index=False)\nprint(\"\\nTrend result saved to /root/output/trend_result.csv\")\n\n# Task 2: Identify most important driving factor\n# Define categories\ncategories = {\n    'Heat': ['AirTempLake', 'Shortwave', 'Longwave'],\n    'Flow': ['Precip', 'Outflow', 'Inflow'],\n    'Wind': ['WindSpeedLake'],\n    'Human': ['DevelopedArea', 'AgricultureArea']\n}\n\n# All feature columns\nfeature_cols = ['Precip', 'AirTempLake', 'Shortwave', 'Longwave', 'WindSpeedLake',\n                'DevelopedArea', 'AgricultureArea', 'Outflow', 'Inflow']\n\nX = df[feature_cols].values\ny = df['WaterTemperature'].values\n\n# Standardize features\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Fit linear regression\nmodel = LinearRegression()\nmodel.fit(X_scaled, y)\n\n# Get coefficients (importance based on standardized coefficients)\ncoefficients = np.abs(model.coef_)\nfeature_importance = dict(zip(feature_cols, coefficients))\n\nprint(\"\\nFeature Importance (absolute standardized coefficients):\")\nfor feat, imp in sorted(feature_importance.items(), key=lambda x: x[1], reverse=True):\n    print(f\"  {feat}: {imp:.4f}\")\n\n# Calculate category importance\ncategory_importance = {}\nfor cat, features in categories.items():\n    cat_imp = sum(feature_importance[f] for f in features)\n    category_importance[cat] = cat_imp\n\nprint(\"\\nCategory Importance:\")\ntotal_importance = sum(category_importance.values())\nfor cat, imp in sorted(category_importance.items(), key=lambda x: x[1], reverse=True):\n    pct = (imp / total_importance) * 100\n    print(f\"  {cat}: {imp:.4f} ({pct:.1f}%)\")\n\n# Find dominant category\ndominant_cat = max(category_importance, key=category_importance.get)\ndominant_contribution = (category_importance[dominant_cat] / total_importance) * 100\n\nprint(f\"\\nDominant Category: {dominant_cat}\")\nprint(f\"Contribution: {dominant_contribution:.2f}%\")\n\n# Save dominant factor result\ndominant_factor = pd.DataFrame({'variable': [dominant_cat], 'contribution': [dominant_contribution]})\ndominant_factor.to_csv('/root/output/dominant_factor.csv', index=False)\nprint(\"\\nDominant factor saved to /root/output/dominant_factor.csv\")\nEOF\n"]
