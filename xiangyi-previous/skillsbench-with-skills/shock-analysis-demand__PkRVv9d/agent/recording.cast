[121.08194, "i", "cat << 'EOF' > get_data.py\nimport urllib.request\nurls = [\n    'https://www.imf.org/external/pubs/ft/weo/2024/02/weodata/weorept.aspx?sy=2022&ey=2029&scsm=1&ssd=1&sort=country&ds=.&br=1&c=915&s=NGDP_RPCH%2CNGDP_D%2CNGDP%2CNGDPD&grp=0&a=',\n    'https://www.imf.org/external/pubs/ft/weo/2024/01/weodata/weorept.aspx?sy=2022&ey=2029&scsm=1&ssd=1&sort=country&ds=.&br=1&c=915&s=NGDP_RPCH%2CNGDP_D%2CNGDP%2CNGDPD&grp=0&a=',\n    'https://www.imf.org/external/pubs/ft/weo/2023/02/weodata/weorept.aspx?sy=2022&ey=2029&scsm=1&ssd=1&sort=country&ds=.&br=1&c=915&s=NGDP_RPCH%2CNGDP_D%2CNGDP%2CNGDPD&grp=0&a='\n]\nfor i, url in enumerate(urls):\n    try:\n        print(f'Trying {url}')\n        resp = urllib.request.urlopen(url)\n        content = resp.read().decode('utf-8')\n        if 'Page not found' not in content and 'Country-Specific Data' in content:\n            with open(f'weo_{i}.html', 'w') as f:\n                f.write(content)\n            print(f'Success with {url}')\n            break\n    except Exception as e:\n        print(f'Failed {url}: {e}')\nEOF\npython3 get_data.py\n"]
[121.082466, "o", "cat << 'EOF' > get_data.py"]
