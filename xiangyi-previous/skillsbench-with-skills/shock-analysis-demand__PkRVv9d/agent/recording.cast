[172.909095, "i", "cat << 'EOF' > get_data_v2.py\nimport urllib.request\nheaders = {'User-Agent': 'Mozilla/5.0'}\n\ndef download(url, filename):\n    try:\n        req = urllib.request.Request(url, headers=headers)\n        with urllib.request.urlopen(req) as resp:\n            with open(filename, 'wb') as f:\n                f.write(resp.read())\n        print(f'Downloaded {filename} from {url}')\n        return True\n    except Exception as e:\n        print(f'Failed {url}: {e}')\n        return False\n\n# Try to get SUT 2022\ndownload('https://www.geostat.ge/media/60829/SUT_2022_Eng.xlsx', 'sut_2022.xlsx')\n# Try to get WEO Georgia data\ndownload('https://www.imf.org/external/pubs/ft/weo/2024/01/weodata/weorept.aspx?sy=2020&ey=2029&scsm=1&ssd=1&sort=country&ds=.&br=1&c=915&s=NGDP_RPCH,NGDP_D,NGDP,NGDPD&grp=0&a=', 'weo_georgia.html')\nEOF\npython3 get_data_v2.py\n"]
