[33.333091, "o", "32:-behaviour(gen_statem).\r\n106:    case gen_statem:start_link(?MODULE,\r\n134:            gen_statem:cast(ConnPid, socket_control),\r\n170:    throw({keep_state_and_data,\r\n290:-type state_info() :: iolist().\r\n294:\t\t\t  state_info()\r\n408:    %% in wait_for_socket state;\r\n444:\t      userauth_supported_methods = AuthMethods,\r\n474:                       userauth_quiet_mode = ?GET_OPT(quiet_mode, Opts),\r\n478:            S1#ssh{userauth_pubkeys = [K || K <- ?GET_OPT(pref_public_key_algs, Opts),\r\n487:\t\t   userauth_methods = string:tokens(AuthMethods, \",\"),\r\n536:%% gen_statem callbacks\r\n543:-type state_name() :: \r\n552:      | {userauth,                  role()                    }\r\n553:      | {userauth_keyboard_interactive,       role()          }\r\n554:      | {userauth_keyboard_interactive_extra, server          }\r\n555:      | {userauth_keyboard_interactive_info_response, client  }\r\n556:      | {connected,                 role()                    }\r\n559:%% The state names must fulfill some rules regarding\r\n562:-spec renegotiation(state_name()) -> boolean().\r\n571:-spec handle_event(gen_statem:event_type(),\r\n573:\t\t   state_name(),\r\n575:\t\t  ) -> gen_statem:event_handler_result(state_name()) .\r\n584:     state_enter].\r\n601:                          connection_state = init_connection_record(Role, Socket, Opts)\r\n604:                {next_state, {hello,Role}, D, NextEvent}\r\n627:\t    {keep_state, D#data{inet_initial_recbuf_size=Size}, [{state_timeout,Time,no_hello_received}] };\r\n640:    keep_state_and_data;\r\n665:\t    {next_state, {kexinit,Role,init}, D, {change_callback_module, ssh_fsm_kexinit}};\r\n677:handle_event(state_timeout, no_hello_received, {hello,_Role}=StateName, D0 = #data{ssh_params = Ssh0}) ->\r\n694:\t\"ssh-userauth\" ->\r\n696:\t    {ok, {Reply, Ssh}} = ssh_auth:handle_userauth_request(Msg, SessionId, Ssh0),\r\n698:\t    {next_state, {userauth,server}, D, {change_callback_module,ssh_fsm_userauth_server}};\r\n708:handle_event(internal, #ssh_msg_service_accept{name = \"ssh-userauth\"}, {service_request,client},\r\n709:\t     #data{ssh_params = #ssh{service=\"ssh-userauth\"} = Ssh0} = D0) ->\r\n710:    {Msg, Ssh} = ssh_auth:init_userauth_request_msg(Ssh0),\r\n714:    {next_state, {userauth,client}, D, {change_callback_module,ssh_fsm_userauth_client}};\r\n717:%% Skip ext_info messages in connected state (for example from OpenSSH >= 7.7)\r\n718:handle_event(internal, #ssh_msg_ext_info{}, {connected,_Role}, D) ->\r\n719:    {keep_state, D};\r\n721:handle_event(internal, {#ssh_msg_kexinit{},_}, {connected,Role}, D0) ->\r\n726:    {next_state, {kexinit,Role,renegotiate}, D, [postpone, {change_callback_module,ssh_fsm_kexinit}]};\r\n730:\tssh_connection:handle_msg(Msg, D0#data.connection_state, ?role(StateName), D0#data.ssh_params),\r\n746:    keep_state_and_data;\r\n749:    keep_state_and_data;\r\n757:    keep_state_and_data;\r\n759:handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n767:                {{_, Reason}, client} when ((StateName =/= {connected,client})\r\n778:\t\t    {connected,_} ->\r\n779:\t\t\tsend_replies(Replies, D0#data{connection_state=Connection});\r\n"]
