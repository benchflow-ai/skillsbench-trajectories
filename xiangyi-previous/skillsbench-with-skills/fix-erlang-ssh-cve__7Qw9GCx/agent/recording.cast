[32.796603, "o", "80:-export([init/1, callback_mode/0, handle_event/4, terminate/3,\r\n571:-spec handle_event(gen_statem:event_type(),\r\n583:    [handle_event_function,\r\n589:handle_event(cast, socket_control, {wait_for_socket, Role},\r\n614:handle_event(internal, socket_ready, {hello,_}=StateName, #data{ssh_params = Ssh0} = D) ->\r\n636:handle_event(internal, {info_line,_Line}, {hello,client}, D) ->\r\n642:handle_event(internal, {info_line,Line}, {hello,server}=StateName, D) ->\r\n651:handle_event(internal, {version_exchange,Version}, {hello,Role}, D0) ->\r\n677:handle_event(state_timeout, no_hello_received, {hello,_Role}=StateName, D0 = #data{ssh_params = Ssh0}) ->\r\n692:handle_event(internal, Msg = #ssh_msg_service_request{name=ServiceName}, StateName = {service_request,server}, D0) ->\r\n708:handle_event(internal, #ssh_msg_service_accept{name = \"ssh-userauth\"}, {service_request,client},\r\n718:handle_event(internal, #ssh_msg_ext_info{}, {connected,_Role}, D) ->\r\n721:handle_event(internal, {#ssh_msg_kexinit{},_}, {connected,Role}, D0) ->\r\n728:handle_event(internal, #ssh_msg_disconnect{description=Desc} = Msg, StateName, D0) ->\r\n735:handle_event(internal, #ssh_msg_ignore{}, {_StateName, _Role, init},\r\n745:handle_event(internal, #ssh_msg_ignore{}, _StateName, _) ->\r\n748:handle_event(internal, #ssh_msg_unimplemented{}, _StateName, _) ->\r\n752:handle_event(cast, #ssh_msg_debug{} = Msg, State, D) ->\r\n753:    handle_event(internal, Msg, State, D);\r\n755:handle_event(internal, #ssh_msg_debug{} = Msg, _StateName, D) ->\r\n759:handle_event(internal, {conn_msg,Msg}, StateName, #data{connection_state = Connection0,\r\n804:handle_event(enter, OldState, {connected,_}=NewState, D) ->\r\n808:handle_event(enter, OldState, {ext_info,_,renegotiate}=NewState, D) ->\r\n812:handle_event(enter, {connected,_}=OldState, NewState, D) ->\r\n816:handle_event(cast, force_renegotiate, StateName, D) ->\r\n817:    handle_event({timeout,renegotiate}, undefined, StateName, D);\r\n819:handle_event({timeout,renegotiate}, _, StateName, D0) ->\r\n830:handle_event({timeout,check_data_size}, _, StateName, D0) ->\r\n840:handle_event({call,From}, get_alg, _, D) ->\r\n844:handle_event(cast, _, StateName, _) when not ?CONNECTED(StateName) ->\r\n847:handle_event(cast, {adjust_window,ChannelId,Bytes}, StateName, D) when ?CONNECTED(StateName) ->\r\n873:handle_event(cast, {reply_request,Resp,ChannelId}, StateName, D) when ?CONNECTED(StateName) ->\r\n894:handle_event(cast, {request,ChannelPid, ChannelId, Type, Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n897:handle_event(cast, {request,ChannelId,Type,Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n900:handle_event(cast, {unknown,Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n904:handle_event(cast, {global_request, Type, Data}, StateName, D) when ?CONNECTED(StateName) ->\r\n909:handle_event({call,From}, get_print_info, StateName, D) ->\r\n926:handle_event({call,From}, {connection_info, Options}, _, D) ->\r\n930:handle_event({call,From}, {channel_info,ChannelId,Options}, _, D) ->\r\n940:handle_event({call,From}, {info, all}, _, D) ->\r\n947:handle_event({call,From}, {info, ChannelPid}, _, D) ->\r\n956:handle_event({call,From}, {set_sock_opts,SocketOptions}, _StateName, D) ->\r\n963:handle_event({call,From}, {get_sock_opts,SocketGetOptions}, _StateName, D) ->\r\n970:handle_event({call,From}, stop, _StateName, D0) ->\r\n974:handle_event({call,_}, _, StateName, _) when not ?CONNECTED(StateName) ->\r\n977:handle_event({call,From}, {request, ChannelPid, ChannelId, Type, Data, Timeout}, StateName, D0)\r\n988:handle_event({call,From}, {request, ChannelId, Type, Data, Timeout}, StateName, D0)\r\n999:handle_event({call,From}, {global_request, \"tcpip-forward\" = Type,\r\n1020:handle_event({call,From}, {global_request, Type, Data, Timeout}, StateName, D0) when ?CONNECTED(StateName) ->\r\n1027:handle_event({call,From}, {data, ChannelId, Type, Data, Timeout}, StateName, D0)\r\n"]
