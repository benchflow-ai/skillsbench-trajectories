[115.244592, "i", "cat > /tmp/fix_patch.py << 'EOF'\nimport re\n\n# Read the original file\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'r') as f:\n    content = f.read()\n\n# The vulnerable section that needs to be fixed (lines 1161-1177)\n# We need to add state checking before processing connection messages\n\nold_code = '''                #ssh_msg_global_request{}            = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_request_success{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_request_failure{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_open{}              = Msg -> {keep_state, D1,\n                                                               [{{timeout, max_initial_idle_time}, cancel} |\n                                                                ?CONNECTION_MSG(Msg)\n                                                               ]};\n                #ssh_msg_channel_open_confirmation{} = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_open_failure{}      = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_window_adjust{}     = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_data{}              = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_extended_data{}     = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_eof{}               = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_close{}             = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_request{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_failure{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_success{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};'''\n\nnew_code = '''                #ssh_msg_global_request{}            = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_request_success{}           = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_request_failure{}           = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_open{}              = Msg when ?CONNECTED(StateName) -> {keep_state, D1,\n                                                               [{{timeout, max_initial_idle_time}, cancel} |\n                                                                ?CONNECTION_MSG(Msg)\n                                                               ]};\n                #ssh_msg_channel_open_confirmation{} = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_open_failure{}      = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_window_adjust{}     = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_data{}              = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_extended_data{}     = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_eof{}               = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_close{}             = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_request{}           = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_failure{}           = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n                #ssh_msg_channel_success{}           = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\n\n                %% Connection"]
[115.244841, "i", " protocol messages received before authentication - disconnect\n                #ssh_msg_global_request{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_request_success{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_request_failure{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_open{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_open_confirmation{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_open_failure{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_window_adjust{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_data{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_extended_data{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_eof{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_close{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_request{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_failure{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                 "]
[115.244936, "i", "                    StateName, D1),\n                    {stop, Shutdown, D};\n                #ssh_msg_channel_success{} ->\n                    {Shutdown, D} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,\n                                     \"Connection message received before authentication\",\n                                     StateName, D1),\n                    {stop, Shutdown, D};'''\n\nif old_code in content:\n    content = content.replace(old_code, new_code)\n    print(\"Patch applied successfully!\")\nelse:\n    print(\"ERROR: Could not find the code to patch\")\n    print(\"Searching for partial matches...\")\n    if '#ssh_msg_global_request{}' in content:\n        print(\"Found #ssh_msg_global_request{}\")\n    if '#ssh_msg_channel_open{}' in content:\n        print(\"Found #ssh_msg_channel_open{}\")\n\n# Write the patched file\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\n    f.write(content)\nEOF\npython3 /tmp/fix_patch.py\n"]
