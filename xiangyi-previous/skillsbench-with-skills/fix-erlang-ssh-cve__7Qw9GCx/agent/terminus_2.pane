[?2004hroot@94cb5168f6fc:/app/workspace# sed -n '1245,1310p' /app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl
[?2004l                #ssh_msg_channel_success{} ->
