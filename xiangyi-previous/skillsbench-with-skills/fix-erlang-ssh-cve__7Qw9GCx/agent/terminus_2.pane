                                 StateName, D0),
            {stop, Shutdown, D}
    catch
	C:E:ST ->
            MaxLogItemLen = ?GET_OPT(max_log_item_len,SshParams#ssh.opts),
            {Shutdown, D} =
                ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR,
                                 io_lib:format("Bad packet: Couldn't decrypt~n~p:~p~n~p",
                                               [C,E,ST], [{chars_limit, MaxLogItemLen}]),
                                 StateName, D0),
            {stop, Shutdown, D}
    end;


