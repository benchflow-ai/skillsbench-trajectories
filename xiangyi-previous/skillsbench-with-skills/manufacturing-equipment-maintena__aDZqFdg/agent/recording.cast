[165.879011, "o", "\u001b[?2004hroot@1573e067814a:/app# "]
[172.631941, "i", "cat > /tmp/q3_solution.py << 'EOFSCRIPT'\nimport pandas as pd\nimport json\nimport numpy as np\n\nthermo = pd.read_csv('/app/data/thermocouples.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\n\nq3_min_peak = {}\nq3_failing = set()\n\nfor run_id in sorted(thermo['run_id'].unique()):\n    run_mes = mes[mes['run_id'] == run_id]\n    if len(run_mes) == 0:\n        q3_failing.add(run_id)\n        continue\n    \n    liquidus = run_mes['solder_liquidus_c'].values[0]\n    required_min_peak = liquidus + 20.0\n    \n    run_thermo = thermo[thermo['run_id'] == run_id]\n    \n    if len(run_thermo) == 0:\n        q3_failing.add(run_id)\n        continue\n    \n    peak_by_tc = {}\n    for tc_id in run_thermo['tc_id'].unique():\n        tc_data = run_thermo[run_thermo['tc_id'] == tc_id]\n        peak_temp = float(tc_data['temp_c'].max())\n        peak_by_tc[tc_id] = peak_temp\n        \n        if peak_temp < required_min_peak:\n            q3_failing.add(run_id)\n    \n    if peak_by_tc:\n        best_tc = max(peak_by_tc, key=peak_by_tc.get)\n        q3_min_peak[run_id] = {\n            'tc_id': best_tc,\n            'peak_temp_c': round(peak_by_tc[best_tc], 2),\n            'required_min_peak_c': round(required_min_peak, 2)\n        }\n\nq3_out = {\n    'failing_runs': sorted(list(q3_failing)),\n    'min_peak_by_run': q3_min_peak\n}\n\nwith open('/app/output/q03.json', 'w') as f:\n    json.dump(q3_out, f, indent=2)\n\nprint(f\"Q3: Done - {len(q3_min_peak)} runs, {len(q3_failing)} failing\")\nEOFSCRIPT\n"]
