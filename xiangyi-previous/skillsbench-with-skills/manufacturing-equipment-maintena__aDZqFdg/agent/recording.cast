[198.079657, "o", "\u001b[?2004hroot@1573e067814a:/app# "]
[206.506133, "i", "cat > /tmp/q5_solution.py << 'EOFSCRIPT'\nimport pandas as pd\nimport json\nimport numpy as np\n\nmes = pd.read_csv('/app/data/mes_log.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# Get summary defect data per run\ndefect_summary = defects.groupby('run_id').agg({\n    'count': 'sum',\n    'fp_yield_pct': 'first'\n}).reset_index()\n\ndefect_summary.columns = ['run_id', 'total_defects', 'yield_pct']\n\n# Merge with MES data to get board_family\nrun_family = mes[['run_id', 'board_family']].drop_duplicates()\n\n# Combine\nanalysis = defect_summary.merge(run_family, on='run_id', how='left')\n\n# For runs with no defect data, assume 0 defects\nanalysis['total_defects'] = analysis['total_defects'].fillna(0)\nanalysis['yield_pct'] = analysis['yield_pct'].fillna(100.0)\n\n# Group by board_family and select best run\nq5_results = []\n\nfor family in sorted(analysis['board_family'].unique()):\n    family_runs = analysis[analysis['board_family'] == family].copy()\n    \n    if len(family_runs) == 0:\n        continue\n    \n    # Sort by: lowest defects (higher is better for yield), then by run_id\n    family_runs = family_runs.sort_values(\n        ['yield_pct', 'total_defects'],\n        ascending=[False, True]\n    )\n    \n    best_run = family_runs.iloc[0]['run_id']\n    runner_ups = family_runs.iloc[1:]['run_id'].tolist()\n    \n    q5_results.append({\n        'board_family': family,\n        'best_run_id': best_run,\n        'runner_up_run_ids': runner_ups\n    })\n\nq5_sorted = sorted(q5_results, key=lambda x: x['board_family'])\n\nwith open('/app/output/q05.json', 'w') as f:\n    json.dump(q5_sorted, f, indent=2)\n\nprint(f\"Q5: Done - {len(q5_sorted)} board families\")\nEOFSCRIPT\n"]
[206.506377, "o", "cat > /tmp/q5_solution.py << 'EOFSCRIPT'\r\n\u001b[?2004l\r"]
