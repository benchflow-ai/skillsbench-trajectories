[148.104491, "i", "python3 > /tmp/solution.py << 'EOFSCRIPT'\nimport pandas as pd\nimport json\nimport numpy as np\nfrom collections import defaultdict\n\n# Load data\nthermo = pd.read_csv('/app/data/thermocouples.csv')\nmes = pd.read_csv('/app/data/mes_log.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# ===== QUESTION 1: PREHEAT RAMP RATE =====\nq1_max_ramp_by_run = {}\nq1_violating = set()\n\nfor run_id in sorted(thermo['run_id'].unique()):\n    run_data = thermo[thermo['run_id'] == run_id]\n    preheat_data = run_data[run_data['zone_id'] == 1]\n    \n    if len(preheat_data) == 0:\n        continue\n    \n    max_ramp = {}\n    for tc_id in preheat_data['tc_id'].unique():\n        tc_data = preheat_data[preheat_data['tc_id'] == tc_id].sort_values('time_s')\n        if len(tc_data) < 2:\n            continue\n        \n        temps = tc_data['temp_c'].values\n        times = tc_data['time_s'].values\n        ramp_rates = np.diff(temps) / np.diff(times)\n        max_rate = float(np.max(ramp_rates))\n        max_ramp[tc_id] = max_rate\n        \n        if max_rate > 2.0:\n            q1_violating.add(run_id)\n    \n    if max_ramp:\n        best_tc = max(max_ramp, key=max_ramp.get)\n        q1_max_ramp_by_run[run_id] = {\n            'tc_id': best_tc,\n            'max_preheat_ramp_c_per_s': round(max_ramp[best_tc], 2)\n        }\n\nq1_output = {\n    'ramp_rate_limit_c_per_s': 2.0,\n    'violating_runs': sorted(list(q1_violating)),\n    'max_ramp_by_run': q1_max_ramp_by_run\n}\n\nwith open('/app/output/q01.json', 'w') as f:\n    json.dump(q1_output, f, indent=2)\n\nprint(\"Q1 completed\")\nprint(f\"  Violating runs: {len(q1_violating)}\")\nprint(f\"  Total runs: {len(q1_max_ramp_by_run)}\")\n\nEOFSCRIPT\n"]
[148.104732, "o", "python3 > /tmp/solution.py << 'EOFSCRIPT'\r\n\u001b[?2004l\r"]
