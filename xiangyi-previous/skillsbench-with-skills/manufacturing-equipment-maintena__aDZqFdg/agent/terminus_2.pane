[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> defects = pd.read_csv('/app/data/test_defects.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Get summary defect data per run
[?2004l[?2004h> defect_summary = defects.groupby('run_id').agg({
[?2004l[?2004h>     'count': 'sum',
[?2004l[?2004h>     'fp_yield_pct': 'first'
[?2004l[?2004h> }).reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> defect_summary.columns = ['run_id', 'total_defects', 'yield_pct']
[?2004l[?2004h> 
[?2004l[?2004h> # Merge with MES data to get board_family
[?2004l[?2004h> run_family = mes[['run_id', 'board_family']].drop_duplicates()
[?2004l[?2004h> 
[?2004l[?2004h> # Combine
[?2004l[?2004h> analysis = defect_summary.merge(run_family, on='run_id', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # For runs with no defect data, assume 0 defects
[?2004l[?2004h> analysis['total_defects'] = analysis['total_defects'].fillna(0)
[?2004l[?2004h> analysis['yield_pct'] = analysis['yield_pct'].fillna(100.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Group by board_family and select best run
[?2004l[?2004h> q5_results = []
[?2004l[?2004h> 
[?2004l[?2004h> for family in sorted(analysis['board_family'].unique()):
[?2004l[?2004h>     family_runs = analysis[analysis['board_family'] == family].copy()
[?2004l[?2004h>     
[?2004l[?2004h>     if len(family_runs) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by: lowest defects (higher is better for yield), then by run_id
[?2004l[?2004h>     family_runs = family_runs.sort_values(
[?2004l[?2004h>         ['yield_pct', 'total_defects'],
[?2004l[?2004h>         ascending=[False, True]
[?2004l[?2004h>     )
[?2004l[?2004h>     
[?2004l[?2004h>     best_run = family_runs.iloc[0]['run_id']
[?2004l[?2004h>     runner_ups = family_runs.iloc[1:]['run_id'].tolist()
[?2004l[?2004h>     
[?2004l[?2004h>     q5_results.append({
[?2004l[?2004h>         'board_family': family,
[?2004l[?2004h>         'best_run_id': best_run,
[?2004l[?2004h>         'runner_up_run_ids': runner_ups
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> q5_sorted = sorted(q5_results, key=lambda x: x['board_family'])
