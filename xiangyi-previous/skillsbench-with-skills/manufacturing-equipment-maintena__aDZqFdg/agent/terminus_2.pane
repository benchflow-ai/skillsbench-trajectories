[?2004hroot@1573e067814a:/app# cat > /tmp/q4_solution.py << 'EOFSCRIPT'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> mes = pd.read_csv('/app/data/mes_log.csv')
[?2004l[?2004h> 
[?2004l[?2004h> q4_results = []
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in mes.iterrows():
[?2004l[?2004h>     run_id = row['run_id']
[?2004l[?2004h>     board_len = row['board_length_cm']
[?2004l[?2004h>     thermal_mass = row['thermal_mass_idx']
[?2004l[?2004h>     actual_speed = row['conveyor_speed_cm_min']
[?2004l[?2004h>     
[?2004l[?2004h>     # Estimate minimum speed based on thermal requirements
[?2004l[?2004h>     # For typical reflow: ~120-150 seconds total dwell time needed
[?2004l[?2004h>     # Oven chamber heated length ~ 240 cm (typical for 8-10 zone ovens)
[?2004l[?2004h>     # Minimum speed = chamber_length / dwell_time
[?2004l[?2004h>     
[?2004l[?2004h>     # Based on thermal mass, estimate dwell time
[?2004l[?2004h>     # Low mass (0.5): 90 sec, High mass (1.5): 150 sec
[?2004l[?2004h>     dwell_time = 90 + (thermal_mass - 0.5) * 40
[?2004l[?2004h>     
[?2004l[?2004h>     # Typical oven chamber heated length
[?2004l[?2004h>     chamber_length = 240  # cm, typical for 8-10 zone ovens
[?2004l[?2004h>     
[?2004l[?2004h>     required_min_speed = chamber_length / (dwell_time / 60)  # convert to cm/min
[?2004l[?2004h>     
[?2004l[?2004h>     meets = actual_speed >= required_min_speed
[?2004l[?2004h>     
[?2004l[?2004h>     q4_results.append({
[?2004l[?2004h>         'run_id': run_id,
[?2004l[?2004h>         'required_min_speed_cm_min': round(required_min_speed, 2),
[?2004l[?2004h>         'actual_speed_cm_min': round(actual_speed, 2),
[?2004l[?2004h>         'meets': meets
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> q4_sorted = sorted(q4_results, key=lambda x: x['run_id'])
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output/q04.json', 'w') as f:
[?2004l[?2004h>     json.dump(q4_sorted, f, indent=2)
[?2004l[?2004h> 
