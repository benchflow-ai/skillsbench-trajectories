[217.569012, "i", "cat > calculate_merge_times.py << 'EOF'\nimport json\nimport urllib.request\nfrom datetime import datetime\nimport time\n\n# Load existing data\nwith open('/app/report.json', 'r') as f:\n    report = json.load(f)\n\n# We need to fetch PR details for merged PRs\n# Let's try to fetch them with longer delays\nmerged_pr_numbers = [10154, 10151, 10145, 10143, 10139, 10135, 10124, 10121, 10116, 10112,\n                     10110, 10104, 10102, 10094, 10078, 10074, 10070, 10056, 10055, 10051,\n                     10048, 10044, 10043, 10026, 10025, 10020, 10019, 10016, 10012, 10009,\n                     10006, 9999, 9992, 9985]\n\nprint(f\"Attempting to fetch merge times for {len(merged_pr_numbers)} PRs...\")\nprint(\"Waiting for rate limit to reset...\")\ntime.sleep(10)\n\ntotal_days = 0\nmerge_count = 0\n\nfor i, pr_num in enumerate(merged_pr_numbers):\n    try:\n        url = f\"https://api.github.com/repos/cli/cli/pulls/{pr_num}\"\n        print(f\"Fetching PR #{pr_num} ({i+1}/{len(merged_pr_numbers)})...\")\n        \n        with urllib.request.urlopen(url) as response:\n            pr_detail = json.loads(response.read().decode())\n        \n        if pr_detail.get('merged_at'):\n            created = datetime.strptime(pr_detail['created_at'], '%Y-%m-%dT%H:%M:%SZ')\n            merged = datetime.strptime(pr_detail['merged_at'], '%Y-%m-%dT%H:%M:%SZ')\n            days = (merged - created).total_seconds() / 86400\n            total_days += days\n            merge_count += 1\n            print(f\"  Merge time: {days:.1f} days\")\n        \n        time.sleep(3)  # Longer delay between requests\n        \n    except Exception as e:\n        print(f\"  Error: {e}\")\n        if \"403\" in str(e):\n            print(\"  Rate limit hit, stopping...\")\n            break\n        time.sleep(5)\n\nif merge_count > 0:\n    avg_merge_days = round(total_days / merge_count, 1)\n    report['pr']['avg_merge_days'] = avg_merge_days\n    print(f\"\\nCalculated average merge time: {avg_merge_days} days from {merge_count} PRs\")\n    \n    with open('/app/report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    \n    print(\"\\nUpdated report:\")\n    print(json.dumps(report, indent=2))\nelse:\n    print(\"\\nCould not calculate merge times due to rate limiting.\")\n    print(\"Current report:\")\n    print(json.dumps(report, indent=2))\nEOF\n"]
