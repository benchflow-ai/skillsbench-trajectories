[265.055789, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.055868, "o", ">     # Calculate using closed_at as proxy for merged_at"]
[265.055938, "o", "\r\n"]
[265.056009, "o", "\u001b[?2004l\r"]
[265.056097, "o", "\u001b[?2004h"]
[265.056174, "o", "> "]
[265.056297, "o", "    total_days = 0"]
[265.056395, "o", "\r\n"]
[265.056518, "o", "\u001b[?2004l\r\u001b[?2004h"]
[265.056597, "o", ">     count = 0"]
[265.056707, "o", "\r\n"]
[265.056826, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[265.056982, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[265.057087, "o", ">     for pr in merged_prs:"]
[265.057172, "o", "\r\n"]
[265.057279, "o", "\u001b[?2004l\r"]
[265.057502, "o", "\u001b[?2004h> "]
[265.057591, "o", "        if pr.get('created_at') and pr.get('closed_at'):"]
[265.057681, "o", "\r\n"]
[265.057763, "o", "\u001b[?2004l\r"]
[265.057863, "o", "\u001b[?2004h"]
[265.058151, "o", "> "]
[265.058242, "o", "            created = datetime.strptime(pr['created_at'], '%Y-%m-%dT%H:%M:%SZ')"]
[265.058319, "o", "\r\n"]
[265.058404, "o", "\u001b[?2004l\r"]
[265.058508, "o", "\u001b[?2004h"]
[265.058596, "o", "> "]
[265.05888, "o", "            closed = datetime.strptime(pr['closed_at'], '%Y-%m-%dT%H:%M:%SZ')"]
[265.058967, "o", "\r\n"]
[265.059047, "o", "\u001b[?2004l\r"]
[265.05914, "o", "\u001b[?2004h"]
[265.059224, "o", "> "]
[265.059466, "o", "            days = (closed - created).total_seconds() / 86400"]
[265.059547, "o", "\r\n"]
[265.059624, "o", "\u001b[?2004l\r"]
[265.059726, "o", "\u001b[?2004h"]
[265.059813, "o", "> "]
[265.059977, "o", "            total_days += days"]
