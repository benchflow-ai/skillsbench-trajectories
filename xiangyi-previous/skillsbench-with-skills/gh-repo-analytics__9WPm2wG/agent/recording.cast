[265.060132, "o", "\u001b[?2004l\r"]
[265.060227, "o", "\u001b[?2004h"]
[265.060309, "o", "> "]
[265.060447, "o", "            count += 1"]
[265.06052, "o", "\r\n"]
[265.060594, "o", "\u001b[?2004l\r"]
[265.060729, "o", "\u001b[?2004h"]
[265.060831, "o", ">     "]
[265.060967, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[265.061059, "o", ">     if count > 0:"]
[265.061176, "o", "\r\n\u001b[?2004l\r"]
[265.061375, "o", "\u001b[?2004h> "]
[265.061448, "o", "        avg_days = round(total_days / count, 1)"]
