[88.783954, "i", "cat > fetch_data.py << 'EOF'\nimport json\nimport urllib.request\nfrom datetime import datetime\nfrom collections import Counter\nimport time\n\ndef fetch_url(url):\n    with urllib.request.urlopen(url) as response:\n        return json.loads(response.read().decode())\n\n# Fetch PRs created in December 2024\nprint(\"Fetching PRs...\")\nprs = []\npage = 1\nwhile True:\n    url = f\"https://api.github.com/search/issues?q=repo:cli/cli+type:pr+created:2024-12-01..2024-12-31&per_page=100&page={page}\"\n    data = fetch_url(url)\n    if 'items' not in data or len(data['items']) == 0:\n        break\n    prs.extend(data['items'])\n    if len(data['items']) < 100:\n        break\n    page += 1\n    time.sleep(0.5)  # Rate limiting\n\nprint(f\"Found {len(prs)} PRs\")\n\n# Analyze PRs\ntotal_prs = len(prs)\nmerged_prs = []\nclosed_prs = []\ncontributor_counts = Counter()\n\nfor pr in prs:\n    contributor_counts[pr['user']['login']] += 1\n    \n    # Fetch detailed PR info to check merge status\n    pr_url = pr['pull_request']['url']\n    pr_detail = fetch_url(pr_url)\n    \n    if pr_detail.get('merged_at'):\n        merged_prs.append(pr_detail)\n    elif pr['state'] == 'closed':\n        closed_prs.append(pr)\n    \n    time.sleep(0.1)  # Rate limiting\n\nprint(f\"Merged: {len(merged_prs)}, Closed: {len(closed_prs)}\")\n\n# Calculate average merge time\nif merged_prs:\n    total_days = 0\n    for pr in merged_prs:\n        created = datetime.strptime(pr['created_at'], '%Y-%m-%dT%H:%M:%SZ')\n        merged = datetime.strptime(pr['merged_at'], '%Y-%m-%dT%H:%M:%SZ')\n        days = (merged - created).total_seconds() / 86400\n        total_days += days\n    avg_merge_days = round(total_days / len(merged_prs), 1)\nelse:\n    avg_merge_days = 0.0\n\ntop_contributor = contributor_counts.most_common(1)[0][0] if contributor_counts else \"\"\n\nprint(f\"Fetching issues...\")\n# Fetch issues created in December 2024\nissues = []\npage = 1\nwhile True:\n    url = f\"https://api.github.com/search/issues?q=repo:cli/cli+type:issue+created:2024-12-01..2024-12-31&per_page=100&page={page}\"\n    data = fetch_url(url)\n    if 'items' not in data or len(data['items']) == 0:\n        break\n    issues.extend(data['items'])\n    if len(data['items']) < 100:\n        break\n    page += 1\n    time.sleep(0.5)  # Rate limiting\n\nprint(f\"Found {len(issues)} issues\")\n\n# Count bug reports\ntotal_issues = len(issues)\nbug_issues = []\nfor issue in issues:\n    labels = [label['name'].lower() for label in issue.get('labels', [])]\n    if any('bug' in label for label in labels):\n        bug_issues.append(issue)\n\n# Count resolved bugs (closed in December)\nresolved_bugs = sum(1 for issue in bug_issues if issue['state'] == 'closed')\n\nreport = {\n    \"pr\": {\n        \"total\": total_prs,\n        \"merged\": len(merged_prs),\n        \"closed\": len(closed_prs),\n        \"avg_merge_days\": avg_merge_days,\n        \"top_contributor\": top_contributor\n    },\n    \"issue\": {\n        \"total\": total_issues,\n        \"bug\": len(bug_issues),\n        \"resolved_bugs\": resolved_bugs\n    }\n}\n\nwith open('/app/report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nReport generated:\")\nprint(json.dumps(report, indent=2))\nEOF\n"]
[88.784316, "o", "cat > fetch_data.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
