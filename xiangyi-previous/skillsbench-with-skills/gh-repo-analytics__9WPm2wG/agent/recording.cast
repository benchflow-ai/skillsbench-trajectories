[160.171992, "o", "issues = []\r\n\u001b[?2004l\r\u001b[?2004h> page = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.172025, "o", "while True:"]
[160.172149, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.172439, "o", "    url = f\"https://api.github.com/search/issues?q=repo:cli/cli+type:issue+created:2024-12-01..2024-12-31&per_page=100&page={page}\"\r\n\u001b[?2004l\r"]
[160.172581, "o", "\u001b[?2004h"]
[160.197308, "o", "> "]
[160.19737, "o", "    data = fetch_url(url)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.19765, "o", "    if not data or 'items' not in data or len(data['items']) == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.197757, "o", "    issues.extend(data['items'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.197862, "o", "    if len(data['items']) < 100:\r\n\u001b[?2004l\r"]
[160.197895, "o", "\u001b[?2004h> "]
[160.19802, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h>     page += 1\r\n\u001b[?2004l\r"]
[160.198053, "o", "\u001b[?2004h> "]
[160.198173, "o", "    time.sleep(2)  # Rate limiting\r\n\u001b[?2004l\r"]
[160.198208, "o", "\u001b[?2004h> "]
[160.198335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.198435, "o", "print(f\"Found {len(issues)} issues\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.198533, "o", "# Count bug reports\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.198629, "o", "total_issues = len(issues)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.198661, "o", "bug_issues = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.199005, "o", "for issue in issues:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.199171, "o", "    labels = [label['name'].lower() for label in issue.get('labels', [])]\r\n\u001b[?2004l\r\u001b[?2004h>     if any('bug' in label for label in labels):\r\n\u001b[?2004l\r\u001b[?2004h>         bug_issues.append(issue)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.199255, "o", "# Count resolved bugs (closed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.199448, "o", "resolved_bugs = sum(1 for issue in bug_issues if issue['state'] == 'closed')\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.199524, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r"]
[160.199595, "o", "\u001b[?2004h>     \"pr\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.199677, "o", "        \"total\": total_prs,\r\n\u001b[?2004l\r"]
[160.199737, "o", "\u001b[?2004h> "]
[160.199796, "o", "        \"merged\": len(merged_prs),\r\n\u001b[?2004l\r"]
[160.199853, "o", "\u001b[?2004h> "]
[160.199911, "o", "        \"closed\": len(closed_prs),\r\n\u001b[?2004l\r"]
[160.199968, "o", "\u001b[?2004h> "]
[160.200033, "o", "        \"avg_merge_days\": avg_merge_days,\r\n\u001b[?2004l\r"]
[160.200092, "o", "\u001b[?2004h> "]
[160.200171, "o", "        \"top_contributor\": top_contributor\r\n\u001b[?2004l\r"]
[160.200598, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     \"issue\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"total\": total_issues,\r\n\u001b[?2004l\r\u001b[?2004h>         \"bug\": len(bug_issues),\r\n\u001b[?2004l\r\u001b[?2004h>         \"resolved_bugs\": resolved_bugs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.200734, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.200844, "o", "with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.200943, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.201067, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nReport generated:\")\r\n\u001b[?2004l\r"]
[160.201178, "o", "\u001b[?2004h> "]
[160.201278, "o", "print(json.dumps(report, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[160.205151, "o", "\u001b[?2004hroot@34bd9e0d2b06:/app# "]
