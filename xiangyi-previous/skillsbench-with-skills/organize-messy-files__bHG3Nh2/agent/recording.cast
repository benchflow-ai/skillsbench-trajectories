[681.719075, "o", "        return subprocess.check_output(['pdftotext', path, '-'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.719223, "o", "    if path.endswith('.docx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[681.71934, "o", "\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.719473, "o", "                root = ET.fromstring(z.read('word/document.xml'))\r\n\u001b[?2004l\r"]
[681.71956, "o", "\u001b[?2004h"]
[681.719704, "o", "> "]
[681.719877, "o", "                return \" \".join(node.text for node in root.iter() if node.text)"]
[681.719939, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.719969, "o", "> "]
[681.720133, "o", "        except: return \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.720166, "o", "> "]
[681.720414, "o", "    if path.endswith('.pptx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.720517, "o", "            text = []\r\n\u001b[?2004l\r\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.720597, "o", "                for f in z.namelist():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.720851, "o", "                    if f.startswith('ppt/slides/slide'):\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.720921, "o", "> "]
[681.720976, "o", "                        root = ET.fromstring(z.read(f))\r\n\u001b[?2004l\r"]
[681.721053, "o", "\u001b[?2004h> "]
[681.721285, "o", "                        text.append(\" \".join(node.text for node in root.iter() if node.text))\r\n\u001b[?2004l\r"]
[681.721359, "o", "\u001b[?2004h> "]
[681.72143, "o", "            return \" \".join(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.721518, "o", "        except: return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.721587, "o", "    return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.721666, "o", "def classify(text, filename):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.721764, "o", "    text = text.lower() + \" \" + filename.lower()\r\n\u001b[?2004l\r"]
[681.721837, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.721969, "o", "    # Check for Music History first to avoid false positives in others\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.722264, "o", "    if re.search(r'\\b(music|composer|symphony|jazz|opera|orchestra|rhythm|melody|harmony|billboard|pop music|electronic music)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.722362, "o", "        return \"music_history\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[681.722439, "o", "\u001b[?2004h> "]
[681.722499, "o", "    # Check for Black Hole\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.722702, "o", "    if re.search(r'\\b(black hole|event horizon|hawking radiation|schwarzschild|general relativity)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.722766, "o", "> "]
[681.722818, "o", "        return \"black_hole\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.722878, "o", "    # Check for DNA\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.722922, "o", "> "]
[681.723129, "o", "    if re.search(r'\\b(dna|genome|genetics|sequencing|nucleotide|chromosome|rna)\\b', text):\r\n\u001b[?2004l\r"]
[681.723177, "o", "\u001b[?2004h> "]
[681.723236, "o", "        return \"DNA\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.723284, "o", "> "]
[681.723331, "o", "    # Check for Trapped Ion / QC\r\n\u001b[?2004l\r"]
[681.723373, "o", "\u001b[?2004h> "]
[681.723592, "o", "    if re.search(r'\\b(trapped ion|quantum computing|qubit|quantum gate|rydberg|ion trap|quantum simulation)\\b', text):\r\n\u001b[?2004l\r"]
[681.723639, "o", "\u001b[?2004h> "]
[681.723695, "o", "        return \"trapped_ion_and_qc\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.723753, "o", "> "]
[681.723798, "o", "    # Check for LLM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724017, "o", "    if re.search(r'\\b(large language model|llm|transformer|gpt|attention mechanism|pre-training|nlp)\\b', text):\r\n\u001b[?2004l\r"]
[681.724115, "o", "\u001b[?2004h> "]
[681.724172, "o", "        return \"LLM\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724258, "o", "    return \"music_history\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724407, "o", "cats = ['LLM', 'trapped_ion_and_qc', 'black_hole', 'DNA', 'music_history']\r\n\u001b[?2004l\r"]
[681.724457, "o", "\u001b[?2004h> "]
[681.724529, "o", "for c in cats: os.makedirs(c, exist_ok=True)\r\n\u001b[?2004l\r"]
[681.724592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724659, "o", "all_files = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724724, "o", "for c in cats:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724773, "o", "    for f in os.listdir(c):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724855, "o", "        all_files.append(os.path.join(c, f))\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.724918, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.724972, "o", "for path in all_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.725047, "o", "    if os.path.isdir(path): continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.725096, "o", "> "]
[681.725147, "o", "    filename = os.path.basename(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.725217, "o", "    text = get_text(path)\r\n\u001b[?2004l\r"]
[681.725262, "o", "\u001b[?2004h> "]
[681.725322, "o", "    category = classify(text, filename)\r\n\u001b[?2004l\r"]
[681.725377, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.725463, "o", "    dest = os.path.join(category, filename)\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.72552, "o", "> "]
[681.725562, "o", "    if path != dest:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.725619, "o", "        os.rename(path, dest)\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.725662, "o", "> EOF\r\n\u001b[?2004l\r"]
[681.767442, "o", "\u001b[?2004hroot@b4b2e5e10690:~# "]
[681.767614, "o", "python3 classify.py\r\n\u001b[?2004l\r"]
