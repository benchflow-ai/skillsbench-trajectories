[275.462926, "o", "pdftotext DNA/2011.02460v1.pdf - | head -n 30\r\n\u001b[?2004l\r"]
[275.484635, "o", "Phylogenetic reconstruction of the cultural evolution of electronic music via\r\ndynamic community detection (1975–1999)\r\nMason Youngblooda,b,1 , Karim Baraghithc , and Patrick E. Savaged\r\n\r\narXiv:2011.02460v1 [q-bio.PE] 4 Nov 2020\r\n\r\na\r\n\r\nDepartment of Psychology, The Graduate Center, City University of New York, New York, NY, USA\r\nb\r\nDepartment of Biology, Queens College, City University of New York, Flushing, NY, USA\r\nc\r\nDepartment of Philosophy, DCLPS, Heinrich-Heine University, Düsseldorf, NRW, Germany\r\nd\r\nFaculty of Environment and Information Studies, Keio University SFC, Fujisawa, Japan\r\n1\r\nmasonyoungblood@gmail.com\r\n\r\nAbstract\r\nCultural phylogenies, or “trees” of culture, are typically built using methods from biology that use similarities and\r\ndifferences in artifacts to infer the historical relationships between the populations that produced them. While these\r\nmethods have yielded important insights, particularly in linguistics, researchers continue to debate the extent to which\r\ncultural phylogenies are tree-like or reticulated due to high levels of horizontal transmission. In this study, we propose a\r\nnovel method for phylogenetic reconstruction using dynamic community detection that explicitly accounts for transmission\r\nbetween lineages. We used data from 1,498,483 collaborative relationships between electronic music artists to construct\r\na cultural phylogeny based on observed population structure. The results suggest that, although the phylogeny is fundamentally tree-like, horizontal transmission is common and populations never become fully isolated from one another.\r\nIn addition, we found evidence that electronic music diversity has increased between 1975 and 1999. The method used\r\nin this study is available as a new R package called DynCommPhylo. Future studies should apply this method to other\r\ncultural systems such as academic publishing and film, as well as biological systems where high resolution reproductive\r\ndata is available, to assess how levels of reticulation in evolution vary across domains.\r\n"]
[275.49367, "o", "\u001b[?2004hroot@b4b2e5e10690:~# "]
[288.966467, "i", "cat << 'EOF' > classify.py\nimport os, subprocess, zipfile, re\nimport xml.etree.ElementTree as ET\n\ndef get_text(path):\n    if path.endswith('.pdf'):\n        return subprocess.check_output(['pdftotext', path, '-'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')\n    if path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                root = ET.fromstring(z.read('word/document.xml'))\n                return \" \".join(node.text for node in root.iter() if node.text)\n        except: return \"\"\n    if path.endswith('.pptx'):\n        try:\n            text = []\n            with zipfile.ZipFile(path) as z:\n                for f in z.namelist():\n                    if f.startswith('ppt/slides/slide'):\n                        root = ET.fromstring(z.read(f))\n                        text.append(\" \".join(node.text for node in root.iter() if node.text))\n            return \" \".join(text)\n        except: return \"\"\n    return \"\"\n\ndef classify(text, filename):\n    text = text.lower() + \" \" + filename.lower()\n    \n    # Check for Black Hole\n    if re.search(r'\\b(black hole|event horizon|hawking radiation|schwarzschild|general relativity)\\b', text):\n        return \"black_hole\"\n    # Check for DNA\n    if re.search(r'\\b(dna|genome|genetics|sequencing|nucleotide|chromosome|rna)\\b', text):\n        return \"DNA\"\n    # Check for Trapped Ion / QC\n    if re.search(r'\\b(trapped ion|quantum computing|qubit|quantum gate|rydberg|ion trap|quantum simulation)\\b', text):\n        return \"trapped_ion_and_qc\"\n    # Check for LLM\n    if re.search(r'\\b(large language model|llm|transformer|gpt|attention mechanism|pre-training|nlp)\\b', text):\n        if \"music\" not in text or \"language model\" in text:\n            return \"LLM\"\n    \n    return \"music_history\"\n\ncats = ['LLM', 'trapped_ion_and_qc', 'black_hole', 'DNA', 'music_history']\nfor c in cats: os.makedirs(c, exist_ok=True)\n\nall_files = []\nfor c in cats:\n    for f in os.listdir(c):\n        all_files.append(os.path.join(c, f))\n\nfor path in all_files:\n    if os.path.isdir(path): continue\n    filename = os.path.basename(path)\n    text = get_text(path)\n    category = classify(text, filename)\n    \n    dest = os.path.join(category, filename)\n    if path != dest:\n        os.rename(path, dest)\nEOF\npython3 classify.py\n"]
[288.976831, "o", "cat << 'EOF' > classify.py\r\n\u001b[?2004l\r\u001b[?2004h> import os, subprocess, zipfile, re\r\n\u001b[?2004l\r\u001b[?2004h> import xml.etree.ElementTree as ET\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_text(path):\r\n\u001b[?2004l\r\u001b[?2004h>     if path.endswith('.pdf'):\r\n\u001b[?2004l\r\u001b[?2004h>         return subprocess.check_output(['pdftotext', path, '-'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')\r\n\u001b[?2004l\r\u001b[?2004h>     if path.endswith('.docx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h>                 root = ET.fromstring(z.read('word/document.xml'))\r\n\u001b[?2004l\r\u001b[?2004h>                 return \" \".join(node.text for node in root.iter() if node.text)\r\n\u001b[?2004l\r\u001b[?2004h>         except: return \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if path.endswith('.pptx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             text = []\r\n\u001b[?2004l\r\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h>                 for f in z.namelist():\r\n\u001b[?2004l\r\u001b[?2004h>                     if f.startswith('ppt/slides/slide'):\r\n\u001b[?2004l\r\u001b[?2004h>                         root = ET.fromstring(z.read(f))\r\n\u001b[?2004l\r\u001b[?2004h>                         text.append(\" \".join(node.text for node in root.iter() if node.text))\r\n\u001b[?2004l\r\u001b[?2004h>             return \" \".join(text)\r\n\u001b[?2004l\r\u001b[?2004h>         except: return \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def classify(text, filename):\r\n\u001b[?2004l\r\u001b[?2004h>     text = text.lower() + \" \" + filename.lower()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check for Black Hole\r\n\u001b[?2004l\r\u001b[?2004h>     if re.search(r'\\b(black hole|event horizon|hawking radiation|schwarzschild|general relativity)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h>         return \"black_hole\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Check for DNA\r\n\u001b[?2004l\r\u001b[?2004h>     if re.search(r'\\b(dna|genome|genetics|sequencing|nucleotide|chromosome|rna)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h>         return \"DNA\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Check for Trapped Ion / QC\r\n\u001b[?2004l\r\u001b[?2004h>     if re.search(r'\\b(trapped ion|quantum computing|qubit|quantum gate|rydberg|ion trap|quantum simulation)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h>         return \"trapped_ion_and_qc\"\r\n\u001b[?2004l\r\u001b[?2004h>     # Check for LLM\r\n\u001b[?2004l\r\u001b[?2004h>     if re.search(r'\\b(large language model|llm|transformer|gpt|attention mechanism|pre-training|nlp)\\b', text):\r\n\u001b[?2004l\r\u001b[?2004h>         if \"music\" not in text or \"language model\" in text:\r\n\u001b[?2004l\r\u001b[?2004h>             return \"LLM\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return \"music_history\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cats = ['LLM', 'trapped_ion_and_qc', 'black_hole', 'DNA', 'music_history']\r\n\u001b[?2004l\r\u001b[?2004h> for c in cats: os.makedirs(c, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> all_files = []\r\n\u001b[?2004l\r\u001b[?2004h> for c in cats:\r\n\u001b[?2004l\r\u001b[?2004h>     for f in os.listdir(c):\r\n\u001b[?2004l\r\u001b[?2004h>         all_files.append(os.path.join(c, f))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for path in all_files:\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.isdir(path): continue\r\n\u001b[?2004l\r\u001b[?2004h>     filename = os.path.basename(path)\r\n\u001b[?2004l\r\u001b[?2004h>     text = get_text(path)\r\n\u001b[?2004l\r\u001b[?2004h>     category = classify(text, filename)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     dest = os.path.join(category, filename)\r\n\u001b[?2004l\r\u001b[?2004h>     if path != dest:\r\n\u001b[?2004l\r\u001b[?2004h>         os.rename(path, dest)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
