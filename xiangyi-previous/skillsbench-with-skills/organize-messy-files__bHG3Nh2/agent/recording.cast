[37.864455, "i", "cat << 'EOF' > classify.py\nimport os\nimport subprocess\nimport zipfile\nimport xml.etree.ElementTree as ET\n\ndef get_pdf_text(path):\n    try:\n        return subprocess.check_output(['pdftotext', path, '-'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')\n    except:\n        return \"\"\n\ndef get_docx_text(path):\n    try:\n        with zipfile.ZipFile(path) as z:\n            content = z.read('word/document.xml')\n            root = ET.fromstring(content)\n            return \" \".join(node.text for node in root.iter() if node.text)\n    except:\n        return \"\"\n\ndef get_pptx_text(path):\n    try:\n        text = []\n        with zipfile.ZipFile(path) as z:\n            for f in z.namelist():\n                if f.startswith('ppt/slides/slide'):\n                    content = z.read(f)\n                    root = ET.fromstring(content)\n                    text.append(\" \".join(node.text for node in root.iter() if node.text))\n        return \" \".join(text)\n    except:\n        return \"\"\n\ndef classify(text, filename):\n    text = text.lower() + \" \" + filename.lower()\n    if any(k in text for k in ['large language model', 'llm', 'transformer', 'gpt', 'pre-training', 'attention mechanism', 'neural machine translation']):\n        return \"LLM\"\n    if any(k in text for k in ['trapped ion', 'quantum computing', 'qubit', 'quantum gate', 'rydberg', 'ion trap', 'quantum simulation']):\n        return \"trapped_ion_and_qc\"\n    if any(k in text for k in ['black hole', 'event horizon', 'hawking radiation', 'general relativity', 'schwarzschild', 'gravitational wave']):\n        return \"black_hole\"\n    if any(k in text for k in ['dna', 'genome', 'nucleotide', 'genetics', 'sequencing', 'biological', 'chromosome', 'rna']):\n        return \"DNA\"\n    return \"music_history\"\n\nsource_dir = 'papers/all'\nfor filename in os.listdir(source_dir):\n    path = os.path.join(source_dir, filename)\n    if os.path.isdir(path): continue\n    \n    text = \"\"\n    if filename.endswith('.pdf'):\n        text = get_pdf_text(path)\n    elif filename.endswith('.docx'):\n        text = get_docx_text(path)\n    elif filename.endswith('.pptx'):\n        text = get_pptx_text(path)\n    \n    category = classify(text, filename)\n    os.rename(path, os.path.join(category, filename))\nEOF\npython3 classify.py\n"]
