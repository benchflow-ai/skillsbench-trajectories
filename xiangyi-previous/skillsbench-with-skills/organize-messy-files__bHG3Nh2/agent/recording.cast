[255.375221, "o", "arXiv:1403.4513v1 [stat.AP] 14 Nov 2013\r\n\r\nA quantitative approach to evolution of music and\r\nphilosophy\r\nVilson Vieira1 , Renato Fabbri1 , Gonzalo Travieso1 , Osvaldo N.\r\n"]
[255.37915, "o", "\u001b[?2004hroot@b4b2e5e10690:~# "]
