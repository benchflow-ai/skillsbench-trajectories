[37.384505, "i", "cat <<EOF > export_obj.js\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from './data/object.js';\nimport fs from 'fs';\nimport path from 'path';\n\n// Create the object\nconst root = createScene();\n\n// Apply -90 degrees X-rotation for Blender Z-up\n// root is a THREE.Group or THREE.Object3D\nroot.rotation.x = -Math.PI / 2;\n\n// We need to ensure matrices are updated before exporting\nroot.updateMatrixWorld(true);\n\n// Export to OBJ\nconst exporter = new OBJExporter();\nconst result = exporter.parse(root);\n\n// Write to file\nconst outputPath = '/root/output/object.obj';\nfs.writeFileSync(outputPath, result);\n\nconsole.log('Successfully exported to ' + outputPath);\nEOF\n"]
