[?2004l[?2004h>         for (let i = 0; i < im.count; i++) {
[?2004l[?2004h>             im.getMatrixAt(i, matrix);
[?2004l[?2004h>             const mesh = new THREE.Mesh(im.geometry, im.material);
[?2004l[?2004h>             mesh.applyMatrix4(matrix);
[?2004l[?2004h>             mesh.name = im.name + '_' + i;
[?2004l[?2004h>             group.add(mesh);
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         group.copy(im, false); // Copy transform of the InstancedMesh itself
[?2004l[?2004h>         parent.add(group);
[?2004l[?2004h>         parent.remove(im);
[?2004l[?2004h>     });
[?2004l[?2004h> }
