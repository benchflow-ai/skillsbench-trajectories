[?2004l[?2004h>     const instancedMeshes = [];
[?2004l[?2004h>     object.traverse(child => {
[?2004l[?2004h>         if (child.isInstancedMesh) {
[?2004l[?2004h>             instancedMeshes.push(child);
[?2004l[?2004h>         }
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     instancedMeshes.forEach(im => {
[?2004l[?2004h>         const parent = im.parent;
[?2004l[?2004h>         const group = new THREE.Group();
[?2004l[?2004h>         group.name = im.name + '_instances';
[?2004l[?2004h>         
