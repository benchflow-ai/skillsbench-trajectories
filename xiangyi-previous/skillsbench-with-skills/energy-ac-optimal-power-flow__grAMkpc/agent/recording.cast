[553.560868, "o", "\u001b[?2004h> "]
[553.560936, "o", "        Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.561019, "o", "\u001b[?2004h> "]
