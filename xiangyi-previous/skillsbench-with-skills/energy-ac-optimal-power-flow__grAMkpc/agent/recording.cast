[442.250972, "o", "\u001b[?2004h> "]
[442.251131, "o", "# Load network data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.251173, "o", "with open('network.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.25122, "o", "baseMVA = data['baseMVA']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.251265, "o", "buses = np.array(data['bus'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.251318, "o", "gens = np.array(data['gen'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[442.251379, "o", "> "]
[442.251407, "o", "branches = np.array(data['branch'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.25147, "o", "gencosts = np.array(data['gencost'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[442.251527, "o", "\u001b[?2004h> "]
[442.251559, "o", "n_bus = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.251617, "o", "n_gen = len(gens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.251685, "o", "n_branch = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
