[149.938029, "o", "        elif n_cost[i] == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.938085, "o", "            c1[i] = cost_coeffs[i, 0] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.938121, "o", "> "]
[149.938196, "o", "            c0[i] = cost_coeffs[i, 1]\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[149.939376, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[162.794454, "i", "cat >> solve_acopf.py << 'EOF'\n\n# Branch data\nfbus = branches[:, 0].astype(int) - 1\ntbus = branches[:, 1].astype(int) - 1\nR = branches[:, 2]\nX = branches[:, 3]\nB = branches[:, 4]\nrate_a = branches[:, 5] / baseMVA\ntap = branches[:, 7]\nshift = branches[:, 8] * np.pi / 180\nbr_status = branches[:, 10].astype(int)\nang_min = branches[:, 11] * np.pi / 180\nang_max = branches[:, 12] * np.pi / 180\n\ntap[tap == 0] = 1.0\n\n# Build admittance matrix\nYbus = np.zeros((n_bus, n_bus), dtype=complex)\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\n    Ybus[t, t] += Ys + Ysh/2\n    Ybus[f, t] += -Ys / np.conj(tr)\n    Ybus[t, f] += -Ys / tr\n\nfor i in range(n_bus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\nslack_bus = np.where(bus_type == 3)[0]\nif len(slack_bus) == 0:\n    slack_bus = [0]\nelse:\n    slack_bus = [slack_bus[0]]\n\nprint(f\"Slack bus: {slack_bus[0] + 1}\")\nprint(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW, {np.sum(Qd)*baseMVA:.2f} MVAr\")\nEOF\n"]
