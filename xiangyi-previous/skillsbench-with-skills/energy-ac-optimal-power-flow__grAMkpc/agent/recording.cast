[162.796827, "o", "if len(slack_bus) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796881, "o", "    slack_bus = [0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796918, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796996, "o", "    slack_bus = [slack_bus[0]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.797068, "o", "print(f\"Slack bus: {slack_bus[0] + 1}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
