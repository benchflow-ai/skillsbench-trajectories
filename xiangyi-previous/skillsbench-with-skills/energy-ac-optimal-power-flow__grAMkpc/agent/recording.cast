[162.797231, "o", "print(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW, {np.sum(Qd)*baseMVA:.2f} MVAr\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[162.798106, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[173.974544, "i", "cat >> solve_acopf.py << 'EOF'\n\ndef pack_vars(Va, Vm, Pg, Qg):\n    return np.concatenate([Va, Vm, Pg, Qg])\n\ndef unpack_vars(x):\n    Va = x[0:n_bus]\n    Vm = x[n_bus:2*n_bus]\n    Pg = x[2*n_bus:2*n_bus+n_gen]\n    Qg = x[2*n_bus+n_gen:2*n_bus+2*n_gen]\n    return Va, Vm, Pg, Qg\n\ndef objective(x):\n    _, _, Pg, _ = unpack_vars(x)\n    Pg_MW = Pg * baseMVA\n    cost = np.sum(c2 * Pg_MW**2 + c1 * Pg_MW + c0)\n    return cost\n\ndef power_flow_mismatch(Va, Vm, Pg, Qg):\n    V = Vm * np.exp(1j * Va)\n    S_calc = V * np.conj(Ybus @ V)\n    P_calc = S_calc.real\n    Q_calc = S_calc.imag\n    \n    P_inj = np.zeros(n_bus)\n    Q_inj = np.zeros(n_bus)\n    \n    for i in range(n_gen):\n        if gen_status[i]:\n            P_inj[gen_bus[i]] += Pg[i]\n            Q_inj[gen_bus[i]] += Qg[i]\n    \n    P_mismatch = P_inj - Pd - P_calc\n    Q_mismatch = Q_inj - Qd - Q_calc\n    \n    return P_mismatch, Q_mismatch\n\ndef constraints_eq(x):\n    Va, Vm, Pg, Qg = unpack_vars(x)\n    P_mis, Q_mis = power_flow_mismatch(Va, Vm, Pg, Qg)\n    angle_constraint = Va[slack_bus[0]]\n    return np.concatenate([P_mis, Q_mis, [angle_constraint]])\nEOF\n"]
