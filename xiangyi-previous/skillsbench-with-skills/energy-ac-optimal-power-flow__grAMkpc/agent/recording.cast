[364.974083, "o", "> "]
[364.974122, "o", "Qmax = gens[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.974186, "o", "Qmin = gens[:, 4] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
