[149.93546, "o", "\u001b[?2004h> "]
[149.93549, "o", "n_bus = len(buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.935524, "o", "n_gen = len(gens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.935561, "o", "> "]
[149.935596, "o", "n_branch = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.935632, "o", "\u001b[?2004h> "]
[149.935787, "o", "print(f\"Loading network: {n_bus} buses, {n_gen} generators, {n_branch} branches\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.935863, "o", "# Bus data (1-indexed in file, convert to 0-indexed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.935925, "o", "bus_id = buses[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.935989, "o", "bus_type = buses[:, 1].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.936025, "o", "> "]
[149.936058, "o", "Pd = buses[:, 2] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936146, "o", "Qd = buses[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> Gs = buses[:, 4]\r\n\u001b[?2004l\r"]
[149.936179, "o", "\u001b[?2004h> "]
[149.936255, "o", "Bs = buses[:, 5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936289, "o", "Vm_init = buses[:, 7]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936327, "o", "Va_init = buses[:, 8] * np.pi / 180\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.936412, "o", "> Vmax = buses[:, 11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
