[417.462751, "o", "\u001b[?2004h> "]
[417.462813, "o", "        \"vmax_pu\": float(Vmax[i])\r\n\u001b[?2004l\r"]
[417.462879, "o", "\u001b[?2004h> "]
[417.462926, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[417.462967, "o", "# Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[417.463054, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r"]
