[553.565248, "o", "\u001b[?2004h> "]
[553.565298, "o", "for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.565347, "o", "> "]
[553.565398, "o", "    if gen_status[i]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.565483, "o", "        P_inj[gen_bus[i]] += Pg_pu[i]\r\n\u001b[?2004l\r"]
[553.565528, "o", "\u001b[?2004h> "]
[553.565605, "o", "        Q_inj[gen_bus[i]] += Qg_pu[i]\r\n\u001b[?2004l\r"]
[553.565656, "o", "\u001b[?2004h> "]
[553.565705, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.565744, "o", "dP = P_inj - Pd_pu - P_calc\r\n\u001b[?2004l\r"]
[553.565788, "o", "\u001b[?2004h> "]
[553.565841, "o", "dQ = Q_inj - Qd_pu - Q_calc\r\n\u001b[?2004l\r"]
[553.565892, "o", "\u001b[?2004h> "]
[553.565935, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.566009, "o", "max_p_mis = np.max(np.abs(dP)) * baseMVA\r\n\u001b[?2004l\r"]
[553.566052, "o", "\u001b[?2004h> "]
[553.566151, "o", "max_q_mis = np.max(np.abs(dQ)) * baseMVA\r\n\u001b[?2004l\r"]
[553.566196, "o", "\u001b[?2004h> "]
[553.566287, "o", "print(f\"Max P mismatch: {max_p_mis:.6f} MW\")\r\n\u001b[?2004l\r"]
[553.566334, "o", "\u001b[?2004h> "]
[553.566436, "o", "print(f\"Max Q mismatch: {max_q_mis:.6f} MVAr\")\r\n\u001b[?2004l\r"]
[553.56649, "o", "\u001b[?2004h> "]
[553.566542, "o", "EOF\r\n\u001b[?2004l\r"]
[553.567753, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[569.730087, "i", "cat >> solve_ed.py << 'EOF'\n\n# Calculate cost\ntotal_cost = np.sum(c2 * Pg**2 + c1 * Pg + c0)\nprint(f\"\\nTotal cost: ${total_cost:,.2f}/hr\")\n\n# Calculate totals\ntotal_gen_P = np.sum(Pg[gen_status == 1])\ntotal_gen_Q = np.sum(Qg[gen_status == 1])\ntotal_load_P = np.sum(Pd)\ntotal_load_Q = np.sum(Qd)\ntotal_losses = total_gen_P - total_load_P\n\nprint(f\"Generation: {total_gen_P:.2f} MW, {total_gen_Q:.2f} MVAr\")\nprint(f\"Load: {total_load_P:.2f} MW, {total_load_Q:.2f} MVAr\")\nprint(f\"Losses: {total_losses:.2f} MW\")\n\n# Calculate branch flows\nprint(\"Calculating branch flows...\")\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 and limit_MVA < 9999 else 0\n    \n    branch_data.append({\n        'from_bus': int(fbus[i] + 1),\n        'to_bus': int(tbus[i] + 1),\n        'loading_pct': float(loading_pct),\n        'flow_from_MVA': float(Sf_MVA),\n        'flow_to_MVA': float(St_MVA),\n        'limit_MVA': float(limit_MVA)\n    })\n\nbranch_data.sort(key=lambda x: x['loading_pct'], reverse=True)\nmost_loaded = branch_data[:10]\n\nif most_loaded:\n    print(f\"Most loaded branch: {most_loaded[0]['from_bus']}-{most_loaded[0]['to_bus']} at {most_loaded[0]['loading_pct']:.2f}%\")\nEOF\n"]
