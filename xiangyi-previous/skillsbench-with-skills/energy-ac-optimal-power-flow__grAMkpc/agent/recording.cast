[364.975842, "o", "            c1[i] = cost_coeffs[i, 1] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.975953, "o", "            c0[i] = cost_coeffs[i, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
