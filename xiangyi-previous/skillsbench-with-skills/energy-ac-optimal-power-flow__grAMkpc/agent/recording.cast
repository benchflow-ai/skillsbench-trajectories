[385.734477, "o", "    Q_inj = np.zeros(n_bus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.7345, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.734559, "o", "    for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.734599, "o", "> "]
[385.734622, "o", "        if gen_status[i]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.734741, "o", "            P_inj[gen_bus[i]] += Pg[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.734849, "o", "            Q_inj[gen_bus[i]] += Qg[i]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.734891, "o", "    # Mismatches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.734961, "o", "    dP = P_inj - Pd - P_calc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.735011, "o", "    dQ = Q_inj - Qd - Q_calc\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[385.735031, "o", "> "]
[385.735125, "o", "    # Remove slack bus from P mismatch and PV buses from Q mismatch\r\n\u001b[?2004l\r"]
[385.735151, "o", "\u001b[?2004h> "]
[385.735215, "o", "    pv_buses = np.where(bus_type == 2)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.735235, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[385.735255, "o", "> "]
[385.735351, "o", "    max_mis = max(np.max(np.abs(dP)), np.max(np.abs(dQ)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.735378, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.735431, "o", "    if iteration % 5 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.73545, "o", "> "]
[385.735584, "o", "        print(f\"  Iter {iteration}: max mismatch = {max_mis*baseMVA:.6f} MW/MVAr\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[385.735607, "o", "\u001b[?2004h> "]
[385.735658, "o", "    if max_mis < tol:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.735736, "o", "        print(f\"Converged in {iteration} iterations\")\r\n\u001b[?2004l\r"]
[385.735756, "o", "\u001b[?2004h> "]
[385.735774, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.735792, "o", ">     \r\n\u001b[?2004l\r"]
[385.73581, "o", "\u001b[?2004h> "]
[385.735893, "o", "    if iteration == max_iter - 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.735984, "o", "        print(\"Warning: Did not converge, using best solution\")\r\n\u001b[?2004l\r"]
[385.736005, "o", "\u001b[?2004h> "]
[385.736022, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.736039, "o", "> \r\n\u001b[?2004l\r"]
[385.736056, "o", "\u001b[?2004h> "]
[385.736133, "o", "# Update Qg for generators\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.736152, "o", "for i in range(n_gen):\r\n\u001b[?2004l\r"]
[385.736169, "o", "\u001b[?2004h> "]
[385.736232, "o", "    if gen_status[i]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[385.736276, "o", "        bus_idx = gen_bus[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.736297, "o", "> "]
[385.736369, "o", "        Qg[i] = Q_calc[bus_idx] + Qd[bus_idx]\r\n\u001b[?2004l\r"]
[385.73639, "o", "\u001b[?2004h> "]
[385.736465, "o", "        Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[385.736485, "o", "> EOF\r\n\u001b[?2004l\r"]
[385.737538, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[402.185411, "i", "cat >> solve_simple.py << 'EOF'\n\n# Calculate cost\nPg_MW = Pg * baseMVA\ntotal_cost = np.sum(c2 * Pg_MW**2 + c1 * Pg_MW + c0)\n\nprint(f\"\\nTotal cost: ${total_cost:,.2f}/hr\")\n\n# Calculate totals\ntotal_gen_P = np.sum(Pg[gen_status == 1]) * baseMVA\ntotal_gen_Q = np.sum(Qg[gen_status == 1]) * baseMVA\ntotal_load_P = np.sum(Pd) * baseMVA\ntotal_load_Q = np.sum(Qd) * baseMVA\ntotal_losses = total_gen_P - total_load_P\n\nprint(f\"Generation: {total_gen_P:.2f} MW, {total_gen_Q:.2f} MVAr\")\nprint(f\"Load: {total_load_P:.2f} MW, {total_load_Q:.2f} MVAr\")\nprint(f\"Losses: {total_losses:.2f} MW\")\n\n# Calculate branch flows\nV = Vm * np.exp(1j * Va)\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] * baseMVA if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 else 0\n    \n    branch_data.append({\n        'from_bus': int(fbus[i] + 1),\n        'to_bus': int(tbus[i] + 1),\n        'loading_pct': float(loading_pct),\n        'flow_from_MVA': float(Sf_MVA),\n        'flow_to_MVA': float(St_MVA),\n        'limit_MVA': float(limit_MVA)\n    })\n\nbranch_data.sort(key=lambda x: x['loading_pct'], reverse=True)\nmost_loaded = branch_data[:10]\n\nprint(f\"Most loaded branch: {most_loaded[0]['loading_pct']:.2f}%\")\nEOF\n"]
