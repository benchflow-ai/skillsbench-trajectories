[553.56165, "o", "tap = branches[:, 7]\r\n\u001b[?2004l\r"]
[553.5617, "o", "\u001b[?2004h> "]
[553.561763, "o", "shift = branches[:, 8] * np.pi / 180\r\n\u001b[?2004l\r"]
[553.561808, "o", "\u001b[?2004h> "]
[553.561912, "o", "br_status = branches[:, 10].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.561958, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.561999, "o", "tap[tap == 0] = 1.0\r\n\u001b[?2004l\r"]
[553.562051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
