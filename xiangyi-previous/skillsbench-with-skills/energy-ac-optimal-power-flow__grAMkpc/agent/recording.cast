[534.354657, "o", "Pd = buses[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.354726, "o", "> "]
[534.35477, "o", "Qd = buses[:, 3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.354839, "o", "Gs = buses[:, 4]\r\n\u001b[?2004l\r"]
[534.354887, "o", "\u001b[?2004h> Bs = buses[:, 5]\r\n\u001b[?2004l\r"]
[534.354941, "o", "\u001b[?2004h> "]
[534.354995, "o", "Vm = buses[:, 7]\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.355041, "o", "> Va = buses[:, 8]\r\n\u001b[?2004l\r"]
[534.355067, "o", "\u001b[?2004h> "]
[534.35515, "o", "Vmax = buses[:, 11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.355213, "o", "Vmin = buses[:, 12]\r\n\u001b[?2004l\r"]
[534.355257, "o", "\u001b[?2004h> "]
[534.355311, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.355355, "o", "total_load = np.sum(Pd)\r\n\u001b[?2004l\r"]
[534.355406, "o", "\u001b[?2004h> "]
[534.355491, "o", "print(f\"Total load: {total_load:.2f} MW\")\r\n\u001b[?2004l\r"]
[534.355536, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.355588, "o", "\u001b[?2004h> "]
[534.35564, "o", "# Parse generator data\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.355689, "o", "> "]
[534.355736, "o", "gen_bus = gens[:, 0].astype(int) - 1\r\n\u001b[?2004l\r"]
[534.355789, "o", "\u001b[?2004h> "]
[534.355855, "o", "gen_status = gens[:, 7].astype(int)\r\n\u001b[?2004l\r"]
[534.355906, "o", "\u001b[?2004h> "]
[534.355953, "o", "Pmax = gens[:, 8]\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.356005, "o", "> "]
[534.356054, "o", "Pmin = gens[:, 9]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.356105, "o", "Qmax = gens[:, 3]\r\n\u001b[?2004l\r"]
[534.356154, "o", "\u001b[?2004h> "]
[534.356202, "o", "Qmin = gens[:, 4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.356235, "o", "Vg = gens[:, 5]\r\n\u001b[?2004l\r"]
[534.356276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.356328, "o", "\u001b[?2004h> "]
[534.356377, "o", "# Parse cost data\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.356425, "o", "> "]
[534.356478, "o", "cost_model = gencosts[:, 0].astype(int)\r\n\u001b[?2004l\r"]
[534.356522, "o", "\u001b[?2004h> "]
[534.356605, "o", "n_cost = gencosts[:, 3].astype(int)\r\n\u001b[?2004l\r"]
[534.356655, "o", "\u001b[?2004h> "]
[534.356706, "o", "cost_coeffs = gencosts[:, 4:]\r\n\u001b[?2004l\r"]
[534.356757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.356799, "o", "\u001b[?2004h> "]
[534.356823, "o", "c2 = np.zeros(n_gen)\r\n\u001b[?2004l\r"]
[534.35687, "o", "\u001b[?2004h> "]
[534.356969, "o", "c1 = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.357036, "o", "c0 = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.357079, "o", "for i in range(n_gen):\r\n\u001b[?2004l\r"]
[534.357131, "o", "\u001b[?2004h> "]
[534.357179, "o", "    if cost_model[i] == 2:\r\n\u001b[?2004l\r"]
[534.357232, "o", "\u001b[?2004h> "]
[534.357276, "o", "        if n_cost[i] == 3:\r\n\u001b[?2004l\r"]
[534.357327, "o", "\u001b[?2004h> "]
[534.357399, "o", "            c2[i] = cost_coeffs[i, 0]\r\n\u001b[?2004l\r"]
[534.357451, "o", "\u001b[?2004h> "]
[534.357521, "o", "            c1[i] = cost_coeffs[i, 1]\r\n\u001b[?2004l\r"]
[534.357574, "o", "\u001b[?2004h> "]
[534.357643, "o", "            c0[i] = cost_coeffs[i, 2]\r\n\u001b[?2004l\r"]
[534.357688, "o", "\u001b[?2004h> "]
[534.357742, "o", "        elif n_cost[i] == 2:\r\n\u001b[?2004l\r"]
[534.357793, "o", "\u001b[?2004h> "]
[534.357866, "o", "            c1[i] = cost_coeffs[i, 0]\r\n\u001b[?2004l\r"]
[534.357917, "o", "\u001b[?2004h> "]
[534.357989, "o", "            c0[i] = cost_coeffs[i, 1]\r\n\u001b[?2004l\r"]
[534.358033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.358084, "o", "\u001b[?2004h> "]
[534.358206, "o", "# Economic dispatch - merit order by marginal cost at mid-point\r\n\u001b[?2004l\r"]
[534.358259, "o", "\u001b[?2004h> "]
[534.358304, "o", "Pg = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.358355, "o", "> "]
[534.358396, "o", "marginal_cost = np.zeros(n_gen)\r\n\u001b[?2004l\r"]
[534.358447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.358489, "o", "\u001b[?2004h> "]
[534.358544, "o", "for i in range(n_gen):\r\n\u001b[?2004l\r"]
[534.358596, "o", "\u001b[?2004h>     if gen_status[i]:\r\n"]
[534.358648, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[534.35872, "o", "        Pmid = (Pmax[i] + Pmin[i]) / 2\r\n\u001b[?2004l\r"]
[534.358774, "o", "\u001b[?2004h> "]
[534.358892, "o", "        marginal_cost[i] = 2 * c2[i] * Pmid + c1[i]\r\n\u001b[?2004l\r"]
[534.358943, "o", "\u001b[?2004h> "]
[534.358998, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.359052, "o", "        marginal_cost[i] = 1e10\r\n\u001b[?2004l\r"]
[534.359109, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.359164, "o", "\u001b[?2004h> "]
[534.359223, "o", "# Sort generators by marginal cost\r\n\u001b[?2004l\r"]
[534.359275, "o", "\u001b[?2004h> "]
[534.359347, "o", "gen_order = np.argsort(marginal_cost)\r\n\u001b[?2004l\r"]
[534.359399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.359451, "o", "\u001b[?2004h> "]
[534.359524, "o", "# Dispatch generators to meet load + 5% for losses\r\n\u001b[?2004l\r"]
[534.359576, "o", "\u001b[?2004h> "]
[534.359638, "o", "target_gen = total_load * 1.05\r\n\u001b[?2004l\r"]
[534.359682, "o", "\u001b[?2004h> "]
[534.359727, "o", "remaining = target_gen\r\n\u001b[?2004l\r"]
[534.359752, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.359812, "o", "\u001b[?2004h> "]
[534.359862, "o", "for i in gen_order:\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.359911, "o", "> "]
[534.359957, "o", "    if gen_status[i] == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[534.36001, "o", "> "]
[534.36006, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.360101, "o", "    if remaining <= 0:\r\n\u001b[?2004l\r"]
[534.36013, "o", "\u001b[?2004h> "]
[534.3602, "o", "        Pg[i] = Pmin[i]\r\n\u001b[?2004l\r"]
[534.360251, "o", "\u001b[?2004h> "]
[534.360304, "o", "    elif remaining >= Pmax[i]:\r\n\u001b[?2004l\r"]
[534.360357, "o", "\u001b[?2004h> "]
[534.360396, "o", "        Pg[i] = Pmax[i]\r\n\u001b[?2004l\r"]
[534.360447, "o", "\u001b[?2004h> "]
[534.360498, "o", "        remaining -= Pmax[i]\r\n\u001b[?2004l\r"]
[534.360548, "o", "\u001b[?2004h> "]
[534.360599, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[534.360644, "o", "        Pg[i] = remaining\r\n\u001b[?2004l\r"]
[534.36069, "o", "\u001b[?2004h> "]
[534.360732, "o", "        remaining = 0\r\n\u001b[?2004l\r"]
[534.360783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[534.360832, "o", "\u001b[?2004h> "]
[534.360917, "o", "print(f\"Economic dispatch: {np.sum(Pg):.2f} MW\")\r\n\u001b[?2004l\r"]
[534.360968, "o", "\u001b[?2004h> "]
[534.361019, "o", "EOF\r\n\u001b[?2004l\r"]
[534.362233, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[553.559697, "i", "cat >> solve_ed.py << 'EOF'\n\n# Set Qg proportional to Pg within limits\nQg = np.zeros(n_gen)\nfor i in range(n_gen):\n    if gen_status[i] and Pg[i] > 0:\n        # Assume power factor of 0.95\n        Qg[i] = Pg[i] * 0.33  # tan(acos(0.95))\n        Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])\n\n# Parse branch data\nfbus = branches[:, 0].astype(int) - 1\ntbus = branches[:, 1].astype(int) - 1\nR = branches[:, 2]\nX = branches[:, 3]\nB = branches[:, 4]\nrate_a = branches[:, 5]\ntap = branches[:, 7]\nshift = branches[:, 8] * np.pi / 180\nbr_status = branches[:, 10].astype(int)\n\ntap[tap == 0] = 1.0\n\n# Build Ybus\nprint(\"Building admittance matrix...\")\nYbus = np.zeros((n_bus, n_bus), dtype=complex)\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\n    Ybus[t, t] += Ys + Ysh/2\n    Ybus[f, t] += -Ys / np.conj(tr)\n    Ybus[t, f] += -Ys / tr\n\nfor i in range(n_bus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\n# Convert to per-unit\nPd_pu = Pd / baseMVA\nQd_pu = Qd / baseMVA\nPg_pu = Pg / baseMVA\nQg_pu = Qg / baseMVA\nVa_rad = Va * np.pi / 180\n\nprint(\"Calculating power flows...\")\nV = Vm * np.exp(1j * Va_rad)\nS_calc = V * np.conj(Ybus @ V)\nP_calc = S_calc.real\nQ_calc = S_calc.imag\n\n# Net injections\nP_inj = np.zeros(n_bus)\nQ_inj = np.zeros(n_bus)\nfor i in range(n_gen):\n    if gen_status[i]:\n        P_inj[gen_bus[i]] += Pg_pu[i]\n        Q_inj[gen_bus[i]] += Qg_pu[i]\n\ndP = P_inj - Pd_pu - P_calc\ndQ = Q_inj - Qd_pu - Q_calc\n\nmax_p_mis = np.max(np.abs(dP)) * baseMVA\nmax_q_mis = np.max(np.abs(dQ)) * baseMVA\nprint(f\"Max P mismatch: {max_p_mis:.6f} MW\")\nprint(f\"Max Q mismatch: {max_q_mis:.6f} MVAr\")\nEOF\n"]
[553.55995, "o", "cat >> solve_ed.py << 'EOF'\r\n\u001b[?2004l\r"]
