[162.795029, "o", "R = branches[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.795059, "o", "> X = branches[:, 3]\r\n\u001b[?2004l\r"]
[162.795095, "o", "\u001b[?2004h> "]
