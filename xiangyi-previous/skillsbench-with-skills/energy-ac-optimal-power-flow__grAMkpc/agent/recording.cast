[364.974307, "o", "Pmax = gens[:, 8] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.974365, "o", "Pmin = gens[:, 9] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.974385, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
