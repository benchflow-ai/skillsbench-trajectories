[173.976239, "o", "    for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.976329, "o", "        if gen_status[i]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.976391, "o", "            P_inj[gen_bus[i]] += Pg[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
