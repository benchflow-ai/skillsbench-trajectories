[534.352315, "i", "cat > solve_ed.py << 'EOF'\nimport json\nimport numpy as np\n\nprint(\"Loading network data...\")\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbuses = np.array(data['bus'])\ngens = np.array(data['gen'])\nbranches = np.array(data['branch'])\ngencosts = np.array(data['gencost'])\n\nn_bus = len(buses)\nn_gen = len(gens)\nn_branch = len(branches)\n\nprint(f\"Network: {n_bus} buses, {n_gen} generators, {n_branch} branches\")\n\n# Parse bus data\nbus_id = buses[:, 0].astype(int)\nbus_type = buses[:, 1].astype(int)\nPd = buses[:, 2]\nQd = buses[:, 3]\nGs = buses[:, 4]\nBs = buses[:, 5]\nVm = buses[:, 7]\nVa = buses[:, 8]\nVmax = buses[:, 11]\nVmin = buses[:, 12]\n\ntotal_load = np.sum(Pd)\nprint(f\"Total load: {total_load:.2f} MW\")\n\n# Parse generator data\ngen_bus = gens[:, 0].astype(int) - 1\ngen_status = gens[:, 7].astype(int)\nPmax = gens[:, 8]\nPmin = gens[:, 9]\nQmax = gens[:, 3]\nQmin = gens[:, 4]\nVg = gens[:, 5]\n\n# Parse cost data\ncost_model = gencosts[:, 0].astype(int)\nn_cost = gencosts[:, 3].astype(int)\ncost_coeffs = gencosts[:, 4:]\n\nc2 = np.zeros(n_gen)\nc1 = np.zeros(n_gen)\nc0 = np.zeros(n_gen)\nfor i in range(n_gen):\n    if cost_model[i] == 2:\n        if n_cost[i] == 3:\n            c2[i] = cost_coeffs[i, 0]\n            c1[i] = cost_coeffs[i, 1]\n            c0[i] = cost_coeffs[i, 2]\n        elif n_cost[i] == 2:\n            c1[i] = cost_coeffs[i, 0]\n            c0[i] = cost_coeffs[i, 1]\n\n# Economic dispatch - merit order by marginal cost at mid-point\nPg = np.zeros(n_gen)\nmarginal_cost = np.zeros(n_gen)\n\nfor i in range(n_gen):\n    if gen_status[i]:\n        Pmid = (Pmax[i] + Pmin[i]) / 2\n        marginal_cost[i] = 2 * c2[i] * Pmid + c1[i]\n    else:\n        marginal_cost[i] = 1e10\n\n# Sort generators by marginal cost\ngen_order = np.argsort(marginal_cost)\n\n# Dispatch generators to meet load + 5% for losses\ntarget_gen = total_load * 1.05\nremaining = target_gen\n\nfor i in gen_order:\n    if gen_status[i] == 0:\n        continue\n    if remaining <= 0:\n        Pg[i] = Pmin[i]\n    elif remaining >= Pmax[i]:\n        Pg[i] = Pmax[i]\n        remaining -= Pmax[i]\n    else:\n        Pg[i] = remaining\n        remaining = 0\n\nprint(f\"Economic dispatch: {np.sum(Pg):.2f} MW\")\nEOF\n"]
