[458.159494, "o", "            c1[i] = cost_coeffs[i, 1] * baseMVA\r\n\u001b[?2004l\r"]
[458.159548, "o", "\u001b[?2004h> "]
[458.159599, "o", "            c0[i] = cost_coeffs[i, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.159642, "o", "        elif n_cost[i] == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.159733, "o", "            c1[i] = cost_coeffs[i, 0] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.159802, "o", "            c0[i] = cost_coeffs[i, 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.159865, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.159921, "o", "# Calculate total cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.159971, "o", "Pg_MW = Pg * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160018, "o", "total_cost = np.sum(c2 * Pg_MW**2 + c1 * Pg_MW + c0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.160047, "o", "> "]
[458.160114, "o", "print(f\"Total cost: ${total_cost:,.2f}/hr\")\r\n\u001b[?2004l\r"]
[458.160166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160219, "o", "# Parse branch data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160268, "o", "fbus = branches[:, 0].astype(int) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160323, "o", "tbus = branches[:, 1].astype(int) - 1\r\n\u001b[?2004l\r"]
[458.160369, "o", "\u001b[?2004h> "]
[458.160403, "o", "R = branches[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160475, "o", "X = branches[:, 3]\r\n\u001b[?2004l\r\u001b[?2004h> B = branches[:, 4]\r\n\u001b[?2004l\r"]
[458.160502, "o", "\u001b[?2004h> "]
[458.160548, "o", "rate_a = branches[:, 5] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160611, "o", "tap = branches[:, 7]\r\n\u001b[?2004l\r"]
[458.160661, "o", "\u001b[?2004h> shift = branches[:, 8] * np.pi / 180\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.160712, "o", "> "]
[458.160758, "o", "br_status = branches[:, 10].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160782, "o", "tap[tap == 0] = 1.0\r\n\u001b[?2004l\r"]
[458.160833, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[458.160866, "o", "> # Build Ybus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.160934, "o", "Ybus = np.zeros((n_bus, n_bus), dtype=complex)\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.160981, "o", "> "]
[458.161009, "o", "for i in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161066, "o", "    if br_status[i] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161136, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161186, "o", "    f = fbus[i]\r\n\u001b[?2004l\r\u001b[?2004h>     t = tbus[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161234, "o", "    Ys = 1.0 / (R[i] + 1j * X[i])\r\n\u001b[?2004l\r"]
[458.161257, "o", "\u001b[?2004h> "]
[458.16132, "o", "    Ysh = 1j * B[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.161347, "o", ">     tr = tap[i] * np.exp(1j * shift[i])\r\n\u001b[?2004l\r"]
[458.161414, "o", "\u001b[?2004h> "]
[458.161454, "o", "    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\r\n\u001b[?2004l\r"]
[458.161506, "o", "\u001b[?2004h> "]
[458.161554, "o", "    Ybus[t, t] += Ys + Ysh/2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161603, "o", "    Ybus[f, t] += -Ys / np.conj(tr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161642, "o", "    Ybus[t, f] += -Ys / tr\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.161695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161755, "o", "for i in range(n_bus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161784, "o", "    Ybus[i, i] += Gs[i] + 1j * Bs[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[458.161849, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[458.161903, "o", "print(\"Calculating power flows...\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[458.163055, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[475.343923, "i", "cat >> solve_final.py << 'EOF'\n\n# Calculate power injections and verify balance\nV = Vm * np.exp(1j * Va)\nS_calc = V * np.conj(Ybus @ V)\nP_calc = S_calc.real\nQ_calc = S_calc.imag\n\n# Net injections\nP_inj = np.zeros(n_bus)\nQ_inj = np.zeros(n_bus)\n\nfor i in range(n_gen):\n    if gen_status[i]:\n        P_inj[gen_bus[i]] += Pg[i]\n        Q_inj[gen_bus[i]] += Qg[i]\n\n# Power balance mismatches\ndP = P_inj - Pd - P_calc\ndQ = Q_inj - Qd - Q_calc\n\nmax_p_mismatch = np.max(np.abs(dP)) * baseMVA\nmax_q_mismatch = np.max(np.abs(dQ)) * baseMVA\n\nprint(f\"Max P mismatch: {max_p_mismatch:.6f} MW\")\nprint(f\"Max Q mismatch: {max_q_mismatch:.6f} MVAr\")\n\n# Calculate branch flows\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] * baseMVA if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 and limit_MVA < 9999 else 0\n    \n    branch_data.append({\n        'from_bus': int(fbus[i] + 1),\n        'to_bus': int(tbus[i] + 1),\n        'loading_pct': float(loading_pct),\n        'flow_from_MVA': float(Sf_MVA),\n        'flow_to_MVA': float(St_MVA),\n        'limit_MVA': float(limit_MVA)\n    })\n\nbranch_data.sort(key=lambda x: x['loading_pct'], reverse=True)\nmost_loaded = branch_data[:10]\n\nif most_loaded:\n    print(f\"Most loaded branch: {most_loaded[0]['loading_pct']:.2f}%\")\nEOF\n"]
