[417.461399, "o", "\u001b[?2004h> "]
[417.461493, "o", "            \"pmin_MW\": float(Pmin[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[417.461617, "o", "            \"pmax_MW\": float(Pmax[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h"]
[417.461666, "o", "> "]
[417.461756, "o", "            \"qmin_MVAr\": float(Qmin[i] * baseMVA),\r\n\u001b[?2004l\r"]
[417.4618, "o", "\u001b[?2004h> "]
[417.461892, "o", "            \"qmax_MVAr\": float(Qmax[i] * baseMVA)\r\n\u001b[?2004l\r\u001b[?2004h"]
