[162.795655, "o", "tap[tap == 0] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.795724, "o", "# Build admittance matrix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.795794, "o", "Ybus = np.zeros((n_bus, n_bus), dtype=complex)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.795859, "o", "for i in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.795935, "o", "    if br_status[i] == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r"]
[162.795998, "o", "\u001b[?2004h>     f = fbus[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796064, "o", "    t = tbus[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796127, "o", "    Ys = 1.0 / (R[i] + 1j * X[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.796175, "o", "    Ysh = 1j * B[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
