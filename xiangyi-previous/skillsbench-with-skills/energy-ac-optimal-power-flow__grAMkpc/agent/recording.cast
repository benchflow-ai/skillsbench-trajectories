[442.252022, "o", "bus_type = buses[:, 1].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.252088, "o", "Pd = buses[:, 2] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.252142, "o", "Qd = buses[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.252197, "o", "Gs = buses[:, 4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.25225, "o", "Bs = buses[:, 5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.252292, "o", "Vm = buses[:, 7]  # Use initial voltage magnitude\r\n\u001b[?2004l\r"]
[442.252346, "o", "\u001b[?2004h> "]
[442.252397, "o", "Va = buses[:, 8] * np.pi / 180  # Use initial voltage angle\r\n\u001b[?2004l\r"]
[442.252449, "o", "\u001b[?2004h> "]
[442.252503, "o", "Vmax = buses[:, 11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
