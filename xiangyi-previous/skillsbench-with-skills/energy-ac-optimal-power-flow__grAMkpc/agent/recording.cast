[149.936519, "o", "# Generator data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936581, "o", "gen_bus = gens[:, 0].astype(int) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936638, "o", "Pg_init = gens[:, 1] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.93669, "o", "Qg_init = gens[:, 2] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.936726, "o", "> "]
[149.93676, "o", "Qmax = gens[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.93687, "o", "Qmin = gens[:, 4] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936912, "o", "Vg = gens[:, 5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.936948, "o", "gen_status = gens[:, 7].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937044, "o", "Pmax = gens[:, 8] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> Pmin = gens[:, 9] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.937077, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.93715, "o", "# Generator cost data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937321, "o", "cost_model = gencosts[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> n_cost = gencosts[:, 3].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937376, "o", "cost_coeffs = gencosts[:, 4:]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937415, "o", "c2 = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937513, "o", "c1 = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h> c0 = np.zeros(n_gen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.937548, "o", "for i in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.937579, "o", "> "]
[149.93766, "o", "    if cost_model[i] == 2:\r\n\u001b[?2004l\r\u001b[?2004h>         if n_cost[i] == 3:\r\n\u001b[?2004l\r"]
[149.937699, "o", "\u001b[?2004h> "]
[149.937777, "o", "            c2[i] = cost_coeffs[i, 0] * baseMVA * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
