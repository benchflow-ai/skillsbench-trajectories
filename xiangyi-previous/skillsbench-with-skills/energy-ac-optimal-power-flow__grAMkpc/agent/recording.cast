[173.978475, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[186.285939, "i", "cat >> solve_acopf.py << 'EOF'\n\ndef constraints_ineq(x):\n    Va, Vm, Pg, Qg = unpack_vars(x)\n    constraints = []\n    \n    for i in range(n_gen):\n        if gen_status[i]:\n            constraints.append(Pmin[i] - Pg[i])\n            constraints.append(Pg[i] - Pmax[i])\n            constraints.append(Qmin[i] - Qg[i])\n            constraints.append(Qg[i] - Qmax[i])\n    \n    for i in range(n_bus):\n        constraints.append(Vmin[i] - Vm[i])\n        constraints.append(Vm[i] - Vmax[i])\n    \n    V = Vm * np.exp(1j * Va)\n    for i in range(n_branch):\n        if br_status[i] == 0 or rate_a[i] == 0:\n            continue\n        \n        f = fbus[i]\n        t = tbus[i]\n        Ys = 1.0 / (R[i] + 1j * X[i])\n        Ysh = 1j * B[i]\n        tr = tap[i] * np.exp(1j * shift[i])\n        \n        Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n        St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n        \n        constraints.append(np.abs(Sf) - rate_a[i])\n        constraints.append(np.abs(St) - rate_a[i])\n    \n    for i in range(n_branch):\n        if br_status[i] == 0:\n            continue\n        f = fbus[i]\n        t = tbus[i]\n        ang_diff = Va[f] - Va[t]\n        constraints.append(ang_min[i] - ang_diff)\n        constraints.append(ang_diff - ang_max[i])\n    \n    return np.array(constraints)\nEOF\n"]
[186.286259, "o", "cat >> solve_acopf.py << 'EOF'\r\n\u001b[?2004l\r"]
[186.286352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def constraints_ineq(x):\r\n\u001b[?2004l\r"]
[186.286458, "o", "\u001b[?2004h>     Va, Vm, Pg, Qg = unpack_vars(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.286538, "o", "    constraints = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(n_gen):\r\n\u001b[?2004l\r"]
[186.286619, "o", "\u001b[?2004h>         if gen_status[i]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.2867, "o", "> "]
[186.286769, "o", "            constraints.append(Pmin[i] - Pg[i])\r\n\u001b[?2004l\r\u001b[?2004h>             constraints.append(Pg[i] - Pmax[i])\r\n\u001b[?2004l\r"]
[186.286845, "o", "\u001b[?2004h> "]
[186.286927, "o", "            constraints.append(Qmin[i] - Qg[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287014, "o", "            constraints.append(Qg[i] - Qmax[i])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287095, "o", "    for i in range(n_bus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287141, "o", "        constraints.append(Vmin[i] - Vm[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.287247, "o", "> "]
[186.287318, "o", "        constraints.append(Vm[i] - Vmax[i])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.287389, "o", "> "]
[186.287474, "o", "    for i in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h>         if br_status[i] == 0 or rate_a[i] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287518, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.28756, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287694, "o", "        f = fbus[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.287765, "o", ">         t = tbus[i]\r\n\u001b[?2004l\r\u001b[?2004h>         Ys = 1.0 / (R[i] + 1j * X[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287859, "o", "        Ysh = 1j * B[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.287928, "o", "        tr = tap[i] * np.exp(1j * shift[i])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.28813, "o", "        Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288268, "o", "        St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[186.288357, "o", "\u001b[?2004h> "]
[186.288408, "o", "        constraints.append(np.abs(Sf) - rate_a[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288501, "o", "        constraints.append(np.abs(St) - rate_a[i])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288566, "o", "    for i in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288635, "o", "        if br_status[i] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288697, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.288761, "o", "        f = fbus[i]\r\n\u001b[?2004l\r\u001b[?2004h>         t = tbus[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.288823, "o", ">         ang_diff = Va[f] - Va[t]\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.288886, "o", "> "]
[186.28895, "o", "        constraints.append(ang_min[i] - ang_diff)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.289023, "o", "        constraints.append(ang_diff - ang_max[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.289087, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.28915, "o", "    return np.array(constraints)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[186.290165, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[198.146057, "i", "cat >> solve_acopf.py << 'EOF'\n\n# Initial point\nx0 = pack_vars(Va_init, Vm_init, Pg_init, Qg_init)\n\nprint(\"\\nSolving AC-OPF...\")\nprint(f\"Initial objective: ${objective(x0):.2f}/hr\")\n\n# Set up constraints\ncons_eq = {'type': 'eq', 'fun': constraints_eq}\ncons_ineq = {'type': 'ineq', 'fun': lambda x: -constraints_ineq(x)}\n\n# Bounds\nbounds = []\nfor i in range(n_bus):\n    bounds.append((-np.pi, np.pi))\nfor i in range(n_bus):\n    bounds.append((Vmin[i], Vmax[i]))\nfor i in range(n_gen):\n    if gen_status[i]:\n        bounds.append((Pmin[i], Pmax[i]))\n    else:\n        bounds.append((0, 0))\nfor i in range(n_gen):\n    if gen_status[i]:\n        bounds.append((Qmin[i], Qmax[i]))\n    else:\n        bounds.append((0, 0))\n\n# Solve\nresult = minimize(\n    objective,\n    x0,\n    method='SLSQP',\n    bounds=bounds,\n    constraints=[cons_eq, cons_ineq],\n    options={'maxiter': 1000, 'ftol': 1e-6, 'disp': True}\n)\n\nprint(f\"\\nOptimization: {result.message}\")\nprint(f\"Success: {result.success}\")\nprint(f\"Final objective: ${result.fun:.2f}/hr\")\n\nVa_sol, Vm_sol, Pg_sol, Qg_sol = unpack_vars(result.x)\nVa_deg = Va_sol * 180 / np.pi\n\nP_mis, Q_mis = power_flow_mismatch(Va_sol, Vm_sol, Pg_sol, Qg_sol)\nprint(f\"Max P mismatch: {np.max(np.abs(P_mis))*baseMVA:.6f} MW\")\nprint(f\"Max Q mismatch: {np.max(np.abs(Q_mis))*baseMVA:.6f} MVAr\")\nEOF\n"]
