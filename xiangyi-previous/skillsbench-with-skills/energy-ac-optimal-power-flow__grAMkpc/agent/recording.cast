[417.460089, "o", "> "]
[417.46019, "o", "        \"max_q_mismatch_MVAr\": float(max_q_mismatch),\r\n\u001b[?2004l\r\u001b[?2004h"]
[417.460235, "o", "> "]
[417.460337, "o", "        \"max_voltage_violation_pu\": float(max_v_violation),\r\n\u001b[?2004l\r\u001b[?2004h"]
[417.460384, "o", "> "]
[417.460492, "o", "        \"max_branch_overload_MVA\": float(max_branch_overload)\r\n\u001b[?2004l\r"]
[417.460518, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[417.460564, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
