[211.908829, "o", "    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V_sol[f] * np.conj(V_sol[f]) - (Ys / np.conj(tr)) * V_sol[f] * np.conj(V_sol[t])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.909003, "o", "    St = (Ys + Ysh/2) * V_sol[t] * np.conj(V_sol[t]) - (Ys / tr) * V_sol[t] * np.conj(V_sol[f])\r\n\u001b[?2004l\r\u001b[?2004h> "]
