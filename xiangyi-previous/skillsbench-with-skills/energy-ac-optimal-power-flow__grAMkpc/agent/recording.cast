[442.250606, "i", "cat > solve_final.py << 'EOF'\nimport json\nimport numpy as np\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbuses = np.array(data['bus'])\ngens = np.array(data['gen'])\nbranches = np.array(data['branch'])\ngencosts = np.array(data['gencost'])\n\nn_bus = len(buses)\nn_gen = len(gens)\nn_branch = len(branches)\n\nprint(f\"Network: {n_bus} buses, {n_gen} generators, {n_branch} branches\")\n\n# Parse bus data - use initial values from file\nbus_id = buses[:, 0].astype(int)\nbus_type = buses[:, 1].astype(int)\nPd = buses[:, 2] / baseMVA\nQd = buses[:, 3] / baseMVA\nGs = buses[:, 4]\nBs = buses[:, 5]\nVm = buses[:, 7]  # Use initial voltage magnitude\nVa = buses[:, 8] * np.pi / 180  # Use initial voltage angle\nVmax = buses[:, 11]\nVmin = buses[:, 12]\n\n# Parse generator data - use initial dispatch\ngen_bus = gens[:, 0].astype(int) - 1\nPg = gens[:, 1] / baseMVA  # Use initial Pg\nQg = gens[:, 2] / baseMVA  # Use initial Qg\nQmax = gens[:, 3] / baseMVA\nQmin = gens[:, 4] / baseMVA\ngen_status = gens[:, 7].astype(int)\nPmax = gens[:, 8] / baseMVA\nPmin = gens[:, 9] / baseMVA\n\nprint(f\"Total generation: {np.sum(Pg[gen_status==1])*baseMVA:.2f} MW\")\nprint(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW\")\nEOF\n"]
[442.250812, "o", "cat > solve_final.py << 'EOF'\r\n\u001b[?2004l\r"]
