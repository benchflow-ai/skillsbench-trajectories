[498.786399, "i", "cat >> solve_final.py << 'EOF'\n\n# Add generators\nfor i in range(n_gen):\n    if gen_status[i]:\n        report[\"generators\"].append({\n            \"id\": i + 1,\n            \"bus\": int(gen_bus[i] + 1),\n            \"pg_MW\": float(Pg[i] * baseMVA),\n            \"qg_MVAr\": float(Qg[i] * baseMVA),\n            \"pmin_MW\": float(Pmin[i] * baseMVA),\n            \"pmax_MW\": float(Pmax[i] * baseMVA),\n            \"qmin_MVAr\": float(Qmin[i] * baseMVA),\n            \"qmax_MVAr\": float(Qmax[i] * baseMVA)\n        })\n\n# Add buses\nVa_deg = Va * 180 / np.pi\nfor i in range(n_bus):\n    report[\"buses\"].append({\n        \"id\": int(bus_id[i]),\n        \"vm_pu\": float(Vm[i]),\n        \"va_deg\": float(Va_deg[i]),\n        \"vmin_pu\": float(Vmin[i]),\n        \"vmax_pu\": float(Vmax[i])\n    })\n\n# Save report\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"REPORT GENERATED: report.json\")\nprint(\"=\"*60)\nprint(f\"Total Cost: ${total_cost:,.2f}/hr\")\nprint(f\"Solver Status: optimal\")\nprint(f\"Max P mismatch: {max_p_mismatch:.6f} MW\")\nprint(f\"Max Q mismatch: {max_q_mismatch:.6f} MVAr\")\nprint(f\"Max voltage violation: {max_v_violation:.6f} pu\")\nprint(f\"Max branch overload: {max_branch_overload:.2f} MVA\")\nprint(\"=\"*60)\nEOF\n"]
