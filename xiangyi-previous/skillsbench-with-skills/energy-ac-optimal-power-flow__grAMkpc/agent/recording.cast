[516.037018, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\n\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\ngens = np.array(data['gen'])\nprint(\"Generator initial values (first 10):\")\nprint(\"Pg (MW):\", gens[:10, 1])\nprint(\"Pmin (MW):\", gens[:10, 9])\nprint(\"Pmax (MW):\", gens[:10, 8])\nprint(\"Status:\", gens[:10, 7])\n\ngen_status = gens[:, 7].astype(int)\nprint(f\"\\nActive generators: {np.sum(gen_status)}\")\nprint(f\"Total Pmax: {np.sum(gens[gen_status==1, 8]):.2f} MW\")\nprint(f\"Total Pmin: {np.sum(gens[gen_status==1, 9]):.2f} MW\")\nprint(f\"Total initial Pg: {np.sum(gens[gen_status==1, 1]):.2f} MW\")\nEOF\n"]
