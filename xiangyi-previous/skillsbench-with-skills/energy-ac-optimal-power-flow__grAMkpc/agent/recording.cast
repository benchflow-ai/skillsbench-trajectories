[235.294597, "i", "cat >> solve_acopf.py << 'EOF'\n\n# Add generator data\nfor i in range(n_gen):\n    if gen_status[i]:\n        report[\"generators\"].append({\n            \"id\": i + 1,\n            \"bus\": int(gen_bus[i] + 1),\n            \"pg_MW\": float(Pg_sol[i] * baseMVA),\n            \"qg_MVAr\": float(Qg_sol[i] * baseMVA),\n            \"pmin_MW\": float(Pmin[i] * baseMVA),\n            \"pmax_MW\": float(Pmax[i] * baseMVA),\n            \"qmin_MVAr\": float(Qmin[i] * baseMVA),\n            \"qmax_MVAr\": float(Qmax[i] * baseMVA)\n        })\n\n# Add bus data\nfor i in range(n_bus):\n    report[\"buses\"].append({\n        \"id\": int(bus_id[i]),\n        \"vm_pu\": float(Vm_sol[i]),\n        \"va_deg\": float(Va_deg[i]),\n        \"vmin_pu\": float(Vmin[i]),\n        \"vmax_pu\": float(Vmax[i])\n    })\n\n# Save report\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"REPORT GENERATED: report.json\")\nprint(\"=\"*60)\nprint(f\"Total Cost: ${result.fun:,.2f}/hr\")\nprint(f\"Total Generation: {total_gen_P:.2f} MW, {total_gen_Q:.2f} MVAr\")\nprint(f\"Total Load: {total_load_P:.2f} MW, {total_load_Q:.2f} MVAr\")\nprint(f\"Total Losses: {total_losses:.2f} MW\")\nprint(f\"Solver Status: {report['summary']['solver_status']}\")\nprint(\"=\"*60)\nEOF\n"]
