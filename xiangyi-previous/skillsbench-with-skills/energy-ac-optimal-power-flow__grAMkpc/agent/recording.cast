[364.976441, "o", "\u001b[?2004h> "]
[364.976479, "o", "X = branches[:, 3]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.976501, "o", "> "]
[364.976686, "o", "B = branches[:, 4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.97673, "o", "> "]
[364.976804, "o", "rate_a = branches[:, 5] / baseMVA\r\n\u001b[?2004l\r"]
[364.976849, "o", "\u001b[?2004h> "]
[364.976916, "o", "tap = branches[:, 7]\r\n\u001b[?2004l\r"]
[364.976962, "o", "\u001b[?2004h"]
[364.976987, "o", "> "]
