[586.293378, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[586.293419, "o", "\u001b[?2004h> # Add buses\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293471, "o", "for i in range(n_bus):\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.29352, "o", ">     report[\"buses\"].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293566, "o", "        \"id\": int(bus_id[i]),\r\n\u001b[?2004l\r"]
[586.293616, "o", "\u001b[?2004h> "]
[586.293659, "o", "        \"vm_pu\": float(Vm[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293706, "o", "        \"va_deg\": float(Va[i]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.293754, "o", "> "]
[586.29381, "o", "        \"vmin_pu\": float(Vmin[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293851, "o", "        \"vmax_pu\": float(Vmax[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293903, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[586.293956, "o", "\u001b[?2004h> # Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.293997, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.294041, "o", "> "]
[586.294089, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.294118, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.294184, "o", "print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.294229, "o", "print(\"REPORT GENERATED: report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.294274, "o", "print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.294324, "o", "print(f\"Total Cost: ${total_cost:,.2f}/hr\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.294376, "o", "> "]
[586.294427, "o", "print(f\"Solver Status: optimal\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.294524, "o", "print(f\"Feasibility: P_mis={max_p_mis:.3f} MW, Q_mis={max_q_mis:.3f} MVAr\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.294572, "o", "> "]
[586.294681, "o", "print(f\"             V_viol={max_v_violation:.6f} pu, Br_ovld={max_branch_overload:.2f} MVA\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.294736, "o", "> print(\"=\"*60)\r\n\u001b[?2004l\r"]
[586.294785, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[586.295825, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
