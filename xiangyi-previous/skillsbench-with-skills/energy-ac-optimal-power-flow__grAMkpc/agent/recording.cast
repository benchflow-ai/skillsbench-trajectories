[417.458571, "o", "    \"summary\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[417.458678, "o", "        \"total_cost_per_hour\": float(total_cost),\r\n\u001b[?2004l\r"]
[417.458733, "o", "\u001b[?2004h> "]
[417.458798, "o", "        \"total_load_MW\": float(total_load_P),\r\n\u001b[?2004l\r"]
