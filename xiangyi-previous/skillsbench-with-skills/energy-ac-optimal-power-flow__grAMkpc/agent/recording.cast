[553.563303, "o", "\u001b[?2004h> "]
[553.563347, "o", "    Ybus[t, t] += Ys + Ysh/2\r\n\u001b[?2004l\r"]
[553.563395, "o", "\u001b[?2004h> "]
[553.563479, "o", "    Ybus[f, t] += -Ys / np.conj(tr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.563531, "o", "> "]
[553.563571, "o", "    Ybus[t, f] += -Ys / tr\r\n\u001b[?2004l\r"]
[553.563595, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.563639, "o", "\u001b[?2004h> "]
[553.563688, "o", "for i in range(n_bus):\r\n\u001b[?2004l\r"]
[553.563733, "o", "\u001b[?2004h> "]
[553.563802, "o", "    Ybus[i, i] += Gs[i] + 1j * Bs[i]\r\n\u001b[?2004l\r"]
[553.563853, "o", "\u001b[?2004h> "]
