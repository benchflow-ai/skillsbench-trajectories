[417.45974, "o", "\u001b[?2004h> "]
[417.459803, "o", "    \"most_loaded_branches\": most_loaded,\r\n\u001b[?2004l\r"]
[417.459847, "o", "\u001b[?2004h> "]
[417.459888, "o", "    \"feasibility_check\": {\r\n\u001b[?2004l\r"]
[417.45994, "o", "\u001b[?2004h> "]
