[173.976756, "o", "\u001b[?2004h> "]
[173.97679, "o", "def constraints_eq(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.976866, "o", "    Va, Vm, Pg, Qg = unpack_vars(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.97698, "o", "    P_mis, Q_mis = power_flow_mismatch(Va, Vm, Pg, Qg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
