[173.975953, "o", "\u001b[?2004h>     P_calc = S_calc.real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.976013, "o", "    Q_calc = S_calc.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
