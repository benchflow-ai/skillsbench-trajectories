[417.459008, "o", "        \"total_load_MVAr\": float(total_load_Q),\r\n\u001b[?2004l\r"]
[417.459056, "o", "\u001b[?2004h> "]
[417.459145, "o", "        \"total_generation_MW\": float(total_gen_P),\r\n\u001b[?2004l\r"]
[417.459201, "o", "\u001b[?2004h> "]
[417.459291, "o", "        \"total_generation_MVAr\": float(total_gen_Q),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[417.459416, "o", "        \"total_losses_MW\": float(total_losses),\r\n\u001b[?2004l\r\u001b[?2004h"]
[417.459466, "o", "> "]
[417.459513, "o", "        \"solver_status\": \"optimal\"\r\n\u001b[?2004l\r"]
[417.459564, "o", "\u001b[?2004h> "]
[417.4596, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
