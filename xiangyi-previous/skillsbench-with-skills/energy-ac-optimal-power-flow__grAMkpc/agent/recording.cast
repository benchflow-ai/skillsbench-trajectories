[402.187656, "o", "    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[402.187779, "o", "    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\r\n\u001b[?2004l\r"]
[402.18784, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[402.187868, "o", ">     Sf_MVA = np.abs(Sf) * baseMVA\r\n\u001b[?2004l\r"]
