[442.252878, "o", "Qmax = gens[:, 3] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h"]
[442.252932, "o", "> "]
[442.252982, "o", "Qmin = gens[:, 4] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.253031, "o", "gen_status = gens[:, 7].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.253081, "o", "Pmax = gens[:, 8] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.253138, "o", "Pmin = gens[:, 9] / baseMVA\r\n\u001b[?2004l\r"]
[442.253182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.253278, "o", "print(f\"Total generation: {np.sum(Pg[gen_status==1])*baseMVA:.2f} MW\")\r\n\u001b[?2004l\r"]
[442.253329, "o", "\u001b[?2004h> "]
[442.253369, "o", "print(f\"Total load: {np.sum(Pd)*baseMVA:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[442.25342, "o", "> EOF\r\n\u001b[?2004l\r"]
[442.254565, "o", "\u001b[?2004hroot@c48bdcf5829b:~# "]
[458.158257, "i", "cat >> solve_final.py << 'EOF'\n\n# Parse cost data\ncost_model = gencosts[:, 0].astype(int)\nn_cost = gencosts[:, 3].astype(int)\ncost_coeffs = gencosts[:, 4:]\n\nc2 = np.zeros(n_gen)\nc1 = np.zeros(n_gen)\nc0 = np.zeros(n_gen)\nfor i in range(n_gen):\n    if cost_model[i] == 2:\n        if n_cost[i] == 3:\n            c2[i] = cost_coeffs[i, 0] * baseMVA * baseMVA\n            c1[i] = cost_coeffs[i, 1] * baseMVA\n            c0[i] = cost_coeffs[i, 2]\n        elif n_cost[i] == 2:\n            c1[i] = cost_coeffs[i, 0] * baseMVA\n            c0[i] = cost_coeffs[i, 1]\n\n# Calculate total cost\nPg_MW = Pg * baseMVA\ntotal_cost = np.sum(c2 * Pg_MW**2 + c1 * Pg_MW + c0)\nprint(f\"Total cost: ${total_cost:,.2f}/hr\")\n\n# Parse branch data\nfbus = branches[:, 0].astype(int) - 1\ntbus = branches[:, 1].astype(int) - 1\nR = branches[:, 2]\nX = branches[:, 3]\nB = branches[:, 4]\nrate_a = branches[:, 5] / baseMVA\ntap = branches[:, 7]\nshift = branches[:, 8] * np.pi / 180\nbr_status = branches[:, 10].astype(int)\n\ntap[tap == 0] = 1.0\n\n# Build Ybus\nYbus = np.zeros((n_bus, n_bus), dtype=complex)\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\n    Ybus[t, t] += Ys + Ysh/2\n    Ybus[f, t] += -Ys / np.conj(tr)\n    Ybus[t, f] += -Ys / tr\n\nfor i in range(n_bus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\nprint(\"Calculating power flows...\")\nEOF\n"]
