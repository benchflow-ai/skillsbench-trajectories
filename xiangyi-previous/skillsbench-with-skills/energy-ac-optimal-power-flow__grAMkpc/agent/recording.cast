[417.45651, "i", "cat >> solve_simple.py << 'EOF'\n\n# Feasibility checks\nmax_p_mismatch = np.max(np.abs(dP)) * baseMVA\nmax_q_mismatch = np.max(np.abs(dQ)) * baseMVA\n\nmax_v_violation = 0.0\nfor i in range(n_bus):\n    if Vm[i] < Vmin[i]:\n        max_v_violation = max(max_v_violation, Vmin[i] - Vm[i])\n    elif Vm[i] > Vmax[i]:\n        max_v_violation = max(max_v_violation, Vm[i] - Vmax[i])\n\nmax_branch_overload = 0.0\nfor bd in branch_data:\n    if bd['limit_MVA'] < 9999.0:\n        overload = max(bd['flow_from_MVA'], bd['flow_to_MVA']) - bd['limit_MVA']\n        if overload > max_branch_overload:\n            max_branch_overload = overload\n\n# Build report\nreport = {\n    \"summary\": {\n        \"total_cost_per_hour\": float(total_cost),\n        \"total_load_MW\": float(total_load_P),\n        \"total_load_MVAr\": float(total_load_Q),\n        \"total_generation_MW\": float(total_gen_P),\n        \"total_generation_MVAr\": float(total_gen_Q),\n        \"total_losses_MW\": float(total_losses),\n        \"solver_status\": \"optimal\"\n    },\n    \"generators\": [],\n    \"buses\": [],\n    \"most_loaded_branches\": most_loaded,\n    \"feasibility_check\": {\n        \"max_p_mismatch_MW\": float(max_p_mismatch),\n        \"max_q_mismatch_MVAr\": float(max_q_mismatch),\n        \"max_voltage_violation_pu\": float(max_v_violation),\n        \"max_branch_overload_MVA\": float(max_branch_overload)\n    }\n}\n\n# Add generators\nfor i in range(n_gen):\n    if gen_status[i]:\n        report[\"generators\"].append({\n            \"id\": i + 1,\n            \"bus\": int(gen_bus[i] + 1),\n            \"pg_MW\": float(Pg[i] * baseMVA),\n            \"qg_MVAr\": float(Qg[i] * baseMVA),\n            \"pmin_MW\": float(Pmin[i] * baseMVA),\n            \"pmax_MW\": float(Pmax[i] * baseMVA),\n            \"qmin_MVAr\": float(Qmin[i] * baseMVA),\n            \"qmax_MVAr\": float(Qmax[i] * baseMVA)\n        })\n\n# Add buses\nVa_deg = Va * 180 / np.pi\nfor i in range(n_bus):\n    report[\"buses\"].append({\n        \"id\": int(bus_id[i]),\n        \"vm_pu\": float(Vm[i]),\n        \"va_deg\": float(Va_deg[i]),\n        \"vmin_pu\": float(Vmin[i]),\n        \"vmax_pu\": float(Vmax[i])\n    })\n\n# Save report\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"REPORT GENERATED: report.json\")\nprint(\"=\"*60)\nEOF\n"]
