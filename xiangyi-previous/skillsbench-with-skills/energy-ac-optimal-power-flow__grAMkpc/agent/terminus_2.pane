[?2004l[?2004h> 
[?2004l[?2004h> # Sort generators by marginal cost
[?2004l[?2004h> gen_order = np.argsort(marginal_cost)
[?2004l[?2004h> 
[?2004l[?2004h> # Dispatch generators to meet load + 5% for losses
[?2004l[?2004h> target_gen = total_load * 1.05
[?2004l[?2004h> remaining = target_gen
[?2004l[?2004h> 
[?2004l[?2004h> for i in gen_order:
[?2004l[?2004h>     if gen_status[i] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if remaining <= 0:
