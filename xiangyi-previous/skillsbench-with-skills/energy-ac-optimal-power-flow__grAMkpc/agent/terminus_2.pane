[?2004l[?2004h>     elif remaining >= Pmax[i]:
[?2004l[?2004h>         Pg[i] = Pmax[i]
[?2004l[?2004h>         remaining -= Pmax[i]
[?2004l[?2004h>     else:
[?2004l[?2004h>         Pg[i] = remaining
[?2004l[?2004h>         remaining = 0
[?2004l[?2004h> 
