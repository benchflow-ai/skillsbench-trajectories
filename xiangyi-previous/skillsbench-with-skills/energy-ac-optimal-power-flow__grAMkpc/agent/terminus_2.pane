[?2004l[?2004h>         P_inj[gen_bus[i]] += Pg_pu[i]
[?2004l[?2004h>         Q_inj[gen_bus[i]] += Qg_pu[i]
[?2004l[?2004h> 
[?2004l[?2004h> dP = P_inj - Pd_pu - P_calc
[?2004l[?2004h> dQ = Q_inj - Qd_pu - Q_calc
[?2004l[?2004h> 
[?2004l[?2004h> max_p_mis = np.max(np.abs(dP)) * baseMVA
[?2004l[?2004h> max_q_mis = np.max(np.abs(dQ)) * baseMVA
[?2004l[?2004h> print(f"Max P mismatch: {max_p_mis:.6f} MW")
[?2004l[?2004h> print(f"Max Q mismatch: {max_q_mis:.6f} MVAr")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@c48bdcf5829b:~# cat >> solve_ed.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate cost
[?2004l[?2004h> total_cost = np.sum(c2 * Pg**2 + c1 * Pg + c0)
[?2004l[?2004h> print(f"\nTotal cost: ${total_cost:,.2f}/hr")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate totals
[?2004l[?2004h> total_gen_P = np.sum(Pg[gen_status == 1])
[?2004l[?2004h> total_gen_Q = np.sum(Qg[gen_status == 1])
[?2004l[?2004h> total_load_P = np.sum(Pd)
[?2004l[?2004h> total_load_Q = np.sum(Qd)
[?2004l[?2004h> total_losses = total_gen_P - total_load_P
[?2004l[?2004h> 
