[?2004l[?2004h>             c0[i] = cost_coeffs[i, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Economic dispatch - merit order by marginal cost at mid-point
[?2004l[?2004h> Pg = np.zeros(n_gen)
[?2004l[?2004h> marginal_cost = np.zeros(n_gen)
[?2004l[?2004h> 
