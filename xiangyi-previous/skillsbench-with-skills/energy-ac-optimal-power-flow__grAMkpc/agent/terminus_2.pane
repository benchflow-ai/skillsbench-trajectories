[?2004l[?2004h> tbus = branches[:, 1].astype(int) - 1
[?2004l[?2004h> R = branches[:, 2]
[?2004l[?2004h> X = branches[:, 3]
[?2004l[?2004h> B = branches[:, 4]
[?2004l[?2004h> rate_a = branches[:, 5]
[?2004l[?2004h> tap = branches[:, 7]
[?2004l[?2004h> shift = branches[:, 8] * np.pi / 180
[?2004l[?2004h> br_status = branches[:, 10].astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> tap[tap == 0] = 1.0
[?2004l[?2004h> 
[?2004l[?2004h> # Build Ybus
[?2004l[?2004h> print("Building admittance matrix...")
[?2004l[?2004h> Ybus = np.zeros((n_bus, n_bus), dtype=complex)
[?2004l[?2004h> for i in range(n_branch):
[?2004l[?2004h>     if br_status[i] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     f = fbus[i]
[?2004l[?2004h>     t = tbus[i]
[?2004l[?2004h>     Ys = 1.0 / (R[i] + 1j * X[i])
[?2004l[?2004h>     Ysh = 1j * B[i]
[?2004l[?2004h>     tr = tap[i] * np.exp(1j * shift[i])
[?2004l[?2004h>     Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))
[?2004l[?2004h>     Ybus[t, t] += Ys + Ysh/2
[?2004l[?2004h>     Ybus[f, t] += -Ys / np.conj(tr)
[?2004l[?2004h>     Ybus[t, f] += -Ys / tr
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(n_bus):
[?2004l[?2004h>     Ybus[i, i] += Gs[i] + 1j * Bs[i]
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to per-unit
[?2004l[?2004h> Pd_pu = Pd / baseMVA
[?2004l[?2004h> Qd_pu = Qd / baseMVA
[?2004l[?2004h> Pg_pu = Pg / baseMVA
[?2004l[?2004h> Qg_pu = Qg / baseMVA
[?2004l[?2004h> Va_rad = Va * np.pi / 180
[?2004l[?2004h> 
[?2004l[?2004h> print("Calculating power flows...")
[?2004l[?2004h> V = Vm * np.exp(1j * Va_rad)
