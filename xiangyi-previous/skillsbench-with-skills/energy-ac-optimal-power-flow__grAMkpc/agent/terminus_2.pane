[?2004l[?2004h> 
[?2004l[?2004h> for i in range(n_branch):
[?2004l[?2004h>     if br_status[i] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     f = fbus[i]
[?2004l[?2004h>     t = tbus[i]
[?2004l[?2004h>     Ys = 1.0 / (R[i] + 1j * X[i])
[?2004l[?2004h>     Ysh = 1j * B[i]
[?2004l[?2004h>     tr = tap[i] * np.exp(1j * shift[i])
[?2004l[?2004h>     
[?2004l[?2004h>     Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])
[?2004l[?2004h>     St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])
[?2004l[?2004h>     
[?2004l[?2004h>     Sf_MVA = np.abs(Sf) * baseMVA
[?2004l[?2004h>     St_MVA = np.abs(St) * baseMVA
[?2004l[?2004h>     limit_MVA = rate_a[i] if rate_a[i] > 0 else 9999.0
[?2004l[?2004h>     
[?2004l[?2004h>     loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 and limit_MVA < 9999 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     branch_data.append({
[?2004l[?2004h>         'from_bus': int(fbus[i] + 1),
[?2004l[?2004h>         'to_bus': int(tbus[i] + 1),
[?2004l[?2004h>         'loading_pct': float(loading_pct),
