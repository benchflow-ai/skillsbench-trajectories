[?2004l[?2004h>         # Assume power factor of 0.95
[?2004l[?2004h>         Qg[i] = Pg[i] * 0.33  # tan(acos(0.95))
[?2004l[?2004h>         Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])
[?2004l[?2004h> 
[?2004l[?2004h> # Parse branch data
