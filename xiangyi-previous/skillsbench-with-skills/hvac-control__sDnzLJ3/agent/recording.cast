[43.075228, "i", "cat <<EOF > tune.py\nimport json\n\ndef tune():\n    with open('estimated_params.json', 'r') as f:\n        params = json.load(f)\n    \n    K = params['K']\n    tau = params['tau']\n    \n    # Lambda tuning for PI controller\n    # Desired closed-loop time constant\n    cl_tau = 15.0 # We want settling time < 120s. 4 * cl_tau approx settling time.\n    \n    Kp = tau / (K * cl_tau)\n    Ki = 1.0 / (K * cl_tau)\n    Kd = 0.0\n    \n    gains = {\n        \"Kp\": float(Kp),\n        \"Ki\": float(Ki),\n        \"Kd\": float(Kd),\n        \"lambda\": float(cl_tau)\n    }\n    \n    with open('tuned_gains.json', 'w') as f:\n        json.dump(gains, f, indent=2)\n    print(f\"Tuning complete: Kp={Kp:.4f}, Ki={Ki:.4f}, Kd={Kd:.4f}\")\n\nif __name__ == \"__main__\":\n    tune()\nEOF\n"]
