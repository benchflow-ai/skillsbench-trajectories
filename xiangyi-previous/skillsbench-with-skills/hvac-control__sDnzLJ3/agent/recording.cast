[29.968908, "o", "    \r\n\u001b[?2004l\r"]
[29.968955, "o", "\u001b[?2004h> "]
[29.969025, "o", "    # Calculate fitting error\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.969078, "o", "> "]
[29.969125, "o", "    predictions = model.predict(X)\r\n\u001b[?2004l\r"]
[29.969175, "o", "\u001b[?2004h> "]
[29.969296, "o", "    fitting_error = np.sqrt(np.mean((y - predictions)**2))\r\n\u001b[?2004l\r"]
[29.969341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.969394, "o", "\u001b[?2004h> "]
[29.969439, "o", "    params = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.969477, "o", "        \"K\": float(K),\r\n\u001b[?2004l\r"]
[29.969529, "o", "\u001b[?2004h> "]
[29.96957, "o", "        \"tau\": float(tau),\r\n\u001b[?2004l\r"]
[29.969622, "o", "\u001b[?2004h> "]
[29.9697, "o", "        \"r_squared\": float(r_squared),\r\n\u001b[?2004l\r"]
[29.969749, "o", "\u001b[?2004h> "]
[29.969837, "o", "        \"fitting_error\": float(fitting_error)\r\n\u001b[?2004l\r"]
[29.969882, "o", "\u001b[?2004h>     }\r\n"]
[29.969936, "o", "\u001b[?2004l\r\u001b[?2004h"]
[29.96998, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.97008, "o", "    with open('estimated_params.json', 'w') as f:\r\n\u001b[?2004l\r"]
[29.970135, "o", "\u001b[?2004h"]
[29.970179, "o", "> "]
[29.970217, "o", "        json.dump(params, f, indent=2)\r\n\u001b[?2004l\r"]
