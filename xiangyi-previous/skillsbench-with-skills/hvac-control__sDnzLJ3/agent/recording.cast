[30.900877, "o", "\u001b[?2004hroot@c87159641bfb:~# "]
[36.597492, "i", "cat <<EOF > estimate.py\nimport json\nimport numpy as np\n\ndef estimate():\n    with open('calibration_log.json', 'r') as f:\n        cal_data = json.load(f)\n    \n    data = cal_data['data']\n    u = cal_data['heater_power_test']\n    T_ambient = 18.0\n    \n    X = []\n    y = []\n    \n    for i in range(len(data) - 1):\n        T_curr = data[i]['temperature']\n        T_next = data[i+1]['temperature']\n        dt = data[i+1]['time'] - data[i]['time']\n        \n        if dt <= 0: continue\n        X.append(T_curr)\n        y.append(T_next)\n\n    X = np.array(X)\n    y = np.array(y)\n    \n    # T_next = a * T_curr + b\n    a, b = np.polyfit(X, y, 1)\n    \n    # Calculate R-squared\n    y_pred = a * X + b\n    res = y - y_pred\n    ss_res = np.sum(res**2)\n    ss_tot = np.sum((y - np.mean(y))**2)\n    r_squared = 1 - (ss_res / ss_tot)\n    \n    dt = 0.5\n    tau = dt / (1 - a)\n    K = (b / (1 - a) - T_ambient) / u\n    \n    fitting_error = np.sqrt(np.mean(res**2))\n\n    params = {\n        \"K\": float(K),\n        \"tau\": float(tau),\n        \"r_squared\": float(r_squared),\n        \"fitting_error\": float(fitting_error)\n    }\n    \n    with open('estimated_params.json', 'w') as f:\n        json.dump(params, f, indent=2)\n    print(f\"Estimation complete: K={K:.4f}, tau={tau:.4f}, R2={r_squared:.4f}\")\n\nif __name__ == \"__main__\":\n    estimate()\nEOF\n"]
