[53.148027, "i", "cat <<EOF > control.py\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\ndef run_control():\n    sim = HVACSimulator()\n    with open('tuned_gains.json', 'r') as f:\n        gains = json.load(f)\n    \n    Kp = gains['Kp']\n    Ki = gains['Ki']\n    Kd = gains['Kd']\n    \n    setpoint = sim.get_setpoint()\n    dt = sim.get_dt()\n    \n    temp = sim.reset()\n    integral = 0.0\n    prev_error = 0.0\n    \n    data = []\n    \n    duration = 200.0\n    steps = int(duration / dt)\n    \n    for i in range(steps):\n        error = setpoint - temp\n        integral += error * dt\n        derivative = (error - prev_error) / dt\n        \n        # Anti-windup: clamp heater power and adjust integral if necessary\n        power = Kp * error + Ki * integral + Kd * derivative\n        clamped_power = max(0.0, min(100.0, power))\n        \n        # Simple anti-windup: back-calculation or clamping integral\n        if power != clamped_power:\n            integral -= error * dt # undo the integration\n            \n        result = sim.step(clamped_power)\n        temp = result['temperature']\n        prev_error = error\n        \n        data.append({\n            \"time\": result['time'],\n            \"temperature\": result['temperature'],\n            \"setpoint\": setpoint,\n            \"heater_power\": result['heater_power'],\n            \"error\": round(setpoint - result['temperature'], 4)\n        })\n\n    output = {\n        \"phase\": \"control\",\n        \"setpoint\": setpoint,\n        \"data\": data\n    }\n    \n    with open('control_log.json', 'w') as f:\n        json.dump(output, f, indent=2)\n        \n    # Calculate metrics\n    temps = [d['temperature'] for d in data]\n    times = [d['time'] for d in data]\n    \n    # Steady state error: average error in the last 30 seconds\n    ss_data = [d['error'] for d in data if d['time'] > 170]\n    ss_error = abs(np.mean(ss_data))\n    \n    # Max temperature and overshoot\n    max_temp = max(temps)\n    overshoot = max(0, (max_temp - setpoint) / (setpoint - temps[0]))\n    \n    # Settling time: last time error > 0.5C\n    settling_time = 0\n    for d in data:\n        if abs(d['error']) > 0.5:\n            settling_time = d['time']\n    \n    # Rise time: time to first reach 90% of setpoint from 10% of the step\n    initial_temp = temps[0]\n    target_range = setpoint - initial_temp\n    t10 = None\n    t90 = None\n    for d in data:\n        if t10 is None and d['temperature'] >= initial_temp + 0.1 * target_range:\n            t10 = d['time']\n        if t90 is None and d['temperature'] >= initial_temp + 0.9 * target_range:\n            t90 = d['time']\n    rise_time = (t90 - t10) if (t10 is not None and t90 is not None) else 0\n\n    metrics = {\n        \"rise_time\": float(rise_time),\n        \"overshoot\": float(overshoot),\n        \"settling_time\": float(settling_time),\n        \"steady_state_error\": float(ss_error),\n        \"max_temp\": float(max_temp)\n    }\n    \n    with open('metrics.json', 'w') as f:\n        json.dump(metrics, f, indent=2)\n    \n    print(\"Control run complete. Metrics:\")\n    print(json.dumps(metrics, indent=2))\n\nif __name__ == \"__main__\":\n    run_control()\nEOF\n"]
[53.148853, "o", "cat <<EOF > control.py\r\n\u001b[?2004l\r"]
[53.14984, "o", "\u001b[?2004h> "]
[53.149966, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from hvac_simulator import HVACSimulator\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_control():\r\n\u001b[?2004l\r\u001b[?2004h>     sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h>     with open('tuned_gains.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         gains = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     Kp = gains['Kp']\r\n\u001b[?2004l\r\u001b[?2004h>     Ki = gains['Ki']\r\n\u001b[?2004l\r\u001b[?2004h>     Kd = gains['Kd']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     setpoint = sim.get_setpoint()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.151105, "o", "    dt = sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h>     integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     prev_error = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     data = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     duration = 200.0\r\n\u001b[?2004l\r\u001b[?2004h>     steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h>         error = setpoint - temp\r\n\u001b[?2004l\r\u001b[?2004h>         integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h>         derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Anti-windup: clamp heater power and adjust integral if necessary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.151273, "o", "        power = Kp * error + Ki * integral + Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.151308, "o", "        clamped_power = max(0.0, min(100.0, power))\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[53.15143, "o", "\u001b[?2004h> "]
[53.151477, "o", "        # Simple anti-windup: back-calculation or clamping integral\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.151655, "o", "> "]
[53.151725, "o", "        if power != clamped_power:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.151771, "o", "            integral -= error * dt # undo the integration\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.15195, "o", "> "]
[53.151997, "o", "        result = sim.step(clamped_power)\r\n\u001b[?2004l\r\u001b[?2004h>         temp = result['temperature']\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.152034, "o", "> "]
[53.152142, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.152251, "o", "> "]
[53.152305, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"time\": result['time'],\r\n\u001b[?2004l\r"]
[53.152354, "o", "\u001b[?2004h> "]
[53.152512, "o", "            \"temperature\": result['temperature'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.152599, "o", ">             \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.152643, "o", "            \"heater_power\": result['heater_power'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.152733, "o", "            \"error\": round(setpoint - result['temperature'], 4)\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[53.152768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.1528, "o", "\u001b[?2004h> "]
[53.152836, "o", "    output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.152971, "o", "        \"phase\": \"control\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153009, "o", "        \"data\": data\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[53.153094, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153131, "o", "    with open('control_log.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153198, "o", "        json.dump(output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153234, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153301, "o", "    # Calculate metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153384, "o", "    temps = [d['temperature'] for d in data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153447, "o", "    times = [d['time'] for d in data]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[53.153476, "o", "\u001b[?2004h> "]
[53.153578, "o", "    # Steady state error: average error in the last 30 seconds\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.153612, "o", "> "]
[53.15369, "o", "    ss_data = [d['error'] for d in data if d['time'] > 170]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153763, "o", "    ss_error = abs(np.mean(ss_data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.153799, "o", "    \r\n\u001b[?2004l\r"]
[53.153833, "o", "\u001b[?2004h> "]
[53.153936, "o", "    # Max temperature and overshoot\r\n\u001b[?2004l\r\u001b[?2004h>     max_temp = max(temps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.15403, "o", "    overshoot = max(0, (max_temp - setpoint) / (setpoint - temps[0]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154064, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.15414, "o", "    # Settling time: last time error > 0.5C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154208, "o", "    settling_time = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154257, "o", "    for d in data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154333, "o", "        if abs(d['error']) > 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154402, "o", "            settling_time = d['time']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154439, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154555, "o", "    # Rise time: time to first reach 90% of setpoint from 10% of the step\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154609, "o", "    initial_temp = temps[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.154642, "o", "> "]
[53.154714, "o", "    target_range = setpoint - initial_temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154768, "o", "    t10 = None\r\n\u001b[?2004l\r\u001b[?2004h>     t90 = None\r\n\u001b[?2004l\r"]
[53.154805, "o", "\u001b[?2004h> "]
[53.154836, "o", "    for d in data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.154985, "o", "        if t10 is None and d['temperature'] >= initial_temp + 0.1 * target_range:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155059, "o", "            t10 = d['time']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155177, "o", "        if t90 is None and d['temperature'] >= initial_temp + 0.9 * target_range:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155246, "o", "            t90 = d['time']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155353, "o", "    rise_time = (t90 - t10) if (t10 is not None and t90 is not None) else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.15539, "o", "\u001b[?2004h> "]
[53.155467, "o", "    metrics = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.1555, "o", "        \"rise_time\": float(rise_time),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155572, "o", "        \"overshoot\": float(overshoot),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155656, "o", "        \"settling_time\": float(settling_time),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155747, "o", "        \"steady_state_error\": float(ss_error),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155813, "o", "        \"max_temp\": float(max_temp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.155851, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[53.155888, "o", "\u001b[?2004h> "]
[53.155976, "o", "    with open('metrics.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.156028, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[53.156067, "o", "\u001b[?2004h> "]
[53.156131, "o", "    print(\"Control run complete. Metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.156205, "o", "    print(json.dumps(metrics, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.156239, "o", "\u001b[?2004h> "]
[53.156311, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     run_control()\r\n\u001b[?2004l\r"]
[53.156346, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[53.157753, "o", "\u001b[?2004hroot@c87159641bfb:~# "]
[53.606406, "i", "python3 control.py\n"]
[53.606653, "o", "python3 control.py\r\n\u001b[?2004l\r"]
[54.09489, "o", "Control run complete. Metrics:\r\n{\r\n  \"rise_time\": 28.5,\r\n  \"overshoot\": 0.09757203842049099,\r\n  \"settling_time\": 31.0,\r\n  \"steady_state_error\": 0.003033333333333333,\r\n  \"max_temp\": 22.3657\r\n}\r\n"]
[54.112332, "o", "\u001b[?2004hroot@c87159641bfb:~# "]
[58.794798, "i", "ls -l calibration_log.json estimated_params.json tuned_gains.json control_log.json metrics.json\n"]
[58.795144, "o", "ls -l calibration_log.json estimated_params.json tuned_gains.json control_log.json metrics.json\r\n\u001b[?2004l\r"]
[58.796378, "o", "-rw-r--r-- 1 root root 10937 Jan 26 11:20 calibration_log.json\r\n-rw-r--r-- 1 root root 55512 Jan 26 11:20 control_log.json\r\n-rw-r--r-- 1 root root   133 Jan 26 11:20 estimated_params.json\r\n-rw-r--r-- 1 root root   153 Jan 26 11:20 metrics.json\r\n-rw-r--r-- 1 root root    88 Jan 26 11:20 tuned_gains.json\r\n"]
[58.796558, "o", "\u001b[?2004hroot@c87159641bfb:~# "]
