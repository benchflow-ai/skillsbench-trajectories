[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useState, useEffect } from 'react';
[?2004l[?2004h> 
[?2004l[?2004h> const API_URL = '';
[?2004l[?2004h> 
[?2004l[?2004h> interface ResultsBarProps {
[?2004l[?2004h>   page: number;
[?2004l[?2004h>   totalProducts: number;
[?2004l[?2004h>   onPageChange: (page: number) => void;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export default function ResultsBar({ page, totalProducts, onPageChange }: ResultsBarProps) {
[?2004l[?2004h>   const [visible, setVisible] = useState<boolean | null>(null);
[?2004l[?2004h>   const [loading, setLoading] = useState(true);
[?2004l[?2004h>   const perPage = 15;
[?2004l[?2004h>   const totalPages = Math.ceil(totalProducts / perPage) || 1;
[?2004l[?2004h> 
[?2004l[?2004h>   useEffect(() => {
[?2004l[?2004h>     fetch(`${API_URL}/api/results-bar`)
[?2004l[?2004h>       .then(r => r.json())
[?2004l[?2004h>       .then(data => {
[?2004l[?2004h>         setVisible(data.visible);
[?2004l[?2004h>         setLoading(false);
[?2004l[?2004h>       })
[?2004l[?2004h>       .catch(() => setLoading(false));
[?2004l[?2004h>   }, []);
[?2004l[?2004h> 
[?2004l[?2004h>   if (!loading && (!visible || totalProducts === 0)) return null;
[?2004l[?2004h> 
[?2004l[?2004h>   const start = (page - 1) * perPage + 1;
[?2004l[?2004h>   const end = Math.min(page * perPage, totalProducts);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div
[?2004l[?2004h>       data-testid="results-bar"
[?2004l[?2004h>       className="flex justify-between items-center bg-[var(--card-bg)] py-4 px-5 mb-5 rounded-lg text-sm"
[?2004l[?2004h>     >
[?2004l[?2004h>       {loading || totalProducts === 0 ? (
[?2004l[?2004h>         <>
[?2004l[?2004h>           <span className="opacity-0">Showing 1-15 of 100 products</span>
[?2004l[?2004h>           <div data-testid="pagination" className="flex items-center gap-3 opacity-0">
[?2004l[?2004h>             <button className="px-4 py-2">← Prev</button>
[?2004l[?2004h>             <span>Page 1 of 1</span>
[?2004l[?2004h>             <button className="px-4 py-2">Next →</button>
[?2004l[?2004h>           </div>
[?2004l[?2004h>           <span className="opacity-0">Sort: Price ▼</span>
[?2004l[?2004h>         </>
[?2004l[?2004h>       ) : (
[?2004l[?2004h>         <>
[?2004l[?2004h>           <span>Showing {start}-{end} of {totalProducts} products</span>
[?2004l[?2004h>           <div data-testid="pagination" className="flex items-center gap-3">
[?2004l[?2004h>             <button
[?2004l[?2004h>               data-testid="prev-page-btn"
[?2004l[?2004h>               disabled={page === 1}
[?2004l[?2004h>               onClick={() => onPageChange(page - 1)}
[?2004l[?2004h>               className="px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}
[?2004l[?2004h>             >
[?2004l[?2004h>               ← Prev
[?2004l[?2004h>             </button>
[?2004l[?2004h>             <span>Page {page} of {totalPages}</span>
[?2004l[?2004h>             <button
[?2004l[?2004h>               data-testid="next-page-btn"
[?2004l[?2004h>               disabled={page === totalPages}
[?2004l[?2004h>               onClick={() => onPageChange(page + 1)}
[?2004l[?2004h>               className="px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}
[?2004l[?2004h>             >
[?2004l[?2004h>               Next →
[?2004l[?2004h>             </button>
[?2004l[?2004h>           </div>
[?2004l[?2004h>           <span>Sort: Price ▼</span>
[?2004l[?2004h>         </>
[?2004l[?2004h>       )}
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@f554ebf732e2:/app# cat > src/components/ProductList.tsx << 'EOF'
[?2004l[?2004h> 'use client';
[?2004l[?2004h> 
[?2004l[?2004h> import { useState, useEffect } from 'react';
[?2004l[?2004h> import ProductCard from './ProductCard';
[?2004l[?2004h> import ProductSkeleton from './ProductSkeleton';
[?2004l[?2004h> 
[?2004l[?2004h> const API_URL = '';
[?2004l[?2004h> 
[?2004l[?2004h> interface ProductListProps {
[?2004l[?2004h>   page: number;
[?2004l[?2004h>   onProductsLoaded: (total: number) => void;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export default function ProductList({ page, onProductsLoaded }: ProductListProps) {
[?2004l[?2004h>   const [products, setProducts] = useState<any[]>([]);
[?2004l[?2004h>   const [loading, setLoading] = useState(true);
[?2004l[?2004h>   const perPage = 15;
[?2004l[?2004h> 
[?2004l[?2004h>   useEffect(() => {
[?2004l[?2004h>     fetch(`${API_URL}/api/products`)
[?2004l[?2004h>       .then(r => r.json())
[?2004l[?2004h>       .then(data => {
[?2004l[?2004h>         setProducts(data);
[?2004l[?2004h>         setLoading(false);
[?2004l[?2004h>         onProductsLoaded(data.length);
[?2004l[?2004h>       });
[?2004l[?2004h>   }, []);
[?2004l[?2004h> 
[?2004l[?2004h>   // Show only 15 products per page
[?2004l[?2004h>   const startIndex = (page - 1) * perPage;
[?2004l[?2004h>   const visibleProducts = products.slice(startIndex, startIndex + perPage);
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div data-testid="product-list" className="p-5">
[?2004l[?2004h>       <h2 className="mb-5">Products</h2>
[?2004l[?2004h>       <div className="grid grid-cols-3 gap-5">
[?2004l[?2004h>         {loading ? (
[?2004l[?2004h>           Array.from({ length: perPage }).map((_, index) => (
[?2004l[?2004h>             <ProductSkeleton key={index} />
[?2004l[?2004h>           ))
[?2004l[?2004h>         ) : (
[?2004l[?2004h>           visibleProducts.map((product) => (
[?2004l[?2004h>             <ProductCard key={product.id} product={product} />
[?2004l[?2004h>           ))
[?2004l[?2004h>         )}
[?2004l[?2004h>       </div>
[?2004l[?2004h>     </div>
[?2004l[?2004h>   );
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@f554ebf732e2:/app# cat > src/components/ProductCard.tsx << 'EOF'
