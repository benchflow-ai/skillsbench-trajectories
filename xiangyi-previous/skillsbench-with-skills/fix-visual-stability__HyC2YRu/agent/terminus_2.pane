[?2004l'use client';

import { useState, useEffect } from 'react';

const API_URL = '';

export default function Banner() {
  const [promo, setPromo] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetch(`${API_URL}/api/banner`)
      .then(r => r.json())
      .then(data => {
        setPromo(data.text);
        setLoading(false);
      })
      .catch(() => setLoading(false));
  }, []);

  if (!loading && !promo) return null;

  return (
    <div
      data-testid="promo-banner"
      className="bg-[#0070f3] text-white py-24 px-4 text-center font-bold text-2xl"
    >
      {loading ? (
        <span className="opacity-0">Loading...</span>
      ) : (
        promo
      )}
    </div>
  );
}
[?2004hroot@f554ebf732e2:/app# cat src/components/ProductCard.tsx
[?2004l'use client';

interface Product {
  id: string;
  name: string;
  price: number;
  image: string;
}

export default function ProductCard({ product }: { product: Product }) {
  return (
    <div data-testid="product-card" className="bg-[var(--card-bg)] rounded-lg p-4" style={{ boxShadow: 'var(--card-shadow)', border: '1px solid var(--border-color)' }}>
      <img
        data-testid="product-image"
        src={product.image}
        alt={product.name}
        width={300}
        height={192}
        className="w-full aspect-[25/16] object-cover"
      />
      <h3 className="mt-3 mb-2">{product.name}</h3>
      <p className="font-bold text-[#0070f3]">${product.price.toFixed(2)}</p>
      <button className="w-full p-2.5 mt-3 bg-[#0070f3] text-white border-none rounded cursor-pointer">
        Add to Cart
      </button>
    </div>
  );
}
[?2004hroot@f554ebf732e2:/app# cat src/components/LateBanner.tsx
[?2004l'use client';

import { useState, useEffect } from 'react';

const API_URL = '';

export default function LateBanner() {
  const [text, setText] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetch(`${API_URL}/api/late-banner`)
      .then(r => r.json())
      .then(data => {
        setText(data.text);
        setLoading(false);
      })
      .catch(() => setLoading(false));
  }, []);

  if (!loading && !text) return null;

  return (
    <div
      data-testid="late-banner"
      className="bg-[#ff6b35] text-white py-32 px-4 text-center font-bold text-[28px]"
    >
      {loading ? (
        <span className="opacity-0">Loading...</span>
      ) : (
        text
      )}
    </div>
  );
}
[?2004hroot@f554ebf732e2:/app# cat src/components/ProductList.tsx
[?2004l'use client';

import { useState, useEffect } from 'react';
import ProductCard from './ProductCard';
import ProductSkeleton from './ProductSkeleton';

const API_URL = '';

interface ProductListProps {
  page: number;
  onProductsLoaded: (total: number) => void;
}

export default function ProductList({ page, onProductsLoaded }: ProductListProps) {
  const [products, setProducts] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const perPage = 15;

  useEffect(() => {
    fetch(`${API_URL}/api/products`)
      .then(r => r.json())
      .then(data => {
        setProducts(data);
        setLoading(false);
        onProductsLoaded(data.length);
      });
  }, []);

  // Show only 15 products per page
  const startIndex = (page - 1) * perPage;
  const visibleProducts = products.slice(startIndex, startIndex + perPage);

  return (
    <div data-testid="product-list" className="p-5">
      <h2 className="mb-5">Products</h2>
      <div className="grid grid-cols-3 gap-5">
        {loading ? (
          Array.from({ length: perPage }).map((_, index) => (
            <ProductSkeleton key={index} />
          ))
        ) : (
          visibleProducts.map((product) => (
            <ProductCard key={product.id} product={product} />
          ))
        )}
      </div>
    </div>
  );
}
