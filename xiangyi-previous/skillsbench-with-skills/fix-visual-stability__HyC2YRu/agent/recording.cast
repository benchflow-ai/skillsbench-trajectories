[188.554135, "i", "cat src/components/Banner.tsx\n"]
[188.554541, "o", "cat src/components/Banner.tsx\r\n\u001b[?2004l\r"]
[188.555789, "o", "'use client';\r\n\r\nimport { useState, useEffect } from 'react';\r\n\r\nconst API_URL = '';\r\n\r\nexport default function Banner() {\r\n  const [promo, setPromo] = useState<string | null>(null);\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  useEffect(() => {\r\n    fetch(`${API_URL}/api/banner`)\r\n      .then(r => r.json())\r\n      .then(data => {\r\n        setPromo(data.text);\r\n        setLoading(false);\r\n      })\r\n      .catch(() => setLoading(false));\r\n  }, []);\r\n\r\n  if (!loading && !promo) return null;\r\n\r\n  return (\r\n    <div\r\n      data-testid=\"promo-banner\"\r\n      className=\"bg-[#0070f3] text-white py-24 px-4 text-center font-bold text-2xl\"\r\n    >\r\n      {loading ? (\r\n        <span className=\"opacity-0\">Loading...</span>\r\n      ) : (\r\n        promo\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n"]
[188.55599, "o", "\u001b[?2004hroot@f554ebf732e2:/app# "]
[188.724084, "i", "cat src/components/ProductCard.tsx\n"]
[188.724307, "o", "cat src/components/ProductCard.tsx\r\n\u001b[?2004l\r"]
[188.725374, "o", "'use client';\r\n\r\ninterface Product {\r\n  id: string;\r\n  name: string;\r\n  price: number;\r\n  image: string;\r\n}\r\n\r\nexport default function ProductCard({ product }: { product: Product }) {\r\n  return (\r\n    <div data-testid=\"product-card\" className=\"bg-[var(--card-bg)] rounded-lg p-4\" style={{ boxShadow: 'var(--card-shadow)', border: '1px solid var(--border-color)' }}>\r\n      <img\r\n        data-testid=\"product-image\"\r\n        src={product.image}\r\n        alt={product.name}\r\n        width={300}\r\n        height={192}\r\n        className=\"w-full aspect-[25/16] object-cover\"\r\n      />\r\n      <h3 className=\"mt-3 mb-2\">{product.name}</h3>\r\n      <p className=\"font-bold text-[#0070f3]\">${product.price.toFixed(2)}</p>\r\n      <button className=\"w-full p-2.5 mt-3 bg-[#0070f3] text-white border-none rounded cursor-pointer\">\r\n        Add to Cart\r\n      </button>\r\n    </div>\r\n  );\r\n}\r\n"]
[188.7255, "o", "\u001b[?2004hroot@f554ebf732e2:/app# "]
[204.88682, "i", "cat src/components/LateBanner.tsx\n"]
[204.887358, "o", "cat src/components/LateBanner.tsx\r\n\u001b[?2004l\r"]
[204.888351, "o", "'use client';\r\n\r\nimport { useState, useEffect } from 'react';\r\n\r\nconst API_URL = '';\r\n\r\nexport default function LateBanner() {\r\n  const [text, setText] = useState<string | null>(null);\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  useEffect(() => {\r\n    fetch(`${API_URL}/api/late-banner`)\r\n      .then(r => r.json())\r\n      .then(data => {\r\n        setText(data.text);\r\n        setLoading(false);\r\n      })\r\n      .catch(() => setLoading(false));\r\n  }, []);\r\n\r\n  if (!loading && !text) return null;\r\n\r\n  return (\r\n    <div\r\n      data-testid=\"late-banner\"\r\n      className=\"bg-[#ff6b35] text-white py-32 px-4 text-center font-bold text-[28px]\"\r\n    >\r\n      {loading ? (\r\n        <span className=\"opacity-0\">Loading...</span>\r\n      ) : (\r\n        text\r\n"]
[204.888384, "o", "      )}\r\n    </div>\r\n  );\r\n}\r\n"]
[204.888555, "o", "\u001b[?2004hroot@f554ebf732e2:/app# "]
[205.096866, "i", "cat src/components/ProductList.tsx\n"]
[205.097642, "o", "cat src/components/ProductList.tsx\r\n\u001b[?2004l\r"]
[205.097977, "o", "'use client';\r\n\r\nimport { useState, useEffect } from 'react';\r\nimport ProductCard from './ProductCard';\r\nimport ProductSkeleton from './ProductSkeleton';\r\n\r\nconst API_URL = '';\r\n\r\ninterface ProductListProps {\r\n  page: number;\r\n  onProductsLoaded: (total: number) => void;\r\n}\r\n\r\nexport default function ProductList({ page, onProductsLoaded }: ProductListProps) {\r\n  const [products, setProducts] = useState<any[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const perPage = 15;\r\n\r\n  useEffect(() => {\r\n    fetch(`${API_URL}/api/products`)\r\n      .then(r => r.json())\r\n      .then(data => {\r\n        setProducts(data);\r\n        setLoading(false);\r\n        onProductsLoaded(data.length);\r\n      });\r\n  }, []);\r\n\r\n  // Show only 15 products per page\r\n  const startIndex = (page - 1) * perPage;\r\n  const visibleProducts = products.slice(startIndex, startIndex + perPage);\r\n\r\n  return (\r\n    <div data-testid=\"product-list\" className=\"p-5\">\r\n      <h2 className=\"mb-5\">Products</h2>\r\n      <div className=\"grid grid-cols-3 gap-5\">\r\n        {loading ? (\r\n          Array.from({ length: perPage }).map((_, index) => (\r\n            <ProductSkeleton key={index} />\r\n          ))\r\n        ) : (\r\n          visibleProducts.map((product) => (\r\n            <ProductCard key={product.id} product={product} />\r\n          ))\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n"]
[205.098122, "o", "\u001b[?2004hroot@f554ebf732e2:/app# "]
