[119.616125, "o", "  const totalPages = Math.ceil(totalProducts / perPage) || 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.616186, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.616237, "o", "  useEffect(() => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.616297, "o", "    fetch(`${API_URL}/api/results-bar`)\r\n\u001b[?2004l\r"]
