[87.3709, "i", "cat > src/components/Banner.tsx << 'EOF'\n'use client';\n\nimport { useState, useEffect } from 'react';\n\nconst API_URL = '';\n\nexport default function Banner() {\n  const [promo, setPromo] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetch(`${API_URL}/api/banner`)\n      .then(r => r.json())\n      .then(data => {\n        setPromo(data.text);\n        setLoading(false);\n      })\n      .catch(() => setLoading(false));\n  }, []);\n\n  if (!loading && !promo) return null;\n\n  return (\n    <div\n      data-testid=\"promo-banner\"\n      className=\"bg-[#0070f3] text-white py-24 px-4 text-center font-bold text-2xl\"\n    >\n      {loading ? (\n        <span className=\"opacity-0\">Loading...</span>\n      ) : (\n        promo\n      )}\n    </div>\n  );\n}\nEOF\n"]
[87.37143, "o", "cat > src/components/Banner.tsx << 'EOF'"]
