[62.748703, "o", "678:J. Peng, Y. Wang, Y. Xi, X. Li, and K. Yu, “A survey on speech large language models,” arXiv preprint\r\n679:arXiv:2410.18908, 2024.\r\n680:Y. Chu et al., “Qwen2-audio technical report,” arXiv\r\n681:preprint arXiv:2407.10759, 2024.\r\n682:W. Held et al., “Distilling an end-to-end voice assistant without instruction training data,” arXiv preprint\r\n683:arXiv:2410.02678, 2024.\r\n686:in Proc. ACL, 2023, pp. 15 757–15 773.\r\n688:discrete sequence modeling,” in Proc. ACL, 2024, pp. 9637–\r\n693:B. Wang et al., “Audiobench: A universal benchmark for audio large language models,” arXiv preprint\r\n694:arXiv:2406.16020, 2024.\r\n696:computational complexity of self-attention,” in Proceedings\r\n697:of The 34th International Conference on Algorithmic Learning Theory, S. Agrawal and F. Orabona, Eds., ser. PMLR,\r\n700:Y. Shang, M. Cai, B. Xu, Y. J. Lee, and Y. Yan, “Llavaprumerge: Adaptive token reduction for efficient large multimodal models,” arXiv preprint arXiv:2403.15388, 2024.\r\n703:large speech language models,” in Proc. NeurIPS, 2023,\r\n706:for text-to-speech,” in Proc. Interspeech, 2019, pp. 1526–\r\n708:T. Saeki et al., “Utmos: Utokyo-sarulab system for voicemos challenge 2022,” in Proc. Interspeech, 2022, pp. 4521–\r\n714:audio language model,” arXiv preprint arXiv:2405.08295,\r\n717:NeurIPS, 2017.\r\n720:ser. Proceedings of Machine Learning Research, vol. 162,\r\n723:model insights,” arXiv preprint arXiv:2402.16363, 2024.\r\n"]
