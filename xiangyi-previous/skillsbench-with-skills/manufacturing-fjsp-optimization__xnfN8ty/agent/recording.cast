[473.338412, "o", "\u001b[?2004h> "]
[473.338607, "o", "    bl_ops = {(it['job'], it['op']): it for it in baseline['schedule']}\r\n\u001b[?2004l\r"]
[473.338632, "o", "\u001b[?2004h> "]
[473.338762, "o", "    fr_t = policy['freeze']['freeze_until']\r\n\u001b[?2004l\r"]
[473.338787, "o", "\u001b[?2004h> "]
[473.338887, "o", "    locked = []"]
[473.338974, "o", "\r\n\u001b[?2004l\r"]
