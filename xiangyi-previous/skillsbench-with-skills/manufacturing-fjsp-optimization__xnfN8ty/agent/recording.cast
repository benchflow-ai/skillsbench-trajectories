[473.336697, "o", "\u001b[?2004h> "]
[473.336889, "o", "            pts = list(map(int, lines[idx].split())); idx += 1\r\n\u001b[?2004l\r"]
[473.336917, "o", "\u001b[?2004h> "]
[473.337123, "o", "            ops.append({pts[i]: pts[i+1] for i in range(1, len(pts), 2)})\r\n\u001b[?2004l\r"]
[473.337157, "o", "\u001b[?2004h> "]
[473.337245, "o", "        jobs_data.append(ops)\r\n\u001b[?2004l\r"]
[473.337275, "o", "\u001b[?2004h> "]
[473.337407, "o", "    with open('/app/data/downtime.csv') as f:\r\n\u001b[?2004l\r"]
[473.337437, "o", "\u001b[?2004h> "]
