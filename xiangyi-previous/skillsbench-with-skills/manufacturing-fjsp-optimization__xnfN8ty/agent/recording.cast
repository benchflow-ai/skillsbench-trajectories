[16.588459, "o", "\r\n      \"machine\": 2,\r\n      \"start\": 5,\r\n      \"end\": 11,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 9,\r\n      \"end\": 15,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 2,\r\n      \"machine\": 2,\r\n      \"start\": 11,\r\n      \"end\": 16,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 1,\r\n      \"machine\": 1,\r\n      \"start\": 15,\r\n      \"end\": 20,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 2,\r\n      \"op\": 1,\r\n      \"machine\": 0,\r\n      \"start\": 16,\r\n      \"end\": 24,\r\n      \"dur\": 8\r\n    },\r\n    {\r\n      \"job\": 3,\r\n      \"op\": 2,\r\n      \"machine\": 2,\r\n      \"start\": 20,\r\n      \"end\": 26,\r\n      \"dur\": 6\r\n    },\r\n    {\r\n      \"job\": 0,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 24,\r\n      \"end\": 29,\r\n      \"dur\": 5\r\n    },\r\n    {\r\n      \"job\": 1,\r\n      \"op\": 2,\r\n      \"machine\": 0,\r\n      \"start\": 29,\r\n      \"end\": 36,\r\n"]
