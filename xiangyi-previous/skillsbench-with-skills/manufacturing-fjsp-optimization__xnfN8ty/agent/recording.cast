[16.58875, "o", "\u001b[?2004hroot@0a3a5b9e3b7f:/app# "]
[458.289085, "i", "cat << 'EOF' > solve.py\nimport json, csv\ndef solve():\n    with open('/app/data/instance.txt') as f:\n        lines = f.readlines()\n    n_jobs, n_machines = map(int, lines[0].split())\n    jobs_data, idx = [], 1\n    for j in range(n_jobs):\n        n_ops = int(lines[idx]); idx += 1\n        ops = []\n        for o in range(n_ops):\n            pts = list(map(int, lines[idx].split())); idx += 1\n            ops.append({pts[i+1]: pts[i+2] for i in range(0, len(pts), 2)})\n        jobs_data.append(ops)\n    with open('/app/data/downtime.csv') as f:\n        downtimes = list(csv.DictReader(f))\n        for d in downtimes: \n            d['m'], d['s'], d['e'] = int(d['machine']), int(d['start']), int(d['end'])\n    with open('/app/data/policy.json') as f: policy = json.load(f)\n    with open('/app/data/baseline_solution.json') as f: baseline = json.load(f)\n    bl_ops = {(it['job'], it['op']): it for it in baseline['schedule']}\n    fr_t = policy['freeze']['freeze_until']\n    locked = []\n    if policy['freeze']['enabled']:\n        for (j, o), it in bl_ops.items():\n            if it['start'] <= fr_t:\n                if not any(d['m'] == it['machine'] and not (it['end'] <= d['s'] or it['start'] >= d['e']) for d in downtimes):\n                    locked.append((j, o))\n    sched = {}\n    for (j, o) in locked:\n        it = bl_ops[(j, o)]\n        sched[(j, o)] = {'job': j, 'op': o, 'machine': it['machine'], 'start': it['start'], 'end': it['end'], 'dur': it['dur']}\n    to_sched = [(j, o) for j in range(n_jobs) for o in range(len(jobs_data[j])) if (j, o) not in locked]\n    while to_sched:\n        avail = sorted([op for op in to_sched if op[1] == 0 or (op[0], op[1]-1) in sched], key=lambda x: bl_ops[x]['start'])\n        curr_j, curr_o = avail[0]; to_sched.remove((curr_j, curr_o))\n        best_m, best_s, bl_m = None, 1e9, bl_ops[(curr_j, curr_o)]['machine']\n        e_s = sched[(curr_j, curr_o-1)]['end'] if curr_o > 0 else 0\n        for m, dur in jobs_data[curr_j][curr_o].items():\n            t = e_s\n            while True:\n                if all(not (t+dur > it['start'] and t < it['end']) for it in sched.values() if it['machine'] == m) and all(not (t+dur > d['s'] and t < d['e']) for d in downtimes if d['m'] == m):\n                    break\n                t += 1\n            if t < best_s or (t == best_s and m == bl_m):\n                best_s, best_m = t, m\n        sched[(curr_j, curr_o)] = {'job': curr_j, 'op': curr_o, 'machine': best_m, 'start': best_s, 'end': best_s + jobs_data[curr_j][curr_o][best_m], 'dur': jobs_data[curr_j][curr_o][best_m]}\n    final = sorted(sched.values(), key=lambda x: (x['start'], x['machine']))\n    res = {\"status\": \"OPTIMIZED\", \"makespan\": max(it['end'] for it in final), \"schedule\": final}\n    with open('/app/output/solution.json', 'w') as f: json.dump(res, f, indent=2)\n    with open('/app/output/schedule.csv', 'w', newline='') as f:\n        w = csv.DictWriter(f, fieldnames=['job', 'op', 'machine', 'start', 'end', 'dur'])\n        w.writeheader(); w.writerows(final)\n    print(f\"Makespan: {res['makespan']}\")\nsolve()\nEOF\npython3 solve.py\n"]
