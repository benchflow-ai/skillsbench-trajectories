[473.337596, "o", "\u001b[?2004h> "]
[473.337691, "o", "        for d in downtimes: \r\n\u001b[?2004l\r"]
[473.337725, "o", "\u001b[?2004h> "]
[473.337938, "o", "            d['m'], d['s'], d['e'] = int(d['machine']), int(d['start']), int(d['end'])\r\n\u001b[?2004l\r"]
[473.337973, "o", "\u001b[?2004h> "]
[473.338142, "o", "    with open('/app/data/policy.json') as f: policy = json.load(f)\r\n\u001b[?2004l\r"]
[473.338166, "o", "\u001b[?2004h> "]
