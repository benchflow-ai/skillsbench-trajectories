[473.340099, "o", "\u001b[?2004h> "]
[473.340142, "o", "        it = bl_ops[(j, o)]\r\n\u001b[?2004l\r"]
[473.340184, "o", "\u001b[?2004h> "]
[473.340478, "o", "        sched[(j, o)] = {'job': j, 'op': o, 'machine': it['machine'], 'start': it['start'], 'end': it['end'], 'dur': it['dur']}\r\n\u001b[?2004l\r"]
[473.340505, "o", "\u001b[?2004h> "]
