[473.335691, "o", "def solve():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.335818, "o", "    with open('/app/data/instance.txt') as f:\r\n\u001b[?2004l\r"]
[473.335846, "o", "\u001b[?2004h> "]
[473.335925, "o", "        lines = f.readlines()\r\n\u001b[?2004l\r"]
[473.335979, "o", "\u001b[?2004h> "]
[473.336106, "o", "    n_jobs, n_machines = map(int, lines[0].split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.336181, "o", "    jobs_data, idx = [], 1\r\n\u001b[?2004l\r"]
[473.336207, "o", "\u001b[?2004h> "]
[473.336309, "o", "    for j in range(n_jobs):\r\n\u001b[?2004l\r"]
[473.33636, "o", "\u001b[?2004h> "]
[473.336448, "o", "        n_ops = int(lines[idx]); idx += 1\r\n\u001b[?2004l\r"]
[473.336492, "o", "\u001b[?2004h> "]
[473.336517, "o", "        ops = []\r\n\u001b[?2004l\r"]
[473.336541, "o", "\u001b[?2004h"]
[473.336566, "o", "> "]
