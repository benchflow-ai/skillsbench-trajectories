[473.339765, "o", "\u001b[?2004h> "]
[473.339864, "o", "                    locked.append((j, o))\r\n\u001b[?2004l\r"]
[473.339911, "o", "\u001b[?2004h> "]
[473.339954, "o", "    sched = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.340006, "o", "> "]
