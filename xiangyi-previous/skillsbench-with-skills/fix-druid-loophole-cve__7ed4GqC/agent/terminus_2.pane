[?2004lpackage org.apache.druid.query.filter;

import com.fasterxml.jackson.core.JsonParser;
import com.fasterxml.jackson.databind.DeserializationContext;
import com.fasterxml.jackson.databind.JsonDeserializer;
import com.fasterxml.jackson.databind.node.ObjectNode;
import java.io.IOException;
import java.util.Iterator;

public class DimFilterValidator extends JsonDeserializer<DimFilter>
{
  @Override
  public DimFilter deserialize(JsonParser jp, DeserializationContext ctxt) throws IOException
  {
    ObjectNode node = jp.getCodec().readTree(jp);
    
    // Check for empty string keys which can bypass security
    Iterator<String> fieldNames = node.fieldNames();
    while (fieldNames.hasNext()) {
      String fieldName = fieldNames.next();
      if ("".equals(fieldName)) {
        throw new IllegalArgumentException("DimFilter cannot contain empty string keys");
      }
    }
    
    // Delegate to default deserializer
    return ctxt.readTreeAsValue(node, DimFilter.class);
  }
}
