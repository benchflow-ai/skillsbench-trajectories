[330.825504, "o", "diff --git a/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java b/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java\r\nindex 62a379a36a..0f337adfbe 100644\r\n--- a/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java\r\n+++ b/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java\r\n@@ -75,6 +75,7 @@ public class JavaScriptDimFilter extends AbstractOptimizableDimFilter implements\r\n   {\r\n     Preconditions.checkArgument(dimension != null, \"dimension must not be null\");\r\n     Preconditions.checkArgument(function != null, \"function must not be null\");\r\n+    validateConfiguration();\r\n     this.dimension = dimension;\r\n     this.function = function;\r\n     this.extractionFn = extractionFn;\r\n@@ -82,6 +83,15 @@ public class JavaScriptDimFilter extends AbstractOptimizableDimFilter implements\r\n     this.config = config;\r\n   }\r\n \r\n+  private void validateConfiguration()\r\n+  {\r\n+    if (function.contains(\"java.lang.Runtime\") ||\r\n+        function.contains(\"java.lang.ProcessBuilder\") ||\r\n+        function.contains(\"java.io.File\")) {\r\n+      throw new IllegalArgumentException(\"JavaScript filter contains dangerous Java API calls\");\r\n+    }\r\n+  }\r\n+\r\n   @VisibleForTesting\r\n   public JavaScriptDimFilter(\r\n       String dimension,\r\n"]
