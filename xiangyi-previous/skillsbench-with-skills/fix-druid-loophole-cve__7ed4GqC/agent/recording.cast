[70.383707, "o", "    ObjectNode node = jp.getCodec().readTree(jp);\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.383767, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.383889, "o", "    // Check for empty string keys which can bypass security\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.384012, "o", "    Iterator<String> fieldNames = node.fieldNames();\r\n\u001b[?2004l\r"]
[70.384055, "o", "\u001b[?2004h> "]
