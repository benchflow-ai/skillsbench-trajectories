[70.386935, "o", "package org.apache.druid.query.filter;\r\n\r\nimport com.fasterxml.jackson.core.JsonParser;\r\nimport com.fasterxml.jackson.databind.DeserializationContext;\r\nimport com.fasterxml.jackson.databind.JsonDeserializer;\r\nimport com.fasterxml.jackson.databind.node.ObjectNode;\r\nimport java.io.IOException;\r\nimport java.util.Iterator;\r\n\r\npublic class DimFilterValidator extends JsonDeserializer<DimFilter>\r\n{\r\n  @Override\r\n  public DimFilter deserialize(JsonParser jp, DeserializationContext ctxt) throws IOException\r\n  {\r\n    ObjectNode node = jp.getCodec().readTree(jp);\r\n    \r\n    // Check for empty string keys which can bypass security\r\n    Iterator<String> fieldNames = node.fieldNames();\r\n    while (fieldNames.hasNext()) {\r\n      String fieldName = fieldNames.next();\r\n      if (\"\".equals(fieldName)) {\r\n        throw new IllegalArgumentException(\"DimFilter cannot contain empty string keys\");\r\n      }\r\n    }\r\n    \r\n    // Delegate to default deserializer\r\n    return ctxt.readTreeAsValue(node, DimFilter.class);\r\n  }\r\n}\r\n"]
[70.387081, "o", "\u001b[?2004hroot@f17fe370ec39:~/druid# "]
[77.552143, "i", "cat > /root/patches/0001-fix-javascript-filter-empty-key-vulnerability.patch << 'EOF'\n--- a/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java\n+++ b/processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java\n@@ -68,6 +68,7 @@ public class JavaScriptDimFilter extends AbstractOptimizableDimFilter implements\n   {\n     Preconditions.checkArgument(dimension != null, \"dimension must not be null\");\n     Preconditions.checkArgument(function != null, \"function must not be null\");\n+    validateConfiguration();\n     this.dimension = dimension;\n     this.function = function;\n     this.extractionFn = extractionFn;\n@@ -75,6 +76,15 @@ public class JavaScriptDimFilter extends AbstractOptimizableDimFilter implements\n     this.config = config;\n   }\n \n+  private void validateConfiguration()\n+  {\n+    // Validate that function is a proper JavaScript function\n+    if (function.contains(\"java.lang.Runtime\") || \n+        function.contains(\"java.lang.ProcessBuilder\") ||\n+        function.contains(\"java.io.File\")) {\n+      throw new IllegalArgumentException(\"JavaScript filter contains dangerous Java API calls\");\n+    }\n+  }\n \n   @VisibleForTesting\n   public JavaScriptDimFilter(\nEOF\ncat /root/patches/0001-fix-javascript-filter-empty-key-vulnerability.patch\n"]
