[147.287973, "o", "\u001b[?2004hroot@f17fe370ec39:~/druid# "]
[147.44976, "i", "cd /root/druid && python3 << 'PYSCRIPT'\nimport re\n\nwith open('processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java', 'r') as f:\n    lines = f.readlines()\n\n# Find the line with the last Preconditions check and add validateConfiguration() after it\nfor i, line in enumerate(lines):\n    if 'function must not be null' in line and 'Preconditions' in line:\n        lines.insert(i + 1, '    validateConfiguration();\\n')\n        break\n\n# Find the closing brace of the constructor (line with just '  }') and add the method after it\nfor i, line in enumerate(lines):\n    if i > 80 and line.strip() == '}' and '@VisibleForTesting' in lines[i+2]:\n        validation_method = '''\\n  private void validateConfiguration()\\n  {\\n    if (function.contains(\"java.lang.Runtime\") ||\\n        function.contains(\"java.lang.ProcessBuilder\") ||\\n        function.contains(\"java.io.File\")) {\\n      throw new IllegalArgumentException(\"JavaScript filter contains dangerous Java API calls\");\\n    }\\n  }\\n'''\n        lines.insert(i + 1, validation_method)\n        break\n\nwith open('processing/src/main/java/org/apache/druid/query/filter/JavaScriptDimFilter.java', 'w') as f:\n    f.writelines(lines)\n\nprint(\"File modified successfully\")\nPYSCRIPT\n"]
