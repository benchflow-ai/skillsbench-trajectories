[403.429998, "o", "    const data = JSON.parse(result);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.430048, "o", "    return data.messageId;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.430088, "o", "  } catch (error) {\r\n\u001b[?2004l\r"]
[403.430133, "o", "\u001b[?2004h> "]
