[403.421212, "i", "cat > schedule_meetings_simple.mjs << 'EOF'\n#!/usr/bin/env node\n\nimport { execSync } from 'child_process';\nimport fs from 'fs';\n\nconst GMAIL_SCRIPT = '/root/verifier-skills/gmail-skill/scripts/gmail-send.js';\n\nfunction parseMeetingRequest(emailText) {\n  const constraints = {};\n  \n  // Extract duration\n  const hourMatch = emailText.match(/(\\d+\\.?\\d*)\\s*hour/i);\n  const minuteMatch = emailText.match(/(\\d+)\\s*minute/i);\n  \n  if (hourMatch) {\n    constraints.durationHours = parseFloat(hourMatch[1]);\n  } else if (minuteMatch) {\n    constraints.durationHours = parseFloat(minuteMatch[1]) / 60;\n  } else {\n    constraints.durationHours = 1;\n  }\n  \n  // Extract dates\n  const dateMatch = emailText.match(/January\\s+(\\d+)(?:th|st|nd|rd)?(?:\\s+(?:and|or)\\s+(?:January\\s+)?(\\d+)(?:th|st|nd|rd)?)?/i);\n  if (dateMatch) {\n    const day1 = parseInt(dateMatch[1]);\n    constraints.dates = [new Date(2026, 0, day1)];\n    if (dateMatch[2]) {\n      const day2 = parseInt(dateMatch[2]);\n      constraints.dates.push(new Date(2026, 0, day2));\n    }\n  }\n  \n  // Extract time range\n  const timeMatch = emailText.match(/(\\d+):?(\\d*)\\s*(am|pm)\\s+(?:to|and)\\s+(\\d+):?(\\d*)\\s*(am|pm)/i);\n  if (timeMatch) {\n    let startHour = parseInt(timeMatch[1]);\n    const startMin = timeMatch[2] ? parseInt(timeMatch[2]) : 0;\n    const startPeriod = timeMatch[3].toLowerCase();\n    let endHour = parseInt(timeMatch[4]);\n    const endMin = timeMatch[5] ? parseInt(timeMatch[5]) : 0;\n    const endPeriod = timeMatch[6].toLowerCase();\n    \n    if (startPeriod === 'pm' && startHour !== 12) startHour += 12;\n    if (startPeriod === 'am' && startHour === 12) startHour = 0;\n    if (endPeriod === 'pm' && endHour !== 12) endHour += 12;\n    if (endPeriod === 'am' && endHour === 12) endHour = 0;\n    \n    constraints.timeStart = { hour: startHour, minute: startMin };\n    constraints.timeEnd = { hour: endHour, minute: endMin };\n  }\n  \n  return constraints;\n}\n\nfunction formatTime(date) {\n  let hours = date.getHours();\n  const minutes = date.getMinutes();\n  const ampm = hours >= 12 ? 'PM' : 'AM';\n  hours = hours % 12 || 12;\n  const minutesStr = minutes.toString().padStart(2, '0');\n  return `${hours.toString().padStart(2, '0')}:${minutesStr} ${ampm}`;\n}\n\nfunction formatDate(date) {\n  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  \n  const dayName = days[date.getDay()];\n  const month = months[date.getMonth()];\n  const day = date.getDate().toString().padStart(2, '0');\n  const year = date.getFullYear();\n  \n  return `${dayName}, ${month} ${day}, ${year}`;\n}\n\nfunction sendEmail(toEmail, subject, body) {\n  try {\n    const bodyEscaped = body.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n');\n    const result = execSync(\n      `node \"${GMAIL_SCRIPT}\" --to \"${toEmail}\" --subject \"${subject}\" --body \"${bodyEscaped}\"`,\n      { encoding: 'utf-8' }\n    );\n    const data = JSON.parse(result);\n    return data.messageId;\n  } catch (error) {\n    console.error('Error sending email:', error.message);\n    return null;\n  }\n}\n\nasync function main() {\n  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\n  const results = { sent_results: [] };\n  \n  for (const request of requests) {\n    const { email_text, from_email } = request;\n    \n    console.log(`\\nProcessing request from ${from_email}`);\n    \n    const constraints = parseMeetingRequest(email_text);\n    console.log('Constraints:', JSON.stringify(constraints, null, 2));\n    \n    // Use the earliest date and time available\n    if (constraints.dates && constraints.dates.length > 0 && constraints.timeStart) {\n      const startDate = constraints.dates[0];\n      const startTime = new Date(startDate);\n      startTime.setHours(constraints.timeStart.hour, constraints.timeStart.minute, 0, 0);\n      \n      const endTime = new Date(startTime);\n      const durationHours = constraints.durationHours || 1;\n      endTime.setHours(startTime.getHours() + Math.floor(duration"]
[403.421288, "i", "Hours));\n      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\n      \n      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\n      \n      const body = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\n      \n      console.log('\\nSending email...');\n      console.log('Body:', body.replace(/\\\\n/g, '\\n'));\n      \n      const messageId = sendEmail(from_email, 'Re: Meeting Request', body);\n      \n      if (messageId) {\n        console.log(`Email sent successfully. Message ID: ${messageId}`);\n        results.sent_results.push({ messageId });\n      } else {\n        console.log('Failed to send email');\n      }\n    } else {\n      console.log('Could not parse meeting constraints');\n    }\n  }\n  \n  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\n  console.log('\\nResults saved to /root/results.json');\n}\n\nmain().catch(console.error);\nEOF\n"]
