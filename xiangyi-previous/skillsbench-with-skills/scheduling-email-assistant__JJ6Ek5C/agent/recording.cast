[403.430436, "o", "async function main() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.430483, "o", "> "]
[403.43056, "o", "  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\r\n\u001b[?2004l\r"]
[403.430608, "o", "\u001b[?2004h> "]
[403.430662, "o", "  const results = { sent_results: [] };\r\n\u001b[?2004l\r"]
[403.430683, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[403.430794, "o", "\u001b[?2004h> "]
[403.430853, "o", "  for (const request of requests) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.430907, "o", "    const { email_text, from_email } = request;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[403.430961, "o", "\u001b[?2004h> "]
[403.431016, "o", "    console.log(`\\nProcessing request from ${from_email}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.43108, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.431166, "o", "    const constraints = parseMeetingRequest(email_text);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.431256, "o", "    console.log('Constraints:', JSON.stringify(constraints, null, 2));\r\n\u001b[?2004l\r"]
[403.431304, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[403.431363, "o", "\u001b[?2004h> "]
[403.431414, "o", "    // Use the earliest date and time available\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.431465, "o", "> "]
[403.431549, "o", "    if (constraints.dates && constraints.dates.length > 0 && constraints.timeStart) {\r\n\u001b[?2004l\r"]
[403.431601, "o", "\u001b[?2004h> "]
[403.431654, "o", "      const startDate = constraints.dates[0];\r\n\u001b[?2004l\r"]
[403.431683, "o", "\u001b[?2004h> "]
[403.431755, "o", "      const startTime = new Date(startDate);\r\n\u001b[?2004l\r"]
[403.431801, "o", "\u001b[?2004h> "]
[403.431921, "o", "      startTime.setHours(constraints.timeStart.hour, constraints.timeStart.minute, 0, 0);\r\n\u001b[?2004l\r"]
[403.431976, "o", "\u001b[?2004h> "]
[403.432024, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.432079, "o", "      const endTime = new Date(startTime);\r\n\u001b[?2004l\r"]
[403.432131, "o", "\u001b[?2004h> "]
[403.432189, "o", "      const durationHours = constraints.durationHours || 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.432238, "o", "> "]
[403.43234, "o", "      endTime.setHours(startTime.getHours() + Math.floor(durationHours));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.432466, "o", "      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.43253, "o", ">       \r\n\u001b[?2004l\r"]
[403.432585, "o", "\u001b[?2004h> "]
[403.432633, "o", "      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\r\n\u001b[?2004l\r"]
[403.432666, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r"]
[403.432746, "o", "\u001b[?2004h> "]
[403.433143, "o", "      const body = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.433174, "o", ">       \r\n\u001b[?2004l\r"]
[403.433289, "o", "\u001b[?2004h> "]
[403.433333, "o", "      console.log('\\nSending email...');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.433386, "o", "      console.log('Body:', body.replace(/\\\\n/g, '\\n'));\r\n\u001b[?2004l\r"]
[403.433425, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.433479, "o", "> "]
[403.433574, "o", "      const messageId = sendEmail(from_email, 'Re: Meeting Request', body);\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.433598, "o", ">       \r\n"]
[403.433668, "o", "\u001b[?2004l\r\u001b[?2004h"]
[403.433709, "o", ">       if (messageId) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.433815, "o", "        console.log(`Email sent successfully. Message ID: ${messageId}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.433899, "o", "        results.sent_results.push({ messageId });\r\n\u001b[?2004l\r"]
[403.433948, "o", "\u001b[?2004h> "]
[403.433977, "o", "      } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.434047, "o", "        console.log('Failed to send email');\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.434078, "o", ">       }\r\n\u001b[?2004l\r"]
[403.434102, "o", "\u001b[?2004h> "]
[403.434166, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.434239, "o", "      console.log('Could not parse meeting constraints');\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.434269, "o", ">     }\r\n\u001b[?2004l\r"]
[403.434345, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[403.434391, "o", "\u001b[?2004h> "]
[403.434466, "o", "  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.434513, "o", "> "]
[403.434569, "o", "  console.log('\\nResults saved to /root/results.json');\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.434619, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
