[494.806487, "o", "\u001b[?2004h> "]
[494.806555, "o", "    .replace(/=+$/, '');\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[494.806647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.806675, "o", "async function sendEmail(to, subject, body) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.806741, "o", "  try {\r\n\u001b[?2004l\r"]
[494.806772, "o", "\u001b[?2004h> "]
[494.806883, "o", "    const encodedMessage = createEmailMessage(to, subject, body);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.806983, "o", "    const result = await gmail.users.messages.send({\r\n\u001b[?2004l\r"]
[494.807012, "o", "\u001b[?2004h>       userId: 'me',\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.807073, "o", ">       requestBody: {\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.807136, "o", "> "]
[494.807164, "o", "        raw: encodedMessage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.807285, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.807319, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h>     return result.data.id;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.80734, "o", "  } catch (error) {\r\n\u001b[?2004l\r"]
[494.807423, "o", "\u001b[?2004h> "]
[494.807503, "o", "    console.error('Error sending email:', error.message);\r\n\u001b[?2004l\r"]
[494.807563, "o", "\u001b[?2004h>     return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.807593, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.807663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.807694, "o", "> async function main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.807839, "o", "  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.807891, "o", "  const results = { sent_results: [] };\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.807947, "o", ">   \r\n\u001b[?2004l\r"]
[494.807972, "o", "\u001b[?2004h> "]
[494.808034, "o", "  for (const request of requests) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.808144, "o", "    const { email_text, from_email } = request;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.808261, "o", "    console.log(`\\nProcessing request from ${from_email}`);\r\n\u001b[?2004l\r"]
[494.808331, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.808417, "o", "    const constraints = parseMeetingRequest(email_text);\r\n\u001b[?2004l\r"]
[494.808484, "o", "\u001b[?2004h> "]
[494.808561, "o", "    console.log('Constraints:', JSON.stringify(constraints, null, 2));\r\n\u001b[?2004l\r"]
[494.808632, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.808762, "o", "    if (constraints.dates && constraints.dates.length > 0 && constraints.timeStart) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.808821, "o", "> "]
[494.808907, "o", "      const startDate = constraints.dates[0];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.808981, "o", "      const startTime = new Date(startDate);\r\n\u001b[?2004l\r"]
[494.809055, "o", "\u001b[?2004h> "]
[494.809154, "o", "      startTime.setHours(constraints.timeStart.hour, constraints.timeStart.minute, 0, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.809217, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.809238, "o", "> "]
[494.809306, "o", "      const endTime = new Date(startTime);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.809385, "o", "      const durationHours = constraints.durationHours || 1;\r\n\u001b[?2004l\r"]
[494.809408, "o", "\u001b[?2004h> "]
[494.809539, "o", "      endTime.setHours(startTime.getHours() + Math.floor(durationHours));\r\n\u001b[?2004l\r"]
[494.809615, "o", "\u001b[?2004h> "]
[494.809701, "o", "      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.809764, "o", ">       \r\n\u001b[?2004l\r"]
[494.809788, "o", "\u001b[?2004h> "]
[494.809887, "o", "      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\r\n\u001b[?2004l\r"]
[494.80994, "o", "\u001b[?2004h> "]
[494.809994, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.810396, "o", "      const emailBody = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.810485, "o", ">       \r\n\u001b[?2004l\r"]
[494.810509, "o", "\u001b[?2004h>       console.log('\\nSending email...');\r\n\u001b[?2004l\r"]
[494.810529, "o", "\u001b[?2004h> "]
[494.810682, "o", "      const messageId = await sendEmail(from_email, 'Re: Meeting Request', emailBody);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.810762, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.810787, "o", "      if (messageId) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.810897, "o", "        console.log(`Email sent successfully. Message ID: ${messageId}`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.810974, "o", "        results.sent_results.push({ messageId });\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.811023, "o", "> "]
[494.811071, "o", "      } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.811096, "o", "        console.log('Failed to send email');\r\n\u001b[?2004l\r"]
[494.811147, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[494.811171, "o", "\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[494.811209, "o", "\u001b[?2004h> "]
[494.811346, "o", "      console.log('Could not parse meeting constraints');\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.81137, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.811507, "o", "  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.811592, "o", "  console.log('\\nResults saved to /root/results.json');\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.811615, "o", "> "]
[494.811687, "o", "  console.log(JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.811709, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.811766, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.81183, "o", "main().catch(console.error);\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
