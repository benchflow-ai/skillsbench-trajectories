[89.405497, "o", "> "]
[89.405598, "o", "            day1 = int(match.group(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.405738, "o", "            constraints['dates'] = [datetime(2026, 1, day1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.405821, "o", "            if match.group(2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.405953, "o", "                day2 = int(match.group(2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.406139, "o", "                constraints['dates'].append(datetime(2026, 1, day2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.406219, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.406254, "o", "> "]
[89.406292, "o", "    # Extract time range\r\n\u001b[?2004l\r"]
[89.40637, "o", "\u001b[?2004h> "]
[89.406507, "o", "    time_pattern = r'(\\d+):?(\\d*)\\s*(am|pm)\\s+(?:to|and)\\s+(\\d+):?(\\d*)\\s*(am|pm)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.406688, "o", "    match = re.search(time_pattern, email_text, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.406769, "o", "    if match:\r\n\u001b[?2004l\r)\u001b[?2004h> "]
[89.406854, "o", "        start_hour = int(match.group(1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.406887, "o", "> "]
[89.407048, "o", "        start_min = int(match.group(2)) if match.group(2) else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.407171, "o", "        start_period = match.group(3).lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.407273, "o", "        end_hour = int(match.group(4))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.407459, "o", "        end_min = int(match.group(5)) if match.group(5) else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.407577, "o", "        end_period = match.group(6).lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.407642, "o", "        \r\n\u001b[?2004l\r).\u001b[?2004h> "]
[89.407679, "o", "        # Convert to 24-hour format\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.407754, "o", "> "]
[89.407842, "o", "        if start_period == 'pm' and start_hour != 12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.407878, "o", "> "]
[89.407947, "o", "            start_hour += 12\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.408015, "o", "> "]
[89.408085, "o", "        elif start_period == 'am' and start_hour == 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408122, "o", "            start_hour = 0\r\n\u001b[?2004l\r"]
[89.408194, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408309, "o", "        if end_period == 'pm' and end_hour != 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408375, "o", "            end_hour += 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408508, "o", "        elif end_period == 'am' and end_hour == 12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408598, "o", "            end_hour = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.40868, "o", "        \r\n\u001b[?2004l\rse\u001b[?2004h> "]
[89.40876, "o", "        constraints['time_start'] = (start_hour, start_min)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.408931, "o", "        constraints['time_end'] = (end_hour, end_min)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.409023, "o", "\u001b[?2004h>     return constraints\r\n\u001b[?2004l\r"]
[89.409093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h> def get_calendar_service():\r\n\u001b[?2004l\r "]
[89.409174, "o", "\u001b[?2004h> "]
[89.409235, "o", "    \"\"\"Get authenticated Calendar API service\"\"\"\r\n\u001b[?2004l\r"]
[89.409275, "o", "\u001b[?2004h>     creds = None\r\n\u001b[?2004l\r  "]
[89.40935, "o", "\u001b[?2004h> "]
[89.409471, "o", "    token_path = '/root/auth/calendar/tokens.json'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.409658, "o", "    creds_path = '/root/auth/calendar/credentials.json'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.40973, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.409793, "o", "    if os.path.exists(token_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.409872, "o", "> "]
[89.409965, "o", "        creds = Credentials.from_authorized_user_file(token_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.410007, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.410101, "o", "    if not creds or not creds.valid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41028, "o", "        if creds and creds.expired and creds.refresh_token:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.410374, "o", "            creds.refresh(Request())\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.410452, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41055, "o", "    return build('calendar', 'v3', credentials=creds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.410634, "o", "> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[89.410713, "o", "def get_gmail_service():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.410797, "o", "    \"\"\"Get authenticated Gmail API service\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.410833, "o", "> "]
[89.410871, "o", "    creds = None\r\n\u001b[?2004l\r -\u001b[?2004h> "]
[89.410997, "o", "    token_path = '/root/auth/gmail/tokens.json'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411124, "o", "    creds_path = '/root/auth/gmail/credentials.json'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411166, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411265, "o", "    if os.path.exists(token_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411484, "o", "        creds = Credentials.from_authorized_user_file(token_path)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\ra"]
[89.41156, "o", "\u001b[?2004h> "]
[89.411638, "o", "    if not creds or not creds.valid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411831, "o", "        if creds and creds.expired and creds.refresh_token:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.411953, "o", "            creds.refresh(Request())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.412017, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.412106, "o", "    return build('gmail', 'v1', credentials=creds)\r\n\u001b[?2004l\r \u001b[?2004h> \r\n"]
[89.412142, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[89.412323, "o", "def check_availability(calendar_service, start_time, end_time):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.412445, "o", "    \"\"\"Check if a time slot is available\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41248, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.412657, "o", "        events_result = calendar_service.events().list(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.412749, "o", "            calendarId='primary',\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.412819, "o", "> "]
[89.412904, "o", "            timeMin=start_time.isoformat() + 'Z',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413033, "o", "            timeMax=end_time.isoformat() + 'Z',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413106, "o", "            singleEvents=True,\r\n\u001b[?2004l\r \u001b[?2004h> "]
[89.413187, "o", "            orderBy='startTime'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413254, "o", "        ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413294, "o", "        \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[89.413422, "o", "        events = events_result.get('items', [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413504, "o", "        return len(events) == 0\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[89.413574, "o", "    except HttpError as error:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413698, "o", "        print(f'An error occurred: {error}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.413777, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.413813, "o", "\u001b[?2004h> "]
[89.413938, "o", "def find_available_slot(calendar_service, constraints):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414026, "o", "    \"\"\"Find the earliest available time slot\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.4141, "o", "> "]
[89.414178, "o", "    duration_hours = constraints.get('duration_hours', 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414258, "o", "    dates = constraints.get('dates', [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414323, "o", "    time_start = constraints.get('time_start', (9, 0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.414408, "o", "> "]
[89.414476, "o", "    time_end = constraints.get('time_end', (17, 0))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414547, "o", "    for date in dates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414633, "o", "        # Try 30-minute intervals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414715, "o", "        current_hour, current_min = time_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414796, "o", "        end_hour, end_min = time_end\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.414878, "o", "        while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41498, "o", "            start_time = date.replace(hour=current_hour, minute=current_min, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.415053, "o", "> "]
[89.415137, "o", "            end_time = start_time + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.415206, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415282, "o", "            # Check if end time exceeds the constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415412, "o", "            constraint_end = date.replace(hour=end_hour, minute=end_min, second=0, microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415506, "o", "            if end_time > constraint_end:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415589, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415667, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415748, "o", "            if check_availability(calendar_service, start_time, end_time):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415828, "o", "                return start_time, end_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415889, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.415959, "o", "            # Move to next 30-minute slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41604, "o", "            current_min += 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41613, "o", "            if current_min >= 60:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416212, "o", "                current_min = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 current_hour += 1\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[89.416296, "o", "\u001b[?2004h> "]
[89.416363, "o", "            if current_hour > end_hour or (current_hour == end_hour and current_min >= end_min):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.416446, "o", ">                 break\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416522, "o", "    return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416597, "o", "def format_time(dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416682, "o", "    \"\"\"Format time as HH:MM AM/PM\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416745, "o", "    return dt.strftime('%I:%M %p')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416815, "o", "def format_date(dt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.4169, "o", "    \"\"\"Format date as Day, Month DD, YYYY\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.416987, "o", "    return dt.strftime('%A, %B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.417068, "o", "\u001b[?2004h> def send_email(gmail_service, to_email, subject, body):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.41713, "o", ">     \"\"\"Send email via Gmail API\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417201, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417272, "o", "        message = MIMEText(body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417343, "o", "        message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417427, "o", "        message['subject'] = subject\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417549, "o", "        raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417624, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417699, "o", "        send_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417771, "o", "            userId='me',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.417853, "o", "            body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h>         ).execute()\r\n\u001b[?2004l\r"]
[89.417932, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418013, "o", "        return send_message['id']\r\n\u001b[?2004l\r\u001b[?2004h>     except HttpError as error:\r\n\u001b[?2004l\r"]
[89.418093, "o", "\u001b[?2004h>         print(f'An error occurred: {error}')\r\n\u001b[?2004l\r"]
[89.418172, "o", "\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.418251, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418312, "o", "    # Read meeting requests\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418384, "o", "    with open('/root/test_input.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41846, "o", "        requests = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[89.418538, "o", "\u001b[?2004h>     # Get API services\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418611, "o", "    calendar_service = get_calendar_service()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418681, "o", "    gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.418719, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41879, "o", "    results = {'sent_results': []}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418884, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     for request in requests:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.418965, "o", "        email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419047, "o", "        from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[89.419127, "o", "\u001b[?2004h> "]
[89.419194, "o", "        print(f\"\\nProcessing request from {from_email}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419269, "o", "        # Parse constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419343, "o", "        constraints = parse_meeting_request(email_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41942, "o", "        print(f\"Constraints: {constraints}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419504, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419588, "o", "        # Find available slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419668, "o", "        start_time, end_time = find_available_slot(calendar_service, constraints)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.41975, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         if start_time and end_time:\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.419829, "o", ">             # Format the response\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.419898, "o", "            day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420022, "o", "            date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420151, "o", "            time_range = f\"{format_time(start_time)} - {format_time(end_time)}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420266, "o", "            duration_hours = constraints.get('duration_hours', 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420338, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420415, "o", "            body = f\"\"\"Hi,\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420487, "o", "Thank you for your meeting request.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.420563, "o", "> I can be available:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420636, "o", "Date: {day_name}, {date_formatted}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.420726, "o", "Time: {time_range}\r\n\u001b[?2004l\r\u001b[?2004h> "]
