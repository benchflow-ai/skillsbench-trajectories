[139.913883, "i", "cat > schedule_meetings.py << 'EOF'\nimport json\nimport os\nfrom datetime import datetime, timedelta\nfrom google.auth.transport.requests import Request\nfrom google.oauth2.credentials import Credentials\nfrom googleapiclient.discovery import build\nfrom googleapiclient.errors import HttpError\nimport base64\nfrom email.mime.text import MIMEText\nimport re\n\ndef parse_meeting_request(email_text):\n    \"\"\"Extract meeting constraints from email text\"\"\"\n    constraints = {}\n    \n    # Extract duration\n    duration_patterns = [\n        r'(\\d+\\.?\\d*)\\s*hour',\n        r'(\\d+)\\s*minute'\n    ]\n    \n    for pattern in duration_patterns:\n        match = re.search(pattern, email_text, re.IGNORECASE)\n        if match:\n            if 'hour' in pattern:\n                constraints['duration_hours'] = float(match.group(1))\n            elif 'minute' in pattern:\n                constraints['duration_hours'] = float(match.group(1)) / 60\n            break\n    \n    # Extract dates\n    date_patterns = [\n        r'January\\s+(\\d+)(?:th|st|nd|rd)?(?:\\s+and\\s+January\\s+(\\d+)(?:th|st|nd|rd)?)?',\n    ]\n    \n    for pattern in date_patterns:\n        match = re.search(pattern, email_text, re.IGNORECASE)\n        if match:\n            day1 = int(match.group(1))\n            constraints['dates'] = [datetime(2026, 1, day1)]\n            if match.group(2):\n                day2 = int(match.group(2))\n                constraints['dates'].append(datetime(2026, 1, day2))\n            break\n    \n    # Extract time range\n    time_pattern = r'(\\d+):?(\\d*)\\s*(am|pm)\\s+(?:to|and)\\s+(\\d+):?(\\d*)\\s*(am|pm)'\n    match = re.search(time_pattern, email_text, re.IGNORECASE)\n    if match:\n        start_hour = int(match.group(1))\n        start_min = int(match.group(2)) if match.group(2) else 0\n        start_period = match.group(3).lower()\n        end_hour = int(match.group(4))\n        end_min = int(match.group(5)) if match.group(5) else 0\n        end_period = match.group(6).lower()\n        \n        # Convert to 24-hour format\n        if start_period == 'pm' and start_hour != 12:\n            start_hour += 12\n        elif start_period == 'am' and start_hour == 12:\n            start_hour = 0\n            \n        if end_period == 'pm' and end_hour != 12:\n            end_hour += 12\n        elif end_period == 'am' and end_hour == 12:\n            end_hour = 0\n        \n        constraints['time_start'] = (start_hour, start_min)\n        constraints['time_end'] = (end_hour, end_min)\n    \n    return constraints\n\ndef load_credentials(token_path):\n    \"\"\"Load credentials from token file with nested structure\"\"\"\n    with open(token_path, 'r') as f:\n        token_data = json.load(f)\n    \n    # Extract default account credentials\n    default_account = token_data.get('defaultAccount', 'default')\n    account_data = token_data.get('accounts', {}).get(default_account, {})\n    \n    # Create credentials object\n    creds = Credentials(\n        token=account_data.get('access_token'),\n        refresh_token=account_data.get('refresh_token'),\n        token_uri='https://oauth2.googleapis.com/token',\n        client_id=account_data.get('client_id'),\n        client_secret=account_data.get('client_secret'),\n        scopes=account_data.get('scope', '').split()\n    )\n    \n    return creds\n\ndef get_calendar_service():\n    \"\"\"Get authenticated Calendar API service\"\"\"\n    token_path = '/root/auth/calendar/tokens.json'\n    creds = load_credentials(token_path)\n    return build('calendar', 'v3', credentials=creds)\n\ndef get_gmail_service():\n    \"\"\"Get authenticated Gmail API service\"\"\"\n    token_path = '/root/auth/gmail/tokens.json'\n    creds = load_credentials(token_path)\n    return build('gmail', 'v1', credentials=creds)\n\ndef check_availability(calendar_service, start_time, end_time):\n    \"\"\"Check if a time slot is available\"\"\"\n    try:\n        events_result = calendar_service.events().list(\n            calendarId='primary',\n            timeMin=start_time.isoformat() + 'Z',\n            timeMax=end_time.isoformat() + 'Z',\n            singleEvents=True,\n            orderBy='startTime'\n        ).execute()\n        \n        even"]
[139.913943, "i", "ts = events_result.get('items', [])\n        return len(events) == 0\n    except HttpError as error:\n        print(f'An error occurred: {error}')\n        return False\n\ndef find_available_slot(calendar_service, constraints):\n    \"\"\"Find the earliest available time slot\"\"\"\n    duration_hours = constraints.get('duration_hours', 1)\n    dates = constraints.get('dates', [])\n    time_start = constraints.get('time_start', (9, 0))\n    time_end = constraints.get('time_end', (17, 0))\n    \n    for date in dates:\n        # Try 30-minute intervals\n        current_hour, current_min = time_start\n        end_hour, end_min = time_end\n        \n        while True:\n            start_time = date.replace(hour=current_hour, minute=current_min, second=0, microsecond=0)\n            end_time = start_time + timedelta(hours=duration_hours)\n            \n            # Check if end time exceeds the constraint\n            constraint_end = date.replace(hour=end_hour, minute=end_min, second=0, microsecond=0)\n            if end_time > constraint_end:\n                break\n            \n            if check_availability(calendar_service, start_time, end_time):\n                return start_time, end_time\n            \n            # Move to next 30-minute slot\n            current_min += 30\n            if current_min >= 60:\n                current_min = 0\n                current_hour += 1\n            \n            if current_hour > end_hour or (current_hour == end_hour and current_min >= end_min):\n                break\n    \n    return None, None\n\ndef format_time(dt):\n    \"\"\"Format time as HH:MM AM/PM\"\"\"\n    return dt.strftime('%I:%M %p')\n\ndef format_date(dt):\n    \"\"\"Format date as Day, Month DD, YYYY\"\"\"\n    return dt.strftime('%A, %B %d, %Y')\n\ndef send_email(gmail_service, to_email, subject, body):\n    \"\"\"Send email via Gmail API\"\"\"\n    try:\n        message = MIMEText(body)\n        message['to'] = to_email\n        message['subject'] = subject\n        \n        raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\n        \n        send_message = gmail_service.users().messages().send(\n            userId='me',\n            body={'raw': raw_message}\n        ).execute()\n        \n        return send_message['id']\n    except HttpError as error:\n        print(f'An error occurred: {error}')\n        return None\n\ndef main():\n    # Read meeting requests\n    with open('/root/test_input.json', 'r') as f:\n        requests = json.load(f)\n    \n    # Get API services\n    calendar_service = get_calendar_service()\n    gmail_service = get_gmail_service()\n    \n    results = {'sent_results': []}\n    \n    for request in requests:\n        email_text = request['email_text']\n        from_email = request['from_email']\n        \n        print(f\"\\nProcessing request from {from_email}\")\n        \n        # Parse constraints\n        constraints = parse_meeting_request(email_text)\n        print(f\"Constraints: {constraints}\")\n        \n        # Find available slot\n        start_time, end_time = find_available_slot(calendar_service, constraints)\n        \n        if start_time and end_time:\n            # Format the response\n            day_name = start_time.strftime('%A')\n            date_formatted = start_time.strftime('%B %d, %Y')\n            time_range = f\"{format_time(start_time)} - {format_time(end_time)}\"\n            duration_hours = constraints.get('duration_hours', 1)\n            \n            body = f\"\"\"Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: {day_name}, {date_formatted}\nTime: {time_range}\nDuration: {duration_hours} hour(s)\n\nIf this time doesn't work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench\"\"\"\n            \n            # Send email\n            message_id = send_email(gmail_service, from_email, 'Re: Meeting Request', body)\n            \n            if message_id:\n                print(f\"Email sent successfully. Message ID: {message_id}\")\n                results['sent_results'].append({'messageId': message_id})\n            else:\n                print(\"Failed to send email\")\n        else:\n            print(\"No availa"]
[139.914162, "i", "ble slot found\")\n    \n    # Save results\n    with open('/root/results.json', 'w') as f:\n        json.dump(results, f, indent=2)\n    \n    print(\"\\nResults saved to /root/results.json\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
[139.914277, "o", "cat > schedule_meetings.py << 'EOF'\r\n"]
