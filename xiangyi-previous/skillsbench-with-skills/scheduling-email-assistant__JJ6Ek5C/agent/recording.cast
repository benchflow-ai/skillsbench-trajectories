[241.417554, "o", "\u001b[?2004h> "]
[241.417694, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.417799, "o", "  return constraints;\r\n\u001b[?2004l\r"]
[241.417829, "o", "\u001b[?2004h> "]
[241.417919, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.41795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.418164, "o", "function checkAvailability(startTime, endTime) {\r\n\u001b[?2004l\r"]
[241.418278, "o", "\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.418427, "o", "    const result = execSync(\r\n\u001b[?2004l\r"]
[241.418463, "o", "\u001b[?2004h> "]
[241.418906, "o", "      `node \"${CALENDAR_SCRIPT}\" --timeMin \"${startTime.toISOString()}\" --timeMax \"${endTime.toISOString()}\"`,\r\n\u001b[?2004l\r"]
[241.418943, "o", "\u001b[?2004h> "]
[241.419081, "o", "      { encoding: 'utf-8' }\r\n\u001b[?2004l\r"]
[241.41912, "o", "\u001b[?2004h> "]
[241.419201, "o", "    );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.419377, "o", "    const data = JSON.parse(result);\r\n\u001b[?2004l\r"]
[241.419418, "o", "\u001b[?2004h> "]
[241.419652, "o", "    return data.events && data.events.length === 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.419682, "o", "> "]
[241.419786, "o", "  } catch (error) {\r\n\u001b[?2004l\r"]
[241.419819, "o", "\u001b[?2004h> "]
[241.420095, "o", "    console.error('Error checking availability:', error.message);\r\n\u001b[?2004l\r"]
[241.420125, "o", "\u001b[?2004h> "]
[241.420251, "o", "    return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.420288, "o", "  }\r\n\u001b[?2004l\r"]
[241.420327, "o", "\u001b[?2004h> }"]
[241.42036, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.420403, "o", "> \r\n\u001b[?2004l\r"]
[241.420444, "o", "\u001b[?2004h> "]
[241.420658, "o", "function findAvailableSlot(constraints) {\r\n\u001b[?2004l\r"]
[241.420693, "o", "\u001b[?2004h> "]
[241.420968, "o", "  const durationHours = constraints.durationHours || 1;\r\n\u001b[?2004l\r"]
[241.421007, "o", "\u001b[?2004h> "]
[241.421232, "o", "  const dates = constraints.dates || [];\r\n\u001b[?2004l\r"]
[241.421267, "o", "\u001b[?2004h> "]
[241.421548, "o", "  const timeStart = constraints.timeStart || { hour: 9, minute: 0 };\r\n\u001b[?2004l\r"]
[241.421582, "o", "\u001b[?2004h> "]
[241.421758, "o", "  const timeEnd = constraints.timeEnd || { hour: 17, minute: 0 };\r\n\u001b[?2004l\r"]
[241.421791, "o", "\u001b[?2004h>   \r\n"]
[241.421824, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[241.421913, "o", "  for (const date of dates) {\r\n\u001b[?2004l\r"]
[241.42195, "o", "\u001b[?2004h> "]
[241.422064, "o", "    let currentHour = timeStart.hour;\r\n\u001b[?2004l\r"]
[241.4221, "o", "\u001b[?2004h> "]
[241.422207, "o", "    let currentMin = timeStart.minute;\r\n\u001b[?2004l\r"]
[241.422239, "o", "\u001b[?2004h> "]
[241.422278, "o", "    \r\n\u001b[?2004l\r"]
[241.422311, "o", "\u001b[?2004h> "]
[241.422419, "o", "    while (true) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.422513, "o", "      const startTime = new Date(date);\r\n\u001b[?2004l\r"]
[241.422546, "o", "\u001b[?2004h> "]
[241.422704, "o", "      startTime.setHours(currentHour, currentMin, 0, 0);\r\n\u001b[?2004l\r"]
[241.422746, "o", "\u001b[?2004h> "]
[241.422794, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.422909, "o", "      const endTime = new Date(startTime);\r\n\u001b[?2004l\r"]
[241.422956, "o", "\u001b[?2004h> "]
[241.423138, "o", "      endTime.setHours(startTime.getHours() + Math.floor(durationHours));\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.423173, "o", "> "]
[241.423347, "o", "      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\r\n\u001b[?2004l\r"]
[241.423378, "o", "\u001b[?2004h> "]
[241.423495, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.423554, "o", "      const constraintEnd = new Date(date);\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.423586, "o", "> "]
[241.423744, "o", "      constraintEnd.setHours(timeEnd.hour, timeEnd.minute, 0, 0);\r\n\u001b[?2004l\r"]
[241.423778, "o", "\u001b[?2004h> "]
[241.423815, "o", "      \r\n\u001b[?2004l\r"]
[241.423858, "o", "\u001b[?2004h> "]
[241.423968, "o", "      if (endTime > constraintEnd) break;\r\n\u001b[?2004l\r"]
[241.424001, "o", "\u001b[?2004h> "]
[241.424029, "o", "      \r\n\u001b[?2004l\r"]
[241.42406, "o", "\u001b[?2004h> "]
[241.424199, "o", "      if (checkAvailability(startTime, endTime)) {\r\n\u001b[?2004l\r"]
[241.424236, "o", "\u001b[?2004h> "]
[241.424347, "o", "        return { startTime, endTime };\r\n\u001b[?2004l\r"]
[241.424379, "o", "\u001b[?2004h> "]
[241.424417, "o", "      }\r\n\u001b[?2004l\r"]
[241.424448, "o", "\u001b[?2004h> "]
[241.424487, "o", "      \r\n\u001b[?2004l\r"]
[241.424526, "o", "\u001b[?2004h> "]
[241.424675, "o", "      // Move to next 30-minute slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.424737, "o", "      currentMin += 30;\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.424768, "o", "> "]
[241.424843, "o", "      if (currentMin >= 60) {\r\n\u001b[?2004l\r"]
[241.424897, "o", "\u001b[?2004h> "]
[241.424976, "o", "        currentMin = 0;\r\n\u001b[?2004l\r"]
[241.425009, "o", "\u001b[?2004h> "]
[241.425083, "o", "        currentHour += 1;\r\n\u001b[?2004l\r"]
[241.425114, "o", "\u001b[?2004h> "]
[241.425186, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.425221, "o", "      \r\n\u001b[?2004l\r"]
[241.425253, "o", "\u001b[?2004h> "]
[241.425498, "o", "      if (currentHour > timeEnd.hour || (currentHour === timeEnd.hour && currentMin >= timeEnd.minute)) {\r\n\u001b[?2004l\r"]
[241.425533, "o", "\u001b[?2004h> "]
[241.425572, "o", "        break;\r\n\u001b[?2004l\r"]
[241.425606, "o", "\u001b[?2004h> "]
[241.425734, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n"]
[241.425768, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[241.425807, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h"]
[241.425839, "o", "> "]
[241.425949, "o", "  return null;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[241.425986, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[241.426076, "o", "function formatTime(date) {\r\n\u001b[?2004l\r"]
[241.426108, "o", "\u001b[?2004h> "]
[241.426205, "o", "  let hours = date.getHours();\r\n\u001b[?2004l\r"]
[241.426238, "o", "\u001b[?2004h> "]
[241.426348, "o", "  const minutes = date.getMinutes();\r\n\u001b[?2004l\r"]
[241.426385, "o", "\u001b[?2004h> "]
[241.426509, "o", "  const ampm = hours >= 12 ? 'PM' : 'AM';\r\n\u001b[?2004l\r"]
[241.426539, "o", "\u001b[?2004h> "]
[241.426636, "o", "  hours = hours % 12 || 12;\r\n\u001b[?2004l\r"]
[241.426701, "o", "\u001b[?2004h> "]
[241.42681, "o", "  const minutesStr = minutes.toString().padStart(2, '0');\r\n\u001b[?2004l\r"]
[241.42688, "o", "\u001b[?2004h> "]
[241.427046, "o", "  return `${hours.toString().padStart(2, '0')}:${minutesStr} ${ampm}`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.427126, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[241.427186, "o", "> "]
[241.427255, "o", "function formatDate(date) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.427472, "o", "  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\r\n\u001b[?2004l\r"]
[241.427544, "o", "\u001b[?2004h> "]
[241.427785, "o", "  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\r\n\u001b[?2004l\r"]
[241.427864, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.427963, "o", "  const dayName = days[date.getDay()];\r\n\u001b[?2004l\r"]
[241.428031, "o", "\u001b[?2004h> "]
[241.428115, "o", "  const month = months[date.getMonth()];\r\n\u001b[?2004l\r"]
[241.428178, "o", "\u001b[?2004h> "]
[241.428317, "o", "  const day = date.getDate().toString().padStart(2, '0');\r\n\u001b[?2004l\r"]
[241.428385, "o", "\u001b[?2004h> "]
[241.428446, "o", "  const year = date.getFullYear();\r\n\u001b[?2004l\r"]
[241.428516, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h"]
[241.428587, "o", "> "]
[241.428657, "o", "  return `${dayName}, ${month} ${day}, ${year}`;\r\n\u001b[?2004l\r"]
[241.428764, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[241.428828, "o", "\u001b[?2004h> "]
[241.428914, "o", "function sendEmail(toEmail, subject, body) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.428992, "o", ">   try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.429052, "o", "> "]
[241.429124, "o", "    const result = execSync(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.429391, "o", "      `node \"${GMAIL_SCRIPT}\" --to \"${toEmail}\" --subject \"${subject}\" --body \"${body.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n')}\"`,\r\n\u001b[?2004l\r"]
[241.429463, "o", "\u001b[?2004h> "]
[241.429533, "o", "      { encoding: 'utf-8' }\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.429601, "o", ">     );\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.429669, "o", "> "]
[241.429733, "o", "    const data = JSON.parse(result);\r\n\u001b[?2004l\r"]
[241.4298, "o", "\u001b[?2004h> "]
[241.429869, "o", "    return data.messageId;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.429933, "o", "  } catch (error) {\r\n\u001b[?2004l\r"]
[241.429999, "o", "\u001b[?2004h> "]
[241.430113, "o", "    console.error('Error sending email:', error.message);\r\n\u001b[?2004l\r"]
[241.430179, "o", "\u001b[?2004h> "]
[241.430243, "o", "    return null;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n"]
[241.430319, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.430387, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.430455, "o", "async function main() {\r\n\u001b[?2004l\r"]
[241.430521, "o", "\u001b[?2004h> "]
[241.430592, "o", "  // Read meeting requests\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.430807, "o", "  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.430913, "o", "  const results = { sent_results: [] };\r\n\u001b[?2004l\r"]
[241.430989, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.431088, "o", "  for (const request of requests) {\r\n\u001b[?2004l\r"]
[241.431152, "o", "\u001b[?2004h> "]
[241.43125, "o", "    const { email_text, from_email } = request;\r\n\u001b[?2004l\r"]
[241.431325, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[241.43139, "o", "\u001b[?2004h> "]
[241.431504, "o", "    console.log(`\\nProcessing request from ${from_email}`);\r\n\u001b[?2004l\r"]
[241.43158, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[241.431655, "o", ">     // Parse constraints\r\n"]
[241.431721, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[241.431861, "o", "    const constraints = parseMeetingRequest(email_text);\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.431931, "o", "> "]
[241.432071, "o", "    console.log('Constraints:', JSON.stringify(constraints, null, 2));\r\n\u001b[?2004l\r"]
[241.432142, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[241.432208, "o", "> "]
[241.432283, "o", "    // Find available slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.432391, "o", "    const slot = findAvailableSlot(constraints);\r\n\u001b[?2004l\r"]
[241.432481, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.432549, "o", "    if (slot) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.432624, "o", "> "]
[241.432687, "o", "      const { startTime, endTime } = slot;\r\n\u001b[?2004l\r"]
[241.432752, "o", "\u001b[?2004h> "]
[241.432895, "o", "      const dayName = formatDate(startTime).split(',')[0];\r\n\u001b[?2004l\r"]
[241.432971, "o", "\u001b[?2004h> "]
[241.433128, "o", "      const dateFormatted = formatDate(startTime).substring(dayName.length + 2);\r\n\u001b[?2004l\r"]
[241.433203, "o", "\u001b[?2004h> "]
[241.433358, "o", "      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\r\n\u001b[?2004l\r"]
[241.433429, "o", "\u001b[?2004h> "]
[241.433547, "o", "      const durationHours = constraints.durationHours || 1;\r\n\u001b[?2004l\r"]
[241.43362, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r"]
[241.433689, "o", "\u001b[?2004h> "]
[241.434163, "o", "      const body = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\r\n\u001b[?2004l\r"]
[241.434263, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.434364, "o", "      console.log('\\nSending email...');\r\n\u001b[?2004l\r"]
[241.434432, "o", "\u001b[?2004h> "]
[241.434573, "o", "      const messageId = sendEmail(from_email, 'Re: Meeting Request', body);\r\n\u001b[?2004l\r"]
[241.43465, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.434724, "o", "      if (messageId) {\r\n\u001b[?2004l\r"]
[241.43479, "o", "\u001b[?2004h> "]
[241.434945, "o", "        console.log(`Email sent successfully. Message ID: ${messageId}`);\r\n\u001b[?2004l\r"]
[241.435015, "o", "\u001b[?2004h> "]
[241.435104, "o", "        results.sent_results.push({ messageId });\r\n\u001b[?2004l\r"]
[241.435173, "o", "\u001b[?2004h>       } else {"]
[241.435245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.435341, "o", "        console.log('Failed to send email');\r\n\u001b[?2004l\r"]
[241.435411, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[241.435478, "o", "\u001b[?2004h> "]
[241.43555, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.435659, "o", "      console.log('No available slot found');\r\n\u001b[?2004l\r"]
[241.435731, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[241.435811, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.435891, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.43597, "o", "  // Save results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.436133, "o", "  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r"]
[241.436201, "o", "\u001b[?2004h> "]
[241.436305, "o", "  console.log('\\nResults saved to /root/results.json');\r\n\u001b[?2004l\r"]
[241.436374, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[241.436444, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[241.436519, "o", "main().catch(console.error);\r\n\u001b[?2004l\r"]
[241.436594, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[241.437986, "o", "\u001b[?2004hroot@1ae3a0db5f6f:~# "]
