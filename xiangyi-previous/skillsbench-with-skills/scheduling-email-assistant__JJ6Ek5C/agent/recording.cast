[139.926718, "o", "    if match:\r\n\u001b[?2004l\r"]
[139.926906, "o", "\u001b[?2004h> "]
[139.927047, "o", "        start_hour = int(match.group(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.927362, "o", "        start_min = int(match.group(2)) if match.group(2) else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.927387, "o", "> "]
[139.927629, "o", "        start_period = match.group(3).lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.927654, "o", "> "]
[139.927859, "o", "        end_hour = int(match.group(4))\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.927881, "o", "> "]
[139.928225, "o", "        end_min = int(match.group(5)) if match.group(5) else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.928247, "o", "> "]
[139.928485, "o", "        end_period = match.group(6).lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.928552, "o", "> "]
[139.92866, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.928837, "o", "        # Convert to 24-hour format\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.929155, "o", "        if start_period == 'pm' and start_hour != 12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.929183, "o", "> "]
[139.929389, "o", "            start_hour += 12\r\n\u001b[?2004l\r"]
[139.929411, "o", "\u001b[?2004h> "]
[139.929729, "o", "        elif start_period == 'am' and start_hour == 12:\r\n\u001b[?2004l\r"]
[139.929755, "o", "\u001b[?2004h> "]
[139.929949, "o", "            start_hour = 0\r\n\u001b[?2004l\r"]
[139.929974, "o", "\u001b[?2004h> "]
[139.930086, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.930144, "o", "> "]
[139.930559, "o", "        if end_period == 'pm' and end_hour != 12:\r\n\u001b[?2004l\r"]
[139.930643, "o", "\u001b[?2004h"]
[139.930712, "o", "> "]
[139.930895, "o", "            end_hour += 12\r\n\u001b[?2004l\r"]
[139.930923, "o", "\u001b[?2004h> "]
[139.931203, "o", "        elif end_period == 'am' and end_hour == 12:\r\n\u001b[?2004l\r"]
[139.931228, "o", "\u001b[?2004h> "]
[139.931381, "o", "            end_hour = 0\r\n\u001b[?2004l\r"]
[139.931405, "o", "\u001b[?2004h> "]
[139.931483, "o", "        \r\n\u001b[?2004l\r"]
[139.931509, "o", "\u001b[?2004h> "]
[139.931843, "o", "        constraints['time_start'] = (start_hour, start_min)\r\n\u001b[?2004l\r"]
[139.931866, "o", "\u001b[?2004h> "]
[139.932172, "o", "        constraints['time_end'] = (end_hour, end_min)\r\n\u001b[?2004l\r"]
[139.932196, "o", "\u001b[?2004h> "]
[139.932252, "o", "    \r\n\u001b[?2004l\r"]
[139.932271, "o", "\u001b[?2004h> "]
[139.932421, "o", "    return constraints\r\n\u001b[?2004l\r"]
[139.932445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.9325, "o", "\u001b[?2004h> "]
[139.9327, "o", "def load_credentials(token_path):\r\n\u001b[?2004l\r"]
[139.932725, "o", "\u001b[?2004h> "]
[139.9331, "o", "    \"\"\"Load credentials from token file with nested structure\"\"\"\r\n\u001b[?2004l\r"]
[139.933126, "o", "\u001b[?2004h> "]
[139.933427, "o", "    with open(token_path, 'r') as f:\r\n\u001b[?2004l\r"]
[139.933454, "o", "\u001b[?2004h"]
[139.933528, "o", "> "]
[139.933762, "o", "        token_data = json.load(f)\r\n"]
[139.933787, "o", "\u001b[?2004l\r"]
[139.933853, "o", "\u001b[?2004h"]
[139.933876, "o", "> "]
[139.933961, "o", "    \r\n\u001b[?2004l\r"]
[139.933983, "o", "\u001b[?2004h"]
[139.934055, "o", "> "]
[139.934341, "o", "    # Extract default account credentials\r\n\u001b[?2004l\r"]
[139.934367, "o", "\u001b[?2004h"]
[139.934442, "o", "> "]
[139.934859, "o", "    default_account = token_data.get('defaultAccount', 'default')\r\n\u001b[?2004l\r"]
[139.934883, "o", "\u001b[?2004h> "]
[139.93535, "o", "    account_data = token_data.get('accounts', {}).get(default_account, {})\r\n\u001b[?2004l\r"]
[139.935373, "o", "\u001b[?2004h> "]
[139.935499, "o", "    \r\n\u001b[?2004l\r"]
[139.935547, "o", "\u001b[?2004h> "]
[139.935753, "o", "    # Create credentials object\r\n\u001b[?2004l\r"]
[139.935778, "o", "\u001b[?2004h"]
[139.935842, "o", "> "]
[139.93608, "o", "    creds = Credentials(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.936279, "o", "        token=account_data.get('access_token'),\r\n\u001b[?2004l\r"]
[139.936341, "o", "\u001b[?2004h> "]
[139.93671, "o", "        refresh_token=account_data.get('refresh_token'),\r\n\u001b[?2004l\r"]
[139.936735, "o", "\u001b[?2004h"]
[139.93681, "o", "> "]
[139.937187, "o", "        token_uri='https://oauth2.googleapis.com/token',\r\n\u001b[?2004l\r"]
[139.937219, "o", "\u001b[?2004h> "]
[139.937557, "o", "        client_id=account_data.get('client_id'),\r\n\u001b[?2004l\r"]
[139.937582, "o", "\u001b[?2004h"]
[139.937653, "o", "> "]
[139.938001, "o", "        client_secret=account_data.get('client_secret'),\r\n\u001b[?2004l\r"]
[139.93807, "o", "\u001b[?2004h"]
[139.938208, "o", "> "]
[139.938457, "o", "        scopes=account_data.get('scope', '').split()\r\n\u001b[?2004l\r"]
[139.938484, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.938537, "o", ">     \r\n\u001b[?2004l\r"]
[139.938609, "o", "\u001b[?2004h> "]
[139.938724, "o", "    return creds\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.938788, "o", "\u001b[?2004h> "]
[139.938919, "o", "def get_calendar_service():\r\n\u001b[?2004l\r"]
[139.938986, "o", "\u001b[?2004h> "]
[139.939244, "o", "    \"\"\"Get authenticated Calendar API service\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.939317, "o", "> "]
[139.939548, "o", "    token_path = '/root/auth/calendar/tokens.json'\r\n\u001b[?2004l\r"]
[139.939678, "o", "\u001b[?2004h> "]
[139.939805, "o", "    creds = load_credentials(token_path)\r\n\u001b[?2004l\r"]
[139.939868, "o", "\u001b[?2004h> "]
[139.940148, "o", "    return build('calendar', 'v3', credentials=creds)\r\n\u001b[?2004l\r"]
[139.940217, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.940355, "o", "def get_gmail_service():\r\n\u001b[?2004l\r"]
[139.940412, "o", "\u001b[?2004h> "]
[139.940658, "o", "    \"\"\"Get authenticated Gmail API service\"\"\"\r\n\u001b[?2004l\r"]
[139.940733, "o", "\u001b[?2004h> "]
[139.940971, "o", "    token_path = '/root/auth/gmail/tokens.json'\r\n\u001b[?2004l\r"]
[139.941046, "o", "\u001b[?2004h> "]
[139.94122, "o", "    creds = load_credentials(token_path)\r\n\u001b[?2004l\r"]
[139.941283, "o", "\u001b[?2004h> "]
[139.941511, "o", "    return build('gmail', 'v1', credentials=creds)\r\n\u001b[?2004l\r"]
[139.941591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.941889, "o", "def check_availability(calendar_service, start_time, end_time):\r\n\u001b[?2004l\r"]
[139.941956, "o", "\u001b[?2004h> "]
[139.942114, "o", "    \"\"\"Check if a time slot is available\"\"\"\r\n\u001b[?2004l\r"]
[139.942178, "o", "\u001b[?2004h>     try:"]
[139.942259, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.94246, "o", "        events_result = calendar_service.events().list(\r\n\u001b[?2004l\r"]
[139.942525, "o", "\u001b[?2004h> "]
[139.942654, "o", "            calendarId='primary',\r\n\u001b[?2004l\r"]
[139.94272, "o", "\u001b[?2004h> "]
[139.942907, "o", "            timeMin=start_time.isoformat() + 'Z',\r\n\u001b[?2004l\r"]
[139.943033, "o", "\u001b[?2004h> "]
[139.943144, "o", "            timeMax=end_time.isoformat() + 'Z',\r\n\u001b[?2004l\r"]
[139.943332, "o", "\u001b[?2004h>             singleEvents=True,\r\n"]
[139.943441, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[139.943525, "o", "            orderBy='startTime'\r\n\u001b[?2004l\r"]
[139.943628, "o", "\u001b[?2004h> "]
[139.943705, "o", "        ).execute()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.943795, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.944011, "o", "        events = events_result.get('items', [])\r\n\u001b[?2004l\r"]
[139.944107, "o", "\u001b[?2004h> "]
[139.944187, "o", "        return len(events) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.944267, "o", "> "]
[139.944364, "o", "    except HttpError as error:\r\n\u001b[?2004l\r"]
[139.9445, "o", "\u001b[?2004h> "]
[139.944636, "o", "        print(f'An error occurred: {error}')\r\n\u001b[?2004l\r"]
[139.944728, "o", "\u001b[?2004h> "]
[139.944813, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.944911, "o", "\u001b[?2004h> "]
[139.945161, "o", "def find_available_slot(calendar_service, constraints):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.945374, "o", "    \"\"\"Find the earliest available time slot\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.945457, "o", "    duration_hours = constraints.get('duration_hours', 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.945586, "o", ">     dates = constraints.get('dates', [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.945727, "o", "    time_start = constraints.get('time_start', (9, 0))\r\n\u001b[?2004l\r"]
[139.945853, "o", "\u001b[?2004h> "]
[139.945972, "o", "    time_end = constraints.get('time_end', (17, 0))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.946111, "o", "    for date in dates:\r\n\u001b[?2004l\r\u001b[?2004h>         # Try 30-minute intervals\r\n\u001b[?2004l\r"]
[139.946236, "o", "\u001b[?2004h>         current_hour, current_min = time_start\r\n"]
[139.94636, "o", "\u001b[?2004l\r\u001b[?2004h>         end_hour, end_min = time_end"]
[139.94652, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.946594, "o", "        while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.946811, "o", "            start_time = date.replace(hour=current_hour, minute=current_min, second=0, microsecond=0)\r\n\u001b[?2004l\r"]
[139.946885, "o", "\u001b[?2004h> "]
[139.947001, "o", "            end_time = start_time + timedelta(hours=duration_hours)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n"]
[139.947137, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[139.94725, "o", "            # Check if end time exceeds the constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.947397, "o", "            constraint_end = date.replace(hour=end_hour, minute=end_min, second=0, microsecond=0)\r\n\u001b[?2004l\r"]
[139.947508, "o", "\u001b[?2004h>             if end_time > constraint_end:\r\n\u001b[?2004l\r"]
[139.947629, "o", "\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.947746, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.947856, "o", "            if check_availability(calendar_service, start_time, end_time):\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.947983, "o", ">                 return start_time, end_time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.948101, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.948213, "o", "            # Move to next 30-minute slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.94833, "o", "            current_min += 30\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.948451, "o", "            if current_min >= 60:\r\n\u001b[?2004l\r\u001b[?2004h>                 current_min = 0\r\n\u001b[?2004l\r"]
[139.948573, "o", "\u001b[?2004h>                 current_hour += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.948696, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.948857, "o", "            if current_hour > end_hour or (current_hour == end_hour and current_min >= end_min):\r\n\u001b[?2004l\r"]
[139.948966, "o", "\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.952932, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953096, "o", "    return None, None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def format_time(dt):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Format time as HH:MM AM/PM\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return dt.strftime('%I:%M %p')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def format_date(dt):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Format date as Day, Month DD, YYYY\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return dt.strftime('%A, %B %d, %Y')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def send_email(gmail_service, to_email, subject, body):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Send email via Gmail API\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         message = MIMEText(body)\r\n\u001b[?2004l\r\u001b[?2004h>         message['to'] = to_email\r\n\u001b[?2004l\r\u001b[?2004h>         message['subject'] = subject\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         send_message = gmail_service.users().messages().send(\r\n\u001b[?2004l\r\u001b[?2004h>             userId='me',\r\n\u001b[?2004l\r\u001b[?2004h>             body={'raw': raw_message}\r\n\u001b[?2004l\r\u001b[?2004h>         ).execute()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         return send_message['id']\r\n\u001b[?2004l\r\u001b[?2004h>     except HttpError as error:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'An error occurred: {error}')\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     # Read meeting requests\r\n\u001b[?2004l\r\u001b[?2004h>     with open('/root/test_input.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         requests = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Get API services\r\n\u001b[?2004l\r\u001b[?2004h>     calendar_service = get_calendar_service()\r\n\u001b[?2004l\r\u001b[?2004h>     gmail_service = get_gmail_service()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results = {'sent_results': []}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for request in requests:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953141, "o", "        email_text = request['email_text']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953304, "o", "        from_email = request['from_email']\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.953353, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953483, "o", "        print(f\"\\nProcessing request from {from_email}\")\r\n\u001b[?2004l\r"]
[139.953516, "o", "\u001b[?2004h> "]
[139.95359, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.953755, "o", "        # Parse constraints\r\n\u001b[?2004l\r"]
[139.953841, "o", "\u001b[?2004h> "]
[139.953978, "o", "        constraints = parse_meeting_request(email_text)\r\n\u001b[?2004l\r"]
[139.954069, "o", "\u001b[?2004h> "]
[139.954161, "o", "        print(f\"Constraints: {constraints}\")\r\n\u001b[?2004l\r"]
[139.954209, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[139.954253, "o", "\u001b[?2004h> "]
[139.954381, "o", "        # Find available slot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.954547, "o", "        start_time, end_time = find_available_slot(calendar_service, constraints)\r\n\u001b[?2004l\r"]
[139.95462, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[139.954689, "o", "\u001b[?2004h> "]
[139.954755, "o", "        if start_time and end_time:\r\n\u001b[?2004l\r"]
[139.954818, "o", "\u001b[?2004h> "]
[139.954886, "o", "            # Format the response\r\n\u001b[?2004l\r"]
[139.954959, "o", "\u001b[?2004h> "]
[139.955054, "o", "            day_name = start_time.strftime('%A')\r\n\u001b[?2004l\r"]
[139.955125, "o", "\u001b[?2004h> "]
[139.955252, "o", "            date_formatted = start_time.strftime('%B %d, %Y')\r\n\u001b[?2004l\r"]
[139.955322, "o", "\u001b[?2004h> "]
[139.955494, "o", "            time_range = f\"{format_time(start_time)} - {format_time(end_time)}\"\r\n\u001b[?2004l\r"]
[139.955565, "o", "\u001b[?2004h> "]
[139.955712, "o", "            duration_hours = constraints.get('duration_hours', 1)\r\n\u001b[?2004l\r"]
[139.95578, "o", "\u001b[?2004h>             "]
[139.955848, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.955917, "o", "            body = f\"\"\"Hi,\r\n\u001b[?2004l\r"]
[139.955985, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.956079, "o", "Thank you for your meeting request.\r\n\u001b[?2004l\r"]
[139.956147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.956215, "o", "I can be available:\r\n\u001b[?2004l\r"]
[139.956284, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.956447, "o", "Date: {day_name}, {date_formatted}\r\n"]
[139.956519, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[139.956591, "o", "Time: {time_range}\r\n\u001b[?2004l\r"]
[139.956661, "o", "\u001b[?2004h> "]
[139.956736, "o", "Duration: {duration_hours} hour(s)\r\n\u001b[?2004l\r"]
[139.956807, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.956886, "o", "> "]
[139.957053, "o", "If this time doesn't work, please let me know your preferred alternatives.\r\n\u001b[?2004l\r"]
[139.957124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.957192, "o", "> Best regards,\r\n\u001b[?2004l\r"]
[139.957261, "o", "\u001b[?2004h> "]
[139.957328, "o", "SkillsBench\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957403, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957482, "o", "            # Send email\r\n\u001b[?2004l\r"]
[139.957551, "o", "\u001b[?2004h> "]
[139.957759, "o", "            message_id = send_email(gmail_service, from_email, 'Re: Meeting Request', body)\r\n\u001b[?2004l\r"]
[139.95784, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[139.957908, "o", "\u001b[?2004h> "]
[139.957979, "o", "            if message_id:\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.958047, "o", "> "]
[139.958209, "o", "                print(f\"Email sent successfully. Message ID: {message_id}\")\r\n\u001b[?2004l\r"]
[139.958278, "o", "\u001b[?2004h> "]
[139.958445, "o", "                results['sent_results'].append({'messageId': message_id})\r\n\u001b[?2004l\r"]
[139.95851, "o", "\u001b[?2004h> "]
[139.958582, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958703, "o", "                print(\"Failed to send email\")\r\n\u001b[?2004l\r"]
[139.95877, "o", "\u001b[?2004h> "]
[139.958838, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958934, "o", "            print(\"No available slot found\")\r\n\u001b[?2004l\r"]
[139.959003, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.959072, "o", ">     # Save results\r\n\u001b[?2004l\r"]
[139.959139, "o", "\u001b[?2004h> "]
[139.959241, "o", "    with open('/root/results.json', 'w') as f:\r\n\u001b[?2004l\r"]
[139.959309, "o", "\u001b[?2004h> "]
[139.959406, "o", "        json.dump(results, f, indent=2)\r\n\u001b[?2004l\r"]
[139.959474, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.959544, "o", "> "]
[139.959636, "o", "    print(\"\\nResults saved to /root/results.json\")\r\n\u001b[?2004l\r"]
[139.959704, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.959792, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[139.959859, "o", "\u001b[?2004h> "]
[139.959927, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
