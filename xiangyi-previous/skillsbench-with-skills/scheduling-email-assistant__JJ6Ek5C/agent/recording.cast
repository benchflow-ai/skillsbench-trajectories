[206.257044, "o", "#!/usr/bin/env node\r\n\r\nimport { google } from 'googleapis';\r\nimport minimist from 'minimist';\r\nimport { getAuthClient, parseAccountArg } from './auth/auth-utils.js';\r\nimport { logAction } from './action-logger.js';\r\n\r\nfunction createEmailMessage(to, subject, body, options = {}) {\r\n  const { cc, bcc, html, replyTo } = options;\r\n\r\n  const headers = [\r\n    `To: ${to}`,\r\n    `Subject: ${subject}`,\r\n  ];\r\n\r\n  if (cc) headers.push(`Cc: ${cc}`);\r\n  if (bcc) headers.push(`Bcc: ${bcc}`);\r\n  if (replyTo) headers.push(`Reply-To: ${replyTo}`);\r\n\r\n  headers.push('Content-Type: text/html; charset=utf-8');\r\n  headers.push('');\r\n\r\n  const message = headers.join('\\r\\n') + (html || body);\r\n\r\n  return Buffer.from(message)\r\n    .toString('base64')\r\n    .replace(/\\+/g, '-')\r\n    .replace(/\\//g, '_')\r\n    .replace(/=+$/, '');\r\n}\r\n\r\nasync function sendEmail(args) {\r\n  // Validate required args\r\n  if (!args.to || !args.subject || !args.body) {\r\n    throw new Error('Missing required arguments: --to, --subject, and --body are required');\r\n  }\r\n\r\n  // Get authenticated client for specified account (or default)\r\n  const accountId = parseAccountArg(args);\r\n  const oauth2Client = await getAuthClient(accountId);\r\n\r\n  const gmail = google.gmail({ version: 'v1', auth: oauth2Client });\r\n\r\n  // Create email\r\n  const encodedMessage = createEmailMessage(\r\n    args.to,\r\n    args.subject,\r\n    args.body,\r\n    {\r\n      cc: args.cc,\r\n      bcc: args.bcc,\r\n      html: args.html,\r\n      replyTo: args['reply-to']\r\n    }\r\n  );\r\n\r\n  // Send email\r\n  const result = await gmail.users.messages.send({\r\n    userId: 'me',\r\n    requestBody: {\r\n      raw: encodedMessage\r\n    }\r\n  });\r\n\r\n  return {\r\n    success: true,\r\n    messageId: result.data.id,\r\n    threadId: result.data.threadId,\r\n    to: args.to,\r\n    subject: args.subject,\r\n    account: accountId || 'default'\r\n  };\r\n}\r\n\r\n// Main execution\r\nconst args = minimist(process.argv.slice(2));\r\nconst startTime = Date.now();\r\n\r\nsendEmail(args)\r\n  .then(result => {\r\n    // Log the action\r\n    logAction('send', args, result, {\r\n      account: result.account,\r\n      duration: Date.now() - startTime\r\n    });\r\n\r\n    console.log(JSON.stringify(result, null, 2));\r\n  })\r\n  .catch(error => {\r\n    const errorResult = {\r\n      success: false,\r\n      error: error.message\r\n    };\r\n\r\n    // Log the failed action\r\n    logAction('send', args, errorResult, {\r\n      account: args.account || 'default',\r\n      duration: Date.now() - startTime,\r\n      failed: true\r\n    });\r\n\r\n    console.error(JSON.stringify(errorResult, null, 2));\r\n    process.exit(1);\r\n  });\r\n\u001b[?2004hroot@1ae3a0db5f6f:~# "]
[241.404718, "i", "cat > schedule_meetings.js << 'EOF'\n#!/usr/bin/env node\n\nimport { execSync } from 'child_process';\nimport fs from 'fs';\nimport path from 'path';\n\nconst CALENDAR_SCRIPT = '/root/.agents/skills/google-calendar-skill/scripts/calendar-events-list.js';\nconst GMAIL_SCRIPT = '/root/verifier-skills/gmail-skill/scripts/gmail-send.js';\n\nfunction parseMeetingRequest(emailText) {\n  const constraints = {};\n  \n  // Extract duration\n  const hourMatch = emailText.match(/(\\d+\\.?\\d*)\\s*hour/i);\n  const minuteMatch = emailText.match(/(\\d+)\\s*minute/i);\n  \n  if (hourMatch) {\n    constraints.durationHours = parseFloat(hourMatch[1]);\n  } else if (minuteMatch) {\n    constraints.durationHours = parseFloat(minuteMatch[1]) / 60;\n  } else {\n    constraints.durationHours = 1; // default\n  }\n  \n  // Extract dates\n  const dateMatch = emailText.match(/January\\s+(\\d+)(?:th|st|nd|rd)?(?:\\s+and\\s+January\\s+(\\d+)(?:th|st|nd|rd)?)?/i);\n  if (dateMatch) {\n    const day1 = parseInt(dateMatch[1]);\n    constraints.dates = [new Date(2026, 0, day1)];\n    if (dateMatch[2]) {\n      const day2 = parseInt(dateMatch[2]);\n      constraints.dates.push(new Date(2026, 0, day2));\n    }\n  }\n  \n  // Extract time range\n  const timeMatch = emailText.match(/(\\d+):?(\\d*)\\s*(am|pm)\\s+(?:to|and)\\s+(\\d+):?(\\d*)\\s*(am|pm)/i);\n  if (timeMatch) {\n    let startHour = parseInt(timeMatch[1]);\n    const startMin = timeMatch[2] ? parseInt(timeMatch[2]) : 0;\n    const startPeriod = timeMatch[3].toLowerCase();\n    let endHour = parseInt(timeMatch[4]);\n    const endMin = timeMatch[5] ? parseInt(timeMatch[5]) : 0;\n    const endPeriod = timeMatch[6].toLowerCase();\n    \n    // Convert to 24-hour format\n    if (startPeriod === 'pm' && startHour !== 12) startHour += 12;\n    if (startPeriod === 'am' && startHour === 12) startHour = 0;\n    if (endPeriod === 'pm' && endHour !== 12) endHour += 12;\n    if (endPeriod === 'am' && endHour === 12) endHour = 0;\n    \n    constraints.timeStart = { hour: startHour, minute: startMin };\n    constraints.timeEnd = { hour: endHour, minute: endMin };\n  }\n  \n  return constraints;\n}\n\nfunction checkAvailability(startTime, endTime) {\n  try {\n    const result = execSync(\n      `node \"${CALENDAR_SCRIPT}\" --timeMin \"${startTime.toISOString()}\" --timeMax \"${endTime.toISOString()}\"`,\n      { encoding: 'utf-8' }\n    );\n    const data = JSON.parse(result);\n    return data.events && data.events.length === 0;\n  } catch (error) {\n    console.error('Error checking availability:', error.message);\n    return false;\n  }\n}\n\nfunction findAvailableSlot(constraints) {\n  const durationHours = constraints.durationHours || 1;\n  const dates = constraints.dates || [];\n  const timeStart = constraints.timeStart || { hour: 9, minute: 0 };\n  const timeEnd = constraints.timeEnd || { hour: 17, minute: 0 };\n  \n  for (const date of dates) {\n    let currentHour = timeStart.hour;\n    let currentMin = timeStart.minute;\n    \n    while (true) {\n      const startTime = new Date(date);\n      startTime.setHours(currentHour, currentMin, 0, 0);\n      \n      const endTime = new Date(startTime);\n      endTime.setHours(startTime.getHours() + Math.floor(durationHours));\n      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\n      \n      const constraintEnd = new Date(date);\n      constraintEnd.setHours(timeEnd.hour, timeEnd.minute, 0, 0);\n      \n      if (endTime > constraintEnd) break;\n      \n      if (checkAvailability(startTime, endTime)) {\n        return { startTime, endTime };\n      }\n      \n      // Move to next 30-minute slot\n      currentMin += 30;\n      if (currentMin >= 60) {\n        currentMin = 0;\n        currentHour += 1;\n      }\n      \n      if (currentHour > timeEnd.hour || (currentHour === timeEnd.hour && currentMin >= timeEnd.minute)) {\n        break;\n      }\n    }\n  }\n  \n  return null;\n}\n\nfunction formatTime(date) {\n  let hours = date.getHours();\n  const minutes = date.getMinutes();\n  const ampm = hours >= 12 ? 'PM' : 'AM';\n  hours = hours % 12 || 12;\n  const minutesStr = minutes.toString().padStart(2, '0');\n  return `${hours.toString().padStart(2, '0')}:${minutesStr} ${am"]
[241.404905, "i", "pm}`;\n}\n\nfunction formatDate(date) {\n  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  \n  const dayName = days[date.getDay()];\n  const month = months[date.getMonth()];\n  const day = date.getDate().toString().padStart(2, '0');\n  const year = date.getFullYear();\n  \n  return `${dayName}, ${month} ${day}, ${year}`;\n}\n\nfunction sendEmail(toEmail, subject, body) {\n  try {\n    const result = execSync(\n      `node \"${GMAIL_SCRIPT}\" --to \"${toEmail}\" --subject \"${subject}\" --body \"${body.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n')}\"`,\n      { encoding: 'utf-8' }\n    );\n    const data = JSON.parse(result);\n    return data.messageId;\n  } catch (error) {\n    console.error('Error sending email:', error.message);\n    return null;\n  }\n}\n\nasync function main() {\n  // Read meeting requests\n  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\n  const results = { sent_results: [] };\n  \n  for (const request of requests) {\n    const { email_text, from_email } = request;\n    \n    console.log(`\\nProcessing request from ${from_email}`);\n    \n    // Parse constraints\n    const constraints = parseMeetingRequest(email_text);\n    console.log('Constraints:', JSON.stringify(constraints, null, 2));\n    \n    // Find available slot\n    const slot = findAvailableSlot(constraints);\n    \n    if (slot) {\n      const { startTime, endTime } = slot;\n      const dayName = formatDate(startTime).split(',')[0];\n      const dateFormatted = formatDate(startTime).substring(dayName.length + 2);\n      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\n      const durationHours = constraints.durationHours || 1;\n      \n      const body = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\n      \n      console.log('\\nSending email...');\n      const messageId = sendEmail(from_email, 'Re: Meeting Request', body);\n      \n      if (messageId) {\n        console.log(`Email sent successfully. Message ID: ${messageId}`);\n        results.sent_results.push({ messageId });\n      } else {\n        console.log('Failed to send email');\n      }\n    } else {\n      console.log('No available slot found');\n    }\n  }\n  \n  // Save results\n  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\n  console.log('\\nResults saved to /root/results.json');\n}\n\nmain().catch(console.error);\nEOF\n"]
