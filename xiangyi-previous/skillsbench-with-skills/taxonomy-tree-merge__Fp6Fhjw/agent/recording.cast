[230.414214, "i", "python3 << 'EOF'\nimport pandas as pd\nfrom collections import Counter\n\ndf = pd.read_csv('/root/output/unified_taxonomy_hierarchy.csv')\n\n# Check L2 count per L1\nprint(\"L2 categories per L1:\")\nfor l1 in df['unified_level_1'].unique():\n    l2_cats = df[df['unified_level_1'] == l1]['unified_level_2'].dropna().unique()\n    l2_cats = [x for x in l2_cats if x]\n    print(f\"  {l1}: {len(l2_cats)} L2 categories\")\n\nprint(\"\\nSample L2 categories for 'Books | Media | Entertainment':\")\nbooks = df[df['unified_level_1'] == 'Books | Media | Entertainment']['unified_level_2'].dropna().unique()\nfor b in sorted([x for x in books if x])[:20]:\n    print(f\"  {b}\")\nEOF\n"]
