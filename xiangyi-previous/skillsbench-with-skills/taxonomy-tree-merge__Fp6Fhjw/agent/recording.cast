[74.787628, "o", "> "]
[74.787847, "o", "    # Religious & Ceremonial\r\n\u001b[?2004l\r"]
[74.787898, "o", "\u001b[?2004h> "]
[74.788484, "o", "    'Religious & Ceremonial': 'Religious | Ceremonial | Occasions',\r\n\u001b[?2004l\r"]
[74.788545, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[74.788582, "o", "\u001b[?2004h"]
[74.788649, "o", "> \r\n\u001b[?2004l\r"]
[74.788696, "o", "\u001b[?2004h> "]
[74.789022, "o", "# Default mapping for unmapped categories\r\n\u001b[?2004l\r"]
[74.789175, "o", "\u001b[?2004h> "]
[74.789319, "o", "def get_unified_level1(original_cat):\r\n\u001b[?2004l\r"]
[74.78937, "o", "\u001b[?2004h> "]
[74.789644, "o", "    \"\"\"Get unified level 1 category\"\"\"\r\n\u001b[?2004l\r"]
[74.789788, "o", "\u001b[?2004h> "]
[74.790002, "o", "    if original_cat in TOP_LEVEL_MAPPING:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.790052, "o", "> "]
[74.79031, "o", "        return TOP_LEVEL_MAPPING[original_cat]\r\n\u001b[?2004l\r"]
[74.790343, "o", "\u001b[?2004h> "]
[74.790462, "o", "    # Try partial matching\r\n\u001b[?2004l\r"]
[74.790497, "o", "\u001b[?2004h> "]
[74.79076, "o", "    original_lower = original_cat.lower()\r\n\u001b[?2004l\r"]
[74.790814, "o", "\u001b[?2004h"]
[74.790935, "o", "> "]
[74.791178, "o", "    if 'sport' in original_lower or 'outdoor' in original_lower or 'fitness' in original_lower:\r\n\u001b[?2004l\r"]
[74.791222, "o", "\u001b[?2004h"]
[74.791256, "o", "> "]
[74.79145, "o", "        return 'Sports | Outdoors | Recreation'\r\n\u001b[?2004l\r"]
[74.791488, "o", "\u001b[?2004h> "]
[74.791869, "o", "    if 'home' in original_lower or 'garden' in original_lower or 'furniture' in original_lower or 'kitchen' in original_lower:\r\n\u001b[?2004l\r"]
[74.79191, "o", "\u001b[?2004h> "]
[74.792056, "o", "        return 'Home | Garden | Living'\r\n\u001b[?2004l\r"]
[74.792091, "o", "\u001b[?2004h> "]
[74.792351, "o", "    if 'tool' in original_lower or 'hardware' in original_lower or 'improvement' in original_lower:\r\n\u001b[?2004l\r"]
[74.792398, "o", "\u001b[?2004h> "]
[74.792521, "o", "        return 'Hardware | Tools | Building'\r\n\u001b[?2004l\r"]
[74.792555, "o", "\u001b[?2004h> "]
[74.792865, "o", "    if 'electron' in original_lower or 'computer' in original_lower or 'phone' in original_lower or 'camera' in original_lower:\r\n\u001b[?2004l\r"]
[74.792902, "o", "\u001b[?2004h> "]
[74.793027, "o", "        return 'Electronics | Technology'\r\n\u001b[?2004l\r"]
[74.793069, "o", "\u001b[?2004h> "]
[74.793545, "o", "    if 'book' in original_lower or 'media' in original_lower or 'music' in original_lower or 'movie' in original_lower or 'art' in original_lower or 'entertainment' in original_lower:\r\n\u001b[?2004l\r"]
[74.793584, "o", "\u001b[?2004h> "]
[74.793703, "o", "        return 'Books | Media | Entertainment'\r\n\u001b[?2004l\r"]
[74.793747, "o", "\u001b[?2004h> "]
[74.794027, "o", "    if 'health' in original_lower or 'beauty' in original_lower or 'personal' in original_lower:\r\n\u001b[?2004l\r"]
[74.794059, "o", "\u001b[?2004h> "]
[74.794184, "o", "        return 'Health | Beauty | Personal Care'\r\n\u001b[?2004l\r"]
[74.794221, "o", "\u001b[?2004h> "]
[74.794469, "o", "    if 'food' in original_lower or 'beverage' in original_lower or 'grocery' in original_lower:\r\n\u001b[?2004l\r"]
[74.794508, "o", "\u001b[?2004h> "]
[74.794627, "o", "        return 'Food | Beverages | Grocery'\r\n\u001b[?2004l\r"]
[74.794657, "o", "\u001b[?2004h> "]
[74.795052, "o", "    if 'cloth' in original_lower or 'apparel' in original_lower or 'fashion' in original_lower or 'shoe' in original_lower or 'jewelry' in original_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.795171, "o", "        return 'Clothing | Fashion | Accessories'\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.795214, "o", "> "]
[74.795366, "o", "    if 'toy' in original_lower or 'game' in original_lower or 'hobby' in original_lower:\r\n\u001b[?2004l\r"]
[74.795407, "o", "\u001b[?2004h> "]
[74.79549, "o", "        return 'Toys | Games | Hobbies'\r\n\u001b[?2004l\r"]
[74.79552, "o", "\u001b[?2004h> "]
[74.795723, "o", "    if 'auto' in original_lower or 'vehicle' in original_lower or 'car' in original_lower:\r\n\u001b[?2004l\r"]
[74.795763, "o", "\u001b[?2004h> "]
[74.795865, "o", "        return 'Automotive | Vehicles | Parts'\r\n\u001b[?2004l\r"]
[74.795894, "o", "\u001b[?2004h> "]
[74.796071, "o", "    if 'baby' in original_lower or 'kid' in original_lower or 'toddler' in original_lower:\r\n\u001b[?2004l\r"]
[74.796098, "o", "\u001b[?2004h> "]
[74.796181, "o", "        return 'Baby | Kids | Maternity'\r\n\u001b[?2004l\r"]
[74.796207, "o", "\u001b[?2004h> "]
[74.796338, "o", "    if 'pet' in original_lower or 'animal' in original_lower:\r\n\u001b[?2004l\r"]
[74.796376, "o", "\u001b[?2004h> "]
[74.796486, "o", "        return 'Pets | Animals | Supplies'\r\n\u001b[?2004l\r"]
[74.796515, "o", "\u001b[?2004h> "]
[74.796842, "o", "    if 'business' in original_lower or 'industrial' in original_lower or 'office' in original_lower or 'scientific' in original_lower:\r\n\u001b[?2004l\r"]
[74.796888, "o", "\u001b[?2004h"]
[74.796914, "o", "> "]
[74.79702, "o", "        return 'Business | Industrial | Office'\r\n\u001b[?2004l\r"]
[74.797056, "o", "\u001b[?2004h> "]
[74.797206, "o", "    if 'mature' in original_lower or 'adult' in original_lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.797233, "o", "> "]
[74.797298, "o", "        return 'Adult | Mature Products'\r\n\u001b[?2004l\r"]
[74.797327, "o", "\u001b[?2004h> "]
[74.797504, "o", "    if 'religious' in original_lower or 'ceremonial' in original_lower:\r\n\u001b[?2004l\r"]
[74.797544, "o", "\u001b[?2004h> "]
[74.797678, "o", "        return 'Religious | Ceremonial | Occasions'\r\n\u001b[?2004l\r"]
[74.797704, "o", "\u001b[?2004h> "]
[74.797742, "o", "    # Default fallback\r\n\u001b[?2004l\r"]
[74.797771, "o", "\u001b[?2004h> "]
[74.797881, "o", "    return 'Other | Miscellaneous'\r\n\u001b[?2004l\r"]
[74.797905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.797949, "o", "\u001b[?2004h> "]
[74.797991, "o", "# Process each source\r\n\u001b[?2004l\r"]
[74.798024, "o", "\u001b[?2004h> "]
[74.798097, "o", "def process_source(df, source_name):\r\n\u001b[?2004l\r"]
[74.798121, "o", "\u001b[?2004h> "]
[74.798265, "o", "    \"\"\"Process a dataframe and extract category information\"\"\"\r\n\u001b[?2004l\r"]
[74.798295, "o", "\u001b[?2004h> "]
[74.798339, "o", "    records = []\r\n\u001b[?2004l\r"]
[74.798379, "o", "\u001b[?2004h> "]
[74.798458, "o", "    for idx, row in df.iterrows():\r\n\u001b[?2004l\r"]
[74.798482, "o", "\u001b[?2004h> "]
[74.798572, "o", "        path = row['category_path']\r\n\u001b[?2004l\r"]
[74.798598, "o", "\u001b[?2004h> "]
[74.798694, "o", "        levels = parse_category_path(path)\r\n\u001b[?2004l\r"]
[74.798727, "o", "\u001b[?2004h> "]
[74.798782, "o", "        if levels:\r\n\u001b[?2004l\r"]
[74.798815, "o", "\u001b[?2004h> "]
[74.798886, "o", "            records.append({\r\n\u001b[?2004l\r"]
[74.798914, "o", "\u001b[?2004h> "]
[74.799001, "o", "                'source': source_name,\r\n\u001b[?2004l\r"]
[74.799025, "o", "\u001b[?2004h> "]
[74.799103, "o", "                'category_path': path,\r\n\u001b[?2004l\r"]
[74.799129, "o", "\u001b[?2004h> "]
[74.799203, "o", "                'levels': levels,\r\n\u001b[?2004l\r"]
[74.79924, "o", "\u001b[?2004h> "]
[74.799305, "o", "                'depth': len(levels)\r\n\u001b[?2004l\r"]
[74.799333, "o", "\u001b[?2004h> "]
[74.799366, "o", "            })\r\n\u001b[?2004l\r"]
[74.799399, "o", "\u001b[?2004h> "]
[74.79945, "o", "    return records\r\n\u001b[?2004l\r"]
[74.799476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.799506, "o", "\u001b[?2004h> "]
[74.799585, "o", "print(\"\\nProcessing sources...\")\r\n\u001b[?2004l\r"]
[74.79961, "o", "\u001b[?2004h> "]
[74.799758, "o", "amazon_records = process_source(amazon_df, 'amazon')\r\n\u001b[?2004l\r"]
[74.799789, "o", "\u001b[?2004h> "]
[74.799903, "o", "fb_records = process_source(fb_df, 'facebook')\r\n\u001b[?2004l\r"]
[74.799946, "o", "\u001b[?2004h> "]
[74.800079, "o", "google_records = process_source(google_df, 'google')\r\n\u001b[?2004l\r"]
[74.800105, "o", "\u001b[?2004h> "]
[74.800131, "o", "\r\n\u001b[?2004l\r"]
[74.800155, "o", "\u001b[?2004h> "]
[74.800302, "o", "all_records = amazon_records + fb_records + google_records\r\n\u001b[?2004l\r"]
[74.800335, "o", "\u001b[?2004h> "]
[74.800465, "o", "print(f\"Total records: {len(all_records)}\")\r\n\u001b[?2004l\r"]
[74.80051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.800534, "o", "\u001b[?2004h> "]
[74.800626, "o", "# Build hierarchical structure\r\n\u001b[?2004l\r"]
[74.80066, "o", "\u001b[?2004h> "]
[74.800777, "o", "print(\"\\nBuilding unified taxonomy...\")\r\n\u001b[?2004l\r"]
[74.800827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.80086, "o", "\u001b[?2004h> "]
[74.801088, "o", "# Collect all unique paths at each level within each unified L1\r\n\u001b[?2004l\r"]
[74.801124, "o", "\u001b[?2004h> "]
[74.801422, "o", "hierarchy = defaultdict(lambda: defaultdict(lambda: defaultdict(lambda: defaultdict(set))))\r\n\u001b[?2004l\r"]
[74.801476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.801512, "o", "\u001b[?2004h> "]
[74.801601, "o", "for r in all_records:\r\n\u001b[?2004l\r"]
[74.801641, "o", "\u001b[?2004h"]
[74.801666, "o", "> "]
[74.801728, "o", "    levels = r['levels']\r\n\u001b[?2004l\r"]
[74.801769, "o", "\u001b[?2004h"]
[74.801793, "o", "> "]
[74.801858, "o", "    if not levels:\r\n\u001b[?2004l\r"]
[74.801891, "o", "\u001b[?2004h"]
[74.801916, "o", "> "]
[74.802012, "o", "        continue\r\n\u001b[?2004l\r"]
[74.802042, "o", "\u001b[?2004h> "]
[74.806198, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.806271, "o", ">     # Get unified level 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.806314, "o", "> "]
[74.806409, "o", "    unified_l1 = get_unified_level1(levels[0])\r\n\u001b[?2004l\r"]
[74.806449, "o", "\u001b[?2004h> "]
[74.806482, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[74.806511, "o", "> "]
[74.80667, "o", "    # Use original levels 2-5 as basis for unified levels 2-5\r\n\u001b[?2004l\r"]
[74.8067, "o", "\u001b[?2004h> "]
[74.806842, "o", "    l2 = levels[1] if len(levels) > 1 else ''\r\n\u001b[?2004l\r"]
[74.806876, "o", "\u001b[?2004h> "]
[74.807, "o", "    l3 = levels[2] if len(levels) > 2 else ''\r\n\u001b[?2004l\r"]
[74.807035, "o", "\u001b[?2004h> "]
[74.807148, "o", "    l4 = levels[3] if len(levels) > 3 else ''\r\n\u001b[?2004l\r"]
[74.807188, "o", "\u001b[?2004h> "]
[74.807322, "o", "    l5 = levels[4] if len(levels) > 4 else ''\r\n\u001b[?2004l\r"]
[74.807384, "o", "\u001b[?2004h> "]
[74.807417, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.807463, "o", "    if l2:\r\n\u001b[?2004l\r"]
[74.80749, "o", "\u001b[?2004h> "]
[74.807648, "o", "        hierarchy[unified_l1][l2][l3][l4].add(l5 if l5 else '')\r\n\u001b[?2004l\r"]
[74.807677, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.80771, "o", "\u001b[?2004h> "]
