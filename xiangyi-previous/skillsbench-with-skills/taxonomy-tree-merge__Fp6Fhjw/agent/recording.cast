[170.563916, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Create output records\nprint(\"\\nGenerating output...\")\noutput_full = []\nhierarchy_set = set()\n\nfor r in all_records:\n    lvls = r['levels']\n    u1 = get_unified_l1(lvls[0])\n    \n    # Get original levels\n    l2_orig = lvls[1] if len(lvls) > 1 else ''\n    l3_orig = lvls[2] if len(lvls) > 2 else ''\n    l4_orig = lvls[3] if len(lvls) > 3 else ''\n    l5_orig = lvls[4] if len(lvls) > 4 else ''\n    \n    # Map to unified\n    u2 = l2_map.get((u1, l2_orig), l2_orig) if l2_orig else ''\n    u3 = l3_map.get((u1, u2, l3_orig), l3_orig) if l3_orig else ''\n    u4 = l4_map.get((u1, u2, u3, l4_orig), l4_orig) if l4_orig else ''\n    u5 = l5_map.get((u1, u2, u3, u4, l5_orig), l5_orig) if l5_orig else ''\n    \n    depth = len([x for x in [u1, u2, u3, u4, u5] if x])\n    \n    output_full.append({\n        'source': r['source'],\n        'category_path': r['path'],\n        'depth': depth,\n        'unified_level_1': u1,\n        'unified_level_2': u2,\n        'unified_level_3': u3,\n        'unified_level_4': u4,\n        'unified_level_5': u5\n    })\n    \n    hierarchy_set.add((u1, u2, u3, u4, u5))\nEOF\n"]
