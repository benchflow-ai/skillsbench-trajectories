 'shelf'],\n        'Kitchen | Dining': ['kitchen', 'dining', 'cookware', 'bakeware', 'tableware', 'utensil', 'appliance', 'coffee', 'food storage'],\n        'Bedding | Bath': ['bedding', 'bath', 'towel', 'sheet', 'pillow', 'blanket', 'comforter', 'shower', 'bathroom'],\n        'Garden | Outdoor': ['garden', 'outdoor', 'patio', 'lawn', 'plant', 'flower', 'grill', 'pool'],\n        'Home Decor': ['decor', 'decoration', 'art', 'mirror', 'frame', 'vase', 'candle', 'rug', 'curtain'],\n        'Lighting': ['light', 'lamp', 'chandelier', 'bulb', 'fixture'],\n        'Storage | Organization': ['storage', 'organization', 'closet', 'basket', 'bin', 'container', 'rack'],\n        'Cleaning Supplies': ['clean', 'vacuum', 'mop', 'broom', 'laundry', 'detergent'],\n        'Home Appliances': ['appliance', 'washer', 'dryer', 'refrigerator', 'dishwasher', 'microwave', 'oven'],\n    },\n}\nEOF\n"]
