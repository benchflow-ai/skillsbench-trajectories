[341.284602, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Write output files\nimport os\nos.makedirs('/root/output', exist_ok=True)\n\nprint(\"Writing unified_taxonomy_full.csv...\")\ndf_full = pd.DataFrame(output_full)\ndf_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\nprint(f\"  Wrote {len(df_full)} rows\")\n\nprint(\"Writing unified_taxonomy_hierarchy.csv...\")\nhierarchy_list = [{'unified_level_1': h[0], 'unified_level_2': h[1], \n                   'unified_level_3': h[2], 'unified_level_4': h[3],\n                   'unified_level_5': h[4]} for h in sorted(hierarchy_set)]\ndf_hier = pd.DataFrame(hierarchy_list)\ndf_hier.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\nprint(f\"  Wrote {len(df_hier)} rows\")\n\n# Summary\nprint(\"\\n=== Summary ===\")\nprint(f\"Records by source:\")\nfor src in ['amazon', 'facebook', 'google']:\n    cnt = sum(1 for r in output_full if r['source'] == src)\n    print(f\"  {src}: {cnt}\")\n\nprint(f\"\\nL1 distribution:\")\nl1_counts = Counter(r['unified_level_1'] for r in output_full)\nfor l1, cnt in l1_counts.most_common():\n    print(f\"  {l1}: {cnt}\")\n\nprint(f\"\\nL2 per L1:\")\nfor l1 in sorted(l1_counts.keys()):\n    l2s = set(r['unified_level_2'] for r in output_full if r['unified_level_1'] == l1 and r['unified_level_2'])\n    print(f\"  {l1}: {len(l2s)} L2 categories\")\n\nprint(\"\\nDone!\")\nEOF\n"]
