[271.216586, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# L1 mapping with keyword matching\nL1_KEYWORDS = {\n    'Sports | Outdoors | Recreation': ['sport', 'outdoor', 'fitness', 'cycling', 'camping', 'hunting', 'fishing', 'exercise', 'athletic', 'recreation', 'golf', 'tennis', 'soccer', 'basketball', 'baseball', 'swimming', 'hiking', 'climbing', 'boating'],\n    'Home | Garden | Living': ['home', 'garden', 'furniture', 'kitchen', 'patio', 'lawn', 'bedding', 'bath', 'decor', 'lighting', 'dining', 'living', 'bedroom', 'storage', 'organization', 'appliance', 'cookware', 'tableware'],\n    'Hardware | Tools | Building': ['tool', 'hardware', 'improvement', 'building', 'plumbing', 'electrical', 'paint', 'lumber', 'construction', 'fastener', 'power tool'],\n    'Electronics | Technology': ['electron', 'computer', 'phone', 'camera', 'software', 'optic', 'audio', 'video', 'tv', 'television', 'tablet', 'laptop', 'printer', 'network', 'gps', 'wearable', 'smart'],\n    'Books | Media | Entertainment': ['book', 'media', 'music', 'movie', 'art', 'entertainment', 'instrument', 'dvd', 'cd', 'vinyl', 'magazine', 'comic', 'novel', 'literature', 'reading', 'craft', 'hobby', 'party', 'event'],\n    'Health | Beauty | Personal Care': ['health', 'beauty', 'personal', 'care', 'household', 'medical', 'wellness', 'vitamin', 'supplement', 'cosmetic', 'skincare', 'haircare', 'oral', 'hygiene', 'first aid', 'pharmacy'],\n    'Food | Beverages | Grocery': ['food', 'beverage', 'grocery', 'gourmet', 'tobacco', 'snack', 'drink', 'coffee', 'tea', 'wine', 'beer', 'alcohol', 'meat', 'dairy', 'produce', 'bakery', 'candy'],\n    'Clothing | Fashion | Accessories': ['cloth', 'apparel', 'fashion', 'shoe', 'jewelry', 'luggage', 'accessori', 'handbag', 'watch', 'eyewear', 'costume', 'uniform', 'dress', 'shirt', 'pants', 'jacket'],\n    'Toys | Games | Hobbies': ['toy', 'game', 'hobby', 'puzzle', 'doll', 'action figure', 'board game', 'video game', 'lego', 'model', 'collectible', 'rc', 'remote control'],\n    'Automotive | Vehicles | Parts': ['auto', 'vehicle', 'car', 'motor', 'truck', 'motorcycle', 'boat', 'rv', 'trailer', 'tire', 'engine', 'brake', 'transmission'],\n    'Baby | Kids | Maternity': ['baby', 'kid', 'toddler', 'infant', 'maternity', 'nursery', 'diaper', 'stroller', 'car seat', 'child'],\n    'Pets | Animals | Supplies': ['pet', 'animal', 'dog', 'cat', 'bird', 'fish', 'reptile', 'horse', 'aquarium', 'terrarium'],\n    'Business | Industrial | Office': ['business', 'industrial', 'office', 'scientific', 'lab', 'commercial', 'professional', 'janitorial', 'safety', 'shipping', 'packaging'],\n    'Adult | Mature Products': ['mature', 'adult', 'erotic', 'weapon', 'gun', 'ammunition'],\n    'Religious | Ceremonial | Occasions': ['religious', 'ceremonial', 'worship', 'memorial', 'funeral', 'wedding'],\n}\n\ndef get_unified_l1(cat):\n    cat_lower = cat.lower()\n    for unified, keywords in L1_KEYWORDS.items():\n        if any(kw in cat_lower for kw in keywords):\n            return unified\n    return 'Other | Miscellaneous'\nEOF\n"]
