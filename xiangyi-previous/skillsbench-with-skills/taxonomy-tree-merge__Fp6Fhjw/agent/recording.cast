[170.068924, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Build clustering at each level\nprint(\"Clustering L2...\")\nl2_map = {}  # (l1, orig_l2) -> unified_l2\nfor l1, cats in l1_l2.items():\n    clusters = cluster_cats(cats, max_clusters=18)\n    for orig, rep in clusters.items():\n        l2_map[(l1, orig)] = rep\n\nprint(\"Clustering L3...\")\nl3_map = {}\nfor (l1, l2), cats in l1l2_l3.items():\n    ul2 = l2_map.get((l1, l2), l2)\n    clusters = cluster_cats(cats, max_clusters=18)\n    for orig, rep in clusters.items():\n        l3_map[(l1, ul2, orig)] = rep\n\nprint(\"Clustering L4...\")\nl4_map = {}\nfor (l1, l2, l3), cats in l1l2l3_l4.items():\n    ul2 = l2_map.get((l1, l2), l2)\n    ul3 = l3_map.get((l1, ul2, l3), l3)\n    clusters = cluster_cats(cats, max_clusters=18)\n    for orig, rep in clusters.items():\n        l4_map[(l1, ul2, ul3, orig)] = rep\n\nprint(\"Clustering L5...\")\nl5_map = {}\nfor (l1, l2, l3, l4), cats in l1l2l3l4_l5.items():\n    ul2 = l2_map.get((l1, l2), l2)\n    ul3 = l3_map.get((l1, ul2, l3), l3)\n    ul4 = l4_map.get((l1, ul2, ul3, l4), l4)\n    clusters = cluster_cats(cats, max_clusters=18)\n    for orig, rep in clusters.items():\n        l5_map[(l1, ul2, ul3, ul4, orig)] = rep\nEOF\n"]
