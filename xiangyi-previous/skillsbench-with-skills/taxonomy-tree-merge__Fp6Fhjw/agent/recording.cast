[340.168067, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Default L2 mappings for categories without specific rules\nL2_MAPPINGS['Adult | Mature Products'] = {\n    'Adult Content': ['erotic', 'adult', 'mature'],\n    'Weapons': ['weapon', 'gun', 'knife', 'ammunition', 'firearm'],\n}\n\nL2_MAPPINGS['Religious | Ceremonial | Occasions'] = {\n    'Religious Items': ['religious', 'spiritual', 'worship', 'prayer'],\n    'Ceremonial': ['ceremonial', 'memorial', 'funeral'],\n    'Wedding': ['wedding', 'bridal', 'marriage'],\n}\n\nL2_MAPPINGS['Other | Miscellaneous'] = {\n    'General': ['general', 'other', 'miscellaneous'],\n}\n\ndef get_unified_l2(l1, category_text):\n    \"\"\"Map a category to unified L2 based on L1 and keywords\"\"\"\n    if l1 not in L2_MAPPINGS:\n        return category_text  # Keep original if no mapping\n    \n    cat_lower = category_text.lower()\n    mappings = L2_MAPPINGS[l1]\n    \n    for unified_l2, keywords in mappings.items():\n        if any(kw in cat_lower for kw in keywords):\n            return unified_l2\n    \n    # Default: return first available or 'General'\n    return list(mappings.keys())[0] if mappings else category_text\nEOF\n"]
[340.168539, "o", "cat >> /root/unify_taxonomy.py << 'EOF'\r\n\u001b[?2004l\r"]
