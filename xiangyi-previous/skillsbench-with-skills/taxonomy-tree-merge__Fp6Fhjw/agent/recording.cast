[440.418065, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Generate output\nprint(\"\\nGenerating output...\")\noutput_full = []\nhierarchy_set = set()\n\nfor r in all_records:\n    lvls = r['levels']\n    u1 = get_unified_l1(lvls[0])\n    \n    # Get unified levels\n    orig_l2 = lvls[1] if len(lvls) > 1 else ''\n    u2 = l2_clusters.get((u1, orig_l2), orig_l2) if orig_l2 else ''\n    \n    orig_l3 = lvls[2] if len(lvls) > 2 else ''\n    u3 = l3_clusters.get((u1, u2, orig_l3), orig_l3) if orig_l3 else ''\n    \n    orig_l4 = lvls[3] if len(lvls) > 3 else ''\n    u4 = l4_clusters.get((u1, u2, u3, orig_l4), orig_l4) if orig_l4 else ''\n    \n    orig_l5 = lvls[4] if len(lvls) > 4 else ''\n    u5 = l5_clusters.get((u1, u2, u3, u4, orig_l5), orig_l5) if orig_l5 else ''\n    \n    depth = len([x for x in [u1, u2, u3, u4, u5] if x])\n    \n    output_full.append({\n        'source': r['source'],\n        'category_path': r['path'],\n        'depth': depth,\n        'unified_level_1': u1,\n        'unified_level_2': u2,\n        'unified_level_3': u3,\n        'unified_level_4': u4,\n        'unified_level_5': u5\n    })\n    \n    hierarchy_set.add((u1, u2, u3, u4, u5))\nEOF\n"]
