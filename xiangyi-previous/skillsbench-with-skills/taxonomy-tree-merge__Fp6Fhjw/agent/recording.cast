[398.435377, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Process records first to collect all L2 categories per L1\nprint(\"Processing records...\")\nall_records = []\nfor df, src in [(amazon_df, 'amazon'), (fb_df, 'facebook'), (google_df, 'google')]:\n    for _, row in df.iterrows():\n        levels = parse_path(row['category_path'])\n        if levels:\n            all_records.append({'source': src, 'path': row['category_path'], 'levels': levels})\n\nprint(f\"Total: {len(all_records)} records\")\n\n# Collect L2 categories per L1\nl1_to_l2s = defaultdict(Counter)\nfor r in all_records:\n    lvls = r['levels']\n    u1 = get_unified_l1(lvls[0])\n    if len(lvls) > 1:\n        l1_to_l2s[u1][lvls[1]] += 1\n\nprint(f\"\\nL1 categories: {len(l1_to_l2s)}\")\nfor l1, l2_counter in sorted(l1_to_l2s.items()):\n    print(f\"  {l1}: {len(l2_counter)} unique L2s\")\nEOF\n"]
