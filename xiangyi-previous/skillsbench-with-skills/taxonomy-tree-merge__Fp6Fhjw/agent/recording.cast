[169.580948, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Process all records\nprint(\"Processing records...\")\nall_records = []\nfor df, src in [(amazon_df, 'amazon'), (fb_df, 'facebook'), (google_df, 'google')]:\n    for _, row in df.iterrows():\n        levels = parse_path(row['category_path'])\n        if levels:\n            all_records.append({'source': src, 'path': row['category_path'], 'levels': levels})\n\nprint(f\"Total: {len(all_records)} records\")\n\n# Collect categories at each level\nl1_l2 = defaultdict(set)\nl1l2_l3 = defaultdict(set)\nl1l2l3_l4 = defaultdict(set)\nl1l2l3l4_l5 = defaultdict(set)\n\nfor r in all_records:\n    lvls = r['levels']\n    u1 = get_unified_l1(lvls[0])\n    l2 = lvls[1] if len(lvls) > 1 else None\n    l3 = lvls[2] if len(lvls) > 2 else None\n    l4 = lvls[3] if len(lvls) > 3 else None\n    l5 = lvls[4] if len(lvls) > 4 else None\n    \n    if l2: l1_l2[u1].add(l2)\n    if l2 and l3: l1l2_l3[(u1, l2)].add(l3)\n    if l2 and l3 and l4: l1l2l3_l4[(u1, l2, l3)].add(l4)\n    if l2 and l3 and l4 and l5: l1l2l3l4_l5[(u1, l2, l3, l4)].add(l5)\n\nprint(f\"L1 categories: {len(l1_l2)}\")\nEOF\n"]
