,\n    'Shipping | Packaging': ['shipping', 'packaging', 'box', 'tape', 'label', 'pallet'],\n    'Medical | Healthcare': ['medical', 'healthcare', 'hospital', 'clinic', 'dental'],\n}\n\nL2_MAPPINGS['Hardware | Tools | Building'] = {\n    'Power Tools': ['power tool', 'drill', 'saw', 'sander', 'grinder'],\n    'Hand Tools': ['hand tool', 'hammer', 'screwdriver', 'wrench', 'plier'],\n    'Plumbing': ['plumbing', 'pipe', 'faucet', 'valve', 'toilet', 'sink'],\n    'Electrical': ['electrical', 'wire', 'outlet', 'switch', 'breaker', 'conduit'],\n    'Paint | Supplies': ['paint', 'brush', 'roller', 'primer', 'stain'],\n    'Building Materials': ['building', 'lumber', 'drywall', 'insulation', 'roofing'],\n    'Fasteners | Hardware': ['fastener', 'screw', 'nail', 'bolt', 'nut', 'anchor'],\n    'HVAC': ['hvac', 'heating', 'cooling', 'air conditioning', 'ventilation', 'furnace'],\n    'Doors | Windows': ['door', 'window', 'lock', 'handle', 'hinge'],\n}\nEOF\n"]
