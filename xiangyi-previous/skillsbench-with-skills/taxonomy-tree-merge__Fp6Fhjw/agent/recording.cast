[340.169049, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.16912, "o", "L2_MAPPINGS['Religious | Ceremonial | Occasions'] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.169248, "o", "    'Religious Items': ['religious', 'spiritual', 'worship', 'prayer'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
