[148.739343, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# L1 mapping rules\nL1_RULES = [\n    (['sport', 'outdoor', 'fitness', 'cycling', 'camping', 'hunting', 'fishing'], 'Sports | Outdoors | Recreation'),\n    (['home', 'garden', 'furniture', 'kitchen', 'patio', 'lawn', 'bedding', 'bath'], 'Home | Garden | Living'),\n    (['tool', 'hardware', 'improvement', 'building'], 'Hardware | Tools | Building'),\n    (['electron', 'computer', 'phone', 'camera', 'software', 'optic'], 'Electronics | Technology'),\n    (['book', 'media', 'music', 'movie', 'art', 'entertainment', 'instrument'], 'Books | Media | Entertainment'),\n    (['health', 'beauty', 'personal', 'care', 'household'], 'Health | Beauty | Personal Care'),\n    (['food', 'beverage', 'grocery', 'gourmet', 'tobacco'], 'Food | Beverages | Grocery'),\n    (['cloth', 'apparel', 'fashion', 'shoe', 'jewelry', 'luggage', 'accessori'], 'Clothing | Fashion | Accessories'),\n    (['toy', 'game', 'hobby'], 'Toys | Games | Hobbies'),\n    (['auto', 'vehicle', 'car', 'motor'], 'Automotive | Vehicles | Parts'),\n    (['baby', 'kid', 'toddler', 'infant', 'maternity'], 'Baby | Kids | Maternity'),\n    (['pet', 'animal'], 'Pets | Animals | Supplies'),\n    (['business', 'industrial', 'office', 'scientific'], 'Business | Industrial | Office'),\n    (['mature', 'adult'], 'Adult | Mature Products'),\n    (['religious', 'ceremonial'], 'Religious | Ceremonial | Occasions'),\n]\n\ndef get_unified_l1(cat):\n    cat_lower = cat.lower()\n    for keywords, unified in L1_RULES:\n        if any(kw in cat_lower for kw in keywords):\n            return unified\n    return 'Other | Miscellaneous'\nEOF\n"]
