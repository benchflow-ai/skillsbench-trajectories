[482.020935, "i", "python3 << 'EOF'\nimport pandas as pd\nfrom collections import Counter\n\ndf = pd.read_csv('/root/output/unified_taxonomy_full.csv')\n\n# Check source distribution per L1\nprint(\"Source distribution per L1:\")\nfor l1 in sorted(df['unified_level_1'].unique()):\n    l1_df = df[df['unified_level_1'] == l1]\n    src_counts = l1_df['source'].value_counts().to_dict()\n    total = len(l1_df)\n    print(f\"\\n{l1} (total: {total}):\")\n    for src in ['amazon', 'facebook', 'google']:\n        cnt = src_counts.get(src, 0)\n        pct = cnt/total*100 if total > 0 else 0\n        print(f\"  {src}: {cnt} ({pct:.1f}%)\")\nEOF\n"]
