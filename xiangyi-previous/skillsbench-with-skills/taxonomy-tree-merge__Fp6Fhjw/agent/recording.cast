[75.887659, "o", "/root/unify_taxonomy.py:1: DeprecationWarning: \r\nPyarrow will become a required dependency of pandas in the next major release of pandas (pandas 3.0),\r\n(to allow more performant data types, such as the Arrow string type, and better interoperability with other libraries)\r\nbut was not found to be installed on your system.\r\nIf this would cause problems for you,\r\nplease provide us feedback at https://github.com/pandas-dev/pandas/issues/54466\r\n        \r\n  import pandas as pd\r\nLoading data files...\r\n"]
[75.909469, "o", "Amazon: 2523 rows\r\nFacebook: 2967 rows\r\nGoogle: 5595 rows\r\n\r\nProcessing sources...\r\n"]
[76.473858, "o", "Total records: 11085\r\n\r\nBuilding unified taxonomy...\r\n"]
[76.499938, "o", "\r\nUnified Level 1 categories: 16\r\n  Adult | Mature Products: 2 L2 categories\r\n  Automotive | Vehicles | Parts: 14 L2 categories\r\n  Baby | Kids | Maternity: 32 L2 categories\r\n  Books | Media | Entertainment: 85 L2 categories\r\n  Business | Industrial | Office: 80 L2 categories\r\n  Clothing | Fashion | Accessories: 21 L2 categories\r\n  Electronics | Technology: 48 L2 categories\r\n  Food | Beverages | Grocery: 18 L2 categories\r\n"]
[76.500023, "o", "  Hardware | Tools | Building: 32 L2 categories\r\n  Health | Beauty | Personal Care: 22 L2 categories\r\n  Home | Garden | Living: 83 L2 categories\r\n  Other | Miscellaneous: 29 L2 categories\r\n  Pets | Animals | Supplies: 19 L2 categories\r\n  Religious | Ceremonial | Occasions: 3 L2 categories\r\n  Sports | Outdoors | Recreation: 9 L2 categories\r\n  Toys | Games | Hobbies: 40 L2 categories\r\n"]
[76.630793, "o", "\u001b[?2004hroot@4af5b017183c:~# "]
[148.231533, "i", "cat > /root/unify_taxonomy.py << 'EOF'\nimport pandas as pd\nimport re\nfrom collections import defaultdict, Counter\n\n# Load data\nprint(\"Loading data...\")\namazon_df = pd.read_csv('/root/data/amazon_product_categories.csv')\nfb_df = pd.read_csv('/root/data/fb_product_categories.csv')\ngoogle_df = pd.read_csv('/root/data/google_shopping_product_categories.csv')\n\ndef clean_text(text):\n    if pd.isna(text): return \"\"\n    text = str(text).strip()\n    text = re.sub(r'\\s+', ' ', text)\n    return text.title().strip('\"\\' ')\n\ndef parse_path(path):\n    if pd.isna(path): return []\n    parts = str(path).split(' > ')\n    return [clean_text(p) for p in parts if p.strip()]\n\ndef get_words(text):\n    words = re.findall(r'\\b\\w+\\b', text.lower())\n    stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with'}\n    return set(w for w in words if w not in stops and len(w) > 1)\n\ndef word_overlap(t1, t2):\n    w1, w2 = get_words(t1), get_words(t2)\n    if not w1 or not w2: return 0\n    return len(w1 & w2) / len(w1 | w2)\nEOF\n"]
