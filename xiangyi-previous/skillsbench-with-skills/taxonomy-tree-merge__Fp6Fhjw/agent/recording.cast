[270.703523, "o", "    parts = str(path).split(' > ')\r\n\u001b[?2004l\r"]
[270.703552, "o", "\u001b[?2004h> "]
[270.70366, "o", "    return [clean_text(p) for p in parts if p.strip()]\r\n\u001b[?2004l\r"]
[270.703692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.70372, "o", "\u001b[?2004h"]
[270.709215, "o", "> "]
[270.709457, "o", "def get_words(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.7095, "o", "    words = re.findall(r'\\b\\w+\\b', text.lower())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.70956, "o", "    stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with', 'by'}\r\n\u001b[?2004l\r"]
[270.709598, "o", "\u001b[?2004h> "]
[270.709798, "o", "    return set(w for w in words if w not in stops and len(w) > 1)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
