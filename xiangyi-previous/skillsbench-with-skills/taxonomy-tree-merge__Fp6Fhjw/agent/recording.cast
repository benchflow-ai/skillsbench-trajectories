[397.440978, "o", "\u001b[?2004h> "]
[397.441029, "o", "    text = re.sub(r'\\s+', ' ', text)\r\n\u001b[?2004l\r"]
[397.441084, "o", "\u001b[?2004h> "]
[397.441151, "o", "    return text.title().strip('\"\\' ')\r\n\u001b[?2004l\r"]
[397.441203, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.441256, "o", "def parse_path(path):\r\n\u001b[?2004l\r"]
[397.441309, "o", "\u001b[?2004h> "]
[397.441364, "o", "    if pd.isna(path): return []\r\n\u001b[?2004l\r"]
[397.441503, "o", "\u001b[?2004h> "]
[397.441635, "o", "    parts = str(path).split(' > ')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.44172, "o", "    return [clean_text(p) for p in parts if p.strip()]\r\n\u001b[?2004l\r"]
[397.441785, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.441852, "o", "def get_words(text):\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.441911, "o", "> "]
[397.44282, "o", "    words = re.findall(r'\\b\\w+\\b', text.lower())\r\n\u001b[?2004l\r\u001b[?2004h>     stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with', 'by', 'products', 'supplies', 'items', 'goods'}\r\n\u001b[?2004l\r\u001b[?2004h>     return set(w for w in words if w not in stops and len(w) > 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def word_overlap(t1, t2):\r\n\u001b[?2004l\r\u001b[?2004h>     w1, w2 = get_words(t1), get_words(t2)\r\n\u001b[?2004l\r\u001b[?2004h>     if not w1 or not w2: return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.442949, "o", "    return len(w1 & w2) / len(w1 | w2)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
