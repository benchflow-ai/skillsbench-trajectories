[340.169732, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.169801, "o", "def get_unified_l2(l1, category_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.169891, "o", "    \"\"\"Map a category to unified L2 based on L1 and keywords\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[340.169975, "o", ">     if l1 not in L2_MAPPINGS:\r\n\u001b[?2004l\r"]
[340.170049, "o", "\u001b[?2004h> "]
[340.170121, "o", "        return category_text  # Keep original if no mapping\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[340.170191, "o", "\u001b[?2004h>     cat_lower = category_text.lower()\r\n\u001b[?2004l\r"]
[340.170259, "o", "\u001b[?2004h>     mappings = L2_MAPPINGS[l1]\r\n\u001b[?2004l\r"]
[340.170332, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.170408, "o", "    for unified_l2, keywords in mappings.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.170493, "o", "        if any(kw in cat_lower for kw in keywords):\r\n\u001b[?2004l\r\u001b[?2004h"]
[340.17056, "o", ">             return unified_l2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.170631, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.170704, "o", "    # Default: return first available or 'General'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[340.170797, "o", "    return list(mappings.keys())[0] if mappings else category_text\r\n\u001b[?2004l\r\u001b[?2004h> "]
