[148.745124, "o", "\u001b[?2004hroot@4af5b017183c:~# "]
[149.191165, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\ndef cluster_cats(cats, max_clusters=15):\n    \"\"\"Cluster categories by word similarity\"\"\"\n    if len(cats) <= max_clusters:\n        return {c: c for c in cats}\n    \n    cat_list = sorted(cats, key=lambda x: -len(x))  # Start with longer names\n    clusters = {}\n    reps = []\n    \n    for cat in cat_list:\n        best_match, best_score = None, 0\n        for rep in reps:\n            score = word_overlap(cat, rep)\n            if score > best_score and score > 0.25:\n                best_score, best_match = score, rep\n        \n        if best_match and len(reps) >= 3:\n            clusters[cat] = best_match\n        else:\n            reps.append(cat)\n            clusters[cat] = cat\n            if len(reps) >= max_clusters:\n                for rem in cat_list:\n                    if rem not in clusters:\n                        best = max(reps, key=lambda r: word_overlap(rem, r))\n                        clusters[rem] = best\n                break\n    return clusters\n\ndef make_name(cats, max_words=4):\n    \"\"\"Create unified name from category list\"\"\"\n    if not cats: return \"\"\n    word_cnt = Counter()\n    for c in cats:\n        word_cnt.update(get_words(c))\n    top = [w.title() for w, _ in word_cnt.most_common(max_words)]\n    return ' | '.join(top) if top else list(cats)[0]\nEOF\n"]
