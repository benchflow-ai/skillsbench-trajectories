[439.418003, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Cluster L2 categories only when > 20\ndef cluster_l2s(l2_counter, max_clusters=18, min_clusters=3):\n    \"\"\"Cluster L2 categories, keeping originals when possible\"\"\"\n    l2_list = list(l2_counter.keys())\n    \n    if len(l2_list) <= max_clusters:\n        return {l2: l2 for l2 in l2_list}  # Keep all originals\n    \n    # Sort by frequency (most common first as representatives)\n    sorted_l2s = sorted(l2_list, key=lambda x: -l2_counter[x])\n    \n    clusters = {}\n    reps = []\n    \n    for l2 in sorted_l2s:\n        if len(reps) < max_clusters:\n            # Check if similar to existing rep\n            best_match, best_score = None, 0\n            for rep in reps:\n                score = word_overlap(l2, rep)\n                if score > best_score and score > 0.4:\n                    best_score, best_match = score, rep\n            \n            if best_match:\n                clusters[l2] = best_match\n            else:\n                reps.append(l2)\n                clusters[l2] = l2\n        else:\n            # Assign to closest existing rep\n            best_match = max(reps, key=lambda r: word_overlap(l2, r))\n            clusters[l2] = best_match\n    \n    return clusters\n\n# Build L2 clustering for each L1\nprint(\"\\nClustering L2 categories...\")\nl2_clusters = {}  # {(l1, orig_l2): unified_l2}\n\nfor l1, l2_counter in l1_to_l2s.items():\n    clusters = cluster_l2s(l2_counter)\n    for orig, unified in clusters.items():\n        l2_clusters[(l1, orig)] = unified\n    print(f\"  {l1}: {len(l2_counter)} -> {len(set(clusters.values()))} L2s\")\nEOF\n"]
[439.425213, "o", "cat >> /root/unify_taxonomy.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Cluster L2 categories only when > 20\r\n\u001b[?2004l\r\u001b[?2004h> def cluster_l2s(l2_counter, max_clusters=18, min_clusters=3):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Cluster L2 categories, keeping originals when possible\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     l2_list = list(l2_counter.keys())\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if len(l2_list) <= max_clusters:\r\n\u001b[?2004l\r\u001b[?2004h>         return {l2: l2 for l2 in l2_list}  # Keep all originals\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort by frequency (most common first as representatives)\r\n\u001b[?2004l\r\u001b[?2004h>     sorted_l2s = sorted(l2_list, key=lambda x: -l2_counter[x])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     clusters = {}\r\n\u001b[?2004l\r\u001b[?2004h>     reps = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for l2 in sorted_l2s:\r\n\u001b[?2004l\r\u001b[?2004h>         if len(reps) < max_clusters:\r\n\u001b[?2004l\r\u001b[?2004h>             # Check if similar to existing rep\r\n\u001b[?2004l\r\u001b[?2004h>             best_match, best_score = None, 0\r\n\u001b[?2004l\r\u001b[?2004h>             for rep in reps:\r\n\u001b[?2004l\r\u001b[?2004h>                 score = word_overlap(l2, rep)\r\n\u001b[?2004l\r\u001b[?2004h>                 if score > best_score and score > 0.4:\r\n\u001b[?2004l\r\u001b[?2004h>                     best_score, best_match = score, rep\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             if best_match:\r\n\u001b[?2004l\r\u001b[?2004h>                 clusters[l2] = best_match\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 reps.append(l2)\r\n\u001b[?2004l\r\u001b[?2004h>                 clusters[l2] = l2\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             # Assign to closest existing rep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.425432, "o", "            best_match = max(reps, key=lambda r: word_overlap(l2, r))\r\n\u001b[?2004l\r\u001b[?2004h>             clusters[l2] = best_match\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.425532, "o", "    return clusters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.425627, "o", "# Build L2 clustering for each L1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.426075, "o", "print(\"\\nClustering L2 categories...\")\r\n\u001b[?2004l\r\u001b[?2004h> l2_clusters = {}  # {(l1, orig_l2): unified_l2}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for l1, l2_counter in l1_to_l2s.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.426215, "o", "    clusters = cluster_l2s(l2_counter)"]
[439.426478, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for orig, unified in clusters.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.426579, "o", "        l2_clusters[(l1, orig)] = unified\r\n\u001b[?2004l\r"]
[439.42665, "o", "\u001b[?2004h> "]
[439.428414, "o", "    print(f\"  {l1}: {len(l2_counter)} -> {len(set(clusters.values()))} L2s\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@4af5b017183c:~# "]
[439.898924, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Similarly cluster L3, L4, L5 within their parents\nprint(\"\\nCollecting L3-L5 categories...\")\nl2_to_l3s = defaultdict(Counter)\nl3_to_l4s = defaultdict(Counter)\nl4_to_l5s = defaultdict(Counter)\n\nfor r in all_records:\n    lvls = r['levels']\n    u1 = get_unified_l1(lvls[0])\n    \n    if len(lvls) > 1:\n        u2 = l2_clusters.get((u1, lvls[1]), lvls[1])\n        if len(lvls) > 2:\n            l2_to_l3s[(u1, u2)][lvls[2]] += 1\n            if len(lvls) > 3:\n                l3_to_l4s[(u1, u2, lvls[2])][lvls[3]] += 1\n                if len(lvls) > 4:\n                    l4_to_l5s[(u1, u2, lvls[2], lvls[3])][lvls[4]] += 1\n\n# Cluster L3s\nprint(\"Clustering L3...\")\nl3_clusters = {}\nfor (u1, u2), l3_counter in l2_to_l3s.items():\n    clusters = cluster_l2s(l3_counter, max_clusters=18)\n    for orig, unified in clusters.items():\n        l3_clusters[(u1, u2, orig)] = unified\n\n# Cluster L4s\nprint(\"Clustering L4...\")\nl4_clusters = {}\nfor (u1, u2, l3), l4_counter in l3_to_l4s.items():\n    u3 = l3_clusters.get((u1, u2, l3), l3)\n    clusters = cluster_l2s(l4_counter, max_clusters=18)\n    for orig, unified in clusters.items():\n        l4_clusters[(u1, u2, u3, orig)] = unified\n\n# Cluster L5s\nprint(\"Clustering L5...\")\nl5_clusters = {}\nfor (u1, u2, l3, l4), l5_counter in l4_to_l5s.items():\n    u3 = l3_clusters.get((u1, u2, l3), l3)\n    u4 = l4_clusters.get((u1, u2, u3, l4), l4)\n    clusters = cluster_l2s(l5_counter, max_clusters=18)\n    for orig, unified in clusters.items():\n        l5_clusters[(u1, u2, u3, u4, orig)] = unified\nEOF\n"]
