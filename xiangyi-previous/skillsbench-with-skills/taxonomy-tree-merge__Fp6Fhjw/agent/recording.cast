[440.424653, "o", "\u001b[?2004hroot@4af5b017183c:~# "]
[440.941592, "i", "cat >> /root/unify_taxonomy.py << 'EOF'\n\n# Write files\nimport os\nos.makedirs('/root/output', exist_ok=True)\n\nprint(\"Writing unified_taxonomy_full.csv...\")\ndf_full = pd.DataFrame(output_full)\ndf_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\nprint(f\"  Wrote {len(df_full)} rows\")\n\nprint(\"Writing unified_taxonomy_hierarchy.csv...\")\nhierarchy_list = [{'unified_level_1': h[0], 'unified_level_2': h[1], \n                   'unified_level_3': h[2], 'unified_level_4': h[3],\n                   'unified_level_5': h[4]} for h in sorted(hierarchy_set)]\ndf_hier = pd.DataFrame(hierarchy_list)\ndf_hier.to_csv('/root/output/unified_taxonomy_hierarchy.csv', index=False)\nprint(f\"  Wrote {len(df_hier)} rows\")\n\n# Summary stats\nprint(\"\\n=== SUMMARY ===\")\nprint(f\"Total records: {len(output_full)}\")\nprint(f\"Unique paths: {len(hierarchy_set)}\")\nprint(f\"\\nBy source:\")\nfor src in ['amazon', 'facebook', 'google']:\n    print(f\"  {src}: {sum(1 for r in output_full if r['source'] == src)}\")\n\nprint(f\"\\nL2 count per L1:\")\nfor l1 in sorted(set(r['unified_level_1'] for r in output_full)):\n    l2s = set(r['unified_level_2'] for r in output_full if r['unified_level_1'] == l1 and r['unified_level_2'])\n    print(f\"  {l1}: {len(l2s)}\")\n\nprint(\"\\nDone!\")\nEOF\n"]
[440.943091, "o", "cat >> /root/unify_taxonomy.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Write files\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/root/output', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Writing unified_taxonomy_full.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> df_full = pd.DataFrame(output_full)\r\n\u001b[?2004l\r\u001b[?2004h> df_full.to_csv('/root/output/unified_taxonomy_full.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Wrote {len(df_full)} rows\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Writing unified_taxonomy_hierarchy.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
