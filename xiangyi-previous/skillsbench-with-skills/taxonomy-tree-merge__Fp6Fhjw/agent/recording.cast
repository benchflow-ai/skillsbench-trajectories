[340.169446, "o", "    'Wedding': ['wedding', 'bridal', 'marriage'],\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[340.169519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
