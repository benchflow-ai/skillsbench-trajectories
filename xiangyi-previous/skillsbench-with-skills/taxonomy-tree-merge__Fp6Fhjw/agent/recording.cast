[270.701268, "i", "cat > /root/unify_taxonomy.py << 'EOF'\nimport pandas as pd\nimport re\nfrom collections import defaultdict, Counter\n\nprint(\"Loading data...\")\namazon_df = pd.read_csv('/root/data/amazon_product_categories.csv')\nfb_df = pd.read_csv('/root/data/fb_product_categories.csv')\ngoogle_df = pd.read_csv('/root/data/google_shopping_product_categories.csv')\n\ndef clean_text(text):\n    if pd.isna(text): return \"\"\n    text = str(text).strip()\n    text = re.sub(r'\\s+', ' ', text)\n    return text.title().strip('\"\\' ')\n\ndef parse_path(path):\n    if pd.isna(path): return []\n    parts = str(path).split(' > ')\n    return [clean_text(p) for p in parts if p.strip()]\n\ndef get_words(text):\n    words = re.findall(r'\\b\\w+\\b', text.lower())\n    stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with', 'by'}\n    return set(w for w in words if w not in stops and len(w) > 1)\nEOF\n"]
