[?2004l[?2004h> print(f"Records by source:")
[?2004l[?2004h> for src in ['amazon', 'facebook', 'google']:
[?2004l[?2004h>     cnt = sum(1 for r in output_full if r['source'] == src)
[?2004l[?2004h>     print(f"  {src}: {cnt}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nL1 distribution:")
[?2004l[?2004h> l1_counts = Counter(r['unified_level_1'] for r in output_full)
[?2004l[?2004h> for l1, cnt in l1_counts.most_common():
[?2004l[?2004h>     print(f"  {l1}: {cnt}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nL2 per L1:")
[?2004l[?2004h> for l1 in sorted(l1_counts.keys()):
[?2004l[?2004h>     l2s = set(r['unified_level_2'] for r in output_full if r['unified_level_1'] == l1 and r['unified_level_2'])
[?2004l[?2004h>     print(f"  {l1}: {len(l2s)} L2 categories")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nDone!")
