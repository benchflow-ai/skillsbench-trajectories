[?2004l[?2004h>     words = re.findall(r'\b\w+\b', text.lower())
[?2004l[?2004h>     stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with', 'by', 'products', 'supplies', 'items', 'goods'}
[?2004l[?2004h>     return set(w for w in words if w not in stops and len(w) > 2)
