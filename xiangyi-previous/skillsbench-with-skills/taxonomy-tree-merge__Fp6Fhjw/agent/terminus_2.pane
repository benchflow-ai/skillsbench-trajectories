[?2004l[?2004h> 
[?2004l[?2004h> def clean_text(text):
[?2004l[?2004h>     if pd.isna(text): return ""
[?2004l[?2004h>     text = str(text).strip()
[?2004l[?2004h>     text = re.sub(r'\s+', ' ', text)
[?2004l[?2004h>     return text.title().strip('"\' ')
[?2004l[?2004h> 
[?2004l[?2004h> def parse_path(path):
[?2004l[?2004h>     if pd.isna(path): return []
[?2004l[?2004h>     parts = str(path).split(' > ')
[?2004l[?2004h>     return [clean_text(p) for p in parts if p.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> def get_words(text):
[?2004l[?2004h>     words = re.findall(r'\b\w+\b', text.lower())
[?2004l[?2004h>     stops = {'and', 'or', 'the', 'a', 'an', 'of', 'for', 'to', 'in', 'on', 'with', 'by'}
[?2004l[?2004h>     return set(w for w in words if w not in stops and len(w) > 1)
[?2004l[?2004h> EOF
