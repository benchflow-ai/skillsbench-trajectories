[?2004l[?2004h> def word_overlap(t1, t2):
[?2004l[?2004h>     w1, w2 = get_words(t1), get_words(t2)
[?2004l[?2004h>     if not w1 or not w2: return 0
[?2004l[?2004h>     return len(w1 & w2) / len(w1 | w2)
