[?2004l[?2004h>                 clusters[l2] = l2
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Assign to closest existing rep
[?2004l[?2004h>             best_match = max(reps, key=lambda r: word_overlap(l2, r))
[?2004l[?2004h>             clusters[l2] = best_match
[?2004l[?2004h>     
[?2004l[?2004h>     return clusters
