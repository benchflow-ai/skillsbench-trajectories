[?2004l[?2004h>     # Title case
[?2004l[?2004h>     text = text.title()
[?2004l[?2004h>     return text
[?2004l[?2004h> 
[?2004l[?2004h> def parse_category_path(path):
[?2004l[?2004h>     """Parse a category path into levels"""
