[?2004l[?2004h> 
[?2004l[?2004h> # Default L2 mappings for categories without specific rules
[?2004l[?2004h> L2_MAPPINGS['Adult | Mature Products'] = {
[?2004l[?2004h>     'Adult Content': ['erotic', 'adult', 'mature'],
[?2004l[?2004h>     'Weapons': ['weapon', 'gun', 'knife', 'ammunition', 'firearm'],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> L2_MAPPINGS['Religious | Ceremonial | Occasions'] = {
[?2004l[?2004h>     'Religious Items': ['religious', 'spiritual', 'worship', 'prayer'],
[?2004l[?2004h>     'Ceremonial': ['ceremonial', 'memorial', 'funeral'],
[?2004l[?2004h>     'Wedding': ['wedding', 'bridal', 'marriage'],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> L2_MAPPINGS['Other | Miscellaneous'] = {
[?2004l[?2004h>     'General': ['general', 'other', 'miscellaneous'],
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def get_unified_l2(l1, category_text):
[?2004l[?2004h>     """Map a category to unified L2 based on L1 and keywords"""
[?2004l[?2004h>     if l1 not in L2_MAPPINGS:
[?2004l[?2004h>         return category_text  # Keep original if no mapping
[?2004l[?2004h>     
[?2004l[?2004h>     cat_lower = category_text.lower()
[?2004l[?2004h>     mappings = L2_MAPPINGS[l1]
[?2004l[?2004h>     
[?2004l[?2004h>     for unified_l2, keywords in mappings.items():
[?2004l[?2004h>         if any(kw in cat_lower for kw in keywords):
[?2004l[?2004h>             return unified_l2
[?2004l[?2004h>     
[?2004l[?2004h>     # Default: return first available or 'General'
[?2004l[?2004h>     return list(mappings.keys())[0] if mappings else category_text
[?2004l[?2004h> EOF
[?2004l[?2004hroot@4af5b017183c:~# cat >> /root/unify_taxonomy.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Process all records
[?2004l[?2004h> print("Processing records...")
[?2004l[?2004h> all_records = []
[?2004l[?2004h> for df, src in [(amazon_df, 'amazon'), (fb_df, 'facebook'), (google_df, 'google')]:
[?2004l[?2004h>     for _, row in df.iterrows():
[?2004l[?2004h>         levels = parse_path(row['category_path'])
[?2004l[?2004h>         if levels:
[?2004l[?2004h>             all_records.append({'source': src, 'path': row['category_path'], 'levels': levels})
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total: {len(all_records)} records")
[?2004l[?2004h> 
[?2004l[?2004h> # Build output with unified taxonomy
[?2004l[?2004h> print("Building unified taxonomy...")
[?2004l[?2004h> output_full = []
[?2004l[?2004h> hierarchy_set = set()
[?2004l[?2004h> 
[?2004l[?2004h> for r in all_records:
[?2004l[?2004h>     lvls = r['levels']
[?2004l[?2004h>     
[?2004l[?2004h>     # Level 1: Use keyword-based mapping
[?2004l[?2004h>     u1 = get_unified_l1(lvls[0])
[?2004l[?2004h>     
[?2004l[?2004h>     # Level 2: Use semantic grouping based on L1 and original L2
[?2004l[?2004h>     orig_l2 = lvls[1] if len(lvls) > 1 else ''
[?2004l[?2004h>     # Also consider L1 original name for L2 mapping context
[?2004l[?2004h>     l2_context = f"{lvls[0]} {orig_l2}"
[?2004l[?2004h>     u2 = get_unified_l2(u1, l2_context) if orig_l2 else ''
[?2004l[?2004h>     
[?2004l[?2004h>     # Levels 3-5: Keep original but clean
[?2004l[?2004h>     u3 = lvls[2] if len(lvls) > 2 else ''
[?2004l[?2004h>     u4 = lvls[3] if len(lvls) > 3 else ''
[?2004l[?2004h>     u5 = lvls[4] if len(lvls) > 4 else ''
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate depth
[?2004l[?2004h>     depth = len([x for x in [u1, u2, u3, u4, u5] if x])
[?2004l[?2004h>     
[?2004l[?2004h>     output_full.append({
[?2004l[?2004h>         'source': r['source'],
[?2004l[?2004h>         'category_path': r['path'],
[?2004l[?2004h>         'depth': depth,
[?2004l[?2004h>         'unified_level_1': u1,
[?2004l[?2004h>         'unified_level_2': u2,
[?2004l[?2004h>         'unified_level_3': u3,
[?2004l[?2004h>         'unified_level_4': u4,
[?2004l[?2004h>         'unified_level_5': u5
[?2004l[?2004h>     })
[?2004l[?2004h>     
[?2004l[?2004h>     hierarchy_set.add((u1, u2, u3, u4, u5))
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Generated {len(output_full)} records")
[?2004l[?2004h> EOF
