[?2004l[?2004h> def cluster_cats(cats, max_clusters=15):
[?2004l[?2004h>     """Cluster categories by word similarity"""
[?2004l[?2004h>     if len(cats) <= max_clusters:
[?2004l[?2004h>         return {c: c for c in cats}
[?2004l[?2004h>     
[?2004l[?2004h>     cat_list = sorted(cats, key=lambda x: -len(x))  # Start with longer names
[?2004l[?2004h>     clusters = {}
[?2004l[?2004h>     reps = []
[?2004l[?2004h>     
[?2004l[?2004h>     for cat in cat_list:
[?2004l[?2004h>         best_match, best_score = None, 0
[?2004l[?2004h>         for rep in reps:
[?2004l[?2004h>             score = word_overlap(cat, rep)
[?2004l[?2004h>             if score > best_score and score > 0.25:
[?2004l[?2004h>                 best_score, best_match = score, rep
[?2004l[?2004h>         
[?2004l[?2004h>         if best_match and len(reps) >= 3:
[?2004l[?2004h>             clusters[cat] = best_match
[?2004l[?2004h>         else:
[?2004l[?2004h>             reps.append(cat)
[?2004l[?2004h>             clusters[cat] = cat
[?2004l[?2004h>             if len(reps) >= max_clusters:
[?2004l[?2004h>                 for rem in cat_list:
[?2004l[?2004h>                     if rem not in clusters:
[?2004l[?2004h>                         best = max(reps, key=lambda r: word_overlap(rem, r))
[?2004l[?2004h>                         clusters[rem] = best
[?2004l[?2004h>                 break
[?2004l[?2004h>     return clusters
[?2004l[?2004h> 
[?2004l[?2004h> def make_name(cats, max_words=4):
[?2004l[?2004h>     """Create unified name from category list"""
[?2004l[?2004h>     if not cats: return ""
[?2004l[?2004h>     word_cnt = Counter()
