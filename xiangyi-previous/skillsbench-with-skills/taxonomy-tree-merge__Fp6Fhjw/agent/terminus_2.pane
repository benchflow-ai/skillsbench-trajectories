[?2004l[?2004h> def cluster_l2s(l2_counter, max_clusters=18, min_clusters=3):
[?2004l[?2004h>     """Cluster L2 categories, keeping originals when possible"""
[?2004l[?2004h>     l2_list = list(l2_counter.keys())
[?2004l[?2004h>     
[?2004l[?2004h>     if len(l2_list) <= max_clusters:
[?2004l[?2004h>         return {l2: l2 for l2 in l2_list}  # Keep all originals
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by frequency (most common first as representatives)
[?2004l[?2004h>     sorted_l2s = sorted(l2_list, key=lambda x: -l2_counter[x])
[?2004l[?2004h>     
[?2004l[?2004h>     clusters = {}
[?2004l[?2004h>     reps = []
[?2004l[?2004h>     
[?2004l[?2004h>     for l2 in sorted_l2s:
[?2004l[?2004h>         if len(reps) < max_clusters:
[?2004l[?2004h>             # Check if similar to existing rep
[?2004l[?2004h>             best_match, best_score = None, 0
[?2004l[?2004h>             for rep in reps:
[?2004l[?2004h>                 score = word_overlap(l2, rep)
[?2004l[?2004h>                 if score > best_score and score > 0.4:
[?2004l[?2004h>                     best_score, best_match = score, rep
[?2004l[?2004h>             
[?2004l[?2004h>             if best_match:
[?2004l[?2004h>                 clusters[l2] = best_match
[?2004l[?2004h>             else:
