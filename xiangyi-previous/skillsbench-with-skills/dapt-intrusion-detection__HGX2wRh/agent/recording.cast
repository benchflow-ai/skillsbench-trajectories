[137.395638, "i", "python3 -c \"\nfrom scapy.all import rdpcap, IP, TCP, UDP\nfrom collections import defaultdict\n\npackets = rdpcap('packets.pcap')\n\n# Quick verification of key metrics\nprint('Quick verification:')\nprint(f'Total packets: {len(packets)}')\n\n# Verify flow count\nflows = set()\nfor pkt in packets:\n    if IP in pkt:\n        src_ip = pkt[IP].src\n        dst_ip = pkt[IP].dst\n        if TCP in pkt:\n            flows.add((src_ip, dst_ip, pkt[TCP].sport, pkt[TCP].dport, 'TCP'))\n        elif UDP in pkt:\n            flows.add((src_ip, dst_ip, pkt[UDP].sport, pkt[UDP].dport, 'UDP'))\n\nprint(f'Unique flows: {len(flows)}')\n\n# Verify bidirectional\nbidi = 0\nfor f in flows:\n    rev = (f[1], f[0], f[3], f[2], f[4])\n    if rev in flows:\n        bidi += 1\nprint(f'Bidirectional (before /2): {bidi}')\nprint(f'Bidirectional flows: {bidi // 2}')\n\"\n"]
