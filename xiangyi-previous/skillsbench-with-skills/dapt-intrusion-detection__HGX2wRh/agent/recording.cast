[52.123573, "o", "\u001b[?2004h> "]
[52.123668, "o", "            src_ports.append(sport)\r\n\u001b[?2004l\r"]
[52.123708, "o", "\u001b[?2004h> "]
[52.123807, "o", "            dst_ports.append(dport)\r\n\u001b[?2004l\r"]
[52.123831, "o", "\u001b[?2004h> "]
[52.124069, "o", "            flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.124093, "o", "> "]
[52.124175, "o", "        elif UDP in pkt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.124232, "o", "> "]
[52.124291, "o", "            protocol_udp += 1\r\n\u001b[?2004l\r"]
[52.124331, "o", "\u001b[?2004h> "]
[52.124434, "o", "            sport = pkt[UDP].sport\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.124456, "o", "> "]
[52.124588, "o", "            dport = pkt[UDP].dport\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.124611, "o", "> "]
[52.124733, "o", "            src_ports.append(sport)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.124805, "o", "> "]
[52.124881, "o", "            dst_ports.append(dport)\r\n\u001b[?2004l\r"]
[52.124908, "o", "\u001b[?2004h> "]
[52.12513, "o", "            flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.125153, "o", "> "]
[52.125233, "o", "        elif ICMP in pkt:\r\n\u001b[?2004l\r"]
[52.125257, "o", "\u001b[?2004h> "]
[52.125365, "o", "            protocol_icmp += 1\r\n\u001b[?2004l\r"]
[52.125389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[52.12543, "o", "\u001b[?2004h> "]
[52.125522, "o", "print(\"Computing statistics...\")\r\n\u001b[?2004l\r"]
[52.125567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[52.125611, "o", "\u001b[?2004h> "]
[52.125653, "o", "# Time series\r\n\u001b[?2004l\rc\u001b[?2004h> "]
[52.125692, "o", "timestamps.sort()\r\n\u001b[?2004l\r"]
[52.125736, "o", "\u001b[?2004h> "]
[52.125946, "o", "duration_seconds = timestamps[-1] - timestamps[0] if timestamps else 0\r\n\u001b[?2004l\r"]
[52.12599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[52.126025, "o", "\u001b[?2004h> "]
[52.126141, "o", "# Packets per minute buckets\r\n\u001b[?2004l\r"]
[52.126187, "o", "\u001b[?2004h> "]
[52.126229, "o", "if timestamps:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.12628, "o", "> "]
[52.1264, "o", "    start_time = timestamps[0]\r\n\u001b[?2004l\r"]
[52.126429, "o", "\u001b[?2004h> "]
[52.126597, "o", "    buckets = defaultdict(int)\r\n\u001b[?2004l\r"]
[52.126638, "o", "\u001b[?2004h> "]
[52.126705, "o", "    for ts in timestamps:\r\n\u001b[?2004l\r"]
[52.126732, "o", "\u001b[?2004h> "]
[52.126968, "o", "        bucket_idx = int((ts - start_time) // 60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.127117, "o", "        buckets[bucket_idx] += 1\r\n\u001b[?2004l\r"]
[52.12717, "o", "\u001b[?2004h> "]
[52.127363, "o", "    bucket_counts = list(buckets.values())\r\n\u001b[?2004l\r"]
[52.127387, "o", "\u001b[?2004h> "]
[52.127913, "o", "    packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.12801, "o", "> "]
[52.128144, "o", "    packets_per_minute_max = max(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.128198, "o", "> "]
[52.128392, "o", "    packets_per_minute_min = min(bucket_counts) if bucket_counts else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.12844, "o", "> "]
[52.128489, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.128909, "o", "    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\r\n\u001b[?2004l\r"]
[52.128963, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[52.129003, "o", "\u001b[?2004h> # Size statistics"]
[52.129047, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129075, "o", "> "]
[52.129173, "o", "total_bytes = sum(packet_sizes)\r\n\u001b[?2004l\r"]
[52.129219, "o", "\u001b[?2004h> "]
[52.129582, "o", "avg_packet_size = total_bytes / len(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r"]
[52.129649, "o", "\u001b[?2004h> "]
[52.12981, "o", "min_packet_size = min(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.129857, "o", "> "]
[52.130129, "o", "max_packet_size = max(packet_sizes) if packet_sizes else 0\r\n\u001b[?2004l\r"]
[52.130158, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[52.130223, "o", "\u001b[?2004h> "]
[52.13031, "o", "# Shannon entropy function\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.130334, "o", "> "]
[52.130442, "o", "def shannon_entropy(items):\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.130491, "o", "> "]
[52.130538, "o", "    if not items:\r\n\u001b[?2004l\r"]
[52.130583, "o", "\u001b[?2004h> "]
[52.130635, "o", "        return 0\r\n\u001b[?2004l\r"]
[52.13068, "o", "\u001b[?2004h> "]
[52.13081, "o", "    counter = Counter(items)\r\n\u001b[?2004l\r"]
[52.130853, "o", "\u001b[?2004h> "]
[52.130942, "o", "    total = len(items)\r\n\u001b[?2004l\r"]
[52.130989, "o", "\u001b[?2004h> "]
[52.131028, "o", "    entropy = 0\r\n\u001b[?2004l\r"]
[52.131079, "o", "\u001b[?2004h> "]
[52.131214, "o", "    for count in counter.values():\r\n\u001b[?2004l\r"]
[52.131279, "o", "\u001b[?2004h> "]
[52.131326, "o", "        if count > 0:\r\n\u001b[?2004l\r"]
[52.13137, "o", "\u001b[?2004h> "]
[52.13145, "o", "            p = count / total\r\n\u001b[?2004l\r"]
[52.131516, "o", "\u001b[?2004h> "]
[52.131665, "o", "            entropy -= p * math.log2(p)\r\n\u001b[?2004l\r"]
[52.131715, "o", "\u001b[?2004h> "]
[52.1318, "o", "    return entropy\r\n\u001b[?2004l\r"]
[52.131842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.131885, "o", "\u001b[?2004h> "]
[52.132085, "o", "src_ip_entropy = shannon_entropy(src_ips)\r\n\u001b[?2004l\r"]
[52.132107, "o", "\u001b[?2004h> "]
[52.132311, "o", "dst_ip_entropy = shannon_entropy(dst_ips)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.132334, "o", "> "]
[52.132567, "o", "src_port_entropy = shannon_entropy(src_ports)\r\n\u001b[?2004l\r"]
[52.132593, "o", "\u001b[?2004h> "]
[52.132772, "o", "dst_port_entropy = shannon_entropy(dst_ports)\r\n\u001b[?2004l\r"]
[52.132823, "o", "\u001b[?2004h"]
[52.132869, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.133017, "o", "unique_src_ports = len(set(src_ports))\r\n\u001b[?2004l\r"]
[52.133063, "o", "\u001b[?2004h> "]
[52.133229, "o", "unique_dst_ports = len(set(dst_ports))\r\n\u001b[?2004l\r"]
[52.13329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[52.133361, "o", "# Graph metrics\r\n\u001b[?2004l\r"]
[52.133407, "o", "\u001b[?2004h> "]
[52.133556, "o", "all_ips = set(src_ips) | set(dst_ips)\r\n\u001b[?2004l\r"]
[52.133598, "o", "\u001b[?2004h> "]
[52.13371, "o", "num_nodes = len(all_ips)\r\n\u001b[?2004l\r"]
[52.133751, "o", "\u001b[?2004h> "]
[52.133835, "o", "num_edges = len(edges)\r\n\u001b[?2004l\r"]
[52.13388, "o", "\u001b[?2004h> "]
[52.133956, "o", "if num_nodes >= 2:\r\n\u001b[?2004l\r"]
[52.133998, "o", "\u001b[?2004h> "]
[52.134335, "o", "    network_density = num_edges / (num_nodes * (num_nodes - 1))\r\n\u001b[?2004l\r"]
[52.13436, "o", "\u001b[?2004h> "]
[52.134427, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.134514, "o", "    network_density = 0\r\n\u001b[?2004l\r"]
[52.134561, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r="]
[52.13459, "o", "\u001b[?2004h> "]
[52.134648, "o", "# Degree calculations\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.134671, "o", "> "]
[52.134779, "o", "out_degree = defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.134821, "o", "> "]
[52.134935, "o", "in_degree = defaultdict(set)\r\n\u001b[?2004l\r"]
[52.134977, "o", "\u001b[?2004h> "]
[52.135055, "o", "for src, dst in edges:\r\n\u001b[?2004l\r"]
[52.135098, "o", "\u001b[?2004h> "]
[52.135247, "o", "    out_degree[src].add(dst)\r\n\u001b[?2004l\r"]
[52.135295, "o", "\u001b[?2004h> "]
[52.135402, "o", "    in_degree[dst].add(src)\r\n\u001b[?2004l\r"]
[52.135453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r0\u001b[?2004h"]
[52.135492, "o", "> "]
[52.135896, "o", "max_outdegree = max(len(dsts) for dsts in out_degree.values()) if out_degree else 0\r\n\u001b[?2004l\r"]
[52.135921, "o", "\u001b[?2004h> "]
[52.136361, "o", "max_indegree = max(len(srcs) for srcs in in_degree.values()) if in_degree else 0\r\n\u001b[?2004l\r"]
[52.136389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
[52.136456, "o", "\u001b[?2004h> "]
[52.136544, "o", "# Inter-arrival times\r\n\u001b[?2004l\r"]
[52.136566, "o", "\u001b[?2004h> "]
[52.136672, "o", "iats = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.136845, "o", "for i in range(1, len(timestamps)):\r\n\u001b[?2004l\r"]
[52.136895, "o", "\u001b[?2004h> "]
[52.137129, "o", "    iats.append(timestamps[i] - timestamps[i-1])\r\n\u001b[?2004l\r"]
[52.13716, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.137228, "o", "\u001b[?2004h> if iats:\r\n"]
[52.137264, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.137384, "o", "    iat_mean = sum(iats) / len(iats)\r\n\u001b[?2004l\r"]
[52.137413, "o", "\u001b[?2004h> "]
[52.137786, "o", "    iat_variance = sum((x - iat_mean)**2 for x in iats) / len(iats)\r\n\u001b[?2004l\r"]
[52.137817, "o", "\u001b[?2004h> "]
[52.137976, "o", "    iat_std = math.sqrt(iat_variance)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.137998, "o", "> "]
[52.138289, "o", "    iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.138317, "o", "else:\r\n\u001b[?2004l\r"]
[52.138379, "o", "\u001b[?2004h> "]
[52.138537, "o", "    iat_mean = iat_variance = iat_cv = 0\r\n\u001b[?2004l\r"]
[52.138578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[52.138616, "o", "\u001b[?2004h> "]
[52.138664, "o", "# Producer/Consumer Ratio\r\n\u001b[?2004l\r"]
[52.138689, "o", "\u001b[?2004h> "]
[52.138963, "o", "all_ips_for_pcr = set(ip_bytes_sent.keys()) | set(ip_bytes_recv.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.138987, "o", "> "]
[52.139046, "o", "num_producers = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.139101, "o", "> "]
[52.13914, "o", "num_consumers = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.139205, "o", "for ip in all_ips_for_pcr:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.139251, "o", "> "]
[52.139295, "o", "    sent = ip_bytes_sent[ip]\r\n\u001b[?2004l\r"]
[52.13934, "o", "\u001b[?2004h> "]
[52.139404, "o", "    recv = ip_bytes_recv[ip]\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.139449, "o", "> "]
[52.139493, "o", "    if sent + recv > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.139541, "o", "> "]
[52.139629, "o", "        pcr = (sent - recv) / (sent + recv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.139674, "o", "> "]
[52.139715, "o", "        if pcr > 0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.139792, "o", "            num_producers += 1\r\n\u001b[?2004l\r"]
[52.13984, "o", "\u001b[?2004h> "]
[52.139903, "o", "        elif pcr < -0.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.139978, "o", "            num_consumers += 1\r\n\u001b[?2004l\r"]
[52.140005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.140051, "o", "\u001b[?2004h> "]
[52.140105, "o", "# Flow metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.140157, "o", "unique_flows = len(flows)\r\n\u001b[?2004l\r"]
[52.140203, "o", "\u001b[?2004h> "]
[52.140341, "o", "tcp_flows = len([f for f in flows if f[4] == 'TCP'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.140467, "o", "udp_flows = len([f for f in flows if f[4] == 'UDP'])\r\n\u001b[?2004l\r"]
[52.140518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.140568, "o", "\u001b[?2004h> "]
[52.140616, "o", "# Bidirectional flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.140657, "o", "bidirectional_flows = 0\r\n\u001b[?2004l\r"]
[52.140708, "o", "\u001b[?2004h> "]
[52.140769, "o", "for flow in flows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.1408, "o", "> "]
[52.140885, "o", "    src_ip, dst_ip, sport, dport, proto = flow\r\n\u001b[?2004l\r"]
[52.140937, "o", "\u001b[?2004h> "]
[52.141053, "o", "    reverse_flow = (dst_ip, src_ip, dport, sport, proto)\r\n\u001b[?2004l\r"]
[52.141106, "o", "\u001b[?2004h> "]
[52.141147, "o", "    if reverse_flow in flows:\r\n\u001b[?2004l\r"]
[52.141175, "o", "\u001b[?2004h> "]
[52.141262, "o", "        bidirectional_flows += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.141306, "o", "> "]
[52.141409, "o", "bidirectional_flows //= 2  # Each pair counted twice\r\n\u001b[?2004l\r"]
[52.141434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.141501, "o", "\u001b[?2004h> "]
[52.14155, "o", "# Analysis flags\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.141714, "o", "# Port scan detection: high number of unique dst ports from single source\r\n\u001b[?2004l\r"]
[52.141763, "o", "\u001b[?2004h> "]
[52.141819, "o", "src_to_dstports = defaultdict(set)\r\n\u001b[?2004l\r"]
[52.141866, "o", "\u001b[?2004h> "]
[52.141937, "o", "for i, src in enumerate(src_ips):\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.141982, "o", "> "]
[52.142025, "o", "    if i < len(dst_ports):\r\n\u001b[?2004l\r"]
[52.142078, "o", "\u001b[?2004h> "]
[52.142177, "o", "        src_to_dstports[src].add(dst_ports[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.142222, "o", "> "]
[52.142444, "o", "max_ports_scanned = max(len(ports) for ports in src_to_dstports.values()) if src_to_dstports else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.142473, "o", "> "]
[52.14263, "o", "has_port_scan = max_ports_scanned > 100  # Threshold for port scan\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.142674, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.142781, "o", "# DoS detection: very high packets per minute\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.142825, "o", "> "]
[52.142953, "o", "has_dos_pattern = packets_per_minute_max > 10000  # Threshold\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.142997, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.143158, "o", "# Beaconing: low IAT coefficient of variation indicates regularity\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.143201, "o", "> "]
[52.143331, "o", "has_beaconing = iat_cv < 0.5 and iat_cv > 0 and len(iats) > 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.143382, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.14349, "o", "# Traffic benign: no malicious patterns detected\r\n\u001b[?2004l\r"]
[52.143541, "o", "\u001b[?2004h> "]
[52.143668, "o", "is_traffic_benign = not (has_port_scan or has_dos_pattern)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.143714, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.143773, "o", "print(\"Writing results...\")\r\n\u001b[?2004l\r"]
[52.143813, "o", "\u001b[?2004h"]
[52.143856, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.143911, "o", "# Prepare results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.143955, "o", "results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.14403, "o", "    'protocol_tcp': protocol_tcp,\r\n\u001b[?2004l\r"]
[52.14408, "o", "\u001b[?2004h> "]
[52.144139, "o", "    'protocol_udp': protocol_udp,\r\n\u001b[?2004l\r"]
[52.144192, "o", "\u001b[?2004h> "]
[52.144252, "o", "    'protocol_icmp': protocol_icmp,\r\n\u001b[?2004l\r"]
