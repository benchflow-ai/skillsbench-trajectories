[52.148962, "o", "lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.149062, "o", "with open('/root/network_stats.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.160781, "o", "> "]
[52.160916, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line = line.rstrip('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>         if line.startswith('#') or line == 'metric,value':\r\n\u001b[?2004l\r\u001b[?2004h>             lines.append(line)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             parts = line.split(',')\r\n\u001b[?2004l\r\u001b[?2004h>             if len(parts) >= 1:\r\n\u001b[?2004l\r\u001b[?2004h>                 metric = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h>                 if metric in results:\r\n\u001b[?2004l\r\u001b[?2004h>                     lines.append(f\"{metric},{results[metric]}\")\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     lines.append(line)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/network_stats.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(line + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSummary of key metrics:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Total packets: {len(packets)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  TCP: {protocol_tcp}, UDP: {protocol_udp}, ICMP: {protocol_icmp}, ARP: {protocol_arp}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Duration: {duration_seconds:.2f}s\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Unique flows: {unique_flows}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Port scan detected: {has_port_scan}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  DoS pattern detected: {has_dos_pattern}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
