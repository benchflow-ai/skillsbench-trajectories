[12.763978, "o", "\u001b[?2004hroot@d7f624f9c06e:~# "]
[52.115835, "i", "cat > analyze_pcap.py << 'EOF'\nimport math\nfrom collections import defaultdict, Counter\nfrom scapy.all import rdpcap, IP, TCP, UDP, ICMP, ARP\nimport csv\n\nprint(\"Loading pcap file...\")\npackets = rdpcap('packets.pcap')\nprint(f\"Loaded {len(packets)} packets\")\n\n# Initialize counters and collectors\nprotocol_tcp = 0\nprotocol_udp = 0\nprotocol_icmp = 0\nprotocol_arp = 0\nprotocol_ip_total = 0\n\ntimestamps = []\npacket_sizes = []\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\n\n# For graph metrics\nedges = set()\n\n# For flow metrics\nflows = set()\n\n# For PCR calculation\nip_bytes_sent = defaultdict(int)\nip_bytes_recv = defaultdict(int)\n\nprint(\"Processing packets...\")\nfor pkt in packets:\n    # Timestamp and size\n    timestamps.append(float(pkt.time))\n    pkt_len = len(pkt)\n    packet_sizes.append(pkt_len)\n    \n    # Protocol detection\n    if ARP in pkt:\n        protocol_arp += 1\n    \n    if IP in pkt:\n        protocol_ip_total += 1\n        src_ip = pkt[IP].src\n        dst_ip = pkt[IP].dst\n        src_ips.append(src_ip)\n        dst_ips.append(dst_ip)\n        edges.add((src_ip, dst_ip))\n        \n        # PCR tracking\n        ip_bytes_sent[src_ip] += pkt_len\n        ip_bytes_recv[dst_ip] += pkt_len\n        \n        proto_num = pkt[IP].proto\n        \n        if TCP in pkt:\n            protocol_tcp += 1\n            sport = pkt[TCP].sport\n            dport = pkt[TCP].dport\n            src_ports.append(sport)\n            dst_ports.append(dport)\n            flows.add((src_ip, dst_ip, sport, dport, 'TCP'))\n        elif UDP in pkt:\n            protocol_udp += 1\n            sport = pkt[UDP].sport\n            dport = pkt[UDP].dport\n            src_ports.append(sport)\n            dst_ports.append(dport)\n            flows.add((src_ip, dst_ip, sport, dport, 'UDP'))\n        elif ICMP in pkt:\n            protocol_icmp += 1\n\nprint(\"Computing statistics...\")\n\n# Time series\ntimestamps.sort()\nduration_seconds = timestamps[-1] - timestamps[0] if timestamps else 0\n\n# Packets per minute buckets\nif timestamps:\n    start_time = timestamps[0]\n    buckets = defaultdict(int)\n    for ts in timestamps:\n        bucket_idx = int((ts - start_time) // 60)\n        buckets[bucket_idx] += 1\n    bucket_counts = list(buckets.values())\n    packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0\n    packets_per_minute_max = max(bucket_counts) if bucket_counts else 0\n    packets_per_minute_min = min(bucket_counts) if bucket_counts else 0\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\n# Size statistics\ntotal_bytes = sum(packet_sizes)\navg_packet_size = total_bytes / len(packet_sizes) if packet_sizes else 0\nmin_packet_size = min(packet_sizes) if packet_sizes else 0\nmax_packet_size = max(packet_sizes) if packet_sizes else 0\n\n# Shannon entropy function\ndef shannon_entropy(items):\n    if not items:\n        return 0\n    counter = Counter(items)\n    total = len(items)\n    entropy = 0\n    for count in counter.values():\n        if count > 0:\n            p = count / total\n            entropy -= p * math.log2(p)\n    return entropy\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\n\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\n# Graph metrics\nall_ips = set(src_ips) | set(dst_ips)\nnum_nodes = len(all_ips)\nnum_edges = len(edges)\nif num_nodes >= 2:\n    network_density = num_edges / (num_nodes * (num_nodes - 1))\nelse:\n    network_density = 0\n\n# Degree calculations\nout_degree = defaultdict(set)\nin_degree = defaultdict(set)\nfor src, dst in edges:\n    out_degree[src].add(dst)\n    in_degree[dst].add(src)\n\nmax_outdegree = max(len(dsts) for dsts in out_degree.values()) if out_degree else 0\nmax_indegree = max(len(srcs) for srcs in in_degree.values()) if in_degree else 0\n\n# Inter-arrival times\niats = []\nfor i in range(1, len(timestamps)):\n    iats.append(timestamps[i] - timestamps[i-1])\n\nif iats:\n    iat_mean = sum(iats) / len(iats)\n    iat_variance = sum((x - iat_m"]
[52.116012, "i", "ean)**2 for x in iats) / len(iats)\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\n# Producer/Consumer Ratio\nall_ips_for_pcr = set(ip_bytes_sent.keys()) | set(ip_bytes_recv.keys())\nnum_producers = 0\nnum_consumers = 0\nfor ip in all_ips_for_pcr:\n    sent = ip_bytes_sent[ip]\n    recv = ip_bytes_recv[ip]\n    if sent + recv > 0:\n        pcr = (sent - recv) / (sent + recv)\n        if pcr > 0.2:\n            num_producers += 1\n        elif pcr < -0.2:\n            num_consumers += 1\n\n# Flow metrics\nunique_flows = len(flows)\ntcp_flows = len([f for f in flows if f[4] == 'TCP'])\nudp_flows = len([f for f in flows if f[4] == 'UDP'])\n\n# Bidirectional flows\nbidirectional_flows = 0\nfor flow in flows:\n    src_ip, dst_ip, sport, dport, proto = flow\n    reverse_flow = (dst_ip, src_ip, dport, sport, proto)\n    if reverse_flow in flows:\n        bidirectional_flows += 1\nbidirectional_flows //= 2  # Each pair counted twice\n\n# Analysis flags\n# Port scan detection: high number of unique dst ports from single source\nsrc_to_dstports = defaultdict(set)\nfor i, src in enumerate(src_ips):\n    if i < len(dst_ports):\n        src_to_dstports[src].add(dst_ports[i])\nmax_ports_scanned = max(len(ports) for ports in src_to_dstports.values()) if src_to_dstports else 0\nhas_port_scan = max_ports_scanned > 100  # Threshold for port scan\n\n# DoS detection: very high packets per minute\nhas_dos_pattern = packets_per_minute_max > 10000  # Threshold\n\n# Beaconing: low IAT coefficient of variation indicates regularity\nhas_beaconing = iat_cv < 0.5 and iat_cv > 0 and len(iats) > 100\n\n# Traffic benign: no malicious patterns detected\nis_traffic_benign = not (has_port_scan or has_dos_pattern)\n\nprint(\"Writing results...\")\n\n# Prepare results\nresults = {\n    'protocol_tcp': protocol_tcp,\n    'protocol_udp': protocol_udp,\n    'protocol_icmp': protocol_icmp,\n    'protocol_arp': protocol_arp,\n    'protocol_ip_total': protocol_ip_total,\n    'duration_seconds': round(duration_seconds, 6),\n    'packets_per_minute_avg': round(packets_per_minute_avg, 6),\n    'packets_per_minute_max': packets_per_minute_max,\n    'packets_per_minute_min': packets_per_minute_min,\n    'total_bytes': total_bytes,\n    'avg_packet_size': round(avg_packet_size, 6),\n    'min_packet_size': min_packet_size,\n    'max_packet_size': max_packet_size,\n    'src_ip_entropy': round(src_ip_entropy, 6),\n    'dst_ip_entropy': round(dst_ip_entropy, 6),\n    'src_port_entropy': round(src_port_entropy, 6),\n    'dst_port_entropy': round(dst_port_entropy, 6),\n    'unique_src_ports': unique_src_ports,\n    'unique_dst_ports': unique_dst_ports,\n    'num_nodes': num_nodes,\n    'num_edges': num_edges,\n    'network_density': round(network_density, 6),\n    'max_outdegree': max_outdegree,\n    'max_indegree': max_indegree,\n    'iat_mean': round(iat_mean, 6),\n    'iat_variance': round(iat_variance, 6),\n    'iat_cv': round(iat_cv, 6),\n    'num_producers': num_producers,\n    'num_consumers': num_consumers,\n    'unique_flows': unique_flows,\n    'bidirectional_flows': bidirectional_flows,\n    'tcp_flows': tcp_flows,\n    'udp_flows': udp_flows,\n    'is_traffic_benign': str(is_traffic_benign).lower(),\n    'has_port_scan': str(has_port_scan).lower(),\n    'has_dos_pattern': str(has_dos_pattern).lower(),\n    'has_beaconing': str(has_beaconing).lower(),\n}\n\n# Read original CSV and update values\nlines = []\nwith open('/root/network_stats.csv', 'r') as f:\n    for line in f:\n        line = line.rstrip('\\n')\n        if line.startswith('#') or line == 'metric,value':\n            lines.append(line)\n        else:\n            parts = line.split(',')\n            if len(parts) >= 1:\n                metric = parts[0]\n                if metric in results:\n                    lines.append(f\"{metric},{results[metric]}\")\n                else:\n                    lines.append(line)\n\nwith open('/root/network_stats.csv', 'w') as f:\n    for line in lines:\n        f.write(line + '\\n')\n\nprint(\"Done!\")\nprint(\"\\nSummary of key metrics:\")\nprint(f\"  Total packets: {len(packets)}\")\nprin"]
[52.116083, "i", "t(f\"  TCP: {protocol_tcp}, UDP: {protocol_udp}, ICMP: {protocol_icmp}, ARP: {protocol_arp}\")\nprint(f\"  Duration: {duration_seconds:.2f}s\")\nprint(f\"  Unique flows: {unique_flows}\")\nprint(f\"  Port scan detected: {has_port_scan}\")\nprint(f\"  DoS pattern detected: {has_dos_pattern}\")\nEOF\n"]
