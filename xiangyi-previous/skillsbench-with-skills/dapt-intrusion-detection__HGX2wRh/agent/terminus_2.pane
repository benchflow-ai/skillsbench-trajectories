[?2004le[?2004h> # Shannon entropy function
[?2004l[?2004h> def shannon_entropy(items):
[?2004l[?2004h>     if not items:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     counter = Counter(items)
[?2004l[?2004h>     total = len(items)
[?2004l[?2004h>     entropy = 0
[?2004l[?2004h>     for count in counter.values():
[?2004l[?2004h>         if count > 0:
[?2004l[?2004h>             p = count / total
[?2004l[?2004h>             entropy -= p * math.log2(p)
[?2004l[?2004h>     return entropy
