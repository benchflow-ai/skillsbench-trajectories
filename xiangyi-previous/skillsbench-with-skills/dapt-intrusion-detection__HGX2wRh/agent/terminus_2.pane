[?2004l[?2004h>     bucket_counts = list(buckets.values())
[?2004l[?2004h>     packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0
[?2004l[?2004h>     packets_per_minute_max = max(bucket_counts) if bucket_counts else 0
