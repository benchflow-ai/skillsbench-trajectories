[44.714822, "i", ", 0.04),  # ng/mL\n    'Troponin_T': (0, 0.04),  # ng/mL\n    'Free_T4': (0.8, 1.8),  # ng/dL\n    'Free_T3': (2.3, 4.2),  # pg/mL\n    'pH_Arterial': (7.35, 7.45),  # pH\n    'pCO2_Arterial': (35, 45),  # mmHg\n    'pO2_Arterial': (80, 100),  # mmHg\n    'Lactate': (0.5, 2.0),  # mmol/L\n    'Beta2_Microglobulin': (0.0, 2.4),  # mg/L\n    'Aluminum': (0, 10),  # µg/L\n}\n\nprint(\"\\nPhysiological ranges defined for\", len(physiological_ranges), \"features\")\nprint(\"\\nSample of data before unit conversion:\")\nprint(data_clean[['patient_id', 'Serum_Creatinine', 'Hemoglobin', 'Ferritin']].head())\n\nENDSCRIPT\n"]
