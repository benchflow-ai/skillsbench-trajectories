[29.450795, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport re\n\n# Load the data\ndata = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\n\n# Function to convert string to float, handling scientific notation and comma decimals\ndef convert_to_float(val):\n    if pd.isna(val) or val == '' or val == 'nan':\n        return np.nan\n    \n    # Convert to string if not already\n    val_str = str(val).strip()\n    \n    # Replace comma with period for decimal separator\n    val_str = val_str.replace(',', '.')\n    \n    try:\n        return float(val_str)\n    except:\n        return np.nan\n\n# Convert all columns except patient_id to numeric\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\nprint(\"Data after conversion:\")\nprint(data.head(2))\nprint(\"\\nData types after conversion:\")\nprint(data.dtypes.unique())\nprint(\"\\nMissing values after conversion:\")\nprint(data.isnull().sum().sum())\nEOF\n"]
