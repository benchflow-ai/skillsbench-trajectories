[66.730333, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Load and convert data\ndata = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\n\ndef convert_to_float(val):\n    if pd.isna(val) or val == '' or val == 'nan':\n        return np.nan\n    val_str = str(val).strip()\n    val_str = val_str.replace(',', '.')\n    try:\n        return float(val_str)\n    except:\n        return np.nan\n\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\ndata_clean = data.dropna().reset_index(drop=True)\n\n# Define physiological ranges\nphysiological_ranges = {\n    'Serum_Creatinine': (0.6, 1.2),\n    'BUN': (7, 20),\n    'eGFR': (60, 120),\n    'Cystatin_C': (0.5, 1.0),\n    'BUN_Creatinine_Ratio': (10, 20),\n    'Sodium': (136, 145),\n    'Potassium': (3.5, 5.0),\n    'Chloride': (98, 107),\n    'Bicarbonate': (23, 29),\n    'Anion_Gap': (8, 16),\n    'Magnesium': (1.7, 2.2),\n    'Serum_Calcium': (8.5, 10.2),\n    'Ionized_Calcium': (4.5, 5.3),\n    'Phosphorus': (2.5, 4.5),\n    'Intact_PTH': (15, 65),\n    "]
[66.730387, "i", "'Vitamin_D_25OH': (30, 100),\n    'Vitamin_D_1_25OH': (20, 60),\n    'Alkaline_Phosphatase': (30, 120),\n    'Hemoglobin': (12.0, 17.5),\n    'Hematocrit': (36, 46),\n    'RBC_Count': (4.5, 5.9),\n    'WBC_Count': (4.5, 11.0),\n    'Platelet_Count': (150, 400),\n    'Serum_Iron': (60, 170),\n    'TIBC': (250, 425),\n    'Transferrin_Saturation': (20, 50),\n    'Ferritin': (30, 300),\n    'Reticulocyte_Count': (0.5, 2.5),\n    'Total_Bilirubin': (0.1, 1.2),\n    'Direct_Bilirubin': (0.0, 0.3),\n    'Albumin_Serum': (3.5, 5.5),\n    'Total_Protein': (6.0, 8.3),\n    'Prealbumin': (20, 40),\n    'CRP': (0.0, 3.0),\n    'Total_Cholesterol': (0, 200),\n    'LDL_Cholesterol': (0, 130),\n    'HDL_Cholesterol': (40, 200),\n    'Triglycerides': (0, 150),\n    'Non_HDL_Cholesterol': (0, 160),\n    'Glucose': (70, 100),\n    'HbA1c': (4.0, 5.6),\n    'Fructosamine': (200, 285),\n    'Uric_Acid': (3.5, 7.2),\n    'Urine_Albumin': (0, 30),\n    'Urine_Creatinine': (800, 2000),\n    'Albumin_to_Creatinine_Ratio_Urine': (0, 30),\n    'Protein_to_Creatini"]
[66.730405, "i", "ne_Ratio_Urine': (0, 150),\n    'Urine_Protein': (0, 150),\n    'Urine_pH': (4.5, 8.0),\n    'Urine_Specific_Gravity': (1.005, 1.030),\n    'BNP': (0, 100),\n    'NT_proBNP': (0, 125),\n    'Troponin_I': (0, 0.04),\n    'Troponin_T': (0, 0.04),\n    'Free_T4': (0.8, 1.8),\n    'Free_T3': (2.3, 4.2),\n    'pH_Arterial': (7.35, 7.45),\n    'pCO2_Arterial': (35, 45),\n    'pO2_Arterial': (80, 100),\n    'Lactate': (0.5, 2.0),\n    'Beta2_Microglobulin': (0.0, 2.4),\n    'Aluminum': (0, 10),\n}\n\n# Define unit conversion rules: (feature, condition, conversion_factor, description)\nunit_conversions = [\n    # Serum_Creatinine: if > 1.5, likely µmol/L, convert to mg/dL by dividing by 88.4\n    ('Serum_Creatinine', lambda x: x > 1.5, 1/88.4, 'µmol/L to mg/dL'),\n    # BUN: if > 25, might be in mmol/L, convert to mg/dL by multiplying by 2.8\n    ('BUN', lambda x: x > 25, 2.8, 'mmol/L to mg/dL'),\n    # Cystatin_C: if > 1.2, likely in mg/L, keep as is (normal range 0.5-1.0)\n    # Magnesium: if > 3, likely in mmol/L, convert to mg/dL by mu"]
[66.730412, "i", "ltiplying by 2.43\n    ('Magnesium', lambda x: x > 3, 2.43, 'mmol/L to mg/dL'),\n    # Serum_Calcium: if > 15, likely in mmol/L, convert to mg/dL by multiplying by 4.0\n    ('Serum_Calcium', lambda x: x > 15, 4.0, 'mmol/L to mg/dL'),\n    # Phosphorus: if > 6, likely in mmol/L, convert to mg/dL by multiplying by 3.1\n    ('Phosphorus', lambda x: x > 6, 3.1, 'mmol/L to mg/dL'),\n    # Albumin_Serum: if > 8, likely in g/L, convert to g/dL by dividing by 10\n    ('Albumin_Serum', lambda x: x > 8, 1/10, 'g/L to g/dL'),\n    # Total_Protein: if > 10, likely in g/L, convert to g/dL by dividing by 10\n    ('Total_Protein', lambda x: x > 10, 1/10, 'g/L to g/dL'),\n    # Hemoglobin: if > 20, likely in g/L, convert to g/dL by dividing by 10\n    ('Hemoglobin', lambda x: x > 20, 1/10, 'g/L to g/dL'),\n    # Glucose: if > 200 and < 1000, likely in mg/dL (ok), if > 1000 might be µmol/L, convert by dividing by 18\n    ('Glucose', lambda x: x > 1000, 1/18, 'µmol/L to mg/dL'),\n    # Uric_Acid: if > 15, likely in µmol/L, convert to mg/"]
[66.730418, "i", "dL by dividing by 59.48\n    ('Uric_Acid', lambda x: x > 15, 1/59.48, 'µmol/L to mg/dL'),\n    # Triglycerides: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\n    ('Triglycerides', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\n    # Total_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\n    ('Total_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\n    # LDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\n    ('LDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\n    # HDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\n    ('HDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\n    # Ferritin: if > 500, likely in ng/mL (ok), if > 5000 might be in µg/L, convert by dividing by 1.0 (same)\n    # CRP: if > 10, likely in mg/L (ok)\n    # Prealbumin: if > 50, likely i"]
[66.730427, "i", "n mg/L, convert to mg/dL by dividing by 10\n    ('Prealbumin', lambda x: x > 50, 1/10, 'mg/L to mg/dL'),\n]\n\nprint(\"Applying unit conversions...\")\nconversion_count = 0\n\nfor feature, condition, factor, desc in unit_conversions:\n    if feature in data_clean.columns:\n        mask = data_clean[feature].apply(condition)\n        if mask.any():\n            old_values = data_clean.loc[mask, feature].copy()\n            data_clean.loc[mask, feature] = data_clean.loc[mask, feature] * factor\n            new_values = data_clean.loc[mask, feature].copy()\n            conversion_count += mask.sum()\n            print(f\"  {feature}: converted {mask.sum()} values ({desc})\")\n            print(f\"    Sample: {old_values.iloc[0]:.4f} -> {new_values.iloc[0]:.4f}\")\n\nprint(f\"\\nTotal values converted: {conversion_count}\")\nprint(f\"\\nSample after conversion:\")\nprint(data_clean[['patient_id', 'Serum_Creatinine', 'Hemoglobin', 'Ferritin']].head())\n\nENDSCRIPT\n"]
