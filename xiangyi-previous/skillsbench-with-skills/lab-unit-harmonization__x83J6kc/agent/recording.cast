[44.714529, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\ndata = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\n\n# Function to convert string to float\ndef convert_to_float(val):\n    if pd.isna(val) or val == '' or val == 'nan':\n        return np.nan\n    val_str = str(val).strip()\n    val_str = val_str.replace(',', '.')\n    try:\n        return float(val_str)\n    except:\n        return np.nan\n\n# Convert all columns except patient_id to numeric\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\nprint(f\"Original data shape: {data.shape}\")\nprint(f\"Rows with missing values: {data[data.columns[1:]].isnull().any(axis=1).sum()}\")\n\n# Remove rows with any missing values\ndata_clean = data.dropna()\nprint(f\"Data shape after removing missing values: {data_clean.shape}\")\n\n# Define physiological ranges for each feature (US conventional units)\nphysiological_ranges = {\n    'Serum_Creatinine': (0.6, 1.2),  # mg/dL\n    'BUN': (7, 20),  # mg/dL\n    'eGFR': (60, 120),  # mL/"]
[44.71475, "i", "min/1.73m2\n    'Cystatin_C': (0.5, 1.0),  # mg/L\n    'BUN_Creatinine_Ratio': (10, 20),  # ratio\n    'Sodium': (136, 145),  # mEq/L\n    'Potassium': (3.5, 5.0),  # mEq/L\n    'Chloride': (98, 107),  # mEq/L\n    'Bicarbonate': (23, 29),  # mEq/L\n    'Anion_Gap': (8, 16),  # mEq/L\n    'Magnesium': (1.7, 2.2),  # mg/dL\n    'Serum_Calcium': (8.5, 10.2),  # mg/dL\n    'Ionized_Calcium': (4.5, 5.3),  # mg/dL\n    'Phosphorus': (2.5, 4.5),  # mg/dL\n    'Intact_PTH': (15, 65),  # pg/mL\n    'Vitamin_D_25OH': (30, 100),  # ng/mL\n    'Vitamin_D_1_25OH': (20, 60),  # pg/mL\n    'Alkaline_Phosphatase': (30, 120),  # U/L\n    'Hemoglobin': (12.0, 17.5),  # g/dL\n    'Hematocrit': (36, 46),  # %\n    'RBC_Count': (4.5, 5.9),  # million/µL\n    'WBC_Count': (4.5, 11.0),  # thousand/µL\n    'Platelet_Count': (150, 400),  # thousand/µL\n    'Serum_Iron': (60, 170),  # µg/dL\n    'TIBC': (250, 425),  # µg/dL\n    'Transferrin_Saturation': (20, 50),  # %\n    'Ferritin': (30, 300),  # ng/mL\n    'Reticulocyte_Count': (0.5, 2.5),  # %\n    "]
