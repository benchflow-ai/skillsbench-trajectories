[66.760852, "o", "\u001b[?2004h"]
[66.760878, "o", "> "]
[66.76103, "o", "# Define unit conversion rules: (feature, condition, conversion_factor, description)\r\n\u001b[?2004l\r"]
[66.761057, "o", "\u001b[?2004h> "]
[66.761113, "o", "unit_conversions = [\r\n\u001b[?2004l\r"]
[66.761142, "o", "\u001b[?2004h> "]
[66.761298, "o", "    # Serum_Creatinine: if > 1.5, likely µmol/L, convert to mg/dL by dividing by 88.4\r\n\u001b[?2004l\r"]
[66.761329, "o", "\u001b[?2004h> "]
[66.761468, "o", "    ('Serum_Creatinine', lambda x: x > 1.5, 1/88.4, 'µmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.761504, "o", "\u001b[?2004h> "]
[66.761645, "o", "    # BUN: if > 25, might be in mmol/L, convert to mg/dL by multiplying by 2.8\r\n\u001b[?2004l\r"]
[66.761676, "o", "\u001b[?2004h> "]
[66.761784, "o", "    ('BUN', lambda x: x > 25, 2.8, 'mmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.761819, "o", "\u001b[?2004h"]
[66.761851, "o", "> "]
[66.761985, "o", "    # Cystatin_C: if > 1.2, likely in mg/L, keep as is (normal range 0.5-1.0)\r\n\u001b[?2004l\r"]
[66.762018, "o", "\u001b[?2004h> "]
[66.762164, "o", "    # Magnesium: if > 3, likely in mmol/L, convert to mg/dL by multiplying by 2.43\r\n\u001b[?2004l\r"]
[66.762197, "o", "\u001b[?2004h> "]
[66.762313, "o", "    ('Magnesium', lambda x: x > 3, 2.43, 'mmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.762348, "o", "\u001b[?2004h> "]
[66.762506, "o", "    # Serum_Calcium: if > 15, likely in mmol/L, convert to mg/dL by multiplying by 4.0\r\n\u001b[?2004l\r"]
[66.762533, "o", "\u001b[?2004h> "]
[66.762714, "o", "    ('Serum_Calcium', lambda x: x > 15, 4.0, 'mmol/L to mg/dL'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.762824, "o", "    # Phosphorus: if > 6, likely in mmol/L, convert to mg/dL by multiplying by 3.1\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.762859, "o", "> "]
[66.76297, "o", "    ('Phosphorus', lambda x: x > 6, 3.1, 'mmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.762993, "o", "\u001b[?2004h> "]
[66.763163, "o", "    # Albumin_Serum: if > 8, likely in g/L, convert to g/dL by dividing by 10\r\n\u001b[?2004l\r"]
[66.763194, "o", "\u001b[?2004h> "]
[66.763325, "o", "    ('Albumin_Serum', lambda x: x > 8, 1/10, 'g/L to g/dL'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.763355, "o", "> "]
[66.763481, "o", "    # Total_Protein: if > 10, likely in g/L, convert to g/dL by dividing by 10\r\n\u001b[?2004l\r"]
[66.763521, "o", "\u001b[?2004h> "]
[66.763636, "o", "    ('Total_Protein', lambda x: x > 10, 1/10, 'g/L to g/dL'),\r\n\u001b[?2004l\r"]
[66.763656, "o", "\u001b[?2004h"]
[66.76368, "o", "> "]
[66.763816, "o", "    # Hemoglobin: if > 20, likely in g/L, convert to g/dL by dividing by 10\r\n\u001b[?2004l\r"]
[66.763855, "o", "\u001b[?2004h"]
[66.763885, "o", "> "]
[66.764, "o", "    ('Hemoglobin', lambda x: x > 20, 1/10, 'g/L to g/dL'),\r\n\u001b[?2004l\r"]
[66.764025, "o", "\u001b[?2004h> "]
[66.764223, "o", "    # Glucose: if > 200 and < 1000, likely in mg/dL (ok), if > 1000 might be µmol/L, convert by dividing by 18\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.764254, "o", "> "]
[66.764381, "o", "    ('Glucose', lambda x: x > 1000, 1/18, 'µmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.764427, "o", "\u001b[?2004h> "]
[66.764568, "o", "    # Uric_Acid: if > 15, likely in µmol/L, convert to mg/dL by dividing by 59.48\r\n\u001b[?2004l\r"]
[66.764596, "o", "\u001b[?2004h"]
[66.764618, "o", "> "]
[66.764744, "o", "    ('Uric_Acid', lambda x: x > 15, 1/59.48, 'µmol/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.764772, "o", "\u001b[?2004h> "]
[66.764971, "o", "    # Triglycerides: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\r\n\u001b[?2004l\r"]
[66.765006, "o", "\u001b[?2004h> "]
[66.765131, "o", "    ('Triglycerides', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.765165, "o", "\u001b[?2004h> "]
[66.765358, "o", "    # Total_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\r\n\u001b[?2004l\r"]
[66.765388, "o", "\u001b[?2004h"]
[66.765419, "o", "> "]
[66.765539, "o", "    ('Total_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.765571, "o", "\u001b[?2004h> "]
[66.76577, "o", "    # LDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\r\n\u001b[?2004l\r"]
[66.7658, "o", "\u001b[?2004h> "]
[66.765931, "o", "    ('LDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.765965, "o", "\u001b[?2004h> "]
[66.766162, "o", "    # HDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100\r\n\u001b[?2004l\r"]
[66.766202, "o", "\u001b[?2004h> "]
[66.766322, "o", "    ('HDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.766355, "o", "\u001b[?2004h> "]
[66.766547, "o", "    # Ferritin: if > 500, likely in ng/mL (ok), if > 5000 might be in µg/L, convert by dividing by 1.0 (same)\r\n\u001b[?2004l\r"]
[66.766588, "o", "\u001b[?2004h> "]
[66.766674, "o", "    # CRP: if > 10, likely in mg/L (ok)\r\n\u001b[?2004l\r"]
[66.766716, "o", "\u001b[?2004h> "]
[66.766895, "o", "    # Prealbumin: if > 50, likely in mg/L, convert to mg/dL by dividing by 10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.766988, "o", "    ('Prealbumin', lambda x: x > 50, 1/10, 'mg/L to mg/dL'),\r\n\u001b[?2004l\r"]
[66.767025, "o", "\u001b[?2004h> ]"]
[66.767045, "o", "\r\n\u001b[?2004l\r"]
[66.767236, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Applying unit conversions...\")\r\n\u001b[?2004l\r"]
[66.767271, "o", "\u001b[?2004h> "]
[66.767349, "o", "conversion_count = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.767387, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.767421, "o", "> "]
[66.767535, "o", "for feature, condition, factor, desc in unit_conversions:\r\n\u001b[?2004l\r"]
[66.767566, "o", "\u001b[?2004h> "]
[66.76765, "o", "    if feature in data_clean.columns:\r\n\u001b[?2004l\r"]
[66.767684, "o", "\u001b[?2004h> "]
[66.767791, "o", "        mask = data_clean[feature].apply(condition)\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.767822, "o", "> "]
[66.76788, "o", "        if mask.any():\r\n\u001b[?2004l\r"]
[66.767907, "o", "\u001b[?2004h"]
[66.767932, "o", "> "]
[66.768054, "o", "            old_values = data_clean.loc[mask, feature].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.76808, "o", "> "]
[66.768222, "o", "            data_clean.loc[mask, feature] = data_clean.loc[mask, feature] * factor\r\n\u001b[?2004l\r"]
[66.76825, "o", "\u001b[?2004h"]
[66.768273, "o", "> "]
[66.768383, "o", "            new_values = data_clean.loc[mask, feature].copy()\r\n\u001b[?2004l\r"]
[66.768409, "o", "\u001b[?2004h"]
[66.76844, "o", "> "]
[66.768523, "o", "            conversion_count += mask.sum()\r\n\u001b[?2004l\r"]
[66.768532, "o", "\u001b[?2004h"]
[66.768568, "o", "> "]
[66.7687, "o", "            print(f\"  {feature}: converted {mask.sum()} values ({desc})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.76873, "o", "> "]
[66.768883, "o", "            print(f\"    Sample: {old_values.iloc[0]:.4f} -> {new_values.iloc[0]:.4f}\")\r\n\u001b[?2004l\r"]
[66.7689, "o", "\u001b[?2004h"]
[66.768939, "o", "> \r\n"]
[66.768971, "o", "\u001b[?2004l\r"]
[66.769001, "o", "\u001b[?2004h"]
[66.769033, "o", "> "]
[66.769139, "o", "print(f\"\\nTotal values converted: {conversion_count}\")\r\n\u001b[?2004l\r"]
[66.769172, "o", "\u001b[?2004h> "]
[66.769252, "o", "print(f\"\\nSample after conversion:\")\r\n\u001b[?2004l\r"]
[66.769295, "o", "\u001b[?2004h"]
[66.769328, "o", "> "]
[66.76947, "o", "print(data_clean[['patient_id', 'Serum_Creatinine', 'Hemoglobin', 'Ferritin']].head())\r\n\u001b[?2004l\r"]
[66.769506, "o", "\u001b[?2004h"]
[66.769533, "o", "> \r\n"]
[66.769563, "o", "\u001b[?2004l\r"]
[66.769594, "o", "\u001b[?2004h"]
[66.769628, "o", "> "]
[66.769668, "o", "ENDSCRIPT\r\n\u001b[?2004l\r"]
