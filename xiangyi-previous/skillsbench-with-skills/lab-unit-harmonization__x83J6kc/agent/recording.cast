[135.835178, "o", "n_rules:\r\n\u001b[?2004l\r\u001b[?2004h>     if feature in data_clean.columns:\r\n\u001b[?2004l\r\u001b[?2004h>         mask = data_clean[feature].apply(condition)\r\n\u001b[?2004l\r\u001b[?2004h>         if mask.any():\r\n\u001b[?2004l\r\u001b[?2004h>             data_clean.loc[mask, feature] = data_clean.loc[mask, feature] * factor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Apply multiple refinement passes\r\n\u001b[?2004l\r\u001b[?2004h> for pass_num in range(3):\r\n\u001b[?2004l\r\u001b[?2004h>     conversions_made = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for feature, (min_val, max_val) in physiological_ranges.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if feature not in data_clean.columns:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Values below minimum\r\n\u001b[?2004l\r\u001b[?2004h>         mask_low = data_clean[feature] < min_val\r\n\u001b[?2004l\r\u001b[?2004h>         if feature in ['Hemoglobin', 'Hematocrit', 'RBC_Count', 'Total_Protein', 'Albumin_Serum']:\r\n\u001b[?2004l\r\u001b[?2004h>             if mask_low.any() and data_clean.loc[mask_low, feature].min() > 0:\r\n\u001b[?2004l"]
