[175.11623, "i", "python3 > /tmp/harmonize.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load data\ndata = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\n\ndef convert_to_float(val):\n    if pd.isna(val) or val == '' or val == 'nan':\n        return np.nan\n    try:\n        return float(str(val).strip().replace(',', '.'))\n    except:\n        return np.nan\n\n# Convert all columns to numeric\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\n# Remove rows with missing values\ndata = data.dropna().reset_index(drop=True)\nprint(f\"Data shape: {data.shape}\")\n\n# Define physiological ranges\nranges = {\n    'Serum_Creatinine': (0.6, 1.2),\n    'BUN': (7, 20),\n    'eGFR': (60, 120),\n    'Hemoglobin': (12.0, 17.5),\n    'Ferritin': (30, 300),\n    'Magnesium': (1.7, 2.2),\n    'Phosphorus': (2.5, 4.5),\n    'pO2_Arterial': (80, 100),\n    'Lactate': (0.5, 2.0),\n}\n\n# Apply conversions\nprint(\"\\nApplying conversions:\")\n\n# Serum_Creatinine: µmol/L to mg/dL if > 1.5\nmask = data['Serum_Creatinine'] > 1.5\nif mask."]
[175.116273, "i", "any():\n    data.loc[mask, 'Serum_Creatinine'] = data.loc[mask, 'Serum_Creatinine'] / 88.4\n    print(f\"Serum_Creatinine: {mask.sum()} converted\")\n\n# BUN: mmol/L to mg/dL if > 25\nmask = data['BUN'] > 25\nif mask.any():\n    data.loc[mask, 'BUN'] = data.loc[mask, 'BUN'] / 2.8\n    print(f\"BUN: {mask.sum()} converted\")\n\n# Magnesium: mmol/L to mg/dL if > 3\nmask = data['Magnesium'] > 3\nif mask.any():\n    data.loc[mask, 'Magnesium'] = data.loc[mask, 'Magnesium'] / 2.43\n    print(f\"Magnesium: {mask.sum()} converted\")\n\n# Phosphorus: mmol/L to mg/dL if > 6\nmask = data['Phosphorus'] > 6\nif mask.any():\n    data.loc[mask, 'Phosphorus'] = data.loc[mask, 'Phosphorus'] / 3.1\n    print(f\"Phosphorus: {mask.sum()} converted\")\n\n# Hemoglobin: g/L to g/dL if > 20\nmask = data['Hemoglobin'] > 20\nif mask.any():\n    data.loc[mask, 'Hemoglobin'] = data.loc[mask, 'Hemoglobin'] / 10\n    print(f\"Hemoglobin (>20): {mask.sum()} converted\")\n\n# Ferritin: µg/L to ng/mL if > 500\nmask = data['Ferritin'] > 500\nif mask.any():\n    data.loc[mask, 'Fer"]
[175.116383, "i", "ritin'] = data.loc[mask, 'Ferritin'] / 10\n    print(f\"Ferritin: {mask.sum()} converted\")\n\n# pO2_Arterial: kPa to mmHg if > 200\nmask = data['pO2_Arterial'] > 200\nif mask.any():\n    data.loc[mask, 'pO2_Arterial'] = data.loc[mask, 'pO2_Arterial'] / 7.5\n    print(f\"pO2_Arterial: {mask.sum()} converted\")\n\n# Lactate: mmol/L to mg/dL if > 10\nmask = data['Lactate'] > 10\nif mask.any():\n    data.loc[mask, 'Lactate'] = data.loc[mask, 'Lactate'] / 11.2\n    print(f\"Lactate: {mask.sum()} converted\")\n\n# Round to 2 decimal places\nfor col in data.columns[1:]:\n    data[col] = data[col].round(2)\n    data[col] = data[col].apply(lambda x: f\"{x:.2f}\")\n\nprint(f\"\\nFinal shape: {data.shape}\")\nprint(f\"\\nSample:\")\nprint(data[['patient_id', 'Serum_Creatinine', 'Hemoglobin', 'Ferritin', 'BUN']].head(10))\n\n# Save\ndata.to_csv('/root/ckd_lab_data_harmonized.csv', index=False)\nprint(f\"\\nSaved to /root/ckd_lab_data_harmonized.csv\")\nEOF\n"]
