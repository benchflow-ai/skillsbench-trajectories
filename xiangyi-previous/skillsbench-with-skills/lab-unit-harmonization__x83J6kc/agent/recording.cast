[158.816317, "i", "  'Albumin_to_Creatinine_Ratio_Urine': (0, 30),\n    'Protein_to_Creatinine_Ratio_Urine': (0, 150),\n    'Urine_Protein': (0, 150),\n    'Urine_pH': (4.5, 8.0),\n    'Urine_Specific_Gravity': (1.005, 1.030),\n    'BNP': (0, 100),\n    'NT_proBNP': (0, 125),\n    'Troponin_I': (0, 0.04),\n    'Troponin_T': (0, 0.04),\n    'Free_T4': (0.8, 1.8),\n    'Free_T3': (2.3, 4.2),\n    'pH_Arterial': (7.35, 7.45),\n    'pCO2_Arterial': (35, 45),\n    'pO2_Arterial': (80, 100),\n    'Lactate': (0.5, 2.0),\n    'Beta2_Microglobulin': (0.0, 2.4),\n    'Aluminum': (0, 10),\n}\n\nprint(\"\\nApplying smart unit conversions based on physiological ranges...\")\n\n# Smart conversion: for each feature, determine if values are in wrong units\nfor feature, (min_val, max_val) in physiological_ranges.items():\n    if feature not in data_clean.columns:\n        continue\n    \n    col_data = data_clean[feature]\n    out_of_range_count = ((col_data < min_val) | (col_data > max_val)).sum()\n    \n    if out_of_range_count == 0:\n        continue\n    \n    # Determine a"]
