[91.254597, "i", "python3 << 'ENDSCRIPT'\nimport pandas as pd\nimport numpy as np\n\n# Load and convert data\ndata = pd.read_csv('/root/environment/data/ckd_lab_data.csv')\n\ndef convert_to_float(val):\n    if pd.isna(val) or val == '' or val == 'nan':\n        return np.nan\n    val_str = str(val).strip()\n    val_str = val_str.replace(',', '.')\n    try:\n        return float(val_str)\n    except:\n        return np.nan\n\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\ndata_clean = data.dropna().reset_index(drop=True)\n\n# Define physiological ranges\nphysiological_ranges = {\n    'Serum_Creatinine': (0.6, 1.2),\n    'BUN': (7, 20),\n    'eGFR': (60, 120),\n    'Cystatin_C': (0.5, 1.0),\n    'BUN_Creatinine_Ratio': (10, 20),\n    'Sodium': (136, 145),\n    'Potassium': (3.5, 5.0),\n    'Chloride': (98, 107),\n    'Bicarbonate': (23, 29),\n    'Anion_Gap': (8, 16),\n    'Magnesium': (1.7, 2.2),\n    'Serum_Calcium': (8.5, 10.2),\n    'Ionized_Calcium': (4.5, 5.3),\n    'Phosphorus': (2.5, 4.5),\n    'Intact_PTH': (15, 65),\n    "]
