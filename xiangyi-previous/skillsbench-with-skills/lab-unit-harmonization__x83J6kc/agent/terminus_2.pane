[?2004l[?2004h> # Prealbumin: if > 50, divide by 10 (mg/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Prealbumin'] > 50
[?2004l[?2004h> data_clean.loc[mask, 'Prealbumin'] = data_clean.loc[mask, 'Prealbumin'] / 10
