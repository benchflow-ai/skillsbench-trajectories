[?2004l[?2004h> # Define unit conversion rules: (feature, condition, conversion_factor, description)
[?2004l[?2004h> unit_conversions = [
[?2004l[?2004h>     # Serum_Creatinine: if > 1.5, likely µmol/L, convert to mg/dL by dividing by 88.4
[?2004l[?2004h>     ('Serum_Creatinine', lambda x: x > 1.5, 1/88.4, 'µmol/L to mg/dL'),
[?2004l[?2004h>     # BUN: if > 25, might be in mmol/L, convert to mg/dL by multiplying by 2.8
[?2004l[?2004h>     ('BUN', lambda x: x > 25, 2.8, 'mmol/L to mg/dL'),
[?2004l[?2004h>     # Cystatin_C: if > 1.2, likely in mg/L, keep as is (normal range 0.5-1.0)
[?2004l[?2004h>     # Magnesium: if > 3, likely in mmol/L, convert to mg/dL by multiplying by 2.43
[?2004l[?2004h>     ('Magnesium', lambda x: x > 3, 2.43, 'mmol/L to mg/dL'),
[?2004l[?2004h>     # Serum_Calcium: if > 15, likely in mmol/L, convert to mg/dL by multiplying by 4.0
[?2004l[?2004h>     ('Serum_Calcium', lambda x: x > 15, 4.0, 'mmol/L to mg/dL'),
[?2004l[?2004h>     # Phosphorus: if > 6, likely in mmol/L, convert to mg/dL by multiplying by 3.1
[?2004l[?2004h>     ('Phosphorus', lambda x: x > 6, 3.1, 'mmol/L to mg/dL'),
[?2004l[?2004h>     # Albumin_Serum: if > 8, likely in g/L, convert to g/dL by dividing by 10
[?2004l[?2004h>     ('Albumin_Serum', lambda x: x > 8, 1/10, 'g/L to g/dL'),
[?2004l[?2004h>     # Total_Protein: if > 10, likely in g/L, convert to g/dL by dividing by 10
[?2004l[?2004h>     ('Total_Protein', lambda x: x > 10, 1/10, 'g/L to g/dL'),
[?2004l[?2004h>     # Hemoglobin: if > 20, likely in g/L, convert to g/dL by dividing by 10
[?2004l[?2004h>     ('Hemoglobin', lambda x: x > 20, 1/10, 'g/L to g/dL'),
[?2004l[?2004h>     # Glucose: if > 200 and < 1000, likely in mg/dL (ok), if > 1000 might be µmol/L, convert by dividing by 18
[?2004l[?2004h>     ('Glucose', lambda x: x > 1000, 1/18, 'µmol/L to mg/dL'),
[?2004l[?2004h>     # Uric_Acid: if > 15, likely in µmol/L, convert to mg/dL by dividing by 59.48
[?2004l[?2004h>     ('Uric_Acid', lambda x: x > 15, 1/59.48, 'µmol/L to mg/dL'),
[?2004l[?2004h>     # Triglycerides: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100
[?2004l[?2004h>     ('Triglycerides', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),
[?2004l[?2004h>     # Total_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100
[?2004l[?2004h>     ('Total_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),
[?2004l[?2004h>     # LDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100
[?2004l[?2004h>     ('LDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),
[?2004l[?2004h>     # HDL_Cholesterol: if > 500 and < 1000, likely in mg/dL (ok), if > 1000 might be mg/L, convert by dividing by 100
[?2004l[?2004h>     ('HDL_Cholesterol', lambda x: x > 1000, 1/100, 'mg/L to mg/dL'),
[?2004l[?2004h>     # Ferritin: if > 500, likely in ng/mL (ok), if > 5000 might be in µg/L, convert by dividing by 1.0 (same)
[?2004l[?2004h>     # CRP: if > 10, likely in mg/L (ok)
[?2004l[?2004h>     # Prealbumin: if > 50, likely in mg/L, convert to mg/dL by dividing by 10
[?2004l[?2004h>     ('Prealbumin', lambda x: x > 50, 1/10, 'mg/L to mg/dL'),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> print("Applying unit conversions...")
[?2004l[?2004h> conversion_count = 0
[?2004l[?2004h> 
[?2004l[?2004h> for feature, condition, factor, desc in unit_conversions:
[?2004l[?2004h>     if feature in data_clean.columns:
[?2004l[?2004h>         mask = data_clean[feature].apply(condition)
[?2004l[?2004h>         if mask.any():
[?2004l[?2004h>             old_values = data_clean.loc[mask, feature].copy()
[?2004l[?2004h>             data_clean.loc[mask, feature] = data_clean.loc[mask, feature] * factor
[?2004l[?2004h>             new_values = data_clean.loc[mask, feature].copy()
[?2004l[?2004h>             conversion_count += mask.sum()
[?2004l[?2004h>             print(f"  {feature}: converted {mask.sum()} values ({desc})")
[?2004l[?2004h>             print(f"    Sample: {old_values.iloc[0]:.4f} -> {new_values.iloc[0]:.4f}")
[?2004l[?2004h> 
