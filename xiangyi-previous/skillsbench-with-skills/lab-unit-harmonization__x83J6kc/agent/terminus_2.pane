[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l [?2004h> # Load and convert data
[?2004l[?2004h> data = pd.read_csv('/root/environment/data/ckd_lab_data.csv')
[?2004l[?2004h> 
[?2004ld[?2004h> def convert_to_float(val):
[?2004l[?2004h>     if pd.isna(val) or val == '' or val == 'nan':
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     val_str = str(val).strip()
[?2004l[?2004h>     val_str = val_str.replace(',', '.')
[?2004l[?2004h>     try:
[?2004l[?2004h>         return float(val_str)
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.nan
[?2004le[?2004h> 
[?2004la[?2004h> for col in data.columns[1:]:
[?2004l[?2004h>     data[col] = data[col].apply(convert_to_float)
[?2004l[?2004h> 
[?2004la[?2004h> data_clean = data.dropna().reset_index(drop=True)
[?2004l[?2004h> 
[?2004l [?2004h> print(f"Data shape after removing missing values: {data_clean.shape}")
[?2004l[?2004h> 
[?2004lg[?2004h> # Apply comprehensive unit conversions
[?2004l[?2004h> print("\nApplying unit conversions...")
[?2004l[?2004h> 
[?2004l[?2004h> # Serum_Creatinine: if > 1.5, divide by 88.4 (µmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Serum_Creatinine'] > 1.5
[?2004l[?2004h> data_clean.loc[mask, 'Serum_Creatinine'] = data_clean.loc[mask, 'Serum_Creatinine'] / 88.4
[?2004l[?2004h> 
[?2004l[?2004h> # BUN: if > 25, divide by 2.8 (mmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['BUN'] > 25
[?2004l[?2004h> data_clean.loc[mask, 'BUN'] = data_clean.loc[mask, 'BUN'] / 2.8
[?2004l[?2004h> 
[?2004l[?2004h> # Magnesium: if > 3, divide by 2.43 (mmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Magnesium'] > 3
[?2004l[?2004h> data_clean.loc[mask, 'Magnesium'] = data_clean.loc[mask, 'Magnesium'] / 2.43
[?2004l[?2004h> 
[?2004l[?2004h> # Serum_Calcium: if > 15, divide by 4.0 (mmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Serum_Calcium'] > 15
[?2004l[?2004h> data_clean.loc[mask, 'Serum_Calcium'] = data_clean.loc[mask, 'Serum_Calcium'] / 4.0
[?2004l[?2004h> 
[?2004l[?2004h> # Phosphorus: if > 6, divide by 3.1 (mmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Phosphorus'] > 6
[?2004l[?2004h> data_clean.loc[mask, 'Phosphorus'] = data_clean.loc[mask, 'Phosphorus'] / 3.1
[?2004l[?2004h> 
[?2004l[?2004h> # Albumin_Serum: if > 8, divide by 10 (g/L to g/dL)
[?2004l[?2004h> mask = data_clean['Albumin_Serum'] > 8
[?2004l[?2004h> data_clean.loc[mask, 'Albumin_Serum'] = data_clean.loc[mask, 'Albumin_Serum'] / 10
[?2004l[?2004h> 
[?2004l[?2004h> # Total_Protein: if > 10, divide by 10 (g/L to g/dL)
[?2004l[?2004h> mask = data_clean['Total_Protein'] > 10
[?2004l[?2004h> data_clean.loc[mask, 'Total_Protein'] = data_clean.loc[mask, 'Total_Protein'] / 10
[?2004l[?2004h> 
[?2004l[?2004h> # Hemoglobin: if > 20, divide by 10 (g/L to g/dL)
[?2004l[?2004h> mask = data_clean['Hemoglobin'] > 20
[?2004l[?2004h> data_clean.loc[mask, 'Hemoglobin'] = data_clean.loc[mask, 'Hemoglobin'] / 10
[?2004l[?2004h> 
[?2004l[?2004h> # Hemoglobin: if < 5, multiply by 10 (mmol/L to g/dL)
[?2004l[?2004h> mask = data_clean['Hemoglobin'] < 5
[?2004l[?2004h> data_clean.loc[mask, 'Hemoglobin'] = data_clean.loc[mask, 'Hemoglobin'] * 10
[?2004l[?2004h> 
[?2004l[?2004h> # Hematocrit: if > 60, divide by 10
[?2004l[?2004h> mask = data_clean['Hematocrit'] > 60
[?2004l[?2004h> data_clean.loc[mask, 'Hematocrit'] = data_clean.loc[mask, 'Hematocrit'] / 10
[?2004l[?2004h> 
[?2004l[?2004h> # Glucose: if > 1000, divide by 18 (µmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Glucose'] > 1000
[?2004l[?2004h> data_clean.loc[mask, 'Glucose'] = data_clean.loc[mask, 'Glucose'] / 18
[?2004l[?2004h> 
[?2004l[?2004h> # Uric_Acid: if > 15, divide by 59.48 (µmol/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Uric_Acid'] > 15
[?2004l[?2004h> data_clean.loc[mask, 'Uric_Acid'] = data_clean.loc[mask, 'Uric_Acid'] / 59.48
[?2004l[?2004h> 
[?2004l[?2004h> # Triglycerides: if > 1000, divide by 100 (mg/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Triglycerides'] > 1000
[?2004l[?2004h> data_clean.loc[mask, 'Triglycerides'] = data_clean.loc[mask, 'Triglycerides'] / 100
[?2004l[?2004h> 
[?2004l[?2004h> # Total_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)
[?2004l[?2004h> mask = data_clean['Total_Cholesterol'] > 1000
[?2004l[?2004h> data_clean.loc[mask, 'Total_Cholesterol'] = data_clean.loc[mask, 'Total_Cholesterol'] / 100
[?2004l[?2004h> 
[?2004l[?2004h> # LDL_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)
[?2004l[?2004h> mask = data_clean['LDL_Cholesterol'] > 1000
[?2004l[?2004h> data_clean.loc[mask, 'LDL_Cholesterol'] = data_clean.loc[mask, 'LDL_Cholesterol'] / 100
[?2004l[?2004h> 
[?2004l[?2004h> # HDL_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)
[?2004l[?2004h> mask = data_clean['HDL_Cholesterol'] > 1000
[?2004l[?2004h> data_clean.loc[mask, 'HDL_Cholesterol'] = data_clean.loc[mask, 'HDL_Cholesterol'] / 100
[?2004l[?2004h> 
[?2004l[?2004h> # Ferritin: if > 500, divide by 10 (might be in µg/L, convert to ng/mL)
[?2004l[?2004h> mask = data_clean['Ferritin'] > 500
[?2004l[?2004h> data_clean.loc[mask, 'Ferritin'] = data_clean.loc[mask, 'Ferritin'] / 10
