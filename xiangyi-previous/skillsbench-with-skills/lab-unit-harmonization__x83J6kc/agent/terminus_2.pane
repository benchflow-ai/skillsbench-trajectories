[?2004l# Lactate: mmol/L to mg/dL if > 10
mask = data['Lactate'] > 10
if mask.any():
    data.loc[mask, 'Lactate'] = data.loc[mask, 'Lactate'] / 11.2
    print(f"Lactate: {mask.sum()} converted")

# Second pass - for remaining out-of-range values
print("\nSecond pass conversions:")

# Hemoglobin: if < 5, multiply by 10 (mmol/L to g/dL)
mask = data['Hemoglobin'] < 5
if mask.any():
    data.loc[mask, 'Hemoglobin'] = data.loc[mask, 'Hemoglobin'] * 10
    print(f"Hemoglobin (<5): {mask.sum()} converted")

# Ferritin: if still > 300, divide by 10 again
mask = data['Ferritin'] > 300
if mask.any():
    data.loc[mask, 'Ferritin'] = data.loc[mask, 'Ferritin'] / 10
    print(f"Ferritin (>300): {mask.sum()} converted")

# BUN: if still > 25, divide by 2.8 again
mask = data['BUN'] > 25
if mask.any():
    data.loc[mask, 'BUN'] = data.loc[mask, 'BUN'] / 2.8
    print(f"BUN (>25): {mask.sum()} converted")

# Magnesium: if still > 2.5, divide by 2.43 again
mask = data['Magnesium'] > 2.5
if mask.any():
    data.loc[mask, 'Magnesium'] = data.loc[mask, 'Magnesium'] / 2.43
    print(f"Magnesium (>2.5): {mask.sum()} converted")

# Round to 2 decimal places
for col in data.columns[1:]:
    data[col] = data[col].round(2)
    data[col] = data[col].apply(lambda x: f"{x:.2f}")

print(f"\nFinal shape: {data.shape}")
print(f"\nSample:")
print(data[['patient_id', 'Serum_Creatinine', 'Hemoglobin', 'Ferritin', 'BUN']].head(10))

# Save
data.to_csv('/root/ckd_lab_data_harmonized.csv', index=False)
print(f"\nSaved to /root/ckd_lab_data_harmonized.csv")
