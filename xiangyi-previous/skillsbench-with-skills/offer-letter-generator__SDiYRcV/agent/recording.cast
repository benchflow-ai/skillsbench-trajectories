[41.597751, "i", "python3 << 'EOF'\nimport zipfile\n\n# Verify the output file by extracting and checking content\nwith zipfile.ZipFile('/root/offer_letter_filled.docx', 'r') as zip_ref:\n    with zip_ref.open('word/document.xml') as f:\n        content = f.read().decode('utf-8')\n\n# Check for any remaining placeholders\nimport re\nplaceholders = re.findall(r'\\{\\{[A-Z_]+\\}\\}', content)\nif placeholders:\n    print(f\"WARNING: Found remaining placeholders: {placeholders}\")\nelse:\n    print(\"✓ No remaining placeholders found\")\n\n# Check that relocation content is present\nif 'relocation' in content.lower():\n    print(\"✓ Relocation content is present\")\nelse:\n    print(\"✗ Relocation content is missing\")\n\n# Check for some key replaced values\nif 'Sarah Chen' in content:\n    print(\"✓ Candidate name found: Sarah Chen\")\nif 'Senior Software Engineer' in content:\n    print(\"✓ Position found: Senior Software Engineer\")\nif '185,000' in content:\n    print(\"✓ Base salary found: 185,000\")\n\nprint(\"\\n✓ Offer letter generation completed successfully!\")\nEOF\n"]
