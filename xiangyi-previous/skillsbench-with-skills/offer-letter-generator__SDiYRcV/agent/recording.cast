[16.221124, "i", "python3 << 'EOF'\nimport json\nimport zipfile\nimport os\nfrom io import BytesIO\n\n# Load employee data\nwith open('/root/employee_data.json', 'r') as f:\n    data = json.load(f)\n\n# Extract and read the template\nwith zipfile.ZipFile('/root/offer_letter_template.docx', 'r') as zip_ref:\n    # Read document.xml\n    with zip_ref.open('word/document.xml') as f:\n        content = f.read().decode('utf-8')\n\nprint(\"Template content (first 1000 chars):\")\nprint(content[:1000])\nprint(\"\\n...\\n\")\nprint(\"Template content (last 1000 chars):\")\nprint(content[-1000:])\nEOF\n"]
