[24.607616, "i", "python3 << 'EOF'\nimport json\nimport zipfile\nimport re\nfrom io import BytesIO\nimport shutil\n\n# Load employee data\nwith open('/root/employee_data.json', 'r') as f:\n    data = json.load(f)\n\nprint(\"Employee data loaded:\")\nprint(f\"Name: {data['CANDIDATE_FULL_NAME']}\")\nprint(f\"Position: {data['POSITION']}\")\nprint(f\"Relocation: {data['RELOCATION_PACKAGE']}\")\n\n# Read the template docx\ntemplate_path = '/root/offer_letter_template.docx'\noutput_path = '/root/offer_letter_filled.docx'\n\n# Copy template to output location\nshutil.copy(template_path, output_path)\n\n# Extract and modify\nwith zipfile.ZipFile(output_path, 'r') as zip_ref:\n    with zip_ref.open('word/document.xml') as f:\n        content = f.read().decode('utf-8')\n\n# First, let's extract all text to see the full structure\nprint(\"\\nSearching for placeholders and conditional sections...\")\nif '{{IF_RELOCATION}}' in content:\n    print(\"Found IF_RELOCATION section\")\nelse:\n    print(\"IF_RELOCATION section not found in current form\")\n\n# Find all placeholder patterns\nplaceholders = re.findall(r'\\{\\{[A-Z_]+\\}\\}', content)\nprint(f\"\\nFound placeholders: {set(placeholders)}\")\nEOF\n"]
