[33.24113, "o", "    content = re.sub(r'\\{\\{IF_RELOCATION\\}\\}', '', content)\r\n\u001b[?2004l\r"]
[33.241159, "o", "\u001b[?2004h> "]
[33.24129, "o", "    content = re.sub(r'\\{\\{END_IF_RELOCATION\\}\\}', '', content)\r\n\u001b[?2004l\r"]
[33.241336, "o", "\u001b[?2004h> "]
[33.241438, "o", "    print(\"Keeping relocation content (markers removed)\")\r\n\u001b[?2004l\r"]
[33.241496, "o", "\u001b[?2004h> "]
[33.241528, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.241621, "o", "    # Remove the entire section including markers\r\n\u001b[?2004l\r"]
[33.241699, "o", "\u001b[?2004h> "]
[33.241879, "o", "    content = re.sub(r'\\{\\{IF_RELOCATION\\}\\}.*?\\{\\{END_IF_RELOCATION\\}\\}', '', content, flags=re.DOTALL)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.241972, "o", "    print(\"Removing relocation content\")\r\n\u001b[?2004l\r"]
[33.242, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.242058, "o", "\u001b[?2004h> "]
[33.242139, "o", "# Replace all placeholders with values from JSON\r\n\u001b[?2004l\r"]
[33.242166, "o", "\u001b[?2004h> "]
[33.242248, "o", "for key, value in data.items():\r\n\u001b[?2004l\r"]
[33.242303, "o", "\u001b[?2004h> "]
[33.242359, "o", "    placeholder = '{{' + key + '}}'\r\n\u001b[?2004l\r"]
[33.242389, "o", "\u001b[?2004h> "]
[33.242462, "o", "    if placeholder in content:\r\n\u001b[?2004l\r"]
[33.242487, "o", "\u001b[?2004h> "]
[33.242621, "o", "        content = content.replace(placeholder, str(value))\r\n\u001b[?2004l\r"]
[33.242651, "o", "\u001b[?2004h> "]
[33.242756, "o", "        print(f\"Replaced {placeholder} with {value}\")\r\n\u001b[?2004l\r"]
[33.24278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.24281, "o", "\u001b[?2004h> "]
[33.242927, "o", "print(\"\\nModified content length:\", len(content))\r\n\u001b[?2004l\r"]
[33.242951, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.243006, "o", "\u001b[?2004h> "]
[33.243071, "o", "# Write back the modified document.xml\r\n\u001b[?2004l\r"]
[33.243095, "o", "\u001b[?2004h> "]
[33.243215, "o", "with open(doc_path, 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[33.24326, "o", "\u001b[?2004h> "]
[33.243292, "o", "    f.write(content)\r\n\u001b[?2004l\r"]
[33.243348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.243375, "o", "# Repack the docx\r\n\u001b[?2004l\r"]
[33.243404, "o", "\u001b[?2004h> "]
[33.243581, "o", "with zipfile.ZipFile(output_path, 'w', zipfile.ZIP_DEFLATED) as zip_ref:\r\n\u001b[?2004l\r"]
[33.243612, "o", "\u001b[?2004h> "]
[33.243687, "o", "    for root, dirs, files in os.walk(temp_dir):\r\n\u001b[?2004l\r"]
[33.243712, "o", "\u001b[?2004h> "]
[33.243777, "o", "        for file in files:\r\n\u001b[?2004l\r"]
[33.243805, "o", "\u001b[?2004h> "]
[33.243913, "o", "            file_path = os.path.join(root, file)\r\n\u001b[?2004l\r"]
[33.243959, "o", "\u001b[?2004h> "]
[33.244073, "o", "            arcname = os.path.relpath(file_path, temp_dir)\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.244099, "o", "> "]
[33.244188, "o", "            zip_ref.write(file_path, arcname)\r\n\u001b[?2004l\r"]
[33.244212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.244266, "o", "\u001b[?2004h> "]
[33.244369, "o", "print(f\"\\nOffer letter saved to: {output_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.244422, "o", "> "]
[33.244523, "o", "print(f\"File size: {os.path.getsize(output_path)} bytes\")\r\n\u001b[?2004l\r"]
[33.244575, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.244607, "o", "# Cleanup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.244677, "o", "shutil.rmtree(temp_dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
