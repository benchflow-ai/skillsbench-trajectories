[217.867137, "o", "with open('/root/detection_results.csv', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write('approximant,snr,total_mass\\n')\r\n\u001b[?2004l\r\u001b[?2004h>     for approx in approximants:\r\n\u001b[?2004l\r\u001b[?2004h>         if approx in results:\r\n\u001b[?2004l\r\u001b[?2004h>             snr, total_mass = results[approx]\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f'{approx},{snr:.4f},{int(total_mass)}\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Results written successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nFinal Results:\")\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/detection_results.csv', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f.read())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
