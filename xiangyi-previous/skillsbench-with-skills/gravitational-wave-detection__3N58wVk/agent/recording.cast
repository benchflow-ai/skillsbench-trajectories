[893.063205, "i", "python3 << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.filter.matchedfilter import matched_filter\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation, welch\nfrom pycbc.filter import highpass_fir\n\nprint(\"Loading and conditioning data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nstrain = highpass_fir(strain, 35, 8)\n\nprint(\"Estimating PSD...\")\npsd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=int(2*strain.sample_rate))\npsd = interpolate(psd, 1.0/strain.duration)\npsd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\n\nprint(\"\\nGenerating test template (SEOBNRv4_opt, m1=20, m2=20)...\")\nhp, hc = get_td_waveform(approximant=\"SEOBNRv4_opt\",\n                        mass1=20, mass2=20,\n                        delta_t=1.0/strain.sample_rate,\n                        f_lower=35)\nprint(f\"Template length: {len(hp)}\")\nprint(f\"Strain length: {len(strain)}\")\nprint(f\"Templat"]
[893.063596, "o", "python3 << 'EOF'\r\nimport numpy as np\r\nfrom pycbc.frame import read_frame\r\nfrom pycbc.waveform import get_td_waveform\r\nfrom pycbc.filter.matchedfilter import matched_filter\r\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation, welch\r\nfrom pycbc.filter import highpass_fir\r\n\r\nprint(\"Loading and conditioning data...\")\r\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\r\nstrain = highpass_fir(strain, 35, 8)\r\n\r\nprint(\"Estimating PSD...\")\r\npsd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=int(2*strain.sample_rate))\r\npsd = interpolate(psd, 1.0/strain.duration)\r\npsd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\r\n\r\nprint(\"\\nGenerating test template (SEOBNRv4_opt, m1=20, m2=20)...\")\r\nhp, hc = get_td_waveform(approximant=\"SEOBNRv4_opt\",\r\n                        mass1=20, mass2=20,\r\n                        delta_t=1.0/strain.sample_rate,\r\n                        f_lower=35)\r\nprint(f\"Template length: {len(hp)}\")\r\nprint(f\"Strain length: {len(str"]
[893.067226, "i", "e max: {np.max(np.abs(hp.data))}\")\nprint(f\"Strain max: {np.max(np.abs(strain.data))}\")\n\nif len(hp) < len(strain):\n    hp.resize(len(strain))\n\nprint(\"\\nPerforming matched filter (with PSD)...\")\nsnr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\nprint(f\"SNR type: {type(snr)}\")\nprint(f\"SNR length: {len(snr)}\")\nprint(f\"SNR max: {np.max(np.abs(snr))}\")\nprint(f\"SNR min: {np.min(np.abs(snr))}\")\nprint(f\"SNR mean: {np.mean(np.abs(snr))}\")\nprint(f\"SNR first 10: {snr[:10]}\")\n\npeak_snr = np.max(np.abs(snr))\nprint(f\"\\nPeak SNR: {peak_snr}\")\n\nEOF\n"]
[893.067403, "o", "ain)}\")\r\nprint(f\"Template max: {np.max(np.abs(hp.data))}\")\r\nprint(f\"Strain max: {np.max(np.abs(strain.data))}\")\r\n\r\nif len(hp) < len(strain):\r\n    hp.resize(len(strain))\r\n\r\nprint(\"\\nPerforming matched filter (with PSD)...\")\r\nsnr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\r\nprint(f\"SNR type: {type(snr)}\")\r\nprint(f\"SNR length: {len(snr)}\")\r\nprint(f\"SNR max: {np.max(np.abs(snr))}\")\r\nprint(f\"SNR min: {np.min(np.abs(snr))}\")\r\nprint(f\"SNR mean: {np.mean(np.abs(snr))}\")\r\nprint(f\"SNR first 10: {snr[:10]}\")\r\n\r\npeak_snr = np.max(np.abs(snr))\r\nprint(f\"\\nPeak SNR: {peak_snr}\")\r\n\r\nEOF\r\n"]
