[217.848639, "i", "python3 << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.filter.matchedfilter import matched_filter\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation, welch\nfrom pycbc.filter import highpass_fir\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Loading data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nprint(f\"Data loaded: {len(strain)} samples at {strain.sample_rate} Hz, duration: {len(strain)/strain.sample_rate:.1f}s\")\n\nprint(\"Conditioning data...\")\nstrain = highpass_fir(strain, 35, 8)\nprint(\"Highpass filtering applied\")\n\nprint(\"Estimating PSD...\")\npsd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=int(2*strain.sample_rate))\npsd = interpolate(psd, 1.0/strain.duration)\npsd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\nprint(\"PSD estimated\")\n\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nmass_range = range(10, 41)\nresults = {}\n\nprint"]
[217.84878, "i", "(f\"\\nGrid search: {len(approximants)} approximants, {len(mass_range)}x{len(mass_range)} mass grid\")\n\nfor approx_idx, approx in enumerate(approximants):\n    print(f\"\\n[{approx_idx+1}/{len(approximants)}] Processing {approx}...\")\n    max_snr = 0\n    best_params = None\n    template_count = 0\n    failed_count = 0\n    \n    for m1 in mass_range:\n        for m2 in mass_range:\n            try:\n                hp, hc = get_td_waveform(approximation=approx,\n                                        mass1=m1, mass2=m2,\n                                        delta_t=1.0/strain.sample_rate,\n                                        f_lower=35)\n                \n                if len(hp) < len(strain):\n                    hp.resize(len(strain))\n                \n                snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n                peak_snr = np.max(np.abs(snr))\n                \n                if peak_snr > max_snr:\n                    max_snr = peak_snr\n                    best_params = (m1, m2, p"]
[217.848795, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[217.848803, "i", "eak_snr)\n                \n                template_count += 1\n                \n            except Exception as e:\n                failed_count += 1\n                continue\n    \n    if best_params:\n        m1, m2, snr = best_params\n        total_mass = m1 + m2\n        results[approx] = (snr, total_mass)\n        print(f\"  Templates processed: {template_count}, Failed: {failed_count}\")\n        print(f\"  Best: m1={m1}, m2={m2}, SNR={snr:.4f}, Total Mass={total_mass}\")\n    else:\n        print(f\"  No valid templates found!\")\n\nprint(\"\\nWriting results to /root/detection_results.csv...\")\nwith open('/root/detection_results.csv', 'w') as f:\n    f.write('approximant,snr,total_mass\\n')\n    for approx in approximants:\n        if approx in results:\n            snr, total_mass = results[approx]\n            f.write(f'{approx},{snr:.4f},{int(total_mass)}\\n')\n\nprint(\"Results written successfully!\")\nprint(\"\\nFinal Results:\")\nwith open('/root/detection_results.csv', 'r') as f:\n    print(f.read())\n\nEOF\n"]
