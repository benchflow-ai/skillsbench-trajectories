[12.789404, "i", "python3 << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.filter import match_filter\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load the data\nprint(\"Loading data...\")\ntry:\n    strain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\n    print(f\"Data loaded successfully. Duration: {len(strain)/strain.sample_rate:.2f} seconds\")\nexcept Exception as e:\n    print(f\"Error loading data: {e}\")\n    exit(1)\n\n# Condition the data\nprint(\"Conditioning data...\")\nfrom pycbc.filter import highpass_fir, lowpass_fir\ntry:\n    # Highpass filter to remove low frequency noise\n    strain = highpass_fir(strain, 35, 8)\n    print(\"Highpass filtering applied\")\nexcept Exception as e:\n    print(f\"Warning during filtering: {e}\")\n\n# Estimate PSD for whitening\nprint(\"Estimating PSD...\")\ntry:\n    from pycbc.psd import welch\n    psd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=i"]
[12.789457, "i", "nt(2*strain.sample_rate))\n    psd = interpolate(psd, 1.0/strain.duration)\n    psd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\n    print(\"PSD estimated\")\nexcept Exception as e:\n    print(f\"Error estimating PSD: {e}\")\n    exit(1)\n\n# Define parameters\napproximants = [\"SEOBNRv4_opt\", \"IMRPhenomD\", \"TaylorT4\"]\nmass_range = range(10, 41)  # 10 to 40 solar masses\nresults = {}\n\nprint(f\"\\nSearching over {len(approximants)} approximants...\")\nprint(f\"Mass range: {min(mass_range)}-{max(mass_range)} solar masses\")\nprint(f\"Total templates to generate: {len(approximants) * len(mass_range) * len(mass_range)}\")\n\n# Grid search over mass parameters\nfor approx in approximants:\n    print(f\"\\nProcessing approximant: {approx}\")\n    max_snr = 0\n    best_params = None\n    template_count = 0\n    \n    for m1 in mass_range:\n        for m2 in mass_range:\n            try:\n                # Generate template\n                hp, hc = get_td_waveform(approximation=approx,\n                               "]
[12.789503, "i", "         mass1=m1, mass2=m2,\n                                        delta_t=1.0/strain.sample_rate,\n                                        f_lower=35)\n                \n                # Resize template to match strain length\n                if len(hp) < len(strain):\n                    hp.resize(len(strain))\n                \n                # Perform matched filtering\n                snr = match_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n                \n                # Find peak SNR\n                peak_snr = np.max(np.abs(snr))\n                \n                if peak_snr > max_snr:\n                    max_snr = peak_snr\n                    best_params = (m1, m2, peak_snr)\n                \n                template_count += 1\n                if template_count % 50 == 0:\n                    print(f\"  Processed {template_count} templates, current max SNR: {max_snr:.2f}\")\n                    \n            except Exception as e:\n                # Skip templates that fail\n                continue\n   "]
[12.789755, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from pycbc.frame import read_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.78978, "i", " \n    if best_params:\n        m1, m2, snr = best_params\n        total_mass = m1 + m2\n        results[approx] = (snr, total_mass)\n        print(f\"  Best match: m1={m1}, m2={m2}, SNR={snr:.4f}, Total Mass={total_mass}\")\n    else:\n        print(f\"  No valid templates found for {approx}\")\n\n# Write results to CSV\nprint(\"\\nWriting results to /root/detection_results.csv...\")\ntry:\n    with open('/root/detection_results.csv', 'w') as f:\n        f.write('approximant,snr,total_mass\\n')\n        for approx in approximants:\n            if approx in results:\n                snr, total_mass = results[approx]\n                f.write(f'{approx},{snr:.4f},{int(total_mass)}\\n')\n    print(\"Results written successfully!\")\nexcept Exception as e:\n    print(f\"Error writing results: {e}\")\n    exit(1)\n\nprint(\"\\nTask completed!\")\nEOF\n"]
