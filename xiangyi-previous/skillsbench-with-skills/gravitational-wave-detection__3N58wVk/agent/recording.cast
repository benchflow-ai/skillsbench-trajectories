[226.973621, "o", "\u001b[?2004hroot@7025ea790558:~# "]
[286.514107, "i", "python3 << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.filter.matchedfilter import matched_filter\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation, welch\nfrom pycbc.filter import highpass_fir\nimport traceback\n\nprint(\"Loading and conditioning data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nstrain = highpass_fir(strain, 35, 8)\n\nprint(\"Estimating PSD...\")\npsd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=int(2*strain.sample_rate))\npsd = interpolate(psd, 1.0/strain.duration)\npsd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\n\nprint(\"\\n=== Testing SEOBNRv4_opt (m1=20, m2=20) ===\")\ntry:\n    hp, hc = get_td_waveform(approximation=\"SEOBNRv4_opt\",\n                            mass1=20, mass2=20,\n                            delta_t=1.0/strain.sample_rate,\n                            f_lower=35)\n    print(f\"Template generated: {len(hp)} samples\")\n    print(f\""]
[286.514165, "i", "Strain: {len(strain)} samples\")\n    \n    if len(hp) < len(strain):\n        hp.resize(len(strain))\n    \n    print(\"Calling matched_filter...\")\n    snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n    print(f\"Matched filter returned: {type(snr)}, length: {len(snr)}\")\n    peak_snr = np.max(np.abs(snr))\n    print(f\"Peak SNR: {peak_snr}\")\nexcept Exception as e:\n    print(f\"ERROR: {e}\")\n    traceback.print_exc()\n\nprint(\"\\n=== Testing IMRPhenomD (m1=20, m2=20) ===\")\ntry:\n    hp, hc = get_td_waveform(approximation=\"IMRPhenomD\",\n                            mass1=20, mass2=20,\n                            delta_t=1.0/strain.sample_rate,\n                            f_lower=35)\n    print(f\"Template generated: {len(hp)} samples\")\n    if len(hp) < len(strain):\n        hp.resize(len(strain))\n    snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n    peak_snr = np.max(np.abs(snr))\n    print(f\"Peak SNR: {peak_snr}\")\nexcept Exception as e:\n    print(f\"ERROR: {e}\")\n    traceback.print_exc()\n\npri"]
[286.514184, "i", "nt(\"\\n=== Testing TaylorT4 (m1=20, m2=20) ===\")\ntry:\n    hp, hc = get_td_waveform(approximation=\"TaylorT4\",\n                            mass1=20, mass2=20,\n                            delta_t=1.0/strain.sample_rate,\n                            f_lower=35)\n    print(f\"Template generated: {len(hp)} samples\")\n    if len(hp) < len(strain):\n        hp.resize(len(strain))\n    snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n    peak_snr = np.max(np.abs(snr))\n    print(f\"Peak SNR: {peak_snr}\")\nexcept Exception as e:\n    print(f\"ERROR: {e}\")\n    traceback.print_exc()\n\nEOF\n"]
