[150.976278, "i", "python3 << 'EOF'\nimport numpy as np\nfrom pycbc.frame import read_frame\nfrom pycbc.waveform import get_td_waveform\nfrom pycbc.filter.matchedfilter import matched_filter\nfrom pycbc.psd import interpolate, inverse_spectrum_truncation\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load the data\nprint(\"Loading data...\")\nstrain = read_frame('/root/data/PyCBC_T2_2.gwf', 'H1:TEST-STRAIN')\nprint(f\"Data loaded: {len(strain)} samples at {strain.sample_rate} Hz\")\n\n# Condition the data\nprint(\"Conditioning data...\")\nfrom pycbc.filter import highpass_fir\nstrain = highpass_fir(strain, 35, 8)\nprint(\"Highpass filtering applied\")\n\n# Estimate PSD\nprint(\"Estimating PSD...\")\nfrom pycbc.psd import welch\npsd = welch(strain, seg_len=int(4*strain.sample_rate), seg_stride=int(2*strain.sample_rate))\npsd = interpolate(psd, 1.0/strain.duration)\npsd = inverse_spectrum_truncation(psd, int(4*strain.sample_rate), trunc_method='hann')\nprint(\"PSD estimated\")\n\n# Test template generation\nprint(\"\\nTesting template generation...\")\ntry:\n    pr"]
[150.976479, "i", "int(\"Generating SEOBNRv4_opt template (m1=20, m2=20)...\")\n    hp, hc = get_td_waveform(approximation=\"SEOBNRv4_opt\",\n                            mass1=20, mass2=20,\n                            delta_t=1.0/strain.sample_rate,\n                            f_lower=35)\n    print(f\"Template generated: {len(hp)} samples\")\n    print(f\"Strain length: {len(strain)} samples\")\n    \n    # Try matched filtering\n    print(\"Attempting matched filter...\")\n    if len(hp) < len(strain):\n        hp.resize(len(strain))\n    snr = matched_filter(hp, strain, psd=psd, low_frequency_cutoff=35)\n    peak_snr = np.max(np.abs(snr))\n    print(f\"Matched filter successful! Peak SNR: {peak_snr:.4f}\")\nexcept Exception as e:\n    print(f\"Error: {type(e).__name__}: {e}\")\n    import traceback\n    traceback.print_exc()\n\nEOF\n"]
