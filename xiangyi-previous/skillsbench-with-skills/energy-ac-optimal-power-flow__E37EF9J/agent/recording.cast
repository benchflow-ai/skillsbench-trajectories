[215.099965, "i", "cat > /tmp/dc_opf_solver.py << 'EOFSCRIPT'\nimport json\nimport numpy as np\nimport cvxpy as cp\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('/root/network.json', 'r') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data['baseMVA']\nbus_data = np.array(network_data['bus'])\ngen_data = np.array(network_data['gen'])\nbranch_data = np.array(network_data['branch'])\ngencost_data = np.array(network_data['gencost'])\n\n# Column indices\nBUS_I, BUS_TYPE, PD, QD, GS, BS, VMAX, VMIN = 0, 1, 2, 3, 4, 5, 11, 12\nGEN_BUS, GEN_PG, GEN_QG, GEN_QMAX, GEN_QMIN, GEN_STATUS, GEN_PMAX, GEN_PMIN = 0, 1, 2, 3, 4, 7, 8, 9\nBR_FBUS, BR_TBUS, BR_R, BR_X, BR_B, BR_RATE_A, BR_STATUS = 0, 1, 2, 3, 4, 5, 10\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\nnum_branch = len(branch_data)\n\nprint(f\"DC-OPF Solver\")\nprint(f\"Base MVA: {base_mva}\")\nprint(f\"Buses: {num_bus}, Generators: {num_gen}, Branches: {num_branch}\")\n\n# Create bus index mapping\nbus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]\n\n# Identify slack bus\nslack_bus_idx = None\nfor i in range(num_bus):\n    if int(bus_data[i, BUS_TYPE]) == 3:\n        slack_bus_idx = i\n        break\nif slack_bus_idx is None:\n    slack_bus_idx = 0\n\nprint(f\"Slack bus: {int(bus_data[slack_bus_idx, BUS_I])} (index {slack_bus_idx})\")\n\n# Build admittance matrix for DC-OPF\n# For DC-OPF, we only care about susceptance (imaginary part)\nB = np.zeros((num_bus, num_bus))\n\nfor b_idx in range(num_branch):\n    if int(branch_data[b_idx, BR_STATUS]) == 0:\n        continue\n    \n    fbus_id = int(branch_data[b_idx, BR_FBUS])\n    tbus_id = int(branch_data[b_idx, BR_TBUS])\n    \n    if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\n        continue\n    \n    fbus = bus_idx_map[fbus_id]\n    tbus = bus_idx_map[tbus_id]\n    \n    r = branch_data[b_idx, BR_R]\n    x = branch_data[b_idx, BR_X]\n    \n    if x == 0:\n        continue\n    \n    b_line = 1.0 / x\n    \n    B[fbus, fbus] += b_line\n    B[tbus, tbus] += b_line\n    B[fbus, tbus] -= b_line\n    B[tbus, fbus] -= b_line\n\n# Remove slack bus row/column for DC-OPF\nnon_slack = [i for i in range(num_bus) if i != slack_bus_idx]\nB_reduced = B[np.ix_(non_slack, non_slack)]\n\nprint(f\"Admittance matrix built (size {len(non_slack)}x{len(non_slack)})\")\n\n# DC-OPF formulation\n# Variables\npg = cp.Variable(num_gen)  # Real power generation\ntheta = cp.Variable(len(non_slack))  # Bus voltage angles (slack angle = 0)\n\n# Objective: minimize generation cost\ncost = 0\nfor i in range(num_gen):\n    if int(gencost_data[i, 0]) == 2:  # Polynomial cost\n        n = int(gencost_data[i, 3])\n        if n >= 2:\n            c2 = gencost_data[i, 4]\n            c1 = gencost_data[i, 5] if n >= 2 else 0\n            c0 = gencost_data[i, 6] if n >= 3 else 0\n            cost += c2 * pg[i]**2 + c1 * pg[i] + c0\n        elif n == 1:\n            c1 = gencost_data[i, 4]\n            c0 = gencost_data[i, 5] if n >= 2 else 0\n            cost += c1 * pg[i] + c0\n    else:\n        # Piecewise linear\n        cost += gencost_data[i, 4] * pg[i]\n\n# Constraints\nconstraints = []\n\n# Generator limits\nfor i in range(num_gen):\n    constraints.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)\n    constraints.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)\n\n# Power balance (DC approximation)\nfor idx, bus_idx in enumerate(non_slack):\n    # Load\n    p_load = bus_data[bus_idx, PD] / base_mva\n    \n    # Generation at this bus\n    p_gen = 0\n    for g_idx in range(num_gen):\n        if gen_bus_indices[g_idx] == bus_idx:\n            p_gen = p_gen + pg[g_idx]\n    \n    # Power flow equation: sum of flows = generation - load\n    # For DC-OPF: P_ij = B_ij * (theta_i - theta_j)\n    flow_sum = 0\n    for b_idx in range(num_branch):\n        if int(branch_data[b_idx, BR_STATUS]) == 0:\n            continue\n        \n        fbus_id = int(branch_data[b_idx, BR_FBUS])\n        tbus_id = int(branch_data[b_idx, BR_TBUS])\n        \n        if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\n            continue\n        \n        "]
[215.100117, "i", "fbus = bus_idx_map[fbus_id]\n        tbus = bus_idx_map[tbus_id]\n        \n        r = branch_data[b_idx, BR_R]\n        x = branch_data[b_idx, BR_X]\n        \n        if x == 0:\n            continue\n        \n        b_line = 1.0 / x\n        \n        if fbus == bus_idx:\n            # From this bus\n            if tbus == slack_bus_idx:\n                flow_sum = flow_sum + b_line * theta[idx]\n            else:\n                tbus_idx = non_slack.index(tbus)\n                flow_sum = flow_sum + b_line * (theta[idx] - theta[tbus_idx])\n        elif tbus == bus_idx:\n            # To this bus\n            if fbus == slack_bus_idx:\n                flow_sum = flow_sum - b_line * theta[idx]\n            else:\n                fbus_idx = non_slack.index(fbus)\n                flow_sum = flow_sum + b_line * (theta[idx] - theta[fbus_idx])\n    \n    constraints.append(p_gen - p_load == flow_sum)\n\n# Solve\nprint(\"Solving DC-OPF...\")\nproblem = cp.Problem(cp.Minimize(cost), constraints)\nproblem.solve(solver=cp.ECOS, verbose=False)\n\nprint(f\"Status: {problem.status}\")\nprint(f\"Optimal cost: {problem.value:.2f}\")\n\n# Extract results\npg_opt = np.array(pg.value) * base_mva\ntheta_opt = np.array(theta.value) * 180 / np.pi\n\nprint(f\"Total generation: {pg_opt.sum():.2f} MW\")\nprint(f\"Total load: {bus_data[:, PD].sum():.2f} MW\")\n\n# Store results for later use\nresults = {\n    'pg': pg_opt,\n    'theta': theta_opt,\n    'slack_idx': slack_bus_idx,\n    'non_slack': non_slack,\n    'cost': problem.value\n}\n\nnp.save('/tmp/dc_opf_results.npy', results, allow_pickle=True)\nprint(\"\\nResults saved!\")\n\nEOFSCRIPT\n"]
[215.100404, "o", "cat > /tmp/dc_opf_solver.py << 'EOFSCRIPT'\r\n\u001b[?2004l\r"]
