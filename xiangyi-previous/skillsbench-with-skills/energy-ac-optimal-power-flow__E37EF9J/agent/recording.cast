[269.369405, "i", "python3 << 'EOF'\nimport json\nimport numpy as np\n\n# Load network data\nwith open('/root/network.json', 'r') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data['baseMVA']\nbus_data = np.array(network_data['bus'])\ngen_data = np.array(network_data['gen'])\n\n# Column indices\nBUS_I, PD = 0, 2\nGEN_BUS = 0\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\n\nbus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]\n\n# Check generator distribution\nprint(\"Generators per bus:\")\nfor bus_idx in range(num_bus):\n    gens_at_bus = [g for g in range(num_gen) if gen_bus_indices[g] == bus_idx]\n    if len(gens_at_bus) > 0:\n        print(f\"  Bus {int(bus_data[bus_idx, BUS_I])}: {len(gens_at_bus)} generators\")\n\nprint(f\"\\nTotal load: {bus_data[:, PD].sum():.2f} MW\")\nprint(f\"Total gen capacity: {gen_data[:, 8].sum():.2f} MW\")\nprint(f\"Min gen capacity: {gen_data[:, 9].sum():.2f} MW\")\n\nEOF\n"]
