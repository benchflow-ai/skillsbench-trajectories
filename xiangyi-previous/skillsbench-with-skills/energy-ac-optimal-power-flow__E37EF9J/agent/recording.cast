[285.236784, "i", "cat > /tmp/dc_opf_v3.py << 'EOFSCRIPT'\nimport json\nimport numpy as np\nimport cvxpy as cp\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('/root/network.json', 'r') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data['baseMVA']\nbus_data = np.array(network_data['bus'])\ngen_data = np.array(network_data['gen'])\nbranch_data = np.array(network_data['branch'])\ngencost_data = np.array(network_data['gencost'])\n\nBUS_I, BUS_TYPE, PD = 0, 1, 2\nGEN_BUS, GEN_PMAX, GEN_PMIN = 0, 8, 9\nBR_FBUS, BR_TBUS, BR_X, BR_STATUS = 0, 1, 3, 10\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\nnum_branch = len(branch_data)\n\nprint(f\"DC-OPF V3: {num_bus} buses, {num_gen} gens, {num_branch} branches\")\n\n# Bus mapping\nbus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_bus_indices = np.array([bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)])\n\n# Slack bus\nslack_idx = np.where(bus_data[:, BUS_TYPE] == 3)[0]\nslack_idx = slack_idx[0] if len(slack_idx) > 0 else 0\nprint(f\"Slack bus: {int(bus_data[slack_idx, BUS_I])} (index {slack_idx})\")\n\n# Build B matrix\nB = np.zeros((num_bus, num_bus))\nfor b_idx in range(num_branch):\n    if int(branch_data[b_idx, BR_STATUS]) == 0:\n        continue\n    fbus_id = int(branch_data[b_idx, BR_FBUS])\n    tbus_id = int(branch_data[b_idx, BR_TBUS])\n    if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\n        continue\n    fbus = bus_idx_map[fbus_id]\n    tbus = bus_idx_map[tbus_id]\n    x = branch_data[b_idx, BR_X]\n    if x != 0:\n        b_val = 1.0 / x\n        B[fbus, fbus] += b_val\n        B[tbus, tbus] += b_val\n        B[fbus, tbus] -= b_val\n        B[tbus, fbus] -= b_val\n\n# Remove slack row and column\nnon_slack = np.array([i for i in range(num_bus) if i != slack_idx])\nB_red = B[np.ix_(non_slack, non_slack)]\nB_slack_col = B[np.ix_(non_slack, [slack_idx])].flatten()\n\nprint(f\"Reduced B: {B_red.shape}\")\n\n# Build generation incidence matrix\nC_gen = np.zeros((len(non_slack), num_gen))\nfor g_idx in range(num_gen):\n    bus_idx = gen_bus_indices[g_idx]\n    if bus_idx in non_slack:\n        row = np.where(non_slack == bus_idx)[0][0]\n        C_gen[row, g_idx] = 1.0\n\nprint(f\"C_gen: {C_gen.shape}\")\nprint(f\"Generators per bus (non-slack): {C_gen.sum(axis=1).max():.0f} max\")\n\n# Load vector\np_load = bus_data[non_slack, PD] / base_mva\nprint(f\"Total load: {p_load.sum() * base_mva:.2f} MW\")\n\n# Variables\npg = cp.Variable(num_gen)\ntheta = cp.Variable(len(non_slack))\n\n# Cost function\ncost = 0\nfor i in range(num_gen):\n    n = int(gencost_data[i, 3])\n    c = gencost_data[i, 4:4+n]\n    for k, coeff in enumerate(c):\n        power = n - 1 - k\n        cost += coeff * (pg[i] ** max(power, 0))\n\n# Constraints\ncons = []\n\n# Generator bounds\nfor i in range(num_gen):\n    cons.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)\n    cons.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)\n\n# Power balance: C_gen @ pg = B_red @ theta + p_load\ncons.append(C_gen @ pg == B_red @ theta + p_load)\n\nprint(f\"Solving with {len(cons)} constraints...\")\nproblem = cp.Problem(cp.Minimize(cost), cons)\nproblem.solve(solver=cp.SCS, verbose=False, max_iters=5000, eps=1e-4)\n\nprint(f\"Status: {problem.status}\")\nif problem.status == 'optimal':\n    pg_opt = np.array(pg.value) * base_mva\n    theta_opt = np.array(theta.value)\n    \n    print(f\"Optimal cost: ${problem.value:.2f}\")\n    print(f\"Total generation: {pg_opt.sum():.2f} MW\")\n    print(f\"Total load: {p_load.sum() * base_mva:.2f} MW\")\n    print(f\"Mismatch: {(pg_opt.sum() - p_load.sum() * base_mva):.2f} MW\")\n    \n    # Save results\n    np.savez('/tmp/dc_results.npz', pg=pg_opt, theta=theta_opt, cost=problem.value,\n             slack_idx=slack_idx, non_slack=non_slack)\n    print(\"Results saved to /tmp/dc_results.npz\")\nelse:\n    print(f\"Failed to solve: {problem.status}\")\n\nEOFSCRIPT\n"]
