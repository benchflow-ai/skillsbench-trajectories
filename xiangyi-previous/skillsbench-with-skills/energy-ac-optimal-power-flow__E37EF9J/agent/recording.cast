[252.115542, "o", "\u001b[?2004h> "]
[252.115578, "o", "    bus_idx = gen_bus_indices[g_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115628, "o", "    if bus_idx in non_slack_idx:\r\n\u001b[?2004l\r"]
[252.115672, "o", "\u001b[?2004h> "]
[252.115715, "o", "        row_idx = non_slack_idx.index(bus_idx)\r\n\u001b[?2004l\r"]
[252.115758, "o", "\u001b[?2004h> "]
[252.115802, "o", "        C_gen[row_idx, g_idx] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.115854, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115901, "o", "# Power balance: C_gen @ pg - p_load = B_red @ theta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.115983, "o", "# Rearrange: C_gen @ pg = B_red @ theta + p_load\r\n\u001b[?2004l\r"]
[252.116026, "o", "\u001b[?2004h> "]
[252.116081, "o", "cons.append(C_gen @ pg == B_red @ theta + p_load_red)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.116125, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.116178, "o", "print(f\"Total constraints: {len(cons)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.11622, "o", "print(f\"Solving...\")\r\n\u001b[?2004l\r"]
[252.116263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.11632, "o", "problem = cp.Problem(cp.Minimize(cost), cons)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.116451, "o", "problem.solve(solver=cp.SCS, verbose=False, max_iters=5000)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.116515, "o", "print(f\"Status: {problem.status}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.116565, "o", "> "]
[252.1166, "o", "print(f\"Optimal cost: {problem.value:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[252.116644, "o", "\u001b[?2004h> "]
[252.116695, "o", "if problem.status == 'optimal':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.11675, "o", "    pg_opt = np.array(pg.value) * base_mva\r\n\u001b[?2004l\r"]
[252.116797, "o", "\u001b[?2004h> "]
[252.116849, "o", "    print(f\"Total generation: {pg_opt.sum():.2f} MW\")\r\n\u001b[?2004l\r"]
[252.116902, "o", "\u001b[?2004h> "]
[252.116953, "o", "    print(f\"Total load: {p_load.sum() * base_mva:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117028, "o", "    print(f\"\\nSample generator outputs:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.117073, "o", "> "]
[252.117107, "o", "    for i in range(min(5, num_gen)):\r\n\u001b[?2004l\r"]
[252.117169, "o", "\u001b[?2004h> "]
[252.117212, "o", "        print(f\"  Gen {i}: {pg_opt[i]:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117262, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117311, "o", "    print(f\"Optimization failed!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.117358, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOFSCRIPT\r\n\u001b[?2004l\r"]
