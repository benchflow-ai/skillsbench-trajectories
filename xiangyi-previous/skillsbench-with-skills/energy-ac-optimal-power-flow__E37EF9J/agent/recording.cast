[134.77473, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[134.774792, "o", "\u001b[?2004h> "]
[134.775038, "o", "from scipy.optimize import minimize, LinearConstraint, NonlinearConstraint, Bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.775104, "o", "import warnings\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.775167, "o", "> "]
[134.775236, "o", "warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r"]
[134.775258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[134.775353, "o", "\u001b[?2004h> # Load network data\r\n\u001b[?2004l\r el\u001b[?2004h"]
[134.775384, "o", "> "]
[134.775531, "o", "with open('/root/network.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.77556, "o", "> "]
[134.775628, "o", "    network_data = json.load(f)\r\n\u001b[?2004l\r"]
[134.775689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.775741, "o", "> "]
[134.775788, "o", "base_mva = network_data['baseMVA']\r\n\u001b[?2004l\r"]
[134.775908, "o", "\u001b[?2004h> "]
[134.776013, "o", "bus_data = np.array(network_data['bus'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.776088, "o", "gen_data = np.array(network_data['gen'])\r\n\u001b[?2004l\r \u001b[?2004h> "]
[134.776157, "o", "branch_data = np.array(network_data['branch'])\r\n\u001b[?2004l\r*\u001b[?2004h"]
[134.776202, "o", "> "]
[134.776308, "o", "gencost_data = np.array(network_data['gencost'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[134.776363, "o", "\u001b[?2004h> "]
[134.776394, "o", "# Column indices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.776619, "o", "BUS_I, BUS_TYPE, PD, QD, GS, BS, VMAX, VMIN = 0, 1, 2, 3, 4, 5, 11, 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.776933, "o", "GEN_BUS, GEN_PG, GEN_QG, GEN_QMAX, GEN_QMIN, GEN_VMAX, GEN_STATUS, GEN_PMAX, GEN_PMIN = 0, 1, 2, 3, 4, 5, 7, 8, 9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.777138, "o", "BR_FBUS, BR_TBUS, BR_R, BR_X, BR_B, BR_RATE_A, BR_STATUS = 0, 1, 2, 3, 4, 5, 10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.777199, "o", "\r\n\u001b[?2004l\r1\u001b[?2004h> "]
[134.777246, "o", "num_bus = len(bus_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.77729, "o", "num_gen = len(gen_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.777417, "o", "num_branch = len(branch_data)\r\n\u001b[?2004l\r] \u001b[?2004h> \r\n\u001b[?2004l\r*\u001b[?2004h> "]
[134.777487, "o", "# Create bus index mapping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.777592, "o", "bus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\r\n\u001b[?2004l\r"]
[134.777646, "o", "\u001b[?2004h> "]
[134.777837, "o", "gen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[134.777966, "o", "# Identify slack bus (type 3) and PV buses (type 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.778012, "o", "> "]
[134.778037, "o", "slack_bus_idx = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.778099, "o", "for i in range(num_bus):\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.778123, "o", "> "]
[134.778226, "o", "    if int(bus_data[i, BUS_TYPE]) == 3:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.778254, "o", "> "]
[134.778329, "o", "        slack_bus_idx = i\r\n\u001b[?2004l\r"]
[134.778384, "o", "\u001b[?2004h> "]
[134.778433, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.778471, "o", "if slack_bus_idx is None:\r\n\u001b[?2004l\r)\u001b[?2004h"]
[134.778522, "o", "> "]
[134.77856, "o", "    slack_bus_idx = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[134.778783, "o", "print(f\"Slack bus index: {slack_bus_idx} (Bus {int(bus_data[slack_bus_idx, BUS_I])})\")\r\n\u001b[?2004l\r"]
[134.778811, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[134.779027, "o", "# Variable ordering: [Pg (num_gen), Qg (num_gen), Vm (num_bus), Va (num_bus)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.779075, "o", "> "]
[134.779102, "o", "def get_var_indices():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.779156, "o", "    pg_start = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.779225, "o", "    pg_end = num_gen\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.779273, "o", "> "]
[134.77932, "o", "    qg_start = pg_end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.779393, "o", "    qg_end = qg_start + num_gen\r\n\u001b[?2004l\r"]
[134.779418, "o", "\u001b[?2004h> "]
[134.779472, "o", "    vm_start = qg_end\r\n\u001b[?2004l\r = \u001b[?2004h> "]
[134.779558, "o", "    vm_end = vm_start + num_bus\r\n\u001b[?2004l\r"]
[134.779602, "o", "\u001b[?2004h> "]
[134.779653, "o", "    va_start = vm_end\r\n\u001b[?2004l\r"]
[134.779701, "o", "\u001b[?2004h> "]
[134.779729, "o", "    va_end = va_start + num_bus\r\n\u001b[?2004l\r"]
[134.779755, "o", "\u001b[?2004h> "]
[134.779961, "o", "    return pg_start, pg_end, qg_start, qg_end, vm_start, vm_end, va_start, va_end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.780009, "o", "\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[134.78023, "o", "pg_start, pg_end, qg_start, qg_end, vm_start, vm_end, va_start, va_end = get_var_indices()\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.780261, "o", "> "]
[134.78031, "o", "total_vars = va_end\r\n\u001b[?2004l\rai\u001b[?2004h"]
[134.780371, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[134.780446, "o", "print(f\"Total optimization variables: {total_vars}\")\r\n\u001b[?2004l\r"]
[134.78047, "o", "\u001b[?2004h> "]
[134.780731, "o", "print(f\"  Pg: {pg_end - pg_start}, Qg: {qg_end - qg_start}, Vm: {vm_end - vm_start}, Va: {va_end - va_start}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[134.780758, "o", "\u001b[?2004h> "]
[134.780819, "o", "# Initial point\r\n\u001b[?2004l\rst\u001b[?2004h> "]
[134.780862, "o", "x0 = np.zeros(total_vars)\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[134.780973, "o", "for i in range(num_gen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.781099, "o", "    x0[pg_start + i] = gen_data[i, GEN_PG]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.781183, "o", "    x0[qg_start + i] = gen_data[i, GEN_QG]\r\n\u001b[?2004l\r"]
[134.781228, "o", "\u001b[?2004h> "]
[134.78127, "o", "for i in range(num_bus):\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[134.781476, "o", "    x0[vm_start + i] = bus_data[i, VMAX] if bus_data[i, VMAX] > 0 else 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.781559, "o", "    x0[va_start + i] = 0.0\r\n\u001b[?2004l\r"]
[134.781614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[134.781656, "o", "# Objective function: cost\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[134.781707, "o", "def objective(x):\r\n\u001b[?2004l\r"]
[134.781762, "o", "\u001b[?2004h> "]
[134.781805, "o", "    pg = x[pg_start:pg_end]\r\n\u001b[?2004l\r \u001b[?2004h> "]
[134.781844, "o", "    cost = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.781918, "o", "    for i in range(num_gen):\r\n\u001b[?2004l\r"]
[134.781943, "o", "\u001b[?2004h> "]
[134.782069, "o", "        if int(gencost_data[i, 0]) == 2:  # Polynomial cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.782094, "o", "> "]
[134.782185, "o", "            n = int(gencost_data[i, 3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.782229, "o", "> "]
[134.782321, "o", "            coeffs = gencost_data[i, 4:4+n]\r\n\u001b[?2004l\r"]
[134.782366, "o", "\u001b[?2004h> "]
[134.782432, "o", "            # coeffs are in descending order of powers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.782513, "o", "            for j, c in enumerate(coeffs):\r\n\u001b[?2004l\r"]
[134.782557, "o", "\u001b[?2004h> "]
[134.7826, "o", "                power = n - 1 - j\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.782663, "o", "                cost += c * (pg[i] ** power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.782708, "o", "> "]
[134.782756, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.782811, "o", "            # Piecewise linear - use first two coefficients\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.782862, "o", "> "]
[134.782928, "o", "            cost += gencost_data[i, 4] * pg[i] + gencost_data[i, 5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.782974, "o", "> "]
[134.783026, "o", "    return cost\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[134.783062, "o", "\u001b[?2004h> # Power balance constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783101, "o", "def power_balance(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783151, "o", "    pg = x[pg_start:pg_end]\r\n\u001b[?2004l\r"]
[134.783195, "o", "\u001b[?2004h> "]
[134.783246, "o", "    qg = x[qg_start:qg_end]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783284, "o", "    vm = x[vm_start:vm_end]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783331, "o", "    va = x[va_start:va_end]\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.783377, "o", ">     \r\n\u001b[?2004l\r"]
[134.78343, "o", "\u001b[?2004h> "]
[134.783466, "o", "    constraints = np.zeros(2 * num_bus)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.78351, "o", "> "]
[134.783549, "o", "    for i in range(num_bus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783586, "o", "        # Real power balance\r\n\u001b[?2004l\r"]
[134.78363, "o", "\u001b[?2004h> "]
[134.78368, "o", "        p_balance = -bus_data[i, PD] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.783723, "o", "> "]
[134.783767, "o", "        q_balance = -bus_data[i, QD] / base_mva\r\n\u001b[?2004l\r"]
[134.783818, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[134.783853, "o", "\u001b[?2004h> "]
[134.783897, "o", "        # Add shunt admittance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.783976, "o", "        p_balance -= bus_data[i, GS] * vm[i]**2 / base_mva\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.784074, "o", "        q_balance += bus_data[i, BS] * vm[i]**2 / base_mva\r\n\u001b[?2004l\r"]
[134.784097, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[134.784142, "o", "\u001b[?2004h> "]
[134.784203, "o", "        # Add generation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.784248, "o", "        for g_idx in range(num_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.784284, "o", "> "]
[134.784329, "o", "            if gen_bus_indices[g_idx] == i:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.784378, "o", "> "]
[134.784424, "o", "                p_balance += pg[g_idx] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.784473, "o", "> "]
[134.784517, "o", "                q_balance += qg[g_idx] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.784567, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.784625, "o", "        # Add branch flows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.78467, "o", "        for b_idx in range(num_branch):\r\n\u001b[?2004l\r"]
[134.784716, "o", "\u001b[?2004h> "]
[134.784772, "o", "            if int(branch_data[b_idx, BR_STATUS]) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.784822, "o", "> "]
[134.784859, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[134.784911, "o", "\u001b[?2004h> "]
[134.784993, "o", "            fbus = bus_idx_map.get(int(branch_data[b_idx, BR_FBUS]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785125, "o", "            tbus = bus_idx_map.get(int(branch_data[b_idx, BR_TBUS]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.78515, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.785199, "o", "> "]
[134.785262, "o", "            if fbus is None or tbus is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785301, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785345, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785407, "o", "            r = branch_data[b_idx, BR_R]\r\n\u001b[?2004l\r"]
[134.785451, "o", "\u001b[?2004h> "]
[134.785488, "o", "            x = branch_data[b_idx, BR_X]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785564, "o", "            b = branch_data[b_idx, BR_B]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785617, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.785658, "o", ">             if r**2 + x**2 == 0:\r\n\u001b[?2004l\r"]
[134.785703, "o", "\u001b[?2004h> "]
[134.785748, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785793, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785843, "o", "            z = r + 1j*x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.785888, "o", "            y = 1.0 / z if z != 0 else 0\r\n\u001b[?2004l\r"]
[134.785932, "o", "\u001b[?2004h> "]
[134.785983, "o", "            g = y.real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786019, "o", "            b_series = y.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.78607, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786106, "o", "            if i == fbus:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.78615, "o", "                # From bus\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.786201, "o", "> "]
[134.786265, "o", "                vi = vm[i] * np.exp(1j * va[i] * np.pi / 180)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786378, "o", "                vj = vm[tbus] * np.exp(1j * va[tbus] * np.pi / 180)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.786423, "o", "> "]
[134.786468, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786642, "o", "                s_ij = vi * np.conj(g + 1j*(b_series + b/2)) * np.conj(vi) - vi * np.conj(g + 1j*b_series) * np.conj(vj)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786696, "o", "                p_balance -= s_ij.real\r\n\u001b[?2004l\r"]
[134.786748, "o", "\u001b[?2004h> "]
[134.786782, "o", "                q_balance -= s_ij.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786833, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786874, "o", "            elif i == tbus:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.786915, "o", "                # To bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787019, "o", "                vi = vm[i] * np.exp(1j * va[i] * np.pi / 180)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787137, "o", "                vj = vm[fbus] * np.exp(1j * va[fbus] * np.pi / 180)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787187, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787412, "o", "                s_ji = vi * np.conj(g + 1j*(b_series + b/2)) * np.conj(vi) - vi * np.conj(g + 1j*b_series) * np.conj(vj)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787441, "o", "                p_balance -= s_ji.real\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.787498, "o", "> "]
[134.787521, "o", "                q_balance -= s_ji.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787566, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.787592, "o", "> "]
[134.787646, "o", "        constraints[i] = p_balance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787731, "o", "        constraints[num_bus + i] = q_balance\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787777, "o", "    return constraints\r\n\u001b[?2004l\r"]
[134.787799, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.787844, "o", "# Bounds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.7879, "o", "lb = np.zeros(total_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.78794, "o", "ub = np.zeros(total_vars)\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.787987, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.788032, "o", "for i in range(num_gen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.788109, "o", "    lb[pg_start + i] = gen_data[i, GEN_PMIN] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.788153, "o", "> "]
[134.788211, "o", "    ub[pg_start + i] = gen_data[i, GEN_PMAX] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.788263, "o", "> "]
[134.788308, "o", "    lb[qg_start + i] = gen_data[i, GEN_QMIN] / base_mva\r\n\u001b[?2004l\r"]
[134.788359, "o", "\u001b[?2004h> "]
[134.788412, "o", "    ub[qg_start + i] = gen_data[i, GEN_QMAX] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.788463, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.7885, "o", "> for i in range(num_bus):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.788571, "o", "    lb[vm_start + i] = bus_data[i, VMIN]\r\n\u001b[?2004l\r"]
[134.788621, "o", "\u001b[?2004h> "]
[134.788667, "o", "    ub[vm_start + i] = bus_data[i, VMAX]\r\n\u001b[?2004l\r"]
[134.788722, "o", "\u001b[?2004h> "]
[134.78876, "o", "    lb[va_start + i] = -np.pi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.788784, "o", "    ub[va_start + i] = np.pi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[134.788844, "o", "> "]
[134.788892, "o", "bounds = Bounds(lb, ub)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.788928, "o", "# Slack bus angle constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789062, "o", "constraints_list = [{'type': 'eq', 'fun': lambda x: x[va_start + slack_bus_idx]}]\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.789132, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789181, "o", "# Power balance constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789261, "o", "constraints_list.append({'type': 'eq', 'fun': power_balance})\r\n\u001b[?2004l\r"]
[134.789306, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789358, "o", "print(\"Starting optimization...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.78941, "o", "> "]
[134.789514, "o", "result = minimize(objective, x0, method='SLSQP', bounds=bounds, constraints=constraints_list,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789616, "o", "                 options={'maxiter': 1000, 'ftol': 1e-6})\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.78966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789723, "o", "print(f\"Optimization result: {result.message}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789792, "o", "print(f\"Success: {result.success}\")\r\n\u001b[?2004l\r"]
[134.789838, "o", "\u001b[?2004h> "]
[134.789893, "o", "print(f\"Cost: {result.fun}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789932, "o", "# Extract results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.789999, "o", "pg_opt = result.x[pg_start:pg_end] * base_mva\r\n\u001b[?2004l\r"]
[134.790045, "o", "\u001b[?2004h> "]
[134.790087, "o", "qg_opt = result.x[qg_start:qg_end] * base_mva\r\n\u001b[?2004l\r"]
[134.79013, "o", "\u001b[?2004h> "]
[134.790175, "o", "vm_opt = result.x[vm_start:vm_end]\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.790225, "o", "> "]
[134.790264, "o", "va_opt = result.x[va_start:va_end] * 180 / np.pi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[134.790315, "o", "\u001b[?2004h> "]
[134.790367, "o", "print(f\"\\nOptimization completed!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[134.790441, "o", "print(f\"Total generation: {pg_opt.sum():.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[134.790486, "o", "> "]
[134.790532, "o", "print(f\"Total load: {bus_data[:, PD].sum():.2f} MW\")\r\n\u001b[?2004l\r"]
[134.790577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
