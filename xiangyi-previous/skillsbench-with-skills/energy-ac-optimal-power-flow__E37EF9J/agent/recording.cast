[350.217334, "i", "python3 << 'EOF'\nimport json\nwith open('/root/report.json', 'r') as f:\n    report = json.load(f)\n    print(\"Report structure:\")\n    print(f\"  Summary keys: {list(report['summary'].keys())}\")\n    print(f\"  Generators: {len(report['generators'])}\")\n    print(f\"  Buses: {len(report['buses'])}\")\n    print(f\"  Most loaded branches: {len(report['most_loaded_branches'])}\")\n    print(f\"  Feasibility check keys: {list(report['feasibility_check'].keys())}\")\n    print(\"\\nReport is valid JSON!\")\nEOF\n"]
