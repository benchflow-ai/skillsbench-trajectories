[113.093318, "i", "python3 << 'EOFPYTHON'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('network.json', 'r') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data['baseMVA']\nbus_data = np.array(network_data['bus'])\ngen_data = np.array(network_data['gen'])\nbranch_data = np.array(network_data['branch'])\ngencost_data = np.array(network_data['gencost'])\n\nprint(f\"Base MVA: {base_mva}\")\nprint(f\"Number of buses: {len(bus_data)}\")\nprint(f\"Number of generators: {len(gen_data)}\")\nprint(f\"Number of branches: {len(branch_data)}\")\nprint(f\"Number of generator costs: {len(gencost_data)}\")\n\n# MATPOWER bus column indices\n# [bus_i, type, Pd, Qd, Gs, Bs, area, Vm, Va, baseKV, zone, Vmax, Vmin]\nBUS_I = 0\nBUS_TYPE = 1\nPD = 2\nQD = 3\nGS = 4\nBS = 5\nVMAX = 11\nVMIN = 12\n\n# MATPOWER gen column indices\n# [bus, Pg, Qg, Qmax, Qmin, Vg, mBase, status, Pmax, Pmin]\nGEN_BUS = 0\nGEN_PG = 1\nGEN_QG = 2\nGEN_QMAX = 3\nGEN_QMIN = 4\nGEN_VG = 5\nGEN_MBASE = 6\nGEN_STATUS = 7\nGEN_PMAX = 8\nGEN_PMIN = 9\n\n# MATPOWER branch column indices\n# [fbus, tbus, r, x, b, rateA, rateB, rateC, ratio, angle, status, angmin, angmax]\nBR_FBUS = 0\nBR_TBUS = 1\nBR_R = 2\nBR_X = 3\nBR_B = 4\nBR_RATE_A = 5\nBR_STATUS = 10\n\n# MATPOWER gencost column indices\n# [type, startup, shutdown, n, c(n-1), ..., c0]\nGENCOST_TYPE = 0\nGENCOST_N = 3\n\nprint(\"\\nNetwork data loaded successfully!\")\nEOFPYTHON\n"]
