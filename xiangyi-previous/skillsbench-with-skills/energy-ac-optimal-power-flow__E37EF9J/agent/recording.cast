[215.104584, "o", "    slack_bus_idx = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[215.104637, "o", "}\u001b[?2004h> "]
[215.10485, "o", "print(f\"Slack bus: {int(bus_data[slack_bus_idx, BUS_I])} (index {slack_bus_idx})\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[215.104896, "o", "t\u001b[?2004h> "]
[215.104964, "o", "# Build admittance matrix for DC-OPF\r\n\u001b[?2004l\r"]
[215.104988, "o", "\u001b[?2004h> "]
[215.105163, "o", "# For DC-OPF, we only care about susceptance (imaginary part)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105211, "o", "> "]
[215.105267, "o", "B = np.zeros((num_bus, num_bus))\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105291, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[215.105379, "o", "for b_idx in range(num_branch):\r\n\u001b[?2004l\r"]
[215.105427, "o", "\u001b[?2004h> "]
[215.105506, "o", "    if int(branch_data[b_idx, BR_STATUS]) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105551, "o", "> "]
[215.105597, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.105664, "o", "    fbus_id = int(branch_data[b_idx, BR_FBUS])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105708, "o", "> "]
[215.10575, "o", "    tbus_id = int(branch_data[b_idx, BR_TBUS])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105801, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.10585, "o", "> "]
[215.105895, "o", "    if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\r\n\u001b[?2004l\r"]
[215.105933, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.105976, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.106021, "o", "> "]
[215.106072, "o", "    fbus = bus_idx_map[fbus_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106121, "o", "    tbus = bus_idx_map[tbus_id]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[215.106172, "o", "\u001b[?2004h> "]
[215.106219, "o", "    r = branch_data[b_idx, BR_R]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106266, "o", "    x = branch_data[b_idx, BR_X]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106304, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     if x == 0:\r\n\u001b[?2004l\r"]
[215.106329, "o", "\u001b[?2004h> "]
[215.106393, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106445, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     b_line = 1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.106493, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10654, "o", "    B[fbus, fbus] += b_line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10658, "o", "    B[tbus, tbus] += b_line\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.106625, "o", "> "]
[215.106671, "o", "    B[fbus, tbus] -= b_line\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106717, "o", "    B[tbus, fbus] -= b_line\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.106768, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.106813, "o", "# Remove slack bus row/column for DC-OPF\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.106861, "o", "> "]
[215.106907, "o", "non_slack = [i for i in range(num_bus) if i != slack_bus_idx]\r\n\u001b[?2004l\r"]
[215.10695, "o", "\u001b[?2004h> "]
[215.10699, "o", "B_reduced = B[np.ix_(non_slack, non_slack)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.107044, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107134, "o", "print(f\"Admittance matrix built (size {len(non_slack)}x{len(non_slack)})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.107184, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107223, "o", "# DC-OPF formulation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107273, "o", "# Variables\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107333, "o", "pg = cp.Variable(num_gen)  # Real power generation\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.107387, "o", "> "]
[215.107469, "o", "theta = cp.Variable(len(non_slack))  # Bus voltage angles (slack angle = 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[215.10752, "o", "\u001b[?2004h> "]
[215.107573, "o", "# Objective: minimize generation cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107611, "o", "cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107661, "o", "for i in range(num_gen):\r\n\u001b[?2004l\r"]
[215.107704, "o", "\u001b[?2004h> "]
[215.107743, "o", "    if int(gencost_data[i, 0]) == 2:  # Polynomial cost\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107805, "o", "        n = int(gencost_data[i, 3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.107855, "o", "> "]
[215.107903, "o", "        if n >= 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.107951, "o", "            c2 = gencost_data[i, 4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.108011, "o", "            c1 = gencost_data[i, 5] if n >= 2 else 0\r\n\u001b[?2004l\r"]
[215.108062, "o", "\u001b[?2004h> "]
[215.108105, "o", "            c0 = gencost_data[i, 6] if n >= 3 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.108156, "o", "> "]
[215.108199, "o", "            cost += c2 * pg[i]**2 + c1 * pg[i] + c0\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.108241, "o", ">         elif n == 1:\r\n\u001b[?2004l\r"]
[215.108284, "o", "\u001b[?2004h> "]
[215.108325, "o", "            c1 = gencost_data[i, 4]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.108379, "o", "> "]
[215.10842, "o", "            c0 = gencost_data[i, 5] if n >= 2 else 0\r\n\u001b[?2004l\r"]
[215.108476, "o", "\u001b[?2004h> "]
[215.108515, "o", "            cost += c1 * pg[i] + c0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[215.10856, "o", "\u001b[?2004h> "]
[215.108607, "o", "        # Piecewise linear\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.108671, "o", "        cost += gencost_data[i, 4] * pg[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.108723, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.108767, "o", "# Constraints\r\n\u001b[?2004l\r\u001b[?2004h> constraints = []\r\n\u001b[?2004l\r"]
[215.108818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10887, "o", "# Generator limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.108918, "o", "for i in range(num_gen):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.108997, "o", "    constraints.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)\r\n\u001b[?2004l\r"]
[215.109047, "o", "\u001b[?2004h> "]
[215.109135, "o", "    constraints.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.109184, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.109232, "o", "# Power balance (DC approximation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.10928, "o", "> "]
[215.109319, "o", "for idx, bus_idx in enumerate(non_slack):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10937, "o", "    # Load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.109429, "o", "    p_load = bus_data[bus_idx, PD] / base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.109482, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.109531, "o", "    # Generation at this bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.109579, "o", "    p_gen = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10962, "o", "    for g_idx in range(num_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.10967, "o", "> "]
[215.109716, "o", "        if gen_bus_indices[g_idx] == bus_idx:\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.109754, "o", "> "]
[215.109797, "o", "            p_gen = p_gen + pg[g_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.109843, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.10991, "o", "    # Power flow equation: sum of flows = generation - load\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.109961, "o", "> "]
[215.110004, "o", "    # For DC-OPF: P_ij = B_ij * (theta_i - theta_j)\r\n\u001b[?2004l\r"]
[215.110027, "o", "\u001b[?2004h> "]
[215.11009, "o", "    flow_sum = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.110141, "o", "    for b_idx in range(num_branch):\r\n\u001b[?2004l\r"]
[215.110191, "o", "\u001b[?2004h> "]
[215.110238, "o", "        if int(branch_data[b_idx, BR_STATUS]) == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.110284, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.110335, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.110379, "o", "        fbus_id = int(branch_data[b_idx, BR_FBUS])\r\n\u001b[?2004l\r"]
[215.110427, "o", "\u001b[?2004h> "]
[215.110478, "o", "        tbus_id = int(branch_data[b_idx, BR_TBUS])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.110502, "o", ">         \r\n\u001b[?2004l\r"]
[215.110562, "o", "\u001b[?2004h> "]
[215.110627, "o", "        if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.110678, "o", "> "]
[215.110728, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.110781, "o", "        fbus = bus_idx_map[fbus_id]\r\n\u001b[?2004l\r"]
[215.110826, "o", "\u001b[?2004h> "]
[215.110878, "o", "        tbus = bus_idx_map[tbus_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.110926, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.11097, "o", "        r = branch_data[b_idx, BR_R]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111018, "o", "> "]
[215.111066, "o", "        x = branch_data[b_idx, BR_X]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[215.111118, "o", "\u001b[?2004h>         if x == 0:\r\n\u001b[?2004l\r"]
[215.111163, "o", "\u001b[?2004h> "]
[215.11122, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111271, "o", ">         b_line = 1.0 / x\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.11131, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.111358, "o", "        if fbus == bus_idx:\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111408, "o", ">             # From this bus\r\n\u001b[?2004l\r"]
[215.111462, "o", "\u001b[?2004h> "]
[215.111514, "o", "            if tbus == slack_bus_idx:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.111576, "o", "                flow_sum = flow_sum + b_line * theta[idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111622, "o", "> "]
[215.111667, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.111707, "o", "                tbus_idx = non_slack.index(tbus)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111752, "o", "> "]
[215.111837, "o", "                flow_sum = flow_sum + b_line * (theta[idx] - theta[tbus_idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.111882, "o", "> "]
[215.111928, "o", "        elif tbus == bus_idx:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.111973, "o", "            # To this bus\r\n\u001b[?2004l\r"]
[215.112017, "o", "\u001b[?2004h> "]
[215.112066, "o", "            if fbus == slack_bus_idx:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112133, "o", "                flow_sum = flow_sum - b_line * theta[idx]\r\n\u001b[?2004l\r"]
[215.112183, "o", "\u001b[?2004h>             else:\r\n\u001b[?2004l\r"]
[215.112234, "o", "\u001b[?2004h> "]
[215.112279, "o", "                fbus_idx = non_slack.index(fbus)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.112326, "o", "> "]
[215.112399, "o", "                flow_sum = flow_sum + b_line * (theta[idx] - theta[fbus_idx])\r\n\u001b[?2004l\r"]
[215.112445, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112526, "o", "    constraints.append(p_gen - p_load == flow_sum)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.112577, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112629, "o", "# Solve\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112677, "o", "print(\"Solving DC-OPF...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112723, "o", "problem = cp.Problem(cp.Minimize(cost), constraints)\r\n\u001b[?2004l\r"]
[215.112777, "o", "\u001b[?2004h> "]
[215.112814, "o", "problem.solve(solver=cp.ECOS, verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.112868, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112916, "o", "print(f\"Status: {problem.status}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.112975, "o", "print(f\"Optimal cost: {problem.value:.2f}\")\r\n\u001b[?2004l\r"]
[215.113019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113065, "o", "# Extract results\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.113138, "o", "> "]
[215.113191, "o", "pg_opt = np.array(pg.value) * base_mva\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113228, "o", "theta_opt = np.array(theta.value) * 180 / np.pi\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.113276, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113347, "o", "print(f\"Total generation: {pg_opt.sum():.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.11344, "o", "print(f\"Total load: {bus_data[:, PD].sum():.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.113492, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113541, "o", "# Store results for later use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.11359, "o", "results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113637, "o", "    'pg': pg_opt,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113685, "o", "    'theta': theta_opt,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113728, "o", "    'slack_idx': slack_bus_idx,\r\n\u001b[?2004l\r"]
[215.113774, "o", "\u001b[?2004h> "]
[215.113826, "o", "    'non_slack': non_slack,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.113874, "o", "    'cost': problem.value\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[215.113925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.114003, "o", "np.save('/tmp/dc_opf_results.npy', results, allow_pickle=True)\r\n\u001b[?2004l\r"]
[215.114049, "o", "\u001b[?2004h> "]
[215.114099, "o", "print(\"\\nResults saved!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.114147, "o", "> EOFSCRIPT\r\n\u001b[?2004l\r"]
[215.115295, "o", "\u001b[?2004h(opf_env) root@255b9729c190:/tmp# "]
[216.065358, "i", "python3 /tmp/dc_opf_solver.py\n"]
[216.065699, "o", "python3 /tmp/dc_opf_solver.py\r\n\u001b[?2004l\r"]
[217.456698, "o", "DC-OPF Solver\r\nBase MVA: 100.0\r\nBuses: 300, Generators: 69, Branches: 411\r\n"]
[217.456772, "o", "Slack bus: 43 (index 42)\r\n"]
[217.459067, "o", "Admittance matrix built (size 299x299)\r\n"]
[217.727955, "o", "Solving DC-OPF...\r\n"]
[217.735051, "o", "Traceback (most recent call last):\r\n  File \"/tmp/dc_opf_solver.py\", line 167, in <module>\r\n"]
[217.735235, "o", "    problem.solve(solver=cp.ECOS, verbose=False)\r\n"]
[217.735309, "o", "  File \"/tmp/opf_env/lib/python3.12/site-packages/cvxpy/problems/problem.py\", line 609, in solve\r\n"]
[217.735449, "o", "    return solve_func(self, *args, **kwargs)\r\n"]
[217.73552, "o", "           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/tmp/opf_env/lib/python3.12/site-packages/cvxpy/problems/problem.py\", line 1191, in _solve\r\n"]
[217.735672, "o", "    data, solving_chain, inverse_data = self.get_problem_data(\r\n                                        ^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/tmp/opf_env/lib/python3.12/site-packages/cvxpy/problems/problem.py\", line 755, in get_problem_data\r\n"]
[217.735793, "o", "    solving_chain = self._construct_chain(\r\n                    ^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/tmp/opf_env/lib/python3.12/site-packages/cvxpy/problems/problem.py\", line 1007, in _construct_chain\r\n"]
[217.73593, "o", "    candidate_solvers = self._find_candidate_solvers(solver=solver, gp=gp)\r\n"]
