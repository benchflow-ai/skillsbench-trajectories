[114.100339, "o", "\u001b[?2004h(opf_env) root@255b9729c190:~# "]
[134.774173, "i", "cat > /tmp/ac_opf_solver.py << 'EOFSCRIPT'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize, LinearConstraint, NonlinearConstraint, Bounds\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Load network data\nwith open('/root/network.json', 'r') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data['baseMVA']\nbus_data = np.array(network_data['bus'])\ngen_data = np.array(network_data['gen'])\nbranch_data = np.array(network_data['branch'])\ngencost_data = np.array(network_data['gencost'])\n\n# Column indices\nBUS_I, BUS_TYPE, PD, QD, GS, BS, VMAX, VMIN = 0, 1, 2, 3, 4, 5, 11, 12\nGEN_BUS, GEN_PG, GEN_QG, GEN_QMAX, GEN_QMIN, GEN_VMAX, GEN_STATUS, GEN_PMAX, GEN_PMIN = 0, 1, 2, 3, 4, 5, 7, 8, 9\nBR_FBUS, BR_TBUS, BR_R, BR_X, BR_B, BR_RATE_A, BR_STATUS = 0, 1, 2, 3, 4, 5, 10\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\nnum_branch = len(branch_data)\n\n# Create bus index mapping\nbus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]\n\n# Identify slack bus (type 3) and PV buses (type 2)\nslack_bus_idx = None\nfor i in range(num_bus):\n    if int(bus_data[i, BUS_TYPE]) == 3:\n        slack_bus_idx = i\n        break\nif slack_bus_idx is None:\n    slack_bus_idx = 0\n\nprint(f\"Slack bus index: {slack_bus_idx} (Bus {int(bus_data[slack_bus_idx, BUS_I])})\")\n\n# Variable ordering: [Pg (num_gen), Qg (num_gen), Vm (num_bus), Va (num_bus)]\ndef get_var_indices():\n    pg_start = 0\n    pg_end = num_gen\n    qg_start = pg_end\n    qg_end = qg_start + num_gen\n    vm_start = qg_end\n    vm_end = vm_start + num_bus\n    va_start = vm_end\n    va_end = va_start + num_bus\n    return pg_start, pg_end, qg_start, qg_end, vm_start, vm_end, va_start, va_end\n\npg_start, pg_end, qg_start, qg_end, vm_start, vm_end, va_start, va_end = get_var_indices()\ntotal_vars = va_end\n\nprint(f\"Total optimization variables: {total_vars}\")\nprint(f\"  Pg: {pg_end - pg_start}, Qg: {qg_end - qg_start}, Vm: {vm_end - vm_start}, Va: {va_end - va_start}\")\n\n# Initial point\nx0 = np.zeros(total_vars)\nfor i in range(num_gen):\n    x0[pg_start + i] = gen_data[i, GEN_PG]\n    x0[qg_start + i] = gen_data[i, GEN_QG]\nfor i in range(num_bus):\n    x0[vm_start + i] = bus_data[i, VMAX] if bus_data[i, VMAX] > 0 else 1.0\n    x0[va_start + i] = 0.0\n\n# Objective function: cost\ndef objective(x):\n    pg = x[pg_start:pg_end]\n    cost = 0.0\n    for i in range(num_gen):\n        if int(gencost_data[i, 0]) == 2:  # Polynomial cost\n            n = int(gencost_data[i, 3])\n            coeffs = gencost_data[i, 4:4+n]\n            # coeffs are in descending order of powers\n            for j, c in enumerate(coeffs):\n                power = n - 1 - j\n                cost += c * (pg[i] ** power)\n        else:\n            # Piecewise linear - use first two coefficients\n            cost += gencost_data[i, 4] * pg[i] + gencost_data[i, 5]\n    return cost\n\n# Power balance constraints\ndef power_balance(x):\n    pg = x[pg_start:pg_end]\n    qg = x[qg_start:qg_end]\n    vm = x[vm_start:vm_end]\n    va = x[va_start:va_end]\n    \n    constraints = np.zeros(2 * num_bus)\n    \n    for i in range(num_bus):\n        # Real power balance\n        p_balance = -bus_data[i, PD] / base_mva\n        q_balance = -bus_data[i, QD] / base_mva\n        \n        # Add shunt admittance\n        p_balance -= bus_data[i, GS] * vm[i]**2 / base_mva\n        q_balance += bus_data[i, BS] * vm[i]**2 / base_mva\n        \n        # Add generation\n        for g_idx in range(num_gen):\n            if gen_bus_indices[g_idx] == i:\n                p_balance += pg[g_idx] / base_mva\n                q_balance += qg[g_idx] / base_mva\n        \n        # Add branch flows\n        for b_idx in range(num_branch):\n            if int(branch_data[b_idx, BR_STATUS]) == 0:\n                continue\n            \n            fbus = bus_idx_map.get(int(branch_data[b_idx, BR_FBUS]))\n            tbus = bus_idx_map.get(int(branch_data[b_idx, BR_TBUS]))\n            \n            if fbus is None or tbus is None:\n                continue\n            \n            r = branch_data[b_idx, BR_R]"]
[134.774248, "i", "\n            x = branch_data[b_idx, BR_X]\n            b = branch_data[b_idx, BR_B]\n            \n            if r**2 + x**2 == 0:\n                continue\n            \n            z = r + 1j*x\n            y = 1.0 / z if z != 0 else 0\n            g = y.real\n            b_series = y.imag\n            \n            if i == fbus:\n                # From bus\n                vi = vm[i] * np.exp(1j * va[i] * np.pi / 180)\n                vj = vm[tbus] * np.exp(1j * va[tbus] * np.pi / 180)\n                \n                s_ij = vi * np.conj(g + 1j*(b_series + b/2)) * np.conj(vi) - vi * np.conj(g + 1j*b_series) * np.conj(vj)\n                p_balance -= s_ij.real\n                q_balance -= s_ij.imag\n            \n            elif i == tbus:\n                # To bus\n                vi = vm[i] * np.exp(1j * va[i] * np.pi / 180)\n                vj = vm[fbus] * np.exp(1j * va[fbus] * np.pi / 180)\n                \n                s_ji = vi * np.conj(g + 1j*(b_series + b/2)) * np.conj(vi) - vi * np.conj(g + 1j*b_series) * np.conj(vj)\n                p_balance -= s_ji.real\n                q_balance -= s_ji.imag\n        \n        constraints[i] = p_balance\n        constraints[num_bus + i] = q_balance\n    \n    return constraints\n\n# Bounds\nlb = np.zeros(total_vars)\nub = np.zeros(total_vars)\n\nfor i in range(num_gen):\n    lb[pg_start + i] = gen_data[i, GEN_PMIN] / base_mva\n    ub[pg_start + i] = gen_data[i, GEN_PMAX] / base_mva\n    lb[qg_start + i] = gen_data[i, GEN_QMIN] / base_mva\n    ub[qg_start + i] = gen_data[i, GEN_QMAX] / base_mva\n\nfor i in range(num_bus):\n    lb[vm_start + i] = bus_data[i, VMIN]\n    ub[vm_start + i] = bus_data[i, VMAX]\n    lb[va_start + i] = -np.pi\n    ub[va_start + i] = np.pi\n\nbounds = Bounds(lb, ub)\n\n# Slack bus angle constraint\nconstraints_list = [{'type': 'eq', 'fun': lambda x: x[va_start + slack_bus_idx]}]\n\n# Power balance constraints\nconstraints_list.append({'type': 'eq', 'fun': power_balance})\n\nprint(\"Starting optimization...\")\nresult = minimize(objective, x0, method='SLSQP', bounds=bounds, constraints=constraints_list,\n                 options={'maxiter': 1000, 'ftol': 1e-6})\n\nprint(f\"Optimization result: {result.message}\")\nprint(f\"Success: {result.success}\")\nprint(f\"Cost: {result.fun}\")\n\n# Extract results\npg_opt = result.x[pg_start:pg_end] * base_mva\nqg_opt = result.x[qg_start:qg_end] * base_mva\nvm_opt = result.x[vm_start:vm_end]\nva_opt = result.x[va_start:va_end] * 180 / np.pi\n\nprint(f\"\\nOptimization completed!\")\nprint(f\"Total generation: {pg_opt.sum():.2f} MW\")\nprint(f\"Total load: {bus_data[:, PD].sum():.2f} MW\")\n\nEOFSCRIPT\n"]
[134.774573, "o", "cat > /tmp/ac_opf_solver.py << 'EOFSCRIPT'\r\n\u001b[?2004l\r"]
