[?2004l[?2004h> 
[?2004l[?2004h> # Load network data
[?2004l[?2004h> with open('/root/network.json', 'r') as f:
[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> base_mva = data['baseMVA']
[?2004l[?2004h> bus_data = np.array(data['bus'])
[?2004l[?2004h> gen_data = np.array(data['gen'])
[?2004l[?2004h> branch_data = np.array(data['branch'])
[?2004l[?2004h> gencost_data = np.array(data['gencost'])
[?2004l[?2004h> 
[?2004l[?2004h> BUS_I, BUS_TYPE, PD = 0, 1, 2
[?2004l[?2004h> GEN_BUS, GEN_PMAX, GEN_PMIN = 0, 8, 9
[?2004l[?2004h> BR_FBUS, BR_TBUS, BR_X, BR_STATUS = 0, 1, 3, 10
[?2004l[?2004h> 
[?2004l[?2004h> num_bus = len(bus_data)
[?2004l[?2004h> num_gen = len(gen_data)
[?2004l[?2004h> num_branch = len(branch_data)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Simple DC-OPF")
[?2004l[?2004h> 
[?2004l[?2004h> # Bus mapping
[?2004l[?2004h> bus_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}
[?2004l[?2004h> gen_buses = np.array([bus_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)])
[?2004l[?2004h> 
[?2004l[?2004h> # Slack bus
[?2004l[?2004h> slack_idx = np.where(bus_data[:, BUS_TYPE] == 3)[0][0]
[?2004l[?2004h> non_slack = np.where(np.arange(num_bus) != slack_idx)[0]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Buses: {num_bus}, Generators: {num_gen}, Slack: {slack_idx}")
[?2004l[?2004h> 
[?2004l[?2004h> # Build B matrix
[?2004l[?2004h> B = np.zeros((num_bus, num_bus))
[?2004l[?2004h> for b in range(num_branch):
[?2004l[?2004h>     if branch_data[b, BR_STATUS] == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     fbus = bus_map.get(int(branch_data[b, BR_FBUS]))
[?2004l[?2004h>     tbus = bus_map.get(int(branch_data[b, BR_TBUS]))
[?2004l[?2004h>     if fbus is None or tbus is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     x = branch_data[b, BR_X]
[?2004l[?2004h>     if x == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     b_val = 1.0 / x
[?2004l[?2004h>     B[fbus, fbus] += b_val
[?2004l[?2004h>     B[tbus, tbus] += b_val
[?2004l[?2004h>     B[fbus, tbus] -= b_val
[?2004l[?2004h>     B[tbus, fbus] -= b_val
[?2004l[?2004h> 
[?2004l[?2004h> B_red = B[np.ix_(non_slack, non_slack)]
[?2004l[?2004h> B_slack = B[np.ix_(non_slack, [slack_idx])].flatten()
[?2004l[?2004h> 
[?2004l[?2004h> # Generation matrix
[?2004l[?2004h> C = np.zeros((len(non_slack), num_gen))
[?2004l[?2004h> for g in range(num_gen):
[?2004l[?2004h>     bus_idx = gen_buses[g]
[?2004l[?2004h>     if bus_idx in non_slack:
[?2004l[?2004h>         row = np.where(non_slack == bus_idx)[0][0]
[?2004l[?2004h>         C[row, g] = 1.0
[?2004l[?2004h> 
[?2004l[?2004h> # Load
[?2004l[?2004h> p_load = bus_data[non_slack, PD] / base_mva
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total load: {p_load.sum() * base_mva:.2f} MW")
[?2004l[?2004h> 
[?2004l[?2004h> # Objective function
[?2004l[?2004h> def objective(pg_pu):
[?2004l[?2004h>     cost = 0
[?2004l[?2004h>     for i in range(num_gen):
[?2004l[?2004h>         n = int(gencost_data[i, 3])
[?2004l[?2004h>         c = gencost_data[i, 4:4+n]
[?2004l[?2004h>         for k, coeff in enumerate(c):
[?2004l[?2004h>             power = n - 1 - k
[?2004l[?2004h>             if power > 0:
[?2004l[?2004h>                 cost += coeff * (pg_pu[i] ** power)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cost += coeff
[?2004l[?2004h>     return cost
[?2004l[?2004h> 
[?2004l[?2004h> # Power balance constraint function
[?2004l[?2004h> def constraint_func(pg_pu):
[?2004l[?2004h>     # C @ pg = B_red @ theta + p_load
[?2004l[?2004h>     # Solve for theta: theta = inv(B_red) @ (C @ pg - p_load)
[?2004l[?2004h>     lhs = C @ pg_pu - p_load
[?2004l[?2004h>     try:
[?2004l[?2004h>         theta = np.linalg.solve(B_red, lhs)
[?2004l[?2004h>         return lhs - B_red @ theta  # Should be zero
[?2004l[?2004h>     except:
[?2004l[?2004h>         return np.ones(len(non_slack)) * 1e10
[?2004l[?2004h> 
[?2004l[?2004h> # Initial point
[?2004l[?2004h> pg0_pu = np.ones(num_gen) * 0.5
[?2004l[?2004h> for i in range(num_gen):
[?2004l[?2004h>     pg0_pu[i] = min(gen_data[i, GEN_PMAX] / base_mva, 0.5)
[?2004l[?2004h> 
[?2004l[?2004h> # Bounds
[?2004l[?2004h> lb = gen_data[:, GEN_PMIN] / base_mva
[?2004l[?2004h> ub = gen_data[:, GEN_PMAX] / base_mva
[?2004l[?2004h> bounds = Bounds(lb, ub)
[?2004l[?2004h> 
[?2004l[?2004h> # Constraint
[?2004l[?2004h> from scipy.optimize import NonlinearConstraint
[?2004l[?2004h> constraint = NonlinearConstraint(constraint_func, np.zeros(len(non_slack)), np.zeros(len(non_slack)))
[?2004l[?2004h> 
[?2004l[?2004h> print("Solving...")
[?2004l[?2004h> result = minimize(objective, pg0_pu, method='SLSQP', bounds=bounds,
[?2004l[?2004h>                  constraints={'type': 'eq', 'fun': constraint_func},
[?2004l[?2004h>                  options={'maxiter': 500, 'ftol': 1e-6})
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Status: {result.success}")
[?2004l[?2004h> if result.success:
[?2004l[?2004h>     pg_opt = result.x * base_mva
[?2004l[?2004h>     print(f"Cost: ${result.fun:.2f}")
[?2004l[?2004h>     print(f"Total gen: {pg_opt.sum():.2f} MW")
[?2004l[?2004h>     print(f"Total load: {p_load.sum() * base_mva:.2f} MW")
[?2004l[?2004h>     
[?2004l[?2004h>     # Save
[?2004l[?2004h>     np.savez('/tmp/opf_sol.npz', pg=pg_opt, bus_data=bus_data, gen_data=gen_data,
[?2004l[?2004h>              gen_buses=gen_buses, slack_idx=slack_idx, cost=result.fun)
[?2004l[?2004h>     print("Solution saved!")
[?2004l[?2004h> else:
