[?2004l[?2004h> for i in range(num_gen):
[?2004l[?2004h>     n = int(gencost_data[i, 3])
[?2004l[?2004h>     c = gencost_data[i, 4:4+n]
[?2004l[?2004h>     for k, coeff in enumerate(c):
[?2004l[?2004h>         power = n - 1 - k
[?2004l[?2004h>         cost += coeff * (pg[i] ** max(power, 0))
[?2004l[?2004h> 
[?2004l[?2004h> # Constraints
[?2004l[?2004h> cons = []
[?2004l[?2004h> 
[?2004l[?2004h> # Generator bounds
[?2004l[?2004h> for i in range(num_gen):
[?2004l[?2004h>     cons.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)
[?2004l[?2004h>     cons.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)
[?2004l[?2004h> 
[?2004l[?2004h> # Power balance: C_gen @ pg = B_red @ theta + p_load
[?2004l[?2004h> cons.append(C_gen @ pg == B_red @ theta + p_load)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Solving with {len(cons)} constraints...")
[?2004l[?2004h> problem = cp.Problem(cp.Minimize(cost), cons)
[?2004l[?2004h> problem.solve(solver=cp.SCS, verbose=False, max_iters=5000, eps=1e-4)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Status: {problem.status}")
[?2004l[?2004h> if problem.status == 'optimal':
[?2004l[?2004h>     pg_opt = np.array(pg.value) * base_mva
[?2004l[?2004h>     theta_opt = np.array(theta.value)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Optimal cost: ${problem.value:.2f}")
[?2004l[?2004h>     print(f"Total generation: {pg_opt.sum():.2f} MW")
[?2004l[?2004h>     print(f"Total load: {p_load.sum() * base_mva:.2f} MW")
[?2004l[?2004h>     print(f"Mismatch: {(pg_opt.sum() - p_load.sum() * base_mva):.2f} MW")
[?2004l[?2004h>     
[?2004l[?2004h>     # Save results
[?2004l[?2004h>     np.savez('/tmp/dc_results.npz', pg=pg_opt, theta=theta_opt, cost=problem.value,
[?2004l[?2004h>              slack_idx=slack_idx, non_slack=non_slack)
[?2004l[?2004h>     print("Results saved to /tmp/dc_results.npz")
[?2004l[?2004h> else:
