[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import cvxpy as cp
[?2004l[?2004h> from scipy.sparse import csr_matrix
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> # Load network data
[?2004l[?2004h> with open('/root/network.json', 'r') as f:
[?2004l[?2004h>     network_data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> base_mva = network_data['baseMVA']
[?2004l[?2004h> bus_data = np.array(network_data['bus'])
[?2004l[?2004h> gen_data = np.array(network_data['gen'])
[?2004l[?2004h> branch_data = np.array(network_data['branch'])
[?2004l[?2004h> gencost_data = np.array(network_data['gencost'])
[?2004l[?2004h> 
[?2004l[?2004h> # Column indices
[?2004l[?2004h> BUS_I, BUS_TYPE, PD, QD = 0, 1, 2, 3
[?2004l[?2004h> GEN_BUS, GEN_PG, GEN_PMAX, GEN_PMIN = 0, 1, 8, 9
[?2004l[?2004h> BR_FBUS, BR_TBUS, BR_X, BR_STATUS = 0, 1, 3, 10
[?2004l[?2004h> 
[?2004l[?2004h> num_bus = len(bus_data)
[?2004l[?2004h> num_gen = len(gen_data)
[?2004l[?2004h> num_branch = len(branch_data)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"DC-OPF V2 Solver")
[?2004l[?2004h> print(f"Buses: {num_bus}, Generators: {num_gen}, Branches: {num_branch}")
[?2004l[?2004h> 
[?2004l[?2004h> # Bus mapping
[?2004l[?2004h> bus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}
[?2004l[?2004h> gen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]
[?2004l[?2004h> 
[?2004l[?2004h> # Find slack bus
[?2004l[?2004h> slack_idx = None
[?2004l[?2004h> for i in range(num_bus):
[?2004l[?2004h>     if int(bus_data[i, BUS_TYPE]) == 3:
[?2004l[?2004h>         slack_idx = i
[?2004l[?2004h>         break
[?2004l[?2004h> if slack_idx is None:
[?2004l[?2004h>     slack_idx = 0
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Slack bus index: {slack_idx}")
[?2004l[?2004h> 
[?2004l[?2004h> # Build susceptance matrix B
[?2004l[?2004h> B = np.zeros((num_bus, num_bus))
[?2004l[?2004h> for b_idx in range(num_branch):
[?2004l[?2004h>     if int(branch_data[b_idx, BR_STATUS]) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     fbus_id = int(branch_data[b_idx, BR_FBUS])
[?2004l[?2004h>     tbus_id = int(branch_data[b_idx, BR_TBUS])
[?2004l[?2004h>     if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:
[?2004l[?2004h>         continue
[?2004l[?2004h>     fbus = bus_idx_map[fbus_id]
[?2004l[?2004h>     tbus = bus_idx_map[tbus_id]
[?2004l[?2004h>     x = branch_data[b_idx, BR_X]
[?2004l[?2004h>     if x != 0:
[?2004l[?2004h>         b_val = 1.0 / x
[?2004l[?2004h>         B[fbus, fbus] += b_val
[?2004l[?2004h>         B[tbus, tbus] += b_val
[?2004l[?2004h>         B[fbus, tbus] -= b_val
[?2004l[?2004h>         B[tbus, fbus] -= b_val
[?2004l[?2004h> 
[?2004l[?2004h> # Reduced B matrix (remove slack row/col)
[?2004l[?2004h> non_slack_idx = [i for i in range(num_bus) if i != slack_idx]
[?2004l[?2004h> B_red = B[np.ix_(non_slack_idx, non_slack_idx)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"B matrix size: {B_red.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Variables
[?2004l[?2004h> pg = cp.Variable(num_gen)  # Generation in per-unit
[?2004l[?2004h> theta = cp.Variable(len(non_slack_idx))  # Angles in radians
[?2004l[?2004h> 
[?2004l[?2004h> # Objective
[?2004l[?2004h> cost = 0
[?2004l[?2004h> for i in range(num_gen):
[?2004l[?2004h>     n = int(gencost_data[i, 3])
[?2004l[?2004h>     if n >= 2:
[?2004l[?2004h>         c = gencost_data[i, 4:4+n]
[?2004l[?2004h>         # Polynomial: sum c_k * Pg^(n-1-k)
[?2004l[?2004h>         for k, coeff in enumerate(c):
[?2004l[?2004h>             power = n - 1 - k
[?2004l[?2004h>             if power > 0:
[?2004l[?2004h>                 cost += coeff * (pg[i] ** power)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cost += coeff
[?2004l[?2004h>     else:
[?2004l[?2004h>         cost += gencost_data[i, 4] * pg[i]
[?2004l[?2004h> 
[?2004l[?2004h> # Constraints list
[?2004l[?2004h> cons = []
[?2004l[?2004h> 
[?2004l[?2004h> # Generator limits
[?2004l[?2004h> for i in range(num_gen):
[?2004l[?2004h>     cons.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)
[?2004l[?2004h>     cons.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)
[?2004l[?2004h> 
[?2004l[?2004h> # Load vector (per-unit)
[?2004l[?2004h> p_load = np.zeros(num_bus)
[?2004l[?2004h> for i in range(num_bus):
[?2004l[?2004h>     p_load[i] = bus_data[i, PD] / base_mva
[?2004l[?2004h> p_load_red = p_load[non_slack_idx]
[?2004l[?2004h> 
[?2004l[?2004h> # Generation vector matrix
[?2004l[?2004h> C_gen = np.zeros((len(non_slack_idx), num_gen))
[?2004l[?2004h> for g_idx in range(num_gen):
[?2004l[?2004h>     bus_idx = gen_bus_indices[g_idx]
[?2004l[?2004h>     if bus_idx in non_slack_idx:
[?2004l[?2004h>         row_idx = non_slack_idx.index(bus_idx)
[?2004l[?2004h>         C_gen[row_idx, g_idx] = 1.0
[?2004l[?2004h> 
[?2004l[?2004h> # Power balance: C_gen @ pg - p_load = B_red @ theta
[?2004l[?2004h> # Rearrange: C_gen @ pg = B_red @ theta + p_load
[?2004l[?2004h> cons.append(C_gen @ pg == B_red @ theta + p_load_red)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total constraints: {len(cons)}")
[?2004l[?2004h> print(f"Solving...")
[?2004l[?2004h> 
[?2004l[?2004h> problem = cp.Problem(cp.Minimize(cost), cons)
[?2004l[?2004h> problem.solve(solver=cp.SCS, verbose=False, max_iters=5000)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Status: {problem.status}")
[?2004l[?2004h> print(f"Optimal cost: {problem.value:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> if problem.status == 'optimal':
[?2004l[?2004h>     pg_opt = np.array(pg.value) * base_mva
[?2004l[?2004h>     print(f"Total generation: {pg_opt.sum():.2f} MW")
[?2004l[?2004h>     print(f"Total load: {p_load.sum() * base_mva:.2f} MW")
[?2004l[?2004h>     print(f"\nSample generator outputs:")
[?2004l[?2004h>     for i in range(min(5, num_gen)):
[?2004l[?2004h>         print(f"  Gen {i}: {pg_opt[i]:.2f} MW")
[?2004l[?2004h> else:
[?2004l[?2004h>     print(f"Optimization failed!")
