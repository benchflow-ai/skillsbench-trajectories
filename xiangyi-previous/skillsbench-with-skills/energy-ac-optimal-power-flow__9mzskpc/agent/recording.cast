[271.409195, "o", "    if br[BR_STATUS] == 0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409233, "o", "    f=int(br[F_BUS])-1; t=int(br[T_BUS])-1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409304, "o", "    Pflow[f]+=br[PF]; Qflow[f]+=br[QF]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.409342, "o", "> "]
[271.409375, "o", "    Pflow[t]+=br[PT]; Qflow[t]+=br[QT]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.409409, "o", "> Vm=bus[:,VM]\r\n\u001b[?2004l\r"]
[271.409442, "o", "\u001b[?2004h> "]
[271.409569, "o", "Pmis=Pgen - bus[:,PD] - bus[:,GS]*Vm**2 - Pflow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409602, "o", "Qmis=Qgen - bus[:,QD] + bus[:,BS]*Vm**2 - Qflow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409674, "o", "max_p_mis=float(np.max(np.abs(Pmis)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409742, "o", "max_q_mis=float(np.max(np.abs(Qmis)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.409776, "o", "> "]
[271.40981, "o", "# voltage violation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409892, "o", "vmin=bus[:,VMIN]; vmax=bus[:,VMAX]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.409943, "o", "vol_viol=np.maximum(vmin - Vm, Vm - vmax)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410033, "o", "max_vol_viol=float(np.max(np.maximum(vol_viol,0)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.41007, "o", "> # branch overload\r\n\u001b[?2004l\r"]
[271.410102, "o", "\u001b[?2004h> "]
[271.410134, "o", "rate=branch[:,RATE_A]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410229, "o", "MVA_from=np.sqrt(branch[:,PF]**2 + branch[:,QF]**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410316, "o", "MVA_to=np.sqrt(branch[:,PT]**2 + branch[:,QT]**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410381, "o", "MVA=np.maximum(MVA_from, MVA_to)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.410417, "o", "> "]
[271.410482, "o", "overload=np.where(rate>0, np.maximum(0, MVA-rate), 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.41056, "o", "max_branch_over=float(np.max(overload))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410612, "o", "# most loaded branches\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.41065, "o", "> records=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410716, "o", "for i, br in enumerate(branch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410773, "o", "    limit=float(br[RATE_A])\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.410809, "o", "> "]
[271.410879, "o", "    if limit<=0 or br[BR_STATUS]==0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.410963, "o", "    mva_from=float(MVA_from[i]); mva_to=float(MVA_to[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.411057, "o", "    loading=float(max(mva_from, mva_to)/limit*100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.411111, "o", "    records.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.411173, "o", "        \"from_bus\": int(br[F_BUS]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411209, "o", "> "]
[271.411239, "o", "        \"to_bus\": int(br[T_BUS]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411323, "o", ">         \"loading_pct\": loading,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.411378, "o", "        \"flow_from_MVA\": mva_from,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411413, "o", "> "]
[271.411444, "o", "        \"flow_to_MVA\": mva_to,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.41153, "o", "        \"limit_MVA\": limit\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.41164, "o", "records.sort(key=lambda x: x[\"loading_pct\"], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.411697, "o", "most_loaded=records[:5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.41173, "o", "# generators list\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411765, "o", "> gens=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411799, "o", "> "]
[271.41183, "o", "for i, g in enumerate(gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411864, "o", ">     gens.append({\r\n\u001b[?2004l\r"]
[271.411897, "o", "\u001b[?2004h> "]
[271.41193, "o", "        \"id\": i+1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.411962, "o", "> "]
[271.411994, "o", "        \"bus\": int(g[GEN_BUS]),\r\n\u001b[?2004l\r"]
[271.412027, "o", "\u001b[?2004h> "]
[271.41206, "o", "        \"pg_MW\": float(g[PG]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.412093, "o", "> "]
[271.412131, "o", "        \"qg_MVAr\": float(g[QG]),\r\n\u001b[?2004l\r"]
[271.412163, "o", "\u001b[?2004h> "]
[271.412234, "o", "        \"pmin_MW\": float(g[PMIN]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412273, "o", "        \"pmax_MW\": float(g[PMAX]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412577, "o", "        \"qmin_MVAr\": float(g[QMIN]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"qmax_MVAr\": float(g[QMAX])\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> # buses list\r\n\u001b[?2004l\r\u001b[?2004h> buses=[]\r\n\u001b[?2004l\r\u001b[?2004h> for i, b in enumerate(bus):\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.41261, "o", ">     buses.append({\r\n\u001b[?2004l\r"]
[271.412645, "o", "\u001b[?2004h> "]
[271.412679, "o", "        \"id\": int(b[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412789, "o", "        \"vm_pu\": float(b[VM]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412827, "o", "        \"va_deg\": float(b[VA]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412905, "o", "        \"vmin_pu\": float(b[VMIN]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.412951, "o", "        \"vmax_pu\": float(b[VMAX])\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.412971, "o", ">     })\r\n\u001b[?2004l\r"]
[271.412997, "o", "\u001b[?2004h> "]
[271.413216, "o", "report={\r\n\u001b[?2004l\r\u001b[?2004h>     \"summary\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"total_cost_per_hour\": float(res['f']),\r\n\u001b[?2004l\r"]
[271.413274, "o", "\u001b[?2004h> "]
[271.413302, "o", "        \"total_load_MW\": total_load_MW,\r\n\u001b[?2004l\r"]
[271.413333, "o", "\u001b[?2004h> "]
[271.413425, "o", "        \"total_load_MVAr\": total_load_MVAr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.413451, "o", "> "]
[271.41354, "o", "        \"total_generation_MW\": total_gen_MW,\r\n\u001b[?2004l\r"]
[271.413565, "o", "\u001b[?2004h> "]
[271.413671, "o", "        \"total_generation_MVAr\": total_gen_MVAr,\r\n\u001b[?2004l\r"]
[271.413697, "o", "\u001b[?2004h> "]
[271.41379, "o", "        \"total_losses_MW\": total_losses_MW,\r\n\u001b[?2004l\r"]
[271.413817, "o", "\u001b[?2004h> "]
[271.413961, "o", "        \"solver_status\": \"optimal\" if res['success'] else \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.413991, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.414073, "o", "    \"generators\": gens,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.414137, "o", "    \"buses\": buses,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.414248, "o", "    \"most_loaded_branches\": most_loaded,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.414321, "o", "    \"feasibility_check\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.414419, "o", "        \"max_p_mismatch_MW\": max_p_mis,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.414455, "o", "> "]
[271.414525, "o", "        \"max_q_mismatch_MVAr\": max_q_mis,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.414553, "o", "> "]
[271.41465, "o", "        \"max_voltage_violation_pu\": max_vol_viol,\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.414677, "o", "> "]
[271.41478, "o", "        \"max_branch_overload_MVA\": max_branch_over\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.414809, "o", ">     }\r\n\u001b[?2004l\r"]
[271.414838, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[271.414866, "o", "\u001b[?2004h> "]
[271.414958, "o", "with open('report.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.414987, "o", "> "]
[271.415049, "o", "    json.dump(report,f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.415075, "o", "> "]
[271.415138, "o", "print(\"report.json written\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.415166, "o", "> PY\r\n\u001b[?2004l\r"]
[275.413435, "o", "report.json written\r\n"]
[275.451752, "o", "\u001b[?2004hroot@80cc4fa33903:~# "]
[288.604101, "i", "head -n 40 report.json\n"]
[288.604386, "o", "head -n 40 report.json\r\n\u001b[?2004l\r"]
[288.605283, "o", "{\r\n  \"summary\": {\r\n    \"total_cost_per_hour\": 565220.0021794721,\r\n    \"total_load_MW\": 23525.85,\r\n    \"total_load_MVAr\": 7787.969999999999,\r\n    \"total_generation_MW\": 23950.967143765167,\r\n    \"total_generation_MVAr\": 7793.637036350412,\r\n    \"total_losses_MW\": 425.1171437651683,\r\n    \"solver_status\": \"optimal\"\r\n  },\r\n  \"generators\": [\r\n    {\r\n      \"id\": 1,\r\n      \"bus\": 43,\r\n      \"pg_MW\": 496.3413746197301,\r\n      \"qg_MVAr\": 9.99999925822091,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 718.0,\r\n      \"qmin_MVAr\": 0.0,\r\n      \"qmax_MVAr\": 10.0\r\n    },\r\n    {\r\n      \"id\": 2,\r\n      \"bus\": 200,\r\n      \"pg_MW\": 880.9999873521659,\r\n      \"qg_MVAr\": 299.9978902829371,\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 881.0,\r\n"]
[288.605336, "o", "      \"qmin_MVAr\": -300.0,\r\n      \"qmax_MVAr\": 300.0\r\n    },\r\n    {\r\n      \"id\": 3,\r\n      \"bus\": 209,\r\n      \"pg_MW\": 202.99998780032843,\r\n      \"qg_MVAr\": 86.99999213023266,"]
[288.605367, "o", "\r\n      \"pmin_MW\": 0.0,\r\n      \"pmax_MW\": 203.0,\r\n      \"qmin_MVAr\": 0.0,\r\n      \"qmax_MVAr\": 87.0\r\n"]
