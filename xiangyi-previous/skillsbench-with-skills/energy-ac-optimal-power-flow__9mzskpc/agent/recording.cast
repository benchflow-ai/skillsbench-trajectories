[271.406405, "i", "/tmp/venv/bin/python - <<'PY'\nimport json, numpy as np\nfrom pypower.api import runopf, ppoption\nfrom pypower.idx_bus import PD, QD, GS, BS, VM, VA, VMAX, VMIN\nfrom pypower.idx_gen import GEN_BUS, PG, QG, QMAX, QMIN, GEN_STATUS, PMAX, PMIN\nfrom pypower.idx_brch import F_BUS, T_BUS, RATE_A, BR_STATUS, PF, QF, PT, QT\nwith open('network.json') as f:\n    data=json.load(f)\nppc = {'baseMVA': data['baseMVA'],\n       'bus': np.array(data['bus'], dtype=float),\n       'gen': np.array(data['gen'], dtype=float),\n       'branch': np.array(data['branch'], dtype=float),\n       'gencost': np.array(data['gencost'], dtype=float)}\nppopt = ppoption(VERBOSE=0, OUT_ALL=0)\nres = runopf(ppc, ppopt)\nbus=res['bus']; gen=res['gen']; branch=res['branch']\nnb=bus.shape[0]\n# totals\ntotal_load_MW=float(bus[:,PD].sum())\ntotal_load_MVAr=float(bus[:,QD].sum())\non = gen[:,GEN_STATUS] > 0\ntotal_gen_MW=float(gen[on,PG].sum())\ntotal_gen_MVAr=float(gen[on,QG].sum())\ntotal_losses_MW=total_gen_MW - total_load_MW\n# bus generation sums\nPgen=np.zeros(nb); Qgen=np.zeros(nb)\nfor g in gen[on]:\n    b=int(g[GEN_BUS])-1\n    Pgen[b]+=g[PG]; Qgen[b]+=g[QG]\n# branch flows\nPflow=np.zeros(nb); Qflow=np.zeros(nb)\nfor br in branch:\n    if br[BR_STATUS] == 0: continue\n    f=int(br[F_BUS])-1; t=int(br[T_BUS])-1\n    Pflow[f]+=br[PF]; Qflow[f]+=br[QF]\n    Pflow[t]+=br[PT]; Qflow[t]+=br[QT]\nVm=bus[:,VM]\nPmis=Pgen - bus[:,PD] - bus[:,GS]*Vm**2 - Pflow\nQmis=Qgen - bus[:,QD] + bus[:,BS]*Vm**2 - Qflow\nmax_p_mis=float(np.max(np.abs(Pmis)))\nmax_q_mis=float(np.max(np.abs(Qmis)))\n# voltage violation\nvmin=bus[:,VMIN]; vmax=bus[:,VMAX]\nvol_viol=np.maximum(vmin - Vm, Vm - vmax)\nmax_vol_viol=float(np.max(np.maximum(vol_viol,0)))\n# branch overload\nrate=branch[:,RATE_A]\nMVA_from=np.sqrt(branch[:,PF]**2 + branch[:,QF]**2)\nMVA_to=np.sqrt(branch[:,PT]**2 + branch[:,QT]**2)\nMVA=np.maximum(MVA_from, MVA_to)\noverload=np.where(rate>0, np.maximum(0, MVA-rate), 0)\nmax_branch_over=float(np.max(overload))\n# most loaded branches\nrecords=[]\nfor i, br in enumerate(branch):\n    limit=float(br[RATE_A])\n    if limit<=0 or br[BR_STATUS]==0: continue\n    mva_from=float(MVA_from[i]); mva_to=float(MVA_to[i])\n    loading=float(max(mva_from, mva_to)/limit*100)\n    records.append({\n        \"from_bus\": int(br[F_BUS]),\n        \"to_bus\": int(br[T_BUS]),\n        \"loading_pct\": loading,\n        \"flow_from_MVA\": mva_from,\n        \"flow_to_MVA\": mva_to,\n        \"limit_MVA\": limit\n    })\nrecords.sort(key=lambda x: x[\"loading_pct\"], reverse=True)\nmost_loaded=records[:5]\n# generators list\ngens=[]\nfor i, g in enumerate(gen):\n    gens.append({\n        \"id\": i+1,\n        \"bus\": int(g[GEN_BUS]),\n        \"pg_MW\": float(g[PG]),\n        \"qg_MVAr\": float(g[QG]),\n        \"pmin_MW\": float(g[PMIN]),\n        \"pmax_MW\": float(g[PMAX]),\n        \"qmin_MVAr\": float(g[QMIN]),\n        \"qmax_MVAr\": float(g[QMAX])\n    })\n# buses list\nbuses=[]\nfor i, b in enumerate(bus):\n    buses.append({\n        \"id\": int(b[0]),\n        \"vm_pu\": float(b[VM]),\n        \"va_deg\": float(b[VA]),\n        \"vmin_pu\": float(b[VMIN]),\n        \"vmax_pu\": float(b[VMAX])\n    })\nreport={\n    \"summary\": {\n        \"total_cost_per_hour\": float(res['f']),\n        \"total_load_MW\": total_load_MW,\n        \"total_load_MVAr\": total_load_MVAr,\n        \"total_generation_MW\": total_gen_MW,\n        \"total_generation_MVAr\": total_gen_MVAr,\n        \"total_losses_MW\": total_losses_MW,\n        \"solver_status\": \"optimal\" if res['success'] else \"failed\"\n    },\n    \"generators\": gens,\n    \"buses\": buses,\n    \"most_loaded_branches\": most_loaded,\n    \"feasibility_check\": {\n        \"max_p_mismatch_MW\": max_p_mis,\n        \"max_q_mismatch_MVAr\": max_q_mis,\n        \"max_voltage_violation_pu\": max_vol_viol,\n        \"max_branch_overload_MVA\": max_branch_over\n    }\n}\nwith open('report.json','w') as f:\n    json.dump(report,f,indent=2)\nprint(\"report.json written\")\nPY\n"]
