[?2004l[?2004h>        'gen': np.array(data['gen'], dtype=float),
[?2004l[?2004h>        'branch': np.array(data['branch'], dtype=float),
[?2004l[?2004h>        'gencost': np.array(data['gencost'], dtype=float)}
[?2004l[?2004h> ppopt = ppoption(VERBOSE=0, OUT_ALL=0)
[?2004l[?2004h> res = runopf(ppc, ppopt)
[?2004l[?2004h> bus=res['bus']; gen=res['gen']; branch=res['branch']
[?2004l[?2004h> nb=bus.shape[0]
[?2004l[?2004h> # totals
[?2004l[?2004h> total_load_MW=float(bus[:,PD].sum())
[?2004l[?2004h> total_load_MVAr=float(bus[:,QD].sum())
[?2004l[?2004h> on = gen[:,GEN_STATUS] > 0
[?2004l[?2004h> total_gen_MW=float(gen[on,PG].sum())
[?2004l[?2004h> total_gen_MVAr=float(gen[on,QG].sum())
[?2004l[?2004h> total_losses_MW=total_gen_MW - total_load_MW
[?2004l[?2004h> # bus generation sums
[?2004l[?2004h> Pgen=np.zeros(nb); Qgen=np.zeros(nb)
[?2004l[?2004h> for g in gen[on]:
[?2004l[?2004h>     b=int(g[GEN_BUS])-1
[?2004l[?2004h>     Pgen[b]+=g[PG]; Qgen[b]+=g[QG]
[?2004l[?2004h> # branch flows
[?2004l[?2004h> Pflow=np.zeros(nb); Qflow=np.zeros(nb)
[?2004l[?2004h> for br in branch:
[?2004l[?2004h>     if br[BR_STATUS] == 0: continue
[?2004l[?2004h>     f=int(br[F_BUS])-1; t=int(br[T_BUS])-1
[?2004l[?2004h>     Pflow[f]+=br[PF]; Qflow[f]+=br[QF]
[?2004l[?2004h>     Pflow[t]+=br[PT]; Qflow[t]+=br[QT]
[?2004l[?2004h> Vm=bus[:,VM]
[?2004l[?2004h> Pmis=Pgen - bus[:,PD] - bus[:,GS]*Vm**2 - Pflow
[?2004l[?2004h> Qmis=Qgen - bus[:,QD] + bus[:,BS]*Vm**2 - Qflow
[?2004l[?2004h> max_p_mis=float(np.max(np.abs(Pmis)))
[?2004l[?2004h> max_q_mis=float(np.max(np.abs(Qmis)))
[?2004l[?2004h> # voltage violation
[?2004l[?2004h> vmin=bus[:,VMIN]; vmax=bus[:,VMAX]
[?2004l[?2004h> vol_viol=np.maximum(vmin - Vm, Vm - vmax)
[?2004l[?2004h> max_vol_viol=float(np.max(np.maximum(vol_viol,0)))
[?2004l[?2004h> # branch overload
[?2004l[?2004h> rate=branch[:,RATE_A]
[?2004l[?2004h> MVA_from=np.sqrt(branch[:,PF]**2 + branch[:,QF]**2)
[?2004l[?2004h> MVA_to=np.sqrt(branch[:,PT]**2 + branch[:,QT]**2)
[?2004l[?2004h> MVA=np.maximum(MVA_from, MVA_to)
[?2004l[?2004h> overload=np.where(rate>0, np.maximum(0, MVA-rate), 0)
[?2004l[?2004h> max_branch_over=float(np.max(overload))
[?2004l[?2004h> # most loaded branches
[?2004l[?2004h> records=[]
[?2004l[?2004h> for i, br in enumerate(branch):
[?2004l[?2004h>     limit=float(br[RATE_A])
[?2004l[?2004h>     if limit<=0 or br[BR_STATUS]==0: continue
[?2004l[?2004h>     mva_from=float(MVA_from[i]); mva_to=float(MVA_to[i])
[?2004l[?2004h>     loading=float(max(mva_from, mva_to)/limit*100)
[?2004l[?2004h>     records.append({
[?2004l[?2004h>         "from_bus": int(br[F_BUS]),
[?2004l[?2004h>         "to_bus": int(br[T_BUS]),
[?2004l[?2004h>         "loading_pct": loading,
[?2004l[?2004h>         "flow_from_MVA": mva_from,
[?2004l[?2004h>         "flow_to_MVA": mva_to,
[?2004l[?2004h>         "limit_MVA": limit
[?2004l[?2004h>     })
[?2004l[?2004h> records.sort(key=lambda x: x["loading_pct"], reverse=True)
[?2004l[?2004h> most_loaded=records[:5]
[?2004l[?2004h> # generators list
[?2004l[?2004h> gens=[]
[?2004l[?2004h> for i, g in enumerate(gen):
[?2004l[?2004h>     gens.append({
[?2004l[?2004h>         "id": i+1,
[?2004l[?2004h>         "bus": int(g[GEN_BUS]),
[?2004l[?2004h>         "pg_MW": float(g[PG]),
[?2004l[?2004h>         "qg_MVAr": float(g[QG]),
[?2004l[?2004h>         "pmin_MW": float(g[PMIN]),
[?2004l[?2004h>         "pmax_MW": float(g[PMAX]),
[?2004l[?2004h>         "qmin_MVAr": float(g[QMIN]),
[?2004l[?2004h>         "qmax_MVAr": float(g[QMAX])
[?2004l[?2004h>     })
[?2004l[?2004h> # buses list
[?2004l[?2004h> buses=[]
[?2004l[?2004h> for i, b in enumerate(bus):
[?2004l[?2004h>     buses.append({
[?2004l[?2004h>         "id": int(b[0]),
[?2004l[?2004h>         "vm_pu": float(b[VM]),
[?2004l[?2004h>         "va_deg": float(b[VA]),
[?2004l[?2004h>         "vmin_pu": float(b[VMIN]),
[?2004l[?2004h>         "vmax_pu": float(b[VMAX])
[?2004l[?2004h>     })
[?2004l[?2004h> report={
[?2004l[?2004h>     "summary": {
[?2004l[?2004h>         "total_cost_per_hour": float(res['f']),
[?2004l[?2004h>         "total_load_MW": total_load_MW,
[?2004l[?2004h>         "total_load_MVAr": total_load_MVAr,
[?2004l[?2004h>         "total_generation_MW": total_gen_MW,
[?2004l[?2004h>         "total_generation_MVAr": total_gen_MVAr,
[?2004l[?2004h>         "total_losses_MW": total_losses_MW,
[?2004l[?2004h>         "solver_status": "optimal" if res['success'] else "failed"
[?2004l[?2004h>     },
[?2004l[?2004h>     "generators": gens,
[?2004l[?2004h>     "buses": buses,
[?2004l[?2004h>     "most_loaded_branches": most_loaded,
[?2004l[?2004h>     "feasibility_check": {
[?2004l[?2004h>         "max_p_mismatch_MW": max_p_mis,
[?2004l[?2004h>         "max_q_mismatch_MVAr": max_q_mis,
[?2004l[?2004h>         "max_voltage_violation_pu": max_vol_viol,
[?2004l[?2004h>         "max_branch_overload_MVA": max_branch_over
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> with open('report.json','w') as f:
[?2004l[?2004h>     json.dump(report,f,indent=2)
