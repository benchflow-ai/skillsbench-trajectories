[238.079771, "o", "def extract_molecules_from_pdf(filepath: str) -> list:\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079776, "o", "> "]
[238.079796, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[238.079804, "o", "\u001b[?2004h"]
[238.07981, "o", "> "]
[238.079882, "o", "    Extract chemical names from a PDF file.\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079899, "o", "> "]
[238.079907, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[238.079913, "o", "\u001b[?2004h"]
[238.079928, "o", "> "]
[238.079955, "o", "    molecules = []\r\n\u001b[?2004l\r"]
[238.079962, "o", "\u001b[?2004h"]
[238.079968, "o", "> "]
[238.080292, "o", "    with pdfplumber.open(filepath) as pdf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.080317, "o", "        for page in pdf.pages:\r\n\u001b[?2004l\r\u001b[?2004h>             text = page.extract_text()\r\n\u001b[?2004l\r\u001b[?2004h>             if text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.080406, "o", "                # Split by newlines and filter empty lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.080473, "o", "                lines = [line.strip() for line in text.split('\\n') if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.080483, "o", "> "]
[238.080553, "o", "                molecules.extend(lines)\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.080564, "o", "> "]
[238.080599, "o", "    return molecules\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.080621, "o", "> \r\n\u001b[?2004l\r"]
[238.080643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[238.080666, "o", "\u001b[?2004h> "]
[238.080749, "o", "def topk_tanimoto_similarity_molecules(target_molecule_name: str, \r\n\u001b[?2004l\r"]
[238.080759, "o", "\u001b[?2004h> "]
[238.080875, "o", "                                        molecule_pool_filepath: str, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.080971, "o", "                                        top_k: int) -> list:\r\n\u001b[?2004l\r"]
[238.080996, "o", "\u001b[?2004h> "]
[238.081016, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.081038, "o", "> "]
[238.081119, "o", "    Find the top k most similar chemicals to the target molecule.\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.081144, "o", "> "]
[238.081166, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.081197, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.08128, "o", "        target_molecule_name: Name of the target chemical\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.081304, "o", "> "]
[238.081422, "o", "        molecule_pool_filepath: Path to PDF file containing list of chemicals\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.08145, "o", "> "]
[238.081509, "o", "        top_k: Number of top similar molecules to return\r\n\u001b[?2004l\r"]
[238.081537, "o", "\u001b[?2004h> "]
[238.081559, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.081588, "o", "    Returns:\r\n\u001b[?2004l\r"]
[238.081617, "o", "\u001b[?2004h> "]
[238.081701, "o", "        List of chemical names sorted by Tanimoto similarity (descending),\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.081725, "o", "> "]
[238.081782, "o", "        with alphabetical ordering for ties.\r\n\u001b[?2004l\r"]
[238.081805, "o", "\u001b[?2004h> "]
[238.081829, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.081882, "o", "    # Get SMILES for target molecule\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.081911, "o", "> "]
[238.081987, "o", "    target_smiles = get_smiles_from_name(target_molecule_name)\r\n\u001b[?2004l\r"]
[238.082008, "o", "\u001b[?2004h> "]
[238.082052, "o", "    if target_smiles is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.082076, "o", "> "]
[238.082204, "o", "        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\r\n\u001b[?2004l\r"]
[238.082232, "o", "\u001b[?2004h> "]
[238.082259, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.082321, "o", "    # Get fingerprint for target molecule\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.08242, "o", "    target_fp = get_morgan_fingerprint(target_smiles)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.082479, "o", "    if target_fp is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.082655, "o", "        raise ValueError(f\"Could not generate fingerprint for target molecule: {target_molecule_name}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.082687, "o", "    \r\n\u001b[?2004l\r"]
[238.08272, "o", "\u001b[?2004h> "]
[238.082766, "o", "    # Extract molecules from PDF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.082854, "o", "    molecule_names = extract_molecules_from_pdf(molecule_pool_filepath)\r\n\u001b[?2004l\r"]
[238.082877, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[238.082899, "o", "\u001b[?2004h> "]
[238.082942, "o", "    # Calculate similarities\r\n\u001b[?2004l\r"]
[238.082965, "o", "\u001b[?2004h> "]
[238.082992, "o", "    similarities = []\r\n\u001b[?2004l\r"]
[238.083022, "o", "\u001b[?2004h> "]
[238.083062, "o", "    for mol_name in molecule_names:\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.083084, "o", "> "]
[238.083142, "o", "        # Skip if it's the same as target\r\n\u001b[?2004l\r"]
[238.083171, "o", "\u001b[?2004h> "]
[238.083247, "o", "        if mol_name.lower() == target_molecule_name.lower():\r\n\u001b[?2004l\r"]
[238.083269, "o", "\u001b[?2004h> "]
[238.08329, "o", "            continue\r\n\u001b[?2004l\r"]
[238.083316, "o", "\u001b[?2004h> "]
[238.083345, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.083419, "o", "        smiles = get_smiles_from_name(mol_name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.083449, "o", "> "]
[238.083475, "o", "        if smiles is None:\r\n\u001b[?2004l\r"]
[238.083504, "o", "\u001b[?2004h> "]
[238.083529, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.083554, "o", "            \r\n\u001b[?2004l\r"]
[238.083575, "o", "\u001b[?2004h> "]
[238.083635, "o", "        fp = get_morgan_fingerprint(smiles)\r\n\u001b[?2004l\r"]
[238.083659, "o", "\u001b[?2004h> "]
[238.083693, "o", "        if fp is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.083735, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.083757, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[238.083779, "o", "> "]
[238.083843, "o", "        # Calculate Tanimoto similarity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.083958, "o", "        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.083981, "o", "> "]
[238.084047, "o", "        similarities.append((mol_name, similarity))\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.08407, "o", ">     \r\n\u001b[?2004l\r"]
[238.084095, "o", "\u001b[?2004h> "]
[238.084186, "o", "    # Sort by similarity (descending), then alphabetically for ties\r\n\u001b[?2004l\r"]
[238.084215, "o", "\u001b[?2004h> "]
[238.084285, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.084312, "o", "    \r\n\u001b[?2004l\r"]
[238.084335, "o", "\u001b[?2004h> "]
[238.084374, "o", "    # Return top k molecule names\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.084404, "o", "> "]
[238.084488, "o", "    return [mol_name for mol_name, _ in similarities[:top_k]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[238.084509, "o", "\u001b[?2004h> \r\n"]
[238.084541, "o", "\u001b[?2004l\r"]
[238.084566, "o", "\u001b[?2004h> "]
[238.084589, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[238.084618, "o", "\u001b[?2004h> "]
[238.084648, "o", "    # Test the function\r\n\u001b[?2004l\r"]
[238.084671, "o", "\u001b[?2004h> "]
[238.084722, "o", "    result = topk_tanimoto_similarity_molecules(\r\n\u001b[?2004l\r"]
[238.084751, "o", "\u001b[?2004h> "]
[238.084777, "o", "        \"Aspirin\", \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.084842, "o", "        \"/root/workspace/molecules.pdf\", \r\n\u001b[?2004l\r"]
[238.08487, "o", "\u001b[?2004h> "]
[238.084893, "o", "        5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.084917, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.084987, "o", "    print(\"Top 5 similar molecules to Aspirin:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.085012, "o", "> "]
[238.085065, "o", "    for i, mol in enumerate(result, 1):\r\n\u001b[?2004l\r"]
[238.085093, "o", "\u001b[?2004h> "]
[238.085126, "o", "        print(f\"  {i}. {mol}\")\r\n\u001b[?2004l\r"]
[238.085155, "o", "\u001b[?2004h> "]
[238.085179, "o", "EOF\r\n\u001b[?2004l\r"]
