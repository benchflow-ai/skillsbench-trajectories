[51.151181, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.151232, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.151334, "o", "    # Return top k molecule names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.151452, "o", "    return [mol_name for mol_name, _ in similarities[:top_k]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
