[238.077254, "o", "\u001b[?2004h> "]
[238.077331, "o", "def get_smiles_from_name(chemical_name: str) -> str:\r\n\u001b[?2004l\r"]
[238.077361, "o", "\u001b[?2004h> "]
[238.077379, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.077455, "o", "    Convert a chemical name to SMILES using PubChem.\r\n\u001b[?2004l\r"]
[238.077471, "o", "\u001b[?2004h> "]
[238.077549, "o", "    Uses caching to avoid repeated API calls.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.077636, "o", "    Includes retry logic for transient network issues.\r\n\u001b[?2004l\r"]
[238.077647, "o", "\u001b[?2004h> "]
[238.077667, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[238.077673, "o", "\u001b[?2004h"]
[238.07768, "o", "> "]
[238.077771, "o", "    max_retries = 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.077812, "o", "    for attempt in range(max_retries):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.077846, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.077873, "o", "> "]
[238.077966, "o", "            compounds = pcp.get_compounds(chemical_name, 'name')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.077995, "o", "            if compounds:\r\n\u001b[?2004l\r"]
[238.078024, "o", "\u001b[?2004h> "]
[238.07813, "o", "                # Use isomeric_smiles to preserve chirality information\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.078229, "o", "                return compounds[0].isomeric_smiles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.078281, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[238.078314, "o", "\u001b[?2004h"]
[238.078342, "o", "> "]
[238.078369, "o", "            if attempt < max_retries - 1:\r\n\u001b[?2004l\r"]
[238.078398, "o", "\u001b[?2004h> "]
[238.078492, "o", "                time.sleep(0.5 * (attempt + 1))  # Exponential backoff\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.07853, "o", "            continue\r\n\u001b[?2004l\r"]
[238.078554, "o", "\u001b[?2004h> "]
[238.078588, "o", "    return None\r\n\u001b[?2004l\r"]
[238.078617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[238.078646, "o", "> "]
[238.078771, "o", "# Create Morgan fingerprint generator with radius=2 and chirality\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.07885, "o", "_morgan_generator = rdFingerprintGenerator.GetMorganGenerator(\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.078874, "o", "> "]
[238.078895, "o", "    radius=2,\r\n\u001b[?2004l\r"]
[238.078918, "o", "\u001b[?2004h> "]
[238.078944, "o", "    includeChirality=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.078983, "o", "    fpSize=2048\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079004, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079031, "o", "> \r\n\u001b[?2004l\r"]
[238.079057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.079113, "o", "def get_morgan_fingerprint(smiles: str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.079137, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079163, "o", "> "]
[238.079247, "o", "    Generate Morgan fingerprint for a molecule from its SMILES.\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079266, "o", "> "]
[238.079343, "o", "    Uses radius=2 and includes chirality as specified.\r\n\u001b[?2004l\r"]
[238.079348, "o", "\u001b[?2004h"]
[238.079357, "o", "> "]
[238.079373, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[238.07939, "o", "\u001b[?2004h> "]
[238.079448, "o", "    mol = Chem.MolFromSmiles(smiles)\r\n\u001b[?2004l\r"]
[238.079452, "o", "\u001b[?2004h"]
[238.07947, "o", "> "]
[238.079491, "o", "    if mol is None:\r\n\u001b[?2004l\r"]
[238.079512, "o", "\u001b[?2004h> "]
[238.079541, "o", "        return None\r\n\u001b[?2004l\r"]
[238.079546, "o", "\u001b[?2004h"]
[238.07956, "o", "> "]
[238.079632, "o", "    return _morgan_generator.GetFingerprint(mol)\r\n\u001b[?2004l\r"]
[238.079636, "o", "\u001b[?2004h"]
[238.07965, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[238.079655, "o", "> \r\n"]
