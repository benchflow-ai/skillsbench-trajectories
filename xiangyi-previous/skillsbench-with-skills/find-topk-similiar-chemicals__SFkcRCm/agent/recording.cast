[453.50065, "o", "            \r\n\u001b[?2004l\r"]
[453.500671, "o", "\u001b[?2004h"]
[453.500692, "o", "> "]
[453.500787, "o", "        smiles = get_smiles_from_name(mol_name)\r\n\u001b[?2004l\r"]
[453.500813, "o", "\u001b[?2004h"]
[453.500838, "o", "> "]
[453.500872, "o", "        if smiles is None:\r\n\u001b[?2004l\r"]
[453.500896, "o", "\u001b[?2004h> "]
[453.500961, "o", "            continue\r\n\u001b[?2004l\r"]
[453.500983, "o", "\u001b[?2004h> "]
[453.501024, "o", "            \r\n\u001b[?2004l\r"]
[453.501048, "o", "\u001b[?2004h> "]
[453.501155, "o", "        fp = get_morgan_fingerprint(smiles)\r\n\u001b[?2004l\r"]
[453.501177, "o", "\u001b[?2004h> "]
[453.501227, "o", "        if fp is None:\r\n\u001b[?2004l\r"]
[453.501252, "o", "\u001b[?2004h> "]
[453.501312, "o", "            continue\r\n\u001b[?2004l\r"]
[453.501334, "o", "\u001b[?2004h"]
[453.501361, "o", "> "]
[453.501374, "o", "        \r\n\u001b[?2004l\r"]
[453.501391, "o", "\u001b[?2004h> "]
[453.501491, "o", "        # Calculate Tanimoto similarity\r\n\u001b[?2004l\r"]
[453.501511, "o", "\u001b[?2004h"]
[453.501531, "o", "> "]
[453.501652, "o", "        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\r\n\u001b[?2004l\r"]
[453.501665, "o", "\u001b[?2004h> "]
[453.501791, "o", "        similarities.append((mol_name, similarity))\r\n\u001b[?2004l\r\u001b[?2004h"]
[453.501811, "o", ">     \r\n\u001b[?2004l\r"]
[453.501833, "o", "\u001b[?2004h"]
[453.501854, "o", "> "]
[453.50198, "o", "    # Sort by similarity (descending), then alphabetically for ties\r\n\u001b[?2004l\r"]
[453.502003, "o", "\u001b[?2004h> "]
[453.502109, "o", "    similarities.sort(key=lambda x: (-x[1], x[0]))\r\n\u001b[?2004l\r"]
[453.502143, "o", "\u001b[?2004h>     \r\n"]
[453.502167, "o", "\u001b[?2004l\r"]
[453.502189, "o", "\u001b[?2004h> "]
[453.502261, "o", "    # Return top k molecule names\r\n\u001b[?2004l\r"]
[453.502286, "o", "\u001b[?2004h"]
[453.502307, "o", "> "]
[453.502417, "o", "    return [mol_name for mol_name, _ in similarities[:top_k]]\r\n\u001b[?2004l\r"]
[453.50244, "o", "\u001b[?2004h"]
[453.502456, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[453.502472, "o", "> \r\n\u001b[?2004l\r"]
[453.502494, "o", "\u001b[?2004h> "]
[453.502553, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[453.502576, "o", "\u001b[?2004h> "]
[453.502664, "o", "    # Test the function\r\n\u001b[?2004l\r"]
[453.502683, "o", "\u001b[?2004h"]
[453.502702, "o", "> "]
[453.502799, "o", "    result = topk_tanimoto_similarity_molecules(\r\n\u001b[?2004l\r"]
[453.502821, "o", "\u001b[?2004h> "]
[453.502874, "o", "        \"Aspirin\", \r\n\u001b[?2004l\r"]
[453.5029, "o", "\u001b[?2004h"]
[453.502927, "o", "> "]
[453.503005, "o", "        \"/root/workspace/molecules.pdf\", \r\n\u001b[?2004l\r"]
[453.503031, "o", "\u001b[?2004h> "]
[453.503056, "o", "        5\r\n\u001b[?2004l\r"]
[453.503078, "o", "\u001b[?2004h> "]
[453.503095, "o", "    )\r\n\u001b[?2004l\r"]
[453.503119, "o", "\u001b[?2004h"]
[453.503138, "o", "> "]
[453.503238, "o", "    print(\"Top 5 similar molecules to Aspirin:\")\r\n\u001b[?2004l\r"]
[453.503263, "o", "\u001b[?2004h> "]
[453.503349, "o", "    for i, mol in enumerate(result, 1):\r\n\u001b[?2004l\r"]
[453.503374, "o", "\u001b[?2004h> "]
[453.503456, "o", "        print(f\"  {i}. {mol}\")\r\n\u001b[?2004l\r"]
[453.503481, "o", "\u001b[?2004h> "]
[453.503508, "o", "EOF\r\n\u001b[?2004l\r"]
[453.504762, "o", "\u001b[?2004hroot@3cdd77c4e93f:~/workspace# "]
