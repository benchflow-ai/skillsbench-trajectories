[238.076265, "i", "cat > /root/workspace/solution.py << 'EOF'\nimport pdfplumber\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import rdFingerprintGenerator\nfrom rdkit import DataStructs\nfrom functools import lru_cache\nimport time\n\n\n@lru_cache(maxsize=1000)\ndef get_smiles_from_name(chemical_name: str) -> str:\n    \"\"\"\n    Convert a chemical name to SMILES using PubChem.\n    Uses caching to avoid repeated API calls.\n    Includes retry logic for transient network issues.\n    \"\"\"\n    max_retries = 3\n    for attempt in range(max_retries):\n        try:\n            compounds = pcp.get_compounds(chemical_name, 'name')\n            if compounds:\n                # Use isomeric_smiles to preserve chirality information\n                return compounds[0].isomeric_smiles\n        except Exception as e:\n            if attempt < max_retries - 1:\n                time.sleep(0.5 * (attempt + 1))  # Exponential backoff\n            continue\n    return None\n\n\n# Create Morgan fingerprint generator with radius=2 and chirality\n_morgan_ge"]
[238.076309, "i", "nerator = rdFingerprintGenerator.GetMorganGenerator(\n    radius=2,\n    includeChirality=True,\n    fpSize=2048\n)\n\n\ndef get_morgan_fingerprint(smiles: str):\n    \"\"\"\n    Generate Morgan fingerprint for a molecule from its SMILES.\n    Uses radius=2 and includes chirality as specified.\n    \"\"\"\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        return None\n    return _morgan_generator.GetFingerprint(mol)\n\n\ndef extract_molecules_from_pdf(filepath: str) -> list:\n    \"\"\"\n    Extract chemical names from a PDF file.\n    \"\"\"\n    molecules = []\n    with pdfplumber.open(filepath) as pdf:\n        for page in pdf.pages:\n            text = page.extract_text()\n            if text:\n                # Split by newlines and filter empty lines\n                lines = [line.strip() for line in text.split('\\n') if line.strip()]\n                molecules.extend(lines)\n    return molecules\n\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name: str, \n                                        molecule_pool_filepath: s"]
[238.076319, "i", "tr, \n                                        top_k: int) -> list:\n    \"\"\"\n    Find the top k most similar chemicals to the target molecule.\n    \n    Args:\n        target_molecule_name: Name of the target chemical\n        molecule_pool_filepath: Path to PDF file containing list of chemicals\n        top_k: Number of top similar molecules to return\n    \n    Returns:\n        List of chemical names sorted by Tanimoto similarity (descending),\n        with alphabetical ordering for ties.\n    \"\"\"\n    # Get SMILES for target molecule\n    target_smiles = get_smiles_from_name(target_molecule_name)\n    if target_smiles is None:\n        raise ValueError(f\"Could not find SMILES for target molecule: {target_molecule_name}\")\n    \n    # Get fingerprint for target molecule\n    target_fp = get_morgan_fingerprint(target_smiles)\n    if target_fp is None:\n        raise ValueError(f\"Could not generate fingerprint for target molecule: {target_molecule_name}\")\n    \n    # Extract molecules from PDF\n    molecule_names = extract_molecul"]
[238.07645, "i", "es_from_pdf(molecule_pool_filepath)\n    \n    # Calculate similarities\n    similarities = []\n    for mol_name in molecule_names:\n        # Skip if it's the same as target\n        if mol_name.lower() == target_molecule_name.lower():\n            continue\n            \n        smiles = get_smiles_from_name(mol_name)\n        if smiles is None:\n            continue\n            \n        fp = get_morgan_fingerprint(smiles)\n        if fp is None:\n            continue\n        \n        # Calculate Tanimoto similarity\n        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\n        similarities.append((mol_name, similarity))\n    \n    # Sort by similarity (descending), then alphabetically for ties\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n    \n    # Return top k molecule names\n    return [mol_name for mol_name, _ in similarities[:top_k]]\n\n\nif __name__ == \"__main__\":\n    # Test the function\n    result = topk_tanimoto_similarity_molecules(\n        \"Aspirin\", \n        \"/root/workspace/molecules.pdf\", \n     "]
[238.076487, "o", "cat > /root/workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[238.076534, "i", "   5\n    )\n    print(\"Top 5 similar molecules to Aspirin:\")\n    for i, mol in enumerate(result, 1):\n        print(f\"  {i}. {mol}\")\nEOF\n"]
[238.076585, "o", "es_from_pdf(molecule_pool_filepath)\r\n    \r\n    # Calculate similarities\r\n    similarities = []\r\n    for mol_name in molecule_names:\r\n        # Skip if it's the same as target\r\n        if mol_name.lower() == target_molecule_name.lower():\r\n            continue\r\n            \r\n        smiles = get_smiles_from_name(mol_name)\r\n        if smiles is None:\r\n            continue\r\n            \r\n        fp = get_morgan_fingerprint(smiles)\r\n        if fp is None:\r\n            continue\r\n        \r\n        # Calculate Tanimoto similarity\r\n        similarity = DataStructs.TanimotoSimilarity(target_fp, fp)\r\n        similarities.append((mol_name, similarity))\r\n    \r\n    # Sort by similarity (descending), then alphabetically for ties\r\n   "]
[238.076615, "o", " similarities.sort(key=lambda x: (-x[1], x[0"]
[238.076641, "o", "]))\r\n    \r\n    # Return top k molecule names\r\n    return [mol_name for mol_name, _ in similarities[:top_k]]\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    # Test the function\r\n    result = topk_tanimoto_similarity_molecules(\r\n        \"Aspirin\", \r\n        \"/root/workspace/molecules.pdf\", \r\n        5\r\n    )\r\n    print(\"Top 5 similar molecu"]
[238.076695, "o", "\u001b[?2004h> "]
[238.076722, "o", "import pdfplumber\r\n\u001b[?2004l\r"]
[238.076743, "o", "\u001b[?2004h> "]
[238.076812, "o", "import pubchempy as pcp\r\n\u001b[?2004l\r"]
[238.076821, "o", "\u001b[?2004h> "]
[238.076893, "o", "from rdkit import Chem\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.076902, "o", "> "]
[238.076982, "o", "from rdkit.Chem import rdFingerprintGenerator\r\n\u001b[?2004l\r"]
[238.076991, "o", "\u001b[?2004h> "]
[238.077046, "o", "from rdkit import DataStructs\r\n\u001b[?2004l\r"]
[238.077055, "o", "\u001b[?2004h"]
[238.077069, "o", "> "]
