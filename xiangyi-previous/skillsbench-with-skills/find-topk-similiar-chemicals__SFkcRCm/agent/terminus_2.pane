[?2004l[?2004h>         for page in pdf.pages:
[?2004l[?2004h>             text = page.extract_text()
[?2004l[?2004h>             if text:
[?2004l[?2004h>                 # Split by newlines and filter empty lines
[?2004l[?2004h>                 lines = [line.strip() for line in text.split('\n') if line.strip()]
[?2004l[?2004h>                 molecules.extend(lines)
[?2004l[?2004h>     return molecules
