[?2004l[?2004h>     
[?2004l[?2004h>     # Get fingerprint for target molecule
[?2004l[?2004h>     target_fp = get_morgan_fingerprint(target_smiles)
[?2004l[?2004h>     if target_fp is None:
[?2004l[?2004h>         raise ValueError(f"Could not generate fingerprint for target molecule: {target_molecule_name}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract molecules from PDF
