[?2004l[?2004h> def get_smiles_from_name(chemical_name: str) -> str:
[?2004l[?2004h>     """
[?2004l[?2004h>     Convert a chemical name to SMILES using PubChem.
[?2004l[?2004h>     Uses caching to avoid repeated API calls.
