[285.320113, "o", "ioctl$PPRELEASE(fd fd_ppdev, cmd const[PPRELEASE])\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.32014, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320164, "o", "> "]
[285.320265, "o", "# Yield the port (release it if another driver is waiting, then reclaim)\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320291, "o", "> "]
[285.320361, "o", "ioctl$PPYIELD(fd fd_ppdev, cmd const[PPYIELD])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[285.320386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[285.320464, "o", "# Register device exclusively (must be before PPCLAIM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320489, "o", "> "]
[285.320558, "o", "ioctl$PPEXCL(fd fd_ppdev, cmd const[PPEXCL])\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320583, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.320663, "o", "# Data line direction: non-zero for input mode\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320688, "o", "> "]
[285.320782, "o", "ioctl$PPDATADIR(fd fd_ppdev, cmd const[PPDATADIR], arg ptr[in, int32])\r\n\u001b[?2004l\r"]
[285.320818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[285.320849, "o", "> "]
[285.320913, "o", "# Negotiate a particular IEEE 1284 mode\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.321056, "o", "ioctl$PPNEGOT(fd fd_ppdev, cmd const[PPNEGOT], arg ptr[in, flags[ieee1284_modes, int32]])\r\n\u001b[?2004l\r"]
[285.321081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[285.321114, "o", "> "]
[285.321182, "o", "# Set control lines when an interrupt occurs\r\n\u001b[?2004l\r"]
[285.321212, "o", "\u001b[?2004h> "]
[285.32134, "o", "ioctl$PPWCTLONIRQ(fd fd_ppdev, cmd const[PPWCTLONIRQ], arg ptr[in, int8])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.32137, "o", "\u001b[?2004h> "]
[285.321437, "o", "# Clear (and return) interrupt count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.321563, "o", "ioctl$PPCLRIRQ(fd fd_ppdev, cmd const[PPCLRIRQ], arg ptr[out, int32])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.32159, "o", "\u001b[?2004h> "]
[285.321664, "o", "# Set the IEEE 1284 phase"]
[285.321716, "o", "\r\n\u001b[?2004l\r"]
[285.321747, "o", "\u001b[?2004h> "]
[285.321863, "o", "ioctl$PPSETPHASE(fd fd_ppdev, cmd const[PPSETPHASE], arg ptr[in, int32])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.32189, "o", "\u001b[?2004h> "]
[285.321966, "o", "# Set and get port timeout (struct timeval's)\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.32199, "o", "> "]
[285.322757, "o", "ioctl$PPGETTIME(fd fd_ppdev, cmd const[PPGETTIME], arg ptr[out, timeval])\r\n\u001b[?2004l\r\u001b[?2004h> ioctl$PPSETTIME(fd fd_ppdev, cmd const[PPSETTIME], arg ptr[in, timeval])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.322842, "o", "# Get available modes (what the hardware can do)\r\n\u001b[?2004l\r\u001b[?2004h> ioctl$PPGETMODES(fd fd_ppdev, cmd const[PPGETMODES], arg ptr[out, flags[ieee1284_modes, int32]])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get the current mode and phase\r\n\u001b[?2004l\r\u001b[?2004h> ioctl$PPGETMODE(fd fd_ppdev, cmd const[PPGETMODE], arg ptr[out, flags[ieee1284_modes, int32]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.322905, "o", "ioctl$PPGETPHASE(fd fd_ppdev, cmd const[PPGETPHASE], arg ptr[out, int32])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.322952, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Get/set flags\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.322993, "o", "> "]
[285.323116, "o", "ioctl$PPGETFLAGS(fd fd_ppdev, cmd const[PPGETFLAGS], arg ptr[out, flags[ppdev_flags, int32]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.323254, "o", "ioctl$PPSETFLAGS(fd fd_ppdev, cmd const[PPSETFLAGS], arg ptr[in, flags[ppdev_flags, int32]])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[285.323295, "o", "\u001b[?2004h> "]
[285.323336, "o", "ppdev_frob_struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.323376, "o", "        mask    int8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.323437, "o", "        val     int8\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[285.323586, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[285.323859, "o", "ieee1284_modes = IEEE1284_MODE_NIBBLE, IEEE1284_MODE_BYTE, IEEE1284_MODE_COMPAT, IEEE1284_MODE_ECP, IEEE1284_MODE_ECPRLE, IEEE1284_MODE_ECPSWE, IEEE1284_MODE_EPP, IEEE1284_MODE_BECP, IEEE1284_MODE_EPPSL, IEEE1284_MODE_EPPSWE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[285.323952, "o", "> ppdev_flags = PP_FASTWRITE, PP_FASTREAD, PP_W91284PIC\r\n\u001b[?2004l\r\u001b[?2004h"]
[285.324057, "o", "> EOFFILE\r\n\u001b[?2004l\r"]
