[112.940261, "o", "\u001b[?2004hroot@3b01e4f2f411:~# "]
[117.581755, "i", "cat /opt/syzkaller/sys/linux/dev_ppdev.txt\n"]
[117.582133, "o", "cat /opt/syzkaller/sys/linux/dev_ppdev.txt\r\n\u001b[?2004l\r"]
[117.583283, "o", "# Copyright 2024 syzkaller project authors. All rights reserved.\r\n# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.\r\n\r\n# Linux parallel port driver (ppdev)\r\n# https://elixir.bootlin.com/linux/latest/source/drivers/char/ppdev.c\r\n\r\ninclude <linux/ppdev.h>\r\ninclude <linux/parport.h>\r\ninclude <uapi/linux/fcntl.h>\r\n\r\nresource fd_ppdev[fd]\r\n\r\n"]
[117.583335, "o", "syz_open_dev$ppdev(dev ptr[in, string[\"/dev/parport#\"]], id intptr, flags flags[open_flags]) fd_ppdev\r\n\r\n# Set mode for read/write (e.g. IEEE1284_MODE_EPP)\r\nioctl$PPSETMODE(fd fd_ppdev, cmd const[PPSETMODE], arg ptr[in, int32])\r\n\r\n# Read status\r\nioctl$PPRSTATUS(fd fd_ppdev, cmd const[PPRSTATUS], arg ptr[out, int8])\r\n\r\n# Read/write control\r\nioctl$PPRCONTROL(fd fd_ppdev, cmd const[PPRCONTROL], arg ptr[out, int8])\r\nioctl$PPWCONTROL(fd fd_ppdev, cmd const[PPWCONTROL], arg ptr[in, int8])\r\n\r\n# Frob control bits\r\nioctl$PPFCONTROL(fd fd_ppdev, cmd const[PPFCONTROL], arg ptr[in, ppdev_frob_struct])\r\n\r\n# Read/write data\r\nioctl$PPRDATA(fd fd_ppdev, cmd const[PPRDATA], arg ptr[out, int8])\r\nioctl$PPWDATA(fd fd_ppdev, cmd const[PPWDATA], arg ptr[in, int8])"]
[117.583375, "o", "\r\n\r\n# Claim the port to start using it\r\nioctl$PPCLAIM(fd fd_ppdev, cmd const[PPCLAIM])\r\n\r\n# Release the port when you aren't using it\r\nioctl$PPRELEASE(fd fd_ppdev, cmd const[PPRELEASE])\r\n\r\n# Yield the port (release it if another driver is waiting, then reclaim)\r\nioctl$PPYIELD(fd fd_ppdev, cmd const[PPYIELD])\r\n\r\n# Register device exclusively (must be before PPCLAIM)\r\nioctl$PPEXCL(fd fd_ppdev, cmd const[PPEXCL])\r\n\r\n# Data line direction: non-zero for input mode\r\n"]
[117.583408, "o", "ioctl$PPDATADIR(fd fd_ppdev, cmd const[PPDATADIR], arg ptr[in, int32])\r\n\r\n# Negotiate a particular IEEE 1284 mode\r\nioctl$PPNEGOT(fd fd_ppdev, cmd const[PPNEGOT], arg ptr[in, int32])\r\n\r\n# Set control lines when an interrupt occurs\r\nioctl$PPWCTLONIRQ(fd fd_ppdev, cmd const[PPWCTLONIRQ], arg ptr[in, int8])\r\n\r\n# Clear (and return) interrupt count\r\n"]
[117.583443, "o", "ioctl$PPCLRIRQ(fd fd_ppdev, cmd const[PPCLRIRQ], arg ptr[out, int32])\r\n\r\n# Set the IEEE 1284 phase\r\nioctl$PPSETPHASE(fd fd_ppdev, cmd const[PPSETPHASE], arg ptr[in, int32])\r\n\r\n# Set and get port timeout (struct timeval's)\r\nioctl$PPGETTIME(fd fd_ppdev, cmd const[PPGETTIME], arg ptr[out, timeval])\r\nioctl$PPSETTIME(fd fd_ppdev, cmd const[PPSETTIME], arg ptr[in, timeval])\r\n\r\n# Get available modes (what the hardware can do)\r\nioctl$PPGETMODES(fd fd_ppdev, cmd const[PPGETMODES], arg ptr[out, int32])\r\n\r\n# Get the current mode and phase\r\nioctl$PPGETMODE(fd fd_ppdev, cmd const[PPGETMODE], arg ptr[out, int32])\r\nioctl$PPGETPHASE(fd fd_ppdev, cmd const[PPGETPHASE], arg ptr[out, int32])\r\n\r\n# Get/set flags\r\nioctl$PPGETFLAGS(fd fd_ppdev, cmd const[PPGETFLAGS], arg ptr[out, int32])\r\nioctl$PPSETFLAGS(fd fd_ppdev, cmd const[PPSETFLAGS], arg ptr[in, int32])\r\n\r\nppdev_frob_struct {\r\n.maskint8\r\n.valint8\r\n}\r\n\r\nieee1284_modes = IEEE1284_MODE_NIBBLE, IEEE1284_MODE_BYTE, IEEE1284_MODE_COMPAT, IEEE1284_MODE_ECP, IEEE1284_MODE_ECPRLE, IEEE1284_MODE_ECPSWE, IEEE1284_MODE_EPP, IEEE1284_MODE_BECP, IEEE1284_MODE_EPPSL, IEEE1284_MODE_EPPSWE\r\n"]
[117.583483, "o", "\r\nppdev_flags = PP_FASTWRITE, PP_FASTREAD, PP_W91284PIC\r\n"]
[117.583826, "o", "\u001b[?2004hroot@3b01e4f2f411:~# "]
[120.916981, "i", "rm /opt/syzkaller/sys/linux/dev_ppdev.txt\n"]
[120.917244, "o", "rm /opt/syzkaller/sys/linux/dev_ppdev.txt\r\n\u001b[?2004l\r"]
[120.918396, "o", "\u001b[?2004hroot@3b01e4f2f411:~# "]
[131.493879, "i", "cat > /opt/syzkaller/sys/linux/dev_ppdev.txt << 'EOFFILE'\n# Copyright 2024 syzkaller project authors. All rights reserved.\n# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.\n\n# Linux parallel port driver (ppdev)\n# https://elixir.bootlin.com/linux/latest/source/drivers/char/ppdev.c\n\ninclude <linux/ppdev.h>\ninclude <linux/parport.h>\ninclude <uapi/linux/fcntl.h>\n\nresource fd_ppdev[fd]\n\nsyz_open_dev$ppdev(dev ptr[in, string[\"/dev/parport#\"]], id intptr, flags flags[open_flags]) fd_ppdev\n\n# Set mode for read/write (e.g. IEEE1284_MODE_EPP)\nioctl$PPSETMODE(fd fd_ppdev, cmd const[PPSETMODE], arg ptr[in, int32])\n\n# Read status\nioctl$PPRSTATUS(fd fd_ppdev, cmd const[PPRSTATUS], arg ptr[out, int8])\n\n# Read/write control\nioctl$PPRCONTROL(fd fd_ppdev, cmd const[PPRCONTROL], arg ptr[out, int8])\nioctl$PPWCONTROL(fd fd_ppdev, cmd const[PPWCONTROL], arg ptr[in, int8])\n\n# Frob control bits\nioctl$PPFCONTROL(fd fd_ppdev, cmd const[PPFCONTROL], arg ptr[in, ppdev_frob_struct])\n\n# Read/write data\nioctl$PPRDATA(fd fd_ppdev, cmd const[PPRDATA], arg ptr[out, int8])\nioctl$PPWDATA(fd fd_ppdev, cmd const[PPWDATA], arg ptr[in, int8])\n\n# Claim the port to start using it\nioctl$PPCLAIM(fd fd_ppdev, cmd const[PPCLAIM])\n\n# Release the port when you aren't using it\nioctl$PPRELEASE(fd fd_ppdev, cmd const[PPRELEASE])\n\n# Yield the port (release it if another driver is waiting, then reclaim)\nioctl$PPYIELD(fd fd_ppdev, cmd const[PPYIELD])\n\n# Register device exclusively (must be before PPCLAIM)\nioctl$PPEXCL(fd fd_ppdev, cmd const[PPEXCL])\n\n# Data line direction: non-zero for input mode\nioctl$PPDATADIR(fd fd_ppdev, cmd const[PPDATADIR], arg ptr[in, int32])\n\n# Negotiate a particular IEEE 1284 mode\nioctl$PPNEGOT(fd fd_ppdev, cmd const[PPNEGOT], arg ptr[in, int32])\n\n# Set control lines when an interrupt occurs\nioctl$PPWCTLONIRQ(fd fd_ppdev, cmd const[PPWCTLONIRQ], arg ptr[in, int8])\n\n# Clear (and return) interrupt count\nioctl$PPCLRIRQ(fd fd_ppdev, cmd const[PPCLRIRQ], arg ptr[out, int32])\n\n# Set the IEEE 1284 phase\nioctl$PPSETPHASE(fd fd_ppdev, cmd const[PPSETPHASE], arg ptr[in, int32])\n\n# Set and get port timeout (struct timeval's)\nioctl$PPGETTIME(fd fd_ppdev, cmd const[PPGETTIME], arg ptr[out, timeval])\nioctl$PPSETTIME(fd fd_ppdev, cmd const[PPSETTIME], arg ptr[in, timeval])\n\n# Get available modes (what the hardware can do)\nioctl$PPGETMODES(fd fd_ppdev, cmd const[PPGETMODES], arg ptr[out, int32])\n\n# Get the current mode and phase\nioctl$PPGETMODE(fd fd_ppdev, cmd const[PPGETMODE], arg ptr[out, int32])\nioctl$PPGETPHASE(fd fd_ppdev, cmd const[PPGETPHASE], arg ptr[out, int32])\n\n# Get/set flags\nioctl$PPGETFLAGS(fd fd_ppdev, cmd const[PPGETFLAGS], arg ptr[out, int32])\nioctl$PPSETFLAGS(fd fd_ppdev, cmd const[PPSETFLAGS], arg ptr[in, int32])\n\nppdev_frob_struct {\n        mask    int8\n        val     int8\n}\n\nieee1284_modes = IEEE1284_MODE_NIBBLE, IEEE1284_MODE_BYTE, IEEE1284_MODE_COMPAT, IEEE1284_MODE_ECP, IEEE1284_MODE_ECPRLE, IEEE1284_MODE_ECPSWE, IEEE1284_MODE_EPP, IEEE1284_MODE_BECP, IEEE1284_MODE_EPPSL, IEEE1284_MODE_EPPSWE\n\nppdev_flags = PP_FASTWRITE, PP_FASTREAD, PP_W91284PIC\nEOFFILE\n"]
