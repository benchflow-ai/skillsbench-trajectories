[72.538953, "o", "\u001b[?2004hroot@3b01e4f2f411:~# "]
[76.940222, "i", "grep -i 'phase\\|IEEE1284' /usr/include/linux/parport.h | grep define\n"]
[76.9406, "o", "grep -i 'phase\\|IEEE1284' /usr/include/linux/parport.h | grep define\r\n\u001b[?2004l\r"]
[76.955752, "o", "#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_NIBBLE             0\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_BYTE              (1<<0)\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_COMPAT            (1<<8)\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_BECP              (1<<9) /* Bounded ECP mode */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_ECP               (1<<4)\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_ECPRLE            (IEEE1284_MODE_ECP | (1<<5))\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_ECPSWE            (1<<10) /* Software-emulated */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_EPP               (1<<6)\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_EPPSL             (1<<11) /* EPP 1.7 */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_MODE_EPPSWE            (1<<12) /* Software-emulated */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_DEVICEID               (1<<2)  /* This is a flag */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_EXT_LINK               (1<<14) /* This flag causes the\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_ADDR\t\t\t(1<<13)\t/* This is a flag */\r\n#\u001b[01;31m\u001b[Kdefine\u001b[m\u001b[K IEEE1284_DATA\t\t\t 0\t/* So is this */\r\n\u001b[?2004hroot@3b01e4f2f411:~# "]
