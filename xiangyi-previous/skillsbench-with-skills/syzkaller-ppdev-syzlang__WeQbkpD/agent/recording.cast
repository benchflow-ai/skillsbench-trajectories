[131.524822, "o", "\u001b[?2004hroot@3b01e4f2f411:~# "]
[144.295597, "i", "python3 << 'PYEOF'\nimport struct\n\n# Calculate ioctl numbers\n# _IOW(type, nr, size) = (IOC_WRITE | ((size & IOCPARM_MASK) << IOC_SIZESHIFT) | ((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))\n# _IOR(type, nr, size) = (IOC_READ | ((size & IOCPARM_MASK) << IOC_SIZESHIFT) | ((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))\n# _IO(type, nr) = (((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))\n\nIOC_NRBITS = 8\nIOC_TYPEBITS = 8\nIOC_SIZEBITS = 14\nIOC_DIRBITS = 2\n\nIOC_NRSHIFT = 0\nIOC_TYPESHIFT = IOC_NRSHIFT + IOC_NRBITS\nIOC_SIZESHIFT = IOC_TYPESHIFT + IOC_TYPEBITS\nIOC_DIRSHIFT = IOC_SIZESHIFT + IOC_SIZEBITS\n\nIOC_WRITE = 1 << IOC_DIRSHIFT\nIOC_READ = 2 << IOC_DIRSHIFT\n\ndef _IOW(type_val, nr, size):\n    return IOC_WRITE | ((size & 0x3FFF) << IOC_SIZESHIFT) | ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT)\n\ndef _IOR(type_val, nr, size):\n    return IOC_READ | ((size & 0x3FFF) << IOC_SIZESHIFT) | ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT)\n\ndef _IO(type_val, nr):\n    return ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT)\n\nPP_IOCTL = 'p'\n\n# Calculate ioctl values\nPPSETMODE = _IOW(PP_IOCTL, 0x80, 4)\nPPRSTATUS = _IOR(PP_IOCTL, 0x81, 1)\nPPRCONTROL = _IOR(PP_IOCTL, 0x83, 1)\nPPWCONTROL = _IOW(PP_IOCTL, 0x84, 1)\nPPFCONTROL = _IOW(PP_IOCTL, 0x8e, 2)\nPPRDATA = _IOR(PP_IOCTL, 0x85, 1)\nPPWDATA = _IOW(PP_IOCTL, 0x86, 1)\nPPCLAIM = _IO(PP_IOCTL, 0x8b)\nPPRELEASE = _IO(PP_IOCTL, 0x8c)\nPPYIELD = _IO(PP_IOCTL, 0x8d)\nPPEXCL = _IO(PP_IOCTL, 0x8f)\nPPDATADIR = _IOW(PP_IOCTL, 0x90, 4)\nPPNEGOT = _IOW(PP_IOCTL, 0x91, 4)\nPPWCTLONIRQ = _IOW(PP_IOCTL, 0x92, 1)\nPPCLRIRQ = _IOR(PP_IOCTL, 0x93, 4)\nPPSETPHASE = _IOW(PP_IOCTL, 0x94, 4)\nPPGETTIME = _IOR(PP_IOCTL, 0x95, 16)\nPPSETTIME = _IOW(PP_IOCTL, 0x96, 16)\nPPGETMODES = _IOR(PP_IOCTL, 0x97, 4)\nPPGETMODE = _IOR(PP_IOCTL, 0x98, 4)\nPPGETPHASE = _IOR(PP_IOCTL, 0x99, 4)\nPPGETFLAGS = _IOR(PP_IOCTL, 0x9a, 4)\nPPSETFLAGS = _IOW(PP_IOCTL, 0x9b, 4)\n\nprint(f\"PPSETMODE = {PPSETMODE}\")\nprint(f\"PPRSTATUS = {PPRSTATUS}\")\nprint(f\"PPRCONTROL = {PPRCONTROL}\")\nprint(f\"PPWCONTROL = {PPWCONTROL}\")\nprint(f\"PPFCONTROL = {PPFCONTROL}\")\nprint(f\"PPRDATA = {PPRDATA}\")\nprint(f\"PPWDATA = {PPWDATA}\")\nprint(f\"PPCLAIM = {PPCLAIM}\")\nprint(f\"PPRELEASE = {PPRELEASE}\")\nprint(f\"PPYIELD = {PPYIELD}\")\nprint(f\"PPEXCL = {PPEXCL}\")\nprint(f\"PPDATADIR = {PPDATADIR}\")\nprint(f\"PPNEGOT = {PPNEGOT}\")\nprint(f\"PPWCTLONIRQ = {PPWCTLONIRQ}\")\nprint(f\"PPCLRIRQ = {PPCLRIRQ}\")\nprint(f\"PPSETPHASE = {PPSETPHASE}\")\nprint(f\"PPGETTIME = {PPGETTIME}\")\nprint(f\"PPSETTIME = {PPSETTIME}\")\nprint(f\"PPGETMODES = {PPGETMODES}\")\nprint(f\"PPGETMODE = {PPGETMODE}\")\nprint(f\"PPGETPHASE = {PPGETPHASE}\")\nprint(f\"PPGETFLAGS = {PPGETFLAGS}\")\nprint(f\"PPSETFLAGS = {PPSETFLAGS}\")\n\nprint(f\"\\nPP_FASTWRITE = {1<<2}\")\nprint(f\"PP_FASTREAD = {1<<3}\")\nprint(f\"PP_W91284PIC = {1<<4}\")\nPYEOF\n"]
