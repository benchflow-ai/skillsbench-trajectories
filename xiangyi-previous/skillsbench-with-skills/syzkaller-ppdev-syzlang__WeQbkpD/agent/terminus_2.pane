[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ioctl numbers
[?2004l[?2004h> # _IOW(type, nr, size) = (IOC_WRITE | ((size & IOCPARM_MASK) << IOC_SIZESHIFT) | ((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))
[?2004l[?2004h> # _IOR(type, nr, size) = (IOC_READ | ((size & IOCPARM_MASK) << IOC_SIZESHIFT) | ((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))
[?2004l[?2004h> # _IO(type, nr) = (((type) << IOC_TYPESHIFT) | ((nr) << IOC_NRSHIFT))
[?2004l[?2004h> 
[?2004l[?2004h> IOC_NRBITS = 8
[?2004l[?2004h> IOC_TYPEBITS = 8
[?2004l[?2004h> IOC_SIZEBITS = 14
[?2004l[?2004h> IOC_DIRBITS = 2
[?2004l[?2004h> 
[?2004l[?2004h> IOC_NRSHIFT = 0
[?2004l[?2004h> IOC_TYPESHIFT = IOC_NRSHIFT + IOC_NRBITS
[?2004l[?2004h> IOC_SIZESHIFT = IOC_TYPESHIFT + IOC_TYPEBITS
[?2004l[?2004h> IOC_DIRSHIFT = IOC_SIZESHIFT + IOC_SIZEBITS
[?2004l[?2004h> 
[?2004l[?2004h> IOC_WRITE = 1 << IOC_DIRSHIFT
[?2004l[?2004h> IOC_READ = 2 << IOC_DIRSHIFT
[?2004l[?2004h> 
[?2004l[?2004h> def _IOW(type_val, nr, size):
[?2004l[?2004h>     return IOC_WRITE | ((size & 0x3FFF) << IOC_SIZESHIFT) | ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT)
[?2004l[?2004h> 
[?2004l[?2004h> def _IOR(type_val, nr, size):
[?2004l[?2004h>     return IOC_READ | ((size & 0x3FFF) << IOC_SIZESHIFT) | ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT) M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[K)
[?2004l[?2004h> 
[?2004l[?2004h> def _IO(type_val, nr):
[?2004l[?2004h>     return ((ord(type_val) if isinstance(type_val, str) else type_val) << IOC_TYPESHIFT) | (nr << IOC_NRSHIFT)
[?2004l[?2004h> 
[?2004l[?2004h> PP_IOCTL = 'p'
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate ioctl values
[?2004l[?2004h> PPSETMODE = _IOW(PP_IOCTL, 0x80, 4)
[?2004l[?2004h> PPRSTATUS = _IOR(PP_IOCTL, 0x81, 1)
[?2004l[?2004h> PPRCONTROL = _IOR(PP_IOCTL, 0x83, 1)
[?2004l[?2004h> PPWCONTROL = _IOW(PP_IOCTL, 0x84, 1)
[?2004l[?2004h> PPFCONTROL = _IOW(PP_IOCTL, 0x8e, 2)
[?2004l[?2004h> PPRDATA = _IOR(PP_IOCTL, 0x85, 1)
[?2004l[?2004h> PPWDATA = _IOW(PP_IOCTL, 0x86, 1)
[?2004l[?2004h> PPCLAIM = _IO(PP_IOCTL, 0x8b)
[?2004l[?2004h> PPRELEASE = _IO(PP_IOCTL, 0x8c)
[?2004l[?2004h> PPYIELD = _IO(PP_IOCTL, 0x8d)
[?2004l[?2004h> PPEXCL = _IO(PP_IOCTL, 0x8f)
[?2004l[?2004h> PPDATADIR = _IOW(PP_IOCTL, 0x90, 4)
[?2004l[?2004h> PPNEGOT = _IOW(PP_IOCTL, 0x91, 4)
[?2004l[?2004h> PPWCTLONIRQ = _IOW(PP_IOCTL, 0x92, 1)
[?2004l[?2004h> PPCLRIRQ = _IOR(PP_IOCTL, 0x93, 4)
[?2004l[?2004h> PPSETPHASE = _IOW(PP_IOCTL, 0x94, 4)
[?2004l[?2004h> PPGETTIME = _IOR(PP_IOCTL, 0x95, 16)
[?2004l[?2004h> PPSETTIME = _IOW(PP_IOCTL, 0x96, 16)
[?2004l[?2004h> PPGETMODES = _IOR(PP_IOCTL, 0x97, 4)
[?2004l[?2004h> PPGETMODE = _IOR(PP_IOCTL, 0x98, 4)
[?2004l[?2004h> PPGETPHASE = _IOR(PP_IOCTL, 0x99, 4)
[?2004l[?2004h> PPGETFLAGS = _IOR(PP_IOCTL, 0x9a, 4)
[?2004l[?2004h> PPSETFLAGS = _IOW(PP_IOCTL, 0x9b, 4)
