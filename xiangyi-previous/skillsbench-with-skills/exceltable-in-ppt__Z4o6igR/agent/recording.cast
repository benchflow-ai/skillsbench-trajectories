[28.934921, "i", "python3 - <<'PY'\nimport zipfile, io\nimport openpyxl\npptx='/root/input.pptx'\nwith zipfile.ZipFile(pptx) as z:\n    data=z.read('ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\nwb=openpyxl.load_workbook(io.BytesIO(data), data_only=False)\nws=wb.active\nprint('sheet', ws.title, 'size', ws.max_row, ws.max_column)\n# print table\nfor row in ws.iter_rows(values_only=False):\n    vals=[]\n    for cell in row:\n        v=cell.value\n        if cell.data_type=='f':\n            vals.append(f'={v}')\n        else:\n            vals.append(v)\n    print(vals)\nPY\n"]
[28.944813, "o", "python3 - <<'PY'"]
[28.946704, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import zipfile, io\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> pptx='/root/input.pptx'\r\n\u001b[?2004l\r\u001b[?2004h> with zipfile.ZipFile(pptx) as z:\r\n\u001b[?2004l\r\u001b[?2004h>     data=z.read('ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(io.BytesIO(data), data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb.active\r\n\u001b[?2004l\r\u001b[?2004h> print('sheet', ws.title, 'size', ws.max_row, ws.max_column)\r\n\u001b[?2004l\r\u001b[?2004h> # print table\r\n\u001b[?2004l\r\u001b[?2004h> for row in ws.iter_rows(values_only=False):\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for cell in row:\r\n\u001b[?2004l\r\u001b[?2004h>         v=cell.value\r\n\u001b[?2004l\r\u001b[?2004h>         if cell.data_type=='f':\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(f'={v}')\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(v)\r\n\u001b[?2004l\r\u001b[?2004h>     print(vals)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[29.666884, "o", "sheet Sheet1 size 6 5\r\n['Exchange Rate', 'CNY', 'USD', 'EUR', 'GBP']\r\n['CNY', 1, '==ROUND(1/B3, 3)', '==ROUND(1/B4,3)', '==ROUND(1/B5, 3)']\r\n['USD', 7.25, 1, '==ROUND(1/C4, 3)', '==ROUND(1/C5, 3)']\r\n['EUR', 7.85, 1.08, 1, '==ROUND(1/D5, 3)']\r\n['GBP', 9.17, 1.26, 1.17, 1]\r\n[None, None, None, None, None]\r\n"]
