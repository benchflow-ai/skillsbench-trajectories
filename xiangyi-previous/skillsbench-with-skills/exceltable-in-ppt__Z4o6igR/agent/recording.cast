[77.379789, "i", "python3 - <<'PY'\nimport zipfile, io, os\nimport openpyxl\npptx='/root/input.pptx'\nout='/root/results.pptx'\nwith zipfile.ZipFile(pptx) as zin:\n    data=zin.read('ppt/embeddings/Microsoft_Excel_Worksheet.xlsx')\n    wb=openpyxl.load_workbook(io.BytesIO(data), data_only=False)\n    ws=wb.active\n    ws['B3'].value=7.02\n    bio=io.BytesIO()\n    wb.save(bio)\n    newdata=bio.getvalue()\n    with zipfile.ZipFile(out, 'w') as zout:\n        for item in zin.infolist():\n            if item.filename == 'ppt/embeddings/Microsoft_Excel_Worksheet.xlsx':\n                zout.writestr(item, newdata)\n            else:\n                zout.writestr(item, zin.read(item.filename))\nprint('written', out, 'size', os.path.getsize(out))\nPY\n"]
