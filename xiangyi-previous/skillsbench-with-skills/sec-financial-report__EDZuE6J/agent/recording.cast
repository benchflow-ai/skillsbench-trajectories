[46.497779, "i", "cat << 'EOF' > /root/compare_berkshire.py\nimport collections\n\ndef get_holdings(filename):\n    holdings = collections.defaultdict(float)\n    with open(filename, 'r') as f:\n        for line in f:\n            cusip, value = line.strip().split('\\t')\n            holdings[cusip] += float(value)\n    return holdings\n\nq2 = get_holdings('/root/berkshire_q2.tsv')\nq3 = get_holdings('/root/berkshire_q3.tsv')\n\ndiff = {}\nall_cusips = set(q2.keys()) | set(q3.keys())\nfor cusip in all_cusips:\n    diff[cusip] = q3.get(cusip, 0) - q2.get(cusip, 0)\n\nsorted_diff = sorted(diff.items(), key=lambda x: x[1], reverse=True)\nfor i in range(5):\n    print(sorted_diff[i][0])\nEOF\npython3 /root/compare_berkshire.py\n"]
[46.49809, "o", "cat << 'EOF' > /root/compare_berkshire.py\r\n\u001b[?2004l\r"]
