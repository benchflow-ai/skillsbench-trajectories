[?2004hroot@10a0156a846a:~# cat <<EOF > solve_gdp.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> file_path = 'gdp.xlsx'
[?2004l[?2004h> wb = openpyxl.load_workbook(file_path)
[?2004l[?2004h> task = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # Helper to set formula for a range
[?2004l[?2004h> def set_formula(sheet, row_start, row_end, col_start_idx, col_end_idx, formula_template):
[?2004l[?2004h>     for r in range(row_start, row_end + 1):
[?2004l[?2004h>         for c in range(col_start_idx, col_end_idx + 1):
[?2004l[?2004h>             col_letter = get_column_letter(c)
[?2004l[?2004h>             # Replace placeholders in template
[?2004l[?2004h>             # {col} -> column letter (e.g., H)
[?2004l[?2004h>             # {row} -> row number (e.g., 12)
[?2004l[?2004h>             # {col_idx} -> column index
[?2004l[?2004h>             f = formula_template.format(col=col_letter, row=r)
[?2004l[?2004h>             sheet.cell(row=r, column=c).value = f
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Fill Data
[?2004l[?2004h> # Ranges: H12:L17, H19:L24, H26:L31
[?2004l[?2004h> # Formula: =INDEX(Data!$A$21:$Z$40, MATCH($D{row}, Data!$B$21:$B$40, 0), MATCH({col}$9, Data!$A$4:$Z$4, 0))
[?2004l[?2004h> lookup_formula = "=INDEX(Data!\$A\$21:\$Z\$40, MATCH(\$D{row}, Data!\$B\$21:\$B\$40, 0), MATCH({col}\$9, Data!\$A\$4:\$Z\$4, 0))"
[?2004l[?2004h> 
[?2004l[?2004h> cols = range(8, 13) # H to L (8, 9, 10, 11, 12)
[?2004l[?2004h> for r_start, r_end in [(12, 17), (19, 24), (26, 31)]:
[?2004l[?2004h>     set_formula(task, r_start, r_end, 8, 12, lookup_formula)
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Net Exports % GDP
[?2004l[?2004h> # Range: H35:L40
[?2004l[?2004h> # Formula: =(H{row_exp}-H{row_imp})/H{row_gdp}*100
[?2004l[?2004h> # Rows mapping:
[?2004l[?2004h> # 35 -> Exp 12, Imp 19, GDP 26
[?2004l[?2004h> # 36 -> Exp 13, Imp 20, GDP 27
[?2004l[?2004h> # ...
[?2004l[?2004h> for i, r in enumerate(range(35, 41)):
[?2004l[?2004h>     row_exp = 12 + i
[?2004l[?2004h>     row_imp = 19 + i
[?2004l[?2004h>     row_gdp = 26 + i
[?2004l[?2004h>     for c in cols:
[?2004l[?2004h>         col_letter = get_column_letter(c)
[?2004l[?2004h>         f = f"=({col_letter}{row_exp}-{col_letter}{row_imp})/{col_letter}{row_gdp}*100"
[?2004l[?2004h>         task.cell(row=r, column=c).value = f
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2 Stats: Rows 42-47
[?2004l[?2004h> stats_map = {
[?2004l[?2004h>     42: "MIN",
[?2004l[?2004h>     43: "MAX",
[?2004l[?2004h>     44: "MEDIAN",
[?2004l[?2004h>     45: "AVERAGE",
[?2004l[?2004h>     46: "PERCENTILE.INC",
[?2004l[?2004h>     47: "PERCENTILE.INC"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> for r, func in stats_map.items():
[?2004l[?2004h>     for c in cols:
[?2004l[?2004h>         col_letter = get_column_letter(c)
[?2004l[?2004h>         rng = f"{col_letter}35:{col_letter}40"
[?2004l[?2004h>         if r == 46:
[?2004l[?2004h>             f = f"={func}({rng}, 0.25)"
[?2004l[?2004h>         elif r == 47:
[?2004l[?2004h>             f = f"={func}({rng}, 0.75)"
[?2004l[?2004h>         else:
[?2004l[?2004h>             f = f"={func}({rng})"
[?2004l[?2004h>         task.cell(row=r, column=c).value = f
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Weighted Mean
[?2004l[?2004h> # Row 50
[?2004l[?2004h> # Formula: =SUMPRODUCT(H35:H40, H26:H31)/SUM(H26:H31)
[?2004l[?2004h> for c in cols:
[?2004l[?2004h>     col_letter = get_column_letter(c)
[?2004l[?2004h>     f = f"=SUMPRODUCT({col_letter}35:{col_letter}40, {col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"
[?2004l[?2004h>     task.cell(row=50, column=c).value = f
[?2004l[?2004h> 
[?2004l[?2004h> wb.save(file_path)
[?2004l[?2004h> print("Done")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@10a0156a846a:~# python3 solve_gdp.py
[?2004lDone
