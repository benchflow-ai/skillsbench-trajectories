[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('gdp.xlsx', data_only=True)
[?2004l[?2004h> task = wb['Task']
[?2004l[?2004h> data = wb['Data']
[?2004l[?2004h> 
[?2004l[?2004h> print("--- Task Sheet ---")
[?2004l[?2004h> # Check Row 10 for years
[?2004l[?2004h> row10 = [cell.value for cell in task[10]]
