[?2004l[?2004h> 
[?2004l[?2004h> print("\n--- Data Sheet ---")
[?2004l[?2004h> # Check headers in Data sheet (assuming around row 20 or 21)
[?2004l[?2004h> for row in data.iter_rows(min_row=20, max_row=22, max_col=10):
[?2004l[?2004h>     print([c.value for c in row])
[?2004l[?2004h> EOF
