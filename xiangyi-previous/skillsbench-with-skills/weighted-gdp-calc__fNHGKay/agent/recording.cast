[48.653887, "i", "cat <<EOF > inspect_headers.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('gdp.xlsx', data_only=True)\ntask = wb['Task']\ndata = wb['Data']\n\n# Check Task years in H10:L10\ntask_years = [task[f'{c}10'].value for c in ['H', 'I', 'J', 'K', 'L']]\nprint(f\"Task Years (H10:L10): {task_years}\")\n\n# Check Data sheet headers for years. Let's check Row 1 and Row 20.\nprint(\"Data Sheet Row 1:\")\nprint([c.value for c in data[1][:20]]) # First 20 cols\n\nprint(\"Data Sheet Row 20:\")\nprint([c.value for c in data[20][:20]])\nEOF\npython3 inspect_headers.py\n"]
