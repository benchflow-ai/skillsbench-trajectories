[92.914685, "i", "cat <<EOF > inspect_stats.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('gdp.xlsx', data_only=False)\ntask = wb['Task']\n\nprint(\"--- Task Sheet Grid (Rows 33-50, Cols C-H) ---\")\nfor r in range(33, 51):\n    row_vals = []\n    for c in range(3, 9): # C to H\n        val = task.cell(row=r, column=c).value\n        row_vals.append(str(val))\n    print(f\"Row {r}: {row_vals}\")\nEOF\npython3 inspect_stats.py\n"]
