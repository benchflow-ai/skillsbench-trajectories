[32.283584, "i", "cat <<EOF > inspect_gdp.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('gdp.xlsx', data_only=True)\ntask = wb['Task']\ndata = wb['Data']\n\nprint(\"--- Task Sheet ---\")\n# Check Row 10 for years\nrow10 = [cell.value for cell in task[10]]\nprint(f\"Row 10: {row10}\")\n\n# Check Column D for series codes (rows 12-32)\ncolD = [task[f'D{i}'].value for i in range(12, 33)]\nprint(f\"Col D (12-32): {colD}\")\n\nprint(\"\\n--- Data Sheet ---\")\n# Check headers in Data sheet (assuming around row 20 or 21)\nfor row in data.iter_rows(min_row=20, max_row=22, max_col=10):\n    print([c.value for c in row])\nEOF\npython3 inspect_gdp.py\n"]
