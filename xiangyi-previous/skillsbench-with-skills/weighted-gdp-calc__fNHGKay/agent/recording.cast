[60.197664, "i", "cat <<EOF > inspect_grid.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('gdp.xlsx', data_only=False)\ntask = wb['Task']\ndata = wb['Data']\n\nprint(\"--- Task Sheet Grid (Rows 8-12, Cols C-M) ---\")\nfor r in range(8, 13):\n    row_vals = []\n    for c in range(3, 14): # C is 3\n        val = task.cell(row=r, column=c).value\n        row_vals.append(str(val))\n    print(f\"Row {r}: {row_vals}\")\n\nprint(\"\\n--- Data Sheet Grid (Rows 18-22, Cols A-J) ---\")\nfor r in range(18, 23):\n    row_vals = []\n    for c in range(1, 11):\n        val = data.cell(row=r, column=c).value\n        row_vals.append(str(val))\n    print(f\"Row {r}: {row_vals}\")\n\nprint(\"\\n--- Data Sheet Grid (Rows 1-5, Cols A-J) ---\")\nfor r in range(1, 6):\n    row_vals = []\n    for c in range(1, 11):\n        val = data.cell(row=r, column=c).value\n        row_vals.append(str(val))\n    print(f\"Row {r}: {row_vals}\")\nEOF\npython3 inspect_grid.py\n"]
