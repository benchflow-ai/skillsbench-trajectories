[118.559973, "o", "# Formula: =SUMPRODUCT(H35:H40, H26:H31)/SUM(H26:H31)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.56001, "o", "for c in cols:\r\n\u001b[?2004l\r"]
[118.560045, "o", "\u001b[?2004h> "]
[118.560136, "o", "    col_letter = get_column_letter(c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.560168, "o", "> "]
[118.560378, "o", "    f = f\"=SUMPRODUCT({col_letter}35:{col_letter}40, {col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)\"\r\n\u001b[?2004l\r"]
[118.560413, "o", "\u001b[?2004h> "]
[118.560516, "o", "    task.cell(row=50, column=c).value = f\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.560549, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.560613, "o", "wb.save(file_path)\r\n\u001b[?2004l\r"]
[118.560643, "o", "\u001b[?2004h> "]
[118.56067, "o", "print(\"Done\")\r\n\u001b[?2004l\r"]
[118.560699, "o", "\u001b[?2004h> "]
[118.560727, "o", "EOF\r\n\u001b[?2004l\r"]
[118.62001, "o", "\u001b[?2004hroot@10a0156a846a:~# python3 solve_gdp.py\r\n\u001b[?2004l\r"]
[119.912519, "o", "Done\r\n"]
