[303.449295, "i", "python3 << 'EOF'\nimport json\n\n# Load and clean the report\nwith open('report.json', 'r') as f:\n    report = json.load(f)\n\n# Clean up -0.0 values\nfor gen in report['generator_dispatch']:\n    if gen['reserve_MW'] == 0 or gen['reserve_MW'] == -0.0:\n        gen['reserve_MW'] = 0.0\n    if gen['output_MW'] == 0 or gen['output_MW'] == -0.0:\n        gen['output_MW'] = 0.0\n\n# Save cleaned report\nwith open('report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"Report cleaned and saved.\")\nprint(f\"\\nSummary:\")\nprint(f\"  Generators: {len(report['generator_dispatch'])}\")\nprint(f\"  Total cost: ${report['totals']['cost_dollars_per_hour']:,.2f}/hour\")\nprint(f\"  Total load: {report['totals']['load_MW']:,.2f} MW\")\nprint(f\"  Total generation: {report['totals']['generation_MW']:,.2f} MW\")\nprint(f\"  Total reserves: {report['totals']['reserve_MW']:,.2f} MW\")\nprint(f\"  Operating margin: {report['operating_margin_MW']:,.2f} MW\")\nprint(f\"\\nMost loaded lines:\")\nfor line in report['most_loaded_lines']:\n    print(f\"  {line['from']} -> {line['to']}: {line['loading_pct']}%\")\nEOF\n"]
[303.450329, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load and clean the report\r\n\u001b[?2004l\r\u001b[?2004h> with open('report.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     report = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Clean up -0.0 values\r\n\u001b[?2004l\r\u001b[?2004h> for gen in report['generator_dispatch']:\r\n\u001b[?2004l\r\u001b[?2004h>     if gen['reserve_MW'] == 0 or gen['reserve_MW'] == -0.0:\r\n\u001b[?2004l\r\u001b[?2004h>         gen['reserve_MW'] = 0.0\r\n\u001b[?2004l\r"]
[303.450951, "o", "\u001b[?2004h> "]
[303.451075, "o", "    if gen['output_MW'] == 0 or gen['output_MW'] == -0.0:\r\n\u001b[?2004l\r\u001b[?2004h>         gen['output_MW'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save cleaned report\r\n\u001b[?2004l\r\u001b[?2004h> with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Report cleaned and saved.\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nSummary:\")"]
[303.451115, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.45144, "o", "print(f\"  Generators: {len(report['generator_dispatch'])}\")\r\n\u001b[?2004l\r"]
[303.45156, "o", "\u001b[?2004h> print(f\"  Total cost: ${report['totals']['cost_dollars_per_hour']:,.2f}/hour\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  Total load: {report['totals']['load_MW']:,.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[303.451599, "o", "print(f\"  Total generation: {report['totals']['generation_MW']:,.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
