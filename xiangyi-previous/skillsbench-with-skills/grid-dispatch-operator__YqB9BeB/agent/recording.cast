[332.967635, "i", "python3 << 'EOF'\nimport json\n\nwith open('report.json', 'r') as f:\n    report = json.load(f)\n\n# Validate structure\nrequired_keys = ['generator_dispatch', 'totals', 'most_loaded_lines', 'operating_margin_MW']\nfor key in required_keys:\n    assert key in report, f\"Missing key: {key}\"\n\n# Validate generator_dispatch structure\ngen = report['generator_dispatch'][0]\nassert all(k in gen for k in ['id', 'bus', 'output_MW', 'reserve_MW', 'pmax_MW']), \"Generator missing fields\"\n\n# Validate totals structure\ntotals = report['totals']\nassert all(k in totals for k in ['cost_dollars_per_hour', 'load_MW', 'generation_MW', 'reserve_MW']), \"Totals missing fields\"\n\n# Validate most_loaded_lines structure\nline = report['most_loaded_lines'][0]\nassert all(k in line for k in ['from', 'to', 'loading_pct']), \"Line missing fields\"\n\nprint(\"✓ All required fields present\")\nprint(f\"✓ {len(report['generator_dispatch'])} generators\")\nprint(f\"✓ Generation ({report['totals']['generation_MW']}) matches load ({report['totals']['load_MW']})\")\nprint(f\"✓ Reserves: {report['totals']['reserve_MW']} MW\")\nprint(f\"✓ Top 3 loaded lines included\")\nprint(f\"✓ Operating margin: {report['operating_margin_MW']} MW\")\nprint(\"\\nReport validation PASSED!\")\nEOF\n"]
