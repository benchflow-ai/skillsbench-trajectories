[218.957031, "i", "cat > solve_opf.py << 'SCRIPT'\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\nfrom scipy.sparse import csr_matrix, lil_matrix\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nbaseMVA = data['baseMVA']\nbus_data = data['bus']\ngen_data = data['gen']\nbranch_data = data['branch']\ngencost_data = data['gencost']\nreserve_capacity = data['reserve_capacity']\nreserve_requirement = data['reserve_requirement']\n\n# Extract dimensions\nn_bus = len(bus_data)\nn_gen = len(gen_data)\nn_branch = len(branch_data)\n\nprint(f\"Network: {n_bus} buses, {n_gen} generators, {n_branch} branches\")\nprint(f\"Reserve requirement: {reserve_requirement} MW\")\n\n# Create bus index mapping (bus numbers may not be contiguous)\nbus_nums = [int(b[0]) for b in bus_data]\nbus_to_idx = {bus_num: idx for idx, bus_num in enumerate(bus_nums)}\n\n# Extract bus loads\nPd = np.array([b[2] for b in bus_data])  # Load at each bus\ntotal_load = np.sum(Pd)\nprint(f\"Total load: {total_load:.2f} MW\")\n\n# Extract generator data\ngen_bus = [int(g[0]) for g in gen_data]\ngen_bus_idx = [bus_to_idx[b] for b in gen_bus]\nPmax = np.array([g[8] for g in gen_data])\nPmin = np.array([g[9] for g in gen_data])\ngen_status = np.array([g[7] for g in gen_data])\n\n# Extract costs (linear cost coefficient)\ncosts = np.array([c[5] for c in gencost_data])  # c1 coefficient ($/MWh)\n\n# Reserve capacity\nres_cap = np.array(reserve_capacity)\n\nprint(f\"Total Pmax: {np.sum(Pmax):.2f} MW\")\nprint(f\"Total reserve capacity: {np.sum(res_cap):.2f} MW\")\n\n# Extract branch data\nbranch_from = [int(b[0]) for b in branch_data]\nbranch_to = [int(b[1]) for b in branch_data]\nbranch_x = np.array([b[3] for b in branch_data])  # reactance\nbranch_rate = np.array([b[5] for b in branch_data])  # MVA rating\nbranch_status = np.array([b[10] for b in branch_data])\n\n# Convert branch endpoints to indices\nbranch_from_idx = [bus_to_idx[b] for b in branch_from]\nbranch_to_idx = [bus_to_idx[b] for b in branch_to]\n\n# Build B matrix for DC power flow (susceptance matrix)\n# For DC-OPF: P_flow = (theta_from - theta_to) / x = B_line * (theta_from - theta_to)\n# where B_line = 1/x (in per unit)\n\n# Variables: [Pg (n_gen), Rg (n_gen), theta (n_bus)]\n# Total variables: 2*n_gen + n_bus\nn_vars = 2 * n_gen + n_bus\n\nprint(f\"\\nOptimization problem: {n_vars} variables\")\n\n# Objective: minimize sum(cost_i * Pg_i)\n# c vector for linprog\nc = np.zeros(n_vars)\nc[:n_gen] = costs  # Cost coefficients for Pg\n# No cost for reserves or theta\n\n# Constraints:\n# 1. Power balance at each bus: sum(Pg at bus) - Pd = sum(B_ij * (theta_i - theta_j))\n# 2. Pg + Rg <= Pmax (capacity coupling)\n# 3. sum(Rg) >= reserve_requirement\n# 4. Line flow limits: -rate <= (theta_from - theta_to)/x <= rate\n\n# Build equality constraints for power balance\n# A_eq * x = b_eq\n# For each bus i: sum(Pg for gens at i) - sum(B_ij*(theta_i - theta_j)) = Pd_i\n\n# Build incidence and susceptance matrices\nA_eq = lil_matrix((n_bus, n_vars))\nb_eq = Pd.copy()\n\n# Generator injection at each bus\nfor g in range(n_gen):\n    bus_idx = gen_bus_idx[g]\n    A_eq[bus_idx, g] = 1.0  # Pg contributes to bus power balance\n\n# Power flow terms: for each branch, add B*(theta_from - theta_to) to from bus, subtract from to bus\nfor br in range(n_branch):\n    if branch_status[br] == 0:\n        continue\n    f_idx = branch_from_idx[br]\n    t_idx = branch_to_idx[br]\n    b_val = 1.0 / branch_x[br]  # susceptance\n    \n    # Flow from f to t: B*(theta_f - theta_t)\n    # At bus f: net injection = Pg - Pd = flow out = B*(theta_f - theta_t)\n    # At bus t: net injection = Pg - Pd = flow in = -B*(theta_f - theta_t)\n    \n    # So in power balance: Pg - B*theta_f + B*theta_t = Pd (for bus f)\n    # And: Pg + B*theta_f - B*theta_t = Pd (for bus t)\n    \n    theta_offset = 2 * n_gen  # theta variables start after Pg and Rg\n    A_eq[f_idx, theta_offset + f_idx] -= b_val\n    A_eq[f_idx, theta_offset + t_idx] += b_val\n    A_eq[t_idx, theta_offset + f_idx] += b_val\n    A_eq[t_idx, theta_offset + t_idx] -= b_val\n\n# Set reference bus (bus 0) theta = 0\n# We'll handle this by fixing theta[0] = 0 through bounds\n\n# "]
[218.95722, "i", "Inequality constraints: A_ub * x <= b_ub\n# 1. Pg + Rg <= Pmax for each generator\n# 2. -sum(Rg) <= -reserve_requirement (i.e., sum(Rg) >= reserve_requirement)\n# 3. Line flow limits: (theta_from - theta_to)/x <= rate AND -(theta_from - theta_to)/x <= rate\n\nn_ineq = n_gen + 1 + 2 * n_branch  # capacity coupling + reserve req + line limits (both directions)\nA_ub = lil_matrix((n_ineq, n_vars))\nb_ub = np.zeros(n_ineq)\n\nrow = 0\n\n# Capacity coupling: Pg + Rg <= Pmax\nfor g in range(n_gen):\n    A_ub[row, g] = 1.0  # Pg\n    A_ub[row, n_gen + g] = 1.0  # Rg\n    b_ub[row] = Pmax[g]\n    row += 1\n\n# Reserve requirement: -sum(Rg) <= -reserve_requirement\nfor g in range(n_gen):\n    A_ub[row, n_gen + g] = -1.0\nb_ub[row] = -reserve_requirement\nrow += 1\n\n# Line flow limits\ntheta_offset = 2 * n_gen\nfor br in range(n_branch):\n    if branch_status[br] == 0:\n        continue\n    f_idx = branch_from_idx[br]\n    t_idx = branch_to_idx[br]\n    b_val = 1.0 / branch_x[br]\n    rate = branch_rate[br]\n    \n    # Flow = (theta_f - theta_t) / x = b_val * (theta_f - theta_t)\n    # Constraint: b_val * (theta_f - theta_t) <= rate\n    A_ub[row, theta_offset + f_idx] = b_val\n    A_ub[row, theta_offset + t_idx] = -b_val\n    b_ub[row] = rate\n    row += 1\n    \n    # Constraint: -b_val * (theta_f - theta_t) <= rate (i.e., flow >= -rate)\n    A_ub[row, theta_offset + f_idx] = -b_val\n    A_ub[row, theta_offset + t_idx] = b_val\n    b_ub[row] = rate\n    row += 1\n\nprint(f\"Inequality constraints: {row}\")\n\n# Variable bounds\nbounds = []\n# Pg bounds: Pmin <= Pg <= Pmax\nfor g in range(n_gen):\n    bounds.append((Pmin[g], Pmax[g]))\n# Rg bounds: 0 <= Rg <= reserve_capacity\nfor g in range(n_gen):\n    bounds.append((0, res_cap[g]))\n# Theta bounds: reference bus = 0, others unbounded\nfor i in range(n_bus):\n    if i == 0:\n        bounds.append((0, 0))  # Reference bus\n    else:\n        bounds.append((None, None))\n\nprint(\"\\nSolving LP...\")\n\n# Convert to CSR format for efficiency\nA_eq_csr = csr_matrix(A_eq)\nA_ub_csr = csr_matrix(A_ub[:row, :])\nb_ub_trimmed = b_ub[:row]\n\n# Solve\nresult = linprog(c, A_ub=A_ub_csr, b_ub=b_ub_trimmed, A_eq=A_eq_csr, b_eq=b_eq, \n                 bounds=bounds, method='highs')\n\nif result.success:\n    print(f\"Optimization successful!\")\n    print(f\"Total cost: ${result.fun:.2f}/hour\")\n    \n    # Extract solution\n    Pg_opt = result.x[:n_gen]\n    Rg_opt = result.x[n_gen:2*n_gen]\n    theta_opt = result.x[2*n_gen:]\n    \n    total_gen = np.sum(Pg_opt)\n    total_res = np.sum(Rg_opt)\n    \n    print(f\"Total generation: {total_gen:.2f} MW\")\n    print(f\"Total reserves: {total_res:.2f} MW\")\n    \n    # Calculate line flows and loading\n    line_flows = []\n    for br in range(n_branch):\n        if branch_status[br] == 0:\n            continue\n        f_idx = branch_from_idx[br]\n        t_idx = branch_to_idx[br]\n        b_val = 1.0 / branch_x[br]\n        flow = b_val * (theta_opt[f_idx] - theta_opt[t_idx])\n        rate = branch_rate[br]\n        loading = abs(flow) / rate * 100 if rate > 0 else 0\n        line_flows.append({\n            'branch_idx': br,\n            'from': branch_from[br],\n            'to': branch_to[br],\n            'flow': flow,\n            'rate': rate,\n            'loading_pct': loading\n        })\n    \n    # Sort by loading\n    line_flows.sort(key=lambda x: x['loading_pct'], reverse=True)\n    \n    print(f\"\\nTop 3 most loaded lines:\")\n    for i, lf in enumerate(line_flows[:3]):\n        print(f\"  {i+1}. Line {lf['from']}->{lf['to']}: {lf['loading_pct']:.1f}% ({abs(lf['flow']):.1f}/{lf['rate']:.1f} MW)\")\n    \n    # Calculate operating margin\n    operating_margin = np.sum(Pmax - Pg_opt - Rg_opt)\n    print(f\"\\nOperating margin: {operating_margin:.2f} MW\")\n    \n    # Build report\n    generator_dispatch = []\n    for g in range(n_gen):\n        generator_dispatch.append({\n            \"id\": g + 1,\n            \"bus\": gen_bus[g],\n            \"output_MW\": round(Pg_opt[g], 2),\n            \"reserve_MW\": round(Rg_opt[g], 2),\n            \"pmax_MW\": Pmax[g]\n        })\n    \n    most_loaded_lines = [\n        {\"from\": lf['from'], \"to\": lf['to'], \"loading_pct\": round(lf['loa"]
[218.957289, "i", "ding_pct'], 1)}\n        for lf in line_flows[:3]\n    ]\n    \n    report = {\n        \"generator_dispatch\": generator_dispatch,\n        \"totals\": {\n            \"cost_dollars_per_hour\": round(result.fun, 2),\n            \"load_MW\": round(total_load, 2),\n            \"generation_MW\": round(total_gen, 2),\n            \"reserve_MW\": round(total_res, 2)\n        },\n        \"most_loaded_lines\": most_loaded_lines,\n        \"operating_margin_MW\": round(operating_margin, 2)\n    }\n    \n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n    \n    print(\"\\nReport saved to report.json\")\nelse:\n    print(f\"Optimization failed: {result.message}\")\nSCRIPT\n"]
