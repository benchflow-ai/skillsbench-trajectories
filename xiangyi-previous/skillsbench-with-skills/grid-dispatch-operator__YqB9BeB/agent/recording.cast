[218.960468, "o", "# Create bus index mapping (bus numbers may not be contiguous)\r\n\u001b[?2004l\r"]
[218.960488, "o", "\u001b[?2004h> "]
[218.960587, "o", "bus_nums = [int(b[0]) for b in bus_data]\r\n\u001b[?2004l\r"]
[218.960605, "o", "\u001b[?2004h> "]
[218.960785, "o", "bus_to_idx = {bus_num: idx for idx, bus_num in enumerate(bus_nums)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.960809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[218.960827, "o", "> "]
[218.96088, "o", "# Extract bus loads\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.960942, "o", "> "]
[218.961076, "o", "Pd = np.array([b[2] for b in bus_data])  # Load at each bus\r\n\u001b[?2004l\r"]
[218.961098, "o", "\u001b[?2004h> "]
[218.961156, "o", "total_load = np.sum(Pd)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.961175, "o", "> "]
[218.961284, "o", "print(f\"Total load: {total_load:.2f} MW\")\r\n\u001b[?2004l\r"]
[218.961305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r="]
[218.961321, "o", "\u001b[?2004h> "]
[218.961397, "o", "# Extract generator data\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.961421, "o", "> "]
[218.961522, "o", "gen_bus = [int(g[0]) for g in gen_data]\r\n\u001b[?2004l\r"]
[218.961541, "o", "\u001b[?2004h> "]
[218.961655, "o", "gen_bus_idx = [bus_to_idx[b] for b in gen_bus]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.961675, "o", "> "]
[218.961786, "o", "Pmax = np.array([g[8] for g in gen_data])\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.961804, "o", "> "]
[218.961913, "o", "Pmin = np.array([g[9] for g in gen_data])\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.961932, "o", "> "]
[218.962061, "o", "gen_status = np.array([g[7] for g in gen_data])\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.96208, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.962215, "o", "# Extract costs (linear cost coefficient)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.962238, "o", "> "]
[218.962445, "o", "costs = np.array([c[5] for c in gencost_data])  # c1 coefficient ($/MWh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.962466, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[218.962531, "o", "# Reserve capacity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.962665, "o", "res_cap = np.array(reserve_capacity)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.96273, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.962842, "o", "print(f\"Total Pmax: {np.sum(Pmax):.2f} MW\")\r\n\u001b[?2004l\r"]
[218.962895, "o", "\u001b[?2004h> "]
[218.963036, "o", "print(f\"Total reserve capacity: {np.sum(res_cap):.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.963076, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[218.9632, "o", "# Extract branch data\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[218.9633, "o", "branch_from = [int(b[0]) for b in branch_data]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.963359, "o", "> "]
[218.963459, "o", "branch_to = [int(b[1]) for b in branch_data]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.963488, "o", "> "]
[218.963624, "o", "branch_x = np.array([b[3] for b in branch_data])  # reactance\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.963675, "o", "> "]
[218.963831, "o", "branch_rate = np.array([b[5] for b in branch_data])  # MVA rating\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.963857, "o", "> "]
[218.964, "o", "branch_status = np.array([b[10] for b in branch_data])\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.964024, "o", "> \r\n\u001b[?2004l\r)\u001b[?2004h> "]
[218.964169, "o", "# Convert branch endpoints to indices\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.964193, "o", "> "]
[218.964311, "o", "branch_from_idx = [bus_to_idx[b] for b in branch_from]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.964368, "o", "> "]
[218.96448, "o", "branch_to_idx = [bus_to_idx[b] for b in branch_to]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.964499, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[218.964677, "o", "# Build B matrix for DC power flow (susceptance matrix)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.9647, "o", "> "]
[218.964933, "o", "# For DC-OPF: P_flow = (theta_from - theta_to) / x = B_line * (theta_from - theta_to)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.964956, "o", "> "]
[218.965027, "o", "# where B_line = 1/x (in per unit)\r\n\u001b[?2004l\r"]
[218.965054, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[218.965209, "o", "# Variables: [Pg (n_gen), Rg (n_gen), theta (n_bus)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.965231, "o", "> "]
[218.965316, "o", "# Total variables: 2*n_gen + n_bus\r\n\u001b[?2004l\r"]
[218.965349, "o", "\u001b[?2004h> "]
[218.96542, "o", "n_vars = 2 * n_gen + n_bus\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.965441, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[218.965813, "o", "print(f\"\\nOptimization problem: {n_vars} variables\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Objective: minimize sum(cost_i * Pg_i)\r\n\u001b[?2004l\r\u001b[?2004h> # c vector for linprog\r\n\u001b[?2004l\r\u001b[?2004h> c = np.zeros(n_vars)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.965913, "o", "c[:n_gen] = costs  # Cost coefficients for Pg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.965974, "o", "# No cost for reserves or theta\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[218.965994, "o", "\u001b[?2004h> "]
[218.966046, "o", "# Constraints:\r\n\u001b[?2004l\r"]
[218.966071, "o", "\u001b[?2004h> "]
[218.966353, "o", "# 1. Power balance at each bus: sum(Pg at bus) - Pd = sum(B_ij * (theta_i - theta_j))\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.966374, "o", "> "]
[218.966553, "o", "# 2. Pg + Rg <= Pmax (capacity coupling)\r\n\u001b[?2004l\r"]
[218.966654, "o", "\u001b[?2004h> "]
[218.966825, "o", "# 3. sum(Rg) >= reserve_requirement\r\n"]
[218.966902, "o", "\u001b[?2004l\r"]
[218.966953, "o", "\u001b[?2004h> "]
[218.967169, "o", "# 4. Line flow limits: -rate <= (theta_from - theta_to)/x <= rate"]
[218.96724, "o", "\r\n"]
[218.967266, "o", "\u001b[?2004l\r\u001b[?2004h"]
[218.967341, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[218.967388, "o", "> "]
[218.967569, "o", "# Build equality constraints for power balance"]
[218.967772, "o", "\r\n"]
[218.967811, "o", "\u001b[?2004l\r\u001b[?2004h> # A_eq * x = b_eq\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.968013, "o", "# For each bus i: sum(Pg for gens at i) - sum(B_ij*(theta_i - theta_j)) = Pd_i\r\n\u001b[?2004l\r"]
[218.968038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[218.968065, "o", "\u001b[?2004h> "]
[218.968201, "o", "# Build incidence and susceptance matrices\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.96826, "o", "> "]
[218.968346, "o", "A_eq = lil_matrix((n_bus, n_vars))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.968384, "o", "b_eq = Pd.copy()\r\n\u001b[?2004l\r"]
[218.968411, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rw\u001b[?2004h> "]
[218.96853, "o", "# Generator injection at each bus\r\n\u001b[?2004l\r"]
[218.968551, "o", "\u001b[?2004h> "]
[218.968647, "o", "for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.968672, "o", "> "]
[218.968768, "o", "    bus_idx = gen_bus_idx[g]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.968789, "o", "> "]
[218.969005, "o", "    A_eq[bus_idx, g] = 1.0  # Pg contributes to bus power balance\r\n\u001b[?2004l\r"]
[218.969031, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[218.969055, "o", "> "]
[218.969388, "o", "# Power flow terms: for each branch, add B*(theta_from - theta_to) to from bus, subtract from to bus\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.969416, "o", "> "]
[218.9695, "o", "for br in range(n_branch):\r\n\u001b[?2004l\r"]
[218.969549, "o", "\u001b[?2004h> "]
[218.969648, "o", "    if branch_status[br] == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.969669, "o", "> "]
[218.969747, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.969863, "o", "    f_idx = branch_from_idx[br]\r\n\u001b[?2004l\r"]
[218.96989, "o", "\u001b[?2004h> "]
[218.969985, "o", "    t_idx = branch_to_idx[br]\r\n\u001b[?2004l\r"]
[218.970011, "o", "\u001b[?2004h> "]
[218.970167, "o", "    b_val = 1.0 / branch_x[br]  # susceptance\r\n\u001b[?2004l\r"]
[218.970212, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[218.970231, "o", "\u001b[?2004h> "]
[218.970387, "o", "    # Flow from f to t: B*(theta_f - theta_t)\r\n\u001b[?2004l\r"]
[218.970413, "o", "\u001b[?2004h> "]
[218.970639, "o", "    # At bus f: net injection = Pg - Pd = flow out = B*(theta_f - theta_t)\r\n\u001b[?2004l\r"]
[218.970665, "o", "\u001b[?2004h> "]
[218.970921, "o", "    # At bus t: net injection = Pg - Pd = flow in = -B*(theta_f - theta_t)\r\n\u001b[?2004l\r"]
[218.97095, "o", "\u001b[?2004h>     "]
[218.970969, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.970988, "o", "> "]
[218.971216, "o", "    # So in power balance: Pg - B*theta_f + B*theta_t = Pd (for bus f)\r\n\u001b[?2004l\r"]
[218.971239, "o", "\u001b[?2004h> "]
[218.971421, "o", "    # And: Pg + B*theta_f - B*theta_t = Pd (for bus t)\r\n\u001b[?2004l\r"]
[218.971446, "o", "\u001b[?2004h> "]
[218.971479, "o", "    \r\n\u001b[?2004l\r"]
[218.971502, "o", "\u001b[?2004h> "]
[218.97172, "o", "    theta_offset = 2 * n_gen  # theta variables start after Pg and Rg\r\n\u001b[?2004l\r"]
[218.971746, "o", "\u001b[?2004h> "]
[218.971898, "o", "    A_eq[f_idx, theta_offset + f_idx] -= b_val\r\n\u001b[?2004l\r"]
[218.971924, "o", "\u001b[?2004h> "]
[218.972076, "o", "    A_eq[f_idx, theta_offset + t_idx] += b_val\r\n\u001b[?2004l\r"]
[218.97211, "o", "\u001b[?2004h> "]
[218.972256, "o", "    A_eq[t_idx, theta_offset + f_idx] += b_val\r\n\u001b[?2004l\r"]
[218.972279, "o", "\u001b[?2004h> "]
[218.972435, "o", "    A_eq[t_idx, theta_offset + t_idx] -= b_val\r\n\u001b[?2004l\r"]
[218.972474, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[218.972494, "o", "\u001b[?2004h> "]
[218.972614, "o", "# Set reference bus (bus 0) theta = 0\r\n\u001b[?2004l\r"]
[218.972632, "o", "\u001b[?2004h> "]
[218.972825, "o", "# We'll handle this by fixing theta[0] = 0 through bounds\r\n\u001b[?2004l\r"]
[218.972852, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[218.972873, "o", "\u001b[?2004h> "]
[218.97311, "o", "# Inequality constraints: A_ub * x <= b_ub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.97318, "o", "# 1. Pg + Rg <= Pmax for each generator\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.973205, "o", "> "]
[218.973449, "o", "# 2. -sum(Rg) <= -reserve_requirement (i.e., sum(Rg) >= reserve_requirement)\r\n\u001b[?2004l\r"]
[218.973471, "o", "\u001b[?2004h> "]
[218.973777, "o", "# 3. Line flow limits: (theta_from - theta_to)/x <= rate AND -(theta_from - theta_to)/x <= rate\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.973801, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[218.973827, "o", "> "]
[218.974146, "o", "n_ineq = n_gen + 1 + 2 * n_branch  # capacity coupling + reserve req + line limits (both directions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.974174, "o", "> "]
[218.974337, "o", "A_ub = lil_matrix((n_ineq, n_vars))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.9744, "o", "b_ub = np.zeros(n_ineq)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.974421, "o", "> \r\n\u001b[?2004l\r"]
[218.974446, "o", "\u001b[?2004h> "]
[218.974513, "o", "row = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[218.974536, "o", "\u001b[?2004l\r\u001b[?2004h"]
[218.974556, "o", "> "]
[218.974824, "o", "# Capacity coupling: Pg + Rg <= Pmax\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.974852, "o", "> "]
[218.978833, "o", "for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, g] = 1.0  # Pg\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, n_gen + g] = 1.0  # Rg\r\n\u001b[?2004l\r\u001b[?2004h>     b_ub[row] = Pmax[g]\r\n\u001b[?2004l\r\u001b[?2004h>     row += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Reserve requirement: -sum(Rg) <= -reserve_requirement\r\n\u001b[?2004l\r\u001b[?2004h> for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, n_gen + g] = -1.0\r\n\u001b[?2004l\r\u001b[?2004h> b_ub[row] = -reserve_requirement\r\n\u001b[?2004l\r\u001b[?2004h> row += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Line flow limits\r\n\u001b[?2004l\r\u001b[?2004h> theta_offset = 2 * n_gen\r\n\u001b[?2004l\r\u001b[?2004h> for br in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h>     if branch_status[br] == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     f_idx = branch_from_idx[br]\r\n\u001b[?2004l\r\u001b[?2004h>     t_idx = branch_to_idx[br]\r\n\u001b[?2004l\r\u001b[?2004h>     b_val = 1.0 / branch_x[br]\r\n\u001b[?2004l\r\u001b[?2004h>     rate = branch_rate[br]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Flow = (theta_f - theta_t) / x = b_val * (theta_f - theta_t)\r\n\u001b[?2004l\r\u001b[?2004h>     # Constraint: b_val * (theta_f - theta_t) <= rate\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, theta_offset + f_idx] = b_val\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, theta_offset + t_idx] = -b_val\r\n\u001b[?2004l\r\u001b[?2004h>     b_ub[row] = rate\r\n\u001b[?2004l\r\u001b[?2004h>     row += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Constraint: -b_val * (theta_f - theta_t) <= rate (i.e., flow >= -rate)\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, theta_offset + f_idx] = -b_val\r\n\u001b[?2004l\r\u001b[?2004h>     A_ub[row, theta_offset + t_idx] = b_val\r\n\u001b[?2004l\r\u001b[?2004h>     b_ub[row] = rate\r\n\u001b[?2004l\r\u001b[?2004h>     row += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Inequality constraints: {row}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Variable bounds\r\n\u001b[?2004l\r\u001b[?2004h> bounds = []\r\n\u001b[?2004l\r\u001b[?2004h> # Pg bounds: Pmin <= Pg <= Pmax\r\n\u001b[?2004l\r\u001b[?2004h> for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>     bounds.append((Pmin[g], Pmax[g]))\r\n\u001b[?2004l\r\u001b[?2004h> # Rg bounds: 0 <= Rg <= reserve_capacity\r\n\u001b[?2004l\r\u001b[?2004h> for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h>     bounds.append((0, res_cap[g]))\r\n\u001b[?2004l\r\u001b[?2004h> # Theta bounds: reference bus = 0, others unbounded\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(n_bus):\r\n\u001b[?2004l\r\u001b[?2004h>     if i == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         bounds.append((0, 0))  # Reference bus\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         bounds.append((None, None))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSolving LP...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert to CSR format for efficiency\r\n\u001b[?2004l\r\u001b[?2004h> A_eq_csr = csr_matrix(A_eq)\r\n\u001b[?2004l\r\u001b[?2004h> A_ub_csr = csr_matrix(A_ub[:row, :])\r\n\u001b[?2004l\r\u001b[?2004h> b_ub_trimmed = b_ub[:row]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Solve\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.979369, "o", "result = linprog(c, A_ub=A_ub_csr, b_ub=b_ub_trimmed, A_eq=A_eq_csr, b_eq=b_eq, \r\n\u001b[?2004l\r"]
[218.979393, "o", "\u001b[?2004h> "]
[218.979517, "o", "                 bounds=bounds, method='highs')\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.979539, "o", "> \r\n\u001b[?2004l\r"]
[218.979602, "o", "\u001b[?2004h> "]
[218.979635, "o", "if result.success:\r\n"]
[218.979663, "o", "\u001b[?2004l\r\u001b[?2004h"]
[218.979681, "o", "> "]
[218.979738, "o", "    print(f\"Optimization successful!\")\r\n\u001b[?2004l\r"]
[218.979761, "o", "\u001b[?2004h> "]
[218.979839, "o", "    print(f\"Total cost: ${result.fun:.2f}/hour\")\r\n\u001b[?2004l\r"]
[218.97986, "o", "\u001b[?2004h>     "]
[218.979884, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.979906, "o", "> "]
[218.979936, "o", "    # Extract solution\r\n\u001b[?2004l\r"]
[218.979962, "o", "\u001b[?2004h> "]
[218.980023, "o", "    Pg_opt = result.x[:n_gen]\r\n\u001b[?2004l\r"]
[218.980046, "o", "\u001b[?2004h> "]
[218.980204, "o", "    Rg_opt = result.x[n_gen:2*n_gen]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980228, "o", "    theta_opt = result.x[2*n_gen:]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980294, "o", "    total_gen = np.sum(Pg_opt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980376, "o", "    total_res = np.sum(Rg_opt)\r\n\u001b[?2004l\r"]
[218.980419, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980498, "o", "    print(f\"Total generation: {total_gen:.2f} MW\")\r\n\u001b[?2004l\r"]
[218.98052, "o", "\u001b[?2004h> "]
[218.980599, "o", "    print(f\"Total reserves: {total_res:.2f} MW\")\r\n\u001b[?2004l\r"]
[218.980623, "o", "\u001b[?2004h>     "]
[218.980656, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980731, "o", "    # Calculate line flows and loading\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.980764, "o", "> "]
[218.980823, "o", "    line_flows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.980851, "o", "    for br in range(n_branch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.980871, "o", "> "]
[218.980927, "o", "        if branch_status[br] == 0:\r\n\u001b[?2004l\r"]
[218.980947, "o", "\u001b[?2004h> "]
[218.981038, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981101, "o", "        f_idx = branch_from_idx[br]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981151, "o", "        t_idx = branch_to_idx[br]\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.981197, "o", "> "]
[218.981229, "o", "        b_val = 1.0 / branch_x[br]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981353, "o", "        flow = b_val * (theta_opt[f_idx] - theta_opt[t_idx])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981385, "o", "        rate = branch_rate[br]\r\n\u001b[?2004l\r"]
[218.981463, "o", "\u001b[?2004h> "]
[218.981544, "o", "        loading = abs(flow) / rate * 100 if rate > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.98159, "o", "        line_flows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981642, "o", "            'branch_idx': br,\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.981663, "o", "> "]
[218.981728, "o", "            'from': branch_from[br],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.981779, "o", "            'to': branch_to[br],\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.981798, "o", "> "]
[218.98185, "o", "            'flow': flow,\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.981927, "o", ">             'rate': rate,\r\n\u001b[?2004l\r"]
[218.981961, "o", "\u001b[?2004h>             'loading_pct': loading\r\n\u001b[?2004l\r"]
[218.982054, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.98214, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Sort by loading\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.982211, "o", "    line_flows.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.982241, "o", ">     \r\n\u001b[?2004l\r"]
[218.982262, "o", "\u001b[?2004h> "]
[218.982331, "o", "    print(f\"\\nTop 3 most loaded lines:\")\r\n\u001b[?2004l\r"]
[218.982363, "o", "\u001b[?2004h> "]
[218.982439, "o", "    for i, lf in enumerate(line_flows[:3]):\r\n\u001b[?2004l\r"]
[218.982463, "o", "\u001b[?2004h> "]
[218.982688, "o", "        print(f\"  {i+1}. Line {lf['from']}->{lf['to']}: {lf['loading_pct']:.1f}% ({abs(lf['flow']):.1f}/{lf['rate']:.1f} MW)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.982771, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.982817, "o", "    # Calculate operating margin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.982915, "o", "    operating_margin = np.sum(Pmax - Pg_opt - Rg_opt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983037, "o", "    print(f\"\\nOperating margin: {operating_margin:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[218.983062, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983126, "o", "    # Build report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983174, "o", "    generator_dispatch = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983263, "o", "    for g in range(n_gen):\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.983333, "o", ">         generator_dispatch.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983363, "o", "            \"id\": g + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983431, "o", "            \"bus\": gen_bus[g],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983514, "o", "            \"output_MW\": round(Pg_opt[g], 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.983534, "o", "> "]
[218.983605, "o", "            \"reserve_MW\": round(Rg_opt[g], 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.983625, "o", "> "]
[218.983665, "o", "            \"pmax_MW\": Pmax[g]\r\n\u001b[?2004l\r"]
[218.98371, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[218.983785, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983809, "o", "    most_loaded_lines = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.983985, "o", "        {\"from\": lf['from'], \"to\": lf['to'], \"loading_pct\": round(lf['loading_pct'], 1)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.984019, "o", "        for lf in line_flows[:3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.984054, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.984077, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.984118, "o", "    report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.984138, "o", "> "]
[218.984257, "o", "        \"generator_dispatch\": generator_dispatch,\r\n\u001b[?2004l\r\u001b[?2004h>         \"totals\": {"]
[218.984284, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[218.984426, "o", "            \"cost_dollars_per_hour\": round(result.fun, 2),\r\n\u001b[?2004l\r"]
[218.985009, "o", "\u001b[?2004h>             \"load_MW\": round(total_load, 2),"]
[218.985037, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             \"generation_MW\": round(total_gen, 2),\r\n\u001b[?2004l\r\u001b[?2004h>             \"reserve_MW\": round(total_res, 2)\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h>         \"most_loaded_lines\": most_loaded_lines,\r\n\u001b[?2004l\r\u001b[?2004h>         \"operating_margin_MW\": round(operating_margin, 2)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     with open('report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[218.985138, "o", "\u001b[?2004h> "]
[218.985164, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[218.985185, "o", "\u001b[?2004h> "]
[218.985262, "o", "    print(\"\\nReport saved to report.json\")\r\n\u001b[?2004l\r"]
[218.985283, "o", "\u001b[?2004h> "]
[218.985313, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.985333, "o", "> "]
[218.98541, "o", "    print(f\"Optimization failed: {result.message}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[218.985435, "o", "> SCRIPT\r\n\u001b[?2004l\r"]
[218.986966, "o", "\u001b[?2004hroot@7fcb4fd0aa51:~# "]
