[294.466671, "o", "      \"output_MW\": 73.33,\r\n      \"reserve_MW\": 13.25,\r\n      \"pmax_MW\": 147.0\r\n    }\r\n  ],\r\n  \"totals\": {\r\n    \"cost_dollars_per_hour\": 2965637.91,\r\n    \"load_MW\": 144839.06,\r\n    \"generation_MW\": 144839.06,\r\n    \"reserve_MW\": 5923.5\r\n  },\r\n  \"most_loaded_lines\": [\r\n    {\r\n      \"from\": 2198,\r\n      \"to\": 1324,\r\n      \"loading_pct\": 100.0\r\n    },\r\n    {\r\n      \"from\": 1660,\r\n      \"to\": 2664,\r\n      \"loading_pct\": 100.0\r\n    },\r\n    {\r\n      \"from\": 64,\r\n      \"to\": 1501,\r\n      \"loading_pct\": 100.0\r\n    }\r\n  ],\r\n  \"operating_margin_MW\": 68325.44\r\n}"]
