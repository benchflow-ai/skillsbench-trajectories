[28.217941, "o", "\u001b[?2004hroot@7fcb4fd0aa51:~# "]
[40.739524, "i", "python3 << 'EOF'\nimport json\n\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\nprint(\"Keys:\", list(data.keys()))\nprint(\"BaseMVA:\", data.get('baseMVA', 100))\nprint(\"Reserve:\", data.get('reserve', {}))\n\n# Calculate total load from bus data\n# Bus format: [bus_i, type, Pd, Qd, Gs, Bs, area, Vm, Va, baseKV, zone, Vmax, Vmin]\nbus_data = data.get('bus', [])\ntotal_load = sum(b[2] for b in bus_data)  # Pd is at index 2\nprint(f\"\\nTotal load: {total_load} MW\")\nprint(f\"Number of buses: {len(bus_data)}\")\n\n# Generator info\ngen_data = data.get('gen', [])\nprint(f\"Number of generators: {len(gen_data)}\")\ntotal_pmax = sum(g[8] for g in gen_data if g[7] == 1)  # Pmax for online gens\ntotal_pmin = sum(g[9] for g in gen_data if g[7] == 1)\nprint(f\"Total Pmax: {total_pmax} MW\")\nprint(f\"Total Pmin: {total_pmin} MW\")\n\n# Branch info\nbranch_data = data.get('branch', [])\nprint(f\"Number of branches: {len(branch_data)}\")\n\nEOF\n"]
[40.742601, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('network.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Keys:\", list(data.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> print(\"BaseMVA:\", data.get('baseMVA', 100))\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Reserve:\", data.get('reserve', {}))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate total load from bus data\r\n\u001b[?2004l\r\u001b[?2004h> # Bus format: [bus_i, type, Pd, Qd, Gs, Bs, area, Vm, Va, baseKV, zone, Vmax, Vmin]\r\n\u001b[?2004l\r\u001b[?2004h> bus_data = data.get('bus', [])\r\n\u001b[?2004l\r\u001b[?2004h> total_load = sum(b[2] for b in bus_data)  # Pd is at index 2\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nTotal load: {total_load} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of buses: {len(bus_data)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Generator info\r\n\u001b[?2004l\r\u001b[?2004h> gen_data = data.get('gen', [])\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of generators: {len(gen_data)}\")\r\n\u001b[?2004l\r\u001b[?2004h> total_pmax = sum(g[8] for g in gen_data if g[7] == 1)  # Pmax for online gens\r\n\u001b[?2004l\r\u001b[?2004h> total_pmin = sum(g[9] for g in gen_data if g[7] == 1)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total Pmax: {total_pmax} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total Pmin: {total_pmin} MW\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Branch info\r\n\u001b[?2004l\r\u001b[?2004h> branch_data = data.get('branch', [])\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of branches: {len(branch_data)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
