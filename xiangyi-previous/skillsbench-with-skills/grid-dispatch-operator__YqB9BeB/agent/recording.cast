[28.174913, "i", "python3 << 'EOF'\nimport json\n\n# Load network data\nwith open('network.json', 'r') as f:\n    data = json.load(f)\n\n# Print structure overview\nprint(\"Keys:\", list(data.keys()))\nprint(\"\\nNumber of buses:\", len(data.get('bus', [])))\nprint(\"Number of generators:\", len(data.get('gen', [])))\nprint(\"Number of branches:\", len(data.get('branch', [])))\nprint(\"\\nReserve data:\", data.get('reserve', {}))\nprint(\"\\nBaseMVA:\", data.get('baseMVA', 100))\n\n# Print generator data\nprint(\"\\nGenerator data:\")\nfor i, g in enumerate(data.get('gen', [])):\n    print(f\"Gen {i+1}: bus={g[0]}, Pg={g[1]}, Pmax={g[8]}, Pmin={g[9]}, status={g[7]}\")\n\n# Print gencost data\nprint(\"\\nGenerator cost data:\")\nfor i, c in enumerate(data.get('gencost', [])):\n    print(f\"Gen {i+1} cost: {c}\")\nEOF\n"]
