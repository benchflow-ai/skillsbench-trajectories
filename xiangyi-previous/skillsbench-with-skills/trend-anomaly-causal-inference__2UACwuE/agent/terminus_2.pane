[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part3.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Amazon usage frequency
[?2004l[?2004h> usage_map = {'Less than 5 times per month': 1, '5 - 10 times per month': 2, 'More than 10 times per month': 3}
[?2004l[?2004h> survey_fe['amazon_usage_freq'] = survey_df['Q-amazon-use-how-oft'].map(usage_map).fillna(0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Household size
[?2004l[?2004h> def parse_hh(val):
[?2004l[?2004h>     if pd.isna(val): return 0
[?2004l[?2004h>     val = str(val)
[?2004l[?2004h>     if '4+' in val: return 4
[?2004l[?2004h>     if 'just me' in val.lower() or val == '1': return 1
[?2004l[?2004h>     try: return int(val)
[?2004l[?2004h>     except: return 0
[?2004l[?2004h> 
[?2004l[?2004h> survey_fe['household_size'] = survey_df['Q-amazon-use-hh-size'].apply(parse_hh)
[?2004l[?2004h> survey_fe['amazon_accounts'] = survey_df['Q-amazon-use-howmany'].apply(parse_hh)
[?2004l[?2004h> 
[?2004l[?2004h> # Substance use
[?2004l[?2004h> survey_fe['uses_cigarettes'] = (survey_df['Q-substance-use-cigarettes'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> survey_fe['uses_marijuana'] = (survey_df['Q-substance-use-marijuana'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> survey_fe['uses_alcohol'] = (survey_df['Q-substance-use-alcohol'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Health
[?2004l[?2004h> survey_fe['has_diabetes'] = (survey_df['Q-personal-diabetes'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> survey_fe['uses_wheelchair'] = (survey_df['Q-personal-wheelchair'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # State regions
[?2004l[?2004h> northeast = ['CT','ME','MA','NH','RI','VT','NJ','NY','PA']
[?2004l[?2004h> midwest = ['IL','IN','MI','OH','WI','IA','KS','MN','MO','NE','ND','SD']
[?2004l[?2004h> south = ['DE','FL','GA','MD','NC','SC','VA','WV','AL','KY','MS','TN','AR','LA','OK','TX']
[?2004l[?2004h> west = ['AZ','CO','ID','MT','NV','NM','UT','WY','AK','CA','HI','OR','WA']
[?2004l[?2004h> 
[?2004l[?2004h> survey_fe['region_northeast'] = survey_df['Q-demos-state'].isin(northeast).astype(int)
[?2004l[?2004h> survey_fe['region_midwest'] = survey_df['Q-demos-state'].isin(midwest).astype(int)
[?2004l[?2004h> survey_fe['region_south'] = survey_df['Q-demos-state'].isin(south).astype(int)
[?2004l[?2004h> survey_fe['region_west'] = survey_df['Q-demos-state'].isin(west).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Final feature engineered shape: {survey_fe.shape}")
