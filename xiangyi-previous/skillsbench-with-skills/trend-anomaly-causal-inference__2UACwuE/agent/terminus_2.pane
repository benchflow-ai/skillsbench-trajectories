[?2004hroot@05a65808387b:/app# cat > /app/analysis_part1.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> print("STEP 1: DATA CLEANING")
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print("Loading datasets...")
[?2004l[?2004h> survey_df = pd.read_csv('/app/data/survey_dirty.csv')
[?2004l[?2004h> purchases_df = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Survey data shape: {survey_df.shape}")
[?2004l[?2004h> print(f"Purchase data shape: {purchases_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # ============ CLEAN SURVEY DATA ============
[?2004l[?2004h> print("\nCleaning survey data...")
[?2004l[?2004h> print(f"Survey duplicates before: {survey_df.duplicated().sum()}")
[?2004l[?2004h> print(f"Survey ResponseID duplicates: {survey_df['Survey ResponseID'].duplicated().sum()}")
[?2004l[?2004h> 
[?2004l[?2004h> survey_df = survey_df.drop_duplicates()
[?2004l[?2004h> survey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'], keep='first')
[?2004l[?2004h> survey_df.columns = survey_df.columns.str.strip()
[?2004l[?2004h> 
[?2004l[?2004h> for col in survey_df.columns:
[?2004l[?2004h>     if col != 'Survey ResponseID':
[?2004l[?2004h>         if survey_df[col].dtype == 'object':
[?2004l[?2004h>             survey_df[col] = survey_df[col].str.strip() if survey_df[col].dtype == 'object' else survey_df[col]
[?2004l[?2004h>             survey_df[col] = survey_df[col].fillna('Unknown')
[?2004l[?2004h>         else:
[?2004l[?2004h>             survey_df[col] = survey_df[col].fillna(survey_df[col].median())
[?2004l[?2004h> 
[?2004l[?2004h> survey_df = survey_df.dropna(subset=['Survey ResponseID'])
[?2004l[?2004h> print(f"Survey data after cleaning: {survey_df.shape}")
[?2004l[?2004h> survey_df.to_csv('/app/output/survey_cleaned.csv', index=False)
[?2004l[?2004h> print("Saved: survey_cleaned.csv")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part1.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # ============ CLEAN PURCHASE DATA ============
[?2004l[?2004h> print("\nCleaning purchase data...")
[?2004l[?2004h> print(f"Purchase duplicates before: {purchases_df.duplicated().sum()}")
[?2004l[?2004h> 
[?2004l[?2004h> purchases_df = purchases_df.drop_duplicates()
[?2004l[?2004h> purchases_df.columns = purchases_df.columns.str.strip()
[?2004l[?2004h> purchases_df['Order Date'] = pd.to_datetime(purchases_df['Order Date'], errors='coerce')
[?2004l[?2004h> purchases_df = purchases_df.dropna(subset=['Order Date'])
[?2004l[?2004h> purchases_df['Purchase Price Per Unit'] = pd.to_numeric(purchases_df['Purchase Price Per Unit'], errors='coerce')
[?2004l[?2004h> purchases_df['Quantity'] = pd.to_numeric(purchases_df['Quantity'], errors='coerce')
