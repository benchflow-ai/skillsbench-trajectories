[?2004l[?2004h>         'baseline_purchase_rate': result['baseline_purchase_rate'],
[?2004l[?2004h>         'treatment_purchase_rate': result['treatment_purchase_rate'],
[?2004l[?2004h>         'n_at_risk': result['n_at_risk'],
[?2004l[?2004h>         'intensive_margin': int_sorted,
[?2004l[?2004h>         'extensive_margin': ext_sorted
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAnalyzing slump categories...")
[?2004l[?2004h> slump_results = []
