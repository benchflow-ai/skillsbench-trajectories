[?2004hroot@05a65808387b:/app# cat > /app/analysis_part4.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> print("STEP 4: PREPARE AGGREGATED DATA FOR DID")
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> purchases_df = pd.read_pickle('/app/output/purchases_clean.pkl')
[?2004l[?2004h> survey_fe = pd.read_pickle('/app/output/survey_fe.pkl')
[?2004l[?2004h> anomaly_df = pd.read_pickle('/app/output/anomaly_df.pkl')
[?2004l[?2004h> 
[?2004l[?2004h> # Get top 10 surge and slump categories
[?2004l[?2004h> surge_cats = anomaly_df.head(10)['Category'].tolist()
[?2004l[?2004h> slump_cats = anomaly_df.tail(10)['Category'].tolist()
[?2004l[?2004h> selected_cats = surge_cats + slump_cats
[?2004l[?2004h> print(f"Surge categories: {surge_cats}")
[?2004l[?2004h> print(f"Slump categories: {slump_cats}")
[?2004l[?2004h> 
[?2004l[?2004h> # Define periods
[?2004l[?2004h> baseline_start = pd.Timestamp('2020-01-01')
[?2004l[?2004h> baseline_end = pd.Timestamp('2020-02-29')
[?2004l[?2004h> treatment_start = pd.Timestamp('2020-03-01')
[?2004l[?2004h> treatment_end = pd.Timestamp('2020-03-31')
[?2004l[?2004h> 
[?2004l[?2004h> # Filter purchases to selected categories and periods
[?2004l[?2004h> mask = (purchases_df['Category'].isin(selected_cats)) & \
[?2004l[?2004h>        (purchases_df['Order Date'] >= baseline_start) & \
[?2004l[?2004h>        (purchases_df['Order Date'] <= treatment_end)
[?2004l[?2004h> purchases_filtered = purchases_df[mask].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Add period indicator
[?2004l[?2004h> purchases_filtered['Period'] = np.where(
[?2004l[?2004h>     purchases_filtered['Order Date'] < treatment_start, 'Baseline', 'Treatment'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Filtered purchases: {len(purchases_filtered)}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part4.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # INTENSIVE MARGIN: Total spend per user-category-period
[?2004l[?2004h> intensive = purchases_filtered.groupby(
[?2004l[?2004h>     ['Survey ResponseID', 'Category', 'Period']
[?2004l[?2004h> ).agg(Total_Spend=('Total_Spend', 'sum')).reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Intensive margin data shape: {intensive.shape}")
[?2004l[?2004h> intensive.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)
[?2004l[?2004h> print("Saved: user_category_period_aggregated_intensive.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # EXTENSIVE MARGIN: Create panel with all user-category-period combinations
[?2004l[?2004h> all_users = survey_fe['Survey ResponseID'].unique()
[?2004l[?2004h> periods = ['Baseline', 'Treatment']
[?2004l[?2004h> 
[?2004l[?2004h> # Create full panel
[?2004l[?2004h> panel_rows = []
[?2004l[?2004h> for user in all_users:
[?2004l[?2004h>     for cat in selected_cats:
[?2004l[?2004h>         for period in periods:
[?2004l[?2004h>             panel_rows.append({'Survey ResponseID': user, 'Category': cat, 'Period': period})
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.DataFrame(panel_rows)
[?2004l[?2004h> print(f"Full panel size: {len(panel)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Merge with actual purchases to get Has_Purchase indicator
[?2004l[?2004h> purchase_indicator = purchases_filtered.groupby(
[?2004l[?2004h>     ['Survey ResponseID', 'Category', 'Period']
[?2004l[?2004h> ).size().reset_index(name='purchase_count')
[?2004l[?2004h> 
[?2004l[?2004h> extensive = panel.merge(purchase_indicator, on=['Survey ResponseID', 'Category', 'Period'], how='left')
[?2004l[?2004h> extensive['Has_Purchase'] = (extensive['purchase_count'].fillna(0) > 0).astype(int)
[?2004l[?2004h> extensive = extensive[['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Extensive margin data shape: {extensive.shape}")
[?2004l[?2004h> extensive.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)
[?2004l[?2004h> print("Saved: user_category_period_aggregated_extensive.csv")
[?2004l[?2004h> 
[?2004l[?2004h> # Save for next step
[?2004l[?2004h> intensive.to_pickle('/app/output/intensive.pkl')
[?2004l[?2004h> extensive.to_pickle('/app/output/extensive.pkl')
[?2004l[?2004h> print("Data preparation complete!")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@05a65808387b:/app# python3 /app/analysis_part4.py
[?2004l============================================================
STEP 4: PREPARE AGGREGATED DATA FOR DID
