[?2004hroot@05a65808387b:/app# cat > /app/analysis_part2.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> print("STEP 2: ANOMALY DETECTION")
[?2004l[?2004h> print("=" * 60)
[?2004l[?2004h> 
[?2004l[?2004h> # Load cleaned data
[?2004l[?2004h> survey_df = pd.read_pickle('/app/output/survey_clean.pkl')
[?2004l[?2004h> purchases_df = pd.read_pickle('/app/output/purchases_clean.pkl')
[?2004l[?2004h> 
[?2004l[?2004h> # Define time periods
[?2004l[?2004h> treatment_start = pd.Timestamp('2020-03-01')
[?2004l[?2004h> treatment_end = pd.Timestamp('2020-03-31')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Treatment period: {treatment_start.date()} to {treatment_end.date()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Create daily sales by category
[?2004l[?2004h> purchases_df['Date'] = purchases_df['Order Date'].dt.date
[?2004l[?2004h> daily_cat = purchases_df.groupby(['Date', 'Category']).agg(
[?2004l[?2004h>     Daily_Sales=('Total_Spend', 'sum'),
[?2004l[?2004h>     Unique_Customers=('Survey ResponseID', 'nunique')
[?2004l[?2004h> ).reset_index()
[?2004l[?2004h> daily_cat['Date'] = pd.to_datetime(daily_cat['Date'])
[?2004l[?2004h> 
[?2004l[?2004h> categories = purchases_df['Category'].unique()
[?2004l[?2004h> print(f"Total categories: {len(categories)}")
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_results = []
[?2004l[?2004h> for category in categories:
[?2004l[?2004h>     cat_data = daily_cat[daily_cat['Category'] == category].copy()
[?2004l[?2004h>     if len(cat_data) < 10:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     historical = cat_data[cat_data['Date'] < treatment_start]
[?2004l[?2004h>     treatment = cat_data[(cat_data['Date'] >= treatment_start) & (cat_data['Date'] <= treatment_end)]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(historical) < 5 or len(treatment) < 1:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     hist_mean = historical['Daily_Sales'].mean()
[?2004l[?2004h>     hist_std = historical['Daily_Sales'].std()
[?2004l[?2004h>     if hist_std == 0 or np.isnan(hist_std):
[?2004l[?2004h>         hist_std = hist_mean * 0.1 if hist_mean > 0 else 1
[?2004l[?2004h>     
[?2004l[?2004h>     treatment_mean = treatment['Daily_Sales'].mean()
[?2004l[?2004h>     z_score = (treatment_mean - hist_mean) / hist_std if hist_std > 0 else 0
[?2004l[?2004h>     anomaly_index = np.tanh(z_score / 3) * 100
[?2004l[?2004h>     
[?2004l[?2004h>     anomaly_results.append({
[?2004l[?2004h>         'Category': category,
[?2004l[?2004h>         'Anomaly_Index': round(anomaly_index, 2),
[?2004l[?2004h>         'Historical_Mean': hist_mean,
[?2004l[?2004h>         'Treatment_Mean': treatment_mean,
[?2004l[?2004h>         'Z_Score': z_score
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_df = pd.DataFrame(anomaly_results)
[?2004l[?2004h> anomaly_df = anomaly_df.sort_values('Anomaly_Index', ascending=False)
[?2004l[?2004h> print(f"Categories with anomaly scores: {len(anomaly_df)}")
[?2004l[?2004h> print("\nTop 10 SURGE:")
[?2004l[?2004h> print(anomaly_df.head(10)[['Category', 'Anomaly_Index']])
[?2004l[?2004h> print("\nTop 10 SLUMP:")
[?2004l[?2004h> print(anomaly_df.tail(10)[['Category', 'Anomaly_Index']])
[?2004l[?2004h> 
[?2004l[?2004h> anomaly_df[['Category', 'Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)
[?2004l[?2004h> print("\nSaved: category_anomaly_index.csv")
[?2004l[?2004h> anomaly_df.to_pickle('/app/output/anomaly_df.pkl')
[?2004l[?2004h> EOF
