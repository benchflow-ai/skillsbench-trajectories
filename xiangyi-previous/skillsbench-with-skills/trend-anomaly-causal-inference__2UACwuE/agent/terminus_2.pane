[?2004l[?2004h> survey_df = pd.read_pickle('/app/output/survey_clean.pkl')
[?2004l[?2004h> survey_fe = pd.DataFrame()
[?2004l[?2004h> survey_fe['Survey ResponseID'] = survey_df['Survey ResponseID']
[?2004l[?2004h> 
[?2004l[?2004h> # Age encoding
[?2004l[?2004h> age_map = {'18 - 24 years': 1, '25 - 34 years': 2, '35 - 44 years': 3,
[?2004l[?2004h>            '45 - 54 years': 4, '55 - 64 years': 5, '65 and older': 6}
[?2004l[?2004h> survey_fe['age_group'] = survey_df['Q-demos-age'].map(age_map).fillna(0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Income encoding
[?2004l[?2004h> income_map = {'Less than $25,000': 1, '$25,000 - $49,999': 2, '$50,000 - $74,999': 3,
[?2004l[?2004h>               '$75,000 - $99,999': 4, '$100,000 - $149,999': 5, '$150,000 or more': 6}
[?2004l[?2004h> survey_fe['income_level'] = survey_df['Q-demos-income'].map(income_map).fillna(0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Education encoding
[?2004l[?2004h> edu_map = {'Some high school or less': 1, 'High school diploma or GED': 2,
[?2004l[?2004h>            'Some college, no degree': 3, 'Associate degree': 4,
[?2004l[?2004h>            "Bachelor's degree": 5,
[?2004l[?2004h>            'Graduate or professional degree (MA, MS, MBA, PhD, JD, MD, DDS, etc)': 6}
[?2004l[?2004h> survey_fe['education_level'] = survey_df['Q-demos-education'].map(edu_map).fillna(0).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Gender
[?2004l[?2004h> survey_fe['is_female'] = (survey_df['Q-demos-gender'].str.lower().str.contains('female', na=False)).astype(int)
[?2004l[?2004h> survey_fe['is_male'] = (survey_df['Q-demos-gender'].str.lower() == 'male').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Hispanic
[?2004l[?2004h> survey_fe['is_hispanic'] = (survey_df['Q-demos-hispanic'].str.lower() == 'yes').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Race dummies
[?2004l[?2004h> for race in ['White', 'Black', 'Asian', 'Other']:
[?2004l[?2004h>     survey_fe[f'race_{race.lower()}'] = survey_df['Q-demos-race'].str.contains(race, case=False, na=False).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Sexual orientation
[?2004l[?2004h> survey_fe['is_lgbtq'] = survey_df['Q-sexual-orientation'].str.contains('LGBTQ', case=False, na=False).astype(int)
[?2004l[?2004h> survey_fe['is_heterosexual'] = survey_df['Q-sexual-orientation'].str.contains('straight|heterosexual', case=False, na=False).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Feature engineered data shape: {survey_fe.shape}")
[?2004l[?2004h> print(f"Features: {list(survey_fe.columns)}")
[?2004l[?2004h> survey_fe.to_csv('/app/output/survey_feature_engineered.csv', index=False)
[?2004l[?2004h> print("Saved: survey_feature_engineered.csv")
