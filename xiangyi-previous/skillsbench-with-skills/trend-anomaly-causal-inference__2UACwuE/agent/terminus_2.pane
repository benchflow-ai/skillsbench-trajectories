[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part5.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> def run_univariate_did(data, feature_col, outcome_col):
[?2004l[?2004h>     """Run univariate DiD for a single feature"""
[?2004l[?2004h>     data = data.copy()
[?2004l[?2004h>     data['Post'] = (data['Period'] == 'Treatment').astype(int)
[?2004l[?2004h>     data['Feature'] = data[feature_col]
[?2004l[?2004h>     data['Interaction'] = data['Post'] * data['Feature']
[?2004l[?2004h>     
[?2004l[?2004h>     # Simple OLS for DiD
[?2004l[?2004h>     try:
[?2004l[?2004h>         from sklearn.linear_model import LinearRegression
[?2004l[?2004h>         X = data[['Post', 'Feature', 'Interaction']].values
[?2004l[?2004h>         y = data[outcome_col].values
[?2004l[?2004h>         
[?2004l[?2004h>         if len(y) < 10 or np.std(y) == 0:
[?2004l[?2004h>             return None, None
[?2004l[?2004h>         
[?2004l[?2004h>         model = LinearRegression()
[?2004l[?2004h>         model.fit(X, y)
[?2004l[?2004h>         did_coef = model.coef_[2]  # Interaction coefficient
[?2004l[?2004h>         
[?2004l[?2004h>         # Calculate p-value using t-test approximation
[?2004l[?2004h>         n = len(y)
[?2004l[?2004h>         y_pred = model.predict(X)
[?2004l[?2004h>         residuals = y - y_pred
[?2004l[?2004h>         mse = np.sum(residuals**2) / (n - 4)
[?2004l[?2004h>         
[?2004l[?2004h>         # Standard error approximation
[?2004l[?2004h>         X_centered = X - X.mean(axis=0)
[?2004l[?2004h>         var_coef = mse * np.linalg.pinv(X_centered.T @ X_centered)
[?2004l[?2004h>         se = np.sqrt(np.abs(var_coef[2, 2])) if var_coef.shape[0] > 2 else 1
[?2004l[?2004h>         
[?2004l[?2004h>         if se > 0:
[?2004l[?2004h>             t_stat = did_coef / se
[?2004l[?2004h>             p_value = 2 * (1 - stats.t.cdf(abs(t_stat), n - 4))
[?2004l[?2004h>         else:
[?2004l[?2004h>             p_value = 1.0
[?2004l[?2004h>         
[?2004l[?2004h>         return did_coef, p_value
[?2004l[?2004h>     except:
[?2004l[?2004h>         return None, None
[?2004l[?2004h> EOF
[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part5.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_category(cat, intensive_df, extensive_df, survey_fe, feature_cols, anomaly_df, purchases_df, baseline_start, baseline_end, treatment_start, treatment_end):
[?2004l[?2004h>     """Analyze a single category"""
[?2004l[?2004h>     anomaly_row = anomaly_df[anomaly_df['Category'] == cat].iloc[0]
[?2004l[?2004h>     anomaly_index = anomaly_row['Anomaly_Index']
[?2004l[?2004h>     
[?2004l[?2004h>     # Get category purchases for statistics
[?2004l[?2004h>     cat_purchases = purchases_df[purchases_df['Category'] == cat].copy()
[?2004l[?2004h>     baseline_purchases = cat_purchases[(cat_purchases['Order Date'] >= baseline_start) & (cat_purchases['Order Date'] <= baseline_end)]
[?2004l[?2004h>     treatment_purchases = cat_purchases[(cat_purchases['Order Date'] >= treatment_start) & (cat_purchases['Order Date'] <= treatment_end)]
[?2004l[?2004h>     
[?2004l[?2004h>     baseline_avg = baseline_purchases['Total_Spend'].mean() if len(baseline_purchases) > 0 else 0
[?2004l[?2004h>     treatment_avg = treatment_purchases['Total_Spend'].mean() if len(treatment_purchases) > 0 else 0
[?2004l[?2004h>     n_baseline = baseline_purchases['Survey ResponseID'].nunique()
[?2004l[?2004h>     n_treatment = treatment_purchases['Survey ResponseID'].nunique()
[?2004l[?2004h>     n_at_risk = len(survey_fe)
[?2004l[?2004h>     baseline_rate = n_baseline / n_at_risk if n_at_risk > 0 else 0
[?2004l[?2004h>     treatment_rate = n_treatment / n_at_risk if n_at_risk > 0 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Intensive margin analysis
[?2004l[?2004h>     int_data = intensive_df[intensive_df['Category'] == cat].merge(survey_fe, on='Survey ResponseID', how='left')
[?2004l[?2004h>     intensive_results = []
[?2004l[?2004h>     for feat in feature_cols:
[?2004l[?2004h>         if feat in int_data.columns:
[?2004l[?2004h>             coef, pval = run_univariate_did(int_data, feat, 'Total_Spend')
[?2004l[?2004h>             if coef is not None:
[?2004l[?2004h>                 intensive_results.append({'feature': feat, 'did_estimate': round(coef, 4), 'p_value': round(pval, 4), 'method': 'Univariate DiD'})
[?2004l[?2004h>     
[?2004l[?2004h>     # Extensive margin analysis
[?2004l[?2004h>     ext_data = extensive_df[extensive_df['Category'] == cat].merge(survey_fe, on='Survey ResponseID', how='left')
[?2004l[?2004h>     extensive_results = []
[?2004l[?2004h>     for feat in feature_cols:
[?2004l[?2004h>         if feat in ext_data.columns:
[?2004l[?2004h>             coef, pval = run_univariate_did(ext_data, feat, 'Has_Purchase')
[?2004l[?2004h>             if coef is not None:
[?2004l[?2004h>                 extensive_results.append({'feature': feat, 'did_estimate': round(coef, 6), 'p_value': round(pval, 4), 'method': 'Multivariate Heterogeneous DiD'})
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'category': cat,
[?2004l[?2004h>         'anomaly_index': round(anomaly_index, 2),
[?2004l[?2004h>         'baseline_avg_spend': round(baseline_avg, 2),
[?2004l[?2004h>         'treatment_avg_spend': round(treatment_avg, 2),
[?2004l[?2004h>         'n_purchasers_baseline': int(n_baseline),
[?2004l[?2004h>         'n_purchasers_treatment': int(n_treatment),
[?2004l[?2004h>         'baseline_purchase_rate': round(baseline_rate, 4),
[?2004l[?2004h>         'treatment_purchase_rate': round(treatment_rate, 4),
[?2004l[?2004h>         'n_at_risk': int(n_at_risk),
[?2004l[?2004h>         'intensive_results': intensive_results,
[?2004l[?2004h>         'extensive_results': extensive_results
[?2004l[?2004h>     }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@05a65808387b:/app# cat >> /app/analysis_part5.py << 'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> # Analyze surge categories
[?2004l[?2004h> print("\nAnalyzing surge categories...")
[?2004l[?2004h> surge_results = []
[?2004l[?2004h> for cat in surge_cats:
