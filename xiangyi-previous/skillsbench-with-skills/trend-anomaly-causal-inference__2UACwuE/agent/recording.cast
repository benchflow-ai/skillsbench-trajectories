[264.790272, "i", "cat > /app/analysis_part5.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport json\nfrom scipy import stats\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"=\" * 60)\nprint(\"STEP 5: CAUSAL ANALYSIS (DiD)\")\nprint(\"=\" * 60)\n\n# Load data\nintensive = pd.read_pickle('/app/output/intensive.pkl')\nextensive = pd.read_pickle('/app/output/extensive.pkl')\nsurvey_fe = pd.read_pickle('/app/output/survey_fe.pkl')\nanomaly_df = pd.read_pickle('/app/output/anomaly_df.pkl')\npurchases_df = pd.read_pickle('/app/output/purchases_clean.pkl')\n\n# Get categories\nsurge_cats = anomaly_df.head(10)['Category'].tolist()\nslump_cats = anomaly_df.tail(10)['Category'].tolist()\n\n# Get feature columns (exclude ID)\nfeature_cols = [c for c in survey_fe.columns if c != 'Survey ResponseID']\nprint(f\"Features for analysis: {len(feature_cols)}\")\n\n# Define periods\nbaseline_start = pd.Timestamp('2020-01-01')\nbaseline_end = pd.Timestamp('2020-02-29')\ntreatment_start = pd.Timestamp('2020-03-01')\ntreatment_end = pd.Timestamp('2020-03-31')\nEOF\n"]
