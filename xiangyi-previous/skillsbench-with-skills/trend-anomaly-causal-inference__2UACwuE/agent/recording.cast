[171.564867, "i", "cat >> /app/analysis_part3.py << 'EOF'\n\n# Amazon usage frequency\nusage_map = {'Less than 5 times per month': 1, '5 - 10 times per month': 2, 'More than 10 times per month': 3}\nsurvey_fe['amazon_usage_freq'] = survey_df['Q-amazon-use-how-oft'].map(usage_map).fillna(0).astype(int)\n\n# Household size\ndef parse_hh(val):\n    if pd.isna(val): return 0\n    val = str(val)\n    if '4+' in val: return 4\n    if 'just me' in val.lower() or val == '1': return 1\n    try: return int(val)\n    except: return 0\n\nsurvey_fe['household_size'] = survey_df['Q-amazon-use-hh-size'].apply(parse_hh)\nsurvey_fe['amazon_accounts'] = survey_df['Q-amazon-use-howmany'].apply(parse_hh)\n\n# Substance use\nsurvey_fe['uses_cigarettes'] = (survey_df['Q-substance-use-cigarettes'].str.lower() == 'yes').astype(int)\nsurvey_fe['uses_marijuana'] = (survey_df['Q-substance-use-marijuana'].str.lower() == 'yes').astype(int)\nsurvey_fe['uses_alcohol'] = (survey_df['Q-substance-use-alcohol'].str.lower() == 'yes').astype(int)\n\n# Health\nsurvey_fe['has_diabetes'] = (survey_df['Q-personal-diabetes'].str.lower() == 'yes').astype(int)\nsurvey_fe['uses_wheelchair'] = (survey_df['Q-personal-wheelchair'].str.lower() == 'yes').astype(int)\n\n# State regions\nnortheast = ['CT','ME','MA','NH','RI','VT','NJ','NY','PA']\nmidwest = ['IL','IN','MI','OH','WI','IA','KS','MN','MO','NE','ND','SD']\nsouth = ['DE','FL','GA','MD','NC','SC','VA','WV','AL','KY','MS','TN','AR','LA','OK','TX']\nwest = ['AZ','CO','ID','MT','NV','NM','UT','WY','AK','CA','HI','OR','WA']\n\nsurvey_fe['region_northeast'] = survey_df['Q-demos-state'].isin(northeast).astype(int)\nsurvey_fe['region_midwest'] = survey_df['Q-demos-state'].isin(midwest).astype(int)\nsurvey_fe['region_south'] = survey_df['Q-demos-state'].isin(south).astype(int)\nsurvey_fe['region_west'] = survey_df['Q-demos-state'].isin(west).astype(int)\n\nprint(f\"Final feature engineered shape: {survey_fe.shape}\")\nsurvey_fe.to_csv('/app/output/survey_feature_engineered.csv', index=False)\nsurvey_fe.to_pickle('/app/output/survey_fe.pkl')\nprint(\"Saved: survey_feature_engineered.csv\")\nEOF\n"]
