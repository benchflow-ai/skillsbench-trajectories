[83.516112, "i", "cat > /app/analysis_part1.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"=\" * 60)\nprint(\"STEP 1: DATA CLEANING\")\nprint(\"=\" * 60)\n\n# Load data\nprint(\"Loading datasets...\")\nsurvey_df = pd.read_csv('/app/data/survey_dirty.csv')\npurchases_df = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')\n\nprint(f\"Survey data shape: {survey_df.shape}\")\nprint(f\"Purchase data shape: {purchases_df.shape}\")\n\n# ============ CLEAN SURVEY DATA ============\nprint(\"\\nCleaning survey data...\")\nprint(f\"Survey duplicates before: {survey_df.duplicated().sum()}\")\nprint(f\"Survey ResponseID duplicates: {survey_df['Survey ResponseID'].duplicated().sum()}\")\n\nsurvey_df = survey_df.drop_duplicates()\nsurvey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'], keep='first')\nsurvey_df.columns = survey_df.columns.str.strip()\n\nfor col in survey_df.columns:\n    if col != 'Survey ResponseID':\n        if survey_df[col].dtype == 'object':\n            survey_df[col] = survey_df[col].str.strip() if survey_df[col].dtype == 'object' else survey_df[col]\n            survey_df[col] = survey_df[col].fillna('Unknown')\n        else:\n            survey_df[col] = survey_df[col].fillna(survey_df[col].median())\n\nsurvey_df = survey_df.dropna(subset=['Survey ResponseID'])\nprint(f\"Survey data after cleaning: {survey_df.shape}\")\nsurvey_df.to_csv('/app/output/survey_cleaned.csv', index=False)\nprint(\"Saved: survey_cleaned.csv\")\nEOF\n"]
