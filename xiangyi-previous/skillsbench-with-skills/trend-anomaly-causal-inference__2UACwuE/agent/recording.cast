[195.597011, "o", "baseline_start = pd.Timestamp('2020-01-01')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.597095, "o", "baseline_end = pd.Timestamp('2020-02-29')\r\n\u001b[?2004l\r\u001b[?2004h> "]
