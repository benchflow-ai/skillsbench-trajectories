[130.190363, "i", "cat > /app/analysis_part2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"=\" * 60)\nprint(\"STEP 2: ANOMALY DETECTION\")\nprint(\"=\" * 60)\n\n# Load cleaned data\nsurvey_df = pd.read_pickle('/app/output/survey_clean.pkl')\npurchases_df = pd.read_pickle('/app/output/purchases_clean.pkl')\n\n# Define time periods\ntreatment_start = pd.Timestamp('2020-03-01')\ntreatment_end = pd.Timestamp('2020-03-31')\n\nprint(f\"Treatment period: {treatment_start.date()} to {treatment_end.date()}\")\n\n# Create daily sales by category\npurchases_df['Date'] = purchases_df['Order Date'].dt.date\ndaily_cat = purchases_df.groupby(['Date', 'Category']).agg(\n    Daily_Sales=('Total_Spend', 'sum'),\n    Unique_Customers=('Survey ResponseID', 'nunique')\n).reset_index()\ndaily_cat['Date'] = pd.to_datetime(daily_cat['Date'])\n\ncategories = purchases_df['Category'].unique()\nprint(f\"Total categories: {len(categories)}\")\n\nanomaly_results = []\nfor category in categories:\n    cat_data = daily_cat[daily_cat['Category'] == category].copy()\n    if len(cat_data) < 10:\n        continue\n    \n    historical = cat_data[cat_data['Date'] < treatment_start]\n    treatment = cat_data[(cat_data['Date'] >= treatment_start) & (cat_data['Date'] <= treatment_end)]\n    \n    if len(historical) < 5 or len(treatment) < 1:\n        continue\n    \n    hist_mean = historical['Daily_Sales'].mean()\n    hist_std = historical['Daily_Sales'].std()\n    if hist_std == 0 or np.isnan(hist_std):\n        hist_std = hist_mean * 0.1 if hist_mean > 0 else 1\n    \n    treatment_mean = treatment['Daily_Sales'].mean()\n    z_score = (treatment_mean - hist_mean) / hist_std if hist_std > 0 else 0\n    anomaly_index = np.tanh(z_score / 3) * 100\n    \n    anomaly_results.append({\n        'Category': category,\n        'Anomaly_Index': round(anomaly_index, 2),\n        'Historical_Mean': hist_mean,\n        'Treatment_Mean': treatment_mean,\n        'Z_Score': z_score\n    })\n\nanomaly_df = pd.DataFrame(anomaly_results)\nanomaly_df = anomaly_df.sort_values('Anomaly_Index', ascending=False)\nprint(f\"Categories with anomaly scores: {len(anomaly_df)}\")\nprint(\"\\nTop 10 SURGE:\")\nprint(anomaly_df.head(10)[['Category', 'Anomaly_Index']])\nprint(\"\\nTop 10 SLUMP:\")\nprint(anomaly_df.tail(10)[['Category', 'Anomaly_Index']])\n\nanomaly_df[['Category', 'Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)\nprint(\"\\nSaved: category_anomaly_index.csv\")\nanomaly_df.to_pickle('/app/output/anomaly_df.pkl')\nEOF\n"]
