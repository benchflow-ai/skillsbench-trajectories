[195.594533, "i", "cat > /app/analysis_part4.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"=\" * 60)\nprint(\"STEP 4: PREPARE AGGREGATED DATA FOR DID\")\nprint(\"=\" * 60)\n\n# Load data\npurchases_df = pd.read_pickle('/app/output/purchases_clean.pkl')\nsurvey_fe = pd.read_pickle('/app/output/survey_fe.pkl')\nanomaly_df = pd.read_pickle('/app/output/anomaly_df.pkl')\n\n# Get top 10 surge and slump categories\nsurge_cats = anomaly_df.head(10)['Category'].tolist()\nslump_cats = anomaly_df.tail(10)['Category'].tolist()\nselected_cats = surge_cats + slump_cats\nprint(f\"Surge categories: {surge_cats}\")\nprint(f\"Slump categories: {slump_cats}\")\n\n# Define periods\nbaseline_start = pd.Timestamp('2020-01-01')\nbaseline_end = pd.Timestamp('2020-02-29')\ntreatment_start = pd.Timestamp('2020-03-01')\ntreatment_end = pd.Timestamp('2020-03-31')\n\n# Filter purchases to selected categories and periods\nmask = (purchases_df['Category'].isin(selected_cats)) & \\\n       (purchases_df['Order Date'] >= baseline_start) & \\\n       (purchases_df['Order Date'] <= treatment_end)\npurchases_filtered = purchases_df[mask].copy()\n\n# Add period indicator\npurchases_filtered['Period'] = np.where(\n    purchases_filtered['Order Date'] < treatment_start, 'Baseline', 'Treatment'\n)\n\nprint(f\"Filtered purchases: {len(purchases_filtered)}\")\nEOF\n"]
[195.594853, "o", "cat > /app/analysis_part4.py << 'EOF'\r\n\u001b[?2004l\r"]
