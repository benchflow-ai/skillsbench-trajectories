[195.596587, "o", "print(f\"Surge categories: {surge_cats}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.596641, "o", "print(f\"Slump categories: {slump_cats}\")\r\n\u001b[?2004l\r"]
