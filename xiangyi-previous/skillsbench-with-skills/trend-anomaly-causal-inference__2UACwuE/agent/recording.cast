[266.612726, "i", "cat >> /app/analysis_part5.py << 'EOF'\n\n# Analyze surge categories\nprint(\"\\nAnalyzing surge categories...\")\nsurge_results = []\nfor cat in surge_cats:\n    print(f\"  Processing: {cat}\")\n    result = analyze_category(cat, intensive, extensive, survey_fe, feature_cols, anomaly_df, purchases_df, baseline_start, baseline_end, treatment_start, treatment_end)\n    \n    # Sort by did_estimate descending for surge (largest positive effects)\n    int_sorted = sorted(result['intensive_results'], key=lambda x: x['did_estimate'], reverse=True)[:3]\n    ext_sorted = sorted(result['extensive_results'], key=lambda x: x['did_estimate'], reverse=True)[:3]\n    \n    surge_results.append({\n        'category': result['category'],\n        'anomaly_index': result['anomaly_index'],\n        'baseline_avg_spend': result['baseline_avg_spend'],\n        'treatment_avg_spend': result['treatment_avg_spend'],\n        'n_purchasers_baseline': result['n_purchasers_baseline'],\n        'n_purchasers_treatment': result['n_purchasers_treatment'],\n        'baseline_purchase_rate': result['baseline_purchase_rate'],\n        'treatment_purchase_rate': result['treatment_purchase_rate'],\n        'n_at_risk': result['n_at_risk'],\n        'intensive_margin': int_sorted,\n        'extensive_margin': ext_sorted\n    })\n\nprint(\"\\nAnalyzing slump categories...\")\nslump_results = []\nfor cat in slump_cats:\n    print(f\"  Processing: {cat}\")\n    result = analyze_category(cat, intensive, extensive, survey_fe, feature_cols, anomaly_df, purchases_df, baseline_start, baseline_end, treatment_start, treatment_end)\n    \n    # Sort by did_estimate ascending for slump (largest negative effects)\n    int_sorted = sorted(result['intensive_results'], key=lambda x: x['did_estimate'], reverse=False)[:3]\n    ext_sorted = sorted(result['extensive_results'], key=lambda x: x['did_estimate'], reverse=False)[:3]\n    \n    slump_results.append({\n        'category': result['category'],\n        'anomaly_index': result['anomaly_index'],\n        'baseline_avg_spend': result['baseline_avg_spend'],\n        'treatment_avg_spend': result['treatment_avg_spend'],\n        'n_purchasers_baseline': result['n_purchasers_baseline'],\n        'n_purchasers_treatment': result['n_purchasers_treatment'],\n        'baseline_purchase_rate': result['baseline_purchase_rate'],\n        'treatment_purchase_rate': result['treatment_purchase_rate'],\n        'n_at_risk': result['n_at_risk'],\n        'intensive_margin': int_sorted,\n        'extensive_margin': ext_sorted\n    })\nEOF\n"]
