[84.041029, "i", "cat >> /app/analysis_part1.py << 'EOF'\n\n# ============ CLEAN PURCHASE DATA ============\nprint(\"\\nCleaning purchase data...\")\nprint(f\"Purchase duplicates before: {purchases_df.duplicated().sum()}\")\n\npurchases_df = purchases_df.drop_duplicates()\npurchases_df.columns = purchases_df.columns.str.strip()\npurchases_df['Order Date'] = pd.to_datetime(purchases_df['Order Date'], errors='coerce')\npurchases_df = purchases_df.dropna(subset=['Order Date'])\npurchases_df['Purchase Price Per Unit'] = pd.to_numeric(purchases_df['Purchase Price Per Unit'], errors='coerce')\npurchases_df['Quantity'] = pd.to_numeric(purchases_df['Quantity'], errors='coerce')\npurchases_df['Quantity'] = purchases_df['Quantity'].fillna(1)\n\npurchases_df = purchases_df.dropna(subset=['Category'])\npurchases_df = purchases_df[purchases_df['Category'].str.strip() != '']\npurchases_df = purchases_df.dropna(subset=['Survey ResponseID'])\npurchases_df = purchases_df.dropna(subset=['Purchase Price Per Unit'])\npurchases_df = purchases_df[purchases_df['Purchase Price Per Unit'] > 0]\n\nfor col in ['Category', 'Survey ResponseID', 'Title', 'Shipping Address State']:\n    if col in purchases_df.columns:\n        purchases_df[col] = purchases_df[col].astype(str).str.strip()\n\npurchases_df['Total_Spend'] = purchases_df['Purchase Price Per Unit'] * purchases_df['Quantity']\n\nvalid_users = set(survey_df['Survey ResponseID'].unique())\npurchases_df = purchases_df[purchases_df['Survey ResponseID'].isin(valid_users)]\n\nprint(f\"Purchase data after cleaning: {purchases_df.shape}\")\npurchases_df.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)\nprint(\"Saved: amazon-purchases-2019-2020-filtered.csv\")\n\n# Save for next steps\nsurvey_df.to_pickle('/app/output/survey_clean.pkl')\npurchases_df.to_pickle('/app/output/purchases_clean.pkl')\nprint(\"Data cleaning complete!\")\nEOF\n"]
