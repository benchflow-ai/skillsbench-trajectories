[444.416924, "o", "ARB-LLM: A LTERNATING R EFINED B INARIZATIONS\r\nFOR L ARGE L ANGUAGE M ODELS\r\n\r\n"]
[444.42241, "o", "A BSTRACT\r\nLarge Language Models (LLMs) have greatly pushed forward advancements in\r\nnatural language processing, yet their high memory and computational demands\r\nhinder practical deployment. Binarization, as an effective compression technique,\r\ncan shrink model weights to just 1 bit, significantly reducing the high demands\r\non computation and memory. However, current binarization methods struggle to\r\nnarrow the distribution gap between binarized and full-precision weights, while\r\n"]
