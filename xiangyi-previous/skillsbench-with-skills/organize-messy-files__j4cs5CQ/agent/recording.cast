[308.37113, "i", "cat << 'EOF' > check_music.py\nimport zipfile\nimport os\n\nfiles = [\n    'trapped_ion_and_qc/paper_file_1.docx',\n    'LLM/paper_file_2.docx'\n]\n\nmusic_keywords = ['music', 'composer', 'symphony', 'jazz', 'baroque', 'classical', 'opera', 'concerto', 'sonata', 'musical', 'beethoven', 'mozart', 'bach']\n\nfor filepath in files:\n    if not os.path.exists(filepath):\n        print(f\"{filepath} not found\")\n        continue\n        \n    try:\n        with zipfile.ZipFile(filepath, 'r') as z:\n            content = \"\"\n            for name in z.namelist():\n                if name.endswith('.xml'):\n                    content += z.read(name).decode('utf-8', errors='ignore')\n            \n            content_lower = content.lower()\n            found = []\n            for kw in music_keywords:\n                if kw in content_lower:\n                    found.append(kw)\n            \n            if found:\n                print(f\"Music keywords found in {filepath}: {found}\")\n                # Print a snippet context\n                idx = content_lower.find(found[0])\n                start = max(0, idx - 50)\n                end = min(len(content_lower), idx + 50)\n                print(f\"Context: ...{content_lower[start:end]}...\")\n            else:\n                print(f\"No music keywords in {filepath}\")\n    except Exception as e:\n        print(f\"Error: {e}\")\nEOF\npython3 check_music.py\n"]
