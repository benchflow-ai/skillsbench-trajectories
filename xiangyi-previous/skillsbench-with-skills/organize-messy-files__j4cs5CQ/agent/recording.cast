[272.609997, "i", "cat << 'EOF' > inspect_files.py\nimport zipfile\nimport os\nimport shutil\n\nfiles_to_check = [\n    ('LLM/DAMOP.pptx', 'trapped_ion_and_qc', ['trapped ion', 'quantum computing', 'qubit', 'entanglement', 'ion trap']),\n    ('music_history/paper_file_1.docx', 'LLM', ['LLM', 'Large Language Model', 'GPT']),\n    ('music_history/paper_file_1.docx', 'trapped_ion_and_qc', ['quantum', 'qubit']),\n    ('music_history/paper_file_1.docx', 'black_hole', ['black hole']),\n    ('music_history/paper_file_1.docx', 'DNA', ['DNA', 'gene']),\n    ('music_history/paper_file_2.docx', 'LLM', ['LLM', 'Large Language Model', 'GPT']),\n    ('music_history/paper_file_2.docx', 'trapped_ion_and_qc', ['quantum', 'qubit']),\n    ('music_history/paper_file_2.docx', 'black_hole', ['black hole']),\n    ('music_history/paper_file_2.docx', 'DNA', ['DNA', 'gene'])\n]\n\nfor filepath, target_folder, keywords in files_to_check:\n    if not os.path.exists(filepath):\n        continue\n        \n    try:\n        with zipfile.ZipFile(filepath, 'r') as z:\n            content = \"\"\n            for name in z.namelist():\n                # for docx, text is in word/document.xml, for pptx in ppt/slides/slide*.xml\n                if name.endswith('.xml'):\n                    content += z.read(name).decode('utf-8', errors='ignore')\n            \n            content_lower = content.lower()\n            for keyword in keywords:\n                if keyword.lower() in content_lower:\n                    print(f\"Found '{keyword}' in {filepath}. Moving to {target_folder}.\")\n                    shutil.move(filepath, os.path.join(target_folder, os.path.basename(filepath)))\n                    break\n    except Exception as e:\n        print(f\"Error reading {filepath}: {e}\")\nEOF\npython3 inspect_files.py\n"]
