[?2004hroot@77f4c8b2a471:~# cat << 'EOF' > organize.py
[?2004l[?2004h> import os
[?2004l[?2004h> import shutil
[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> source_dir = 'papers/all'
[?2004l[?2004h> target_dirs = {
[?2004l[?2004h>     'LLM': ['LLM', 'Large Language Model', 'GPT', 'Transformer', 'Generative AI', 'attention mechanism', 'neural network'],
[?2004l[?2004h>     'trapped_ion_and_qc': ['trapped ion', 'quantum computing', 'qubit', 'entanglement', 'ion trap', 'quantum state', 'superconducting', 'quantum gate', 'fidelity'],
[?2004l[?2004h>     'black_hole': ['black hole', 'event horizon', 'singularity', 'accretion disk', 'Hawking radiation', 'gravitational wave', 'general relativity', 'spacetime'],
[?2004l[?2004h>     'DNA': ['DNA', 'gene', 'genome', 'nucleotide', 'sequencing', 'CRISPR', 'genetic', 'chromosome', 'protein', 'biology'],
[?2004l[?2004h>     'music_history': ['music', 'composer', 'symphony', 'jazz', 'baroque', 'classical', 'opera', 'concerto', 'sonata', 'musical', 'beethoven', 'mozart', 'bach']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> fallback_dir = 'music_history'
[?2004l[?2004h> 
[?2004l[?2004h> files = os.listdir(source_dir)
[?2004l[?2004h> 
[?2004l[?2004h> for filename in files:
[?2004l[?2004h>     filepath = os.path.join(source_dir, filename)
[?2004l[?2004h>     content = ""
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         if filename.lower().endswith('.pdf'):
[?2004l[?2004h>             # Use pdftotext for PDFs
[?2004l[?2004h>             result = subprocess.run(['pdftotext', filepath, '-'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors='ignore')
[?2004l[?2004h>             content = result.stdout
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Use strings-like approach for others (docx, pptx are zips, but strings usually finds text)
[?2004l[?2004h>             # Reading as binary and decoding ignoring errors is effectively similar to strings for python
[?2004l[?2004h>             with open(filepath, 'rb') as f:
[?2004l[?2004h>                 content = f.read().decode('utf-8', errors='ignore')
[?2004l[?2004h>                 # Also try latin-1 if utf-8 yields little, but ignore is usually enough to find keywords
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error reading {filename}: {e}")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     content_lower = content.lower()
[?2004l[?2004h>     moved = False
[?2004l[?2004h>     
[?2004l[?2004h>     # Check categories
[?2004l[?2004h>     for category, keywords in target_dirs.items():
[?2004l[?2004h>         for keyword in keywords:
[?2004l[?2004h>             if keyword.lower() in content_lower:
[?2004l[?2004h>                 shutil.move(filepath, os.path.join(category, filename))
[?2004l[?2004h>                 print(f"Moved {filename} to {category}")
[?2004l[?2004h>                 moved = True
[?2004l[?2004h>                 break
[?2004l[?2004h>         if moved:
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>     if not moved:
[?2004l[?2004h>         # Move to fallback if no keywords found (as per instruction: "if a file does not fit into any other 4 folders, it should fit into the last one")
[?2004l[?2004h>         # However, the prompt says "fit into the last one" which is music_history.
[?2004l[?2004h>         # But wait, it says "if a file does not fit into any other 4 folders". 
[?2004l[?2004h>         # This implies I should try to match the specific 4 first. 
[?2004l[?2004h>         # Actually, let's be careful. If it matches music keywords, it goes to music.
[?2004l[?2004h>         # If it matches NOTHING, it goes to music.
[?2004l[?2004h>         shutil.move(filepath, os.path.join(fallback_dir, filename))
[?2004l[?2004h>         print(f"Moved {filename} to {fallback_dir} (fallback)")
[?2004l[?2004h> 
