[70.136911, "o", "\u001b[?2004hroot@6e96fd0dedf0:~# "]
[100.4111, "i", "cat > tts_convert.py << 'EOF'\nimport os\nfrom bs4 import BeautifulSoup\nfrom openai import OpenAI\nfrom pydub import AudioSegment\nimport tempfile\n\n# Initialize OpenAI client\nclient = OpenAI(api_key=os.environ.get('OPENAI_API_KEY'))\n\ndef extract_text_from_html(filepath):\n    \"\"\"Extract readable text from Paul Graham's essay HTML.\"\"\"\n    with open(filepath, 'r', encoding='utf-8') as f:\n        html = f.read()\n    \n    soup = BeautifulSoup(html, 'html.parser')\n    \n    # Remove script and style elements\n    for script in soup([\"script\", \"style\", \"map\", \"area\"]):\n        script.decompose()\n    \n    # Get text from the main content\n    # Paul Graham's essays are in a table with font tags\n    text = soup.get_text(separator=' ', strip=True)\n    \n    # Clean up the text\n    lines = [line.strip() for line in text.split('\\n') if line.strip()]\n    text = ' '.join(lines)\n    \n    # Remove navigation and other non-content text\n    # Find the actual essay content (usually starts after the title)\n    return text\n\ndef chunk_text(text, max_chars=4000):\n    \"\"\"Split text into chunks that fit within TTS limits.\"\"\"\n    words = text.split()\n    chunks = []\n    current_chunk = []\n    current_length = 0\n    \n    for word in words:\n        if current_length + len(word) + 1 > max_chars:\n            chunks.append(' '.join(current_chunk))\n            current_chunk = [word]\n            current_length = len(word)\n        else:\n            current_chunk.append(word)\n            current_length += len(word) + 1\n    \n    if current_chunk:\n        chunks.append(' '.join(current_chunk))\n    \n    return chunks\n\ndef text_to_speech(text, output_path):\n    \"\"\"Convert text to speech using OpenAI TTS.\"\"\"\n    response = client.audio.speech.create(\n        model=\"tts-1\",\n        voice=\"alloy\",\n        input=text\n    )\n    response.stream_to_file(output_path)\n\ndef main():\n    essays = [\n        ('ds.html', 'Do Things that Don\\'t Scale'),\n        ('foundermode.html', 'Founder Mode')\n    ]\n    \n    audio_segments = []\n    \n    for html_file, title in essays:\n        print(f\"Processing: {title}\")\n        \n        # Extract text\n        text = extract_text_from_html(html_file)\n        print(f\"  Extracted {len(text)} characters\")\n        \n        # Add title announcement\n        intro_text = f\"Essay: {title}. \"\n        full_text = intro_text + text\n        \n        # Chunk the text\n        chunks = chunk_text(full_text)\n        print(f\"  Split into {len(chunks)} chunks\")\n        \n        # Convert each chunk to audio\n        for i, chunk in enumerate(chunks):\n            print(f\"  Converting chunk {i+1}/{len(chunks)}...\")\n            temp_file = f\"/tmp/chunk_{html_file}_{i}.mp3\"\n            text_to_speech(chunk, temp_file)\n            audio_segments.append(AudioSegment.from_mp3(temp_file))\n    \n    # Combine all segments\n    print(\"Combining audio segments...\")\n    combined = audio_segments[0]\n    for segment in audio_segments[1:]:\n        # Add a small pause between chunks\n        combined += AudioSegment.silent(duration=500) + segment\n    \n    # Export final audiobook\n    print(\"Exporting to /root/audiobook.mp3...\")\n    combined.export(\"/root/audiobook.mp3\", format=\"mp3\")\n    print(\"Done!\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[100.412871, "o", "cat > tts_convert.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> from bs4 import BeautifulSoup\r\n\u001b[?2004l\r\u001b[?2004h> from openai import OpenAI\r\n\u001b[?2004l\r\u001b[?2004h> from pydub import AudioSegment\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Initialize OpenAI client\r\n\u001b[?2004l\r\u001b[?2004h> client = OpenAI(api_key=os.environ.get('OPENAI_API_KEY'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_text_from_html(filepath):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract readable text from Paul Graham's essay HTML.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     with open(filepath, 'r', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         html = f.read()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     soup = BeautifulSoup(html, 'html.parser')\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[100.412955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Remove script and style elements"]
[100.413029, "o", "\r\n"]
