[100.414181, "o", "\u001b[?2004h"]
[100.414308, "o", "> "]
[100.414362, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.414409, "o", "    # Get text from the main content\r\n\u001b[?2004l\r"]
[100.414446, "o", "\u001b[?2004h> "]
[100.414755, "o", "    # Paul Graham's essays are in a table with font tags\r\n\u001b[?2004l\r\u001b[?2004h>     text = soup.get_text(separator=' ', strip=True)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.414896, "o", "    # Clean up the text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415018, "o", "    lines = [line.strip() for line in text.split('\\n') if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415138, "o", "    text = ' '.join(lines)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[100.415176, "o", "\u001b[?2004h> "]
[100.415274, "o", "    # Remove navigation and other non-content text\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.415338, "o", "> "]
[100.415528, "o", "    # Find the actual essay content (usually starts after the title)\r\n\u001b[?2004l\r\u001b[?2004h>     return text\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415642, "o", "def chunk_text(text, max_chars=4000):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415761, "o", "    \"\"\"Split text into chunks that fit within TTS limits.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.415795, "o", "> "]
[100.415829, "o", "    words = text.split()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.41593, "o", "    chunks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.415979, "o", "    current_chunk = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.416026, "o", "    current_length = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.416076, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.416123, "o", ">     for word in words:\r\n\u001b[?2004l\r"]
[100.416163, "o", "\u001b[?2004h> "]
[100.41748, "o", "        if current_length + len(word) + 1 > max_chars:\r\n\u001b[?2004l\r\u001b[?2004h>             chunks.append(' '.join(current_chunk))\r\n\u001b[?2004l\r\u001b[?2004h>             current_chunk = [word]\r\n\u001b[?2004l\r\u001b[?2004h>             current_length = len(word)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             current_chunk.append(word)\r\n\u001b[?2004l\r\u001b[?2004h>             current_length += len(word) + 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if current_chunk:\r\n\u001b[?2004l\r\u001b[?2004h>         chunks.append(' '.join(current_chunk))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return chunks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def text_to_speech(text, output_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.417539, "o", "    \"\"\"Convert text to speech using OpenAI TTS.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421288, "o", "    response = client.audio.speech.create(\r\n\u001b[?2004l\r\u001b[?2004h>         model=\"tts-1\",\r\n\u001b[?2004l\r\u001b[?2004h>         voice=\"alloy\",\r\n\u001b[?2004l\r\u001b[?2004h>         input=text\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     response.stream_to_file(output_path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     essays = [\r\n\u001b[?2004l\r\u001b[?2004h>         ('ds.html', 'Do Things that Don\\'t Scale'),\r\n\u001b[?2004l\r\u001b[?2004h>         ('foundermode.html', 'Founder Mode')\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     audio_segments = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for html_file, title in essays:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Processing: {title}\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Extract text\r\n\u001b[?2004l\r\u001b[?2004h>         text = extract_text_from_html(html_file)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Extracted {len(text)} characters\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Add title announcement\r\n\u001b[?2004l\r\u001b[?2004h>         intro_text = f\"Essay: {title}. \"\r\n\u001b[?2004l\r\u001b[?2004h>         full_text = intro_text + text\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Chunk the text\r\n\u001b[?2004l\r\u001b[?2004h>         chunks = chunk_text(full_text)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Split into {len(chunks)} chunks\")\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Convert each chunk to audio\r\n\u001b[?2004l\r\u001b[?2004h>         for i, chunk in enumerate(chunks):\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"  Converting chunk {i+1}/{len(chunks)}...\")\r\n\u001b[?2004l\r\u001b[?2004h>             temp_file = f\"/tmp/chunk_{html_file}_{i}.mp3\"\r\n\u001b[?2004l\r\u001b[?2004h>             text_to_speech(chunk, temp_file)\r\n\u001b[?2004l\r\u001b[?2004h>             audio_segments.append(AudioSegment.from_mp3(temp_file))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Combine all segments\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Combining audio segments...\")\r\n\u001b[?2004l\r\u001b[?2004h>     combined = audio_segments[0]\r\n\u001b[?2004l\r\u001b[?2004h>     for segment in audio_segments[1:]:\r\n\u001b[?2004l\r\u001b[?2004h>         # Add a small pause between chunks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421333, "o", "        combined += AudioSegment.silent(duration=500) + segment\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421481, "o", "    # Export final audiobook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421545, "o", "    print(\"Exporting to /root/audiobook.mp3...\")\r\n\u001b[?2004l\r"]
[100.421639, "o", "\u001b[?2004h> "]
[100.421736, "o", "    combined.export(\"/root/audiobook.mp3\", format=\"mp3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421835, "o", "    print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.421863, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[100.421967, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[100.423543, "o", "\u001b[?2004hroot@6e96fd0dedf0:~# "]
