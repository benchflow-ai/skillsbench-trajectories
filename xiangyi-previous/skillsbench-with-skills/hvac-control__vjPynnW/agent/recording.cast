[166.822064, "o", "> "]
[166.822107, "o", "    params = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82216, "o", "        \"K\": float(round(K, 5)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.822199, "o", ">         \"tau\": float(round(tau, 3)),\r\n\u001b[?2004l\r"]
[166.822242, "o", "\u001b[?2004h> "]
[166.822286, "o", "        \"r_squared\": float(round(r2, 4)),\r\n\u001b[?2004l\r"]
[166.82233, "o", "\u001b[?2004h> "]
[166.822376, "o", "        \"fitting_error\": float(round(rmse, 5))\r\n\u001b[?2004l\r"]
[166.82242, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[166.822458, "o", "\u001b[?2004h> "]
[166.822492, "o", "    with open(\"estimated_params.json\", \"w\") as f:\r\n\u001b[?2004l\r"]
[166.82254, "o", "\u001b[?2004h> "]
[166.822577, "o", "        json.dump(params, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.822615, "o", "    return params\r\n\u001b[?2004l\r"]
[166.822638, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[166.822696, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[166.822743, "o", "> def tune_gains(params):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.822781, "o", "    K = params[\"K\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.822815, "o", "    tau = params[\"tau\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.822864, "o", "> "]
[166.822904, "o", "    lam = max(20.0, min(30.0, 0.7 * tau))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.822944, "o", "    if K <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.822992, "o", "> "]
[166.823029, "o", "        K = 0.1\r\n\u001b[?2004l\r\u001b[?2004h>     Kp = tau / (K * lam)\r\n\u001b[?2004l\r"]
[166.823077, "o", "\u001b[?2004h> "]
[166.823114, "o", "    Ki = 1.0 / (K * lam)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823158, "o", "    Kd = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823345, "o", "    gains = {\"Kp\": float(round(Kp, 4)), \"Ki\": float(round(Ki, 4)), \"Kd\": float(round(Kd, 4)), \"lambda\": float(round(lam, 3))}\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.823396, "o", "> "]
[166.823434, "o", "    with open(\"tuned_gains.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.82349, "o", "> "]
[166.823527, "o", "        json.dump(gains, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823575, "o", "    return gains\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[166.823611, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823657, "o", "def run_control(gains):\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.823691, "o", "> "]
[166.823731, "o", "    sim = HVACSimulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823775, "o", "    dt = sim.get_dt()\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.823816, "o", ">     setpoint = sim.get_setpoint()\r\n\u001b[?2004l\r"]
[166.823861, "o", "\u001b[?2004h> "]
[166.823898, "o", "    temp = sim.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.823944, "o", "    duration = 200.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.823991, "o", "> "]
[166.824029, "o", "    steps = int(duration / dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824081, "o", "    Kp, Ki, Kd = gains[\"Kp\"], gains[\"Ki\"], gains[\"Kd\"]\r\n\u001b[?2004l\r"]
[166.824127, "o", "\u001b[?2004h> "]
[166.824178, "o", "    integral = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824221, "o", "    prev_error = setpoint - temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824272, "o", "    data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824328, "o", "    for _ in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824395, "o", "        error = setpoint - temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824455, "o", "        integral += error * dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.824504, "o", "> "]
[166.824554, "o", "        derivative = (error - prev_error) / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824636, "o", "        u = Kp * error + Ki * integral + Kd * derivative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824753, "o", "        if u > 100.0:\r\n\u001b[?2004l\r\u001b[?2004h>             u = 100.0\r\n\u001b[?2004l\r"]
[166.824827, "o", "\u001b[?2004h>             if error > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824882, "o", "                integral -= error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.824957, "o", "        elif u < 0.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825014, "o", "            u = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825072, "o", "            if error < 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82513, "o", "                integral -= error * dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825186, "o", "        res = sim.step(u)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82524, "o", "        temp = res[\"temperature\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825298, "o", "        error_after = setpoint - temp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825359, "o", "        data.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825422, "o", "            \"time\": res[\"time\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825481, "o", "            \"temperature\": temp,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825563, "o", "            \"setpoint\": setpoint,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825653, "o", "            \"heater_power\": res[\"heater_power\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825722, "o", "            \"error\": round(error_after, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.82578, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825833, "o", "        prev_error = error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.825941, "o", "    log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": data}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826013, "o", "    with open(\"control_log.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.826072, "o", ">         json.dump(log, f, indent=2)\r\n\u001b[?2004l\r"]
[166.826155, "o", "\u001b[?2004h>     return log\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[166.826208, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[166.826265, "o", "def compute_metrics(control_log):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826319, "o", "    data = control_log[\"data\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826374, "o", "    times = [d[\"time\"] for d in data]\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.826423, "o", "> "]
[166.826476, "o", "    temps = [d[\"temperature\"] for d in data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826529, "o", "    setpoint = control_log[\"setpoint\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.82658, "o", ">     max_temp = max(temps)\r\n\u001b[?2004l\r"]
[166.826633, "o", "\u001b[?2004h> "]
[166.826697, "o", "    overshoot = max(0.0, (max_temp - setpoint) / setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.826754, "o", ">     T0 = temps[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826802, "o", "    step = setpoint - T0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.826854, "o", "    t10 = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82691, "o", "    t90 = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82696, "o", "    if step != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827038, "o", "        low = T0 + 0.1 * step\r\n\u001b[?2004l\r\u001b[?2004h>         high = T0 + 0.9 * step\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.827103, "o", "> "]
[166.827163, "o", "        for t, temp in zip(times, temps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827224, "o", "            if t10 is None and temp >= low:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827279, "o", "                t10 = t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827353, "o", "            if t10 is not None and temp >= high:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.827408, "o", ">                 t90 = t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827468, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.827522, "o", ">     if t10 is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827581, "o", "        t10 = times[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827636, "o", "    if t90 is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.82769, "o", "        t90 = times[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827749, "o", "    rise_time = max(0.0, t90 - t10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.827804, "o", ">     settling_time = times[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827862, "o", "    band = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.827922, "o", "    for i in range(len(temps)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828015, "o", "        if all(abs(t - setpoint) <= band for t in temps[i:]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828091, "o", "            settling_time = times[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828147, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828244, "o", "    dt = times[1] - times[0] if len(times) > 1 else 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828296, "o", "    n = max(1, int(10.0 / dt))\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.828349, "o", "> "]
[166.828414, "o", "    steady_state_error = abs(float(np.mean(temps[-n:])) - setpoint)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.82847, "o", ">     metrics = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828554, "o", "        \"rise_time\": float(round(rise_time, 3)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828648, "o", "        \"overshoot\": float(round(overshoot, 4)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.828742, "o", "        \"settling_time\": float(round(settling_time, 3)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.828793, "o", "> "]
[166.828859, "o", "        \"steady_state_error\": float(round(steady_state_error, 4)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.828917, "o", "> "]
[166.828975, "o", "        \"max_temp\": float(round(max_temp, 3))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829059, "o", "    with open(\"metrics.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829128, "o", "        json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829181, "o", "    return metrics\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[166.829229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829279, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829345, "o", "    cal_log, sim, heater_power = run_calibration()\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.829397, "o", "> "]
[166.829454, "o", "    params = estimate_params(cal_log, sim, heater_power)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.82951, "o", ">     gains = tune_gains(params)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.829572, "o", ">     control_log = run_control(gains)\r\n\u001b[?2004l\r"]
[166.829626, "o", "\u001b[?2004h> "]
[166.829685, "o", "    metrics = compute_metrics(control_log)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829813, "o", "    print(\"Calibration, estimation, tuning, and control completed.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829869, "o", "    print(\"Metrics:\", metrics)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[166.829919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.829968, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.830021, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[166.831242, "o", "\u001b[?2004hroot@a4fcae6ff416:~# "]
[166.953512, "i", "python3 hvac_task.py\n"]
[166.953737, "o", "python3 hvac_task.py\r\n\u001b[?2004l\r"]
[167.459104, "o", "Calibration, estimation, tuning, and control completed.\r\nMetrics: {'rise_time': 37.0, 'overshoot': 0.0127, 'settling_time': 40.5, 'steady_state_error': 0.0055, 'max_temp': 22.28}\r\n"]
[167.49024, "o", "\u001b[?2004hroot@a4fcae6ff416:~# "]
[170.865939, "i", "ls -1 *.json\n"]
[170.866166, "o", "ls -1 *.json\r\n\u001b[?2004l\r"]
[170.867699, "o", "calibration_log.json\r\ncontrol_log.json\r\nestimated_params.json\r\nmetrics.json\r\nroom_config.json\r\ntuned_gains.json\r\n\u001b[?2004hroot@a4fcae6ff416:~# "]
