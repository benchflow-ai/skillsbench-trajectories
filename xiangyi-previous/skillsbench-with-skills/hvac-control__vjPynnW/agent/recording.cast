[16.610263, "o", "cat room_config.json\r\n\u001b[?2004l\r"]
[16.61101, "o", "{\r\n  \"setpoint\": 22.0,\r\n  \"ambient_temp\": 18.0,\r\n  \"noise_std\": 0.1,\r\n  \"max_safe_temp\": 30.0,\r\n  \"min_safe_temp\": 10.0,\r\n  \"dt\": 0.5\r\n}\r\n"]
[16.611154, "o", "\u001b[?2004hroot@a4fcae6ff416:~# "]
[166.817371, "i", "cat <<'PY' > hvac_task.py\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\n\ndef run_calibration():\n    sim = HVACSimulator()\n    dt = sim.get_dt()\n    heater_power = 50.0\n    duration = 60.0\n    data = []\n    temp0 = sim.reset()\n    data.append({\"time\": 0.0, \"temperature\": round(temp0, 4), \"heater_power\": 0.0})\n    steps = int(duration / dt)\n    for _ in range(steps):\n        res = sim.step(heater_power)\n        data.append({\"time\": res[\"time\"], \"temperature\": res[\"temperature\"], \"heater_power\": res[\"heater_power\"]})\n    log = {\"phase\": \"calibration\", \"heater_power_test\": heater_power, \"data\": data}\n    with open(\"calibration_log.json\", \"w\") as f:\n        json.dump(log, f, indent=2)\n    return log, sim, heater_power\n\n\ndef estimate_params(cal_log, sim, heater_power):\n    temps = [d[\"temperature\"] for d in cal_log[\"data\"][1:]]  # exclude initial\n    dt = sim.get_dt()\n    T_ambient = sim.get_ambient_temp()\n    u = heater_power\n    T_k = np.array(temps[:-1])\n    T_k1 = np.array(temps[1:])\n    y = (T_k1 - T_k) / dt\n    a, b = np.polyfit(T_k, y, 1)\n    if a >= 0:\n        a = -1e-6\n    tau = -1.0 / a\n    K = (b * tau - T_ambient) / u\n    y_hat = a * T_k + b\n    ss_res = np.sum((y - y_hat) ** 2)\n    ss_tot = np.sum((y - np.mean(y)) ** 2)\n    r2 = 1 - ss_res / ss_tot if ss_tot > 0 else 1.0\n    rmse = float(np.sqrt(np.mean((y - y_hat) ** 2)))\n    params = {\n        \"K\": float(round(K, 5)),\n        \"tau\": float(round(tau, 3)),\n        \"r_squared\": float(round(r2, 4)),\n        \"fitting_error\": float(round(rmse, 5))\n    }\n    with open(\"estimated_params.json\", \"w\") as f:\n        json.dump(params, f, indent=2)\n    return params\n\n\ndef tune_gains(params):\n    K = params[\"K\"]\n    tau = params[\"tau\"]\n    lam = max(20.0, min(30.0, 0.7 * tau))\n    if K <= 0:\n        K = 0.1\n    Kp = tau / (K * lam)\n    Ki = 1.0 / (K * lam)\n    Kd = 0.0\n    gains = {\"Kp\": float(round(Kp, 4)), \"Ki\": float(round(Ki, 4)), \"Kd\": float(round(Kd, 4)), \"lambda\": float(round(lam, 3))}\n    with open(\"tuned_gains.json\", \"w\") as f:\n        json.dump(gains, f, indent=2)\n    return gains\n\n\ndef run_control(gains):\n    sim = HVACSimulator()\n    dt = sim.get_dt()\n    setpoint = sim.get_setpoint()\n    temp = sim.reset()\n    duration = 200.0\n    steps = int(duration / dt)\n    Kp, Ki, Kd = gains[\"Kp\"], gains[\"Ki\"], gains[\"Kd\"]\n    integral = 0.0\n    prev_error = setpoint - temp\n    data = []\n    for _ in range(steps):\n        error = setpoint - temp\n        integral += error * dt\n        derivative = (error - prev_error) / dt\n        u = Kp * error + Ki * integral + Kd * derivative\n        if u > 100.0:\n            u = 100.0\n            if error > 0:\n                integral -= error * dt\n        elif u < 0.0:\n            u = 0.0\n            if error < 0:\n                integral -= error * dt\n        res = sim.step(u)\n        temp = res[\"temperature\"]\n        error_after = setpoint - temp\n        data.append({\n            \"time\": res[\"time\"],\n            \"temperature\": temp,\n            \"setpoint\": setpoint,\n            \"heater_power\": res[\"heater_power\"],\n            \"error\": round(error_after, 4)\n        })\n        prev_error = error\n    log = {\"phase\": \"control\", \"setpoint\": setpoint, \"data\": data}\n    with open(\"control_log.json\", \"w\") as f:\n        json.dump(log, f, indent=2)\n    return log\n\n\ndef compute_metrics(control_log):\n    data = control_log[\"data\"]\n    times = [d[\"time\"] for d in data]\n    temps = [d[\"temperature\"] for d in data]\n    setpoint = control_log[\"setpoint\"]\n    max_temp = max(temps)\n    overshoot = max(0.0, (max_temp - setpoint) / setpoint)\n    T0 = temps[0]\n    step = setpoint - T0\n    t10 = None\n    t90 = None\n    if step != 0:\n        low = T0 + 0.1 * step\n        high = T0 + 0.9 * step\n        for t, temp in zip(times, temps):\n            if t10 is None and temp >= low:\n                t10 = t\n            if t10 is not None and temp >= high:\n                t90 = t\n                break\n    if t10 is None:\n        t10 = times[-1]\n    if t90 is None:\n        t90 = times[-1]\n    rise_time = max(0.0, t90"]
[166.81742, "i", " - t10)\n    settling_time = times[-1]\n    band = 0.5\n    for i in range(len(temps)):\n        if all(abs(t - setpoint) <= band for t in temps[i:]):\n            settling_time = times[i]\n            break\n    dt = times[1] - times[0] if len(times) > 1 else 0.5\n    n = max(1, int(10.0 / dt))\n    steady_state_error = abs(float(np.mean(temps[-n:])) - setpoint)\n    metrics = {\n        \"rise_time\": float(round(rise_time, 3)),\n        \"overshoot\": float(round(overshoot, 4)),\n        \"settling_time\": float(round(settling_time, 3)),\n        \"steady_state_error\": float(round(steady_state_error, 4)),\n        \"max_temp\": float(round(max_temp, 3))\n    }\n    with open(\"metrics.json\", \"w\") as f:\n        json.dump(metrics, f, indent=2)\n    return metrics\n\n\ndef main():\n    cal_log, sim, heater_power = run_calibration()\n    params = estimate_params(cal_log, sim, heater_power)\n    gains = tune_gains(params)\n    control_log = run_control(gains)\n    metrics = compute_metrics(control_log)\n    print(\"Calibration, estimation, tuning, and control completed.\")\n    print(\"Metrics:\", metrics)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\n"]
