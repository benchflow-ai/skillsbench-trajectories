[71.531481, "o", "  if (geometry.isBufferGeometry) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.531556, "o", "    // Clone geometry to avoid modifying original\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.531626, "o", "    const clonedGeometry = geometry.clone();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.531684, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.531705, "o", "> "]
[71.531773, "o", "    // Ensure position attribute exists\r\n\u001b[?2004l\r"]
[71.531804, "o", "\u001b[?2004h> "]
[71.531919, "o", "    if (!clonedGeometry.attributes.position) {\r\n\u001b[?2004l\r\u001b[?2004h>       continue;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.532002, "o", ">     // Apply transformation\r\n\u001b[?2004l\r"]
[71.532072, "o", "\u001b[?2004h> "]
[71.532137, "o", "    applyXRotation(clonedGeometry, mesh);\r\n\u001b[?2004l\r"]
[71.532286, "o", "\u001b[?2004h> "]
[71.532479, "o", "    geometries.push(clonedGeometry);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.532591, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.532631, "o", "// Manually merge all geometries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.532798, "o", "const positions = [];\r\n\u001b[?2004l\r"]
[71.532887, "o", "\u001b[?2004h> "]
[71.532983, "o", "const indices = [];\r\n\u001b[?2004l\r\u001b[?2004h> let vertexOffset = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.533054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> for (const geom of geometries) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.53322, "o", "  const pos = geom.attributes.position.array;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.533395, "o", "  const idx = geom.index ? geom.index.array : null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.533479, "o", ">   \r\n\u001b[?2004l\r"]
[71.533512, "o", "\u001b[?2004h>   // Add vertices\r\n"]
[71.533615, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.533661, "o", "  for (let i = 0; i < pos.length; i++) {\r\n\u001b[?2004l\r"]
[71.53375, "o", "\u001b[?2004h> "]
[71.533818, "o", "    positions.push(pos[i]);\r\n\u001b[?2004l\r"]
[71.533853, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.533982, "o", ">   \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.53404, "o", ">   // Add indices or create them\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.534147, "o", ">   if (idx) {\r\n\u001b[?2004l\r"]
[71.534185, "o", "\u001b[?2004h> "]
[71.534261, "o", "    for (let i = 0; i < idx.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.534437, "o", "      indices.push(idx[i] + vertexOffset);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[71.534522, "o", "\u001b[?2004h>   } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.534638, "o", "    for (let i = 0; i < pos.length / 3; i++) {\r\n\u001b[?2004l\r"]
[71.534743, "o", "\u001b[?2004h> "]
[71.534852, "o", "      indices.push(i + vertexOffset);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.534932, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.535018, "o", "  vertexOffset += pos.length / 3;\r\n\u001b[?2004l\r"]
[71.535093, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.535223, "o", "const mergedGeometry = new THREE.BufferGeometry();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.535514, "o", "mergedGeometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.535597, "o", "> "]
[71.535683, "o", "if (indices.length > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.53589, "o", "  mergedGeometry.setIndex(new THREE.BufferAttribute(new Uint32Array(indices), 1));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536008, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536051, "o", "// Export to OBJ format\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536149, "o", "function geometryToOBJ(geometry) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536311, "o", "  const positions = geometry.attributes.position.array;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536496, "o", "  const indices = geometry.index ? geometry.index.array : null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536561, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.536623, "o", "  let obj = '# Desk Globe\\n';\r\n\u001b[?2004l\r"]
[71.53671, "o", "\u001b[?2004h> "]
[71.536925, "o", "  obj += '# Converted from Three.js with -90 degree X-rotation for Blender Z-up\\n\\n';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537004, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537076, "o", "  // Write vertices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537167, "o", "  for (let i = 0; i < positions.length; i += 3) {\r\n\u001b[?2004l\r"]
[71.537239, "o", "\u001b[?2004h> "]
[71.537467, "o", "    obj += `v ${positions[i].toFixed(6)} ${positions[i + 1].toFixed(6)} ${positions[i + 2].toFixed(6)}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537537, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.537616, "o", ">   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537692, "o", "  obj += '\\n';\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n"]
[71.53777, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.537842, "o", "  // Write faces\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.537942, "o", "  if (indices) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.538024, "o", "    for (let i = 0; i < indices.length; i += 3) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.538099, "o", "> "]
[71.538173, "o", "      const a = indices[i] + 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.538243, "o", "      const b = indices[i + 1] + 1;\r\n\u001b[?2004l\r"]
[71.538305, "o", "\u001b[?2004h> "]
[71.538384, "o", "      const c = indices[i + 2] + 1;\r\n\u001b[?2004l\r"]
[71.538454, "o", "\u001b[?2004h> "]
[71.538541, "o", "      obj += `f ${a} ${b} ${c}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.5386, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.538659, "o", "  } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.538817, "o", "    // If no indices, create faces from vertices\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.538893, "o", "> "]
[71.53896, "o", "    const vertexCount = positions.length / 3;\r\n\u001b[?2004l\r"]
[71.539035, "o", "\u001b[?2004h> "]
[71.539124, "o", "    for (let i = 0; i < vertexCount; i += 3) {\r\n\u001b[?2004l\r"]
[71.539193, "o", "\u001b[?2004h> "]
[71.53926, "o", "      const a = i + 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.539335, "o", "      const b = i + 2;\r\n\u001b[?2004l\r"]
[71.539402, "o", "\u001b[?2004h> "]
[71.5395, "o", "      const c = i + 3;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.539577, "o", "      if (c <= vertexCount) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.539701, "o", "        obj += `f ${a} ${b} ${c}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.539796, "o", ">       }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.539867, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[71.539935, "o", "\u001b[?2004h>   return obj;\r\n\u001b[?2004l\r"]
[71.539999, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.540078, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.540154, "o", "> "]
[71.54024, "o", "const objContent = geometryToOBJ(mergedGeometry);\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.540311, "o", "> "]
[71.540394, "o", "fs.writeFileSync('/root/output/object.obj', objContent);\r\n\u001b[?2004l\r"]
[71.540461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.540657, "o", "console.log('Successfully exported to /root/output/object.obj');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.540908, "o", "console.log(`Total vertices: ${mergedGeometry.attributes.position.array.length / 3}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.540994, "o", "> "]
[71.541074, "o", "if (mergedGeometry.index) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.541244, "o", "  console.log(`Total faces: ${mergedGeometry.index.array.length / 3}`);\r\n\u001b[?2004l\r"]
[71.541344, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.541427, "o", "> EOF\r\n\u001b[?2004l\r"]
[71.543, "o", "\u001b[?2004hroot@8e58caf27b5e:~# "]
[74.56153, "i", "node convert.js\n"]
[74.561763, "o", "node convert.js\r\n\u001b[?2004l\r"]
[74.71397, "o", "Successfully exported to /root/output/object.obj\r\nTotal vertices: 4850\r\nTotal faces: 8108\r\n"]
[74.728781, "o", "\u001b[?2004hroot@8e58caf27b5e:~# "]
[82.044202, "i", "ls -lh /root/output/object.obj\n"]
[82.044499, "o", "ls -lh /root/output/object.obj\r\n\u001b[?2004l\r"]
[82.045952, "o", "-rw-r--r-- 1 root root 276K Jan 26 11:18 /root/output/object.obj\r\n"]
[82.046128, "o", "\u001b[?2004hroot@8e58caf27b5e:~# "]
