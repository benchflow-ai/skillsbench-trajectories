[92.610835, "o", "wc -l /root/output/object.obj && echo '---' && grep -c '^v ' /root/output/object.obj && echo 'vertices' && grep -c '^f ' /root/output/object.obj && echo 'faces'\r\n\u001b[?2004l\r"]
