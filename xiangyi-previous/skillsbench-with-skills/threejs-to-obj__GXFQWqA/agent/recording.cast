[84.757506, "o", "# Desk Globe\r\n# Converted from Three.js with -90 degree X-rotation for Blender Z-up\r\n\r\nv 0.000000 4.000000 -0.800000\r\nv 0.522105 3.965780 -0.800000\r\nv 1.035276 3.863703 -0.800000\r\nv 1.530734 3.695518 -0.800000\r\nv 2.000000 3.464102 -0.800000\r\nv 2.435046 3.173413 -0.800000\r\nv 2.828427 2.828427 -0.800000\r\nv 3.173413 2.435046 -0.800000\r\nv 3.464102 2.000000 -0.800000\r\nv 3.695518 1.530734 -0.800000\r\nv 3.863703 1.035276 -0.800000\r\nv 3.965780 0.522105 -0.800000\r\nv 4.000000 0.000000 -0.800000\r\nv 3.965780 -0.522105 -0.800000\r\nv 3.863703 -1.035276 -0.800000\r\nv 3.695518 -1.530734 -0.800000\r\nv 3.464102 -2.000000 -0.800000\r\n"]
