[905.732207, "o", "\u001b[?2004h> links=re.findall(r'href=\"([^\"]+)\"', html)\r\n\u001b[?2004l\r\u001b[?2004h> links=[l for l in links if 'pwt' in l.lower()]\r\n\u001b[?2004l\r\u001b[?2004h> print(links[:20])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
