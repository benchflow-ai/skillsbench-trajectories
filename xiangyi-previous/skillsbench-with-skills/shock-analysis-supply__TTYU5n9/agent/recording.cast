[103.0088, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('test-supply.xlsx', data_only=False)\nws=wb['CFC data']\n# print formulas in columns C-E for first few rows\nfor r in range(2,10):\n    vals = [ws.cell(r,c).value for c in range(1,6)]\n    print(r, vals)\n\nws=wb['Production']\nprint('Production row 5-8 formulas:')\nfor r in range(5,9):\n    vals=[ws.cell(r,c).value for c in range(1,16)]\n    print(r, vals)\n\n# check some cells in Production that may have formulas later\nfor r in range(36,40):\n    vals=[ws.cell(r,c).value for c in range(1,16)]\n    print(r, vals)\n\nPY\n"]
