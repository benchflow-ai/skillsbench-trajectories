[268.467664, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('test-supply.xlsx', data_only=False)\nws=wb['CFC data']\nprint('CFC data formulas in cols C-E (rows 2-10):')\nfor r in range(2,11):\n    print(r, [ws.cell(r,c).value for c in range(3,6)])\n\nws=wb['Production']\nprint('\\nProduction rows 25-75 (non-empty):')\nfor r in range(1,80):\n    row=[ws.cell(r,c).value for c in range(1,17)]\n    if any(v is not None for v in row):\n        if r>=25:\n            print(r, row)\nPY\n"]
