[?2004l[?2004h>     return float(h) * 3600 + float(m) * 60 + float(s)
[?2004l[?2004h> 
[?2004l[?2004h> def parse_segments(file_path):
[?2004l[?2004h>     with open(file_path, 'r', encoding='utf-8') as f:
[?2004l[?2004h>         content = f.read().strip()
[?2004l[?2004h>     segments = []
