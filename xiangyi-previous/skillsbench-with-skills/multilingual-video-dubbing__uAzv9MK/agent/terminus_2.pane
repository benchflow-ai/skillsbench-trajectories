[?2004l[?2004h>     for block in blocks:
[?2004l[?2004h>         lines = block.split('\n')
[?2004l[?2004h>         if len(lines) >= 2:
[?2004l[?2004h>             times = lines[1].split(' --> ')
[?2004l[?2004h>             start = get_time_seconds(times[0])
[?2004l[?2004h>             end = get_time_seconds(times[1])
[?2004l[?2004h>             segments.append((start, end))
[?2004l[?2004h>     return segments
[?2004l[?2004h> 
[?2004l[?2004h> def get_duration(file_path):
