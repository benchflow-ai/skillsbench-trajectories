[127.793701, "o", "  \"original_duration_sec\": video_duration,\r\n\u001b[?2004l\r\u001b[?2004h>   \"new_duration_sec\": new_video_duration,\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.793823, "o", ">   \"measured_lufs\": measured_lufs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.793934, "o", "  \"speech_segments\": [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.794039, "o", "      \"window_start_sec\": seg_start,\r\n\u001b[?2004l\r\u001b[?2004h>       \"window_end_sec\": seg_end,\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.79415, "o", ">       \"placed_start_sec\": seg_start,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.794258, "o", "      \"placed_end_sec\": seg_start + final_duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.794363, "o", "      \"source_text\": source_text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.79447, "o", "      \"target_text\": target_text,\r\n\u001b[?2004l\r\u001b[?2004h>       \"window_duration_sec\": target_duration,\r\n\u001b[?2004l\r"]
[127.794589, "o", "\u001b[?2004h>       \"tts_duration_sec\": final_duration,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.794696, "o", "      \"drift_sec\": abs((seg_start + final_duration) - seg_end),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.794804, "o", "      \"duration_control\": \"rate_adjust\"\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[127.794994, "o", "\u001b[?2004h>   ]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(report_path, \"w\") as f:\r\n\u001b[?2004l\r"]
[127.795114, "o", "\u001b[?2004h>     json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
