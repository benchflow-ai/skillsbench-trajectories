[50.57016, "o", "\u001b[?2004hroot@b2c334c3f798:~# "]
[127.77962, "i", "cat << 'EOF' > dubbing.py\nimport subprocess\nimport json\nimport os\n\ndef parse_srt_text(file_path):\n    with open(file_path, 'r', encoding='utf-8') as f:\n        lines = f.readlines()\n    text_lines = lines[2:]\n    return \"\".join([l.strip() + \" \" for l in text_lines]).strip()\n\ndef get_time_seconds(time_str):\n    h, m, s = time_str.replace(',', '.').split(':')\n    return float(h) * 3600 + float(m) * 60 + float(s)\n\ndef parse_segments(file_path):\n    with open(file_path, 'r', encoding='utf-8') as f:\n        content = f.read().strip()\n    segments = []\n    blocks = content.split('\\n\\n')\n    for block in blocks:\n        lines = block.split('\\n')\n        if len(lines) >= 2:\n            times = lines[1].split(' --> ')\n            start = get_time_seconds(times[0])\n            end = get_time_seconds(times[1])\n            segments.append((start, end))\n    return segments\n\ndef get_duration(file_path):\n    cmd = [\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\", \"-of\", \"default=noprint_wrappers=1:nokey=1\", file_path]\n    return float(subprocess.check_output(cmd).strip())\n\ndef get_lufs(file_path):\n    cmd = [\"ffmpeg\", \"-i\", file_path, \"-af\", \"loudnorm=I=-23:TP=-1.0:LRA=7.0:print_format=json\", \"-f\", \"null\", \"-\"]\n    result = subprocess.run(cmd, stderr=subprocess.PIPE, text=True)\n    lines = result.stderr.splitlines()\n    json_str = \"\"\n    in_json = False\n    for line in lines:\n        if line.strip() == \"{\":\n            in_json = True\n            json_str = \"{\"\n        elif in_json:\n            json_str += line\n            if line.strip() == \"}\":\n                in_json = False\n    if json_str:\n        try:\n            data = json.loads(json_str)\n            return float(data.get('input_i', -23.0))\n        except:\n            return -23.0\n    return -23.0\n\nsource_text_path = \"/root/source_text.srt\"\ntarget_text_path = \"/root/reference_target_text.srt\"\nsegments_path = \"/root/segments.srt\"\ninput_video = \"/root/input.mp4\"\noutput_audio = \"/outputs/tts_segments/seg_0.wav\"\noutput_video = \"/outputs/dubbed.mp4\"\nreport_path ="]
[127.780003, "i", " \"/outputs/report.json\"\n\ntarget_text = parse_srt_text(target_text_path)\nsource_text = parse_srt_text(source_text_path)\nsegments = parse_segments(segments_path)\nseg_start, seg_end = segments[0]\ntarget_duration = seg_end - seg_start\n\nsubprocess.run([\"edge-tts\", \"--voice\", \"ja-JP-NanamiNeural\", \"--text\", target_text, \"--write-media\", \"raw_tts.mp3\"], check=True)\n\nraw_duration = get_duration(\"raw_tts.mp3\")\nspeed_rate = raw_duration / target_duration\n\nfilter_complex = f\"atempo={speed_rate},loudnorm=I=-23:LRA=7:tp=-1.0,aresample=48000\"\ncmd_ffmpeg = [\"ffmpeg\", \"-y\", \"-i\", \"raw_tts.mp3\", \"-af\", filter_complex, \"-ac\", \"1\", output_audio]\nsubprocess.run(cmd_ffmpeg, check=True)\n\nfinal_duration = get_duration(output_audio)\nmeasured_lufs = get_lufs(output_audio)\n\ncmd_dub = [\"ffmpeg\", \"-y\", \"-i\", input_video, \"-i\", output_audio, \"-c:v\", \"copy\", \"-c:a\", \"aac\", \"-map\", \"0:v:0\", \"-map\", \"1:a:0\", \"-shortest\", output_video]\nsubprocess.run(cmd_dub, check=True)\n\nvideo_duration = get_duration(input_video)\nnew_video_duration = get_duration(output_video)\n\nreport = {\n  \"source_language\": \"en\",\n  \"target_language\": \"ja\",\n  \"audio_sample_rate_hz\": 48000,\n  \"audio_channels\": 1,\n  \"original_duration_sec\": video_duration,\n  \"new_duration_sec\": new_video_duration,\n  \"measured_lufs\": measured_lufs,\n  \"speech_segments\": [\n    {\n      \"window_start_sec\": seg_start,\n      \"window_end_sec\": seg_end,\n      \"placed_start_sec\": seg_start,\n      \"placed_end_sec\": seg_start + final_duration,\n      \"source_text\": source_text,\n      \"target_text\": target_text,\n      \"window_duration_sec\": target_duration,\n      \"tts_duration_sec\": final_duration,\n      \"drift_sec\": abs((seg_start + final_duration) - seg_end),\n      \"duration_control\": \"rate_adjust\"\n    }\n  ]\n}\n\nwith open(report_path, \"w\") as f:\n    json.dump(report, f, indent=2)\nEOF\n"]
