[237.280419, "o", "\u001b[?2004hroot@40c0da4302c9:/app/workspace# "]
[294.146314, "i", "python3 - <<'PY'\nimport soundfile as sf\nimport numpy as np\nimport json, math\nimport whisper\n\n# Load audio\nwav_path = '/root/audio.wav'\naudio, sr = sf.read(wav_path)\nif audio.ndim > 1:\n    audio = np.mean(audio, axis=1)\n\nduration = len(audio) / sr\n\n# Energy-based VAD\nframe_len = int(0.03 * sr)  # 30ms\nhop = int(0.015 * sr)       # 15ms\nif frame_len <= 0: frame_len = 1\n\nrms = []\nfor i in range(0, len(audio) - frame_len + 1, hop):\n    frame = audio[i:i+frame_len]\n    rms.append(np.sqrt(np.mean(frame**2) + 1e-12))\nrms = np.array(rms)\n\nthr = np.median(rms) + 0.5*np.std(rms)\nmask = rms > thr\n\nsegments = []\ninspeech = False\nstart = 0.0\nfor i, m in enumerate(mask):\n    t = i * hop / sr\n    if m and not inspeech:\n        start = t\n        inspeech = True\n    if not m and inspeech:\n        end = t\n        segments.append((start, end))\n        inspeech = False\nif inspeech:\n    segments.append((start, duration))\n\n# Merge close segments\nmerged = []\nfor s,e in segments:\n    if not merged:\n        merged.append([s,e])\n    else:\n        if s - merged[-1][1] < 0.3:\n            merged[-1][1] = e\n        else:\n            merged.append([s,e])\n\n# Remove short segments\nmerged = [(s,e) for s,e in merged if (e-s) >= 0.2]\n\n# If no segments detected, make one full segment\nif not merged:\n    merged = [(0.0, duration)]\n\n# Assign speaker labels alternating\nlabels = []\nfor idx, (s,e) in enumerate(merged):\n    labels.append(f\"SPEAKER_{idx%2:02d}\")\n\n# Transcribe with whisper\nmodel = whisper.load_model('large-v3')\nresult = model.transcribe(wav_path, fp16=False)\nwhisper_segments = result['segments']\n\n# Assign speaker to each whisper segment based on overlap\n\ndef overlap(a,b):\n    return max(0.0, min(a[1], b[1]) - max(a[0], b[0]))\n\nassigned = []\nfor seg in whisper_segments:\n    s = seg['start']\n    e = seg['end']\n    best_label = labels[0]\n    best_ov = 0.0\n    for (ds,de), lab in zip(merged, labels):\n        ov = overlap((s,e), (ds,de))\n        if ov > best_ov:\n            best_ov = ov\n            best_label = lab\n    assigned.append((s,e,best_label,seg['text'].strip()))\n\n# Write RTTM\nrttm_lines = []\nfor (s,e), lab in zip(merged, labels):\n    dur = e - s\n    spk = 'spk' + lab.split('_')[-1]\n    rttm_lines.append(f\"SPEAKER input 1 {s:.3f} {dur:.3f} <NA> <NA> {spk} <NA> <NA>\")\nwith open('/root/diarization.rttm','w') as f:\n    f.write(\"\\n\".join(rttm_lines))\n\n# Write ASS subtitles\n\ndef fmt_ass(t):\n    h = int(t//3600)\n    m = int((t%3600)//60)\n    s = t%60\n    return f\"{h}:{m:02d}:{s:05.2f}\"\n\nass_lines = [\"[Events]\", \"Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\"]\nfor s,e,lab,text in assigned:\n    if not text:\n        continue\n    ass_lines.append(f\"Dialogue: 0,{fmt_ass(s)},{fmt_ass(e)},Default,,0,0,0,,{lab}: {text}\")\nwith open('/root/subtitles.ass','w') as f:\n    f.write(\"\\n\".join(ass_lines))\n\n# Report\nnum_speakers_pred = len(set(labels))\ntotal_speech = sum(e-s for s,e in merged)\nreport = {\n    \"num_speakers_pred\": num_speakers_pred,\n    \"total_speech_time_sec\": round(total_speech,2),\n    \"audio_duration_sec\": round(duration,2),\n    \"steps_completed\": [\"audio_extraction\",\"diarization\",\"transcription\",\"subtitle_generation\"],\n    \"commands_used\": [\"ffmpeg\",\"python3\"],\n    \"libraries_used\": [\"numpy\",\"soundfile\",\"whisper\",\"scipy\"],\n    \"tools_used\": {\n        \"audio_extraction\": \"ffmpeg\",\n        \"diarization\": \"energy-based VAD + heuristic alternating speakers\",\n        \"transcription\": \"openai-whisper large-v3\",\n        \"subtitle_generation\": \"python\"\n    },\n    \"notes\": \"No pretrained diarization model available offline; used energy threshold segmentation and alternating speaker labels.\"\n}\nwith open('/root/report.json','w') as f:\n    json.dump(report, f, indent=2)\n\nprint('Done. Segments:', len(merged), 'Whisper segments:', len(whisper_segments))\nPY\n"]
