[710.06561, "o", "for idx, ((s,e), lab) in enumerate(zip(merged, labels)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.065698, "o", ">     text = f\"{lab}: [speech segment {idx+1}]\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.065782, "o", "> "]
[710.065864, "o", "    ass_lines.append(f\"Dialogue: 0,{fmt_ass(s)},{fmt_ass(e)},Default,,0,0,0,,{text}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.065948, "o", "with open('/root/subtitles.ass','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.066037, "o", "    f.write(\"\\n\".join(ass_lines))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Report"]
[710.066122, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> num_speakers_pred = len(set(labels))\r\n\u001b[?2004l\r"]
[710.066205, "o", "\u001b[?2004h> total_speech = sum(e-s for s,e in merged)\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.066289, "o", "> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.066373, "o", "    \"num_speakers_pred\": num_speakers_pred,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.066456, "o", "    \"total_speech_time_sec\": round(total_speech,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.06654, "o", "    \"audio_duration_sec\": round(duration,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.066654, "o", "    \"steps_completed\": [\"audio_extraction\",\"diarization\",\"subtitle_generation\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.066764, "o", "> "]
[710.06686, "o", "    \"commands_used\": [\"ffmpeg\",\"python3\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.066948, "o", "    \"libraries_used\": [\"numpy\",\"soundfile\",\"scipy\"],\r\n\u001b[?2004l\r\u001b[?2004h>     \"tools_used\": {\r\n\u001b[?2004l\r"]
[710.06704, "o", "\u001b[?2004h>         \"audio_extraction\": \"ffmpeg\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.067114, "o", "> "]
[710.067185, "o", "        \"diarization\": \"energy-based VAD + heuristic alternating speakers\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.067256, "o", "        \"subtitle_generation\": \"python\"\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[710.067329, "o", "\u001b[?2004h> "]
[710.067455, "o", "    \"notes\": \"Whisper ASR could not complete due to resource limits; subtitles contain placeholder text for each detected speech segment.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.067532, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.067606, "o", "with open('/root/report.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.067677, "o", ">     json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[710.067747, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[710.067817, "o", "print('Generated files. Segments:', len(merged))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
