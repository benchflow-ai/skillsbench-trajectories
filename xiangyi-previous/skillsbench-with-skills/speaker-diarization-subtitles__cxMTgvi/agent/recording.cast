[371.961994, "o", "> "]
[371.962038, "o", "        \"subtitle_generation\": \"python\"\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[371.962098, "o", "\u001b[?2004h> "]
[371.962269, "o", "    \"notes\": \"No pretrained diarization model available offline; used energy threshold segmentation and alternating speaker labels.\"\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[371.962323, "o", "\u001b[?2004h> "]
[371.962378, "o", "with open('/root/report.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[371.962435, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.962489, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[371.962616, "o", "print('Done. Segments:', len(merged), 'Whisper segments:', len(whisper_segments))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
