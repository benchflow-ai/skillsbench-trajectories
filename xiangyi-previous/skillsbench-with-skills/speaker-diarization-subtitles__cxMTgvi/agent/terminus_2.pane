[?2004hroot@40c0da4302c9:/app/workspace# python3 - <<'PY'
[?2004l[?2004h> import soundfile as sf
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> import whisper
[?2004l[?2004h> 
[?2004l[?2004h> wav_path = '/root/audio.wav'
[?2004l[?2004h> audio, sr = sf.read(wav_path)
[?2004l[?2004h> if audio.ndim > 1:
[?2004l[?2004h>     audio = np.mean(audio, axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> duration = len(audio) / sr
[?2004l[?2004h> 
[?2004l[?2004h> # Energy-based VAD
[?2004l[?2004h> frame_len = int(0.03 * sr)
[?2004l[?2004h> hop = int(0.015 * sr)
[?2004l[?2004h> if frame_len <= 0: frame_len = 1
[?2004l[?2004h> rms = []
[?2004l[?2004h> for i in range(0, len(audio) - frame_len + 1, hop):
[?2004l[?2004h>     frame = audio[i:i+frame_len]
[?2004l[?2004h>     rms.append(np.sqrt(np.mean(frame**2) + 1e-12))
[?2004l[?2004h> rms = np.array(rms)
[?2004l[?2004h> thr = np.median(rms) + 0.5*np.std(rms)
[?2004l[?2004h> mask = rms > thr
[?2004l[?2004h> segments = []
[?2004l[?2004h> inspeech = False
[?2004l[?2004h> start = 0.0
[?2004l[?2004h> for i, m in enumerate(mask):
[?2004l[?2004h>     t = i * hop / sr
[?2004l[?2004h>     if m and not inspeech:
[?2004l[?2004h>         start = t
[?2004l[?2004h>         inspeech = True
[?2004l[?2004h>     if not m and inspeech:
[?2004l[?2004h>         end = t
[?2004l[?2004h>         segments.append((start, end))
[?2004l[?2004h>         inspeech = False
[?2004l[?2004h> if inspeech:
[?2004l[?2004h>     segments.append((start, duration))
[?2004l[?2004h> 
[?2004l[?2004h> # Merge close segments
[?2004l[?2004h> merged = []
[?2004l[?2004h> for s,e in segments:
[?2004l[?2004h>     if not merged:
[?2004l[?2004h>         merged.append([s,e])
[?2004l[?2004h>     else:
[?2004l[?2004h>         if s - merged[-1][1] < 0.3:
[?2004l[?2004h>             merged[-1][1] = e
[?2004l[?2004h>         else:
[?2004l[?2004h>             merged.append([s,e])
[?2004l[?2004h> merged = [(s,e) for s,e in merged if (e-s) >= 0.2]
[?2004l[?2004h> if not merged:
[?2004l[?2004h>     merged = [(0.0, duration)]
[?2004l[?2004h> 
[?2004l[?2004h> labels = [f"SPEAKER_{i%2:02d}" for i in range(len(merged))]
[?2004l[?2004h> 
[?2004l[?2004h> # Whisper tiny model
[?2004l[?2004h> model = whisper.load_model('tiny')
[?2004l[?2004h> result = model.transcribe(wav_path, fp16=False)
[?2004l[?2004h> whisper_segments = result['segments']
[?2004l[?2004h> 
[?2004l[?2004h> # Assign speaker labels
[?2004l[?2004h> 
[?2004l[?2004h> def overlap(a,b):
[?2004l[?2004h>     return max(0.0, min(a[1], b[1]) - max(a[0], b[0]))
[?2004l[?2004h> 
[?2004l[?2004h> assigned = []
[?2004l[?2004h> for seg in whisper_segments:
[?2004l[?2004h>     s = seg['start']
[?2004l[?2004h>     e = seg['end']
[?2004l[?2004h>     best_label = labels[0]
[?2004l[?2004h>     best_ov = 0.0
[?2004l[?2004h>     for (ds,de), lab in zip(merged, labels):
[?2004l[?2004h>         ov = overlap((s,e), (ds,de))
[?2004l[?2004h>         if ov > best_ov:
[?2004l[?2004h>             best_ov = ov
[?2004l[?2004h>             best_label = lab
[?2004l[?2004h>     assigned.append((s,e,best_label,seg['text'].strip()))
[?2004l[?2004h> 
[?2004l[?2004h> # RTTM
[?2004l[?2004h> rttm_lines = []
[?2004l[?2004h> for (s,e), lab in zip(merged, labels):
[?2004l[?2004h>     dur = e - s
[?2004l[?2004h>     spk = 'spk' + lab.split('_')[-1]
[?2004l[?2004h>     rttm_lines.append(f"SPEAKER input 1 {s:.3f} {dur:.3f} <NA> <NA> {spk} <NA> <NA>")
[?2004l[?2004h> with open('/root/diarization.rttm','w') as f:
[?2004l[?2004h>     f.write("\n".join(rttm_lines))
[?2004l[?2004h> 
[?2004l[?2004h> # ASS subtitles
[?2004l[?2004h> 
[?2004l[?2004h> def fmt_ass(t):
[?2004l[?2004h>     h = int(t//3600)
[?2004l[?2004h>     m = int((t%3600)//60)
[?2004l[?2004h>     s = t%60
[?2004l[?2004h>     return f"{h}:{m:02d}:{s:05.2f}"
[?2004l[?2004h> 
[?2004l[?2004h> ass_lines = ["[Events]", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"]
[?2004l[?2004h> for s,e,lab,text in assigned:
[?2004l[?2004h>     if not text:
[?2004l[?2004h>         continue
[?2004l[?2004h>     ass_lines.append(f"Dialogue: 0,{fmt_ass(s)},{fmt_ass(e)},Default,,0,0,0,,{lab}: {text}")
[?2004l[?2004h> with open('/root/subtitles.ass','w') as f:
[?2004l[?2004h>     f.write("\n".join(ass_lines))
[?2004l[?2004h> 
[?2004l[?2004h> # Report
[?2004l[?2004h> num_speakers_pred = len(set(labels))
[?2004l[?2004h> total_speech = sum(e-s for s,e in merged)
[?2004l[?2004h> report = {
[?2004l[?2004h>     "num_speakers_pred": num_speakers_pred,
[?2004l[?2004h>     "total_speech_time_sec": round(total_speech,2),
[?2004l[?2004h>     "audio_duration_sec": round(duration,2),
