[?2004l[?2004h>         html_content = f.read()
[?2004l[?2004h>     
[?2004l[?2004h>     soup = BeautifulSoup(html_content, 'html.parser')
[?2004l[?2004h>     
[?2004l[?2004h>     # Get title
[?2004l[?2004h>     title = soup.find('title')
[?2004l[?2004h>     title_text = title.get_text() if title else "Essay"
[?2004l[?2004h>     
[?2004l[?2004h>     # Find the main content - Paul Graham's essays have text in font tags with size=2 face=verdana
[?2004l[?2004h>     content = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Get all text from font tags
[?2004l[?2004h>     for font_tag in soup.find_all('font', {'size': '2', 'face': 'verdana'}):
[?2004l[?2004h>         text = font_tag.get_text(separator=' ', strip=True)
[?2004l[?2004h>         # Clean up the text
[?2004l[?2004h>         text = re.sub(r'\s+', ' ', text)
[?2004l[?2004h>         if len(text) > 100:  # Only include substantial text blocks
[?2004l[?2004h>             content.append(text)
[?2004l[?2004h>     
[?2004l[?2004h>     # Combine title and content
[?2004l[?2004h>     full_text = f"{title_text}. " + ' '.join(content)
[?2004l[?2004h>     return full_text
[?2004l[?2004h> 
[?2004l[?2004h> def text_to_speech(text, output_file):
[?2004l[?2004h>     """Convert text to speech using OpenAI TTS API"""
[?2004l[?2004h>     print(f"Converting text to speech... ({len(text)} characters)")
[?2004l[?2004h>     
[?2004l[?2004h>     # OpenAI TTS has a limit, so we might need to chunk
[?2004l[?2004h>     # The limit is around 4096 characters per request
[?2004l[?2004h>     max_chars = 4000
[?2004l[?2004h>     
[?2004l[?2004h>     if len(text) <= max_chars:
[?2004l[?2004h>         # Single request
[?2004l[?2004h>         response = client.audio.speech.create(
[?2004l[?2004h>             model="tts-1",
[?2004l[?2004h>             voice="alloy",
[?2004l[?2004h>             input=text
[?2004l[?2004h>         )
[?2004l[?2004h>         response.stream_to_file(output_file)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Need to chunk and combine
[?2004l[?2004h>         chunks = []
[?2004l[?2004h>         sentences = text.split('. ')
[?2004l[?2004h>         current_chunk = ""
[?2004l[?2004h>         
[?2004l[?2004h>         for sentence in sentences:
[?2004l[?2004h>             if len(current_chunk) + len(sentence) < max_chars:
[?2004l[?2004h>                 current_chunk += sentence + ". "
[?2004l[?2004h>             else:
[?2004l[?2004h>                 if current_chunk:
[?2004l[?2004h>                     chunks.append(current_chunk)
[?2004l[?2004h>                 current_chunk = sentence + ". "
[?2004l[?2004h>         
[?2004l[?2004h>         if current_chunk:
[?2004l[?2004h>             chunks.append(current_chunk)
[?2004l[?2004h>         
[?2004l[?2004h>         print(f"Processing {len(chunks)} chunks...")
[?2004l[?2004h>         
[?2004l[?2004h>         # Generate audio for each chunk and combine
[?2004l[?2004h>         temp_files = []
[?2004l[?2004h>         for i, chunk in enumerate(chunks):
[?2004l[?2004h>             temp_file = f"temp_chunk_{i}.mp3"
[?2004l[?2004h>             print(f"  Chunk {i+1}/{len(chunks)}...")
[?2004l[?2004h>             response = client.audio.speech.create(
[?2004l[?2004h>                 model="tts-1",
[?2004l[?2004h>                 voice="alloy",
