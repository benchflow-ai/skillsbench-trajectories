[103.79343, "o", "client = OpenAI(api_key=os.environ.get('OPENAI_API_KEY'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_text_from_html(html_file):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract main text content from Paul Graham essay HTML\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.793568, "o", "    with open(html_file, 'r', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.793674, "o", "        html_content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.793751, "o", "    soup = BeautifulSoup(html_content, 'html.parser')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.793841, "o", "    # Get title\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.794638, "o", "    title = soup.find('title')\r\n\u001b[?2004l\r\u001b[?2004h>     title_text = title.get_text() if title else \"Essay\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Find the main content - Paul Graham's essays have text in font tags with size=2 face=verdana\r\n\u001b[?2004l\r\u001b[?2004h>     content = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Get all text from font tags\r\n\u001b[?2004l\r\u001b[?2004h>     for font_tag in soup.find_all('font', {'size': '2', 'face': 'verdana'}):\r\n\u001b[?2004l\r\u001b[?2004h>         text = font_tag.get_text(separator=' ', strip=True)\r\n\u001b[?2004l\r\u001b[?2004h>         # Clean up the text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.794689, "o", "        text = re.sub(r'\\s+', ' ', text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.7948, "o", "        if len(text) > 100:  # Only include substantial text blocks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.794883, "o", "            content.append(text)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[103.794917, "o", "\u001b[?2004h> "]
[103.795013, "o", "    # Combine title and content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795053, "o", "    full_text = f\"{title_text}. \" + ' '.join(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795124, "o", "    return full_text\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795194, "o", "def text_to_speech(text, output_file):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795297, "o", "    \"\"\"Convert text to speech using OpenAI TTS API\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795402, "o", "    print(f\"Converting text to speech... ({len(text)} characters)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.795461, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795525, "o", "    # OpenAI TTS has a limit, so we might need to chunk\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.795565, "o", "> "]
[103.795628, "o", "    # The limit is around 4096 characters per request\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795724, "o", "    max_chars = 4000\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795762, "o", "    if len(text) <= max_chars:\r\n\u001b[?2004l\r"]
[103.795852, "o", "\u001b[?2004h>         # Single request\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.795918, "o", "        response = client.audio.speech.create(\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.795954, "o", ">             model=\"tts-1\",\r\n\u001b[?2004l\r"]
[103.796041, "o", "\u001b[?2004h>             voice=\"alloy\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.796078, "o", "            input=text\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.796151, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.796243, "o", "        response.stream_to_file(output_file)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.796306, "o", "        # Need to chunk and combine\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.796376, "o", ">         chunks = []\r\n\u001b[?2004l\r"]
[103.796416, "o", "\u001b[?2004h>         sentences = text.split('. ')\r\n\u001b[?2004l\r"]
[103.796451, "o", "\u001b[?2004h> "]
[103.796545, "o", "        current_chunk = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.796642, "o", "        for sentence in sentences:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.796679, "o", ">             if len(current_chunk) + len(sentence) < max_chars:\r\n\u001b[?2004l\r"]
[103.796769, "o", "\u001b[?2004h>                 current_chunk += sentence + \". \"\r\n\u001b[?2004l\r"]
[103.796803, "o", "\u001b[?2004h> "]
[103.796889, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 if current_chunk:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.796926, "o", "> "]
[103.797011, "o", "                    chunks.append(current_chunk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797085, "o", "                current_chunk = sentence + \". \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.79712, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797234, "o", "        if current_chunk:\r\n\u001b[?2004l\r\u001b[?2004h>             chunks.append(current_chunk)\r\n\u001b[?2004l\r"]
[103.797268, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.79736, "o", "        print(f\"Processing {len(chunks)} chunks...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.797398, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797485, "o", "        # Generate audio for each chunk and combine\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.797549, "o", "> "]
[103.797581, "o", "        temp_files = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797673, "o", "        for i, chunk in enumerate(chunks):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797773, "o", "            temp_file = f\"temp_chunk_{i}.mp3\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797809, "o", "            print(f\"  Chunk {i+1}/{len(chunks)}...\")\r\n\u001b[?2004l\r"]
[103.797894, "o", "\u001b[?2004h> "]
[103.797951, "o", "            response = client.audio.speech.create(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.797988, "o", "                model=\"tts-1\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798062, "o", "                voice=\"alloy\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798099, "o", "                input=chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798211, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h>             response.stream_to_file(temp_file)\r\n\u001b[?2004l\r"]
[103.798248, "o", "\u001b[?2004h> "]
[103.798319, "o", "            temp_files.append(temp_file)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[103.798404, "o", "\u001b[?2004h> "]
[103.798441, "o", "        # Combine all chunks using ffmpeg or simple concatenation\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.798475, "o", "> "]
[103.798585, "o", "        # For MP3, we can use binary concatenation (simple approach)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798665, "o", "        with open(output_file, 'wb') as outfile:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798735, "o", "            for temp_file in temp_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.798821, "o", "                with open(temp_file, 'rb') as infile:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.798855, "o", "> "]
[103.798923, "o", "                    outfile.write(infile.read())\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.798961, "o", "> "]
[103.799054, "o", "                os.remove(temp_file)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.79914, "o", "        print(f\"Combined {len(chunks)} chunks into {output_file}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.799179, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799264, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799301, "o", "    print(\"Extracting text from essays...\")\r\n\u001b[?2004l\r"]
[103.799389, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799444, "o", "    # Extract text from both essays\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799505, "o", "    essay1_text = extract_text_from_html('essay1.html')\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.79956, "o", "> "]
[103.799599, "o", "    essay2_text = extract_text_from_html('essay2.html')\r\n\u001b[?2004l\r"]
[103.799633, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799724, "o", "    print(f\"Essay 1: {len(essay1_text)} characters\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.799761, "o", "> "]
[103.799823, "o", "    print(f\"Essay 2: {len(essay2_text)} characters\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.79986, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.799979, "o", "    # Combine both essays with a separator\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800046, "o", "    combined_text = essay1_text + \" ... Next essay: ... \" + essay2_text\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.800082, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800182, "o", "    print(f\"\\nTotal text: {len(combined_text)} characters\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.80025, "o", "> "]
[103.800288, "o", "    print(\"\\nGenerating audiobook...\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800362, "o", "    # Convert to speech\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800445, "o", "    text_to_speech(combined_text, '/root/audiobook.mp3')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800479, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.800587, "o", "    print(\"\\nAudiobook created successfully at /root/audiobook.mp3\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.800613, "o", "> EOF\r\n\u001b[?2004l\r"]
[103.801652, "o", "\u001b[?2004hroot@75253832891d:~# "]
[103.896707, "i", "python3 convert_to_audio.py\n"]
[103.897012, "o", "python3 convert_to_audio.py\r\n\u001b[?2004l\r"]
