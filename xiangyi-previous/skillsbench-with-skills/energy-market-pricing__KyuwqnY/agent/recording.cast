[342.815269, "o", "    print(f\"Found line 64-1501 at index {line_64_1501_idx}\")\r\n\u001b[?2004l\r"]
[342.815338, "o", "\u001b[?2004h> "]
[342.815421, "o", "    print(f\"Original limit: {branch_rate[line_64_1501_idx]:.2f} MW\")\r\n\u001b[?2004l\r"]
[342.815473, "o", "\u001b[?2004h> "]
[342.815622, "o", "    print(f\"Modified limit: {branches_modified[line_64_1501_idx]:.2f} MW\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.815713, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.815762, "o", "    print(\"Line 64-1501 not found\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.815872, "o", "    branches_modified = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.81596, "o", "# Solve counterfactual\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.816041, "o", "print(\"Solving counterfactual case...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.816142, "o", "results_cf = solve_market(branches_modified)\r\n\u001b[?2004l\r"]
[342.816221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Generate report\r\n\u001b[?2004l\r"]
[342.816297, "o", "\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.816372, "o", "    'base_case': results_base,\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.81646, "o", ">     'counterfactual': results_cf,\r\n\u001b[?2004l\r"]
[342.816509, "o", "\u001b[?2004h>     'impact_analysis': {\r\n\u001b[?2004l\r"]
[342.816606, "o", "\u001b[?2004h> "]
[342.816787, "o", "        'cost_reduction_dollars_per_hour': float(results_base['total_cost'] - results_cf['total_cost']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.816843, "o", "        'buses_with_largest_lmp_drop': [],\r\n\u001b[?2004l\r"]
[342.816951, "o", "\u001b[?2004h> "]
[342.817067, "o", "        'congestion_relieved': len(results_cf['binding_lines']) < len(results_base['binding_lines'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.817197, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
