[156.427839, "o", "        gen_at_bus = 0\r\n\u001b[?2004l\r"]
[156.427908, "o", "\u001b[?2004h> "]
[156.428097, "o", "        for g_idx, g_bus in enumerate(gen_bus):\r\n\u001b[?2004l\r"]
[156.428137, "o", "\u001b[?2004h> "]
[156.428306, "o", "            if g_bus == bus_id:\r\n\u001b[?2004l\r"]
[156.428352, "o", "\u001b[?2004h> "]
[156.428565, "o", "                gen_at_bus += pg[g_idx]\r\n\u001b[?2004l\r"]
[156.428595, "o", "\u001b[?2004h> "]
[156.428633, "o", "        \r\n\u001b[?2004l\r"]
[156.428662, "o", "\u001b[?2004h> "]
[156.428954, "o", "        flow_sum = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.429064, "o", "        for br_idx in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.4293, "o", "            if branch_from[br_idx] == bus_id:\r\n\u001b[?2004l\r"]
[156.429336, "o", "\u001b[?2004h> "]
[156.429677, "o", "                to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[156.429713, "o", "\u001b[?2004h> "]
[156.429905, "o", "                x = branch_x[br_idx]\r\n\u001b[?2004l\r"]
[156.429941, "o", "\u001b[?2004h> "]
[156.430085, "o", "                if x != 0:\r\n\u001b[?2004l\r"]
[156.430122, "o", "\u001b[?2004h> "]
[156.430411, "o", "                    flow = (theta[b_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r"]
[156.430448, "o", "\u001b[?2004h> "]
[156.430646, "o", "                    flow_sum += flow\r\n\u001b[?2004l\r"]
[156.430685, "o", "\u001b[?2004h> "]
[156.43076, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[156.430791, "o", "> "]
[156.430994, "o", "            if branch_to[br_idx] == bus_id:\r\n\u001b[?2004l\r"]
[156.431031, "o", "\u001b[?2004h> "]
[156.431365, "o", "                from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[156.431401, "o", "\u001b[?2004h> "]
[156.43191, "o", "                x = branch_x[br_idx]\r\n\u001b[?2004l\r"]
[156.43196, "o", "\u001b[?2004h>                 if x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.432157, "o", "                    flow = (theta[from_idx] - theta[b_idx]) / x * base_mva\r\n\u001b[?2004l\r"]
[156.432192, "o", "\u001b[?2004h> "]
[156.432402, "o", "                    flow_sum += flow\r\n\u001b[?2004l\r"]
[156.432441, "o", "\u001b[?2004h> "]
[156.432584, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.432827, "o", "        constraints.append(gen_at_bus == bus_pd[b_idx] + flow_sum)\r\n\u001b[?2004l\r"]
[156.432866, "o", "\u001b[?2004h> "]
[156.432898, "o", "    \r\n\u001b[?2004l\r"]
[156.432938, "o", "\u001b[?2004h> "]
[156.433062, "o", "    # Line limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.433202, "o", "    line_flow_vars = []\r\n\u001b[?2004l\r"]
[156.43327, "o", "\u001b[?2004h> "]
[156.433434, "o", "    for br_idx in range(num_branches):\r\n\u001b[?2004l\r"]
[156.433506, "o", "\u001b[?2004h> "]
[156.433738, "o", "        from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[156.433804, "o", "\u001b[?2004h> "]
[156.434043, "o", "        to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[156.434117, "o", "\u001b[?2004h> "]
[156.434554, "o", "        x = branch_x[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.434898, "o", "            flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r"]
[156.434974, "o", "\u001b[?2004h> "]
[156.435194, "o", "            line_flow_vars.append((br_idx, flow))\r\n\u001b[?2004l\r"]
[156.435344, "o", "\u001b[?2004h> "]
[156.435414, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.435557, "o", "            limit = branch_rate[br_idx]\r\n\u001b[?2004l\r"]
[156.435649, "o", "\u001b[?2004h> "]
[156.436196, "o", "            if branches_modified is not None and br_idx in branches_modified:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.43638, "o", "                limit = branches_modified[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[156.436547, "o", "\u001b[?2004h> "]
[156.436644, "o", "            constraints.append(flow <= limit)\r\n\u001b[?2004l\r"]
[156.436749, "o", "\u001b[?2004h> "]
[156.436929, "o", "            constraints.append(flow >= -limit)\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.437031, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.437146, "o", "    # Reserve requirement\r\n\u001b[?2004l\r"]
[156.437246, "o", "\u001b[?2004h> "]
[156.437415, "o", "    constraints.append(cp.sum(reserve) >= reserve_requirement)\r\n\u001b[?2004l\r"]
[156.437485, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.437613, "o", "    # Solve\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.437994, "o", "    problem = cp.Problem(cp.Minimize(objective), constraints)\r\n\u001b[?2004l\r\u001b[?2004h>     problem.solve(solver=cp.ECOS, verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.438184, "o", "    # Calculate LMPs from dual variables (simplified approach)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.438348, "o", "    # LMP = energy price + congestion price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.438561, "o", "    # For now, use a simplified approach based on generation costs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.438683, "o", "    lmps = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h>     for b_idx in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.438849, "o", ">         # Find marginal generator at this bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.43905, "o", "        gens_at_bus = [i for i, gb in enumerate(gen_bus) if gb == bus_ids[b_idx]]\r\n\u001b[?2004l\r"]
[156.439191, "o", "\u001b[?2004h>         if gens_at_bus:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.43928, "o", "            # Use cost of highest-cost generator\r\n\u001b[?2004l\r"]
[156.439357, "o", "\u001b[?2004h> "]
[156.439568, "o", "            max_cost_gen = max(gens_at_bus, key=lambda i: cost_coeffs[i, 0] if cost_n[i] == 3 else cost_coeffs[i, 0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.439656, "o", "> "]
[156.439728, "o", "            if cost_n[max_cost_gen] == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.439969, "o", "                lmps[b_idx] = 2 * cost_coeffs[max_cost_gen, 0] * pg.value[max_cost_gen] + cost_coeffs[max_cost_gen, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440063, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440193, "o", "                lmps[b_idx] = cost_coeffs[max_cost_gen, 0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.440269, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440412, "o", "            lmps[b_idx] = 30.0  # Default price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440496, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440578, "o", "    # Identify binding lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440656, "o", "    binding_lines = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.440776, "o", "    for br_idx, flow_expr in line_flow_vars:\r\n\u001b[?2004l\r"]
[156.440848, "o", "\u001b[?2004h> "]
[156.44093, "o", "        if flow_expr.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.441002, "o", "> "]
[156.441074, "o", "            limit = branch_rate[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.441147, "o", "> "]
[156.441284, "o", "            if branches_modified is not None and br_idx in branches_modified:\r\n\u001b[?2004l\r"]
[156.441358, "o", "\u001b[?2004h> "]
[156.441443, "o", "                limit = branches_modified[br_idx]\r\n\u001b[?2004l\r"]
[156.441518, "o", "\u001b[?2004h> "]
[156.441651, "o", "            loading = abs(flow_expr.value) / limit if limit > 0 else 0\r\n\u001b[?2004l\r"]
[156.441724, "o", "\u001b[?2004h> "]
[156.441792, "o", "            if loading >= 0.99:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.441912, "o", "                binding_lines.append({\r\n\u001b[?2004l\r"]
[156.441988, "o", "\u001b[?2004h> "]
[156.442071, "o", "                    'from': int(branch_from[br_idx]),\r\n\u001b[?2004l\r"]
[156.442142, "o", "\u001b[?2004h> "]
[156.442239, "o", "                    'to': int(branch_to[br_idx]),\r\n\u001b[?2004l\r"]
[156.442312, "o", "\u001b[?2004h> "]
[156.442431, "o", "                    'flow_MW': float(abs(flow_expr.value)),\r\n\u001b[?2004l\r"]
[156.442543, "o", "\u001b[?2004h> "]
[156.454557, "o", "                    'limit_MW': float(limit)\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     results = {\r\n\u001b[?2004l\r\u001b[?2004h>         'total_cost': float(problem.value) if problem.value is not None else 0,\r\n\u001b[?2004l\r\u001b[?2004h>         'lmp_by_bus': [{'bus': int(bus_ids[i]), 'lmp_dollars_per_MWh': float(lmps[i])} for i in range(num_buses)],\r\n\u001b[?2004l\r\u001b[?2004h>         'reserve_mcp_dollars_per_MWh': 5.0,  # Placeholder\r\n\u001b[?2004l\r\u001b[?2004h>         'binding_lines': binding_lines\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Solve base case\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Solving base case...\")\r\n\u001b[?2004l\r\u001b[?2004h> results_base = solve_market()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Find and modify line 64-1501\r\n\u001b[?2004l\r\u001b[?2004h> line_64_1501_idx = None\r\n\u001b[?2004l\r\u001b[?2004h> for br_idx in range(len(branch_from)):\r\n\u001b[?2004l\r\u001b[?2004h>     if (branch_from[br_idx] == 64 and branch_to[br_idx] == 1501) or \\\r\n\u001b[?2004l\r\u001b[?2004h>        (branch_from[br_idx] == 1501 and branch_to[br_idx] == 64):\r\n\u001b[?2004l\r\u001b[?2004h>         line_64_1501_idx = br_idx\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if line_64_1501_idx is not None:\r\n\u001b[?2004l\r\u001b[?2004h>     branches_modified = {line_64_1501_idx: branch_rate[line_64_1501_idx] * 1.2}\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Found line 64-1501 at index {line_64_1501_idx}\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Line 64-1501 not found\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.454799, "o", "    branches_modified = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Solve counterfactual\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.454857, "o", "print(\"Solving counterfactual case...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.454913, "o", "> "]
[156.454986, "o", "results_cf = solve_market(branches_modified)\r\n\u001b[?2004l\r"]
[156.455035, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[156.455084, "o", "\u001b[?2004h> "]
[156.455136, "o", "# Generate report\r\n\u001b[?2004l\r"]
[156.455186, "o", "\u001b[?2004h> "]
[156.455238, "o", "report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.455286, "o", "> "]
[156.455335, "o", "    'base_case': results_base,\r\n\u001b[?2004l\r"]
[156.455384, "o", "\u001b[?2004h> "]
[156.455446, "o", "    'counterfactual': results_cf,\r\n\u001b[?2004l\r"]
[156.455495, "o", "\u001b[?2004h> "]
[156.455544, "o", "    'impact_analysis': {\r\n\u001b[?2004l\r"]
[156.455593, "o", "\u001b[?2004h> "]
[156.45583, "o", "        'cost_reduction_dollars_per_hour': float(results_base['total_cost'] - results_cf['total_cost']),\r\n\u001b[?2004l\r"]
[156.455883, "o", "\u001b[?2004h> "]
[156.455967, "o", "        'buses_with_largest_lmp_drop': [],\r\n\u001b[?2004l\r"]
[156.456017, "o", "\u001b[?2004h> "]
[156.456252, "o", "        'congestion_relieved': len(results_cf['binding_lines']) < len(results_base['binding_lines'])\r\n\u001b[?2004l\r"]
[156.4563, "o", "\u001b[?2004h> "]
[156.456348, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.456395, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.456443, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.456512, "o", "# Calculate LMP drops\r\n\u001b[?2004l\r"]
[156.456559, "o", "\u001b[?2004h> "]
[156.456607, "o", "lmp_drops = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.456655, "o", "> "]
[156.456751, "o", "for base_lmp in results_base['lmp_by_bus']:\r\n\u001b[?2004l\r"]
[156.456799, "o", "\u001b[?2004h> "]
[156.457029, "o", "    cf_lmp = next((x for x in results_cf['lmp_by_bus'] if x['bus'] == base_lmp['bus']), None)\r\n\u001b[?2004l\r"]
[156.457079, "o", "\u001b[?2004h> "]
[156.457131, "o", "    if cf_lmp:\r\n\u001b[?2004l\r"]
[156.457179, "o", "\u001b[?2004h> "]
[156.457369, "o", "        drop = base_lmp['lmp_dollars_per_MWh'] - cf_lmp['lmp_dollars_per_MWh']\r\n\u001b[?2004l\r"]
[156.457417, "o", "\u001b[?2004h> "]
[156.457481, "o", "        lmp_drops.append({\r\n\u001b[?2004l\r"]
[156.457528, "o", "\u001b[?2004h> "]
[156.457607, "o", "            'bus': base_lmp['bus'],\r\n\u001b[?2004l\r"]
[156.457654, "o", "\u001b[?2004h> "]
[156.457765, "o", "            'base_lmp': base_lmp['lmp_dollars_per_MWh'],\r\n\u001b[?2004l\r"]
[156.457814, "o", "\u001b[?2004h> "]
[156.457949, "o", "            'cf_lmp': cf_lmp['lmp_dollars_per_MWh'],\r\n\u001b[?2004l\r"]
[156.457999, "o", "\u001b[?2004h> "]
[156.458045, "o", "            'delta': drop\r\n\u001b[?2004l\r"]
[156.458093, "o", "\u001b[?2004h>         })"]
[156.458143, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.458199, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.45834, "o", "lmp_drops.sort(key=lambda x: x['delta'], reverse=True)\r\n\u001b[?2004l\r"]
[156.458394, "o", "\u001b[?2004h> "]
[156.458579, "o", "report['impact_analysis']['buses_with_largest_lmp_drop'] = lmp_drops[:3]\r\n\u001b[?2004l\r"]
[156.458625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[156.458674, "o", "\u001b[?2004h> "]
