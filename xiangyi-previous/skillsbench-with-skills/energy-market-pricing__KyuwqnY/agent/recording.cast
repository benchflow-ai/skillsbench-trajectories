[342.807917, "o", "\u001b[?2004h> "]
[342.808009, "o", "            costs = []\r\n\u001b[?2004l\r"]
[342.808065, "o", "\u001b[?2004h> "]
[342.808195, "o", "            for g_idx in gens_at_bus:\r\n\u001b[?2004l\r"]
[342.808242, "o", "\u001b[?2004h"]
[342.808293, "o", "> "]
[342.808451, "o", "                if cost_n[g_idx] == 3:  # Quadratic\r\n\u001b[?2004l\r"]
[342.808502, "o", "\u001b[?2004h> "]
[342.808646, "o", "                    c2 = cost_coeffs[g_idx, 0]\r\n\u001b[?2004l\r"]
[342.808699, "o", "\u001b[?2004h> "]
