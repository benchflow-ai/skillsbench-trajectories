[342.811926, "o", "\u001b[?2004h> "]
[342.811976, "o", "                limit = branches_modified[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.812136, "o", "            loading = abs(flow_expr.value) / limit if limit > 0 else 0\r\n\u001b[?2004l\r"]
[342.81222, "o", "\u001b[?2004h>             if loading >= 0.99:\r\n\u001b[?2004l\r"]
[342.812294, "o", "\u001b[?2004h> "]
[342.812342, "o", "                binding_lines.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
