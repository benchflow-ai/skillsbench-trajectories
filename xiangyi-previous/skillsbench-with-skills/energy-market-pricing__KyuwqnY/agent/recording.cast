[342.813501, "o", "\u001b[?2004h> "]
[342.813549, "o", "        'reserve_mcp_dollars_per_MWh': 5.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.813652, "o", "        'binding_lines': binding_lines\r\n\u001b[?2004l\r\u001b[?2004h"]
