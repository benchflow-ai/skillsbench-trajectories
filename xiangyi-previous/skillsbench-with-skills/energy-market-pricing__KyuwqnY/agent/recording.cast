[342.803182, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.803382, "o", "        problem.solve(solver=cp.SCS, verbose=False, max_iters=5000)\r\n\u001b[?2004l\r"]
[342.803423, "o", "\u001b[?2004h> "]
[342.803566, "o", "    except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.803747, "o", "        problem.solve(solver=cp.ECOS, verbose=False)\r\n\u001b[?2004l\r"]
[342.803838, "o", "\u001b[?2004h> "]
