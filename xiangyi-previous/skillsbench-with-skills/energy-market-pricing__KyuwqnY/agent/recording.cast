[477.743653, "i", "python3 << 'EOF'\nimport json\n\nwith open('report.json') as f:\n    report = json.load(f)\n\nprint(\"Report Structure:\")\nprint(f\"Base case total cost: ${report['base_case']['total_cost']:.2f}\")\nprint(f\"Counterfactual total cost: ${report['counterfactual']['total_cost']:.2f}\")\nprint(f\"\\nImpact Analysis:\")\nprint(f\"Cost reduction: ${report['impact_analysis']['cost_reduction_dollars_per_hour']:.2f}\")\nprint(f\"Congestion relieved: {report['impact_analysis']['congestion_relieved']}\")\nprint(f\"\\nBuses with largest LMP drop:\")\nfor bus_info in report['impact_analysis']['buses_with_largest_lmp_drop']:\n    print(f\"  Bus {bus_info['bus']}: {bus_info['base_lmp']:.2f} -> {bus_info['cf_lmp']:.2f} (delta: {bus_info['delta']:.2f})\")\n\nprint(f\"\\nBase case binding lines: {len(report['base_case']['binding_lines'])}\")\nprint(f\"Counterfactual binding lines: {len(report['counterfactual']['binding_lines'])}\")\n\nif report['base_case']['binding_lines']:\n    print(f\"\\nSample binding lines (base case):\")\n    for line in report['base_case']['binding_lines'][:3]:\n        print(f\"  {line['from']} -> {line['to']}: {line['flow_MW']:.2f} MW / {line['limit_MW']:.2f} MW\")\n\nEOF\n"]
