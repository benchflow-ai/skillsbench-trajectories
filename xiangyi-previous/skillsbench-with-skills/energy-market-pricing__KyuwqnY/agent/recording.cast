[342.799405, "o", "    for br_idx in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.799491, "o", "> "]
[342.799555, "o", "        x = branch_x[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.79963, "o", "        if x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.799746, "o", "            from_bus = branch_from[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.799874, "o", "            to_bus = branch_to[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.799905, "o", "> "]
[342.800039, "o", "            from_idx = bus_to_idx.get(from_bus)\r\n\u001b[?2004l\r"]
[342.800066, "o", "\u001b[?2004h> "]
[342.800192, "o", "            to_idx = bus_to_idx.get(to_bus)\r\n\u001b[?2004l\r"]
[342.800219, "o", "\u001b[?2004h> "]
[342.800245, "o", "            \r\n\u001b[?2004l\r"]
[342.800272, "o", "\u001b[?2004h> "]
[342.80046, "o", "            if from_idx is not None and to_idx is not None:\r\n\u001b[?2004l\r"]
[342.800487, "o", "\u001b[?2004h> "]
[342.800698, "o", "                flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.800735, "o", "> "]
[342.800852, "o", "                line_flows[br_idx] = flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.800937, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.801073, "o", "                limit = branch_rate[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.801101, "o", "> "]
[342.80134, "o", "                if branches_modified is not None and br_idx in branches_modified:\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.80137, "o", "> "]
[342.801525, "o", "                    limit = branches_modified[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.801555, "o", "> "]
[342.801667, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.801838, "o", "                constraints.append(flow <= limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.802047, "o", "                constraints.append(flow >= -limit)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.80208, "o", "    # Reserve requirement\r\n\u001b[?2004l\r"]
[342.802107, "o", "\u001b[?2004h> "]
[342.802301, "o", "    constraints.append(cp.sum(reserve) >= reserve_requirement)\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.802332, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[342.802358, "o", "> "]
[342.80239, "o", "    # Solve\r\n\u001b[?2004l\r"]
[342.802419, "o", "\u001b[?2004h> "]
