[342.790956, "o", "\u001b[?2004h> "]
[342.79109, "o", "            c0 = cost_coeffs[i, 1]\r\n\u001b[?2004l\r"]
[342.791171, "o", "\u001b[?2004h> "]
[342.791334, "o", "            gen_cost += c1 * pg[i] + c0\r\n\u001b[?2004l\r"]
[342.791418, "o", "\u001b[?2004h>     \r\n"]
[342.7915, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[342.791589, "o", "    objective = gen_cost\r\n\u001b[?2004l\r"]
[342.791678, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.791771, "o", "    constraints = []\r\n\u001b[?2004l\r"]
[342.791849, "o", "\u001b[?2004h> "]
[342.791931, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.791998, "o", "    # Generator limits\r\n\u001b[?2004l\r"]
[342.792072, "o", "\u001b[?2004h> "]
[342.792235, "o", "    constraints.append(pg >= gen_pmin)\r\n\u001b[?2004l\r"]
[342.792272, "o", "\u001b[?2004h> "]
[342.792471, "o", "    constraints.append(pg <= gen_pmax)\r\n\u001b[?2004l\r"]
[342.792498, "o", "\u001b[?2004h> "]
[342.792676, "o", "    constraints.append(reserve >= 0)\r\n\u001b[?2004l\r"]
[342.792696, "o", "\u001b[?2004h> "]
[342.792958, "o", "    constraints.append(reserve <= reserve_capacity)\r\n\u001b[?2004l\r"]
[342.79299, "o", "\u001b[?2004h> "]
[342.793178, "o", "    constraints.append(pg + reserve <= gen_pmax)\r\n\u001b[?2004l\r"]
[342.793203, "o", "\u001b[?2004h> "]
[342.793224, "o", "    \r\n\u001b[?2004l\r"]
[342.79325, "o", "\u001b[?2004h> "]
[342.793351, "o", "    # Slack bus angle\r\n\u001b[?2004l\r"]
[342.793373, "o", "\u001b[?2004h> "]
[342.793524, "o", "    constraints.append(theta[0] == 0)\r\n\u001b[?2004l\r"]
[342.793549, "o", "\u001b[?2004h> "]
[342.793573, "o", "    \r\n\u001b[?2004l\r"]
[342.793598, "o", "\u001b[?2004h> "]
[342.79384, "o", "    # Power balance (DC) - simplified with bus index mapping\r\n\u001b[?2004l\r"]
[342.793867, "o", "\u001b[?2004h> "]
[342.794658, "o", "    bus_to_idx = {bid: idx for idx, bid in enumerate(bus_ids)}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for b_idx, bus_id in enumerate(bus_ids):\r\n\u001b[?2004l\r\u001b[?2004h>         # Generation at this bus\r\n\u001b[?2004l\r\u001b[?2004h>         gen_at_bus = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.794693, "o", "> "]
[342.795297, "o", "        for g_idx, g_bus in enumerate(gen_bus):\r\n\u001b[?2004l\r\u001b[?2004h>             if g_bus == bus_id:\r\n\u001b[?2004l\r\u001b[?2004h>                 gen_at_bus += pg[g_idx]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.795422, "o", "        # Net flow out of bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.795527, "o", "        flow_out = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.795568, "o", "> "]
[342.795727, "o", "        for br_idx in range(num_branches):\r\n\u001b[?2004l\r"]
[342.795763, "o", "\u001b[?2004h> "]
[342.795865, "o", "            x = branch_x[br_idx]\r\n\u001b[?2004l\r"]
[342.795887, "o", "\u001b[?2004h> "]
[342.795993, "o", "            if x != 0:\r\n\u001b[?2004l\r"]
[342.79602, "o", "\u001b[?2004h> "]
[342.796208, "o", "                from_bus = branch_from[br_idx]\r\n\u001b[?2004l\r"]
[342.796232, "o", "\u001b[?2004h> "]
[342.796403, "o", "                to_bus = branch_to[br_idx]\r\n\u001b[?2004l\r"]
[342.796426, "o", "\u001b[?2004h> "]
[342.796633, "o", "                from_idx = bus_to_idx.get(from_bus)\r\n\u001b[?2004l\r"]
[342.796654, "o", "\u001b[?2004h> "]
[342.796848, "o", "                to_idx = bus_to_idx.get(to_bus)\r\n\u001b[?2004l\r"]
[342.796872, "o", "\u001b[?2004h> "]
[342.796946, "o", "                \r\n\u001b[?2004l\r"]
[342.796973, "o", "\u001b[?2004h> "]
[342.797228, "o", "                if from_idx is not None and to_idx is not None:\r\n\u001b[?2004l\r"]
[342.797253, "o", "\u001b[?2004h> "]
[342.797425, "o", "                    if from_bus == bus_id:\r\n\u001b[?2004l\r"]
[342.797446, "o", "\u001b[?2004h> "]
[342.798017, "o", "                        flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h>                         flow_out += flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.798494, "o", "                    elif to_bus == bus_id:\r\n\u001b[?2004l\r\u001b[?2004h>                         flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.798624, "o", "                        flow_out -= flow\r\n\u001b[?2004l\r"]
[342.798698, "o", "\u001b[?2004h>         \r\n"]
[342.798771, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[342.79885, "o", "        # Power balance: gen = demand + flow_out\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.798931, "o", "> "]
[342.799079, "o", "        constraints.append(gen_at_bus == bus_pd[b_idx] + flow_out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.799163, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.799244, "o", "    # Line limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
