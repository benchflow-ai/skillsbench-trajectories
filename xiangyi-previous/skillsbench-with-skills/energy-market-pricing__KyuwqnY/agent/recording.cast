[342.8071, "o", "\u001b[?2004h"]
[342.807136, "o", "> "]
[342.80743, "o", "    for b_idx, bus_id in enumerate(bus_ids):\r\n\u001b[?2004l\r"]
[342.807474, "o", "\u001b[?2004h"]
[342.807522, "o", "> "]
[342.807709, "o", "        gens_at_bus = [i for i, gb in enumerate(gen_bus) if gb == bus_id]\r\n\u001b[?2004l\r"]
[342.807768, "o", "\u001b[?2004h> "]
