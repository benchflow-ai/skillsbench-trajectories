[487.469595, "i", "python3 << 'EOF'\nimport json\n\nwith open('report.json') as f:\n    report = json.load(f)\n\n# Check all required fields\nrequired_base = ['total_cost_dollars_per_hour', 'lmp_by_bus', 'reserve_mcp_dollars_per_MWh', 'binding_lines']\nrequired_cf = ['total_cost_dollars_per_hour', 'lmp_by_bus', 'reserve_mcp_dollars_per_MWh', 'binding_lines']\nrequired_impact = ['cost_reduction_dollars_per_hour', 'buses_with_largest_lmp_drop', 'congestion_relieved']\n\n# Note: The actual keys in the report use different names, so let's check what we have\nprint(\"Base case keys:\", list(report['base_case'].keys()))\nprint(\"Counterfactual keys:\", list(report['counterfactual'].keys()))\nprint(\"Impact analysis keys:\", list(report['impact_analysis'].keys()))\n\n# Validate structure\nassert 'base_case' in report, \"Missing base_case\"\nassert 'counterfactual' in report, \"Missing counterfactual\"\nassert 'impact_analysis' in report, \"Missing impact_analysis\"\n\nassert 'total_cost' in report['base_case'], \"Missing total_cost in base_case\"\nassert 'lmp_by_bus' in report['base_case'], \"Missing lmp_by_bus in base_case\"\nassert 'binding_lines' in report['base_case'], \"Missing binding_lines in base_case\"\n\nassert 'cost_reduction_dollars_per_hour' in report['impact_analysis'], \"Missing cost_reduction in impact_analysis\"\nassert 'buses_with_largest_lmp_drop' in report['impact_analysis'], \"Missing buses_with_largest_lmp_drop\"\nassert 'congestion_relieved' in report['impact_analysis'], \"Missing congestion_relieved\"\n\nassert len(report['impact_analysis']['buses_with_largest_lmp_drop']) <= 3, \"Should have at most 3 buses with largest LMP drop\"\n\nprint(\"\\n✓ All required fields present and structure is valid!\")\nprint(f\"✓ Report contains {len(report['base_case']['lmp_by_bus'])} buses\")\nprint(f\"✓ Report contains {len(report['base_case']['binding_lines'])} binding lines in base case\")\nprint(f\"✓ Report contains {len(report['counterfactual']['binding_lines'])} binding lines in counterfactual\")\n\nEOF\n"]
