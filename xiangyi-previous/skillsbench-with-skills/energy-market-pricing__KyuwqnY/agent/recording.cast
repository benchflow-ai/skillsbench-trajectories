[342.812782, "o", "\u001b[?2004h> "]
[342.812859, "o", "                    'limit_MW': float(limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.812945, "o", "                })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[342.813024, "o", ">     results = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
