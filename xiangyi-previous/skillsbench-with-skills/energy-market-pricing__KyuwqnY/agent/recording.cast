[342.817329, "o", "\u001b[?2004h> "]
[342.81741, "o", "for base_lmp in results_base['lmp_by_bus']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.817591, "o", "    cf_lmp = next((x for x in results_cf['lmp_by_bus'] if x['bus'] == base_lmp['bus']), None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.817714, "o", "    if cf_lmp:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.817829, "o", "        drop = base_lmp['lmp_dollars_per_MWh'] - cf_lmp['lmp_dollars_per_MWh']\r\n\u001b[?2004l\r"]
[342.817918, "o", "\u001b[?2004h>         lmp_drops.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.818001, "o", "            'bus': base_lmp['bus'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.818062, "o", "            'base_lmp': base_lmp['lmp_dollars_per_MWh'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.818142, "o", "> "]
[342.818215, "o", "            'cf_lmp': cf_lmp['lmp_dollars_per_MWh'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.818294, "o", "            'delta': drop\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[342.8184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.818448, "o", "lmp_drops.sort(key=lambda x: x['delta'], reverse=True)\r\n\u001b[?2004l\r"]
[342.818552, "o", "\u001b[?2004h> "]
[342.818666, "o", "report['impact_analysis']['buses_with_largest_lmp_drop'] = lmp_drops[:3]\r\n\u001b[?2004l\r"]
[342.81875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.818829, "o", "with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.818914, "o", "> "]
