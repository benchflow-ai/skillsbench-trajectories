[136.019499, "o", "gens = np.array(network['gen'])\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[136.019595, "o", "branches = np.array(network['branch'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.01968, "o", "gencost = np.array(network['gencost'])\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[136.019806, "o", "reserve_capacity = np.array(network['reserve_capacity'])\r\n\u001b[?2004l\r[\u001b[?2004h> "]
[136.019901, "o", "reserve_requirement = network['reserve_requirement']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[136.019938, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.019976, "o", "# Extract bus data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020052, "o", "bus_ids = buses[:, 0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020183, "o", "bus_type = buses[:, 1].astype(int)  # 1=PQ, 2=PV, 3=ref\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020261, "o", "bus_pd = buses[:, 2]  # Real power demand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020518, "o", "bus_qd = buses[:, 3]  # Reactive power demand\r\n\u001b[?2004l\r\r\n\u001b[?2004h> bus_vmax = buses[:, 11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020591, "o", "bus_vmin = buses[:, 12]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020711, "o", "# Extract generator data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.020823, "o", "gen_bus = gens[:, 0].astype(int)\r\n\u001b[?2004l\r"]
[136.020852, "o", "\u001b[?2004h> "]
[136.020991, "o", "gen_pg = gens[:, 1]  # Real power output\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.021021, "o", "> "]
[136.02114, "o", "gen_pmax = gens[:, 8]  # Max power\r\n\u001b[?2004l\r"]
[136.02122, "o", "\u001b[?2004h> "]
[136.021285, "o", "gen_pmin = gens[:, 9]  # Min power\r\n\u001b[?2004l\r"]
[136.02133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.021421, "o", "> # Extract branch data\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.021497, "o", "> "]
[136.021568, "o", "branch_from = branches[:, 0].astype(int)\r\n\u001b[?2004l\r"]
[136.021631, "o", "\u001b[?2004h> "]
[136.021728, "o", "branch_to = branches[:, 1].astype(int)\r\n\u001b[?2004l\r"]
[136.021797, "o", "\u001b[?2004h> "]
[136.021893, "o", "branch_r = branches[:, 2]  # Resistance\r\n\u001b[?2004l\r"]
[136.021966, "o", "\u001b[?2004h> "]
[136.022062, "o", "branch_x = branches[:, 3]  # Reactance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.022227, "o", "branch_rate = branches[:, 5]  # Thermal limit (MVA)\r\n\u001b[?2004l\r"]
[136.022303, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.022405, "o", "> "]
[136.022488, "o", "# Extract cost data (quadratic cost function)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.022594, "o", "cost_type = gencost[:, 0].astype(int)\r\n\u001b[?2004l\r"]
[136.022672, "o", "\u001b[?2004h> "]
[136.022743, "o", "cost_startup = gencost[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.022831, "o", "cost_shutdown = gencost[:, 2]\r\n\u001b[?2004l\r"]
[136.022924, "o", "\u001b[?2004h> "]
[136.022994, "o", "cost_n = gencost[:, 3].astype(int)\r\n\u001b[?2004l\r"]
[136.023033, "o", "\u001b[?2004h> "]
[136.023142, "o", "cost_coeffs = gencost[:, 4:]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.023284, "o", "def solve_market(branches_modified=None):\r\n\u001b[?2004l\r"]
[136.023363, "o", "\u001b[?2004h> "]
[136.023405, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.023512, "o", "    Solve DC-OPF with reserve co-optimization\r\n\u001b[?2004l\r"]
[136.02358, "o", "\u001b[?2004h> "]
[136.02362, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.023732, "o", "    num_buses = len(bus_ids)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.023805, "o", "    num_gens = len(gen_bus)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.023933, "o", "    num_branches = len(branch_from)\r\n\u001b[?2004l\r"]
[136.024005, "o", "\u001b[?2004h>     "]
[136.024042, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.024128, "o", "    # Decision variables\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.024297, "o", "    pg = cp.Variable(num_gens)  # Generator dispatch (MW)\r\n\u001b[?2004l\r"]
[136.024324, "o", "\u001b[?2004h> "]
[136.02452, "o", "    reserve = cp.Variable(num_gens)  # Spinning reserve (MW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.024573, "o", "> "]
[136.024784, "o", "    theta = cp.Variable(num_buses)  # Bus voltage angles (radians)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.02502, "o", "    reserve_price = cp.Variable(1)  # Reserve market clearing price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.025064, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.025182, "o", "    # Objective: minimize total cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.025227, "o", "> "]
[136.025358, "o", "    # Cost = generation cost + reserve cost\r\n\u001b[?2004l\r"]
[136.025432, "o", "\u001b[?2004h> "]
[136.025535, "o", "    gen_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.025579, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.025609, "o", "> "]
[136.025748, "o", "        if cost_n[i] == 3:  # Quadratic cost\r\n\u001b[?2004l\r"]
[136.025848, "o", "\u001b[?2004h> "]
[136.025954, "o", "            c2 = cost_coeffs[i, 0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.026023, "o", "            c1 = cost_coeffs[i, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.026146, "o", "            c0 = cost_coeffs[i, 2]\r\n\u001b[?2004l\r"]
[136.026215, "o", "\u001b[?2004h> "]
[136.026369, "o", "            gen_cost += c2 * cp.square(pg[i]) + c1 * pg[i] + c0\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.026449, "o", "> "]
[136.026555, "o", "        elif cost_n[i] == 2:  # Linear cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.026661, "o", "> "]
[136.026747, "o", "            c1 = cost_coeffs[i, 0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.026831, "o", "            c0 = cost_coeffs[i, 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.026872, "o", "> "]
[136.026982, "o", "            gen_cost += c1 * pg[i] + c0\r\n\u001b[?2004l\r"]
[136.027014, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.02706, "o", "\u001b[?2004h> "]
[136.027231, "o", "    reserve_cost = reserve_price[0] * cp.sum(reserve)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.027313, "o", "> "]
[136.027387, "o", "    objective = gen_cost + reserve_cost\r\n\u001b[?2004l\r"]
[136.02746, "o", "\u001b[?2004h>     \r\n"]
[136.027545, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.027625, "o", "    constraints = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.027707, "o", "    # Generator constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.02792, "o", "    constraints.extend([pg >= gen_pmin])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.027982, "o", "    constraints.extend([pg <= gen_pmax])\r\n\u001b[?2004l\r"]
[136.028104, "o", "\u001b[?2004h> "]
[136.028188, "o", "    constraints.extend([reserve >= 0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.028231, "o", "    constraints.extend([reserve <= reserve_capacity])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.028333, "o", "    constraints.extend([pg + reserve <= gen_pmax])  # Reserve coupling constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.028397, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.028435, "o", "> "]
[136.028472, "o", "    # Bus angle constraints (slack bus at 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.02851, "o", "> "]
[136.028595, "o", "    constraints.append(theta[0] == 0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.028634, "o", "> "]
[136.028711, "o", "    # Power balance constraints (DC approximation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.028781, "o", "> "]
[136.02882, "o", "    for b_idx, bus_id in enumerate(bus_ids):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.028969, "o", "        # Sum of generation at this bus\r\n\u001b[?2004l\r\u001b[?2004h>         gen_at_bus = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.029009, "o", "> "]
[136.029157, "o", "        for g_idx, g_bus in enumerate(gen_bus):\r\n\u001b[?2004l\r\u001b[?2004h>             if g_bus == bus_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029231, "o", "                gen_at_bus += pg[g_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029253, "o", "        \r\n\u001b[?2004l\r"]
[136.02928, "o", "\u001b[?2004h"]
[136.029393, "o", ">         # Sum of flows from this bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029429, "o", "        flow_from_bus = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029502, "o", "        flow_to_bus = 0\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.029539, "o", "> "]
[136.02961, "o", "        for br_idx in range(num_branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029806, "o", "            if branch_from[br_idx] == bus_id:\r\n\u001b[?2004l\r\u001b[?2004h>                 # Find bus indices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.029898, "o", "                to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[136.029933, "o", "\u001b[?2004h> "]
[136.030038, "o", "                x = branch_x[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.03007, "o", "                if x != 0:\r\n\u001b[?2004l\r"]
[136.030163, "o", "\u001b[?2004h> "]
[136.030233, "o", "                    flow = (theta[b_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.030315, "o", "                    flow_from_bus += flow\r\n\u001b[?2004l\r"]
[136.030347, "o", "\u001b[?2004h> "]
[136.030425, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.030463, "o", "            if branch_to[br_idx] == bus_id:\r\n\u001b[?2004l\r"]
[136.030515, "o", "\u001b[?2004h> "]
[136.030668, "o", "                from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.030702, "o", "                x = branch_x[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.030801, "o", "                if x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.030877, "o", "                    flow = (theta[from_idx] - theta[b_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.030919, "o", "> "]
[136.031021, "o", "                    flow_to_bus += flow\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.031115, "o", "        # Power balance: generation = demand + net outflow\r\n\u001b[?2004l\r"]
[136.03119, "o", "\u001b[?2004h> "]
[136.03128, "o", "        constraints.append(gen_at_bus == bus_pd[b_idx] + flow_from_bus + flow_to_bus)\r\n\u001b[?2004l\r"]
[136.031316, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.03141, "o", "\u001b[?2004h>     # Transmission line constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.031482, "o", "    for br_idx in range(num_branches):\r\n\u001b[?2004l\r"]
[136.031545, "o", "\u001b[?2004h> "]
[136.031607, "o", "        from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\r\n\u001b[?2004l\r"]
[136.031667, "o", "\u001b[?2004h> "]
[136.031768, "o", "        to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.03184, "o", "        x = branch_x[br_idx]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n"]
[136.031878, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[136.031974, "o", "        if x != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.032047, "o", "            limit = branch_rate[br_idx]\r\n\u001b[?2004l\r"]
[136.032086, "o", "\u001b[?2004h> "]
[136.032183, "o", "            if branches_modified is not None and br_idx in branches_modified:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.032262, "o", "                limit = branches_modified[br_idx]\r\n\u001b[?2004l\r"]
[136.03234, "o", "\u001b[?2004h> "]
[136.032382, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.032479, "o", "            flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.032565, "o", "            constraints.extend([flow <= limit, flow >= -limit])\r\n\u001b[?2004l\r"]
[136.032599, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.032637, "o", "\u001b[?2004h> "]
[136.032726, "o", "    # Reserve requirement constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.032822, "o", "    constraints.append(cp.sum(reserve) >= reserve_requirement)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.032858, "o", ">     \r\n\u001b[?2004l\r"]
[136.032892, "o", "\u001b[?2004h> "]
[136.032977, "o", "    # Reserve price non-negativity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033015, "o", "    constraints.append(reserve_price >= 0)\r\n\u001b[?2004l\r"]
[136.03305, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.033085, "o", "\u001b[?2004h> "]
[136.033122, "o", "    # Solve\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033371, "o", "    problem = cp.Problem(cp.Minimize(objective), constraints)\r\n\u001b[?2004l\r\u001b[?2004h>     problem.solve(solver=cp.ECOS, verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033409, "o", "    if problem.status != cp.OPTIMAL:\r\n\u001b[?2004l\r"]
[136.033511, "o", "\u001b[?2004h>         print(f\"Warning: Solver status {problem.status}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.033575, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033656, "o", "    # Extract results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033697, "o", "    results = {\r\n\u001b[?2004l\r\u001b[?2004h>         'pg': pg.value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033789, "o", "        'reserve': reserve.value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.033825, "o", "        'theta': theta.value,\r\n\u001b[?2004l\r"]
[136.033927, "o", "\u001b[?2004h>         'total_cost': problem.value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.034129, "o", "        'reserve_price': reserve_price.value[0] if reserve_price.value is not None else 0,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[136.034245, "o", "\u001b[?2004h> "]
[136.034342, "o", "    return results, problem, theta, pg, reserve, reserve_price\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Solve base case\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.034423, "o", "print(\"Solving base case...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.034535, "o", "results_base, problem_base, theta_base, pg_base, reserve_base, rp_base = solve_market()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[136.034617, "o", "> "]
[136.03468, "o", "# Create modified branches for counterfactual (20% increase on line 64-1501)\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.034715, "o", "> "]
[136.034736, "o", "line_64_1501_idx = None\r\n\u001b[?2004l\r"]
[136.034879, "o", "\u001b[?2004h> "]
[136.034931, "o", "for br_idx in range(len(branch_from)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.035032, "o", "    if (branch_from[br_idx] == 64 and branch_to[br_idx] == 1501) or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.035095, "o", "       (branch_from[br_idx] == 1501 and branch_to[br_idx] == 64):\r\n\u001b[?2004l\r"]
[136.03512, "o", "\u001b[?2004h> "]
[136.035182, "o", "        line_64_1501_idx = br_idx\r\n\u001b[?2004l\r"]
[136.035204, "o", "\u001b[?2004h> "]
[136.035243, "o", "        break\r\n\u001b[?2004l\r"]
[136.035268, "o", "\u001b[?2004h> "]
[136.03529, "o", "\r\n\u001b[?2004l\r"]
[136.035315, "o", "\u001b[?2004h> "]
[136.03536, "o", "if line_64_1501_idx is not None:\r\n\u001b[?2004l\r"]
[136.035384, "o", "\u001b[?2004h> "]
[136.035525, "o", "    branches_modified = {line_64_1501_idx: branch_rate[line_64_1501_idx] * 1.2}\r\n\u001b[?2004l\r\u001b[?2004h"]
