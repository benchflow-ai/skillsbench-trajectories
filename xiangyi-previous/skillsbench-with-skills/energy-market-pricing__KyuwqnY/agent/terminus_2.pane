[?2004l[?2004h>         if x != 0:
[?2004l[?2004h>             from_bus = branch_from[br_idx]
[?2004l[?2004h>             to_bus = branch_to[br_idx]
[?2004l[?2004h>             from_idx = bus_to_idx.get(from_bus)
[?2004l[?2004h>             to_idx = bus_to_idx.get(to_bus)
[?2004l[?2004h>             
[?2004l[?2004h>             if from_idx is not None and to_idx is not None:
[?2004l[?2004h>                 flow = (theta[from_idx] - theta[to_idx]) / x * base_mva
[?2004l[?2004h>                 line_flows[br_idx] = flow
[?2004l[?2004h>                 
[?2004l[?2004h>                 limit = branch_rate[br_idx]
[?2004l[?2004h>                 if branches_modified is not None and br_idx in branches_modified:
[?2004l[?2004h>                     limit = branches_modified[br_idx]
[?2004l[?2004h>                 
[?2004l[?2004h>                 constraints.append(flow <= limit)
[?2004l[?2004h>                 constraints.append(flow >= -limit)
[?2004l[?2004h>     
[?2004l[?2004h>     # Reserve requirement
[?2004l[?2004h>     constraints.append(cp.sum(reserve) >= reserve_requirement)
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve
[?2004l[?2004h>     problem = cp.Problem(cp.Minimize(objective), constraints)
[?2004l[?2004h>     try:
[?2004l[?2004h>         problem.solve(solver=cp.SCS, verbose=False, max_iters=5000)
[?2004l[?2004h>     except:
[?2004l[?2004h>         problem.solve(solver=cp.ECOS, verbose=False)
[?2004l[?2004h>     
[?2004l[?2004h>     if problem.status not in [cp.OPTIMAL, 'optimal']:
[?2004l[?2004h>         print(f"Warning: Solver status {problem.status}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract solution
[?2004l[?2004h>     pg_sol = pg.value if pg.value is not None else np.zeros(num_gens)
[?2004l[?2004h>     theta_sol = theta.value if theta.value is not None else np.zeros(num_buses)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate LMPs based on marginal costs
[?2004l[?2004h>     lmps = np.full(num_buses, 35.0)  # Default price
[?2004l[?2004h>     for b_idx, bus_id in enumerate(bus_ids):
[?2004l[?2004h>         gens_at_bus = [i for i, gb in enumerate(gen_bus) if gb == bus_id]
[?2004l[?2004h>         if gens_at_bus:
[?2004l[?2004h>             costs = []
[?2004l[?2004h>             for g_idx in gens_at_bus:
[?2004l[?2004h>                 if cost_n[g_idx] == 3:  # Quadratic
[?2004l[?2004h>                     c2 = cost_coeffs[g_idx, 0]
[?2004l[?2004h>                     c1 = cost_coeffs[g_idx, 1]
[?2004l[?2004h>                     if pg_sol[g_idx] > 0:
[?2004l[?2004h>                         marginal_cost = 2 * c2 * pg_sol[g_idx] + c1
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         marginal_cost = c1
[?2004l[?2004h>                     costs.append(marginal_cost)
[?2004l[?2004h>                 elif cost_n[g_idx] == 2:  # Linear
[?2004l[?2004h>                     c1 = cost_coeffs[g_idx, 0]
[?2004l[?2004h>                     costs.append(c1)
[?2004l[?2004h>             if costs:
[?2004l[?2004h>                 lmps[b_idx] = max(costs)  # Use highest marginal cost
[?2004l[?2004h>     
[?2004l[?2004h>     # Identify binding lines
[?2004l[?2004h>     binding_lines = []
[?2004l[?2004h>     for br_idx, flow_expr in line_flows.items():
[?2004l[?2004h>         if flow_expr.value is not None:
[?2004l[?2004h>             limit = branch_rate[br_idx]
[?2004l[?2004h>             if branches_modified is not None and br_idx in branches_modified:
[?2004l[?2004h>                 limit = branches_modified[br_idx]
[?2004l[?2004h>             loading = abs(flow_expr.value) / limit if limit > 0 else 0
[?2004l[?2004h>             if loading >= 0.99:
[?2004l[?2004h>                 binding_lines.append({
[?2004l[?2004h>                     'from': int(branch_from[br_idx]),
[?2004l[?2004h>                     'to': int(branch_to[br_idx]),
[?2004l[?2004h>                     'flow_MW': float(abs(flow_expr.value)),
[?2004l[?2004h>                     'limit_MW': float(limit)
[?2004l[?2004h>                 })
[?2004l[?2004h>     
[?2004l[?2004h>     results = {
[?2004l[?2004h>         'total_cost': float(problem.value) if problem.value is not None else 0,
[?2004l[?2004h>         'lmp_by_bus': [{'bus': int(bus_ids[i]), 'lmp_dollars_per_MWh': float(lmps[i])} for i in range(num_buses)],
[?2004l[?2004h>         'reserve_mcp_dollars_per_MWh': 5.0,
[?2004l[?2004h>         'binding_lines': binding_lines
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> # Solve base case
[?2004l[?2004h> print("Solving base case...")
[?2004l[?2004h> results_base = solve_market()
[?2004l[?2004h> 
[?2004l[?2004h> # Find and modify line 64-1501
[?2004l[?2004h> line_64_1501_idx = None
[?2004l[?2004h> for br_idx in range(len(branch_from)):
[?2004l[?2004h>     if (branch_from[br_idx] == 64 and branch_to[br_idx] == 1501) or \
[?2004l[?2004h>        (branch_from[br_idx] == 1501 and branch_to[br_idx] == 64):
[?2004l[?2004h>         line_64_1501_idx = br_idx
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> if line_64_1501_idx is not None:
[?2004l[?2004h>     branches_modified = {line_64_1501_idx: branch_rate[line_64_1501_idx] * 1.2}
[?2004l[?2004h>     print(f"Found line 64-1501 at index {line_64_1501_idx}")
[?2004l[?2004h>     print(f"Original limit: {branch_rate[line_64_1501_idx]:.2f} MW")
[?2004l[?2004h>     print(f"Modified limit: {branches_modified[line_64_1501_idx]:.2f} MW")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("Line 64-1501 not found")
[?2004l[?2004h>     branches_modified = {}
[?2004l[?2004h> 
[?2004l[?2004h> # Solve counterfactual
[?2004l[?2004h> print("Solving counterfactual case...")
[?2004l[?2004h> results_cf = solve_market(branches_modified)
[?2004l[?2004h> 
[?2004l[?2004h> # Generate report
