[?2004l[?2004h>             'cf_lmp': cf_lmp['lmp_dollars_per_MWh'],
[?2004l[?2004h>             'delta': drop
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> lmp_drops.sort(key=lambda x: x['delta'], reverse=True)
[?2004l[?2004h> report['impact_analysis']['buses_with_largest_lmp_drop'] = lmp_drops[:3]
[?2004l[?2004h> 
