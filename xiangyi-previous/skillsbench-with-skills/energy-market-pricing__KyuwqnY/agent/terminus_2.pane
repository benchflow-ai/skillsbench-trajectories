[?2004l[?2004h> cost_coeffs = gencost[:, 4:]
[?2004l[?2004h> 
[?2004l[?2004h> def solve_market(branches_modified=None):
[?2004l[?2004h>     """
[?2004l[?2004h>     Solve DC-OPF with reserve co-optimization
[?2004l[?2004h>     """
[?2004l[?2004h>     num_buses = len(bus_ids)
[?2004l[?2004h>     num_gens = len(gen_bus)
[?2004l[?2004h>     num_branches = len(branch_from)
[?2004l[?2004h>     
[?2004l[?2004h>     # Decision variables
[?2004l[?2004h>     pg = cp.Variable(num_gens)  # Generator dispatch (MW)
[?2004l[?2004h>     reserve = cp.Variable(num_gens)  # Spinning reserve (MW)
[?2004l[?2004h>     theta = cp.Variable(num_buses)  # Bus voltage angles (radians)
[?2004l[?2004h>     reserve_price = cp.Variable(1)  # Reserve market clearing price
[?2004l[?2004h>     
[?2004l[?2004h>     # Objective: minimize total cost
[?2004l[?2004h>     # Cost = generation cost + reserve cost
[?2004l[?2004h>     gen_cost = 0
[?2004l[?2004h>     for i in range(num_gens):
[?2004l[?2004h>         if cost_n[i] == 3:  # Quadratic cost
[?2004l[?2004h>             c2 = cost_coeffs[i, 0]
[?2004l[?2004h>             c1 = cost_coeffs[i, 1]
[?2004l[?2004h>             c0 = cost_coeffs[i, 2]
[?2004l[?2004h>             gen_cost += c2 * cp.square(pg[i]) + c1 * pg[i] + c0
[?2004l[?2004h>         elif cost_n[i] == 2:  # Linear cost
[?2004l[?2004h>             c1 = cost_coeffs[i, 0]
[?2004l[?2004h>             c0 = cost_coeffs[i, 1]
[?2004l[?2004h>             gen_cost += c1 * pg[i] + c0
[?2004l[?2004h>     
[?2004l[?2004h>     reserve_cost = reserve_price[0] * cp.sum(reserve)
[?2004l[?2004h>     objective = gen_cost + reserve_cost
[?2004l[?2004h>     
[?2004l[?2004h>     constraints = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Generator constraints
[?2004l[?2004h>     constraints.extend([pg >= gen_pmin])
[?2004l[?2004h>     constraints.extend([pg <= gen_pmax])
[?2004l[?2004h>     constraints.extend([reserve >= 0])
[?2004l[?2004h>     constraints.extend([reserve <= reserve_capacity])
[?2004l[?2004h>     constraints.extend([pg + reserve <= gen_pmax])  # Reserve coupling constraint
[?2004l[?2004h>     
[?2004l[?2004h>     # Bus angle constraints (slack bus at 0)
[?2004l[?2004h>     constraints.append(theta[0] == 0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Power balance constraints (DC approximation)
[?2004l[?2004h>     for b_idx, bus_id in enumerate(bus_ids):
[?2004l[?2004h>         # Sum of generation at this bus
[?2004l[?2004h>         gen_at_bus = 0
[?2004l[?2004h>         for g_idx, g_bus in enumerate(gen_bus):
[?2004l[?2004h>             if g_bus == bus_id:
[?2004l[?2004h>                 gen_at_bus += pg[g_idx]
[?2004l[?2004h>         
[?2004l[?2004h>         # Sum of flows from this bus
[?2004l[?2004h>         flow_from_bus = 0
[?2004l[?2004h>         flow_to_bus = 0
[?2004l[?2004h>         
[?2004l[?2004h>         for br_idx in range(num_branches):
[?2004l[?2004h>             if branch_from[br_idx] == bus_id:
[?2004l[?2004h>                 # Find bus indices
[?2004l[?2004h>                 to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]
[?2004l[?2004h>                 x = branch_x[br_idx]
[?2004l[?2004h>                 if x != 0:
[?2004l[?2004h>                     flow = (theta[b_idx] - theta[to_idx]) / x * base_mva
[?2004l[?2004h>                     flow_from_bus += flow
[?2004l[?2004h>             
[?2004l[?2004h>             if branch_to[br_idx] == bus_id:
[?2004l[?2004h>                 from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]
[?2004l[?2004h>                 x = branch_x[br_idx]
[?2004l[?2004h>                 if x != 0:
[?2004l[?2004h>                     flow = (theta[from_idx] - theta[b_idx]) / x * base_mva
[?2004l[?2004h>                     flow_to_bus += flow
[?2004l[?2004h>         
[?2004l[?2004h>         # Power balance: generation = demand + net outflow
[?2004l[?2004h>         constraints.append(gen_at_bus == bus_pd[b_idx] + flow_from_bus + flow_to_bus)
[?2004l[?2004h>     
[?2004l[?2004h>     # Transmission line constraints
[?2004l[?2004h>     for br_idx in range(num_branches):
[?2004l[?2004h>         from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]
[?2004l[?2004h>         to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]
[?2004l[?2004h>         x = branch_x[br_idx]
[?2004l[?2004h>         
[?2004l[?2004h>         if x != 0:
[?2004l[?2004h>             limit = branch_rate[br_idx]
[?2004l[?2004h>             if branches_modified is not None and br_idx in branches_modified:
[?2004l[?2004h>                 limit = branches_modified[br_idx]
[?2004l[?2004h>             
[?2004l[?2004h>             flow = (theta[from_idx] - theta[to_idx]) / x * base_mva
[?2004l[?2004h>             constraints.extend([flow <= limit, flow >= -limit])
[?2004l[?2004h>     
[?2004l[?2004h>     # Reserve requirement constraint
[?2004l[?2004h>     constraints.append(cp.sum(reserve) >= reserve_requirement)
[?2004l[?2004h>     
[?2004l[?2004h>     # Reserve price non-negativity
[?2004l[?2004h>     constraints.append(reserve_price >= 0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve
[?2004l[?2004h>     problem = cp.Problem(cp.Minimize(objective), constraints)
[?2004l[?2004h>     problem.solve(solver=cp.ECOS, verbose=False)
[?2004l[?2004h>     
[?2004l[?2004h>     if problem.status != cp.OPTIMAL:
[?2004l[?2004h>         print(f"Warning: Solver status {problem.status}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract results
[?2004l[?2004h>     results = {
[?2004l[?2004h>         'pg': pg.value,
[?2004l[?2004h>         'reserve': reserve.value,
[?2004l[?2004h>         'theta': theta.value,
[?2004l[?2004h>         'total_cost': problem.value,
[?2004l[?2004h>         'reserve_price': reserve_price.value[0] if reserve_price.value is not None else 0,
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     return results, problem, theta, pg, reserve, reserve_price
[?2004l[?2004h> 
