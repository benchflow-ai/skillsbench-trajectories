[?2004ls[?2004h> def segment_raw_text(raw_text):
[?2004l[?2004h>     """Segment raw text into individual issues"""
[?2004l[?2004h>     segments = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Split by common delimiters but be more careful
[?2004l[?2004h>     # Use / and & as primary delimiters, but keep "and" phrases together
[?2004l[?2004h>     parts = re.split(r'\s*/\s*|\s*&\s*', raw_text)
[?2004l[?2004h>     
[?2004l[?2004h>     if len(parts) > 1:
[?2004l[?2004h>         for part in parts:
[?2004l[?2004h>             part = part.strip()
[?2004l[?2004h>             if len(part) > 3:  # Minimum meaningful length
[?2004l[?2004h>                 segments.append(part)
[?2004l[?2004h>     
[?2004l[?2004h>     # If no good split found, return whole text
[?2004l[?2004h>     if not segments:
[?2004l[?2004h>         segments = [raw_text.strip()]
[?2004l[?2004h>     
[?2004l[?2004h>     return segments
[?2004l[?2004h> 
[?2004l[?2004h> def find_best_match(segment, codebooks, product_id, station):
[?2004l[?2004h>     """Find the best matching code for a segment"""
[?2004l[?2004h>     if product_id not in codebooks:
[?2004l[?2004h>         return None, 0.0, []
[?2004l[?2004h>     
[?2004l[?2004h>     best_score = 0.0
[?2004l[?2004h>     best_match = None
[?2004l[?2004h>     best_matches_detail = []
[?2004l[?2004h>     
[?2004l[?2004h>     for entry in codebooks[product_id]:
[?2004l[?2004h>         score, matches = calculate_match_score(segment, entry)
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if station is in scope - apply penalty if not
[?2004l[?2004h>         station_scope = entry['station_scope'].upper()
[?2004l[?2004h>         if station.upper() not in station_scope:
[?2004l[?2004h>             score *= 0.8  # Small penalty for out-of-scope
[?2004l[?2004h>         
[?2004l[?2004h>         if score > best_score:
[?2004l[?2004h>             best_score = score
[?2004l[?2004h>             best_match = entry
[?2004l[?2004h>             best_matches_detail = matches
[?2004l[?2004h>     
[?2004l[?2004h>     return best_match, best_score, best_matches_detail
[?2004l[?2004h> 
[?2004l[?2004h> def normalize_logs(logs, codebooks):
[?2004l[?2004h>     """Normalize all logs"""
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for log in logs:
[?2004l[?2004h>         record_id = log['record_id']
[?2004l[?2004h>         product_id = log['product_id']
[?2004l[?2004h>         station = log['station']
[?2004l[?2004h>         engineer_id = log['engineer_id']
[?2004l[?2004h>         raw_reason_text = log['raw_reason_text']
[?2004l[?2004h>         
[?2004l[?2004h>         # Segment the raw text
[?2004l[?2004h>         segments = segment_raw_text(raw_reason_text)
[?2004l[?2004h>         
[?2004l[?2004h>         normalized = []
[?2004l[?2004h>         for i, segment in enumerate(segments, 1):
[?2004l[?2004h>             segment_id = f"{record_id}-S{i}"
[?2004l[?2004h>             
[?2004l[?2004h>             # Find best match
[?2004l[?2004h>             best_match, score, matches = find_best_match(segment, codebooks, product_id, station)
[?2004l[?2004h>             
[?2004l[?2004h>             # Dynamic threshold based on match quality
[?2004l[?2004h>             if best_match and score >= 0.35:  # Threshold for acceptable match
[?2004l[?2004h>                 # Calculate confidence based on score
[?2004l[?2004h>                 # Map score to confidence range [0.5, 0.95]
[?2004l[?2004h>                 confidence = min(0.95, max(0.50, score))
[?2004l[?2004h>                 pred_code = best_match['code']
[?2004l[?2004h>                 pred_label = best_match['standard_label']
[?2004l[?2004h>                 rationale = f"Matched: {', '.join(str(m) for m in matches[:6])}. Score: {score:.2f}"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 # Unknown - low confidence
[?2004l[?2004h>                 confidence = min(0.25, score * 0.6) if score > 0 else 0.10
[?2004l[?2004h>                 pred_code = "UNKNOWN"
[?2004l[?2004h>                 pred_label = ""
[?2004l[?2004h>                 rationale = f"No confident match. Best score: {score:.2f}. Segment may need manual review."
[?2004l[?2004h>             
[?2004l[?2004h>             normalized.append({
[?2004l[?2004h>                 "segment_id": segment_id,
[?2004l[?2004h>                 "span_text": segment,
[?2004l[?2004h>                 "pred_code": pred_code,
[?2004l[?2004h>                 "pred_label": pred_label,
[?2004l[?2004h>                 "confidence": round(confidence, 3),
[?2004l[?2004h>                 "rationale": rationale
[?2004l[?2004h>             })
[?2004l[?2004h>         
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             "record_id": record_id,
[?2004l[?2004h>             "product_id": product_id,
[?2004l[?2004h>             "station": station,
[?2004l[?2004h>             "engineer_id": engineer_id,
[?2004l[?2004h>             "raw_reason_text": raw_reason_text,
[?2004l[?2004h>             "normalized": normalized
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     return results
