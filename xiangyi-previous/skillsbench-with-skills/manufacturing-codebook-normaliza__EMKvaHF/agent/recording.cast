[279.607883, "o", "def segment_raw_text(raw_text):\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.60793, "o", ">     segments = []\r\n\u001b[?2004l\r"]
[279.607953, "o", "\u001b[?2004h> "]
[279.608104, "o", "    parts = re.split(r'\\s*/\\s*|\\s*&\\s*', raw_text)\r\n\u001b[?2004l\r"]
[279.608129, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r \u001b[?2004h> "]
[279.608213, "o", "    if len(parts) > 1:\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[279.608303, "o", "        for part in parts:\r\n\u001b[?2004l\r"]
[279.608354, "o", "\u001b[?2004h> "]
[279.608407, "o", "            part = part.strip()\r\n\u001b[?2004l\r"]
[279.608472, "o", "\u001b[?2004h> "]
[279.60851, "o", "            if len(part) > 3:\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.608564, "o", "> "]
[279.608629, "o", "                segments.append(part)\r\n\u001b[?2004l\r"]
[279.608651, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rl"]
[279.608669, "o", "\u001b[?2004h> "]
[279.608722, "o", "    if not segments:\r\n\u001b[?2004l\r"]
[279.608744, "o", "\u001b[?2004h> "]
[279.608834, "o", "        segments = [raw_text.strip()]\r\n\u001b[?2004l\r"]
[279.608851, "o", "\u001b[?2004h> "]
[279.608867, "o", "    \r\n\u001b[?2004l\ri\u001b[?2004h"]
[279.608886, "o", "> "]
[279.60893, "o", "    return segments\r\n\u001b[?2004l\r"]
[279.608952, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[279.608972, "o", "\u001b[?2004h> "]
[279.609131, "o", "def find_best_match(segment, codebooks, product_id, station):\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.609149, "o", "> "]
[279.609234, "o", "    if product_id not in codebooks:\r\n\u001b[?2004l\r"]
[279.609252, "o", "\u001b[?2004h> "]
[279.609332, "o", "        return None, 0.0, []\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.609355, "o", "> "]
[279.609376, "o", "    \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[279.60943, "o", "    best_score = 0.0\r\n\u001b[?2004l\r"]
[279.609449, "o", "\u001b[?2004h> "]
[279.609503, "o", "    best_match = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.609521, "o", "> "]
[279.60959, "o", "    best_matches_detail = []\r\n\u001b[?2004l\r"]
[279.609614, "o", "\u001b[?2004h> "]
[279.609634, "o", "    \r\n\u001b[?2004l\re\u001b[?2004h> "]
[279.609745, "o", "    for entry in codebooks[product_id]:\r\n\u001b[?2004l\r"]
[279.609762, "o", "\u001b[?2004h> "]
[279.609931, "o", "        score, matches = calculate_match_score(segment, entry)\r\n\u001b[?2004l\r"]
[279.609978, "o", "\u001b[?2004h>         "]
[279.610026, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.610122, "o", "        # Station scope bonus\r\n\u001b[?2004l\r"]
[279.61019, "o", "\u001b[?2004h> "]
[279.610257, "o", "        station_scope = entry['station_scope'].upper()\r\n\u001b[?2004l\r"]
[279.610279, "o", "\u001b[?2004h> "]
[279.610341, "o", "        if station.upper() in station_scope:\r\n\u001b[?2004l\r"]
[279.610362, "o", "\u001b[?2004h> "]
[279.610449, "o", "            score *= 1.1  # Small bonus for correct station\r\n\u001b[?2004l\r"]
[279.610484, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.61051, "o", "\u001b[?2004h> "]
[279.610556, "o", "        if score > best_score:\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.610578, "o", "> "]
[279.610618, "o", "            best_score = score\r\n\u001b[?2004l\r"]
[279.610639, "o", "\u001b[?2004h> "]
[279.610684, "o", "            best_match = entry\r\n\u001b[?2004l\r"]
[279.610709, "o", "\u001b[?2004h> "]
[279.610767, "o", "            best_matches_detail = matches\r\n\u001b[?2004l\r"]
[279.610791, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.610817, "o", "\u001b[?2004h> "]
[279.610907, "o", "    return best_match, best_score, best_matches_detail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.61093, "o", "\u001b[?2004h> "]
[279.610985, "o", "def normalize_logs(logs, codebooks):\r\n\u001b[?2004l\r"]
[279.611005, "o", "\u001b[?2004h> "]
[279.611029, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611063, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611089, "o", "> "]
[279.611118, "o", "    for log in logs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.611181, "o", "        record_id = log['record_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611202, "o", "> "]
[279.61126, "o", "        product_id = log['product_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611281, "o", "> "]
[279.61132, "o", "        station = log['station']\r\n\u001b[?2004l\r"]
[279.611339, "o", "\u001b[?2004h> "]
[279.611402, "o", "        engineer_id = log['engineer_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611422, "o", "> "]
[279.611495, "o", "        raw_reason_text = log['raw_reason_text']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611523, "o", ">         \r\n\u001b[?2004l\r"]
[279.611545, "o", "\u001b[?2004h> "]
[279.611615, "o", "        segments = segment_raw_text(raw_reason_text)\r\n\u001b[?2004l\r"]
[279.611632, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[279.611654, "o", "\u001b[?2004h> "]
[279.611698, "o", "        normalized = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611716, "o", "> "]
[279.61179, "o", "        for i, segment in enumerate(segments, 1):\r\n\u001b[?2004l\r"]
[279.611814, "o", "\u001b[?2004h> "]
[279.611884, "o", "            segment_id = f\"{record_id}-S{i}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.611905, "o", "> "]
[279.611929, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.612151, "o", "            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.612227, "o", "            # Lower threshold to 0.30 for better coverage\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.61225, "o", "> "]
[279.612305, "o", "            if best_match and score >= 0.30:\r\n\u001b[?2004l\r"]
[279.612324, "o", "\u001b[?2004h> "]
[279.612387, "o", "                # Map score to confidence\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.612405, "o", "> "]
[279.612452, "o", "                if score >= 0.8:\r\n\u001b[?2004l\r"]
[279.612472, "o", "\u001b[?2004h> "]
[279.612535, "o", "                    confidence = 0.90\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.612561, "o", "> "]
[279.612602, "o", "                elif score >= 0.6:\r\n\u001b[?2004l\r"]
[279.612621, "o", "\u001b[?2004h> "]
[279.612708, "o", "                    confidence = 0.75 + (score - 0.6) * 0.75\r\n\u001b[?2004l\r"]
[279.612727, "o", "\u001b[?2004h> "]
[279.612777, "o", "                elif score >= 0.4:\r\n\u001b[?2004l\r"]
[279.612799, "o", "\u001b[?2004h> "]
[279.612891, "o", "                    confidence = 0.60 + (score - 0.4) * 0.75\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.612912, "o", "> "]
[279.612946, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.613056, "o", "                    confidence = 0.50 + (score - 0.3) * 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.613085, "o", "                \r\n\u001b[?2004l\r"]
[279.613106, "o", "\u001b[?2004h> "]
[279.61318, "o", "                pred_code = best_match['code']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.613203, "o", "> "]
[279.61328, "o", "                pred_label = best_match['standard_label']\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.613303, "o", "> "]
[279.61344, "o", "                rationale = f\"Matched: {', '.join(str(m) for m in matches[:6])}. Score: {score:.2f}\"\r\n\u001b[?2004l\r"]
[279.613461, "o", "\u001b[?2004h> "]
[279.6135, "o", "            else:\r\n\u001b[?2004l\r"]
[279.613526, "o", "\u001b[?2004h> "]
[279.613632, "o", "                confidence = min(0.20, score * 0.5) if score > 0 else 0.08\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.613654, "o", "> "]
[279.613699, "o", "                pred_code = \"UNKNOWN\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.613719, "o", "> "]
[279.61377, "o", "                pred_label = \"\"\r\n\u001b[?2004l\r"]
[279.613791, "o", "\u001b[?2004h> "]
[279.61393, "o", "                rationale = f\"No confident match. Best score: {score:.2f}. Manual review needed.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.613951, "o", "> "]
[279.61398, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.614034, "o", "            normalized.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.614058, "o", "> "]
[279.614107, "o", "                \"segment_id\": segment_id,\r\n\u001b[?2004l\r"]
[279.614126, "o", "\u001b[?2004h> "]
[279.614184, "o", "                \"span_text\": segment,\r\n\u001b[?2004l\r"]
[279.614205, "o", "\u001b[?2004h> "]
[279.614258, "o", "                \"pred_code\": pred_code,\r\n\u001b[?2004l\r"]
[279.614277, "o", "\u001b[?2004h> "]
[279.614338, "o", "                \"pred_label\": pred_label,\r\n\u001b[?2004l\r"]
[279.614361, "o", "\u001b[?2004h> "]
[279.614438, "o", "                \"confidence\": round(confidence, 3),\r\n\u001b[?2004l\r"]
[279.61446, "o", "\u001b[?2004h> "]
[279.614518, "o", "                \"rationale\": rationale\r\n\u001b[?2004l\r"]
[279.614542, "o", "\u001b[?2004h> "]
[279.614574, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.614603, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.614663, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.61472, "o", "            \"record_id\": record_id,\r\n\u001b[?2004l\r"]
[279.614743, "o", "\u001b[?2004h> "]
[279.614797, "o", "            \"product_id\": product_id,\r\n\u001b[?2004l\r"]
[279.614819, "o", "\u001b[?2004h> "]
[279.614858, "o", "            \"station\": station,\r\n\u001b[?2004l\r"]
[279.614878, "o", "\u001b[?2004h> "]
[279.614936, "o", "            \"engineer_id\": engineer_id,\r\n\u001b[?2004l\r"]
[279.614956, "o", "\u001b[?2004h> "]
[279.615028, "o", "            \"raw_reason_text\": raw_reason_text,\r\n\u001b[?2004l\r"]
[279.615049, "o", "\u001b[?2004h> "]
[279.615099, "o", "            \"normalized\": normalized\r\n\u001b[?2004l\r"]
[279.61512, "o", "\u001b[?2004h> "]
[279.615155, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.615175, "o", "\u001b[?2004h> "]
[279.615213, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.615249, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.615275, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.615331, "o", "    print(\"Loading codebooks...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.615351, "o", "> "]
[279.615394, "o", "    codebooks = load_codebooks()\r\n\u001b[?2004l\r"]
[279.615437, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.61546, "o", "> "]
[279.615512, "o", "    print(\"Loading test logs...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.615537, "o", "> "]
[279.615576, "o", "    logs = load_test_logs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.615605, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.615714, "o", "    print(f\"Processing {len(logs)} records...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.615764, "o", "    results = normalize_logs(logs, codebooks)\r\n\u001b[?2004l\r"]
[279.615802, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[279.615828, "o", "\u001b[?2004h> "]
[279.615924, "o", "    output = {\"records\": results}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.615959, "o", "> "]
[279.615985, "o", "    print(\"Writing output...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.616093, "o", "    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.616112, "o", "> "]
[279.616198, "o", "        json.dump(output, f, ensure_ascii=False, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.616247, "o", ">     \r\n\u001b[?2004l\r"]
[279.616284, "o", "\u001b[?2004h>     print(\"Done!\")\r\n\u001b[?2004l\r"]
[279.616309, "o", "\u001b[?2004h> "]
[279.616381, "o", "    print(f\"Processed {len(results)} records\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.616417, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.616519, "o", "    total_segments = sum(len(r['normalized']) for r in results)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.616539, "o", "> "]
[279.61668, "o", "    unknown_count = sum(1 for r in results for n in r['normalized'] if n['pred_code'] == 'UNKNOWN')\r\n\u001b[?2004l\r"]
[279.616704, "o", "\u001b[?2004h> "]
[279.616772, "o", "    known_count = total_segments - unknown_count\r\n\u001b[?2004l\r"]
[279.616799, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.616822, "o", "> "]
[279.616891, "o", "    print(f\"Total segments: {total_segments}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.616911, "o", "> "]
[279.617035, "o", "    print(f\"Known matches: {known_count} ({known_count/total_segments*100:.1f}%)\")\r\n\u001b[?2004l\r"]
[279.617057, "o", "\u001b[?2004h> "]
[279.617167, "o", "    print(f\"Unknown: {unknown_count} ({unknown_count/total_segments*100:.1f}%)\")\r\n\u001b[?2004l\r"]
[279.617189, "o", "\u001b[?2004h> "]
[279.617216, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.617345, "o", "    confidences = [n['confidence'] for r in results for n in r['normalized']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.617382, "o", "    if confidences:\r\n\u001b[?2004l\r"]
[279.617406, "o", "\u001b[?2004h> "]
[279.617521, "o", "        print(f\"Confidence - Mean: {sum(confidences)/len(confidences):.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.617542, "o", "> "]
[279.617605, "o", "        confidences_sorted = sorted(confidences)\r\n\u001b[?2004l\r"]
[279.617624, "o", "\u001b[?2004h> "]
[279.617758, "o", "        print(f\"Confidence - Median: {confidences_sorted[len(confidences_sorted)//2]:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.617777, "o", "> "]
[279.617904, "o", "        print(f\"Confidence - Min: {min(confidences):.3f}, Max: {max(confidences):.3f}\")\r\n\u001b[?2004l\r"]
[279.617927, "o", "\u001b[?2004h> "]
[279.61805, "o", "        print(f\"Confidence - P25: {confidences_sorted[len(confidences_sorted)//4]:.3f}\")\r\n\u001b[?2004l\r"]
[279.618069, "o", "\u001b[?2004h> "]
[279.618202, "o", "        print(f\"Confidence - P75: {confidences_sorted[3*len(confidences_sorted)//4]:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.618224, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.618243, "o", "> "]
[279.618287, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[279.618314, "o", "\u001b[?2004h> "]
[279.618336, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
