[279.594276, "i", "cat > /app/normalize_final.py << 'EOFPY'\nimport csv\nimport json\nimport re\n\ndef load_codebooks(data_dir='/app/data/'):\n    codebooks = {}\n    products = ['P1_POWER', 'P2_CTRL', 'P3_RF']\n    for product in products:\n        codebooks[product] = []\n        with open(f'{data_dir}/codebook_{product}.csv', 'r', encoding='utf-8') as f:\n            reader = csv.DictReader(f)\n            for row in reader:\n                codebooks[product].append(row)\n    return codebooks\n\ndef load_test_logs(filepath='/app/data/test_center_logs.csv'):\n    logs = []\n    with open(filepath, 'r', encoding='utf-8') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            logs.append(row)\n    return logs\n\ndef extract_components_signals(text):\n    components = set(re.findall(r'\\b[A-Z]\\d+[A-Z]?\\b', text, re.IGNORECASE))\n    signals = set(re.findall(r'\\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b', text))\n    return list(components), list(signals)\n\ndef calculate_match_score(raw_text, codebook_entry):\n    raw_lower = raw_text.lower()\n    raw_components, raw_signals = extract_components_signals(raw_text)\n    \n    cb_label = codebook_entry['standard_label']\n    cb_keywords = codebook_entry['keywords_examples']\n    cb_components, cb_signals = extract_components_signals(cb_label)\n    \n    score = 0.0\n    matches = []\n    \n    # Exact component match\n    for comp in raw_components:\n        if comp.upper() in [c.upper() for c in cb_components]:\n            score += 0.5\n            matches.append(f\"comp:{comp}\")\n    \n    # Exact signal match\n    for sig in raw_signals:\n        if sig.upper() in [s.upper() for s in cb_signals]:\n            score += 0.5\n            matches.append(f\"sig:{sig}\")\n    \n    # Defect type matching (critical for fallback)\n    if 'open' in cb_label.lower():\n        if 'open' in raw_lower or '开路' in raw_text or ' os ' in raw_lower or 'os (' in raw_lower:\n            score += 0.35\n            matches.append('OPEN')\n    \n    if 'short' in cb_label.lower():\n        if 'short' in raw_lower or '短路' in raw_text or 'bridge' in raw_lower:\n            score += 0.35\n            matches.append('SHORT')\n    \n    if 'cold solder' in cb_label.lower() or 'solder' in cb_label.lower():\n        if 'cold solder' in raw_lower or '虚焊' in raw_text or '少锡' in raw_text or \\\n           '浮高' in raw_text or 'missing solder' in raw_lower or 'solder' in raw_lower:\n            score += 0.35\n            matches.append('SOLDER')\n    \n    if 'fixture' in cb_label.lower() and 'contact' in cb_label.lower():\n        if 'fixture' in raw_lower or 'pogo' in raw_lower or 'probe' in raw_lower or \\\n           'reseat' in raw_lower or '接触不良' in raw_text or '探针' in raw_text or \\\n           '重插' in raw_text or '治具' in raw_text or 'contact' in raw_lower or \\\n           'pin' in raw_lower and 'contact' in raw_lower:\n            score += 0.45\n            matches.append('FIXTURE_CONTACT')\n    \n    if 'probe worn' in cb_label.lower() or 'pin' in cb_label.lower() and 'degrad' in cb_label.lower():\n        if '磨损' in raw_text or 'worn' in raw_lower or '换针' in raw_text or 'replace pin' in raw_lower:\n            score += 0.45\n            matches.append('PROBE_WORN')\n    \n    if 'program' in cb_label.lower() or 'flash' in cb_label.lower():\n        if 'program' in raw_lower or 'flash' in raw_lower or '烧录' in raw_text or \\\n           '写入' in raw_text or 'reflash' in raw_lower or 'burn' in raw_lower:\n            score += 0.40\n            matches.append('PROGRAMMING')\n    \n    if 'verif' in cb_label.lower() or 'crc' in cb_label.lower():\n        if 'verif' in raw_lower or 'crc' in raw_lower or '校验' in raw_text or 'checksum' in raw_lower:\n            score += 0.40\n            matches.append('VERIFICATION')\n    \n    if 'current' in cb_label.lower() and ('high' in cb_label.lower() or 'idle' in cb_label.lower()):\n        if 'current' in raw_lower or '电流' in raw_text or 'icc' in raw_lower or \\\n           '功耗' in raw_text or 'consumption' in raw_lower or 'idle' in raw_lower:\n            score += 0.40\n            matches.appen"]
[279.59436, "i", "d('CURRENT_HIGH')\n    \n    if 'missing' in cb_label.lower() and 'component' in cb_label.lower():\n        if 'missing' in raw_lower or '少件' in raw_text or 'no component' in raw_lower:\n            score += 0.40\n            matches.append('MISSING_COMP')\n    \n    # OS/Boot failure\n    if 'os' in cb_label.lower() or 'boot' in cb_label.lower() or 'start' in cb_label.lower():\n        if 'os fail' in raw_lower or '启动' in raw_text or 'boot' in raw_lower or 'start' in raw_lower:\n            score += 0.35\n            matches.append('OS_BOOT')\n    \n    # Keyword matching (lower weight)\n    keyword_list = [k.strip() for k in cb_keywords.lower().split(',')]\n    for kw in keyword_list:\n        if kw and len(kw) > 2 and kw in raw_lower:\n            score += 0.05\n    \n    return score, matches\n\ndef segment_raw_text(raw_text):\n    segments = []\n    parts = re.split(r'\\s*/\\s*|\\s*&\\s*', raw_text)\n    \n    if len(parts) > 1:\n        for part in parts:\n            part = part.strip()\n            if len(part) > 3:\n                segments.append(part)\n    \n    if not segments:\n        segments = [raw_text.strip()]\n    \n    return segments\n\ndef find_best_match(segment, codebooks, product_id, station):\n    if product_id not in codebooks:\n        return None, 0.0, []\n    \n    best_score = 0.0\n    best_match = None\n    best_matches_detail = []\n    \n    for entry in codebooks[product_id]:\n        score, matches = calculate_match_score(segment, entry)\n        \n        # Station scope bonus\n        station_scope = entry['station_scope'].upper()\n        if station.upper() in station_scope:\n            score *= 1.1  # Small bonus for correct station\n        \n        if score > best_score:\n            best_score = score\n            best_match = entry\n            best_matches_detail = matches\n    \n    return best_match, best_score, best_matches_detail\n\ndef normalize_logs(logs, codebooks):\n    results = []\n    \n    for log in logs:\n        record_id = log['record_id']\n        product_id = log['product_id']\n        station = log['station']\n        engineer_id = log['engineer_id']\n        raw_reason_text = log['raw_reason_text']\n        \n        segments = segment_raw_text(raw_reason_text)\n        \n        normalized = []\n        for i, segment in enumerate(segments, 1):\n            segment_id = f\"{record_id}-S{i}\"\n            \n            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\n            \n            # Lower threshold to 0.30 for better coverage\n            if best_match and score >= 0.30:\n                # Map score to confidence\n                if score >= 0.8:\n                    confidence = 0.90\n                elif score >= 0.6:\n                    confidence = 0.75 + (score - 0.6) * 0.75\n                elif score >= 0.4:\n                    confidence = 0.60 + (score - 0.4) * 0.75\n                else:\n                    confidence = 0.50 + (score - 0.3) * 1.0\n                \n                pred_code = best_match['code']\n                pred_label = best_match['standard_label']\n                rationale = f\"Matched: {', '.join(str(m) for m in matches[:6])}. Score: {score:.2f}\"\n            else:\n                confidence = min(0.20, score * 0.5) if score > 0 else 0.08\n                pred_code = \"UNKNOWN\"\n                pred_label = \"\"\n                rationale = f\"No confident match. Best score: {score:.2f}. Manual review needed.\"\n            \n            normalized.append({\n                \"segment_id\": segment_id,\n                \"span_text\": segment,\n                \"pred_code\": pred_code,\n                \"pred_label\": pred_label,\n                \"confidence\": round(confidence, 3),\n                \"rationale\": rationale\n            })\n        \n        results.append({\n            \"record_id\": record_id,\n            \"product_id\": product_id,\n            \"station\": station,\n            \"engineer_id\": engineer_id,\n            \"raw_reason_text\": raw_reason_text,\n            \"normalized\": normalized\n        })\n    \n    return results\n\ndef main():\n    print(\"Loading codebooks...\")\n    code"]
[279.594567, "i", "books = load_codebooks()\n    \n    print(\"Loading test logs...\")\n    logs = load_test_logs()\n    \n    print(f\"Processing {len(logs)} records...\")\n    results = normalize_logs(logs, codebooks)\n    \n    output = {\"records\": results}\n    \n    print(\"Writing output...\")\n    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\n        json.dump(output, f, ensure_ascii=False, indent=2)\n    \n    print(\"Done!\")\n    print(f\"Processed {len(results)} records\")\n    \n    total_segments = sum(len(r['normalized']) for r in results)\n    unknown_count = sum(1 for r in results for n in r['normalized'] if n['pred_code'] == 'UNKNOWN')\n    known_count = total_segments - unknown_count\n    \n    print(f\"Total segments: {total_segments}\")\n    print(f\"Known matches: {known_count} ({known_count/total_segments*100:.1f}%)\")\n    print(f\"Unknown: {unknown_count} ({unknown_count/total_segments*100:.1f}%)\")\n    \n    confidences = [n['confidence'] for r in results for n in r['normalized']]\n    if confidences:\n        print(f\"Confidence - Mean: {sum(confidences)/len(confidences):.3f}\")\n        confidences_sorted = sorted(confidences)\n        print(f\"Confidence - Median: {confidences_sorted[len(confidences_sorted)//2]:.3f}\")\n        print(f\"Confidence - Min: {min(confidences):.3f}, Max: {max(confidences):.3f}\")\n        print(f\"Confidence - P25: {confidences_sorted[len(confidences_sorted)//4]:.3f}\")\n        print(f\"Confidence - P75: {confidences_sorted[3*len(confidences_sorted)//4]:.3f}\")\n\nif __name__ == '__main__':\n    main()\nEOFPY\n"]
