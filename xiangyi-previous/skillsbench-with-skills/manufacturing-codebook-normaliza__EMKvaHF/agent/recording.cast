[65.318648, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.318671, "o", "> "]
[65.318823, "o", "    # Specific pattern matching\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.318985, "o", "    if 'open' in cb_label or '开路' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.319255, "o", "        if 'open' in raw_lower or '开路' in raw_text or 'os' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.319357, "o", "            score += 0.2\r\n\u001b[?2004l\rreason_\u001b[?2004h> "]
[65.319382, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.319404, "o", "> "]
[65.319577, "o", "    if 'short' in cb_label or '短路' in cb_keywords:\r\n\u001b[?2004l\r"]
[65.319598, "o", "\u001b[?2004h> "]
[65.319894, "o", "        if 'short' in raw_lower or '短路' in raw_text or '短路趋势' in raw_text:\r\n\u001b[?2004l\r"]
[65.319921, "o", "\u001b[?2004h> "]
[65.320051, "o", "            score += 0.2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.320073, "o", "> "]
[65.320293, "o", "    if 'cold solder' in cb_label or '虚焊' in cb_keywords:\r\n\u001b[?2004l\r"]
[65.320425, "o", "\u001b[?2004h> "]
[65.320725, "o", "        if 'cold solder' in raw_lower or '虚焊' in raw_text or '少锡' in raw_text or '浮高' in raw_text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.320843, "o", "            score += 0.2\r\n\u001b[?2004l\r"]
[65.320874, "o", "\u001b[?2004h> "]
[65.320976, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.321212, "o", "    if 'fixture' in cb_label or '接触不良' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.32125, "o", "> "]
[65.321591, "o", "        if 'fixture' in raw_lower or 'pogo' in raw_lower or 'probe' in raw_lower or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.321876, "o", "           'reseat' in raw_lower or '接触不良' in raw_text or '探针' in raw_text or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.322085, "o", "           '重插' in raw_text or '换针' in raw_text or '治具' in raw_text:\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.322112, "o", "> "]
[65.322234, "o", "            score += 0.25\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return score, matches\r\n"]
[65.322271, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.322296, "o", "\u001b[?2004h> "]
[65.322426, "o", "def segment_raw_text(raw_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.32245, "o", "    \"\"\"Segment raw text into individual issues\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.322472, "o", "> "]
[65.322598, "o", "    # Split by common delimiters\r\n\u001b[?2004l\r\u001b[?2004h>     segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.322622, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.322722, "o", "    # Try to split by common separators\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.322829, "o", "    parts = re.split(r'[/&]|\\s+and\\s+|\\s+then\\s+', raw_text)\r\n\u001b[?2004l\r"]
[65.322854, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.322874, "o", "\u001b[?2004h> "]
[65.322993, "o", "    if len(parts) > 1:\r\n\u001b[?2004l\r\u001b[?2004h>         for part in parts:\r\n\u001b[?2004l\r"]
[65.323083, "o", "\u001b[?2004h> "]
[65.323154, "o", "            part = part.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.323261, "o", "            if len(part) > 5:  # Minimum meaningful length\r\n\u001b[?2004l\r"]
[65.323346, "o", "\u001b[?2004h> "]
[65.323373, "o", "                segments.append(part)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.323465, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.323539, "o", "        segments.append(raw_text.strip())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.323632, "o", "    \r\n\u001b[?2004l\r"]
[65.323712, "o", "\u001b[?2004h> "]
[65.32381, "o", "    return segments if segments else [raw_text.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.323978, "o", "def find_best_match(segment, codebooks, product_id, station):\r\n\u001b[?2004l\r"]
[65.324063, "o", "\u001b[?2004h> "]
[65.324159, "o", "    \"\"\"Find the best matching code for a segment\"\"\"\r\n\u001b[?2004l\r"]
[65.324255, "o", "\u001b[?2004h> "]
[65.324326, "o", "    if product_id not in codebooks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.32436, "o", "        return None, 0.0, []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[65.324401, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.324578, "o", "    best_score = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     best_match = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.324606, "o", "> "]
[65.324705, "o", "    best_matches_detail = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.324777, "o", "    for entry in codebooks[product_id]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.324845, "o", "        # Check if station is in scope\r\n\u001b[?2004l\r"]
[65.324868, "o", "\u001b[?2004h> "]
[65.324968, "o", "        station_scope = entry['station_scope'].upper()\r\n\u001b[?2004l\r"]
[65.32499, "o", "\u001b[?2004h> "]
[65.325128, "o", "        if station.upper() not in station_scope and 'ALL' not in station_scope:\r\n\u001b[?2004l\r"]
[65.325153, "o", "\u001b[?2004h> "]
[65.325258, "o", "            # Still allow but with penalty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.32537, "o", "            score, matches = calculate_match_score(segment, entry)\r\n\u001b[?2004l\r"]
[65.325394, "o", "\u001b[?2004h> "]
[65.325508, "o", "            score *= 0.7  # Penalty for out-of-scope station\r\n\u001b[?2004l\r"]
[65.325538, "o", "\u001b[?2004h> "]
[65.32563, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.325776, "o", "            score, matches = calculate_match_score(segment, entry)\r\n\u001b[?2004l\r"]
[65.325848, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[65.325872, "o", "\u001b[?2004h"]
[65.32596, "o", "> "]
[65.325989, "o", "        if score > best_score:\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.32601, "o", "> "]
[65.326159, "o", "            best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.326251, "o", "            best_match = entry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.32636, "o", "            best_matches_detail = matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.326499, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.326575, "o", "    return best_match, best_score, best_matches_detail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.326696, "o", "def normalize_logs(logs, codebooks):\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.326746, "o", "> "]
[65.326845, "o", "    \"\"\"Normalize all logs\"\"\"\r\n\u001b[?2004l\r"]
[65.326911, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.32698, "o", "\u001b[?2004h> "]
[65.327065, "o", "    for log in logs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.327133, "o", "        record_id = log['record_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.327248, "o", "        product_id = log['product_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.32735, "o", "        station = log['station']\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.327427, "o", "> "]
[65.327461, "o", "        engineer_id = log['engineer_id']\r\n\u001b[?2004l\r"]
[65.327486, "o", "\u001b[?2004h"]
[65.327512, "o", "> "]
[65.327645, "o", "        raw_reason_text = log['raw_reason_text']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[65.327712, "o", "\u001b[?2004h> "]
[65.327766, "o", "        # Segment the raw text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.327831, "o", "        segments = segment_raw_text(raw_reason_text)\r\n\u001b[?2004l\r"]
[65.327881, "o", "\u001b[?2004h>         \r\n"]
[65.327954, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.32798, "o", "        normalized = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.328087, "o", "        for i, segment in enumerate(segments, 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.328108, "o", "> "]
[65.328203, "o", "            segment_id = f\"{record_id}-S{i}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.328229, "o", "> "]
[65.328303, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.328364, "o", "            # Find best match\r\n\u001b[?2004l\r"]
[65.328394, "o", "\u001b[?2004h> "]
[65.328618, "o", "            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\r\n\u001b[?2004l\r"]
[65.328642, "o", "\u001b[?2004h> "]
[65.328727, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.328825, "o", "            if best_match and score >= 0.3:  # Threshold for acceptable match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.328931, "o", "                # Calculate confidence based on score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.329042, "o", "                confidence = min(0.95, score)  # Cap at 0.95\r\n\u001b[?2004l\r"]
[65.329072, "o", "\u001b[?2004h> "]
[65.329178, "o", "                pred_code = best_match['code']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.329266, "o", "                pred_label = best_match['standard_label']\r\n\u001b[?2004l\r"]
[65.3293, "o", "\u001b[?2004h> "]
[65.329474, "o", "                rationale = f\"Matched keywords: {', '.join(matches[:5])}. Score: {score:.2f}\"\r\n\u001b[?2004l\r"]
[65.329505, "o", "\u001b[?2004h> "]
[65.329579, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.329665, "o", "                # Unknown - low confidence\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.329769, "o", "                confidence = score * 0.5 if score > 0 else 0.1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.329807, "o", "                pred_code = \"UNKNOWN\"\r\n\u001b[?2004l\r"]
[65.329833, "o", "\u001b[?2004h> "]
[65.329903, "o", "                pred_label = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.330029, "o", "                rationale = f\"No confident match found. Best score: {score:.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.330057, "o", "            \r\n\u001b[?2004l\r"]
[65.330084, "o", "\u001b[?2004h> "]
[65.330139, "o", "            normalized.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.330207, "o", "> "]
[65.330232, "o", "                \"segment_id\": segment_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.330395, "o", "                \"span_text\": segment,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"pred_code\": pred_code,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.330458, "o", "                \"pred_label\": pred_label,\r\n\u001b[?2004l\r"]
[65.330479, "o", "\u001b[?2004h> "]
[65.330623, "o", "                \"confidence\": round(confidence, 3),\r\n\u001b[?2004l\r"]
[65.330685, "o", "\u001b[?2004h> "]
[65.330711, "o", "                \"rationale\": rationale\r\n\u001b[?2004l\r\u001b[?2004h"]
[65.330775, "o", "> "]
[65.330799, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.330945, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"record_id\": record_id,\r\n\u001b[?2004l\r"]
[65.330979, "o", "\u001b[?2004h> "]
[65.331079, "o", "            \"product_id\": product_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331165, "o", "            \"station\": station,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331193, "o", "            \"engineer_id\": engineer_id,\r\n\u001b[?2004l\r"]
[65.331245, "o", "\u001b[?2004h> "]
[65.331329, "o", "            \"raw_reason_text\": raw_reason_text,\r\n\u001b[?2004l\r"]
[65.331354, "o", "\u001b[?2004h> "]
[65.33142, "o", "            \"normalized\": normalized\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331472, "o", "        })\r\n"]
[65.331497, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.331523, "o", "> "]
[65.331594, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.331631, "o", "> "]
[65.331707, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331732, "o", "    print(\"Loading codebooks...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331812, "o", "    codebooks = load_codebooks()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[65.331842, "o", "> "]
[65.331938, "o", "    print(\"Loading test logs...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.331958, "o", "    logs = load_test_logs()\r\n\u001b[?2004l\r"]
[65.332017, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.332297, "o", "    print(f\"Processing {len(logs)} records...\")\r\n\u001b[?2004l\r\u001b[?2004h>     results = normalize_logs(logs, codebooks)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     output = {\"records\": results}\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[65.332321, "o", "\u001b[?2004h> "]
[65.332374, "o", "    print(\"Writing output...\")\r\n\u001b[?2004l\r"]
[65.332396, "o", "\u001b[?2004h> "]
[65.332556, "o", "    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.332626, "o", "        json.dump(output, f, ensure_ascii=False, indent=2)\r\n\u001b[?2004l\r"]
[65.332697, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.332718, "o", "    print(\"Done!\")\r\n"]
[65.332778, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[65.33285, "o", "    print(f\"Processed {len(results)} records\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[65.332878, "o", "\u001b[?2004h> "]
[65.33294, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.33296, "o", "    main()\r\n\u001b[?2004l\r"]
[65.333026, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[65.335243, "o", "\u001b[?2004hroot@6e89f37f18fb:/app# "]
[72.218972, "i", "python3 /app/normalize.py\n"]
[72.219834, "o", "python3 /app/normalize.py\r\n\u001b[?2004l\r"]
[72.253887, "o", "Loading codebooks...\r\n"]
[72.254192, "o", "Loading test logs...\r\n"]
[72.337019, "o", "Processing 12000 records...\r\n"]
[82.316017, "o", "Writing output...\r\n"]
[82.935118, "o", "Done!\r\nProcessed 12000 records\r\n"]
[82.97235, "o", "\u001b[?2004hroot@6e89f37f18fb:/app# "]
