[96.575868, "o", "{\r\n  \"records\": [\r\n    {\r\n      \"record_id\": \"R0000001\",\r\n      \"product_id\": \"P3_RF\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E1\",\r\n      \"raw_reason_text\": \"治具/探针接触不良，重插后偶尔OK 浮高\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000001-S1\",\r\n          \"span_text\": \"探针接触不良，重插后偶尔OK 浮高\",\r\n          \"pred_code\": \"P3_RF-TS-019\",\r\n          \"pred_label\": \"Fixture contact unstable (pogo pin / clamp)\",\r\n          \"confidence\": 0.55,\r\n          \"rationale\": \"Matched keywords: 接触不良, 探针. Score: 0.55\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000002\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"FUNC\",\r\n      \"engineer_id\": \"E2\",\r\n      \"raw_reason_text\": \"静态电流偏高，疑似短路趋势/器件异常\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000002-S1\",\r\n          \"span_text\": \"静态电流偏高，疑似短路趋势\",\r\n          \"pred_code\": \"UNKNOWN\",\r\n          \"pred_label\": \"\",\r\n          \"confidence\": 0.122,\r\n          \"rationale\": \"No confident match found. Best score: 0.24\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000003\",\r\n      \"product_id\": \"P2_CTRL\",\r\n      \"station\": \"FCT\",\r\n      \"engineer_id\": \"E4\",\r\n      \"raw_reason_text\": \"校验失败/CRC挂，疑似程序包或数据异常\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000003-S1\",\r\n          \"span_text\": \"CRC挂，疑似程序包或数据异常\",\r\n          \"pred_code\": \"UNKNOWN\",\r\n          \"pred_label\": \"\",\r\n          \"confidence\": 0.075,\r\n          \"rationale\": \"No confident match found. Best score: 0.15\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000004\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E1\",\r\n      \"raw_reason_text\": \"R152_NET open, suspect cold solder/missing solder / R152_NET 开路，疑似虚焊/少锡 NG\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000004-S1\",\r\n          \"span_text\": \"R152_NET open, suspect cold solder\",\r\n          \"pred_code\": \"P1_POWER-EL-001\",\r\n          \"pred_label\": \"Open circuit: C87 / VDD_5V\",\r\n          \"confidence\": 0.35,\r\n          \"rationale\": \"Matched keywords: open. Score: 0.35\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000004-S2\",\r\n          \"span_text\": \"missing solder\",\r\n          \"pred_code\": \"UNKNOWN\",\r\n          \"pred_label\": \"\",\r\n          \"confidence\": 0.075,\r\n          \"rationale\": \"No confident match found. Best score: 0.15\"\r\n        },\r\n        {\r\n          \"segment_id\": \"R0000004-S3\",\r\n          \"span_text\": \"R152_NET 开路，疑似虚焊\",\r\n          \"pred_code\": \"P1_POWER-EL-001\",\r\n          \"pred_label\": \"Open circuit: C87 / VDD_5V\",\r\n          \"confidence\": 0.35,\r\n          \"rationale\": \"Matched keywords: 开路. Score: 0.35\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"record_id\": \"R0000005\",\r\n      \"product_id\": \"P1_POWER\",\r\n      \"station\": \"ICT\",\r\n      \"engineer_id\": \"E2\",\r\n      \"raw_reason_text\": \"I2C_SDA 开路，疑似虚焊/少锡\",\r\n      \"normalized\": [\r\n        {\r\n          \"segment_id\": \"R0000005-S1\",\r\n          \"span_text\": \"I2C_SDA 开路，疑似虚焊\",\r\n          \"pred_code\": \"P1_POWER-EL-001\",\r\n          \"pred_label\": \"Open circuit: C87 / VDD_5V\",\r\n          \"confidence\": 0.35,\r\n          \"rationale\": \"Matched keywords: 开路. Score: 0.35\"\r\n\u001b[?2004h"]
