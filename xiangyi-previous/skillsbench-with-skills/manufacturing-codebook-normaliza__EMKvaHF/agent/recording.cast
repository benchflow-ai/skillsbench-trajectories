[151.890096, "o", "            score += 0.4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.890267, "o", "            matches.append(f\"component:{comp}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.89031, "o", "> "]
[151.890471, "o", "            break  # Only count once\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.890506, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.890664, "o", "    # Exact signal match (high weight)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.890698, "o", "    for sig in raw_signals:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.890875, "o", "        if sig.upper() in [s.upper() for s in cb_signals]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.890962, "o", "            score += 0.4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.891541, "o", "            matches.append(f\"signal:{sig}\")\r\n\u001b[?2004l\r\u001b[?2004h>             break  # Only count once\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Keyword matching from codebook examples\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.891774, "o", "    keyword_list = [k.strip() for k in cb_keywords.lower().split(',')]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[151.89181, "o", "\u001b[?2004h> "]
[151.891981, "o", "    # Category-specific keywords with higher weights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.892067, "o", "    category_matches = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.892089, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.892188, "o", "    # Open circuit detection\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.892216, "o", "> "]
[151.894176, "o", "    if 'open' in cb_label.lower() or '开路' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h>         if 'open' in raw_lower or '开路' in raw_text or ' os ' in raw_lower or 'os (' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h>             score += 0.25\r\n\u001b[?2004l\r\u001b[?2004h>             matches.append('open_circuit')\r\n\u001b[?2004l\r\u001b[?2004h>             category_matches += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Short circuit detection  \r\n\u001b[?2004l\r\u001b[?2004h>     if 'short' in cb_label.lower() or '短路' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h>         if 'short' in raw_lower or '短路' in raw_text or '短路趋势' in raw_text or 'bridge' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h>             score += 0.25\r\n\u001b[?2004l\r\u001b[?2004h>             matches.append('short_circuit')\r\n\u001b[?2004l\r\u001b[?2004h>             category_matches += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.894215, "o", "> "]
[151.894233, "o", "    # Cold solder detection\r\n\u001b[?2004l\r"]
[151.894255, "o", "\u001b[?2004h> "]
[151.894515, "o", "    if 'cold solder' in cb_label.lower() or '虚焊' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.895263, "o", "        if 'cold solder' in raw_lower or '虚焊' in raw_text or '少锡' in raw_text or \\\r\n\u001b[?2004l\r\u001b[?2004h>            '浮高' in raw_text or 'missing solder' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h>             score += 0.25\r\n\u001b[?2004l\r\u001b[?2004h>             matches.append('cold_solder')\r\n\u001b[?2004l\r\u001b[?2004h>             category_matches += 1\r\n\u001b[?2004l\r"]
[151.895332, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.895393, "o", "    # Fixture/probe contact issues\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.89558, "o", "    if 'fixture' in cb_label.lower() or 'contact' in cb_label.lower():\r\n\u001b[?2004l\r"]
[151.89561, "o", "\u001b[?2004h> "]
[151.895831, "o", "        if 'fixture' in raw_lower or 'pogo' in raw_lower or 'probe' in raw_lower or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.896154, "o", "           'reseat' in raw_lower or '接触不良' in raw_text or '探针' in raw_text or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.8964, "o", "           '重插' in raw_text or '换针' in raw_text or '治具' in raw_text or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.896688, "o", "           'contact' in raw_lower or 'pin' in raw_lower or '磨损' in raw_text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.896835, "o", "            score += 0.3\r\n\u001b[?2004l\r"]
[151.896884, "o", "\u001b[?2004h> "]
[151.897544, "o", "            matches.append('fixture_contact')\r\n\u001b[?2004l\r\u001b[?2004h>             category_matches += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Programming/Flash issues\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.897653, "o", "    if 'program' in cb_label.lower() or 'flash' in cb_label.lower():\r\n\u001b[?2004l\r"]
[151.897678, "o", "\u001b[?2004h> "]
[151.897988, "o", "        if 'program' in raw_lower or 'flash' in raw_lower or '烧录' in raw_text or \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.898039, "o", "> "]
[151.898281, "o", "           '写入' in raw_text or 'reflash' in raw_lower or 'reburn' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.898363, "o", "            score += 0.3\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.898388, "o", "> "]
[151.898531, "o", "            matches.append('programming')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.89865, "o", "            category_matches += 1\r\n\u001b[?2004l\r"]
[151.898671, "o", "\u001b[?2004h> "]
[151.898718, "o", "    \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[151.898877, "o", "    # Verification/CRC issues\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.899626, "o", "    if 'verif' in cb_label.lower() or 'crc' in cb_label.lower() or 'checksum' in cb_label.lower():\r\n\u001b[?2004l\r\u001b[?2004h>         if 'verif' in raw_lower or 'crc' in raw_lower or 'checksum' in raw_lower or \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.899704, "o", "           '校验' in raw_text or '验证' in raw_text:\r\n\u001b[?2004l\r"]
[151.899727, "o", "\u001b[?2004h> "]
[151.899811, "o", "            score += 0.3\r\n\u001b[?2004l\r"]
[151.899843, "o", "\u001b[?2004h> "]
[151.900009, "o", "            matches.append('verification')\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.900032, "o", "> "]
[151.900183, "o", "            category_matches += 1\r\n\u001b[?2004l\r: p\u001b[?2004h>     \r\n\u001b[?2004l\rc"]
[151.900208, "o", "\u001b[?2004h> "]
[151.900294, "o", "    # Component issue detection\r\n\u001b[?2004l\r"]
[151.900317, "o", "\u001b[?2004h> "]
[151.900605, "o", "    if 'component' in cb_label.lower() and 'issue' in cb_label.lower():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.900886, "o", "        if '器件' in raw_text or 'component' in raw_lower or 'device' in raw_lower:\r\n\u001b[?2004l\r"]
[151.90093, "o", "\u001b[?2004h> "]
[151.901026, "o", "            score += 0.2\r\n\u001b[?2004l\r"]
[151.901058, "o", "\u001b[?2004h> "]
[151.901218, "o", "            matches.append('component_issue')\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.90125, "o", ">     \r\n\u001b[?2004l\r"]
[151.901283, "o", "\u001b[?2004h> "]
[151.90138, "o", "    # Current issues\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.9016, "o", "    if 'current' in cb_label.lower() or '电流' in cb_keywords:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.901637, "o", "> "]
[151.90188, "o", "        if 'current' in raw_lower or '电流' in raw_text or 'idle' in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.901981, "o", "            score += 0.2\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.902016, "o", "> "]
[151.902156, "o", "            matches.append('current_issue')\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.902187, "o", ">     \r\n\u001b[?2004l\r"]
[151.90222, "o", "\u001b[?2004h> "]
[151.902411, "o", "    # General keyword matching (lower weight)\r\n\u001b[?2004l\r"]
[151.902442, "o", "\u001b[?2004h> "]
[151.902535, "o", "    for kw in keyword_list:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.90257, "o", "> "]
[151.902704, "o", "        if kw and len(kw) > 2 and kw in raw_lower:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.902735, "o", "> "]
[151.902816, "o", "            score += 0.05\r\n\u001b[?2004l\r"]
[151.902849, "o", "\u001b[?2004h> "]
[151.902964, "o", "            if kw not in str(matches):\r\n\u001b[?2004l\r"]
[151.902995, "o", "\u001b[?2004h> "]
[151.903093, "o", "                matches.append(kw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.903121, "o", ">     \r\n\u001b[?2004l\r"]
[151.903158, "o", "\u001b[?2004h> "]
[151.903253, "o", "    return score, matches\r\n\u001b[?2004l\r"]
[151.903283, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[151.903391, "o", "def segment_raw_text(raw_text):\r\n\u001b[?2004l\r"]
[151.903423, "o", "\u001b[?2004h> "]
[151.903576, "o", "    \"\"\"Segment raw text into individual issues\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.903607, "o", "> "]
[151.90369, "o", "    segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.903724, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.903924, "o", "    # Split by common delimiters but be more careful\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.904157, "o", "    # Use / and & as primary delimiters, but keep \"and\" phrases together\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.904293, "o", "    parts = re.split(r'\\s*/\\s*|\\s*&\\s*', raw_text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.904322, "o", ">     \r\n\u001b[?2004l\r"]
[151.904353, "o", "\u001b[?2004h> "]
[151.904451, "o", "    if len(parts) > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.904617, "o", "        for part in parts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.904736, "o", "            part = part.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.904916, "o", "            if len(part) > 3:  # Minimum meaningful length\r\n\u001b[?2004l\r"]
[151.90495, "o", "\u001b[?2004h> "]
[151.905088, "o", "                segments.append(part)\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.905166, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.905337, "o", "    # If no good split found, return whole text\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.905377, "o", "> "]
[151.905471, "o", "    if not segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.905587, "o", "        segments = [raw_text.strip()]\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.905616, "o", ">     \r\n\u001b[?2004l\r"]
[151.905647, "o", "\u001b[?2004h> "]
[151.905746, "o", "    return segments\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.905951, "o", "def find_best_match(segment, codebooks, product_id, station):\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.905984, "o", "> "]
[151.906127, "o", "    \"\"\"Find the best matching code for a segment\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.906162, "o", "> "]
[151.906268, "o", "    if product_id not in codebooks:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.906302, "o", "> "]
[151.906399, "o", "        return None, 0.0, []\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.906433, "o", ">     \r\n\u001b[?2004l\r"]
[151.906464, "o", "\u001b[?2004h> "]
[151.906562, "o", "    best_score = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.906657, "o", "    best_match = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.906766, "o", "    best_matches_detail = []\r\n\u001b[?2004l\r"]
[151.906799, "o", "\u001b[?2004h> "]
[151.906826, "o", "    \r\n\u001b[?2004l\r"]
[151.906858, "o", "\u001b[?2004h> "]
[151.90698, "o", "    for entry in codebooks[product_id]:\r\n\u001b[?2004l\r"]
[151.907014, "o", "\u001b[?2004h> "]
[151.907154, "o", "        score, matches = calculate_match_score(segment, entry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907188, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907298, "o", "        # Check if station is in scope - apply penalty if not\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907391, "o", "        station_scope = entry['station_scope'].upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.907426, "o", "> "]
[151.907513, "o", "        if station.upper() not in station_scope:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907588, "o", "            score *= 0.8  # Small penalty for out-of-scope\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907622, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907703, "o", "        if score > best_score:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907765, "o", "            best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907829, "o", "            best_match = entry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907916, "o", "            best_matches_detail = matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.907949, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.90805, "o", "    return best_match, best_score, best_matches_detail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.908085, "o", "\u001b[?2004h> "]
[151.90817, "o", "def normalize_logs(logs, codebooks):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.90824, "o", "    \"\"\"Normalize all logs\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.908272, "o", "    results = []\r\n\u001b[?2004l\r"]
[151.90831, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[151.908344, "o", "\u001b[?2004h> "]
[151.908456, "o", "    for log in logs:\r\n\u001b[?2004l\r\u001b[?2004h>         record_id = log['record_id']\r\n"]
[151.908489, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.908579, "o", "        product_id = log['product_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.908652, "o", "        station = log['station']\r\n\u001b[?2004l\r"]
[151.908689, "o", "\u001b[?2004h> "]
[151.908768, "o", "        engineer_id = log['engineer_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.908857, "o", "        raw_reason_text = log['raw_reason_text']\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.908893, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.908923, "o", "> "]
[151.909021, "o", "        # Segment the raw text\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909089, "o", "        segments = segment_raw_text(raw_reason_text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909123, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909207, "o", "        normalized = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909291, "o", "        for i, segment in enumerate(segments, 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.909325, "o", "> "]
[151.909406, "o", "            segment_id = f\"{record_id}-S{i}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909434, "o", "            \r\n\u001b[?2004l\r"]
[151.909464, "o", "\u001b[?2004h> "]
[151.909565, "o", "            # Find best match\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.909691, "o", "            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\r\n\u001b[?2004l\r"]
[151.909727, "o", "\u001b[?2004h>             \r\n"]
[151.909757, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.909858, "o", "            # Dynamic threshold based on match quality\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.909891, "o", "> "]
[151.910012, "o", "            if best_match and score >= 0.35:  # Threshold for acceptable match\r\n\u001b[?2004l\r"]
[151.910045, "o", "\u001b[?2004h> "]
[151.910147, "o", "                # Calculate confidence based on score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.910237, "o", "                # Map score to confidence range [0.5, 0.95]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.910342, "o", "                confidence = min(0.95, max(0.50, score))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.910432, "o", "                pred_code = best_match['code']\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.910468, "o", "> "]
[151.910554, "o", "                pred_label = best_match['standard_label']\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.910586, "o", "> "]
[151.910734, "o", "                rationale = f\"Matched: {', '.join(str(m) for m in matches[:6])}. Score: {score:.2f}\"\r\n\u001b[?2004l\r"]
[151.910767, "o", "\u001b[?2004h> "]
[151.910791, "o", "            else:\r\n\u001b[?2004l\r"]
[151.910894, "o", "\u001b[?2004h>                 # Unknown - low confidence\r\n\u001b[?2004l\r"]
[151.910925, "o", "\u001b[?2004h> "]
[151.911044, "o", "                confidence = min(0.25, score * 0.6) if score > 0 else 0.10\r\n\u001b[?2004l\r"]
[151.911077, "o", "\u001b[?2004h> "]
[151.911167, "o", "                pred_code = \"UNKNOWN\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.911234, "o", "                pred_label = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.911458, "o", "                rationale = f\"No confident match. Best score: {score:.2f}. Segment may need manual review.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91152, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.911553, "o", "            normalized.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.911629, "o", "                \"segment_id\": segment_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.911701, "o", "                \"span_text\": segment,\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.911733, "o", "> "]
[151.911814, "o", "                \"pred_code\": pred_code,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91192, "o", "                \"pred_label\": pred_label,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91201, "o", "                \"confidence\": round(confidence, 3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912136, "o", "                \"rationale\": rationale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912223, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.912294, "o", ">             \"record_id\": record_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.912386, "o", ">             \"product_id\": product_id,\r\n\u001b[?2004l\r"]
[151.91247, "o", "\u001b[?2004h>             \"station\": station,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912554, "o", "            \"engineer_id\": engineer_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912637, "o", "            \"raw_reason_text\": raw_reason_text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912738, "o", "            \"normalized\": normalized\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[151.912815, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.912892, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.912965, "o", "    print(\"Loading codebooks...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913034, "o", "    codebooks = load_codebooks()\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.91311, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91319, "o", "    print(\"Loading test logs...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913258, "o", "    logs = load_test_logs()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913348, "o", "    print(f\"Processing {len(logs)} records...\")\r\n\u001b[?2004l\r"]
[151.913423, "o", "\u001b[?2004h> "]
[151.913493, "o", "    results = normalize_logs(logs, codebooks)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913564, "o", "    output = {\"records\": results}\r\n\u001b[?2004l\r"]
[151.913639, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913729, "o", "    print(\"Writing output...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91383, "o", "    with open('/app/output/solution.json', 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.913947, "o", "        json.dump(output, f, ensure_ascii=False, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914041, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914143, "o", "    print(f\"Processed {len(results)} records\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914234, "o", "    # Print some statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914325, "o", "    total_segments = sum(len(r['normalized']) for r in results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914483, "o", "    unknown_count = sum(1 for r in results for n in r['normalized'] if n['pred_code'] == 'UNKNOWN')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914597, "o", "    known_count = total_segments - unknown_count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914672, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914764, "o", "    print(f\"Total segments: {total_segments}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.914874, "o", "    print(f\"Known matches: {known_count} ({known_count/total_segments*100:.1f}%)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.915013, "o", "    print(f\"Unknown: {unknown_count} ({unknown_count/total_segments*100:.1f}%)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.915107, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91519, "o", "    # Calculate confidence statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.915295, "o", "    confidences = [n['confidence'] for r in results for n in r['normalized']]\r\n\u001b[?2004l\r\u001b[?2004h>     if confidences:\r\n\u001b[?2004l\r"]
[151.915375, "o", "\u001b[?2004h> "]
[151.915458, "o", "        print(f\"Confidence - Mean: {sum(confidences)/len(confidences):.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.91553, "o", "        confidences_sorted = sorted(confidences)\r\n\u001b[?2004l\r"]
[151.915596, "o", "\u001b[?2004h> "]
[151.915696, "o", "        print(f\"Confidence - Median: {confidences_sorted[len(confidences_sorted)//2]:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.915767, "o", "> "]
[151.916038, "o", "        print(f\"Confidence - Min: {min(confidences):.3f}, Max: {max(confidences):.3f}\")\r\n\u001b[?2004l\r"]
[151.916135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOFPYTHON\r\n\u001b[?2004l\r"]
