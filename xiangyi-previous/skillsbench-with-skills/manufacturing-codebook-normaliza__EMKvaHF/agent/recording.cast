[380.031173, "i", "python3 << 'PYEOF'\nimport json\nimport statistics\n\n# Load and validate the solution\nwith open('/app/output/solution.json', 'r') as f:\n    solution = json.load(f)\n\nprint(\"=\" * 60)\nprint(\"FINAL SOLUTION VALIDATION\")\nprint(\"=\" * 60)\n\n# Check structure\nprint(f\"\\n1. Structure Check:\")\nprint(f\"   - Has 'records' key: {('records' in solution)}\")\nprint(f\"   - Total records: {len(solution['records'])}\")\n\n# Check first record has all required fields\nfirst_record = solution['records'][0]\nrequired_fields = ['record_id', 'product_id', 'station', 'engineer_id', 'raw_reason_text', 'normalized']\nprint(f\"\\n2. Required Fields Check:\")\nfor field in required_fields:\n    print(f\"   - {field}: {field in first_record}\")\n\n# Check normalized structure\nfirst_norm = first_record['normalized'][0]\nnorm_fields = ['segment_id', 'span_text', 'pred_code', 'pred_label', 'confidence', 'rationale']\nprint(f\"\\n3. Normalized Fields Check:\")\nfor field in norm_fields:\n    print(f\"   - {field}: {field in first_norm}\")\n\n# Check segment_id format\nprint(f\"\\n4. Segment ID Format Check:\")\nprint(f\"   - Example: {first_norm['segment_id']}\")\nprint(f\"   - Follows format: {first_norm['segment_id'].startswith(first_record['record_id'] + '-S')}\")\n\n# Confidence statistics\nall_confidences = []\nknown_confidences = []\nunknown_confidences = []\n\nfor record in solution['records']:\n    for norm in record['normalized']:\n        conf = norm['confidence']\n        all_confidences.append(conf)\n        if norm['pred_code'] == 'UNKNOWN':\n            unknown_confidences.append(conf)\n        else:\n            known_confidences.append(conf)\n\nprint(f\"\\n5. Confidence Statistics:\")\nprint(f\"   Total predictions: {len(all_confidences)}\")\nprint(f\"   Known: {len(known_confidences)} ({len(known_confidences)/len(all_confidences)*100:.1f}%)\")\nprint(f\"   Unknown: {len(unknown_confidences)} ({len(unknown_confidences)/len(all_confidences)*100:.1f}%)\")\n\nprint(f\"\\n6. Confidence Distribution (All):\")\nprint(f\"   Mean: {statistics.mean(all_confidences):.3f}\")\nprint(f\"   Median: {statistics.median(all_confidences):.3f}\")\nprint(f\"   Min: {min(all_confidences):.3f}\")\nprint(f\"   Max: {max(all_confidences):.3f}\")\nprint(f\"   Stdev: {statistics.stdev(all_confidences):.3f}\")\n\nprint(f\"\\n7. Confidence Distribution (Known):\")\nif known_confidences:\n    print(f\"   Mean: {statistics.mean(known_confidences):.3f}\")\n    print(f\"   Median: {statistics.median(known_confidences):.3f}\")\n    print(f\"   Min: {min(known_confidences):.3f}\")\n    print(f\"   Max: {max(known_confidences):.3f}\")\n\nprint(f\"\\n8. Confidence Distribution (Unknown):\")\nif unknown_confidences:\n    print(f\"   Mean: {statistics.mean(unknown_confidences):.3f}\")\n    print(f\"   Median: {statistics.median(unknown_confidences):.3f}\")\n    print(f\"   Min: {min(unknown_confidences):.3f}\")\n    print(f\"   Max: {max(unknown_confidences):.3f}\")\n\nprint(f\"\\n9. Sample Records Check:\")\nfor i in [0, 100, 1000, 5000, 10000]:\n    rec = solution['records'][i]\n    print(f\"   Record {rec['record_id']}: {len(rec['normalized'])} segments\")\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"VALIDATION COMPLETE\")\nprint(\"=\" * 60)\nPYEOF\n"]
