[68.33051, "o", "        <div className=\"animate-pulse w-full h-full bg-gray-200 rounded\"></div>\r\n\u001b[?2004l\r\u001b[?2004h>       ) : (\r\n\u001b[?2004l\r\u001b[?2004h>         <>\r\n\u001b[?2004l\r\u001b[?2004h>           <span>Showing {start}-{end} of {totalProducts} products</span>\r\n\u001b[?2004l\r\u001b[?2004h>           <div data-testid=\"pagination\" className=\"flex items-center gap-3\">\r\n\u001b[?2004l\r\u001b[?2004h>             <button\r\n\u001b[?2004l\r\u001b[?2004h>               data-testid=\"prev-page-btn\"\r\n\u001b[?2004l\r\u001b[?2004h>               disabled={page === 1}\r\n\u001b[?2004l\r\u001b[?2004h>               onClick={() => onPageChange(page - 1)}\r\n\u001b[?2004l\r\u001b[?2004h>               className=\"px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80\" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}\r\n\u001b[?2004l\r\u001b[?2004h>             >\r\n\u001b[?2004l\r\u001b[?2004h>               ← Prev\r\n\u001b[?2004l\r\u001b[?2004h>             </button>\r\n\u001b[?2004l\r\u001b[?2004h>             <span>Page {page} of {totalPages}</span>\r\n\u001b[?2004l\r\u001b[?2004h>             <button\r\n\u001b[?2004l\r\u001b[?2004h>               data-testid=\"next-page-btn\"\r\n\u001b[?2004l\r\u001b[?2004h>               disabled={page === totalPages}\r\n\u001b[?2004l\r\u001b[?2004h>               onClick={() => onPageChange(page + 1)}\r\n\u001b[?2004l\r\u001b[?2004h>               className=\"px-4 py-2 rounded cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed hover:not-disabled:opacity-80\" style={{ backgroundColor: 'var(--card-bg)', border: '1px solid var(--border-color)' }}\r\n\u001b[?2004l\r\u001b[?2004h>             >\r\n\u001b[?2004l\r\u001b[?2004h>               Next →\r\n\u001b[?2004l\r\u001b[?2004h>             </button>\r\n\u001b[?2004l\r\u001b[?2004h>           </div>\r\n\u001b[?2004l\r\u001b[?2004h>           <span>Sort: Price ▼</span>\r\n\u001b[?2004l\r\u001b[?2004h>         </>\r\n\u001b[?2004l\r\u001b[?2004h>       )}\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@29b932c61b5d:/app# "]
