[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def count_unique_pedestrians(video_path):
[?2004l[?2004h>     """Count unique pedestrians in a video using detection and tracking."""
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     
[?2004l[?2004h>     # Initialize HOG descriptor for pedestrian detection
[?2004l[?2004h>     hog = cv2.HOGDescriptor()
[?2004l[?2004h>     hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())
[?2004l[?2004h>     
[?2004l[?2004h>     # Track unique pedestrians
[?2004l[?2004h>     tracked_pedestrians = []
[?2004l[?2004h>     frame_count = 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Parameters for tracking
[?2004l[?2004h>     IOU_THRESHOLD = 0.3  # Intersection over Union threshold for matching
[?2004l[?2004h>     MAX_FRAMES_MISSING = 30  # Maximum frames a pedestrian can be missing
[?2004l[?2004h>     
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, frame = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         
[?2004l[?2004h>         frame_count += 1
[?2004l[?2004h>         
[?2004l[?2004h>         # Detect pedestrians every few frames to improve performance
[?2004l[?2004h>         if frame_count % 5 == 0:
[?2004l[?2004h>             # Resize frame for faster processing
[?2004l[?2004h>             scale = 0.5
[?2004l[?2004h>             resized = cv2.resize(frame, None, fx=scale, fy=scale)
[?2004l[?2004h>             
[?2004l[?2004h>             # Detect pedestrians
[?2004l[?2004h>             boxes, weights = hog.detectMultiScale(resized, winStride=(8, 8),
[?2004l[?2004h>                                                   padding=(4, 4), scale=1.05)
[?2004l[?2004h>             
[?2004l[?2004h>             # Scale boxes back to original size
[?2004l[?2004h>             boxes = [(int(x/scale), int(y/scale), int(w/scale), int(h/scale)) 
[?2004l[?2004h>                     for (x, y, w, h) in boxes]
[?2004l[?2004h>             
[?2004l[?2004h>             # Update tracked pedestrians
[?2004l[?2004h>             for box in boxes:
[?2004l[?2004h>                 matched = False
[?2004l[?2004h>                 x, y, w, h = box
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Try to match with existing tracked pedestrians
[?2004l[?2004h>                 for i, ped in enumerate(tracked_pedestrians):
[?2004l[?2004h>                     if frame_count - ped['last_seen'] > MAX_FRAMES_MISSING:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Calculate IOU (Intersection over Union)
[?2004l[?2004h>                     px, py, pw, ph = ped['box']
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Calculate intersection
[?2004l[?2004h>                     ix1 = max(x, px)
[?2004l[?2004h>                     iy1 = max(y, py)
[?2004l[?2004h>                     ix2 = min(x + w, px + pw)
[?2004l[?2004h>                     iy2 = min(y + h, py + ph)
[?2004l[?2004h>                     
[?2004l[?2004h>                     if ix2 > ix1 and iy2 > iy1:
[?2004l[?2004h>                         intersection = (ix2 - ix1) * (iy2 - iy1)
[?2004l[?2004h>                         union = w * h + pw * ph - intersection
[?2004l[?2004h>                         iou = intersection / union if union > 0 else 0
[?2004l[?2004h>                         
[?2004l[?2004h>                         if iou > IOU_THRESHOLD:
[?2004l[?2004h>                             # Update existing pedestrian
[?2004l[?2004h>                             tracked_pedestrians[i]['box'] = box
[?2004l[?2004h>                             tracked_pedestrians[i]['last_seen'] = frame_count
[?2004l[?2004h>                             matched = True
[?2004l[?2004h>                             break
[?2004l[?2004h>                 
[?2004l[?2004h>                 # If no match found, add as new pedestrian
[?2004l[?2004h>                 if not matched:
[?2004l[?2004h>                     tracked_pedestrians.append({
[?2004l[?2004h>                         'box': box,
[?2004l[?2004h>                         'first_seen': frame_count,
[?2004l[?2004h>                         'last_seen': frame_count
[?2004l[?2004h>                     })
[?2004l[?2004h>     
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     
[?2004l[?2004h>     # Count pedestrians that were seen for a minimum duration
[?2004l[?2004h>     MIN_FRAMES = 3
[?2004l[?2004h>     unique_count = sum(1 for ped in tracked_pedestrians 
[?2004l[?2004h>                       if ped['last_seen'] - ped['first_seen'] >= MIN_FRAMES)
[?2004l[?2004h>     
[?2004l[?2004h>     return max(unique_count, len(tracked_pedestrians))  # Return at least the total detected
[?2004l[?2004h> 
