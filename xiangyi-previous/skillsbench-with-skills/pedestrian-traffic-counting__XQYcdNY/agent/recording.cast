[627.928618, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[627.928651, "o", "> "]
[627.928904, "o", "        # Detect pedestrians every few frames to improve performance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.928944, "o", "        if frame_count % 5 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.928972, "o", "> "]
[627.929098, "o", "            # Resize frame for faster processing\r\n\u001b[?2004l\r"]
[627.929127, "o", "\u001b[?2004h> "]
[627.929203, "o", "            scale = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.929356, "o", "            resized = cv2.resize(frame, None, fx=scale, fy=scale)\r\n\u001b[?2004l\r"]
[627.929385, "o", "\u001b[?2004h> "]
[627.929409, "o", "            \r\n\u001b[?2004l\r"]
[627.929491, "o", "\u001b[?2004h> "]
[627.929526, "o", "            # Detect pedestrians\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.929562, "o", "> "]
[627.92972, "o", "            boxes, weights = hog.detectMultiScale(resized, winStride=(8, 8),\r\n\u001b[?2004l\r"]
[627.929751, "o", "\u001b[?2004h> "]
[627.929952, "o", "                                                  padding=(4, 4), scale=1.05)\r\n\u001b[?2004l\r"]
[627.929988, "o", "\u001b[?2004h> "]
[627.930017, "o", "            \r\n\u001b[?2004l\r"]
[627.930046, "o", "\u001b[?2004h> "]
[627.930174, "o", "            # Scale boxes back to original size\r\n\u001b[?2004l\r"]
[627.930213, "o", "\u001b[?2004h> "]
[627.930392, "o", "            boxes = [(int(x/scale), int(y/scale), int(w/scale), int(h/scale)) \r\n\u001b[?2004l\r"]
[627.930423, "o", "\u001b[?2004h"]
[627.935752, "o", ">                     for (x, y, w, h) in boxes]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.935819, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[627.935851, "o", "> "]
[627.936046, "o", "            # Update tracked pedestrians"]
[627.936085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.936163, "o", "            for box in boxes:\r\n\u001b[?2004l\r"]
[627.936197, "o", "\u001b[?2004h> "]
[627.93628, "o", "                matched = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.936322, "o", "> "]
[627.936401, "o", "                x, y, w, h = box\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.936437, "o", "                \r\n\u001b[?2004l\r"]
[627.936542, "o", "\u001b[?2004h> "]
[627.936719, "o", "                # Try to match with existing tracked pedestrians\r\n\u001b[?2004l\r"]
[627.936751, "o", "\u001b[?2004h> "]
[627.936981, "o", "                for i, ped in enumerate(tracked_pedestrians):"]
[627.937026, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.937061, "o", "> "]
[627.937214, "o", "                    if frame_count - ped['last_seen'] > MAX_FRAMES_MISSING:\r\n\u001b[?2004l\r"]
[627.937246, "o", "\u001b[?2004h> "]
[627.937392, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.937427, "o", "> "]
[627.937524, "o", "                    \r\n\u001b[?2004l\r"]
[627.937559, "o", "\u001b[?2004h> "]
[627.937722, "o", "                    # Calculate IOU (Intersection over Union)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.937926, "o", "                    px, py, pw, ph = ped['box']\r\n\u001b[?2004l\r"]
[627.937964, "o", "\u001b[?2004h"]
[627.938031, "o", "> "]
[627.938109, "o", "                    \r\n\u001b[?2004l\r"]
[627.938139, "o", "\u001b[?2004h"]
[627.938166, "o", "> "]
[627.938368, "o", "                    # Calculate intersection\r\n\u001b[?2004l\r"]
[627.938406, "o", "\u001b[?2004h> "]
[627.938518, "o", "                    ix1 = max(x, px)\r\n\u001b[?2004l\r"]
[627.938556, "o", "\u001b[?2004h> "]
[627.938707, "o", "                    iy1 = max(y, py)\r\n\u001b[?2004l\r"]
[627.938741, "o", "\u001b[?2004h> "]
[627.938924, "o", "                    ix2 = min(x + w, px + pw)\r\n\u001b[?2004l\r"]
[627.938964, "o", "\u001b[?2004h> "]
[627.939144, "o", "                    iy2 = min(y + h, py + ph)\r\n\u001b[?2004l\r"]
[627.939183, "o", "\u001b[?2004h> "]
[627.939274, "o", "                    \r\n\u001b[?2004l\r"]
[627.939312, "o", "\u001b[?2004h> "]
[627.939522, "o", "                    if ix2 > ix1 and iy2 > iy1:\r\n\u001b[?2004l\r"]
[627.939554, "o", "\u001b[?2004h> "]
[627.939703, "o", "                        intersection = (ix2 - ix1) * (iy2 - iy1)\r\n\u001b[?2004l\r"]
[627.939736, "o", "\u001b[?2004h> "]
[627.939905, "o", "                        union = w * h + pw * ph - intersection\r\n\u001b[?2004l\r"]
[627.93995, "o", "\u001b[?2004h> "]
[627.940113, "o", "                        iou = intersection / union if union > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.940152, "o", "> "]
[627.940182, "o", "                        \r\n\u001b[?2004l\r"]
[627.940216, "o", "\u001b[?2004h> "]
[627.940335, "o", "                        if iou > IOU_THRESHOLD:\r\n\u001b[?2004l\r"]
[627.940372, "o", "\u001b[?2004h> "]
[627.940515, "o", "                            # Update existing pedestrian\r\n\u001b[?2004l\r"]
[627.94055, "o", "\u001b[?2004h> "]
[627.940686, "o", "                            tracked_pedestrians[i]['box'] = box\r\n\u001b[?2004l\r"]
[627.940716, "o", "\u001b[?2004h> "]
[627.940905, "o", "                            tracked_pedestrians[i]['last_seen'] = frame_count\r\n\u001b[?2004l\r"]
[627.940939, "o", "\u001b[?2004h> "]
[627.941052, "o", "                            matched = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.941092, "o", "> "]
[627.94116, "o", "                            break\r\n\u001b[?2004l\r"]
[627.941194, "o", "\u001b[?2004h> "]
[627.941241, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h"]
[627.941281, "o", "> "]
[627.941419, "o", "                # If no match found, add as new pedestrian\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.941451, "o", "> "]
[627.941538, "o", "                if not matched:\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.941575, "o", "> "]
[627.941659, "o", "                    tracked_pedestrians.append({\r\n\u001b[?2004l\r"]
[627.941695, "o", "\u001b[?2004h> "]
[627.941779, "o", "                        'box': box,\r\n\u001b[?2004l\r"]
[627.941817, "o", "\u001b[?2004h> "]
[627.941932, "o", "                        'first_seen': frame_count,\r\n\u001b[?2004l\r"]
[627.941967, "o", "\u001b[?2004h> "]
[627.942073, "o", "                        'last_seen': frame_count\r\n\u001b[?2004l\r"]
[627.942111, "o", "\u001b[?2004h> "]
[627.942169, "o", "                    })\r\n\u001b[?2004l\r"]
[627.94221, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[627.942246, "o", "\u001b[?2004h> "]
[627.942278, "o", "    cap.release()\r\n\u001b[?2004l\r"]
[627.942317, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[627.942358, "o", "\u001b[?2004h> "]
[627.942508, "o", "    # Count pedestrians that were seen for a minimum duration\r\n\u001b[?2004l\r"]
[627.942542, "o", "\u001b[?2004h> "]
[627.94258, "o", "    MIN_FRAMES = 3\r\n\u001b[?2004l\r"]
[627.942612, "o", "\u001b[?2004h> "]
[627.942749, "o", "    unique_count = sum(1 for ped in tracked_pedestrians \r\n\u001b[?2004l\r"]
[627.942782, "o", "\u001b[?2004h> "]
[627.942957, "o", "                      if ped['last_seen'] - ped['first_seen'] >= MIN_FRAMES)\r\n\u001b[?2004l\r"]
[627.942993, "o", "\u001b[?2004h>     \r\n"]
[627.943036, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[627.943265, "o", "    return max(unique_count, len(tracked_pedestrians))  # Return at least the total detected\r\n\u001b[?2004l\r"]
[627.943302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[627.94334, "o", "> def main():\r\n"]
[627.943389, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[627.943739, "o", "    video_dir = '/app/video'\r\n\u001b[?2004l\r"]
[627.944999, "o", "\u001b[?2004h> "]
[627.945043, "o", "    results = []\r\n\u001b[?2004l\r"]
[627.94508, "o", "\u001b[?2004h> "]
[627.94512, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.945187, "o", "    # Get all video files\r\n\u001b[?2004l\r"]
[627.945219, "o", "\u001b[?2004h> "]
[627.945412, "o", "    video_files = sorted([f for f in os.listdir(video_dir) if f.endswith('.mp4')])\r\n\u001b[?2004l\r"]
[627.945449, "o", "\u001b[?2004h>     "]
[627.945486, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.945581, "o", "    for video_file in video_files:\r\n\u001b[?2004l\r"]
[627.945623, "o", "\u001b[?2004h> "]
[627.945751, "o", "        video_path = os.path.join(video_dir, video_file)\r\n\u001b[?2004l\r"]
[627.945791, "o", "\u001b[?2004h> "]
[627.945881, "o", "        print(f\"Processing {video_file}...\")\r\n\u001b[?2004l\r"]
[627.945923, "o", "\u001b[?2004h> "]
[627.945957, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.946107, "o", "        count = count_unique_pedestrians(video_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.946143, "o", "> "]
[627.946262, "o", "        print(f\"  Found {count} unique pedestrians\")\r\n\u001b[?2004l\r"]
[627.946305, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[627.946344, "o", "\u001b[?2004h> "]
[627.946406, "o", "        results.append({\r\n\u001b[?2004l\r"]
[627.946452, "o", "\u001b[?2004h> "]
[627.946519, "o", "            'filename': video_file,\r\n\u001b[?2004l\r"]
[627.946556, "o", "\u001b[?2004h> "]
[627.946631, "o", "            'number': count\r\n\u001b[?2004l\r\u001b[?2004h"]
[627.94667, "o", "> "]
[627.946719, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.946765, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[627.946866, "o", "    # Create DataFrame and save to Excel\r\n\u001b[?2004l\r"]
[627.946904, "o", "\u001b[?2004h> "]
[627.946986, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r"]
[627.947021, "o", "\u001b[?2004h> "]
[627.94712, "o", "    output_path = '/app/video/count.xlsx'\r\n\u001b[?2004l\r"]
[627.94716, "o", "\u001b[?2004h> "]
[627.947317, "o", "    df.to_excel(output_path, sheet_name='results', index=False)\r\n\u001b[?2004l\r"]
[627.947361, "o", "\u001b[?2004h> "]
[627.947482, "o", "    print(f\"\\nResults saved to {output_path}\")\r\n\u001b[?2004l\r"]
[627.947516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[627.947549, "o", "\u001b[?2004h> "]
[627.947617, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[627.947812, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[628.200216, "o", "\u001b[?2004hroot@65eda266d5f4:/app/video# "]
