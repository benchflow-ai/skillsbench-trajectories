[390.473989, "o", "\u001b[?2004hroot@65eda266d5f4:/app/video# "]
[627.921582, "i", "cat > count_pedestrians.py << 'EOF'\nimport cv2\nimport pandas as pd\nimport os\nfrom collections import defaultdict\nimport numpy as np\n\ndef count_unique_pedestrians(video_path):\n    \"\"\"Count unique pedestrians in a video using detection and tracking.\"\"\"\n    cap = cv2.VideoCapture(video_path)\n    \n    # Initialize HOG descriptor for pedestrian detection\n    hog = cv2.HOGDescriptor()\n    hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())\n    \n    # Track unique pedestrians\n    tracked_pedestrians = []\n    frame_count = 0\n    \n    # Parameters for tracking\n    IOU_THRESHOLD = 0.3  # Intersection over Union threshold for matching\n    MAX_FRAMES_MISSING = 30  # Maximum frames a pedestrian can be missing\n    \n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        \n        frame_count += 1\n        \n        # Detect pedestrians every few frames to improve performance\n        if frame_count % 5 == 0:\n            # Resize frame for faster processing\n            scale = 0.5\n            resized = cv2.resize(frame, None, fx=scale, fy=scale)\n            \n            # Detect pedestrians\n            boxes, weights = hog.detectMultiScale(resized, winStride=(8, 8),\n                                                  padding=(4, 4), scale=1.05)\n            \n            # Scale boxes back to original size\n            boxes = [(int(x/scale), int(y/scale), int(w/scale), int(h/scale)) \n                    for (x, y, w, h) in boxes]\n            \n            # Update tracked pedestrians\n            for box in boxes:\n                matched = False\n                x, y, w, h = box\n                \n                # Try to match with existing tracked pedestrians\n                for i, ped in enumerate(tracked_pedestrians):\n                    if frame_count - ped['last_seen'] > MAX_FRAMES_MISSING:\n                        continue\n                    \n                    # Calculate IOU (Intersection over Union)\n                    px, py, pw, ph = ped['box']\n                    \n                    # Calculate intersection\n                    ix1 = max(x, px)\n                    iy1 = max(y, py)\n                    ix2 = min(x + w, px + pw)\n                    iy2 = min(y + h, py + ph)\n                    \n                    if ix2 > ix1 and iy2 > iy1:\n                        intersection = (ix2 - ix1) * (iy2 - iy1)\n                        union = w * h + pw * ph - intersection\n                        iou = intersection / union if union > 0 else 0\n                        \n                        if iou > IOU_THRESHOLD:\n                            # Update existing pedestrian\n                            tracked_pedestrians[i]['box'] = box\n                            tracked_pedestrians[i]['last_seen'] = frame_count\n                            matched = True\n                            break\n                \n                # If no match found, add as new pedestrian\n                if not matched:\n                    tracked_pedestrians.append({\n                        'box': box,\n                        'first_seen': frame_count,\n                        'last_seen': frame_count\n                    })\n    \n    cap.release()\n    \n    # Count pedestrians that were seen for a minimum duration\n    MIN_FRAMES = 3\n    unique_count = sum(1 for ped in tracked_pedestrians \n                      if ped['last_seen'] - ped['first_seen'] >= MIN_FRAMES)\n    \n    return max(unique_count, len(tracked_pedestrians))  # Return at least the total detected\n\ndef main():\n    video_dir = '/app/video'\n    results = []\n    \n    # Get all video files\n    video_files = sorted([f for f in os.listdir(video_dir) if f.endswith('.mp4')])\n    \n    for video_file in video_files:\n        video_path = os.path.join(video_dir, video_file)\n        print(f\"Processing {video_file}...\")\n        \n        count = count_unique_pedestrians(video_path)\n        print(f\"  Found {count} unique pedestrians\")\n        \n        results.append({\n            'filename': video_file,\n            'number': count\n        })\n    \n    # Create DataFrame and sav"]
[627.92165, "i", "e to Excel\n    df = pd.DataFrame(results)\n    output_path = '/app/video/count.xlsx'\n    df.to_excel(output_path, sheet_name='results', index=False)\n    print(f\"\\nResults saved to {output_path}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
