[132.954272, "i", "cat > /root/export_obj.mjs <<'EOF'\nimport fs from 'fs';\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from 'file:///root/data/object.js';\n\n// Build scene\nconst root = createScene();\n\n// Apply Blender Z-up conversion: rotate -90 degrees about X\nroot.rotation.x = -Math.PI / 2;\n\n// Replace InstancedMesh with regular Mesh instances\nfunction expandInstancedMeshes(scene) {\n  const instanced = [];\n  scene.traverse((child) => {\n    if (child.isInstancedMesh) instanced.push(child);\n  });\n\n  for (const im of instanced) {\n    im.updateMatrix();\n    const parent = im.parent;\n    const group = new THREE.Group();\n    group.name = im.name + '_expanded';\n\n    const temp = new THREE.Matrix4();\n    const local = new THREE.Matrix4();\n\n    for (let i = 0; i < im.count; i++) {\n      im.getMatrixAt(i, temp);\n      local.multiplyMatrices(im.matrix, temp);\n      const mesh = new THREE.Mesh(im.geometry, im.material);\n      mesh.name = `${im.name}_${i}`;\n      mesh.matrix.copy(local);\n      mesh.matrixAutoUpdate = false;\n      group.add(mesh);\n    }\n\n    parent.add(group);\n    parent.remove(im);\n  }\n}\n\nexpandInstancedMeshes(root);\nroot.updateMatrixWorld(true);\n\n// Export to OBJ\nconst exporter = new OBJExporter();\nconst objText = exporter.parse(root);\n\nfs.writeFileSync('/root/output/object.obj', objText, 'utf8');\nconsole.log('OBJ exported to /root/output/object.obj');\nEOF\n"]
