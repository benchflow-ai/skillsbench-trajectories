[?2004l[?2004h> vendor_by_name = {row['name']: row for _, row in vendors_df.iterrows()}
[?2004l[?2004h> vendor_by_id = {row['id']: row for _, row in vendors_df.iterrows()}
[?2004l[?2004h> po_by_number = {row['po_number']: row for _, row in po_df.iterrows()}
[?2004l[?2004h> 
[?2004l[?2004h> # Function for fuzzy matching
[?2004l[?2004h> def fuzzy_match_vendor(name, threshold=0.8):
[?2004l[?2004h>     best_match = None
[?2004l[?2004h>     best_ratio = 0
[?2004l[?2004h>     for vendor_name in vendor_by_name.keys():
[?2004l[?2004h>         ratio = SequenceMatcher(None, name.lower(), vendor_name.lower()).ratio()
[?2004l[?2004h>         if ratio > best_ratio:
[?2004l[?2004h>             best_ratio = ratio
[?2004l[?2004h>             best_match = vendor_name
[?2004l[?2004h>     if best_ratio >= threshold:
[?2004l[?2004h>         return best_match
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # Extract invoices from PDF
[?2004l[?2004h> invoices = []
[?2004l[?2004h> with pdfplumber.open('/root/invoices.pdf') as pdf:
[?2004l[?2004h>     for page_num, page in enumerate(pdf.pages, 1):
