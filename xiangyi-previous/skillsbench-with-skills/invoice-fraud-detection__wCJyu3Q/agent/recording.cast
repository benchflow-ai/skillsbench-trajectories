[39.142676, "i", "python3 << 'EOF'\nimport pdfplumber\nimport pandas as pd\nimport json\nfrom difflib import SequenceMatcher\n\n# Load vendors and POs\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npo_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Create lookup dictionaries\nvendor_by_name = {row['name']: row for _, row in vendors_df.iterrows()}\nvendor_by_id = {row['id']: row for _, row in vendors_df.iterrows()}\npo_by_number = {row['po_number']: row for _, row in po_df.iterrows()}\n\n# Function for fuzzy matching\ndef fuzzy_match_vendor(name, threshold=0.8):\n    best_match = None\n    best_ratio = 0\n    for vendor_name in vendor_by_name.keys():\n        ratio = SequenceMatcher(None, name.lower(), vendor_name.lower()).ratio()\n        if ratio > best_ratio:\n            best_ratio = ratio\n            best_match = vendor_name\n    if best_ratio >= threshold:\n        return best_match\n    return None\n\n# Extract invoices from PDF\ninvoices = []\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages, 1):\n        text = page.extract_text()\n        lines = text.strip().split('\\n')\n        \n        invoice = {'page': page_num}\n        for line in lines:\n            if line.startswith('From:'):\n                invoice['vendor_name'] = line.replace('From:', '').strip()\n            elif line.startswith('Total'):\n                amount_str = line.replace('Total', '').replace('$', '').strip()\n                invoice['amount'] = float(amount_str)\n            elif line.startswith('Payment IBAN:'):\n                invoice['iban'] = line.replace('Payment IBAN:', '').strip()\n            elif line.startswith('PO Number:'):\n                invoice['po_number'] = line.replace('PO Number:', '').strip()\n        \n        invoices.append(invoice)\n\n# Fraud detection\nfraud_report = []\n\nfor invoice in invoices:\n    reason = None\n    \n    # 1. Check for Unknown Vendor\n    vendor_name = invoice['vendor_name']\n    matched_vendor = None\n    \n    if vendor_name in vendor_by_name:\n        matched_vendor = vendor_by_name[vendor_name]\n    else:\n        # Try fuzzy matching\n        fuzzy_match = fuzzy_match_vendor(vendor_name)\n        if fuzzy_match:\n            matched_vendor = vendor_by_name[fuzzy_match]\n        else:\n            reason = \"Unknown Vendor\"\n    \n    if reason is None and matched_vendor is not None:\n        # 2. Check for IBAN Mismatch\n        if invoice['iban'] != matched_vendor['iban']:\n            reason = \"IBAN Mismatch\"\n    \n    if reason is None:\n        # 3. Check for Invalid PO\n        po_number = invoice.get('po_number')\n        if po_number not in po_by_number:\n            reason = \"Invalid PO\"\n        else:\n            po = po_by_number[po_number]\n            \n            # 4. Check for Amount Mismatch\n            if abs(invoice['amount'] - po['amount']) > 0.01:\n                reason = \"Amount Mismatch\"\n            \n            # 5. Check for Vendor Mismatch\n            if reason is None and matched_vendor is not None:\n                if po['vendor_id'] != matched_vendor['id']:\n                    reason = \"Vendor Mismatch\"\n    \n    # Add to fraud report if fraudulent\n    if reason is not None:\n        fraud_report.append({\n            \"invoice_page_number\": invoice['page'],\n            \"vendor_name\": invoice['vendor_name'],\n            \"invoice_amount\": invoice['amount'],\n            \"iban\": invoice['iban'],\n            \"po_number\": invoice.get('po_number'),\n            \"reason\": reason\n        })\n\nprint(f\"Found {len(fraud_report)} fraudulent invoices\")\nfor fraud in fraud_report[:5]:\n    print(fraud)\n\n# Save to file\nwith open('/root/fraud_report.json', 'w') as f:\n    json.dump(fraud_report, f, indent=2)\n\nprint(f\"\\nFraud report saved to /root/fraud_report.json\")\nEOF\n"]
