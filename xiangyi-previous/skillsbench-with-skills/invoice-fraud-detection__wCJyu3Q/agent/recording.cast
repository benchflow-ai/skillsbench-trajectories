[59.365939, "i", "python3 << 'EOF'\nimport json\n\nwith open('/root/fraud_report.json', 'r') as f:\n    data = json.load(f)\n\nprint(\"Sample fraudulent invoices:\")\nprint(\"\\n1. First invoice (IBAN Mismatch):\")\nprint(json.dumps(data[0], indent=2))\n\nprint(\"\\n2. Unknown Vendor example:\")\nfor inv in data:\n    if inv['reason'] == 'Unknown Vendor':\n        print(json.dumps(inv, indent=2))\n        break\n\nprint(\"\\n3. Invalid PO example:\")\nfor inv in data:\n    if inv['reason'] == 'Invalid PO':\n        print(json.dumps(inv, indent=2))\n        break\n\nprint(\"\\n4. Vendor Mismatch check (if any):\")\nhas_vendor_mismatch = any(inv['reason'] == 'Vendor Mismatch' for inv in data)\nprint(f\"Found Vendor Mismatch: {has_vendor_mismatch}\")\n\nprint(\"\\nFraud summary:\")\nfor reason in sorted(set(inv['reason'] for inv in data)):\n    count = sum(1 for inv in data if inv['reason'] == reason)\n    print(f\"  {reason}: {count}\")\nEOF\n"]
