[27.469655, "i", "python3 << 'EOF'\nimport pdfplumber\nimport pandas as pd\nimport json\nfrom difflib import SequenceMatcher\n\n# Load vendors and POs\nvendors_df = pd.read_excel('/root/vendors.xlsx')\npo_df = pd.read_csv('/root/purchase_orders.csv')\n\n# Create lookup dictionaries\nvendor_by_name = {row['name']: row for _, row in vendors_df.iterrows()}\nvendor_by_id = {row['id']: row for _, row in vendors_df.iterrows()}\npo_by_number = {row['po_number']: row for _, row in po_df.iterrows()}\n\n# Function for fuzzy matching\ndef fuzzy_match_vendor(name, threshold=0.8):\n    best_match = None\n    best_ratio = 0\n    for vendor_name in vendor_by_name.keys():\n        ratio = SequenceMatcher(None, name.lower(), vendor_name.lower()).ratio()\n        if ratio > best_ratio:\n            best_ratio = ratio\n            best_match = vendor_name\n    if best_ratio >= threshold:\n        return best_match\n    return None\n\n# Extract invoices from PDF\ninvoices = []\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages, 1):\n        text = page.extract_text()\n        lines = text.strip().split('\\n')\n        \n        invoice = {'page': page_num}\n        for line in lines:\n            if line.startswith('From:'):\n                invoice['vendor_name'] = line.replace('From:', '').strip()\n            elif line.startswith('Total'):\n                amount_str = line.replace('Total', '').replace('$', '').strip()\n                invoice['amount'] = float(amount_str)\n            elif line.startswith('Payment IBAN:'):\n                invoice['iban'] = line.replace('Payment IBAN:', '').strip()\n            elif line.startswith('PO Number:'):\n                invoice['po_number'] = line.replace('PO Number:', '').strip()\n        \n        invoices.append(invoice)\n\nprint(f\"Extracted {len(invoices)} invoices\")\nprint(\"First 3 invoices:\")\nfor inv in invoices[:3]:\n    print(inv)\nEOF\n"]
