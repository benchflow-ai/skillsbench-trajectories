[39.144309, "o", "po_by_number = {row['po_number']: row for _, row in po_df.iterrows()}\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.144349, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.144446, "o", "# Function for fuzzy matching\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.144568, "o", "def fuzzy_match_vendor(name, threshold=0.8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.144623, "o", "    best_match = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.144698, "o", "    best_ratio = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.144792, "o", "> "]
[39.144911, "o", "    for vendor_name in vendor_by_name.keys():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.145045, "o", "        ratio = SequenceMatcher(None, name.lower(), vendor_name.lower()).ratio()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.145116, "o", "        if ratio > best_ratio:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.145208, "o", "            best_ratio = ratio\r\n\u001b[?2004l\r"]
[39.14524, "o", "\u001b[?2004h> "]
[39.145415, "o", "            best_match = vendor_name\r\n\u001b[?2004l\r\u001b[?2004h>     if best_ratio >= threshold:\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.145453, "o", "> "]
[39.145579, "o", "        return best_match\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.145661, "o", ">     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract invoices from PDF\r\n\u001b[?2004l\r"]
[39.145722, "o", "\u001b[?2004h> invoices = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.145789, "o", "with pdfplumber.open('/root/invoices.pdf') as pdf:\r\n\u001b[?2004l\r"]
[39.145861, "o", "\u001b[?2004h> "]
[39.14594, "o", "    for page_num, page in enumerate(pdf.pages, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146, "o", "        text = page.extract_text()\r\n\u001b[?2004l\r"]
[39.146066, "o", "\u001b[?2004h> "]
[39.146109, "o", "        lines = text.strip().split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[39.14615, "o", "\u001b[?2004h> "]
[39.146297, "o", "        invoice = {'page': page_num}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146373, "o", "        for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146455, "o", "            if line.startswith('From:'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146648, "o", "                invoice['vendor_name'] = line.replace('From:', '').strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146727, "o", "            elif line.startswith('Total'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146865, "o", "                amount_str = line.replace('Total', '').replace('$', '').strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.146965, "o", "                invoice['amount'] = float(amount_str)\r\n\u001b[?2004l\r"]
[39.147018, "o", "\u001b[?2004h> "]
[39.147069, "o", "            elif line.startswith('Payment IBAN:'):\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.1471, "o", "> "]
[39.147238, "o", "                invoice['iban'] = line.replace('Payment IBAN:', '').strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.147274, "o", "> "]
[39.147357, "o", "            elif line.startswith('PO Number:'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.147542, "o", "                invoice['po_number'] = line.replace('PO Number:', '').strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.147668, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         invoices.append(invoice)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[39.147791, "o", "> # Fraud detection\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.147828, "o", "> fraud_report = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.14797, "o", "for invoice in invoices:\r\n\u001b[?2004l\r\u001b[?2004h>     reason = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[39.148047, "o", "\u001b[?2004h> "]
[39.148105, "o", "    # 1. Check for Unknown Vendor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.14817, "o", "    vendor_name = invoice['vendor_name']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.148296, "o", "    matched_vendor = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.148355, "o", "    if vendor_name in vendor_by_name:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.148463, "o", "        matched_vendor = vendor_by_name[vendor_name]\r\n\u001b[?2004l\r"]
[39.1485, "o", "\u001b[?2004h> "]
[39.148594, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.148705, "o", "        # Try fuzzy matching\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.148801, "o", "        fuzzy_match = fuzzy_match_vendor(vendor_name)\r\n\u001b[?2004l\r"]
[39.148854, "o", "\u001b[?2004h> "]
[39.148919, "o", "        if fuzzy_match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.14905, "o", "            matched_vendor = vendor_by_name[fuzzy_match]\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.149122, "o", ">         else:\r\n\u001b[?2004l\r"]
[39.149182, "o", "\u001b[?2004h> "]
[39.149215, "o", "            reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r"]
[39.149353, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[39.149412, "o", "\u001b[?2004h>     if reason is None and matched_vendor is not None:\r\n\u001b[?2004l\r"]
[39.149481, "o", "\u001b[?2004h> "]
[39.149536, "o", "        # 2. Check for IBAN Mismatch\r\n\u001b[?2004l\r"]
[39.149597, "o", "\u001b[?2004h> "]
[39.14972, "o", "        if invoice['iban'] != matched_vendor['iban']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.149799, "o", "            reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r"]
[39.149866, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[39.149901, "o", "\u001b[?2004h> "]
[39.149927, "o", "    if reason is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150104, "o", "        # 3. Check for Invalid PO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150212, "o", "        po_number = invoice.get('po_number')\r\n\u001b[?2004l\r"]
[39.15027, "o", "\u001b[?2004h> "]
[39.150339, "o", "        if po_number not in po_by_number:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.15039, "o", "            reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.150431, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150496, "o", "            po = po_by_number[po_number]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150549, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[39.150587, "o", "> "]
[39.150626, "o", "            # 4. Check for Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150707, "o", "            if abs(invoice['amount'] - po['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.150758, "o", "> "]
[39.150806, "o", "                reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.150843, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.150912, "o", "            # 5. Check for Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.150958, "o", "> "]
[39.151019, "o", "            if reason is None and matched_vendor is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.15104, "o", "> "]
[39.151124, "o", "                if po['vendor_id'] != matched_vendor['id']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.151143, "o", "> "]
[39.151214, "o", "                    reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r"]
[39.151235, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[39.151256, "o", "\u001b[?2004h> "]
[39.151315, "o", "    # Add to fraud report if fraudulent\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.151337, "o", "> "]
[39.151373, "o", "    if reason is not None:\r\n\u001b[?2004l\r"]
[39.151392, "o", "\u001b[?2004h> "]
[39.151435, "o", "        fraud_report.append({\r\n\u001b[?2004l\r"]
[39.151458, "o", "\u001b[?2004h> "]
[39.151538, "o", "            \"invoice_page_number\": invoice['page'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.151559, "o", "> "]
[39.151627, "o", "            \"vendor_name\": invoice['vendor_name'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.151648, "o", "> "]
[39.151721, "o", "            \"invoice_amount\": invoice['amount'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.151754, "o", "> "]
[39.151789, "o", "            \"iban\": invoice['iban'],\r\n\u001b[?2004l\r"]
[39.151811, "o", "\u001b[?2004h> "]
[39.151884, "o", "            \"po_number\": invoice.get('po_number'),\r\n\u001b[?2004l\r"]
[39.151905, "o", "\u001b[?2004h> "]
[39.151943, "o", "            \"reason\": reason\r\n\u001b[?2004l\r"]
[39.151967, "o", "\u001b[?2004h> "]
[39.151986, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[39.152004, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[39.152097, "o", "print(f\"Found {len(fraud_report)} fraudulent invoices\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.152117, "o", "> "]
[39.152165, "o", "for fraud in fraud_report[:5]:\r\n\u001b[?2004l\r"]
[39.152189, "o", "\u001b[?2004h> "]
[39.152211, "o", "    print(fraud)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[39.152232, "o", "\u001b[?2004h> "]
[39.152259, "o", "# Save to file\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.152279, "o", "> "]
[39.15235, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[39.152373, "o", "\u001b[?2004h> "]
[39.152427, "o", "    json.dump(fraud_report, f, indent=2)\r\n\u001b[?2004l\r"]
[39.152452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[39.152471, "o", "> "]
[39.152563, "o", "print(f\"\\nFraud report saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.152582, "o", "> EOF\r\n\u001b[?2004l\r"]
[40.335245, "o", "Found 50 fraudulent invoices\r\n{'invoice_page_number': 1, 'vendor_name': 'Vendor 11', 'invoice_amount': 8623.76, 'iban': 'FRADULENT_IBAN', 'po_number': 'PO-1030', 'reason': 'IBAN Mismatch'}\r\n{'invoice_page_number': 2, 'vendor_name': 'Vendor 3', 'invoice_amount': 8347.33, 'iban': 'IBAN000000003', 'po_number': 'PO-1412', 'reason': 'Amount Mismatch'}\r\n{'invoice_page_number': 3, 'vendor_name': 'Fraudulent Corp', 'invoice_amount': 3034.55, 'iban': 'IBAN000000003', 'po_number': 'PO-1181', 'reason': 'Unknown Vendor'}\r\n{'invoice_page_number': 4, 'vendor_name': 'Vendor 31', 'invoice_amount': 2426.91, 'iban': 'IBAN000000031', 'po_number': 'PO-INVALID', 'reason': 'Invalid PO'}\r\n{'invoice_page_number': 5, 'vendor_name': 'Vendor 80', 'invoice_amount': 7056.43, 'iban': 'IBAN000000080', 'po_number': 'PO-1415', 'reason': 'Amount Mismatch'}\r\n"]
