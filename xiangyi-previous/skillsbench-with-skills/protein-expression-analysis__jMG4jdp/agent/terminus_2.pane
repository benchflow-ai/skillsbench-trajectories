[?2004hroot@395330d346a0:~# cat <<EOF > verify_names.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('protein_expression.xlsx')
[?2004l[?2004h> ws_task = wb['Task']
[?2004l[?2004h> ws_data = wb['Data']
[?2004l[?2004h> 
[?2004l[?2004h> # Get Task samples
[?2004l[?2004h> task_samples = [cell.value for cell in ws_task[10][2:12]] # C10 to L10
[?2004l[?2004h> 
[?2004l[?2004h> # Get Data samples
[?2004l[?2004h> data_samples = [cell.value for cell in ws_data[1]]
[?2004l[?2004h> 
[?2004l[?2004h> print('Checking sample name matches...')
[?2004l[?2004h> for sample in task_samples:
[?2004l[?2004h>     if sample in data_samples:
[?2004l[?2004h>         print(f'[OK] {sample} found in Data')
[?2004l[?2004h>     else:
[?2004l[?2004h>         print(f'[MISSING] {sample} NOT found in Data')
[?2004l[?2004h>         # Print potential partial matches
[?2004l[?2004h>         matches = [s for s in data_samples if s and (sample in s or s in sample)]
[?2004l[?2004h>         print(f'   Potential matches: {matches}')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
