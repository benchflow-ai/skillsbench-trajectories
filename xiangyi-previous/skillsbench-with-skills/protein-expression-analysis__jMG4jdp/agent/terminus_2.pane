[OK] TE6_OESOPHAGUS_TenPx17 found in Data
[OK] FUOV1_OVARY_TenPx16 found in Data
[OK] LS513_LARGE_INTESTINE_TenPx09 found in Data
[OK] THP1_HAEMATOPOIETIC_AND_LYMPHOID_TISSUE_TenPx24 found in Data
[OK] SW48_LARGE_INTESTINE_TenPx07 found in Data
[OK] NCIN87_STOMACH_TenPx26 found in Data
[?2004hroot@395330d346a0:~# cat <<EOF > solve_protein.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> file_path = 'protein_expression.xlsx'
[?2004l[?2004h> wb = openpyxl.load_workbook(file_path)
[?2004l[?2004h> ws = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Pull expression data (C11:L20)
[?2004l[?2004h> # Rows 11-20 (Proteins), Cols C-L (Samples)
[?2004l[?2004h> for row in range(11, 21):
[?2004l[?2004h>     for col in range(3, 13): # C is 3, L is 12
[?2004l[?2004h>         cell = ws.cell(row=row, column=col)
[?2004l[?2004h>         # Formula: =INDEX(Data!A:ZZ, MATCH(A{row}, Data!A:A, 0), MATCH({col_letter}10, Data!1:1, 0))
[?2004l[?2004h>         # Use relative reference for A{row} and {col_letter}10 so it's clean, but specific is fine too.
[?2004l[?2004h>         col_letter = get_column_letter(col)
[?2004l[?2004h>         formula = f'=INDEX(Data!$A:$ZZ,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'
[?2004l[?2004h>         cell.value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Calculate group statistics (B24:K27)
[?2004l[?2004h> # Transposed: Col B -> Protein at Row 11, Col C -> Protein at Row 12, etc.
[?2004l[?2004h> # Control samples: C{row}:G{row}
[?2004l[?2004h> # Treated samples: H{row}:L{row}
[?2004l[?2004h> 
[?2004l[?2004h> stats_start_col = 2 # B
[?2004l[?2004h> for i in range(10): # 10 proteins
[?2004l[?2004h>     col = stats_start_col + i
[?2004l[?2004h>     protein_row = 11 + i
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 24: Control Mean
[?2004l[?2004h>     ws.cell(row=24, column=col).value = f'=AVERAGE(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 25: Control StdDev
[?2004l[?2004h>     ws.cell(row=25, column=col).value = f'=STDEV.S(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 26: Treated Mean
[?2004l[?2004h>     ws.cell(row=26, column=col).value = f'=AVERAGE(H{protein_row}:L{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 27: Treated StdDev
[?2004l[?2004h>     ws.cell(row=27, column=col).value = f'=STDEV.S(H{protein_row}:L{protein_row})'
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Fold change calculations (C32:D41)
[?2004l[?2004h> # Rows 32-41 correspond to Proteins 1-10
[?2004l[?2004h> # Stats are in Cols B-K (Row 24=CtrlMean, Row 26=TrtMean)
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(10):
[?2004l[?2004h>     row = 32 + i
[?2004l[?2004h>     stats_col_letter = get_column_letter(2 + i) # B, C, D...
[?2004l[?2004h>     
[?2004l[?2004h>     # Log2 Fold Change (Col D) = Treated Mean - Control Mean
[?2004l[?2004h>     # Treated Mean is Row 26, Control Mean is Row 24
[?2004l[?2004h>     ws.cell(row=row, column=4).value = f'={stats_col_letter}$26-{stats_col_letter}$24'
[?2004l[?2004h>     
[?2004l[?2004h>     # Fold Change (Col C) = 2^(Log2 FC)
[?2004l[?2004h>     ws.cell(row=row, column=3).value = f'=2^D{row}'
[?2004l[?2004h> 
[?2004l[?2004h> wb.save(file_path)
[?2004l[?2004h> print("Formulas written successfully.")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@395330d346a0:~# python3 solve_protein.py
[?2004lFormulas written successfully.
[?2004hroot@395330d346a0:~# cat <<EOF > verify_formulas.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> 
[?2004l[?2004h> wb = openpyxl.load_workbook('protein_expression.xlsx')
[?2004l[?2004h> ws = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> cells_to_check = ['C11', 'B24', 'C32', 'D32']
[?2004l[?2004h> print("Checking formulas:")
[?2004l[?2004h> for addr in cells_to_check:
[?2004l[?2004h>     print(f"{addr}: {ws[addr].value}")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@395330d346a0:~# python3 verify_formulas.py
[?2004lChecking formulas:
C11: =INDEX(Data!:,MATCH(11,Data!:,0),MATCH(C0,Data!:,0))
B24: =AVERAGE(C11:G11)
C32: =2^D32
D32: =B6-B4
[?2004hroot@395330d346a0:~# cat <<'EOF' > solve_protein.py
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl.utils import get_column_letter
[?2004l[?2004h> 
[?2004l[?2004h> file_path = 'protein_expression.xlsx'
[?2004l[?2004h> wb = openpyxl.load_workbook(file_path)
[?2004l[?2004h> ws = wb['Task']
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Pull expression data (C11:L20)
[?2004l[?2004h> for row in range(11, 21):
[?2004l[?2004h>     for col in range(3, 13): # C is 3, L is 12
[?2004l[?2004h>         cell = ws.cell(row=row, column=col)
[?2004l[?2004h>         col_letter = get_column_letter(col)
[?2004l[?2004h>         # Formula: =INDEX(Data!$A:$ZZ, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))
[?2004l[?2004h>         formula = f'=INDEX(Data!$A:$ZZ,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'
[?2004l[?2004h>         cell.value = formula
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Calculate group statistics (B24:K27)
[?2004l[?2004h> stats_start_col = 2 # B
[?2004l[?2004h> for i in range(10): # 10 proteins
[?2004l[?2004h>     col = stats_start_col + i
[?2004l[?2004h>     protein_row = 11 + i
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 24: Control Mean
[?2004l[?2004h>     ws.cell(row=24, column=col).value = f'=AVERAGE(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 25: Control StdDev
[?2004l[?2004h>     ws.cell(row=25, column=col).value = f'=STDEV.S(C{protein_row}:G{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 26: Treated Mean
[?2004l[?2004h>     ws.cell(row=26, column=col).value = f'=AVERAGE(H{protein_row}:L{protein_row})'
[?2004l[?2004h>     
[?2004l[?2004h>     # Row 27: Treated StdDev
[?2004l[?2004h>     ws.cell(row=27, column=col).value = f'=STDEV.S(H{protein_row}:L{protein_row})'
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Fold change calculations (C32:D41)
[?2004l[?2004h> for i in range(10):
[?2004l[?2004h>     row = 32 + i
[?2004l[?2004h>     stats_col_letter = get_column_letter(2 + i) # B, C, D...
[?2004l[?2004h>     
[?2004l[?2004h>     # Log2 Fold Change (Col D) = Treated Mean - Control Mean
[?2004l[?2004h>     ws.cell(row=row, column=4).value = f'={stats_col_letter}$26-{stats_col_letter}$24'
[?2004l[?2004h>     
[?2004l[?2004h>     # Fold Change (Col C) = 2^(Log2 FC)
[?2004l[?2004h>     ws.cell(row=row, column=3).value = f'=2^D{row}'
[?2004l[?2004h> 
[?2004l[?2004h> wb.save(file_path)
[?2004l[?2004h> print("Formulas written successfully.")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@395330d346a0:~# python3 solve_protein.py
[?2004lFormulas written successfully.
