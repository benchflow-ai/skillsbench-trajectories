[207.086441, "o", "\u001b[?2004hroot@395330d346a0:~# "]
[234.069178, "i", "cat <<'EOF' > solve_protein.py\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nfile_path = 'protein_expression.xlsx'\nwb = openpyxl.load_workbook(file_path)\nws = wb['Task']\n\n# 1. Pull expression data (C11:L20)\nfor row in range(11, 21):\n    for col in range(3, 13): # C is 3, L is 12\n        cell = ws.cell(row=row, column=col)\n        col_letter = get_column_letter(col)\n        # Formula: =INDEX(Data!$A:$ZZ, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))\n        formula = f'=INDEX(Data!$A:$ZZ,MATCH($A{row},Data!$A:$A,0),MATCH({col_letter}$10,Data!$1:$1,0))'\n        cell.value = formula\n\n# 2. Calculate group statistics (B24:K27)\nstats_start_col = 2 # B\nfor i in range(10): # 10 proteins\n    col = stats_start_col + i\n    protein_row = 11 + i\n    \n    # Row 24: Control Mean\n    ws.cell(row=24, column=col).value = f'=AVERAGE(C{protein_row}:G{protein_row})'\n    \n    # Row 25: Control StdDev\n    ws.cell(row=25, column=col).value = f'=STDEV.S(C{protein_row}:G{protein_row})'\n    \n    # Row 26: Treated Mean\n    ws.cell(row=26, column=col).value = f'=AVERAGE(H{protein_row}:L{protein_row})'\n    \n    # Row 27: Treated StdDev\n    ws.cell(row=27, column=col).value = f'=STDEV.S(H{protein_row}:L{protein_row})'\n\n# 3. Fold change calculations (C32:D41)\nfor i in range(10):\n    row = 32 + i\n    stats_col_letter = get_column_letter(2 + i) # B, C, D...\n    \n    # Log2 Fold Change (Col D) = Treated Mean - Control Mean\n    ws.cell(row=row, column=4).value = f'={stats_col_letter}$26-{stats_col_letter}$24'\n    \n    # Fold Change (Col C) = 2^(Log2 FC)\n    ws.cell(row=row, column=3).value = f'=2^D{row}'\n\nwb.save(file_path)\nprint(\"Formulas written successfully.\")\nEOF\n"]
