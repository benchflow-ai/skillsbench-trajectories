[72.74578, "o", "        print(f'[OK] {sample} found in Data')\r\n\u001b[?2004l\r"]
[72.745833, "o", "\u001b[?2004h> "]
[72.745885, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.746002, "o", "        print(f'[MISSING] {sample} NOT found in Data')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.746068, "o", "        # Print potential partial matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.746219, "o", "        matches = [s for s in data_samples if s and (sample in s or s in sample)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.74631, "o", "        print(f'   Potential matches: {matches}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
