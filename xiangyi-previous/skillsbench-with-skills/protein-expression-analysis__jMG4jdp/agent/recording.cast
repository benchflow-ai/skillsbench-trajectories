[72.744288, "i", "cat <<EOF > verify_names.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\nws_task = wb['Task']\nws_data = wb['Data']\n\n# Get Task samples\ntask_samples = [cell.value for cell in ws_task[10][2:12]] # C10 to L10\n\n# Get Data samples\ndata_samples = [cell.value for cell in ws_data[1]]\n\nprint('Checking sample name matches...')\nfor sample in task_samples:\n    if sample in data_samples:\n        print(f'[OK] {sample} found in Data')\n    else:\n        print(f'[MISSING] {sample} NOT found in Data')\n        # Print potential partial matches\n        matches = [s for s in data_samples if s and (sample in s or s in sample)]\n        print(f'   Potential matches: {matches}')\n\nEOF\n"]
