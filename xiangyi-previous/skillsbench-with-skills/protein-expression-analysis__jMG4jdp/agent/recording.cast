[234.072806, "o", "> "]
[234.072918, "o", "    ws.cell(row=26, column=col).value = f'=AVERAGE(H{protein_row}:L{protein_row})'\r\n\u001b[?2004l\r"]
[234.072944, "o", "\u001b[?2004h> "]
[234.07301, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.073036, "o", "> "]
[234.073123, "o", "    # Row 27: Treated StdDev\r\n\u001b[?2004l\r"]
[234.073208, "o", "\u001b[?2004h> "]
[234.073277, "o", "    ws.cell(row=27, column=col).value = f'=STDEV.S(H{protein_row}:L{protein_row})'\r\n\u001b[?2004l\r"]
[234.073337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.073389, "o", "> "]
[234.073432, "o", "# 3. Fold change calculations (C32:D41)\r\n\u001b[?2004l\r"]
[234.073478, "o", "\u001b[?2004h> "]
[234.073504, "o", "for i in range(10):\r\n\u001b[?2004l\r"]
[234.073578, "o", "\u001b[?2004h> "]
[234.073626, "o", "    row = 32 + i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.073732, "o", "    stats_col_letter = get_column_letter(2 + i) # B, C, D...\r\n\u001b[?2004l\r"]
[234.073785, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[234.073834, "o", "\u001b[?2004h> "]
[234.07394, "o", "    # Log2 Fold Change (Col D) = Treated Mean - Control Mean\r\n\u001b[?2004l\r"]
[234.073988, "o", "\u001b[?2004h> "]
[234.074167, "o", "    ws.cell(row=row, column=4).value = f'={stats_col_letter}$26-{stats_col_letter}$24'\r\n\u001b[?2004l\r"]
[234.074224, "o", "\u001b[?2004h> "]
[234.074279, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.074327, "o", "    # Fold Change (Col C) = 2^(Log2 FC)\r\n\u001b[?2004l\r"]
[234.074376, "o", "\u001b[?2004h> "]
[234.074478, "o", "    ws.cell(row=row, column=3).value = f'=2^D{row}'\r\n\u001b[?2004l\r"]
[234.074524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.074571, "o", "> "]
[234.074618, "o", "wb.save(file_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.074665, "o", "> "]
[234.074712, "o", "print(\"Formulas written successfully.\")\r\n\u001b[?2004l\r"]
[234.074763, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[234.07603, "o", "\u001b[?2004hroot@395330d346a0:~# "]
[234.234159, "i", "python3 solve_protein.py\n"]
[234.2344, "o", "python3 solve_protein.py\r\n\u001b[?2004l\r"]
[234.487983, "o", "Formulas written successfully.\r\n"]
[234.513024, "o", "\u001b[?2004hroot@395330d346a0:~# "]
[237.234274, "i", "python3 verify_formulas.py\n"]
[237.234478, "o", "python3 verify_formulas.py\r\n\u001b[?2004l\r"]
