[20.491262, "i", "cat <<EOF > inspect_excel.py\nimport openpyxl\n\nwb = openpyxl.load_workbook('protein_expression.xlsx')\nprint('Sheets:', wb.sheetnames)\n\nws_task = wb['Task']\nprint('\\n--- Task Sheet Header/Setup (Rows 8-20) ---')\nfor i, row in enumerate(ws_task.iter_rows(min_row=8, max_row=20, values_only=True), start=8):\n    print(f'Row {i}: {row}')\n\nprint('\\n--- Task Sheet Stats Area (Rows 23-28) ---')\nfor i, row in enumerate(ws_task.iter_rows(min_row=23, max_row=28, values_only=True), start=23):\n    print(f'Row {i}: {row}')\n\nprint('\\n--- Task Sheet Fold Change Area (Rows 31-42) ---')\nfor i, row in enumerate(ws_task.iter_rows(min_row=31, max_row=42, values_only=True), start=31):\n    print(f'Row {i}: {row}')\n\nws_data = wb['Data']\nprint('\\n--- Data Sheet (First 5 rows) ---')\nfor i, row in enumerate(ws_data.iter_rows(min_row=1, max_row=5, values_only=True), start=1):\n    print(f'Row {i}: {row}')\nEOF\n"]
