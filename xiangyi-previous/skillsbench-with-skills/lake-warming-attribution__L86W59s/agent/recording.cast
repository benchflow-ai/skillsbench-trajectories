[18.295276, "o", "# Find the most important feature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.29535, "o", "most_important_idx = np.argmax(coefficients)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.295445, "o", "most_important_var = all_features[most_important_idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.295563, "o", "most_important_coef = model.coef_[most_important_idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.295637, "o", "# Calculate contribution as percentage\r\n\u001b[?2004l\r"]
[18.295691, "o", "\u001b[?2004h> "]
[18.295759, "o", "# Using the absolute values of standardized coefficients\r\n\u001b[?2004l\r"]
[18.295811, "o", "\u001b[?2004h> "]
[18.295854, "o", "total_importance = np.sum(coefficients)\r\n\u001b[?2004l\r"]
[18.2959, "o", "\u001b[?2004h> "]
[18.29602, "o", "contribution_pct = (coefficients[most_important_idx] / total_importance) * 100\r\n\u001b[?2004l\r"]
[18.296072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296177, "o", "print(f\"\\nMost important variable: {most_important_var}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296256, "o", "print(f\"Coefficient: {most_important_coef}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.29633, "o", "print(f\"Contribution: {contribution_pct:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296379, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.296404, "o", "> # Save dominant factor result\r\n\u001b[?2004l\r"]
[18.296451, "o", "\u001b[?2004h> "]
[18.296507, "o", "dominant_factor = pd.DataFrame({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296562, "o", "    'variable': [most_important_var],\r\n\u001b[?2004l\r"]
[18.296607, "o", "\u001b[?2004h> "]
[18.296652, "o", "    'contribution': [f\"{contribution_pct:.2f}%\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296697, "o", "})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296817, "o", "dominant_factor.to_csv('/root/output/dominant_factor.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296918, "o", "print(\"\\nDominant factor saved to /root/output/dominant_factor.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.296964, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.297022, "o", "print(\"\\n=== Analysis Complete ===\")\r\n\u001b[?2004l\r"]
[18.297067, "o", "\u001b[?2004h> EOF\r\n"]
[18.297112, "o", "\u001b[?2004l\r"]
[18.313594, "o", "\u001b[?2004hroot@6ac128602499:~# "]
[18.47916, "i", "python3 /root/analysis.py\n"]
