[?2004hroot@335d0ed8294e:~# python3 << 'EOF'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from copy import copy
[?2004l[?2004h> 
[?2004l[?2004h> # Load the workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('nasa_budget_incomplete.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 1: Budget by Directorate
[?2004l[?2004h> ws1 = wb['Budget by Directorate']
[?2004l[?2004h> 
[?2004l[?2004h> # K5 (2016 Total) = sum of B5:J5
[?2004l[?2004h> k5_value = sum([ws1[f'{col}5'].value for col in 'BCDEFGHIJ'])
[?2004l[?2004h> ws1['K5'].value = k5_value
[?2004l[?2004h> print(f"K5 (2016 Total): {k5_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # K10 (2021 Total) = sum of B10:J10
[?2004l[?2004h> k10_value = sum([ws1[f'{col}10'].value for col in 'BCDEFGHIJ'])
[?2004l[?2004h> ws1['K10'].value = k10_value
[?2004l[?2004h> print(f"K10 (2021 Total): {k10_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # F8 (2019 Space Operations) = K8 - sum of other columns in row 8
[?2004l[?2004h> k8_total = ws1['K8'].value
[?2004l[?2004h> f8_value = k8_total - sum([ws1[f'{col}8'].value for col in 'BCDEGHIJ'])
[?2004l[?2004h> ws1['F8'].value = f8_value
[?2004l[?2004h> print(f"F8 (2019 Space Operations): {f8_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # B9 (2020 Science) = K9 - sum of other columns in row 9
[?2004l[?2004h> k9_total = ws1['K9'].value
[?2004l[?2004h> b9_value = k9_total - sum([ws1[f'{col}9'].value for col in 'CDEFGHIJ'])
[?2004l[?2004h> ws1['B9'].value = b9_value
[?2004l[?2004h> print(f"B9 (2020 Science): {b9_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # E10 (2021 Exploration) = K10 - sum of other columns in row 10
[?2004l[?2004h> e10_value = k10_value - sum([ws1[f'{col}10'].value for col in 'BCDFGHIJ'])
[?2004l[?2004h> ws1['E10'].value = e10_value
[?2004l[?2004h> print(f"E10 (2021 Exploration): {e10_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # C12 (2023 Aeronautics) = K12 - sum of other columns in row 12
[?2004l[?2004h> k12_total = ws1['K12'].value
[?2004l[?2004h> c12_value = k12_total - sum([ws1[f'{col}12'].value for col in 'BDEFGHIJ'])
[?2004l[?2004h> ws1['C12'].value = c12_value
[?2004l[?2004h> print(f"C12 (2023 Aeronautics): {c12_value}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSheet 1 (Budget by Directorate) - COMPLETE")
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 2: YoY Changes (%)
[?2004l[?2004h> ws2 = wb['YoY Changes (%)']
[?2004l[?2004h> 
[?2004l[?2004h> # D7 (2019 Space Technology % change) = (D8 - D7_prev) / D7_prev * 100
[?2004l[?2004h> # where D7_prev is D6 (2018 value from Budget sheet)
[?2004l[?2004h> d6_2018 = ws1['D6'].value  # 686
[?2004l[?2004h> d7_2019 = ws1['D7'].value  # 760
[?2004l[?2004h> d7_yoy = ((d7_2019 - d6_2018) / d6_2018) * 100
[?2004l[?2004h> ws2['D7'].value = round(d7_yoy, 2)
[?2004l[?2004h> print(f"D7 (2019 Space Tech YoY %): {round(d7_yoy, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> # B9 (2021 Science % change) = (B10 - B9) / B9 * 100
[?2004l[?2004h> # where B9 is 2020 Science from Budget sheet
[?2004l[?2004h> b9_2020 = ws1['B9'].value  # Just calculated
[?2004l[?2004h> b10_2021 = ws1['B10'].value  # 7301
[?2004l[?2004h> b9_yoy = ((b10_2021 - b9_2020) / b9_2020) * 100
[?2004l[?2004h> ws2['B9'].value = round(b9_yoy, 2)
[?2004l[?2004h> print(f"B9 (2021 Science YoY %): {round(b9_yoy, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> # F9 (2021 Space Operations % change) = (F10 - F9) / F9 * 100
[?2004l[?2004h> # where F9 is 2020 Space Operations from Budget sheet
[?2004l[?2004h> f9_2020 = ws1['F9'].value  # 3989
[?2004l[?2004h> f10_2021 = ws1['F10'].value  # 3986
[?2004l[?2004h> f9_yoy = ((f10_2021 - f9_2020) / f9_2020) * 100
[?2004l[?2004h> ws2['F9'].value = round(f9_yoy, 2)
[?2004l[?2004h> print(f"F9 (2021 Space Ops YoY %): {round(f9_yoy, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSheet 2 (YoY Changes) - COMPLETE")
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 3: Directorate Shares (%)
[?2004l[?2004h> ws3 = wb['Directorate Shares (%)']
[?2004l[?2004h> 
[?2004l[?2004h> # F5 (2016 Space Operations share) = (F5_budget / K5_budget) * 100
[?2004l[?2004h> f5_budget = ws1['F5'].value  # 5029
[?2004l[?2004h> k5_budget = ws1['K5'].value  # Just calculated
[?2004l[?2004h> f5_share = (f5_budget / k5_budget) * 100
[?2004l[?2004h> ws3['F5'].value = round(f5_share, 2)
[?2004l[?2004h> print(f"F5 (2016 Space Ops share %): {round(f5_share, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> # B10 (2021 Science share) = (B10_budget / K10_budget) * 100
[?2004l[?2004h> b10_budget = ws1['B10'].value  # 7301
[?2004l[?2004h> k10_budget = ws1['K10'].value  # Just calculated
[?2004l[?2004h> b10_share = (b10_budget / k10_budget) * 100
[?2004l[?2004h> ws3['B10'].value = round(b10_share, 2)
[?2004l[?2004h> print(f"B10 (2021 Science share %): {round(b10_share, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSheet 3 (Directorate Shares) - COMPLETE")
[?2004l[?2004h> 
[?2004l[?2004h> # Sheet 4: Growth Analysis
[?2004l[?2004h> ws4 = wb['Growth Analysis']
[?2004l[?2004h> 
[?2004l[?2004h> # E5 (FY2019 Exploration Budget) - from Budget sheet
[?2004l[?2004h> e5_value = ws1['E8'].value  # 5047 (2019 Exploration)
[?2004l[?2004h> ws4['E5'].value = e5_value
[?2004l[?2004h> print(f"E5 (FY2019 Exploration): {e5_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # E4 (Exploration CAGR) = ((FY2024 / FY2019) ^ (1/5) - 1) * 100
[?2004l[?2004h> e6_value = ws1['E13'].value  # 7618 (2024 Exploration)
[?2004l[?2004h> cagr_e = (((e6_value / e5_value) ** (1/5)) - 1) * 100
[?2004l[?2004h> ws4['E4'].value = round(cagr_e, 2)
[?2004l[?2004h> print(f"E4 (Exploration CAGR %): {round(cagr_e, 2)}")
[?2004l[?2004h> 
[?2004l[?2004h> # B7 (Science 5-Year Change) = FY2024 - FY2019
[?2004l[?2004h> b6_value = ws1['B13'].value  # 8440 (2024 Science)
[?2004l[?2004h> b5_value = ws1['B8'].value  # 6906 (2019 Science)
[?2004l[?2004h> b7_value = b6_value - b5_value
[?2004l[?2004h> ws4['B7'].value = b7_value
[?2004l[?2004h> print(f"B7 (Science 5-Year Change): {b7_value}")
[?2004l[?2004h> 
[?2004l[?2004h> # B8 (Science Avg Annual Budget) = average of B5:B10 from Budget sheet (2019-2024)
[?2004l[?2004h> science_values = [ws1[f'B{row}'].value for row in range(8, 14)]  # rows 8-13 (2019-2024)
[?2004l[?2004h> b8_value = sum(science_values) / len(science_values)
[?2004l[?2004h> ws4['B8'].value = round(b8_value, 1)
[?2004l[?2004h> print(f"B8 (Science Avg Annual Budget): {round(b8_value, 1)}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nSheet 4 (Growth Analysis) - COMPLETE")
[?2004l[?2004h> 
[?2004l[?2004h> # Save the workbook
[?2004l[?2004h> wb.save('nasa_budget_recovered.xlsx')
