[130.436823, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_recovered.xlsx')\n\nws_budget = wb['Budget by Directorate']\nws_yoy = wb['YoY Changes (%)']\nws_shares = wb['Directorate Shares (%)']\nws_growth = wb['Growth Analysis']\n\nprint(\"=\"*60)\nprint(\"FINAL VERIFICATION - ALL RECOVERED VALUES\")\nprint(\"=\"*60)\n\nprint(\"\\n1. BUDGET BY DIRECTORATE SHEET\")\nprint(\"-\" * 60)\nrecovered_budget = {\n    'K5 (2016 Total)': ws_budget['K5'].value,\n    'F8 (2019 Space Operations)': ws_budget['F8'].value,\n    'B9 (2020 Science)': ws_budget['B9'].value,\n    'E10 (2021 Exploration)': ws_budget['E10'].value,\n    'K10 (2021 Total)': ws_budget['K10'].value,\n    'C12 (2023 Aeronautics)': ws_budget['C12'].value,\n}\n\nfor key, val in recovered_budget.items():\n    print(f\"  {key}: ${val}M\")\n\n# Verify all row sums\nprint(\"\\n  Row sum verifications:\")\nfor row in [5, 10]:\n    col_sum = sum([ws_budget[f'{col}{row}'].value for col in 'BCDEFGHIJ'])\n    total = ws_budget[f'K{row}'].value\n    match = \"✓\" if col_sum == total else \"✗\"\n    print(f\"    Row {row}: sum={col_sum}, total={total} {match}\")\n\nprint(\"\\n2. YoY CHANGES (%) SHEET\")\nprint(\"-\" * 60)\nrecovered_yoy = {\n    'D7 (2019 Space Technology)': ws_yoy['D7'].value,\n    'B9 (2021 Science)': ws_yoy['B9'].value,\n    'F9 (2021 Space Operations)': ws_yoy['F9'].value,\n}\n\nfor key, val in recovered_yoy.items():\n    print(f\"  {key}: {val}%\")\n\nprint(\"\\n3. DIRECTORATE SHARES (%) SHEET\")\nprint(\"-\" * 60)\nrecovered_shares = {\n    'F5 (2016 Space Operations)': ws_shares['F5'].value,\n    'B10 (2021 Science)': ws_shares['B10'].value,\n}\n\nfor key, val in recovered_shares.items():\n    print(f\"  {key}: {val}%\")\n\nprint(\"\\n4. GROWTH ANALYSIS SHEET\")\nprint(\"-\" * 60)\nrecovered_growth = {\n    'E5 (FY2019 Exploration Budget)': ws_growth['E5'].value,\n    'E4 (Exploration CAGR %)': ws_growth['E4'].value,\n    'B7 (Science 5-Year Change)': ws_growth['B7'].value,\n    'B8 (Science Avg Annual Budget)': ws_growth['B8'].value,\n}\n\nfor key, val in recovered_growth.items():\n    print(f\"  {key}: {val}\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"SUMMARY\")\nprint(\"=\"*60)\nprint(f\"Total recovered values: 15\")\nprint(f\"  - Budget by Directorate: 6 values\")\nprint(f\"  - YoY Changes: 3 values\")\nprint(f\"  - Directorate Shares: 2 values\")\nprint(f\"  - Growth Analysis: 4 values\")\nprint(f\"\\nFile: nasa_budget_recovered.xlsx\")\nprint(f\"Status: READY FOR DELIVERY\")\nprint(\"=\"*60)\n\nEOF\n"]
