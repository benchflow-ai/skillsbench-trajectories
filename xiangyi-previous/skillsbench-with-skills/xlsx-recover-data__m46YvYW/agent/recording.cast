[44.117473, "o", "# E4 (Exploration CAGR) = ((FY2024 / FY2019) ^ (1/5) - 1) * 100\r\n\u001b[?2004l\r"]
[44.117514, "o", "\u001b[?2004h> "]
[44.117643, "o", "e6_value = ws1['E13'].value  # 7618 (2024 Exploration)\r\n\u001b[?2004l\r"]
[44.117674, "o", "\u001b[?2004h> "]
[44.117819, "o", "cagr_e = (((e6_value / e5_value) ** (1/5)) - 1) * 100\r\n\u001b[?2004l\r"]
[44.117848, "o", "\u001b[?2004h> "]
[44.117952, "o", "ws4['E4'].value = round(cagr_e, 2)\r\n\u001b[?2004l\r"]
[44.117983, "o", "\u001b[?2004h> "]
[44.118131, "o", "print(f\"E4 (Exploration CAGR %): {round(cagr_e, 2)}\")\r\n\u001b[?2004l\r"]
[44.118162, "o", "\u001b[?2004h> "]
[44.118197, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.118226, "o", "> "]
[44.118333, "o", "# B7 (Science 5-Year Change) = FY2024 - FY2019\r\n\u001b[?2004l\r"]
[44.118361, "o", "\u001b[?2004h> "]
[44.118487, "o", "b6_value = ws1['B13'].value  # 8440 (2024 Science)\r\n\u001b[?2004l\r"]
[44.118517, "o", "\u001b[?2004h> "]
[44.11864, "o", "b5_value = ws1['B8'].value  # 6906 (2019 Science)\r\n\u001b[?2004l\r"]
[44.118668, "o", "\u001b[?2004h> "]
[44.118766, "o", "b7_value = b6_value - b5_value\r\n\u001b[?2004l\r"]
[44.118796, "o", "\u001b[?2004h> "]
[44.118866, "o", "ws4['B7'].value = b7_value\r\n\u001b[?2004l\r"]
[44.118895, "o", "\u001b[?2004h> "]
[44.119016, "o", "print(f\"B7 (Science 5-Year Change): {b7_value}\")\r\n\u001b[?2004l\r"]
[44.119064, "o", "\u001b[?2004h> "]
[44.119099, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.119129, "o", "> "]
[44.119318, "o", "# B8 (Science Avg Annual Budget) = average of B5:B10 from Budget sheet (2019-2024)\r\n\u001b[?2004l\r"]
[44.119347, "o", "\u001b[?2004h> "]
[44.120322, "o", "science_values = [ws1[f'B{row}'].value for row in range(8, 14)]  # rows 8-13 (2019-2024)\r\n\u001b[?2004l\r"]
[44.120363, "o", "\u001b[?2004h> b8_value = sum(science_values) / len(science_values)\r\n\u001b[?2004l\r\u001b[?2004h> ws4['B8'].value = round(b8_value, 1)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"B8 (Science Avg Annual Budget): {round(b8_value, 1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSheet 4 (Growth Analysis) - COMPLETE\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save the workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('nasa_budget_recovered.xlsx')\r\n\u001b[?2004l\r"]
[44.120394, "o", "\u001b[?2004h> "]
[44.122349, "o", "print(\"\\n=== File saved as nasa_budget_recovered.xlsx ===\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[44.31306, "o", "K5 (2016 Total): 19285\r\nK10 (2021 Total): 16730\r\n"]
[44.31322, "o", "F8 (2019 Space Operations): 4639\r\nB9 (2020 Science): 7139\r\nE10 (2021 Exploration): 0\r\nC12 (2023 Aeronautics): 936\r\n\r\nSheet 1 (Budget by Directorate) - COMPLETE"]
[44.313415, "o", "\r\nD7 (2019 Space Tech YoY %): 10.79\r\nB9 (2021 Science YoY %): 2.27\r\nF9 (2021 Space Ops YoY %): -0.08\r\n\r\nSheet 2 (YoY Changes) - COMPLETE\r\nF5 (2016 Space Ops share %): 26.08\r\nB10 (2021 Science share %): 43.64\r\n\r\nSheet 3 (Directorate Shares) - COMPLETE\r\nE5 (FY2019 Exploration): 5047\r\n"]
[44.313484, "o", "E4 (Exploration CAGR %): 8.58\r\nB7 (Science 5-Year Change): 1534\r\nB8 (Science Avg Annual Budget): 7610.3\r\n\r\nSheet 4 (Growth Analysis) - COMPLETE"]
