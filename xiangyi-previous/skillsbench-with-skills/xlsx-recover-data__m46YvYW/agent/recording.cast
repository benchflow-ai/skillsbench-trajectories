[110.456122, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_recovered.xlsx')\n\nws_budget = wb['Budget by Directorate']\nws_yoy = wb['YoY Changes (%)']\nws_shares = wb['Directorate Shares (%)']\nws_growth = wb['Growth Analysis']\n\nprint(\"=== COMPREHENSIVE VERIFICATION ===\")\nprint(\"\\n1. BUDGET BY DIRECTORATE - All recovered values:\")\nprint(\"   K5 (2016 Total): \", ws_budget['K5'].value)\nprint(\"   F8 (2019 Space Ops): \", ws_budget['F8'].value)\nprint(\"   B9 (2020 Science): \", ws_budget['B9'].value)\nprint(\"   E10 (2021 Exploration): \", ws_budget['E10'].value)\nprint(\"   K10 (2021 Total): \", ws_budget['K10'].value)\nprint(\"   C12 (2023 Aeronautics): \", ws_budget['C12'].value)\n\n# Verify K5 sum\nk5_sum = sum([ws_budget[f'{col}5'].value for col in 'BCDEFGHIJ'])\nprint(f\"\\n   K5 verification: sum={k5_sum}, stored={ws_budget['K5'].value}, match={k5_sum == ws_budget['K5'].value}\")\n\n# Verify K10 sum\nk10_sum = sum([ws_budget[f'{col}10'].value for col in 'BCDEFGHIJ'])\nprint(f\"   K10 verification: sum={k10_sum}, stored={ws_budget['K10'].value}, match={k10_sum == ws_budget['K10'].value}\")\n\nprint(\"\\n2. YoY CHANGES (%) - All recovered values:\")\nprint(\"   D7 (2019 Space Tech %): \", ws_yoy['D7'].value)\nprint(\"   B9 (2021 Science %): \", ws_yoy['B9'].value)\nprint(\"   F9 (2021 Space Ops %): \", ws_yoy['F9'].value)\n\n# Verify YoY calculations\nd7_calc = ((ws_budget['D7'].value - ws_budget['D6'].value) / ws_budget['D6'].value) * 100\nprint(f\"\\n   D7 verification: calculated={round(d7_calc, 2)}, stored={ws_yoy['D7'].value}\")\n\nb9_calc = ((ws_budget['B10'].value - ws_budget['B9'].value) / ws_budget['B9'].value) * 100\nprint(f\"   B9 verification: calculated={round(b9_calc, 2)}, stored={ws_yoy['B9'].value}\")\n\nf9_calc = ((ws_budget['F10'].value - ws_budget['F9'].value) / ws_budget['F9'].value) * 100\nprint(f\"   F9 verification: calculated={round(f9_calc, 2)}, stored={ws_yoy['F9'].value}\")\n\nprint(\"\\n3. DIRECTORATE SHARES (%) - All recovered values:\")\nprint(\"   F5 (2016 Space Ops %): \", ws_shares['F5'].value)\nprint(\"   B10 (2021 Science %): \", ws_shares['B10'].value)\n\n# Verify share calculations\nf5_calc = (ws_budget['F5'].value / ws_budget['K5'].value) * 100\nprint(f\"\\n   F5 verification: calculated={round(f5_calc, 2)}, stored={ws_shares['F5'].value}\")\n\nb10_calc = (ws_budget['B10'].value / ws_budget['K10'].value) * 100\nprint(f\"   B10 verification: calculated={round(b10_calc, 2)}, stored={ws_shares['B10'].value}\")\n\nprint(\"\\n4. GROWTH ANALYSIS - All recovered values:\")\nprint(\"   E5 (FY2019 Exploration): \", ws_growth['E5'].value)\nprint(\"   E4 (Exploration CAGR %): \", ws_growth['E4'].value)\nprint(\"   B7 (Science 5-Yr Change): \", ws_growth['B7'].value)\nprint(\"   B8 (Science Avg Annual): \", ws_growth['B8'].value)\n\n# Verify CAGR\ne5_val = ws_growth['E5'].value\ne6_val = ws_budget['E13'].value\ncagr_calc = (((e6_val / e5_val) ** (1/5)) - 1) * 100\nprint(f\"\\n   E4 verification: calculated={round(cagr_calc, 2)}, stored={ws_growth['E4'].value}\")\n\n# Verify 5-year change\nb7_calc = ws_budget['B13'].value - ws_budget['B8'].value\nprint(f\"   B7 verification: calculated={b7_calc}, stored={ws_growth['B7'].value}\")\n\n# Verify average\nscience_vals = [ws_budget[f'B{row}'].value for row in range(8, 14)]\nb8_calc = sum(science_vals) / len(science_vals)\nprint(f\"   B8 verification: calculated={round(b8_calc, 1)}, stored={ws_growth['B8'].value}\")\n\nprint(\"\\n=== ALL VERIFICATIONS COMPLETE ===\")\nprint(\"\\nSummary of all recovered values:\")\nprint(\"  Budget by Directorate: 6 values recovered\")\nprint(\"  YoY Changes: 3 values recovered\")\nprint(\"  Directorate Shares: 2 values recovered\")\nprint(\"  Growth Analysis: 4 values recovered\")\nprint(\"  TOTAL: 15 missing values successfully recovered\")\n\nEOF\n"]
