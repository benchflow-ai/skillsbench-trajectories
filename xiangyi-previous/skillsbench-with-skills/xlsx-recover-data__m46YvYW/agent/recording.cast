[118.604069, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_recovered.xlsx')\n\nws_budget = wb['Budget by Directorate']\nws_shares = wb['Directorate Shares (%)']\n\nprint(\"=== CORRECTING B10 IN DIRECTORATE SHARES ===\")\n\n# Recalculate B10 share with correct K10 value\nb10_budget = ws_budget['B10'].value  # 7301\nk10_budget = ws_budget['K10'].value  # 21439\nb10_share_correct = (b10_budget / k10_budget) * 100\n\nprint(f\"B10 Budget: ${b10_budget}M\")\nprint(f\"K10 Total: ${k10_budget}M\")\nprint(f\"B10 Share (corrected): {round(b10_share_correct, 2)}%\")\nprint(f\"B10 Share (old): {ws_shares['B10'].value}%\")\n\nws_shares['B10'].value = round(b10_share_correct, 2)\n\nprint(f\"B10 Share (updated): {ws_shares['B10'].value}%\")\n\nwb.save('nasa_budget_recovered.xlsx')\nprint(\"\\n=== File saved with B10 correction ===\")\n\nEOF\n"]
