[64.067613, "i", "python3 << 'EOF'\nimport openpyxl\n\nwb = openpyxl.load_workbook('nasa_budget_recovered.xlsx')\n\nws_budget = wb['Budget by Directorate']\nws_shares = wb['Directorate Shares (%)']\n\nprint(\"=== Checking Directorate Shares for 2021 (Row 10) ===\")\nprint(\"\\nShares (% of Total):\")\nfor col in 'BCDEFGHIJ':\n    cell_ref = f'{col}10'\n    share_val = ws_shares[cell_ref].value\n    budget_val = ws_budget[cell_ref].value\n    print(f\"  {col}10: Share={share_val}%, Budget=${budget_val}M\")\n\nk10_budget = ws_budget['K10'].value\nprint(f\"\\nK10 (Total): ${k10_budget}M\")\n\n# Calculate what E10 should be based on share\ne10_share = ws_shares['E10'].value\nif e10_share:\n    e10_calculated = (e10_share / 100) * k10_budget\n    print(f\"\\nE10 Share: {e10_share}%\")\n    print(f\"E10 Calculated from share: ${e10_calculated}M\")\n    print(f\"E10 Current value: ${ws_budget['E10'].value}M\")\n    \n    if e10_calculated != ws_budget['E10'].value:\n        print(f\"\\nCORRECTION NEEDED: E10 should be {e10_calculated}\")\n\nEOF\n"]
