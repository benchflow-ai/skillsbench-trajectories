, ws_yoy['B9'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"   F9 (2021 Space Ops %): \", ws_yoy['F9'].value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify YoY calculations\r\n\u001b[?2004l\r\u001b[?2004h> d7_calc = ((ws_budget['D7'].value - ws_budget['D6'].value) / ws_budget['D6'].value) * 100\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\n   D7 verification: calculated={round(d7_calc, 2)}, stored={ws_yoy['D7'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> b9_calc = ((ws_budget['B10'].value - ws_budget['B9'].value) / ws_budget['B9'].value) * 100\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"   B9 verification: calculated={round(b9_calc, 2)}, stored={ws_yoy['B9'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> f9_calc = ((ws_budget['F10'].value - ws_budget['F9'].value) / ws_budget['F9'].value) * 100\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"   F9 verification: calculated={round(f9_calc, 2)}, stored={ws_yoy['F9'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n3. DIRECTORATE SHARES (%) - All recovered values:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"   F5 (2016 Space Ops %): \", ws_shares['F5'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"   B10 (2021 Science %): \", ws_shares['B10'].value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify share calculations\r\n\u001b[?2004l\r\u001b[?2004h> f5_calc = (ws_budget['F5'].value / ws_budget['K5'].value) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
