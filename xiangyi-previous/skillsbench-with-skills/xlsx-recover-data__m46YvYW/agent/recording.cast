[110.467634, "o", "print(\"   E4 (Exploration CAGR %): \", ws_growth['E4'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"   B7 (Science 5-Yr Change): \", ws_growth['B7'].value)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"   B8 (Science Avg Annual): \", ws_growth['B8'].value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify CAGR\r\n\u001b[?2004l\r\u001b[?2004h> e5_val = ws_growth['E5'].value\r\n\u001b[?2004l\r\u001b[?2004h> e6_val = ws_budget['E13'].value\r\n\u001b[?2004l\r\u001b[?2004h> cagr_calc = (((e6_val / e5_val) ** (1/5)) - 1) * 100\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\n   E4 verification: calculated={round(cagr_calc, 2)}, stored={ws_growth['E4'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify 5-year change\r\n\u001b[?2004l\r\u001b[?2004h> b7_calc = ws_budget['B13'].value - ws_budget['B8'].value\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"   B7 verification: calculated={b7_calc}, stored={ws_growth['B7'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify average\r\n\u001b[?2004l\r\u001b[?2004h> science_vals = [ws_budget[f'B{row}'].value for row in range(8, 14)]\r\n\u001b[?2004l\r\u001b[?2004h> b8_calc = sum(science_vals) / len(science_vals)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"   B8 verification: calculated={round(b8_calc, 1)}, stored={ws_growth['B8'].value}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== ALL VERIFICATIONS COMPLETE ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
