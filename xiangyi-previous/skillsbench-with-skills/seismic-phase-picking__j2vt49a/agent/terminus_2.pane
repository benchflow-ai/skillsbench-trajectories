[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> def recursive_sta_lta(sig, nsta, nlta):
[?2004l[?2004h>     sta = np.zeros(len(sig))
[?2004l[?2004h>     lta = np.zeros(len(sig))
[?2004l[?2004h>     # Simple STA/LTA implementation
[?2004l[?2004h>     sq_sig = sig**2
[?2004l[?2004h>     for i in range(len(sig)):
[?2004l[?2004h>         if i < nlta:
[?2004l[?2004h>             sta[i] = np.mean(sq_sig[max(0, i-nsta):i+1])
[?2004l[?2004h>             lta[i] = np.mean(sq_sig[0:i+1])
[?2004l[?2004h>         else:
[?2004l[?2004h>             sta[i] = np.mean(sq_sig[i-nsta:i+1])
[?2004l[?2004h>             lta[i] = np.mean(sq_sig[i-nlta:i+1])
[?2004l[?2004h>     return sta / (lta + 1e-10)
[?2004l[?2004h> 
[?2004l[?2004h> def fast_sta_lta(sig, nsta, nlta):
[?2004l[?2004h>     sq_sig = sig**2
[?2004l[?2004h>     sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')
[?2004l[?2004h>     lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')
[?2004l[?2004h>     return sta / (lta + 1e-10)
[?2004l[?2004h> 
[?2004l[?2004h> def pick_phases():
[?2004l[?2004h>     data_dir = '/root/data/'
[?2004l[?2004h>     files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])
[?2004l[?2004h>     results = []
[?2004l[?2004h>     
[?2004l[?2004h>     for f in files:
[?2004l[?2004h>         path = os.path.join(data_dir, f)
[?2004l[?2004h>         d = np.load(path)
[?2004l[?2004h>         data = d['data'] # (12000, 3)
[?2004l[?2004h>         dt = d['dt']
[?2004l[?2004h>         
[?2004l[?2004h>         # Channels: DPE, DPN, DPZ (usually)
[?2004l[?2004h>         # P-wave: use Vertical channel (index 2)
[?2004l[?2004h>         # S-wave: use Horizontal channels (index 0, 1)
[?2004l[?2004h>         
[?2004l[?2004h>         # Preprocessing: detrend and bandpass (simple highpass here)
[?2004l[?2004h>         # But let's try STA/LTA on raw first, or just mean-removed
[?2004l[?2004h>         data = data - np.mean(data, axis=0)
[?2004l[?2004h>         
[?2004l[?2004h>         # P-picking on DPZ
[?2004l[?2004h>         p_sig = data[:, 2]
[?2004l[?2004h>         p_char = fast_sta_lta(p_sig, int(0.1/dt), int(2.0/dt))
[?2004l[?2004h>         p_picks = np.where(p_char > 3.0)[0]
[?2004l[?2004h>         if len(p_picks) > 0:
[?2004l[?2004h>             # Take the first pick that satisfies the threshold
[?2004l[?2004h>             # Or better, the first local maximum above threshold
[?2004l[?2004h>             results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_picks[0]})
[?2004l[?2004h>             
[?2004l[?2004h>         # S-picking on Horizontals
[?2004l[?2004h>         s_sig = np.sqrt(data[:, 0]**2 + data[:, 1]**2)
[?2004l[?2004h>         s_char = fast_sta_lta(s_sig, int(0.2/dt), int(4.0/dt))
[?2004l[?2004h>         # Avoid picking S before P or too close to P
[?2004l[?2004h>         p_idx = p_picks[0] if len(p_picks) > 0 else 0
[?2004l[?2004h>         s_char[:p_idx + int(0.2/dt)] = 0
[?2004l[?2004h>         s_picks = np.where(s_char > 2.5)[0]
[?2004l[?2004h>         if len(s_picks) > 0:
[?2004l[?2004h>             results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_picks[0]})
[?2004l[?2004h>             
[?2004l[?2004h>     df = pd.DataFrame(results)
[?2004l[?2004h>     df.to_csv('/root/results.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     pick_phases()
