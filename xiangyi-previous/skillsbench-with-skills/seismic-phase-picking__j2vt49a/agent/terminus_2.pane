[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import signal
[?2004l[?2004h> 
[?2004l[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=4):
[?2004l[?2004h>     nyquist = 0.5 * fs
[?2004l[?2004h>     low = lowcut / nyquist
[?2004l[?2004h>     high = highcut / nyquist
[?2004l[?2004h>     b, a = signal.butter(order, [low, high], btype='band')
[?2004l[?2004h>     y = signal.filtfilt(b, a, data, axis=0)
[?2004l[?2004h>     return y
[?2004l[?2004h> 
[?2004l[?2004h> def classic_sta_lta(sig, nsta, nlta):
[?2004l[?2004h>     sta = np.zeros(len(sig))
[?2004l[?2004h>     lta = np.zeros(len(sig))
[?2004l[?2004h>     sq_sig = sig**2
[?2004l[?2004h>     # Use cumulative sum for fast calculation
[?2004l[?2004h>     cumsum = np.cumsum(np.insert(sq_sig, 0, 0))
[?2004l[?2004h>     
[?2004l[?2004h>     # STA
[?2004l[?2004h>     sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta
[?2004l[?2004h>     # LTA
[?2004l[?2004h>     lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta
[?2004l[?2004h>     
[?2004l[?2004h>     # Pad to match original length
[?2004l[?2004h>     sta = np.pad(sta, (nsta-1, 0), 'constant', constant_values=1e-10)
