[?2004l[?2004h> def classic_sta_lta(sig, nsta, nlta):
[?2004l[?2004h>     sq_sig = sig**2
[?2004l[?2004h>     sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')
[?2004l[?2004h>     lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')
[?2004l[?2004h>     return sta / (lta + 1e-30)
[?2004l[?2004h> 
[?2004l[?2004h> def aic_pick(sig):
[?2004l[?2004h>     n = len(sig)
[?2004l[?2004h>     if n < 2: return 0
[?2004l[?2004h>     aic = np.zeros(n)
[?2004l[?2004h>     for k in range(1, n - 1):
[?2004l[?2004h>         var1 = np.var(sig[0:k])
[?2004l[?2004h>         var2 = np.var(sig[k:n])
[?2004l[?2004h>         if var1 <= 0: var1 = 1e-30
[?2004l[?2004h>         if var2 <= 0: var2 = 1e-30
[?2004l[?2004h>         aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)
[?2004l[?2004h>     aic[0] = aic[1]
[?2004l[?2004h>     aic[-1] = aic[-2]
[?2004l[?2004h>     return np.argmin(aic)
