[161.752698, "o", "            if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 p_idx = p_picks[0]\r\n\u001b[?2004l\r\u001b[?2004h>                 results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # S-picking on Horizontals\r\n\u001b[?2004l\r\u001b[?2004h>             s_sig = np.sqrt(data[:, 0]**2 + data[:, 1]**2)\r\n\u001b[?2004l\r\u001b[?2004h>             s_char = classic_sta_lta(s_sig, int(0.2*fs), int(4.0*fs))\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>             # Search for S after P\r\n\u001b[?2004l\r\u001b[?2004h>             search_start = p_idx + int(0.5*fs) if p_idx is not None else int(1.0*fs)\r\n\u001b[?2004l\r\u001b[?2004h>             if search_start < len(s_char):\r\n\u001b[?2004l\r\u001b[?2004h>                 s_picks = np.where(s_char[search_start:] > 2.0)[0]\r\n\u001b[?2004l\r\u001b[?2004h>                 if len(s_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                     s_idx = s_picks[0] + search_start\r\n\u001b[?2004l\r\u001b[?2004h>                     results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.752943, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.752985, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.753045, "o", "    df.to_csv('/root/results.csv', index=False)\r\n"]
