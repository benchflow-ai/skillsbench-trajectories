[360.06576, "o", "\r\n"]
[360.065863, "o", "\u001b[?2004l\r"]
[360.065967, "o", "\u001b[?2004h"]
[360.066132, "o", "> \r\n"]
[360.066212, "o", "\u001b[?2004l\r\u001b[?2004h> def aic_pick(sig):"]
[360.066316, "o", "\r\n"]
[360.066449, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.066525, "o", ">     n = len(sig)"]
[360.066698, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.066781, "o", ">     if n < 2: return 0"]
[360.066889, "o", "\r\n"]
[360.067044, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.067126, "o", ">     aic = np.zeros(n)"]
[360.067228, "o", "\r\n"]
[360.067392, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.067468, "o", ">     for k in range(1, n - 1):"]
[360.067548, "o", "\r\n"]
[360.067732, "o", "\u001b[?2004l\r"]
[360.067814, "o", "\u001b[?2004h>         var1 = np.var(sig[0:k])"]
[360.067892, "o", "\r\n"]
[360.068001, "o", "\u001b[?2004l\r"]
[360.068171, "o", "\u001b[?2004h"]
[360.068252, "o", ">         var2 = np.var(sig[k:n])"]
[360.068375, "o", "\r\n"]
[360.068562, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.072488, "o", ">         if var1 <= 0: var1 = 1e-30"]
[360.072667, "o", "\r\n"]
[360.07278, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.072965, "o", "> "]
