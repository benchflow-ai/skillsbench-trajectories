[423.581468, "o", "\u001b[?2004h> "]
[423.581556, "o", "        var2 = np.var(sig[k:n])\r\n\u001b[?2004l\r"]
[423.581621, "o", "\u001b[?2004h> "]
[423.581777, "o", "        if var1 <= 0: var1 = 1e-30\r\n\u001b[?2004l\r"]
[423.581816, "o", "\u001b[?2004h"]
[423.581903, "o", "> "]
[423.58203, "o", "        if var2 <= 0: var2 = 1e-30\r\n\u001b[?2004l\r"]
[423.582063, "o", "\u001b[?2004h"]
[423.582151, "o", "> "]
[423.582342, "o", "        aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)\r\n\u001b[?2004l\r"]
[423.582419, "o", "\u001b[?2004h> "]
[423.582504, "o", "    aic[:2] = aic[2]\r\n\u001b[?2004l\r"]
[423.582588, "o", "\u001b[?2004h> "]
[423.582681, "o", "    aic[-2:] = aic[-3]\r\n\u001b[?2004l\r"]
[423.582752, "o", "\u001b[?2004h> "]
[423.582786, "o", "    return np.argmin(aic)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.582825, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.582865, "o", "> "]
[423.582962, "o", "def pick_phases():\r\n\u001b[?2004l\r"]
[423.583128, "o", "\u001b[?2004h>     data_dir = '/root/data/'"]
[423.583169, "o", "\r\n\u001b[?2004l\r"]
[423.583262, "o", "\u001b[?2004h> "]
[423.583492, "o", "    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\r\n\u001b[?2004l\r"]
[423.583525, "o", "\u001b[?2004h"]
[423.583729, "o", ">     results = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[423.58392, "o", "\u001b[?2004h> "]
[423.584044, "o", "    for f in files:\r\n\u001b[?2004l\r"]
[423.584078, "o", "\u001b[?2004h"]
[423.584164, "o", "> "]
[423.584197, "o", "        try:\r\n\u001b[?2004l\r"]
[423.584282, "o", "\u001b[?2004h> "]
[423.584469, "o", "            d = np.load(os.path.join(data_dir, f))\r\n\u001b[?2004l\r"]
[423.584504, "o", "\u001b[?2004h"]
[423.584589, "o", "> "]
[423.584695, "o", "            data = d['data']\r\n\u001b[?2004l\r"]
[423.584728, "o", "\u001b[?2004h"]
[423.584817, "o", "> "]
[423.584916, "o", "            dt = d['dt']\r\n\u001b[?2004l\r"]
[423.584952, "o", "\u001b[?2004h"]
[423.585034, "o", "> "]
[423.585136, "o", "            fs = 1.0 / dt\r\n\u001b[?2004l\r"]
[423.585169, "o", "\u001b[?2004h"]
[423.585256, "o", "> "]
[423.585424, "o", "            \r\n\u001b[?2004l\r"]
[423.585557, "o", "\u001b[?2004h> "]
[423.585668, "o", "            # More aggressive filtering for noisy data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.585703, "o", "            data_filt = bandpass_filter(data, 2.0, 15.0, fs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.585795, "o", "            \r\n\u001b[?2004l\r"]
[423.585827, "o", "\u001b[?2004h> "]
[423.585993, "o", "            # P-pick: try Vertical channel first\r\n\u001b[?2004l\r"]
[423.586022, "o", "\u001b[?2004h"]
[423.586181, "o", "> "]
[423.586281, "o", "            p_sig = data_filt[:, 2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.586363, "o", "            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(3.0*fs))\r\n\u001b[?2004l\r"]
[423.586436, "o", "\u001b[?2004h> "]
[423.586572, "o", "            # If vertical is weak, try horizontal energy?\r\n\u001b[?2004l\r"]
[423.586619, "o", "\u001b[?2004h"]
[423.586666, "o", "> "]
[423.586788, "o", "            # No, P is usually vertical.\r\n\u001b[?2004l\r"]
[423.586867, "o", "\u001b[?2004h"]
[423.586911, "o", "> "]
[423.587072, "o", "            p_thresh = 1.8\r\n\u001b[?2004l\r"]
[423.587179, "o", "\u001b[?2004h> "]
[423.587211, "o", "            p_picks = np.where(p_char > p_thresh)[0]\r\n\u001b[?2004l\r\u001b[?2004h>             p_idx = None\r\n"]
[423.587311, "o", "\u001b[?2004l\r"]
[423.587345, "o", "\u001b[?2004h> "]
[423.587427, "o", "            if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.58756, "o", "                p_idx_pre = p_picks[0]\r\n\u001b[?2004l\r"]
[423.587605, "o", "\u001b[?2004h"]
[423.587651, "o", "> "]
[423.5878, "o", "                start = max(0, p_idx_pre - int(1.0*fs))\r\n\u001b[?2004l\r"]
[423.58785, "o", "\u001b[?2004h"]
[423.587893, "o", "> "]
[423.588067, "o", "                end = min(len(p_sig), p_idx_pre + int(0.5*fs))\r\n\u001b[?2004l\r"]
[423.588193, "o", "\u001b[?2004h> "]
[423.58828, "o", "                p_idx = start + aic_pick(p_sig[start:end])\r\n\u001b[?2004l\r"]
[423.588441, "o", "\u001b[?2004h> "]
[423.588551, "o", "                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\r\n\u001b[?2004l\r"]
[423.588596, "o", "\u001b[?2004h"]
[423.588681, "o", "> "]
[423.58873, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.588868, "o", "            # S-pick: horizontal energy\r\n\u001b[?2004l\r"]
[423.588917, "o", "\u001b[?2004h> "]
[423.589119, "o", "            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\r\n\u001b[?2004l\r"]
[423.589166, "o", "\u001b[?2004h"]
[423.589251, "o", "> "]
[423.589393, "o", "            s_char = classic_sta_lta(s_sig, int(0.2*fs), int(5.0*fs))\r\n\u001b[?2004l\r"]
[423.589438, "o", "\u001b[?2004h"]
[423.589526, "o", "> "]
[423.589576, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.589719, "o", "            # Search start: after P or from start\r\n\u001b[?2004l\r"]
[423.589847, "o", "\u001b[?2004h> "]
[423.590037, "o", "            search_start = p_idx + int(0.2*fs) if p_idx is not None else int(1.0*fs)\r\n\u001b[?2004l\r"]
[423.590159, "o", "\u001b[?2004h>             s_thresh = 1.6\r\n\u001b[?2004l\r"]
[423.590252, "o", "\u001b[?2004h> "]
[423.590283, "o", "            if search_start < len(s_char):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.590432, "o", "                s_picks = np.where(s_char[search_start:] > s_thresh)[0]\r\n\u001b[?2004l\r"]
[423.590583, "o", "\u001b[?2004h> "]
[423.590679, "o", "                if len(s_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.590748, "o", "                    s_idx_pre = s_picks[0] + search_start\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.59093, "o", "                    start = max(search_start, s_idx_pre - int(1.0*fs))\r\n\u001b[?2004l\r"]
[423.591004, "o", "\u001b[?2004h> "]
[423.591155, "o", "                    end = min(len(s_sig), s_idx_pre + int(1.0*fs))\r\n\u001b[?2004l\r"]
[423.591187, "o", "\u001b[?2004h> "]
[423.591346, "o", "                    s_idx = start + aic_pick(s_sig[start:end])\r\n\u001b[?2004l\r"]
[423.59138, "o", "\u001b[?2004h> "]
[423.5916, "o", "                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\r\n\u001b[?2004l\r"]
[423.591672, "o", "\u001b[?2004h> "]
[423.591734, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.591866, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[423.5919, "o", "\u001b[?2004h> "]
[423.592017, "o", "    df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.592141, "o", "    df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r"]
[423.59221, "o", "\u001b[?2004h> "]
[423.592368, "o", "    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\r\n\u001b[?2004l\r"]
[423.592497, "o", "\u001b[?2004h> \r\n"]
[423.592617, "o", "\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[423.59265, "o", "\u001b[?2004h>     pick_phases()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.592783, "o", "EOF\r\n\u001b[?2004l\r"]
[423.607608, "o", "\u001b[?2004hroot@61b932f24ef7:~# "]
[424.802548, "i", "python3 /root/picker.py\n"]
[424.803394, "o", "python3 /root/picker.py\r\n\u001b[?2004l\r"]
[429.028441, "o", "Done! Wrote 126 picks to /root/results.csv\r\n"]
[429.30337, "o", "\u001b[?2004hroot@61b932f24ef7:~# "]
[434.695598, "i", "grep \",P,\" /root/results.csv | wc -l\n"]
[434.696836, "o", "grep \",P,\" /root/results.csv | wc -l\r\n\u001b[?2004l\r"]
[434.700596, "o", "68\r\n"]
[434.70107, "o", "\u001b[?2004hroot@61b932f24ef7:~# "]
[435.119044, "i", "grep \",S,\" /root/results.csv | wc -l\n"]
[435.120169, "o", "grep \",S,\" /root/results.csv | wc -l\r\n\u001b[?2004l\r"]
[435.121318, "o", "58\r\n"]
[435.121622, "o", "\u001b[?2004hroot@61b932f24ef7:~# "]
[455.214623, "i", "cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta(sig, nsta, nlta):\n    sq_sig = sig**2\n    sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')\n    lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')\n    return sta / (lta + 1e-30)\n\ndef aic_pick(sig):\n    n = len(sig)\n    if n < 10: return 0\n    aic = np.zeros(n)\n    for k in range(2, n - 2):\n        var1 = np.var(sig[0:k])\n        var2 = np.var(sig[k:n])\n        if var1 <= 0: var1 = 1e-30\n        if var2 <= 0: var2 = 1e-30\n        aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)\n    aic[:2] = aic[2]\n    aic[-2:] = aic[-3]\n    return np.argmin(aic)\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        try:\n            d = np.load(os.path.join(data_dir, f))\n            data = d['data']\n            dt = d['dt']\n            fs = 1.0 / dt\n            \n            data_filt = bandpass_filter(data, 1.0, 20.0, fs)\n            \n            # P-pick: try Vertical channel first, then total energy\n            p_sig = data_filt[:, 2]\n            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(3.0*fs))\n            p_picks = np.where(p_char > 1.6)[0]\n            \n            if len(p_picks) == 0:\n                # Try total energy\n                p_sig = np.sqrt(np.sum(data_filt**2, axis=1))\n                p_char = classic_sta_lta(p_sig, int(0.1*fs), int(3.0*fs))\n                p_picks = np.where(p_char > 1.6)[0]\n            \n            p_idx = None\n            if len(p_picks) > 0:\n                p_idx_pre = p_picks[0]\n                start = max(0, p_idx_pre - int(0.5*fs))\n                end = min(len(p_sig), p_idx_pre + int(0.5*fs))\n                p_idx = start + aic_pick(p_sig[start:end])\n                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\n            \n            # S-pick: horizontal energy\n            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\n            s_char = classic_sta_lta(s_sig, int(0.2*fs), int(5.0*fs))\n            \n            search_start = p_idx + int(0.2*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > 1.4)[0]\n                if len(s_picks) > 0:\n                    s_idx_pre = s_picks[0] + search_start\n                    start = max(search_start, s_idx_pre - int(0.5*fs))\n                    end = min(len(s_sig), s_idx_pre + int(0.5*fs))\n                    s_idx = start + aic_pick(s_sig[start:end])\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n            elif len(p_picks) == 0: # Try picking S even if no P\n                s_picks = np.where(s_char[int(1.0*fs):] > 1.4)[0]\n                if len(s_picks) > 0:\n                    s_idx_pre = s_picks[0] + int(1.0*fs)\n                    start = max(0, s_idx_pre - int(0.5*fs))\n                    end = min(len(s_sig), s_idx_pre + int(0.5*fs))\n                    s_idx = start + aic_pick(s_sig[start:end])\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception:\n            pass\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
[455.218278, "o", "cat << 'EOF' > /root/picker.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=4):\r\n\u001b[?2004l\r\u001b[?2004h>     nyquist = 0.5 * fs\r\n\u001b[?2004l\r\u001b[?2004h>     low = lowcut / nyquist\r\n\u001b[?2004l\r\u001b[?2004h>     high = highcut / nyquist\r\n\u001b[?2004l\r\u001b[?2004h>     b, a = signal.butter(order, [low, high], btype='band')\r\n\u001b[?2004l\r\u001b[?2004h>     y = signal.filtfilt(b, a, data, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h>     return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def classic_sta_lta(sig, nsta, nlta):\r\n\u001b[?2004l\r\u001b[?2004h>     sq_sig = sig**2\r\n\u001b[?2004l\r\u001b[?2004h>     sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h>     lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h>     return sta / (lta + 1e-30)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def aic_pick(sig):\r\n\u001b[?2004l\r\u001b[?2004h>     n = len(sig)\r\n\u001b[?2004l\r\u001b[?2004h>     if n < 10: return 0\r\n\u001b[?2004l\r\u001b[?2004h>     aic = np.zeros(n)\r\n\u001b[?2004l\r\u001b[?2004h>     for k in range(2, n - 2):\r\n\u001b[?2004l\r\u001b[?2004h>         var1 = np.var(sig[0:k])\r\n\u001b[?2004l\r\u001b[?2004h>         var2 = np.var(sig[k:n])\r\n\u001b[?2004l\r\u001b[?2004h>         if var1 <= 0: var1 = 1e-30"]
[455.218544, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         if var2 <= 0: var2 = 1e-30"]
[455.218873, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[455.21899, "o", ">         aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)"]
[455.219092, "o", "\r\n"]
