[184.604888, "o", "root@61b932f24ef7:~# "]
[202.950696, "i", "cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta_fast(sig, nsta, nlta):\n    sq_sig = sig**2\n    cumsum = np.cumsum(np.insert(sq_sig, 0, 0))\n    sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta\n    lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta\n    # Pad to match original length and align\n    res = np.zeros(len(sig))\n    res[nlta:] = sta[nlta-nsta:] / (lta[:-1] + 1e-30)\n    return res\n\ndef aic_pick(sig):\n    n = len(sig)\n    aic = np.zeros(n)\n    for k in range(1, n - 1):\n        # AIC = k * log(var(sig[0:k])) + (n-k) * log(var(sig[k:n]))\n        var1 = np.var(sig[0:k])\n        var2 = np.var(sig[k:n])\n        if var1 == 0: var1 = 1e-30\n        if var2 == 0: var2 = 1e-30\n        aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)\n    return np.argmin(aic[1:-1]) + 1\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        try:\n            d = np.load(os.path.join(data_dir, f))\n            data = d['data']\n            dt = d['dt']\n            fs = 1.0 / dt\n            \n            # Filtered data for picking\n            data_filt = bandpass_filter(data, 1.0, 20.0, fs)\n            \n            # P-pick\n            p_sig = data_filt[:, 2]\n            p_char = classic_sta_lta_fast(p_sig, int(0.1*fs), int(2.0*fs))\n            p_picks = np.where(p_char > 3.5)[0]\n            p_idx = None\n            if len(p_picks) > 0:\n                # Refine with AIC\n                search_window = 100 # 1s\n                start = max(0, p_picks[0] - search_window)\n                end = min(len(p_sig), p_picks[0] + search_window)\n                p_idx = start + aic_pick(p_sig[start:end])\n                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\n            \n            # S-pick\n            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\n            s_char = classic_sta_lta_fast(s_sig, int(0.2*fs), int(4.0*fs))\n            # Search after P\n            search_start = p_idx + int(0.2*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > 2.5)[0]\n                if len(s_picks) > 0:\n                    s_idx_pre = s_picks[0] + search_start\n                    # Refine with AIC\n                    search_window = 200 # 2s\n                    start = max(0, s_idx_pre - search_window)\n                    end = min(len(s_sig), s_idx_pre + search_window)\n                    s_idx = start + aic_pick(s_sig[start:end])\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception:\n            pass\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
[202.955394, "o", "cat << 'EOF' > /root/picker.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import signal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=4):\r\n\u001b[?2004l\r\u001b[?2004h>     nyquist = 0.5 * fs\r\n\u001b[?2004l\r\u001b[?2004h>     low = lowcut / nyquist\r\n\u001b[?2004l\r\u001b[?2004h>     high = highcut / nyquist\r\n\u001b[?2004l\r\u001b[?2004h>     b, a = signal.butter(order, [low, high], btype='band')\r\n\u001b[?2004l\r\u001b[?2004h>     y = signal.filtfilt(b, a, data, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h>     return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def classic_sta_lta_fast(sig, nsta, nlta):\r\n\u001b[?2004l\r\u001b[?2004h>     sq_sig = sig**2\r\n\u001b[?2004l\r\u001b[?2004h>     cumsum = np.cumsum(np.insert(sq_sig, 0, 0))\r\n\u001b[?2004l\r\u001b[?2004h>     sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta\r\n\u001b[?2004l\r\u001b[?2004h>     lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta\r\n\u001b[?2004l\r\u001b[?2004h>     # Pad to match original length and align\r\n\u001b[?2004l\r\u001b[?2004h>     res = np.zeros(len(sig))\r\n\u001b[?2004l\r\u001b[?2004h>     res[nlta:] = sta[nlta-nsta:] / (lta[:-1] + 1e-30)\r\n\u001b[?2004l\r\u001b[?2004h>     return res\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def aic_pick(sig):\r\n\u001b[?2004l\r\u001b[?2004h>     n = len(sig)\r\n\u001b[?2004l\r\u001b[?2004h>     aic = np.zeros(n)\r\n\u001b[?2004l\r\u001b[?2004h>     for k in range(1, n - 1):\r\n\u001b[?2004l\r\u001b[?2004h>         # AIC = k * log(var(sig[0:k])) + (n-k) * log(var(sig[k:n]))\r\n\u001b[?2004l\r\u001b[?2004h>         var1 = np.var(sig[0:k])\r\n\u001b[?2004l\r\u001b[?2004h>         var2 = np.var(sig[k:n])\r\n\u001b[?2004l\r\u001b[?2004h>         if var1 == 0: var1 = 1e-30\r\n\u001b[?2004l\r\u001b[?2004h>         if var2 == 0: var2 = 1e-30\r\n\u001b[?2004l\r\u001b[?2004h>         aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)\r\n\u001b[?2004l\r\u001b[?2004h>     return np.argmin(aic[1:-1]) + 1\r\n\u001b[?2004l\r"]
