[423.579818, "o", "def classic_sta_lta(sig, nsta, nlta):\r\n\u001b[?2004l\r"]
[423.57996, "o", "\u001b[?2004h> "]
[423.580007, "o", "    sq_sig = sig**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.580151, "o", "    sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')\r\n\u001b[?2004l\r"]
[423.580239, "o", "\u001b[?2004h> "]
[423.580362, "o", "    lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')\r\n\u001b[?2004l\r"]
[423.580527, "o", "\u001b[?2004h>     return sta / (lta + 1e-30)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.580832, "o", "def aic_pick(sig):\r\n\u001b[?2004l\r\u001b[?2004h>     n = len(sig)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.580908, "o", "    if n < 10: return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.581053, "o", "    aic = np.zeros(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.581187, "o", "    for k in range(2, n - 2):\r\n\u001b[?2004l\r"]
[423.581283, "o", "\u001b[?2004h> "]
