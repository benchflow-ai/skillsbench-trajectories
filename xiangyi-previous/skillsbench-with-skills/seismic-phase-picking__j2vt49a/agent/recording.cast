[103.215504, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.215649, "o", "def classic_sta_lta(sig, nsta, nlta):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.215757, "o", "    sta = np.zeros(len(sig))\r\n\u001b[?2004l\r"]
[103.215788, "i", "lding, start searching after P-pick if available\n            s_thresh = 3.0\n            search_start = p_idx + int(0.5*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > s_thresh)[0]\n                if len(s_picks) > 0:\n                    s_idx = s_picks[0] + search_start\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception as e:\n            print(f'Error processing {f}: {e}')\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
