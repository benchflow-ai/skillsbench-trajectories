[455.22323, "o", "                p_char = classic_sta_lta(p_sig, int(0.1*fs), int(3.0*fs))\r\n\u001b[?2004l\r"]
[455.223341, "o", "\u001b[?2004h> "]
[455.223471, "o", "                p_picks = np.where(p_char > 1.6)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.223598, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h>             p_idx = None\r\n\u001b[?2004l\r"]
[455.22372, "o", "\u001b[?2004h>             if len(p_picks) > 0:\r\n\u001b[?2004l\r"]
[455.223845, "o", "\u001b[?2004h>                 p_idx_pre = p_picks[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[455.2241, "o", "> "]
[455.224288, "o", "                start = max(0, p_idx_pre - int(0.5*fs))\r\n\u001b[?2004l\r\u001b[?2004h>                 end = min(len(p_sig), p_idx_pre + int(0.5*fs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.224452, "o", "                p_idx = start + aic_pick(p_sig[start:end])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.224643, "o", "                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.224698, "o", "            \r\n"]
[455.228461, "o", "\u001b[?2004l\r\u001b[?2004h"]
[455.22853, "o", "> "]
[455.228827, "o", "            # S-pick: horizontal energy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.229023, "o", "            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.229205, "o", "            s_char = classic_sta_lta(s_sig, int(0.2*fs), int(5.0*fs))\r\n\u001b[?2004l\r"]
[455.22926, "o", "\u001b[?2004h> "]
[455.229488, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.22968, "o", "            search_start = p_idx + int(0.2*fs) if p_idx is not None else int(1.0*fs)\r\n\u001b[?2004l\r"]
[455.229728, "o", "\u001b[?2004h> "]
[455.229958, "o", "            if search_start < len(s_char):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.230215, "o", "                s_picks = np.where(s_char[search_start:] > 1.4)[0]\r\n"]
[455.230271, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[455.230502, "o", "                if len(s_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.230668, "o", "                    s_idx_pre = s_picks[0] + search_start\r\n\u001b[?2004l\r"]
[455.230716, "o", "\u001b[?2004h> "]
[455.231004, "o", "                    start = max(search_start, s_idx_pre - int(0.5*fs))\r\n\u001b[?2004l\r"]
[455.231161, "o", "\u001b[?2004h> "]
[455.231362, "o", "                    end = min(len(s_sig), s_idx_pre + int(0.5*fs))\r\n\u001b[?2004l\r"]
[455.231513, "o", "\u001b[?2004h> "]
[455.231675, "o", "                    s_idx = start + aic_pick(s_sig[start:end])\r\n"]
[455.231815, "o", "\u001b[?2004l\r"]
[455.232659, "o", "\u001b[?2004h"]
[455.2333, "o", ">                     results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.23361, "o", "            elif len(p_picks) == 0: # Try picking S even if no P\r\n\u001b[?2004l\r\u001b[?2004h>                 s_picks = np.where(s_char[int(1.0*fs):] > 1.4)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.234012, "o", "                if len(s_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                     s_idx_pre = s_picks[0] + int(1.0*fs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.234309, "o", "                    start = max(0, s_idx_pre - int(0.5*fs))\r\n\u001b[?2004l\r\u001b[?2004h>                     end = min(len(s_sig), s_idx_pre + int(0.5*fs))"]
[455.235042, "o", "\r\n\u001b[?2004l\r"]
[455.235217, "o", "\u001b[?2004h>                     s_idx = start + aic_pick(s_sig[start:end])\r\n\u001b[?2004l\r"]
[455.23543, "o", "\u001b[?2004h> "]
[455.235585, "o", "                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.235899, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.236062, "o", "    df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.23623, "o", "    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[455.236385, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     pick_phases()\r\n\u001b[?2004l\r\u001b[?2004h> "]
