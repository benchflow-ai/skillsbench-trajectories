[144.288806, "o", "\u001b[?2004hroot@61b932f24ef7:~# "]
[161.739365, "i", "cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta(sig, nsta, nlta):\n    sq_sig = sig**2\n    cumsum = np.cumsum(np.insert(sq_sig, 0, 0))\n    sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta\n    lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta\n    \n    # Align sta/lta: lta corresponds to the window ending at the same point as sta\n    # but with a longer window.\n    # sta[i] is average of sq_sig[i:i+nsta]\n    # lta[i] is average of sq_sig[i:i+nlta]\n    # We want ratio at index k = i + nsta\n    \n    # Let's simplify and use the same logic as ObsPy's classic_sta_lta\n    # ratio[i] = sta[i] / lta[i]\n    # To avoid division by zero, use a tiny epsilon relative to the mean\n    eps = np.mean(sq_sig) * 1e-6 + 1e-30\n    \n    # Pad lta to match sta length if necessary, but here they are calculated from same cumsum\n    # Let's just use a simpler rolling window approach with numpy\n    \n    res = np.zeros(len(sig))\n    for i in range(nlta, len(sig)):\n        sta_val = (cumsum[i] - cumsum[i-nsta]) / nsta\n        lta_val = (cumsum[i] - cumsum[i-nlta]) / nlta\n        res[i] = sta_val / (lta_val + eps)\n    return res\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        path = os.path.join(data_dir, f)\n        try:\n            d = np.load(path)\n            data = d['data']\n            dt = d['dt']\n            fs = 1.0 / dt\n            \n            # Detrend\n            data = data - np.mean(data, axis=0)\n            \n            # P-picking on Vertical channel (index 2)\n            p_sig = data[:, 2]\n            # Lowpass or Bandpass filter can help\n            # data_filt = bandpass_filter(data,"]
[161.739435, "i", " 1.0, 20.0, fs)\n            # p_sig = data_filt[:, 2]\n            \n            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(2.0*fs))\n            p_picks = np.where(p_char > 2.5)[0]\n            p_idx = None\n            if len(p_picks) > 0:\n                p_idx = p_picks[0]\n                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\n            \n            # S-picking on Horizontals\n            s_sig = np.sqrt(data[:, 0]**2 + data[:, 1]**2)\n            s_char = classic_sta_lta(s_sig, int(0.2*fs), int(4.0*fs))\n            \n            # Search for S after P\n            search_start = p_idx + int(0.5*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > 2.0)[0]\n                if len(s_picks) > 0:\n                    s_idx = s_picks[0] + search_start\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception as e:\n            pass\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
[161.740357, "o", "cat << 'EOF' > /root/picker.py\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from scipy import signal"]
