[79.679329, "i", "cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\n\ndef recursive_sta_lta(sig, nsta, nlta):\n    sta = np.zeros(len(sig))\n    lta = np.zeros(len(sig))\n    # Simple STA/LTA implementation\n    sq_sig = sig**2\n    for i in range(len(sig)):\n        if i < nlta:\n            sta[i] = np.mean(sq_sig[max(0, i-nsta):i+1])\n            lta[i] = np.mean(sq_sig[0:i+1])\n        else:\n            sta[i] = np.mean(sq_sig[i-nsta:i+1])\n            lta[i] = np.mean(sq_sig[i-nlta:i+1])\n    return sta / (lta + 1e-10)\n\ndef fast_sta_lta(sig, nsta, nlta):\n    sq_sig = sig**2\n    sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')\n    lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')\n    return sta / (lta + 1e-10)\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        path = os.path.join(data_dir, f)\n        d = np.load(path)\n        data = d['data'] # (12000, 3)\n        dt = d['dt']\n        \n        # Channels: DPE, DPN, DPZ (usually)\n        # P-wave: use Vertical channel (index 2)\n        # S-wave: use Horizontal channels (index 0, 1)\n        \n        # Preprocessing: detrend and bandpass (simple highpass here)\n        # But let's try STA/LTA on raw first, or just mean-removed\n        data = data - np.mean(data, axis=0)\n        \n        # P-picking on DPZ\n        p_sig = data[:, 2]\n        p_char = fast_sta_lta(p_sig, int(0.1/dt), int(2.0/dt))\n        p_picks = np.where(p_char > 3.0)[0]\n        if len(p_picks) > 0:\n            # Take the first pick that satisfies the threshold\n            # Or better, the first local maximum above threshold\n            results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_picks[0]})\n            \n        # S-picking on Horizontals\n        s_sig = np.sqrt(data[:, 0]**2 + data[:, 1]**2)\n        s_char = fast_sta_lta(s_sig, int(0.2/dt), int(4.0/dt))\n        # Avoid picking S before P or too close to P\n        p_idx = p_picks[0] if len(p_p"]
[79.679827, "i", "icks) > 0 else 0\n        s_char[:p_idx + int(0.2/dt)] = 0\n        s_picks = np.where(s_char > 2.5)[0]\n        if len(s_picks) > 0:\n            results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_picks[0]})\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
