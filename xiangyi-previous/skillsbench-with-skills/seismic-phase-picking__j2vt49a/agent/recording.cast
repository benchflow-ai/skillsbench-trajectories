[127.590458, "i", "cat << 'EOF' > /root/debug_picker.py\nimport numpy as np\nimport os\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta(sig, nsta, nlta):\n    sq_sig = sig**2\n    cumsum = np.cumsum(np.insert(sq_sig, 0, 0))\n    sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta\n    lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta\n    # Align sta/lta\n    lta_padded = np.pad(lta, (nlta-nsta, 0), 'constant', constant_values=1e-10)\n    # Now sta and lta_padded have same length as sta\n    return sta / (lta_padded + 1e-10)\n\npath = '/root/data/BG.ACR..DP.0215954.npz'\nd = np.load(path)\ndata = d['data']\ndt = d['dt']\nfs = 1.0 / dt\ndata_filt = bandpass_filter(data, 1.0, 15.0, fs)\np_sig = data_filt[:, 2]\np_char = classic_sta_lta(p_sig, int(0.1*fs), int(2.0*fs))\nprint(f'P_sig max: {np.max(np.abs(p_sig))}')\nprint(f'P_char max: {np.max(p_char)}')\nprint(f'P_char mean: {np.mean(p_char)}')\n\ns_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\ns_char = classic_sta_lta(s_sig, int(0.3*fs), int(4.0*fs))\nprint(f'S_sig max: {np.max(np.abs(s_sig))}')\nprint(f'S_char max: {np.max(s_char)}')\nprint(f'S_char mean: {np.mean(s_char)}')\nEOF\n"]
