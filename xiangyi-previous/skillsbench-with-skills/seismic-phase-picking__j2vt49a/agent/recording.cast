[360.07374, "o", "\u001b[?2004l\r"]
[360.073845, "o", "\u001b[?2004h"]
[360.074011, "o", "> "]
[360.074063, "o", "    aic[0] = aic[1]\r\n\u001b[?2004l\r"]
[360.075134, "o", "\u001b[?2004h> "]
[360.075271, "o", "    aic[-1] = aic[-2]\r\n\u001b[?2004l\r"]
[360.075308, "o", "\u001b[?2004h"]
[360.075338, "o", "> "]
[360.075445, "o", "    return np.argmin(aic)\r\n\u001b[?2004l\r"]
[360.075478, "o", "\u001b[?2004h"]
[360.075657, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.075766, "o", "def pick_phases():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.075851, "o", "    data_dir = '/root/data/'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.076009, "o", "    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\r\n\u001b[?2004l\r"]
[360.076153, "o", "\u001b[?2004h>     results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.076186, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     for f in files:\r\n\u001b[?2004l\r"]
[360.076253, "o", "\u001b[?2004h> "]
[360.076337, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.076483, "o", "            d = np.load(os.path.join(data_dir, f))\r\n\u001b[?2004l\r"]
[360.076518, "o", "\u001b[?2004h> "]
[360.07663, "o", "            data = d['data']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.076723, "o", "            dt = d['dt']\r\n\u001b[?2004l\r"]
[360.076757, "o", "\u001b[?2004h> "]
[360.076854, "o", "            fs = 1.0 / dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.07694, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.077118, "o", "            data_filt = bandpass_filter(data, 1.0, 15.0, fs)\r\n\u001b[?2004l\r"]
[360.077187, "o", "\u001b[?2004h>             \r\n"]
[360.077216, "o", "\u001b[?2004l\r\u001b[?2004h"]
[360.077251, "o", "> "]
[360.077407, "o", "            # P-pick on Vertical\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.077502, "o", "            p_sig = data_filt[:, 2]\r\n\u001b[?2004l\r"]
[360.077542, "o", "\u001b[?2004h> "]
[360.07776, "o", "            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(2.0*fs))\r\n\u001b[?2004l\r"]
[360.077884, "o", "\u001b[?2004h> "]
[360.077982, "o", "            p_picks = np.where(p_char > 2.5)[0]\r\n\u001b[?2004l\r"]
[360.07817, "o", "\u001b[?2004h> "]
[360.078632, "o", "            p_idx = None\r\n\u001b[?2004l\r\u001b[?2004h>             if len(p_picks) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 p_idx_pre = p_picks[0]\r\n\u001b[?2004l\r"]
[360.078756, "o", "\u001b[?2004h> "]
[360.078855, "o", "                start = max(0, p_idx_pre - int(0.5*fs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.079012, "o", "                end = min(len(p_sig), p_idx_pre + int(0.2*fs))\r\n\u001b[?2004l\r"]
[360.07914, "o", "\u001b[?2004h> "]
[360.079243, "o", "                p_idx = start + aic_pick(p_sig[start:end])\r\n\u001b[?2004l\r"]
[360.079278, "o", "\u001b[?2004h> "]
[360.079537, "o", "                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\r\n\u001b[?2004l\r"]
[360.079573, "o", "\u001b[?2004h> "]
[360.079693, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.079804, "o", "            # S-pick on Horizontals\r\n\u001b[?2004l\r"]
[360.080522, "o", "\u001b[?2004h> "]
[360.08058, "o", "            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\r\n\u001b[?2004l\r\u001b[?2004h>             s_char = classic_sta_lta(s_sig, int(0.2*fs), int(4.0*fs))\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.080821, "o", "            search_start = p_idx + int(0.1*fs) if p_idx is not None else int(1.0*fs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.080858, "o", "> "]
[360.08099, "o", "            if search_start < len(s_char):\r\n\u001b[?2004l\r"]
[360.081031, "o", "\u001b[?2004h> "]
[360.08123, "o", "                s_picks = np.where(s_char[search_start:] > 2.0)[0]"]
[360.081296, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.081358, "o", "> "]
[360.088522, "o", "                if len(s_picks) > 0:\r\n\u001b[?2004l\r"]
[360.088571, "o", "\u001b[?2004h> "]
[360.088709, "o", "                    s_idx_pre = s_picks[0] + search_start\r\n\u001b[?2004l\r"]
[360.088744, "o", "\u001b[?2004h> "]
[360.088938, "o", "                    start = max(search_start, s_idx_pre - int(0.5*fs))\r\n\u001b[?2004l\r"]
[360.088975, "o", "\u001b[?2004h> "]
[360.089151, "o", "                    end = min(len(s_sig), s_idx_pre + int(0.5*fs))\r\n\u001b[?2004l\r"]
[360.089189, "o", "\u001b[?2004h> "]
[360.089352, "o", "                    s_idx = start + aic_pick(s_sig[start:end])\r\n\u001b[?2004l\r"]
[360.089384, "o", "\u001b[?2004h> "]
[360.089974, "o", "                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     df = pd.DataFrame(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.090077, "o", "    df.to_csv('/root/results.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.090243, "o", "    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\r\n\u001b[?2004l\r"]
[360.090277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.090309, "o", "\u001b[?2004h> "]
[360.090399, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[360.090432, "o", "\u001b[?2004h> "]
[360.090503, "o", "    pick_phases()\r\n\u001b[?2004l\r"]
[360.090535, "o", "\u001b[?2004h> "]
[360.090565, "o", "EOF\r\n\u001b[?2004l\r"]
