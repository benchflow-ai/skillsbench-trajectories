[127.593431, "o", "> \r\n"]
[127.593525, "o", "\u001b[?2004l\r\u001b[?2004h> def bandpass_filter(data, lowcut, highcut, fs, order=4):"]
[127.593618, "o", "\r\n"]
[127.59371, "o", "\u001b[?2004l\r"]
[127.593828, "o", "\u001b[?2004h"]
[127.593994, "o", "> "]
[127.594082, "o", "    nyquist = 0.5 * fs"]
[127.594405, "o", "\r\n"]
[127.594636, "o", "\u001b[?2004l\r\u001b[?2004h"]
[127.594738, "o", ">     low = lowcut / nyquist"]
[127.594875, "o", "\r\n"]
[127.595101, "o", "\u001b[?2004l\r\u001b[?2004h"]
[127.59523, "o", ">     high = highcut / nyquist"]
[127.595376, "o", "\r\n"]
