[455.219316, "o", "\u001b[?2004h"]
[455.219481, "o", "> "]
[455.219577, "o", "    aic[:2] = aic[2]"]
[455.219706, "o", "\r\n"]
[455.219879, "o", "\u001b[?2004l\r\u001b[?2004h"]
[455.21998, "o", ">     aic[-2:] = aic[-3]"]
[455.220109, "o", "\r\n\u001b[?2004l\r"]
[455.220273, "o", "\u001b[?2004h> "]
[455.22041, "o", "    return np.argmin(aic)"]
[455.22054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def pick_phases():\r\n\u001b[?2004l\r"]
