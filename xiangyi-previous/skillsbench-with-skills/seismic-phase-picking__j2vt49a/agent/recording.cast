[184.542403, "o", "[ 8.8857165e-16  4.7413146e-16 -5.2428708e-16  6.8134166e-16\r\n  1.1334499e-15  5.4946763e-16 -4.1223632e-15  8.3202988e-16\r\n  1.1711101e-15 -7.1269495e-16 -2.0690357e-15  6.7283113e-15\r\n -1.0489635e-14  8.4614009e-15 -7.0046105e-15  1.4282338e-14\r\n -1.3937006e-14  8.6497649e-15 -7.9276888e-15  1.3754858e-14]\r\n"]
