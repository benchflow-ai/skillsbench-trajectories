[360.059208, "i", "cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta(sig, nsta, nlta):\n    sq_sig = sig**2\n    sta = np.convolve(sq_sig, np.ones(nsta)/nsta, mode='same')\n    lta = np.convolve(sq_sig, np.ones(nlta)/nlta, mode='same')\n    return sta / (lta + 1e-30)\n\ndef aic_pick(sig):\n    n = len(sig)\n    if n < 2: return 0\n    aic = np.zeros(n)\n    for k in range(1, n - 1):\n        var1 = np.var(sig[0:k])\n        var2 = np.var(sig[k:n])\n        if var1 <= 0: var1 = 1e-30\n        if var2 <= 0: var2 = 1e-30\n        aic[k] = k * np.log10(var1) + (n - k) * np.log10(var2)\n    aic[0] = aic[1]\n    aic[-1] = aic[-2]\n    return np.argmin(aic)\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        try:\n            d = np.load(os.path.join(data_dir, f))\n            data = d['data']\n            dt = d['dt']\n            fs = 1.0 / dt\n            \n            data_filt = bandpass_filter(data, 1.0, 15.0, fs)\n            \n            # P-pick on Vertical\n            p_sig = data_filt[:, 2]\n            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(2.0*fs))\n            p_picks = np.where(p_char > 2.5)[0]\n            p_idx = None\n            if len(p_picks) > 0:\n                p_idx_pre = p_picks[0]\n                start = max(0, p_idx_pre - int(0.5*fs))\n                end = min(len(p_sig), p_idx_pre + int(0.2*fs))\n                p_idx = start + aic_pick(p_sig[start:end])\n                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\n            \n            # S-pick on Horizontals\n            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\n            s_char = classic_sta_lta(s_sig, int(0.2*fs), int(4.0*fs))\n            \n            search_start = p_idx + int(0.1*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > 2.0)[0]\n                if len(s_picks) > 0:\n                    s_idx_pre = s_picks[0] + search_start\n                    start = max(search_start, s_idx_pre - int(0.5*fs))\n                    end = min(len(s_sig), s_idx_pre + int(0.5*fs))\n                    s_idx = start + aic_pick(s_sig[start:end])\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception:\n            pass\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"]
