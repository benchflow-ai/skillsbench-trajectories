[179.997518, "o", "\r\n                #ssh_msg_global_request{}            = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_request_success{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_request_failure{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_open{}              = Msg -> {keep_state, D1,\r\n                                                               [{{timeout, max_initial_idle_time}, cancel} |\r\n                                                                ?CONNECTION_MSG(Msg)\r\n                                                               ]};\r\n                #ssh_msg_channel_open_confirmation{} = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_open_failure{}      = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_window_adjust{}     = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_data{}              = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_extended_data{}     = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_eof{}               = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_close{}             = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n                #ssh_msg_channel_request{}           = Msg -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\r\n"]
[179.998004, "o", "\u001b[?2004hroot@bce1d249761e:/app/workspace# "]
[195.616423, "i", "cat <<EOF > fix.py\nlines = open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl').readlines()\n\nnew_lines = []\nskip = 0\nfor line in lines:\n    if skip > 0:\n        skip -= 1\n        continue\n    \n    if '#ssh_msg_global_request{}' in line and '= Msg ->' in line:\n        # Fix global_request\n        new_lines.append('                #ssh_msg_global_request{} = Msg when ?CONNECTED(StateName) -> {keep_state, D1, ?CONNECTION_MSG(Msg)};\\n')\n        new_lines.append('                #ssh_msg_global_request{} = _Msg -> {keep_state, D1};\\n')\n    elif '#ssh_msg_channel_open{}' in line and '= Msg ->' in line:\n        # Fix channel_open\n        new_lines.append('                #ssh_msg_channel_open{} = Msg when ?CONNECTED(StateName) -> {keep_state, D1,\\n')\n        new_lines.append('                                                               [{{timeout, max_initial_idle_time}, cancel} |\\n')\n        new_lines.append('                                                                ?CONNECTION_MSG(Msg)\\n')\n        new_lines.append('                                                               ]};\\n')\n        new_lines.append('                #ssh_msg_channel_open{} = _Msg -> {keep_state, D1};\\n')\n        skip = 3 # Skip the next 3 lines of the original channel_open block\n    else:\n        new_lines.append(line)\n\nwith open('/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl', 'w') as f:\n    f.writelines(new_lines)\nEOF\npython3 fix.py\n"]
[195.616681, "o", "cat <<EOF > fix.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
