[104.60162, "o", "\u001b[32m\u001b[K2113\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_on(connection_events) -> dbg:tp(?MODULE,   \u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, 4, x);\r\n\u001b[32m\u001b[K2121\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_on(tcp) -> dbg:tp(?MODULE, \u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, 4,\r\n\u001b[32m\u001b[K2134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_off(tcp) -> dbg:ctpg(?MODULE, \u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, 4), % How to avoid cancelling 'connection_events' ?\r\n\u001b[32m\u001b[K2142\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_off(connection_events) -> dbg:ctpg(?MODULE, \u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, 4);\r\n\u001b[32m\u001b[K2174\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(connection_events, {call, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, [EventType, EventContent, State, _Data]}}) ->\r\n\u001b[32m\u001b[K2178\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(connection_events, {return_from, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K,4}, Ret}) ->\r\n\u001b[32m\u001b[K2183\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(tcp, {call, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, [info, {tcp,Sock,TcpData}, State, _Data]}}) ->\r\n\u001b[32m\u001b[K2189\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(tcp, {call, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, [info, {tcp_error,Sock,Msg}, State, _Data]}}) ->\r\n\u001b[32m\u001b[K2195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(tcp, {call, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K, [info, {tcp_closed,Sock}, State, _Data]}}) ->\r\n\u001b[32m\u001b[K2200\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kssh_dbg_format(tcp, {return_from, {?MODULE,\u001b[01;31m\u001b[Khandle_event\u001b[m\u001b[K,4}, _Ret}) ->\r\n"]
