[149.366036, "o", "\u001b[?2004h> "]
[149.366203, "o", "            if (temp1 >= 100 and temp1 <= 150) or (temp2 >= 100 and temp2 <= 150):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.366296, "o", "                 if t2 > t1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.366465, "o", "                     rate = (temp2 - temp1) / (t2 - t1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.366499, "o", "> "]
[149.366592, "o", "                     ramps.append(rate)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.366643, "o", "        \r\n\u001b[?2004l\r"]
[149.366678, "o", "\u001b[?2004h> "]
[149.366709, "o", "        if ramps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.3668, "o", "            max_r = max(ramps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.366834, "o", "> "]
[149.366921, "o", "            if max_r > max_ramp_run:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.366957, "o", "> "]
[149.367024, "o", "                max_ramp_run = max_r\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.367058, "o", "> "]
[149.367141, "o", "                selected_tc_id = tc_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.367178, "o", ">     \r\n\u001b[?2004l\rk\u001b[?2004h> "]
[149.367254, "o", "    if selected_tc_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.367352, "o", "        max_ramp_by_run[run_id] = {\r\n\u001b[?2004l\r"]
[149.367387, "o", "\u001b[?2004h> "]
[149.367481, "o", "            \"tc_id\": selected_tc_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.367516, "o", "> "]
[149.36768, "o", "            \"max_preheat_ramp_c_per_s\": round(max_ramp_run, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.367704, "o", "        }\r\n\u001b[?2004l\r"]
[149.367773, "o", "\u001b[?2004h> "]
[149.367829, "o", "        if max_ramp_run > ramp_limit:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.367866, "o", "> "]
[149.367977, "o", "            violating_runs_q1.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.36801, "o", "> \r\n\u001b[?2004l\r]\u001b[?2004h> "]
[149.368079, "o", "# Sort\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.368111, "o", "violating_runs_q1.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.368147, "o", "> "]
[149.368241, "o", "# Sort dict by key\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.368356, "o", "max_ramp_by_run = dict(sorted(max_ramp_by_run.items()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.368392, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[149.368465, "o", "q1_output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.36855, "o", "  \"ramp_rate_limit_c_per_s\": ramp_limit,\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.368583, "o", "> "]
[149.36868, "o", "  \"violating_runs\": violating_runs_q1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.368713, "o", "> "]
[149.368802, "o", "  \"max_ramp_by_run\": max_ramp_by_run\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.368836, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.368934, "o", "save_json(q1_output, 'q01.json')\r\n\u001b[?2004l\r"]
[149.368966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.368999, "o", "\u001b[?2004h> "]
[149.369085, "o", "# --- Q2: TAL ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.369319, "o", "# TAL Window: 30-60s. TC: largest_mass (coldest, hardest to reflow).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.369409, "o", "# Threshold: Liquidus.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[149.36945, "o", "q2_output = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[149.369484, "o", "> "]
[149.369563, "o", "for index, row in mes.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.369594, "o", "> "]
[149.369669, "o", "    run_id = row['run_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.36983, "o", "    liquidus = row['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[149.369879, "o", "\u001b[?2004h> "]
[149.369991, "o", "    run_tcs = tcs[tcs['run_id'] == run_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.370033, "o", "> "]
[149.370068, "o", "    if run_tcs.empty:\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[149.37015, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[149.370183, "o", "\u001b[?2004h> "]
[149.370258, "o", "    # Select largest_mass\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.370291, "o", "> "]
[149.37045, "o", "    tc_data = run_tcs[run_tcs['tc_location'] == 'largest_mass']\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.370481, "o", "> "]
[149.370533, "o", "    if tc_data.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.370566, "o", "> "]
[149.370644, "o", "        tc_data = run_tcs # Fallback\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.370679, "o", ">     \r\n\u001b[?2004l\r"]
[149.370755, "o", "\u001b[?2004h> "]
[149.37097, "o", "    # If multiple largest_mass, which one? The one with MINIMUM TAL (worst case for wetting)?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.371145, "o", "    # Or the one with MAXIMUM TAL (worst case for brittle)?\r\n\u001b[?2004l\r"]
[149.371179, "o", "\u001b[?2004h> "]
[149.371397, "o", "    # Handbook says \"ensure quality reflow... wetting time is normally 30 to 60\".\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.371428, "o", "> "]
[149.371607, "o", "    # If TAL < 30 -> non-compliant (didn't wet).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.37172, "o", "    # If TAL > 60 -> non-compliant (brittle).\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.371752, "o", "> "]
[149.371994, "o", "    # So we need to check if ANY largest_mass TC is out of spec? Or the representative one?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.37215, "o", "    # \"Select the most representative thermocouple value\".\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.3722, "o", "> "]
[149.372329, "o", "    # Usually, largest mass is the critical one for MIN TAL.\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.372363, "o", "> "]
[149.372657, "o", "    # Let's pick the specific TC that has the lowest Peak Temp (coldest) as the representative for largest_mass?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.372871, "o", "    # Or just process all largest_mass TCs and report the one that fails? \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.372904, "o", "> "]
[149.373098, "o", "    # The output format expects one entry per run (implied by \"tc_id\": \"\").\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.373364, "o", "    # Let's calculate TAL for all largest_mass TCs and pick the one that is most critical.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.373565, "o", "    # Most critical = furthest from center of window? Or min TAL?\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.373599, "o", "> "]
[149.373769, "o", "    # Let's pick the one with Min TAL as it's the \"coldest\" spot.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.373798, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.373878, "o", "    selected_tc = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.373991, "o", "    min_tal = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.374026, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.37417, "o", "    # First, calculate TAL for all candidates\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.374229, "o", "    candidates = []\r\n\u001b[?2004l\r"]
[149.374263, "o", "\u001b[?2004h> "]
[149.374371, "o", "    for tc_id in tc_data['tc_id'].unique():\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.374406, "o", "> "]
[149.37465, "o", "        df_tc = tc_data[tc_data['tc_id'] == tc_id].sort_values('time_s')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.374725, "o", "        times = df_tc['time_s'].values\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.374806, "o", "> "]
[149.37485, "o", "        temps = df_tc['temp_c'].values\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.374881, "o", ">         \r\n\u001b[?2004l\r"]
[149.374913, "o", "\u001b[?2004h> "]
[149.375075, "o", "        # Calculate time above liquidus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.375253, "o", "        # Simple integration: sum of time intervals where avg temp > liquidus\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.375314, "o", "> "]
[149.375355, "o", "        tal = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.375447, "o", "        for i in range(len(times) - 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.37548, "o", "> "]
[149.375586, "o", "            t1, t2 = times[i], times[i+1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.375655, "o", "> "]
[149.375731, "o", "            temp1, temp2 = temps[i], temps[i+1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.375793, "o", ">             \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[149.375884, "o", "            # Check intersection\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.375907, "o", "> "]
[149.376044, "o", "            if temp1 > liquidus and temp2 > liquidus:\r\n\u001b[?2004l\r"]
[149.376063, "o", "\u001b[?2004h> "]
[149.376228, "o", "                tal += (t2 - t1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.376342, "o", "            elif temp1 <= liquidus and temp2 <= liquidus:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.376476, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.376555, "o", "            else:\r\n\u001b[?2004l\rnt\u001b[?2004h> "]
[149.376606, "o", "                # Linear interpolation\r\n\u001b[?2004l\r"]
[149.376669, "o", "\u001b[?2004h> "]
[149.376709, "o", "                # T(t) = m*t + c\r\n\u001b[?2004l\r"]
[149.376734, "o", "\u001b[?2004h> "]
[149.376849, "o", "                # Find t where T = liquidus\r\n\u001b[?2004l\r"]
[149.376894, "o", "\u001b[?2004h> "]
[149.376999, "o", "                slope = (temp2 - temp1) / (t2 - t1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.377039, "o", "> "]
[149.377103, "o", "                if slope != 0:\r\n\u001b[?2004l\r"]
[149.377143, "o", "\u001b[?2004h> "]
[149.377298, "o", "                    t_cross = t1 + (liquidus - temp1) / slope\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.377323, "o", "> "]
[149.377432, "o", "                    if temp1 > liquidus:\r\n\u001b[?2004l\r"]
[149.377451, "o", "\u001b[?2004h> "]
[149.3776, "o", "                         tal += (t_cross - t1)\r\n\u001b[?2004l\r"]
[149.377628, "o", "\u001b[?2004h> "]
[149.377746, "o", "                    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.377847, "o", "                         tal += (t2 - t_cross)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.377893, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.387202, "o", "        candidates.append({'tc_id': tc_id, 'tal': tal})\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Select representative.\r\n\u001b[?2004l\r\u001b[?2004h>     # If any is < 30, pick that (failure).\r\n\u001b[?2004l\r\u001b[?2004h>     # If all > 60, pick that (failure).\r\n\u001b[?2004l\r\u001b[?2004h>     # If multiple fails, pick worst.\r\n\u001b[?2004l\r\u001b[?2004h>     # If all pass, pick any (maybe min TAL).\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     best_candidate = candidates[0]\r\n\u001b[?2004l\r\u001b[?2004h>     # Logic: Prioritize showing non-compliance.\r\n\u001b[?2004l\r\u001b[?2004h>     # Check for < 30\r\n\u001b[?2004l\r\u001b[?2004h>     low_fails = [c for c in candidates if c['tal'] < 30]\r\n\u001b[?2004l\r\u001b[?2004h>     high_fails = [c for c in candidates if c['tal'] > 60]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if low_fails:\r\n\u001b[?2004l\r\u001b[?2004h>         best_candidate = min(low_fails, key=lambda x: x['tal']) # Worst low fail\r\n\u001b[?2004l\r\u001b[?2004h>     elif high_fails:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394015, "o", "        best_candidate = max(high_fails, key=lambda x: x['tal']) # Worst high fail\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         # All compliant, pick min TAL (closest to limit?)\r\n\u001b[?2004l\r\u001b[?2004h>         best_candidate = min(candidates, key=lambda x: x['tal'])\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     status = \"compliant\"\r\n\u001b[?2004l\r \u001b[?2004h>     if best_candidate['tal'] < 30 or best_candidate['tal'] > 60:\r\n\u001b[?2004l\r\u001b[?2004h>         status = \"non-compliant\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     q2_output.append({\r\n\u001b[?2004l\ra\u001b[?2004h>         \"run_id\": run_id,\r\n\u001b[?2004l\r\u001b[?2004h>         \"tc_id\": best_candidate['tc_id'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"tal_s\": round(best_candidate['tal'], 2),\r\n\u001b[?2004l\r\u001b[?2004h>         \"required_min_tal_s\": 30.0,\r\n\u001b[?2004l\r\u001b[?2004h>         \"required_max_tal_s\": 60.0,\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": status\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> q2_output.sort(key=lambda x: x['run_id'])\r\n\u001b[?2004l\r\u001b[?2004h> save_json(q2_output, 'q02.json')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # --- Q3: Peak Temp ---\r\n\u001b[?2004l\r\u001b[?2004h> # Min Peak = Liquidus + 20. TC: largest_mass.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> failing_runs_q3 = []\r\n\u001b[?2004l\r\u001b[?2004h> min_peak_by_run = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for index, row in mes.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h>     run_id = row['run_id']\r\n\u001b[?2004l\r\u001b[?2004h>     liquidus = row['solder_liquidus_c']\r\n\u001b[?2004l\r\u001b[?2004h>     required_peak = liquidus + 20.0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     run_tcs = tcs[tcs['run_id'] == run_id]\r\n\u001b[?2004l\r\u001b[?2004h>     if run_tcs.empty:\r\n\u001b[?2004l\r\u001b[?2004h>         failing_runs_q3.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     tc_data = run_tcs[run_tcs['tc_location'] == 'largest_mass']\r\n\u001b[?2004l\r\u001b[?2004h>     if tc_data.empty:\r\n\u001b[?2004l\r\u001b[?2004h>         tc_data = run_tcs\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394158, "o", "    # Find the TC with the LOWEST peak temp (worst case for min peak req)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394206, "o", "    worst_peak = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h>     selected_tc = None\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[149.394236, "o", "\u001b[?2004h> "]
[149.394348, "o", "    for tc_id in tc_data['tc_id'].unique():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394497, "o", "        peak = tc_data[tc_data['tc_id'] == tc_id]['temp_c'].max()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394615, "o", "        if peak < worst_peak:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394661, "o", "            worst_peak = peak\r\n\u001b[?2004l\r"]
[149.394694, "o", "\u001b[?2004h> "]
[149.394746, "o", "            selected_tc = tc_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.394782, "o", "            \r\n\u001b[?2004l\r"]
[149.394862, "o", "\u001b[?2004h>     min_peak_by_run[run_id] = {\r\n"]
[149.394893, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.394961, "o", "        \"tc_id\": selected_tc,\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.394995, "o", "> "]
[149.395094, "o", "        \"peak_temp_c\": round(worst_peak, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395231, "o", "        \"required_min_peak_c\": round(required_peak, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395295, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395321, "o", "> "]
[149.395361, "o", "    if worst_peak < required_peak:\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395383, "o", "> "]
[149.39546, "o", "        failing_runs_q3.append(run_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395489, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395533, "o", "failing_runs_q3.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395634, "o", "min_peak_by_run = dict(sorted(min_peak_by_run.items()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395659, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395688, "o", "q3_output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395753, "o", "  \"failing_runs\": failing_runs_q3,\r\n\u001b[?2004l\r"]
[149.395774, "o", "\u001b[?2004h> "]
[149.395838, "o", "  \"min_peak_by_run\": min_peak_by_run\r\n\u001b[?2004l\r"]
[149.395861, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.395918, "o", "save_json(q3_output, 'q03.json')\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.395957, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.395982, "o", "\u001b[?2004h> "]
[149.396026, "o", "# --- Q4: Conveyor Speed ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396048, "o", "> "]
[149.396113, "o", "# Req Speed = Boards/Min * Length / LoadFactor\r\n\u001b[?2004l\r"]
[149.396139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.396174, "o", "q4_output = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396205, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.39627, "o", "for index, row in mes.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.396327, "o", "    run_id = row['run_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.396348, "o", "> "]
[149.396391, "o", "    bpm = row['boards_per_min']\r\n\u001b[?2004l\r"]
[149.396412, "o", "\u001b[?2004h> "]
[149.396518, "o", "    length = row['board_length_cm']\r\n\u001b[?2004l\r"]
[149.39654, "o", "\u001b[?2004h> "]
[149.396626, "o", "    lf = row['loading_factor']\r\n\u001b[?2004l\r"]
[149.396664, "o", "\u001b[?2004h> "]
[149.396766, "o", "    actual_speed = row['conveyor_speed_cm_min']\r\n\u001b[?2004l\r"]
[149.396802, "o", "\u001b[?2004h>     \r\n"]
[149.396831, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.396872, "o", "    if lf > 0:\r\n\u001b[?2004l\r"]
[149.396901, "o", "\u001b[?2004h> "]
[149.396976, "o", "        req_speed = (bpm * length) / lf\r\n\u001b[?2004l\r"]
[149.397009, "o", "\u001b[?2004h> "]
[149.397038, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.397128, "o", "        req_speed = 0 # Should not happen\r\n\u001b[?2004l\r"]
[149.397161, "o", "\u001b[?2004h> "]
[149.39719, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.397316, "o", "    meets = actual_speed >= (req_speed - 0.01) # Tolerance?\r\n\u001b[?2004l\r"]
[149.397353, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[149.397382, "o", "\u001b[?2004h> "]
[149.397417, "o", "    q4_output.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.397468, "o", "        \"run_id\": run_id,\r\n\u001b[?2004l\r"]
[149.397497, "o", "\u001b[?2004h> "]
[149.397584, "o", "        \"required_min_speed_cm_min\": round(req_speed, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.397677, "o", "        \"actual_speed_cm_min\": round(actual_speed, 2),\r\n\u001b[?2004l\r"]
[149.397699, "o", "\u001b[?2004h> "]
[149.397733, "o", "        \"meets\": meets\r\n\u001b[?2004l\r"]
[149.397773, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[149.3978, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.397868, "o", "q4_output.sort(key=lambda x: x['run_id'])\r\n\u001b[?2004l\r"]
[149.397891, "o", "\u001b[?2004h> "]
[149.397954, "o", "save_json(q4_output, 'q04.json')\r\n\u001b[?2004l\r"]
[149.397988, "o", "\u001b[?2004h"]
[149.398109, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.398137, "o", "\u001b[?2004h> "]
[149.398174, "o", "# --- Q5: Best Run ---\r\n\u001b[?2004l\r"]
[149.3982, "o", "\u001b[?2004h> "]
[149.398259, "o", "# Best run per board_family.\r\n\u001b[?2004l\r"]
[149.398283, "o", "\u001b[?2004h> "]
[149.398437, "o", "# Criteria: Pass all checks (Q1, Q2, Q3, Q4). Then Efficiency (Speed?)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.398545, "o", "# Also Quality (Defects).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.398589, "o", "> "]
[149.398667, "o", "# 1. Identify failing runs\r\n\u001b[?2004l\r\u001b[?2004h> failed_runs = set()\r\n\u001b[?2004l\r"]
[149.398696, "o", "\u001b[?2004h> "]
[149.398772, "o", "failed_runs.update(violating_runs_q1)\r\n\u001b[?2004l\r"]
[149.398811, "o", "\u001b[?2004h> "]
[149.398965, "o", "failed_runs.update([r['run_id'] for r in q2_output if r['status'] == 'non-compliant'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399055, "o", "failed_runs.update(failing_runs_q3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.399077, "o", "> "]
[149.399223, "o", "failed_runs.update([r['run_id'] for r in q4_output if not r['meets']])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399294, "o", "# 2. Defect counts\r\n\u001b[?2004l\r"]
[149.399321, "o", "\u001b[?2004h> "]
[149.399514, "o", "# Sum defects per run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399615, "o", "defect_counts = defects.groupby('run_id')['count'].sum().to_dict()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399669, "o", "# 3. Group by family\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399719, "o", "families = mes['board_family'].unique()\r\n\u001b[?2004l\r"]
[149.399742, "o", "\u001b[?2004h> "]
[149.399783, "o", "q5_output = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.39981, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.399911, "o", "for family in families:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.40001, "o", "    family_runs = mes[mes['board_family'] == family]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.400038, "o", "    \r\n\u001b[?2004l\r"]
[149.400062, "o", "\u001b[?2004h> "]
[149.400102, "o", "    # Candidates\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.400153, "o", "    candidates = []\r\n\u001b[?2004l\r"]
[149.40018, "o", "\u001b[?2004h> "]
[149.400282, "o", "    for idx, row in family_runs.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.40031, "o", "> "]
[149.400347, "o", "        rid = row['run_id']\r\n\u001b[?2004l\r"]
[149.400371, "o", "\u001b[?2004h> "]
[149.40056, "o", "        is_compliant = rid not in failed_runs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.400601, "o", "        d_count = defect_counts.get(rid, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.400626, "o", "> "]
[149.400704, "o", "        speed = row['conveyor_speed_cm_min']\r\n\u001b[?2004l\r"]
[149.400734, "o", "\u001b[?2004h> "]
[149.400763, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.400835, "o", "        candidates.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.400859, "o", "> "]
[149.40091, "o", "            'run_id': rid,\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.400933, "o", "> "]
[149.401004, "o", "            'compliant': is_compliant,\r\n\u001b[?2004l\r"]
[149.40103, "o", "\u001b[?2004h> "]
[149.401098, "o", "            'defects': d_count,\r\n\u001b[?2004l\r"]
[149.401125, "o", "\u001b[?2004h> "]
[149.401173, "o", "            'speed': speed\r\n\u001b[?2004l\r"]
[149.401197, "o", "\u001b[?2004h> "]
[149.401219, "o", "        })\r\n\u001b[?2004l\r"]
[149.40124, "o", "\u001b[?2004h> "]
[149.401259, "o", "    \r\n\u001b[?2004l\r"]
[149.401284, "o", "\u001b[?2004h> "]
[149.401343, "o", "    # Sort candidates\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.401368, "o", "> "]
[149.401458, "o", "    # Priority: 1. Compliant (True > False)\r\n\u001b[?2004l\r"]
[149.401484, "o", "\u001b[?2004h> "]
[149.401596, "o", "    #           2. Defects (Low > High)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.401664, "o", "    #           3. Speed (High > Low)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.401684, "o", "    \r\n\u001b[?2004l\r"]
[149.401724, "o", "\u001b[?2004h> "]
[149.402037, "o", "    candidates.sort(key=lambda x: (x['compliant'], -x['defects'], x['speed']), reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if candidates:\r\n\u001b[?2004l\r"]
[149.402086, "o", "\u001b[?2004h> "]
[149.40212, "o", "        best_run = candidates[0]['run_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.403146, "o", "        runner_ups = [c['run_id'] for c in candidates[1:]]\r\n\u001b[?2004l\r\u001b[?2004h>         runner_ups.sort() # List others\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         q5_output.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"board_family\": family,\r\n\u001b[?2004l\r\u001b[?2004h>             \"best_run_id\": best_run,\r\n\u001b[?2004l\r\u001b[?2004h>             \"runner_up_run_ids\": runner_ups\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> q5_output.sort(key=lambda x: x['board_family'])\r\n\u001b[?2004l\r\u001b[?2004h> save_json(q5_output, 'q05.json')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[149.403197, "o", "\u001b[?2004l\r"]
[149.419296, "o", "\u001b[?2004hroot@3fc7c37f9150:/app# "]
[149.537831, "i", "python3 solve_task.py\n"]
[149.538093, "o", "python3 solve_task.py\r\n\u001b[?2004l\r"]
[150.461867, "o", "\u001b[?2004hroot@3fc7c37f9150:/app# "]
[159.932241, "i", "ls -l /app/output/\n"]
[159.932479, "o", "ls -l /app/output/\r\n\u001b[?2004l\r"]
