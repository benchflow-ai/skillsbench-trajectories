[159.934126, "o", "\u001b[?2004hroot@3fc7c37f9150:/app# "]
[160.072878, "i", "cat /app/output/q01.json\n"]
[160.07315, "o", "cat /app/output/q01.json\r\n\u001b[?2004l\r"]
[160.07419, "o", "{\r\n  \"ramp_rate_limit_c_per_s\": 2.0,\r\n  \"violating_runs\": [\r\n    \"R0018\",\r\n    \"R0035\",\r\n    \"R0040\",\r\n    \"R0044\",\r\n    \"R0046\",\r\n    \"R0050\",\r\n    \"R0053\",\r\n    \"R0055\"\r\n  ],\r\n  \"max_ramp_by_run\": {\r\n    \"R0001\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.65\r\n    },\r\n    \"R0002\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.03\r\n    },\r\n    \"R0003\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.08\r\n    },\r\n    \"R0004\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.64\r\n    },\r\n    \"R0005\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.51\r\n    },\r\n    \"R0006\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.78\r\n    },\r\n    \"R0007\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.83\r\n    },\r\n    \"R0008\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.89\r\n    },\r\n    \"R0009\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.82\r\n    },\r\n    \"R0010\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.47\r\n    },\r\n    \"R0011\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.43\r\n    },\r\n    \"R0012\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.55\r\n    },\r\n    \"R0013\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.32\r\n    },\r\n    \"R0014\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.74\r\n    },\r\n    \"R0015\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.41\r\n    },\r\n    \"R0016\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\": 1.04\r\n    },\r\n    \"R0017\": {\r\n      \"tc_id\": \"TC2\",\r\n      \"max_preheat_ramp_c_per_s\":