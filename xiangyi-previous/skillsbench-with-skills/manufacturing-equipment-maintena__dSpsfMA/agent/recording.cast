[50.705476, "i", "cat <<EOF > extract_handbook.py\nfrom pypdf import PdfReader\n\nreader = PdfReader(\"/app/data/handbook.pdf\")\nwith open(\"handbook.txt\", \"w\") as f:\n    for page in reader.pages:\n        f.write(page.extract_text() + \"\\n\")\nEOF\n"]
