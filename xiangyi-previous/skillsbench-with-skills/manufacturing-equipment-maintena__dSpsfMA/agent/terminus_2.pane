[?2004l[?2004h>             'compliant': is_compliant,
[?2004l[?2004h>             'defects': d_count,
[?2004l[?2004h>             'speed': speed
[?2004l[?2004h>         })
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort candidates
[?2004l[?2004h>     # Priority: 1. Compliant (True > False)
[?2004l[?2004h>     #           2. Defects (Low > High)
[?2004l[?2004h>     #           3. Speed (High > Low)
[?2004l[?2004h>     
[?2004l[?2004h>     candidates.sort(key=lambda x: (x['compliant'], -x['defects'], x['speed']), reverse=True)
[?2004l[?2004h>     
[?2004l[?2004h>     if candidates:
[?2004l[?2004h>         best_run = candidates[0]['run_id']
[?2004l[?2004h>         runner_ups = [c['run_id'] for c in candidates[1:]]
[?2004l[?2004h>         runner_ups.sort() # List others
[?2004l[?2004h>         
[?2004l[?2004h>         q5_output.append({
[?2004l[?2004h>             "board_family": family,
[?2004l[?2004h>             "best_run_id": best_run,
[?2004l[?2004h>             "runner_up_run_ids": runner_ups
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> q5_output.sort(key=lambda x: x['board_family'])
[?2004l[?2004h> save_json(q5_output, 'q05.json')
[?2004l[?2004h> 
