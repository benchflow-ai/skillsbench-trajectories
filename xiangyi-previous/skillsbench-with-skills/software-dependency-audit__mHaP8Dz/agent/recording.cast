[85.104882, "i", "python3 << 'EOF'\nimport json\nimport csv\n\nwith open('/tmp/trivy_output.json') as f:\n    data = json.load(f)\n\nvulnerabilities = []\n\nfor result in data.get('Results', []):\n    vulns = result.get('Vulnerabilities', [])\n    for v in vulns:\n        severity = v.get('Severity', '')\n        if severity in ['HIGH', 'CRITICAL']:\n            # Get CVSS score - try different sources\n            cvss_score = 'N/A'\n            cvss_data = v.get('CVSS', {})\n            for source in ['nvd', 'ghsa', 'redhat']:\n                if source in cvss_data:\n                    score = cvss_data[source].get('V3Score')\n                    if score:\n                        cvss_score = str(score)\n                        break\n            \n            # Get fixed version\n            fixed_version = v.get('FixedVersion', 'N/A')\n            if not fixed_version:\n                fixed_version = 'N/A'\n            \n            # Get reference URL (first one)\n            refs = v.get('References', [])\n            url = refs[0] if refs else 'N/A'\n            \n            vuln_info = {\n                'Package': v.get('PkgName', ''),\n                'Version': v.get('InstalledVersion', ''),\n                'CVE_ID': v.get('VulnerabilityID', ''),\n                'Severity': severity,\n                'CVSS_Score': cvss_score,\n                'Fixed_Version': fixed_version,\n                'Title': v.get('Title', ''),\n                'Url': url\n            }\n            vulnerabilities.append(vuln_info)\n            print(f\"Found: {vuln_info['CVE_ID']} - {vuln_info['Package']} ({severity})\")\n\nprint(f\"\\nTotal HIGH/CRITICAL vulnerabilities: {len(vulnerabilities)}\")\n\n# Write to CSV\nwith open('/root/security_audit.csv', 'w', newline='') as csvfile:\n    fieldnames = ['Package', 'Version', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    writer.writeheader()\n    for vuln in vulnerabilities:\n        writer.writerow(vuln)\n\nprint(f\"\\nCSV written to /root/security_audit.csv\")\nEOF\n"]
