[?2004hroot@e0c4d1bb8cf0:~# python3 << 'SCRIPT'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('test - demand.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Create SUT Calc sheet
[?2004l[?2004h> if 'SUT Calc' in wb.sheetnames:
[?2004l[?2004h>     del wb['SUT Calc']
[?2004l[?2004h> ws_sut = wb.create_sheet('SUT Calc')
[?2004l[?2004h> 
[?2004l[?2004h> print("Creating SUT Calc sheet...")
[?2004l[?2004h> 
[?2004l[?2004h> # Headers
[?2004l[?2004h> ws_sut['A1'] = 'Item'
[?2004l[?2004h> ws_sut['B1'] = 'Description'
[?2004l[?2004h> ws_sut['C1'] = 'Total Supply'
[?2004l[?2004h> ws_sut['D1'] = 'Total Imports'
[?2004l[?2004h> ws_sut['E1'] = 'Domestic Production'
[?2004l[?2004h> ws_sut['F1'] = 'Total Use'
[?2004l[?2004h> ws_sut['G1'] = 'GFCF (Investment)'
[?2004l[?2004h> ws_sut['H1'] = 'Import Content of Investment'
[?2004l[?2004h> 
[?2004l[?2004h> # Row labels
[?2004l[?2004h> ws_sut['A2'] = 'Construction'
[?2004l[?2004h> ws_sut['B2'] = 'Construction products'
[?2004l[?2004h> ws_sut['A3'] = 'Machinery'
[?2004l[?2004h> ws_sut['B3'] = 'Machinery and equipment'
[?2004l[?2004h> ws_sut['A4'] = 'Other'
[?2004l[?2004h> ws_sut['B4'] = 'Other investment goods'
[?2004l[?2004h> 
[?2004l[?2004h> # Link to SUPPLY sheet - Total Supply (sum of domestic production + imports)
[?2004l[?2004h> # For construction (assume row 30 in SUPPLY)
[?2004l[?2004h> ws_sut['C2'] = '=SUM(SUPPLY!C30:AN30)'
[?2004l[?2004h> ws_sut['D2'] = '=SUPPLY!B30'
[?2004l[?2004h> ws_sut['E2'] = '=C2-D2'
[?2004l[?2004h> 
[?2004l[?2004h> # For machinery (assume row 25 in SUPPLY)
[?2004l[?2004h> ws_sut['C3'] = '=SUM(SUPPLY!C25:AN25)'
[?2004l[?2004h> ws_sut['D3'] = '=SUPPLY!B25'
[?2004l[?2004h> ws_sut['E3'] = '=C3-D3'
[?2004l[?2004h> 
[?2004l[?2004h> # For other (assume row 20 in SUPPLY)
[?2004l[?2004h> ws_sut['C4'] = '=SUM(SUPPLY!C20:AN20)'
[?2004l[?2004h> ws_sut['D4'] = '=SUPPLY!B20'
[?2004l[?2004h> ws_sut['E4'] = '=C4-D4'
[?2004l[?2004h> 
[?2004l[?2004h> # Link to USE sheet - GFCF column (column AO = 41)
[?2004l[?2004h> ws_sut['F2'] = '=USE!AO30'
[?2004l[?2004h> ws_sut['G2'] = '=USE!AO30'
[?2004l[?2004h> ws_sut['F3'] = '=USE!AO25'
[?2004l[?2004h> ws_sut['G3'] = '=USE!AO25'
[?2004l[?2004h> ws_sut['F4'] = '=USE!AO20'
[?2004l[?2004h> ws_sut['G4'] = '=USE!AO20'
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate import content for each category
[?2004l[?2004h> ws_sut['H2'] = '=D2/C2'
[?2004l[?2004h> ws_sut['H3'] = '=D3/C3'
[?2004l[?2004h> ws_sut['H4'] = '=D4/C4'
[?2004l[?2004h> 
[?2004l[?2004h> # Summary rows
[?2004l[?2004h> ws_sut['A6'] = 'Total'
[?2004l[?2004h> ws_sut['C6'] = '=SUM(C2:C4)'
[?2004l[?2004h> ws_sut['D6'] = '=SUM(D2:D4)'
[?2004l[?2004h> ws_sut['E6'] = '=SUM(E2:E4)'
[?2004l[?2004h> ws_sut['F6'] = '=SUM(F2:F4)'
[?2004l[?2004h> ws_sut['G6'] = '=SUM(G2:G4)'
[?2004l[?2004h> ws_sut['H6'] = '=D6/C6'
[?2004l[?2004h> 
[?2004l[?2004h> # Weighted average import content share
[?2004l[?2004h> ws_sut['A46'] = 'Estimated Import Content Share'
[?2004l[?2004h> ws_sut['C46'] = '=SUMPRODUCT(G2:G4,H2:H4)/SUM(G2:G4)'
[?2004l[?2004h> 
[?2004l[?2004h> print("SUT Calc sheet created with formulas")
[?2004l[?2004h> wb.save('test - demand.xlsx')
[?2004l[?2004h> print("SUT Calc sheet completed")
[?2004l[?2004h> SCRIPT
[?2004lCreating SUT Calc sheet...
SUT Calc sheet created with formulas
SUT Calc sheet completed
[?2004hroot@e0c4d1bb8cf0:~# python3 << 'SCRIPT'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> print("Updating NA sheet - Scenario 1...")
[?2004l[?2004h> 
[?2004l[?2004h> # Link Real GDP from WEO_Data (column C in NA = column B in WEO_Data)
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3  # Row 3 for 2020, etc.
[?2004l[?2004h>     weo_row = year - 2020 + 2  # WEO starts at row 2
[?2004l[?2004h>     ws_na[f'C{row}'] = f'=WEO_Data!B{weo_row}'
[?2004l[?2004h>     ws_na[f'J{row}'] = f'=WEO_Data!E{weo_row}'
[?2004l[?2004h> 
[?2004l[?2004h> print("Linked Real GDP and Baseline Growth from WEO_Data")
[?2004l[?2004h> 
[?2004l[?2004h> # Assumptions section
[?2004l[?2004h> ws_na['D30'] = 6.5  # Total investment in billion USD
[?2004l[?2004h> ws_na['D31'] = '="SUT Calc"!C46'  # Import content share from SUT Calc
[?2004l[?2004h> ws_na['D32'] = 0.8  # Demand multiplier
[?2004l[?2004h> ws_na['D33'] = 'Bell shape'  # Project allocation
[?2004l[?2004h> 
[?2004l[?2004h> # Exchange rate (using cell reference for flexibility)
[?2004l[?2004h> ws_na['C29'] = 'Exchange rate (Lari/USD)'
[?2004l[?2004h> ws_na['D29'] = 2.746
[?2004l[?2004h> 
[?2004l[?2004h> print("Added assumptions")
[?2004l[?2004h> 
[?2004l[?2004h> # Project allocation - bell shape over 8 years (2026-2033)
[?2004l[?2004h> # Bell shape: lower at start/end, higher in middle
[?2004l[?2004h> bell_allocation = [0.05, 0.10, 0.20, 0.30, 0.20, 0.10, 0.04, 0.01]  # Sums to 1.0
[?2004l[?2004h> 
[?2004l[?2004h> for i, year in enumerate(range(2026, 2034)):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'D{row}'] = bell_allocation[i]
[?2004l[?2004h> 
[?2004l[?2004h> # For other years, allocation is 0
[?2004l[?2004h> for year in list(range(2020, 2026)) + list(range(2034, 2043)):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'D{row}'] = 0
[?2004l[?2004h> 
[?2004l[?2004h> print("Added bell-shaped project allocation")
[?2004l[?2004h> 
[?2004l[?2004h> # Project Investment in billion Lari = allocation * total investment * exchange rate
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'E{row}'] = f'=D{row}*$D$30*$D$29'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added project investment formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Imports = Project Investment * import content share
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'F{row}'] = f'=E{row}*$D$31'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added imports formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # GDP impact (I-M) = (Project Investment - Imports) * Multiplier
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'G{row}'] = f'=(E{row}-F{row})*$D$32'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added GDP impact formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # % of GDP
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'I{row}'] = f'=G{row}/C{row}*100'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added % of GDP formulas")
[?2004l[?2004h> 
[?2004l[?2004h> # Projected Growth = Baseline Growth + % of GDP
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = year - 2020 + 3
[?2004l[?2004h>     ws_na[f'K{row}'] = f'=J{row}+I{row}'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added projected growth formulas")
[?2004l[?2004h> 
[?2004l[?2004h> wb.save('test - demand.xlsx')
[?2004l[?2004h> print("Scenario 1 completed")
[?2004l[?2004h> SCRIPT
[?2004lUpdating NA sheet - Scenario 1...
Linked Real GDP and Baseline Growth from WEO_Data
Added assumptions
Added bell-shaped project allocation
Added project investment formulas
Added imports formulas
Added GDP impact formulas
Added % of GDP formulas
Added projected growth formulas
Scenario 1 completed
[?2004hroot@e0c4d1bb8cf0:~# python3 << 'SCRIPT'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('test - demand.xlsx')
[?2004l[?2004h> ws_na = wb['NA']
[?2004l[?2004h> 
[?2004l[?2004h> print("Creating Scenario 2 (Demand Multiplier = 1.0)...")
[?2004l[?2004h> 
[?2004l[?2004h> # Scenario 2 starts at row 50
[?2004l[?2004h> start_row_s2 = 50
[?2004l[?2004h> 
[?2004l[?2004h> # Headers for Scenario 2
[?2004l[?2004h> ws_na[f'A{start_row_s2}'] = 'SCENARIO 2: Demand Multiplier = 1.0'
[?2004l[?2004h> ws_na[f'B{start_row_s2+1}'] = 'Year'
[?2004l[?2004h> ws_na[f'C{start_row_s2+1}'] = 'Real GDP'
[?2004l[?2004h> ws_na[f'D{start_row_s2+1}'] = 'Project Allocation (%)'
[?2004l[?2004h> ws_na[f'E{start_row_s2+1}'] = 'Project Investment'
[?2004l[?2004h> ws_na[f'F{start_row_s2+1}'] = 'Imports'
[?2004l[?2004h> ws_na[f'G{start_row_s2+1}'] = 'GDP impact'
[?2004l[?2004h> ws_na[f'H{start_row_s2+1}'] = 'Multiplier'
[?2004l[?2004h> ws_na[f'I{start_row_s2+1}'] = '% of GDP'
[?2004l[?2004h> ws_na[f'J{start_row_s2+1}'] = 'Baseline GDP Growth'
[?2004l[?2004h> ws_na[f'K{start_row_s2+1}'] = 'Projected Growth'
[?2004l[?2004h> 
[?2004l[?2004h> ws_na[f'G{start_row_s2+2}'] = 'I-M'
[?2004l[?2004h> 
[?2004l[?2004h> # Years
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = start_row_s2 + 3 + (year - 2020)
[?2004l[?2004h>     ws_na[f'B{row}'] = year
[?2004l[?2004h> 
[?2004l[?2004h> # Link Real GDP and Baseline Growth from WEO_Data
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = start_row_s2 + 3 + (year - 2020)
[?2004l[?2004h>     weo_row = year - 2020 + 2
[?2004l[?2004h>     ws_na[f'C{row}'] = f'=WEO_Data!B{weo_row}'
[?2004l[?2004h>     ws_na[f'J{row}'] = f'=WEO_Data!E{weo_row}'
[?2004l[?2004h> 
[?2004l[?2004h> # Assumptions for Scenario 2
[?2004l[?2004h> assump_row_s2 = start_row_s2 + 28
[?2004l[?2004h> ws_na[f'C{assump_row_s2}'] = 'Assumptions'
[?2004l[?2004h> ws_na[f'C{assump_row_s2+1}'] = 'Exchange rate (Lari/USD)'
[?2004l[?2004h> ws_na[f'D{assump_row_s2+1}'] = 2.746
[?2004l[?2004h> ws_na[f'C{assump_row_s2+2}'] = 'total investment'
[?2004l[?2004h> ws_na[f'D{assump_row_s2+2}'] = 6.5
[?2004l[?2004h> ws_na[f'C{assump_row_s2+3}'] = 'import content share'
[?2004l[?2004h> ws_na[f'D{assump_row_s2+3}'] = '="SUT Calc"!C46'
[?2004l[?2004h> ws_na[f'C{assump_row_s2+4}'] = 'demand multiplier'
[?2004l[?2004h> ws_na[f'D{assump_row_s2+4}'] = 1.0  # Changed from 0.8
[?2004l[?2004h> ws_na[f'C{assump_row_s2+5}'] = 'Project allocation'
[?2004l[?2004h> ws_na[f'D{assump_row_s2+5}'] = 'Bell shape'
[?2004l[?2004h> 
[?2004l[?2004h> # Project allocation - same bell shape
[?2004l[?2004h> bell_allocation = [0.05, 0.10, 0.20, 0.30, 0.20, 0.10, 0.04, 0.01]
[?2004l[?2004h> for i, year in enumerate(range(2026, 2034)):
[?2004l[?2004h>     row = start_row_s2 + 3 + (year - 2020)
[?2004l[?2004h>     ws_na[f'D{row}'] = bell_allocation[i]
[?2004l[?2004h> 
[?2004l[?2004h> for year in list(range(2020, 2026)) + list(range(2034, 2043)):
[?2004l[?2004h>     row = start_row_s2 + 3 + (year - 2020)
[?2004l[?2004h>     ws_na[f'D{row}'] = 0
[?2004l[?2004h> 
[?2004l[?2004h> # Formulas for Scenario 2
[?2004l[?2004h> for year in range(2020, 2043):
[?2004l[?2004h>     row = start_row_s2 + 3 + (year - 2020)
[?2004l[?2004h>     ws_na[f'E{row}'] = f'=D{row}*$D${assump_row_s2+2}*$D${assump_row_s2+1}'
[?2004l[?2004h>     ws_na[f'F{row}'] = f'=E{row}*$D${assump_row_s2+3}'
[?2004l[?2004h>     ws_na[f'G{row}'] = f'=(E{row}-F{row})*$D${assump_row_s2+4}'
[?2004l[?2004h>     ws_na[f'I{row}'] = f'=G{row}/C{row}*100'
