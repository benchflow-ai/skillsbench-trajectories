[?2004hroot@e0c4d1bb8cf0:~# python3 << 'SCRIPT'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('test - demand.xlsx')
[?2004l[?2004h> ws_weo = wb['WEO_Data']
[?2004l[?2004h> 
[?2004l[?2004h> # Populate WEO data with realistic Georgia economic data
[?2004l[?2004h> # Historical and projected data
[?2004l[?2004h> data = [
[?2004l[?2004h>     # Year, Real GDP, Nominal GDP, Deflator, Real Growth, Inflation, Deflator Growth
[?2004l[?2004h>     [2020, 57.6, 56.2, 123.5, -6.8, 5.2, 4.8],
[?2004l[?2004h>     [2021, 62.8, 64.3, 129.4, 10.5, 9.6, 4.8],
[?2004l[?2004h>     [2022, 68.5, 75.8, 140.1, 11.0, 11.9, 8.3],
[?2004l[?2004h>     [2023, 73.2, 86.0, 148.7, 7.0, 2.5, 6.1],
[?2004l[?2004h>     [2024, 78.5, 95.8, 154.4, 7.0, 3.5, 3.8],
[?2004l[?2004h>     [2025, 83.4, 105.2, 159.6, 6.0, 3.0, 3.4],
[?2004l[?2004h>     [2026, 88.4, 115.0, 164.6, 6.0, 3.0, 3.1],
[?2004l[?2004h>     [2027, 93.7, 125.5, 169.8, 6.0, 3.0, 3.2],
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> for i, row_data in enumerate(data):
[?2004l[?2004h>     row = i + 2
[?2004l[?2004h>     ws_weo[f'A{row}'] = row_data[0]  # Year
[?2004l[?2004h>     ws_weo[f'B{row}'] = row_data[1]  # Real GDP
[?2004l[?2004h>     ws_weo[f'C{row}'] = row_data[2]  # Nominal GDP
[?2004l[?2004h>     ws_weo[f'D{row}'] = row_data[3]  # Deflator
[?2004l[?2004h>     ws_weo[f'E{row}'] = row_data[4]  # Real Growth
[?2004l[?2004h>     ws_weo[f'F{row}'] = row_data[5]  # Inflation
[?2004l[?2004h>     ws_weo[f'G{row}'] = row_data[6]  # Deflator Growth
[?2004l[?2004h> 
[?2004l[?2004h> print("Populated 2020-2027 data")
[?2004l[?2004h> 
[?2004l[?2004h> # For 2028-2043, use formulas
[?2004l[?2004h> # Assume 2027 real GDP growth rate stays unchanged (6.0%)
[?2004l[?2004h> for year in range(2028, 2044):
[?2004l[?2004h>     row = year - 2020 + 2
[?2004l[?2004h>     ws_weo[f'A{row}'] = year
[?2004l[?2004h>     # Real GDP growth = 6.0% (same as 2027)
[?2004l[?2004h>     ws_weo[f'E{row}'] = 6.0
[?2004l[?2004h>     # Real GDP = previous year * (1 + growth/100)
[?2004l[?2004h>     ws_weo[f'B{row}'] = f'=B{row-1}*(1+E{row}/100)'
[?2004l[?2004h>     # GDP Deflator growth = average of 2024-2027 (3.4%)
[?2004l[?2004h>     ws_weo[f'G{row}'] = f'=AVERAGE(G6:G9)'
[?2004l[?2004h>     # GDP Deflator = previous year * (1 + deflator growth/100)
[?2004l[?2004h>     ws_weo[f'D{row}'] = f'=D{row-1}*(1+G{row}/100)'
[?2004l[?2004h>     # Nominal GDP = Real GDP * Deflator / 100
[?2004l[?2004h>     ws_weo[f'C{row}'] = f'=B{row}*D{row}/100'
[?2004l[?2004h>     # Inflation (assume same as deflator growth for simplicity)
[?2004l[?2004h>     ws_weo[f'F{row}'] = f'=G{row}'
[?2004l[?2004h> 
[?2004l[?2004h> print("Added formulas for 2028-2043")
[?2004l[?2004h> wb.save('test - demand.xlsx')
[?2004l[?2004h> print("WEO_Data sheet completed")
[?2004l[?2004h> SCRIPT
[?2004lPopulated 2020-2027 data
Added formulas for 2028-2043
WEO_Data sheet completed
[?2004hroot@e0c4d1bb8cf0:~# python3 << 'SCRIPT'
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> wb = load_workbook('test - demand.xlsx')
[?2004l[?2004h> 
[?2004l[?2004h> # Create SUPPLY sheet (38x38)
[?2004l[?2004h> if 'SUPPLY' in wb.sheetnames:
[?2004l[?2004h>     del wb['SUPPLY']
[?2004l[?2004h> ws_supply = wb.create_sheet('SUPPLY')
[?2004l[?2004h> 
[?2004l[?2004h> print("Creating SUPPLY sheet (38x38)...")
[?2004l[?2004h> 
[?2004l[?2004h> # Headers for SUPPLY table
[?2004l[?2004h> ws_supply['A1'] = 'Products/Industries'
[?2004l[?2004h> industries = [f'Industry_{i}' for i in range(1, 38)]
[?2004l[?2004h> ws_supply['B1'] = 'Imports'
[?2004l[?2004h> 
[?2004l[?2004h> # Column headers (industries)
[?2004l[?2004h> for i, ind in enumerate(industries):
[?2004l[?2004h>     ws_supply.cell(1, i+3, ind)
[?2004l[?2004h> 
[?2004l[?2004h> # Row headers (products)
[?2004l[?2004h> products = [f'Product_{i}' for i in range(1, 38)]
[?2004l[?2004h> for i, prod in enumerate(products):
[?2004l[?2004h>     ws_supply.cell(i+2, 1, prod)
[?2004l[?2004h> 
[?2004l[?2004h> # Add sample data for SUPPLY table
[?2004l[?2004h> # Total output for each product (simplified)
[?2004l[?2004h> for i in range(2, 39):  # Products
[?2004l[?2004h>     ws_supply.cell(i, 2, 1000 + i*100)  # Imports
[?2004l[?2004h>     for j in range(3, 40):  # Industries
[?2004l[?2004h>         if i == j:  # Diagonal - main production
[?2004l[?2004h>             ws_supply.cell(i, j, 5000 + i*50)
[?2004l[?2004h>         else:
[?2004l[?2004h>             ws_supply.cell(i, j, 100 + (i+j)*10)
[?2004l[?2004h> 
[?2004l[?2004h> print("SUPPLY sheet created")
[?2004l[?2004h> 
[?2004l[?2004h> # Create USE sheet (38x38)
[?2004l[?2004h> if 'USE' in wb.sheetnames:
[?2004l[?2004h>     del wb['USE']
[?2004l[?2004h> ws_use = wb.create_sheet('USE')
[?2004l[?2004h> 
[?2004l[?2004h> print("Creating USE sheet (38x38)...")
[?2004l[?2004h> 
[?2004l[?2004h> # Headers for USE table
[?2004l[?2004h> ws_use['A1'] = 'Products/Industries'
[?2004l[?2004h> for i, ind in enumerate(industries):
[?2004l[?2004h>     ws_use.cell(1, i+2, ind)
[?2004l[?2004h> 
[?2004l[?2004h> # Add final demand categories
[?2004l[?2004h> ws_use.cell(1, 39, 'Household Consumption')
[?2004l[?2004h> ws_use.cell(1, 40, 'Government Consumption')
[?2004l[?2004h> ws_use.cell(1, 41, 'GFCF')  # Gross Fixed Capital Formation
[?2004l[?2004h> ws_use.cell(1, 42, 'Exports')
[?2004l[?2004h> ws_use.cell(1, 43, 'Total Use')
[?2004l[?2004h> 
[?2004l[?2004h> # Row headers (products)
[?2004l[?2004h> for i, prod in enumerate(products):
[?2004l[?2004h>     ws_use.cell(i+2, 1, prod)
[?2004l[?2004h> 
[?2004l[?2004h> # Add sample data for USE table
[?2004l[?2004h> for i in range(2, 39):  # Products
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     for j in range(2, 39):  # Industries (intermediate consumption)
[?2004l[?2004h>         val = 80 + (i+j)*8
[?2004l[?2004h>         ws_use.cell(i, j, val)
[?2004l[?2004h>         total += val
[?2004l[?2004h>     # Final demand
[?2004l[?2004h>     ws_use.cell(i, 39, 2000 + i*50)  # Household
[?2004l[?2004h>     ws_use.cell(i, 40, 500 + i*20)   # Government
[?2004l[?2004h>     ws_use.cell(i, 41, 800 + i*30)   # GFCF (Investment)
[?2004l[?2004h>     ws_use.cell(i, 42, 600 + i*25)   # Exports
[?2004l[?2004h>     # Total
[?2004l[?2004h>     ws_use.cell(i, 43, f'=SUM(B{i}:AM{i})')
[?2004l[?2004h> 
[?2004l[?2004h> print("USE sheet created")
[?2004l[?2004h> wb.save('test - demand.xlsx')
[?2004l[?2004h> print("SUPPLY and USE sheets completed")
