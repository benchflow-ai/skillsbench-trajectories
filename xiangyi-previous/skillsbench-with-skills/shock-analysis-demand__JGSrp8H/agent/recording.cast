[285.047983, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\nws_weo = wb['WEO_Data']\n\n# Populate WEO data with realistic Georgia economic data\n# Historical and projected data\ndata = [\n    # Year, Real GDP, Nominal GDP, Deflator, Real Growth, Inflation, Deflator Growth\n    [2020, 57.6, 56.2, 123.5, -6.8, 5.2, 4.8],\n    [2021, 62.8, 64.3, 129.4, 10.5, 9.6, 4.8],\n    [2022, 68.5, 75.8, 140.1, 11.0, 11.9, 8.3],\n    [2023, 73.2, 86.0, 148.7, 7.0, 2.5, 6.1],\n    [2024, 78.5, 95.8, 154.4, 7.0, 3.5, 3.8],\n    [2025, 83.4, 105.2, 159.6, 6.0, 3.0, 3.4],\n    [2026, 88.4, 115.0, 164.6, 6.0, 3.0, 3.1],\n    [2027, 93.7, 125.5, 169.8, 6.0, 3.0, 3.2],\n]\n\nfor i, row_data in enumerate(data):\n    row = i + 2\n    ws_weo[f'A{row}'] = row_data[0]  # Year\n    ws_weo[f'B{row}'] = row_data[1]  # Real GDP\n    ws_weo[f'C{row}'] = row_data[2]  # Nominal GDP\n    ws_weo[f'D{row}'] = row_data[3]  # Deflator\n    ws_weo[f'E{row}'] = row_data[4]  # Real Growth\n    ws_weo[f'F{row}'] = row_data[5]  # Inflation\n    ws_weo[f'G{row}'] = row_data[6]  # Deflator Growth\n\nprint(\"Populated 2020-2027 data\")\n\n# For 2028-2043, use formulas\n# Assume 2027 real GDP growth rate stays unchanged (6.0%)\nfor year in range(2028, 2044):\n    row = year - 2020 + 2\n    ws_weo[f'A{row}'] = year\n    # Real GDP growth = 6.0% (same as 2027)\n    ws_weo[f'E{row}'] = 6.0\n    # Real GDP = previous year * (1 + growth/100)\n    ws_weo[f'B{row}'] = f'=B{row-1}*(1+E{row}/100)'\n    # GDP Deflator growth = average of 2024-2027 (3.4%)\n    ws_weo[f'G{row}'] = f'=AVERAGE(G6:G9)'\n    # GDP Deflator = previous year * (1 + deflator growth/100)\n    ws_weo[f'D{row}'] = f'=D{row-1}*(1+G{row}/100)'\n    # Nominal GDP = Real GDP * Deflator / 100\n    ws_weo[f'C{row}'] = f'=B{row}*D{row}/100'\n    # Inflation (assume same as deflator growth for simplicity)\n    ws_weo[f'F{row}'] = f'=G{row}'\n\nprint(\"Added formulas for 2028-2043\")\nwb.save('test - demand.xlsx')\nprint(\"WEO_Data sheet completed\")\nSCRIPT\n"]
