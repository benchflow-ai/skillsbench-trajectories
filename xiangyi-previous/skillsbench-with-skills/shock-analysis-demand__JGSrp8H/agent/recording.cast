[455.301788, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\nws_na = wb['NA']\n\n# Unmerge any merged cells first\nif ws_na.merged_cells:\n    for merged_range in list(ws_na.merged_cells):\n        ws_na.unmerge_cells(str(merged_range))\n    print(\"Unmerged cells\")\n\n# Now add header for Scenario 1\nws_na.insert_rows(1)\nws_na['A1'] = 'SCENARIO 1: Base Case (Multiplier=0.8, Import Content from SUT)'\n\nprint(\"Added Scenario 1 header\")\n\nwb.save('test - demand.xlsx')\nprint(\"Saved successfully\")\n\n# Verify the workbook structure\nprint(\"\\n=== Workbook Structure ===\")\nprint(f\"Sheet names: {wb.sheetnames}\")\n\nfor sheet_name in wb.sheetnames:\n    ws = wb[sheet_name]\n    print(f\"\\n{sheet_name}: {ws.max_row} rows x {ws.max_column} columns\")\n\nprint(\"\\n=== Task Complete ===\")\nprint(\"File: test - demand.xlsx\")\nprint(\"\\nSheets created:\")\nprint(\"  1. WEO_Data - Georgia economic data with formulas\")\nprint(\"  2. SUPPLY - 38x38 supply table\")\nprint(\"  3. USE - 38x38 use table\")\nprint(\"  4. SUT Calc - Import content calculation\")\nprint(\"  5. NA - Three scenarios with all formulas\")\nSCRIPT\n"]
