[389.700325, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\nws_na = wb['NA']\n\nprint(\"Creating Scenario 2 (Demand Multiplier = 1.0)...\")\n\n# Scenario 2 starts at row 50\nstart_row_s2 = 50\n\n# Headers for Scenario 2\nws_na[f'A{start_row_s2}'] = 'SCENARIO 2: Demand Multiplier = 1.0'\nws_na[f'B{start_row_s2+1}'] = 'Year'\nws_na[f'C{start_row_s2+1}'] = 'Real GDP'\nws_na[f'D{start_row_s2+1}'] = 'Project Allocation (%)'\nws_na[f'E{start_row_s2+1}'] = 'Project Investment'\nws_na[f'F{start_row_s2+1}'] = 'Imports'\nws_na[f'G{start_row_s2+1}'] = 'GDP impact'\nws_na[f'H{start_row_s2+1}'] = 'Multiplier'\nws_na[f'I{start_row_s2+1}'] = '% of GDP'\nws_na[f'J{start_row_s2+1}'] = 'Baseline GDP Growth'\nws_na[f'K{start_row_s2+1}'] = 'Projected Growth'\n\nws_na[f'G{start_row_s2+2}'] = 'I-M'\n\n# Years\nfor year in range(2020, 2043):\n    row = start_row_s2 + 3 + (year - 2020)\n    ws_na[f'B{row}'] = year\n\n# Link Real GDP and Baseline Growth from WEO_Data\nfor year in range(2020, 2043):\n    row = start_row_s2 + 3 + (year - 2020)\n    weo_row = year - 2020 + 2\n    ws_na[f'C{row}'] = f'=WEO_Data!B{weo_row}'\n    ws_na[f'J{row}'] = f'=WEO_Data!E{weo_row}'\n\n# Assumptions for Scenario 2\nassump_row_s2 = start_row_s2 + 28\nws_na[f'C{assump_row_s2}'] = 'Assumptions'\nws_na[f'C{assump_row_s2+1}'] = 'Exchange rate (Lari/USD)'\nws_na[f'D{assump_row_s2+1}'] = 2.746\nws_na[f'C{assump_row_s2+2}'] = 'total investment'\nws_na[f'D{assump_row_s2+2}'] = 6.5\nws_na[f'C{assump_row_s2+3}'] = 'import content share'\nws_na[f'D{assump_row_s2+3}'] = '=\"SUT Calc\"!C46'\nws_na[f'C{assump_row_s2+4}'] = 'demand multiplier'\nws_na[f'D{assump_row_s2+4}'] = 1.0  # Changed from 0.8\nws_na[f'C{assump_row_s2+5}'] = 'Project allocation'\nws_na[f'D{assump_row_s2+5}'] = 'Bell shape'\n\n# Project allocation - same bell shape\nbell_allocation = [0.05, 0.10, 0.20, 0.30, 0.20, 0.10, 0.04, 0.01]\nfor i, year in enumerate(range(2026, 2034)):\n    row = start_row_s2 + 3 + (year - 2020)\n    ws_na[f'D{row}'] = bell_allocation[i]\n\nfor year in list(range(2020, 2026)) + list(range(2034, 2043)):\n    row = start_row_s2 + 3 + (year - 2020)\n    ws_na[f'D{row}'] = 0\n\n# Formulas for Scenario 2\nfor year in range(2020, 2043):\n    row = start_row_s2 + 3 + (year - 2020)\n    ws_na[f'E{row}'] = f'=D{row}*$D${assump_row_s2+2}*$D${assump_row_s2+1}'\n    ws_na[f'F{row}'] = f'=E{row}*$D${assump_row_s2+3}'\n    ws_na[f'G{row}'] = f'=(E{row}-F{row})*$D${assump_row_s2+4}'\n    ws_na[f'I{row}'] = f'=G{row}/C{row}*100'\n    ws_na[f'K{row}'] = f'=J{row}+I{row}'\n\nprint(\"Scenario 2 created\")\n\n# Scenario 3 starts at row 100\nstart_row_s3 = 100\n\n# Headers for Scenario 3\nws_na[f'A{start_row_s3}'] = 'SCENARIO 3: Import Content Share = 0.5'\nws_na[f'B{start_row_s3+1}'] = 'Year'\nws_na[f'C{start_row_s3+1}'] = 'Real GDP'\nws_na[f'D{start_row_s3+1}'] = 'Project Allocation (%)'\nws_na[f'E{start_row_s3+1}'] = 'Project Investment'\nws_na[f'F{start_row_s3+1}'] = 'Imports'\nws_na[f'G{start_row_s3+1}'] = 'GDP impact'\nws_na[f'H{start_row_s3+1}'] = 'Multiplier'\nws_na[f'I{start_row_s3+1}'] = '% of GDP'\nws_na[f'J{start_row_s3+1}'] = 'Baseline GDP Growth'\nws_na[f'K{start_row_s3+1}'] = 'Projected Growth'\n\nws_na[f'G{start_row_s3+2}'] = 'I-M'\n\nprint(\"Creating Scenario 3 (Import Content Share = 0.5)...\")\n\n# Years\nfor year in range(2020, 2043):\n    row = start_row_s3 + 3 + (year - 2020)\n    ws_na[f'B{row}'] = year\n\n# Link Real GDP and Baseline Growth\nfor year in range(2020, 2043):\n    row = start_row_s3 + 3 + (year - 2020)\n    weo_row = year - 2020 + 2\n    ws_na[f'C{row}'] = f'=WEO_Data!B{weo_row}'\n    ws_na[f'J{row}'] = f'=WEO_Data!E{weo_row}'\n\n# Assumptions for Scenario 3\nassump_row_s3 = start_row_s3 + 28\nws_na[f'C{assump_row_s3}'] = 'Assumptions'\nws_na[f'C{assump_row_s3+1}'] = 'Exchange rate (Lari/USD)'\nws_na[f'D{assump_row_s3+1}'] = 2.746\nws_na[f'C{assump_row_s3+2}'] = 'total investment'\nws_na[f'D{assump_row_s3+2}'] = 6.5\nws_na[f'C{assump_row_s3+3}'] = 'import content share'\nws_na[f'D{assump_row_s3+3}'] = 0.5  # Changed from SUT Calc link\nws_na[f'C{assump_row_s3+4}'] = 'demand multiplier'\nws_na[f'D{assump_row_s3+4}'] = 0.8\nws_na[f'C"]
[389.700386, "i", "{assump_row_s3+5}'] = 'Project allocation'\nws_na[f'D{assump_row_s3+5}'] = 'Bell shape'\n\n# Project allocation - same bell shape\nfor i, year in enumerate(range(2026, 2034)):\n    row = start_row_s3 + 3 + (year - 2020)\n    ws_na[f'D{row}'] = bell_allocation[i]\n\nfor year in list(range(2020, 2026)) + list(range(2034, 2043)):\n    row = start_row_s3 + 3 + (year - 2020)\n    ws_na[f'D{row}'] = 0\n\n# Formulas for Scenario 3\nfor year in range(2020, 2043):\n    row = start_row_s3 + 3 + (year - 2020)\n    ws_na[f'E{row}'] = f'=D{row}*$D${assump_row_s3+2}*$D${assump_row_s3+1}'\n    ws_na[f'F{row}'] = f'=E{row}*$D${assump_row_s3+3}'\n    ws_na[f'G{row}'] = f'=(E{row}-F{row})*$D${assump_row_s3+4}'\n    ws_na[f'I{row}'] = f'=G{row}/C{row}*100'\n    ws_na[f'K{row}'] = f'=J{row}+I{row}'\n\nprint(\"Scenario 3 created\")\n\nwb.save('test - demand.xlsx')\nprint(\"All three scenarios completed!\")\nSCRIPT\n"]
