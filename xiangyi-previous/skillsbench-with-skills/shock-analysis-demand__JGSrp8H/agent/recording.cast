[307.341989, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[307.342498, "o", "> SCRIPT\r\n\u001b[?2004l\r"]
[308.081808, "o", "Creating SUPPLY sheet (38x38)...\r\n"]
[308.095816, "o", "SUPPLY sheet created\r\nCreating USE sheet (38x38)...\r\nUSE sheet created\r\n"]
[308.241683, "o", "SUPPLY and USE sheets completed\r\n"]
[308.30449, "o", "\u001b[?2004hroot@e0c4d1bb8cf0:~# "]
[329.608427, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\n\n# Create SUT Calc sheet\nif 'SUT Calc' in wb.sheetnames:\n    del wb['SUT Calc']\nws_sut = wb.create_sheet('SUT Calc')\n\nprint(\"Creating SUT Calc sheet...\")\n\n# Headers\nws_sut['A1'] = 'Item'\nws_sut['B1'] = 'Description'\nws_sut['C1'] = 'Total Supply'\nws_sut['D1'] = 'Total Imports'\nws_sut['E1'] = 'Domestic Production'\nws_sut['F1'] = 'Total Use'\nws_sut['G1'] = 'GFCF (Investment)'\nws_sut['H1'] = 'Import Content of Investment'\n\n# Row labels\nws_sut['A2'] = 'Construction'\nws_sut['B2'] = 'Construction products'\nws_sut['A3'] = 'Machinery'\nws_sut['B3'] = 'Machinery and equipment'\nws_sut['A4'] = 'Other'\nws_sut['B4'] = 'Other investment goods'\n\n# Link to SUPPLY sheet - Total Supply (sum of domestic production + imports)\n# For construction (assume row 30 in SUPPLY)\nws_sut['C2'] = '=SUM(SUPPLY!C30:AN30)'\nws_sut['D2'] = '=SUPPLY!B30'\nws_sut['E2'] = '=C2-D2'\n\n# For machinery (assume row 25 in SUPPLY)\nws_sut['C3'] = '=SUM(SUPPLY!C25:AN25)'\nws_sut['D3'] = '=SUPPLY!B25'\nws_sut['E3'] = '=C3-D3'\n\n# For other (assume row 20 in SUPPLY)\nws_sut['C4'] = '=SUM(SUPPLY!C20:AN20)'\nws_sut['D4'] = '=SUPPLY!B20'\nws_sut['E4'] = '=C4-D4'\n\n# Link to USE sheet - GFCF column (column AO = 41)\nws_sut['F2'] = '=USE!AO30'\nws_sut['G2'] = '=USE!AO30'\nws_sut['F3'] = '=USE!AO25'\nws_sut['G3'] = '=USE!AO25'\nws_sut['F4'] = '=USE!AO20'\nws_sut['G4'] = '=USE!AO20'\n\n# Calculate import content for each category\nws_sut['H2'] = '=D2/C2'\nws_sut['H3'] = '=D3/C3'\nws_sut['H4'] = '=D4/C4'\n\n# Summary rows\nws_sut['A6'] = 'Total'\nws_sut['C6'] = '=SUM(C2:C4)'\nws_sut['D6'] = '=SUM(D2:D4)'\nws_sut['E6'] = '=SUM(E2:E4)'\nws_sut['F6'] = '=SUM(F2:F4)'\nws_sut['G6'] = '=SUM(G2:G4)'\nws_sut['H6'] = '=D6/C6'\n\n# Weighted average import content share\nws_sut['A46'] = 'Estimated Import Content Share'\nws_sut['C46'] = '=SUMPRODUCT(G2:G4,H2:H4)/SUM(G2:G4)'\n\nprint(\"SUT Calc sheet created with formulas\")\nwb.save('test - demand.xlsx')\nprint(\"SUT Calc sheet completed\")\nSCRIPT\n"]
[329.613078, "o", "python3 << 'SCRIPT'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb = load_workbook('test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create SUT Calc sheet\r\n\u001b[?2004l\r\u001b[?2004h> if 'SUT Calc' in wb.sheetnames:\r\n\u001b[?2004l\r\u001b[?2004h>     del wb['SUT Calc']\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut = wb.create_sheet('SUT Calc')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Creating SUT Calc sheet...\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Headers\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A1'] = 'Item'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B1'] = 'Description'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['C1'] = 'Total Supply'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['D1'] = 'Total Imports'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['E1'] = 'Domestic Production'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['F1'] = 'Total Use'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['G1'] = 'GFCF (Investment)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['H1'] = 'Import Content of Investment'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Row labels\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A2'] = 'Construction'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B2'] = 'Construction products'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A3'] = 'Machinery'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B3'] = 'Machinery and equipment'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['A4'] = 'Other'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['B4'] = 'Other investment goods'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Link to SUPPLY sheet - Total Supply (sum of domestic production + imports)\r\n\u001b[?2004l\r\u001b[?2004h> # For construction (assume row 30 in SUPPLY)"]
[329.613333, "o", "\r\n"]
[329.616496, "o", "\u001b[?2004l\r"]
[329.616663, "o", "\u001b[?2004h> ws_sut['C2'] = '=SUM(SUPPLY!C30:AN30)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.61678, "o", "ws_sut['D2'] = '=SUPPLY!B30'\r\n\u001b[?2004l\r\u001b[?2004h> ws_sut['E2'] = '=C2-D2'"]
[329.616875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.616973, "o", "# For machinery (assume row 25 in SUPPLY)\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.617066, "o", "> ws_sut['C3'] = '=SUM(SUPPLY!C25:AN25)'"]
[329.617153, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.617249, "o", "ws_sut['D3'] = '=SUPPLY!B25'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.617345, "o", "ws_sut['E3'] = '=C3-D3'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[329.617435, "o", "\u001b[?2004h> # For other (assume row 20 in SUPPLY)"]
[329.617524, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.617596, "o", "ws_sut['C4'] = '=SUM(SUPPLY!C20:AN20)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[329.61767, "o", "> ws_sut['D4'] = '=SUPPLY!B20'"]
[329.617742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[329.617813, "o", "ws_sut['E4'] = '=C4-D4'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[329.617877, "o", "\u001b[?2004h> "]
