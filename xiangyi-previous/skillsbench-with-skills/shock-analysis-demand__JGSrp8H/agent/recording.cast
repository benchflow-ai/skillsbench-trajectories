[37.309125, "i", "python3 << 'EOF'\nimport openpyxl\nwb = openpyxl.load_workbook('test - demand.xlsx')\nws = wb['NA']\nprint('NA Sheet Content (first 35 rows):')\nfor row in range(1, min(35, ws.max_row + 1)):\n    row_data = []\n    for col in range(1, min(12, ws.max_column + 1)):\n        cell = ws.cell(row, col)\n        val = cell.value\n        if val is not None:\n            row_data.append(f'{openpyxl.utils.get_column_letter(col)}{row}:{val}')\n    if row_data:\n        print(f'Row {row}: {row_data}')\nEOF\n"]
