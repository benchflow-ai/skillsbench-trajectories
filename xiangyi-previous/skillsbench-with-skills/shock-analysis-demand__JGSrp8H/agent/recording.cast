[191.437825, "i", "python3 << 'EOF'\nimport pandas as pd\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndf = pd.read_csv('weo.xls', sep='\\t', encoding='latin1', on_bad_lines='skip')\nprint(f\"WEO data shape: {df.shape}\")\nprint(f\"\\nColumns: {list(df.columns[:15])}\")\ngeorgia = df[df['Country'].str.contains('Georgia', case=False, na=False)]\nprint(f\"\\nGeorgia rows found: {len(georgia)}\")\nif len(georgia) > 0:\n    print(f\"\\nSubject Descriptors available:\")\n    for i, subj in enumerate(georgia['Subject Descriptor'].unique()[:20]):\n        print(f\"{i+1}. {subj}\")\nEOF\n"]
