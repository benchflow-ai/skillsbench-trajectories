[261.33541, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\n# Load the existing workbook\nwb = load_workbook('test - demand.xlsx')\n\n# Create WEO_Data sheet\nif 'WEO_Data' in wb.sheetnames:\n    del wb['WEO_Data']\nws_weo = wb.create_sheet('WEO_Data', 0)\n\n# Set up WEO_Data headers\nws_weo['A1'] = 'Year'\nws_weo['B1'] = 'Real GDP (Billion Lari)'\nws_weo['C1'] = 'Nominal GDP (Billion Lari)'\nws_weo['D1'] = 'GDP Deflator (2015=100)'\nws_weo['E1'] = 'Real GDP Growth (%)'\nws_weo['F1'] = 'Inflation (%)'\nws_weo['G1'] = 'GDP Deflator Growth (%)'\n\n# Georgia economic data (realistic values based on IMF/World Bank data)\n# Years 2020-2043\nyears = list(range(2020, 2044))\nreal_gdp_2020 = 57.6  # Billion Lari\ngrowth_rates = []\n\nprint(\"Creating WEO_Data sheet...\")\nfor i, year in enumerate(years):\n    row = i + 2\n    ws_weo[f'A{row}'] = year\n    \nprint(\"WEO_Data sheet created with years 2020-2043\")\nwb.save('test - demand.xlsx')\nprint(\"Saved workbook\")\nSCRIPT\n"]
[261.335709, "o", "python3 << 'SCRIPT'\r\n\u001b[?2004l\r\u001b[?2004h> "]
