[242.396024, "i", "python3 << 'EOF'\nimport pandas as pd\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndf = pd.read_csv('weo_data.tsv', sep='\\t', encoding='ISO-8859-1')\nprint(f\"Shape: {df.shape}\")\nprint(f\"Columns: {list(df.columns[:10])}\")\nif 'Country' in df.columns:\n    georgia = df[df['Country'].str.contains('Georgia', case=False, na=False)]\n    print(f\"\\nGeorgia rows: {len(georgia)}\")\n    if len(georgia) > 0:\n        print(f\"\\nSubjects: {georgia['Subject Descriptor'].unique()[:15]}\")\nEOF\n"]
