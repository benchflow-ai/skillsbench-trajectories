[492.381093, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\nws_na = wb['NA']\n\n# Fix Scenario 3 import content share - it should be at row 133 (assump_row_s3 + 3)\n# Let me recalculate: start_row_s3 = 101, assump_row_s3 = 101 + 28 = 129\n# So import content should be at D132 (129 + 3)\nprint(\"Checking Scenario 3 assumptions...\")\nprint(f\"Row 129: {ws_na['C129'].value} = {ws_na['D129'].value}\")\nprint(f\"Row 130: {ws_na['C130'].value} = {ws_na['D130'].value}\")\nprint(f\"Row 131: {ws_na['C131'].value} = {ws_na['D131'].value}\")\nprint(f\"Row 132: {ws_na['C132'].value} = {ws_na['D132'].value}\")\nprint(f\"Row 133: {ws_na['C133'].value} = {ws_na['D133'].value}\")\n\n# Fix if needed\nif ws_na['D132'].value != 0.5:\n    ws_na['D132'] = 0.5\n    print(\"\\nFixed import content share to 0.5\")\n    wb.save('test - demand.xlsx')\n    print(\"Saved\")\nelse:\n    print(\"\\nImport content already correct\")\n\nprint(\"\\n=== TASK COMPLETED SUCCESSFULLY ===\")\nSCRIPT\n"]
