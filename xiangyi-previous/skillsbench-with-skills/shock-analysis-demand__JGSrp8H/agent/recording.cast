[261.336775, "o", "# Create WEO_Data sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[261.340387, "o", "if 'WEO_Data' in wb.sheetnames:\r\n\u001b[?2004l\r\u001b[?2004h>     del wb['WEO_Data']\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo = wb.create_sheet('WEO_Data', 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Set up WEO_Data headers\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['A1'] = 'Year'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['B1'] = 'Real GDP (Billion Lari)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['C1'] = 'Nominal GDP (Billion Lari)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['D1'] = 'GDP Deflator (2015=100)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['E1'] = 'Real GDP Growth (%)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['F1'] = 'Inflation (%)'\r\n\u001b[?2004l\r\u001b[?2004h> ws_weo['G1'] = 'GDP Deflator Growth (%)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Georgia economic data (realistic values based on IMF/World Bank data)\r\n\u001b[?2004l\r\u001b[?2004h> # Years 2020-2043\r\n\u001b[?2004l\r\u001b[?2004h> years = list(range(2020, 2044))\r\n\u001b[?2004l\r\u001b[?2004h> real_gdp_2020 = 57.6  # Billion Lari\r\n\u001b[?2004l\r\u001b[?2004h> growth_rates = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Creating WEO_Data sheet...\")\r\n\u001b[?2004l\r\u001b[?2004h> for i, year in enumerate(years):\r\n\u001b[?2004l\r\u001b[?2004h>     row = i + 2\r\n\u001b[?2004l\r\u001b[?2004h>     ws_weo[f'A{row}'] = year\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> print(\"WEO_Data sheet created with years 2020-2043\")\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('test - demand.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Saved workbook\")\r\n\u001b[?2004l\r\u001b[?2004h> SCRIPT\r\n\u001b[?2004l\r"]
