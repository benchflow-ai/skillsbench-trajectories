[391.230398, "o", "root@e0c4d1bb8cf0:~# "]
[408.480525, "i", "python3 << 'SCRIPT'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook('test - demand.xlsx')\nws_na = wb['NA']\n\n# Add header for Scenario 1\nws_na.insert_rows(1)\nws_na['A1'] = 'SCENARIO 1: Base Case (Multiplier=0.8, Import Content from SUT)'\n\n# Update the original header row (now row 2)\nws_na['B2'] = 'Year'\nws_na['C2'] = 'Real GDP'\nws_na['D2'] = 'Project Allocation (%)'\nws_na['E2'] = 'Project Investment'\nws_na['F2'] = 'Imports'\nws_na['G2'] = 'GDP impact'\nws_na['H2'] = 'Multiplier'\nws_na['I2'] = '% of GDP'\nws_na['J2'] = 'Baseline GDP Growth'\nws_na['K2'] = 'Projected Growth'\nws_na['G3'] = 'I-M'\n\nprint(\"Added Scenario 1 header\")\n\nwb.save('test - demand.xlsx')\n\n# Verify the workbook structure\nprint(\"\\n=== Workbook Structure ===\")\nprint(f\"Sheet names: {wb.sheetnames}\")\nprint(f\"\\nTotal sheets: {len(wb.sheetnames)}\")\n\nfor sheet_name in wb.sheetnames:\n    ws = wb[sheet_name]\n    print(f\"\\n{sheet_name}:\")\n    print(f\"  Dimensions: {ws.max_row} rows x {ws.max_column} columns\")\n    if sheet_name == 'WEO_Data':\n        print(f\"  Sample: {ws['A1'].value}, {ws['B1'].value}, {ws['E1'].value}\")\n    elif sheet_name == 'SUT Calc':\n        print(f\"  Import content formula: {ws['C46'].value}\")\n    elif sheet_name == 'NA':\n        print(f\"  Scenario 1: {ws['A1'].value}\")\n        print(f\"  Assumptions at D30-D33\")\n\nprint(\"\\n=== Verification Complete ===\")\nprint(\"File saved as: test - demand.xlsx\")\nSCRIPT\n"]
