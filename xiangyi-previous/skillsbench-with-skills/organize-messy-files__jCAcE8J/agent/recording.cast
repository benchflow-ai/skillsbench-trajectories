[259.004629, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess\n\ndef first_lines(f, n=3):\n    try:\n        text = subprocess.check_output(['pdftotext','-f','1','-l','1',f,'-'], text=True, errors='ignore')\n        lines=[l.strip() for l in text.splitlines() if l.strip()]\n        return lines[:n]\n    except Exception as e:\n        return []\n\nfiles=['0704.0117v1.pdf','0707.1221v1.pdf','0707.3224v1.pdf','0710.4345v1.pdf','0711.1406v1.pdf','0809.1063v1.pdf']\nfor f in files:\n    print(f, first_lines(f))\nPY\n"]
