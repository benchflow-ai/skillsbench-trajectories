[326.409699, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess, glob, re, zipfile\n\npatterns = {\n    'LLM': [r'\\blarge language model\\b', r'\\blanguage model\\b', r'\\bllm\\b', r'\\bgpt\\b', r'\\btransformer\\b', r'\\bchatgpt\\b', r'\\bprompt\\b', r'instruction tuning', r'\\brlhf\\b', r'\\bfine-tuning\\b', r'\\btoken\\b', r'\\battention\\b', r'in-context'],\n    'trapped_ion_and_qc': [r'\\btrapped ion\\b', r'\\bion trap\\b', r'\\bion-trap\\b', r'\\btrapped-ion\\b', r'\\bquantum computing\\b', r'\\bquantum computer\\b', r'\\bquantum information\\b', r'\\bqubit\\b', r'\\bquantum gate\\b', r'\\bquantum logic\\b', r'\\bquantum simulation\\b', r'\\bquantum processor\\b'],\n    'black_hole': [r'\\bblack hole\\b', r'\\bblack-hole\\b', r'\\bevent horizon\\b', r'\\bhawking\\b', r'\\bkerr\\b', r'\\bschwarzschild\\b', r'\\bsingularity\\b', r'\\baccretion\\b', r'\\bgravitational\\b', r'\\brelativity\\b'],\n    'DNA': [r'\\bdna\\b', r'\\bgenome\\b', r'\\bgenetic\\b', r'\\bgene\\b', r'\\bchromosome\\b', r'\\bnucleotide\\b', r'\\bgenomics\\b', r'\\brna\\b', r'\\bprotein\\b', r'\\bsequencing\\b', r'\\bmolecular\\b'],\n    'music_history': [r'\\bmusic\\b', r'\\bcomposer\\b', r'\\bsymphony\\b', r'\\bopera\\b', r'\\bbaroque\\b', r'\\bclassical\\b', r'\\bjazz\\b', r'\\bsong\\b', r'\\bmusical\\b', r'\\bmusicology\\b', r'history of music']\n}\n\nregex = {cat:[re.compile(p, re.IGNORECASE) for p in pats] for cat,pats in patterns.items()}\n\n\ndef extract_text(path):\n    if path.endswith('.pdf'):\n        try:\n            return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\n        except Exception:\n            return ''\n    elif path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\n            return re.sub('<[^<]+?>',' ',xml)\n        except Exception:\n            return ''\n    elif path.endswith('.pptx'):\n        try:\n            text_parts=[]\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\n\ndef classify(text):\n    for cat in ['black_hole','DNA','LLM','music_history','trapped_ion_and_qc']:\n        if any(r.search(text) for r in regex[cat]):\n            return cat\n    return 'unknown'\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nunknown=[]\nfor f in files:\n    t = extract_text(f)\n    cat = classify(t)\n    results[f]=cat\n    if cat=='unknown':\n        unknown.append(f)\n\nfrom collections import Counter\nprint('Counts:', Counter(results.values()))\nif unknown:\n    print('Unknown files:', len(unknown))\n    for f in unknown:\n        print(f)\nPY\n"]
