[748.579006, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess, glob, re, zipfile, os, shutil\n\nbase = os.path.abspath(os.path.join(os.getcwd(), '..'))\n\ndef extract_text(path):\n    if path.endswith('.pdf'):\n        try:\n            return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\n        except Exception:\n            return ''\n    elif path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\n            return re.sub('<[^<]+?>',' ',xml)\n        except Exception:\n            return ''\n    elif path.endswith('.pptx'):\n        try:\n            text_parts=[]\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\nblack_hole_re = re.compile(r'black hole|black-hole|event horizon|hawking|kerr|schwarzschild|singularity', re.I)\nDNA_re = re.compile(r'\\b(dna|genome|genetic|gene|chromosome|nucleotide|genomics|rna|protein|sequencing)\\b', re.I)\nmusic_re = re.compile(r'\\b(music|musical|composer|symphony|opera|baroque|classical|jazz|song|musicology|melody|rhythm|pop|popular music|rock|hip hop)\\b', re.I)\nLLM_re = re.compile(r'large language model|language model|\\bllm\\b|\\bgpt\\b|chatgpt|transformer|instruction tuning|prompt|in-context', re.I)\ntrapped_re = re.compile(r'trapped ion|ion trap|ion-trap|trapped-ion', re.I)\nqc_re = re.compile(r'quantum computing|quantum computer|quantum information|qubit|quantum gate|quantum logic|quantum simulation|quantum processor', re.I)\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nfrom collections import Counter\ncounts = Counter()\n\nfor f in files:\n    text = extract_text(f)\n    t = text.lower()\n    if black_hole_re.search(text):\n        cat = 'black_hole'\n    elif DNA_re.search(text):\n        cat = 'DNA'\n    elif music_re.search(text):\n        cat = 'music_history'\n    elif LLM_re.search(text):\n        cat = 'LLM'\n    elif trapped_re.search(text) or qc_re.search(text) or 'quantum' in t:\n        cat = 'trapped_ion_and_qc'\n    else:\n        cat = 'trapped_ion_and_qc'\n\n    dest = os.path.join(base, cat, os.path.basename(f))\n    shutil.move(f, dest)\n    counts[cat] += 1\n\nprint('Moved counts:', counts)\nPY\n"]
[748.579268, "o", "cd ~/papers/all\r\n"]
