[404.234609, "o", "\u001b[?2004hroot@384008d58f77:~/papers/all# "]
[482.502061, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess, glob, re, zipfile\n\nkeywords = {\n    'LLM': ['large language model','language model','llm','gpt','transformer','chatgpt','prompt','instruction','fine-tuning','pretrained','token','attention','embedding','in-context','decoder','bert'],\n    'trapped_ion_and_qc': ['trapped ion','ion trap','ion-trap','trapped-ion','quantum computing','quantum computer','quantum information','qubit','quantum gate','quantum logic','quantum simulation','quantum processor','entanglement','superposition','quantum'],\n    'black_hole': ['black hole','black-hole','event horizon','hawking','kerr','schwarzschild','singularity','accretion','gravitational','relativity','gravitational wave','thermodynamics'],\n    'DNA': ['dna','genome','genetic','gene','chromosome','nucleotide','genomics','rna','protein','sequencing','molecular','bio','enzyme'],\n    'music_history': ['music','musical','song','symphony','composer','opera','baroque','classical','jazz','musicology','music history','rhythm','melody','pop','popular','rock','hip hop']\n}\n\n\ndef extract_text(path):\n    if path.endswith('.pdf'):\n        try:\n            return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\n        except Exception:\n            return ''\n    elif path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\n            return re.sub('<[^<]+?>',' ',xml)\n        except Exception:\n            return ''\n    elif path.endswith('.pptx'):\n        try:\n            text_parts=[]\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nambiguous = []\nfor f in files:\n    t = extract_text(f).lower()\n    scores = {cat:0 for cat in keywords}\n    for cat, keys in keywords.items():\n        for k in keys:\n            if k in t:\n                scores[cat] += t.count(k)\n    # pick highest score\n    best = max(scores, key=scores.get)\n    best_score = scores[best]\n    results[f]= (best, scores)\n    if best_score == 0:\n        ambiguous.append(f)\n\nfrom collections import Counter\nprint('Counts:', Counter([v[0] for v in results.values()]))\nprint('Zero-score files:', len(ambiguous))\nfor f in ambiguous[:10]:\n    print(' ',f)\n\n# show sample of potential misclassifications: where music score >0 but not classified as music, etc.\nfor cat in keywords:\n    pass\n\n# show top 5 files where music score >0 but classified other\nprint('\\nMusic-related but not classified as music_history:')\nfor f,(best,scores) in results.items():\n    if scores['music_history']>0 and best!='music_history':\n        print(f, best, scores)\n\nprint('\\nDNA-related but not classified as DNA:')\nfor f,(best,scores) in results.items():\n    if scores['DNA']>0 and best!='DNA':\n        print(f, best, scores)\n\nprint('\\nTrapped-ion/QC-related but not classified as trapped_ion_and_qc:')\nfor f,(best,scores) in results.items():\n    if scores['trapped_ion_and_qc']>0 and best!='trapped_ion_and_qc':\n        print(f, best, scores)\n\nprint('\\nLLM-related but not classified as LLM:')\nfor f,(best,scores) in results.items():\n    if scores['LLM']>0 and best!='LLM':\n        print(f, best, scores)\nPY\n"]
