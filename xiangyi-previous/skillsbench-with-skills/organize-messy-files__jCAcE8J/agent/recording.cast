[72.2443, "o", "\u001b[?2004hroot@384008d58f77:~/papers# "]
[116.647906, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess, glob, os, re, zipfile\n\nLLM_keys = ['large language model','language model','llm','gpt','transformer','prompt','chatgpt','instruction tuning','rlhf','fine-tuning','token','attention','in-context']\ntrapped_keys = ['trapped ion','ion trap','ion-trap','ion trap', 'ion', 'qubit', 'quantum computing','quantum computer','quantum information','quantum gate','quantum logic','quantum control','quantum simulation','quantum processor']\nblackhole_keys = ['black hole','black-hole','event horizon','hawking','kerr','schwarzschild','singularity','accretion','gravitational','relativity','astrophysical']\nDNA_keys = ['dna','genome','genetic','gene','chromosome','nucleotide','genomics','rna','protein','sequencing','molecular']\nmusic_keys = ['music','composer','symphony','opera','baroque','classical','jazz','song','musical','musicology','history of music']\n\n\ndef extract_text(path):\n    if path.endswith('.pdf'):\n        try:\n            return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\n        except Exception as e:\n            return ''\n    elif path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\n            text = re.sub('<[^<]+?>',' ',xml)\n            return text\n        except Exception:\n            return ''\n    elif path.endswith('.pptx'):\n        try:\n            text_parts = []\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\n\ndef classify(text):\n    t = text.lower()\n    if any(k in t for k in blackhole_keys):\n        return 'black_hole'\n    if any(k in t for k in DNA_keys):\n        return 'DNA'\n    if any(k in t for k in LLM_keys):\n        return 'LLM'\n    if any(k in t for k in music_keys):\n        return 'music_history'\n    if any(k in t for k in trapped_keys):\n        return 'trapped_ion_and_qc'\n    return 'unknown'\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nunknown = []\nfor f in files:\n    text = extract_text(f)\n    cat = classify(text)\n    results[f]=cat\n    if cat=='unknown':\n        unknown.append(f)\n\nfrom collections import Counter\nprint('Counts:', Counter(results.values()))\nif unknown:\n    print('Unknown files:', len(unknown))\n    for f in unknown:\n        print(f)\nPY\n"]
[116.648371, "o", "cd ~/papers/all\r\n\u001b[?2004l\r in t for k in DNA_keys):\r\n        return 'DNA'\r\n    if any(k in t for k in LLM_keys):\r\n        return 'LLM'\r\n    if any(k in t for k in music_keys):\r\n        return 'music_history'\r\n    if any(k in t for k in trapped_keys):\r\n        return 'trapped_ion_and_qc'\r\n    return 'unknown'\r\n\r\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\r\nresults = {}\r\nunknown = []\r\nfor f in files:\r\n    text = extract_text(f)\r\n    cat = classify(text)\r\n    results[f]=cat\r\n    if cat=='unknown':\r\n        unknown.append(f)\r\n\r\nfrom collections import Counter\r\nprint('Counts:', Counter(results.values()))\r\nif unknown:\r\n    print('Unknown files:', len(unknown))\r\n    for f in unknown:\r\n        print(f)\r\nPY\r\n\u001b[?2004hroot@384008d58f77:~/papers/all# "]
