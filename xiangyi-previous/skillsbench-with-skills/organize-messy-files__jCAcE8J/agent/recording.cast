[748.589878, "o", "\u001b[?2004hroot@384008d58f77:~/papers/all# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess, glob, re, zipfile, os, shutil\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> base = os.path.abspath(os.path.join(os.getcwd(), '..'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_text(path):\r\n\u001b[?2004l\r\u001b[?2004h>     if path.endswith('.pdf'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             return ''\r\n\u001b[?2004l\r\u001b[?2004h>     elif path.endswith('.docx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h>                 xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\r\n\u001b[?2004l\r\u001b[?2004h>             return re.sub('<[^<]+?>',' ',xml)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             return ''\r\n\u001b[?2004l\r\u001b[?2004h>     elif path.endswith('.pptx'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             text_parts=[]\r\n\u001b[?2004l\r\u001b[?2004h>             with zipfile.ZipFile(path) as z:\r\n\u001b[?2004l\r\u001b[?2004h>                 for name in z.namelist():\r\n\u001b[?2004l\r\u001b[?2004h>                     if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\r\n\u001b[?2004l\r\u001b[?2004h>                         xml = z.read(name).decode('utf-8', errors='ignore')\r\n\u001b[?2004l\r\u001b[?2004h>                         text_parts.append(re.sub('<[^<]+?>',' ',xml))\r\n\u001b[?2004l\r\u001b[?2004h>             return ' '.join(text_parts)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             return ''\r\n\u001b[?2004l\r\u001b[?2004h>     return ''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> black_hole_re = re.compile(r'black hole|black-hole|event horizon|hawking|kerr|schwarzschild|singularity', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> DNA_re = re.compile(r'\\b(dna|genome|genetic|gene|chromosome|nucleotide|genomics|rna|protein|sequencing)\\b', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> music_re = re.compile(r'\\b(music|musical|composer|symphony|opera|baroque|classical|jazz|song|musicology|melody|rhythm|pop|popular music|rock|hip hop)\\b', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> LLM_re = re.compile(r'large language model|language model|\\bllm\\b|\\bgpt\\b|chatgpt|transformer|instruction tuning|prompt|in-context', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> trapped_re = re.compile(r'trapped ion|ion trap|ion-trap|trapped-ion', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> qc_re = re.compile(r'quantum computing|quantum computer|quantum information|qubit|quantum gate|quantum logic|quantum simulation|quantum processor', re.I)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> files = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> counts = Counter()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for f in files:\r\n\u001b[?2004l\r\u001b[?2004h>     text = extract_text(f)\r\n\u001b[?2004l\r\u001b[?2004h>     t = text.lower()\r\n\u001b[?2004l\r\u001b[?2004h>     if black_hole_re.search(text):\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'black_hole'\r\n\u001b[?2004l\r\u001b[?2004h>     elif DNA_re.search(text):\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'DNA'\r\n\u001b[?2004l\r\u001b[?2004h>     elif music_re.search(text):\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'music_history'\r\n\u001b[?2004l\r\u001b[?2004h>     elif LLM_re.search(text):\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'LLM'\r\n\u001b[?2004l\r\u001b[?2004h>     elif trapped_re.search(text) or qc_re.search(text) or 'quantum' in t:\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'trapped_ion_and_qc'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         cat = 'trapped_ion_and_qc'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     dest = os.path.join(base, cat, os.path.basename(f))\r\n\u001b[?2004l\r\u001b[?2004h>     shutil.move(f, dest)\r\n\u001b[?2004l\r\u001b[?2004h>     counts[cat] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Moved counts:', counts)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
