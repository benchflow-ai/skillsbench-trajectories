[624.3686, "o", "\u001b[?2004hroot@384008d58f77:~/papers/all# "]
[653.806502, "i", "cd ~/papers/all\npython3 - <<'PY'\nimport subprocess, glob, re, zipfile\n\npatterns = {\n    'black_hole': [r'\\bblack hole\\b', r'\\bblack-hole\\b', r'\\bevent horizon\\b', r'\\bhawking\\b', r'\\bkerr\\b', r'\\bschwarzschild\\b', r'\\bsingularity\\b'],\n    'DNA': [r'\\bdna\\b', r'\\bgenome\\b', r'\\bgenetic\\b', r'\\bgene\\b', r'\\bchromosome\\b', r'\\bnucleotide\\b', r'\\bgenomics\\b', r'\\brna\\b', r'\\bprotein\\b', r'\\bsequencing\\b'],\n    'music_history': [r'\\bmusic\\b', r'\\bmusical\\b', r'\\bcomposer\\b', r'\\bsymphony\\b', r'\\bopera\\b', r'\\bbaroque\\b', r'\\bclassical\\b', r'\\bjazz\\b', r'\\bsong\\b', r'\\bmusicology\\b', r'\\bmelody\\b', r'\\brhythm\\b', r'\\bpopular music\\b', r'\\bhip hop\\b', r'\\brock\\b'],\n    'LLM': [r'\\blarge language model\\b', r'\\blanguage model\\b', r'\\bllm\\b', r'\\bgpt\\b', r'\\bchatgpt\\b', r'\\btransformer\\b', r'\\binstruction tuning\\b', r'\\bprompt\\b', r'\\bin-context\\b']\n}\nregex = {cat:[re.compile(p, re.IGNORECASE) for p in pats] for cat,pats in patterns.items()}\n\n\ndef extract_text(path):\n    if path.endswith('.pdf'):\n        try:\n            return subprocess.check_output(['pdftotext','-f','1','-l','1',path,'-'], text=True, errors='ignore')\n        except Exception:\n            return ''\n    elif path.endswith('.docx'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                xml = z.read('word/document.xml').decode('utf-8', errors='ignore')\n            return re.sub('<[^<]+?>',' ',xml)\n        except Exception:\n            return ''\n    elif path.endswith('.pptx'):\n        try:\n            text_parts=[]\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nrecords = []\nfor f in files:\n    t = extract_text(f)\n    cat = None\n    for c in ['black_hole','DNA','music_history','LLM']:\n        if any(r.search(t) for r in regex[c]):\n            cat = c\n            break\n    if cat is None:\n        cat = 'trapped_ion_and_qc'\n    # first non-empty line\n    first = ''\n    for line in t.splitlines():\n        if line.strip():\n            first = line.strip()\n            break\n    records.append((cat,f,first))\n\nfor cat in ['LLM','music_history','black_hole','DNA','trapped_ion_and_qc']:\n    print('\\n##',cat)\n    for c,f,first in records:\n        if c==cat:\n            print(f\"{f} :: {first}\")\nPY\n"]
[653.807322, "o", "cd ~/papers/all\r\n\u001b[?2004l\r  t = extract_text(f)\r\n    cat = None\r\n    for c in ['black_hole','DNA','music_history','LLM']:\r\n        if any(r.search(t) for r in regex[c]):\r\n            cat = c\r\n            break\r\n    if cat is None:\r\n        cat = 'trapped_ion_and_qc'\r\n    # first non-empty line\r\n    first = ''\r\n    for line in t.splitlines():\r\n        if line.strip():\r\n            first = line.strip()\r\n            break\r\n    records.append((cat,f,first))\r\n\r\nfor cat in ['LLM','music_history','black_hole','DNA','trapped_ion_and_qc']:\r\n    print('\\n##',cat)\r\n    for c,f,first in records:\r\n        if c==cat:\r\n            print(f\"{f} :: {first}\")\r\nPY\r\n\u001b[?2004hroot@384008d58f77:~/papers/all# "]
