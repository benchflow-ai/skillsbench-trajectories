def classify(text):
    for cat in ['black_hole','DNA','LLM','music_history','trapped_ion_and_qc']:
        if any(r.search(text) for r in regex[cat]):
            return cat
    return 'unknown'

files = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))
cat_files = {c:[] for c in patterns}
for f in files:
    t = extract_text(f)
    cat = classify(t)
    cat_files.setdefault(cat, []).append((f,t))

for cat, flist in cat_files.items():
    print('\n',cat)
    for f,t in flist[:3]:
        lines=[l.strip() for l in t.splitlines() if l.strip()]
        print(' ',f, '::', ' / '.join(lines[:2]))
