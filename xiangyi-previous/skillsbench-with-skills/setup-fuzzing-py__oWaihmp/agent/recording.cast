[89.209323, "o", "5. JSONtoObj.c - JSON parsing implementation\r\n"]
[89.209354, "o", "> "]
[89.209404, "o", "6. objToJSON.c - JSON encoding implementation\r\n"]
[89.209439, "o", "> \r\n> "]
[89.209476, "o", "Key Parameters and Options:\r\n"]
[89.209498, "o", "> "]
[89.209579, "o", "- encode_html_chars - Escape HTML characters in output\r\n"]
[89.209602, "o", "> "]
[89.209666, "o", "- escape_forward_slashes - Escape forward slashes\r\n"]
[89.209691, "o", "> "]
[89.209739, "o", "- ensure_ascii - Escape non-ASCII characters\r\n"]
[89.209764, "o", "> "]
[89.209824, "o", "- sort_keys - Sort object keys in output\r\n> "]
[89.209894, "o", "- indent - Pretty-print with indentation\r\n"]
[89.209917, "o", "> "]
[89.209995, "o", "- default - Custom encoder for non-serializable objects\r\n"]
[89.210029, "o", "> "]
[89.210072, "o", "- object_hook - Custom decoder hook for objects\r\n"]
[89.210097, "o", "> "]
[89.210151, "o", "- parse_float - Custom float parser\r\n> "]
[89.210204, "o", "- parse_int - Custom int parser\r\n"]
[89.210229, "o", "> \r\n"]
[89.210252, "o", "> "]
[89.210269, "o", "Fuzzing Focus Areas:\r\n"]
[89.21029, "o", "> "]
[89.210393, "o", "- Malformed JSON strings (invalid syntax, incomplete structures)\r\n> "]
[89.210478, "o", "- Deeply nested JSON structures (stack overflow testing)\r\n"]
[89.210493, "o", "> "]
[89.210563, "o", "- Large JSON payloads (memory exhaustion)\r\n> "]
[89.210644, "o", "- Unicode and escape sequence handling\r\n> "]
[89.210727, "o", "- Numeric edge cases (very large numbers, NaN, Infinity)\r\n"]
[89.210755, "o", "> "]
[89.210783, "o", "- Circular reference detection\r\n"]
[89.219709, "o", "> - Custom encoder/decoder hook edge cases\r\n> - Empty and null value handling\r\n> - Array and object boundary conditions\r\n> EOF\r\n"]
