[119.565984, "i", "cat > /app/ujson/fuzz.py << 'EOF'\nimport sys\nimport atheris\nimport ujson\n\n@atheris.instrument_func\ndef test_ujson_loads(data):\n    \"\"\"Fuzz ujson.loads() with various JSON inputs\"\"\"\n    if len(data) < 1:\n        return\n    \n    try:\n        json_str = data.decode('utf-8', errors='ignore')\n        ujson.loads(json_str)\n    except (ValueError, TypeError, ujson.JSONDecodeError):\n        pass\n    except Exception:\n        pass\n\n@atheris.instrument_func\ndef test_ujson_dumps(data):\n    \"\"\"Fuzz ujson.dumps() with various Python objects\"\"\"\n    if len(data) < 1:\n        return\n    \n    try:\n        # Create various Python objects from the data\n        obj = {\n            \"data\": data.decode('utf-8', errors='ignore'),\n            \"length\": len(data),\n            \"bytes\": list(data[:min(10, len(data))])\n        }\n        ujson.dumps(obj)\n    except (ValueError, TypeError, OverflowError):\n        pass\n    except Exception:\n        pass\n\n@atheris.instrument_func\ndef test_ujson_with_options(data):\n    \"\"\"Fuzz ujson with var"]
[119.566033, "i", "ious encoding options\"\"\"\n    if len(data) < 1:\n        return\n    \n    try:\n        json_str = data.decode('utf-8', errors='ignore')\n        # Test loads with different options\n        ujson.loads(json_str)\n        \n        # Test dumps with different options\n        obj = {\"test\": json_str}\n        ujson.dumps(obj, ensure_ascii=True)\n        ujson.dumps(obj, sort_keys=True)\n    except (ValueError, TypeError, ujson.JSONDecodeError):\n        pass\n    except Exception:\n        pass\n\n@atheris.instrument_func\ndef test_ujson_nested_structures(data):\n    \"\"\"Fuzz deeply nested JSON structures\"\"\"\n    if len(data) < 1:\n        return\n    \n    try:\n        # Create nested structure\n        nested = {\"level\": 0}\n        current = nested\n        for i, byte in enumerate(data[:100]):  # Limit nesting depth\n            current[f\"level_{i}\"] = {\"value\": byte, \"level\": i + 1}\n            current = current[f\"level_{i}\"]\n        \n        ujson.dumps(nested)\n    except (ValueError, TypeError, RecursionError, OverflowError):\n   "]
[119.566196, "i", "     pass\n    except Exception:\n        pass\n\ndef TestOneInput(data):\n    test_ujson_loads(data)\n    test_ujson_dumps(data)\n    test_ujson_with_options(data)\n    test_ujson_nested_structures(data)\n\nif __name__ == \"__main__\":\n    atheris.Setup(sys.argv, TestOneInput)\n    atheris.Fuzz()\nEOF\n"]
