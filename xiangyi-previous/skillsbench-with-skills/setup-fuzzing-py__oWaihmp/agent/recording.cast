[618.025913, "i", "cat > /tmp/run_fuzzers.sh << 'SCRIPT'\n#!/bin/bash\nset -e\n\n# Run fuzzer for arrow\ncd /app/arrow\nif [ -d .venv ]; then\n  source .venv/bin/activate\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\n  deactivate\nfi\n\n# Run fuzzer for black\ncd /app/black\nif [ -d .venv ]; then\n  source .venv/bin/activate\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\n  deactivate\nfi\n\n# Run fuzzer for ipython\ncd /app/ipython\nif [ -d .venv ]; then\n  source .venv/bin/activate\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\n  deactivate\nfi\n\necho 'All fuzzers completed'\nSCRIPT\n"]
[618.026016, "o", "cat > /tmp/run_fuzzers.sh << 'SCRIPT'\r\n#!/bin/bash\r\nset -e\r\n\r\n# Run fuzzer for arrow\r\ncd /app/arrow\r\nif [ -d .venv ]; then\r\n  source .venv/bin/activate\r\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\r\n  deactivate\r\nfi\r\n\r\n# Run fuzzer for black\r\ncd /app/black\r\nif [ -d .venv ]; then\r\n  source .venv/bin/activate\r\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\r\n  deactivate\r\nfi\r\n\r\n# Run fuzzer for ipython\r\ncd /app/ipython\r\nif [ -d .venv ]; then\r\n  source .venv/bin/activate\r\n  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true\r\n  deactivate\r\nfi\r\n\r\necho 'All fuzzers completed'\r\nSCRIPT\r\n"]
[632.949077, "i", "bash /tmp/run_fuzzers.sh\n"]
