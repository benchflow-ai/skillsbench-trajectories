#!/bin/bash
set -e

# Run fuzzer for arrow
cd /app/arrow
if [ -d .venv ]; then
  source .venv/bin/activate
  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true
  deactivate
fi

# Run fuzzer for black
cd /app/black
if [ -d .venv ]; then
  source .venv/bin/activate
  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true
  deactivate
fi

# Run fuzzer for ipython
cd /app/ipython
if [ -d .venv ]; then
  source .venv/bin/activate
  timeout 10 python3 fuzz.py > fuzz.log 2>&1 || true
  deactivate
fi

echo 'All fuzzers completed'
SCRIPT
