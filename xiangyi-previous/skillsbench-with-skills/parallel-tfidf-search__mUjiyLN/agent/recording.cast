[219.014841, "o", "\u001b[?2004h> "]
[219.014887, "o", "        \"may\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.014933, "o", "        \"been\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.014975, "o", "        \"being\",\r\n\u001b[?2004l\r"]
[219.015023, "o", "\u001b[?2004h>         \"am\",\r\n\u001b[?2004l\rt"]
[219.015071, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.015098, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.015128, "o", "\u001b[?2004h> "]
[219.015288, "o", "TOKEN_PATTERN = re.compile(r\"\\b[a-zA-Z]{2,}\\b\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rh"]
[219.015334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> "]
[219.015432, "o", "def tokenize(text: str) -> List[str]:\r\n\u001b[?2004l\r"]
[219.015493, "o", "\u001b[?2004h> "]
[219.015589, "o", "    tokens = TOKEN_PATTERN.findall(text.lower())\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.015634, "o", "> "]
[219.01574, "o", "    return [t for t in tokens if t not in STOP_WORDS]\r\n\u001b[?2004l\r"]
[219.01578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> \r\n\u001b[?2004l\rv"]
[219.015818, "o", "\u001b[?2004h> "]
[219.015992, "o", "def compute_term_frequencies(tokens: List[str]) -> Dict[str, float]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.016043, "o", "> "]
[219.016068, "o", "    if not tokens:\r\n\u001b[?2004l\rk\u001b[?2004h> "]
[219.01613, "o", "        return {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.016173, "o", "> "]
[219.016259, "o", "    counts = defaultdict(int)\r\n\u001b[?2004l\r"]
[219.016306, "o", "\u001b[?2004h> "]
[219.016332, "o", "    for token in tokens:\r\n\u001b[?2004l\r"]
[219.016361, "o", "\u001b[?2004h> "]
[219.016484, "o", "        counts[token] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.016539, "o", "    total = len(tokens)\r\n\u001b[?2004l\r"]
[219.016572, "o", "\u001b[?2004h> "]
[219.016721, "o", "    return {term: count / total for term, count in counts.items()}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.016772, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd"]
[219.016802, "o", "\u001b[?2004h> "]
[219.016982, "o", "# ==========================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.017011, "o", "> "]
[219.01711, "o", "# Data Structures (same as sequential)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.01714, "o", "> "]
[219.017384, "o", "# ==========================================================================\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h"]
[219.017467, "o", "> @dataclass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.017514, "o", "class TFIDFIndex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.017579, "o", "    num_documents: int = 0\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[219.017732, "o", "    vocabulary: set[str] = field(default_factory=set)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.017938, "o", "    document_frequencies: Dict[str, int] = field(default_factory=dict)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.017967, "o", "> "]
[219.018108, "o", "    idf: Dict[str, float] = field(default_factory=dict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.018363, "o", "    inverted_index: Dict[str, List[Tuple[int, float]]] = field(default_factory=dict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.018595, "o", "    doc_vectors: Dict[int, Dict[str, float]] = field(default_factory=dict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.018823, "o", "    doc_norms: Dict[int, float] = field(default_factory=dict)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[219.018871, "o", "> @dataclass\r\n\u001b[?2004l\r b\u001b[?2004h> "]
[219.018992, "o", "class SearchResult:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.019069, "o", "    doc_id: int\r\n\u001b[?2004l\r\u001b[?2004h>     score: float\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.019123, "o", "    title: str = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.01917, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.019228, "o", "\u001b[?2004h> @dataclass\r\n\u001b[?2004l\r"]
[219.01929, "o", "\u001b[?2004h> class ParallelIndexingResult:"]
[219.019341, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.019384, "o", "    index: TFIDFIndex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.019452, "o", "    elapsed_time: float\r\n\u001b[?2004l\rdoc_i\u001b[?2004h"]
[219.019508, "o", "> "]
[219.019549, "o", "    num_documents: int\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.019604, "o", "    vocabulary_size: int\r\n\u001b[?2004l\r"]
[219.019643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h"]
[219.019682, "o", "> "]
[219.019883, "o", "# ==========================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.019911, "o", "> "]
[219.020034, "o", "# Parallel Index Building Helpers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.02023, "o", "# ==========================================================================\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.020258, "o", "> \r\n\u001b[?2004l\rr\u001b[?2004h> \r\n\u001b[?2004l\rm"]
[219.020324, "o", "\u001b[?2004h> "]
[219.020432, "o", "def _process_documents_chunk(chunk: List[Document]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.020492, "o", "> "]
[219.0206, "o", "    local_doc_term_freqs: Dict[int, Dict[str, float]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.020657, "o", "> "]
[219.02075, "o", "    local_doc_terms: Dict[int, set[str]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.02078, "o", "> "]
[219.020855, "o", "    local_vocab: set[str] = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.020883, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[219.020953, "o", "    for doc in chunk:\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.021011, "o", "> "]
[219.021106, "o", "        text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.02116, "o", "> "]
[219.021202, "o", "        tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.021242, "o", "> "]
[219.021347, "o", "        tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.021373, "o", "> "]
[219.021486, "o", "        local_doc_term_freqs[doc.doc_id] = tf\r\n\u001b[?2004l\roc_i\u001b[?2004h"]
[219.021511, "o", "> "]
[219.021655, "o", "        local_doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.021715, "o", "> "]
[219.021773, "o", "        local_vocab.update(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.0218, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> "]
[219.021982, "o", "    return local_doc_term_freqs, local_doc_terms, local_vocab\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.022046, "o", "w\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[219.022074, "o", "\u001b[?2004h> _GLOBAL_IDF = None\r\n\u001b[?2004l\r"]
[219.022147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.022191, "o", "> \r\n\u001b[?2004l\rx\u001b[?2004h> "]
[219.022267, "o", "def _init_tfidf_worker(idf: Dict[str, float]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.022305, "o", "> "]
[219.022358, "o", "    global _GLOBAL_IDF\r\n\u001b[?2004l\r"]
[219.022397, "o", "\u001b[?2004h> "]
[219.022438, "o", "    _GLOBAL_IDF = idf\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.022465, "o", "> \r\n\u001b[?2004l\rx\u001b[?2004h> \r\n\u001b[?2004l\re"]
[219.02253, "o", "\u001b[?2004h> "]
[219.022686, "o", "def _process_tfidf_chunk(doc_items: List[Tuple[int, Dict[str, float]]]):\r\n\u001b[?2004l\r"]
[219.022734, "o", "\u001b[?2004h> "]
[219.022766, "o", "    idf = _GLOBAL_IDF\r\n\u001b[?2004l\rec"]
[219.022792, "o", "\u001b[?2004h> "]
[219.022938, "o", "    local_doc_vectors: Dict[int, Dict[str, float]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.022994, "o", "> "]
[219.02307, "o", "    local_doc_norms: Dict[int, float] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.023162, "o", "> "]
[219.023282, "o", "    local_inverted: Dict[str, List[Tuple[int, float]]] = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.023333, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[219.023414, "o", "    for doc_id, tf_dict in doc_items:\r\n\u001b[?2004l\r"]
[219.023454, "o", "\u001b[?2004h> "]
[219.023544, "o", "        doc_vector: Dict[str, float] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.023587, "o", "> "]
[219.023624, "o", "        norm_sq = 0.0\r\n\u001b[?2004l\r"]
[219.023664, "o", "\u001b[?2004h> "]
[219.023843, "o", "        for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[219.023887, "o", "\u001b[?2004h> "]
[219.024077, "o", "            tfidf = tf * idf.get(term, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.024245, "o", "> "]
[219.024331, "o", "            doc_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.030918, "o", "> "]
[219.031098, "o", "            norm_sq += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.031288, "o", "            local_inverted[term].append((doc_id, tfidf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.031415, "o", "> "]
[219.031556, "o", "        local_doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.031587, "o", "> "]
[219.031886, "o", "        local_doc_norms[doc_id] = math.sqrt(norm_sq)\r\n\u001b[?2004l\r"]
[219.03192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rb"]
[219.031949, "o", "\u001b[?2004h> "]
[219.032299, "o", "    return local_doc_vectors, local_doc_norms, local_inverted\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.032339, "o", "> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[219.032369, "o", "\r\n\u001b[?2004l\r"]
[219.032405, "o", "\u001b[?2004h> "]
[219.032866, "o", "# ==========================================================================\r\n\u001b[?2004l\r"]
[219.032902, "o", "\u001b[?2004h> "]
[219.033042, "o", "# Parallel Index Building\r\n\u001b[?2004l\r"]
[219.03307, "o", "\u001b[?2004h> "]
[219.033523, "o", "# ==========================================================================\r\n\u001b[?2004l\r"]
[219.033559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.033587, "o", "> \r\n\u001b[?2004l\r"]
[219.033618, "o", "\u001b[?2004h> "]
[219.034355, "o", "def build_tfidf_index_parallel(documents: List[Document], num_workers: int = None, chunk_size: int = 500) -> ParallelIndexingResult:\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.034391, "o", "> "]
[219.03456, "o", "    start_time = time.perf_counter()\r\n\u001b[?2004l\r"]
[219.034593, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.03462, "o", "> "]
[219.034741, "o", "    index = TFIDFIndex()\r\n\u001b[?2004l\r"]
[219.034767, "o", "\u001b[?2004h> "]
[219.034985, "o", "    index.num_documents = len(documents)\r\n\u001b[?2004l\r"]
[219.035023, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.035197, "o", "    if num_workers is None:\r\n\u001b[?2004l\r"]
[219.03523, "o", "\u001b[?2004h> "]
[219.035508, "o", "        num_workers = os.cpu_count() or 1\r\n\u001b[?2004l\r"]
[219.035588, "o", "\u001b[?2004h> "]
[219.035806, "o", "    num_workers = max(1, min(num_workers, len(documents) or 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.036183, "o", "    # Step 1: Tokenize documents and compute TF (parallel)\r\n\u001b[?2004l\r\u001b[?2004h>     doc_term_freqs: Dict[int, Dict[str, float]] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.040464, "o", "    doc_terms: Dict[int, set[str]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.040517, "o", "> "]
[219.040655, "o", "    vocabulary: set[str] = set()\r\n\u001b[?2004l\r"]
[219.040688, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.04072, "o", "\u001b[?2004h> "]
[219.041111, "o", "    if num_workers <= 1 or len(documents) <= chunk_size:\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.041143, "o", "> "]
[219.041322, "o", "        for doc in documents:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.041602, "o", "            text = doc.title + \" \" + doc.content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.042297, "o", "            tokens = tokenize(text)\r\n\u001b[?2004l\r\u001b[?2004h>             tf = compute_term_frequencies(tokens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.042587, "o", "            doc_term_freqs[doc.doc_id] = tf\r\n"]
[219.04298, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.043152, "o", "            doc_terms[doc.doc_id] = set(tf.keys())\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.043238, "o", "> "]
[219.043459, "o", "            vocabulary.update(tf.keys())\r\n\u001b[?2004l\r"]
[219.043653, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[219.043845, "o", "\u001b[?2004h> "]
[219.044113, "o", "        chunks = [documents[i : i + chunk_size] for i in range(0, len(documents), chunk_size)]\r\n\u001b[?2004l\r"]
[219.04418, "o", "\u001b[?2004h> "]
[219.04459, "o", "        with ProcessPoolExecutor(max_workers=num_workers) as executor:\r\n"]
[219.044737, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.04852, "o", "            for local_doc_term_freqs, local_doc_terms, local_vocab in executor.map(_process_documents_chunk, chunks):"]
[219.048907, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.049317, "o", "                # Merge in chunk order to preserve document ordering"]
[219.049428, "o", "\r\n\u001b[?2004l\r"]
[219.049477, "o", "\u001b[?2004h> "]
[219.049831, "o", "                for doc_id, tf in local_doc_term_freqs.items():"]
[219.049893, "o", "\r\n\u001b[?2004l\r"]
[219.049925, "o", "\u001b[?2004h> "]
[219.050283, "o", "                    doc_term_freqs[doc_id] = tf\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.050341, "o", "> "]
[219.050749, "o", "                for doc_id, terms in local_doc_terms.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.05097, "o", "                    doc_terms[doc_id] = terms"]
[219.051053, "o", "\r\n\u001b[?2004l\r"]
[219.051093, "o", "\u001b[?2004h> "]
[219.051344, "o", "                vocabulary.update(local_vocab)\r\n\u001b[?2004l\r"]
[219.051377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.051412, "o", "\u001b[?2004h> "]
[219.051599, "o", "    index.vocabulary = vocabulary\r\n\u001b[?2004l\r"]
[219.051637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.05174, "o", "\u001b[?2004h> "]
[219.051966, "o", "    # Step 2: Document frequencies (use counting)\r\n\u001b[?2004l\r"]
[219.052003, "o", "\u001b[?2004h> "]
[219.052187, "o", "    df_counts = defaultdict(int)"]
[219.052385, "o", "\r\n\u001b[?2004l\r"]
[219.052418, "o", "\u001b[?2004h> "]
[219.052645, "o", "    for terms in doc_terms.values():\r\n\u001b[?2004l\r"]
[219.052804, "o", "\u001b[?2004h>         for term in terms:\r\n\u001b[?2004l\r"]
[219.052848, "o", "\u001b[?2004h> "]
[219.053115, "o", "            df_counts[term] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.053508, "o", "    index.document_frequencies = dict(df_counts)"]
[219.053606, "o", "\r\n"]
[219.053691, "o", "\u001b[?2004l\r"]
[219.053816, "o", "\u001b[?2004h"]
[219.053949, "o", "> "]
[219.05409, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.054248, "o", "    # Step 3: IDF scores"]
[219.054372, "o", "\r\n"]
[219.054507, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.054873, "o", "    N = index.num_documents if index.num_documents > 0 else 1"]
[219.054969, "o", "\r\n"]
[219.055047, "o", "\u001b[?2004l\r"]
[219.055143, "o", "\u001b[?2004h"]
[219.055233, "o", "> "]
[219.055614, "o", "    for term, df in index.document_frequencies.items():"]
[219.055721, "o", "\r\n"]
[219.055839, "o", "\u001b[?2004l\r"]
[219.056173, "o", "\u001b[?2004h> "]
[219.056311, "o", "        index.idf[term] = math.log(N / df) + 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.056802, "o", "    # Step 4 & 5: Build inverted index and doc vectors (parallel)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.057172, "o", "    # Prepare ordered doc_items based on input document order\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.057422, "o", "> "]
[219.057628, "o", "    doc_order = [doc.doc_id for doc in documents]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.057887, "o", "    doc_positions = {doc_id: pos for pos, doc_id in enumerate(doc_order)}\r\n\u001b[?2004l\r"]
[219.058059, "o", "\u001b[?2004h> "]
[219.058331, "o", "    doc_items = [(doc_id, doc_term_freqs[doc_id]) for doc_id in doc_order]\r\n\u001b[?2004l\r"]
[219.05848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[219.058712, "o", "    if num_workers <= 1 or len(doc_items) <= chunk_size:\r\n\u001b[?2004l\r"]
[219.058854, "o", "\u001b[?2004h> "]
[219.058981, "o", "        for doc_id, tf_dict in doc_items:\r\n\u001b[?2004l\r"]
[219.059017, "o", "\u001b[?2004h> "]
[219.059172, "o", "            doc_vector = {}\r\n\u001b[?2004l\r"]
[219.059306, "o", "\u001b[?2004h> "]
[219.059425, "o", "            norm_sq = 0.0\r\n\u001b[?2004l\r"]
[219.059461, "o", "\u001b[?2004h> "]
[219.059653, "o", "            for term, tf in tf_dict.items():\r\n\u001b[?2004l\r"]
[219.059764, "o", "\u001b[?2004h> "]
[219.059991, "o", "                tfidf = tf * index.idf.get(term, 0.0)\r\n\u001b[?2004l\r"]
[219.060023, "o", "\u001b[?2004h> "]
[219.060271, "o", "                doc_vector[term] = tfidf\r\n\u001b[?2004l\r"]
[219.060305, "o", "\u001b[?2004h> "]
[219.06052, "o", "                norm_sq += tfidf * tfidf\r\n\u001b[?2004l\r"]
[219.060556, "o", "\u001b[?2004h> "]
[219.060979, "o", "                index.inverted_index.setdefault(term, []).append((doc_id, tfidf))\r\n\u001b[?2004l\r"]
[219.061008, "o", "\u001b[?2004h> "]
[219.061281, "o", "            index.doc_vectors[doc_id] = doc_vector\r\n\u001b[?2004l\r"]
[219.061458, "o", "\u001b[?2004h> "]
[219.061585, "o", "            index.doc_norms[doc_id] = math.sqrt(norm_sq)\r\n\u001b[?2004l\r"]
[219.061626, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[219.061657, "o", "\u001b[?2004h> "]
[219.061915, "o", "        chunks = [doc_items[i : i + chunk_size] for i in range(0, len(doc_items), chunk_size)]\r\n\u001b[?2004l\r"]
[219.061983, "o", "\u001b[?2004h> "]
[219.062271, "o", "        with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_tfidf_worker, initargs=(index.idf,)) as executor:\r\n\u001b[?2004l\r"]
[219.062329, "o", "\u001b[?2004h> "]
[219.062583, "o", "            for local_doc_vectors, local_doc_norms, local_inverted in executor.map(_process_tfidf_chunk, chunks):\r\n\u001b[?2004l\r"]
[219.062639, "o", "\u001b[?2004h> "]
[219.062759, "o", "                index.doc_vectors.update(local_doc_vectors)\r\n\u001b[?2004l\r"]
[219.062811, "o", "\u001b[?2004h> "]
[219.062919, "o", "                index.doc_norms.update(local_doc_norms)\r\n\u001b[?2004l\r"]
[219.062978, "o", "\u001b[?2004h> "]
[219.063123, "o", "                for term, postings in local_inverted.items():\r\n\u001b[?2004l\r"]
[219.063176, "o", "\u001b[?2004h> "]
[219.063347, "o", "                    index.inverted_index.setdefault(term, []).extend(postings)\r\n\u001b[?2004l\r"]
[219.063423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.063587, "o", "    # Sort posting lists by score descending; tie-break by document order\r\n\u001b[?2004l\r"]
[219.063616, "o", "\u001b[?2004h> "]
[219.063775, "o", "    for term, posting_list in index.inverted_index.items():\r\n\u001b[?2004l\r"]
[219.063804, "o", "\u001b[?2004h> "]
[219.064012, "o", "        posting_list.sort(key=lambda x: (-x[1], doc_positions.get(x[0], 0)))\r\n\u001b[?2004l\r"]
[219.064042, "o", "\u001b[?2004h> "]
[219.064071, "o", "\r\n\u001b[?2004l\r"]
[219.064175, "o", "\u001b[?2004h> "]
[219.064279, "o", "    elapsed = time.perf_counter() - start_time\r\n\u001b[?2004l\r"]
[219.064382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.064698, "o", "    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\r\n\u001b[?2004l\r"]
[219.064736, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.064846, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.064912, "o", "> "]
[219.064996, "o", "# ==========================================================================\r\n\u001b[?2004l\r"]
[219.065032, "o", "\u001b[?2004h> "]
[219.065101, "o", "# Parallel Search\r\n\u001b[?2004l\r"]
[219.065132, "o", "\u001b[?2004h> "]
[219.065342, "o", "# ==========================================================================\r\n\u001b[?2004l\r"]
[219.065446, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.065542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _GLOBAL_INDEX = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.065613, "o", "_GLOBAL_DOC_TITLES = None\r\n\u001b[?2004l\r"]
[219.065678, "o", "\u001b[?2004h> "]
[219.065734, "o", "_GLOBAL_TOP_K = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.065764, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.065794, "o", "> "]
[219.066015, "o", "def _init_search_worker(index: TFIDFIndex, doc_titles: Dict[int, str], top_k: int):\r\n\u001b[?2004l\r"]
[219.066053, "o", "\u001b[?2004h> "]
[219.066227, "o", "    global _GLOBAL_INDEX, _GLOBAL_DOC_TITLES, _GLOBAL_TOP_K\r\n\u001b[?2004l\r"]
[219.066264, "o", "\u001b[?2004h> "]
[219.066348, "o", "    _GLOBAL_INDEX = index\r\n\u001b[?2004l\r"]
[219.066383, "o", "\u001b[?2004h> "]
[219.066495, "o", "    _GLOBAL_DOC_TITLES = doc_titles\r\n\u001b[?2004l\r"]
[219.066524, "o", "\u001b[?2004h> "]
[219.066616, "o", "    _GLOBAL_TOP_K = top_k\r\n\u001b[?2004l\r"]
[219.066645, "o", "\u001b[?2004h> \r\n"]
[219.066672, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.066761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.067048, "o", "def _search_single(query: str, index: TFIDFIndex, top_k: int, doc_titles: Dict[int, str] = None) -> List[SearchResult]:\r\n\u001b[?2004l\r"]
[219.067089, "o", "\u001b[?2004h> "]
[219.067193, "o", "    query_tokens = tokenize(query)\r\n\u001b[?2004l\r"]
[219.067224, "o", "\u001b[?2004h> "]
[219.067304, "o", "    if not query_tokens:\r\n\u001b[?2004l\r"]
[219.067336, "o", "\u001b[?2004h> "]
[219.067409, "o", "        return []\r\n\u001b[?2004l\r"]
[219.067445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.067473, "o", "\u001b[?2004h> "]
[219.067638, "o", "    query_tf = compute_term_frequencies(query_tokens)\r\n\u001b[?2004l\r"]
[219.067669, "o", "\u001b[?2004h> \r\n"]
[219.067697, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.067799, "o", ">     query_vector = {}\r\n\u001b[?2004l\r"]
[219.067886, "o", "\u001b[?2004h> "]
[219.067963, "o", "    query_norm_sq = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.068029, "o", "    for term, tf in query_tf.items():\r\n\u001b[?2004l\r"]
[219.06806, "o", "\u001b[?2004h> "]
[219.068169, "o", "        if term in index.idf:\r\n\u001b[?2004l\r"]
[219.068215, "o", "\u001b[?2004h> "]
[219.068329, "o", "            tfidf = tf * index.idf[term]\r\n\u001b[?2004l\r"]
[219.06841, "o", "\u001b[?2004h> "]
[219.068661, "o", "            query_vector[term] = tfidf\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.068709, "o", "> "]
[219.068834, "o", "            query_norm_sq += tfidf * tfidf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.06892, "o", "    if not query_vector:\r\n\u001b[?2004l\r"]
[219.068951, "o", "\u001b[?2004h> "]
[219.069025, "o", "        return []\r\n\u001b[?2004l\r"]
[219.069127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.069193, "o", "    query_norm = math.sqrt(query_norm_sq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.069231, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.069314, "o", "    candidate_docs = set()\r\n\u001b[?2004l\r"]
[219.069346, "o", "\u001b[?2004h> "]
[219.069468, "o", "    for term in query_vector:\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.069501, "o", "> "]
[219.069584, "o", "        if term in index.inverted_index:\r\n\u001b[?2004l\r"]
[219.069615, "o", "\u001b[?2004h> "]
[219.069751, "o", "            for doc_id, _ in index.inverted_index[term]:\r\n\u001b[?2004l\r"]
[219.069848, "o", "\u001b[?2004h> "]
[219.069961, "o", "                candidate_docs.add(doc_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.070116, "o", "    scores = []\r\n\u001b[?2004l\r\u001b[?2004h>     for doc_id in candidate_docs:\r\n\u001b[?2004l\r"]
[219.070193, "o", "\u001b[?2004h> "]
[219.070428, "o", "        doc_vector = index.doc_vectors.get(doc_id, {})\r\n\u001b[?2004l\r\u001b[?2004h>         doc_norm = index.doc_norms.get(doc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.070499, "o", "        if doc_norm == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.070638, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.070822, "o", "        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.070905, "o", "> "]
[219.071013, "o", "        similarity = dot_product / (query_norm * doc_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.071132, "o", "        scores.append((doc_id, similarity))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.071216, "o", "\u001b[?2004h> "]
[219.071295, "o", "    top_results = nlargest(top_k, scores, key=lambda x: x[1])\r\n\u001b[?2004l\r"]
[219.07137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.07145, "o", "    results: List[SearchResult] = []\r\n\u001b[?2004l\r"]
[219.071533, "o", "\u001b[?2004h> "]
[219.071607, "o", "    titles = doc_titles or {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.071758, "o", "    for doc_id, score in top_results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072012, "o", "        results.append(SearchResult(doc_id=doc_id, score=score, title=titles.get(doc_id, f\"Document {doc_id}\")))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072189, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072283, "o", "def _search_worker(query: str) -> List[SearchResult]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072505, "o", "    return _search_single(query, _GLOBAL_INDEX, _GLOBAL_TOP_K, _GLOBAL_DOC_TITLES)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.07264, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def batch_search_parallel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.072721, "o", ">     queries: List[str],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072809, "o", "    index: TFIDFIndex,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072893, "o", "    top_k: int = 10,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.072961, "o", "    num_workers: int = None,\r\n\u001b[?2004l\r"]
[219.073026, "o", "\u001b[?2004h> "]
