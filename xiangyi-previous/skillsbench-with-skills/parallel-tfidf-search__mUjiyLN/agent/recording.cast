[219.006268, "i", "cat <<'PY' > /root/workspace/parallel_solution.py\n#!/usr/bin/env python3\n\"\"\"\nParallel TF-IDF Implementation\n\nProvides parallelized versions of TF-IDF index building and batch search.\n\"\"\"\n\nimport math\nimport os\nimport re\nimport time\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom typing import Dict, List, Tuple\nfrom concurrent.futures import ProcessPoolExecutor\n\nfrom document_generator import Document\n\n# ==========================================================================\n# Text Processing (same as sequential)\n# ==========================================================================\n\nSTOP_WORDS = frozenset(\n    [\n        \"a\",\n        \"an\",\n        \"and\",\n        \"are\",\n        \"as\",\n        \"at\",\n        \"be\",\n        \"by\",\n        \"for\",\n        \"from\",\n        \"has\",\n        \"he\",\n        \"in\",\n        \"is\",\n        \"it\",\n        \"its\",\n        \"of\",\n        \"on\",\n        \"that\",\n        \"the\",\n        \"to\",\n        \"was\",\n        \"were\",\n        \"will\",\n        \"with\",\n        \"the\",\n        \"this\",\n        \"but\",\n        \"they\",\n        \"have\",\n        \"had\",\n        \"what\",\n        \"when\",\n        \"where\",\n        \"who\",\n        \"which\",\n        \"why\",\n        \"how\",\n        \"all\",\n        \"each\",\n        \"every\",\n        \"both\",\n        \"few\",\n        \"more\",\n        \"most\",\n        \"other\",\n        \"some\",\n        \"such\",\n        \"no\",\n        \"not\",\n        \"only\",\n        \"same\",\n        \"so\",\n        \"than\",\n        \"too\",\n        \"very\",\n        \"just\",\n        \"can\",\n        \"should\",\n        \"now\",\n        \"or\",\n        \"if\",\n        \"then\",\n        \"because\",\n        \"about\",\n        \"into\",\n        \"through\",\n        \"during\",\n        \"before\",\n        \"after\",\n        \"above\",\n        \"below\",\n        \"between\",\n        \"under\",\n        \"again\",\n        \"further\",\n        \"once\",\n        \"here\",\n        \"there\",\n        \"any\",\n        \"do\",\n        \"does\",\n        \"did\",\n        \"doing\",\n        \"would\",\n        \"could\",\n        \"might\",\n        \"must\",\n        \"shall\",\n        \"may\",\n        \"been\",\n        \"being\",\n        \"am\",\n    ]\n)\n\nTOKEN_PATTERN = re.compile(r\"\\b[a-zA-Z]{2,}\\b\")\n\n\ndef tokenize(text: str) -> List[str]:\n    tokens = TOKEN_PATTERN.findall(text.lower())\n    return [t for t in tokens if t not in STOP_WORDS]\n\n\ndef compute_term_frequencies(tokens: List[str]) -> Dict[str, float]:\n    if not tokens:\n        return {}\n    counts = defaultdict(int)\n    for token in tokens:\n        counts[token] += 1\n    total = len(tokens)\n    return {term: count / total for term, count in counts.items()}\n\n\n# ==========================================================================\n# Data Structures (same as sequential)\n# ==========================================================================\n\n\n@dataclass\nclass TFIDFIndex:\n    num_documents: int = 0\n    vocabulary: set[str] = field(default_factory=set)\n    document_frequencies: Dict[str, int] = field(default_factory=dict)\n    idf: Dict[str, float] = field(default_factory=dict)\n    inverted_index: Dict[str, List[Tuple[int, float]]] = field(default_factory=dict)\n    doc_vectors: Dict[int, Dict[str, float]] = field(default_factory=dict)\n    doc_norms: Dict[int, float] = field(default_factory=dict)\n\n\n@dataclass\nclass SearchResult:\n    doc_id: int\n    score: float\n    title: str = \"\"\n\n\n@dataclass\nclass ParallelIndexingResult:\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ==========================================================================\n# Parallel Index Building Helpers\n# ==========================================================================\n\n\ndef _process_documents_chunk(chunk: List[Document]):\n    local_doc_term_freqs: Dict[int, Dict[str, float]] = {}\n    local_doc_terms: Dict[int, set[str]] = {}\n    local_vocab: set[str] = set()\n\n    for doc in chunk:\n        text = doc.title + \" \" + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        local_doc_term_freqs[doc.doc_id] = tf\n       "]
[219.006539, "i", " local_doc_terms[doc.doc_id] = set(tf.keys())\n        local_vocab.update(tf.keys())\n\n    return local_doc_term_freqs, local_doc_terms, local_vocab\n\n\n_GLOBAL_IDF = None\n\n\ndef _init_tfidf_worker(idf: Dict[str, float]):\n    global _GLOBAL_IDF\n    _GLOBAL_IDF = idf\n\n\ndef _process_tfidf_chunk(doc_items: List[Tuple[int, Dict[str, float]]]):\n    idf = _GLOBAL_IDF\n    local_doc_vectors: Dict[int, Dict[str, float]] = {}\n    local_doc_norms: Dict[int, float] = {}\n    local_inverted: Dict[str, List[Tuple[int, float]]] = defaultdict(list)\n\n    for doc_id, tf_dict in doc_items:\n        doc_vector: Dict[str, float] = {}\n        norm_sq = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * idf.get(term, 0.0)\n            doc_vector[term] = tfidf\n            norm_sq += tfidf * tfidf\n            local_inverted[term].append((doc_id, tfidf))\n        local_doc_vectors[doc_id] = doc_vector\n        local_doc_norms[doc_id] = math.sqrt(norm_sq)\n\n    return local_doc_vectors, local_doc_norms, local_inverted\n\n\n# ==========================================================================\n# Parallel Index Building\n# ==========================================================================\n\n\ndef build_tfidf_index_parallel(documents: List[Document], num_workers: int = None, chunk_size: int = 500) -> ParallelIndexingResult:\n    start_time = time.perf_counter()\n\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n\n    if num_workers is None:\n        num_workers = os.cpu_count() or 1\n    num_workers = max(1, min(num_workers, len(documents) or 1))\n\n    # Step 1: Tokenize documents and compute TF (parallel)\n    doc_term_freqs: Dict[int, Dict[str, float]] = {}\n    doc_terms: Dict[int, set[str]] = {}\n    vocabulary: set[str] = set()\n\n    if num_workers <= 1 or len(documents) <= chunk_size:\n        for doc in documents:\n            text = doc.title + \" \" + doc.content\n            tokens = tokenize(text)\n            tf = compute_term_frequencies(tokens)\n            doc_term_freqs[doc.doc_id] = tf\n            doc_terms[doc.doc_id] = set(tf.keys())\n            vocabulary.update(tf.keys())\n    else:\n        chunks = [documents[i : i + chunk_size] for i in range(0, len(documents), chunk_size)]\n        with ProcessPoolExecutor(max_workers=num_workers) as executor:\n            for local_doc_term_freqs, local_doc_terms, local_vocab in executor.map(_process_documents_chunk, chunks):\n                # Merge in chunk order to preserve document ordering\n                for doc_id, tf in local_doc_term_freqs.items():\n                    doc_term_freqs[doc_id] = tf\n                for doc_id, terms in local_doc_terms.items():\n                    doc_terms[doc_id] = terms\n                vocabulary.update(local_vocab)\n\n    index.vocabulary = vocabulary\n\n    # Step 2: Document frequencies (use counting)\n    df_counts = defaultdict(int)\n    for terms in doc_terms.values():\n        for term in terms:\n            df_counts[term] += 1\n    index.document_frequencies = dict(df_counts)\n\n    # Step 3: IDF scores\n    N = index.num_documents if index.num_documents > 0 else 1\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n\n    # Step 4 & 5: Build inverted index and doc vectors (parallel)\n    # Prepare ordered doc_items based on input document order\n    doc_order = [doc.doc_id for doc in documents]\n    doc_positions = {doc_id: pos for pos, doc_id in enumerate(doc_order)}\n    doc_items = [(doc_id, doc_term_freqs[doc_id]) for doc_id in doc_order]\n\n    if num_workers <= 1 or len(doc_items) <= chunk_size:\n        for doc_id, tf_dict in doc_items:\n            doc_vector = {}\n            norm_sq = 0.0\n            for term, tf in tf_dict.items():\n                tfidf = tf * index.idf.get(term, 0.0)\n                doc_vector[term] = tfidf\n                norm_sq += tfidf * tfidf\n                index.inverted_index.setdefault(term, []).append((doc_id, tfidf))\n            index.doc_vectors[doc_id] = doc_vector\n            index.doc_norms[doc_id] = math.sqrt(norm_sq)\n    else:\n        chunks = [doc_items[i "]
[219.006643, "i", ": i + chunk_size] for i in range(0, len(doc_items), chunk_size)]\n        with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_tfidf_worker, initargs=(index.idf,)) as executor:\n            for local_doc_vectors, local_doc_norms, local_inverted in executor.map(_process_tfidf_chunk, chunks):\n                index.doc_vectors.update(local_doc_vectors)\n                index.doc_norms.update(local_doc_norms)\n                for term, postings in local_inverted.items():\n                    index.inverted_index.setdefault(term, []).extend(postings)\n\n    # Sort posting lists by score descending; tie-break by document order\n    for term, posting_list in index.inverted_index.items():\n        posting_list.sort(key=lambda x: (-x[1], doc_positions.get(x[0], 0)))\n\n    elapsed = time.perf_counter() - start_time\n\n    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\n\n# ==========================================================================\n# Parallel Search\n# ==========================================================================\n\n\n_GLOBAL_INDEX = None\n_GLOBAL_DOC_TITLES = None\n_GLOBAL_TOP_K = None\n\n\ndef _init_search_worker(index: TFIDFIndex, doc_titles: Dict[int, str], top_k: int):\n    global _GLOBAL_INDEX, _GLOBAL_DOC_TITLES, _GLOBAL_TOP_K\n    _GLOBAL_INDEX = index\n    _GLOBAL_DOC_TITLES = doc_titles\n    _GLOBAL_TOP_K = top_k\n\n\ndef _search_single(query: str, index: TFIDFIndex, top_k: int, doc_titles: Dict[int, str] = None) -> List[SearchResult]:\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n\n    query_tf = compute_term_frequencies(query_tokens)\n\n    query_vector = {}\n    query_norm_sq = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_sq += tfidf * tfidf\n\n    if not query_vector:\n        return []\n\n    query_norm = math.sqrt(query_norm_sq)\n\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        if doc_norm == 0:\n            continue\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n\n    results: List[SearchResult] = []\n    titles = doc_titles or {}\n    for doc_id, score in top_results:\n        results.append(SearchResult(doc_id=doc_id, score=score, title=titles.get(doc_id, f\"Document {doc_id}\")))\n\n    return results\n\n\ndef _search_worker(query: str) -> List[SearchResult]:\n    return _search_single(query, _GLOBAL_INDEX, _GLOBAL_TOP_K, _GLOBAL_DOC_TITLES)\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: int = None,\n    documents: List[Document] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    start_time = time.perf_counter()\n\n    if num_workers is None:\n        num_workers = os.cpu_count() or 1\n    num_workers = max(1, min(num_workers, len(queries) or 1))\n\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n\n    if num_workers <= 1 or len(queries) <= 1:\n        results = [_search_single(q, index, top_k, doc_titles) for q in queries]\n    else:\n        chunksize = max(1, len(queries) // (num_workers * 4))\n        with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, doc_titles, top_k)) as executor:\n            results = list(executor.map(_search_worker, queries, chunksize=chunksize))\n\n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\n\nPY\n"]
