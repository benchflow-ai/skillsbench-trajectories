[224.986838, "o", "#!/usr/bin/env python3\r\n\"\"\"\r\nParallel TF-IDF Implementation\r\n\r\nProvides parallelized versions of TF-IDF index building and batch search.\r\n\"\"\"\r\n\r\nimport math\r\nimport os\r\nimport re\r\nimport time\r\nfrom collections import defaultdict\r\nfrom dataclasses import dataclass, field\r\nfrom heapq import nlargest\r\nfrom typing import Dict, List, Tuple\r\nfrom concurrent.futures import ProcessPoolExecutor\r\n\r\nfrom document_generator import Document\r\n\r\n# ==========================================================================\r\n"]
[224.987098, "o", "\u001b[?2004hroot@1625e44189d9:~# "]
[225.188257, "i", "tail -n 20 /root/workspace/parallel_solution.py\n"]
[225.188632, "o", "tail -n 20 /root/workspace/parallel_solution.py\r\n\u001b[?2004l\r"]
[225.189773, "o", "    documents: List[Document] = None,\r\n) -> Tuple[List[List[SearchResult]], float]:\r\n    start_time = time.perf_counter()\r\n\r\n    if num_workers is None:\r\n        num_workers = os.cpu_count() or 1\r\n    num_workers = max(1, min(num_workers, len(queries) or 1))\r\n\r\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\r\n\r\n    if num_workers <= 1 or len(queries) <= 1:\r\n        results = [_search_single(q, index, top_k, doc_titles) for q in queries]\r\n    else:\r\n        chunksize = max(1, len(queries) // (num_workers * 4))\r\n        with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, doc_titles, top_k)) as executor:\r\n            results = list(executor.map(_search_worker, queries, chunksize=chunksize))\r\n\r\n    elapsed = time.perf_counter() - start_time\r\n    return results, elapsed\r\n\r\n"]
[225.189919, "o", "\u001b[?2004hroot@1625e44189d9:~# "]
[233.071376, "i", "nl -ba /root/workspace/parallel_solution.py | head -n 25\n"]
[233.071871, "o", "nl -ba /root/workspace/parallel_solution.py | head -n 25\r\n\u001b[?2004l\r"]
[233.073425, "o", "     1\t#!/usr/bin/env python3\r\n     2\t\"\"\"\r\n     3\tParallel TF-IDF Implementation\r\n     4\t\r\n     5\tProvides parallelized versions of TF-IDF index building and batch search.\r\n     6\t\"\"\"\r\n     7\t\r\n     8\timport math\r\n     9\timport os\r\n    10\timport re\r\n    11\timport time\r\n    12\tfrom collections import defaultdict\r\n    13\tfrom dataclasses import dataclass, field\r\n    14\tfrom heapq import nlargest\r\n    15\tfrom typing import Dict, List, Tuple\r\n    16\tfrom concurrent.futures import ProcessPoolExecutor\r\n    17\t\r\n    18\tfrom document_generator import Document\r\n    19\t\r\n"]
[233.073467, "o", "    20\t# ==========================================================================\r\n    21\t# Text Processing (same as sequential)\r\n    22\t# ==========================================================================\r\n    23\t\r\n    24\tSTOP_WORDS = frozenset(\r\n    25\t    [\r\n"]
[233.073642, "o", "\u001b[?2004hroot@1625e44189d9:~# "]
[287.190982, "i", "python3 - <<'PY'\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\n# generate small corpus\ncorpus = generate_corpus(50, seed=42)\nseq_res = build_tfidf_index_sequential(corpus)\npar_res = build_tfidf_index_parallel(corpus, num_workers=2, chunk_size=10)\n\nprint('vocab', len(seq_res.index.vocabulary), len(par_res.index.vocabulary))\nprint('idf equal', all(abs(seq_res.index.idf[t]-par_res.index.idf[t])<1e-12 for t in seq_res.index.idf))\n\nquery = 'machine learning algorithm'\nseq_results = search_sequential(query, seq_res.index, top_k=5, documents=corpus)\npar_results, _ = batch_search_parallel([query], par_res.index, top_k=5, num_workers=2, documents=corpus)\npar_results = par_results[0]\nprint('seq ids', [r.doc_id for r in seq_results])\nprint('par ids', [r.doc_id for r in par_results])\nprint('seq scores', [round(r.score,6) for r in seq_results])\nprint('par scores', [round(r.score,6) for r in par_results])\nPY\n"]
