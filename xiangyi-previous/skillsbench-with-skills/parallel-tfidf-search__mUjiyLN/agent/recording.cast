[349.484635, "i", "cd /root/workspace\npython3 - <<'PY'\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ncorpus = generate_corpus(100, seed=1)\nseq_res = build_tfidf_index_sequential(corpus)\npar_res = build_tfidf_index_parallel(corpus, num_workers=2, chunk_size=20)\n\nqueries = [\"machine learning algorithm\", \"business strategy growth\", \"scientific experiment data\", \"network security encryption\"]\nseq_results = batch_search_sequential(queries, seq_res.index, top_k=5, documents=corpus)\npar_results, _ = batch_search_parallel(queries, par_res.index, top_k=5, num_workers=2, documents=corpus)\n\nok = True\nfor i, (s, p) in enumerate(zip(seq_results, par_results)):\n    if [r.doc_id for r in s] != [r.doc_id for r in p] or [round(r.score,6) for r in s] != [round(r.score,6) for r in p]:\n        print('Mismatch at', i)\n        print([r.doc_id for r in s], [r.doc_id for r in p])\n        print([r.score for r in s], [r.score for r in p])\n        ok = False\n        break\nprint('match', ok)\nPY\n"]
