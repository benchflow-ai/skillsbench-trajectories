Sending keys: ['cat <<EOF > simulation.py\nimport pandas as pd\nimport yaml\nimport numpy as np\nfrom acc_system import AdaptiveCruiseControl\n\ndef run_simulation():\n    with open(\'vehicle_params.yaml\', \'r\') as f:\n        config = yaml.safe_load(f)\n    try:\n        with open(\'tuning_results.yaml\', \'r\') as f:\n            tuning = yaml.safe_load(f)\n        config[\'pid_speed\'].update(tuning[\'pid_speed\'])\n        config[\'pid_distance\'].update(tuning[\'pid_distance\'])\n    except FileNotFoundError:\n        pass\n\n    sensor_data = pd.read_csv(\'sensor_data.csv\')\n    acc = AdaptiveCruiseControl(config)\n    dt = config[\'simulation\'][\'dt\']\n\n    results = []\n    my_ego_speed = 0.0\n    my_ego_pos = 0.0\n    \n    # We need to reconstruct the lead vehicle\'s position\n    # The CSV gives us ego_speed(csv) and distance(csv)\n    # We can integrate ego_speed(csv) to get ego_pos(csv)\n    csv_ego_pos = 0.0\n    \n    for i, row in sensor_data.iterrows():\n        time = row[\'time\']\n        csv_ego_speed = row[\'ego_speed\']\n        csv_lead_speed = row[\'lead_speed\']\n        csv_distance = row[\'distance\']\n\n        # Lead vehicle absolute position and speed\n        if not np.isnan(csv_distance):\n            lead_pos = csv_ego_pos + csv_distance\n            lead_speed = csv_lead_speed\n            \n            # My distance to lead vehicle\n            my_distance = lead_pos - my_ego_pos\n        else:\n            lead_speed = None\n            my_distance = None\n\n        accel_cmd, mode, dist_err = acc.compute(my_ego_speed, lead_speed, my_distance, dt)\n        \n        ttc = None\n        if my_distance is not None and lead_speed is not None:\n            rel_speed = my_ego_speed - lead_speed\n            if rel_speed > 0:\n                ttc = my_distance / rel_speed\n\n        results.append({\n            \'time\': time,\n            \'ego_speed\': round(my_ego_speed, 2),\n            \'acceleration_cmd\': round(accel_cmd, 2),\n            \'mode\': mode,\n            \'distance_error\': round(dist_err, 2) if dist_err is not None else \'\',\n            \'distance\': round(my_distance, 2) if my_distance is not None else \'\',\n            \'ttc\': round(ttc, 2) if ttc is not None else \'\'\n        })\n\n        # Update my ego state\n        my_ego_pos += my_ego_speed * dt + 0.5 * accel_cmd * dt**2\n        my_ego_speed += accel_cmd * dt\n        my_ego_speed = max(0, my_ego_speed)\n\n        # Update CSV ego position for next step\n        csv_ego_pos += csv_ego_speed * dt\n\n    df_results = pd.DataFrame(results)\n    df_results.to_csv(\'simulation_results.csv\', index=False)\n    print("Simulation complete. Results saved to simulation_results.csv")\n\nif __name__ == "__main__":\n    run_simulation()\nEOF\npython3 simulation.py\npython3 check_metrics.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
