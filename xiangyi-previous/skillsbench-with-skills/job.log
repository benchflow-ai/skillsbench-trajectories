Sending keys: ['python3 << \'EOF\'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\n\ndef compute_sta_lta(trace, dt, sta_len=0.5, lta_len=5.0):\n    """Compute STA/LTA ratio."""\n    sta_samples = max(1, int(sta_len / dt))\n    lta_samples = max(1, int(lta_len / dt))\n    \n    abs_trace = np.abs(trace)\n    sta = np.convolve(abs_trace, np.ones(sta_samples)/sta_samples, mode=\'same\')\n    lta = np.convolve(abs_trace, np.ones(lta_samples)/lta_samples, mode=\'same\')\n    \n    lta[lta < 1e-20] = 1e-20\n    return sta / lta\n\ndef pick_phases_optimized(data, dt, channels):\n    """Optimized phase picking."""\n    picks = []\n    \n    # Compute RMS across all channels\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    \n    # Apply multiple STA/LTA with different parameters\n    ratio1 = compute_sta_lta(rms, dt, sta_len=0.2, lta_len=2.0)\n    ratio2 = compute_sta_lta(rms, dt, sta_len=0.5, lta_len=5.0)\n    ratio3 = compute_sta_lta(rms, dt, sta_len=0.1, lta_len=1.0)\n    \n    # Combine ratios (average)\n    combined_ratio = (ratio1 + ratio2 + ratio3) / 3.0\n    \n    # Find peaks with adaptive threshold\n    min_dist = int(0.5 / dt)\n    \n    # Try different thresholds\n    for percentile in [85, 80, 75, 70]:\n        threshold = np.percentile(combined_ratio[100:], percentile)\n        peaks, _ = signal.find_peaks(combined_ratio, height=threshold, distance=min_dist)\n        \n        if len(peaks) >= 2:\n            break\n    \n    # Sort peaks by index (temporal order)\n    peaks = np.sort(peaks)\n    \n    # Assign P and S\n    if len(peaks) > 0:\n        picks.append((\'P\', int(peaks[0])))\n    if len(peaks) > 1:\n        picks.append((\'S\', int(peaks[1])))\n    \n    return picks\n\n# Process all files\ndata_dir = \'/root/data/\'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith(\'.npz\'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict[\'data\']\n            dt = float(data_dict[\'dt\'])\n            channels = str(data_dict[\'channels\'])\n            \n            picks = pick_phases_optimized(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    \'file_name\': filename,\n                    \'phase\': phase,\n                    \'pick_idx\': idx\n                })\n        except Exception as e:\n            print(f"Error processing {filename}: {e}")\n\n# Write results to CSV\nwith open(\'/root/results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'file_name\', \'phase\', \'pick_idx\'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f"Processed {len([f for f in os.listdir(data_dir) if f.endswith(\'.npz\')])} files")\nprint(f"Found {len(results)} picks")\nprint(f"P picks: {len([r for r in results if r[\'phase\'] == \'P\'])}")\nprint(f"S picks: {len([r for r in results if r[\'phase\'] == \'S\'])}")\n\n# Verify P before S\nfiles_dict = {}\nfor r in results:\n    fname = r[\'file_name\']\n    if fname not in files_dict:\n        files_dict[fname] = {}\n    files_dict[fname][r[\'phase\']] = int(r[\'pick_idx\'])\n\nwarnings = 0\nfor fname, picks in files_dict.items():\n    if \'P\' in picks and \'S\' in picks:\n        if picks[\'P\'] >= picks[\'S\']:\n            warnings += 1\n\nprint(f"Files with P before S: {100 - warnings}/100")\nprint("\\nResults saved to /root/results.csv")\n\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
