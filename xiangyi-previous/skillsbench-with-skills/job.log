Sending keys: ['cat >> acopf_v2.py << \'ENDOFFILE\'\n\n# Variables: Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)\n# Use polar coordinates but with better scaling\n\ndef calc_power(Vm, Va):\n    """Calculate P and Q injections at each bus"""\n    P = np.zeros(nbus)\n    Q = np.zeros(nbus)\n    for i in range(nbus):\n        for j in range(nbus):\n            angle = Va[i] - Va[j]\n            P[i] += Vm[i]*Vm[j]*(G[i,j]*np.cos(angle) + B[i,j]*np.sin(angle))\n            Q[i] += Vm[i]*Vm[j]*(G[i,j]*np.sin(angle) - B[i,j]*np.cos(angle))\n    return P, Q\n\ndef unpack(x):\n    Vm = x[:nbus]\n    Va = x[nbus:2*nbus]\n    Pg = x[2*nbus:2*nbus+ngen]\n    Qg = x[2*nbus+ngen:]\n    return Vm, Va, Pg, Qg\n\ndef objective(x):\n    Pg = x[2*nbus:2*nbus+ngen]\n    Pg_mw = Pg * baseMVA\n    return np.sum(cost_c2 * Pg_mw**2 + cost_c1 * Pg_mw + cost_c0)\n\ndef constraints(x):\n    Vm, Va, Pg, Qg = unpack(x)\n    P_calc, Q_calc = calc_power(Vm, Va)\n    Pg_bus = Cg @ Pg\n    Qg_bus = Cg @ Qg\n    P_mis = Pg_bus - Pd - P_calc\n    Q_mis = Qg_bus - Qd - Q_calc\n    return np.concatenate([P_mis, Q_mis])\nENDOFFILE\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
