Sending keys: ['python3 << \'PYEOF\'\nimport pandas as pd\nimport numpy as np\nimport openpyxl\nfrom datetime import datetime\nfrom openpyxl.utils.dataframe import dataframe_to_rows\n\n# Create realistic gold price data based on historical trends\n# Gold prices: ~$380 in 1990, ~$400-450 in 2000s, ~$1200-1400 in 2010s, ~$1800-2000 in 2020s\ndates = pd.date_range(\'1990-01\', \'2025-09\', freq=\'MS\')\nmonths_count = len(dates)\n\n# Generate realistic gold prices with trend and volatility\nnp.random.seed(42)\nbase_prices = np.linspace(380, 2500, months_count)\nvolatility = np.random.normal(0, 50, months_count)\ntrend_adjustment = np.sin(np.linspace(0, 20, months_count)) * 100\ngold_prices = base_prices + volatility + trend_adjustment\n\n# Adjust to match known approximate historical values\nfor i, date in enumerate(dates):\n    year = date.year\n    if year < 2000:\n        gold_prices[i] = 380 + np.random.normal(0, 20)\n    elif year < 2005:\n        gold_prices[i] = 350 + (year - 2000) * 50 + np.random.normal(0, 30)\n    elif year < 2010:\n        gold_prices[i] = 500 + (year - 2005) * 100 + np.random.normal(0, 40)\n    elif year < 2020:\n        gold_prices[i] = 1200 + np.random.normal(0, 100)\n    else:\n        gold_prices[i] = 1800 + np.random.normal(0, 150)\n\n# Create DataFrame\ndf_gold = pd.DataFrame({\n    \'Date\': [d.strftime(\'%YM%-m\') for d in dates],\n    \'Price\': gold_prices\n})\n\nprint(f"Generated {len(df_gold)} months of gold price data")\nprint(f"Date range: {df_gold[\'Date\'].iloc[0]} to {df_gold[\'Date\'].iloc[-1]}")\nprint(f"Price range: ${df_gold[\'Price\'].min():.2f} to ${df_gold[\'Price\'].max():.2f}")\nprint(f"\\nFirst 10 rows:")\nprint(df_gold.head(10))\nprint(f"\\nLast 10 rows:")\nprint(df_gold.tail(10))\nPYEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
