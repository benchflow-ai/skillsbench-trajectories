 -1:\n        if relocation_package == "Yes":\n            # Keep content, just remove markers\n            paragraphs[start_idx].text = paragraphs[start_idx].text.replace(\'{{IF_RELOCATION}}\', \'\')\n            paragraphs[end_idx].text = paragraphs[end_idx].text.replace(\'{{END_IF_RELOCATION}}\', \'\')\n        else:\n            # Remove all paragraphs between and including markers\n            # We\'ll do this later to not mess up indices\n            pass\n\n    # Re-run for tables if necessary, but usually markers are in paragraphs\n\n# Loading data\nwith open(\'employee_data.json\', \'r\') as f:\n    data = json.load(f)\n\ndoc = Document(\'offer_letter_template.docx\')\n\n# Handle relocation logic first\nparagraphs = list(doc.paragraphs)\nstart_p = -1\nend_p = -1\nfor i, p in enumerate(paragraphs):\n    if \'{{IF_RELOCATION}}\' in p.text:\n        start_p = i\n    if \'{{END_IF_RELOCATION}}\' in p.text:\n        end_p = i\n\nif start_p != -1 and end_p != -1:\n    if data.get(\'RELOCATION_PACKAGE\') == \'Yes\':\n        # Just remove the markers\n        doc.paragraphs[start_p].text = doc.paragraphs[start_p].text.replace(\'{{IF_RELOCATION}}\', \'\')\n        doc.paragraphs[end_p].text = doc.paragraphs[end_p].text.replace(\'{{END_IF_RELOCATION}}\', \'\')\n    else:\n        # Remove the paragraphs from end to start\n        for i in range(end_p, start_p - 1, -1):\n            p = doc.paragraphs[i]._element\n            p.getparent().remove(p)\n            p._p = p._element = None\n\n# Now replace all other placeholders\n# We\'ll iterate through all paragraphs and tables\n\ndef global_replace(doc, data):\n    for p in list(doc.paragraphs):\n        for key, value in data.items():\n            placeholder = f\'{{{{{key}}}}}\'\n            if placeholder in p.text:\n                p.text = p.text.replace(placeholder, str(value))\n    \n    for table in doc.tables:\n        for row in table.rows:\n            for cell in row.cells:\n                for p in cell.paragraphs:\n                    for key, value in data.items():\n                        placeholder = f\'{{{{{key}}}}}\'\n                        if placeholder in p.text:\n                            p.text = p.text.replace(placeholder, str(value))\n\nglobal_replace(doc, data)\n\ndoc.save(\'/root/offer_letter_filled.docx\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
