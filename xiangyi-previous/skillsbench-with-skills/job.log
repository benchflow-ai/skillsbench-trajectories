Sending keys: ['cat >> /root/unify_taxonomy.py << \'EOF\'\n\n# Process all records\nprint("Processing records...")\nall_records = []\nfor df, src in [(amazon_df, \'amazon\'), (fb_df, \'facebook\'), (google_df, \'google\')]:\n    for _, row in df.iterrows():\n        levels = parse_path(row[\'category_path\'])\n        if levels:\n            all_records.append({\'source\': src, \'path\': row[\'category_path\'], \'levels\': levels})\n\nprint(f"Total: {len(all_records)} records")\n\n# Build output with unified taxonomy\nprint("Building unified taxonomy...")\noutput_full = []\nhierarchy_set = set()\n\nfor r in all_records:\n    lvls = r[\'levels\']\n    \n    # Level 1: Use keyword-based mapping\n    u1 = get_unified_l1(lvls[0])\n    \n    # Level 2: Use semantic grouping based on L1 and original L2\n    orig_l2 = lvls[1] if len(lvls) > 1 else \'\'\n    # Also consider L1 original name for L2 mapping context\n    l2_context = f"{lvls[0]} {orig_l2}"\n    u2 = get_unified_l2(u1, l2_context) if orig_l2 else \'\'\n    \n    # Levels 3-5: Keep original but clean\n    u3 = lvls[2] if len(lvls) > 2 else \'\'\n    u4 = lvls[3] if len(lvls) > 3 else \'\'\n    u5 = lvls[4] if len(lvls) > 4 else \'\'\n    \n    # Calculate depth\n    depth = len([x for x in [u1, u2, u3, u4, u5] if x])\n    \n    output_full.append({\n        \'source\': r[\'source\'],\n        \'category_path\': r[\'path\'],\n        \'depth\': depth,\n        \'unified_level_1\': u1,\n        \'unified_level_2\': u2,\n        \'unified_level_3\': u3,\n        \'unified_level_4\': u4,\n        \'unified_level_5\': u5\n    })\n    \n    hierarchy_set.add((u1, u2, u3, u4, u5))\n\nprint(f"Generated {len(output_full)} records")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
