Sending keys: ['cat > parallel_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building using multiprocessing\n2. Batch search using multiprocessing\n\nDesigned to achieve significant speedup on multi-core systems.\n"""\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom multiprocessing import cpu_count\nfrom typing import Optional\n\nfrom document_generator import Document\nfrom sequential import (\n    STOP_WORDS,\n    TOKEN_PATTERN,\n    IndexingResult,\n    SearchResult,\n    TFIDFIndex,\n    batch_search_sequential,\n    compute_term_frequencies,\n    search_sequential,\n    tokenize,\n)\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building Helper Functions\n# ============================================================================\n\n\ndef _process_document_chunk(chunk: list[Document]) -> dict:\n    """\n    Process a chunk of documents to extract terms and frequencies.\n    \n    Args:\n        chunk: List of documents to process\n        \n    Returns:\n        Dictionary containing:\n        - doc_vectors: doc_id -> dict of term -> tf\n        - vocabulary: set of all terms\n        - document_frequencies: term -> count of docs containing term\n    """\n    doc_vectors = {}\n    vocabulary = set()\n    document_frequencies = defaultdict(int)\n    \n    for doc in chunk:\n        tokens = tokenize(doc.content)\n        if not tokens:\n            doc_vectors[doc.doc_id] = {}\n            continue\n            \n        # Compute term frequencies\n        tf = compute_term_frequencies(tokens)\n        doc_vectors[doc.doc_id] = tf\n        \n        # Track vocabulary and document frequencies\n        for term in tf:\n            vocabulary.add(term)\n            document_frequencies[term] += 1\n    \n    return {\n        "doc_vectors": doc_vectors,\n        "vocabulary": vocabulary,\n        "document_frequencies": document_frequencies,\n    }\n\n\ndef build_tfidf_index_parallel(\n    documents: list[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    """\n    Build TF-IDF index in parallel.\n    \n    Args:\n        documents: List of documents to index\n        num_workers: Number of worker processes (default: CPU count)\n        chunk_size: Number of documents per chunk\n        \n    Returns:\n        ParallelIndexingResult containing the TFIDFIndex and timing info\n    """\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = cpu_count()\n    \n    num_docs = len(documents)\n    \n    # Create chunks\n    chunks = []\n    for i in range(0, num_docs, chunk_size):\n        chunks.append(documents[i : i + chunk_size])\n    \n    # Process chunks in parallel\n    all_doc_vectors = {}\n    all_vocabulary = set()\n    all_document_frequencies = defaultdict(int)\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        results = list(executor.map(_process_document_chunk, chunks))\n    \n    # Merge results from all chunks\n    for result in results:\n        all_doc_vectors.update(result["doc_vectors"])\n        all_vocabulary.update(result["vocabulary"])\n        for term, count in result["document_frequencies"].items():\n            all_document_frequencies[term] += count\n    \n    # Compute IDF scores\n    idf = {}\n    for term in all_vocabulary:\n        df = all_document_frequencies[term]\n        # IDF = log(N / df)\n        idf[term] = math.log(num_docs / df) if df > 0 else 0.0\n    \n    # Build inverted index and compute TF-IDF vectors\n    inverted_index = defaultdict(list)\n    doc_norms = {}\n    final_doc_vectors = {}\n    \n    for doc_id, tf_vector in all_doc_vectors.items():\n        tfidf_vector = {}\n        norm_squared = 0.0\n        \n        for term, tf in tf_vector.items():\n            tfidf_score = tf * idf[term]\n            tfidf_vector[term] = tfidf_score\n            norm_squared += tfidf_score * tfidf_score\n            \n            # Add to inverted index\n            inverted_index[term].append((doc_id, tfidf_score))\n        \n        final_doc_vectors[doc_id] = tfidf_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    # Build final index\n    index = TFIDFIndex(\n        num_documents=num_docs,\n        vocabulary=all_vocabulary,\n        document_frequencies=dict(all_document_frequencies),\n        idf=idf,\n        inverted_index=dict(inverted_index),\n        doc_vectors=final_doc_vectors,\n        doc_norms=doc_norms,\n    )\n    \n    elapsed_time = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed_time,\n        num_documents=num_docs,\n        vocabulary_size=len(all_vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Batch Search Helper Functions\n# ============================================================================\n\n\ndef _search_single_query(args: tuple) -> list[SearchResult]:\n    """\n    Search for a single query. Used as worker function.\n    \n    Args:\n        args: Tuple of (query, index, top_k, doc_titles)\n        \n    Returns:\n        List of SearchResult objects\n    """\n    query, index, top_k, doc_titles = args\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        results.append(\n            SearchResult(\n                doc_id=doc_id,\n                score=score,\n                title=doc_titles.get(doc_id, f"Document {doc_id}"),\n            )\n        )\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: list[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[list[Document]] = None,\n) -> tuple[list[list[SearchResult]], float]:\n    """\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (default: CPU count)\n        documents: Optional list of documents for title lookup\n        \n    Returns:\n        Tuple of (results, elapsed_time) where results is a list of result lists\n    """\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = cpu_count()\n    \n    # Build doc_titles mapping\n    doc_titles = {}\n    if documents:\n        doc_titles = {d.doc_id: d.title for d in documents}\n    \n    # Prepare arguments for worker function\n    worker_args = [(query, index, top_k, doc_titles) for query in queries]\n    \n    # Process queries in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        results = list(executor.map(_search_single_query, worker_args))\n    \n    elapsed_time = time.perf_counter() - start_time\n    \n    return results, elapsed_time\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
