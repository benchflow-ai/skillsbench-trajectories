Sending keys: ['cat << \'EOF\' > optimize_dbscan.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom multiprocessing import Pool\n\ndef load_data():\n    citsci = pd.read_csv(\'/root/data/citsci_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    expert = pd.read_csv(\'/root/data/expert_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    return citsci, expert\n\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\n        return 0, []\n\n    dists = cdist(cluster_centroids, expert_points, metric=\'euclidean\')\n    matched_expert_indices = set()\n    matched_cluster_indices = set()\n    matches = []\n\n    # Flatten distances and sort\n    flat_dists = []\n    for i in range(len(cluster_centroids)):\n        for j in range(len(expert_points)):\n            if dists[i, j] <= max_dist:\n                flat_dists.append((dists[i, j], i, j))\n    \n    flat_dists.sort()\n\n    for d, i, j in flat_dists:\n        if i not in matched_cluster_indices and j not in matched_expert_indices:\n            matched_cluster_indices.add(i)\n            matched_expert_indices.add(j)\n            matches.append(d)\n    \n    return len(matches), matches\n\ndef evaluate_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    if len(citsci_points) == 0:\n        return 0.0, np.nan\n\n    def custom_dist(a, b):\n        dx = a[0] - b[0]\n        dy = a[1] - b[1]\n        return np.sqrt((shape_weight * dx)**2 + ((2 - shape_weight) * dy)**2)\n\n    # DBSCAN with custom distance\n    # We can precompute the distance matrix for speed if needed, \n    # but sklearn DBSCAN accepts metric=\'precomputed\' or a callable.\n    # Given the constraints and potential number of points, let\'s use a callable.\n    db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=custom_dist).fit(citsci_points)\n    \n    labels = db.labels_\n    unique_labels = set(labels) - {-1}\n    \n    cluster_centroids = []\n    for label in unique_labels:\n        cluster_points = citsci_points[labels == label]\n        cluster_centroids.append(cluster_points.mean(axis=0))\n    \n    cluster_centroids = np.array(cluster_centroids)\n    expert_points = np.array(expert_points)\n\n    num_matches, matches = greedy_match(cluster_centroids, expert_points)\n    \n    precision = num_matches / len(cluster_centroids) if len(cluster_centroids) > 0 else 0\n    recall = num_matches / len(expert_points) if len(expert_points) > 0 else 0\n    \n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    delta = np.mean(matches) if len(matches) > 0 else np.nan\n    \n    return f1, delta\n\ndef run_search(params):\n    min_samples, epsilon, shape_weight, citsci_grouped, expert_grouped, all_expert_files = params\n    \n    f1_scores = []\n    deltas = []\n    \n    for file_rad in all_expert_files:\n        c_pts = citsci_grouped.get(file_rad, pd.DataFrame(columns=[\'x\', \'y\']))[[\'x\', \'y\']].values\n        e_pts = expert_grouped.get(file_rad, pd.DataFrame(columns=[\'x\', \'y\']))[[\'x\', \'y\']].values\n        \n        f1, delta = evaluate_image(c_pts, e_pts, min_samples, epsilon, shape_weight)\n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n            \n    avg_f1 = np.mean(f1_scores)\n    avg_delta = np.mean(deltas) if deltas else np.nan\n    \n    return (avg_f1, avg_delta, min_samples, epsilon, shape_weight)\n\ndef is_pareto_optimal(costs):\n    """\n    Find the pareto-optimal points\n    :param costs: (n_points, n_costs) array. We want to maximize the first cost and minimize the second.\n    :return: (n_points, ) boolean array of whether each point is Pareto optimal\n    """\n    is_efficient = np.ones(costs.shape[0], dtype=bool)\n    for i, c in enumerate(costs):\n        if is_efficient[i]:\n            # A point is dominated if there is another point that is better in at least one objective \n            # and not worse in any objective.\n            # Here: better means F1 higher and delta lower.\n            # We want to find if any other point j dominates point i.\n            # Point j dominates point i if (F1_j >= F1_i and delta_j <= delta_i) \n            # AND (F1_j > F1_i or delta_j < delta_i)\n            \n            # To simplify, we\'ll check if point i is dominated by any other point.\n            # Point i is dominated if there exists j such that:\n            # (costs[j, 0] >= c[0] and costs[j, 1] <= c[1]) and (costs[j, 0] > c[0] or costs[j, 1] < c[1])\n            \n            dominated = ((costs[:, 0] >= c[0]) & (costs[:, 1] <= c[1])) & ((costs[:, 0] > c[0]) | (costs[:, 1] < c[1]))\n            if np.any(dominated):\n                is_efficient[i] = False\n    return is_efficient\n\nif __name__ == \'__main__\':\n    citsci, expert = load_data()\n    citsci_grouped = {name: group for name, group in citsci.groupby(\'file_rad\')}\n    expert_grouped = {name: group for name, group in expert.groupby(\'file_rad\')}\n    all_expert_files = sorted(expert[\'file_rad\'].unique())\n    \n    param_grid = []\n    for ms in range(3, 10):\n        for eps in range(4, 25, 2):\n            for sw in np.arange(0.9, 1.95, 0.1):\n                param_grid.append((ms, eps, round(sw, 1), citsci_grouped, expert_grouped, all_expert_files))\n    \n    with Pool() as pool:\n        results = pool.map(run_search, param_grid)\n    \n    # Filter results with F1 > 0.5\n    filtered_results = [r for r in results if r[0] > 0.5]\n    \n    if not filtered_results:\n        print("No results with F1 > 0.5")\n    else:\n        # Identify Pareto frontier\n        costs = np.array([(r[0], r[1]) for r in filtered_results])\n        # costs[:, 0] is F1 (maximize), costs[:, 1] is delta (minimize)\n        pareto_mask = is_pareto_optimal(costs)\n        pareto_results = [filtered_results[i] for i in range(len(filtered_results)) if pareto_mask[i]]\n        \n        # Sort results for consistency (optional)\n        pareto_results.sort(key=lambda x: (-x[0], x[1]))\n        \n        # Write to CSV\n        with open(\'/root/pareto_frontier.csv\', \'w\') as f:\n            f.write("F1,delta,min_samples,epsilon,shape_weight\\n")\n            for r in pareto_results:\n                f.write(f"{r[0]:.5f},{r[1]:.5f},{r[2]},{r[3]},{r[4]:.1f}\\n")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
