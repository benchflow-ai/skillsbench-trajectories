Sending keys: ['python3 << \'EOF\'\nimport struct\nimport json\nfrom collections import defaultdict\n\n# Read binary STL file\nwith open(\'/root/scan_data.stl\', \'rb\') as f:\n    data = f.read()\n\nnum_triangles = struct.unpack(\'<I\', data[80:84])[0]\n\n# Parse all triangles\ntriangles = []\noffset = 84\nfor i in range(num_triangles):\n    normal = struct.unpack(\'<3f\', data[offset:offset+12])\n    v1 = struct.unpack(\'<3f\', data[offset+12:offset+24])\n    v2 = struct.unpack(\'<3f\', data[offset+24:offset+36])\n    v3 = struct.unpack(\'<3f\', data[offset+36:offset+48])\n    attr = struct.unpack(\'<H\', data[offset+48:offset+50])[0]\n    triangles.append({\'vertices\': [v1, v2, v3], \'material_id\': attr, \'index\': i})\n    offset += 50\n\n# Build vertex to triangle mapping\ndef vertex_key(v):\n    # Round to avoid floating point issues\n    return (round(v[0], 5), round(v[1], 5), round(v[2], 5))\n\nvertex_to_triangles = defaultdict(set)\nfor i, t in enumerate(triangles):\n    for v in t[\'vertices\']:\n        vertex_to_triangles[vertex_key(v)].add(i)\n\n# Union-Find for connected components\nparent = list(range(num_triangles))\ndef find(x):\n    if parent[x] != x:\n        parent[x] = find(parent[x])\n    return parent[x]\ndef union(x, y):\n    px, py = find(x), find(y)\n    if px != py:\n        parent[px] = py\n\n# Connect triangles sharing vertices\nfor vertex, tri_set in vertex_to_triangles.items():\n    tri_list = list(tri_set)\n    for i in range(len(tri_list)):\n        for j in range(i+1, len(tri_list)):\n            union(tri_list[i], tri_list[j])\n\n# Group triangles by component\ncomponents = defaultdict(list)\nfor i in range(num_triangles):\n    components[find(i)].append(i)\n\nprint(f"Number of connected components: {len(components)}")\nfor comp_id, tri_indices in sorted(components.items(), key=lambda x: -len(x[1])):\n    mat_ids = set(triangles[i][\'material_id\'] for i in tri_indices)\n    print(f"Component {comp_id}: {len(tri_indices)} triangles, materials: {mat_ids}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
