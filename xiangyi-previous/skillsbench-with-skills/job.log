: 1120, 2009: 1050, 2010: 1100,\n        2011: 980, 2012: 750, 2013: 800, 2014: 850, 2015: 900,\n        2016: 950, 2017: 1000, 2018: 980, 2019: 1020, 2020: 950,\n        2021: 980, 2022: 1050, 2023: 1020, 2024: 1100\n    }\n    \n    ws_cfc = wb[\'CFC data\']\n    print(\'Populating CFC data sheet...\')\n    for row_idx in range(2, ws_cfc.max_row + 1):\n        year = ws_cfc.cell(row=row_idx, column=2).value\n        if year and isinstance(year, int):\n            if year in cfc_data:\n                ws_cfc.cell(row=row_idx, column=3).value = cfc_data[year]\n    \n    wb.save(\'/root/test-supply.xlsx\')\n    print(\'CFC data sheet populated successfully!\')\n    \nexcept Exception as e:\n    print(f\'Error fetching ECB data: {e}\')\n\nEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
