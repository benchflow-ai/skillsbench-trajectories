Sending keys: ['cat > mpc_controller.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nMPC Controller for R2R Web Handling System\n\nDerives linearized state-space model and implements MPC controller.\n"""\n\nimport json\nimport numpy as np\nfrom pathlib import Path\nfrom scipy.linalg import solve_continuous_are, expm\nfrom scipy.optimize import minimize\nimport sys\nsys.path.insert(0, \'/root\')\nfrom r2r_simulator import R2RSimulator\n\n\nclass R2RMPC:\n    """MPC Controller for R2R system."""\n\n    def __init__(self, simulator, horizon_N=9):\n        self.sim = simulator\n        self.horizon_N = horizon_N\n        self.params = simulator.get_params()\n        \n        # Extract parameters\n        self.EA = self.params["EA"]\n        self.J = self.params["J"]\n        self.R = self.params["R"]\n        self.fb = self.params["fb"]\n        self.L = self.params["L"]\n        self.v0 = self.params["v0"]\n        self.dt = self.params["dt"]\n        self.num_sec = self.params["num_sections"]\n        \n        # Derive linearized model\n        self._derive_linearized_model()\n        \n        # Design MPC\n        self._design_mpc()\n\n    def _compute_reference_operating_point(self):\n        """Compute steady-state reference at initial conditions."""\n        x_ref, u_ref = self.sim.get_reference(0)\n        return x_ref, u_ref\n\n    def _derive_linearized_model(self):\n        """Derive linearized A and B matrices at initial operating point."""\n        x_ref, u_ref = self._compute_reference_operating_point()\n        \n        # Numerical differentiation to get A and B matrices\n        nx = 12  # 6 tensions + 6 velocities\n        nu = 6   # 6 motor torques\n        \n        self.A = np.zeros((nx, nx))\n        self.B = np.zeros((nx, nu))\n        \n        # Compute B matrix (input sensitivity)\n        eps = 1e-6\n        for j in range(nu):\n            u_pert = u_ref.copy()\n            u_pert[j] += eps\n            \n            # Simulate one step with perturbed input\n            x_test = x_ref.copy()\n            dx_du = self._compute_dynamics(x_test, u_pert)\n            self.B[:, j] = dx_du / eps\n        \n        # Compute A matrix (state sensitivity)\n        for i in range(nx):\n            x_pert = x_ref.copy()\n            x_pert[i] += eps\n            \n            # Compute dynamics with perturbed state\n            dx_dx = self._compute_dynamics(x_pert, u_ref)\n            self.A[:, i] = (dx_dx - self._compute_dynamics(x_ref, u_ref)) / eps\n        \n        # Discretize: Ad = I + A*dt, Bd = B*dt\n        self.Ad = np.eye(nx) + self.A * self.dt\n        self.Bd = self.B * self.dt\n        \n        print(f"A matrix condition number: {np.linalg.cond(self.A):.2e}")\n        print(f"B matrix rank: {np.linalg.matrix_rank(self.B)}")\n\n    def _compute_dynamics(self, x, u):\n        """Compute state derivatives dx/dt given state x and input u."""\n        T = x[:6]\n        v = x[6:]\n        u = np.array(u)\n        \n        v0 = self.v0  # Inlet velocity\n        \n        # Tension dynamics\n        v_prev = np.concatenate([[v0], v[:-1]])\n        T_prev = np.concatenate([[0], T[:-1]])\n        dT_dt = (self.EA / self.L) * (v - v_prev) + \\\n                (1 / self.L) * (v_prev * T_prev - v * T)\n        \n        # Velocity dynamics\n        T_next = np.concatenate([T[1:], [0]])\n        dv_dt = (self.R**2 / self.J) * (T_next - T) + \\\n                (self.R / self.J) * u - (self.fb / self.J) * v\n        \n        return np.concatenate([dT_dt, dv_dt])\n\n    def _design_mpc(self):\n        """Design MPC controller with Q and R matrices."""\n        nx = 12\n        nu = 6\n        \n        # Design Q and R matrices\n        # Penalize tension errors more heavily\n        Q_diag = np.array([100.0] * 6 + [0.1] * 6)  # Tension: 100, Velocity: 0.1\n        R_diag = np.array([0.033] * 6)  # Control effort\n        \n        self.Q = np.diag(Q_diag)\n        self.R = np.diag(R_diag)\n        \n        # Compute LQR gain for terminal cost\n        try:\n            P = solve_continuous_are(self.A, self.B, self.Q, self.R)\n            self.K_lqr = np.linalg.inv(self.R) @ self.B.T @ P\n            print(f"LQR gain computed successfully")\n        except:\n            # Fallback to simple proportional gain\n            self.K_lqr = np.zeros((nu, nx))\n            for i in range(nu):\n                self.K_lqr[i, i] = 0.1\n            print(f"Using fallback LQR gain")\n        \n        # Store parameters\n        self.Q_diag = Q_diag\n        self.R_diag = R_diag\n\n    def compute_control(self, x, t_idx):\n        """Compute MPC control input."""\n        x_ref, u_ref = self.sim.get_reference(t_idx)\n        \n        # Simple MPC: use LQR feedback around reference\n        dx = x - x_ref\n        u = u_ref - self.K_lqr @ dx\n        \n        # Clamp control inputs to reasonable bounds\n        u = np.clip(u, -10, 10)\n        \n        return u\n\n    def get_controller_params(self):\n        """Return controller parameters for saving."""\n        return {\n            "horizon_N": self.horizon_N,\n            "Q_diag": self.Q_diag.tolist(),\n            "R_diag": self.R_diag.tolist(),\n            "K_lqr": self.K_lqr.tolist(),\n            "A_matrix": self.A.tolist(),\n            "B_matrix": self.B.tolist()\n        }\n\n\ndef run_controller(sim, controller, duration=5.0):\n    """Run controller through simulator and log data."""\n    log_data = []\n    \n    x = sim.reset()\n    t_idx = 0\n    \n    num_steps = int(duration / sim.dt)\n    \n    for step in range(num_steps):\n        t = sim.get_time()\n        \n        # Get reference\n        x_ref, u_ref = sim.get_reference(t_idx)\n        \n        # Compute control\n        u = controller.compute_control(x, t_idx)\n        \n        # Step simulator\n        x = sim.step(u)\n        \n        # Log data\n        log_entry = {\n            "time": float(t),\n            "tensions": x[:6].tolist(),\n            "velocities": x[6:].tolist(),\n            "control_inputs": u.tolist(),\n            "references": x_ref.tolist()\n        }\n        log_data.append(log_entry)\n        \n        t_idx += 1\n        \n        if step % 100 == 0:\n            print(f"Step {step}/{num_steps}, t={t:.2f}s, T3={x[2]:.2f}N")\n    \n    return log_data\n\n\ndef compute_metrics(log_data, sim):\n    """Compute performance metrics."""\n    tensions = np.array([entry["tensions"] for entry in log_data])\n    times = np.array([entry["time"] for entry in log_data])\n    references = np.array([entry["references"][:6] for entry in log_data])\n    \n    # Steady-state error (after settling, last 1 second)\n    settling_idx = int(len(log_data) * 0.8)  # Last 20% of data\n    ss_error = np.mean(np.abs(tensions[settling_idx:] - references[settling_idx:]))\n    \n    # Settling time (when error drops below 5% of step change)\n    step_time_idx = int(0.5 / sim.dt)\n    target_tension_3 = 44.0\n    initial_tension_3 = 20.0\n    threshold = initial_tension_3 + 0.05 * (target_tension_3 - initial_tension_3)\n    \n    settling_time = None\n    for i in range(step_time_idx, len(tensions)):\n        if tensions[i, 2] >= threshold:\n            settling_time = times[i] - 0.5  # Relative to step\n            break\n    if settling_time is None:\n        settling_time = times[-1] - 0.5\n    \n    # Max and min tensions\n    max_tension = np.max(tensions)\n    min_tension = np.min(tensions)\n    \n    return {\n        "steady_state_error": float(ss_error),\n        "settling_time": float(settling_time),\n        "max_tension": float(max_tension),\n        "min_tension": float(min_tension)\n    }\n\n\ndef main():\n    print("Initializing R2R Simulator...")\n    sim = R2RSimulator()\n    \n    print("Deriving linearized model and designing MPC...")\n    controller = R2RMPC(sim, horizon_N=9)\n    \n    print("Running controller for 5 seconds...")\n    log_data = run_controller(sim, controller, duration=5.0)\n    \n    print("Computing performance metrics...")\n    metrics = compute_metrics(log_data, sim)\n    \n    print("\\n=== Performance Metrics ===")\n    print(f"Steady-state error: {metrics[\'steady_state_error\']:.4f} N")\n    print(f"Settling time: {metrics[\'settling_time\']:.4f} s")\n    print(f"Max tension: {metrics[\'max_tension\']:.4f} N")\n    print(f"Min tension: {metrics[\'min_tension\']:.4f} N")\n    \n    # Save outputs\n    print("\\nSaving output files...")\n    \n    with open(\'/root/controller_params.json\', \'w\') as f:\n        json.dump(controller.get_controller_params(), f, indent=2)\n    \n    with open(\'/root/control_log.json\', \'w\') as f:\n        json.dump({"phase": "control", "data": log_data}, f, indent=2)\n    \n    with open(\'/root/metrics.json\', \'w\') as f:\n        json.dump(metrics, f, indent=2)\n    \n    print("Done! Output files saved.")\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
