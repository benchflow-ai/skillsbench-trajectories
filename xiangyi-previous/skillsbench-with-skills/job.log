Sending keys: ['cat > /root/flood_check2.py << \'EOF\'\nimport requests\nimport csv\nimport time\n\n# Read station IDs\nwith open(\'/root/data/michigan_stations.txt\', \'r\') as f:\n    stations = [line.strip() for line in f if line.strip()]\n\nprint(f"Processing {len(stations)} stations...")\n\nstart_date = "2025-04-01"\nend_date = "2025-04-07"\n\nresults = []\n\nfor i, station_id in enumerate(stations):\n    try:\n        # Get daily values for April 1-7, 2025\n        dv_url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={station_id}&startDT={start_date}&endDT={end_date}&parameterCd=00060&siteStatus=all"\n        dv_resp = requests.get(dv_url, timeout=30)\n        dv_data = dv_resp.json()\n        \n        # Extract daily discharge values\n        daily_values = {}  # {day: value}\n        if \'value\' in dv_data and \'timeSeries\' in dv_data[\'value\'] and len(dv_data[\'value\'][\'timeSeries\']) > 0:\n            ts = dv_data[\'value\'][\'timeSeries\'][0]\n            values = ts.get(\'values\', [{}])[0].get(\'value\', [])\n            for v in values:\n                try:\n                    date_str = v[\'dateTime\'][:10]  # YYYY-MM-DD\n                    day = int(date_str.split(\'-\')[2])\n                    flow = float(v[\'value\'])\n                    daily_values[day] = flow\n                except:\n                    pass\n        \n        if not daily_values:\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: No discharge data")\n            continue\n        \n        # Get historical statistics for p90 thresholds\n        stat_url = f"https://waterservices.usgs.gov/nwis/stat/?format=rdb&sites={station_id}&statReportType=daily&statTypeCd=all&parameterCd=00060"\n        stat_resp = requests.get(stat_url, timeout=30)\n        \n        # Parse statistics to get April 1-7 p90 values\n        p90_thresholds = {}  # {day: p90_value}\n        for line in stat_resp.text.split(\'\\n\'):\n            if not line.startswith(\'USGS\'):\n                continue\n            parts = line.split(\'\\t\')\n            if len(parts) >= 23:\n                try:\n                    month = int(parts[5])\n                    day = int(parts[6])\n                    if month == 4 and 1 <= day <= 7:\n                        p90 = float(parts[22]) if parts[22] else None\n                        if p90:\n                            p90_thresholds[day] = p90\n                except:\n                    pass\n        \n        if not p90_thresholds:\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: No threshold data")\n            continue\n        \n        # Count flood days\n        flood_days = 0\n        for day in range(1, 8):\n            if day in daily_values and day in p90_thresholds:\n                if daily_values[day] >= p90_thresholds[day]:\n                    flood_days += 1\n        \n        if flood_days > 0:\n            results.append({\'station_id\': station_id, \'flood_days\': flood_days})\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: {flood_days} flood days")\n        else:\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: No flooding")\n        \n        # Small delay to be nice to the API\n        time.sleep(0.1)\n        \n    except Exception as e:\n        print(f"[{i+1}/{len(stations)}] Station {station_id}: Error - {str(e)[:50]}")\n\n# Write results to CSV\nwith open(\'/root/output/flood_results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'station_id\', \'flood_days\'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f"\\nDone! Found {len(results)} stations with flooding.")\nprint(f"Results saved to /root/output/flood_results.csv")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
