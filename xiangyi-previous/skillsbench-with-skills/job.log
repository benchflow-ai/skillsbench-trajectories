Sending keys: ['cat > /app/workspace/ocr_final.py << \'ENDOFSCRIPT\'\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image\nfrom openpyxl import Workbook\n\ndef extract_text(image_path):\n    try:\n        img = Image.open(image_path)\n        text = pytesseract.image_to_string(img)\n        return text\n    except Exception as e:\n        print(f"Error processing {image_path}: {e}")\n        return ""\n\ndef extract_date(text):\n    """Extract date from OCR text and convert to ISO format."""\n    month_map = {\n        \'jan\': \'01\', \'feb\': \'02\', \'mar\': \'03\', \'apr\': \'04\',\n        \'may\': \'05\', \'jun\': \'06\', \'jul\': \'07\', \'aug\': \'08\',\n        \'sep\': \'09\', \'oct\': \'10\', \'nov\': \'11\', \'dec\': \'12\'\n    }\n    \n    lines = text.split(\'\\n\')\n    \n    for line in lines:\n        upper_line = line.upper()\n        \n        # Skip lines with company/GST/registration numbers (but not if DATE keyword present)\n        if any(kw in upper_line for kw in [\'GST NO\', \'REG NO\', \'COMPANY NO\', \'SDN BHD\', \'(-\', \'-M)\', \'-W)\', \'-K)\', \'-V)\', \'-D)\', \'-A)\', \'-T)\', \'-X)\']):\n            if \'DATE\' not in upper_line:\n                continue\n        \n        # Pattern: DD/MM/YYYY or DD-MM-YYYY or DD.MM.YYYY\n        match = re.search(r\'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{4})\', line)\n        if match:\n            day, month, year = match.groups()\n            if 2000 <= int(year) <= 2030:\n                day = day.zfill(2)\n                month = month.zfill(2)\n                if int(month) > 12:\n                    month_fixed = month.replace(\'6\', \'0\').replace(\'5\', \'0\')\n                    if 1 <= int(month_fixed) <= 12:\n                        month = month_fixed\n                if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                    return f"{year}-{month}-{day}"\n        \n        # Pattern: DD/MM/YY\n        match = re.search(r\'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d)\', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            if int(month) > 12:\n                month_fixed = month.replace(\'6\', \'0\').replace(\'5\', \'0\')\n                if 1 <= int(month_fixed) <= 12:\n                    month = month_fixed\n            year_full = \'20\' + year if int(year) < 50 else \'19\' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f"{year_full}-{month}-{day}"\n        \n        # Pattern: DMMYYYY or DDMYYYY without separators (like 2032018 for 20/3/2018)\n        # Look for date keyword first\n        if \'DATE\' in upper_line:\n            match = re.search(r\'(\\d{6,8})\', line)\n            if match:\n                digits = match.group(1)\n                if len(digits) == 7:  # DMMYYYY or DDMYYYY\n                    # Try DDMYYYY first (20/3/2018 -> 2032018)\n                    day = digits[0:2]\n                    month = digits[2:3]\n                    year = digits[3:7]\n                    if 1 <= int(month) <= 9 and 1 <= int(day) <= 31 and 2000 <= int(year) <= 2030:\n                        return f"{year}-0{month}-{day}"\n                    # Try DMMYYYY\n                    day = digits[0:1]\n                    month = digits[1:3]\n                    year = digits[3:7]\n                    if 1 <= int(month) <= 12 and 1 <= int(day) <= 9 and 2000 <= int(year) <= 2030:\n                        return f"{year}-{month.zfill(2)}-0{day}"\n                elif len(digits) == 8:  # DDMMYYYY\n                    day = digits[0:2]\n                    month = digits[2:4]\n                    year = digits[4:8]\n                    if 1 <= int(month) <= 12 and 1 <= int(day) <= 31 and 2000 <= int(year) <= 2030:\n                        return f"{year}-{month}-{day}"\n        \n        # Pattern: DD MMM YYYY\n        match = re.search(r\'(\\d{1,2})[\\s\\-\\./:](Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./:](\\d{4})\', line, re.IGNORECASE)\n        if match:\n            day, month_str, year = match.groups()\n            if 2000 <= int(year) <= 2030:\n                day = day.zfill(2)\n                month = month_map[month_str.lower()[:3]]\n                return f"{year}-{month}-{day}"\n    \n    return None\n\ndef extract_total_amount(text):\n    """Extract total amount from OCR text based on priority keywords."""\n    lines = text.split(\'\\n\')\n    \n    def extract_amount_from_line(line):\n        """Extract monetary value from a line."""\n        line_fixed = line.replace(\'u\', \'0\').replace(\'U\', \'0\').replace(\'O\', \'0\').replace(\'o\', \'0\')\n        line_fixed = line_fixed.replace(\',\', \'\')\n        matches = re.findall(r\'(\\d+\\.\\d{2})(?!\\d)\', line_fixed)\n        if matches:\n            return matches[-1]\n        matches = re.findall(r\'([\\d,]+\\.\\d{2})(?!\\d)\', line)\n        if matches:\n            return matches[-1].replace(\',\', \'\')\n        return None\n    \n    def is_exclusion_line(line):\n        upper = line.upper()\n        exclusions = [\'SUBTOTAL\', \'SUB TOTAL\', \'SUB-TOTAL\', \'CASH\', \'CHANGE\', \'VISA\', \'MASTER\', \n                      \'PAYMENT\', \'TENDER\', \'EXCL\', \'SAVING\', \'DISCOUNT\', \'ROUNDING\']\n        for ex in exclusions:\n            if ex in upper:\n                return True\n        return False\n    \n    # Priority patterns for total\n    priority_patterns = [\n        r\'GRAND\\s*TOTAL\',\n        r\'TOTAL\\s*:?\\s*RM\',\n        r\'TOTAL\\s*AMOUNT\',\n        r\'TOTAL\\s*DUE\',\n        r\'AMOUNT\\s*DUE\',\n        r\'BALANCE\\s*DUE\',\n        r\'NETT\\s*TOTAL\',\n        r\'NET\\s*TOTAL\',\n        r\'TOTAL.*INCL\',\n        r\'TOTAL.*INEL\',  # OCR error for INCL\n        r\'TOTAL\\s*ROUNDED\',\n        r\'TOTAL\\s*AMT\\s*ROUNDED\',\n        r\'TOTAL\\s*AFTER\',\n        r\'TOTAL\\s*SALES\',\n        r\'TOTAL\\s*RM\',\n        r\'(?<!SUB)(?<!SUB-)(?<!SUB )TOTAL(?!\\s*QTY|\\s*QUANTITY|\\s*ITEM|\\s*SAVING|\\s*GROSS|\\s*EXCL)\',\n    ]\n    \n    for pattern in priority_patterns:\n        for i, line in enumerate(lines):\n            upper_line = line.upper()\n            \n            # Skip subtotal lines\n            if \'SUBTOTAL\' in upper_line or \'SUB TOTAL\' in upper_line or \'SUB-TOTAL\' in upper_line:\n                continue\n            \n            # Skip GST/tax summary lines (but not "incl GST")\n            if re.search(r\'GST\\s*@|GST\\s*\\d+%|TAX\\s*@|SR\\s*@\', upper_line):\n                continue\n            \n            if re.search(pattern, upper_line, re.IGNORECASE):\n                amount = extract_amount_from_line(line)\n                if amount and float(amount) > 1.0:\n                    return amount\n                # Try next line\n                if i + 1 < len(lines):\n                    next_line = lines[i + 1]\n                    if not is_exclusion_line(next_line):\n                        amount = extract_amount_from_line(next_line)\n                        if amount and float(amount) > 1.0:\n                            return amount\n    \n    return None\n\ndef main():\n    img_dir = \'/app/workspace/dataset/img\'\n    output_file = \'/app/workspace/stat_ocr.xlsx\'\n    \n    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith((\'.jpg\', \'.jpeg\', \'.png\'))])\n    \n    results = []\n    \n    for filename in files:\n        image_path = os.path.join(img_dir, filename)\n        print(f"Processing {filename}...")\n        \n        text = extract_text(image_path)\n        \n        date = extract_date(text)\n        total_amount = extract_total_amount(text)\n        \n        print(f"  Date: {date}")\n        print(f"  Total: {total_amount}")\n        \n        results.append({\n            \'filename\': filename,\n            \'date\': date,\n            \'total_amount\': total_amount\n        })\n    \n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'results\'\n    \n    ws[\'A1\'] = \'filename\'\n    ws[\'B1\'] = \'date\'\n    ws[\'C1\'] = \'total_amount\'\n    \n    for i, result in enumerate(results, start=2):\n        ws[f\'A{i}\'] = result[\'filename\']\n        ws[f\'B{i}\'] = result[\'date\']\n        ws[f\'C{i}\'] = result[\'total_amount\']\n    \n    wb.save(output_file)\n    print(f"\\nResults saved to {output_file}")\n\nif __name__ == \'__main__\':\n    main()\nENDOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
