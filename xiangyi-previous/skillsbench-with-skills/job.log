Sending keys: ['cat > /tmp/solution2_fixed.py << \'EOFPYTHON\'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes_log = pd.read_csv(\'/app/data/mes_log.csv\')\nthermocouples = pd.read_csv(\'/app/data/thermocouples.csv\')\n\n# Constants from handbook\nTAL_MIN_S = 30\nTAL_MAX_S = 60\nTC_LOCATION = \'largest_mass\'\n\n# Filter thermocouples for largest_mass only\ntc_data = thermocouples[thermocouples[\'tc_location\'] == TC_LOCATION].copy()\n\nprint("\\n=== Question 2: Time Above Liquidus (Fixed) ===")\n\nq02_output = []\n\nfor run_id in sorted(mes_log[\'run_id\'].unique()):\n    # Get liquidus temperature for this run\n    run_info = mes_log[mes_log[\'run_id\'] == run_id].iloc[0]\n    liquidus_c = float(run_info[\'solder_liquidus_c\'])\n    \n    run_tc = tc_data[tc_data[\'run_id\'] == run_id].copy()\n    \n    if len(run_tc) == 0:\n        continue\n    \n    run_tc = run_tc.sort_values(\'time_s\').reset_index(drop=True)\n    tc_id = str(run_tc[\'tc_id\'].iloc[0])\n    \n    # Calculate TAL by summing time intervals where temp > liquidus\n    tal_s = 0.0\n    \n    for i in range(len(run_tc) - 1):\n        temp_current = run_tc.loc[i, \'temp_c\']\n        temp_next = run_tc.loc[i+1, \'temp_c\']\n        time_current = run_tc.loc[i, \'time_s\']\n        time_next = run_tc.loc[i+1, \'time_s\']\n        \n        # If both points are above liquidus, add the interval\n        if temp_current > liquidus_c and temp_next > liquidus_c:\n            tal_s += (time_next - time_current)\n        # If one point is above and one below, estimate partial interval\n        elif temp_current > liquidus_c or temp_next > liquidus_c:\n            # Linear interpolation to find crossing point\n            if temp_current != temp_next:\n                fraction_above = abs(max(temp_current, temp_next) - liquidus_c) / abs(temp_next - temp_current)\n                tal_s += (time_next - time_current) * fraction_above\n    \n    tal_s = round(tal_s, 2)\n    \n    # Determine compliance\n    if TAL_MIN_S <= tal_s <= TAL_MAX_S:\n        status = "compliant"\n    else:\n        status = "non-compliant"\n    \n    q02_output.append({\n        "run_id": run_id,\n        "tc_id": tc_id,\n        "tal_s": tal_s,\n        "required_min_tal_s": TAL_MIN_S,\n        "required_max_tal_s": TAL_MAX_S,\n        "status": status\n    })\n\nwith open(\'/app/output/q02.json\', \'w\') as f:\n    json.dump(q02_output, f, indent=2)\n\nprint(f"Processed TAL for {len(q02_output)} runs")\ncompliant = sum(1 for r in q02_output if r[\'status\'] == \'compliant\')\nprint(f"Compliant: {compliant}, Non-compliant: {len(q02_output) - compliant}")\n\n# Show some examples\nprint("\\nSample TAL values:")\nfor r in q02_output[:5]:\n    print(f"{r[\'run_id\']}: {r[\'tal_s\']}s - {r[\'status\']}")\n\nEOFPYTHON\npython3 /tmp/solution2_fixed.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
