ine_indices:\n            branch[idx, 5] *= 1.20\n            \n    B = build_b_matrix(bus, branch, bus_id_to_idx)\n    \n    Pg = cp.Variable(ng)\n    Rg = cp.Variable(ng)\n    Theta = cp.Variable(nb)\n    \n    constraints = []\n    \n    Pd = bus[:, 2]\n    \n    row_g = [bus_id_to_idx[int(gen[i, 0])] for i in range(ng)]\n    col_g = list(range(ng))\n    data_g = [1.0] * ng\n    C_gen = sp.coo_matrix((data_g, (row_g, col_g)), shape=(nb, ng))\n    \n    P_inj = (C_gen @ Pg - Pd) / baseMVA\n    \n    balance_constr = (B @ Theta == P_inj)\n    constraints.append(balance_constr)\n    constraints.append(Theta[slack_bus_idx] == 0)\n    \n    Pmin = gen[:, 9]\n    Pmax = gen[:, 8]\n    constraints.append(Pg >= Pmin)\n    constraints.append(Pg <= Pmax)\n    \n    line_flows = []\n    limit_vec = []\n    active_branches = []\n    \n    row_f = []\n    col_f = []\n    data_f = []\n    \n    for i in range(nbr):\n        if branch[i, 10] == 0:\n            continue\n            \n        f_id = int(branch[i, 0])\n        t_id = int(branch[i, 1])\n        if f_id not in bus_id_to_idx or t_id not in bus_id_to_idx:\n            continue\n            \n        f_idx = bus_id_to_idx[f_id]\n        t_idx = bus_id_to_idx[t_id]\n        x = branch[i, 3]\n        rate_a = branch[i, 5]\n        \n        if rate_a == 0:\n            rate_a = 1e10\n            \n        row_f.append(len(limit_vec))\n        col_f.append(f_idx)\n        data_f.append(1.0/x)\n        \n        row_f.append(len(limit_vec))\n        col_f.append(t_idx)\n        data_f.append(-1.0/x)\n        \n        limit_vec.append(rate_a / baseMVA)\n        active_branches.append(i)\n        \n    Bf = sp.coo_matrix((data_f, (row_f, col_f)), shape=(len(limit_vec), nb))\n    Flows = Bf @ Theta\n    \n    constraints.append(Flows <= limit_vec)\n    constraints.append(Flows >= -np.array(limit_vec))\n    \n    constraints.append(Rg >= 0)\n    constraints.append(Rg <= reserve_cap)\n    constraints.append(Pg + Rg <= Pmax)\n    \n    reserve_constr = (cp.sum(Rg) >= reserve_req)\n    constraints.append(reserve_constr)\n    \n    c2 = np.zeros(ng)\n    c1 = np.zeros(ng)\n    c0 = np.zeros(ng)\n    \n    for i in range(ng):\n        gc = gencost[i]\n        n = int(gc[3])\n        if n == 3:\n            c2[i] = gc[4]\n            c1[i] = gc[5]\n            c0[i] = gc[6]\n        elif n == 2:\n            c1[i] = gc[4]\n            c0[i] = gc[5]\n            \n    obj = cp.sum(c2 * cp.square(Pg) + c1 * Pg + c0)\n    \n    problem = cp.Problem(cp.Minimize(obj), constraints)\n    problem.solve(solver=cp.OSQP, eps_abs=1e-5, eps_rel=1e-5, max_iter=20000)\n    \n    if problem.status not in ["optimal", "optimal_inaccurate"]:\n        print(f"Warning: Problem status {problem.status}")\n\n    total_cost = problem.value\n    lmps = -balance_constr.dual_value / baseMVA \n    reserve_mcp = reserve_constr.dual_value\n    \n    flow_vals = Flows.value\n    binding = []\n    for idx, branch_idx in enumerate(active_branches):\n        f_val = flow_vals[idx] * baseMVA\n        limit_val = limit_vec[idx] * baseMVA\n        loading = abs(f_val) / limit_val\n        if loading >= 0.99:\n            binding.append({\n                "from": int(branch[branch_idx, 0]),\n                "to": int(branch[branch_idx, 1]),\n                "flow_MW": float(f_val),\n                "limit_MW": float(limit_val)\n            })\n            \n    lmp_list = []\n    for i in range(nb):\n        lmp_list.append({\n            "bus": int(bus_ids[i]),\n            "lmp_dollars_per_MWh": float(lmps[i])\n        })\n        \n    return {\n        "total_cost_dollars_per_hour": float(total_cost),\n        "lmp_by_bus": lmp_list,\n        "reserve_mcp_dollars_per_MWh": float(reserve_mcp),\n        "binding_lines": binding\n    }\n\ndef main():\n    data = load_data("network.json")\n    \n    print("Solving Base Case...")\n    base_res = solve_market(data, relax_line=False)\n    \n    print("Solving Counterfactual...")\n    cf_res = solve_market(data, relax_line=True)\n    \n    cost_red = base_res["total_cost_dollars_per_hour"] - cf_res["total_cost_dollars_per_hour"]\n    \n    base_lmps = {x["bus"]: x["lmp_dollars_per_MWh"] for x in base_res["lmp_by_bus"]}\n    cf_lmps = {x["bus"]: x["lmp_dollars_per_MWh"] for x in cf_res["lmp_by_bus"]}\n    \n    drops = []\n    for bus_id, base_p in base_lmps.items():\n        cf_p = cf_lmps[bus_id]\n        diff = cf_p - base_p\n        drops.append({\n            "bus": bus_id,\n            "base_lmp": round(base_p, 2),\n            "cf_lmp": round(cf_p, 2),\n            "delta": round(diff, 2)\n        })\n        \n    drops.sort(key=lambda x: x["delta"])\n    top_3 = drops[:3]\n    \n    congestion_relieved = True\n    for line in cf_res["binding_lines"]:\n        f = line["from"]\n        t = line["to"]\n        if (f == 64 and t == 1501) or (f == 1501 and t == 64):\n            congestion_relieved = False\n            break\n            \n    report = {\n        "base_case": base_res,\n        "counterfactual": cf_res,\n        "impact_analysis": {\n            "cost_reduction_dollars_per_hour": round(cost_red, 2),\n            "buses_with_largest_lmp_drop": top_3,\n            "congestion_relieved": congestion_relieved\n        }\n    }\n    \n    with open("report.json", "w") as f:\n        json.dump(report, f, indent=2)\n        \n    print("Report generated.")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
