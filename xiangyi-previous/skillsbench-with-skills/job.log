Sending keys: ['cat << \'EOF\' >> /root/Tokenizer.scala\n\n// ============================================================================\n// Complex Nested Generics\n// ============================================================================\n\nclass TokenRegistry[T] {\n  private val _registry = mutable.Map.empty[String, TokenContainer[T]]\n  private val _handlers = mutable.ListBuffer.empty[T => Option[Token]]\n\n  def register(key: String, container: TokenContainer[T]): Unit = {\n    _registry(key) = container\n  }\n\n  def addHandler(handler: T => Option[Token]): Unit = {\n    _handlers += handler\n  }\n\n  def process(key: String): List[Option[Token]] = {\n    _registry.get(key) match {\n      case None => Nil\n      case Some(container) =>\n        container.getAll.map { item =>\n          _handlers.foldLeft(Option.empty[Token]) { (acc, handler) =>\n            acc.orElse(handler(item))\n          }\n        }.toList\n    }\n  }\n}\n\n// ============================================================================\n// Higher-Kinded Type Simulation\n// ============================================================================\n\nclass TokenFunctor[T](val value: T) {\n  def map[U](func: T => U): TokenFunctor[U] = {\n    new TokenFunctor(func(value))\n  }\n\n  def flatMap[U](func: T => TokenFunctor[U]): TokenFunctor[U] = {\n    func(value)\n  }\n\n  def getOrElse(default: => T): T = {\n    if (value != null) value else default\n  }\n}\n\nclass TokenMonad[T](value: T) extends TokenFunctor[T](value) {\n  def ap[U](funcWrapped: TokenMonad[T => U]): TokenMonad[U] = {\n    new TokenMonad(funcWrapped.value(value))\n  }\n}\n\nobject TokenMonad {\n  def pure[T](value: T): TokenMonad[T] = new TokenMonad(value)\n}\n\n// ============================================================================\n// JSON Structure Tokenization\n// ============================================================================\n\nsealed trait JsonValue\ncase class JsonString(v: String) extends JsonValue\ncase class JsonNumber(v: Double) extends JsonValue\ncase class JsonBoolean(v: Boolean) extends JsonValue\ncase object JsonNull extends JsonValue\ncase class JsonArray(v: List[JsonValue]) extends JsonValue\ncase class JsonObject(v: Map[String, JsonValue]) extends JsonValue\n\nclass JsonTokenizer(pretty: Boolean = false) {\n  def tokenize(value: JsonValue): Token = {\n    val jsonStr = stringify(value)\n    Token(jsonStr, TokenType.STRUCTURED, Map("json" -> true))\n  }\n\n  private def stringify(value: JsonValue): String = {\n    // Simple JSON stringifier\n    value match {\n      case JsonString(s) => s"\\"$s\\""\n      case JsonNumber(n) => n.toString\n      case JsonBoolean(b) => b.toString\n      case JsonNull => "null"\n      case JsonArray(arr) => arr.map(stringify).mkString("[", ", ", "]")\n      case JsonObject(obj) => obj.map { case (k, v) => s"\\"$k\\": ${stringify(v)}" }.mkString("{", ", ", "}")\n    }\n  }\n\n  def tokenizePath(value: JsonValue, path: String): Option[Token] = {\n    val parts = path.split("\\\\.")\n    var current: Option[JsonValue] = Some(value)\n\n    for (part <- parts if current.isDefined) {\n      current = current.get match {\n        case JsonObject(obj) => obj.get(part)\n        case JsonArray(arr) if part.forall(_.isDigit) => \n          val idx = part.toInt\n          if (idx >= 0 && idx < arr.length) Some(arr(idx)) else None\n        case _ => None\n      }\n    }\n\n    current.map(tokenize)\n  }\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
