Sending keys: ['cat >> /root/Tokenizer.scala << \'EOF\'\n\nclass UniversalTokenizer(\n  stringTokenizer: Option[StringTokenizer] = None,\n  numericTokenizer: Option[NumericTokenizer] = None,\n  temporalTokenizer: Option[TemporalTokenizer] = None,\n  handleNull: Boolean = true,\n  nullToken: String = "<NULL>"\n) extends BaseTokenizer[Any] {\n\n  private val defaultStringTokenizer = stringTokenizer.getOrElse(new StringTokenizer())\n  private val defaultNumericTokenizer = numericTokenizer.getOrElse(new NumericTokenizer())\n  private val defaultTemporalTokenizer = temporalTokenizer.getOrElse(new TemporalTokenizer())\n\n  def tokenize(value: Any): Token = {\n    value match {\n      case null if handleNull =>\n        Token(nullToken, TokenType.Null, Map("is_null" -> true))\n\n      case null =>\n        throw new IllegalArgumentException("Null values not supported")\n\n      case None if handleNull =>\n        Token(nullToken, TokenType.Null, Map("is_null" -> true))\n\n      case Some(v) =>\n        tokenize(v)\n\n      case s: String =>\n        defaultStringTokenizer.tokenize(s)\n\n      case _: Int | _: Long | _: Float | _: Double | _: BigDecimal =>\n        defaultNumericTokenizer.tokenize(value)\n\n      case _: LocalDate | _: LocalDateTime =>\n        defaultTemporalTokenizer.tokenize(value)\n\n      case seq: Seq[_] =>\n        val tokens = seq.map(tokenize)\n        val concatenated = tokens.map(_.value).mkString(",")\n        Token(s"[$concatenated]", TokenType.Structured, Map("element_count" -> seq.length))\n\n      case map: Map[_, _] =>\n        val pairs = map.map { case (k, v) =>\n          s"${tokenize(k).value}:${tokenize(v).value}"\n        }.mkString(",")\n        Token(s"{$pairs}", TokenType.Structured, Map("key_count" -> map.size))\n\n      case t: Tokenizable =>\n        Token(t.toToken, TokenType.String, Map("custom_tokenizable" -> true))\n\n      case _ =>\n        Token(value.toString, TokenType.String, Map("fallback" -> true))\n    }\n  }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
