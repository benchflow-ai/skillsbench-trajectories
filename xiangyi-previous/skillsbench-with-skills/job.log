Sending keys: ['python3 << \'EOF\'\nimport numpy as np\nimport os\nimport glob\nfrom scipy import signal\n\ndef sta_lta(data, sta_len, lta_len):\n    """\n    Calculate STA/LTA characteristic function\n    """\n    sta = np.convolve(data**2, np.ones(sta_len)/sta_len, mode=\'same\')\n    lta = np.convolve(data**2, np.ones(lta_len)/lta_len, mode=\'same\')\n    \n    # Avoid division by zero\n    lta[lta == 0] = 1e-10\n    \n    return sta / lta\n\ndef pick_phases(trace_data, dt, sta_p=5, lta_p=100, sta_s=10, lta_s=200, \n                 threshold_p=3.5, threshold_s=3.0):\n    """\n    Pick P and S wave arrivals from 3-component seismic data\n    """\n    # Apply bandpass filter\n    fs = 1.0 / dt\n    \n    # For P-wave: use vertical component (index 2), higher frequency\n    sos_p = signal.butter(4, [1, 15], btype=\'band\', fs=fs, output=\'sos\')\n    vertical_filt = signal.sosfilt(sos_p, trace_data[:, 2])\n    \n    # Calculate STA/LTA for P-wave\n    cf_p = sta_lta(np.abs(vertical_filt), int(sta_p/dt), int(lta_p/dt))\n    \n    # Pick P-wave arrivals\n    p_picks = []\n    above_threshold = cf_p > threshold_p\n    # Find trigger points\n    triggers = np.where(np.diff(above_threshold.astype(int)) == 1)[0]\n    \n    # Only keep the first strong trigger for P-wave\n    if len(triggers) > 0:\n        # Look in first half of trace for P-wave\n        early_triggers = triggers[triggers < len(cf_p) // 2]\n        if len(early_triggers) > 0:\n            p_picks.append(early_triggers[0])\n    \n    # For S-wave: use horizontal components, lower frequency\n    sos_s = signal.butter(4, [1, 10], btype=\'band\', fs=fs, output=\'sos\')\n    horizontal_1 = signal.sosfilt(sos_s, trace_data[:, 0])\n    horizontal_2 = signal.sosfilt(sos_s, trace_data[:, 1])\n    \n    # Combine horizontal components\n    horizontal_combined = np.sqrt(horizontal_1**2 + horizontal_2**2)\n    \n    # Calculate STA/LTA for S-wave\n    cf_s = sta_lta(horizontal_combined, int(sta_s/dt), int(lta_s/dt))\n    \n    # Pick S-wave arrivals (should be after P-wave)\n    s_picks = []\n    above_threshold_s = cf_s > threshold_s\n    triggers_s = np.where(np.diff(above_threshold_s.astype(int)) == 1)[0]\n    \n    # S-wave should come after P-wave\n    search_start = p_picks[0] + int(0.2/dt) if len(p_picks) > 0 else int(0.5/dt)\n    \n    for trigger in triggers_s:\n        if trigger > search_start and trigger < len(cf_s) - int(1.0/dt):\n            s_picks.append(trigger)\n            break  # Take first good S-wave pick\n    \n    return p_picks, s_picks\n\n# Test on one file\nsample_file = \'/root/data/BG.ACR..DP.0215954.npz\'\ndata = np.load(sample_file)\ntrace = data[\'data\']\ndt = float(data[\'dt\'])\n\np_picks, s_picks = pick_phases(trace, dt)\nprint(f"P picks: {p_picks}")\nprint(f"S picks: {s_picks}")\nprint(f"Trace length: {len(trace)}")\nprint(f"Sampling rate: {1/dt} Hz")\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
