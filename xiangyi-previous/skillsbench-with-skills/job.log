Sending keys: ['python3 << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Read the Excel files\ndf_10_raw = pd.read_excel(\'/root/ERP-2025-table10.xls\', sheet_name=0, engine=\'xlrd\', header=None)\ndf_12_raw = pd.read_excel(\'/root/ERP-2025-table12.xls\', sheet_name=0, engine=\'xlrd\', header=None)\ndf_cpi = pd.read_excel(\'/root/CPI.xlsx\', sheet_name=0)\n\n# Extract PCE annual data\npce_annual = {}\npce_quarterly_2024 = []\nfor i in range(5, len(df_10_raw)):\n    year_str = str(df_10_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == \'nan\':\n        continue\n    value = df_10_raw.iloc[i, 1]\n    if pd.notna(value):\n        # Check if it\'s annual (ends with period) or quarterly\n        if year_str.endswith(\'.\'):\n            try:\n                year = int(year_str.rstrip(\'.\'))\n                pce_annual[year] = value\n            except:\n                pass\n        elif \'2024:\' in year_str:\n            pce_quarterly_2024.append(value)\n\n# Extract PFI annual data\npfi_annual = {}\npfi_quarterly_2024 = []\nfor i in range(6, len(df_12_raw)):\n    year_str = str(df_12_raw.iloc[i, 0]).strip()\n    if not year_str or year_str == \'nan\':\n        continue\n    value = df_12_raw.iloc[i, 1]\n    if pd.notna(value):\n        # Check if it\'s annual (ends with period) or quarterly\n        if year_str.endswith(\'.\'):\n            try:\n                year = int(year_str.rstrip(\'.\'))\n                pfi_annual[year] = value\n            except:\n                pass\n        elif \'2024:\' in year_str:\n            pfi_quarterly_2024.append(value)\n\nprint("PCE Annual data:")\nprint(f"Years: {sorted(pce_annual.keys())}")\nprint(f"Count: {len(pce_annual)}")\nprint(f"2024 Quarterly data: {pce_quarterly_2024}")\nprint(f"2024 Average: {np.mean(pce_quarterly_2024)}")\n\nprint("\\nPFI Annual data:")\nprint(f"Years: {sorted(pfi_annual.keys())}")\nprint(f"Count: {len(pfi_annual)}")\nprint(f"2024 Quarterly data: {pfi_quarterly_2024}")\nprint(f"2024 Average: {np.mean(pfi_quarterly_2024)}")\n\n# Create annual series from 1973 to 2024\nyears = list(range(1973, 2024))\npce_values = [pce_annual[y] for y in years]\npfi_values = [pfi_annual[y] for y in years]\n\n# Add 2024 as average of available quarters\npce_values.append(np.mean(pce_quarterly_2024))\npfi_values.append(np.mean(pfi_quarterly_2024))\nyears.append(2024)\n\nprint(f"\\nFinal annual series (1973-2024): {len(years)} years")\nprint(f"PCE: {pce_values[:5]} ... {pce_values[-5:]}")\nprint(f"PFI: {pfi_values[:5]} ... {pfi_values[-5:]}")\nprint(f"Years: {years[:5]} ... {years[-5:]}")\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
