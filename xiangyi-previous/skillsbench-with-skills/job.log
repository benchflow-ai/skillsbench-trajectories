ng\n    norm_text = text.replace(\'th,\', \',\').replace(\'st,\', \',\').replace(\'nd,\', \',\').replace(\'rd,\', \',\')\n    \n    # Simplistic parsing logic for the specific task examples\n    if "January 8" in text and "January 9" in text:\n        possible_dates = [datetime.date(2026, 1, 8), datetime.date(2026, 1, 9)]\n    elif "January 6" in text and "7th" in text:\n        possible_dates = [datetime.date(2026, 1, 6), datetime.date(2026, 1, 7)]\n    elif "January 8" in text:\n         possible_dates = [datetime.date(2026, 1, 8)]\n         \n    # Extract time constraints\n    start_hour = 9\n    end_hour = 17\n    \n    # Example 1: "10:00am to 2:00pm"\n    # Example 2: "11:00 AM and 3:00 PM"\n    # Example 3: "9:30am and 11:30am"\n    \n    time_match = re.search(r\'(\\d{1,2}:?\\d{0,2})\\s*(am|pm)?\\s*(to|and)\\s*(\\d{1,2}:?\\d{0,2})\\s*(am|pm)\', text, re.IGNORECASE)\n    if time_match:\n        t1_str = time_match.group(1)\n        t1_ampm = time_match.group(2)\n        t2_str = time_match.group(4)\n        t2_ampm = time_match.group(5)\n        \n        if not t1_ampm and t2_ampm: t1_ampm = t2_ampm # Assume same if missing\n        \n        def parse_time(t_str, ampm):\n            if \':\' in t_str:\n                h, m = map(int, t_str.split(\':\'))\n            else:\n                h = int(t_str)\n                m = 0\n            if ampm and ampm.lower() == \'pm\' and h != 12:\n                h += 12\n            if ampm and ampm.lower() == \'am\' and h == 12:\n                h = 0\n            return datetime.time(h, m)\n            \n        start_time = parse_time(t1_str, t1_ampm)\n        end_time = parse_time(t2_str, t2_ampm)\n    else:\n        # Fallback default\n        start_time = datetime.time(9, 0)\n        end_time = datetime.time(17, 0)\n        \n    return {\n        \'duration\': duration,\n        \'dates\': possible_dates,\n        \'start_time\': start_time,\n        \'end_time\': end_time\n    }\n\ndef check_calendar_availability(service, date, start_time_constraint, end_time_constraint, duration_hours):\n    # Define the search window for the day\n    time_min = datetime.datetime.combine(date, start_time_constraint).isoformat() + \'Z\'\n    time_max = datetime.datetime.combine(date, end_time_constraint).isoformat() + \'Z\'\n    \n    events_result = service.events().list(calendarId=\'primary\', timeMin=time_min, timeMax=time_max, singleEvents=True, orderBy=\'startTime\').execute()\n    events = events_result.get(\'items\', [])\n    \n    # Find a slot\n    current_start = datetime.datetime.combine(date, start_time_constraint)\n    window_end = datetime.datetime.combine(date, end_time_constraint)\n    \n    # Iterate through events to find gaps\n    # We need to sort events just in case\n    busy_slots = []\n    for event in events:\n        start = event[\'start\'].get(\'dateTime\', event[\'start\'].get(\'date\'))\n        end = event[\'end\'].get(\'dateTime\', event[\'end\'].get(\'date\'))\n        # Parse to datetime objects (naive for simplicity, assuming local time matches)\n        # Note: The API returns RFC3339 timestamps (e.g., 2026-01-08T10:00:00-07:00). We should handle timezones properly or assume local.\n        # For this task, let\'s assume everything is in the same timezone or ignore offset for simplicity if possible, \n        # but correct way is to use dateutil parser.\n        busy_slots.append((date_parser.parse(start), date_parser.parse(end)))\n        \n    # Sort busy slots\n    busy_slots.sort(key=lambda x: x[0])\n    \n    # Try to fit the meeting\n    meeting_duration = datetime.timedelta(hours=duration_hours)\n    \n    # Check availability\n    # Simplification: Convert everything to offset-naive for comparison if we assume same timezone context\n    # Or better, keep offsets. Let\'s try to find the first gap.\n    \n    # We need to ensure current_start has timezone info if busy_slots do.\n    # Let\'s assume the calendar events have timezone info. We should add timezone info to current_start.\n    # However, we don\'t know the local timezone easily without querying settings. \n    # Let\'s try to infer from the first event or default to UTC if no events.\n    \n    tzinfo = datetime.timezone.utc\n    if busy_slots:\n        tzinfo = busy_slots[0][0].tzinfo\n        \n    current_start = current_start.replace(tzinfo=tzinfo)\n    window_end = window_end.replace(tzinfo=tzinfo)\n    \n    for busy_start, busy_end in busy_slots:\n        if current_start + meeting_duration <= busy_start:\n            return current_start, current_start + meeting_duration\n        current_start = max(current_start, busy_end)\n        \n    if current_start + meeting_duration <= window_end:\n        return current_start, current_start + meeting_duration\n        \n    return None, None\n\ndef send_email(service, to_email, subject, body_text):\n    message = MIMEText(body_text)\n    message[\'to\'] = to_email\n    message[\'subject\'] = subject\n    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode(\'utf-8\')\n    body = {\'raw\': raw_message}\n    \n    try:\n        message = service.users().messages().send(userId=\'me\', body=body).execute()\n        return message[\'id\']\n    except Exception as e:\n        print(f\'An error occurred: {e}\')\n        return None\n\ndef main():\n    # Load input\n    with open(INPUT_FILE, \'r\') as f:\n        requests = json.load(f)\n        \n    # Auth\n    try:\n        calendar_service = get_service(\'calendar\', CALENDAR_TOKEN_PATH, SCOPES_CALENDAR)\n        gmail_service = get_service(\'gmail\', GMAIL_TOKEN_PATH, SCOPES_GMAIL)\n    except Exception as e:\n        print(e)\n        return\n\n    sent_results = []\n\n    for req in requests:\n        email_text = req[\'email_text\']\n        from_email = req[\'from_email\']\n        \n        constraints = parse_email_content(email_text)\n        \n        proposed_start = None\n        proposed_end = None\n        \n        for date in constraints[\'dates\']:\n            start, end = check_calendar_availability(\n                calendar_service, \n                date, \n                constraints[\'start_time\'], \n                constraints[\'end_time\'], \n                constraints[\'duration\']\n            )\n            if start:\n                proposed_start = start\n                proposed_end = end\n                break\n        \n        if proposed_start:\n            # Format the reply\n            day_name = proposed_start.strftime(\'%A\')\n            month = proposed_start.strftime(\'%B\')\n            dd = proposed_start.strftime(\'%d\')\n            yyyy = proposed_start.strftime(\'%Y\')\n            date_formatted = f"{month} {dd}, {yyyy}"\n            \n            time_range = f"{proposed_start.strftime(\'%I:%M %p\')} - {proposed_end.strftime(\'%I:%M %p\')}"\n            \n            reply_body = f"Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: {day_name}, {date_formatted}\\nTime: {time_range}\\nDuration: {constraints[\'duration\']} hour(s)\\n\\nIf this time doesn\'t work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench"\n            \n            print(f"Sending email to {from_email}...")\n            msg_id = send_email(gmail_service, from_email, "Re: Meeting Request", reply_body)\n            if msg_id:\n                sent_results.append({"messageId": msg_id})\n        else:\n            print(f"Could not find a slot for request from {from_email}")\n            \n    # Save results\n    with open(RESULTS_FILE, \'w\') as f:\n        json.dump({"sent_results": sent_results}, f)\n        \nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
