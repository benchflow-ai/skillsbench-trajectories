Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nimport qutip as qt\nfrom scipy.special import factorial\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Spin frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\n# Grid for Wigner function\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# Spin dimension (using collective spin representation)\n# For N spin-1/2 particles, j = N/2\nj = N / 2\ndim_spin = int(2 * j + 1)  # Dimension of spin Hilbert space\n\nprint(f"Setting up Dicke model with N={N} spins, n_max={n_max} photons")\nprint(f"Spin dimension: {dim_spin}, Cavity dimension: {n_max}")\nprint(f"Total Hilbert space dimension: {dim_spin * n_max}")\n\n# Create operators\n# Cavity operators\na = qt.tensor(qt.destroy(n_max), qt.qeye(dim_spin))\n\n# Collective spin operators using jmat\nJz = qt.tensor(qt.qeye(n_max), qt.jmat(j, \'z\'))\nJp = qt.tensor(qt.qeye(n_max), qt.jmat(j, \'+\'))\nJm = qt.tensor(qt.qeye(n_max), qt.jmat(j, \'-\'))\nJx = qt.tensor(qt.qeye(n_max), qt.jmat(j, \'x\'))\n\n# Hamiltonian\n# H = omega_0 * Jz + omega_c * a^dag * a + g * (a^dag + a) * (J+ + J-)\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint("Hamiltonian created")\n\ndef get_collapse_operators(case):\n    """\n    Get collapse operators for each case.\n    \n    For collective spin operators, we use:\n    - Local dephasing: sqrt(gamma_phi) * Jz (collective dephasing approximation)\n    - Local pumping: sqrt(gamma_up) * J+ \n    - Local emission: sqrt(gamma_down) * J-\n    - Collective pumping: sqrt(gamma_Up) * J+\n    - Collective emission: sqrt(gamma_Down) * J-\n    \n    Note: For local processes on N atoms, we scale by sqrt(N) for collective operators\n    """\n    c_ops = []\n    \n    # Cavity decay (always present)\n    c_ops.append(np.sqrt(kappa) * a)\n    \n    if case == 1:\n        # Local de-phasing & local pumping\n        gamma_phi = 0.01\n        gamma_up = 0.1\n        # For N local dephasing channels, each with rate gamma_phi\n        # Using collective operator approximation: sum of sigma_z^i ~ 2*Jz\n        # Each local dephasing: sqrt(gamma_phi) * sigma_z^i\n        # Collective effect: sqrt(N * gamma_phi) * (2/N) * Jz for proper scaling\n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz)  # Dephasing\n        c_ops.append(np.sqrt(gamma_up) * Jp)  # Local pumping (collective approx)\n        \n    elif case == 2:\n        # Local de-phasing & local emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz)  # Dephasing\n        c_ops.append(np.sqrt(gamma_down) * Jm)  # Local emission\n        \n    elif case == 3:\n        # Local de-phasing & local emission & collective pumping\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Up = 0.1  # Collective pumping\n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz)  # Dephasing\n        c_ops.append(np.sqrt(gamma_down) * Jm)  # Local emission\n        c_ops.append(np.sqrt(gamma_Up) * Jp)  # Collective pumping\n        \n    elif case == 4:\n        # Local de-phasing & local emission & collective emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Down = 0.1  # Collective emission\n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz)  # Dephasing\n        c_ops.append(np.sqrt(gamma_down) * Jm)  # Local emission\n        c_ops.append(np.sqrt(gamma_Down) * Jm)  # Collective emission\n    \n    return c_ops\n\ndef solve_steady_state_and_wigner(case):\n    """\n    Solve for steady state and compute Wigner function of cavity.\n    """\n    print(f"\\nCase {case}: Computing steady state...")\n    \n    c_ops = get_collapse_operators(case)\n    \n    # Solve for steady state\n    try:\n        rho_ss = qt.steadystate(H, c_ops, method=\'direct\')\n        print(f"  Steady state found using direct method")\n    except:\n        try:\n            rho_ss = qt.steadystate(H, c_ops, method=\'iterative-gmres\')\n            print(f"  Steady state found using iterative-gmres method")\n        except:\n            rho_ss = qt.steadystate(H, c_ops, method=\'eigen\')\n            print(f"  Steady state found using eigen method")\n    \n    # Trace out spin degrees of freedom to get cavity state\n    # The tensor structure is: cavity x spin\n    # We need to trace over the spin (index 1)\n    rho_cavity = rho_ss.ptrace(0)\n    \n    print(f"  Cavity state obtained, dim = {rho_cavity.shape}")\n    print(f"  Trace of cavity state: {rho_cavity.tr():.6f}")\n    print(f"  Mean photon number: {qt.expect(qt.destroy(n_max).dag() * qt.destroy(n_max), rho_cavity):.4f}")\n    \n    # Calculate Wigner function\n    print(f"  Computing Wigner function on {len(xvec)}x{len(pvec)} grid...")\n    W = qt.wigner(rho_cavity, xvec, pvec)\n    \n    print(f"  Wigner function computed, shape = {W.shape}")\n    print(f"  Wigner min: {W.min():.6f}, max: {W.max():.6f}")\n    \n    return W\n\n# Process all 4 cases\nfor case in range(1, 5):\n    W = solve_steady_state_and_wigner(case)\n    \n    # Save to CSV\n    filename = f"{case}.csv"\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"  Saved to {filename}")\n\nprint("\\nAll cases completed!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
