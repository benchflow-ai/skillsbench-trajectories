i in largest_tri_indices)\nprint(f"Material IDs in largest component: {material_ids}")\nmaterial_id = list(material_ids)[0]\n\n# Calculate signed volume using tetrahedron method\n# Volume = sum of (v1 . (v2 x v3)) / 6 for each triangle\ndef signed_volume_of_triangle(v1, v2, v3):\n    # Cross product v2 x v3\n    cross = (\n        v2[1]*v3[2] - v2[2]*v3[1],\n        v2[2]*v3[0] - v2[0]*v3[2],\n        v2[0]*v3[1] - v2[1]*v3[0]\n    )\n    # Dot product v1 . cross\n    dot = v1[0]*cross[0] + v1[1]*cross[1] + v1[2]*cross[2]\n    return dot / 6.0\n\ntotal_volume = 0.0\nfor i in largest_tri_indices:\n    t = triangles[i]\n    v1, v2, v3 = t[\'vertices\']\n    total_volume += signed_volume_of_triangle(v1, v2, v3)\n\n# Volume should be positive (absolute value)\nvolume = abs(total_volume)\nprint(f"Volume: {volume} cubic units")\n\n# Density lookup (from material_density_table.md)\ndensity_table = {\n    1: 0.10,   # Generic Debris\n    10: 7.85,  # Standard Steel\n    25: 2.70,  # Aluminum 6061\n    42: 5.55,  # Unobtanium\n    99: 11.34  # Lead\n}\n\ndensity = density_table.get(material_id, None)\nprint(f"Material ID: {material_id}, Density: {density} g/cm³")\n\n# Calculate mass\nmass = volume * density\nprint(f"Mass: {mass} g")\n\n# Save result\nresult = {\n    "main_part_mass": round(mass, 2),\n    "material_id": material_id\n}\nprint(f"Result: {json.dumps(result, indent=2)}")\n\nwith open(\'/root/mass_report.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\nprint("Saved to /root/mass_report.json")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
