ow_idx, 13).value\n    \n    dots_sheet.cell(row_idx, 1).value = name\n    dots_sheet.cell(row_idx, 2).value = sex\n    dots_sheet.cell(row_idx, 3).value = bw\n    dots_sheet.cell(row_idx, 4).value = squat\n    dots_sheet.cell(row_idx, 5).value = bench\n    dots_sheet.cell(row_idx, 6).value = deadlift\n\nprint("Data copied successfully!")\nprint(f"Rows copied: {data_sheet.max_row - 1}")\n\n# Save the workbook\nwb.save(\'/root/data/openipf.xlsx\')\nprint("Workbook saved!")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
