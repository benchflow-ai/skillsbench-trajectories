Sending keys: ['\n\npython3 << \'ENDPY\'\nimport sys\nwith open(\'dicke_simulation.py\', \'w\') as f:\n    f.write(\'\'\'import numpy as np\nimport qutip as qt\n\nN = 4\nomega_0 = 1.0\nomega_c = 1.0  \ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\nprint("Setting up Dicke model...")\n\ndef spin_operator(op, i, N, n_max):\n    op_list = [qt.qeye(n_max)]\n    for j in range(N):\n        op_list.append(op if j == i else qt.qeye(2))\n    return qt.tensor(op_list)\n\ndef collective_operator(op, N, n_max):\n    return sum(spin_operator(op, i, N, n_max) for i in range(N))\n\nop_list_a = [qt.destroy(n_max)] + [qt.qeye(2) for _ in range(N)]\na = qt.tensor(op_list_a)\nJz = collective_operator(qt.sigmaz() / 2.0, N, n_max)\nJp = collective_operator(qt.sigmap(), N, n_max)\nJm = collective_operator(qt.sigmam(), N, n_max)\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\ndef solve_case(case_num, collapse_ops, desc):\n    print(f"Case {case_num}: {desc}")\n    c_ops = [np.sqrt(kappa) * a] + collapse_ops\n    rho_ss = qt.steadystate(H, c_ops, method="eigen", sparse=True)\n    rho_cavity = rho_ss.ptrace(0)\n    xvec = np.linspace(-6, 6, 1000)\n    pvec = np.linspace(-6, 6, 1000)\n    W = qt.wigner(rho_cavity, xvec, pvec)\n    np.savetxt(f"{case_num}.csv", W, delimiter=",")\n    print(f"Saved {case_num}.csv")\n    return W\n\nfor case in range(1, 5):\n    gamma_phi, gamma_down, gamma_up = 0.01, 0.1, 0.1\n    c_ops = []\n    for i in range(N):\n        c_ops.append(np.sqrt(gamma_phi) * spin_operator(qt.sigmaz(), i, N, n_max))\n    if case == 1:\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_up) * spin_operator(qt.sigmap(), i, N, n_max))\n    else:\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_down) * spin_operator(qt.sigmam(), i, N, n_max))\n        if case == 3:\n            c_ops.append(np.sqrt(0.1) * Jp)\n        elif case == 4:\n            c_ops.append(np.sqrt(0.1) * Jm)\n    solve_case(case, c_ops, ["Local dephasing & pumping", "Local dephasing & emission", "+ collective pumping", "+ collective emission"][case-1])\nprint("Done!")\n\'\'\')\nprint("File created")\nENDPY\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
