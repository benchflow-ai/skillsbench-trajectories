Sending keys: ['cat << \'EOF\' > optimize_dbscan.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom joblib import Parallel, delayed\nimport itertools\n\n# Load data\ncitsci = pd.read_csv(\'/root/data/citsci_train.csv\')\nexpert = pd.read_csv(\'/root/data/expert_train.csv\')\n\n# Group by image\n# Expert images define the universe of images we care about\nexpert_images = expert[\'file_rad\'].unique()\ncitsci_grouped = citsci.groupby(\'file_rad\')\nexpert_grouped = expert.groupby(\'file_rad\')\n\n# Pre-fetch data for all expert images to avoid repeated indexing\nimage_data = {}\nfor img in expert_images:\n    # Get expert points\n    if img in expert_grouped.groups:\n        exp_pts = expert_grouped.get_group(img)[[\'x\', \'y\']].values\n    else:\n        exp_pts = np.empty((0, 2))\n    \n    # Get citizen science points\n    if img in citsci_grouped.groups:\n        cit_pts = citsci_grouped.get_group(img)[[\'x\', \'y\']].values\n    else:\n        cit_pts = np.empty((0, 2))\n        \n    image_data[img] = {\'exp\': exp_pts, \'cit\': cit_pts}\n\n# Define parameter grid\nmin_samples_range = range(3, 10)\nepsilon_range = range(4, 26, 2)\nshape_weight_range = [round(x, 1) for x in np.arange(0.9, 2.0, 0.1)]\n\nparam_grid = list(itertools.product(min_samples_range, epsilon_range, shape_weight_range))\n\ndef evaluate_params(params):\n    min_samples, eps, w = params\n    \n    f1_scores = []\n    deltas = []\n    \n    # Scaling factors for custom distance\n    # d = sqrt((w*dx)^2 + ((2-w)*dy)^2)\n    # We scale x by w and y by (2-w) then use standard Euclidean\n    scale_x = w\n    scale_y = 2 - w\n    \n    for img in expert_images:\n        data = image_data[img]\n        cit_pts = data[\'cit\']\n        exp_pts = data[\'exp\']\n        \n        # If no cit points, F1=0, delta=NaN\n        if len(cit_pts) == 0:\n            f1_scores.append(0.0)\n            deltas.append(np.nan)\n            continue\n            \n        # Scale points for DBSCAN\n        cit_pts_scaled = cit_pts.copy()\n        cit_pts_scaled[:, 0] *= scale_x\n        cit_pts_scaled[:, 1] *= scale_y\n        \n        # Run DBSCAN\n        # eps is applied in the scaled space\n        db = DBSCAN(eps=eps, min_samples=min_samples, metric=\'euclidean\', algorithm=\'brute\')\n        labels = db.fit_predict(cit_pts_scaled)\n        \n        # Extract clusters\n        unique_labels = set(labels)\n        if -1 in unique_labels:\n            unique_labels.remove(-1)\n            \n        if not unique_labels:\n            # No clusters found\n            f1_scores.append(0.0)\n            deltas.append(np.nan)\n            continue\n            \n        # Compute centroids in ORIGINAL space\n        centroids = []\n        for l in unique_labels:\n            cluster_points = cit_pts[labels == l]\n            centroids.append(cluster_points.mean(axis=0))\n        centroids = np.array(centroids)\n        \n        # Match with expert points\n        # Greedy matching based on Euclidean distance, max 100 pixels\n        if len(exp_pts) == 0:\n            # No expert points to match against -> Precision=0, Recall=0 (undefined?), F1=0\n            f1_scores.append(0.0)\n            deltas.append(np.nan)\n            continue\n            \n        # Distance matrix (centroids vs expert)\n        dists = cdist(centroids, exp_pts, metric=\'euclidean\')\n        \n        matches = []\n        matched_centroids = set()\n        matched_experts = set()\n        \n        # List of all possible pairs sorted by distance\n        possible_matches = []\n        for i in range(len(centroids)):\n            for j in range(len(exp_pts)):\n                if dists[i, j] <= 100:\n                    possible_matches.append((dists[i, j], i, j))\n        \n        possible_matches.sort(key=lambda x: x[0])\n        \n        match_deltas = []\n        \n        for d, c_idx, e_idx in possible_matches:\n            if c_idx not in matched_centroids and e_idx not in matched_experts:\n                matched_centroids.add(c_idx)\n                matched_experts.add(e_idx)\n                match_deltas.append(d)\n                \n        tp = len(matched_centroids)\n        fp = len(centroids) - tp\n        fn = len(exp_pts) - tp\n        \n        if tp == 0:\n            f1 = 0.0\n            delta = np.nan\n        else:\n            precision = tp / (tp + fp)\n            recall = tp / (tp + fn)\n            f1 = 2 * (precision * recall) / (precision + recall)\n            delta = np.mean(match_deltas)\n            \n        f1_scores.append(f1)\n        deltas.append(delta)\n        \n    # Aggregate results\n    avg_f1 = np.mean(f1_scores)\n    \n    # Filter out NaNs for delta average\n    valid_deltas = [d for d in deltas if not np.isnan(d)]\n    if valid_deltas:\n        avg_delta = np.mean(valid_deltas)\n    else:\n        avg_delta = np.nan # Should probably not happen if F1 > 0\n        \n    return {\n        \'min_samples\': min_samples,\n        \'epsilon\': eps,\n        \'shape_weight\': w,\n        \'F1\': avg_f1,\n        \'delta\': avg_delta\n    }\n\n# Run grid search in parallel\nresults = Parallel(n_jobs=-1)(delayed(evaluate_params)(p) for p in param_grid)\nresults_df = pd.DataFrame(results)\n\n# Filter results\nfiltered_df = results_df[results_df[\'F1\'] > 0.5].copy()\n\nif filtered_df.empty:\n    print("No results with F1 > 0.5")\n    filtered_df.to_csv(\'/root/pareto_frontier.csv\', index=False)\n    exit()\n\n# Find Pareto frontier\n# Maximize F1, Minimize delta\n# Sort by F1 descending to make it easier\nfiltered_df = filtered_df.sort_values(\'F1\', ascending=False).reset_index(drop=True)\n\npareto_indices = []\n\n# A simple way to find Pareto frontier for 2 objectives:\n# Sort by one objective (F1 desc), then keep point if it improves the other objective (delta)\n# relative to the best seen so far.\n# Since we want to MINIMIZE delta, we keep a running minimum of delta.\n\n# However, strictly speaking, for duplicates in F1, we want the best delta.\n# And we need to handle the trade-off.\n\n# Let\'s do a standard check:\n# Point A dominates B if F1(A) >= F1(B) AND delta(A) <= delta(B) \n# AND (F1(A) > F1(B) OR delta(A) < delta(B))\n\nis_pareto = []\nfor i, row in filtered_df.iterrows():\n    dominated = False\n    for j, other in filtered_df.iterrows():\n        if i == j: \n            continue\n        \n        # Check if \'other\' dominates \'row\'\n        if (other[\'F1\'] >= row[\'F1\'] and other[\'delta\'] <= row[\'delta\']) and \\\n           (other[\'F1\'] > row[\'F1\'] or other[\'delta\'] < row[\'delta\']):\n            dominated = True\n            break\n    is_pareto.append(not dominated)\n\npareto_df = filtered_df[is_pareto].copy()\n\n# Rounding\npareto_df[\'F1\'] = pareto_df[\'F1\'].round(5)\npareto_df[\'delta\'] = pareto_df[\'delta\'].round(5)\npareto_df[\'shape_weight\'] = pareto_df[\'shape_weight\'].round(1)\n\n# Select columns and save\noutput_cols = [\'F1\', \'delta\', \'min_samples\', \'epsilon\', \'shape_weight\']\npareto_df[output_cols].to_csv(\'/root/pareto_frontier.csv\', index=False)\n\nprint("Pareto frontier saved.")\nprint(pareto_df[output_cols])\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
