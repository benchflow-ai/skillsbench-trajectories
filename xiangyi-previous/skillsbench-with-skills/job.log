Sending keys: ['python3 << \'EOF\'\nimport cv2\nimport numpy as np\nimport csv\n\ndef count_objects(frame_path, template_path, threshold=0.7):\n    """Count objects in a frame using template matching"""\n    frame = cv2.imread(frame_path, cv2.IMREAD_GRAYSCALE)\n    template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n    \n    if frame is None or template is None:\n        return 0\n    \n    # Ensure template is not larger than frame\n    if template.shape[0] > frame.shape[0] or template.shape[1] > frame.shape[1]:\n        return 0\n    \n    # Perform template matching\n    result = cv2.matchTemplate(frame, template, cv2.TM_CCOEFF)\n    \n    # Find locations where match exceeds threshold\n    min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(result)\n    \n    # Normalize result to 0-1 range for threshold comparison\n    result_normalized = (result - result.min()) / (result.max() - result.min() + 1e-8)\n    \n    # Find all matches above threshold\n    locations = np.where(result_normalized >= threshold)\n    \n    if len(locations[0]) == 0:\n        return 0\n    \n    # Apply non-maximum suppression to avoid counting overlapping detections\n    points = list(zip(locations[1], locations[0]))\n    \n    if not points:\n        return 0\n    \n    # Simple clustering to merge nearby detections\n    points = sorted(points)\n    clusters = []\n    template_h, template_w = template.shape\n    min_distance = max(template_h, template_w) // 2\n    \n    for point in points:\n        found = False\n        for cluster in clusters:\n            cx, cy = cluster\n            if abs(point[0] - cx) < min_distance and abs(point[1] - cy) < min_distance:\n                found = True\n                break\n        if not found:\n            clusters.append(point)\n    \n    return len(clusters)\n\n# Load template images and convert to grayscale if needed\ncoin_template = "/root/coin.png"\nenemy_template = "/root/enemy.png"\nturtle_template = "/root/turtle.png"\n\n# Prepare CSV output\nresults = []\n\nprint("Processing frames and counting objects...")\nfor i in range(1, 28):\n    frame_path = f"/root/keyframes_{i:03d}.png"\n    frame_id = f"/root/keyframes_{i:03d}.png"\n    \n    # Count each object type\n    coins = count_objects(frame_path, coin_template, threshold=0.6)\n    enemies = count_objects(frame_path, enemy_template, threshold=0.6)\n    turtles = count_objects(frame_path, turtle_template, threshold=0.6)\n    \n    results.append({\n        \'frame_id\': frame_id,\n        \'coins\': coins,\n        \'enemies\': enemies,\n        \'turtles\': turtles\n    })\n    \n    print(f"Frame {i:03d}: coins={coins}, enemies={enemies}, turtles={turtles}")\n\n# Write to CSV\nwith open(\'/root/counting_results.csv\', \'w\', newline=\'\') as csvfile:\n    fieldnames = [\'frame_id\', \'coins\', \'enemies\', \'turtles\']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    \n    writer.writeheader()\n    writer.writerows(results)\n\nprint("\\nResults written to /root/counting_results.csv")\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
