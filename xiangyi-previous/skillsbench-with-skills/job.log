Sending keys: ['cat << \'EOF\' > solution.py\nimport pandas as pd\nimport json\nimport numpy as np\n\nmes_log = pd.read_csv(\'/app/data/mes_log.csv\')\ntest_defects = pd.read_csv(\'/app/data/test_defects.csv\')\ntc_data = pd.read_csv(\'/app/data/thermocouples.csv\')\n\n# Q1\nramp_limit = 2.0\nmax_ramp_by_run = {}\nviolating_runs = []\nfor run_id in mes_log[\'run_id\'].unique():\n    run_tc = tc_data[(tc_data[\'run_id\'] == run_id) & (tc_data[\'tc_id\'] == \'TC1\')].sort_values(\'time_s\')\n    if run_tc.empty: continue\n    preheat_data = run_tc[(run_tc[\'temp_c\'] >= 100) & (run_tc[\'temp_c\'] <= 150)]\n    if len(preheat_data) < 2: max_ramp = 0.0\n    else:\n        ramps = (preheat_data[\'temp_c\'].values[1:] - preheat_data[\'temp_c\'].values[:-1]) / (preheat_data[\'time_s\'].values[1:] - preheat_data[\'time_s\'].values[:-1])\n        max_ramp = np.max(ramps) if len(ramps) > 0 else 0.0\n    max_ramp_by_run[run_id] = {"tc_id": "TC1", "max_preheat_ramp_c_per_s": round(float(max_ramp), 2)}\n    if max_ramp > ramp_limit: violating_runs.append(run_id)\nq01 = {"ramp_rate_limit_c_per_s": ramp_limit, "violating_runs": sorted(violating_runs), "max_ramp_by_run": dict(sorted(max_ramp_by_run.items()))}\nwith open(\'/app/output/q01.json\', \'w\') as f: json.dump(q01, f, indent=2)\n\n# Q2\ntal_results = []\nfor _, row in mes_log.iterrows():\n    run_tc = tc_data[(tc_data[\'run_id\'] == row[\'run_id\']) & (tc_data[\'tc_id\'] == \'TC1\')].sort_values(\'time_s\')\n    tal_s = 0.0\n    if not run_tc.empty:\n        above = run_tc[run_tc[\'temp_c\'] > row[\'solder_liquidus_c\']]\n        if not above.empty: tal_s = above[\'time_s\'].max() - above[\'time_s\'].min()\n    tal_results.append({"run_id": row[\'run_id\'], "tc_id": "TC1", "tal_s": round(float(tal_s), 2), "required_min_tal_s": 30.0, "required_max_tal_s": 60.0, "status": "compliant" if 30 <= tal_s <= 60 else "non-compliant"})\nwith open(\'/app/output/q02.json\', \'w\') as f: json.dump(sorted(tal_results, key=lambda x: x[\'run_id\']), f, indent=2)\n\n# Q3\nfailing_runs, min_peak_by_run = [], {}\nfor _, row in mes_log.iterrows():\n    run_tc = tc_data[tc_data[\'run_id\'] == row[\'run_id\']]\n    if run_tc.empty: failing_runs.append(row[\'run_id\']); continue\n    peak_temp = run_tc[\'temp_c\'].max()\n    tc_id_at_peak = run_tc.loc[run_tc[\'temp_c\'].idxmax(), \'tc_id\']\n    min_peak_by_run[row[\'run_id\']] = {"tc_id": tc_id_at_peak, "peak_temp_c": round(float(peak_temp), 2), "required_min_peak_c": float(row[\'solder_liquidus_c\'] + 20)}\n    if peak_temp < row[\'solder_liquidus_c\'] + 20: failing_runs.append(row[\'run_id\'])\nq03 = {"failing_runs": sorted(failing_runs), "min_peak_by_run": dict(sorted(min_peak_by_run.items()))}\nwith open(\'/app/output/q03.json\', \'w\') as f: json.dump(q03, f, indent=2)\n\n# Q4\nspeed_results = []\nfor _, row in mes_log.iterrows():\n    min_line_speed = (row[\'boards_per_min\'] * row[\'board_length_cm\']) / row[\'loading_factor\']\n    meets = (row[\'conveyor_speed_cm_min\'] >= min_line_speed - 0.01) and (60 <= row[\'conveyor_speed_cm_min\'] <= 80)\n    speed_results.append({"run_id": row[\'run_id\'], "required_min_speed_cm_min": round(float(min_line_speed), 2), "actual_speed_cm_min": round(float(row[\'conveyor_speed_cm_min\']), 2), "meets": bool(meets)})\nwith open(\'/app/output/q04.json\', \'w\') as f: json.dump(sorted(speed_results, key=lambda x: x[\'run_id\']), f, indent=2)\n\n# Q5\nfamily_runs = {}\nfor _, row in mes_log.iterrows():\n    yield_val = test_defects[(test_defects[\'run_id\'] == row[\'run_id\']) & (test_defects[\'defect_type\'] == \'yield_summary\')][\'fp_yield_pct\'].iloc[0]\n    if row[\'board_family\'] not in family_runs: family_runs[row[\'board_family\']] = []\n    family_runs[row[\'board_family\']].append({"run_id": row[\'run_id\'], "yield": yield_val, "efficiency": row[\'boards_per_min\']})\nq05 = []\nfor family, runs in family_runs.items():\n    sorted_runs = sorted(runs, key=lambda x: (-x[\'yield\'], -x[\'efficiency\']))\n    q05.append({"board_family": family, "best_run_id": sorted_runs[0][\'run_id\'], "runner_up_run_ids": sorted([r[\'run_id\'] for r in sorted_runs[1:]])})\nwith open(\'/app/output/q05.json\', \'w\') as f: json.dump(sorted(q05, key=lambda x: x[\'board_family\']), f, indent=2)\nEOF\npython3 solution.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
