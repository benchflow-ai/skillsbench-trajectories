Sending keys: ['cat > calibration.py << \'EOF\'\n#!/usr/bin/env python3\n"""Calibration phase: Run open-loop test to characterize the system."""\n\nimport json\nfrom hvac_simulator import HVACSimulator\n\ndef run_calibration():\n    # Initialize simulator\n    sim = HVACSimulator()\n    \n    # Calibration parameters\n    heater_power_test = 50.0  # 50% heater power for step response\n    duration = 40.0  # 40 seconds to ensure we have good data\n    \n    print(f"Starting calibration test...")\n    print(f"Heater power: {heater_power_test}%")\n    print(f"Duration: {duration}s")\n    \n    # Reset simulator and get initial temperature\n    initial_temp = sim.reset()\n    print(f"Initial temperature: {initial_temp:.2f}C")\n    \n    # Collect initial state (heater off)\n    data = [{\n        "time": 0.0,\n        "temperature": round(initial_temp, 4),\n        "heater_power": 0.0\n    }]\n    \n    # Run open-loop test with constant heater power\n    results = sim.run_open_loop(heater_power_test, duration)\n    \n    # Add results to data\n    for result in results:\n        data.append({\n            "time": result["time"],\n            "temperature": result["temperature"],\n            "heater_power": result["heater_power"]\n        })\n    \n    print(f"Calibration complete. Collected {len(data)} data points.")\n    print(f"Final temperature: {data[-1][\'temperature\']:.2f}C")\n    \n    # Save calibration log\n    calibration_log = {\n        "phase": "calibration",\n        "heater_power_test": heater_power_test,\n        "data": data\n    }\n    \n    with open(\'calibration_log.json\', \'w\') as f:\n        json.dump(calibration_log, f, indent=2)\n    \n    print("Saved calibration_log.json")\n\nif __name__ == "__main__":\n    run_calibration()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
