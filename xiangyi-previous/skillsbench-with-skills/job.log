Sending keys: ['python3 << \'EOF\'\nimport json\nimport pdfplumber\nimport pandas as pd\n\n# Load all data\nwith open(\'/root/fraud_report.json\') as f:\n    report = json.load(f)\n\nvendors_df = pd.read_excel(\'/root/vendors.xlsx\')\npos_df = pd.read_csv(\'/root/purchase_orders.csv\')\n\n# Check for null PO numbers\nnull_po_count = sum(1 for inv in report if inv[\'po_number\'] is None)\nprint(f"Invoices with null PO number: {null_po_count}")\n\n# Verify a few specific cases\nprint("\\n=== Verification Samples ===")\n\n# Check page 3 (Unknown Vendor)\npage_3 = [inv for inv in report if inv[\'invoice_page_number\'] == 3]\nif page_3:\n    print(f"\\nPage 3: {page_3[0][\'reason\']}")\n    print(f"  Vendor: {page_3[0][\'vendor_name\']}")\n    vendor_exists = not vendors_df[vendors_df[\'name\'] == page_3[0][\'vendor_name\']].empty\n    print(f"  Vendor in database: {vendor_exists}")\n\n# Check page 1 (IBAN Mismatch)\npage_1 = [inv for inv in report if inv[\'invoice_page_number\'] == 1]\nif page_1:\n    print(f"\\nPage 1: {page_1[0][\'reason\']}")\n    print(f"  Invoice IBAN: {page_1[0][\'iban\']}")\n    vendor = vendors_df[vendors_df[\'name\'] == page_1[0][\'vendor_name\']]\n    if not vendor.empty:\n        print(f"  Expected IBAN: {vendor.iloc[0][\'iban\']}")\n        print(f"  Match: {page_1[0][\'iban\'] == vendor.iloc[0][\'iban\']}")\n\n# Check page 2 - let\'s verify what the issue is\nwith pdfplumber.open(\'/root/invoices.pdf\') as pdf:\n    text = pdf.pages[1].extract_text()\n    print(f"\\n=== Page 2 Invoice ===")\n    print(text)\n\nimport re\nvendor_match = re.search(r\'From:\\s*(.+)\', text)\namount_match = re.search(r\'Total\\s+\\$([\\d,]+\\.\\d{2})\', text)\npo_match = re.search(r\'PO Number:\\s*(.+)\', text)\n\nif all([vendor_match, amount_match, po_match]):\n    vendor_name = vendor_match.group(1).strip()\n    amount = float(amount_match.group(1).replace(\',\', \'\'))\n    po_number = po_match.group(1).strip()\n    \n    print(f"\\nPage 2 Analysis:")\n    vendor = vendors_df[vendors_df[\'name\'] == vendor_name]\n    if not vendor.empty:\n        print(f"  Vendor ID: {vendor.iloc[0][\'id\']}")\n    \n    po = pos_df[pos_df[\'po_number\'] == po_number]\n    if not po.empty:\n        print(f"  PO exists: Yes")\n        print(f"  PO Vendor ID: {po.iloc[0][\'vendor_id\']}")\n        print(f"  PO Amount: {po.iloc[0][\'amount\']}")\n        print(f"  Invoice Amount: {amount}")\n        print(f"  Amount diff: {abs(amount - po.iloc[0][\'amount\'])}")\n    else:\n        print(f"  PO exists: No")\n\nprint("\\n=== Final Report Summary ===")\nprint(f"Total invoices analyzed: 53")\nprint(f"Fraudulent invoices: {len(report)}")\nprint(f"Legitimate invoices: {53 - len(report)}")\nprint("\\nFraud breakdown:")\nreasons = {}\nfor inv in report:\n    reasons[inv[\'reason\']] = reasons.get(inv[\'reason\'], 0) + 1\nfor reason, count in sorted(reasons.items()):\n    print(f"  {reason}: {count}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
