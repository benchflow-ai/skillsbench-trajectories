Sending keys: ['cat > /app/solve.py << \'EOF\'\nimport json\nimport csv\nfrom itertools import combinations\n\ndef parse_instance(filename):\n    with open(filename, \'r\') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, \'r\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row[\'machine\'])\n            s = int(row[\'start\'])\n            e = int(row[\'end\'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\ndef parse_baseline(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\njobs, num_machines = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\npolicy = parse_policy(\'/app/data/policy.json\')\nbaseline = parse_baseline(\'/app/data/baseline_solution.json\')\n\nbaseline_ops = {}\nfor op in baseline[\'schedule\']:\n    baseline_ops[(op[\'job\'], op[\'op\'])] = op\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan = baseline[\'makespan\'] * policy[\'guards\'][\'max_makespan_ratio\']\n\nprint(f"Constraints: max_changes={max_machine_changes}, max_shift={max_start_shift}, max_makespan={max_makespan}")\n\n# Frozen operations with violations must change\nfrozen_must_change = set()\nfor key, op in baseline_ops.items():\n    is_frozen = op[\'start\'] < freeze_until\n    has_violation = overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime)\n    if is_frozen and has_violation:\n        frozen_must_change.add(key)\n\nprint(f"Must change: {frozen_must_change}")\n\ndef schedule_with_choices(jobs, downtime, num_machines, choices):\n    """Schedule with given machine choices."""\n    machine_available = [0] * num_machines\n    schedule = []\n    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\n    scheduled = set()\n    \n    while len(scheduled) < len(all_ops):\n        best = None\n        best_start = float(\'inf\')\n        \n        for j, o in all_ops:\n            if (j, o) in scheduled:\n                continue\n            if o > 0 and (j, o-1) not in scheduled:\n                continue\n            \n            machine, duration = choices[(j, o)]\n            prev_end = 0\n            if o > 0:\n                for s in schedule:\n                    if s[\'job\'] == j and s[\'op\'] == o - 1:\n                        prev_end = s[\'end\']\n                        break\n            \n            earliest = max(machine_available[machine], prev_end)\n            start = get_available_start(machine, earliest, duration, downtime)\n            \n            if start < best_start:\n                best = (j, o, machine, duration, start)\n                best_start = start\n        \n        if best is None:\n            return None\n        \n        j, o, machine, duration, start = best\n        schedule.append({\n            \'job\': j, \'op\': o, \'machine\': machine,\n            \'start\': start, \'end\': start + duration, \'dur\': duration\n        })\n        machine_available[machine] = start + duration\n        scheduled.add((j, o))\n    \n    return schedule\n\ndef evaluate(schedule, baseline_ops, downtime):\n    makespan = max(op[\'end\'] for op in schedule)\n    changes = sum(1 for op in schedule if op[\'machine\'] != baseline_ops[(op[\'job\'], op[\'op\'])][\'machine\'])\n    shift = sum(abs(op[\'start\'] - baseline_ops[(op[\'job\'], op[\'op\'])][\'start\']) for op in schedule)\n    violations = sum(1 for op in schedule if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime))\n    return makespan, changes, shift, violations\n\n# Build all possible choices for each operation\nall_choices = {}\nfor j in range(len(jobs)):\n    for o in range(len(jobs[j])):\n        key = (j, o)\n        baseline_op = baseline_ops[key]\n        alts = jobs[j][o]\n        \n        if key in frozen_must_change:\n            # Must use different machine\n            all_choices[key] = [(m, d) for m, d in alts if m != baseline_op[\'machine\']]\n        else:\n            all_choices[key] = alts\n\n# Get baseline choice for each operation\nbaseline_choice = {}\nfor key, op in baseline_ops.items():\n    for m, d in jobs[key[0]][key[1]]:\n        if m == op[\'machine\']:\n            baseline_choice[key] = (m, d)\n            break\n\n# Operations that CAN be changed (not frozen, or frozen with violation)\ncan_change = []\nfor key in all_choices:\n    baseline_op = baseline_ops[key]\n    if key in frozen_must_change:\n        continue  # Already must change\n    if baseline_op[\'start\'] >= freeze_until:  # Not frozen\n        can_change.append(key)\n\nprint(f"Can optionally change: {can_change}")\n\n# Try different combinations of changes\nbest_schedule = None\nbest_score = (float(\'inf\'), float(\'inf\'), float(\'inf\'))\n\n# Start with baseline + required changes\nbase = {}\nfor key in all_choices:\n    if key in frozen_must_change:\n        base[key] = all_choices[key][0]  # Use first alternative\n    else:\n        base[key] = baseline_choice[key]\n\n# Try adding 0 to (max_changes - len(frozen_must_change)) optional changes\nremaining_budget = max_machine_changes - len(frozen_must_change)\nprint(f"Remaining change budget: {remaining_budget}")\n\nfor num_extra in range(remaining_budget + 1):\n    for extra_ops in combinations(can_change, num_extra):\n        # For each extra op, try all non-baseline alternatives\n        alt_options = []\n        for key in extra_ops:\n            baseline_m = baseline_choice[key][0]\n            non_baseline = [(m, d) for m, d in all_choices[key] if m != baseline_m]\n            if non_baseline:\n                alt_options.append([(key, alt) for alt in non_baseline])\n        \n        if len(alt_options) != len(extra_ops):\n            continue  # Some ops have no alternatives\n        \n        if not alt_options:\n            alt_combos = [[]]\n        else:\n            from itertools import product\n            alt_combos = list(product(*alt_options))\n        \n        for combo in alt_combos:\n            choices = dict(base)\n            for key, alt in combo:\n                choices[key] = alt\n            \n            schedule = schedule_with_choices(jobs, downtime, num_machines, choices)\n            if schedule:\n                makespan, changes, shift, violations = evaluate(schedule, baseline_ops, downtime)\n                \n                if violations == 0 and changes <= max_machine_changes and shift <= max_start_shift and makespan <= max_makespan:\n                    if (makespan, changes, shift) < best_score:\n                        best_score = (makespan, changes, shift)\n                        best_schedule = schedule\n                        print(f"Found: makespan={makespan}, changes={changes}, shift={shift}")\n\nif best_schedule:\n    schedule = best_schedule\n    makespan, changes, shift, violations = evaluate(schedule, baseline_ops, downtime)\n    \n    print(f"\\nBest schedule:")\n    print(f"  Makespan: {makespan}")\n    print(f"  Changes: {changes}")\n    print(f"  Shift: {shift}")\n    print(f"  Violations: {violations}")\n    \n    schedule.sort(key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    \n    for op in schedule:\n        baseline_op = baseline_ops[(op[\'job\'], op[\'op\'])]\n        changed = "*" if op[\'machine\'] != baseline_op[\'machine\'] else " "\n        print(f"  {changed} Job {op[\'job\']} Op {op[\'op\']}: M{op[\'machine\']} [{op[\'start\']}-{op[\'end\']}]")\n    \n    solution = {"status": "FEASIBLE", "makespan": makespan, "schedule": schedule}\n    \n    with open(\'/app/output/solution.json\', \'w\') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open(\'/app/output/schedule.csv\', \'w\') as f:\n        f.write(\'job,op,machine,start,end,dur\\n\')\n        for op in schedule:\n            f.write(f"{op[\'job\']},{op[\'op\']},{op[\'machine\']},{op[\'start\']},{op[\'end\']},{op[\'dur\']}\\n")\n    \n    print("\\nSolution saved!")\nelse:\n    print("\\nNo feasible solution found!")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
