Sending keys: ['cat > /root/process_diarization.py << \'EOF\'\nimport os\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n# Try to import required libraries\ntry:\n    import torch\n    from pyannote.audio import Pipeline\n    from pyannote.audio.pipelines.utils import PipelineModel\nexcept ImportError as e:\n    print(f"Warning: {e}")\n\ntry:\n    import whisper\nexcept ImportError:\n    print("Warning: whisper not fully imported")\n\ndef extract_audio(video_path, audio_path):\n    """Extract audio from video using ffmpeg"""\n    print(f"Extracting audio from {video_path}...")\n    cmd = [\n        \'ffmpeg\', \'-i\', video_path, \'-q:a\', \'9\', \'-n\',\n        \'-acodec\', \'libmp3lame\', \'-ac\', \'1\', \'-ar\', \'16000\',\n        audio_path\n    ]\n    subprocess.run(cmd, capture_output=True)\n    return audio_path\n\ndef get_audio_duration(audio_path):\n    """Get audio duration using ffprobe"""\n    cmd = [\n        \'ffprobe\', \'-v\', \'error\', \'-show_entries\',\n        \'format=duration\', \'-of\', \'default=noprint_wrappers=1:nokey=1:noesc=1\',\n        audio_path\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    try:\n        return float(result.stdout.strip())\n    except:\n        return 0.0\n\ndef perform_diarization(audio_path):\n    """Perform speaker diarization using pyannote"""\n    print(f"Performing diarization on {audio_path}...")\n    try:\n        pipeline = Pipeline.from_pretrained(\n            "pyannote/speaker-diarization-3.0",\n            use_auth_token=None\n        )\n        diarization = pipeline(audio_path)\n        return diarization\n    except Exception as e:\n        print(f"Diarization error: {e}")\n        return None\n\ndef transcribe_audio(audio_path):\n    """Transcribe audio using Whisper"""\n    print(f"Transcribing audio...")\n    try:\n        model = whisper.load_model("base")\n        result = model.transcribe(audio_path, language="en")\n        return result\n    except Exception as e:\n        print(f"Transcription error: {e}")\n        return None\n\ndef generate_rttm(diarization, output_path):\n    """Generate RTTM format from diarization"""\n    print(f"Generating RTTM file...")\n    with open(output_path, \'w\') as f:\n        for turn, _, speaker in diarization.itertracks(yield_label=True):\n            start = turn.start\n            end = turn.end\n            duration = end - start\n            f.write(f"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n")\n\ndef align_transcripts_with_diarization(diarization, transcription):\n    """Align whisper segments with speaker labels"""\n    segments_with_speakers = []\n    \n    for segment in transcription[\'segments\']:\n        seg_start = segment[\'start\']\n        seg_end = segment[\'end\']\n        text = segment[\'text\'].strip()\n        \n        # Find which speaker is dominant in this segment\n        speaker_times = {}\n        for turn, _, speaker in diarization.itertracks(yield_label=True):\n            overlap_start = max(turn.start, seg_start)\n            overlap_end = min(turn.end, seg_end)\n            if overlap_end > overlap_start:\n                overlap = overlap_end - overlap_start\n                speaker_times[speaker] = speaker_times.get(speaker, 0) + overlap\n        \n        if speaker_times:\n            speaker = max(speaker_times, key=speaker_times.get)\n        else:\n            speaker = "spk00"\n        \n        segments_with_speakers.append({\n            \'start\': seg_start,\n            \'end\': seg_end,\n            \'speaker\': speaker,\n            \'text\': text\n        })\n    \n    return segments_with_speakers\n\ndef generate_ass_subtitles(segments, output_path):\n    """Generate ASS subtitle format"""\n    print(f"Generating ASS subtitle file...")\n    \n    ass_content = """[Script Info]\nTitle: Diarization Subtitles\nScriptType: v4.00+\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\nStyle: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n"""\n    \n    for seg in segments:\n        start_ms = int(seg[\'start\'] * 1000)\n        end_ms = int(seg[\'end\'] * 1000)\n        start_time = f"{start_ms//3600000}:{(start_ms%3600000)//60000:02d}:{(start_ms%60000)//1000:02d}.{(start_ms%1000)//10:02d}"\n        end_time = f"{end_ms//3600000}:{(end_ms%3600000)//60000:02d}:{(end_ms%60000)//1000:02d}.{(end_ms%1000)//10:02d}"\n        \n        speaker_label = seg[\'speaker\'].upper()\n        text = f"{speaker_label}: {seg[\'text\']}"\n        \n        ass_content += f"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{text}\\n"\n    \n    with open(output_path, \'w\') as f:\n        f.write(ass_content)\n\ndef calculate_speech_time(segments):\n    """Calculate total speech time"""\n    total = 0\n    for seg in segments:\n        total += seg[\'end\'] - seg[\'start\']\n    return total\n\ndef count_speakers(diarization):\n    """Count number of speakers"""\n    speakers = set()\n    for turn, _, speaker in diarization.itertracks(yield_label=True):\n        speakers.add(speaker)\n    return len(speakers)\n\ndef main():\n    input_video = "/root/input.mp4"\n    audio_path = "/tmp/audio.wav"\n    rttm_path = "/root/diarization.rttm"\n    ass_path = "/root/subtitles.ass"\n    report_path = "/root/report.json"\n    \n    steps_completed = []\n    tools_used = {}\n    libraries_used = []\n    commands_used = []\n    \n    try:\n        # Step 1: Extract audio\n        print("\\n=== Step 1: Audio Extraction ===")\n        extract_audio(input_video, audio_path)\n        steps_completed.append("audio_extraction")\n        tools_used["audio_extraction"] = "ffmpeg"\n        commands_used.append("ffmpeg")\n        audio_duration = get_audio_duration(audio_path)\n        print(f"Audio duration: {audio_duration:.2f} seconds")\n        \n        # Step 2: Diarization\n        print("\\n=== Step 2: Speaker Diarization ===")\n        diarization = perform_diarization(audio_path)\n        if diarization:\n            steps_completed.append("diarization")\n            tools_used["diarization"] = "pyannote.audio"\n            libraries_used.append("pyannote.audio")\n            commands_used.append("python3")\n            num_speakers = count_speakers(diarization)\n            print(f"Number of speakers detected: {num_speakers}")\n        else:\n            print("Diarization failed")\n            diarization = None\n        \n        # Step 3: Transcription\n        print("\\n=== Step 3: Speech Transcription ===")\n        transcription = transcribe_audio(audio_path)\n        if transcription:\n            steps_completed.append("transcription")\n            tools_used["transcription"] = "openai-whisper"\n            libraries_used.append("openai-whisper")\n            print(f"Transcription completed with {len(transcription[\'segments\'])} segments")\n        else:\n            print("Transcription failed")\n            transcription = None\n        \n        # Step 4: Align and generate outputs\n        if diarization and transcription:\n            print("\\n=== Step 4: Alignment and Output Generation ===")\n            \n            # Generate RTTM\n            generate_rttm(diarization, rttm_path)\n            steps_completed.append("rttm_generation")\n            print(f"RTTM file generated: {rttm_path}")\n            \n            # Align transcripts with speakers\n            segments_with_speakers = align_transcripts_with_diarization(diarization, transcription)\n            \n            # Generate ASS subtitles\n            generate_ass_subtitles(segments_with_speakers, ass_path)\n            steps_completed.append("subtitle_generation")\n            print(f"ASS subtitle file generated: {ass_path}")\n            \n            # Calculate metrics\n            total_speech_time = calculate_speech_time(segments_with_speakers)\n            num_speakers = count_speakers(diarization)\n            \n            # Generate report\n            print("\\n=== Step 5: Report Generation ===")\n            report = {\n                "num_speakers_pred": num_speakers,\n                "total_speech_time_sec": round(total_speech_time, 2),\n                "audio_duration_sec": round(audio_duration, 2),\n                "steps_completed": steps_completed,\n                "commands_used": list(set(commands_used)),\n                "libraries_used": list(set(libraries_used)),\n                "tools_used": tools_used,\n                "notes": f"Successfully processed {input_video} with {num_speakers} speakers. Generated RTTM, ASS subtitles, and detailed report."\n            }\n            \n            with open(report_path, \'w\') as f:\n                json.dump(report, f, indent=2)\n            \n            steps_completed.append("report_generation")\n            print(f"Report generated: {report_path}")\n            print(f"\\nSummary:")\n            print(f"  Speakers detected: {num_speakers}")\n            print(f"  Total speech time: {total_speech_time:.2f}s")\n            print(f"  Audio duration: {audio_duration:.2f}s")\n            print(f"  Steps completed: {\', \'.join(steps_completed)}")\n        else:\n            print("Cannot proceed without diarization and transcription")\n    \n    except Exception as e:\n        print(f"Error: {e}")\n        import traceback\n        traceback.print_exc()\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
