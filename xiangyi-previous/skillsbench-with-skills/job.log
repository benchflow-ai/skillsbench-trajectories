Sending keys: ['cat << \'EOF\' > process_floods.py\nimport pandas as pd\nfrom dataretrieval import nwis\nimport requests\nimport io\nimport os\n\n# 1. Read Station IDs\nprint("Reading station IDs...")\nwith open(\'/root/data/michigan_stations.txt\', \'r\') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\nprint(f"Found {len(station_ids)} stations.")\n\n# 2. Fetch Flood Thresholds\nprint("Fetching NWS flood thresholds...")\nurl = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"\ntry:\n    response = requests.get(url, timeout=30)\n    response.raise_for_status()\n    # Handle potential bad lines by skipping them or using a more robust parser\n    # The skill guide warns about column mismatches. \n    # Let\'s try reading it with pandas directly, skipping bad lines.\n    nws_df = pd.read_csv(io.StringIO(response.text), on_bad_lines=\'skip\')\nexcept Exception as e:\n    print(f"Error fetching thresholds: {e}")\n    exit(1)\n\n# 3. Create Threshold Dictionary\nprint("Processing thresholds...")\nthresholds = {}\n# Ensure columns exist and are clean\nnws_df.columns = [c.lower().strip() for c in nws_df.columns]\n\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row.get(\'usgs id\', \'\')).strip()\n    flood_stage = row.get(\'flood stage\')\n    \n    if usgs_id and pd.notna(flood_stage) and flood_stage != -9999:\n        try:\n            thresholds[usgs_id] = float(flood_stage)\n        except ValueError:\n            continue\n\nprint(f"Loaded thresholds for {len(thresholds)} stations.")\n\n# 4. Process Stations\nprint("Processing station data...")\nflood_results = []\n\nstart_date = \'2025-04-01\'\nend_date = \'2025-04-07\'\n\nfor i, station_id in enumerate(station_ids):\n    if i % 10 == 0:\n        print(f"Processing {i}/{len(station_ids)}: {station_id}")\n        \n    if station_id not in thresholds:\n        # print(f"Skipping {station_id}: No threshold data")\n        continue\n        \n    threshold = thresholds[station_id]\n    \n    try:\n        # Fetch IV data (00065 = Gage height)\n        df, _ = nwis.get_iv(\n            sites=station_id,\n            start=start_date,\n            end=end_date,\n            parameterCd=\'00065\'\n        )\n        \n        if df.empty:\n            continue\n            \n        # Identify the gage height column\n        # It usually looks like \'00065\' or \'00065_00000\'\n        # We want to exclude quality code columns ending in _cd\n        gage_cols = [c for c in df.columns if \'00065\' in str(c) and \'_cd\' not in str(c)]\n        \n        if not gage_cols:\n            continue\n            \n        gage_col = gage_cols[0]\n        \n        # Aggregate to daily max\n        daily_max = df[gage_col].resample(\'D\').max()\n        \n        # Count flood days\n        days_above = int((daily_max >= threshold).sum())\n        \n        if days_above > 0:\n            flood_results.append({\n                \'station_id\': station_id,\n                \'flood_days\': days_above\n            })\n            \n    except Exception as e:\n        print(f"Error processing {station_id}: {e}")\n\n# 5. Output Results\nprint("Writing results...")\noutput_df = pd.DataFrame(flood_results)\nif not output_df.empty:\n    output_df = output_df[[\'station_id\', \'flood_days\']]\n    output_df.to_csv(\'/root/output/flood_results.csv\', index=False)\n    print(f"Results written to /root/output/flood_results.csv with {len(output_df)} entries.")\nelse:\n    print("No flooding detected.")\n    # Create empty file with headers\n    with open(\'/root/output/flood_results.csv\', \'w\') as f:\n        f.write(\'station_id,flood_days\\n\')\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
