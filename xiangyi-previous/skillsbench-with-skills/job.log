Sending keys: ['cat > recover_budget.py << \'EOF\'\nimport pandas as pd\nimport openpyxl\nfrom openpyxl import load_workbook\nimport numpy as np\n\n# Load workbook\nwb = load_workbook(\'nasa_budget_incomplete.xlsx\')\n\n# Sheet 1: Budget by Directorate\nws1 = wb[\'Budget by Directorate\']\n\n# Read data to find missing values and calculate them\ndf1 = pd.read_excel(\'nasa_budget_incomplete.xlsx\', sheet_name=\'Budget by Directorate\', header=1)\n\nprint("Analyzing Budget by Directorate...")\nprint(df1)\n\n# Calculate missing values in Budget sheet\n# Row 3 (2016) - Total is missing\nrow_2016 = [5589, 640, 687, 4030, 5029, 115, 2769, 389, 37]\ntotal_2016 = sum(row_2016)\nprint(f"\\n2016 Total: {total_2016}")\nws1[\'K4\'] = total_2016  # Row 4 in Excel (index 3 in df + header)\n\n# Row 6 (2019) - Space Operations is missing\n# Total for 2019 is 21688\nrow_2019_known = [6906, 725, 927, 5047, 110, 2755, 538, 41]\ntotal_2019 = 21688\nspace_ops_2019 = total_2019 - sum(row_2019_known)\nprint(f"2019 Space Operations: {space_ops_2019}")\nws1[\'F8\'] = space_ops_2019\n\n# Row 7 (2020) - Science is missing\nrow_2020_known = [819, 1100, 6017, 3989, 120, 2913, 373, 43]\ntotal_2020 = 22513\nscience_2020 = total_2020 - sum(row_2020_known)\nprint(f"2020 Science: {science_2020}")\nws1[\'C9\'] = science_2020\n\n# Row 8 (2021) - Exploration and Total are missing\n# First get Total from YoY change: 2020 total * (1 + 3.43/100)\ntotal_2021 = round(total_2020 * (1 + 3.43/100))\nprint(f"2021 Total: {total_2021}")\nws1[\'K10\'] = total_2021\n\n# Now calculate Exploration\nrow_2021_known = [7301, 829, 1100, 3986, 127, 2953, 390, 44]\nexploration_2021 = total_2021 - sum(row_2021_known)\nprint(f"2021 Exploration: {exploration_2021}")\nws1[\'F10\'] = exploration_2021\n\n# Row 10 (2023) - Aeronautics is missing\nrow_2023_known = [8262, 1192, 7618, 4256, 143, 3106, 424, 47]\ntotal_2023 = 25984\naero_2023 = total_2023 - sum(row_2023_known)\nprint(f"2023 Aeronautics: {aero_2023}")\nws1[\'D12\'] = aero_2023\n\nprint("\\n" + "="*80)\n\n# Sheet 2: YoY Changes (%)\nws2 = wb[\'YoY Changes (%)\']\ndf2 = pd.read_excel(\'nasa_budget_incomplete.xlsx\', sheet_name=\'YoY Changes (%)\', header=1)\n\nprint("\\nAnalyzing YoY Changes...")\n\n# 2019 Space Technology YoY change\n# From budget: 2019=927, 2018=760\nyoy_space_tech_2019 = round(((927 - 760) / 760) * 100, 2)\nprint(f"2019 Space Technology YoY: {yoy_space_tech_2019}%")\nws2[\'D7\'] = yoy_space_tech_2019\n\n# 2021 Science YoY change\n# From budget: 2021=7301, 2020=science_2020\nyoy_science_2021 = round(((7301 - science_2020) / science_2020) * 100, 2)\nprint(f"2021 Science YoY: {yoy_science_2021}%")\nws2[\'C9\'] = yoy_science_2021\n\n# 2021 Space Operations YoY change\n# From budget: 2021=3986, 2020=3989\nyoy_space_ops_2021 = round(((3986 - 3989) / 3989) * 100, 2)\nprint(f"2021 Space Operations YoY: {yoy_space_ops_2021}%")\nws2[\'F9\'] = yoy_space_ops_2021\n\nprint("\\n" + "="*80)\n\n# Sheet 3: Directorate Shares (%)\nws3 = wb[\'Directorate Shares (%)\']\ndf3 = pd.read_excel(\'nasa_budget_incomplete.xlsx\', sheet_name=\'Directorate Shares (%)\', header=1)\n\nprint("\\nAnalyzing Directorate Shares...")\n\n# 2016 Space Operations share\n# Budget: 5029, Total: total_2016\nshare_space_ops_2016 = round((5029 / total_2016) * 100, 2)\nprint(f"2016 Space Operations Share: {share_space_ops_2016}%")\nws3[\'F5\'] = share_space_ops_2016\n\n# 2021 Science share\n# Budget: 7301, Total: total_2021\nshare_science_2021 = round((7301 / total_2021) * 100, 2)\nprint(f"2021 Science Share: {share_science_2021}%")\nws3[\'C10\'] = share_science_2021\n\nprint("\\n" + "="*80)\n\n# Sheet 4: Growth Analysis\nws4 = wb[\'Growth Analysis\']\ndf4 = pd.read_excel(\'nasa_budget_incomplete.xlsx\', sheet_name=\'Growth Analysis\', header=1)\n\nprint("\\nAnalyzing Growth Analysis...")\n\n# FY2019 Exploration (from budget sheet)\nexploration_2019 = 5047\nprint(f"FY2019 Exploration: {exploration_2019}")\nws4[\'E5\'] = exploration_2019\n\n# 5-Year CAGR for Exploration\n# CAGR = ((FY2024/FY2019)^(1/5) - 1) * 100\nexploration_2024 = 7618\ncagr_exploration = round(((exploration_2024 / exploration_2019) ** (1/5) - 1) * 100, 2)\nprint(f"Exploration 5-Year CAGR: {cagr_exploration}%")\nws4[\'E4\'] = cagr_exploration\n\n# 5-Year Change for Science\nscience_2019 = 6906\nscience_2024 = 8440\nchange_science = science_2024 - science_2019\nprint(f"Science 5-Year Change: {change_science}")\nws4[\'C7\'] = change_science\n\n# Average Annual Budget for Science\navg_science = round((science_2019 + science_2020 + 7301 + 7614 + 8262 + science_2024) / 6, 1)\nprint(f"Science Avg Annual Budget: {avg_science}")\nws4[\'C8\'] = avg_science\n\nprint("\\n" + "="*80)\nprint("\\nSaving recovered budget to nasa_budget_recovered.xlsx...")\n\n# Save the workbook\nwb.save(\'nasa_budget_recovered.xlsx\')\n\nprint("Done! File saved successfully.")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
