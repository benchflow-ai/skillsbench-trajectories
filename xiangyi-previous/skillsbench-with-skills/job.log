Sending keys: ['cat > /root/process_taxonomy.py << \'EOF\'\nimport pandas as pd\nimport csv\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple\n\ndef normalize_category(cat: str) -> str:\n    """Normalize category text."""\n    cat = cat.strip().lower()\n    cat = re.sub(r\'[&]\', \'and\', cat)\n    cat = re.sub(r\'\\s+\', \' \', cat)\n    return cat\n\ndef load_categories():\n    """Load categories from all three sources."""\n    categories = {\n        \'amazon\': [],\n        \'facebook\': [],\n        \'google\': []\n    }\n    \n    # Load Amazon\n    df_amazon = pd.read_csv(\'/root/data/amazon_product_categories.csv\')\n    categories[\'amazon\'] = df_amazon[\'category_path\'].tolist()\n    \n    # Load Facebook\n    df_fb = pd.read_csv(\'/root/data/fb_product_categories.csv\')\n    categories[\'facebook\'] = df_fb[\'category_path\'].tolist()\n    \n    # Load Google\n    df_google = pd.read_csv(\'/root/data/google_shopping_product_categories.csv\')\n    categories[\'google\'] = df_google[\'category_path\'].tolist()\n    \n    return categories\n\ndef parse_hierarchy(categories_dict: Dict[str, List[str]]) -> Dict[str, List[Tuple]]:\n    """Parse category hierarchies."""\n    parsed = {}\n    \n    for source, cat_list in categories_dict.items():\n        parsed[source] = []\n        for cat_path in cat_list:\n            parts = [p.strip() for p in cat_path.split(\'>\')]\n            parsed[source].append({\n                \'path\': cat_path,\n                \'parts\': parts,\n                \'depth\': len(parts),\n                \'normalized_parts\': [normalize_category(p) for p in parts]\n            })\n    \n    return parsed\n\ndef extract_level_categories(parsed_dict: Dict) -> Dict[int, Dict[str, List[str]]]:\n    """Extract categories at each level from all sources."""\n    level_cats = defaultdict(lambda: defaultdict(list))\n    \n    for source, items in parsed_dict.items():\n        for item in items:\n            parts = item[\'parts\']\n            norm_parts = item[\'normalized_parts\']\n            for level in range(1, len(parts) + 1):\n                cat = parts[level - 1]\n                norm_cat = norm_parts[level - 1]\n                level_cats[level][source].append((cat, norm_cat))\n    \n    return level_cats\n\ndef get_top_categories(level_cats: Dict, level: int, top_n: int = 100) -> List[Tuple[str, int]]:\n    """Get most common categories at a given level."""\n    all_cats = []\n    for source_list in level_cats[level].values():\n        all_cats.extend(source_list)\n    \n    counter = Counter([norm for _, norm in all_cats])\n    return counter.most_common(top_n)\n\ndef build_unified_taxonomy(parsed_dict: Dict) -> Tuple[List[Dict], Dict]:\n    """Build unified 5-level taxonomy."""\n    level_cats = extract_level_categories(parsed_dict)\n    \n    # Get top categories at each level\n    unified = {}\n    for level in range(1, 6):\n        if level == 1:\n            top_n = 15  # Target 10-20 for level 1\n        elif level == 2:\n            top_n = 60  # ~4 per parent\n        elif level == 3:\n            top_n = 150  # ~2.5 per parent\n        elif level == 4:\n            top_n = 300  # ~2 per parent\n        else:\n            top_n = 500  # ~1.7 per parent\n        \n        top_cats = get_top_categories(level_cats, level, top_n)\n        unified[level] = [cat for cat, _ in top_cats]\n    \n    return unified\n\ndef map_to_unified(parsed_dict: Dict, unified: Dict) -> List[Dict]:\n    """Map original categories to unified taxonomy."""\n    results = []\n    \n    for source, items in parsed_dict.items():\n        for item in items:\n            parts = item[\'parts\']\n            norm_parts = item[\'normalized_parts\']\n            \n            # Map each level\n            unified_parts = {}\n            for level in range(1, 6):\n                if level <= len(parts):\n                    norm_cat = norm_parts[level - 1]\n                    # Find closest match in unified\n                    if norm_cat in unified[level]:\n                        unified_parts[level] = parts[level - 1]\n                    else:\n                        # Find best match\n                        best_match = None\n                        for unified_cat in unified[level]:\n                            if norm_cat.startswith(unified_cat[:3]):\n                                best_match = unified_cat\n                                break\n                        unified_parts[level] = best_match if best_match else unified[level][0]\n                else:\n                    unified_parts[level] = None\n            \n            results.append({\n                \'source\': source,\n                \'category_path\': item[\'path\'],\n                \'depth\': item[\'depth\'],\n                \'unified_level_1\': unified_parts.get(1),\n                \'unified_level_2\': unified_parts.get(2),\n                \'unified_level_3\': unified_parts.get(3),\n                \'unified_level_4\': unified_parts.get(4),\n                \'unified_level_5\': unified_parts.get(5)\n            })\n    \n    return results\n\nif __name__ == \'__main__\':\n    print("Loading categories...")\n    categories = load_categories()\n    print(f"Loaded {sum(len(v) for v in categories.values())} categories")\n    \n    print("Parsing hierarchies...")\n    parsed = parse_hierarchy(categories)\n    \n    print("Building unified taxonomy...")\n    unified = build_unified_taxonomy(parsed)\n    \n    print("Mapping to unified taxonomy...")\n    results = map_to_unified(parsed, unified)\n    \n    # Output full mapping\n    df_full = pd.DataFrame(results)\n    df_full.to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\n    print(f"Saved {len(df_full)} mappings to unified_taxonomy_full.csv")\n    \n    # Output hierarchy\n    hierarchy_rows = []\n    seen = set()\n    for _, row in df_full.iterrows():\n        levels = (row[\'unified_level_1\'], row[\'unified_level_2\'], row[\'unified_level_3\'], \n                 row[\'unified_level_4\'], row[\'unified_level_5\'])\n        if levels not in seen:\n            seen.add(levels)\n            hierarchy_rows.append({\n                \'unified_level_1\': levels[0],\n                \'unified_level_2\': levels[1],\n                \'unified_level_3\': levels[2],\n                \'unified_level_4\': levels[3],\n                \'unified_level_5\': levels[4]\n            })\n    \n    df_hierarchy = pd.DataFrame(hierarchy_rows)\n    df_hierarchy.to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\n    print(f"Saved {len(df_hierarchy)} hierarchy paths to unified_taxonomy_hierarchy.csv")\n    \n    print("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
