Sending keys: ['cat > control.py << \'EOF\'\n#!/usr/bin/env python3\n"""Closed-loop control: Run PID controller to reach setpoint."""\n\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\ndef calculate_metrics(data, setpoint):\n    """Calculate performance metrics from control data."""\n    times = np.array([d[\'time\'] for d in data])\n    temps = np.array([d[\'temperature\'] for d in data])\n    \n    # Find initial temperature (average of first few points)\n    T_initial = np.mean(temps[:5])\n    \n    # Max temperature\n    max_temp = np.max(temps)\n    \n    # Rise time: time to reach 90% of setpoint change\n    target_90 = T_initial + 0.9 * (setpoint - T_initial)\n    rise_idx = np.where(temps >= target_90)[0]\n    rise_time = times[rise_idx[0]] if len(rise_idx) > 0 else times[-1]\n    \n    # Overshoot: (max_temp - setpoint) / (setpoint - T_initial)\n    overshoot = max(0, (max_temp - setpoint) / (setpoint - T_initial))\n    \n    # Settling time: time to stay within 2% of setpoint\n    settling_band = 0.02 * abs(setpoint - T_initial)\n    settled = False\n    settling_time = times[-1]\n    \n    for i in range(len(temps) - 20):  # Check if it stays settled for 20 points (~10s)\n        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\n            settling_time = times[i]\n            settled = True\n            break\n    \n    # Steady-state error: average error in last 20% of data\n    steady_start = int(0.8 * len(temps))\n    steady_state_error = abs(np.mean(temps[steady_start:]) - setpoint)\n    \n    return {\n        "rise_time": round(rise_time, 2),\n        "overshoot": round(overshoot, 4),\n        "settling_time": round(settling_time, 2),\n        "steady_state_error": round(steady_state_error, 4),\n        "max_temp": round(max_temp, 4)\n    }\n\ndef run_control():\n    # Load tuned gains\n    with open(\'tuned_gains.json\', \'r\') as f:\n        gains = json.load(f)\n    \n    Kp = gains[\'Kp\']\n    Ki = gains[\'Ki\']\n    Kd = gains[\'Kd\']\n    \n    print(f"Running closed-loop control with PID gains:")\n    print(f"  Kp = {Kp:.4f}")\n    print(f"  Ki = {Ki:.4f}")\n    print(f"  Kd = {Kd:.4f}")\n    \n    # Initialize simulator\n    sim = HVACSimulator()\n    setpoint = sim.get_setpoint()\n    dt = sim.get_dt()\n    \n    print(f"\\nSetpoint: {setpoint}C")\n    print(f"Control duration: 150s minimum")\n    \n    # Reset and get initial temperature\n    initial_temp = sim.reset()\n    print(f"Initial temperature: {initial_temp:.2f}C")\n    \n    # PID controller state\n    integral = 0.0\n    prev_error = setpoint - initial_temp\n    \n    # Data collection\n    data = []\n    \n    # Run control loop for at least 150 seconds\n    duration = 150.0\n    steps = int(duration / dt)\n    \n    print(f"\\nStarting control loop...")\n    \n    for step in range(steps):\n        # Get current state from last step or initial\n        if step == 0:\n            current_temp = initial_temp\n            time = 0.0\n        else:\n            time = data[-1][\'time\'] + dt\n        \n        # Calculate error\n        error = setpoint - current_temp\n        \n        # PID control\n        # Proportional term\n        P = Kp * error\n        \n        # Integral term with anti-windup\n        integral += error * dt\n        # Anti-windup: clamp integral to prevent excessive buildup\n        max_integral = 100.0 / Ki if Ki > 0 else 1000.0\n        integral = np.clip(integral, -max_integral, max_integral)\n        I = Ki * integral\n        \n        # Derivative term\n        derivative = (error - prev_error) / dt\n        D = Kd * derivative\n        \n        # Calculate control output\n        heater_power = P + I + D\n        \n        # Clamp to valid range [0, 100]\n        heater_power = np.clip(heater_power, 0.0, 100.0)\n        \n        # Apply control and step simulation\n        result = sim.step(heater_power)\n        current_temp = result[\'temperature\']\n        \n        # Log data\n        data.append({\n            "time": round(result[\'time\'], 2),\n            "temperature": round(current_temp, 4),\n            "setpoint": setpoint,\n            "heater_power": round(heater_power, 2),\n            "error": round(error, 4)\n        })\n        \n        # Update for next iteration\n        prev_error = error\n        \n        # Print progress every 30 seconds\n        if step % 60 == 0 or step == steps - 1:\n            print(f"  t={result[\'time\']:.1f}s: T={current_temp:.2f}C, P={heater_power:.1f}%, error={error:.2f}C")\n    \n    print(f"\\nControl complete. Collected {len(data)} data points.")\n    \n    # Save control log\n    control_log = {\n        "phase": "control",\n        "setpoint": setpoint,\n        "data": data\n    }\n    \n    with open(\'control_log.json\', \'w\') as f:\n        json.dump(control_log, f, indent=2)\n    \n    print("Saved control_log.json")\n    \n    # Calculate and save metrics\n    metrics = calculate_metrics(data, setpoint)\n    \n    print(f"\\nPerformance Metrics:")\n    print(f"  Rise time: {metrics[\'rise_time\']:.2f}s")\n    print(f"  Overshoot: {metrics[\'overshoot\']*100:.2f}%")\n    print(f"  Settling time: {metrics[\'settling_time\']:.2f}s")\n    print(f"  Steady-state error: {metrics[\'steady_state_error\']:.4f}C")\n    print(f"  Max temperature: {metrics[\'max_temp\']:.2f}C")\n    \n    with open(\'metrics.json\', \'w\') as f:\n        json.dump(metrics, f, indent=2)\n    \n    print("\\nSaved metrics.json")\n    \n    # Check if requirements are met\n    print("\\n=== Requirements Check ===")\n    print(f"Steady-state error < 0.5C: {metrics[\'steady_state_error\']:.4f}C - {\'PASS\' if metrics[\'steady_state_error\'] < 0.5 else \'FAIL\'}")\n    print(f"Settling time < 120s: {metrics[\'settling_time\']:.2f}s - {\'PASS\' if metrics[\'settling_time\'] < 120 else \'FAIL\'}")\n    print(f"Overshoot < 10%: {metrics[\'overshoot\']*100:.2f}% - {\'PASS\' if metrics[\'overshoot\'] < 0.10 else \'FAIL\'}")\n    print(f"Max temperature < 30C: {metrics[\'max_temp\']:.2f}C - {\'PASS\' if metrics[\'max_temp\'] < 30 else \'FAIL\'}")\n    print(f"Control duration >= 150s: {data[-1][\'time\']:.1f}s - PASS")\n\nif __name__ == "__main__":\n    run_control()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
