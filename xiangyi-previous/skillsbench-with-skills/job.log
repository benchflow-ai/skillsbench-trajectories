Sending keys: ['cat << \'EOF\' > analyze.py\nimport csv\nimport math\nimport collections\nimport statistics\nfrom scapy.all import *\n\ntry:\n    packets = rdpcap("packets.pcap")\nexcept Exception as e:\n    print(f"Error reading pcap: {e}")\n    exit(1)\n\n# --- Init Variables ---\nproto_counts = collections.Counter()\nip_total = 0\ntimestamps = []\nlengths = []\n\nsrc_ips = []\ndst_ips = []\nsrc_ports = []\ndst_ports = []\n\nnodes = set()\nedges = set()\nout_degree = collections.defaultdict(set)\nin_degree = collections.defaultdict(set)\n\nbytes_sent = collections.defaultdict(int)\nbytes_recv = collections.defaultdict(int)\n\nflows = set() # (src, dst, sport, dport, proto)\nport_scan_candidates = collections.defaultdict(set) # src -> set(dport)\n\n# --- Process Packets ---\nfor pkt in packets:\n    timestamps.append(float(pkt.time))\n    lengths.append(len(pkt))\n    \n    if pkt.haslayer(TCP): proto_counts[\'tcp\'] += 1\n    if pkt.haslayer(UDP): proto_counts[\'udp\'] += 1\n    if pkt.haslayer(ICMP): proto_counts[\'icmp\'] += 1\n    if pkt.haslayer(ARP): proto_counts[\'arp\'] += 1\n    \n    if pkt.haslayer(IP):\n        ip_total += 1\n        ip_layer = pkt[IP]\n        sip, dip = ip_layer.src, ip_layer.dst\n        \n        src_ips.append(sip)\n        dst_ips.append(dip)\n        nodes.add(sip); nodes.add(dip)\n        edges.add((sip, dip))\n        out_degree[sip].add(dip)\n        in_degree[dip].add(sip)\n        \n        bytes_sent[sip] += len(pkt)\n        bytes_recv[dip] += len(pkt)\n        \n        sport = 0\n        dport = 0\n        proto_num = ip_layer.proto\n        \n        if pkt.haslayer(TCP):\n            sport = pkt[TCP].sport\n            dport = pkt[TCP].dport\n            src_ports.append(sport)\n            dst_ports.append(dport)\n            flows.add((sip, dip, sport, dport, 6))\n            port_scan_candidates[sip].add(dport)\n        elif pkt.haslayer(UDP):\n            sport = pkt[UDP].sport\n            dport = pkt[UDP].dport\n            src_ports.append(sport)\n            dst_ports.append(dport)\n            flows.add((sip, dip, sport, dport, 17))\n            port_scan_candidates[sip].add(dport)\n\n# --- Calculations ---\n# Time\nduration = timestamps[-1] - timestamps[0] if timestamps else 0\nbuckets = collections.defaultdict(int)\nstart_time = timestamps[0] if timestamps else 0\nfor ts in timestamps:\n    b_idx = int((ts - start_time) // 60)\n    buckets[b_idx] += 1\nppm_vals = list(buckets.values()) if buckets else [0]\nppm_avg = statistics.mean(ppm_vals) if ppm_vals else 0\nppm_max = max(ppm_vals) if ppm_vals else 0\nppm_min = min(ppm_vals) if ppm_vals else 0\n\n# Size\ntotal_bytes = sum(lengths)\navg_size = statistics.mean(lengths) if lengths else 0\nmin_size = min(lengths) if lengths else 0\nmax_size = max(lengths) if lengths else 0\n\n# Entropy\ndef calc_entropy(data):\n    if not data: return 0\n    counts = collections.Counter(data)\n    total = len(data)\n    return -sum((c/total) * math.log2(c/total) for c in counts.values())\n\nsrc_ip_ent = calc_entropy(src_ips)\ndst_ip_ent = calc_entropy(dst_ips)\nsrc_port_ent = calc_entropy(src_ports)\ndst_port_ent = calc_entropy(dst_ports)\nuniq_src_ports = len(set(src_ports))\nuniq_dst_ports = len(set(dst_ports))\n\n# Graph\nnum_nodes = len(nodes)\nnum_edges = len(edges)\ndensity = num_edges / (num_nodes * (num_nodes - 1)) if num_nodes > 1 else 0\nmax_out = max((len(d) for d in out_degree.values()), default=0)\nmax_in = max((len(s) for s in in_degree.values()), default=0)\n\n# IAT\niats = [timestamps[i] - timestamps[i-1] for i in range(1, len(timestamps))]\niat_mean = statistics.mean(iats) if iats else 0\niat_var = statistics.variance(iats) if len(iats) > 1 else 0\niat_std = math.sqrt(iat_var)\niat_cv = iat_std / iat_mean if iat_mean > 0 else 0\n\n# PCR\nproducers = 0\nconsumers = 0\nall_ips = set(bytes_sent.keys()) | set(bytes_recv.keys())\nfor ip in all_ips:\n    s = bytes_sent[ip]; r = bytes_recv[ip]\n    if s + r > 0:\n        pcr = (s - r) / (s + r)\n        if pcr > 0.2: producers += 1\n        if pcr < -0.2: consumers += 1\n\n# Flows\nuniq_flows = len(flows)\ntcp_flows = len([f for f in flows if f[4] == 6])\nudp_flows = len([f for f in flows if f[4] == 17])\nbidirect = 0\nfor f in flows:\n    # f = (src, dst, sport, dport, proto)\n    rev = (f[1], f[0], f[3], f[2], f[4])\n    if rev in flows:\n        bidirect += 1\n\n# Analysis Flags\n# Heuristics:\n# Port Scan: Single IP scanning > 50 ports\nmax_scanned_ports = max((len(ports) for ports in port_scan_candidates.values()), default=0)\nhas_port_scan = max_scanned_ports > 50\n\n# DoS: High PPM max (e.g., > 3000)\nhas_dos = ppm_max > 3000\n\n# Beaconing: Very low IAT CV (e.g., < 0.05) and sufficient packets\nhas_beaconing = iat_cv < 0.1 and len(packets) > 50\n\nis_benign = not (has_port_scan or has_dos or has_beaconing)\n\n# Results Dict\nres = {\n    \'protocol_tcp\': proto_counts[\'tcp\'],\n    \'protocol_udp\': proto_counts[\'udp\'],\n    \'protocol_icmp\': proto_counts[\'icmp\'],\n    \'protocol_arp\': proto_counts[\'arp\'],\n    \'protocol_ip_total\': ip_total,\n    \'duration_seconds\': duration,\n    \'packets_per_minute_avg\': ppm_avg,\n    \'packets_per_minute_max\': ppm_max,\n    \'packets_per_minute_min\': ppm_min,\n    \'total_bytes\': total_bytes,\n    \'avg_packet_size\': avg_size,\n    \'min_packet_size\': min_size,\n    \'max_packet_size\': max_size,\n    \'dst_port_entropy\': dst_port_ent,\n    \'src_port_entropy\': src_port_ent,\n    \'src_ip_entropy\': src_ip_ent,\n    \'dst_ip_entropy\': dst_ip_ent,\n    \'unique_dst_ports\': uniq_dst_ports,\n    \'unique_src_ports\': uniq_src_ports,\n    \'num_nodes\': num_nodes,\n    \'num_edges\': num_edges,\n    \'network_density\': density,\n    \'max_indegree\': max_in,\n    \'max_outdegree\': max_out,\n    \'iat_mean\': iat_mean,\n    \'iat_variance\': iat_var,\n    \'iat_cv\': iat_cv,\n    \'num_producers\': producers,\n    \'num_consumers\': consumers,\n    \'unique_flows\': uniq_flows,\n    \'bidirectional_flows\': bidirect,\n    \'tcp_flows\': tcp_flows,\n    \'udp_flows\': udp_flows,\n    \'is_traffic_benign\': str(is_benign).lower(),\n    \'has_port_scan\': str(has_port_scan).lower(),\n    \'has_dos_pattern\': str(has_dos).lower(),\n    \'has_beaconing\': str(has_beaconing).lower(),\n}\n\n# Write CSV\nlines = []\nwith open(\'/root/network_stats.csv\', \'r\') as f:\n    lines = f.readlines()\n\nwith open(\'/root/network_stats.csv\', \'w\') as f:\n    for line in lines:\n        line = line.strip()\n        if not line or line.startswith(\'#\') or line == \'metric,value\':\n            f.write(line + \'\\n\')\n            continue\n        key = line.split(\',\')[0]\n        if key in res:\n            f.write(f"{key},{res[key]}\\n")\n        else:\n            f.write(line + \'\\n\')\n\nprint("Analysis complete.")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
