Sending keys: ['cat > get_merge_times_graphql.py << \'EOF\'\nimport json\nimport urllib.request\nimport time\n\n# GraphQL query to fetch multiple PRs with merge data\nquery_template = \'\'\'\n{\n  repository(owner: "cli", name: "cli") {\n    pullRequests(first: 34, states: MERGED, orderBy: {field: CREATED_AT, direction: DESC}) {\n      nodes {\n        number\n        createdAt\n        mergedAt\n      }\n    }\n  }\n}\n\'\'\'\n\n# List of PR numbers we need\npr_numbers = [10154, 10151, 10145, 10143, 10139, 10135, 10124, 10121, 10116, 10112,\n              10110, 10104, 10102, 10094, 10078, 10074, 10070, 10056, 10055, 10051,\n              10048, 10044, 10043, 10026, 10025, 10020, 10019, 10016, 10012, 10009,\n              10006, 9999, 9992, 9985]\n\n# Build GraphQL query for specific PRs\nqueries = []\nfor pr_num in pr_numbers[:10]:  # Try first 10\n    queries.append(f\'pr{pr_num}: pullRequest(number: {pr_num}) {{ number createdAt mergedAt }}\')\n\ngraphql_query = \'\'\'\n{\n  repository(owner: "cli", name: "cli") {\n    \'\'\' + \'\\n    \'.join(queries) + \'\'\'\n  }\n}\n\'\'\'\n\nprint("Trying GraphQL API...")\ntry:\n    req = urllib.request.Request(\n        \'https://api.github.com/graphql\',\n        data=json.dumps({\'query\': graphql_query}).encode(),\n        headers={\'Content-Type\': \'application/json\'}\n    )\n    with urllib.request.urlopen(req) as response:\n        result = json.loads(response.read().decode())\n        print(json.dumps(result, indent=2))\nexcept Exception as e:\n    print(f"GraphQL failed: {e}")\n    print("\\nGraphQL requires authentication. Falling back to alternative method...")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
