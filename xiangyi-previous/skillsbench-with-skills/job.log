arker + parts2[1]\n        new_content = prefix + new_block + \'\\n\\n\\n\' + suffix\n        with open(\'/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl\', \'w\') as f:\n            f.write(new_content)\n    else:\n        print("Could not find next handler marker")\nelse:\n    print("Could not find start marker")\nEOF\npython3 /tmp/fix_ssh_v3.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
