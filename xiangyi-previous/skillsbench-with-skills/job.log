p_flows,\n    \'udp_flows\': udp_flows,\n    \'is_traffic_benign\': is_traffic_benign,\n    \'has_port_scan\': has_port_scan,\n    \'has_dos_pattern\': has_dos_pattern,\n    \'has_beaconing\': has_beaconing,\n}\n\n# Read original CSV and update\nlines = []\nwith open(\'network_stats.csv\', \'r\') as f:\n    for line in f:\n        line = line.rstrip(\'\\n\')\n        if line.startswith(\'#\') or line == \'metric,value\':\n            lines.append(line)\n        else:\n            parts = line.split(\',\')\n            if len(parts) == 2:\n                metric = parts[0]\n                if metric in results:\n                    value = results[metric]\n                    lines.append(f"{metric},{value}")\n                else:\n                    lines.append(line)\n            else:\n                lines.append(line)\n\n# Write back\nwith open(\'network_stats.csv\', \'w\') as f:\n    for line in lines:\n        f.write(line + \'\\n\')\n\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
