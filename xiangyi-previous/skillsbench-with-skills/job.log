Sending keys: ['cat > /tmp/solution3.py << \'EOFPYTHON\'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes_log = pd.read_csv(\'/app/data/mes_log.csv\')\nthermocouples = pd.read_csv(\'/app/data/thermocouples.csv\')\ntest_defects = pd.read_csv(\'/app/data/test_defects.csv\')\n\n# Constants from handbook\n# Peak should exceed liquidus by approximately 20°C\nPEAK_TEMP_MARGIN_C = 20\nTC_LOCATION = \'largest_mass\'\n\n# Filter thermocouples for largest_mass only\ntc_data = thermocouples[thermocouples[\'tc_location\'] == TC_LOCATION].copy()\n\n# ============================================================================\n# QUESTION 3: Peak Temperature Requirements\n# ============================================================================\nprint("\\n=== Question 3: Peak Temperature ===")\n\nmin_peak_by_run = {}\nfailing_runs = []\n\nfor run_id in sorted(mes_log[\'run_id\'].unique()):\n    # Get liquidus temperature for this run\n    run_info = mes_log[mes_log[\'run_id\'] == run_id].iloc[0]\n    liquidus_c = float(run_info[\'solder_liquidus_c\'])\n    required_min_peak_c = liquidus_c + PEAK_TEMP_MARGIN_C\n    \n    run_tc = tc_data[tc_data[\'run_id\'] == run_id].copy()\n    \n    if len(run_tc) == 0:\n        # No thermocouple data means failing\n        failing_runs.append(run_id)\n        min_peak_by_run[run_id] = {\n            "tc_id": None,\n            "peak_temp_c": None,\n            "required_min_peak_c": round(required_min_peak_c, 2)\n        }\n        continue\n    \n    run_tc = run_tc.sort_values(\'time_s\')\n    tc_id = str(run_tc[\'tc_id\'].iloc[0])\n    \n    # Find peak temperature\n    peak_temp_c = float(run_tc[\'temp_c\'].max())\n    peak_temp_c = round(peak_temp_c, 2)\n    \n    min_peak_by_run[run_id] = {\n        "tc_id": tc_id,\n        "peak_temp_c": peak_temp_c,\n        "required_min_peak_c": round(required_min_peak_c, 2)\n    }\n    \n    # Check if failing\n    if peak_temp_c < required_min_peak_c:\n        failing_runs.append(run_id)\n\nq03_output = {\n    "failing_runs": sorted(failing_runs),\n    "min_peak_by_run": min_peak_by_run\n}\n\nwith open(\'/app/output/q03.json\', \'w\') as f:\n    json.dump(q03_output, f, indent=2)\n\nprint(f"Processed peak temps for {len(min_peak_by_run)} runs")\nprint(f"Failing runs: {len(failing_runs)}")\n\nEOFPYTHON\npython3 /tmp/solution3.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
