Sending keys: ['cat <<EOF > solve_gdp.py\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nfile_path = \'gdp.xlsx\'\nwb = openpyxl.load_workbook(file_path)\ntask = wb[\'Task\']\n\n# Helper to set formula for a range\ndef set_formula(sheet, row_start, row_end, col_start_idx, col_end_idx, formula_template):\n    for r in range(row_start, row_end + 1):\n        for c in range(col_start_idx, col_end_idx + 1):\n            col_letter = get_column_letter(c)\n            # Replace placeholders in template\n            # {col} -> column letter (e.g., H)\n            # {row} -> row number (e.g., 12)\n            # {col_idx} -> column index\n            f = formula_template.format(col=col_letter, row=r)\n            sheet.cell(row=r, column=c).value = f\n\n# Step 1: Fill Data\n# Ranges: H12:L17, H19:L24, H26:L31\n# Formula: =INDEX(Data!$A$21:$Z$40, MATCH($D{row}, Data!$B$21:$B$40, 0), MATCH({col}$9, Data!$A$4:$Z$4, 0))\nlookup_formula = "=INDEX(Data!\\$A\\$21:\\$Z\\$40, MATCH(\\$D{row}, Data!\\$B\\$21:\\$B\\$40, 0), MATCH({col}\\$9, Data!\\$A\\$4:\\$Z\\$4, 0))"\n\ncols = range(8, 13) # H to L (8, 9, 10, 11, 12)\nfor r_start, r_end in [(12, 17), (19, 24), (26, 31)]:\n    set_formula(task, r_start, r_end, 8, 12, lookup_formula)\n\n# Step 2: Net Exports % GDP\n# Range: H35:L40\n# Formula: =(H{row_exp}-H{row_imp})/H{row_gdp}*100\n# Rows mapping:\n# 35 -> Exp 12, Imp 19, GDP 26\n# 36 -> Exp 13, Imp 20, GDP 27\n# ...\nfor i, r in enumerate(range(35, 41)):\n    row_exp = 12 + i\n    row_imp = 19 + i\n    row_gdp = 26 + i\n    for c in cols:\n        col_letter = get_column_letter(c)\n        f = f"=({col_letter}{row_exp}-{col_letter}{row_imp})/{col_letter}{row_gdp}*100"\n        task.cell(row=r, column=c).value = f\n\n# Step 2 Stats: Rows 42-47\nstats_map = {\n    42: "MIN",\n    43: "MAX",\n    44: "MEDIAN",\n    45: "AVERAGE",\n    46: "PERCENTILE.INC",\n    47: "PERCENTILE.INC"\n}\n\nfor r, func in stats_map.items():\n    for c in cols:\n        col_letter = get_column_letter(c)\n        rng = f"{col_letter}35:{col_letter}40"\n        if r == 46:\n            f = f"={func}({rng}, 0.25)"\n        elif r == 47:\n            f = f"={func}({rng}, 0.75)"\n        else:\n            f = f"={func}({rng})"\n        task.cell(row=r, column=c).value = f\n\n# Step 3: Weighted Mean\n# Row 50\n# Formula: =SUMPRODUCT(H35:H40, H26:H31)/SUM(H26:H31)\nfor c in cols:\n    col_letter = get_column_letter(c)\n    f = f"=SUMPRODUCT({col_letter}35:{col_letter}40, {col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"\n    task.cell(row=50, column=c).value = f\n\nwb.save(file_path)\nprint("Done")\nEOF\npython3 solve_gdp.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
