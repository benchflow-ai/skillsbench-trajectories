Sending keys: ['cat << \'EOF\' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\n# Step 1: Extract Gold Price\nimf_df = pd.read_excel(\'imf_data.xls\', sheet_name=\'External\', skiprows=0)\ngold_data = imf_df[[\'Commodity\', \'PGOLD\']].iloc[3:].dropna()\ngold_data.columns = [\'Date\', \'Price\']\ngold_data[\'Price\'] = pd.to_numeric(gold_data[\'Price\'])\n\n# Calculate log returns\ngold_data[\'Log Return\'] = np.log(gold_data[\'Price\'] / gold_data[\'Price\'].shift(1)) * 100\n\n# Calculate volatilities\ngold_data[\'3m Vol\'] = gold_data[\'Log Return\'].rolling(window=3).std()\ngold_data[\'12m Vol\'] = gold_data[\'Log Return\'].rolling(window=12).std()\n\n# Write to Gold price sheet\nwb = load_workbook(\'data/test-rar.xlsx\')\nws_gold = wb[\'Gold price\']\n\n# Clear existing data if any (except headers)\nfor row in ws_gold.iter_rows(min_row=2):\n    for cell in row:\n        cell.value = None\n\nfor i, row in enumerate(gold_data.values, start=2):\n    ws_gold.cell(row=i, column=1, value=row[0]) # Date\n    ws_gold.cell(row=i, column=2, value=row[1]) # Price\n    ws_gold.cell(row=i, column=3, value=row[2]) # Log Return\n    ws_gold.cell(row=i, column=4, value=row[3]) # 3m Vol\n    ws_gold.cell(row=i, column=5, value=row[4]) # 12m Vol\n\n# Step 1: Fill Answer sheet\nws_answer = wb[\'Answer\']\nlatest_data = gold_data.iloc[-1]\nlatest_3m_vol = latest_data[\'3m Vol\']\nlatest_12m_vol = latest_data[\'12m Vol\']\nannualized_3m_vol = latest_3m_vol * np.sqrt(12)\n\nws_answer[\'B3\'] = latest_3m_vol\nws_answer[\'B4\'] = latest_12m_vol\nws_answer[\'B5\'] = annualized_3m_vol\nws_answer[\'B6\'] = latest_data[\'Price\']\n\n# Step 2: Gold reserves\nws_value = wb[\'Value\']\nws_volume = wb[\'Volume\']\n\n# Read Value sheet\ndata_value = []\nfor row in ws_value.iter_rows(min_row=1, values_only=True):\n    data_value.append(row)\ndf_value = pd.DataFrame(data_value[1:], columns=data_value[0])\n\n# Read Volume sheet\ndata_volume = []\nfor row in ws_volume.iter_rows(min_row=1, values_only=True):\n    data_volume.append(row)\ndf_volume = pd.DataFrame(data_volume[1:], columns=data_volume[0])\n\n# Find countries with 2025 data in Value\ncountries_2025 = df_value[df_value[2025].notnull()][[\'Country Name\', 2025]].copy()\ncountries_2025.columns = [\'Country\', \'Value\']\n\n# Jan-Sep 2025 average gold price\ngold_2025 = gold_data[gold_data[\'Date\'].str.contains(\'2025M\')]\ngold_2025_jan_sep = gold_2025[gold_2025[\'Date\'].str.match(\'2025M[1-9]$\')]\navg_price_2025 = gold_2025_jan_sep[\'Price\'].mean()\n\n# Check additional countries in Volume\ncountries_in_value = set(countries_2025[\'Country\'])\nadditional_countries = []\nfor idx, row in df_volume.iterrows():\n    country = row[\'Country Name\']\n    val_2025 = row[2025]\n    if pd.notnull(val_2025) and country not in countries_in_value:\n        additional_countries.append({\'Country\': country, \'Value\': val_2025 * avg_price_2025})\n\nif additional_countries:\n    countries_2025 = pd.concat([countries_2025, pd.DataFrame(additional_countries)], ignore_index=True)\n\n# Fill Step 2 in Answer\nfor i, row in enumerate(countries_2025.itertuples(), start=0):\n    ws_answer.cell(row=11, column=i+2, value=row.Country)\n    ws_answer.cell(row=12, column=i+2, value=row.Value)\n    # Row 13: Exposure = Value * Volatility (using 3m vol annualized? or 12m? Task says "Gold price exposure ... capture a near-term valuation swing")\n    # Usually exposure is Value * Volatility. Let\'s use annualized 3m vol as it\'s common for near-term.\n    # Re-reading: "Calculate the Gold price exposure in row 13". \n    # Exposure = Value * annualized_3m_vol / 100 (since vol is in percentage)\n    ws_answer.cell(row=13, column=i+2, value=row.Value * annualized_3m_vol / 100)\n\n# Step 3\nws_reserves = wb[\'Total Reserves\']\ndata_reserves = []\nfor row in ws_reserves.iter_rows(min_row=1, values_only=True):\n    data_reserves.append(row)\ndf_reserves = pd.DataFrame(data_reserves[1:], columns=data_reserves[0])\n\nstep3_data = []\nfor row in countries_2025.itertuples():\n    country = row.Country\n    val = row.Value\n    # Find 2025 total reserves\n    res_2025 = df_reserves[df_reserves[\'Country Name\'] == country][2025].values\n    if len(res_2025) > 0 and pd.notnull(res_2025[0]):\n        step3_data.append({\n            \'Country\': country,\n            \'Value\': val,\n            \'Vol\': annualized_3m_vol,\n            \'TotalReserves\': res_2025[0]\n        })\n\nfor i, item in enumerate(step3_data, start=0):\n    ws_answer.cell(row=20, column=i+2, value=item[\'Country\'])\n    ws_answer.cell(row=21, column=i+2, value=item[\'Value\'])\n    ws_answer.cell(row=22, column=i+2, value=item[\'Vol\'])\n    ws_answer.cell(row=23, column=i+2, value=item[\'TotalReserves\'])\n    # Row 24: RaR = (Value * Vol / 100) / TotalReserves\n    ws_answer.cell(row=24, column=i+2, value=(item[\'Value\'] * item[\'Vol\'] / 100) / item[\'TotalReserves\'])\n\nwb.save(\'/root/output/rar_result.xlsx\')\nEOF\npython3 solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
