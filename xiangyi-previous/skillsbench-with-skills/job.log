Sending keys: ['cat > simulation.py << \'EOF\'\nimport yaml\nimport pandas as pd\nimport math\nfrom acc_system import AdaptiveCruiseControl\n\ndef run_simulation():\n    # Load configuration\n    with open(\'vehicle_params.yaml\', \'r\') as f:\n        config = yaml.safe_load(f)\n    \n    # Load tuned gains if available\n    try:\n        with open(\'tuning_results.yaml\', \'r\') as f:\n            tuning = yaml.safe_load(f)\n            config[\'pid_speed\'] = tuning[\'pid_speed\']\n            config[\'pid_distance\'] = tuning[\'pid_distance\']\n            print("Loaded tuned gains")\n    except FileNotFoundError:\n        print("No tuning results found, using default gains")\n\n    # Initialize ACC\n    acc = AdaptiveCruiseControl(config)\n    dt = config[\'simulation\'][\'dt\']\n    \n    # Load sensor data\n    sensor_data = pd.read_csv(\'sensor_data.csv\')\n    \n    results = []\n    \n    for index, row in sensor_data.iterrows():\n        time = row[\'time\']\n        ego_speed = row[\'ego_speed\']\n        lead_speed = row[\'lead_speed\'] if not pd.isna(row[\'lead_speed\']) else None\n        distance = row[\'distance\'] if not pd.isna(row[\'distance\']) else None\n        \n        accel_cmd, mode, dist_err = acc.compute(ego_speed, lead_speed, distance, dt)\n        \n        # Calculate TTC for logging\n        ttc = None\n        if lead_speed is not None and distance is not None:\n            rel_speed = ego_speed - lead_speed\n            if rel_speed > 0:\n                ttc = distance / rel_speed\n        \n        results.append({\n            \'time\': time,\n            \'ego_speed\': ego_speed,\n            \'acceleration_cmd\': accel_cmd,\n            \'mode\': mode,\n            \'distance_error\': dist_err,\n            \'distance\': distance,\n            \'ttc\': ttc\n        })\n    \n    # Save results\n    df_results = pd.DataFrame(results)\n    df_results.to_csv(\'simulation_results.csv\', index=False)\n    print("Simulation complete. Results saved to simulation_results.csv")\n\nif __name__ == \'__main__\':\n    run_simulation()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
