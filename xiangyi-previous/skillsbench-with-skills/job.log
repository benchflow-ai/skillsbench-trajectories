Sending keys: ['cat >> /app/analysis_part5.py << \'EOF\'\n\ndef run_univariate_did(data, feature_col, outcome_col):\n    """Run univariate DiD for a single feature"""\n    data = data.copy()\n    data[\'Post\'] = (data[\'Period\'] == \'Treatment\').astype(int)\n    data[\'Feature\'] = data[feature_col]\n    data[\'Interaction\'] = data[\'Post\'] * data[\'Feature\']\n    \n    # Simple OLS for DiD\n    try:\n        from sklearn.linear_model import LinearRegression\n        X = data[[\'Post\', \'Feature\', \'Interaction\']].values\n        y = data[outcome_col].values\n        \n        if len(y) < 10 or np.std(y) == 0:\n            return None, None\n        \n        model = LinearRegression()\n        model.fit(X, y)\n        did_coef = model.coef_[2]  # Interaction coefficient\n        \n        # Calculate p-value using t-test approximation\n        n = len(y)\n        y_pred = model.predict(X)\n        residuals = y - y_pred\n        mse = np.sum(residuals**2) / (n - 4)\n        \n        # Standard error approximation\n        X_centered = X - X.mean(axis=0)\n        var_coef = mse * np.linalg.pinv(X_centered.T @ X_centered)\n        se = np.sqrt(np.abs(var_coef[2, 2])) if var_coef.shape[0] > 2 else 1\n        \n        if se > 0:\n            t_stat = did_coef / se\n            p_value = 2 * (1 - stats.t.cdf(abs(t_stat), n - 4))\n        else:\n            p_value = 1.0\n        \n        return did_coef, p_value\n    except:\n        return None, None\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
