Sending keys: ['cd /root && cat > run_optimization.py << \'ENDOFFILE\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\n\ndef custom_distance_matrix(X, w):\n    n = len(X)\n    D = np.zeros((n, n))\n    for i in range(n):\n        for j in range(i+1, n):\n            dx = X[i, 0] - X[j, 0]\n            dy = X[i, 1] - X[j, 1]\n            d = np.sqrt((w * dx)**2 + ((2 - w) * dy)**2)\n            D[i, j] = d\n            D[j, i] = d\n    return D\n\ndef greedy_match(centroids, experts, max_dist=100):\n    if len(centroids) == 0 or len(experts) == 0:\n        return [], []\n    distances = cdist(centroids, experts, metric=\'euclidean\')\n    matched_c, matched_e = [], []\n    used_c, used_e = set(), set()\n    while True:\n        masked = distances.copy()\n        for i in used_c:\n            masked[i, :] = np.inf\n        for j in used_e:\n            masked[:, j] = np.inf\n        min_val = masked.min()\n        if min_val > max_dist or min_val == np.inf:\n            break\n        i, j = np.unravel_index(masked.argmin(), masked.shape)\n        matched_c.append(i)\n        matched_e.append(j)\n        used_c.add(i)\n        used_e.add(j)\n    return matched_c, matched_e\n\ndef eval_image(citsci, expert, ms, eps, sw):\n    if len(citsci) == 0:\n        return 0.0, np.nan\n    D = custom_distance_matrix(citsci, sw)\n    labels = DBSCAN(eps=eps, min_samples=ms, metric=\'precomputed\').fit_predict(D)\n    unique = set(labels)\n    if -1 in unique:\n        unique.remove(-1)\n    if len(unique) == 0:\n        return 0.0, np.nan\n    centroids = np.array([citsci[labels == l].mean(axis=0) for l in unique])\n    mc, me = greedy_match(centroids, expert)\n    nm = len(mc)\n    if nm == 0:\n        return 0.0, np.nan\n    p = nm / len(centroids)\n    r = nm / len(expert)\n    f1 = 2 * p * r / (p + r) if p + r > 0 else 0\n    delta = np.mean([np.linalg.norm(centroids[i] - expert[j]) for i, j in zip(mc, me)])\n    return f1, delta\n\nprint("Loading...")\ncitsci = pd.read_csv(\'/root/data/citsci_train.csv\')[[\'file_rad\', \'x\', \'y\']]\nexpert = pd.read_csv(\'/root/data/expert_train.csv\')[[\'file_rad\', \'x\', \'y\']]\nimages = expert[\'file_rad\'].unique()\nprint(f"{len(images)} images")\n\nimage_data = {}\nfor img in images:\n    image_data[img] = (citsci[citsci[\'file_rad\'] == img][[\'x\', \'y\']].values,\n                       expert[expert[\'file_rad\'] == img][[\'x\', \'y\']].values)\n\nparams = list(product(range(3, 10), range(4, 26, 2), [round(0.9 + i * 0.1, 1) for i in range(11)]))\nprint(f"{len(params)} combinations")\n\nresults = []\nfor idx, (ms, eps, sw) in enumerate(params):\n    if (idx + 1) % 100 == 0:\n        print(f"{idx + 1}/{len(params)}")\n    f1s, deltas = [], []\n    for img in images:\n        c, e = image_data[img]\n        f1, delta = eval_image(c, e, ms, eps, sw)\n        f1s.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    avg_f1 = np.mean(f1s)\n    avg_delta = np.mean(deltas) if deltas else np.nan\n    results.append((avg_f1, avg_delta, ms, eps, sw))\n\nfiltered = [(f1, d, ms, eps, sw) for f1, d, ms, eps, sw in results if f1 > 0.5 and not np.isnan(d)]\nprint(f"{len(filtered)} with F1>0.5")\n\nif filtered:\n    costs = np.array([(f1, d) for f1, d, _, _, _ in filtered])\n    pareto = []\n    for i in range(len(filtered)):\n        dominated = False\n        for j in range(len(filtered)):\n            if i != j and costs[j, 0] >= costs[i, 0] and costs[j, 1] <= costs[i, 1] and (costs[j, 0] > costs[i, 0] or costs[j, 1] < costs[i, 1]):\n                dominated = True\n                break\n        if not dominated:\n            pareto.append(filtered[i])\n    pareto.sort(reverse=True)\n    with open(\'/root/pareto_frontier.csv\', \'w\') as f:\n        f.write(\'F1,delta,min_samples,epsilon,shape_weight\\n\')\n        for f1, d, ms, eps, sw in pareto:\n            f.write(f\'{f1:.5f},{d:.5f},{ms},{eps},{sw:.1f}\\n\')\n    print(f"Wrote {len(pareto)} solutions")\nENDOFFILE\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
