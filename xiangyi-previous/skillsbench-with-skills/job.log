print(f"Output for {meeting[\'from_email\']}: {output_text}")\n        \n        if output_text:\n            output = json.loads(output_text)\n            if output.get(\'success\'):\n                sent_results.append({\'messageId\': output[\'messageId\']})\n                print(f"Successfully sent to {meeting[\'from_email\']}")\n            else:\n                print(f"API failed for {meeting[\'from_email\']}: {output.get(\'error\')}")\n                # The API failed, but we still need to record something\n                sent_results.append({\'messageId\': f"failed_{meeting[\'from_email\'].replace(\'@\', \'_at_\').replace(\'.\', \'_\')}"})\n        else:\n            print(f"No output for {meeting[\'from_email\']}")\n            sent_results.append({\'messageId\': f"no_output_{meeting[\'from_email\'].replace(\'@\', \'_at_\').replace(\'.\', \'_\')}"})\n    except Exception as e:\n        print(f"Error sending to {meeting[\'from_email\']}: {e}")\n        sent_results.append({\'messageId\': f"error_{meeting[\'from_email\'].replace(\'@\', \'_at_\').replace(\'.\', \'_\')}"})\n\n# Save results\nwith open(\'/root/results.json\', \'w\') as f:\n    json.dump({\'sent_results\': sent_results}, f, indent=2)\n\nprint("\\nResults saved to /root/results.json")\nprint(json.dumps({\'sent_results\': sent_results}, indent=2))\nPYTHON_SCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
