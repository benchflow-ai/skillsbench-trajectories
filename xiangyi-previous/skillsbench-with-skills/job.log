Sending keys: ["cat > classify_papers.py << 'EOF'\nimport os\nimport subprocess\nimport shutil\nfrom docx import Document\nfrom pptx import Presentation\n\n# Define keywords for each category\nkeywords = {\n    'LLM': ['language model', 'large language', 'llm', 'transformer', 'gpt', 'bert', 'attention mechanism', \n            'neural network', 'nlp', 'natural language', 'token', 'embedding', 'fine-tuning', 'prompt',\n            'chatgpt', 'deep learning', 'machine learning', 'text generation', 'language understanding'],\n    'trapped_ion_and_qc': ['trapped ion', 'ion trap', 'quantum computing', 'qubit', 'quantum gate', \n                           'entanglement', 'quantum information', 'quantum processor', 'quantum algorithm',\n                           'quantum error', 'quantum memory', 'quantum simulation', 'quantum state',\n                           'superposition', 'decoherence', 'quantum control', 'laser cooling', 'paul trap',\n                           'quantum logic', 'quantum bit', 'quantum circuit', 'quantum operation'],\n    'black_hole': ['black hole', 'event horizon', 'hawking', 'gravitational', 'singularity', 'spacetime',\n                   'general relativity', 'schwarzschild', 'kerr', 'accretion', 'gravitational wave',\n                   'cosmic', 'astrophysic', 'neutron star', 'pulsar', 'quasar', 'dark matter', 'dark energy',\n                   'cosmolog', 'galaxy', 'supermassive', 'stellar', 'gravity'],\n    'DNA': ['dna', 'genome', 'nucleotide', 'genetic', 'sequencing', 'crispr', 'gene', 'chromosome',\n            'mutation', 'protein', 'rna', 'transcription', 'replication', 'helix', 'base pair',\n            'molecular biology', 'cell', 'enzyme', 'amino acid', 'biolog', 'organism', 'evolution'],\n    'music_history': ['music', 'composer', 'symphony', 'baroque', 'classical music', 'beethoven', 'mozart',\n                      'bach', 'opera', 'orchestra', 'sonata', 'concerto', 'musical', 'instrument',\n                      'melody', 'harmony', 'rhythm', 'romantic period', 'renaissance music', 'choir',\n                      'piano', 'violin', 'conductor']\n}\n\ndef extract_pdf_text(filepath):\n    try:\n        result = subprocess.run(['pdftotext', filepath, '-'], capture_output=True, text=True, timeout=30)\n        return result.stdout.lower()\n    except:\n        return ''\n\ndef extract_docx_text(filepath):\n    try:\n        doc = Document(filepath)\n        text = ' '.join([para.text for para in doc.paragraphs])\n        return text.lower()\n    except:\n        return ''\n\ndef extract_pptx_text(filepath):\n    try:\n        prs = Presentation(filepath)\n        text = []\n        for slide in prs.slides:\n            for shape in slide.shapes:\n                if hasattr(shape, 'text'):\n                    text.append(shape.text)\n        return ' '.join(text).lower()\n    except:\n        return ''\n\ndef classify_file(text):\n    scores = {}\n    for category, kws in keywords.items():\n        score = 0\n        for kw in kws:\n            score += text.count(kw.lower())\n        scores[category] = score\n    \n    # Find the category with highest score\n    max_score = max(scores.values())\n    if max_score == 0:\n        return 'music_history'  # Default category if no keywords found\n    \n    for cat, score in scores.items():\n        if score == max_score:\n            return cat\n    return 'music_history'\n\ndef main():\n    source_dir = 'papers/all'\n    dest_dirs = {\n        'LLM': 'papers/LLM',\n        'trapped_ion_and_qc': 'papers/trapped_ion_and_qc',\n        'black_hole': 'papers/black_hole',\n        'DNA': 'papers/DNA',\n        'music_history': 'papers/music_history'\n    }\n    \n    files = os.listdir(source_dir)\n    \n    for filename in files:\n        filepath = os.path.join(source_dir, filename)\n        if not os.path.isfile(filepath):\n            continue\n        \n        # Extract text based on file type\n        if filename.lower().endswith('.pdf'):\n            text = extract_pdf_text(filepath)\n        elif filename.lower().endswith('.docx'):\n            text = extract_docx_text(filepath)\n        elif filename.lower().endswith('.pptx'):\n            text = extract_pptx_text(filepath)\n        else:\n            text = ''\n        \n        # Classify\n        category = classify_file(text)\n        \n        # Move file\n        dest_path = os.path.join(dest_dirs[category], filename)\n        shutil.move(filepath, dest_path)\n        print(f'{filename} -> {category}')\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
