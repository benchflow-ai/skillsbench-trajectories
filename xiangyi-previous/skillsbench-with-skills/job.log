Sending keys: ['python3 << \'EOF\'\nimport re\nfrom collections import deque\n\ndef parse_domain_and_generate_plan_v2(domain_file, problem_file, output_file, task_num):\n    # Read files\n    with open(domain_file, \'r\') as f:\n        domain_content = f.read()\n    with open(problem_file, \'r\') as f:\n        problem_content = f.read()\n    \n    # Extract move action names\n    move_actions = re.findall(r\'\\(:action\\s+(move_[^\\s]+)\', domain_content)\n    \n    # Build transition graph for moves\n    transitions = {}  # from_seg -> [(to_seg, action_name), ...]\n    action_map = {}  # (from_seg, to_seg) -> action_name\n    \n    for action in move_actions:\n        parts = action.split(\'_\')\n        seg_pos = [i for i, p in enumerate(parts) if p == \'seg\']\n        \n        if len(seg_pos) >= 2:\n            from_parts = [\'seg\']\n            for i in range(seg_pos[0]+1, seg_pos[1]):\n                from_parts.append(parts[i])\n            \n            to_parts = [\'seg\']\n            for i in range(seg_pos[1]+1, len(parts)):\n                if parts[i] in [\'north\', \'south\', \'medium\']:\n                    break\n                to_parts.append(parts[i])\n            \n            from_seg = \'_\'.join(from_parts)\n            to_seg = \'_\'.join(to_parts)\n            \n            if from_seg not in transitions:\n                transitions[from_seg] = []\n            transitions[from_seg].append((to_seg, action))\n            action_map[(from_seg, to_seg)] = action\n    \n    # Extract startup and takeoff actions\n    startup_actions = re.findall(r\'\\(:action\\s+(startup_[^\\s]+)\', domain_content)\n    takeoff_actions = re.findall(r\'\\(:action\\s+(takeoff_[^\\s]+)\', domain_content)\n    \n    # Extract initial state\n    init_match = re.search(r\'\\(at-segment\\s+(\\S+)\\s+(\\S+)\\)\', problem_content)\n    if init_match:\n        airplane = init_match.group(1)\n        start_seg = init_match.group(2)\n    \n    # Extract goal\n    goal_match = re.search(r\'\\(is-parked\\s+(\\S+)\\s+(\\S+)\\)|\\(airborne\\s+(\\S+)\\s+(\\S+)\\)\', problem_content)\n    if goal_match:\n        if goal_match.group(1):  # is-parked\n            goal_seg = goal_match.group(2)\n            goal_type = \'parked\'\n        else:  # airborne\n            goal_seg = goal_match.group(4)\n            goal_type = \'airborne\'\n    \n    print(f"Start: {start_seg}, Goal: {goal_seg} ({goal_type})")\n    print(f"Airplane: {airplane}")\n    \n    # BFS to find path\n    def find_path(start, goal):\n        queue = deque([(start, [start])])\n        visited = {start}\n        \n        while queue:\n            current, path = queue.popleft()\n            \n            if current == goal:\n                return path\n            \n            if current in transitions:\n                for next_seg, _ in transitions[current]:\n                    if next_seg not in visited:\n                        visited.add(next_seg)\n                        queue.append((next_seg, path + [next_seg]))\n        \n        return None\n    \n    path = find_path(start_seg, goal_seg)\n    \n    if path:\n        print(f"Path found: {path}")\n        \n        # Generate plan\n        plan_lines = []\n        for i in range(len(path) - 1):\n            from_seg = path[i]\n            to_seg = path[i+1]\n            action = action_map[(from_seg, to_seg)]\n            plan_lines.append(f"{action}({airplane})")\n        \n        # Add startup and takeoff if goal is airborne\n        if goal_type == \'airborne\':\n            # Find appropriate startup action for goal_seg\n            # Format: startup_seg_RWE_0_50_south_medium\n            startup_pattern = f"startup_{goal_seg}_"\n            matching_startup = [a for a in startup_actions if a.startswith(startup_pattern)]\n            if matching_startup:\n                plan_lines.append(f"{matching_startup[0]}({airplane})")\n                print(f"Added startup: {matching_startup[0]}")\n            \n            # Find appropriate takeoff action for goal_seg\n            # Format: takeoff_seg_RWE_0_50_south\n            takeoff_pattern = f"takeoff_{goal_seg}_"\n            matching_takeoff = [a for a in takeoff_actions if a.startswith(takeoff_pattern)]\n            if matching_takeoff:\n                plan_lines.append(f"{matching_takeoff[0]}({airplane})")\n                print(f"Added takeoff: {matching_takeoff[0]}")\n        \n        # Write plan\n        with open(output_file, \'w\') as f:\n            for line in plan_lines:\n                f.write(line + \'\\n\')\n        \n        print(f"\\nPlan written to {output_file}")\n        for line in plan_lines:\n            print(f"  {line}")\n    else:\n        print("No path found!")\n\n# Process task02\nprint("=== Task02 ===")\nparse_domain_and_generate_plan_v2(\'/app/airport/domain02.pddl\', \'/app/airport/task02.pddl\', \'/app/task02.txt\', 2)\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
