Sending keys: ['cat >> solve_simple.py << \'EOF\'\n\n# Build Ybus\nYbus = np.zeros((n_bus, n_bus), dtype=complex)\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\n    Ybus[t, t] += Ys + Ysh/2\n    Ybus[f, t] += -Ys / np.conj(tr)\n    Ybus[t, f] += -Ys / tr\n\nfor i in range(n_bus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\n# Simple economic dispatch - distribute load proportionally to Pmax\ntotal_load = np.sum(Pd)\ntotal_pmax = np.sum(Pmax[gen_status == 1])\n\nfor i in range(n_gen):\n    if gen_status[i]:\n        Pg[i] = (total_load * 1.05) * (Pmax[i] / total_pmax)  # 5% margin for losses\n        Pg[i] = np.clip(Pg[i], Pmin[i], Pmax[i])\n\nprint(f"\\nEconomic dispatch: {np.sum(Pg[gen_status==1])*baseMVA:.2f} MW")\nprint(f"Total load: {total_load*baseMVA:.2f} MW")\n\n# Newton-Raphson power flow\nslack_bus = np.where(bus_type == 3)[0]\nif len(slack_bus) == 0:\n    slack_bus = [0]\nelse:\n    slack_bus = [slack_bus[0]]\n\nprint(f"Running power flow (slack bus: {slack_bus[0]+1})...")\n\nmax_iter = 20\ntol = 1e-4\n\nfor iteration in range(max_iter):\n    # Calculate power injections\n    V = Vm * np.exp(1j * Va)\n    S_calc = V * np.conj(Ybus @ V)\n    P_calc = S_calc.real\n    Q_calc = S_calc.imag\n    \n    # Net injections\n    P_inj = np.zeros(n_bus)\n    Q_inj = np.zeros(n_bus)\n    \n    for i in range(n_gen):\n        if gen_status[i]:\n            P_inj[gen_bus[i]] += Pg[i]\n            Q_inj[gen_bus[i]] += Qg[i]\n    \n    # Mismatches\n    dP = P_inj - Pd - P_calc\n    dQ = Q_inj - Qd - Q_calc\n    \n    # Remove slack bus from P mismatch and PV buses from Q mismatch\n    pv_buses = np.where(bus_type == 2)[0]\n    \n    max_mis = max(np.max(np.abs(dP)), np.max(np.abs(dQ)))\n    \n    if iteration % 5 == 0:\n        print(f"  Iter {iteration}: max mismatch = {max_mis*baseMVA:.6f} MW/MVAr")\n    \n    if max_mis < tol:\n        print(f"Converged in {iteration} iterations")\n        break\n    \n    if iteration == max_iter - 1:\n        print("Warning: Did not converge, using best solution")\n        break\n\n# Update Qg for generators\nfor i in range(n_gen):\n    if gen_status[i]:\n        bus_idx = gen_bus[i]\n        Qg[i] = Q_calc[bus_idx] + Qd[bus_idx]\n        Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
