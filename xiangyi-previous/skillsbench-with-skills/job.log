Sending keys: ['cat > /tmp/solve_civ6.py << \'EOF\'\nimport sqlite3\nimport json\nfrom collections import defaultdict\nimport itertools\n\n# Load map data\nconn = sqlite3.connect(\'/data/maps/e2e_test_case_0.Civ6Map\')\ncursor = conn.cursor()\n\ncursor.execute("SELECT Width, Height FROM Map;")\nwidth, height = cursor.fetchone()\n\ncursor.execute("SELECT ID, TerrainType, IsImpassable FROM Plots;")\nplots_data = cursor.fetchall()\n\ncursor.execute("SELECT ID, FeatureType FROM PlotFeatures;")\nfeatures_data = cursor.fetchall()\nfeatures = {fid: ftype for fid, ftype in features_data}\n\nconn.close()\n\n# Build terrain map\nterrain_map = {}\nfor plot_id, terrain, impassable in plots_data:\n    x = plot_id % width\n    y = plot_id // width\n    terrain_map[(x, y)] = {\n        \'terrain\': terrain,\n        \'impassable\': impassable,\n        \'feature\': features.get(plot_id, None)\n    }\n\n# Helper functions\ndef get_neighbors(x, y):\n    """Get all 6 neighbors in hex grid"""\n    if y % 2 == 0:  # Even row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x-1, y-1), (x, y-1),\n            (x-1, y+1), (x, y+1)\n        ]\n    else:  # Odd row\n        neighbors = [\n            (x-1, y), (x+1, y),\n            (x, y-1), (x+1, y-1),\n            (x, y+1), (x+1, y+1)\n        ]\n    return [(nx, ny) for nx, ny in neighbors if (nx, ny) in terrain_map]\n\ndef is_valid_placement(x, y):\n    """Check if a tile can have a district placed"""\n    if (x, y) not in terrain_map:\n        return False\n    tile = terrain_map[(x, y)]\n    if \'OCEAN\' in tile[\'terrain\'] or \'COAST\' in tile[\'terrain\']:\n        return False\n    if \'MOUNTAIN\' in tile[\'terrain\']:\n        return False\n    if tile[\'impassable\']:\n        return False\n    return True\n\ndef calculate_campus_bonus(x, y, placed_districts):\n    """Calculate Campus adjacency bonus"""\n    bonus = 0\n    neighbors = get_neighbors(x, y)\n    \n    # Count mountains\n    for nx, ny in neighbors:\n        if (nx, ny) in terrain_map:\n            tile = terrain_map[(nx, ny)]\n            if \'MOUNTAIN\' in tile[\'terrain\']:\n                bonus += 1\n            # Geothermal fissure\n            if tile[\'feature\'] == \'FEATURE_GEOTHERMAL_FISSURE\':\n                bonus += 1\n            # Reef\n            if tile[\'feature\'] == \'FEATURE_REEF\':\n                bonus += 1\n    \n    # Count rainforests/jungles (1 per 2)\n    jungle_count = 0\n    for nx, ny in neighbors:\n        if (nx, ny) in terrain_map:\n            tile = terrain_map[(nx, ny)]\n            if tile[\'feature\'] in [\'FEATURE_JUNGLE\', \'FEATURE_MARSH\']:\n                jungle_count += 1\n    bonus += jungle_count // 2\n    \n    return bonus\n\ndef calculate_holy_site_bonus(x, y, placed_districts):\n    """Calculate Holy Site adjacency bonus"""\n    bonus = 0\n    neighbors = get_neighbors(x, y)\n    \n    # Count mountains\n    for nx, ny in neighbors:\n        if (nx, ny) in terrain_map:\n            tile = terrain_map[(nx, ny)]\n            if \'MOUNTAIN\' in tile[\'terrain\']:\n                bonus += 1\n    \n    # Count woods (1 per 2)\n    woods_count = 0\n    for nx, ny in neighbors:\n        if (nx, ny) in terrain_map:\n            tile = terrain_map[(nx, ny)]\n            if tile[\'feature\'] == \'FEATURE_FOREST\':\n                woods_count += 1\n    bonus += woods_count // 2\n    \n    return bonus\n\ndef calculate_theater_bonus(x, y, placed_districts):\n    """Calculate Theater Square adjacency bonus"""\n    bonus = 0\n    neighbors = get_neighbors(x, y)\n    \n    # Count adjacent districts (1 per 2)\n    district_count = 0\n    for nx, ny in neighbors:\n        if (nx, ny) in placed_districts:\n            district_count += 1\n    bonus += district_count // 2\n    \n    return bonus\n\ndef calculate_industrial_zone_bonus(x, y, placed_districts):\n    """Calculate Industrial Zone adjacency bonus"""\n    bonus = 0\n    # Typically gets bonus from mines/quarries and strategic resources\n    # Without resource data, this will be minimal\n    return bonus\n\ndef calculate_commercial_hub_bonus(x, y, placed_districts):\n    """Calculate Commercial Hub adjacency bonus"""\n    bonus = 0\n    neighbors = get_neighbors(x, y)\n    \n    # Count adjacent rivers (would need river data)\n    # Count adjacent harbors\n    for nx, ny in neighbors:\n        if placed_districts.get((nx, ny)) == \'HARBOR\':\n            bonus += 2\n    \n    return bonus\n\ndef calculate_harbor_bonus(x, y, placed_districts, city_center):\n    """Calculate Harbor adjacency bonus"""\n    if (x, y) not in terrain_map:\n        return 0\n    \n    tile = terrain_map[(x, y)]\n    # Harbor must be on coast\n    if \'COAST\' not in tile[\'terrain\']:\n        return 0\n    \n    bonus = 0\n    neighbors = get_neighbors(x, y)\n    \n    # +2 if adjacent to city center\n    if city_center in neighbors:\n        bonus += 2\n    \n    # Count sea resources (reef, fish, etc)\n    for nx, ny in neighbors:\n        if (nx, ny) in terrain_map:\n            ntile = terrain_map[(nx, ny)]\n            if ntile[\'feature\'] == \'FEATURE_REEF\':\n                bonus += 1\n    \n    return bonus\n\ndef is_harbor_valid(x, y):\n    """Check if harbor can be placed here"""\n    if (x, y) not in terrain_map:\n        return False\n    tile = terrain_map[(x, y)]\n    return \'COAST\' in tile[\'terrain\']\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
