Sending keys: ['cat > /workspace/src/main/java/com/example/userservice/service/ExternalApiService.java << \'EOF\'\npackage com.example.userservice.service;\n\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.http.MediaType;\nimport org.springframework.stereotype.Service;\nimport org.springframework.web.client.RestClient;\n\nimport java.util.Map;\n\n/**\n * Service for making external API calls using RestClient.\n * Migrated from RestTemplate to RestClient for Spring Boot 3.2.\n */\n@Service\npublic class ExternalApiService {\n\n    private final RestClient restClient;\n\n    @Value("${external.api.base-url:https://api.example.com}")\n    private String baseUrl;\n\n    public ExternalApiService() {\n        this.restClient = RestClient.create();\n    }\n\n    /**\n     * Verify user email through external service\n     */\n    public boolean verifyEmail(String email) {\n        try {\n            String url = baseUrl + "/verify/email?email=" + email;\n            Map response = restClient.get()\n                    .uri(url)\n                    .retrieve()\n                    .body(Map.class);\n            if (response != null) {\n                Object valid = response.get("valid");\n                return Boolean.TRUE.equals(valid);\n            }\n            return false;\n        } catch (Exception e) {\n            // Log and return false on failure\n            return false;\n        }\n    }\n\n    /**\n     * Send notification to external notification service\n     */\n    public void sendNotification(String userId, String message) {\n        try {\n            String url = baseUrl + "/notifications";\n\n            Map<String, String> requestBody = Map.of(\n                    "userId", userId,\n                    "message", message\n            );\n\n            restClient.post()\n                    .uri(url)\n                    .contentType(MediaType.APPLICATION_JSON)\n                    .body(requestBody)\n                    .retrieve()\n                    .toBodilessEntity();\n        } catch (Exception e) {\n            // Log error but don\'t fail the main operation\n        }\n    }\n\n    /**\n     * Fetch user profile from external identity provider\n     */\n    public Map<String, Object> fetchExternalProfile(String externalId) {\n        try {\n            String url = baseUrl + "/profiles/" + externalId;\n            @SuppressWarnings("unchecked")\n            Map<String, Object> response = restClient.get()\n                    .uri(url)\n                    .accept(MediaType.APPLICATION_JSON)\n                    .retrieve()\n                    .body(Map.class);\n            return response;\n        } catch (Exception e) {\n            return null;\n        }\n    }\n\n    /**\n     * Update external system with user data\n     */\n    public boolean syncUserData(String userId, Map<String, Object> userData) {\n        try {\n            String url = baseUrl + "/users/" + userId + "/sync";\n\n            restClient.put()\n                    .uri(url)\n                    .contentType(MediaType.APPLICATION_JSON)\n                    .body(userData)\n                    .retrieve()\n                    .toBodilessEntity();\n            return true;\n        } catch (Exception e) {\n            return false;\n        }\n    }\n\n    /**\n     * Delete user data from external system\n     */\n    public boolean deleteExternalUserData(String userId) {\n        try {\n            String url = baseUrl + "/users/" + userId;\n\n            restClient.delete()\n                    .uri(url)\n                    .retrieve()\n                    .toBodilessEntity();\n            return true;\n        } catch (Exception e) {\n            return false;\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
