Sending keys: ['python3 << \'EOF\'\nimport numpy as np\nfrom scipy.signal import medfilt\n\n# Load and filter data\ndata = np.loadtxt(\'/root/data/tess_lc.txt\')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Quality filtering and outlier removal\nmask = (flag == 0)\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask_outliers = np.abs(flux - median_flux) < 5 * std_flux\ntime = time[mask_outliers]\nflux = flux[mask_outliers]\nflux_err = flux_err[mask_outliers]\n\n# Detrend\nwindow_size = 101\nflux_trend = medfilt(flux, kernel_size=window_size)\nflux_detrended = flux / flux_trend\n\nprint("Starting BLS period search...")\n\n# Implement Box Least Squares (BLS) algorithm\ndef bls_power(time, flux, period, qmin=0.01, qmax=0.1, nq=10):\n    """Calculate BLS power for a given period"""\n    # Fractional transit duration to test\n    q_values = np.linspace(qmin, qmax, nq)\n    max_sr = 0\n    \n    # Phase fold the data\n    phase = (time % period) / period\n    \n    for q in q_values:\n        # Test different transit phases\n        n_phase = int(1.0 / q)\n        for i in range(n_phase):\n            phase_center = i / n_phase\n            \n            # Separate in-transit and out-of-transit points\n            in_transit = np.abs(phase - phase_center) < q/2\n            in_transit |= np.abs(phase - phase_center - 1) < q/2\n            in_transit |= np.abs(phase - phase_center + 1) < q/2\n            \n            if np.sum(in_transit) < 3 or np.sum(~in_transit) < 3:\n                continue\n                \n            # Calculate signal residue (BLS statistic)\n            flux_in = flux[in_transit]\n            flux_out = flux[~in_transit]\n            \n            mean_in = np.mean(flux_in)\n            mean_out = np.mean(flux_out)\n            \n            if mean_out > 0:\n                sr = (mean_out - mean_in)**2 * len(flux_in) * len(flux_out) / len(flux)\n                max_sr = max(max_sr, sr)\n    \n    return max_sr\n\n# Search over period range\nperiod_min = 0.5\nperiod_max = min(12.0, (time[-1] - time[0]) / 2)\nn_periods = 5000\n\nperiods = np.linspace(period_min, period_max, n_periods)\npower = np.zeros(n_periods)\n\nfor i, period in enumerate(periods):\n    if i % 500 == 0:\n        print(f"Progress: {i}/{n_periods} periods tested")\n    power[i] = bls_power(time, flux_detrended, period)\n\n# Find best period\nbest_idx = np.argmax(power)\nbest_period = periods[best_idx]\n\nprint(f"\\nBest period found: {best_period:.5f} days")\nprint(f"BLS power: {power[best_idx]:.6f}")\n\n# Save the period\nwith open(\'/root/period.txt\', \'w\') as f:\n    f.write(f"{best_period:.5f}\\n")\n\nprint(f"Period written to /root/period.txt")\n\nEOF\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
