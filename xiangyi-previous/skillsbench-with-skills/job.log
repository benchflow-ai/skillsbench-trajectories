Sending keys: ["python3 - <<'PY'\nimport numpy as np\nfrom astropy.timeseries import BoxLeastSquares\nfrom astropy.stats import sigma_clip\nfrom scipy.signal import savgol_filter\n\n# Load data\npath = '/root/data/tess_lc.txt'\ndata = np.loadtxt(path)\n\nt, f, flag, ferr = data.T\nmask = flag == 0\n\nt, f, ferr = t[mask], f[mask], ferr[mask]\n# sigma clip outliers\nclip = sigma_clip(f, sigma=5)\nmask2 = ~clip.mask\n\nt, f, ferr = t[mask2], f[mask2], ferr[mask2]\n\n# Detrend using Savitzky-Golay filter\n# Estimate median cadence\nif len(t) > 1:\n    dt = np.median(np.diff(t))\nelse:\n    dt = 0.02\n\n# window length for ~1 day smoothing\nwindow = int(1.0 / dt)\nif window % 2 == 0:\n    window += 1\nif window < 5:\n    window = 5\n\ntrend = savgol_filter(f, window_length=window, polyorder=2)\ndetrended = f / trend\n\n# BLS period search\nbls = BoxLeastSquares(t, detrended, dy=ferr)\nperiods = np.linspace(0.5, 20.0, 20000)\ndurations = np.linspace(0.05, 0.3, 10)\n\npower = bls.power(periods, durations)\nbest_period = periods[np.argmax(power.power)]\nprint('Best period:', best_period)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat > /root/find_period.py << \'EOF\'\nimport numpy as np\nfrom scipy import signal\nfrom scipy.ndimage import median_filter\n\n# Load data\ndata = np.loadtxt(\'/root/data/tess_lc.txt\', comments=\'#\')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\nprint(f"Total data points: {len(time)}")\nprint(f"Time range: {time.min():.2f} to {time.max():.2f} MJD")\nprint(f"Time span: {time.max() - time.min():.2f} days")\n\n# Filter by quality flag (keep only flag=0)\nmask = flag == 0\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\nprint(f"After quality filter: {len(time)} points")\n\n# Remove outliers using sigma clipping\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nsigma_clip = 3.0\nmask = np.abs(flux - median_flux) < sigma_clip * std_flux\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\nprint(f"After outlier removal: {len(time)} points")\n\n# Detrend stellar variability using Savitzky-Golay filter\n# Need to handle gaps in data - use a window that spans ~1 day\ntime_step = np.median(np.diff(time))\nprint(f"Median time step: {time_step*24*60:.2f} minutes")\n\n# Window for ~0.5 day smoothing (to preserve transit shape)\nwindow_days = 0.5\nwindow_points = int(window_days / time_step)\nif window_points % 2 == 0:\n    window_points += 1\nwindow_points = max(window_points, 51)\nprint(f"Smoothing window: {window_points} points")\n\n# Use Savitzky-Golay filter for detrending\ntrend = signal.savgol_filter(flux, window_points, 3)\nflux_detrended = flux / trend\n\nprint(f"Detrended flux std: {np.std(flux_detrended):.6f}")\n\n# Box Least Squares periodogram for transit detection\ndef bls_periodogram(time, flux, periods, duration_frac=0.02):\n    """Simple BLS implementation"""\n    power = np.zeros(len(periods))\n    \n    for i, period in enumerate(periods):\n        # Phase fold\n        phase = (time % period) / period\n        \n        # Try different transit phases\n        n_phases = int(period / (duration_frac * period * 0.5)) + 1\n        n_phases = min(n_phases, 100)\n        \n        best_depth = 0\n        duration = duration_frac * period\n        \n        for phase_start in np.linspace(0, 1, n_phases):\n            phase_end = phase_start + duration_frac\n            \n            if phase_end <= 1:\n                in_transit = (phase >= phase_start) & (phase < phase_end)\n            else:\n                in_transit = (phase >= phase_start) | (phase < (phase_end - 1))\n            \n            if np.sum(in_transit) > 5 and np.sum(~in_transit) > 5:\n                depth = np.median(flux[~in_transit]) - np.median(flux[in_transit])\n                if depth > best_depth:\n                    best_depth = depth\n        \n        power[i] = best_depth\n    \n    return power\n\n# Search period range (typical hot Jupiter range)\nperiods = np.linspace(0.5, 15, 3000)\nprint("Running BLS periodogram...")\npower = bls_periodogram(time, flux_detrended, periods)\n\n# Find best period\nbest_idx = np.argmax(power)\nbest_period = periods[best_idx]\nprint(f"Best period: {best_period:.5f} days")\nprint(f"BLS power: {power[best_idx]:.6f}")\n\n# Refine around best period\nperiods_fine = np.linspace(best_period - 0.1, best_period + 0.1, 1000)\nperiods_fine = periods_fine[periods_fine > 0.3]\npower_fine = bls_periodogram(time, flux_detrended, periods_fine)\nbest_idx_fine = np.argmax(power_fine)\nbest_period_refined = periods_fine[best_idx_fine]\nprint(f"Refined period: {best_period_refined:.5f} days")\n\n# Write result\nwith open(\'/root/period.txt\', \'w\') as f:\n    f.write(f"{best_period_refined:.5f}\\n")\n\nprint(f"Period written to /root/period.txt")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
