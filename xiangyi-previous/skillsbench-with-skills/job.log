(clean_str).str.upper()\np['Category'] = p['Category'].fillna('UNKNOWN')\n\np = p.dropna(subset=['Order Date','Purchase Price Per Unit','Quantity','Survey ResponseID'])\np = p[(p['Purchase Price Per Unit']>0) & (p['Quantity']>0)]\np['Total_Spend'] = p['Purchase Price Per Unit'] * p['Quantity']\np = p.drop_duplicates()\n\np.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)\n\n# Anomaly detection\np['date'] = p['Order Date'].dt.normalize()\nend_date = pd.to_datetime('2020-03-31')\nstart_date = p['date'].min()\nall_dates = pd.date_range(start_date, end_date, freq='D')\n\ndaily_sales = p.groupby(['Category','date'])['Total_Spend'].sum().reset_index()\n\nrecords = []\nfor cat, grp in daily_sales.groupby('Category'):\n    s = grp.set_index('date').reindex(all_dates, fill_value=0)['Total_Spend']\n    baseline = s[s.index < pd.to_datetime('2020-03-01')]\n    treatment = s[(s.index >= pd.to_datetime('2020-03-01')) & (s.index <= end_date)]\n    baseline_mean = baseline.mean()\n    baseline_std = baseline.std()\n    treatment_mean = treatment.mean()\n    if baseline_std == 0 or np.isnan(baseline_std):\n        if treatment_mean == baseline_mean:\n            z = 0\n        else:\n            z = np.sign(treatment_mean - baseline_mean) * 5\n    else:\n        z = (treatment_mean - baseline_mean) / baseline_std\n    anomaly = np.tanh(z) * 100\n    records.append({'Category': cat, 'Anomaly_Index': anomaly,\n                    'baseline_avg_spend': baseline_mean,\n                    'treatment_avg_spend': treatment_mean})\n\nanomaly_df = pd.DataFrame(records)\nanomaly_df[['Category','Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)\n\n# Identify top categories\nanomaly_sorted = anomaly_df.sort_values('Anomaly_Index', ascending=False)\ntop_surge = anomaly_sorted.head(10)['Category'].tolist()\ntop_slump = anomaly_sorted.tail(10)['Category'].tolist()\n\n# Aggregate user-category-period data\nusers = survey_cleaned['Survey ResponseID'].unique()\nall_top_categories = list(dict.fromkeys(top_surge + top_slump))\n\nbaseline_start = pd.to_datetime('2020-01-01')\nbaseline_end = pd.to_datetime('2020-02-29')\ntreatment_start = pd.to_datetime('2020-03-01')\ntreatment_end = pd.to_datetime('2020-03-31')\n\nindex = pd.MultiIndex.from_product([users, all_top_categories], names=['Survey ResponseID','Category'])\n\nrows = []\nfor period_name, (start, end) in {'baseline':(baseline_start, baseline_end), 'treatment':(treatment_start, treatment_end)}.items():\n    df_period = p[(p['date']>=start) & (p['date']<=end) & (p['Category'].isin(all_top_categories))]\n    spend = df_period.groupby(['Survey ResponseID','Category'])['Total_Spend'].sum()\n    spend = spend.reindex(index, fill_value=0).reset_index()\n    spend['Period'] = period_name\n    rows.append(spend)\n\nagg = pd.concat(rows, ignore_index=True)\nagg_intensive = agg[['Survey ResponseID','Category','Period','Total_Spend']].copy()\nagg_intensive.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)\n\nagg_extensive = agg.copy()\nagg_extensive['Has_Purchase'] = (agg_extensive['Total_Spend']>0).astype(int)\nagg_extensive = agg_extensive[['Survey ResponseID','Category','Period','Has_Purchase']]\nagg_extensive.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)\n\n# Causal analysis\nfeatures = feature_df.set_index('Survey ResponseID')\nfeature_cols = [c for c in features.columns if features[c].nunique()>1]\n# filter features with prevalence >=5%\nvalid_features = [c for c in feature_cols if features[c].mean()>=0.05 and features[c].mean()<=0.95]\n\n\ndef did_regression(df, outcome, feature):\n    X = pd.DataFrame({\n        'feature': df[feature],\n        'period': df['period_ind'],\n    })\n    X['interaction'] = X['feature'] * X['period']\n    if sm is None:\n        # simple OLS using numpy\n        X_mat = np.column_stack([np.ones(len(X)), X['feature'], X['period'], X['interaction']])\n        y = df[outcome].values\n        beta = np.linalg.lstsq(X_mat, y, rcond=None)[0]\n        # approximate p-value not computed; return nan\n        return beta[3], np.nan\n    else:\n        X_mat = sm.add_constant(X)\n        model = sm.OLS(df[outcome], X_mat).fit()\n        return model.params['interaction'], model.pvalues['interaction']\n\nreport = {\n    'metadata': {\n        'baseline_start': baseline_start.strftime('%m-%d-%Y'),\n        'baseline_end': baseline_end.strftime('%m-%d-%Y'),\n        'treatment_start': treatment_start.strftime('%m-%d-%Y'),\n        'treatment_end': treatment_end.strftime('%m-%d-%Y'),\n        'total_features_analyzed': len(valid_features)\n    },\n    'surge_categories': [],\n    'slump_categories': [],\n    'summary': {\n        'surge': {'total_categories': len(top_surge), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0},\n        'slump': {'total_categories': len(top_slump), 'total_intensive_drivers': 0, 'total_extensive_drivers': 0}\n    }\n}\n\n# Precompute purchase metrics\nn_at_risk = len(users)\n\nfor cat_list, key in [(top_surge, 'surge_categories'), (top_slump, 'slump_categories')]:\n    for cat in cat_list:\n        cat_daily = anomaly_df[anomaly_df['Category']==cat].iloc[0]\n        # baseline and treatment metrics\n        base_users = p[(p['Category']==cat) & (p['date']>=baseline_start) & (p['date']<=baseline_end)]['Survey ResponseID'].nunique()\n        treat_users = p[(p['Category']==cat) & (p['date']>=treatment_start) & (p['date']<=treatment_end)]['Survey ResponseID'].nunique()\n        base_rate = base_users / n_at_risk if n_at_risk else 0\n        treat_rate = treat_users / n_at_risk if n_at_risk else 0\n\n        df_cat = agg[agg['Category']==cat].copy()\n        df_cat = df_cat.merge(features, left_on='Survey ResponseID', right_index=True, how='left')\n        df_cat['period_ind'] = (df_cat['Period']=='treatment').astype(int)\n        # intensive\n        int_results = []\n        for feat in valid_features:\n            try:\n                coef, pval = did_regression(df_cat, 'Total_Spend', feat)\n                int_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Univariate DiD'})\n            except Exception:\n                continue\n        # extensive\n        df_cat_ext = df_cat.copy()\n        df_cat_ext['Has_Purchase'] = (df_cat_ext['Total_Spend']>0).astype(int)\n        ext_results = []\n        for feat in valid_features:\n            try:\n                coef, pval = did_regression(df_cat_ext, 'Has_Purchase', feat)\n                ext_results.append({'feature': feat, 'did_estimate': float(coef), 'p_value': None if pd.isna(pval) else float(pval), 'method': 'Multivariate Heterogeneous DiD'})\n            except Exception:\n                continue\n\n        # sort and select top 3\n        if key == 'surge_categories':\n            int_results = sorted(int_results, key=lambda x: x['did_estimate'], reverse=True)[:3]\n            ext_results = sorted(ext_results, key=lambda x: x['did_estimate'], reverse=True)[:3]\n        else:\n            int_results = sorted(int_results, key=lambda x: x['did_estimate'])[:3]\n            ext_results = sorted(ext_results, key=lambda x: x['did_estimate'])[:3]\n\n        report[key].append({\n            'category': cat,\n            'anomaly_index': float(cat_daily['Anomaly_Index']),\n            'baseline_avg_spend': float(cat_daily['baseline_avg_spend']),\n            'treatment_avg_spend': float(cat_daily['treatment_avg_spend']),\n            'n_purchasers_baseline': int(base_users),\n            'n_purchasers_treatment': int(treat_users),\n            'baseline_purchase_rate': float(base_rate),\n            'treatment_purchase_rate': float(treat_rate),\n            'n_at_risk': int(n_at_risk),\n            'intensive_margin': int_results,\n            'extensive_margin': ext_results\n        })\n\n        report['summary']['surge' if key==