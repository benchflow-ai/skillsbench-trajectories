Sending keys: ['cat << \'EOF\' > process_data.py\nimport pandas as pd\nimport numpy as np\n\ndef clean_value(val):\n    if pd.isna(val):\n        return np.nan\n    if isinstance(val, str):\n        val = val.replace(\',\', \'.\')\n        try:\n            return float(val)\n        except ValueError:\n            return np.nan\n    return float(val)\n\ndf = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\')\ndf = df.dropna()\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(clean_value)\ndf = df.dropna()\n\n# Unit Harmonization\n# Serum_Creatinine (mg/dL): 0.7-1.3, CKD up to 20\ndf.loc[df[\'Serum_Creatinine\'] > 50, \'Serum_Creatinine\'] /= 88.4\n\n# BUN (mg/dL): 7-20, CKD up to 200\ndf.loc[df[\'BUN\'] < 5, \'BUN\'] /= 0.357\n\n# Serum_Calcium (mg/dL): 8.5-10.5\n# If < 3, likely mmol/L (factor 4). If 3-6, likely mEq/L (factor 2).\ndf.loc[df[\'Serum_Calcium\'] < 3.0, \'Serum_Calcium\'] *= 4.0\ndf.loc[(df[\'Serum_Calcium\'] >= 3.0) & (df[\'Serum_Calcium\'] < 7.0), \'Serum_Calcium\'] *= 2.0\n\n# Phosphorus (mg/dL): 2.5-4.5\ndf.loc[df[\'Phosphorus\'] < 2.0, \'Phosphorus\'] *= 3.1\n\n# Hemoglobin (g/dL): 12-16\ndf.loc[df[\'Hemoglobin\'] > 30, \'Hemoglobin\'] /= 10.0\ndf.loc[df[\'Hemoglobin\'] < 5.0, \'Hemoglobin\'] *= 1.61\ndf.loc[df[\'Hemoglobin\'] < 5.0, \'Hemoglobin\'] *= 4.0\n\n# Albumin_Serum (g/dL): 3.5-5.0\ndf.loc[df[\'Albumin_Serum\'] > 10, \'Albumin_Serum\'] /= 10.0\n\n# Total_Protein (g/dL): 6-8\ndf.loc[df[\'Total_Protein\'] > 15, \'Total_Protein\'] /= 10.0\n\n# Glucose (mg/dL): 70-100\ndf.loc[df[\'Glucose\'] < 25, \'Glucose\'] *= 18.0\n\n# Uric_Acid (mg/dL): 3-7\ndf.loc[df[\'Uric_Acid\'] > 50, \'Uric_Acid\'] /= 16.8\n\n# Bilirubin (mg/dL): 0.1-1.2\ndf.loc[df[\'Total_Bilirubin\'] > 5, \'Total_Bilirubin\'] /= 17.1\ndf.loc[df[\'Direct_Bilirubin\'] > 5, \'Direct_Bilirubin\'] /= 17.1\n\n# Cholesterol features: mg/dL\nfor col in [\'Total_Cholesterol\', \'LDL_Cholesterol\', \'HDL_Cholesterol\', \'Triglycerides\', \'Non_HDL_Cholesterol\']:\n    df.loc[df[col] < 15, col] *= 38.6 if col != \'Triglycerides\' else 88.5\n\n# Serum_Iron (ug/dL): 60-170\ndf.loc[df[\'Serum_Iron\'] < 20, \'Serum_Iron\'] *= 5.59\n\n# Round and format\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(lambda x: "{:.2f}".format(round(float(x), 2)))\n    else:\n        df[col] = df[col].astype(int)\n\ndf.to_csv(\'/root/ckd_lab_data_harmonized.csv\', index=False)\nEOF\npython3 process_data.py\nhead -n 5 /root/ckd_lab_data_harmonized.csv\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
