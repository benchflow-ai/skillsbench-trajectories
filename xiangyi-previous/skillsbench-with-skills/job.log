ations\n                # Mark picks as used\n                for idx in cluster_indices:\n                    picks_used.add(idx)\n                \n                # Estimate event time from P picks\n                p_picks = [p for p in cluster_picks if p[\'phase\'] == \'P\']\n                if len(p_picks) > 0:\n                    earliest_p = min([UTCDateTime(p[\'time\']) for p in p_picks])\n                    events.append({\n                        \'time\': earliest_p,\n                        \'n_picks\': len(cluster_picks),\n                        \'n_stations\': len(stations_in_cluster)\n                    })\n    \n    return events\n\nprint("\\nAssociating picks into events...")\nevents = associate_events(picks_df, time_window=20.0, min_picks=4)\nprint(f"Found {len(events)} events")\n\nif len(events) < 3:\n    print("Trying alternative association with relaxed parameters...")\n    events = associate_events(picks_df, time_window=30.0, min_picks=3)\n    print(f"Found {len(events)} events with relaxed parameters")\n\n# Create output DataFrame\nif len(events) > 0:\n    results = []\n    for event in events:\n        results.append({\n            \'time\': event[\'time\'].strftime(\'%Y-%m-%dT%H:%M:%S.%f\')[:-3],\n            \'n_picks\': event[\'n_picks\'],\n            \'n_stations\': event[\'n_stations\']\n        })\n    \n    results_df = pd.DataFrame(results)\n    results_df[\'time_utc\'] = pd.to_datetime(results_df[\'time\'])\n    results_df = results_df.sort_values(\'time_utc\')\n    \n    # Deduplicate events within 5 seconds\n    final_events = []\n    last_time = None\n    for _, row in results_df.iterrows():\n        if last_time is None or (row[\'time_utc\'] - last_time).total_seconds() > 5:\n            final_events.append(row)\n            last_time = row[\'time_utc\']\n    \n    final_df = pd.DataFrame(final_events)[[\'time\', \'n_picks\', \'n_stations\']]\n    print(f"\\nFinal events after deduplication: {len(final_df)}")\n    print(final_df)\nelse:\n    final_df = pd.DataFrame(columns=[\'time\'])\n    print("No events found!")\n\n# Save results\nfinal_df.to_csv(\'/root/results.csv\', index=False)\nprint(f"\\nResults saved to /root/results.csv")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
