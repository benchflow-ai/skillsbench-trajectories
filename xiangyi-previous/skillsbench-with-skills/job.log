Sending keys: ['cat << \'EOF\' > solution.py\nimport geopandas as gpd\nimport pandas as pd\nimport json\nfrom shapely.validation import make_valid\n\n# Load plates and find Pacific plate\nplates = gpd.read_file(\'/root/PB2002_plates.json\')\npacific_plate = plates[plates[\'Code\'] == \'PA\'].copy()\nif pacific_plate.empty:\n    pacific_plate = plates[plates[\'PlateName\'] == \'Pacific\'].copy()\n\npacific_poly = pacific_plate.geometry.iloc[0]\nif not pacific_poly.is_valid:\n    pacific_poly = make_valid(pacific_poly)\n\n# Load earthquakes\nearthquakes = gpd.read_file(\'/root/earthquakes_2024.json\')\n\n# Filter earthquakes within Pacific plate\npacific_quakes = earthquakes[earthquakes.geometry.within(pacific_poly)].copy()\n\n# Load boundaries\nboundaries = gpd.read_file(\'/root/PB2002_boundaries.json\')\n# Filter boundaries that are part of the Pacific plate (PA)\npacific_boundaries = boundaries[(boundaries[\'PlateA\'] == \'PA\') | (boundaries[\'PlateB\'] == \'PA\')]\n\n# Combine all Pacific boundary lines into a single MultiLineString\nboundary_lines = pacific_boundaries.geometry.unary_union\n\ndef get_min_distance(point, lines):\n    # Local projection centered on the point for accurate distance\n    proj_crs = f"+proj=aeqd +lat_0={point.y} +lon_0={point.x} +ellps=WGS84 +units=m"\n    p_gdf = gpd.GeoSeries([point], crs=\'EPSG:4326\').to_crs(proj_crs)\n    l_gdf = gpd.GeoSeries([lines], crs=\'EPSG:4326\').to_crs(proj_crs)\n    return p_gdf.distance(l_gdf).iloc[0] / 1000.0\n\npacific_quakes[\'distance_km\'] = pacific_quakes.geometry.apply(lambda p: get_min_distance(p, boundary_lines))\n\n# Find the one with max distance\nfurthest_quake = pacific_quakes.loc[pacific_quakes[\'distance_km\'].idxmax()]\n\n# Prepare output\nresult = {\n    "id": furthest_quake[\'id\'],\n    "place": furthest_quake[\'place\'],\n    "time": pd.to_datetime(furthest_quake[\'time\'], unit=\'ms\').strftime(\'%Y-%m-%dT%H:%M:%SZ\'),\n    "magnitude": float(furthest_quake[\'mag\']),\n    "latitude": float(furthest_quake.geometry.y),\n    "longitude": float(furthest_quake.geometry.x),\n    "distance_km": round(float(furthest_quake[\'distance_km\']), 2)\n}\n\nwith open(\'/root/answer.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
