       rationale = "No match found"\n        \n        if product_id in codebooks:\n            cb_records = codebooks[product_id]\n            candidates = []\n            raw_lower = raw_text.lower()\n            \n            for cb_row in cb_records:\n                keywords = cb_row[\'keywords_list\']\n                if not keywords:\n                    continue\n                \n                matches = 0\n                for k in keywords:\n                    if k in raw_lower:\n                        matches += 1\n                \n                if matches > 0:\n                    score = matches / len(keywords)\n                    candidates.append({\n                        "code": cb_row[\'code\'],\n                        "label": cb_row[\'standard_label\'],\n                        "score": score,\n                        "matches": matches\n                    })\n            \n            if candidates:\n                # Sort by score descending\n                candidates.sort(key=lambda x: x[\'score\'], reverse=True)\n                best = candidates[0]\n                \n                if best[\'score\'] > 0:\n                    pred_code = best[\'code\']\n                    pred_label = best[\'label\']\n                    confidence = round(best[\'score\'], 4)\n                    rationale = f"Matched {best[\'matches\']} keywords"\n        \n        segment = {\n            "segment_id": f"{record_id}-S1",\n            "span_text": raw_text,\n            "pred_code": pred_code,\n            "pred_label": pred_label,\n            "confidence": confidence,\n            "rationale": rationale\n        }\n        \n        record["normalized"].append(segment)\n        records.append(record)\n\n    output = {"records": records}\n    \n    try:\n        with open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n            json.dump(output, f, ensure_ascii=False, indent=2)\n        print("Successfully wrote /app/output/