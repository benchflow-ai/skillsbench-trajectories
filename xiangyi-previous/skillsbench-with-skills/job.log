Sending keys: ['cat > dicke_model.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# System parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Transition frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid parameters\ngrid_points = 1000\nx_range = 6.0\np_range = 6.0\n\nprint("Initializing Dicke model simulation...")\nprint(f"Parameters: N={N}, ω₀={omega_0}, ω_c={omega_c}, g={g:.4f}, κ={kappa}, n_max={n_max}")\n\n# Create operators\na = destroy(n_max)  # Cavity annihilation operator\nN_cav = num(n_max)  # Cavity number operator\n\n# Spin operators for N two-level systems\njz = (N/2.0) * qeye(2)  # Single spin Jz\njx = 0.5 * sigmax()  # Single spin Jx\njy = 0.5 * sigmay()  # Single spin Jy\njp = (sigmax() + 1j*sigmay()) / 2.0  # Single spin J+\njm = (sigmax() - 1j*sigmay()) / 2.0  # Single spin J-\n\n# Collective operators for N spins\nJz = tensor(a, qeye(2**N))\nJx = tensor(qeye(n_max), 0*qeye(2**N))\nJy = tensor(qeye(n_max), 0*qeye(2**N))\nJp = tensor(qeye(n_max), 0*qeye(2**N))\nJm = tensor(qeye(n_max), 0*qeye(2**N))\n\n# Build collective spin operators\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jz\n    Jz_i = tensor(qeye(n_max), tensor(ops))\n    Jz = Jz + Jz_i\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jp\n    Jp_i = tensor(qeye(n_max), tensor(ops))\n    Jp = Jp + Jp_i\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jm\n    Jm_i = tensor(qeye(n_max), tensor(ops))\n    Jm = Jm + Jm_i\n\nprint("Operators constructed.")\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * tensor(N_cav, qeye(2**N)) + g * (tensor(a + a.dag(), Jp + Jm))\n\nprint("Hamiltonian constructed.")\nprint("\\nSolving for steady states in 4 different loss cases...")\n\n# Case 1: Local dephasing & local pumping\nprint("\\nCase 1: Local dephasing (γ_φ=0.01) & local pumping (γ_↑=0.1)")\ngamma_phi_1 = 0.01\ngamma_up_1 = 0.1\n\nc_ops_1 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\n\n# Local dephasing and pumping for each spin\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_1) * tensor(qeye(n_max), tensor(ops))\n    c_ops_1.append(c_dephase)\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = (qeye(2) - sigmaz()) / 2.0  # |↓⟩⟨↓|\n    c_pump = np.sqrt(gamma_up_1) * tensor(qeye(n_max), tensor(ops))\n    c_ops_1.append(c_pump)\n\nprint(f"Number of collapse operators: {len(c_ops_1)}")\nrho_ss_1 = steadystate(H, c_ops_1, method=\'direct\')\nprint("Steady state found for Case 1.")\n\n# Case 2: Local dephasing & local emission\nprint("\\nCase 2: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1)")\ngamma_phi_2 = 0.01\ngamma_down_2 = 0.1\n\nc_ops_2 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_2) * tensor(qeye(n_max), tensor(ops))\n    c_ops_2.append(c_dephase)\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_2) * tensor(qeye(n_max), tensor(ops))\n    c_ops_2.append(c_emit)\n\nprint(f"Number of collapse operators: {len(c_ops_2)}")\nrho_ss_2 = steadystate(H, c_ops_2, method=\'direct\')\nprint("Steady state found for Case 2.")\n\n# Case 3: Local dephasing & local emission & collective pumping\nprint("\\nCase 3: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective pumping (γ_Σ↑=0.1)")\ngamma_phi_3 = 0.01\ngamma_down_3 = 0.1\ngamma_coll_up_3 = 0.1\n\nc_ops_3 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_3) * tensor(qeye(n_max), tensor(ops))\n    c_ops_3.append(c_dephase)\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_3) * tensor(qeye(n_max), tensor(ops))\n    c_ops_3.append(c_emit)\n\n# Collective pumping: J_+ (raises all spins)\nJp_coll = tensor(qeye(n_max), 0*qeye(2**N))\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jp\n    Jp_i = tensor(qeye(n_max), tensor(ops))\n    Jp_coll = Jp_coll + Jp_i\nc_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp_coll)\n\nprint(f"Number of collapse operators: {len(c_ops_3)}")\nrho_ss_3 = steadystate(H, c_ops_3, method=\'direct\')\nprint("Steady state found for Case 3.")\n\n# Case 4: Local dephasing & local emission & collective emission\nprint("\\nCase 4: Local dephasing (γ_φ=0.01) & local emission (γ_↓=0.1) & collective emission (γ_Σ↓=0.1)")\ngamma_phi_4 = 0.01\ngamma_down_4 = 0.1\ngamma_coll_down_4 = 0.1\n\nc_ops_4 = [np.sqrt(kappa) * tensor(a, qeye(2**N))]  # Cavity loss\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_4) * tensor(qeye(n_max), tensor(ops))\n    c_ops_4.append(c_dephase)\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_4) * tensor(qeye(n_max), tensor(ops))\n    c_ops_4.append(c_emit)\n\n# Collective emission: J_- (lowers all spins)\nJm_coll = tensor(qeye(n_max), 0*qeye(2**N))\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = jm\n    Jm_i = tensor(qeye(n_max), tensor(ops))\n    Jm_coll = Jm_coll + Jm_i\nc_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm_coll)\n\nprint(f"Number of collapse operators: {len(c_ops_4)}")\nrho_ss_4 = steadystate(H, c_ops_4, method=\'direct\')\nprint("Steady state found for Case 4.")\n\nprint("\\nTracing out spin degrees of freedom...")\n\n# Trace out spins to get cavity density matrices\n# The full state is in Hilbert space of cavity (n_max) × spins (2^N)\n# We need to trace out the spin part\n\ndef get_cavity_state(rho_full, n_max, N):\n    """Trace out spins to get cavity density matrix"""\n    # rho_full is in the tensor product space: cavity × spins\n    # We want to trace out the spin part\n    rho_cavity = ptrace(rho_full, 0)  # Keep only cavity mode (index 0)\n    return rho_cavity\n\nrho_cav_1 = get_cavity_state(rho_ss_1, n_max, N)\nrho_cav_2 = get_cavity_state(rho_ss_2, n_max, N)\nrho_cav_3 = get_cavity_state(rho_ss_3, n_max, N)\nrho_cav_4 = get_cavity_state(rho_ss_4, n_max, N)\n\nprint("Cavity states extracted.")\n\nprint("\\nCalculating Wigner functions...")\n\n# Create grid for Wigner function\nxvec = np.linspace(-x_range, x_range, grid_points)\npvec = np.linspace(-p_range, p_range, grid_points)\n\n# Calculate Wigner functions\nW1 = wigner(rho_cav_1, xvec, pvec)\nW2 = wigner(rho_cav_2, xvec, pvec)\nW3 = wigner(rho_cav_3, xvec, pvec)\nW4 = wigner(rho_cav_4, xvec, pvec)\n\nprint(f"Wigner functions calculated on {grid_points}x{grid_points} grid.")\n\nprint("\\nSaving results to CSV files...")\n\n# Save Wigner functions as CSV\nnp.savetxt(\'1.csv\', W1, delimiter=\',\')\nnp.savetxt(\'2.csv\', W2, delimiter=\',\')\nnp.savetxt(\'3.csv\', W3, delimiter=\',\')\nnp.savetxt(\'4.csv\', W4, delimiter=\',\')\n\nprint("Results saved:")\nprint("  1.csv - Case 1: Local dephasing & local pumping")\nprint("  2.csv - Case 2: Local dephasing & local emission")\nprint("  3.csv - Case 3: Local dephasing & local emission & collective pumping")\nprint("  4.csv - Case 4: Local dephasing & local emission & collective emission")\n\nprint("\\nSimulation complete!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
