Sending keys: ['cat > /root/seismic_association.py << \'EOF\'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import UTCDateTime\nimport seisbench.models as sbm\nfrom scipy.spatial.distance import cdist\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Velocity model\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\ndef haversine_distance(lat1, lon1, lat2, lon2):\n    """Calculate distance in km between two points on Earth."""\n    R = 6371  # Earth\'s radius in km\n    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n    dlat = lat2 - lat1\n    dlon = lon2 - lon1\n    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\n    c = 2 * np.arcsin(np.sqrt(a))\n    return R * c\n\ndef load_data():\n    """Load waveform and station data."""\n    print("Loading waveform data...")\n    st = obspy.read(\'/root/data/wave.mseed\')\n    \n    print("Loading station data...")\n    stations_df = pd.read_csv(\'/root/data/stations.csv\')\n    \n    # Get unique stations with their locations\n    stations = stations_df.groupby([\'network\', \'station\']).first().reset_index()\n    stations = stations[[\'network\', \'station\', \'longitude\', \'latitude\', \'elevation_m\']]\n    \n    return st, stations\n\ndef pick_phases(st):\n    """Use PhaseNet to pick P and S phases."""\n    print("Loading PhaseNet model...")\n    model = sbm.PhaseNet.from_pretrained(\'instance\')\n    model.eval()\n    \n    picks = []\n    \n    # Group traces by station\n    station_traces = defaultdict(list)\n    for tr in st:\n        key = (tr.stats.network, tr.stats.station)\n        station_traces[key].append(tr)\n    \n    print(f"Processing {len(station_traces)} stations...")\n    \n    for (network, station), traces in station_traces.items():\n        # Create a stream for this station\n        station_st = obspy.Stream(traces)\n        \n        # Get 3-component data (E, N, Z)\n        try:\n            # Sort by channel to get consistent ordering\n            station_st.sort(keys=[\'channel\'])\n            \n            # Run PhaseNet\n            annotations = model.annotate(station_st)\n            \n            # Extract picks from annotations\n            picks_result = model.classify(station_st, P_threshold=0.3, S_threshold=0.3)\n            \n            for pick in picks_result:\n                picks.append({\n                    \'network\': network,\n                    \'station\': station,\n                    \'phase\': pick.phase,\n                    \'time\': pick.peak_time,\n                    \'probability\': pick.peak_value\n                })\n                \n        except Exception as e:\n            print(f"  Error processing {network}.{station}: {e}")\n            continue\n    \n    print(f"Total picks: {len(picks)}")\n    return picks\n\ndef associate_picks(picks, stations):\n    """Associate picks into earthquake events using a simple grid search."""\n    if len(picks) == 0:\n        return []\n    \n    picks_df = pd.DataFrame(picks)\n    picks_df[\'time_utc\'] = picks_df[\'time\'].apply(lambda x: UTCDateTime(x))\n    picks_df[\'time_float\'] = picks_df[\'time_utc\'].apply(lambda x: float(x))\n    \n    # Merge with station locations\n    picks_df = picks_df.merge(stations, on=[\'network\', \'station\'], how=\'left\')\n    \n    print(f"Picks with locations: {len(picks_df)}")\n    \n    # Get P picks for initial event detection\n    p_picks = picks_df[picks_df[\'phase\'] == \'P\'].copy()\n    s_picks = picks_df[picks_df[\'phase\'] == \'S\'].copy()\n    \n    print(f"P picks: {len(p_picks)}, S picks: {len(s_picks)}")\n    \n    if len(p_picks) == 0:\n        return []\n    \n    # Simple association: cluster P picks that are close in time\n    # considering travel time differences\n    p_picks = p_picks.sort_values(\'time_float\').reset_index(drop=True)\n    \n    events = []\n    used_picks = set()\n    \n    # Grid search over possible event locations and times\n    # Use station locations as candidate event locations\n    candidate_lats = np.linspace(stations[\'latitude\'].min() - 0.5, \n                                  stations[\'latitude\'].max() + 0.5, 20)\n    candidate_lons = np.linspace(stations[\'longitude\'].min() - 0.5, \n                                  stations[\'longitude\'].max() + 0.5, 20)\n    \n    # For each P pick, try to find an event\n    for idx, p_pick in p_picks.iterrows():\n        if idx in used_picks:\n            continue\n        \n        # Find other P picks within a reasonable time window\n        time_window = 30  # seconds - max travel time difference across network\n        nearby_p = p_picks[\n            (abs(p_picks[\'time_float\'] - p_pick[\'time_float\']) < time_window) &\n            (~p_picks.index.isin(used_picks))\n        ]\n        \n        if len(nearby_p) < 3:  # Need at least 3 stations for a reliable event\n            continue\n        \n        # Try to find best origin time and location\n        best_origin = None\n        best_residual = float(\'inf\')\n        best_associated = []\n        \n        for lat in candidate_lats:\n            for lon in candidate_lons:\n                # Calculate expected travel times\n                distances = []\n                for _, pick in nearby_p.iterrows():\n                    dist = haversine_distance(lat, lon, pick[\'latitude\'], pick[\'longitude\'])\n                    distances.append(dist)\n                \n                # Expected P arrival times relative to first arrival\n                travel_times = np.array(distances) / VP\n                \n                # Try different origin times\n                for _, ref_pick in nearby_p.head(5).iterrows():\n                    ref_dist = haversine_distance(lat, lon, ref_pick[\'latitude\'], ref_pick[\'longitude\'])\n                    origin_time = ref_pick[\'time_float\'] - ref_dist / VP\n                    \n                    # Calculate residuals\n                    residuals = []\n                    associated = []\n                    for pick_idx, pick in nearby_p.iterrows():\n                        dist = haversine_distance(lat, lon, pick[\'latitude\'], pick[\'longitude\'])\n                        expected_time = origin_time + dist / VP\n                        residual = abs(pick[\'time_float\'] - expected_time)\n                        if residual < 3.0:  # 3 second tolerance\n                            residuals.append(residual)\n                            associated.append(pick_idx)\n                    \n                    if len(associated) >= 3:\n                        mean_residual = np.mean(residuals)\n                        if mean_residual < best_residual:\n                            best_residual = mean_residual\n                            best_origin = origin_time\n                            best_associated = associated\n        \n        if best_origin is not None and len(best_associated) >= 3:\n            events.append({\n                \'time\': UTCDateTime(best_origin),\n                \'num_picks\': len(best_associated),\n                \'residual\': best_residual\n            })\n            used_picks.update(best_associated)\n            print(f"  Event at {UTCDateTime(best_origin)} with {len(best_associated)} picks, residual={best_residual:.2f}s")\n    \n    return events\n\ndef main():\n    # Load data\n    st, stations = load_data()\n    print(f"Loaded {len(st)} traces from {len(stations)} stations")\n    \n    # Pick phases\n    picks = pick_phases(st)\n    \n    # Associate picks into events\n    print("\\nAssociating picks into events...")\n    events = associate_picks(picks, stations)\n    \n    print(f"\\nFound {len(events)} events")\n    \n    # Write results\n    if events:\n        results_df = pd.DataFrame(events)\n        results_df[\'time\'] = results_df[\'time\'].apply(lambda x: x.strftime(\'%Y-%m-%dT%H:%M:%S.%f\')[:-3])\n        results_df.to_csv(\'/root/results.csv\', index=False)\n        print(f"\\nResults written to /root/results.csv")\n        print(results_df)\n    else:\n        # Write empty results\n        pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n        print("No events found, empty results written.")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
