Sending keys: ['cat << \'EOF\' > create_audiobook.py\nimport os\nimport requests\nfrom bs4 import BeautifulSoup\nfrom openai import OpenAI\nimport subprocess\n\nclient = OpenAI()\n\nurls = [\n    "https://paulgraham.com/ds.html",\n    "https://paulgraham.com/foundermode.html"\n]\n\ndef get_essay_text(url):\n    try:\n        response = requests.get(url)\n        response.raise_for_status()\n        soup = BeautifulSoup(response.content, \'html.parser\')\n        # Paul Graham\'s essays are typically in <font face="verdana"> tags\n        fonts = soup.find_all(\'font\', face=\'verdana\')\n        if not fonts:\n            return ""\n        # Heuristic: The essay is likely the font tag with the most text\n        essay_font = max(fonts, key=lambda f: len(f.get_text()))\n        text = essay_font.get_text()\n        # Basic cleaning\n        return text.strip()\n    except Exception as e:\n        print(f"Error fetching {url}: {e}")\n        return ""\n\ndef split_text(text, max_length=4000):\n    # Split by sentences to avoid cutting words\n    sentences = text.replace(\'\\n\', \' \').split(\'. \')\n    chunks = []\n    current_chunk = ""\n    \n    for sentence in sentences:\n        # Add the period back\n        sentence = sentence.strip() + ". "\n        if len(current_chunk) + len(sentence) > max_length:\n            chunks.append(current_chunk)\n            current_chunk = sentence\n        else:\n            current_chunk += sentence\n            \n    if current_chunk:\n        chunks.append(current_chunk)\n    return chunks\n\naudio_files = []\n\nfor i, url in enumerate(urls):\n    print(f"Processing {url}...")\n    text = get_essay_text(url)\n    if not text:\n        print(f"Skipping {url} (no text found)")\n        continue\n        \n    print(f"Found {len(text)} characters.")\n    chunks = split_text(text)\n    print(f"Split into {len(chunks)} chunks.")\n    \n    for j, chunk in enumerate(chunks):\n        if not chunk.strip(): continue\n        filename = f"part_{i}_{j}.mp3"\n        print(f"Generating audio for chunk {j+1}/{len(chunks)} of essay {i+1}...")\n        \n        try:\n            response = client.audio.speech.create(\n                model="tts-1",\n                voice="alloy",\n                input=chunk\n            )\n            # Save to file\n            with open(filename, \'wb\') as f:\n                f.write(response.content)\n            audio_files.append(filename)\n        except Exception as e:\n            print(f"Error generating audio: {e}")\n\nif not audio_files:\n    print("No audio files generated.")\n    exit(1)\n\n# Create file list for ffmpeg\nlist_filename = "files.txt"\nwith open(list_filename, "w") as f:\n    for filename in audio_files:\n        f.write(f"file \'{os.path.abspath(filename)}\'\\n")\n\noutput_file = "/root/audiobook.mp3"\nprint(f"Concatenating to {output_file}...")\n\n# Use ffmpeg to concatenate\nsubprocess.run(\n    ["ffmpeg", "-f", "concat", "-safe", "0", "-i", list_filename, "-c", "copy", output_file, "-y"],\n    check=True\n)\n\n# Cleanup temporary files\nfor f in audio_files:\n    if os.path.exists(f):\n        os.remove(f)\nif os.path.exists(list_filename):\n    os.remove(list_filename)\n\nprint("Task complete!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
