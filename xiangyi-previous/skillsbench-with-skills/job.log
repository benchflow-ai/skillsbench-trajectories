ched[(curr_j, curr_o-1)][\'end\'] if curr_o > 0 else 0\n        for m, dur in jobs_data[curr_j][curr_o].items():\n            t = e_s\n            while True:\n                if all(not (t+dur > it[\'start\'] and t < it[\'end\']) for it in sched.values() if it[\'machine\'] == m) and all(not (t+dur > d[\'s\'] and t < d[\'e\']) for d in downtimes if d[\'m\'] == m):\n                    break\n                t += 1\n            if t < best_s or (t == best_s and m == bl_m):\n                best_s, best_m = t, m\n        sched[(curr_j, curr_o)] = {\'job\': curr_j, \'op\': curr_o, \'machine\': best_m, \'start\': best_s, \'end\': best_s + jobs_data[curr_j][curr_o][best_m], \'dur\': jobs_data[curr_j][curr_o][best_m]}\n    final = sorted(sched.values(), key=lambda x: (x[\'start\'], x[\'machine\']))\n    res = {"status": "OPTIMIZED", "makespan": max(it[\'end\'] for it in final), "schedule": final}\n    with open(\'/app/output/solution.json\', \'w\') as f: json.dump(res, f, indent=2)\n    with open(\'/app/output/schedule.csv\', \'w\', newline=\'\') as f:\n        w = csv.DictWriter(f, fieldnames=[\'job\', \'op\', \'machine\', \'start\', \'end\', \'dur\'])\n        w.writeheader(); w.writerows(final)\n    print(f"Makespan: {res[\'makespan\']}")\nsolve()\nEOF\npython3 solve.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
