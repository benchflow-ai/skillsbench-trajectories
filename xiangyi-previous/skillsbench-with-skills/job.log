Sending keys: ['cat > /tmp/simple_dc_opf.py << \'EOFSCRIPT\'\nimport json\nimport numpy as np\nfrom scipy.optimize import LinearConstraint, Bounds, minimize\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load network data\nwith open(\'/root/network.json\', \'r\') as f:\n    data = json.load(f)\n\nbase_mva = data[\'baseMVA\']\nbus_data = np.array(data[\'bus\'])\ngen_data = np.array(data[\'gen\'])\nbranch_data = np.array(data[\'branch\'])\ngencost_data = np.array(data[\'gencost\'])\n\nBUS_I, BUS_TYPE, PD = 0, 1, 2\nGEN_BUS, GEN_PMAX, GEN_PMIN = 0, 8, 9\nBR_FBUS, BR_TBUS, BR_X, BR_STATUS = 0, 1, 3, 10\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\nnum_branch = len(branch_data)\n\nprint(f"Simple DC-OPF")\n\n# Bus mapping\nbus_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_buses = np.array([bus_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)])\n\n# Slack bus\nslack_idx = np.where(bus_data[:, BUS_TYPE] == 3)[0][0]\nnon_slack = np.where(np.arange(num_bus) != slack_idx)[0]\n\nprint(f"Buses: {num_bus}, Generators: {num_gen}, Slack: {slack_idx}")\n\n# Build B matrix\nB = np.zeros((num_bus, num_bus))\nfor b in range(num_branch):\n    if branch_data[b, BR_STATUS] == 0:\n        continue\n    fbus = bus_map.get(int(branch_data[b, BR_FBUS]))\n    tbus = bus_map.get(int(branch_data[b, BR_TBUS]))\n    if fbus is None or tbus is None:\n        continue\n    x = branch_data[b, BR_X]\n    if x == 0:\n        continue\n    b_val = 1.0 / x\n    B[fbus, fbus] += b_val\n    B[tbus, tbus] += b_val\n    B[fbus, tbus] -= b_val\n    B[tbus, fbus] -= b_val\n\nB_red = B[np.ix_(non_slack, non_slack)]\nB_slack = B[np.ix_(non_slack, [slack_idx])].flatten()\n\n# Generation matrix\nC = np.zeros((len(non_slack), num_gen))\nfor g in range(num_gen):\n    bus_idx = gen_buses[g]\n    if bus_idx in non_slack:\n        row = np.where(non_slack == bus_idx)[0][0]\n        C[row, g] = 1.0\n\n# Load\np_load = bus_data[non_slack, PD] / base_mva\n\nprint(f"Total load: {p_load.sum() * base_mva:.2f} MW")\n\n# Objective function\ndef objective(pg_pu):\n    cost = 0\n    for i in range(num_gen):\n        n = int(gencost_data[i, 3])\n        c = gencost_data[i, 4:4+n]\n        for k, coeff in enumerate(c):\n            power = n - 1 - k\n            if power > 0:\n                cost += coeff * (pg_pu[i] ** power)\n            else:\n                cost += coeff\n    return cost\n\n# Power balance constraint function\ndef constraint_func(pg_pu):\n    # C @ pg = B_red @ theta + p_load\n    # Solve for theta: theta = inv(B_red) @ (C @ pg - p_load)\n    lhs = C @ pg_pu - p_load\n    try:\n        theta = np.linalg.solve(B_red, lhs)\n        return lhs - B_red @ theta  # Should be zero\n    except:\n        return np.ones(len(non_slack)) * 1e10\n\n# Initial point\npg0_pu = np.ones(num_gen) * 0.5\nfor i in range(num_gen):\n    pg0_pu[i] = min(gen_data[i, GEN_PMAX] / base_mva, 0.5)\n\n# Bounds\nlb = gen_data[:, GEN_PMIN] / base_mva\nub = gen_data[:, GEN_PMAX] / base_mva\nbounds = Bounds(lb, ub)\n\n# Constraint\nfrom scipy.optimize import NonlinearConstraint\nconstraint = NonlinearConstraint(constraint_func, np.zeros(len(non_slack)), np.zeros(len(non_slack)))\n\nprint("Solving...")\nresult = minimize(objective, pg0_pu, method=\'SLSQP\', bounds=bounds,\n                 constraints={\'type\': \'eq\', \'fun\': constraint_func},\n                 options={\'maxiter\': 500, \'ftol\': 1e-6})\n\nprint(f"Status: {result.success}")\nif result.success:\n    pg_opt = result.x * base_mva\n    print(f"Cost: ${result.fun:.2f}")\n    print(f"Total gen: {pg_opt.sum():.2f} MW")\n    print(f"Total load: {p_load.sum() * base_mva:.2f} MW")\n    \n    # Save\n    np.savez(\'/tmp/opf_sol.npz\', pg=pg_opt, bus_data=bus_data, gen_data=gen_data,\n             gen_buses=gen_buses, slack_idx=slack_idx, cost=result.fun)\n    print("Solution saved!")\nelse:\n    print(f"Failed: {result.message}")\n\nEOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
