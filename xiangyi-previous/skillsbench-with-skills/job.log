dx, BR_R]\n    x = branch_data[b_idx, BR_X]\n    \n    if x == 0:\n        continue\n    \n    b_line = 1.0 / x\n    \n    B[fbus, fbus] += b_line\n    B[tbus, tbus] += b_line\n    B[fbus, tbus] -= b_line\n    B[tbus, fbus] -= b_line\n\n# Remove slack bus row/column for DC-OPF\nnon_slack = [i for i in range(num_bus) if i != slack_bus_idx]\nB_reduced = B[np.ix_(non_slack, non_slack)]\n\nprint(f"Admittance matrix built (size {len(non_slack)}x{len(non_slack)})")\n\n# DC-OPF formulation\n# Variables\npg = cp.Variable(num_gen)  # Real power generation\ntheta = cp.Variable(len(non_slack))  # Bus voltage angles (slack angle = 0)\n\n# Objective: minimize generation cost\ncost = 0\nfor i in range(num_gen):\n    if int(gencost_data[i, 0]) == 2:  # Polynomial cost\n        n = int(gencost_data[i, 3])\n        if n >= 2:\n            c2 = gencost_data[i, 4]\n            c1 = gencost_data[i, 5] if n >= 2 else 0\n            c0 = gencost_data[i, 6] if n >= 3 else 0\n            cost += c2 * pg[i]**2 + c1 * pg[i] + c0\n        elif n == 1:\n            c1 = gencost_data[i, 4]\n            c0 = gencost_data[i, 5] if n >= 2 else 0\n            cost += c1 * pg[i] + c0\n    else:\n        # Piecewise linear\n        cost += gencost_data[i, 4] * pg[i]\n\n# Constraints\nconstraints = []\n\n# Generator limits\nfor i in range(num_gen):\n    constraints.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)\n    constraints.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)\n\n# Power balance (DC approximation)\nfor idx, bus_idx in enumerate(non_slack):\n    # Load\n    p_load = bus_data[bus_idx, PD] / base_mva\n    \n    # Generation at this bus\n    p_gen = 0\n    for g_idx in range(num_gen):\n        if gen_bus_indices[g_idx] == bus_idx:\n            p_gen = p_gen + pg[g_idx]\n    \n    # Power flow equation: sum of flows = generation - load\n    # For DC-OPF: P_ij = B_ij * (theta_i - theta_j)\n    flow_sum = 0\n    for b_idx in range(num_branch):\n        if int(branch_data[b_idx, BR_STATUS]) == 0:\n            continue\n        \n        fbus_id = int(branch_data[b_idx, BR_FBUS])\n        tbus_id = int(branch_data[b_idx, BR_TBUS])\n        \n        if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\n            continue\n        \n        fbus = bus_idx_map[fbus_id]\n        tbus = bus_idx_map[tbus_id]\n        \n        r = branch_data[b_idx, BR_R]\n        x = branch_data[b_idx, BR_X]\n        \n        if x == 0:\n            continue\n        \n        b_line = 1.0 / x\n        \n        if fbus == bus_idx:\n            # From this bus\n            if tbus == slack_bus_idx:\n                flow_sum = flow_sum + b_line * theta[idx]\n            else:\n                tbus_idx = non_slack.index(tbus)\n                flow_sum = flow_sum + b_line * (theta[idx] - theta[tbus_idx])\n        elif tbus == bus_idx:\n            # To this bus\n            if fbus == slack_bus_idx:\n                flow_sum = flow_sum - b_line * theta[idx]\n            else:\n                fbus_idx = non_slack.index(fbus)\n                flow_sum = flow_sum + b_line * (theta[idx] - theta[fbus_idx])\n    \n    constraints.append(p_gen - p_load == flow_sum)\n\n# Solve\nprint("Solving DC-OPF...")\nproblem = cp.Problem(cp.Minimize(cost), constraints)\nproblem.solve(solver=cp.ECOS, verbose=False)\n\nprint(f"Status: {problem.status}")\nprint(f"Optimal cost: {problem.value:.2f}")\n\n# Extract results\npg_opt = np.array(pg.value) * base_mva\ntheta_opt = np.array(theta.value) * 180 / np.pi\n\nprint(f"Total generation: {pg_opt.sum():.2f} MW")\nprint(f"Total load: {bus_data[:, PD].sum():.2f} MW")\n\n# Store results for later use\nresults = {\n    \'pg\': pg_opt,\n    \'theta\': theta_opt,\n    \'slack_idx\': slack_bus_idx,\n    \'non_slack\': non_slack,\n    \'cost\': problem.value\n}\n\nnp.save(\'/tmp/dc_opf_results.npy\', results, allow_pickle=True)\nprint("\\nResults saved!")\n\nEOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
