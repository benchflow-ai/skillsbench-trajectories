ict[emp_id]\n    for field in old_df.columns:\n        if field == 'ID':\n            continue\n        old_val = old_rec.get(field)\n        new_val = new_rec.get(field)\n        # compare with NaN handling\n        if pd.isna(old_val) and pd.isna(new_val):\n            continue\n        if isinstance(old_val, float) and isinstance(new_val, float):\n            # compare numeric\n            if pd.isna(old_val) and pd.isna(new_val):\n                continue\n        if old_val != new_val:\n            # cast values for json: numbers as int if integer\n            def cast(v):\n                if pd.isna(v):\n                    return None\n                if isinstance(v, (int, float)):\n                    # check if integer-valued\n                    if isinstance(v, float) and v.is_integer():\n                        return int(v)\n                    return float(v) if isinstance(v, float) else v\n                return v\n            modified.append({\n                'id': emp_id,\n                'field': field,\n                'old_value': cast(old_val),\n                'new_value': cast(new_val)\n            })\n\n# sort modified by id then field\nmodified = sorted(modified, key=lambda x: (x['id'], x['field']))\n\nreport = {\n    'deleted_employees': deleted,\n    'modified_employees': modified\n}\n\nwith open('/root/diff_report.json','w') as f:\n    json.dump(report, f, indent=2)\n\nprint('deleted', deleted[:5], 'modified count', len(modified))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
