'].rolling(window=3).std()\ngold_data[\'Vol_12m\'] = gold_data[\'LogReturn\'].rolling(window=12).std()\n\nlatest_row = gold_data.iloc[-1]\nvol_3m_latest = latest_row[\'Vol_3m\']\nvol_12m_latest = latest_row[\'Vol_12m\']\nvol_3m_annualized = vol_3m_latest * np.sqrt(12)\n\ngold_2025 = gold_data[gold_data.index.year == 2025]\ngold_2025_jan_sep = gold_2025[gold_2025.index.month <= 9]\navg_gold_2025 = gold_2025_jan_sep[\'Price\'].mean() if not gold_2025_jan_sep.empty else gold_data.iloc[-12:][\'Price\'].mean()\n\nprint(f"Stats: Vol3m={vol_3m_latest}, Vol12m={vol_12m_latest}, Avg2025={avg_gold_2025}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
