Sending keys: ['python3 << \'ENDSCRIPT\'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\ntc = pd.read_csv(\'/app/data/thermocouples.csv\')\n\n# Handbook specifications:\n# Preheat zone: 100°C to 150°C\n# Ramp rate limit: < 2°C/second (so max allowed is 2.0)\n# Use largest_mass thermocouple\n\nPREHEAT_MIN = 100.0\nPREHEAT_MAX = 150.0\nRAMP_LIMIT = 2.0  # °C/second\n\n# Filter for largest_mass thermocouple only\ntc_largest = tc[tc[\'tc_location\'] == \'largest_mass\'].copy()\n\ndef calculate_max_preheat_ramp(run_data):\n    """Calculate max ramp rate during preheat phase (100-150°C)"""\n    run_data = run_data.sort_values(\'time_s\')\n    \n    # Find data points in preheat range\n    preheat_data = run_data[(run_data[\'temp_c\'] >= PREHEAT_MIN) & (run_data[\'temp_c\'] <= PREHEAT_MAX)]\n    \n    if len(preheat_data) < 2:\n        return None, None\n    \n    # Calculate ramp rates between consecutive points\n    temps = preheat_data[\'temp_c\'].values\n    times = preheat_data[\'time_s\'].values\n    \n    max_ramp = 0.0\n    for i in range(1, len(temps)):\n        dt = times[i] - times[i-1]\n        if dt > 0:\n            ramp = (temps[i] - temps[i-1]) / dt\n            if ramp > max_ramp:\n                max_ramp = ramp\n    \n    tc_id = run_data[\'tc_id\'].iloc[0]\n    return tc_id, round(max_ramp, 2)\n\n# Calculate for each run\nresults = {}\nviolating_runs = []\n\nfor run_id in sorted(tc_largest[\'run_id\'].unique()):\n    run_data = tc_largest[tc_largest[\'run_id\'] == run_id]\n    tc_id, max_ramp = calculate_max_preheat_ramp(run_data)\n    \n    if max_ramp is not None:\n        results[run_id] = {\n            \'tc_id\': tc_id,\n            \'max_preheat_ramp_c_per_s\': max_ramp\n        }\n        if max_ramp > RAMP_LIMIT:\n            violating_runs.append(run_id)\n\n# Create output\noutput = {\n    \'ramp_rate_limit_c_per_s\': RAMP_LIMIT,\n    \'violating_runs\': sorted(violating_runs),\n    \'max_ramp_by_run\': results\n}\n\nprint(json.dumps(output, indent=2))\n\n# Save to file\nwith open(\'/app/output/q01.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint("\\nSaved to /app/output/q01.json")\nprint(f"\\nViolating runs: {len(violating_runs)}")\nENDSCRIPT\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
