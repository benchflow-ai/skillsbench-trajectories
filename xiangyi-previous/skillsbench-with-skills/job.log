Sending keys: ["python3 - <<'PY'\nimport pdfplumber, pandas as pd, json, re\npdf_path='/root/employees_backup.pdf'\nrows=[]\nheader=None\nwith pdfplumber.open(pdf_path) as pdf:\n    for page in pdf.pages:\n        tables = page.extract_tables()\n        for t in tables:\n            if not t:\n                continue\n            # determine header\n            if header is None:\n                header = t[0]\n            # skip header row if present\n            start = 1 if t and t[0] and t[0][0]=='ID' else 0\n            for row in t[start:]:\n                if not row:\n                    continue\n                if row[0] and re.match(r'^EMP\\d{5}$', row[0]):\n                    rows.append(row)\n\nold_df = pd.DataFrame(rows, columns=header)\n\ncur_df = pd.read_excel('/root/employees_current.xlsx')\n\n# normalize column names\nold_df.columns = [c.strip() for c in old_df.columns]\ncur_df.columns = [c.strip() for c in cur_df.columns]\n\nnum_fields = ['Salary','Years','Score']\nfor df in (old_df, cur_df):\n    for field in num_fields:\n        if field in df.columns:\n            df[field] = df[field].astype(str).str.replace(',','', regex=False)\n            df[field] = pd.to_numeric(df[field], errors='coerce')\n    for col in df.columns:\n        if col not in num_fields:\n            df[col] = df[col].astype(str)\n\nold_dict = old_df.set_index('ID').to_dict(orient='index')\ncur_dict = cur_df.set_index('ID').to_dict(orient='index')\n\nold_ids = set(old_dict)\ncur_ids = set(cur_dict)\n\ndeleted = sorted(old_ids - cur_ids)\n\nmodified = []\nfor emp_id in sorted(old_ids & cur_ids):\n    old_rec = old_dict[emp_id]\n    new_rec = cur_dict[emp_id]\n    for field in old_df.columns:\n        if field == 'ID':\n            continue\n        old_val = old_rec.get(field)\n        new_val = new_rec.get(field)\n        if pd.isna(old_val) and pd.isna(new_val):\n            continue\n        if old_val != new_val:\n            def cast(v):\n                if pd.isna(v):\n                    return None\n                if isinstance(v, (int, float)):\n                    if isinstance(v, float) and v.is_integer():\n                        return int(v)\n                    return float(v) if isinstance(v, float) else v\n                return v\n            modified.append({\n                'id': emp_id,\n                'field': field,\n                'old_value': cast(old_val),\n                'new_value': cast(new_val)\n            })\n\nmodified = sorted(modified, key=lambda x: (x['id'], x['field']))\n\nreport = {'deleted_employees': deleted, 'modified_employees': modified}\nwith open('/root/diff_report.json','w') as f:\n    json.dump(report, f, indent=2)\n\nprint('deleted count', len(deleted), 'modified count', len(modified))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
