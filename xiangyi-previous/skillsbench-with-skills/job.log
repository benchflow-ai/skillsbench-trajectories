0706\n\n# Add Dots formula for each row\nfor row_idx in range(2, data_sheet.max_row + 1):\n    # Formula: ROUND(IF(B{row}="M", 500/((-307.75076)+(24.0900756)*C{row}+(-0.1918759221)*C{row}^2+(0.0007391293)*C{row}^3+(-0.000001093)*C{row}^4)*G{row}, 500/((-57.96288)+(13.6175032)*C{row}+(-0.1126655495)*C{row}^2+(0.0005158568)*C{row}^3+(-0.0000010706)*C{row}^4)*G{row}), 3)\n    \n    # Men\'s formula component\n    men_denom = f"((-307.75076)+(24.0900756)*C{row_idx}+(-0.1918759221)*C{row_idx}^2+(0.0007391293)*C{row_idx}^3+(-0.000001093)*C{row_idx}^4)"\n    men_formula = f"500/{men_denom}*G{row_idx}"\n    \n    # Women\'s formula component  \n    women_denom = f"((-57.96288)+(13.6175032)*C{row_idx}+(-0.1126655495)*C{row_idx}^2+(0.0005158568)*C{row_idx}^3+(-0.0000010706)*C{row_idx}^4)"\n    women_formula = f"500/{women_denom}*G{row_idx}"\n    \n    # Combined IF formula with ROUND\n    formula = f\'=ROUND(IF(B{row_idx}="M",{men_formula},{women_formula}),3)\'\n    \n    dots_sheet.cell(row=row_idx, column=dots_col, value=formula)\n\nprint(f"Added Dots column with formulas")\n\n# Save the workbook\nwb.save(\'/root/data/openipf.xlsx\')\nprint("\\nWorkbook saved successfully!")\n\nwb.close()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
