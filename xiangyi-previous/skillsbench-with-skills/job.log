Sending keys: ['python3 << \'SCRIPT\'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook(\'test - demand.xlsx\')\nws_na = wb[\'NA\']\n\nprint("Updating NA sheet - Scenario 1...")\n\n# Link Real GDP from WEO_Data (column C in NA = column B in WEO_Data)\nfor year in range(2020, 2043):\n    row = year - 2020 + 3  # Row 3 for 2020, etc.\n    weo_row = year - 2020 + 2  # WEO starts at row 2\n    ws_na[f\'C{row}\'] = f\'=WEO_Data!B{weo_row}\'\n    ws_na[f\'J{row}\'] = f\'=WEO_Data!E{weo_row}\'\n\nprint("Linked Real GDP and Baseline Growth from WEO_Data")\n\n# Assumptions section\nws_na[\'D30\'] = 6.5  # Total investment in billion USD\nws_na[\'D31\'] = \'="SUT Calc"!C46\'  # Import content share from SUT Calc\nws_na[\'D32\'] = 0.8  # Demand multiplier\nws_na[\'D33\'] = \'Bell shape\'  # Project allocation\n\n# Exchange rate (using cell reference for flexibility)\nws_na[\'C29\'] = \'Exchange rate (Lari/USD)\'\nws_na[\'D29\'] = 2.746\n\nprint("Added assumptions")\n\n# Project allocation - bell shape over 8 years (2026-2033)\n# Bell shape: lower at start/end, higher in middle\nbell_allocation = [0.05, 0.10, 0.20, 0.30, 0.20, 0.10, 0.04, 0.01]  # Sums to 1.0\n\nfor i, year in enumerate(range(2026, 2034)):\n    row = year - 2020 + 3\n    ws_na[f\'D{row}\'] = bell_allocation[i]\n\n# For other years, allocation is 0\nfor year in list(range(2020, 2026)) + list(range(2034, 2043)):\n    row = year - 2020 + 3\n    ws_na[f\'D{row}\'] = 0\n\nprint("Added bell-shaped project allocation")\n\n# Project Investment in billion Lari = allocation * total investment * exchange rate\nfor year in range(2020, 2043):\n    row = year - 2020 + 3\n    ws_na[f\'E{row}\'] = f\'=D{row}*$D$30*$D$29\'\n\nprint("Added project investment formulas")\n\n# Imports = Project Investment * import content share\nfor year in range(2020, 2043):\n    row = year - 2020 + 3\n    ws_na[f\'F{row}\'] = f\'=E{row}*$D$31\'\n\nprint("Added imports formulas")\n\n# GDP impact (I-M) = (Project Investment - Imports) * Multiplier\nfor year in range(2020, 2043):\n    row = year - 2020 + 3\n    ws_na[f\'G{row}\'] = f\'=(E{row}-F{row})*$D$32\'\n\nprint("Added GDP impact formulas")\n\n# % of GDP\nfor year in range(2020, 2043):\n    row = year - 2020 + 3\n    ws_na[f\'I{row}\'] = f\'=G{row}/C{row}*100\'\n\nprint("Added % of GDP formulas")\n\n# Projected Growth = Baseline Growth + % of GDP\nfor year in range(2020, 2043):\n    row = year - 2020 + 3\n    ws_na[f\'K{row}\'] = f\'=J{row}+I{row}\'\n\nprint("Added projected growth formulas")\n\nwb.save(\'test - demand.xlsx\')\nprint("Scenario 1 completed")\nSCRIPT\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
