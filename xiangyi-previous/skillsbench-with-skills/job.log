Sending keys: ["cat <<EOF > /app/prepare_causal_data.py\nimport pandas as pd\nimport numpy as np\nimport os\n\n# Paths\npurchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'\nanomaly_path = '/app/output/category_anomaly_index.csv'\nsurvey_path = '/app/output/survey_cleaned.csv'\noutput_dir = '/app/output/'\n\nprint('Loading data...')\npurchase_df = pd.read_csv(purchase_path)\nanomaly_df = pd.read_csv(anomaly_path)\nsurvey_df = pd.read_csv(survey_path)\n\n# Get Top 10 Surge and Slump Categories\nsurge_cats = anomaly_df.sort_values('Anomaly_Index', ascending=False).head(10)['Category'].tolist()\nslump_cats = anomaly_df.sort_values('Anomaly_Index', ascending=True).head(10)['Category'].tolist()\ntarget_cats = surge_cats + slump_cats\n\nprint(f'Target categories: {len(target_cats)}')\n\n# Filter purchase data for relevant dates and categories\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])\n\n# Define periods\nbaseline_start = pd.to_datetime('2020-01-01')\nbaseline_end = pd.to_datetime('2020-02-29')\ntreatment_start = pd.to_datetime('2020-03-01')\ntreatment_end = pd.to_datetime('2020-03-31')\n\n# Create Period column\npurchase_df['Period'] = np.nan\npurchase_df.loc[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end), 'Period'] = 'Baseline'\npurchase_df.loc[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end), 'Period'] = 'Treatment'\n\n# Filter to valid periods and target categories\nfiltered_df = purchase_df.dropna(subset=['Period'])\nfiltered_df = filtered_df[filtered_df['Category'].isin(target_cats)]\n\n# We need a Cartesian product of Users x Categories x Periods to ensure 0s are recorded\nusers = survey_df['Survey ResponseID'].unique()\nperiods = ['Baseline', 'Treatment']\n\n# Create skeleton dataframe\nimport itertools\nskeleton = pd.DataFrame(list(itertools.product(users, target_cats, periods)), columns=['Survey ResponseID', 'Category', 'Period'])\n\n# Aggregate actual spend\nagg_spend = filtered_df.groupby(['Survey ResponseID', 'Category', 'Period'])['Total Spend'].sum().reset_index()\n\n# Merge with skeleton\nfinal_df = skeleton.merge(agg_spend, on=['Survey ResponseID', 'Category', 'Period'], how='left')\nfinal_df['Total Spend'] = final_df['Total Spend'].fillna(0)\n\n# Create Extensive Margin (Has_Purchase)\nfinal_df['Has_Purchase'] = (final_df['Total Spend'] > 0).astype(int)\n\n# Save Intensive\nprint('Saving intensive margin data...')\nintensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Total Spend']\nfinal_df[intensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_intensive.csv'), index=False)\n\n# Save Extensive\nprint('Saving extensive margin data...')\nextensive_cols = ['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']\nfinal_df[extensive_cols].to_csv(os.path.join(output_dir, 'user_category_period_aggregated_extensive.csv'), index=False)\n\nprint('Data preparation complete.')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
