Sending keys: ['cat << \'EOF\' > solve_market.py\nimport json\nimport numpy as np\nfrom cvxopt import matrix, solvers, sparse, spmatrix\n\ndef solve_dc_opf(network, line_relax=None):\n    baseMVA = network[\'baseMVA\']\n    buses = network[\'bus\']\n    gens = network[\'gen\']\n    branches = network[\'branch\']\n    gencost = network[\'gencost\']\n    res_cap = network[\'reserve_capacity\']\n    res_req = network[\'reserve_requirement\']\n\n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n    \n    bus_map = {int(b[0]): i for i, b in enumerate(buses)}\n    \n    Pd = np.array([b[2] for b in buses]) / baseMVA\n    \n    # Variables: [Pg (num_gens), R (num_gens), theta (num_buses)]\n    n_vars = num_gens + num_gens + num_buses\n    \n    # Objective: minimize c1 * Pg\n    c = np.zeros(n_vars)\n    for i in range(num_gens):\n        c[i] = gencost[i][4] * baseMVA # c1 is at index 4 if NCOST=3 and MODEL=2? Wait, let\'s re-check.\n        # Wait, previous check showed [2.0, 0.0, 0.0, 3.0, 0.0, 20.344902, 0.0]\n        # Index 0: 2.0 (MODEL)\n        # Index 1: 0.0 (STARTUP)\n        # Index 2: 0.0 (SHUTDOWN)\n        # Index 3: 3.0 (NCOST)\n        # Index 4: 0.0 (c2)\n        # Index 5: 20.344902 (c1)\n        # Index 6: 0.0 (c0)\n        c[i] = gencost[i][5] * baseMVA\n\n    # Equality constraints: A_eq * x = b_eq\n    # 1. Power balance: B * theta - Pg_at_bus = -Pd\n    # 2. Reference bus: theta[0] = 0\n    \n    # Construct B matrix as sparse\n    B_vals = []\n    B_rows = []\n    B_cols = []\n    for br in branches:\n        if br[10] > 0:\n            f = bus_map[int(br[0])]\n            t = bus_map[int(br[1])]\n            x = br[3]\n            b_val = 1.0 / x\n            # Diagonal f,f\n            B_vals.append(b_val); B_rows.append(f); B_cols.append(f)\n            # Diagonal t,t\n            B_vals.append(b_val); B_rows.append(t); B_cols.append(t)\n            # Off-diagonal f,t\n            B_vals.append(-b_val); B_rows.append(f); B_cols.append(t)\n            # Off-diagonal t,f\n            B_vals.append(-b_val); B_rows.append(t); B_cols.append(f)\n\n    # A_eq components\n    # theta part (B * theta)\n    A_eq_vals = B_vals\n    A_eq_rows = B_rows\n    A_eq_cols = [2*num_gens + c for c in B_cols]\n    \n    # Pg part (-Pg_at_bus)\n    for i, g in enumerate(gens):\n        bus_idx = bus_map[int(g[0])]\n        A_eq_vals.append(-1.0)\n        A_eq_rows.append(bus_idx)\n        A_eq_cols.append(i)\n        \n    # Reference bus constraint\n    A_eq_vals.append(1.0)\n    A_eq_rows.append(num_buses)\n    A_eq_cols.append(2*num_gens + 0)\n    \n    A_eq = spmatrix(A_eq_vals, A_eq_rows, A_eq_cols, (num_buses + 1, n_vars))\n    b_eq = matrix(np.concatenate([-Pd, [0.0]]))\n\n    # Inequality constraints: G * x <= h\n    G_vals = []\n    G_rows = []\n    G_cols = []\n    h = []\n    \n    curr_row = 0\n    # Pg + R <= Pmax\n    for i in range(num_gens):\n        G_vals.extend([1.0, 1.0])\n        G_rows.extend([curr_row, curr_row])\n        G_cols.extend([i, num_gens + i])\n        h.append(gens[i][8] / baseMVA)\n        curr_row += 1\n        \n    # -Pg <= -Pmin\n    for i in range(num_gens):\n        G_vals.append(-1.0)\n        G_rows.append(curr_row)\n        G_cols.append(i)\n        h.append(-gens[i][9] / baseMVA)\n        curr_row += 1\n        \n    # R <= Rmax\n    for i in range(num_gens):\n        G_vals.append(1.0)\n        G_rows.append(curr_row)\n        G_cols.append(num_gens + i)\n        h.append(res_cap[i] / baseMVA)\n        curr_row += 1\n        \n    # -R <= 0\n    for i in range(num_gens):\n        G_vals.append(-1.0)\n        G_rows.append(curr_row)\n        G_cols.append(num_gens + i)\n        h.append(0.0)\n        curr_row += 1\n        \n    # -sum(R) <= -Rreq\n    res_req_row = curr_row\n    for i in range(num_gens):\n        G_vals.append(-1.0)\n        G_rows.append(curr_row)\n        G_cols.append(num_gens + i)\n    h.append(-res_req / baseMVA)\n    curr_row += 1\n    \n    # Branch flow limits\n    for i, br in enumerate(branches):\n        if br[10] > 0:\n            f = bus_map[int(br[0])]\n            t = bus_map[int(br[1])]\n            x = br[3]\n            limit = br[5] / baseMVA\n            if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n                limit *= 1.2\n            \n            # (1/x) * (theta_f - theta_t) <= limit\n            G_vals.extend([1.0/x, -1.0/x])\n            G_rows.extend([curr_row, curr_row])\n            G_cols.extend([2*num_gens + f, 2*num_gens + t])\n            h.append(limit)\n            curr_row += 1\n            \n            # -(1/x) * (theta_f - theta_t) <= limit\n            G_vals.extend([-1.0/x, 1.0/x])\n            G_rows.extend([curr_row, curr_row])\n            G_cols.extend([2*num_gens + f, 2*num_gens + t])\n            h.append(limit)\n            curr_row += 1\n\n    G = spmatrix(G_vals, G_rows, G_cols, (curr_row, n_vars))\n    h = matrix(h)\n    \n    sol = solvers.lp(matrix(c), G, h, A_eq, b_eq)\n    \n    x_sol = np.array(sol[\'x\']).flatten()\n    Pg = x_sol[:num_gens] * baseMVA\n    R = x_sol[num_gens:2*num_gens] * baseMVA\n    theta = x_sol[2*num_gens:]\n    \n    LMPs = -np.array(sol[\'y\']).flatten()[:num_buses] / baseMVA\n    # Wait, sign of LMP might be tricky. In min c\'x s.t. Ax=b, dual is y. \n    # Power balance: B*theta - Pg = -Pd. Change in Pd (increase) means -Pd decreases.\n    # Let\'s verify sign later.\n\n    res_mcp = np.array(sol[\'z\']).flatten()[res_req_row] / baseMVA\n    \n    binding_lines = []\n    for i, br in enumerate(branches):\n        f_idx = bus_map[int(br[0])]\n        t_idx = bus_map[int(br[1])]\n        x = br[3]\n        limit = br[5]\n        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n            limit *= 1.2\n        \n        flow = (1.0 / x) * (theta[f_idx] - theta[t_idx]) * baseMVA\n        if abs(flow) >= 0.99 * limit:\n            binding_lines.append({"from": int(br[0]), "to": int(br[1]), "flow_MW": float(flow), "limit_MW": float(limit)})\n\n    return {\n        "total_cost": float(sol[\'primal objective\']),\n        "LMPs": LMPs.tolist(),\n        "res_mcp": float(res_mcp),\n        "binding_lines": binding_lines\n    }\n\nwith open(\'network.json\') as f:\n    network = json.load(f)\n\nbase_case = solve_dc_opf(network)\ncf_case = solve_dc_opf(network, line_relax=(64, 1501))\n\nbuses = network[\'bus\']\nbus_ids = [int(b[0]) for b in buses]\n\nreport = {\n    "base_case": {\n        "total_cost_dollars_per_hour": base_case[\'total_cost\'],\n        "lmp_by_bus": [{"bus": bid, "lmp_dollars_per_MWh": lmp} for bid, lmp in zip(bus_ids, base_case[\'LMPs\'])],\n        "reserve_mcp_dollars_per_MWh": base_case[\'res_mcp\'],\n        "binding_lines": base_case[\'binding_lines\']\n    },\n    "counterfactual": {\n        "total_cost_dollars_per_hour": cf_case[\'total_cost\'],\n        "lmp_by_bus": [{"bus": bid, "lmp_dollars_per_MWh": lmp} for bid, lmp in zip(bus_ids, cf_case[\'LMPs\'])],\n        "reserve_mcp_dollars_per_MWh": cf_case[\'res_mcp\'],\n        "binding_lines": cf_case[\'binding_lines\']\n    }\n}\n\nbase_lmps = np.array(base_case[\'LMPs\'])\ncf_lmps = np.array(cf_case[\'LMPs\'])\ndeltas = cf_lmps - base_lmps\nsorted_indices = np.argsort(deltas)\ntop_3_indices = sorted_indices[:3]\n\nbuses_with_largest_lmp_drop = []\nfor idx in top_3_indices:\n    buses_with_largest_lmp_drop.append({\n        "bus": int(bus_ids[idx]),\n        "base_lmp": float(base_lmps[idx]),\n        "cf_lmp": float(cf_lmps[idx]),\n        "delta": float(deltas[idx])\n    })\n\nline_binding_in_cf = any((l[\'from\'] == 64 and l[\'to\'] == 1501) or (l[\'from\'] == 1501 and l[\'to\'] == 64) for l in cf_case[\'binding_lines\'])\n\nreport["impact_analysis"] = {\n    "cost_reduction_dollars_per_hour": base_case[\'total_cost\'] - cf_case[\'total_cost\'],\n    "buses_with_largest_lmp_drop": buses_with_largest_lmp_drop,\n    "congestion_relieved": not line_binding_in_cf\n}\n\nwith open(\'report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\nEOF\npython3 solve_market.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
