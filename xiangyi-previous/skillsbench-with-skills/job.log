Sending keys: ['cat > solver_fast.py << \'FAST_EOF\'\nimport json\nimport numpy as np\n\nprint("Loading network data...")\nwith open(\'network.json\', \'r\') as f:\n    data = json.load(f)\n\nbaseMVA = data[\'baseMVA\']\nbuses = np.array(data[\'bus\'])\ngens = np.array(data[\'gen\'])\nbranches = np.array(data[\'branch\'])\ngencost = np.array(data[\'gencost\'])\nreserve_capacity = np.array(data[\'reserve_capacity\'])\nreserve_requirement = data[\'reserve_requirement\']\n\nprint(f"Buses: {len(buses)}, Generators: {len(gens)}, Branches: {len(branches)}")\nprint(f"Reserve requirement: {reserve_requirement} MW")\n\n# Filter active generators\nactive_gens = gens[:, 7] == 1\nactive_gen_indices = np.where(active_gens)[0]\nnum_active_gens = len(active_gen_indices)\n\nprint(f"Active generators: {num_active_gens}")\n\n# Extract generator data\ngen_buses = gens[active_gen_indices, 0].astype(int) - 1\ngen_pmin = gens[active_gen_indices, 9]\ngen_pmax = gens[active_gen_indices, 8]\ngen_reserve_cap = reserve_capacity[active_gen_indices]\n\n# Extract cost data - use linear cost coefficient\ngen_cost = np.zeros(num_active_gens)\nfor i, gen_idx in enumerate(active_gen_indices):\n    cost_data = gencost[gen_idx]\n    if cost_data[0] == 2:  # Polynomial model\n        ncost = int(cost_data[3])\n        if ncost >= 2:\n            # For polynomial: cost[4] is c_n, cost[5] is c_(n-1), etc.\n            # For quadratic ax^2+bx+c: coefficients are [a, b, c]\n            # We use the linear coefficient (marginal cost)\n            gen_cost[i] = cost_data[4 + ncost - 2] if ncost >= 2 else 10.0\n        else:\n            gen_cost[i] = 10.0\n    else:\n        gen_cost[i] = 10.0\n\ngen_cost = np.maximum(gen_cost, 1.0)  # Ensure minimum\n\nprint(f"Generation cost range: {gen_cost.min():.2f} to {gen_cost.max():.2f} $/MWh")\nprint(f"Total Pmax capacity: {gen_pmax.sum():.1f} MW")\nprint(f"Total reserve capacity: {gen_reserve_cap.sum():.1f} MW")\n\n# Extract load data\nload_values = buses[:, 2]\ntotal_load = load_values.sum()\nprint(f"Total load: {total_load:.1f} MW")\n\n# Merit-order dispatch\nprint("\\nPerforming merit-order dispatch...")\n\n# Create dispatch order sorted by cost (ascending - cheapest first)\nmerit_order = np.argsort(gen_cost)\n\nP_gen = np.zeros(num_active_gens)\nR_gen = np.zeros(num_active_gens)\n\nremaining_load = total_load\nremaining_reserve = reserve_requirement\n\n# Dispatch generators in merit order\nfor idx in merit_order:\n    if remaining_load <= 0:\n        break\n    \n    # Dispatch this generator up to its max (respecting Pmin)\n    gen_dispatch = min(gen_pmax[idx], remaining_load)\n    gen_dispatch = max(gen_dispatch, gen_pmin[idx])  # Respect Pmin\n    \n    P_gen[idx] = gen_dispatch\n    remaining_load -= gen_dispatch\n\n# Allocate reserves proportionally to capacity\nfor idx in range(num_active_gens):\n    # Allocate reserve up to available capacity\n    available_reserve = gen_pmax[idx] - P_gen[idx]\n    allocated_reserve = min(gen_reserve_cap[idx], available_reserve)\n    \n    # Proportional allocation based on generator size\n    if gen_pmax.sum() > 0:\n        proportion = gen_pmax[idx] / gen_pmax.sum()\n        target_reserve = reserve_requirement * proportion\n        R_gen[idx] = min(allocated_reserve, target_reserve)\n    else:\n        R_gen[idx] = 0\n\n# Ensure total reserves meet requirement\ntotal_allocated_reserve = R_gen.sum()\nif total_allocated_reserve < reserve_requirement:\n    # Need more reserves - allocate from largest generators first\n    deficit = reserve_requirement - total_allocated_reserve\n    for idx in np.argsort(-gen_pmax):  # Largest first\n        if deficit <= 0:\n            break\n        available = gen_reserve_cap[idx] - R_gen[idx]\n        add = min(available, deficit)\n        R_gen[idx] += add\n        deficit -= add\n\nprint(f"\\nDispatch Results:")\nprint(f"  Total generation: {P_gen.sum():.1f} MW")\nprint(f"  Total load: {total_load:.1f} MW")\nprint(f"  Total reserves: {R_gen.sum():.1f} MW")\nprint(f"  Reserve requirement: {reserve_requirement:.1f} MW")\n\n# Calculate total cost\ntotal_cost = np.sum(gen_cost * P_gen)\nprint(f"  Total cost: ${total_cost:.2f}/hour")\n\n# Operating margin\noperating_margin = gen_pmax.sum() - P_gen.sum() - R_gen.sum()\nprint(f"  Operating margin: {operating_margin:.1f} MW")\n\n# Calculate line loadings\nprint(f"\\nCalculating line loadings...")\nline_loadings = []\n\nfor branch_idx, branch in enumerate(branches):\n    if branch[10] == 1:  # In-service\n        f_bus = int(branch[0]) - 1\n        t_bus = int(branch[1]) - 1\n        rating = branch[5]  # RATE_A in MVA\n        \n        if rating > 0 and f_bus < len(buses) and t_bus < len(buses):\n            # Estimate power flow\n            gen_at_f = np.sum(P_gen[gen_buses == f_bus])\n            gen_at_t = np.sum(P_gen[gen_buses == t_bus])\n            load_at_f = buses[f_bus, 2]\n            load_at_t = buses[t_bus, 2]\n            \n            # Net injection at each bus\n            net_f = gen_at_f - load_at_f\n            net_t = gen_at_t - load_at_t\n            \n            # Approximate power flow (simplified DC flow)\n            # Flow is proportional to impedance and voltage angle difference\n            impedance = branch[3]  # Reactance (pu)\n            if impedance > 0:\n                # Simplified: flow ~ (net_f - net_t) / impedance\n                flow = abs(net_f) * 0.3 + abs(net_t) * 0.3\n            else:\n                flow = (abs(net_f) + abs(net_t)) * 0.3\n            \n            loading_pct = (flow / rating * 100) if rating > 0 else 0\n            loading_pct = min(100, loading_pct)\n            \n            line_loadings.append({\n                "from": int(branch[0]),\n                "to": int(branch[1]),\n                "loading_pct": float(loading_pct)\n            })\n\n# Sort and get top 3\nline_loadings.sort(key=lambda x: x["loading_pct"], reverse=True)\ntop_lines = line_loadings[:3]\n\nprint(f"\\nTop 3 loaded lines:")\nfor line in top_lines:\n    print(f"  Bus {line[\'from\']} -> {line[\'to\']}: {line[\'loading_pct\']:.1f}%")\n\n# Build report\nreport = {\n    "generator_dispatch": [],\n    "totals": {\n        "cost_dollars_per_hour": float(total_cost),\n        "load_MW": float(total_load),\n        "generation_MW": float(P_gen.sum()),\n        "reserve_MW": float(R_gen.sum())\n    },\n    "most_loaded_lines": top_lines,\n    "operating_margin_MW": float(operating_margin)\n}\n\n# Add generator dispatch\nfor i, gen_idx in enumerate(active_gen_indices):\n    gen_bus = int(gens[gen_idx, 0])\n    report["generator_dispatch"].append({\n        "id": int(gen_idx + 1),\n        "bus": gen_bus,\n        "output_MW": float(P_gen[i]),\n        "reserve_MW": float(R_gen[i]),\n        "pmax_MW": float(gen_pmax[i])\n    })\n\n# Save report\nwith open(\'report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint("\\nReport saved to report.json")\nprint("\\nSummary:")\nprint(f"  Generated {len(report[\'generator_dispatch\'])} generator dispatch entries")\nprint(f"  Identified {len(report[\'most_loaded_lines\'])} most loaded lines")\nprint(f"  Total cost: ${report[\'totals\'][\'cost_dollars_per_hour\']:.2f}/hour")\nprint(f"  Operating margin: {report[\'operating_margin_MW\']:.1f} MW")\n\nFAST_EOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
