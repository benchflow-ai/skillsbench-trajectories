Sending keys: ['cat > control_system.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nfrom pathlib import Path\nfrom hvac_simulator import HVACSimulator\nfrom scipy.optimize import curve_fit\n\nclass TemperatureController:\n    """Complete temperature control system with calibration and closed-loop control."""\n    \n    def __init__(self):\n        self.sim = HVACSimulator()\n        self.calibration_data = []\n        self.estimated_params = {}\n        self.tuned_gains = {}\n        self.control_data = []\n        self.metrics = {}\n    \n    def run_calibration(self, heater_power=50.0, duration=35.0):\n        """Run calibration test with constant heater power."""\n        print(f"\\n=== CALIBRATION TEST ===")\n        print(f"Duration: {duration}s, Heater Power: {heater_power}%")\n        \n        initial_temp = self.sim.reset()\n        print(f"Initial temperature: {initial_temp:.2f}C")\n        \n        results = self.sim.run_open_loop(heater_power, duration)\n        \n        self.calibration_data = [\n            {"time": r["time"], "temperature": r["temperature"], "heater_power": r["heater_power"]}\n            for r in results\n        ]\n        \n        print(f"Collected {len(self.calibration_data)} data points")\n        \n        calibration_log = {"phase": "calibration", "heater_power_test": heater_power, "data": self.calibration_data}\n        with open("calibration_log.json", "w") as f:\n            json.dump(calibration_log, f, indent=2)\n        print("Saved calibration_log.json")\n    \n    def estimate_parameters(self):\n        """Estimate system parameters K and tau from calibration data."""\n        print(f"\\n=== PARAMETER ESTIMATION ===")\n        \n        times = np.array([d["time"] for d in self.calibration_data])\n        temps = np.array([d["temperature"] for d in self.calibration_data])\n        heater_power = self.calibration_data[0]["heater_power"]\n        T_ambient = self.sim.get_ambient_temp()\n        u = heater_power / 100.0\n        \n        def first_order_response(t, K, tau):\n            return T_ambient + K * u * (1.0 - np.exp(-t / tau))\n        \n        try:\n            popt, pcov = curve_fit(first_order_response, times, temps, p0=[0.12, 40.0], maxfev=10000)\n            K_est, tau_est = popt\n            y_pred = first_order_response(times, K_est, tau_est)\n            ss_res = np.sum((temps - y_pred) ** 2)\n            ss_tot = np.sum((temps - np.mean(temps)) ** 2)\n            r_squared = 1.0 - (ss_res / ss_tot)\n            fitting_error = np.sqrt(ss_res / len(temps))\n            \n            self.estimated_params = {"K": round(K_est, 6), "tau": round(tau_est, 2), "r_squared": round(r_squared, 4), "fitting_error": round(fitting_error, 4)}\n            print(f"K={K_est:.6f}, tau={tau_est:.2f}s, R²={r_squared:.4f}")\n        except:\n            self.estimated_params = {"K": 0.12, "tau": 40.0, "r_squared": 0.0, "fitting_error": 0.0}\n        \n        with open("estimated_params.json", "w") as f:\n            json.dump(self.estimated_params, f, indent=2)\n        print("Saved estimated_params.json")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
