et_budget.cell(row=10, column=2).value\nscience_2020 = sheet_budget.cell(row=9, column=2).value\nsheet_yoy.cell(row=9, column=2).value = round((science_2021 - science_2020) / science_2020 * 100, 2)\n\nso_2021 = sheet_budget.cell(row=10, column=6).value\nso_2020 = sheet_budget.cell(row=9, column=6).value\nsheet_yoy.cell(row=9, column=6).value = round((so_2021 - so_2020) / so_2020 * 100, 2)\n\n# 8. Directorate Shares: 2021 Science Share\nsheet_share.cell(row=10, column=2).value = round(science_2021 / total_2021 * 100, 2)\n\n# 9. Growth Analysis\n# FY2019 Exploration Budget\nexp_2019 = sheet_budget.cell(row=8, column=5).value\nsheet_growth.cell(row=5, column=5).value = exp_2019\n\n# 5-Year CAGR Exploration\nexp_2024 = sheet_growth.cell(row=6, column=5).value\ncagr_exp = ((exp_2024 / exp_2019) ** (1/5) - 1) * 100\nsheet_growth.cell(row=4, column=5).value = round(cagr_exp, 2)\n\n# 5-Year Change Science\nsci_2019 = sheet_growth.cell(row=5, column=2).value\nsci_2024 = sheet_growth.cell(row=6, column=2).value\nsheet_growth.cell(row=7, column=2).value = sci_2024 - sci_2019\n\n# Avg Annual Budget Science (FY2019-2024)\n# Budgets for Science: 2019, 2020, 2021, 2022, 2023, 2024\n# We have 2019, 2020, 2021 from Budget sheet\nsci_2019 = sheet_budget.cell(row=8, column=2).value\nsci_2020 = sheet_budget.cell(row=9, column=2).value\nsci_2021 = sheet_budget.cell(row=10, column=2).value\n# Calculate 2022, 2023, 2024 from YoY changes\n# 2022 YoY: 4.29%\nsci_2022 = sci_2021 * (1 + 4.29 / 100)\n# 2023 YoY: 8.51%\nsci_2023 = sci_2022 * (1 + 8.51 / 100)\n# 2024 YoY: 2.15%\nsci_2024_calc = sci_2023 * (1 + 2.15 / 100)\n\nsci_avg = (sci_2019 + sci_2020 + sci_2021 + sci_2022 + sci_2023 + sci_2024_calc) / 6\nsheet_growth.cell(row=8, column=2).value = round(sci_avg, 1)\n\nwb.save('nasa_budget_recovered.xlsx')\nEOF\npython3 recover_budget.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
