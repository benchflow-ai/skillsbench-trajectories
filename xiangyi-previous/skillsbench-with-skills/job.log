nvironment();\n        env.setParallelism(1);\n\n        // Task Events\n        DataStream<TaskEvent> taskEvents = env.readTextFile(taskInput)\n            .map(new MapFunction<String, TaskEvent>() {\n                @Override\n                public TaskEvent map(String s) throws Exception {\n                    String[] tokens = s.split(",");\n                    long timestamp = Long.parseLong(tokens[0]) / 1000; // micros to millis\n                    long jobId = Long.parseLong(tokens[2]);\n                    int eventType = Integer.parseInt(tokens[5]);\n                    return new TaskEvent(timestamp, jobId, eventType);\n                }\n            })\n            .filter(new FilterFunction<TaskEvent>() {\n                @Override\n                public boolean filter(TaskEvent taskEvent) throws Exception {\n                    return taskEvent.eventType == 0; // SUBMIT\n                }\n            })\n            .assignTimestampsAndWatermarks(\n                WatermarkStrategy.<TaskEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))\n                    .withTimestampAssigner((event, timestamp) -> event.timestamp)\n            );\n\n        // Job Events\n        DataStream<JobEvent> jobEvents = env.readTextFile(jobInput)\n            .map(new MapFunction<String, JobEvent>() {\n                @Override\n                public JobEvent map(String s) throws Exception {\n                    String[] tokens = s.split(",");\n                    long timestamp = Long.parseLong(tokens[0]) / 1000; // micros to millis\n                    long jobId = Long.parseLong(tokens[2]);\n                    int eventType = Integer.parseInt(tokens[3]);\n                    return new JobEvent(timestamp, jobId, eventType);\n                }\n            })\n            .filter(new FilterFunction<JobEvent>() {\n                @Override\n                public boolean filter(JobEvent jobEvent) throws Exception {\n                    return jobEvent.eventType == 4; // FINISH\n                }\n            })\n            .assignTimestampsAndWatermarks(\n                WatermarkStrategy.<JobEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))\n                    .withTimestampAssigner((event, timestamp) -> event.timestamp)\n            );\n\n        // Calculate stage sizes\n        DataStream<Tuple2<Long, Integer>> stageSizes = taskEvents\n            .keyBy(t -> t.jobId)\n            .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\n            .process(new ProcessWindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                @Override\n                public void process(Long key, Context context, Iterable<TaskEvent> elements, Collector<Tuple2<Long, Integer>> out) throws Exception {\n                    int count = 0;\n                    for (TaskEvent e : elements) {\n                        count++;\n                    }\n                    out.collect(Tuple2.of(key, count));\n                }\n            });\n\n        // Connect and find max stage per job upon completion\n        stageSizes.connect(jobEvents)\n            .keyBy(t -> t.f0, j -> j.jobId)\n            .process(new CoProcessFunction<Tuple2<Long, Integer>, JobEvent, String>() {\n                \n                private ValueState<Integer> maxStageSize;\n                private ValueState<Long> jobFinishTime;\n\n                @Override\n                public void open(Configuration parameters) throws Exception {\n                    maxStageSize = getRuntimeContext().getState(new ValueStateDescriptor<>("maxStage", Integer.class));\n                    jobFinishTime = getRuntimeContext().getState(new ValueStateDescriptor<>("jobFinishTime", Long.class));\n                }\n\n                @Override\n                public void processElement1(Tuple2<Long, Integer> stage, Context ctx, Collector<String> out) throws Exception {\n                    Integer currentMax = maxStageSize.value();\n                    if (currentMax == null || stage.f1 > currentMax) {\n                        maxStageSize.update(stage.f1);\n                    }\n                }\n\n                @Override\n                public void processElement2(JobEvent job, Context ctx, Collector<String> out) throws Exception {\n                    jobFinishTime.update(job.timestamp);\n                    // Wait for 10 minutes past job finish to ensure all session windows have closed\n                    ctx.timerService().registerEventTimeTimer(job.timestamp + Time.minutes(10).toMilliseconds() + 1);\n                }\n\n                @Override\n                public void onTimer(long timestamp, OnTimerContext ctx, Collector<String> out) throws Exception {\n                    Long finishTime = jobFinishTime.value();\n                    if (finishTime != null) {\n                         Integer max = maxStageSize.value();\n                         if (max != null) {\n                             out.collect("(" + ctx.getCurrentKey() + "," + max + ")");\n                         }\n                         maxStageSize.clear();\n                         jobFinishTime.clear();\n                    }\n                }\n            })\n            .writeAsText(outputPath, FileSystem.WriteMode.OVERWRITE).setParallelism(1);\n\n        env.execute("LongestSessionPerJob");\n    }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
