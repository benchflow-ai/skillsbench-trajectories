urn cat\n    return None\n\nif __name__ == '__main__':\n    files_dir = '/root/papers/all'\n    base_dir = '/root/papers'\n    \n    files = [f for f in os.listdir(files_dir) if f.endswith('.pdf')]\n    \n    for filename in files:\n        filepath = os.path.join(files_dir, filename)\n        text = get_pdf_text(filepath)\n        category = categorize_file(filename, text)\n        \n        if category:\n            print(f'{filename} -> {category}')\n        else:\n            print(f'{filename} -> UNKNOWN')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
