Sending keys: ['cat > src/main/java/clusterdata/query/LongestSessionPerJob.java << \'EOF\'\npackage clusterdata.query;\n\nimport clusterdata.datatypes.JobEvent;\nimport clusterdata.datatypes.TaskEvent;\nimport clusterdata.utils.AppBase;\nimport org.apache.flink.api.common.eventtime.WatermarkStrategy;\nimport org.apache.flink.api.common.functions.MapFunction;\nimport org.apache.flink.api.common.state.ListState;\nimport org.apache.flink.api.common.state.ListStateDescriptor;\nimport org.apache.flink.api.java.utils.ParameterTool;\nimport org.apache.flink.configuration.Configuration;\nimport org.apache.flink.streaming.api.datastream.DataStream;\nimport org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;\nimport org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction;\nimport org.apache.flink.util.Collector;\n\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.List;\n\npublic class LongestSessionPerJob extends AppBase {\n\n    public static void main(String[] args) throws Exception {\n\n        ParameterTool params = ParameterTool.fromArgs(args);\n        String taskInput = params.get("task_input", null);\n        String jobInput = params.get("job_input", null);\n        String outputPath = params.get("output", null);\n        System.out.println("task_input  " + taskInput);\n        System.out.println("job_input  " + jobInput);\n        final long sessionGapMicros = params.getLong("sesssize", 600) * 1000000L; // Convert to microseconds\n\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        // Read and parse task events\n        DataStream<TaskEvent> taskEvents = env\n                .readTextFile(taskInput)\n                .map(new MapFunction<String, TaskEvent>() {\n                    @Override\n                    public TaskEvent map(String line) throws Exception {\n                        String[] fields = line.split(",", -1);\n                        TaskEvent event = new TaskEvent();\n                        event.timestamp = Long.parseLong(fields[0]);\n                        event.missingInfo = fields[1];\n                        event.jobId = Long.parseLong(fields[2]);\n                        event.taskIndex = Long.parseLong(fields[3]);\n                        event.machineId = fields[4].isEmpty() ? null : Long.parseLong(fields[4]);\n                        event.eventType = Integer.parseInt(fields[5]);\n                        event.user = fields[6];\n                        event.schedulingClass = Integer.parseInt(fields[7]);\n                        event.priority = Integer.parseInt(fields[8]);\n                        event.cpuRequest = Double.parseDouble(fields[9]);\n                        event.memoryRequest = Double.parseDouble(fields[10]);\n                        event.diskRequest = Double.parseDouble(fields[11]);\n                        event.differentMachines = Integer.parseInt(fields[12]);\n                        return event;\n                    }\n                })\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\n                                .withTimestampAssigner((event, timestamp) -> event.timestamp)\n                );\n\n        // Filter only SUBMIT events (type 0)\n        DataStream<TaskEvent> submitEvents = taskEvents\n                .filter(event -> event.eventType == 0);\n\n        // Read and parse job events\n        DataStream<JobEvent> jobEvents = env\n                .readTextFile(jobInput)\n                .map(new MapFunction<String, JobEvent>() {\n                    @Override\n                    public JobEvent map(String line) throws Exception {\n                        String[] fields = line.split(",", -1);\n                        JobEvent event = new JobEvent();\n                        event.timestamp = Long.parseLong(fields[0]);\n                        event.missingInfo = fields[1];\n                        event.jobId = Long.parseLong(fields[2]);\n                        event.eventType = Integer.parseInt(fields[3]);\n                        event.user = fields[4];\n                        event.schedulingClass = Integer.parseInt(fields[5]);\n                        event.jobName = fields[6];\n                        event.logicalJobName = fields[7];\n                        return event;\n                    }\n                })\n                .assignTimestampsAndWatermarks(\n                        WatermarkStrategy.<JobEvent>forMonotonousTimestamps()\n                                .withTimestampAssigner((event, timestamp) -> event.timestamp)\n                );\n\n        // Filter job completion events (FINISH=4 or KILL=5)\n        DataStream<JobEvent> completedJobs = jobEvents\n                .filter(event -> event.eventType == 4 || event.eventType == 5);\n\n        // Connect task submits with completed jobs\n        DataStream<String> result = submitEvents\n                .keyBy(event -> event.jobId)\n                .connect(completedJobs.keyBy(event -> event.jobId))\n                .process(new KeyedCoProcessFunction<Long, TaskEvent, JobEvent, String>() {\n                    private ListState<Long> submitTimestampsState;\n\n                    @Override\n                    public void open(Configuration parameters) throws Exception {\n                        submitTimestampsState = getRuntimeContext().getListState(\n                                new ListStateDescriptor<>("submitTimestamps", Long.class));\n                    }\n\n                    @Override\n                    public void processElement1(TaskEvent taskEvent, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        // Store the timestamp of each SUBMIT event\n                        submitTimestampsState.add(taskEvent.timestamp);\n                    }\n\n                    @Override\n                    public void processElement2(JobEvent jobEvent, Context ctx,\n                                                Collector<String> out) throws Exception {\n                        // When job completes, compute sessions from stored timestamps\n                        List<Long> timestamps = new ArrayList<>();\n                        for (Long ts : submitTimestampsState.get()) {\n                            timestamps.add(ts);\n                        }\n                        \n                        if (timestamps.isEmpty()) {\n                            return;\n                        }\n\n                        // Sort timestamps\n                        Collections.sort(timestamps);\n\n                        // Compute sessions with gap threshold\n                        int maxSessionSize = 0;\n                        int currentSessionSize = 1;\n                        \n                        for (int i = 1; i < timestamps.size(); i++) {\n                            long gap = timestamps.get(i) - timestamps.get(i - 1);\n                            if (gap <= sessionGapMicros) {\n                                // Still in the same session\n                                currentSessionSize++;\n                            } else {\n                                // New session starts\n                                maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\n                                currentSessionSize = 1;\n                            }\n                        }\n                        // Don\'t forget the last session\n                        maxSessionSize = Math.max(maxSessionSize, currentSessionSize);\n\n                        out.collect("(" + jobEvent.jobId + "," + maxSessionSize + ")");\n                    }\n                });\n\n        result.writeAsText(outputPath).setParallelism(1);\n\n        env.execute("LongestSessionPerJob");\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 1