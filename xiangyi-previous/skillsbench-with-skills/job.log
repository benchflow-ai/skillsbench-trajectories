Sending keys: ['cat > /root/solve.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom collections import Counter\n\n# Read the data\ndf = pd.read_excel(\'/root/data.xlsx\', sheet_name=\'Data\', header=7)\n\n# Extract relevant columns (Turn number, Game number, Roll 1-6)\ndata = df[[\'Unnamed: 2\', \'Unnamed: 3\', \'Unnamed: 4\', \'Unnamed: 5\', \'Unnamed: 6\', \'Unnamed: 7\', \'Unnamed: 8\', \'Unnamed: 9\']].copy()\ndata.columns = [\'Turn\', \'Game\', \'Roll1\', \'Roll2\', \'Roll3\', \'Roll4\', \'Roll5\', \'Roll6\']\n\n# Skip the header row and any NaN rows\ndata = data.dropna(subset=[\'Turn\', \'Game\'])\ndata = data.astype(int)\n\nprint(f"Total turns: {len(data)}")\nprint(f"Total games: {data[\'Game\'].max()}")\n\n# Scoring functions for each category\ndef high_and_often(rolls):\n    """Highest number * times it was rolled"""\n    highest = max(rolls)\n    count = rolls.count(highest)\n    return highest * count\n\ndef summation(rolls):\n    """Sum of all six dice"""\n    return sum(rolls)\n\ndef highs_and_lows(rolls):\n    """Highest * lowest * difference"""\n    highest = max(rolls)\n    lowest = min(rolls)\n    return highest * lowest * (highest - lowest)\n\ndef only_two_numbers(rolls):\n    """30 if all rolls are one of two numbers"""\n    unique = set(rolls)\n    if len(unique) == 2:\n        return 30\n    return 0\n\ndef all_the_numbers(rolls):\n    """40 if rolls are 1-2-3-4-5-6 in any order"""\n    if set(rolls) == {1, 2, 3, 4, 5, 6}:\n        return 40\n    return 0\n\ndef ordered_subset_of_four(rolls):\n    """50 if there\'s a run of 4 consecutive increasing or decreasing in order rolled"""\n    for i in range(3):  # positions 0,1,2 can start a run of 4\n        subset = rolls[i:i+4]\n        # Check increasing\n        if all(subset[j+1] == subset[j] + 1 for j in range(3)):\n            return 50\n        # Check decreasing\n        if all(subset[j+1] == subset[j] - 1 for j in range(3)):\n            return 50\n    return 0\n\ndef get_all_scores(rolls):\n    """Get all possible scores for a turn"""\n    return {\n        \'high_and_often\': high_and_often(rolls),\n        \'summation\': summation(rolls),\n        \'highs_and_lows\': highs_and_lows(rolls),\n        \'only_two\': only_two_numbers(rolls),\n        \'all_numbers\': all_the_numbers(rolls),\n        \'ordered_four\': ordered_subset_of_four(rolls)\n    }\n\ndef get_best_game_score(turn1_scores, turn2_scores):\n    """Find the best combined score using each category at most once"""\n    categories = list(turn1_scores.keys())\n    best_score = 0\n    \n    # Try all combinations of assigning categories to turns\n    for cat1 in categories:\n        for cat2 in categories:\n            if cat1 != cat2:  # Can\'t use same category twice\n                score = turn1_scores[cat1] + turn2_scores[cat2]\n                if score > best_score:\n                    best_score = score\n    \n    return best_score\n\n# Calculate scores for each turn\nturn_scores = {}\nfor _, row in data.iterrows():\n    turn_num = int(row[\'Turn\'])\n    rolls = [int(row[\'Roll1\']), int(row[\'Roll2\']), int(row[\'Roll3\']), \n             int(row[\'Roll4\']), int(row[\'Roll5\']), int(row[\'Roll6\'])]\n    turn_scores[turn_num] = get_all_scores(rolls)\n\n# Calculate best score for each game\ngame_scores = {}\nfor game_num in range(1, 3001):\n    # Each game has 2 turns: turn 2*game-1 and turn 2*game\n    turn1 = 2 * game_num - 1\n    turn2 = 2 * game_num\n    \n    if turn1 in turn_scores and turn2 in turn_scores:\n        game_scores[game_num] = get_best_game_score(turn_scores[turn1], turn_scores[turn2])\n\nprint(f"Games calculated: {len(game_scores)}")\nprint(f"Sample game scores: {list(game_scores.items())[:10]}")\n\n# Match odd games (Player 1) vs even games (Player 2)\n# game 1 vs game 2, game 3 vs game 4, etc.\nplayer1_wins = 0\nplayer2_wins = 0\nties = 0\n\nfor i in range(1, 1501):  # 1500 matches\n    odd_game = 2 * i - 1  # 1, 3, 5, ...\n    even_game = 2 * i     # 2, 4, 6, ...\n    \n    score1 = game_scores.get(odd_game, 0)\n    score2 = game_scores.get(even_game, 0)\n    \n    if score1 > score2:\n        player1_wins += 1\n    elif score2 > score1:\n        player2_wins += 1\n    else:\n        ties += 1\n\nprint(f"\\nPlayer 1 wins: {player1_wins}")\nprint(f"Player 2 wins: {player2_wins}")\nprint(f"Ties: {ties}")\nprint(f"\\nAnswer (P1 wins - P2 wins): {player1_wins - player2_wins}")\n\n# Write answer\nwith open(\'/root/answer.txt\', \'w\') as f:\n    f.write(str(player1_wins - player2_wins))\n\nprint("\\nAnswer written to /root/answer.txt")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
