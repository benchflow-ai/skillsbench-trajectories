Sending keys: ['cat << \'EOF\' > /root/workspace/test_parallel.py\nimport time\nimport argparse\nfrom sequential import generate_corpus, build_tfidf_index_sequential, batch_search_sequential, TFIDFIndex\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--num-docs", type=int, default=5000)\n    parser.add_argument("--num-queries", type=int, default=20)\n    args = parser.parse_args()\n\n    print(f"Generating {args.num_docs} documents...")\n    documents = generate_corpus(args.num_docs, seed=42)\n    \n    # Generate queries\n    queries = ["machine learning", "artificial intelligence", "neural networks", "data science", "python programming"] * (args.num_queries // 5)\n    queries = queries[:args.num_queries]\n    \n    print("="*60)\n    print("Testing Index Building")\n    print("="*60)\n    \n    # Sequential Build\n    print("Running Sequential Indexing...")\n    start = time.perf_counter()\n    seq_result = build_tfidf_index_sequential(documents)\n    seq_time = time.perf_counter() - start\n    print(f"Sequential Time: {seq_time:.4f}s")\n    \n    # Parallel Build\n    print("Running Parallel Indexing...")\n    start = time.perf_counter()\n    par_result = build_tfidf_index_parallel(documents, num_workers=4)\n    par_time = time.perf_counter() - start\n    print(f"Parallel Time: {par_time:.4f}s")\n    \n    print(f"Speedup: {seq_time / par_time:.2f}x")\n    \n    # Verify Index Correctness\n    print("\\nVerifying Index Correctness...")\n    assert len(seq_result.index.vocabulary) == len(par_result.index.vocabulary), "Vocabulary size mismatch"\n    assert seq_result.index.num_documents == par_result.index.num_documents, "Num docs mismatch"\n    \n    # Check a few terms in inverted index\n    vocab_list = list(seq_result.index.vocabulary)\n    for i in range(0, len(vocab_list), 1000):\n        term = vocab_list[i]\n        seq_postings = seq_result.index.inverted_index.get(term, [])\n        par_postings = par_result.index.inverted_index.get(term, [])\n        \n        # Sort just in case order differs slightly (though we sorted in code)\n        seq_postings.sort()\n        par_postings.sort()\n        \n        assert len(seq_postings) == len(par_postings), f"Posting list length mismatch for term \'{term}\'"\n        # Check content roughly (float precision might differ slightly)\n        for (d1, s1), (d2, s2) in zip(seq_postings, par_postings):\n            assert d1 == d2, f"Doc ID mismatch for term \'{term}\'"\n            assert abs(s1 - s2) < 1e-6, f"Score mismatch for term \'{term}\': {s1} vs {s2}"\n            \n    print("Index verification passed!")\n    \n    print("="*60)\n    print("Testing Search")\n    print("="*60)\n    \n    # Sequential Search\n    print("Running Sequential Search...")\n    start = time.perf_counter()\n    seq_search_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - start\n    print(f"Sequential Search Time: {seq_search_time:.4f}s")\n    \n    # Parallel Search\n    print("Running Parallel Search...")\n    # Note: batch_search_parallel returns (results, time)\n    # But we want to measure wall clock here including overhead if any\n    start = time.perf_counter()\n    par_search_results, inner_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    par_search_time = time.perf_counter() - start\n    print(f"Parallel Search Time: {par_search_time:.4f}s")\n    \n    print(f"Speedup: {seq_search_time / par_search_time:.2f}x")\n    \n    # Verify Search Correctness\n    print("\\nVerifying Search Correctness...")\n    for i, (seq_res, par_res) in enumerate(zip(seq_search_results, par_search_results)):\n        assert len(seq_res) == len(par_res), f"Result count mismatch for query {i}"\n        for r1, r2 in zip(seq_res, par_res):\n            assert r1.doc_id == r2.doc_id, f"Result doc_id mismatch for query {i}"\n            assert abs(r1.score - r2.score) < 1e-6, f"Result score mismatch for query {i}"\n            \n    print("Search verification passed!")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
