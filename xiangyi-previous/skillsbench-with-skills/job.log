defaultdict(list)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n            inverted_index[term].append((doc_id, tfidf))\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    for term in inverted_index:\n        inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n    \n    index.inverted_index = dict(inverted_index)\n\n    elapsed = time.perf_counter() - start_time\n    return ParallelIndexingResult(\n        index=index, \n        elapsed_time=elapsed, \n        num_documents=len(documents), \n        vocabulary_size=len(index.vocabulary)\n    )\n\ndef search_worker(args):\n    query, index_idf, index_inverted_index, index_doc_vectors, index_doc_norms, top_k, doc_titles = args\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n\n    query_tf = compute_term_frequencies(query_tokens)\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index_idf:\n            tfidf = tf * index_idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n\n    if not query_vector:\n        return []\n\n    query_norm = math.sqrt(query_norm_squared)\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index_inverted_index:\n            for doc_id, _ in index_inverted_index[term]:\n                candidate_docs.add(doc_id)\n\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index_doc_vectors.get(doc_id, {})\n        doc_norm = index_doc_norms.get(doc_id, 0)\n        if doc_norm == 0:\n            continue\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    results = []\n    for doc_id, score in top_results:\n        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f"Document {doc_id}")))\n    return results\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n    \n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    # Extract necessary parts of index to avoid passing the whole object if it helps,\n    # but here we pass them as separate arguments to be clear.\n    worker_args = [(query, index.idf, index.inverted_index, index.doc_vectors, index.doc_norms, top_k, doc_titles) for query in queries]\n    \n    with multiprocessing.Pool(processes=num_workers) as pool:\n        results = pool.map(search_worker, worker_args)\n        \n    elapsed_time = time.perf_counter() - start_time\n    return results, elapsed_time\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
