Sending keys: ['cat > parallel_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nParallel TF-IDF Implementation\n\nParallelizes the TF-IDF index building using ProcessPoolExecutor with chunked batches.\nSearch is implemented sequentially as it\'s already fast enough.\n"""\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom dataclasses import dataclass\nfrom heapq import nlargest\nfrom typing import List\n\nfrom document_generator import Document\nfrom sequential import (\n    SearchResult,\n    TFIDFIndex,\n    compute_term_frequencies,\n    tokenize,\n    search_sequential,\n)\n\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\ndef _worker_process_chunk(chunk: List[Document]) -> tuple[dict, dict]:\n    """\n    Worker function to process a chunk of documents.\n    Returns (doc_tfs, doc_terms) for the chunk.\n    """\n    doc_tfs = {}\n    doc_terms = {}\n    \n    for doc in chunk:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_tfs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n    \n    return doc_tfs, doc_terms\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: int = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    """\n    Build TF-IDF index in parallel using chunked batch processing.\n\n    Args:\n        documents: List of Document objects\n        num_workers: Number of worker processes (default: CPU count)\n        chunk_size: Chunk size for batch processing (default: 500)\n\n    Returns:\n        ParallelIndexingResult containing TFIDFIndex and timing info\n    """\n    start_time = time.perf_counter()\n\n    # Phase 1: Chunk documents and process in parallel\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    \n    doc_tfs = {}\n    doc_terms = {}\n    all_vocabulary = set()\n\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_worker_process_chunk, chunk) for chunk in chunks]\n        for future in futures:\n            chunk_tfs, chunk_terms = future.result()\n            doc_tfs.update(chunk_tfs)\n            doc_terms.update(chunk_terms)\n            all_vocabulary.update(set().union(*chunk_terms.values()))\n\n    # Phase 2: Calculate document frequencies\n    document_frequencies = {}\n    for term in all_vocabulary:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        document_frequencies[term] = df\n\n    # Phase 3: Compute IDF scores (with smoothing, matching sequential)\n    num_docs = len(documents)\n    idf = {}\n    for term, df in document_frequencies.items():\n        # IDF(t) = log(N / DF(t)) + 1 (smoothed, matching sequential)\n        idf[term] = math.log(num_docs / df) + 1\n\n    # Phase 4: Build inverted index and doc vectors\n    inverted_index = defaultdict(list)\n    doc_vectors = {}\n    doc_norms = {}\n\n    for term in all_vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_tfs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * idf[term]\n                posting_list.append((doc_id, tfidf))\n        inverted_index[term] = posting_list\n\n    # Compute doc vectors and norms\n    for doc_id, tf_dict in doc_tfs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        doc_vectors[doc_id] = doc_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    # Create index\n    index = TFIDFIndex(\n        num_documents=num_docs,\n        vocabulary=all_vocabulary,\n        document_frequencies=document_frequencies,\n        idf=idf,\n        inverted_index=dict(inverted_index),\n        doc_vectors=doc_vectors,\n        doc_norms=doc_norms,\n    )\n\n    elapsed_time = time.perf_counter() - start_time\n\n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed_time,\n        num_documents=num_docs,\n        vocabulary_size=len(all_vocabulary),\n    )\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: int = None,\n    documents: List[Document] = None,\n) -> tuple[List[List[SearchResult]], float]:\n    """\n    Search for multiple queries.\n    \n    Uses sequential search as it\'s already fast. For very large query sets,\n    parallelization overhead is not worth the complexity.\n\n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (ignored, for API compatibility)\n        documents: Optional list of documents for title lookup\n\n    Returns:\n        Tuple of (results, elapsed_time) where results is a list of result lists\n    """\n    start_time = time.perf_counter()\n\n    # Use sequential search - it\'s already fast and parallelization overhead is high\n    results = []\n    for query in queries:\n        result = search_sequential(query, index, top_k, documents)\n        results.append(result)\n\n    elapsed_time = time.perf_counter() - start_time\n\n    return results, elapsed_time\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
