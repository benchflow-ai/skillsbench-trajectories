Sending keys: ['cat > fetch_data.py << \'EOF\'\nimport json\nimport urllib.request\nfrom datetime import datetime\nfrom collections import Counter\nimport time\n\ndef fetch_url(url):\n    try:\n        with urllib.request.urlopen(url) as response:\n            return json.loads(response.read().decode())\n    except Exception as e:\n        print(f"Error fetching {url}: {e}")\n        return None\n\n# Fetch PRs created in December 2024 - use is:merged and is:unmerged queries\nprint("Fetching merged PRs...")\nmerged_prs = []\npage = 1\nwhile True:\n    url = f"https://api.github.com/search/issues?q=repo:cli/cli+type:pr+is:merged+created:2024-12-01..2024-12-31&per_page=100&page={page}"\n    data = fetch_url(url)\n    if not data or \'items\' not in data or len(data[\'items\']) == 0:\n        break\n    merged_prs.extend(data[\'items\'])\n    if len(data[\'items\']) < 100:\n        break\n    page += 1\n    time.sleep(2)  # Rate limiting\n\nprint(f"Found {len(merged_prs)} merged PRs")\n\nprint("Fetching closed (unmerged) PRs...")\nclosed_prs = []\npage = 1\nwhile True:\n    url = f"https://api.github.com/search/issues?q=repo:cli/cli+type:pr+is:closed+is:unmerged+created:2024-12-01..2024-12-31&per_page=100&page={page}"\n    data = fetch_url(url)\n    if not data or \'items\' not in data or len(data[\'items\']) == 0:\n        break\n    closed_prs.extend(data[\'items\'])\n    if len(data[\'items\']) < 100:\n        break\n    page += 1\n    time.sleep(2)  # Rate limiting\n\nprint(f"Found {len(closed_prs)} closed (unmerged) PRs")\n\nprint("Fetching open PRs...")\nopen_prs = []\npage = 1\nwhile True:\n    url = f"https://api.github.com/search/issues?q=repo:cli/cli+type:pr+is:open+created:2024-12-01..2024-12-31&per_page=100&page={page}"\n    data = fetch_url(url)\n    if not data or \'items\' not in data or len(data[\'items\']) == 0:\n        break\n    open_prs.extend(data[\'items\'])\n    if len(data[\'items\']) < 100:\n        break\n    page += 1\n    time.sleep(2)  # Rate limiting\n\nprint(f"Found {len(open_prs)} open PRs")\n\ntotal_prs = len(merged_prs) + len(closed_prs) + len(open_prs)\n\n# Count contributors\ncontributor_counts = Counter()\nfor pr in merged_prs + closed_prs + open_prs:\n    contributor_counts[pr[\'user\'][\'login\']] += 1\n\ntop_contributor = contributor_counts.most_common(1)[0][0] if contributor_counts else ""\n\n# Calculate average merge time - need to fetch PR details for merged PRs\nprint(f"Calculating merge times for {len(merged_prs)} merged PRs...")\ntotal_days = 0\nmerge_count = 0\n\nfor i, pr in enumerate(merged_prs):\n    if i % 10 == 0:\n        print(f"Processing PR {i+1}/{len(merged_prs)}...")\n    \n    pr_url = pr[\'pull_request\'][\'url\']\n    pr_detail = fetch_url(pr_url)\n    \n    if pr_detail and pr_detail.get(\'merged_at\'):\n        created = datetime.strptime(pr_detail[\'created_at\'], \'%Y-%m-%dT%H:%M:%SZ\')\n        merged = datetime.strptime(pr_detail[\'merged_at\'], \'%Y-%m-%dT%H:%M:%SZ\')\n        days = (merged - created).total_seconds() / 86400\n        total_days += days\n        merge_count += 1\n    \n    time.sleep(0.5)  # Rate limiting\n\navg_merge_days = round(total_days / merge_count, 1) if merge_count > 0 else 0.0\n\nprint(f"Fetching issues...")\n# Fetch issues created in December 2024\nissues = []\npage = 1\nwhile True:\n    url = f"https://api.github.com/search/issues?q=repo:cli/cli+type:issue+created:2024-12-01..2024-12-31&per_page=100&page={page}"\n    data = fetch_url(url)\n    if not data or \'items\' not in data or len(data[\'items\']) == 0:\n        break\n    issues.extend(data[\'items\'])\n    if len(data[\'items\']) < 100:\n        break\n    page += 1\n    time.sleep(2)  # Rate limiting\n\nprint(f"Found {len(issues)} issues")\n\n# Count bug reports\ntotal_issues = len(issues)\nbug_issues = []\nfor issue in issues:\n    labels = [label[\'name\'].lower() for label in issue.get(\'labels\', [])]\n    if any(\'bug\' in label for label in labels):\n        bug_issues.append(issue)\n\n# Count resolved bugs (closed)\nresolved_bugs = sum(1 for issue in bug_issues if issue[\'state\'] == \'closed\')\n\nreport = {\n    "pr": {\n        "total": total_prs,\n        "merged": len(merged_prs),\n        "closed": len(closed_prs),\n        "avg_merge_days": avg_merge_days,\n        "top_contributor": top_contributor\n    },\n    "issue": {\n        "total": total_issues,\n        "bug": len(bug_issues),\n        "resolved_bugs": resolved_bugs\n    }\n}\n\nwith open(\'/app/report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint("\\nReport generated:")\nprint(json.dumps(report, indent=2))\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
