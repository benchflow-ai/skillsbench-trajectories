Sending keys: ['cat << \'EOF\' > solution.py\nimport geopandas as gpd\nimport pandas as pd\nimport json\nfrom shapely.geometry import shape\n\n# Load plates and find Pacific plate\nplates = gpd.read_file(\'/root/PB2002_plates.json\')\npacific_plate = plates[plates[\'PlateName\'] == \'Pacific\']\nif pacific_plate.empty:\n    pacific_plate = plates[plates[\'Code\'] == \'PA\']\n\npacific_poly = pacific_plate.geometry.iloc[0]\n\n# Load earthquakes\nearthquakes = gpd.read_file(\'/root/earthquakes_2024.json\')\n\n# Filter earthquakes within Pacific plate\n# Use a spatial join or simple \'within\' check\npacific_quakes = earthquakes[earthquakes.geometry.within(pacific_poly)].copy()\n\n# To get accurate distance in km, project to Azimuthal Equidistant\n# Centered on the Pacific plate\'s centroid\ncentroid = pacific_poly.centroid\nproj_crs = f"+proj=aeqd +lat_0={centroid.y} +lon_0={centroid.x} +ellps=WGS84 +units=m"\n\npacific_quakes_proj = pacific_quakes.to_crs(proj_crs)\npacific_boundary_proj = gpd.GeoSeries([pacific_poly.boundary], crs=\'EPSG:4326\').to_crs(proj_crs).iloc[0]\n\n# Calculate distances in km\npacific_quakes[\'distance_km\'] = pacific_quakes_proj.geometry.distance(pacific_boundary_proj) / 1000.0\n\n# Find the one with max distance\nfurthest_quake = pacific_quakes.loc[pacific_quakes[\'distance_km\'].idxmax()]\n\n# Prepare output\nresult = {\n    "id": furthest_quake[\'id\'],\n    "place": furthest_quake[\'place\'],\n    "time": pd.to_datetime(furthest_quake[\'time\'], unit=\'ms\').strftime(\'%Y-%m-%dT%H:%M:%SZ\'),\n    "magnitude": float(furthest_quake[\'mag\']),\n    "latitude": float(furthest_quake.geometry.y),\n    "longitude": float(furthest_quake.geometry.x),\n    "distance_km": round(float(furthest_quake[\'distance_km\']), 2)\n}\n\nwith open(\'/root/answer.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > solve.py <<EOF\nimport seisbench.models as sbm\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom datetime import datetime\nimport warnings\nwarnings.filterwarnings('ignore')\n\ndef solve():\n    print('Loading data...')\n    stream = obspy.read('/root/data/wave.mseed')\n    print(f'Loaded {len(stream)} traces')\n\n    print('Loading PhaseNet...')\n    model = sbm.PhaseNet.from_pretrained('stead')\n    \n    print('Picking phases...')\n    output = model.classify(stream, P_threshold=0.3, S_threshold=0.3)\n    picks = output.picks\n    print(f'Picked {len(picks)} phases')\n\n    # Organize picks by station\n    picks_by_station = {}\n    for p in picks:\n        parts = p.trace_id.split('.')\n        net = parts[0]\n        sta = parts[1]\n        key = f'{net}.{sta}'\n        if key not in picks_by_station:\n            picks_by_station[key] = []\n        picks_by_station[key].append(p)\n\n    origin_times = []\n    vp = 6.0\n    vs = vp / 1.75\n    r = vp / vs\n\n    print('Associating...')\n    for sta, p_list in picks_by_station.items():\n        ps = [x for x in p_list if x.phase == 'P']\n        ss = [x for x in p_list if x.phase == 'S']\n        \n        for p_pick in ps:\n            for s_pick in ss:\n                if s_pick.peak_time > p_pick.peak_time:\n                    dt = s_pick.peak_time - p_pick.peak_time\n                    if dt < 60:\n                        t0_correction = dt / (r - 1)\n                        t0 = p_pick.peak_time - t0_correction\n                        origin_times.append(t0.datetime.timestamp())\n\n    if not origin_times:\n        print('No events associated.')\n        pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\n        return\n\n    print(f'Generated {len(origin_times)} candidate origin times')\n    \n    X = np.array(origin_times).reshape(-1, 1)\n    # Clustering parameters: eps=5s, min_samples=3\n    db = DBSCAN(eps=5, min_samples=3).fit(X)\n    labels = db.labels_\n\n    events = []\n    unique_labels = set(labels)\n    n_clusters = len(unique_labels) - (1 if -1 in unique_labels else 0)\n    print(f'Found {n_clusters} clusters')\n\n    for k in unique_labels:\n        if k == -1:\n            continue\n        \n        class_member_mask = (labels == k)\n        cluster_times = X[class_member_mask]\n        mean_time = np.mean(cluster_times)\n        \n        dt_obj = datetime.utcfromtimestamp(mean_time)\n        t_iso = dt_obj.isoformat(timespec='milliseconds')\n        events.append(t_iso)\n\n    events.sort()\n    \n    df = pd.DataFrame({'time': events})\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Results saved to /root/results.csv with {len(events)} events')\n    if len(events) > 0:\n        print(df.head())\n\nif __name__ == '__main__':\n    solve()\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
