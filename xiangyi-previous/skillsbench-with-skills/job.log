Sending keys: ["cat <<EOF > export_obj.js\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from './data/object.js';\nimport fs from 'fs';\n\nconst root = createScene();\n\n// Function to convert InstancedMesh to regular Meshes\nfunction convertInstancedMeshToMesh(object) {\n    const instancedMeshes = [];\n    object.traverse(child => {\n        if (child.isInstancedMesh) {\n            instancedMeshes.push(child);\n        }\n    });\n\n    instancedMeshes.forEach(im => {\n        const parent = im.parent;\n        const group = new THREE.Group();\n        group.name = im.name + '_instances';\n        \n        const matrix = new THREE.Matrix4();\n        for (let i = 0; i < im.count; i++) {\n            im.getMatrixAt(i, matrix);\n            const mesh = new THREE.Mesh(im.geometry, im.material);\n            mesh.applyMatrix4(matrix);\n            mesh.name = im.name + '_' + i;\n            group.add(mesh);\n        }\n        \n        group.copy(im, false); // Copy transform of the InstancedMesh itself\n        parent.add(group);\n        parent.remove(im);\n    });\n}\n\nconvertInstancedMeshToMesh(root);\n\n// Apply -90 degrees X-rotation for Blender Z-up\nconst exportRoot = new THREE.Group();\nexportRoot.add(root);\nexportRoot.rotation.x = -Math.PI / 2;\n\n// Update matrices\nexportRoot.updateMatrixWorld(true);\n\n// Export\nconst exporter = new OBJExporter();\nconst result = exporter.parse(exportRoot);\n\nfs.writeFileSync('/root/output/object.obj', result);\nconsole.log('Successfully exported to /root/output/object.obj');\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
