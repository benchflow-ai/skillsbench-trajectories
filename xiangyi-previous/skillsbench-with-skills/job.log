Sending keys: ['cat > /root/find_earthquake.py << \'EOF\'\nimport json\nimport geopandas as gpd\nfrom shapely.geometry import Point, shape\nimport pandas as pd\nfrom datetime import datetime\nimport numpy as np\n\n# Load earthquake data\nwith open(\'/root/earthquakes_2024.json\', \'r\') as f:\n    eq_data = json.load(f)\n\n# Load plate data\nplates_gdf = gpd.read_file(\'/root/PB2002_plates.json\')\nboundaries_gdf = gpd.read_file(\'/root/PB2002_boundaries.json\')\n\n# Create GeoDataFrame for earthquakes\nearthquakes = []\nfor feature in eq_data[\'features\']:\n    props = feature[\'properties\']\n    coords = feature[\'geometry\'][\'coordinates\']\n    earthquakes.append({\n        \'id\': feature[\'id\'],\n        \'place\': props[\'place\'],\n        \'time\': props[\'time\'],\n        \'magnitude\': props[\'mag\'],\n        \'longitude\': coords[0],\n        \'latitude\': coords[1],\n        \'geometry\': Point(coords[0], coords[1])\n    })\n\neq_gdf = gpd.GeoDataFrame(earthquakes, crs=\'EPSG:4326\')\n\nprint(f"Total earthquakes: {len(eq_gdf)}")\n\n# Get Pacific plate\npacific_plate = plates_gdf[plates_gdf[\'Code\'] == \'PA\'].copy()\nprint(f"Pacific plate found: {len(pacific_plate)} polygon(s)")\n\n# Find earthquakes within Pacific plate\neq_in_pacific = gpd.sjoin(eq_gdf, pacific_plate, predicate=\'within\', how=\'inner\')\nprint(f"Earthquakes in Pacific plate: {len(eq_in_pacific)}")\n\nif len(eq_in_pacific) == 0:\n    print("No earthquakes found in Pacific plate!")\n    exit(1)\n\n# Get Pacific plate boundaries\n# Boundaries where PlateA or PlateB is \'PA\'\npacific_boundaries = boundaries_gdf[\n    (boundaries_gdf[\'PlateA\'] == \'PA\') | (boundaries_gdf[\'PlateB\'] == \'PA\')\n].copy()\n\nprint(f"Pacific plate boundaries: {len(pacific_boundaries)}")\n\n# Use a projection centered on the Pacific Ocean\n# Azimuthal Equidistant projection centered at (180, 0) for the Pacific\n# This preserves distances from the center point\npacific_center_lon = 180\npacific_center_lat = 0\n\n# Use a custom projection string for azimuthal equidistant centered on Pacific\nproj_string = f\'+proj=aeqd +lat_0={pacific_center_lat} +lon_0={pacific_center_lon} +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs\'\n\n# Reproject to the custom projection\neq_in_pacific_proj = eq_in_pacific.to_crs(proj_string)\npacific_boundaries_proj = pacific_boundaries.to_crs(proj_string)\n\nprint("\\nCalculating distances...")\n\n# For each earthquake, find minimum distance to any Pacific boundary\nmax_distance = -1\nfarthest_eq = None\n\nfor idx, eq in eq_in_pacific_proj.iterrows():\n    min_dist = float(\'inf\')\n    \n    # Calculate distance to each boundary segment\n    for _, boundary in pacific_boundaries_proj.iterrows():\n        dist = eq.geometry.distance(boundary.geometry)\n        if dist < min_dist:\n            min_dist = dist\n    \n    # Convert from meters to kilometers\n    dist_km = min_dist / 1000.0\n    \n    if dist_km > max_distance:\n        max_distance = dist_km\n        farthest_eq = eq_in_pacific.loc[idx]\n\nprint(f"\\nFarthest earthquake from Pacific boundary: {max_distance:.2f} km")\nprint(f"ID: {farthest_eq[\'id\']}")\nprint(f"Place: {farthest_eq[\'place\']}")\nprint(f"Magnitude: {farthest_eq[\'magnitude\']}")\nprint(f"Coordinates: ({farthest_eq[\'latitude\']}, {farthest_eq[\'longitude\']})")\n\n# Convert time from milliseconds to ISO 8601 format\ntime_ms = farthest_eq[\'time\']\ntime_dt = datetime.utcfromtimestamp(time_ms / 1000.0)\ntime_iso = time_dt.strftime(\'%Y-%m-%dT%H:%M:%SZ\')\n\n# Prepare output\nresult = {\n    \'id\': farthest_eq[\'id\'],\n    \'place\': farthest_eq[\'place\'],\n    \'time\': time_iso,\n    \'magnitude\': float(farthest_eq[\'magnitude\']),\n    \'latitude\': float(farthest_eq[\'latitude\']),\n    \'longitude\': float(farthest_eq[\'longitude\']),\n    \'distance_km\': round(max_distance, 2)\n}\n\n# Write to JSON file\nwith open(\'/root/answer.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(f"\\nResult written to /root/answer.json")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
