 with {stop_and_reply, Shutdown, Repls, D}\n        while i < len(lines):\n            line = lines[i]\n            new_lines.append(\'            \' + line)\n            i += 1\n            if \'{stop_and_reply, Shutdown, Repls, D}\' in line:\n                break\n        new_lines.append(\'        false ->\')\n        new_lines.append(\'            {Shutdown, D1} = ?send_disconnect(?SSH_DISCONNECT_PROTOCOL_ERROR, "Connection message before authentication", StateName, D0),\')\n        new_lines.append(\'            {stop, Shutdown, D1}\')\n        new_lines.append(\'    end;\')\n    else:\n        new_lines.append(lines[i])\n        i += 1\n\nwith open(\'/app/workspace/otp_src_27.3.2/lib/ssh/src/ssh_connection_handler.erl\', \'w\') as f:\n    f.write(\'\\n\'.join(new_lines))\nEOF\npython3 /tmp/fix_ssh_v2.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
