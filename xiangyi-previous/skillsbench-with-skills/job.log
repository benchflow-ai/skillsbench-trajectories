Sending keys: ["cat > export_meshes.js << 'SCRIPT_EOF'\nimport * as THREE from 'three';\nimport { createScene } from './object.js';\nimport fs from 'fs';\nimport path from 'path';\n\n// Simple OBJ exporter function\nfunction exportToOBJ(mesh) {\n    const geometry = mesh.geometry;\n    \n    // Update the matrix to get world positions\n    mesh.updateMatrixWorld(true);\n    \n    const vertices = [];\n    const faces = [];\n    \n    if (geometry.isBufferGeometry) {\n        const positionAttribute = geometry.getAttribute('position');\n        \n        if (positionAttribute) {\n            // Extract vertices and apply world transform\n            for (let i = 0; i < positionAttribute.count; i++) {\n                const vertex = new THREE.Vector3(\n                    positionAttribute.getX(i),\n                    positionAttribute.getY(i),\n                    positionAttribute.getZ(i)\n                );\n                // Apply mesh's world transformation\n                vertex.applyMatrix4(mesh.matrixWorld);\n                vertices.push(vertex);\n            }\n            \n            // Extract faces\n            if (geometry.index) {\n                const indexAttribute = geometry.index;\n                for (let i = 0; i < indexAttribute.count; i += 3) {\n                    faces.push([\n                        indexAttribute.getX(i) + 1,\n                        indexAttribute.getX(i + 1) + 1,\n                        indexAttribute.getX(i + 2) + 1\n                    ]);\n                }\n            } else {\n                // Non-indexed geometry\n                for (let i = 0; i < positionAttribute.count; i += 3) {\n                    faces.push([i + 1, i + 2, i + 3]);\n                }\n            }\n        }\n    }\n    \n    // Generate OBJ format string\n    let objContent = '# Exported from Three.js\\n';\n    objContent += `o ${mesh.name || 'mesh'}\\n`;\n    \n    // Write vertices\n    for (const vertex of vertices) {\n        objContent += `v ${vertex.x} ${vertex.y} ${vertex.z}\\n`;\n    }\n    \n    // Write faces\n    for (const face of faces) {\n        objContent += `f ${face[0]} ${face[1]} ${face[2]}\\n`;\n    }\n    \n    return objContent;\n}\n\n// Function to merge multiple meshes into one OBJ\nfunction exportGroupToOBJ(group) {\n    let objContent = '# Exported from Three.js\\n';\n    objContent += `o ${group.name || 'group'}\\n`;\n    \n    let vertexOffset = 0;\n    const meshes = [];\n    \n    // Collect all meshes in this group\n    group.traverse((child) => {\n        if (child.isMesh && child.geometry) {\n            meshes.push(child);\n        }\n    });\n    \n    // Export each mesh\n    for (const mesh of meshes) {\n        mesh.updateMatrixWorld(true);\n        const geometry = mesh.geometry;\n        \n        if (geometry.isBufferGeometry) {\n            const positionAttribute = geometry.getAttribute('position');\n            \n            if (positionAttribute) {\n                // Write vertices\n                for (let i = 0; i < positionAttribute.count; i++) {\n                    const vertex = new THREE.Vector3(\n                        positionAttribute.getX(i),\n                        positionAttribute.getY(i),\n                        positionAttribute.getZ(i)\n                    );\n                    vertex.applyMatrix4(mesh.matrixWorld);\n                    objContent += `v ${vertex.x} ${vertex.y} ${vertex.z}\\n`;\n                }\n                \n                // Write faces with offset\n                if (geometry.index) {\n                    const indexAttribute = geometry.index;\n                    for (let i = 0; i < indexAttribute.count; i += 3) {\n                        const f1 = indexAttribute.getX(i) + 1 + vertexOffset;\n                        const f2 = indexAttribute.getX(i + 1) + 1 + vertexOffset;\n                        const f3 = indexAttribute.getX(i + 2) + 1 + vertexOffset;\n                        objContent += `f ${f1} ${f2} ${f3}\\n`;\n                    }\n                } else {\n                    for (let i = 0; i < positionAttribute.count; i += 3) {\n                        const f1 = i + 1 + vertexOffset;\n                        const f2 = i + 2 + vertexOffset;\n                        const f3 = i + 3 + vertexOffset;\n                        objContent += `f ${f1} ${f2} ${f3}\\n`;\n                    }\n                }\n                \n                vertexOffset += positionAttribute.count;\n            }\n        }\n    }\n    \n    return objContent;\n}\n\n// Create output directories\nconst partMeshesDir = '/root/output/part_meshes';\nconst linksDir = '/root/output/links';\n\nfs.mkdirSync(partMeshesDir, { recursive: true });\nfs.mkdirSync(linksDir, { recursive: true });\n\n// Create the scene\nconsole.log('Creating scene...');\nconst scene = createScene();\n\nconsole.log('Scene structure:');\nconsole.log(`Root: ${scene.name}`);\n\n// Traverse and export\nscene.children.forEach((part) => {\n    if (part.isGroup) {\n        console.log(`\\nProcessing part: ${part.name}`);\n        \n        // Create directory for this part\n        const partDir = path.join(partMeshesDir, part.name);\n        fs.mkdirSync(partDir, { recursive: true });\n        \n        // Export individual meshes in this part\n        part.traverse((child) => {\n            if (child.isMesh && child.geometry) {\n                const meshName = child.name || 'unnamed_mesh';\n                console.log(`  - Exporting mesh: ${meshName}`);\n                \n                const objContent = exportToOBJ(child);\n                const objPath = path.join(partDir, `${meshName}.obj`);\n                fs.writeFileSync(objPath, objContent);\n            }\n        });\n        \n        // Export the entire part as a single OBJ in links\n        console.log(`  - Exporting part to links: ${part.name}`);\n        const partObjContent = exportGroupToOBJ(part);\n        const partObjPath = path.join(linksDir, `${part.name}.obj`);\n        fs.writeFileSync(partObjPath, partObjContent);\n    }\n});\n\nconsole.log('\\nExport complete!');\nconsole.log(`Part meshes saved to: ${partMeshesDir}`);\nconsole.log(`Links saved to: ${linksDir}`);\nSCRIPT_EOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
