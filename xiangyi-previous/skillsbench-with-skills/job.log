num_buses):\n            if B[i, j] != 0:\n                A_eq[i, num_gens + num_gens + j] = B[i, j]\n    \n    b_eq = -Pd\n\n    # Reference bus theta = 0\n    ref_row = np.zeros(n_vars)\n    ref_row[num_gens + num_gens + 0] = 1.0\n    A_eq = np.vstack([A_eq, ref_row])\n    b_eq = np.append(b_eq, 0.0)\n\n    # Inequality constraints: G * x <= h\n    G = []\n    h = []\n\n    # Pg limits: Pg + R <= Pmax, Pg >= Pmin\n    for i in range(num_gens):\n        # Pg + R <= Pmax\n        row = np.zeros(n_vars)\n        row[i] = 1.0\n        row[num_gens + i] = 1.0\n        G.append(row)\n        h.append(gens[i][8] / baseMVA)\n        # -Pg <= -Pmin\n        row = np.zeros(n_vars)\n        row[i] = -1.0\n        G.append(row)\n        h.append(-gens[i][9] / baseMVA)\n    \n    # Reserve limits: R <= Rmax, R >= 0\n    for i in range(num_gens):\n        # R <= Rmax\n        row = np.zeros(n_vars)\n        row[num_gens + i] = 1.0\n        G.append(row)\n        h.append(res_cap[i] / baseMVA)\n        # -R <= 0\n        row = np.zeros(n_vars)\n        row[num_gens + i] = -1.0\n        G.append(row)\n        h.append(0.0)\n\n    # Total reserve requirement: sum(R) >= Rreq => -sum(R) <= -Rreq\n    row = np.zeros(n_vars)\n    for i in range(num_gens):\n        row[num_gens + i] = -1.0\n    G.append(row)\n    h.append(-res_req / baseMVA)\n\n    # Branch flow limits: |1/x * (theta_f - theta_t)| <= Limit\n    for i, br in enumerate(branches):\n        f = bus_map[int(br[0])]\n        t = bus_map[int(br[1])]\n        x = br[3]\n        limit = br[5] / baseMVA\n        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n            limit *= 1.2\n        \n        if br[10] > 0:\n            # (1/x) * (theta_f - theta_t) <= limit\n            row = np.zeros(n_vars)\n            row[num_gens + num_gens + f] = 1.0 / x\n            row[num_gens + num_gens + t] = -1.0 / x\n            G.append(row)\n            h.append(limit)\n            # -(1/x) * (theta_f - theta_t) <= limit\n            row = np.zeros(n_vars)\n            row[num_gens + num_gens + f] = -1.0 / x\n            row[num_gens + num_gens + t] = 1.0 / x\n            G.append(row)\n            h.append(limit)\n\n    G = np.array(G)\n    h = np.array(h)\n\n    # Solve LP\n    sol = solvers.lp(matrix(c), matrix(G), matrix(h), matrix(A_eq), matrix(b_eq))\n    \n    if sol[\'status\'] != \'optimal\':\n        return None\n\n    x_sol = np.array(sol[\'x\']).flatten()\n    Pg = x_sol[:num_gens] * baseMVA\n    R = x_sol[num_gens:2*num_gens] * baseMVA\n    theta = x_sol[2*num_gens:]\n    \n    # LMPs are duals of power balance constraints\n    # In cvxopt, sol[\'y\'] are duals for equality constraints\n    # The first num_buses equality constraints are power balance\n    # Note: cvxopt duals \'y\' might have a sign difference depending on formulation\n    # Objective is min c\'x s.t. Gx <= h, Ax = b. \n    # LMPs are duals of Ax = b. \n    # Looking at the results, we\'ll see if the sign is correct.\n    LMPs = np.array(sol[\'y\']).flatten()[:num_buses] / baseMVA\n    # Reserve MCP is dual of the reserve requirement constraint\n    # It\'s one of the inequality constraints. \n    # In cvxopt, sol[\'z\'] are duals for Gx <= h\n    # Reserve constraint was -sum(R) <= -Rreq, which was at index (2*num_gens + 2*num_gens)\n    res_mcp_idx = 4 * num_gens\n    res_mcp = np.array(sol[\'z\']).flatten()[res_mcp_idx] / baseMVA\n\n    total_cost = sol[\'primal objective\']\n    \n    # Binding lines\n    binding_lines = []\n    for i, br in enumerate(branches):\n        f_idx = bus_map[int(br[0])]\n        t_idx = bus_map[int(br[1])]\n        x = br[3]\n        limit = br[5]\n        if line_relax and ((int(br[0]) == line_relax[0] and int(br[1]) == line_relax[1]) or (int(br[0]) == line_relax[1] and int(br[1]) == line_relax[0])):\n            limit *= 1.2\n        \n        flow = (1.0 / x) * (theta[f_idx] - theta[t_idx]) * baseMVA\n        if abs(flow) >= 0.99 * limit:\n            binding_lines.append({"from": int(br[0]), "to": int(br[1]), "flow_MW": float(flow), "limit_MW": float(limit)})\n\n    return {\n        "total_cost": float(total_cost),\n        "Pg": Pg.tolist(),\n        "R": R.tolist(),\n        "LMPs": LMPs.tolist(),\n        "res_mcp": float(res_mcp),\n        "binding_lines": binding_lines\n    }\n\nwith open(\'network.json\') as f:\n    network = json.load(f)\n\nbase_case = solve_dc_opf(network)\ncf_case = solve_dc_opf(network, line_relax=(64, 1501))\n\nbuses = network[\'bus\']\nbus_ids = [int(b[0]) for b in buses]\n\n# Prepare report\nreport = {\n    "base_case": {\n        "total_cost_dollars_per_hour": base_case[\'total_cost\'],\n        "lmp_by_bus": [{"bus": bid, "lmp_dollars_per_MWh": lmp} for bid, lmp in zip(bus_ids, base_case[\'LMPs\'])],\n        "reserve_mcp_dollars_per_MWh": base_case[\'res_mcp\'],\n        "binding_lines": base_case[\'binding_lines\']\n    },\n    "counterfactual": {\n        "total_cost_dollars_per_hour": cf_case[\'total_cost\'],\n        "lmp_by_bus": [{"bus": bid, "lmp_dollars_per_MWh": lmp} for bid, lmp in zip(bus_ids, cf_case[\'LMPs\'])],\n        "reserve_mcp_dollars_per_MWh": cf_case[\'res_mcp\'],\n        "binding_lines": cf_case[\'binding_lines\']\n    }\n}\n\n# Impact analysis\nbase_lmps = np.array(base_case[\'LMPs\'])\ncf_lmps = np.array(cf_case[\'LMPs\'])\ndeltas = cf_lmps - base_lmps\n\n# Buses with largest LMP drop (most negative delta)\nsorted_indices = np.argsort(deltas)\ntop_3_indices = sorted_indices[:3]\n\nbuses_with_largest_lmp_drop = []\nfor idx in top_3_indices:\n    buses_with_largest_lmp_drop.append({\n        "bus": int(bus_ids[idx]),\n        "base_lmp": float(base_lmps[idx]),\n        "cf_lmp": float(cf_lmps[idx]),\n        "delta": float(deltas[idx])\n    })\n\nline_binding_in_cf = any(l[\'from\'] in [64, 1501] and l[\'to\'] in [64, 1501] for l in cf_case[\'binding_lines\'])\n\nreport["impact_analysis"] = {\n    "cost_reduction_dollars_per_hour": base_case[\'total_cost\'] - cf_case[\'total_cost\'],\n    "buses_with_largest_lmp_drop": buses_with_largest_lmp_drop,\n    "congestion_relieved": not line_binding_in_cf\n}\n\nwith open(\'report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\nEOF\npython3 solve_market.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
