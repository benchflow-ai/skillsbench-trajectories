  \'Non_HDL_Cholesterol\': (0, 160),\n    \'Glucose\': (70, 100),\n    \'HbA1c\': (4.0, 5.6),\n    \'Fructosamine\': (200, 285),\n    \'Uric_Acid\': (3.5, 7.2),\n    \'Urine_Albumin\': (0, 30),\n    \'Urine_Creatinine\': (800, 2000),\n    \'Albumin_to_Creatinine_Ratio_Urine\': (0, 30),\n    \'Protein_to_Creatinine_Ratio_Urine\': (0, 150),\n    \'Urine_Protein\': (0, 150),\n    \'Urine_pH\': (4.5, 8.0),\n    \'Urine_Specific_Gravity\': (1.005, 1.030),\n    \'BNP\': (0, 100),\n    \'NT_proBNP\': (0, 125),\n    \'Troponin_I\': (0, 0.04),\n    \'Troponin_T\': (0, 0.04),\n    \'Free_T4\': (0.8, 1.8),\n    \'Free_T3\': (2.3, 4.2),\n    \'pH_Arterial\': (7.35, 7.45),\n    \'pCO2_Arterial\': (35, 45),\n    \'pO2_Arterial\': (80, 100),\n    \'Lactate\': (0.5, 2.0),\n    \'Beta2_Microglobulin\': (0.0, 2.4),\n    \'Aluminum\': (0, 10),\n}\n\nprint("\\nApplying comprehensive unit conversions...")\n\n# Define conversion rules with thresholds and factors\nconversion_rules = [\n    (\'Serum_Creatinine\', lambda x: x > 1.5, 1/88.4),\n    (\'BUN\', lambda x: x > 25, 1/2.8),\n    (\'Magnesium\', lambda x: x > 3, 1/2.43),\n    (\'Serum_Calcium\', lambda x: x > 15, 1/4.0),\n    (\'Phosphorus\', lambda x: x > 6, 1/3.1),\n    (\'Albumin_Serum\', lambda x: x > 8, 1/10),\n    (\'Total_Protein\', lambda x: x > 10, 1/10),\n    (\'Hemoglobin\', lambda x: x > 20, 1/10),\n    (\'Hemoglobin\', lambda x: x < 5, 10),\n    (\'Hematocrit\', lambda x: x > 60, 1/10),\n    (\'Glucose\', lambda x: x > 1000, 1/18),\n    (\'Uric_Acid\', lambda x: x > 15, 1/59.48),\n    (\'Triglycerides\', lambda x: x > 1000, 1/100),\n    (\'Total_Cholesterol\', lambda x: x > 1000, 1/100),\n    (\'LDL_Cholesterol\', lambda x: x > 1000, 1/100),\n    (\'HDL_Cholesterol\', lambda x: x > 1000, 1/100),\n    (\'Ferritin\', lambda x: x > 500, 1/10),\n    (\'Prealbumin\', lambda x: x > 50, 1/10),\n    (\'pO2_Arterial\', lambda x: x > 200, 1/7.5),\n    (\'Lactate\', lambda x: x > 10, 1/11.2),\n    (\'Beta2_Microglobulin\', lambda x: x > 10, 1/1000),\n    (\'Aluminum\', lambda x: x > 100, 1/10),\n]\n\nfor feature, condition, factor in conversion_rules:\n    if feature in data_clean.columns:\n        mask = data_clean[feature].apply(condition)\n        if mask.any():\n            data_clean.loc[mask, feature] = data_clean.loc[mask, feature] * factor\n\n# Apply multiple refinement passes\nfor pass_num in range(3):\n    conversions_made = 0\n    for feature, (min_val, max_val) in physiological_ranges.items():\n        if feature not in data_clean.columns:\n            continue\n        \n        # Values below minimum\n        mask_low = data_clean[feature] < min_val\n        if feature in [\'Hemoglobin\', \'Hematocrit\', \'RBC_Count\', \'Total_Protein\', \'Albumin_Serum\']:\n            if mask_low.any() and data_clean.loc[mask_low, feature].min() > 0:\n                data_clean.loc[mask_low, feature] = data_clean.loc[mask_low, feature] * 10\n                conversions_made += mask_low.sum()\n        \n        # Values above maximum\n        mask_high = data_clean[feature] > max_val\n        if feature in [\'Ferritin\', \'BUN\', \'Magnesium\', \'Phosphorus\', \'pO2_Arterial\', \'Lactate\', \'Beta2_Microglobulin\', \'Aluminum\', \'eGFR\']:\n            if mask_high.any():\n                if feature == \'eGFR\' and data_clean.loc[mask_high, feature].max() > 500:\n                    data_clean.loc[mask_high, feature] = data_clean.loc[mask_high, feature] / 10\n                elif feature in [\'Ferritin\', \'BUN\', \'Magnesium\', \'Phosphorus\']:\n                    data_clean.loc[mask_high, feature] = data_clean.loc[mask_high, feature] / 10\n                elif feature in [\'pO2_Arterial\', \'Lactate\']:\n                    data_clean.loc[mask_high, feature] = data_clean.loc[mask_high, feature] / 10\n                elif feature in [\'Beta2_Microglobulin\', \'Aluminum\']:\n                    data_clean.loc[mask_high, feature] = data_clean.loc[mask_high, feature] / 100\n                conversions_made += mask_high.sum()\n    \n    if conversions_made == 0:\n        break\n    print(f"Pass {pass_num + 1}: {conversions_made} values converted")\n\n# Round all values to 2 decimal places\nfor col in data_clean.columns[1:]:\n    data_clean[col] = data_clean[col].round(2)\n\n# Format as X.XX\nfor col in data_clean.columns[1:]:\n    data_clean[col] = data_clean[col].apply(lambda x: f"{x:.2f}")\n\nprint(f"\\nFinal data shape: {data_clean.shape}")\nprint(f"\\nSample of final data:")\nprint(data_clean[[\'patient_id\', \'Serum_Creatinine\', \'Hemoglobin\', \'Ferritin\', \'BUN\', \'pO2_Arterial\', \'Lactate\']].head(10))\n\n# Save to output file\noutput_path = \'/root/ckd_lab_data_harmonized.csv\'\ndata_clean.to_csv(output_path, index=False)\nprint(f"\\nData saved to {output_path}")\n\nENDSCRIPT\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
