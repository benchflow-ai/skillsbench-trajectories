Sending keys: ['cat << \'EOF\' > solution.py\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook(\'/root/data/openipf.xlsx\')\nsheet_data = wb[\'Data\']\nsheet_dots = wb[\'Dots\']\n\n# Step 1: Find columns\nheaders = [cell.value for cell in sheet_data[1]]\nrequired_columns = [\'Name\', \'Sex\', \'BodyweightKg\', \'Best3SquatKg\', \'Best3BenchKg\', \'Best3DeadliftKg\']\ncol_indices = {name: headers.index(name) + 1 for name in required_columns}\n\n# Copy headers and data to \'Dots\' sheet\nfor i, name in enumerate(required_columns, 1):\n    sheet_dots.cell(row=1, column=i, value=name)\n\nfor row_idx, row in enumerate(sheet_data.iter_rows(min_row=2, values_only=True), 2):\n    for i, name in enumerate(required_columns, 1):\n        sheet_dots.cell(row=row_idx, column=i, value=row[col_indices[name]-1])\n\n# Step 2: TotalKg column\ntotal_kg_col = len(required_columns) + 1\nsheet_dots.cell(row=1, column=total_kg_col, value=\'TotalKg\')\n\n# Find indices for lifts in \'Dots\' sheet\ndots_headers = [cell.value for cell in sheet_dots[1]]\nsquat_idx = get_column_letter(dots_headers.index(\'Best3SquatKg\') + 1)\nbench_idx = get_column_letter(dots_headers.index(\'Best3BenchKg\') + 1)\ndeadlift_idx = get_column_letter(dots_headers.index(\'Best3DeadliftKg\') + 1)\n\nfor row_idx in range(2, sheet_dots.max_row + 1):\n    formula = f\'={squat_idx}{row_idx}+{bench_idx}{row_idx}+{deadlift_idx}{row_idx}\'\n    sheet_dots.cell(row=row_idx, column=total_kg_col, value=formula)\n\n# Step 3: Dots column\ndots_col = total_kg_col + 1\nsheet_dots.cell(row=1, column=dots_col, value=\'Dots\')\n\nsex_idx = get_column_letter(dots_headers.index(\'Sex\') + 1)\nbw_idx = get_column_letter(dots_headers.index(\'BodyweightKg\') + 1)\ntotal_idx = get_column_letter(total_kg_col)\n\n# Dots formula\n# Dots = X * 500 / (Aw^4 + Bw^3 + Cw^2 + Dw + E)\n# Men: A = -0.0000010930, B = 0.0007391293, C = -0.1918759221, D = 24.0900756, E = -307.75076\n# Women: A = -0.0000010706, B = 0.0005158568, C = -0.1126655495, D = 13.6175032, E = -57.96288\n\nfor row_idx in range(2, sheet_dots.max_row + 1):\n    # We use IF to check Sex\n    # Men\n    am, bm, cm, dm, em = -0.0000010930, 0.0007391293, -0.1918759221, 24.0900756, -307.75076\n    # Women\n    aw, bw, cw, dw, ew = -0.0000010706, 0.0005158568, -0.1126655495, 13.6175032, -57.96288\n    \n    w = f\'{bw_idx}{row_idx}\'\n    X = f\'{total_idx}{row_idx}\'\n    sex = f\'{sex_idx}{row_idx}\'\n    \n    formula_m = f\'({am}*POWER({w},4) + {bm}*POWER({w},3) + {cm}*POWER({w},2) + {dm}*{w} + {em})\'\n    formula_w = f\'({aw}*POWER({w},4) + {bw}*POWER({w},3) + {cw}*POWER({w},2) + {dw}*{w} + {ew})\'\n    \n    # Dots = X * 500 / denominator\n    full_formula = f\'=ROUND({X}*500/IF({sex}="M",{formula_m},{formula_w}), 3)\'\n    sheet_dots.cell(row=row_idx, column=dots_col, value=full_formula)\n\nwb.save("/root/data/openipf.xlsx")\nEOF\npython3 solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
