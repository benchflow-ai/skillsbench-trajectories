Sending keys: ['cat <<EOF > /root/workspace/solution.py\nimport pdfplumber\nimport pubchempy as pcp\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem, DataStructs\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    # Helper to get fingerprint\n    def get_fp(name):\n        try:\n            # Use PubChem to get SMILES\n            # We use isomeric_smiles to respect chirality if available, though name->structure might be ambiguous\n            compounds = pcp.get_compounds(name, \'name\')\n            if not compounds:\n                return None\n            # Use the first compound found\n            smiles = compounds[0].isomeric_smiles\n            if not smiles:\n                return None\n            \n            mol = Chem.MolFromSmiles(smiles)\n            if not mol:\n                return None\n            \n            # Morgan fingerprints with Tanimoto similarity (radius = 2, include chirality)\n            return AllChem.GetMorganFingerprintAsBitVect(mol, 2, useChirality=True)\n        except Exception:\n            return None\n\n    # Get target fingerprint\n    target_fp = get_fp(target_molecule_name)\n    if target_fp is None:\n        # If we can\'t process the target, we can\'t compute similarity\n        return []\n\n    # Read PDF to get candidate names\n    candidates = set()\n    try:\n        with pdfplumber.open(molecule_pool_filepath) as pdf:\n            for page in pdf.pages:\n                text = page.extract_text()\n                if text:\n                    for line in text.split(\'\\n\'):\n                        line = line.strip()\n                        if line:\n                            candidates.add(line)\n    except Exception as e:\n        # If PDF reading fails\n        print(f"Error reading PDF: {e}")\n        return []\n\n    candidate_scores = []\n    for name in candidates:\n        fp = get_fp(name)\n        if fp:\n            sim = DataStructs.TanimotoSimilarity(target_fp, fp)\n            candidate_scores.append((name, sim))\n    \n    # Sort: Descending similarity (-x[1]), then Ascending name (x[0])\n    candidate_scores.sort(key=lambda x: (-x[1], x[0]))\n    \n    return [x[0] for x in candidate_scores[:top_k]]\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
