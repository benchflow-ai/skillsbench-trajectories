Sending keys: ['cat <<EOF > estimate.py\nimport json\nimport numpy as np\nfrom sklearn.linear_model import LinearRegression\n\ndef estimate():\n    with open(\'calibration_log.json\', \'r\') as f:\n        cal_data = json.load(f)\n    \n    data = cal_data[\'data\']\n    u = cal_data[\'heater_power_test\']\n    \n    # Get T_ambient from the first data point (before heater starts or at t=0)\n    T_ambient = 18.0 # From config, but let\'s see if we can get it from data\n    # Actually, the first point is at t=0, T is T_ambient + noise.\n    \n    X = []\n    y = []\n    \n    for i in range(len(data) - 1):\n        T_curr = data[i][\'temperature\']\n        T_next = data[i+1][\'temperature\']\n        dt = data[i+1][\'time\'] - data[i][\'time\']\n        \n        if dt <= 0: continue\n        \n        # T_next = T_curr + (dt/tau) * (K*u + T_amb - T_curr)\n        # T_next = (1 - dt/tau) * T_curr + (dt/tau) * (K*u + T_amb)\n        # Let T_next = a * T_curr + b\n        X.append([T_curr])\n        y.append(T_next)\n\n    X = np.array(X)\n    y = np.array(y)\n    \n    model = LinearRegression()\n    model.fit(X, y)\n    \n    a = model.coef_[0]\n    b = model.intercept_\n    r_squared = model.score(X, y)\n    \n    dt = 0.5 # known from config\n    tau = dt / (1 - a)\n    # b = (dt/tau) * (K*u + T_amb) => K*u + T_amb = b / (dt/tau) = b / (1-a)\n    K = (b / (1 - a) - T_ambient) / u\n    \n    # Calculate fitting error\n    predictions = model.predict(X)\n    fitting_error = np.sqrt(np.mean((y - predictions)**2))\n\n    params = {\n        "K": float(K),\n        "tau": float(tau),\n        "r_squared": float(r_squared),\n        "fitting_error": float(fitting_error)\n    }\n    \n    with open(\'estimated_params.json\', \'w\') as f:\n        json.dump(params, f, indent=2)\n    print(f"Estimation complete: K={K:.4f}, tau={tau:.4f}, R2={r_squared:.4f}")\n\nif __name__ == "__main__":\n    estimate()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
