Sending keys: ['cat <<EOF > solve.py\nimport pandas as pd\nimport numpy as np\n\ndef score_high_and_often(rolls):\n    m = max(rolls)\n    return m * rolls.count(m)\n\ndef score_summation(rolls):\n    return sum(rolls)\n\ndef score_highs_and_lows(rolls):\n    h = max(rolls)\n    l = min(rolls)\n    return h * l * (h - l)\n\ndef score_only_two_numbers(rolls):\n    return 30 if len(set(rolls)) == 2 else 0\n\ndef score_all_the_numbers(rolls):\n    return 40 if sorted(rolls) == [1, 2, 3, 4, 5, 6] else 0\n\ndef score_ordered_subset(rolls):\n    # Check for run of 4 consecutive increasing or decreasing\n    # Differences between adjacent elements must be 1 or -1 for 3 consecutive steps\n    for i in range(len(rolls) - 3):\n        sub = rolls[i:i+4]\n        # Check increasing\n        if all(sub[j+1] == sub[j] + 1 for j in range(3)):\n            return 50\n        # Check decreasing\n        if all(sub[j+1] == sub[j] - 1 for j in range(3)):\n            return 50\n    return 0\n\ncategories = [\'HO\', \'S\', \'HL\', \'OTN\', \'ATN\', \'OSF\']\n\ndef get_turn_scores(rolls):\n    scores = {}\n    scores[\'HO\'] = score_high_and_often(rolls)\n    scores[\'S\'] = score_summation(rolls)\n    scores[\'HL\'] = score_highs_and_lows(rolls)\n    scores[\'OTN\'] = score_only_two_numbers(rolls)\n    scores[\'ATN\'] = score_all_the_numbers(rolls)\n    scores[\'OSF\'] = score_ordered_subset(rolls)\n    return scores\n\n# Load data\ndf = pd.read_excel(\'/root/data.xlsx\', sheet_name=\'Data\', header=8)\n\n# Filter out rows where Game number is NaN (end of data)\ndf = df[df[\'Game number\'].notna()]\n\n# Ensure rolls are integers\nroll_cols = [f\'Roll {i}\' for i in range(1, 7)]\ndf[roll_cols] = df[roll_cols].astype(int)\n\ngame_scores = {}\n\n# Process each game\nfor game_num, group in df.groupby(\'Game number\'):\n    if len(group) != 2:\n        continue # Should be 2 turns per game\n    \n    # Get rolls for the two turns\n    rolls1 = group.iloc[0][roll_cols].tolist()\n    rolls2 = group.iloc[1][roll_cols].tolist()\n    \n    scores1 = get_turn_scores(rolls1)\n    scores2 = get_turn_scores(rolls2)\n    \n    max_score = -1\n    \n    # Find max combined score with different categories\n    for c1 in categories:\n        for c2 in categories:\n            if c1 == c2:\n                continue\n            current_score = scores1[c1] + scores2[c2]\n            if current_score > max_score:\n                max_score = current_score\n                \n    game_scores[int(game_num)] = max_score\n\n# Match logic\n# Player 1: Odd games (1, 3, 5...)\n# Player 2: Even games (2, 4, 6...)\n# Match 1: Game 1 vs Game 2\n# Match k: Game 2k-1 vs Game 2k\n\np1_wins = 0\np2_wins = 0\n\nsorted_games = sorted(game_scores.keys())\nmax_game = max(sorted_games)\nnum_matches = max_game // 2\n\nfor i in range(1, num_matches + 1):\n    g1 = 2*i - 1\n    g2 = 2*i\n    \n    if g1 in game_scores and g2 in game_scores:\n        s1 = game_scores[g1]\n        s2 = game_scores[g2]\n        \n        if s1 > s2:\n            p1_wins += 1\n        elif s2 > s1:\n            p2_wins += 1\n\nresult = p1_wins - p2_wins\nprint(f"P1 Wins: {p1_wins}")\nprint(f"P2 Wins: {p2_wins}")\nprint(f"Result: {result}")\n\nwith open(\'/root/answer.txt\', \'w\') as f:\n    f.write(str(result))\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
