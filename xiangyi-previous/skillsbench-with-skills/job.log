nly=True):\n    if row[0] is None: continue\n    year=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    shares[year]=dict(zip(headers_sh,vals))\n\nfor year in budgets:\n    total=budgets[year]['Total']\n    for k in headers_sh:\n        if shares[year].get(k) is None and budgets[year].get(k) is not None and total is not None:\n            share=budgets[year][k]/total*100\n            print('Share',year,k, round(share,2))\n\n# Growth analysis computations\nws_g=wb['Growth Analysis']\nheaders_g=[cell.value for cell in ws_g[3]][1:]\nrows=list(ws_g.iter_rows(min_row=4, values_only=True))\n# create mapping for metrics\nmetrics={}\nfor row in rows:\n    metric=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    metrics[metric]=dict(zip(headers_g,vals))\n\n# compute missing in growth analysis\n# CAGR for Exploration\nimport math\nif metrics['5-Year CAGR (%)']['Exploration'] is None:\n    b2019=budgets[2019]['Exploration']\n    b2024=budgets[2024]['Exploration']\n    cagr=(b2024/b2019)**(1/5)-1\n    print('CAGR Exploration', round(cagr*100,2))\n# FY2019 budget for Exploration\nif metrics['FY2019 Budget ($M)']['Exploration'] is None:\n    print('FY2019 Exploration', budgets[2019]['Exploration'])\n# 5-year change for Science\nif metrics['5-Year Change ($M)']['Science'] is None:\n    change=budgets[2024]['Science']-budgets[2019]['Science']\n    print('5-year change Science', change)\n# Avg Annual Budget for Science\nif metrics['Avg Annual Budget ($M)']['Science'] is None:\n    # average 2019-2024 inclusive\n    avg=sum(budgets[y]['Science'] for y in range(2019,2025))/6\n    print('Avg annual Science', round(avg,1))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
