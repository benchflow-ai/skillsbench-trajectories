not in Excel)\nfor emp_id in pdf_records:\n    if emp_id not in excel_records:\n        deleted_employees.append(emp_id)\n\n# Check for modifications (in both)\ncolumns_to_compare = [\'First\', \'Last\', \'Dept\', \'Position\', \'Salary\', \'Years\', \'Location\', \'Score\']\n\nfor emp_id, old_rec in pdf_records.items():\n    if emp_id in excel_records:\n        new_rec = excel_records[emp_id]\n        for field in columns_to_compare:\n            old_val = old_rec[field]\n            new_val = new_rec[field]\n            \n            # Compare\n            if old_val != new_val:\n                # Handle potential floating point epsilon issues if necessary, \n                # but simple equality usually works for simple decimals like 4.3 vs 4.3\n                # If strict equality fails for floats, we might need math.isclose, \n                # but let\'s assume standard values.\n                \n                modified_employees.append({\n                    "id": emp_id,\n                    "field": field,\n                    "old_value": old_val,\n                    "new_value": new_val\n                })\n\n# 4. Sort results\ndeleted_employees.sort()\nmodified_employees.sort(key=lambda x: x[\'id\'])\n\noutput = {\n    "deleted_employees": deleted_employees,\n    "modified_employees": modified_employees\n}\n\n# 5. Write JSON\nwith open(\'/root/diff_report.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint("Comparison complete. Report generated.")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
