Sending keys: ['cat > seismic_analysis.py << \'EOF\'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import read, UTCDateTime\nimport seisbench.models as sbm\nfrom datetime import datetime\nfrom sklearn.cluster import DBSCAN\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nprint("Loading waveform data...")\nst = read(\'/root/data/wave.mseed\')\nprint(f"Loaded {len(st)} traces")\n\nprint("\\nLoading station data...")\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\n\n# Create station lookup\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = f"{row[\'network\']}.{row[\'station\']}"\n    if key not in station_lookup:\n        station_lookup[key] = {\n            \'latitude\': row[\'latitude\'],\n            \'longitude\': row[\'longitude\'],\n            \'elevation_m\': row[\'elevation_m\']\n        }\n\nprint(f"Unique stations: {len(station_lookup)}")\n\nprint("\\nLoading EQTransformer model (faster than PhaseNet)...")\nmodel = sbm.EQTransformer.from_pretrained("original")\nmodel.eval()\nprint("Model loaded successfully")\n\n# Group traces by station\nfrom collections import defaultdict\nstation_streams = defaultdict(list)\nfor tr in st:\n    station_id = f"{tr.stats.network}.{tr.stats.station}"\n    station_streams[station_id].append(tr)\n\nprint(f"Grouped into {len(station_streams)} stations")\n\nall_picks = []\n\nfor station_id, traces in station_streams.items():\n    print(f"Processing {station_id}...", end=\' \')\n    \n    try:\n        station_st = obspy.Stream(traces)\n        \n        # Get Z, N, E components\n        z_tr = station_st.select(channel="*Z")[0] if len(station_st.select(channel="*Z")) > 0 else None\n        n_tr = station_st.select(channel="*N")[0] if len(station_st.select(channel="*N")) > 0 else None\n        e_tr = station_st.select(channel="*E")[0] if len(station_st.select(channel="*E")) > 0 else None\n        \n        if z_tr is None:\n            print("No Z component, skipping")\n            continue\n        \n        # Prepare 3-component data\n        z_data = z_tr.data.astype(np.float32)\n        \n        if n_tr is not None and e_tr is not None:\n            n_data = n_tr.data.astype(np.float32)\n            e_data = e_tr.data.astype(np.float32)\n        else:\n            n_data = z_data.copy()\n            e_data = z_data.copy()\n        \n        # Stack into (3, N) array\n        data_3c = np.stack([z_data, n_data, e_data], axis=0)\n        \n        # Use SeisBench\'s annotate method (handles windowing internally)\n        annotations = model.annotate(data_3c)\n        \n        # Get picks from annotations\n        picks = model.classify(data_3c, P_threshold=0.3, S_threshold=0.3)\n        \n        # Convert picks to absolute times\n        sr = z_tr.stats.sampling_rate\n        start_time = z_tr.stats.starttime\n        \n        if picks.p_picks is not None:\n            for pick_sample, pick_prob in zip(picks.p_picks, picks.p_probs):\n                pick_time = start_time + (pick_sample / sr)\n                all_picks.append({\n                    \'station\': station_id,\n                    \'time\': pick_time,\n                    \'phase\': \'P\',\n                    \'probability\': float(pick_prob)\n                })\n        \n        if picks.s_picks is not None:\n            for pick_sample, pick_prob in zip(picks.s_picks, picks.s_probs):\n                pick_time = start_time + (pick_sample / sr)\n                all_picks.append({\n                    \'station\': station_id,\n                    \'time\': pick_time,\n                    \'phase\': \'S\',\n                    \'probability\': float(pick_prob)\n                })\n        \n        n_picks = len([p for p in all_picks if p[\'station\'] == station_id])\n        print(f"{n_picks} picks")\n        \n    except Exception as e:\n        print(f"Error: {e}")\n        continue\n\nprint(f"\\nTotal picks: {len(all_picks)}")\n\nif len(all_picks) == 0:\n    print("No picks found!")\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n    exit(0)\n\npicks_df = pd.DataFrame(all_picks)\nprint(f"P picks: {len(picks_df[picks_df[\'phase\'] == \'P\'])}")\nprint(f"S picks: {len(picks_df[picks_df[\'phase\'] == \'S\'])}")\n\n# Event association\nprint("\\nAssociating picks to events...")\n\nmean_lat = np.mean([s[\'latitude\'] for s in station_lookup.values()])\nmean_lon = np.mean([s[\'longitude\'] for s in station_lookup.values()])\n\nvp = 6.0  # km/s\nvs = vp / 1.75  # km/s\n\n# Estimate origin times\norigin_times = []\nfor pick in all_picks:\n    station_id = pick[\'station\']\n    if station_id not in station_lookup:\n        continue\n    \n    station_info = station_lookup[station_id]\n    \n    lat_diff = station_info[\'latitude\'] - mean_lat\n    lon_diff = station_info[\'longitude\'] - mean_lon\n    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\n    distance_km = distance_deg * 111.0\n    \n    if pick[\'phase\'] == \'P\':\n        travel_time = distance_km / vp\n    else:\n        travel_time = distance_km / vs\n    \n    origin_time = pick[\'time\'] - travel_time\n    origin_times.append(origin_time.timestamp)\n\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\n# Cluster with DBSCAN\ndbscan = DBSCAN(eps=5.0, min_samples=3)\ncluster_labels = dbscan.fit_predict(origin_times_array)\n\nprint(f"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters")\n\n# Extract events\nevents = []\nfor cluster_id in set(cluster_labels):\n    if cluster_id == -1:\n        continue\n    \n    cluster_mask = cluster_labels == cluster_id\n    cluster_origin_times = origin_times_array[cluster_mask]\n    \n    event_time = np.median(cluster_origin_times)\n    events.append({\n        \'time\': datetime.utcfromtimestamp(event_time).isoformat(),\n        \'num_picks\': int(np.sum(cluster_mask))\n    })\n\nevents_df = pd.DataFrame(events)\nevents_df = events_df.sort_values(\'time\').reset_index(drop=True)\n\nprint(f"\\nFinal event count: {len(events_df)}")\nprint(events_df)\n\nevents_df.to_csv(\'/root/results.csv\', index=False)\nprint("\\nResults saved to /root/results.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
