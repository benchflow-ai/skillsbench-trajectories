Sending keys: ["cat > solve_dcopf.py << 'PART1'\nimport json\nimport numpy as np\nimport cvxpy as cp\n\ndef load_network(filename):\n    with open(filename, 'r') as f:\n        return json.load(f)\n\ndef solve_dcopf_with_reserves(data, branch_modifications=None):\n    baseMVA = data['baseMVA']\n    buses = np.array(data['bus'])\n    gens = np.array(data['gen'])\n    branches = np.array(data['branch']).copy()\n    gencost = np.array(data['gencost'])\n    reserve_capacity = np.array(data['reserve_capacity'])\n    reserve_requirement = data['reserve_requirement']\n    \n    if branch_modifications:\n        for branch_idx, new_limit in branch_modifications.items():\n            branches[branch_idx, 5] = new_limit\n    \n    n_bus = len(buses)\n    n_gen = len(gens)\n    n_branch = len(branches)\n    \n    bus_nums = buses[:, 0].astype(int)\n    bus_idx = {int(num): i for i, num in enumerate(bus_nums)}\n    \n    gen_status = gens[:, 7]\n    active_gens = gen_status == 1\n    \n    pg = cp.Variable(n_gen)\n    theta = cp.Variable(n_bus)\n    reserve = cp.Variable(n_gen)\n    \n    costs = []\n    reserve_costs = []\n    \n    for i in range(n_gen):\n        if not active_gens[i]:\n            continue\n        cost_data = gencost[i]\n        ncost = int(cost_data[3])\n        coeffs = cost_data[4:4+ncost]\n        \n        if ncost == 3:\n            costs.append(coeffs[0] * cp.square(pg[i]) + coeffs[1] * pg[i] + coeffs[2])\n        elif ncost == 2:\n            costs.append(coeffs[0] * pg[i] + coeffs[1])\n        else:\n            costs.append(coeffs[-1])\n        \n        marginal_cost = coeffs[-2] if len(coeffs) >= 2 else 10.0\n        reserve_costs.append(0.1 * marginal_cost * reserve[i])\n    \n    objective = cp.Minimize(cp.sum(costs) + cp.sum(reserve_costs))\n    constraints = []\nPART1\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
