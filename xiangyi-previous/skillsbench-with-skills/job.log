Sending keys: ["cat <<'EOF' > /root/process.js\nimport * as THREE from 'three';\nimport { OBJExporter } from 'three/examples/jsm/exporters/OBJExporter.js';\nimport { createScene } from './data/object.js';\nimport fs from 'fs';\nimport path from 'path';\n\nconst root = createScene();\nconst outputDir = '/root/output';\nconst partMeshesDir = path.join(outputDir, 'part_meshes');\nconst linksDir = path.join(outputDir, 'links');\n\nif (!fs.existsSync(partMeshesDir)) fs.mkdirSync(partMeshesDir, { recursive: true });\nif (!fs.existsSync(linksDir)) fs.mkdirSync(linksDir, { recursive: true });\n\nconst exporter = new OBJExporter();\n\nfunction exportPart(obj) {\n    const partName = obj.name || 'unnamed_part';\n    console.log('Processing part:', partName);\n\n    const partPath = path.join(partMeshesDir, partName);\n    if (!fs.existsSync(partPath)) fs.mkdirSync(partPath, { recursive: true });\n\n    // 1. Export meshes that are direct children of this group\n    obj.children.forEach(child => {\n        if (child.isMesh) {\n            const meshName = child.name || 'unnamed_mesh';\n            const objData = exporter.parse(child);\n            fs.writeFileSync(path.join(partPath, meshName + '.obj'), objData);\n        }\n    });\n\n    // 2. Export the part itself for links folder, excluding child groups\n    const childrenToRemove = obj.children.filter(child => child.isGroup);\n    childrenToRemove.forEach(child => obj.remove(child));\n    \n    const partObjData = exporter.parse(obj);\n    fs.writeFileSync(path.join(linksDir, partName + '.obj'), partObjData);\n\n    // Restore children for further traversal\n    childrenToRemove.forEach(child => obj.add(child));\n}\n\nfunction traverse(obj) {\n    if (obj.isGroup && obj !== root) {\n        exportPart(obj);\n    }\n    \n    [...obj.children].forEach(child => {\n        traverse(child);\n    });\n}\n\ntraverse(root);\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
