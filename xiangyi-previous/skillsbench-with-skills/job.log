    "software development",\n        "scientific research",\n        "business strategy",\n        "cloud computing",\n        "network security",\n        "database optimization",\n        "parallel processing",\n        "distributed systems",\n    ] * 20  # 200 queries\n\n    print(f"\\nSearching with {len(test_queries)} queries (sequential)...")\n    seq_search_start = time.perf_counter()\n    seq_search_results = batch_search_sequential(test_queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - seq_search_start\n    print(f"Sequential: {seq_search_time*1000:.2f}ms")\n\n    for num_workers in [1, 2, 4]:\n        print(f"\\nSearching with {len(test_queries)} queries (parallel, {num_workers} workers)...")\n        par_search_results, par_search_time = batch_search_parallel(\n            test_queries, seq_result.index, top_k=10, num_workers=num_workers, documents=documents\n        )\n        print(f"Parallel: {par_search_time*1000:.2f}ms")\n        speedup = seq_search_time / par_search_time\n        print(f"Speedup: {speedup:.2f}x")\n        if num_workers == 4:\n            if speedup >= 2.0:\n                print("✓ Target speedup (2.0x) ACHIEVED")\n            else:\n                print(f"✗ Target speedup (2.0x) not met: {speedup:.2f}x")\n\n    print("\\n" + "=" * 70)\n    print("Final test completed!")\n    print("=" * 70)\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
