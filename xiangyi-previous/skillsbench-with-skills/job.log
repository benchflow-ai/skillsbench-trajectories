Sending keys: ['cat << \'EOF\' > detect_anomalies.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.linear_model import LinearRegression\n\n# Load cleaned data\npurchases = pd.read_csv(\'/app/output/amazon-purchases-2019-2020-filtered.csv\', parse_dates=[\'Order Date\'])\n\n# Aggregate daily sales by category\ndaily_sales = purchases.groupby([\'Category\', \'Order Date\'])[\'Total_Spend\'].sum().reset_index()\n\ncategories = daily_sales[\'Category\'].unique()\nanomaly_results = []\n\ntarget_start = pd.Timestamp(\'2020-03-01\')\ntarget_end = pd.Timestamp(\'2020-03-31\')\n\nfor cat in categories:\n    cat_data = daily_sales[daily_sales[\'Category\'] == cat].copy()\n    cat_data = cat_data.sort_values(\'Order Date\')\n    \n    # Split into historical and target\n    hist_data = cat_data[cat_data[\'Order Date\'] < target_start]\n    target_data = cat_data[(cat_data[\'Order Date\'] >= target_start) & (cat_data[\'Order Date\'] <= target_end)]\n    \n    if len(hist_data) < 10:\n        continue\n        \n    # Prepare features for prediction (trend and day of week)\n    hist_data[\'days_since_start\'] = (hist_data[\'Order Date\'] - hist_data[\'Order Date\'].min()).dt.days\n    hist_data[\'dow\'] = hist_data[\'Order Date\'].dt.dayofweek\n    \n    X_hist = pd.get_dummies(hist_data[[\'days_since_start\', \'dow\']], columns=[\'dow\'])\n    y_hist = hist_data[\'Total_Spend\']\n    \n    model = LinearRegression()\n    model.fit(X_hist, y_hist)\n    \n    # Predict for March 2020\n    # We need to create a range of dates for March 2020 to predict even if there were no sales on some days\n    march_dates = pd.date_range(start=target_start, end=target_end)\n    march_df = pd.DataFrame({\'Order Date\': march_dates})\n    march_df[\'days_since_start\'] = (march_df[\'Order Date\'] - hist_data[\'Order Date\'].min()).dt.days\n    march_df[\'dow\'] = march_df[\'Order Date\'].dt.dayofweek\n    \n    X_march = pd.get_dummies(march_df[[\'days_since_start\', \'dow\']], columns=[\'dow\'])\n    # Ensure all dow columns from training are present\n    for col in X_hist.columns:\n        if col not in X_march.columns:\n            X_march[col] = 0\n    X_march = X_march[X_hist.columns]\n    \n    y_pred = model.predict(X_march)\n    y_pred = np.maximum(y_pred, 0) # No negative sales predicted\n    \n    actual_march_sales = target_data[\'Total_Spend\'].sum()\n    predicted_march_sales = y_pred.sum()\n    \n    if predicted_march_sales + actual_march_sales > 0:\n        # Deviation index from -100 to 100\n        index = 100 * (actual_march_sales - predicted_march_sales) / (actual_march_sales + predicted_march_sales)\n    else:\n        index = 0\n        \n    anomaly_results.append({\'Category\': cat, \'Anomaly_Index\': index, \'Actual\': actual_march_sales, \'Predicted\': predicted_march_sales})\n\nanomaly_df = pd.DataFrame(anomaly_results)\nanomaly_df.to_csv(\'/app/output/category_anomaly_index.csv\', index=False, columns=[\'Category\', \'Anomaly_Index\'])\n\n# Identify top 10 surge and slump\nsurge = anomaly_df.sort_values(\'Anomaly_Index\', ascending=False).head(10)\nslump = anomaly_df.sort_values(\'Anomaly_Index\', ascending=True).head(10)\n\nprint("Top 10 Surge Categories:")\nprint(surge[[\'Category\', \'Anomaly_Index\']])\nprint("\\nTop 10 Slump Categories:")\nprint(slump[[\'Category\', \'Anomaly_Index\']])\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
