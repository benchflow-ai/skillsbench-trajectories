Sending keys: ['cat > /root/create_compilation.py << \'EOF\'\nimport json\nimport subprocess\nimport os\n\n# Load annotations\nwith open(\'/root/annotations.json\', \'r\') as f:\n    fillers = json.load(f)\n\nprint(f"Processing {len(fillers)} filler word clips...")\n\n# Create temporary directory for clips\nos.makedirs(\'/tmp/clips\', exist_ok=True)\n\n# Extract each clip (1.5 seconds: 0.5 before, 1.0 after the timestamp)\nclip_files = []\nfor i, filler in enumerate(fillers):\n    timestamp = filler[\'timestamp\']\n    start_time = max(0, timestamp - 0.5)  # 0.5 seconds before\n    duration = 1.5  # Total duration of clip\n    \n    output_file = f\'/tmp/clips/clip_{i:04d}.mp4\'\n    clip_files.append(output_file)\n    \n    # Extract clip using ffmpeg\n    cmd = [\n        \'ffmpeg\', \'-y\', \'-i\', \'/root/input.mp4\',\n        \'-ss\', str(start_time),\n        \'-t\', str(duration),\n        \'-c:v\', \'libx264\', \'-c:a\', \'aac\',\n        \'-avoid_negative_ts\', \'make_zero\',\n        output_file\n    ]\n    \n    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    if (i + 1) % 10 == 0:\n        print(f"Extracted {i + 1}/{len(fillers)} clips...")\n\nprint(f"Extracted all {len(fillers)} clips")\n\n# Create concat file for ffmpeg\nconcat_file = \'/tmp/clips/concat.txt\'\nwith open(concat_file, \'w\') as f:\n    for clip_file in clip_files:\n        f.write(f"file \'{clip_file}\'\\n")\n\nprint("Concatenating clips...")\n# Concatenate all clips\ncmd = [\n    \'ffmpeg\', \'-y\', \'-f\', \'concat\', \'-safe\', \'0\',\n    \'-i\', concat_file,\n    \'-c\', \'copy\',\n    \'/root/output.mp4\'\n]\n\nresult = subprocess.run(cmd, capture_output=True, text=True)\nif result.returncode == 0:\n    print("Successfully created /root/output.mp4")\nelse:\n    print("Error concatenating clips, trying with re-encoding...")\n    # Try again with re-encoding if copy fails\n    cmd = [\n        \'ffmpeg\', \'-y\', \'-f\', \'concat\', \'-safe\', \'0\',\n        \'-i\', concat_file,\n        \'-c:v\', \'libx264\', \'-c:a\', \'aac\',\n        \'/root/output.mp4\'\n    ]\n    subprocess.run(cmd)\n    print("Created /root/output.mp4 with re-encoding")\n\n# Cleanup\nimport shutil\nshutil.rmtree(\'/tmp/clips\')\nprint("Cleanup complete")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
