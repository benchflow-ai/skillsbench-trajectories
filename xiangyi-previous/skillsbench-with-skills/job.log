Sending keys: ['cat > /root/final_analysis.py << \'EOF\'\nimport numpy as np\nfrom scipy import signal\nfrom scipy.ndimage import median_filter\nfrom astropy.timeseries import BoxLeastSquares\n\n# Load data\ndata = np.loadtxt(\'/root/data/tess_lc.txt\', comments=\'#\')\ntime = data[:, 0]\nflux = data[:, 1]\nflag = data[:, 2]\nflux_err = data[:, 3]\n\n# Filter by quality flag\nmask = flag == 0\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\n# Remove outliers - more aggressive\nmedian_flux = np.median(flux)\nstd_flux = np.std(flux)\nmask = np.abs(flux - median_flux) < 3.5 * std_flux\ntime = time[mask]\nflux = flux[mask]\nflux_err = flux_err[mask]\n\nprint(f"Data points: {len(time)}")\nprint(f"Time span: {time.max() - time.min():.2f} days")\n\n# Iterative detrending - mask transits and re-fit\ntime_step = np.median(np.diff(time))\n\n# First pass: rough detrending\nwindow_points = int(1.0 / time_step)  # 1 day window\nif window_points % 2 == 0:\n    window_points += 1\n\ntrend1 = signal.savgol_filter(flux, window_points, 3)\nflux_dt1 = flux / trend1\n\n# Identify potential transits (low points)\ntransit_mask = flux_dt1 < (1 - 2*np.std(flux_dt1))\nprint(f"Potential transit points: {np.sum(transit_mask)}")\n\n# Second pass: fit trend excluding transit points\nflux_masked = flux.copy()\nflux_masked[transit_mask] = np.nan\n\n# Interpolate over masked points\nvalid_mask = ~np.isnan(flux_masked)\nflux_interp = np.interp(time, time[valid_mask], flux_masked[valid_mask])\n\n# Smooth the interpolated flux\ntrend2 = signal.savgol_filter(flux_interp, window_points, 3)\nflux_detrended = flux / trend2\n\nprint(f"Detrended flux range: {flux_detrended.min():.6f} to {flux_detrended.max():.6f}")\nprint(f"Detrended flux std: {np.std(flux_detrended):.6f}")\n\n# Use astropy BLS with wider period search\nmodel = BoxLeastSquares(time, flux_detrended)\n\n# Search periods from 0.3 to 20 days\nperiods = np.linspace(0.3, 20, 15000)\n\n# Range of transit durations\ndurations = np.array([0.03, 0.05, 0.07, 0.1, 0.13, 0.16])  # days\n\nprint("Running BLS periodogram...")\nresult = model.power(periods, durations)\n\nbest_period = result.period[np.argmax(result.power)]\nbest_power = np.max(result.power)\n\nprint(f"\\nBest period: {best_period:.5f} days")\nprint(f"Best power: {best_power:.6f}")\n\n# Check top 15 periods\nsorted_idx = np.argsort(result.power)[::-1]\nprint("\\nTop 15 periods:")\nseen_periods = []\nfor i in range(min(50, len(sorted_idx))):\n    idx = sorted_idx[i]\n    p = result.period[idx]\n    # Skip if too close to already seen period\n    if not any(abs(p - sp) < 0.1 for sp in seen_periods):\n        seen_periods.append(p)\n        print(f"  {p:.5f} days, power={result.power[idx]:.6f}")\n    if len(seen_periods) >= 15:\n        break\n\n# Refine around best period\nperiods_fine = np.linspace(best_period - 0.02, best_period + 0.02, 2000)\nperiods_fine = periods_fine[periods_fine > 0.2]\nresult_fine = model.power(periods_fine, durations)\nbest_period_refined = result_fine.period[np.argmax(result_fine.power)]\n\nprint(f"\\nRefined best period: {best_period_refined:.5f} days")\n\n# Calculate expected number of transits\nn_transits = (time.max() - time.min()) / best_period_refined\nprint(f"Expected transits in data: {n_transits:.1f}")\n\n# Phase fold and bin to verify transit\nphase = ((time - time.min()) % best_period_refined) / best_period_refined\nsorted_idx = np.argsort(phase)\nphase_sorted = phase[sorted_idx]\nflux_sorted = flux_detrended[sorted_idx]\n\n# Bin the phase-folded data\nn_bins = 100\nbin_edges = np.linspace(0, 1, n_bins + 1)\nbin_flux = []\nbin_phase = []\nfor i in range(n_bins):\n    mask = (phase_sorted >= bin_edges[i]) & (phase_sorted < bin_edges[i+1])\n    if np.sum(mask) > 0:\n        bin_flux.append(np.median(flux_sorted[mask]))\n        bin_phase.append((bin_edges[i] + bin_edges[i+1]) / 2)\n\nbin_flux = np.array(bin_flux)\nbin_phase = np.array(bin_phase)\n\n# Find minimum (transit)\nmin_idx = np.argmin(bin_flux)\nprint(f"\\nTransit at phase: {bin_phase[min_idx]:.3f}")\nprint(f"Transit depth: {1 - bin_flux[min_idx]:.6f}")\nprint(f"Min binned flux: {bin_flux[min_idx]:.6f}")\nprint(f"Max binned flux: {bin_flux.max():.6f}")\n\n# Write best period\nwith open(\'/root/period.txt\', \'w\') as f:\n    f.write(f"{best_period_refined:.5f}\\n")\nprint(f"\\nPeriod {best_period_refined:.5f} written to /root/period.txt")\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
