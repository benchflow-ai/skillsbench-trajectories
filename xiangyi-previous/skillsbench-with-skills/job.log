ops_share_2016}")\nws3.cell(row=5, column=6).value = space_ops_share_2016\n\n# 2021 Science share (row 10, col 2): 7301/23285 * 100\nscience_share_2021 = round(7301 / 23285 * 100, 2)\nprint(f"2021 Science Share: {science_share_2021}")\nws3.cell(row=10, column=2).value = science_share_2021\nprint("Sheet 3 fixed!")\n\n# ============ SHEET 4: Growth Analysis ============\n# Structure: Row 4=5-Year CAGR, Row 5=FY2019 Budget, Row 6=FY2024 Budget, Row 7=5-Year Change, Row 8=Avg Annual\n# Columns: 2=Science, 3=Aero, 4=Space Tech, 5=Exploration, 6=Space Ops, 7=STEM, 8=Safety, 9=Construction, 10=Inspector\n\n# Exploration 5-Year CAGR (row 4, col 5): ((7618/5047)^(1/5) - 1) * 100\nimport math\nexploration_cagr = round((pow(7618/5047, 1/5) - 1) * 100, 2)\nprint(f"Exploration 5-Year CAGR: {exploration_cagr}")\nws4.cell(row=4, column=5).value = exploration_cagr\n\n# FY2019 Exploration Budget (row 5, col 5): 5047\nprint(f"FY2019 Exploration: 5047")\nws4.cell(row=5, column=5).value = 5047\n\n# Science 5-Year Change (row 7, col 2): 8440 - 6906\nscience_5yr_change = 8440 - 6906\nprint(f"Science 5-Year Change: {science_5yr_change}")\nws4.cell(row=7, column=2).value = science_5yr_change\n\n# Science Avg Annual Budget (row 8, col 2): average of 2019-2024\n# 2019: 6906, 2020: 7139, 2021: 7301, 2022: 7614, 2023: 8262, 2024: 8440\nscience_avg = round((6906 + 7139 + 7301 + 7614 + 8262 + 8440) / 6, 1)\nprint(f"Science Avg Annual: {science_avg}")\nws4.cell(row=8, column=2).value = science_avg\nprint("Sheet 4 fixed!")\n\n# Save the recovered file\nwb.save(\'nasa_budget_recovered.xlsx\')\nprint("\\nFile saved as nasa_budget_recovered.xlsx!")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
