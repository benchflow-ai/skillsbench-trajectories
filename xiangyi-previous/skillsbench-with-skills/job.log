Sending keys: ['cat << \'EOF\' > optimize.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom multiprocessing import Pool\n\ndef load_data():\n    c = pd.read_csv(\'/root/data/citsci_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    e = pd.read_csv(\'/root/data/expert_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    return c, e\n\ndef greedy_match(centroids, expert_pts, max_dist=100):\n    if len(centroids) == 0 or len(expert_pts) == 0: return 0, []\n    dists = cdist(centroids, expert_pts, metric=\'euclidean\')\n    m_c, m_e, matches = set(), set(), []\n    flat = sorted([(dists[i,j], i, j) for i in range(len(centroids)) for j in range(len(expert_pts)) if dists[i,j] <= max_dist])\n    for d, i, j in flat:\n        if i not in m_c and j not in m_e:\n            m_c.add(i); m_e.add(j); matches.append(d)\n    return len(matches), matches\n\ndef eval_img(c_pts, e_pts, ms, eps, sw):\n    if len(c_pts) == 0: return 0.0, np.nan\n    sc = c_pts.copy(); sc[:, 0] *= sw; sc[:, 1] *= (2 - sw)\n    db = DBSCAN(eps=eps, min_samples=ms, metric=\'euclidean\').fit(sc)\n    ctrs = np.array([c_pts[db.labels_ == l].mean(axis=0) for l in set(db.labels_) - {-1}])\n    num, m = greedy_match(ctrs, e_pts)\n    p = num / len(ctrs) if len(ctrs) > 0 else 0\n    r = num / len(e_pts) if len(e_pts) > 0 else 0\n    f1 = 2*p*r/(p+r) if (p+r) > 0 else 0\n    return f1, np.mean(m) if m else np.nan\n\ndef run(p):\n    ms, eps, sw, c_g, e_g, files = p\n    f1s, ds = [], []\n    for f in files:\n        f1, d = eval_img(c_g.get(f, np.empty((0,2))), e_g.get(f, np.empty((0,2))), ms, eps, sw)\n        f1s.append(f1)\n        if not np.isnan(d): ds.append(d)\n    return (np.mean(f1s), np.mean(ds) if ds else np.nan, ms, eps, sw)\n\nif __name__ == \'__main__\':\n    c, e = load_data()\n    c_g = {n: g[[\'x\', \'y\']].values for n, g in c.groupby(\'file_rad\')}\n    e_g = {n: g[[\'x\', \'y\']].values for n, g in e.groupby(\'file_rad\')}\n    files = sorted(e[\'file_rad\'].unique())\n    grid = [(ms, eps, round(sw, 1), c_g, e_g, files) for ms in range(3, 10) for eps in range(4, 25, 2) for sw in np.arange(0.9, 1.95, 0.1)]\n    with Pool() as pool: results = pool.map(run, grid)\n    filt = [r for r in results if r[0] > 0.5]\n    if filt:\n        costs = np.array([(r[0], r[1]) for r in filt])\n        eff = np.ones(len(filt), dtype=bool)\n        for i, c in enumerate(costs):\n            if eff[i]:\n                dom = ((costs[:,0] >= c[0]) & (costs[:,1] <= c[1])) & ((costs[:,0] > c[0]) | (costs[:,1] < c[1]))\n                if np.any(dom): eff[i] = False\n        pareto = sorted([filt[i] for i in range(len(filt)) if eff[i]], key=lambda x: (-x[0], x[1]))\n        with open(\'/root/pareto_frontier.csv\', \'w\') as f:\n            f.write("F1,delta,min_samples,epsilon,shape_weight\\n")\n            for r in pareto: f.write(f"{r[0]:.5f},{r[1]:.5f},{r[2]},{r[3]},{r[4]:.1f}\\n")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
