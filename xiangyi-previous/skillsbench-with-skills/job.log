Sending keys: ['cat >> analysis.py << \'EOF\'\n\n# Step 4: Prepare data for DiD analysis\nprint("\\nStep 4: Preparing data for DiD analysis...")\n\n# Filter purchases to top surge and slump categories\ntop_categories = top_surge + top_slump\npurchases_top = purchases[purchases[\'Category\'].isin(top_categories)].copy()\n\n# Add period indicator\ndef assign_period(date):\n    if baseline_start <= date <= baseline_end:\n        return \'baseline\'\n    elif treatment_start <= date <= treatment_end:\n        return \'treatment\'\n    else:\n        return \'other\'\n\npurchases_top[\'Period\'] = purchases_top[\'Order Date\'].apply(assign_period)\npurchases_top = purchases_top[purchases_top[\'Period\'].isin([\'baseline\', \'treatment\'])]\n\n# Get all unique users from survey\nall_users = survey[\'Survey ResponseID\'].unique()\n\n# Create intensive margin data (Total_Spend per user-category-period)\nintensive_data = []\n\nfor user in all_users:\n    for category in top_categories:\n        for period in [\'baseline\', \'treatment\']:\n            user_cat_period = purchases_top[\n                (purchases_top[\'Survey ResponseID\'] == user) &\n                (purchases_top[\'Category\'] == category) &\n                (purchases_top[\'Period\'] == period)\n            ]\n            total_spend = user_cat_period[\'Total_Spend\'].sum()\n            intensive_data.append({\n                \'Survey ResponseID\': user,\n                \'Category\': category,\n                \'Period\': period,\n                \'Total_Spend\': total_spend\n            })\n\nintensive_df = pd.DataFrame(intensive_data)\nintensive_df.to_csv(\'/app/output/user_category_period_aggregated_intensive.csv\', index=False)\nprint(f"Intensive margin data created: {intensive_df.shape}")\n\n# Create extensive margin data (Has_Purchase indicator per user-category-period)\nextensive_data = []\n\nfor user in all_users:\n    for category in top_categories:\n        for period in [\'baseline\', \'treatment\']:\n            user_cat_period = purchases_top[\n                (purchases_top[\'Survey ResponseID\'] == user) &\n                (purchases_top[\'Category\'] == category) &\n                (purchases_top[\'Period\'] == period)\n            ]\n            has_purchase = 1 if len(user_cat_period) > 0 else 0\n            extensive_data.append({\n                \'Survey ResponseID\': user,\n                \'Category\': category,\n                \'Period\': period,\n                \'Has_Purchase\': has_purchase\n            })\n\nextensive_df = pd.DataFrame(extensive_data)\nextensive_df.to_csv(\'/app/output/user_category_period_aggregated_extensive.csv\', index=False)\nprint(f"Extensive margin data created: {extensive_df.shape}")\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
